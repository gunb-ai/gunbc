module gunbc.instruments.list_append_concat_paired_timing

import v2.std.algebra {
  Cons,
  Empty,
  FreeMonoid,
  fold_list_right,
  length,
  list_append,
  zip_eq
}

// Consumer: gunbc.recurring_failure_mode.lens_prices_the_authority_while_the_lane_runs_the_realization.
// Re-derives the one-binary list_append concat vs reconstructed fold_list_right timing. Both arms
// are linear, so this is not a doubling-ratio enrollment. Native HostBudget:
// gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/instruments/list_append_concat_paired_timing.dag --function paired_timing
// Depth is pow2_ones(k: 8) = 256: the reconstructed arm is non-tail fold_list_right at left-length
// depth. No generic params: `<T>` overlaps the `<` operator in the emitted dag grammar.
fn list_append_from_fold_list_right(left: FreeMonoid<Int>, right: FreeMonoid<Int>) -> FreeMonoid<Int> {
  fold_list_right(xs: left, empty: right, snoc: fn(acc, item) {
    Cons { head: item, tail: acc }
  })
}

fn singleton_one() -> FreeMonoid<Int> {
  Cons { head: 1, tail: Empty }
}

fn ones(n: Int) -> FreeMonoid<Int> {
  if n <= 0 {
    Empty
  } else {
    Cons { head: 1, tail: ones(n: n - 1) }
  }
}

fn list_times_two(xs: FreeMonoid<Int>) -> FreeMonoid<Int> {
  list_append(left: xs, right: xs)
}

fn pow2_ones(k: Int) -> FreeMonoid<Int> {
  if k <= 0 {
    singleton_one()
  } else {
    list_times_two(xs: pow2_ones(k: k - 1))
  }
}

fn same_flag_text(same: Bool) -> String {
  if same {
    "true"
  } else {
    "false"
  }
}

fn paired_timing() -> String {
  let left = pow2_ones(k: 8)
  let right = ones(n: 20)
  let left_n = length(xs: left)
  let right_n = length(xs: right)
  let new_start = observed_monotonic_nanos("list-append-concat-start")
  let new_out = list_append(left: left, right: right)
  let new_end = observed_monotonic_nanos("list-append-concat-end")
  let old_start = observed_monotonic_nanos("list-append-fold-right-start")
  let old_out = list_append_from_fold_list_right(left: left, right: right)
  let old_end = observed_monotonic_nanos("list-append-fold-right-end")
  let new_ns = new_end - new_start
  let old_ns = old_end - old_start
  let same = zip_eq(a: new_out, b: old_out, eq: fn(a, b) { a == b })
  let same_text = same_flag_text(same: same)
  concat(
    "carrier=emitted-list_append-vs-reconstructed-fold_list_right ",
    concat(
      "left_n=",
      concat(
        to_string(left_n),
        concat(
          " right_n=",
          concat(
            to_string(right_n),
            concat(
              " new_ns=",
              concat(
                to_string(new_ns),
                concat(
                  " old_ns=",
                  concat(
                    to_string(old_ns),
                    concat(" same=", same_text)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}
