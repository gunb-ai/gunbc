module tools.type_name_homonym_census

import std.types { Bool, Int, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.ci_layer_roots { witness_layer_roots }
import v2.std.decl_index { DeclFact, ItemKind, TypeItem, decl_facts }
import gunbc.bare_name_fork_lens { BareNameDeclaration, bare_name_declarations_of }
import std.materialization_ladder { string_list_contains }

// DOES A TYPE NAME EXIST THAT TWO MODULES DECLARE? An entry point, so the answer is re-derived
// rather than transcribed.
//
// WHY THE QUESTION IS ASKED AT ALL. `v2.std.node_reflection` `coproduct_arm_keys` resolves a type
// through `type_item_by_name`, which iterates the claim scope's modules and matches on the AUTHORED
// (bare) name. `v2.workflow.floor_pure_producer_share` refuses to enrol that producer in the
// cross-claim share because the share's memo key covers the declared arguments only, so the
// resolving context is invisible to it. THAT REFUSAL STANDS WHATEVER THIS CENSUS SAYS -- a key that
// omits an input the value depends on may not be enrolled, and the population it happens to face
// today is not the criterion (DESIGN section 5: correctness by construction, not validation).
//
// WHAT THE ANSWER CHANGES IS THE READING OF THE PAST, WHICH IS WORTH KNOWING SEPARATELY. With no
// homonym in the corpus, no served output could ever have been wrong and the refused rows are
// UNGUARDED rather than harmful. With one, the class has a live specimen and the upstream repair
// ranks differently. The refused rows cite this instrument by name so a later reader re-runs it
// instead of trusting a number that has aged.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/type_name_homonym_census.dag --function census
//
// IT CONSUMES `gunbc.bare_name_fork_lens` RATHER THAN RESPELLING IT. That lens already models
// "which modules declare this bare name" over `decl_facts`; a second traversal beside it would be
// the fork DESIGN section 3 forbids. What this adds is one restriction the lens does not carry --
// TYPE-kind names only -- because the reflection path that prompted the question resolves types.
//
// IT IS DELIBERATELY NOT WIRED INTO WITNESS DISCOVERY, for the reason its sibling
// `tools.bare_name_fork_check` states: the unit of computation is the whole corpus and the unit of
// fact is one name, so every consumer wanting something else would pay for a corpus traversal. Two
// censuses were deleted from discovery in August on exactly that shape.
fn type_declarations() -> List<BareNameDeclaration> {
  bare_name_declarations_of(facts: decl_facts(pool_roots: witness_layer_roots))
    |> filter(d => is_type_item(kind: d.kind))
}

fn is_type_item(kind: ItemKind) -> Bool {
  match kind {
    TypeItem => true
    _ => false
  }
}

// THE DECLARERS OF ONE TYPE NAME, as DISTINCT module paths. Distinct is load-bearing: one module
// declaring a name once is the ordinary case, and a list that counted occurrences rather than
// declarers would report every type in the corpus as its own homonym.
fn declarer_paths_of(name: String, declarations: List<BareNameDeclaration>) -> List<String> {
  fold(
    declarations |> filter(d => d.name == name) |> map(d => d.rel_path),
    init: [],
    f: fn(acc, p) { if string_list_contains(xs: acc, wanted: p) { acc } else { list_snoc_item(xs: acc, item: p) } }
  )
}

fn distinct_names(declarations: List<BareNameDeclaration>) -> List<String> {
  fold(
    declarations |> map(d => d.name),
    init: [],
    f: fn(acc, n) { if string_list_contains(xs: acc, wanted: n) { acc } else { list_snoc_item(xs: acc, item: n) } }
  )
}

type TypeNameHomonym {
  name: String
  declarer_paths: List<String>
}

fn type_name_homonyms() -> List<TypeNameHomonym> {
  let declarations = type_declarations()
  distinct_names(declarations: declarations)
    |> map(n => TypeNameHomonym { name: n, declarer_paths: declarer_paths_of(name: n, declarations: declarations) })
    |> filter(h => count(h.declarer_paths) > 1)
}

fn homonym_line(h: TypeNameHomonym) -> String {
  concat("[type-name-homonym] name=", concat(h.name, concat(" declarers=", join(h.declarer_paths, ","))))
}

// THE CENSUS ANSWER IS DELIVERED THROUGH THE EXIT, and a NON-EMPTY answer is the one that carries
// its rows. That is not this instrument gating on the corpus: it is standalone, invoked by
// `--entry`, enrolled in no lane, so its exit code blocks nothing. It uses the refusal channel
// because `std.process` `ExitSuccess` carries no narration -- a declared substrate gap whose
// capability and dissolution trigger are named at `tools.emit_host_gate`
// `emit_host_verdict_narration_dissolution_trigger`. When that lands, both arms print and this
// departure dissolves; until then the alternative is an instrument whose measurement is unreadable.
//
// A ZERO IS A REAL MEASUREMENT AND PRINTS AS ONE. The empty arm returns its own line rather than a
// bare success, for the reason the sibling's header names: a lens whose only output is a refusal
// reads clean whenever it could not read at all.
fn census() -> ProcessExit {
  exit_failure(reason: join(census_report(), "\n"))
}

// THE REPORT, so a caller that wants the rows rather than an exit reads them here.
fn census_report() -> List<String> {
  let homonyms = type_name_homonyms()
  if count(homonyms) == 0 {
    ["[type-name-homonym] none: no TYPE-kind authored name is declared by more than one module over the witness layer roots"]
  } else {
    map(homonyms, h => homonym_line(h: h))
  }
}
