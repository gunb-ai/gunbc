module tools.rust_stage0_gates

import std.types { List }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

fn rust_monolith_suffixes() -> List<String> {
  [".rs", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml",
   "clippy.toml", "rustfmt.toml", ".cargo/config.toml"]
}

fn path_is_rust_monolith(path: String) -> Bool {
  fold(rust_monolith_suffixes(), false, fn(acc, suffix) { acc || ends_with(s: path, suffix: suffix) })
}

fn any_rust_monolith(paths: List<String>) -> Bool {
  fold(paths, false, fn(acc, p) { acc || path_is_rust_monolith(path: p) })
}

data consumed_input_closure_concept_note: Disposition = Terminal {
  reason: "consume-input vs produce-artifact is a permanent §3 distinction (different direction + domain from NodeArtifactProvenance). The declared fact here is ENROLLMENT ONLY (unit + entry_path): the consumed .dag closure itself is DERIVED at read time from v2.lens.affected_set.entry_selection.entry_affected_by_dependency_view over gunbc.ci_layer_roots.witness_layer_roots (DependencyView reverse-reachability, replacing import_closure_live). Per-PR live execution gated on #6239 via corpus_dependency_view_per_pr_execution_gate. The former drift walls (src/v1 consumed_input_closure_drift_test.rs and the import_closure_completeness floor witness) were deleted with the hand-typed path list they guarded, not relocated"
}

type ConsumedInputUnit {
  unit: String
  entry_path: String
}

data coproduct_reflection_conformance_consumed_unit: ConsumedInputUnit = ConsumedInputUnit {
  unit: "coproduct_reflection_conformance_test",
  entry_path: "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag"
}

data declared_consumed_input_units: List<ConsumedInputUnit> = [
  coproduct_reflection_conformance_consumed_unit
]

// PER-PR SELECTION IS NOT ENABLED HERE, AND THAT IS NOW SAID RATHER THAN PROBED FOR
// (gunbc#10156 clause 2). This read `if corpus_dependency_view_per_pr_substrate_ready()`, calling
// entry_affected_by_dependency_view when the fn-arrow substrate happened to cover the corpus and
// returning must-run when it did not. That predicate is deleted: it asked at runtime about a
// producer whose subject was its caller's resolved closure, and the producer now takes pool_roots,
// so the question has no referent.
//
// THIS PRESERVES THE BEHAVIOUR THIS GATE ACTUALLY HAD, and the receipt for that is not this file's:
// v2.lens.affected_set.entry_selection records a 2026-07-10 probe measuring the predicate FALSE on
// a pristine main clone, which is the arm below. So the selection call was already unreachable in
// practice; making it unconditional would not have restored a live selection, it would have newly
// enrolled a whole-corpus dependency walk in a per-PR gate that has never run one.
//
// Must-run is also the DECLARED default here, not a convenience: unit_must_run_failclosed_note
// states absent declaration = must-run. Per-PR selection was the subject of
// v2.lens.affected_set.corpus_dependency_view corpus_dependency_view_per_pr_execution_gate, which
// is DELETED as part of the §3 consolidation (the fn-arrow mechanism #2 is removed;
// module-graph import-closure mechanism #3 is the survivor). Enabling per-PR selection
// is now a matter of wiring entry_affected_by_touched_paths into this gate's callers,
// not re-creating the deleted corpus_dependency_view module.
fn unit_is_affected(_u: ConsumedInputUnit, _paths: List<String>) -> Bool {
  true
}

fn any_declared_unit_affected(paths: List<String>) -> Bool {
  fold(declared_consumed_input_units, false, fn(acc, u) { acc || unit_is_affected(u: u, paths: paths) })
}

data unit_must_run_failclosed_note: Disposition = Terminal {
  reason: "fail-closed per-unit selection is a permanent §5 invariant: absent declaration = must-run, keeping coverage sound while declarations are added incrementally"
}

data unit_must_run_staged_note: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.rust_stage0_gates",
    decl_name: "per_unit_test_selector",
    field: WholeDeclaration
  }
}

fn unit_must_run(unit: String, paths: List<String>) -> Bool {
  fold(declared_consumed_input_units, true, fn(acc, u) {
    if u.unit == unit { unit_is_affected(u: u, paths: paths) } else { acc }
  })
}

data should_run_gates_coverage_note: Disposition = Terminal {
  reason: "Coverage fire (Edge-(b)) is a permanent §5 design invariant: the rust gate ALSO runs when a changed .dag affects a declared unit's derived import closure, only ever ADDING fires, never newly skipping"
}

fn should_run_gates(paths: List<String>, git_success: Bool) -> Bool {
  if git_success {
    any_rust_monolith(paths: paths) || any_declared_unit_affected(paths: paths)
  } else {
    true
  }
}

// The three rows below each carried BOTH arms of the deleted predicate and asserted whichever one
// the runtime happened to be in — a witness that cannot fail whichever way the probe answers, which
// is a row with no discriminating red. With selection declared off, each asserts the one thing that
// is true, and a change that silently enabled selection here would turn them red.
fn witness_dag_only_gates_fire_without_per_pr_selection() -> Bool {
  should_run_gates(paths: ["src/v2/std/text.dag"], git_success: true) == true
}

fn witness_empty_paths_gate_fires_without_per_pr_selection() -> Bool {
  should_run_gates(paths: [], git_success: true) == true
}

fn witness_declared_unit_must_run_without_per_pr_selection() -> Bool {
  unit_must_run(
    unit: "coproduct_reflection_conformance_test",
    paths: ["src/v2/std/text.dag"]
  ) == true
}
