module gunbc.instruments.dag_emit_real_grammar_round_trips

import std.types { String, List, Bool }
import v2.std.algebra { filter }
import std.compiler_entry { CompilerEntryDriver, NativeClaimDriver, NativeClaimReport, NativeClaimTerminal, NativeClaimHeld, NativeClaimNotHeld }
import v2.compiler.parse { PreparedGrammar, parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.compiler.tokenize { tokenize_prepared }
import v2.extdeps.languages.dag { dag_emit_parse_tree }
import v2.std.diagnostic { Accepted, Diagnostics, NonEmptyDiagnostics, Outcome, Rejected, bind_outcome }
import v2.std.fn_index { non_empty_diagnostics_list }
import v2.std.node { Node, content_hash, symbol_lexeme }

// THE DAG TARGET'S REAL-GRAMMAR ROUND TRIPS, AS A NAMED INSTRUMENT. `gunbc test
// //gunbc/instruments:dag-emit-real-grammar-round-trips` emits this closure, builds it and runs it
// natively. Each case is the real route over one construct: ingest the source through
// dag_prepared_grammar and parse_module_prepared, emit the parse tree by reading dag_grammar_root
// backward (v2.extdeps.languages.dag dag_emit_parse_tree), ingest the emitted text again, and
// require the identical tree (v2.std.node content_hash, which does not read occurrence ids).
//
// WHY AN INSTRUMENT AND NOT FLOOR CLAIMS. Two real parses of any of these constructs exceed the
// required floor's per-claim eval-step budget, and several cross its wall clock. The floor keeps one
// real round trip, over a one-line data declaration, as its inhabitance claim
// (v2.test.execution.dag_grammar_backward_round_trip). The loss of the rest from the floor is the
// declared drop gunbc.rung_drop.dag_emit_real_grammar_round_trips_off_floor, whose population IS
// dag_emit_real_grammar_round_trip_expected_identities below. Run by name; not a merge gate.
data compiler_pipeline_entry: CompilerEntryDriver = NativeClaimDriver

type DagEmitRoundTripCase {
  identity: String
  source: String
}

type DagEmitRoundTripRow {
  identity: String
  held: Bool
  observed: String
}

// The grammar is prepared once per round trip and both ingests read it.
fn dag_round_trip_parse(prepared: PreparedGrammar, residue: Diagnostics, text: String) -> Outcome<Node> {
  bind_outcome(
    o: tokenize_prepared(text: text, file: ^dag_emit_round_trip_source, prepared: dag_prepared_lex()),
    f: fn(stream) {
      match parse_module_prepared(tokens: stream, prepared: prepared, validation_residue: residue) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: artifact, diagnostics: d } => Accepted { value: artifact.tree, diagnostics: d }
      }
    }
  )
}

fn dag_round_trip_refused(stage: String, d: NonEmptyDiagnostics) -> String {
  fold(non_empty_diagnostics_list(d: d), init: concat(stage, " refused:"), f: fn(acc, x) { concat(acc, concat(" ", symbol_lexeme(sym: x.reason))) })
}

// WHAT HAPPENED, as one observation: `same` when the re-ingested tree equals the ingested one, the
// refusing stage and its reasons otherwise, or `trees differ` with the emitted text.
fn dag_round_trip_observed(text: String) -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => dag_round_trip_refused(stage: "grammar preparation", d: d)
    Accepted { value: prepared, diagnostics: residue } =>
      match dag_round_trip_parse(prepared: prepared, residue: residue, text: text) {
        Rejected { diagnostics: d } => dag_round_trip_refused(stage: "first ingest", d: d)
        Accepted { value: tree, diagnostics: _ } =>
          match dag_emit_parse_tree(tree: tree) {
            Rejected { diagnostics: d } => dag_round_trip_refused(stage: "emit", d: d)
            Accepted { value: emitted, diagnostics: _ } =>
              match dag_round_trip_parse(prepared: prepared, residue: residue, text: emitted) {
                Rejected { diagnostics: d } => dag_round_trip_refused(stage: "re-ingest", d: d)
                Accepted { value: again, diagnostics: _ } =>
                  if content_hash(n: tree) == content_hash(n: again) { "same" } else { concat("trees differ: ", emitted) }
              }
          }
      }
  }
}

fn dag_round_trips(text: String) -> Bool {
  dag_round_trip_observed(text: text) == "same"
}

// Module paths avoid keywords: `module rt.let` refuses at the first ingest (KeywordAsPathSegment) because `let` is not a
// path segment, which is not this instrument's subject.
data dag_emit_real_grammar_round_trip_cases: List<DagEmitRoundTripCase> = [
  DagEmitRoundTripCase { identity: "fn_declaration", source: "module rt.fn_decl\nfn add(x: Int, y: Int) -> Int { x + y }\n" },
  DagEmitRoundTripCase { identity: "record_type", source: "module rt.record_type\ntype Point { x: Int, y: Int }\n" },
  DagEmitRoundTripCase { identity: "coproduct", source: "module rt.coproduct\ntype Shape = Circle { r: Int } | Square\n" },
  DagEmitRoundTripCase { identity: "match_comma_arms", source: "module rt.match_arms\ntype T = A | B\nfn f(t: T) -> Int { match t { A => 1, _ => 2 } }\n" },
  DagEmitRoundTripCase { identity: "match_bool_literal_arms", source: "module rt.match_bool_arms\nfn pick(a: Bool) -> Int { match a { true => 1, false => 2 } }\n" },
  DagEmitRoundTripCase { identity: "match_statement_body_arm", source: "module rt.match_stmt_body\n\ntype T = A | B\n\nfn f(t: T, v: Int) -> Int {\n  match t {\n    A =>\n      let w = v\n      w + 1\n    B => v\n  }\n}\n" },
  DagEmitRoundTripCase { identity: "let_statement", source: "module rt.let_stmt\nfn f(from: Int, input: Int) -> Int { let transport = from\n transport + input }\n" },
  DagEmitRoundTripCase { identity: "list_literal", source: "module rt.list\nimport std.types { List }\ndata xs: List<Int> = [1, 2, 3]\n" },
  DagEmitRoundTripCase { identity: "map_literal", source: "module rt.map_literal\nimport std.types { Map }\ndata m: Map<String, Bool> = { \"a\": true, \"b\": false }\n" },
  DagEmitRoundTripCase { identity: "string_escapes", source: "module rt.string_escapes\ndata s: String = \"q\\\"b\\\\s\\nt\\tz\\u\{e9\}\\x41\\\{\\\}\"\n" },
  DagEmitRoundTripCase { identity: "caret_symbol", source: "module rt.caret_symbol\ndata k: Symbol = ^some_name\n" },
  DagEmitRoundTripCase { identity: "escaped_quoted_key", source: "module rt.escaped_key\nimport std.types { Map }\ndata m: Map<String, Bool> = { \"a\\\"b\": true, \"\\u\{e9\}\": false }\n" },
  DagEmitRoundTripCase { identity: "quoted_key_spelled_like_an_identifier", source: "module rt.quoted_key\ndata r: R = { \"Node\": true }\n" },
  DagEmitRoundTripCase { identity: "bare_key", source: "module rt.bare_key\ndata r: R = { Node: true }\n" }
]

// THE EXPECTED IDENTITIES, DECLARED RATHER THAN DERIVED FROM THE CASES, so a case removed from the
// list above leaves its identity rostered with no row, and the run is no observation rather than a
// smaller green. This list is also the declared drop's population.
data dag_emit_real_grammar_round_trip_expected_identities: List<String> = [
  "fn_declaration",
  "record_type",
  "coproduct",
  "match_comma_arms",
  "match_bool_literal_arms",
  "match_statement_body_arm",
  "let_statement",
  "list_literal",
  "map_literal",
  "string_escapes",
  "caret_symbol",
  "escaped_quoted_key",
  "quoted_key_spelled_like_an_identifier",
  "bare_key"
]

fn dag_emit_round_trip_row(c: DagEmitRoundTripCase) -> DagEmitRoundTripRow {
  let observed = dag_round_trip_observed(text: c.source)
  DagEmitRoundTripRow { identity: c.identity, held: observed == "same", observed: observed }
}

fn dag_emit_round_trip_row_text(r: DagEmitRoundTripRow) -> String {
  concat("case ", concat(r.identity, concat(if r.held { " held" } else { " not_held" }, concat(" observed=", concat(r.observed, "\n")))))
}

fn native_claim_report() -> NativeClaimReport {
  let rows = dag_emit_real_grammar_round_trip_cases |> map(c => dag_emit_round_trip_row(c: c))
  let roster = concat("roster ", concat(dag_emit_real_grammar_round_trip_expected_identities |> join(separator: ","), "\n"))
  let failed = rows |> filter(r => !r.held) |> map(r => r.identity)
  let terminal = if (failed |> count) == 0 { held_terminal() } else { not_held_terminal(reason: concat("not held: ", failed |> join(separator: ","))) }
  NativeClaimReport { stdout: concat(roster, rows |> map(r => dag_emit_round_trip_row_text(r: r)) |> join(separator: "")), terminal: terminal }
}

fn held_terminal() -> NativeClaimTerminal {
  NativeClaimHeld
}

fn not_held_terminal(reason: String) -> NativeClaimTerminal {
  NativeClaimNotHeld { reason: reason }
}
