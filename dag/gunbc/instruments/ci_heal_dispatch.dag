module tools.ci_heal_dispatch

import std.algebra { trim }

import gunbc.repository { gunbc_repository }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { CommitSha, NonEmptyStr }
import extdeps.shell
import extdeps.github.workflows
import gunbc.generated_artifact { WitnessFloorYamlArtifact, artifact_name }

data ci_heal_dispatch_owner: String = gunbc_repository.owner
data ci_heal_dispatch_repo: String = gunbc_repository.name
// THE WORKFLOW IS NAMED BY ITS ARTIFACT VARIANT, NOT BY A FILENAME LITERAL. This row read
// "ci.yml" for a fortnight after the 2026-08-15 floor cut deleted that workflow: a literal cannot
// go stale loudly, so the dispatcher pointed at a file with no existence and nothing said so.
// gunbc.generated_artifact GeneratedArtifact is the single authority for which emissions this
// repository commits and where; naming the variant means the census is coproduct exhaustiveness --
// deleting WitnessFloorYamlArtifact would refuse this module at compile time rather than leaving a
// dangling string. The heal job is a job OF that emission, so the variant is also the true subject.
data ci_heal_dispatch_workflow_id: String = artifact_name(a: WitnessFloorYamlArtifact)

// The heal job does not mint a gh-api shell call. It invokes the modeled
// github.Workflows.CreateDispatch operation, whose REST transport is the realization handler. The
// dispatch ref remains the PR branch because GitHub's endpoint requires a branch/tag ref;
// expected_healed_sha travels separately as the immutable input and the run refuses unless BOTH its
// GitHub check subject (github.sha) and checkout name it. GITHUB_TOKEN is resolved solely by the
// service's auth_source; CreateDispatch has no unused caller-supplied auth_token input and this
// tool passes no empty sentinel.

fn required_env(name: NonEmptyStr) -> String? {
  let observed = shell.Env.Get(name: name)
  match observed.value {
    Present { value: raw } =>
      if trim(raw) == "" { none } else { Present { value: trim(raw) } }
    Absent => none
  }
}

func main() -> ProcessExit {
  let branch = match required_env(name: "GUNBC_HEAL_BRANCH_REF") {
    Present { value: value } => value
    Absent => return exit_failure(reason: "HealDispatchRefused: GUNBC_HEAL_BRANCH_REF is absent")
  }
  let healed_head = match required_env(name: "GUNBC_HEALED_HEAD") {
    Present { value: value } => value as CommitSha
    Absent => return exit_failure(reason: "HealDispatchRefused: GUNBC_HEALED_HEAD is absent")
  }
  let receipt = github.Workflows.CreateDispatch(
    owner: ci_heal_dispatch_owner,
    repo: ci_heal_dispatch_repo,
    workflow_id: ci_heal_dispatch_workflow_id,
    ref: branch,
    expected_healed_sha: healed_head
  )
  if receipt.workflow_run_id > 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "HealDispatchRefused: dispatch response carried no workflow run identity")
  }
}
