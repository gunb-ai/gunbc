module gunbc.instruments.scratch_s2_node

import gunbc.cli_wire { CliWireResponse, CliWirePrintable }
import std.process { ExitSuccess }
import std.integer { int_to_decimal_string }
import extdeps.filesystem.filesystem_io { Filesystem }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.compiler.parse { PreparedGrammar }
import v2.compiler.tokenize { PreparedLexRules }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.workflow.roster_import_sweep { RosterHeadRow, RosterHomeClosure, RosterHomeScope, RosterOutcome, RosterClean, RosterRefused, RosterApplyWritten, RosterApplyRefused, OneHome, OnlyOccurrences, KeepHead, roster_rows_for_scope, roster_home_sides, roster_home_closures, roster_census_text_rows, roster_applied, roster_refusal_text, roster_render_outcome }

// SCRATCH, NEVER LANDED (branch scratch/s2-node): S2's apply route over v2.std.node on a fleet runner (a node.dag pass outruns
// BuildBuddy's cap). The census before, the file converged IN MEMORY by roster_applied (the apply's own splice), the census
// after, and the final text between markers, because a fleet runner's writes are not kept.
data s2_path: String = "src/v2/std/node.dag"

fn s2_scope() -> RosterHomeScope {
  OneHome { home: qualified_name_from_dotted_string(dotted: "std.algebra"), rows: OnlyOccurrences { call: "sort_by", within: "symbols_are_one_distinct_set", texts: ["symbol_total_order()"] } }
}

// The new heads' binding: list_sort_by_key read as a KeepHead row of std.algebra, so the census's own classifier counts its
// heads, and its outcome is Clean exactly when every such head is free and the module imports it from std.algebra.
fn s2_to_row() -> RosterHeadRow {
  RosterHeadRow { call: "list_sort_by_key", import_name: "list_sort_by_key", home: qualified_name_from_dotted_string(dotted: "std.algebra"), labels: [], head: KeepHead }
}

fn scratch_s2_node_wire() -> CliWireResponse {
  CliWirePrintable { bytes: s2_report(), exit: ExitSuccess }
}

fn s2_report() -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "S2 grammar-unprepared\n"
    Accepted { value: prepared, diagnostics: _ } => s2_run(prepared: prepared, lex: dag_prepared_lex())
  }
}

fn s2_census(label: String, text: String, rows: List<RosterHeadRow>, closures: List<RosterHomeClosure>, call: String, prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let c = roster_census_text_rows(sides: roster_home_sides(rows: rows), companions: [], path: s2_path, text: text, prepared: prepared, lex: lex, candidates: rows, closures: closures, census_call: Present { value: call })
  "CENSUS-" + label + " " + s2_path + " call=" + call + " heads=" + int_to_decimal_string(value: c.heads) + " selected=" + int_to_decimal_string(value: c.selected) + "\n" + roster_render_outcome(path: s2_path, outcome: c.outcome) + "OUTCOME-" + label + " " + s2_outcome_word(outcome: c.outcome) + "\n"
}

fn s2_outcome_word(outcome: RosterOutcome) -> String {
  match outcome {
    RosterClean => "clean"
    RosterRefused { reason: r } => "refused " + roster_refusal_text(reason: r)
    _ => "planned"
  }
}

// ONE ANALYSIS: the census of the original file IS the apply's first pass (roster_census_text_rows returns the outcome the
// apply splices), so its census line is the before-census, and the spliced text is the swept file. The after-census and the
// binding census read that swept file in a second run (s2_after_run), never re-deriving the first pass.
fn s2_run(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let scope = s2_scope()
  let rows = roster_rows_for_scope(scope: scope)
  let closures = roster_home_closures(root: "", scope: scope)
  let read = Filesystem.Read(path: s2_path)
  if read.success {
    let c = roster_census_text_rows(sides: roster_home_sides(rows: rows), companions: [], path: s2_path, text: read.content, prepared: prepared, lex: lex, candidates: rows, closures: closures, census_call: Present { value: "sort_by" })
    let census = "CENSUS-BEFORE " + s2_path + " call=sort_by heads=" + int_to_decimal_string(value: c.heads) + " selected=" + int_to_decimal_string(value: c.selected) + "\n" + roster_render_outcome(path: s2_path, outcome: c.outcome) + "OUTCOME-BEFORE " + s2_outcome_word(outcome: c.outcome) + "\n"
    census + s2_splice_report(before: read.content, outcome: c.outcome)
  } else {
    "S2 unreadable\n"
  }
}

fn s2_splice_report(before: String, outcome: RosterOutcome) -> String {
  match outcome {
    RosterClean => "SPLICE none (clean)\n"
    RosterRefused { reason: r } => "SPLICE none (refused " + roster_refusal_text(reason: r) + ")\n"
    other =>
      match roster_applied(before: before, outcome: other) {
        RosterApplyRefused { reason: r } => "SPLICE-REFUSED " + roster_refusal_text(reason: r) + "\n"
        RosterApplyWritten { content: c } => "FINAL-BEGIN\n" + c + "\nFINAL-END\n"
      }
  }
}

// THE SECOND RUN, over the swept file committed on this scratch branch: the after-census over the same selection (a Clean
// outcome is the fixed point), and list_sort_by_key's census as a KeepHead row of std.algebra, whose outcome is Clean
// exactly when every such head is free and the module imports it from std.algebra.
fn scratch_s2_node_after_wire() -> CliWireResponse {
  CliWirePrintable { bytes: s2_after_report(), exit: ExitSuccess }
}

fn s2_after_report() -> String {
  match dag_prepared_grammar() {
    Rejected { diagnostics: _ } => "S2 grammar-unprepared\n"
    Accepted { value: prepared, diagnostics: _ } => s2_after_run(prepared: prepared, lex: dag_prepared_lex())
  }
}

fn s2_after_run(prepared: PreparedGrammar, lex: PreparedLexRules) -> String {
  let scope = s2_scope()
  let rows = roster_rows_for_scope(scope: scope)
  let closures = roster_home_closures(root: "", scope: scope)
  let read = Filesystem.Read(path: s2_path)
  if read.success {
    s2_census(label: "AFTER", text: read.content, rows: rows, closures: closures, call: "sort_by", prepared: prepared, lex: lex)
      + s2_census(label: "TO-BOUND", text: read.content, rows: [s2_to_row()], closures: closures, call: "list_sort_by_key", prepared: prepared, lex: lex)
  } else {
    "S2 unreadable\n"
  }
}

