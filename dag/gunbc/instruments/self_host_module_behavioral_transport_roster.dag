module tools.self_host_module_behavioral_transport_roster

import std.types { List }
import tools.self_host_curated_seed_linked_harness {
  CuratedSeedLinkedClaimRun,
  CsslWitnessDriver,
  CsslReceiptOutcome,
  CsslBehaviorHeld,
  CsslBehaviorDiverged,
  CsslSetupRefused,
  cssl_seed_linked_behavioral_receipt
}
import v2.std.algebra { fold_list }
import std.optional {
  Optional,
  Absent,
  Present,
  optional_absent,
  optional_present
}
import v2.std.subject_evidence {
  EvidenceInstrumentRefused,
  EvidenceSubjectUnreached,
  EvidenceSubjectCompleted,
  SubjectEvidence,
  subject_evidence_establishes
}
import v2.std.text { String }

// The modeled per-module behavioral-receipt producer (Gate-1 receipt lane B1): one config row per
// src/v2/compiler/self_host/frontier.dag module, one generic dispatch fn
// (compiler_module_behavioral_receipt_for) replacing the 16 hand-authored
// tools.self_host_<mod>_behavioral_transport.dag files this roster supersedes (00_compile,
// 01_tokenize, 02_parse, 03_body_producer, 03_ingest, 03_normalize, 03_resolve, 04_infer,
// 07_target_carriers, discovery_enumeration, materialization_carriers, parse_engine_hooks
// (since deleted with its module), program_assembly, program_partition, source_authority, use_site_verdict). Each row is config data
// only (module path, witness driver, pass marker, supplementary claim-runs). A row's driver is the
// .dag contract the harness emits beside the subject and renders its driver from
// (CsslWitnessDriver); no row names a hand-written Rust file any more; the hand shim paths the
// rows once carried are deleted with the fields that held them (see
// gunbc.recurring_failure_mode hand_shim_shadows_an_emitted_module), so every row links the whole
// emitted closure. The emit/assemble/cargo/witness execution stays entirely in the shared kernel
// (tools.self_host_curated_seed_linked_harness), so a new frontier row's receipt is one roster row,
// not a new file. Fail-closed: an unrecognized module_path returns false (never a fabricated pass)
// — see compiler_module_behavioral_receipt_for. tools.self_host_logic_behavioral_transport and
// tools.namespace_import_closure_behavioral_transport are deliberately NOT migrated here: neither
// is keyed by a frontier row (logic predates the frontier; namespace_import_closure proves an
// emitter CLASS property, not a per-module fact — see falsifier_self_host_wet_emit_class_note in
// v2.compiler.self_host.wet_receipt_enrollment).

type ModuleBehavioralTransportConfig {
  module_path: String
  driver: CsslWitnessDriver
  pass_marker: String
  claim_runs: List<CuratedSeedLinkedClaimRun>
}

