fn module_behavioral_transport_config_if_matches(
  module_path: String,
  cfg: ModuleBehavioralTransportConfig
) -> Optional<ModuleBehavioralTransportConfig> {
  if cfg.module_path == module_path {
    optional_present(value: cfg)
  } else {
    optional_absent()
  }
}

fn module_behavioral_transport_config_for(module_path: String) -> Optional<ModuleBehavioralTransportConfig> {
  fold_list(
    xs: compiler_module_behavioral_transport_roster,
    empty: Absent,
    cons: fn(acc, cfg) {
      match acc {
        Present { value: _ } => acc
        Absent => module_behavioral_transport_config_if_matches(module_path: module_path, cfg: cfg)
      }
    }
  )
}

// AN UNCONFIGURED MODULE IS NOT A FAILING ONE, AND THIS ARM USED TO SAY IT WAS.
//
// The Absent arm means NO TRANSPORT CONFIG EXISTS for the module -- the receipt was never attempted.
// It returned `false`, the same value a receipt that RAN and found the emitted module behaving
// differently from the seed returns. Two states with opposite owners and opposite remedies: one needs
// a config row authored here, the other needs a behavioural divergence repaired in the compiler. The
// old signature could not express the difference even in principle, so no caller could act on it.
//
// The doc note above described this arm as "fail-closed: an unrecognized module_path returns false
// (never a fabricated pass)". That was true and insufficient, which is why it survived review for as
// long as it did: refusing to fabricate a PASS is necessary and says nothing about whether the false
// it returns instead is readable. Fail-closed and unaliased are different properties.
//
// THE COMPLETED ARM NO LONGER ALIASES A SETUP FAILURE AS A DIVERGENCE. cssl_seed_linked_behavioral_receipt
// answers a typed CsslReceiptOutcome: a step that did not produce what the drive needs (a missing or
// unbuilt witness artifact, a failed emit or cargo build) is EvidenceSubjectUnreached with the located
// step, never BehavioralReceiptRefuted -- which is reserved for a drive that RAN and did not hold.
type CompilerModuleReceiptNoVerdict
  = BehavioralTransportConfigAbsent { module_path: String }
  | BehavioralReceiptSetupRefused { module_path: String, step: String }

type CompilerModuleReceiptOutcome
  = BehavioralReceiptHeld
  | BehavioralReceiptRefuted { observed: String }

fn compiler_module_receipt_outcome_licenses(outcome: CompilerModuleReceiptOutcome) -> Bool {
  match outcome {
    BehavioralReceiptHeld => true
    BehavioralReceiptRefuted { observed: _ } => false
  }
}

fn compiler_module_behavioral_receipt_evidence(
  module_path: String
) -> SubjectEvidence<CompilerModuleReceiptNoVerdict, CompilerModuleReceiptOutcome> {
  match module_behavioral_transport_config_for(module_path: module_path) {
    Present { value: cfg } => match cssl_seed_linked_behavioral_receipt(
      source_rel: cfg.module_path,
      driver: cfg.driver,
      pass_marker: cfg.pass_marker,
      claim_runs: cfg.claim_runs
    ) {
      CsslBehaviorHeld => EvidenceSubjectCompleted { outcome: BehavioralReceiptHeld }
      CsslBehaviorDiverged { observed } => EvidenceSubjectCompleted { outcome: BehavioralReceiptRefuted { observed: observed } }
      CsslSetupRefused { step: refused_step } => EvidenceSubjectUnreached {
        cause: BehavioralReceiptSetupRefused { module_path: cfg.module_path, step: refused_step }
      }
    }
    Absent => EvidenceInstrumentRefused {
      cause: BehavioralTransportConfigAbsent { module_path: module_path }
    }
  }
}

fn compiler_module_behavioral_receipt_for(module_path: String) -> Bool {
  subject_evidence_establishes(
    evidence: compiler_module_behavioral_receipt_evidence(module_path: module_path),
    licenses: fn(o) { compiler_module_receipt_outcome_licenses(outcome: o) }
  )
}
