module gunbc.instruments.argv_word_construction_census

// THE TYPED-ARGV CONSTRUCTION CENSUS ROSTER (debt paydown trial, witty-tern-54, 2026-10-03).
//
// The instrument is v2.lens.argv_word_construction; this module commits WHAT IT COUNTS: the
// population of argv-string construction sites over dag/extdeps and dag/gunbc, at identity grain,
// as a typed roster that may only shrink. DESIGN 5: a count over the current tree is not an
// oracle — every row below joins to a live census member at (module_file, decl, decl_kind), a
// row that stops resolving refuses the recount, and the population never grows past the committed
// baseline: new string-built argv is refused, not enrolled.
//
// Recount (the named, re-runnable instrument run): discover the two roots' module files by the
// declaration index, walk each with the lens, and hold the gates over (live, roster, baseline).
// The gates live in the lens; this module owns the committed state: the roster, the baseline
// cardinality, and the sites classified as NOT argv debt with a stated reason.

import v2.lens.argv_word_construction {
  ArgvWordsDeclKind,
  ArgvWordsRosterRow,
  ArgvWordsSite,
  ArgvWordsSiteClass,
  ExtdepsInterfaceBuilder,
  FnDecl,
  DataDecl,
  WorkflowCallSite,
  ArgvWordsModuleEstablished,
  ArgvWordsModuleRefused,
  argv_word_construction_gates,
  argv_word_construction_module_sites,
  argv_word_construction_for_paths
}
import v2.std.algebra { fold_list, list_reverse }
import v2.std.collection { List }
import std.algebra { Cons, Empty, FreeMonoid }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }

// The modeled roots. Anything else is refused by the lens, never silently zero.
data argv_word_construction_census_roots: List<String> = ["dag/extdeps", "dag/gunbc"]

// THE COMMITTED BASELINE: the population the instrument counted over the two roots at the start
// of the trial (origin/main, 2026-10-03). The roster may only shrink past this number.
data argv_word_construction_census_baseline_population: Int = 0

// THE ROSTER: one row per live census member. `note` names what the site is and what pays it.
// Kept at zero rows until the first committed recount fills it from the instrument (never by
// hand from a text search).
data argv_word_construction_census_roster: List<ArgvWordsRosterRow> = []

// Sites whose evidence is read and REFUSED AS DEBT with a stated reason: the census classifies,
// it does not silently count. Each entry names its reason; a reason that stops being true must
// delete the entry (the same shrink discipline as the roster).
data argv_word_construction_census_excluded: List<ArgvWordsExclusion> = []

type ArgvWordsExclusion {
  module_file: String
  decl: String
  reason: String
}

fn excluded_identity_matches(e: ArgvWordsExclusion, s: ArgvWordsSite) -> Bool {
  (e.module_file == s.module_file) && (e.decl == s.decl)
}

fn site_is_excluded(s: ArgvWordsSite) -> Bool {
  fold_list(xs: argv_word_construction_census_excluded, empty: false, cons: fn(acc, e) { acc || excluded_identity_matches(e: e, s: s) })
}

// The live census members after classification: exclusions are visible subtractions with reasons.
fn argv_word_construction_census_live(sites: List<ArgvWordsSite>) -> List<ArgvWordsSite> {
  fold_list(xs: sites, empty: Empty, cons: fn(acc, s) { if site_is_excluded(s: s) { acc } else { Cons { head: s, tail: acc } } })
}

// The contract over one recount's live sites.
fn argv_word_construction_census_check_sites(sites: List<ArgvWordsSite>) -> ProcessExit {
  argv_word_construction_gates(live: argv_word_construction_census_live(sites: sites), roster: argv_word_construction_census_roster, baseline_population: argv_word_construction_census_baseline_population)
}

// The recount entry: discover the roots' module files by the declaration index (never a text
// search), walk each with the lens, and hold the contract.
fn argv_word_construction_census_recount() -> ProcessExit {
  argv_word_construction_census_check_paths(paths: argv_word_construction_census_root_paths())
}

// The discovered modeled roots' module files, in declaration-index order. Shared by the gated
// recount above and the roster emitters below so all see the same population. Parameterized by
// roots: the corpus walk is run ONE ROOT PER PROCESS (a wet lane kills a whole-corpus walk with
// OOM -- the per-process journal of read+parse dispatches is what grows, so the split is by the
// roots boundary, the population's own partition).
fn argv_word_construction_census_root_paths_for_roots(roots: List<String>) -> List<String> {
  let decls = module_declaration_facts_live(pool_roots: roots)
  let paths_reversed = fold_list(xs: decls, empty: Empty, cons: fn(acc, d) {
    let p = declared_module_path(d: d)
    if p == "" { acc } else { Cons { head: p, tail: acc } }
  })
  list_reverse(xs: paths_reversed)
}

fn argv_word_construction_census_root_paths() -> List<String> {
  argv_word_construction_census_root_paths_for_roots(roots: argv_word_construction_census_roots)
}

// The roster emitter for a wet-lane run (claim_batch --wet): the same discovered population, each
// module walked by the lens, rows written as TSV to the scratch path. The committed roster data
// decl above is filled FROM this output, never by hand from a text search. Hermetic lanes refuse
// the write by design -- the emitter exists for the recount, not for CI.
fn argv_word_construction_census_recount_emit() -> ProcessExit {
  argv_word_construction_for_paths(paths: argv_word_construction_census_root_paths(), out: "target/argv_word_construction_census_recount.tsv")
}

fn argv_word_construction_census_recount_emit_extdeps() -> ProcessExit {
  argv_word_construction_for_paths(paths: argv_word_construction_census_root_paths_for_roots(roots: ["dag/extdeps"]), out: "target/argv_word_construction_census_recount_extdeps.tsv")
}

fn argv_word_construction_census_recount_emit_gunbc() -> ProcessExit {
  argv_word_construction_for_paths(paths: argv_word_construction_census_root_paths_for_roots(roots: ["dag/gunbc"]), out: "target/argv_word_construction_census_recount_gunbc.tsv")
}

fn declared_module_path(d: ModuleDeclarationFact) -> String {
  d.path
}

// The distinct module files named by the committed roster, in first-appearance order: exactly the
// population the bounded-contract claim re-walks, so CI executes the gates at roster size without
// ever walking the whole corpus.
fn argv_word_construction_census_roster_modules() -> List<String> {
  let reversed = fold_list(xs: argv_word_construction_census_roster, empty: Empty, cons: fn(acc, r) {
    if contains_string(xs: acc, x: r.module_file) { acc } else { Cons { head: r.module_file, tail: acc } }
  })
  list_reverse(xs: reversed)
}

fn contains_string(xs: List<String>, x: String) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, y) { acc || (y == x) })
}

type ArgvWordsCollected {
  sites: FreeMonoid<ArgvWordsSite>
  refusals: FreeMonoid<String>
}

fn collect_path(c: ArgvWordsCollected, p: String) -> ArgvWordsCollected {
  match argv_word_construction_module_sites(path: p) {
    ArgvWordsModuleRefused { path: rp, reason: r } =>
      ArgvWordsCollected { sites: c.sites, refusals: Cons { head: concat(concat(concat("REFUSED\t", rp), "\t"), r), tail: c.refusals } }
    ArgvWordsModuleEstablished { path: _, sites: sites } =>
      ArgvWordsCollected { sites: fold_list(xs: sites, empty: c.sites, cons: fn(acc, s) { Cons { head: s, tail: acc } }), refusals: c.refusals }
  }
}

// The contract over an explicit path list: the per-module walk is the lens's; the gates run on the
// collected live sites, and every per-module refusal is named, never dropped. Kept separate from
// the discovery so a bounded recount (one module, one directory) is runnable in a claim test
// without the whole corpus.
fn argv_word_construction_census_check_paths(paths: List<String>) -> ProcessExit {
  let collected = fold_list(xs: paths, empty: ArgvWordsCollected { sites: Empty, refusals: Empty }, cons: collect_path)
  match list_reverse(xs: collected.refusals) {
    Empty => argv_word_construction_census_check_sites(sites: list_reverse(xs: collected.sites))
    nonempty => exit_failure(reason: join_lines(rs: nonempty))
  }
}

fn join_lines(rs: FreeMonoid<String>) -> String {
  fold_list(xs: list_reverse(xs: rs), empty: "", cons: fn(acc, l) { if acc == "" { l } else { concat(concat(acc, "\n"), l) } })
}
