module tools.floor_cost_distribution_instrument

import extdeps.filesystem.filesystem_io
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.measure { Millisecond, millisecond, millisecond_count }
import std.types { Bool, Int, String, NonEmptyStr }
import gunbc.floor_cost_distribution {
  FloorCostRow,
  IdentityEnvelope,
  RunCost,
  RunExtremeCount,
  CostBand,
  LadderStep,
  parse_claim_cost_tsv,
  cost_bands,
  rows_at_or_above,
  runs_refused,
  worst_over_runs,
  module_max_cpu,
  repair_ladder,
  identity_inflation_permille,
  permille_percentile,
  implied_clean_run_budget,
  identity_envelopes,
  complete_envelopes,
  work_invariant_envelopes,
  envelope_permille,
  envelope_permilles,
  worst_envelope_permille,
  run_extreme_census
}

// THE ENTRY POINT FOR docs/plans/floor-cost-distribution-near-the-ceiling.md.
//
// Recipe, and it needs no floor run -- the inputs are artifacts the required floor already
// uploads on every run:
//
//   gh run download <run-id> -n required-floor-claim-cost -D <dir>/<run-id>
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/floor_cost_distribution_instrument.dag \
//     --function floor_cost_distribution_report
//
// WHY THIS IS A SEPARATE MODULE FROM `gunbc.floor_cost_distribution`: reading bytes off disk is a
// realization and the analysis is an interface (DESIGN section 3). The split is what lets the
// witness exercise every derivation on a hand-built fixture with no artifacts present, so the
// evidence does not depend on which runs happen to be downloaded.
//
// AN ABSENT OR UNREADABLE FILE REFUSES AND IS NAMED. It does not contribute an empty population:
// an empty artifact silently emptied a ten-way identity intersection during the original analysis,
// and a run that reads as zero rows is indistinguishable from a run where nothing crossed. That is
// the absorbing fallback DESIGN section 5 forbids, so the arm below is typed and counted.

// THE CEILING CARRIES ITS UNIT. `v2.workflow.required_floor` `required_floor_claim_cpu_safety_limit_ms`
// is the authority for the value; this row is the analysis-side reading of it, and it is a
// Millisecond rather than a bare Int so it cannot be compared against a figure read from another
// clock -- the exact confusion `std.measure` exists to make unwritable.
data floor_cost_ceiling: Millisecond = millisecond(count: 500)

// The default clean-run/contended pair the memo's inflation figures rest on, and the default
// download root. Both are arguments to the functions below; these rows only name the defaults so
// the recipe above is runnable as written.
data floor_cost_artifact_root: String = "/tmp/floor-cost"
data floor_cost_artifact_file: String = "required_floor_claim_cost.tsv"

type RunLoad
  = RunLoaded { run: RunCost }
  | RunUnreadable { run: NonEmptyStr, path: String }
  | RunEmpty { run: NonEmptyStr, path: String }

fn run_cost_path(root: String, run: NonEmptyStr) -> String {
  concat(concat(root, concat("/", run as String)), concat("/", floor_cost_artifact_file))
}

fn load_run_cost(root: String, run: NonEmptyStr) -> RunLoad {
  let path = run_cost_path(root: root, run: run)
  let read = Filesystem.Read(path: path)
  if !read.success {
    RunUnreadable { run: run, path: path }
  } else {
    let rows = parse_claim_cost_tsv(text: read.content)
    if count(rows) == 0 {
      RunEmpty { run: run, path: path }
    } else {
      RunLoaded { run: RunCost { run: run, rows: rows } }
    }
  }
}

fn loaded_runs(loads: List<RunLoad>) -> List<RunCost> {
  loads |> flat_map(l => match l {
    RunLoaded { run: r } => [r]
    RunUnreadable { run: _, path: _ } => []
    RunEmpty { run: _, path: _ } => []
  })
}

fn refused_load_lines(loads: List<RunLoad>) -> List<String> {
  loads |> flat_map(l => match l {
    RunLoaded { run: _ } => []
    RunUnreadable { run: r, path: p } => [concat(concat("REFUSED unreadable run=", r as String), concat(" path=", p))]
    RunEmpty { run: r, path: p } => [concat(concat("REFUSED empty run=", r as String), concat(" path=", p))]
  })
}

fn band_line(b: CostBand) -> String {
  concat(
    concat(to_string(millisecond_count(m: b.lower_ms)), concat("-", to_string(millisecond_count(m: b.upper_ms)))),
    concat("\t", to_string(b.rows))
  )
}

fn ladder_line(s: LadderStep) -> String {
  concat(
    s.removed,
    concat(concat("\tworst=", to_string(millisecond_count(m: s.worst_ms))), concat("\trefused=", to_string(s.runs_refused)))
  )
}

fn percentile_line(values: List<Int>, percent: Int) -> String {
  concat(
    concat("p", to_string(percent)),
    match permille_percentile(values: values, percent: percent) {
      Absent => "\tno-observation"
      Present { value: v } => concat(
        concat("\t", concat(to_string(v), " permille")),
        concat("\tclean-run budget ", concat(to_string(millisecond_count(m: implied_clean_run_budget(ceiling_ms: floor_cost_ceiling, inflation_permille: v))), "ms"))
      )
    }
  )
}

// The whole analysis over one loaded set of runs. `baseline` and `contended` name the pair the
// inflation percentiles are paired over; `repaired` is the counterfactual exclusion set; `order`
// is the ladder's removal order.
fn floor_cost_distribution_lines(
  loads: List<RunLoad>,
  baseline: NonEmptyStr,
  contended: NonEmptyStr,
  repaired: List<String>,
  order: List<String>,
  band_edges: List<Millisecond>,
  min_base_ms: Millisecond
) -> List<String> {
  let runs = loaded_runs(loads: loads)
  let refusals = refused_load_lines(loads: loads)
  let latest = runs |> filter(r => (r.run as String) == (contended as String)) |> first
  concat(
    concat(
      concat(
        [concat("runs loaded\t", to_string(count(runs)))],
        refusals
      ),
      match latest {
        Absent => [concat("REFUSED no population for contended run ", contended as String)]
        Present { value: c } => concat(
          concat(
            [concat("band histogram for run ", c.run as String)],
            cost_bands(rows: c.rows, edges: band_edges) |> map(b => band_line(b: b))
          ),
          [
            concat("rows at or above 300ms\t", to_string(rows_at_or_above(rows: c.rows, ms: millisecond(count: 300)))),
            concat("rows at or above 400ms\t", to_string(rows_at_or_above(rows: c.rows, ms: millisecond(count: 400))))
          ]
        )
      }
    ),
    concat(
      [
        concat("runs refused as observed\t", to_string(runs_refused(runs: runs, ceiling_ms: floor_cost_ceiling, excluded_modules: []))),
        concat("runs refused with the repaired modules excluded\t", to_string(runs_refused(runs: runs, ceiling_ms: floor_cost_ceiling, excluded_modules: repaired))),
        concat("worst row over all runs, repaired excluded\t", to_string(millisecond_count(m: worst_over_runs(runs: runs, excluded_modules: repaired))))
      ],
      concat(
        repair_ladder(runs: runs, ceiling_ms: floor_cost_ceiling, already_excluded: repaired, order: order)
          |> map(s => ladder_line(s: s)),
        match runs |> filter(r => (r.run as String) == (baseline as String)) |> first {
          Absent => [concat("REFUSED no population for baseline run ", baseline as String)]
          Present { value: b } => match latest {
            Absent => []
            Present { value: c } => {
              let infl = identity_inflation_permille(base: b, other: c, min_base_ms: min_base_ms)
              concat(
                [concat("paired inflation observations\t", to_string(count(infl)))],
                [50, 90, 95, 99] |> map(p => percentile_line(values: infl, percent: p))
              )
            }
          }
        }
      )
    )
  )
}

fn floor_cost_distribution_report_for(
  root: String,
  run_ids: List<NonEmptyStr>,
  baseline: NonEmptyStr,
  contended: NonEmptyStr,
  repaired: List<String>,
  order: List<String>
) -> String {
  join(
    floor_cost_distribution_lines(
      loads: run_ids |> map(r => load_run_cost(root: root, run: r)),
      baseline: baseline,
      contended: contended,
      repaired: repaired,
      order: order,
      band_edges: [0, 10, 50, 100, 200, 300, 400, 500, 1000000] |> map(e => millisecond(count: e)),
      min_base_ms: millisecond(count: 50)
    ),
    "\n"
  )
}

// THE ZERO-ARGUMENT ENTRY POINT, so the recipe at the top of this module is runnable as written and
// the memo can cite a producer rather than carry figures.
//
// THE RUN IDS ARE DATA HERE BECAUSE THE FINDING IS ABOUT THESE RUNS. A measurement over "whatever
// happened to be downloaded" is not re-derivable -- a second reader would get different numbers and
// have no way to tell a real change from a different sample. Naming them is the citation.
data floor_cost_sampled_runs: List<NonEmptyStr> = [
  "33668368846" as NonEmptyStr,
  "33670164259" as NonEmptyStr,
  "33673806092" as NonEmptyStr,
  "33680659583" as NonEmptyStr,
  "33681059548" as NonEmptyStr,
  "33682522296" as NonEmptyStr,
  "33683651328" as NonEmptyStr,
  "33688140761" as NonEmptyStr,
  "33690512169" as NonEmptyStr,
  "33691893294" as NonEmptyStr
]

// The clean/contended pair the inflation percentiles are paired over. `33690512169` is the last
// FloorClean run before gunbc#10133 landed; `33691893294` is the merge commit of #10133 and the
// most contended run in the sample, which is why it is the one the band histogram is read from.
data floor_cost_baseline_run: NonEmptyStr = "33690512169" as NonEmptyStr
data floor_cost_contended_run: NonEmptyStr = "33691893294" as NonEmptyStr

// The modules gunbc#10133 repaired. Excluding them replays every run as if the repair had already
// landed, which is what separates the repair's effect from the contention of the run it landed on.
data floor_cost_repaired_modules: List<String> = [
  "test.claim.self_host_compile_phase_live_gate_witness",
  "test.claim.self_host_compile_phase_frontier_witness",
  "test.claim.compiler_frontend_program_status_witness"
]

// Ladder order: remaining modules by max-over-runs cost, worst first.
data floor_cost_ladder_order: List<String> = [
  "v2.test.emit.rust_produced_decl_emit",
  "v2.test.execution.emit_host_field_access_equals_eval",
  "v2.test.execution.emit_host_fold_closure_equals_eval",
  "v2.test.emit.semantic_decl_serialize_parity",
  "v2.test.execution.emit_host_meet_join_equals_eval",
  "v2.test.execution.emit_host_complement_equals_eval",
  "v2.test.emit.produced_decl_two_target",
  "v2.test.execution.emit_host_add_equals_eval",
  "v2.test.emit.semantic_decl_routing_generic",
  "v2.test.claim.enforcement.lens_module_gate_witness"
]

fn floor_cost_distribution_report() -> String {
  floor_cost_distribution_report_for(
    root: floor_cost_artifact_root,
    run_ids: floor_cost_sampled_runs,
    baseline: floor_cost_baseline_run,
    contended: floor_cost_contended_run,
    repaired: floor_cost_repaired_modules,
    order: floor_cost_ladder_order
  )
}

// THE ACTUATOR. It REFUSES when any named run failed to load rather than reporting over whatever
// was readable: a report derived from six of ten runs is a different measurement wearing the same
// name, and the percentiles below it would be a statement about which downloads happened to
// succeed. The refusal names the runs, so the operator's next move is a download and not a guess.
fn floor_cost_distribution_check() -> ProcessExit {
  let loads = floor_cost_sampled_runs |> map(r => load_run_cost(root: floor_cost_artifact_root, run: r))
  let refusals = refused_load_lines(loads: loads)
  if count(refusals) > 0 {
    exit_failure(reason: join(concat(["floor cost distribution: refusing an incomplete sample"], refusals), "\n"))
  } else {
    ExitSuccess
  }
}

// THE BETWEEN-RUN ENVELOPE REPORT, a SECOND entry point rather than more lines on the first,
// because it answers a different question over a different sample. The report above measures ONE
// run's band histogram and ONE pair's inflation; this one measures how far a single identity's cost
// travels across runs, which is the only quantity a budget may be set from.
//
// Recipe -- again no floor run, the artifacts are uploaded by every required-floor run:
//
//   for r in <the run ids in `floor_cost_envelope_sampled_runs`>; do
//     gh run download $r -n required-floor-claim-cost -D /tmp/floor-cost/$r
//   done
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/instruments/floor_cost_distribution_instrument.dag \
//     --function floor_cost_envelope_report
//
// THE RUNNER IS CARRIED BESIDE THE RUN AND IS NOT IN THE ARTIFACT. `required_floor_claim_cost.tsv`
// records no host, so the run-to-runner binding is provenance acquired from
// `repos/gunb-ai/gunbc/actions/runs/<id>/jobs` (`required-witnesses-floor`, field `runner_name`) and
// declared here. It is data rather than prose because the whole question this report exists to
// settle -- whether a verdict is a property of which runner picked up the job -- cannot be asked
// without it, and a host read off a job page into a sentence is unreachable from the census that
// would contradict it.
//
// THE RUNNER NAME IS A HOST PLUS AN EPHEMERAL SUFFIX. `srv1-19-1788450638-2019208` names host
// `srv1-19` and a per-job registration; the suffix differs on every job, so the twelve runs sampled
// here ran on twelve DISTINCT runner registrations across three distinct hosts. Run and runner are
// therefore one-to-one in this sample and cannot be separated by it; HOST can be, and is.
type FloorRunProvenance {
  run: NonEmptyStr
  runner: NonEmptyStr
}

// TWELVE GREEN `main` RUNS OF `witnesses.yml`, 2026-09-03. Green rather than mixed, and `main`
// rather than pull-request, so the population is one the required floor actually admitted: a
// refused run's crossing rows are censored and `v2.workflow.floor_cost_debt` measured that a
// censored figure and the true cost are essentially uncorrelated.
//
// TWELVE RATHER THAN TWO IS THE WHOLE POINT OF THIS ROSTER. The finding that commissioned it rested
// on a single pair of runs, whose percentiles were computed across ROWS inside that one pair and
// therefore described row-to-row heterogeneity rather than run-to-run spread. N runs on N distinct
// runners is the sample that indexes over the right thing.
data floor_cost_envelope_sampled_runs: List<FloorRunProvenance> = [
  FloorRunProvenance { run: "33778067165" as NonEmptyStr, runner: "srv4-06-1788452232-1908277" as NonEmptyStr },
  FloorRunProvenance { run: "33776747244" as NonEmptyStr, runner: "srv4-14-1788451568-1822397" as NonEmptyStr },
  FloorRunProvenance { run: "33775106554" as NonEmptyStr, runner: "srv1-19-1788450638-2019208" as NonEmptyStr },
  FloorRunProvenance { run: "33774684988" as NonEmptyStr, runner: "srv3-11-1788449654-3251019" as NonEmptyStr },
  FloorRunProvenance { run: "33772569940" as NonEmptyStr, runner: "srv1-13-1788448111-660445" as NonEmptyStr },
  FloorRunProvenance { run: "33772503574" as NonEmptyStr, runner: "srv4-01-1788448102-1586464" as NonEmptyStr },
  FloorRunProvenance { run: "33772224705" as NonEmptyStr, runner: "srv3-13-1788442800-3072494" as NonEmptyStr },
  FloorRunProvenance { run: "33772122416" as NonEmptyStr, runner: "srv3-21-1788448106-3180404" as NonEmptyStr },
  FloorRunProvenance { run: "33766436293" as NonEmptyStr, runner: "srv4-09-1788443674-1514295" as NonEmptyStr },
  FloorRunProvenance { run: "33754393519" as NonEmptyStr, runner: "srv3-04-1788436534-2520344" as NonEmptyStr },
  FloorRunProvenance { run: "33749762586" as NonEmptyStr, runner: "srv3-14-1788435102-2419101" as NonEmptyStr },
  FloorRunProvenance { run: "33747598822" as NonEmptyStr, runner: "srv1-03-1788434224-1059575" as NonEmptyStr }
]

// The subject the measurement was commissioned over, named so the report prints its envelope beside
// the corpus percentiles rather than leaving a reader to grep for it.
data floor_cost_envelope_subject: String = "v2.test.emit.rust_produced_decl_emit.rust_produced_decl_name_discriminates"

fn envelope_runner_line(prov: FloorRunProvenance, census: List<RunExtremeCount>) -> String {
  concat(
    concat(prov.run as String, concat("\t", prov.runner as String)),
    match census |> filter(c => (c.run as String) == (prov.run as String)) |> first {
      Absent => "\tno-population"
      Present { value: c } => concat(
        concat("\thottest_for=", to_string(c.hottest_for)),
        concat("\tcoolest_for=", to_string(c.coolest_for))
      )
    }
  )
}

fn envelope_subject_line(envelopes: List<IdentityEnvelope>, subject: String) -> String {
  match envelopes |> filter(e => e.identity == subject) |> first {
    Absent => concat("subject absent from the complete population\t", subject)
    Present { value: e } => concat(
      concat(subject, concat("\truns=", to_string(e.runs_observed))),
      concat(
        concat(concat("\tmin=", to_string(millisecond_count(m: e.min_ms))), concat("ms\tmax=", concat(to_string(millisecond_count(m: e.max_ms)), "ms"))),
        concat(
          concat("\tenvelope=", match envelope_permille(e: e) {
            Absent => "unmeasurable-at-a-zero-baseline"
            Present { value: v } => concat(to_string(v), " permille")
          }),
          concat(concat("\thottest=", e.hottest_run as String), concat("\tcoolest=", e.coolest_run as String))
        )
      )
    )
  }
}

fn floor_cost_envelope_lines(
  loads: List<RunLoad>,
  provenance: List<FloorRunProvenance>,
  min_ms: Millisecond,
  subject: String
) -> List<String> {
  let runs = loaded_runs(loads: loads)
  let refusals = refused_load_lines(loads: loads)
  let all = identity_envelopes(runs: runs)
  let complete = complete_envelopes(envelopes: all, runs_expected: count(provenance), min_ms: min_ms)
  let controlled = work_invariant_envelopes(envelopes: complete)
  let census = run_extreme_census(runs: runs, envelopes: controlled)
  concat(
    concat(
      concat(
        [
          concat("runs loaded\t", to_string(count(runs))),
          concat("identities observed\t", to_string(count(all))),
          concat("identities present in every run and at or above the floor\t", to_string(count(complete))),
          concat("of those, work-invariant across every run\t", to_string(count(controlled)))
        ],
        refusals
      ),
      concat(
        [
          concat("worst between-run inflation observed\t", concat(to_string(worst_envelope_permille(envelopes: controlled)), " permille")),
          envelope_subject_line(envelopes: controlled, subject: subject)
        ],
        [50, 90, 95, 99] |> map(p => percentile_line(values: envelope_permilles(envelopes: controlled), percent: p))
      )
    ),
    concat(
      ["run\trunner\textreme census over the work-invariant population"],
      provenance |> map(prov => envelope_runner_line(prov: prov, census: census))
    )
  )
}

fn floor_cost_envelope_report() -> String {
  join(
    floor_cost_envelope_lines(
      loads: floor_cost_envelope_sampled_runs |> map(p => load_run_cost(root: floor_cost_artifact_root, run: p.run)),
      provenance: floor_cost_envelope_sampled_runs,
      min_ms: millisecond(count: 50),
      subject: floor_cost_envelope_subject
    ),
    "\n"
  )
}

// THE ACTUATOR, refusing an incomplete sample for the reason `floor_cost_distribution_check` states:
// a run that reads as zero rows is indistinguishable from a run in which nothing crossed, and here
// it is worse -- a missing run silently narrows every identity's envelope, which is the direction
// that makes a budget look safer than it is.
fn floor_cost_envelope_check() -> ProcessExit {
  let loads = floor_cost_envelope_sampled_runs |> map(p => load_run_cost(root: floor_cost_artifact_root, run: p.run))
  let refusals = refused_load_lines(loads: loads)
  if count(refusals) > 0 {
    exit_failure(reason: join(concat(["floor cost envelope: refusing an incomplete sample"], refusals), "\n"))
  } else {
    ExitSuccess
  }
}
