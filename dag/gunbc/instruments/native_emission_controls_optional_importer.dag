module gunbc.instruments.native_emission_controls_optional_importer

import std.types { Int }
import gunbc.instruments.native_emission_controls_optional_collision { Optional, CollisionWrapped, CollisionEmpty, collision_row_value }

// THE CROSS-MODULE COLLISION: a module that IMPORTS the non-kernel Optional of
// gunbc.instruments.native_emission_controls_optional_collision and names it BARE in a variant
// payload. The payload reference is a declaration-body member, so a module that imports HeldChoice
// (gunbc.instruments.native_emission_controls) receives it from the type environment's copy with no
// carried declaration. Its denotation is this module's import binding, never the kernel optional
// mint: a resolver that decides an unstamped bare Optional from the leaf, or from the kernel mint's
// row after only a same-file check declined, rebinds it to the kernel declaration and the payload
// realizes as the host Option. The declarer is in ANOTHER file, so a same-file check cannot see it.
type HeldChoice
  = HeldOptional { held: Optional }
  | HeldNothing

data held_wrapped_row: HeldChoice = HeldOptional { held: CollisionWrapped { value: 11 } }

data held_empty_row: HeldChoice = HeldOptional { held: CollisionEmpty }

fn held_choice_value(c: HeldChoice) -> Int {
  match c {
    HeldOptional { held: o } => collision_row_value(o: o)
    HeldNothing => 0 - 1
  }
}
