module gunbc.instruments.native_emission_controls_optional_importer

import std.types { Int }
import gunbc.instruments.native_emission_controls_optional_collision { Optional, CollisionWrapped, CollisionEmpty, collision_row_value }

// THE CROSS-MODULE COLLISION, the resolver repair's red-to-green specimen
// (gunbc.recurring_failure_mode.an_imported_name_shadowed_by_a_kernel_name). This module imports the
// non-kernel Optional of gunbc.instruments.native_emission_controls_optional_collision BY NAME and
// names it bare in a variant payload, and the v1 resolver types that payload two ways: the field
// binding (v1.compiler.infer_env lookup_binding) takes the import, while the type environment's copy
// of HeldChoice, resolved by name through the overlay where the kernel layer sits above imports,
// takes the kernel Optional mint. Emitted, the module renders HeldChoice<present_value>, the mint's
// type variable, and does not build (measured on gunbc#13454). It is therefore outside the
// gunbc.instruments.native_emission_controls closure until the resolver refuses or unifies the
// collision at the import; the emitter's own order is pinned meanwhile by the unit control
// unstamped_bare_optional_follows_the_lookup_binding_order.
type HeldChoice
  = HeldOptional { held: Optional }
  | HeldNothing

data held_wrapped_row: HeldChoice = HeldOptional { held: CollisionWrapped { value: 11 } }

data held_empty_row: HeldChoice = HeldOptional { held: CollisionEmpty }

fn held_choice_value(c: HeldChoice) -> Int {
  match c {
    HeldOptional { held: o } => collision_row_value(o: o)
    HeldNothing => 0 - 1
  }
}
