module gunbc.recurring_failure_mode

// ONE ROW PER FAILURE CLASS, BECAUSE ONE SENTENCE PER FLEET WAS THE DEFECT.
//
// These classes lived in a single 11,751-character `p(text:)` blob in gunbc.design_document. Every
// lane that named a new class appended to that one line, so two lanes naming two UNRELATED classes
// collided on every merge -- five conflict cycles on one PR in one night, every resolution purely
// additive, zero sentences ever lost. That is textual contention standing in for semantic
// contention: the classes are independent, and only the line was shared. Split into rows, two lanes
// touch two declarations and never collide, while two lanes editing the SAME class still conflict --
// which is correct, because that is real disagreement about one fact (DESIGN section 2).
//
// THIS CUT IS MECHANICAL AND ITS ORACLE IS AN EMPTY DIFF. Each row carries its authored sentence
// BYTE-FOR-BYTE and the projection renders them in roster order, so regenerating DESIGN.md after the
// split produces no change at all. Sorting the rows by identity would reorder the paragraph and
// destroy that oracle -- a projection defect would then be indistinguishable from an intended edit --
// so order is carried by the roster and determinism comes from the roster being source-ordered.
//
// WHAT IS DELIBERATELY ABSENT: the analytic fields (misleading surface, actual question, failure
// mechanism, required guard) that these rows will eventually carry. Filling them for seventeen
// classes means authoring analysis that does not exist in the text today, which is semantic
// rewriting inside a structural cut and has no oracle. They land in a follow-up where each class is
// a readable diff.
//
// WHY `evidence` STAYS EMPTY ON EVERY ROW, recorded so the next author does not fill in seventeen
// empty lists and call it citation hygiene. The field is a typed `DeclarationRef` list and a typed
// citation is genuinely better than a symbol spelled inside `authored` -- but measured today,
// nothing resolves it and nobody reads it. `v2.lens.cited_symbol_resolution` takes its population
// from `hand_authored_production_doc_declaration_refs` (HandAuthoredDocBind primary_work plus
// additional_works) and this carrier is not in it; `gunbc.design_document` projects `.authored`
// alone, so a populated `evidence` renders nowhere; and that lens has not executed on a push since
// the 2026-08-23 directive deleted its job, which its own `cited_symbol_required_check_note`
// records as a declared rung drop to mitigatable. A citation that no resolver covers and no reader
// sees is not partial coverage -- it is the decoration DESIGN section 4b calls worse than absent,
// because it will be cited as coverage. THE OCCASION MATTERS: this was decided in the diff that
// repaired a specimen whose whole defect was three symbols nothing ever checked, and populating an
// unchecked field there would have reproduced the finding inside its own repair.
// dissolve-on: the cited-symbol law's own trigger -- enrollment widens to every structural
// DeclarationRef carrier when the Node-tree reader lands. At that point these rows carry resolvable
// evidence and the symbols in `authored` become the redundant half.

import std.types { String, NonEmptyStr, List }
import std.decl_ref { DeclarationRef }

type RecurringFailureMode {
  identity: NonEmptyStr
  authored: String
  evidence: List<DeclarationRef>
}

data hollow_alias: RecurringFailureMode = RecurringFailureMode {
  identity: "hollow_alias" as NonEmptyStr,
  authored: "hollow alias (minimality ≠ grounding)",
  evidence: [],
}

data state_space_conflation: RecurringFailureMode = RecurringFailureMode {
  identity: "state_space_conflation" as NonEmptyStr,
  authored: "state-space conflation (an `Option`/`None` meaning >2 things — split into named variants; its most-repeated form here is **not-applicable rendered as malformed** — one reason symbol over \"the input is wrong\" and \"this strategy had nothing to say about it\", which have opposite owners and opposite repairs. Found three times in three stages by one lane (#8801 and #8828 in body lowering, `parse_g0_tokens_remain` in parse), always by reading the producer and never from the message. Recognition rule: if the arm sits downstream of a search, lookup or alternative that returned `Absent`, it is not-applicable and needs its own reason. A SECOND FORM, which does not match that shape and is the same class: **a dichotomy stated over a domain with three states.** Specimen (gunbc#9324): the `floor_resource_sample` comment documented `pswpin` rising with `pgmajfault` as swap and `pgmajfault` rising with `pswpin` flat as mapping churn — two arms over three states, since BOTH FLAT is quiet. Churn is a defect this lane owns and quiet is the absence of one, so the missing arm inverts the verdict. The mechanism of the misread is what the recognition rule keys on: `pgmajfault rises` and `pswpin flat` are two conditions and only their CONJUNCTION is churn, so a reader matching on the cheaper condition alone selects churn for a state that satisfies `pswpin flat` and nothing else — which zero-and-zero does. **Recognition rule for this form: for every arm of a stated dichotomy, enumerate the domain and check that each arm's conditions are required jointly.** What made it invisible rather than merely wrong is that BOTH readers landed on the same arm — 26 intervals so classified by one and 6 by another, neither having compared notes — and agreement reads as confirmation. THAT IS A PROMPT TO RE-DERIVE, NOT A DIAGNOSTIC, and the distinction is load-bearing: convergent readings are equally produced by shared assumptions, a common heuristic, ambiguity in the subject, or one reader having anchored on the other, and n=2 on one specimen cannot separate those from a defect in the rule. What survives is only the weaker direction — agreement between readers of one rule is not independent evidence about that rule, because the shared input is a shared potential defect, so it licenses re-deriving from the domain and never a conclusion about which cause produced it.)",
  evidence: [],
}

data absorbing_fallback: RecurringFailureMode = RecurringFailureMode {
  identity: "absorbing_fallback" as NonEmptyStr,
  authored: "absorbing fallback (a failure arm that widens — rerun everything, scan all keys, always run — instead of refusing; ⊤-as-answer conflated with ⊤-as-ignorance; the deficit's frequency zeroed by construction, the corpus-denominated cost breaking the budget later)",
  evidence: [],
}

data empty_observation_narrow: RecurringFailureMode = RecurringFailureMode {
  identity: "empty_observation_narrow" as NonEmptyStr,
  authored: "**empty-observation narrow** (the absorbing fallback's mirror: ⊥-as-answer conflated with ⊥-as-ignorance — an observation that could not express what changed rendered as the verdict \"nothing is affected\", so the run narrows to nothing instead of widening. Strictly worse than the widen §5 already forbids: a widen is merely expensive, a narrow is silently uncovered. Live specimen: a push whose baseline ref *is* the pushed ref diffs the commit against itself, and the witness floor reported the resulting zero-path observation as \"N unaffected (import-closure, skipped without resolve)\" — receipt, two main pushes reporting an identical `4118 unaffected` on different commits, a skip count that cannot be a function of the diff. The tell that one observation is wrong rather than three local choices reasonable: its consumers disagree — compile-clean widened to whole-tree, regen gated on the event name, the witness floor skipped)",
  evidence: [],
}

data cache_impurity: RecurringFailureMode = RecurringFailureMode {
  identity: "cache_impurity" as NonEmptyStr,
  authored: "cache impurity (key on declared-input content; byte-identical cached-vs-cold is the purity oracle)",
  evidence: [],
}

data reflection_evidence_structural_proof: RecurringFailureMode = RecurringFailureMode {
  identity: "reflection_evidence_structural_proof" as NonEmptyStr,
  authored: "reflection evidence ≠ structural proof (prove a read axis by execution, with a no-host-enumeration control)",
  evidence: [],
}

data coercion_proven_by_normalized_round_trip: RecurringFailureMode = RecurringFailureMode {
  identity: "coercion_proven_by_normalized_round_trip" as NonEmptyStr,
  authored: "coercion proven by normalized round-trip, not a golden string",
  evidence: [],
}

data parallel_representation_debt: RecurringFailureMode = RecurringFailureMode {
  identity: "parallel_representation_debt" as NonEmptyStr,
  authored: "parallel-representation debt (an honestly-marked scaffold duplicating a canonical fact is still a violation)",
  evidence: [],
}

data internal_review_finds_missing_tests_external: RecurringFailureMode = RecurringFailureMode {
  identity: "internal_review_finds_missing_tests_external" as NonEmptyStr,
  authored: "internal review finds missing tests, external review finds missing checks",
  evidence: [],
}

data unmarked_workaround: RecurringFailureMode = RecurringFailureMode {
  identity: "unmarked_workaround" as NonEmptyStr,
  authored: "unmarked workaround (an author-side absorbing fallback — routing around an obstacle with no dissolution trigger; the line-stop signal, never a landing state)",
  evidence: [],
}

data self_authorized_dissolution: RecurringFailureMode = RecurringFailureMode {
  identity: "self_authorized_dissolution" as NonEmptyStr,
  authored: "**self-authorized dissolution** (temporary work treated as admissible because the author named its future deletion — a trigger is a lifecycle fact, not permission; without an operator verdict, marked debt is rejected exactly like unmarked debt)",
  evidence: [],
}

data positional_citation: RecurringFailureMode = RecurringFailureMode {
  identity: "positional_citation" as NonEmptyStr,
  authored: "positional citation (a `file:line` pointer where a symbol was available — see §3).",
  evidence: [],
}

data bound_shaped_closure: RecurringFailureMode = RecurringFailureMode {
  identity: "bound_shaped_closure" as NonEmptyStr,
  authored: "**bound-shaped closure** (a requirement is satisfied by a number that is real, and the row it satisfies stops ranking for work. Distinct from prefix-of-the-truth, which is about what a PRODUCER reports: this is about what a CONSUMER concludes from a satisfied clause. Receipt (gunbc#9418): §4b(3) asks a declared drop for a bounded population; a whole-root emit census answers three; the emitter's first gate had returned ahead of every later check, and clearing it showed eight more that had been standing the whole time. Publishing three as THE population would have discharged 4b(3) with an honest measurement and left the class reading as closed — worse than the UNCOUNTED it replaced, because an unmet clause still ranks and a met one does not. The tell is that the satisfying figure comes from a mechanism that STOPS: a first match, an early return, a capped scan, a truncated list. **Recognition rule: before a number discharges a requirement, ask what the producer does AFTER it has enough to answer — if it returns, the number bounds the producer's patience and not the population.**)",
  evidence: [],
}

data authority_substitution: RecurringFailureMode = RecurringFailureMode {
  identity: "authority_substitution" as NonEmptyStr,
  authored: "**authority substitution** (fact F lives in carrier A; operation O is governed by carrier B; A is cited as the evidence that O changed; no A→B relation is claimed by either carrier. Nothing asserted is false — the *entailment* is invented, which is why review reads past it: both halves check out and only the arrow between them is missing. It is §3's single-authority rule read in the direction authors actually violate it — not two authorities for one fact, but one authority borrowed to answer for another's. Receipt (gunbc#8865): an expecting-red probe was enrolled in `gunbc.explicit_witness_admission`, which DOCUMENTS a known red, and the PR asserted the required floor therefore held it; the floor gates on `v2.workflow.floor_expected_red` and nothing relates the two, so CI went red on a row its author had recorded as expected. The general tell is a sentence of the form *I registered it in A, so B now does X* where B is never named — and its structural fix is never a broader guard joining every A row to B, since that manufactures exactly the entailment being invented; the guard must carry the narrow predicate, with its exceptions declared.)",
  evidence: [],
}

data reachability_read_as_occupancy: RecurringFailureMode = RecurringFailureMode {
  identity: "reachability_read_as_occupancy" as NonEmptyStr,
  authored: "**reachability read as occupancy** (a guard's arm, disposition or check is deleted because nothing currently lands in it. Three questions are in play and only the first two decide whether it should exist: *mechanism existence* — can any governing authority produce this state; *join reachability* — can that mechanism classify an element of THIS operation's denominator; *current occupancy* — does anything receive it today. **Yes / yes / zero is a healthy guard being quiet, not a dead one**, and deleting it removes a live wall while looking principled. The distinction is load-bearing because it borders a true rule pointing the other way: a check whose RED IS UNREACHABLE — no authorable input can produce it — is a decoration, permanently green and worse than absent, because it is cited as coverage. Unreachable means the red cannot be produced at all; empty means it can and nothing does. Two corollaries, each from a lane that got it wrong first. Reachability is judged against what a FIXTURE MAY AUTHOR, never what the accepted corpus contains — a regression probe is an invalid program by definition, so a state no `Accepted` program holds is usually still authorable as source, and scoping reachability to corpus-expressible is this same conflation one layer out. And an arm is reachable relative to ONE operation: `gunbc.scm`'s path-exclusion disposition is unreachable from the floor's own fold, which drops excluded subjects before inventory, yet reachable from a join over admission ROWS, which exclusion never removes — so *the arm's reachability is a property of the denominator of the operation that returns it, not of what some lower mechanism observes internally*. Both halves were found the same day by separate lanes, from opposite directions. **THE DISCRIMINATING COUNTER-SPECIMEN, which this row needed and did not have (gunbc XL-0-RECEIPT, 2026-09-01):** `gunbc.floor_component_receipt` and `gunbc.floor_component_receipt_document` were a well-built pair — schema, artifact name, path, a typed subject carrying workflow name / run id / head sha, a decoder with typed `ReceiptMemberAbsent` and `ReceiptMemberMalformed` causes, and an event-subject join refusing over three distinct mismatch arms. Read against the three questions the answer is not yes/yes/zero but **NO at the first**: nothing anywhere writes `target/floor-component-receipt.json`, no Rust carries the schema string, and `witnesses.yml` uploads four artifacts of which the receipt is not one. Their reader was the `falsifier-alert.yml` job, deleted in the 2026-08-15 CI cut. **The join is UNREACHABLE, not merely unoccupied, and that is the whole difference between retiring a dead model and deleting a live guard** — a quiet guard has a producer that could fill it, this had none. The census must be run per medium, since a survivor stops being reached silently: import graph (only its own witness test), `*_test.dag` discovery (that test is a PEER of the subject, not a guard over a survivor), workflow argv, Cargo `[[bin]]`, Rust (one string literal used as a test label, not a call), and roster rows (two `gunbc.non_fold_residue` frontier rows). **The second, costlier half — what the prose did while the model sat dead — is its own class and is rostered separately as `unbacked_execution_claim`;** what belongs HERE is only the consequence for this rule: a dead model is not harmless while it waits, because **a good model with no consumer is still residue (§6), and residue that describes itself in the present tense actively manufactures false premises.** Disposition landed: both modules and their witness test deleted, the two frontier rows removed, and every surviving citation of them rewritten to the past tense with the deletion and its date recorded — because a citation left naming a deleted symbol fakes a grep hit for the next reader.)",
  evidence: [],
}

data total_at_the_level_examined_blind: RecurringFailureMode = RecurringFailureMode {
  identity: "total_at_the_level_examined_blind" as NonEmptyStr,
  authored: "**total at the level examined, blind one level down** (a judgment is exhaustive over the type it matches and says nothing about the distinction that actually decides the outcome, which lives inside one of its arms. **The pairing is the whole content: the match is exhaustive AND wrong**, and the exhaustiveness is what hides it — there is no missing arm to report, no warning, nothing incomplete, so neither a reviewer reading the match nor a wildcard-free lens can see it. Specimen with a mutation receipt (gunbc.scm, 2026-08-22), **repaired on main 2026-08-25 by gunbc#8973 and kept in the past tense because the mechanism recurs while this instance does not**: a publication fold matched one outer arm carrying a JSON codec's entire refusal enum. It was total over that codec's refusal type, and the enum's arms carried three different publication remedies — a reader limitation, an absent-object problem over a well-formed document, and malformed bytes. Only the third may supersede a head slot, so the collapsed form let an OLDER READER OVERWRITE A NEWER WRITER'S DOCUMENT: data loss produced by the reader's own limitation, from a match that compiled and looked complete. Executed both ways — descending, four witnesses passed; collapsed, the witness driving all three remedies through the single outer arm went red; a temporary decode arm made the fold non-exhaustive; restored control passed. **None of this row's three cited symbols resolved on main, and they failed in two different ways** — measured across main's whole history, not just its head. `repository_load_disposition`, the function this row said performed the collapse, has NEVER existed as code on main: it appears only in this carrier and in the projection, and it names a declaration from the CLOSED attempt gunbc#8940, whose branch was retained in history and never landed. So the row cited a function that was fabricated on the day it was written. `RepositoryDecodeImageRefusal` and `ImageRefusal` were real — they landed with gunbc#8807 and gunbc#8840 and were deleted by gunbc#8965 on 2026-08-23 when the fused format was cut — so those two went stale one day later, by the ordinary route a citation rots when the thing it names is removed. The two halves matter separately because they have different remedies: a fabricated name is caught by resolving symbols before writing them, a deleted one only by a resolver that reruns. Either way a reader applying this entry's own recognition rule grepped for a match that was not there. That is §3's stale-citation class sitting inside the authority that names it, and it is recorded here rather than quietly deleted because a specimen whose symbols cannot be resolved is the failure this row exists to teach, one level up. **What landed is stronger than descending**, and the difference is the reusable part: the remedy vocabulary was hoisted into a module that names no format — `gunbc.scm.load_standing` `LoadStanding`, and each format now classifies its own refusals into it (`gunbc.scm.commit_closure_json_v2` `closure_document_load_standing`). Descending inside one codec's enum would have closed the collapse and left the consumer still matching on a format's vocabulary; hoisting leaves the consumer no format arms to collapse, so the next format is a new classifier rather than a new way to reintroduce this defect. **THE HOISTING WAS NECESSARY AND NOT SUFFICIENT, and this sentence is the fourth citation in this row to have gone stale.** It read that the permission was derived `by one total function`, naming `standing_may_supersede_generation` — a `LoadStanding -> Bool` carrying neither the slot the observation was made on nor the generation examined, so a caller could apply it to a slot the evidence never described or to a generation that had moved since it was read. gunbc#9258 deleted it and replaced the destination with `gunbc.scm.supersession` `supersede_head_slot`, where evidence is minted FROM the slot by `observe_generation` — a caller cannot state which generation it examined, only examine one — and the swap refuses unless the slot still holds it. The deletion left this sentence naming a declaration that no longer resolves, one day after it was written, which is the same rot this row already records twice above and is corrected here for the same reason. Second, independent specimen the same day, in the compiler itself: a census of the fourteen declared-type positions the grammar admits found five accepting a plain kernel value where a coproduct is declared — the judgment is present and total at the level it examines, and never descends. **The tell is a `_` or a bare binding in the arm that carries the payload**, and the test is not whether the match is complete but whether every cause it collapses shares one remedy; the fix is to descend so a new inner arm fails to compile HERE, rather than silently inheriting whichever remedy the outer arm happened to name.)",
  evidence: [],
}

data execution_provenance_loss: RecurringFailureMode = RecurringFailureMode {
  identity: "execution_provenance_loss" as NonEmptyStr,
  authored: "**execution-provenance loss** (a reported value is consumed as though an observation produced it, while the carrier holds no proof the observation path ran. **Distinct from state-space conflation, and the repair law is what separates them**: there the carrier cannot represent the distinction and the fix is to split the states; here the carrier already has the state — the consumer simply cannot tell whether it was *reached*, and the fix is to bind an execution receipt to the value. Three specimens in one night, all on main, none of them a missing variant. `known_red_held=206` is `36 held + 170 that RUNTIME-ERRORED`: the substrate splits those into distinct arms, so the states exist; what the quoted figure loses is *did the assertion run*, and an expected-red row that threw is not evidence the red is expected — it is a row whose assertion never executed. A floor whose `TerminalLedgerUnrenderable` count is `0` reads identically whether the ledger checks passed or preparation refused before a ledger existed. And a `.dag` board of `E0599=23 E0308=128` reads identically whether cargo ran or normalize refused upstream of it. **The receipt that makes this worth a row rather than a caution:** for three hours after #8976 put a §4c-illegal annotation inside a match body, the compiler refused at strict preparation while downstream measurements kept producing valid-looking values — one lane concluded a defect was closed, another concluded the same defect was still firing, both citing runs where it could not appear at all; three separate A/B comparisons reported perfect agreement, one because both arms were broken identically, one because a missing flag meant no arm executed, and one because the defect had been fixed between runs so both arms were the same bytes. Every one of those is downstream of a single fact: **a masked run and a clean run rendered identically.** Recognition rule: if a count of zero and an unreached stage produce the same output, the number is not an observation. The construction move, and it is stronger than naming known masks because it also forecloses the undiscovered ones: any stage capable of preventing a downstream observation from executing must participate in the observation carrier, so `refused before stage N` cannot inhabit the same carrier as `stage N executed with zero findings` — a known mask is a hole someone found, execution provenance is what stops an unfound hole from masquerading as a measurement.)",
  evidence: [],
}

data remediation_mutated_view: RecurringFailureMode = RecurringFailureMode {
  identity: "remediation_mutated_view" as NonEmptyStr,
  authored: "remediation-mutated view (the standard response to a signal OVERWRITES the surface most readers query it through, so the population becomes unreconstructible AT THAT LEVEL and the reader concludes the evidence is gone. It usually is not: the defect is reading a MUTABLE PROJECTION as if it were the record, and a level below it there is generally an immutable one the same query reaches intact. Receipt, and the inversion belongs BESIDE it rather than after it: a fleet event terminated eight witnesses runs inside 49 seconds; every lane re-ran; a re-run REPLAYS the original merge ref and OVERWRITES the run-level conclusion, so queried through run conclusions the population was invisible -- zero of twenty-one -- while queried through the run's attempt records it was complete and exact hours later. Two independent reconstructions from the mutated view reported five and six of the eight: each correct, each incomplete, same cause -- so the mutated view fails SILENTLY and PARTIALLY, which is worse than failing empty. The rule is therefore NOT capture-or-lose-it: capture before remediating, or reconstruct from the immutable record, never from the mutable one. Stating only the first half is worse than saying nothing, because a lane that has already remediated reads it as a verdict that its evidence is gone and stops looking -- which is what produced the zero of twenty-one. Recognition rule: before concluding a population is unrecoverable, ask WHICH LEVEL you queried and whether the remedy WRITES to it.)",
  evidence: [],
}

data diagnostic_name_mechanism_silent: RecurringFailureMode = RecurringFailureMode {
  identity: "diagnostic_name_mechanism_silent" as NonEmptyStr,
  authored: "diagnostic name accurate about the situation, silent about the mechanism (a diagnostic's NAME describes the state it was raised in faithfully and says nothing about WHICH PREDICATE produced it, so a reader who treats the name as a cause builds a coherent story with no load-bearing contact with the code. Nothing in the name is wrong, which is why review reads past it. THREE RECEIPTS IN ONE NIGHT FROM THREE READERS, provenance stated per receipt because a row about untraced names must not itself rest on an untraced relay. FIRST, measured by this row's author, and it leads because the reader was the author of the story: rustc labels reading `expected Rc<Vector<i64>>, found String` at 49 sites plus 2 reversed, from which a representation fork was inferred -- the model type `Symbol` rendering as `String` in parameter position and a vector in field position -- and published. Measured: `Symbol` renders CONSISTENTLY as `String`, `Connective.Atom` carries `identity: String`, and the `.dag` is well-typed with the same declared type on both sides. The published mechanism was wrong; the label was a faithful description of a mismatch the type-checker had computed. AND THE CHECK FAILED THE SAME WAY THE READING DID, which is the most instructive part rather than decoration: a grep for the printed type name returned zero and zero was read as absence, when the emitted source spells `Rc<Vec<i64>>` and `lib.rs` carries `use im::Vector as Vec`, so rustc was printing the resolved underlying name. A name was read as a fact about the tree twice in one investigation, once in the diagnostic and once in the refutation of it. WHAT THE 49 SITES ACTUALLY ARE, and it is UNCHASED: `Rc<Vec<i64>>` is how `List<Int>` renders, so they read expected `List<Int>` found `String` -- an ordinary mechanism, and a real one. The amendment closed the wrong explanation, not the defect. SECOND, reported by quick-bat-372 and independently verified: `MethodNotFound` names the situation correctly and does not say which predicate gates it -- `method_existence_decision` gates on `kernel_profile_lookup`, so a fully resolved USER product with no kernel profile answers `MethodExistenceUndecided`. THIRD, same provenance: `FieldNotFound` names a concept never emitted for field ACCESS at all, established by exhausting its three construction sites -- two pattern bindings and one guarded by a record literal's field names. WHY IT EARNS A ROW: two of the three would have shipped as PERMANENTLY-GREEN WITNESS ARMS, an assertion that a wall fired over a wall that cannot fire for that input, which is section 4b's decoration-cited-as-coverage reached by a route no other row names -- and all three were caught by reading the PRODUCER rather than by review. WHAT IS NOT CLAIMED: three instances in one night is a suggestive rate and not a base rate; all three surfaced while several lanes were unusually deep in diagnostic populations, so the frequency is a property of that work rather than of the corpus. Recognition rule: before treating a diagnostic name as a mechanism, read the function that produces it and find the predicate that gates it; if you cannot name that predicate, you have a situation and not a cause. A grep for the type name is a cheap first pass, not a sufficient check: rustc prints resolved names while source spells aliases, so `use X as Y` defeats the search in both directions and a zero can be confident and wrong. Read the producer. AMENDED 2026-08-28 -- THE PRODUCER'S OWN PROSE IS ALSO A NAME, so `read the producer` is necessary and NOT SUFFICIENT. The three receipts above are all DIAGNOSTIC names; the same failure reaches COMMENTS, and it is harder to see there because a comment is where a reader goes to ESCAPE the name. Two variants, and the ranking is the whole point. STALE prose is FALSIFIABLE BY READING: what it says is contradicted by the code as it stands, so a reader who checks the producer can always catch it. THAT IS NOT THE SAME AS SELF-CORRECTING, and an earlier revision of this row said it was -- `it rots when the code moves, and whoever next touches that code notices` -- which THIS ROW'S OWN SECOND RECEIPT REFUTES (review 57329): the deleted/still-here contradiction is LIVE in the tree today, and it was found by a reader who had gone there for an unrelated reason, NOT by the next person to touch the code. So the ranking below is about FALSIFIABILITY and not about correction rate. Stale prose persists exactly as long as nobody reads it, which is indefinitely; what makes it the lesser of the two is that a reader who does check is guaranteed to see the disagreement. WRONG-MECHANISM-CORRECT-CONCLUSION is NOT self-limiting: nothing it says is falsified by moving the code, so it survives every refactor, and the defect it names really existing READS AS CONFIRMATION of the explanation it gives -- load-bearing misinformation with a correct headline, routing every future reader to the wrong repair. RECEIPT, read independently by three readers rather than relayed: the comment above the floor's live-tree scan says its two computations `cannot agree except by coincidence` because one is a syntactic scan and the other falls through to `effect_reach_derived_reads_live_tree_for_entry`, a SEMANTIC reachability derivation -- locating the cause in the import graph. Read the control flow: `reads_live_tree_effective` calls `parse_entry_live_tree_disposition` first, and an UNDECLARED file reaches `Ok(declared.unwrap_or(true))`, so the function RETURNS before the derivation is consulted. The largest and simplest disagreement class is decided before the import graph is reached, and the mechanism the comment names has nothing to do with it. A SECOND RECEIPT FROM THE SAME PARAGRAPH, in the stale variant: it states the floor's copy is DELETED rather than reconciled, in the past tense, four lines above a section headed WHY IT IS STILL HERE explaining that the scan is live. RECOGNITION RULE, extending the one above rather than replacing it: THE CODE PATH IS THE FACT, and every sentence around it -- in a note, in a doc, or in the producer's own comment -- is commentary that may be stale or may be wrong about WHY. And having reached the producer, do not stop at the sentence that confirms your framing: this amendment exists because a reader quoted IT IS NO WALL from such a comment and dropped `and it is a partial classifier, not an enforcement` from four lines below, inside the same citation.)",
  evidence: [],
}

data identity_absent_graph_traversal: RecurringFailureMode = RecurringFailureMode {
  identity: "identity_absent_graph_traversal" as NonEmptyStr,
  authored: "identity-absent graph traversal (a walk over a graph the COMPILER built re-enters shared nodes because it cannot carry a `visited` or memo key — the nodes have no identity the model is allowed to name — so the only two arms available locally are to PAY the re-entry, or to key on a substitute the substrate forbids. THE TRAP IS THAT THE ARMS DIFFER IN KIND AND THE CHEAP-LOOKING ONE IS THE UNSAFE ONE: paying is a cost, visible and bounded; keying on a substitute silently skips a DISTINCT node believed already visited, drops whatever that node contributed, and reports nothing. THE MECHANISM, structural and checkable by reading rather than by measurement: `v1.compiler.infer_emit_info` `collect_type_node_import_surface_names` recurses on BOTH `children` AND the `inferred` resolved node, so a shared type DAG is traversed as a tree and a node reachable by k paths is walked k times. The key does not exist. `std.occurrence_identity` `occurrence_identity_scope_law` names filename, SourceSpan, authored name, structural Node equality and content hash as FORBIDDEN identity inputs, and `NodeOccurrenceIdentity` `OccurrenceSynthetic` — which is what the compiler mints for a node no author wrote — carries no id at all, so every synthesised node compares equal to every other and a visited set built on it would skip the wrong one. The remaining candidate is host allocation identity, which exists only in the realization and not in the model. RUNG: OUTSIDE THE LADDER, and the earlier revision of this row said `mitigatable`, which was inflation of exactly the kind section 4b(1) names. The invalid state is writable, nothing refuses it, and its failure is a silent skip — section 4b puts silent wrongness outside the ladder rather than low on it. What that revision offered as the mitigation was that no author has yet needed such a traversal and that review might catch one; neither is containment by a total operation, a typed outcome, a bound, a rollback or an isolation, and no discriminating RED exists on any acceptance path, so no rung above the floor is claimable by executed evidence. ONE PARTIAL CONTAINMENT IS REAL AND DOES NOT LIFT THE CLASS: at the measured seam a dropped name reaches an emitted Rust crate, where rustc refuses it as E0422/E0425/E0433 far from the cause, and the regen byte-identity gate would show the drift. That is a property of THAT seam's consumer being a compiled artifact, not of the class — a traversal whose consumer is a verdict rather than a compilation has no such backstop — and section 4b sets a class's rung at the MINIMUM across its in-scope paths. CEILING: structural impossibility, and per section 4b(3) the trigger names the CAPABILITY rather than an artifact — an identity for synthesised occurrences, sufficient for a `visited` set over inferred type nodes to be authorable in `.dag` at all. Nothing less retires it: a faster traversal, a memo at one seam, or a counter measuring the amplification all leave the key absent and the unsafe arm equally reachable. An intermediate rung is available and is NOT claimed here because nothing implements it: a typed refusal at the traversal seam would make the class mechanically preventable while leaving the invalid state writable. THE ESCAPES THAT LOOK AVAILABLE AND ARE NOT, listed because this class is mostly discovered by trying them, and each was closed by EXECUTION rather than by argument — deleting the producer, replacing it with the cheaper sub-producers beside it, reading `TypeSummary.field_import_surface_names` instead (which is CIRCULAR, being produced BY this walk in `build_field_type_map`, and answers a different relation), and hoisting the work earlier (there is nothing to hoist: each item belongs to one module and each module is emitted once). Two further hypotheses about the COST were falsified the same way and are worth not repeating: the list-copy lowering, and the match-scrutinee deep clone. The measured populations, the amplification, the per-escape figures and the two falsifications are recorded once, dated, with their method and their non-enrollment stated, in the plan document `emit-type-surface-traversal-cost`, which is bound to this traversal and its two consumers in `gunbc.doc_graph_roots` and retires when they move; they are deliberately not transcribed here, because a number copied into a roster row is the positional-citation failure one entry up wearing different clothes. RECOGNITION RULE: when you reach for a visited or memo key over a graph the compiler built rather than the author wrote, enumerate the keys available to you; if every candidate is one the identity authority forbids, the deficit is upstream in the identity algebra and NEITHER local arm is a repair — the amplification is the symptom and the missing identity is the class.)",
  evidence: [],
}

data resolved_reference_outside_execution_closure: RecurringFailureMode = RecurringFailureMode {
  identity: "resolved_reference_outside_execution_closure" as NonEmptyStr,
  authored: "resolved reference outside the execution closure (an Accepted program contains a resolved call edge whose target declaration's OWNER MODULE is absent from the module closure loaded for that execution, so resolve and typecheck both report success and the program dies at run time. MECHANISM: bare-reference resolution consults a declaration population BROADER than the explicit-import closure from which the runtime index is built, so the two phases answer to two different denominators and nothing joins them. THE SPECIMEN, found by execution rather than by reading, and recorded here because a class whose only evidence is an argument is not a class: three witness files -- test.claim.spark_serving_observe_witness_test, test.claim.spark_serving_model_store_witness_test and test.claim.spark.spark_cell_role_retirement_witness_test -- CALLED hermetic_fixture_provenance with no import of the module declaring it. Resolve accepted them, typecheck accepted them, and every claim reaching the call refused at run time with `no declaration named hermetic_fixture_provenance in this execution's loaded index (searched the modules loaded for this run; the name may be declared in a module this run did not load)`. The positive control is exact and cheap: adding the one import admits and executes the UNCHANGED call. WHY IT IS NOT ONE OF THE ROWS BESIDE IT, checked rather than assumed. It is not `reachability_read_as_occupancy`: nothing here mistook reachability for occupancy, and the declaration is genuinely reachable AND genuinely resolved. It is not `identity_absent_graph_traversal`: the declaration exists, has an identity, and that identity is found -- what is absent is the RELATION from the resolved target to the modules the execution loader materializes. This is the missing agreement between two denominators, not the occupancy of either one. RUNG, SCOPED AND NOT INFLATED: mitigatable at the source-to-witness-execution grain the specimen demonstrates, where the runtime refusal is typed, located and loud. THE LANGUAGE-WIDE RUNG IS NOT CLAIMED and the reason is a control that has not been run: place an observable EFFECT before the unloaded call and see whether it executes before the refusal. If it does, the class is not mitigatable at that grain without preflight or rollback, because the failure arrives after the program has already acted. Until that control answers, this row's rung is a statement about witness execution and nothing wider. CEILING: structurally guaranteed rather than structurally impossible -- source can still omit an import, so the state stays writable, but no Accepted program should contain the edge. NEXT-RUNG TRIGGER, naming the CAPABILITY: acceptance joins every resolved declaration identity's owner module to the exact local/import/prelude closure used to construct the execution index. DISCRIMINATING RED: a bare call with no explicit import is refused BEFORE Accepted, not after. POSITIVE CONTROL: adding the exact import admits and executes the unchanged call. REPAIR DIRECTION, and the wrong arm is the tempting one: constrain RESOLUTION and ADMISSION. Do NOT widen the runtime loader to chase bare-reference edges -- that converts undeclared dependencies into implicit imports and dissolves the direct-import law to make a symptom go away, which is the absorbing-fallback shape applied to a language rule. Both phases must consume ONE admitted dependency closure. RECOGNITION RULE: a green typecheck is not evidence that a call can execute unless the phase that accepted it and the phase that will run it were answering to the same module set; when a name resolves but its module is not imported, ask which denominator each phase used before concluding the reference is sound.)",
  evidence: [],
}

data surface_shorthand_preempts_resolved_identity: RecurringFailureMode = RecurringFailureMode {
  identity: "surface_shorthand_preempts_resolved_identity" as NonEmptyStr,
  authored: "**surface shorthand preempts resolved identity** (a semantic consumer dispatches on a raw lexeme after resolution has already named its declaration, so a declared constructor is reinterpreted as a host sentinel or primitive. Recognition rule: once a node carries a binding/declaration identity, value construction must be total over that identity; spelling may be interpreted only on an explicitly unresolved shorthand arm. Specimen gunbc#9741: bare and imported `None` became host `Null` while qualified `Diagnostics.None {}` became a `Variant`; a single-frame comparison hid the fork. This is not hollow alias: the binding is grounded and present, then discarded downstream. It is also separate from the per-frame symbol-ordinal defect: that defect corrupted lexeme identity while crossing frames, whereas this one ignores an identity already supplied at one construction site. Next-rung trigger: host literals and intentional primitive representations are typed parser/resolver constructions, and evaluator value construction is total over every resolved binding with no raw-spelling arm able to override it.)",
  evidence: [],
}

data meaning_fork: RecurringFailureMode = RecurringFailureMode {
  identity: "meaning_fork" as NonEmptyStr,
  authored: "**meaning fork** (one scoped name carries more than one material semantic referent under hidden state; accuracy of meaning applies to terms in every layer, and for a contract-bearing name, differences in obligations, quality floor, refusal behavior, billing consequence, or remedy establish different referents. The subject is scoped: the key is the naming surface, the visible name, and the declared effective version or epoch — the same spelling in two explicitly distinct scopes or across a declared version transition is legitimate reuse, not a fork. Recognition rule: hold that key constant and vary the hidden state; if the material semantic referent changes without a distinct variant name, the name has forked — for a contract-bearing name, a change in obligations, quality floor, refusal behavior, billing consequence, or remedy is sufficient evidence of that change. This is the one-name/two-meanings dual of nicknaming.)",
  evidence: [],
}

data externalized_degradation: RecurringFailureMode = RecurringFailureMode {
  identity: "externalized_degradation" as NonEmptyStr,
  authored: "**externalized degradation** (an actor that accepted an obligation or risk, or caused a cost, silently shifts the resulting burden to another principal while preserving the apparent name, price, or contract. Recognition rule: identify the accepted obligation or causal responsibility, trigger the adverse state, and follow who bears the marginal burden; if another principal's burden rises while the responsible actor neither absorbs it through its reserve, refusal, or remedy path nor exposes a separately named, priced, and refusable transfer, the burden was externalized. A disclosed, refusable allocation agreed before contract formation is the transfer arm; an undisclosed or unilateral later shift is refused. The honest arms are absorb-and-reserve or separately name-and-price the transfer.)",
  evidence: [],
}

data instrument_output_read_as_subject_content: RecurringFailureMode = RecurringFailureMode {
  identity: "instrument_output_read_as_subject_content" as NonEmptyStr,
  authored: "**instrument output read as subject content** (a consumer derives a SET from a report whose completeness is a property of the REPORTING TOOL rather than of the subject. **The boundary against `execution_provenance_loss` is the whole justification for a separate row, because the two look identical at the call site and have opposite repairs**: there a value is consumed as though an observation produced it while nothing proves the observation path RAN, and the fix is to bind an execution receipt; here the observation ran and reported FAITHFULLY — the instrument answered its own question correctly — and what is wrong is that its output was complete for the REPORTER s purpose and was read as complete for the CONSUMER s. Provenance is intact; the SUBJECT is substituted, so no receipt binding can detect it and the repair is instead to derive the set from the subject itself. Distinct from `total_at_the_level_examined_blind`, which is a judgment shape (a match total over the type it examines, blind inside an arm), and from `reachability_read_as_occupancy`, which asks whether a quiet guard should exist; this is neither a match nor a guard. Specimen with a receipt, repaired on main by gunbc#9829: the required floor asked `extdeps.git` `git.Core.DiffUnified0` (`git diff -U0 <range>`) which lines a change touched, and `floor_diff_edits_from_line_ranges` attributed those lines to enclosing declarations to decide which witness identities the change established. Git prints only the hunks that DIFFER, so on a rename it prints the module line and whatever else moved — while every identity at the destination is a newly qualified `module.function` that has never executed under that spelling, because the authored module name moved with the file. **THE REASON IT SURVIVED IS THAT THE TWO ANSWERS COINCIDE BY ACCIDENT IN THE COMMON CASE**: for a wholly-added file every line is a `+` line, so line attribution reaches every declaration and the defect is invisible; it appears only when the instrument gets TERSE, which rename detection is. Measured over the window reachable in a shallow session clone — a floor on the population, not the population, since older renames are unmeasured — 8 of 8 rename-destination `.dag` files carrying test decls were under-enrolled and at least 87 of their 103 identities were never selected; a PURE MOVE with no content edit enrolled NOTHING. It was not merely a reporting gap: changed-witness membership is what OVERRIDES the cost-debt withhold and the outside-gate suppression, so the same miss on a rostered identity is a silent decline of a witness whose author is present, which is the state `v2.workflow.floor_changed_witness` `changed_witness_execution_standing` exists to red. The repair derives the set from the subject: a path `parse_unified_diff_added_paths` already rules new-at-path contributes the declarations THE FILE ITSELF PARSES TO, bounded to that file s own decl list and never the corpus, so it is the precise answer rather than an absorbing widen. Its discriminating red is `rename_destination_enrolls_every_test_decl_not_only_the_diff_touched_one`, which feeds the specimen s verbatim diff and FAILS when the rule is disabled, paired with `in_place_modify_enrolls_only_the_touched_test_decl`, which passes under both states so the first cannot be satisfied by widening. **Recognition rule, and it predicts well beyond git**: whenever a set is read out of a tool s output, ask whether that tool promised completeness over YOUR question or over its own — `--stat`, any de-duplicating or truncating reporter, and any porcelain that elides for human brevity all report faithfully and none of them promise the consumer s set. **Its near twin is `executed_conjunct_discriminates_nothing`, approached from the other side**: there the satisfied signal is EXECUTION -- the conjunct genuinely runs and is genuinely gated on -- while here it is COMPLETENESS RELATIVE TO THE REPORTER, which is why this class is not a reachability problem and looking for an unexecuted path finds everything healthy. In both, the axis the diligent reader checks already reads green, and checking it harder returns the same green.)",
  evidence: [],
}

data executed_conjunct_discriminates_nothing: RecurringFailureMode = RecurringFailureMode {
  identity: "executed_conjunct_discriminates_nothing" as NonEmptyStr,
  authored: "**a conjunct that executes, is reached, is gated on, and still discriminates nothing** (a predicate wired into a live check runs on every call, sits inside a gate that really blocks, and yet deletes cleanly: remove it and every witness stays green, because no fixture ever constructs the population that would make it false. **It is invisible precisely BECAUSE reachability is satisfied.** The usual signature of an unenforced mechanism -- nothing calls it -- is absent, so every reachability-based tell reports health, and review reads the conjunct as a wall because it genuinely is evaluated. Executed and enforcing are different properties, and no amount of coverage over the calling path distinguishes them. **It is bounded against three neighbours and none of their recognition rules will find it.** `reachability_read_as_occupancy` asks whether to DELETE a guard that is quiet, and warns that mechanism-yes / join-yes / occupancy-zero is a healthy guard; this class is not about deletion and not about occupancy -- the conjunct here should stay, and the defect is that it was believed to be doing work it was not. Section 6's inert-lens tell is machinery that nothing GATES on; this is gated on. Section 4b's decoration case is a check whose RED cannot be authored ANYWHERE; this RED can be authored -- it simply never was, which is the whole difference, and it is the difference between a permanent ceiling and one missing fixture. **THE REMEDY HAS TWO HALVES AND THE SECOND IS WHAT MAKES THE FIRST SOUND.** First: for each wall, run the DELETE arm and confirm EXACTLY ONE witness reddens -- not that a witness reddens. Second: the subject that isolates the conjunct must be chosen with care, because a red for the wrong reason is how this class survives its own test. **SPECIMEN, with both halves executed** (gunbc#9838, `gunbc.self_host_compile_phase_frontier`): `census_population_is_duplicate_free` was added as a conjunct of `receipt_population_coherent`, evaluated on every coherence check and reachable from the live path; deleting it left the whole witness module green. The fixture that isolates it is a receipt whose `refused_files` REPEATS A PATH -- enrolled as `a_receipt_whose_refused_population_repeats_a_path_is_refused_by_coherence` in `test.claim.self_host_compile_phase_frontier_witness`, with `the_same_receipt_without_the_repeat_is_coherent` as its positive control. The subject that looks equally good and is not: a repeated ERROR DIAGNOSTIC IDENTITY also reddens the module, but it breaks a count invariant one line over rather than this conjunct, so it would have scored the DEAD conjunct as LIVE and closed the investigation with the wall still inert. **RUNG: mechanically preventable, and the honest ceiling is the same rung rather than higher.** The unenforcing conjunct stays writable; what exists is an executed falsifier per wall, not a construction that forbids authoring one. The next-rung trigger is a CAPABILITY and not an artifact: a mechanism that derives, from the check itself, the population its removal would change -- so that a conjunct with an empty such population fails to compile rather than waiting for an author to think of the delete arm. Enumerating delete arms by hand does not retire it; it only executes this row's recognition rule once per wall. **Its near twin is `instrument_output_read_as_subject_content`, and they meet from opposite sides**: there a report is complete for the REPORTER and read as complete for the SUBJECT; here a conjunct is genuinely executed and read as genuinely discriminating. Both are the shape where the health signal the reader actually checks -- completeness there, execution here -- is fully satisfied while the property they believe it establishes does not hold. **Neither is found by checking harder along the axis that already reads green.**)",
  evidence: [],
}

data unbacked_execution_claim: RecurringFailureMode = RecurringFailureMode {
  identity: "unbacked_execution_claim" as NonEmptyStr,
  authored: "**unbacked execution claim** (prose asserts a live executing relation — this runs on X, X reads these fields, Y already resolves Z — that no authority backs, and a reader forms the premise and plans against it. §4b's CI rung drop names the harm PREMISE CONTAMINATION in its own words; this row is that harm as a general class, since the drop is about one paragraph in the canonical authority and the class is about every carrier. **THE ORIGINS ARE A FIELD OF THIS ONE ROW RATHER THAN SEPARATE ROWS, because the recognition rule is identical across them** — resolve the claim against the authority that owns the relation — **but the REMEDY BRANCHES ON THE ORIGIN, and a remedy applied without reading the origin manufactures new false statements.** Three origins are ATTESTED here and a fourth is conceivable but was NOT found. ORIGIN 1, EXECUTOR DELETED: the claim was true and its executor was removed. Specimen: `gunbc.floor_component_receipt_document` recited that an alert downloads an artifact named `floor-component-receipt` from a run id it is given and reads four named fields; that alert was `falsifier-alert.yml`, deleted 2026-08-15, and a lane read the module, believed the transport live, planned against it, and was corrected by its reviewing authority — the cost is measured, not hypothetical. Second specimen, same origin: `gunbc.ci_failure_class` stated its dissolution trigger as calling `classify_failure_reason` *the way claim_executor already resolves* `gunbc.floor_component_receipt`; `write_floor_component_receipt_at` did exactly that from 2026-07-30 (gunbc#7467) until gunbc#9228 deleted it on 2026-08-25. ORIGIN 2, THE CITED SYMBOL DIED WHILE ITS CONTENT SURVIVED AS AN ANNOTATION, and this one has a corpus-wide producer: `v1_compiler.cli_run` twice cited `floor_component_resource_checkpoint_note` and `floor_component_phase_journal_scaffold_note`, which were real `data …: String` declarations in `gunbc.floor_component_receipt` until the 2026-08-30 prose-bankruptcy sweep (gunbc#9752) converted module-scope commentary rows into §4c annotations corpus-wide. §4c makes an annotation uncitable by construction — `v1_compiler.cli_run` `annotation_erased_scan_text` feeds the semantic passes, so annotation text is not present in the tree the citation harvester walks. **THE CONSEQUENCE IS THE OPPOSITE OF THE ONE THIS ROW FIRST DREW, AND THE CORRECTION IS THE INSTRUCTIVE PART.** The first revision reasoned that the sweep therefore broke every citation of a converted row, making the population the sweep's own diff. Measured by a separate lane (gunbc XL-0-CITE, 2026-09-01) against `v1_compiler.declaration_index`, whose only citation producers are `citation_from_record_literal` and `citation_from_constructor_call`: the typed-citation breakage is **ZERO**, computed both today and as of the sweep commit, on a control that discriminates in both directions. A plain name in annotation prose was never a citation, so the sweep could not break one. What that leaves is a REAL class with an honest ceiling rather than a defect population: these citations bind READERS and no mechanism, so they sit in §4b's *outside the modeled guarantee* column — observed and repaired by reading, never gated — and calling them a dangling-citation population would have been rung inflation about a check that by construction cannot see them. The two `cli_run` sites are genuine instances of the harm and there is no mechanical census that would have found them. ORIGIN 3, WRONG AUTHORITY FOR SOMETHING THAT STILL EXECUTES: `dag/test/claim/instrument_sandbox_witness_test` says its live half `runs on the falsifier lane`; that half sits on `FalsifierSubstrateLongLane`, which `std.witness_admission` `witness_cadence_has_scheduled_route` reports routeless — but it also carries a local recipe, and `OfflineLocalRecipe` HAS a route, so the relation is live and only the named authority is wrong. THE FOURTH, NEVER BACKED AT ALL, IS NOT ATTESTED IN THIS CORPUS and is recorded as unmeasured rather than as a population. **THIS ROW IS NOT THE AUTHORITY ON ANY POPULATION, and saying so is the point:** `gunbc.deleted_cadence_reference_census` already owns the falsifier-cadence instance of origin 1 — twelve sites, a `DeletedCadenceReferenceStanding` vocabulary whose `PremiseInvalidated` arm is exactly this class, and one `GuaranteeRungDrop` filed once for the shared executor rather than per site. A pattern row that restated its population would be a second authority for a fact that already has one, which is the §3 violation this row's own remedy is meant to prevent; so the census is cited here and nothing about its contents is copied. What belongs HERE is only the recognition rule and the remedy arms, which generalize past the falsifier. **THE MECHANICAL TEST for finding one is sharper than asking whether the verb is runs or is enrolled: resolve the claim against the authority that owns the relation, and ask whether the prose implies a live route for something that authority says has none.** The naive runs/enrolled discriminator loses one arm and it is the common one — `Enrolled on falsifier_rehomed_bin_wet_entries (nightly batch 5)` is nominally an enrollment claim, which is TRUE, but `nightly` asserts a cadence that executes and `FalsifierRehomedBinWet` is routeless, so the reader forms the false premise anyway. Three outcomes per line: asserts execution (contaminating), asserts enrollment only (true, leave it), asserts enrollment while implying a live cadence (contaminating). **THE REMEDY HAS THREE ARMS, KEYED TO WHAT THE AUTHORITY SAYS NOW, and picking the wrong one is itself an instance of this class.** Origin 1 → PAST TENSE WITH THE DATE, keeping the reasoning, because the reasoning usually outlives its executor and a reader who finds a dangling claim silently deleted learns nothing. Origin 2 → name the module and the FACT rather than the dead symbol, since §4c left no symbol to cite; past-tensing here would wrongly report the content as gone when only its citability is. Origin 3 → CORRECT IT to the authority that does back it, NOT past tense: past-tensing a live relation records it as dead and is a new contamination in the opposite direction, produced by the remedy itself. Origin 4 → say it was never backed, or delete the assertion while keeping any surviving reasoning; NEVER past tense, because there is no past to record, and `X USED TO resolve Y` asserts an execution that also never happened. **The default against deletion is a default and not an absolute: a sentence whose entire content is a false execution claim has no reasoning to preserve.** **THE SELF-RECEIPT, and it is the most useful thing in this row (2026-09-01):** the first revision of this entry asserted the `ci_failure_class` clause and the two `cli_run` notes as never-true, on the strength of a grep showing they resolve nowhere TODAY. **Both were true when written**, and the row about unbacked claims therefore contained two of them. It was caught by a reviewing authority asking for verification rather than inheritance, not by any check. **RECOGNITION RULE EARNED: `resolves nowhere now` is not `never resolved`, the distinction is decided by history and not by the working tree, and the instrument is `git log --all -S` over the DECLARATION FORM** — which also separates origin 1 from origin 2 by showing WHAT deleted the referent. The neighbouring rule is `positional_citation`'s: a citation left naming a deleted symbol fakes a grep hit, so every arm above records the change rather than quietly removing the name.)",
  evidence: [],
}

data recurring_failure_mode_roster: List<RecurringFailureMode> = [
  hollow_alias,
  state_space_conflation,
  absorbing_fallback,
  empty_observation_narrow,
  cache_impurity,
  reflection_evidence_structural_proof,
  coercion_proven_by_normalized_round_trip,
  parallel_representation_debt,
  internal_review_finds_missing_tests_external,
  unmarked_workaround,
  self_authorized_dissolution,
  positional_citation,
  bound_shaped_closure,
  authority_substitution,
  reachability_read_as_occupancy,
  total_at_the_level_examined_blind,
  execution_provenance_loss,
  remediation_mutated_view,
  diagnostic_name_mechanism_silent,
  identity_absent_graph_traversal,
  resolved_reference_outside_execution_closure,
  surface_shorthand_preempts_resolved_identity,
  meaning_fork,
  externalized_degradation,
  instrument_output_read_as_subject_content,
  executed_conjunct_discriminates_nothing,
  unbacked_execution_claim,
]
