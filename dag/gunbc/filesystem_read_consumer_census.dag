module gunbc.filesystem_read_consumer_census

import std.types { List, NonEmptyStr, String }

data filesystem_read_direct_consumer_census_instrument: String = "Snapshot revision 045ab627854f336ffb7bc6d0e918bb47b560d587. Re-derive the direct-site population with: rg -n --glob '*.dag' 'Filesystem\\.Read\\(' dag src/v2 fixtures/class_b_trim. Re-derive symbolic enclosing declarations with the same roster passed to: perl -ne 'if(/^\\s*(?:test\\s+)?(?:fn|func)\\s+([A-Za-z0-9_]+)/)\{$f=$1\} if(/Filesystem\\.Read\\(/)\{print qq($ARGV\\t$f\\t$_)\}'. Service-operation bodies require naming the service and operation directly because they are not fn declarations. Compare the derived symbolic identities against filesystem_read_direct_consumer_census; a count alone is not completeness."

// Pre-cut disposition census for replacing extdeps.filesystem.filesystem_io
// Filesystem.Read's flat content/success/error product with
// std.error_primitives.Result<String, ReadError>. Identities are symbolic:
// module + declaration + local binding where one declaration contains multiple
// reads. No source positions are carried.
//
// The old operation maps Read and Delete success through the wire key
// "write_success". That shared nickname is the observable fork; the product also
// permits content + false + empty error, false + non-empty content, and every
// other contradictory combination. These rows decide the terminal meaning at
// each direct service-operation consumer before the root changes. The five
// dispositions mean, respectively: every ReadError terminates with the existing
// refusal/false result; ENOENT alone is expected absence and all other arms
// refuse; the existing typed refusal preserves the ReadError value; an
// unguarded content read gains an explicit all-errors refusal; or any error in a
// multi-read observation refuses the whole observation rather than admitting a
// partial tuple.
type ReadConsumerDisposition
  = EveryReadErrorRefuses
  | EnoentIsAbsenceOtherErrorsRefuse
  | PreserveTypedReadError
  | UnguardedReadMustRefuse
  | AnyReadErrorRefusesWholeObservation

type ReadConsumerRow {
  site: NonEmptyStr
  disposition: ReadConsumerDisposition
}

fn read_consumer(site: NonEmptyStr, disposition: ReadConsumerDisposition) -> ReadConsumerRow {
  ReadConsumerRow { site: site, disposition: disposition }
}

