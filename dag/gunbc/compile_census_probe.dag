module gunbc.compile_census_probe

import std.types { Bool, Int, List, String }
import std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable, census_blocking_rows, census_total_count }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_subject, census_any_count_for_class, census_blocking_count_for_class }

// THE SINGLE HOME for "compile this source string and count what it refused". Both of these
// were declared locally in test.claim.algebra_receiver_alias_witness, and a second witness
// needed the same two facts -- copying them would have made one concept answer from two
// authorities, which is the fork DESIGN section 3 exists to prevent. They live here rather than
// inside gunbc.compile_diagnostic_census because they join that census to
// guarantee_probe_corpus's subject lookup, and the census module must not gain an edge to the
// probe corpus to serve a helper neither of them owns.
//
// BOTH FAILURE ARMS RETURN -1, NEVER 0. A not-runnable census is not "nothing was blocking":
// callers here assert `== 0` for an accepted source, so an arm returning 0 on failure would
// make a census that never ran indistinguishable from a clean compile, and every acceptance
// witness would green by vacancy.

fn blocking_subject_count_for(source: String, wanted_class: String, wanted_subject: String) -> Int {
  match census_blocking_count_for_subject(census: compile_dag_diagnostic_census(source), wanted_class: wanted_class, wanted_subject: wanted_subject) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// THE ROWS, not just the counts. A claim of the form 'the probe differs from its control by exactly
// the target key' cannot be made from counts alone -- equal totals can hide an offsetting pair of
// changes -- so the caller needs the rows and hands them to the SHARED comparator
// (gunbc.compile_diagnostic_census::censuses_differ_by_exactly_the_target_key), which is where
// 'exactly the target key' is defined once for the whole tree. This module owns 'compile a source
// string and report what it saw'; the comparator owns 'what counts as a one-key difference'.
// A source that does not run at all yields `none`: absence is reported as absence rather than as an
// empty row list, so a broken fixture can never look like a clean compile.
type ProbeCensusRows {
  rows: List<CompileDiagnosticCensusRow>
}

fn census_rows_for(source: String) -> ProbeCensusRows? {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => Present { value: ProbeCensusRows { rows: rows } }
    CensusNotRunnable { cause: _ } => none
  }
}

fn total_blocking_count_for(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// A CLASS THAT REFUSES, COUNTED WITHOUT NAMING A SUBJECT. blocking_subject_count_for is the right
// question when a probe asserts WHICH declaration was refused; it is the wrong one when the class
// itself is the whole assertion and the subject the census derives is an implementation detail of
// the diagnostic's fields. Asking through any_class_count_for instead would answer at ANY severity,
// so a wall silently downgraded from blocking to advisory would keep this green -- which is exactly
// the vacancy the -1 arms exist to prevent, arrived at from the severity axis rather than the
// runnability one. This asks the BLOCKING projection for rows of a class, and nothing about the
// subject.
fn blocking_class_count_for(source: String, wanted_class: String) -> Int {
  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(source), wanted: wanted_class) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// AN ADVISORY DIAGNOSTIC IS INVISIBLE TO THE TWO ABOVE, and that is not a gap in them: both
// read the BLOCKING projection, which is the right question for a construct that refuses. A
// diagnostic carried at SeverityNonError never appears there, so a witness asserting on one
// through blocking_subject_count_for would read 0 and green by vacancy -- the same shape the
// -1 arms exist to prevent, arrived at from the other side. This asks the census for rows of
// a class at ANY severity instead.
fn any_class_count_for(source: String, wanted_class: String) -> Int {
  match census_any_count_for_class(census: compile_dag_diagnostic_census(source), wanted: wanted_class) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}
