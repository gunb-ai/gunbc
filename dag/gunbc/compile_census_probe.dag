module gunbc.compile_census_probe

import std.types { Bool, Int, String }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_blocking_rows, census_total_count }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_subject }

// THE SINGLE HOME for "compile this source string and count what it refused". Both of these
// were declared locally in test.claim.algebra_receiver_alias_witness_test, and a second witness
// needed the same two facts -- copying them would have made one concept answer from two
// authorities, which is the fork DESIGN section 3 exists to prevent. They live here rather than
// inside gunbc.compile_diagnostic_census because they join that census to
// guarantee_probe_corpus's subject lookup, and the census module must not gain an edge to the
// probe corpus to serve a helper neither of them owns.
//
// BOTH FAILURE ARMS RETURN -1, NEVER 0. A not-runnable census is not "nothing was blocking":
// callers here assert `== 0` for an accepted source, so an arm returning 0 on failure would
// make a census that never ran indistinguishable from a clean compile, and every acceptance
// witness would green by vacancy.

fn blocking_subject_count_for(source: String, wanted_class: String, wanted_subject: String) -> Int {
  match census_blocking_count_for_subject(census: compile_dag_diagnostic_census(source), wanted_class: wanted_class, wanted_subject: wanted_subject) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

fn total_blocking_count_for(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}
