module gunbc.githooks_pre_commit_emit


fn emit_glob_case_arms(globs: List<String>) -> String {
  fold(globs, init: "", f: fn(acc, g) {
    concat(acc, concat("\n    ", concat(g, "*) return 0 ;;")))
  })
}

fn emit_freshness_path_fn(label: String, globs: List<String>) -> String {
  concat(
    concat(label, "_path() {\n  case \"$1\" in"),
    concat(emit_glob_case_arms(globs: globs), "\n  esac\n  return 1\n}\n")
  )
}

data githooks_pre_commit_note: String = "Commit-time fmt gate (operator request 2026-07-12: add fmt to the commit hook). The staged path set is matched against the same LocalTidyCargoFmtCheck trigger globs the pre-push hook and the CI rust gate consume — one fmt-relevance authority, three surfaces. Both commit-time and push-time hooks are CHECK-ONLY: on drift they refuse with the fix recipe instead of mutating the index or auto-committing (git add -u under a partially-staged tree would sweep unstaged edits into the commit — a silent widen; push-time auto-commit was retired in #6706 non-invasive gates, and #6720 carries the same check-only policy into the typed plan/Rust transport). dissolve-on: shell emission via the grammar path (the bash medium modeled as GrammarRelationRow rows read forward, superseding these concat-built shell string literals — same trigger as the githooks_pre_push_emit sibling; the medium-as-string debt is tracked once for the hook-emit family, here explicitly rather than implicitly via the sibling roster). Follow-on (not modeled here): a GitPreCommitHook CommitWorkflowSurface row binding this artifact into commit_workflow_realization_bindings."

fn emit_pre_commit_staged_scan() -> String {
  concat(
    emit_freshness_path_fn(label: "staged_fmt", globs: gunbc.local_tidy_spec.local_tidy_trigger_globs(check: gunbc.commit_workflow.LocalTidyCargoFmtCheck)),
    "NEED_FMT=0\nwhile IFS= read -r p; do\n  [[ -z \"$p\" ]] && continue\n  if staged_fmt_path \"$p\"; then NEED_FMT=1; break; fi\ndone < <(git diff --cached --name-only --diff-filter=ACMR)\n[[ \"$NEED_FMT\" == \"0\" ]] && exit 0\n"
  )
}

data pre_commit_fmt_outcome_split_note: String = "Same three-way split as the pre-push sibling, from the one authority (gunbc.local_tidy_spec): exit 1 is the only status that reports drift in staged Rust, and any other non-zero status names cargo as unrunnable rather than blaming the staged work. The branches are spelled as explicit if-blocks instead of an and-list so the arm does not depend on bash errexit's suppression rules inside a && list."

fn emit_pre_commit_fmt_recipe_echo(outcome_recipe: String) -> String {
  concat("  echo \"[pre-commit] ", concat(outcome_recipe, "\" >&2\n  exit 1\nfi\n"))
}

fn emit_pre_commit_run_fmt() -> String {
  concat(
    concat(
      "echo \"[pre-commit] cargo fmt --all --check\"\nfmt_rc=0\ncargo fmt --all --check || fmt_rc=$?\nif [[ \"$fmt_rc\" == \"0\" ]]; then\n  exit 0\nfi\n",
      concat(
        "if [[ \"$fmt_rc\" == \"1\" ]]; then\n",
        emit_pre_commit_fmt_recipe_echo(
          outcome_recipe: gunbc.local_tidy_spec.local_tidy_fmt_outcome_recipe(
            outcome: gunbc.local_tidy_spec.FmtDrift,
            drift_recipe: gunbc.local_tidy_spec.local_tidy_fmt_pre_commit_drift_recipe
          )
        )
      )
    ),
    concat(
      "if [[ \"$fmt_rc\" != \"0\" ]]; then\n",
      emit_pre_commit_fmt_recipe_echo(
        outcome_recipe: gunbc.local_tidy_spec.local_tidy_fmt_outcome_recipe(
          outcome: gunbc.local_tidy_spec.FmtToolUnavailable {
            program: "cargo",
            cause: "exit status $fmt_rc"
          },
          drift_recipe: gunbc.local_tidy_spec.local_tidy_fmt_pre_commit_drift_recipe
        )
      )
    )
  )
}

fn expected_githooks_pre_commit_sh() -> String {
  concat(
    concat(
      "#!/usr/bin/env bash\n# GENERATED by dag/gunbc/githooks_pre_commit_emit.dag — DO NOT HAND-EDIT.\n",
      "set -euo pipefail\nROOT=\"", concat(extdeps.git.git_toplevel_shell_subexpr(), "\"\ncd \"$ROOT\"\n")
    ),
    concat(gunbc.githooks_repo_local_git_config_emit.emit_repo_local_git_config_converge_shell(), concat(emit_pre_commit_staged_scan(), emit_pre_commit_run_fmt()))
  )
}
