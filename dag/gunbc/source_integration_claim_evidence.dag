module gunbc.source_integration_claim_evidence


type SourceBindingFact {
  bound: std.types.RunKey
  source_read: v2.compiler.source_authority.DagSourceReadWitness
  binding: OccurrenceBinding<std.occurrence_identity.OccurrenceId>
}

type SourceIntegrationProposition
  = SourceBindingCaptured
  | SourceBindingAdmissible

type SourceIntegrationClaim = std.claim_evidence.Claim<std.occurrence_binding.OccurrenceBinding<std.occurrence_identity.OccurrenceId>, v2.compiler.source_authority.DagSourceReadWitness, SourceIntegrationProposition, std.syntax.SyntaxSpec, std.types.RunKey>

type SourceIntegrationEvidenceLink = std.claim_evidence.EvidenceLink<SourceBindingFact, SourceIntegrationClaim, std.syntax.SyntaxSpec, SourceIntegrationProposition, gunbc.readback_independence.ReadBackProbe>

type SourceIntegrationEvidenceInference = std.claim_evidence.EvidenceInference<SourceBindingFact, SourceIntegrationClaim, std.syntax.SyntaxSpec, SourceIntegrationProposition, gunbc.readback_independence.ReadBackProbe>

data source_binding_capture_probe: gunbc.readback_independence.ReadBackProbe = gunbc.readback_independence.ReadBackProbe {
  label: "decode one authored source binding",
  subject: "the binding captured for one proposal occurrence",
  effect_on_subject: ProbeInert,
}

fn source_binding_captured_claim(
  fact: SourceBindingFact,
) -> SourceIntegrationClaim {
  std.claim_evidence.Claim {
    id: "source-binding-captured",
    subject: fact.binding,
    target: fact.source_read,
    proposition: SourceBindingCaptured,
    scope: dag_syntax_spec,
    bound: fact.bound,
  }
}

fn source_binding_admissible_claim(
  fact: SourceBindingFact,
) -> SourceIntegrationClaim {
  std.claim_evidence.Claim {
    id: "source-binding-admissible",
    subject: fact.binding,
    target: fact.source_read,
    proposition: SourceBindingAdmissible,
    scope: dag_syntax_spec,
    bound: fact.bound,
  }
}

fn source_binding_capture_inference(
  fact_id: std.claim_evidence.RecordedFactId,
  fact: SourceBindingFact,
) -> SourceIntegrationEvidenceInference {
  let claim = source_binding_captured_claim(
    fact: fact,
  )
  infer_probe_evidence(
    fact: std.claim_evidence.RecordedFact {
      id: fact_id,
      value: fact,
    },
    direction: EvidenceSupports,
    inference_rule: "decoded-binding-supports-capture-only",
    authority: dag_syntax_spec,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "decoded-source-binding",
      activity: "decode-authored-proposal",
      agent: "dag-source-decoder",
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "binding was decoded for the named proposal attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: SourceBindingCaptured,
      losses: [
        "capture does not prove semantic compatibility",
        "capture does not prove authorization or admission",
      ],
    },
    probe: source_binding_capture_probe,
  )
}

data source_integration_evidence_humility_note: std.types.NonEmptyStr = "This P−1 consumer records one typed OccurrenceBinding observed from one DagSourceReadWitness and deliberately does not introduce a proposal identity before the P0 transformation carrier exists. The source grammar is the inference authority and the decoder is only provenance. A decoded binding can support SourceBindingCaptured and no stronger conclusion. SourceBindingAdmissible remains neither supported nor challenged until semantic, authorization, and policy evidence enters through its own claim links."
