module gunbc.provider_standing


data provider_standing_authority_note: String = "SHARED CONTRACT for Claude and Cursor dispatch lanes (valiant-stag-845). ProviderReadiness decomposes per provider-control-interface-audit section 10 into six independent axes: installation, authentication, entitlement, limit, turn outcome, and tool environment. One arm must not erase another — the audit worked example (authenticated + weekly Opus warning + Fable rejected + Opus runnable) requires it. Limit observations carry an explicit ProviderLimitSubject; native limit tokens stay open (NonEmptyStr) with recognised projections layered over them, never a closed enum that drops upstream tokens (section 4.1). Standing facts reuse std.claim_evidence RecordedFact and EvidenceLink machinery (section 11); this module owns the proposition shapes only. ProviderAuthenticationStanding derives from token state, never from subscription profile metadata alone — profile-present-token-absent is a distinct refusal arm, not a gap that reads as authenticated (eager-raven-845 live observation, 2026-08-06)."

data provider_standing_selection_note: String = "Selection eligibility consumes an admitted ProviderStanding bundle AND a ProviderLimitDispatchDraw. LimitDispatchDrawAutomatic fail-closes on any observed ProviderNativeLimitBucket exhaustion (extdeps.llm.codex_app_server codex_model_to_limit_bucket_gap_note). ProfileExactOverride may supply operator_asserted_native_limit_bucket on SelectCodex — attributed assertion, not a cited join. LimitDispatchDrawUnspecified is constructible for limit-subject coverage tests only — provider_standing_is_selection_eligible and provider_standing_bundle_is_selection_eligible refuse it at the entry point (construction wall); dispatch eligibility must use Automatic, Account, Model, or NativeBucket draws."

data provider_standing_limit_dispatch_draw_note: String = "Limit blocking is dispatch-scoped. LimitDispatchDrawAutomatic and LimitDispatchDrawModel treat every ProviderNativeLimitBucket exhaustion/rate-limit/until-reset/rejection as blocking — relevance is undeterminable without a cited native-token-to-model join (extdeps.llm.codex_app_server codex_model_to_limit_bucket_gap_note; extdeps.llm.claude_sdk claude_native_limit_token_to_model_gap_note). LimitDispatchDrawModel blocks ProviderModelLimit only when subject_model == draw_model. LimitDispatchDrawNativeBucket blocks only on matching native_key. DISSOLVES ON: cited joins land per provider gap notes."

data provider_standing_limit_rejection_unspecified_draw_note: String = "LimitRejected under LimitDispatchDrawUnspecified does not block when the subject is ProviderModelLimit — a single rejected model must not erase account eligibility (section 10 worked example: Fable rejected, Opus still runnable). ProviderNativeLimitBucket and ProviderAccountLimit rejections still route through limit_subject_covers_dispatch_draw so a future rate_limit_reached decode cannot slip past Unspecified/Automatic fail-closed the way LimitExhausted does."

type ProviderLimitDispatchDraw
  = LimitDispatchDrawUnspecified
  | LimitDispatchDrawAutomatic
  | LimitDispatchDrawAccount { credential: ProviderLimitCredentialIdentity }
  | LimitDispatchDrawModel {
      credential: ProviderLimitCredentialIdentity,
      model: std.types.NonEmptyStr,
    }
  | LimitDispatchDrawNativeBucket {
      credential: ProviderLimitCredentialIdentity,
      native_key: std.types.NonEmptyStr,
    }

type ProviderLimitCredentialIdentity
  = LimitCredentialUnspecified
  | LimitCredentialLabel { label: std.types.NonEmptyStr }

type ProviderLimitSubject
  = ProviderAccountLimit { credential: ProviderLimitCredentialIdentity }
  | ProviderWorkspaceLimit { workspace_account: std.types.NonEmptyStr }
  | ProviderModelLimit {
      credential: ProviderLimitCredentialIdentity,
      model: std.types.NonEmptyStr,
    }
  | ProviderNativeLimitBucket {
      credential: ProviderLimitCredentialIdentity,
      native_key: std.types.NonEmptyStr,
    }

type ProviderInstallationStanding
  = InstallationStandingUnobserved { reason: std.types.NonEmptyStr }
  | InstallationExecutableMissing
  | InstallationVersionDrift { observed: std.types.NonEmptyStr, expected: std.types.NonEmptyStr }
  | InstallationReady

type ProviderAuthenticationStanding
  = AuthenticationStandingUnobserved { reason: std.types.NonEmptyStr }
  | AuthenticationCredentialsAbsent
  | AuthenticationRecordedUnverified
  | AuthenticationProfilePresentTokenAbsent {
      subscription_tier: std.types.NonEmptyStr,
      token_source: std.types.NonEmptyStr,
    }
  | AuthenticationRefreshFailed { reason: std.types.NonEmptyStr }
  | AuthenticationExpired
  | AuthenticationAuthenticated

type ProviderEntitlementObservation
  = EntitlementObservationUnobserved { reason: std.types.NonEmptyStr }
  | EntitlementObservedAvailable
  | EntitlementRejected { reason: std.types.NonEmptyStr }

data limit_subject_unobserved_note: String = "AN UNMEASURED SUBJECT IS NOT AN UNMEASURED WORLD (review 51237, gunbc#8166). LimitObservationUnobserved blocks EVERY draw, which is right when nothing is known about any limit — the observation carries no subject because there is no subject to carry. It is wrong the moment one bucket decodes and a sibling does not: the codex bucket failing to decode does not make a measured, available codex_bengalfox bucket unmeasured, and refusing a draw that names the sibling refuses work on evidence that concerns a different subject.\n\nThat is still a fail-closed error rather than a fail-open one, which is exactly why it is easy to miss and worth naming: over-refusal reads as caution while it silently prices out capacity the observation proved was there.\n\nSo this arm carries the subject the producer already had. It routes through limit_subject_covers_dispatch_draw like every other subject-bearing arm, which means it blocks a draw naming that bucket, and it still blocks Unspecified and Automatic draws — those cover every native bucket, so an unmeasured bucket refuses whenever the draw does not say which bucket it consults. Precision where the draw names a subject; fail-closed where it does not.\n\nThe distinction from LimitCapabilityGapUnobservable is that the gap arm means the capability cannot be observed AT ALL on this surface (it returns false — a permanently unobservable axis must not block forever), while this arm means a specific observable subject was not measured on this trip."

data provider_native_limit_cause_note: String = "THE CAUSE IS NOT THE SUBJECT, AND ITS ABSENCE IS NOT A NAME. The Codex bridge built this field as `match reached_type \{ Present \{ value: t \} => t Absent => limit_id \}` — so a bucket that reported exhaustion WITHOUT naming a cause got the bucket's own id in the cause slot, and a reader could not tell an upstream-reported `rate_limit_reached` from our own substitution. That is state-space conflation on a field whose entire job is to say why.\n\nNativeCauseUnreported is the honest arm. It is reachable: rateLimitReachedType is optional on the wire, and an exhausted bucket that omits it is a real observation — exhausted, cause unstated — distinct from both a named cause and from not having observed the bucket at all.\n\nSCOPE, stated because the other arms were NOT converted: LimitWarning, LimitRejected, LimitExhausted and LimitRateLimited still carry a bare native_token. They have one producer between them (a fixture) and no observed case of a missing token, so converting them now would add a state nothing can reach. Trigger: the first producer that cannot supply a token converts that arm rather than substituting a stand-in."

data provider_limit_reset_note: String = "AN UNOBSERVED RESET IS NOT AN IMMEDIATE ONE, AND IT WAS PREVIOUSLY NEITHER — it was nothing at all. CodexBucketUnavailableUntilReset decodes resetsAt from the wire and the projection dropped it on the floor, so an arm literally named UntilReset could not say until when. A consumer deciding whether to wait or to route elsewhere needs exactly that, and the previous answer was to guess.\n\nThe absent arm is not a defect to remove: resetsAt is optional upstream, so exhausted-with-no-stated-reset is a state the wire can produce. Carrying it as LimitResetInstantUnobserved keeps the retry decision explicit instead of letting a missing timestamp read as zero — zero being the BEST possible reset and therefore the worst available default."

type ProviderNativeLimitCause
  = NativeCauseReported { token: std.types.NonEmptyStr }
  | NativeCauseUnreported

type ProviderLimitReset
  = LimitResetAt { at: std.types.EpochSecs }
  | LimitResetInstantUnobserved

type ProviderLimitObservation
  = LimitObservationUnobserved { reason: std.types.NonEmptyStr }
  | LimitCapabilityGapUnobservable { reason: std.types.NonEmptyStr }
  | LimitSubjectUnobserved {
      subject: ProviderLimitSubject,
      native_token: std.types.NonEmptyStr,
      reason: std.types.NonEmptyStr,
    }
  | LimitObservedAvailable { subject: ProviderLimitSubject }
  | LimitWarning {
      subject: ProviderLimitSubject,
      native_token: std.types.NonEmptyStr,
      utilization_basis_points: std.measure.BasisPoint,
    }
  | LimitRejected {
      subject: ProviderLimitSubject,
      native_token: std.types.NonEmptyStr,
      reason: std.types.NonEmptyStr,
    }
  | LimitUnavailableUntilReset {
      subject: ProviderLimitSubject,
      cause: ProviderNativeLimitCause,
      reset: ProviderLimitReset,
      reason: std.types.NonEmptyStr,
    }
  | LimitExhausted { subject: ProviderLimitSubject, native_token: std.types.NonEmptyStr }
  | LimitRateLimited { subject: ProviderLimitSubject, native_token: std.types.NonEmptyStr }

type ProviderTurnOutcome
  = TurnOutcomeUnobserved { reason: std.types.NonEmptyStr }
  | TurnNotStarted
  | TurnSucceeded
  | TurnFailed { reason: std.types.NonEmptyStr }
  | TurnRefused { reason: std.types.NonEmptyStr }

type ProviderToolEnvironmentStanding
  = ToolEnvironmentStandingUnobserved { reason: std.types.NonEmptyStr }
  | ToolEnvironmentUnavailable { reason: std.types.NonEmptyStr }
  | ToolEnvironmentReady

type ProviderStandingBundle {
  installation: ProviderInstallationStanding
  authentication: ProviderAuthenticationStanding
  entitlement: ProviderEntitlementObservation
  limits: List<ProviderLimitObservation>
  turn: ProviderTurnOutcome
  tool_environment: ProviderToolEnvironmentStanding
}

type ProviderStandingObservationFact {
  provider: extdeps.llm.cli_lifecycle.ProviderInstance
  bundle: ProviderStandingBundle
}

type ProviderStanding
  = ProviderStandingUnobserved { reason: std.types.NonEmptyStr }
  | ProviderStandingFromFact {
      fact: std.claim_evidence.RecordedFact<ProviderStandingObservationFact>,
    }

data inventory_declared_standing_unobserved_reason: std.types.NonEmptyStr = "inventory row is declared, not observed at selection time" as std.types.NonEmptyStr

data selection_fixture_standing_fact_id: std.claim_evidence.RecordedFactId = "dispatch-selection-standing-fixture" as std.claim_evidence.RecordedFactId

data provider_standing_live_probe_fact_id: std.claim_evidence.RecordedFactId = "provider-standing-live-dashboard-probe" as std.claim_evidence.RecordedFactId

fn provider_standing_inventory_unobserved() -> ProviderStanding {
  ProviderStandingUnobserved { reason: inventory_declared_standing_unobserved_reason }
}

fn provider_standing_from_fixture_bundle(
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bundle: ProviderStandingBundle,
) -> ProviderStanding {
  provider_standing_from_observed_bundle(
    fact_id: selection_fixture_standing_fact_id,
    provider: provider,
    bundle: bundle,
  )
}

fn provider_standing_from_observed_bundle(
  fact_id: std.claim_evidence.RecordedFactId,
  provider: extdeps.llm.cli_lifecycle.ProviderInstance,
  bundle: ProviderStandingBundle,
) -> ProviderStanding {
  ProviderStandingFromFact {
    fact: std.claim_evidence.RecordedFact {
      id: fact_id,
      value: ProviderStandingObservationFact {
        provider: provider,
        bundle: bundle,
      },
    },
  }
}

fn provider_standing_bundle(standing: ProviderStanding) -> ProviderStandingBundle? {
  match standing {
    ProviderStandingUnobserved { reason: _ } => Absent
    ProviderStandingFromFact { fact } => Present { value: fact.value.bundle }
  }
}

fn installation_standing_is_selection_eligible(standing: ProviderInstallationStanding) -> Bool {
  match standing {
    InstallationReady => true
    InstallationStandingUnobserved { reason: _ } => false
    InstallationExecutableMissing => false
    InstallationVersionDrift { observed: _, expected: _ } => false
  }
}

fn authentication_standing_is_selection_eligible(standing: ProviderAuthenticationStanding) -> Bool {
  match standing {
    AuthenticationAuthenticated => true
    AuthenticationStandingUnobserved { reason: _ } => false
    AuthenticationCredentialsAbsent => false
    AuthenticationRecordedUnverified => false
    AuthenticationProfilePresentTokenAbsent { subscription_tier: _, token_source: _ } => false
    AuthenticationRefreshFailed { reason: _ } => false
    AuthenticationExpired => false
  }
}

fn entitlement_standing_is_selection_eligible(standing: ProviderEntitlementObservation) -> Bool {
  match standing {
    EntitlementObservedAvailable => true
    EntitlementObservationUnobserved { reason: _ } => false
    EntitlementRejected { reason: _ } => false
  }
}

fn tool_environment_standing_is_selection_eligible(
  standing: ProviderToolEnvironmentStanding,
) -> Bool {
  match standing {
    ToolEnvironmentReady => true
    ToolEnvironmentStandingUnobserved { reason: _ } => false
    ToolEnvironmentUnavailable { reason: _ } => false
  }
}

fn turn_standing_is_selection_eligible(standing: ProviderTurnOutcome) -> Bool {
  match standing {
    TurnNotStarted => true
    TurnSucceeded => true
    TurnOutcomeUnobserved { reason: _ } => false
    TurnFailed { reason: _ } => false
    TurnRefused { reason: _ } => false
  }
}

fn limit_subject_is_account_scope(subject: ProviderLimitSubject) -> Bool {
  match subject {
    ProviderAccountLimit { credential: _ } => true
    ProviderWorkspaceLimit { workspace_account: _ } => false
    ProviderModelLimit { credential: _, model: _ } => false
    ProviderNativeLimitBucket { credential: _, native_key: _ } => false
  }
}

fn limit_credential_draw_matches(
  subject_cred: ProviderLimitCredentialIdentity,
  draw_cred: ProviderLimitCredentialIdentity,
) -> Bool {
  match subject_cred {
    LimitCredentialUnspecified => true
    LimitCredentialLabel { label: subject_label } =>
      match draw_cred {
        LimitCredentialUnspecified => true
        LimitCredentialLabel { label: draw_label } => subject_label == draw_label
      }
  }
}

fn limit_subject_covers_dispatch_draw(
  subject: ProviderLimitSubject,
  draw: ProviderLimitDispatchDraw,
) -> Bool {
  match draw {
    LimitDispatchDrawUnspecified =>
      match subject {
        ProviderNativeLimitBucket { credential: _, native_key: _ } => true
        _ => limit_subject_is_account_scope(subject: subject)
      }
    LimitDispatchDrawAutomatic =>
      match subject {
        ProviderNativeLimitBucket { credential: _, native_key: _ } => true
        _ => limit_subject_is_account_scope(subject: subject)
      }
    LimitDispatchDrawAccount { credential: draw_cred } =>
      match subject {
        ProviderAccountLimit { credential: subject_cred } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
        ProviderWorkspaceLimit { workspace_account: _ } => false
        ProviderModelLimit { credential: subject_cred, model: _ } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
        ProviderNativeLimitBucket { credential: subject_cred, native_key: _ } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
      }
    LimitDispatchDrawModel { credential: draw_cred, model: draw_model } =>
      match subject {
        ProviderAccountLimit { credential: subject_cred } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
        ProviderWorkspaceLimit { workspace_account: _ } => false
        ProviderModelLimit { credential: subject_cred, model: subject_model } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          ) && subject_model == draw_model
        ProviderNativeLimitBucket { credential: subject_cred, native_key: _ } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
      }
    LimitDispatchDrawNativeBucket { credential: draw_cred, native_key: draw_key } =>
      match subject {
        ProviderAccountLimit { credential: subject_cred } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          )
        ProviderWorkspaceLimit { workspace_account: _ } => false
        ProviderModelLimit { credential: _, model: _ } => false
        ProviderNativeLimitBucket { credential: subject_cred, native_key: subject_key } =>
          limit_credential_draw_matches(
            subject_cred: subject_cred,
            draw_cred: draw_cred,
          ) && subject_key == draw_key
      }
  }
}

fn limit_observation_blocks_dispatch(
  observation: ProviderLimitObservation,
  draw: ProviderLimitDispatchDraw,
) -> Bool {
  match observation {
    LimitObservationUnobserved { reason: _ } => true
    LimitSubjectUnobserved { subject: s, native_token: _, reason: _ } =>
      limit_subject_covers_dispatch_draw(subject: s, draw: draw)
    LimitUnavailableUntilReset { subject: s, cause: _, reset: _, reason: _ } =>
      limit_subject_covers_dispatch_draw(subject: s, draw: draw)
    LimitExhausted { subject: s, native_token: _ } =>
      limit_subject_covers_dispatch_draw(subject: s, draw: draw)
    LimitRateLimited { subject: s, native_token: _ } =>
      limit_subject_covers_dispatch_draw(subject: s, draw: draw)
    LimitRejected { subject: s, native_token: _, reason: _ } =>
      match draw {
        LimitDispatchDrawUnspecified =>
          match s {
            ProviderModelLimit { credential: _, model: _ } => false
            _ => limit_subject_covers_dispatch_draw(subject: s, draw: draw)
          }
        _ => limit_subject_covers_dispatch_draw(subject: s, draw: draw)
      }
    LimitCapabilityGapUnobservable { reason: _ } => false
    LimitObservedAvailable { subject: _ } => false
    LimitWarning { subject: _, native_token: _, utilization_basis_points: _ } => false
  }
}

fn limit_observations_are_selection_eligible(
  observations: List<ProviderLimitObservation>,
  draw: ProviderLimitDispatchDraw,
) -> Bool {
  if std.types.list_length(items: observations) == 0 {
    false
  } else {
    !any(
      observations,
      observation => limit_observation_blocks_dispatch(observation: observation, draw: draw),
    )
  }
}

fn provider_standing_bundle_is_selection_eligible(
  bundle: ProviderStandingBundle,
  draw: ProviderLimitDispatchDraw,
) -> Bool {
  match draw {
    LimitDispatchDrawUnspecified => false
    _ =>
      installation_standing_is_selection_eligible(standing: bundle.installation)
        && authentication_standing_is_selection_eligible(standing: bundle.authentication)
        && entitlement_standing_is_selection_eligible(standing: bundle.entitlement)
        && limit_observations_are_selection_eligible(observations: bundle.limits, draw: draw)
        && turn_standing_is_selection_eligible(standing: bundle.turn)
        && tool_environment_standing_is_selection_eligible(standing: bundle.tool_environment)
  }
}

fn provider_standing_is_selection_eligible(
  standing: ProviderStanding,
  draw: ProviderLimitDispatchDraw,
) -> Bool {
  match provider_standing_bundle(standing: standing) {
    Present { value: bundle } =>
      provider_standing_bundle_is_selection_eligible(bundle: bundle, draw: draw)
    Absent => false
  }
}

fn first_blocking_native_limit_bucket_for_automatic_draw(
  observations: List<ProviderLimitObservation>,
) -> std.types.NonEmptyStr? {
  fold(
    observations,
    init: none,
    f: (acc, observation) => {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if limit_observation_blocks_dispatch(
            observation: observation,
            draw: LimitDispatchDrawAutomatic,
          ) {
            match observation {
              LimitExhausted { subject: s, native_token: _ } =>
                match s {
                  ProviderNativeLimitBucket { credential: _, native_key: key } =>
                    v2.std.optional.optional_present(value: key)
                  _ => v2.std.optional.optional_absent()
                }
              LimitRateLimited { subject: s, native_token: _ } =>
                match s {
                  ProviderNativeLimitBucket { credential: _, native_key: key } =>
                    v2.std.optional.optional_present(value: key)
                  _ => v2.std.optional.optional_absent()
                }
              LimitUnavailableUntilReset { subject: s, cause: _, reset: _, reason: _ } =>
                match s {
                  ProviderNativeLimitBucket { credential: _, native_key: key } =>
                    v2.std.optional.optional_present(value: key)
                  _ => v2.std.optional.optional_absent()
                }
              _ => v2.std.optional.optional_absent()
            }
          } else {
            v2.std.optional.optional_absent()
          }
      }
    },
  )
}

data dispatch_automatic_provider_preference_note: String = "AUTHORED preference order for automatic provider selection. Incidental inventory list order must never decide; this row is the sole authority. Filter ineligible offers by standing first, then walk this preference list and select the first eligible match, or refuse typed when none qualify."

data dispatch_automatic_provider_preference: List<extdeps.llm.cli_lifecycle.ProviderKind> = [
  extdeps.llm.cli_lifecycle.ClaudeCliProvider,
  extdeps.llm.cli_lifecycle.CursorCliProvider,
  extdeps.llm.cli_lifecycle.CodexCliProvider,
]

fn optional_kind_when_eligible(
  kind: extdeps.llm.cli_lifecycle.ProviderKind,
  eligible_kinds: List<extdeps.llm.cli_lifecycle.ProviderKind>,
) -> extdeps.llm.cli_lifecycle.ProviderKind? {
  if any(eligible_kinds, eligible => eligible == kind) {
    v2.std.optional.optional_present(value: kind)
  } else {
    v2.std.optional.optional_absent()
  }
}

fn select_first_preferred_kind(
  preference: List<extdeps.llm.cli_lifecycle.ProviderKind>,
  eligible_kinds: List<extdeps.llm.cli_lifecycle.ProviderKind>,
) -> extdeps.llm.cli_lifecycle.ProviderKind? {
  fold(
    preference,
    init: none,
    f: (acc, kind) => {
      match acc {
        Present { value: _ } => acc
        Absent => optional_kind_when_eligible(kind: kind, eligible_kinds: eligible_kinds)
      }
    },
  )
}

fn fixture_standing_bundle_authenticated_available() -> ProviderStandingBundle {
  ProviderStandingBundle {
    installation: InstallationReady,
    authentication: AuthenticationAuthenticated,
    entitlement: EntitlementObservedAvailable,
    limits: [
      LimitObservedAvailable {
        subject: ProviderAccountLimit { credential: LimitCredentialUnspecified },
      },
    ],
    turn: TurnNotStarted,
    tool_environment: ToolEnvironmentReady,
  }
}

fn fixture_standing_bundle_authenticated_unavailable_until_reset() -> ProviderStandingBundle {
  ProviderStandingBundle {
    installation: InstallationReady,
    authentication: AuthenticationAuthenticated,
    entitlement: EntitlementObservedAvailable,
    limits: [
      LimitUnavailableUntilReset {
        subject: ProviderAccountLimit { credential: LimitCredentialUnspecified },
        cause: NativeCauseReported { token: "seven_day" as std.types.NonEmptyStr },
        reset: LimitResetInstantUnobserved,
        reason: "weekly cap exhausted until reset" as std.types.NonEmptyStr,
      },
    ],
    turn: TurnNotStarted,
    tool_environment: ToolEnvironmentReady,
  }
}

fn fixture_standing_bundle_cursor_capability_gap() -> ProviderStandingBundle {
  ProviderStandingBundle {
    installation: InstallationReady,
    authentication: AuthenticationAuthenticated,
    entitlement: EntitlementObservedAvailable,
    limits: [
      LimitCapabilityGapUnobservable {
        reason: "cursor local has no account-level headroom surface" as std.types.NonEmptyStr,
      },
    ],
    turn: TurnNotStarted,
    tool_environment: ToolEnvironmentReady,
  }
}

data claude_profile_present_token_absent_live_fixture_note: String = "LIVE RECEIPT (eager-raven-845, 2026-08-06): Claude credential home whose oauthAccount carries full subscription profile metadata — claude_max, stripe_subscription — while control_response reports account.tokenSource=none. Ambient home and isolated file-tree copy give bit-identical .claude.json sha256 with apiKeySource=none; profile is file-resident, token is not. Every attempt terminates authentication_failed. Naive derivation from oauthAccount alone would conclude authenticated; that is fabricated-plausible-output in the dangerous direction. ClaudeStateRootRef { root: FilePath } denotes the profile tree, not the authority to act — slice C must not treat file-residence as credential binding."

fn fixture_standing_bundle_claude_profile_present_token_absent() -> ProviderStandingBundle {
  ProviderStandingBundle {
    installation: InstallationReady,
    authentication: AuthenticationProfilePresentTokenAbsent {
      subscription_tier: "claude_max" as std.types.NonEmptyStr,
      token_source: "none" as std.types.NonEmptyStr,
    },
    entitlement: EntitlementObservedAvailable,
    limits: [
      LimitObservedAvailable {
        subject: ProviderAccountLimit { credential: LimitCredentialUnspecified },
      },
    ],
    turn: TurnFailed {
      reason: "authentication_failed" as std.types.NonEmptyStr,
    },
    tool_environment: ToolEnvironmentReady,
  }
}
