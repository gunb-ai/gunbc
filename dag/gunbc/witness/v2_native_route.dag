module gunbc.witness_v2_native_route

import v2.std.algebra { any, filter, fold_list, is_empty, length }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present }
import v2.workflow.compile_door_ledger {
  CauseOwnership,
  DiagnosticGrain,
  FatalGrain,
  HeadGrain,
  cause_ownership_lookup
}

// THE LANE AUTHORITY FOR THE required-v2-native CI JOB (operator authorization 2026-09-09: one
// additional required job, modelled beside the workflow authority that will project it — never
// a hand-edit of the generated YAML). The job's subject is the compiler/test EXECUTION ROUTE
// itself: the emitted-native compiler binary, invoked by explicit path, over a derived
// v2.test.* population. The 32 native-only construct arms are explicitly NOT this proof — they
// show generated Rust programs ran natively while the claim executor stayed seed-backed; this
// lane's receipt must show which binary answered.
//
// STANDING AT AUTHORING: the emitted native compiler — the DirectIngestDriver main emitted for
// the 00_compile closure — refuses every real v2.test.* module today. Its admission is
// hard-coded to the compile_driver_subject name with an empty import environment, and the v2
// compile door is at its modelled frontier for the whole corpus (v2.workflow.compile_door_ledger
// carries the interpreted door's burn-down; the native and interpreted routes agree on the
// probed modules, so the blocker is the compiler frontier, not a native divergence). The
// contracted positive population is therefore EMPTY, and native_route_admission refuses an
// empty positive population by construction — the empty-observation narrow is the one verdict
// this lane may never issue. The lane is modelled in full here; ENROLMENT into the required
// workflow is blocked on the door frontier, with the trigger and the exact enrolment edit
// carried as data at the bottom of this module.

// THE JOB IDENTITY IS ONE ROW. The workflow enrolment edit, the receipt, and the witnesses all
// cite this declaration; no second spelling of the job name anywhere.
data required_v2_native_job_name: String = "required-v2-native"

// THE UNIVERSE IS A PREFIX, NOT A ROSTER. The population is DERIVED from the module census by
// prefix membership — a hand-listed roster would silently drift from the tree it claims to
// cover. The prefix is the same `v2.test.` the required floor gates on (v2.workflow.required_floor
// required_gate_prefixes): the native lane's universe is the floor's witness universe asked of
// a different route. The contract's "no silent remainder" binds INSIDE the universe: every
// universe member carries exactly one verdict row, and every refused verdict carries exactly
// one classified cause.
data native_route_universe_prefix: String = "v2.test."

fn native_route_universe_member(module_qn: String) -> Bool {
  starts_with(s: module_qn, prefix: native_route_universe_prefix)
}

fn native_route_universe(module_qns: List<String>) -> List<String> {
  filter(xs: module_qns, predicate: fn(qn) { native_route_universe_member(module_qn: qn) })
}

// ONE ROW PER UNIVERSE MEMBER. NativeAccepted is the positive population. NativeRefused carries
// TWO reason symbols because the compiler's rejection is a list with a grain the row must not
// hide: rejected_with_pending PREPENDS the non-fatal pending diagnostics, so the head reason is
// an advisory that rode along while the LAST diagnostic is the fatal cause the member is
// excluded for. The door ledger records the head; this lane records both and classifies on the
// fatal — the two instruments join on head_reason while the exclusion cause stays honest about
// what actually refused.
type NativeRouteVerdict
  = NativeAccepted
  | NativeRefused { head_reason: Symbol, fatal_reason: Symbol }

type NativeRouteMemberRow {
  module_path: String
  verdict: NativeRouteVerdict
}

// THE EXCLUSION TAXONOMY. A refused member is excluded for exactly one of three causes: the
// compiler's own frontier (attributed to its owning lane through the door ledger's
// known_frontier_causes at FATAL grain — this lane delegates to that table, it does not
// re-enumerate it); the emitted driver's admission limit (a native-route fact the interpreted
// door never faces, owned here); or NOTHING — an unattributed refusal, which is never silently
// bucketed: it blocks admission until someone owns it, the same fail-closed reading the door
// ledger gives an unowned head reason.
type NativeRouteExclusionCause
  = CompilerFrontierAttributed { reason: Symbol }
  | NativeDriverAdmissionLimit { reason: Symbol }
  | UnattributedRefusal { reason: Symbol }

// The emitted DirectIngestDriver hard-codes admission to the compile_driver_subject name with
// an empty import environment, so resolve_module_not_found on this route is the DRIVER's limit,
// not the module's defect: every real module is named something else, and every import is
// unresolvable under it. The roster is data so a driver widening deletes a row rather than
// editing a predicate.
data native_driver_limit_reasons: List<Symbol> = [ ^resolve_module_not_found ]

fn native_driver_limit_reason(reason: Symbol) -> Bool {
  any(xs: native_driver_limit_reasons, predicate: fn(r) { r == reason })
}

// The exclusion question is asked at FATAL grain: the fatal reason is the cause that actually
// refused the member, so its ownership row is the FatalGrain one. Asking the head-grain
// question of a fatal reason was the grain crossing the review named — the same symbol can be
// owned at one grain and unowned at the other, and only the fatal-grain answer classifies an
// exclusion.
fn classify_native_refusal(reason: Symbol) -> NativeRouteExclusionCause {
  if native_driver_limit_reason(reason: reason) {
    NativeDriverAdmissionLimit { reason: reason }
  } else {
    match cause_ownership_lookup(cause: reason, grain: FatalGrain) {
      Present { value: _ } => CompilerFrontierAttributed { reason: reason }
      Absent => UnattributedRefusal { reason: reason }
    }
  }
}

// THE HEAD REASON IS NOT DEAD RECEIPT DATA. rejected_with_pending prepends the non-fatal
// advisory, so the head reason is a real observation of the frontier at a different grain —
// the same observation the door ledger's own rows carry. Every refused row's head reason must
// therefore be owned at HEAD grain: an unowned advisory is a new frontier cause surfacing
// where nobody counted it, and it blocks admission by its own name rather than riding along
// unclassified.
fn native_route_head_advisory_attributed(reason: Symbol) -> Bool {
  native_driver_limit_reason(reason: reason)
    || match cause_ownership_lookup(cause: reason, grain: HeadGrain) {
      Present { value: _ } => true
      Absent => false
    }
}

fn native_route_head_advisories_all_attributed(rows: List<NativeRouteMemberRow>) -> Bool {
  !any(xs: rows, predicate: fn(row) {
    match row.verdict {
      NativeAccepted => false
      NativeRefused { head_reason: h, fatal_reason: _ } =>
        !native_route_head_advisory_attributed(reason: h)
    }
  })
}

// THE COUNTED PARTITION the contract names ("every excluded member typed and counted"). The
// census is DERIVED from the rows, never accumulated beside them — a counter that disagrees
// with the population it summarizes has no constructor here.
type NativeRouteExclusionCensus {
  accepted: Int
  excluded_compiler_frontier: Int
  excluded_driver_limit: Int
  excluded_unattributed: Int
}

fn native_route_exclusion_census(rows: List<NativeRouteMemberRow>) -> NativeRouteExclusionCensus {
  fold_list(
    xs: rows,
    empty: NativeRouteExclusionCensus {
      accepted: 0,
      excluded_compiler_frontier: 0,
      excluded_driver_limit: 0,
      excluded_unattributed: 0
    },
    cons: fn(acc, row) {
      match row.verdict {
        NativeAccepted => NativeRouteExclusionCensus {
          accepted: acc.accepted + 1,
          excluded_compiler_frontier: acc.excluded_compiler_frontier,
          excluded_driver_limit: acc.excluded_driver_limit,
          excluded_unattributed: acc.excluded_unattributed
        }
        NativeRefused { head_reason: _, fatal_reason: r } =>
          match classify_native_refusal(reason: r) {
            CompilerFrontierAttributed { reason: _ } => NativeRouteExclusionCensus {
              accepted: acc.accepted,
              excluded_compiler_frontier: acc.excluded_compiler_frontier + 1,
              excluded_driver_limit: acc.excluded_driver_limit,
              excluded_unattributed: acc.excluded_unattributed
            }
            NativeDriverAdmissionLimit { reason: _ } => NativeRouteExclusionCensus {
              accepted: acc.accepted,
              excluded_compiler_frontier: acc.excluded_compiler_frontier,
              excluded_driver_limit: acc.excluded_driver_limit + 1,
              excluded_unattributed: acc.excluded_unattributed
            }
            UnattributedRefusal { reason: _ } => NativeRouteExclusionCensus {
              accepted: acc.accepted,
              excluded_compiler_frontier: acc.excluded_compiler_frontier,
              excluded_driver_limit: acc.excluded_driver_limit,
              excluded_unattributed: acc.excluded_unattributed + 1
            }
          }
      }
    }
  )
}

// "No silent remainder" as an executing check: the four counters close over the population.
fn native_route_census_is_total(
  census: NativeRouteExclusionCensus,
  rows: List<NativeRouteMemberRow>
) -> Bool {
  census.accepted + census.excluded_compiler_frontier
    + census.excluded_driver_limit + census.excluded_unattributed == length(xs: rows)
}

// THE NO-FALLBACK CONTROL IS A RECEIVED FACT, NOT AN ASSUMPTION. After the emitted compiler
// exists, the old compiler/interpreter route is made unavailable — or an executing falsifier
// is armed that fails if the old route is touched — and the receipt records WHICH control
// held. OldRouteControlAbsent is representable so admission can refuse it by name: a receipt
// that cannot say how fallback was closed has not closed it.
type NativeRouteOldRouteControl
  = OldRouteWithdrawn { withdrawn_executable: String }
  | OldRouteFalsifierArmed { falsifier_identity: String }
  | OldRouteControlAbsent

// The deliberately broken specimen is the route's RED control: a source the compiler must
// refuse. If the emitted binary ACCEPTS it, the route's refusal arm is dead and every refusal
// verdict in the population is worthless — admission refuses.
type NativeRouteBrokenControl
  = BrokenSpecimenRefused { reason: Symbol }
  | BrokenSpecimenAccepted

// THE TERMINAL OBSERVATION. Every identity the contract names is a field: the tested tree; the
// seed used ONLY to prepare the emitted compiler (recorded honestly — this job does not claim
// native bootstrap); the emitted closure's identity; the executed binary's path AND content
// identity (route identity is observed, never synthesized from the intended command); the
// per-member verdicts; and both controls.
type NativeRouteReceipt {
  job: String
  tested_tree: String
  preparation_seed_identity: String
  emitted_closure_identity: String
  executable_path: String
  executable_identity: String
  population: List<NativeRouteMemberRow>
  broken_control: NativeRouteBrokenControl
  old_route_control: NativeRouteOldRouteControl
}

// ADMISSION IS THE CONTRACT, ONE AUTHORITY, ONE CLAUSE PER PREDICATE. The job greens only when
// all hold: the receipt is well-formed (right job, identities recorded, population actually
// derived — an empty population is a harness failure, not a result); the positive population
// is non-empty (NativeAccepted IS the positive population, so the load-bearing clause is
// non-emptiness: an all-refused census proves the route refused, not that it routed); the
// broken specimen still refused; every exclusion is classified — the lane does not green over
// unowned refusals; route identity is recorded; and the old-route control is present. The fold
// collects EVERY violated clause rather than stopping at the first, so one red run names
// everything that must change before the next run.
type NativeRouteAdmissionRefusalCause
  = JobNameMismatch
  | TestedTreeUnrecorded
  | PreparationSeedUnrecorded
  | EmittedClosureUnrecorded
  | PopulationUnderived
  | PositivePopulationEmpty
  | BrokenSpecimenAcceptedByRoute
  | UnattributedExclusionsPresent
  | UnattributedHeadAdvisoryPresent
  | RouteIdentityUnrecorded
  | OldRouteControlNeverInstalled

type NativeRouteAdmission
  = NativeRouteAdmitted
  | NativeRouteRefused { causes: List<NativeRouteAdmissionRefusalCause> }

fn native_route_job_name_matches(receipt: NativeRouteReceipt) -> Bool {
  receipt.job == required_v2_native_job_name
}

fn native_route_tested_tree_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.tested_tree != ""
}

// The seed and the closure are DIFFERENT observations and refuse by DIFFERENT names: folding
// them into one predicate made EmittedClosureUnrecorded unreachable (a receipt with a recorded
// seed and an unrecorded closure reported preparation_seed_unrecorded), which is the
// grain-mismatch class DESIGN 4b(3) names. One predicate per observation.
fn native_route_preparation_seed_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.preparation_seed_identity != ""
}

fn native_route_emitted_closure_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.emitted_closure_identity != ""
}

fn native_route_population_derived(receipt: NativeRouteReceipt) -> Bool {
  !is_empty(xs: receipt.population)
}

fn native_route_positive_population_present(receipt: NativeRouteReceipt) -> Bool {
  length(xs: filter(xs: receipt.population, predicate: fn(row) {
    match row.verdict {
      NativeAccepted => true
      NativeRefused { head_reason: _, fatal_reason: _ } => false
    }
  })) > 0
}

fn native_route_broken_control_holds(receipt: NativeRouteReceipt) -> Bool {
  match receipt.broken_control {
    BrokenSpecimenRefused { reason: _ } => true
    BrokenSpecimenAccepted => false
  }
}

fn native_route_exclusions_all_classified(receipt: NativeRouteReceipt) -> Bool {
  native_route_exclusion_census(rows: receipt.population).excluded_unattributed == 0
}

fn native_route_identity_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.executable_path != "" && receipt.executable_identity != ""
}

fn native_route_old_route_closed(receipt: NativeRouteReceipt) -> Bool {
  match receipt.old_route_control {
    OldRouteWithdrawn { withdrawn_executable: _ } => true
    OldRouteFalsifierArmed { falsifier_identity: _ } => true
    OldRouteControlAbsent => false
  }
}

fn native_route_admission(receipt: NativeRouteReceipt) -> NativeRouteAdmission {
  let c1 = if native_route_job_name_matches(receipt: receipt) { [] } else { [JobNameMismatch] }
  let c2 = if native_route_tested_tree_recorded(receipt: receipt) { c1 } else { concat(c1, [TestedTreeUnrecorded]) }
  let c3 = if native_route_preparation_seed_recorded(receipt: receipt) { c2 } else { concat(c2, [PreparationSeedUnrecorded]) }
  let c4 = if native_route_emitted_closure_recorded(receipt: receipt) { c3 } else { concat(c3, [EmittedClosureUnrecorded]) }
  let c5 = if native_route_population_derived(receipt: receipt) { c4 } else { concat(c4, [PopulationUnderived]) }
  let c6 = if native_route_positive_population_present(receipt: receipt) { c5 } else { concat(c5, [PositivePopulationEmpty]) }
  let c7 = if native_route_broken_control_holds(receipt: receipt) { c6 } else { concat(c6, [BrokenSpecimenAcceptedByRoute]) }
  let c8 = if native_route_exclusions_all_classified(receipt: receipt) { c7 } else { concat(c7, [UnattributedExclusionsPresent]) }
  let c9 = if native_route_head_advisories_all_attributed(rows: receipt.population) { c8 } else { concat(c8, [UnattributedHeadAdvisoryPresent]) }
  let c10 = if native_route_identity_recorded(receipt: receipt) { c9 } else { concat(c9, [RouteIdentityUnrecorded]) }
  let causes = if native_route_old_route_closed(receipt: receipt) { c10 } else { concat(c10, [OldRouteControlNeverInstalled]) }
  if is_empty(xs: causes) { NativeRouteAdmitted } else { NativeRouteRefused { causes: causes } }
}

// The job's terminal print renders causes by name; the projection lives beside the coproduct,
// so a new cause refuses to compile until it is named (exhaustive match). The membership probe
// is how a witness — and the enrolment gate's report — asks for one clause's verdict without
// re-matching the whole coproduct.
fn native_route_admission_refusal_cause_name(cause: NativeRouteAdmissionRefusalCause) -> String {
  match cause {
    JobNameMismatch => "job_name_mismatch"
    TestedTreeUnrecorded => "tested_tree_unrecorded"
    PreparationSeedUnrecorded => "preparation_seed_unrecorded"
    EmittedClosureUnrecorded => "emitted_closure_unrecorded"
    PopulationUnderived => "population_underived"
    PositivePopulationEmpty => "positive_population_empty"
    BrokenSpecimenAcceptedByRoute => "broken_specimen_accepted_by_route"
    UnattributedExclusionsPresent => "unattributed_exclusions_present"
    UnattributedHeadAdvisoryPresent => "unattributed_head_advisory_present"
    RouteIdentityUnrecorded => "route_identity_unrecorded"
    OldRouteControlNeverInstalled => "old_route_control_never_installed"
  }
}

fn native_route_admitted(admission: NativeRouteAdmission) -> Bool {
  match admission {
    NativeRouteAdmitted => true
    NativeRouteRefused { causes: _ } => false
  }
}

fn native_route_admission_refused_with(
  admission: NativeRouteAdmission,
  cause_name: String
) -> Bool {
  match admission {
    NativeRouteAdmitted => false
    NativeRouteRefused { causes: causes } =>
      any(xs: causes, predicate: fn(c) {
        native_route_admission_refusal_cause_name(cause: c) == cause_name
      })
  }
}

// The terminal print of one run: every violated clause, one line's worth. Derived from the
// causes, never accumulated beside them.
fn native_route_admission_summary(admission: NativeRouteAdmission) -> String {
  match admission {
    NativeRouteAdmitted => "admitted"
    NativeRouteRefused { causes: causes } => concat(
      "refused: ",
      fold_list(
        xs: causes,
        empty: "",
        cons: fn(acc, c) {
          let name = native_route_admission_refusal_cause_name(cause: c)
          if acc == "" { name } else { concat(acc, ", ", name) }
        }
      )
    )
  }
}

// ENROLMENT IS THE ADMISSION QUESTION ASKED OF THE REAL CENSUS. The gate derives the lane's
// enrolment state from a census receipt — the same predicate the enrolled job will gate on,
// asked before enrolment, so the enrolment decision and the standing verdict can never be two
// facts.
type NativeRouteEnrolment
  = EnrolmentOpen
  | EnrolmentBlocked { causes: List<NativeRouteAdmissionRefusalCause> }

fn native_route_enrolment(census: NativeRouteReceipt) -> NativeRouteEnrolment {
  match native_route_admission(receipt: census) {
    NativeRouteAdmitted => EnrolmentOpen
    NativeRouteRefused { causes: causes } => EnrolmentBlocked { causes: causes }
  }
}

// TODAY'S STANDING, AS DATA. The lane is modelled in full and its enrolment is BLOCKED on the
// compile-door frontier. The trigger names the CAPABILITY that unblocks it (DESIGN 4b(3): a
// trigger names the capability, never an artifact that would contribute to one), and the edit
// row names the exact mechanical change that lands it, so the future lane author executes
// rather than re-derives. This row DELETES at enrolment: once the job stands in the required
// workflow, the standing it records here is the job's own receipt, not a row beside it.
type NativeRouteEnrolmentState
  = EnrolmentOpenToday
  | EnrolmentAwaitingDoorFrontier

type NativeRouteEnrolmentStanding {
  state: NativeRouteEnrolmentState
  trigger: String
  enrolment_edit: String
  census_evidence: String
}

data native_route_enrolment_standing: NativeRouteEnrolmentStanding = NativeRouteEnrolmentStanding {
  state: EnrolmentAwaitingDoorFrontier,
  trigger: "the emitted native compiler accepts at least one real v2.test.* module — the compile-door frontier (v2.workflow.compile_door_ledger known_frontier_causes burn-down) has closed far enough that the derived positive population is non-empty; re-derive by running the census recipe named in census_evidence and evaluating native_route_enrolment over its receipt",
  enrolment_edit: "add V2NativeLane to gunbc.required_ci_phase_roster RequiredCiLane with its phase variant(s) enrolled in required_ci_phases and owned by the new lane in required_ci_phase_lane, mirror the variants in claim_executor (the per-run host join refuses a divergence in either direction), add WitnessFloorV2NativeLane to gunbc.witness_floor_workflow witness_floor_lane_roster with its job materialization (seed builds once, emits the compiler closure, cargo-builds it, withdraws the old route, runs the census and both controls, prints the receipt, gates on native_route_admission), add the lane to required_lanes_roster so the aggregate witnesses job needs it, regenerate .github/workflows/witnesses.yml",
  census_evidence: "local census harness on the PR-#10692 head (tree f173aaa24860a0efe7b2142cefcedc69675ff66f): emit via `gunbc compile --entry src/v2/compiler/00_compile.dag --source-root dag --source-root src/v2 --target rust`, cargo build with the repo-pinned toolchain, withdraw the seed binary, invoke the emitted binary by explicit path over every derived universe member, classify each verdict with classify_native_refusal. Measured 2026-09-09 over the derived universe of 882 members: zero accepted, 882 refused with every fatal cause attributed (the five causes the door-ledger table lacked were added to it by this lane's measurement), the broken specimen refused, and native_route_admission over the real receipt executed to `refused: positive_population_empty`"
}

fn native_route_enrolment_blocked_today(standing: NativeRouteEnrolmentStanding) -> Bool {
  match standing.state {
    EnrolmentAwaitingDoorFrontier => true
    EnrolmentOpenToday => false
  }
}
