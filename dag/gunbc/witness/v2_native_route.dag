module gunbc.witness_v2_native_route

import v2.std.algebra { any, filter, fold_list, is_empty, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.optional { Absent, Optional, Present }
import v2.compiler.native_test_vocabulary {
  NativeTestVerdict, NativeTestPassed, NativeTestReturnedFalse, NativeTestReturnedOther, NativeTestRefused,
  NativeTestStage, NativeTestStageContext, NativeTestStagePrepare, NativeTestStageEntry, NativeTestStageEval,
  NativeTestFileRefusal
}
import v2.workflow.compile_door_cause_ownership {
  DiagnosticGrain, FatalGrain, HeadGrain, cause_ownership_lookup
}
import v2.workflow.floor_expected_red { floor_expected_red_roster }
import v2.workflow.floor_route_gap { floor_route_gap_roster }

// THE LANE AUTHORITY FOR THE required-v2-native CI JOB (operator authorization 2026-09-09: one
// additional required job, modelled beside the workflow authority that projects it — never a
// hand-edit of the generated YAML). The job's subject is the compiler/test EXECUTION ROUTE
// itself: the emitted-native compiler binary, invoked by explicit path, executing a derived
// v2.test.* population through its own whole-source-root Eval driver
// (std.compiler_entry SourceRootEvalDriver — the v2.compiler.compile native_test_* fold), and
// reaching a TERMINAL TEST VERDICT per identity. The 32 native-only construct arms are
// explicitly NOT this proof — they show generated Rust programs ran natively while the claim
// executor stayed seed-backed; this lane's receipt must show which binary answered, and what
// verdict each named test reached.
//
// THE TERMINAL SUBJECT IS THE TEST IDENTITY, NOT THE MODULE. A module accepted for translation
// proves the front door opened; it says nothing about whether any declaration inside it was
// located, evaluated, or returned its expected verdict. Every row of this lane's population is
// keyed by the qualified `<module>.<declaration>` identity — the same grain the required floor
// gates on — and the verdict carried is the driver's own NativeTestVerdict, imported from
// v2.compiler.compile rather than re-declared here (DESIGN 3: one authority for the verdict
// vocabulary; a second route-local verdict type would be a nickname).
//
// THE ROUTE IS EVAL, NOT TRANSLATION. The driver resolves the exact test declaration inside a
// whole-ingest context, infers it, and evaluates it under eval_default_interpretation — the
// same hermetic effect policy the floor's execution mode runs (every host-effect boundary
// disallowed). A test that reaches for a host effect refuses at the Eval stage on this route,
// exactly as it gaps on the floor; the floor_route_gap roster is the independently established
// expectation that pairing consumes.

// THE JOB IDENTITY IS ONE ROW. The workflow job materialization, the receipt, and the witnesses
// all cite this declaration; no second spelling of the job name anywhere.
data required_v2_native_job_name: String = "required-v2-native"

// THE UNIVERSE IS A PREFIX, NOT A ROSTER. The population is DERIVED from the tree's test
// discovery by prefix membership — a hand-listed roster would silently drift from the tree it
// claims to cover. The prefix is the same `v2.test.` the required floor gates on
// (v2.workflow.required_floor required_gate_prefixes): the native lane's universe is the floor's
// witness universe asked of a different route. The universe is derived by the host harness from
// the floor's own discovery producer (v2.workflow.floor_discovery_producer) joined against each
// entry's authored module header, and carried on the receipt; admission checks its shape and
// joins the observed population against it exactly.
data native_route_universe_prefix: String = "v2.test."

fn native_route_universe_member(module_qn: String) -> Bool {
  starts_with(s: module_qn, prefix: native_route_universe_prefix)
}

// ONE TEST IDENTITY, STRUCTURED. The module qualified name and the declaration name are separate
// observations — the emitted binary reports them separately, and the dotted spelling is DERIVED
// here (never parsed back out of a string), the same derivation the floor's
// witness_identity_qualified_name makes. Function names carry no dots, so the dotted form's last
// segment is always the declaration; the split is unambiguous in both directions.
type NativeRouteTestIdentity {
  module: String
  declaration: String
}

fn native_route_identity_qualified(identity: NativeRouteTestIdentity) -> String {
  concat(concat(identity.module, "."), identity.declaration)
}

fn native_route_identity_eq(a: NativeRouteTestIdentity, b: NativeRouteTestIdentity) -> Bool {
  a.module == b.module && a.declaration == b.declaration
}

fn native_route_identity_member(target: NativeRouteTestIdentity, xs: List<NativeRouteTestIdentity>) -> Bool {
  any(xs: xs, predicate: fn(x) { native_route_identity_eq(a: x, b: target) })
}

// NO DUPLICATE IDENTITIES, asked the same way of the universe and of the observed population: an
// identity appearing twice means the derivation double-counted a declaration or the harness
// recorded one run twice, and both are harness defects, not results. Quadratic by construction —
// the interpreter measured this shape over the full derived population at tens of seconds, and
// the standing bare-minimum-cost ruling prices the fold, not the realized n.
fn native_route_identities_unique(xs: List<NativeRouteTestIdentity>) -> Bool {
  !any(xs: xs, predicate: fn(x) {
    length(xs: filter(xs: xs, predicate: fn(y) { native_route_identity_eq(a: x, b: y) })) > 1
  })
}

// THE REFERENCE EXPECTATION, PER MEMBER, FROM THE FLOOR'S OWN ROSTERS. Pairing a native verdict
// against nothing proves nothing about agreement; the independently established expectation is
// the required floor's, joined at the exact qualified identity. Three arms, derived — never
// transcribed: route-gap membership is asked FIRST because an identity on both rosters is a
// route-gap fact (the floor executes it and it gaps), and expected-red second; the remainder is
// the floor's standing expectation for every discovered v2.test.* member — pass — which is the
// expectation a green floor asserts of every unrostered identity by construction.
type NativeRouteReference
  = FloorExpectedPass
  | FloorExpectedRed
  | FloorRouteGapRefusal

fn native_route_reference_for(
  qualified: String,
  expected_red: List<String>,
  route_gap: List<String>
) -> NativeRouteReference {
  if any(xs: route_gap, predicate: fn(r) { r == qualified }) {
    FloorRouteGapRefusal
  } else if any(xs: expected_red, predicate: fn(r) { r == qualified }) {
    FloorExpectedRed
  } else {
    FloorExpectedPass
  }
}

// ONE ROW PER UNIVERSE MEMBER: the identity and the verdict the emitted native binary observed
// for it. The verdict is the driver's NativeTestVerdict verbatim — Passed, ReturnedFalse,
// ReturnedOther, or Refused at a named stage with the fatal reason — so the receipt carries what
// the route observed, not a summary of it.
type NativeRouteMemberRow {
  identity: NativeRouteTestIdentity
  verdict: NativeTestVerdict
}

// THE MODULE → SOURCE-PATH RELATION, OVER THE UNIVERSE'S OWN MODULES. A Context-stage row is a
// derived classification minted by the host from a file refusal, and the derivation's join key
// is this relation: the observation names a module, the file refusal names a path, and only the
// module → path row binds the two. The receipt carries it (restricted to the universe's modules
// — the whole domain the classification can touch) so admission can require the backing file
// refusal to belong to the ROW'S OWN module, not to some file anywhere with the same reason.
// The path is a Symbol because the join partner — NativeTestFileRefusal.path — is one.
type NativeRouteModuleSource {
  module: String
  path: Symbol
}

// THE EXCLUSION TAXONOMY, CLASSIFIED FROM STAGE AND PROVENANCE — never from the reason symbol
// alone (the review's standing instruction: the same symbol is a driver limit on one route and a
// resolver defect on another). A refused member is excluded for exactly one of these causes:
// the compiler's own frontier (attributed to its owning lane through the door ledger's
// known_frontier_causes at FATAL grain — this lane delegates to that table, it does not
// re-enumerate it); the driver's entry resolution (the declaration was not an evaluable arrow —
// a test data row or an absent name — a driver fact the door never faces, owned here); the
// hermetic effect boundary (the test reached a host effect the Eval interpretation does not
// bind); or NOTHING — an unattributed refusal, which is never silently bucketed: it blocks
// admission until someone owns it, the same fail-closed reading the door ledger gives an
// unowned head reason.
type NativeRouteExclusionCause
  = CompilerFrontierAttributed { reason: Symbol }
  | NativeEntryResolutionLimit { reason: Symbol }
  | NativeEvalBoundary { reason: Symbol }
  | UnattributedRefusal { reason: Symbol }

// The driver's entry stage refuses for exactly these reasons today: the named declaration was
// not found in the prepared module, or it was found and is not an arrow (a test data row carries
// no body to evaluate). The roster is data so a driver widening deletes a row rather than
// editing a predicate; an entry-stage refusal with any other reason is unattributed, not
// assumed.
data native_route_entry_limit_reasons: List<Symbol> = [
  ^native_test_entry_declaration_not_found,
  ^native_test_entry_declaration_not_arrow
]

// The hermetic boundary's reason family: eval_default_interpretation binds no host effect, so a
// test that reaches one refuses with one of these. An Eval-stage refusal with any OTHER reason
// is not a boundary observation — it is an eval defect or a compiler frontier cause, and it is
// classified through the door ledger or left unattributed, never waved through as a boundary.
data native_route_effect_boundary_reasons: List<Symbol> = [
  ^eval_rejected_effect_io_unbound,
  ^eval_rejected_effect_io_write_payload_mismatch,
  ^eval_rejected_effect_io_roundtrip_arity
]

fn native_route_reason_member(reason: Symbol, roster: List<Symbol>) -> Bool {
  any(xs: roster, predicate: fn(r) { r == reason })
}

// THE CLASSIFICATION QUESTION IS ASKED AT FATAL GRAIN for the compiler-frontier arm: the fatal
// reason is the cause that actually refused, so its ownership row is the FatalGrain one. Asking
// the head-grain question of a fatal reason was the grain crossing the review named — the same
// symbol can be owned at one grain and unowned at the other, and only the fatal-grain answer
// classifies an exclusion.
fn classify_native_refusal(stage: NativeTestStage, reason: Symbol) -> NativeRouteExclusionCause {
  match stage {
    NativeTestStageEntry =>
      if native_route_reason_member(reason: reason, roster: native_route_entry_limit_reasons) {
        NativeEntryResolutionLimit { reason: reason }
      } else {
        UnattributedRefusal { reason: reason }
      }
    NativeTestStageEval =>
      if native_route_reason_member(reason: reason, roster: native_route_effect_boundary_reasons) {
        NativeEvalBoundary { reason: reason }
      } else {
        match cause_ownership_lookup(cause: reason, grain: FatalGrain) {
          Present { value: _ } => CompilerFrontierAttributed { reason: reason }
          Absent => UnattributedRefusal { reason: reason }
        }
      }
    NativeTestStageContext =>
      match cause_ownership_lookup(cause: reason, grain: FatalGrain) {
        Present { value: _ } => CompilerFrontierAttributed { reason: reason }
        Absent => UnattributedRefusal { reason: reason }
      }
    NativeTestStagePrepare =>
      match cause_ownership_lookup(cause: reason, grain: FatalGrain) {
        Present { value: _ } => CompilerFrontierAttributed { reason: reason }
        Absent => UnattributedRefusal { reason: reason }
      }
  }
}

// THE DISPOSITION OF ONE MEMBER: the (verdict, reference) pair, decided whole. A VERDICT the
// native route reached must AGREE with the reference — a pass where the floor expects red, a
// false where the floor expects pass, a non-Boolean return, or any reached verdict on a
// route-gap identity (the hermetic native route reaching what the hermetic floor route could not
// is a discrepancy between two routes that share an effect policy, and it reds) — and every
// disagreement is a DIVERGENCE, never an exclusion. A REFUSAL is a capability limit, not a
// verdict: it agrees only where the reference is the route gap and the refusal is the hermetic
// boundary itself (Eval stage, effect-boundary reason); every other refusal is an EXCLUSION,
// typed and counted by its classified cause.
type NativeRouteDivergenceCause
  = NativePassedExpectedRed
  | NativeFalseExpectedPass
  | NativeReturnedOtherVerdict
  | NativeReachedRouteGap

type NativeRouteDisposition
  = NativeAgreementPass
  | NativeAgreementExpectedRed
  | NativeAgreementRouteGap
  | NativeExclusion { cause: NativeRouteExclusionCause }
  | NativeDivergence { cause: NativeRouteDivergenceCause }

fn native_route_disposition(
  verdict: NativeTestVerdict,
  reference: NativeRouteReference
) -> NativeRouteDisposition {
  match verdict {
    NativeTestPassed =>
      match reference {
        FloorExpectedPass => NativeAgreementPass
        FloorExpectedRed => NativeDivergence { cause: NativePassedExpectedRed }
        FloorRouteGapRefusal => NativeDivergence { cause: NativeReachedRouteGap }
      }
    NativeTestReturnedFalse =>
      match reference {
        FloorExpectedPass => NativeDivergence { cause: NativeFalseExpectedPass }
        FloorExpectedRed => NativeAgreementExpectedRed
        FloorRouteGapRefusal => NativeDivergence { cause: NativeReachedRouteGap }
      }
    NativeTestReturnedOther => NativeDivergence { cause: NativeReturnedOtherVerdict }
    NativeTestRefused { stage: stage, reason: reason } =>
      match reference {
        FloorRouteGapRefusal =>
          match stage {
            NativeTestStageEval =>
              if native_route_reason_member(reason: reason, roster: native_route_effect_boundary_reasons) {
                NativeAgreementRouteGap
              } else {
                NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
              }
            NativeTestStageContext => NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
            NativeTestStagePrepare => NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
            NativeTestStageEntry => NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
          }
        FloorExpectedPass => NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
        FloorExpectedRed => NativeExclusion { cause: classify_native_refusal(stage: stage, reason: reason) }
      }
  }
}

// THE COUNTED PARTITION the contract names ("every excluded member typed and counted"), extended
// with the agreement and divergence counts the pairing requires. The census is DERIVED from the
// rows, never accumulated beside them — a counter that disagrees with the population it
// summarizes has no constructor here. The rosters are folded in once (the caller derives them
// once) so the per-member reference question is a membership ask, not a re-derivation.
type NativeRouteCensus {
  agreement_pass: Int
  agreement_expected_red: Int
  agreement_route_gap: Int
  excluded_compiler_frontier: Int
  excluded_entry_limit: Int
  excluded_eval_boundary: Int
  excluded_unattributed: Int
  divergences: Int
}

fn native_route_census(
  rows: List<NativeRouteMemberRow>,
  expected_red: List<String>,
  route_gap: List<String>
) -> NativeRouteCensus {
  fold_list(
    xs: rows,
    empty: NativeRouteCensus {
      agreement_pass: 0,
      agreement_expected_red: 0,
      agreement_route_gap: 0,
      excluded_compiler_frontier: 0,
      excluded_entry_limit: 0,
      excluded_eval_boundary: 0,
      excluded_unattributed: 0,
      divergences: 0
    },
    cons: fn(acc, row) {
      let reference = native_route_reference_for(
        qualified: native_route_identity_qualified(identity: row.identity),
        expected_red: expected_red,
        route_gap: route_gap
      )
      match native_route_disposition(verdict: row.verdict, reference: reference) {
        NativeAgreementPass => NativeRouteCensus {
          agreement_pass: acc.agreement_pass + 1,
          agreement_expected_red: acc.agreement_expected_red,
          agreement_route_gap: acc.agreement_route_gap,
          excluded_compiler_frontier: acc.excluded_compiler_frontier,
          excluded_entry_limit: acc.excluded_entry_limit,
          excluded_eval_boundary: acc.excluded_eval_boundary,
          excluded_unattributed: acc.excluded_unattributed,
          divergences: acc.divergences
        }
        NativeAgreementExpectedRed => NativeRouteCensus {
          agreement_pass: acc.agreement_pass,
          agreement_expected_red: acc.agreement_expected_red + 1,
          agreement_route_gap: acc.agreement_route_gap,
          excluded_compiler_frontier: acc.excluded_compiler_frontier,
          excluded_entry_limit: acc.excluded_entry_limit,
          excluded_eval_boundary: acc.excluded_eval_boundary,
          excluded_unattributed: acc.excluded_unattributed,
          divergences: acc.divergences
        }
        NativeAgreementRouteGap => NativeRouteCensus {
          agreement_pass: acc.agreement_pass,
          agreement_expected_red: acc.agreement_expected_red,
          agreement_route_gap: acc.agreement_route_gap + 1,
          excluded_compiler_frontier: acc.excluded_compiler_frontier,
          excluded_entry_limit: acc.excluded_entry_limit,
          excluded_eval_boundary: acc.excluded_eval_boundary,
          excluded_unattributed: acc.excluded_unattributed,
          divergences: acc.divergences
        }
        NativeExclusion { cause: cause } =>
          match cause {
            CompilerFrontierAttributed { reason: _ } => NativeRouteCensus {
              agreement_pass: acc.agreement_pass,
              agreement_expected_red: acc.agreement_expected_red,
              agreement_route_gap: acc.agreement_route_gap,
              excluded_compiler_frontier: acc.excluded_compiler_frontier + 1,
              excluded_entry_limit: acc.excluded_entry_limit,
              excluded_eval_boundary: acc.excluded_eval_boundary,
              excluded_unattributed: acc.excluded_unattributed,
              divergences: acc.divergences
            }
            NativeEntryResolutionLimit { reason: _ } => NativeRouteCensus {
              agreement_pass: acc.agreement_pass,
              agreement_expected_red: acc.agreement_expected_red,
              agreement_route_gap: acc.agreement_route_gap,
              excluded_compiler_frontier: acc.excluded_compiler_frontier,
              excluded_entry_limit: acc.excluded_entry_limit + 1,
              excluded_eval_boundary: acc.excluded_eval_boundary,
              excluded_unattributed: acc.excluded_unattributed,
              divergences: acc.divergences
            }
            NativeEvalBoundary { reason: _ } => NativeRouteCensus {
              agreement_pass: acc.agreement_pass,
              agreement_expected_red: acc.agreement_expected_red,
              agreement_route_gap: acc.agreement_route_gap,
              excluded_compiler_frontier: acc.excluded_compiler_frontier,
              excluded_entry_limit: acc.excluded_entry_limit,
              excluded_eval_boundary: acc.excluded_eval_boundary + 1,
              excluded_unattributed: acc.excluded_unattributed,
              divergences: acc.divergences
            }
            UnattributedRefusal { reason: _ } => NativeRouteCensus {
              agreement_pass: acc.agreement_pass,
              agreement_expected_red: acc.agreement_expected_red,
              agreement_route_gap: acc.agreement_route_gap,
              excluded_compiler_frontier: acc.excluded_compiler_frontier,
              excluded_entry_limit: acc.excluded_entry_limit,
              excluded_eval_boundary: acc.excluded_eval_boundary,
              excluded_unattributed: acc.excluded_unattributed + 1,
              divergences: acc.divergences
            }
          }
        NativeDivergence { cause: _ } => NativeRouteCensus {
          agreement_pass: acc.agreement_pass,
          agreement_expected_red: acc.agreement_expected_red,
          agreement_route_gap: acc.agreement_route_gap,
          excluded_compiler_frontier: acc.excluded_compiler_frontier,
          excluded_entry_limit: acc.excluded_entry_limit,
          excluded_eval_boundary: acc.excluded_eval_boundary,
          excluded_unattributed: acc.excluded_unattributed,
          divergences: acc.divergences + 1
        }
      }
    }
  )
}

// THE CONTROLS ARE OBSERVATIONS, NOT CONSTRUCTORS. Each control records what the emitted binary
// was OBSERVED to do; admission pattern-matches the observation, so a harness that cannot
// produce the observation cannot green the clause.
//
// THE FALSE AND TRUE CONTROLS PROVE THE VERDICT PATH IS LIVE. The lane's admission refuses
// unless the emitted binary observed the false control RETURN FALSE (a route that reports it
// Passed — or refuses it, or loses it — has a dead or diverted verdict arm, and every pass in
// the population is then worthless) and the true control RETURN TRUE (a route that falsifies or
// refuses everything cannot green either). Both controls live in v2.native_lane_fixture.control
// — outside the universe prefix, plain `fn` so floor discovery enrolls no rows for them — and
// the host names them to the binary explicitly, beside the derived universe. Absent is
// representable so a missing observation refuses by name rather than pattern-matching to a
// default.
//
// THE MALFORMED CONTROL PROVES THE FRONT-END REFUSAL ARM IS LIVE. The host materializes the
// committed poison specimen as a `.dag` under the lane's scratch root — the committed carrier
// is not a `.dag` file, because the changed-witness observation parses every changed `.dag`
// path in a diff and the deliberate tokenize failure would refuse it — and runs the same
// binary over that scratch root as the run's only source root. The run's single consumed
// output is the poison path's refusal, so rooting it at the full corpus would pay a second
// whole-corpus context fold for one observation. An honest front-end collects a per-file refusal
// for it (the collecting fold refuses the FILE, never the whole context), and the receipt records
// the refusal it observed. MalformedSpecimenAccepted — no refusal row for the poison path — means
// the route "accepted" poisoned source and every refusal verdict in its census is worthless.
type NativeRouteMalformedControl
  = MalformedSpecimenRefused { path: String, reason: Symbol }
  | MalformedSpecimenAccepted

// THE NO-FALLBACK CONTROL IS A RECEIVED FACT, NOT AN ASSUMPTION. After the emitted compiler
// exists, the old compiler/interpreter route is made unavailable — or an executing falsifier is
// armed that fails if the old route is touched — and the receipt records WHICH control held and
// the identity of what was withdrawn or armed. OldRouteControlAbsent is representable so
// admission can refuse it by name: a receipt that cannot say how fallback was closed has not
// closed it. The empty-string arm is refused alongside the absent arm: a control whose identity
// names nothing is not an observation.
type NativeRouteOldRouteControl
  = OldRouteWithdrawn { withdrawn_executable: String }
  | OldRouteFalsifierArmed { falsifier_identity: String }
  | OldRouteControlAbsent

// THE TERMINAL OBSERVATION. Every identity the contract names is a field: the tested tree; the
// seed used ONLY to prepare the emitted compiler (recorded honestly — this job does not claim
// native bootstrap); the emitted closure's identity; the executed binary's path AND content
// identity (route identity is observed, never synthesized from the intended command); the
// DERIVED universe; the module → source-path relation over the universe's modules (the context
// reclassification's join key, carried so admission can re-ask the join, not trust it); the
// OBSERVED population; the per-file front-end refusals the collecting fold gathered; and every
// control.
type NativeRouteReceipt {
  job: String
  tested_tree: String
  preparation_seed_identity: String
  emitted_closure_identity: String
  executable_path: String
  executable_identity: String
  universe: List<NativeRouteTestIdentity>
  module_source_index: List<NativeRouteModuleSource>
  population: List<NativeRouteMemberRow>
  file_refusals: List<NativeTestFileRefusal>
  false_control: Optional<NativeTestVerdict>
  true_control: Optional<NativeTestVerdict>
  malformed_control: NativeRouteMalformedControl
  old_route_control: NativeRouteOldRouteControl
}

// ADMISSION IS THE CONTRACT, ONE AUTHORITY, ONE CLAUSE PER PREDICATE. The job greens only when
// all hold: the receipt is well-formed (right job, every identity recorded); the universe is
// derived and well-formed (non-empty, duplicate-free, prefix-closed); the observed population
// JOINS the universe exactly (no duplicates, no foreign rows, no omissions — "no silent
// remainder" as an executing check, not a comment); the positive population is non-empty (an
// all-refused census proves the route refused, not that it routed); every identity on the
// required-native ratchet roster is observed passing natively again (a regression of an already
// admitted native pass blocks, however its refusal would classify); no divergence is observed;
// every exclusion is classified; every file refusal is owned at both grains; every Context-stage
// refusal is backed by its own module's observed file refusal; and all four controls hold. The fold collects
// EVERY violated clause rather than stopping at the first, so one red run names everything that
// must change before the next run.
type NativeRouteAdmissionRefusalCause
  = JobNameMismatch
  | TestedTreeUnrecorded
  | PreparationSeedUnrecorded
  | EmittedClosureUnrecorded
  | RouteIdentityUnrecorded
  | UniverseUnderived
  | UniverseDuplicatesPresent
  | UniversePrefixViolationsPresent
  | PopulationDuplicatesPresent
  | PopulationForeignRowsPresent
  | PopulationOmissionsPresent
  | PositivePopulationEmpty
  | RequiredNativePassRegressed
  | DivergencesPresent
  | UnattributedExclusionsPresent
  | UnattributedFileRefusalsPresent
  | UnattributedHeadAdvisoriesPresent
  | ContextRefusalsUnbacked
  | FalseControlNotObserved
  | TrueControlNotObserved
  | MalformedControlAcceptedByRoute
  | OldRouteControlNeverInstalled

type NativeRouteAdmission
  = NativeRouteAdmitted
  | NativeRouteRefused { causes: List<NativeRouteAdmissionRefusalCause> }

// ONE CLAUSE, ONE PREDICATE, ONE ROW. The check record couples a clause's verdict to the cause
// its failure appends, so the admission fold is one pass and the cause list can never drift from
// the predicate list.
type NativeRouteClauseCheck {
  holds: Bool
  cause: NativeRouteAdmissionRefusalCause
}

fn native_route_job_name_matches(receipt: NativeRouteReceipt) -> Bool {
  receipt.job == required_v2_native_job_name
}

fn native_route_tested_tree_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.tested_tree != ""
}

// The seed and the closure are DIFFERENT observations and refuse by DIFFERENT names: folding
// them into one predicate made EmittedClosureUnrecorded unreachable (a receipt with a recorded
// seed and an unrecorded closure reported preparation_seed_unrecorded), which is the
// grain-mismatch class DESIGN 4b(3) names. One predicate per observation.
fn native_route_preparation_seed_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.preparation_seed_identity != ""
}

fn native_route_emitted_closure_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.emitted_closure_identity != ""
}

fn native_route_identity_recorded(receipt: NativeRouteReceipt) -> Bool {
  receipt.executable_path != "" && receipt.executable_identity != ""
}

fn native_route_universe_derived(receipt: NativeRouteReceipt) -> Bool {
  !is_empty(xs: receipt.universe)
}

fn native_route_universe_unique(receipt: NativeRouteReceipt) -> Bool {
  native_route_identities_unique(xs: receipt.universe)
}

fn native_route_universe_prefix_closed(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.universe, predicate: fn(i) {
    !native_route_universe_member(module_qn: i.module)
  })
}

// The population's identity projection: the uniqueness and coverage questions range over
// identities, not rows, so the projection is named once beside the join that asks it.
fn native_route_row_identities(rows: List<NativeRouteMemberRow>) -> List<NativeRouteTestIdentity> {
  fold_list(xs: rows, empty: [], cons: fn(acc, row) { list_snoc_item(xs: acc, item: row.identity) })
}

fn native_route_population_unique(receipt: NativeRouteReceipt) -> Bool {
  native_route_identities_unique(
    xs: native_route_row_identities(rows: receipt.population)
  )
}

// THE EXACT JOIN, BOTH DIRECTIONS. "No silent remainder" is two questions: every universe member
// carries exactly one observed row (no omissions), and every observed row names a universe
// member (no foreign rows — a cherry-picked or padded population refuses here). With uniqueness
// on both sides, the two directions together are set equality at identity grain.
fn native_route_population_covers_universe(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.universe, predicate: fn(member) {
    !any(xs: receipt.population, predicate: fn(row) {
      native_route_identity_eq(a: row.identity, b: member)
    })
  })
}

fn native_route_population_no_foreign(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.population, predicate: fn(row) {
    !native_route_identity_member(target: row.identity, xs: receipt.universe)
  })
}

fn native_route_positive_population_present(census: NativeRouteCensus) -> Bool {
  census.agreement_pass > 0
}

// THE REQUIRED-NATIVE RATCHET. The positive-population clause alone is an existential canary:
// a test that passes natively today could regress tomorrow to an already-known compiler refusal
// and disappear into the attributed-exclusion population while the lane stays green — coverage
// could collapse from hundreds of identities to one. This roster is the convergence ratchet
// that forbids the collapse: every identity ADMITTED as a native agreement-pass is enrolled
// here, and every subsequent head must observe it passing natively again. The frontier census
// still types every not-yet-native test as an exclusion; the distinction the roster draws is
//   not yet admitted natively → typed exclusion allowed
//   already admitted natively → a refusal is a regression and blocks
// Membership changes are explicit authority edits — a removal or redisposition is a reviewed
// row change beside its reason, never a silent shrink. A count floor would not do: one identity
// can replace another while capability is lost, so the join is at identity grain.
data native_route_required_pass_identities: List<NativeRouteTestIdentity> = [
  NativeRouteTestIdentity {
    module: "v2.test.native_lane_smoke",
    declaration: "native_route_positive_population_smoke"
  }
]

// One clause, asked of the observed population with the floor's rosters already derived: every
// rostered identity must be present with disposition NativeAgreementPass. The disposition fold
// is reused whole rather than re-asked as a raw verdict match, so a rostered identity whose
// reference expectation ever changes is judged by the same pairing every other member gets.
fn native_route_required_passes_hold(
  rows: List<NativeRouteMemberRow>,
  expected_red: List<String>,
  route_gap: List<String>
) -> Bool {
  !any(xs: native_route_required_pass_identities, predicate: fn(required) {
    !any(xs: rows, predicate: fn(row) {
      native_route_identity_eq(a: row.identity, b: required)
      && match native_route_disposition(
        verdict: row.verdict,
        reference: native_route_reference_for(
          qualified: native_route_identity_qualified(identity: row.identity),
          expected_red: expected_red,
          route_gap: route_gap
        )
      ) {
        NativeAgreementPass => true
        NativeAgreementExpectedRed => false
        NativeAgreementRouteGap => false
        NativeExclusion { cause: _ } => false
        NativeDivergence { cause: _ } => false
      }
    })
  })
}

fn native_route_no_divergences(census: NativeRouteCensus) -> Bool {
  census.divergences == 0
}

fn native_route_exclusions_all_classified(census: NativeRouteCensus) -> Bool {
  census.excluded_unattributed == 0
}

// EVERY FILE REFUSAL IS OWNED AT FATAL GRAIN: the fatal reason is the cause that refused the
// file, so its ownership row is the FatalGrain one. An unowned fatal cause is a new front-end
// frontier fact surfacing where nobody counted it, and it blocks admission by its own name.
fn native_route_file_refusals_attributed(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.file_refusals, predicate: fn(fr) {
    match cause_ownership_lookup(cause: fr.fatal_reason, grain: FatalGrain) {
      Present { value: _ } => false
      Absent => true
    }
  })
}

// THE HEAD REASON IS NOT DEAD RECEIPT DATA. rejected_with_pending prepends the non-fatal
// advisory, so the head reason is a real observation of the frontier at a different grain — the
// same observation the door ledger's own rows carry. Every file refusal's head reason must be
// owned at HEAD grain: an unowned advisory is a new frontier cause surfacing where nobody
// counted it, and it blocks admission by its own name rather than riding along unclassified.
fn native_route_head_advisories_attributed(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.file_refusals, predicate: fn(fr) {
    match cause_ownership_lookup(cause: fr.head_reason, grain: HeadGrain) {
      Present { value: _ } => false
      Absent => true
    }
  })
}

// A CONTEXT-STAGE REFUSAL IS A DERIVED CLASSIFICATION, AND DERIVED CLASSIFICATIONS ARE FORGEABLE
// UNTIL BOUND TO THEIR OBSERVATION — AT SUBJECT GRAIN. The host reclassifies a member whose
// entry file never loaded as Context-stage with the file's fatal reason; the receipt therefore
// carries the module → source-path relation beside the file-refusal population, and every
// Context-stage row must join BOTH: its module's own source path (through module_source_index)
// AND an observed file refusal at exactly that path carrying exactly that fatal reason. A join
// on the reason alone is forgeable by any unrelated file sharing a common parser reason; a join
// on the module alone says nothing about which refusal backs it. The triple is the observation.
fn native_route_context_refusals_backed(receipt: NativeRouteReceipt) -> Bool {
  !any(xs: receipt.population, predicate: fn(row) {
    match row.verdict {
      NativeTestRefused { stage: stage, reason: reason } =>
        match stage {
          NativeTestStageContext =>
            !any(xs: receipt.module_source_index, predicate: fn(ms) {
              ms.module == row.identity.module
              && any(xs: receipt.file_refusals, predicate: fn(fr) {
                fr.path == ms.path && fr.fatal_reason == reason
              })
            })
          NativeTestStagePrepare => false
          NativeTestStageEntry => false
          NativeTestStageEval => false
        }
      NativeTestPassed => false
      NativeTestReturnedFalse => false
      NativeTestReturnedOther => false
    }
  })
}

// THE LIVE-VERDICT CONTROLS ARE NAMED BY THE AUTHORITY, NOT BY THE HARNESS. The pair sits
// OUTSIDE the universe prefix on purpose — discovery enrols no row for it, so nothing but this
// declaration can put it in front of the route — and the clauses below judge the verdicts it
// produced. While the seed derived the universe, these two names lived as Rust constants beside
// the derivation; the derivation is now the emitted binary's own fold, and a control the route
// must execute is a fact of the lane's contract, so it is declared beside the clause that reads
// it. A control whose declaration is renamed and not re-declared here stops being observed, and
// the false/true clauses refuse an Absent verdict by name.
data native_route_live_control_module: String = "v2.native_lane_fixture.control"

data native_route_live_control_false_declaration: String = "native_lane_false_control"

data native_route_live_control_true_declaration: String = "native_lane_true_control"

fn native_route_false_control_holds(receipt: NativeRouteReceipt) -> Bool {
  match receipt.false_control {
    Present { value: v } =>
      match v {
        NativeTestReturnedFalse => true
        NativeTestPassed => false
        NativeTestReturnedOther => false
        NativeTestRefused { stage: _, reason: _ } => false
      }
    Absent => false
  }
}

fn native_route_true_control_holds(receipt: NativeRouteReceipt) -> Bool {
  match receipt.true_control {
    Present { value: v } =>
      match v {
        NativeTestPassed => true
        NativeTestReturnedFalse => false
        NativeTestReturnedOther => false
        NativeTestRefused { stage: _, reason: _ } => false
      }
    Absent => false
  }
}

fn native_route_malformed_control_holds(receipt: NativeRouteReceipt) -> Bool {
  match receipt.malformed_control {
    MalformedSpecimenRefused { path: path, reason: _ } => path != ""
    MalformedSpecimenAccepted => false
  }
}

fn native_route_old_route_closed(receipt: NativeRouteReceipt) -> Bool {
  match receipt.old_route_control {
    OldRouteWithdrawn { withdrawn_executable: p } => p != ""
    OldRouteFalsifierArmed { falsifier_identity: f } => f != ""
    OldRouteControlAbsent => false
  }
}

fn native_route_admission(receipt: NativeRouteReceipt) -> NativeRouteAdmission {
  let expected_red = floor_expected_red_roster()
  let route_gap = floor_route_gap_roster()
  let census = native_route_census(
    rows: receipt.population,
    expected_red: expected_red,
    route_gap: route_gap
  )
  let checks: List<NativeRouteClauseCheck> = [
    NativeRouteClauseCheck { holds: native_route_job_name_matches(receipt: receipt), cause: JobNameMismatch },
    NativeRouteClauseCheck { holds: native_route_tested_tree_recorded(receipt: receipt), cause: TestedTreeUnrecorded },
    NativeRouteClauseCheck { holds: native_route_preparation_seed_recorded(receipt: receipt), cause: PreparationSeedUnrecorded },
    NativeRouteClauseCheck { holds: native_route_emitted_closure_recorded(receipt: receipt), cause: EmittedClosureUnrecorded },
    NativeRouteClauseCheck { holds: native_route_identity_recorded(receipt: receipt), cause: RouteIdentityUnrecorded },
    NativeRouteClauseCheck { holds: native_route_universe_derived(receipt: receipt), cause: UniverseUnderived },
    NativeRouteClauseCheck { holds: native_route_universe_unique(receipt: receipt), cause: UniverseDuplicatesPresent },
    NativeRouteClauseCheck { holds: native_route_universe_prefix_closed(receipt: receipt), cause: UniversePrefixViolationsPresent },
    NativeRouteClauseCheck { holds: native_route_population_unique(receipt: receipt), cause: PopulationDuplicatesPresent },
    NativeRouteClauseCheck { holds: native_route_population_no_foreign(receipt: receipt), cause: PopulationForeignRowsPresent },
    NativeRouteClauseCheck { holds: native_route_population_covers_universe(receipt: receipt), cause: PopulationOmissionsPresent },
    NativeRouteClauseCheck { holds: native_route_positive_population_present(census: census), cause: PositivePopulationEmpty },
    NativeRouteClauseCheck { holds: native_route_required_passes_hold(rows: receipt.population, expected_red: expected_red, route_gap: route_gap), cause: RequiredNativePassRegressed },
    NativeRouteClauseCheck { holds: native_route_no_divergences(census: census), cause: DivergencesPresent },
    NativeRouteClauseCheck { holds: native_route_exclusions_all_classified(census: census), cause: UnattributedExclusionsPresent },
    NativeRouteClauseCheck { holds: native_route_file_refusals_attributed(receipt: receipt), cause: UnattributedFileRefusalsPresent },
    NativeRouteClauseCheck { holds: native_route_head_advisories_attributed(receipt: receipt), cause: UnattributedHeadAdvisoriesPresent },
    NativeRouteClauseCheck { holds: native_route_context_refusals_backed(receipt: receipt), cause: ContextRefusalsUnbacked },
    NativeRouteClauseCheck { holds: native_route_false_control_holds(receipt: receipt), cause: FalseControlNotObserved },
    NativeRouteClauseCheck { holds: native_route_true_control_holds(receipt: receipt), cause: TrueControlNotObserved },
    NativeRouteClauseCheck { holds: native_route_malformed_control_holds(receipt: receipt), cause: MalformedControlAcceptedByRoute },
    NativeRouteClauseCheck { holds: native_route_old_route_closed(receipt: receipt), cause: OldRouteControlNeverInstalled }
  ]
  let causes = fold_list(
    xs: checks,
    empty: [],
    cons: fn(acc, check) {
      if check.holds { acc } else { concat(acc, [check.cause]) }
    }
  )
  if is_empty(xs: causes) { NativeRouteAdmitted } else { NativeRouteRefused { causes: causes } }
}

// The job's terminal print renders causes by name; the projection lives beside the coproduct,
// so a new cause refuses to compile until it is named (exhaustive match). The membership probe
// is how a witness — and the job's own report — asks for one clause's verdict without
// re-matching the whole coproduct.
fn native_route_admission_refusal_cause_name(cause: NativeRouteAdmissionRefusalCause) -> String {
  match cause {
    JobNameMismatch => "job_name_mismatch"
    TestedTreeUnrecorded => "tested_tree_unrecorded"
    PreparationSeedUnrecorded => "preparation_seed_unrecorded"
    EmittedClosureUnrecorded => "emitted_closure_unrecorded"
    RouteIdentityUnrecorded => "route_identity_unrecorded"
    UniverseUnderived => "universe_underived"
    UniverseDuplicatesPresent => "universe_duplicates_present"
    UniversePrefixViolationsPresent => "universe_prefix_violations_present"
    PopulationDuplicatesPresent => "population_duplicates_present"
    PopulationForeignRowsPresent => "population_foreign_rows_present"
    PopulationOmissionsPresent => "population_omissions_present"
    PositivePopulationEmpty => "positive_population_empty"
    RequiredNativePassRegressed => "required_native_pass_regressed"
    DivergencesPresent => "divergences_present"
    UnattributedExclusionsPresent => "unattributed_exclusions_present"
    UnattributedFileRefusalsPresent => "unattributed_file_refusals_present"
    UnattributedHeadAdvisoriesPresent => "unattributed_head_advisories_present"
    ContextRefusalsUnbacked => "context_refusals_unbacked"
    FalseControlNotObserved => "false_control_not_observed"
    TrueControlNotObserved => "true_control_not_observed"
    MalformedControlAcceptedByRoute => "malformed_control_accepted_by_route"
    OldRouteControlNeverInstalled => "old_route_control_never_installed"
  }
}

fn native_route_admitted(admission: NativeRouteAdmission) -> Bool {
  match admission {
    NativeRouteAdmitted => true
    NativeRouteRefused { causes: _ } => false
  }
}

fn native_route_admission_refused_with(
  admission: NativeRouteAdmission,
  cause_name: String
) -> Bool {
  match admission {
    NativeRouteAdmitted => false
    NativeRouteRefused { causes: causes } =>
      any(xs: causes, predicate: fn(c) {
        native_route_admission_refusal_cause_name(cause: c) == cause_name
      })
  }
}

// The terminal print of one run: every violated clause, one line's worth. Derived from the
// causes, never accumulated beside them.
fn native_route_admission_summary(admission: NativeRouteAdmission) -> String {
  match admission {
    NativeRouteAdmitted => "admitted"
    NativeRouteRefused { causes: causes } => concat(
      "refused: ",
      fold_list(
        xs: causes,
        empty: "",
        cons: fn(acc, c) {
          let name = native_route_admission_refusal_cause_name(cause: c)
          if acc == "" { name } else { concat(acc, ", ", name) }
        }
      )
    )
  }
}
