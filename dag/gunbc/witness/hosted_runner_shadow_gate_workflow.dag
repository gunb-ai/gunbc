// THE HOSTED-RUNNER SHADOW GATE: a NON-required GitHub Actions job on a standard GitHub-hosted
// runner that joins the tailnet and drives the gunbc remote build for every required-gate row.
// This implements the operator ruling of 2026-11-19 (@ref
// gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign). It
// DISSOLVES at cutover: the job roster is closed to growth and this entry was admitted by the
// ruling; when the fleet itself runs the remote build natively, this workflow is removed.
//
// WHY A SEPARATE WORKFLOW FILE rather than a second job in witnesses.yml:
//   1. It needs repository secrets (tailscale OAuth, CI SSH key) the required gate does not.
//   2. It is same-repo only (forks get no secrets), so it needs its own conditional guard.
//   3. It is ephemeral by ruling; removing it at cutover should not touch the required workflow.
//   4. The drift watch covers it independently: each generated artifact has its own producer.
//
// THE NETWORK PATH: the hosted runner joins the tailnet as tag:ci-dispatch (the operator ruling of
// 2026-11-19: "OK for ci-dispatch, as long as its all modeled/recorded for tailscale convergence").
// The emitted ACL grant (extdeps.tailscale.acl tag_ci_dispatch_to_build_hosts_ssh_grant) gives
// tag:ci-dispatch tcp:22 to tag:ci (the fleet hosts' tag). Only the gunbc-build forced-command
// account admits the CI key, so the blast radius is the remote-build gate operation and nothing
// else on the host. Even if a host ran Tailscale SSH, no ssh rule names tag:ci-dispatch.
//
// THE CONFIG-CHECK ARMS (manager ruling 2026-11-19, re-armed for WIF by review 97115): the job
// branches on the EVENT, not on secret presence -- the credentials federate or the fetch step goes
// red. Only a dispatch at the default branch runs remote legs; a dispatch elsewhere is a verdict
// request that cannot federate and goes red; pull_request/merge_group report the typed skip and
// cite the concern row. Red control: when the federation works and the remote gate fails, the
// gate step's exit code propagates and the job goes red.
//
// THE HAND-SHELL GATE (ctrl review policy): the run: fields build shell as strings. This is a
// scaffold; the dissolution trigger below names the capability that would replace it — the
// orchestration-to-shell bash-emit capability v2.workflow.bash_emit / bash_emit_stmts, tracked as
// #5828 (the same trigger the precedent carriers name:
// gunbc.test.claim.runner.runner_host_medium_fleet_keys_witness
// the_boot_command_carries_its_dissolution_trigger_naming_bash_emit). The carrier-level marker
// dissolves when that capability lands.
//
// THE DISSOLUTION: this entire workflow dissolves at remote-build cutover. The carrier-level
// DissolutionCondition below records it.
//
// THE GATE OPERATION: per emitted_subject_build_rows row, the job invokes the remote-build client's
// gate operation (gunbc.compute.remote_build_client remote_gate_cli). Until that CLI lands (work
// item adhoc-7d2186ce-2c3, sibling keen-swift-260), the plumbing is proved with remote_test_cli on
// a known pattern. When remote_gate_cli lands, the steps below switch to it with the same shape.
//
// CI EVALUATES NO WITNESSES: the job dispatches work to a remote host via SSH; the witnesses are
// evaluated on the fleet host, not on the GitHub runner.

// ── THE WORKFLOW IDENTITY ────────────────────────────────────────────────────────────────────────

data shadow_gate_workflow_name: String = "hosted-runner-shadow-gate"
// CARRIER-LEVEL DISSOLUTION MARKER (HAND-SHELL GATE policy + the operator ruling @ref
// gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign):
// this workflow is a scaffold. It dissolves at remote-build cutover, when the fleet runs the
// remote build natively and the v2-bootstrap required context's witnesses.yml drops.
data shadow_gate_dissolution: DissolutionCondition = unbound_dissolution(description: "dissolve-on: remote-build cutover -- the fleet runs the remote build natively; this shadow gate and its hosted runner are no longer needed. The v2-bootstrap required context dissolves (same ruling, 2026-11-19); this job dissolves with it. The hand-assembled run: strings in this workflow are scaffold pending the orchestration-to-shell capability v2.workflow.bash_emit / bash_emit_stmts, tracked as #5828; when that lands they are authored as modeled Nodes and this marker retires with them.")

data shadow_gate_job_id: String = "remote-build-shadow"
data shadow_gate_timeout_minutes: Int = 30

// ── THE TRIGGERS ─────────────────────────────────────────────────────────────────────────────────
//
// pull_request (same-repo only, since forks receive no secrets), merge_group, and
// WORKFLOW_DISPATCH. The dispatch arm exists for the evidence loop the operator ruling demands:
// re-running the shadow gate on demand to capture the remote receipt and wall time, and to
// demonstrate the RED CONTROL (dispatch with a pattern the remote host fails). It dissolves with
// the rest of the carrier at cutover. The single optional input defaults, in the step itself, to
// the modelled plumbing-proof pattern, so an empty dispatch always runs the model's pattern.

// The dispatch input, read SAFELY: GitHub expands ${{ inputs.pattern }} in the step's env: block
// (the env context assignment is the documented injection mitigation — the value never enters the
// script text, so metacharacters in it cannot be executed). The script reads it quoted, with the
// shell defaulting to the modelled pattern when empty.
data shadow_gate_pattern_env: String = "GUNBC_GATE_PATTERN"

data shadow_gate_pattern_input_expression: String = "${{ inputs.pattern }}"

// THE EVIDENCE RE-RUN INPUT (see trigger comment). Optional; empty means the step runs the model's
// plumbing-proof pattern (defaulted in the step via $GUNBC_GATE_PATTERN :-).
data shadow_gate_pattern_dispatch_input: DispatchInput = DispatchInput {
  name: "pattern",
  description: Present { value: "evidence re-runs only: remote gate pattern override (e.g. a pattern the remote host fails, for the red control). Empty defaults to the modelled plumbing-proof pattern." },
  required: false,
  default: none,
  type: InputString,
}

fn shadow_gate_pull_request_activity_types() -> List<PullRequestActivity> {
  [Opened, Synchronize, Reopened]
}

fn shadow_gate_triggers() -> List<WorkflowTrigger> {
  [
    PullRequest {
      branches: [gunbc_default_branch_name],
      types: shadow_gate_pull_request_activity_types(),
      paths: []
    },
    MergeGroup,
    WorkflowDispatch { inputs: [shadow_gate_pattern_dispatch_input] },
  ]
}

// THE SAME-REPO GUARD. A fork PR has no access to repository secrets, so the tailscale step and the
// SSH-key step would fail with an unhelpful secret-not-found error. This if_condition skips the job
// entirely on fork PRs with a clear job name in the Actions UI, rather than failing on a missing
// secret. merge_group and workflow_dispatch run in the repository context (secrets available), so
// they pass the guard.
data shadow_gate_fork_guard: String = "github.event_name == 'merge_group' || github.event_name == 'workflow_dispatch' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)"

// ── THE SECRETS ──────────────────────────────────────────────────────────────────────────────────
//
// THE CREDENTIALS ARE NOT GITHUB SECRETS (operator decision, 2026-11-20, relayed by clever-raven-401
// and gentle-crab-832): the SSH private half (#gunbc.compute.remote_build::remote_build_ci_ssh_privkey_secret)
// and the Tailscale OAuth client secret (#gunbc.tailscale_ci_oauth_client::tailscale_oauth_client_secret_ref)
// live in GCP Secret Manager and the runner reads them over workload identity federation as a dedicated
// low-privilege service account (#gunbc.auth.hosted_ci_secrets_federation::hosted_ci_secrets_federation).
// The federation is PINNED by OIDC claim -- this repository id, this owner id, THIS workflow file at
// refs/heads/main, event workflow_dispatch, ref refs/heads/main -- so only dispatches of the reviewed
// main copy of this workflow can ever mint the token. That pin is why the remote legs run on
// dispatch-at-main ONLY: pull_request and merge_group runs cannot federate, and the config job says so
// with a typed notice instead of pretending to shadow. The gap that leaves against the operator's goal
// (hosted PR jobs driving remote builds) is recorded as an open capability concern at
// #gunbc.integration_concern.shadow_gate_pr_time_remote_build_capability_gap::shadow_gate_pr_time_remote_build_capability_gap: a PR job must reach the
// remote build without PR-authored code ever holding the key, which needs the build host to verify a
// PR-scoped GitHub OIDC token and build that commit isolated -- not this pin relaxed.
// The OAuth client ID itself is PUBLIC (a model constant: #gunbc.tailscale_ci_oauth_client::ci_oauth_client_id);
// only the client SECRET and the SSH private half are fetched over WIF.

// Where the fetched SSH private half lives for the duration of the job: the runner's own temp
// directory, mode 0600, wiped on step exit. Every gate step names it explicitly through the
// client's identity_file parameter -- no HOME default.
data shadow_gate_ci_ssh_key_file: String = "$RUNNER_TEMP/remote-build-ci-ssh-key"

// The fetched Tailscale OAuth client SECRET reaches the tailscale action's step through this env
// name. $GITHUB_ENV alone does NOT mask: the fetch step registers the value with ::add-mask::
// first, and only then appends it, so every later log redacts it.
data shadow_gate_oauth_secret_env: String = "TS_OAUTH_SECRET"

// The config-check script no longer probes secrets -- the credentials are not GitHub secrets and
// cannot be listed from the job. What it checks is the EVENT ARM, and the arms are typed
// (gunbc.design_argument::fail_closed):
// - workflow_dispatch at refs/heads/main: configured=true. This is the ONLY arm the pinned WIF
//   provider federates, so it is the only arm with remote legs (the pin:
//   #gunbc.auth.hosted_ci_secrets_federation::hosted_ci_secrets_attribute_condition).
// - workflow_dispatch at any other ref: ::error:: + exit 1 (never green). A dispatch IS an
//   explicit verdict request, and one this arm cannot honour -- the pin refuses the credentials
//   for an unreviewed copy -- fails with a located diagnostic. Green-with-a-notice would be
//   green-by-default on the one event where someone asked for a verdict (review 97115).
// - pull_request / merge_group: typed notice + configured=false. The provider refuses these
//   events' claims; the remote legs are skipped and the event-concern that records the gap is
//   cited in the notice text.
fn shadow_gate_config_check_script() -> String {
  join([
    "if [ \"$GITHUB_EVENT_NAME\" = \"workflow_dispatch\" ] && [ \"$GITHUB_REF\" = \"refs/heads/",
    gunbc_default_branch_name,
    "\" ]; then\n  echo 'configured=true' >> $GITHUB_OUTPUT\nelif [ \"$GITHUB_EVENT_NAME\" = \"workflow_dispatch\" ]; then\n  echo '::error::not a dispatch at refs/heads/",
    gunbc_default_branch_name,
    ": the WIF provider is pinned to the reviewed main copy of this workflow (hosted_ci_secrets_attribute_condition), so this run cannot federate the credentials; a dispatched verdict request that cannot federate fails rather than passing green'\n  exit 1\nelse\n  echo 'configured=false' >> $GITHUB_OUTPUT\n  echo '::notice::remote legs run only on workflow_dispatch at refs/heads/",
    gunbc_default_branch_name,
    ": the pinned WIF provider refuses pull_request/merge_group claims, so the remote build is not shadowed on this event; see gunbc.integration_concern::shadow_gate_pr_time_remote_build_capability_gap'\nfi\n",
  ], "")
}

// ── THE TAILNET JOIN ─────────────────────────────────────────────────────────────────────────────
//
// The hosted runner joins as tag:ci-dispatch (operator ruling @ref
// gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign:
// "OK for ci-dispatch, as long as its all modeled/recorded for tailscale convergence").
// EPHEMERAL, so it self-expires from the tailnet when the runner exits; no operator or Terraform
// cleanup. Ephemerality is a property of the OAuth-MINTED AUTH KEY (the action mints it that way per
// gunbc.tailscale_ci_oauth_client ci_oauth_client_ephemeral), NOT a `tailscale up` flag -- there is
// none, and passing one aborts the join ('flag provided but not defined: -ephemeral', run
// 44948446694). The action's post step logs the node out.

data shadow_gate_tailscale_tags: String = join(ci_oauth_client_tags, ",")
// `tailscale up` args for the runner node: EMPTY. --accept-dns=false was wrong: the probe step
// needs MagicDNS to resolve the serving hosts' srv*.tailecbe08.ts.net names (run 44954152909 typed
// 'Could not resolve hostname srv3.tailecbe08.ts.net'), and MagicDNS forwards everything else
// upstream, so nothing off-tailnet breaks -- `tailscale up` accepts DNS by default anyway.
// Ephemerality is decided where the key is minted (ci_oauth_client_ephemeral), never in up args
// (`up` has no such flag; run 44948446694 typed-failed on the invented one).
data shadow_gate_tailscale_args: String = ""

// ── THE CONFIG-CHECK STEP ─────────────────────────────────────────────────────────────────────────
//
// Before anything that needs a secret runs, this step checks whether the required secrets
// are present. The arms are typed per event (fail-closed: every degradation is typed, located
// and countable — gunbc.design_argument::fail_closed):
// - pull_request with secrets absent: typed '::notice::' + configured=false, downstream steps
//   skip. This is the documented fork arm (forks get no secrets) and the pre-cutover case;
//   the job reports "not attempted", neither green-as-passed nor red.
// - merge_group or workflow_dispatch with secrets absent: '::error::' + exit 1. Both run in the
//   repository context where the secrets MUST be present, so their absence is a rotated/deleted-secret
//   incident and the shadow gate must not degrade into a permanent silent pass. The config job goes
//   red and the dependent shadow job never runs.
// - secrets present: configured=true; when the remote gate fails its exit code propagates
//   normally (the red control).

data shadow_gate_config_job_id: String = "shadow-gate-config"

fn shadow_gate_config_job() -> Job {
  Job {
    id: shadow_gate_config_job_id,
    name: Present { value: "Hosted-runner shadow gate: configuration" },
    runner: HostedRunner { label: Ubuntu2404 },
    environment: none,
    env: none,
    outputs: Present { value: [kv(key: "configured", value: yaml_string(s: "${{ steps.check.outputs.configured }}"))] },
    if_condition: Present { value: shadow_gate_fork_guard },
    needs: [],
    steps: [
      RunStep {
        name: Present { value: "Check secrets" },
        id: Present { value: "check" },
        run: shadow_gate_config_check_script(),
        shell: Present { value: Bash },
        working_directory: none,
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none,
      },
    ],
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}

data shadow_gate_main_job_needs: List<String> = [shadow_gate_config_job_id]

// The main job's if_condition: runs only when the config job says configured=true.
// When configured=false, GitHub marks this job as SKIPPED (gray), not green and not red.
data shadow_gate_main_job_if: String = "needs.shadow-gate-config.outputs.configured == 'true'"



fn shadow_gate_tailscale_join_step() -> Step {
  UsesStep {
    name: Present { value: "Join tailnet (ephemeral, tag:ci-dispatch)" },
    id: none,
    uses: tailscale_github_action_v4_4_0,
    with: Present { value: [
      // The client ID is PUBLIC: the model constant, not a fetched secret. (The operator also
      // mirrors it as the `tailscale-oauth-client-id` annotation on the Secret Manager secret --
      // #gunbc.tailscale_ci_oauth_client::tailscale_oauth_client_secret_ref; the annotation is where
      // an operator reads the id, not a second source the job resolves.)
      kv(key: "oauth-client-id", value: yaml_string(s: ci_oauth_client_id)),
      // The fetched secret reaches this step as job env: the fetch step registers it with
      // ::add-mask:: before appending it to $GITHUB_ENV, so every later log redacts it.
      kv(key: "oauth-secret", value: yaml_string(s: concat("${{ env.", shadow_gate_oauth_secret_env, " }}"))),
      kv(key: "tags", value: yaml_string(s: shadow_gate_tailscale_tags)),
      kv(key: "args", value: yaml_string(s: shadow_gate_tailscale_args)),
    ] },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// ── THE CREDENTIAL FETCH OVER WIF ────────────────────────────────────────────────────────────────
//
// A CI-specific key for the gunbc-build forced-command account, admitted through the remote-build
// authorized-keys line in gunbc.compute.remote_build. NOT the operator's personal key. The private
// half lives in Secret Manager (#gunbc.compute.remote_build::remote_build_ci_ssh_privkey_secret);
// the job mints the pinned provider's token (google-github-actions/auth through
// #gunbc.fleet.fleet_workflow_steps::ci_wif_auth_step_for -- the same route fleet-converge takes)
// and reads the secret material with it. THE SHAPE OF THE FETCH MIRRORS THE FLEET KEY AGENT
// (gunbc.fleet.fleet_key_agent): the bearer header reaches curl through a 0600 FILE, so the token
// never becomes an argv word (#gunbc.auth.bearer_header_file::gunbc_ci_auth_header_file_write_command_to,
// held by test.claim.credential_argv_exposure_witness); the fetched key STAYS a 0600 file rather
// than joining an agent and being wiped, because the remote-build client reads and verifies the
// identity file itself, and every gate step names it through the client's identity_file parameter.
// The fetched key's FINGERPRINT is pinned from the model (#gunbc.compute.remote_build::remote_build_client_key_ci)
// BEFORE any host sees it: wrong secret material cannot connect anywhere.

fn shadow_gate_ssh_key_access_url() -> String {
  secret_ref_access_url(secret_ref_pin_version(ref: remote_build_ci_ssh_privkey_secret, version: hosted_ci_ssh_key_secret_version))
}

fn shadow_gate_oauth_secret_access_url() -> String {
  secret_ref_access_url(secret_ref_pin_version(ref: tailscale_oauth_client_secret_ref, version: tailscale_oauth_client_secret_version))
}

// The fetch, as one bash script (shell text under this module's HAND-SHELL GATE marker, same
// dissolution as every other run: here -- v2.workflow.bash_emit, #5828).
fn shadow_gate_ci_credentials_fetch_script() -> String {
  join([
    "set -euo pipefail\n",
    "umask 077\n",
    "HDR_FILE=\"$RUNNER_TEMP/shadow-gate-auth-header\"\n",
    "VAL_FILE=\"$RUNNER_TEMP/shadow-gate-oauth-val\"\n",
    // The path comes from ONE constant, shadow_gate_ci_ssh_key_file -- the same value the ssh -i
    // probe and every --arg identity_file= gate step read (review 97138). It is assigned HERE, in
    // the script, not in the step's env block: env values are literal strings GitHub pastes
    // unchanged, and only the script's own bash expands $RUNNER_TEMP (review 97111 finding 2).
    concat("KEY_FILE=\"", shadow_gate_ci_ssh_key_file, "\"\n"),
    "cleanup() { rm -f \"$HDR_FILE\" \"$VAL_FILE\"; }\n",
    "trap cleanup EXIT\n",
    gunbc_ci_auth_header_file_write_command_to(header_file: "HDR_FILE"),
    "\n",
    // THE SSH PRIVATE HALF. Pin the version (never 'latest': the fetch must name what the model
    // named), decode the base64 payload into $KEY_FILE (0600), then verify the fingerprint the
    // model holds BEFORE any ssh uses it. The file persists for the job's later steps; the runner
    // is ephemeral and $RUNNER_TEMP dies with it.
    "rm -f \"$KEY_FILE\"\n",
    "curl -fsSL -H @\"$HDR_FILE\" \"",
    shadow_gate_ssh_key_access_url(),
    "\" | python3 -c 'import sys,json,base64; sys.stdout.write(base64.b64decode(json.load(sys.stdin)[\"payload\"][\"data\"]).decode(\"utf-8\"))' > \"$KEY_FILE\"\n",
    "chmod 600 \"$KEY_FILE\"\n",
    "ACTUAL_FP=\"$(ssh-keygen -lf \"$KEY_FILE\" | awk '\{print $2}')\"\n",
    "EXPECTED_FP=\"",
    remote_build_client_key_ci.fingerprint,
    "\"\n",
    "if [ \"$ACTUAL_FP\" != \"$EXPECTED_FP\" ]; then\n  rm -f \"$KEY_FILE\"\n  echo \"::error::fetched remote-build CI SSH key fingerprint $ACTUAL_FP != the modeled $EXPECTED_FP; refusing to connect with it\" >&2\n  exit 1\nfi\n",
    // THE TAILSCALE OAUTH CLIENT SECRET. The header file is deleted only AFTER BOTH fetches -- one
    // mint, two reads (review 97111 finding 1: an rm between them made the second curl impossible).
    // The value is registered with ::add-mask:: BEFORE it joins $GITHUB_ENV: appending to
    // $GITHUB_ENV alone does NOT mask (review 97111 finding 3) -- add-mask is what makes every
    // later log redact it. The tailscale step reads it as env, never as a secret-context reference.
    "curl -fsSL -H @\"$HDR_FILE\" \"",
    shadow_gate_oauth_secret_access_url(),
    "\" | python3 -c 'import sys,json,base64; print(base64.b64decode(json.load(sys.stdin)[\"payload\"][\"data\"]).decode(\"utf-8\"), end=\"\")' > \"$VAL_FILE\"\n",
    "rm -f \"$HDR_FILE\"\n",
    "VAL=\"$(cat \"$VAL_FILE\")\"\n",
    "echo \"::add-mask::$VAL\"\n",
    "printf '%s=%s\\n' \"",
    shadow_gate_oauth_secret_env,
    "\" \"$VAL\" >> \"$GITHUB_ENV\"\n",
    "rm -f \"$VAL_FILE\"\n",
  ], "")
}

// The fetch step: the pinned provider's token in as env (google-github-actions/auth's
// access_token output), the two credentials out as a 0600 file and a masked job env.
fn shadow_gate_ci_credentials_fetch_step() -> Step {
  RunStep {
    name: Present { value: "Fetch CI credentials over WIF (SM pinned versions -> 0600 file + masked env, fingerprint-pinned)" },
    id: Present { value: "fetch-credentials" },
    run: shadow_gate_ci_credentials_fetch_script(),
    shell: Present { value: Bash },
    working_directory: none,
    env: Present { value: [
      kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}")),
    ] },
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none,
  }
}

// ── THE REMOTE BUILD PLUMBING PROOF ──────────────────────────────────────────────────────────────
//
// ONE step, one small witness package, through remote_test_cli. It proves the hosted runner can
// reach the tailnet, authenticate as the gunbc-build forced-command account, and drive the
// remote-build client end to end. It does NOT run any gate row and does not claim to: when
// remote_gate_cli (work item adhoc-7d2186ce-2c3) lands, its per-row adoption of
// emitted_subject_build_rows replaces this step, and each step will then be named after the row it
// actually runs.

// THE PLUMBING-PROOF PATTERN: one small witness target that exercises the remote-build path
// without needing a full witness roster. This is the remote_test_cli pattern argument.
//
// The pattern is a Bazel TARGET LABEL, not a filesystem path: run 45008834135 was refused at
// 'selection' with 'the pattern selected no module with a planned claim:
// //dag/test/claim/compute/host_capacity_seal_witness.dag:host_capacity_seal_witness.dag', because
// extdeps/bazel/target_pattern parses the trailing component as a TARGET NAME and
// compute/test_selection::witness_label_of_path derives the target name from a source file by
// DROPPING the .dag suffix. Written with the suffix, the target never matches any module, so the
// selection is empty and the run is refused before a single request leaves the runner.
data shadow_gate_plumbing_proof_pattern: String = "//dag/test/claim/compute:host_capacity_seal_witness"

// The remote-build account to SSH into. This is the forced-command account, not root, not operator.
data shadow_gate_remote_user: String = "gunbc-build"

// THE REMOTE-BUILD CLIENT WALKS THE ROSTER. The client (remote_build_client.dag) handles
// unreachable hosts with its typed per-host answer (HostUnreachable). The shadow job targets the
// first serving host from remote_build_serving_hosts(); if it is unreachable, the client refuses
// that host and the step fails (shadow behavior). The model does NOT filter by reachability:
// reachability is a runtime fact (a host's tailnet membership changes when it is joined), not a
// model invariant. As of 2026-11-20 the roster is srv3 and srv4, both joined on the tailnet and
// converged by the serving converger; srv1 left the roster that day (its pinned checkout predates
// the gate-subject verb, and its build pool holds a seat whose holder recorded no exit) and returns
// on a serving converge at or after 2387c5493bb9 -- gunbc.compute.remote_build_hosts
// remote_build_serving_hosts carries the rule at the row. When the roster names no host the step REFUSES:
// shadow_gate_first_serving_host answers Absent and shadow_gate_no_host_run is what runs -- the step never
// names a host from memory.

// The first serving host (the client's own roster ordering; the gate CLI picks by capacity), or Absent when
// the roster names none. The caller refuses on Absent. A remembered literal is a fabricated default
// (gunbc.design_argument::fail_closed: "no plausible output is fabricated"), and the host this lane just
// removed -- for judging requests with a grammar it no longer has -- is exactly the one memory supplies.
fn shadow_gate_first_serving_host() -> String? {
  match list_head(xs: remote_build_serving_hosts()) {
    Present { value: h } => Present { value: h as String }
    Absent => Absent
  }
}

// WHAT THE PLUMBING-PROOF STEP DOES WHEN THE ROSTER NAMES NO HOST: it says so and exits with the code the
// client uses when no host admitted the work, so an undispatched proof is red and countable, never green by
// construction.
// SCAFFOLD MARKER (hand-shell gate policy): this row is a hand-assembled run: string; it joins the other
// hand-assembled strings in this workflow rather than starting a new lane, and they dissolve together at the
// orchestration-to-shell capability v2.workflow.bash_emit / bash_emit_stmts (tracking #5828), where this
// refusal is authored as a modeled Node. The carrier-level marker on shadow_gate_dissolution names that same
// trigger. The exit number is not retyped here: it is RENDERED from the client's own exit authority
// (gunbc.compute.remote_build_client remote_gate_exit_code, the GateNoHostAdmitted arm), so the step and the
// client cannot drift apart -- a step whose refusal exit disagreed with the client's would be a second path
// beside a modeled route.
fn shadow_gate_no_host_run_text(description: String) -> String {
  join(["set -euo pipefail && echo '::error::remote_build_serving_hosts names no serving host: ", description, " cannot be dispatched, and this step refuses to name one from memory' && exit ", int_to_decimal_string(value: remote_gate_exit_code(o: GateNoHostAdmitted))], "")
}

data shadow_gate_no_host_run: String = shadow_gate_no_host_run_text(description: "the plumbing proof")

// The tailnet name for a host identity (the standard pattern from gunbc.fleet.fleet_tailnet).
fn shadow_gate_host_tailnet_name(host: String) -> String {
  join([host, ".tailecbe08.ts.net"], "")
}

// The gunbc binary the CI builds (same as the required gate).
data shadow_gate_gunbc_binary: String = "target/release/gunbc"

// THE SOURCE-ROOT PAIR for every `gunbc run` the workflow emits -- ONE admission (single_authority).
// The directory names are RENDERED from the layout authority (layout_tree_directory binds the dag
// tree to 'dag' and the v2 tree to 'src/v2', relative to the repository root); the runner's
// repository root is $GITHUB_WORKSPACE, so the pair is absolute against the checkout. A layout move
// retargets these lines automatically.
data shadow_gate_source_root_args: String = join(["--source-root \"$GITHUB_WORKSPACE/", layout_tree_directory(tree: LayoutTreeDag{}), "\" --source-root \"$GITHUB_WORKSPACE/", layout_tree_directory(tree: LayoutTreeV2{}), "\""], "")

// THE ONE PLUMBING-PROOF STEP. Name and identity say exactly what runs: remote_test_cli over the
// plumbing-proof pattern, on the first serving host. It is NOT named after any gate row because it
// runs no gate row. When remote_gate_cli lands, per-row steps named after each row's rendered
// label replace it.
fn shadow_gate_remote_build_step() -> Step {
  RunStep {
    name: Present { value: "Plumbing proof: remote_test_cli over the plumbing-proof pattern" },
    id: Present { value: "remote-build-plumbing-proof" },
    run: shadow_gate_plumbing_proof_run(),
    shell: Present { value: Bash },
    working_directory: none,
    env: Present { value: concat(shadow_gate_push_credential_env(), [
      kv(key: shadow_gate_pattern_env, value: yaml_string(s: shadow_gate_pattern_input_expression)),
    ]) },
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
// THE PLUMBING PROOF'S COMMAND, one place: when the roster names a host, the client invocation
// against it; when the roster names none, the typed refusal, which is the only honest thing a job
// can print before it has dispatched anything at all. NO bare `ssh ... true` probe: the forced
// command IS the protocol server, and a bare dial is a ONE-word request its grammar refuses
// ('a request needs at least five words; saw 1' -- run 44960617832, where the probe killed the
// step before the client ever ran). Reachability and admission are the protocol client's own
// typed outcomes (exit 3 when no host is admitted; a refusal prints the server's reason).
// SCAFFOLD MARKER (hand-shell gate policy): this is a hand-assembled run: string; it joins the
// other hand-assembled strings in this workflow rather than starting a new lane, and dissolves
// with them at the orchestration-to-shell capability v2.workflow.bash_emit / bash_emit_stmts
// (tracking #5828), where the step is authored as modeled Nodes.
fn shadow_gate_plumbing_proof_run() -> String {
  match shadow_gate_first_serving_host() {
    Absent => shadow_gate_no_host_run
    Present { value: _host } =>
      join([
        "set -euo pipefail",
        "echo '--- remote gate step ---'",
        concat(concat(concat(concat(concat(concat(concat(concat(concat(shadow_gate_gunbc_binary, concat(" run ", shadow_gate_source_root_args)), " --entry dag/gunbc/compute/remote_build_client.dag --function remote_test_cli --arg worktree=$PWD --arg pattern=\"${"), shadow_gate_pattern_env), ":-"), shadow_gate_plumbing_proof_pattern), "}\" --arg host="), _host), " --arg receipt_path=/tmp/shadow-gate-receipt-plumbing-proof.json --arg identity_file="), shadow_gate_ci_ssh_key_file),
        "cat /tmp/shadow-gate-receipt-plumbing-proof.json",
      ], " && ")
  }
}


// THE PER-ROW GATE STEP (agreed shape with gunbc.compute.remote_build_client's remote_gate_cli,
// sibling lane adhoc-7d2186ce-2c3): one step per emitted_subject_build_rows row, invoked with the
// row's LABEL (so the remote side runs exactly the row the required v2-bootstrap job runs), the
// checkout path, and a per-row receipt path. Exit codes follow the instrument law and are rendered
// per the manager ruling of 2026-11-20: 0 held; 1 = code verdict -> step RED (the honest failure);
// 2 = typed local refusal (label not a gate row, snapshot refused) -> RED, because that is a model
// bug and must never pass quietly; 3 = no host admitted the reservation -> RED with the typed
// 'no host admitted' error (a green check that did not run the gate is the silent pass
// gunbc.design_argument::fail_closed forbids; while this job is non-required, red there costs
// nothing and tells the truth); 4 = code verdict held but the client could not delete the origin
// ref -> step green with a countable ::warning:: (cleanup fact, not a verdict on the code). The
// receipt is cat-ed to the log on EVERY outcome, so the run always carries the typed attempts.
// SCAFFOLD MARKER (hand-shell gate policy): the exit-rendering block below is a hand-assembled
// run: string; it joins the other hand-assembled strings in this workflow rather than starting a
// new lane, and dissolves with them at the orchestration-to-shell capability v2.workflow.bash_emit
// / bash_emit_stmts (tracking #5828), where the case arms become modeled Nodes.
fn shadow_gate_remote_gate_step(row: EmittedSubjectBuildRow) -> Step {
  let label_text = emitted_subject_build_label_text(row: row)
  RunStep {
    name: Present { value: concat("Remote gate: ", label_text) },
    id: Present { value: concat("gate-", row.step_id) },
    // The roster selection is the ONE typed source for the host pin, here exactly as in the
    // plumbing proof: with a Present roster the request is PINNED to that host (--arg host= is the
    // client's own pin, which must be a DISPATCH-roster host or the client refuses); with an empty
    // roster the step carries the typed no-host refusal, because the CLI contract counts the pin
    // among required arguments and calling without it is a contract error, not an omission.
    run: match shadow_gate_first_serving_host() {
      Absent => shadow_gate_no_host_run_text(description: concat("gate ", label_text))
      Present { value: host } => concat(
      join([
        "set -uo pipefail",
        "rc=0",
        concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(shadow_gate_gunbc_binary, concat(" run ", shadow_gate_source_root_args)), " --entry dag/gunbc/compute/remote_build_client.dag --function remote_gate_cli --arg worktree=$GITHUB_WORKSPACE --arg label='"), label_text), "' --arg host="), host), " --arg receipt_path=\"$RUNNER_TEMP/gate-"), row.step_id), ".json\" --arg identity_file="), shadow_gate_ci_ssh_key_file), " || rc=$?"),
        concat(concat("cat \"$RUNNER_TEMP/gate-", row.step_id), ".json\" || true"),
        "case \"$rc\" in",
        "  0) exit 0;;",
        concat("  1) echo '::error::gate ", label_text, ": code verdict - did not hold'; exit 1;;"),
        concat("  2) echo '::error::gate ", label_text, ": typed local refusal - nothing was sent to any host'; exit 1;;"),
        concat("  3) echo '::error::gate ", label_text, ": no host admitted the reservation (capacity/infra)'; exit 1;;"),
        concat("  4) echo '::warning::gate ", label_text, ": held, but an origin ref was left behind (cleanup fact; count these)'; exit 0;;"),
        concat("  *) echo \"::error::gate ", label_text, ": unexpected exit code $rc\"; exit 1;;"),
        "esac"
      ], "\n"),
      "\n"
    )
    },
    shell: Present { value: Bash },
    working_directory: none,
    env: Present { value: shadow_gate_push_credential_env() },
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// The remote steps: the plumbing-proof step (tailnet+ssh reachability and the red control via the
// pattern input) PLUS one gate step per emitted_subject_build_rows row once remote_gate_cli is on
// main. The plumbing step is not named after a row and runs no row; the gate steps carry the rows.
fn shadow_gate_remote_build_steps() -> List<Step> {
  list_append(
    left: [shadow_gate_remote_build_step()],
    right: list_map(xs: emitted_subject_build_rows(), f: shadow_gate_remote_gate_step)
  )
}

// ── THE PUSH CREDENTIAL (narrowly scoped; the granting decision is the ruling cited below) ───────
// #gunbc.design_ruling::hosted_shadow_gate_push_credential_scoped_write_2026_11_22
//
// The protocol's hidden-ref push (remote_build_client_source_ref / remote_build_client_push_argv:
// ONLY refs/remote-build/<commit>.<millis>, a one-level hidden ref the client deletes after the
// request) authenticates with the job's own GITHUB_TOKEN, so this dispatch@main-only job holds
// contents: write. Scope holds it honest: checkout keeps persist-credentials: false (nothing enters
// .git/config), the token rides ONLY the three remote-build client steps' env (not job env, not any
// other step), the helper is injected through git's own GIT_CONFIG_* environment mechanism so no
// file is written at all, and branch protection still guards main. A public repository means the
// push can exfiltrate nothing that read access could not already reach.
fn shadow_gate_push_credential_env() -> List<YamlKeyValue> {
  [
    kv(key: "GIT_CONFIG_COUNT", value: yaml_string(s: "2")),
    kv(key: "GIT_CONFIG_KEY_0", value: yaml_string(s: "credential.https://github.com/.helper")),
    kv(key: "GIT_CONFIG_VALUE_0", value: yaml_string(s: "")),
    kv(key: "GIT_CONFIG_KEY_1", value: yaml_string(s: "credential.https://github.com/.helper")),
    kv(key: "GIT_CONFIG_VALUE_1", value: yaml_string(s: "!f(){ echo username=x-access-token; echo password=$GITHUB_TOKEN; };f")),
    kv(key: "GITHUB_TOKEN", value: yaml_string(s: "${{ secrets.GITHUB_TOKEN }}")),
  ]
}

// ── THE BUILD STEPS (hosted prelude: checkout, build gunbc) ──────────────────────────────────────
//
// The shadow gate needs a working gunbc binary to invoke remote_test_cli. The hosted runner builds
// it from source. This is slower than the fleet (which has a pre-built binary), but the shadow gate
// measures WALL TIME against v2-bootstrap; the build is part of what is measured.

fn shadow_gate_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present { value: [kv(key: "persist-credentials", value: yaml_bool(b: false))] },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn shadow_gate_build_step() -> Step {
  RunStep {
    name: Present { value: "Build gunbc" },
    id: Present { value: "build-gunbc" },
    run: "cargo build --release --bin gunbc\n",
    shell: Present { value: Bash },
    working_directory: none,
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// ── THE JOB ──────────────────────────────────────────────────────────────────────────────────────

fn shadow_gate_job() -> Job {
  Job {
    id: shadow_gate_job_id,
    name: Present { value: "Hosted-runner shadow gate (remote build)" },
    runner: HostedRunner { label: Ubuntu2404 },
    environment: none,
    env: none,
    if_condition: Present { value: shadow_gate_main_job_if },
    needs: shadow_gate_main_job_needs,
    outputs: none,
    // contents: write exists for ONE effect: the remote-build client's hidden-ref push
    // (refs/remote-build/<commit>.<millis> only -- see shadow_gate_push_credential_env); branch
    // protection still guards main and the job is dispatch@main-only. id-token: write belongs to
    // exactly one step -- the WIF auth step -- and the pin (hosted_ci_secrets_attribute_condition)
    // bounds who can answer it.
    permissions: Present { value: WorkflowPermissions {
      contents: Present { value: PermWrite },
      pull_requests: none,
      issues: none,
      actions: none,
      id_token: Present { value: PermWrite },
      pages: none,
    }},
    concurrency: none,
    timeout_minutes: Present { value: shadow_gate_timeout_minutes },
    continue_on_error: none,
    steps: shadow_gate_all_steps(),
  }
}

// The steps in order: checkout, build, WIF auth, credential fetch, tailscale join, remote gate per row.
fn shadow_gate_all_steps() -> List<Step> {
  list_append(
    left: [
      shadow_gate_checkout_step(),
      shadow_gate_build_step(),
      // Credentials FIRST: the tailscale join needs the fetched OAuth secret, and every remote
      // step needs the fetched SSH key. The auth step's id is wif_auth (the fleet-converge shape).
      ci_wif_auth_step_for(
        name: concat("Federate to the hosted-CI service account (pinned: this workflow at refs/heads/", gunbc_default_branch_name, ", dispatch only)"),
        provider_resource: hosted_ci_secrets_provider_resource(),
        service_account: hosted_ci_secrets_service_account,
      ),
      shadow_gate_ci_credentials_fetch_step(),
      shadow_gate_tailscale_join_step(),
    ],
    right: shadow_gate_remote_build_steps()
  )
}

// ── THE WORKFLOW ─────────────────────────────────────────────────────────────────────────────────

fn shadow_gate_workflow() -> Workflow {
  Workflow {
    name: shadow_gate_workflow_name,
    run_name: none,
    on: shadow_gate_triggers(),
    concurrency: none,
    env: none,
    permissions: none,
    jobs: [shadow_gate_config_job(), shadow_gate_job()],
  }
}

// ── THE EMITTER ──────────────────────────────────────────────────────────────────────────────────

type ShadowGateWorkflowGenerationOutcome
  = ShadowGateWorkflowGenerated { content: String }
  | ShadowGateWorkflowGenerationRefused { reason: String }

fn expected_hosted_runner_shadow_gate_yml() -> ShadowGateWorkflowGenerationOutcome {
  expected_hosted_runner_shadow_gate_yml_with(workflow: shadow_gate_workflow())
}

// THE MARKER HEADER, INSIDE the emitted content: the two carriers that belong on the artifact per
// gunbc.design_argument::source_annotations ("a dissolution condition belongs in a typed carrier") --
// the HAND-SHELL GATE line (the run: strings are scaffold pending v2.workflow.bash_emit /
// bash_emit_stmts, #5828 -- the trigger the runner_host_medium precedent names) and the DISSOLUTION
// line (the job dissolves at remote-build cutover). gunbc.test.claim
// .hosted_runner_shadow_gate_workflow_witness locks both on these bytes. The "# Generated by"/
// "# Authority" provenance lines are NOT inlined here: gunbc.generated_artifact_emit artifact_generate
// prepends them at one bytes boundary from the gunbc.generated_workflow_provenance row, and inlining
// them here duplicated them when main_wet regenerated (smart-crane-730's drift report on #16766).
// The CLI below composes the SAME projected header, so dev regen and the instrument agree.
fn shadow_gate_generated_header() -> String {
  concat(
    concat(
      "# HAND-SHELL GATE: run: steps are scaffold strings; dissolution trigger is v2.workflow.bash_emit / bash_emit_stmts (#5828).\n",
      "# DISSOLUTION (fail-closed): this carrier DISSOLVES WHEN "
    ),
    concat(
      concat(dissolution_description(condition: shadow_gate_dissolution), ".\n"),
      shadow_gate_push_credential_header_note
    )
  )
}

// The push-credential fact, carried at the bytes boundary where it is reviewed: WHAT may be pushed
// (protocol-bounded hidden refs), HOW far the permission reaches (client steps' env only), and that
// main stays guarded. The operator scoped it; the record belongs on the artifact.
data shadow_gate_push_credential_header_note: String = "# PUSH CREDENTIAL (gunbc.design_ruling::hosted_shadow_gate_push_credential_scoped_write_2026_11_22, decided 2026-11-22): the remote-build client pushes ONLY hidden refs refs/remote-build/<commit>.<millis> (gunbc.compute.remote_build_client remote_build_client_source_ref), deleted after the request; contents: write is held by this dispatch@main-only job and the token rides ONLY the client steps' env (GIT_CONFIG_* helper, never .git/config); checkout persists no credential; branch protection still guards main.\n"

fn expected_hosted_runner_shadow_gate_yml_with(workflow: Workflow) -> ShadowGateWorkflowGenerationOutcome {
  match admit_workflow_action_uses(workflow: workflow) {
    WorkflowActionUsesRefused { refusals: rs } =>
      ShadowGateWorkflowGenerationRefused { reason: workflow_action_uses_refusal_reason(workflow_module: "gunbc.witness.hosted_runner_shadow_gate_workflow", refusals: rs) }
    WorkflowActionUsesAdmitted =>
      match admit_workflow_checkout_refs(workflow: workflow, declared: []) {
        WorkflowCheckoutRefsRefused { refusals: crs } =>
          ShadowGateWorkflowGenerationRefused { reason: workflow_checkout_refs_refusal_reason(workflow_module: "gunbc.witness.hosted_runner_shadow_gate_workflow", refusals: crs) }
        WorkflowCheckoutRefsAdmitted =>
          match admit_workflow_toolchain_homes(workflow: workflow) {
            WorkflowToolchainHomesAdmitted =>
              match emit_yaml(v: project_workflow_to_yaml(workflow: workflow)) {
                EmittedYaml { text: t } => ShadowGateWorkflowGenerated { content: concat(shadow_gate_generated_header(), t) }
                YamlEmitRefused { path: p, reason: r } =>
                  ShadowGateWorkflowGenerationRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.witness.hosted_runner_shadow_gate_workflow", path: p, reason: r) }
              }
            WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
              ShadowGateWorkflowGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
          }
      }
  }
}

// ── THE CLI ────────────────────────────────────────────────────────────────────────────────────────
//
//   gunbc --dry-run run --source-root dag --source-root src/v2 \
//     --entry dag/gunbc/witness/hosted_runner_shadow_gate_workflow.dag \
//     --function shadow_gate_emit_cli

fn shadow_gate_emit_cli() -> ProcessExit {
  match generated_workflow_provenance_header(a: HostedRunnerShadowGateYamlArtifact) {
    GeneratedWorkflowProvenanceHeaderProduced { content: header } =>
      match expected_hosted_runner_shadow_gate_yml() {
        ShadowGateWorkflowGenerated { content } => {
          let w = Filesystem.Write(path: ".github/workflows/hosted-runner-shadow-gate.yml", content: concat(header, content))
          if w.success { ExitSuccess } else { ExitFailure { code: 1, reason: w.error } }
        }
        ShadowGateWorkflowGenerationRefused { reason } => ExitFailure { code: 1, reason: reason }
      }
    GeneratedWorkflowProvenanceHeaderNotApplicable =>
      ExitFailure { code: 1, reason: "gunbc.generated_workflow_provenance has no provenance row for HostedRunnerShadowGateYamlArtifact: the commit-policy admission requires one (fail-closed)" }
  }
}

fn hosted_runner_shadow_gate_yaml_artifact_generated() -> ArtifactGenerationOutcome {
  match expected_hosted_runner_shadow_gate_yml() {
      ShadowGateWorkflowGenerated { content } => workflow_body_generated(content: content)
      ShadowGateWorkflowGenerationRefused { reason } => ArtifactGenerationRefused { reason: reason }
    }
}

fn hosted_runner_shadow_gate_yaml_artifact_extra_valid(_generated: ArtifactGenerationOutcome) -> Bool {
  ci_yml_parses(path: artifact_path(a: HostedRunnerShadowGateYamlArtifact))
}

data hosted_runner_shadow_gate_yaml_artifact_production: GeneratedArtifactProduction = GeneratedArtifactProduction {
  generate: hosted_runner_shadow_gate_yaml_artifact_generated,
  extra_valid: hosted_runner_shadow_gate_yaml_artifact_extra_valid,
  provenance: Present { value: GeneratedWorkflowProvenance {
    generator: "gunbc.witness.hosted_runner_shadow_gate_workflow expected_hosted_runner_shadow_gate_yml",
    authority: "gunbc.witness.hosted_runner_shadow_gate_workflow shadow_gate_workflow",
  } },
}
