import extdeps.languages.yaml.ingest { ingest_yaml_source, IngestedYaml, YamlIngestRejected }
// THE GUARD IS BUILT AS NODES AND RENDERED, never joined from strings (review 82001, manager
// ruling). These are the same three modules the memory guard and the toolchain isolation carrier
// import: a builder for the tree, the emitter that renders it, and the dissolution vocabulary for
// the marker that names when this carrier can be deleted.
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }
import v2.std.diagnostic { Outcome, Accepted, Rejected }
import v2.std.node { Node }
import v2.workflow.bash_emit { bash_emit_stmts }
import v2.extdeps.languages.bash_build {
  bash_build_assign,
  bash_build_command_from_lits,
  bash_build_command_with_words,
  bash_build_exit,
  bash_build_if_from_stmts,
  bash_build_or_else,
  bash_build_test_bracket,
  bash_build_word_cmdsubst,
  bash_build_word_concat_from_nodes,
  bash_build_word_lit,
  bash_build_word_var
}

// THE INVOCATION-CONTRACT STAMP: what the generated steps of gunbc.witness.compiler_gate_workflow
// promise about the SUBJECT'S OWN BINARY -- which verbs it is asked to run, with which flags, and what
// shape of output a step reads back -- hashed into one literal that is emitted into the workflow AND
// read back off the checked-out tree.
//
// WHY THIS EXISTS. gunbc.recurring_failure_mode.instruction_and_subject_resolved_from_different_revisions,
// silent arm. A pull-request run takes the WORKFLOW TEXT from the merge ref and the gunbc BINARY from
// the PR head (the lane's checkout ref is github.event.pull_request.head.sha, so the two are never
// declared to be paired). When the head lacks the newest part of an instruction, the older binary still
// ANSWERS the newer command: runs 39066871919, 39067193189, 39067690307 and 39069382384 (2026-10-17)
// executed the new reuse walk against a head predating the ancestor locator, printed the six-field
// counts shape with no ancestor=, and exited GREEN with reused=0. The step's only contract on that
// output was a shell exit code, so a stale verb answering a fresh command was indistinguishable from a
// current verb with nothing to reuse -- and reused=0 is a legitimate outcome, which is what made those
// greens so easy to read as fine. Nothing refused, because nothing was written down about what the step
// would accept as an answer.
//
// THIS IS THE WRITTEN-DOWN, AND IT IS A PREMISE, NOT A SYMPTOM CHECK. The stamp is deliberately NOT
// "the counts line must contain ancestor=": that is one per symptom, hard-codes one field name, passes
// every other shape drift, and must be rewritten each time the contract moves (§5 -- a check that would
// also pass the bad thing is not a check). The stamp is the declaration the generator ALREADY HOLDS
// when it emits the step: the step says "run this verb, with these flags, and read this field set
// back". Refusing when the checked-out tree cannot have produced that declaration refuses the SPLIT
// itself, whichever part of the instruction the head is missing.
//
// THE PREIMAGE, AND WHY IT IS THESE ROWS AND NOT THE WORKFLOW TEXT. DESIGN §4d and the stated law of
// gunbc.required_ci_contract_epoch: do NOT digest workflow text, or every unrelated commit to main
// forces every open PR to merge main. So the preimage is ONLY the atoms a generated step puts in the
// subject's argv or reads from its stdout, taken from rows the generator already consumes. A change to
// main that touches no invoked contract must NOT move the stamp; a change to an invoked verb, a flag it
// is handed, or a field a step reads MUST move it, because the stale-subject case is exactly the case
// where those moved.

// THE CONSUMER OF THIS VALUE, named rather than implied (DESIGN §3c: a value with no consumer is a
// value that will be deleted, or worse, kept and disagreed with). It is read in exactly three places,
// and each is a DIFFERENT reading, which is the whole point:
//   1. THE EMITTED WORKFLOW, .github/workflows/witnesses.yml, carries the value as the workflow-level
//      `env: GUNBC_COMPILER_GATE_CONTRACT_STAMP:` LITERAL, written by
//      gunbc.witness.compiler_gate_workflow compiler_gate_contract_stamp_env_entry. That is the RUNNING
//      side -- what the instruction in force promised.
//   2. THE SAME FILE AT THE CHECKED-OUT REVISION, read by the guard step this module emits
//      (compiler_gate_contract_stamp_guard_script -> compiler_gate_contract_stamp_read_from), one parse
//      of .github/workflows/witnesses.yml out of the tree the lane actually built. That is the TREE side
//      -- what the subject's own revision declared. The comparison IS the guard; nothing else consumes
//      the pair, so the value cannot become a decoration someone disagrees with.
//   3. THE WITNESS test.claim.compiler_gate_contract_stamp_witness, which binds both sides: the emitted
//      literal against this derivation, the refusal text against these strings, and the step's POSITION
//      against the emitted job.
// There is deliberately NO fourth reader: not the epoch, not the heal gate, not any admission walk. A
// second authority reading the same name would be the drift this value exists to prevent.

// THE NAME, one place, so the emitter, the refusal, the consumer above and the witness cannot drift
// apart. Deliberately a sibling of, and not equal to, required_ci_contract_epoch_env_key: the two hash
// different preimages and answer different questions, and a shared key would let one silently stand in
// for the other.
data compiler_gate_contract_stamp_env_key: String = "GUNBC_COMPILER_GATE_CONTRACT_STAMP"

data compiler_gate_contract_stamp_provenance: String = "gunbc.witness.compiler_gate_workflow compiler_gate_contract_stamp"

// --------------------------------------------------------------------------------- THE DECLARED CONTRACT
//
// THE ATOMS. Each entry is a promise the emitted steps make about the subject's argv or its stdout, and
// each is spelled by the row that GENERATES the step rather than re-typed here (§3). Adding a verb, a
// flag or a read-back field means adding its atom; omitting one leaves the stamp silent about a promise,
// which is precisely the gap that let four stale-verb runs pass.

// THE VERBS AND THE FLAGS THEY ARE HANDED. Four argv shapes, one per generated step that invokes the
// subject's binary: the reuse walk, the plain walk, the identity/receipts publisher, and the two
// instrument builds. `--reuse-from` is the flag whose ABSENCE was the loud form of this class (unknown
// option --reuse-from, exit 127 with an empty --compiler) and whose silent form is the four greens
// above: a head predating it still accepted the command.
fn compiler_gate_invocation_argv_rows() -> List<String> {
  list_append(
    left: [
      join(["argv:", cli_verb_parse_population, " --compiler ", " --reuse-from "], ""),
      join(["argv:", cli_verb_parse_population, " --compiler ", " --write-identity ", " --receipts "], ""),
      join(["argv:", cli_verb_parse_population, " --compiler "], "")
    ],
    right: list_map(
      xs: emitted_subject_build_rows(),
      f: fn(row) { join(["argv:test ", emitted_subject_build_label_text(row: row)], "") }
    )
  )
}

// THE OUTPUT SHAPE A STEP READS BACK. The reuse walk accepts whatever the verb prints provided it exits
// 0, so the field set IS the contract -- and it is the field set the four silent runs proved unenforced.
// The labels are the rows the verb prints and its claim asserts, so there is no second spelling that
// could drift and quietly un-stamp a real contract change.
data compiler_gate_invocation_output_rows: List<String> = list_append( left: list_map( xs: parse_verdict_reuse_counts_field_labels, f: fn(label) { concat("stdout:", parse_verdict_reuse_counts_prefix, " ", label) } ), right: ["stdout:ancestor-attribution-required"] )

// THE LOCATOR'S BOUND. The restore chain walks a declared first-parent window and records the ancestor
// it restored from; the counts line then names it. The window's width is contract, because a head that
// cannot walk as far cannot make the claim the step makes. Drawn from the same row the locator, the
// gated restore chain and the record step are all generated from, so the stamp cannot disagree with the
// steps it stamps.
fn compiler_gate_invocation_locator_rows() -> List<String> {
  list_map(
    xs: parse_verdict_restore_ancestor_ordinals,
    f: fn(ordinal) { join(["locator:first-parent-ordinal:", to_string(ordinal)], "") }
  )
}

fn compiler_gate_invocation_contract_rows() -> List<String> {
  list_append(
    left: list_append(left: compiler_gate_invocation_argv_rows(), right: compiler_gate_invocation_output_rows),
    right: compiler_gate_invocation_locator_rows()
  )
}

// CANONICAL ORDER, for the same reason the epoch sorts its lists: a row appended in a different order is
// not a changed contract, and a stamp that moved on reordering would be a stamp that lies about being
// moved by a real change.
fn compiler_gate_invocation_contract_canonical_rows() -> List<String> {
  sort_by(compiler_gate_invocation_contract_rows(), f => f)
}

fn compiler_gate_invocation_contract_material() -> String {
  join(compiler_gate_invocation_contract_canonical_rows(), "|")
}

// -------------------------------------------------------------------------------------- DERIVED OR REFUSE
//
// The value is a function of the declared rows and nothing else, so no author can pin a stamp that
// flatters a stale tree, and the refusal to produce one is typed rather than silent. Mirrors
// required_ci_contract_epoch_is_derived: a module that cannot state its own stamp must REFUSE to emit
// one, not emit a placeholder that would compare equal to itself forever.
type CompilerGateContractStampDerivation
  = CompilerGateContractStampDerived { stamp: ContentHash }
  | CompilerGateContractStampNotDerived { reason: String }

fn compiler_gate_contract_stamp_derivation() -> CompilerGateContractStampDerivation {
  if length(compiler_gate_invocation_contract_canonical_rows()) == 0 {
    CompilerGateContractStampNotDerived {
      reason: "the invocation contract declares no rows, so nothing would be promised and nothing could be refused"
    }
  } else if fold(
    compiler_gate_invocation_contract_canonical_rows(),
    init: false,
    f: fn(any_empty, row) { any_empty || string_length(s: row) == 0 }
  ) {
    CompilerGateContractStampNotDerived {
      reason: "a declared contract row is empty, so two different contracts could hash alike"
    }
  } else if string_contains(s: compiler_gate_invocation_contract_material(), pattern: "${{") {
    CompilerGateContractStampNotDerived {
      reason: "a contract row carries a GitHub expression, so the stamp would not be a literal and could not be compared"
    }
  } else {
    CompilerGateContractStampDerived {
      stamp: content_hash_of_value(value: compiler_gate_invocation_contract_material())
    }
  }
}

fn compiler_gate_contract_stamp_is_derived() -> Bool {
  match compiler_gate_contract_stamp_derivation {
    CompilerGateContractStampDerived { stamp: _ } => true
    CompilerGateContractStampNotDerived { reason: _ } => false
  }
}

fn compiler_gate_contract_stamp_underived_reason() -> String {
  match compiler_gate_contract_stamp_derivation {
    CompilerGateContractStampDerived { stamp: _ } => ""
    CompilerGateContractStampNotDerived { reason: r } => r
  }
}

// THE LITERAL THAT GOES INTO THE EMITTED WORKFLOW. "refused" is a value that can never equal a content
// hash, so an underived stamp fails the tree comparison rather than passing it -- refuse, never warn.
fn compiler_gate_contract_stamp_yaml_value() -> String {
  match compiler_gate_contract_stamp_derivation {
    CompilerGateContractStampDerived { stamp: stamp } => serialize_content_hash(hash: stamp)
    CompilerGateContractStampNotDerived { reason: _ } => "refused"
  }
}

fn compiler_gate_contract_stamp() -> String {
  compiler_gate_contract_stamp_yaml_value()
}

// --------------------------------------------------------------------------------------- THE TREE-SIDE READ
//
// ONE PARSE, TYPED ARMS, NO WARNING ARM AND NO OVERRIDE INPUT (§5). The RUNNING side of the comparison is
// not read here: it arrives as the workflow-level env literal the runner injected, which is the file
// GitHub actually executed. The TREE side is this file as it sits in the checked-out subject. When the
// two differ, the instruction executing was not generated from the tree it is judging -- which is the
// split, and the refusal names both stamps.
//
// WHY NOT THE TREE'S OWN gunbc TO PARSE IT. The suspect in this class is the tree's binary, so a read
// that runs it would have the accused vouch for itself. The read goes through the ingested document,
// structurally -- never a substring scan, which would match the key inside a shell command, a heredoc or
// a comment and answer about text rather than about the workflow's environment (the law
// gunbc.required_ci_epoch_observation states for the sibling reader).
//
// WHY NO "MALFORMED HEX" ARM. Once the member is a non-empty string there is no further decoding step
// that could refuse; an arm for it would be a permanently unreachable RED, which std.contract_identity
// forbids on ContractEpoch itself. The arms below are each reachable from a document a fixture can hand.
type CompilerGateContractStampReading
  = StampPresent { stamp: String }
  | StampAbsent
  | StampUnreadable { detail: String }
  | StampMismatch { running: String, tree: String }

fn compiler_gate_contract_stamp_workflow_path() -> FilePath {
  artifact_path(a: WitnessFloorYamlArtifact) as FilePath
}

fn compiler_gate_stamp_env_entries(entries: List<YamlKeyValue>) -> List<YamlKeyValue> {
  fold(
    entries,
    init: [],
    f: fn(acc, kv) {
      if kv.key == "env" {
        match kv.value {
          YamlMapping { entries: es } => es
          YamlNull => acc
          YamlBool { value: _ } => acc
          YamlInt { lexeme: _ } => acc
          YamlFloat { lexeme: _ } => acc
          YamlString { value: _ } => acc
          YamlSequence { elements: _ } => acc
        }
      } else {
        acc
      }
    }
  )
}

fn compiler_gate_stamp_matching_entries(entries: List<YamlKeyValue>) -> List<YamlKeyValue> {
  filter(entries, kv => kv.key == compiler_gate_contract_stamp_env_key)
}

// A SECOND STAMP MEMBER IS UNREADABLE, NOT "THE FIRST ONE WINS". A workflow that declares the stamp
// twice is not a workflow whose stamp can be trusted, and picking one by position would be a silent
// resolution of an ambiguity the check exists to police.
fn compiler_gate_stamp_from_entry(kvs: List<YamlKeyValue>) -> CompilerGateContractStampReading {
  match length(kvs) {
    0 => StampAbsent
    1 =>
      match first(kvs) {
        Present { value: kv } =>
          match kv.value {
            YamlString { value: s } =>
              if string_length(s: s) == 0 {
                StampUnreadable { detail: "the stamp member is the empty string" }
              } else if string_contains(s: s, pattern: "${{") {
                StampUnreadable { detail: "the stamp member is a GitHub expression, not a literal" }
              } else {
                StampPresent { stamp: trim(s) }
              }
            YamlNull => StampUnreadable { detail: "the stamp member is not a string" }
            YamlBool { value: _ } => StampUnreadable { detail: "the stamp member is not a string" }
            YamlInt { lexeme: _ } => StampUnreadable { detail: "the stamp member is not a string" }
            YamlFloat { lexeme: _ } => StampUnreadable { detail: "the stamp member is not a string" }
            YamlSequence { elements: _ } => StampUnreadable { detail: "the stamp member is not a string" }
            YamlMapping { entries: _ } => StampUnreadable { detail: "the stamp member is not a string" }
          }
        Absent => StampAbsent
      }
    _ => StampUnreadable { detail: "the workflow declares the contract stamp member more than once" }
  }
}

// THE PURE HALF: it takes source text and decides, so every refusal arm is authorable from a fixture.
fn compiler_gate_contract_stamp_read_from(src: String) -> CompilerGateContractStampReading {
  match ingest_yaml_source(src: src) {
    YamlIngestRejected { line: l, reason: r } =>
      StampUnreadable { detail: join(["document rejected at line ", to_string(l), ": ", r], "") }
    IngestedYaml { value: doc } =>
      match doc {
        YamlMapping { entries: es } =>
          compiler_gate_stamp_from_entry(
            kvs: compiler_gate_stamp_matching_entries(
              entries: compiler_gate_stamp_env_entries(entries: es)
            )
          )
        YamlNull => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
        YamlBool { value: _ } => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
        YamlInt { lexeme: _ } => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
        YamlFloat { lexeme: _ } => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
        YamlString { value: _ } => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
        YamlSequence { elements: _ } => StampUnreadable { detail: "the workflow document is not a mapping, so it declares no env block" }
      }
  }
}

// --------------------------------------------------------------------------------------------- THE VERDICT
//
// Four arms and no fifth. The RUNNING value is compared as read: the emitted workflow carries a literal,
// and a running value that is not a literal is a generation bug the derived-or-refuse half above already
// refuses at emit time -- so there is no second parse here to author, and no arm to fake.
fn compiler_gate_contract_stamp_compare(
  running: String,
  tree: CompilerGateContractStampReading
) -> CompilerGateContractStampReading {
  match tree {
    StampPresent { stamp: tree_stamp } =>
      if tree_stamp == running {
        StampPresent { stamp: tree_stamp }
      } else {
        StampMismatch { running: running, tree: tree_stamp }
      }
    StampAbsent => StampAbsent
    StampUnreadable { detail: d } => StampUnreadable { detail: d }
    StampMismatch { running: r, tree: t } => StampMismatch { running: r, tree: t }
  }
}

// THE DIAGNOSTIC IS THE POINT OF THE CHECK. Every refusal names BOTH stamps and the one remedy, and is
// located by the step that prints it. There is no warning arm and no input that overrides it (§5).
fn compiler_gate_contract_stamp_refusal_line(verdict: CompilerGateContractStampReading) -> String {
  match verdict {
    StampPresent { stamp: _ } => ""
    StampAbsent => join(
      [
        "REFUSED gunbc contract stamp: StampAbsent. The checked-out subject declares no ",
        compiler_gate_contract_stamp_env_key,
        " at ",
        compiler_gate_contract_stamp_workflow_path_as_string(),
        ", so its workflow predates the instruction this job is executing. ",
        compiler_gate_contract_stamp_provenance,
        ". Remedy: merge origin/main into this branch."
      ],
      ""
    )
    StampUnreadable { detail: d } => join(
      [
        "REFUSED gunbc contract stamp: StampUnreadable {",
        d,
        "}. The checked-out subject's ",
        compiler_gate_contract_stamp_workflow_path_as_string(),
        " does not carry a readable ",
        compiler_gate_contract_stamp_env_key,
        ". Remedy: merge origin/main into this branch."
      ],
      ""
    )
    StampMismatch { running: running, tree: tree_stamp } => join(
      [
        "REFUSED gunbc contract stamp: StampMismatch \{running=",
        running,
        ", tree=",
        tree_stamp,
        "}. The workflow executing was generated from a DIFFERENT revision than the tree it is judging: ",
        "the instruction came from the merge ref and the ",
        compiler_gate_contract_stamp_provenance,
        "-stamped workflow in the checked-out tree says otherwise. ",
        "Remedy: merge origin/main into this branch so the tree carries the instruction being run."
      ],
      ""
    )
  }
}

fn compiler_gate_contract_stamp_workflow_path_as_string() -> String {
  compiler_gate_contract_stamp_workflow_path() as String
}

// THE ARMS THE GENERATED STEP ACTS ON, kept as named predicates so the witness can assert each one is
// reachable rather than taking the step's word for it.
fn compiler_gate_contract_stamp_is_refusal(verdict: CompilerGateContractStampReading) -> Bool {
  match verdict {
    StampPresent { stamp: _ } => false
    StampAbsent => true
    StampUnreadable { detail: _ } => true
    StampMismatch { running: _, tree: _ } => true
  }
}

// ----------------------------------------------------------------------------------- THE GENERATED STEP
//
// ONE STEP, PLACED BEFORE EVERY STEP THAT INVOKES THE TREE'S OWN BINARY, AND ONLY IN THE JOB THAT DOES.
// It runs no product and reads nothing but the checked-out file, so it can sit ahead of the toolchain
// install: the earliest possible place the split can be refused is the one right after the tree appears.
//
// WHY IT CANNOT ASK THE SUSPECT. The binary this lane would normally use is the one built FROM THIS TREE,
// so a check that ran it to validate this tree would have the accused vouch for itself -- and when the
// tree predates the instruction, that binary predates it too. So the comparison is done by the runner's
// own awk over the committed file, and the only thing this step trusts is the env literal GitHub injected
// from the workflow it actually executed.
//
// WHY THAT AWK IS SOUND, AND WHERE ITS EDGE IS. It matches the stamp key ONLY inside the TOP-LEVEL env
// block -- the block at column zero, with the key at two-space indent -- so an indented step-level `env:`
// and a command body that mentions the key cannot both answer for it. That mirrors the structural, never
// substring, law of gunbc.required_ci_epoch_observation, and gunbc.witness.compiler_gate_contract_stamp
// claims bind the same four arms over the same document through the yaml ingest. THE HONEST EDGE: this is
// a line match, not a YAML parse, and the two readers could in principle disagree about a document neither
// the emitter produces. What that could cost is examined where the arms are consumed -- a false PRESENT
// still refuses unless the value matches, and the only direction that could spare a stale tree is a false
// ABSENCE, which this file shape cannot produce for a tree that was generated with a stamp at all.
data compiler_gate_contract_stamp_step_name: String = "Refuse a subject older than the instruction running it"

fn compiler_gate_contract_stamp_awk_program() -> String {
  // THE COUNTER IS INITIALISED IN A BEGIN BLOCK, NOT AS A BARE RULE. `in_env = 0` on its own is a
  // PATTERNLESS RULE, which awk runs for EVERY input line -- so it resets the flag on every line and the
  // stamp is never found. The fold model over the ingested document cannot show this, because there is no
  // per-line semantics there to get wrong; it surfaced only by running the emitted program against a file
  // that SHOULD have matched and watching it exit 3.
  //
  // RULES ARE SEPARATED BY NEWLINES, NOT SEMICOLONS. mawk -- which is /usr/bin/awk on the fleet's
  // ubuntu arm64 runners -- refuses several semicolon-separated `if` rules on one line with
  // "syntax error at or near if". The failure mode of getting this wrong is the loud kind on a runner
  // (awk exits non-zero, so the step refuses as StampAbsent), but it refuses for the WRONG REASON, and a
  // gate that reports "your tree predates the instruction" when its own awk is broken is a gate nobody
  // can trust the next time it fires. The fold is therefore exercised against the real interpreter in
  // test.claim.witness.compiler_gate_contract_stamp, not only modelled.
  //
  // IT CARRIES NO SINGLE QUOTE, because the shell assigns it in single quotes; a quote inside would
  // close the quoting and let the remainder of the line be re-parsed. Trimming is done by DELETING
  // non-hex characters rather than by matching quote characters, which both keeps it quote-free and is
  // strictly stronger for a value that must be a content hash.
  join(
    [
      "\nBEGIN { in_env = 0 }\n",
      "$0 ~ /^env:[[:space:]]*$/ { in_env = 1; next }\n",
      "in_env && $0 ~ /^[^[:space:]]/ { in_env = 0 }\n",
      "in_env && index($0, \"  \" key \": \") == 1 {\n",
      "  v = substr($0, index($0, \": \") + 2)\n",
      "  gsub(/[^0-9a-f]/, \"\", v)\n",
      "  if (length(v) > 0) { print v; found = 1; exit }\n",
      "  exit 3\n",
      "}\n",
      "END { if (!found) exit 3 }\n"
    ],
    ""
  )
}

// THE GUARD IS A NODE TREE, NOT A STRING. Manager ruling on review 82001: "build the step as
// nodes, not strings ... use that same route for the guard so no shell syntax is hand-joined.
// Inside the awk program, it is acceptable if it is a single typed argument rather than spliced
// text." So every STATEMENT here -- both tests, every printf, every exit, the two assignments --
// is built through v2.extdeps.languages.bash_build and rendered by v2.workflow.bash_emit, which
// is the route the memory guard at gunbc.instruments.instrument_dispatch_workflow and the
// toolchain isolation carrier at v2.workflow.ci_workflow_run_emit already take. No line of shell
// in this file is concatenated from string literals any more.
//
// THE ONE STRING THAT REMAINS IS THE AWK PROGRAM, and it is a single typed argument to one
// command word, exactly as the ruling permits. It stays a string on purpose: it is a program in
// ANOTHER LANGUAGE, and bash_build has no node kind for an awk rule. Modelling it as bash nodes
// would be the worse lie -- a bash tree cannot express `$0 ~ /^env:/`, so the attempt would
// produce a node that claims to mean something it does not. Its correctness is instead pinned
// two ways: the witness runs it against the real interpreter, and the fold in
// compiler_gate_stamp_from_entry is checked to agree with it on the same fixtures.
//
// WHY THE CAPTURE CHANGED SHAPE, which is the one place the conversion is not a re-spelling.
// It used to read `if ! STAMP_TREE=$(awk ...)`, and the serializer cannot build that:
// bash_fold_serialize_negation_inner admits or_else, and_then, pipe and a nested negation, and an
// ASSIGNMENT IS NOT AMONG THEM -- so the `!` form has no node representation at all. It is
// replaced by capture-with-`|| true` (an or_else node, which IS admitted, inside a cmdsubst
// word) followed by `[ -z "$STAMP_TREE" ]`. Those are the same test, and not by approximation:
// the program prints the stamp if and only if it exits 0 (the `print v` and the `exit` are the
// same statement, and every failure path reaches `exit 3` without printing), so "the capture
// failed" and "the capture printed nothing" pick out exactly the same runs. That equivalence is
// what makes the swap a refactoring rather than a behaviour change, and it is the property the
// executed RED re-checks after regeneration, not a claim made here.
//
// THE `-e` CONSTRAINT SURVIVES THE SWAP. GitHub's default run shell is `bash -e {0}`, under
// which a bare `VAR=$(failing cmd)` aborts the STEP at that line -- so the old form's `if !`
// existed to stop the run dying with a bare exit 1 and no diagnostic. `|| true` inside the
// command substitution discharges the same obligation: the assignment's status is true, so the
// step continues and the `[ -z ]` arm prints the typed refusal. Both forms were verified by
// running them under `bash -e -o pipefail`, which is the only way to tell them apart.
fn compiler_gate_contract_stamp_guard_statements() -> List<Node> {
  [
    bash_build_assign(
      name: "STAMP_RUNNING",
      // The GitHub expression is ONE literal word. The serializer leaves a literal alone inside
      // its single quotes, so Actions still expands it at run time -- the same route the fleet's
      // other node-built carriers take for expressions.
      value: bash_build_word_lit(text: concat(concat("${{ env.", compiler_gate_contract_stamp_env_key), " }}"))
    ),
    // NO LEVER TO SOFTEN THIS. continue-on-error, ::warning:: and any inputs./env.GUNBC_ALLOW
    // read are refused by the witness below; the node grammar has no warning arm to reach for.
    bash_build_if_from_stmts(
      cond: bash_build_test_bracket(words: [bash_build_word_lit(text: "-z"), bash_build_word_var(name: "STAMP_RUNNING")]),
      then_stmts: [
        compiler_gate_contract_stamp_print_line(compiler_gate_contract_stamp_refusal_parts_no_env()),
        bash_build_exit(code: "1")
      ]
    ),
    bash_build_assign(
      name: "AWK_PROG",
      value: bash_build_word_lit(text: compiler_gate_contract_stamp_awk_program())
    ),
    bash_build_assign(
      name: "STAMP_TREE",
      value: bash_build_word_cmdsubst(
        body: bash_build_or_else(
          left: bash_build_command_with_words(
            words: [
              bash_build_word_lit(text: "awk"),
              // TWO WORDS, NOT ONE. `awk -v key=NAME` is one option and its argument, and the
              // serializer quotes each word SEPARATELY, so a single concat word renders as
              // '-v key=' 'GUNBC_...' -- two argv entries whose first has a TRAILING SPACE. mawk
              // then reads the lvalue as " key" and dies: `awk: improper assignment: -v  key=...`.
              // The capture is empty, the -z arm fires, and the guard refuses a CORRECTLY STAMPED
              // tree with StampAbsent -- a gate blaming the branch for a fault in the gate, which
              // is the exact wrong-reason failure this module's own comments warn about. It was
              // caught only by running the positive control on the emitted bytes.
              bash_build_word_lit(text: "-v"),
              bash_build_word_lit(
                text: concat("key=", compiler_gate_contract_stamp_env_key)
              ),
              // The variable word renders as "$AWK_PROG" on its own: the double quotes are SHELL
              // SYNTAX the serializer supplies, not characters of the program text, and quoting the
              // substitution is what keeps the multi-line program ONE argument.
              bash_build_word_var(name: "AWK_PROG"),
              bash_build_word_lit(text: compiler_gate_contract_stamp_tree_file())
            ]
          ),
          right: bash_build_command_from_lits(lits: ["true"])
        )
      )
    ),
    bash_build_if_from_stmts(
      cond: bash_build_test_bracket(words: [bash_build_word_lit(text: "-z"), bash_build_word_var(name: "STAMP_TREE")]),
      then_stmts: [
        compiler_gate_contract_stamp_print_line(compiler_gate_contract_stamp_refusal_parts_absent()),
        bash_build_exit(code: "1")
      ]
    ),
    bash_build_if_from_stmts(
      cond: bash_build_test_bracket(
        words: [
          bash_build_word_var(name: "STAMP_TREE"),
          bash_build_word_lit(text: "!="),
          bash_build_word_var(name: "STAMP_RUNNING")
        ]
      ),
      then_stmts: [
        compiler_gate_contract_stamp_print_line(compiler_gate_contract_stamp_refusal_parts_mismatch()),
        bash_build_exit(code: "1")
      ]
    ),
    // THE PROCEEDING PATH SAYS SO. Silence and agreement used to be indistinguishable in the log,
    // which is how the silent arm got green four times; the positive control's own line is the
    // difference between "the guard ran and agreed" and "the guard did not run".
    bash_build_command_with_words(
      words: [
        bash_build_word_lit(text: "printf"),
        bash_build_word_lit(text: "gunbc contract stamp: paired running=%s tree=%s\\n"),
        bash_build_word_concat_from_nodes(parts: [bash_build_word_var(name: "STAMP_RUNNING")]),
        bash_build_word_concat_from_nodes(parts: [bash_build_word_var(name: "STAMP_TREE")])
      ]
    )
  ]
}

// THE PATH, as a node literal word -- one value used by BOTH the awk argument and the
// StampAbsent message, so the file the guard reads and the file it names cannot drift apart.
fn compiler_gate_contract_stamp_tree_file() -> String {
  compiler_gate_contract_stamp_workflow_path() as String
}

// ONE printf PER REFUSAL, as a node: `printf '%s\n' <one word>`. The format and the message are
// separate WORDS, so the message cannot be re-parsed as a format; each refusal is its own word
// built from literal and variable PARTS, which is how a stamp value reaches the message without
// any unquoted expansion of a tree-influenced value anywhere in the step.
fn compiler_gate_contract_stamp_print_line(parts: List<Node>) -> Node {
  bash_build_command_with_words(
    words: [
      bash_build_word_lit(text: "printf"),
      bash_build_word_lit(text: "%s\\n"),
      bash_build_word_concat_from_nodes(parts: parts)
    ]
  )
}

// THE REFUSAL MESSAGES AS NODE PARTS, not as quoted strings. A literal part is emitted
// single-quoted by the serializer and a variable part as "$NAME", and the parts concatenate into
// ONE word -- so the shell interpolates the two stamps and nothing else, and no message can gain
// an unquoted expansion by accident. These are the strings the witness pins, so a rewording that
// drops a stamp, the remedy, or the verdict name leaves it red.
fn compiler_gate_contract_stamp_refusal_parts_no_env() -> List<Node> {
  [
    bash_build_word_lit(text: "REFUSED gunbc contract stamp: StampUnreadable \{the executing workflow carries no "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_env_key),
    bash_build_word_lit(text: " in its environment, so it was not generated with an invocation contract. "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_provenance),
    bash_build_word_lit(text: ". Remedy: merge origin/main into this branch.")
  ]
}

fn compiler_gate_contract_stamp_refusal_parts_absent() -> List<Node> {
  [
    bash_build_word_lit(text: "REFUSED gunbc contract stamp: StampAbsent. The checked-out subject declares no readable "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_env_key),
    bash_build_word_lit(text: " at "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_tree_file()),
    bash_build_word_lit(text: ", so its workflow predates the instruction this job is executing. "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_provenance),
    bash_build_word_lit(text: ". Remedy: merge origin/main into this branch.")
  ]
}

fn compiler_gate_contract_stamp_refusal_parts_mismatch() -> List<Node> {
  [
    bash_build_word_lit(text: "REFUSED gunbc contract stamp: StampMismatch \{running="),
    bash_build_word_var(name: "STAMP_RUNNING"),
    bash_build_word_lit(text: ", tree="),
    bash_build_word_var(name: "STAMP_TREE"),
    bash_build_word_lit(text: "}. The workflow executing was generated from a DIFFERENT revision than the tree it is judging: the instruction came from the merge ref, and the "),
    bash_build_word_lit(text: compiler_gate_contract_stamp_provenance),
    bash_build_word_lit(text: "-stamped workflow committed in the checked-out tree says otherwise. Remedy: merge origin/main into this branch so the tree carries the instruction being run.")
  ]
}

// WHY THE TREE SIDE IS READ BY THE RUNNER AND NOT BY A TYPED READER -- asked directly in review
// 82001 ("the step scans the YAML with awk, a grep standing in for a parse"), and the answer is
// STRUCTURAL, not convenience. A typed reader DOES EXIST: compiler_gate_contract_stamp_read_from
// parses with ingest_yaml_source into YamlValue and refuses with a located CompilerGateContractStampReading,
// and it is what the witness runs. It cannot be what the guard runs, for two reasons that are the
// same reason:
//
//   1. THE GUARD RUNS BEFORE ANY BINARY EXISTS. It sits at index 1 of the job, immediately after the
//      fleet checkout and before toolchain_home_isolation_step, which is before the first step that
//      invokes the subject. Its whole job is to decide whether that binary may be built at all. A
//      typed reader would have to be built first, which inverts the order the guard exists to enforce.
//   2. THE ONLY BINARY THAT COULD READ THE TREE IS THE SUSPECT'S OWN. The single gunbc available at
//      that moment is one built FROM THE CHECKED-OUT TREE -- the very artifact whose provenance the
//      guard is testing. Asking it to certify its own tree is the circularity the class row records
//      (gunbc.recurring_failure_mode.instruction_and_subject_resolved_from_different_revisions): the
//      instruction and the subject resolved from different revisions is precisely the state in which
//      you cannot trust a subject-side reader to report the tree honestly.
//
// AND THE HEAD UNDER SUSPICION CANNOT EVEN CARRY THE READER. The four measured silent-green heads
// (39066871919, 39067193189, 39067690307, 39069382384) predate this module; a pre-stamp head has no
// compiler_gate_contract_stamp.dag to compile, so a guard that depends on a tree-side reader is a
// guard that is absent exactly when it is needed. That is a fail-open in the shape of a fix.
//
// So a pre-build read of a committed workflow member, performed by code that is NOT the tree's, is
// structurally necessary here. What is NOT necessary is the medium, which is why the scaffold below
// carries a dissolution obligation and why the awk program is one typed string argument rather than
// spliced text: it is a value passed to a command node, not shell syntax joined from strings.
//
// The scan's edges are stated rather than assumed, and the witness pins them: the awk program is a
// BEGIN-only program (no implicit per-line rule), it accepts the stamp only from a mapping key at
// column zero whose name is exactly the env key, directly under a column-zero `env:` -- so a step-level
// env of the same name cannot satisfy the read -- it strips non-hex characters before length/charset
// validation, and it prints if and only if it exits 0, with EVERY failure path reaching exit 3 and END
// exiting 3 unless a stamp was found. Reading it as a grep standing in for a parse would be right if
// it accepted a match anywhere in the document; it does not, and the controls prove the difference
// (a step-level env of the right shape reads StampAbsent, not StampPresent).
//
// DISSOLUTION: THE TRIGGER IS A CAPABILITY, NOT A FILE OR A DATE. This carrier exists because
// nothing at run time can read the tree's own workflow stamp without executing tree code, and
// the thing under suspicion is the tree. It dissolves the day a pre-build reader of that stamp
// exists that does NOT run tree code -- GitHub's own `workflow_sha` on the check run, or a
// runner-side typed reader for a committed workflow member. Naming a capability is what makes
// the obligation closable; naming a date or a path would let it sit marked forever.
data compiler_gate_contract_stamp_shell_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.witness.compiler_gate_contract_stamp",
    decl_name: "compiler_gate_contract_stamp_guard_statements",
    field: WholeDeclaration
  }
}

data compiler_gate_contract_stamp_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: compiler_gate_contract_stamp_guard_statements -- bash-node carrier that reads the tree's own committed workflow stamp BEFORE any binary is built and refuses a subject older than the instruction running it; dissolves when a pre-build reader of a committed workflow member exists that does not run tree code (GitHub's own workflow_sha on the check run, or a runner-side typed reader). The awk program remains a single typed string argument until an awk-rule node grammar lands.")

// THE SCRIPT, rendered from the tree. Poison on rejection rather than a silent empty run: an
// empty run body is a step that passes, and a passing step that checks nothing is precisely the
// silent green this module was written to end. The gate predicate below is what keeps poison out
// of a committed artifact; the poison string is what makes a rejection LOUD if the gate is ever
// bypassed by a caller that forgets it.
data compiler_gate_contract_stamp_emit_refused_poison: String = "__GUNBC_ORCH_EMIT_REFUSED__ gunbc contract stamp guard emission was rejected by v2.workflow.bash_emit"

fn compiler_gate_contract_stamp_guard_script_outcome() -> Outcome<String> {
  match bash_emit_stmts(statements: compiler_gate_contract_stamp_guard_statements(), set_e: false) {
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
    Accepted { value: body, diagnostics: ds } =>
      Accepted {
        value: concat(compiler_gate_contract_stamp_marker_line(), body),
        diagnostics: ds
      }
  }
}

// THE MARKER, on the first line of the emitted script, in the same form the fleet's other
// shell carriers use: "# " followed by the dissolution description, which already begins
// "dissolve-on:". It is a COMMENT so it costs the runner nothing and cannot change behaviour.
fn compiler_gate_contract_stamp_marker_line() -> String {
  concat("# ", concat(dissolution_description(condition: compiler_gate_contract_stamp_shell_emit_dissolution_trigger), "\n"))
}

// THE GATE PREDICATE the workflow generator consults before it will emit the step. It is a
// sibling of compiler_gate_contract_stamp_is_derived() and it fails closed: a node tree the
// serializer refuses stops the whole workflow from generating, rather than emitting a step that
// would silently check nothing.
fn compiler_gate_contract_stamp_guard_script_is_renderable() -> Bool {
  match compiler_gate_contract_stamp_guard_script_outcome() {
    Accepted { value: script, diagnostics: _ } =>
      // THE MARKER AND THE REFUSALS SURVIVE RENDERING. Checked here, in the path that produces
      // the committed artifact, and not only in the witness: a marker that a later refactor
      // drops would otherwise reopen exactly the unmarked-runner defect review 82001 named.
      !string_contains(s: script, pattern: compiler_gate_contract_stamp_emit_refused_poison)
        && string_contains(s: script, pattern: "dissolve-on: ")
        && string_contains(s: script, pattern: "exit 1")
    Rejected { diagnostics: _ } => false
  }
}

fn compiler_gate_contract_stamp_guard_script() -> String {
  match compiler_gate_contract_stamp_guard_script_outcome() {
    Accepted { value: script, diagnostics: _ } => script
    Rejected { diagnostics: _ } => compiler_gate_contract_stamp_emit_refused_poison
  }
}


fn compiler_gate_contract_stamp_guard_step() -> Step {
  RunStep {
    name: Present { value: compiler_gate_contract_stamp_step_name },
    id: none,
    run: compiler_gate_contract_stamp_guard_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}
