// THE EPOCH TRAVELS IN THESE BYTES. gunbc.required_ci_epoch_observation parses
// GUNBC_REQUIRED_CI_CONTRACT_EPOCH structurally out of .github/workflows/witnesses.yml AT THE
// TRIGGERING COMMIT -- the bytes GitHub executed -- so the judging side does not author what it
// requires, and gunbc.fleet_revision_acceptance will not advance the fleet's desired state without
// it. witnesses.yml lost the member at 85c1356300c and fleet-desired has refused every push to main
// since (8 runs, 2026-09-19T23:50Z onward) with RequiredCiEpochAbsent, against 52 consecutive
// greens before it.
import gunbc.required_ci_contract_epoch { required_ci_contract_epoch, required_ci_contract_epoch_env_key }

// THE HOSTED BUILD PRELUDE. It was the `compiler` lane's whole job until the 2026-09-28 ruling deleted
// that lane (see the header); gunbc.instrument_dispatch_workflow still builds `gunbc` on a hosted
// runner through it, so the prelude outlived the lane that named it. emit-build left it on
// 2026-10-02 for the fleet prelude over the same bins.
data compiler_gate_required_bins: List<String> = ["gunbc"]
data compiler_gate_build_step_name: String = "Build the compiler"

fn compiler_gate_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present { value: [kv(key: "persist-credentials", value: yaml_bool(b: false))] },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

type CompilerGateBoundStep {
  step: Step
  role: StepCapabilityRole
  step_name: String
}

fn compiler_gate_hosted_build_prelude_bound_steps() -> List<CompilerGateBoundStep> {
  [
    CompilerGateBoundStep {
      step: compiler_gate_checkout_step(),
      role: capability_neutral,
      step_name: "Checkout",
    },
    CompilerGateBoundStep {
      step: toolchain_home_isolation_step(),
      role: capability_neutral,
      step_name: "Isolate toolchain homes",
    },
    CompilerGateBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    CompilerGateBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
    CompilerGateBoundStep {
      step: witness_floor_build_step(
        step_name: compiler_gate_build_step_name,
        build_script: repo_self_build_command(bins: compiler_gate_required_bins),
      ),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: compiler_gate_build_step_name,
    },
  ]
}

// THE LINT IS A STEP ON `generated`, NOT A JOB OF ITS OWN (operator ruling 2026-09-28).
//
// It ran as rust_clippy_all_targets_step inside required-witnesses-build, then -- once that job was
// gone and nothing had inherited the step, leaving lint over every target ungated while
// gunbc.contributor_onboarding_path told a contributor it is "a merge is blocked on" -- as a hosted
// `clippy` job, because a wall that no step executes is a decoration (DESIGN 4b). The claim is
// unchanged: the workspace is lint-clean over every target, and `cargo clippy --all-targets` is the
// only command that compiles the integration-test and example targets, so a red there is invisible
// to every other step.
//
// WHAT THE SEPARATE JOB BOUGHT, AND WHAT KEEPS IT NOW. The job kept "the workspace compiles" and "the
// workspace is lint-clean" apart, so a reader saw which failed and one red could not hide the
// other. On `generated` the lint keeps its own step, name and id, and its condition is the status
// guard alone: a red build step cannot skip it and a red lint cannot skip the steps after it, so both
// reds still reach the log under their own names. What the job cost was a checkout, a toolchain
// install and a wait for a hosted slot on every run, to run a step that finishes in about a minute
// (the `Lint every target` step timings of merge-queue runs 36478070174 and 36464765845). It sits
// on `generated` rather than `floor` because `generated` is the shorter fleet lane, so the step
// lands off the run's critical path.
data compiler_gate_clippy_step_name: String = "Lint every target"
data compiler_gate_lint_step_id: String = "lint_all_targets"

fn compiler_gate_lint_step() -> Step {
  RunStep {
    name: Present { value: compiler_gate_clippy_step_name },
    id: Present { value: compiler_gate_lint_step_id },
    run: concat(wrap_command_with_floor_attempt_receipt(command: repo_self_clippy_command()), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: witness_step_status_guard_expression() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE v1 UNIT TESTS ARE A BLOCKING FLEET LANE (2026-09-30, restoring the lane the 2026-09-29 ruling
// deleted, in the shape that ruling named). The history: a non-required step on the hosted `clippy`
// job (2026-09-27), its own non-blocking hosted lane (2026-09-28), deleted because continue_on_error
// made its red unreadable (2026-09-29). It returns without continue_on_error, on the fleet, with the
// aggregate reading it, so a unit-test red refuses the required context; the restoration retires
// gunbc.rung_drop rust_unit_tests_off_the_merge_path in the same change.
//
// THE FLEET COST IS THE PRICE THE OLDER REASONING DECLINED, AND IT IS NOW PAID DELIBERATELY. The
// 2026-09-28 reasoning kept the step off the fleet because a fleet slot would pay its wall on every
// push for a verdict nothing required. The verdict is now required, so the wall buys a gate; and the
// lane runs BESIDE `floor` and `generated` (needs: []), so it adds slot-minutes but no critical-path
// minutes unless it is the longest lane.
//
// THE BOUND IS REAL, NOT DECLARED, AND ON THE FLEET IT IS THE SLOT'S OWN. The regeneration-host tests
// read their budget through gunbc.host_budget_source and refuse HostBudgetUnreadable where no cgroup
// binds the process. GUNBC_MEMORY_BUDGET_BYTES would be the escape hatch that refusal exists to
// refuse. On the hosted runner the step bound itself with sudo (gunbc.ci_spec
// hosted_runner_memory_cgroup_bind_commands); on a fleet host that bind is unsound, because the slots
// share one cgroup tree and a sudo write to the root subtree_control reaches every slot. It is also
// unneeded: every fleet slot is a systemd unit whose MemoryMax is gunbc.fleet_host_budget
// gunbc_per_runner_memory_cap, the runner starts the step inside that unit's cgroup, and the v1
// governor's leaf-to-root walk (memory_governor binding_cap_cgroup_dir) reads it. So the step runs the
// test command bare, and a slot that lost its MemoryMax turns the regeneration-host tests red with a
// typed refusal rather than passing on a fabricated budget.
data compiler_gate_unit_test_step_name: String = "Run the v1 unit tests"
data compiler_gate_unit_test_step_id: String = "rust_unit_tests"
// THE UNIT STEP CARRIES ITS OWN CAP, AND THE JOB CAP IS DERIVED FROM IT, SO THE STEP ENDS INSIDE THE
// JOB BY CONSTRUCTION. THE RULE, stated so the literal can be re-derived rather than trusted: the step
// cap is the largest observed step wall on the fleet runner class, times 1.5, rounded up to the next
// 5 minutes. Headroom is multiplicative because the wall scales with the test population and with
// slot contention, and a required lane whose cap is hit reads as a red that says nothing about the
// diff. The observed walls are those of the rust_unit_tests step in this lane's own fleet runs (the
// first, witnesses run 36676083674 on srv4, is the current maximum), plus the hosted population
// silent-koi-310 tabulated, which sits below it; re-read them there and re-derive when a fleet wall
// exceeds two thirds of the cap.
fn compiler_gate_unit_test_timeout() -> Minute {
  minute(count: 40)
}

// Checkout, toolchain-home isolation and the toolchain install run before the unit step; the step
// itself compiles the test binary, so this reserve covers only the prelude.
fn compiler_gate_unit_test_pre_step_reserve() -> Minute {
  minute(count: 10)
}

fn compiler_gate_unit_test_job_timeout() -> Minute {
  minute(count: minute_count(compiler_gate_unit_test_timeout()) + minute_count(compiler_gate_unit_test_pre_step_reserve()))
}

fn compiler_gate_unit_test_command() -> String {
  repo_self_test_command()
}

fn compiler_gate_unit_test_step() -> Step {
  RunStep {
    name: Present { value: compiler_gate_unit_test_step_name },
    id: Present { value: compiler_gate_unit_test_step_id },
    run: concat(wrap_command_with_floor_attempt_receipt(command: compiler_gate_unit_test_command()), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: minute_count(compiler_gate_unit_test_timeout()) }
  }
}

data compiler_gate_unit_test_job_id: String = "rust-unit-tests"

fn compiler_gate_unit_test_bound_steps() -> List<CompilerGateBoundStep> {
  [
    CompilerGateBoundStep {
      step: compiler_gate_checkout_step(),
      role: capability_neutral,
      step_name: "Checkout",
    },
    CompilerGateBoundStep {
      step: toolchain_home_isolation_step(),
      role: capability_neutral,
      step_name: "Isolate toolchain homes",
    },
    CompilerGateBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    CompilerGateBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
    CompilerGateBoundStep {
      step: compiler_gate_unit_test_step(),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: compiler_gate_unit_test_step_name,
    },
  ]
}

fn compiler_gate_unit_test_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: compiler_gate_unit_test_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

fn compiler_gate_unit_test_job() -> Job {
  Job {
    id: compiler_gate_unit_test_job_id,
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    environment: none,
    steps: list_map(xs: compiler_gate_unit_test_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: none,
    outputs: none,
    if_condition: Present { value: compiler_gate_floor_job_condition() },
    timeout_minutes: Present { value: minute_count(compiler_gate_unit_test_job_timeout()) },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: compiler_gate_permissions }
  }
}

data compiler_gate_permissions: WorkflowPermissions = WorkflowPermissions {
  contents: Present { value: PermRead },
  pull_requests: none,
  issues: none,
  actions: none,
  id_token: none
}

// THE REQUIRED STATUS MUST READ EVERY LANE, OR A LANE IS MERELY WAITED ON.
//
// The repository ruleset requires ONE status, `witnesses`. A lane that publishes its own status
// beside it is not a gate: when the compiler lane is green and clippy is red, the required status
// is still green and the pull request still merges. The first cut of the clippy job did exactly
// that -- it restored an executing step and left the wall unbuilt, which is the decoration DESIGN
// section 4b names, arriving one level up from the missing check.
//
// So `witnesses` is the AGGREGATOR and the lanes run beneath it. It needs both, runs always() so a
// failed lane cannot skip the verdict, and reads each lane's own result rather than inferring one
// from its own success. This is the shape the workflow carried before #11742 collapsed it to a
// single job, and the reason is unchanged: the aggregating job carries the required context and
// reads BOTH lane results -- that last is what makes a lane block rather than merely be waited on.
//
// The ruleset is not the place to fix this. It lives outside the repository, so requiring a second
// status there would put a merge-blocking fact where the model cannot see it or regenerate it.
//
// A lane that did not conclude success is a refusal, including skipped and cancelled, and the
// verdict distinguishes a RED lane from one that produced NO CONCLUSION: those are different facts
// and only the first is a statement about the diff.

// ═══════════════════════════════════════════════════════════════════════════
// THE FLEET LANE. The hosted lane above runs the unit tests, which a 16 GB runner can do; the work
// below cannot run there at all. Measured 2026-09-19: the witnesses fold peaks at 20.2 GiB and the
// generated-artifact pass at 12.9 GiB, against 16 GB on a standard hosted runner, and the fold's
// memory barely moves with the roster because discovery reads the whole corpus (6,182 sources,
// 21,240 rows) whatever the roster selects. So this lane runs on the fleet, where a slot carries
// 26 GiB.
//
// WHAT IT IS FOR, stated because a build-only gate already cost this repository three things in one
// night: witnesses.yml lost the contract epoch and fleet-desired refused eight pushes; two typecheck
// errors landed that regeneration refuses; and three generated artifacts drifted unobserved. A gate
// that builds and lints cannot see any of them. This lane restores the two verdicts that can: the
// claims, and whether the committed generated artifacts match their authorities.
//
// THE DRIFT GATE IS THE MERGE BLOCKER, and the repair runs only where it refused, so an ordinary
// push pays the gate once (6.3 min) and skips the repair's three invocations (16 min) entirely --
// where heal paid all four on every push.
data compiler_gate_floor_job_id: String = "floor"
data compiler_gate_floor_timeout_minutes: Int = 90
data compiler_gate_floor_build_step_name: String = "Build the compiler and the witness executor"
data compiler_gate_drift_step_id: String = "generated_artifact_gate"
data compiler_gate_repair_declaration_step_id: String = "repair_declaration"
data compiler_gate_repair_regen_step_id: String = "repair_regen"
data compiler_gate_candidate_step_id: String = "repair_candidate"
data compiler_gate_candidate_retention_days: Int = 3

// FORK CODE DOES NOT RUN ON THE FLEET. heal carried these clauses and this lane took heal's work,
// and the checkout below is an attacker-authored head sha on a runner that persists between jobs.
// The guard is scoped to pull_request events: merge_group and workflow_dispatch carry no
// pull_request context, so unscoped clauses would read null and SKIP this lane -- and a skipped
// required lane never reports, which stalls the merge queue for good. The repository's Actions
// policy already requires approval for all external contributors; this is the second wall.
fn compiler_gate_floor_job_condition() -> String {
  join(["github.event_name != 'pull_request' || ", heal_same_repository_clause], "")
}

// DEPENDABOT IS DECLINED BY THE REPAIR, NOT BY THE LANE, and the distinction is a deadlock this
// nearly shipped with. heal excluded dependabot because heal PUSHES to the head branch, which is
// dependabot's to manage; the FOLD and the drift gate push nothing, and a dependabot pull request
// that merges without them is exactly the unobserved head this lane exists to prevent. Skipping the
// whole lane would also have hung those pull requests forever: dependabot's head repository IS this
// repository, so the aggregator's fork carve-out below does not cover it and it would reach the
// error branch on a lane that never ran.
fn compiler_gate_repair_actor_clause() -> String {
  concat(" && ", heal_not_dependabot_clause)
}

// The candidate must describe the pull request head, not the merge result, or a repair would carry
// main's content into the branch. On merge_group and dispatch the expression is empty and checkout
// falls back to the triggering ref.
fn compiler_gate_floor_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout the commit this lane judges" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        checkout_ref_entry(ref_expression: compiler_gate_checkout_ref),
        kv(key: "persist-credentials", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THIS STEP DOES NOT REFUSE THE LANE, AND THE SENTENCE THAT SAID IT DID WAS FALSE. Its run is
// witness_floor_run_script, which passes --measurement-receipt; under that flag claim_executor
// writes every blocker into the receipt and returns success (a completed measurement carrying
// blockers is a fact to adjudicate, not a process failure -- that is what keeps a refused floor
// and a killed runner distinct). The verdict is the D0-ADJUDICATE step bound after it, exactly as
// gunbc.witness_floor_workflow binds it. Measured before that step was bound here (PR #11821, run
// 35497139573): the log read 'floor refused ... phases_run=2 phases_failed=2', no claim ran, and
// the lane concluded success -- a required gate green over a refusal, DESIGN section 5's hard-reject
// arm. Every floor success between #11742 and the landing of the bundle below is unverified.
fn compiler_gate_floor_run_step() -> Step {
  RunStep {
    name: Present { value: "Nominal witnesses (one prepared subject, one fold)" },
    id: Present { value: "required_ci_measure" },
    run: concat(wrap_command_with_floor_attempt_receipt(command: witness_floor_run_script()), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: witness_floor_precondition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE STEP NAME STATES ITS POPULATION, AND THE POPULATION IS NARROWER THAN "GENERATED ARTIFACTS".
// generated_artifact_gate main reads gunbc.generated_artifact_registry committed_generated_artifacts only. The
// ~157 stage0 mirrors (src/v1/stage0/src/std_measure.rs and the rest of the compile_stage0 emitted
// population) are adjudicated by claim_executor's GeneratedArtifact phase, which routes to
// --required-lane build, and no job has invoked that lane since #11742. The earlier name,
// "Generated artifacts match their authorities", stayed GREEN over that gap and read as a statement
// about stage0; std_measure.rs drifted on main under it (gunbc#12067). Declared drop:
// gunbc.rung_drop.witness_floor_off_the_required_gate. Row:
// gunbc.recurring_failure_mode.generated_population_split_across_two_unjoined_rosters.
//
// WHERE THE STAGE0 PHASES MAY RUN, measured rather than assumed: the floor process peaks AT its
// slot's memory.high (run 35716368507: peak 26847006720 against high 26843545600, high events
// 1109), and the generated-artifact pass peaks near 12.9 GiB. They never share one process, and
// since the 2026-09-27 ruling they do not share one slot either: this step and the stage0 step run
// on compiler_gate_generated_job, beside the floor rather than after it.
//
// A DISCRIMINATOR FOR THE REPAIR, NOT A SECOND VERDICT (operator ruling 2026-09-28). The build lane's
// GeneratedArtifact phase adjudicates this step's population -- the same gunbc.generated_artifact
// registry (committed_generated_artifacts, read through the seed's boundary host) -- beside the
// stage0 mirrors, which is why this step was already kept off the merge queue: there it would be a
// second verdict on one population at one revision (DESIGN section 2). Since the 2026-09-28 ruling
// the lane runs on every event (compiler_gate_stage0_regen_condition), so the same argument reaches
// pull_request and workflow_dispatch. What keeps this step alive is its one consumer: the repair
// chain is bound to it, because a repair candidate describes a pull request head and regenerates the
// registry population only, so it must know whether THAT population drifted -- which the lane's
// refusal does not say. So the step runs only after the lane refused, and a green lane pays nothing
// for it. It follows the lane in the job for that reason; on the merge queue it still never runs,
// because no repair is produced there.
fn compiler_gate_drift_condition() -> String {
  join([
    witness_step_status_guard(),
    "github.event_name != '", github_event_name_merge_group, "' && ",
    "steps.build_witness_fold.outcome == 'success' && ",
    "steps.", compiler_gate_stage0_regen_step_id, ".outcome == 'failure'"
  ], "")
}

data compiler_gate_drift_step_name: String = "Registry-rostered generated artifacts (gunbc.generated_artifact): which drifted, run only after the build lane refused, to decide whether the repair applies"

fn compiler_gate_drift_step() -> Step {
  RunStep {
    name: Present { value: compiler_gate_drift_step_name },
    id: Present { value: compiler_gate_drift_step_id },
    run: concat(gunbc_ci_generated_artifact_verify_invoke(), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: compiler_gate_drift_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE STAGE0 MIRRORS ARE CHECKED ON EVERY EVENT, ONE GENERATION DEEP. Operator decision
// msg_6e36a6a2 (2026-09-23) put this step on the merge queue at two generations, superseding
// msg_4a9045fc's generation-1-only ruling; operator ruling 2026-09-28 widened its events (below);
// operator ruling 2026-10-04 ("we don't need to run multiple times - we are not that particular
// about determinism in v1 anymore") cut it back to one generation.
//
// WHAT THE STEP ASSERTS, in one sentence: the committed mirrors equal ONE emission of the current
// .dag sources by the seed built from those committed mirrors. The ruling waives DETERMINISM, which
// is all the deleted second generation could see -- it re-emitted with the same binary. It does
// not waive CONVERGENCE, and the one-generation assertion still holds it: the seed this lane runs
// is built from the committed mirrors, so mirrors emitted by a binary that predates a change to the
// emitter's own closure (infer, emit_rust) do not equal what this seed emits, and the step refuses.
// An author changing that closure therefore still owes a second ROUND (rebuild from the installed
// mirrors, emit again) before the step admits; an author changing anything else owes one.
// The drift step above reads gunbc.generated_artifact alone; the ~158 compile_stage0 mirrors are
// adjudicated by claim_executor's build lane -- the GeneratedArtifact phase -- and no job had run
// that lane since #11742, so std_measure.rs drifted onto main under a green required run
// (gunbc#12067) and more mirrors had drifted by the time this step first executed.
//
// THE LANE'S OWN COMMAND, so which phases run is still decided by the binary's exhaustive
// partition (gunbc.witness_floor_workflow build_lane_run_script over gunbc.fabric_witness_run
// build_lane_run_command), never by this YAML. Measured on the fleet (run 35890770775, after
// #12100 removed the field-name re-export leak that had inflated generation 1 to 30 min): the
// whole lane, then two generations deep, took 22.5 min, and the floor job ~58 min against
// compiler_gate_floor_timeout_minutes.
//
// A STEP ON ITS OWN JOB, BESIDE THE FLOOR -- operator ruling 2026-09-27, which supersedes the
// earlier "a step on this job, not a new job" placement. That placement saved one checkout and
// build per queued landing and paid for it in latency: the lane ran after the witnesses fold and
// the drift gate, so a landing waited for the SUM of three independent verdicts (see
// compiler_gate_generated_job). The measured memory constraint -- the floor process peaks at its
// slot's memory.high (run 35716368507) and the stage0 pass near 12.9 GiB, so the two never fit
// additively -- is met by a separate slot as fully as by a later step.
//
// ON EVERY EVENT, BECAUSE A PULL REQUEST THAT FAILS IT STILL ENTERS THE QUEUE (operator ruling
// 2026-09-28). The merge_group-only placement reasoned that a pull request does not land, so the
// queue's run -- which judges the sha that becomes main -- is the one that must hold, and priced the
// cost as "an author learns of drift at queue time". Everyone else paid that price: under the
// ALLGREEN queue a failing entry fails every group built on top of it, and the queue learns of the
// red only when the required context concludes. #12412 and #12539 each passed their pull-request
// runs and then failed this step in the queue (merge-queue runs 36478072318 and 36492169928), and
// every group stacked on #12412 failed the same phase until it was ejected --
// gunbc.recurring_failure_mode required_verdict_placed_only_on_the_merge_queue. The step also runs on
// workflow_dispatch, whose remaining callers are manual runs judging a head, for the same reason.
// `!cancelled()` rather than the default success(): an earlier red step, such as the lint, must not
// disarm this check (see witness_floor_workflow's measured correction).
//
// gunbc.rung_drop.floor_cut_regen_second_generation_agreement STANDS, and since 2026-10-04 no
// required phase compares a second generation for any population.
data compiler_gate_stage0_regen_step_name: String = "Stage0 mirrors match one emission by this seed: required CI build lane"
data compiler_gate_stage0_regen_step_id: String = "stage0_regen"

// NO EVENT CLAUSE, which is the ruling rather than an omission: the step runs wherever the job does,
// under the same precondition the floor's run step carries (the status guard and a built seed).
fn compiler_gate_stage0_regen_condition() -> String {
  witness_floor_precondition()
}

fn compiler_gate_stage0_regen_step() -> Step {
  RunStep {
    name: Present { value: compiler_gate_stage0_regen_step_name },
    id: Present { value: compiler_gate_stage0_regen_step_id },
    run: concat(wrap_command_with_floor_attempt_receipt(command: build_lane_run_script()), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: compiler_gate_stage0_regen_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_repair_condition() -> String {
  concat(
    concat("failure() && steps.", concat(compiler_gate_drift_step_id, ".outcome == 'failure'")),
    compiler_gate_repair_actor_clause()
  )
}

fn compiler_gate_step_succeeded_clause(step_id: String) -> String {
  concat(" && steps.", concat(step_id, ".outcome == 'success'"))
}

// EVERY REPAIR LINK REQUIRES ITS PREDECESSOR. main_wet writes artifact by artifact, so a
// regeneration that refuses partway leaves a partially rewritten tree, and a declaration that
// refused leaves the candidate's ledger trailers unwritten. Either sealed and pushed is a repair
// nothing judged, and the publisher admits a failed producing run by design.
fn compiler_gate_regen_condition() -> String {
  concat(compiler_gate_repair_condition(),
    compiler_gate_step_succeeded_clause(step_id: compiler_gate_repair_declaration_step_id))
}

fn compiler_gate_seal_condition() -> String {
  concat(compiler_gate_regen_condition(),
    compiler_gate_step_succeeded_clause(step_id: compiler_gate_repair_regen_step_id))
}

fn compiler_gate_upload_condition() -> String {
  concat(compiler_gate_seal_condition(),
    compiler_gate_step_succeeded_clause(step_id: compiler_gate_candidate_step_id))
}

fn compiler_gate_repair_declaration_step() -> Step {
  RunStep {
    name: Present { value: "Declare which ledger rows this repair covers" },
    id: Present { value: compiler_gate_repair_declaration_step_id },
    run: gunbc_ci_heal_repair_declaration_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: compiler_gate_repair_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_regen_step() -> Step {
  RunStep {
    name: Present { value: "Regenerate every registry-rostered generated artifact (not the stage0 mirrors), then verify the tree it wrote" },
    id: Present { value: compiler_gate_repair_regen_step_id },
    run: concat(gunbc_ci_generated_artifact_regen_verified_invoke(), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: compiler_gate_regen_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_candidate_step() -> Step {
  RunStep {
    name: Present { value: "Produce the sealed repair candidate" },
    id: Present { value: compiler_gate_candidate_step_id },
    run: gunbc_ci_heal_candidate_invoke(),
    shell: none,
    env: Present {
      value: [
        kv(key: heal_candidate_repository_env as String, value: yaml_string(s: "${{ github.repository }}")),
        kv(key: heal_candidate_pull_number_env as String, value: yaml_string(s: "${{ github.event.pull_request.number }}")),
        kv(key: heal_candidate_head_ref_env as String, value: yaml_string(s: "${{ github.event.pull_request.head.ref }}")),
        kv(key: heal_candidate_base_ref_env as String, value: yaml_string(s: "${{ github.event.pull_request.base.ref }}")),
        kv(key: heal_candidate_run_id_env as String, value: yaml_string(s: "${{ github.run_id }}"))
      ]
    },
    working_directory: none,
    if_condition: Present { value: compiler_gate_seal_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_candidate_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload the sealed repair candidate" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: heal_repair_candidate_artifact_name as String)),
        kv(key: "path", value: yaml_string(s: heal_candidate_directory)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(key: "retention-days", value: yaml_int(n: compiler_gate_candidate_retention_days))
      ]
    },
    env: none,
    if_condition: Present { value: compiler_gate_upload_condition() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_floor_bound_steps() -> List<CompilerGateBoundStep> {
  concat(compiler_gate_fleet_prelude_bound_steps_around_build(
    bins: witness_floor_required_bins,
    build_step_name: compiler_gate_floor_build_step_name,
    before_build: compiler_gate_candidate_key_bound_steps(),
    after_build: compiler_gate_candidate_pack_bound_steps(),
  ), concat([
    CompilerGateBoundStep {
      step: compiler_gate_floor_run_step(),
      role: consumes_only(capabilities: [RustfmtCapability]),
      step_name: "Nominal witnesses (one prepared subject, one fold)",
    },
  ], compiler_gate_floor_measurement_bound_steps()))
}

// THE PRELUDE BOTH FLEET JOBS NEED, ONE LIST RATHER THAN TWO COPIES: the head checkout, isolated
// toolchain homes, a pinned default, and claim_executor plus gunbc built from the judged tree. The
// build step keeps its id, build_witness_fold, in both jobs because every downstream condition in
// each job reads that id; step ids are per job, so the two never collide.
fn compiler_gate_fleet_prelude_bound_steps() -> List<CompilerGateBoundStep> {
  compiler_gate_fleet_prelude_bound_steps_around_build(
    bins: witness_floor_required_bins,
    build_step_name: compiler_gate_floor_build_step_name,
    before_build: [],
    after_build: [],
  )
}

// emit-build needs only `gunbc` (its instruments run through `gunbc test`), so it takes the same
// prelude over its own binaries rather than a copy of it; the floor adds its candidate-key and
// candidate-pack steps around the same build.
fn compiler_gate_fleet_prelude_bound_steps_around_build(bins: List<String>, build_step_name: String, before_build: List<CompilerGateBoundStep>, after_build: List<CompilerGateBoundStep>) -> List<CompilerGateBoundStep> {
  concat([
    CompilerGateBoundStep {
      step: compiler_gate_floor_checkout_step(),
      role: capability_neutral,
      step_name: "Checkout the commit this lane judges",
    },
    CompilerGateBoundStep {
      step: toolchain_home_isolation_step(),
      role: capability_neutral,
      step_name: "Isolate toolchain homes",
    },
    CompilerGateBoundStep {
      step: witness_floor_toolchain_step(),
      role: provides_only(capabilities: [CargoCapability, RustcCapability, RustfmtCapability, RustupCapability]),
      step_name: "Install Rust toolchain",
    },
    CompilerGateBoundStep {
      step: toolchain_pin_rustup_default_step(),
      role: consumes_only(capabilities: [RustupCapability, CargoCapability]),
      step_name: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)",
    },
  ], concat(before_build, concat([
    CompilerGateBoundStep {
      step: witness_floor_build_step(
        step_name: build_step_name,
        build_script: repo_self_build_command(bins: bins),
      ),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: build_step_name,
    },
  ], concat(after_build, [
    CompilerGateBoundStep {
      step: witness_toolchain_homes_isolated_guard_step(),
      role: capability_neutral,
      step_name: "Require isolated toolchain homes",
    },
  ]))))
}

// ORDER: the lint first (the cheapest verdict, over the Rust the prelude just built), then the build
// lane, then the drift discriminator that reads the lane's outcome, then the repair chain that reads
// the discriminator's.
fn compiler_gate_generated_bound_steps() -> List<CompilerGateBoundStep> {
  concat(compiler_gate_fleet_prelude_bound_steps(), [
    CompilerGateBoundStep {
      step: compiler_gate_lint_step(),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: compiler_gate_clippy_step_name,
    },
    CompilerGateBoundStep {
      step: compiler_gate_stage0_regen_step(),
      role: consumes_only(capabilities: [RustfmtCapability]),
      step_name: compiler_gate_stage0_regen_step_name,
    },
    CompilerGateBoundStep {
      step: compiler_gate_drift_step(),
      role: capability_neutral,
      step_name: compiler_gate_drift_step_name,
    },
    CompilerGateBoundStep {
      step: compiler_gate_repair_declaration_step(),
      role: capability_neutral,
      step_name: "Declare which ledger rows this repair covers",
    },
    CompilerGateBoundStep {
      step: compiler_gate_regen_step(),
      role: capability_neutral,
      step_name: "Regenerate every registry-rostered generated artifact (not the stage0 mirrors), then verify the tree it wrote",
    },
    CompilerGateBoundStep {
      step: compiler_gate_candidate_step(),
      role: capability_neutral,
      step_name: "Produce the sealed repair candidate",
    },
    CompilerGateBoundStep {
      step: compiler_gate_candidate_upload_step(),
      role: capability_neutral,
      step_name: "Upload the sealed repair candidate",
    },
  ])
}

// THE RECEIPT'S THREE CONSUMERS, TAKEN FROM THE ONE AUTHORITY THAT DECLARES THEM. D0-MEASURE seals
// an unreached receipt when the instrument never returned one, D0-PUBLISH uploads it, and
// D0-ADJUDICATE reads it back and exits 1 on any blocker -- the step whose absence let a refused
// floor conclude success. Bound here by re-binding gunbc.witness_floor_workflow's rows rather than
// re-declaring them, so this lane and the floor workflow cannot carry two refusal mechanisms for
// one receipt (DESIGN section 3). The rows already bind their env to steps.build_witness_fold,
// which is the id witness_floor_build_step gives this job's build step too.
//
// THE PER-CLAIM COST RECEIPT IS UPLOADED AFTER THEM, re-bound the same way
// (gunbc.witness_floor_workflow required_floor_claim_cost_upload_bound_step). Its condition is the
// floor's precondition, which holds through a red adjudication, so a refused floor still publishes
// the cost of what it executed.
fn compiler_gate_floor_measurement_bound_steps() -> List<CompilerGateBoundStep> {
  list_map(
    xs: concat(required_ci_measurement_bound_steps(), [required_floor_claim_cost_upload_bound_step()]),
    f: fn(b) { CompilerGateBoundStep { step: b.step, role: b.role, step_name: b.step_name } },
  )
}

fn compiler_gate_floor_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: compiler_gate_floor_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

fn compiler_gate_floor_scripts_are_renderable() -> Bool {
  wrap_command_is_renderable(command: witness_floor_run_script())
    && wrap_command_is_renderable(command: build_lane_run_script())
    && wrap_command_is_renderable(command: repo_self_clippy_command())
    && wrap_command_is_renderable(command: repo_self_build_command(bins: witness_floor_required_bins))
    && required_ci_measurement_scripts_are_renderable()
}

// ── THE MERGE QUEUE PRODUCES THE COMPILER PAIR CANDIDATE ────────────────────────────────────────
//
// The floor already builds claim_executor and gunbc from the tree that will land. On a merge group
// (the composed revision that becomes main), it also keys that build as gunbc.fleet_release_bins_key
// compiler_pair_release_product BEFORE building -- so the build is stamped with the materialized tree,
// as the preimage says -- then packs the two binaries with the build log the build step just wrote,
// wraps the pack as one object and uploads it as a short-lived workflow artifact. The floor holds no
// cache credential: it produces a CANDIDATE, and fleet-desired, after the revision lands, verifies it
// and is the only canonical publisher. A pull-request run produces nothing (nothing would consume it).
// A refusal here is the floor's: an environment the product's preimage cannot honestly describe
// stops the line rather than yielding an unprovenanced candidate.
fn compiler_gate_candidate_condition() -> String {
  "github.event_name == 'merge_group'"
}

fn compiler_gate_candidate_built_condition() -> String {
  "github.event_name == 'merge_group' && steps.build_witness_fold.outcome == 'success'"
}

fn compiler_gate_candidate_run_step(name: String, script: String, condition: String) -> Step {
  RunStep {
    name: Present { value: name },
    id: none,
    run: script,
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: condition },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_candidate_key_bound_steps() -> List<CompilerGateBoundStep> {
  [
    CompilerGateBoundStep {
      step: compiler_gate_candidate_run_step(
        name: "Key the compiler pair candidate (merge group; stamps the build with the materialized tree)",
        script: release_bins_key_script_for(product: compiler_pair_release_product()),
        condition: compiler_gate_candidate_condition(),
      ),
      role: consumes_only(capabilities: [CargoCapability, RustcCapability]),
      step_name: "Key the compiler pair candidate (merge group; stamps the build with the materialized tree)",
    },
  ]
}

fn compiler_gate_candidate_pack_bound_steps() -> List<CompilerGateBoundStep> {
  [
    CompilerGateBoundStep {
      step: compiler_gate_candidate_run_step(
        name: "Pack the compiler pair candidate with its build log",
        script: join([release_bins_pack_manifest_script_for(product: compiler_pair_release_product()), release_bins_pack_object_script()], "\n"),
        condition: compiler_gate_candidate_built_condition(),
      ),
      role: capability_neutral,
      step_name: "Pack the compiler pair candidate with its build log",
    },
    CompilerGateBoundStep {
      step: UsesStep {
        name: Present { value: "Upload the compiler pair candidate" },
        id: none,
        uses: upload_artifact_action,
        with: Present {
          value: [
            kv(key: "name", value: yaml_string(s: compiler_pair_candidate_artifact_name)),
            kv(key: "path", value: yaml_string(s: release_bins_pack_object_path_expression())),
            kv(key: "if-no-files-found", value: yaml_string(s: "error")),
            kv(key: "retention-days", value: yaml_int(n: compiler_pair_candidate_retention_whole_days())),
            kv(key: "compression-level", value: yaml_int(n: 0))
          ]
        },
        env: none,
        if_condition: Present { value: compiler_gate_candidate_built_condition() },
        continue_on_error: none,
        timeout_minutes: none
      },
      role: capability_neutral,
      step_name: "Upload the compiler pair candidate",
    },
  ]
}

fn compiler_gate_floor_job() -> Job {
  Job {
    id: compiler_gate_floor_job_id,
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    environment: none,
    steps: list_map(xs: compiler_gate_floor_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: Present {
      value: [
        kv(key: malloc_arena_max_env_key, value: yaml_string(s: malloc_arena_max_value)),
        kv(key: "GUNBC_EXPECTED_RED_ROSTER_JOIN", value: yaml_string(s: expected_red_roster_join_path)),
        kv(key: "GUNBC_REQUIRED_FLOOR_DISPOSITION", value: yaml_string(s: required_floor_disposition_path)),
        kv(key: "GUNBC_LONG_HOME_STORAGE_AGREEMENT", value: yaml_string(s: long_home_storage_agreement_path)),
        kv(key: "GUNBC_REQUIRED_FLOOR_CLAIM_COST", value: yaml_string(s: required_floor_claim_cost_path)),
        kv(key: "GUNBC_REQUIRED_FLOOR_CROSS_CLAIM_DEMAND", value: yaml_string(s: required_floor_cross_claim_demand_path))
      ]
    },
    outputs: none,
    if_condition: Present { value: compiler_gate_floor_job_condition() },
    timeout_minutes: Present { value: compiler_gate_floor_timeout_minutes },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: compiler_gate_permissions }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
// THE GENERATED-ARTIFACT LANE: A JOB BESIDE THE FLOOR, NOT STEPS AFTER IT.
//
// OPERATOR RULING 2026-09-27, which grows the closed roster by exactly this one job. Its steps used
// to run on the floor job after the witnesses fold exited, so a run waited for the SUM of three
// verdicts that do not read one another -- the witnesses fold, the registry drift gate and, on the
// merge queue, the stage0 build lane. Merge-queue run 36339106604 is the receipt: those three steps
// took 46, 9 and 29 minutes in series, and the job 87. On its own slot the lane runs concurrently
// with the floor, the memory constraint that kept the passes apart is met by placement (each
// process has a slot to itself), and a run waits for the longer lane instead of the total.
//
// THE PRICE IS ONE MORE CHECKOUT AND SEED BUILD PER RUN, on the fleet, which is why the roster
// needed a ruling rather than an edit. The total work is otherwise the same steps; the merge-queue
// drift step is removed rather than moved (compiler_gate_drift_condition), so a queued landing runs
// one generated-artifact adjudication instead of two.
//
// FORK CODE DOES NOT RUN HERE EITHER, and the guard is the floor's own condition, not a second
// spelling of it: both jobs check out the judged head on a persistent self-hosted runner.
data compiler_gate_generated_job_id: String = "generated"

fn compiler_gate_generated_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: compiler_gate_generated_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

// THE TIMEOUT IS THE FLOOR'S BOUND, one authority for how long a fleet lane may hold a slot, not a
// second literal: this lane's measured wall is well under it on both events.
fn compiler_gate_generated_job() -> Job {
  Job {
    id: compiler_gate_generated_job_id,
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    environment: none,
    steps: list_map(xs: compiler_gate_generated_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: Present {
      value: [
        kv(key: malloc_arena_max_env_key, value: yaml_string(s: malloc_arena_max_value))
      ]
    },
    outputs: none,
    if_condition: Present { value: compiler_gate_floor_job_condition() },
    timeout_minutes: Present { value: compiler_gate_floor_timeout_minutes },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: compiler_gate_permissions }
  }
}

// THE EMIT-AND-BUILD LANE. Its subject, and the discriminating red it buys that no other required
// lane carries, are `gunbc.emitted_subject_build_gate`'s to state; read that module before this
// one. What is decided HERE is only its realization as a job: which runner, which prelude, and how
// its verdict reaches the required context.
//
// A JOB AND NOT A STEP ON A LANE THAT ALREADY BUILDS THIS TREE, weighed against the roster header's
// own question. The seed build is established by the fleet lanes' prelude (the `compiler` lane that
// first carried it was deleted on 2026-09-28), and this lane establishes something else: that the
// seed can EMIT two v2 closures and that the EMITTED crates compile. The two fail for different
// causes and a reader must see which. As its own job it runs BESIDE the floor, so its wall overlaps
// the floor's instead of adding to it; on `floor` or `generated` it would add in series. The
// prelude is paid once more per run and that is the price.
//
// THE FLEET RUNNER, because the lane blocks (compiler_gate_lane_rows) and a blocking lane may not
// run hosted (compiler_gate_merge_path_runs_on_the_fleet). That makes it a standing claim on the
// fleet for every pull request and merge_group, which the operator signed off on 2026-10-02. It
// inherits the fleet lanes' exposure the header names: a superseded pull-request run is cancelled,
// and fleet_compile_cancellation_standing still reads NotSafe. THE WALL IS MEASURED ON THIS RUNNER CLASS BY THIS LANE'S OWN RUNS and is
// not restated here (DESIGN section 6: name the instrument, never transcribe its output) -- the
// producer is the `emit-build` job of any run of this workflow, and the two instrument steps carry
// one label each so the split between the two compilations is readable from the step timings
// rather than inferred.
data compiler_gate_emit_build_job_id: String = "emit-build"

// THE TIMEOUT IS A BOUND, NOT A BUDGET, and it is deliberately well above the measured wall: a
// timeout that trims a slow-but-honest run converts a subject verdict into silence on the required
// context, which is the failure `required_lanes_aggregate_job_condition` spends its whole comment
// on one module over.
data compiler_gate_emit_build_timeout_minutes: Int = 90

// ONE STEP PER SUBJECT, EACH WITH ITS OWN ID. `witness_floor_build_step` cannot be reused: it binds
// the fixed step id `build_witness_fold`, and two steps in one job may not share an id. The
// failure-class wrapper is kept -- a new lane is exactly where a runner hiccup must read as `infra`
// rather than as a defect in the diff.
fn compiler_gate_emit_build_step(row: EmittedSubjectBuildRow) -> Step {
  RunStep {
    name: Present { value: emitted_subject_build_step_name(row: row) },
    id: Present { value: row.step_id },
    run: concat(
      wrap_command_with_floor_attempt_receipt(
        command: shell_command_render(command: emitted_subject_build_command(row: row))
      ),
      "\n"
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE NOTICE STEP RUNS ON FAILURE AND ONLY ON FAILURE, because that is the one moment a stranger
// is looking at this job. It is the LAST step, so it appears directly beneath the diagnostic a
// reader is trying to interpret rather than scrolled away above it.
//
// `if: failure()` rather than `always()`: a notice printed on a green run is noise on every
// passing PR in the repository, and the reassurance has no subject when there is nothing to
// reassure anyone about.
//
// THE QUOTING IS `extdeps.github.log_annotations` `emit_line_shell` AND NOT A SECOND SPELLING OF
// IT. That module already owns printf-one-line-shell-quoted for exactly this purpose, and a
// hand-rolled `echo '...'` here would be the section 3 fork -- with the usual downgrade attached,
// since a line containing an apostrophe would terminate its own quote.
//
// IT ECHOES RATHER THAN ANNOTATES. A `::error::` would add a second red to a job that already has
// one, and a `::notice::` on a failed job is rendered where nobody looking at the failure will
// read it. Plain stdout at the end of the step list is where the eye already is.
// THE LIVE NOTICE: the standing row composed with THIS lane row's blocking status, so "does NOT
// block your merge" is printed only while `compiler_gate_lane_rows` says so, and the one-word flip
// to `LaneBlocks` changes the notice in the same edit.
fn compiler_gate_emit_build_notice_lines() -> List<String> {
  emit_build_standing_notice_for(
    standing: emit_build_standing,
    lane_blocks: length(xs: filter(xs: compiler_gate_blocking_rows(), predicate: fn(row) {
      row.job_id == compiler_gate_emit_build_job_id
    })) > 0
  )
}

fn compiler_gate_emit_build_notice_step() -> Step {
  RunStep {
    name: Present { value: "Why this lane is red, and what would be a real finding" },
    id: none,
    run: join(list_map(xs: compiler_gate_emit_build_notice_lines(), f: emit_line_shell), "\n"),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "failure()" },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn compiler_gate_emit_build_subject_bound_steps() -> List<CompilerGateBoundStep> {
  list_map(xs: emitted_subject_build_rows(), f: fn(row) {
    CompilerGateBoundStep {
      step: compiler_gate_emit_build_step(row: row),
      role: consumes_only(capabilities: [CargoCapability]),
      step_name: emitted_subject_build_step_name(row: row),
    }
  })
}

// THE PRELUDE IS THE FLEET PRELUDE over `gunbc` alone, because the subject steps need exactly what it
// provides on the fleet: the judged checkout, an isolated toolchain home (and the guard requiring
// it), a pinned default, and the `gunbc` binary the instruments are invoked through.
// THE NATIVE PRODUCT STORE'S ROOT IS THE EXISTING DERIVATION, NOT A SECOND ONE. `emit-build` binds the
// fleet's own `ci_native_cache_root_step` (`$RUNNER_TOOL_CACHE/gunbc-native/<toolchain segment>`),
// which is outside the per-job `$RUNNER_TEMP` and so survives to the next run on the same runner
// host (`cli_run::native_product_cache`, CI programme row R3). The toolchain segment is already part
// of the root, and the product key carries the toolchain axis besides.
// THE STORE EXISTS ONLY FOR PULL REQUESTS. The required run on the merge queue's composed revision is
// the proof of the sha that lands, so it builds its own compiler: with the root unset the seed reads
// and writes nothing (GUNBC_NATIVE_CACHE_ROOT unset is "no store"). A per-host entry is verified only
// against its own manifest, which whoever wrote it controls, and a pull request's job runs code the
// pull request chose; letting the queue read what a pull request could have written would let the
// merge gate pass on a compiler it never built. A pull request's own reuse stays inside that trust.
fn compiler_gate_native_cache_condition() -> String {
  join(["github.event_name == '", github_event_name_pull_request, "'"], "")
}

fn compiler_gate_native_cache_root_step_for_pull_requests() -> Step {
  match ci_native_cache_root_step() {
    RunStep { name: n, id: i, run: r, shell: s, env: e, working_directory: w, if_condition: _, continue_on_error: c, timeout_minutes: tm } =>
      RunStep { name: n, id: i, run: r, shell: s, env: e, working_directory: w, if_condition: Present { value: compiler_gate_native_cache_condition() }, continue_on_error: c, timeout_minutes: tm }
    other => other
  }
}

fn compiler_gate_emit_build_native_cache_root_bound_step() -> CompilerGateBoundStep {
  CompilerGateBoundStep {
    step: compiler_gate_native_cache_root_step_for_pull_requests(),
    role: consumes_only(capabilities: [RustcCapability]),
    step_name: "Derive native-cache root",
  }
}

fn compiler_gate_emit_build_bound_steps() -> List<CompilerGateBoundStep> {
  concat(
    concat(compiler_gate_fleet_prelude_bound_steps_around_build(bins: compiler_gate_required_bins, build_step_name: compiler_gate_build_step_name, before_build: [compiler_gate_emit_build_native_cache_root_bound_step()], after_build: []), compiler_gate_emit_build_subject_bound_steps()),
    [CompilerGateBoundStep {
      step: compiler_gate_emit_build_notice_step(),
      role: capability_neutral,
      step_name: "Why this lane is red, and what would be a real finding",
    }]
  )
}

fn compiler_gate_emit_build_capability_closure_holds() -> Bool {
  capability_closure_is_closed(
    v: workflow_job_capability_closure(
      steps: list_map(
        xs: compiler_gate_emit_build_bound_steps(),
        f: fn(b) { CapabilityAnnotatedStep { step_name: b.step_name, role: b.role } },
      )
    ),
  )
}

fn compiler_gate_emit_build_job() -> Job {
  Job {
    id: compiler_gate_emit_build_job_id,
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    environment: none,
    steps: list_map(xs: compiler_gate_emit_build_bound_steps(), f: fn(b) { b.step }),
    needs: [],
    env: Present {
      value: [
        kv(key: malloc_arena_max_env_key, value: yaml_string(s: malloc_arena_max_value))
      ]
    },
    outputs: none,
    if_condition: Present { value: compiler_gate_floor_job_condition() },
    timeout_minutes: Present { value: compiler_gate_emit_build_timeout_minutes },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: compiler_gate_permissions }
  }
}

// A LANE RESULT IS AN EXPRESSION, NOT SHELL TEXT, AND THE JOB ID IS NOT ALWAYS DOT-SAFE.
//
// `-` is the SUBTRACTION OPERATOR in the Actions expression language, so `needs.emit-build.result`
// does not dereference a job: it parses as arithmetic over three undefined operands and renders
// EMPTY. Downstream that compares unequal to `success` on every run, including all-green ones -- a
// gate whose only reachable state is red, which carries exactly as much information as one that
// can never go red. gunbc#6f358d269b found that on the previous workflow's hyphenated lane ids and
// taught `extdeps.github.expressions` to choose index form (`needs['emit-build'].result`) from the
// segment; this module was then written with THREE dot-safe job ids and hand-spelled its
// interpolations as string literals, which agreed with the authority by coincidence and stopped
// agreeing the moment a lane id carried a hyphen.
//
// So every lane result now renders through that authority, the dot-safe ones included: their bytes
// are unchanged, which is the point -- the four call sites become one rule instead of three
// literals that happen to be right and one that is not.
fn compiler_gate_lane_result_expression(job_id: String) -> String {
  interpolate(expression: ContextAccess { context: Needs, path: [job_id, "result"] })
}

// The ruleset requires a check named `witnesses`, and a job's check is named by its id.
data compiler_gate_aggregate_job_id: String = "witnesses"

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE GATE IS DERIVED FROM THE ROSTER -- ALL OF IT, NOT THE `needs` EDGE ALONE
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// THE DEFECT THIS CLOSES, AND IT WAS IN THE FIRST CUT OF THIS ROSTER (review 69973). `needs` is
// NOT what makes a lane block. This job is `if: always()`, so a `needs` edge only orders it; the
// verdict is computed entirely from the env bindings and the shell conditionals below. A roster
// joined against `needs` alone therefore moved the silent absence from the `needs` list to the
// ENV list rather than removing it -- and it did so while ASSERTING that the two representations
// agree, which is worse than the state it replaced, because an inflated claim never ranks for
// climbing (DESIGN section 4b(1)).
//
// The scenario the row itself scheduled: the follow-up that flips `emit-build` to `LaneBlocks`
// adds the row word and gains the `needs` edge, forgets the script clause, and gets a green
// `compiler_gate_lane_standings_hold`, a green emission, and a lane that still cannot block.
//
// SO THE REMEDY IS CONSTRUCTION, NOT A WIDER CHECK (DESIGN section 5). The env block, every
// conditional and the echo line are FOLDED FROM `compiler_gate_lane_rows`, so a blocking lane
// without a variable, or a variable no clause reads, has no constructor. The only join left is
// jobs-list against roster, because the workflow's job list is the one surface this module does
// not derive from the roster.
//
// THE VARIABLE NAME IS A ROW FIELD rather than a transformation of the job id, for the reason
// the step id is: a shell variable name and a job id are different namespaces with different
// alphabets -- `emit-build` is not a variable name -- so deriving one from the other means
// authoring a mangling rule whose only consumer is this list.

fn compiler_gate_var_read(row: CompilerGateLaneRow) -> String {
  join(["\"$", row.var_name, "\""], "")
}

fn compiler_gate_var_report(row: CompilerGateLaneRow) -> String {
  join([row.job_id, "=$", row.var_name], "")
}

fn compiler_gate_blocking_rows() -> List<CompilerGateLaneRow> {
  compiler_gate_blocking_rows_of(rows: compiler_gate_lane_rows())
}

// THE AGGREGATE IS A FUNCTION OF A SUPPLIED ROSTER, and the live gate is that function applied to
// `compiler_gate_lane_rows`. The roster is the one input every surface below derives from, so
// taking it as a parameter lets a witness state a LAW over any roster -- an announced lane binds no
// variable, a blocking lane is read by every arm -- over a supplied row, while the live claims
// assert which lanes block today (DESIGN section 3: a witness discriminates at one interface).
fn compiler_gate_blocking_rows_of(rows: List<CompilerGateLaneRow>) -> List<CompilerGateLaneRow> {
  filter(xs: rows, predicate: compiler_gate_lane_blocks)
}

fn compiler_gate_strict_rows_of(rows: List<CompilerGateLaneRow>) -> List<CompilerGateLaneRow> {
  filter(xs: compiler_gate_blocking_rows_of(rows: rows), predicate: fn(row) {
    match row.arm {
      GateArmStrict => true
      GateArmSkippableOnFork { notice: _, unobserved_error: _ } => false
    }
  })
}

fn compiler_gate_fork_rows_of(rows: List<CompilerGateLaneRow>) -> List<CompilerGateLaneRow> {
  filter(xs: compiler_gate_blocking_rows_of(rows: rows), predicate: fn(row) {
    match row.arm {
      GateArmStrict => false
      GateArmSkippableOnFork { notice: _, unobserved_error: _ } => true
    }
  })
}

fn compiler_gate_report_text(rows: List<CompilerGateLaneRow>) -> String {
  join(list_map(xs: rows, f: compiler_gate_var_report), " ")
}

// THE COMPARISON IS `!= success` AND NOT A LIST OF BAD STATES, carried over from the roster this
// module displaced and still a measured fact rather than a preference: run 32883390033 read
// `FLOOR="abandoned"`, a `needs.*.result` value nobody knew was reachable, and an enumerated
// guard would have admitted it and reported the required context GREEN over two lanes that never
// ran. The strict inequality admits exactly one state and refuses every other, including ones the
// author has never heard of.
fn compiler_gate_is_failure_clause(row: CompilerGateLaneRow) -> String {
  join(["[ ", compiler_gate_var_read(row: row), " = failure ]"], "")
}

fn compiler_gate_not_success_clause(row: CompilerGateLaneRow) -> String {
  join(["[ ", compiler_gate_var_read(row: row), " != success ]"], "")
}

fn compiler_gate_echo_line(rows: List<CompilerGateLaneRow>) -> String {
  join([
    "echo \"required lanes: ",
    compiler_gate_report_text(rows: compiler_gate_blocking_rows_of(rows: rows)),
    " (same_repo=$SAME_REPO)\""
  ], "")
}

fn compiler_gate_failure_line(rows: List<CompilerGateLaneRow>) -> String {
  join([
    "if ",
    join(list_map(xs: compiler_gate_blocking_rows_of(rows: rows), f: compiler_gate_is_failure_clause), " || "),
    "; then echo \"::error::a required lane concluded failure (",
    compiler_gate_report_text(rows: compiler_gate_blocking_rows_of(rows: rows)),
    ") - open that job's log\" >&2; exit 1; fi"
  ], "")
}

// THE SECOND ARM SAYS SOMETHING THE FIRST DOES NOT, and keeping them apart is the whole reason
// there are two: a lane that FAILED is a verdict about the diff, and a lane that produced no
// conclusion of its own leaves the head UNOBSERVED. Both block; they send a reader to different
// places.
fn compiler_gate_unobserved_line(rows: List<CompilerGateLaneRow>) -> String {
  join([
    "if ",
    join(list_map(xs: compiler_gate_strict_rows_of(rows: rows), f: compiler_gate_not_success_clause), " || "),
    "; then echo \"::error::a required lane produced no conclusion of its own, so this head is unobserved rather than failed (",
    compiler_gate_report_text(rows: compiler_gate_strict_rows_of(rows: rows)),
    ")\" >&2; exit 1; fi"
  ], "")
}

fn compiler_gate_fork_line(row: CompilerGateLaneRow) -> String {
  match row.arm {
    GateArmStrict => ""
    GateArmSkippableOnFork { notice: n, unobserved_error: e } =>
      join([
        "if ", compiler_gate_not_success_clause(row: row),
        "; then if [ \"$SAME_REPO\" = false ] && [ ", compiler_gate_var_read(row: row), " = skipped ]",
        "; then echo \"::notice::", n, "\"",
        "; else echo \"::error::", e, " (", compiler_gate_var_report(row: row),
        "), so this head carries no verdict from that lane\"; exit 1; fi; fi"
      ], "")
  }
}

// THE STRICT ARM IS A LINE ONLY WHILE A STRICT LANE BLOCKS. Since the 2026-09-28 ruling every
// blocking lane runs on the fleet and is skippable on a fork, so no blocking row is strict, and the
// unobserved line over zero rows would render `if ; then` -- a shell syntax error that reds the
// required context on every run, a gate whose only reachable state is red. The fork lines already
// refuse `!= success` for every fleet lane, so omitting the empty line loses no refusal.
fn compiler_gate_unobserved_lines(rows: List<CompilerGateLaneRow>) -> List<String> {
  if length(xs: compiler_gate_strict_rows_of(rows: rows)) == 0 { [] } else { [compiler_gate_unobserved_line(rows: rows)] }
}

fn compiler_gate_aggregate_script_lines() -> List<String> {
  compiler_gate_aggregate_script_lines_for(rows: compiler_gate_lane_rows())
}

fn compiler_gate_aggregate_script_lines_for(rows: List<CompilerGateLaneRow>) -> List<String> {
  list_append(
    left: list_append(left: [compiler_gate_echo_line(rows: rows), compiler_gate_failure_line(rows: rows)], right: compiler_gate_unobserved_lines(rows: rows)),
    right: list_map(xs: compiler_gate_fork_rows_of(rows: rows), f: compiler_gate_fork_line)
  )
}

// THE FORK PREDICATE HAS ONE AUTHORITY AND THIS IS NOT IT (review 69999). The first cut of the
// derived gate promoted the inline `${{ ... }}` literal to a `data` row, which looked like
// consolidation and was the opposite: a verbatim re-spelling of the predicate
// `compiler_gate_floor_job_condition` already derives one screen up from
// `gunbc.heal_workflow` `heal_same_repository_clause`, which this module already imports.
//
// THE COUPLING IS LOAD-BEARING, NOT COSMETIC, which is why a second spelling is a defect rather
// than untidiness: the floor lane SKIPS exactly when that condition is false, and the gate's fork
// carve-out EXCUSES that skip exactly when `$SAME_REPO` is false. Two sources for one predicate
// and the two failure modes are opposite and both silent -- the fleet lane skips while the gate
// refuses (a merge-queue stall on every fork PR), or the gate excuses a skip that was not
// fork-driven (an unobserved head admitted). One authority makes both unwritable.
//
// ONLY THE INTERPOLATION DELIMITERS ARE ADDED HERE, and they are read from the expression
// writer's own spellings rather than typed, for the same reason the lane results are: a job `if`
// takes a bare expression and a step `env` value takes an interpolated one, which is a difference
// of TRANSPORT, not of predicate.
fn compiler_gate_same_repo_expression() -> String {
  join([
    default_expression_spellings.interp_open,
    compiler_gate_floor_job_condition(),
    default_expression_spellings.interp_close
  ], "")
}

fn compiler_gate_aggregate_step_env() -> List<YamlKeyValue> {
  compiler_gate_aggregate_step_env_for(rows: compiler_gate_lane_rows())
}

fn compiler_gate_aggregate_step_env_for(rows: List<CompilerGateLaneRow>) -> List<YamlKeyValue> {
  list_append(
    left: list_map(xs: compiler_gate_blocking_rows_of(rows: rows), f: fn(row) {
      kv(key: row.var_name, value: yaml_string(s: compiler_gate_lane_result_expression(job_id: row.job_id)))
    }),
    right: [kv(key: "SAME_REPO", value: yaml_string(s: compiler_gate_same_repo_expression()))]
  )
}

fn compiler_gate_aggregate_step() -> Step {
  RunStep {
    name: Present { value: "Every required lane must have succeeded" },
    id: none,
    run: join(compiler_gate_aggregate_script_lines(), "\n"),
    shell: none,
    env: Present { value: compiler_gate_aggregate_step_env() },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// ON THE FLEET, AND WITH NO FORK GUARD (operator ruling 2026-09-28). The job checks nothing out,
// installs no toolchain and runs one short script over its lanes' results, so it runs no pull-request
// code of its own and holds a slot for seconds -- where on the hosted pool it waited minutes for one
// (the header's receipts). It carries no `if` beyond always() because a skipped job's check is not
// a refusal: the required context must be produced on every run, and the fork carve-out lives in the
// lane rows the script reads.
fn compiler_gate_aggregate_job() -> Job {
  Job {
    id: compiler_gate_aggregate_job_id,
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    environment: none,
    steps: [compiler_gate_aggregate_step()],
    needs: compiler_gate_blocking_job_ids(),
    env: none,
    outputs: none,
    if_condition: Present { value: "always()" },
    timeout_minutes: Present { value: 5 },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: compiler_gate_permissions }
  }
}

// EVERY JOB THAT IS NOT THE AGGREGATE DECLARES WHETHER IT BLOCKS, AND THE TWO STATES ARE
// DERIVED FROM ONE ROSTER RATHER THAN FROM THE ABSENCE OF AN EDGE.
//
// THE FAIL-OPEN THIS CLOSES. A job present in the workflow but absent from the aggregate's
// `needs` RUNS AND CANNOT BLOCK: it publishes its own check, which no ruleset requires, while the
// one required context concludes success over a lane it never read. Before this roster the jobs
// list and the `needs` list were two spellings of one fact, and that state was reachable by
// forgetting an edge -- silently, with a green gate.
//
// WHY THE ANSWER IS NOT "EVERY JOB MUST BE NEEDED". A lane that runs and does not block is a
// LEGITIMATE INTERIM: `emit-build` stood in it from 2026-09-22 (operator ruling, v2 foundation
// manager: land it PRESENT and NOT BLOCKING while main could not self-host) until 2026-10-02, when
// the operator signed off its fleet claim and its row became LaneBlocks. No lane stands in it today;
// the arm is kept because the next lane to land may need it. The defect is not that such a lane exists; it is that its non-blocking standing was
// INFERRABLE FROM AN ABSENCE, where a forgotten edge and a deliberate interim are the same bytes.
//
// So the standing is DECLARED and it carries the trigger that retires it -- and, since review
// 69973, EVERY GATING SURFACE IS FOLDED FROM THIS ROSTER rather than joined against it. The first
// cut joined the roster against the aggregate's `needs` and claimed the representations agreed;
// they did not, because this job is `if: always()` and a `needs` edge only orders it. The verdict
// is computed from the env bindings and the shell conditionals, so joining `needs` moved the
// silent absence one surface along while asserting it had been removed. `needs`, the env block,
// the echo line and every conditional now derive from these rows, so a blocking lane without a
// variable, or a variable no clause reads, has no constructor (DESIGN section 5: construction
// over validation). Flipping `emit-build` to required is one word on one row plus the job's move
// onto the fleet, which compiler_gate_merge_path_runs_on_the_fleet refuses to let anyone forget; and
// forgetting to flip it leaves a row whose trigger anyone reading the roster can see -- not an edge,
// and not a variable, that nobody can see is missing.
type CompilerGateLaneStanding
  = LaneBlocks
  | LaneAnnouncedNotBlocking { flip_trigger: String }

// THE GATE ARM IS A PROPERTY OF THE LANE, NOT A SPECIAL CASE IN THE SCRIPT. Two lanes differ in
// what a non-success MEANS. For a strict lane -- one that runs on every pull request, forks included,
// as the deleted hosted compiler and lint lanes did -- any non-success is a head this gate cannot
// vouch for. A fleet lane legitimately SKIPS on a fork pull request -- there is no witnesses fold and
// no generated-artifact verdict for that head, and saying so is a notice rather than a refusal.
// Carrying that as a row field is what lets the whole script be derived; carrying it as a
// hand-written fourth line is what let the script drift from the roster. Since the 2026-09-28 ruling
// every blocking lane is a fleet lane, so today no live row carries GateArmStrict (emit-build left it when it moved),
// and a hosted lane cannot turn blocking without moving (compiler_gate_merge_path_runs_on_the_fleet).
type CompilerGateArm
  = GateArmStrict
  | GateArmSkippableOnFork { notice: String, unobserved_error: String }

type CompilerGateLaneRow {
  job_id: String
  var_name: String
  standing: CompilerGateLaneStanding
  arm: CompilerGateArm
}

// THE UNIT-TEST ROW IS NOT BLOCKING UNDER A DECLARED DROP (operator-approved, escalation
// msg_e83c070f, 2026-10-05): the step overran its cap on every head after gunbc#12951, so its red
// said nothing about the diff and refused every merge. The job still runs and reports;
// gunbc.rung_drop rust_unit_tests_over_their_cap names the trigger that flips it back to LaneBlocks.
fn compiler_gate_lane_rows() -> List<CompilerGateLaneRow> {
  [
    CompilerGateLaneRow {
      job_id: compiler_gate_unit_test_job_id,
      var_name: "RUST_UNIT_TESTS",
      arm: GateArmSkippableOnFork {
        notice: "the v1 unit-test lane is skipped for a fork pull request: it runs on the fleet",
        unobserved_error: "the v1 unit-test lane produced no success"
      },
      standing: LaneAnnouncedNotBlocking {
        flip_trigger: "gunbc.rung_drop rust_unit_tests_over_their_cap: the full v1 --lib unit suite completes under its cap on the fleet runner on every head. Sufficient for: the lane red meaning a test failed, never that its clock ran out."
      },
    },
    CompilerGateLaneRow {
      job_id: compiler_gate_emit_build_job_id,
      var_name: "EMIT_BUILD",
      standing: LaneBlocks,
      arm: GateArmSkippableOnFork {
        notice: "the emit-build lane is skipped for a fork pull request: no self-host or native-CLI emission verdict for this head",
        unobserved_error: "the emit-build lane produced no success"
      }
    },
    CompilerGateLaneRow {
      job_id: compiler_gate_floor_job_id,
      var_name: "FLOOR",
      standing: LaneBlocks,
      arm: GateArmSkippableOnFork {
        notice: "the fleet lane is skipped for a fork pull request: no witnesses fold and no generated-artifact verdict for this head",
        unobserved_error: "the fleet lane produced no success"
      }
    },
    CompilerGateLaneRow {
      job_id: compiler_gate_generated_job_id,
      var_name: "GENERATED",
      standing: LaneBlocks,
      arm: GateArmSkippableOnFork {
        notice: "the generated-artifact lane is skipped for a fork pull request: no generated-artifact verdict for this head",
        unobserved_error: "the generated-artifact lane produced no success"
      }
    },
  ]
}

fn compiler_gate_lane_blocks(row: CompilerGateLaneRow) -> Bool {
  match row.standing {
    LaneBlocks => true
    LaneAnnouncedNotBlocking { flip_trigger: _ } => false
  }
}

fn compiler_gate_blocking_job_ids() -> List<String> {
  list_map(xs: compiler_gate_blocking_rows(), f: fn(row) { row.job_id })
}

// THE ONE JOIN THAT REMAINS, AND IT IS AN EMISSION CONJUNCT RATHER THAN A WITNESS because the
// remedy is refusal, not a report: a workflow whose gate does not match its declared standings
// must not be emitted at all, and `expected_compiler_gate_yml` already refuses to produce yaml
// when a capability closure fails. The drift gate then reds on the refusal marker rather than on
// a workflow that would have run.
//
// IT IS PARAMETERIZED ON ALL THREE SIDES so the RED is authorable at the fixture boundary, which
// is the boundary that decides whether a top-rung check carries information (DESIGN section 4b):
// a witness hands it disagreeing sets and reads the refusal, rather than waiting for a future
// author to supply the only counterexample.
//
// WHY IT STILL TAKES `blocking` AND `needs` WHEN BOTH ARE NOW DERIVED FROM THE SAME ROSTER. Those
// two arms are trivially true today and are kept because they are cheap and because the property
// they state -- the gate reads exactly the lanes declared to block -- is the one a future author
// would break by reintroducing a hand-written `needs` list. What they do NOT establish is that the
// env and script agree, and that is not a gap: those are folded, so the claims over them live in
// the witness as readings of a derived value rather than as a join between two authorities.
fn compiler_gate_standings_agree(
  job_ids: List<String>,
  rostered: List<String>,
  blocking: List<String>,
  needs: List<String>
) -> Bool {
  let every_job_rostered = all(job_ids, id => any(rostered, r => r == id))
  let no_phantom_row = all(rostered, r => any(job_ids, id => id == r))
  let every_blocker_needed = all(blocking, b => any(needs, n => n == b))
  let no_unblocking_need = all(needs, n => any(blocking, b => b == n))
  every_job_rostered && no_phantom_row && every_blocker_needed && no_unblocking_need
}

fn compiler_gate_non_aggregate_job_ids() -> List<String> {
  list_map(
    xs: filter(
      xs: compiler_gate_workflow.jobs,
      predicate: fn(j) { j.id != compiler_gate_aggregate_job_id }
    ),
    f: fn(j) { j.id }
  )
}

fn compiler_gate_lane_standings_hold() -> Bool {
  compiler_gate_standings_agree(
    job_ids: compiler_gate_non_aggregate_job_ids(),
    rostered: list_map(xs: compiler_gate_lane_rows(), f: fn(row) { row.job_id }),
    blocking: compiler_gate_blocking_job_ids(),
    needs: compiler_gate_aggregate_job().needs
  )
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE MERGE PATH RUNS ON THE FLEET -- AN EMISSION CONJUNCT, NOT A CONVENTION (operator ruling 2026-09-28)
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// The merge path is every lane the required context reads plus the aggregate that reads them. A
// hosted job on it makes every landing wait for a slot in a pool this repository does not control,
// which is the stall the header records. A workflow that puts one there must not be emitted at all,
// for the reason compiler_gate_standings_agree gives for being a conjunct: the remedy is refusal.
//
// A RUNNER THIS LAYER CANNOT DECIDE IS COUNTED HOSTED. RunsOnExpression is resolved at dispatch,
// so whether it lands on the hosted pool is unknowable here; admitting it would be the absorbing
// fallback DESIGN section 5 names, so it refuses like the hosted label does.
//
// PARAMETERIZED on both sets so the RED is authorable at the fixture boundary: a witness hands it a
// merge path that meets the hosted set and reads the refusal.
fn compiler_gate_no_merge_path_job_is_hosted(merge_path: List<String>, hosted: List<String>) -> Bool {
  all(merge_path, m => all(hosted, h => h != m))
}

fn compiler_gate_runner_is_hosted(runner: RunnerSpec) -> Bool {
  match runner {
    HostedRunner { label: _ } => true
    SelfHosted { labels: _ } => false
    RunsOnExpression { expression: _ } => true
  }
}

fn compiler_gate_hosted_job_ids() -> List<String> {
  list_map(
    xs: filter(
      xs: compiler_gate_workflow.jobs,
      predicate: fn(j) { compiler_gate_runner_is_hosted(runner: j.runner) }
    ),
    f: fn(j) { j.id }
  )
}

fn compiler_gate_merge_path_job_ids() -> List<String> {
  list_append(left: compiler_gate_blocking_job_ids(), right: [compiler_gate_aggregate_job_id])
}

fn compiler_gate_merge_path_runs_on_the_fleet() -> Bool {
  compiler_gate_no_merge_path_job_is_hosted(
    merge_path: compiler_gate_merge_path_job_ids(),
    hosted: compiler_gate_hosted_job_ids()
  )
}

// Pending runs are replaced as before; a running PR build is cancelled by the next push. The
// header says why that was lawful on a hosted runner, and why that reasoning no longer covers the
// merge path's fleet jobs. The policy arm is the fold's own vocabulary, so the emitted expression is
// the one gunbc.witness_floor_workflow would emit for this arm.
data compiler_gate_concurrency_policy: WitnessFloorConcurrencyPolicy = WitnessFloorConcurrencyPolicy {
  pending: ReplaceExistingPending,
  running: SupersedeRunningForEvent { event: github_event_name_pull_request }
}

data compiler_gate_workflow: Workflow = Workflow {
  name: witness_floor_workflow_name,
  run_name: none,
  on: witness_floor_triggers(),
  concurrency: Present {
    value: concurrency_of_policy(policy: compiler_gate_concurrency_policy, group: witness_floor_concurrency_group())
  },
  env: Present { value: [
    kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
    kv(key: (required_ci_contract_epoch_env_key as String), value: yaml_string(s: (required_ci_contract_epoch as String)))
  ] },
  permissions: Present { value: compiler_gate_permissions },
  jobs: [compiler_gate_unit_test_job(), compiler_gate_emit_build_job(), compiler_gate_floor_job(), compiler_gate_generated_job(), compiler_gate_aggregate_job()]
}

data compiler_gate_capability_refusal_reason: String = "REFUSED gunbc.compiler_gate_workflow: a job's capability closure does not hold, a floor script is not renderable, the workflow runs a job that compiler_gate_lane_rows does not roster, or a blocking lane or the aggregate runs on a hosted runner (compiler_gate_merge_path_runs_on_the_fleet, operator ruling 2026-09-28). No workflow yaml was emitted. Fix the step roles in the lane's bound steps, add the job's row, or put the merge-path job on gunbc_ci_selected_runner_spec. The gate's needs, env bindings and every conditional are FOLDED from that roster, so they cannot disagree with it and this refusal has nothing to say about them."

fn expected_compiler_gate_yml() -> WitnessFloorGenerationOutcome {
  match admit_workflow_action_uses(workflow: compiler_gate_workflow) {
    WorkflowActionUsesRefused { refusals: rs } =>
      WitnessFloorGenerationRefused { reason: workflow_action_uses_refusal_reason(workflow_module: "gunbc.compiler_gate_workflow", refusals: rs) }
    WorkflowActionUsesAdmitted =>
      match admit_workflow_checkout_refs(workflow: compiler_gate_workflow, declared: [compiler_gate_checkout_ref]) {
    WorkflowCheckoutRefsRefused { refusals: crs } =>
      WitnessFloorGenerationRefused { reason: workflow_checkout_refs_refusal_reason(workflow_module: "gunbc.compiler_gate_workflow", refusals: crs) }
    WorkflowCheckoutRefsAdmitted =>
      match admit_workflow_toolchain_homes(workflow: compiler_gate_workflow) {
        WorkflowToolchainHomeRefused { job_id: j, refusal: r } =>
          WitnessFloorGenerationRefused { reason: toolchain_home_refusal_reason(job_id: j, refusal: r) }
        WorkflowToolchainHomesAdmitted =>
          if compiler_gate_unit_test_capability_closure_holds() && compiler_gate_emit_build_capability_closure_holds() && compiler_gate_floor_capability_closure_holds() && compiler_gate_generated_capability_closure_holds() && compiler_gate_floor_scripts_are_renderable() && compiler_gate_lane_standings_hold() && compiler_gate_merge_path_runs_on_the_fleet() {
            match emit_yaml(v: project_workflow_to_yaml(workflow: compiler_gate_workflow)) {
              EmittedYaml { text: t } => WitnessFloorGenerated { content: t }
              YamlEmitRefused { path: p, reason: r } => WitnessFloorGenerationRefused { reason: yaml_emit_refusal_text(module_path: "gunbc.compiler_gate_workflow", path: p, reason: r) }
            }
          } else {
            WitnessFloorGenerationRefused { reason: compiler_gate_capability_refusal_reason }
          }
      }
  }
  }
}

data compiler_gate_checkout_ref: Expression = ContextAccess { context: Github, path: ["event", "pull_request", "head", "sha"] }
