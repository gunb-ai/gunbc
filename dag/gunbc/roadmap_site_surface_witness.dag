module gunbc.roadmap_site_surface_witness


// The digest the stale fixture substitutes for the roadmap artifact's real one. It is sixteen zeros
// rather than a word like `stale-digest` because Fnv1a64Structural.digest is `String where lower_hex_16`:
// a non-hex marker is not a digest the carrier can hold, so the fixture would have had to be spelled
// outside the producer to carry it, which is the drift this control exists to exclude.
data witness_stale_artifact_digest_hex: String = "0000000000000000"

fn fresh_surface_read_grounds_for_bundle(bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle) -> Bool {
  gunbc.roadmap_site_surface_expect.fresh_surface_read_grounds(
    bundle: bundle,
    read: gunbc.roadmap_site_surface_types.HealthzBodyRead { body: bundle.healthz_body },
  )
}

fn witness_stale_roadmap_artifact(bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle) -> gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact {
  gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceArtifact {
    url_path: bundle.roadmap_md.url_path,
    body: bundle.roadmap_md.body,
    digest: std.content_hash.Fnv1a64Structural { digest: witness_stale_artifact_digest_hex as std.types.NonEmptyStr },
  }
}

// The stale body is rendered by the same producer the route uses, varying exactly one input, and the
// hand-spelled literal it replaces could no longer reach the check it controls. That literal was a
// three-member document with no release identity; once readiness checks identity BEFORE surface, it
// refuses as ProcessIdentityAbsent — a true verdict about a different axis — so the assertion below
// (ServedSurfaceStale, naming the stale digest) would have been asserting a refusal the fixture can no
// longer produce. It was also a second spelling of a document healthz_body_with_release_identity is the
// sole producer of, which is the dual representation DESIGN §3 forbids.
//
// So the fixture is the real document with ONE artifact digest replaced. Probe, parse, identity and
// revision all pass; the surface identity the process reports is the bundle's own, so the
// ProcessSurfaceMismatch arm passes too; and the projected artifact map is the only thing that differs.
// That makes this the discriminating control for the LAST arm specifically — a process reporting the
// expected identity while serving a stale artifact map — which is the case readiness.dag's
// readiness_compares_the_candidate_note names as needing its own control.
fn witness_stale_healthz_body_for_bundle(
  bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle,
  release_revision: std.types.CommitSha,
) -> String {
  gunbc.roadmap_site_surface_render.healthz_body_with_release_identity(
    roadmap: witness_stale_roadmap_artifact(bundle: bundle),
    dispatch: bundle.dispatch_json,
    daily: bundle.daily_html,
    full: bundle.full_html,
    dispatch_js: bundle.dispatch_js,
    release_revision: release_revision,
    surface_bundle_identity: bundle.bundle_identity,
  )
}

fn stale_surface_read_does_not_ground_for_bundle(
  bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle,
  release_revision: std.types.CommitSha,
) -> Bool {
  let stale_body = witness_stale_healthz_body_for_bundle(
    bundle: bundle,
    release_revision: release_revision,
  )
  gunbc.roadmap_site_surface_expect.stale_surface_read_does_not_ground(bundle: bundle, stale_body: stale_body)
    && match gunbc.live_deploy.readiness.ground_service_ready_from_healthz_with_bundle(
      read: gunbc.roadmap_site_surface_types.HealthzBodyRead { body: stale_body },
      bundle: bundle,
      expected_revision: release_revision,
      expected_surface_identity: bundle.bundle_identity,
    ) {
      std.realization_reconcile.DoesNotGround { reason: why } =>
        string_contains(s: why, pattern: "ServedSurfaceStale")
          && string_contains(s: why, pattern: witness_stale_artifact_digest_hex)
          && !string_contains(s: why, pattern: "JSON.parse")
          && !string_contains(s: why, pattern: "ProcessIdentityAbsent")
          && !string_contains(s: why, pattern: "ProcessRevisionMismatch")
          && !string_contains(s: why, pattern: "ProcessSurfaceMismatch")
      std.realization_reconcile.Grounds { evidence: _ } => false
    }
}

fn reconcile_grounds_healthy_fixture_read_for_bundle(
  bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle,
  release_revision: std.types.CommitSha,
) -> Bool {
  std.realization_reconcile.reconciliation_converged(
    r: gunbc.live_deploy.readiness.reconcile_service_ready_read_for_bundle(
      read: gunbc.live_deploy.readiness.show_healthz_read_fixture_healthy(bundle: bundle, release_revision: release_revision),
      bundle: bundle,
      effect: gunbc.live_deploy.readiness.service_ready_apply_effect(),
      expected_revision: release_revision,
      expected_surface_identity: bundle.bundle_identity,
    )
  )
}

fn service_ready_once_converges_on_healthy_fixture_for_bundle(
  bundle: gunbc.roadmap_site_surface_types.RoadmapSiteSurfaceBundle,
  release_revision: std.types.CommitSha,
) -> Bool {
  std.realization_reconcile.reconciliation_converged(
    r: gunbc.live_deploy.readiness.live_deploy_service_ready_once_for_bundle(
      bundle: bundle,
      release_revision: release_revision,
    )
  )
}

// The revision arrives from the caller, and that is why this module declares no sha. Readiness compares
// against the release a deploy admitted, so every helper here needs one — but the single fixture revision
// the deploy witnesses share is declared in test.claim.live_deploy.deploy_release_fixture, deliberately
// under dag/test/ so no production module can name it. Threading it in as a parameter keeps that
// containment intact and keeps this module free of a second synthetic sha that could drift from it.
fn roadmap_site_surface_readiness_group_holds(release_revision: std.types.CommitSha) -> Bool {
  let live = gunbc.roadmap_site_surface_observe.live_roadmap_site_surface_bundle()
  let bundle = live.bundle
  gunbc.roadmap_site_surface_expect.healthz_round_trip_receipt_holds(bundle: bundle)
    && fresh_surface_read_grounds_for_bundle(bundle: bundle)
    && stale_surface_read_does_not_ground_for_bundle(bundle: bundle, release_revision: release_revision)
    && reconcile_grounds_healthy_fixture_read_for_bundle(bundle: bundle, release_revision: release_revision)
    && service_ready_once_converges_on_healthy_fixture_for_bundle(bundle: bundle, release_revision: release_revision)
    && gunbc.roadmap_site_surface_expect.healthz_surface_tolerates_transport_trailing_lf(bundle: bundle)
    && gunbc.roadmap_site_surface_expect.healthz_route_json_ok(bundle: bundle)
}
