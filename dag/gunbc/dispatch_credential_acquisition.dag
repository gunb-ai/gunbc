data credential_acquisition_slots_dirname: String = "credential-acquisition-slots"

fn credential_acquisition_slots_root(instance_root: String) -> NonEmptyStr {
  join([instance_root, "/", credential_acquisition_slots_dirname], "") as NonEmptyStr
}

// THE SLOTS ROOT IS A DEMANDED DIRECTORY, declared here beside the path it is. The CAS slot store
// (gunbc.durable_cas_file_store) refuses a root it cannot list rather than reading it as empty, so
// a root nothing creates refuses every executor that acquires a credential snapshot at its first
// slot: the srv1 lab's first claude dispatch did exactly that (2026-10-16, "the directory
// .../credential-acquisition-slots could not be listed"). Its creator is the one instance
// directory list (gunbc.roadmap.dashboard_instance_directories), which both deployment routes
// ensure and read back. Owner-only: the slots record which attempt holds which credential.
fn credential_acquisition_slots_directory(instance: HostDashboardInstance) -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: "credential-acquisition-slots" as NonEmptyStr,
    path: credential_acquisition_slots_root(instance_root: instance.instance_root as String) as String as FilePath,
    owner: instance.directory_owner,
    mode: DirectoryOwnerOnly,
    group_adoption: ForeignOwnershipRefuses,
  }
}

// THE CURSOR RUNTIME PARENT IS AN INSTANCE DIRECTORY, declared beside the path it is and enrolled in the one
// list (gunbc.roadmap.dashboard_instance_directories). Deployment ensures it at an explicit mode and reads it
// back; an attempt creates only its own base under it and never creates or repairs the parent.
fn cursor_attempt_runtime_directory(instance: HostDashboardInstance) -> OwnedDirectoryTarget {
  OwnedDirectoryDeclared {
    member: "cursor-attempt-runtime" as NonEmptyStr,
    path: cursor_attempt_runtime_parent(instance_root: instance.instance_root as String) as FilePath,
    owner: instance.directory_owner,
    mode: DirectoryOwnerOnly,
    group_adoption: ForeignOwnershipRefuses,
  }
}

fn credential_acquisition_reference(identity: String, executor: SnapshotExecutor) -> NonEmptyStr {
  join([identity, "-", match executor { ClaudeFromSnapshot => "claude"  CursorFromSnapshot => "cursor" }], "") as NonEmptyStr
}

// Drain is ENOENT or cgroup.events populated 0 on the recorded ControlGroup. Recovery
// observes that path from outside the belt cgroup, so a drained path already means every
// process of every invocation in the cgroup has ended. A later invocation in the same
// cgroup stays populated 1 and preserves. invocation_id is therefore not a record field:
// it would not distinguish a state the path standing does not already establish.
// producer_pid, producer_namespace and boot_id are deleted rather than filled.
// THE CURSOR ATTEMPT'S RUNTIME ROOT: the one directory a keyed cursor-agent invocation of this attempt
// may use as its HOME and config root, because a keyed invocation persists the credential under the
// config root it runs with (extdeps.llm.cursor_cli, observed 2026-10-17). The record persists ONLY that the
// attempt registered such a root (AttemptCursor { runtime_root: CursorRuntimeRootRegistered }); it never persists a path. The root is
// DERIVED, always, from the instance root of the slot being acted on plus the record's own reference
// (cursor_attempt_runtime_root), so a record cannot name a foreign directory and recovery cannot be
// steered outside the instance. Registration is durable BEFORE the directory exists, so owner death
// between the two cannot orphan it, and a registered root never created is a clean no-op removal.
// OWNERSHIP IS ESTABLISHED BY CREATION: the attempt's base is created create-only, then an owner marker
// directory named by the reference and opened_at is created inside it. Only a root carrying that marker is
// ever removed. A create-only mkdir that loses proves the attempt does NOT own what is there, so the root
// stays in place for good: recovery sees no marker and leaves it alone. The record is indexed by executor, so
// only the Cursor arm can carry the registration and a Claude record cannot (it is not a value to refuse).
// A cursor record in the format before this field decodes as CursorRuntimeRootUnregistered.
// CONSUMERS (DESIGN 3c): gunbc.cursor_harness_credential cursor_runtime_environment binds
// HOME=<base>/home and XDG_CONFIG_HOME=<base>/config (cursor_attempt_runtime_home/_config) on the sandbox
// preflight, the key probe and the worker turn, through credential_taken_cursor_runtime_root.
type CursorRuntimeRootRegistration
  = CursorRuntimeRootUnregistered
  | CursorRuntimeRootRegistered

type AttemptExecutor
  = AttemptClaude
  | AttemptCursor { runtime_root: CursorRuntimeRootRegistration }

fn attempt_executor_word(executor: AttemptExecutor) -> String {
  match executor {
    AttemptClaude => "claude"
    AttemptCursor { runtime_root: _ } => "cursor"
  }
}

// The derived root: never persisted, never read back from a record.
type CursorAttemptRuntimeRoot {
  base: String
}

data cursor_attempt_runtime_dirname: String = "cursor-attempt-runtime"
data cursor_attempt_runtime_home_dirname: String = "home"
data cursor_attempt_runtime_config_dirname: String = "config"

fn cursor_attempt_runtime_root(instance_root: String, reference: String) -> CursorAttemptRuntimeRoot {
  CursorAttemptRuntimeRoot { base: join([instance_root, cursor_attempt_runtime_dirname, reference], "/") }
}

fn cursor_attempt_runtime_parent(instance_root: String) -> String {
  join([instance_root, cursor_attempt_runtime_dirname], "/")
}

fn cursor_attempt_runtime_owner_marker_name(reference: String, opened_at: EpochSecs) -> String {
  join(["owner-", reference, "-", to_string(value: opened_at)], "")
}

// The runtime root of a taken attempt's Cursor draw, derived the one way the create, the discard and the
// recovery derive it (instance root plus the record's own reference), so every Cursor invocation of the
// attempt (gunbc.worker_turn_standing, gunbc.roadmap.roadmap_dispatch_actuator) binds the root that
// credential_register_then_take created.
fn credential_taken_cursor_runtime_root(snapshot: TakenCredentialSnapshot) -> CursorAttemptRuntimeRoot {
  let attempt = taken_credential_snapshot_attempt(snapshot: snapshot)
  cursor_attempt_runtime_root(
    instance_root: attempt.instance.instance_root as String,
    reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: CursorFromSnapshot) as String,
  )
}

fn cursor_attempt_runtime_home(root: CursorAttemptRuntimeRoot) -> String {
  join([root.base, cursor_attempt_runtime_home_dirname], "/")
}

fn cursor_attempt_runtime_config(root: CursorAttemptRuntimeRoot) -> String {
  join([root.base, cursor_attempt_runtime_config_dirname], "/")
}

type CredentialAcquisitionRecord {
  identity: String
  node_id: String
  reference: String
  executor: AttemptExecutor
  snapshot_path: String
  belt_unit: String
  control_group: String
  opened_at: EpochSecs
  launch_deadline: EpochSecs
  state: AttemptState
}

fn credential_record_with_state(r: CredentialAcquisitionRecord, state: AttemptState) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: r.identity, node_id: r.node_id, reference: r.reference, executor: r.executor, snapshot_path: r.snapshot_path,
    belt_unit: r.belt_unit, control_group: r.control_group,
    opened_at: r.opened_at, launch_deadline: r.launch_deadline, state: state,
  }
}

fn credential_record_json(r: CredentialAcquisitionRecord) -> String {
  serialize_json(v: json_object(members: list_append(left: [
    json_kv(key: "identity", value: json_string(s: r.identity)),
    json_kv(key: "node_id", value: json_string(s: r.node_id)),
    json_kv(key: "reference", value: json_string(s: r.reference)),
    json_kv(key: "executor", value: json_string(s: attempt_executor_word(executor: r.executor))),
    json_kv(key: "snapshot_path", value: json_string(s: r.snapshot_path)),
    json_kv(key: "belt_unit", value: json_string(s: r.belt_unit)),
    json_kv(key: "control_group", value: json_string(s: r.control_group)),
    json_kv(key: "opened_at", value: json_int(n: r.opened_at)),
    json_kv(key: "launch_deadline", value: json_int(n: r.launch_deadline)),
    json_kv(key: "state", value: json_string(s: attempt_state_wire(s: r.state))),
    json_kv(key: "detail", value: json_string(s: match r.state { AttemptTerminal { verdict: _, detail: d } => d  AttemptReserved => ""  AttemptLaunching => "" })),
  ], right: match r.executor {
    AttemptCursor { runtime_root: CursorRuntimeRootRegistered } => [json_kv(key: "cursor_runtime_root", value: JsonBool { value: true })]
    AttemptCursor { runtime_root: CursorRuntimeRootUnregistered } => []
    AttemptClaude => []
  })))
}

fn credential_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value } => match value { JsonString { value: s } => Present { value: s }  _ => none }
    _ => none
  }
}

fn credential_member_epoch(doc: JsonValue, key: String) -> EpochSecs? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value } => match value { JsonNumber { lexeme: n } => match parse_int(s: n as String) { Present { value: i } => if i < 0 { none } else { Present { value: i } }  Absent => none }  _ => none }
    _ => none
  }
}

type CredentialExecutorRead
  = ExecutorRead { executor: AttemptExecutor }
  | ExecutorUnreadable

// The executor word selects the arm and the arm owns the registration member: a cursor record reads it
// (absent is the format before the field, true is registered), and a claude record must not carry the
// member at all. Any other spelling of the member refuses the record.
fn credential_executor_read(doc: JsonValue, executor_word: String) -> CredentialExecutorRead {
  let member = json_object_unique_member(v: doc, key: "cursor_runtime_root")
  if executor_word == "claude" {
    match member {
      JsonMemberAbsent => ExecutorRead { executor: AttemptClaude }
      _ => ExecutorUnreadable
    }
  } else if executor_word == "cursor" {
    match member {
      JsonMemberAbsent => ExecutorRead { executor: AttemptCursor { runtime_root: CursorRuntimeRootUnregistered } }
      JsonMemberFound { value } =>
        match value {
          JsonBool { value: true } => ExecutorRead { executor: AttemptCursor { runtime_root: CursorRuntimeRootRegistered } }
          _ => ExecutorUnreadable
        }
      _ => ExecutorUnreadable
    }
  } else {
    ExecutorUnreadable
  }
}

fn credential_record_decode(text: String) -> CredentialAcquisitionRecord? {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: doc } =>
      match credential_member(doc: doc, key: "identity") {
        Absent => none
        Present { value: identity } =>
          match credential_member(doc: doc, key: "node_id") {
            Absent => none
            Present { value: node_id } =>
          match credential_member(doc: doc, key: "reference") {
            Absent => none
            Present { value: reference } =>
              match credential_member(doc: doc, key: "executor") {
                Absent => none
                Present { value: executor_word } =>
                  match credential_member(doc: doc, key: "snapshot_path") {
                    Absent => none
                    Present { value: snapshot_path } =>
                      match credential_member(doc: doc, key: "belt_unit") {
                        Absent => none
                        Present { value: belt_unit } =>
                          match credential_member(doc: doc, key: "control_group") {
                            Absent => none
                            Present { value: control_group } =>
                              match credential_member_epoch(doc: doc, key: "opened_at") {
                                Absent => none
                                Present { value: opened_at } =>
                                  match credential_member_epoch(doc: doc, key: "launch_deadline") {
                                    Absent => none
                                    Present { value: launch_deadline } =>
                                      match credential_member(doc: doc, key: "state") {
                                        Absent => none
                                        Present { value: word } =>
                                          match attempt_state_decode(word: word, detail: match credential_member(doc: doc, key: "detail") { Present { value: d } => d  Absent => "" }) {
                                            Absent => none
                                            Present { value: state } =>
                                              match credential_executor_read(doc: doc, executor_word: executor_word) {
                                                ExecutorUnreadable => none
                                                ExecutorRead { executor } =>
                                                  Present { value: CredentialAcquisitionRecord {
                                                    identity: identity, node_id: node_id, reference: reference, executor: executor, snapshot_path: snapshot_path,
                                                    belt_unit: belt_unit, control_group: control_group,
                                                    opened_at: opened_at, launch_deadline: launch_deadline, state: state,
                                                  } }
                                              }
                                          }
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
          }
      }
  }
}

fn credential_record_reference(r: CredentialAcquisitionRecord) -> String { r.reference }
fn credential_record_state(r: CredentialAcquisitionRecord) -> AttemptState { r.state }
fn credential_record_opened_at(r: CredentialAcquisitionRecord) -> EpochSecs { r.opened_at }
fn credential_record_launch_deadline(r: CredentialAcquisitionRecord) -> EpochSecs { r.launch_deadline }

fn credential_acquisition_codec() -> AttemptPayloadCodec<CredentialAcquisitionRecord>
  admit_callers: [
    decl_ref(module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_open"),
    decl_ref(module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_begin_launch"),
    decl_ref(module_path: "gunbc.dispatch_credential_acquisition", decl_name: "credential_terminate"),
  ]
{
  AttemptPayloadCodec {
    encode: credential_record_json,
    decode: credential_record_decode,
    reference_of: credential_record_reference,
    state_of: credential_record_state,
    with_state: credential_record_with_state,
    opened_at: credential_record_opened_at,
    launch_deadline: credential_record_launch_deadline,
  }
}

type CredentialReaderStanding
  = CredentialReaderEnded
  | CredentialReaderRunning
  | CredentialReaderUnobserved { detail: String }

fn credential_reader_standing(process: WorkerProcessEvidence) -> CredentialReaderStanding {
  match process {
    WorkerProcessRunning { command: _ } => CredentialReaderRunning
    WorkerProcessUnobserved { reason: r } => CredentialReaderUnobserved { detail: r as String }
    WorkerProcessAbsent => CredentialReaderEnded
    WorkerProcessExited { exit_code: _, last_command: _ } => CredentialReaderEnded
    WorkerProcessSignaled { signal: _, last_command: _ } => CredentialReaderEnded
  }
}

fn credential_open(root: NonEmptyStr, record: CredentialAcquisitionRecord) -> AttemptTransition {
  attempt_open_payload(store: file_slot_store(root: root), record: record, codec: credential_acquisition_codec())
}

fn credential_begin_launch(root: NonEmptyStr, reference: NonEmptyStr, expected: CasGeneration) -> AttemptTransition {
  attempt_begin_launch_payload(
    store: file_slot_store(root: root),
    reference: reference,
    expected: expected,
    codec: credential_acquisition_codec())
}

fn credential_terminate(
  root: NonEmptyStr,
  reference: NonEmptyStr,
  expected: CasGeneration,
  verdict: AttemptVerdict,
  detail: String,
  reader: CredentialReaderStanding,
) -> AttemptTransition {
  match observe_cas_slot_state(root: root, key: reference) {
    CasObservedUnreadable { cause: c } =>
      AttemptTransitionRefused { detail: join(["the attempt slot could not be read: ", cas_unreadable_slot_detail(cause: c)], "") }
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent =>
          AttemptLostRace { expected: join(["generation ", to_string(value: cas_generation_count(g: expected))], ""), observed: "an absent slot" }
        CasReadablePresent { version: v } =>
          match credential_record_decode(text: v.value as String) {
            Absent =>
              AttemptTransitionRefused { detail: "the credential slot holds a record this fold cannot decode" }
            Present { value: rec } =>
              match rec.state {
                AttemptLaunching =>
                  match reader {
                    CredentialReaderEnded =>
                      attempt_terminate_payload(
                        store: file_slot_store(root: root),
                        reference: reference,
                        expected: expected,
                        verdict: verdict,
                        detail: detail,
                        codec: credential_acquisition_codec())
                    CredentialReaderRunning =>
                      AttemptTransitionRefused { detail: "Launching may only terminate after the launched reader has ended" }
                    CredentialReaderUnobserved { detail: d } =>
                      AttemptTransitionRefused {
                        detail: join(["Launching may only terminate after the launched reader has ended; reader unobserved: ", d], ""),
                      }
                  }
                AttemptReserved =>
                  attempt_terminate_payload(
                    store: file_slot_store(root: root),
                    reference: reference,
                    expected: expected,
                    verdict: verdict,
                    detail: detail,
                    codec: credential_acquisition_codec())
                AttemptTerminal { verdict: _, detail: _ } =>
                  attempt_terminate_payload(
                    store: file_slot_store(root: root),
                    reference: reference,
                    expected: expected,
                    verdict: verdict,
                    detail: detail,
                    codec: credential_acquisition_codec())
              }
          }
      }
  }
}

fn observe_self_control_group() -> String? {
  let raw = Filesystem.Read(path: procfs_path_literal(p: ProcSelfCgroup) as String)
  if raw.success {
    match read_unified_cgroup_membership(content: raw.content) {
      CurrentCgroupObserved { relative_path: rel } => Present { value: rel as String }
      MembershipMissing => none
      MembershipAmbiguous { first: _, second: _ } => none
      MembershipMalformed { cause: _ } => none
    }
  } else {
    none
  }
}

fn belt_unit_from_control_group(control_group: String) -> String {
  fold(split(s: control_group, delimiter: "/"), init: "", f: (acc, part) => if trim(s: part) == "" { acc } else { trim(s: part) })
}

type ProducerIdentity
  = ProducerIdentified { control_group: String, belt_unit: String }
  | ProducerUnidentified { detail: String }

fn observe_producer_identity() -> ProducerIdentity {
  match observe_self_control_group() {
    Absent => ProducerUnidentified { detail: "Unidentified: /proc/self/cgroup (extdeps.linux.procfs ProcSelfCgroup) did not yield a unified membership" }
    Present { value: cg } =>
      if trim(s: cg) == "" {
        ProducerUnidentified { detail: "Unidentified: unified cgroup membership was empty" }
      } else {
        ProducerIdentified { control_group: cg, belt_unit: belt_unit_from_control_group(control_group: cg) }
      }
  }
}

type LaunchLostOutcome
  = CredentialLaunchAdmitted
  | LaunchLostSnapshotDiscarded
  | LaunchLostDiscardFailed { reason: NonEmptyStr }

// THE ONE DISCARD OF A TAKEN ATTEMPT: the snapshot is tombstoned AND the attempt's own Cursor runtime root
// is retired, so no exit that never launches a child leaves either behind (refusal, lost launch, spawn
// failure). A SUCCESSFUL spawn never reaches this: the child keeps the root while it lives and the A3
// recovery removes it after producer drain plus reader-ended evidence. Both are attempted whichever fails
// first and BOTH causes are returned; the registered record keeps the cleanup owed for A3 to retry. The
// root is derived from the attempt's instance root and the record's own reference, and retired only if
// the attempt established ownership of it, so a lost create-only mkdir never leads to a deletion.
fn credential_discard_taken_attempt(snapshot: TakenCredentialSnapshot) -> CredentialSnapshotDiscard {
  let tombstoned = dispatch_credential_snapshot_discard(snapshot: snapshot)
  let attempt = taken_credential_snapshot_attempt(snapshot: snapshot)
  let executor = taken_credential_snapshot_executor(snapshot: snapshot)
  let instance_root = attempt.instance.instance_root as String
  let removed = match executor {
    ClaudeFromSnapshot => CredentialSealed { path: "" }
    CursorFromSnapshot =>
      match credential_slot_record(instance_root: instance_root, reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: executor)) {
        Absent => CredentialSealFailed { detail: "the attempt record could not be read, so ownership of the cursor runtime root is unknown and it stays owed" }
        Present { value: rec } => credential_retire_cursor_runtime_root(record: rec, instance_root: instance_root)
      }
  }
  match tombstoned {
    CredentialSnapshotTombstoneFailed { reason: r } =>
      CredentialSnapshotTombstoneFailed { reason: join([r as String, credential_removal_owed_note(removed: removed)], "") as NonEmptyStr }
    CredentialSnapshotTombstoned =>
      match removed {
        CredentialSealFailed { detail: d } => CredentialSnapshotTombstoneFailed { reason: d as NonEmptyStr }
        CredentialSealed { path: _ } => CredentialSnapshotTombstoned
        CredentialCleanupOwed { reason: d } => CredentialSnapshotTombstoneFailed { reason: d as NonEmptyStr }
      }
  }
}

fn credential_discard_taken_snapshot(snapshot: TakenCredentialSnapshot) -> LaunchLostOutcome {
  match credential_discard_taken_attempt(snapshot: snapshot) {
    CredentialSnapshotTombstoned => LaunchLostSnapshotDiscarded
    CredentialSnapshotTombstoneFailed { reason: r } => LaunchLostDiscardFailed { reason: r }
  }
}

fn credential_begin_launch_or_discard(
  root: NonEmptyStr,
  reference: NonEmptyStr,
  expected: CasGeneration,
  snapshot: TakenCredentialSnapshot,
) -> LaunchLostOutcome {
  match credential_begin_launch(
    root: root,
    reference: reference,
    expected: expected,
  ) {
    AttemptAdvanced { state: _, generation: _ } => CredentialLaunchAdmitted
    AttemptLostRace { expected: _, observed: _ } =>
      credential_discard_taken_snapshot(snapshot: snapshot)
    AttemptTransitionRefused { detail: _ } =>
      credential_discard_taken_snapshot(snapshot: snapshot)
  }
}

fn credential_admit_reader_or_discard(snapshot: TakenCredentialSnapshot) -> LaunchLostOutcome {
  let attempt = taken_credential_snapshot_attempt(snapshot: snapshot)
  let root = credential_acquisition_slots_root(instance_root: attempt.instance.instance_root as String)
  let reference = credential_acquisition_reference(
    identity: attempt.attempt_key,
    executor: taken_credential_snapshot_executor(snapshot: snapshot))
  match observe_cas_slot_state(root: root, key: reference) {
    CasObservedUnreadable { cause: _ } =>
      credential_discard_taken_snapshot(snapshot: snapshot)
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent =>
          credential_discard_taken_snapshot(snapshot: snapshot)
        CasReadablePresent { version: v } =>
          match credential_record_decode(text: v.value as String) {
            Absent =>
              credential_discard_taken_snapshot(snapshot: snapshot)
            Present { value: rec } =>
              match rec.state {
                AttemptReserved =>
                  credential_begin_launch_or_discard(
                    root: root,
                    reference: reference,
                    expected: cas_generation_first(),
                    snapshot: snapshot)
                AttemptLaunching =>
                  credential_discard_taken_snapshot(snapshot: snapshot)
                AttemptTerminal { verdict: _, detail: _ } =>
                  credential_discard_taken_snapshot(snapshot: snapshot)
              }
          }
      }
  }
}

type CredentialSealReceipt
  = CredentialSealed { path: String }
  | CredentialSealFailed { detail: String }
  | CredentialCleanupOwed { reason: String }

fn credential_snapshot_is_tombstone(text: String) -> Bool {
  trim(s: text) == trim(s: credential_snapshot_tombstone_body)
}

fn credential_occupy_snapshot(path: String) -> CredentialSealReceipt {
  match credential_occupy_tombstone(path: path) {
    CredentialOccupied => CredentialSealed { path: path }
    CredentialOccupyFailed { detail: d } => CredentialSealFailed { detail: d }
  }
}

// THE RUNTIME ROOT IS REMOVED UNDER THE SAME GATE AS THE SNAPSHOT TOMBSTONE and by the same fold, but it
// is a separate release: a successful spawn tombstones the snapshot while the child keeps using the
// root. The path is never read from the record: it is derived from the instance root of the slot being
// recovered and the record's own reference.
// THE MECHANISM IS THE ONE gunbc.fabric.fabric_source_snapshot ALREADY RULED ON (operator ruling
// 2026-09-21: the owning uid is inside the trust boundary): a constructed location with derived ancestry,
// whose shared parent must satisfy the level rule (owned by this uid or root, not writable by others
// unless sticky) and be its own canonical spelling, and whose base must be owner-only and canonical. It is
// checked before create and before every removal, and each observation is typed (a listing is absent,
// listed or indeterminate), never an exit code. A symlink planted by anyone else cannot satisfy the rule.
// RESIDUAL, DECLARED UNDER gunbc.recurring_failure_mode a_pathname_reresolves_its_ancestry_between_calls:
// the same uid swapping a level between the check and rm re-resolves the path. The Cursor CLI runs as this
// uid but its commands run in a workspace-only sandbox that cannot write the instance root. That RFM's
// trigger (directory-anchored, openat-style primitives in the .dag filesystem surface) closes it here
// and for every consumer; this module does not mint a second mechanism beside it.
type CursorRuntimeRootCreation
  = CursorRuntimeRootCreated
  | CursorRuntimeRootCreationRefused { detail: String }

type CursorRuntimeRootFact
  = CursorRuntimeRootNotRegistered
  | CursorRuntimeRootAbsent
  | CursorRuntimeRootOwned
  | CursorRuntimeRootNotOwned { detail: String }
  | CursorRuntimeRootAncestryRefused { detail: String }
  | CursorRuntimeRootUnreadable { detail: String }

fn credential_attempt_executor_for(executor: SnapshotExecutor) -> AttemptExecutor {
  match executor {
    ClaudeFromSnapshot => AttemptClaude
    CursorFromSnapshot => AttemptCursor { runtime_root: CursorRuntimeRootRegistered }
  }
}

fn credential_slot_record(instance_root: String, reference: NonEmptyStr) -> CredentialAcquisitionRecord? {
  match observe_cas_slot_state(root: credential_acquisition_slots_root(instance_root: instance_root), key: reference) {
    CasObservedUnreadable { cause: _ } => none
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent => none
        CasReadablePresent { version: v } => credential_record_decode(text: v.value as String)
      }
  }
}

fn credential_record_registers_runtime_root(record: CredentialAcquisitionRecord) -> Bool {
  match record.executor {
    AttemptClaude => false
    AttemptCursor { runtime_root: CursorRuntimeRootUnregistered } => false
    AttemptCursor { runtime_root: CursorRuntimeRootRegistered } => true
  }
}

fn credential_list_entry(directory: String, name: String) -> FilesystemEntryPresence {
  let listed = Filesystem.List(path: directory)
  filesystem_entry_presence(
    listing: filesystem_listing_observation(directory: directory, success: listed.success, entries: listed.entries, error: listed.error),
    name: name,
  )
}

type CursorRuntimeAncestry
  = CursorRuntimeAncestrySafe
  | CursorRuntimeAncestryRefused { detail: String }

// The level rule over the shared parent, with the principal observed once: a parent another uid could
// substitute, or one that is a link, refuses.
fn cursor_runtime_parent_ancestry(instance_root: String) -> CursorRuntimeAncestry {
  match observe_provider_principal() {
    Absent => CursorRuntimeAncestryRefused { detail: "the process principal could not be observed, so the cursor runtime parent is not judged safe" }
    Present { value: principal } =>
      match ancestry_is_safe(levels: [instance_root, cursor_attempt_runtime_parent(instance_root: instance_root)], trusted: trusted_owners_of(principal: principal)) {
        AncestrySafe => CursorRuntimeAncestrySafe
        AncestryRefused { level: l, detail: d } => CursorRuntimeAncestryRefused { detail: join(["the cursor runtime level ", l, " is refused: ", d], "") }
      }
  }
}

// The attempt's base must be owner-only and its own canonical spelling.
fn cursor_runtime_base_ancestry(root: CursorAttemptRuntimeRoot) -> CursorRuntimeAncestry {
  match observe_provider_principal() {
    Absent => CursorRuntimeAncestryRefused { detail: "the process principal could not be observed, so the cursor runtime base is not judged safe" }
    Present { value: principal } => {
      let observed = observe_level(path: root.base)
      if !base_is_admissible(observed: observed, trusted: trusted_owners_of(principal: principal)) {
        CursorRuntimeAncestryRefused { detail: join(["the cursor runtime base ", root.base, " is not an owner-only directory of this process: ", ancestry_refusal_detail(observed: observed)], "") }
      } else if !level_spelling_is_canonical(level: root.base) {
        CursorRuntimeAncestryRefused { detail: join(["the cursor runtime base ", root.base, " is not its own canonical spelling, so it is a link"], "") }
      } else {
        CursorRuntimeAncestrySafe
      }
    }
  }
}

// What stands at the derived root, as typed observations: only a positively absent shared parent or base is
// Absent, only a listed base whose listing positively lacks the marker is NotOwned, and everything that
// could not be looked at is a loud, owed failure.
fn observe_cursor_runtime_root_fact(record: CredentialAcquisitionRecord, instance_root: String) -> CursorRuntimeRootFact {
  if !credential_record_registers_runtime_root(record: record) {
    CursorRuntimeRootNotRegistered
  } else {
    let root = cursor_attempt_runtime_root(instance_root: instance_root, reference: record.reference)
    match credential_list_entry(directory: instance_root, name: cursor_attempt_runtime_dirname) {
      FilesystemEntryAbsent(_) => CursorRuntimeRootAbsent
      FilesystemEntryPresenceIndeterminate { cause: c } => CursorRuntimeRootUnreadable { detail: c }
      FilesystemEntrySubjectRefused { directory: _, name: _, cause: c } => CursorRuntimeRootUnreadable { detail: c }
      FilesystemEntryListed { directory: _, name: _ } =>
        match cursor_runtime_parent_ancestry(instance_root: instance_root) {
          CursorRuntimeAncestryRefused { detail: d } => CursorRuntimeRootAncestryRefused { detail: d }
          CursorRuntimeAncestrySafe =>
            match credential_list_entry(directory: cursor_attempt_runtime_parent(instance_root: instance_root), name: record.reference) {
              FilesystemEntryAbsent(_) => CursorRuntimeRootAbsent
              FilesystemEntryPresenceIndeterminate { cause: c } => CursorRuntimeRootUnreadable { detail: c }
              FilesystemEntrySubjectRefused { directory: _, name: _, cause: c } => CursorRuntimeRootUnreadable { detail: c }
              FilesystemEntryListed { directory: _, name: _ } =>
                match cursor_runtime_base_ancestry(root: root) {
                  CursorRuntimeAncestryRefused { detail: d } => CursorRuntimeRootAncestryRefused { detail: d }
                  CursorRuntimeAncestrySafe =>
                    match credential_list_entry(directory: root.base, name: cursor_attempt_runtime_owner_marker_name(reference: record.reference, opened_at: record.opened_at)) {
                      FilesystemEntryAbsent(_) => CursorRuntimeRootNotOwned { detail: join(["the cursor runtime root of ", record.reference, " carries no owner marker of this attempt, so it is not removed"], "") }
                      FilesystemEntryPresenceIndeterminate { cause: c } => CursorRuntimeRootUnreadable { detail: c }
                      FilesystemEntrySubjectRefused { directory: _, name: _, cause: c } => CursorRuntimeRootUnreadable { detail: c }
                      FilesystemEntryListed { directory: _, name: _ } => CursorRuntimeRootOwned
                    }
                }
            }
        }
    }
  }
}

// Created AFTER the record names it (credential_register_then_take opens the record first). The shared
// parent must satisfy the level rule; the attempt's base is create-only at mode 0700 (a pre-existing root
// is refused and left in place for good), then it must itself be owner-only and canonical; the owner marker,
// home and config follow, all 0700 at creation. A failure AFTER the base was created removes what this
// attempt created; a refusal BEFORE it leaves whatever stands there untouched.
fn credential_create_cursor_runtime_root(record: CredentialAcquisitionRecord, instance_root: String) -> CursorRuntimeRootCreation {
  if !credential_record_registers_runtime_root(record: record) {
    CursorRuntimeRootCreated
  } else {
    let root = cursor_attempt_runtime_root(instance_root: instance_root, reference: record.reference)
      match cursor_runtime_parent_ancestry(instance_root: instance_root) {
        CursorRuntimeAncestryRefused { detail: d } => CursorRuntimeRootCreationRefused { detail: join([d, " (the cursor runtime parent is an instance directory ensured by deployment; an absent or unsafe one is refused, never created by an attempt)"], "") }
        CursorRuntimeAncestrySafe => {
          let base = run_shell_command_observe(command: mkdir_create_only_with_mode_command(path: root.base, octal_mode: declared_directory_mode_octal(m: DirectoryOwnerOnly) as NonEmptyStr), transport: LocalExec)
          if base.exit_code != 0 {
            CursorRuntimeRootCreationRefused { detail: join(["the cursor runtime root ", root.base, " was not created by this attempt, so it is not owned and is left in place (create-only refuses a pre-existing root): ", trim(s: base.stderr)], "") }
          } else {
            match cursor_runtime_base_ancestry(root: root) {
              CursorRuntimeAncestryRefused { detail: d } =>
                CursorRuntimeRootCreationRefused { detail: join([d, credential_removal_owed_note(removed: credential_remove_cursor_runtime_root_at(root: root, reference: record.reference, opened_at: record.opened_at))], "") }
              CursorRuntimeAncestrySafe => {
                let marker = run_shell_command_observe(command: mkdir_create_only_with_mode_command(path: join([root.base, cursor_attempt_runtime_owner_marker_name(reference: record.reference, opened_at: record.opened_at)], "/"), octal_mode: declared_directory_mode_octal(m: DirectoryOwnerOnly) as NonEmptyStr), transport: LocalExec)
                let home = run_shell_command_observe(command: mkdir_create_only_with_mode_command(path: cursor_attempt_runtime_home(root: root), octal_mode: declared_directory_mode_octal(m: DirectoryOwnerOnly) as NonEmptyStr), transport: LocalExec)
                let config = run_shell_command_observe(command: mkdir_create_only_with_mode_command(path: cursor_attempt_runtime_config(root: root), octal_mode: declared_directory_mode_octal(m: DirectoryOwnerOnly) as NonEmptyStr), transport: LocalExec)
                if marker.exit_code == 0 && home.exit_code == 0 && config.exit_code == 0 {
                  CursorRuntimeRootCreated
                } else {
                  let removed = credential_remove_cursor_runtime_root_at(root: root, reference: record.reference, opened_at: record.opened_at)
                  CursorRuntimeRootCreationRefused { detail: join(["the cursor runtime root ", root.base, " marker, home or config could not be created: ", trim(s: marker.stderr), trim(s: home.stderr), trim(s: config.stderr), credential_removal_owed_note(removed: removed)], "") }
                }
              }
            }
          }
        }
      }
  }
}

// Retires the root only when ownership stands. Not registered, never created and positively not owned are a
// clean no-op (the last deliberately leaves a foreign root alone); a refused level or an unreadable listing
// is a loud, owed failure.
fn credential_retire_cursor_runtime_root(record: CredentialAcquisitionRecord, instance_root: String) -> CredentialSealReceipt {
  match observe_cursor_runtime_root_fact(record: record, instance_root: instance_root) {
    CursorRuntimeRootNotRegistered => CredentialSealed { path: "" }
    CursorRuntimeRootAbsent => CredentialSealed { path: "" }
    CursorRuntimeRootNotOwned { detail: _ } => CredentialSealed { path: "" }
    CursorRuntimeRootAncestryRefused { detail: d } => CredentialSealFailed { detail: d }
    CursorRuntimeRootUnreadable { detail: d } => CredentialSealFailed { detail: d }
    CursorRuntimeRootOwned => credential_remove_cursor_runtime_root_at(root: cursor_attempt_runtime_root(instance_root: instance_root, reference: record.reference), reference: record.reference, opened_at: record.opened_at)
  }
}

// A failed removal is never dropped: it is appended to the refusal that caused it, and the registered
// record (still non-terminal) keeps the root owed, so A3 recovery retries it under the drain gate.
fn credential_removal_owed_note(removed: CredentialSealReceipt) -> String {
  match removed {
    CredentialSealed { path: _ } => ""
    CredentialSealFailed { detail: d } => join(["; the cleanup stays owed to A3 recovery: ", d], "")
    CredentialCleanupOwed { reason: d } => join(["; the cleanup stays owed to A3 recovery: ", d], "")
  }
}

// Release converges by observing absence: after rm the base is read back, and only a positively Absent
// listing reports it released. A base still listed, or a listing that cannot be read, stays owed.
fn credential_remove_cursor_runtime_root_at(root: CursorAttemptRuntimeRoot, reference: String, opened_at: EpochSecs) -> CredentialSealReceipt {
  let marker = cursor_attempt_runtime_owner_marker_name(reference: reference, opened_at: opened_at)
  let listed = Filesystem.List(path: root.base)
  if !listed.success {
    CredentialSealFailed { detail: join(["the cursor runtime root ", root.base, " could not be listed for removal: ", listed.error], "") }
  } else {
    // THE OWNER MARKER IS REMOVED LAST. A removal that fails partway must leave the marker, so the root
    // still reads Owned and stays owed; a marker unlinked first turned a half-removed root into NotOwned,
    // which A3 reports sealed and never retries.
    // One residual remains: if rmdir of the marker succeeds and rmdir of the base fails, the base is EMPTY (every
    // other child was swept first) and reads NotOwned, so no content outlives the release. Its causes are a
    // same-uid entry or mode change between the two calls: the RFM a_pathname_reresolves_its_ancestry_between_calls residual.
    let swept = run_shell_command_observe(command: find_other_children_exec_command(root: root.base, keep_name: marker, exec_argv: rm_recursive_force_one_file_system_exec_argv()), transport: LocalExec)
    if swept.exit_code != 0 {
      CredentialSealFailed { detail: join(["the cursor runtime root ", root.base, " could not be removed: ", trim(s: swept.stderr)], "") }
    } else {
      let marker_gone = run_shell_command_observe(command: rmdir_command(path: join([root.base, marker], "/")), transport: LocalExec)
      let base_gone = run_shell_command_observe(command: rmdir_command(path: root.base), transport: LocalExec)
      if marker_gone.exit_code != 0 || base_gone.exit_code != 0 {
        CredentialSealFailed { detail: join(["the cursor runtime root ", root.base, " could not be removed: ", trim(s: marker_gone.stderr), trim(s: base_gone.stderr)], "") }
      } else {
        match credential_list_entry(directory: path_parent_directory(path: root.base), name: reference) {
          FilesystemEntryAbsent(_) => CredentialSealed { path: root.base }
          FilesystemEntryListed { directory: _, name: _ } => CredentialSealFailed { detail: join(["the cursor runtime root ", root.base, " is still present after removal"], "") }
          FilesystemEntryPresenceIndeterminate { cause: c } => CredentialSealFailed { detail: join(["the absence of ", root.base, " could not be read back: ", c], "") }
          FilesystemEntrySubjectRefused { directory: _, name: _, cause: c } => CredentialSealFailed { detail: join(["the absence of ", root.base, " could not be read back: ", c], "") }
        }
      }
    }
  }
}

fn credential_receipt_failure(receipt: CredentialSealReceipt) -> String? {
  match receipt {
    CredentialSealed { path: _ } => none
    CredentialSealFailed { detail: d } => Present { value: d }
    CredentialCleanupOwed { reason: d } => Present { value: d }
  }
}

// BOTH obligations are attempted, the snapshot tombstone first: a root that cannot be removed (mount,
// permission, filesystem) must never keep the plaintext snapshot alive. Each standing is returned: a root
// failure alone is owed (the slot is retried), a snapshot failure is a seal failure, and both failing keeps
// both causes.
fn credential_seal_after_terminate(record: CredentialAcquisitionRecord, drain: RecordedCgroupDrain, instance_root: String) -> CredentialSealReceipt {
  match drain {
    RecordedCgroupMaySeal { detail: _ } => {
      let snapshot = match observe_snapshot_seal_fact(path: record.snapshot_path) {
        CredentialSnapshotTombstone => CredentialSealed { path: record.snapshot_path }
        CredentialSnapshotUnsealed => credential_occupy_snapshot(path: record.snapshot_path)
      }
      let root = credential_retire_cursor_runtime_root(record: record, instance_root: instance_root)
      match credential_receipt_failure(receipt: snapshot) {
        Absent =>
          match credential_receipt_failure(receipt: root) {
            Absent => snapshot
            Present { value: rd } => CredentialCleanupOwed { reason: rd }
          }
        Present { value: sd } =>
          match credential_receipt_failure(receipt: root) {
            Absent => CredentialSealFailed { detail: sd }
            Present { value: rd } => CredentialSealFailed { detail: join([sd, "; ", rd], "") }
          }
      }
    }
    RecordedCgroupPreserve { detail: d } =>
      CredentialCleanupOwed { reason: d }
  }
}

type CredentialSnapshotSealFact
  = CredentialSnapshotTombstone
  | CredentialSnapshotUnsealed

fn observe_snapshot_seal_fact(path: String) -> CredentialSnapshotSealFact {
  let raw = Filesystem.Read(path: path)
  match filesystem_exact_read(
    path: path,
    content: raw.content,
    success: raw.success,
    error: raw.error,
    error_kind: raw.error_kind,
  ) {
    FilesystemExactPathRead { path: _, content: body } =>
      if credential_snapshot_is_tombstone(text: body) {
        CredentialSnapshotTombstone
      } else {
        CredentialSnapshotUnsealed
      }
    FilesystemExactPathAbsent { path: _ } =>
      CredentialSnapshotUnsealed
    FilesystemExactPathUnreadable { path: _, kind: _, error: _ } =>
      CredentialSnapshotUnsealed
    FilesystemExactPathKindUnrecognized { path: _, observed: _, error: _ } =>
      CredentialSnapshotUnsealed
  }
}

type CredentialRecoveryDecision
  = CredentialRecoveryPreserve { reason: String }
  | CredentialRecoveryMayClose { reason: String }
  | CredentialRecoverySealNow { reason: String }

fn credential_recovery_decide(record: CredentialAcquisitionRecord, drain: RecordedCgroupDrain, now: EpochSecs, reader: CredentialReaderStanding, root: CursorRuntimeRootFact) -> CredentialRecoveryDecision {
  match record.state {
    AttemptReserved =>
      if now < record.launch_deadline {
        CredentialRecoveryPreserve { reason: "W: reserved inside the declared window" }
      } else {
        CredentialRecoveryMayClose { reason: "reserved past deadline with no launch" }
      }
    AttemptLaunching =>
      match drain {
        RecordedCgroupPreserve { detail: s } =>
          CredentialRecoveryPreserve { reason: s }
        RecordedCgroupMaySeal { detail: s } =>
          match reader {
            CredentialReaderEnded =>
              CredentialRecoveryMayClose { reason: join([s, "; reader ended"], "") }
            CredentialReaderRunning =>
              CredentialRecoveryPreserve { reason: "reader still live" }
            CredentialReaderUnobserved { detail: d } =>
              CredentialRecoveryPreserve { reason: join(["reader unobserved: ", d], "") }
          }
      }
    AttemptTerminal { verdict: _, detail: _ } =>
      match observe_snapshot_seal_fact(path: record.snapshot_path) {
        CredentialSnapshotTombstone =>
          match root {
            CursorRuntimeRootOwned =>
              // The tombstone is already in place, so a root the attempt owns that survived (a discard whose
              // removal failed, a child that ended) is still owed. Removal is idempotent and, once the root
              // is gone, the fact reads Absent and every later sweep is a real no-op.
              match drain {
                RecordedCgroupMaySeal { detail: s } => CredentialRecoverySealNow { reason: s }
                RecordedCgroupPreserve { detail: s } => CredentialRecoveryPreserve { reason: join(["owed: ", s], "") }
              }
            CursorRuntimeRootAncestryRefused { detail: d } => CredentialRecoveryPreserve { reason: join(["owed: ", d], "") }
            CursorRuntimeRootUnreadable { detail: d } => CredentialRecoveryPreserve { reason: join(["owed: ", d], "") }
            CursorRuntimeRootNotRegistered => CredentialRecoveryPreserve { reason: "sealed" }
            CursorRuntimeRootAbsent => CredentialRecoveryPreserve { reason: "sealed" }
            CursorRuntimeRootNotOwned { detail: _ } => CredentialRecoveryPreserve { reason: "sealed" }
          }
        CredentialSnapshotUnsealed =>
          match drain {
            RecordedCgroupMaySeal { detail: s } =>
              CredentialRecoverySealNow { reason: s }
            RecordedCgroupPreserve { detail: s } =>
              CredentialRecoveryPreserve { reason: join(["owed: ", s], "") }
          }
      }
  }
}

type CredentialSlotRecovery
  = CredentialSlotKept { text: String }
  | CredentialSlotClosed { text: String }
  | CredentialSlotFailed { text: String }

fn credential_slot_recovery_text(r: CredentialSlotRecovery) -> String {
  match r {
    CredentialSlotKept { text: t } => t
    CredentialSlotClosed { text: t } => t
    CredentialSlotFailed { text: t } => t
  }
}

fn credential_recover_slot(root: NonEmptyStr, reference: NonEmptyStr, now: EpochSecs, reader: CredentialReaderStanding) -> CredentialSlotRecovery {
  match observe_cas_slot_state(root: root, key: reference) {
    CasObservedUnreadable { cause: c } =>
      CredentialSlotKept { text: join(["preserve unreadable ", reference as String, ": ", cas_unreadable_slot_detail(cause: c)], "") }
    CasObservedReadable { readable: r } =>
      match r {
        CasReadableAbsent =>
          CredentialSlotKept { text: join(["absent ", reference as String], "") }
        CasReadablePresent { version: v } =>
          match credential_record_decode(text: v.value as String) {
            Absent =>
              CredentialSlotFailed { text: join(["undecodable ", reference as String], "") }
            Present { value: rec } => {
              let drain = recorded_cgroup_drain(path: observe_recorded_cgroup_path(control_group: rec.control_group))
              match credential_recovery_decide(record: rec, drain: drain, now: now, reader: reader, root: observe_cursor_runtime_root_fact(record: rec, instance_root: path_parent_directory(path: root as String))) {
                CredentialRecoveryPreserve { reason: why } =>
                  CredentialSlotKept { text: join(["preserve ", reference as String, ": ", why], "") }
                CredentialRecoverySealNow { reason: why } =>
                  match credential_seal_after_terminate(record: rec, drain: drain, instance_root: path_parent_directory(path: root as String)) {
                    CredentialSealed { path: p } =>
                      CredentialSlotClosed { text: join(["sealed ", p], "") }
                    CredentialSealFailed { detail: d } =>
                      CredentialSlotFailed { text: join(["seal failed ", reference as String, ": ", d], "") }
                    CredentialCleanupOwed { reason: o } =>
                      CredentialSlotKept { text: join(["owed ", reference as String, ": ", why, "; ", o], "") }
                  }
                CredentialRecoveryMayClose { reason: why } =>
                  match credential_terminate(
                    root: root,
                    reference: reference,
                    expected: v.generation,
                    verdict: AttemptRecovered,
                    detail: why,
                    reader: reader,
                  ) {
                    AttemptLostRace { expected: e, observed: o } =>
                      CredentialSlotKept { text: join(["terminate lost ", reference as String, ": ", e, " vs ", o], "") }
                    AttemptTransitionRefused { detail: d } =>
                      CredentialSlotFailed { text: join(["terminate refused ", reference as String, ": ", d], "") }
                    AttemptAdvanced { state: _, generation: _ } =>
                      match credential_seal_after_terminate(record: rec, drain: drain, instance_root: path_parent_directory(path: root as String)) {
                        CredentialSealed { path: p } =>
                          CredentialSlotClosed { text: join(["sealed ", p], "") }
                        CredentialSealFailed { detail: d } =>
                          CredentialSlotFailed { text: join(["seal failed ", reference as String, ": ", d], "") }
                        CredentialCleanupOwed { reason: o } =>
                          CredentialSlotKept { text: join(["owed ", reference as String, ": ", o], "") }
                      }
                  }
              }
            }
          }
      }
  }
}

type CredentialRootRecovery
  = CredentialRootOk { report: String }
  | CredentialRootFailed { report: String }

fn credential_root_recovery_report(r: CredentialRootRecovery) -> String {
  match r {
    CredentialRootOk { report: t } => t
    CredentialRootFailed { report: t } => t
  }
}

fn credential_recover_root(root: NonEmptyStr, now: EpochSecs, reader_for: fn(CredentialAcquisitionRecord) -> CredentialReaderStanding) -> CredentialRootRecovery {
  match cas_slot_keys(root: root) {
    CasSlotKeysSubjectRefused { root: _, cause: c } =>
      CredentialRootFailed { report: join(["credential slot root refused: ", c], "") }
    CasSlotKeysListingRefused { root: _, detail: d } =>
      CredentialRootFailed { report: join(["credential slot listing refused: ", d], "") }
    CasSlotKeysListed { keys } =>
      if length(keys) == 0 {
        CredentialRootOk { report: "no credential slots" }
      } else {
        let rows = map(keys, k =>
          match observe_cas_slot_state(root: root, key: k) {
            CasObservedUnreadable { cause: c } =>
              CredentialSlotKept { text: join(["preserve unreadable ", k as String, ": ", cas_unreadable_slot_detail(cause: c)], "") }
            CasObservedReadable { readable: r } =>
              match r {
                CasReadableAbsent =>
                  credential_recover_slot(root: root, reference: k, now: now, reader: CredentialReaderUnobserved { detail: "absent while listing" })
                CasReadablePresent { version: v } =>
                  match credential_record_decode(text: v.value as String) {
                    Absent =>
                      credential_recover_slot(root: root, reference: k, now: now, reader: CredentialReaderUnobserved { detail: "undecodable" })
                    Present { value: rec } =>
                      credential_recover_slot(root: root, reference: k, now: now, reader: reader_for(rec))
                  }
              }
          })
        let report = join(map(rows, r => credential_slot_recovery_text(r: r)), "\n")
        let failed = fold(rows, init: false, f: (acc, row) =>
          acc || match row {
            CredentialSlotFailed { text: _ } => true
            CredentialSlotKept { text: _ } => false
            CredentialSlotClosed { text: _ } => false
          })
        if failed {
          CredentialRootFailed { report: report }
        } else {
          CredentialRootOk { report: report }
        }
      }
  }
}

fn credential_register_then_take(
  attempt: DispatchAttempt,
  executor: SnapshotExecutor,
  custody: SnapshotCustodyDeclaration,
  snapshot: NonEmptyStr,
) -> DispatchCredentialSnapshot {
  match now_epoch_seconds() {
    Absent =>
      DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: "the host clock could not be read" } }
    Present { value: now } =>
      match observe_producer_identity() {
        ProducerUnidentified { detail: d } =>
          DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: d } }
        ProducerIdentified { control_group: cg, belt_unit: unit } => {
          let record = CredentialAcquisitionRecord {
            identity: attempt.attempt_key,
            node_id: attempt.node.node as String,
            reference: credential_acquisition_reference(identity: attempt.attempt_key, executor: executor) as String,
            executor: credential_attempt_executor_for(executor: executor),
            snapshot_path: snapshot as String,
            belt_unit: unit,
            control_group: cg,
            opened_at: now,
            launch_deadline: now + compute_pre_launch_ceiling_seconds,
            state: AttemptReserved,
          }
          let root = credential_acquisition_slots_root(instance_root: attempt.instance.instance_root as String)
          match credential_open(root: root, record: record) {
            AttemptLostRace { expected: e, observed: o } =>
              DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: join(["credential open lost: expected ", e, " found ", o], "") } }
            AttemptTransitionRefused { detail: d } =>
              DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: d } }
            AttemptAdvanced { state: _, generation: _ } =>
              match credential_create_cursor_runtime_root(record: record, instance_root: attempt.instance.instance_root as String) {
                CursorRuntimeRootCreationRefused { detail: d } =>
                  DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: d } }
                CursorRuntimeRootCreated =>
                  match dispatch_credential_snapshot_take(attempt: attempt, executor: executor, custody: custody, snapshot: snapshot) {
                    DispatchSnapshotTaken { snapshot: taken } => DispatchSnapshotTaken { snapshot: taken }
                    DispatchSnapshotRefused { reason: refusal } => {
                      let removed = credential_retire_cursor_runtime_root(record: record, instance_root: attempt.instance.instance_root as String)
                      match removed {
                        CredentialSealed { path: _ } => DispatchSnapshotRefused { reason: refusal }
                        CredentialSealFailed { detail: _ } => DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: join([dispatch_snapshot_refusal_text(reason: refusal) as String, credential_removal_owed_note(removed: removed)], "") } }
                        CredentialCleanupOwed { reason: _ } => DispatchSnapshotRefused { reason: SnapshotWriteFailed { path: snapshot, detail: join([dispatch_snapshot_refusal_text(reason: refusal) as String, credential_removal_owed_note(removed: removed)], "") } }
                      }
                    }
                  }
              }
          }
        }
      }
  }
}
