module gunbc.codex_provider_runtime_receipt


data codex_provider_runtime_receipt_authority_note: String = "ONE authority for the Codex provider-runtime receipt #8224 consumes. Placement (all three ProviderRuntimePlacement roots), bundled executable path, exact bundle identity (receipt_identity hex from the materialized release sidecar), and process fingerprint are derived from what converge installed — never hand-authored literals agreeing across branches (operator ruling 2026-08-13). Process fingerprint is CodexProcessFingerprintUnobserved until a wet tmux observation on the bundled binary lands; dispatch must not treat the legacy dispatch_codex_process_fingerprint literal as evidence. Publication target: ProviderRuntimePlacement.wire_evidence_root/codex-provider-runtime/HOST.json — written when converge succeeds; absent until first successful fleet execution (#8226 prerequisite). srv2/srv3/srv4 standing is unobserved from the operator key; do not claim observed placement beyond what a host receipt proves."

type CodexProcessFingerprintStanding
  = CodexProcessFingerprintObserved { fingerprint: std.types.NonEmptyStr }
  | CodexProcessFingerprintUnobserved { reason: std.types.NonEmptyStr }

data codex_process_fingerprint_unobserved_reason: std.types.NonEmptyStr = "bundled-native pane_current_command not yet observed on this host; derive from CodexProviderRuntimeReceipt once wet observation updates process_fingerprint — never from a hand-authored literal" as std.types.NonEmptyStr

type CodexProviderRuntimeReceipt {
  host: product.placement_supply.HostIdentity
  placement: gunbc.host_layout.ProviderRuntimePlacement
  bundled_executable: std.types.FilePath
  version_marker: std.types.NonEmptyStr
  bundle_receipt_identity_hex: std.types.NonEmptyStr
  process_fingerprint: CodexProcessFingerprintStanding
}

fn codex_provider_runtime_receipt_wire_path(
  placement: gunbc.host_layout.ProviderRuntimePlacement,
  host: product.placement_supply.HostIdentity,
) -> std.types.FilePath {
  concat(
    placement.wire_evidence_root as String,
    concat(
      "/codex-provider-runtime/",
      concat(host as String, ".json"),
    ),
  ) as std.types.FilePath
}

fn derive_codex_provider_runtime_receipt(
  host: product.placement_supply.HostIdentity,
  bundled_executable: std.types.FilePath,
  bundle_receipt_identity_hex: std.types.NonEmptyStr,
) -> CodexProviderRuntimeReceipt? {
  match provider_runtime_placement_for_host(host: host) {
    Absent => none
    Present { value: placement } =>
      Present {
        value: CodexProviderRuntimeReceipt {
          host: host,
          placement: placement,
          bundled_executable: bundled_executable,
          version_marker: codex_runtime_version_identity_marker() as std.types.NonEmptyStr,
          bundle_receipt_identity_hex: bundle_receipt_identity_hex,
          process_fingerprint: CodexProcessFingerprintUnobserved {
            reason: codex_process_fingerprint_unobserved_reason,
          },
        }
      }
  }
}

fn codex_provider_runtime_receipt_converges_three_roots(
  receipt: CodexProviderRuntimeReceipt,
) -> Bool {
  (receipt.placement.runtime_release_root as String) != ""
    && (receipt.placement.runtime_mutable_state_root as String) != ""
    && (receipt.placement.wire_evidence_root as String) != ""
}

fn codex_provider_runtime_receipt_process_fingerprint_observed(
  receipt: CodexProviderRuntimeReceipt,
) -> std.types.NonEmptyStr? {
  match receipt.process_fingerprint {
    CodexProcessFingerprintObserved { fingerprint } => Present { value: fingerprint }
    CodexProcessFingerprintUnobserved { reason: _ } => none
  }
}
