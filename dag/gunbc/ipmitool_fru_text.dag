module gunbc.ipmitool_fru_text

import std.types { String, NonEmptyStr }
import std.algebra { trim }
import std.optional { Present, Absent }

// THE PURE LINE DECODE of `ipmitool fru print` text: each field is read from exactly one line.
// Shared by every consumer of a committed FRU capture (the Mt. Jade identity read and the board
// authority read), so the line grammar has one home.
// The two grains are two types: a field read can only be absent, repeated or empty, so the
// capture-level failures are not representable in what `fru_field` returns.
type FruFieldGapKind
  = FruFieldAbsent { field: NonEmptyStr }
  | FruFieldRepeated { field: NonEmptyStr }
  | FruFieldEmpty { field: NonEmptyStr }

type FruCaptureGap
  = FruCaptureUnreadable { error: String }
  | FruCaptureDigestMismatch { expected: NonEmptyStr, observed: String }
  | FruFieldGapped { gap: FruFieldGapKind }
  | FruSubjectLinkUnobserved
  | FruBoundToAnotherLink { board_extra: String }

// THE ONE DIGEST CHECK of a committed capture against the sha256 a record was authored from.
// Every reader of a committed FRU capture asks this; a mismatch is never decoded.
type FruCaptureDigestCheck
  = FruCaptureDigestAgrees
  | FruCaptureDigestDiffers { gap: FruCaptureGap }

fn fru_capture_digest_check(content: String, expected_sha256: NonEmptyStr) -> FruCaptureDigestCheck {
  let observed = sha256_hex_of_text(text: content)
  if observed != (expected_sha256 as String) {
    FruCaptureDigestDiffers { gap: FruCaptureDigestMismatch { expected: expected_sha256, observed: observed } }
  } else {
    FruCaptureDigestAgrees
  }
}

type FruFieldRead
  = FruFieldValue { value: NonEmptyStr }
  | FruFieldGap { gap: FruFieldGapKind }

fn fru_line_key(line: String) -> String {
  match split(s: line, delimiter: " : ").first() {
    Present { value: k } => trim(k)
    Absent => ""
  }
}

fn fru_line_value(line: String) -> String {
  trim(join(split(s: line, delimiter: " : ").skip(n: 1), " : "))
}

fn fru_field(content: String, field: NonEmptyStr) -> FruFieldRead {
  let hits = split(s: content, delimiter: "\n") |> filter(l => fru_line_key(line: l) == (field as String))
  match hits.first() {
    Absent => FruFieldGap { gap: FruFieldAbsent { field: field } }
    Present { value: line } =>
      if length(hits) > 1 {
        FruFieldGap { gap: FruFieldRepeated { field: field } }
      } else if fru_line_value(line: line) == "" {
        FruFieldGap { gap: FruFieldEmpty { field: field } }
      } else {
        FruFieldValue { value: fru_line_value(line: line) as NonEmptyStr }
      }
  }
}
