data ci_native_cache_derive_step_name: String = "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"

fn ci_native_cache_root_step() -> Step {
  RunStep {
    name: Present { value: ci_native_cache_derive_step_name },
    id: none,
    run: v2.workflow.ci_workflow_run_emit.ci_native_cache_root_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
