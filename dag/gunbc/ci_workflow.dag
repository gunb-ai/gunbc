        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(
          key: "include-hidden-files",
          value: yaml_bool(b: ci_heal_author_commit_artifact_includes_hidden_files())
        ),
        kv(key: "retention-days", value: yaml_int(n: 7)),
        kv(key: "compression-level", value: yaml_int(n: 0))
      ]
    },
    env: none,
    if_condition: Present { value: ci_heal_author_commit_upload_if() },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

