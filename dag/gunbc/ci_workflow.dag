}

fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_cargo_build_jobs_count() -> Int {
  compile_jobs_count_or_serial(jobs: ci_compile_jobs(
    memory_budget: gunbc_ci_runner_slot_memory_max_live,
    force_serial: false
  ))
}

fn ci_cargo_build_jobs_line() -> String {
  concat(
    "echo \"CARGO_BUILD_JOBS=",
    concat(to_string(ci_cargo_build_jobs_count()), "\" >> \"$GITHUB_ENV\"\n")
  )
}

fn ci_isolate_toolchain_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain dirs" },
    id: none,
    run: concat(
      concat(
        concat(
          concat(
            "rm -rf \"$RUNNER_TEMP/rustup\" \"$RUNNER_TEMP/cargo\"\n",
            "echo \"HOME=$RUNNER_TEMP\" >> \"$GITHUB_ENV\"\n"
          ),
          concat(
            "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
            "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n"
          )
        ),
        concat(
          "echo \"MAKEFLAGS=\" >> \"$GITHUB_ENV\"\n",
          ci_cargo_build_jobs_line()
        )
      ),
      concat(
        "if sccache --show-stats >/dev/null 2>&1; then\n",
        concat(
          "  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n",
          concat(
            "  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
            "fi"
          )
        )
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_prelude_steps() -> List<Step> {
  [
    ci_checkout_step(),
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: concat(
        "rustup default \"$(rustup show active-toolchain | awk '",
        concat(concat("{", "print $1; exit"), concat("}", "')\""))
      ),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ]
}

fn ci_floor_spec_from_roster() -> CiSpec {
  {
    gates: project_ci_floor_gates(roster: commit_gate_roster),
    witness_entries: project_ci_floor_witness_entries(roster: commit_gate_roster),
    diff_policy: gunbc_ci_spec.diff_policy,
    notice_title: gunbc_ci_spec.notice_title,
    deploy_stages: [],
  }
}

fn ci_release_build_step() -> Step {
  RunStep {
    name: Present { value: "Build v1-compiler (release)" },
    id: none,
    run: ci_release_build_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_release_build_step_timeout_minutes }
  }
}

fn ci_floor_step() -> Step {
  RunStep {
    name: Present { value: "gunbc ci (.dag witnesses + gates)" },
    id: none,
    run: gunbc_ci_floor_run(spec: ci_floor_spec_from_roster()),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_floor_step_timeout_minutes }
  }
}

data merge_admission_gate_step_name: String = "Merge-admission gate (receipt required; freshness block held until GatingEnforced)"

data merge_admission_ci_gate_step_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_merge_admission_gate_step",
    field: WholeDeclaration
  }
}

fn ci_merge_admission_gate_step() -> Step {
  RunStep {
    name: Present { value: merge_admission_gate_step_name },
    id: none,
    run: ci_merge_admission_gate_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_nextest_install_step() -> Step {
  RunStep {
    name: Present { value: "Install cargo-nextest" },
    id: none,
    run: concat(
      concat(
        concat(
          "echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n",
          "if ! \"$CARGO_HOME/bin/cargo-nextest\" nextest --version >/dev/null 2>&1; then\n"
        ),
        concat(
          "  mkdir -p \"$CARGO_HOME/bin\"\n",
          "  case \"$(uname -m)\" in aarch64|arm64) A=linux-arm ;; *) A=linux ;; esac\n"
        )
      ),
      concat(
        "  curl -LsSf --retry 3 \"https://get.nexte.st/0.9.138/$A\" | tar zxf - -C \"$CARGO_HOME/bin\"\n",
        "fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_rust_sccache_warm_step() -> Step {
  RunStep {
    name: Present { value: "sccache warm (release bins + cache prime)" },
    id: none,
    run: ci_release_build_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_rust_sccache_warm_step_timeout_minutes }
  }
}

fn ci_rust_gate_step() -> Step {
  RunStep {
    name: Present { value: "v1 rust gate (fmt + clippy + nextest)" },
    id: none,
    run: gunbc_ci_rust_gate_only_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_rust_gate_step_timeout_minutes }
  }
}

fn ci_rust_cgroup_measurement_step() -> Step {
  RunStep {
    name: Present { value: "rust_tests cgroup peak (placement divisor)" },
    id: none,
    run: concat(
      "BIN=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/release/claim_executor\"\n",
      concat(
        "if [ -x \"$BIN\" ]; then \"$BIN\" --measure-cgroup-peak; ",
        "else echo \"[measurement] cgroup peak: unavailable (claim_executor not built)\"; fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_deploy_step(stage: DeployStage) -> Step {
  RunStep {
    name: Present { value: stage.step_name },
    id: none,
    run: gunbc_ci_deploy_run_script(stage: stage),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

data gunbc_ci_job_timeout_policy_minutes: Int = 90

data gunbc_ci_floor_step_timeout_minutes: Duration = 135

data gunbc_ci_floor_step_timeout_minutes_measure_grounding_dissolution_trigger: String = "🟡 feature:value-Measure dissolve-on: gunbc_ci_floor_step_timeout_minutes names GitHub Actions step timeout-minutes on the wire (extdeps/github/actions.dag RunStep.timeout_minutes projects Int). Carrier is std.types.Duration (minute magnitude, interim until CI budgets ground on std.measure time with explicit unit at the model layer and Int projection moves to GHA emit-only realization). DISSOLVES WHEN all gunbc CI step timeout authorities use a grounded measure carrier and timeout_minutes Int is derived at the workflow emit seam only."

data gunbc_ci_rust_gate_step_timeout_minutes: Int = 30

data gunbc_ci_rust_gate_step_budget_note: String = "Budgeted rust-gate-only step (fmt/clippy/nextest after sccache warm): 30m interim after v1-compiler stage0 edits — clippy --all-targets still in-flight at 15m step kill (receipt: rust_tests job 85269811605, run 28758588865 on 1588cf3; warm step 10m07s then clippy from 23:39:02 to step-FAILURE at 23:54:02 with zero gate verdict). Steady-state target remains 15m once clippy fits after warm; cold-cache storms stay in gunbc_ci_rust_sccache_warm_step_timeout_minutes (45m), not absorbed here (operator ruling, cool-hawk-899 / valiant-bee-192)."

data ci_rust_build_gate_step_split_note: String = "Build and rust gate are separate workflow steps (same discipline as ci_build_floor_step_split_note): bundling cargo build + rust_gates_ci under one step timeout produced step-FAILURE during v1-compiler compile with zero gate verdict (receipt: rust_tests job 85237415376, run 28746200534 on dfbff0f). Warm step ci_rust_sccache_warm_step carries gunbc_ci_rust_sccache_warm_step_timeout_minutes; rust gate step carries gunbc_ci_rust_gate_step_timeout_minutes."

data gunbc_ci_rust_sccache_warm_step_timeout_minutes: Int = 45

data gunbc_ci_rust_sccache_warm_step_budget_note: String = "Observable sccache-warm step (release bins + cache prime) before the budgeted rust gate: cold-cache fallback storms are counted here, not in gunbc_ci_rust_gate_step_timeout_minutes (operator ruling, cool-hawk-899 / valiant-bee-192). Receipt: PRs 6286/6274/6290 timed out at 15m with clippy never finishing under sccache cold-cache fallback while bundled with build."

data gunbc_ci_aux_step_timeout_minutes: Int = 5

data gunbc_ci_prelude_allowance_minutes: Int = 5

data ci_build_floor_step_split_note: String = "Build and floor are separate workflow steps so gate budgets apply to claim_executor only, not cargo build: bundling both under one step timeout produced step-FAILURE during v1-compiler compile with zero gate verdict (receipt: PR #6259 ci job 85192573905, 2026-07-05). Build step carries gunbc_ci_release_build_step_timeout_minutes; floor step carries gunbc_ci_floor_step_timeout_minutes."

data gunbc_ci_release_build_step_timeout_minutes: Int = 45

data gunbc_ci_release_build_step_budget_note: String = "Interim release-build step budget until cold v1-compiler fits 15m: 45 = prior 30m + margin after main merge (CARGO_BUILD_JOBS=6, text_lookup_work_counter). Receipt: job 85235032962 timed out at 30m still Compiling v1-compiler (~25m dep prelude + compile in progress; run 28745277854 on 1ba1895). Prior: job 85194701830 at 15m. Re-derive DOWNWARD when fleet cache/build path stabilizes."

data gunbc_ci_floor_gate_step_budget_note: String = "Superseded by gunbc_ci_floor_step_timeout_minutes (Duration=135, interim 2026-07-05): batch-1 dag_compile_clean_gate runs in-process witness_layer_roots_compile_clean_check (resolve leg only; receipt run 28748751115 showed emit on batch-1 exhausting 90m before batch-2 witnesses). Re-derive DOWNWARD when S2a node store / compile-clean scoping lands."

data gunbc_ci_deploy_job_backstop_timeout_minutes: Int = 10

data gunbc_ci_job_timeout_policy_disposition: Disposition = Terminal {
  reason: "gunbc CI budget semantics (operator ruling, 2026-07-05): any timed-out gate is a FAILURE, not a silent pass - no verdict == failure. The budget is enforced at the STEP level (GitHub Actions step timeout-minutes fails the step, conclusion=failure, logs + [t+Xs] phase marks intact), never as a job-level kill: the prior 10-minute job-kill policy (2026-07-04) produced conclusion=cancelled, which every consumer treated as not-red - operationally a silent pass. Receipt: the last successful main ci run was 2026-07-01T01:00Z; 29 of the next 30 main runs were cancelled; four days of merges landed with zero gate verdicts while two latent reds entered the tree (04_resolve.dag emit-fresh hard diagnostics; inert_lens witness-builtin scope errors). Breach semantics stay RED-by-step-failure; step budgets on-carrier: release build gunbc_ci_release_build_step_timeout_minutes (45m), rust sccache-warm gunbc_ci_rust_sccache_warm_step_timeout_minutes (45m — cold-cache storms isolated from gate budget per #6296), rust gate gunbc_ci_rust_gate_step_timeout_minutes (30m interim — clippy in-flight at 15m after v1-compiler warm; receipt run 28758588865), aux steps 5. The floor step is a separate authority — gunbc_ci_floor_step_timeout_minutes (135, interim 2026-07-05): batch-1 dag_compile_clean_gate runs in-process witness_layer_roots_compile_clean_check (resolve leg only; receipt run 28748751115 showed emit on batch-1 exhausting the 90m step alone before batch-2 witnesses); --target dag emit green-by-execution is enrolled on dag_compile_clean_clean_tree_emit_execution_holds in batch-2+ (same builtin). Perturb/cross-tree/dag-shell receipts stay in enrolled corpus witness dag_compile_clean_perturb_receipts_test.dag (batch-2+). Opt-in enrolled corpus witnesses share this step after batch-1. Until resolver-graph work (S2a node store, compile-clean scoping/memoization) shrinks the floor under a shorter budget, the floor step carries this interim headroom — not a second undocumented policy fork. Job backstops = ci: release build + floor step + aux + prelude (190m); rust_tests: sccache warm + rust gate + aux + prelude + aux (90m). dissolve-on: re-profile after compile-clean scoping/memoization; reduce gunbc_ci_floor_step_timeout_minutes when batch-1 resolve + enrolled emit witness + peers complete inside a shorter measured envelope. default_job_timeout_minutes (extdeps/github/actions.dag) still models GitHub's 360min platform default - workflow-layer policy on top."
}

fn gunbc_ci_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_floor_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_ci_rust_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_rust_sccache_warm_step_timeout_minutes + gunbc_ci_rust_gate_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn ci_deploy_job(stage: DeployStage) -> Job {
  Job {
    id: stage.id,
    name: none,
    runner: stage.runner,
    steps: concat(ci_prelude_steps(), [ci_deploy_step(stage: stage)]),
    needs: stage.needs,
    env: none,
    outputs: none,
    if_condition: Present { value: ci_deploy_push_to_main_if },
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_deploy_job_backstop_timeout_minutes },
    continue_on_error: none,
    concurrency: none
  }
}

fn ci_deploy_jobs() -> List<Job> {
  map(gunbc_ci_deploy_stages, s => ci_deploy_job(stage: s))
}

fn ci_job() -> Job {
  Job {
    id: "ci",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_release_build_step(), ci_floor_step(), ci_merge_admission_gate_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

fn rust_tests_job() -> Job {
  Job {
    id: "rust_tests",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(
      ci_prelude_steps(),
      [ci_nextest_install_step(), ci_rust_sccache_warm_step(), ci_rust_gate_step(), ci_rust_cgroup_measurement_step()]
    ),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_rust_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

data ci_workflow: Workflow = {
  name: "ci",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {

      group: ci_concurrency_group(),
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: Present { value: PermRead },
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: concat([ci_job(), rust_tests_job()], ci_deploy_jobs())
}
