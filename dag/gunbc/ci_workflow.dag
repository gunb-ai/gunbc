fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_cargo_build_jobs_count() -> Int {
  compile_jobs_count_or_serial(jobs: ci_compile_jobs(
    memory_budget: gunbc_ci_runner_slot_memory_max_live,
    force_serial: false
  ))
}

fn ci_cargo_build_jobs_line() -> String {
  concat(
    "echo \"CARGO_BUILD_JOBS=",
    concat(to_string(ci_cargo_build_jobs_count()), "\" >> \"$GITHUB_ENV\"\n")
  )
}

fn ci_isolate_toolchain_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain dirs" },
    id: none,
    run: concat(
      concat(
        concat(
          concat(
            "rm -rf \"$RUNNER_TEMP/rustup\" \"$RUNNER_TEMP/cargo\"\n",
            "echo \"HOME=$RUNNER_TEMP\" >> \"$GITHUB_ENV\"\n"
          ),
          concat(
            "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
            "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n"
          )
        ),
        concat(
          "echo \"MAKEFLAGS=\" >> \"$GITHUB_ENV\"\n",
          ci_cargo_build_jobs_line()
        )
      ),
      concat(
        "if sccache --show-stats >/dev/null 2>&1; then\n",
        concat(
          "  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n",
          concat(
            "  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
            "fi"
          )
        )
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_prelude_steps() -> List<Step> {
  [
    ci_checkout_step(),
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: concat(
        "rustup default \"$(rustup show active-toolchain | awk '",
        concat(concat("{", "print $1; exit"), concat("}", "')\""))
      ),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ]
}

fn ci_floor_spec_from_roster() -> CiSpec {
  {
    gates: project_ci_floor_gates(roster: commit_gate_roster),
    witness_entries: project_ci_floor_witness_entries(roster: commit_gate_roster),
    diff_policy: gunbc_ci_spec.diff_policy,
    notice_title: gunbc_ci_spec.notice_title,
    deploy_stages: [],
  }
}

fn ci_release_build_step() -> Step {
  RunStep {
    name: Present { value: "Build release bins (claim_executor + gunbc)" },
    id: none,
