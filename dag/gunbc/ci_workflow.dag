fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_heal_revalidation_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        kv(key: "ref", value: yaml_string(s: "${{ inputs.expected_healed_sha || github.sha }}"))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_heal_revalidation_preflight_step() -> Step {
  RunStep {
    name: Present { value: "Refuse a heal revalidation whose run subject or checkout does not name the expected healed SHA" },
    id: none,
    run: ci_heal_revalidation_preflight_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_cargo_build_jobs_count() -> Int {
  compile_jobs_count_or_serial(jobs: ci_compile_jobs(
    memory_budget: ci_runner_target_ram_speed_budget(target: selected_ci_runner_target()),
    force_serial: false
  ))
}

