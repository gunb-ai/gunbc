fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

data ci_heal_branch_ref_expr: String = "${{ github.head_ref || github.ref_name }}"

data ci_heal_branch_checkout_note: String = "The generated-artifact heal checks out the PR SOURCE branch head (github.head_ref) rather than the default detached PR-merge ref, because the heal pushes a regeneration commit BACK to that branch. The heal runs on pull_request only (ci_regen_heal_if), so github.head_ref is always the PR source branch; the `|| github.ref_name` fallback is retained as a defensive no-op for that expression. push (main), merge_group, and workflow_dispatch are excluded by ci_regen_heal_if — main is not auto-healed (its ci drift gate reds instead) and a queue ref (gh-readonly-queue/*) is not a pushable branch."

fn ci_heal_branch_head_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout triggering branch head (heal pushes the regeneration back to this branch)" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [
        kv(key: "fetch-depth", value: yaml_int(n: 0)),
        kv(key: "ref", value: yaml_string(s: ci_heal_branch_ref_expr))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_cargo_build_jobs_count() -> Int {
  compile_jobs_count_or_serial(jobs: ci_compile_jobs(
    memory_budget: ci_runner_target_ram_speed_budget(target: selected_ci_runner_target()),
    force_serial: false
  ))
}

fn ci_isolate_toolchain_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain dirs" },
    id: none,
    run: ci_isolate_toolchain_script(build_jobs_count: ci_cargo_build_jobs_count()),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_prelude_steps() -> List<Step> {
  [
    ci_checkout_step(),
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: ci_pin_rustup_default_script(),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ]
}

data ci_artifact_consumer_prelude_note: String = "Checkout-only prelude for deploy jobs that consume the build job's release-bins artifact. Rust release-bin build + isolated rustup stay on build only — deploy verifies and runs prebuilt binaries."

data ci_floor_gate_toolchain_note: String = "Batch-4 floor gates (emit_host rust smoke, self_host realized-comparison rustfmt/regen_stage0) need cargo+rustfmt on PATH. Uses setup-rust-toolchain without isolated RUSTUP_HOME — the full ci_prelude_steps isolate+pin+cache stack stays build-only (exit 127 rustup extract flake on srv3-07/08, 2026-07-21). Hosts that expose a cargo shim (e.g. /usr/local/ctrl-build-shims/cargo) without $CARGO_HOME/bin on PATH still fail bare `rustfmt` spawn inside regen_stage0 while `cargo fmt` works — ci_regen_ensure_rustfmt_path_script (v2.workflow.ci_regen_rustfmt_path_emit; Scaffold + orch bash-emit Pipeline of atomic PATH probes) prepends the locatable rustfmt dir onto PATH for the regen shell (receipt: CI #7290 srv3-03)."

fn ci_floor_gate_toolchain_step() -> Step {
  UsesStep {
    name: Present { value: "Setup Rust (floor gate toolchain — batch-4 emit_host/self_host gates need cargo/rustfmt; no isolated rustup)" },
    id: none,
    uses: setup_rust_action,
    with: Present {
      value: [
        kv(key: "components", value: yaml_string(s: "rustfmt")),
        kv(key: "cache", value: yaml_bool(b: false)),
        kv(key: "rustflags", value: yaml_string(s: ""))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_artifact_consumer_prelude_steps() -> List<Step> {
  [ci_checkout_step()]
}

fn ci_floor_job_prelude_steps() -> List<Step> {
  [ci_checkout_step(), ci_floor_gate_toolchain_step()]
}

