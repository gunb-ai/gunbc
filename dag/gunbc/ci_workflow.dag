module gunbc.ci_workflow

import extdeps.languages.yaml.types { yaml_string, yaml_int, yaml_bool, kv }
import gunbc.ci_workflow_expressions {
  ci_concurrency_group, ci_setup_rust_home, ci_cache_path, ci_cache_key, ci_cache_restore_keys
}
import gunbc.ci_spec {
  CiSpec, gunbc_ci_spec, gunbc_ci_workflow_run, gunbc_ci_rust_job_run,
  gunbc_ci_deploy_stages, DeployStage, gunbc_ci_deploy_run_script,
}
import gunbc.merge_admission_produce {
  ci_merge_admission_gate_script,
}
import gunbc.ci_workflow_expressions { ci_deploy_push_to_main_if }
import gunbc.commit_workflow { commit_gate_roster, project_ci_floor_gates, project_ci_floor_witness_entries }
import gunbc.runner_spec_from_offer { gunbc_ci_runner_spec }
import std.disposition { Disposition, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  WorkflowPermissions, PermRead,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax, CancelInProgressBool,
  checkout_action, setup_rust_action, cache_action
}

fn ci_checkout_step() -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present {
      value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_isolate_toolchain_step() -> Step {
  RunStep {
    name: Present { value: "Isolate toolchain dirs" },
    id: none,
    run: concat(
      concat(
        concat(
          concat(
            "rm -rf \"$RUNNER_TEMP/rustup\" \"$RUNNER_TEMP/cargo\"\n",
            "echo \"HOME=$RUNNER_TEMP\" >> \"$GITHUB_ENV\"\n"
          ),
          concat(
            "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
            "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n"
          )
        ),
        "if sccache --show-stats >/dev/null 2>&1; then\n"
      ),
      concat(
        concat(
          "  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n",
          concat(
            "  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
            concat(
              "  echo \"CARGO_BUILD_JOBS=1\" >> \"$GITHUB_ENV\"\n",
              concat(
                "else\n",
                concat(
                  "  echo \"CARGO_BUILD_JOBS=2\" >> \"$GITHUB_ENV\"\n",
                  "fi"
                )
              )
            )
          )
        ),
        ""
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_prelude_steps() -> List<Step> {
  [
    ci_checkout_step(),
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: concat(
        "rustup default \"$(rustup show active-toolchain | awk '",
        concat(concat("{", "print $1; exit"), concat("}", "')\""))
      ),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ]
}

fn ci_floor_spec_from_roster() -> CiSpec {
  {
    gates: project_ci_floor_gates(roster: commit_gate_roster),
    witness_entries: project_ci_floor_witness_entries(roster: commit_gate_roster),
    diff_policy: gunbc_ci_spec.diff_policy,
    notice_title: gunbc_ci_spec.notice_title,
    deploy_stages: [],
  }
}

fn ci_floor_step() -> Step {
  RunStep {
    name: Present { value: "gunbc ci (.dag witnesses + gates)" },
    id: none,
    run: gunbc_ci_workflow_run(spec: ci_floor_spec_from_roster()),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_job_timeout_policy_minutes }
  }
}

data merge_admission_gate_step_name: String = "Merge-admission gate (receipt required; freshness block held until GatingEnforced)"

data merge_admission_ci_gate_step_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_merge_admission_gate_step",
    field: WholeDeclaration
  }
}

fn ci_merge_admission_gate_step() -> Step {
  RunStep {
    name: Present { value: merge_admission_gate_step_name },
    id: none,
    run: ci_merge_admission_gate_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_nextest_install_step() -> Step {
  RunStep {
    name: Present { value: "Install cargo-nextest" },
    id: none,
    run: concat(
      concat(
        concat(
          "echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n",
          "if ! \"$CARGO_HOME/bin/cargo-nextest\" nextest --version >/dev/null 2>&1; then\n"
        ),
        concat(
          "  mkdir -p \"$CARGO_HOME/bin\"\n",
          "  case \"$(uname -m)\" in aarch64|arm64) A=linux-arm ;; *) A=linux ;; esac\n"
        )
      ),
      concat(
        "  curl -LsSf --retry 3 \"https://get.nexte.st/0.9.138/$A\" | tar zxf - -C \"$CARGO_HOME/bin\"\n",
        "fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_rust_gate_step() -> Step {
  RunStep {
    name: Present { value: "v1 rust gate (fmt + clippy + nextest)" },
    id: none,
    run: gunbc_ci_rust_job_run(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_rust_gate_step_timeout_minutes }
  }
}

fn ci_rust_cgroup_measurement_step() -> Step {
  RunStep {
    name: Present { value: "rust_tests cgroup peak (placement divisor)" },
    id: none,
    run: concat(
      "BIN=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/release/claim_executor\"\n",
      concat(
        "if [ -x \"$BIN\" ]; then \"$BIN\" --measure-cgroup-peak; ",
        "else echo \"[measurement] cgroup peak: unavailable (claim_executor not built)\"; fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_deploy_step(stage: DeployStage) -> Step {
  RunStep {
    name: Present { value: stage.step_name },
    id: none,
    run: gunbc_ci_deploy_run_script(stage: stage),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

data gunbc_ci_job_timeout_policy_minutes: Int = 10

data gunbc_ci_rust_gate_step_timeout_minutes: Int = 15

data gunbc_ci_aux_step_timeout_minutes: Int = 5

data gunbc_ci_prelude_allowance_minutes: Int = 5

data gunbc_ci_job_timeout_policy_disposition: Disposition = Terminal {
  reason: "gunbc CI budget semantics (operator ruling, 2026-07-05): any timed-out gate is a FAILURE, not a silent pass - no verdict == failure. The budget is enforced at the STEP level (GitHub Actions step timeout-minutes fails the step, conclusion=failure, logs + [t+Xs] phase marks intact), never as a job-level kill: the prior 10-minute job-kill policy (2026-07-04) produced conclusion=cancelled, which every consumer treated as not-red - operationally a silent pass. Receipt: the last successful main ci run was 2026-07-01T01:00Z; 29 of the next 30 main runs were cancelled; four days of merges landed with zero gate verdicts while two latent reds entered the tree (04_resolve.dag emit-fresh hard diagnostics; inert_lens witness-builtin scope errors). Budgets stay SHORT by operator ruling (2026-07-05, twice confirmed): floor 10 minutes, rust gate 15, aux steps 5 - the forcing function survives, only its breach semantics changed. Until resolver-graph work (S2a node store, compile-clean scoping) fits the floor inside 10 minutes, main runs red-by-STEP-FAILURE with [t+Xs] phase attribution: an honest, countable deficit signal, unlike the cancelled-silence it replaces. Job-level timeouts are retained only as per-job backstops = that job's step-budget sum + prelude allowance: step timeouts start at step start, so a tighter backstop could job-cancel (silence) before a step fails red, resurrecting the exact defect this policy removes. Every post-prelude step is step-budgeted and fails RED first; a backstop firing means a wedged prelude - itself a mechanism bug to investigate, never a gate verdict. default_job_timeout_minutes (extdeps/github/actions.dag) still models GitHub's 360min platform default - workflow-layer policy on top."
}

fn gunbc_ci_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_job_timeout_policy_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_ci_rust_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_rust_gate_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn ci_deploy_job(stage: DeployStage) -> Job {
  Job {
    id: stage.id,
    name: none,
    runner: stage.runner,
    steps: concat(ci_prelude_steps(), [ci_deploy_step(stage: stage)]),
    needs: stage.needs,
    env: none,
    outputs: none,
    if_condition: Present { value: ci_deploy_push_to_main_if },
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_job_timeout_policy_minutes },
    continue_on_error: none,
    concurrency: none
  }
}

fn ci_deploy_jobs() -> List<Job> {
  map(gunbc_ci_deploy_stages, s => ci_deploy_job(stage: s))
}

fn ci_job() -> Job {
  Job {
    id: "ci",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_floor_step(), ci_merge_admission_gate_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

fn rust_tests_job() -> Job {
  Job {
    id: "rust_tests",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_nextest_install_step(), ci_rust_gate_step(), ci_rust_cgroup_measurement_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_rust_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

data ci_workflow: Workflow = {
  name: "ci",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {

      group: ci_concurrency_group(),
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: Present { value: PermRead },
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: concat([ci_job(), rust_tests_job()], ci_deploy_jobs())
}
