    witness_entries: project_ci_floor_witness_entries(roster: commit_gate_roster),
    discovery_scan_dirs: gunbc_ci_spec.discovery_scan_dirs,
    diff_policy: gunbc_ci_spec.diff_policy,
    notice_title: gunbc_ci_spec.notice_title,
    deploy_stages: [],
  }
}

