data ci_regen_ratchet_removed_note: String = "The regen_divergence ratchet (formerly a REQUIRED ci_regen_ratchet job + tools/regen_divergence_ratchet.dag) was REMOVED (operator ruling 2026-07-07): it was interim scaffolding whose retirement condition — divergence count reaching 0, at which the byte-identical hard gate auto-promotes — is imminent via the accept-fresh self-host fixpoint (lively-raven-355), so the monotone-shrink guard is being retired slightly ahead of that auto-promote rather than maintained. It had also gone false-red on main after #6348 (emit → realization) moved the actual divergence off the pre-#6348 baseline (31), and refuse_if_baseline_raised makes a baseline re-calibration unwritable — so the guard was blocking merge on benign emit drift, not real new debt. Trade recorded honestly: until the fixpoint lands, self-host debt could grow behind the non-required ci_regen door unguarded; the non-required ci_regen job still shows the honest byte-identical verdict, and when divergence hits 0 the RegenVerifyGate returns to the required surface (the post-zero gate-placement decision, operator + owner)."

fn rust_tests_job() -> Job {
  Job {
    id: "rust_tests",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(
      ci_prelude_steps(),
      [ci_nextest_install_step(), ci_rust_sccache_warm_step(), ci_rust_gate_step(), ci_rust_cgroup_measurement_step()]
    ),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_rust_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

data ci_workflow: Workflow = {
  name: "ci",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {

      group: ci_concurrency_group(),
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: Present { value: PermRead },
      issues: none,
      actions: none,
      id_token: none
    }
  },
  jobs: concat([ci_job(), ci_regen_job(), rust_tests_job()], ci_deploy_jobs())
}
