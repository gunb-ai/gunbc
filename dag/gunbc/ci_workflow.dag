data ci_floor_receipts_artifact_name: String = "floor-receipts"

data ci_floor_receipts_artifact_note: String = "The floor's cost/drift receipts are TSV+txt files under target/, and until this step existed the ONLY way they left a run was for the writer to mirror every row into the step log — which is why one floor step carried ~12,000 receipt rows (measured: run 31453445496, 17,757 lines total, 8,614 of them one disclosure receipt). That mirroring was never an observability design; it was the absence of a transport, and gunbc.ci_spec gunbc_ci_compile_clean_clamp_note USED TO depend on it, naming those log lines as the seeding source for compile_clean_cost_basis.tsv — that note and the basis file's own header are corrected in the same change to read the uploaded receipt files instead, so no consumer is left pointing at a tag with zero emit sites. Uploading the files makes the console dump redundant so the writers can stop, and makes the basis seeding read a FILE rather than scrape a log. always() because a red run is exactly when the receipts are wanted (same reasoning as ci_floor_peak_post_step), and if-no-files-found: warn rather than error because a floor that refuses before any receipt writes is already redding on its own diagnostic — turning the absence of a receipt into a SECOND failure would report the transport as the defect. Glob rather than an enumerated roster: the receipt paths are hardcoded at each Rust writer with no single authority to consume, so listing them here would mint the second one (DESIGN section 3); the glob dissolves into that roster when a receipt-path authority lands."

fn ci_floor_receipts_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload floor receipts (TSV authority for cost/drift rows)" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: ci_floor_receipts_artifact_name)),
        kv(key: "path", value: yaml_string(s: "target/floor-*")),
        kv(key: "if-no-files-found", value: yaml_string(s: "warn")),
        kv(key: "retention-days", value: yaml_int(n: 14))
      ]
    },
    env: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

