    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_floor_step_timeout_minutes }
  }
}

data merge_admission_gate_step_name: String = "Merge-admission gate (receipt required; freshness block held until GatingEnforced)"

data merge_admission_ci_gate_step_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_workflow",
    decl_name: "ci_merge_admission_gate_step",
    field: WholeDeclaration
  }
}

fn ci_merge_admission_gate_step() -> Step {
  RunStep {
    name: Present { value: merge_admission_gate_step_name },
    id: none,
    run: ci_merge_admission_gate_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_nextest_install_step() -> Step {
  RunStep {
    name: Present { value: "Install cargo-nextest" },
    id: none,
    run: concat(
      concat(
        concat(
          "echo \"$CARGO_HOME/bin\" >> \"$GITHUB_PATH\"\n",
          "if ! \"$CARGO_HOME/bin/cargo-nextest\" nextest --version >/dev/null 2>&1; then\n"
        ),
        concat(
          "  mkdir -p \"$CARGO_HOME/bin\"\n",
          "  case \"$(uname -m)\" in aarch64|arm64) A=linux-arm ;; *) A=linux ;; esac\n"
        )
      ),
      concat(
        "  curl -LsSf --retry 3 \"https://get.nexte.st/0.9.138/$A\" | tar zxf - -C \"$CARGO_HOME/bin\"\n",
        "fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_rust_sccache_warm_step() -> Step {
  RunStep {
    name: Present { value: "sccache warm (release bins + cache prime)" },
