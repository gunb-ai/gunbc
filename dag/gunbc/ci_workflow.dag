  RunStep {
    name: Present { value: "Converge repository-local Git integration bindings (repo_local_git_config converge)" },
    id: none,
    run: gunbc_ci_heal_repo_local_git_config_invoke(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_heal_commit_push_step() -> Step {
  RunStep {
    name: Present { value: "Commit + push auto-push-eligible regenerated artifacts (workflow paths are author-commit-required)" },
    id: Present { value: ci_heal_commit_push_step_id },
    run: gunbc_ci_heal_commit_push_script(),
    shell: none,
    env: Present {
      value: [kv(key: "GITHUB_TOKEN", value: yaml_string(s: "${{ github.token }}"))]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

data ci_heal_commit_push_step_id: String = "heal_commit_push"

fn ci_heal_author_commit_upload_if() -> String {
  concat(
    concat("always() && steps.", ci_heal_commit_push_step_id),
    concat(".outputs.", concat(ci_heal_author_commit_required_output, " == '1'"))
  )
}

fn ci_heal_author_commit_upload_step() -> Step {
  UsesStep {
    name: Present { value: "Upload author-commit-required workflow repairs (the selected push credential cannot update .github/workflows/**)" },
    id: none,
    uses: upload_artifact_action,
    with: Present {
      value: [
        kv(key: "name", value: yaml_string(s: ci_heal_author_commit_artifact_name)),
        kv(key: "path", value: yaml_string(s: ci_heal_author_commit_artifact_dir)),
        kv(key: "if-no-files-found", value: yaml_string(s: "error")),
        kv(
          key: "include-hidden-files",
          value: yaml_bool(b: ci_heal_author_commit_artifact_includes_hidden_files())
        ),
        kv(key: "retention-days", value: yaml_int(n: 7)),
        kv(key: "compression-level", value: yaml_int(n: 0))
      ]
    },
    env: none,
    if_condition: Present { value: ci_heal_author_commit_upload_if() },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_artifact_transfer_step_timeout_minutes }
  }
}

fn ci_heal_generated_artifacts_job() -> Job {
  Job {
    id: "heal_generated_artifacts",
    name: none,
    runner: gunbc_ci_selected_runner_spec(),
    steps: concat(
      [ci_heal_branch_head_checkout_step()],
      [ci_release_bins_download_step(), ci_release_bins_unpack_verify_step(), ci_heal_repo_local_git_config_step(), ci_heal_binary_source_skew_guard_step(), ci_heal_regen_step(), ci_heal_commit_push_step(), ci_heal_author_commit_upload_step()]
    ),
    needs: ["build"],
    env: none,
    outputs: none,
    if_condition: Present { value: ci_regen_heal_if },
    timeout_minutes: Present { value: gunbc_ci_heal_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none,
    permissions: Present { value: ci_heal_job_permissions }
  }
}

