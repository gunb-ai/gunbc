  }
}

fn ci_native_cache_prelude_order_bridge() -> String {
  concat(
    concat("HOME: ", ci_setup_rust_home()),
    concat("\n      - name: ", ci_native_cache_derive_step_name)
  )
}

data ci_native_cache_prelude_order_bridge_note: String = "Adjacency-as-proxy ordering witness (not a structural Step-order predicate): ci_native_cache_prelude_order_bridge builds the setup-rust HOME env line immediately followed by the native-cache step name at the emitter's six-space yaml indent. witness_prelude_native_cache_root_step_follows_setup_rust asserts expected_ci_yml/falsifier_yml contain that substring. The real invariant is only that segment derivation runs after setup-rust-toolchain installs rustc; this check over-constrains to textual adjacency and can false-RED on a legitimate step inserted between setup-rust and native-cache, emitter yaml reformatting, or setup-rust gaining fields after HOME — but not false-green if ordering regresses. A hand-rolled match on Step would be the structural alternative; non-fold-residue forbids the wildcard arms that predicate would need (receipt: nfr floor on 14bc815db4). Dissolves when prelude ordering is witnessed without coproduct-residue match arms."

fn ci_prelude_steps_with_checkout(checkout: Step, exact_head_preflight: List<Step>) -> List<Step> {
  [
    checkout,
  ] |> concat(exact_head_preflight) |> concat([
    ci_isolate_toolchain_step(),
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    ci_native_cache_root_step(),
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: ci_pin_rustup_default_script(),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: ci_cache_path())),
          kv(key: "key", value: yaml_string(s: ci_cache_key())),
          kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ])
}

fn ci_prelude_steps() -> List<Step> {
  ci_prelude_steps_with_checkout(checkout: ci_checkout_step(), exact_head_preflight: [])
}

fn ci_heal_revalidation_prelude_steps() -> List<Step> {
  ci_prelude_steps_with_checkout(
    checkout: ci_heal_revalidation_checkout_step(),
    exact_head_preflight: [ci_heal_revalidation_preflight_step()]
  )
}

data ci_artifact_consumer_prelude_note: String = "Checkout-only prelude for deploy jobs that consume the build job's release-bins artifact. Rust release-bin build + isolated rustup stay on build only — deploy verifies and runs prebuilt binaries."

data ci_floor_gate_toolchain_note: String = "Batch-4 floor gates (emit_host rust smoke, self_host realized-comparison rustfmt/regen_stage0) need cargo+rustfmt on PATH. Uses setup-rust-toolchain without isolated RUSTUP_HOME — the full ci_prelude_steps isolate+pin+cache stack stays build-only (exit 127 rustup extract flake on srv3-07/08, 2026-07-21). Hosts that expose a cargo shim (e.g. /usr/local/ctrl-build-shims/cargo) without $CARGO_HOME/bin on PATH still fail bare `rustfmt` spawn inside regen_stage0 while `cargo fmt` works — ci_regen_ensure_rustfmt_path_script (v2.workflow.ci_regen_rustfmt_path_emit; If/Predicate/Exit/Let orch emit, leaf test -x / command -v / export PATH) prepends the locatable rustfmt dir onto PATH for the regen shell (receipt: CI #7290 srv3-03)."

fn ci_floor_gate_toolchain_step() -> Step {
  UsesStep {
    name: Present { value: "Setup Rust (floor gate toolchain — batch-4 emit_host/self_host gates need cargo/rustfmt; no isolated rustup)" },
    id: none,
    uses: setup_rust_action,
    with: Present {
      value: [
        kv(key: "components", value: yaml_string(s: "rustfmt")),
        kv(key: "cache", value: yaml_bool(b: false)),
        kv(key: "rustflags", value: yaml_string(s: ""))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn ci_artifact_consumer_prelude_steps() -> List<Step> {
  [ci_heal_revalidation_checkout_step(), ci_heal_revalidation_preflight_step()]
}

