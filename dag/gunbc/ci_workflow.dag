// A2 credential seam (parent msg_72e2dcee, provisioned): GitHub OIDC -> WIF exchange to
// the WIF-only service account, then in-run materialization of the fleet automation
// private key — Secret Manager versions/1 PINNED (never `latest`), fetched into
// RUNNER_TEMP mode 0600, loaded into an ssh-agent, and the file WIPED before any probe
// runs. The agent socket is exported via GITHUB_ENV so the probe step's ssh children
// inherit it; a trailing always() step kills the agent. Receipts downstream carry the
// identity NAME and outcome only — no key bytes, no payload digests (the fetch script
// never echoes the payload). Authority for the facts: gunbc.fleet_host_key_enrollment
// probe_identity_secret_access_requirement.
fn ci_fleet_wif_auth_step() -> Step {
  UsesStep {
    name: Present { value: "WIF auth (OIDC -> fleet-cloud-convergence SA, access token only)" },
    id: Present { value: "wif_auth" },
    uses: google_auth_action,
    with: Present {
      value: [
        kv(key: "workload_identity_provider", value: yaml_string(s: probe_identity_secret_access_requirement.wif_provider_resource)),
        kv(key: "service_account", value: yaml_string(s: probe_identity_secret_access_requirement.service_account)),
        kv(key: "token_format", value: yaml_string(s: "access_token")),
        kv(key: "create_credentials_file", value: yaml_bool(b: false))
      ]
    },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_step() -> Step {
  RunStep {
    name: Present { value: "Materialize fleet key in-run (SM versions/1 pinned -> RUNNER_TEMP 0600 -> ssh-agent -> wipe file)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_script(),
    shell: none,
    env: Present {
      value: [kv(key: "WIF_ACCESS_TOKEN", value: yaml_string(s: "${{ steps.wif_auth.outputs.access_token }}"))]
    },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_fleet_key_agent_cleanup_step() -> Step {
  RunStep {
    name: Present { value: "Kill the in-run ssh-agent (key never outlives the job)" },
    id: none,
    run: gunbc_ci_fleet_key_agent_cleanup_script(),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

// Fleet convergence collection (join 5 invocation wire): a READ, srv1-pinned (the collector
// reads published receipts over the typed SSH seam FROM inside the fleet and folds the
// verdict). Its guard admits push OR workflow_dispatch (ci_fleet_collect_read_if) — on push
// it runs per merged revision downstream of the required ci check; on dispatch it observes
// current fleet state relative to the CURRENT refs/fleet/desired without advancing anything
// (unfused from the push-only writes; see ci_fleet_convergence_steps).
fn ci_collect_fleet_convergence_step() -> Step {
  RunStep {
    name: Present { value: "Collect fleet converge receipts and fold the fleet verdict (collect_fleet_convergence_wet)" },
    id: none,
