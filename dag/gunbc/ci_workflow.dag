    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_floor_step_timeout_minutes }
  }
}

fn ci_regen_job() -> Job {
  Job {
    id: "ci_regen",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_release_build_step(), ci_regen_floor_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_job_backstop_timeout_minutes() },
