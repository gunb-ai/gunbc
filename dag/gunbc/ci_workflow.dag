}

fn ci_rust_cgroup_measurement_step() -> Step {
  RunStep {
    name: Present { value: "rust_tests cgroup peak (placement divisor)" },
    id: none,
    run: concat(
      "BIN=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target/release/claim_executor\"\n",
      concat(
        "if [ -x \"$BIN\" ]; then \"$BIN\" --measure-cgroup-peak; ",
        "else echo \"[measurement] cgroup peak: unavailable (claim_executor not built)\"; fi"
      )
    ),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: Present { value: "always()" },
    continue_on_error: none,
    timeout_minutes: Present { value: gunbc_ci_aux_step_timeout_minutes }
  }
}

fn ci_deploy_step(stage: DeployStage) -> Step {
  RunStep {
    name: Present { value: stage.step_name },
    id: none,
    run: gunbc_ci_deploy_run_script(stage: stage),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

data gunbc_ci_job_timeout_policy_minutes: Int = 90

data gunbc_ci_floor_step_timeout_minutes: Duration = 30

data gunbc_ci_floor_step_timeout_minutes_measure_grounding_dissolution_trigger: String = "🟡 feature:value-Measure dissolve-on: gunbc_ci_floor_step_timeout_minutes names GitHub Actions step timeout-minutes on the wire (extdeps/github/actions.dag RunStep.timeout_minutes projects Int). Carrier is std.types.Duration (minute magnitude, interim until CI budgets ground on std.measure time with explicit unit at the model layer and Int projection moves to GHA emit-only realization). DISSOLVES WHEN all gunbc CI step timeout authorities use a grounded measure carrier and timeout_minutes Int is derived at the workflow emit seam only."

data gunbc_ci_rust_gate_step_timeout_minutes: Int = 90

data gunbc_ci_rust_gate_step_budget_note: String = "Budgeted rust-gate-only step (gunbc run rust_gates_ci then fmt/clippy/nextest after sccache warm): 90m interim (operator ask 2026-07-08 — give the rust gate more time while the real fix lands). Receipt run 28909628928 @ de019459e (rust_tests job): reconcile now ~9s (the prior ~22m reconcile is FIXED), fmt 4.2s, but `cargo clippy --all-targets -- -D warnings` alone ran 2656s (~44m) and nextest was killed mid-start at the 45m step cap. ROOT CAUSE (not fixed by this bump): clippy --all-targets is a cold dev-profile compile of the whole workspace INCLUDING all test/bench targets, a distinct rustc invocation set from the release bins the warm step primes, so sccache gives it ~zero hit and it recompiles ~44m every run. 90m = clippy(~44m) + nextest headroom + margin, so the gate reaches RED-by-step-failure instead of a starved nextest. Prior 45m/30m receipts: reconcile-before-main ~22m + nextest killed (job 85319650284); clippy in-flight at 15m kill (job 85269811605). Cold-cache storms stay in gunbc_ci_rust_sccache_warm_step_timeout_minutes, not here (operator ruling, cool-hawk-899 / valiant-bee-192). DISSOLVE-ON: clippy gets a warmed/cached dev-profile compile (or --all-targets scope is cut) so the gate fits well under 45m again — re-derive DOWNWARD then. Migrating every step budget to a single derived base x margin is the follow-up (the job backstop gunbc_ci_rust_job_backstop_timeout_minutes() is already derived this way)."

data ci_rust_build_gate_step_split_note: String = "Build and rust gate are separate workflow steps (same discipline as ci_build_floor_step_split_note): bundling cargo build + rust_gates_ci under one step timeout produced step-FAILURE during v1-compiler compile with zero gate verdict (receipt: rust_tests job 85237415376, run 28746200534 on dfbff0f). Warm step ci_rust_sccache_warm_step carries gunbc_ci_rust_sccache_warm_step_timeout_minutes; rust gate step carries gunbc_ci_rust_gate_step_timeout_minutes."

data gunbc_ci_rust_sccache_warm_step_timeout_minutes: Int = 46

data gunbc_ci_rust_sccache_warm_step_budget_note: String = "Observable sccache-warm step (release bins + cache prime) before the budgeted rust gate: cold-cache fallback storms are counted here, not in gunbc_ci_rust_gate_step_timeout_minutes (operator ruling, cool-hawk-899 / valiant-bee-192). Receipt: PRs 6286/6274/6290 timed out at 15m with clippy never finishing under sccache cold-cache fallback while bundled with build."

data gunbc_ci_aux_step_timeout_minutes: Int = 5

data gunbc_ci_prelude_allowance_minutes: Int = 5

data ci_build_floor_step_split_note: String = "Build and floor are separate workflow steps so gate budgets apply to claim_executor only, not cargo build: bundling both under one step timeout produced step-FAILURE during v1-compiler compile with zero gate verdict (receipt: PR #6259 ci job 85192573905, 2026-07-05). Build step carries gunbc_ci_release_build_step_timeout_minutes; floor step carries gunbc_ci_floor_step_timeout_minutes."

data gunbc_ci_release_build_step_timeout_minutes: Int = 45

data gunbc_ci_release_build_step_budget_note: String = "Interim release-build step budget until cold v1-compiler fits 15m: 45 = prior 30m + margin after main merge (CARGO_BUILD_JOBS=6, text_lookup_work_counter). Receipt: job 85235032962 timed out at 30m still Compiling v1-compiler (~25m dep prelude + compile in progress; run 28745277854 on 1ba1895). Prior: job 85194701830 at 15m. Re-derive DOWNWARD when fleet cache/build path stabilizes."

data gunbc_ci_floor_gate_step_budget_note: String = "Floor-step budget raised to 30m (#6361 Lever A dissolve-on, receipt run 28902523405 @ e1a27e4286): the 10m cap was sized when batch-1 compile-clean never finished (~600s cap-kill) and downstream gates never ran. Lever A un-masked batches 1-3 green in ~5m; EmitDeterminismGate (batch 4, x2 gunbc compile oracle) then hit the 10m step kill mid-oracle (~5m into batch 4, zero gate verdict). Measured need: ~5m batches 1-3 + ~18m EmitDeterminism (2× ~537s compile legs per floor-shared-compute-memoization.md). 30m = envelope + margin. Job backstop gunbc_ci_job_backstop_timeout_minutes() = 45+30+5+5 = 85m."

data gunbc_ci_deploy_job_backstop_timeout_minutes: Int = 10

fn gunbc_ci_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_release_build_step_timeout_minutes + gunbc_ci_floor_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

fn gunbc_ci_rust_job_backstop_timeout_minutes() -> Int {
  gunbc_ci_rust_sccache_warm_step_timeout_minutes + gunbc_ci_rust_gate_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_aux_step_timeout_minutes + gunbc_ci_prelude_allowance_minutes
}

data gunbc_ci_job_timeout_policy_disposition: Disposition = Terminal {
  reason: "gunbc CI budget semantics (operator ruling 2026-07-06): floor step gunbc_ci_floor_step_timeout_minutes enforced at STEP level (RED-by-failure); ci job backstop gunbc_ci_job_backstop_timeout_minutes() = release build + floor + aux + prelude (85m at floor=30m after #6361 Lever A dissolve-on; was 65m at floor=10m) so cold release build is not killed by a job cap shorter than gunbc_ci_release_build_step_timeout_minutes (receipt run 28819559597 @ 201371c: 10m job kill aborted cargo mid-build). rust_tests keeps step-sum job backstop gunbc_ci_rust_job_backstop_timeout_minutes() = warm + gate + aux + prelude (151m at current step carriers: 46+90+5+5+5; warm and gate are SEPARATE serializer-witnessed steps - cold-cache release-bin storms land in warm, never eat the gate budget - and since clippy --all-targets dominates the gate the gate is now the larger of the two, 90 > 46) — job cap must cover step budgets so gates reach RED-by-step-failure, not job-cancelled silent-pass (#6323 starvation-kill scoped to ci/floor only on main). dissolve-on: compile-clean scoping/memoization shrinks batch-1; floor step raised when batch-1 completes inside measured envelope (receipt run 28902523405 @ e1a27e4286)."
}

fn ci_deploy_job(stage: DeployStage) -> Job {
  Job {
    id: stage.id,
    name: none,
    runner: stage.runner,
    steps: concat(ci_prelude_steps(), [ci_deploy_step(stage: stage)]),
    needs: stage.needs,
    env: none,
    outputs: none,
    if_condition: Present { value: ci_deploy_push_to_main_if },
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_deploy_job_backstop_timeout_minutes },
    continue_on_error: none,
    concurrency: none
  }
}

fn ci_deploy_jobs() -> List<Job> {
  map(gunbc_ci_deploy_stages, s => ci_deploy_job(stage: s))
}

fn ci_job() -> Job {
  Job {
    id: "ci",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(ci_prelude_steps(), [ci_release_build_step(), ci_floor_step(), ci_merge_admission_gate_step()]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: gunbc_ci_job_backstop_timeout_minutes() },
    continue_on_error: none,
    concurrency: none
  }
}

data ci_regen_job_non_required_note: String = "The ci_regen job is NON-required (operator two-job split, 2026-07-07, #6350): it runs the self-host fixed-point class (RegenVerifyGate + SelfHostStalenessGate) HARD and shows honest RED until the seed<->.dag reconcile lands, but it must be EXCLUDED from branch-protection required status checks so main goes green on the grounded invariants (the required ci + rust_tests jobs). continue_on_error stays none: the job reflects the true regen verdict; non-required-ness is the branch-protection reading, not a soft-pass. The former §5 anti-growth guard (the REQUIRED regen_divergence ratchet) was REMOVED 2026-07-07 as imminent-to-obsolete interim scaffolding — see ci_regen_ratchet_removed_note; until the accept-fresh fixpoint drives divergence to 0 (and RegenVerifyGate returns to the required surface), debt growth behind this non-required door is unguarded, recorded honestly as an interim trade."

