module gunbc.compile_permit_scope_observe

import std.types { String, NonEmptyStr, List, Bool }
import std.algebra { trim }
import std.disposition { Disposition, SingleAuthority }
import std.measure { HardwareThreadCount, hardware_thread_count }
import product.placement_supply { HostIdentity }
import extdeps.systemd { EnvironmentProperty, AfterProperty, WantsProperty }
import extdeps.cargo { CargoBuildJobsEnv, cargo_environment_variable_name }
import extdeps.jobserver { jobserver_fifo_path_from_makeflags }
import gunbc.host_effect { HostEffectTransport }
import gunbc.systemctl_show_read {
  systemctl_show_property_read,
  SystemdPropertyCaptured,
  SystemdPropertyCaptureRefused,
}
import gunbc.compile_permit_scope {
  CompileParallelismRealization,
  BorrowerHeldCooperativeHostFifo,
  InvocationLocalCargo,
  HostCompileCancellationStanding,
  HostCancellationObserved,
  HostCancellationUnreadable,
  HostCancellationUnobserved,
  FleetCompileCancellationStanding,
  fleet_cancellation_standing,
}
import gunbc.fleet_runner_connectivity { fleet_hosts }
import gunbc.fleet_show_effective_read { fleet_host_ssh_transport }
import gunbc.runner_unit { runner_slot_unit_name }
import gunbc.build_cache_instance { RunnerSlotIdentity }
import gunbc.host_converge { gunbc_runner_jobserver_service }

data compile_permit_scope_observe_scope_disposition: Disposition = SingleAuthority

// WHAT THIS MODULE READS, AND WHAT IT MUST NOT SAY. gunbc.compile_permit_scope derives whether
// cancellation is safe; this module reports the realization a runner slot unit is running. An
// observation that labelled itself safe would be the self-certifying carrier that module already
// refused. Present fifo-auth evidence is BorrowerHeldCooperativeHostFifo; complete absence of that
// evidence is InvocationLocalCargo. A mixed set is unreadable, not a guess at either arm.

fn compile_permit_scope_probe_unit(host: HostIdentity) -> NonEmptyStr {
  runner_slot_unit_name(slot: RunnerSlotIdentity { host: host, slot_index: 1 })
}

fn env_assignment_value(tokens: List<String>, key: String) -> String? {
  fold(
    tokens,
    init: none,
    f: (acc, t) => match acc {
      Present { value: v } => Present { value: v }
      Absent => {
        let prefix = concat(key, "=")
        if starts_with(s: t, prefix: prefix) {
          Present {
            value: substring(s: t, start: string_length(s: prefix), end: string_length(s: t)),
          }
        } else {
          none
        }
      }
    },
  )
}

fn word_present(tokens: List<String>, word: String) -> Bool {
  any(tokens, t => t == word)
}

type PermitScopePropertyRead
  = PermitScopePropertyText { text: String }
  | PermitScopePropertyUnreadable { cause: NonEmptyStr }

fn read_environment(
  transport: HostEffectTransport,
  unit: NonEmptyStr,
) -> PermitScopePropertyRead {
  match systemctl_show_property_read(transport: transport, unit: unit, property: EnvironmentProperty) {
    SystemdPropertyCaptured { value: raw } => PermitScopePropertyText { text: trim(raw) }
    SystemdPropertyCaptureRefused { reason: why } =>
      PermitScopePropertyUnreadable { cause: why as NonEmptyStr }
  }
}

fn read_after(
  transport: HostEffectTransport,
  unit: NonEmptyStr,
) -> PermitScopePropertyRead {
  match systemctl_show_property_read(transport: transport, unit: unit, property: AfterProperty) {
    SystemdPropertyCaptured { value: raw } => PermitScopePropertyText { text: trim(raw) }
    SystemdPropertyCaptureRefused { reason: why } =>
      PermitScopePropertyUnreadable { cause: why as NonEmptyStr }
  }
}

fn read_wants(
  transport: HostEffectTransport,
  unit: NonEmptyStr,
) -> PermitScopePropertyRead {
  match systemctl_show_property_read(transport: transport, unit: unit, property: WantsProperty) {
    SystemdPropertyCaptured { value: raw } => PermitScopePropertyText { text: trim(raw) }
    SystemdPropertyCaptureRefused { reason: why } =>
      PermitScopePropertyUnreadable { cause: why as NonEmptyStr }
  }
}

// WHAT WAS READ, NOT THE SLOT'S DESIRED WIDTH. Completely absent fifo evidence is
// InvocationLocalCargo only when CARGO_BUILD_JOBS is present in the unit text. Filling
// jobs_per_slot from gunbc_runner_cores_per_slot would mint Observed from a model row the
// host never advertised, which is a Safe-capable fabricated default (review 65466).
fn local_jobs_from_environment(tokens: List<String>) -> HardwareThreadCount? {
  match env_assignment_value(
    tokens: tokens,
    key: cargo_environment_variable_name(variable: CargoBuildJobsEnv) as String,
  ) {
    Present { value: raw } =>
      match parse_int(s: raw) {
        Present { value: n } =>
          if n >= 1 { Present { value: hardware_thread_count(count: n) } } else { none }
        Absent => none
      }
    Absent => none
  }
}

fn realization_from_unit_text(
  environment: String,
  after: String,
  wants: String,
) -> CompileParallelismRealization? {
  let env_tokens = split(s: environment, delimiter: " ")
  let after_tokens = split(s: after, delimiter: " ")
  let wants_tokens = split(s: wants, delimiter: " ")
  let daemon = gunbc_runner_jobserver_service
  let fifo_env = env_assignment_value(tokens: env_tokens, key: "CTRL_JOBSERVER_FIFO")
  let makeflags = env_assignment_value(tokens: env_tokens, key: "MAKEFLAGS")
  let fifo_from_flags = match makeflags {
    Present { value: flags } => jobserver_fifo_path_from_makeflags(makeflags: flags)
    Absent => none
  }
  let after_daemon = word_present(tokens: after_tokens, word: daemon)
  let wants_daemon = word_present(tokens: wants_tokens, word: daemon)
  match fifo_from_flags {
    Present { value: path } =>
      match fifo_env {
        Present { value: env_path } =>
          if (env_path == path) && after_daemon && wants_daemon && (path != "") {
            Present {
              value: BorrowerHeldCooperativeHostFifo {
                fifo_path: path as NonEmptyStr,
                daemon_service: daemon as NonEmptyStr,
              }
            }
          } else {
            none
          }
        Absent => none
      }
    Absent =>
      if (match fifo_env { Present { value: _ } => true, Absent => false }) || after_daemon || wants_daemon {
        none
      } else {
        match local_jobs_from_environment(tokens: env_tokens) {
          Present { value: jobs } => Present { value: InvocationLocalCargo { jobs_per_slot: jobs } }
          Absent => none
        }
      }
  }
}

fn host_standing_from_unit_text(
  host: HostIdentity,
  environment: String,
  after: String,
  wants: String,
) -> HostCompileCancellationStanding {
  match realization_from_unit_text(environment: environment, after: after, wants: wants) {
    Present { value: realization } =>
      HostCancellationObserved { host: host, realization: realization }
    Absent =>
      HostCancellationUnreadable {
        host: host,
        cause: "runner unit Environment/After/Wants did not jointly evidence a fifo pool or an invocation-local cargo bound" as NonEmptyStr,
      }
  }
}

fn observe_host_compile_cancellation(
  host: HostIdentity,
  transport: HostEffectTransport,
) -> HostCompileCancellationStanding {
  let unit = compile_permit_scope_probe_unit(host: host)
  match read_environment(transport: transport, unit: unit) {
    PermitScopePropertyUnreadable { cause: why } =>
      HostCancellationUnreadable { host: host, cause: why }
    PermitScopePropertyText { text: environment } =>
      match read_after(transport: transport, unit: unit) {
        PermitScopePropertyUnreadable { cause: why } =>
          HostCancellationUnreadable { host: host, cause: why }
        PermitScopePropertyText { text: after } =>
          match read_wants(transport: transport, unit: unit) {
            PermitScopePropertyUnreadable { cause: why } =>
              HostCancellationUnreadable { host: host, cause: why }
            PermitScopePropertyText { text: wants } =>
              host_standing_from_unit_text(
                host: host,
                environment: environment,
                after: after,
                wants: wants,
              )
          }
      }
  }
}

fn observe_host_compile_cancellation_for_fleet_host(host: HostIdentity) -> HostCompileCancellationStanding {
  match fleet_host_ssh_transport(host: host) {
    Absent =>
      HostCancellationUnobserved {
        host: host,
        cause: "no fleet_host_ssh_transport for this host" as NonEmptyStr,
      }
    Present { value: transport } => observe_host_compile_cancellation(host: host, transport: transport)
  }
}

fn observe_fleet_compile_cancellation_observations() -> List<HostCompileCancellationStanding> {
  map(fleet_hosts(), h => observe_host_compile_cancellation_for_fleet_host(host: h))
}

fn observe_fleet_compile_cancellation_standing() -> FleetCompileCancellationStanding {
  fleet_cancellation_standing(
    eligible_hosts: fleet_hosts(),
    observations: observe_fleet_compile_cancellation_observations(),
  )
}

// WET ENTRY. Hermetic evaluation of this fn classifies mock ssh stdout as unreadable, which is
// NotSafe. A session with fleet SSH identity reaches the live units. Do not bind this into
// fleet_compile_cancellation_standing: that row is consumed by witnesses.yml emit.
fn observe_fleet_compile_permit_scope() -> FleetCompileCancellationStanding {
  observe_fleet_compile_cancellation_standing()
}
