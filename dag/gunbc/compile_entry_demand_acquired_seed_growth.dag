module gunbc.compile_entry_demand_acquired_seed_growth

import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Receipt for the hand-Rust that makes `gunbc compile --entry` resolve over the demand-acquired
// closure `gunbc run` uses (one shared generated-provider loop), and makes governed/custom module
// ownership obey source-root order.
data compile_entry_demand_acquired_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "demand_acquired_provider_fixed_point", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "demand_acquired_entry_sources", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "CustomRootDuplicate", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "custom_root_module_census_under", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "read_governed_layout_module", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire", decl_name: "read_layout_module", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.entry_resolve", decl_name: "provider_closure_of", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "anchor_source_root_typed", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "admit_source_root", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run", decl_name: "compile_emission_over_inner", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "a_governed_custom_duplicate_obeys_root_order_and_policy", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "a_module_in_two_custom_roots_refuses_on_run_and_keeps_the_first_root_under_precedence", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.demand_acquire.tests", decl_name: "an_entry_compile_acquires_the_generated_provider_a_crossing_demands", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.cli_run.keyed_module_lookup.tests", decl_name: "governed_and_custom_copies_follow_root_order", field: WholeDeclaration }
  ],
  reason: "WHY RUST RATHER THAN .dag: compile --entry and run are the v1 seed's own acquisition path (demand_acquire, entry_resolve); the v1 interpreter cannot call v2.compiler.module_acquisition as a fold, so the shared resolve/seed/rebuild loop is extracted once (demand_acquired_provider_fixed_point) and both run and compile call it, not copied. WHY ADMITTED AGAINST THE v1 FREEZE: gunbc.v1.v1_maintenance_standing v1_seed_standing admits by PURPOSE - the whole-tree index made the v2 self-host entry compile peak at 10.27 GB; the demand-acquired closure peaks at 2.26 GB (source_root_eval -> rust, release), byte-identical emitted crate against main at the same head. The same change fixes a latent run defect: read_layout_module consulted the custom census before governed storage, so governed/custom duplicates ignored root order and policy; one root-order rule now serves run and compile (DESIGN 6b root generalization).",
  owning_dissolution_lane: "v1-hand-queue-drain" as RoadmapNodeId,
  trigger: "Delete these declarations when native v2 entry compile through v2.compiler.module_acquisition is SUFFICIENT FOR compile --entry (including generated-provider demands and governed/custom root-order ownership) without the seed's demand_acquire. WHAT DOES NOT RETIRE IT: a cache over the whole-tree index; a whole-pool fallback behind the entry compile.",
  current_boundary: "compile --entry (CompileSubject::Entry) and gunbc run call demand_acquired_provider_fixed_point; the other compile subjects (primary root, population) still use the whole-tree index by design. Controls: a_governed_custom_duplicate_obeys_root_order_and_policy (both root orders x both policies), an_entry_compile_acquires_the_generated_provider_a_crossing_demands (host_text_crossing_entry_witness class), governed_and_custom_copies_follow_root_order for the keyed reads."
}
