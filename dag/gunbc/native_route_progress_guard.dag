module gunbc.native_route_progress_guard

import v2.std.algebra { any, count_where, fold_list, is_empty, length, list_append, list_flat_map, list_map }
import v2.std.collection { List, Map, empty_map, map_insert, map_lookup }
import v2.std.integer { Int }
import v2.std.logic { Bool }
import v2.std.optional { Optional, Present, Absent, optional_present, optional_absent }
import v2.compiler.native_test_vocabulary {
  NativeTestStage, NativeTestStagePrepare, NativeTestStageContext, NativeTestStageEntry, NativeTestStageEval
}
import std.content_hash { Fnv1a64Structural, Fnv1a64StructuralDigestHex, structural_content_hash, content_hash_eq_structural }
import gunbc.witness_v2_native_route {
  NativeRouteTestIdentity, native_route_identity_eq, native_route_identity_qualified,
  NativeRouteDisposition,
  NativeAgreementPass, NativeAgreementExpectedRed, NativeAgreementRouteGap,
  NativeExclusion, NativeDivergence,
  NativeRouteExclusionCause,
  CompilerFrontierAttributed, NativeEntryResolutionLimit, NativeEvalBoundary, UnattributedRefusal,
  NativeRouteDivergenceCause,
  NativePassedExpectedRed, NativeFalseExpectedPass, NativeReturnedOtherVerdict, NativeReachedRouteGap,
  NativeRouteEmittedBuild
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// WHY A PROGRESS GUARD IS A DIFFERENT QUESTION FROM ADMISSION, AND NOT A SECOND RATCHET
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// `gunbc.witness_v2_native_route` `native_route_admission` answers ONE question about ONE run:
// is this receipt well-formed, does its population join its universe exactly, and does every
// reached verdict agree with the floor's reference. It is the right question and it is
// COMPLETE ON ONE HEAD. What it cannot see is the only thing a frontier lane exists to report:
// whether the head in front of it can do LESS than the head behind it.
//
// That blindness is not theoretical. The emitted-native compiler refuses most of the universe
// today -- `NativeExclusion` at `prepare`, at `context`, at `entry` -- and admission COUNTS those
// exclusions rather than refusing them, because a capability limit is not a divergence. So a
// change that makes the emitter refuse EARLIER for a subject it used to carry to `eval`, or that
// turns a correctly-observed `ReturnedFalse` on an expected-red subject into a `Passed`, produces
// a receipt admission accepts. The lane goes green while the frontier moved backwards. A count
// cannot catch it either: exclusions rise here and fall there and the total is unchanged, which
// is `matching-total-hides-a-mismatched-partition` in its native habitat.
//
// SO THE GUARD IS AT IDENTITY GRAIN, AND THAT IS THE WHOLE DESIGN. DESIGN section 5 admits a
// monotone debt contract over a closed subject universe only when "the subject universe is
// independently discovered and closed, membership is checked at identity grain rather than by
// count, and every removal carries a typed disposition". All three hold here and none of them
// is new vocabulary: the universe is DERIVED from the tree's `v2.test.*` declarations (it is not
// a roster anyone edits), the identity is `NativeRouteTestIdentity` (module qualified name plus
// declaration name, with its own equality), and this module supplies the third.
//
// WHAT "SUBSTITUTION CANNOT SATISFY THE BASELINE" MEANS HERE, because it is the clause that makes
// the guard worth having and it FALLS OUT of identity grain rather than being checked for. A
// renamed or re-homed subject is a DIFFERENT IDENTITY. It cannot silently inherit the old one's
// attainment, because the join never matches it; the old identity simply goes missing and owes a
// disposition. A guard keyed on counts, on module names, or on "some subject that looks like it"
// would let a rewrite that quietly lowers the bar pass as continuity.
//
// AND THE REPORT SEPARATES TWO FACTS A SINGLE VERDICT FUSES. "The requested tests passed" and
// "no established position was lost" are different claims with different consequences, and a lane
// that prints one number answers neither: a head where five subjects newly pass and one regressed
// is a RED with good news in it, and a head where nothing passes and nothing regressed is a GREEN
// with no good news at all. `NativeProgressReport` carries both and `native_progress_verdict`
// reads only the second, so the encouraging number can never green the guard.

// ═══════════════════════════════════════════════════════════════════════════════════════════
// CONSUMPTION: THIS IS A DECLARED FRONTIER, AND HERE IS ITS TRIGGER (DESIGN section 3c)
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// CONSUMED SINCE 2026-09-23, PER ROW. gunbc.native_frontier_ratchet calls this module's row, disposition
// and cause-transition folds (`native_progress_row_findings`, `native_progress_disposition_row_findings`,
// `native_cause_transition_row_findings`) and `native_progress_finding_text` from inside the emitted
// binary's adjudicate mode, run nightly by `//gunbc/instruments:v2-native-frontier`. What it does
// NOT consume is `native_progress_report` as a whole (its whole-baseline adjudication clause cannot
// hold for a roster compiled into the binary that judges it; the ratchet states why), nor the
// provenance and advance vocabulary, which stays the frontier described below. The paragraphs
// that follow were written before that consumer existed, and are kept as the record of the
// frontier that was declared.
//
// NOTHING IN PRODUCTION CALLED THIS FOLD WHEN IT LANDED, AND THAT WAS SAID PLAINLY RATHER THAN LEFT
// FOR A REVIEWER TO FIND. A declaration nothing consumes is section 2's redundant work in its purest
// form, and section 3c admits exactly one honest alternative to "consumed in this change": a
// NAMED consumer landing in a NAMED later change, with the trigger stated beside it. So:
//
//   NAMED CONSUMER, FOR THE RENDERING SURFACE AS WELL AS THE FOLD -- stated for both because
//   review 70109 found the renderer dangling while this section named a consumer only for the
//   fold, so the section itself had the sibling-shaped gap. `native_progress_finding_text` and
//   the two helpers beneath it (`native_run_reach_text`, `native_adjudication_receipt_text`) are
//   the operator-facing half of the same consumer: the job prints one line per finding. They are
//   EXECUTED by this module's witness, which asserts the rendered text carries the receipt and
//   says so when there is none -- so they are exercised rather than merely declared, which is the
//   distinction section 5 draws between a consumer and a typecheck.
//
//   The Tier 2 native-lane job of gunbc#12043's programme -- the run that
//   invokes the native route over the derived `v2.test.*` universe, derives one
//   `NativeProgressObservedReading` per universe member from the dispositions
//   `gunbc.witness_v2_native_route` `native_route_disposition` already computes, and adjudicates
//   `native_progress_verdict` beside `native_route_admission`.
//
//   TRIGGER. That job's CADENCE and its COVERAGE DISPOSITION are an operator decision, put on
//   gunbc#12043 and not yet answered, and both change what gets written: the route's measured
//   wall does not fit the acceptance path -- the figure is that drop row's own, re-derived by the
//   lane rather than restated here -- so the job runs on a
//   different cadence, which `gunbc.rung_drop` `v2_native_route_off_the_merge_path` pre-authorises
//   as its third option -- "a job that runs on a different cadence with its own row ... replaces
//   it with a differently-named drop". Whether that replacement is total or partial decides
//   whether the old row is replaced or stands beside a new one carrying the uncovered population,
//   and writing either before the answer would be guessing at a rung declaration.
//
//   WHAT IS NOT WAITING ON THAT ANSWER, which is why this module lands ahead of it: the ORDER and
//   the JOIN are cadence-independent. A regression is a regression whether the run that found it
//   was required, queued or scheduled.
//
// AND THE BASELINE IS NOT AUTHORED HERE ON PURPOSE. A baseline committed before a run that can
// produce one would be a literal copied from nothing -- the oracle failure DESIGN section 5 names,
// where automating the literal's update collapses the assertion to `measure() == measure()`. The
// first baseline is MINTED FROM A RUN, by the consumer above, and this module supplies only the
// vocabulary it is minted into.

// ═══════════════════════════════════════════════════════════════════════════════════════════
// WHERE THE LIVE FRONTIER ACTUALLY IS, AND WHY THE PRE-CONTEXT RUNGS COME FIRST
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// THE MEASURED FACT THIS SECTION IS BUILT ON. No contemporary head executes the native route end
// to end. It dies at the EMITTED CARGO BUILD: main with no diff refuses with `cause=EmittedCompilerBuildFailed` in the emitted
// `src/extdeps_numeric_base16.rs`, on a pure-main control; gunbc#12043's `emit-build` lane
// reproduces it on every head it has run, and is the producer to re-ask rather than this line.
// The cause is a rostered substrate class -- a phantom `Compose` carrier spelled where values are
// put -- spanning seven-plus modules, not a missing import anyone can add.
//
// SO THE ROUTE IS NOT `Context -> Prepare -> Entry -> Eval -> Pass` WITH A PREAMBLE. It is
//
//     emission attempted -> source emitted -> emitted crate built -> executable started
//                                                                          |
//                                                        and only THEN the per-test stages
//
// and a guard whose lowest rung is `refused at prepare` presupposes a binary that RAN, which on
// main is not true.
//
// AND HOW FAR A RUN GETS IS A PER-HEAD FACT THAT FLIPS, WHICH IS WHY `reach` IS A FIELD ON THE
// REPORT AND NOT A CEILING IN THIS MODULE. Two readings within an hour of each other: main stops
// at the emitted build (measured by gunbc#12043's `emit-build` lane, which is where to re-ask),
// and a composition including `session/sharp-bear-756` at 6032d50be7d builds the emitted crate
// clean.
//
// THE SECOND READING IS RELAYED AND STAYS LABELLED THAT WAY, with its evidence stated at the
// strength it actually has rather than rounded up or down. TWO INDEPENDENT OBSERVATIONS exist:
// that session's own (a clean build under `RUSTFLAGS=-D warnings`), and gentle-bee-234's on a
// DIFFERENT composition including the same head (same clean build, and further -- a discriminating
// cargo red and clean-root-versus-poison behaviour). A THIRD ATTEMPT, from this lane, IS
// INCONCLUSIVE: one remote dispatch over that tree reached `compile.normalize` and was ended by
// the runner's own deadline. The two builds' walls differ by more than a factor of two, which is
// the likely reason and is why the next person should budget from the slower observer's run
// rather than the headline one -- both are re-derivable by re-running the instrument, and neither
// number is restated here.
//
// SO THE STANDING IS: cited to its authors, not restated as this module's measurement
// (`extdeps.external_authority` `CitedFigureStanding`), and the reading is symmetric in the way
// DESIGN section 4d requires in BOTH directions -- a third party timing out is not evidence
// against a result, and two independent builds are not evidence that it always builds. Nothing in
// this module's construction depends on which reading is right; they are two values of one field,
// which is the whole reason `reach` sits on the report.
//
// WHAT A GREEN EMITTED BUILD DOES NOT ESTABLISH, said here because the temptation is immediate:
// it establishes `ReachCrateBuilt`, and nothing above it. Context, Prepare, Entry, Eval and Pass
// have produced no observations on any head yet, and this module may not promote them on the
// strength of a build -- a stage advances from what a run observed, which is the same rule
// `native_progress_baseline_advance` enforces against historical measurements one paragraph down.
//
// WHY THAT IS A REPRESENTATION BUG AND NOT MERELY A SCOPE ONE. With only the stage ladder, a run
// that never produced a binary yields an EMPTY population, and an empty population makes every
// baseline row read as "vanished, owing a disposition". That is loud, so it is not the silent
// version of the failure -- but it is the WRONG CAUSE, and wrong in the direction that rots: it
// says the subjects went away when the truth is that nothing could look at them. A stage nothing
// could observe must never read the same as a stage that observed nothing wrong. That is
// absence-conflated-with-success (DESIGN section 5), and it is the specific way a progress
// ratchet lies.
//
// THE TEST OF WHETHER THIS REPRESENTATION IS RIGHT, and it is the reason the rungs land now
// rather than after the substrate class clears: THE SAME RUN CROSSES INTO `Context` BY ITSELF
// WHEN THE BUILD STARTS WORKING, with no edit to this model. If a change to these types were
// needed on that day, the rungs were drawn in the wrong place.
//
// AND THE PRE-CONTEXT RUNGS ARE THE ONLY PART WITH A REAL INHABITANCE SOURCE TODAY. gunbc#12043's
// `emit-build` lane executes exactly them -- on main it attempts emission, emits the closure, and
// refuses at the cargo build; on the head above it reaches `ReachCrateBuilt` -- so this vocabulary
// is not a frontier waiting on a consumer the way the stage ladder above it still is. It is the
// part of the guard that can be read against a real run now, and it is read against two runs that
// disagree, which is better evidence than either alone.

// THE REACH OF ONE RUN, ORDERED. This is a WHOLE-RUN fact and deliberately not a per-identity one:
// no subject has an individual answer to "did the crate build".
type NativeRunReach
  = ReachEmissionAttempted
  | ReachSourceEmitted
  | ReachCrateBuilt
  | ReachExecutableStarted

fn native_run_reach_rank(r: NativeRunReach) -> Int {
  match r {
    ReachEmissionAttempted => 0
    ReachSourceEmitted => 1
    ReachCrateBuilt => 2
    ReachExecutableStarted => 3
  }
}

fn native_run_reach_text(r: NativeRunReach) -> String {
  match r {
    ReachEmissionAttempted => "emission attempted"
    ReachSourceEmitted => "source emitted"
    ReachCrateBuilt => "emitted crate built"
    ReachExecutableStarted => "executable started"
  }
}

// THE PER-TEST STAGES ARE REACHABLE ONLY FROM THE TOP RUNG. Below it there is no population to
// have an opinion about, and this predicate is what the report consults before comparing anything.
fn native_run_reached_the_population(r: NativeRunReach) -> Bool {
  native_run_reach_rank(r: r) >= native_run_reach_rank(r: ReachExecutableStarted)
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// PROVENANCE: WHAT MAY ADVANCE A RATCHET, AND WHAT MAY ONLY BE KEPT
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// A measurement taken against a NAMED STALE TREE is real evidence and is worth retaining -- it is
// how anyone reconstructs where the frontier was. It must not move the live ratchet, for the
// reason A3 gives: agreement holds only on what stays stable across time, and a baseline advanced
// from a tree that no longer exists asserts a position no current head can be held to. The next
// regression would then be measured against a bar nothing ever cleared here.
//
// SO PROVENANCE IS A FIELD ON THE OBSERVATION RATHER THAN A CONVENTION AROUND IT, and
// `native_progress_baseline_advance` is a typed refusal rather than a comment asking nicely. A
// historical reading can still be compared -- reading is not advancing -- and its verdict is
// reported with its tree named, so an operator can see where the frontier WAS without the roster
// moving.
// THREE ROLES, NOT TWO, AND THE TWO THAT LOOK ALIKE FAIL DIFFERENTLY (manager ruling, 2026-09-22).
//
// The first cut had `LiveRunOnHead | HistoricalAgainstTree`, which is admitted-or-not, and that
// collapses a distinction with teeth: a BRANCH observation and a STALE MAIN observation are both
// "not the current main baseline" and are nothing else alike.
//
//   MainBaselineObservation   the tested tree IS main. This is the only role that answers "what
//                             does the corpus currently hold", and the only one that may advance
//                             the regression floor.
//   BranchObservation         the tested tree was NEVER main. It is REAL EVIDENCE ABOUT
//                             CAPABILITY -- "is this possible right now" -- and must be readable
//                             as such, which is why it is an arm rather than a discard. It can
//                             NEVER be refreshed into a baseline no matter how often it is re-run,
//                             because re-running it produces another branch observation.
//   HistoricalMainObservation the tested tree WAS main and has aged. Stale, and REFRESHABLE: the
//                             same subject measured on today's main yields a baseline.
//
// WHY COLLAPSING BRANCH INTO EITHER NEIGHBOUR IS A DEFECT AND NOT A SIMPLIFICATION. Fold it into
// the admitted arm and one branch raises the regression floor under every other lane -- a bar no
// merge candidate ever cleared, enforced against all of them. Fold it into the historical arm and
// its remedy reads as "re-measure it", which will never produce a baseline and so becomes a task
// that cannot complete. `session/sharp-bear-756` is exactly this case today: self-host green,
// capability demonstrated, main unchanged.
//
// THE TESTED TREE IS THE RECEIPT'S, NOT THIS ROW'S OPINION OF IT. `NativeRouteReceipt` carries
// `tested_tree`, and the arm chosen here is a CLASSIFICATION of that value against main rather
// than a second source for it -- which is also this module's answer to the standing rule that a
// report must state the judged sha and its relation to current main. The relation is the arm; the
// sha is its field. A report that could not say which tree it judged could not choose an arm.
// A VERDICT IS IDENTIFIED BY THE TREE IT JUDGED **AND** THE ADJUDICATION THAT TURNED OBSERVATIONS
// INTO GREEN OR RED (manager ruling, 2026-09-22, from an incident).
//
// THE FACT BEHIND IT. gunbc#11998's floor job concluded SUCCESS while its own floor log read
// `verdict=FloorRefused, phases_failed=1`. Not a flake and not a stale base: the floor builds
// claim_executor from the CHECKED-OUT HEAD, and that head predates f5bd9b064a (gunbc#11829),
// which binds the adjudicator so a refusal reaches the job conclusion. gunbc#12050 carries the
// same witnesses plus that commit and fails. Same source, opposite lane verdicts, one commit
// between -- and #11829's own message states the blast radius: every floor success between
// #11742/#11761 and its landing is unverified.
//
// SO A SUBJECT TREE IS NOT SUFFICIENT TO IDENTIFY A VERDICT, and this module is where that has
// consequences, because it is the one thing in the corpus that consumes historical verdicts and
// compares them ACROSS TIME. Two drifts, and the provenance arms above cover only the first:
//
//   TREE DRIFT           same adjudicator, different subject -- which the three roles model.
//   GATE-SEMANTIC DRIFT  same subject, different adjudicator -- which nothing recorded.
//
// "Green at SHA X" is incomplete in either direction.
//
// THE PAYOFF IS NOT THAT INCIDENT, IT IS THE NEXT GATE STRENGTHENING. Today the discriminator is
// "does the judged head contain f5bd9b064a", which works and is unrememberable -- in a month
// nobody will know to ask. With the adjudicator on the verdict, a gate strengthening makes older
// verdicts NOT VERDICTS IN THE CURRENT MEANING automatically, rather than weaker evidence of the
// same kind, and the question is answerable without anyone recalling a commit hash. That is the
// difference between a fact the model carries and a fact a person has to remember (A3: agreement
// holds only on what stays stable across time).
//
// THE RECEIPT IDENTITY IS OPTIONAL BECAUSE NOT EVERY ADJUDICATION IS RECEIPT-BASED, and the
// absence is a real state rather than a missing value: an adjudicator that decided inline has no
// receipt to name, which is a different fact from one whose receipt went unrecorded. Only the
// first is representable here; the second is a defect in the producer.
// THE DISCRIMINATOR IS A DERIVED IDENTITY, NOT THE NAME (review 70073).
//
// The first cut compared `authority` -- a free-form String the producer authors -- and the
// paragraph above promised something that comparison cannot deliver: that a gate strengthening
// makes older verdicts not-verdicts-in-the-current-meaning AUTOMATICALLY. It does not. A
// strengthening that leaves the spelling unchanged is the NORMAL case -- gunbc#11829 did not
// rename anything it strengthened -- and leaves `comparable` true, so the guard compares across
// two definitions of green and reports regressions at face value. That is DESIGN section 5's own
// tell, verbatim: a check "satisfied by editing the declaration while the realization still
// lies", and section 4b(1)'s "a type name establishes nothing".
//
// The witness demonstrated the dependency rather than the property: its red only fired because a
// person hand-typed `@ pre-f5bd9b064a` into the string -- the commit hash the comment claimed
// nobody would need to recall.
//
// SO THE COMPARISON IS OVER `closure_identity`, a content hash of the ADJUDICATING CLOSURE, which
// changes when the closure changes whether or not anyone renames anything. `authority` survives
// for a reader and is explicitly NOT the discriminator. `Fnv1a64Structural` rather than the
// `ContentHash` union, for the reason `v2.std.node` `Hash` takes the same: cross-family
// comparison of that union is still authorable at typecheck until Phase B of
// feature:content-hash-family-grounded, and a comparison that could straddle families is the
// wrong primitive for a discriminator whose whole job is to be exact.
//
// THE RUNG THIS REACHES, STATED HONESTLY RATHER THAN ROUNDED UP. This is mechanically preventable,
// not structural. The residual is that the producer must hash THE ADJUDICATING CLOSURE and not
// something adjacent -- a producer hashing a constant would defeat it exactly as a producer
// writing a constant name did. What changed is that the failure now requires an active mistake
// instead of the ordinary case: renaming nothing is no longer sufficient to claim continuity.
// Closing the residual means the producer deriving the hash from the closure the emitter already
// walks, which is a producer obligation and is named here rather than assumed.
type NativeVerdictAdjudication {
  authority: String
  closure_identity: Fnv1a64Structural
  receipt_identity: Optional<String>
}

// THE EQUALITY IS `std.content_hash`'s AND NOT A SECOND SPELLING OF IT (review 70088). The first
// cut wrote `(a.closure_identity.digest as String) == (b...)`, which re-mints
// `content_hash_eq_structural` -- a consumed authority in the very module this one already
// imports from -- and does it by casting AWAY the `lower_hex_16` refinement, in the one function
// whose stated job is to be exact. Section 2's test is that net concepts must not grow by
// re-invention, and a hand-rolled compare that erases its operands' type is re-invention with a
// downgrade attached.
fn native_adjudication_same(a: NativeVerdictAdjudication, b: NativeVerdictAdjudication) -> Bool {
  content_hash_eq_structural(left: a.closure_identity, right: b.closure_identity)
}

// THE RECEIPT IDENTITY REACHES THE OPERATOR RATHER THAN SITTING UNREAD (review 70073: it was
// written at three sites and read at none, which is section 3c's red however well shaped). It is
// deliberately NOT part of `native_adjudication_same`: two runs under one adjudicator with
// different receipts are the same MEANING of green and must compare, so folding the receipt into
// the discriminator would make every run incomparable with every other. What it is for is
// reaching the person who has to go find the evidence, so it is rendered on the boundary finding,
// where an absent receipt is itself informative -- an adjudicator that decided inline has none.
fn native_adjudication_receipt_text(a: NativeVerdictAdjudication) -> String {
  match a.receipt_identity {
    Present { value: r } => join([", receipt ", r], "")
    Absent => " (adjudicated inline, no receipt)"
  }
}

// A FOURTH ARM, FOR A TREE THAT CAN NEVER BE A LANDED ONE (manager relay of witty-cat-84's case
// on gunbc#12009, 2026-09-22). The three roles above answer "what is this tree's relation to
// main"; none of them answers "could this tree ever land", and those are different questions.
//
// THEIR CASE, WHICH IS THIS DEFECT CLASS FROM THE OPPOSITE END. They met all three conjuncts of a
// rung-flip trigger HONESTLY -- on a measurement composition, their head plus two cherry-picked
// emitter files, that will never exist as a landed tree. By the letter, compliant; landing it
// would have flipped a standing to `LivePairRequired` on a tree where the required observation is
// impossible, taking a lane from enrolled-red-and-tolerated to required-and-failing. Their
// phrasing of the shared class is better than mine and is kept verbatim: A VERDICT THAT IS ONLY
// MEANINGFUL RELATIVE TO A CONTEXT THE VERDICT DOES NOT CARRY.
//
// WHY A BRANCH ARM DOES NOT COVER IT, which is the tempting fold and is wrong in the direction
// that matters: a branch head CAN land -- that is what a branch is for -- so classifying an author
// composition as one asserts a future that will not happen, and a consumer checking "evidence
// composition equals landing composition" would be handed a tree it must reject as one it may
// accept. A tree sha does not distinguish a landable ref from an assembled measurement tree; both
// hash.
//
// THE SECOND CONSUMER IS WHY THIS LANDS NOW RATHER THAN WHEN NEEDED. `native_progress_baseline_
// advance` is this module's own consumer; gunbc#12009's flip check is an independent one reached
// from the other direction, and it turns their question into a decidable check. A capability with
// one consumer is a bet (DESIGN section 3c); with two independent ones it is a modelled fact.
type NativeObservationProvenance
  = MainBaselineObservation { head: String }
  | BranchObservation { branch: String, head: String }
  | HistoricalMainObservation { tree: String, note: String }
  | AuthorCompositionObservation { base_head: String, overlay: String, note: String }

// THE REFUSALS ARE KEPT APART BECAUSE THEIR REMEDIES ARE DIFFERENT, and two of them are the two
// roles above: a stale main observation is refreshed by re-measuring on today's main, and a
// branch observation is not refreshable at all -- the remedy is to land the branch. Telling a
// reader to re-run a branch measurement is sending them on an errand that cannot finish.
// THE PREDICATE THE SECOND CONSUMER READS, and it is deliberately not "did this advance the
// ratchet". A flip check asks whether the tree an observation was made on is one that can BE the
// landing tree; a ratchet asks whether it may raise the floor. `HistoricalMainObservation` is
// landable and stale -- it was main -- which is precisely why the two questions need two
// functions rather than one.
fn native_observation_is_on_a_landable_tree(p: NativeObservationProvenance) -> Bool {
  match p {
    MainBaselineObservation { head: _ } => true
    BranchObservation { branch: _, head: _ } => true
    HistoricalMainObservation { tree: _, note: _ } => true
    AuthorCompositionObservation { base_head: _, overlay: _, note: _ } => false
  }
}

type NativeBaselineAdvance
  = BaselineMayAdvance { head: String }
  | BaselineAdvanceRefusedHistorical { tree: String }
  | BaselineAdvanceRefusedNeverMain { branch: String, head: String }
  | BaselineAdvanceRefusedNotALandableTree { base_head: String, overlay: String }
  | BaselineAdvanceRefusedUnreached { reach: NativeRunReach }
  | BaselineAdvanceRefusedProgressLost

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE ORDER
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// PROGRESS IS A POSITION ON THE ROUTE, NOT A PASS RATE. The route is a pipeline -- prepare,
// context, entry, eval -- and a subject's attainment is how far along it the emitted compiler
// carried it, plus whether the verdict it eventually produced AGREED with the floor. Three bands,
// and the lowest is ordered inside itself by the stage the refusal happened at:
//
//   AttainRefused { stage }   the route stopped here. prepare < context < entry < eval, because
//                             refusing at `eval` means the front end carried the subject through
//                             three stages that a `prepare` refusal never reached.
//   AttainDiverged            a verdict was produced and it DISAGREED with the floor reference.
//                             Strictly further than any refusal -- the whole pipeline ran -- and
//                             strictly worse than agreement. It is a defect, and the guard's job
//                             is not to bless it but to refuse its silent appearance BELOW an
//                             agreement that used to stand.
//   AttainAgreed              the verdict was produced and matched the reference, whether that
//                             reference was a pass, a required red, or the route gap.
//
// THE THREE AGREEMENT ARMS COLLAPSE TO ONE BAND ON PURPOSE, and this is the subtle call in the
// module. `NativeAgreementPass`, `NativeAgreementExpectedRed` and `NativeAgreementRouteGap` are
// different FACTS -- admission keeps them apart and must -- but they are the same ATTAINMENT:
// each says the route ran to completion and the answer was the expected one. Ordering them
// against each other would mean claiming that a subject moving from "correctly red" to "correctly
// passing" is progress on THIS axis, which it is not: it is the floor's reference that changed,
// not the emitted compiler's reach, and a guard that read it as progress would then read the
// reverse change as a regression and red a lane for a legitimate edit to the expected-red roster.
// The identity-grain REFERENCE change is a different question and is not this module's.
//   AttainUnreached          the run never got far enough to have an opinion about this subject.
//                            It is NOT a position on the ladder and is deliberately not ranked --
//                            see `native_attainment_at_least` for why asking "is unreached at
//                            least prepare" is a question with no honest answer.
type NativeRouteAttainment
  = AttainUnreached { blocked_at: NativeRunReach }
  | AttainRefused { stage: NativeTestStage, cause: NativeRouteExclusionCause }
  | AttainDiverged { cause: NativeRouteDivergenceCause }
  | AttainAgreed

// THE STAGE LADDER, AS A RANK. It is spelled here rather than in the vocabulary module because
// ORDER is not a fact about the stages -- `v2.compiler.native_test_vocabulary` declares what the
// stages ARE, and nothing there needs them ranked. It is a fact about the route's pipeline, which
// is this guard's subject. A match rather than a lookup table, so adding a stage refuses to
// compile until it states its rank.
fn native_stage_rank(stage: NativeTestStage) -> Int {
  match stage {
    NativeTestStagePrepare => 0
    NativeTestStageContext => 1
    NativeTestStageEntry => 2
    NativeTestStageEval => 3
  }
}

// THE BAND RANK. Refusals occupy 0..3 by stage, so the two bands above them start at 4.
// A BAR IS A DIFFERENT TYPE FROM A READING, AND THAT IS THE FOURTH TIME THIS LADDER HAS HAD TO
// LEARN IT (review 70058).
//
// `AttainUnreached` was representable on a baseline row, and the comparison answered `false` for
// an unreached BAR exactly as it once did for an unreached READING -- the misattribution this
// module had already been repaired for twice, on the direct arm and on the rename arm, surviving
// on the third side. And it was reachable through the module's OWN INTENDED MINTING ROUTE, not by
// hand: a run reaches the population, reports `AttainUnreached` for a subject not yet in the
// baseline, produces no finding (the row fold is driven by `baseline.rows`), verdicts
// `ProgressPreserved`, is admitted by `native_progress_baseline_advance`, and the consumer mints
// a baseline freezing an unreached bar. Every later run then reports `ProgressRegressed` forever
// for a subject whose bar was "nothing looked at it".
//
// SO THE REMEDY IS NOT A THIRD GUARD CLAUSE. Three repairs of one shape is the signal that the
// shape is wrong, and DESIGN section 5 says what to do about it: "stronger than catching a wrong
// state is making it unwritable". A BAR and a READING are genuinely different things -- a reading
// may record that nothing was looked at, and a bar cannot, because "nothing was looked at" is not
// a level anything can be held to. They are now different types, and the invalid state has no
// constructor.
//
// ONE LADDER, NOT TWO, so this is a refinement rather than the section 3 fork it would otherwise
// be. `native_baseline_rank` is the ladder and it is TOTAL. The observed rank is derived from it
// through `native_observed_as_baseline`, the one-way projection that is also the MINTING GATE --
// the same function answers "can this reading be a bar" and "what rank does this reading have",
// because they are the same question.
type NativeBaselineAttainment
  = BaselineRefused { stage: NativeTestStage, cause: NativeRouteExclusionCause }
  | BaselineDiverged { cause: NativeRouteDivergenceCause }
  | BaselineAgreed

// STAGE RANK AND DIAGNOSTIC CAUSE ARE DIFFERENT COORDINATES, AND THE LADDER ONLY EVER CARRIED THE
// FIRST (manager requirement, 2026-09-22 -- the third instance of one underlying error, and the
// subtlest).
//
// THE CASE. 47 modules move from `resolve_reason_ambiguous_symbol` to `resolve_reason_unbound_
// symbol`: same stage, same disposition, same verdict -- and the second cause is TRUE while the
// first was manufactured by a fallback searching unrelated modules. The consequence is a person's
// day: an author told to disambiguate names spends it on names, and an author told the provider
// is missing walks upstream and finds the file that will not parse. A ratchet scoring on
// attainment alone reports those 47 as NO PROGRESS.
//
// WORSE THAN A GAP: THE MODULE WAS DISCARDING A CAUSE IT ALREADY HELD. `native_attainment_of_with_
// stage` pattern-matched `NativeExclusion { cause: _ }` and `NativeDivergence { cause: _ }` and
// threw both away. Carrying them is recovery, not new modelling, which is the tell that the
// coordinate belongs here.
//
// THE GENERAL FORM, worth having once rather than three times: COMPARE THE PAYLOAD OF AN OUTCOME
// AT THE GRAIN THE SUBJECT CLAIMS, NOT ONLY ITS VARIANT. It bit twice in this file at once --
// `AttainRefused` collapsed every fatal reason, and `AttainDiverged` collapsed all four
// divergence causes, so a subject moving between two kinds of divergence was invisible too. And
// it applies recursively: `NativeRouteExclusionCause` is itself a variant whose PAYLOAD is the
// reason symbol, which is the coordinate the 47 modules actually moved on -- so the comparison
// keys on variant AND reason, not on variant alone.
fn native_exclusion_cause_tag(c: NativeRouteExclusionCause) -> String {
  match c {
    CompilerFrontierAttributed { reason: _ } => "compiler-frontier"
    NativeEntryResolutionLimit { reason: _ } => "entry-resolution-limit"
    NativeEvalBoundary { reason: _ } => "eval-boundary"
    UnattributedRefusal { reason: _ } => "unattributed"
  }
}

fn native_exclusion_cause_reason(c: NativeRouteExclusionCause) -> Symbol {
  match c {
    CompilerFrontierAttributed { reason: r } => r
    NativeEntryResolutionLimit { reason: r } => r
    NativeEvalBoundary { reason: r } => r
    UnattributedRefusal { reason: r } => r
  }
}

fn native_exclusion_cause_same(a: NativeRouteExclusionCause, b: NativeRouteExclusionCause) -> Bool {
  native_exclusion_cause_tag(c: a) == native_exclusion_cause_tag(c: b)
    && native_exclusion_cause_reason(c: a) == native_exclusion_cause_reason(c: b)
}

fn native_divergence_cause_tag(c: NativeRouteDivergenceCause) -> String {
  match c {
    NativePassedExpectedRed => "passed-expected-red"
    NativeFalseExpectedPass => "false-expected-pass"
    NativeReturnedOtherVerdict => "returned-other"
    NativeReachedRouteGap => "reached-route-gap"
  }
}

fn native_baseline_rank(b: NativeBaselineAttainment) -> Int {
  match b {
    BaselineRefused { stage: s, cause: _ } => native_stage_rank(stage: s)
    BaselineDiverged { cause: _ } => 4
    BaselineAgreed => 5
  }
}

// THE PROJECTION AND THE MINTING GATE ARE ONE FUNCTION. A reading becomes a bar exactly when it
// records that something was looked at; `Absent` is the refusal, and it is the only arm that can
// stop an unreached reading from becoming a floor everyone is held to.
fn native_observed_as_baseline(a: NativeRouteAttainment) -> Optional<NativeBaselineAttainment> {
  match a {
    AttainUnreached { blocked_at: _ } => optional_absent()
    AttainRefused { stage: s, cause: c } => optional_present(value: BaselineRefused { stage: s, cause: c })
    AttainDiverged { cause: c } => optional_present(value: BaselineDiverged { cause: c })
    AttainAgreed => optional_present(value: BaselineAgreed)
  }
}

fn native_attainment_rank(a: NativeRouteAttainment) -> Optional<Int> {
  match native_observed_as_baseline(a: a) {
    Absent => optional_absent()
    Present { value: b } => optional_present(value: native_baseline_rank(b: b))
  }
}

// THE BASELINE SIDE OF THIS COMPARISON NO LONGER HAS A FAILURE ARM, which is the whole point of
// the type split: there is nothing to ask. What remains is the OBSERVED side's floor, kept
// because callers route an unreached reading to its own finding before reaching here and a total
// function must still answer if one ever does -- and `false` is the fail-closed answer, which can
// never manufacture progress.
fn native_attainment_at_least(
  observed: NativeRouteAttainment,
  baseline: NativeBaselineAttainment
) -> Bool {
  match native_attainment_rank(a: observed) {
    Absent => false
    Present { value: seen } => seen >= native_baseline_rank(b: baseline)
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE BASELINE, AND WHAT MAY REMOVE A ROW FROM IT
// ═══════════════════════════════════════════════════════════════════════════════════════════

type NativeProgressBaselineRow {
  identity: NativeRouteTestIdentity
  attained: NativeBaselineAttainment
}

// A LEGITIMATE REMOVAL IS A CLAIM ABOUT THE WORLD, AND THE GUARD CHECKS IT RATHER THAN TAKING IT.
//
// This is the difference between a disposition and an exemption. An exemption says "do not count
// this row"; nothing can falsify it, so the debt contract decays into a list of things people
// stopped wanting to fix. A disposition says something CHECKABLE about the observed run, and the
// guard refuses the disposition whose claim the run contradicts:
//
//   SubjectDeleted            the declaration is gone. CHECKED: the identity must be absent from
//                             the observed universe. A row claiming deletion for a subject the
//                             run still discovered is refused.
//   SubjectLeftTheUniverse    the declaration moved out from under the `v2.test.` prefix. Checked
//                             the same way and kept SEPARATE from deletion because they are
//                             different facts with different follow-ups, and a reader of the
//                             report should not have to guess which happened.
//   SubjectRenamed            the subject survives under a new identity. CHECKED HARDEST, because
//                             this is the arm through which a lowered bar would walk: the NEW
//                             identity must be present in the observed run AND must itself attain
//                             at least what the OLD identity had. A rename is a continuation of a
//                             position, so it carries the position; a rename that does not is a
//                             regression wearing a rename's clothes, and it reds under its own
//                             refusal name rather than passing as bookkeeping.
// AN ACCEPT-TO-REFUSE TRANSITION IS NOT AUTOMATICALLY A REGRESSION, AND A RATCHET THAT SAYS IT IS
// WILL PENALISE THE LANE THAT REMOVES A FAIL-OPEN (manager requirement, 2026-09-22, arriving from
// a consumer rather than from the brief).
//
// THE CASE. gunbc#12009 deletes the global spelling search, and on the closure it measures that
// makes a large set of resolve refusals APPEAR -- which are not new failures. The old acceptances
// DEPENDED ON THE FALLBACK: a reference whose real binding did not exist fell through to a
// corpus-wide spelling search, found the name in an unrelated module, and answered. MOST of them
// reach a module that FILE-REFUSES, so their declarations never entered the index at all. The
// search was inventing answers around front-end defects that were invisible for exactly as long
// as it existed. gunbc#12009 is the producer that enumerates them; the counts are its to report.
// That is DESIGN section 5's absorbing fallback, removed.
//
// WHY THE LADDER ALONE GETS THIS WRONG. `AttainAgreed` outranks every refusal, so agreement going
// to refusal reads as a fall. But section 4b puts SILENT WRONGNESS BELOW THE LADDER ENTIRELY --
// it is not a rung -- and a located, attributed refusal IS a rung. An identity moving from a
// fabricated acceptance to an attributed refusal has therefore gone UP, and scoring it as a fall
// would reward restoring the fail-open. Progress has opposite signs on a refusal count in two
// real cases this week: a bounded repair driving its refusals to zero, and an authority
// migration making a large attributed set appear.
//
// SO THE ARM IS NOT "DID ANYTHING REGRESS" BUT "IS EVERY ACCEPT-TO-REFUSE MEMBER DISPOSITIONED".
// Empty is the right answer for a bounded repair and is its done condition; non-empty is expected
// for an authority migration, and the obligation is that every member is ENUMERATED AND
// ATTRIBUTED rather than that the set is small. This is the same machinery as the removal
// dispositions below and deliberately a SEPARATE ROSTER: a removal says a subject is gone, and
// this says a present subject's old bar was never real. Conflating them would let a removal
// excuse a regression and vice versa.
//
// THE DISPOSITION IS CHECKABLE IN THE SAME WAY THE OTHERS ARE. It names the fail-open whose
// removal caused the transition and the refusal the subject now reaches, so a reader can ask
// whether that refusal is really attributed -- and a transition claimed for a subject that did
// NOT go accept-to-refuse is refused, exactly as a deletion the run contradicts is.
// A CAUSE TRANSITION AT A FIXED RANK IS A FIRST-CLASS MOVEMENT, NOT A NON-EVENT, and it needs a
// disposition for the same reason accept-to-refuse does: it can go either way and the ratchet
// cannot tell which without being told. A cause becoming truthful is among the most valuable
// things a front-end change produces; the same cause renamed is neutral; and a cause becoming
// LESS truthful is a regression that moves no stage and would otherwise be invisible.
//
// `CauseRegressedUnderANewLabel` IS AN ARM OF THE DISPOSITION RATHER THAN THE ABSENCE OF ONE,
// which is the part worth noticing: declaring it does not excuse it. The guard reds on it under
// its own name. An author admitting a cause regression gets a located red; an author saying
// nothing gets `CauseTransitionUndispositioned`. Neither passes, and the two send a reader
// somewhere different -- which is the whole reason this is a disposition and not a boolean.
type NativeCauseTransitionDisposition
  = CauseNowMoreTruthful { was: String, now: String, why: String }
  | SameDefectRenamed { was: String, now: String }
  | CauseRegressedUnderANewLabel { was: String, now: String, why: String }

type NativeCauseTransitionRow {
  identity: NativeRouteTestIdentity
  disposition: NativeCauseTransitionDisposition
}

// THE CAUSE COORDINATE OF A POSITION, COMPARED AT EQUAL RANK. Agreement carries no cause -- there
// is no diagnostic in a verdict that matched -- so an agreement-to-agreement pair has nothing to
// compare and is not a transition.
fn native_cause_unchanged(baseline: NativeBaselineAttainment, seen: NativeRouteAttainment) -> Bool {
  match baseline {
    BaselineAgreed => true
    BaselineRefused { stage: _, cause: bc } =>
      match seen {
        AttainRefused { stage: _, cause: sc } => native_exclusion_cause_same(a: bc, b: sc)
        AttainAgreed => true
        AttainDiverged { cause: _ } => true
        AttainUnreached { blocked_at: _ } => true
      }
    BaselineDiverged { cause: bc } =>
      match seen {
        AttainDiverged { cause: sc } => native_divergence_cause_tag(c: bc) == native_divergence_cause_tag(c: sc)
        AttainAgreed => true
        AttainRefused { stage: _, cause: _ } => true
        AttainUnreached { blocked_at: _ } => true
      }
  }
}

// THIS ROSTER CLASSIFIES; IT DOES NOT WAIVE. The first cut had only the two excusing arms and
// admitted on ANY declaration -- `Present { value: _ } => []` -- so an author who declared
// `PriorAcceptanceWasNeverSound` over an acceptance that WAS sound got a silent pass, and the
// roster was an escape hatch with a vocabulary on it.
//
// The third arm is what makes it a classification. It exists so an author CAN say the honest
// thing when a fall is a real fall, and SAYING IT DOES NOT EXCUSE IT: the guard reds under its
// own name. Declared gets a located red naming the regression; undeclared gets
// `AcceptToRefuseUndispositioned`. Neither passes, and the two send a reader somewhere different
// -- which is the whole reason this is a disposition and not a boolean, and the same shape the
// cause-transition roster takes.
type NativeAcceptToRefuseDisposition
  = PriorAcceptanceDependedOnARemovedFallback { fallback: String, now_refuses_with: String }
  | PriorAcceptanceWasNeverSound { authority: String, now_refuses_with: String }
  | AcceptanceWasSoundAndThisIsARegression { why: String }

type NativeAcceptToRefuseRow {
  identity: NativeRouteTestIdentity
  disposition: NativeAcceptToRefuseDisposition
}

type NativeProgressDisposition
  = SubjectDeleted { authority: String }
  | SubjectLeftTheUniverse { moved_to_module: String }
  | SubjectRenamed { to: NativeRouteTestIdentity, authority: String }
type NativeProgressDispositionRow {
  identity: NativeRouteTestIdentity
  disposition: NativeProgressDisposition
}

// THE BASELINE CARRIES THE ADJUDICATION IT WAS MINTED UNDER, which is what makes the question
// answerable rather than merely recorded: a bar established under one meaning of "green" is not a
// bar in a different one, and the comparison is the place that would otherwise silently span the
// two.
type NativeProgressBaseline {
  rows: List<NativeProgressBaselineRow>
  dispositions: List<NativeProgressDispositionRow>
  accept_to_refuse: List<NativeAcceptToRefuseRow>
  cause_transitions: List<NativeCauseTransitionRow>
  minted_under: NativeVerdictAdjudication
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE VERDICT VOCABULARY
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// EVERY REFUSAL NAMES THE IDENTITY IT IS ABOUT. A guard that reported "3 regressions" would send
// a reader to diff two receipts by hand, which is the report doing arithmetic instead of saying
// what happened (DESIGN section 5: every degradation a typed, LOCATED, countable diagnostic).
// `SubjectUnreachedEarlierRungFailed` IS NEITHER A REGRESSION NOR A MISSING SUBJECT. The run
// stopped below the rung at which that subject could have been looked at, so its baseline is
// neither met nor lost: it is unjudged. It reds -- a merge candidate that established nothing is
// not a pass -- under a cause that sends a reader to the earlier rung rather than into a diff.
type NativeProgressFinding
  = ProgressRegressed {
      identity: NativeRouteTestIdentity
      baseline: NativeBaselineAttainment
      observed: NativeRouteAttainment
    }
  | BaselineMemberMissingUndisposed { identity: NativeRouteTestIdentity }
  | DispositionContradictedByRun { identity: NativeRouteTestIdentity }
  | RenameTargetAbsent { identity: NativeRouteTestIdentity, target: NativeRouteTestIdentity }
  | RenameTargetBelowBaseline {
      identity: NativeRouteTestIdentity
      target: NativeRouteTestIdentity
      baseline: NativeBaselineAttainment
      observed: NativeRouteAttainment
    }
  | DisposedSubjectHasNoBaselineRow { identity: NativeRouteTestIdentity }
  | ArtifactProductionFailed { detail: String }
  | ObservedMemberReadingMalformed { identity: NativeRouteTestIdentity }
  | BaselineMintedUnderADifferentAdjudication {
      baseline: NativeVerdictAdjudication
      run: NativeVerdictAdjudication
    }
  | AcceptToRefuseUndispositioned {
      identity: NativeRouteTestIdentity
      baseline: NativeBaselineAttainment
      observed: NativeRouteAttainment
    }
  | AcceptToRefuseDispositionContradicted { identity: NativeRouteTestIdentity }
  | AcceptToRefuseDeclaredARegression {
      identity: NativeRouteTestIdentity
      baseline: NativeBaselineAttainment
      observed: NativeRouteAttainment
    }
  | CauseTransitionUndispositioned { identity: NativeRouteTestIdentity }
  | CauseRegressedAtAFixedRank { identity: NativeRouteTestIdentity, was: String, now: String }
  | CauseTransitionDispositionContradicted { identity: NativeRouteTestIdentity }
  | SubjectUnreachedEarlierRungFailed {
      identity: NativeRouteTestIdentity
      blocked_at: NativeRunReach
    }

// ARTIFACT PRODUCTION IS PART OF THE GUARD, NOT A PRECONDITION OF IT.
//
// A run whose emitted crate did not build produces a receipt with an EMPTY or truncated
// population, and an empty population regresses every baseline row at once -- which is true but
// useless, and worse, it is the shape a reader learns to wave through ("the build broke, ignore
// the guard"). So the build outcome is READ FIRST and reported as its own finding: a non-zero
// cargo status, or a warning count admission requires to be zero, is `ArtifactProductionFailed`
// with the detail on it. The per-identity findings are still computed and still reported -- the
// guard does not go quiet because one upstream fact failed -- but the reader is told which
// explanation is available.
//
// THE WARNING COUNT IS PART OF IT for the reason the receipt carries it at all: under the
// repository's warning denial a lint arrives as an ERROR and stops the build, so a non-zero count
// on a zero status can only be a warning rustc did not own, which is still a warning the receipt
// would otherwise have swallowed.
fn native_progress_artifact_findings(build: NativeRouteEmittedBuild) -> List<NativeProgressFinding> {
  let status_findings =
    if build.exit_status == 0 {
      []
    } else {
      [ArtifactProductionFailed {
        detail: join(["the emitted crate did not build: cargo exit status is not zero, compiler ", build.compiler_path], "")
      }]
    }
  if build.warning_count == 0 {
    status_findings
  } else {
    list_append(left: status_findings, right: [ArtifactProductionFailed {
      detail: "the emitted crate built with warning diagnostics under a denial that makes a lint an error, so the warnings are ones rustc did not own"
    }])
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE JOIN
// ═══════════════════════════════════════════════════════════════════════════════════════════

// THE OBSERVED SIDE, AT THE SAME GRAIN AS THE BASELINE. The caller supplies the per-identity
// attainment it derived from the run's own dispositions, because deriving it here would mean
// re-asking `native_route_disposition` -- re-executing admission's own fold, which has its own
// subject and its own discriminating red (DESIGN section 3: a witness discriminates at one
// interface, and a claim that re-runs another module's fold asserts nothing new and pays for all
// of it again). This module's subject is the ORDER and the JOIN, and nothing else.
type NativeProgressObservedRow {
  identity: NativeRouteTestIdentity
  attained: NativeRouteAttainment
}

// READING ONE OBSERVED MEMBER, WITH ITS MALFORMED PAIR REPORTED RATHER THAN ONLY ABSORBED.
//
// `native_attainment_of_with_stage` takes the ladder's bottom for an exclusion whose verdict
// names no stage, because a fold must be total and inventing a position is worse. But bottom
// SILENTLY MASKS a real regression from `eval` down, so the pair cannot only be absorbed: the
// reading reports it, and the report carries it as a finding like any other. That is the
// difference between a fail-closed default and a fail-closed default nobody hears about.
type NativeProgressObservedReading {
  row: NativeProgressObservedRow
  findings: List<NativeProgressFinding>
}

// A DISPOSITION THAT SAYS "EXCLUDED" OVER A VERDICT THAT NAMES NO STAGE IS A MALFORMED PAIR, and
// this fold takes the BOTTOM of the ladder for it rather than inventing a position. Bottom is
// fail-closed in one direction only -- it can never manufacture progress -- and it cannot
// manufacture a regression either, because a bar recorded through this same fold would have taken
// bottom too. What it WOULD do is mask a real fall from `eval` down to bottom, so the pair is also
// COUNTED as a malformed reading by `native_progress_read_observed` rather than only absorbed.
fn native_attainment_of_with_stage(
  disposition: NativeRouteDisposition,
  refused_at: Optional<NativeTestStage>
) -> NativeRouteAttainment {
  match disposition {
    NativeAgreementPass => AttainAgreed
    NativeAgreementExpectedRed => AttainAgreed
    NativeAgreementRouteGap => AttainAgreed
    NativeDivergence { cause: c } => AttainDiverged { cause: c }
    NativeExclusion { cause: c } =>
      match refused_at {
        Present { value: s } => AttainRefused { stage: s, cause: c }
        Absent => AttainRefused { stage: NativeTestStagePrepare, cause: c }
      }
  }
}

fn native_progress_read_observed(
  identity: NativeRouteTestIdentity,
  disposition: NativeRouteDisposition,
  refused_at: Optional<NativeTestStage>
) -> NativeProgressObservedReading {
  let attained = native_attainment_of_with_stage(disposition: disposition, refused_at: refused_at)
  let malformed =
    match disposition {
      NativeExclusion { cause: _ } =>
        match refused_at {
          Absent => [ObservedMemberReadingMalformed { identity: identity }]
          Present { value: _ } => []
        }
      NativeAgreementPass => []
      NativeAgreementExpectedRed => []
      NativeAgreementRouteGap => []
      NativeDivergence { cause: _ } => []
    }
  NativeProgressObservedReading {
    row: NativeProgressObservedRow { identity: identity, attained: attained },
    findings: malformed
  }
}

fn native_progress_observed_rows(readings: List<NativeProgressObservedReading>) -> List<NativeProgressObservedRow> {
  list_map(xs: readings, f: fn(r) { r.row })
}

// A CONCATENATION, NOT AN ACCUMULATOR. `list_append(left: acc, right: ...)` inside a fold pays a
// full O(n) right-fold per step, which is the measured quadratic trap `v2.std.algebra`
// `list_snoc_item` was introduced for; `list_flat_map` removes the accumulator rather than making
// its append cheaper, which is the repair one level up.
fn native_progress_reading_findings(readings: List<NativeProgressObservedReading>) -> List<NativeProgressFinding> {
  list_flat_map(xs: readings, f: fn(r) { r.findings })
}

// THE JOIN IS KEYED, NOT SCANNED (review 69968).
//
// The baseline is one row per member of the DERIVED `v2.test.*` universe, so a linear scan of the
// observed population once per baseline row is O(n*m) over a population sized by the corpus. DESIGN
// section 6 fixes a proven cost-shape defect unconditionally -- "'n is small here' is not a
// time-stable fact (reuse changes n)" -- and this is landing before its first real run, so it is
// cheapest now and there is no realized n to argue about.
//
// THE KEY IS THE EXISTING IDENTITY AUTHORITY, NOT A SECOND ONE. `native_route_identity_qualified`
// is what the route already keys its subjects on, and it is INJECTIVE over this universe for a
// reason worth stating rather than assuming: a module qualified name may carry dots but a
// DECLARATION NAME MAY NOT, so the last dot in the joined form always divides them and no two
// distinct identities share a key. Minting a second key here would be the fork DESIGN section 3
// forbids, and a key without a complete canonical preimage is the conformance-identity defect
// beside it.

fn native_progress_observed_index(
  observed: List<NativeProgressObservedRow>
) -> Map<String, NativeRouteAttainment> {
  fold_list(
    xs: observed,
    empty: empty_map(),
    cons: fn(acc, row) {
      map_insert(m: acc, key: native_route_identity_qualified(identity: row.identity), value: row.attained)
    }
  )
}

fn native_progress_disposition_index(
  dispositions: List<NativeProgressDispositionRow>
) -> Map<String, NativeProgressDisposition> {
  fold_list(
    xs: dispositions,
    empty: empty_map(),
    cons: fn(acc, row) {
      map_insert(m: acc, key: native_route_identity_qualified(identity: row.identity), value: row.disposition)
    }
  )
}

fn native_cause_transition_index(
  rows: List<NativeCauseTransitionRow>
) -> Map<String, NativeCauseTransitionDisposition> {
  fold_list(
    xs: rows,
    empty: empty_map(),
    cons: fn(acc, row) {
      map_insert(m: acc, key: native_route_identity_qualified(identity: row.identity), value: row.disposition)
    }
  )
}

fn native_accept_to_refuse_index(
  rows: List<NativeAcceptToRefuseRow>
) -> Map<String, NativeAcceptToRefuseDisposition> {
  fold_list(
    xs: rows,
    empty: empty_map(),
    cons: fn(acc, row) {
      map_insert(m: acc, key: native_route_identity_qualified(identity: row.identity), value: row.disposition)
    }
  )
}

// A TRANSITION DISPOSITION IS CHECKED FROM ITS OWN SIDE TOO, exactly as a removal disposition is:
// one claimed for a subject that did NOT go accept-to-refuse is contradicted by the run, and
// leaving it standing would pre-authorise a future fall nobody looked at.
// THE THIRD ROSTER IS CHECKED FROM ITS OWN SIDE TOO, and it was the only one that was not
// (review 70131). Removal dispositions had `native_progress_disposition_row_findings`,
// accept-to-refuse had `native_accept_to_refuse_row_findings`, and `cause_transitions` was only
// ever READ BY KEY LOOKUP -- so a `CauseNowMoreTruthful` row for an identity whose cause did not
// move was never contradicted, persisted in the baseline, and SILENTLY PRE-AUTHORISED THE NEXT
// CAUSE CHANGE at that identity: the guard would return no finding where it owed
// `CauseTransitionUndispositioned` or `CauseRegressedAtAFixedRank`.
//
// A PRE-DECLARED WAIVER OF A RED THIS MODULE EXISTS TO RAISE is DESIGN section 5's escape hatch --
// "a toggle whose only effect is 'proceed as if the refusal had not fired'" -- and the section
// calls a diff that lands one a hard reject. It is also the eighth instance of
// `a_rule_is_applied_at_the_site_that_prompted_it_and_not_its_sibling` in this module, and the
// purest: the annotation on the accept-to-refuse checker states the rule VERBATIM -- "one claimed
// for a subject that did NOT go accept-to-refuse is contradicted by the run, and leaving it
// standing would pre-authorise a future fall nobody looked at" -- and the same sentence is true,
// word for word, of a cause-transition row. The rule was written down, next to the code, and not
// applied to the roster added after it.
//
// THE CHECK IS THE CONJUNCTION THE DISPOSITION CLAIMS: the identity must be in the baseline, in
// the run, AT EQUAL RANK, and carrying a DIFFERENT cause. Any one of those failing means the row
// describes something that did not happen.
fn native_cause_transition_row_findings(
  row: NativeCauseTransitionRow,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>
) -> List<NativeProgressFinding> {
  let key = native_route_identity_qualified(identity: row.identity)
  match map_lookup(m: baseline_index, key: key) {
    Absent => [CauseTransitionDispositionContradicted { identity: row.identity }]
    Present { value: bar } =>
      match map_lookup(m: observed, key: key) {
        Absent => [CauseTransitionDispositionContradicted { identity: row.identity }]
        Present { value: seen } =>
          if native_rank_is_equal(baseline: bar, seen: seen)
            && (native_cause_unchanged(baseline: bar, seen: seen) == false) {
            []
          } else {
            [CauseTransitionDispositionContradicted { identity: row.identity }]
          }
      }
  }
}

fn native_cause_transition_findings_from_rows(
  baseline: NativeProgressBaseline,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>,
  reach: NativeRunReach
) -> List<NativeProgressFinding> {
  if native_run_reached_the_population(r: reach) == false {
    []
  } else {
    list_flat_map(
      xs: baseline.cause_transitions,
      f: fn(row) {
        native_cause_transition_row_findings(row: row, baseline_index: baseline_index, observed: observed)
      }
    )
  }
}

fn native_accept_to_refuse_row_findings(
  row: NativeAcceptToRefuseRow,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>
) -> List<NativeProgressFinding> {
  let key = native_route_identity_qualified(identity: row.identity)
  match map_lookup(m: baseline_index, key: key) {
    Absent => [AcceptToRefuseDispositionContradicted { identity: row.identity }]
    Present { value: bar } =>
      match map_lookup(m: observed, key: key) {
        Absent => [AcceptToRefuseDispositionContradicted { identity: row.identity }]
        Present { value: seen } =>
          if native_fall_is_accept_to_refuse(baseline: bar, seen: seen) {
            []
          } else {
            [AcceptToRefuseDispositionContradicted { identity: row.identity }]
          }
      }
  }
}

fn native_accept_to_refuse_findings(
  baseline: NativeProgressBaseline,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>,
  reach: NativeRunReach
) -> List<NativeProgressFinding> {
  if native_run_reached_the_population(r: reach) == false {
    []
  } else {
    list_flat_map(
      xs: baseline.accept_to_refuse,
      f: fn(row) {
        native_accept_to_refuse_row_findings(row: row, baseline_index: baseline_index, observed: observed)
      }
    )
  }
}

fn native_progress_baseline_index(
  rows: List<NativeProgressBaselineRow>
) -> Map<String, NativeBaselineAttainment> {
  fold_list(
    xs: rows,
    empty: empty_map(),
    cons: fn(acc, row) {
      map_insert(m: acc, key: native_route_identity_qualified(identity: row.identity), value: row.attained)
    }
  )
}

fn native_progress_observed_for(
  identity: NativeRouteTestIdentity,
  observed: Map<String, NativeRouteAttainment>
) -> Optional<NativeRouteAttainment> {
  map_lookup(m: observed, key: native_route_identity_qualified(identity: identity))
}

fn native_progress_disposition_for(
  identity: NativeRouteTestIdentity,
  dispositions: Map<String, NativeProgressDisposition>
) -> Optional<NativeProgressDisposition> {
  map_lookup(m: dispositions, key: native_route_identity_qualified(identity: identity))
}

// THE RENAME ARM MUST ROUTE AN UNREACHED TARGET THE SAME WAY THE DIRECT ARM DOES, and it did not
// (review 70018). It handed the target straight to `native_attainment_at_least`, which answers
// `false` for an unreached reading BY CONSTRUCTION -- so a rename whose target nothing could look
// at was reported as `RenameTargetBelowBaseline`, "the rename lowered the bar", when the truth is
// "nothing looked at it". That is the same wrong-cause-in-the-rotting-direction the direct arm was
// repaired for one commit earlier, surviving in its sibling; the module's own annotation claimed
// unreached readings were routed to their own finding BEFORE reaching the comparison, and on this
// path that was false.
//
// THE FINDING NAMES THE TARGET, NOT THE ORIGINAL, because the target is the identity the run
// failed to reach and the one a reader needs to go looking for.
fn native_progress_rename_comparison(
  row: NativeProgressBaselineRow,
  target: NativeRouteTestIdentity,
  seen: NativeRouteAttainment
) -> List<NativeProgressFinding> {
  if native_attainment_at_least(observed: seen, baseline: row.attained) {
    []
  } else {
    [RenameTargetBelowBaseline {
      identity: row.identity,
      target: target,
      baseline: row.attained,
      observed: seen
    }]
  }
}

// AN ACCEPT-TO-REFUSE FALL IS THE ONE FALL THAT MAY BE ATTRIBUTED INSTEAD OF SCORED, and it is
// recognised by SHAPE rather than by asking the disposition list first: the bar was an agreement
// and the reading is a refusal. Any other fall -- agreement to divergence, a later stage to an
// earlier one -- is a regression whatever anybody wrote down, because no fail-open removal
// produces it.
fn native_fall_is_accept_to_refuse(
  baseline: NativeBaselineAttainment,
  seen: NativeRouteAttainment
) -> Bool {
  match baseline {
    BaselineAgreed =>
      match seen {
        AttainRefused { stage: _, cause: _ } => true
        AttainAgreed => false
        AttainDiverged { cause: _ } => false
        AttainUnreached { blocked_at: _ } => false
      }
    BaselineDiverged => false
    BaselineRefused { stage: _ } => false
  }
}

fn native_accept_to_refuse_for(
  identity: NativeRouteTestIdentity,
  rows: Map<String, NativeAcceptToRefuseDisposition>
) -> Optional<NativeAcceptToRefuseDisposition> {
  map_lookup(m: rows, key: native_route_identity_qualified(identity: identity))
}

// THE CAUSE COMPARISON IS GATED ON RANK EQUALITY, WHICH THE ANNOTATION ALREADY CLAIMED AND THE
// CODE DID NOT DO (review 70123).
//
// `native_cause_unchanged` compares causes while discarding the stage, and it was invoked on
// EVERY non-falling reading rather than only equal-rank ones. So a subject that genuinely
// ADVANCES -- `BaselineRefused { stage: prepare }` to `AttainRefused { stage: eval }`, which
// NECESSARILY carries a different cause, because it refused somewhere else -- was reported as
// `CauseTransitionUndispositioned`, whose rendered line says "same stage, same verdict, different
// diagnostic". That sentence is FALSE about such a run: the stage moved, which is the one thing
// the finding denies. Loud, located, and attributing the wrong cause, which is this module's own
// repeatedly-repaired class showing up as prose-says-X-code-does-Y.
//
// It also forced an author to file a `NativeCauseTransitionDisposition` for a pure stage advance,
// and all three of its arms are framed around a fixed rank -- so the vocabulary had no honest
// answer to offer.
//
// A RANK CHANGE ALREADY HAS ITS OWN ACCOUNTING: an advance is admitted by the rank comparison
// above, and a fall is a regression or an attributed accept-to-refuse. The cause coordinate is
// the question asked of positions the rank cannot separate, which is exactly what "at equal rank"
// meant.
fn native_rank_is_equal(baseline: NativeBaselineAttainment, seen: NativeRouteAttainment) -> Bool {
  match native_attainment_rank(a: seen) {
    Absent => false
    Present { value: r } => r == native_baseline_rank(b: baseline)
  }
}

fn native_cause_transition_findings(
  row: NativeProgressBaselineRow,
  seen: NativeRouteAttainment,
  cause_transitions: Map<String, NativeCauseTransitionDisposition>
) -> List<NativeProgressFinding> {
  if native_cause_unchanged(baseline: row.attained, seen: seen) {
    []
  } else {
    match map_lookup(
      m: cause_transitions,
      key: native_route_identity_qualified(identity: row.identity)
    ) {
      Absent => [CauseTransitionUndispositioned { identity: row.identity }]
      Present { value: d } =>
        match d {
          CauseNowMoreTruthful { was: _, now: _, why: _ } => []
          SameDefectRenamed { was: _, now: _ } => []
          CauseRegressedUnderANewLabel { was: w, now: n, why: _ } =>
            [CauseRegressedAtAFixedRank { identity: row.identity, was: w, now: n }]
        }
    }
  }
}

fn native_progress_rank_comparison(
  row: NativeProgressBaselineRow,
  seen: NativeRouteAttainment,
  accept_to_refuse: Map<String, NativeAcceptToRefuseDisposition>,
  cause_transitions: Map<String, NativeCauseTransitionDisposition>
) -> List<NativeProgressFinding> {
  if native_attainment_at_least(observed: seen, baseline: row.attained) {
    if native_rank_is_equal(baseline: row.attained, seen: seen) {
      native_cause_transition_findings(row: row, seen: seen, cause_transitions: cause_transitions)
    } else {
      []
    }
  } else if native_fall_is_accept_to_refuse(baseline: row.attained, seen: seen) {
    match native_accept_to_refuse_for(identity: row.identity, rows: accept_to_refuse) {
      Present { value: d } =>
        match d {
          PriorAcceptanceDependedOnARemovedFallback { fallback: _, now_refuses_with: _ } => []
          PriorAcceptanceWasNeverSound { authority: _, now_refuses_with: _ } => []
          AcceptanceWasSoundAndThisIsARegression { why: _ } =>
            [AcceptToRefuseDeclaredARegression {
              identity: row.identity,
              baseline: row.attained,
              observed: seen
            }]
        }
      Absent => [AcceptToRefuseUndispositioned {
        identity: row.identity,
        baseline: row.attained,
        observed: seen
      }]
    }
  } else {
    [ProgressRegressed { identity: row.identity, baseline: row.attained, observed: seen }]
  }
}

// A RUN THAT NEVER REACHED THE POPULATION OWES NO DISPOSITIONS, AND THIS GUARD IS THE ONE THE
// THIRD VERDICT DOES NOT REPLACE.
//
// Making `ProgressUnobserved` a verdict arm fixed what the LANE reports and left what the FINDINGS
// say untouched: with an empty population every baseline row still fell down the `Absent` path and
// came out as `BaselineMemberMissingUndisposed` -- "the subject vanished and owes a disposition" --
// which is the misattribution this whole section exists to remove, surviving one layer in under a
// verdict that had stopped repeating it. Found by the reviewer asking whether a red existed for
// exactly this case; it did not, and the claim that now exists
// (`w_RED_a_run_with_no_binary_reports_every_row_unreached_not_missing`) asserts the FINDING kind
// rather than the verdict, because the verdict was already right while the findings lied.
//
// The remedy is a short-circuit rather than a wider `Absent` arm: below the top rung there is no
// population to be absent FROM, so the question "is this subject missing" is not one this run can
// be asked, and answering it at all is the defect.

// ONE BASELINE ROW, DECIDED WHOLE. Present in the run: compare attainment. Absent from the run:
// the row owes a disposition, and the disposition owes a fact the run agrees with.
fn native_progress_row_findings(
  row: NativeProgressBaselineRow,
  observed: Map<String, NativeRouteAttainment>,
  dispositions: Map<String, NativeProgressDisposition>,
  accept_to_refuse: Map<String, NativeAcceptToRefuseDisposition>,
  cause_transitions: Map<String, NativeCauseTransitionDisposition>,
  reach: NativeRunReach
) -> List<NativeProgressFinding> {
  if native_run_reached_the_population(r: reach) == false {
    [SubjectUnreachedEarlierRungFailed { identity: row.identity, blocked_at: reach }]
  } else {
  match native_progress_observed_for(identity: row.identity, observed: observed) {
    Present { value: seen } =>
      match seen {
        AttainUnreached { blocked_at: r } =>
          [SubjectUnreachedEarlierRungFailed { identity: row.identity, blocked_at: r }]
        AttainRefused { stage: _, cause: _ } => native_progress_rank_comparison(row: row, seen: seen, accept_to_refuse: accept_to_refuse, cause_transitions: cause_transitions)
        AttainDiverged { cause: _ } => native_progress_rank_comparison(row: row, seen: seen, accept_to_refuse: accept_to_refuse, cause_transitions: cause_transitions)
        AttainAgreed => native_progress_rank_comparison(row: row, seen: seen, accept_to_refuse: accept_to_refuse, cause_transitions: cause_transitions)
      }
    Absent =>
      match native_progress_disposition_for(identity: row.identity, dispositions: dispositions) {
        Absent => [BaselineMemberMissingUndisposed { identity: row.identity }]
        Present { value: d } =>
          match d {
            SubjectDeleted { authority: _ } => []
            SubjectLeftTheUniverse { moved_to_module: _ } => []
            SubjectRenamed { to: target, authority: _ } =>
              match native_progress_observed_for(identity: target, observed: observed) {
                Absent => [RenameTargetAbsent { identity: row.identity, target: target }]
                Present { value: seen } =>
                  match seen {
                    AttainUnreached { blocked_at: r } =>
                      [SubjectUnreachedEarlierRungFailed { identity: target, blocked_at: r }]
                    AttainRefused { stage: _, cause: _ } => native_progress_rename_comparison(row: row, target: target, seen: seen)
                    AttainDiverged { cause: _ } => native_progress_rename_comparison(row: row, target: target, seen: seen)
                    AttainAgreed => native_progress_rename_comparison(row: row, target: target, seen: seen)
                  }
              }
          }
      }
  }
  }
}

// A DISPOSITION IS ALSO CHECKED FROM ITS OWN SIDE, in two directions the row fold above cannot
// see. A disposition for a subject the run DID discover is contradicted by the run -- somebody
// declared a deletion that did not happen, and leaving it standing would pre-authorize a future
// removal nobody looked at. A disposition for an identity with no baseline row at all is
// bookkeeping about nothing, and is the shape a disposition list takes as it rots.
fn native_progress_disposition_row_findings(
  row: NativeProgressDispositionRow,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>
) -> List<NativeProgressFinding> {
  let key = native_route_identity_qualified(identity: row.identity)
  let missing_row =
    match map_lookup(m: baseline_index, key: key) {
      Present { value: _ } => []
      Absent => [DisposedSubjectHasNoBaselineRow { identity: row.identity }]
    }
  let contradicted =
    match map_lookup(m: observed, key: key) {
      Present { value: _ } => [DispositionContradictedByRun { identity: row.identity }]
      Absent => []
    }
  list_append(left: missing_row, right: contradicted)
}

// THE DISPOSITION SIDE IS SILENT BELOW THE TOP RUNG FOR THE SAME REASON. `DispositionContradicted
// ByRun` asks whether the run still discovered the subject; a run that never reached the
// population discovered nothing, so every disposition would read as uncontradicted -- an answer
// that looks like agreement and is ignorance. `DisposedSubjectHasNoBaselineRow` is a fact about
// the roster rather than the run and would be safe to report, but it is withheld too: a run that
// observed nothing should not emit roster hygiene findings that a reader will read as findings
// ABOUT THAT RUN.
fn native_progress_disposition_findings(
  baseline: NativeProgressBaseline,
  baseline_index: Map<String, NativeBaselineAttainment>,
  observed: Map<String, NativeRouteAttainment>,
  reach: NativeRunReach
) -> List<NativeProgressFinding> {
  if native_run_reached_the_population(r: reach) == false {
    []
  } else {
  list_flat_map(
    xs: baseline.dispositions,
    f: fn(row) {
      native_progress_disposition_row_findings(row: row, baseline_index: baseline_index, observed: observed)
    }
  )
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// THE REPORT
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// TWO NUMBERS THAT ARE NOT THE SAME NUMBER, AND THE VERDICT READS ONLY ONE.
//
// `agreed` is "the requested tests passed" -- the encouraging figure, the one a reader wants, and
// the one that must never decide the lane. `findings` is "progress preserved", and it is empty or
// it is not. A report carrying only the first is the shape that let a frontier move backwards
// under a rising pass count; a report carrying only the second tells a reader nothing about
// whether the frontier ADVANCED, which is the point of running it.
type NativeProgressReport {
  reach: NativeRunReach
  provenance: NativeObservationProvenance
  adjudication: NativeVerdictAdjudication
  baseline_size: Int
  observed_size: Int
  agreed: Int
  findings: List<NativeProgressFinding>
}

// THE COMPARISON SHORT-CIRCUITS ACROSS A MEANING BOUNDARY rather than running and adding one
// more finding beside its results. A per-identity regression computed against a bar from a
// different definition of green is not a weaker reading of the same fact, it is a reading of a
// different one -- and emitting both would let a reader take the regressions at face value and
// treat the boundary as a footnote.
fn native_progress_report(
  baseline: NativeProgressBaseline,
  readings: List<NativeProgressObservedReading>,
  build: NativeRouteEmittedBuild,
  reach: NativeRunReach,
  provenance: NativeObservationProvenance,
  adjudication: NativeVerdictAdjudication
) -> NativeProgressReport {
  let comparable = native_adjudication_same(a: baseline.minted_under, b: adjudication)
  let observed_rows = native_progress_observed_rows(readings: readings)
  let observed = native_progress_observed_index(observed: observed_rows)
  let dispositions = native_progress_disposition_index(dispositions: baseline.dispositions)
  let baseline_index = native_progress_baseline_index(rows: baseline.rows)
  let accept_to_refuse = native_accept_to_refuse_index(rows: baseline.accept_to_refuse)
  let cause_transitions = native_cause_transition_index(rows: baseline.cause_transitions)
  let row_findings =
    if comparable {
      list_flat_map(
        xs: baseline.rows,
        f: fn(row) { native_progress_row_findings(row: row, observed: observed, dispositions: dispositions, accept_to_refuse: accept_to_refuse, cause_transitions: cause_transitions, reach: reach) }
      )
    } else {
      []
    }
  let adjudication_findings =
    if comparable {
      []
    } else {
      [BaselineMintedUnderADifferentAdjudication {
        baseline: baseline.minted_under,
        run: adjudication
      }]
    }
  NativeProgressReport {
    reach: reach,
    provenance: provenance,
    adjudication: adjudication,
    baseline_size: length(xs: baseline.rows),
    observed_size: length(xs: observed_rows),
    agreed: count_where(xs: observed_rows, predicate: fn(r) {
      match r.attained {
        AttainAgreed => true
        AttainDiverged { cause: _ } => false
        AttainRefused { stage: _, cause: _ } => false
        AttainUnreached { blocked_at: _ } => false
      }
    }),
    findings: list_flat_map(
      xs: [
        native_progress_artifact_findings(build: build),
        native_progress_reading_findings(readings: readings),
        row_findings,
        if comparable {
          native_progress_disposition_findings(baseline: baseline, baseline_index: baseline_index, observed: observed, reach: reach)
        } else {
          []
        },
        if comparable {
          native_accept_to_refuse_findings(baseline: baseline, baseline_index: baseline_index, observed: observed, reach: reach)
        } else {
          []
        },
        if comparable {
          native_cause_transition_findings_from_rows(baseline: baseline, baseline_index: baseline_index, observed: observed, reach: reach)
        } else {
          []
        },
        adjudication_findings
      ],
      f: fn(fs) { fs }
    )
  }
}

// THE VERDICT IS THE EMPTINESS OF THE FINDINGS AND NOTHING ELSE. Not a threshold, not a ratio,
// not "no worse than last time by more than k" -- a single regressed identity is a lost position
// and the lane says so.
// THREE STATES, AND THE THIRD IS THE ONE A TWO-STATE VERDICT GETS WRONG.
//
// `ProgressUnobserved` is a run that never reached the population: nothing regressed and nothing
// was preserved, because nothing was looked at. It BLOCKS -- a merge candidate that established
// nothing is not a pass, which is the whole of DESIGN section 5's refusal to let an empty
// observation stand in for a clean one -- and it is a DIFFERENT RED from `ProgressLost`, because
// it sends a reader to the earlier rung rather than into a diff. It also may not advance the
// ratchet, which `native_progress_baseline_advance` enforces rather than trusting.
//
// This is not a hypothetical arm waiting for a bad day: it is the state EVERY head is in right
// now, and a two-state verdict would report today's reality as a corpus-wide regression.
type NativeProgressVerdict
  = ProgressPreserved
  | ProgressLost { findings: List<NativeProgressFinding> }
  | ProgressUnobserved { reach: NativeRunReach, findings: List<NativeProgressFinding> }

fn native_progress_verdict(report: NativeProgressReport) -> NativeProgressVerdict {
  if native_run_reached_the_population(r: report.reach) {
    if is_empty(xs: report.findings) {
      ProgressPreserved
    } else {
      ProgressLost { findings: report.findings }
    }
  } else {
    ProgressUnobserved { reach: report.reach, findings: report.findings }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// MINTING: THE ONLY ROUTE FROM READINGS TO A BASELINE, AND IT REFUSES PER ROW
// ═══════════════════════════════════════════════════════════════════════════════════════════
//
// `native_progress_baseline_advance` answers whether a RUN may advance the ratchet at all.
// This answers, for a run that may, WHICH OF ITS READINGS CAN BE BARS -- a separate question,
// and the one the defect at review 70058 walked through. A consumer that built rows itself would
// have to remember that an unreached reading is not a bar; here it cannot construct one, and the
// readings it could not mint are RETURNED rather than dropped, because a subject silently missing
// from a new baseline is indistinguishable from one legitimately removed.
type NativeBaselineMinting {
  rows: List<NativeProgressBaselineRow>
  unmintable: List<NativeRouteTestIdentity>
}

fn native_progress_mint_row(row: NativeProgressObservedRow) -> List<NativeProgressBaselineRow> {
  match native_observed_as_baseline(a: row.attained) {
    Absent => []
    Present { value: b } => [NativeProgressBaselineRow { identity: row.identity, attained: b }]
  }
}

fn native_progress_unmintable_identity(row: NativeProgressObservedRow) -> List<NativeRouteTestIdentity> {
  match native_observed_as_baseline(a: row.attained) {
    Absent => [row.identity]
    Present { value: _ } => []
  }
}

fn native_progress_mint_baseline(
  readings: List<NativeProgressObservedReading>
) -> NativeBaselineMinting {
  let rows = native_progress_observed_rows(readings: readings)
  NativeBaselineMinting {
    rows: list_flat_map(xs: rows, f: native_progress_mint_row),
    unmintable: list_flat_map(xs: rows, f: native_progress_unmintable_identity)
  }
}

// THE RATCHET ADVANCES FROM ONE KIND OF RUN ONLY, and this is a typed refusal rather than a note
// asking the consumer nicely. Three ways to be told no, kept apart because they have different
// remedies: a historical measurement is evidence to KEEP and never to advance from (A3 -- a
// baseline advanced from a tree that no longer exists asserts a position no current head can be
// held to); an unreached run observed nothing to advance from; and a run that lost a position
// must not have that loss frozen into the new floor.
fn native_progress_baseline_advance(report: NativeProgressReport) -> NativeBaselineAdvance {
  match report.provenance {
    HistoricalMainObservation { tree: t, note: _ } => BaselineAdvanceRefusedHistorical { tree: t }
    BranchObservation { branch: b, head: h } => BaselineAdvanceRefusedNeverMain { branch: b, head: h }
    AuthorCompositionObservation { base_head: bh, overlay: o, note: _ } =>
      BaselineAdvanceRefusedNotALandableTree { base_head: bh, overlay: o }
    MainBaselineObservation { head: h } =>
      match native_progress_verdict(report: report) {
        ProgressUnobserved { reach: r, findings: _ } => BaselineAdvanceRefusedUnreached { reach: r }
        ProgressLost { findings: _ } => BaselineAdvanceRefusedProgressLost
        ProgressPreserved => BaselineMayAdvance { head: h }
      }
  }
}

// THE OPERATOR'S LINE FOR ONE FINDING. Each names its subject, because a reader of a red run must
// reach the identity without opening a second artifact.
fn native_progress_finding_text(f: NativeProgressFinding) -> String {
  match f {
    ProgressRegressed { identity: id, baseline: _, observed: _ } =>
      join(["REGRESSED ", native_route_identity_qualified(identity: id)], "")
    BaselineMemberMissingUndisposed { identity: id } =>
      join(["MISSING WITHOUT A DISPOSITION ", native_route_identity_qualified(identity: id)], "")
    DispositionContradictedByRun { identity: id } =>
      join(["DISPOSITION CONTRADICTED BY THE RUN ", native_route_identity_qualified(identity: id)], "")
    RenameTargetAbsent { identity: id, target: t } =>
      join(["RENAME TARGET NOT OBSERVED ", native_route_identity_qualified(identity: id), " -> ", native_route_identity_qualified(identity: t)], "")
    RenameTargetBelowBaseline { identity: id, target: t, baseline: _, observed: _ } =>
      join(["RENAME TARGET BELOW THE BASELINE ", native_route_identity_qualified(identity: id), " -> ", native_route_identity_qualified(identity: t)], "")
    DisposedSubjectHasNoBaselineRow { identity: id } =>
      join(["DISPOSITION FOR A SUBJECT WITH NO BASELINE ROW ", native_route_identity_qualified(identity: id)], "")
    ArtifactProductionFailed { detail: d } =>
      join(["ARTIFACT PRODUCTION FAILED ", d], "")
    ObservedMemberReadingMalformed { identity: id } =>
      join(["OBSERVED MEMBER READING MALFORMED ", native_route_identity_qualified(identity: id)], "")
    BaselineMintedUnderADifferentAdjudication { baseline: b, run: r } =>
      join([
        "NOT A BAR IN THE CURRENT MEANING: the baseline was minted under '", b.authority,
        "' closure ", (b.closure_identity.digest as String), native_adjudication_receipt_text(a: b),
        " and this run was adjudicated by '", r.authority,
        "' closure ", (r.closure_identity.digest as String), native_adjudication_receipt_text(a: r),
        " -- a comparison would span two definitions of green"
      ], "")
    AcceptToRefuseUndispositioned { identity: id, baseline: _, observed: _ } =>
      join([
        "ACCEPT-TO-REFUSE WITHOUT A DISPOSITION (this may be an advance -- a fabricated acceptance ",
        "becoming an attributed refusal is a rung UP -- but it must be enumerated and attributed, ",
        "not assumed either way) ", native_route_identity_qualified(identity: id)
      ], "")
    CauseTransitionUndispositioned { identity: id } =>
      join([
        "CAUSE CHANGED AT A FIXED RANK WITHOUT A DISPOSITION (same stage, same verdict, different ",
        "diagnostic -- which may be the most valuable kind of change there is, or a regression that ",
        "moves nothing; it must be classified, not assumed) ",
        native_route_identity_qualified(identity: id)
      ], "")
    CauseRegressedAtAFixedRank { identity: id, was: w, now: n } =>
      join([
        "CAUSE REGRESSED AT A FIXED RANK (declared, and declaring it does not excuse it): '", w,
        "' -> '", n, "' ", native_route_identity_qualified(identity: id)
      ], "")
    AcceptToRefuseDeclaredARegression { identity: id, baseline: _, observed: _ } =>
      join([
        "ACCEPT-TO-REFUSE DECLARED A REGRESSION (declared, and declaring it does not excuse it) ",
        native_route_identity_qualified(identity: id)
      ], "")
    CauseTransitionDispositionContradicted { identity: id } =>
      join([
        "CAUSE-TRANSITION DISPOSITION CONTRADICTED BY THE RUN (this subject's cause did not change ",
        "at a fixed rank, so the row describes something that did not happen and would have ",
        "pre-authorised the next change) ", native_route_identity_qualified(identity: id)
      ], "")
    AcceptToRefuseDispositionContradicted { identity: id } =>
      join([
        "ACCEPT-TO-REFUSE DISPOSITION CONTRADICTED BY THE RUN (this subject did not go from an ",
        "agreement to a refusal) ", native_route_identity_qualified(identity: id)
      ], "")
    SubjectUnreachedEarlierRungFailed { identity: id, blocked_at: r } =>
      join([
        "UNREACHED (the run stopped at '", native_run_reach_text(r: r), "', so this subject was never looked at) ",
        native_route_identity_qualified(identity: id)
      ], "")
  }
}
