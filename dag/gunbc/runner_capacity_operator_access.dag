module gunbc.runner_capacity_operator_access


data runner_capacity_operator_access_authority_disposition: std.disposition.Disposition = std.disposition.SingleAuthority

data runner_capacity_operator_access_note: String = "STEP E VOID (operator correction 2026-08-07): no SSH access receipt for ADD — reach is IN-BAND via gunbc.host_effect.LocalShell on a GHA job labelled for the target host. SSH is narrowed to RECOVER (zero-runner host / last-runner replace) only. Real ADD gate is PRIVILEGE (ReadEffectivePosixPrincipal + SudoNopasswdGrantListProbe). srv1 probed live 2026-08-07: User=briansrls, (ALL) NOPASSWD: ALL. APPLICATION GOES THROUGH THE WORKFLOW ONLY — operator hand-converged srv1 caps before that ruling; srv1 is the row-6 already-converged control (modeled cap path must emit ZERO effects on srv1). LIVE WIDTH = unit/process + org roster, NOT directories. #7940 subsumes runner-liveness-reconcile.timer. Read live ctrl installer at /home/briansrls/ctrl/scripts/session-dashboard/host/install-actions-runner.sh before wiring realizers; model-vs-fresh realizer scope is operator-open."

data runner_capacity_workflow_only_application_note: String = "OPERATOR RULING (2026-08-07): all host mutation goes through gunbc apply workflow — never hand-ssh fixes. A realizer refusal is a line-stop signal, not permission to act manually. srv1's five slots were hand-converged to the 14GiB model before this ruling; they are now the acceptance row 6 fixture (already correct → zero effects). srv2/srv3/srv4 remain at 16GiB until the workflow applies."

data runner_capacity_apply_yml_heal_note: String = "PR A apply.yml heal is structurally blocked: .github/workflows/** cannot be pushed by the Actions token. CI cannot emit apply.yml; an author commit is required. Do not depend on heal landing that file."

data runner_capacity_width_authority_note: String = "WIDTH AUTHORITY = activated unit count joined to org roster, NOT install-tree count. srv1: 50 complete trees, 5 active. srv3 observed 2026-08-07: slots 06/07/08 are complete install trees (08 exists — materialized width 8); committed width 7 is a memory CEILING, not a materialization limit — slot 08 stays materialized and unactivated. Stale .runner on 06/07 is not a blocker (rewritten at start). Never refuse or re-extract complete dormant trees."

data srv3_slot_installation_parent_probe_note: String = "AUTHORITATIVE: vivid-eagle-131 read-only in-band observation 2026-08-07 (srv2->ubuntu@192.168.1.221). Mapped in gunbc.runner_incarnation vivid_eagle_srv3_slot_installation_observation. 01..05 active; 06/07/08 materialized-not-active. No further probe needed."

type RunnerCapacityActionClass
  = RunnerCapacityAddSlots { host: product.placement_supply.HostIdentity }
  | RunnerCapacityRecoverHost { host: product.placement_supply.HostIdentity }

type RunnerCapacityExecutionTarget
  = RunnerCapacityExecuteInBand {
      host_label: std.types.NonEmptyStr
      transport: gunbc.host_effect.HostEffectTransport
    }
  | RunnerCapacityExecuteHostedRemote {
      host: product.placement_supply.HostIdentity
      transport: gunbc.host_effect.HostEffectTransport
      reason: String
    }

fn runner_capacity_execution_target_for_action(
  action: gunbc.runner_capacity_operator_access.RunnerCapacityActionClass,
) -> gunbc.runner_capacity_operator_access.RunnerCapacityExecutionTarget {
  match action {
    RunnerCapacityAddSlots { host: h } =>
      RunnerCapacityExecuteInBand {
        host_label: h as std.types.NonEmptyStr,
        transport: gunbc.host_effect.LocalShell,
      }
    RunnerCapacityRecoverHost { host: h } =>
      RunnerCapacityExecuteHostedRemote {
        host: h,
        transport: gunbc.host_effect.SshShell,
        reason: concat(
          "zero-runner recovery on ",
          concat(
            h as String,
            " requires GitHub-hosted job + SSH reach; ADD lane uses in-band gunbc.host_effect.LocalShell only (#7940 repair)",
          ),
        ),
      }
  }
}

type RunnerCapacitySlotAddPrivilegeOperation
  = PrivOpRunnerRootDirectoryCreate {}
  | PrivOpSystemdUnitInstall {}
  | PrivOpSystemdDaemonReload {}
  | PrivOpSystemdUnitStart {}

type RunnerCapacityInBandTransportBinding {
  github_actions_host_label: std.types.NonEmptyStr
  transport: gunbc.host_effect.HostEffectTransport
}

type RunnerCapacityInBandAdmissionProbes {
  effective_principal_read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead
  sudo_grant_list_probe: extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape
}

type RunnerCapacityHostInBandAdmissionRequirement {
  host: product.placement_supply.HostIdentity
  transport_binding: gunbc.runner_capacity_operator_access.RunnerCapacityInBandTransportBinding
  executing_principal: std.types.NonEmptyStr
  required_operations: List<gunbc.runner_capacity_operator_access.RunnerCapacitySlotAddPrivilegeOperation>
  probes: gunbc.runner_capacity_operator_access.RunnerCapacityInBandAdmissionProbes
}

data runner_capacity_slot_add_required_operations: List<gunbc.runner_capacity_operator_access.RunnerCapacitySlotAddPrivilegeOperation> = [
  PrivOpRunnerRootDirectoryCreate {},
  PrivOpSystemdUnitInstall {},
  PrivOpSystemdDaemonReload {},
  PrivOpSystemdUnitStart {},
]

data runner_capacity_sudo_grant_list_probe: extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape = "/usr/bin/sudo" as extdeps.sudo.nopasswd_execute_probe.SudoNopasswdGrantListProbeShape

fn runner_capacity_in_band_transport_binding(host: product.placement_supply.HostIdentity) -> gunbc.runner_capacity_operator_access.RunnerCapacityInBandTransportBinding {
  RunnerCapacityInBandTransportBinding {
    github_actions_host_label: host as std.types.NonEmptyStr,
    transport: gunbc.host_effect.LocalShell,
  }
}

fn runner_capacity_in_band_admission_probes() -> gunbc.runner_capacity_operator_access.RunnerCapacityInBandAdmissionProbes {
  RunnerCapacityInBandAdmissionProbes {
    effective_principal_read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead {},
    sudo_grant_list_probe: runner_capacity_sudo_grant_list_probe,
  }
}

fn runner_capacity_executing_principal_for_host(host: product.placement_supply.HostIdentity) -> std.types.NonEmptyStr {
  if (host as String) == (gunbc.fleet_intent_network.operator_host_srv3 as String) {
    gunbc.runner_host_deploy.srv3_runner_host_deploy.runner_user as std.types.NonEmptyStr
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
    gunbc.runner_host_deploy.srv4_runner_host_deploy.runner_user as std.types.NonEmptyStr
  } else {
    "briansrls" as std.types.NonEmptyStr
  }
}

fn runner_capacity_host_in_band_admission_requirement(host: product.placement_supply.HostIdentity) -> gunbc.runner_capacity_operator_access.RunnerCapacityHostInBandAdmissionRequirement {
  RunnerCapacityHostInBandAdmissionRequirement {
    host: host,
    transport_binding: runner_capacity_in_band_transport_binding(host: host),
    executing_principal: runner_capacity_executing_principal_for_host(host: host),
    required_operations: runner_capacity_slot_add_required_operations,
    probes: runner_capacity_in_band_admission_probes(),
  }
}

type InBandPrivilegeObservation
  = PrivilegeObserved {
      observed_on: std.types.NonEmptyStr
      host: product.placement_supply.HostIdentity
      principal: std.types.NonEmptyStr
      sudo_grant_summary: std.types.NonEmptyStr
    }
  | PrivilegeUnobserved { reason: String }

data srv1_in_band_privilege_observation: gunbc.runner_capacity_operator_access.InBandPrivilegeObservation = PrivilegeObserved {
  observed_on: "2026-08-07" as std.types.NonEmptyStr,
  host: gunbc.fleet_intent_network.operator_host_srv1,
  principal: "briansrls" as std.types.NonEmptyStr,
  sudo_grant_summary: "actions-runner units run as User=briansrls; sudo -n -l returns (ALL) NOPASSWD: ALL; sudo -n true succeeds (deep-badger-594 srv1 probe 2026-08-07)" as std.types.NonEmptyStr,
}

fn in_band_privilege_observation_for_host(host: product.placement_supply.HostIdentity) -> gunbc.runner_capacity_operator_access.InBandPrivilegeObservation {
  if (host as String) == (gunbc.fleet_intent_network.operator_host_srv1 as String) {
    srv1_in_band_privilege_observation
  } else if (host as String) == (gunbc.fleet_intent_network.operator_host_srv3 as String)
    || (host as String) == (gunbc.fleet_intent_network.operator_host_srv4 as String) {
    PrivilegeUnobserved {
      reason: concat(
        "in-band privilege probe not yet executed on ",
        concat(host as String, " — require ReadEffectivePosixPrincipal + SudoNopasswdGrantListProbe via gunbc.host_effect.LocalShell job labelled for host"),
      ),
    }
  } else {
    PrivilegeUnobserved {
      reason: "host is not enrolled in runner_capacity_operator_access in-band admission",
    }
  }
}

data srv1_already_converged_caps_control_note: String = "srv1 acceptance row 6 control (operator 2026-08-07): five slots hand-converged to modeled 14GiB caps (MemoryMax=15032385536 MemoryHigh=13958643712 MemorySwapMax=34359738368 CPUWeight=100) plus (per the original note) TasksMax=512 — but the 2026-08-08 operator ruling on PR 8045 made 16384 the desired TasksMax (512 is the diagnosed EAGAIN outage value), and the 512 claim was then DECIDED FALSE BY OBSERVATION (executed pre-apply receipt, run 31288091024, 2026-08-09, operator-accepted: all five slots at effective TasksMax=16384 with matching cgroup pids.max). The zero-effects premise therefore holds on every converged axis including tasks, and the no-op control is exact. Still discriminates directory-counting or write-blind realizers."

type RunnerCapacityHostAdmissionVerdict
  = InBandAdmissionRequirementDocumented { requirement: gunbc.runner_capacity_operator_access.RunnerCapacityHostInBandAdmissionRequirement }
  | InBandPrivilegeUnobserved { host: product.placement_supply.HostIdentity, reason: String }
  | InBandPrivilegeInsufficient { host: product.placement_supply.HostIdentity, detail: std.types.NonEmptyStr, missing: std.types.NonEmptyStr }
  | OrgRosterReadScopeUnverified { host: product.placement_supply.HostIdentity, reason: String }

data runner_capacity_org_roster_scope_note: String = "Acceptance rows 5/6/8 require a live org self-hosted-runner roster read. GET /orgs/gunb-ai/actions/runners returns 403 for some session tokens; in-band runner job tokens may differ. Until scope is verified in-band, roster-dependent convergence refuses — never fabricates registrations."

fn runner_capacity_host_admission_verdict(host: product.placement_supply.HostIdentity) -> gunbc.runner_capacity_operator_access.RunnerCapacityHostAdmissionVerdict {
  let requirement = runner_capacity_host_in_band_admission_requirement(host: host)
  match in_band_privilege_observation_for_host(host: host) {
    PrivilegeObserved { observed_on: _, host: _, principal: _, sudo_grant_summary: _ } =>
      InBandAdmissionRequirementDocumented { requirement: requirement }
    PrivilegeUnobserved { reason: r } =>
      InBandPrivilegeUnobserved { host: host, reason: r }
  }
}

fn runner_capacity_managed_host_admission_verdicts() -> List<gunbc.runner_capacity_operator_access.RunnerCapacityHostAdmissionVerdict> {
  [
    runner_capacity_host_admission_verdict(host: gunbc.fleet_intent_network.operator_host_srv3),
    runner_capacity_host_admission_verdict(host: gunbc.fleet_intent_network.operator_host_srv4),
  ]
}

fn runner_capacity_in_band_admission_blocks_wet_work(host: product.placement_supply.HostIdentity) -> Bool {
  match runner_capacity_host_admission_verdict(host: host) {
    InBandAdmissionRequirementDocumented { requirement: _ } => false
    InBandPrivilegeUnobserved { host: _, reason: _ } => true
    InBandPrivilegeInsufficient { host: _, detail: _, missing: _ } => true
    OrgRosterReadScopeUnverified { host: _, reason: _ } => true
  }
}
