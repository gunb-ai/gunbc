module gunbc.namespace_baseline_seed_growth

import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.seed_growth { SeedGrowthJustification }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// Seed-growth obligation for v1_compiler.namespace_baseline (2026-09-19). The module is the
// NON-GATE RESIDUE of v1_compiler.namespace_wave_admission, which was deleted with the
// wave-admission wall by operator ruling 2026-09-19 (gunbc.rung_drop
// namespace_wave_admission_wall_removed): the wall's adjudication, disposition vocabulary,
// transition-admission roster loading and refusal verdicts are gone, and what remains is the
// machinery the required floor and the joint claim join already shared -- the base-side index
// reconstruction over a diff window, the git acquisition helpers it runs on, and the
// parse-environment-of-a-revision loader that keeps a base readable under its own grammar.
//
// WHY THE RESIDUE IS JUSTIFIED AT ALL rather than deleted with the wall: the required floor's
// arm-set-consumer planning row (gunbc.floor_arm_set_consumer_seed_growth, gunbc#11194) reads
// its base side through reconstruct_base_index, and joint_claim_join parses base-side sources
// through base_records. Those consumers predate the deletion and survive it unchanged; deleting
// the machinery with the wall would have been a second, unruled removal smuggled inside the
// ruled one.
//
// WHAT THIS ROW DOES NOT COVER: the seven declarations whose admitting purpose is the floor's
// stale-match planning (BaselineReconstruction, reconstruct_base_index and the five arm-set
// consumer items). They stay rostered in gunbc.floor_arm_set_consumer_seed_growth, with only
// their module_path re-pointed, because their justification is that feature's and did not change
// when the file was renamed.

data namespace_baseline_seed_growth_note: String = "Seed-growth obligation for v1_compiler.namespace_baseline: the base-side declaration-index reconstruction over a diff window (gunbc#11194's floor planning row, joint_claim_join, behavioral_receipt_host's git leg), plus the parse-environment-of-a-revision loader. Declared 2026-09-19 when the wave-admission wall around this machinery was deleted by operator ruling; the wall's own justification (gunbc.namespace_wave_admission namespace_wave_admission_seed_growth_justification) is deleted with its module, and its seven floor-purpose items remain admitted by gunbc.floor_arm_set_consumer_seed_growth under their new module path."

data namespace_baseline_seed_growth_justification: SeedGrowthJustification = SeedGrowthJustification {
  hand_authored_declarations: [
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "KERNEL_DECLARATION_IDENTITY", field: WholeDeclaration },
