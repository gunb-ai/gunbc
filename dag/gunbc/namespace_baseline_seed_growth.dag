    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "kernel_set_serves_both", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "KERNEL_TYPES_ITEM", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "kernel_names_at", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "evaluate_owned_item_in", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "revision_scratch_root", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "closure_paths_of", field: WholeDeclaration },
    DeclarationRef { module_path: "v1_compiler.namespace_baseline", decl_name: "as_kernel_set_refusal", field: WholeDeclaration },
