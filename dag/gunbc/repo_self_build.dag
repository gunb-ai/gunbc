module gunbc.repo_self_build

import std.types { String, List, NonEmptyStr }

// THE SINGLE POINT THROUGH WHICH THIS REPOSITORY BUILDS ITS OWN BINARIES.
// Before this module the same operation was spelled independently in three
// workflow authorities and hand-authored in a fourth, with the bin sets
// differing and nothing relating them, so "how this repo builds its compiler"
// had four owners and could be changed inconsistently -- which it already had
// been. Operator ruling 2026-08-24: everything compiles through the same
// point, no forks allowed.
//
// The split follows DESIGN section 3. The cargo BUILD SHAPE is upstream's and
// belongs to extdeps.rust.cargo. WHICH package and WHICH bins is business
// policy and lives here. How a consumer transports it -- a workflow RunStep, a
// host effect, an interpreter service call -- is realization and lives with
// the consumer. A caller that writes the argv itself has taken all three back.
//
// The construction is not novel: witness_floor_workflow already folded a bin
// roster onto one base command, correctly, in private. What was missing was
// not the idea but its REACH -- three other consumers could not call it. This
// module is that function promoted to where every consumer can reach it.

data repo_self_build_authority_note: String = "Single authority for the argv this repository uses to build its own binaries. The package is a fact about THIS repository's layout, not about cargo, so it is data here rather than a parameter every caller re-supplies: a caller free to name the package could build a different crate and still look like a conforming call. The BIN SET is a parameter because it genuinely differs by consumer -- the required floor needs claim_executor and gunbc, fleet-desired needs gunbc alone -- and that difference is the only axis on which honest callers disagree."

data repo_self_build_package: NonEmptyStr = "v1-compiler"

data repo_self_build_profile_flag: String = "--release"

data repo_self_build_empty_bins_note: String = "An empty bin set renders the package build with no --bin selector, which is cargo's own meaning for it (build every target in the package) and is a DIFFERENT request from building a named subset -- not a degenerate case of one. It is rendered rather than refused because a fold over an empty roster produces exactly this string in the construction this module promotes, so the state is reachable by an honest caller; a refusal here would break a caller that is asking cargo a legitimate question."

fn repo_self_build_bin_flag(bin: String) -> String {
  join(["--bin ", bin], "")
}

fn repo_self_build_bin_selector(bins: List<String>) -> String {
  join(bins |> map(b => repo_self_build_bin_flag(bin: b)), " ")
}

// WHY THE SUBJECT IS A CLOSED VOCABULARY AND NOT A PACKAGE PARAMETER.
// The authority note above pins the package as data on the grounds that "a
// caller free to name the package could build a different crate and still look
// like a conforming call". That reasoning is right about the danger and was
// wrong about the remedy, because a second HONEST subject exists: the
// self-host regen gate builds an EMITTED CANDIDATE TREE that lives only during
// the run (crisp-crab-430, closing the fail-open arm where required-regen
// compares emitted bytes to committed bytes and never asks whether either
// compiles). That caller is not an under-served case of this module -- it is
// excluded by the exact property the note relies on.
//
// Making the package a free parameter would buy them in by giving up the
// guarantee. A closed subject coproduct keeps both: no constructor names an
// arbitrary crate, and the one other legitimate breadth has a name. This is
// DESIGN section 2 horizontal -- one concept at two breadths -- rather than a
// sibling authority sharing an argv vocabulary, which is what a section 3 fork
// looks like from the inside.
type CargoBuildSubject
  = RepositoryCrate
  | EmittedCandidateTree { manifest_path: String }

// THE VERB IS AN AXIS BECAUSE THE TWO CONSUMERS ASK DIFFERENT QUESTIONS.
// Producing runnable binaries needs `build`; establishing that an emitted tree
// COMPILES needs only `check`, and the difference is not cosmetic -- measured
// warm with the whole stage0 lib recompiled, which is exactly the
// candidate-install case: check 59.8s / 2.5GB peak against build 155s / 4.7GB
// peak, with every diagnostic of interest check-visible. Left hardcoded, the
// second consumer writes "cargo check" beside this module's "cargo build" and
// the fork this module exists to prevent reappears one field down.
type CargoVerb
  = CargoBuild
  | CargoCheck

fn cargo_verb_token(verb: CargoVerb) -> String {
  match verb {
    CargoBuild => "cargo build"
    CargoCheck => "cargo check"
  }
}

fn cargo_subject_selector(subject: CargoBuildSubject) -> String {
  match subject {
    RepositoryCrate => join(["-p", repo_self_build_package as String], " ")
    EmittedCandidateTree { manifest_path: path } => join(["--manifest-path", path], " ")
  }
}

fn repo_self_build_base_command(verb: CargoVerb, subject: CargoBuildSubject) -> String {
  join(
    [cargo_verb_token(verb: verb), repo_self_build_profile_flag, cargo_subject_selector(subject: subject)],
    " "
  )
}

fn repo_self_build_package_command() -> String {
  repo_self_build_base_command(verb: CargoBuild, subject: RepositoryCrate)
}

fn repo_self_build_command_for(
  verb: CargoVerb,
  subject: CargoBuildSubject,
  bins: List<String>
) -> String {
  let base = repo_self_build_base_command(verb: verb, subject: subject)
  if bins |> count == 0 {
    base
  } else {
    join([base, repo_self_build_bin_selector(bins: bins)], " ")
  }
}

// The repository's own crate, built, with a bin subset -- what every consumer
// in this repo wants today. Kept as the short spelling so the common call does
// not restate two axes it never varies.
fn repo_self_build_command(bins: List<String>) -> String {
  repo_self_build_command_for(verb: CargoBuild, subject: RepositoryCrate, bins: bins)
}
