module gunbc.git_diff_change_window


data git_diff_change_window_note: String = "Git realization of an exact affected-set comparison window. Producers observe merge-base(head, target_generation) in a Git worktree and persist a head- and window-identity-addressed receipt; consumers (gunbc.diff_baseline, floor_diff_observe) read the path named by GUNBC_DIFF_WINDOW_PATH. This module is Git-specific — other SCM realizations carry their own native receipts beneath a future compatibility envelope."

data gunbc_diff_window_path_env: std.types.NonEmptyStr = "GUNBC_DIFF_WINDOW_PATH"

data git_diff_window_schema: String = "gunbc-git-diff-window/v2"

data git_diff_window_absent_identity_label: String = "git-diff-window-absent"

data git_diff_window_target_member: String = "target_ref"
data git_diff_window_target_generation_member: String = "target_generation"
data git_diff_window_base_member: String = "base_object_id"
data git_diff_window_head_member: String = "head_object_id"
data git_diff_window_identity_member: String = "window_identity"
data git_diff_window_relation_member: String = "relation"
data git_diff_window_relation_observed: String = "observed_merge_base"

type GitObservedMergeBase {}

type GitExactDiffWindow {
  target: std.types.GitRef,
  target_generation: extdeps.git.object_store.GitObjectId,
  base: extdeps.git.object_store.GitObjectId,
  head: extdeps.git.object_store.GitObjectId,
  relation: GitObservedMergeBase,
  window_identity: std.content_hash.Fnv1a64Structural,
}

type GitDiffWindowObservation
  = GitDiffWindowObserved { window: GitExactDiffWindow }
  | GitDiffWindowMalformed { detail: String }
  | GitDiffWindowReadRefused { path: String, cause: String }

type GitMergeBaseObservation
  = GitMergeBaseObserved {
      target: std.types.GitRef,
      target_generation: extdeps.git.object_store.GitObjectId,
      base: extdeps.git.object_store.GitObjectId,
      head: extdeps.git.object_store.GitObjectId,
    }
  | GitMergeBaseProgramUnavailable { program: String, reason: String }
  | GitMergeBaseExecutionFailed {
      program: String,
      exit_code: Int,
      stdout: String,
      stderr: String,
    }
  | GitMergeBaseOutputMalformed { stdout: String }

type GitTargetGenerationObservation
  = GitTargetGenerationObserved { generation: extdeps.git.object_store.GitObjectId }
  | GitTargetGenerationProgramUnavailable { program: String, reason: String }
  | GitTargetGenerationExecutionFailed {
      program: String,
      exit_code: Int,
      stdout: String,
      stderr: String,
    }
  | GitTargetGenerationOutputMalformed { stdout: String }

type ChangeWindowPreparationRefusal
  = ChangeWindowMergeBaseRefused { observation: GitMergeBaseObservation }
  | ChangeWindowTargetGenerationRefused { observation: GitTargetGenerationObservation }
  | ChangeWindowHeadObjectIdRefused { head_hex: String }
  | ChangeWindowPersistenceRefused { path: String, cause: String }

type GitDiffWindowPrepareOutcome
  = GitDiffWindowPrepared { path: String, window: GitExactDiffWindow }
  | GitDiffWindowPrepareRefused { cause: ChangeWindowPreparationRefusal }

fn git_diff_window_required_string(doc: extdeps.languages.json.emit.JsonValue, key: String) -> String? {
  match extdeps.languages.json.parse.json_object_unique_member(v: doc, key: key) {
    extdeps.languages.json.parse.JsonMemberAbsent => none
    extdeps.languages.json.parse.JsonMemberDuplicated { count: _ } => none
    extdeps.languages.json.parse.JsonMemberNotAnObject => none
    extdeps.languages.json.parse.JsonMemberFound { value: v } =>
      match v {
        extdeps.languages.json.emit.JsonString { value: raw } =>
          let line = std.algebra.trim(raw)
          if line == "" { none } else { Present { value: line } }
        extdeps.languages.json.emit.JsonNull => none
        extdeps.languages.json.emit.JsonBool { value: _ } => none
        extdeps.languages.json.emit.JsonNumber { lexeme: _ } => none
        extdeps.languages.json.emit.JsonArray { elements: _ } => none
        extdeps.languages.json.emit.JsonObject { members: _ } => none
      }
  }
}

fn git_diff_window_git_object_id_from_member(doc: extdeps.languages.json.emit.JsonValue, key: String) -> extdeps.git.object_store.GitObjectId? {
  match git_diff_window_required_string(doc: doc, key: key) {
    Absent => none
    Present { value: hex } => extdeps.git.object_store.git_object_id_from_untagged_hex(hex: hex)
  }
}

fn git_diff_window_identity_of(
  target: std.types.GitRef,
  target_generation: extdeps.git.object_store.GitObjectId,
  base: extdeps.git.object_store.GitObjectId,
  head: extdeps.git.object_store.GitObjectId,
) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_combine_structural(
    left: std.content_hash.content_hash_combine_structural(
      left: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: target as std.types.NonEmptyStr),
        right: std.content_hash.content_hash_atom(
          value: extdeps.git.object_store.git_object_id_wire_hex(oid: target_generation) as std.types.NonEmptyStr
        ),
      ),
      right: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: extdeps.git.object_store.git_object_id_wire_hex(oid: base) as std.types.NonEmptyStr),
        right: std.content_hash.content_hash_atom(value: extdeps.git.object_store.git_object_id_wire_hex(oid: head) as std.types.NonEmptyStr),
      ),
    ),
    right: std.content_hash.content_hash_atom(value: git_diff_window_relation_observed as std.types.NonEmptyStr),
  )
}

fn git_diff_window_absent_identity() -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_atom(value: git_diff_window_absent_identity_label as std.types.NonEmptyStr)
}

fn git_diff_window_identity_hex(identity: std.content_hash.Fnv1a64Structural) -> String {
  identity.digest as String
}

fn git_diff_window_identities_equal(
  left: std.content_hash.Fnv1a64Structural,
  right: std.content_hash.Fnv1a64Structural,
) -> Bool {
  std.content_hash.content_hash_eq_structural(left: left, right: right)
}

fn git_exact_diff_window_for_verification(
  target: std.types.GitRef,
  target_generation: extdeps.git.object_store.GitObjectId,
  base: extdeps.git.object_store.GitObjectId,
  head: extdeps.git.object_store.GitObjectId,
) -> GitExactDiffWindow {
  let identity = git_diff_window_identity_of(
    target: target,
    target_generation: target_generation,
    base: base,
    head: head,
  )
  GitExactDiffWindow {
    target: target,
    target_generation: target_generation,
    base: base,
    head: head,
    relation: GitObservedMergeBase {},
    window_identity: identity,
  }
}

fn git_diff_window_json(window: GitExactDiffWindow) -> String {
  extdeps.languages.json.emit.serialize_json(
    v: extdeps.languages.json.emit.json_object(
      members: [
        extdeps.languages.json.emit.json_kv(key: "schema", value: extdeps.languages.json.emit.json_string(s: git_diff_window_schema)),
        extdeps.languages.json.emit.json_kv(key: git_diff_window_target_member, value: extdeps.languages.json.emit.json_string(s: window.target as String)),
        extdeps.languages.json.emit.json_kv(
          key: git_diff_window_target_generation_member,
          value: extdeps.languages.json.emit.json_string(s: extdeps.git.object_store.git_object_id_wire_hex(oid: window.target_generation) as String)
        ),
        extdeps.languages.json.emit.json_kv(
          key: git_diff_window_base_member,
          value: extdeps.languages.json.emit.json_string(s: extdeps.git.object_store.git_object_id_wire_hex(oid: window.base) as String)
        ),
        extdeps.languages.json.emit.json_kv(
          key: git_diff_window_head_member,
          value: extdeps.languages.json.emit.json_string(s: extdeps.git.object_store.git_object_id_wire_hex(oid: window.head) as String)
        ),
        extdeps.languages.json.emit.json_kv(
          key: git_diff_window_identity_member,
          value: extdeps.languages.json.emit.json_string(s: git_diff_window_identity_hex(identity: window.window_identity))
        ),
        extdeps.languages.json.emit.json_kv(
          key: git_diff_window_relation_member,
          value: extdeps.languages.json.emit.json_string(s: git_diff_window_relation_observed)
        ),
      ]
    )
  )
}

fn git_diff_window_from_json(text: String) -> GitDiffWindowObservation {
  match extdeps.languages.json.parse.parse_json(s: text) {
    Absent =>
      GitDiffWindowMalformed { detail: "git diff window payload is not valid JSON" }
    Present { value: doc } =>
      match git_diff_window_required_string(doc: doc, key: "schema") {
        Absent =>
          GitDiffWindowMalformed { detail: "git diff window payload missing schema member" }
        Present { value: schema } =>
          if schema != git_diff_window_schema {
            GitDiffWindowMalformed {
              detail: concat("git diff window schema must be ", git_diff_window_schema)
            }
          } else {
            match git_diff_window_required_string(doc: doc, key: git_diff_window_target_member) {
              Absent =>
                GitDiffWindowMalformed { detail: "git diff window target_ref is missing" }
              Present { value: target } =>
                match git_diff_window_git_object_id_from_member(
                  doc: doc,
                  key: git_diff_window_target_generation_member
                ) {
                  Absent =>
                    GitDiffWindowMalformed {
                      detail: "git diff window target_generation is missing or not a valid git object id"
                    }
                  Present { value: target_generation } =>
                    match git_diff_window_git_object_id_from_member(
                      doc: doc,
                      key: git_diff_window_base_member
                    ) {
                      Absent =>
                        GitDiffWindowMalformed {
                          detail: "git diff window base_object_id is missing or not a valid git object id"
                        }
                      Present { value: base } =>
                        match git_diff_window_git_object_id_from_member(
                          doc: doc,
                          key: git_diff_window_head_member
                        ) {
                          Absent =>
                            GitDiffWindowMalformed {
                              detail: "git diff window head_object_id is missing or not a valid git object id"
                            }
                          Present { value: head } =>
                            match git_diff_window_required_string(
                              doc: doc,
                              key: git_diff_window_relation_member
                            ) {
                              Absent =>
                                GitDiffWindowMalformed {
                                  detail: "git diff window relation must be observed_merge_base"
                                }
                              Present { value: relation } =>
                                if relation != git_diff_window_relation_observed {
                                  GitDiffWindowMalformed {
                                    detail: "git diff window relation must be observed_merge_base"
                                  }
                                } else if extdeps.git.object_store.git_object_id_wire_hex(oid: base) == extdeps.git.object_store.git_object_id_wire_hex(oid: head) {
                                  GitDiffWindowMalformed {
                                    detail: "git diff window base_object_id equals head_object_id — self-compare refused"
                                  }
                                } else {
                                  let derived = git_diff_window_identity_of(
                                    target: target as std.types.GitRef,
                                    target_generation: target_generation,
                                    base: base,
                                    head: head,
                                  )
                                  match git_diff_window_required_string(
                                    doc: doc,
                                    key: git_diff_window_identity_member
                                  ) {
                                    Absent =>
                                      GitDiffWindowMalformed {
                                        detail: "git diff window window_identity is missing"
                                      }
                                    Present { value: identity_hex } =>
                                      if git_diff_window_identity_hex(identity: derived) != identity_hex {
                                        GitDiffWindowMalformed {
                                          detail: "git diff window window_identity does not match derived identity"
                                        }
                                      } else {
                                        GitDiffWindowObserved {
                                          window: GitExactDiffWindow {
                                            target: target as std.types.GitRef,
                                            target_generation: target_generation,
                                            base: base,
                                            head: head,
                                            relation: GitObservedMergeBase {},
                                            window_identity: derived,
                                          }
                                        }
                                      }
                                  }
                                }
                            }
                        }
                    }
                }
            }
          }
      }
  }
}

fn git_diff_window_from_path(path: String) -> GitDiffWindowObservation {
  let read = extdeps.filesystem.filesystem_io.Filesystem.Read(path: path)
  if read.success {
    git_diff_window_from_json(text: read.content)
  } else {
    GitDiffWindowReadRefused {
      path: path,
      cause: read.error
    }
  }
}

fn git_diff_window_env_assignment(path: String) -> String {
  concat(
    concat(gunbc_diff_window_path_env as String, "="),
    path
  )
}
