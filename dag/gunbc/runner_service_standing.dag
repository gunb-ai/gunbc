module gunbc.runner_service_standing

// MATERIALIZE != ENABLE != START. Two cuts, not one, and the repository had already made the second
// one and then un-made it for this consumer: extdeps.systemd.systemctl says enable and start are
// "SEPARATE OPERATIONS, deliberately not `enable --now`", while its own systemctl_enable_now_command
// fuses them for exactly one caller -- runner slot activation. That fusion carries a note saying the
// split "is its own change with its own witness". This module is that change.
//
// WHY THE FUSION IS NOT MERELY UNTIDY. `enable` and `start` authorize different things across
// different time horizons. `start` runs the unit now, under whatever prerequisites hold now.
// `enable` declares the unit WANTED PERSISTENTLY, so it starts again after a reboot -- at a moment
// when the cache instance and compile pool this fleet gates activation on may not yet be ready.
// Fused, one admission decision is silently spent on both, and the post-reboot start inherits an
// admission that was measured against a machine state that no longer exists.
//
// WHAT THIS COST IN PRACTICE, measured 2026-08-25 rather than argued: the emitted apply.sh carries
// systemctl daemon-reload and systemctl disable and NOTHING that starts a runner -- enable count 0,
// start count 0. So fleet convergence reported a host converged when its slots existed on disk and
// served no traffic. srv1 held FIFTY slot directories with five runners running, a state that
// persisted indefinitely with nothing in the pipeline able to notice. Convergence was measuring
// filesystem state while the thing being converged is SERVICE CAPACITY.

import std.types { String, NonEmptyStr, List, Bool }
import v2.std.algebra { fold_list }

// THREE ORTHOGONAL AXES, NOT ONE LIFECYCLE ENUM. systemd can hold every combination of these -- a
// unit can be installed-but-disabled-and-running, or enabled-but-inactive -- so a single ordered
// enum would have to pick an order that does not exist and would make the off-diagonal states
// unrepresentable rather than merely unusual.
type RunnerMaterializationStanding
  = MaterializationUnobserved
  | RunnerAbsent
  | RunnerMaterialized
  | RunnerMaterializationDrifted { detail: NonEmptyStr }

type RunnerEnablementStanding
  = EnablementUnobserved
  | RunnerDisabled
  | RunnerEnabled

type RunnerActivityStanding
  = ActivityUnobserved
  | RunnerInactive
  | RunnerActivating
  | RunnerActive
  | RunnerFailed

type RunnerServiceStanding {
  materialization: RunnerMaterializationStanding
  enablement: RunnerEnablementStanding
  activity: RunnerActivityStanding
}

// THE ACTIONS ARE SEPARATE VALUES, so a consumer cannot express "enable and start" as one opaque
// step. That is the construction half of this module: the fused spelling has no representation here.
type RunnerServiceAction
  = MaterializeRunner
  | EnableRunnerUnit
  | StartRunnerUnit

type RunnerServicePlanRefusal
  = MaterializationStandingUnobserved
  | EnablementStandingUnobserved
  | ActivityStandingUnobserved
  | MaterializationDriftUnrepaired { detail: NonEmptyStr }
  | UnitInFailedState
  | ActivationNotAdmitted

type RunnerServicePlan
  = ServiceActionsPlanned { actions: List<RunnerServiceAction> }
  | ServicePlanRefused { cause: RunnerServicePlanRefusal }

// UNOBSERVED IS A REFUSAL, NEVER A DEFAULT. An axis nobody measured is not a disabled unit and not
// an inactive one; rendering it as either is the empty-observation narrow this repository already
// names as strictly worse than a widen -- a widen is expensive, a narrow is silently uncovered.
fn runner_service_plan(
  standing: RunnerServiceStanding,
  activation_admitted: Bool,
) -> RunnerServicePlan {
  match standing.materialization {
    MaterializationUnobserved =>
      ServicePlanRefused { cause: MaterializationStandingUnobserved }
    RunnerMaterializationDrifted { detail: d } =>
      ServicePlanRefused { cause: MaterializationDriftUnrepaired { detail: d } }
    RunnerAbsent =>
      // Materialization needs no activation admission: installing files admits no work.
      ServiceActionsPlanned { actions: [MaterializeRunner] }
    RunnerMaterialized =>
      runner_service_plan_for_materialized(
        enablement: standing.enablement,
        activity: standing.activity,
        activation_admitted: activation_admitted,
      )
  }
}

// BOTH ENABLE AND START CONSUME THE ADMISSION. Enabling is not the harmless half: it authorizes the
// unit to start after a reboot, potentially before the cache and pool prerequisites hold again.
fn runner_service_plan_for_materialized(
  enablement: RunnerEnablementStanding,
  activity: RunnerActivityStanding,
  activation_admitted: Bool,
) -> RunnerServicePlan {
  match activity {
    ActivityUnobserved => ServicePlanRefused { cause: ActivityStandingUnobserved }
    RunnerFailed => ServicePlanRefused { cause: UnitInFailedState }
    _ =>
      match enablement {
        EnablementUnobserved => ServicePlanRefused { cause: EnablementStandingUnobserved }
        _ => {
          let needed = runner_service_actions_needed(enablement: enablement, activity: activity)
          if list_length(items: needed) == 0 {
            ServiceActionsPlanned { actions: needed }
          } else {
            if activation_admitted {
              ServiceActionsPlanned { actions: needed }
            } else {
              ServicePlanRefused { cause: ActivationNotAdmitted }
            }
          }
        }
      }
  }
}

fn runner_service_actions_needed(
  enablement: RunnerEnablementStanding,
  activity: RunnerActivityStanding,
) -> List<RunnerServiceAction> {
  let enable_part = match enablement {
    RunnerDisabled => [EnableRunnerUnit]
    _ => [] as List<RunnerServiceAction>
  }
  let start_part = match activity {
    RunnerInactive => [StartRunnerUnit]
    _ => [] as List<RunnerServiceAction>
  }
  enable_part + start_part
}

fn runner_service_action_label(a: RunnerServiceAction) -> NonEmptyStr {
  match a {
    MaterializeRunner => "materialize" as NonEmptyStr
    EnableRunnerUnit => "enable" as NonEmptyStr
    StartRunnerUnit => "start" as NonEmptyStr
  }
}

fn runner_service_plan_is_converged(plan: RunnerServicePlan) -> Bool {
  match plan {
    ServiceActionsPlanned { actions: a } => list_length(items: a) == 0
    ServicePlanRefused { cause: _ } => false
  }
}
