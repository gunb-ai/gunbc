module gunbc.spark_serving_release


// THE SPARK SERVING RELEASE — one content-addressed identity over everything that must be
// identical on both replicas.
//
// The canary proved a runtime/model combination is executable on GB10 and proved nothing else.
// It is retired rather than refactored: neither its $HOME/gunbc-serve state nor its shell seeds
// this route, because three of its checks could not fail (cache corruption recovered instead of
// refusing, a permissive early exit sat above the strict readback, and generation was printed
// rather than asserted) and lifting that shell would carry those bypasses into production wearing
// a rewrite.
//
// WHY ONE IDENTITY RATHER THAN SEPARATE CHECKED CONDITIONS: four independently-checked facts can
// each pass while the composite is incoherent — a runtime from one resolution, a model from
// another, a serving configuration that matches neither. Hashing the closure makes "srv5 and srv6
// run the same thing" a single comparison instead of a conjunction someone can weaken one arm at
// a time.
type RuntimeArtifactIdentity { closure_digest: std.types.NonEmptyStr }

type ServingConfigurationIdentity { configuration_digest: std.types.NonEmptyStr }

type OllamaRuntime {}

type SparkServingRuntimeKind = OllamaRuntime

type SparkServingBindListen {
  host: std.types.NonEmptyStr
  port: std.types.Port
}

fn spark_serving_runtime_kind_wire(runtime: SparkServingRuntimeKind) -> String {
  match runtime {
    OllamaRuntime => "ollama"
  }
}

fn spark_serving_endpoint_intent_wire(intent: gunbc.spark_serving_realization.ServingEndpointIntent) -> String {
  match intent {
    UnauthenticatedEndpoint => "lan-unauthenticated"
    AuthenticatedEndpoint => "authenticated"
  }
}

fn spark_serving_bind_listen_wire(bind: SparkServingBindListen) -> String {
  join([bind.host as String, ":", to_string(bind.port)], "")
}

fn spark_serving_configuration_seed(
  runtime: SparkServingRuntimeKind,
  model_ref: extdeps.ollama.api.OllamaModelRef,
  bind: SparkServingBindListen,
  endpoint: gunbc.spark_serving_realization.ServingEndpointIntent,
) -> std.types.NonEmptyStr {
  join([
    "spark-serving|runtime=", spark_serving_runtime_kind_wire(runtime: runtime),
    "|model=", ollama_model_ref_wire(ref: model_ref),
    "|bind=", spark_serving_bind_listen_wire(bind: bind),
    "|endpoint=", spark_serving_endpoint_intent_wire(intent: endpoint),
  ], "") as std.types.NonEmptyStr
}

fn spark_serving_configuration_identity(
  runtime: SparkServingRuntimeKind,
  model_ref: extdeps.ollama.api.OllamaModelRef,
  bind: SparkServingBindListen,
  endpoint: gunbc.spark_serving_realization.ServingEndpointIntent,
) -> ServingConfigurationIdentity {
  ServingConfigurationIdentity {
    configuration_digest: content_hash_atom(
      value: spark_serving_configuration_seed(
        runtime: runtime,
        model_ref: model_ref,
        bind: bind,
        endpoint: endpoint,
      ),
    ).digest as std.types.NonEmptyStr,
  }
}

// Unified memory is SHARED between CPU and GPU on GB10, which is why the accelerator reports no
// separate device total. Admission is against the shared pool; budgeting as though a private
// device pool existed is how a model that cannot fit gets admitted.
// Both magnitudes were Int, so a NEGATIVE context length and a NEGATIVE memory budget were
// representable -- states with no meaning that a validator would have to reject after the fact.
// max_model_len is a cardinal token count (Nat) and the budget is a ByteSize on the std.measure
// authority, so neither can be written. Memory is not a bare number: it carries its quantity, and
// reusing the measure carrier is what lets this budget be compared against the host RAM figures
// the fleet already models rather than against a same-shaped Int that happens to mean bytes.
type InferenceCapacityPolicy { max_model_len: std.nat.Nat  shared_memory_budget_bytes: std.measure.ByteSize }

type SparkServingRelease {
  runtime: RuntimeArtifactIdentity
  model: gunbc.model_artifact.ModelArtifact
}

type SparkServingServingPolicy {
  serving_configuration: ServingConfigurationIdentity
  capacity: InferenceCapacityPolicy
}

// The identity is DERIVED from the release, never authored. It previously carried a NonEmptyStr
// that callers typed by hand -- so the same digest could name different releases, different
// digests the same release, and an identity could exist with no release at all. That was a string
// labelled "digest" while the module called it content-addressed, and it hollowed out the exact-
// replication property the carrier exists to provide: "both hosts run the same thing" rested on an
// author typing the same string twice.
//
// Fnv1a64Structural rather than the ContentHash union, per the family-grounding rule the same way
// GateRosterHash and v2.std.node.Hash carry it: a union-typed carrier re-opens the cross-family
// comparison that grounding closed.
type SparkServingReleaseIdentity { digest: std.content_hash.Fnv1a64Structural }

// The seed is the injective rendering the identity is taken over. Every field appears, each behind
// its own name, so two releases differing in any single input produce different seed text and
// therefore a different digest -- which is what makes the identity a function of the release
// rather than a label beside it.
fn spark_serving_release_seed(spec: SparkServingRelease) -> std.types.NonEmptyStr {
  join([
    "spark-serving-release|runtime=", spec.runtime.closure_digest as String,
    "|model=", serialize_content_hash(hash: spec.model.identity) as String,
    "|serving_label=", spec.model.serving_label as String,
  ], "") as std.types.NonEmptyStr
}

fn spark_serving_release_identity(spec: SparkServingRelease) -> SparkServingReleaseIdentity {
  SparkServingReleaseIdentity { digest: content_hash_atom(value: spark_serving_release_seed(spec: spec)) }
}

// The occurrence binds ONE release identity to a host. srv5 and srv6 share release R and differ
// only in host and receipt — that shared identity is the entire point of the release carrier, and
// it is why the access and identity prerequisites below are NOT fields of the release: fusing a
// credential or a host-key binding into it would change the release identity whenever a
// credential rotated, so the two hosts could no longer share one.
// THE ENDPOINT CREDENTIAL IS GONE, by operator ruling (2026-08-14). The field was REQUIRED on every
// occurrence while the operator's endpoint intent is UnauthenticatedEndpoint -- so the model demanded
// a credential for a surface with no authentication, and no code ever read it: the only values that
// ever filled it were witness fixtures. A required field with no consumer is not a placeholder for
// future authentication, it is a fact the model asserts and never checks, and it would have been
// filled with a plausible-looking SecretVersionRef at the first real declaration.
//
// The operator's ruling was conditional and the condition was measured rather than assumed: keep it
// if authentication is already wired, remove it if it needs more wiring. Nothing consumes it, so it
// needs wiring, so it goes. Authenticating the endpoint later is a real change -- an intent arm, a
// credential resolution path, and a consumer that presents it -- and it should land as that change
// rather than being pre-declared by an unread field.
//
// Serving policy (configuration digest and capacity) lives on the OCCURRENCE beside release identity.
// It is desired state compared separately from the loaded runtime+model fingerprint — configuration
// and capacity are not imported into observations.
type SparkServingOccurrence {
  host: product.placement_supply.HostIdentity
  release_identity: SparkServingReleaseIdentity
  serving_policy: SparkServingServingPolicy
}

// Prerequisites are ADMITTED DEPENDENCIES, not booleans and not release fields. Each names what
// is missing rather than answering false, because "no managed principal exists" and "the host key
// has no independent anchor" have different remedies and a shared `false` erases that.
type SparkServingPrerequisite
  = HostIdentityBindingAdmitted { host: product.placement_supply.HostIdentity }
  | ManagedHostAccessGrounded { host: product.placement_supply.HostIdentity }
  | PrerequisiteAbsent { host: product.placement_supply.HostIdentity, requirement: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }

type SparkServingRefusal { subject: std.types.NonEmptyStr  cause: std.types.NonEmptyStr }

// THE NO-OP IS STRUCTURAL. SparkServingAlreadyConverged CARRIES NO EFFECT PLAN, so a converged
// host has no constructor by which to write, restart, reinstall, or rotate anything. That is
// stronger than building a plan and discovering its list is empty, which concedes the write is
// representable and relies on an emptiness check a later edit can regress.
//
// This is the same cure the bmc_*_reconciled_policy no-op write needs: both of its arms return the
// policy, so an already-converged policy is rewritten on every converge — an unnecessary IAM write
// carrying a read-modify-write window that can clobber a concurrent change. A write that is not
// needed is not made safe by its content matching what was last read.
// The OBSERVATION is independent of the desired state, and its refusal arm is distinct from an
// observation reporting a difference: "we could not see what is loaded" and "what is loaded is
// wrong" have different remedies, and collapsing them lets an unobservable host read as drifted.
// The loaded identity is the SAME derived carrier as the desired one, so a comparison cannot be
// satisfied by a caller-authored label.
//
// THE THIRD ARM EXISTS BECAUSE FIRST INSTALL WAS UNREACHABLE WITHOUT IT. With only Observed and
// ObservationRefused, a host running nothing at all could be reported only as a refusal -- and this
// module's own comment above says refusal means "we could not see", not "we saw nothing". So a
// never-installed Spark and an unreachable Spark produced the same reconciliation, and the arm that
// proposes an install had no observation that could reach it: you cannot propose adding what you
// have no way to say is absent. That is the same state-space conflation the paragraph above refuses
// between refusal and drift, one position over -- and it was load-bearing rather than cosmetic,
// because it is precisely the state both Sparks are in today.
type SparkServingObservation
  = SparkServingObserved { host: product.placement_supply.HostIdentity, loaded_release: SparkServingRelease }
  | SparkServingAbsent { host: product.placement_supply.HostIdentity }
  | SparkServingObservationRefused { host: product.placement_supply.HostIdentity, cause: std.types.NonEmptyStr }

type SparkServingReconciliation
  = SparkServingAlreadyConverged { converged_release: SparkServingReleaseIdentity }
  | SparkServingInstallRequired { subject: product.placement_supply.HostIdentity, desired_release: SparkServingReleaseIdentity }
  | SparkServingDeltaRequired { plan_subject: std.types.NonEmptyStr }
  | SparkServingRefused { first: SparkServingRefusal, more: List<SparkServingRefusal> }

data no_absent_prerequisite: SparkServingRefusal? = none

data no_further_refusals: List<SparkServingRefusal> = []

// EVERY PREREQUISITE AND OBSERVATION IS BOUND TO ITS SUBJECT HOST. This function existed because
// the first draft discarded the host from all five carrier positions (`host: _`), which made the
// reconciliation answer a question about one host using another host's facts: srv6's observation
// satisfied srv5's desired occurrence whenever the release digests agreed, and an absent
// prerequisite on srv6 refused srv5. That is the copied-receipt class fleet_posix_accounts already
// names -- a receipt produced for one host consumed as another's answer with nothing to detect the
// swap -- and it is the failure the two-replica design is most exposed to, because srv5 and srv6
// are deliberately configured to share one release identity. The digest being right is exactly
// what makes the subject being wrong invisible.
fn host_matches(a: product.placement_supply.HostIdentity, b: product.placement_supply.HostIdentity) -> Bool {
  (a as String) == (b as String)
}

// A prerequisite that is ABSENT carries its own requirement and cause, so the refusal names what
// is missing instead of a bare false that erases which of several remedies applies. Only
// prerequisites recorded FOR THE SUBJECT are consulted: another host's absent prerequisite is not
// evidence about this one, in either direction.
fn first_absent_prerequisite(subject: product.placement_supply.HostIdentity, prerequisites: List<SparkServingPrerequisite>) -> SparkServingRefusal? {
  v2.std.algebra.fold_list(xs: prerequisites, empty: no_absent_prerequisite, cons: fn(acc, p) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent => match p {
        PrerequisiteAbsent { host: h, requirement: req, cause: why } => if host_matches(a: h, b: subject) { Present { value: SparkServingRefusal { subject: req, cause: why } } } else { none }
        HostIdentityBindingAdmitted { host: _ } => none
        ManagedHostAccessGrounded { host: _ } => none
      }
    }
  })
}

// PRESENCE IS REQUIRED, NOT MERELY NON-ABSENCE. Checking only for an explicit PrerequisiteAbsent
// row let an EMPTY prerequisite list read as satisfied -- silence answering as consent, which is
// the empty-observation narrow (DESIGN section 5): "nobody recorded a prerequisite for srv5" and
// "srv5's prerequisites hold" are different states and the first must not actuate.
fn admits_identity_binding(subject: product.placement_supply.HostIdentity, prerequisites: List<SparkServingPrerequisite>) -> Bool {
  v2.std.algebra.fold_list(xs: prerequisites, empty: false, cons: fn(acc, p) {
    match p {
      HostIdentityBindingAdmitted { host: h } => acc || host_matches(a: h, b: subject)
      ManagedHostAccessGrounded { host: _ } => acc
      PrerequisiteAbsent { host: _, requirement: _, cause: _ } => acc
    }
  })
}

fn admits_managed_access(subject: product.placement_supply.HostIdentity, prerequisites: List<SparkServingPrerequisite>) -> Bool {
  v2.std.algebra.fold_list(xs: prerequisites, empty: false, cons: fn(acc, p) {
    match p {
      ManagedHostAccessGrounded { host: h } => acc || host_matches(a: h, b: subject)
      HostIdentityBindingAdmitted { host: _ } => acc
      PrerequisiteAbsent { host: _, requirement: _, cause: _ } => acc
    }
  })
}

data missing_identity_binding_refusal: SparkServingRefusal = SparkServingRefusal { subject: "host identity binding", cause: "no admitted host-identity binding is recorded for this subject; an unanchored host cannot be the subject of a serving claim" }

data missing_managed_access_refusal: SparkServingRefusal = SparkServingRefusal { subject: "managed host access", cause: "no grounded managed access is recorded for this subject; convergence cannot be owned through a human bootstrap account" }

data observation_subject_mismatch_refusal: SparkServingRefusal = SparkServingRefusal { subject: "observation subject", cause: "the observation was taken on a different host than the desired occurrence names; a matching release digest across replicas makes a swapped subject invisible, so it refuses rather than comparing" }

// THE MECHANISM. Desired x observation x prerequisites -> exactly one arm. This is what makes the
// structural no-op real rather than a shape: SparkServingAlreadyConverged is reachable ONLY when
// an independent observation reports the derived identity the desired state asks for, and it
// carries that observed identity rather than a free-text receipt a caller could author.
//
// Order matters and is deliberate. Prerequisites are checked FIRST, so a host without a managed
// principal or an admitted identity binding refuses rather than being compared -- comparing state
// on a host we have no grounded way to reach would answer a question we cannot ask. An observation
// refusal is next, and is NOT drift: it is the absence of an answer.
fn reconcile_spark_serving(
  desired: SparkServingOccurrence,
  observation: SparkServingObservation,
  prerequisites: List<SparkServingPrerequisite>,
) -> SparkServingReconciliation {
  match first_absent_prerequisite(subject: desired.host, prerequisites: prerequisites) {
    Present { value: absent } => SparkServingRefused { first: absent, more: no_further_refusals }
    Absent =>
      if admits_identity_binding(subject: desired.host, prerequisites: prerequisites) == false {
        SparkServingRefused { first: missing_identity_binding_refusal, more: no_further_refusals }
      } else {
        if admits_managed_access(subject: desired.host, prerequisites: prerequisites) == false {
          SparkServingRefused { first: missing_managed_access_refusal, more: no_further_refusals }
        } else {
          match observation {
            SparkServingObservationRefused { host: seen, cause: why } =>
              if host_matches(a: seen, b: desired.host) == false {
                SparkServingRefused { first: observation_subject_mismatch_refusal, more: no_further_refusals }
              } else {
                SparkServingRefused { first: SparkServingRefusal { subject: "observation", cause: why }, more: no_further_refusals }
              }
            SparkServingAbsent { host: seen } =>
              if host_matches(a: seen, b: desired.host) == false {
                SparkServingRefused { first: observation_subject_mismatch_refusal, more: no_further_refusals }
              } else {
                SparkServingInstallRequired { subject: desired.host, desired_release: desired.release_identity }
              }
            SparkServingObserved { host: seen, loaded_release: loaded } =>
              if host_matches(a: seen, b: desired.host) == false {
                SparkServingRefused { first: observation_subject_mismatch_refusal, more: no_further_refusals }
              } else {
                if (spark_serving_release_identity(spec: loaded).digest.digest as String)
                  == (desired.release_identity.digest.digest as String) {
                  SparkServingAlreadyConverged {
                    converged_release: spark_serving_release_identity(spec: loaded),
                  }
                } else {
                  SparkServingDeltaRequired { plan_subject: "loaded release differs from desired release" as std.types.NonEmptyStr }
                }
              }
          }
        }
      }
  }
}

// Only SparkServingDeltaRequired may reach an actuator. Expressed as a total function over the
// coproduct rather than a guard at the call site, so a new arm cannot silently become actuating.
fn spark_serving_may_actuate(reconciliation: SparkServingReconciliation) -> Bool {
  match reconciliation {
    SparkServingDeltaRequired { plan_subject: _ } => true
    SparkServingInstallRequired { subject: _, desired_release: _ } => true
    SparkServingAlreadyConverged { converged_release: _ } => false
    SparkServingRefused { first: _, more: _ } => false
  }
}

// Two occurrences are exact replicas exactly when their release identities agree. Compared at the
// single release digest rather than field-by-field, because a field-wise comparison is a
// conjunction that can be weakened one arm at a time.
fn spark_occurrences_share_release(a: SparkServingOccurrence, b: SparkServingOccurrence) -> Bool {
  (a.release_identity.digest.digest as String) == (b.release_identity.digest.digest as String)
}

// ── The fleet plan: one row per host, joining what must change to what it costs in privilege ────

// WHY THE PLAN IS A CARRIER RATHER THAN A PRINTED STRING. The operator reviews a plan and then
// approves it, so the thing approved and the thing applied must be the SAME VALUE. Rendering first
// and deciding from the rendered text is the prose-decision defect this repo has now removed twice
// from probe exits; it would be worse here, because the decision is an operator's rather than a
// process exit code. So the rows are typed, the render is a projection of them, and an apply
// consumes the rows.
//
// The join is the point. A reconciliation alone says a host needs an install; a shortfall alone says
// what privilege a realization costs. Neither answers the question an operator actually has, which
// is "can this be applied with the credentials that exist". Only the pair answers it.
type SparkServingPlanRow {
  host: product.placement_supply.HostIdentity
  reconciliation: SparkServingReconciliation
  contract: gunbc.spark_serving_realization.ServingRequirementRefusal?
  shortfall: gunbc.spark_serving_realization.EscalationShortfall
}

// Head-plus-tail: a plan over zero hosts has no constructor. "Nothing to do" and "no host was
// considered" are different answers and an empty list would render identically for both -- which is
// precisely the conflation that made first install unreachable one type up.
type SparkServingPlan
  = ServingPlanned { first: SparkServingPlanRow, more: List<SparkServingPlanRow> }
  | ServingPlanNotAttempted { cause: std.types.NonEmptyStr }

// The deployment target for a Spark serving unit under the named automation account. The actor is a
// PARAMETER rather than a constant because the same plan computed for root is the control that
// proves privilege is emergent -- run it as RootPrincipal and every shortfall empties.
fn spark_serving_target(actor: gunbc.spark_serving_realization.SystemPrincipal) -> gunbc.spark_serving_realization.ServingDeploymentTarget {
  gunbc.spark_serving_realization.ServingDeploymentTarget {
    actor: actor,
    unit_name: spark_serving_unit_name as std.types.NonEmptyStr,
    unit_path: join(["/etc/systemd/system/", spark_serving_unit_name], "") as std.types.NonEmptyStr,
    staged_unit_path: join(["/var/lib/gunbc/staged/", spark_serving_unit_name], "") as std.types.NonEmptyStr,
    runtime_package: "ollama" as std.types.NonEmptyStr,
  }
}

// THE REALIZATION IS A PARAMETER AND ITS ADMISSIBILITY IS CHECKED, because the first cut hardcoded
// UserUnitRealization here and that was fail-open planning (review 51835). The realization model
// REFUSES a user unit under an intent requiring a no-login service identity -- structurally, on any
// host, with no observation -- so a plan that assumed it could answer "ready to apply" for a path the
// model says cannot satisfy the intent, while the admitted path needed administrator-backed effects.
// Computing a privilege cost for the wrong realization is not a smaller answer; it is a confident
// answer to a different question.
//
// The contract check is identity_contract_refusal, which takes only the intent and the realization.
// That is deliberate: it is the OBSERVATION-FREE half of admission, so the plan gains intent fidelity
// without depending on SparkHostCapabilityObservation -- the host-grained carrier whose fork is still
// open and which must not acquire a new consumer before it is closed. Full selection, including the
// capability half, lands with that closure and not before.
fn spark_serving_plan_row(
  desired: SparkServingOccurrence,
  observation: SparkServingObservation,
  prerequisites: List<SparkServingPrerequisite>,
  intent: gunbc.spark_serving_realization.SparkServingIntent,
  realization: gunbc.spark_serving_realization.SparkServingRealization,
  actor: gunbc.spark_serving_realization.SystemPrincipal,
  expected_credential: std.content_hash.ContentHash,
  observed_grants: gunbc.spark_serving_realization.ObservedGrantPopulation,
) -> SparkServingPlanRow {
  SparkServingPlanRow {
    host: desired.host,
    reconciliation: reconcile_spark_serving(
      desired: desired, observation: observation, prerequisites: prerequisites),
    contract: identity_contract_refusal(intent: intent, realization: realization),
    shortfall: escalation_shortfall(
      realization: realization,
      subject_host: desired.host,
      expected_credential: expected_credential,
      target: spark_serving_target(actor: actor),
      observed: observed_grants),
  }
}

// A row may be applied only when BOTH halves admit it: the reconciliation says there is a change to
// make, and the privilege it costs is already held. Total over both coproducts, so neither a new
// reconciliation arm nor a new shortfall arm can become applicable by omission.
fn plan_row_applicable(row: SparkServingPlanRow) -> Bool {
  match row.contract {
    Present { value: _ } => false
    Absent =>
      spark_serving_may_actuate(reconciliation: row.reconciliation)
        && applicable_without_administrator(shortfall: row.shortfall)
  }
}

// WHAT AN OPERATOR IS BEING ASKED TO APPROVE, per row. Deliberately NOT a Bool: "nothing to do",
// "ready to apply" and "blocked on a credential" are three different answers, and an approval
// interface that collapses the last two invites approving a plan that cannot run.
type SparkServingPlanVerdict
  = ServingNoChangeRequired
  | ServingReadyToApply
  | ServingRealizationInadmissible { cause: std.types.NonEmptyStr }
  | ServingBlockedOnPrivilege { first_missing: std.types.NonEmptyStr }
  | ServingBlockedOnObservation { cause: std.types.NonEmptyStr }
  | ServingEvidenceMismatch { cause: std.types.NonEmptyStr }

// THE CONTRACT IS CHECKED BEFORE ANYTHING ELSE. An inadmissible realization makes every downstream
// answer moot: there is no point reporting that its privilege cost is already covered.
fn plan_row_verdict(row: SparkServingPlanRow) -> SparkServingPlanVerdict {
  match row.contract {
    Present { value: refusal } => ServingRealizationInadmissible { cause: refusal.cause }
    Absent => plan_row_verdict_admitted(row: row)
  }
}

fn plan_row_verdict_admitted(row: SparkServingPlanRow) -> SparkServingPlanVerdict {
  match row.reconciliation {
    SparkServingAlreadyConverged { converged_release: _ } => ServingNoChangeRequired
    SparkServingRefused { first: f, more: _ } => ServingBlockedOnObservation { cause: f.cause }
    SparkServingInstallRequired { subject: _, desired_release: _ } => privilege_verdict(shortfall: row.shortfall)
    SparkServingDeltaRequired { plan_subject: _ } => privilege_verdict(shortfall: row.shortfall)
  }
}

fn privilege_verdict(shortfall: gunbc.spark_serving_realization.EscalationShortfall) -> SparkServingPlanVerdict {
  match shortfall {
    NoNewPrivilegeRequired => ServingReadyToApply
    NewPrivilegeRequired { first: f, more: _ } => ServingBlockedOnPrivilege { first_missing: f }
    ShortfallUndecidable { cause: c } => ServingBlockedOnObservation { cause: c }
    ShortfallEvidenceMismatch { cause: c } => ServingEvidenceMismatch { cause: c }
  }
}

fn plan_verdict_label(verdict: SparkServingPlanVerdict) -> String {
  match verdict {
    ServingNoChangeRequired => "no-change"
    ServingReadyToApply => "ready-to-apply"
    ServingBlockedOnPrivilege { first_missing: m } => join(["blocked-on-privilege missing=", m as String], "")
    ServingBlockedOnObservation { cause: c } => join(["blocked-on-observation cause=", c as String], "")
    ServingRealizationInadmissible { cause: c } => join(["realization-inadmissible cause=", c as String], "")
    ServingEvidenceMismatch { cause: c } => join(["evidence-mismatch cause=", c as String], "")
  }
}

fn spark_serving_plan_text(plan: SparkServingPlan) -> String {
  match plan {
    ServingPlanNotAttempted { cause: c } => join(["spark serving plan not attempted: ", c as String, "\n"], "")
    ServingPlanned { first: f, more: m } =>
      join(map(concat([f], m), row =>
        join(["plan host=", row.host as String, " ", plan_verdict_label(verdict: plan_row_verdict(row: row)), "\n"], "")), "")
  }
}
