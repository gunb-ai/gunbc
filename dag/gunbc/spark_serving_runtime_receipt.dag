module gunbc.spark_serving_runtime_receipt

import std.types { String, List, NonEmptyStr, FilePath, Bool }
import std.algebra { trim }
import product.placement_supply { HostIdentity }
import extdeps.ssh.session { SshSessionExecResult }
import extdeps.languages.json.parse {
  json_object_unique_member,
  parse_json,
}
import extdeps.languages.json.emit {
  JsonString,
  JsonObject,
  JsonKeyValue,
  serialize_json,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import gunbc.spark_serving_readback_parse {
  SparkServingReadbackField,
  SparkServingReadbackPresent,
  SparkServingReadbackRefused,
  spark_serving_readback_field_from_member_lookup,
}

data spark_serving_runtime_install_receipt_provenance_note: String = "RELEASE-ARCHIVE ADMISSION PROVENANCE — not running-process attestation and not proof of completed runtime install. Records which cited release-asset row gunbc.package_delivery.materialize_spark_serving_ollama_runtime_bundle admitted (DownloadToFile + SHA-256 verify) on this host. Extraction, executable placement, systemd enable, and model pull are separate #8225 follow-on; this receipt must not be read as claiming they happened. Out-of-band binary replacement leaves the receipt stale while /api/version may still answer — wet observation joins receipt digest with the independently probed version wire via ollama_runtime_closure_digest_for_observed_release."

data spark_serving_runtime_receipt_note: String = "Release-archive admission receipt authority for Ollama runtime closure identity on Spark hosts (carrier name SparkServingRuntimeInstallReceipt is legacy — the write path records archive digest admission only). gunbc.package_delivery.materialize_spark_serving_ollama_runtime_bundle writes via write_spark_serving_runtime_install_receipt after digest admission; wet observation reads spark_serving_runtime_receipt_wire_path via spark_serving_runtime_receipt_probe_words and still requires independent /api/version agreement — never re-derives the cited release-asset digest from desired state alone. Missing or unreadable receipt on an active unit refuses rather than collapsing to SparkServingReadbackAbsent."

type SparkServingRuntimeInstallReceipt {
  host: HostIdentity
  release_asset_digest_hex: NonEmptyStr
}

data spark_serving_executor_home: FilePath = "/home/gunbc-automation" as FilePath

data spark_serving_runtime_receipt_rel: String = ".local/share/gunbc/spark-serving/ollama-runtime-receipt.json"

data spark_serving_runtime_receipt_release_asset_digest_member: String = "release_asset_digest_hex"

fn spark_serving_runtime_receipt_wire_path(host: HostIdentity) -> FilePath {
  spark_serving_runtime_receipt_path(host: host)
}

fn spark_serving_runtime_receipt_path(host: HostIdentity) -> FilePath {
  concat(
    spark_serving_executor_home as String,
    concat("/", spark_serving_runtime_receipt_rel),
  ) as FilePath
}

fn spark_serving_runtime_receipt_probe_words(host: HostIdentity) -> List<String> {
  ["cat", spark_serving_runtime_receipt_wire_path(host: host) as String]
}

fn spark_serving_parse_runtime_receipt_json(stdout: String) -> SparkServingReadbackField {
  match parse_json(s: stdout) {
    Absent =>
      SparkServingReadbackRefused {
        cause: "ollama runtime install receipt is not parseable JSON" as NonEmptyStr,
      }
    Present { value: doc } =>
      spark_serving_readback_field_from_member_lookup(
        lookup: json_object_unique_member(
          v: doc,
          key: spark_serving_runtime_receipt_release_asset_digest_member,
        ),
        member: spark_serving_runtime_receipt_release_asset_digest_member,
      )
  }
}

fn spark_serving_runtime_receipt_field_from_probe(
  probe: SshSessionExecResult?,
) -> SparkServingReadbackField {
  match probe {
    Absent =>
      SparkServingReadbackRefused {
        cause: "runtime install receipt probe leg did not run" as NonEmptyStr,
      }
    Present { value: r } =>
      if r.success {
        spark_serving_parse_runtime_receipt_json(stdout: r.stdout)
      } else {
        SparkServingReadbackRefused {
          cause: join([
            "runtime install receipt probe failed exit=", to_string(r.exit_code),
            " stderr=", r.stderr,
          ], "") as NonEmptyStr,
        }
      }
  }
}

fn spark_serving_runtime_receipt_parent_path() -> FilePath {
  concat(
    spark_serving_executor_home as String,
    "/.local/share/gunbc/spark-serving",
  ) as FilePath
}

fn ensure_spark_serving_runtime_receipt_parent_dir() -> Bool {
  shell.Mkdir.Parents(path: spark_serving_runtime_receipt_parent_path()).success
}

fn spark_serving_runtime_install_receipt_json(
  receipt: SparkServingRuntimeInstallReceipt,
) -> String {
  serialize_json(v: JsonObject {
    members: [
      JsonKeyValue {
        key: spark_serving_runtime_receipt_release_asset_digest_member,
        value: JsonString { value: receipt.release_asset_digest_hex as String },
      },
    ],
  })
}

fn write_spark_serving_runtime_install_receipt_at_path(
  path: FilePath,
  receipt: SparkServingRuntimeInstallReceipt,
) -> Bool {
  Filesystem.Write(
    path: path as String,
    content: spark_serving_runtime_install_receipt_json(receipt: receipt),
  ).success
}

fn write_spark_serving_runtime_install_receipt(
  receipt: SparkServingRuntimeInstallReceipt,
) -> Bool {
  if ensure_spark_serving_runtime_receipt_parent_dir() == false {
    false
  } else {
    write_spark_serving_runtime_install_receipt_at_path(
      path: spark_serving_runtime_receipt_wire_path(host: receipt.host),
      receipt: receipt,
    )
  }
}

fn read_spark_serving_runtime_install_receipt_bytes_at_path(path: FilePath) -> String? {
  let read = Filesystem.Read(path: path as String)
  if read.success == false {
    none
  } else {
    let trimmed = (read.content as String).trim()
    if trimmed == "" {
      none
    } else {
      Present { value: trimmed }
    }
  }
}

fn read_spark_serving_runtime_install_receipt_bytes(host: HostIdentity) -> String? {
  read_spark_serving_runtime_install_receipt_bytes_at_path(
    path: spark_serving_runtime_receipt_wire_path(host: host),
  )
}
