module gunbc.parse_verdict_publish

import std.types { Bool, String, List, NonEmptyStr }
import std.optional { Present }
import std.dissolution { DissolutionCondition, unbound_dissolution, dissolution_description }
import extdeps.languages.yaml.types { YamlKeyValue, yaml_string, kv }
import extdeps.github.actions { Step, RunStep, UsesStep, github_event_name_push }
import gunbc.action_use_admission { cache_save_action }
import gunbc.ci.ci_failure_class { wrap_command_with_floor_attempt_receipt, wrap_command_is_renderable }
import v2.cli.population_verb_names { cli_verb_parse_population }
import gunbc.instrument_targets { v2_native_cli_source_roots }
import gunbc.emitted_subject_build_gate { native_step_memory_inputs }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_job_cgroup_ownership }
import gunbc.host.memory_envelope {
  EnvelopeSlotRequired,
  EnvelopeNotRequested,
  EnvelopeRequirementUnreadable,
  memory_envelope_required_ci_contract,
}
import std.algebra { list_map }
import gunbc.parse_verdict_schema {
  parse_verdict_request_family,
}

// POLICY (not the GitHub cache interface): this repository publishes materialization receipts
// only from a push of refs/heads/main. A pull-request run may restore a default-branch entry
// (extdeps.cache.github_actions gha_cache_entry_restorable_by) and must never save one.
data materialization_publish_ref: String = "refs/heads/main"

fn materialization_publish_if() -> String {
  join(["github.event_name == '", github_event_name_push, "' && github.ref == '", materialization_publish_ref, "'"], "")
}

// ONE PROVIDER, GENERIC OVER REQUEST FAMILIES. The GHA cache key prefix names the family so a
// later test-verdict family (operator E6) is another prefix, not another save mechanism.

fn materialization_gha_cache_key_prefix(family: String) -> String {
  join(["gunbc-materialization-", family, "-"], "")
}

// THE GHA OBJECT KEY, EXACTLY (not a receipt key). One blob per (family, compiler identity, sha):
//   gunbc-materialization-<family>-<compiler_identity>-<github.sha>
// compiler_identity is the parse-compiler digest (sidecar .parse_compiler_identity beside
// keep_generation_one_executable): import_closure_live of tokenize+parse+schema, emitted
// Rust of those modules, src/v1/stage0_runtime, rustc identity. Restore is prefix
//   gunbc-materialization-<family>-<compiler_identity>-
// so a parser-identity change cannot hit a prior compiler's blob.
// THE RECEIPT PREIMAGE inside the blob is ParseVerdictRequest { source_digest, compiler }
// (std.materialization_provider): every stored line is
//   parse-verdict <TAB> <source_digest> <TAB> <compiler_identity> <TAB> Accepted
// A line that names only source_digest is not a receipt and is not saved.

data parse_verdict_publish_step_id: String = "publish_parse_verdicts"
data parse_verdict_identity_step_name: String = "Resolve parse-verdict compiler identity"
data parse_verdict_publish_step_name: String = "Walk parse-population and publish verdict receipts"
fn parse_verdict_save_step_name() -> String {
  join(["Save ", parse_verdict_request_family, " receipts to Actions cache"], "")
}
data parse_verdict_receipt_dir: String = ".gunbc/parse-verdicts"
data generation_one_executable_prefix: String = "v2-native-cli-gen-one-"
data generation_one_closure_identity_suffix: String = ".closure_identity"
data generation_one_parse_compiler_identity_suffix: String = ".parse_compiler_identity"
data parse_verdict_compiler_output: String = "compiler_identity"
data parse_verdict_parser_bin_output: String = "parser_bin"

// The walk's argv (parse-population --compiler + source roots) is modeled; locating the
// generation-one binary and writing GITHUB_OUTPUT is foreign-executor shell, same class as
// rust_clippy_all_targets_shell_emit_dissolution_trigger.
data parse_verdict_publish_shell_emit_dissolution_text: NonEmptyStr = "dissolve-on: parse_verdict_publish_walk_step -- hand-shell run carrier for locating the generation-one executable and writing GITHUB_OUTPUT. DISSOLVES WHEN the orchestration-to-shell bash emission (v2.workflow.ci_workflow_run_emit ci_workflow_run_emit_pipeline) renders this step from modeled bash_build statements rather than a joined command string, at which point this row and the comment it projects delete together."
data parse_verdict_publish_shell_emit_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: parse_verdict_publish_shell_emit_dissolution_text)

fn parse_verdict_identity_command() -> String {
  join(
    [
      "set -o pipefail",
      "n=0",
      "bin=",
      join(["for f in \"$RUNNER_TEMP\"/", generation_one_executable_prefix, "*; do [ -f \"$f\" ] || continue; case \"$f\" in *", generation_one_closure_identity_suffix, "|*", generation_one_parse_compiler_identity_suffix, ") continue ;; esac; n=$((n+1)); bin=$f; done"], ""),
      "if [ \"$n\" -ne 1 ]; then echo \"::error::IdentityUnknown: expected exactly one generation-one executable under RUNNER_TEMP, found $n\"; exit 1; fi",
      join(["cid=\"$bin", generation_one_parse_compiler_identity_suffix, "\""], ""),
      "if [ ! -s \"$cid\" ]; then echo \"::error::IdentityUnknown: missing or empty parse-compiler identity beside the generation-one executable\"; exit 1; fi",
      "compiler=$(cat \"$cid\")",
      join(["echo \"", parse_verdict_compiler_output, "=$compiler\" >> \"$GITHUB_OUTPUT\""], ""),
      join(["echo \"", parse_verdict_parser_bin_output, "=$bin\" >> \"$GITHUB_OUTPUT\""], "")
    ],
    "; "
  )
}

fn parse_verdict_publish_command() -> String {
  join(
    [
      "set -o pipefail",
      join(["bin=\"${{ steps.", parse_verdict_publish_step_id, ".outputs.", parse_verdict_parser_bin_output, " }}\""], ""),
      join(["compiler=\"${{ steps.", parse_verdict_publish_step_id, ".outputs.", parse_verdict_compiler_output, " }}\""], ""),
      "if [ -z \"$bin\" ] || [ ! -x \"$bin\" ] || [ -z \"$compiler\" ]; then echo \"::error::IdentityUnknown: parser identity or generation-one executable missing after the identity step\"; exit 1; fi",
      join(["mkdir -p \"", parse_verdict_receipt_dir, "\""], ""),
      join(["\"$bin\" ", cli_verb_parse_population, " --compiler \"$compiler\"", source_root_argv(), " > \"", parse_verdict_receipt_dir, "/receipts.tsv\""], "")
    ],
    "; "
  )
}

fn source_root_argv() -> String {
  join(
    list_map(xs: v2_native_cli_source_roots(), f: fn(root) { join([" --source-root ", root], "") }),
    ""
  )
}

fn parse_verdict_wrapped_script(command: String) -> String {
  concat(
    concat("# ", concat(dissolution_description(condition: parse_verdict_publish_shell_emit_dissolution_trigger), "\n")),
    concat(wrap_command_with_floor_attempt_receipt(command: command), "\n")
  )
}

fn parse_verdict_publish_script_is_renderable() -> Bool {
  wrap_command_is_renderable(command: parse_verdict_identity_command())
    && wrap_command_is_renderable(command: parse_verdict_publish_command())
}

fn parse_verdict_publish_memory_env() -> List<YamlKeyValue> {
  match memory_envelope_required_ci_contract().requirement {
    EnvelopeSlotRequired =>
      list_map(
        xs: native_step_memory_inputs(ownership: gunbc_runner_slot_job_cgroup_ownership),
        f: fn(env_input) { kv(key: env_input.env_name, value: yaml_string(s: env_input.env_value)) }
      )
    EnvelopeNotRequested => []
    EnvelopeRequirementUnreadable { raw: _ } => []
  }
}

fn parse_verdict_identity_step() -> Step {
  RunStep {
    name: Present { value: parse_verdict_identity_step_name },
    id: Present { value: parse_verdict_publish_step_id },
    run: parse_verdict_wrapped_script(command: parse_verdict_identity_command()),
    shell: none,
    env: Present { value: parse_verdict_publish_memory_env() },
    working_directory: none,
    if_condition: Present { value: materialization_publish_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_publish_walk_step() -> Step {
  RunStep {
    name: Present { value: parse_verdict_publish_step_name },
    id: none,
    run: parse_verdict_wrapped_script(command: parse_verdict_publish_command()),
    shell: none,
    env: Present { value: parse_verdict_publish_memory_env() },
    working_directory: none,
    if_condition: Present { value: materialization_publish_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_publish_cache_key() -> String {
  join(
    [
      materialization_gha_cache_key_prefix(family: parse_verdict_request_family),
      "${{ steps.",
      parse_verdict_publish_step_id,
      ".outputs.",
      parse_verdict_compiler_output,
      " }}-${{ github.sha }}"
    ],
    ""
  )
}

// SAVE-ONLY. actions/cache (combined) restores before save and can overwrite receipts.tsv.
// cache_save_action is the subdirectory action (save/action.yml at the same commit), admitted as
// its own row. This step runs AFTER the walk. Restore-keys belong on the PR-2 consumer
// (gunbc.parse_verdict_schema parse_verdict_pr2_restore_frontier).
fn materialization_family_cache_save_step(family: String, path: String, cache_key: String) -> Step {
  UsesStep {
    name: Present { value: join(["Save ", family, " receipts to Actions cache"], "") },
    id: none,
    uses: cache_save_action,
    with: Present {
      value: [
        kv(key: "path", value: yaml_string(s: path)),
        kv(key: "key", value: yaml_string(s: cache_key))
      ]
    },
    env: none,
    if_condition: Present { value: materialization_publish_if() },
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn parse_verdict_publish_save_step() -> Step {
  materialization_family_cache_save_step(
    family: parse_verdict_request_family,
    path: parse_verdict_receipt_dir,
    cache_key: parse_verdict_publish_cache_key()
  )
}
