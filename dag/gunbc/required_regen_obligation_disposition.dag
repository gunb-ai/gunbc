module gunbc.required_regen_obligation_disposition

import std.types { Int, String, Bool }
import std.decl_ref { DeclarationRef, decl_ref }

// WAVE 4 LACKS A TOTAL DISPOSITION FOR THE REQUIRED-REGEN OBLIGATION: TRANSFER AND RETIREMENT
// ARE FUSED.
//
// `gunbc.plans.cli_run_hollowing_plan` carries one row -- area "Regen oracle & self-host scope",
// authority `v2.workflow.required_regen` / `v1_compiler.required_regen_host` -- dispositioned
// `delete-with-v1` at the Wave 4 real-fixpoint cutover. That single row answers for two different
// futures with different obligations:
//
//   TRANSFER  the operation survives under a successor authority and realization
//   RETIRE    the operation ceases to exist because its subject is gone
//
// Both end in deleting the same two files, which is why one row can cover them and why nothing
// notices that it does. The obligations diverge completely: a transfer owes a successor and an
// equivalence receipt, a retirement owes proof that the subject is empty. `delete-with-v1` states
// the ACTION and leaves the JUSTIFICATION unstated, so the plan may take the action without ever
// establishing which justification held.
//
// THE PLAN MAY STILL CHOOSE RETIREMENT. What it may not do is let "delete-with-v1" stand in for
// PROVING the subject retired. This module is the carrier where that proof would live.
//
// DESIGN owns safety standing and the plan owns sequencing; this lifecycle is the one place they
// meet, so neither is edited against the other. An earlier revision of this work reported the two
// as CONTRADICTORY and asked for arbitration between them. That was wrong and the error is worth
// recording: a next-rung trigger is an obligation WHILE ITS SUBJECT REMAINS LIVE, and a terminal
// migration may remove the subject entirely -- deleting an operation whose subject is gone is
// RETIRING it, not declining to climb. The two authorities are compatible under exactly that
// condition, and nobody had checked whether it holds. That unchecked condition, not a
// contradiction, is the defect.
type ObligationLifecycle
  = Active
  | Transferred {
      successor_authority: DeclarationRef
      successor_realization: String
      equivalence_receipt: String
    }
  | Retired {
      mirror_population_empty_receipt: String
      required_consumer_population_empty_receipt: String
    }

// THE ASYMMETRY IS THE ENTIRE CONTENT OF THIS CARRIER, and a symmetric pair of predicates would
// have been the fused row again in typed clothing.
//
// The HOST is one realization of the operation. Under a transfer its work moves to the successor
// realization, so deleting it is admissible. Under a retirement the operation is gone, so
// deleting it is admissible. Both arms admit.
//
// The CARRIER is the operation's DEFINITION. A transfer needs something to define what the
// successor must be equivalent TO, so deleting the definition while the operation still exists
// destroys the referent of its own equivalence receipt. Only retirement admits it.
fn host_deletion_admitted(lifecycle: ObligationLifecycle) -> Bool {
  match lifecycle {
    Active => false
    Transferred { successor_authority: _, successor_realization: _, equivalence_receipt: _ } => true
    Retired { mirror_population_empty_receipt: _, required_consumer_population_empty_receipt: _ } => true
  }
}

fn carrier_deletion_admitted(lifecycle: ObligationLifecycle) -> Bool {
  match lifecycle {
    Active => false
    Transferred { successor_authority: _, successor_realization: _, equivalence_receipt: _ } => false
    Retired { mirror_population_empty_receipt: _, required_consumer_population_empty_receipt: _ } => true
  }
}

// WHAT THE MEASUREMENTS ACTUALLY LICENSE, NARROWED FROM WHAT AN EARLIER REVISION CLAIMED.
//
// Three routes were attempted and one was refuted. The refuted one is real and its receipts hold.
// What does NOT follow is that no derivation can exist: "the host derived from the carrier" does
// not require the host to import a Rust type generated into the same v1 stage0 closure. That is
// ONE construction. The others below are reachable and UNEXAMINED, and an earlier revision of this
// work reported the class as unable to climb -- an impossibility claim resting on the exhaustion
// of one route, which is the same equivalence-across-a-gap this lane had already caught itself
// making about the closure stubs.
type RouteStatus
  = RouteRefuted { evidence: String }
  | RouteUnexamined { why_it_remains_open: String }

type DerivationRoute {
  route: String
  status: RouteStatus
}

data required_regen_derivation_routes: List<DerivationRoute> = [
  DerivationRoute {
    route: "host imports a Rust type generated into the v1 stage0 closure",
    status: RouteRefuted {
      evidence: "Three preconditions fail, each found only by attempting the step the previous one unblocked. regen_source_roots() is a closed two-variant enum (src/v1, dag), so src/v2 is not a regen root; measured by reading line 2 of every emitted stage0 .rs, ZERO declare a v2.* source module. Relocating the carrier into dag/ does not suffice, because closure membership is by IMPORT FROM A SEED MODULE rather than by residence -- see the control table below. And no seed-side consumer of regen refusals exists, because the adjudication is hand-written Rust; the only honest candidate consumer is the host itself. dag/std/trait_derive_shape.dag states the exclusion is deliberate: stage0 IS the v1 seed, and a seed reaching into src/v2 would depend on the successor it bootstraps toward."
    }
  },
  DerivationRoute {
    route: "generate the host decision fold from the carrier at build time",
    status: RouteUnexamined { why_it_remains_open: "Does not require the carrier to be a closure member at all -- the generation step runs before or beside the seed build rather than inside it, so the src/v2 root exclusion does not reach it. Unattempted." }
  },
  DerivationRoute {
    route: "interpret the carrier and pass a typed receipt across the host boundary",
    status: RouteUnexamined { why_it_remains_open: "The interpreter already executes .dag; the host would consume a receipt rather than a generated type, so no Rust type needs to exist in the seed closure. Unattempted." }
  },
  DerivationRoute {
    route: "move the operation to the promoted v2 workflow product",
    status: RouteUnexamined { why_it_remains_open: "Dissolves the boundary instead of crossing it: if the operation runs in the v2 product there is no v1 host to derive. This is the TRANSFER arm of the lifecycle above." }
  },
  DerivationRoute {
    route: "the operation retires with its subject",
    status: RouteUnexamined { why_it_remains_open: "If Wave 4 eliminates the committed stage0-mirror population and no successor needs the operation, there is nothing left to derive. This is the RETIRED arm, and it is the plan's apparent intent -- but it is unproven, which is this module's subject." }
  }
]

// DERIVED, NEVER STORED, so a stale verdict is unrepresentable rather than merely discouraged.
fn some_derivation_route_remains_unexamined() -> Bool {
  required_regen_derivation_routes |> any(r => match r.status {
    RouteUnexamined { why_it_remains_open: _ } => true
    RouteRefuted { evidence: _ } => false
  })
}

fn refuted_route_count() -> Int {
  length(xs: required_regen_derivation_routes |> filter(r => match r.status {
    RouteRefuted { evidence: _ } => true
    RouteUnexamined { why_it_remains_open: _ } => false
  }))
}

type ClosureMembershipObservation {
  module_path: String
  seed_importers: Int
  emitted: Bool
}

// BOTH ARMS ARE LOAD-BEARING. A positive-only list would establish that imported modules are
// emitted and leave "would an unimported one be emitted anyway?" unanswered -- which is exactly
// the question the second precondition turns on.
data required_regen_closure_membership_controls: List<ClosureMembershipObservation> = [
  ClosureMembershipObservation { module_path: "extdeps.cargo", seed_importers: 2, emitted: true },
  ClosureMembershipObservation { module_path: "gunbc.cli_dispatch_surface", seed_importers: 1, emitted: true },
  ClosureMembershipObservation { module_path: "gunbc.ci_spec", seed_importers: 0, emitted: false },
  ClosureMembershipObservation { module_path: "gunbc.commit_workflow", seed_importers: 0, emitted: false },
  ClosureMembershipObservation { module_path: "gunbc.doc_graph_roots", seed_importers: 0, emitted: false }
]

data required_regen_conformance_note: String = "THE OPERATION IS ENFORCED; WHAT IS UNOBSERVED IS THE RELATION BETWEEN ITS TWO REALIZATIONS. Measured across all of src/v1/stage0/src/*.rs, `required_regen_run` and `required_regen_sync_admission` occur exactly ONCE, and the occurrence is a COMMENT naming the carrier as authority for an ordering. No production Rust calls into the carrier; its only executor is its own witness test.\n\nAN EARLIER REVISION READ THAT AS THE OPERATION BEING UNENFORCED. It is not, and the correction matters because it changes both severity and repair. The hand-written host is an INDEPENDENT REALIZATION and it does enforce required-regen: it refuses drift, it names paths, it stops the line. The honest pair is OperationEnforcedByIndependentRealization together with CarrierRealizationConformanceUnobserved. What is missing is a mechanically enforced RELATION between the two realizations -- not the enforcement.\n\nWHAT THE UNOBSERVED CONFORMANCE COSTS, which is the part that survives the correction. The host has 23 production refusal sites covering roughly 21 distinct states; the carrier names SIX of those states, and three of the carrier's eleven declared variants have no producer anywhere. Site count and state count are reported separately because two states refuse at two sites each, so a site total read as a state total overstates the divergence. Two realizations of one operation drifted to that extent without anything refusing, and a comment cannot fail. That is what an unobserved conformance relation permits; it is not a claim that either realization is wrong.\n\nWHY THE ZERO-PRODUCER COUNT IS SOUND DESPITE BEING A NAME GREP: constructing a .dag coproduct variant requires the literal variant name, and a check for reflective construction (construct_variant / variant_by_name / make_variant) returns nothing in the corpus, so for the .dag side the terminal-constructor vocabulary IS the producer-path vocabulary. An exclusion oracle needs a closed producer-path vocabulary, not merely a closed terminal-constructor one; where that does not hold, a producer may publish the positives it found and may not publish 'no X exists'. The host-side claims here are scoped to what was read directly."

data required_regen_obligation_scope_note: String = "SCOPE. Subject: ONE obligation, on ONE authority pair, and one plan row. This module does not claim the plan is wrong to delete either file, does not claim retirement is the wrong disposition, and does not propose the Wave 4 work. It claims the row does not say WHICH disposition it is taking, and that the two carry different obligations.\n\nIT ALSO MAKES NO POPULATION CLAIM. How many other plan rows fuse transfer with retirement is UNMEASURED -- deliberately, because a specimen count taken while establishing the mechanism would be mistaken for the bound. What licenses generalizing the MECHANISM and not the RATE is that nothing in the corpus can refuse over a plan row's disposition: it has no executable dependents, so the fail-closed census that normally surfaces a load-bearing gap is structurally silent for this class, and the only thing that finds one is somebody attempting the work it governs.\n\nTHIS CARRIER GATES NOTHING. It is a finding, not a repair and not a proposal, and saying so is required rather than modest: a carrier named for a wall while occupying none is the inflation DESIGN section 4b forbids."

data required_regen_obligation_authorities: List<DeclarationRef> = [
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_run"),
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_sync_admission"),
  decl_ref(module_path: "v2.workflow.required_regen", decl_name: "RequiredRegenRefusal"),
  decl_ref(module_path: "gunbc.plans.cli_run_hollowing_plan", decl_name: "cli_run_hollowing_plan_body")
]
