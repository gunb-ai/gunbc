module gunbc.tools.review_codex

import extdeps.cron.schedule_model { CronSchedule, Wildcard, Step, render_cron_schedule }
import gunbc.tools.cron_tag { upsert_tagged_cron_tab }
import extdeps.github.pulls
import std.types { CommitSha }
import extdeps.llm.cli
import extdeps.shell
import std.credentials { CredentialSource, EnvVar }

data default_model: String = "gpt-5.4"
data default_reasoning_effort: String = "xhigh"
data cron_schedule: CronSchedule = CronSchedule {
  minute: Step { start: 0, step: 20 },
  hour: Wildcard,
  day_of_month: Wildcard,
  month: Wildcard,
  day_of_week: Wildcard
}
data cron_tag: String = "review-agent"
data owner: String = "gunb-ai"
data repo: String = "gunbc"

data github_auth: CredentialSource = EnvVar { name: "GITHUB_TOKEN" }
data openai_auth: CredentialSource = EnvVar { name: "OPENAI_API_KEY" }

data review_instructions: String = "You are a reviewer for the gunbc project (a DAG compiler).

FIRST: Read DESIGN.md — it defines the project's objective and principles. All
feedback is grounded in it. Read relevant reference files selectively.

STEP 0 — CLASSIFY this PR:
  (a) Code (.rs, stage0): compiler implementation
  (b) .dag models (dag/): type system, service models, dependency specs
  (c) Design/docs (.md): architecture, design decisions, invariants
  (d) Mixed: apply all relevant axes

STEP 1 — RESOLVE prior comments if fixed by current diff:
RESOLVED|comment_id|one sentence

STEP 2 — REVIEW on axes matching the classification:

FOR CODE: apply the principles from DESIGN.md as active checks:
  1. FAIL-CLOSED (no silent failures)
  2. ILLEGAL STATES UNREPRESENTABLE
  3. FACTS FLOW FORWARD (no silent drops across stage boundaries)
  4. COPROD DISSOLUTION (new enums need 🟢/🟡/🔴 classification)
  5. SINGLE AUTHORITY (no duplicate representations)
  6. API-LEVEL ENFORCEMENT (not convention)
  7. LOOP HEALTH (multi-round PRs only): is this round making forward progress
     or shifting debt? Track scaffold delta, cross-layer pattern recurrence,
     cheating signals, real consumer enablement. End with LOOP|CONVERGING|
     STAGNANT|ACCUMULATING_DEBT|reason.
Also check DESIGN.md. For comment discipline,
new code should speak through clear names, small functions, structured types,
and readable control flow instead of explanatory comments. Accept narrow
comments only for non-obvious boundaries, genuinely complex decisions,
historical/performance context, or load-bearing headers.
FOR .DAG: fidelity to external spec, composition from std/ primitives, layering (L0-L5), M9 grounding, coproduct dissolution.
FOR DESIGN/DOCS: challenge the design against DESIGN.md. What's missing? Where are the load-bearing assumptions? Does it reinvent something in std/?

CONSTRAINTS:
- SCOPE: stay within the PR's scope.
- BLOCKING vs NON-BLOCKING calibration: BLOCKING = fixing later is meaningfully
  harder than fixing now. Substrate issues are almost always BLOCKING.
  Performance issues usually NON-BLOCKING. When in doubt, prefer BLOCKING.
- ROOT-CAUSE: for BLOCKING only, trace upstream.
- Only flag + lines. Don't repeat prior comments.

OUTPUT FORMAT (strict, no markdown):
RESOLVED|comment_id|one sentence
BLOCKING|file_path|line_number|one sentence
ROOT_CAUSE|file_path|upstream gap and fix
NON-BLOCKING|file_path|GOOD|one sentence
NON-BLOCKING|file_path|IMPROVE|one sentence + roadmap lane
ROADMAP|VERIFIED|item|one sentence
ROADMAP|INCOMPLETE|item|one sentence
VERDICT|LGTM|one sentence (0 blocking)
VERDICT|REQUEST_CHANGES|one sentence (blocking exists)

Nothing else. No headers, no preamble.

--- Reference files (read from repo as needed) ---
DESIGN.md — objective, principles, and modeling discipline. Read this FIRST.
dag/std/algebra.dag — Semiring, Lattice, Monoid, FreeMonoid, etc.
dag/std/termination.dag — DescentEvidence, RankingDimension
dag/std/types.dag — kernel types, container types"

fn has_review_at_sha(reviews: List<PullReview>, sha: CommitSha) -> Bool {
  any(reviews, r => r.commit_id == sha && contains(r.body, "INVARIANTS"))
}

fn build_prompt(
  pr_title: String,
  pr_number: Int,
  branch: String,
  base_ref: String,
  prior_comments: String
) -> String {
  let header = review_instructions
  let pr_context = "Start by fetching the diff with: gh pr diff {pr_number} --repo {owner}/{repo}\nThen read whichever reference files are relevant to the changes you see.\nDon't read everything — be selective."
  let pr_meta = "--- PR #{pr_number}: {pr_title} ---\nBranch: {branch} -> {base_ref}"
  let prior = "--- Already flagged (do not repeat these) ---\n{prior_comments}"
  "{header}\n\n{pr_context}\n\n{pr_meta}\n\n{prior}"
}

fn format_review_header(
  backend: String,
  model: String,
  sha: CommitSha,
  body: String
) -> String {
  "<!-- [codex-review] sha:{sha} -->\n`{backend}` · `{model}` · `{sha}`\n\n{body}"
}

func review_pr(
  pr_owner: String = owner,
  pr_repo: String = repo,
  pr_number: Int,
  model: String = default_model,
  reasoning_effort: String = default_reasoning_effort
) -> { reviewed: Bool } {

  pr = github.Pulls.Get(
    auth_token: github_auth,
    owner: pr_owner,
    repo: pr_repo,
    pull_number: pr_number
  )

  existing = github.Pulls.ListReviews(
    auth_token: github_auth,
    owner: pr_owner,
    repo: pr_repo,
    pull_number: pr_number
  )
  already_done = has_review_at_sha(reviews: existing.reviews, sha: pr.pr.head.sha)

  prior_comments_raw = github.Pulls.ListComments(
    auth_token: github_auth,
    owner: pr_owner,
    repo: pr_repo,
    issue_number: pr_number
  )

  prompt = build_prompt(
    pr_title: pr.pr.title,
    pr_number: pr_number,
    branch: pr.pr.head.ref,
    base_ref: pr.pr.base.ref,
    prior_comments: "none"
  )

  llm_result = llm.Codex.Review(
    prompt: prompt,
    cwd: "/Users/briansrls/gunbc",
    model: model,
    reasoning_effort: reasoning_effort
  )

  review_body = format_review_header(
    backend: "codex",
    model: model,
    sha: pr.pr.head.sha,
    body: llm_result.stdout
  )

  posted = github.Pulls.CreateReview(
    auth_token: github_auth,
    owner: pr_owner,
    repo: pr_repo,
    pull_number: pr_number,
    commit_id: pr.pr.head.sha,
    body: review_body,
    comments: "[]"
  )

  return { reviewed: true }
}

func review_cycle(
  cycle_owner: String = owner,
  cycle_repo: String = repo
) -> { reviewed_count: Int } {

  upsert_tagged_cron_tab(
    tag: cron_tag,
    schedule: render_cron_schedule(cron_schedule),
    command: "dag run --source-root dag --function gunbc.tools.review_codex.review_cycle",
    log_path: "/Users/briansrls/.local/share/gunbc-review/logs/cron.log"
  )

  open_prs = github.Pulls.List(
    auth_token: github_auth,
    owner: cycle_owner,
    repo: cycle_repo,
    state: Open
  )

  results = for pr in open_prs.pulls {
    review_pr(
      pr_owner: cycle_owner,
      pr_repo: cycle_repo,
      pr_number: pr.number
    )
  }

  return { reviewed_count: count(results) }
}
