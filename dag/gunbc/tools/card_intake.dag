module gunbc.tools.card_intake

import std.types { FilePath, NonEmptyStr }
import std.credentials { CredentialSource, EnvVar }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.llm.anthropic {
  AnthropicChatMessage,
  UserMessage,
  UserTextBlock,
  AnthropicImageBlock,
  ImageSource,
  Base64Image,
  AnthropicImageMediaType,
  ImageJpeg
}
import extdeps.llm.anthropic_rest
import extdeps.filesystem.filesystem_io
import extdeps.tcgplayer.tcgplayer
import extdeps.tcgplayer.catalog
import extdeps.tcgplayer.pricing
import extdeps.tcgplayer.store
import extdeps.cloud.gcp.secret_ref { SecretRef }
import gunbc.auth.secret_ref_credential { fetch_secret_ref_credential }

data tcgplayer_client_id_source: CredentialSource = EnvVar { name: "TCGPLAYER_CLIENT_ID" }

data tcgplayer_client_secret_source: CredentialSource = EnvVar { name: "TCGPLAYER_CLIENT_SECRET" }

data tcgplayer_store_key_source: CredentialSource = EnvVar { name: "TCGPLAYER_STORE_KEY" }

data default_recognition_model: String = "claude-sonnet-4-6-20250929"

data default_high_value_threshold_usd: Float = 50.0

data tcgplayer_money_measure_grounding_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.tools.card_intake",
    decl_name: "default_high_value_threshold_usd",
    field: WholeDeclaration
  }
}

data recognition_instruction: String = "Identify the single trading card in this photo. Reply with only the exact printed card name, nothing else. If no card is clearly identifiable, reply with only the word UNKNOWN."

data unrecognized_card_sentinel: String = "UNKNOWN"

data structural_coverage_gap_intake_recognition_residual: List<String> = [
  "v0 recognition extracts the card name only; set, collector number, condition, and finish",
  "enrichment (and per-condition sku selection from them) lands when the intake consumer",
  "prices per-condition skus instead of products"
]

type CatalogMatch
  = ExactMatch { product_id: Int }
  | AmbiguousMatch { candidate_count: Int }
  | NoMatch

type RiskReason
  = UnmatchedCard
  | AmbiguousCatalogMatch
  | UnpricedCard
  | HighValue
  | ConditionNotOffered
  | SkuUnavailableForCondition
  | AmbiguousSku

type IntakeDisposition
  = ReadyToList
  | NeedsReview { reasons: List<RiskReason> }

fn classify_catalog_match(total_items: Int, first_product_id: Int) -> CatalogMatch {
  if total_items == 0 { NoMatch }
  else if total_items == 1 { ExactMatch { product_id: first_product_id } }
  else { AmbiguousMatch { candidate_count: total_items } }
}

fn match_risk_reasons(card_match: CatalogMatch) -> List<RiskReason> {
  match card_match {
    NoMatch => [] |> list_push(UnmatchedCard)
    AmbiguousMatch { candidate_count: _ } => [] |> list_push(AmbiguousCatalogMatch)
    ExactMatch { product_id: _ } => []
  }
}

fn price_risk_reasons(
  base: List<RiskReason>,
  market_price: Float?,
  high_value_threshold: Float
) -> List<RiskReason> {
  match market_price {
    Present { value: p } =>
      if p >= high_value_threshold { base |> list_push(HighValue) } else { base }
    Absent => base |> list_push(UnpricedCard)
  }
}

fn assess_intake(
  card_match: CatalogMatch,
  market_price: Float?,
  high_value_threshold: Float
) -> IntakeDisposition {
  let reasons = price_risk_reasons(
    base: match_risk_reasons(card_match: card_match),
    market_price: market_price,
    high_value_threshold: high_value_threshold
  )
  if count(reasons) == 0 { ReadyToList } else { NeedsReview { reasons: reasons } }
}

fn count_true(flags: List<Bool>) -> Int {
  fold(flags, init: 0, f: (acc, b) => if b { acc + 1 } else { acc })
}

data structural_coverage_gap_intake_recognition_residual_resolved_note: List<String> = [
  "per-condition sku selection and sku-level pricing now land via plan_condition_listing;",
  "the remaining recognition-side residual is extracting set / collector number / finish from",
  "the photo so printing_id and language_id need not be supplied by the caller"
]

fn sku_risk_reasons(selection: SkuSelection) -> List<RiskReason> {
  match selection {
    SkuUnavailable => [] |> list_push(SkuUnavailableForCondition)
    SkuAmbiguous { candidate_count: _ } => [] |> list_push(AmbiguousSku)
    SkuMatched { sku_id: _ } => []
  }
}

fn assess_sku_listing(
  selection: SkuSelection,
  market_price: Float?,
  high_value_threshold: Float
) -> IntakeDisposition {
  let reasons = price_risk_reasons(
    base: sku_risk_reasons(selection: selection),
    market_price: market_price,
    high_value_threshold: high_value_threshold
  )
  if count(reasons) == 0 { ReadyToList } else { NeedsReview { reasons: reasons } }
}

type ConditionListingPlan
  = ListingReady { sku_id: Int, market_price: Float? }
  | ListingBlocked { disposition: IntakeDisposition, selection: SkuSelection }

fn plan_from_matched(
  sku_id: Int,
  disposition: IntakeDisposition,
  market_price: Float?
) -> ConditionListingPlan {
  match disposition {
    ReadyToList => ListingReady { sku_id: sku_id, market_price: market_price }
    NeedsReview { reasons: _ } =>
      ListingBlocked { disposition: disposition, selection: SkuMatched { sku_id: sku_id } }
  }
}

fn plan_for_condition_id(
  skus: List<ProductSku>,
  condition_id: Int,
  printing_id: Int,
  language_id: Int,
  market_price: Float?,
  high_value_threshold: Float
) -> ConditionListingPlan {
  let selection = select_sku_for_condition(
    skus: skus,
    condition_id: condition_id,
    printing_id: printing_id,
    language_id: language_id
  )
  let disposition = assess_sku_listing(
    selection: selection,
    market_price: market_price,
    high_value_threshold: high_value_threshold
  )
  match selection {
    SkuMatched { sku_id: sid } =>
      plan_from_matched(sku_id: sid, disposition: disposition, market_price: market_price)
    SkuUnavailable => ListingBlocked { disposition: disposition, selection: selection }
    SkuAmbiguous { candidate_count: _ } =>
      ListingBlocked { disposition: disposition, selection: selection }
  }
}

fn plan_condition_listing(
  conditions: List<CategoryCondition>,
  skus: List<ProductSku>,
  condition: CardCondition,
  printing_id: Int,
  language_id: Int,
  market_price: Float?,
  high_value_threshold: Float
) -> ConditionListingPlan {
  match resolve_condition_id(conditions: conditions, condition: condition) {
    Absent =>
      ListingBlocked {
        disposition: NeedsReview { reasons: [] |> list_push(ConditionNotOffered) },
        selection: SkuUnavailable
      }
    Present { value: cid } =>
      plan_for_condition_id(
        skus: skus,
        condition_id: cid,
        printing_id: printing_id,
        language_id: language_id,
        market_price: market_price,
        high_value_threshold: high_value_threshold
      )
  }
}


func recognize_binder_photo(
  photo_path: FilePath,
  model: String = default_recognition_model
) -> { card_name: String } {

  photo = Filesystem.Read(path: photo_path)

  response = llm.Anthropic.Messages(
    api_key: "",
    model: model,
    messages: [
      UserMessage {
        content: [
          AnthropicImageBlock { source: Base64Image { media_type: ImageJpeg, data: photo.content } },
          UserTextBlock { text: recognition_instruction }
        ]
      }
    ],
    max_tokens: 256,
    temperature: none,
    system: none
  )

  return { card_name: response.content }
}

func intake_binder_photo(
  photo_path: FilePath,
  bearer_token: Secret,
  category_id: Int,
  high_value_threshold: Float = default_high_value_threshold_usd
) -> { card_name: String, disposition: IntakeDisposition, product_id: Int, market_price: Float? } {

  recognized = recognize_binder_photo(photo_path: photo_path)

  search = tcgplayer.Catalog.SearchProducts(
    bearer_token: bearer_token,
    product_name: recognized.card_name,
    category_id: category_id
  )

  prices = tcgplayer.Pricing.GetProductPrices(
    bearer_token: bearer_token,
    product_ids: "{search.first_product_id}"
  )

  card_match = classify_catalog_match(
    total_items: search.total_items,
    first_product_id: search.first_product_id
  )

  disposition = assess_intake(
    card_match: card_match,
    market_price: prices.market_price,
    high_value_threshold: high_value_threshold
  )

  return {
    card_name: recognized.card_name,
    disposition: disposition,
    product_id: search.first_product_id,
    market_price: prices.market_price
  }
}

func intake_binder(
  photo_paths: List<FilePath>,
  client_id: String,
  client_secret: Secret,
  category_id: Int,
  high_value_threshold: Float = default_high_value_threshold_usd
) -> { total: Int, flagged: Int } {

  token = tcgplayer.Auth.MintBearerToken(
    client_id: client_id,
    client_secret: client_secret
  )

  results = for p in photo_paths {
    intake_binder_photo(
      photo_path: p,
      bearer_token: token.access_token,
      category_id: category_id,
      high_value_threshold: high_value_threshold
    )
  }

  flags = for r in results {
    match r.disposition {
      ReadyToList => false
      NeedsReview { reasons: _ } => true
    }
  }

  return { total: count(results), flagged: count_true(flags: flags) }
}

func list_card_sku(
  client_id: String,
  client_secret: Secret,
  store_key: NonEmptyStr,
  sku_id: Int,
  price: Float,
  quantity: Int
) -> { price_updated: Bool, quantity_updated: Bool } {

  token = tcgplayer.Auth.MintBearerToken(
    client_id: client_id,
    client_secret: client_secret
  )

  priced = tcgplayer.Store.UpdateSkuPrice(
    bearer_token: token.access_token,
    store_key: store_key,
    sku_id: sku_id,
    price: price
  )

  stocked = tcgplayer.Store.IncrementSkuQuantity(
    bearer_token: token.access_token,
    store_key: store_key,
    sku_id: sku_id,
    quantity: quantity
  )

  return { price_updated: priced.success, quantity_updated: stocked.success }
}

fn selected_sku_id(
  conditions: List<CategoryCondition>,
  skus: List<ProductSku>,
  condition: CardCondition,
  printing_id: Int,
  language_id: Int
) -> Int? {
  match resolve_condition_id(conditions: conditions, condition: condition) {
    Absent => none
    Present { value: cid } =>
      match select_sku_for_condition(
        skus: skus,
        condition_id: cid,
        printing_id: printing_id,
        language_id: language_id
      ) {
        SkuMatched { sku_id: sid } => Present { value: sid }
        SkuUnavailable => none
        SkuAmbiguous { candidate_count: _ } => none
      }
  }
}

func sku_market_price(
  bearer_token: Secret,
  sku_id: Int
) -> Float? {

  prices = tcgplayer.Pricing.GetSkuPrices(
    bearer_token: bearer_token,
    sku_ids: "{sku_id}"
  )

  prices.market_price
}

func list_sku_ready(
  bearer_token: Secret,
  store_key: NonEmptyStr,
  sku_id: Int,
  price: Float,
  quantity: Int
) -> Bool {

  priced = tcgplayer.Store.UpdateSkuPrice(
    bearer_token: bearer_token,
    store_key: store_key,
    sku_id: sku_id,
    price: price
  )

  stocked = tcgplayer.Store.IncrementSkuQuantity(
    bearer_token: bearer_token,
    store_key: store_key,
    sku_id: sku_id,
    quantity: quantity
  )

  priced.success && stocked.success
}

func list_card_by_condition(
  bearer_token: Secret,
  store_key: NonEmptyStr,
  category_id: Int,
  product_id: Int,
  condition: CardCondition,
  printing_id: Int,
  language_id: Int,
  price: Float,
  quantity: Int,
  high_value_threshold: Float = default_high_value_threshold_usd
) -> { plan: ConditionListingPlan, listed: Bool } {

  conds = tcgplayer.Catalog.GetCategoryConditions(
    bearer_token: bearer_token,
    category_id: category_id
  )

  skus = tcgplayer.Catalog.GetProductSkus(
    bearer_token: bearer_token,
    product_id: product_id
  )

  market_price = match selected_sku_id(
    conditions: conds.conditions,
    skus: skus.skus,
    condition: condition,
    printing_id: printing_id,
    language_id: language_id
  ) {
    Absent => none
    Present { value: sid } => sku_market_price(bearer_token: bearer_token, sku_id: sid)
  }

  plan = plan_condition_listing(
    conditions: conds.conditions,
    skus: skus.skus,
    condition: condition,
    printing_id: printing_id,
    language_id: language_id,
    market_price: market_price,
    high_value_threshold: high_value_threshold
  )

  listed = match plan {
    ListingReady { sku_id: sid, market_price: _ } =>
      list_sku_ready(
        bearer_token: bearer_token,
        store_key: store_key,
        sku_id: sid,
        price: price,
        quantity: quantity
      )
    ListingBlocked { disposition: _, selection: _ } => false
  }

  return { plan: plan, listed: listed }
}

data tcgplayer_secret_manager_credential_note: List<String> = [
  "the TCGplayer client secret is sourced from GCP Secret Manager via the single",
  "SecretRef authority (fetch_secret_ref_credential: GCloud WIF access token ->",
  "SecretManager.AccessVersion -> utf8 payload); routing the store key the same way",
  "is a residual pending a Secret -> NonEmptyStr grounding for the store_key path field"
]

func mint_token_from_secret_manager(
  client_id: String,
  client_secret_ref: SecretRef
) -> { access_token: Secret } {

  client_secret = fetch_secret_ref_credential(secret_ref: client_secret_ref)

  token = tcgplayer.Auth.MintBearerToken(
    client_id: client_id,
    client_secret: client_secret
  )

  return { access_token: token.access_token }
}
