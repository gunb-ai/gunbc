module gunbc.tools.bmc_read_telemetry

import extdeps.bmc.http
import extdeps.bmc.netrc {
  NetrcResolution, NetrcResolved, NetrcRefused,
  netrc_resolve,
}
import extdeps.transports.rest {
  RestOutcome, RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable,
}

func bmc_read_telemetry() -> ProcessExit
  uses net: std.resources.Network
{
  host = shell.Env.Get(name: "BMC_HOST")
  netrc = shell.Env.Get(name: "BMC_NETRC_FILE")
  match host.value {
    Absent => return exit_failure(reason: "BMC_HOST is not set")
    Present { value: host_v } =>
      if host_v == "" {
        return exit_failure(reason: "BMC_HOST is empty")
      } else {
        match netrc.value {
          Absent => return exit_failure(reason: "BMC_NETRC_FILE is not set (rotated BMC cred)")
          Present { value: netrc_v } =>
            if netrc_v == "" {
              return exit_failure(reason: "BMC_NETRC_FILE is empty")
            } else {
              let bmc = host_v as NonEmptyStr
              let netrc_file = netrc_v as NonEmptyStr
              let chassis = asrock_altrad8ud_redfish_chassis_id

              // ONE netrc resolution for BOTH credential-bearing calls (per the directive:
              // one resolution per workflow, not per call). The credential binding lives
              // for the match arm scope only.
              let cred = netrc_resolve(file: netrc_file as FilePath, host: bmc)
              match cred {
                NetrcResolved { login: l, password: p } => {
                  system_resp = redfish.Http.GetSystem(
                    bmc_host: bmc, username: l, password: p
                  )
                  match system_resp.outcome {
                    RestOk => Unit
                    RestStatusRefused { status: _, body: b } => return exit_failure(reason: b)
                    RestTransportRefused { cause: c } => return exit_failure(reason: c)
                    RestBodyUndecodable { status: _, cause: c } => return exit_failure(reason: c)
                  }

                  sensors_resp = redfish.Http.GetChassisSensors(
                    bmc_host: bmc, chassis_id: chassis, username: l, password: p
                  )
                  match sensors_resp.outcome {
                    RestOk => Unit
                    RestStatusRefused { status: _, body: b } => return exit_failure(reason: b)
                    RestTransportRefused { cause: c } => return exit_failure(reason: c)
                    RestBodyUndecodable { status: _, cause: c } => return exit_failure(reason: c)
                  }

                  return ExitSuccess
                }
                NetrcRefused { cause: c } =>
                  return exit_failure(reason: concat("netrc resolution failed: ", netrc_refusal_reason(cause: c)))
              }
            }
        }
      }
  }
}

fn netrc_refusal_reason(cause: NetrcRefusalCause) -> String {
  match cause {
    NetrcNoMatchingEntry { host: h } => concat("no netrc entry for ", h)
    NetrcDuplicateMachine { host: h } => concat("duplicate netrc entry for ", h)
    NetrcMalformedFile { detail: d } => d
    NetrcFileUnreadable { detail: d } => d
  }
}
