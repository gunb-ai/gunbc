module gunbc.tools.bmc_read_telemetry

import extdeps.transports.rest { RestResult, RestRefusal, RestStatusRefused, RestTransportRefused, RestBodyUndecodable }


fn bmc_read_telemetry() -> ProcessExit
{
  host = shell.Env.Get(name: "BMC_HOST")
  netrc = shell.Env.Get(name: "BMC_NETRC_FILE")
  match host.value {
    Absent => return exit_failure(reason: "BMC_HOST is not set")
    Present { value: host_v } =>
      if host_v == "" {
        return exit_failure(reason: "BMC_HOST is empty")
      } else {
        match netrc.value {
          Absent => return exit_failure(reason: "BMC_NETRC_FILE is not set (rotated BMC cred)")
          Present { value: netrc_v } =>
            if netrc_v == "" {
              return exit_failure(reason: "BMC_NETRC_FILE is empty")
            } else {
              let bmc = host_v as NonEmptyStr
              let netrc_file = netrc_v as NonEmptyStr
              let chassis = asrock_altrad8ud_redfish_chassis_id

              system_result = redfish.Http.GetSystem(bmc_host: bmc, netrc_file: netrc_file)
              return match system_result {
                RestAnswered { answer: system_body } => {
                  sensors_result = redfish.Http.GetChassisSensors(
                    bmc_host: bmc,
                    chassis_id: chassis,
                    netrc_file: netrc_file
                  )
                  return match sensors_result {
                    RestAnswered { answer: sensors_body } => ExitSuccess
                    RestRefused { refusal: refusal } => exit_failure(reason: match refusal { RestStatusRefused { status: _, body: b } => b  RestTransportRefused { cause: c } => c  RestBodyUndecodable { status: _, cause: c } => c })
                  }
                }
                RestRefused { refusal: refusal } => exit_failure(reason: match refusal { RestStatusRefused { status: _, body: b } => b  RestTransportRefused { cause: c } => c  RestBodyUndecodable { status: _, cause: c } => c })
              }
            }
        }
      }
  }
}
