module gunbc.tools.bmc_onboard

import extdeps.bmc.http
import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.entropy
import extdeps.cloud.gcp.secret_manager {
  decode_sm_access_version_payload_wire,
  decode_sm_resolved_version_identity_wire,
  decode_sm_access_version_secret_wire,
  encode_sm_access_version_payload_wire,
  SmAccessVersionPayloadDecoded,
  SmAccessVersionPayloadDecodeRefused,
  SmAccessVersionSecretDecoded,
  SmAccessVersionSecretDecodeRefused,
  SmResolvedVersionIdentityDecoded,
  SmResolvedVersionIdentityDecodeRefused,
}
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.bmc_onboarding {
  BmcOnboardingPlan,
  srv3_onboarding_plan,
  srv4_onboarding_plan,
  BmcCredentialProbeResult,
  FactoryCredentialActive,
  RotatedCredentialActive,
  CredentialAccessUpsertRequired,
  CredentialEnsureRefused,
  CredentialStateUnknown,
}
import gunbc.auth.access_token_source {
  AccessTokenSource,
  AccessTokenEnsureRefused,
  AccessTokenReady,
  AccessTokenUpsertRequired,
  GcloudPrintToken,
  access_token_upsert_required_reason,
  ensure_access_token,
}
import std.types { FilePath, NonEmptyStr, Secret, String }
import std.logic { Bool }
import std.resources { Network }
import std.bytes { utf8_encode_bytes }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.disposition { Disposition, Scaffold, SingleAuthority, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.languages.json.emit {
  serialize_json,
  json_object,
  json_kv,
  json_string,
}

data bmc_onboard_netrc_path: String = "/tmp/bmc_onboard_netrc"
data bmc_onboard_pwbody_path: String = "/tmp/bmc_onboard_pwbody.json"

data bmc_onboard_secret_on_disk_debt: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.filesystem.filesystem_io",
    decl_name: "Filesystem",
    field: WholeDeclaration
  }
}


data bmc_credential_length_chars_unit_debt: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.measure",
    decl_name: "Measure",
    field: WholeDeclaration
  }
}

data bmc_credential_length_chars: Int = 16

fn netrc_content(host: String, account: String, password: String) -> String {
  concat("machine ", concat(host, concat(" login ", concat(account, concat(" password ", concat(password, "\n"))))))
}

fn account_password_body(new_password: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "Password", value: json_string(s: new_password)),
  ]))
}

fn boot_override_body(target: String, enabled: String, mode: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "Boot", value: json_object(members: [
      json_kv(key: "BootSourceOverrideTarget", value: json_string(s: target)),
      json_kv(key: "BootSourceOverrideEnabled", value: json_string(s: enabled)),
      json_kv(key: "BootSourceOverrideMode", value: json_string(s: mode)),
    ])),
  ]))
}

fn reset_body(reset_type: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "ResetType", value: json_string(s: reset_type)),
  ]))
}

fn gcp_secret_full_name(project: String, secret_id: String) -> String {
  concat("projects/", concat(project, concat("/secrets/", secret_id)))
}

fn onboarding_secret_id(plan: BmcOnboardingPlan) -> NonEmptyStr {
  plan.secret_name
}

fn mint_bmc_credential() -> Secret {
  Urandom.ReadPassword(count: bmc_credential_length_chars).password as Secret
}

// THE NETRC FILE IS THE CREDENTIAL'S ONLY CARRIER NOW, so its MODE is load-bearing rather than
// incidental. Every Redfish call in this tool authenticates through this path since the argv-borne
// `-u {username}:{password}` arms were deleted from extdeps.bmc.http, which means a world-readable
// netrc would simply move the exposure from the process table to the filesystem -- on hosts where
// the audience is identical, since the same unprivileged reader that could ps the argv can stat /tmp.
// Filesystem.Write creates with the ambient umask; WriteOwnerOnly creates 0600 at creation via
// O_EXCL rather than writing first and chmod-ing after, so there is no window in which the bytes
// exist at a wider mode.
//
// O_EXCL is why the shred precedes the write instead of following the read: WriteOwnerOnly REFUSES
// an existing path, and this tool legitimately rewrites the netrc within one run -- once for the
// factory login and again after rotation. Removing first makes the rewrite the ordinary case rather
// than a failure, and it also means a netrc left behind by an earlier interrupted run is destroyed
// before this one authenticates, instead of being silently reused.
fn write_netrc(host: String, account: String, password: String) -> Bool {
  let _ = shell.Remove.FileForce(path: bmc_onboard_netrc_path as FilePath)
  Filesystem.WriteOwnerOnly(path: bmc_onboard_netrc_path, content: netrc_content(host: host, account: account, password: password)).success
}

// THE POST-ROTATION REAUTH RE-WRITES THE NETRC, because the credential the BMC now expects is the
// one this func just installed. That write is CHECKED rather than assumed: a silently-failed netrc
// would leave the PREVIOUS credential's file in place, and the reauth would then appear to succeed
// while proving nothing about the rotation it exists to confirm -- a green that means the opposite
// of what it reads as.
func bmc_rotate_credential(plan: BmcOnboardingPlan, new_credential: Secret) -> ProcessExit
  uses net: Network
{
  let host = plan.bmc.host
  let account = plan.factory_login.username

  if write_netrc(host: host, account: account, password: plan.factory_login.published_password) == false {
    return exit_failure(reason: "rotate: netrc write failed")
  }

  let body = Filesystem.Write(
    path: bmc_onboard_pwbody_path,
    content: account_password_body(new_password: new_credential as String)
  )
  if body.success == false {
    return exit_failure(reason: concat("rotate: password body write failed: ", body.error))
  }

  rot = redfish.Http.SetAccountPassword(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr,
    account_id: account,
    request_body_file: bmc_onboard_pwbody_path as NonEmptyStr
  )
  if rot.success == false {
    return exit_failure(reason: rot.body)
  }

  if write_netrc(host: host, account: account, password: new_credential as String) == false {
    return exit_failure(reason: "rotate: netrc write for post-rotation reauth failed")
  }
  verify = redfish.Http.GetSystem(bmc_host: host, netrc_file: bmc_onboard_netrc_path as NonEmptyStr)
  return if verify.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("rotate: reauth with new credential rejected: ", verify.body))
  }
}

func bmc_store_and_rotate(plan: BmcOnboardingPlan, token_source: AccessTokenSource, credential: Secret) -> ProcessExit
  uses net: Network
{
  let payload_b64 = encode_sm_access_version_payload_wire(credential: credential)
  let secret_id = onboarding_secret_id(plan: plan)

  match ensure_access_token(source: token_source) {
    AccessTokenUpsertRequired { plan: upsert_plan } =>
      return exit_failure(
        reason: access_token_upsert_required_reason(plan: upsert_plan),
      )
    AccessTokenEnsureRefused { reason: reason } =>
      return exit_failure(reason: reason as String)
    AccessTokenReady { token: token } => {
      stored = gcp.SecretManager.AddVersion(
        access_token: token,
        secret_name: gcp_secret_full_name(project: fleet_secrets_gcp_project, secret_id: secret_id),
        payload_b64: payload_b64
      )
      readback = gcp.SecretManager.AccessVersion(
        access_token: token,
        project_id: fleet_secrets_gcp_project,
        secret: secret_id,
        version: "latest"
      )
      let expected_payload = utf8_encode_bytes(s: credential as String)
      let readback_ok = match decode_sm_access_version_payload_wire(data_b64: readback.data_b64) {
        SmAccessVersionPayloadDecoded { payload: stored_payload } =>
          stored_payload == expected_payload
        SmAccessVersionPayloadDecodeRefused { cause: _ } => false
      }
      match decode_sm_resolved_version_identity_wire(name: stored.name as String) {
        SmResolvedVersionIdentityDecoded { identity: stored_identity } =>
          match decode_sm_resolved_version_identity_wire(name: readback.name as String) {
            SmResolvedVersionIdentityDecoded { identity: readback_identity } => {
              if !readback_ok || stored_identity != readback_identity {
                return exit_failure(reason: concat(concat(concat("store: GCP durability read-back mismatch — refusing to rotate (would lock out ", plan.bmc.host), concat("); stored version ", stored_identity as String)), ""))
              }
            }
            SmResolvedVersionIdentityDecodeRefused { cause: _ } =>
              return exit_failure(reason: "store: GCP read-back resolved version identity refused by wire decoder")
          }
        SmResolvedVersionIdentityDecodeRefused { cause: _ } =>
          return exit_failure(reason: "store: GCP AddVersion resolved version identity refused by wire decoder")
      }

      return bmc_rotate_credential(plan: plan, new_credential: credential)
    }
  }
}

func bmc_assimilate_credential(plan: BmcOnboardingPlan, token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  let host = plan.bmc.host
  let account = plan.factory_login.username

  root_resp = redfish.Http.GetServiceRoot(bmc_host: host)
  if root_resp.success == false {
    return exit_failure(reason: concat("acquire: service root unreachable: ", root_resp.body))
  }
  if write_netrc(host: host, account: account, password: plan.factory_login.published_password) == false {
    return exit_failure(reason: "acquire: netrc write failed")
  }
  acq = redfish.Http.GetSystem(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr
  )
  if acq.success == false {
    return exit_failure(reason: concat("acquire: factory login failed: ", acq.body))
  }

  return bmc_store_and_rotate(plan: plan, token_source: token_source, credential: mint_bmc_credential())
}

// A NETRC THAT COULD NOT BE WRITTEN IS NOT EVIDENCE ABOUT THE CREDENTIAL, and this probe keeps those
// apart. Each write failure returns CredentialStateUnknown rather than falling through to the next
// arm, because reporting `factory login failed` for a local filesystem fault would send an operator
// to the BMC to investigate a problem that is on this host. The same rule governs the stored-
// credential arm below it.
func bmc_probe_credential_phase(plan: BmcOnboardingPlan, token_source: AccessTokenSource) -> BmcCredentialProbeResult
  uses net: Network
{
  let host = plan.bmc.host
  let account = plan.factory_login.username

  if write_netrc(host: host, account: account, password: plan.factory_login.published_password) == false {
    return CredentialStateUnknown { reason: "netrc write for factory credential probe failed" }
  }
  factory_check = redfish.Http.GetSystem(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr
  )
  if factory_check.success {
    return FactoryCredentialActive
  }

  match ensure_access_token(source: token_source) {
    AccessTokenUpsertRequired { plan: upsert_plan } =>
      return CredentialAccessUpsertRequired { plan: upsert_plan }
    AccessTokenEnsureRefused { reason: reason } =>
      return CredentialEnsureRefused { reason: reason }
    AccessTokenReady { token: token } => {
      secret_resp = gcp.SecretManager.AccessVersion(
        access_token: token,
        project_id: fleet_secrets_gcp_project,
        secret: onboarding_secret_id(plan: plan),
        version: "latest"
      )
      match decode_sm_access_version_secret_wire(data_b64: secret_resp.data_b64) {
        SmAccessVersionSecretDecoded { credential: password } => {
          if write_netrc(host: host, account: account, password: password as String) == false {
            return CredentialStateUnknown { reason: "netrc write for stored credential probe failed" }
          }
          rotated_verify = redfish.Http.GetSystem(
            bmc_host: host,
            netrc_file: bmc_onboard_netrc_path as NonEmptyStr
          )
          return if rotated_verify.success {
            RotatedCredentialActive
          } else {
            CredentialStateUnknown { reason: "stored credential rejected by BMC" }
          }
        }
        SmAccessVersionSecretDecodeRefused { cause: _ } =>
          CredentialStateUnknown { reason: "stored credential payload refused by wire decoder" }
      }
    }
  }
}

func bmc_converge_credential(plan: BmcOnboardingPlan, token_source: AccessTokenSource) -> ProcessExit
  uses net: Network
{
  root_resp = redfish.Http.GetServiceRoot(bmc_host: plan.bmc.host)
  if root_resp.success == false {
    return exit_failure(reason: concat("credential converge: BMC unreachable: ", root_resp.body))
  }

  probe = bmc_probe_credential_phase(plan: plan, token_source: token_source)
  match probe {
    FactoryCredentialActive => return bmc_store_and_rotate(plan: plan, token_source: token_source, credential: mint_bmc_credential())
    RotatedCredentialActive => return ExitSuccess
    CredentialAccessUpsertRequired { plan: upsert_plan } =>
      return exit_failure(
        reason: access_token_upsert_required_reason(plan: upsert_plan),
      )
    CredentialEnsureRefused { reason: reason } =>
      return exit_failure(reason: reason as String)
    CredentialStateUnknown { reason: r } =>
      return exit_failure(reason: concat("credential converge: unknown phase: ", r))
  }
}

func srv3_probe_credential_phase() -> BmcCredentialProbeResult
  uses net: Network
{
  bmc_probe_credential_phase(plan: srv3_onboarding_plan, token_source: GcloudPrintToken)
}

func srv3_converge_credential() -> ProcessExit
  uses net: Network
{
  bmc_converge_credential(plan: srv3_onboarding_plan, token_source: GcloudPrintToken)
}

func srv4_converge_credential() -> ProcessExit
  uses net: Network
{
  bmc_converge_credential(plan: srv4_onboarding_plan, token_source: GcloudPrintToken)
}
