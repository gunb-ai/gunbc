import std.process { ProcessExit, ExitSuccess, exit_failure }

// CONVERGE ONE BMC'S READ-ONLY HEALTH ACCOUNT, using the administrator credential from custody once.
//
// observe (administrator reads the accounts collection, then the reader account if listed)
//   -> plan (gunbc.bmc.bmc_health_reader plan_reader_account)
//   -> converged: prove the custody reader credential authenticates, change nothing
//   -> create: mint, store and read back bmc-<host>-health-reader, POST the account, then verify
//      INDEPENDENTLY that the reader logs in and that the administrator reads its role as ReadOnly.
//
// The credential is stored before the account exists, so a failed POST leaves an orphan version and
// no account; the next run observes the account absent and stores a fresh one. The reverse order
// would leave an account whose password nobody holds.
//
// The health check itself never imports this module: it receives only the reader credential.
//
// The create body holds the reader's password, so it goes to CreateAccount on stdin and never has a
// path. It used to be written owner-only to a per-host /tmp file and removed after the POST.
//
// The administrator's credential is in one private netrc for the whole administrator session (the
// accounts read, the POST, the role read-back), removed when the session returns. The reader's
// login is a separate call with its own netrc, so the two credentials never share a file. Before,
// both used one fixed /tmp path, the reader login overwrote the administrator's file, and nothing
// removed it afterwards.

// A LOGIN THAT NEVER REACHED THE BMC IS NOT A REJECTED PASSWORD. A netrc that could not be placed or
// removed, including one that left credential residue on disk, is a local fault whose remedy is
// cleanup, so it keeps the bracket's located reason instead of reading as "does not authenticate".
type BmcLoginAttempt
  = BmcLoginAccepted
  | BmcLoginRejected { body: String }
  | BmcLoginNotAttempted { reason: String }

fn bmc_login_attempt(host: NonEmptyStr, account: NonEmptyStr, password: Secret) -> BmcLoginAttempt
{
  match bmc_authenticated_call(stage: "reader login", host: host, account: account, password: password, call: BmcGetSystem) {
    BmcCallRefused { reason: r } => BmcLoginNotAttempted { reason: r }
    BmcCallAnswered { reply: probe } =>
      if probe.success { BmcLoginAccepted } else { BmcLoginRejected { body: probe.body } }
  }
}

fn reader_login_exit(attempt: BmcLoginAttempt, rejected_prefix: String) -> ProcessExit {
  match attempt {
    BmcLoginAccepted => ExitSuccess
    BmcLoginRejected { body: b } => exit_failure(reason: concat(rejected_prefix, b))
    BmcLoginNotAttempted { reason: r } => exit_failure(reason: concat("reader: the login was not attempted: ", r))
  }
}

// Reads run under the administrator netrc the caller's bracket placed.
fn observe_reader_account(host: NonEmptyStr, netrc: NonEmptyStr) -> ReaderAccountObservation
{
  accounts = redfish.Http.GetAccounts(bmc_host: host, netrc_file: netrc)
  if accounts.success == false {
    return ReaderAccountUnreadable { cause: concat("the accounts collection could not be read: ", accounts.body) as NonEmptyStr }
  }
  return match reader_listed_in_accounts(body: accounts.body) {
    ReaderListingUnreadable { cause: c } => ReaderAccountUnreadable { cause: c }
    ReaderNotListed => ReaderAccountAbsent
    ReaderListed => {
      account = redfish.Http.GetAccount(bmc_host: host, netrc_file: netrc, account_id: bmc_health_reader_username)
      if account.success {
        reader_account_from_json(body: account.body)
      } else {
        ReaderAccountUnreadable { cause: concat("the listed reader account could not be read: ", account.body) as NonEmptyStr }
      }
    }
  }
}

fn bmc_health_reader_converge(plan: BmcOnboardingPlan) -> ProcessExit
{
  match select_access_token_source() {
    AccessTokenSourceUnavailable { cause: c } => return exit_failure(reason: c as String)
    AccessTokenSourceSelected { source: s } => match ensure_access_token(source: s) {
      AccessTokenUpsertRequired { plan: p } => return exit_failure(reason: access_token_upsert_required_reason(plan: p))
      AccessTokenEnsureRefused { reason: r } => return exit_failure(reason: r as String)
      AccessTokenReady { token: t } =>
        match bmc_custody_credential(secret_id: onboarding_secret_id(plan: plan), token: t) {
          CustodyCredentialAbsent => return exit_failure(reason: concat("reader: the administrator credential is not in custody for ", plan.bmc.host as String))
          CustodyCredentialUnreadable { cause: c } => return exit_failure(reason: concat("reader: the administrator credential could not be read from custody: ", c))
          CustodyCredentialHeld { password: admin_password } =>
            return bmc_health_reader_converge_as_admin(plan: plan, token: t, admin_password: admin_password as Secret)
        }
    }
  }
}

// THE ADMINISTRATOR SESSION RUNS INSIDE ONE BRACKET, and a netrc that could not be removed refuses
// whatever the session concluded. When that happens the session may already have created the reader
// account, so the reason says so instead of reading as if nothing had happened.
fn bmc_health_reader_converge_as_admin(plan: BmcOnboardingPlan, token: Secret, admin_password: Secret) -> ProcessExit
{
  match with_private_netrc_binding(
    machine: plan.bmc.host,
    login: plan.factory_login.username,
    password: admin_password,
    use: fn(binding) { bmc_health_reader_admin_session(plan: plan, token: token, netrc: netrc_binding_path(binding: binding) as NonEmptyStr) },
  ) {
    PrivateSecretFileCompleted { value: exit } => exit
    PrivateSecretFileCompletedResidueRemains { value: _ } =>
      exit_failure(reason: "reader administrator: the session ran (it may have created the reader account) but its per-run netrc could not be removed, so the administrator credential may remain on disk and requires cleanup before retry")
    PrivateSecretFileNotEntered { cause: c } =>
      exit_failure(reason: concat("reader administrator: the per-run netrc could not be placed, so the BMC was not called: ", c as String))
    PrivateSecretFileNotEnteredResidueRemains { cause: c } =>
      exit_failure(reason: concat("reader administrator: the per-run netrc could not be placed AND credential material may remain on disk, requiring cleanup before retry: ", c as String))
  }
}

fn bmc_health_reader_admin_session(plan: BmcOnboardingPlan, token: Secret, netrc: NonEmptyStr) -> ProcessExit
{
  let host = plan.bmc.host
  let reader_secret = bmc_health_reader_secret_id(host: plan.host)
  match plan_reader_account(observation: observe_reader_account(host: host, netrc: netrc)) {
    ReaderAccountRefused { cause: c } => return exit_failure(reason: concat("reader: ", c as String))
    ReaderAccountConverged =>
      match bmc_custody_credential(secret_id: reader_secret, token: token) {
        CustodyCredentialAbsent => return exit_failure(reason: "reader: the account exists but its credential is not in custody; it was not created by this flow or custody was lost")
        CustodyCredentialUnreadable { cause: c } => return exit_failure(reason: concat("reader: the reader credential could not be read from custody: ", c))
        CustodyCredentialHeld { password: held } =>
          return reader_login_exit(
            attempt: bmc_login_attempt(host: host, account: bmc_health_reader_username, password: held as Secret),
            rejected_prefix: "reader: the account exists but the custody credential is refused: ",
          )
      }
    CreateReaderAccount => {
      let credential = mint_bmc_credential()
      match bmc_store_credential_verified(secret_id: reader_secret, token: token, credential: credential, host_label: host as String) {
        BmcCustodyRefused { reason: r } => return exit_failure(reason: r)
        BmcCustodyEstablished => return bmc_health_reader_create(plan: plan, credential: credential, netrc: netrc)
      }
    }
  }
}

// Runs under the administrator netrc the caller's bracket placed, and the role read-back is taken
// under it too: the reader is not entitled to read accounts. The reader login places its own netrc.
fn bmc_health_reader_create(plan: BmcOnboardingPlan, credential: Secret, netrc: NonEmptyStr) -> ProcessExit
{
  let host = plan.bmc.host
  created = redfish.Http.CreateAccount(bmc_host: host, netrc_file: netrc, request_body: reader_account_create_body(password: credential))
  if created.success == false {
    return exit_failure(reason: concat("reader: account POST refused: ", created.body))
  }
  match plan_reader_account(observation: observe_reader_account(host: host, netrc: netrc)) {
    ReaderAccountRefused { cause: c } => return exit_failure(reason: concat("reader: created, but read back as: ", c as String))
    CreateReaderAccount => return exit_failure(reason: "reader: created, but the accounts collection does not list it")
    ReaderAccountConverged =>
      return reader_login_exit(
        attempt: bmc_login_attempt(host: host, account: bmc_health_reader_username, password: credential),
        rejected_prefix: "reader: the created account refuses the stored credential: ",
      )
  }
}

fn srv1_health_reader_converge() -> ProcessExit
{
  bmc_health_reader_converge(plan: srv1_onboarding_plan)
}

fn srv2_health_reader_converge() -> ProcessExit
{
  bmc_health_reader_converge(plan: srv2_onboarding_plan)
}

fn srv3_health_reader_converge() -> ProcessExit
{
  bmc_health_reader_converge(plan: srv3_onboarding_plan)
}

fn srv4_health_reader_converge() -> ProcessExit
{
  bmc_health_reader_converge(plan: srv4_onboarding_plan)
}
