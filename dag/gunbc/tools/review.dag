module gunbc.tools.review


data default_model: String = "claude-sonnet-4-6-20250929"

data review_fetch_stall_deadline_seconds: std.types.Seconds = 300
data cron_schedule: extdeps.cron.schedule_model.CronSchedule = extdeps.cron.schedule_model.CronSchedule {
  minute: extdeps.cron.schedule_model.Step { start: 0, step: 10 },
  hour: Wildcard,
  day_of_month: Wildcard,
  month: Wildcard,
  day_of_week: Wildcard
}
data review_messages: List<extdeps.llm.anthropic.AnthropicChatMessage> = [
  extdeps.llm.anthropic.UserMessage {
    content: [extdeps.llm.anthropic.UserTextBlock { text: "Review the PR described in the system prompt." }]
  }
]

type GitShowAtRef =
    GitShowRead { content: String }
  | GitShowRefused { reason: String }

type ReviewContextRead =
    ReviewContextReady { design: String, algebra_ref: String }
  | ReviewContextRefused { reason: String }

fn has_review_at_sha(reviews: List<extdeps.github.pulls.PullReview>, sha: std.types.CommitSha) -> Bool {
  any(reviews, r => r.commit_id == sha && r.body.contains("Review"))
}

fn git_show_file_at_ref(ref: std.types.GitRef, path: std.types.FilePath) -> GitShowAtRef {
  let result = git.Core.Show(ref: ref, path: path)
  if result.success {
    GitShowRead { content: result.content }
  } else {
    GitShowRefused {
      reason: concat(
        concat("git.Core.Show failed for ", path as String),
        concat(": ", result.stderr)
      )
    }
  }
}

fn review_context_read(ref: std.types.GitRef) -> ReviewContextRead {
  match git_show_file_at_ref(ref: ref, path: "DESIGN.md" as std.types.FilePath) {
    GitShowRefused { reason: why } => ReviewContextRefused { reason: why }
    GitShowRead { content: design } =>
      match git_show_file_at_ref(ref: ref, path: "dag/std/algebra.dag" as std.types.FilePath) {
        GitShowRefused { reason: why } => ReviewContextRefused { reason: why }
        GitShowRead { content: algebra_ref } =>
          ReviewContextReady { design: design, algebra_ref: algebra_ref }
      }
  }
}

fn fetch_pr_head_ref(ref: String) -> Bool {
  let fetched = git.Core.FetchNoTags(
    remote: "origin",
    ref: ref,
    stall_deadline_seconds: review_fetch_stall_deadline_seconds
  )
  fetched.success
}

fn build_system_prompt(
  design: String,
  algebra_ref: String
) -> String {
  let instructions = "Review on three axes:\n1. PRINCIPLE VIOLATIONS: check diff against DESIGN.md\n2. COMPOSITIONAL MODELING: for .dag changes, evaluate accuracy, harmony, layering\n3. COMMENT DISCIPLINE (DESIGN.md): code should speak through clear names, small functions, structured types, and readable control flow instead of explanatory comments. Accept narrow comments only for non-obvious boundaries, genuinely complex decisions, historical/performance context, or load-bearing headers.\n\nOutput:\nVIOLATION|file|line|description\nMODEL|file|GOOD|description\nMODEL|file|IMPROVE|description\nSTYLE|file|line|description\nSUMMARY|one sentence\n\nNothing else."
  "{instructions}\n\n--- DESIGN.md ---\n{design}\n\n--- std/algebra.dag ---\n{algebra_ref}"
}

fn build_user_message(
  pr_title: String,
  pr_number: Int,
  branch: String,
  base_ref: String,
  diff: String
) -> String {
  "PR #{pr_number}: {pr_title}\nBranch: {branch} -> {base_ref}\n\n--- Diff ---\n{diff}"
}

func review_pr(
  owner: String,
  repo: String,
  pr_number: Int,
  model: String = gunbc.tools.review.default_model
) -> { reviewed: Bool, comment_url: String } {

  pr = github.Pulls.Get(
    auth_token: "",
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )

  existing = github.Pulls.ListReviews(
    auth_token: "",
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )
  already_done = gunbc.tools.review.has_review_at_sha(reviews: existing.reviews, sha: pr.pr.head.sha)

  diff = github.Pulls.Diff(
    auth_token: "",
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )
  let _ = fetch_pr_head_ref(ref: pr.pr.head.ref)
  let origin_ref = concat("origin/", pr.pr.head.ref) as std.types.GitRef
  match review_context_read(ref: origin_ref) {
    ReviewContextRefused { reason: why } =>
      return { reviewed: false, comment_url: concat("review refused: ", why) }
    ReviewContextReady { design: design, algebra_ref: algebra_ref } => {
      system_prompt = build_system_prompt(
        design: design,
        algebra_ref: algebra_ref
      )
      user_msg = build_user_message(
        pr_title: pr.pr.title,
        pr_number: pr_number,
        branch: pr.pr.head.ref,
        base_ref: pr.pr.base.ref,
        diff: diff.diff
      )
      llm_response = llm.Anthropic.Messages(
        api_key: "",
        model: model,
        messages: review_messages,
        max_tokens: 8192,
        temperature: none,
        system: "{system_prompt}\n\n{user_msg}"
      )

      posted = github.Pulls.CreateReview(
        auth_token: "",
        owner: owner,
        repo: repo,
        pull_number: pr_number,
        commit_id: pr.pr.head.sha,
        body: llm_response.content,
        comments: "[]"
      )

      return { reviewed: true, comment_url: posted.html_url }
    }
  }
}

data review_cycle_default_scope_note: String = "THE DEFAULTS PROJECT FROM gunbc.repository RATHER THAN RESPELLING THE SLUG, closing the last of the five nicknames (review 46301). One hazard is recorded with it because it is not visible at this line: a default argument expression is evaluated in the CALLER'S scope, not this module's, so a future caller in a module that does not import gunbc.repository would die at the call site with an undefined variable naming something it never wrote. That is safe today only because review_cycle has no in-corpus caller - the one reference is a command string invoking review_codex's function of the same name - so the default is unreachable rather than proven. A caller that appears must import gunbc.repository, or pass owner and repo explicitly, which is the better habit anyway."

func review_cycle(
  owner: String = gunbc_repository.owner,
  repo: String = gunbc_repository.name
) -> { reviewed_count: Int } {

  upsert_tagged_cron_tab(
    tag: "review-agent",
    schedule: render_cron_schedule(gunbc.tools.review.cron_schedule),
    command: "/Users/briansrls/gunbc/target/review-codegen/review-agent review-cycle",
    log_path: "/Users/briansrls/.local/share/gunbc-review/logs/cron.log"
  )

  open_prs = github.Pulls.List(
    auth_token: "",
    owner: owner,
    repo: repo,
    state: extdeps.github.pulls.Open
  )

  results = for pr in open_prs.pulls {
    gunbc.tools.review.review_pr(
      owner: owner,
      repo: repo,
      pr_number: pr.number
    )
  }

  return { reviewed_count: count(results) }
}
