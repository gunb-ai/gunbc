module gunbc.tools.bmc_onboard_validate


func bmc_onboard_validate() -> ProcessExit
  uses net: std.resources.Network
{
  let bmc_host = srv3_onboarding_plan.bmc.host

  root_resp = redfish.Http.GetServiceRoot(bmc_host: bmc_host)
  if root_resp.success == false {
    return exit_failure(reason: root_resp.body)
  }

  system_resp = redfish.Http.GetSystem(
    bmc_host: bmc_host,
    username: srv3_onboarding_plan.factory_login.username,
    password: srv3_onboarding_plan.factory_login.published_password as Secret
  )

  return if system_resp.success { ExitSuccess } else { exit_failure(reason: system_resp.body) }
}
