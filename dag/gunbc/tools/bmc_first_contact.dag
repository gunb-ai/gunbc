module gunbc.tools.bmc_first_contact

// THE NETRC AUTHORITY IS IMPORTED RATHER THAN RE-SPELLED. This module previously declared no imports
// at all and resolved every name through corpus scope, which is survivable for a diagnostic tool and
// is NOT survivable for the one function that decides the mode of a file holding a credential: a
// second local netrc_content would be a fork of an authority whose whole point is that there is one
// of it, and bare resolution over a whole-corpus pool is not a stable binding to reason about when
// the question is "which write verb ran".
import gunbc.tools.bmc_onboard {
  BmcGetSystem, bmc_authenticated_call, bmc_call_succeeded, bmc_call_failure_reason,
}
import std.types { Secret }
import std.process { ProcessExit, ExitSuccess, exit_failure }


// `shell.Env.Get` answers `value: String?`, and this func reached it with `as NonEmptyStr`, which
// does not eliminate the absence: with BMC_HOST unset the Redfish call was dialled at a host whose
// name was the literal text `Absent`. The compiler now refuses that cast. The absent arm is a loud
// word rather than a plausible hostname so the resulting connection failure names its own cause
// instead of reading as an unreachable BMC.
fn bmc_first_contact_host(value: String?) -> NonEmptyStr {
  match value {
    Present { value: host } => host as NonEmptyStr
    Absent => "bmc-host-env-unset" as NonEmptyStr
  }
}

// THE FACTORY PASSWORD IS PUBLISHED, AND IT STILL DOES NOT GO IN ARGV. It is tempting to treat a
// vendor-published default as harmless in a command line, but the exception would be the wrong shape
// to teach: this func calls the same operation bmc_onboard uses to authenticate with a ROTATED
// secret, and an operation that accepts a credential by argv accepts every credential by argv.
// Keeping one authentication path means the leaky one has nowhere to survive, so first-contact
// authenticates through the same per-call private netrc as every other Redfish caller, removed when
// the call returns, and refuses loudly if it cannot place or remove it.
fn bmc_first_contact() -> ProcessExit
{
  host = shell.Env.Get(name: "BMC_HOST")
  let bmc = bmc_first_contact_host(value: host.value)

  let resp = bmc_authenticated_call(
    stage: "first-contact",
    host: bmc,
    account: openbmc_factory_login.username,
    password: openbmc_factory_login.published_password as Secret,
    call: BmcGetSystem,
  )

  return if bmc_call_succeeded(outcome: resp) { ExitSuccess } else { exit_failure(reason: bmc_call_failure_reason(outcome: resp, rejected_prefix: "")) }
}
