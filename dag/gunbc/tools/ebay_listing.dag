module gunbc.tools.ebay_listing

import extdeps.transports.rest { RestResult, RestAnswered, RestRefused, RestRefusal, RestExchangeRefusal, RestMutationExchange, classify_rest_refusal }
import extdeps.ebay.ebay { EbayUs, MarketplaceEnum }
import extdeps.ebay.inventory { ConditionEnum, EbayAmount, EbayOfferDetailsWithKeys, FixedPrice, FormatTypeEnum, InventoryItem, InventoryItemAvailability, InventoryItemProduct, ListingPolicies, PricingSummary, ShipToLocationAvailability }
import extdeps.ebay.inventory
import extdeps.ebay.oauth { sell_inventory_scope }
import extdeps.ebay.oauth
import std.credentials { CredentialSource }

data ebay_client_id_source: CredentialSource = std.credentials.EnvVar { name: "EBAY_CLIENT_ID" }

data ebay_client_secret_source: CredentialSource = std.credentials.EnvVar { name: "EBAY_CLIENT_SECRET" }

data ebay_refresh_token_source: CredentialSource = std.credentials.EnvVar { name: "EBAY_REFRESH_TOKEN" }

data default_marketplace: MarketplaceEnum = EbayUs

data default_format: FormatTypeEnum = FixedPrice

data default_content_language: NonEmptyStr = "en-US"

data default_currency: CurrencyCode = Usd

data fixed_price_listing_duration: NonEmptyStr = "GTC"

type EbayListingDraft {
  sku: NonEmptyStr
  title: NonEmptyStr
  description: String
  image_urls: List<String>
  condition: ConditionEnum
  price_value: String
  quantity: Int
  category_id: String
  fulfillment_policy_id: NonEmptyStr
  payment_policy_id: NonEmptyStr
  return_policy_id: NonEmptyStr
  merchant_location_key: String
}

fn build_inventory_item(draft: EbayListingDraft) -> InventoryItem {
  InventoryItem {
    availability: InventoryItemAvailability {
      shipToLocationAvailability: ShipToLocationAvailability { quantity: draft.quantity }
    },
    condition: draft.condition,
    conditionDescription: none,
    product: InventoryItemProduct {
      title: draft.title,
      description: draft.description,
      aspects: none,
      imageUrls: draft.image_urls
    }
  }
}

fn build_offer(draft: EbayListingDraft) -> EbayOfferDetailsWithKeys {
  EbayOfferDetailsWithKeys {
    sku: draft.sku,
    marketplaceId: default_marketplace,
    format: default_format,
    availableQuantity: draft.quantity,
    categoryId: draft.category_id,
    listingDescription: draft.description,
    listingDuration: fixed_price_listing_duration,
    listingPolicies: ListingPolicies {
      fulfillmentPolicyId: draft.fulfillment_policy_id,
      paymentPolicyId: draft.payment_policy_id,
      returnPolicyId: draft.return_policy_id
    },
    pricingSummary: PricingSummary {
      price: EbayAmount { value: draft.price_value, currency: default_currency }
    },
    merchantLocationKey: draft.merchant_location_key
  }
}

type EbayStep
  = EbayStepMintUserToken
  | EbayStepCreateOrReplaceInventoryItem
  | EbayStepCreateOffer
  | EbayStepPublishOffer
  | EbayStepGetInventoryItems

type EbayCommittedStep
  = EbayInventoryItemCommitted { sku: NonEmptyStr }
  | EbayOfferCommitted { offer_id: NonEmptyStr }

type EbaySellerToken
  = EbaySellerTokenMinted { access_token: Secret }
  | EbaySellerTokenRefused { step: EbayStep, refusal: RestRefusal }

type EbayItemListing
  = EbayItemListed { offer_id: String, listing_id: String }
  | EbayItemListingRefused { step: EbayStep, refusal: RestRefusal, exchange: RestExchangeRefusal, committed: List<EbayCommittedStep> }

type EbayInventoryView
  = EbayInventoryShown { total: Int, size: Int }
  | EbayInventoryShowRefused { step: EbayStep, refusal: RestRefusal }

fn ebay_list_item_refused(step: EbayStep, refusal: RestRefusal, committed: List<EbayCommittedStep>) -> EbayItemListing {
  EbayItemListingRefused {
    step: step,
    refusal: refusal,
    exchange: classify_rest_refusal(standing: RestMutationExchange { refusal: refusal }),
    committed: committed
  }
}

fn mint_seller_token(
  client_id: String,
  client_secret: Secret,
  refresh_token: Secret
) -> EbaySellerToken {

  match ebay.OAuth.MintUserToken(
    client_id: client_id,
    client_secret: client_secret,
    refresh_token: refresh_token,
    scope: sell_inventory_scope
  ) {
    RestRefused { refusal } =>
      return EbaySellerTokenRefused { step: EbayStepMintUserToken, refusal: refusal }
    RestAnswered { answer: token } =>
      return EbaySellerTokenMinted { access_token: token.access_token }
  }
}

fn list_item(
  draft: EbayListingDraft,
  client_id: String,
  client_secret: Secret,
  refresh_token: Secret
) -> EbayItemListing {

  match mint_seller_token(
    client_id: client_id,
    client_secret: client_secret,
    refresh_token: refresh_token
  ) {
    EbaySellerTokenRefused { step: step, refusal: refusal } =>
      return ebay_list_item_refused(step: step, refusal: refusal, committed: [])
    EbaySellerTokenMinted { access_token: access_token } =>
      match ebay.Inventory.CreateOrReplaceInventoryItem(
        access_token: access_token,
        sku: draft.sku,
        content_language: default_content_language,
        item: build_inventory_item(draft: draft)
      ) {
        RestRefused { refusal } =>
          return ebay_list_item_refused(step: EbayStepCreateOrReplaceInventoryItem, refusal: refusal, committed: [])
        RestAnswered { answer: _ } =>
          match ebay.Inventory.CreateOffer(
            access_token: access_token,
            content_language: default_content_language,
            offer: build_offer(draft: draft)
          ) {
            RestRefused { refusal } =>
              return ebay_list_item_refused(
                step: EbayStepCreateOffer,
                refusal: refusal,
                committed: [EbayInventoryItemCommitted { sku: draft.sku }]
              )
            RestAnswered { answer: offer } =>
              match ebay.Inventory.PublishOffer(
                access_token: access_token,
                offer_id: offer.offer_id
              ) {
                RestRefused { refusal } =>
                  return ebay_list_item_refused(
                    step: EbayStepPublishOffer,
                    refusal: refusal,
                    committed: [EbayInventoryItemCommitted { sku: draft.sku }, EbayOfferCommitted { offer_id: offer.offer_id }]
                  )
                RestAnswered { answer: published } =>
                  return EbayItemListed { offer_id: offer.offer_id, listing_id: published.listing_id }
              }
          }
      }
  }
}

fn show_inventory(
  client_id: String,
  client_secret: Secret,
  refresh_token: Secret,
  limit: Int = default_inventory_items_limit
) -> EbayInventoryView {

  match mint_seller_token(
    client_id: client_id,
    client_secret: client_secret,
    refresh_token: refresh_token
  ) {
    EbaySellerTokenRefused { step: step, refusal: refusal } =>
      return EbayInventoryShowRefused { step: step, refusal: refusal }
    EbaySellerTokenMinted { access_token: access_token } =>
      match ebay.Inventory.GetInventoryItems(
        access_token: access_token,
        limit: limit,
        offset: 0
      ) {
        RestRefused { refusal } =>
          return EbayInventoryShowRefused { step: EbayStepGetInventoryItems, refusal: refusal }
        RestAnswered { answer: page } =>
          return EbayInventoryShown { total: page.total, size: page.size }
      }
  }
}
