module gunbc.tools.roadmap_spawn_request

import extdeps.git.inspect
import extdeps.languages.json.emit {
  serialize_json,
  json_object,
  json_kv,
  json_string,
  json_array,
}
import gunbc.roadmap_authority {
  roadmap_authority_projection,
  RoadmapAuthorityProjected, RoadmapAuthorityProjectionRefused,
  authored_merged_prs,
}
import gunbc.roadmap_spawner { roadmap_spawn_request_json }

func roadmap_next_spawnable() -> String {
  match roadmap_authority_projection() {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      serialize_json(v: json_object(members: [
        json_kv(key: "schema", value: json_string(s: "roadmap-spawn-request/v1")),
        json_kv(key: "error", value: json_string(s: detail)),
        json_kv(key: "ready", value: json_array(elements: [])),
      ]))
    RoadmapAuthorityProjected { doc: doc, accepted: _ } => {
      let sha_result = git.Inspect.HeadCommit()
      if sha_result.success {
        roadmap_spawn_request_json(doc: doc, merged: authored_merged_prs(), anchor_commit: sha_result.sha)
      } else {
        "{\"schema\": \"roadmap-spawn-request/v1\", \"error\": \"anchor_commit unavailable: git rev-parse HEAD failed\", \"ready\": []}"
      }
    }
  }
}
