module gunbc.review_sheet_header_init

import std.types { NonEmptyStr, String, Int, List, Bool }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.decl_ref { decl_ref }
import std.dissolution { unbound_dissolution }
import extdeps.google.sheets {
  ValueRangeWrite,
  A1RangeEncoding,
  A1RangeEncoded,
  A1TitleApostropheUnsupported,
  sheets_major_dimension_wire,
  DimensionRows,
}
import gunbc.review_sheet_projection {
  ValidatedHeaderSchema,
  review_sheet_header_names,
  A1RowSpan,
  a1_row_span,
  a1_column_letters,
}
import gunbc.review_sheet_sheets { sheet_qualified_span }
import gunbc.review_sheet_formula_observation {
  FormulaWholeTabObservation,
  FormulaWholeTabReading,
  FormulaWholeTabObserved,
  FormulaWholeTabRefused,
  FormulaWholeTabRefusal,
  formula_whole_tab_refusal_text,
}

// HEADER INITIALISATION OF A TAB THAT HOLDS NO VALUE OR FORMULA. The locked live buyer-sheet
// transaction (H2) writes a header row into a freshly created tab before the ordinary ensure pass
// can run; that pass classifies rows under a header row and has nothing to classify until one
// exists. A header row cannot be taken back once written, so the decision to write it is the one
// place where "this tab is empty" is load-bearing, and the parked planner (gunbc#11613) got it
// wrong in two ways this module is built against: it judged emptiness from a FORMATTED_VALUE
// readback (finding 2, a blank-rendering formula is invisible), and it exported two routes to the
// write authorisation that consulted no observation at all (finding 4).
//
// ONE INPUT, ONE MINT. plan_header_init takes the reading gunbc.review_sheet_formula_observation
// produced -- its carrier is sole_constructor and its only mint performs the FORMULA read -- and
// the landed ValidatedHeaderSchema, whose only mint is validate_header_schema. It is the only
// function that writes HeaderRowWriteAuthorization, which is itself sole_constructor. No helper
// here returns the authorisation or a plan from caller-supplied parts: first_occupied_cell answers
// a question about a grid and header_row_span a question about a schema, and neither confers
// anything. The pieces H2 needs to perform the write are read off the authorisation
// (header_row_value_range_write), never assembled beside it.
//
// EMPTINESS IS FAIL-CLOSED. A tab is empty exactly when every cell of every row the FORMULA read
// returned is "". A header list that is [] says nothing -- values.get omits the values field for an
// empty range and returns a ragged grid otherwise, so "row 1 is empty" is a statement about one
// row and "there are no rows" is the only zero. Whitespace is content: " " in A1 is a value the
// operator or a formula put there, and a write over it erases it. The first cell that is not ""
// is returned located, in reading order, so the operator is told WHICH cell stopped the write.
//
// THE RUNG IS THE SAME AS THE OBSERVATION'S. sole_constructor is enforced on the v1 seed's
// acceptance path and parsed without enforcement on the native v2 path (gunbc.rung_drop
// g0_type_decl_modifier_parse_without_sealing_property), so the wall on the authorisation is real
// on the seed only. WHO may call plan_header_init is not confined here: .dag has no module-private
// and the consumer is in another repository, so the confinement of the mint's callers is the
// private H2 caller's job (its write permit wraps this call), and this module states that
// boundary rather than claiming it.

type HeaderRowWriteAuthorization sole_constructor {
  spreadsheet_id: NonEmptyStr
  tab: NonEmptyStr
  range: String
  span: A1RowSpan
  cells: List<String>
}

// The first cell that is not "", located: sheet_row is 1-based (row 1 is the header row),
// column_index is 0-based within that row. The raw cell is carried so the refusal names what was
// found -- under FORMULA rendering that is the formula text for a formula cell.
type OccupiedCell {
  sheet_row: Int
  column_index: Int
  raw: String
}

type RowScan
  = RowScanClear
  | RowScanFound { found: OccupiedCell }

fn first_occupied_in_row(cells: List<String>, sheet_row: Int) -> RowScan {
  let found =
    cells
      |> enumerate
      |> filter(p => p.second != "")
      |> map(p => OccupiedCell { sheet_row: sheet_row, column_index: p.first, raw: p.second })
      |> first
  match found {
    Present { value: c } => RowScanFound { found: c }
    Absent => RowScanClear
  }
}

fn first_occupied_cell(rows: List<List<String>>) -> RowScan {
  rows
    |> enumerate
    |> fold(init: RowScanClear, f: (acc, p) =>
      match acc {
        RowScanFound { found: c } => RowScanFound { found: c }
        RowScanClear => first_occupied_in_row(cells: p.second, sheet_row: p.first + 1)
      })
}

fn occupied_cell_text(cell: OccupiedCell) -> String {
  join([
    "row ", to_string(cell.sheet_row),
    " column index ", to_string(cell.column_index),
    " holds ", cell.raw,
  ], "")
}

// The header row's span: A1 to the last header's column on row 1. The A1 column authority is the
// enrolled letter roster (gunbc.review_sheet_projection a1_column_letters, A..Z), and a schema
// wider than it has no address for its last header, which is a refusal rather than a truncated row.
type HeaderRowSpan
  = HeaderRowSpanned { span: A1RowSpan }
  | HeaderRowUnaddressable { header_count: Int, addressable_columns: Int }

fn header_row_span(validated: ValidatedHeaderSchema) -> HeaderRowSpan {
  let n = count(review_sheet_header_names(validated: validated))
  match a1_row_span(sheet_row: 1, cell_count: n) {
    Present { value: s } => HeaderRowSpanned { span: s }
    Absent => HeaderRowUnaddressable { header_count: n, addressable_columns: count(a1_column_letters) }
  }
}

type HeaderInitPlan
  = HeaderInitWriteHeaderRow { authorization: HeaderRowWriteAuthorization }
  | HeaderInitTabOccupied { tab: NonEmptyStr, first: OccupiedCell }
  | HeaderInitHeaderRowUnaddressable { tab: NonEmptyStr, header_count: Int, addressable_columns: Int }
  | HeaderInitTabTitleUnquotable { tab: NonEmptyStr }
  | HeaderInitObservationRefused { refusal: FormulaWholeTabRefusal }

// THE ONLY MINT of HeaderRowWriteAuthorization. Order: the observation's own refusal first (there
// is no tab to speak of); then the grid, because a schema question is not asked of an occupied
// tab; then the schema's address. The title encoding is asked last and is unreachable in practice
// -- the observation's tab equals the tab the encoder already admitted at request time -- but the
// codec's refusal is an arm of its result and the fold is total over it.
fn plan_header_init(reading: FormulaWholeTabReading, validated: ValidatedHeaderSchema) -> HeaderInitPlan {
  match reading {
    FormulaWholeTabRefused { refusal: r } => HeaderInitObservationRefused { refusal: r }
    FormulaWholeTabObserved { observation: o } =>
      match first_occupied_cell(rows: o.rows) {
        RowScanFound { found: c } => HeaderInitTabOccupied { tab: o.tab, first: c }
        RowScanClear =>
          match header_row_span(validated: validated) {
            HeaderRowUnaddressable { header_count: n, addressable_columns: a } =>
              HeaderInitHeaderRowUnaddressable { tab: o.tab, header_count: n, addressable_columns: a }
            HeaderRowSpanned { span: s } =>
              match sheet_qualified_span(tab: o.tab, span: s) {
                A1TitleApostropheUnsupported { title: t } => HeaderInitTabTitleUnquotable { tab: t }
                A1RangeEncoded { wire: w } =>
                  HeaderInitWriteHeaderRow {
                    authorization: HeaderRowWriteAuthorization {
                      spreadsheet_id: o.spreadsheet_id,
                      tab: o.tab,
                      range: w,
                      span: s,
                      cells: map(review_sheet_header_names(validated: validated), n => n as String),
                    }
                  }
              }
          }
      }
  }
}

// The one value range the authorisation lowers to: the encoded row-1 span, ROWS-major, the header
// names as one row. A projection off the sealed carrier, so it cannot be reached without one.
fn header_row_value_range_write(authorization: HeaderRowWriteAuthorization) -> ValueRangeWrite {
  ValueRangeWrite {
    range: authorization.range,
    majorDimension: sheets_major_dimension_wire(d: DimensionRows),
    values: [authorization.cells],
  }
}

fn header_init_plan_text(plan: HeaderInitPlan) -> String {
  match plan {
    HeaderInitWriteHeaderRow { authorization: a } =>
      join(["write the header row at ", a.range, ": ", join(a.cells, "|")], "")
    HeaderInitTabOccupied { tab: t, first: c } =>
      join(["tab ", t as String, " is occupied: ", occupied_cell_text(cell: c)], "")
    HeaderInitHeaderRowUnaddressable { tab: t, header_count: n, addressable_columns: a } =>
      join(["tab ", t as String, ": the header row has ", to_string(n), " names and only ", to_string(a), " columns are addressable"], "")
    HeaderInitTabTitleUnquotable { tab: t } =>
      join(["tab ", t as String, " cannot be quoted in A1 notation"], "")
    HeaderInitObservationRefused { refusal: r } =>
      join(["the FORMULA observation was refused: ", formula_whole_tab_refusal_text(refusal: r)], "")
  }
}

// THE CONSUMER IS PRIVATE AND LATER. strategy.buyer_review_live (gunbc-private, H2) plans the
// header row from the FORMULA reading and performs the write from header_row_value_range_write
// under its transaction, with an independent readback. The pure folds are executed by
// test.claim.review_sheet_header_init_witness, and plan_header_init is executed there against the
// hermetic values.get fixture; neither is a production consumer, so both routes below are frontier.
data review_sheet_header_init_consumer_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.review_sheet_header_init", decl_name: "plan_header_init"),
    reason: "the only mint of HeaderRowWriteAuthorization, over a FormulaWholeTabReading and a ValidatedHeaderSchema; its caller is the private transaction strategy.buyer_review_live (H2), whose write permit confines who may plan a header row",
    dissolution: unbound_dissolution(description: "dissolves when strategy.buyer_review_live (gunbc-private, H2) calls gunbc.review_sheet_header_init plan_header_init over a reading from observe_formula_whole_tab and performs the HeaderInitWriteHeaderRow write from header_row_value_range_write under its transaction with an independent readback; the hermetic witness execution does not fire this, and neither does a caller that matches the plan without performing the write"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.review_sheet_header_init", decl_name: "header_row_value_range_write"),
    reason: "the lowering of an authorisation to the one ValueRangeWrite the private transaction sends",
    dissolution: unbound_dissolution(description: "dissolves when strategy.buyer_review_live (gunbc-private, H2) calls gunbc.review_sheet_header_init plan_header_init over a reading from observe_formula_whole_tab and performs the HeaderInitWriteHeaderRow write from header_row_value_range_write under its transaction with an independent readback; the hermetic witness execution does not fire this, and neither does a caller that matches the plan without performing the write"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.review_sheet_header_init", decl_name: "header_init_plan_text"),
    reason: "the operator rendering of a plan, consumed by the same private transaction's report",
    dissolution: unbound_dissolution(description: "dissolves when strategy.buyer_review_live (gunbc-private, H2) calls gunbc.review_sheet_header_init plan_header_init over a reading from observe_formula_whole_tab and performs the HeaderInitWriteHeaderRow write from header_row_value_range_write under its transaction with an independent readback; the hermetic witness execution does not fire this, and neither does a caller that matches the plan without performing the write"),
  ),
]
