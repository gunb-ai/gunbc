module gunbc.witness_eval_budget

import std.realization_schedule {
  ScheduleWitnessEntry,
  WitnessKind,
  CorpusWitnessKind,
  schedule_witness_entry_roster_contains
}
import std.witness_admission {
  WitnessExecutionBudget,
  FastLaneEvalBudget,
  SubstrateLongLaneEvalBudget
}
import std.types { NonEmptyStr, String, List, Bool, Int }
import std.algebra { Cons, Empty }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE BUDGET AXIS'S OWN CARRIER, AND IT IS HERE BECAUSE THE AXIS DID NOT HAVE ONE.
//
// std.witness_admission witness_admission_axis_separation_note already declares what
// WitnessExecutionBudget is: "how much eval time this witness requires to reach a verdict at all.
// It is a property of the WITNESS (what it walks), never of the batch that happens to hold it, so
// declaring a long budget must not require joining a second batch." That sentence was true of the
// TYPE and false of its CARRIER. Until this change the only place a budget could be written was
// the `budget` field on gunbc.explicit_witness_admission ExplicitWitnessAdmission, and an
// admission row carries two consequences the budget axis has nothing to do with:
//
//   explicit_witness_admission_cadence_executes REFUSES DiscoverySelection, OfflineLocalRecipe,
//   FixtureExplicitRoster and NoConsumer, and explicit_witness_admissions_well_formed folds it
//   over every row — so a row for a witness that runs on per-PR discovery is malformed by
//   construction; and
//
//   v2.workflow.witness_admission witness_row_excluded_from_discovery reads the admission rows
//   directly, and v2.workflow.floor_discovery_producer drops exactly those (entry, function)
//   pairs — so writing a budget for a discovered witness DELETED it from the required floor.
//
// The axis was therefore expressible only for witnesses that had already left discovery. A witness
// whose cost is a fact about what it walks, and which runs on the floor, could not say so. That is
// the defect this module removes, and it is removed by moving the field rather than by adding a
// second home for it: DESIGN §3's replacement rule wants the authority transition atomic and the
// old root gone, so ExplicitWitnessAdmission no longer carries a budget at all and every consumer
// of the axis resolves here.
//
// THE RESIDUAL IS FAST, AND IT IS A RESIDUAL RATHER THAN A ROW. A witness with no row here runs
// under the ordinary per-claim ceiling. Enumerating the fast witnesses would be a roster of the
// whole corpus maintained by hand to say what the absence of a row already says; the sixteen
// `budget: FastLaneEvalBudget` lines this migration deleted from the admission rows were exactly
// that, restating the default once per row. The direction of the arm is what makes the absence
// safe: an undeclared witness gets the TIGHTER limit, so a lane that forgets to declare reds
// loudly rather than running unbounded (std.witness_admission's own statement of the rule — "the
// arm narrows, never widens").

type DeclaredWitnessEvalBudget {
  witness: ScheduleWitnessEntry
  budget: WitnessExecutionBudget
  reason: NonEmptyStr
  dissolution: DissolutionCondition
}

fn long_eval_budget(
  entry: String,
  f: String,
  kind: WitnessKind,
  reason: NonEmptyStr,
  dissolution: DissolutionCondition
) -> DeclaredWitnessEvalBudget {
  DeclaredWitnessEvalBudget {
    witness: ScheduleWitnessEntry { entry: entry, function: f, kind: kind },
    budget: SubstrateLongLaneEvalBudget,
    reason: reason,
    dissolution: dissolution,
  }
}

// A ROW'S REASON NAMES WHAT THE WITNESS WALKS, never what a runner happened to measure. The
// measurement is admissible evidence for the row and is not its subject: a cost observed on a
// shared runner is a fact about that attempt (gunbc.rung_drop floor_cost_contention_verdict), and
// a row grounded in one would be re-derived every time the number moved. What makes a row correct
// is that the witness's own work is bounded by something the ordinary ceiling cannot see.

data declared_witness_eval_budgets: List<DeclaredWitnessEvalBudget> = [
  long_eval_budget(
    entry: "dag/test/claim/long/g2_data_reference_under_selection_witness_test.dag",
    f: "specimen_classifies_as_runtime_read",
    kind: CorpusWitnessKind,
    reason: "Live-read selection specimen: the claim derives a selection manifest over a narrowed but real specimen pool (dag/test/claim plus the scaffold-disposition fixture root), so its cost is the pool's breadth rather than the claim's own arithmetic. That input is not bounded by anything the per-claim ceiling can see. Moved here unchanged from the admission row that carried it before the budget axis had a carrier of its own.",
    dissolution: unbound_dissolution(description: "live_read_selection_manifest_live derives its manifest at closure cost rather than by walking the specimen pool per claim, at which point the row's own work is bounded by its closure and this row deletes")
  ),
  long_eval_budget(
    entry: "dag/test/claim/long/g2_data_reference_under_selection_witness_test.dag",
    f: "specimen_does_not_classify_as_local_read",
    kind: CorpusWitnessKind,
    reason: "The discriminating half of the same under-selection pair, walking the same specimen pool for the same reason as its sibling specimen_classifies_as_runtime_read.",
    dissolution: unbound_dissolution(description: "same as specimen_classifies_as_runtime_read row")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/direct_rust_door_production_group_test.dag",
    f: "direct_rust_door_production_group_closing_expectation_holds",
    kind: CorpusWitnessKind,
    reason: "The direct-rust-door closing validation runs one real production group construction — an interpreted walk of the emitter's own pipeline — so the cost is the pipeline crossing the witness exists to observe, not incidental work around it.",
    dissolution: unbound_dissolution(description: "the group construction the witness observes is realized natively rather than interpreted, so the crossing costs closure time instead of a pipeline run, and this row deletes")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag",
    f: "witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds",
    kind: CorpusWitnessKind,
    reason: "Origin-probe family: the cell walks the live derivation the module's own production_qualification_origin_probe_long_witness_note names — fn_arrow_decl_facts_live() / derived_production_qualification_mint_sites_live() — so its input is the live scope's breadth rather than a fixture the claim controls.",
    dissolution: unbound_dissolution(description: "closure discovery is served from a shared derivation rather than re-walked per claim, and the four origin-probe rows delete together")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag",
