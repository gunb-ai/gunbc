    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell asserts a series that does not validate refuses rather than answers.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
