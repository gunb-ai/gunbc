    f: "a_live_observation_on_the_receipts_own_toolchain_is_comparable",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell is the comparability positive control against the receipt's own toolchain.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
