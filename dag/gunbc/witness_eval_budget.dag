    dissolution: unbound_dissolution(description: "same as witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds row")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag",
    f: "witness_ingest_mint_surface_requires_call_occurrence_frontier_reds",
    kind: CorpusWitnessKind,
    reason: "Same origin-probe closure walk as witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds.",
    dissolution: unbound_dissolution(description: "same as witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds row")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/production_qualification_origin_probe_witness_test.dag",
    f: "witness_direct_door_smoke_requires_closure_or_call_occurrence_frontier_reds",
    kind: CorpusWitnessKind,
    reason: "Same origin-probe closure walk as witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds.",
    dissolution: unbound_dissolution(description: "same as witness_live_scope_fixture_origin_discoverable_in_entry_closure_reds row")
  ),
  long_eval_budget(
    entry: "src/v2/test/claim/long/infer_transform_binary_infix_witness_test.dag",
    f: "infer_transform_add_vertical_witness_holds",
    kind: CorpusWitnessKind,
    reason: "One normalize->resolve->infer pass over add_probe through the production frontend: the crossing IS the subject, so its cost is the witness's own work rather than overhead. The fast per-PR control that carries the cheap half is infer_transform_non_add_remains_frontier_holds.",
    dissolution: unbound_dissolution(description: "the frontend+infer crossing is realized natively rather than interpreted, at which point the pass costs closure time and this row deletes with the long-lane file")
  ),

  // THE THIRTEEN LIVE-GATE CELLS. They are one row each rather than one file-grain row because
  // the axis is declared at function grain everywhere else in this carrier and a file-grain row
  // would silently adopt any cell added to the module later — a budget granted to a witness
  // nobody has written yet is not a declaration about what that witness walks.
  //
  // WHAT THEY WALK, WHICH IS THE ROW'S SUBJECT. Every cell derives from
  // gunbc.self_host_compile_phase_frontier self_host_compile_phase_frontier_receipts — the
  // persisted compile-phase receipt series, an authored roster carrying each receipt's full raw
  // diagnostic-identity census — and then folds that census through the frontier's own fold. The
  // series is the witness's input, it is authored data that grows as receipts are appended, and
  // its size is not visible to a per-claim ceiling derived from what an ordinary witness costs.
  // The claim frame is fresh per claim (required_floor_runner builds one so that "claims sharing
  // one immutable scope must not share the mutable evaluation caches a context owns"), so the
  // derivation is paid once per cell and thirteen times per module, by construction.
  //
  // THESE ARE NOT KNOWN-RED ROWS AND THEY DO NOT LEAVE DISCOVERY. They pass; they are enrolled on
  // the required floor under required_gate_prefixes' `test.claim.self_host_` prefix and stay
  // there. That is the whole point of the carrier split above: before it, saying "this witness
  // needs more eval time" could only be said by a row that also removed the witness from the
  // floor.
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_live_census_equal_to_the_latest_receipt_holds",
    kind: CorpusWitnessKind,
    reason: "The accepted positive control of the live compile-phase gate: it re-derives the board from the latest receipt's own raw identity census through the frontier's live fold, so its input is the persisted receipt series rather than anything the cell authors.",
    dissolution: unbound_dissolution(description: "the receipt series is derived once per RUN and shared across the claims that read it — a provider whose scope reaches the floor's claim loop, per std.materialization_ladder — rather than re-derived inside each claim's own frame; the thirteen live-gate rows then delete together, because at that point a cell's own work is the perturbation it applies and nothing else")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_live_tree_that_gained_an_identity_refuses_and_names_it",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell adds one planted identity to that census and asserts the refusal names it.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_live_tree_that_swapped_an_identity_at_equal_cardinality_refuses",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell is the probe that would go green if the identity join were replaced by a population-size comparison.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_live_tree_that_removed_an_identity_holds",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell asserts a shrinking census is not a regression.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_live_observation_from_another_host_target_is_unmeasured_not_held",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell perturbs the toolchain reading and asserts the verdict is unmeasured rather than held.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
    entry: "dag/test/claim/self_host_compile_phase_live_gate_witness_test.dag",
    f: "a_pinned_live_invocation_is_incomparable_to_a_defaulted_receipt",
    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell perturbs the invocation and asserts incomparability.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  ),
  long_eval_budget(
