    kind: CorpusWitnessKind,
    reason: "Same receipt-series derivation as a_live_census_equal_to_the_latest_receipt_holds; this cell asserts an empty census from a completed measurement is a held verdict rather than an unmeasured one.",
    dissolution: unbound_dissolution(description: "same as a_live_census_equal_to_the_latest_receipt_holds row")
  )
]

fn declared_witness_eval_budget_matches(
  row: DeclaredWitnessEvalBudget,
  entry: String,
  function: String
) -> Bool {
  (row.witness.entry == entry) && (row.witness.function == function)
}

fn declared_witness_eval_budget_count_for_in(
  rows: List<DeclaredWitnessEvalBudget>,
  entry: String,
  function: String
) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(n, row) {
      if declared_witness_eval_budget_matches(row: row, entry: entry, function: function) {
        n + 1
      } else {
        n
      }
    }
  )
}

// EXACTLY ONE DECLARATION PER WITNESS, for the reason the admission authority states about its own
// uniqueness wall: a witness with two rows carries two budgets, and the lookup below would answer
// with whichever came first while the second stayed authored and unread.

fn declared_witness_eval_budget_duplicate_count_in(
  rows: List<DeclaredWitnessEvalBudget>
) -> Int {
  fold(
    rows,
    init: 0,
    f: fn(n, row) {
      if declared_witness_eval_budget_count_for_in(
        rows: rows,
        entry: row.witness.entry,
        function: row.witness.function
      ) > 1 {
        n + 1
      } else {
        n
      }
    }
  )
}

fn declared_witness_eval_budget_duplicate_count() -> Int {
  declared_witness_eval_budget_duplicate_count_in(rows: declared_witness_eval_budgets)
}

// NO FILE-GRAIN ROW IS WRITABLE HERE, and it is refused rather than merely unused. The admission
// authority admits an empty function as a file-grain form because a CONSUMER can legitimately
// claim every witness in an entry; a BUDGET cannot, because it would be granted to cells nobody
// has authored yet. The declaration is what a reviewer reads to know which witnesses were
// admitted to a longer envelope, so it must name them.

fn declared_witness_eval_budget_well_formed(row: DeclaredWitnessEvalBudget) -> Bool {
  !(row.witness.entry == "") && !(row.witness.function == "")
}

fn declared_witness_eval_budgets_well_formed_in(
  rows: List<DeclaredWitnessEvalBudget>
) -> Bool {
  fold(
    rows,
    init: true,
    f: fn(ok, row) { ok && declared_witness_eval_budget_well_formed(row: row) }
  )
}

fn declared_witness_eval_budgets_well_formed() -> Bool {
  declared_witness_eval_budgets_well_formed_in(rows: declared_witness_eval_budgets)
}

fn declared_witness_eval_budget_requires_long_eval(row: DeclaredWitnessEvalBudget) -> Bool {
  match row.budget {
    SubstrateLongLaneEvalBudget => true
    FastLaneEvalBudget => false
  }
}

// THE ONE PROJECTION EVERY CONSUMER READS. gunbc.ci_layer_roots unions it with the long-lane BATCH
// roster to size that lane's ceiling, and v2.workflow.required_floor reads it to decide which
// claims the floor arms its long-budget deadline for. Batch membership routes EXECUTION; this
// roster only sizes a CEILING, and the two stay separable exactly because the budget no longer
// rides on an admission row.

fn witness_long_eval_budget_roster() -> List<ScheduleWitnessEntry> {
  reverse(fold(
    declared_witness_eval_budgets,
    init: Empty,
    f: fn(acc, row) {
      if declared_witness_eval_budget_requires_long_eval(row: row) {
        Cons { head: row.witness, tail: acc }
      } else {
        acc
      }
    }
  ))
}

// THE RESIDUAL IS THE FAST LANE, ANSWERED BY THE COPRODUCT AND NOT BY A BOOL. A consumer asking
// what envelope a witness declared gets an arm it must match on, so "no row" and "a fast row" are
// the same answer and neither is a missing value.

fn witness_eval_budget_for(entry: String, function: String) -> WitnessExecutionBudget {
  fold(
    declared_witness_eval_budgets,
    init: FastLaneEvalBudget,
    f: fn(acc, row) {
      if declared_witness_eval_budget_matches(row: row, entry: entry, function: function) {
        row.budget
      } else {
        acc
      }
    }
  )
}

fn witness_declares_long_eval_budget(entry: String, function: String) -> Bool {
  match witness_eval_budget_for(entry: entry, function: function) {
    SubstrateLongLaneEvalBudget => true
    FastLaneEvalBudget => false
  }
}

fn witness_long_eval_budget_roster_contains(w: ScheduleWitnessEntry) -> Bool {
  schedule_witness_entry_roster_contains(xs: witness_long_eval_budget_roster(), w: w)
}
