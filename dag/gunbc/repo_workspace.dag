module gunbc.repo_workspace

import std.types { String, List }
import std.workspace_artifact {
  WorkspaceFootprint, WorkspaceArtifact, FootprintProvenance,
  CitedUpstream, RepoTool,
  RegenerableFromSource, LocalCacheState, PerDeveloperState, HostOsMetadata,
  SessionRuntimeState, MayContainSecrets, OutsideSubstrate, SupersededAuthority
}
import extdeps.cargo { cargo_workspace_footprint }
import extdeps.cargo_tarpaulin { tarpaulin_report_footprint }
import extdeps.python { cpython_bytecode_footprint }
import extdeps.npm { node_modules_footprint }
import extdeps.tmux { pipe_pane_log_footprint }
import extdeps.os.macos { finder_metadata_footprint }
import extdeps.os.windows { explorer_thumbnail_footprint }
import extdeps.editor.jetbrains_ide { jetbrains_workspace_footprint }
import extdeps.editor.visual_studio_code { vscode_workspace_footprint }
import extdeps.editor.vim { vim_swap_footprint }
import extdeps.editor.gnu_emacs { emacs_backup_footprint }
import extdeps.dotenv { dotenv_footprint }

// THE JOIN OF THIS REPOSITORY'S WORKSPACE FOOTPRINTS. Replaced gunbc.gitignore_model +
// gunbc.gitignore_authority (one nullary variant per path, patterns restated in a central
// emit match — the shape that let seven dead allowlist rows emit for weeks, because no
// producer owned them). Here every entry is either an extdeps product's own declaration —
// onboarding a tool includes declaring what files it introduces, what they mean, and why
// they are untracked — with repo-chosen LOCATIONS passed as parameters (policy stays a
// workflow fact, §3), or a repo tool's declaration carrying its owner module by name.
// The .gitignore byte projection is derived in gunbc.gitignore_emit; the generated-artifact
// rows are a separate arm derived from gunbc.generated_artifact commit policy.

fn own_tool_footprints() -> List<WorkspaceFootprint> {
  [
    WorkspaceFootprint {
      provenance: RepoTool { display: "Codegen bin symlink", owner_module: "gunbc.repo_workspace" },
      artifacts: [
        WorkspaceArtifact { pattern: "/bin/", meaning: "symlink to target/release created by codegen", reason: RegenerableFromSource }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Generator stamp files", owner_module: "gunbc.generated_artifact" },
      artifacts: [
        WorkspaceArtifact { pattern: ".*-stamp", meaning: "producer-centric generator stamps", reason: RegenerableFromSource }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Workflow runtime state", owner_module: "v2.workflow.required_floor" },
      artifacts: [
        WorkspaceArtifact { pattern: "/.gunbc/", meaning: "local execution ledger and config", reason: SessionRuntimeState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "testgen outputs", owner_module: "v1.10_test" },
      artifacts: [
        WorkspaceArtifact { pattern: "src/v1/10_test/generated-tests/src/generated/", meaning: "tests generated by testgen; not source-of-truth", reason: RegenerableFromSource }
      ]
    },
    WorkspaceFootprint {
      provenance: CitedUpstream { display: "Claude Code session state", upstream: "code.claude.com" },
      artifacts: [
        WorkspaceArtifact { pattern: ".claude/", meaning: "per-clone agent session state", reason: SessionRuntimeState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Stage0 regeneration temp dirs", owner_module: "v1_compiler.required_regen_host" },
      artifacts: [
        WorkspaceArtifact { pattern: ".regen-sources/", meaning: "regen input snapshot", reason: RegenerableFromSource },
        WorkspaceArtifact { pattern: ".regen-output/", meaning: "regen emitted candidate", reason: RegenerableFromSource },
        WorkspaceArtifact { pattern: ".regen-generated-source-root/", meaning: "regen generated source root", reason: RegenerableFromSource },
        WorkspaceArtifact { pattern: ".freshness-check/", meaning: "staleness-check scratch tree", reason: RegenerableFromSource }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Interactive auth/session transcripts", owner_module: "gunbc.auth.credentials" },
      artifacts: [
        WorkspaceArtifact { pattern: "out.txt", meaning: "interactive auth transcript; may contain OAuth URLs or session state", reason: MayContainSecrets }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "OpenClaw workspace artifacts", owner_module: "gunbc.repo_workspace" },
      artifacts: [
        WorkspaceArtifact { pattern: "/.openclaw/", meaning: "OpenClaw control dir; the control plane lives in ~/ctrl, not this repo", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/AGENTS.md", meaning: "OpenClaw agent roster projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/HEARTBEAT.md", meaning: "OpenClaw heartbeat projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/IDENTITY.md", meaning: "OpenClaw identity projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/SOUL.md", meaning: "OpenClaw soul projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/TOOLS.md", meaning: "OpenClaw tools projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/USER.md", meaning: "OpenClaw user projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/WORKBOARD.md", meaning: "OpenClaw workboard projection", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: "/scripts/openclaw/", meaning: "OpenClaw-managed scripts dir", reason: SessionRuntimeState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "v2 compiler inspect output", owner_module: "gunbc.repo_workspace" },
      artifacts: [
        WorkspaceArtifact { pattern: ".v2-inspect", meaning: "v2 compiler inspect output", reason: SessionRuntimeState },
        WorkspaceArtifact { pattern: ".v2-inspect-errors.txt", meaning: "v2 compiler inspect error output", reason: SessionRuntimeState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "GitHub CLI local cache", owner_module: "gunbc.repo_workspace" },
      artifacts: [
        WorkspaceArtifact { pattern: ".gh-cache/", meaning: "local gh API response cache (dashboard tooling)", reason: LocalCacheState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Python local dev scripts", owner_module: "gunbc.repo_workspace" },
      artifacts: [
        WorkspaceArtifact { pattern: "*.py", meaning: "local dev tooling only; never committed to the .dag/.rs substrate", reason: OutsideSubstrate }
      ]
    },
    WorkspaceFootprint {
      provenance: CitedUpstream { display: "Generic editor backup files", upstream: "cross-editor backup convention" },
      artifacts: [
        WorkspaceArtifact { pattern: "*.bak", meaning: "editor backup copy", reason: PerDeveloperState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "claim-corpus execution-map output", owner_module: "v1_compiler.cli_run" },
      artifacts: [
        WorkspaceArtifact { pattern: ".claim-map/", meaning: "claim execution map output", reason: RegenerableFromSource },
        WorkspaceArtifact { pattern: "src/v2/test/claim/manual/sg2_scratch_probe.dag", meaning: "scratch probe written by manual claim runs", reason: SessionRuntimeState }
      ]
    },
    WorkspaceFootprint {
      provenance: RepoTool { display: "Superseded planning scratch directories", owner_module: "gunbc.plan" },
      artifacts: [
        WorkspaceArtifact { pattern: "/gunbc-planning/", meaning: "pre-plan-carrier planning scratch", reason: SupersededAuthority { canonical: "docs/plans/ (generated PlanArtifact) and DESIGN.md" } },
        WorkspaceArtifact { pattern: "/scripts/fixtures/", meaning: "pre-plan-carrier fixture scratch", reason: SupersededAuthority { canonical: "docs/plans/ (generated PlanArtifact) and DESIGN.md" } }
      ]
    }
  ]
}

// Repo policy bound to extdeps concepts: WHERE cargo's target trees and CARGO_HOME live,
// where coverage aggregates, how tmux pane logs are named — locations are this module's
// facts, the concepts are the cited modules'.
fn repo_workspace_footprints() -> List<WorkspaceFootprint> {
  concat(
    [
      cargo_workspace_footprint(target_dir_patterns: ["/target/", "/target-codex/"], cargo_home_pattern: "/.cargo-home/"),
      tarpaulin_report_footprint(coverage_output_dir_pattern: "/coverage/"),
      jetbrains_workspace_footprint(),
      vscode_workspace_footprint(),
      vim_swap_footprint(),
      emacs_backup_footprint(),
      finder_metadata_footprint(),
      explorer_thumbnail_footprint(),
      pipe_pane_log_footprint(log_pattern: "tmux-*.log"),
      dotenv_footprint(),
      node_modules_footprint(),
      cpython_bytecode_footprint()
    ],
    own_tool_footprints()
  )
}
