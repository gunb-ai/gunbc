module gunbc.stage0_cargo_manifest

import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.text { String }

data stage0_cargo_manifest_authority_note: String = "Cargo [[bin]] targets are NOT hand-listed here. stage0_cargo_toml_repo_path names the manifest; v1_compiler.cli_run.stage0_cargo_bin_repo_paths_from_manifest derives repo-relative paths by reading src/v1/stage0/Cargo.toml at witness/host execution time. gunbc.stage0_rust_source_lifecycle_scaffold joins cargo paths only through that host-derived surface — a manual row list is forbidden (operator rework 2026-07-29)."

data stage0_cargo_toml_repo_path: String = "src/v1/stage0/Cargo.toml"

data stage0_package_root: String = "src/v1/stage0/"

data stage0_cargo_bin_repo_paths_from_manifest_ref: DeclarationRef = DeclarationRef {
  module_path: "v1_compiler.cli_run",
  decl_name: "stage0_cargo_bin_repo_paths_from_manifest",
  field: WholeDeclaration
}
