module gunbc.stage0_cargo_manifest

import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.text { String }

data stage0_cargo_manifest_authority_note: String = "Cargo [[bin]] targets are NOT hand-listed here. stage0_cargo_toml_repo_path names the manifest file; repo-relative bin paths are supplied only by the host observation boundary (follow-on PR B) with typed ManifestParseRefused — never integer conclusions or manual rows in .dag."

data stage0_cargo_toml_repo_path: String = "src/v1/stage0/Cargo.toml"

data stage0_package_root: String = "src/v1/stage0/"

data stage0_cargo_bin_paths_observation_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.stage0_rust_host_observation",
  decl_name: "stage0_cargo_bin_repo_paths_observed",
  field: WholeDeclaration
}
