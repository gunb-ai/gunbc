module gunbc.demo.semantic_system_readout

import std.types { String, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import product.compute_board.emission_entry {
  BoardEmission,
  BoardEmitted,
  BoardArticleNotAdmitted,
  BoardTargetRefused,
  emit_verilog,
  emit_spice,
  emit_ngspice_run,
  emit_pin_constraints,
}
import gunbc.generated_artifact { WitnessFloorYamlArtifact, artifact_directory }
import gunbc.generated_artifact_observation {
  observe_directory_listings,
  observe_generated_artifact_with,
}
import gunbc.generated_artifact_assessment {
  GeneratedArtifactObserved,
  GeneratedArtifactCommittedAbsent,
  GeneratedArtifactObservationRefused,
}

// A READOUT, NOT AN AUTHORITY. Every verdict below is computed by calling the producer or witness
// that already owns the claim; this module restates no expected bytes, no expected outcome and no
// count. What it adds is only the arrangement a reader sees and the explicit standing of each line:
// a live verdict, a recorded external-tool run joined to today's output, or a frontier that is not
// claimed. The frontier arm has no verdict field, so an unclaimed capability cannot be printed as
// passing.
//
// ReadoutRefused IS A LINE WHOSE QUESTION COULD NOT BE ANSWERED AT ALL, which is a third thing and
// not a failing verdict. A host read that refuses says nothing about the subject, so folding it into
// LiveVerdict { holds: false } would report drift on the strength of our own bookkeeping failing --
// the error gunbc.generated_artifact_observation exists to prevent. It fails the run like a FAIL,
// and it prints under its own tag carrying the cause, so the two are never confused.
//
// THIS PARAGRAPH SITS HERE RATHER THAN BESIDE THE ARM IT DESCRIBES, and the move was forced: an
// earlier revision put it between the arms, where DESIGN section 4c admits no annotation at all.
// Only module-item grain is modeled, so the parse phase refused it five times -- once per line --
// and a local `gunbc run` over this entry accepted the same file, because that route never runs the
// phase that enforces the grain.
type ReadoutStanding
  = LiveVerdict { holds: Bool }
  | RecordedRunJoined { inputs_match_today: Bool }
  | NotClaimed
  | MechanismNote
  | ReadoutRefused { cause: String }

type ReadoutLine {
  standing: ReadoutStanding
  text: String
}

type ReadoutSection {
  title: String
  lines: List<ReadoutLine>
}

fn live(text: String, holds: Bool) -> ReadoutLine {
  ReadoutLine { standing: LiveVerdict { holds: holds }, text: text }
}

fn note(text: String) -> ReadoutLine {
  ReadoutLine { standing: MechanismNote, text: text }
}

fn open(text: String) -> ReadoutLine {
  ReadoutLine { standing: NotClaimed, text: text }
}

fn recorded(text: String, joined: Bool) -> ReadoutLine {
  ReadoutLine { standing: RecordedRunJoined { inputs_match_today: joined }, text: text }
}

fn refused(text: String, cause: String) -> ReadoutLine {
  ReadoutLine { standing: ReadoutRefused { cause: cause }, text: text }
}

fn emitted<R>(e: BoardEmission<R>) -> Bool {
  match e {
    BoardEmitted { source: _ } => true
    BoardArticleNotAdmitted { causes: _ } => false
    BoardTargetRefused { cause: _ } => false
  }
}

// THE WHOLE QUESTION IS ALREADY OWNED, so this asks it rather than re-asking the filesystem. An
// earlier revision of this line read the committed path itself and compared `.content` to the
// generated bytes, which took the transport's content channel while ignoring success and error:
// an absent, unreadable or permission-denied workflow file rendered as a DRIFT verdict, which is a
// claim about the repository established from the failure of our own read. gunbc
// .generated_artifact_observation folds both channels through filesystem_read_outcome, generates
// the adorned bytes through the same boundary, and returns the three states that are actually
// distinguishable. Each maps to the standing that tells the truth about what was learned.
data workflow_line_text: String = "required witness workflow equals its .dag projection"

// THE MAPPING IS SPLIT FROM THE OBSERVATION, so a claim can discriminate it at ONE INTERFACE. This
// function decides what an observation MEANS for the readout and reaches nothing: hand it the three
// arms and it yields PASS, REFUSED-absent and REFUSED-unreadable. DESIGN section 3's standing rule
// asks for exactly this shape -- a witness's inputs belong at the boundary as supplied values rather
// than as the output of executing the layers beneath it -- and the measurement says the same thing
// in numbers: the live claims that folded observation and mapping together cost 383k to 1,225k eval
// steps to inspect which arm came back, which is the rule's own tell (a claim whose evaluation is
// dominated by one call whose RESULT SHAPE is all it inspects).
//
// WHAT THIS SPLIT MAY NOT DO IS REMOVE THE LAST EXECUTION OF THE REAL PATH, which the same rule
// states and which is the whole reason `workflow_line` below still exists and is still claimed. The
// supplied-arm claims establish the mapping; the live claim establishes that the real observer
// reaches it. Neither substitutes for the other.
fn workflow_line_for(observation: GeneratedArtifactObservation) -> ReadoutLine {
  match observation {
    GeneratedArtifactObserved { artifact: _, path: _, generated_content: g, committed_content: c, extra_validation: _ } =>
      live(text: workflow_line_text, holds: g == c)
    GeneratedArtifactCommittedAbsent { artifact: _, path: p, detail: d } =>
      refused(text: workflow_line_text, cause: concat(concat("committed artifact absent: ", p), concat(" — ", d)))
    GeneratedArtifactObservationRefused { artifact: _, path: p, cause: c } =>
      refused(text: workflow_line_text, cause: concat(concat("observation refused: ", p), concat(" — ", c)))
  }
}

// THE LIVE HALF, AND IT IS DELIBERATELY THIN: take the observation, delegate the meaning. Everything
// expensive is on this side of the seam -- the directory listing, the committed read folded through
// filesystem_read_outcome, and the adorned projection of the whole workflow -- and none of it is
// re-executed by a claim that only needs to know what an arm means.
fn workflow_line() -> ReadoutLine {
  let a = WitnessFloorYamlArtifact
  let rows = observe_directory_listings(directories: [artifact_directory(a: a)])
  workflow_line_for(observation: observe_generated_artifact_with(a: a, rows: rows))
}

// THE READOUT CALLS PRODUCERS, NEVER CLAIMS. It once read thirteen claim functions from five witness
// modules for their verdicts -- the layer inversion DESIGN section 3 names with this module as its
// receipt -- and the test-reference wall (v1.compiler.compile test_reference_diagnostics) now refuses
// that reach outright. Those capabilities are established by their own claims on the floor, so the
// readout keeps only the lines a production call answers.
fn readout_sections() -> List<ReadoutSection> {
  [
    ReadoutSection {
      title: "SEMANTIC BOARD ARTICLE",
      lines: [
        live(text: "Verilog module emitted from the article", holds: emitted(e: emit_verilog())),
        live(text: "SPICE circuit emitted from the article", holds: emitted(e: emit_spice())),
        live(text: "ngspice run deck emitted from the article", holds: emitted(e: emit_ngspice_run())),
        live(text: "pin constraints emitted from the article", holds: emitted(e: emit_pin_constraints())),
        open(text: "emitted Verilog bytes lexed back into the semantic model"),
      ],
    },
    ReadoutSection {
      title: "DOGFOODING",
      lines: [
        workflow_line(),
      ],
    },
    ReadoutSection {
      title: "NEXT SEMANTIC FRONTIER",
      lines: [
        open(text: "Rust expression syntax reconstructed compositionally into the semantic graph"),
        open(text: "that recovered graph projected into the board's Verilog path"),
        open(text: "live external-tool execution from this entry"),
      ],
    },
  ]
}

fn standing_tag(s: ReadoutStanding) -> String {
  match s {
    LiveVerdict { holds: h } => if h { "  PASS      " } else { "  FAIL      " }
    RecordedRunJoined { inputs_match_today: j } => if j { "  RECORDED  " } else { "  STALE     " }
    NotClaimed => "  OPEN      "
    MechanismNote => "  NOTE      "
    ReadoutRefused { cause: _ } => "  REFUSED   "
  }
}

fn standing_detail(s: ReadoutStanding) -> String {
  match s {
    ReadoutRefused { cause: c } => concat(" — ", c)
    LiveVerdict { holds: _ } => ""
    RecordedRunJoined { inputs_match_today: _ } => ""
    NotClaimed => ""
    MechanismNote => ""
  }
}

fn line_fails(l: ReadoutLine) -> Bool {
  match l.standing {
    LiveVerdict { holds: h } => !h
    RecordedRunJoined { inputs_match_today: j } => !j
    NotClaimed => false
    MechanismNote => false
    ReadoutRefused { cause: _ } => true
  }
}

fn render_section(s: ReadoutSection) -> String {
  fold(s.lines, init: concat(s.title, "\n"), f: fn(acc, l) {
    concat(
      acc,
      concat(
        standing_tag(s: l.standing),
        concat(l.text, concat(standing_detail(s: l.standing), "\n"))
      )
    )
  })
}

fn render(sections: List<ReadoutSection>) -> String {
  fold(sections, init: "ONE AUTHORITY, MANY REALIZATIONS\n\n", f: fn(acc, s) {
    concat(acc, concat(render_section(s: s), "\n"))
  })
}

fn any_line_fails(sections: List<ReadoutSection>) -> Bool {
  fold(sections, init: false, f: fn(acc, s) {
    fold(s.lines, init: acc, f: fn(inner, l) { inner || line_fails(l: l) })
  })
}

data readout_path: String = "target/demo/semantic_system_readout.txt"

// The exit code is the readout's verdict: a FAIL or STALE line fails the run, so the report cannot
// be green while any line it prints is not. The text goes to readout_path because a run's only
// other text channel is a failure reason.
fn render_demo() -> ProcessExit {
  let sections = readout_sections()
  let text = render(sections: sections)
  let w = Filesystem.Write(path: readout_path, content: text)
  if !w.success {
    exit_failure(reason: concat("demo readout unwritable: ", w.error))
  } else {
    if any_line_fails(sections: sections) {
      exit_failure(reason: text)
    } else {
      ExitSuccess
    }
  }
}
