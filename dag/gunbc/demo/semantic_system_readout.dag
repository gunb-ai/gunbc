import extdeps.filesystem.filesystem_io { Filesystem }
import v2.test.claim.translate_underived_refusal { cross_language_compile_python_to_typescript_round_trip_holds }
import v2.test.claim.verilog_interlock_emission_test {
  w_interlock_emits_expected_bytes_through_the_generic_fold,
  w_expression_perturbation_changes_the_bytes,
  w_token_spine_reads_back_to_the_same_emitted_node,
}
import v2.test.long.accumulator_copy_compile_gate {
  gate_red_quadratic_rejects,
  gate_green_identity_accepts_clean,
  gate_refusal_ledger_counted_not_gating,
}
import test.claim.compute_board_admission_witness { w_a_coherent_fixture_is_admitted }
import test.claim.compute_board_simulation_receipt_witness {
  w_the_executed_verilog_is_what_the_product_emits_today,
  w_the_executed_deck_is_what_the_product_emits_today,
  w_the_placed_constraints_are_what_the_product_emits_today,
  w_every_recorded_run_was_accepted,
  w_every_recorded_implementation_run_was_accepted,
}
import product.compute_board.emission_entry {
  BoardEmission,
  BoardEmitted,
  BoardArticleNotAdmitted,
  BoardTargetRefused,
  emit_verilog,
  emit_spice,
  emit_ngspice_run,
  emit_pin_constraints,
}
import gunbc.generated_artifact { WitnessFloorYamlArtifact, artifact_path }
import gunbc.generated_artifact_emit {
  ArtifactGenerated,
  ArtifactGenerationRefused,
  artifact_generate,
}

// A READOUT, NOT AN AUTHORITY. Every verdict below is computed by calling the producer or witness
// that already owns the claim; this module restates no expected bytes, no expected outcome and no
// count. What it adds is only the arrangement a reader sees and the explicit standing of each line:
// a live verdict, a recorded external-tool run joined to today's output, or a frontier that is not
// claimed. The frontier arm has no verdict field, so an unclaimed capability cannot be printed as
// passing.
type ReadoutStanding
  = LiveVerdict { holds: Bool }
  | RecordedRunJoined { inputs_match_today: Bool }
  | NotClaimed
  | MechanismNote

type ReadoutLine {
  standing: ReadoutStanding
  text: String
}

type ReadoutSection {
  title: String
  lines: List<ReadoutLine>
}

fn live(text: String, holds: Bool) -> ReadoutLine {
  ReadoutLine { standing: LiveVerdict { holds: holds }, text: text }
}

fn note(text: String) -> ReadoutLine {
  ReadoutLine { standing: MechanismNote, text: text }
}

fn open(text: String) -> ReadoutLine {
  ReadoutLine { standing: NotClaimed, text: text }
}

fn recorded(text: String, joined: Bool) -> ReadoutLine {
  ReadoutLine { standing: RecordedRunJoined { inputs_match_today: joined }, text: text }
}

fn emitted<R>(e: BoardEmission<R>) -> Bool {
  match e {
    BoardEmitted { source: _ } => true
    BoardArticleNotAdmitted { causes: _ } => false
    BoardTargetRefused { cause: _ } => false
  }
}

// The committed bytes are the ADORNED projection (provenance header + generator output), so the
// comparison goes through artifact_generate, the one bytes boundary that owns that composition, and
// the path comes from the registry rather than a literal here.
fn workflow_is_generated_from_dag() -> Bool {
  match artifact_generate(a: WitnessFloorYamlArtifact) {
    ArtifactGenerationRefused { reason: _ } => false
    ArtifactGenerated { content: expected } =>
      Filesystem.Read(path: artifact_path(a: WitnessFloorYamlArtifact)).content == expected
  }
}

fn readout_sections() -> List<ReadoutSection> {
  [
    ReadoutSection {
      title: "BOUNDED LANGUAGE ADAPTER",
      lines: [
        live(text: "Python add parsed and emitted byte-exactly as TypeScript", holds: cross_language_compile_python_to_typescript_round_trip_holds()),
        note(text: "whole-function grammar-row selection over one add profile; compositional ingestion not claimed"),
      ],
    },
    ReadoutSection {
      title: "SEMANTIC BOARD ARTICLE",
      lines: [
        live(text: "board article admitted", holds: w_a_coherent_fixture_is_admitted()),
        live(text: "Verilog emitted through the generic grammar-relation fold", holds: w_interlock_emits_expected_bytes_through_the_generic_fold()),
        live(text: "perturbing the modeled expression changes the emitted circuit", holds: w_expression_perturbation_changes_the_bytes()),
        live(text: "Verilog token spine reads back to the same emitted node", holds: w_token_spine_reads_back_to_the_same_emitted_node()),
        live(text: "Verilog module emitted from the article", holds: emitted(e: emit_verilog())),
        live(text: "SPICE circuit emitted from the article", holds: emitted(e: emit_spice())),
        live(text: "ngspice run deck emitted from the article", holds: emitted(e: emit_ngspice_run())),
        live(text: "pin constraints emitted from the article", holds: emitted(e: emit_pin_constraints())),
        open(text: "emitted Verilog bytes lexed back into the semantic model"),
      ],
    },
    ReadoutSection {
      title: "ENFORCEMENT BEFORE REALIZATION",
      lines: [
        live(text: "clean fold admitted with no diagnostics", holds: gate_green_identity_accepts_clean()),
        live(text: "copied-accumulator quadratic fold refused", holds: gate_red_quadratic_rejects()),
        live(text: "unregistered combiner admitted but ledgered as unclassified", holds: gate_refusal_ledger_counted_not_gating()),
      ],
    },
    ReadoutSection {
      title: "DOGFOODING",
      lines: [
        live(text: "required witness workflow equals its .dag projection", holds: workflow_is_generated_from_dag()),
      ],
    },
    ReadoutSection {
      title: "EXTERNAL TOOL RECEIPTS (recorded runs, not rerun here)",
      lines: [
        recorded(text: "Icarus and ngspice runs accepted; their inputs are today's Verilog and deck", joined: w_every_recorded_run_was_accepted() && w_the_executed_verilog_is_what_the_product_emits_today() && w_the_executed_deck_is_what_the_product_emits_today()),
        recorded(text: "Yosys / nextpnr / icepack runs accepted; their pin input is today's constraints", joined: w_every_recorded_implementation_run_was_accepted() && w_the_placed_constraints_are_what_the_product_emits_today()),
      ],
    },
    ReadoutSection {
      title: "NEXT SEMANTIC FRONTIER",
      lines: [
        open(text: "Rust expression syntax reconstructed compositionally into the semantic graph"),
        open(text: "that recovered graph projected into the board's Verilog path"),
        open(text: "live external-tool execution from this entry"),
      ],
    },
  ]
}

fn standing_tag(s: ReadoutStanding) -> String {
  match s {
    LiveVerdict { holds: h } => if h { "  PASS      " } else { "  FAIL      " }
    RecordedRunJoined { inputs_match_today: j } => if j { "  RECORDED  " } else { "  STALE     " }
    NotClaimed => "  OPEN      "
    MechanismNote => "  NOTE      "
  }
}

fn line_fails(l: ReadoutLine) -> Bool {
  match l.standing {
    LiveVerdict { holds: h } => !h
    RecordedRunJoined { inputs_match_today: j } => !j
    NotClaimed => false
    MechanismNote => false
  }
}

fn render_section(s: ReadoutSection) -> String {
  fold(s.lines, init: concat(s.title, "\n"), f: fn(acc, l) {
    concat(acc, concat(standing_tag(s: l.standing), concat(l.text, "\n")))
  })
}

fn render(sections: List<ReadoutSection>) -> String {
  fold(sections, init: "ONE AUTHORITY, MANY REALIZATIONS\n\n", f: fn(acc, s) {
    concat(acc, concat(render_section(s: s), "\n"))
  })
}

fn any_line_fails(sections: List<ReadoutSection>) -> Bool {
  fold(sections, init: false, f: fn(acc, s) {
    fold(s.lines, init: acc, f: fn(inner, l) { inner || line_fails(l: l) })
  })
}

data readout_path: String = "target/demo/semantic_system_readout.txt"

// The exit code is the readout's verdict: a FAIL or STALE line fails the run, so the report cannot
// be green while any line it prints is not. The text goes to readout_path because a run's only
// other text channel is a failure reason.
fn render_demo() -> ProcessExit {
  let sections = readout_sections()
  let text = render(sections: sections)
  let w = Filesystem.Write(path: readout_path, content: text)
  if !w.success {
    exit_failure(reason: concat("demo readout unwritable: ", w.error))
  } else {
    if any_line_fails(sections: sections) {
      exit_failure(reason: text)
    } else {
      ExitSuccess
    }
  }
}
