module gunbc.host_converge_realize

type ConvergeKnobInterpretVerdict =
    KnobUnimplemented { knob_name: String, target_kind: String, reason: String }
  | KnobEffect { knob_name: String, effect_script: String }

fn converge_target_kind_label(t: gunbc.host_converge.ConvergeTarget) -> String {
  match t {
    SliceProperty { unit: _, property: _, apply_value: _, expected_effective: _ } => "SliceProperty"
    PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: _, bytes_value: _ } => "PerSlotMemoryCap"
    RunnerWidth { instance_glob: _ } => "RunnerWidth"
    JobserverTokens { env_file: _, env_key: _, service_unit: _ } => "JobserverTokens"
    VerifyOnlyCap { slice_unit: _, property: _ } => "VerifyOnlyCap"
    GunbcPinnedTree {
      gunbc_root_env_key: _,
      gunbc_root_path: _,
      dag_root: _,
      ctrl_checkout_path: _,
      binary: _,
      pin_read_script: _,
      green_place_marker: _,
      live_apply: _,
    } => "GunbcPinnedTree"
    CodexRuntimeBundle { host_identity: _ } => "CodexRuntimeBundle"
  }
}

data converge_knob_unimplemented_reason_prefix: String = "host_converge_realize: ConvergeKnob interpreter frontier — fail-closed Unimplemented per knob target; no free-form imperative arm (host-effect Phase D / shell-emission slice 2)"

fn converge_knob_unimplemented_reason(knob: gunbc.host_converge.ConvergeKnob) -> String {
  concat(
    concat(
      concat(
        concat(converge_knob_unimplemented_reason_prefix, " ["),
        converge_target_kind_label(t: knob.target)
      ),
      concat(concat("/", knob.name), "]")
    ),
    " — typed extdeps.systemd/oomd read+write not yet wired for this knob arm"
  )
}

fn interpret_converge_knob(knob: gunbc.host_converge.ConvergeKnob) -> ConvergeKnobInterpretVerdict {
  match knob.target {
    PerSlotMemoryCap { dropin_path: dp, instance_glob: _, property: prop, bytes_value: bv } =>
      KnobEffect {
        knob_name: knob.name,
        effect_script: gunbc.host_axis_caps.cap_upsert_script(m: gunbc.host_axis_caps.desired_cap_member(
          dropin_path: dp as std.types.NonEmptyStr,
          property: prop as std.types.NonEmptyStr,
          bytes_value: bv as std.types.NonEmptyStr,
        )),
      }
    _ =>
      KnobUnimplemented {
        knob_name: knob.name,
        target_kind: converge_target_kind_label(t: knob.target),
        reason: converge_knob_unimplemented_reason(knob: knob),
      }
  }
}

type ConvergeHostInterpretResult =
    ConvergeHostRefused { reason: String }
  | ConvergeHostInterpreted { knob_count: Int, stdout: String }

data converge_host_no_knobs_reason: String = "host_converge_realize: HostConverge has zero knobs; fail-closed — refusing fabricated ConvergePlanApplied without knob work"

data converge_host_multi_knob_concatenation_finding: std.disposition.Disposition = std.disposition.Terminal {
  reason: "FINDING (2026-08-19, surfaced while investigating gunbc.fleet_converge_cli converge_cli_applied_knob_count). INVALID STATE: interpret_host_converge folded 2+ KnobEffect scripts into one concatenated shell body and realize_converge_in_process (host_effect_realize.dag) reported Converged on that one script's whole-script exit code; cap_upsert_script (host_axis_caps.dag) fragments carry no set -e / && chaining, so the exit code reflects only the LAST fragment's command, not an AND of all of them. HARM: a ConvergeCliReceipt/ConvergePlanApplied that a later reader trusts instead of re-observing would claim convergence achieved while an earlier knob's command silently failed. RUNG: below the floor — silent wrongness, outside the guarantee ladder, forbidden outright (DESIGN §4b/§5) — if reached. MEASURED (not sampled): today this is unreachable for every host in fleet_converge_policy, because gunbc_pinned_tree_knobs is concatenated FIRST into every HostConverge.knobs list and is a GunbcPinnedTree-target knob that interpret_converge_knob does not implement, so the fail-closed all-or-nothing fold in interpret_host_converge always refuses on knob #1 before reaching any PerSlotMemoryCap knob; no knob-ordering fix rescues this, every real host also independently carries other unimplemented-target knobs later in the same list. CEILING: decidable, gated on the substrate migration this lane exists to do (typed per-knob effects with per-knob outcomes) — a wall after grounding, not a ratchet. REPAIR SHAPE, deliberately not set -e/&&: hardening the concatenated script would invest in the shell path this lane exists to delete and cement multi-knob concatenation as a supported shape. Instead this module refuses multi-knob concatenation outright (below), typed/located/counted, the moment a second KnobEffect would be folded into one script — so the day a future author gives a second ConvergeTarget a real interpret_converge_knob arm, the fold refuses loudly instead of silently concatenating. NEXT TRIGGER: this refusal, and the concatenation it guards, both dissolve together when interpret_host_converge is replaced by typed per-knob effects with per-knob outcomes. KNOWN LIMITATION: ConvergeHostRefused carries only reason: String, so this refusal's cause collapses into the same prose field as KnobUnimplemented — no caller can branch on why a host refused, the two causes are one value to every consumer, and the discriminating witness for this refusal can only assert by string_contains on refusal prose that no rule prevents a future edit from rewording; a typed refusal-cause variant (multi-knob concatenation vs. unimplemented target, each counted) is the natural next increment, deferred here rather than turning this landed wall into an open branch."
}

data converge_host_multi_knob_concatenation_refused_reason_prefix: String = "host_converge_realize: multi-knob script concatenation refused — see converge_host_multi_knob_concatenation_finding for the full invalid-state/harm/rung/ceiling/trigger record"

fn interpret_host_converge(host_converge: gunbc.host_converge.HostConverge) -> ConvergeHostInterpretResult {
  if host_converge.knobs.length() == 0 {
    ConvergeHostRefused { reason: converge_host_no_knobs_reason }
  } else {
    fold(
      host_converge.knobs,
      init: ConvergeHostInterpreted { knob_count: 0, stdout: "" },
      f: fn(acc, knob) {
        match acc {
          ConvergeHostRefused { reason: _ } => acc
          ConvergeHostInterpreted { knob_count: n, stdout: out } =>
            match interpret_converge_knob(knob: knob) {
              KnobUnimplemented { knob_name: name, target_kind: _, reason: why } =>
                ConvergeHostRefused {
                  reason: concat(
                    concat(concat(why, " (host="), host_converge.identity as String),
                    concat(concat(", slice=", gunbc.host_converge.converge_slice_label(s: knob.slice)), concat(", knob=", name))
                  ),
                }
              KnobEffect { knob_name: name, effect_script: s } =>
                if n >= 1 {
                  ConvergeHostRefused {
                    reason: concat(
                      concat(concat(converge_host_multi_knob_concatenation_refused_reason_prefix, " (host="), host_converge.identity as String),
                      concat(concat(", slice=", gunbc.host_converge.converge_slice_label(s: knob.slice)), concat(", knob=", name))
                    ),
                  }
                } else {
                  ConvergeHostInterpreted { knob_count: n + 1, stdout: concat(out, s) }
                }
            }
        }
      }
    )
  }
}

fn converge_host_interpret_refused(r: ConvergeHostInterpretResult) -> Bool {
  match r {
    ConvergeHostRefused { reason: _ } => true
    ConvergeHostInterpreted { knob_count: _, stdout: _ } => false
  }
}
