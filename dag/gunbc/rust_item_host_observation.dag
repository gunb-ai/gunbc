import gunbc.repo_identity { gunbc_merge_target_ref }
import gunbc.generated_artifact { committed_generated_artifact_paths }
import gunbc.stage0_rust_host_observation {
  EmitPopulationConfirmed,
  EmitPopulationEvidence,
  EmitPopulationUnobserved,
  observe_emit_population_evidence
}
import gunbc.rust_item_identity {
  RustImplBlock,
  RustImplMethod,
  RustItemIdentity,
  rust_item_identity_key,
  rust_item_identity_qualified_name
}
import gunbc.rust_item_scan {
  RustFileScan,
