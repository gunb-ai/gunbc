module gunbc.srv3_os_install_reconcile_record_approval


data srv3_os_install_reconcile_record_approval_shell_runner_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.srv3_host_effect_script",
    decl_name: "srv3_host_effect_script_dissolution_trigger",
    field: WholeDeclaration,
  }
}

func srv3_os_install_record_boot_once_approval() -> ProcessExit {
  srv3_reconciliation_to_process_exit(
    r: srv3_durable_approval_grant_record_apply(),
    failure_prefix: "srv3-install-record-approval: ",
  )
}
