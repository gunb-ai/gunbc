module gunbc.runner.runner_jit_admission

import std.types { String, NonEmptyStr, Bool }
import std.disposition { Disposition, SingleAuthority }
import extdeps.github.actions_jit_runner {
  JitMintAdmittedRequestField, JitMintName, JitMintLabels, JitMintRunnerGroupId, JitMintWorkFolder,
  org_generate_jitconfig_path,
}
import extdeps.github.org_admin_auth { github_app_installation_access_token_url }
import gunbc.auth.github_apps {
  gunbai_ci_declared, gunbai_ci_declared_installation_id,
}

data runner_jit_admission_disposition: Disposition = SingleAuthority

// THIS MODULE IS THE AXIS-DEFINITION AUTHORITY for the six host-printed admission names
// (signature, expiry, replay, unit-binding, boot-binding, attempt-binding). The names originated as
// a marker string on a capture; they are not defined in extdeps.github.actions_jit_runner because
// that module owns GitHub's mint shape, and GitHub does not name these axes. Defining them here is
// what lets each one close as required, deferred, or dissolved, instead of remaining a quote of a
// log line.
//
// THE MINT SURFACE IS A TWO-STEP GITHUB PATH, not a host HTTP server and not a parsed blob:
//   1. POST /app/installations/{installation_id}/access_tokens, cited by
//      extdeps.github.org_admin_auth.github_app_installation_access_token_url, minted from the
//      gunbai-ci App key (gunbc.auth.github_apps.gunbai_ci_declared).
//   2. POST /orgs/{org}/actions/runners/generate-jitconfig with that installation token, path from
//      extdeps.github.actions_jit_runner.org_generate_jitconfig_path.
// What step 2 accepts as a body is the four JitMintAdmittedRequestField rows and nothing else.
// encoded_jit_config is opaque; a host cannot check binding axes by decoding it.

type JitAdmissionAxis
  = SignatureAxis
  | ExpiryAxis
  | ReplayAxis
  | UnitBindingAxis
  | BootBindingAxis
  | AttemptBindingAxis

type JitAdmissionChecker
  = HostEnvelopeNonemptyAndFresh
  | GitHubMintRequestField { field: JitMintAdmittedRequestField }

type JitAdmissionAxisStanding
  = AxisRequired { checker: JitAdmissionChecker }
  | AxisDeferred { trigger: NonEmptyStr }
  | AxisDissolvedInto { into: JitAdmissionAxis }
  | AxisDissolvedIntoUpstreamMint { reason: NonEmptyStr }

fn gunbai_ci_installation_token_url() -> String {
  github_app_installation_access_token_url(
    installation_id: gunbai_ci_declared_installation_id.value,
  )
}

fn gunbai_org_generate_jitconfig_path() -> String {
  org_generate_jitconfig_path(org_login: gunbai_ci_declared.owner_login)
}

fn jit_admission_axis_standing(axis: JitAdmissionAxis) -> JitAdmissionAxisStanding {
  match axis {
    SignatureAxis => AxisRequired { checker: HostEnvelopeNonemptyAndFresh }
    ExpiryAxis => AxisRequired { checker: HostEnvelopeNonemptyAndFresh }
    ReplayAxis => AxisDissolvedIntoUpstreamMint {
      reason: "generate-jitconfig creates one runner identity; a second mint of the same name is HTTP 409, and the blob is not a reusable secret",
    }
    UnitBindingAxis => AxisDissolvedInto { into: AttemptBindingAxis }
    BootBindingAxis => AxisDissolvedInto { into: AttemptBindingAxis }
    AttemptBindingAxis => AxisRequired {
      checker: GitHubMintRequestField { field: JitMintName },
    }
  }
}

fn axis_standing_is_deferred(standing: JitAdmissionAxisStanding) -> Bool {
  match standing {
    AxisDeferred { trigger: _ } => true
    AxisRequired { checker: _ } => false
    AxisDissolvedInto { into: _ } => false
    AxisDissolvedIntoUpstreamMint { reason: _ } => false
  }
}

fn jit_admission_axis_is_deferred(axis: JitAdmissionAxis) -> Bool {
  axis_standing_is_deferred(standing: jit_admission_axis_standing(axis: axis))
}

fn attempt_binding_is_required_on_mint_name() -> Bool {
  match jit_admission_axis_standing(axis: AttemptBindingAxis) {
    AxisRequired { checker: GitHubMintRequestField { field: JitMintName } } => true
    AxisRequired { checker: _ } => false
    AxisDeferred { trigger: _ } => false
    AxisDissolvedInto { into: _ } => false
    AxisDissolvedIntoUpstreamMint { reason: _ } => false
  }
}

// WHAT EACH AXIS NEEDS FROM THE MINT SURFACE, so a live read is a field grant, not "read the mint".
// Cited from the six-axis table in the displacement analysis (gunbc#10823): binding axes cannot be
// checked by parsing the opaque blob; they are mint-side obligations if they are obligations at all.
// A host can only compare against what the minter recorded.
type MintSurfaceFact
  = InstallationHoldsRunnersWrite
  | JitconfigResponseHasExpiresAtField
  | JitconfigResponseCarriesRunnerId
  | DuplicateNameConflicts
  | EncodedBlobIsOpaque
  | RequestNameIsPersistedRunnerIdentity
  | RequestAdmitsLabels
  | RequestHasNoHostField
  | RequestHasNoBootField

fn mint_fact_needed(axis: JitAdmissionAxis, fact: MintSurfaceFact) -> Bool {
  match axis {
    SignatureAxis => match fact {
      EncodedBlobIsOpaque => true
      InstallationHoldsRunnersWrite => true
      JitconfigResponseHasExpiresAtField => false
      JitconfigResponseCarriesRunnerId => false
      DuplicateNameConflicts => false
      RequestNameIsPersistedRunnerIdentity => false
      RequestAdmitsLabels => false
      RequestHasNoHostField => false
      RequestHasNoBootField => false
    }
    ExpiryAxis => match fact {
      JitconfigResponseHasExpiresAtField => true
      EncodedBlobIsOpaque => false
      InstallationHoldsRunnersWrite => false
      JitconfigResponseCarriesRunnerId => false
      DuplicateNameConflicts => false
      RequestNameIsPersistedRunnerIdentity => false
      RequestAdmitsLabels => false
      RequestHasNoHostField => false
      RequestHasNoBootField => false
    }
    ReplayAxis => match fact {
      DuplicateNameConflicts => true
      JitconfigResponseCarriesRunnerId => true
      EncodedBlobIsOpaque => false
      InstallationHoldsRunnersWrite => false
      JitconfigResponseHasExpiresAtField => false
      RequestNameIsPersistedRunnerIdentity => false
      RequestAdmitsLabels => false
      RequestHasNoHostField => false
      RequestHasNoBootField => false
    }
    UnitBindingAxis => match fact {
      RequestHasNoHostField => true
      RequestNameIsPersistedRunnerIdentity => true
      EncodedBlobIsOpaque => true
      InstallationHoldsRunnersWrite => false
      JitconfigResponseHasExpiresAtField => false
      JitconfigResponseCarriesRunnerId => false
      DuplicateNameConflicts => false
      RequestAdmitsLabels => false
      RequestHasNoBootField => false
    }
    BootBindingAxis => match fact {
      RequestHasNoBootField => true
      EncodedBlobIsOpaque => true
      InstallationHoldsRunnersWrite => false
      JitconfigResponseHasExpiresAtField => false
      JitconfigResponseCarriesRunnerId => false
      DuplicateNameConflicts => false
      RequestNameIsPersistedRunnerIdentity => false
      RequestAdmitsLabels => false
      RequestHasNoHostField => false
    }
    AttemptBindingAxis => match fact {
      RequestNameIsPersistedRunnerIdentity => true
      RequestAdmitsLabels => true
      EncodedBlobIsOpaque => true
      InstallationHoldsRunnersWrite => false
      JitconfigResponseHasExpiresAtField => false
      JitconfigResponseCarriesRunnerId => false
      DuplicateNameConflicts => false
      RequestHasNoHostField => false
      RequestHasNoBootField => false
    }
  }
}

fn mint_field_can_carry_attempt_binding(field: JitMintAdmittedRequestField) -> Bool {
  match field {
    JitMintName => true
    JitMintLabels => true
    JitMintRunnerGroupId => false
    JitMintWorkFolder => false
  }
}

// encoded_jit_config CONTENTS ARE OUTSIDE THE MODELED GUARANTEE (DESIGN §4b adjacent column),
// not an unmet observation. The mint does not expose the blob's interior; no token will. Filing
// that opacity as coverage is what would talk a later lane into decoding the blob. Signature,
// unit, boot and attempt already route around it (host envelope; dissolve into attempt; mint name).
type EncodedJitConfigInteriorStanding
  = OutsideTheModeledGuaranteeDeclaredBoundary

data encoded_jit_config_interior: EncodedJitConfigInteriorStanding =
  OutsideTheModeledGuaranteeDeclaredBoundary

type AxisMintObservability
  = MintObservableCoverage { question: MintSurfaceCoverageQuestion }
  | MintUnobservableDeclaredBoundary

type MintSurfaceCoverageQuestion
  = GenerateJitconfig201ExpiresAtPresence
  | ReplayRunnerIdAndDuplicateName409

fn axis_mint_observability(axis: JitAdmissionAxis) -> AxisMintObservability {
  match axis {
    ExpiryAxis => MintObservableCoverage { question: GenerateJitconfig201ExpiresAtPresence }
    ReplayAxis => MintObservableCoverage { question: ReplayRunnerIdAndDuplicateName409 }
    SignatureAxis => MintUnobservableDeclaredBoundary
    UnitBindingAxis => MintUnobservableDeclaredBoundary
    BootBindingAxis => MintUnobservableDeclaredBoundary
    AttemptBindingAxis => MintUnobservableDeclaredBoundary
  }
}

fn axis_awaits_live_census(axis: JitAdmissionAxis) -> Bool {
  match axis_mint_observability(axis: axis) {
    MintObservableCoverage { question: _ } => true
    MintUnobservableDeclaredBoundary => false
  }
}

type MintSurfaceLiveCensus
  = LiveCensusUnmet { question: MintSurfaceCoverageQuestion }
  | LiveCensusDischarged { question: MintSurfaceCoverageQuestion, receipt: NonEmptyStr }

fn mint_surface_live_census_is_unmet(census: MintSurfaceLiveCensus) -> Bool {
  match census {
    LiveCensusUnmet { question: _ } => true
    LiveCensusDischarged { question: _, receipt: _ } => false
  }
}

data generate_jitconfig_201_expires_at_coverage: MintSurfaceLiveCensus = LiveCensusUnmet {
  question: GenerateJitconfig201ExpiresAtPresence,
}

data replay_runner_id_and_duplicate_name_coverage: MintSurfaceLiveCensus = LiveCensusUnmet {
  question: ReplayRunnerIdAndDuplicateName409,
}
