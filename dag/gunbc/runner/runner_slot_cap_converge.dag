module gunbc.runner.runner_slot_cap_converge

import std.types { String, List, Bool, Int, NonEmptyStr }
import std.optional { Absent, Present }
import std.algebra { trim }
import std.measure { ByteSize, byte_size_count }
import extdeps.systemd { MemoryMax, MemorySwapMax, MemoryHigh, TasksMax, ControlGroup, systemd_unit_property_wire, SystemdUnitProperty }
import extdeps.systemd.systemctl { systemctl_show_properties_argv }
import extdeps.tools.grep { grep_nonempty_lines_in_tree_argv }
import extdeps.linux.cgroup_v2 { cgroup_v2_mount_point }
import extdeps.linux.cgroup_v2_memory {
  parse_cgroup_memory_limit,
  CgroupMemoryLimited,
  CgroupMemoryUnlimited,
  CgroupMemoryLimitUnparseable,
}
import gunbc.runner.runner_slot_desired { RunnerSlotDesired }
import gunbc.runner.runner_slot_retirement { retirement_cgroup_unescaped_root }
import gunbc.runner.runner_slot_actuation {
  SlotActuationOutcome,
  SlotRead,
  SlotReadRefused,
  read_slot_over,
  read_slot_worker_over,
  drain_and_mask_runner_slot_over,
  activate_runner_slot_over,
  slot_actuation_settled,
  slot_actuation_outcome_wire,
  slot_state_active,
}
import gunbc.runner.runner_disk_reclaim { SlotActivityObservation, SlotHasLiveWorker, SlotIdle, SlotActivityUnobserved }
import gunbc.fleet.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.typed_argv_exec { typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }

// THE LIVE SLOT CAPS, CONVERGED SLOT BY SLOT, ON THE ACTUATOR THE ROUTE ALREADY HAS. The cap drop-ins
// (20-fleet-width, 30-fleet-swap, 40-fleet-high, 50-fleet-tasks) are TEMPLATE-LEVEL: they sit under
// actions-runner@.service.d, so one write reaches every slot, and a running slot keeps the cgroup it
// started with until it is restarted. Writing the file is therefore not convergence. Convergence is the
// slot's LIVE cgroup showing the desired memory.max and memory.swap.max (the files the memory-envelope
// check reads, gunbc.host.memory_envelope), which only a restarted slot shows.
//
// TWO READBACKS, BOTH KEPT. `systemctl show` is the unit's view of its caps; the cgroup files are the
// kernel's. After a reload the unit's view moves at once while a running slot's cgroup does not, so
// "unit at desired, cgroup old" is the ordinary pre-restart state (NeedsRestart). The reverse -- the
// cgroup at desired while the unit says otherwise -- is a disagreement no restart explains, and it
// refuses.
//
// A BUSY SLOT IS NEVER RESTARTED. Idleness is read from the slot's own process listing before anything
// is changed (read_slot_worker_over); a slot with a live Runner.Worker keeps the old shape, the refusal
// is typed and names the slot, and the other slots still converge. Only an idle slot is drained
// (drain_and_mask_runner_slot_over) and then activated (activate_runner_slot_over) -- the same two
// effects gunbc.runner.runner_host_file_converge sequences for the width, with no second actuator.

type SlotCapLive {
  unit_memory_max: String
  unit_swap_max: String
  unit_memory_high: String
  unit_tasks_max: String
  control_group: String
  cgroup_memory_max: String?
  cgroup_swap_max: String?
}

type SlotCapStanding
  = SlotCapsAtDesired
  | SlotCapsNeedRestart { detail: String }
  | SlotCapsReadingsDisagree { detail: String }
  | SlotCapsUnread { cause: String }

// systemd prints an unbounded memory property as `infinity`; the cgroup file prints `max`. Either is
// "no limit", and neither equals a byte count.
fn slot_cap_unit_value_is(reading: String, bytes: ByteSize) -> Bool {
  trim(s: reading) == to_string(byte_size_count(b: bytes))
}

fn slot_cap_cgroup_value_is(reading: String?, bytes: ByteSize) -> Bool {
  match reading {
    Absent => false
    Present { value: body } =>
      match parse_cgroup_memory_limit(body: body) {
        CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == byte_size_count(b: bytes)
        CgroupMemoryUnlimited => false
        CgroupMemoryLimitUnparseable { body: _ } => false
      }
  }
}

fn slot_cap_unit_view_at_desired(live: SlotCapLive, desired: RunnerSlotDesired) -> Bool {
  slot_cap_unit_value_is(reading: live.unit_memory_max, bytes: desired.memory_max)
    && slot_cap_unit_value_is(reading: live.unit_swap_max, bytes: desired.memory_swap_max)
    && slot_cap_unit_value_is(reading: live.unit_memory_high, bytes: desired.memory_high)
    && trim(s: live.unit_tasks_max) == to_string(desired.tasks_max)
}

fn slot_cap_cgroup_view_at_desired(live: SlotCapLive, desired: RunnerSlotDesired) -> Bool {
  slot_cap_cgroup_value_is(reading: live.cgroup_memory_max, bytes: desired.memory_max)
    && slot_cap_cgroup_value_is(reading: live.cgroup_swap_max, bytes: desired.memory_swap_max)
}

fn slot_cap_standing(live: SlotCapLive, desired: RunnerSlotDesired) -> SlotCapStanding {
  let unit_ok = slot_cap_unit_view_at_desired(live: live, desired: desired)
  let cgroup_ok = slot_cap_cgroup_view_at_desired(live: live, desired: desired)
  if cgroup_ok && unit_ok {
    SlotCapsAtDesired
  } else if cgroup_ok {
    SlotCapsReadingsDisagree {
      detail: join(["the cgroup shows memory.max/memory.swap.max at the desired caps while systemctl show reports MemoryMax=", live.unit_memory_max, " MemorySwapMax=", live.unit_swap_max, " MemoryHigh=", live.unit_memory_high, " TasksMax=", live.unit_tasks_max], ""),
    }
  } else {
    SlotCapsNeedRestart {
      detail: join(["cgroup memory.max=", match live.cgroup_memory_max { Absent => "<unread>" Present { value: v } => trim(s: v) }, " memory.swap.max=", match live.cgroup_swap_max { Absent => "<unread>" Present { value: v } => trim(s: v) }, "; unit view MemoryMax=", live.unit_memory_max, " MemorySwapMax=", live.unit_swap_max], ""),
    }
  }
}

// THE HOST GATE, PURE. The drop-ins are template-level, so write + daemon-reload is a HOST-WIDE effect:
// systemd re-applies MemoryMax/MemorySwapMax to every running instance on reload, and a shrinking cap
// or a removed swap can OOM-kill a busy slot's live job. The write is therefore admitted only when EVERY
// slot of the host is idle (operator ruling, clever-crane-830); one busy or unproven slot refuses the
// WHOLE host before any write or reload, naming the slots that stay on the old shape.
type HostCapIdleGate
  = HostCapsAllIdle
  | HostCapsBusy { busy: List<NonEmptyStr>, unproven: List<NonEmptyStr> }

type SlotIdleReading {
  unit: NonEmptyStr
  activity: SlotActivityObservation
}

fn host_cap_idle_gate(readings: List<SlotIdleReading>) -> HostCapIdleGate {
  let busy = map(filter(readings, r => match r.activity { SlotHasLiveWorker => true SlotIdle => false SlotActivityUnobserved { cause: _ } => false }), r => r.unit)
  let unproven = map(filter(readings, r => match r.activity { SlotActivityUnobserved { cause: _ } => true SlotHasLiveWorker => false SlotIdle => false }), r => r.unit)
  if length(busy) == 0 && length(unproven) == 0 { HostCapsAllIdle } else { HostCapsBusy { busy: busy, unproven: unproven } }
}

// THE HOST PLAN, PURE: one decision for the whole host from every slot's standing and the idle gate.
// Unread or disagreeing readings withhold (nothing is known well enough to touch); all at desired leaves
// the caps in place; a differing cap runs only when every slot is idle, and the write+reload is then
// bracketed by drain_and_mask and activate on every slot.
type HostCapPlan
  = HostCapsLeaveInPlace
  | HostCapsDrainWriteRestart
  | HostCapsWithheld { cause: String }

fn host_cap_standing_problem(unit: NonEmptyStr, s: SlotCapStanding) -> String? {
  match s {
    SlotCapsAtDesired => none
    SlotCapsNeedRestart { detail: _ } => none
    SlotCapsReadingsDisagree { detail: d } => Present { value: join([unit as String, ": the unit and the cgroup disagree: ", d], "") }
    SlotCapsUnread { cause: c } => Present { value: join([unit as String, ": the live caps were not read: ", c], "") }
  }
}

fn host_cap_standing_differs(s: SlotCapStanding) -> Bool {
  match s {
    SlotCapsNeedRestart { detail: _ } => true
    SlotCapsAtDesired => false
    SlotCapsReadingsDisagree { detail: _ } => false
    SlotCapsUnread { cause: _ } => false
  }
}

type SlotCapUnitStanding {
  unit: NonEmptyStr
  standing: SlotCapStanding
}

fn host_cap_plan(standings: List<SlotCapUnitStanding>, gate: HostCapIdleGate) -> HostCapPlan {
  let problems = filter(map(standings, x => match host_cap_standing_problem(unit: x.unit, s: x.standing) { Present { value: v } => v Absent => "" }), v => v != "")
  if length(problems) > 0 {
    HostCapsWithheld { cause: join(problems, "; ") }
  } else if !any(standings, x => host_cap_standing_differs(s: x.standing)) {
    HostCapsLeaveInPlace
  } else {
    match gate {
      HostCapsAllIdle => HostCapsDrainWriteRestart
      HostCapsBusy { busy: b, unproven: u } => HostCapsWithheld {
        cause: join(["the cap drop-ins are template-level, so write + reload reaches every running slot; no write and no reload while a job may be live. busy=", join(map(b, x => x as String), " "), " idleness-unproven=", join(map(u, x => x as String), " ")], ""),
      }
    }
  }
}

type SlotCapOutcome
  = SlotCapsLeftInPlace { unit: NonEmptyStr }
  | SlotCapsRestartedAndRead { unit: NonEmptyStr }
  | SlotCapsRefused { unit: NonEmptyStr, step: String, reason: String }

fn slot_cap_outcome_settled(o: SlotCapOutcome) -> Bool {
  match o {
    SlotCapsLeftInPlace { unit: _ } => true
    SlotCapsRestartedAndRead { unit: _ } => true
    SlotCapsRefused { unit: _, step: _, reason: _ } => false
  }
}

fn slot_cap_outcome_wire(o: SlotCapOutcome) -> String {
  match o {
    SlotCapsLeftInPlace { unit: u } => join(["caps ", u as String, " at-desired-left-in-place"], "")
    SlotCapsRestartedAndRead { unit: u } => join(["caps ", u as String, " restarted-and-live-cgroup-read-back"], "")
    SlotCapsRefused { unit: u, step: st, reason: r } => join(["caps ", u as String, " REFUSED step=", st, " ", r], "")
  }
}

// ── The live reading ────────────────────────────────────────────────────────────────────────────

data slot_cap_show_properties: List<SystemdUnitProperty> = [MemoryMax, MemorySwapMax, MemoryHigh, TasksMax, ControlGroup]

data slot_cap_cgroup_files: List<NonEmptyStr> = ["memory.max" as NonEmptyStr, "memory.swap.max" as NonEmptyStr]

fn slot_cap_show_value(lines: List<String>, property: SystemdUnitProperty) -> String? {
  let key = concat(systemd_unit_property_wire(property: property) as String, "=")
  fold(lines, init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: key) {
      Present { value: substring(s: l, start: string_length(s: key), end: string_length(s: l)) }
    } else {
      acc
    })
}

// A grep row is `<path>:<value>`; the row for one file is the one whose path is exactly the slot's
// cgroup directory plus the file name, so a job's descendant cgroup can never answer for the slot.
fn slot_cap_cgroup_file_value(stdout: String, control_group: String, file_name: String) -> String? {
  let prefix = join([cgroup_v2_mount_point as String, control_group, "/", file_name, ":"], "")
  fold(split(s: stdout, delimiter: "\n"), init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: prefix) {
      Present { value: substring(s: l, start: string_length(s: prefix), end: string_length(s: l)) }
    } else {
      acc
    })
}

fn slot_cap_live_of_show(show_stdout: String, cgroup_stdout: String) -> SlotCapLive? {
  let lines = map(split(s: show_stdout, delimiter: "\n"), l => trim(s: l))
  match slot_cap_show_value(lines: lines, property: MemoryMax) {
    Absent => none
    Present { value: mm } =>
      match slot_cap_show_value(lines: lines, property: MemorySwapMax) {
        Absent => none
        Present { value: sw } =>
          match slot_cap_show_value(lines: lines, property: MemoryHigh) {
            Absent => none
            Present { value: hi } =>
              match slot_cap_show_value(lines: lines, property: TasksMax) {
                Absent => none
                Present { value: tk } =>
                  match slot_cap_show_value(lines: lines, property: ControlGroup) {
                    Absent => none
                    Present { value: cg } =>
                      Present {
                        value: SlotCapLive {
                          unit_memory_max: mm,
                          unit_swap_max: sw,
                          unit_memory_high: hi,
                          unit_tasks_max: tk,
                          control_group: cg,
                          cgroup_memory_max: slot_cap_cgroup_file_value(stdout: cgroup_stdout, control_group: cg, file_name: "memory.max"),
                          cgroup_swap_max: slot_cap_cgroup_file_value(stdout: cgroup_stdout, control_group: cg, file_name: "memory.swap.max"),
                        },
                      }
                  }
              }
          }
      }
  }
}

type SlotCapRead
  = SlotCapReadOk { live: SlotCapLive }
  | SlotCapReadRefused { reason: String }

fn read_slot_cap_live_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotCapRead
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_properties_argv(units: [unit], properties: slot_cap_show_properties)) {
    TypedArgvExecRefused { reason: why } => SlotCapReadRefused { reason: why }
    TypedArgvExecConverged { result: shown } =>
      if !shown.success {
        SlotCapReadRefused { reason: join(["systemctl show exit=", to_string(shown.exit_code), " ", trim(s: shown.stderr)], "") }
      } else {
        let cg = match slot_cap_show_value(lines: map(split(s: shown.stdout, delimiter: "\n"), l => trim(s: l)), property: ControlGroup) {
          Absent => ""
          Present { value: v } => v
        }
        // An inactive unit has an empty ControlGroup and no cgroup directory: nothing to read, and its
        // cgroup readings stay absent, which is NeedsRestart rather than a fabricated value.
        let cgroup_stdout = if trim(s: cg) == "" { "" } else {
          match typed_argv_exec_over_fleet_ssh(
            target: target,
            context: context,
            argv: grep_nonempty_lines_in_tree_argv(file_names: slot_cap_cgroup_files, root: retirement_cgroup_unescaped_root(control_group: cg) as NonEmptyStr),
          ) {
            TypedArgvExecRefused { reason: _ } => ""
            TypedArgvExecConverged { result: g } => g.stdout
          }
        }
        match slot_cap_live_of_show(show_stdout: shown.stdout, cgroup_stdout: cgroup_stdout) {
          Absent => SlotCapReadRefused { reason: "systemctl show returned no complete cap block for the unit" }
          Present { value: live } => SlotCapReadOk { live: live }
        }
      }
  }
}

fn slot_cap_standing_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, desired: RunnerSlotDesired) -> SlotCapStanding
{
  match read_slot_cap_live_over(target: target, context: context, unit: unit) {
    SlotCapReadRefused { reason: why } => SlotCapsUnread { cause: why }
    SlotCapReadOk { live: live } => slot_cap_standing(live: live, desired: desired)
  }
}

// ── The effects ─────────────────────────────────────────────────────────────────────────────────

// IDLENESS IS READ BEFORE ANYTHING IS CHANGED, from the same sensors the drain uses. An inactive slot has
// no worker; an active one is idle only when its own process listing proves it.
fn read_slot_idleness_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotIdleReading
{
  SlotIdleReading {
    unit: unit,
    activity: match read_slot_over(target: target, context: context, unit: unit) {
      SlotReadRefused { reason: why } => SlotActivityUnobserved { cause: why as NonEmptyStr }
      SlotRead { reading: r } => if slot_state_active(active: r.active) { read_slot_worker_over(target: target, context: context, unit: unit) } else { SlotIdle }
    },
  }
}

// AFTER THE WRITE AND RELOAD: activate the drained slot (the existing activate effect), then converge on
// its LIVE cgroup. A slot that comes back without both cgroup files at the desired caps and the unit view
// agreeing refuses, typed.
fn activate_and_read_back_slot_caps_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, desired: RunnerSlotDesired) -> SlotCapOutcome
{
  let activated = activate_runner_slot_over(target: target, context: context, unit: unit)
  if !slot_actuation_settled(o: activated) {
    SlotCapsRefused { unit: unit, step: "activate", reason: slot_actuation_outcome_wire(o: activated) }
  } else {
    match slot_cap_standing_over(target: target, context: context, unit: unit, desired: desired) {
      SlotCapsAtDesired => SlotCapsRestartedAndRead { unit: unit }
      SlotCapsNeedRestart { detail: d } => SlotCapsRefused { unit: unit, step: "live-readback", reason: concat("the restarted slot's cgroup does not show the desired caps: ", d) }
      SlotCapsReadingsDisagree { detail: d } => SlotCapsRefused { unit: unit, step: "live-readback", reason: d }
      SlotCapsUnread { cause: c } => SlotCapsRefused { unit: unit, step: "live-readback", reason: c }
    }
  }
}

// THE DRAIN BRACKET. Every slot is drained and masked first (the existing actuator); a slot whose drain is
// not settled (a job started after the idleness read) is the same refusal as a busy one, and the caller
// activates the already-drained slots again so no write happened.
type SlotDrainRow {
  unit: NonEmptyStr
  outcome: SlotActuationOutcome
}

fn drain_all_slots_over(target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>) -> List<SlotDrainRow>
{
  map(units, u => SlotDrainRow { unit: u, outcome: drain_and_mask_runner_slot_over(target: target, context: context, unit: u) })
}

fn drain_all_settled(rows: List<SlotDrainRow>) -> Bool {
  all(rows, r => slot_actuation_settled(o: r.outcome))
}

fn drain_all_cause(rows: List<SlotDrainRow>) -> String {
  join(map(filter(rows, r => !slot_actuation_settled(o: r.outcome)), r => join([r.unit as String, " ", slot_actuation_outcome_wire(o: r.outcome)], "")), "; ")
}

fn read_host_cap_standings_over(target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>, desired: RunnerSlotDesired) -> List<SlotCapUnitStanding>
{
  map(units, u => SlotCapUnitStanding { unit: u, standing: slot_cap_standing_over(target: target, context: context, unit: u, desired: desired) })
}

fn read_host_idleness_over(target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>) -> HostCapIdleGate
{
  host_cap_idle_gate(readings: map(units, u => read_slot_idleness_over(target: target, context: context, unit: u)))
}
