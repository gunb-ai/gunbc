import std.optional { Absent, Present }
import std.algebra { trim, FreeSemigroup, non_empty_to_list }
import std.measure { ByteSize, byte_size_count }
import extdeps.systemd { MemoryMax, MemorySwapMax, MemoryHigh, TasksMax, ControlGroup, systemd_unit_property_wire, SystemdUnitProperty }
import extdeps.systemd.systemctl { systemctl_show_properties_argv, SystemctlStep, ManagerReloadedImplicitly, ManagerReloadedExplicitly, ManagerNotReloaded, systemctl_mask_step, systemctl_unmask_step, systemctl_enable_step, systemctl_start_step, systemctl_stop_step, systemctl_daemon_reload_step }
import extdeps.tools.grep { grep_nonempty_lines_in_tree_argv }
import extdeps.linux.cgroup_v2 { cgroup_v2_mount_point }
import extdeps.linux.cgroup_v2_memory {
  parse_cgroup_memory_limit,
  CgroupMemoryLimited,
  CgroupMemoryUnlimited,
  CgroupMemoryLimitUnparseable,
}
import gunbc.runner.runner_slot_desired { RunnerSlotDesired }
import gunbc.runner.runner_slot_retirement { retirement_cgroup_unescaped_root }
import gunbc.runner.runner_slot_actuation {
  SlotActuationOutcome,
  SlotRead,
  SlotReadRefused,
  read_slot_over,
  read_slot_worker_over,
  drain_and_mask_runner_slot_over,
  activate_runner_slot_over,
  slot_actuation_settled,
  slot_actuation_outcome_wire,
  slot_state_active,
}
import gunbc.runner.runner_disk_reclaim { SlotActivityObservation, SlotHasLiveWorker, SlotIdle, SlotActivityUnobserved }
import gunbc.fleet.fleet_known_hosts_anchor { FleetSshExecutionContext, SshTarget }
import gunbc.typed_argv_exec { typed_argv_exec_over_fleet_ssh, TypedArgvExecConverged, TypedArgvExecRefused }

// THE LIVE SLOT CAPS, CONVERGED SLOT BY SLOT, ON THE ACTUATOR THE ROUTE ALREADY HAS. The cap drop-ins
// (20-fleet-width, 30-fleet-swap, 40-fleet-high, 50-fleet-tasks) are TEMPLATE-LEVEL: they sit under
// actions-runner@.service.d, so one write reaches every slot, and a running slot keeps the cgroup it
// started with until it is restarted. Writing the file is therefore not convergence. Convergence is the
// slot's LIVE cgroup showing the desired memory.max and memory.swap.max (the files the memory-envelope
// check reads, gunbc.host.memory_envelope), which only a restarted slot shows.
//
// TWO READBACKS, BOTH KEPT. `systemctl show` is the unit's view of its caps; the cgroup files are the
// kernel's. After a reload the unit's view moves at once while a running slot's cgroup does not, so
// "unit at desired, cgroup old" is the ordinary pre-restart state (NeedsRestart). The reverse -- the
// cgroup at desired while the unit says otherwise -- is a disagreement no restart explains, and it
// refuses.
//
// A BUSY SLOT IS NEVER RESTARTED. Idleness is read from the slot's own process listing before anything
// is changed (read_slot_worker_over); a slot with a live Runner.Worker keeps the old shape, the refusal
// is typed and names the slot, and the other slots still converge. Only an idle slot is drained
// (drain_and_mask_runner_slot_over) and then activated (activate_runner_slot_over) -- the same two
// effects gunbc.runner.runner_host_file_converge sequences for the width, with no second actuator.

type SlotCapLive {
  unit_memory_max: String
  unit_swap_max: String
  unit_memory_high: String
  unit_tasks_max: String
  control_group: String
  cgroup_memory_max: String?
  cgroup_swap_max: String?
  // THE THIRD LIVE READING, read only by the bracket holder's fold (slot_cap_holder_standing): the
  // shared standing still judges max+swap, the pair the memory-envelope check reads. The holder counts
  // as converged only when this too reads at desired (fleet slot ruling, parent 2026-10-24).
  cgroup_memory_high: String?
}

type SlotCapStanding
  = SlotCapsAtDesired
  | SlotCapsNeedRestart { detail: String }
  | SlotCapsReadingsDisagree { detail: String }
  | SlotCapsUnread { cause: String }
  | SlotCapsStopped

// systemd prints an unbounded memory property as `infinity`; the cgroup file prints `max`. Either is
// "no limit", and neither equals a byte count.
fn slot_cap_unit_value_is(reading: String, bytes: ByteSize) -> Bool {
  trim(s: reading) == to_string(byte_size_count(b: bytes))
}

fn slot_cap_cgroup_value_is(reading: String?, bytes: ByteSize) -> Bool {
  match reading {
    Absent => false
    Present { value: body } =>
      match parse_cgroup_memory_limit(body: body) {
        CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == byte_size_count(b: bytes)
        CgroupMemoryUnlimited => false
        CgroupMemoryLimitUnparseable { body: _ } => false
      }
  }
}

fn slot_cap_unit_view_at_desired(live: SlotCapLive, desired: RunnerSlotDesired) -> Bool {
  slot_cap_unit_value_is(reading: live.unit_memory_max, bytes: desired.memory_max)
    && slot_cap_unit_value_is(reading: live.unit_swap_max, bytes: desired.memory_swap_max)
    && slot_cap_unit_value_is(reading: live.unit_memory_high, bytes: desired.memory_high)
    && trim(s: live.unit_tasks_max) == to_string(desired.tasks_max)
}

fn slot_cap_cgroup_view_at_desired(live: SlotCapLive, desired: RunnerSlotDesired) -> Bool {
  slot_cap_cgroup_value_is(reading: live.cgroup_memory_max, bytes: desired.memory_max)
    && slot_cap_cgroup_value_is(reading: live.cgroup_swap_max, bytes: desired.memory_swap_max)
}

// A PRESENT, PARSEABLE cgroup reading: `max` or a byte count. Missing and malformed are the same
// refusal, never a "differs": an unread value must not authorise a drain, write and reload.
fn slot_cap_cgroup_value_readable(reading: String?) -> Bool {
  match reading {
    Absent => false
    Present { value: body } =>
      match parse_cgroup_memory_limit(body: body) {
        CgroupMemoryLimited { bytes: _ } => true
        CgroupMemoryUnlimited => true
        CgroupMemoryLimitUnparseable { body: _ } => false
      }
  }
}

// ONLY an empty ControlGroup (a unit with no cgroup: stopped) is a separately established no-cgroup
// state, and a stopped unit whose LOADED caps are stale is NeedRestart (its next start would run them). A unit that HAS a cgroup owes complete, parseable readings of both files.
fn slot_cap_standing(live: SlotCapLive, desired: RunnerSlotDesired) -> SlotCapStanding {
  if trim(s: live.control_group) == "" {
    if slot_cap_unit_view_at_desired(live: live, desired: desired) { SlotCapsStopped } else {
      SlotCapsNeedRestart { detail: join(["stopped, and the unit's loaded caps are not the desired ones: MemoryMax=", live.unit_memory_max, " MemorySwapMax=", live.unit_swap_max, " MemoryHigh=", live.unit_memory_high, " TasksMax=", live.unit_tasks_max], "") }
    }
  } else if !slot_cap_cgroup_value_readable(reading: live.cgroup_memory_max) || !slot_cap_cgroup_value_readable(reading: live.cgroup_swap_max) {
    SlotCapsUnread { cause: join(["the unit has cgroup ", live.control_group, " but memory.max/memory.swap.max are missing or malformed: memory.max=", match live.cgroup_memory_max { Absent => "<missing>" Present { value: v } => trim(s: v) }, " memory.swap.max=", match live.cgroup_swap_max { Absent => "<missing>" Present { value: v } => trim(s: v) }], "") }
  } else {
    slot_cap_standing_readable(live: live, desired: desired)
  }
}

fn slot_cap_standing_readable(live: SlotCapLive, desired: RunnerSlotDesired) -> SlotCapStanding {
  let unit_ok = slot_cap_unit_view_at_desired(live: live, desired: desired)
  let cgroup_ok = slot_cap_cgroup_view_at_desired(live: live, desired: desired)
  if cgroup_ok && unit_ok {
    SlotCapsAtDesired
  } else if cgroup_ok {
    SlotCapsReadingsDisagree {
      detail: join(["the cgroup shows memory.max/memory.swap.max at the desired caps while systemctl show reports MemoryMax=", live.unit_memory_max, " MemorySwapMax=", live.unit_swap_max, " MemoryHigh=", live.unit_memory_high, " TasksMax=", live.unit_tasks_max], ""),
    }
  } else {
    SlotCapsNeedRestart {
      detail: join(["cgroup memory.max=", match live.cgroup_memory_max { Absent => "<unread>" Present { value: v } => trim(s: v) }, " memory.swap.max=", match live.cgroup_swap_max { Absent => "<unread>" Present { value: v } => trim(s: v) }, "; unit view MemoryMax=", live.unit_memory_max, " MemorySwapMax=", live.unit_swap_max], ""),
    }
  }
}

// WHICH UNITS OWE A RELOAD, AND WHY WE KNOW (or do not). Owed: the unit's own NeedDaemonReload is not no.
// Unobserved: no complete show block came back for it, which proves nothing about what a reload would load.
// A population that could not be listed at all is its own arm, never a unit.
type PendingReloadKind = PendingReloadOwed | PendingReloadUnobserved

type UnitPendingReload {
  unit: NonEmptyStr
  kind: PendingReloadKind
}

type HostPendingReloads
  = HostNoReloadPending
  | HostReloadsPending { units: FreeSemigroup<UnitPendingReload> }
  | HostPopulationUnobserved { reason: String }

fn host_pending_reloads_owed(p: HostPendingReloads) -> Bool {
  match p {
    HostNoReloadPending => false
    HostReloadsPending { units: _ } => true
    HostPopulationUnobserved { reason: _ } => true
  }
}

fn host_pending_reloads_wire(p: HostPendingReloads) -> String {
  match p {
    HostNoReloadPending => "none"
    HostReloadsPending { units: us } => join(map(non_empty_to_list(xs: us), u => join([u.unit as String, match u.kind { PendingReloadOwed => " reload=owed (NeedDaemonReload is not no)" PendingReloadUnobserved => " reload=unobserved (systemctl show returned no complete block for it)" }], "")), "; ")
    HostPopulationUnobserved { reason: r } => concat("the slot population was not observed: ", r)
  }
}

// THE HOST PLAN, PURE: one decision for the whole host from every slot's standing and the idle gate.
// Unread or disagreeing readings withhold (nothing is known well enough to touch); all at desired leaves
// the caps in place; a differing cap runs only when every slot is idle, and the write+reload is then
// bracketed by drain_and_mask and activate on every slot.
type HostCapPlan
  = HostCapsLeaveInPlace
  | HostCapsDrainWriteRestart
  | HostCapsWithheld { cause: String }

fn host_cap_standing_problem(unit: NonEmptyStr, s: SlotCapStanding) -> String? {
  match s {
    SlotCapsAtDesired => none
    SlotCapsNeedRestart { detail: _ } => none
    SlotCapsReadingsDisagree { detail: d } => Present { value: join([unit as String, ": the unit and the cgroup disagree: ", d], "") }
    SlotCapsUnread { cause: c } => Present { value: join([unit as String, ": the live caps were not read: ", c], "") }
    SlotCapsStopped => none
  }
}

fn host_cap_standing_differs(s: SlotCapStanding) -> Bool {
  match s {
    SlotCapsNeedRestart { detail: _ } => true
    SlotCapsAtDesired => false
    SlotCapsReadingsDisagree { detail: _ } => false
    SlotCapsUnread { cause: _ } => false
    SlotCapsStopped => false
  }
}

type SlotCapUnitStanding {
  unit: NonEmptyStr
  standing: SlotCapStanding
}

// THE CAP FILES' OWN STANDING, observed through the existing file route. A file plan that could not be
// made (HostFileActionRefused) is Unreadable, never a difference: an unread file must not authorise a
// drain, write and reload.
type CapFilesState
  = CapFilesSettled
  | CapFilesDiffer
  | CapFilesUnreadable { cause: String }

// THE STEPS THE BRACKET SENDS, as typed steps from the same constructors the actuator renders its argv
// from: the drain's mask and stop, the activation's unmask, enable and start, and the route's one
// daemon-reload. Whether a step reloads the manager is the effect its constructor declares, so a pending
// unit-file change is a hazard exactly when a step in the bracket would load it.
fn host_cap_bracket_steps(unit: NonEmptyStr) -> List<SystemctlStep> {
  [systemctl_mask_step(unit: unit), systemctl_stop_step(unit: unit), systemctl_unmask_step(unit: unit), systemctl_enable_step(unit: unit), systemctl_start_step(unit: unit), systemctl_daemon_reload_step()]
}

fn host_cap_step_reloads(step: SystemctlStep) -> Bool {
  match step.effect {
    ManagerReloadedImplicitly => true
    ManagerReloadedExplicitly => true
    ManagerNotReloaded => false
  }
}

fn host_cap_bracket_reloads(unit: NonEmptyStr) -> Bool {
  any(host_cap_bracket_steps(unit: unit), step => host_cap_step_reloads(step: step))
}

// WHEN THE PHASE PROCEEDS (ruling of clever-crane-830, narrow scope): a cap differs AND every
// precondition holds -- every cap-file observation readable, no incomplete retiree, no loaded extra, no
// pending unit-file change (NeedDaemonReload on any observed instance; an instance reports the template's
// drop-ins), the host is then drained by gunbc.runner.runner_host_cap_bracket (admission closed first, live jobs waited out inside a declared bound), never judged idle with admission open. Then one bracket drains every slot (the mask reloads are harmless
// because nothing is pending), writes, reloads once, activates and reads back. Everything else that is
// not already at desired is Withheld, typed and named, and a withheld host BARS every other reload site:
// a stale or hand-placed lower-cap file would otherwise load through an unrelated reload.
// `pending_reloads` locates every instance that owes a reload or was not read, as a typed carrier rendered only into the Withheld cause.
fn host_cap_plan(standings: List<SlotCapUnitStanding>, files: CapFilesState, extras: List<NonEmptyStr>, pending_reloads: HostPendingReloads, retirement_cause: String?) -> HostCapPlan {
  let problems = filter(map(standings, x => match host_cap_standing_problem(unit: x.unit, s: x.standing) { Present { value: v } => v Absent => "" }), v => v != "")
  if length(problems) > 0 {
    HostCapsWithheld { cause: join(problems, "; ") }
  } else {
    match files {
      CapFilesUnreadable { cause: c } => HostCapsWithheld { cause: concat("the cap files could not be observed: ", c) }
      CapFilesSettled => host_cap_plan_settled_files(standings: standings, files_differ: false, extras: extras, pending_reloads: pending_reloads, retirement_cause: retirement_cause)
      CapFilesDiffer => host_cap_plan_settled_files(standings: standings, files_differ: true, extras: extras, pending_reloads: pending_reloads, retirement_cause: retirement_cause)
    }
  }
}

fn host_cap_plan_settled_files(standings: List<SlotCapUnitStanding>, files_differ: Bool, extras: List<NonEmptyStr>, pending_reloads: HostPendingReloads, retirement_cause: String?) -> HostCapPlan {
  // PENDING IS CHECKED FIRST, BEFORE ANY ARM THAT OPENS A RELOAD OR AN ACTIVATION, THE LEAVE-IN-PLACE ARM
  // INCLUDED. "Nothing differs" covers only the managed files and the current values; a reload applies
  // every source the manager has pending (a hand-placed instance drop-in with a lower MemoryMax among
  // them), so a pending or unknown reload withholds whatever the managed files say.
  if host_pending_reloads_owed(p: pending_reloads) && any(map(standings, x => x.unit), u => host_cap_bracket_reloads(unit: u)) {
    HostCapsWithheld { cause: join(["a unit-file change is pending reload (or an instance could not be read), and a reload applies every pending source to every running slot, undrained: the managed cap files settling does not cover it. pending: ", host_pending_reloads_wire(p: pending_reloads)], "") }
  } else if !files_differ && !any(standings, x => host_cap_standing_differs(s: x.standing)) {
    HostCapsLeaveInPlace
  } else {
    match retirement_cause {
      Present { value: why } => HostCapsWithheld { cause: concat("a surplus slot has not retired, so the host is not quiescent: ", why) }
      Absent =>
        if length(extras) > 0 {
          HostCapsWithheld { cause: concat("loaded runner instances outside the declared sets would receive the template reload and are not drained or activated by this route: ", join(map(extras, x => x as String), " ")) }
        } else {
          HostCapsDrainWriteRestart
        }
    }
  }
}

// THE BRACKET HOLDER IS NEVER SILENT. The converge job runs FROM a slot of the host it converges, so the
// bracket can neither drain, stop nor restart the unit it runs on: a slot is permanently busy with its own
// Runner.Worker, and stopping it would kill this very run. The holder is therefore EXCLUDED from the drain
// (bracket holder exclusion, gunbc.runner.runner_host_cap_bracket) and its caps land only if the manager
// reload alone applied them, which is NOT assumed: the holder is read back from its LIVE cgroup like every
// other slot, and only a read-back at desired says converged. Anything else says DEFERRED-SELF by name --
// owed, loud, never a convergence claim -- and the next converge pass, running from a different slot,
// brackets it normally. A deferred self settles the RUN (the bracket did all it could here) but never the
// unit: only SlotCapsSelfAtDesired claims the holder's envelope.
type SlotCapOutcome
  = SlotCapsLeftInPlace { unit: NonEmptyStr }
  | SlotCapsRestartedAndRead { unit: NonEmptyStr }
  | SlotCapsSelfAtDesired { unit: NonEmptyStr }
  | SlotCapsSelfDeferred { unit: NonEmptyStr, detail: String }
  | SlotCapsHolderLedgerRefused { unit: NonEmptyStr, cause: String }
  | SlotCapsRefused { unit: NonEmptyStr, step: String, reason: String }

fn slot_cap_outcome_settled(o: SlotCapOutcome) -> Bool {
  match o {
    SlotCapsLeftInPlace { unit: _ } => true
    SlotCapsRestartedAndRead { unit: _ } => true
    SlotCapsSelfAtDesired { unit: _ } => true
    // The per-unit answer is NO: a deferred self never claims its memory envelope.
    SlotCapsSelfDeferred { unit: _, detail: _ } => false
    SlotCapsHolderLedgerRefused { unit: _, cause: _ } => false
    SlotCapsRefused { unit: _, step: _, reason: _ } => false
  }
}

// WHETHER THE BRACKET'S RUN MAY CALL ITSELF DONE. A deferred self settles the RUN -- the bracket
// physically cannot bracket the slot it runs on, and a pass that excluded it, wrote every cap file and
// reloaded the manager once has done all it can for that slot; the next pass, running from a different
// slot, brackets it normally. It NEVER settles the UNIT: that answer lives only in
// slot_cap_outcome_settled, and the wire shouts DEFERRED-SELF beside the unit's name, so the receipt
// reports the holder as owed, never as converged. This coproduct is the run-level fold only, and a
// deferred self is produced only for the unit the bracket identified as its own holder -- nothing else
// can mint one. Any other unsettled outcome -- a refusal, an unread, a foreign mask -- still fails the
// run, exactly as before.
fn slot_cap_outcome_host_settled(o: SlotCapOutcome) -> Bool {
  match o {
    SlotCapsSelfDeferred { unit: _, detail: _ } => true
    _ => slot_cap_outcome_settled(o: o)
  }
}

fn slot_cap_outcome_wire(o: SlotCapOutcome) -> String {
  match o {
    SlotCapsLeftInPlace { unit: u } => join(["caps ", u as String, " at-desired-left-in-place"], "")
    SlotCapsRestartedAndRead { unit: u } => join(["caps ", u as String, " restarted-and-live-cgroup-read-back"], "")
    SlotCapsSelfAtDesired { unit: u } => join(["caps ", u as String, " holder-live-read-back-at-desired"], "")
    SlotCapsSelfDeferred { unit: u, detail: d } => join(["caps ", u as String, " DEFERRED-SELF ", d, " (this pass ran on it; the next pass from another slot brackets it)"], "")
    SlotCapsHolderLedgerRefused { unit: u, cause: c } => join(["caps ", u as String, " REFUSED step=holder-deferral-ledger ", c], "")
    SlotCapsRefused { unit: u, step: st, reason: r } => join(["caps ", u as String, " REFUSED step=", st, " ", r], "")
  }
}

// THE OBSERVED STANDING'S WIRE. Observe mode reports what a read FOUND, never what a mode decided:
// this renders the live standing of one unit (AtDesired / the owed detail / the readings disagree /
// unread with its cause / stopped) directly from SlotCapStanding, so an unread cap never renders as a
// settled no. It exists because the apply outcomes above answer "what did the phase DO"; observe does
// nothing, and its answer is the standing itself.
fn slot_cap_standing_wire(unit: NonEmptyStr, s: SlotCapStanding) -> String {
  match s {
    SlotCapsAtDesired => join(["caps ", unit as String, " observed-at-desired"], "")
    SlotCapsNeedRestart { detail: d } => join(["caps ", unit as String, " OBSERVED-OWED ", d], "")
    SlotCapsReadingsDisagree { detail: d } => join(["caps ", unit as String, " OBSERVED-DISAGREE ", d], "")
    SlotCapsUnread { cause: c } => join(["caps ", unit as String, " OBSERVED-UNREAD ", c], "")
    SlotCapsStopped => join(["caps ", unit as String, " observed-stopped-no-control-group"], "")
  }
}

// ── The live reading ────────────────────────────────────────────────────────────────────────────

data slot_cap_show_properties: List<SystemdUnitProperty> = [MemoryMax, MemorySwapMax, MemoryHigh, TasksMax, ControlGroup]

// THE SHARED LIVE READ STAYS THE PAIR THE ENVELOPE CHECK READS. memory.high is NOT added here: the fleet's
// cap witnesses script this exact argv (two file names), and the shared standing judges max+swap -- the pair
// the memory-envelope check reads (gunbc.host.memory_envelope). A caller that must read MORE of a unit's
// cgroup passes its own file list to read_slot_cap_live_files_over; the bracket holder is such a caller
// (slot_cap_holder_cgroup_files below), because its verdict is taken from its live cgroup alone -- the
// holder is never stop/start bracketed (gunbc.runner.runner_host_cap_bracket), and the fleet ruling
// (parent 2026-10-24) counts it converged only when all three values the drop-in set read back at desired.
data slot_cap_cgroup_files: List<NonEmptyStr> = ["memory.max" as NonEmptyStr, "memory.swap.max" as NonEmptyStr]

fn slot_cap_show_value(lines: List<String>, property: SystemdUnitProperty) -> String? {
  let key = concat(systemd_unit_property_wire(property: property) as String, "=")
  fold(lines, init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: key) {
      Present { value: substring(s: l, start: string_length(s: key), end: string_length(s: l)) }
    } else {
      acc
    })
}

// A grep row is `<path>:<value>`; the row for one file is the one whose path is exactly the slot's
// cgroup directory plus the file name, so a job's descendant cgroup can never answer for the slot.
fn slot_cap_cgroup_file_value(stdout: String, control_group: String, file_name: String) -> String? {
  let prefix = join([cgroup_v2_mount_point as String, control_group, "/", file_name, ":"], "")
  fold(split(s: stdout, delimiter: "\n"), init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: prefix) {
      Present { value: substring(s: l, start: string_length(s: prefix), end: string_length(s: l)) }
    } else {
      acc
    })
}

fn slot_cap_live_of_show(show_stdout: String, cgroup_stdout: String) -> SlotCapLive? {
  let lines = map(split(s: show_stdout, delimiter: "\n"), l => trim(s: l))
  match slot_cap_show_value(lines: lines, property: MemoryMax) {
    Absent => none
    Present { value: mm } =>
      match slot_cap_show_value(lines: lines, property: MemorySwapMax) {
        Absent => none
        Present { value: sw } =>
          match slot_cap_show_value(lines: lines, property: MemoryHigh) {
            Absent => none
            Present { value: hi } =>
              match slot_cap_show_value(lines: lines, property: TasksMax) {
                Absent => none
                Present { value: tk } =>
                  match slot_cap_show_value(lines: lines, property: ControlGroup) {
                    Absent => none
                    Present { value: cg } =>
                      Present {
                        value: SlotCapLive {
                          unit_memory_max: mm,
                          unit_swap_max: sw,
                          unit_memory_high: hi,
                          unit_tasks_max: tk,
                          control_group: cg,
                          cgroup_memory_max: slot_cap_cgroup_file_value(stdout: cgroup_stdout, control_group: cg, file_name: "memory.max"),
                          cgroup_swap_max: slot_cap_cgroup_file_value(stdout: cgroup_stdout, control_group: cg, file_name: "memory.swap.max"),
                          cgroup_memory_high: slot_cap_cgroup_file_value(stdout: cgroup_stdout, control_group: cg, file_name: "memory.high"),
                        },
                      }
                  }
              }
          }
      }
  }
}

type SlotCapRead
  = SlotCapReadOk { live: SlotCapLive }
  | SlotCapReadRefused { reason: String }

// THE EXEC BOUNDARY AS A TYPED ARGUMENT (the machine_intake readback exemplar's RemoteAnswer shape):
// what the exec EFFECT answers -- refused (never attempted), or a result. Splitting exec from judgement
// is what makes the REAL route controllable: read_slot_cap_live_over and the scripted controls both
// pass their exec answers through slot_cap_read_of_answers -- ONE decision core -- so a scripted
// control and the live route cannot drift apart (§6b: script the world the route reads, never the
// judgement it makes).
type SlotCapExecAnswer
  = SlotCapExecRefused { reason: String }
  | SlotCapExecRan { success: Bool, exit_code: Int, stdout: String, stderr: String }

fn slot_cap_exec_answer_of(outcome: TypedArgvExecOutcome) -> SlotCapExecAnswer {
  match outcome {
    TypedArgvExecRefused { reason: r } => SlotCapExecRefused { reason: r }
    TypedArgvExecConverged { result: r } => SlotCapExecRan { success: r.success, exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr }
  }
}

// THE DECISION CORE both routes run: it resolves every refusal with a NAMED cause BEFORE stdout is
// looked at (a leg that printed and then failed can never read as a standing), honours the "no
// ControlGroup means no cgroup directory was read" rule, and hands the bytes to slot_cap_live_of_show.
// `cgroup` is Absent exactly when the unit has no ControlGroup and the leg was (correctly) not fired; a
// non-empty ControlGroup whose leg is Absent is a typed refusal, never a silent gap.
fn slot_cap_read_of_answers(show: SlotCapExecAnswer, cgroup: SlotCapExecAnswer?) -> SlotCapRead {
  match show {
    SlotCapExecRefused { reason: why } => SlotCapReadRefused { reason: why }
    SlotCapExecRan { success: ok, exit_code: ec, stdout: sout, stderr: serr } =>
      if !ok {
        SlotCapReadRefused { reason: join(["systemctl show exit=", to_string(ec), " ", trim(s: serr)], "") }
      } else {
        let cg = match slot_cap_show_value(lines: map(split(s: sout, delimiter: "\n"), l => trim(s: l)), property: ControlGroup) {
          Absent => ""
          Present { value: v } => v
        }
        if trim(s: cg) == "" {
          match slot_cap_live_of_show(show_stdout: sout, cgroup_stdout: "") {
            Absent => SlotCapReadRefused { reason: "systemctl show returned no complete cap block for the unit" }
            Present { value: live } => SlotCapReadOk { live: live }
          }
        } else {
          match cgroup {
            Absent => SlotCapReadRefused { reason: join(["the unit has cgroup ", cg, " but no cgroup leg was attempted"], "") }
            Present { value: SlotCapExecRefused { reason: why } } => SlotCapReadRefused { reason: why }
            Present { value: SlotCapExecRan { success: gok, exit_code: gec, stdout: gout, stderr: gerr } } =>
              if !gok {
                SlotCapReadRefused { reason: join(["cgroup grep exit=", to_string(gec), " ", trim(s: gerr)], "") }
              } else {
                match slot_cap_live_of_show(show_stdout: sout, cgroup_stdout: gout) {
                  Absent => SlotCapReadRefused { reason: "systemctl show returned no complete cap block for the unit" }
                  Present { value: live } => SlotCapReadOk { live: live }
                }
              }
          }
        }
      }
  }
}

// THE LIVE READ: both exec legs fire through typed_argv_exec_over_fleet_ssh (admission at the exec
// boundary, §4b); the cgroup leg fires only when the show leg reached a non-empty ControlGroup, exactly
// as before. The judgement is the shared core below.
fn read_slot_cap_live_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotCapRead
{
  read_slot_cap_live_files_over(target: target, context: context, unit: unit, file_names: slot_cap_cgroup_files)
}

// THE SAME READ, OVER THE FILE LIST THE CALLER NEEDS. The shared list is two files because the standing
// below judges max+swap -- the pair the memory-envelope check reads -- and the fleet's cap witnesses script
// that exact argv; a caller that must read MORE of the unit's cgroup (the bracket holder, which is judged
// on all three values the drop-in sets) passes its own list rather than widening every reader's argv.
fn read_slot_cap_live_files_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, file_names: List<NonEmptyStr>) -> SlotCapRead
{
  let show = slot_cap_exec_answer_of(outcome: typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_properties_argv(units: [unit], properties: slot_cap_show_properties)))
  // An inactive unit has an empty ControlGroup and no cgroup directory: nothing to read, and its
  // cgroup readings stay absent, which is NeedsRestart rather than a fabricated value.
  let cgroup = match show {
    SlotCapExecRan { success: true, exit_code: _, stdout: sout, stderr: _ } =>
      match slot_cap_show_value(lines: map(split(s: sout, delimiter: "\n"), l => trim(s: l)), property: ControlGroup) {
        Absent => none
        Present { value: cg } =>
          if trim(s: cg) == "" {
            none
          } else {
            Present { value: slot_cap_exec_answer_of(outcome: typed_argv_exec_over_fleet_ssh(
              target: target,
              context: context,
              argv: grep_nonempty_lines_in_tree_argv(file_names: file_names, root: retirement_cgroup_unescaped_root(control_group: cg) as NonEmptyStr),
            )) }
          }
      }
    _ => none
  }
  slot_cap_read_of_answers(show: show, cgroup: cgroup)
}

fn slot_cap_standing_over_from_read(read: SlotCapRead, desired: RunnerSlotDesired) -> SlotCapStanding {
  match read {
    SlotCapReadRefused { reason: why } => SlotCapsUnread { cause: why }
    SlotCapReadOk { live: live } => slot_cap_standing(live: live, desired: desired)
  }
}

fn slot_cap_standing_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, desired: RunnerSlotDesired) -> SlotCapStanding
{
  slot_cap_standing_over_from_read(read: read_slot_cap_live_over(target: target, context: context, unit: unit), desired: desired)
}

// THE BRACKET HOLDER'S VERDICT, AS A PURE FOLD OVER ONE LIVE READING. The holder is never stopped or
// restarted (a slot cannot bracket the job that runs on it), so the manager reload is all that can have
// applied its drop-in -- and whether a reload applies memory limits to a LIVE cgroup is not assumed
// (fleet ruling, parent 2026-10-24: srv1/srv2 prove nothing here, they got their caps through the
// stop/start bracket). So the holder counts as converged ONLY on what its live cgroup says now: all
// three values the drop-in sets -- memory.max, memory.swap.max and memory.high -- reading at the desired
// bytes. Anything else -- a stale reading, an unread cgroup, a stopped unit -- is a deferral by name:
// owed, loud, and never a convergence claim. The next converge pass, running from a different slot,
// brackets this one normally.
//
// Why all three where the shared standing judges max+swap: the envelope check reads max+swap
// (gunbc.host.memory_envelope), but the holder is claiming CONVERGENCE against the desired slot shape,
// and a half-applied drop-in (high stale after a reload that loaded the file but left the live cgroup on
// the old throttle line) must not pass as converged. A stopped or inactive unit is deferred too: the
// holder is the running slot, and a stopped "holder" means the identification was wrong or the state
// moved underneath -- say so instead of claiming.
// THE FULL LIVE AGREEMENT FOR THE HOLDER: both envelope values, the throttle line, and the loaded unit
// view agreeing with them. Unit-level fields are compared the same way the bracketed slots compare
// theirs -- one parser, one comparison, no holder-local arithmetic.
fn slot_cap_live_cgroup_at_desired(live: SlotCapLive, desired: RunnerSlotDesired) -> Bool {
  slot_cap_cgroup_value_is(reading: live.cgroup_memory_max, bytes: desired.memory_max)
    && slot_cap_cgroup_value_is(reading: live.cgroup_swap_max, bytes: desired.memory_swap_max)
    && slot_cap_cgroup_value_is(reading: live.cgroup_memory_high, bytes: desired.memory_high)
    && slot_cap_unit_view_at_desired(live: live, desired: desired)
}

// THE HOLDER'S DEFERRAL, WITH THE READING THAT DEFEATED IT NAMED IN THE DETAIL. A deferral that cannot
// say which value disagreed is a §5 diagnostic with nothing to act on: the wire already shouts
// DEFERRED-SELF, and this string is what tells the operator whether to wait for the next pass or to look
// at the manager.
fn slot_cap_holder_standing_detail(live: SlotCapLive, desired: RunnerSlotDesired) -> String {
  let max_want = to_string(byte_size_count(b: desired.memory_max))
  let swap_want = to_string(byte_size_count(b: desired.memory_swap_max))
  let high_want = to_string(byte_size_count(b: desired.memory_high))
  let max_got = match live.cgroup_memory_max { Absent => "unread" Present { value: v } => v }
  let swap_got = match live.cgroup_swap_max { Absent => "unread" Present { value: v } => v }
  let high_got = match live.cgroup_memory_high { Absent => "unread" Present { value: v } => v }
  join([
    "live cgroup reads memory.max=", max_got, " want ", max_want,
    ", memory.swap.max=", swap_got, " want ", swap_want,
    ", memory.high=", high_got, " want ", high_want,
    if slot_cap_unit_view_at_desired(live: live, desired: desired) { "" } else { ", unit view disagrees with the drop-in" },
  ], "")
}

// THE HOLDER'S VERDICT, READ FROM ITS LIVE CGROUP OVER SSH (the same read every bracketed slot gets --
// one argv builder, one parser; the holder gets no special reader, only a wider file list and a stricter
// judge: all three values the drop-in sets, not the two the envelope check reads).
data slot_cap_holder_cgroup_files: List<NonEmptyStr> = ["memory.max" as NonEmptyStr, "memory.swap.max" as NonEmptyStr, "memory.high" as NonEmptyStr]

// THE DEFERRAL, BOUNDED BY WHAT THIS PASS OWED (review 86146, finding 2; DESIGN §4b meta-obligation 2:
// a class below ceiling names its next-rung trigger; §5: a degradation is typed, located and COUNTABLE).
// Value-disagreement with the live cgroup is DEFERRED (parent ruling 2026-10-24: only a pass dispatched
// from ANOTHER slot can stop/start the holder; srv1/srv2 never prove the reload path), but a deferral
// that never ends is success quietly turned into failure-by-placement, so the count rides in from the
// host (the ledger the bracket module keeps next to the obligation file, gunbc.runner.runner_host_cap_bracket):
// a holder may be deferred for at most slot_cap_holder_deferral_bound passes; past the bound the SAME
// reading is a REFUSAL -- the run goes red, the obligation stays, and an operator sees the named
// break-glass rung (systemctl set-property, operator-only, fleet slot rulings 2026-10-10). A ledger
// this pass cannot read also refuses (step holder-deferral-ledger): the bracket pass resets it behind
// that loud red step (holder_ledger_after_verdict), so a corrupted count costs one red run -- never a
// green the bound can never stop.
type HolderDeferralLedger
  = LedgerFresh
  | LedgerCount { prior: Int }
  | LedgerUnwritable { cause: String }

// THE FLEET'S DEFERRAL BOUND. srv3 and srv4 carry nineteen slots each and converge passes are frequent;
// three passes finding the same holder owed -- every one of them able to pick a different slot -- is not
// placement luck any more, it is the stuck-placement case the bound exists to make red. The count is
// per-unit and durable, and ONLY a holder pass that finds the unit back at desired clears it; a slot
// converged as an OWNED unit by ANOTHER slot's bracket keeps its old count, because that pass has no
// reason to look at this unit's holder ledger. The safe direction holds: a stale count makes the bound
// fire EARLY (a red run that names the disagreement and the break-glass rung), never late -- so the
// bound can be strict, it can never be fooled into a permanent green.
data slot_cap_holder_deferral_bound: Int = 3

fn slot_cap_holder_deferral_outcome(ledger: HolderDeferralLedger, unit: NonEmptyStr, live: SlotCapLive, desired: RunnerSlotDesired) -> SlotCapOutcome
{
  let detail = slot_cap_holder_standing_detail(live: live, desired: desired)
  let next_rung = if slot_cap_unit_view_at_desired(live: live, desired: desired) { "; the drop-in has loaded into the unit but the live cgroup predates it: next rung -- bracket this slot from a converge pass dispatched on a DIFFERENT slot" } else { "; the unit view itself disagrees with the drop-in: the manager never reloaded it; next rung -- bracket this slot from a pass dispatched on a different slot" }
  match ledger {
    LedgerCount { prior: p } =>
      if p >= slot_cap_holder_deferral_bound {
        // THE BOUND HAS BLOWN: the same reading, now a refusal. Typed, red, obligation still held.
        SlotCapsRefused { unit: unit, step: "holder-live-read", reason: join([detail, ": deferred across ", to_string(p), " consecutive passes -- the next rung was never taken; placement is stuck or the reload does not apply caps to live cgroups; only an operator stands between this and a bracket from another slot, and systemctl set-property is break-glass (fleet slot rulings 2026-10-10)"], "") }
      } else {
        SlotCapsSelfDeferred { unit: unit, detail: join([detail, next_rung, " (host-tracked deferral pass ", to_string(p + 1), " of ", to_string(slot_cap_holder_deferral_bound), ")"], "") }
      }
    LedgerFresh => SlotCapsSelfDeferred { unit: unit, detail: join([detail, next_rung, " (host-tracked deferral pass 1 of ", to_string(slot_cap_holder_deferral_bound), ")"], "") }
    // AN UNREADABLE LEDGER IS RED, NOT A FREE PASS (review 86323, finding 1; DESIGN §5: a degradation is
    // countable; an uncounted degradation or escape hatch is a hard reject). A deferral here would settle
    // green forever: the file that cannot be read is never rewritten by the pass that failed to read it,
    // so the same unreadable bytes would be read on every future pass and the bound below could never fire.
    // The refusal IS the loud step; the bracket pass then RESETS the ledger to pass 1 (see
    // holder_ledger_after_verdict), so a corrupted ledger costs one red run, not a permanent green.
    LedgerUnwritable { cause: why } => SlotCapsHolderLedgerRefused { unit: unit, cause: join(["the holder is owed caps (", detail, ") but its deferral ledger is unreadable or unwritable: ", why, " -- an UNCOUNTED deferral is a permanent green the bound can never stop, so it refuses. This red pass is the loud, counted step; the pass resets the ledger to pass 1, and the next pass is counted again."], "") }
  }
}

// THE HOLDER'S VERDICT, IN ONE PLACE for both the pure control fold and the ssh fold: all three values the
// drop-in sets, read back from the live cgroup (one parser, one comparison -- no holder-local arithmetic).
fn slot_cap_holder_verdict(unit: NonEmptyStr, live: SlotCapLive, desired: RunnerSlotDesired, ledger: HolderDeferralLedger) -> SlotCapOutcome {
  if slot_cap_live_cgroup_at_desired(live: live, desired: desired) {
    SlotCapsSelfAtDesired { unit: unit }
  } else {
    slot_cap_holder_deferral_outcome(ledger: ledger, unit: unit, live: live, desired: desired)
  }
}

// THE PURE CONTROL FOLD: the holder's verdict for a pass with no prior deferrals recorded (LedgerFresh).
// The production route reaches the same fold through slot_cap_holder_standing_over with the host ledger.
fn slot_cap_holder_standing(unit: NonEmptyStr, live: SlotCapLive, desired: RunnerSlotDesired) -> SlotCapOutcome {
  slot_cap_holder_verdict(unit: unit, live: live, desired: desired, ledger: LedgerFresh)
}

// THE SSH FOLD: the same verdict, read from the holder's live cgroup over the pinned transport (one
// argv builder, one parser -- the holder gets no special reader, only a wider file list and a stricter
// judge: all three values the drop-in sets, not the two the envelope check reads).
fn slot_cap_holder_standing_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, desired: RunnerSlotDesired, ledger: HolderDeferralLedger) -> SlotCapOutcome
{
  match read_slot_cap_live_files_over(target: target, context: context, unit: unit, file_names: slot_cap_holder_cgroup_files) {
    // A FAILED OBSERVATION IS NOT A DEFERRAL BY DESIGN (review 86146; DESIGN §5: a failure arm refuses,
    // never widens). The deferral arm is reserved for the one thing the holder physically cannot do -- be
    // stopped and started by the job running on it -- and it is a CLAIM ABOUT VALUES THAT WERE READ. When
    // the host cannot be read at all, nothing may be claimed either way: a REFUSAL, typed with its step,
    // unsettled at both levels, and it does not discharge the bracket obligation.
    SlotCapReadRefused { reason: why } => SlotCapsRefused { unit: unit, step: "holder-live-read", reason: join(["the holder's live cgroup could not be read: ", why], "") }
    SlotCapReadOk { live: live } => slot_cap_holder_verdict(unit: unit, live: live, desired: desired, ledger: ledger)
  }
}

// ── The effects ─────────────────────────────────────────────────────────────────────────────────

// AFTER THE WRITE AND RELOAD: activate the drained slot (the existing activate effect), then converge on
// its LIVE cgroup. A slot that comes back without both cgroup files at the desired caps and the unit view
// agreeing refuses, typed.
fn activate_and_read_back_slot_caps_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, desired: RunnerSlotDesired) -> SlotCapOutcome
{
  let activated = activate_runner_slot_over(target: target, context: context, unit: unit)
  if !slot_actuation_settled(o: activated) {
    SlotCapsRefused { unit: unit, step: "activate", reason: slot_actuation_outcome_wire(o: activated) }
  } else {
    match slot_cap_standing_over(target: target, context: context, unit: unit, desired: desired) {
      SlotCapsAtDesired => SlotCapsRestartedAndRead { unit: unit }
      SlotCapsNeedRestart { detail: d } => SlotCapsRefused { unit: unit, step: "live-readback", reason: concat("the restarted slot's cgroup does not show the desired caps: ", d) }
      SlotCapsReadingsDisagree { detail: d } => SlotCapsRefused { unit: unit, step: "live-readback", reason: d }
      SlotCapsUnread { cause: c } => SlotCapsRefused { unit: unit, step: "live-readback", reason: c }
      SlotCapsStopped => SlotCapsRefused { unit: unit, step: "live-readback", reason: "the unit has no cgroup after activation" }
    }
  }
}

fn read_host_cap_standings_over(target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>, desired: RunnerSlotDesired) -> List<SlotCapUnitStanding>
{
  map(units, u => SlotCapUnitStanding { unit: u, standing: slot_cap_standing_over(target: target, context: context, unit: u, desired: desired) })
}
