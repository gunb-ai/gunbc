module gunbc.runner_microvm_lifecycle

import std.types { String, NonEmptyStr, Bool, List, Int }
import std.disposition { Disposition, SingleAuthority }
import product.fabric.sanitation {
  CellId, SandboxId, CellReadiness, SanitationFact, SanitationReadback, SanitationObservation,
  FactConfirmed, FactRefuted, FactUnobservable,
  NoSurvivingProcesses, CgroupEmpty, MountsRemoved, NetworkNamespaceRemoved,
  WritableLayersDeleted, SecretsRemoved, cell_readiness_after,
}
import gunbc.build_cache_instance { runner_slot_instance_name }
import gunbc.runner_microvm { RunnerGuestImage }
import gunbc.runner_microvm_attempt {
  MicroVmAttempt, runner_microvm_attempt_unit_name,
}
import gunbc.runner_attempt_launch { AttemptGround, GroundClear, GroundOccupied }
import gunbc.runner_microvm_cell_readiness {
  CellIncarnationAdmission, CellIncarnationAdmitted, CellRecoveryRequired,
  CellReadinessWrite, WriteAttemptStarted, WriteReadbackSettled, WriteUnattributedResidue,
}

data runner_microvm_lifecycle_disposition: Disposition = SingleAuthority

// THE HOST-SIDE PER-ATTEMPT LIFECYCLE CONTROLLER, AS THE DECISIONS IT MAKES.
//
// gunbc.runner_microvm names the topology VmmUnderLifecycleController: a controller is the slot
// unit's MainPID, the VMM runs beneath it, and the unit's intent (ExitType=main with
// KillMode=control-group, gunbc#11662) makes systemd's stop reach the whole cgroup once the
// controller exits. This module is what the controller decides at each step, from what it has
// observed; the realization that performs the steps consumes these decisions and adds none.
//
// THE RULE THE WHOLE MODULE IS SHAPED BY: A GUEST EVENT MAY TRIGGER TEARDOWN, AND NO GUEST EVENT
// MAY ESTABLISH SANITATION. The guest is the tenant. "The runner exited 0" and "the guest powered
// off" are statements made by the code whose residue sanitation exists to find, so they can start a
// teardown and can never finish one. That is carried structurally rather than as a rule a caller
// must remember: sanitation_readback_of_host takes only host readbacks, and there is no type through
// which a guest's report could reach it.

// EVERY LIFECYCLE EVENT CARRIES THE ATTEMPT'S WHOLE IDENTITY, because every question this
// controller answers is "about WHICH incarnation". A stop request, a boot report or a readback that
// names only the slot is ambiguous across incarnations, and the ambiguity is exactly how a stop
// meant for the previous incarnation lands on the current one. The host and slot are inside
// MicroVmAttempt; the VMM identity is derived from it rather than carried beside it, so the two
// cannot disagree.
type AttemptIdentity {
  attempt: MicroVmAttempt
  allocation_generation: Int
  invocation_id: NonEmptyStr
  jit_registration_id: NonEmptyStr
  guest_image: RunnerGuestImage
}

fn attempt_identity_vmm(identity: AttemptIdentity) -> NonEmptyStr {
  runner_microvm_attempt_unit_name(attempt: identity.attempt)
}

fn attempt_identity_cell(identity: AttemptIdentity) -> CellId {
  runner_slot_instance_name(slot: identity.attempt.slot) as CellId
}

fn attempt_identity_sandbox(identity: AttemptIdentity) -> SandboxId {
  attempt_identity_vmm(identity: identity) as String as SandboxId
}

// The guest image is not compared: two incarnations of one attempt id at one generation under one
// InvocationID with one registration are one incarnation, and a comparison on a record with no
// equality would be a second spelling of the tuple's identity.
fn attempt_identity_same(a: AttemptIdentity, b: AttemptIdentity) -> Bool {
  (runner_microvm_attempt_unit_name(attempt: a.attempt) as String) == (runner_microvm_attempt_unit_name(attempt: b.attempt) as String)
    && a.allocation_generation == b.allocation_generation
    && (a.invocation_id as String) == (b.invocation_id as String)
    && (a.jit_registration_id as String) == (b.jit_registration_id as String)
}

// THE CONTROLLER STARTS ONLY FROM AN ADMITTED CELL, AND ITS FIRST DURABLE ACT IS THE IN-FLIGHT
// RECORD. The admission is gunbc.runner_microvm_cell_readiness's; the controller does not re-derive
// it. CellRecoveryRequired is not a refusal to do nothing: it is the instruction to run the terminal
// path for the attempt that never settled, before any new attempt is prepared.
type ControllerStart
  = StartAttempt { identity: AttemptIdentity, record: CellReadinessWrite }
  | StartRecovery { cell: CellId, generation: Int, attempt: NonEmptyStr, trigger: TerminalTrigger }
  | StartQuarantineUnattributedResidue { trigger: TerminalTrigger, record: CellReadinessWrite }
  | StartRefused { admission: CellIncarnationAdmission }
  | StartIdentityDisagrees { admitted_generation: Int, identity_generation: Int }

//
// THE GROUND IS gunbc.runner_attempt_launch's AttemptGround, the host's own check for prior attempt
// resources, and it outranks an admitting record: a store that says Ready over a cell whose jail or
// attempt directory is still present is a store that missed something, and the answer is a
// quarantine, not a launch onto the residue. The residue names no attempt the store knows, so the
// controller does not invent one: it records WriteUnattributedResidue at the generation that was
// about to run, which can only quarantine (gunbc.runner_microvm_cell_readiness).
fn controller_start(
  admission: CellIncarnationAdmission,
  ground: AttemptGround,
  identity: AttemptIdentity,
) -> ControllerStart {
  match admission {
    CellIncarnationAdmitted { cell: c, generation: g } =>
      match ground {
        GroundOccupied =>
          StartQuarantineUnattributedResidue {
            trigger: ResourcesFoundOnRecovery,
            record: WriteUnattributedResidue { cell: c, generation: g },
          }
        GroundClear =>
          if g == identity.allocation_generation {
            StartAttempt {
              identity: identity,
              record: WriteAttemptStarted { cell: c, generation: g, attempt: attempt_identity_vmm(identity: identity) },
            }
          } else {
            StartIdentityDisagrees { admitted_generation: g, identity_generation: identity.allocation_generation }
          }
      }
    CellRecoveryRequired { cell: c, generation: g, attempt: a } =>
      StartRecovery { cell: c, generation: g, attempt: a, trigger: ControllerLost }
    refused => StartRefused { admission: refused }
  }
}

// THE BRING-UP PROGRESSION IS A TOTAL ORDER AND EACH STEP IS OBSERVED, NOT ASSUMED.
//
// AttemptPrepared: credential disk and workspace staged by the host, slot network converged. VmmStarted: the host saw
// the jailer's VMM running in the cell's cgroup. GuestBooted and RunnerListening: the guest reported
// them -- these are guest events, admissible here because progression only decides whether the
// slot is SERVING, never whether it is CLEAN. SlotServing: the listener is up and the host has
// nothing left to do but wait for a terminal trigger.
type BringUpPhase
  = AttemptPrepared
  | VmmStarted
  | GuestBooted
  | RunnerListening
  | SlotServing

fn bring_up_rank(phase: BringUpPhase) -> Int {
  match phase {
    AttemptPrepared => 0
    VmmStarted => 1
    GuestBooted => 2
    RunnerListening => 3
    SlotServing => 4
  }
}

type BringUpEvent {
  identity: AttemptIdentity
  reached: BringUpPhase
}

// A SKIPPED PHASE IS A REFUSAL, not a fast path: a runner reporting "listening" before the host saw
// a VMM means the report is not from this attempt's guest, and advancing would let an unrelated
// listener stand for this slot. An event naming a different incarnation is refused before its
// phase is even looked at.
type BringUpTransition
  = BringUpAdvanced { phase: BringUpPhase }
  | BringUpRefusedForeignIncarnation
  | BringUpRefusedOutOfOrder { from: BringUpPhase, to: BringUpPhase }

fn advance_bring_up(live: AttemptIdentity, at: BringUpPhase, event: BringUpEvent) -> BringUpTransition {
  if !attempt_identity_same(a: live, b: event.identity) {
    BringUpRefusedForeignIncarnation
  } else if bring_up_rank(phase: event.reached) == bring_up_rank(phase: at) + 1 {
    BringUpAdvanced { phase: event.reached }
  } else {
    BringUpRefusedOutOfOrder { from: at, to: event.reached }
  }
}

// THE TERMINAL TRIGGERS. Any one of them starts the same teardown, and none of them decides its
// outcome -- which is why RunnerExited carries its exit code and the code goes nowhere: a job that
// succeeded and left a background process is a dirty cell, and there is no parameter downstream
// through which "succeeded" could say otherwise.
type TerminalTrigger
  = VmmExited { exit_code: Int }
  | RunnerExited { exit_code: Int }
  | DeadlineReached
  | StopRequested
  | ControllerLost
  | ResourcesFoundOnRecovery

// A STOP NAMES ITS INCARNATION, and a stop for any other is refused. The warm pool reuses slots,
// so a stop issued against incarnation N that arrives while N + 1 runs is the ordinary late
// delivery, not an exotic race -- honoring it would tear down a job that never asked to stop.
type StopAdmission
  = StopAdmitted { trigger: TerminalTrigger }
  | StopRefusedStaleIncarnation { live_generation: Int, requested_generation: Int }

fn stop_request_admission(live: AttemptIdentity, requested: AttemptIdentity) -> StopAdmission {
  if attempt_identity_same(a: live, b: requested) {
    StopAdmitted { trigger: StopRequested }
  } else {
    StopRefusedStaleIncarnation {
      live_generation: live.allocation_generation,
      requested_generation: requested.allocation_generation,
    }
  }
}

// THE STOP IS GRACEFUL, THEN FORCED, AND THE FORCE IS BOUNDED. What the controller observes is
// which of the three happened; a task that survives the bounded force-stop (uninterruptible sleep
// survives SIGKILL) is not "still stopping", it is a surviving process, and the cell quarantines on
// it whatever the cgroup readback says afterwards.
type TeardownStop
  = StoppedGracefully
  | StoppedByForce
  | ForceStopBoundExceeded { survivors: List<Int> }

// THE CGROUP READBACK IS RECURSIVE, AND A FAILED READ IS ITS OWN ARM. cgroup.procs of the slot's
// cgroup alone misses every process in a child cgroup -- a double-forked daemon moved one level
// down is invisible to it -- so the readback covers the subtree. A read that fails is
// Unobservable, never Empty: "could not read" is the one answer that must not release a cell.
type CgroupSubtreeReadback
  = CgroupSubtreeEmpty
  | CgroupSubtreePopulated { pids: List<Int>, cgroups: List<NonEmptyStr> }
  | CgroupSubtreeReadFailed { reason: NonEmptyStr }

// EACH ATTEMPT RESOURCE IS READ BACK ABSENT FROM THE HOST, separately, because each leaks something
// different (product.fabric.sanitation SanitationFact).
type ResourceReadback
  = ResourceAbsent
  | ResourcePresent { detail: NonEmptyStr }
  | ResourceUnreadable { reason: NonEmptyStr }

// THE SLOT NETWORK IS NOT AN ATTEMPT RESOURCE, SO IT IS NOT READ BACK ABSENT. The tap and nft ruleset
// are slot-scoped converge state (sunny-ant-606 ruling A); the attempt owns only its jail subtree and
// workspace. What must hold after an attempt is that the slot network is QUIESCENT -- no process holds
// the tap, conntrack for the reused guest address is empty, the ruleset digest equals the converged
// one -- and any failure of that is the network fact refuted. `network` carries that verdict; its
// typed producer is gunbc.runner_microvm_network's network readback (networking lane), and until it
// lands this field is the frontier where that readback is consumed.
type HostTeardownReadback {
  stop: TeardownStop
  cgroup: CgroupSubtreeReadback
  mounts: ResourceReadback
  network: ResourceReadback
  attempt_storage: ResourceReadback
  credential_disk: ResourceReadback
}

fn resource_observation(fact: SanitationFact, readback: ResourceReadback) -> SanitationObservation {
  match readback {
    ResourceAbsent => FactConfirmed { fact: fact }
    ResourcePresent { detail: d } => FactRefuted { fact: fact, detail: d }
    ResourceUnreadable { reason: r } => FactUnobservable { fact: fact, reason: r }
  }
}

fn pid_list_text(pids: List<Int>) -> String {
  join(map(pids, p => to_string(p)), ",")
}

fn cgroup_observation(readback: CgroupSubtreeReadback) -> SanitationObservation {
  match readback {
    CgroupSubtreeEmpty => FactConfirmed { fact: CgroupEmpty }
    CgroupSubtreePopulated { pids: p, cgroups: _ } =>
      FactRefuted { fact: CgroupEmpty, detail: join(["pids ", pid_list_text(pids: p), " remain in the cell's cgroup subtree"], "") as NonEmptyStr }
    CgroupSubtreeReadFailed { reason: r } => FactUnobservable { fact: CgroupEmpty, reason: r }
  }
}

// NO SURVIVING PROCESS NEEDS BOTH HOST FACTS: the stop did not exceed its bound, AND the subtree
// holds no pid. Either one alone is refuted by a case the other misses -- the unkillable task
// that later leaves the cgroup listing, and the double-forked daemon the stop never waited for.
fn surviving_process_observation(stop: TeardownStop, cgroup: CgroupSubtreeReadback) -> SanitationObservation {
  match stop {
    ForceStopBoundExceeded { survivors: s } =>
      FactRefuted { fact: NoSurvivingProcesses, detail: join(["pids ", pid_list_text(pids: s), " survived the bounded force-stop"], "") as NonEmptyStr }
    StoppedGracefully => process_observation_of_cgroup(cgroup: cgroup)
    StoppedByForce => process_observation_of_cgroup(cgroup: cgroup)
  }
}

fn process_observation_of_cgroup(cgroup: CgroupSubtreeReadback) -> SanitationObservation {
  match cgroup {
    CgroupSubtreeEmpty => FactConfirmed { fact: NoSurvivingProcesses }
    CgroupSubtreePopulated { pids: p, cgroups: _ } =>
      FactRefuted { fact: NoSurvivingProcesses, detail: join(["pids ", pid_list_text(pids: p), " are still running"], "") as NonEmptyStr }
    CgroupSubtreeReadFailed { reason: r } => FactUnobservable { fact: NoSurvivingProcesses, reason: r }
  }
}

fn host_observations(host: HostTeardownReadback) -> List<SanitationObservation> {
  [
    surviving_process_observation(stop: host.stop, cgroup: host.cgroup),
    cgroup_observation(readback: host.cgroup),
    resource_observation(fact: MountsRemoved, readback: host.mounts),
    resource_observation(fact: NetworkNamespaceRemoved, readback: host.network),
    resource_observation(fact: WritableLayersDeleted, readback: host.attempt_storage),
    resource_observation(fact: SecretsRemoved, readback: host.credential_disk),
  ]
}

// THE ONLY ROUTE FROM A TEARDOWN TO A SanitationReadback, AND ITS PARAMETERS ARE ALL HOST
// READBACKS. The trigger is deliberately absent: it started the teardown and has nothing to say
// about how it ended.
fn sanitation_readback_of_host(identity: AttemptIdentity, host: HostTeardownReadback) -> SanitationReadback {
  SanitationReadback {
    cell: attempt_identity_cell(identity: identity),
    sandbox: attempt_identity_sandbox(identity: identity),
    observations: host_observations(host: host),
  }
}

// THE TERMINAL PATH'S RESULT: the readiness, and the store write that records it at the attempt's
// own generation, so a readback arriving after a newer incarnation's record is refused by the store
// as stale rather than trusted by the controller.
type TeardownSettlement {
  trigger: TerminalTrigger
  readiness: CellReadiness
  record: CellReadinessWrite
}

fn settle_teardown(identity: AttemptIdentity, trigger: TerminalTrigger, host: HostTeardownReadback) -> TeardownSettlement {
  let readiness = cell_readiness_after(readback: sanitation_readback_of_host(identity: identity, host: host))
  TeardownSettlement {
    trigger: trigger,
    readiness: readiness,
    record: WriteReadbackSettled {
      cell: attempt_identity_cell(identity: identity),
      generation: identity.allocation_generation,
      attempt: attempt_identity_vmm(identity: identity),
      readiness: readiness,
    },
  }
}

// BOOT RECOVERY'S SETTLEMENT. After controller loss the full identity tuple may not be recoverable
// (the InvocationID died with the unit), so recovery settles by the store's own record -- the cell,
// generation and attempt the in-flight write named -- which is exactly the key the store checks.
fn settle_recovery(
  cell: CellId,
  generation: Int,
  attempt: NonEmptyStr,
  host: HostTeardownReadback,
) -> CellReadinessWrite {
  let readiness = cell_readiness_after(readback: SanitationReadback {
    cell: cell,
    sandbox: attempt as String as SandboxId,
    observations: host_observations(host: host),
  })
  WriteReadbackSettled { cell: cell, generation: generation, attempt: attempt, readiness: readiness }
}
