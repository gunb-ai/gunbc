  MicrovmPrivilegedReadings, ConvergedNetwork, ConvergeRefused,
  read_slot_wet, read_host_wet, converge_outcome, receipt_text,
  bind_requested_host, expected_host_reading, host_binding_refusal_text,
  HostBindingHeld, HostBindingRefused, HostBindingUnnamed,
  converge_generation_reading, runner_microvm_network_slot_identities_of,
  runner_microvm_network_receipt_path, runner_microvm_network_receipt_dir,
}
import gunbc.runner_microvm_network_apply { runner_microvm_administrator_target }

// THE OBSERVE READS AS TWO PRINCIPALS, AND WHICH ONE READS WHAT IS THE POINT.
//
// ConvergedSlotNetwork says what a host IS at a generation, so every fact it carries must be a live
// reading. Five of them -- the installed table's listing (whose digest is the converged digest), the
// whole ruleset, the legacy xtables rules, the userspace conntrack helpers and the conntrack
// expectations -- are readable only by root. The job user this step runs as is granted none of
// them, and must not be: operator decision 2026-09-22 keeps gunbc-ghrunner.sudoers modeled and
// uninstalled, because the principal every CI step runs as holding even readbacks is a grant with
// no need behind it once the administrator can read. So those five are read by the host's
// ADMINISTRATOR, gunbc.fleet_bootstrap_principal executor_bootstrap_principal, over the fleet SSH
// edge -- the same principal and the same target gunbc.runner_microvm_network_apply installs through
// -- and everything an unprivileged principal CAN read (procfs, ip, uname) is still read locally.
//
// The first observe run after the apply landed (fleet-converge run 35853748081) refused with
// `the installed ruleset could not be listed`: the listing was attempted as the job user with no
// grant. That refusal was correct and is the reading this module answers, not one it relaxes.

// A READING THAT DID NOT RUN IS NOT AN EMPTY READING. A refused edge or a non-zero exit is
// ProcessRefused, so the fold refuses by name; only an exit-zero leg with no output is
// ProcessOutputAbsent, which for conntrack's expectation table is a real, empty reading.
fn admin_read_outcome(
  target: SshTarget,
  context: FleetSshExecutionContext,
  op: ExecutorPrivilegedOperation,
) -> ProcessOutcome
{
  let argv = elevated_argv(command: map(executor_privileged_operation_argv(op: op), w => w as String))
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv) {
    TypedArgvExecRefused { reason: why } => ProcessRefused { exit_code: -1, stderr: why }
    TypedArgvExecConverged { result: r } =>
      if r.exit_code != 0 {
        ProcessRefused { exit_code: r.exit_code, stderr: trim(s: r.stderr) }
      } else if r.stdout == "" {
        ProcessOutputAbsent
      } else {
        ProcessOutputPresent { text: r.stdout }
      }
  }
}

fn read_privileged_over_admin_edge(target: SshTarget, context: FleetSshExecutionContext) -> MicrovmPrivilegedReadings
{
  MicrovmPrivilegedReadings {
    table: admin_read_outcome(target: target, context: context, op: runner_microvm_nft_read_operation()),
    ruleset: admin_read_outcome(target: target, context: context, op: ReadNftRuleset),
    xtables: admin_read_outcome(target: target, context: context, op: ReadLegacyXtablesRules),
    userspace: admin_read_outcome(target: target, context: context, op: ReadUserspaceConntrackHelpers),
    expectations: admin_read_outcome(target: target, context: context, op: ReadConntrackExpectations),
  }
}

data runner_microvm_network_observe_attempt_raw: String = "runner-microvm-network-observe-ci"

fn runner_microvm_network_observe_wet() -> ProcessExit
{
  let host_reading = hostname_short_read(transport: LocalShell)
  match host_reading {
    HostnameShortCaptureRefused { reason: r } =>
      exit_failure(reason: join(["microvm-network-observe: the host could not name itself: ", r], ""))
    HostnameShortCaptured { value: name } =>
      match bind_requested_host(expected: expected_host_reading(), observed: name) {
        HostBindingUnnamed { detail: d } =>
          exit_failure(reason: host_binding_refusal_text(b: HostBindingUnnamed { detail: d }))
        HostBindingRefused { expected: e, observed: o } =>
          exit_failure(reason: host_binding_refusal_text(b: HostBindingRefused { expected: e, observed: o }))
        HostBindingHeld { host: bound } => observe_bound_host_wet(bound: bound)
      }
  }
}

fn observe_bound_host_wet(bound: HostIdentity) -> ProcessExit
{
  let generation = converge_generation_reading()
  if generation == "" {
    exit_failure(reason: "microvm-network-observe: no run identity in the environment, so the receipt would carry a generation nobody can compare against")
  } else {
    match runner_host_deploy_for(host: bound) {
      RunnerHostDeployUnmodeled { host: h } =>
        exit_failure(reason: join(["microvm-network-observe: ", h as String, " is not a modeled runner host"], ""))
      RunnerHostDeployRefused { host: h, cause: c } =>
        exit_failure(reason: join(["microvm-network-observe: ", h as String, " refuses its deploy row: ", c], ""))
      RunnerHostDeployFound { deploy: d } =>
        observe_admitted_host_wet(deploy: d, host: bound, generation: generation as NonEmptyStr)
    }
  }
}

// THE READER OF THE ROOT-ONLY SURFACES MAY NOT BE THE JOB USER, for the reason the apply refuses on:
// reading "as the administrator" when the administrator IS the job user would mean the job user
// holds the reads, which is the grant this module exists not to need.
fn observe_admitted_host_wet(deploy: RunnerHostDeploy, host: HostIdentity, generation: NonEmptyStr) -> ProcessExit
{
  if !bootstrap_principal_is_not_the_grantee(bootstrap: executor_bootstrap_principal, deploy: deploy) {
    exit_failure(reason: join(["microvm-network-observe: the administrator principal ", executor_bootstrap_principal.login as String, " is the job user on ", host as String, ", so the root-only readings would be taken by the account CI jobs run as"], ""))
  } else {
    match prepare_fleet_ssh_agent_context(attempt_raw: runner_microvm_network_observe_attempt_raw) {
      FleetSshContextRefused { cause: c } => exit_failure(reason: join(["microvm-network-observe: ", c], ""))
      FleetSshContextReady { context: context, receipt: _ } =>
        record_converge_readback_wet(
          slots: runner_microvm_network_slot_identities_of(deploy: deploy),
          host: host,
          generation: generation,
          reads: read_privileged_over_admin_edge(target: runner_microvm_administrator_target(host: host), context: context),
        )
    }
  }
}

fn record_converge_readback_wet(
  slots: List<RunnerSlotIdentity>,
  host: HostIdentity,
  generation: NonEmptyStr,
  reads: MicrovmPrivilegedReadings,
) -> ProcessExit {
  let outcome = converge_outcome(
    slots: map(slots, s => read_slot_wet(slot: s)),
    h: read_host_wet(host: host, generation: generation as ConvergeGeneration, reads: reads),
  )
  let text = receipt_text(o: outcome)
  let _ = run_shell_commands(commands: [mkdir_parents_command(path: runner_microvm_network_receipt_dir)], transport: LocalExec)
  let w = Filesystem.Write(path: runner_microvm_network_receipt_path, content: text)
  if !w.success {
    exit_failure(reason: join(["microvm-network-observe: receipt write refused: ", w.error], ""))
  } else {
    match outcome {
      ConvergedNetwork { receipt: _ } => ExitSuccess
      ConvergeRefused { refusal: _ } => exit_failure(reason: join(["microvm-network-observe: ", text], ""))
    }
  }
}
