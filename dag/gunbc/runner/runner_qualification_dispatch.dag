module gunbc.runner.runner_qualification_dispatch

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.resources { Network }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.decl_ref { decl_ref }
import extdeps.transports.rest { RestOutcome, RestOk }
import extdeps.github.actions { DispatchInput, InputString }
import extdeps.github.workflows { WorkflowDispatchReceipt }
import extdeps.github.workflow_runs {
  WorkflowRun, WorkflowRunStatus, Completed, WorkflowRunConclusion, WorkflowJobRun, WorkflowJobRunList,
}
import gunbc.runner_throughput_qualification_route {
  QualificationInstrument, qualification_instruments,
  FloorPhaseRows, FloorCgroupRows, ClaimCostArtifactEvalSteps, CalibrationSpecimenWitnessLine,
  GuestIdleMeminfoAndNproc, ConcurrentCohortSeatWindows,
}
import gunbc.required_ci_phase_roster {
  FloorPhaseRow, FloorPhaseTimed, FloorPhaseUntimed, FloorPhaseRowReading, FloorPhaseRowRead, FloorPhaseRowGarbled,
  read_floor_phase_row,
}
import gunbc.witness_floor_workflow { required_floor_claim_cost_artifact_name }
import extdeps.github.actions_artifacts { ActionsArtifact, ActionsArtifactList }
import gunbc.host_budget_source {
  FloorCgroupLevelRow, FloorCgroupRowReading, FloorCgroupLevelRead, FloorCgroupRowGarbled,
  read_floor_cgroup_level_row,
}

// THE DISPATCH LEG OF THE QUALIFICATION ROUTE, AND THE COLLECT STAGE THAT READS ITS RUN BACK.
//
// The route registers one ephemeral slot whose label set carries a per-boot attempt label
// (gunbc.runner_throughput_qualification_route ephemeral_slot_labels). Dispatching the floor to that
// slot is a workflow_dispatch whose input IS the attempt label, so the target workflow's runs-on can
// name it and no other registration in the organization can serve the job. This module is the
// production caller of extdeps.github.workflows github.Workflows CreateDispatch; its landing is what
// dissolved that module's unconsumed-operation frontier.
//
// WHICH WORKFLOW IS A PARAMETER. The fleet-converge mode that becomes this route belongs to
// gunbc.fleet_converge_workflow and lands with the boot leg; naming a workflow file here before that
// mode exists would be a second spelling of a fact whose home is not yet written. What this module
// does own is the input the target workflow must declare: qualification_attempt_dispatch_input is
// the DispatchInput row the workflow side consumes, and the dispatch map is keyed by its name, so
// the key the dispatch sends and the key the workflow declares are one declaration.
//
// AUTHORIZATION IS THE DISPATCHING RUN'S (operator ruling 2026-10-03): CreateDispatch authenticates
// with the running job's GITHUB_TOKEN (the service config's auth_source), with no per-dispatch
// approval. gunbc.auth.privileged_effect_census rows dispatch_qualification_floor through
// gunbc.auth.authorization_pattern_selection.

data qualification_attempt_dispatch_input: DispatchInput = DispatchInput {
  name: "runner_attempt_label",
  description: Present { value: "the per-boot attempt label the ephemeral qualification slot registered with; runs-on names it" },
  required: true,
  default: none,
  type: InputString,
}

type QualificationWorkflowTarget {
  owner: NonEmptyStr
  repo: NonEmptyStr
  workflow_id: NonEmptyStr
  ref: NonEmptyStr
}

fn qualification_dispatch_inputs(attempt: NonEmptyStr) -> Map<String, String> {
  map_insert(m: empty_map(), key: qualification_attempt_dispatch_input.name, value: attempt as String)
}

// A DISPATCH IS ONE ATTEMPT AND ITS ANSWER IS THE RECEIPT OR THE REFUSAL, never a run assumed to
// exist. The run id comes from GitHub's 2026-03-10 response (WorkflowDispatchReceipt); a refused or
// unreached request carries its RestOutcome and mints no run.
//
// THE DISPATCHED RUN IS SEALED, AND THAT IS WHAT PUTS COLLECTION CAUSALLY AFTER DISPATCH.
// WorkflowDispatchReceipt is a plain upstream record anyone can write, so a collect fold taking one
// would read back whatever run id a caller named. DispatchedQualificationRun is sole_constructor:
// only this file can write it, and in this file only dispatch_qualification_floor does, from a
// RestOk answer. collect_qualification_run takes that value, so no run is collected that this
// module did not dispatch, for this target and this attempt.
type DispatchedQualificationRun sole_constructor {
  target: QualificationWorkflowTarget
  attempt: NonEmptyStr
  receipt: WorkflowDispatchReceipt
}

type QualificationDispatch
  = QualificationDispatched { run: DispatchedQualificationRun }
  | QualificationDispatchRefused { attempt: NonEmptyStr, outcome: RestOutcome }

fn dispatch_qualification_floor(target: QualificationWorkflowTarget, attempt: NonEmptyStr) -> QualificationDispatch uses net: Network {
  let answered = github.Workflows.CreateDispatch(
    owner: target.owner as String,
    repo: target.repo as String,
    workflow_id: target.workflow_id as String,
    ref: target.ref as String,
    inputs: qualification_dispatch_inputs(attempt: attempt),
  )
  match answered.outcome {
    RestOk =>
      QualificationDispatched {
        run: DispatchedQualificationRun {
          target: target,
          attempt: attempt,
          receipt: WorkflowDispatchReceipt {
            workflow_run_id: answered.workflow_run_id,
            run_url: answered.run_url,
            html_url: answered.html_url,
          },
        },
      }
    other => QualificationDispatchRefused { attempt: attempt, outcome: other }
  }
}

// ── COLLECT: THE RUN READ BACK, ENSURE-STYLE ──────────────────────────────────────────────────
//
// THE SUBJECT IS THE DISPATCHED RUN, CHECKED ON THE READBACK: the run read must carry the id the
// dispatch returned and the workflow_dispatch event, and every job listed must belong to it;
// anything else is RunSubjectMismatch, never a collection of some other run.
//
// A DISPATCH RECEIPT SAYS A RUN EXISTS, NOT THAT THE ATTEMPT'S RUNNER SERVED IT. The collection
// therefore decides only from what GitHub reports about the run now: the run must be Completed with
// a conclusion, and at least one of its jobs must carry the attempt label and have started -- that
// is, been taken by a runner registered under the attempt. A run that finished without that is the
// typed refusal RunNeverReachedAttemptRunner, carrying every job's labels so the cause is located;
// it is never collected as a measurement of a host that did not run it.
//
// THE CONCLUSION IS READ BACK AND CARRIED, NOT FILTERED: a failed floor on the attempt's runner is
// still a run of this host and the receipt says how it ended.

type QualificationRunRefusal
  = RunReadUnreadable { outcome: RestOutcome }
  | RunNotCompleted { status: WorkflowRunStatus }
  | RunCompletedWithoutConclusion
  | RunJobsUnreadable { outcome: RestOutcome }
  | RunJobsTruncated { returned: Int, total: Int }
  | RunNeverReachedAttemptRunner { job_labels: List<List<String>> }
  | RunSubjectMismatch { observed_run_id: Int, observed_event: String, foreign_job_run_ids: List<Int> }

// A COLLECTED RUN IS A RUN THE ATTEMPT'S RUNNER SERVED, AND NOTHING YET ABOUT WHAT IT MEASURED. The
// instruments are read from it afterwards (extract_qualification_instruments), because reading them
// costs one log download per served job and that is only owed once the run is known to be this host's.
//
// THE SUCCESS PAYLOAD IS SEALED: CollectedQualificationRun is sole_constructor, written only by
// conclude_qualification_run, whose callers are admitted by name -- the one production reader,
// collect_qualification_run, and the witness claims that supply readbacks at that interface. An
// admit list constrains the call edge, not where the result goes, so every admitted witness entry
// is a `test fn` returning Bool that consumes the collection internally; a helper returning the
// collection would be a public constructor proxy, and none is admitted. collect_qualification_run
// returns the collection, but only from a sealed DispatchedQualificationRun.
// A module elsewhere cannot mint "this host ran the floor" without a readback.
type CollectedQualificationRun sole_constructor {
  attempt: NonEmptyStr
  run_id: Int
  conclusion: WorkflowRunConclusion
  attempt_jobs: List<WorkflowJobRun>
}

type QualificationRunCollection
  = QualificationRunCollected { collected: CollectedQualificationRun }
  | QualificationRunRefused { attempt: NonEmptyStr, run_id: Int, refusal: QualificationRunRefusal }

fn job_served_by_attempt(job: WorkflowJobRun, attempt: NonEmptyStr) -> Bool {
  (job.labels |> any(l => l == (attempt as String)))
    && (match job.started_at { Present { value: _ } => true Absent => false })
}

fn refuse_run(attempt: NonEmptyStr, run_id: Int, refusal: QualificationRunRefusal) -> QualificationRunCollection {
  QualificationRunRefused { attempt: attempt, run_id: run_id, refusal: refusal }
}

fn conclude_qualification_run(
  attempt: NonEmptyStr,
  run_id: Int,
  run_outcome: RestOutcome,
  run: WorkflowRun,
  jobs_outcome: RestOutcome,
  jobs: WorkflowJobRunList,
) -> QualificationRunCollection
  admit_callers: [
    decl_ref(module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "collect_qualification_run"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_completed_run_served_by_the_attempt_runner_is_collected_with_its_conclusion"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_run_the_attempt_runner_never_served_refuses_with_the_labels_it_saw"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "an_unfinished_or_unconcluded_run_refuses_rather_than_collecting"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_truncated_or_unreadable_readback_refuses"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_readback_of_another_run_refuses_on_the_subject"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_log_with_phase_rows_and_the_slot_level_is_read"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_garbled_row_refuses_rather_than_being_skipped"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "a_log_missing_either_reading_refuses_with_what_it_saw"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "an_unreadable_log_reads_nothing"),
    decl_ref(module_path: "test.claim.runner_qualification_dispatch_witness", decl_name: "the_extraction_reads_a_recorded_required_floor_log"),
  ]
{
  match run_outcome {
    RestOk =>
      if run.id != run_id || run.event != "workflow_dispatch" {
        refuse_run(attempt: attempt, run_id: run_id, refusal: RunSubjectMismatch { observed_run_id: run.id, observed_event: run.event, foreign_job_run_ids: [] })
      } else {
      match run.status {
        Completed =>
          match run.conclusion {
            Absent => refuse_run(attempt: attempt, run_id: run_id, refusal: RunCompletedWithoutConclusion)
            Present { value: conclusion } =>
              match jobs_outcome {
                RestOk =>
                  if count(jobs.jobs) != jobs.total_count {
                    refuse_run(attempt: attempt, run_id: run_id, refusal: RunJobsTruncated { returned: count(jobs.jobs), total: jobs.total_count })
                  } else {
                    let foreign = jobs.jobs |> filter(j => j.run_id != run_id) |> map(j => j.run_id)
                    if count(foreign) != 0 {
                      refuse_run(attempt: attempt, run_id: run_id, refusal: RunSubjectMismatch { observed_run_id: run.id, observed_event: run.event, foreign_job_run_ids: foreign })
                    } else {
                    let served = jobs.jobs |> filter(j => job_served_by_attempt(job: j, attempt: attempt))
                    if count(served) == 0 {
                      refuse_run(attempt: attempt, run_id: run_id, refusal: RunNeverReachedAttemptRunner { job_labels: jobs.jobs |> map(j => j.labels) })
                    } else {
                      QualificationRunCollected {
                        collected: CollectedQualificationRun {
                          attempt: attempt,
                          run_id: run_id,
                          conclusion: conclusion,
                          attempt_jobs: served,
                        },
                      }
                    }
                    }
                  }
                other => refuse_run(attempt: attempt, run_id: run_id, refusal: RunJobsUnreadable { outcome: other })
              }
          }
        other => refuse_run(attempt: attempt, run_id: run_id, refusal: RunNotCompleted { status: other })
      }
      }
    other => refuse_run(attempt: attempt, run_id: run_id, refusal: RunReadUnreadable { outcome: other })
  }
}

fn qualification_run_collected(c: QualificationRunCollection) -> Bool {
  match c {
    QualificationRunCollected { collected: _ } => true
    QualificationRunRefused { attempt: _, run_id: _, refusal: _ } => false
  }
}

fn collect_qualification_run(dispatched: DispatchedQualificationRun) -> QualificationRunCollection uses net: Network {
  let target = dispatched.target
  let run_id = dispatched.receipt.workflow_run_id as String
  let read = github.WorkflowRuns.GetRun(auth_token: "", owner: target.owner as String, repo: target.repo as String, run_id: run_id)
  let jobs = github.WorkflowRuns.ListJobs(auth_token: "", owner: target.owner as String, repo: target.repo as String, run_id: run_id)
  conclude_qualification_run(
    attempt: dispatched.attempt,
    run_id: dispatched.receipt.workflow_run_id,
    run_outcome: read.outcome,
    run: read.run,
    jobs_outcome: jobs.outcome,
    jobs: jobs.result,
  )
}

// ── EXTRACT: THE INSTRUMENTS READ FROM THE COLLECTED RUN ──────────────────────────────────────
//
// WHERE EACH INSTRUMENT IS READ FROM IS A TOTAL MATCH, so adding an instrument to
// gunbc.runner_throughput_qualification_route QualificationInstrument refuses to compile here until it
// says where its reading comes from. Two are this run's job log, read now. Two are this run's
// required-floor-claim-cost artifact, whose read is attempted on every collection and today ends in a
// typed refusal (read_claim_cost_artifact); two are not outputs of this run at all. Each of those four
// is carried by a row below with the capability that would read it.
type QualificationInstrumentSource
  = ReadFromAttemptJobLog
  | ReadFromClaimCostArtifact
  | ReadFromBootLegReadback
  | ReadFromCohortObservation

fn qualification_instrument_source(i: QualificationInstrument) -> QualificationInstrumentSource {
  match i {
    FloorPhaseRows => ReadFromAttemptJobLog
    FloorCgroupRows => ReadFromAttemptJobLog
    ClaimCostArtifactEvalSteps => ReadFromClaimCostArtifact
    CalibrationSpecimenWitnessLine => ReadFromClaimCostArtifact
    GuestIdleMeminfoAndNproc => ReadFromBootLegReadback
    ConcurrentCohortSeatWindows => ReadFromCohortObservation
  }
}

fn qualification_instrument_read_from_job_log(i: QualificationInstrument) -> Bool {
  match qualification_instrument_source(i: i) {
    ReadFromAttemptJobLog => true
    _ => false
  }
}

// ONE SERVED JOB'S LOG, AS GITHUB ANSWERED IT. An unreadable log carries the RestOutcome it came with
// -- a 410 for a log past retention, RestBodyUndecodable for a body the handler could not read whole --
// and is never read as an empty log.
type AttemptJobLog
  = AttemptJobLogRead { job_id: Int, log: String }
  | AttemptJobLogUnreadable { job_id: Int, outcome: RestOutcome }

// THE READINGS. Phase rows are every [floor-phase] row the served jobs printed, timed and untimed, in
// log order; the cgroup rows are only the [floor-cgroup] rows at the SLOT's own level, because the
// levels above it (the runner slice, the system slice) are other subjects' memory and a qualification
// of this slot must not take their peak for its own.
type QualificationLogReadings {
  floor_phase_rows: List<FloorPhaseRow>
  slot_cgroup_rows: List<FloorCgroupLevelRow>
}

type InstrumentReadRefusal
  = JobLogUnreadable { job_id: Int, outcome: RestOutcome }
  | FloorPhaseRowGarbledInLog { job_id: Int, line: String, cause: NonEmptyStr }
  | FloorCgroupRowGarbledInLog { job_id: Int, line: String, cause: NonEmptyStr }
  | FloorPhaseRowsAbsent
  | SlotCgroupLevelAbsent { slot_unit: NonEmptyStr, levels_seen: List<String> }

type QualificationInstrumentExtraction
  = QualificationInstrumentsRead {
      attempt: NonEmptyStr
      run_id: Int
      conclusion: WorkflowRunConclusion
      readings: QualificationLogReadings
      claim_cost: ClaimCostArtifactRead
    }
  | QualificationInstrumentsRefused { attempt: NonEmptyStr, run_id: Int, refusal: InstrumentReadRefusal }

// One log's rows, or the first row that could not be read. A garbled row stops the read: a reading
// assembled around a row it skipped would report a phase or a level as absent that the run printed.
type JobLogRowsReading
  = JobLogRowsRead { phases: List<FloorPhaseRow>, levels: List<FloorCgroupLevelRow> }
  | JobLogRowsRefused { refusal: InstrumentReadRefusal }

fn read_job_log_line(acc: JobLogRowsReading, job_id: Int, line: String) -> JobLogRowsReading {
  match acc {
    JobLogRowsRefused { refusal: _ } => acc
    JobLogRowsRead { phases: ps, levels: ls } =>
      match read_floor_phase_row(line: line) {
        Present { value: FloorPhaseRowGarbled { line: l, cause: c } } =>
          JobLogRowsRefused { refusal: FloorPhaseRowGarbledInLog { job_id: job_id, line: l, cause: c } }
        Present { value: FloorPhaseRowRead { row: r } } => JobLogRowsRead { phases: list_push(ps, r), levels: ls }
        Absent =>
          match read_floor_cgroup_level_row(line: line) {
            Present { value: FloorCgroupRowGarbled { line: l, cause: c } } =>
              JobLogRowsRefused { refusal: FloorCgroupRowGarbledInLog { job_id: job_id, line: l, cause: c } }
            Present { value: FloorCgroupLevelRead { row: r } } => JobLogRowsRead { phases: ps, levels: list_push(ls, r) }
            Absent => acc
          }
      }
  }
}

fn read_job_log_rows(acc: JobLogRowsReading, log: AttemptJobLog) -> JobLogRowsReading {
  match acc {
    JobLogRowsRefused { refusal: _ } => acc
    JobLogRowsRead { phases: _, levels: _ } =>
      match log {
        AttemptJobLogUnreadable { job_id: j, outcome: o } => JobLogRowsRefused { refusal: JobLogUnreadable { job_id: j, outcome: o } }
        AttemptJobLogRead { job_id: j, log: text } =>
          fold(split(s: text, delimiter: "\n"), init: acc, f: (a, line) => read_job_log_line(acc: a, job_id: j, line: line))
      }
  }
}

fn level_is_slot(row: FloorCgroupLevelRow, slot_unit: NonEmptyStr) -> Bool {
  ends_with(s: row.level as String, suffix: concat("/", slot_unit as String))
}

// THE SUPPLIED-INPUT BOUNDARY. Everything the extraction decides is decided here from the sealed
// collection and the reads as they came back; collect_qualification_instruments below is the only
// caller that reaches the network, and it does nothing but perform the reads and hand them in. The
// collection is CollectedQualificationRun and not the collection sum, so an extraction exists only for
// a run conclude_qualification_run admitted -- a refused run has nothing to extract and is not asked.
fn extract_qualification_instruments(
  collected: CollectedQualificationRun,
  logs: List<AttemptJobLog>,
  claim_cost: ClaimCostArtifactRead,
  slot_unit: NonEmptyStr,
) -> QualificationInstrumentExtraction {
  let attempt = collected.attempt
  let run_id = collected.run_id
  match fold(logs, init: JobLogRowsRead { phases: [], levels: [] }, f: (acc, l) => read_job_log_rows(acc: acc, log: l)) {
    JobLogRowsRefused { refusal: r } => QualificationInstrumentsRefused { attempt: attempt, run_id: run_id, refusal: r }
    JobLogRowsRead { phases: phases, levels: levels } => {
      let slot_levels = levels |> filter(l => level_is_slot(row: l, slot_unit: slot_unit))
      let timed = phases |> filter(p => match p { FloorPhaseTimed { phase: _, wall_ms: _ } => true FloorPhaseUntimed { phase: _ } => false })
      if count(timed) == 0 {
        QualificationInstrumentsRefused { attempt: attempt, run_id: run_id, refusal: FloorPhaseRowsAbsent }
      } else if count(slot_levels) == 0 {
        QualificationInstrumentsRefused {
          attempt: attempt,
          run_id: run_id,
          refusal: SlotCgroupLevelAbsent { slot_unit: slot_unit, levels_seen: levels |> map(l => l.level as String) },
        }
      } else {
        QualificationInstrumentsRead {
          attempt: attempt,
          run_id: run_id,
          conclusion: collected.conclusion,
          readings: QualificationLogReadings { floor_phase_rows: phases, slot_cgroup_rows: slot_levels },
          claim_cost: claim_cost,
        }
      }
    }
  }
}

fn read_attempt_job_log(target: QualificationWorkflowTarget, job: WorkflowJobRun) -> AttemptJobLog uses net: Network {
  let read = github.WorkflowRuns.DownloadJobLogsForWorkflowRun(
    auth_token: "",
    owner: target.owner as String,
    repo: target.repo as String,
    job_id: job.id as String,
  )
  match read.outcome {
    RestOk => AttemptJobLogRead { job_id: job.id, log: read.log }
    other => AttemptJobLogUnreadable { job_id: job.id, outcome: other }
  }
}

// THE CLAIM-COST ARTIFACT, READ AS FAR AS ANY BOUND REALIZATION CAN READ IT. It is looked up by the
// name the floor workflow uploads it under (gunbc.witness_floor_workflow
// required_floor_claim_cost_artifact_name), downloaded through GitHub's redirect, and every way that
// can fail is its own arm. An archive that DID arrive is still not a reading: it is a zip, and no
// inflate reader exists to take the TSV out of it, so that arm says so instead of passing bytes on
// as if they were the TSV. There is deliberately no parsed arm yet; it lands with the capability the
// parse_claim_cost_tsv row of qualification_instrument_extraction_frontier_rows names, at which point
// this read hands the member to gunbc.floor_cost_distribution parse_claim_cost_tsv.
type ClaimCostArtifactRead
  = ClaimCostArtifactListUnreadable { outcome: RestOutcome }
  | ClaimCostArtifactListTruncated { returned: Int, total: Int }
  | ClaimCostArtifactAbsent { names_seen: List<String> }
  | ClaimCostArtifactExpired { artifact_id: Int }
  | ClaimCostArchiveUnreadable { artifact_id: Int, outcome: RestOutcome }
  | ClaimCostArchiveNotInflatable { artifact_id: Int }

fn claim_cost_artifact_listed(outcome: RestOutcome, listed: ActionsArtifactList) -> ActionsArtifact? {
  match outcome {
    RestOk => listed.artifacts |> filter(a => a.name == required_floor_claim_cost_artifact_name) |> first
    _ => none
  }
}

fn conclude_claim_cost_listing(outcome: RestOutcome, listed: ActionsArtifactList) -> ClaimCostArtifactRead? {
  match outcome {
    RestOk =>
      if count(listed.artifacts) != listed.total_count {
        Present { value: ClaimCostArtifactListTruncated { returned: count(listed.artifacts), total: listed.total_count } }
      } else {
        match claim_cost_artifact_listed(outcome: outcome, listed: listed) {
          Absent => Present { value: ClaimCostArtifactAbsent { names_seen: listed.artifacts |> map(a => a.name) } }
          Present { value: a } =>
            if a.expired { Present { value: ClaimCostArtifactExpired { artifact_id: a.id } } } else { none }
        }
      }
    other => Present { value: ClaimCostArtifactListUnreadable { outcome: other } }
  }
}

fn conclude_claim_cost_download(artifact_id: Int, outcome: RestOutcome) -> ClaimCostArtifactRead {
  match outcome {
    RestOk => ClaimCostArchiveNotInflatable { artifact_id: artifact_id }
    other => ClaimCostArchiveUnreadable { artifact_id: artifact_id, outcome: other }
  }
}

fn read_claim_cost_artifact(target: QualificationWorkflowTarget, run_id: Int) -> ClaimCostArtifactRead uses net: Network {
  let listed = github.Artifacts.ListWorkflowRunArtifacts(
    auth_token: "",
    owner: target.owner as String,
    repo: target.repo as String,
    run_id: run_id as String,
  )
  match conclude_claim_cost_listing(outcome: listed.outcome, listed: listed.result) {
    Present { value: refused } => refused
    Absent =>
      match claim_cost_artifact_listed(outcome: listed.outcome, listed: listed.result) {
        Absent => ClaimCostArtifactAbsent { names_seen: [] }
        Present { value: a } => {
          let archive = github.Artifacts.DownloadArtifact(
            auth_token: "",
            owner: target.owner as String,
            repo: target.repo as String,
            artifact_id: a.id as String,
          )
          conclude_claim_cost_download(artifact_id: a.id, outcome: archive.outcome)
        }
      }
  }
}

fn collect_qualification_instruments(
  target: QualificationWorkflowTarget,
  collected: CollectedQualificationRun,
  slot_unit: NonEmptyStr,
) -> QualificationInstrumentExtraction uses net: Network {
  let logs = collected.attempt_jobs |> map(j => read_attempt_job_log(target: target, job: j))
  let claim_cost = read_claim_cost_artifact(target: target, run_id: collected.run_id)
  extract_qualification_instruments(collected: collected, logs: logs, claim_cost: claim_cost, slot_unit: slot_unit)
}

// ── THE INSTRUMENTS THIS RUN'S LOG DOES NOT CARRY, EACH WITH THE CAPABILITY THAT WOULD READ IT ──
//
// The extraction above reads every instrument qualification_instrument_source places on the job
// log. The remaining four are three facts, so three rows: one per missing capability, so that each
// row is retired by its own trigger and by nothing else.
data qualification_instrument_extraction_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.floor_cost_distribution", decl_name: "parse_claim_cost_tsv"),
    reason: "ClaimCostArtifactEvalSteps and CalibrationSpecimenWitnessLine are both read from the required-floor-claim-cost TSV (gunbc.floor_cost_distribution parse_claim_cost_tsv; the calibration specimen's row is joined there by calibration_specimen_grounding). Neither is on the job log: on the recorded required-floor log of run 35048059968 / job 104642384772 (test.fixture recorded_required_floor_log_excerpt), there are zero [witness] lines and zero occurrences of the specimen identity test.claim.floor_eval_step_calibration_specimen_test.calibration_specimen_performs_its_declared_work, and eval_steps appear only on the [over-cost] preview, a 25-row truncated view that is not the instrument and is not read as one. Two capabilities are missing. FIRST, the required workflow no longer uploads the artifact: cli_run write_required_floor_claim_cost_tsv still writes the TSV, but the emission of .github/workflows/witnesses.yml by gunbc.compiler_gate_workflow carries no upload step for it, and recent required runs publish only required-ci-measurement-receipt and compiler-pair-candidate. SECOND, an uploaded artifact is always a zip, and the REST handler reads every body as UTF-8 text (extdeps.transports.rest RestBodyObservation body: String), so extdeps.github.actions_artifacts github.Artifacts DownloadArtifact answers RestBodyUndecodable. read_claim_cost_artifact attempts the read on every collection and carries the result as a typed ClaimCostArtifactRead refusal (ClaimCostArtifactAbsent while nothing uploads it)",
    dissolution: unbound_dissolution(description: "BOTH capabilities hold. (1) The required workflow uploads required-floor-claim-cost again, as an upload step in the existing floor job emitted by gunbc.compiler_gate_workflow under gunbc.witness_floor_workflow required_floor_claim_cost_artifact_name -- an emission change, not a new job. (2) The REST transport carries a binary body and an inflate reader can take one member out of one upload-artifact zip. Together these are SUFFICIENT FOR extract_qualification_instruments to read ClaimCostArtifactEvalSteps and CalibrationSpecimenWitnessLine from the same collected run through parse_claim_cost_tsv, and for qualification_instrument_source to place both on that read. NOT satisfied by either capability alone, by the [over-cost] preview or any other truncated view, by a new print of eval_steps into the log, or by an artifact downloaded outside this route"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "gunbc.runner_throughput_qualification_route", decl_name: "mtcollins1_boot_leg"),
    reason: "GuestIdleMeminfoAndNproc is not a run output: the guest's idle MemTotal, MemAvailable (extdeps.linux.proc_meminfo), nproc and uname -m are read before the job starts, by the boot leg's runner-host-up readback, and that leg is gunbc.runner_throughput_qualification_route mtcollins1_boot_leg, still LegAwaitingAuthority",
    dissolution: unbound_dissolution(description: "the boot leg's terminal is the runner host observed up and its readback carries the guest's idle meminfo, nproc and machine word, SUFFICIENT FOR this route to hand that readback to the qualification receipt beside this run's extraction. NOT satisfied by a meminfo read inside the floor job, which is a loaded guest rather than an idle one"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "product.capacity.cohort_observation", decl_name: "seal_cohort"),
    reason: "ConcurrentCohortSeatWindows is sealed by product.capacity.cohort_observation seal_cohort over a roster of seats released at one barrier, each with ready, start and end instants and a settlement. This route registers ONE ephemeral slot and dispatches one floor, so there is no cohort and no barrier to read; one job's started_at and completed_at are not a seat window",
    dissolution: unbound_dissolution(description: "a qualification route that registers a roster of concurrent seats on the host, releases them at a barrier, and reads each seat's ready, start and end back, SUFFICIENT FOR seal_cohort to seal that reading for this host. NOT satisfied by a cohort of one, nor by job timestamps standing in for seat readiness"),
  ),
]
