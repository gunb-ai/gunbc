module gunbc.runner.runner_lifecycle_realize

import std.dissolution { DissolutionCondition, unbound_dissolution }

import gunbc.host.host_effect {
  HostEffectIntent,
  HostEffectEvidence,
  HostEffectTransport,
  ShellEffectApplied,
  LocalShell, SshShell, FleetSsh, EmitArtifactThenThinRun,
  ActivateRunnerSlot, DrainAndMaskRunnerSlot,
}
import std.realization_reconcile { Reconciliation, NotConverged, Converged }
import gunbc.runner.runner_unit { runner_slot_unit_name }
import gunbc.runner.runner_slot_actuation {
  SlotActuationOutcome,
  activate_runner_slot_over,
  drain_and_mask_runner_slot_over,
  slot_actuation_settled,
