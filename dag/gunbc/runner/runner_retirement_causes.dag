module gunbc.runner.runner_retirement_causes

// THE CAUSES A RETIREMENT DECISION CARRIES, IN A MODULE THAT IMPORTS NOTHING HEAVY -- and that is the whole
// reason this module exists, not a packaging preference. gunbc.runner.runner_slot_actuation has to name
// RetirePendingCause / RetireRefusalCause / RetireUndecidedCause on its outcomes (review 92478: "a fact that
// must survive belongs in a typed carrier", DESIGN.md Source) and render them only in its own wire;
// gunbc.runner.runner_replacement_readback, which DECIDES those causes, imports the qualification-dispatch
// and slot-allocation machinery, and that machinery reaches runner_slot_actuation back. Importing the causes
// from the module that decides them therefore closed a dependency cycle -- claim_batch said so over 21
// claims: "error: circular dependency detected". The standings, the causes, the drain decision and their
// renderers are pure data with no authority of their own, so they live here, on two leaf imports and nothing
// else. A decision type that can only be carried by dragging in the whole runner fleet is a type nobody can
// carry, and a module that is both judge and carrier is the cycle this prevents.
import std.optional { Absent, Present }
import std.types { Bool, List, NonEmptyStr, String }
import extdeps.github.workflow_runs { WorkflowRun, WorkflowJobRun, WorkflowRunConclusion }

// ─────────────────────────── LEG 1: THE REGISTRATION READBACK ───────────────────────────
// WHY `RegisteredOffline` IS ITS OWN ARM RATHER THAN `NotRegistered`. A runner that is registered but
// offline is a slot that has been created and has failed to hold a connection: it tells the operator to
// look at the runner, while `NotRegistered` tells them to look at the provisioning. Folding them would
// make an offline replacement look like an unprovisioned one, and the plan would provision a second tree
// over a slot that only needs its runner restarted.
type ReplacementRegistration
  = Registered { slot: NonEmptyStr }
  | RegisteredOffline { slot: NonEmptyStr }
  | NotRegistered { slot: NonEmptyStr }
  | RegistrationUnreadable { slot: NonEmptyStr, cause: String }

// ─────────────────────────── LEG 2: THE COMPLETED-JOB READBACK ───────────────────────────
type ReplacementJobStanding
  = JobConcluded { slot: NonEmptyStr, run: WorkflowRun, floor_job: WorkflowJobRun }
  | JobNotConcluded { slot: NonEmptyStr, cause: String }
  | JobUnreadable { slot: NonEmptyStr, cause: String }

// ─────────────────────────── THE JOIN: REGISTERED *AND* COMPLETED A JOB ───────────────────────────
// THE CAUSE IS THE STANDING, NOT A PARAPHRASE OF IT. The first draft of this type carried arms named
// `NotRegistered`, `RegisteredOffline`, `JobUnreadable` and `JobNotConcluded` beside the identically named
// arms of `ReplacementRegistration` and `ReplacementJobStanding` in the same module -- one fact held twice,
// with the `slot` field shaved off, free to drift out of step with the standing it was meant to report, and
// a name meaning two things on one naming surface. `gunbc.design_argument::minimize_redundancy` ("a concept
// is modeled once and every use derived from it") and `gunbc.design_argument::single_authority` ("holding a
// name constant may not silently change obligations") both say no. A pending cause now CARRIES the standing
// that is holding the retirement, so "registered but offline" is decided in exactly one place and a plan
// line cannot say something the standing does not.
type ReplacementPendingCause
  = RegistrationPending { standing: ReplacementRegistration }
  | JobPending { standing: ReplacementJobStanding }

// ─────────────────────────── WHOSE CAPACITY IS THIS: THE DRAIN CANDIDATE'S STANDING ───────────────────────────
// THE FOUR ANSWERS A DRAIN CANDIDATE CAN GET, IN THE ORDER THEY ARE ASKED. `StillDesired` is asked first
// on purpose: a unit the model still desires is not this plan's to retire even when an obligation lists
// it, because two authorities disagreeing is exactly the case where draining destroys live capacity.
// `live_on_host` is carried and not consulted for the two declared arms: a retiree the host does not
// report is still a retiree (the drain is a no-op), and a fabric member the host reports is still the
// model's fabric slot -- what changes with liveness is the operator's urgency, not the model's authority.
type DrainCandidateStanding
  = StillDesired { unit: NonEmptyStr }
  | DeclaredRetiree { unit: NonEmptyStr, live_on_host: Bool }
  | ModelDeclaredFabricMember { unit: NonEmptyStr, live_on_host: Bool }
  | HandStartedWorkingCapacity { unit: NonEmptyStr }
  | DrainCandidateUnexplained { unit: NonEmptyStr }

// ─────────────────────────── THE DECISION ───────────────────────────
// ONE ARM PER WAY A RETIREMENT CAN BE STOPPED, BECAUSE THEY ARE NOT THE SAME SENTENCE. `RetireDrainWithheld`
// is "not yet": the replacement exists in the model and has not proven itself, and a later run may retire.
// `RetireDrainRefused` is "not yours": the unit is not this plan's to take at all, and no amount of
// waiting on a replacement changes that. A consumer that collapsed the two would drain a hand-started
// runner the moment an unrelated slot proved its first job.
// TWO SENTENCES, NOT FIVE LOOK-ALIKES. `WaitingOnReplacement` says WHICH replacement and hands the caller
// the standing that is holding it -- the rendering, and any consumer that wants to branch on registration
// versus job, reads the standing itself. `ReplacementProofMissing` is the third thing that was previously
// dressed up as an unreadable registration: the caller produced NO standing for that slot at all, which is
// neither "the roster said nothing" nor "the job did not run".
type RetirePendingCause
  = WaitingOnReplacement { replacement: NonEmptyStr, pending: ReplacementPendingCause }
  | ReplacementProofMissing { replacement: NonEmptyStr, cause: String }
  | IncomingUnprovable { cause: String }

type RetireRefusalCause
  = StillDesiredUnit { unit: NonEmptyStr }
  | HandStartedOutsideTheDerivedPopulation { unit: NonEmptyStr }
  | DrainCandidateUnaccountedFor { unit: NonEmptyStr }

type RetireDrainDecision
  = RetireDrainAuthorized { unit: NonEmptyStr, over: List<NonEmptyStr> }
  | RetireDrainWithheld { unit: NonEmptyStr, cause: RetirePendingCause }
  | RetireDrainRefused { unit: NonEmptyStr, cause: RetireRefusalCause }

// THE THIRD RETIREE-CAUSE, TYPED LIKE THE OTHER TWO: the drain leg asked the gate about a candidate and the
// gate produced NO DECISION for it. That is not a withhold (the gate did not consult the readback and say
// wait) and not a refusal (the gate did not classify the candidate), it is the gate never having spoken --
// and the drain leg treats silence the way it treats a refusal: nothing drains. It gets its own type so the
// outcome cannot lean on a string literal to say it.
type RetireUndecidedCause
  = NoDecisionFor { candidate: NonEmptyStr }

// THE CAUSES RENDERED FOR A PLAN LINE, so a withheld retirement reads as a next action and not as a
// refusal with no direction. Every withheld arm names the replacement it is waiting on -- that is the
// difference between "converge refused" and "converge is waiting on srv3-06's first job".
fn retire_pending_cause_wire(cause: RetirePendingCause) -> String {
  match cause {
    WaitingOnReplacement { replacement: slot, pending: pending } =>
      concat("waiting on ", concat((slot as String), concat(": ", pending_cause_text(pending: pending))))
    ReplacementProofMissing { replacement: slot, cause: why } =>
      concat(
        "waiting on ",
        concat((slot as String), concat(": the replacement's readback is missing (", concat(why, ")"))),
      )
    IncomingUnprovable { cause: why } => concat("the replacement population is unknowable: ", why)
  }
}

fn retire_undecided_cause_wire(cause: RetireUndecidedCause) -> String {
  match cause {
    NoDecisionFor { candidate: c } =>
      concat((c as String), ": the retirement gate produced no decision for this candidate; nothing was drained")
  }
}

// ONE RENDERING OF A STANDING, SHARED BY THE PLAN LINE AND THE HAND NOTICE. There used to be two -- the
// withheld cause and the notice each spelled the registration and job cases out, with the same words in
// both and nothing keeping them together. The two `Registered` / `JobConcluded` arms are the same
// unreachable-by-construction pair `awaiting` spells: they can only be reached if a proven leg is handed to
// a function that renders what is HOLDING a retirement, and saying so is better than a panic or a hole.
fn pending_cause_text(pending: ReplacementPendingCause) -> String {
  match pending {
    RegistrationPending { standing: standing } =>
      match standing {
        Registered { slot: slot } => concat((slot as String), " is registered: the registration leg is not what is holding this")
        RegisteredOffline { slot: slot } =>
          concat((slot as String), " is registered in the org runner roster but offline")
        NotRegistered { slot: slot } => concat((slot as String), " is not registered in the org runner roster")
        RegistrationUnreadable { slot: _, cause: why } =>
          concat("the replacement's registration is unreadable (", concat(why, ")"))
      }
    JobPending { standing: standing } =>
      match standing {
        JobConcluded { slot: slot, run: _, floor_job: _ } =>
          concat((slot as String), " has completed a job: the job leg is not what is holding this")
        JobNotConcluded { slot: _, cause: why } =>
          concat("the replacement has not completed a job (", concat(why, ")"))
        JobUnreadable { slot: _, cause: why } =>
          concat("the replacement's first job is unreadable (", concat(why, ")"))
      }
  }
}

fn retire_refusal_cause_wire(cause: RetireRefusalCause) -> String {
  match cause {
    StillDesiredUnit { unit: unit } =>
      concat((unit as String), " is still desired by the committed population: the retiree list and the population disagree")
    HandStartedOutsideTheDerivedPopulation { unit: unit } =>
      concat(
        (unit as String),
        " is running on the host and is in no derived population: it is hand-started working capacity, not an unknown occupant, and this plan will not drain it",
      )
    DrainCandidateUnaccountedFor { unit: unit } =>
      concat((unit as String), " is a drain candidate with nothing declaring it: desired by nobody, retired by nobody, not a fabric slot, and not running")
  }
}

// ONE STEP OF THE DRAIN LEG, PURELY -- and it lives here for the same reason the causes do: the leg that
// ASKS (gunbc.runner.runner_host_file_converge) and the gate that ANSWERS
// (gunbc.runner.runner_replacement_readback) must speak through one type, and neither may import the other.
// The apply route acts only on `DrainNow`; everything else is a report. Every arm is a function of data the
// leg already holds, so the fail-closed behaviour is decidable by a claim without an SSH session.
type RunnerHostDrainStep
  = DrainNow { unit: NonEmptyStr }
  // THE CAUSES TRAVEL TYPED AS FAR AS THE OUTCOME AND ARE RENDERED ONLY IN
  // gunbc.runner.runner_slot_actuation's wire. The gate's decision is a fact that must survive the leg that
  // made it (DESIGN.md, Source: "a fact that must survive belongs in a typed carrier"); turning it into
  // prose here would put a second representation of the decision in front of anyone reading the leg.
  | DrainHeld { unit: NonEmptyStr, cause: RetirePendingCause }
  | DrainRefusedByStanding { unit: NonEmptyStr, cause: RetireRefusalCause }
  | DrainUndecided { unit: NonEmptyStr, cause: RetireUndecidedCause }

// THE ONE LOOKUP THE DRAIN LEG AND THE WITNESS SHARE. Review 92516: the leg used to do its own
// `first(filter(...))` while the module kept a separate `retire_drain_is_authorized` that only the test
// called -- so a leg that matched every candidate to the WRONG decision would have kept the witness green
// while draining working capacity, and the predicate the test trusted was not the one the route ran. There
// is now exactly one lookup, it is what the route calls, and the arm that the leg used to invent (`Absent`
// -> `NoDecisionFor`) is produced here where a claim can reach it.
fn retire_drain_leg_step(unit: NonEmptyStr, decisions: List<RetireDrainDecision>) -> RunnerHostDrainStep {
  let found = filter(decisions, d => match d {
    RetireDrainAuthorized { unit: u, over: _ } => (u as String) == (unit as String)
    RetireDrainWithheld { unit: u, cause: _ } => (u as String) == (unit as String)
    RetireDrainRefused { unit: u, cause: _ } => (u as String) == (unit as String)
  })
  match first(found) {
    Absent => DrainUndecided { unit: unit, cause: NoDecisionFor { candidate: unit } }
    Present { value: RetireDrainAuthorized { unit: u, over: _ } } => DrainNow { unit: u }
    Present { value: RetireDrainWithheld { unit: u, cause: cause } } => DrainHeld { unit: u, cause: cause }
    Present { value: RetireDrainRefused { unit: u, cause: cause } } =>
      DrainRefusedByStanding { unit: u, cause: cause }
  }
}

// THE JOB LEG'S INPUT, WITHOUT THE DISPATCH MODULE IN THE GRAPH.
// WHAT THIS IS JUDGED ON IS gunbc.runner.runner_qualification_dispatch::QualificationRunVerdict -- the
// existing observation, not a new instrument: `FloorJobCollected` carries that verdict's own three fields
// (`run`, `floor_job`, `conclusion`) plus the slot the caller asked about, and `FloorJobRefused` carries the
// reason that verdict's refusal already states. It is a PROJECTION, not a second authority: the only producer
// is gunbc.runner.runner_qualification_dispatch::replacement_job_evidence_of -- the module that owns the
// verdict -- and the gate can construct neither arm itself, so no caller can hand the gate a job that was
// never collected.
//
// WHY THE GATE CANNOT SIMPLY IMPORT THE VERDICT IT JUDGES. The qualification dispatch module reaches
// gunbc.fleet.fleet_converge_workflow -> gunbc.host.host_primary_network_apply ->
// gunbc.runner.runner_host_file_converge, and `runner_host_file_converge` is the caller that asks this gate
// whether a drain is authorized. Importing the verdict from the dispatch module therefore closes a cycle over
// the very route that consumes the answer (the compiler refuses it: "circular dependency detected"). The
// projection keeps the direction honest: the observation's owner translates its own fact into the shape the
// gate can read, and the gate stays free to decide without naming the machinery that produced its inputs.
//
// THE ARMS ARE NAMED AFTER WHAT THEY CARRY, not after the verdict's own `RunVerdictCollected` /
// `RunVerdictRefused`. Same fact, one naming surface is what
// gunbc.design_argument::single_authority asks for; reusing those two names here would put two unrelated
// constructors with the same spelling on the tree, which is how a reader spends an hour deciding which
// `Collected` a `match` was written against.
// THE COLLECTED RUN, AS A SEALED CARRIER. WHY SEAL IT: this record is the whole reason a retirement may
// proceed -- "the runner that registered is the runner that took the floor job, and it concluded". A carrier
// anyone can construct turns the gate into a form the plan fills in, which is the forgery this gate exists to
// stop; the repo already holds that class closed the same way for the collected qualification run
// (gunbc.runner.runner_qualification_dispatch::CollectedQualificationRun is a sole_constructor, and
// dag/test/probe/qualification_collection_relabel_probe.dag is the witness that the wall bites). So the only
// way to hold a collected reading is through `collected_floor_job_reading` below, whose admit list names
// exactly one caller.
type CollectedFloorJobReading sole_constructor {
  run: WorkflowRun,
  floor_job: WorkflowJobRun,
  conclusion: WorkflowRunConclusion,
}

// THE JOB LEG'S INPUT, WITHOUT THE DISPATCH MODULE IN THE GRAPH.
// WHAT THIS IS JUDGED ON IS gunbc.runner.runner_qualification_dispatch::QualificationRunVerdict -- the
// existing observation, not a new instrument: the collected arm carries that verdict's own reading (sealed, so
// it cannot be written by hand) plus the slot the caller asked about, and the refused arm carries the reason
// that verdict's refusal already states. The only producer is
// gunbc.runner.runner_qualification_dispatch::replacement_job_evidence_of -- the module that owns the verdict
// -- and the collected reading inside it can only come from this module's admitted mint, so no caller can
// hand the gate a floor job that was never collected.
//
// WHY THE GATE CANNOT SIMPLY IMPORT THE VERDICT IT JUDGES. The qualification dispatch module reaches
// gunbc.fleet.fleet_converge_workflow -> gunbc.host.host_primary_network_apply ->
// gunbc.runner.runner_host_file_converge, and `runner_host_file_converge` is the caller that asks this gate
// whether a drain is authorized. Importing the verdict from the dispatch module therefore closes a cycle over
// the very route that consumes the answer (the compiler refuses it: "circular dependency detected"). The
// projection keeps the direction honest: the observation's owner translates its own fact into the shape the
// gate can read, and the gate stays free to decide without naming the machinery that produced its inputs.
//
// THE ARMS ARE NAMED AFTER WHAT THEY CARRY, not after the verdict's own `RunVerdictCollected` /
// `RunVerdictRefused`. Same fact, one naming surface is what
// gunbc.design_argument::single_authority asks for; reusing those two names here would put two unrelated
// constructors with the same spelling on the tree, which is how a reader spends an hour deciding which
// `Collected` a `match` was written against.
type ReplacementJobEvidence
  // THE COLLECTED ARM CARRIES NO SLOT LABEL, ONLY THE READING ITSELF. Which slot a floor job belongs to is
  // a fact the job carries -- WorkflowJobRun.runner_name, the same field
  // gunbc.runner.runner_qualification_dispatch::decide_floor_job checked against the registration -- and
  // `floor_job_ran_on` below is the one matcher. A second `slot` field beside it would be a second identity
  // for one fact that the matching code never reads: exactly the fork
  // gunbc.design_argument::single_authority refuses, because the two can disagree and only one of them
  // decides. The REFUSED arm keeps the caller's label, because a readback that was refused names no runner at
  // all -- there the label is the only identity there is, not a copy of one.
  = FloorJobCollected { collected: CollectedFloorJobReading }
  | FloorJobRefused { slot: NonEmptyStr, reason: String }

// THE ONE MINT OF THAT READING, and the one caller it admits. A mint whose admit list is a single
// `decl_ref` is how this repo says "there is a producer, it is this function, and nothing else has written
// one"; widening the list is a visible change to who may attest that a floor job ran.
fn collected_floor_job_reading(
  run: WorkflowRun,
  floor_job: WorkflowJobRun,
  conclusion: WorkflowRunConclusion,
) -> CollectedFloorJobReading
  admit_callers: [
    decl_ref(module_path: "gunbc.runner.runner_qualification_dispatch", decl_name: "replacement_job_evidence_of"),
  ]
{
  CollectedFloorJobReading { run: run, floor_job: floor_job, conclusion: conclusion }
}

// WHICH SLOT THIS EVIDENCE IS ABOUT IS A FACT ABOUT THE JOB, NOT ABOUT THE CALLER'S LABEL. The verdict is
// spent on the runner the floor job actually ran on -- `WorkflowJobRun.runner_name`, the same field
// `decide_floor_job` checked against the registration -- so a collected run for srv3-06 can never be spent
// on srv3-07, and a refused verdict, which names no runner, is spent on nobody. An absent `runner_name` is
// not a match: a job that does not say who ran it has proved nothing about who ran it.
fn floor_job_ran_on(evidence: ReplacementJobEvidence, slot: NonEmptyStr) -> Bool {
  match evidence {
    FloorJobCollected { collected: collected } =>
      match collected.floor_job.runner_name {
        Absent => false
        Present { value: name } => name == (slot as String)
      }
    FloorJobRefused { slot: _, reason: _ } => false
  }
}
