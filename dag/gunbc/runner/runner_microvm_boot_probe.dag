module gunbc.runner.runner_microvm_boot_probe

import std.types { String, NonEmptyStr, Bool, List, FilePath, Int }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.algebra { trim, string_contains }
import std.measure {
  Second, second, second_count, measure_le, measure_sub, MeasureDifference,
  MeasureSubtrahendExceedsMinuend,
}
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.disposition { ConstructionMechanism, SingleAuthority }
import extdeps.shell
import extdeps.exec.command { ArgvCommand }
import extdeps.tools.mkdir { mkdir_parents_command }
import extdeps.tools.gnu_coreutils { cp_command, rm_force_command, timeout_command }
// THE LIFECYCLE PRIMITIVES THE BOUND IS IMPOSED WITH. This module starts the subject, waits on the
// kernel's own classification of how it ended, and signals ONLY the process group it started --
// the repo-owned construction gunbc.harness.harness_shell_job already uses for its backstopped jobs
// (its StartDetached call and harness_await_pid). The import is bare, exactly as that module takes
// it, so posix.Process / posix.Signal and the closed ProcessReapOutcome coproduct arrive whole.
import extdeps.posix.process
import extdeps.posix.signal
import extdeps.tools.sleep
import extdeps.virtualization.firecracker {
  FirecrackerVmConfig, firecracker_release_aarch64,
  firecracker_vm_config_document, firecracker_run_config_command,
}
import extdeps.github.actions_runner { ActionsRunnerRelease }
import gunbc.runner.runner_microvm {
  RunnerGuestImage, gunbc_runner_guest_image,
  RunnerMicroVmNetworking, GuestNetworkAbsent,
  RunnerMicroVmConfigResolution, MicroVmConfigResolved, MicroVmConfigUnresolved,
  gunbc_runner_microvm_vm_config, jit_drive_without_credential,
}
import gunbc.runner.runner_guest_image {
  guest_console_carries, GuestEmitted, GuestBooted,
  runner_guest_image_root, runner_guest_image_path,
  runner_guest_base_artifact_path, runner_guest_kernel_artifact,
}
import gunbc.runner.runner_microvm_host_ready {
  FirecrackerHostStanding, firecracker_host_ready_in_this_process, firecracker_installed_binary,
  firecracker_install_root, firecracker_host_standing_text,
  observe_firecracker_host_standing_wet,
  MicrovmHostBinding, MicrovmHostBound, MicrovmHostBindingRefused,
  microvm_host_binding_wet, microvm_host_binding_refusal_text,
}
import gunbc.command_runner { run_shell_commands, LocalExec }

data runner_microvm_boot_probe_disposition: ConstructionMechanism = SingleAuthority

// A GREEN GUEST BOOT PROBE IS NOT HOST-IMAGE PLACEABILITY. It runs a copied guest rootfs from a
// checkout-built artifact, not a gunbc binary carried in the host image on tmpfs at host boot.

// THE BOOT IS THE MEASUREMENT THE GUEST IMAGE MODULE PROMISED, AND IT IS THE ONLY THING THAT CAN
// SETTLE IT. gunbc.runner.runner_guest_image builds a root filesystem WITHOUT ROOT, and states in full what
// that costs: an unprivileged extraction restores no ownership, no setuid bits and no device nodes.
// It argues all three are survivable in this guest and says plainly that survivable is not proven.
//
// This is the proof obligation discharged. A guest that boots and prints the version of the runner
// baked into it has demonstrated that the kernel found a root filesystem, that init came up, that
// systemd reached its default target, and that the runner's own binary is executable there -- which
// is exactly the set of facts an ownership or device-node loss would have broken. A guest that does
// NOT boot fails loudly on a console this probe captures, and that failure is the evidence that
// would justify buying the privileged build.
//
// IT IS A PROBE AND NOT A PROVISIONER, and the difference is load-bearing rather than modest.
// gunbc.runner.runner_microvm's admission still refuses every production configuration, because the VMM's
// own memory reserve is uncited and the guest cannot be judged against the bounded cell without it.
// Nothing here overrides that: this boots ONE VM outside any cell to observe whether the image
// works, and it measures the reserve that admission is waiting on. Reading this probe's success as
// permission to provision would be reading a smoke test as a capacity decision.

// THE GUEST HAS NO NETWORK, DECLARED RATHER THAN OMITTED. The per-slot tap is a later slice, so this
// guest cannot reach GitHub and therefore cannot register a runner -- it is not a degraded runner,
// it is a different kind of VM, and gunbc.runner.runner_microvm's networking coproduct is where that is
// said. Naming a tap device that does not exist would have made Firecracker fail at device setup and
// the failure would have read as an image defect.
fn runner_microvm_boot_probe_networking() -> RunnerMicroVmNetworking {
  GuestNetworkAbsent {
    cause: "the boot probe runs before the per-slot network slice, so this guest has no tap and no egress; it can boot and print, and it cannot register with GitHub",
  }
}

// THE PROBE BOOTS A COPY, NEVER THE BUILT IMAGE ITSELF. A Firecracker root drive is attached
// READ-WRITE -- the guest's init writes to it -- so booting the built artifact would mutate the
// thing whose digest gunbc.runner.runner_guest_image just recorded, and the next observe would report a
// digest that disagrees with the build receipt for no reason anybody could reconstruct. The copy is
// removed first so a probe never boots a previous probe's dirtied filesystem and reports it as this
// image's behaviour.
fn runner_microvm_boot_probe_dir(root: String) -> String {
  join([root, "/probe"], "")
}

fn runner_microvm_boot_probe_rootfs(root: String) -> String {
  join([runner_microvm_boot_probe_dir(root: root), "/probe-rootfs.ext4"], "")
}

fn runner_microvm_boot_probe_config_path(root: String) -> String {
  join([runner_microvm_boot_probe_dir(root: root), "/probe-vm-config.json"], "")
}

fn runner_microvm_boot_probe_stage_commands(root: String, image: RunnerGuestImage) -> List<ArgvCommand> {
  [
    mkdir_parents_command(path: runner_microvm_boot_probe_dir(root: root)),
    rm_force_command(path: runner_microvm_boot_probe_rootfs(root: root)),
    cp_command(
      source: runner_guest_image_path(root: root, image: image),
      destination: runner_microvm_boot_probe_rootfs(root: root),
    ),
  ]
}

// THE JIT DRIVE CARRIES NO CREDENTIAL, BY THE CONTRACT RATHER THAN BY ACCIDENT. The guest agent reads
// that device as a systemd environment file (gunbc.runner.runner_microvm jit_drive_content), so the
// earlier stand-in -- the rootfs copy's own path -- would now hand systemd an 8 GiB ext4 image to
// parse. The probe instead writes gunbc.runner.runner_microvm jit_drive_without_credential: whole sectors
// of blank lines. The guest boots, prints its runner version and GuestBooted, the listener refuses as
// unconfigured, and the manager powers the VM off -- a boot probe spends no registration.
fn runner_microvm_boot_probe_jit_drive(root: String) -> String {
  join([runner_microvm_boot_probe_dir(root: root), "/probe-jit.img"], "")
}

// NO IMAGE IDENTITY IS TAKEN HERE, AND THAT IS THE POINT: the probe boots a FIXED path, and the
// identity is spent upstream by runner_microvm_boot_probe_stage_commands, which copies
// runner_guest_image_path(root, image) onto it. Taking an identity this function could not honour
// would claim a binding it does not perform -- the copy is what binds the bytes, and the caller
// refuses on a failed copy rather than booting whatever the previous run left behind.
fn runner_microvm_boot_probe_config(root: String) -> RunnerMicroVmConfigResolution {
  gunbc_runner_microvm_vm_config(
    rootfs_path: runner_microvm_boot_probe_rootfs(root: root),
    jit_config_path: runner_microvm_boot_probe_jit_drive(root: root),
    kernel_path: runner_guest_base_artifact_path(root: root, artifact: runner_guest_kernel_artifact),
    net: runner_microvm_boot_probe_networking(),
  )
}

// THE DEADLINE IS THE HOST'S, AND IT MUST NOT DEPEND ON THE GUEST AGREEING TO IT.
//
// The guest agent powers the machine off by SuccessAction=/FailureAction=, which cover every way the agent unit ends -- and
// that only ever covers the case where the agent STARTED. It does not cover an agent systemd never
// pulled in (the exact defect this module's sibling just carried), a kernel that panics before
// userspace, an init that hangs, or a guest that never reaches its target at all. In every one of
// those the VMM sits there holding a guest forever, and the earlier reassurance that this probe
// "boots one VM that powers itself off" was true only of the arm that works.
//
// So the bound is imposed from OUTSIDE the guest by the host, on the VMM process, where no guest
// behaviour can extend it. A step timeout is not a substitute: it kills the step and can leave the
// VMM it spawned running, which is precisely the uncontrolled VM this probe must not create.
//
// THE BOUNDER IS THIS LAYER, NOT A WRAPPED TOOL. This module starts the subject with
// #extdeps.posix.process::StartDetached (which spawns with POSIX_SPAWN_SETPGROUP, so the subject LEADS
// the group this lifecycle owns), waits on the kernel's own classification through Reap, and signals
// that group -- and only that group -- with #extdeps.posix.signal::TerminateProcessGroup after its OWN
// deadline ran out with the subject still alive. It does not wrap the subject in GNU timeout on the
// production route, and it does not read a timeout exit status or timeout's --verbose text as evidence
// that a bound fired: that diagnostic is authored onto a stderr the timed-out subject shares and can
// write to, so text there cannot evidence an enforcement event. What this layer may assert is evidence
// IT owns -- the deadline value it imposed, the fact that it chose to signal, and the kernel's reap
// classification of the group it started. GNU timeout stays modelled where it belongs, as an upstream
// convention in #extdeps.tools.gnu_coreutils::coreutils_timeout_expired_exit_code cited to timeout(1),
// for the readers that still consume it; this module stopped being one of them.
data runner_microvm_boot_probe_deadline: Second = second(count: 180)

// THE POST-SIGNAL REAP BOUND, AND WHAT THIS LAYER CANNOT ESCALATE TO.
// #extdeps.posix.signal::TerminateProcessGroup carries SIGTERM only (its upstream kill(2) form; see
// #extdeps.posix.signal::linux_standard_signal_number for the wire number), and this repo's signal
// service deliberately owns no SIGKILL verb, so this layer does not escalate. A subject that declines
// SIGTERM is therefore NOT reported as a deadline that fired: the post-signal reap still answers
// StillRunning and the classifier refuses by name
// (BootDeadlineEnforcementUnobservable { cause: SubjectDeclinedOurSignal }). A deadline is claimed only
// when the reap ANSWERS Signalled -- the kernel confirming the signal this layer itself sent.
data runner_microvm_boot_probe_kill_grace: Second = second(count: 10)

// RETAINED, AND CITED, NOT CONSUMED. This composed the GNU-timeout wrapper the production boot route
// used before the Shape-A bounder landed here. It stays because the authority row
// #gunbc.recurring_failure_mode::bare_exit_124_read_as_an_observed_timeout_event names it by
// DeclarationRef as the place where a bound was REQUESTED -- its own text is the reason the route was
// dropped: "CONSTRUCTING A GNU TIMEOUT INVOCATION DOES NOT ESTABLISH THAT ITS DEADLINE FIRED". Its argv
// shape (the escalation flag pair, the bound value, the subject) is still witnessed, in
// #test.claim.runner.runner_microvm_boot_probe_witness, because the facts it asserts are upstream
// facts about timeout(1) that OTHER readers still rely on. Nothing on a production path calls it: the
// production route is #gunbc.runner.runner_microvm_boot_probe::runner_microvm_boot_probe_run_bounded,
// which imposes its own bound rather than asking an external tool to hold one.
fn runner_microvm_boot_probe_bounded_command(binary: String, config_path: String) -> ArgvCommand {
  timeout_command(
    duration: runner_microvm_boot_probe_deadline,
    kill_after: runner_microvm_boot_probe_kill_grace,
    command: firecracker_run_config_command(binary: binary, config_path: config_path),
  )
}

// THE RECEIPT: WHAT THE BOUND THIS LAYER IMPOSES ACTUALLY DID, in one bounded invocation, as observed
// by the layer that imposed it. It is minted only by runner_microvm_boot_probe_run_bounded below, and it
// travels to the classifier together with the capture of that same run, so a caller cannot hand the
// classifier a receipt it did not obtain from the invocation it is judging.
//
// WHY NOTHING HERE IS A STATUS. The authority row
// #gunbc.recurring_failure_mode.bare_exit_124_read_as_an_observed_timeout_event::bare_exit_124_read_as_an_observed_timeout_event
// re-derives on srv1 that `timeout --kill-after=1s 5s sh -c 'exit 124'` (the child's OWN 124, no expiry)
// and `timeout --kill-after=1s 0.1s sleep 2` (a real expiry) BOTH exit 124. A status cannot tell those
// two events apart, so no arm of this receipt is keyed on one. What discriminates is which end of the
// lifecycle answered, twice over: whether THIS layer decided to signal after its own deadline ran out
// with the subject still alive, and whether the kernel then reaped the group it started as Signalled.
//
// THE FORGERY THIS SHAPE CLOSES. An earlier revision of this receipt recognised the bounder's own
// --verbose enforcement diagnostic in the run's stderr. That was withdrawn under a binding review
// finding on gunbc#17013: stderr is shared with the bounded subject (#gunbc.command_runner::run_shell_command_observe
// captures it separately from the exit status, and any program the subject runs may write it), so a
// child can print the enforcement sentence with no clock having expired. Every consumer of such a
// receipt -- including the three bare-124 readers named by the follow-up row
// bare-124-timeout-readers-consume-the-bound-observation, which is a CHILD of this roadmap node -- would
// inherit a deadline claim the subject can forge. Text on a shared stderr is not enforcement evidence,
// and nothing in this receipt consults it (gunbc.design_argument::epistemic_humility: the discriminating
// observation is typed and emitted where the bound is imposed, never a promoted guess).
//
// A SEAM FACT RECORDED RATHER THAN REPAIRED (v1 is semantics-frozen: Manager B, 2026-11-25). The route
// this replaced -- #gunbc.command_runner::run_shell_command_observe, realized by
// src/v1/stage0/src/v1_interpreter.rs::shell_result_from_capture, which flattens a signal death with
// `code().unwrap_or(-1)` -- cannot separate a child killed by SIGKILL from a child that reports 137 of
// its own accord: executed on srv1, a real escalation printed exit_code -1 where a child's own
// `exit 137` printed 137 (raw lines in the PR body). That flattening is a v1 SEED fact and this change
// does not touch it; it is also the reason the bounder here never reads a status.
type ExecutionBoundReceipt
  = BoundFired { deadline: Second, reaped_signal: Int }
  | BoundChildExited { exit_code: Int }
  | BoundSignalledByOther { signal: Int }
  | BoundReapRefused { cause: String }
  | BoundKillRefused { deadline: Second, detail: String }
  | BoundSubjectDeclinedSignal { deadline: Second }
  | BoundKillUnconfirmed { deadline: Second, exit_code: Int }
  | BoundKillUnnameable { pid: Int }
  | BoundSpawnRefused { program: String, cause: String }
  | NoExecutionBound

// THE CAPTURE THIS LAYER OWNS. #extdeps.posix.process::StartDetached writes the subject's stdout and
// stderr to files THIS caller named, and the console is read back from there -- never out of an argv
// pipeline. A read that failed is carried as read_cause rather than reported as an empty console:
// "the guest printed nothing" and "we could not read what the guest printed" are different claims, and
// collapsing them is the fabricated-plausible-answer shape (gunbc.design_argument::fail_closed).
type BootProbeConsole {
  stdout: String
  stderr: String
  source: String
  read_cause: String
}

// ONE BOUNDED INVOCATION: the receipt and the capture taken with it. They travel together because the
// run that produces one produces the other -- the pairing claim this witness asserts at one interface
// (gunbc.design_argument::witness_one_interface).
type BoundedBootRun {
  receipt: ExecutionBoundReceipt
  console: BootProbeConsole
}

// THE AWAIT LOOP, on the kernel's own answer: one Reap per second, bounded by `remaining`. Running the
// bound out while the subject is alive answers StillRunning, which is NOT a fact about the subject -- it
// is the signal that THIS layer must decide. The loop is the shape #gunbc.harness.harness_shell_job::harness_await_pid
// already uses for its own job backstop, taken from the same primitives rather than borrowed across the
// harness boundary (no dag/gunbc/runner module imports the harness; the precedent for taking these
// primitives bare is the harness module itself).
fn boot_probe_await_reap(pid: Int, remaining: Second) -> ProcessReapOutcome {
  let reaped = posix.Process.Reap(pid: pid)
  match reaped.reaped {
    StillRunning =>
      if measure_le(a: remaining, b: second(count: 0)) {
        StillRunning
      } else {
        let _pause = sleep.Delay.Seconds(seconds: "1" as NonEmptyStr)
        match measure_sub(a: remaining, b: second(count: 1)) {
          MeasureDifference { value: next } => boot_probe_await_reap(pid: pid, remaining: next)
          MeasureSubtrahendExceedsMinuend => StillRunning
        }
      }
    Exited { code } => Exited { code: code }
    Signaled { signal } => Signaled { signal: signal }
    ReapRefused { cause } => ReapRefused { cause: cause as String }
  }
}

// THE BOUNDED INVOCATION. One call, one subject, one bound. `deadline` and `kill_grace` are THE VALUES
// THIS LAYER IMPOSES, and the receipt carries them back rather than re-reading the module data, so a
// verdict can never render a bound that was not the one imposed on the run it describes. The production
// probe passes #gunbc.runner.runner_microvm_boot_probe::runner_microvm_boot_probe_deadline and
// #gunbc.runner.runner_microvm_boot_probe::runner_microvm_boot_probe_kill_grace; a witness imposes a
// short bound on its own child. `subject` is the argv to bound and the two
// files are paths the CALLER owns: the wet probe writes them under its own probe directory and a
// witness writes them under its own mktemp directory -- never a path belonging to another session, and
// nothing is ever killed by name or pattern (the only group signalled is the one minted from the pid
// THIS call started, below).
fn runner_microvm_boot_probe_run_bounded(
  subject: ArgvCommand,
  deadline: Second,
  kill_grace: Second,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  let started = posix.Process.StartDetached(
    program: subject.program.invocation,
    arguments: subject.arguments,
    stdout_file: stdout_file,
    stderr_file: stderr_file,
  )
  match started.spawn {
    SpawnRefused { program: p, cause: c } =>
      BoundedBootRun {
        receipt: BoundSpawnRefused { program: p as String, cause: c as String },
        console: empty_boot_probe_console(source: stdout_file as String),
      }
    Spawned { pid: pid } =>
      boot_probe_after_first_reap(
        pid: pid,
        deadline: deadline,
        kill_grace: kill_grace,
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
  }
}

// THE FIRST REAP, before this layer has signalled anything. An Exited here is the subject's own ending
// whatever its code -- 124, 137, 1, 0 -- and it is judged on console content, never as a deadline (the
// row's red control). A Signalled here came from someone this layer is not: an outside kill, the host
// OOM killer, or the subject signalling its own group. It is refused by name rather than read as ours.
fn boot_probe_after_first_reap(
  pid: Int,
  deadline: Second,
  kill_grace: Second,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  match boot_probe_await_reap(pid: pid, remaining: deadline) {
    Exited { code: code } =>
      boot_probe_bounded_read(
        receipt: BoundChildExited { exit_code: code },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    Signaled { signal: signal } =>
      boot_probe_bounded_read(
        receipt: BoundSignalledByOther { signal: signal },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    ReapRefused { cause: cause } =>
      boot_probe_bounded_read(
        receipt: BoundReapRefused { cause: cause },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    StillRunning =>
      boot_probe_enforce_deadline(
        pid: pid,
        deadline: deadline,
        kill_grace: kill_grace,
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
  }
}

// THE ENFORCEMENT DECISION, MADE BY THE LAYER THAT OWNS THE BOUND. This is reached only when THIS
// layer's own await ran its own deadline out with the subject still alive -- the decision, not an
// inference from a status. The group is minted from the pid THIS StartDetached returned:
// #extdeps.posix.process::process_group_leader is the sole mint of #extdeps.posix.process::ProcessGroupLeader
// and it refuses 0, 1 and negatives, so the signal can never be aimed at a pid a caller chose, and the
// only group this can reach is the one this invocation started (SETPGROUP at spawn makes the subject its
// own group leader).
fn boot_probe_enforce_deadline(
  pid: Int,
  deadline: Second,
  kill_grace: Second,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  let leader = process_group_leader(spawned_pid: pid)
  match leader {
    Present { value: group } =>
      boot_probe_after_group_signal(
        pid: pid,
        deadline: deadline,
        kill_grace: kill_grace,
        group: group,
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    Absent =>
      boot_probe_bounded_read(
        receipt: BoundKillUnnameable { pid: pid },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
  }
}

fn boot_probe_after_group_signal(
  pid: Int,
  deadline: Second,
  kill_grace: Second,
  group: ProcessGroupLeader,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  let killed = posix.Signal.TerminateProcessGroup(group: group)
  if !killed.success {
    boot_probe_bounded_read(
      receipt: BoundKillRefused { deadline: deadline, detail: killed.stderr },
      stdout_file: stdout_file,
      stderr_file: stderr_file,
    )
  } else {
    boot_probe_confirm_signal(
      pid: pid,
      deadline: deadline,
      remaining: kill_grace,
      stdout_file: stdout_file,
      stderr_file: stderr_file,
    )
  }
}

// THE CONFIRMATION. Only the kernel may close this arm: Signalled after OUR signal is the bound firing,
// and the arm carries both the deadline value WE imposed and the signal the kernel reported. An Exited
// after our signal is NOT credited to the bound (the subject ended on its own terms and the timing is
// not evidence); a StillRunning when the post-signal bound expires means the subject declined SIGTERM,
// which this layer cannot escalate past and will not pretend otherwise.
fn boot_probe_confirm_signal(
  pid: Int,
  deadline: Second,
  remaining: Second,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  let reaped = posix.Process.Reap(pid: pid)
  match reaped.reaped {
    Signaled { signal: signal } =>
      boot_probe_bounded_read(
        receipt: BoundFired { deadline: deadline, reaped_signal: signal },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    Exited { code: code } =>
      boot_probe_bounded_read(
        receipt: BoundKillUnconfirmed { deadline: deadline, exit_code: code },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    ReapRefused { cause: cause } =>
      boot_probe_bounded_read(
        receipt: BoundKillRefused {
          deadline: deadline,
          detail: join(["the reap after this layer's own group signal was refused: ", cause], ""),
        },
        stdout_file: stdout_file,
        stderr_file: stderr_file,
      )
    StillRunning =>
      if measure_le(a: remaining, b: second(count: 0)) {
        boot_probe_bounded_read(
          receipt: BoundSubjectDeclinedSignal { deadline: deadline },
          stdout_file: stdout_file,
          stderr_file: stderr_file,
        )
      } else {
        let _pause = sleep.Delay.Seconds(seconds: "1" as NonEmptyStr)
        match measure_sub(a: remaining, b: second(count: 1)) {
          MeasureDifference { value: next } =>
            boot_probe_confirm_signal(
              pid: pid,
              deadline: deadline,
              remaining: next,
              stdout_file: stdout_file,
              stderr_file: stderr_file,
            )
          MeasureSubtrahendExceedsMinuend =>
            boot_probe_bounded_read(
              receipt: BoundSubjectDeclinedSignal { deadline: deadline },
              stdout_file: stdout_file,
              stderr_file: stderr_file,
            )
        }
      }
  }
}

fn boot_probe_bounded_read(
  receipt: ExecutionBoundReceipt,
  stdout_file: NonEmptyStr,
  stderr_file: NonEmptyStr,
) -> BoundedBootRun {
  let out = Filesystem.Read(path: stdout_file as String)
  let err = Filesystem.Read(path: stderr_file as String)
  if !out.success {
    BoundedBootRun {
      receipt: receipt,
      console: BootProbeConsole {
        stdout: "",
        stderr: "",
        source: stdout_file as String,
        read_cause: join(["the stdout capture could not be read: ", out.error], ""),
      },
    }
  } else if !err.success {
    BoundedBootRun {
      receipt: receipt,
      console: BootProbeConsole {
        stdout: out.content,
        stderr: "",
        source: stderr_file as String,
        read_cause: join(["the stderr capture could not be read: ", err.error], ""),
      },
    }
  } else {
    BoundedBootRun {
      receipt: receipt,
      console: BootProbeConsole {
        stdout: out.content,
        stderr: err.content,
        source: stdout_file as String,
        read_cause: "",
      },
    }
  }
}

fn empty_boot_probe_console(source: String) -> BootProbeConsole {
  BootProbeConsole {
    stdout: "",
    stderr: "",
    source: source,
    read_cause: "nothing was started, so nothing was captured",
  }
}

fn runner_microvm_boot_probe_deadline_text(deadline: Second) -> String {
  concat(to_string(second_count(s: deadline)), " seconds")
}

// THE OBSERVING ENTRY POINT for one bounded boot-probe invocation: it takes the receipt and the capture
// out of the SAME BoundedBootRun the bound produced -- neither can be supplied independently of the run
// it describes -- and carries both into the classifier. This is the function the real-spawn witness
// drives end to end.
fn runner_microvm_boot_probe_verdict_from_run(
  runner: ActionsRunnerRelease,
  run: BoundedBootRun,
) -> BootProbeVerdict {
  guest_agent_boot_verdict(runner: runner, console: run.console, receipt: run.receipt)
}

// THE ACCEPTANCE IS A READBACK OF THE CITED RELEASE, NOT A GREETING. The console must carry the
// version of the runner that extdeps.github.actions_runner pins, so the assertion consumes that row
// rather than a literal: a runner bump moves what this probe demands in the same edit that moves
// what the image contains, and the two cannot drift apart.
// EVERY FAILING ARM CARRIES THE CONSOLE, because on this subject the console IS the evidence and the
// failure is when you most need it. An earlier revision routed the VMM through the capture that
// discards stdout on a non-admitted exit, then labelled the surviving STDERR as "the console" -- a
// fabricated label over missing evidence. A guest that panics and is then killed by its deadline
// prints its panic to stdout, so that arm without stdout is the one arm that had to keep it.
// WHY THIS LAYER'S OWN ENFORCEMENT COULD NOT BE CONFIRMED, carried on the refusal so each refusal
// states what was actually observed. An earlier revision folded two of these into one message and a
// review finding on gunbc#17013 required the split; the arms below are separate because THEIR REMEDIES
// are separate (gunbc.design_argument::fail_closed: "a wrong answer is a loud, typed, located error,
// never a warning or a plausible fabrication").
//   SignalledWithoutOurKill   -- the kernel reaped the subject as Signalled although THIS layer had not
//        signalled it: an outside hand ended it (the host OOM killer, an operator, or the subject
//        signalling its own group). Remedy: find the other signaler; the bound is neither implicated nor
//        exonerated.
//   ReapRefused               -- waitpid refused, so how the subject ended is unknown at all. Remedy: the
//        lifecycle, not the subject.
//   GroupSignalRefused        -- this layer decided at the deadline and asked the kernel to signal the
//        group it started, and the group verb refused. Remedy: the host's signal path.
//   SubjectDeclinedOurSignal  -- this layer signalled and the subject was STILL there when the post-signal
//        bound expired. This service models no SIGKILL escalation, so the honest answer is a refusal: a
//        wedge this layer cannot end is not evidence that a deadline fired. Remedy: an escalation
//        primitive is an extdeps ask, never an inference made here.
//   KillNotConfirmedByReap    -- this layer signalled and the kernel then reaped the subject as EXITED, so
//        the death is not attributable to that signal. Remedy: read the subject, not the bound.
//   GroupUnnameable           -- the pid this invocation started could not be minted as a group leader, so
//        nothing was signalled. Remedy: the lifecycle primitive.
type EnforcementMismatch
  = SignalledWithoutOurKill { signal: Int }
  | ReapRefused { cause: String }
  | GroupSignalRefused { deadline: String, detail: String }
  | SubjectDeclinedOurSignal { deadline: String }
  | KillNotConfirmedByReap { deadline: String, exit_code: Int }
  | GroupUnnameable { pid: Int }

type BootProbeVerdict
  = BootPrintedRunnerVersion { version: String }
  | BootProducedNoConsole { cause: String }
  | BootConsoleLacksRunnerVersion { expected: String, console: String }
  | BootConsoleLacksGuestBooted { console: String }
  | BootNotAttempted { cause: String }
  | BootExceededHostDeadline { deadline: String, console: String, detail: String }
  | BootDeadlineEnforcementUnobservable { console: String, detail: String, cause: EnforcementMismatch }
  | BootConsoleUnreadable { path: String, cause: String }
  | BootVmmFailed { exit_code: Int, console: String, detail: String }

// THE CLASSIFIER CONSUMES THE RECEIPT, never a bare status, and it has NO ARM THAT KEYS A DEADLINE ON
// 124 -- the row's out_of_scope forbids one anywhere, and none is added here.
//   BoundFired                -> BootExceededHostDeadline, rendering the duration THIS layer imposed and
//                                the signal the kernel reported: an observed event, not an invented one
//                                (gunbc.design_argument::epistemic_humility).
//   BoundChildExited          -> judged on console content exactly as if no bound had been placed, so a
//                                guest that exited 124 of its own accord reaches BootVmmFailed -- the
//                                cause BootVmmFailed exists to carry, which the old bare-124 read
//                                discarded. This arm IS the row's red control.
//   the six unobservable arms -> BootDeadlineEnforcementUnobservable with a typed cause: no deadline is
//                                asserted and none is ruled out, and no status is consulted on the way
//                                there (gunbc.design_argument::fail_closed).
//   BoundSpawnRefused         -> BootNotAttempted: nothing ran, so nothing can be judged.
//   NoExecutionBound          -> the captured-console route of #gunbc.runner.runner_observed_version_check:
//                                a committed FILE, with no bounder and no reaper, so there is no subject
//                                status at all and the reader's own status is never laundered into the
//                                subject's. Console content alone decides.
fn boot_probe_verdict_by_content(
  runner: ActionsRunnerRelease,
  console: BootProbeConsole,
  exit_code: Int,
) -> BootProbeVerdict {
  if exit_code != 0 {
    BootVmmFailed { exit_code: exit_code, console: console.stdout, detail: console.stderr }
  } else if console.stdout == "" {
    BootProducedNoConsole {
      cause: "the VMM exited cleanly and produced no console output at all, so the guest did not reach a serial console",
    }
  } else if string_contains(s: console.stdout, pattern: runner.version as String) {
    BootPrintedRunnerVersion { version: runner.version as String }
  } else {
    BootConsoleLacksRunnerVersion { expected: runner.version as String, console: console.stdout }
  }
}

fn boot_probe_verdict(
  runner: ActionsRunnerRelease,
  console: BootProbeConsole,
  receipt: ExecutionBoundReceipt,
) -> BootProbeVerdict {
  match receipt {
    BoundSpawnRefused { program: p, cause: c } =>
      BootNotAttempted {
        cause: join(["nothing was started: the bounded invocation was refused before a pid existed (", p, ": ", c, ")"], ""),
      }
    BoundFired { deadline: d, reaped_signal: sig } =>
      BootExceededHostDeadline {
        deadline: runner_microvm_boot_probe_deadline_text(deadline: d),
        console: console.stdout,
        detail: join([
          "this probe imposed the bound (", runner_microvm_boot_probe_deadline_text(deadline: d),
          ") on a process group it started, signalled that group itself once the bound ran out with the",
          " subject still alive, and the kernel reaped the subject as signalled (signal ", to_string(sig),
          "); the deadline is a death this layer caused and the kernel confirmed -- not an exit status",
          " read as a deadline",
        ], ""),
      }
    BoundChildExited { exit_code: code } =>
      if console.read_cause != "" {
        BootConsoleUnreadable { path: console.source, cause: console.read_cause }
      } else {
        boot_probe_verdict_by_content(runner: runner, console: console, exit_code: code)
      }
    BoundSignalledByOther { signal: sig } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: SignalledWithoutOurKill { signal: sig },
      }
    BoundReapRefused { cause: c } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: ReapRefused { cause: c },
      }
    BoundKillRefused { deadline: d, detail: dd } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: GroupSignalRefused {
          deadline: runner_microvm_boot_probe_deadline_text(deadline: d),
          detail: dd,
        },
      }
    BoundSubjectDeclinedSignal { deadline: d } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: SubjectDeclinedOurSignal {
          deadline: runner_microvm_boot_probe_deadline_text(deadline: d),
        },
      }
    BoundKillUnconfirmed { deadline: d, exit_code: code } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: KillNotConfirmedByReap {
          deadline: runner_microvm_boot_probe_deadline_text(deadline: d),
          exit_code: code,
        },
      }
    BoundKillUnnameable { pid: pid } =>
      BootDeadlineEnforcementUnobservable {
        console: console.stdout,
        detail: console.stderr,
        cause: GroupUnnameable { pid: pid },
      }
    NoExecutionBound =>
      if console.read_cause != "" {
        BootConsoleUnreadable { path: console.source, cause: console.read_cause }
      } else {
        boot_probe_verdict_by_content(runner: runner, console: console, exit_code: 0)
      }
  }
}

// A LIVE BOOT OF THIS IMAGE MUST ALSO CARRY THE AGENT'S GuestBooted MARKER, read through
// #gunbc.runner.runner_guest_image::guest_console_carries -- the host's one console reader -- so a version
// string that reached the console some other way is not read as the agent having run. It is a layer
// over boot_probe_verdict rather than inside it because that verdict also judges consoles captured
// before the marker existed (gunbc.runner_observed_version_check's committed Mt. Collins capture),
// where requiring it would fail a true version readback for a reason unrelated to the version.
fn guest_agent_boot_verdict(
  runner: ActionsRunnerRelease,
  console: BootProbeConsole,
  receipt: ExecutionBoundReceipt,
) -> BootProbeVerdict {
  let base = boot_probe_verdict(runner: runner, console: console, receipt: receipt)
  match base {
    BootPrintedRunnerVersion { version: _ } =>
      if guest_console_carries(console: console.stdout, kind: GuestEmitted { event: GuestBooted }) {
        base
      } else {
        BootConsoleLacksGuestBooted { console: console.stdout }
      }
    BootProducedNoConsole { cause: _ } => base
    BootConsoleLacksRunnerVersion { expected: _, console: _ } => base
    BootConsoleLacksGuestBooted { console: _ } => base
    BootNotAttempted { cause: _ } => base
    BootExceededHostDeadline { deadline: _, console: _, detail: _ } => base
    BootDeadlineEnforcementUnobservable { console: _, detail: _, cause: _ } => base
    BootConsoleUnreadable { path: _, cause: _ } => base
    BootVmmFailed { exit_code: _, console: _, detail: _ } => base
  }
}

// EVERY FAILING ARM CARRIES THE CONSOLE, because on this subject the console IS the evidence and the
// failure is when you most need it. An earlier revision routed the VMM through the capture that
// discards stdout on a non-admitted exit, then labelled the surviving STDERR as "the console" -- a
// fabricated label over missing evidence. A guest that panics and is then killed by its deadline prints
// its panic to stdout, so that arm without stdout is the one arm that had to keep it.
fn boot_probe_verdict_text(v: BootProbeVerdict) -> String {
  match v {
    BootPrintedRunnerVersion { version: x } => join(["boot=printed-runner-version ", x], "")
    BootProducedNoConsole { cause: c } => join(["boot=no-console (", c, ")"], "")
    BootConsoleLacksRunnerVersion { expected: e, console: c } =>
      join(["boot=console-without-runner-version expected=", e, "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootConsoleLacksGuestBooted { console: c } =>
      join(["boot=console-without-guest-booted (the guest agent never reported GuestBooted)\n--- console ---\n", c, "\n--- end console ---"], "")
    BootNotAttempted { cause: c } => join(["boot=not-attempted (", c, ")"], "")
    BootExceededHostDeadline { deadline: d, console: c, detail: e } =>
      join(["boot=host-deadline-expired after ", d,
            " -- this probe imposed that bound, signalled its own process group when the bound ran out,",
            " and the kernel reaped the subject as signalled\n", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: SignalledWithoutOurKill { signal: sig } } =>
      join(["boot=deadline-enforcement-unobservable -- the kernel reaped the bounded subject as signalled",
            " (signal ", to_string(sig), ") although this layer had not signalled its process group: some",
            " other hand ended it (an outside kill, the host OOM killer, or the subject signalling its own",
            " group), so the bound neither fired nor did not, and NO deadline is claimed",
            " (gunbc.design_argument::fail_closed)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: ReapRefused { cause: rc } } =>
      join(["boot=deadline-enforcement-unobservable -- the kernel refused this layer's reap of the bounded",
            " subject (", rc, "), so how it ended is unknown and NO deadline is claimed",
            " (gunbc.design_argument::fail_closed)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: GroupSignalRefused { deadline: d, detail: dd } } =>
      join(["boot=deadline-enforcement-unobservable -- this layer imposed ", d, " and asked the kernel to",
            " signal the process group it started, and the group signal was refused (", dd, "); the subject",
            " was never confirmed dead by that signal, so NO deadline is claimed",
            " (gunbc.design_argument::fail_closed)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: SubjectDeclinedOurSignal { deadline: d } } =>
      join(["boot=deadline-enforcement-unobservable -- this layer imposed ", d, ", signalled the process group",
            " it started, and the subject was still running when the post-signal bound expired: it declined",
            " SIGTERM and this layer models no SIGKILL escalation, so the wedge is reported as a refusal and",
            " NOT as a deadline that fired (a wedge is not evidence of an enforcement event",
            " -- gunbc.design_argument::epistemic_humility)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: KillNotConfirmedByReap { deadline: d, exit_code: code } } =>
      join(["boot=deadline-enforcement-unobservable -- this layer imposed ", d, ", signalled the process group",
            " it started, and the kernel then reaped the subject as EXITED (", to_string(code), "), not as",
            " signalled: the death is not attributable to this layer's signal, so NO deadline is claimed",
            " (gunbc.design_argument::fail_closed)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootDeadlineEnforcementUnobservable { console: c, detail: e, cause: GroupUnnameable { pid: pid } } =>
      join(["boot=deadline-enforcement-unobservable -- this layer started pid ", to_string(pid), " but that pid",
            " could not be minted as a process-group leader, so nothing was signalled and NO deadline is",
            " claimed (gunbc.design_argument::fail_closed)\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
    BootConsoleUnreadable { path: p, cause: cc } =>
      join(["boot=console-unreadable path=", p, " (", cc, ") -- the capture could not be read, which is NOT",
            " the claim that the guest printed nothing (gunbc.design_argument::fail_closed)"], "")
    BootVmmFailed { exit_code: x, console: c, detail: e } =>
      join(["boot=vmm-failed exit=", to_string(x), "\nvmm-stderr: ", e,
            "\n--- console ---\n", c, "\n--- end console ---"], "")
  }
}

fn boot_probe_admitted(v: BootProbeVerdict) -> Bool {
  match v {
    BootPrintedRunnerVersion { version: _ } => true
    BootProducedNoConsole { cause: _ } => false
    BootConsoleLacksRunnerVersion { expected: _, console: _ } => false
    BootConsoleLacksGuestBooted { console: _ } => false
    BootNotAttempted { cause: _ } => false
    BootExceededHostDeadline { deadline: _, console: _, detail: _ } => false
    BootDeadlineEnforcementUnobservable { console: _, detail: _, cause: _ } => false
    BootConsoleUnreadable { path: _, cause: _ } => false
    BootVmmFailed { exit_code: _, console: _, detail: _ } => false
  }
}

data runner_microvm_boot_probe_receipt_dir: String = "target"

data runner_microvm_boot_probe_receipt_path: String = "target/runner-microvm-boot-probe.txt"

fn executor_home_wet() -> String? {
  match shell.Env.Get(name: "HOME" as NonEmptyStr).value {
    Absent => none
    Present { value: h } => if trim(s: h) == "" { none } else { Present { value: h } }
  }
}

// (Hoisted to module grain from the body of the item below: a source annotation inside a
// declaration body is not modeled and refuses to parse.)
// THE LOGIN COMES FROM THE HOST'S ROSTER ROW, because the standing now carries the executor's
// group enrolment and that is a fact about a named account. A probe on a host with no roster
// row has no executor to ask about, which is a BootNotAttempted cause like any other.
//
// THE HOST STANDING IS CHECKED FIRST AND ITS REFUSAL IS CARRIED FORWARD WHOLE. A host with no
// writable /dev/kvm or no Firecracker cannot boot anything, and a probe that discovered that by
// failing to produce a console would report an IMAGE verdict for a HOST fact -- sending a reader to
// the wrong module, which is the state-space conflation this repository refuses elsewhere.
// THE LOGIN COMES FROM THE HOST'S ROSTER ROW, because the standing now carries the executor's
// group enrolment and that is a fact about a named account. A probe on a host with no roster
// row has no executor to ask about, which is a BootNotAttempted cause like any other.
fn runner_microvm_boot_probe_wet() -> ProcessExit
{
  match executor_home_wet() {
    Absent => exit_failure(reason: "runner_microvm_boot_probe: HOME is unset, so neither the image root nor the Firecracker install root can be named")
    Present { value: home } => {
      let fc_root = firecracker_install_root(executor_home: home)
      match microvm_host_binding_wet() {
        MicrovmHostBindingRefused { cause: c } =>
          runner_microvm_boot_probe_receipt_wet(
            verdict: BootNotAttempted { cause: join(["the host this probe is running on is not bound to the host the dispatch selected, so no executor is named to ask about and nothing was booted: ", microvm_host_binding_refusal_text(c: c)], "") },
          )
        MicrovmHostBound { spec: spec, host: bound_host } => {
      let standing = observe_firecracker_host_standing_wet(root: fc_root, login: spec.job_user)
      if !firecracker_host_ready_in_this_process(standing: standing) {
        runner_microvm_boot_probe_receipt_wet(
          verdict: BootNotAttempted {
            cause: join(["the host cannot run a micro-VM at all, so no image verdict is available --\n", firecracker_host_standing_text(s: standing, host: bound_host, expected_login: spec.job_user)], ""),
          },
        )
      } else {
        let root = runner_guest_image_root(executor_home: home)
        let image = gunbc_runner_guest_image
        match runner_microvm_boot_probe_config(root: root) {
          MicroVmConfigUnresolved { cause: c } =>
            runner_microvm_boot_probe_receipt_wet(
              verdict: BootNotAttempted {
                cause: join(["no admissible VM configuration is derivable, so nothing was booted: ", c], ""),
              },
            )
          MicroVmConfigResolved { config: cfg } =>
            match run_shell_commands(commands: runner_microvm_boot_probe_stage_commands(root: root, image: image), transport: LocalExec) {
              ExitSuccess => {
                let j = Filesystem.Write(
                  path: runner_microvm_boot_probe_jit_drive(root: root),
                  content: jit_drive_without_credential(),
                )
                let w = Filesystem.Write(
                  path: runner_microvm_boot_probe_config_path(root: root),
                  content: firecracker_vm_config_document(config: cfg),
                )
                if !j.success {
                  runner_microvm_boot_probe_receipt_wet(
                    verdict: BootNotAttempted {
                      cause: join(["the credential-free JIT drive could not be written: ", j.error], ""),
                    },
                  )
                } else if !w.success {
                  runner_microvm_boot_probe_receipt_wet(
                    verdict: BootNotAttempted {
                      cause: join(["the VM configuration document could not be written: ", w.error], ""),
                    },
                  )
                } else {
                  // THE BOUND IS IMPOSED HERE: this layer starts the VMM in a process group of its own,
                  // waits on the kernel's classification, and signals that group -- and only that group --
                  // if its own deadline runs out. The captures are files this probe owns, under the probe
                  // directory it staged. No GNU timeout wrapper, no status-based deadline read.
                  let run = runner_microvm_boot_probe_run_bounded(
                    subject: firecracker_run_config_command(
                      binary: firecracker_installed_binary(root: fc_root, rel: firecracker_release_aarch64),
                      config_path: runner_microvm_boot_probe_config_path(root: root),
                    ),
                    deadline: runner_microvm_boot_probe_deadline,
                    kill_grace: runner_microvm_boot_probe_kill_grace,
                    stdout_file: join([runner_microvm_boot_probe_dir(root: root), "/vmm-console.txt"], "") as NonEmptyStr,
                    stderr_file: join([runner_microvm_boot_probe_dir(root: root), "/vmm-stderr.txt"], "") as NonEmptyStr,
                  )
                  runner_microvm_boot_probe_receipt_wet(
                    verdict: runner_microvm_boot_probe_verdict_from_run(runner: image.runner, run: run),
                  )
                }
              }
              other => other
            }
        }
      }
        }
      }
    }
  }
}

fn runner_microvm_boot_probe_receipt_wet(verdict: BootProbeVerdict) -> ProcessExit {
  let text = boot_probe_verdict_text(v: verdict)
  let _ = run_shell_commands(commands: [mkdir_parents_command(path: runner_microvm_boot_probe_receipt_dir)], transport: LocalExec)
  let w = Filesystem.Write(path: runner_microvm_boot_probe_receipt_path, content: concat(text, "\n"))
  if !w.success {
    exit_failure(reason: join(["runner_microvm_boot_probe: receipt write refused: ", w.error], ""))
  } else if boot_probe_admitted(v: verdict) {
    ExitSuccess
  } else {
    exit_failure(reason: join(["runner_microvm_boot_probe: the guest image did not demonstrate a boot --\n", text], ""))
  }
}
