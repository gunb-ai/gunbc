data runner_attempt_launch_disposition: Disposition = SingleAuthority

// THE CUTOVER CAPABILITY, NOT AN ARTIFACT. Shadow Y is this planner. The transition fires when
// THIS planner (or its successor of the same root) EXECUTES AT HOST BOOT and the host image is
// BUILT FROM THAT MODEL, so X's ISO path has no remaining production consumer. NAMED CONSUMER:
// the host-image build that carries this fold as PID 1's per-attempt driver. TRIGGER: that
// capability — Y execs at host boot, image built from Y — not a binary in a checkout, not a
// witness, not recovered/ remaining as evidence. SUFFICIENT FOR deleting recovered/ and this
// frontier together. NOT satisfied by this module existing beside the recovered init.
data host_boot_cutover_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: the host-image build whose per-attempt driver is gunbc.runner_attempt_launch plan_attempt_launch executed at host boot on tmpfs. TRIGGER: that capability holds — Y execs at host boot and the host image is built from Y — so the recovered initramfs/init path has zero production consumers. SUFFICIENT FOR deleting docs/recovered/mtcollins-host-image-source and this row in one motion. NOT satisfied by this planner compiling, by a gunbc binary in a checkout, or by Y sitting beside X." as NonEmptyStr,
)

// SHADOW MEANS SHADOW. No fleet-converge entry, no dual dispatch, no "use Y when available".
// Production does not import plan_attempt_launch; a Bool in this module cannot decide that.

// recovered/'s dissolution is NOT this PR. Y beside X does not satisfy it; that fact is the
// unbound host_boot_cutover_frontier, not a second false constant.

// §4b(1): the reported rung is the MINIMUM across in-scope paths. The planner-witness path has
// executed REDs. The host-boot jailer-exec path has not: host_image_placeability_standing is still
// HostShellAndBootImageAccessRefused (BMC answering is not tmpfs exec). Claiming
// MechanicallyPreventable for the class would be inflation. Cutover sequence:
// docs/plans/ci-per-job-microvm-migration.md — plan only, unbound host_boot_cutover_frontier.
data attempt_launch_planner_witness_rung: GuaranteeRung = MechanicallyPreventable

data attempt_launch_host_boot_exec_rung: GuaranteeRung = Mitigatable

fn reported_attempt_launch_rung() -> GuaranteeRung {
  if guarantee_rung_index(r: attempt_launch_host_boot_exec_rung)
    <= guarantee_rung_index(r: attempt_launch_planner_witness_rung) {
    attempt_launch_host_boot_exec_rung
  } else {
    attempt_launch_planner_witness_rung
  }
}

// THE JAILER FILESYSTEM CANNOT CARRY noexec OR nodev: the stock jailer copies the VMM into the
// chroot and mknods /dev/kvm there. Containment is chroot, namespaces, cgroup, and the uid drop.

data attempt_unprivileged_uid: Int = 1000

data attempt_unprivileged_gid: Int = 1000

data jit_config_byte_floor: ByteSize = byte_size(count: 512)

data jit_config_byte_ceiling: ByteSize = byte_size(count: 65536)

data jail_config_path: String = "/vm.json"

data jail_rootfs_path: FilePath = "/rootfs.squashfs"

data jail_kernel_path: FilePath = "/vmlinux"

data jail_jit_path: FilePath = "/jit.bin"

data jail_workspace_path: FilePath = "/work.img"

data host_busybox_bin: NonEmptyStr = "/bin/busybox"

// THE WORKSPACE GRANT MOVED TO gunbc.runner_microvm runner_microvm_workspace_grant, beside the
// drive it sizes, so the guest shape can judge the Work's storage demand against it; the plan
// realizes shape.workspace and no longer carries a size of its own.

type AttemptGround
  = GroundClear
  | GroundOccupied

// THE JIT CREDENTIAL IS ADMITTED FROM THE MINT'S OWN PERFORMANCE, NOT FROM A PRESENTED STANDING.
//
// This replaces X's EnvelopeStanding, which a CALLER assembled: a host fetched a blob, checked it,
// and told the planner "admitted, N bytes". The receipted fail-open was exactly that shape --
// jitconfig-bytes=0 and a launch anyway -- because the only thing between the fetch and the jailer
// was a value anyone could write. Here the planner takes gunbc.github_effect_perform's
// JitMintPerformance and admits a credential only from its delivered arm, bound to THIS attempt.
//
// "SIGNATURE-BOUND" is the App path, not a field. A JitMintReceived delivery is produced by
// perform_organization_jit_mint only after an RS256 App JWT signed with the host's key was accepted
// by GitHub for an installation token, and GitHub minted the blob against that token; the blob is
// opaque (gunbc.runner.runner_jit_admission) and there is no signature in it for a host to check.
// What is NOT structural, stated so it is not over-read: a caller can still construct a
// JitMintReceived beside the performer -- witnesses do -- so this is mitigatable on the planner
// path and its next rung is a sealed performance carrier. Host-envelope axes that had no subject
// once the fetch was gone (unit, boot, nonce, payload digest) dissolve into the attempt binding,
// as gunbc.runner.runner_jit_admission already rules for unit and boot.
type JitDeviceRefusal
  = JitMintNotReceived { performance: JitMintPerformance }
  | JitCredentialNotDelivered { delivery: JitCredentialDelivery }
  | JitCredentialBoundToDifferentAttempt { bound_to: MicroVmAttempt }
  | JitCredentialBelowFloor { bytes: ByteSize }
  | JitCredentialAboveCeiling { bytes: ByteSize }
  | JitMintAdmissionAxisNotRequired

// THE ONLY CARRIER A DEVICE CAN BE STAGED FROM, and admit_jit_credential is its only constructor.
// The registration id travels with the credential rather than beside it: it is GitHub's identity
// for the runner this blob registers, and it is recorded on the launch so every later event about
// this attempt can name the registration a leak or orphan would be reconciled against.
type AdmittedJitCredential sole_constructor {
  credential: EncodedJitConfig
  runner_name: JitRunnerName
  registration_id: Int
}

type JitCredentialAdmission
  = JitCredentialAdmitted { admitted: AdmittedJitCredential }
  | JitCredentialRefused { refusal: JitDeviceRefusal }

// BYTES, MEASURED AS BYTES. string_length counts CODE POINTS, so building a ByteSize from it labels
// one quantity as another -- they coincide for the base64 GitHub returns and diverge for anything
// else, which is exactly the silent wrong answer a floor and ceiling must not admit (review 68668).
// gunbc.runner_microvm jit_drive_utf8_size is the corpus authority for the UTF-8 size of text, and
// it is the same measure the staged device is read back against.
fn jit_credential_bytes(credential: EncodedJitConfig) -> ByteSize {
  jit_drive_utf8_size(text: credential.encoded as String)
}

// THE ROSTER IS CONSUMED, NOT RESTATED. gunbc.runner.runner_jit_admission declares signature and
// expiry required with the HostMintAdmission checker, and admit_jit_credential IS that checker; so
// it refuses if the roster stops saying so, rather than enforcing a wall the roster no longer
// declares (or the roster declaring one nothing enforces).
fn host_mint_admission_is_required() -> Bool {
  match jit_admission_axis_standing(axis: SignatureAxis) {
    AxisRequired { checker: HostMintAdmission } =>
      match jit_admission_axis_standing(axis: ExpiryAxis) {
        AxisRequired { checker: HostMintAdmission } => true
        _ => false
      }
    _ => false
  }
}

fn admit_jit_credential(attempt: MicroVmAttempt, mint: JitMintPerformance) -> JitCredentialAdmission {
  match mint {
    JitMintReceived { delivery: delivery } =>
      match delivery {
        JitCredentialBoundToAttempt { attempt: bound, credential: c, runner_id: id } =>
          if !host_mint_admission_is_required() {
            JitCredentialRefused { refusal: JitMintAdmissionAxisNotRequired }
          } else if bound != attempt {
            JitCredentialRefused { refusal: JitCredentialBoundToDifferentAttempt { bound_to: bound } }
          } else if !measure_le(a: jit_config_byte_floor, b: jit_credential_bytes(credential: c)) {
            JitCredentialRefused { refusal: JitCredentialBelowFloor { bytes: jit_credential_bytes(credential: c) } }
          } else if !measure_le(a: jit_credential_bytes(credential: c), b: jit_config_byte_ceiling) {
            JitCredentialRefused { refusal: JitCredentialAboveCeiling { bytes: jit_credential_bytes(credential: c) } }
          } else {
            JitCredentialAdmitted {
              admitted: AdmittedJitCredential {
                credential: c,
                runner_name: jit_runner_name_for(attempt: attempt),
                registration_id: id,
              },
            }
          }
        other => JitCredentialRefused { refusal: JitCredentialNotDelivered { delivery: other } }
      }
    other => JitCredentialRefused { refusal: JitMintNotReceived { performance: other } }
  }
}

// THE DEVICE, AS TWO HOST STEPS WHOSE ORDER IS THE SECURITY PROPERTY. (1) install(1) creates an
// EMPTY file already owned by the attempt's unprivileged uid and mode 0400, inside the attempt's
// jail; (2) the drive bytes are written into it -- through the filesystem, never an argv.
//
// THE BYTES ARE THE GUEST'S CONTRACT, NOT A HOST CHOICE. What goes on the drive is exactly
// gunbc.runner_microvm jit_drive_content(credential): one ACTIONS_RUNNER_INPUT_JITCONFIG line,
// newline-padded to whole sectors, which is what the guest agent (gunbc.runner_guest_image) reads
// from the device jit_drive_guest_device names. A second host-side format (the recovered init's
// NUL padding, which this module used to write) would be a second authority for one fact, and the
// guest could not read it. The staged file's size is therefore the content's own size, and
// readback checks exactly that.
//
// The file is inside the chroot of exactly one attempt. The guest sees it as a read-only drive
// (gunbc.runner_microvm JitConfigOnReadOnlyDrive) and never sees the host path, the App key, the
// JWT or the installation token, none of which this carrier holds.
type JitDeviceStaging {
  host_path: String
  create: ArgvCommand
  content: String
}

// ONE ROW FOR THE DEVICE'S MODE, in the digits stat(1) %a prints. install(1) -m takes the same
// digits with a leading 0; both spellings derive from this row, so they cannot drift.
data jit_device_mode_digits: NonEmptyStr = "400"

fn jit_device_install_mode() -> NonEmptyStr {
  concat("0", jit_device_mode_digits as String) as NonEmptyStr
}

fn jit_device_staging(jail_root: String, admitted: AdmittedJitCredential) -> JitDeviceStaging {
  let host_path = join([jail_root, jail_jit_path as String], "")
  JitDeviceStaging {
    host_path: host_path,
    create: install_empty_file_command(
      path: host_path,
      octal_mode: jit_device_install_mode(),
      uid: attempt_unprivileged_uid,
      gid: attempt_unprivileged_gid,
    ),
    content: jit_drive_content(encoded_jit_config: admitted.credential.encoded),
  }
}

// PID1 refusals (no boot secret, stage2 missing files) have no constructor on AttemptLaunchPlan.
// That is the census: they are outside this per-attempt planner by construction, not by a Bool.
//
// WHAT THIS ARM ESTABLISHES, AND WHAT IT DOES NOT. jit_device and jailer are fields of ONE arm,
// and plan_after_authorization reaches it only through admit_jit_credential's admitted arm, so a
// plan BUILT BY THIS PLANNER carries a staging plan and a jailer command together or carries
// neither.
//
// THAT IS NOT A CONSTRUCTION WALL, and an earlier revision of this comment said it was. This type
// is not sole_constructor, so a LaunchAuthorized is assemblable outside this module, and its jailer
// field is readable by any holder: a caller can execute plan.jailer without ever obtaining the
// AttemptStagingReceipt that attempt_staging_verdict produces, and modules outside this one already
// read that field. So the arm establishes that every LaunchAuthorized HAS FIELDS FOR BOTH -- not
// that the value came from admit_jit_credential, not that staging ran, not that the readbacks
// happened, and not that the jailer cannot be obtained first. The rung this module reports,
// Mitigatable, is the honest one; the earlier "unwritable by shape" language was not.
//
// AND DEVICE-WITHOUT-LAUNCH IS NOT THE STATE THAT MUST BE IMPOSSIBLE: a staged device with no VMM
// is safe provided teardown removes it. The dangerous state is A VMM LAUNCHED WITHOUT AN
// EFFECT-BOUND, READ-BACK CREDENTIAL DEVICE FOR THIS ATTEMPT. ONE MECHANICALLY PREVENTING REPAIR
// is to withhold the raw jailer capability until after effect-bound staging, with the staging
// realization constructing the executable jailer from its own observations. That is a substantive
// redesign, not a comment fix, and is not attempted here.

// ── TWO AUTHORIZATIONS, ONE PLAN, AND THE SECOND IS A DECLARED FRONTIER'S SUBSTITUTE ─────────
//
// THE GRANT ARM IS THE TERMINAL CONSTRUCTION AND HAS NO PRODUCER. grant_authorizes_reservation
// consumes an ExecutionGrant, and nothing in production constructs one (gunbc.fabric_control_plane
// "THREE GAPS THAT ARE ONE ABSENCE": the ReleaseDirective-to-slot-key relation, the atomic
// cross-ledger acquire join and the whole identity layer are unproduced). So, for the trusted-
// workload microVM shakedown on srv1, the parent lane ruled (2026-09-21) that the planner admits a
// SECOND authorization: the sealed RequiredBuildCellSnapshot, which is the host CAS's own re-read of
// the committed reservation and is constructible only inside
// gunbc.fabric_required_build_cell observe_required_build_cell_wet (one construction site, checked
// by test.claim.runner.runner_attempt_launch_witness_test).
//
// WHAT THE SNAPSHOT ARM PRESERVES, REFUSAL FOR REFUSAL. The grant join refuses on four facts:
//   fence      the presented generation equals the account's held lease generation for this
//              reservation. The MoneyAccount is a pure in-process value with no durable home, so
//              in a later process the fence's referent does not exist; what the host DOES hold is
//              the CAS generation the snapshot was read at, and the controller binds the attempt's
//              allocation generation to it (gunbc.runner_microvm_lifecycle controller_start's
//              CellBindingRefusedGeneration). The arm carries that generation and refuses if the
//              caller's allocation generation disagrees -- ReservationGenerationDisagrees.
//   work       the reservation's demand names the Work presented -- ReservationNamesDifferentWork.
//   demand     the hold owner the CAS holds IS fabric_hold_owner(demand, offer), checked by the
//              snapshot's producer (ReservationPayloadWorkMismatch refuses before a snapshot
//              exists); the snapshot's demand is therefore the held one.
//   offer      likewise, plus the producer's own SelectedOfferCellMismatch (offer.executor must be
//              the slot key); the arm re-checks the slot the attempt is for against the snapshot's
//              cell -- ReservationForDifferentCell.
// The only fact dropped is the grant's own identity (GrantKey, permit, evidence), which is exactly
// the unproduced layer.
//
// THE ARM IS SELECTED BY THE WORK'S TRUST DOMAIN AS A TYPED FACT, NOT BY A FLAG: a Work whose
// requirements.trust_domain is not gunbc.fabric_witness_run gunbc_internal_fleet_trust_domain
// refuses with ReservationArmRequiresInternalFleetTrust, so the untrusted-CI route -- which the
// migration plan keeps grant disagreement for -- cannot reach this arm by construction. The
// witness carries the control.
//
// THE RECEIPT SAYS reservation-authorized, UNDER ITS OWN NAME. LaunchAuthorization keeps the two
// arms apart all the way to the readback, so no receipt can call a reservation-authorized attempt
// grant-authorized (a meaning fork, DESIGN section 3).
//
// DECLARED FRONTIER (DESIGN 3c/4b(3)), AT CAPABILITY GRAIN: an ExecutionGrant PRODUCED AT
// RESERVATION COMMIT with the atomic cross-ledger join, persisted beside the CAS reservation and
// re-read by the controller. When it lands, LaunchAuthorizedByReservation is DELETED, not kept:
// the witness already carries that flip (its control over the reservation arm becomes a refusal
// that the arm no longer exists).
data reservation_authorization_grant_producer_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_attempt_launch plan_attempt_launch, which today consumes an ExecutionGrant no production route constructs, so the microVM shakedown runs through plan_attempt_launch_reservation_authorized instead. TRIGGER, at capability grain: an ExecutionGrant produced at reservation commit with the atomic cross-ledger join (gunbc.fabric_control_plane 'THREE GAPS' note: ReleaseDirective-to-slot-key relation, atomic acquire join, produced identity layer), persisted beside the CAS reservation and re-read by the slot controller in a later process. SUFFICIENT FOR deleting LaunchAuthorizedByReservation, ReservationAuthorization, plan_attempt_launch_reservation_authorized and this row together. NOT satisfied by a witness constructing a grant, by the reservation arm being narrowed further, or by a durable MoneyAccount alone." as NonEmptyStr,
)

type ReservationAuthorization
  = ReservationAuthorizes
  | ReservationArmRequiresInternalFleetTrust { trust_domain: TrustDomainRef }
  | ReservationNamesDifferentWork { reserved: FabricIdentity<NonEmptyStr, WorkKey>, presented: FabricIdentity<NonEmptyStr, WorkKey> }
  | ReservationForDifferentCell { reserved: CellId, attempt_cell: CellId }
  | ReservationGenerationDisagrees { reserved: Int, presented: Int }

type LaunchAuthorization
  = LaunchAuthorizedByGrant { authorization: GrantAuthorization }
  | LaunchAuthorizedByReservation { authorization: ReservationAuthorization }

// THE AGREEMENT IS A PURE FOLD OVER THE RESERVED FACTS, so a witness can drive every refusal with
// supplied values (the snapshot is sole_constructor and only its wet producer can build one); the
// sealed wrapper below is the only production caller and reads those facts off the snapshot.
fn reservation_agreement(
  reserved_work: FabricIdentity<NonEmptyStr, WorkKey>,
  reserved_cell: CellId,
  reserved_generation: Int,
  work: Work<NonEmptyStr>,
  attempt: MicroVmAttempt,
  allocation_generation: Int,
) -> ReservationAuthorization {
  if (work.requirements.trust_domain as String) != (gunbc_internal_fleet_trust_domain as String) {
    ReservationArmRequiresInternalFleetTrust { trust_domain: work.requirements.trust_domain }
  } else if !fabric_identity_eq(left: reserved_work, right: work.id) {
    ReservationNamesDifferentWork { reserved: reserved_work, presented: work.id }
  } else if (reserved_cell as String) != (fabric_cell_id_for_slot(slot: attempt.slot) as String) {
    ReservationForDifferentCell { reserved: reserved_cell, attempt_cell: fabric_cell_id_for_slot(slot: attempt.slot) }
  } else if reserved_generation != allocation_generation {
    ReservationGenerationDisagrees { reserved: reserved_generation, presented: allocation_generation }
  } else {
    ReservationAuthorizes
  }
}

fn reservation_authorizes_attempt(
  snapshot: RequiredBuildCellSnapshot,
  work: Work<NonEmptyStr>,
  attempt: MicroVmAttempt,
  allocation_generation: Int,
) -> ReservationAuthorization {
  reservation_agreement(
    reserved_work: snapshot.work,
    reserved_cell: snapshot.cell,
    reserved_generation: snapshot.generation,
    work: work,
    attempt: attempt,
    allocation_generation: allocation_generation,
  )
}

fn plan_attempt_launch_reservation_authorized(
  snapshot: RequiredBuildCellSnapshot,
  work: Work<NonEmptyStr>,
  allocation_generation: Int,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  shape: RunnerMicroVmShape,
) -> AttemptLaunchPlan {
  let authorization = reservation_authorizes_attempt(
    snapshot: snapshot, work: work, attempt: attempt, allocation_generation: allocation_generation,
  )
  match authorization {
    ReservationAuthorizes => plan_after_authorization(
      authorization: LaunchAuthorizedByReservation { authorization: authorization },
      attempt: attempt,
      mint: mint,
      ground: ground,
      jailer_binary: jailer_binary,
      firecracker_binary: firecracker_binary,
      kernel_source: kernel_source,
      rootfs_source: rootfs_source,
      shape: shape,
    )
    refused => LaunchRefusedUnauthorized { authorization: LaunchAuthorizedByReservation { authorization: refused } }
  }
}

type AttemptLaunchPlan
  = LaunchRefusedUnauthorized { authorization: LaunchAuthorization }
  | LaunchRefusedJitCredential { refusal: JitDeviceRefusal }
  | LaunchRefusedPriorResources
  | LaunchAuthorized {
      authorization: LaunchAuthorization
      jit_runner_name: JitRunnerName
      jit_registration_id: Int
      jit_device: JitDeviceStaging
      tap_device: NonEmptyStr
      guest_ip_boot_arg: String
      slice: SystemdRunProperty
      jail_root: String
      stage_jail_root: ArgvCommand
      stage_kernel: ArgvCommand
      stage_rootfs: ArgvCommand
      workspace_path: String
      workspace_create: ArgvCommand
      workspace_format: ArgvCommand
      kvm_device: FilePath
      vm_config: FirecrackerVmConfig
      jailer: ArgvCommand
    }

// ONE APPENDER FOR EVERY BOOT ARGUMENT THE PLAN ADDS -- the guest address today -- so the join
// is spelled once and a second argument is one more call, not a second copy.
fn with_boot_arg(config: FirecrackerVmConfig, arg: String) -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: FirecrackerBootSource {
      kernel_image_path: config.boot_source.kernel_image_path,
      boot_args: join([config.boot_source.boot_args as String, " ", arg], "") as NonEmptyStr,
    },
    drives: config.drives,
    network_interfaces: config.network_interfaces,
    machine_config: config.machine_config,
  }
}

fn bounded_jailer_command(
  jailer_binary: String,
  jailer_id: String,
  exec_file: String,
  chroot_base_dir: String,
) -> ArgvCommand {
  timeout_command(
    duration: runner_attempt_vmm_deadline,
    kill_after: runner_attempt_vmm_kill_grace,
    command: firecracker_jailer_run_command(
      jailer_binary: jailer_binary,
      jailer_id: jailer_id,
      exec_file: exec_file,
      uid: attempt_unprivileged_uid,
      gid: attempt_unprivileged_gid,
      chroot_base_dir: chroot_base_dir,
      config_path_in_jail: jail_config_path,
    ),
  )
}

fn plan_attempt_launch(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  money_generation: Int,
  work: FabricIdentity<NonEmptyStr, WorkKey>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  offer: FabricIdentity<NonEmptyStr, OfferKey>,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  shape: RunnerMicroVmShape,
) -> AttemptLaunchPlan {
  let authorization = grant_authorizes_reservation(
    grant: grant,
    account: account,
    money_generation: money_generation,
    work: work,
    demand: demand,
    offer: offer,
  )
  match authorization {
    GrantAuthorizes => plan_after_authorization(
      authorization: LaunchAuthorizedByGrant { authorization: authorization },
      attempt: attempt,
      mint: mint,
      ground: ground,
      jailer_binary: jailer_binary,
      firecracker_binary: firecracker_binary,
      kernel_source: kernel_source,
      rootfs_source: rootfs_source,
      shape: shape,
    )
    GrantFenceRefused => LaunchRefusedUnauthorized { authorization: LaunchAuthorizedByGrant { authorization: authorization } }
    GrantAuthorizesDifferentWork => LaunchRefusedUnauthorized { authorization: LaunchAuthorizedByGrant { authorization: authorization } }
    GrantAnswersDifferentDemand => LaunchRefusedUnauthorized { authorization: LaunchAuthorizedByGrant { authorization: authorization } }
    GrantIssuedAgainstDifferentOffer => LaunchRefusedUnauthorized { authorization: LaunchAuthorizedByGrant { authorization: authorization } }
  }
}

fn plan_after_authorization(
  authorization: LaunchAuthorization,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  shape: RunnerMicroVmShape,
) -> AttemptLaunchPlan {
  match ground {
    GroundOccupied => LaunchRefusedPriorResources
    GroundClear =>
      match admit_jit_credential(attempt: attempt, mint: mint) {
        JitCredentialRefused { refusal: r } => LaunchRefusedJitCredential { refusal: r }
        JitCredentialAdmitted { admitted: admitted } => plan_authorized_steps(
          authorization: authorization,
          attempt: attempt,
          admitted: admitted,
          jailer_binary: jailer_binary,
          firecracker_binary: firecracker_binary,
          kernel_source: kernel_source,
          rootfs_source: rootfs_source,
          shape: shape,
        )
      }
  }
}

fn plan_authorized_steps(
  authorization: LaunchAuthorization,
  attempt: MicroVmAttempt,
  admitted: AdmittedJitCredential,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  shape: RunnerMicroVmShape,
) -> AttemptLaunchPlan {
  let net = runner_slot_network(slot: attempt.slot)
  let jail_root = attempt_jail_chroot_root(attempt: attempt, firecracker_binary: firecracker_binary)
  let workspace_host = join([jail_root, jail_workspace_path as String], "")
  let cfg = runner_microvm_vm_config(
    rootfs_path: jail_rootfs_path,
    jit_config_path: jail_jit_path,
    kernel_path: jail_kernel_path,
    net: runner_slot_network_as_microvm_networking(net: net),
    size: shape.size,
    transport: gunbc_runner_jit_transport,
  )
  let jailed = with_boot_arg(
    config: attach_workspace_drive(config: cfg, path: jail_workspace_path),
    arg: runner_slot_guest_network_boot_args(net: net),
  )
  LaunchAuthorized {
    authorization: authorization,
    jit_runner_name: admitted.runner_name,
    jit_registration_id: admitted.registration_id,
    jit_device: jit_device_staging(jail_root: jail_root, admitted: admitted),
    tap_device: net.tap_device,
    guest_ip_boot_arg: runner_slot_guest_network_boot_args(net: net),
    slice: runner_microvm_attempt_slice_property(attempt: attempt),
    jail_root: jail_root,
    stage_jail_root: mkdir_parents_command(path: jail_root),
    stage_kernel: cp_command(
      source: kernel_source,
      destination: join([jail_root, jail_kernel_path as String], ""),
    ),
    stage_rootfs: cp_command(
      source: rootfs_source,
      destination: join([jail_root, jail_rootfs_path as String], ""),
    ),
    workspace_path: workspace_host,
    workspace_create: busybox_dd_sparse_image_command(
      busybox_bin: host_busybox_bin,
      image_path: workspace_host,
      size: shape.workspace,
    ),
    workspace_format: mke2fs_format_command(
      fs: Ext2,
      image_path: workspace_host,
    ),
    kvm_device: firecracker_requires_kvm_device,
    vm_config: jailed,
    jailer: bounded_jailer_command(
      jailer_binary: jailer_binary,
      jailer_id: attempt.attempt_id.value as String,
      exec_file: firecracker_binary,
      chroot_base_dir: runner_microvm_attempt_jail_base(attempt: attempt),
    ),
  }
}

fn attempt_jail_chroot_root(attempt: MicroVmAttempt, firecracker_binary: String) -> String {
  firecracker_jailer_chroot_root(
    chroot_base_dir: runner_microvm_attempt_jail_base(attempt: attempt),
    exec_file: firecracker_binary,
    jailer_id: attempt.attempt_id.value as String,
  )
}

fn workspace_drive_path_on_host(config: FirecrackerVmConfig) -> String {
  fold(config.drives, init: "", f: (acc, d) =>
    if (d.drive_id as String) == (runner_microvm_workspace_drive_id as String) {
      d.path_on_host as String
    } else {
      acc
    }
  )
}

fn planned_jailer_launches(plan: AttemptLaunchPlan) -> Int {
  match plan {
    LaunchAuthorized {
      authorization: _,
      jit_runner_name: _,
      jit_registration_id: _,
      jit_device: _,
      tap_device: _,
      guest_ip_boot_arg: _,
      slice: _,
      jail_root: _,
      stage_jail_root: _,
      stage_kernel: _,
      stage_rootfs: _,
      workspace_path: _,
      workspace_create: _,
      workspace_format: _,
      kvm_device: _,
      vm_config: _,
      jailer: _,
    } => 1
    LaunchRefusedUnauthorized { authorization: _ } => 0
    LaunchRefusedJitCredential { refusal: _ } => 0
    LaunchRefusedPriorResources => 0
  }
}

// STAGING, PERFORMED -- and READ BACK FROM THE HOST rather than believed from the steps' exits.
// Each step's refusal is its own arm naming the step, so a failed install is not reported as a
// failed write. The readback checks the three facts the device's safety rests on: owned by the
// attempt's uid (the jailer drops to it, so root-owned would be unreadable and anything looser would
// be readable by others), mode 0400, and size exactly the drive content's size (so the guest reads
// whole sectors of the contract it expects). A stat that itself failed is its own refusal carrying
// its stderr -- not a mismatch of an empty reading (review 68502). A device that fails readback is
// a refusal: the caller must not launch over it.
type JitDeviceStagingStep
  = JitDeviceCreateStep
  | JitDeviceWriteStep
  | JitDeviceReadbackStep

type JitDeviceStagingOutcome
  = JitDeviceStaged { host_path: String }
  | JitDeviceStagingRefused { step: JitDeviceStagingStep, detail: String }

fn jit_device_fact(name: String, reading: StatFieldReading, expected: String) -> JitDeviceStagingOutcome? {
  match reading {
    StatFieldUnread { detail: d } =>
      Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: join([name, " unread: ", d], "") } }
    StatFieldRead { value: v } =>
      if v == expected {
        none
      } else {
        Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: join([name, " is ", v, ", expected ", expected], "") } }
      }
  }
}

fn jit_device_readback(
  uid: StatFieldReading,
  mode: StatFieldReading,
  size: StatFieldReading,
  content: String,
) -> JitDeviceStagingOutcome? {
  match jit_device_fact(name: "owner uid", reading: uid, expected: to_string(attempt_unprivileged_uid)) {
    Present { value: r } => Present { value: r }
    Absent =>
      match jit_device_fact(name: "mode", reading: mode, expected: jit_device_mode_digits as String) {
        Present { value: r } => Present { value: r }
        Absent =>
          jit_device_fact(
            name: "size",
            reading: size,
            expected: to_string(byte_size_count(b: jit_drive_utf8_size(text: content))),
          )
      }
  }
}

fn stage_jit_device(device: JitDeviceStaging) -> JitDeviceStagingOutcome
  uses net: Network, fs: Filesystem
{
  match run_shell_command_capture(command: device.create, transport: LocalExec) {
    ProcessRefused { exit_code: _, stderr: e } =>
      JitDeviceStagingRefused { step: JitDeviceCreateStep, detail: trim(s: e) }
    _ => {
      let wrote = Filesystem.Write(path: device.host_path, content: device.content)
      if wrote.success == false {
        JitDeviceStagingRefused { step: JitDeviceWriteStep, detail: device.host_path }
      } else {
        match jit_device_readback(
          uid: stat_field_reading(outcome: run_shell_command_capture(command: stat_owner_uid_command(path: device.host_path), transport: LocalExec)),
          mode: stat_field_reading(outcome: run_shell_command_capture(command: stat_mode_command(path: device.host_path), transport: LocalExec)),
          size: stat_field_reading(outcome: run_shell_command_capture(command: stat_size_bytes_command(path: device.host_path), transport: LocalExec)),
          content: device.content,
        ) {
          Present { value: refused } => refused
          Absent => JitDeviceStaged { host_path: device.host_path }
        }
      }
    }
  }
}

type WorkNotEstablished {
  vmm_exit: Int
}

fn work_standing_from_vmm_exit(exit_code: Int) -> WorkNotEstablished {
  WorkNotEstablished { vmm_exit: exit_code }
}

// --- the workspace readback: staging admits the jailer or refuses it ---

// THE PLAN SAYS WHAT TO RUN; THIS SAYS WHETHER WHAT RAN LEFT A WORKSPACE. They are separate
// because they are separated in time: plan_attempt_launch is decided before any host mutation, and
// the dd and mke2fs it plans can fail after it has answered LaunchAuthorized. A guest launched onto
// a workspace that failed to format boots, mounts nothing, and fails the job far from its cause --
// so the jailer is gated on a reading of the image, not on the plan that asked for it.
//
// THE READING IS INDEPENDENT OF THE EXIT CODES. mke2fs exiting zero is the formatter's claim; the
// superblock read back from the image is the host's observation of the result. Both are required,
// and the readback also carries the size, because a sparse `seek` onto a full disk can leave a file
// shorter than asked without dd failing.
//
// The image lives under the attempt's jail root (runner_microvm_attempt_jail_base), so teardown's
// one subtree to prove absent already contains it; nothing here adds a second location.
// THE READING NAMES THE IMAGE IT READ. A superblock read of some other image -- the previous
// attempt's, another slot's -- says nothing about this plan's workspace, so the path travels with
// the reading and staging compares it against the plan's own workspace_path (sunny-ant-606 ruling on
// #11675). The path is attempt-bound by construction: it sits under the attempt's jail root.
type WorkspaceReadback
  = WorkspaceSuperblockRead { image_path: String, ext_magic: Bool, bytes: ByteSize }
  | WorkspaceReadbackFailed { reason: NonEmptyStr }

type WorkspaceStagingObservation {
  create_exit: Int
  format_exit: Int
  readback: WorkspaceReadback
}

type WorkspaceStanding
  = WorkspaceReady
  | WorkspaceCreateFailed { exit: Int }
  | WorkspaceFormatFailed { exit: Int }
  | WorkspaceNotExtFilesystem
  | WorkspaceSizeMismatch { observed: ByteSize, expected: ByteSize }
  | WorkspaceUnreadable { reason: NonEmptyStr }
  | WorkspaceReadbackOfDifferentImage { read: String, planned: String }

// THE EXPECTED SIZE IS THE ONE GRANT, read from gunbc.runner_microvm runner_microvm_workspace_grant
// -- the same row the plan's dd seek and the guest shape's storage fit read -- so the readback
// judges the image against the size that was planned and not against a second copy of it.
fn runner_attempt_workspace_bytes() -> ByteSize {
  mebibyte_to_byte_size(m: runner_microvm_workspace_grant)
}

// THE ORDER IS CAUSAL: a failed create makes the format's exit meaningless, and a failed format
// makes the superblock reading meaningless, so the earliest failure is the one reported.
fn workspace_standing(obs: WorkspaceStagingObservation, planned_path: String) -> WorkspaceStanding {
  if obs.create_exit != 0 {
    WorkspaceCreateFailed { exit: obs.create_exit }
  } else if obs.format_exit != 0 {
    WorkspaceFormatFailed { exit: obs.format_exit }
  } else {
    match obs.readback {
      WorkspaceReadbackFailed { reason: r } => WorkspaceUnreadable { reason: r }
      WorkspaceSuperblockRead { image_path: read, ext_magic: m, bytes: b } =>
        if read != planned_path {
          WorkspaceReadbackOfDifferentImage { read: read, planned: planned_path }
        } else if !m {
          WorkspaceNotExtFilesystem
        } else if byte_size_count(b: b) != byte_size_count(b: runner_attempt_workspace_bytes()) {
          WorkspaceSizeMismatch { observed: b, expected: runner_attempt_workspace_bytes() }
        } else {
          WorkspaceReady
        }
    }
  }
}

// THE JAIL'S MATERIAL IS STAGED BY THREE COMMANDS AND ALL THREE USED TO BE DISCARDED.
//
// stage_jail_root, stage_kernel and stage_rootfs ran and their exits went nowhere: the verdict below
// discriminated only on the JIT device and the workspace superblock, so a `cp` that failed left the
// receipt mintable and released the jailer onto a chroot with no kernel in it. The guest then fails
// to boot far from its cause -- which is the exact failure this file already argues against for the
// workspace two screens up, with the asymmetry sitting two lines apart in the caller (review 69084).
//
// THE ORDER IS CAUSAL, as it is for the workspace: a jail root that was not created makes the copies
// meaningless, and a copy that failed makes its readback meaningless. So the earliest failure is the
// one reported.
//
// AND THE EXITS ARE THE CLAIM WHILE THE READBACK IS THE OBSERVATION, the same split the workspace
// makes. `cp` exiting zero is the tool's word; the file being at the path the jailer will open is the
// host's. They are separated in time by a full disk and by a destination nobody checked.
type JailMaterialStep
  = JailRootStep
  | JailKernelStep
  | JailRootfsStep

fn jail_material_step_label(step: JailMaterialStep) -> String {
  match step {
    JailRootStep => "jail root"
    JailKernelStep => "kernel"
    JailRootfsStep => "rootfs"
  }
}

type JailMaterialStaging {
  jail_root_exit: Int
  kernel_exit: Int
  rootfs_exit: Int
  kernel: PathExistenceReading
  rootfs: PathExistenceReading
}

type JailMaterialStanding
  = JailMaterialReady
  | JailMaterialStepFailed { step: JailMaterialStep, exit: Int }
  | JailMaterialMissing { step: JailMaterialStep }
  | JailMaterialUnobservable { step: JailMaterialStep, reason: NonEmptyStr }

fn jail_material_standing(obs: JailMaterialStaging) -> JailMaterialStanding {
  if obs.jail_root_exit != 0 {
    JailMaterialStepFailed { step: JailRootStep, exit: obs.jail_root_exit }
  } else if obs.kernel_exit != 0 {
    JailMaterialStepFailed { step: JailKernelStep, exit: obs.kernel_exit }
  } else if obs.rootfs_exit != 0 {
    JailMaterialStepFailed { step: JailRootfsStep, exit: obs.rootfs_exit }
  } else {
    jail_material_readbacks(kernel: obs.kernel, rootfs: obs.rootfs)
  }
}

fn jail_material_readbacks(kernel: PathExistenceReading, rootfs: PathExistenceReading) -> JailMaterialStanding {
  match jail_material_present(step: JailKernelStep, reading: kernel) {
    Present { value: refusal } => refusal
    Absent =>
      match jail_material_present(step: JailRootfsStep, reading: rootfs) {
        Present { value: refusal } => refusal
        Absent => JailMaterialReady
      }
  }
}

// STAGING NEEDS NO CONTAINMENT AND SANITATION DOES, which is why this arm folds the ambiguous reading
// where the sanitation readback must open it. `test -e` false means the jailer cannot open the file,
// whether it is missing or merely unstattable, and either way the launch must refuse. Absence is only
// load-bearing in the direction that RELEASES something, and nothing is released here.
fn jail_material_present(step: JailMaterialStep, reading: PathExistenceReading) -> JailMaterialStanding? {
  match reading {
    PathPresent => none
    PathAbsentOrUnstattable => Present { value: JailMaterialMissing { step: step } }
    PathExistenceUnreadable { reason: r } => Present { value: JailMaterialUnobservable { step: step, reason: r } }
  }
}

// THE PATHS THE READBACK ASKS ABOUT ARE THE ONES THE PLAN'S OWN COPIES WRITE TO, derived from the same
// jail_root and the same interface rows, so a readback cannot drift onto a file the jailer will not
// open.
fn jail_kernel_destination(jail_root: String) -> String {
  join([jail_root, jail_kernel_path as String], "")
}

fn jail_rootfs_destination(jail_root: String) -> String {
  join([jail_root, jail_rootfs_path as String], "")
}

// THE RECEIPT IS SEALED: sole_constructor makes attempt_staging_verdict the only
// producer of an AttemptStagingReceipt, so a caller cannot construct that receipt
// beside the gate. The receipt carries the planned JIT-device path and workspace
// path against which the supplied outcomes were judged.
//
// WHAT SEALING DOES NOT PROVE, twice over. FIRST, it does not withhold the jailer
// capability: the same jailer command sits in plain sight on AttemptLaunchPlan's
// LaunchAuthorized arm, which is not sole_constructor, so a caller holding the plan
// already has the capability this receipt was described as gating.
// SECOND, the gate accepts CALLER-AUTHORED positive outcomes: a JitDeviceStaged value is
// constructible without stage_jit_device ever running -- this module's own witnesses construct one
// to drive the foreign-device case -- so a sealed receipt proves the gate was CALLED with
// positive-shaped arguments, not that the host effects and their readbacks occurred.
//
// A PROSE OBLIGATION BESIDE A JAILER-ADMITTING VALUE IS NOT A WALL (sunny-ant-606 ruling): the
// frontier row can say the controller must reach the jailer through this fold, and a controller
// following it exactly would still have launched on workspace readiness alone while the credential
// device had failed. The premises are made inseparable here instead.
type AttemptStagingReceipt sole_constructor {
  jailer: ArgvCommand
  jit_device_path: String
  workspace_path: String
}

type AttemptStagingVerdict
  = StagingAdmitsJailer { receipt: AttemptStagingReceipt }
  | StagingRefusedJailMaterial { standing: JailMaterialStanding }
  | StagingRefusedJitDevice { outcome: JitDeviceStagingOutcome }
  | StagingRefusedForeignJitDevice { staged_path: String, planned_path: String }
  | StagingRefusedWorkspace { standing: WorkspaceStanding }
  | StagingNotAuthorized

// THE ONLY ROUTE TO THE JAILER COMMAND AFTER STAGING, AND IT CONSUMES BOTH STAGINGS. A refused plan
// has no jailer to admit; a workspace that is anything but WorkspaceReady refuses; and the JIT
// device must have been STAGED FOR THIS ATTEMPT -- the staged path is compared against the path this
// plan's own jit_device names, so a sibling attempt's device (or a stale one left at another path)
// refuses rather than being launched over.
//
// TAKING ONLY THE WORKSPACE OBSERVATION WAS A FAIL-OPEN, AND IT WAS CREATED BY A MERGE rather than
// authored: the workspace gate landed on one side and the JIT device on the other, and the join
// admitted a ready workspace while the credential device had failed to stage or had never been
// staged at all. A guest reaching the listener with no credential burns its whole deadline looking
// healthy, which is the class this planner exists to close, so the gate takes both outcomes and
// there is no arm that launches on one of them.
fn attempt_staging_verdict(
  plan: AttemptLaunchPlan,
  jail: JailMaterialStaging,
  jit: JitDeviceStagingOutcome,
  workspace: WorkspaceStagingObservation,
) -> AttemptStagingVerdict {
  match plan {
    LaunchAuthorized {
      authorization: _,
      jit_runner_name: _,
      jit_registration_id: _,
      jit_device: device,
      tap_device: _,
      guest_ip_boot_arg: _,
      slice: _,
      jail_root: _,
      stage_jail_root: _,
      stage_kernel: _,
      stage_rootfs: _,
      workspace_path: planned,
      workspace_create: _,
      workspace_format: _,
      kvm_device: _,
      vm_config: _,
      jailer: j,
    } =>
      match jail_material_standing(obs: jail) {
        JailMaterialReady => attempt_staging_after_jail(device: device, planned: planned, jailer: j, jit: jit, workspace: workspace)
        refused_material => StagingRefusedJailMaterial { standing: refused_material }
      }
    LaunchRefusedUnauthorized { authorization: _ } => StagingNotAuthorized
    LaunchRefusedJitCredential { refusal: _ } => StagingNotAuthorized
    LaunchRefusedPriorResources => StagingNotAuthorized
  }
}

fn attempt_staging_after_jail(
  device: JitDeviceStaging,
  planned: String,
  jailer: ArgvCommand,
  jit: JitDeviceStagingOutcome,
  workspace: WorkspaceStagingObservation,
) -> AttemptStagingVerdict {
  match jit {
    JitDeviceStagingRefused { step: _, detail: _ } => StagingRefusedJitDevice { outcome: jit }
    JitDeviceStaged { host_path: staged } =>
      if staged != device.host_path {
        StagingRefusedForeignJitDevice { staged_path: staged, planned_path: device.host_path }
      } else {
        attempt_staging_after_jit(staged: staged, planned: planned, jailer: jailer, workspace: workspace)
      }
  }
}

fn attempt_staging_after_jit(
  staged: String,
  planned: String,
  jailer: ArgvCommand,
  workspace: WorkspaceStagingObservation,
) -> AttemptStagingVerdict {
  let s = workspace_standing(obs: workspace, planned_path: planned)
  match s {
    WorkspaceReady =>
      StagingAdmitsJailer {
        receipt: AttemptStagingReceipt {
          jailer: jailer,
          jit_device_path: staged,
          workspace_path: planned,
        },
      }
    WorkspaceCreateFailed { exit: _ } => StagingRefusedWorkspace { standing: s }
    WorkspaceFormatFailed { exit: _ } => StagingRefusedWorkspace { standing: s }
    WorkspaceNotExtFilesystem => StagingRefusedWorkspace { standing: s }
    WorkspaceSizeMismatch { observed: _, expected: _ } => StagingRefusedWorkspace { standing: s }
    WorkspaceUnreadable { reason: _ } => StagingRefusedWorkspace { standing: s }
    WorkspaceReadbackOfDifferentImage { read: _, planned: _ } => StagingRefusedWorkspace { standing: s }
  }
}


fn workspace_readback_command(workspace_path: String) -> ArgvCommand {
  dumpe2fs_superblock_command(image_path: workspace_path)
}

