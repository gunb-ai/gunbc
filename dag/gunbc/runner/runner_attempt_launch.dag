data runner_attempt_launch_disposition: Disposition = SingleAuthority

// THE CUTOVER CAPABILITY, NOT AN ARTIFACT. Shadow Y is this planner. The transition fires when
// THIS planner (or its successor of the same root) EXECUTES AT HOST BOOT and the host image is
// BUILT FROM THAT MODEL, so X's ISO path has no remaining production consumer. NAMED CONSUMER:
// the host-image build that carries this fold as PID 1's per-attempt driver. TRIGGER: that
// capability — Y execs at host boot, image built from Y — not a binary in a checkout, not a
// witness, not recovered/ remaining as evidence. SUFFICIENT FOR deleting recovered/ and this
// frontier together. NOT satisfied by this module existing beside the recovered init.
data host_boot_cutover_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: the host-image build whose per-attempt driver is gunbc.runner_attempt_launch plan_attempt_launch executed at host boot on tmpfs. TRIGGER: that capability holds — Y execs at host boot and the host image is built from Y — so the recovered initramfs/init path has zero production consumers. SUFFICIENT FOR deleting docs/recovered/mtcollins-host-image-source and this row in one motion. NOT satisfied by this planner compiling, by a gunbc binary in a checkout, or by Y sitting beside X." as NonEmptyStr,
)

// SHADOW MEANS SHADOW. No fleet-converge entry, no dual dispatch, no "use Y when available".
// Production does not import plan_attempt_launch; a Bool in this module cannot decide that.

// recovered/'s dissolution is NOT this PR. Y beside X does not satisfy it; that fact is the
// unbound host_boot_cutover_frontier, not a second false constant.

// §4b(1): the reported rung is the MINIMUM across in-scope paths. The planner-witness path has
// executed REDs. The host-boot jailer-exec path has not: host_image_placeability_standing is still
// HostShellAndBootImageAccessRefused (BMC answering is not tmpfs exec). Claiming
// MechanicallyPreventable for the class would be inflation. Cutover sequence:
// docs/plans/ci-per-job-microvm-migration.md — plan only, unbound host_boot_cutover_frontier.
data attempt_launch_planner_witness_rung: GuaranteeRung = MechanicallyPreventable

data attempt_launch_host_boot_exec_rung: GuaranteeRung = Mitigatable

fn reported_attempt_launch_rung() -> GuaranteeRung {
  if guarantee_rung_index(r: attempt_launch_host_boot_exec_rung)
    <= guarantee_rung_index(r: attempt_launch_planner_witness_rung) {
    attempt_launch_host_boot_exec_rung
  } else {
    attempt_launch_planner_witness_rung
  }
}

// THE JAILER FILESYSTEM CANNOT CARRY noexec OR nodev: the stock jailer copies the VMM into the
// chroot and mknods /dev/kvm there. Containment is chroot, namespaces, cgroup, and the uid drop.

data attempt_unprivileged_uid: Int = 1000

data attempt_unprivileged_gid: Int = 1000

data runner_attempt_vmm_deadline: Second = second(count: 540)

data runner_attempt_vmm_kill_grace: Second = second(count: 10)

data jit_config_byte_floor: ByteSize = byte_size(count: 512)

data jit_config_byte_ceiling: ByteSize = byte_size(count: 65536)

data jail_config_path: String = "/vm.json"

data jail_rootfs_path: FilePath = "/rootfs.squashfs"

data jail_kernel_path: FilePath = "/vmlinux"

data jail_jit_path: FilePath = "/jit.bin"

data jail_workspace_path: FilePath = "/work.img"

data host_busybox_bin: NonEmptyStr = "/bin/busybox"

// X's WORKGB=4 with `dd bs=1M count=0 seek=$((WORKGB*1024))`: four gibibytes as a Mebibyte seek.
data runner_attempt_workspace_size: Mebibyte = mebibyte(count: 4096)

type AttemptGround
  = GroundClear
  | GroundOccupied

// THE JIT CREDENTIAL IS ADMITTED FROM THE MINT'S OWN PERFORMANCE, NOT FROM A PRESENTED STANDING.
//
// This replaces X's EnvelopeStanding, which a CALLER assembled: a host fetched a blob, checked it,
// and told the planner "admitted, N bytes". The receipted fail-open was exactly that shape --
// jitconfig-bytes=0 and a launch anyway -- because the only thing between the fetch and the jailer
// was a value anyone could write. Here the planner takes gunbc.github_effect_perform's
// JitMintPerformance and admits a credential only from its delivered arm, bound to THIS attempt.
//
// "SIGNATURE-BOUND" is the App path, not a field. A JitMintReceived delivery is produced by
// perform_organization_jit_mint only after an RS256 App JWT signed with the host's key was accepted
// by GitHub for an installation token, and GitHub minted the blob against that token; the blob is
// opaque (gunbc.runner.runner_jit_admission) and there is no signature in it for a host to check.
// What is NOT structural, stated so it is not over-read: a caller can still construct a
// JitMintReceived beside the performer -- witnesses do -- so this is mitigatable on the planner
// path and its next rung is a sealed performance carrier. Host-envelope axes that had no subject
// once the fetch was gone (unit, boot, nonce, payload digest) dissolve into the attempt binding,
// as gunbc.runner.runner_jit_admission already rules for unit and boot.
type JitDeviceRefusal
  = JitMintNotReceived { performance: JitMintPerformance }
  | JitCredentialNotDelivered { delivery: JitCredentialDelivery }
  | JitCredentialBoundToDifferentAttempt { bound_to: MicroVmAttempt }
  | JitCredentialBelowFloor { bytes: ByteSize }
  | JitCredentialAboveCeiling { bytes: ByteSize }
  | JitMintAdmissionAxisNotRequired

// THE ONLY CARRIER A DEVICE CAN BE STAGED FROM, and admit_jit_credential is its only constructor.
// The registration id travels with the credential rather than beside it: it is GitHub's identity
// for the runner this blob registers, and it is recorded on the launch so every later event about
// this attempt can name the registration a leak or orphan would be reconciled against.
type AdmittedJitCredential sole_constructor {
  credential: EncodedJitConfig
  runner_name: JitRunnerName
  registration_id: Int
}

type JitCredentialAdmission
  = JitCredentialAdmitted { admitted: AdmittedJitCredential }
  | JitCredentialRefused { refusal: JitDeviceRefusal }

fn jit_credential_bytes(credential: EncodedJitConfig) -> ByteSize {
  byte_size(count: string_length(credential.encoded as String))
}

// THE ROSTER IS CONSUMED, NOT RESTATED. gunbc.runner.runner_jit_admission declares signature and
// expiry required with the HostMintAdmission checker, and admit_jit_credential IS that checker; so
// it refuses if the roster stops saying so, rather than enforcing a wall the roster no longer
// declares (or the roster declaring one nothing enforces).
fn host_mint_admission_is_required() -> Bool {
  match jit_admission_axis_standing(axis: SignatureAxis) {
    AxisRequired { checker: HostMintAdmission } =>
      match jit_admission_axis_standing(axis: ExpiryAxis) {
        AxisRequired { checker: HostMintAdmission } => true
        _ => false
      }
    _ => false
  }
}

fn admit_jit_credential(attempt: MicroVmAttempt, mint: JitMintPerformance) -> JitCredentialAdmission {
  match mint {
    JitMintReceived { delivery: delivery } =>
      match delivery {
        JitCredentialBoundToAttempt { attempt: bound, credential: c, runner_id: id } =>
          if !host_mint_admission_is_required() {
            JitCredentialRefused { refusal: JitMintAdmissionAxisNotRequired }
          } else if bound != attempt {
            JitCredentialRefused { refusal: JitCredentialBoundToDifferentAttempt { bound_to: bound } }
          } else if !measure_le(a: jit_config_byte_floor, b: jit_credential_bytes(credential: c)) {
            JitCredentialRefused { refusal: JitCredentialBelowFloor { bytes: jit_credential_bytes(credential: c) } }
          } else if !measure_le(a: jit_credential_bytes(credential: c), b: jit_config_byte_ceiling) {
            JitCredentialRefused { refusal: JitCredentialAboveCeiling { bytes: jit_credential_bytes(credential: c) } }
          } else {
            JitCredentialAdmitted {
              admitted: AdmittedJitCredential {
                credential: c,
                runner_name: jit_runner_name_for(attempt: attempt),
                registration_id: id,
              },
            }
          }
        other => JitCredentialRefused { refusal: JitCredentialNotDelivered { delivery: other } }
      }
    other => JitCredentialRefused { refusal: JitMintNotReceived { performance: other } }
  }
}

// THE DEVICE, AS TWO HOST STEPS WHOSE ORDER IS THE SECURITY PROPERTY. (1) install(1) creates an
// EMPTY file already owned by the attempt's unprivileged uid and mode 0400, inside the attempt's
// jail; (2) the drive bytes are written into it -- through the filesystem, never an argv.
//
// THE BYTES ARE THE GUEST'S CONTRACT, NOT A HOST CHOICE. What goes on the drive is exactly
// gunbc.runner_microvm jit_drive_content(credential): one ACTIONS_RUNNER_INPUT_JITCONFIG line,
// newline-padded to whole sectors, which is what the guest agent (gunbc.runner_guest_image) reads
// from the device jit_drive_guest_device names. A second host-side format (the recovered init's
// NUL padding, which this module used to write) would be a second authority for one fact, and the
// guest could not read it. The staged file's size is therefore the content's own size, and
// readback checks exactly that.
//
// The file is inside the chroot of exactly one attempt. The guest sees it as a read-only drive
// (gunbc.runner_microvm JitConfigOnReadOnlyDrive) and never sees the host path, the App key, the
// JWT or the installation token, none of which this carrier holds.
type JitDeviceStaging {
  host_path: String
  create: ArgvCommand
  content: String
}

// ONE ROW FOR THE DEVICE'S MODE, in the digits stat(1) %a prints. install(1) -m takes the same
// digits with a leading 0; both spellings derive from this row, so they cannot drift.
data jit_device_mode_digits: NonEmptyStr = "400"

fn jit_device_install_mode() -> NonEmptyStr {
  concat("0", jit_device_mode_digits as String) as NonEmptyStr
}

fn jit_device_staging(jail_root: String, admitted: AdmittedJitCredential) -> JitDeviceStaging {
  let host_path = join([jail_root, jail_jit_path as String], "")
  JitDeviceStaging {
    host_path: host_path,
    create: install_empty_file_command(
      path: host_path,
      octal_mode: jit_device_install_mode(),
      uid: attempt_unprivileged_uid,
      gid: attempt_unprivileged_gid,
    ),
    content: jit_drive_content(encoded_jit_config: admitted.credential.encoded),
  }
}

// PID1 refusals (no boot secret, stage2 missing files) have no constructor on AttemptLaunchPlan.
// That is the census: they are outside this per-attempt planner by construction, not by a Bool.
//
// THE LAW THIS SHAPE CARRIES: jit_device and jailer are fields of ONE arm, and that arm is
// reachable only through admit_jit_credential's admitted arm. So no admitted, non-empty,
// attempt-bound credential means no device AND no VMM process -- the two cannot come apart.

type AttemptLaunchPlan
  = LaunchRefusedUnauthorized { authorization: GrantAuthorization }
  | LaunchRefusedJitCredential { refusal: JitDeviceRefusal }
  | LaunchRefusedPriorResources
  | LaunchAuthorized {
      authorization: GrantAuthorization
      jit_runner_name: JitRunnerName
      jit_registration_id: Int
      jit_device: JitDeviceStaging
      tap_device: NonEmptyStr
      guest_ip_boot_arg: String
      nft_ruleset: String
      slice: SystemdRunProperty
      jail_root: String
      stage_jail_root: ArgvCommand
      stage_kernel: ArgvCommand
      stage_rootfs: ArgvCommand
      workspace_path: String
      workspace_create: ArgvCommand
      workspace_format: ArgvCommand
      kvm_device: FilePath
      vm_config: FirecrackerVmConfig
      jailer: ArgvCommand
    }

fn with_guest_ip_boot_arg(config: FirecrackerVmConfig, ip_arg: String) -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: FirecrackerBootSource {
      kernel_image_path: config.boot_source.kernel_image_path,
      boot_args: join([config.boot_source.boot_args as String, " ", ip_arg], "") as NonEmptyStr,
    },
    drives: config.drives,
    network_interfaces: config.network_interfaces,
    machine_config: config.machine_config,
  }
}

fn bounded_jailer_command(
  jailer_binary: String,
  jailer_id: String,
  exec_file: String,
  chroot_base_dir: String,
) -> ArgvCommand {
  timeout_command(
    duration: runner_attempt_vmm_deadline,
    kill_after: runner_attempt_vmm_kill_grace,
    command: firecracker_jailer_run_command(
      jailer_binary: jailer_binary,
      jailer_id: jailer_id,
      exec_file: exec_file,
      uid: attempt_unprivileged_uid,
      gid: attempt_unprivileged_gid,
      chroot_base_dir: chroot_base_dir,
      config_path_in_jail: jail_config_path,
    ),
  )
}

fn plan_attempt_launch(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  money_generation: Int,
  work: FabricIdentity<NonEmptyStr, WorkKey>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  offer: FabricIdentity<NonEmptyStr, OfferKey>,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  guest_size: RunnerMicroVmSize,
) -> AttemptLaunchPlan {
  let authorization = grant_authorizes_reservation(
    grant: grant,
    account: account,
    money_generation: money_generation,
    work: work,
    demand: demand,
    offer: offer,
  )
  match authorization {
    GrantAuthorizes => plan_after_authorization(
      authorization: authorization,
      attempt: attempt,
      mint: mint,
      ground: ground,
      jailer_binary: jailer_binary,
      firecracker_binary: firecracker_binary,
      kernel_source: kernel_source,
      rootfs_source: rootfs_source,
      guest_size: guest_size,
    )
    GrantFenceRefused => LaunchRefusedUnauthorized { authorization: authorization }
    GrantAuthorizesDifferentWork => LaunchRefusedUnauthorized { authorization: authorization }
    GrantAnswersDifferentDemand => LaunchRefusedUnauthorized { authorization: authorization }
    GrantIssuedAgainstDifferentOffer => LaunchRefusedUnauthorized { authorization: authorization }
  }
}

fn plan_after_authorization(
  authorization: GrantAuthorization,
  attempt: MicroVmAttempt,
  mint: JitMintPerformance,
  ground: AttemptGround,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  guest_size: RunnerMicroVmSize,
) -> AttemptLaunchPlan {
  match ground {
    GroundOccupied => LaunchRefusedPriorResources
    GroundClear =>
      match admit_jit_credential(attempt: attempt, mint: mint) {
        JitCredentialRefused { refusal: r } => LaunchRefusedJitCredential { refusal: r }
        JitCredentialAdmitted { admitted: admitted } => plan_authorized_steps(
          authorization: authorization,
          attempt: attempt,
          admitted: admitted,
          jailer_binary: jailer_binary,
          firecracker_binary: firecracker_binary,
          kernel_source: kernel_source,
          rootfs_source: rootfs_source,
          guest_size: guest_size,
        )
      }
  }
}

fn plan_authorized_steps(
  authorization: GrantAuthorization,
  attempt: MicroVmAttempt,
  admitted: AdmittedJitCredential,
  jailer_binary: String,
  firecracker_binary: String,
  kernel_source: String,
  rootfs_source: String,
  guest_size: RunnerMicroVmSize,
) -> AttemptLaunchPlan {
  let net = runner_slot_network(slot: attempt.slot)
  let jail_root = attempt_jail_chroot_root(attempt: attempt, firecracker_binary: firecracker_binary)
  let workspace_host = join([jail_root, jail_workspace_path as String], "")
  let cfg = runner_microvm_vm_config(
    rootfs_path: jail_rootfs_path,
    jit_config_path: jail_jit_path,
    kernel_path: jail_kernel_path,
    net: runner_slot_network_as_microvm_networking(net: net),
    size: guest_size,
    transport: gunbc_runner_jit_transport,
  )
  let jailed = with_guest_ip_boot_arg(
    config: attach_workspace_drive(config: cfg, path: jail_workspace_path),
    ip_arg: runner_slot_guest_ip_boot_arg(net: net),
  )
  LaunchAuthorized {
    authorization: authorization,
    jit_runner_name: admitted.runner_name,
    jit_registration_id: admitted.registration_id,
    jit_device: jit_device_staging(jail_root: jail_root, admitted: admitted),
    tap_device: net.tap_device,
    guest_ip_boot_arg: runner_slot_guest_ip_boot_arg(net: net),
    nft_ruleset: runner_microvm_nft_ruleset_text(),
    slice: runner_microvm_attempt_slice_property(attempt: attempt),
    jail_root: jail_root,
    stage_jail_root: mkdir_parents_command(path: jail_root),
    stage_kernel: cp_command(
      source: kernel_source,
      destination: join([jail_root, jail_kernel_path as String], ""),
    ),
    stage_rootfs: cp_command(
      source: rootfs_source,
      destination: join([jail_root, jail_rootfs_path as String], ""),
    ),
    workspace_path: workspace_host,
    workspace_create: busybox_dd_sparse_image_command(
      busybox_bin: host_busybox_bin,
      image_path: workspace_host,
      size: runner_attempt_workspace_size,
    ),
    workspace_format: mke2fs_format_command(
      fs: Ext2,
      image_path: workspace_host,
    ),
    kvm_device: firecracker_requires_kvm_device,
    vm_config: jailed,
    jailer: bounded_jailer_command(
      jailer_binary: jailer_binary,
      jailer_id: attempt.attempt_id.value as String,
      exec_file: firecracker_binary,
      chroot_base_dir: runner_microvm_attempt_jail_base(attempt: attempt),
    ),
  }
}

fn attempt_jail_chroot_root(attempt: MicroVmAttempt, firecracker_binary: String) -> String {
  firecracker_jailer_chroot_root(
    chroot_base_dir: runner_microvm_attempt_jail_base(attempt: attempt),
    exec_file: firecracker_binary,
    jailer_id: attempt.attempt_id.value as String,
  )
}

fn workspace_drive_path_on_host(config: FirecrackerVmConfig) -> String {
  fold(config.drives, init: "", f: (acc, d) =>
    if (d.drive_id as String) == (runner_microvm_workspace_drive_id as String) {
      d.path_on_host as String
    } else {
      acc
    }
  )
}

fn planned_jailer_launches(plan: AttemptLaunchPlan) -> Int {
  match plan {
    LaunchAuthorized {
      authorization: _,
      jit_runner_name: _,
      jit_registration_id: _,
      jit_device: _,
      tap_device: _,
      guest_ip_boot_arg: _,
      nft_ruleset: _,
      slice: _,
      jail_root: _,
      stage_jail_root: _,
      stage_kernel: _,
      stage_rootfs: _,
      workspace_path: _,
      workspace_create: _,
      workspace_format: _,
      kvm_device: _,
      vm_config: _,
      jailer: _,
    } => 1
    LaunchRefusedUnauthorized { authorization: _ } => 0
    LaunchRefusedJitCredential { refusal: _ } => 0
    LaunchRefusedPriorResources => 0
  }
}

// STAGING, PERFORMED -- and READ BACK FROM THE HOST rather than believed from the steps' exits.
// Each step's refusal is its own arm naming the step, so a failed install is not reported as a
// failed write. The readback checks the three facts the device's safety rests on: owned by the
// attempt's uid (the jailer drops to it, so root-owned would be unreadable and anything looser would
// be readable by others), mode 0400, and size exactly the drive content's size (so the guest reads
// whole sectors of the contract it expects). A stat that itself failed is its own refusal carrying
// its stderr -- not a mismatch of an empty reading (review 68502). A device that fails readback is
// a refusal: the caller must not launch over it.
type JitDeviceStagingStep
  = JitDeviceCreateStep
  | JitDeviceWriteStep
  | JitDeviceReadbackStep

type JitDeviceStagingOutcome
  = JitDeviceStaged { host_path: String }
  | JitDeviceStagingRefused { step: JitDeviceStagingStep, detail: String }

type JitDeviceStatReading
  = StatRead { value: String }
  | StatUnread { detail: String }

fn jit_device_stat_reading(outcome: ProcessOutcome) -> JitDeviceStatReading {
  match outcome {
    ProcessOutputPresent { text: t } => StatRead { value: trim(s: t) }
    ProcessOutputAbsent => StatUnread { detail: "stat printed nothing" }
    ProcessRefused { exit_code: code, stderr: e } =>
      StatUnread { detail: join(["stat exit ", to_string(code), ": ", trim(s: e)], "") }
  }
}

fn jit_device_fact(name: String, reading: JitDeviceStatReading, expected: String) -> JitDeviceStagingOutcome? {
  match reading {
    StatUnread { detail: d } =>
      Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: join([name, " unread: ", d], "") } }
    StatRead { value: v } =>
      if v == expected {
        none
      } else {
        Present { value: JitDeviceStagingRefused { step: JitDeviceReadbackStep, detail: join([name, " is ", v, ", expected ", expected], "") } }
      }
  }
}

fn jit_device_readback(
  uid: JitDeviceStatReading,
  mode: JitDeviceStatReading,
  size: JitDeviceStatReading,
  content: String,
) -> JitDeviceStagingOutcome? {
  match jit_device_fact(name: "owner uid", reading: uid, expected: to_string(attempt_unprivileged_uid)) {
    Present { value: r } => Present { value: r }
    Absent =>
      match jit_device_fact(name: "mode", reading: mode, expected: jit_device_mode_digits as String) {
        Present { value: r } => Present { value: r }
        Absent =>
          jit_device_fact(
            name: "size",
            reading: size,
            expected: to_string(byte_size_count(b: jit_drive_utf8_size(text: content))),
          )
      }
  }
}

fn stage_jit_device(device: JitDeviceStaging) -> JitDeviceStagingOutcome
  uses net: Network, fs: Filesystem
{
  match run_shell_command_capture(command: device.create, transport: LocalExec) {
    ProcessRefused { exit_code: _, stderr: e } =>
      JitDeviceStagingRefused { step: JitDeviceCreateStep, detail: trim(s: e) }
    _ => {
      let wrote = Filesystem.Write(path: device.host_path, content: device.content)
      if wrote.success == false {
        JitDeviceStagingRefused { step: JitDeviceWriteStep, detail: device.host_path }
      } else {
        match jit_device_readback(
          uid: jit_device_stat_reading(outcome: run_shell_command_capture(command: stat_owner_uid_command(path: device.host_path), transport: LocalExec)),
          mode: jit_device_stat_reading(outcome: run_shell_command_capture(command: stat_mode_command(path: device.host_path), transport: LocalExec)),
          size: jit_device_stat_reading(outcome: run_shell_command_capture(command: stat_size_bytes_command(path: device.host_path), transport: LocalExec)),
          content: device.content,
        ) {
          Present { value: refused } => refused
          Absent => JitDeviceStaged { host_path: device.host_path }
        }
      }
    }
  }
}

type WorkNotEstablished {
  vmm_exit: Int
}

fn work_standing_from_vmm_exit(exit_code: Int) -> WorkNotEstablished {
  WorkNotEstablished { vmm_exit: exit_code }
}
