module gunbc.runner.runner_teardown_receipt

import std.optional { Optional, Present, Absent }
import std.types { Bool, List, NonEmptyStr, String }
import std.measure { ObservationInstant }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import gunbc.build_cache.build_cache_instance { ProcessIdentity, process_identity_eq }
import gunbc.runner.runner_job_initiator { RunnerEvidenceSource }
import gunbc.runner.runner_usage_receipt {
  RunnerAttemptSubject, runner_attempt_subject_eq, RunnerInstantPair, RunnerInstantOrderRefusal, runner_instant_order_refusal,
}

// Expected resources come from the launch allocation, not the observer's discovered population.
// The microVM product requires all eight declared inventory fields at construction. Coverage of the
// teardown fold is checked separately by the independent resource fixtures; adding a resource
// class requires extending both the inventory/readback and that coverage contract. The VMM
// identity includes boot and start time; names and exit status cannot prove its absence.
// The cgroup covers its descendants.
type MicroVmEnvironmentInventory {
  vmm: ProcessIdentity
  cgroup: NonEmptyStr
  jail: NonEmptyStr
  jail_mount: NonEmptyStr
  jit_drive: NonEmptyStr
  workspace: NonEmptyStr
  tap: NonEmptyStr
  firewall_table: NonEmptyStr
}

// A SLOT IS REALIZED AS A microVM ATTEMPT OR AS A TRANSIENT systemd UNIT ON A MANAGED HOST
// (gunbc.runner.jit_registration_subject producers), and the teardown is one fold over both. The host-unit arm owns
// no jail, jail mount, JIT drive, tap or firewall table -- the unit is the host's own process tree
// in its own cgroup -- so its inventory names only what its launch allocates, rather than filling
// five fields with paths that never existed. Which classes a teardown positive-controls is derived
// from the inventory's arm (runner_resource_classes_for), so a host-unit teardown is not refused
// for a jail it never had, and a microVM teardown still requires all eight.
type HostUnitEnvironmentInventory {
  unit_process: ProcessIdentity
  unit: NonEmptyStr
  cgroup: NonEmptyStr
  workspace: NonEmptyStr
}

// A WHOLE BOOT AS THE ENVIRONMENT (gunbc.plans.mtcollins1_ci_service_legs S7, merry-fox-82's BMC-observer decision of
// 2026-10-30). On a boot that holds nothing persistent the boot IS the attempt's environment, as the VMM is a
// microVM's: every unit, cgroup and tmpfs the attempt made lives in its RAM, so the boot ending is the teardown and
// no per-resource read is owed. That premise is not assumed of a host: the record is minted only from a reading of
// the boot's own mount table that admits it RAM-only (gunbc.runner.runner_machine_boot_teardown
// admit_machine_boot_inventory), so a boot with a writable disk cannot be torn down by powering it off.
type MachineBootEnvironmentInventory sole_constructor {
  host: NonEmptyStr
  boot_id: NonEmptyStr
}

fn mint_machine_boot_inventory(host: NonEmptyStr, boot_id: NonEmptyStr) -> MachineBootEnvironmentInventory admit_callers: [
  decl_ref(module_path: "gunbc.runner.runner_machine_boot_teardown", decl_name: "admit_machine_boot_inventory"),
  decl_ref(module_path: "test.claim.runner.runner_machine_boot_teardown_witness", decl_name: "fixture_machine_boot"),
] {
  MachineBootEnvironmentInventory { host: host, boot_id: boot_id }
}

type RunnerEnvironmentInventory
  = MicroVmInventory { inventory: MicroVmEnvironmentInventory }
  | HostUnitInventory { inventory: HostUnitEnvironmentInventory }
  | MachineBootInventory { inventory: MachineBootEnvironmentInventory }

// THE BOOT THE ENVIRONMENT LIVES ON: the VMM's for a microVM, the unit's main process's for a host unit, and
// the boot itself for a machine boot.
fn runner_environment_boot_id(inventory: RunnerEnvironmentInventory) -> String {
  match inventory {
    MicroVmInventory { inventory: m } => m.vmm.boot_id as String
    HostUnitInventory { inventory: h } => h.unit_process.boot_id as String
    MachineBootInventory { inventory: b } => b.boot_id as String
  }
}

// AN OBSERVER INSIDE THE ENVIRONMENT CANNOT REPORT IT GONE. For a microVM or a host unit that is the one process
// whose absence proves the environment gone (the VMM, the unit's main process; both carry boot and start time, so a
// reused pid cannot stand in). For a machine boot it is ANY process on that boot, because the whole boot is what
// ends: the observer must be off the machine, which is what makes the BMC the observer.
fn runner_observer_inside_environment(inventory: RunnerEnvironmentInventory, observer: ProcessIdentity) -> Bool {
  match inventory {
    MicroVmInventory { inventory: m } => process_identity_eq(a: m.vmm, b: observer)
    HostUnitInventory { inventory: h } => process_identity_eq(a: h.unit_process, b: observer)
    MachineBootInventory { inventory: b } => (observer.boot_id as String) == (b.boot_id as String)
  }
}

// WHERE THE OBSERVER MUST STAND. A microVM's and a host unit's resources are read by a process on the subject boot
// (the host that runs them). A machine boot's cannot be: the observer reads the boot from outside it, so this arm
// requires only what runner_observer_inside_environment already refused, and the boot equality is the
// environment's and the destroyer's.
fn runner_observer_boot_admitted(inventory: RunnerEnvironmentInventory, observer: ProcessIdentity, subject_boot: String) -> Bool {
  match inventory {
    MicroVmInventory { inventory: _ } => (observer.boot_id as String) == subject_boot
    HostUnitInventory { inventory: _ } => (observer.boot_id as String) == subject_boot
    MachineBootInventory { inventory: _ } => true
  }
}

// THE ONE INSTRUMENT A MACHINE BOOT'S READING MAY COME FROM. The premise that power-off ends the boot is physics only
// for a reading of the chassis power line beside the boot's own id (gunbc.runner.runner_machine_boot_teardown
// machine_boot_reading): an Absent written by any other producer -- a failed SSH read, a fixture -- would carry the
// physics' conclusion without its evidence. The other arms keep the existing rule (one instrument, unchanged).
data machine_boot_observation_producer: DeclarationRef = decl_ref(module_path: "gunbc.runner.runner_machine_boot_teardown", decl_name: "machine_boot_reading")

fn runner_instrument_admitted(inventory: RunnerEnvironmentInventory, producer: DeclarationRef) -> Bool {
  match inventory {
    MicroVmInventory { inventory: _ } => true
    HostUnitInventory { inventory: _ } => true
    MachineBootInventory { inventory: _ } => declaration_ref_eq(a: producer, b: machine_boot_observation_producer)
  }
}

type RunnerResourceClass
  = RunnerVmm
  | RunnerTransientUnit
  | RunnerCgroup
  | RunnerJail
  | RunnerJailMount
  | RunnerJitDrive
  | RunnerWorkspace
  | RunnerTap
  | RunnerFirewallTable
  | RunnerMachineBoot

// Parallel representation of RunnerResourceClass, not compiler-enforced enumeration.
// Adding a variant and a readback_reading arm while omitting this roster can compile and
// skip the new resource during teardown. The independent eight-class residue/unreadable
// witness catches omission of a CURRENT class; it does not automatically cover future variants.
// As in gunbc.systemd_property_directive_overlap.systemd_unit_property_members, a .dag source
// module has no declared-coproduct variant-enumeration surface. Coverage is mitigated by the
// independent fixtures, not mechanically prevented by the record or the exhaustive match.
// NEXT-RUNG TRIGGER: a variant-enumeration surface over a declared coproduct, consumed here
// to derive RunnerResourceClass coverage and delete this hand-authored roster. Preserve the
// independent residue/unreadable witnesses after that migration; they establish refusal behavior.
data runner_resource_classes: List<RunnerResourceClass> = [
  RunnerVmm, RunnerCgroup, RunnerJail, RunnerJailMount, RunnerJitDrive, RunnerWorkspace, RunnerTap, RunnerFirewallTable,
]

data host_unit_resource_classes: List<RunnerResourceClass> = [RunnerTransientUnit, RunnerCgroup, RunnerWorkspace]

data machine_boot_resource_classes: List<RunnerResourceClass> = [RunnerMachineBoot]

fn runner_resource_classes_for(inventory: RunnerEnvironmentInventory) -> List<RunnerResourceClass> {
  match inventory {
    MicroVmInventory { inventory: _ } => runner_resource_classes
    HostUnitInventory { inventory: _ } => host_unit_resource_classes
    MachineBootInventory { inventory: _ } => machine_boot_resource_classes
  }
}

type RunnerResourceReading
  = RunnerResourcePresent
  | RunnerResourceAbsent
  | RunnerResourceUnreadable { cause: NonEmptyStr }

type RunnerEnvironmentReadback {
  vmm: RunnerResourceReading
  unit: RunnerResourceReading
  cgroup: RunnerResourceReading
  jail: RunnerResourceReading
  jail_mount: RunnerResourceReading
  jit_drive: RunnerResourceReading
  workspace: RunnerResourceReading
  tap: RunnerResourceReading
  firewall_table: RunnerResourceReading
  machine_boot: RunnerResourceReading
}

// A MACHINE BOOT'S READBACK READS ONE CLASS. The others are not resources of that environment, so they carry an
// unreadable cause rather than an Absent nobody read: a fold that ever consulted one would refuse, not pass.
fn machine_boot_readback(reading: RunnerResourceReading) -> RunnerEnvironmentReadback {
  let unread = RunnerResourceUnreadable { cause: "not a resource of a machine-boot environment; only the boot is read" as NonEmptyStr }
  RunnerEnvironmentReadback {
    vmm: unread, unit: unread, cgroup: unread, jail: unread, jail_mount: unread,
    jit_drive: unread, workspace: unread, tap: unread, firewall_table: unread, machine_boot: reading,
  }
}

type RunnerEnvironmentObservation<P> {
  subject: RunnerAttemptSubject<P>
  inventory: RunnerEnvironmentInventory
  observer: ProcessIdentity
  at: ObservationInstant
  readback: RunnerEnvironmentReadback
  evidence: RunnerEvidenceSource
}

type RunnerEnvironmentReading<P>
  = RunnerEnvironmentObserved { observation: RunnerEnvironmentObservation<P> }
  | RunnerEnvironmentUnobserved { cause: NonEmptyStr }

type RunnerTeardownRequest<P> {
  subject: RunnerAttemptSubject<P>
  inventory: RunnerEnvironmentInventory
  destroyer: ProcessIdentity
  issued_at: ObservationInstant
}

type RunnerTeardownRefusal
  = TeardownObservationMissing { cause: NonEmptyStr }
  | TeardownSubjectMismatch
  | TeardownInventoryMismatch
  | TeardownSelfObservation
  | TeardownObserverInsideEnvironment
  | TeardownObserverChanged
  | TeardownInstrumentChanged
  | TeardownInstrumentNotAdmitted
  | TeardownBootMismatch
  | TeardownObservationOrderRefused { diagnostic: RunnerInstantOrderRefusal }
  | TeardownPositiveControlMissing { resource: RunnerResourceClass }
  | TeardownResourceSurvived { resource: RunnerResourceClass }
  | TeardownResourceUnreadable { resource: RunnerResourceClass, cause: NonEmptyStr }

// This is observation of the named inventory, not a containment assertion about the entire host.
// The observer transport must be independent of the destroyer and preserve its own capture. Merely
// choosing different pid literals in a fixture does not establish that external independence.
type RunnerTeardownReceipt<P> sole_constructor {
  request: RunnerTeardownRequest<P>
  before: RunnerEnvironmentObservation<P>
  after: RunnerEnvironmentObservation<P>
}

type RunnerTeardownResult<P>
  = RunnerTeardownProduced { receipt: RunnerTeardownReceipt<P> }
  | RunnerTeardownRefused { cause: RunnerTeardownRefusal }

fn runner_environment_inventory_eq(a: RunnerEnvironmentInventory, b: RunnerEnvironmentInventory) -> Bool {
  match a {
    MicroVmInventory { inventory: x } =>
      match b {
        MicroVmInventory { inventory: y } => micro_vm_environment_inventory_eq(a: x, b: y)
        HostUnitInventory { inventory: _ } => false
        MachineBootInventory { inventory: _ } => false
      }
    HostUnitInventory { inventory: x } =>
      match b {
        HostUnitInventory { inventory: y } =>
          process_identity_eq(a: x.unit_process, b: y.unit_process) &&
          (x.unit as String) == (y.unit as String) && (x.cgroup as String) == (y.cgroup as String) &&
          (x.workspace as String) == (y.workspace as String)
        MicroVmInventory { inventory: _ } => false
        MachineBootInventory { inventory: _ } => false
      }
    MachineBootInventory { inventory: x } =>
      match b {
        MachineBootInventory { inventory: y } =>
          (x.host as String) == (y.host as String) && (x.boot_id as String) == (y.boot_id as String)
        MicroVmInventory { inventory: _ } => false
        HostUnitInventory { inventory: _ } => false
      }
  }
}

fn micro_vm_environment_inventory_eq(a: MicroVmEnvironmentInventory, b: MicroVmEnvironmentInventory) -> Bool {
  process_identity_eq(a: a.vmm, b: b.vmm) &&
  (a.cgroup as String) == (b.cgroup as String) && (a.jail as String) == (b.jail as String) &&
  (a.jail_mount as String) == (b.jail_mount as String) &&
  (a.jit_drive as String) == (b.jit_drive as String) &&
  (a.workspace as String) == (b.workspace as String) &&
  (a.tap as String) == (b.tap as String) &&
  (a.firewall_table as String) == (b.firewall_table as String)
}

type RunnerResourceTransition {
  resource: RunnerResourceClass
  before: RunnerResourceReading
  after: RunnerResourceReading
}

fn readback_reading(class: RunnerResourceClass, readback: RunnerEnvironmentReadback) -> RunnerResourceReading {
  match class {
    RunnerVmm => readback.vmm
    RunnerTransientUnit => readback.unit
    RunnerCgroup => readback.cgroup
    RunnerJail => readback.jail
    RunnerJailMount => readback.jail_mount
    RunnerJitDrive => readback.jit_drive
    RunnerWorkspace => readback.workspace
    RunnerTap => readback.tap
    RunnerFirewallTable => readback.firewall_table
    RunnerMachineBoot => readback.machine_boot
  }
}

fn runner_resource_transitions(
  classes: List<RunnerResourceClass>,
  before: RunnerEnvironmentReadback,
  after: RunnerEnvironmentReadback,
) -> List<RunnerResourceTransition> {
  classes |> map(class => RunnerResourceTransition {
    resource: class,
    before: readback_reading(class: class, readback: before),
    after: readback_reading(class: class, readback: after),
  })
}

fn runner_resource_transition_refusal(row: RunnerResourceTransition) -> Optional<RunnerTeardownRefusal> {
  match row.before {
    RunnerResourceUnreadable { cause: c } =>
      Present { value: TeardownResourceUnreadable { resource: row.resource, cause: c } }
    RunnerResourceAbsent => Present { value: TeardownPositiveControlMissing { resource: row.resource } }
    RunnerResourcePresent => match row.after {
      RunnerResourcePresent => Present { value: TeardownResourceSurvived { resource: row.resource } }
      RunnerResourceUnreadable { cause: c } =>
        Present { value: TeardownResourceUnreadable { resource: row.resource, cause: c } }
      RunnerResourceAbsent => Absent
    }
  }
}

fn runner_teardown_from_observations<P>(
  request: RunnerTeardownRequest<P>,
  before: RunnerEnvironmentObservation<P>,
  after: RunnerEnvironmentObservation<P>,
) -> RunnerTeardownResult<P> {
  if !runner_attempt_subject_eq(a: request.subject, b: before.subject) ||
     !runner_attempt_subject_eq(a: request.subject, b: after.subject) {
    RunnerTeardownRefused { cause: TeardownSubjectMismatch }
  } else if !runner_environment_inventory_eq(a: request.inventory, b: before.inventory) ||
            !runner_environment_inventory_eq(a: request.inventory, b: after.inventory) {
    RunnerTeardownRefused { cause: TeardownInventoryMismatch }
  } else if process_identity_eq(a: request.destroyer, b: before.observer) ||
            process_identity_eq(a: request.destroyer, b: after.observer) {
    RunnerTeardownRefused { cause: TeardownSelfObservation }
  } else if runner_observer_inside_environment(inventory: request.inventory, observer: before.observer) ||
            runner_observer_inside_environment(inventory: request.inventory, observer: after.observer) {
    RunnerTeardownRefused { cause: TeardownObserverInsideEnvironment }
  } else if !declaration_ref_eq(a: before.evidence.producer, b: after.evidence.producer) {
    RunnerTeardownRefused { cause: TeardownInstrumentChanged }
  } else if !runner_instrument_admitted(inventory: request.inventory, producer: before.evidence.producer) {
    RunnerTeardownRefused { cause: TeardownInstrumentNotAdmitted }
  } else if !process_identity_eq(a: before.observer, b: after.observer) {
    RunnerTeardownRefused { cause: TeardownObserverChanged }
  } else if runner_environment_boot_id(inventory: request.inventory) != (request.subject.boot_id as String) ||
            (request.destroyer.boot_id as String) != (request.subject.boot_id as String) ||
            !runner_observer_boot_admitted(inventory: request.inventory, observer: after.observer, subject_boot: request.subject.boot_id as String) {
    RunnerTeardownRefused { cause: TeardownBootMismatch }
  } else {
    match runner_instant_order_refusal(pairs: [
      RunnerInstantPair { location: "before/issued_at", earlier: before.at, later: request.issued_at },
      RunnerInstantPair { location: "issued_at/after", earlier: request.issued_at, later: after.at },
    ]) {
      Present { value: d } => RunnerTeardownRefused { cause: TeardownObservationOrderRefused { diagnostic: d } }
      Absent => {
        let refusal = runner_resource_transitions(classes: runner_resource_classes_for(inventory: request.inventory), before: before.readback, after: after.readback)
          |> fold(init: Absent, f: fn(found, row) {
            match found {
              Present { value: _ } => found
              Absent => runner_resource_transition_refusal(row: row)
            }
          })
        match refusal {
          Present { value: c } => RunnerTeardownRefused { cause: c }
          Absent => RunnerTeardownProduced { receipt: RunnerTeardownReceipt {
            request: request, before: before, after: after,
          } }
        }
      }
    }
  }
}

fn produce_runner_teardown_receipt<P>(
  request: RunnerTeardownRequest<P>,
  before: RunnerEnvironmentReading<P>,
  after: RunnerEnvironmentReading<P>,
) -> RunnerTeardownResult<P> {
  match before {
    RunnerEnvironmentUnobserved { cause: c } =>
      RunnerTeardownRefused { cause: TeardownObservationMissing { cause: c } }
    RunnerEnvironmentObserved { observation: b } => match after {
      RunnerEnvironmentUnobserved { cause: c } =>
        RunnerTeardownRefused { cause: TeardownObservationMissing { cause: c } }
      RunnerEnvironmentObserved { observation: a } =>
        runner_teardown_from_observations(request: request, before: b, after: a)
    }
  }
}
