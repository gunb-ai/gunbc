module gunbc.runner_microvm_footprint_probe

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.nat { Nat }
import std.disposition { Disposition, SingleAuthority }
import std.measure { ByteSize, byte_size, byte_size_count, Second, second, mebibyte, mebibyte_to_byte_size, kibibyte, kibibyte_to_byte_size }

// DECLARED FRONTIER, STATED RATHER THAN LEFT IMPLICIT (DESIGN 3c). NOTHING EXECUTES THIS PROBE
// TODAY: no caller runs a VMM under GNU time, and `extdeps.tools.gnu_time.gnu_time_max_rss_command`
// has no call site outside the `admit_callers` roster row that permits it. Only this module's own
// witness exercises the types, the renderer and the completeness fold.
//
// THAT IS THE HONEST STATE AND IT IS NAMED HERE RATHER THAN ARGUED IN A PR BODY. The named consumer
// is a wet footprint run on a host that carries an instrument; the trigger is that run producing a
// receipt. It is not held for a specific host -- any host carrying the instrument discharges it --
// because waiting on one machine nobody has is the untracked stall 4b(2) forbids.
//
// WHAT SEPARATES THIS FROM DANGLING MODELING: the sibling half of this change, the instrument
// standing in gunbc.runner_microvm_host_ready, DOES execute today and reports whether a host can
// measure at all. This module is the shape the measurement takes once one can; it is not a second
// answer to a question something else already answers.

data runner_microvm_footprint_probe_disposition: Disposition = SingleAuthority

// WHAT THIS MEASURES, AND THE ONE THING IT DOES NOT ESTABLISH.
//
// gunbc.runner_microvm refuses every launch because its realization reserve is ReserveUnmodeled: no
// VMM resident footprint is a cited quantity, and inventing one would be a fabricated plausible
// output. This probe produces the observation that could retire that refusal -- and it produces a
// RELATIONSHIP OVER SIZES rather than a constant, because the model's own reasoning is that the
// overhead is not constant: it scales with guest size, device model and host page size, so upstream
// documents a measured overhead for one configuration rather than a property of the realization.
//
// THE GUEST'S RAM IS LAZILY FAULTED, AND THAT IS WHY ONE SAMPLE WOULD MISLEAD. Firecracker maps the
// guest's memory, and a page enters the VMM's resident set only when the guest TOUCHES it. A guest
// that boots, prints and powers off touches a small and roughly size-independent amount, so a single
// peak read at one declared size is dominated by that workload rather than by the declared size.
// Sampling several declared sizes under one workload is what separates the two: a peak that stays
// flat as the declared size rises says the declared size is not committed, and a peak that tracks it
// says it is. Those are different worlds for an admission rule, and one sample cannot tell them apart.
//
// SO THIS PROBE DOES NOT ESTABLISH A WORST CASE, and no reader may treat its output as one. A
// worst-case reserve is what a guest costs when it USES its declared memory, which needs a guest
// workload that touches all of it -- a different probe with a different guest. Reporting these
// numbers as if they bounded that case would be the fabricated plausible output this whole refusal
// exists to prevent, arriving by way of a measurement instead of a guess.

// THE INSTRUMENT SET IS ENUMERATED ONCE, HERE, AND OBSERVED ELSEWHERE. An earlier revision carried
// this enumeration twice -- these variants, and a parallel record of one Bool per instrument in
// gunbc.runner_microvm_host_ready -- which is the meaning fork DESIGN 3 forbids: two independently
// editable lists of one set, and they had already drifted (cgroup memory.peak had a boolean and no
// variant, and systemd carried a raw String that a renderer re-interpreted by trimming). Adding an
// instrument now edits one place, and a standing that does not cover a variant cannot be built.
type FootprintInstrument
  = GnuTimeMaxRss
  | SystemdMemoryPeak
  | CgroupMemoryPeak

fn footprint_instrument_name(i: FootprintInstrument) -> String {
  match i {
    GnuTimeMaxRss => "gnu-time-max-rss"
    SystemdMemoryPeak => "systemd-memory-peak"
    CgroupMemoryPeak => "cgroup-memory-peak"
  }
}

// WHETHER AN INSTRUMENT IS THERE IS THREE-VALUED, NOT A BOOLEAN. "The host does not carry it" and
// "we could not read whether it carries it" are different facts, and only one of them says the host
// cannot measure. Collapsing the second into `absent` is the absorbing arm DESIGN 5 names.
type InstrumentObservation
  = InstrumentPresent
  | InstrumentAbsent
  | InstrumentUnreadable { cause: String }

type InstrumentStanding {
  instrument: FootprintInstrument
  observation: InstrumentObservation
}

fn instrument_observation_text(o: InstrumentObservation) -> String {
  match o {
    InstrumentPresent => "present"
    InstrumentAbsent => "absent"
    InstrumentUnreadable { cause: c } => join(["unreadable(", c, ")"], "")
  }
}

fn instrument_standing_text(s: InstrumentStanding) -> String {
  join([footprint_instrument_name(i: s.instrument), "=", instrument_observation_text(o: s.observation)], "")
}

type VmmFootprintSample {
  guest_memory: ByteSize
  instrument: FootprintInstrument
  vmm_peak: ByteSize
}

// EVERY FAILING ARM CARRIES THE SIZE IT WAS MEASURING, because a receipt listing four sizes and
// three outcomes is unreadable without it, and the missing row is exactly the one a reader needs.
type FootprintSampleOutcome
  = FootprintSampled { sample: VmmFootprintSample }
  | FootprintBootRefused { guest_memory: ByteSize, detail: String }
  | FootprintMeasurementUnreadable { guest_memory: ByteSize, instrument: FootprintInstrument, cause: String }

// THE SIZES ARE DECLARED HERE AND SPAN AN OCTAVE-AND-A-HALF ON PURPOSE. Two adjacent sizes cannot
// distinguish a flat relationship from a rising one within measurement noise; a 512 MiB to 4096 MiB
// spread makes the two hypotheses produce visibly different receipts.
data runner_microvm_footprint_sample_sizes: List<ByteSize> = [
  mebibyte_to_byte_size(m: mebibyte(count: 512)),
  mebibyte_to_byte_size(m: mebibyte(count: 1024)),
  mebibyte_to_byte_size(m: mebibyte(count: 2048)),
  mebibyte_to_byte_size(m: mebibyte(count: 4096)),
]

// GNU time's %M IS KIBIBYTES, and this is the one place that fact is APPLIED -- but not the place
// the conversion is DEFINED. extdeps.tools.gnu_time deliberately does not convert (it reports what
// upstream documents), so the consumer that knows what it measured owns the CHOICE of unit; std.measure
// owns the arithmetic. Re-minting a 1024 here would be a second unit system beside the one that
// already carries Kibibyte and its IEC 80000-13 factor.
fn gnu_time_max_rss_bytes(kibibytes: Nat) -> ByteSize {
  kibibyte_to_byte_size(k: kibibyte(count: kibibytes))
}

fn footprint_sample_text(o: FootprintSampleOutcome) -> String {
  match o {
    FootprintSampled { sample: s } =>
      join([
        "sample guest_bytes=", to_string(byte_size_count(b: s.guest_memory)),
        " instrument=", footprint_instrument_name(i: s.instrument),
        " vmm_peak_bytes=", to_string(byte_size_count(b: s.vmm_peak)),
      ], "")
    FootprintBootRefused { guest_memory: g, detail: d } =>
      join(["sample guest_bytes=", to_string(byte_size_count(b: g)), " REFUSED boot: ", d], "")
    FootprintMeasurementUnreadable { guest_memory: g, instrument: i, cause: c } =>
      join([
        "sample guest_bytes=", to_string(byte_size_count(b: g)),
        " instrument=", footprint_instrument_name(i: i),
        " UNREADABLE: ", c,
      ], "")
  }
}

// A RECEIPT THAT LOST A SAMPLE MUST NOT READ AS A COMPLETE ONE. The reserve decision reads the
// relationship across sizes, so a run that measured three of four sizes has not measured the
// relationship -- it has measured three points and left the reader to assume the fourth. This says
// so in the receipt rather than printing the rows that happened to work.
fn footprint_receipt_is_complete(outcomes: List<FootprintSampleOutcome>) -> Bool {
  count(outcomes) == count(runner_microvm_footprint_sample_sizes)
    && fold(outcomes, init: true, f: (ok, o) => ok && match o {
         FootprintSampled { sample: _ } => true
         _ => false
       })
}
