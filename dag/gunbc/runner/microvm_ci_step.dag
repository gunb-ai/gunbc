fn gunbc_ci_runner_microvm_boot_probe_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_runner_microvm_boot_probe_target,
    claim_run: false,
    receipt_rel: "target/runner-microvm-boot-probe.txt"
  )
}
fn gunbc_ci_microvm_slot_reserve_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_microvm_slot_reserve_target,
    claim_run: false,
    receipt_rel: microvm_slot_reserve_receipt_path
  )
}
fn gunbc_ci_microvm_slot_start_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_microvm_slot_start_target,
    claim_run: false,
