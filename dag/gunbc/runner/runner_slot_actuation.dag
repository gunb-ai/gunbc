// THE TWO SLOT LIFECYCLE EFFECTS, AS ONE AUTHORITY FOR EVERY CALLER. ActivateRunnerSlot brings a slot
// the model desires into service; DrainAndMaskRunnerSlot takes a slot out of service without ever
// killing a running job. gunbc.runner.runner_lifecycle_realize realizes the two HostEffect arms through
// these functions, and gunbc.runner.runner_host_file_converge sequences them for a whole host; both
// run over the same administrator-over-fleet-SSH edge, so there is one transport and one meaning.
//
// EACH EFFECT IS READ, DECIDE, ACT, READ BACK. The decision is a pure function of the reading, so an
// already-converged slot issues no leg at all (idempotence is structural, not a flag), and the result
// is settled only when an independent re-read shows the target state. Every failure is a typed
// refusal naming its step; nothing widens.

data slot_actuation_show_properties: List<SystemdUnitProperty> = [IdProperty, LoadState, UnitFileState, ActiveState]

// The GitHub Actions runner's job process. The listener (Runner.Listener) waits for work; a job runs
// in Runner.Worker, so a unit owning a Runner.Worker is executing a job and must not be stopped.
data runner_job_process_comm: String = "Runner.Worker"

// THE READING IS TYPED AT THE BOUNDARY (review 80499). Each word systemctl prints is parsed into the
// extdeps.systemd vocabulary it belongs to -- SystemdUnitLoadState, extdeps.systemd.systemctl
// UnitFileState, SystemdUnitActiveState -- and a word outside that vocabulary refuses the reading, so
// no decision below can fall through an `else` on a string it did not recognize. A unit the manager
// does not know prints an empty UnitFileState; that is carried as Absent, never guessed.
type SlotActuationReading {
  unit: NonEmptyStr
  load: SystemdUnitLoadState
  file: extdeps.systemd.systemctl.UnitFileState?
  active: SystemdUnitActiveState
}

type SlotActuationReadingResolution
  = SlotReadingTyped { reading: SlotActuationReading }
  | SlotReadingUnknownWord { property: String, raw: String }

fn slot_actuation_reading_typed(unit: NonEmptyStr, load_raw: String, file_raw: String, active_raw: String) -> SlotActuationReadingResolution {
  match parse_systemd_unit_load_state(raw: trim(s: load_raw)) {
    Absent => SlotReadingUnknownWord { property: "LoadState", raw: load_raw }
    Present { value: load } =>
      match parse_systemd_unit_active_state(raw: trim(s: active_raw)) {
        Absent => SlotReadingUnknownWord { property: "ActiveState", raw: active_raw }
        Present { value: active } =>
          if trim(s: file_raw) == "" {
            SlotReadingTyped { reading: SlotActuationReading { unit: unit, load: load, file: none, active: active } }
          } else {
            match parse_unit_file_state(raw: trim(s: file_raw)) {
              Absent => SlotReadingUnknownWord { property: "UnitFileState", raw: file_raw }
              Present { value: f } => SlotReadingTyped { reading: SlotActuationReading { unit: unit, load: load, file: Present { value: f }, active: active } }
            }
          }
      }
  }
}

// WHETHER THE SLOT IS RUNNING A JOB IS gunbc.runner.runner_disk_reclaim SlotActivityObservation, not a
// third copy (review 80610). That module names cgroup membership as the structural answer -- every
// Runner.Worker lives in its slot's actions-runner@<slot>.service cgroup -- and this module is its
// producer over the fleet SSH edge. The unit's own cgroup PATH cannot cross that edge (systemd escapes
// the slice as `system-actions\x2drunner.slice`, and the portability alphabet refuses the backslash),
// so the membership is read through ps(1)'s `unit` column, which procps derives from each process's
// /proc/<pid>/cgroup: the same kernel fact, in words the edge admits.
// §3b DIVERGENCE, STATED: gunbc.runner.runner_local_state RunnerSlotBusyStanding answers the same question
// with the worker's ProcessIdentity (boot id, pid, start time). This effect needs only the busy/idle
// answer, so it maps into the payload-free SlotActivityObservation rather than reading a boot id and a
// start time it would discard; a caller that needs the worker's identity uses that standing.

// WHY A DRAIN IS NOT YET SETTLED, AS A TYPE (review 80610): a job is running (the activity read found a
// Runner.Worker), or a stop is already in progress (ActiveState=deactivating, which is not read as a
// job and needs no activity read). Neither is a refusal; both are retried by the next pass.
type SlotDrainPendingCause
  = DrainPendingJobRunning
  | DrainPendingStopInProgress
  | DrainPendingJobRunningLeftUnmasked
  | DrainPendingStopInProgressLeftUnmasked

fn slot_drain_pending_cause_wire(c: SlotDrainPendingCause) -> String {
  match c {
    DrainPendingJobRunning => "a job is running (Runner.Worker in the unit's cgroup); the unit is masked and left running until the job ends"
    DrainPendingStopInProgress => "a stop is already in progress (ActiveState=deactivating); the unit is masked and the stop is not re-issued"
    DrainPendingJobRunningLeftUnmasked => "a job is running (Runner.Worker in the unit's cgroup); the unit is left untouched and unmasked, and a later pass drains it once it is idle"
    DrainPendingStopInProgressLeftUnmasked => "a stop is already in progress (ActiveState=deactivating); the unit is left unmasked until it is inactive"
  }
}

type SlotActuationOutcome
  = SlotActuationNoop { unit: NonEmptyStr, state: String }
  | SlotActivated { unit: NonEmptyStr }
  | SlotNotInstalled { unit: NonEmptyStr }
  | SlotDrainedAndMasked { unit: NonEmptyStr }
  | SlotDrainPending { unit: NonEmptyStr, cause: SlotDrainPendingCause }
  | SlotActuationRefused { unit: NonEmptyStr, step: String, reason: String }

fn slot_actuation_settled(o: SlotActuationOutcome) -> Bool {
  match o {
    SlotActuationNoop { unit: _, state: _ } => true
    SlotActivated { unit: _ } => true
    SlotNotInstalled { unit: _ } => true
    SlotDrainedAndMasked { unit: _ } => true
    SlotDrainPending { unit: _, cause: _ } => false
    SlotActuationRefused { unit: _, step: _, reason: _ } => false
  }
}

fn slot_actuation_outcome_wire(o: SlotActuationOutcome) -> String {
  match o {
    SlotActuationNoop { unit: u, state: st } => join(["actuation ", u as String, " noop ", st], "")
    SlotActivated { unit: u } => join(["actuation ", u as String, " activated-and-read-back"], "")
    SlotNotInstalled { unit: u } => join(["actuation ", u as String, " not-installed (LoadState=not-found: nothing to drain)"], "")
    SlotDrainedAndMasked { unit: u } => join(["actuation ", u as String, " drained-masked-and-read-back"], "")
    SlotDrainPending { unit: u, cause: c } => join(["actuation ", u as String, " DRAIN-PENDING ", slot_drain_pending_cause_wire(c: c)], "")
    SlotActuationRefused { unit: u, step: st, reason: r } => join(["actuation ", u as String, " REFUSED step=", st, " ", r], "")
  }
}

// ── Pure decisions ──────────────────────────────────────────────────────────────────────────────

// Running means the manager holds the unit up or is bringing it up; stopped means it is not and will
// not on its own. Deactivating is neither: it is a stop in progress, so a drain waits for it.
fn slot_state_active(active: SystemdUnitActiveState) -> Bool {
  match active { Active => true Activating => true Reloading => true Inactive => false Failed => false Deactivating => false }
}

fn slot_state_stopped(active: SystemdUnitActiveState) -> Bool {
  match active { Inactive => true Failed => true Active => false Activating => false Reloading => false Deactivating => false }
}

fn slot_state_stopping(active: SystemdUnitActiveState) -> Bool {
  match active { Deactivating => true Active => false Activating => false Reloading => false Inactive => false Failed => false }
}

fn slot_file_is(file: extdeps.systemd.systemctl.UnitFileState?, enabled: Bool) -> Bool {
  match file {
    Absent => false
    Present { value: f } => match f {
      UnitEnabled => enabled
      UnitMasked => !enabled
      UnitEnabledRuntime => false UnitLinked => false UnitStatic => false UnitDisabled => false UnitIndirect => false UnitGenerated => false UnitTransient => false UnitBad => false
    }
  }
}

fn slot_is_masked(r: SlotActuationReading) -> Bool {
  slot_file_is(file: r.file, enabled: false) || match r.load { UnitLoadMasked => true UnitLoaded => false UnitLoadNotFound => false UnitLoadBadSetting => false UnitLoadError => false }
}

fn slot_is_enabled(r: SlotActuationReading) -> Bool {
  slot_file_is(file: r.file, enabled: true)
}

// AN ACTIVE SLOT IS LOADED, ENABLED AND RUNNING. A unit the manager does not know cannot be brought
// into service by this effect -- installing the slot is a different effect -- so not-found refuses,
// as do a bad-setting or error load, a deactivating unit (wait for the stop), and a unit file state
// this effect does not move (linked, static, generated, transient, runtime, bad).
type SlotActivationPlan
  = ActivationAlreadyActive
  | ActivationSteps { steps: List<List<String>> }
  | ActivationRefused { reason: String }

fn slot_activation_plan(r: SlotActuationReading) -> SlotActivationPlan {
  match r.load {
    UnitLoadNotFound => ActivationRefused { reason: "the slot's unit is not installed on this host (LoadState=not-found)" }
    UnitLoadBadSetting => ActivationRefused { reason: "the slot's unit file has a bad setting (LoadState=bad-setting)" }
    UnitLoadError => ActivationRefused { reason: "the manager failed to load the slot's unit (LoadState=error)" }
    UnitLoaded => slot_activation_plan_loaded(r: r)
    UnitLoadMasked => slot_activation_plan_loaded(r: r)
  }
}

fn slot_activation_plan_loaded(r: SlotActuationReading) -> SlotActivationPlan {
  match r.active {
    Deactivating => ActivationRefused { reason: "the slot's unit is deactivating; activation waits for the stop to finish" }
    Active => slot_activation_plan_steps(r: r)
    Activating => slot_activation_plan_steps(r: r)
    Reloading => slot_activation_plan_steps(r: r)
    Inactive => slot_activation_plan_steps(r: r)
    Failed => slot_activation_plan_steps(r: r)
  }
}

fn slot_activation_plan_steps(r: SlotActuationReading) -> SlotActivationPlan {
  match r.file {
    Absent => ActivationRefused { reason: "the slot's unit reports no unit file state, so whether it is enabled is unknown" }
    Present { value: f } =>
      match f {
        UnitEnabled =>
          if slot_state_active(active: r.active) { ActivationAlreadyActive } else { ActivationSteps { steps: [systemctl_start_argv(unit: r.unit)] } }
        UnitMasked =>
          ActivationSteps { steps: concat([systemctl_unmask_argv(unit: r.unit), systemctl_enable_argv(unit: r.unit)], if slot_state_active(active: r.active) { [] } else { [systemctl_start_argv(unit: r.unit)] }) }
        UnitDisabled =>
          ActivationSteps { steps: concat([systemctl_enable_argv(unit: r.unit)], if slot_state_active(active: r.active) { [] } else { [systemctl_start_argv(unit: r.unit)] }) }
        UnitIndirect =>
          ActivationSteps { steps: concat([systemctl_enable_argv(unit: r.unit)], if slot_state_active(active: r.active) { [] } else { [systemctl_start_argv(unit: r.unit)] }) }
        UnitEnabledRuntime => ActivationRefused { reason: "UnitFileState=enabled-runtime: a runtime enablement this effect does not convert" }
        UnitLinked => ActivationRefused { reason: "UnitFileState=linked: the unit file is linked from outside the unit path" }
        UnitStatic => ActivationRefused { reason: "UnitFileState=static: the unit has no install section to enable" }
        UnitGenerated => ActivationRefused { reason: "UnitFileState=generated: the unit is produced by a generator" }
        UnitTransient => ActivationRefused { reason: "UnitFileState=transient: the unit is transient" }
        UnitBad => ActivationRefused { reason: "UnitFileState=bad: the unit file is invalid" }
      }
  }
}

fn slot_activation_read_back_holds(r: SlotActuationReading) -> Bool {
  (match r.load { UnitLoaded => true UnitLoadMasked => false UnitLoadNotFound => false UnitLoadBadSetting => false UnitLoadError => false })
    && slot_is_enabled(r: r) && slot_state_active(active: r.active)
}

// ── The restart decision (the RESTART LEG's actuation) ──────────────────────────────────────────
//
// A RESTART IS NOT AN ACTIVATION. Activation brings an idle slot into service; it refuses a masked
// unit's re-provision and refuses a unit that is already running. A restart cycles a slot that the
// connectivity verdict has already judged DETACHED, ORPHANED, or LOST — a unit that exists and may even
// be "active" to systemd but whose runner is not registered or whose job never reached an agent. So
// this plan is deliberately narrower than activation on the load axis (it will NOT resurrect a unit the
// manager does not have, nor unmask a drained slot — that is a re-provision, a different effect) and
// deliberately broader on the active axis (it restarts a running unit, which activation would no-op).
//
// IT MUST REFUSE WHERE THE STATE IS UNKNOWABLE. A slot whose load could not be read (LoadState=error),
// that is not installed, has a bad setting, or is masked, is refused here rather than restarted blind:
// DESIGN section 5, fail closed on Unresolved/Unreadable. The readback then proves the cycle actually
// happened rather than trusting a systemctl exit code.

type SlotRestartPlan
  = RestartSteps { steps: List<List<String>> }
  | RestartRefused { reason: String }

// THE BUSY CONSULT (review 91071, the #15819 class): every mutating op in this lane is required to consult
// the slot's busy standing BEFORE it touches anything (the RunnerSlotBusyStanding contract, gunbc.runner.
// runner_local_state). A Detached verdict (registration offline) does NOT imply idle, so the plan refuses a
// busy slot: only SlotIdle permits; a busy standing that could not be read refuses exactly like a running
// job (§5, could-not-see is never permission); a slot executing a job refuses UNLESS the lost-agent reading
// corroborates that the running job IS the orphaned one (in_progress, runner null, past timeout), where
// killing it is the remedy. This module's §3b note maps busy into the payload-free SlotActivityObservation
// (the same currency the sibling drain consults via read_slot_worker_over) rather than reading a worker
// ProcessIdentity it would discard; a caller needing the identity uses RunnerSlotBusyStanding directly.
fn slot_restart_plan(r: SlotActuationReading, worker: SlotActivityObservation, lost: LostAgentObservation) -> SlotRestartPlan {
  match r.load {
    UnitLoadNotFound => RestartRefused { reason: "the slot's unit is not installed on this host (LoadState=not-found): restart does not install it" }
    UnitLoadBadSetting => RestartRefused { reason: "the slot's unit file has a bad setting (LoadState=bad-setting)" }
    UnitLoadError => RestartRefused { reason: "the manager failed to load the slot's unit (LoadState=error): the state is unreadable, so it is not restarted" }
    UnitLoadMasked => RestartRefused { reason: "the slot's unit is masked (a drained slot): restart does not unmask — that is a re-provision" }
    UnitLoaded => match worker {
      SlotIdle => RestartSteps { steps: [systemctl_restart_argv(unit: r.unit)] }
      SlotActivityUnobserved { cause: c } =>
        RestartRefused { reason: concat("whether the slot is executing a job could not be read, so it is not restarted: ", c as String) }
      SlotHasLiveWorker => match lost {
        LostAgentDetected { job_id: _, over_by: _ } =>
          RestartSteps { steps: [systemctl_restart_argv(unit: r.unit)] }
        JobNotLost { job_id: _, reason: why } =>
          RestartRefused { reason: concat("the slot is executing a job that is not the orphaned one (", why as String, "); a restart would kill a live job") }
        LostAgentReadRefused { job_id: _, reason: why } =>
          RestartRefused { reason: concat("the slot is executing a job and the lost-agent reading was refused, so the running job is not presumed orphaned: ", why as String) }
      }
    }
  }
}

// THE LIVE MAIN PID OF A READING, IF IT HAS ONE. A grounded or ungrounded main carries a pid; unread or
// none carries none. Used only to prove the restart changed the process.
fn slot_main_process_pid(m: RunnerUnitMainProcess) -> Nat? {
  match m {
    MainProcess { process: p, absolute_start: _ } => Present { value: p.pid }
    MainProcessUngrounded { pid: p, cause: _ } => Present { value: p }
    NoMainProcess => Absent
    MainProcessUnread { cause: _ } => Absent
  }
}

// THE RESTART READS BACK ONLY ON A PROCESS CYCLE: loaded, active, and a live MainPID that differs from
// the one this leg recorded BEFORE the restart (or any live pid where there was none before). This is
// the difference between "systemctl restart returned 0" and "a different agent process is now running"
// — the rung DESIGN section 4c demands: an actuation return cannot mint convergence.
fn slot_restart_read_back_holds(r: SlotActuationReading, before: RunnerUnitMainProcess, after_main: RunnerUnitMainProcess) -> Bool {
  let loaded = match r.load { UnitLoaded => true UnitLoadMasked => false UnitLoadNotFound => false UnitLoadBadSetting => false UnitLoadError => false }
  let after_pid = slot_main_process_pid(m: after_main)
  // The BEFORE side is classified by variant, NOT collapsed through slot_main_process_pid: that helper maps
  // both NoMainProcess (definitively no main -> a live main after is a genuine cold-start cycle) and
  // MainProcessUnread (the unit was not readable -> we cannot tell a cycle from a no-op) to Absent, and
  // conflating them would let an unread before confirm a restart it never observed. A restart leg may reach
  // the actuation with an unread before only on the roster-driven Detached/Orphaned arms, which never consult
  // main; could-not-see is therefore never a readback that a restart happened (DESIGN section 5).
  let before_confirms_cycle = match before {
    NoMainProcess => true
    MainProcessUnread { cause: _ } => false
    MainProcess { process: _, absolute_start: _ } => true
    MainProcessUngrounded { pid: _, cause: _ } => true
  }
  let before_changed = match slot_main_process_pid(m: before) {
    Absent => true
    Present { value: b } => match after_pid {
      Absent => false
      Present { value: a } => a != b
    }
  }
  loaded
    && slot_state_active(active: r.active)
    && before_confirms_cycle
    && match after_pid {
      Absent => false
      Present { value: _ } => before_changed
    }
}


// A DRAINED SLOT IS MASKED AND STOPPED. UNDER MaskWhileRunning the mask comes first, and that is NOT
// safe at any time, which this comment used to claim: `systemctl mask` reloads the manager, and a unit
// whose file is masked loads none of its drop-ins, so a unit still RUNNING when it is masked loses its
// resource-control drop-ins (the template caps on srv1, the per-slot system.control set-property caps on
// srv4) and its Slice= at that reload. Its live job then runs outside system-actions\x2drunner.slice with
// no memory.max on its path, and the memory envelope refuses (fleet-converge run 41861708547 on srv4,
// 2026-11-04: twelve busy slots masked by the slot-tree fold, required v2-bootstrap red on main until the
// units were unmasked and restarted). NeverMaskARunningUnit (below) is the admission that does not. Stopping is admitted only when the unit is not executing a job --
// a Runner.Worker present means a job is in flight, so the slot is left masked and running and the
// effect reports DrainPending; the ephemeral runner exits when its job ends, the mask keeps it down,
// and the next pass reads it stopped. An unreadable process listing refuses rather than guessing idle.
// A deactivating unit is a stop already in progress: it is masked and waited for, never re-stopped.
//
// RESIDUAL RISK, STATED: between reading the listing idle and the stop, the listener can accept a job.
// The window is one SSH round trip, and closing it needs the runner itself to refuse new work
// (deregistration through the GitHub API) -- not modeled here.
type SlotDrainPlan
  = DrainAlreadyMasked
  | DrainUnitNotInstalled
  | DrainSteps { steps: List<List<String>> }
  | DrainWaitForJob { mask: List<List<String>> }
  | DrainWaitForStop { mask: List<List<String>> }
  | DrainRefused { reason: String }

// HOW A DRAIN CLOSES ADMISSION, AS A CHOICE THE CALLER MAKES BY NAME.
//   MaskWhileRunning: mask first, at any state. Admission closes immediately, including on a busy unit,
//     which is what the cap bracket's drain-and-wait relies on; it carries the exposure stated above,
//     recorded as an open integration concern on the bracket rather than changed under it here.
//   NeverMaskARunningUnit: a running unit is never masked. An idle one is STOPPED and then masked, so it
//     is inactive when the mask's reload lands; a busy or stopping one gets no leg at all and is pending
//     for a later pass. Admission is not closed while it runs, so it may take the next job; that costs a
//     later pass, never an envelope. The slot-tree rebuild uses this.
type SlotDrainAdmission
  = MaskWhileRunning
  | NeverMaskARunningUnit

fn slot_drain_plan(r: SlotActuationReading, worker: SlotActivityObservation) -> SlotDrainPlan {
  slot_drain_plan_under(r: r, worker: worker, admission: MaskWhileRunning)
}

fn slot_drain_plan_under(r: SlotActuationReading, worker: SlotActivityObservation, admission: SlotDrainAdmission) -> SlotDrainPlan {
  let mask = if slot_is_masked(r: r) { [] } else { [systemctl_mask_argv(unit: r.unit)] }
  match r.load {
    UnitLoadNotFound => DrainUnitNotInstalled
    UnitLoadBadSetting => DrainRefused { reason: "the slot's unit file has a bad setting (LoadState=bad-setting)" }
    UnitLoadError => DrainRefused { reason: "the manager failed to load the slot's unit (LoadState=error)" }
    UnitLoaded => slot_drain_plan_loaded(r: r, worker: worker, mask: mask, admission: admission)
    UnitLoadMasked => slot_drain_plan_loaded(r: r, worker: worker, mask: mask, admission: admission)
  }
}

// THE MASK A RUNNING UNIT MAY RECEIVE UNDER THE ADMISSION: all of it under MaskWhileRunning, none under
// NeverMaskARunningUnit.
fn slot_drain_running_mask(mask: List<List<String>>, admission: SlotDrainAdmission) -> List<List<String>> {
  match admission {
    MaskWhileRunning => mask
    NeverMaskARunningUnit => []
  }
}

fn slot_drain_plan_loaded(r: SlotActuationReading, worker: SlotActivityObservation, mask: List<List<String>>, admission: SlotDrainAdmission) -> SlotDrainPlan {
  match r.active {
    Inactive => if slot_is_masked(r: r) { DrainAlreadyMasked } else { DrainSteps { steps: mask } }
    Failed => if slot_is_masked(r: r) { DrainAlreadyMasked } else { DrainSteps { steps: mask } }
    Deactivating => DrainWaitForStop { mask: slot_drain_running_mask(mask: mask, admission: admission) }
    Active => slot_drain_plan_running(r: r, worker: worker, mask: mask, admission: admission)
    Activating => slot_drain_plan_running(r: r, worker: worker, mask: mask, admission: admission)
    Reloading => slot_drain_plan_running(r: r, worker: worker, mask: mask, admission: admission)
  }
}

fn slot_drain_plan_running(r: SlotActuationReading, worker: SlotActivityObservation, mask: List<List<String>>, admission: SlotDrainAdmission) -> SlotDrainPlan {
  match worker {
    SlotActivityUnobserved { cause: c } => DrainRefused { reason: concat("whether the slot is executing a job could not be read, so it is not stopped: ", c as String) }
    SlotHasLiveWorker => DrainWaitForJob { mask: slot_drain_running_mask(mask: mask, admission: admission) }
    SlotIdle => match admission {
      MaskWhileRunning => DrainSteps { steps: concat(mask, [systemctl_stop_argv(unit: r.unit)]) }
      NeverMaskARunningUnit => DrainSteps { steps: concat([systemctl_stop_argv(unit: r.unit)], mask) }
    }
  }
}

// A unit that disappeared between the drain legs and the re-read cannot be started again, so the drain
// holds; it is read as not-installed, not as masked-and-stopped (review 80640), and the outcome of a
// drain whose FIRST read found no unit is SlotNotInstalled rather than a masked no-op.
fn slot_drain_read_back_holds(r: SlotActuationReading) -> Bool {
  match r.load {
    UnitLoadNotFound => true
    UnitLoadBadSetting => false
    UnitLoadError => false
    UnitLoaded => slot_is_masked(r: r) && slot_state_stopped(active: r.active)
    UnitLoadMasked => slot_state_stopped(active: r.active)
  }
}

// ── Readings ────────────────────────────────────────────────────────────────────────────────────

fn slot_show_value(lines: List<String>, property: SystemdUnitProperty) -> String? {
  let key = concat(systemd_unit_property_wire(property: property) as String, "=")
  fold(lines, init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: key) { Present { value: substring(s: l, start: string_length(s: key), end: string_length(s: l)) } } else { acc })
}

// The reading for ONE unit out of a show over several, joined by Id; a unit with no complete block is
// unread, never borrowed from a neighbour.
fn slot_actuation_reading_of(unit: NonEmptyStr, show_stdout: String) -> SlotActuationReadingResolution? {
  fold(split(s: show_stdout, delimiter: "\n\n"), init: none, f: (acc, b) => {
    let lines = map(split(s: b, delimiter: "\n"), l => trim(s: l))
    match slot_show_value(lines: lines, property: IdProperty) {
      Absent => acc
      Present { value: id } =>
        if trim(s: id) != (unit as String) { acc } else {
          match slot_show_value(lines: lines, property: LoadState) {
            Absent => acc
            Present { value: ls } =>
              match slot_show_value(lines: lines, property: UnitFileState) {
                Absent => acc
                Present { value: fs } =>
                  match slot_show_value(lines: lines, property: ActiveState) {
                    Absent => acc
                    Present { value: a } => Present { value: slot_actuation_reading_typed(unit: unit, load_raw: ls, file_raw: fs, active_raw: a) }
                  }
              }
          }
        }
    }
  })
}

// ── The argv this module sends, for the portability witness ─────────────────────────────────────

fn slot_actuation_elevated(command: List<String>) -> List<String> {
  let inv = sudo_elevate(command: command)
  concat([inv.bin_path], inv.args)
}

fn slot_actuation_argvs(unit: NonEmptyStr) -> List<List<String>> {
  concat(
    [systemctl_show_properties_argv(units: [unit], properties: slot_actuation_show_properties), ps_unit_comm_listing_argv(), systemctl_show_properties_argv(units: [unit], properties: [ControlGroup, TasksCurrent])],
    map([systemctl_unmask_argv(unit: unit), systemctl_enable_argv(unit: unit), systemctl_start_argv(unit: unit), systemctl_mask_argv(unit: unit), systemctl_stop_argv(unit: unit)], c => slot_actuation_elevated(command: c)),
  )
}

// ── Remote legs over the administrator edge ─────────────────────────────────────────────────────

type SlotReadOutcome
  = SlotRead { reading: SlotActuationReading }
  | SlotReadRefused { reason: String }

fn read_slot_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotReadOutcome
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_properties_argv(units: [unit], properties: slot_actuation_show_properties)) {
    TypedArgvExecRefused { reason: why } => SlotReadRefused { reason: why }
    TypedArgvExecConverged { result: r } =>
      if !r.success {
        SlotReadRefused { reason: join(["systemctl show exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") }
      } else {
        match slot_actuation_reading_of(unit: unit, show_stdout: r.stdout) {
          Absent => SlotReadRefused { reason: "systemctl show returned no complete block for the unit" }
          Present { value: res } =>
            match res {
              SlotReadingUnknownWord { property: p, raw: w } => SlotReadRefused { reason: join(["systemctl show printed ", p, "=", w, ", a word outside the systemd vocabulary this effect decides on"], "") }
              SlotReadingTyped { reading: rd } => SlotRead { reading: rd }
            }
        }
      }
  }
}

// IDLE IS PROVEN BY THE UNIT'S OWN PROCESS, NEVER BY ABSENCE (review on ff67e67949). The decision is
// only asked of an active unit, and an active runner unit always owns its Runner.Listener. So a listing
// in which the unit's name appears on no line -- ps built without systemd prints `-` in the unit
// column, or the column truncated the full actions-runner@<slot>.service name -- has not shown this
// unit at all, and reading it as idle would stop a slot whose job ran unattributed. It is unobserved.
fn slot_activity_of_listing(listing: String, unit: NonEmptyStr) -> SlotActivityObservation {
  if ps_unit_runs_command(listing: listing, unit: unit as String, comm: runner_job_process_comm) {
    SlotHasLiveWorker
  } else if ps_unit_runs_any_process(listing: listing, unit: unit as String) {
    SlotIdle
  } else {
    SlotActivityUnobserved { cause: join(["the process listing attributes no process to ", unit as String, ", which an active runner unit always has (its Runner.Listener): the unit column is missing or truncated, so idleness is unproven"], "") as NonEmptyStr }
  }
}

// A LISTING THAT ATTRIBUTES NOTHING IS SETTLED BY THE UNIT'S OWN TASK COUNT, NOT READ AS IDLE. The unit
// column can be missing or truncated, and then the listing has not shown the unit at all; but a unit can
// also have no process because it has none -- a crash-looping slot in its restart delay is `activating`
// with nothing alive (srv1-02, 2026-10-30: NRestarts 1714, and every drain refused forever). Which of the
// two it is, is the manager's own count: TasksCurrent is the unit cgroup's pids.current, which in cgroup v2
// counts the cgroup and every descendant (kernel cgroup-v2, pids controller), so zero means no
// Runner.Worker and no job anywhere under the unit; a blank ControlGroup means the unit has no workload
// cgroup at all (gunbc.runner.runner_slot_retirement control_group_property_means_cgroup_absent). Both read
// through `systemctl show`, whose argv crosses the fleet edge; the cgroup files themselves would not, because
// a template instance's cgroup path carries a `\x2d` escape the edge refuses. A nonzero count is something
// the listing did not attribute and stays unobserved; a count that is not a number stays unobserved.
type SlotTaskCount
  = SlotCgroupAbsent
  | SlotTasks { count: Int }
  | SlotTasksUnread { cause: String }

fn slot_task_count_of_show(show_stdout: String) -> SlotTaskCount {
  let lines = map(split(s: show_stdout, delimiter: "\n"), l => trim(s: l))
  match slot_show_value(lines: lines, property: ControlGroup) {
    Absent => SlotTasksUnread { cause: "systemctl show printed no ControlGroup" }
    Present { value: cg } =>
      if control_group_property_means_cgroup_absent(value: cg) { SlotCgroupAbsent } else {
        match slot_show_value(lines: lines, property: TasksCurrent) {
          Absent => SlotTasksUnread { cause: "systemctl show printed no TasksCurrent" }
          Present { value: t } =>
            match parse_int(s: trim(s: t)) {
              Absent => SlotTasksUnread { cause: join(["TasksCurrent is not a count: '", trim(s: t), "'"], "") }
              Present { value: n } => SlotTasks { count: n }
            }
        }
      }
  }
}

fn slot_activity_with_task_count(listing: SlotActivityObservation, tasks: SlotTaskCount) -> SlotActivityObservation {
  match listing {
    SlotHasLiveWorker => SlotHasLiveWorker
    SlotIdle => SlotIdle
    SlotActivityUnobserved { cause: c } =>
      match tasks {
        SlotCgroupAbsent => SlotIdle
        SlotTasks { count: n } =>
          if n == 0 { SlotIdle } else {
            SlotActivityUnobserved { cause: join([c as String, "; TasksCurrent=", to_string(n), ", so a process the listing did not attribute is alive"], "") as NonEmptyStr }
          }
        SlotTasksUnread { cause: tc } => SlotActivityUnobserved { cause: join([c as String, "; the unit's task count could not be read: ", tc], "") as NonEmptyStr }
      }
  }
}

fn read_slot_task_count_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotTaskCount
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_properties_argv(units: [unit], properties: [ControlGroup, TasksCurrent])) {
    TypedArgvExecRefused { reason: why } => SlotTasksUnread { cause: why }
    TypedArgvExecConverged { result: r } =>
      if !r.success {
        SlotTasksUnread { cause: join(["systemctl show exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") }
      } else {
        slot_task_count_of_show(show_stdout: r.stdout)
      }
  }
}

fn read_slot_worker_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotActivityObservation
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: ps_unit_comm_listing_argv()) {
    TypedArgvExecRefused { reason: why } => SlotActivityUnobserved { cause: why as NonEmptyStr }
    TypedArgvExecConverged { result: r } =>
      if !r.success {
        SlotActivityUnobserved { cause: join(["ps exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") as NonEmptyStr }
      } else {
        match slot_activity_of_listing(listing: r.stdout, unit: unit) {
          SlotHasLiveWorker => SlotHasLiveWorker
          SlotIdle => SlotIdle
          SlotActivityUnobserved { cause: c } =>
            slot_activity_with_task_count(listing: SlotActivityUnobserved { cause: c }, tasks: read_slot_task_count_over(target: target, context: context, unit: unit))
        }
      }
  }
}

fn run_slot_steps_over(target: SshTarget, context: FleetSshExecutionContext, steps: List<List<String>>) -> String?
{
  fold(steps, init: none, f: (acc, step) => match acc {
    Present { value: _ } => acc
    Absent =>
      match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: slot_actuation_elevated(command: step)) {
        TypedArgvExecRefused { reason: why } => Present { value: join([join(step, " "), ": ", why], "") }
        TypedArgvExecConverged { result: r } =>
          if r.success { none } else { Present { value: join([join(step, " "), " exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") } }
      }
  })
}

// ── The two effects ─────────────────────────────────────────────────────────────────────────────

fn activate_runner_slot_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotActuationOutcome
{
  match read_slot_over(target: target, context: context, unit: unit) {
    SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "read", reason: why }
    SlotRead { reading: r } =>
      match slot_activation_plan(r: r) {
        ActivationRefused { reason: why } => SlotActuationRefused { unit: unit, step: "plan", reason: why }
        ActivationAlreadyActive => SlotActuationNoop { unit: unit, state: "active" }
        ActivationSteps { steps: ss } =>
          match run_slot_steps_over(target: target, context: context, steps: ss) {
            Present { value: why } => SlotActuationRefused { unit: unit, step: "activate", reason: why }
            Absent =>
              match read_slot_over(target: target, context: context, unit: unit) {
                SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "readback", reason: why }
                SlotRead { reading: after } =>
                  if slot_activation_read_back_holds(r: after) { SlotActivated { unit: unit } } else {
                    SlotActuationRefused { unit: unit, step: "readback", reason: "not loaded, enabled and active after activation" }
                  }
              }
          }
      }
  }
}

// THE RESTART LEG'S EFFECT. `before` is the REAL main process the connectivity join was fed — the pid
// the observation grounded the slot on — so the readback can tell a cycled process from a no-op. The
// caller (runner_lifecycle_realize) supplies it only for a verdict that says detached/orphaned/lost, and
// supplies `lost` (the same lost-agent observation the decide used). This effect never re-reads a token and
// never runs blind: it reads the unit, consults busy standing (read_slot_worker_over while active, the §3b
// payload-free currency) and REFUSES a busy slot unless the running job is corroborated orphaned, refuses on
// an unreadable or uninstalled or masked load, restarts once, and re-reads to a process cycle.
//
// FRONTIER (DESIGN section 3c, declared not dangling). This is the modeled restart actuation the restart leg
// performs on a permitted verdict. Its CONSUMER is the wet realize arm that calls runner_lifecycle_restart_leg
// above — on RestartLegPermit it invokes this with the observed main as `before`, and on the SlotActuationOutcome
// records the readback; it is refused before it can be reached on any Unknown/Unresolved/Unreadable verdict,
// because runner_lifecycle_restart_leg never returns Permit for those. Its TRIGGER is the same DISABLED
// runner-liveness-reconcile timer; nothing here runs live in this PR. Its WITNESS (runner_slot_restart_witness)
// supplies the target, context, unit and `before` at the boundary and discriminates the refuse arms and the
// changed-MainPID readback. DISSOLVES when the reconcile timer is re-enabled and the wet arm drives it.
fn restart_runner_slot_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, before: RunnerUnitMainProcess, lost: LostAgentObservation) -> SlotActuationOutcome
{
  match read_slot_over(target: target, context: context, unit: unit) {
    SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "read", reason: why }
    SlotRead { reading: r } => {
      let worker = if slot_state_active(active: r.active) { read_slot_worker_over(target: target, context: context, unit: unit) } else { SlotIdle }
      match slot_restart_plan(r: r, worker: worker, lost: lost) {
        RestartRefused { reason: why } => SlotActuationRefused { unit: unit, step: "plan", reason: why }
        RestartSteps { steps: ss } =>
          match run_slot_steps_over(target: target, context: context, steps: ss) {
            Present { value: why } => SlotActuationRefused { unit: unit, step: "restart", reason: why }
            Absent =>
              match read_slot_over(target: target, context: context, unit: unit) {
                SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "readback", reason: why }
                SlotRead { reading: after } =>
                  if slot_restart_read_back_holds(r: after, before: before, after_main: slot_main_process_over(target: target, context: context, unit: unit)) {
                    SlotActivated { unit: unit }
                  } else {
                    SlotActuationRefused { unit: unit, step: "readback", reason: "not loaded and active on a changed MainPID after restart" }
                  }
              }
          }
      }
      }
  }
}


fn drain_and_mask_runner_slot_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotActuationOutcome
{
  drain_runner_slot_under_over(target: target, context: context, unit: unit, admission: MaskWhileRunning)
}

fn drain_runner_slot_under_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr, admission: SlotDrainAdmission) -> SlotActuationOutcome
{
  match read_slot_over(target: target, context: context, unit: unit) {
    SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "read", reason: why }
    SlotRead { reading: r } => {
      let worker = if slot_state_active(active: r.active) { read_slot_worker_over(target: target, context: context, unit: unit) } else { SlotIdle }
      match slot_drain_plan_under(r: r, worker: worker, admission: admission) {
        DrainAlreadyMasked => SlotActuationNoop { unit: unit, state: "masked-and-stopped" }
        DrainUnitNotInstalled => SlotNotInstalled { unit: unit }
        DrainRefused { reason: why } => SlotActuationRefused { unit: unit, step: "plan", reason: why }
        DrainWaitForJob { mask: m } =>
          match run_slot_steps_over(target: target, context: context, steps: m) {
            Present { value: why } => SlotActuationRefused { unit: unit, step: "mask", reason: why }
            Absent => SlotDrainPending { unit: unit, cause: match admission { MaskWhileRunning => DrainPendingJobRunning NeverMaskARunningUnit => DrainPendingJobRunningLeftUnmasked } }
          }
        DrainWaitForStop { mask: m } =>
          match run_slot_steps_over(target: target, context: context, steps: m) {
            Present { value: why } => SlotActuationRefused { unit: unit, step: "mask", reason: why }
            Absent => SlotDrainPending { unit: unit, cause: match admission { MaskWhileRunning => DrainPendingStopInProgress NeverMaskARunningUnit => DrainPendingStopInProgressLeftUnmasked } }
          }
        DrainSteps { steps: ss } =>
          match run_slot_steps_over(target: target, context: context, steps: ss) {
            Present { value: why } => SlotActuationRefused { unit: unit, step: "drain", reason: why }
            Absent =>
              match read_slot_over(target: target, context: context, unit: unit) {
                SlotReadRefused { reason: why } => SlotActuationRefused { unit: unit, step: "readback", reason: why }
                SlotRead { reading: after } =>
                  if slot_drain_read_back_holds(r: after) { SlotDrainedAndMasked { unit: unit } } else {
                    SlotActuationRefused { unit: unit, step: "readback", reason: "not masked and stopped after drain" }
                  }
              }
          }
      }
    }
  }
}

// ── THE NAME THIS SLOT'S CURRENT LISTENER REGISTERED UNDER, read from the host ───────────────────
//
// WHY THIS EXISTS AT ALL, and why the slot's own name cannot stand in for it. A fleet listener is
// registered through a JIT mint (gunbc.runner.runner_jit_mint), and the mint SUFFIXES the slot's
// prefix on every job: srv3-02 registers as srv3-02-1792728034-201414, the next job as something
// else again. So the roster never carries "srv3-02"; joining the roster on the slot's bare name reads
// every running listener as a registration that is not there. And no PREFIX of the slot's name fixes
// that: an earlier mint shares the prefix, so "srv3-02-" would join a registration this host has
// already replaced — a weaker second key that is worse than none, because it can say "idle" about a
// name that no longer answers jobs while the name that does is unexamined. The identity must be READ,
// and joined by exact equality.
//
// THE ONE AUTHORITY IS THE FILE THE RUNNER BINARY ITSELF WRITES, in the slot's own tree:
// <actions_runner_base_dir>/<instance>/.runner, member AgentName. gunbc.runner.runner_unit_file
// renders the unit with WorkingDirectory = RUNNER_DIR = that same directory (the one instance-dir
// authority, shared with the provisioner's tree), Environment=RUNNER_NAME_PREFIX=%i, and ExecStart =
// gunbc.runner.runner_lifecycle_jit_wrapper_path; the wrapper mints "${RUNNER_NAME_PREFIX}-<epoch>-<pid>"
// and hands it to ./run.sh --jitconfig INSIDE the encoded config, writing no record of its own. The
// runner binary then writes the decoded config to the per-instance path — extdeps.github.actions_runner
// states this of the pinned release and cites its source: "Root is the base directory for the
// config-written state files (.runner, .credentials)... The decoded JIT config is written to those same
// files." So the file is the host's record of who registered, and it is per-instance: one slot's tree
// cannot name another slot's mint (gunbc.runner.runner_host_unit_slot: the instance tree is the slot's
// own working directory, and a shared path would be shared state between concurrent slots).
//
// READ OVER THE ROUTE THAT ALREADY EXISTS. One `cat` of that one path, through the same
// ssh.Session.ExecPortableWords edge every other slot reading uses — no new transport, no shell (the
// word alphabet there is what makes an argument inert), no elevation. Least privilege on purpose: this
// is a read of an identity, not a write to a host, and a bracket that needed root to look at a slot
// would be a bracket that could not be reasoned about next to the writes it gates.
//
// NO READABLE IDENTITY IS ITS OWN ANSWER, never a guess. Absent file, refused leg, non-zero exit,
// undecodable bytes, or a file with no AgentName all come back as SlotRegistrationUnreadable NAMING THE
// SLOT. What may not happen is a fallback to the bare name: that is the defect this exists to remove,
// arriving again as a default. A slot whose current registration cannot be seen is a slot whose cap
// cannot be written.
type SlotRegistrationIdentity
  = RegistrationIdentityRead { instance: NonEmptyStr, name: NonEmptyStr }
  | SlotRegistrationUnreadable { instance: NonEmptyStr, cause: String }

// The `cat` leg for one slot's registration file. The path is built by the SAME authority that
// provisions the tree, so a slot whose tree moved cannot be read at its old address.
fn slot_registration_file_command(instance: NonEmptyStr) -> List<String> {
  ["cat", join([runner_slot_instance_dir(instance_name: instance) as String, "/", actions_runner_registration_file_name], "")]
}

fn slot_registration_unreadable(instance: NonEmptyStr, cause: String) -> SlotRegistrationIdentity {
  // THE CAUSE NAMES THE SLOT IT FAILED ON, not merely the typed field. A reader that cannot say which slot
  // it could not read leaves an operator with nothing to act on, and a §5 diagnostic has to be located:
  // this string is what reaches the observe receipt and the bracket's withheld-cap verdict verbatim.
  SlotRegistrationUnreadable { instance: instance, cause: join(["slot ", instance as String, ": ", cause], "") }
}

// THE ONE HOST READ of the current registration identity, over the administrator-over-fleet-SSH edge.
// Every failure keeps the instance in the answer, because a refusal that cannot name the slot it failed
// on is a refusal nobody can act on.
fn read_slot_registration_over(target: SshTarget, context: FleetSshExecutionContext, instance: NonEmptyStr) -> SlotRegistrationIdentity
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: slot_registration_file_command(instance: instance)) {
    TypedArgvExecRefused { reason: why } => slot_registration_unreadable(instance: instance, cause: why)
    TypedArgvExecConverged { result: r } =>
      if !r.success {
        slot_registration_unreadable(instance: instance, cause: join(["the command could not read the slot's registration file; exit ", to_string(r.exit_code)], ""))
      } else {
        match actions_runner_registration_decode(raw: r.stdout) {
          ActionsRunnerRegistrationUnreadable { reason: why } => slot_registration_unreadable(instance: instance, cause: why)
          ActionsRunnerRegistrationDecoded { registration: _, agent_name: an } => match an {
            AgentNameRead { value: n } => RegistrationIdentityRead { instance: instance, name: n }
            AgentNameAbsent => slot_registration_unreadable(instance: instance, cause: "the registration file carries no AgentName, so the host does not say which registration is this slot's")
            AgentNameUnreadable { reason: why } => slot_registration_unreadable(instance: instance, cause: why)
          }
        }
      }
  }
}

// THE SAME READ, ADDRESSED BY UNIT, WHICH IS HOW EVERY READING IN THIS DOMAIN IS ADDRESSED. The slot is
// named through its unit because the unit is what the bracket, the receipt and every refusal speak in; the
// instance inside it is what addresses the registration file. An unparseable unit yields a refusal that
// names the unit and costs NO leg: there is no slot whose tree to open, and no fallback name to join on.
//
// ONE AUTHORITY, SO A LATER CALLER CANNOT DERIVE A DIFFERENT SLOT. Today the fleet-converge observe receipt
// is its only caller (gunbc.runner.runner_host_file_converge.runner_host_current_registration_text), and the
// cap bracket does NOT yet call it: the bracket still joins the organization roster on the slot's bare name,
// which is a defect tracked with this work and fixed in the follow-up change that introduces the bracket's
// roster join on the CURRENT identity. When that change lands it must call THIS function rather than derive
// the instance again, or the receipt could report an identity the bracket would not have joined on.
type UnitRegistrationReading
  = UnitRegistrationRead { unit: NonEmptyStr, instance: NonEmptyStr, name: NonEmptyStr }
  | UnitRegistrationUnreadable { unit: NonEmptyStr, cause: String }

fn slot_current_registration_over_unit(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> UnitRegistrationReading
{
  match read_runner_unit_name(observed: unit) {
    NotARunnerUnit { observed: _ } => UnitRegistrationUnreadable { unit: unit, cause: "the unit is not a runner unit, so it names no registration" }
    RunnerUnitInstanceMalformed { observed: _, cause: c } => UnitRegistrationUnreadable { unit: unit, cause: c as String }
    RunnerUnitInstance { registration_name: instance } =>
      match read_slot_registration_over(target: target, context: context, instance: instance) {
        RegistrationIdentityRead { instance: i, name: n } => UnitRegistrationRead { unit: unit, instance: i, name: n }
        SlotRegistrationUnreadable { instance: i, cause: c } =>
          UnitRegistrationUnreadable { unit: unit, cause: join(["the host holds no readable current registration for ", i as String, ": ", c], "") }
      }
  }
}

// ── ObserveRunnerLocalState: a read, never an actuation ─────────────────────────────────────────

// THE SLOT'S LOCAL STANDING AS ONE READ-ONLY OBSERVATION over the same administrator edge as the two
// actuations. It issues only `systemctl show`, `ps` and `cat` of /proc, so it mutates nothing; it is settled when
// the unit reading AND the worker reading both came back and the main process is not unread, and any refused leg
// is a located NotConverged naming the leg, never a default. The main process is gunbc.runner.runner_local_state
// RunnerUnitMainProcess, parsed ONCE from the `systemctl show` answer: `0` is NoMainProcess ("supervises no
// process", never a pid), a pid is grounded by the boot id and the /proc start time into a ProcessIdentity or
// stays MainProcessUngrounded, and a leg that did not answer is MainProcessUnread. The unread/ungrounded reading
// feeds slot_incarnation_registration directly.
type SlotLocalObservation
  = SlotLocalObserved { unit: NonEmptyStr, reading: SlotActuationReading, worker: SlotActivityObservation, main: RunnerUnitMainProcess }
  | SlotLocalUnobserved { unit: NonEmptyStr, step: String, reason: String }

fn slot_main_pid_raw_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> String
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: systemctl_show_properties_argv(units: [unit], properties: [IdProperty, MainPID])) {
    TypedArgvExecRefused { reason: why } => concat("unread:", why)
    TypedArgvExecConverged { result: r } =>
      if !r.success {
        join(["unread:systemctl show exit=", to_string(r.exit_code)], "")
      } else {
        match fold(split(s: r.stdout, delimiter: "\n"), init: none, f: (acc, l) =>
          if starts_with(s: l, prefix: "MainPID=") { Present { value: trim(s: substring(s: l, start: 8, end: string_length(s: l))) } } else { acc }) {
          Absent => "unread:no MainPID line"
          Present { value: v } => v
        }
      }
  }
}

// ONE READ OF A /proc TEXT over the edge; a refused or failed read is Absent (unread), never an empty text.
fn slot_proc_text_over(target: SshTarget, context: FleetSshExecutionContext, path: String) -> String?
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv_words(command: cat_command(path: path))) {
    TypedArgvExecRefused { reason: _ } => none
    TypedArgvExecConverged { result: r } => if r.success { Present { value: r.stdout } } else { none }
  }
}

// THE PARSE, PURE: the raw MainPID answer plus the two grounding texts, to the one RunnerUnitMainProcess.
fn slot_main_process_of(raw: String, boot: String?, stat: String?, abs: ProcessAbsoluteStart) -> RunnerUnitMainProcess {
  if starts_with(s: raw, prefix: "unread:") {
    MainProcessUnread { cause: raw as NonEmptyStr }
  } else {
    match parse_int(s: raw) {
      Absent => MainProcessUnread { cause: concat("MainPID answered something that is not an integer: ", raw) as NonEmptyStr }
      Present { value: n } =>
        if n == 0 {
          NoMainProcess
        } else {
          match checked_int_to_nat(n: n) {
            Absent => MainProcessUnread { cause: concat("MainPID is not a pid: ", raw) as NonEmptyStr }
            Present { value: pid } =>
              match boot {
                Absent => MainProcessUngrounded { pid: pid, cause: "the boot id was not read, so the pid is not an identity" as NonEmptyStr }
                Present { value: b } =>
                  match stat {
                    Absent => MainProcessUngrounded { pid: pid, cause: "/proc/PID/stat was not read, so the start time is unknown" as NonEmptyStr }
                    Present { value: t } =>
                      match proc_pid_stat_start_time(content: t) {
                        StartTimeObserved { ticks_since_boot: ticks } =>
                          if trim(s: b) == "" {
                            MainProcessUngrounded { pid: pid, cause: "the boot id read was empty" as NonEmptyStr }
                          } else {
                            MainProcess { process: ProcessIdentity { boot_id: trim(s: b) as NonEmptyStr, pid: pid, start_time: to_string(ticks) as NonEmptyStr }, absolute_start: abs }
                          }
                        StartTimeCommUnterminated => MainProcessUngrounded { pid: pid, cause: "/proc/PID/stat has no terminated comm field" as NonEmptyStr }
                        StartTimeFieldAbsent { fields_after_comm: _ } => MainProcessUngrounded { pid: pid, cause: "/proc/PID/stat has no start time field" as NonEmptyStr }
                        StartTimeUnparseable { field: _ } => MainProcessUngrounded { pid: pid, cause: "/proc/PID/stat start time is not an integer" as NonEmptyStr }
                      }
                  }
              }
          }
        }
    }
  }
}

fn slot_main_process_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> RunnerUnitMainProcess
{
  let raw = slot_main_pid_raw_over(target: target, context: context, unit: unit)
  match parse_int(s: raw) {
    Present { value: n } =>
      if n > 0 {
        let pid_stat = slot_proc_text_over(target: target, context: context, path: concat("/proc/", concat(raw, "/stat")))
        slot_main_process_of(
          raw: raw,
          boot: slot_proc_text_over(target: target, context: context, path: "/proc/sys/kernel/random/boot_id"),
          stat: pid_stat,
          abs: proc_absolute_start_of(
            proc_stat: slot_proc_text_over(target: target, context: context, path: "/proc/stat"),
            clock_ticks_text: slot_command_text_over(target: target, context: context, command: getconf_clock_ticks_command()),
            start_ticks: match pid_stat {
              Absent => none
              Present { value: t } => match proc_pid_stat_start_time(content: t) {
                StartTimeObserved { ticks_since_boot: ticks } => Present { value: ticks }
                StartTimeCommUnterminated => none
                StartTimeFieldAbsent { fields_after_comm: _ } => none
                StartTimeUnparseable { field: _ } => none
              }
            },
          ),
        )
      } else {
        slot_main_process_of(raw: raw, boot: none, stat: none, abs: StartUnread { cause: "no main process" as NonEmptyStr })
      }
    Absent => slot_main_process_of(raw: raw, boot: none, stat: none, abs: StartUnread { cause: "MainPID unread" as NonEmptyStr })
  }
}

// A SECOND COMMAND READ IN THE SAME PROBE, next to the cat reads, so the absolute start comes from one
// pass over the host and not a second, differently-timed one. The clock tick rate is READ here (getconf
// CLK_TCK) and never assumed to be 100 — assuming it silently shifts every start comparison by the
// ratio between the real rate and the guess.
fn slot_command_text_over(target: SshTarget, context: FleetSshExecutionContext, command: ArgvCommand) -> String?
{
  match typed_argv_exec_over_fleet_ssh(target: target, context: context, argv: argv_words(command: command)) {
    TypedArgvExecRefused { reason: _ } => none
    TypedArgvExecConverged { result: r } => if r.success { Present { value: r.stdout } } else { none }
  }
}

// THE ABSOLUTE START, PURE AND BOUNDARY-FED: boot epoch (btime) plus the process's start ticks divided
// by the read tick rate. Any of the three inputs missing or unparseable is StartUnread, never a zero: a
// zero start would make a fresh pid look ancient to the recycled-pid check, or an ancient one look fresh,
// depending on which side of the bound it landed on.
fn proc_absolute_start_of(proc_stat: String?, clock_ticks_text: String?, start_ticks: Int?) -> ProcessAbsoluteStart {
  match proc_stat {
    Absent => StartUnread { cause: "/proc/stat was not read, so the boot time is unknown" as NonEmptyStr }
    Present { value: ps } =>
      match proc_stat_boot_time(content: ps) {
        BootTimeLineAbsent => StartUnread { cause: "/proc/stat has no btime line" as NonEmptyStr }
        BootTimeUnparseable { field: f } => StartUnread { cause: concat("/proc/stat btime is not an integer: ", f) as NonEmptyStr }
        BootTimeBeforeEpoch { field: f } => StartUnread { cause: concat("/proc/stat btime precedes the epoch: ", f) as NonEmptyStr }
        BootTimeObserved { epoch_seconds: btime } =>
          match clock_ticks_text {
            Absent => StartUnread { cause: "the clock tick rate was not read; it is never assumed to be 100" as NonEmptyStr }
            Present { value: ct } =>
              match clock_ticks_reading(stdout: ct) {
                ClockTicksUnparseable { field: f } => StartUnread { cause: concat("the clock tick rate is not an integer: ", f) as NonEmptyStr }
                ClockTicksNotPositive { value: v } => StartUnread { cause: concat("the clock tick rate is not positive: ", to_string(v)) as NonEmptyStr }
                ClockTicksObserved { per_second: hz } =>
                  match start_ticks {
                    Absent => StartUnread { cause: "the process start time was not read" as NonEmptyStr }
                    Present { value: ticks } =>
                      // The clock tick rate is a frequency, so it is carried on the std.measure Hertz
                      // carrier (never a bare scalar divisor), exactly as the sibling replica_incarnation
                      // probe carries it; btime is an EpochSecs instant. The absolute start is the boot
                      // instant plus start_ticks over that rate, and a boot that would fall before the
                      // epoch is refused rather than clamped.
                      let ticks_per_second: Hertz = hertz(count: hz)
                      let abs = (btime as Int) + (ticks / hertz_count(h: ticks_per_second))
                      if abs < 0 {
                        StartUnread { cause: "the computed absolute process start precedes the epoch" as NonEmptyStr }
                      } else {
                        StartObserved { started_at: abs }
                      }
                  }
              }
          }
      }
  }
}

fn observe_runner_slot_local_state_over(target: SshTarget, context: FleetSshExecutionContext, unit: NonEmptyStr) -> SlotLocalObservation
{
  match read_slot_over(target: target, context: context, unit: unit) {
    SlotReadRefused { reason: why } => SlotLocalUnobserved { unit: unit, step: "unit-read", reason: why }
    SlotRead { reading: rd } =>
      SlotLocalObserved { unit: unit, reading: rd, worker: read_slot_worker_over(target: target, context: context, unit: unit), main: slot_main_process_over(target: target, context: context, unit: unit) }
  }
}

fn slot_activity_wire(a: SlotActivityObservation) -> String {
  match a {
    SlotHasLiveWorker => "worker=live"
    SlotIdle => "worker=idle"
    SlotActivityUnobserved { cause: c } => join(["worker=unobserved(", c as String, ")"], "")
  }
}

fn slot_main_process_wire(m: RunnerUnitMainProcess) -> String {
  match m {
    MainProcessUnread { cause: c } => concat("main=unread(", concat(c as String, ")"))
    NoMainProcess => "main=none"
    MainProcessUngrounded { pid: p, cause: c } => join(["main=ungrounded(pid=", to_string(p), ": ", c as String, ")"], "")
    MainProcess { process: p, absolute_start: _ } => join(["main=pid ", to_string(p.pid), " boot=", p.boot_id as String, " start=", p.start_time as String], "")
  }
}

fn slot_local_observation_settled(o: SlotLocalObservation) -> Bool {
  match o {
    SlotLocalObserved { unit: _, reading: _, worker: w, main: m } =>
      (match m { MainProcessUnread { cause: _ } => false NoMainProcess => true MainProcessUngrounded { pid: _, cause: _ } => true MainProcess { process: _, absolute_start: _ } => true })
        && match w { SlotActivityUnobserved { cause: _ } => false SlotHasLiveWorker => true SlotIdle => true }
    SlotLocalUnobserved { unit: _, step: _, reason: _ } => false
  }
}

fn slot_local_observation_wire(o: SlotLocalObservation) -> String {
  match o {
    SlotLocalObserved { unit: u, reading: _, worker: w, main: m } => join(["observe ", u as String, " ", slot_main_process_wire(m: m), " ", slot_activity_wire(a: w)], "")
    SlotLocalUnobserved { unit: u, step: st, reason: r } => join(["observe ", u as String, " UNOBSERVED step=", st, " ", r], "")
  }
}
