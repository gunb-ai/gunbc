module gunbc.runner_group_restriction_observation

import std.types { NonEmptyStr, String, Bool, Int, List }
import extdeps.github.actions_jit_runner { JitRunnerGroupId }
import extdeps.github.org_actions { RunnerGroupVisibility, AllRepositories, SelectedRepositories, PrivateRepositories, runner_group_visibility_wire }
import gunbc.repository { gunbc_repository }
import gunbc.runner.runner_qualification_ref_segment { qualification_pin_segment_in_family }
import gunbc.generated_artifact { artifact_path, MicrovmShakedownYamlArtifact }
import gunbc.fleet.org_actions_inspection {
  RunnerGroupIdentity, RunnerGroupListDecode, RunnerGroupListDecoded, RunnerGroupListDecodeRefused,
}

// THE ONE READING THAT AUTHORIZES A MICROVM MINT, AND THE ONLY PLACE IT CAN BE WRITTEN.
//
// gunbc.runner_jit_mint plan_jit_mint mints a JIT runner only into a group OBSERVED restricted to
// the shakedown workflow file, because GitHub may hand a JIT registration its OS and architecture
// default labels and a runner in an unrestricted group would then match witnesses.yml, heal.yml and
// fleet-converge jobs. That authorization is only as good as the path that constructs it, so the
// restriction is a sole_constructor record: nothing outside this module can write a
// RestrictedRunnerGroup by literal or cast, and the only function here that mints one is
// the observer below, which does so only on a decoded GitHub reading. A witness or a controller that
// wants the authorized arm has to hand this observer a body GitHub could have sent.
//
// The reading is GitHub's own runner-group shape (extdeps.github.org_actions OrgRunnerGroup,
// restricted_to_workflows and selected_workflows), read by gunbc.fleet.org_actions_inspection
// read_runner_groups -- the one read the org-actions inspection, the ensure run and the controller
// all go through, not a second one.

// THE WORKFLOW IDENTIFIER THE GROUP MUST SELECT, derived rather than spelled. GitHub identifies a
// workflow in selected_workflows as `<owner>/<repo>/<path>@<ref>` (docs.github.com/en/rest/actions/
// self-hosted-runner-groups, REST API version 2022-11-28, read 2026-09-23). The repository and its
// default branch are gunbc.repository gunbc_repository and the path is the shakedown workflow's
// generated location, so a rename of either reaches this string. The ref is the full branch ref:
// the shakedown is dispatched from the default branch, and a ref-less or other-branch entry would
// admit a workflow file this repository did not review.
fn microvm_shakedown_selected_workflow() -> NonEmptyStr {
  join([
    gunbc_repository.full_name as String, "/",
    artifact_path(a: MicrovmShakedownYamlArtifact),
    "@refs/heads/", gunbc_repository.default_branch as String,
  ], "") as NonEmptyStr
}

// THE GROUP IS NAMED, AND ITS ID IS READ. The microVM mint's group is one this repository creates
// (gunbc.runner_group_restriction_ensure), and GitHub assigns its id at creation -- so the name is
// the only identity the repository can author, and the id reaches the mint only through a reading
// that found exactly one group holding that name. A name held by two groups is refused, never
// resolved to either.
data microvm_shakedown_runner_group_name: NonEmptyStr = "microvm-shakedown"

type RestrictedRunnerGroup sole_constructor {
  group: JitRunnerGroupId
  name: NonEmptyStr
  selected_workflow: NonEmptyStr
}

// EVERY READING BUT ONE REFUSES, EACH BY ITS OWN NAME, so an operator reading the controller's
// refusal learns which fact of the group is wrong rather than that "the group" is. The id is
// carried by the causes that found a group; the causes that found none have no id to carry.
type RunnerGroupRestrictionRefusal
  = RunnerGroupRestrictionNotYetObserved
  | RunnerGroupListUnreadable { reason: NonEmptyStr }
  | RunnerGroupAbsent
  | RunnerGroupDuplicated { count: Int }
  | RunnerGroupNotRestrictedToWorkflows { group: JitRunnerGroupId }
  | RunnerGroupVisibleBeyondSelected { group: JitRunnerGroupId, visibility: RunnerGroupVisibility }
  | RunnerGroupAdmitsPublicRepositories { group: JitRunnerGroupId }
  | RunnerGroupSelectsOtherWorkflows { group: JitRunnerGroupId, selected: List<NonEmptyStr>, expected: NonEmptyStr }

fn runner_group_restriction_refusal_text(cause: RunnerGroupRestrictionRefusal) -> String {
  match cause {
    RunnerGroupRestrictionNotYetObserved => "RunnerGroupRestrictionNotYetObserved: no read of the org's runner groups reached this decision"
    RunnerGroupListUnreadable { reason } => concat("RunnerGroupListUnreadable: ", reason as String)
    RunnerGroupAbsent => "RunnerGroupAbsent: the org's runner groups contain no group with this name"
    RunnerGroupDuplicated { count } => concat("RunnerGroupDuplicated: groups with this name: ", to_string(count))
    RunnerGroupVisibleBeyondSelected { group, visibility } =>
      join(["RunnerGroupVisibleBeyondSelected: group ", to_string(group.value), " has visibility=", runner_group_visibility_wire(v: visibility) as String, ", so repositories beyond the selected one may use it"], "")
    RunnerGroupAdmitsPublicRepositories { group } =>
      join(["RunnerGroupAdmitsPublicRepositories: group ", to_string(group.value), " has allows_public_repositories=true"], "")
    RunnerGroupNotRestrictedToWorkflows { group } =>
      join(["RunnerGroupNotRestrictedToWorkflows: group ", to_string(group.value), " has restricted_to_workflows=false, so every workflow may use it"], "")
    RunnerGroupSelectsOtherWorkflows { group, selected, expected } =>
      join(["RunnerGroupSelectsOtherWorkflows: group ", to_string(group.value), " selected_workflows=[", join(map(selected, s => s as String), ","), "] expected=[", expected as String, "]"], "")
  }
}

type MicrovmRunnerGroupStanding
  = RunnerGroupRestrictedToWorkflow { restriction: RestrictedRunnerGroup }
  | RunnerGroupRestrictionRefused { name: NonEmptyStr, cause: RunnerGroupRestrictionRefusal }

// A group that selects the shakedown workflow AND another one is refused, not admitted: exactly one
// entry is the whole restriction, and a second entry is a second workflow whose jobs the guest takes.
// THE EXPECTED WORKFLOW IS THE CALLER'S, because the restricted groups are a roster
// (gunbc.runner_group_restriction_ensure restricted_runner_groups): the shakedown's and gunbc-private's
// heal publisher's. The authorization record still has one constructor -- this observer -- and it
// carries the workflow it was observed restricted to, so a mint cannot be handed a group observed
// for another workflow.
// THE SCOPE WALLS EVERY RESTRICTED GROUP HOLDS, whatever its workflow policy: selected visibility
// only, and no public repositories. A group holding the name with either opened is another shape and
// refuses, never adopted.
fn scope_refusal(row: RunnerGroupIdentity) -> RunnerGroupRestrictionRefusal? {
  let group = JitRunnerGroupId { value: row.id }
  match row.visibility {
    SelectedRepositories =>
      if row.allows_public_repositories { Present { value: RunnerGroupAdmitsPublicRepositories { group: group } } }
      else if !row.restricted_to_workflows { Present { value: RunnerGroupNotRestrictedToWorkflows { group: group } } }
      else { none }
    AllRepositories => Present { value: RunnerGroupVisibleBeyondSelected { group: group, visibility: AllRepositories } }
    PrivateRepositories => Present { value: RunnerGroupVisibleBeyondSelected { group: group, visibility: PrivateRepositories } }
  }
}

fn restriction_of(name: NonEmptyStr, selected_workflow: NonEmptyStr, row: RunnerGroupIdentity) -> MicrovmRunnerGroupStanding {
  match scope_refusal(row: row) {
    Present { value: cause } => RunnerGroupRestrictionRefused { name: name, cause: cause }
    Absent => restriction_of_scoped(name: name, selected_workflow: selected_workflow, row: row)
  }
}

// Reached only after scope_refusal admitted the row (selected visibility, no public repositories,
// restricted to workflows), so the one fact left to judge is which workflow it selects.
fn restriction_of_scoped(name: NonEmptyStr, selected_workflow: NonEmptyStr, row: RunnerGroupIdentity) -> MicrovmRunnerGroupStanding {
  let group = JitRunnerGroupId { value: row.id }
  let expected = selected_workflow as String
  if count(row.selected_workflows) == 1 && count(filter(row.selected_workflows, w => (w as String) == expected)) == 1 {
    RunnerGroupRestrictedToWorkflow { restriction: RestrictedRunnerGroup {
      group: group,
      name: name,
      selected_workflow: selected_workflow,
    } }
  } else {
    RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupSelectsOtherWorkflows { group: group, selected: row.selected_workflows, expected: selected_workflow } }
  }
}

fn observe_runner_group_restriction(name: NonEmptyStr, selected_workflow: NonEmptyStr, listed: RunnerGroupListDecode) -> MicrovmRunnerGroupStanding {
  match listed {
    RunnerGroupListDecodeRefused { reason } =>
      RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupListUnreadable { reason: reason } }
    RunnerGroupListDecoded { groups } => {
      let rows = filter(groups, g => (g.name as String) == (name as String))
      if count(rows) > 1 {
        RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupDuplicated { count: count(rows) } }
      } else {
        match rows.first() {
          Absent => RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupAbsent }
          Present { value: row } => restriction_of(name: name, selected_workflow: selected_workflow, row: row)
        }
      }
    }
  }
}

// The shakedown's own reading, which the microVM mint and controller consume.
// A GROUP PINNED PER ATTEMPT (gunbc.runner.runner_qualification_ref_pin) is restricted to ONE workflow
// whose ref changes every attempt: the same workflow file at refs/heads/<prefix><attempt>. So the
// expected entry is a family, not a string: exactly one selected workflow, beginning with pin_prefix,
// whose remainder is one non-empty ref segment. The scope walls are the same as every group's.
fn pinned_selected_workflow(pin_prefix: NonEmptyStr, entry: NonEmptyStr) -> Bool {
  let e = entry as String
  let p = pin_prefix as String
  starts_with(s: e, prefix: p)
    && qualification_pin_segment_in_family(segment: substring(s: e, start: string_length(s: p), end: string_length(s: e)))
}

fn observe_pinned_runner_group(name: NonEmptyStr, pin_prefix: NonEmptyStr, listed: RunnerGroupListDecode) -> MicrovmRunnerGroupStanding {
  match listed {
    RunnerGroupListDecodeRefused { reason } =>
      RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupListUnreadable { reason: reason } }
    RunnerGroupListDecoded { groups } => {
      let rows = filter(groups, g => (g.name as String) == (name as String))
      if count(rows) > 1 {
        RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupDuplicated { count: count(rows) } }
      } else {
        match rows.first() {
          Absent => RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupAbsent }
          Present { value: row } =>
            match scope_refusal(row: row) {
              Present { value: cause } => RunnerGroupRestrictionRefused { name: name, cause: cause }
              Absent =>
                match row.selected_workflows.first() {
                  Present { value: entry } =>
                    if count(row.selected_workflows) == 1 && pinned_selected_workflow(pin_prefix: pin_prefix, entry: entry) {
                      restriction_of_scoped(name: name, selected_workflow: entry, row: row)
                    } else {
                      RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupSelectsOtherWorkflows { group: JitRunnerGroupId { value: row.id }, selected: row.selected_workflows, expected: pin_prefix } }
                    }
                  Absent => RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupSelectsOtherWorkflows { group: JitRunnerGroupId { value: row.id }, selected: [], expected: pin_prefix } }
                }
            }
        }
      }
    }
  }
}

fn observe_shakedown_runner_group_restriction(name: NonEmptyStr, listed: RunnerGroupListDecode) -> MicrovmRunnerGroupStanding {
  observe_runner_group_restriction(name: name, selected_workflow: microvm_shakedown_selected_workflow(), listed: listed)
}

// THE STANDING A CALLER HOLDS BEFORE ANY READ. It is a refusal, named, so a caller that has not
// read the groups still carries a cause through to its operator rather than a bare "no".
fn runner_group_restriction_not_yet_observed(name: NonEmptyStr) -> MicrovmRunnerGroupStanding {
  RunnerGroupRestrictionRefused { name: name, cause: RunnerGroupRestrictionNotYetObserved }
}
