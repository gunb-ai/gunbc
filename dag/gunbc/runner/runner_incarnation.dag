module gunbc.runner_incarnation

import std.types { String, NonEmptyStr, Bool }
import std.nat { Nat }
import std.disposition { Disposition, SingleAuthority, Terminal }
import product.placement_supply { HostIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_index_suffix }
import gunbc.runner_unit { runner_unit_name_of_registration }
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }

data runner_incarnation_authority_disposition: Disposition = SingleAuthority

data runner_incarnation_process_identity_note: String = "LocalRunnerSlotIncarnation deliberately carries NO process/PID field today. Staleness for ReplaceRunnerIncarnation is expressed through slot, unit, unit_active, and registration_name until a live process identity producer exists. Adding a phantom process field without that producer would be specification-without-execution (DESIGN section 5). The seam witness proves the modeled fields survive HostEffect projection.\n\nTHE CARRIER THIS ROW NAMES AS ITS TRIGGER NOW EXISTS, AND THE TRIGGER IS STILL NOT FIRED. gunbc.runner_local_state models the observation this note was waiting for: RunnerListenerPopulationObservation carries the listener and worker ProcessIdentity lists for a slot, and join_runner_local_standing decides a slot's local standing from them together with the unit's own state. So the SHAPE of the missing fact is settled, and it is deliberately settled in a module of its own rather than as a field here -- what a slot HAS INSTALLED, what the MANAGER believes, what is RUNNING and what the PROVIDER thinks are four subjects that fail independently, and hanging a pid on this record would refuse them back into one carrier.\n\nWHAT IS STILL MISSING IS THE LIVE READ, AND THIS ROW MUST NOT BE READ AS SAYING OTHERWISE. gunbc.runner_local_state is a pure decode, following the split gunbc.build_cache_endpoint_observe already established: the transport-bearing reads live where a transport exists, and no such reads are wired to it yet. So this field stays absent for exactly the reason it was absent before -- a process identity on this record would still be a value nothing on a host produced. It becomes addable when a producer hands runner-slot reads to that decoder, not when the decoder was written.\n\nTHIS WAS THE THIRD INDEPENDENT DEFECT POINTING AT THE SAME MISSING SEAM. Activation readiness and incarnation-sensitive membership were the first two; overlapping JIT listeners inside one active slot's cgroup is the third, and it is the one that made the gap costly rather than theoretical."

data runner_slot_installation_state_note: String = "OBSERVED INSTALLATION STATES: SlotAbsent | SlotMaterializedNotActive | SlotCurrentlyActive. UNOBSERVED hosts carry RunnerSlotInstallationObservation::SlotInstallationUnobserved or SlotInstallationReachRefused — NEVER default to SlotAbsent (would route unobserved srv4 down extract path). vivid-eagle-131 srv3 2026-08-07: 01..05 SlotCurrentlyActive; 06/07/08 SlotMaterializedNotActive (complete tree, unit disabled+inactive; stale .runner on 06/07 harmless). srv4: ReachRefused, no slot observations. Materialized ADD may need set-property + daemon-reload + start only (scope UNRULED)."

data runner_slot_stale_runner_dot_note: String = "stale_runner_dot_present records HISTORY only (never-activated vs previously-activated). It must NOT fork the plan or block activation. Measured: jit-runner.sh does not clean .runner/.credentials before start; run.sh overwrites them.\n\nTHE HARMLESS JUDGEMENT WAS CONDITIONAL ON SOMETHING THIS ROW NEVER STATED, AND THE CONDITION HAS BEEN OBSERVED TO FAIL. Overwriting credentials at start is harmless when ONE process at a time uses the slot directory: the incoming incarnation overwrites what the departed one left, and nothing is reading the old values. It stops being harmless the moment two incarnations share the directory, because the overwrite then lands under a listener that is still running and still using them -- the survivor's session keys are replaced beneath it, and it reports a missing RSA key file and an invalid signature from that point on while remaining alive and registered.\n\nTHAT IS OBSERVED, NOT INFERRED: on 2026-08-25 srv3 and srv4 each held multiple Runner.Listener processes inside single ACTIVE runner-unit cgroups (srv3 33 listeners against 20 units, srv4 43 against 21, while srv1 and srv2 were exactly one-to-one), and the surviving listeners logged exactly that missing-key and invalid-signature pair against the shared slot directory.\n\nWHAT THIS ROW DOES AND DOES NOT NOW CLAIM. The local chain -- shared directory, overwritten credentials, invalid sessions on the survivors -- is locally proven. Whether any such stale registration was then ASSIGNED work by GitHub is NOT established: the runners API answers 403 for this repository token, so that hop has never been read. It is named here as unjoined so the next reader does not complete it from plausibility.\n\nTHE OPERATIVE CORRECTION: the overwrite is not the defect and must still not fork the plan or block activation. Overlapping incarnations are the defect, and they are what gunbc.runner_local_state MultipleListenersInOneSlot exists to make refusable. This row is kept rather than deleted because its measurement is still correct and still the reason the overlap is destructive rather than merely wasteful."

type RunnerSlotInstallationState
  = SlotAbsent {}
  | SlotMaterializedNotActive {
      install_tree_complete: Bool
      unit_active: Bool
      stale_runner_dot_present: Bool
    }
  | SlotCurrentlyActive {}

type RunnerSlotInstallationObservation
  = SlotInstallationObserved { state: RunnerSlotInstallationState }
  | SlotInstallationUnobserved { host: HostIdentity, reason: String }
  | SlotInstallationReachRefused { host: HostIdentity, reason: String }

data vivid_eagle_srv3_installation_probe_note: String = "vivid-eagle-131 read-only in-band observation 2026-08-07 via srv2->ubuntu@192.168.1.221 (no units started). srv3-01..08 dirs present; 01..05 active/running+enabled; 06/07/08 complete installs identical to 01; 06/07 .runner present (398B, Ephemeral, AgentIds 111911/111894, mtime 2026-07-21); units @06/@07 disabled+inactive; 08 same shape."

data srv4_installation_reach_refused_note: String = "srv4 NO OBSERVATION (vivid-eagle-131 2026-08-07): srv2->192.168.1.196 as briansrls/ubuntu/ghrunner and srv3 hop all Permission denied or host-key verification failed. Carry ReachRefused — do not infer slot state from srv3."

data runner_slot_installation_predicate_family_disposition: Disposition = Terminal {
  reason: "runner_slot_add_requires_incarnation_replace and the runner_slot_installation_is_* / runner_slot_installation_observation_* Bool helpers are total matches over RunnerSlotInstallationState / RunnerSlotInstallationObservation — every variant has an explicit arm, no top-level wildcard false arm. Unlike fleet_runner_connectivity connectivity_verdict_is_* (wildcard false arms, enrolled in non_fold_residue_frontier), these dissolve at authoring; NFR rows would stale the roster."
}

fn runner_slot_add_requires_incarnation_replace(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: _, unit_active: _, stale_runner_dot_present: _ } => false
    SlotCurrentlyActive {} => false
  }
}

fn runner_slot_installation_is_ready_to_activate(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: complete, unit_active: active, stale_runner_dot_present: _ } =>
      complete && !active
    SlotCurrentlyActive {} => false
  }
}

fn runner_slot_installation_is_converged(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: _, unit_active: active, stale_runner_dot_present: _ } => active
    SlotCurrentlyActive {} => true
  }
}

fn runner_slot_installation_must_not_reextract(state: RunnerSlotInstallationState) -> Bool {
  match state {
    SlotAbsent {} => false
    SlotMaterializedNotActive { install_tree_complete: complete, unit_active: _, stale_runner_dot_present: _ } =>
      complete
    SlotCurrentlyActive {} => true
  }
}

fn runner_slot_installation_observation_blocks_add(observation: RunnerSlotInstallationObservation) -> Bool {
  match observation {
    SlotInstallationObserved { state: state } =>
      match state {
        SlotCurrentlyActive {} => true
        SlotAbsent {} => false
        SlotMaterializedNotActive { install_tree_complete: complete, unit_active: active, stale_runner_dot_present: _ } =>
          !complete || active
      }
    SlotInstallationUnobserved { host: _, reason: _ } => true
    SlotInstallationReachRefused { host: _, reason: _ } => true
  }
}

fn runner_slot_installation_observation_must_not_reextract(observation: RunnerSlotInstallationObservation) -> Bool {
  match observation {
    SlotInstallationObserved { state: state } => runner_slot_installation_must_not_reextract(state: state)
    SlotInstallationUnobserved { host: _, reason: _ } => true
    SlotInstallationReachRefused { host: _, reason: _ } => true
  }
}

fn vivid_eagle_srv3_slot_installation_observation(slot_index: Nat) -> RunnerSlotInstallationObservation {
  if slot_index >= 1 && slot_index <= 5 {
    SlotInstallationObserved { state: SlotCurrentlyActive {} }
  } else if slot_index == 6 || slot_index == 7 {
    SlotInstallationObserved {
      state: SlotMaterializedNotActive {
        install_tree_complete: true,
        unit_active: false,
        stale_runner_dot_present: true,
      },
    }
  } else if slot_index == 8 {
    SlotInstallationObserved {
      state: SlotMaterializedNotActive {
        install_tree_complete: true,
        unit_active: false,
        stale_runner_dot_present: false,
      },
    }
  } else {
    SlotInstallationUnobserved {
      host: operator_host_srv3,
      reason: concat("srv3 slot index ", concat(to_string(slot_index), " not in vivid-eagle-131 probe roster")),
    }
  }
}

fn srv4_slot_installation_observation(slot_index: Nat) -> RunnerSlotInstallationObservation {
  SlotInstallationReachRefused {
    host: operator_host_srv4,
    reason: srv4_installation_reach_refused_note,
  }
}

type LocalRunnerSlotIncarnation {
  slot: RunnerSlotIdentity
  unit: NonEmptyStr
  unit_active: Bool
  registration_name: NonEmptyStr
}

fn runner_slot_incarnation(
  host: HostIdentity,
  slot_index: Nat,
  unit_active: Bool,
) -> LocalRunnerSlotIncarnation {
  let registration_name = join([host as String, "-", runner_slot_index_suffix(index: slot_index)], "") as NonEmptyStr
  LocalRunnerSlotIncarnation {
    slot: RunnerSlotIdentity { host: host, slot_index: slot_index },
    unit: runner_unit_name_of_registration(registration_name: registration_name),
    unit_active: unit_active,
    registration_name: registration_name,
  }
}

fn local_runner_slot_incarnation_fields_match(
  left: LocalRunnerSlotIncarnation,
  right: LocalRunnerSlotIncarnation,
) -> Bool {
  (left.slot.host as String) == (right.slot.host as String)
    && left.slot.slot_index == right.slot.slot_index
    && left.unit == right.unit
    && left.unit_active == right.unit_active
    && left.registration_name == right.registration_name
}
