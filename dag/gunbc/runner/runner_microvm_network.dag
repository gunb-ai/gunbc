data runner_microvm_network_disposition: Disposition = SingleAuthority

// ONE SLOT, ONE /30, AND THE PREFIX IS WHAT MAKES TAP-TO-TAP UNREACHABLE BY ARITHMETIC RATHER THAN
// BY A FIREWALL RULE. A /30 carries exactly four addresses -- network, host, guest, broadcast -- so
// a guest's own routing table contains no route to any other slot's guest. The nftables refusal
// that slice 2 also lands is the SECOND wall, for traffic that reaches the host and tries to be
// forwarded between taps; it is not the first one, and it is not the one this row provides.
//
// Choosing the subnet from the SLOT INDEX rather than allocating one is deliberate: an allocator
// needs state, and state that says which subnet a slot holds is a second authority for something
// the slot identity already determines. Two slots on one host cannot collide because their indices
// differ, and two slots on DIFFERENT hosts never share a link, so the third octet is the whole key.
data runner_microvm_network_prefix_length: Int = 30

data runner_microvm_network_octet1: Int = 172

data runner_microvm_network_octet2: Int = 30

// THE HOST HOLDS .1 AND THE GUEST HOLDS .2, which is the only assignment a /30 admits once the
// network and broadcast addresses are excluded. They are named rather than computed at each call
// site so the two never drift apart.
data runner_microvm_network_host_octet4: Int = 1

data runner_microvm_network_guest_octet4: Int = 2

type RunnerSlotNetwork {
  tap_device: NonEmptyStr
  host_address: Ipv4Address
  guest_address: Ipv4Address
  guest_mac: Eui48Address
  prefix_length: Int
}

// THE DEVICE NAME IS DERIVED AND MUST FIT, because Linux truncates nothing and refuses instead:
// IFNAMSIZ is 16 bytes including the terminator, so 15 characters is the ceiling. "gunbc-tapNN"
// is 11 characters at two digits, which leaves the derivation room the fleet will not reach.
fn runner_slot_tap_device_name(slot: RunnerSlotIdentity) -> NonEmptyStr {
  join(["gunbc-tap", to_string(slot.slot_index)], "") as NonEmptyStr
}

fn runner_slot_host_address(slot: RunnerSlotIdentity) -> Ipv4Address {
  ipv4_address(
    octet1: runner_microvm_network_octet1,
    octet2: runner_microvm_network_octet2,
    octet3: slot.slot_index,
    octet4: runner_microvm_network_host_octet4,
  )
}

fn runner_slot_guest_address(slot: RunnerSlotIdentity) -> Ipv4Address {
  ipv4_address(
    octet1: runner_microvm_network_octet1,
    octet2: runner_microvm_network_octet2,
    octet3: slot.slot_index,
    octet4: runner_microvm_network_guest_octet4,
  )
}

// A LOCALLY ADMINISTERED MAC, AND THE BIT THAT SAYS SO IS SET RATHER THAN ASSUMED. 0x02 in the
// first octet sets the locally-administered bit and clears the group bit, which is what makes this
// address one no vendor can ever be assigned -- the guarantee that matters when the fleet mints
// addresses for guests it created. extdeps.network.mac derives the scope from the octet, so the
// witness asserts LocallyAdministered rather than asserting the literal 2.
fn runner_slot_guest_mac(slot: RunnerSlotIdentity) -> Eui48Address {
  mac_address(
    octet1: 2,
    octet2: 0,
    octet3: 0,
    octet4: 0,
    octet5: 0,
    octet6: slot.slot_index,
  )
}

fn runner_slot_network(slot: RunnerSlotIdentity) -> RunnerSlotNetwork {
  RunnerSlotNetwork {
    tap_device: runner_slot_tap_device_name(slot: slot),
    host_address: runner_slot_host_address(slot: slot),
    guest_address: runner_slot_guest_address(slot: slot),
    guest_mac: runner_slot_guest_mac(slot: slot),
    prefix_length: runner_microvm_network_prefix_length,
  }
}

fn runner_slot_network_as_microvm_networking(net: RunnerSlotNetwork) -> RunnerMicroVmNetworking {
  GuestNetworkTap {
    device: net.tap_device,
    guest_mac: render_mac_address(addr: net.guest_mac),
  }
}

// THE GUEST IS CONFIGURED BY THE KERNEL COMMAND LINE AND CARRIES NO DHCP CLIENT, which removes a
// whole service from the guest and a whole failure mode from the boot. The kernel's own ip= syntax
// (Documentation/admin-guide/nfs/nfsroot.rst) is
//   ip=<client>:<server>:<gateway>:<netmask>:<hostname>:<device>:<autoconf>:<dns0>
// and the empty fields are REQUIRED separators rather than omissions -- a form with fewer colons is
// a different, silently-misparsed directive. autoconf is "off" because every field is supplied
// here; leaving it unset would have the kernel try DHCP anyway and stall the boot on a link where
// nothing answers.
// THE NETMASK IS DERIVED FROM THE PREFIX, NOT SPELLED BESIDE IT (review 61223). "255.255.255.252"
// and prefix_length 30 are two spellings of ONE fact, and only one of them would move if the fleet
// ever re-prefixed: the host's .network file would carry the new CIDR while the guest's kernel ip=
// line kept the old mask, and the guest would boot with a subnet that disagrees with its own
// gateway's. Nothing refuses that -- the guest simply cannot reach the host.
//
// The kernel's ip= directive takes a DOTTED QUAD and not a prefix, so the conversion has to happen
// somewhere; doing it here from the single prefix row is what keeps it one fact.
//
// mask_octet is total over the 9 reachable bit-counts rather than computed with a shift, because
// each arm is the actual mask byte for that many leading ones and a wrong arm is visible by
// inspection. There is no arm for a bit count outside 0..8: octet_mask_bits cannot produce one.
fn mask_octet(bits: Int) -> Int {
  if bits <= 0 { 0 }
  else if bits == 1 { 128 }
  else if bits == 2 { 192 }
  else if bits == 3 { 224 }
  else if bits == 4 { 240 }
  else if bits == 5 { 248 }
  else if bits == 6 { 252 }
  else if bits == 7 { 254 }
  else { 255 }
}

fn octet_mask_bits(prefix: Int, index: Int) -> Int {
  let consumed = 8 * (index - 1)
  let remaining = prefix - consumed
  if remaining <= 0 { 0 } else if remaining >= 8 { 8 } else { remaining }
}

fn netmask_of_prefix(prefix: Int) -> Ipv4Address {
  ipv4_address(
    octet1: mask_octet(bits: octet_mask_bits(prefix: prefix, index: 1)),
    octet2: mask_octet(bits: octet_mask_bits(prefix: prefix, index: 2)),
    octet3: mask_octet(bits: octet_mask_bits(prefix: prefix, index: 3)),
    octet4: mask_octet(bits: octet_mask_bits(prefix: prefix, index: 4)),
  )
}

data runner_microvm_network_guest_interface: NonEmptyStr = "eth0" as NonEmptyStr

data runner_microvm_network_autoconf_off: NonEmptyStr = "off" as NonEmptyStr

fn runner_slot_guest_ip_boot_arg(net: RunnerSlotNetwork) -> String {
  join([
    "ip=",
    render_ipv4_address(addr: net.guest_address) as String,
    "::",
    render_ipv4_address(addr: net.host_address) as String,
    ":",
    render_ipv4_address(addr: netmask_of_prefix(prefix: net.prefix_length)) as String,
    "::",
    runner_microvm_network_guest_interface as String,
    ":",
    runner_microvm_network_autoconf_off as String,
    ":",
    render_ipv4_address(addr: runner_microvm_guest_resolver()) as String,
  ], "")
}

// --- the host ruleset ---

data runner_microvm_tap_device_prefix: NonEmptyStr = "gunbc-tap" as NonEmptyStr

// THE WHOLE MICRO-VM RANGE IN ONE PREFIX, so the NAT rule is one row rather than one per slot. Every
// slot's /30 sits inside 172.30.0.0/16 by the derivation above, so source-matching the /16 covers a
// slot that does not exist yet and needs no edit when the roster grows.
// THE SUPERNET IS BUILT FROM THE SAME OCTET ROWS THE SLOTS USE (review 61223). The prose above
// already states the derivation -- every slot's /30 sits inside it -- and the previous row then
// re-minted that as a bare literal, which is the §3 fork the prose was describing. The failure is
// worse than a stale comment: moving runner_microvm_network_octet2 relocates every slot's network
// while the NAT rule keeps matching the OLD /16, so guest traffic stops being masqueraded and the
// symptom is "the guests have no internet" with every per-slot row looking correct.
data runner_microvm_network_supernet_prefix: Int = 16

fn runner_microvm_network_supernet_address() -> Ipv4Address {
  ipv4_address(
    octet1: runner_microvm_network_octet1,
    octet2: runner_microvm_network_octet2,
    octet3: 0,
    octet4: 0,
  )
}

fn runner_microvm_network_supernet() -> NonEmptyStr {
  join([
    render_ipv4_address(addr: runner_microvm_network_supernet_address()) as String,
    "/",
    to_string(runner_microvm_network_supernet_prefix),
  ], "") as NonEmptyStr
}

data runner_microvm_nft_table_name: NonEmptyStr = "gunbc_microvm" as NonEmptyStr

// THE FORWARD CHAIN'S POLICY IS ACCEPT, AND MAKING IT DROP WOULD HAVE TAKEN THE HOST DOWN.
//
// nftables is not iptables here: when several tables hook the same point, ALL of them run and ANY
// drop wins. srv2 was measured on 2026-09-06 running an active dockerd alongside `table ip filter`,
// `table ip nat`, `table ip mangle` and their ip6 counterparts. A new forward chain with
// `policy drop` would therefore have dropped every packet docker forwards, because our chain's
// default verdict applies to traffic that has nothing to do with this fleet's guests.
//
// So the default is ACCEPT and the isolation is stated as an EXPLICIT DROP of exactly the case that
// must never happen -- tap to tap. That is narrower than a default-closed chain and it is the only
// form that composes with a host we do not own the whole network policy of.
//
// It is also the SECOND wall, not the first: a slot's /30 gives a guest no route to any other
// slot's guest at all (see the prefix row above), so this rule catches traffic that reached the
// host and asked to be forwarded between taps. Both exist because they fail differently -- the
// prefix is arithmetic and cannot be flushed, this rule survives a guest that sets its own routes.
fn runner_microvm_forward_chain(host: HostEgressGrain) -> NftChain {
  NftChain {
    name: "forward" as NonEmptyStr,
    chain_type: NftTypeFilter,
    hook: NftForward,
    priority: NftPriorityFilter,
    policy: forward_chain_policy(g: host.forward),
    rules: concat(
      concat(
        [
          NftRule {
            matches: [
              NftInputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix },
              NftOutputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix },
            ],
            verdict: NftDrop,
          },
        ],
        tap_bound_ipv6_rules(v: host.ipv6),
      ),
      guest_egress_rules(p: runner_microvm_guest_egress_policy, host: host),
    ),
  }
}

// --- guest egress: ONE typed policy, and the rules are folded from it ---

// THE POLICY IS DATA AND THE RULESET IS ITS PROJECTION. An earlier revision of this change wrote the
// rule list by hand and joined it to gunbc.runner.runner_host_filtered_egress's policy with a
// comment, which let the two disagree (review 68173). The policy now lives here, typed, because that
// module already imports this one -- declaring it there would make this module's consumption an
// import cycle -- and runner_host_filtered_egress consumes these rows instead of restating them.
//
// THE GRAIN IS A FIELD, NOT A COMMENT. A host that owns its whole forwarding policy can default-drop
// at the chain; a host where other tables hook forward (srv2's dockerd) cannot, because every table
// runs and any drop wins. There the default-deny is the LAST RULE OF A TAP-SCOPED LIST, and a packet
// that did not enter through a gunbc tap matches no row here.
type ForwardDenyGrain
  = HostChainDefaultDrop
  | TapScopedFinalDrop { chain_policy_reason: NonEmptyStr }

// IPv6 IS AN EXPLICIT STANDING RATHER THAN AN OVERSIGHT. An IPv4-only ruleset on a dual-stack host is
// a default-allow wearing a default-deny's name. In the inet family an `ip daddr` match is false on
// a v6 packet, so v4 rows never see v6 at all: under DefaultDenyRuleset v6 is refused by its own
// rows, in both directions of the tap (raw_ipv6_rules, tap_bound_ipv6_rules), and the tap's
// disable_ipv6 closes the link underneath them.
type IpV6Standing
  = IpV6DisabledOnDataPath
  | IpV6DefaultDenyRuleset
  | IpV6Unaddressed { risk: NonEmptyStr }

// A GRANT NAMES ITS DESTINATION. "Any destination the denials left" and "the one resolver" are
// materially different grants on the same port, so the difference is a constructor, not a reading.
type GuestEgressDestination
  = AnyUndeniedDestination
  | NamedDestination { address: Ipv4Address }

type GuestEgressGrant {
  transport: NftTransport
  port: Port
  destination: GuestEgressDestination
}

// WHAT A GUEST MAY REACH IS SHARED BY EVERY HOST; HOW A HOST ENFORCES IT IS NOT. The grants and
// denials are one row for the fleet. The forward grain and the IPv6 standing are facts about ONE
// host -- whether it owns its forward chain, whether v6 is off on its data path -- so each host
// supplies its own HostEgressGrain, and no host's row carries another host's values (review 68199).
// THE INPUT HOOK IS PART OF WHAT A GUEST MAY REACH. Traffic a guest sends to the HOST's own addresses
// -- sshd, the dockerd socket, any local listener -- never traverses forward, so a policy projected
// only into forward would deny 172.16.0.0/12 in its type while the host's tap address in that range
// stayed reachable (review 68590). Each host states its input grain the same way it states its
// forward grain, and the fold realizes both.
type HostEgressGrain {
  forward: ForwardDenyGrain
  input: ForwardDenyGrain
  ipv6: IpV6Standing
}

type GuestEgressPolicy {
  denied_destinations: List<Ipv4Prefix>
  grants: List<GuestEgressGrant>
}

// THE RESOLVER IS ONE NAMED PUBLIC ADDRESS. 1.1.1.1 is the resolver the Mt. Collins filtered-egress
// run answered through (gunbc.runner.runner_filtered_egress_receipt admitted_paths, guest-dns); it is
// public, so the private-range denials never shadow it. The guest is told it at boot as the ip=
// directive's dns0 field, so the grant and the guest's configuration are one row.
fn runner_microvm_guest_resolver() -> Ipv4Address {
  ipv4_address(octet1: 1, octet2: 1, octet3: 1, octet4: 1)
}

// THE SHARED RUNNER HOSTS (srvN). Other tables hook forward there (dockerd on srv2) and every table
// runs with any drop winning, so the default-deny is the tap-scoped final drop; v6 is not disabled on
// their data path, so it is filtered.
data runner_microvm_shared_host_grain: HostEgressGrain = HostEgressGrain {
  forward: TapScopedFinalDrop {
    chain_policy_reason: "other tables hook forward on srvN (dockerd on srv2) and every table runs with any drop winning, so a chain-level drop would drop traffic this fleet does not own" as NonEmptyStr,
  },
  input: TapScopedFinalDrop {
    chain_policy_reason: "the shared hosts run their own services and other tables hook input, so a chain-level drop would cut traffic this fleet does not own" as NonEmptyStr,
  },
  ipv6: IpV6DefaultDenyRuleset,
}

data runner_microvm_guest_dns_port: Port = 53

data runner_microvm_guest_tls_port: Port = 443

// TCP 443 IS A DESTINATION CLASS, NOT "GITHUB ONLY": github.com and the Actions endpoints are
// CDN-fronted, so a static address list is stale when written. The narrow form is an egress proxy.
data runner_microvm_guest_egress_policy: GuestEgressPolicy = GuestEgressPolicy {
  denied_destinations: [
    ipv4_prefix(o1: 10, o2: 0, o3: 0, o4: 0, length: 8),
    ipv4_prefix(o1: 172, o2: 16, o3: 0, o4: 0, length: 12),
    ipv4_prefix(o1: 192, o2: 168, o3: 0, o4: 0, length: 16),
    ipv4_prefix(o1: 100, o2: 64, o3: 0, o4: 0, length: 10),
    ipv4_prefix(o1: 169, o2: 254, o3: 0, o4: 0, length: 16),
    ipv4_prefix(o1: 127, o2: 0, o3: 0, o4: 0, length: 8),
    ipv4_prefix(o1: 224, o2: 0, o3: 0, o4: 0, length: 4),
  ],
  grants: [
    GuestEgressGrant { transport: NftUdp, port: runner_microvm_guest_dns_port, destination: NamedDestination { address: runner_microvm_guest_resolver() } },
    GuestEgressGrant { transport: NftTcp, port: runner_microvm_guest_dns_port, destination: NamedDestination { address: runner_microvm_guest_resolver() } },
    GuestEgressGrant { transport: NftTcp, port: runner_microvm_guest_tls_port, destination: AnyUndeniedDestination },
  ],
}

fn from_guest_tap(m: List<NftMatch>, verdict: NftVerdict) -> NftRule {
  NftRule {
    matches: concat([NftInputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix }], m),
    verdict: verdict,
  }
}

fn grant_destination_matches(d: GuestEgressDestination) -> List<NftMatch> {
  match d {
    AnyUndeniedDestination => []
    NamedDestination { address: a } =>
      [NftDestinationAddressPrefix { cidr: render_ipv4_cidr(addr: a, prefix: 32) }]
  }
}

fn grant_rule(g: GuestEgressGrant) -> NftRule {
  from_guest_tap(
    m: concat(grant_destination_matches(d: g.destination), [NftTransportDestinationPort { transport: g.transport, port: g.port }]),
    verdict: NftAccept,
  )
}

// THE TAP-SCOPED DEFAULT-DENY COVERS BOTH DIRECTIONS OF THE TAP. From a tap: everything no grant
// admitted. Toward a tap: everything the reply-direction established accept above did not admit --
// a new flow routed to a guest from the uplink or any other interface would otherwise fall through
// to the chain's accept policy (review 68643). Guest flows still complete, because their replies
// match that established accept before reaching this row. Under HostChainDefaultDrop the chain policy
// is already the drop for both directions.
fn final_drop_rules(g: ForwardDenyGrain) -> List<NftRule> {
  match g {
    TapScopedFinalDrop { chain_policy_reason: _ } => [
      from_guest_tap(m: [], verdict: NftDrop),
      NftRule { matches: [NftOutputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix }], verdict: NftDrop },
    ]
    HostChainDefaultDrop => []
  }
}

fn forward_chain_policy(g: ForwardDenyGrain) -> NftPolicy {
  match g {
    TapScopedFinalDrop { chain_policy_reason: _ } => NftPolicyAccept
    HostChainDefaultDrop => NftPolicyDrop
  }
}

// REPLIES ARE ADMITTED IN THEIR OWN DIRECTION. A reply to a guest's flow enters on the uplink and
// leaves on the tap, so an established rule matching only the tap as INPUT never sees it. Under a
// tap-scoped grain the chain's accept policy happened to carry replies; under HostChainDefaultDrop
// the chain policy drops them and no guest flow would complete (review 68199). So the reply rule is
// emitted on every grain, and nothing reaches a tap unsolicited under a dropping chain.
//
// THE ORDER IS THE POLICY. Replies TO a tap first: they belong to flows a grant already admitted.
// Then the invariant denials, ABOVE every accept that starts from a tap -- including the guest-side
// established accept, because an established or related flow toward a denied range (a related ICMP,
// a flow that predates a ruleset change) must still be refused (sunny-ant-606 ruling on #11675). Then
// the guest-side established accept, the grants, and the grain's final drop. The denials sit above
// the 443 grant because that grant is a class and 192.168.x.y:443 is in it (the Mt. Collins receipt's
// denied_paths is this ordering holding). v6 never reaches this chain; see raw_ipv6_rules.
fn guest_egress_rules(p: GuestEgressPolicy, host: HostEgressGrain) -> List<NftRule> {
  concat(
    concat(
      concat(
        concat(
          [
            NftRule {
              matches: [NftOutputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix }, NftConnectionTrackingEstablished],
              verdict: NftAccept,
            },
          ],
          map(p.denied_destinations, c => from_guest_tap(m: [NftDestinationAddressPrefix { cidr: render_ipv4_prefix(p: c) }], verdict: NftDrop)),
        ),
        [from_guest_tap(m: [NftConnectionTrackingEstablished], verdict: NftAccept)],
      ),
      map(p.grants, g => grant_rule(g: g)),
    ),
    final_drop_rules(g: host.forward),
  )
}

// v6 IS REFUSED IN EACH DIRECTION OF THE TAP BY ITS OWN RULE, AND THE LINK IS CLOSED BENEATH THEM.
// FROM a tap: a raw-priority drop in prerouting, before connection tracking (-300 < -200), so no v6
// flow a guest opens is ever tracked -- and it covers v6 the guest sends to the host, which forward
// never sees. TOWARD a tap: an oifname drop in forward (v6 routed from another interface) and in
// output (v6 the host itself sends), because a prerouting rule matching iifname cannot see either
// (review 68618). These run after conntrack, so they refuse delivery rather than prevent tracking;
// what keeps a tap-bound v6 flow from existing at all is the tap's disable_ipv6 -- no v6 address, no
// v6 route through it -- which the sanitation subject requires and every attempt re-reads. The rules
// are the second wall, and each names the direction it covers.
fn raw_ipv6_rules(v: IpV6Standing) -> List<NftRule> {
  match v {
    IpV6DefaultDenyRuleset => [from_guest_tap(m: [NftNetworkProtocolIpv6], verdict: NftDrop)]
    IpV6DisabledOnDataPath => []
    IpV6Unaddressed { risk: _ } => []
  }
}

fn tap_bound_ipv6_rules(v: IpV6Standing) -> List<NftRule> {
  match v {
    IpV6DefaultDenyRuleset => [
      NftRule {
        matches: [NftOutputInterfaceWildcard { prefix: runner_microvm_tap_device_prefix }, NftNetworkProtocolIpv6],
        verdict: NftDrop,
      },
    ]
    IpV6DisabledOnDataPath => []
    IpV6Unaddressed { risk: _ } => []
  }
}

// THE HOST'S OWN TRAFFIC TOWARD A TAP. Output carries only the tap-bound v6 refusal; everything else
// the host sends keeps whatever the host's other tables decide, so the chain's policy is accept.
fn runner_microvm_output_chain(host: HostEgressGrain) -> NftChain {
  NftChain {
    name: "output" as NonEmptyStr,
    chain_type: NftTypeFilter,
    hook: NftOutput,
    priority: NftPriorityFilter,
    policy: NftPolicyAccept,
    rules: tap_bound_ipv6_rules(v: host.ipv6),
  }
}

// A GUEST REACHES NOTHING ON THE HOST. It resolves through a public resolver and fetches over the
// forward path, so no host-local service is one it needs: from a tap, input accepts only replies to
// flows the host itself opened and drops the rest, on every grain. A host that owns its whole input
// policy (HostChainDefaultDrop) additionally drops at the chain and so admits its own loopback and
// replies explicitly -- the two input rows the Mt. Collins receipt read back.
fn input_chain_rules(g: ForwardDenyGrain) -> List<NftRule> {
  concat(
    match g {
      HostChainDefaultDrop => [
        NftRule { matches: [NftInputInterface { device: "lo" as NonEmptyStr }], verdict: NftAccept },
        NftRule { matches: [NftConnectionTrackingEstablished], verdict: NftAccept },
      ]
      TapScopedFinalDrop { chain_policy_reason: _ } => []
    },
    [
      from_guest_tap(m: [NftConnectionTrackingEstablished], verdict: NftAccept),
      from_guest_tap(m: [], verdict: NftDrop),
    ],
  )
}

fn runner_microvm_input_chain(host: HostEgressGrain) -> NftChain {
  NftChain {
    name: "input" as NonEmptyStr,
    chain_type: NftTypeFilter,
    hook: NftInput,
    priority: NftPriorityFilter,
    policy: forward_chain_policy(g: host.input),
    rules: input_chain_rules(g: host.input),
  }
}

fn runner_microvm_raw_prerouting_chain(host: HostEgressGrain) -> NftChain {
  NftChain {
    name: "raw_prerouting" as NonEmptyStr,
    chain_type: NftTypeFilter,
    hook: NftPrerouting,
    priority: NftPriorityRaw,
    policy: NftPolicyAccept,
    rules: raw_ipv6_rules(v: host.ipv6),
  }
}

// THE MASQUERADE MATCHES ON SOURCE AND NOT ON OUTPUT INTERFACE, which removes an observation this
// module would otherwise have to make and keep correct. srv2's uplink is enP3p3s0f1 and srv1's is
// not; naming it would make the ruleset host-specific and would rot the moment an interface is
// renamed by a firmware update or a NIC swap. Source-matching the fleet's own supernet is exact --
// only guest traffic carries those addresses -- and it is identical on every host.
fn runner_microvm_postrouting_chain() -> NftChain {
  NftChain {
    name: "postrouting" as NonEmptyStr,
    chain_type: NftTypeNat,
    hook: NftPostrouting,
    priority: NftPrioritySrcnat,
    policy: NftPolicyAccept,
    rules: [
      NftRule {
        matches: [NftSourceAddressPrefix { cidr: runner_microvm_network_supernet() }],
        verdict: NftMasquerade,
      },
    ],
  }
}

fn runner_microvm_nft_table(host: HostEgressGrain) -> NftTable {
  NftTable {
    family: NftInet,
    name: runner_microvm_nft_table_name,
    chains: [runner_microvm_raw_prerouting_chain(host: host), runner_microvm_input_chain(host: host), runner_microvm_forward_chain(host: host), runner_microvm_output_chain(host: host), runner_microvm_postrouting_chain()],
  }
}

fn runner_microvm_nft_ruleset_text_for(host: HostEgressGrain) -> String {
  nft_table_wire(t: runner_microvm_nft_table(host: host))
}

// THE RULESET IS HOST STATE AND ITS INSTALLER TAKES THE HOST'S OWN GRAIN. The per-attempt launch
// plan carried a ruleset until review 68256: an attempt is not the owner of a host-wide table (parent
// ruling A, 2026-09-19), and a plan with no host identity could only ever render one host's grain.
// The installer is the host converge, which knows which host it is converging.
//
// DECLARED FRONTIER (DESIGN 3c). NAMED CONSUMER: the microVM host converge (the microvm_host_converge
// fleet-converge mode) installing the table on srvN. TRIGGER: that converge installs
// runner_microvm_nft_ruleset_text_for(host: <the converged host's HostEgressGrain>), reads the
// listing back with runner_microvm_nft_list_command and records its digest as the converged digest
// slot_network_readback compares against. SUFFICIENT FOR deleting this row. NOT satisfied by a
// witness folding a grain, and not by any per-attempt step installing a table.
data host_ruleset_installer_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_microvm_network_apply, which HAS LANDED -- it installs this ruleset as the host administrator over the fleet SSH edge and reads the listing back. microvm_network_observe still reads and records and installs NOTHING, because granting the job user install+restart over files it also stages would be granting root (review 69104). WHAT REMAINS: no run has dispatched that apply mode, so no ruleset has been installed on any host and no listing has been read back as the converged digest. TRIGGER: the capability named by microvm_network_host_mutation_principal_frontier holds and that route installs runner_microvm_nft_ruleset_text_for(the host's HostEgressGrain), reads the listing back with runner_microvm_nft_list_command, and records that digest as the converged digest slot_network_readback compares against. SUFFICIENT FOR deleting this row. NOT satisfied by the observe mode running, by the fold existing, or by a witness folding a grain." as NonEmptyStr,
)

fn runner_microvm_shared_host_nft_ruleset_text() -> String {
  runner_microvm_nft_ruleset_text_for(host: runner_microvm_shared_host_grain)
}


// --- the tap as DECLARED STATE, not as a command someone ran ---

// THE TAP IS A systemd-networkd FILE AND NOT AN `ip tuntap` INVOCATION, and the first draft of this
// module got that wrong in a way worth recording: it modeled the MANUAL PROCEDURE -- five privileged
// operations and two new binary grants (ip, nft) -- because that is how an operator creates a tap by
// hand. srv2 was then measured (2026-09-06) running systemd-networkd enabled and active, managing
// the uplink through netplan-generated units. A tap is therefore a .netdev file, its address a
// .network file, and both are FILE INSTALLS -- an operation this fleet already grants.
//
// The whole slice collapsed to two operations on binaries already in the sudoers roster, and the
// authorization surface SHRANK rather than grew. The lesson generalizes: reaching for the command
// an operator would type models the procedure, not the fact.
//
// It is also better than the commands were. A tap created by `ip tuntap add` exists until the next
// reboot and then silently does not; a .netdev is what the host IS, reasserted at every boot with
// no converge run at all.
data runner_microvm_networkd_dir: NonEmptyStr = "/etc/systemd/network" as NonEmptyStr

data runner_microvm_networkd_unit: NonEmptyStr = "systemd-networkd" as NonEmptyStr

// THE ORDERING DEPENDENCY NAMES THE UNIT FILE, NOT THE systemctl ARGUMENT. `systemctl reload
// systemd-networkd` resolves the short name, but After=/Wants= in a unit file take the unit's full
// name, so the two spellings are derived from one row rather than authored twice.
data runner_microvm_networkd_unit_name: NonEmptyStr = "systemd-networkd.service" as NonEmptyStr

data runner_microvm_networkd_file_mode: NonEmptyStr = "0644" as NonEmptyStr

data runner_microvm_networkd_file_owner: NonEmptyStr = "root" as NonEmptyStr

// THE FILENAME CARRIES THE DEVICE, so one slot's units cannot land on another's path, and the
// numeric prefix is systemd's ordering convention rather than decoration -- networkd applies files
// in lexical order and a later file wins, so an unprefixed name would order unpredictably against
// netplan's own 10- files.
fn runner_slot_netdev_path(net: RunnerSlotNetwork) -> String {
  join([runner_microvm_networkd_dir as String, "/50-", net.tap_device as String, ".netdev"], "")
}

fn runner_slot_network_file_path(net: RunnerSlotNetwork) -> String {
  join([runner_microvm_networkd_dir as String, "/50-", net.tap_device as String, ".network"], "")
}

// THE USER= FIELD IS WHAT MAKES THE TAP OPENABLE WITHOUT PRIVILEGE, and it is the whole reason the
// per-JOB path spends no grant at all. networkd creates the device owned by that user at boot; the
// executor then opens it for every guest it launches, forever, with no sudo in the job path.
fn runner_slot_netdev_text(net: RunnerSlotNetwork, owner: NonEmptyStr) -> String {
  join([
    "[NetDev]\n",
    "Name=", net.tap_device as String, "\n",
    "Kind=tap\n",
    "\n",
    "[Tap]\n",
    "User=", owner as String, "\n",
  ], "")
}

// ConfigureWithoutCarrier IS REQUIRED AND IS NOT A TUNING KNOB. A tap has no carrier until a guest
// opens it, so without this networkd leaves the address unassigned and the host has no route to a
// guest that has not booted yet -- which is every guest, at the moment the VM is configured.
fn runner_slot_network_file_text(net: RunnerSlotNetwork) -> String {
  join([
    "[Match]\n",
    "Name=", net.tap_device as String, "\n",
    "\n",
    "[Network]\n",
    "Address=", runner_slot_host_cidr(net: net), "\n",
    "ConfigureWithoutCarrier=yes\n",
  ], "")
}

// THE CONNECTED ROUTE IS OVER THE NETWORK ADDRESS, NOT THE HOST'S OWN. `ip -o -4 route show dev tap`
// prints `172.30.N.0/30 proto kernel scope link src 172.30.N.1`: the destination is the NETWORK and
// the host address appears only as the source. A readback matching the host address with a prefix
// would never hit, so a correctly configured tap would read as SlotRouteNotHeld (side-chat hold on
// #11751). The network address is derived here, beside the addresses it shares its octets with, so
// the route matcher and the address authority cannot drift.
fn runner_slot_subnet(net: RunnerSlotNetwork) -> Ipv4Prefix {
  ipv4_prefix(
    o1: net.host_address.octet1,
    o2: net.host_address.octet2,
    o3: net.host_address.octet3,
    o4: 0,
    length: net.prefix_length,
  )
}

fn runner_slot_host_cidr(net: RunnerSlotNetwork) -> String {
  join([
    render_ipv4_address(addr: net.host_address) as String,
    "/",
    to_string(net.prefix_length),
  ], "")
}

// THE SLOT'S NETWORK FILES ARE ENUMERATED HERE AND NOWHERE ELSE. The v6 sysctl file is one of them:
// leaving it out made the fold say two files while the converge frontier's prose said three, so the
// converge would either install no disable_ipv6 -- and then every slot refuses sanitation subject
// construction, since that requires the tap's v6 read back disabled -- or author its own list beside
// this one (review 68660).
//
// THE OPERATIONS ARE INSTALLS AND ONE RELOAD, and every one of them converges: installing a file
// that is already byte-identical changes nothing, and reload re-reads without tearing a link down.
// There is no non-idempotent arm left to guard, which is why the observe-then-act standing the
// previous draft needed is GONE rather than ported -- the earlier draft needed it because
// `ip tuntap add` fails on an existing device, and no operation here has that shape.
fn runner_slot_network_install_operations(
  net: RunnerSlotNetwork,
  staged_netdev: NonEmptyStr,
  staged_network: NonEmptyStr,
  staged_ipv6_sysctl: NonEmptyStr,
) -> List<ExecutorPrivilegedOperation> {
  [
    InstallFile {
      source: staged_netdev,
      destination: runner_slot_netdev_path(net: net) as NonEmptyStr,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    InstallFile {
      source: staged_network,
      destination: runner_slot_network_file_path(net: net) as NonEmptyStr,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    InstallFile {
      source: staged_ipv6_sysctl,
      destination: runner_slot_ipv6_sysctl_path(net: net) as NonEmptyStr,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    SystemdReloadUnit { unit: runner_microvm_networkd_unit },
  ]
}

// --- the host's own network files: the ruleset, its loader unit, and forwarding ---

// THE RULESET IS A FILE LOADED BY A ONESHOT UNIT, WHICH IS WHY THE CONVERGE NEEDS NO nft GRANT TO
// APPLY IT. The unit runs as root and its ExecStart is the only nft invocation in the fleet's apply
// path; the converge's own authority is limited to installing files and driving systemctl, verbs it
// already holds. It is also what makes the ruleset survive a reboot without a converge run.
//
// RESTART, NOT START. `nft -f` on a file that begins by replacing its own table converges, so
// re-running it is safe -- and a RemainAfterExit oneshot that is already active ignores `start`, so
// a converge that installed new bytes and then started the unit would report success over the OLD
// live ruleset.
data runner_microvm_nft_ruleset_path: NonEmptyStr = "/etc/gunbc/microvm.nft" as NonEmptyStr

data runner_microvm_nft_unit: NonEmptyStr = "gunbc-microvm-nft.service" as NonEmptyStr

data runner_microvm_systemd_unit_dir: NonEmptyStr = "/etc/systemd/system" as NonEmptyStr

fn runner_microvm_nft_unit_path() -> String {
  join([runner_microvm_systemd_unit_dir as String, "/", runner_microvm_nft_unit as String], "")
}

// THE UNIT IS A MODELED SystemdUnitFile, NOT CONCATENATED INI. extdeps.systemd.unit_file owns that
// syntax -- its sections, its separators, its terminating newline -- and gunbc.build_cache_unit
// already records what happens when a consumer re-mints it: a second authority for systemd's own
// file format, the DESIGN section 3 nicknaming that module exists to prevent (review 69082). The one
// directive it lacked, RemainAfterExit=, is now a row there rather than a literal here.
//
// After= networkd, because the ruleset's rules name tap devices networkd creates; nft accepts rules
// for a device that does not exist yet, but ordering it after removes the window where a tap is up
// and unfiltered.
fn runner_microvm_nft_unit_file() -> SystemdUnitFile {
  ServiceUnitFile {
    unit: [
      Description { text: "gunbc microVM host ruleset" as NonEmptyStr },
      After { target: runner_microvm_networkd_unit_name },
      Wants { target: runner_microvm_networkd_unit_name },
    ],
    service: [
      ServiceType { mode: OneshotMode },
      RemainAfterExit { active: true },
      ExecStart {
        command: join([fleet_nft_binary_path as String, " -f ", runner_microvm_nft_ruleset_path as String], "") as NonEmptyStr,
      },
    ],
    install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
  }
}

fn runner_microvm_nft_unit_text() -> String {
  serialize_systemd_unit_file(file: runner_microvm_nft_unit_file())
}

// FORWARDING IS WHAT MAKES THE TAP A ROUTED LINK RATHER THAN A DEAD END. Without it the guest's
// packets reach the host and stop, and the masquerade never runs.
data runner_microvm_forward_sysctl_path: NonEmptyStr = "/etc/sysctl.d/50-gunbc-microvm-forward.conf" as NonEmptyStr

data runner_microvm_ip_forward_proc_path: NonEmptyStr = "/proc/sys/net/ipv4/ip_forward" as NonEmptyStr

fn runner_microvm_forward_sysctl_text() -> String {
  "net.ipv4.ip_forward = 1\n"
}

data runner_microvm_sysctl_unit: NonEmptyStr = "systemd-sysctl.service" as NonEmptyStr

// THE HOST'S OPERATIONS, IN THE ORDER THEY DEPEND ON EACH OTHER: the files first, then the daemon
// reload that makes systemd see a new unit, then the sysctl re-read, then enable (so it survives a
// reboot) and restart (so the bytes just installed are the live ones).
fn runner_microvm_host_network_install_operations(
  staged_ruleset: NonEmptyStr,
  staged_unit: NonEmptyStr,
  staged_forward_sysctl: NonEmptyStr,
) -> List<ExecutorPrivilegedOperation> {
  [
    InstallFile {
      source: staged_ruleset,
      destination: runner_microvm_nft_ruleset_path,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    InstallFile {
      source: staged_unit,
      destination: runner_microvm_nft_unit_path() as NonEmptyStr,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    InstallFile {
      source: staged_forward_sysctl,
      destination: runner_microvm_forward_sysctl_path,
      owner: runner_microvm_networkd_file_owner,
      group: runner_microvm_networkd_file_owner,
      mode: runner_microvm_networkd_file_mode,
    },
    SystemdDaemonReload,
    SystemdRestartUnit { unit: runner_microvm_sysctl_unit },
    SystemdEnableUnit { unit: runner_microvm_nft_unit },
    SystemdRestartUnit { unit: runner_microvm_nft_unit },
  ]
}

// --- the slot network readback: what sanitation reads after an attempt ---

// THE TAP AND THE RULESET OUTLIVE THE ATTEMPT BY DESIGN, SO SANITATION CANNOT PROVE THEM ABSENT.
// They are slot and host state (the .netdev block above; parent ruling on the microVM program,
// 2026-09-19), and what an attempt can leave behind in them is not their existence but their USE:
// a process still holding the tap, connection-tracking flows, expectations or a neighbour entry
// keyed to the guest address the NEXT attempt in this slot will reuse, and a ruleset or tap setting
// that drifted from the converge receipt. Its consumer is not on main yet; see
// slot_network_readback_consumer_frontier below.
//
// CONNTRACK IS FLUSHED BEFORE IT IS READ, AND THE FLUSH IS NOT THE EVIDENCE. The flush is teardown's
// mutation; the reading after it is the fact. A flush that exited zero while a flow survived -- a
// packet from a still-running guest re-creates one -- is exactly the case the read exists to catch.
//
// THE RULESET DIGEST IS OF `nft list table`, NOT OF THE FILE WE APPLIED. nft normalizes what it is
// given, so the text above and the kernel's listing differ in bytes while agreeing in meaning. The
// converged digest is therefore the listing captured by the converge that installed the table, and
// it is supplied here from that receipt rather than recomputed from the rule rows.

// --- IPv6: disabled structurally on both ends of the link ---

// v6 IS OFF ON THE TAP AND IN THE GUEST, SO THERE IS NO v6 PATH TO FILTER. A drop rule covers only the
// paths it names (sunny-ant-606 ruling on #11675), so the rules name each direction -- from a tap at
// raw prerouting, toward a tap in forward and output (raw_ipv6_rules, tap_bound_ipv6_rules). With
// disable_ipv6=1 on the tap the kernel assigns it no v6 address, installs no v6 route through it, and
// discards v6 received on it -- every direction at once, as a property of the link. The rules are the
// second wall, and the guest boots with ipv6.disable=1 so it never builds a v6 stack at all.
//
// THE HOST SETTING IS A sysctl.d FILE, not a command. systemd's udev rules re-run systemd-sysctl for
// each net device as it appears, so a per-device key applies when networkd creates the tap at boot
// and stays applied across reboots -- the same reason the tap itself is a .netdev.
data runner_microvm_sysctl_dir: NonEmptyStr = "/etc/sysctl.d" as NonEmptyStr

fn runner_slot_ipv6_sysctl_path(net: RunnerSlotNetwork) -> String {
  join([runner_microvm_sysctl_dir as String, "/50-", net.tap_device as String, "-ipv6.conf"], "")
}

fn runner_slot_ipv6_sysctl_text(net: RunnerSlotNetwork) -> String {
  join(["net.ipv6.conf.", net.tap_device as String, ".disable_ipv6 = 1\n"], "")
}

// The kernel's live value, which is what a readback reads -- the file above is the intent.
fn runner_slot_ipv6_disabled_proc_path(net: RunnerSlotNetwork) -> String {
  join(["/proc/sys/net/ipv6/conf/", net.tap_device as String, "/disable_ipv6"], "")
}

data runner_microvm_guest_ipv6_disable_arg: NonEmptyStr = "ipv6.disable=1" as NonEmptyStr

// Every network argument the guest kernel boots with: its address, gateway and resolver, and the
// v6 refusal.
fn runner_slot_guest_network_boot_args(net: RunnerSlotNetwork) -> String {
  join([runner_slot_guest_ip_boot_arg(net: net), " ", runner_microvm_guest_ipv6_disable_arg as String], "")
}

// DECLARED FRONTIER (DESIGN 3c). The host setting has a host readback (the per-attempt
// TapIpv6DisabledFact below); the guest's does not yet. NAMED CONSUMER: the guest boot observation
// (gunbc.runner_microvm_boot_probe). TRIGGER: a booted guest reports /proc/sys/net/ipv6 absent (the
// v6 stack never initialised) over the boot observation channel. SUFFICIENT FOR deleting this row.
// It is evidence of the guest's configuration, never of sanitation: a guest event may trigger
// teardown and may not establish sanitation.
data guest_ipv6_disabled_readback_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_microvm_boot_probe guest boot observation. TRIGGER: a booted guest reports its v6 stack absent (/proc/sys/net/ipv6 missing) under ipv6.disable=1 over the boot observation channel. SUFFICIENT FOR deleting this row. NOT satisfied by the boot argument being present, and never counted as sanitation evidence." as NonEmptyStr,
)

// --- the converge receipt: persistent slot network state at one generation ---

// PERSISTENT STATE IS A CONVERGE FACT; TRANSIENT RESIDUE IS AN ATTEMPT FACT. The tap, its address
// and route, its v6 standing, the host's helper standing and the installed ruleset are what the
// host converge establishes and reads back at one generation. The per-attempt readback below checks
// only what an attempt can leave behind, AGAINST this receipt -- it never re-derives the persistent
// facts itself (sunny-ant-606 ruling on #11675).
//
// THE SUBJECT IS DERIVED FROM THE SLOT, and it now carries the guest MAC: neighbour state is keyed
// to the guest's address on the tap and the MAC is the value that entry would hold.
type SlotNetworkSubject {
  slot: RunnerSlotIdentity
  tap_device: NonEmptyStr
  guest_address: Ipv4Address
  guest_mac: Eui48Address
}

fn slot_network_subject(slot: RunnerSlotIdentity) -> SlotNetworkSubject {
  let net = runner_slot_network(slot: slot)
  SlotNetworkSubject { slot: slot, tap_device: net.tap_device, guest_address: net.guest_address, guest_mac: net.guest_mac }
}

fn slot_network_subject_equal(a: SlotNetworkSubject, b: SlotNetworkSubject) -> Bool {
  runner_slot_identity_equal(a: a.slot, b: b.slot)
    && (a.tap_device as String) == (b.tap_device as String)
    && ipv4_address_eq(a: a.guest_address, b: b.guest_address)
    && (render_mac_address(addr: a.guest_mac) as String) == (render_mac_address(addr: b.guest_mac) as String)
}

type TapIpv6Standing
  = TapIpv6Disabled
  | TapIpv6Enabled
  | TapIpv6Unread { reason: NonEmptyStr }

// ONE CONVERGED SLOT: the subject, and what the converge read back for its persistent state.
type ConvergedSlot {
  subject: SlotNetworkSubject
  host_address_cidr: NonEmptyStr
  guest_route: NonEmptyStr
  tap_ipv6: TapIpv6Standing
}

// HELPERS ARE EXCLUDED BY A PROOF OVER THE EFFECTIVE HOST POLICY, NOT OVER OUR TABLE. An expectation
// is created only by a conntrack helper, and a helper attaches to a flow in exactly three ways:
// automatic assignment by port, an explicit helper in ANY ruleset on the host (every nft table and
// any legacy xtables CT target -- dockerd's included), or a userspace helper. Each is a reading, and
// the expectation table is read empty at the same generation.
type HelperAutoAssignment
  = AutoAssignmentAbsentFromKernel { kernel_release: NonEmptyStr }
  | AutoAssignmentSysctlOff
  | AutoAssignmentOn
  | AutoAssignmentUnread { reason: NonEmptyStr }

// A SURFACE IS COUNTED OR IT IS UNREAD, AND THERE IS NO THIRD ANSWER. An Int field cannot say "I did
// not look", so a converge that could not run a probe had only a zero to write -- which is the
// fabricated reading DESIGN section 5 forbids, and it reads as "no helper is attached" (review
// 68963). The count now carries its own absence, so an unread surface cannot be spelled as an
// excluded one.
type HelperSurfaceReading
  = HelperSurfaceCounted { count: Int }
  | HelperSurfaceUnread { reason: NonEmptyStr }

type HelperStanding {
  auto_assignment: HelperAutoAssignment
  nft_ct_helper_statements: HelperSurfaceReading
  xtables_ct_helper_targets: HelperSurfaceReading
  userspace_helpers: HelperSurfaceReading
  expectations_at_generation: HelperSurfaceReading
}

fn helper_surface_is_empty(r: HelperSurfaceReading) -> Bool {
  match r {
    HelperSurfaceCounted { count: n } => n == 0
    HelperSurfaceUnread { reason: _ } => false
  }
}

fn helpers_excluded(h: HelperStanding) -> Bool {
  let auto_off = match h.auto_assignment {
    AutoAssignmentAbsentFromKernel { kernel_release: _ } => true
    AutoAssignmentSysctlOff => true
    AutoAssignmentOn => false
    AutoAssignmentUnread { reason: _ } => false
  }
  auto_off
    && helper_surface_is_empty(r: h.nft_ct_helper_statements)
    && helper_surface_is_empty(r: h.xtables_ct_helper_targets)
    && helper_surface_is_empty(r: h.userspace_helpers)
    && helper_surface_is_empty(r: h.expectations_at_generation)
}

// THE GENERATION IS AN IDENTITY, NOT A COUNT. What a consumer needs is "which converge established
// this", and the converge run already has a name; a number would invite arithmetic on something that
// only ever supports equality, and would need a counter with state of its own.
type ConvergeGeneration = NonEmptyStr where brand("ConvergeGeneration")

type ConvergedSlotNetwork {
  host: HostIdentity
  generation: ConvergeGeneration
  slots: List<ConvergedSlot>
  helpers: HelperStanding
  nft_digest: Sha256Digest
}

// DECLARED FRONTIER (DESIGN 3c). NAMED CONSUMER: the microvm_host_converge fleet-converge mode on
// srvN, which produces ConvergedSlotNetwork. TRIGGER: that converge installs each slot's .netdev,
// .network and v6 sysctl file and the ruleset from runner_microvm_nft_ruleset_text_for(the host's
// HostEgressGrain), then reads back every field of the receipt -- tap, address, route, disable_ipv6,
// helper standing, the nft listing digest -- and records it at a generation. SUFFICIENT FOR
// deleting this row and host_ruleset_installer_frontier together. NOT satisfied by a witness
// building a receipt.
//
// AMENDED 2026-09-21: the observe mode HAS executed on srv1 (fleet-converge run 35646413870) and
// refused, naming the fact -- srv1's gunbc-tap1 has no disable_ipv6 to read, because no route had
// ever installed the slot network. The installing route is now gunbc.runner_microvm_network_apply
// rather than microvm_host_converge, and it has not been dispatched. Both rows stand.
data converged_slot_network_producer_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_microvm_network_converge runner_microvm_network_observe_wet, which HAS LANDED: it binds the dispatched host to the machine, reads the taps, addresses, routes, v6 standing, forwarding, ruleset digest and helper standing, and folds them into ConvergedSlotNetwork or a typed refusal. WHAT REMAINS: no run has produced a receipt, so no ConvergedSlotNetwork exists for any host. The staging and install folds beside it are NOT executed by that mode and are covered by microvm_network_host_mutation_principal_frontier, not by this row. THE MODE HAS NOW EXECUTED AND THE ROW STAYS, WHICH IS THE HONEST READING OF ITS OWN TRIGGER. fleet-converge run 35646413870, mode microvm_network_observe, host srv1, 2026-09-21: it bound to srv1, read the host, and wrote a receipt (artifact runner-microvm-network-observe-receipt, id 10661755164) whose whole content is `microvm-network-observe REFUSED: slot srv1-01: tap disable_ipv6 could not be read`. That is a real reading and it names the real fact -- srv1 carries no gunbc-tap1, because NOTHING HAS EVER INSTALLED THE SLOT NETWORK on any host. So the mode is proven to execute and to refuse where it should; what this row asserts is still true unchanged, that no ConvergedSlotNetwork exists for any host, and narrowing the required facts to mint one from that host would be the fabrication the observe module is written to refuse. TRIGGER: the observe mode executes on a host that has been converged -- gunbc.runner_microvm_network_apply having installed the slot and host network files there -- and records a receipt carrying the live readings at a generation. SUFFICIENT FOR deleting this row. NOT satisfied by a witness building a receipt, by the module compiling, or by a refusal receipt however well it names its fact." as NonEmptyStr,
)

// --- the sanitation subject: sealed, and joined to the receipt ---

// THE SUBJECT OF A SANITATION IS A SLOT JOINED TO THE RECEIPT OF THE HOST IT RUNS ON. Taking the slot
// and the receipt as two unrelated arguments let a self-consistent receipt and listing from host B
// confirm a slot on host A (sunny-ant-606 ruling on #11675). This type has one constructor, and that
// constructor refuses unless the receipt is the slot's own host's, the slot is in the receipt's
// population with the subject the slot derives, its tap's v6 is disabled, and helpers are excluded.
// So the per-attempt fold can only be asked about a slot whose persistent state is established.
type SlotNetworkSanitationSubject sole_constructor {
  subject: SlotNetworkSubject
  converged: ConvergedSlotNetwork
}

type SanitationSubjectRefusal
  = ReceiptForDifferentHost { slot_host: HostIdentity, receipt_host: HostIdentity }
  | SlotNotInConvergedPopulation
  | ConvergedSlotDisagreesWithDerivation
  | TapIpv6NotEstablishedDisabled
  | HelpersNotExcluded

type SanitationSubjectResult
  = SanitationSubjectAdmitted { subject: SlotNetworkSanitationSubject }
  | SanitationSubjectRefused { refusal: SanitationSubjectRefusal }

fn converged_slot_of(slot: RunnerSlotIdentity, receipt: ConvergedSlotNetwork) -> ConvergedSlot? {
  fold(receipt.slots, init: none, f: (acc, c) =>
    match acc {
      Present { value: _ } => acc
      Absent => if runner_slot_identity_equal(a: c.subject.slot, b: slot) { Present { value: c } } else { acc }
    }
  )
}

fn tap_ipv6_is_disabled(t: TapIpv6Standing) -> Bool {
  match t {
    TapIpv6Disabled => true
    TapIpv6Enabled => false
    TapIpv6Unread { reason: _ } => false
  }
}

fn slot_network_sanitation_subject(slot: RunnerSlotIdentity, receipt: ConvergedSlotNetwork) -> SanitationSubjectResult {
  if (slot.host as String) != (receipt.host as String) {
    SanitationSubjectRefused { refusal: ReceiptForDifferentHost { slot_host: slot.host, receipt_host: receipt.host } }
  } else {
    match converged_slot_of(slot: slot, receipt: receipt) {
      Absent => SanitationSubjectRefused { refusal: SlotNotInConvergedPopulation }
      Present { value: c } =>
        if !slot_network_subject_equal(a: c.subject, b: slot_network_subject(slot: slot)) {
          SanitationSubjectRefused { refusal: ConvergedSlotDisagreesWithDerivation }
        } else if !tap_ipv6_is_disabled(t: c.tap_ipv6) {
          SanitationSubjectRefused { refusal: TapIpv6NotEstablishedDisabled }
        } else if !helpers_excluded(h: receipt.helpers) {
          SanitationSubjectRefused { refusal: HelpersNotExcluded }
        } else {
          SanitationSubjectAdmitted { subject: SlotNetworkSanitationSubject { subject: c.subject, converged: receipt } }
        }
    }
  }
}

// --- the per-attempt readback: transient residue against the receipt ---

// EVERY READING NAMES WHAT IT IS ABOUT, AND A READING ABOUT SOMETHING ELSE ESTABLISHES NOTHING HERE.
// Slot readings carry the slot subject; host readings carry the host and the generation they were
// taken against. A reading whose subject, host or generation differs from the sanitation subject's is
// Unobservable for that fact -- never Confirmed.
//
// CONNTRACK IS READ IN BOTH ORIGINAL DIRECTIONS, AND FLUSHED BEFORE IT IS READ. A flow the guest
// opened has it as original source; a flow the host opened toward it has it as original destination.
// The flush is teardown's mutation; the reading after it is the fact.
//
// THE RULESET DIGEST IS OF `nft list table`, NOT OF THE FILE WE APPLIED, and it is compared against
// the receipt's digest, which is a listing too.
type SlotNetworkFact
  = TapUnheldFact
  | TapIpv6DisabledFact
  | GuestOriginatedConntrackEmptyFact
  | GuestDestinedConntrackEmptyFact
  | GuestNeighbourAbsentFact
  | ExpectationTableEmptyFact
  | RulesetMatchesConvergedFact

// EACH FACT HAS ITS OWN WIRE WORD, because a consumer that folds this readback into one sanitation
// fact (gunbc.runner_microvm_lifecycle maps it onto product.fabric.sanitation SlotNetworkQuiescent)
// otherwise reports "the slot network is not quiescent" and sends an operator to look at all seven.
// The label lives here, with the coproduct, rather than being spelled a second time by that consumer.
fn slot_network_fact_label(fact: SlotNetworkFact) -> String {
  match fact {
    TapUnheldFact => "tap-unheld"
    TapIpv6DisabledFact => "tap-ipv6-disabled"
    GuestOriginatedConntrackEmptyFact => "guest-originated-conntrack-empty"
    GuestDestinedConntrackEmptyFact => "guest-destined-conntrack-empty"
    GuestNeighbourAbsentFact => "guest-neighbour-absent"
    ExpectationTableEmptyFact => "expectation-table-empty"
    RulesetMatchesConvergedFact => "ruleset-matches-converged"
  }
}

type TapHolderObservation
  = TapPresentUnheld
  | TapHeld { holders: Int }
  | TapMissing
  | TapHoldersUnreadable { reason: NonEmptyStr }

type ResidueObservation
  = ResidueAbsent
  | ResiduePresent { entries: Int }
  | ResidueUnreadable { reason: NonEmptyStr }

type RulesetObservation
  = RulesetListed { digest: Sha256Digest }
  | RulesetUnreadable { reason: NonEmptyStr }

type TapReading {
  subject: SlotNetworkSubject
  observation: TapHolderObservation
}

type TapIpv6Reading {
  subject: SlotNetworkSubject
  observation: TapIpv6Standing
}

type SlotResidueReading {
  subject: SlotNetworkSubject
  observation: ResidueObservation
}

type HostResidueReading {
  host: HostIdentity
  generation: ConvergeGeneration
  observation: ResidueObservation
}

type RulesetReading {
  host: HostIdentity
  generation: ConvergeGeneration
  observation: RulesetObservation
}

type SlotNetworkReadings {
  tap: TapReading
  tap_ipv6: TapIpv6Reading
  guest_originated_conntrack: SlotResidueReading
  guest_destined_conntrack: SlotResidueReading
  guest_neighbour: SlotResidueReading
  expectations: HostResidueReading
  ruleset: RulesetReading
}

// "COULD NOT READ" IS NOT "REFUTED", and the two arms stay separate because they call for different
// operators: a refutation is a fact about the host that needs remedying, an unobservable reading is
// a fact about the instrument. Both quarantine the cell -- neither is CellReady -- but collapsing
// them would send someone to clean a host that may be clean, or to fix a probe on a host that is not.
type SlotNetworkReadback
  = SlotNetworkConfirmed
  | SlotNetworkRefuted { fact: SlotNetworkFact, detail: NonEmptyStr }
  | SlotNetworkUnobservable { fact: SlotNetworkFact, reason: NonEmptyStr }

fn different_subject(fact: SlotNetworkFact) -> SlotNetworkReadback {
  SlotNetworkUnobservable {
    fact: fact,
    reason: "the reading names a different slot, tap, guest address or MAC than the one being sanitized" as NonEmptyStr,
  }
}

fn different_generation(fact: SlotNetworkFact) -> SlotNetworkReadback {
  SlotNetworkUnobservable {
    fact: fact,
    reason: "the reading was taken on a different host or against a different converge generation than the receipt" as NonEmptyStr,
  }
}

fn tap_readback(s: SlotNetworkSanitationSubject, r: TapReading) -> SlotNetworkReadback {
  if !slot_network_subject_equal(a: s.subject, b: r.subject) {
    different_subject(fact: TapUnheldFact)
  } else {
    match r.observation {
      TapPresentUnheld => SlotNetworkConfirmed
      TapHeld { holders: n } => SlotNetworkRefuted {
        fact: TapUnheldFact,
        detail: join([to_string(n), " process(es) still hold the slot tap after the attempt"], "") as NonEmptyStr,
      }
      TapMissing => SlotNetworkRefuted {
        fact: TapUnheldFact,
        detail: "the slot tap is absent, so the converged network state no longer holds" as NonEmptyStr,
      }
      TapHoldersUnreadable { reason: why } => SlotNetworkUnobservable { fact: TapUnheldFact, reason: why }
    }
  }
}

fn tap_ipv6_readback(s: SlotNetworkSanitationSubject, r: TapIpv6Reading) -> SlotNetworkReadback {
  if !slot_network_subject_equal(a: s.subject, b: r.subject) {
    different_subject(fact: TapIpv6DisabledFact)
  } else {
    match r.observation {
      TapIpv6Disabled => SlotNetworkConfirmed
      TapIpv6Enabled => SlotNetworkRefuted {
        fact: TapIpv6DisabledFact,
        detail: "disable_ipv6 on the slot tap reads 0, so v6 has a path the receipt says does not exist" as NonEmptyStr,
      }
      TapIpv6Unread { reason: why } => SlotNetworkUnobservable { fact: TapIpv6DisabledFact, reason: why }
    }
  }
}

fn residue_readback(fact: SlotNetworkFact, o: ResidueObservation) -> SlotNetworkReadback {
  match o {
    ResidueAbsent => SlotNetworkConfirmed
    ResiduePresent { entries: n } => SlotNetworkRefuted {
      fact: fact,
      detail: join([to_string(n), " entry(ies) survived the attempt"], "") as NonEmptyStr,
    }
    ResidueUnreadable { reason: why } => SlotNetworkUnobservable { fact: fact, reason: why }
  }
}

fn slot_residue_readback(s: SlotNetworkSanitationSubject, fact: SlotNetworkFact, r: SlotResidueReading) -> SlotNetworkReadback {
  if !slot_network_subject_equal(a: s.subject, b: r.subject) {
    different_subject(fact: fact)
  } else {
    residue_readback(fact: fact, o: r.observation)
  }
}

fn at_receipt(s: SlotNetworkSanitationSubject, host: HostIdentity, generation: ConvergeGeneration) -> Bool {
  (s.converged.host as String) == (host as String)
    && (s.converged.generation as String) == (generation as String)
}

fn host_residue_readback(s: SlotNetworkSanitationSubject, fact: SlotNetworkFact, r: HostResidueReading) -> SlotNetworkReadback {
  if !at_receipt(s: s, host: r.host, generation: r.generation) {
    different_generation(fact: fact)
  } else {
    residue_readback(fact: fact, o: r.observation)
  }
}

fn ruleset_readback(s: SlotNetworkSanitationSubject, r: RulesetReading) -> SlotNetworkReadback {
  if !at_receipt(s: s, host: r.host, generation: r.generation) {
    different_generation(fact: RulesetMatchesConvergedFact)
  } else {
    match r.observation {
      RulesetListed { digest: d } =>
        if content_hash_eq_cryptographic(left: d, right: s.converged.nft_digest) {
          SlotNetworkConfirmed
        } else {
          SlotNetworkRefuted {
            fact: RulesetMatchesConvergedFact,
            detail: join(["listed ruleset digest ", d.hex as String, " differs from converged ", s.converged.nft_digest.hex as String], "") as NonEmptyStr,
          }
        }
      RulesetUnreadable { reason: why } => SlotNetworkUnobservable { fact: RulesetMatchesConvergedFact, reason: why }
    }
  }
}

// A REFUTATION ANYWHERE OUTRANKS AN UNREADABLE FACT ELSEWHERE: it is the stronger statement about
// the host, and reporting the probe failure instead would hide a known defect behind an unknown one.
fn is_refuted(r: SlotNetworkReadback) -> Bool {
  match r {
    SlotNetworkRefuted { fact: _, detail: _ } => true
    SlotNetworkConfirmed => false
    SlotNetworkUnobservable { fact: _, reason: _ } => false
  }
}

fn is_unobservable(r: SlotNetworkReadback) -> Bool {
  match r {
    SlotNetworkUnobservable { fact: _, reason: _ } => true
    SlotNetworkConfirmed => false
    SlotNetworkRefuted { fact: _, detail: _ } => false
  }
}

fn first_readback_where(rs: List<SlotNetworkReadback>, pick: fn(SlotNetworkReadback) -> Bool) -> SlotNetworkReadback? {
  fold(rs, init: none, f: (acc, r) =>
    match acc {
      Present { value: _ } => acc
      Absent => if pick(r) { Present { value: r } } else { acc }
    }
  )
}

fn slot_network_verdict(s: SlotNetworkSanitationSubject, readings: SlotNetworkReadings) -> SlotNetworkReadback {
  let facts = [
    tap_readback(s: s, r: readings.tap),
    tap_ipv6_readback(s: s, r: readings.tap_ipv6),
    slot_residue_readback(s: s, fact: GuestOriginatedConntrackEmptyFact, r: readings.guest_originated_conntrack),
    slot_residue_readback(s: s, fact: GuestDestinedConntrackEmptyFact, r: readings.guest_destined_conntrack),
    slot_residue_readback(s: s, fact: GuestNeighbourAbsentFact, r: readings.guest_neighbour),
    host_residue_readback(s: s, fact: ExpectationTableEmptyFact, r: readings.expectations),
    ruleset_readback(s: s, r: readings.ruleset),
  ]
  match first_readback_where(rs: facts, pick: is_refuted) {
    Present { value: r } => r
    Absent => match first_readback_where(rs: facts, pick: is_unobservable) {
      Present { value: u } => u
      Absent => SlotNetworkConfirmed
    }
  }
}

// THE RESULT CARRIES THE SUBJECT IT WAS TAKEN FOR. A bare verdict leaves the subject on the input
// side, so a consumer holding a Confirmed would have to re-derive or re-assert which slot it is about
// -- a second authority for that join. The lifecycle controller's teardown readback compares
// bound_slot_network_readback_slot against its CellBoundAttempt's slot instead (tidy-wolf-685 on
// #11670). The record has one constructor, this fold, so its subject and result cannot be paired
// by hand.
type BoundSlotNetworkReadback sole_constructor {
  subject: SlotNetworkSanitationSubject
  result: SlotNetworkReadback
}

fn slot_network_readback(s: SlotNetworkSanitationSubject, readings: SlotNetworkReadings) -> BoundSlotNetworkReadback {
  BoundSlotNetworkReadback { subject: s, result: slot_network_verdict(s: s, readings: readings) }
}

fn bound_slot_network_readback_slot(b: BoundSlotNetworkReadback) -> RunnerSlotIdentity {
  b.subject.subject.slot
}

fn bound_slot_network_readback_result(b: BoundSlotNetworkReadback) -> SlotNetworkReadback {
  b.result
}

// --- the commands that produce the readback's observations ---

// TEARDOWN FLUSHES; THE LIFECYCLE CONTROLLER READS. The flushes are mutations and belong to the
// teardown step, which runs them before the lists. Their exit status is not the evidence -- see
// extdeps.tools.conntrack and extdeps.iproute2.ip_neigh -- the lists are.
fn runner_slot_teardown_flush_commands(net: RunnerSlotNetwork) -> List<ArgvCommand> {
  let guest = render_ipv4_address(addr: net.guest_address) as String
  [
    conntrack_delete_command(filter: ConntrackOriginalSource, address: guest),
    conntrack_delete_command(filter: ConntrackOriginalDestination, address: guest),
    ip_neigh_flush_command(address: guest, device: net.tap_device as String),
  ]
}

fn runner_slot_guest_originated_conntrack_list_command(net: RunnerSlotNetwork) -> ArgvCommand {
  conntrack_list_command(filter: ConntrackOriginalSource, address: render_ipv4_address(addr: net.guest_address) as String)
}

fn runner_slot_guest_destined_conntrack_list_command(net: RunnerSlotNetwork) -> ArgvCommand {
  conntrack_list_command(filter: ConntrackOriginalDestination, address: render_ipv4_address(addr: net.guest_address) as String)
}

fn runner_slot_guest_neighbour_show_command(net: RunnerSlotNetwork) -> ArgvCommand {
  ip_neigh_show_command(address: render_ipv4_address(addr: net.guest_address) as String, device: net.tap_device as String)
}

fn runner_host_expectation_list_command() -> ArgvCommand {
  conntrack_list_expectations_command()
}

fn runner_microvm_nft_list_command() -> ArgvCommand {
  nft_list_table_command(family: NftInet, name: runner_microvm_nft_table_name)
}

// THE SAME LISTING, AS A GRANTED OPERATION. Listing a table needs CAP_NET_ADMIN, so the converge and
// the lifecycle controller reach it through the operation type that also renders the sudoers line;
// the bare ArgvCommand above is the unelevated spelling for a caller that already has the capability.
fn runner_microvm_nft_read_operation() -> ExecutorPrivilegedOperation {
  ReadNftTable { family: nft_family_wire(f: NftInet) as NonEmptyStr, table: runner_microvm_nft_table_name }
}

// DECLARED FRONTIER (DESIGN 3c). The readback and the three commands that feed it have no
// executing consumer in this tree yet. NAMED CONSUMER: the host teardown readback of the microVM
// slot lifecycle controller (gunbc#11670), whose network fact maps onto product.fabric.sanitation.
// TRIGGER: that controller executes teardown on a host -- runs runner_slot_teardown_flush_commands,
// reads every observation SlotNetworkReadings names, and derives
// CellReady or CellQuarantined from slot_network_readback. SUFFICIENT FOR deleting this row. NOT
// satisfied by #11670 importing the type, or by a witness calling the fold.
data slot_network_readback_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: the microVM slot lifecycle controller's host teardown readback (gunbc#11670). TRIGGER: that controller executes teardown on a host, runs runner_slot_teardown_flush_commands, reads the two conntrack lists, runner_slot_guest_neighbour_show_command, runner_host_expectation_list_command, the tap disable_ipv6 value and runner_microvm_nft_list_command, and derives CellReady or CellQuarantined from slot_network_readback. SUFFICIENT FOR deleting this row. NOT satisfied by an import of the type or by a witness calling the fold." as NonEmptyStr,
)

// DECLARED FRONTIER (DESIGN 3c). The kernel records dns0 in /proc/net/pnp; it does not write
// /etc/resolv.conf. NAMED CONSUMER: the guest image (gunbc.runner_guest_image), whose resolver
// configuration must read the booted dns0 so the guest resolves through the one address the DNS
// grant admits. THE IMAGE HALF IS LANDED: gunbc.runner_guest_image runner_guest_resolver_link_command
// makes the image's /etc/resolv.conf a symlink to /proc/net/pnp, the form the kernel's own nfsroot
// documentation names. WHAT REMAINS is the executing half -- a booted, NETWORKED guest resolving
// github.com through runner_microvm_guest_resolver -- which the boot probe cannot supply (it boots
// with GuestNetworkAbsent) and only a real job under a test label can (gunbc.runner_guest_image
// guest_agent_real_job_acceptance_frontier). SUFFICIENT FOR deleting this row. NOT satisfied by the
// link alone, nor by the boot argument carrying dns0 alone.
data guest_resolver_configuration_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_guest_image resolver configuration. IMAGE HALF LANDED: runner_guest_resolver_link_command links /etc/resolv.conf to /proc/net/pnp. REMAINING TRIGGER: a booted networked guest resolves github.com through runner_microvm_guest_resolver, observed on the console of the first test-label job (guest_agent_real_job_acceptance_frontier). SUFFICIENT FOR deleting this row. NOT satisfied by the link alone or by the ip= boot argument carrying dns0 alone." as NonEmptyStr,
)

// --- the receipt as a wire value: what a later process reads back ---

// A RECEIPT NOBODY CAN PARSE IS A REPORT, NOT A RECEIPT. The converge builds a ConvergedSlotNetwork
// in memory and writes a file; the lifecycle controller runs later, in another process, and needs
// the VALUE -- slot_network_sanitation_subject takes a receipt, not prose (side-chat hold on #11751).
// So the file has a schema line and a total parse back, and the two live beside the type they carry
// rather than in either consumer.
//
// THE DERIVABLE FIELDS ARE VERIFIED, NOT TRUSTED. A slot's tap, guest address and MAC follow from its
// identity, so the parse derives them and REFUSES when the wire disagrees: a receipt describing a
// tap this fleet would never mint is a receipt about something else.
data converged_slot_network_wire_schema: NonEmptyStr = "gunbc.converged_slot_network.v1" as NonEmptyStr

// THE PARSE HALF IS UNCONSUMED AND SAYS SO IN A ROW, NOT IN THIS PROSE. The render half has a
// production consumer (receipt_text folds it into the persisted artifact); the parse half does not
// yet, and DESIGN section 4c is explicit that an annotation is never evidence that a machine claim
// holds. So the gap carries the same typed row every other unconsumed surface in this module
// carries, rather than resting on the paragraph above (review 69448).
data converged_slot_network_parse_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: the microVM slot lifecycle controller (gunbc#11670), which runs in a LATER PROCESS than the converge that wrote the receipt and therefore cannot hold the in-memory ConvergedSlotNetwork -- it must read the persisted artifact back and recover the VALUE, because slot_network_sanitation_subject takes a receipt rather than prose. COVERS the whole wire-parse family: parse_converged_slot_network, parse_converged_body, parse_helper_standing, parse_converged_slot_line, parse_converged_slot_tail, parse_helper_surface, parse_auto_assignment_wire, parse_tap_ipv6_wire, candidate_named, wire_value, wire_lines and drop_prefix. WHAT REMAINS: no controller exists to read a receipt, and no receipt has been written by any run, so the only executing callers are witnesses. TRIGGER: that controller reads a receipt this fleet wrote, recovers the ConvergedSlotNetwork through parse_converged_slot_network, and derives the slot's network fact through slot_network_sanitation_subject on the value it parsed rather than on one it built. SUFFICIENT FOR deleting this row. NOT satisfied by the render half having a consumer, by a witness round-tripping render into parse, by the module compiling, or by the annotation above naming the controller." as NonEmptyStr,
)

fn helper_surface_wire(r: HelperSurfaceReading) -> String {
  match r {
    HelperSurfaceCounted { count: n } => join(["counted:", to_string(n)], "")
    HelperSurfaceUnread { reason: why } => join(["unread:", why as String], "")
  }
}

fn auto_assignment_wire(a: HelperAutoAssignment) -> String {
  match a {
    AutoAssignmentAbsentFromKernel { kernel_release: k } => join(["absent_from_kernel:", k as String], "")
    AutoAssignmentSysctlOff => "sysctl_off"
    AutoAssignmentOn => "on"
    AutoAssignmentUnread { reason: why } => join(["unread:", why as String], "")
  }
}

fn tap_ipv6_wire(t: TapIpv6Standing) -> String {
  match t {
    TapIpv6Disabled => "disabled"
    TapIpv6Enabled => "enabled"
    TapIpv6Unread { reason: why } => join(["unread:", why as String], "")
  }
}

fn converged_slot_wire(c: ConvergedSlot) -> String {
  join([
    "slot=", runner_slot_instance_name(slot: c.subject.slot),
    "|tap=", c.subject.tap_device as String,
    "|guest=", render_ipv4_address(addr: c.subject.guest_address) as String,
    "|mac=", render_mac_address(addr: c.subject.guest_mac) as String,
    "|host_cidr=", c.host_address_cidr as String,
    "|route=", c.guest_route as String,
    "|ipv6=", tap_ipv6_wire(t: c.tap_ipv6),
  ], "")
}

fn render_converged_slot_network(c: ConvergedSlotNetwork) -> String {
  join([
    converged_slot_network_wire_schema as String, "\n",
    "host=", c.host as String, "\n",
    "generation=", c.generation as String, "\n",
    "nft_digest=", c.nft_digest.hex as String, "\n",
    "helper_auto=", auto_assignment_wire(a: c.helpers.auto_assignment), "\n",
    "helper_nft=", helper_surface_wire(r: c.helpers.nft_ct_helper_statements), "\n",
    "helper_xtables=", helper_surface_wire(r: c.helpers.xtables_ct_helper_targets), "\n",
    "helper_userspace=", helper_surface_wire(r: c.helpers.userspace_helpers), "\n",
    "helper_expectations=", helper_surface_wire(r: c.helpers.expectations_at_generation), "\n",
    join(map(c.slots, x => join([converged_slot_wire(c: x), "\n"], "")), ""),
  ], "")
}

type ConvergedSlotNetworkParse
  = ConvergedSlotNetworkParsed { receipt: ConvergedSlotNetwork }
  | ConvergedSlotNetworkMalformed { cause: NonEmptyStr }

fn wire_lines(text: String) -> List<String> {
  filter(xs: split(s: text, delimiter: "\n"), predicate: fn(l) { trim(s: l) != "" })
}

fn wire_value(lines: List<String>, key: String) -> String? {
  fold(lines, init: none, f: (acc, l) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if trim(s: l).starts_with(prefix: join([key, "="], "")) {
          Present { value: drop_prefix(s: trim(s: l), prefix: join([key, "="], "")) }
        } else {
          acc
        }
    }
  )
}

fn drop_prefix(s: String, prefix: String) -> String {
  join(skip(xs: split(s: s, delimiter: prefix), n: 1), prefix)
}

fn parse_helper_surface(raw: String) -> HelperSurfaceReading? {
  if raw.starts_with(prefix: "counted:") {
    match parse_int(s: drop_prefix(s: raw, prefix: "counted:")) {
      Present { value: n } => Present { value: HelperSurfaceCounted { count: n } }
      Absent => none
    }
  } else if raw.starts_with(prefix: "unread:") {
    Present { value: HelperSurfaceUnread { reason: drop_prefix(s: raw, prefix: "unread:") as NonEmptyStr } }
  } else {
    none
  }
}

fn parse_auto_assignment_wire(raw: String) -> HelperAutoAssignment? {
  if raw.starts_with(prefix: "absent_from_kernel:") {
    Present { value: AutoAssignmentAbsentFromKernel { kernel_release: drop_prefix(s: raw, prefix: "absent_from_kernel:") as NonEmptyStr } }
  } else if raw == "sysctl_off" {
    Present { value: AutoAssignmentSysctlOff }
  } else if raw == "on" {
    Present { value: AutoAssignmentOn }
  } else if raw.starts_with(prefix: "unread:") {
    Present { value: AutoAssignmentUnread { reason: drop_prefix(s: raw, prefix: "unread:") as NonEmptyStr } }
  } else {
    none
  }
}

fn parse_tap_ipv6_wire(raw: String) -> TapIpv6Standing? {
  if raw == "disabled" {
    Present { value: TapIpv6Disabled }
  } else if raw == "enabled" {
    Present { value: TapIpv6Enabled }
  } else if raw.starts_with(prefix: "unread:") {
    Present { value: TapIpv6Unread { reason: drop_prefix(s: raw, prefix: "unread:") as NonEmptyStr } }
  } else {
    none
  }
}

// THE SLOT IS FOUND IN THE CANDIDATE ROSTER, NOT MINTED FROM THE TEXT. A receipt naming a slot this
// host does not have is a receipt about another fleet, and deriving the identity from a parsed index
// would let the file invent one.
fn candidate_named(candidates: List<RunnerSlotIdentity>, name: String) -> RunnerSlotIdentity? {
  fold(candidates, init: none, f: (acc, c) =>
    match acc {
      Present { value: _ } => acc
      Absent => if runner_slot_instance_name(slot: c) == name { Present { value: c } } else { acc }
    }
  )
}

fn parse_converged_slot_line(line: String, candidates: List<RunnerSlotIdentity>) -> ConvergedSlot? {
  let parts = split(s: trim(s: line), delimiter: "|")
  match wire_value(lines: parts, key: "slot") {
    Absent => none
    Present { value: name } =>
      match candidate_named(candidates: candidates, name: name) {
        Absent => none
        Present { value: identity } => {
          let derived = slot_network_subject(slot: identity)
          match wire_value(lines: parts, key: "tap") {
            Absent => none
            Present { value: tap } =>
              match wire_value(lines: parts, key: "guest") {
                Absent => none
                Present { value: guest } =>
                  match wire_value(lines: parts, key: "mac") {
                    Absent => none
                    Present { value: mac } =>
                      if (tap != (derived.tap_device as String))
                        || (guest != (render_ipv4_address(addr: derived.guest_address) as String))
                        || (mac != (render_mac_address(addr: derived.guest_mac) as String)) {
                        none
                      } else {
                        parse_converged_slot_tail(parts: parts, derived: derived)
                      }
                  }
              }
          }
        }
      }
  }
}

fn parse_converged_slot_tail(parts: List<String>, derived: SlotNetworkSubject) -> ConvergedSlot? {
  match wire_value(lines: parts, key: "host_cidr") {
    Absent => none
    Present { value: cidr } =>
      match wire_value(lines: parts, key: "route") {
        Absent => none
        Present { value: route } =>
          match wire_value(lines: parts, key: "ipv6") {
            Absent => none
            Present { value: v6raw } =>
              match parse_tap_ipv6_wire(raw: v6raw) {
                Absent => none
                Present { value: v6 } =>
                  Present { value: ConvergedSlot {
                    subject: derived,
                    host_address_cidr: cidr as NonEmptyStr,
                    guest_route: route as NonEmptyStr,
                    tap_ipv6: v6,
                  } }
              }
          }
      }
  }
}

// EVERY FIELD OR NOTHING. A receipt missing its schema line, its host, its generation, its digest,
// any helper reading, or carrying a slot line this host cannot own, is malformed -- the consumer
// gets a typed refusal naming the field rather than a partially populated value.
fn parse_converged_slot_network(text: String, candidates: List<RunnerSlotIdentity>) -> ConvergedSlotNetworkParse {
  let lines = wire_lines(text: text)
  match lines.first() {
    Absent => ConvergedSlotNetworkMalformed { cause: "the receipt is empty" as NonEmptyStr }
    Present { value: schema } =>
      if trim(s: schema) != (converged_slot_network_wire_schema as String) {
        ConvergedSlotNetworkMalformed { cause: "the first line is not this receipt's schema" as NonEmptyStr }
      } else {
        parse_converged_body(lines: lines, candidates: candidates)
      }
  }
}

fn parse_converged_body(lines: List<String>, candidates: List<RunnerSlotIdentity>) -> ConvergedSlotNetworkParse {
  match wire_value(lines: lines, key: "host") {
    Absent => ConvergedSlotNetworkMalformed { cause: "no host= line" as NonEmptyStr }
    Present { value: host } =>
      match wire_value(lines: lines, key: "generation") {
        Absent => ConvergedSlotNetworkMalformed { cause: "no generation= line" as NonEmptyStr }
        Present { value: generation } =>
          match wire_value(lines: lines, key: "nft_digest") {
            Absent => ConvergedSlotNetworkMalformed { cause: "no nft_digest= line" as NonEmptyStr }
            Present { value: hex } =>
              match sha256_hex_digest(hex: hex) {
                Absent => ConvergedSlotNetworkMalformed { cause: "nft_digest is not a sha256 hex digest" as NonEmptyStr }
                Present { value: digest } =>
                  match parse_helper_standing(lines: lines) {
                    Absent => ConvergedSlotNetworkMalformed { cause: "a helper reading is missing or malformed" as NonEmptyStr }
                    Present { value: helpers } =>
                      parse_converged_slots(lines: lines, candidates: candidates, host: host, generation: generation, digest: digest, helpers: helpers)
                  }
              }
          }
      }
  }
}

fn parse_helper_standing(lines: List<String>) -> HelperStanding? {
  match wire_value(lines: lines, key: "helper_auto") {
    Absent => none
    Present { value: autoraw } =>
      match parse_auto_assignment_wire(raw: autoraw) {
        Absent => none
        Present { value: auto } =>
          match parse_helper_surface_at(lines: lines, key: "helper_nft") {
            Absent => none
            Present { value: nft } =>
              match parse_helper_surface_at(lines: lines, key: "helper_xtables") {
                Absent => none
                Present { value: xt } =>
                  match parse_helper_surface_at(lines: lines, key: "helper_userspace") {
                    Absent => none
                    Present { value: us } =>
                      match parse_helper_surface_at(lines: lines, key: "helper_expectations") {
                        Absent => none
                        Present { value: ex } =>
                          Present { value: HelperStanding {
                            auto_assignment: auto,
                            nft_ct_helper_statements: nft,
                            xtables_ct_helper_targets: xt,
                            userspace_helpers: us,
                            expectations_at_generation: ex,
                          } }
                      }
                  }
              }
          }
      }
  }
}

fn parse_helper_surface_at(lines: List<String>, key: String) -> HelperSurfaceReading? {
  match wire_value(lines: lines, key: key) {
    Absent => none
    Present { value: raw } => parse_helper_surface(raw: raw)
  }
}

fn slot_lines(lines: List<String>) -> List<String> {
  filter(xs: lines, predicate: fn(l) { trim(s: l).starts_with(prefix: "slot=") })
}

fn parse_converged_slots(
  lines: List<String>,
  candidates: List<RunnerSlotIdentity>,
  host: String,
  generation: String,
  digest: Sha256Digest,
  helpers: HelperStanding,
) -> ConvergedSlotNetworkParse {
  let raw = slot_lines(lines: lines)
  let parsed = fold(raw, init: [], f: (acc, l) =>
    match parse_converged_slot_line(line: l, candidates: candidates) {
      Present { value: c } => concat(acc, [c])
      Absent => acc
    }
  )
  if length(parsed) != length(raw) {
    ConvergedSlotNetworkMalformed { cause: "a slot line named a slot this host does not own, or disagreed with the address this fleet derives for it" as NonEmptyStr }
  } else {
    ConvergedSlotNetworkParsed {
      receipt: ConvergedSlotNetwork {
        host: host as HostIdentity,
        generation: generation as ConvergeGeneration,
        slots: parsed,
        helpers: helpers,
        nft_digest: digest,
      },
    }
  }
}
