// RunnerSlotProvision owns runner installation end-to-end in gunbc (operator ruling 2026-08-06:
// ctrl is a dead repo; prior ctrl:install-actions-runner citations are void legacy pointers).
// Per slot: cited ActionsRunnerRelease fetch+verify, base dir, extract, ownership, per-slot caps
// BEFORE systemctl enable. srv3/srv4 materialization target is 6 slots; srv4 disk binding is
// apply-time preflight in gunbc.runner_lifecycle runner_width_disk_preflight (not a row pin).

data runner_slot_provision_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: WholeDeclaration,
  }
}

type RunnerSlotMemberAt = NonEmptyStr

// WHAT THE HOST SAYS ABOUT A SLOT TREE, CARRIED ON THE OBSERVED MEMBER. Ownership used to return
// Absent for every observed slot because the observer read only directory names, so every
// out-of-roster tree refused OwnershipUnknown forever and 45 dead runner trees sat on srv2 at two
// gigabytes each. A tree is a retired incarnation of a gunbc-managed slot when four observed facts
// agree: its name is in this host's slot grammar (the allocation authority's own rendering round-
// trips through it), its `.runner` registration is absent OR ephemeral, and its unit is neither
// active nor enabled. That tree was created by this reconcile's own ADD arm and abandoned by a
// width change, so it is Owned and teardown-eligible. Anything else -- a persistently registered
// tree, an unreadable registration, an active unit, a name outside the grammar such as the
// operator scripts in the base dir -- stays OwnershipUnknown and refuses exactly as before.
// Desired members are constructed from names and carry Unobserved, which ownership never admits;
// only an observation can make a member removable.
//
// REGISTRATION IS A KIND, NOT A BOOL. `registered: Bool` read only the file's presence, and on srv2
// two trees (srv2-11, srv2-12) carry a `.runner` beside a unit dead since June, so a Bool could not
// distinguish a stale incarnation from a live persistent registration.
//
// AN EPHEMERAL FILE DOES NOT ESTABLISH THAT GITHUB HAS DROPPED THE REGISTRATION, AND THIS MODULE
// USED TO INFER EXACTLY THAT. The earlier reading was: `Ephemeral: True` plus a unit that is neither
// active nor enabled means GitHub already unregistered it, so the tree is a retired incarnation. The
// upstream sentence it rests on says an ephemeral runner is unregistered AFTER IT COMPLETES ONE JOB
// -- a statement about what happens when a condition occurs, not evidence that it occurred. A
// registration created and stopped before running any job, or before the disconnected-runner removal
// window elapsed, is still held remotely beside a tree that looks exactly like these.
//
// SO BOTH REGISTERED ARMS NOW REFUSE, and for one reason rather than two: current remote presence is
// establishable only by an authorized per-id observation against the organization, which this
// executor does not perform. The lifetime POLICY is still carried, because it is a real fact the
// file records and a consumer reconciling an estate wants it -- what it may no longer do is stand in
// for the observation.
//
// AND THE TREE HOLDS THE ONLY COPY OF THE IDENTITY. Deleting it on this inference would destroy the
// captured AgentId binding that addressing the remote object depends on, which is why the direction
// of this correction matters more than its size: the unsupported arm was the one that authorized
// discarding the evidence needed to do the job properly.
type RunnerSlotRegistration
  = SlotUnregistered
  | SlotRegisteredPersistent
  | SlotRegisteredEphemeral
  | SlotRegistrationUnreadable { reason: String }

type RunnerSlotProvenance
  = SlotProvenanceUnobserved
  | SlotProvenanceObserved {
      in_host_grammar: Bool
      registration: RunnerSlotRegistration
      unit_active: Bool
      unit_enabled: Bool
    }

fn runner_slot_registration_is_retired(r: RunnerSlotRegistration) -> Bool {
  match r {
    SlotUnregistered => true
    SlotRegisteredEphemeral => false
    SlotRegisteredPersistent => false
    SlotRegistrationUnreadable { reason: _ } => false
  }
}

fn runner_slot_registration_wire(r: RunnerSlotRegistration) -> String {
  match r {
    SlotUnregistered => "unregistered"
    SlotRegisteredPersistent => "registered"
    SlotRegisteredEphemeral => "ephemeral"
    SlotRegistrationUnreadable { reason: _ } => "registration-unreadable"
  }
}

type RunnerSlotMember {
  instance_name: NonEmptyStr
  slot_dir: NonEmptyStr
  provenance: RunnerSlotProvenance
}

// THE UNIT NAME A SLOT MEMBER IMPLIES. The member is keyed by its instance name and its tree; the
// retirement authority is keyed by the systemd unit. One derivation, so the two cannot drift.
fn slot_member_unit_name(m: RunnerSlotMember) -> NonEmptyStr {
  join([runner_unit_prefix, m.instance_name as String, runner_unit_suffix], "") as NonEmptyStr
}

fn retirement_mask_line(unit: String) -> String {
  shell_command_text_of_argv(argv: sudo_elevate_argv(command: systemctl_mask_now_argv(unit: unit as NonEmptyStr)))
}

fn realization_requires_actuation(evidence: SlotRetirementEvidence, unit: String) -> Bool {
  match slot_removal_realization(evidence: evidence, unit: unit) {
    RemovalActuationRequired { unit: _ } => true
    RemovalRetirementRefused { unit: _, cause: _ } => false
    RemovalRetirementPending { unit: _, cause: _ } => false
    RemovalTeardownAuthorized { unit: _ } => false
  }
}

fn first_occurrences(items: List<String>) -> List<String> {
  fold(items, init: [], f: (acc, x) => if any(acc, y => y == x) { acc } else { concat(acc, [x]) })
}

fn membership_removed_unit_names(
  membership: MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>,
) -> List<String> {
  flat_map(membership.actions, a =>
    match a {
      MemberRemoved { at: _, from: m } => [slot_member_unit_name(m: m) as String]
      MemberAdded { at: _, to: _ } => []
      MemberChanged { at: _, from: _, to: _ } => []
      MemberRemovalRefused { from: _, cause: _ } => []
      MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
    }
  )
}

// MASK IS AN OBLIGATION OVER THE TRANSITION, NOT A SIDE EFFECT OF TREE TEARDOWN.
//
// Membership only admits a removal when provenance says the incarnation is already dead
// (unregistered/ephemeral, inactive, disabled). The 21-to-12 retirees can still be serving when the
// obligation exists, so they never become `MemberRemoved` and the inhibitor never reached the apply
// script -- which is why `cap_converge_decision` stayed withheld after 22-50 completed. Required
// retirees that `slot_removal_realization` says need actuation are therefore masked from the
// transition set itself. Tree deletion stays on the membership path and still requires
// `RetirementComplete`.
fn evidence_has_standing_for(evidence: SlotRetirementEvidence, unit: String) -> Bool {
  match evidence {
    SlotRetirementEvidenceAbsent { cause: _ } => false
    SlotRetirementEvidencePresent { authorization: _, standings: ss } =>
      any(ss, s => retirement_unit(s: s) == unit)
  }
}

fn membership_does_not_name(removed: List<String>, unit: String) -> Bool {
  !any(removed, r => r == unit)
}

fn obligation_withheld_line(unit: String, cause: String) -> List<String> {
  match read_runner_unit_name(observed: unit as NonEmptyStr) {
    RunnerUnitInstance { registration_name: n } =>
      [slot_removal_withheld_line(
        unit: unit,
        tree: runner_slot_instance_dir(instance_name: n),
        cause: cause,
      )]
    NotARunnerUnit { observed: o } =>
      [join(
        [
          "echo '__GUNBC_CONVERGE_WITHHELD__ runner-slot obligation: unit=",
          o as String,
          " cause=the required identity is not a runner unit, so no slot tree is derived; ",
          cause,
          "' >&2",
        ],
        "",
      )]
    RunnerUnitInstanceMalformed { observed: o, cause: mc } =>
      [join(
        [
          "echo '__GUNBC_CONVERGE_WITHHELD__ runner-slot obligation: unit=",
          o as String,
          " cause=",
          mc as String,
          "; ",
          cause,
          "' >&2",
        ],
        "",
      )]
  }
}

// REQUIRED RETIREES THAT MEMBERSHIP NEVER SAW MUST STILL BE NAMED WHEN THEY ARE NOT MASKED.
//
// `retirement_actuation_units` only emits `RemovalActuationRequired`. An unobserved readback, a
// refused interruption, or a required identity with no bound standing produced no mask and no
// withheld line — the silent-degradation arm DESIGN section 5 forbids, and the exact population
// this planner exists to reach (serving 13..21). Membership teardown already prints those
// dispositions for `MemberRemoved` trees; this is the same diagnostic for the obligation set.
fn obligation_withheld_scripts(
  deploy: RunnerHostDeploy,
  membership: MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>,
  evidence: SlotRetirementEvidence,
) -> List<String> {
  let removed = membership_removed_unit_names(membership: membership)
  transition_required_retiring(host: deploy.host_label as HostIdentity)
    |> map(u => u as String)
    |> filter(u => membership_does_not_name(removed: removed, unit: u))
    |> flat_map(u =>
      if evidence_has_standing_for(evidence: evidence, unit: u)
        && realization_requires_actuation(evidence: evidence, unit: u) {
        []
      } else {
        match slot_removal_realization(evidence: evidence, unit: u) {
          RemovalActuationRequired { unit: au } =>
            obligation_withheld_line(
              unit: au,
              cause: "no retirement standing is bound for this required retiree, so neither mask nor deletion is authorized",
            )
          RemovalRetirementPending { unit: pu, cause: c } =>
            obligation_withheld_line(unit: pu, cause: c)
          RemovalRetirementRefused { unit: ru, cause: c } =>
            obligation_withheld_line(unit: ru, cause: c)
          RemovalTeardownAuthorized { unit: _ } => []
        }
      }
    )
}

fn retirement_actuation_units(
  deploy: RunnerHostDeploy,
  membership: MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>,
  evidence: SlotRetirementEvidence,
) -> List<String> {
  let from_membership = membership_removed_unit_names(membership: membership)
    |> filter(u => realization_requires_actuation(evidence: evidence, unit: u))
  let from_obligation = transition_required_retiring(host: deploy.host_label as HostIdentity)
    |> map(u => u as String)
    |> filter(u =>
      evidence_has_standing_for(evidence: evidence, unit: u)
        && realization_requires_actuation(evidence: evidence, unit: u)
    )
  first_occurrences(items: concat(from_membership, from_obligation))
}

// A WITHHELD DELETION SAYS SO RATHER THAN VANISHING. A skipped teardown that printed nothing would
// leave a narrowing host quietly accumulating trees with no record of which units were waiting on
// what, which is the silent-degradation arm DESIGN section 5 forbids.
fn slot_removal_withheld_line(unit: String, tree: NonEmptyStr, cause: String) -> String {
  join(
    [
      "echo '__GUNBC_CONVERGE_WITHHELD__ runner-slot teardown: unit=",
      unit,
      " tree=",
      tree as String,
      " cause=",
      cause,
      "' >&2",
    ],
    "",
  )
}

fn runner_slot_provenance_is_retired_incarnation(p: RunnerSlotProvenance) -> Bool {
  match p {
    SlotProvenanceUnobserved => false
    SlotProvenanceObserved { in_host_grammar: g, registration: r, unit_active: a, unit_enabled: e } =>
      g && runner_slot_registration_is_retired(r: r) && !a && !e
  }
}

fn runner_slot_provenance_wire(p: RunnerSlotProvenance) -> String {
  match p {
    SlotProvenanceUnobserved => "unobserved"
    SlotProvenanceObserved { in_host_grammar: g, registration: r, unit_active: a, unit_enabled: e } =>
      join([
        if g { "grammar" } else { "foreign" }, ",",
        runner_slot_registration_wire(r: r), ",",
        if a { "active" } else { "inactive" }, ",",
        if e { "enabled" } else { "disabled" },
      ], "")
  }
}

// THE NAME IS IN THE HOST'S GRAMMAR IFF THE ALLOCATION AUTHORITY RENDERS IT BACK. `<host>-<index>`
// is split, the index parsed, and the identity re-rendered through runner_slot_instance_name; a
// name that survives the round trip was produced by that renderer, zero-padding and all. No
// ceiling on the index is assumed, because retired trees come from widths that no longer exist.
fn runner_slot_name_in_host_grammar(host: HostIdentity, instance_name: NonEmptyStr) -> Bool {
  let name = instance_name as String
  let parts = name.split("-")
  let index_text = fold(parts, init: "", f: (acc, p) => p)
  if length(parts) != 2 || !starts_with(s: name, prefix: concat(host as String, "-")) {
    false
  } else {
    match parse_int(s: index_text) {
      Absent => false
      Present { value: i } =>
        i > 0
          && (runner_slot_instance_name(slot: RunnerSlotIdentity { host: host, slot_index: i }) as String) == name
    }
  }
}

type RunnerSlotObservation
  = RunnerSlotsObserved { members: List<RunnerSlotMember> }
  | RunnerSlotsUnobserved { reason: NonEmptyStr }

fn runner_slot_instance_dir(instance_name: NonEmptyStr) -> NonEmptyStr {
  join([actions_runner_base_dir, "/", instance_name as String], "") as NonEmptyStr
}

fn runner_slot_member_from_instance_name(instance_name: String) -> RunnerSlotMember {
  let name = instance_name as NonEmptyStr
  RunnerSlotMember {
    instance_name: name,
    slot_dir: runner_slot_instance_dir(instance_name: name),
    provenance: SlotProvenanceUnobserved,
  }
}

fn runner_slot_member_observed(instance_name: String, provenance: RunnerSlotProvenance) -> RunnerSlotMember {
  let name = instance_name as NonEmptyStr
  RunnerSlotMember {
    instance_name: name,
    slot_dir: runner_slot_instance_dir(instance_name: name),
    provenance: provenance,
  }
}

// THE FABRIC SLOT IS NOT A PROVISIONING TARGET, AND UNTIL 2026-08-23 IT WAS ONE.
//
// This mapped runner_instance_names straight through, so desired was 1..runner_count and nothing
// asked what any slot was FOR. gunbc.runner_slot_allocation authors srv3-06 as
// SlotServesFabricExecution, so the desired set proposed installing a GitHub Actions runner ON TOP
// OF THE FABRIC EXECUTION SLOT -- reconcile saw it as an ordinary missing member, and apply would
// have done it with no refusal anywhere.
//
// That is the count-as-authority failure runner_slot_allocation exists to prevent, reintroduced one
// layer above it. Its note records the first occurrence: purpose derived from index against count,
// so the fabric slot MOVED WITH THE WIDTH -- at width 7, srv3-07 became fabric and srv3-06 was
// silently handed back to Actions, relabelling a slot that may be running work. The carve was made
// an AUTHORED identity so a width change could not do that; this module consumed the width and
// ignored the carve, reaching the same outcome by the other road.
//
// THE FILTER IS ON THE FABRIC ROLE, NOT ON COMMITTED MEMBERSHIP, and that is load-bearing.
// Filtering on runner_slot_membership would ask whether each index is within the host's committed
// width -- the question runner_count already answered -- and yields ZERO desired members for any
// host the fleet model does not know. The reconcile fixtures plant their own synthetic deploy row
// (host_label "wfix") precisely so their expected counts are literals authored beside a known input
// rather than a restatement of the live fleet; routing desired through the global width authority
// would have emptied them and turned four exact-count fixtures green-by-vacuity.
//
// So the width still comes from the deploy row, which derives it from gunbc_runner_slots_per_host,
// and this function removes exactly the identities that are spoken for. Two questions, two answers:
// how many slots does this host carry, and which are Actions runners.
//
// It works on INDICES, not rendered names, so the fabric identity is compared as an identity and
// never by parsing a slot number back out of a string it was just formatted into.
//
// CONSEQUENCE ON THE FLEET: srv3 desires twenty against a committed width of twenty-one. srv1, srv2
// and srv4 carry no fabric member and are unchanged.
fn desired_runner_slot_members(deploy: RunnerHostDeploy) -> List<RunnerSlotMember> {
  let host = deploy.host_label as HostIdentity
  map(
    filter(
      runner_index_seq(n: deploy.runner_count),
      i => !identity_is_fabric_execution_member(
        identity: RunnerSlotIdentity { host: host, slot_index: i },
      ),
    ),
    i => runner_slot_member_from_instance_name(
      instance_name: runner_slot_instance_name(
        slot: RunnerSlotIdentity { host: host, slot_index: i },
      ),
    ),
  )
}

fn runner_slot_member_key(m: RunnerSlotMember) -> NonEmptyStr {
  m.instance_name
}

fn runner_slot_member_key_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  a as String == b as String
}

fn runner_slot_member_value_eq(a: RunnerSlotMember, b: RunnerSlotMember) -> Bool {
  a.slot_dir as String == b.slot_dir as String
}

// Ownership is NOT asserted for every observed slot-dir under /opt/actions-runner. R5
// teardown-owned-only requires a provenance signal (gunbc-managed systemd drop-in + unit template
// this lane writes) before apply lands; until host_effect observation can read that signal,
// ownership_of returns Absent so Removed out-of-band dirs yield MemberRemovalRefused rather than
// fabricated Owned (review 49707).

fn runner_slot_retired_incarnation_ownership() -> Ownership? {
  Present { value: Owned }
}

fn runner_slot_unknown_ownership() -> Ownership? {
  Absent
}

fn runner_slot_member_ownership(m: RunnerSlotMember) -> Ownership? {
  if runner_slot_provenance_is_retired_incarnation(p: m.provenance) {
    runner_slot_retired_incarnation_ownership()
  } else {
    runner_slot_unknown_ownership()
  }
}

fn runner_slot_membership_reconcile(
  desired: List<RunnerSlotMember>,
  observed: List<RunnerSlotMember>,
) -> MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt> {
  membership_plan_admitting_outcome(
    outcome: membership_reconcile(
      desired: desired,
      observed: observed,
      key_of: runner_slot_member_key,
      key_eq: runner_slot_member_key_eq,
      value_eq: runner_slot_member_value_eq,
      ownership_of: runner_slot_member_ownership,
    ),
  )
}

type RunnerSlotEnumerationPostcondition
  = RunnerSlotEnumerationMatched
  | RunnerSlotEnumerationMismatch {
      host: HostIdentity
      declared_count: Int
      observed_count: Int
    }

fn runner_slot_enumeration_postcondition(
  host: HostIdentity,
  observed: List<RunnerSlotMember>,
) -> RunnerSlotEnumerationPostcondition {
  let declared = gunbc_runner_slots_per_host(host: host)
  let observed_count = length(observed)
  if observed_count == declared {
    RunnerSlotEnumerationMatched
  } else {
    RunnerSlotEnumerationMismatch {
      host: host,
      declared_count: declared,
      observed_count: observed_count,
    }
  }
}

type RunnerSlotProvisionPlan {
  host_label: NonEmptyStr
  membership: MembershipPlan<RunnerSlotMember, RunnerSlotMemberAt>
  base_dir_script: String
  upsert_extract_scripts: List<String>
  retirement_scripts: List<String>
  teardown_scripts: List<String>
}

// THE ONE PLACE THE GRANT ROSTER MEETS THE INSTALL SHAPE. extdeps.github.actions_runner describes
// what runner installation IS; this module knows which principal performs it here and so which
// binaries that principal may execute. Both paths come from the closed CiRunnerSudoBinary
// vocabulary, so a verb with no grant row has no spelling at this seam.
// THE COMMANDS THE SCRIPT RUNS ARE PROJECTED FROM THE SAME OPERATION ROW THE SUDOERS GRANT IS.
// gunbc.executor_privileged_operation owns the operation; the executed shell word-vector and the
// authorizing sudoers match are both DERIVED from its argv. Before this, extdeps rebuilt the argv
// from two binary paths while the roster granted the binary alone, so the script could name a
// command the principal was not authorized to run -- measured on srv3, an add-only apply refused at
// the first sudo with zero slots mutated.
fn gunbc_runner_slot_privileged_commands(
  slot_dir: NonEmptyStr,
  job_user: NonEmptyStr,
) -> ActionsRunnerSlotPrivilegedCommands {
  ActionsRunnerSlotPrivilegedCommands {
    remove_command: executor_privileged_operation_shell_command(
      op: RemoveDirectoryTree { path: slot_dir },
    ),
    install_command: executor_privileged_operation_shell_command(
      op: EnsureOwnedDirectory {
        path: slot_dir,
        owner: job_user,
        group: job_user,
        mode: executor_managed_directory_mode,
      },
    ),
  }
}

// THE REMOVAL REALIZATION IS A PARAMETER, AND WITHOUT ONE NOTHING IS DELETED.
//
// `MemberRemoved` stays the membership answer. What changed is that its realization now consults
// `gunbc.runner_slot_retirement`, which separates permission from measurement from effect. The
// default a caller with no evidence supplies is `SlotRetirementEvidenceAbsent`, and that renders
// refusals rather than deletions -- so a route that has not been taught to observe retirement cannot
// silently keep deleting trees.
//
// WHY THE MASK IS EMITTED HERE RATHER THAN BY A SEPARATE ACTUATOR CALL: this is the existing removal
// transaction, and a second top-level path that masked slots beside it would be two authorities over
// one population. The retirement scripts and the teardown scripts are separate lists on the plan so
// apply can order them explicitly and so a reader can see that no pass does both to one unit.
fn runner_slot_provision_plan(
  deploy: RunnerHostDeploy,
  artifact: ActionsRunnerBinaryArtifact,
  observed: List<RunnerSlotMember>,
  retirement_evidence: SlotRetirementEvidence,
) -> RunnerSlotProvisionPlan {
  let membership = runner_slot_membership_reconcile(
    desired: desired_runner_slot_members(deploy: deploy),
    observed: observed,
  )
  RunnerSlotProvisionPlan {
    host_label: deploy.host_label,
    membership: membership,
    base_dir_script: actions_runner_base_dir_ensure_script(
      base_install_command: executor_privileged_operation_shell_command(
        op: EnsureOwnedDirectory {
          path: actions_runner_base_dir as NonEmptyStr,
          owner: deploy.runner_user,
          group: deploy.runner_user,
          mode: executor_managed_directory_mode,
        },
      ),
      cache_install_command: executor_privileged_operation_shell_command(
        op: EnsureOwnedDirectory {
          path: actions_runner_cache_dir as NonEmptyStr,
          owner: deploy.runner_user,
          group: deploy.runner_user,
          mode: executor_managed_directory_mode,
        },
      ),
    ),
    upsert_extract_scripts: flat_map(membership.actions, a =>
      match a {
        MemberAdded { at: _, to: m } =>
          [actions_runner_slot_extract_script(
            artifact: artifact,
            slot_dir: m.slot_dir,
            privileged: gunbc_runner_slot_privileged_commands(
              slot_dir: m.slot_dir,
              job_user: deploy.job_user,
            ),
          )]
        MemberChanged { at: _, from: _, to: _ } => []
        MemberRemoved { at: _, from: _ } => []
        MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
    ),
    retirement_scripts: retirement_actuation_units(
      deploy: deploy,
      membership: membership,
      evidence: retirement_evidence,
    ) |> map(u => retirement_mask_line(unit: u)),
    teardown_scripts: concat(
      flat_map(membership.actions, a =>
      match a {
        MemberRemoved { at: _, from: m } =>
          match slot_removal_realization(
            evidence: retirement_evidence,
            unit: slot_member_unit_name(m: m) as String,
          ) {
            RemovalTeardownAuthorized { unit: _ } =>
              [executor_privileged_operation_shell_command(op: RemoveDirectoryTree { path: m.slot_dir })]
            RemovalActuationRequired { unit: u } =>
              [slot_removal_withheld_line(unit: u, tree: m.slot_dir, cause: "retirement was actuated on this pass; the postcondition is observed independently on the next one")]
            RemovalRetirementPending { unit: u, cause: c } =>
              [slot_removal_withheld_line(unit: u, tree: m.slot_dir, cause: c)]
            RemovalRetirementRefused { unit: u, cause: c } =>
              [slot_removal_withheld_line(unit: u, tree: m.slot_dir, cause: c)]
          }
        MemberAdded { at: _, to: _ } => []
        MemberChanged { at: _, from: _, to: _ } => []
        MemberRemovalRefused { from: _, cause: _ } => []
        MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => []
      }
      ),
      obligation_withheld_scripts(
        deploy: deploy,
        membership: membership,
        evidence: retirement_evidence,
      ),
    ),
  }
}

// THE TEARDOWN ARGV IS THE ONE THE GRANT ROSTER ALREADY SPELLS, rendered through the same seam.
//
// THIS NOTE PREVIOUSLY CLAIMED A SUDO BRAKE THAT DOES NOT EXIST, and the correction matters because
// the claim was load-bearing in the wrong direction: it said the roster enrolls only DESIRED slot
// dirs, so a retired tree outside the current width would refuse at apply and a narrowing host was
// therefore protected by sudoers. Measured against the grant authority, that is false.
// `gunbc.runner_host_grants` enrolls `RemoveDirectoryTree` for every slot in the host's grammar up to
// `runner_slot_teardown_grant_index_bound`, which is 64 -- so slots 13..21 are squarely inside the
// granted population and a narrowing host has no privilege-level obstacle to deleting them.
//
// WHY A STALE SAFETY CLAIM IS WORSE THAN NO CLAIM: it was cited, by me, as the reason a destructive
// path was survivable while its real guard was being examined. Sudo denial must not be treated as a
// safety mechanism in the model or the plan. Whether each host's INSTALLED sudoers bytes match the
// current artifact is a separate readback question, and the answer cannot be assumed in either
// direction -- which is exactly why the guard has to live where the plan can see it.
data runner_slot_teardown_grant_note: String = "retired-tree removal rides RemoveDirectoryTree through executor_privileged_operation_shell_command; the grant roster enrolls the host slot grammar to runner_slot_teardown_grant_index_bound (64), so slots outside the current desired width ARE granted and sudo denial is not a teardown brake"

fn runner_slot_provision_has_width_increase(plan: RunnerSlotProvisionPlan) -> Bool {
  membership_added_count(plan: plan.membership) > 0
}

// --- observation: the third converge member family -------------------------------------------

// AN UNREADABLE HOST REFUSES; AN EMPTY HOST DOES NOT. Collapsing them is the empty-observation
// narrow: rendering 'I could not enumerate the slots' as 'this host has no slots' makes the
// reconcile propose ADDING every desired slot to a machine whose real population was never read,
// which on apply means installing over a live fleet. RunnerSlotsUnobserved carries the CAUSE AND
// NOT THE HOST, a correction rather than an omission: this observer runs LocalExec on whatever
// machine it is on and cannot name it, so a host field here could only be fabricated. Briefly it
// was -- as the empty string, which is not a HostIdentity, so the fabrication refused to typecheck:
// the carrier shape doing a review's work. The caller supplies the host it is converging; the
// observation reports only what it established. RunnerSlotsObserved with an empty list is a genuine
// answer about a genuinely empty host.
//
// THE SIBLING FAMILIES DO NOT DRAW THIS LINE AND THAT IS THE DEFECT NOT TO COPY.
// gunbc.fleet_converge_plan_cli observe_cap_members_wet yields [] both when a drop-in is absent and
// when it cannot be read, and observe_timer_members_wet filters on a test that cannot distinguish
// 'no such unit' from 'could not run the test'. Tolerable for caps, where an absent drop-in is the
// common real state; not for slots, where absent means 'provision it'.
//
// ENUMERATION IS BY DIRECTORY, NOT BY PROBING THE DESIRED NAMES. Asking 'does each name I expect
// exist' returns only a subset of what was already intended, so an out-of-band slot nobody desired
// would be invisible and never reported as MemberRemoved. Listing the base directory makes the
// observed population independent of the desired one, which is the whole point of a reconcile.

fn observe_runner_slot_members_wet() -> RunnerSlotObservation
  uses net: Network
{
  match run_shell_command_capture(
    command: ls_one_per_line_command(path: actions_runner_base_dir),
    transport: LocalExec,
  ) {
    ProcessRefused { exit_code: code, stderr: err } =>
      RunnerSlotsUnobserved {
        reason: concat(
          concat("could not enumerate ", actions_runner_base_dir),
          concat(": the listing refused rather than returning an empty directory, so this host's slot population is UNKNOWN and must not be read as empty. stderr: ", err)
        ) as NonEmptyStr,
      }
    ProcessOutputAbsent =>
      RunnerSlotsUnobserved {
        reason: concat(
          concat("enumerating ", actions_runner_base_dir),
          " produced no output at all -- not an empty listing, which would be an empty string. A command that yields nothing has not answered the question, and treating it as 'no slots' would propose installing every desired slot onto a host whose population was never read."
        ) as NonEmptyStr,
      }
    ProcessOutputPresent { text: t } =>
      RunnerSlotsObserved {
        members: map(
          filter(t.split("\n"), l => trim(s: l) != ""),
          l => runner_slot_member_from_instance_name(instance_name: trim(s: l)),
        ),
      }
  }
}

type RunnerSlotConvergeVerdict
  = RunnerSlotConvergePlanned { host: HostIdentity, plan: RunnerSlotProvisionPlan }
  | RunnerSlotConvergeRefused { host: HostIdentity, reason: NonEmptyStr }

// THE REFUSAL ARM IS WHY THIS FUNCTION EXISTS RATHER THAN CALLERS COMPOSING THE TWO HALVES. A
// caller holding an observation and a deploy row can always pass the observed members straight
// into runner_slot_provision_plan, and the unobserved case becomes a list nobody looked at. Routing
// both through one verdict means the only way to reach a plan is to have read the host, and an
// unmodeled host or unreadable directory produces a refusal naming which it was.

fn runner_slot_converge_verdict(
  host: HostIdentity,
  deploy: RunnerHostDeploy,
  artifact: ActionsRunnerBinaryArtifact,
  observation: RunnerSlotObservation,
  retirement_evidence: SlotRetirementEvidence,
) -> RunnerSlotConvergeVerdict {
  match observation {
    RunnerSlotsUnobserved { reason: r } =>
      RunnerSlotConvergeRefused { host: host, reason: r }
    RunnerSlotsObserved { members: obs } =>
      RunnerSlotConvergePlanned {
        host: host,
        plan: runner_slot_provision_plan(
          deploy: deploy,
          artifact: artifact,
          observed: obs,
          retirement_evidence: retirement_evidence,
        ),
      }
  }
}
