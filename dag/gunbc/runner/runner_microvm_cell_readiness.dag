module gunbc.runner_microvm_cell_readiness

import std.types { String, NonEmptyStr, Bool, List, Int, Map }
import std.disposition { Disposition, SingleAuthority }
import product.fabric.sanitation {
  CellId, CellReadiness, CellReady, CellQuarantined, UnprovenFact, FactNotObserved,
  required_sanitation_facts, SlotScopedNetwork,
}
import gunbc.build_cache_instance { runner_slot_instance_name }
import gunbc.runner_microvm_attempt { MicroVmAttempt, runner_microvm_attempt_unit_name }

data runner_microvm_cell_readiness_disposition: Disposition = SingleAuthority

// THE HOST-LOCAL RECORD OF WHETHER A CELL MAY RUN ITS NEXT INCARNATION.
//
// product.fabric.sanitation decides CellReadiness from ONE readback. This module holds what that
// verdict means ACROSS attempts, which is a different question with its own failure modes: a
// readback can arrive late, a controller can die between staging and readback, and the store the
// verdict lives in can itself be unreadable or writable by someone other than root. None of those
// may turn into admission, so each is a typed arm rather than a default.
//
// THE UNIT OF THE STORE IS (cell, generation). A generation is the allocation generation an
// incarnation ran as; the next incarnation runs as generation + 1 and is admitted only when the
// record for generation says CellReady. Keying on the cell alone is what would let a readback of
// attempt N clear the quarantine of attempt N + 1: the verdicts would be indistinguishable.
//
// A record is either IN FLIGHT or SETTLED, and the in-flight arm is the durable half of boot
// recovery. It is written before anything is staged, so a controller lost at any later point
// leaves a record that says "cleanup owed" rather than a settled Ready from the previous attempt
// that would readmit a cell whose VMM may still be running.
//
// THE IN-FLIGHT RECORD PERSISTS THE ATTEMPT ITSELF, NOT A NAME FOR IT. An opaque attempt string lets a
// record keyed for cell A carry an attempt that belongs to cell B, and recovery would then tear down
// -- and settle -- the wrong cell's attempt under A's key (side-chat ruling on #11670). The attempt's
// slot DERIVES its cell, so the key and the attempt are checked against each other where the store is
// read, and an attempt the key disagrees with makes the store unsound rather than recoverable.
type InFlightAttempt {
  attempt: MicroVmAttempt
  invocation_id: NonEmptyStr
  jit_registration_id: NonEmptyStr
}

type CellReadinessRecord
  = CellAttemptInFlight { cell: CellId, generation: Int, attempt: InFlightAttempt }
  | CellSettled { cell: CellId, generation: Int, readiness: CellReadiness }

fn in_flight_attempt_cell(attempt: InFlightAttempt) -> CellId {
  runner_slot_instance_name(slot: attempt.attempt.slot) as CellId
}

fn in_flight_attempt_unit(attempt: InFlightAttempt) -> NonEmptyStr {
  runner_microvm_attempt_unit_name(attempt: attempt.attempt)
}

fn in_flight_attempt_same(a: InFlightAttempt, b: InFlightAttempt) -> Bool {
  (in_flight_attempt_unit(attempt: a) as String) == (in_flight_attempt_unit(attempt: b) as String)
    && (a.invocation_id as String) == (b.invocation_id as String)
    && (a.jit_registration_id as String) == (b.jit_registration_id as String)
}

// THE ONE CARRIER FOR "THIS ATTEMPT, ON THIS CELL, AT THIS GENERATION". Sealed, and constructible only
// by bind_attempt_to_cell, which refuses an attempt whose derived cell is not the cell it is bound to.
// Every write that names an attempt, every recovery, and every teardown settlement takes this rather
// than a cell and an attempt supplied independently.
type CellBoundAttempt sole_constructor {
  cell: CellId
  generation: Int
  attempt: InFlightAttempt
}

type AttemptCellBinding
  = AttemptBoundToCell { bound: CellBoundAttempt }
  | AttemptCellMismatch { cell: CellId, attempt_cell: CellId }

fn bind_attempt_to_cell(cell: CellId, generation: Int, attempt: InFlightAttempt) -> AttemptCellBinding {
  if (in_flight_attempt_cell(attempt: attempt) as String) == (cell as String) {
    AttemptBoundToCell { bound: CellBoundAttempt { cell: cell, generation: generation, attempt: attempt } }
  } else {
    AttemptCellMismatch { cell: cell, attempt_cell: in_flight_attempt_cell(attempt: attempt) }
  }
}

fn record_cell(record: CellReadinessRecord) -> CellId {
  match record {
    CellAttemptInFlight { cell: c, generation: _, attempt: _ } => c
    CellSettled { cell: c, generation: _, readiness: _ } => c
  }
}

fn record_generation(record: CellReadinessRecord) -> Int {
  match record {
    CellAttemptInFlight { cell: _, generation: g, attempt: _ } => g
    CellSettled { cell: _, generation: g, readiness: _ } => g
  }
}

// ROOT OWNERSHIP IS OBSERVED, NOT ASSUMED, because a store any tenant can write is a store any
// tenant can mark Ready. The observation is the host's stat of the store, and a store that is not
// root-owned and root-only-writable withdraws the WHOLE HOST: every record in it is suspect, not
// one cell's.
type CellReadinessStoreOwnership
  = StoreRootOwned
  | StoreNotRootOwned { owner_uid: Int, mode: NonEmptyStr }

// AN UNREADABLE STORE IS A THIRD STATE, NOT AN EMPTY ONE. Reading "no records" out of a store that
// could not be opened is the empty-observation narrow: it would report every cell as never
// settled -- which refuses, so it is safe -- but it would report it at CELL grain and send an
// operator to every cell instead of to the store. It is kept distinct so the withdrawal lands at
// the grain whose remedy it is.
type CellReadinessStoreRead
  = StoreRead { ownership: CellReadinessStoreOwnership, records: List<CellReadinessRecord> }
  | StoreUnreadable { reason: NonEmptyStr }

// WITHDRAWAL HAS TWO GRAINS AND THEY ARE NOT INTERCHANGEABLE.
//
// HOST grain: the evidence every cell's admission rests on is itself unsound -- the store cannot be
// read, is not root's, holds two records for one cell, or holds a settled record whose readiness names
// a different cell -- so no cell on the host may start,
// including cells whose last record happens to read Ready. CELL grain: the store is sound and says
// THIS cell is not ready. Folding host grain into per-cell refusals would admit the next cell whose
// record is intact inside a store nobody should trust; folding cell grain into host grain would let
// one leaked VMM take a host's whole warm pool out of service.
type HostWithdrawal
  = HostStoreUnreadable { reason: NonEmptyStr }
  | HostStoreNotRootOwned { owner_uid: Int, mode: NonEmptyStr }
  | HostStoreAmbiguous { cell: CellId }
  | HostStoreRecordIncoherent { record_cell: CellId, named_cell: CellId }

// THE STORE IS INDEXED ONCE, WHOLE, BEFORE ANY CELL IS PROJECTED OUT OF IT. Host grain is a property
// of the store, not of the cell being asked about: a duplicate for cell B, or a record whose
// readiness names a different cell than its key, makes the store unsound for cell A too. Filtering to
// the requested cell first and then checking would withdraw only when the defect happened to be in
// that cell, which is the host-grain fact demoted to cell grain (side-chat ruling on #11670). The
// index is sealed: the only way to hold one is to have passed both checks over every record, and the
// keyed map makes the uniqueness check one insert per record rather than a scan per record.
type CellReadinessIndex sole_constructor {
  by_cell: Map<String, CellReadinessRecord>
}

type CellReadinessIndexing
  = StoreIndexed { index: CellReadinessIndex }
  | StoreIndexRefused { withdrawal: HostWithdrawal }

fn readiness_cell(readiness: CellReadiness) -> CellId {
  match readiness {
    CellReady { cell: c } => c
    CellQuarantined { cell: c, unproven: _ } => c
  }
}

// A record is coherent when everything inside it names the cell it is keyed by: a settled record's
// readiness, and an in-flight record's attempt (through the slot the attempt was built on).
fn record_incoherence(record: CellReadinessRecord) -> HostWithdrawal? {
  match record {
    CellAttemptInFlight { cell: c, generation: g, attempt: a } =>
      match bind_attempt_to_cell(cell: c, generation: g, attempt: a) {
        AttemptBoundToCell { bound: _ } => none
        AttemptCellMismatch { cell: rc, attempt_cell: ac } =>
          Present { value: HostStoreRecordIncoherent { record_cell: rc, named_cell: ac } }
      }
    CellSettled { cell: c, generation: _, readiness: r } =>
      if (readiness_cell(readiness: r) as String) == (c as String) {
        none
      } else {
        Present { value: HostStoreRecordIncoherent { record_cell: c, named_cell: readiness_cell(readiness: r) } }
      }
  }
}

// THE FIRST DEFECT IS CARRIED, not overwritten by a later one: the store is refused as a whole and the
// reader needs the first thing that made it unsound.
fn index_step(acc: CellReadinessIndexing, record: CellReadinessRecord) -> CellReadinessIndexing {
  match acc {
    StoreIndexRefused { withdrawal: w } => StoreIndexRefused { withdrawal: w }
    StoreIndexed { index: ix } =>
      match record_incoherence(record: record) {
        Present { value: w } => StoreIndexRefused { withdrawal: w }
        Absent =>
          match map_get(ix.by_cell, record_cell(record: record) as String) {
            Present { value: _ } => StoreIndexRefused { withdrawal: HostStoreAmbiguous { cell: record_cell(record: record) } }
            Absent => StoreIndexed { index: CellReadinessIndex { by_cell: map_insert(ix.by_cell, record_cell(record: record) as String, record) } }
          }
      }
  }
}

fn index_cell_readiness(records: List<CellReadinessRecord>) -> CellReadinessIndexing {
  fold(records, init: StoreIndexed { index: CellReadinessIndex { by_cell: empty_map() } }, f: (acc, r) => index_step(acc: acc, record: r))
}

fn indexed_record(index: CellReadinessIndex, cell: CellId) -> CellReadinessRecord? {
  map_get(index.by_cell, cell as String)
}

type CellWithdrawal
  = CellNeverSettled
  | CellQuarantinedAt { generation: Int, unproven: List<UnprovenFact> }
  | CellGenerationMismatch { settled: Int, allocated: Int }

// THE ADMISSION, AND IT JOINS THREE FACTS AT ONE PLACE: the allocation's generation, the store's
// readiness, and the generation that readiness was established at. CellRecoveryRequired is not a
// withdrawal: it says the previous incarnation never settled and a teardown must run to completion
// BEFORE this question can be asked again -- boot recovery resumes cleanup before admission.
type CellIncarnationAdmission
  = CellIncarnationAdmitted { cell: CellId, generation: Int }
  | CellRecoveryRequired { bound: CellBoundAttempt }
  | CellWithdrawn { cell: CellId, withdrawal: CellWithdrawal }
  | HostWithdrawn { withdrawal: HostWithdrawal }

fn cell_incarnation_admission(
  store: CellReadinessStoreRead,
  cell: CellId,
  allocation_generation: Int,
) -> CellIncarnationAdmission {
  match store {
    StoreUnreadable { reason: r } => HostWithdrawn { withdrawal: HostStoreUnreadable { reason: r } }
    StoreRead { ownership: o, records: rs } =>
      match o {
        StoreNotRootOwned { owner_uid: u, mode: m } =>
          HostWithdrawn { withdrawal: HostStoreNotRootOwned { owner_uid: u, mode: m } }
        StoreRootOwned =>
          match index_cell_readiness(records: rs) {
            StoreIndexRefused { withdrawal: w } => HostWithdrawn { withdrawal: w }
            StoreIndexed { index: ix } =>
              admission_of_indexed_cell(index: ix, cell: cell, allocation_generation: allocation_generation)
          }
      }
  }
}

fn admission_of_indexed_cell(
  index: CellReadinessIndex,
  cell: CellId,
  allocation_generation: Int,
) -> CellIncarnationAdmission {
  match indexed_record(index: index, cell: cell) {
    Absent => CellWithdrawn { cell: cell, withdrawal: CellNeverSettled }
    Present { value: r } => admission_of_record(record: r, allocation_generation: allocation_generation)
  }
}

fn admission_of_record(record: CellReadinessRecord, allocation_generation: Int) -> CellIncarnationAdmission {
  match record {
    CellAttemptInFlight { cell: c, generation: g, attempt: a } =>
      match bind_attempt_to_cell(cell: c, generation: g, attempt: a) {
        AttemptBoundToCell { bound: b } => CellRecoveryRequired { bound: b }
        AttemptCellMismatch { cell: rc, attempt_cell: ac } =>
          HostWithdrawn { withdrawal: HostStoreRecordIncoherent { record_cell: rc, named_cell: ac } }
      }
    CellSettled { cell: c, generation: g, readiness: readiness } =>
      match readiness {
        CellQuarantined { cell: _, unproven: u } =>
          CellWithdrawn { cell: c, withdrawal: CellQuarantinedAt { generation: g, unproven: u } }
        CellReady { cell: _ } =>
          if g + 1 == allocation_generation {
            CellIncarnationAdmitted { cell: c, generation: allocation_generation }
          } else {
            CellWithdrawn { cell: c, withdrawal: CellGenerationMismatch { settled: g, allocated: allocation_generation } }
          }
      }
  }
}

// WRITES ARE MONOTONE IN THE GENERATION, AND QUARANTINE ONLY TIGHTENS WITHIN ONE.
//
// A write at a LOWER generation than the stored record is a stale readback and is refused: it is
// how a slow readback of attempt N would clear attempt N + 1's quarantine. At the SAME generation a
// settled Ready may be tightened to Quarantined and an in-flight record may settle (its own
// attempt's readback), but a Quarantined record is never loosened: clearing a quarantine is a NEW
// readback that establishes the facts, and it is recorded at a new generation so the clearing event
// is distinguishable from a late copy of the old one.
//
// UNATTRIBUTED RESIDUE HAS NO ATTEMPT TO NAME, SO IT HAS ITS OWN WRITE AND THAT WRITE CAN ONLY
// QUARANTINE. Residue found on a cell the store called Ready belongs to no attempt the store knows,
// and inventing one -- the cell's name, the previous generation -- would be a record claiming an
// identity nobody observed. It carries no readiness parameter: its record is a quarantine with every
// sanitation fact a microVM cell owes (slot-scoped network) unobserved, at the generation that was about to run, and only a later readback at
// a higher generation that establishes the facts can clear it.
type CellReadinessWrite
  = WriteAttemptStarted { bound: CellBoundAttempt }
  | WriteReadbackSettled { bound: CellBoundAttempt, readiness: CellReadiness }
  | WriteUnattributedResidue { cell: CellId, generation: Int }

type CellReadinessWriteResult
  = WriteAccepted { records: List<CellReadinessRecord> }
  | WriteRefusedStale { cell: CellId, stored: Int, offered: Int }
  | WriteRefusedWouldLoosenQuarantine { cell: CellId, generation: Int }
  | WriteRefusedAttemptMismatch { cell: CellId, stored_attempt: NonEmptyStr, offered_attempt: NonEmptyStr }
  | WriteRefusedAttemptAlreadyRecorded { cell: CellId, generation: Int }
  | WriteRefusedNotAdmitted { cell: CellId, admission: CellIncarnationAdmission }
  | WriteRefusedStoreUnsound { withdrawal: HostWithdrawal }
  | WriteRefusedIncoherent { withdrawal: HostWithdrawal }

fn write_cell(write: CellReadinessWrite) -> CellId {
  match write {
    WriteAttemptStarted { bound: b } => b.cell
    WriteReadbackSettled { bound: b, readiness: _ } => b.cell
    WriteUnattributedResidue { cell: c, generation: _ } => c
  }
}

fn record_of_write(write: CellReadinessWrite) -> CellReadinessRecord {
  match write {
    WriteAttemptStarted { bound: b } => CellAttemptInFlight { cell: b.cell, generation: b.generation, attempt: b.attempt }
    WriteReadbackSettled { bound: b, readiness: r } => CellSettled { cell: b.cell, generation: b.generation, readiness: r }
    WriteUnattributedResidue { cell: c, generation: g } =>
      CellSettled {
        cell: c,
        generation: g,
        readiness: CellQuarantined { cell: c, unproven: map(required_sanitation_facts(scope: SlotScopedNetwork), f => FactNotObserved { fact: f }) },
      }
  }
}

// AN ATTEMPT START IS NOT A READBACK, so a higher generation alone does not admit it: it is written
// only over a settled Ready at exactly the previous generation, which is the admission above
// restated at the write -- the store refuses to record a start the admission would have refused,
// rather than trusting every writer to have asked first. The first incarnation on a cell therefore
// needs a readback establishing the empty cell before it, exactly like every later one.
//
// THE WRITE IS JUDGED AGAINST THE SAME SEALED INDEX THE ADMISSION READS, so an unsound store refuses
// every write rather than accepting one into a store no reader will trust, and a write whose own
// record would be incoherent is refused before it can make the store unsound.
fn apply_cell_readiness_write(
  records: List<CellReadinessRecord>,
  write: CellReadinessWrite,
) -> CellReadinessWriteResult {
  match index_cell_readiness(records: records) {
    StoreIndexRefused { withdrawal: w } => WriteRefusedStoreUnsound { withdrawal: w }
    StoreIndexed { index: ix } =>
      match record_incoherence(record: record_of_write(write: write)) {
        Present { value: w } => WriteRefusedIncoherent { withdrawal: w }
        Absent => apply_indexed_write(records: records, index: ix, write: write)
      }
  }
}

fn apply_indexed_write(
  records: List<CellReadinessRecord>,
  index: CellReadinessIndex,
  write: CellReadinessWrite,
) -> CellReadinessWriteResult {
  let cell = write_cell(write: write)
  let others = filter(records, r => (record_cell(record: r) as String) != (cell as String))
  let replaced = concat(others, [record_of_write(write: write)])
  match write {
    WriteAttemptStarted { bound: b } =>
      match admission_of_indexed_cell(index: index, cell: b.cell, allocation_generation: b.generation) {
        CellIncarnationAdmitted { cell: _, generation: _ } => WriteAccepted { records: replaced }
        refused => WriteRefusedNotAdmitted { cell: b.cell, admission: refused }
      }
    WriteUnattributedResidue { cell: c, generation: g } =>
      match indexed_record(index: index, cell: c) {
        Absent => WriteAccepted { records: replaced }
        Present { value: stored } =>
          if g < record_generation(record: stored) {
            WriteRefusedStale { cell: c, stored: record_generation(record: stored), offered: g }
          } else {
            WriteAccepted { records: replaced }
          }
      }
    WriteReadbackSettled { bound: b, readiness: r } =>
      match indexed_record(index: index, cell: b.cell) {
        Absent => WriteAccepted { records: replaced }
        Present { value: stored } => {
          let held = record_generation(record: stored)
          if b.generation < held {
            WriteRefusedStale { cell: b.cell, stored: held, offered: b.generation }
          } else if b.generation > held {
            WriteAccepted { records: replaced }
          } else {
            same_generation_settle(stored: stored, bound: b, readiness: r, replaced: replaced)
          }
        }
      }
  }
}

// Called only from the WriteReadbackSettled arm, with that arm's fields rather than the write: the
// other write shapes are not representable here, so there is no arm for them to answer (review 68138).
fn same_generation_settle(
  stored: CellReadinessRecord,
  bound: CellBoundAttempt,
  readiness: CellReadiness,
  replaced: List<CellReadinessRecord>,
) -> CellReadinessWriteResult {
  let cell = bound.cell
  let generation = bound.generation
  match stored {
    CellAttemptInFlight { cell: _, generation: _, attempt: sa } =>
      if in_flight_attempt_same(a: sa, b: bound.attempt) {
        WriteAccepted { records: replaced }
      } else {
        WriteRefusedAttemptMismatch {
          cell: cell,
          stored_attempt: in_flight_attempt_unit(attempt: sa),
          offered_attempt: in_flight_attempt_unit(attempt: bound.attempt),
        }
      }
    CellSettled { cell: _, generation: _, readiness: held } =>
      match held {
        CellQuarantined { cell: _, unproven: _ } => WriteRefusedWouldLoosenQuarantine { cell: cell, generation: generation }
        CellReady { cell: _ } =>
          match readiness {
            CellQuarantined { cell: _, unproven: _ } => WriteAccepted { records: replaced }
            CellReady { cell: _ } => WriteRefusedAttemptAlreadyRecorded { cell: cell, generation: generation }
          }
      }
  }
}
