// THE IMAGE LEG'S PRODUCTION CALLER (gunbc.runner.runner_throughput_qualification_route mtcollins1_image_leg).
// It derives the runner image from the authority (gunbc.runner.runner_host_medium runner_host_medium_image)
// for mtcollins1 -- the host parameters are the census's own machine name and serial console, so the
// envelope and the kernel's console agree with the boot subject -- and publishes it create-only into the
// BMC export through the one seeded-image publication fold, on the export's serving host over fleet SSH
// (srv2 has no runner slot). The publication measures the built bytes, names the image by that digest,
// and reads the published file back before it reports; the receipt below is the digest the boot leg's
// runner_host_boot_medium row carries.
data mtcollins1_runner_host: RunnerHostMediumHost = RunnerHostMediumHost {
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  console_kernel_arg: mtcollins1_census_console_arg,
}

type RunnerImagePublishAttempt
  = RunnerImageNotDerived { reason: String }
  | RunnerImagePublishRan { publication: SeededImagePublication, link: ServedLinkReading }

// THE SERVED LINK (gunbc.host.boot_medium_reader_key boot_medium_served_link_path) IS THIS PUBLISH'S TO
// SET. The boot medium reader key is forced to sha256sum that one fixed path, so the publish that names
// the runner image points the link at it and reads the link back. The link is set only after the
// publication holds, so it never names an image that was not read back; the reading is readlink's
// answer, which must be exactly the published path.
type ServedLinkReading
  = ServedLinkPointsAt { link_path: NonEmptyStr, target: NonEmptyStr }
  | ServedLinkNotSet { reason: String }
  | ServedLinkDisagrees { link_path: NonEmptyStr, expected: NonEmptyStr, read: String }

fn published_image_path(p: SeededImagePublication) -> NonEmptyStr? {
  if seeded_image_publication_holds(p: p) {
    match p {
      SeededImagePublished { built: _, path: path, work: _, staging_residue: _ } => Present { value: path }
      SeededImageAlreadyPublished { built: _, path: path } => Present { value: path }
      SeededImagePublicationRefused { reason: _, work: _ } => none
      SeededImagePublishedRecordNotWritten { built: _, path: _, work: _, staging_residue: _, record: _ } => none
    }
  } else {
    none
  }
}

fn served_link_after(publication: SeededImagePublication, set: fn(NonEmptyStr) -> HostCommandOutcome, read: fn() -> HostCommandOutcome) -> ServedLinkReading {
  let link = boot_medium_served_link_path()
  match published_image_path(p: publication) {
    Absent => ServedLinkNotSet { reason: "the publication did not hold, so the served link was left as it was" }
    Present { value: path } =>
      match set(path) {
        HostCommandDone { stdout: _ } =>
          match read() {
            HostCommandDone { stdout: o } =>
              if trim(s: o) == (path as String) { ServedLinkPointsAt { link_path: link, target: path } } else { ServedLinkDisagrees { link_path: link, expected: path, read: trim(s: o) } }
            HostCommandFailed { exit_code: c, stderr: e } => ServedLinkNotSet { reason: concat("the link was set but could not be read back: ", host_command_outcome_text(e: HostCommandFailed { exit_code: c, stderr: e })) }
            HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e } => ServedLinkNotSet { reason: concat("the link was set but its readback is unconfirmed: ", host_command_outcome_text(e: HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e })) }
            HostCommandNotDispatched { reason: r } => ServedLinkNotSet { reason: concat("the link was set but its readback was not dispatched: ", r) }
          }
        HostCommandFailed { exit_code: c, stderr: e } => ServedLinkNotSet { reason: host_command_outcome_text(e: HostCommandFailed { exit_code: c, stderr: e }) }
        HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e } => ServedLinkNotSet { reason: host_command_outcome_text(e: HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e }) }
        HostCommandNotDispatched { reason: r } => ServedLinkNotSet { reason: concat("not dispatched: ", r) }
      }
  }
}

fn served_link_on(host: CommandHost, publication: SeededImagePublication) -> ServedLinkReading {
  let link = boot_medium_served_link_path()
  served_link_after(
    publication: publication,
    set: fn(path) { host_command(host: host, command: ln_symbolic_force_command(target: path as String, link_name: link as String)) },
    read: fn() { host_command(host: host, command: readlink_command(path: link as String)) },
  )
}

fn served_link_holds(l: ServedLinkReading) -> Bool {
  match l {
    ServedLinkPointsAt { link_path: _, target: _ } => true
    ServedLinkNotSet { reason: _ } => false
    ServedLinkDisagrees { link_path: _, expected: _, read: _ } => false
  }
}

fn render_served_link(l: ServedLinkReading) -> String {
  match l {
    ServedLinkPointsAt { link_path: p, target: t } => join(["served_link=", p as String, "\nserved_link_target=", t as String, "\n"], "")
    ServedLinkNotSet { reason: r } => join(["served_link=not set\nserved_link_reason=", r, "\n"], "")
    ServedLinkDisagrees { link_path: p, expected: e, read: r } => join(["served_link=", p as String, "\nserved_link_disagrees=expected ", e as String, ", read ", r, "\n"], "")
  }
}

fn runner_image_publication_on(host: CommandHost, image: RunnerHostMediumImage) -> RunnerImagePublishAttempt {
  match image {
    RunnerHostMediumRunnerUnpublished { binary_release: r } =>
      RunnerImageNotDerived { reason: concat("no arm64 runner tarball is published for release ", r.version as String) }
    RunnerHostMediumUserDataRefused { reason: r } => RunnerImageNotDerived { reason: concat("the user-data document does not render: ", r) }
    RunnerHostMediumImageDerived { input: i, runner: _ } => {
      let publication = publish_seeded_image(host: host, input: i, stock_path: census_image_stock_path(), boundary: BmcExportBoundary { export_dir: bmc_boot_image_export.dir })
      RunnerImagePublishRan { publication: publication, link: served_link_on(host: host, publication: publication) }
    }
  }
}

fn runner_image_attempt_holds(a: RunnerImagePublishAttempt) -> Bool {
  match a {
    RunnerImageNotDerived { reason: _ } => false
    RunnerImagePublishRan { publication: p, link: l } =>
      seeded_image_publication_holds(p: p) && served_link_holds(l: l)
  }
}

fn render_runner_image_attempt(a: RunnerImagePublishAttempt) -> String {
  match a {
    RunnerImageNotDerived { reason: r } => concat("publication=not attempted\npublication_reason=", r, "\n")
    RunnerImagePublishRan { publication: p, link: l } =>
      concat(render_seeded_image_publication(p: p), render_served_link(l: l))
  }
}

data mtcollins1_runner_image_receipt_path: String = "target/mtcollins1-runner-image.txt"

// THE BAKED RELEASE IS BUILT BY THIS RUN (gunbc.plans.mtcollins1_ci_service_legs (deleted 2026-11-08) F1; merry-fox-82, 2026-10-27, decision
// A and its conditions; 2026-11-07, decision B on #15335): on this run's own aarch64 fleet runner, at the run's checkout
// (GITHUB_SHA), the release-locus tree is staged through the one tree install in its STAGED realm
// (gunbc.host.host_effect_realize tree_install_in_realm, TreeInstallStaged: unelevated, confined to the staging root,
// ownership declared by the archive), packed reproducibly (owner 0, modes kept), measured, copied to the export host,
// and READ BACK THERE: the export host's own sha256 of the copy must equal the measured one, or nothing is built. The
// revision is the checkout's and nothing more; that a slot may RUN it is the slot start's admission
// (gunbc.runner.runner_service_slot_start service_slot_start_admitted), not this build's.
type BakedReleaseBuild
  = BakedReleaseBuilt { baked: RunnerHostBakedRelease }
  | BakedReleaseNotBuilt { reason: String }

// WHERE THE BUILD STAGES AND PACKS, under the checkout's target/ (the run's own working tree; nothing outside it is
// written, and the staged realm refuses a write outside stage_root).
type BakedReleaseBuildPlan {
  revision: CommitSha
  source_root: String
  stage_root: NonEmptyStr
  archive: NonEmptyStr
}

fn baked_release_staged_locus(plan: BakedReleaseBuildPlan) -> String {
  concat(plan.stage_root as String, "/release")
}

// THE LOCAL HALF: stage, pack, measure. Every leg runs on this host as the job's own principal, so a refusal names the
// leg; nothing here is elevated.
type BakedReleasePacked
  = BakedReleasePackedAt { digest: Digest }
  | BakedReleaseNotPacked { reason: String }

fn baked_release_pack(plan: BakedReleaseBuildPlan) -> BakedReleasePacked {
  let route = one_transport_route(transport: LocalShell)
  let cleared = host_command(host: LocalCommandHost, command: rm_recursive_force_command(path: plan.stage_root as String))
  match cleared {
    HostCommandDone { stdout: _ } =>
      match tree_install_in_realm(
        realm: TreeInstallStaged { staging_root: plan.stage_root, archive_owner: approval_broker_helper_root_principal },
        spine: [plan.stage_root as String],
        locus: baked_release_staged_locus(plan: plan),
        source_root: plan.source_root,
        revision: RevisionBoundAtEmission { revision: plan.revision },
        executables: [gunbc_release_bin_name],
        transport: route,
      ) {
        TreeInstallRefused { step: st, reason: r } => BakedReleaseNotPacked { reason: concat("the staged tree install refused at ", tree_install_step_name(step: st), ": ", r) }
        TreeInstallConverged { installed_digest: _d, files_installed: _n } =>
          match host_command(host: LocalCommandHost, command: tar_create_reproducible_command(archive: plan.archive as String, from_directory: baked_release_staged_locus(plan: plan))) {
            HostCommandDone { stdout: _ } =>
              match baked_release_archive_declares_ownership(plan: plan, route: route) {
                Present { value: why } => BakedReleaseNotPacked { reason: concat("the packed release does not declare the tree the elevated install would have produced: ", why) }
                Absent =>
                  match observe_sha256_over_transport(path: plan.archive as String, transport: LocalShell) {
                    Sha256Observed { digest: d } => BakedReleasePackedAt { digest: d }
                    Sha256Unobserved { cause: c } => BakedReleaseNotPacked { reason: concat("the packed release was not measured: ", sha256_unobserved_cause_text(cause: c)) }
                  }
              }
            other => BakedReleaseNotPacked { reason: concat("the staged tree was not packed: ", host_command_outcome_text(e: other)) }
          }
      }
    other => BakedReleaseNotPacked { reason: concat("the previous staging root was not cleared: ", host_command_outcome_text(e: other)) }
  }
}

// THE OWNERSHIP THE ARCHIVE DECLARES, READ BACK (gunbc.host.host_effect_realize tree_staged_archive_disagreement):
// the staged tree's own entries, as the tree install read them back, against the archive's member listing. Absent
// means every member is 0/0 and the tree members carry the elevated install's kinds, targets and modes.
fn baked_release_archive_declares_ownership(plan: BakedReleaseBuildPlan, route: HostEffectElevationRoute) -> Optional<String> {
  match observe_tree_entry_metadata(root: baked_release_staged_locus(plan: plan), subs: release_locus_tree_subdirs, transport: route) {
    TreeMetadataObservationFailed { reason: r } => Present { value: concat("the staged tree's entries were not read: ", r) }
    TreeMetadataObserved { entries: staged } =>
      match host_command(host: LocalCommandHost, command: tar_list_sizes_command(archive: plan.archive as String)) {
        HostCommandDone { stdout: listing } => tree_staged_archive_disagreement(archive_owner: approval_broker_helper_root_principal, staged: staged, listing: listing)
        other => Present { value: concat("the archive was not listed: ", host_command_outcome_text(e: other)) }
      }
  }
}

// THE WHOLE BUILD: pack, copy to `export_dir` on the export host, and read the copy's digest back ON THAT HOST. The
// copy is a parameter so the transport is the caller's (scp over the fleet context in the wet path); the readback is
// always a sha256sum run on the export host itself, so a copy that reported success over a truncated file refuses.
fn baked_release_build_over(plan: BakedReleaseBuildPlan, export_host: CommandHost, export_dir: NonEmptyStr, copy: fn(NonEmptyStr, NonEmptyStr) -> HostCommandOutcome) -> BakedReleaseBuild {
  match baked_release_pack(plan: plan) {
    BakedReleaseNotPacked { reason: r } => BakedReleaseNotBuilt { reason: r }
    BakedReleasePackedAt { digest: measured } => {
      let staged = join([export_dir as String, "/", runner_host_baked_release_name(revision: plan.revision) as String], "") as NonEmptyStr
      match copy(plan.archive, staged) {
        HostCommandDone { stdout: _ } =>
          match host_command(host: export_host, command: sha256sum_file_command(path: staged as String)) {
            HostCommandDone { stdout: out } =>
              match sha256sum_line_digest(line: out) {
                Absent => BakedReleaseNotBuilt { reason: concat("the copy on ", host_label(host: export_host), " was not measured: sha256sum printed no digest") }
                Present { value: read_back } =>
                  if (read_back.hex as String) == (measured.hex as String) {
                    BakedReleaseBuilt { baked: RunnerHostBakedRelease { revision: plan.revision, digest: measured, staged_path: staged } }
                  } else {
                    BakedReleaseNotBuilt { reason: join(["the copy on ", host_label(host: export_host), " reads back as ", read_back.hex as String, ", not the packed ", measured.hex as String], "") }
                  }
              }
            other => BakedReleaseNotBuilt { reason: concat("the copy on ", host_label(host: export_host), " was not measured: ", host_command_outcome_text(e: other)) }
          }
        other => BakedReleaseNotBuilt { reason: concat("the packed release was not copied to ", host_label(host: export_host), ": ", host_command_outcome_text(e: other)) }
      }
    }
  }
}

data mtcollins1_baked_release_stage_root: NonEmptyStr = "target/mtcollins1-baked-release"
data mtcollins1_baked_release_archive: NonEmptyStr = "target/mtcollins1-baked-release.tar"

// THE EXPORT HOST'S SCRATCH FOR THE COPY: an exclusively created directory (mktemp -d), removed after the publication
// has read the copy into the image, whatever the publication's outcome.
data mtcollins1_baked_release_export_prefix: String = "/var/tmp/gunbc-mtcollins1-baked-release."
data mtcollins1_baked_release_export_template: NonEmptyStr = "/var/tmp/gunbc-mtcollins1-baked-release.XXXXXXXX"

data mtcollins1_runner_image_attempt_raw: String = "mtcollins1-runner-image-publish"

// CONSUMPTION (gunbc.design_argument::consumption): invoked by the fleet-converge mode MtCollins1RunnerImagePublish, which
// consumes the fleet SSH key and runs on any runner (gunbc.fleet.fleet_converge_workflow, gunbc.ci.ci_spec).
// The receipt is written whatever the outcome and uploaded by the step that follows.
fn mtcollins1_runner_image_publish_wet() -> ProcessExit {
  let attempt = match prepare_fleet_ssh_agent_context(attempt_raw: mtcollins1_runner_image_attempt_raw) {
    FleetSshContextRefused { cause: c } => RunnerImageNotDerived { reason: concat("no fleet SSH context: ", c) }
    FleetSshContextReady { context: context, receipt: _ } =>
      match current_actions_sha_observation() {
        ActionsShaEmpty { detail: d } => RunnerImageNotDerived { reason: concat("no checkout revision to bake: ", d) }
        ActionsShaMissing { detail: d } => RunnerImageNotDerived { reason: concat("no checkout revision to bake: ", d) }
        ActionsShaObserved { sha: revision } =>
          mtcollins1_runner_image_publish_at(revision: revision, export: FleetSshCommandHost { target: bmc_boot_image_export.target, context: context }, target: bmc_boot_image_export.target, context: context)
      }
  }
  let rendered = render_runner_image_attempt(a: attempt)
  let written = Filesystem.Write(path: mtcollins1_runner_image_receipt_path, content: rendered)
  if written.success == false {
    exit_failure(reason: concat("mtcollins1 runner image: the receipt could not be written: ", written.error, "\n", rendered))
  } else if runner_image_attempt_holds(a: attempt) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 runner image publication did not hold:\n", rendered))
  }
}

// THE BUILD AND THE PUBLICATION AROUND ONE EXPORT-HOST SCRATCH: the copy lands in a directory this run created, the
// publication reads it from there into the image, and the directory is removed after, whatever the publication said.
// A scratch that was not removed is a refusal (its outcome rendered), so a stale copy never outlives an unread run.
fn mtcollins1_runner_image_publish_at(revision: CommitSha, export: CommandHost, target: SshTarget, context: FleetSshExecutionContext) -> RunnerImagePublishAttempt {
  let kind = host_transport_kind(host: export)
  match scratch_acquisition_of(kind: kind, prefix: mtcollins1_baked_release_export_prefix, leg: host_run(host: export, command: mktemp_directory_command(template: mtcollins1_baked_release_export_template))) {
    ScratchNotAcquired { outcome: o } => RunnerImageNotDerived { reason: concat("no export-host scratch for the baked release: ", render_scratch_outcome(label: "baked_release_scratch", prefix: mtcollins1_baked_release_export_prefix, o: o)) }
    ScratchAcquired { dir: dir } => {
      let built = baked_release_build_over(
        plan: BakedReleaseBuildPlan { revision: revision, source_root: ".", stage_root: mtcollins1_baked_release_stage_root, archive: mtcollins1_baked_release_archive },
        export_host: export,
        export_dir: dir,
        copy: (local, remote) => host_command(host: LocalCommandHost, command: fleet_scp_upload_command(context: context, target: target, local_path: local, remote_path: remote)),
      )
      let published = match built {
        BakedReleaseNotBuilt { reason: r } => RunnerImageNotDerived { reason: concat("the baked release was not built: ", r) }
        BakedReleaseBuilt { baked: baked } =>
          runner_image_publication_on(host: export, image: runner_host_medium_image(host: mtcollins1_runner_host, baked: baked))
      }
      let removed = scratch_removal_of(kind: kind, dir: dir, leg: host_run(host: export, command: rm_recursive_force_one_file_system_command(path: dir as String)))
      if scratch_removed(o: removed) { published } else {
        RunnerImageNotDerived { reason: concat("the export-host scratch was not removed after the publication (", render_runner_image_attempt(a: published), "): ", render_scratch_outcome(label: "baked_release_scratch", prefix: mtcollins1_baked_release_export_prefix, o: removed)) }
      }
    }
  }
}
