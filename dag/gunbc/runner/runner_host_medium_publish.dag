module gunbc.runner.runner_host_medium_publish

import std.types { Bool, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.tools.gnu_coreutils { ln_symbolic_force_command, readlink_command }
import std.process { ExitSuccess, ProcessExit, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.host_command_binding {
  CommandHost, FleetSshCommandHost, HostCommandOutcome, HostCommandDone, HostCommandFailed, HostCommandUnconfirmed, HostCommandNotDispatched,
  host_command, host_command_outcome_text,
}
import gunbc.host.boot_medium_reader_key { boot_medium_served_link_path }
import gunbc.fleet.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }
import gunbc.host.boot_medium { bmc_boot_image_export }
import gunbc.machine_intake.mtcollins1_census_image {
  mtcollins1_census_machine, mtcollins1_census_console_device, mtcollins1_census_console_arg, census_image_stock_path,
}
import gunbc.provisioning.seeded_install_media_publish {
  BmcExportBoundary, SeededImagePublication, SeededImagePublished, SeededImageAlreadyPublished, SeededImagePublicationRefused, SeededImagePublishedRecordNotWritten,
  publish_seeded_image, seeded_image_publication_holds, render_seeded_image_publication,
}
import gunbc.runner.runner_host_medium {
  RunnerHostMediumHost, RunnerHostMediumImage, RunnerHostMediumImageDerived, RunnerHostMediumRunnerUnpublished, RunnerHostMediumUserDataRefused,
  runner_host_medium_image, RunnerHostBakedRelease,
}

// THE IMAGE LEG'S PRODUCTION CALLER (gunbc.runner.runner_throughput_qualification_route mtcollins1_image_leg).
// It derives the runner image from the authority (gunbc.runner.runner_host_medium runner_host_medium_image)
// for mtcollins1 -- the host parameters are the census's own machine name and serial console, so the
// envelope and the kernel's console agree with the boot subject -- and publishes it create-only into the
// BMC export through the one seeded-image publication fold, on the export's serving host over fleet SSH
// (srv2 has no runner slot). The publication measures the built bytes, names the image by that digest,
// and reads the published file back before it reports; the receipt below is the digest the boot leg's
// runner_host_boot_medium row carries.
data mtcollins1_runner_host: RunnerHostMediumHost = RunnerHostMediumHost {
  machine: mtcollins1_census_machine,
  console_device: mtcollins1_census_console_device,
  console_kernel_arg: mtcollins1_census_console_arg,
}

type RunnerImagePublishAttempt
  = RunnerImageNotDerived { reason: String }
  | RunnerImagePublishRan { publication: SeededImagePublication, link: ServedLinkReading }

// THE SERVED LINK (gunbc.host.boot_medium_reader_key boot_medium_served_link_path) IS THIS PUBLISH'S TO
// SET. The boot medium reader key is forced to sha256sum that one fixed path, so the publish that names
// the runner image points the link at it and reads the link back. The link is set only after the
// publication holds, so it never names an image that was not read back; the reading is readlink's
// answer, which must be exactly the published path.
type ServedLinkReading
  = ServedLinkPointsAt { link_path: NonEmptyStr, target: NonEmptyStr }
  | ServedLinkNotSet { reason: String }
  | ServedLinkDisagrees { link_path: NonEmptyStr, expected: NonEmptyStr, read: String }

fn published_image_path(p: SeededImagePublication) -> NonEmptyStr? {
  if seeded_image_publication_holds(p: p) {
    match p {
      SeededImagePublished { built: _, path: path, work: _, staging_residue: _ } => Present { value: path }
      SeededImageAlreadyPublished { built: _, path: path } => Present { value: path }
      SeededImagePublicationRefused { reason: _, work: _ } => none
      SeededImagePublishedRecordNotWritten { built: _, path: _, work: _, staging_residue: _, record: _ } => none
    }
  } else {
    none
  }
}

fn served_link_after(publication: SeededImagePublication, set: fn(NonEmptyStr) -> HostCommandOutcome, read: fn() -> HostCommandOutcome) -> ServedLinkReading {
  let link = boot_medium_served_link_path()
  match published_image_path(p: publication) {
    Absent => ServedLinkNotSet { reason: "the publication did not hold, so the served link was left as it was" }
    Present { value: path } =>
      match set(path) {
        HostCommandDone { stdout: _ } =>
          match read() {
            HostCommandDone { stdout: o } =>
              if trim(s: o) == (path as String) { ServedLinkPointsAt { link_path: link, target: path } } else { ServedLinkDisagrees { link_path: link, expected: path, read: trim(s: o) } }
            HostCommandFailed { exit_code: c, stderr: e } => ServedLinkNotSet { reason: concat("the link was set but could not be read back: ", host_command_outcome_text(e: HostCommandFailed { exit_code: c, stderr: e })) }
            HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e } => ServedLinkNotSet { reason: concat("the link was set but its readback is unconfirmed: ", host_command_outcome_text(e: HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e })) }
            HostCommandNotDispatched { reason: r } => ServedLinkNotSet { reason: concat("the link was set but its readback was not dispatched: ", r) }
          }
        HostCommandFailed { exit_code: c, stderr: e } => ServedLinkNotSet { reason: host_command_outcome_text(e: HostCommandFailed { exit_code: c, stderr: e }) }
        HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e } => ServedLinkNotSet { reason: host_command_outcome_text(e: HostCommandUnconfirmed { exit_code: c, stdout: o, stderr: e }) }
        HostCommandNotDispatched { reason: r } => ServedLinkNotSet { reason: concat("not dispatched: ", r) }
      }
  }
}

fn served_link_on(host: CommandHost, publication: SeededImagePublication) -> ServedLinkReading {
  let link = boot_medium_served_link_path()
  served_link_after(
    publication: publication,
    set: fn(path) { host_command(host: host, command: ln_symbolic_force_command(target: path as String, link_name: link as String)) },
    read: fn() { host_command(host: host, command: readlink_command(path: link as String)) },
  )
}

fn served_link_holds(l: ServedLinkReading) -> Bool {
  match l {
    ServedLinkPointsAt { link_path: _, target: _ } => true
    ServedLinkNotSet { reason: _ } => false
    ServedLinkDisagrees { link_path: _, expected: _, read: _ } => false
  }
}

fn render_served_link(l: ServedLinkReading) -> String {
  match l {
    ServedLinkPointsAt { link_path: p, target: t } => join(["served_link=", p as String, "\nserved_link_target=", t as String, "\n"], "")
    ServedLinkNotSet { reason: r } => join(["served_link=not set\nserved_link_reason=", r, "\n"], "")
    ServedLinkDisagrees { link_path: p, expected: e, read: r } => join(["served_link=", p as String, "\nserved_link_disagrees=expected ", e as String, ", read ", r, "\n"], "")
  }
}

fn runner_image_publication_on(host: CommandHost, image: RunnerHostMediumImage) -> RunnerImagePublishAttempt {
  match image {
    RunnerHostMediumRunnerUnpublished { binary_release: r } =>
      RunnerImageNotDerived { reason: concat("no arm64 runner tarball is published for release ", r.version as String) }
    RunnerHostMediumUserDataRefused { reason: r } => RunnerImageNotDerived { reason: concat("the user-data document does not render: ", r) }
    RunnerHostMediumImageDerived { input: i, runner: _ } => {
      let publication = publish_seeded_image(host: host, input: i, stock_path: census_image_stock_path(), boundary: BmcExportBoundary { export_dir: bmc_boot_image_export.dir })
      RunnerImagePublishRan { publication: publication, link: served_link_on(host: host, publication: publication) }
    }
  }
}

fn runner_image_attempt_holds(a: RunnerImagePublishAttempt) -> Bool {
  match a {
    RunnerImageNotDerived { reason: _ } => false
    RunnerImagePublishRan { publication: p, link: l } =>
      seeded_image_publication_holds(p: p) && served_link_holds(l: l)
  }
}

fn render_runner_image_attempt(a: RunnerImagePublishAttempt) -> String {
  match a {
    RunnerImageNotDerived { reason: r } => concat("publication=not attempted\npublication_reason=", r, "\n")
    RunnerImagePublishRan { publication: p, link: l } =>
      concat(render_seeded_image_publication(p: p), render_served_link(l: l))
  }
}

data mtcollins1_runner_image_receipt_path: String = "target/mtcollins1-runner-image.txt"

// THE BAKED RELEASE IS BUILT BY THIS RUN (gunbc.plans.mtcollins1_ci_service_legs F1; merry-fox-82, 2026-10-27, decision
// A and its conditions): on this run's own aarch64 fleet runner, at the run's admitted checkout, the release-locus tree
// is staged through the one tree install (gunbc.host.host_effect_realize approval_broker_tree_install_at), packed,
// measured, and copied to the export host, where it is the image's copied seed artifact. That build is not written
// yet, so the publish refuses here with that cause rather than deriving an image without its release. It lands in
// the same PR before review (the PR is a draft until it does).
type BakedReleaseBuild
  = BakedReleaseBuilt { release: RunnerHostBakedRelease }
  | BakedReleaseNotBuilt { reason: String }

fn mtcollins1_baked_release_build() -> BakedReleaseBuild {
  BakedReleaseNotBuilt { reason: "the publish run's release build (stage the release-locus tree at the admitted checkout, pack, measure, copy to the export host) is not written yet" }
}

data mtcollins1_runner_image_attempt_raw: String = "mtcollins1-runner-image-publish"

// CONSUMPTION (DESIGN §3c): invoked by the fleet-converge mode MtCollins1RunnerImagePublish, which
// consumes the fleet SSH key and runs on any runner (gunbc.fleet.fleet_converge_workflow, gunbc.ci.ci_spec).
// The receipt is written whatever the outcome and uploaded by the step that follows.
fn mtcollins1_runner_image_publish_wet() -> ProcessExit {
  let attempt = match prepare_fleet_ssh_agent_context(attempt_raw: mtcollins1_runner_image_attempt_raw) {
    FleetSshContextRefused { cause: c } => RunnerImageNotDerived { reason: concat("no fleet SSH context: ", c) }
    FleetSshContextReady { context: context, receipt: _ } =>
      match mtcollins1_baked_release_build() {
        BakedReleaseNotBuilt { reason: r } => RunnerImageNotDerived { reason: concat("the baked release was not built: ", r) }
        BakedReleaseBuilt { release: release } =>
          runner_image_publication_on(
            host: FleetSshCommandHost { target: bmc_boot_image_export.target, context: context },
            image: runner_host_medium_image(host: mtcollins1_runner_host, release: release),
          )
      }
  }
  let rendered = render_runner_image_attempt(a: attempt)
  let written = Filesystem.Write(path: mtcollins1_runner_image_receipt_path, content: rendered)
  if written.success == false {
    exit_failure(reason: concat("mtcollins1 runner image: the receipt could not be written: ", written.error, "\n", rendered))
  } else if runner_image_attempt_holds(a: attempt) {
    ExitSuccess
  } else {
    exit_failure(reason: concat("mtcollins1 runner image publication did not hold:\n", rendered))
  }
}
