// THE RUNNER MEDIUM: A DISKLESS LIVE HOST THAT CAN TAKE A HOST-UNIT SLOT.
//
// The same seeded live-server derivation the census image uses
// (extdeps.provisioning.ubuntu_seeded_install_media UbuntuSeededInstallMediaBuildInput), with a
// different program in the seed: instead of a census that powers off, a readiness program that
// installs the actions runner the host-unit slot runs (gunbc.runner.runner_host_unit_slot
// host_unit_slot_runner_release, arm64) and prints one host-capture envelope saying the host is up.
// The program RETURNS rather than halting, so subiquity falls through to its interactive sections
// and waits there: nothing on this medium writes a disk, and the host stays up in RAM for the slot.
//
// THE RUNNER TARBALL RIDES ON THE MEDIUM, SO THE BOOT OPENS NO NETWORK (the route's boot stage has
// no egress, gunbc.runner.runner_throughput_qualification_route stage_egress). It is a seed ARTIFACT
// (extdeps.provisioning.ubuntu_seeded_install_media NoCloudSeedArtifact): the build fetches it from
// the upstream release URL and refuses unless its sha256 is the release's cited arm64 digest, and
// that digest is in the build key. The live program reads the tarball's sha256 back off the medium
// as its own section, and the acceptance predicate refuses a mismatch with a typed cause; each
// install step (clear, create, extract) is its own section with its own exit code, so no step's
// refusal depends on the shell stopping.
//
// THE HOST PARAMETERS ARE THE CALLER'S. Which machine name the envelope carries (it must equal the
// boot subject's machine, gunbc.host.managed_host_boot boot_subject_machine) and which serial console the
// kernel and program write to are facts about the host, so this module takes them as a value and
// names no host.
type RunnerHostMediumHost {
  machine: NonEmptyStr
  console_device: NonEmptyStr
  console_kernel_arg: NonEmptyStr
}

data runner_host_medium_nocloud_dir: NonEmptyStr = "gunbc-runner"
data runner_host_medium_program_file: NonEmptyStr = "runner-host-up.sh"
data runner_host_medium_volume_id: NonEmptyStr = "GUNBC_RUNNER_HOST_2404_3"
data runner_host_medium_image_stem: NonEmptyStr = "gunbc-runner-host-ubuntu-24.04.3-arm64"

// THE PROGRAM RETURNS: the halt slot of host_capture_program is the one line whose effect is on the
// machine, and a runner host must stay up.
data runner_host_medium_halt_command: NonEmptyStr = "true"

fn runner_host_medium_tarball_on_medium(artifact: ActionsRunnerBinaryArtifact) -> String {
  concat("/cdrom/", runner_host_medium_nocloud_dir as String, "/", actions_runner_tarball_filename(artifact: artifact))
}

fn runner_host_medium_seed_artifact(artifact: ActionsRunnerBinaryArtifact) -> NoCloudSeedArtifact {
  NoCloudSeedArtifact {
    name: actions_runner_tarball_filename(artifact: artifact) as NonEmptyStr,
    source_url: actions_runner_download_url(artifact: artifact) as NonEmptyStr,
    digest: actions_runner_release_digest(artifact: artifact),
  }
}


fn runner_host_listener_path() -> String {
  concat(actions_runner_base_dir, actions_runner_listener_relative_path)
}

// THE ACCOUNT THE IMAGE'S LISTENERS RUN AS (operator decision, merry-fox-82, 2026-10-27: option B). The image is
// stateless and image-baked, so no SSH converge enrols it and no runner_host_spec row describes it; the image itself
// declares the account and creates it at every boot as a captured, gated section (runner-account), so a boot that did
// not create it is refused by runner_host_up_readback rather than reported up. Slots on an image-baked host read
// their runner user from here through gunbc.runner.runner_host_listener_account host_unit_slot_runner_user. A system
// account with no home and no login shell: the listener needs an identity the App key's custody row does not admit,
// nothing more. CHANGING THIS CHANGES THE BOOT IMAGE (the medium's user-data, so its output digest).
data runner_host_medium_runner_account: NonEmptyStr = "gunbc-runner"

// THE SECTION NAMES ARE READ BACK BY NAME, so the program's roster and the predicate's reads are one
// set of rows.
data runner_host_section_boot_media: NonEmptyStr = "boot-media"
data runner_host_section_tarball_digest: NonEmptyStr = "runner-tarball-digest"
data runner_host_section_runner_clear: NonEmptyStr = "runner-clear"
data runner_host_section_runner_dir: NonEmptyStr = "runner-dir"
data runner_host_section_runner_extract: NonEmptyStr = "runner-extract"
data runner_host_section_runner_listener: NonEmptyStr = "runner-listener"
data runner_host_section_runner_account: NonEmptyStr = "runner-account"
// THE STAGE THAT PUTS THE FLEET PUBLIC KEY ON THE LIVE RUNNER (operator ruling 2026-11-07,
// gunbc.design_ruling fleet_authorized_keys_on_every_install_route). Named so the read-back predicate and
// the program roster are one set of rows, like every other section here.
data runner_host_section_fleet_authorized_keys: NonEmptyStr = "fleet-authorized-keys"
data runner_host_section_host_key_gen: NonEmptyStr = "host-key-gen"
data runner_host_section_host_key_pub: NonEmptyStr = "host-key-pub"
data runner_host_section_host_key_fingerprint: NonEmptyStr = "host-key-fingerprint"
data runner_host_section_systemd: NonEmptyStr = "systemd-manager"
data runner_host_section_meminfo: NonEmptyStr = "meminfo"
data runner_host_section_nproc: NonEmptyStr = "nproc"
data runner_host_section_machine: NonEmptyStr = "uname-machine"

data runner_host_up_section_names: List<NonEmptyStr> = [
  runner_host_section_boot_media,
  runner_host_section_tarball_digest,
  runner_host_section_runner_clear,
  runner_host_section_runner_dir,
  runner_host_section_runner_extract,
  runner_host_section_runner_listener,
  runner_host_section_runner_account,
  runner_host_section_fleet_authorized_keys,
  runner_host_section_host_key_gen,
  runner_host_section_host_key_pub,
  runner_host_section_host_key_fingerprint,
  runner_host_section_systemd,
  runner_host_section_meminfo,
  runner_host_section_nproc,
  runner_host_section_machine,
]

// THE SECTIONS THE CLOSED READER (runner_host_up_over_closed) GATES BY PLAIN REFUSAL -- a section that is
// absent, malformed, or exited non-zero refuses the read. DERIVED from the ONE shared roster above by excluding
// the five sections that have dedicated parsers below (their output carries a fact beyond the exit status: the
// media labels, the tarball digest, meminfo, nproc, the uname machine). Deriving it instead of hand-copying is
// the single_authority/fail_closed fix review 92035->side-chat required: the OPEN reader already iterates
// runner_host_up_section_names, so any roster member -- fleet-authorized-keys now, and every stage added later
// -- is gated in BOTH readers by construction, never by a second hand list that can drift and silently ACCEPT a
// failed or ABSENT section once the envelope closes (a full success or a located refusal, never a plausible green).
fn runner_host_up_plain_gate_section_names() -> List<NonEmptyStr> {
  filter(
    runner_host_up_section_names,
    n =>
      (n as String) != (runner_host_section_boot_media as String)
        && (n as String) != (runner_host_section_tarball_digest as String)
        && (n as String) != (runner_host_section_meminfo as String)
        && (n as String) != (runner_host_section_nproc as String)
        && (n as String) != (runner_host_section_machine as String),
  )
}

// THE PER-BOOT HOST KEY (S4(c), a PROPOSAL pending the operator's route pick; gunbc.host.anchored_host_transport
// anchored_host_transport_per_boot is the fleet's side). The image is stateless, so its host key is generated
// at EVERY boot into tmpfs (/run, fresh per boot: ssh-keygen refuses an existing file, so a stale key fails loudly),
// The PUBLIC half and its fingerprint are each the output of ONE
// structured command stage (cat, ssh-keygen -l), carried inside the capture envelope on the serial console; the
// fleet-side reader (runner_host_key_observation) splits them in .dag and takes the boot id from the envelope, so no
// stage composes text in shell. Nothing private leaves the host and nothing is stored: the key dies with the boot. The
// boot id is the kernel's (/proc/sys/kernel/random/boot_id), the source the envelope's begin/end markers bind to
// (host_capture_program GUNBC_BOOT_ID). No sshd is started: a daemon is admitted by its consumer (gunbc.design_argument::consumption), and none exists until the
// fleet public key is seeded and a route consumes the pin.
data runner_host_key_file: NonEmptyStr = "/run/gunbc_ssh_host_ed25519_key"
data runner_host_key_public_file: NonEmptyStr = "/run/gunbc_ssh_host_ed25519_key.pub"

// THE LIVE-SESSION SSHD THE FLEET REACHES. The runner medium is a diskless live session that never installs,
// so it has no installed sshd and no autoinstall `ssh` section that lands (that section is a TARGET-system
// installer feature -- the finding that moved the fleet key from a rendered-YAML witness to this stage). It
// uses the live image's OWN ssh.service rather than starting a second daemon beside it (two daemons on :22 is
// a conflict class, and subiquity's live session may already run one for remote install). The drop-in is
// where this boot adds its authorization; ssh.service itself is the image's, and its presence is the
// CitedToAuthority observation beside the casper pins
// (gunbc.provisioning.ubuntu_network_origin_observation openssh_server_live_session_observation) -- its
// ACTIVATION is established here, by the stage's is-active read-back, not transcribed.
data runner_host_ssh_service_unit: NonEmptyStr = "ssh.service"
// sshd keeps the FIRST value it reads for most keywords and sshd_config includes sshd_config.d/*.conf in
// LEXICAL order, so a `99-` drop-in is read LAST and any earlier file wins (on a live installer / cloud-init
// session that earlier file is usually `50-cloud-init.conf` with `PasswordAuthentication yes`, which would
// silently override the hardening while `systemctl is-active` still reports green). This drop-in therefore
// sorts FIRST (`00-`), and the stage READS BACK the effective config with `sshd -T` (below) so a keyword an
// even earlier file overrode fails its grep and the stage fails loud rather than claiming a hardening rung
// it did not establish (fail_closed). gunbc.host.export_host_reader_converge states the same rule -- "a
// drop-in sorting earlier than ours would win, sshd taking the first value" -- and readbacks with sshd -T.
data runner_host_fleet_sshd_drop_in_path: NonEmptyStr = "/etc/ssh/sshd_config.d/00-gunbc-runner-fleet.conf"
data runner_host_sshd_config_drop_in_dir: NonEmptyStr = "/etc/ssh/sshd_config.d"
// The three key commands are built over the key file as a PARAMETER and the stages render them over the declared
// path, so the inhabitance claim runs the SAME commands the image runs against a scratch path (gunbc.design_argument::witness_one_interface).
fn runner_host_key_gen_argv(key_file: String) -> ArgvCommand {
  ssh_keygen_generate_command(key_type: ssh_keygen_ed25519_type, key_file: key_file, comment: "gunbc-runner-host-per-boot")
}

fn runner_host_key_pub_argv(public_key_file: String) -> ArgvCommand {
  cat_command(path: public_key_file)
}

fn runner_host_key_fingerprint_argv(public_key_file: String) -> ArgvCommand {
  ssh_keygen_fingerprint_command(key_file: public_key_file)
}

fn runner_host_key_gen_command() -> String {
  shell_command_render(command: runner_host_key_gen_argv(key_file: runner_host_key_file as String))
}

fn runner_host_key_pub_command() -> String {
  shell_command_render(command: runner_host_key_pub_argv(public_key_file: runner_host_key_public_file as String))
}

fn runner_host_key_fingerprint_command() -> String {
  shell_command_render(command: runner_host_key_fingerprint_argv(public_key_file: runner_host_key_public_file as String))
}

// THE ONE WAY THIS MODULE SPLITS A MODELED argv INTO A SHELL WORD SEQUENCE. Same rendering the account-ensure
// uses (gunbc.executor_privileged_operation precondition_guarded_shell_command), kept local so a boot stage
// reads exactly like the account stage beside it.
fn runner_host_capture_shell(argv: List<String>) -> String {
  join(map(argv, w => posix_single_quote(spelling: w as String)), " ")
}

// THE ONE PLACE THIS MODULE WRITES SHELL OPERATORS (the interim-shell renderer). Every other boot stage beside
// this is a single modeled argv through shell_command_render; the fleet-key stage composes several steps, so it
// needs '&&' sequencing, a pipeline, a redirect, a guard, a printf, and a trailing annotation -- the shell
// STRUCTURE an argv cannot express. Those operators were string literals scattered across three stage functions
// (review 92046, ctrl HAND-SHELL GATE); they live here, in one visibly-marked renderer, so no stage concatenates
// shell inline. Each input is already a rendered String or a MODELED argv -- sshd via
// extdeps.ssh.openssh_server_commands sshd_effective_config_argv, systemctl via gunbc.extdeps.systemd.systemctl,
// the authorized_keys writer via gunbc.spark.managed_access_apply, the checked directives via
// gunbc.runner.workspace_guest_image sshd_fleet_auth_hardening -- so this renderer invents no vocabulary, it only
// assembles (gunbc.design_argument::single_authority). It is DISSOLVED by the orchestration-to-shell
// v2.workflow.bash_emit capability (#5828): when typed live-session HostEffects/emit land, these nodes become
// typed steps and this renderer is deleted. The typed carrier for that is gunbc.spark.managed_access_apply
// authorized_key_install_dissolution_trigger, embedded on the rendered boot command itself (the Chain's final
// Annotated note) so the emitted shell is marked, not merely this comment
// (gunbc.design_argument::source_annotations). Rendering is byte-for-byte the form the witnesses pin in
// gunbc.test.claim.runner.runner_host_medium_fleet_keys_witness -- this is a pure relocation, not a rewrite.
// The REDIRECT text is NOT spelled here: it is admitted via admit_posix_redirect_pathname and serialized via
// extdeps.posix.shell_command_language emit_posix_redirection (the ONE POSIX redirect serializer) and passed IN
// as stdout_redirect/stderr_redirect (gunbc.design_argument::single_authority -- the reviewer on review 92063
// required routing every redirect through that authority and gating the pathname with
// admit_posix_redirect_pathname, so a failed/empty path becomes a typed refusal upstream instead of silently
// writing to '/' or a nonsense target; see runner_host_fleet_authorized_keys_stage_command).
type InterimShell
  = RhShellChain { steps: List<String> }
  | RhShellGuarded { inner: String }
  | RhShellFixedLineMatch { source: String, stderr_redirect: String, line: String }
  | RhShellLineCount { source: String, stderr_redirect: String, keyword: String, expected_count: String }
  | RhShellPrintf { lines: List<String>, stdout_redirect: String }
  | RhShellAnnotated { body: String, note: String }

fn runner_host_interim_shell(node: InterimShell) -> String {
  match node {
    RhShellChain { steps: ss } => join(ss, " && ")
    RhShellGuarded { inner: i } => concat("(", i, ")")
    RhShellFixedLineMatch { source: s, stderr_redirect: r, line: l } =>
      concat("( ", s, r, " | grep -Fx ", posix_single_quote(spelling: l), " )")
    RhShellLineCount { source: s, stderr_redirect: r, keyword: k, expected_count: n } =>
      concat("( test \"$( ", s, r, " | grep -c ", posix_single_quote(spelling: concat("^", k, " ")), " )\" = ", posix_single_quote(spelling: n), " )")
    RhShellPrintf { lines: ls, stdout_redirect: r } =>
      concat("printf '%s\\n' ", join(map(ls, l => posix_single_quote(spelling: l)), " "), r)
    RhShellAnnotated { body: b, note: n } => concat(b, " # ", n)
  }
}

// The roster's authorized_keys, written into the LIVE account by the ONE authorized_keys writer
// (gunbc.spark.managed_access_apply authorized_key_install_script_for_login) -- one idempotent exact-line
// append per fleet key, canonical line form (gunbc.extdeps.ssh.keys ssh_public_key_canonical_line: keytype +
// material, no caller comment, because the public boot seed must not carry caller text). Mapping
// gunbc.fleet.fleet_ssh_access fleet_authorized_keys is the whole of it: there is no second key list here,
// and no mtcollins-only row -- every machine booted from this medium gets the same fleet roster
// (gunbc.design_argument::single_authority).
fn runner_host_fleet_authorized_keys_shell() -> String {
  // One '&&'-joined Chain (via runner_host_interim_shell), NOT newline-joined: with newline separation the
  // FIRST key's failure would be masked by the second key's success (the section exit is only the last
  // command's). '&&' makes the whole roster install one fail-closed chain -- any key's failed step exits this
  // segment nonzero (fail_closed).
  runner_host_interim_shell(node: RhShellChain {
    steps: map(fleet_authorized_keys, k =>
      authorized_key_install_script_for_login(
        login: fleet_automation_principal_login as String,
        key_line: ssh_public_key_canonical_line(k: k),
        halt_on_error: false,
      )
    ),
  })
}

// The sshd drop-in this boot installs: a header naming the authority, then HostKey set to THE per-boot host
// key (runner_host_key_file -- the same key the host-key-gen stage created and the fleet transport anchors
// on; a second key would fork the pin), then the ONE fleet authorization rule drawn from
// gunbc.runner.workspace_guest_image sshd_fleet_auth_hardening with AllowUsers the fleet automation login.
// Written by printf of quoted lines into the drop-in path; no package install, no second daemon.
fn runner_host_fleet_sshd_drop_in_shell(stdout_redirect: String) -> String {
  let lines = concat(
    xs: [
      "# gunbc fleet authorized-keys drop-in -- live runner boot.",
      "# Authorization for the fleet roster; authority gunbc.fleet.fleet_ssh_access fleet_authorized_keys.",
      "# HostKey is the per-boot host key the fleet transport pins on (see runner_host_fleet_authorized_keys_command).",
      concat("HostKey ", runner_host_key_file as String),
    ],
    ys: sshd_fleet_auth_hardening(allow_users: fleet_automation_principal_login),
  )
  // NO `set -e`: this script runs in the LIVE session (a Subiquity early-command), and aborting it would
  // halt the boot -- the medium must always RETURN to Subiquity's interactive sections (the
  // runner_host_medium_witness never_halts claim bans "set -e" in the whole program). The two steps are
  // one '&&'-joined Chain via runner_host_interim_shell (the module's interim-shell renderer): if the mkdir
  // fails the printf never runs and the stage's captured exit is non-zero -- a failed step is recorded as the
  // stage's RunnerHostSectionFailed, exactly like every other host_capture_program stage, rather than
  // aborting-on-error. (gunbc.design_argument::fail_closed without halting the live session.)
  runner_host_interim_shell(node: RhShellChain {
    steps: [
      shell_command_render(command: mkdir_parents_command(path: runner_host_sshd_config_drop_in_dir)),
      runner_host_interim_shell(node: RhShellPrintf {
        lines: lines,
        stdout_redirect: stdout_redirect,
      }),
    ],
  })
}

// OpenSSH keywords whose value is ACCUMULATED across directives rather than first-wins: sshd appends every
// AllowUsers (servconf.c server_config.c ~1821), so `sshd -T` can print the keyword on more than one line and the
// effective allowed-user population is the UNION of those lines. A read-back that only finds the expected line
// would miss an EXTRA appended user, so these keywords get a complete-population check (a count), not presence.
data fleet_sshd_appending_keywords: List<String> = ["allowusers"]

fn fleet_sshd_keyword_appends(keyword: String) -> Bool {
  any(fleet_sshd_appending_keywords, k => k == keyword)
}

// The keyword of a 'keyword value' line, ASCII-lower-cased (sshd -T lower-cases keywords). '' if the line is empty.
fn fleet_sshd_directive_keyword_lower(directive: String) -> String {
  match filter(split(s: directive, delimiter: " "), t => t != "").first() {
    Present { value: raw } => ascii_lowercase(s: raw)
    Absent => ""
  }
}

// The value of a 'keyword value' line, everything after the first token, kept BYTE-FOR-BYTE (original case,
// single-spaced) -- the thing that must be compared literally, never case-folded or treated as a pattern.
fn fleet_sshd_directive_value(directive: String) -> String {
  join(filter(split(s: directive, delimiter: " "), t => t != "").skip(n: 1), " ")
}

fn fleet_sshd_line_keyword_lower(line: String) -> String {
  match filter(split(s: line, delimiter: " "), t => t != "").first() {
    Present { value: raw } => ascii_lowercase(s: raw)
    Absent => ""
  }
}

fn fleet_sshd_line_value_tokens(line: String) -> List<String> {
  filter(split(s: line, delimiter: " "), t => t != "").skip(n: 1)
}

// THE PURE PREDICATE over `sshd -T` effective-config text -- the single model the boot stage's read-back renders,
// so a witness can run the very check the boot runs (the side-chat P2 on review 92065). For each directive the ONE
// authority sshd_fleet_auth_hardening names: normalise ONLY the keyword's case, then collect EVERY line whose
// lower-cased first token is that keyword and require the COMPLETE whitespace-token population of their values to
// equal the expected value's tokens -- a fixed-string, case-sensitive comparison, never a regex (so the '.' in
// '.ssh' is a literal dot, not a wildcard) and never a case fold of the path/username (so '.SSH/...' is refused).
// This is exactly what the OLD `grep -Eix` got wrong: -E turned '.' into a wildcard and -i folded the value's case
// (both false-accepts), and presence-only matching accepted an EXTRA appended AllowUsers because OpenSSH APPENDS
// AllowUsers (servconf.c ~1821) -- so the whole population must match, not one line. gunbc.design_argument::
// single_authority (one algorithm for both the witness and the rendered stage) and ::fail_closed (a wrong
// effective config fails the rung rather than letting `systemctl is-active` pass green over it).
fn sshd_effective_config_satisfies_fleet_hardening(text: String) -> Bool {
  let directives = sshd_fleet_auth_hardening(allow_users: fleet_automation_principal_login)
  let lines = split(s: text, delimiter: "\n")
  all(directives, d => fleet_sshd_directive_holds(lines: lines, directive: d))
}

fn fleet_sshd_directive_holds(lines: List<String>, directive: String) -> Bool {
  let keyword = fleet_sshd_directive_keyword_lower(directive: directive)
  let expected_tokens = filter(split(s: directive, delimiter: " "), t => t != "").skip(n: 1)
  if keyword == "" {
    false
  } else {
    let matching = filter(lines, l => fleet_sshd_line_keyword_lower(line: l) == keyword)
    let actual_tokens = flat_map(matching, l => fleet_sshd_line_value_tokens(line: l))
    actual_tokens == expected_tokens
  }
}

// The hardening this boot must PROVE sshd will actually run with -- the EFFECTIVE value, not the value we
// wrote. The `sshd -T` verb is NOT spelled here: it is rendered through runner_host_capture_shell from the ONE
// authority extdeps.ssh.openssh_server_commands sshd_effective_config_argv() -- the same argv
// gunbc.host.export_host_reader_converge consumes -- so the sshd command has exactly one source (the reviewer
// on review 92042: spelling it inline was a second place deciding the verb, a gunbc.design_argument::
// single_authority fork; and gunbc.design_argument::how_to_work says search the concept graph before inventing
// vocabulary). What is checked -- every directive keyword AND value -- comes from the ONE authority
// gunbc.runner.workspace_guest_image sshd_fleet_auth_hardening(allow_users: fleet_automation_principal_login):
// this maps THAT list's own lines to a per-directive read-back, so no keyword or value is re-spelled either --
// if the authority said `PasswordAuthentication yes` the read-back would seek yes, never a stale no. sshd -T
// prints the effective config lower-cased single-spaced, so the check per directive is `grep -Fx` (FIXED-string,
// whole-line, case-SENSITIVE) against the authority's line with its keyword lower-cased -- NOT `grep -Eix`, whose
// -E made the '.' in '.ssh' a wildcard and whose -i folded the value's case, both false-accepting a wrong path
// (the side-chat P2 on review 92065). For an ACCUMULATING keyword (`allowusers`: OpenSSH appends it, servconf.c
// ~1821) an EXTRA appended line passes a presence check, so a count of that keyword's lines must be exactly one
// (a second allowed user makes the count 2 and fails). A keyword an earlier sshd_config.d file first-obtained to a
// different value makes its grep exit non-zero, which (the whole stage is one '&&'-chain) ends the chain and
// becomes the section's captured RunnerHostSectionFailed -- the hardening rung is established by executed
// evidence, never assumed from `systemctl is-active` going green (gunbc.design_argument::fail_closed; the
// sibling gunbc.host.export_host_reader_converge readbacks the same way). The stderr redirect (' 2>|...') is
// NOT spelled here: it is admitted (admit_posix_redirect_pathname) and serialized by the ONE POSIX authority
// extdeps.posix.shell_command_language emit_posix_redirection and passed in as stderr_redirect, so the redirect
// has one source (review 92063; gunbc.design_argument::single_authority). The pipeline ('|'), the grep argv and
// the PARENTHESIZATION are shell structure no argv expresses (the interim-shell pattern; there is no modeled
// grep argv in the tree to render), so each read-back is one parenthesized operand of the outer '&&'.
fn runner_host_fleet_sshd_effective_readback_shell(stderr_redirect: String) -> String {
  let sshd_t = runner_host_capture_shell(argv: sshd_effective_config_argv())
  let directives = sshd_fleet_auth_hardening(allow_users: fleet_automation_principal_login)
  // One fixed-string, whole-line, case-sensitive check per directive ('sshd -T ... | grep -Fx '<lower-cased keyword>
  // <value>''), derived from the ONE sshd_fleet_auth_hardening authority -- plus, for an ACCUMULATING keyword, a
  // count of its lines so an EXTRA appended value (an extra allowed user) fails the stage, not just a mismatched
  // value. The check is the shell rendering of sshd_effective_config_satisfies_fleet_hardening above.
  let exact_steps = map(
    directives,
    d => runner_host_interim_shell(node: RhShellFixedLineMatch {
      source: sshd_t,
      stderr_redirect: stderr_redirect,
      line: concat(fleet_sshd_directive_keyword_lower(directive: d), " ", fleet_sshd_directive_value(directive: d)),
    }),
  )
  let count_steps = map(
    filter(directives, d => fleet_sshd_keyword_appends(keyword: fleet_sshd_directive_keyword_lower(directive: d))),
    d => runner_host_interim_shell(node: RhShellLineCount {
      source: sshd_t,
      stderr_redirect: stderr_redirect,
      keyword: fleet_sshd_directive_keyword_lower(directive: d),
      expected_count: "1",
    }),
  )
  runner_host_interim_shell(node: RhShellChain { steps: concat(exact_steps, count_steps) })
}

// THE BOOT STAGE THAT MAKES THE FLEET KEY REACH THE LIVE RUNNER (operator ruling 2026-11-07,
// gunbc.design_ruling fleet_authorized_keys_on_every_install_route; the boot-design shape agreed with
// merry-fox-82). The medium is diskless and never installs, so the autoinstall `ssh` section -- a TARGET-system
// installer feature -- never lands here, and a witness over that rendered YAML would certify a key that never
// reaches the running system. The keys go where the runner account and host key are already created: the live
// session, as root, in this order -- the four steps are ONE '&&'-chain (see the join in the body: the first
// failing step exits the stage nonzero, so no step's success masks an earlier step's failure -- fail_closed),
// and no 'set -e' appears anywhere in it (the never_halts claim):
//   1. realize the fleet automation LOGIN account the transport logs in as
//      (gunbc.fleet.fleet_ssh_locus fleet_automation_principal_login), with its home and login shell
//      (gunbc.fleet.fleet_posix_accounts fleet_automation_login_shell_path) through the as-root job-account
//      ensure; no password is set, so password auth is impossible and the drop-in forbids it too;
//   2. write EXACTLY gunbc.fleet.fleet_ssh_access fleet_authorized_keys into that account's authorized_keys;
//   3. install the sshd drop-in (HostKey = the per-boot host key, plus the one fleet authorization rule);
//   4. enable and reload-or-restart the live image's own ssh.service and READ BACK that it is active -- the
//      stage ends on `systemctl is-active`, so a boot where sshd did not come up fails the stage rather than
//      reporting a host the fleet cannot reach (gunbc.design_argument::fail_closed).
// No second daemon, no apt: openssh-server's presence in the live image is the CitedToAuthority observation
// beside the casper pins. Its live-session ACTIVATION is established by EXECUTED evidence inside this stage
// only -- the `systemctl is-active` read-back and the `sshd -T` effective-config read-back, both run against
// the live session and failing the stage otherwise. An authenticated read-back that would OBSERVE the transport
// accepting the fleet principal under the pinned host key is a modelled frontier, NOT executed or claimed here
// (the next rung). INTERIM SHELL like the capture stages beside it (the module's boot stages are realized shell
// until typed live-session HostEffects land); the SYSTEMD verbs come from the single argv authority in
// gunbc.extdeps.systemd.systemctl, not spelled here.
// The fleet-keys boot stage command, or the typed REFUSAL of a redirect pathname that will not admit.
// Surfaced by the program build (runner_host_medium_image) as the seed document that will not render, so a
// bad sshd drop-in path can never silently become a write to '/' or a nonsense target. The RED witness drives
// an empty pathname through runner_host_fleet_authorized_keys_stage_command to establish this arm is real, not
// a documented-unreachable case (gunbc.design_argument::fail_closed; the serving_launch admit-before-redirect pattern).
type RunnerHostFleetBootCommand
  = RunnerHostFleetBootBuilt { command: NonEmptyStr }
  | RunnerHostFleetBootRefused { path: String }

// Build the fleet-keys boot stage command for one sshd drop-in path, routing BOTH its redirects through the ONE
// POSIX redirect authority: admit_posix_redirect_pathname gates each pathname and emit_posix_redirection
// serializes it (extdeps.posix.shell_command_language). The admitted PosixRedirectPathname the gate hands back
// is exactly what the serializer consumes -- one source for what a redirect is (gunbc.design_argument::
// single_authority; the reviewer on review 92063). A pathname that will not admit (empty, or carrying a NUL)
// yields RunnerHostFleetBootRefused and NO shell is emitted for it.
fn runner_host_fleet_authorized_keys_stage_command(drop_in_path: String) -> RunnerHostFleetBootCommand {
  let account_ensure = ensure_job_account_converge_command_as_root(
    login: fleet_automation_principal_login,
    shell: fleet_automation_login_shell_path,
    home: fleet_automation_principal_home,
  )
  let enable = runner_host_capture_shell(argv: systemctl_enable_argv(unit: runner_host_ssh_service_unit))
  let restart = runner_host_capture_shell(argv: systemctl_reload_or_restart_argv(unit: runner_host_ssh_service_unit))
  let readback = runner_host_capture_shell(argv: systemctl_is_active_argv(unit: runner_host_ssh_service_unit))
  match admit_posix_redirect_pathname(path: drop_in_path) {
    PosixRedirectPathRefused { cause: _ } => RunnerHostFleetBootRefused { path: drop_in_path }
    PosixRedirectPathAdmitted { path: drop_in_pn } =>
      match admit_posix_redirect_pathname(path: "/dev/null") {
        PosixRedirectPathRefused { cause: _ } => RunnerHostFleetBootRefused { path: "/dev/null" }
        PosixRedirectPathAdmitted { path: devnull_pn } => RunnerHostFleetBootBuilt {
          // ONE '&&'-chain for the whole stage (the fail_closed fix review 92028 required). The account ensure
          // carries a TOP-LEVEL '||' (its precondition-guarded 'check || create' form), so it is PARENTHESIZED:
          // 'check || create && keys' would, at equal precedence, run the key install whenever the CREATE fails
          // (the very masking this fixes); '(check || create) && keys' runs the keys only when the account is
          // present-or-created. Every step below is newline-free, so the stage is ONE line: the first step whose
          // exit is non-zero ends the chain and becomes the stage's captured exit (RunnerHostSectionFailed) --
          // no earlier failure is masked by the final 'systemctl is-active' succeeding. The stage reports green only
          // when account, roster, drop-in, sshd coming up, AND the sshd -T read-back of the effective config all
          // held, with no 'set -e' (never_halts). That read-back is what keeps the hardening rung honest: an earlier
          // sshd_config.d file first-obtaining a keyword to a different value fails its grep and fails the stage,
          // rather than is-active reporting green over a hardening that silently did not take (fail_closed).
          command: concat(
            runner_host_interim_shell(node: RhShellChain {
              steps: [
                runner_host_interim_shell(node: RhShellGuarded { inner: account_ensure as String }),
                runner_host_fleet_authorized_keys_shell(),
                runner_host_fleet_sshd_drop_in_shell(stdout_redirect: emit_posix_redirection(redir: PosixRedirectStdoutClobber { word: drop_in_pn })),
                enable,
                restart,
                runner_host_fleet_sshd_effective_readback_shell(stderr_redirect: emit_posix_redirection(redir: PosixRedirectStderrClobber { word: devnull_pn })),
                runner_host_interim_shell(node: RhShellAnnotated {
                  body: readback,
                  note: dissolution_description(condition: authorized_key_install_dissolution_trigger),
                }),
              ],
            }),
            "\n",
          ) as NonEmptyStr,
        }
      }
  }
}

// The fleet-keys boot stage command for the module's OWN drop-in path, as the TYPED sum. There is no string
// escape hatch here: a refused redirect stays a RunnerHostFleetBootRefused -- no plausible output is ever
// fabricated (gunbc.design_argument::fail_closed) -- and callers match the sum: the boot roster via
// runner_host_up_stages, and the fleet-keys witnesses. This declaration is also the holder
// gunbc.integration_concern cites (decl_ref / CitesDeclaration) for the fleet_automation two-names fork, so it
// keeps its name rather than being deleted.
fn runner_host_fleet_authorized_keys_command() -> RunnerHostFleetBootCommand {
  runner_host_fleet_authorized_keys_stage_command(drop_in_path: runner_host_fleet_sshd_drop_in_path as String)
}

// THE ROSTER. The slot unit is a transient systemd unit started per attempt
// (gunbc.runner.runner_host_unit_slot HostUnitSlot.argv, systemd-run), so no slot unit exists at
// boot; what boot can establish about a slot is that systemd is the running manager systemd-run
// talks to (/run/systemd/system, sd_booted(3)) and that the listener the slot's argv names is
// installed and executable. The slot unit's own activity is the launch leg's readback.
// The runner boot stages, or the typed refusal of an inadmissible redirect pathname coming from the fleet-keys
// stage. Surfaced by runner_host_medium_image as the seed document that will not render (fail_closed): the boot
// program is never built with a silently-broken sshd drop-in write.
type RunnerHostUpStages
  = RunnerHostUpStagesBuilt { stages: List<HostCaptureStage> }
  | RunnerHostUpStagesRefused { path: String }

fn runner_host_up_stages(artifact: ActionsRunnerBinaryArtifact) -> RunnerHostUpStages {
  match runner_host_fleet_authorized_keys_stage_command(drop_in_path: runner_host_fleet_sshd_drop_in_path as String) {
    RunnerHostFleetBootRefused { path: p } => RunnerHostUpStagesRefused { path: p }
    RunnerHostFleetBootBuilt { command: fleet_command } => RunnerHostUpStagesBuilt { stages: [
    HostCaptureStage { name: runner_host_section_boot_media, command: shell_command_render(command: ls_one_per_line_command(path: udev_disk_by_label_dir)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_tarball_digest, command: shell_command_render(command: sha256sum_file_command(path: runner_host_medium_tarball_on_medium(artifact: artifact))) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_runner_clear, command: shell_command_render(command: rm_recursive_force_command(path: actions_runner_base_dir)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_runner_dir, command: shell_command_render(command: mkdir_parents_command(path: actions_runner_base_dir)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_runner_extract, command: shell_command_render(command: tar_extract_command(archive: runner_host_medium_tarball_on_medium(artifact: artifact), into_directory: actions_runner_base_dir, strip_components: 0, existing_directories: TarOverwriteDir)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_runner_listener, command: shell_command_render(command: test_executable_command(path: runner_host_listener_path())) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_runner_account, command: ensure_system_account_converge_command_as_root(login: runner_host_medium_runner_account, shell: fleet_posix_nologin_shell_path) },
    HostCaptureStage { name: runner_host_section_host_key_gen, command: runner_host_key_gen_command() as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_host_key_pub, command: runner_host_key_pub_command() as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_host_key_fingerprint, command: runner_host_key_fingerprint_command() as NonEmptyStr },
    // Placed AFTER the host-key stages on purpose: this stage's sshd drop-in names the per-boot host key the
    // host-key-gen stage just created, so the key exists by the time sshd is enabled and restarted.
    HostCaptureStage { name: runner_host_section_fleet_authorized_keys, command: fleet_command },
    HostCaptureStage { name: runner_host_section_systemd, command: shell_command_render(command: test_directory_command(path: systemd_booted_runtime_dir)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_meminfo, command: shell_command_render(command: cat_command(path: procfs_path_literal(p: ProcMeminfo) as String)) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_nproc, command: shell_command_render(command: nproc_command()) as NonEmptyStr },
    HostCaptureStage { name: runner_host_section_machine, command: shell_command_render(command: uname_machine_command()) as NonEmptyStr },
    ] }
  }
}

fn runner_host_medium_program_on_medium() -> NonEmptyStr {
  concat("/cdrom/", runner_host_medium_nocloud_dir as String, "/", runner_host_medium_program_file as String) as NonEmptyStr
}

data runner_host_medium_live_commands: UbuntuAutoinstallLiveCommands = UbuntuAutoinstallLiveCommands {
  autoinstall_version: 1,
  early_commands: [shell_command_render(command: posix_sh_script_command(path: runner_host_medium_program_on_medium())) as NonEmptyStr],
}

// THE DERIVATION REFUSES RATHER THAN DEFAULTS: no published arm64 runner tarball for the release, or
// a user-data document the renderer will not write, leaves no image.
type RunnerHostMediumImage
  = RunnerHostMediumImageDerived { input: UbuntuSeededInstallMediaBuildInput, runner: ActionsRunnerBinaryArtifact }
  | RunnerHostMediumRunnerUnpublished { binary_release: ActionsRunnerRelease }
  | RunnerHostMediumUserDataRefused { reason: String }

fn runner_host_medium_image(host: RunnerHostMediumHost) -> RunnerHostMediumImage {
  match actions_runner_binary_artifact_for_arch(binary_release: host_unit_slot_runner_release, arch: Aarch64) {
    Absent => RunnerHostMediumRunnerUnpublished { binary_release: host_unit_slot_runner_release }
    Present { value: artifact } =>
      match autoinstall_live_commands_user_data(payload: runner_host_medium_live_commands) {
        AutoinstallUserDataRefused { reason: r } => RunnerHostMediumUserDataRefused { reason: r }
        AutoinstallUserDataRendered { content: body } =>
          match runner_host_up_stages(artifact: artifact) {
            RunnerHostUpStagesRefused { path: p } =>
              RunnerHostMediumUserDataRefused { reason: concat("fleet authorized-keys boot stage refused: the sshd drop-in redirect pathname '", p, "' is not an admissible redirect target, so the runner boot seed document will not render (fail_closed; runner_host_fleet_authorized_keys_stage_command)") }
            RunnerHostUpStagesBuilt { stages: boot_stages } =>
          RunnerHostMediumImageDerived {
            runner: artifact,
            input: UbuntuSeededInstallMediaBuildInput {
              stock_artifact: noble_numbat_2404_3_live_server_arm64,
              nocloud_dir_on_iso: runner_host_medium_nocloud_dir,
              user_data_body: body as NonEmptyStr,
              seed_files: [
                NoCloudSeedFile {
                  name: runner_host_medium_program_file,
                  content: host_capture_program(
                    machine: host.machine,
                    console_device: host.console_device,
                    stages: boot_stages,
                    halt_command: runner_host_medium_halt_command,
                  ),
                },
              ],
              seed_artifacts: [runner_host_medium_seed_artifact(artifact: artifact)],
              grub_kernel_cmdline: concat(
                ubuntu_seeded_install_media_grub_kernel_cmdline(nocloud_dir: runner_host_medium_nocloud_dir) as String,
                " ",
                host.console_kernel_arg as String,
              ) as NonEmptyStr,
              volume_id: runner_host_medium_volume_id,
              pinned_dates: seeded_install_media_pinned_dates,
              image_stem: runner_host_medium_image_stem,
              builder_revision: seeded_install_media_builder_revision,
            },
          }
          }
      }
  }
}

// THE MEDIUM AUTHORS ONE FACT, THE MEASURED OUTPUT DIGEST of the built image -- its content digest,
// which the export's readback must equal (gunbc.host.boot_medium boot_medium_readback). Name and terminal
// derive from rows above, so a runner medium naming another artifact has no spelling. The one data
// row applying it is gunbc.machine_intake.mtcollins1_boot_run mtcollins1_boot_medium, carrying the digest
// of the publish receipt (wet publish run 39775218607).
fn runner_host_boot_medium(output_digest: NonEmptyStr) -> BootMedium {
  BootMedium {
    image_name: ubuntu_seeded_install_media_image_name(image_stem: runner_host_medium_image_stem, output_digest: output_digest),
    digest: output_digest,
    export: bmc_boot_image_export,
    terminal: BootMediumRunnerHostUp { label: runner_host_medium_volume_id },
  }
}

// ── THE ACCEPTANCE PREDICATE ─────────────────────────────────────────────────────────────────

// WHAT "RUNNER HOST UP" IS, READ BACK: the route's GuestIdleMeminfoAndNproc instrument
// (gunbc.runner.runner_throughput_qualification_route) at idle, before any job, plus the runner installed.
type RunnerHostUp {
  run: HostCaptureRunIdentity
  mem_total: Kibibyte
  mem_available: Kibibyte
  threads: HardwareThreadCount
  machine: Architecture
}

type RunnerHostUpRefusal
  = RunnerHostCaptureUnbound { reason: String }
  | RunnerHostSectionAbsent { name: NonEmptyStr }
  | RunnerHostSectionMalformed { name: NonEmptyStr, reason: String }
  | RunnerHostSectionFailed { name: NonEmptyStr, exit_code: String }
  | RunnerHostMeminfoFieldAbsent { field: NonEmptyStr }
  | RunnerHostNprocUnreadable { observed: String }
  | RunnerHostMachineUnrecognized { observed: String }
  | RunnerHostMachineNotAarch64 { observed: Architecture }
  | RunnerHostLabelAbsent { expected: NonEmptyStr, observed: List<String> }
  | RunnerHostTarballDigestDiffers { expected: NonEmptyStr, observed: String }
  | RunnerHostRunnerUnpublished { binary_release: ActionsRunnerRelease }
  | RunnerHostMediumTerminalNotRunnerHostUp { image: NonEmptyStr }

type RunnerHostUpReadback
  = RunnerHostUpPending { reason: String }
  | RunnerHostUpRefused { refusals: List<RunnerHostUpRefusal> }
  | RunnerHostUpObserved { up: RunnerHostUp }

fn runner_host_up_refusal_text(refusal: RunnerHostUpRefusal) -> String {
  match refusal {
    RunnerHostCaptureUnbound { reason: r } => concat("capture does not bind: ", r)
    RunnerHostSectionAbsent { name: n } => concat("closed envelope carries no ", n as String, " section")
    RunnerHostSectionMalformed { name: _, reason: r } => r
    RunnerHostSectionFailed { name: n, exit_code: c } => concat(n as String, " exited ", c)
    RunnerHostMeminfoFieldAbsent { field: f } => concat("meminfo carries no ", f as String)
    RunnerHostNprocUnreadable { observed: o } => concat("nproc printed ", o, ", not a positive count")
    RunnerHostMachineUnrecognized { observed: o } => concat("uname -m printed ", concat(o, ", which is no Linux machine spelling this projection cites"))
    RunnerHostMachineNotAarch64 { observed: a } => concat("uname -m read back ", concat(architecture_diagnostic_name(arch: a) as String, ", the runner image is arm64"))
    RunnerHostTarballDigestDiffers { expected: e, observed: o } => concat("the runner tarball on the medium read back sha256 ", concat(o, concat(", the release cites ", e as String)))
    RunnerHostRunnerUnpublished { binary_release: r } => concat("no arm64 runner tarball is published for release ", r.version as String)
    RunnerHostLabelAbsent { expected: e, observed: o } => concat("no block device carries the admitted medium's label ", concat(e as String, concat("; labels read: ", join(o, ", "))))
    RunnerHostMediumTerminalNotRunnerHostUp { image: i } => concat("the admitted medium ", concat(i as String, " does not name the runner-host-up terminal"))
  }
}

fn runner_host_last_line(out: List<String>) -> String {
  trim(s: fold(out, init: "", f: (acc, l) => if trim(s: l) == "" { acc } else { l }))
}

// ONE SECTION, READ ON A CLOSED ENVELOPE: absent, unterminated or failed refuses; held yields its
// output. Acceptance is only ever over a closed envelope (the END marker is the program's own
// statement that it wrote everything), so an unterminated section here is the program's defect.
type RunnerHostSectionRead
  = RunnerHostSectionHeld { output: List<String> }
  | RunnerHostSectionRefused { refusal: RunnerHostUpRefusal }

fn runner_host_section_read(envelope: BoundHostCaptureEnvelope, name: NonEmptyStr) -> RunnerHostSectionRead {
  match host_capture_section_reading(envelope: envelope, name: name as String) {
    SectionAbsent => RunnerHostSectionRefused { refusal: RunnerHostSectionAbsent { name: name } }
    SectionPending { output: _ } => RunnerHostSectionRefused { refusal: RunnerHostSectionMalformed { name: name, reason: concat(name as String, " section never printed its EXIT line inside a closed envelope") } }
    SectionMalformed { reason: r } => RunnerHostSectionRefused { refusal: RunnerHostSectionMalformed { name: name, reason: r } }
    SectionComplete { exit_code: c, output: out } =>
      if c == "0" { RunnerHostSectionHeld { output: out } } else { RunnerHostSectionRefused { refusal: RunnerHostSectionFailed { name: name, exit_code: c } } }
  }
}

fn runner_host_section_refusal(read: RunnerHostSectionRead) -> List<RunnerHostUpRefusal> {
  match read {
    RunnerHostSectionHeld { output: _ } => []
    RunnerHostSectionRefused { refusal: r } => [r]
  }
}

fn runner_host_section_output(read: RunnerHostSectionRead) -> List<String> {
  match read {
    RunnerHostSectionHeld { output: out } => out
    RunnerHostSectionRefused { refusal: _ } => []
  }
}

// THE TARBALL'S DIGEST IS READ BACK AND COMPARED HERE, as a typed refusal, rather than gated in the
// program: the medium's bytes are already established by the build (the seed artifact's readback)
// and by the export's readback of the whole image before attach, so this reading is the boot's
// evidence that the tarball it extracted is the cited release -- a mismatch refuses the terminal.
fn runner_host_tarball_digest_refusals(read: RunnerHostSectionRead) -> List<RunnerHostUpRefusal> {
  match actions_runner_binary_artifact_for_arch(binary_release: host_unit_slot_runner_release, arch: Aarch64) {
    Absent => [RunnerHostRunnerUnpublished { binary_release: host_unit_slot_runner_release }]
    Present { value: artifact } => {
      let expected = actions_runner_release_digest(artifact: artifact).hex
      match read {
        RunnerHostSectionRefused { refusal: r } => [r]
        RunnerHostSectionHeld { output: out } => {
          let line = runner_host_last_line(out: out)
          match sha256sum_line_digest(line: line) {
            Present { value: d } => if (d.hex as String) == (expected as String) { [] } else { [RunnerHostTarballDigestDiffers { expected: expected, observed: d.hex as String }] }
            Absent => [RunnerHostTarballDigestDiffers { expected: expected, observed: line }]
          }
        }
      }
    }
  }
}

// EVERY REFUSAL IS NAMED, NOT THE FIRST: a host whose runner install failed AND whose nproc is short
// reports both, so one boot answers both questions.
fn runner_host_up_over_closed(envelope: BoundHostCaptureEnvelope, label: NonEmptyStr) -> RunnerHostUpReadback {
  let media_read = runner_host_section_read(envelope: envelope, name: runner_host_section_boot_media)
  let labels = filter(map(runner_host_section_output(read: media_read), l => trim(s: l)), l => l != "")
  let media_refusals = match media_read {
    RunnerHostSectionRefused { refusal: r } => [r]
    RunnerHostSectionHeld { output: _ } =>
      if any(labels, l => l == (label as String)) { [] } else { [RunnerHostLabelAbsent { expected: label, observed: labels }] }
  }
  let digest_refusals = runner_host_tarball_digest_refusals(read: runner_host_section_read(envelope: envelope, name: runner_host_section_tarball_digest))
  // Gates come from the ONE derived list (runner_host_up_plain_gate_section_names, above), never a hand copy --
  // so fleet-authorized-keys and every future stage are required here exactly as in the open reader.
  let gates = append(append(media_refusals, items: digest_refusals), items: flat_map(
    runner_host_up_plain_gate_section_names(),
    n => runner_host_section_refusal(read: runner_host_section_read(envelope: envelope, name: n)),
  ))
  let mem_read = runner_host_section_read(envelope: envelope, name: runner_host_section_meminfo)
  let nproc_read = runner_host_section_read(envelope: envelope, name: runner_host_section_nproc)
  let machine_read = runner_host_section_read(envelope: envelope, name: runner_host_section_machine)
  let meminfo = parse_proc_meminfo(text: join(runner_host_section_output(read: mem_read), "\n"))
  let nproc_text = runner_host_last_line(out: runner_host_section_output(read: nproc_read))
  let nproc = match parse_int(s: nproc_text) {
    Absent => none
    Present { value: n } => if n > 0 { checked_int_to_nat(n: n) } else { none }
  }
  let machine = runner_host_last_line(out: runner_host_section_output(read: machine_read))
  let mem_refusals = match mem_read {
    RunnerHostSectionRefused { refusal: r } => [r]
    RunnerHostSectionHeld { output: _ } =>
      match meminfo {
        MeminfoFieldAbsent { field: f } => [RunnerHostMeminfoFieldAbsent { field: f }]
        MeminfoParsed { meminfo: _ } => []
      }
  }
  let nproc_refusals = match nproc_read {
    RunnerHostSectionRefused { refusal: r } => [r]
    RunnerHostSectionHeld { output: _ } =>
      match nproc {
        Absent => [RunnerHostNprocUnreadable { observed: nproc_text }]
        Present { value: _ } => []
      }
  }
  let arch = uname_linux_machine_architecture(spelling: machine)
  let machine_refusals = match machine_read {
    RunnerHostSectionRefused { refusal: r } => [r]
    RunnerHostSectionHeld { output: _ } =>
      match arch {
        Absent => [RunnerHostMachineUnrecognized { observed: machine }]
        Present { value: Aarch64 } => []
        Present { value: other } => [RunnerHostMachineNotAarch64 { observed: other }]
      }
  }
  let refusals = append(append(append(gates, items: mem_refusals), items: nproc_refusals), items: machine_refusals)
  match meminfo {
    MeminfoParsed { meminfo: m } =>
      match nproc {
        Present { value: n } =>
          match arch {
            Present { value: a } =>
              if count(refusals) == 0 {
                RunnerHostUpObserved { up: RunnerHostUp { run: envelope.run, mem_total: m.mem_total, mem_available: m.mem_available, threads: hardware_thread_count(count: n), machine: a } }
              } else {
                RunnerHostUpRefused { refusals: refusals }
              }
            Absent => RunnerHostUpRefused { refusals: refusals }
          }
        Absent => RunnerHostUpRefused { refusals: refusals }
      }
    MeminfoFieldAbsent { field: _ } => RunnerHostUpRefused { refusals: refusals }
  }
}

// AN OPEN ENVELOPE NEVER ACCEPTS, AND REFUSES EARLY ONLY ON A COMPLETE SECTION THAT FAILED: a runner
// install step that exited nonzero is a complete fact about that run before END is printed.
fn runner_host_up_over_open(envelope: BoundHostCaptureEnvelope) -> RunnerHostUpReadback {
  let failed = flat_map(runner_host_up_section_names, n => match host_capture_section_reading(envelope: envelope, name: n as String) {
    SectionComplete { exit_code: c, output: _ } => if c == "0" { [] } else { [RunnerHostSectionFailed { name: n, exit_code: c }] }
    SectionMalformed { reason: r } => [RunnerHostSectionMalformed { name: n, reason: r }]
    SectionAbsent => []
    SectionPending { output: _ } => []
  })
  if count(failed) == 0 { RunnerHostUpPending { reason: "envelope open; no complete section refuses" } } else { RunnerHostUpRefused { refusals: failed } }
}

// THE PREDICATE THE BOOT RUN'S TERMINAL WATCH DELEGATES TO for a BootMediumRunnerHostUp medium. The
// capture binds to the subject's machine and run (one envelope, never a search over the stream), and
// the label it must establish is the one on the ADMITTED subject's medium, compared to the labels the
// host listed -- not a module constant, so a subject admitted with another label is refused by a
// capture of this image.
fn runner_host_up_readback(capture: String, subject: AdmittedBootSubject) -> RunnerHostUpReadback {
  match subject.medium.terminal {
    BootMediumRunnerHostUp { label: label } =>
      runner_host_up_readback_of(capture: capture, machine: boot_subject_machine(subject: subject), label: label)
    BootMediumVolumeLabel { label: _ } => RunnerHostUpRefused { refusals: [RunnerHostMediumTerminalNotRunnerHostUp { image: subject.medium.image_name }] }
    BootMediumNoTerminal { reason: _ } => RunnerHostUpRefused { refusals: [RunnerHostMediumTerminalNotRunnerHostUp { image: subject.medium.image_name }] }
  }
}

// THE EPHEMERAL ROW'S RUNNING-OS FACT (gunbc.host.running_os): the runner medium runs its delivered artifact in
// memory, so a runner-host-up readback of the admitted subject proves that subject's medium digest is what runs, on
// the boot the capture names. It reads the same subject the readback is taken over, so the digest and the readback
// cannot come from two subjects. A capture keyed by a historical attempt ordinal names no boot and is unobserved.
fn runner_host_running_os(capture: String, subject: AdmittedBootSubject) -> RunningOsReading {
  match runner_host_up_readback(capture: capture, subject: subject) {
    RunnerHostUpPending { reason: r } => RunningOsUnobserved { cause: concat("the runner-host-up capture is not closed: ", r) }
    RunnerHostUpRefused { refusals: rs } => RunningOsUnobserved { cause: concat("the capture does not establish runner-host-up: ", join(map(rs, x => runner_host_up_refusal_text(refusal: x)), "; ")) }
    RunnerHostUpObserved { up: up } => runner_host_running_os_of_up(up: up, subject: subject)
  }
}

// THE READING OF AN ACCEPTED RUNNER-HOST-UP over the subject it was read for: one fold, so the boot run, which
// carries the accepted reading rather than the capture (gunbc.machine_intake.mtcollins1_boot_run), states the same
// running OS this module's readback does.
fn runner_host_running_os_of_up(up: RunnerHostUp, subject: AdmittedBootSubject) -> RunningOsReading {
  match host_boot_id_of_capture_run(run: up.run) {
    Present { value: boot } => RunningOsObserved { running: RunningDeliveredArtifact { digest: subject.medium.digest }, observed_host: boot_subject_host(subject: subject), observed_on: boot }
    Absent => RunningOsUnobserved { cause: "the capture names a historical attempt ordinal, not a kernel boot id" }
  }
}

// THE READBACK OVER A MACHINE NAME AND A LABEL, for a consumer that holds a capture and no boot: the
// boot subject's own readback delegates here, so the bind and the acceptance are one fold. The caller
// names the machine the envelope must bind to and the label of the medium it expects
// (runner_host_medium_volume_id for this module's image).
fn runner_host_up_readback_of(capture: String, machine: NonEmptyStr, label: NonEmptyStr) -> RunnerHostUpReadback {
  match host_capture_bind(capture: capture, machine: machine) {
    HostCaptureNotBegun => RunnerHostUpPending { reason: "no begin marker for this machine yet" }
    HostCaptureUnbound { reason: r } => RunnerHostUpRefused { refusals: [RunnerHostCaptureUnbound { reason: r }] }
    HostCaptureOpen { envelope: e } => runner_host_up_over_open(envelope: e)
    HostCaptureBound { envelope: e } => runner_host_up_over_closed(envelope: e, label: label)
  }
}

// THE SOL READER (S4(c)): the fleet's pin for this boot, read out of the CLOSED, BOUND envelope the serial console
// carried. Bound to the machine first (host_capture_bind: one begin, its matching end, never a search over the
// stream), so the pin cannot be assembled from another run; the expected boot id is that envelope's own run identity,
// the kernel boot id the markers carry. The pin is composed from the host-key-pub and host-key-fingerprint sections only when
// every host-key section EXITED 0 -- those sections show the key was generated and read back on this boot,
// not that any daemon serves it (none is started here).
// An open envelope observes nothing (the program's END is its own statement that it wrote everything), and a
// section that printed none, or a malformed one, is not observed. The pin is built here from the
// producers' own outputs through checked_host_key (the console grammar is not composed and re-parsed).
type RunnerHostKeyObservation
  = RunnerHostKeyObserved { boot_id: NonEmptyStr, pin: PerBootHostPin }
  | RunnerHostKeyNotObserved { cause: String }

// The nth space-separated field of a section's first non-empty line; Absent when the section has none, so absence is
// never composed into a line as an empty field.
fn runner_host_nth_field(output: List<String>, n: Int) -> String? {
  match first(filter(map(output, l => trim(s: l)), l => l != "")) {
    Absent => none
    Present { value: l } => first(skip(filter(split(s: l, delimiter: " "), f => f != ""), n: n))
  }
}

fn runner_host_key_observation(capture: String, machine: NonEmptyStr, row: AnchoredHostRow) -> RunnerHostKeyObservation {
  match host_capture_bind(capture: capture, machine: machine) {
    HostCaptureNotBegun => RunnerHostKeyNotObserved { cause: "no begin marker for this machine in the console read" }
    HostCaptureUnbound { reason: r } => RunnerHostKeyNotObserved { cause: r }
    HostCaptureOpen { envelope: _ } => RunnerHostKeyNotObserved { cause: "the envelope is still open; no pin is taken before END" }
    HostCaptureBound { envelope: e } => {
      let refusals = flat_map(
        [runner_host_section_host_key_gen, runner_host_section_host_key_pub, runner_host_section_host_key_fingerprint],
        n => runner_host_section_refusal(read: runner_host_section_read(envelope: e, name: n)),
      )
      if count(refusals) != 0 {
        RunnerHostKeyNotObserved { cause: join(map(refusals, r => runner_host_up_refusal_text(refusal: r)), "; ") }
      } else {
        let pub_read = runner_host_section_output(read: runner_host_section_read(envelope: e, name: runner_host_section_host_key_pub))
        let fp_read = runner_host_section_output(read: runner_host_section_read(envelope: e, name: runner_host_section_host_key_fingerprint))
        let boot_id = host_capture_run_identity_value(run: e.run)
        match runner_host_nth_field(output: pub_read, n: 0) {
          Absent => RunnerHostKeyNotObserved { cause: "the host-key-pub section printed no key type" }
          Present { value: key_type } => match runner_host_nth_field(output: pub_read, n: 1) {
            Absent => RunnerHostKeyNotObserved { cause: "the host-key-pub section printed no key blob" }
            Present { value: key_b64 } => match runner_host_nth_field(output: fp_read, n: 1) {
              Absent => RunnerHostKeyNotObserved { cause: "the host-key-fingerprint section printed no fingerprint" }
              Present { value: fingerprint } => {
                if boot_id == "" {
                  RunnerHostKeyNotObserved { cause: "the envelope carries no boot id" }
                } else {
                  match checked_host_key(boot_id: boot_id as NonEmptyStr, key_type: key_type, key_b64: key_b64, fingerprint: fingerprint) {
                    Absent => RunnerHostKeyNotObserved { cause: "the key type, blob or fingerprint printed by the key sections did not check" }
                    Present { value: checked } => RunnerHostKeyObserved { boot_id: boot_id as NonEmptyStr, pin: per_boot_pin_from_checked_key(row: row, parsed: checked) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
