module gunbc.runner.runner_registration_labels

import std.types { String, NonEmptyStr, List, Bool }
import std.optional { Present, Absent }
import product.host_identity { HostIdentity }
import extdeps.github.actions { SelfHosted, HostedRunner, RunsOnExpression }
import gunbc.ci.ci_fleet { fleet_compute_offer_for }
import gunbc.runner.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.runner.runner_slot_allocation { runner_host_label, runner_label_set_union, runner_label_sets_equal }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }
import gunbc.runner.runner_host_deploy { runner_job_user_session_on }
import gunbc.runner.runner_slot_job_role { RunnerSlotJobRole, CiJobSlot, DeployJobSlot, runner_slot_job_role }
import gunbc.ci.deploy_slot_tenancy { deploy_slot_runner_group_name }

// ONE COMPOSITION, EVERY PRODUCER. A registration's labels are made of three facts, each read from
// the one place that owns it:
//   platform  self-hosted / os / arch   gunbc.runner.runner_spec_from_offer, from the host's ComputeOffer
//   class     gunbc-heavy                gunbc.runner.runner_slot_desired gunbc_runner_slot_desired
//   host      the host it executes on    gunbc.runner.runner_slot_allocation runner_host_label
// Unit-file registration, JIT mint, the replace postcondition and the org-roster readback all read
// their labels here. The host-pinned selector (gunbc.ci.ci_deploy_target_host host_pinned_runner_spec)
// reads its platform labels from the same runner_spec_from_offer and its host label from the same
// runner_host_label, so any label it names is one a registration carries.
//
// A HOST WITH NO FLEET COMPUTE OFFER REFUSES. Its OS and architecture are unknown, and filling them
// in with the labels the enrolled hosts carry would register a runner under an architecture nobody
// observed on that host.
type RunnerRegistrationLabelsResolution
  = RegistrationLabelsResolved { labels: List<String> }
  | RegistrationLabelsRefused { host: HostIdentity, cause: NonEmptyStr }

fn runner_registration_labels(host: HostIdentity) -> RunnerRegistrationLabelsResolution {
  match runner_registration_labels_of_class(host: host, class_labels: gunbc_runner_slot_desired().labels.github_labels) {
    RegistrationLabelsResolved { labels: ls } =>
      RegistrationLabelsResolved { labels: runner_label_set_union(a: ls, b: runner_user_session_labels_for(host: host)) }
    refused => refused
  }
}

// THE CLASS HALF OF THE COMPOSITION IS THE ONLY PART A ROLE CHANGES. A CI slot carries the class
// label the floor selects on (gunbc-heavy); the deploy slot carries the label of its restricted
// runner group (gunbc.ci.deploy_slot_tenancy deploy_slot_runner_group_name) and NOT gunbc-heavy, so
// a job that selects the CI class can never be satisfied by it. The group, not this label, is the
// wall -- a label is set membership and any workflow can name one -- which is why the label is
// necessary for fleet-converge to reach the slot and not sufficient to keep anything else off it.
fn runner_registration_labels_of_class(host: HostIdentity, class_labels: List<String>) -> RunnerRegistrationLabelsResolution {
  match fleet_compute_offer_for(host: host) {
    Absent =>
      RegistrationLabelsRefused {
        host: host,
        cause: "host has no fleet compute offer, so its platform labels (os, architecture) are unknown and no registration label set is derived" as NonEmptyStr,
      }
    Present { value: offer } =>
      match runner_spec_from_offer(offer: offer) {
        SelfHosted { labels: platform } =>
          RegistrationLabelsResolved {
            labels: runner_label_set_union(
              a: runner_user_session_label_stripped(labels: runner_label_set_union(a: platform, b: class_labels)),
              b: [runner_host_label(host: host)],
            ),
          }
        HostedRunner { label: _ } => registration_labels_refused_not_self_hosted(host: host)
        RunsOnExpression { expression: _ } => registration_labels_refused_not_self_hosted(host: host)
      }
  }
}

// ONE SLOT'S LABELS: the host's, with the class its role gives it.
fn runner_slot_registration_labels(slot: RunnerSlotIdentity) -> RunnerRegistrationLabelsResolution {
  match runner_slot_job_role(slot: slot) {
    CiJobSlot => runner_registration_labels(host: slot.host)
    DeployJobSlot => runner_registration_labels_of_class(host: slot.host, class_labels: [deploy_slot_runner_group_name as String])
  }
}

// ── USER-SESSION READINESS: A LABEL THE RUNNER_JOB_USER_SESSION_HOSTS ROW GRANTS AND NOTHING ELSE ──
//
// A job account with no lingering user manager cannot start the daemons a job needs: they die with
// the transient scope the job ran in (the defect fleet-converge run 40222057493's mode exists to fix).
// A host's user session is therefore a capability, and -- per the browser-ready and gpu-docker rulings
// and review 86550's "a capability a host can gain and lose has to be a LABEL" -- it reaches the
// registration as a label, so a workflow can select it and a host that never went through the converge
// simply never appears in its pool.
//
// ITS ONLY AUTHORITY IS THE ROW: gunbc.runner.runner_host_deploy runner_job_user_session_hosts records
// the hosts whose job account was lingered by the administrator and whose user manager at
// /run/user/<uid>/bus answers -- that is exactly what that row's converge leg observes and reads back
// (gunbc.runner.runner_user_session: enable-linger ran, Linger=yes read back, the bus socket answers).
// No caller may pass this label; the composition adds it iff the row names the host, so deleting the
// row deletes the label. srv4 earned it on 2026-10-26: the receipt sits beside the row as data
// (gunbc.runner.runner_host_deploy runner_job_user_session_converge_run_id +
// runner_job_user_session_converge_readback), not as a restatement here. srv1/srv3/srv2 carry no row, so their
// label sets are byte-identical to before this constant existed -- the label PR adds no label to a
// host that has not been converged, and the runs-on selector step lands only once every pool host
// reads ready.
data gunbc_user_session_label: String = "gunbc-user-session"

// THE ROW, NOT AN ARGUMENT. The labels a JOB runner registers with, gated by the row. It is added at
// the job entry, not inside runner_registration_labels_of_class: the row is about the job account's user
// manager, and the deploy slot runs the separate deploy principal (whose own labels the role drop-in
// sets) -- gating inside _of_class would hand a capability the deploy principal never earned. Every
// producer reads the job entry (unit fragment, JIT mint, the replace postcondition, the roster readback,
// and the conformance check's desired set), so the grant, the registration and the observed-vs-desired
// comparison cannot disagree about it.
fn runner_user_session_labels_for(host: HostIdentity) -> List<String> {
  if runner_job_user_session_on(host: host) { [gunbc_user_session_label] } else { [] }
}

// THE GRANT IS NOT FORGEABLE THROUGH A CALLER OR AN OFFER ROW. Both halves a host can reach the
// registration through -- its own compute-offer platform labels and the class labels a caller passes --
// are STRIPPED of this label, which is then added only from the row. Without the strip, editing one
// label in a host's offer row, or one class_labels argument, would advertise a user session that host
// never had; that is exactly why the browser-ready label is a written drop-in rather than a
// host-chosen string. test.claim.runner.runner_user_session_label_witness drives both channels.
fn runner_user_session_label_stripped(labels: List<String>) -> List<String> {
  filter(labels, l => l != gunbc_user_session_label)
}

// ── BROWSER READINESS: A LABEL THE BROWSER-TOOLCHAIN CONVERGE GRANTS AND NOTHING ELSE ─────────────
//
// The floor runs real-Chromium wet claims inside its claim_executor run, so a runner on a host whose
// browser toolchain was never converged refuses them (a wet claim on srv1 at the missing toolchain tree). The
// host's readiness is therefore a LABEL: gunbc.runner.runner_browser_toolchain
// browser_ready_labels_converge_wet writes it as a template drop-in when that converge's readback
// holds and removes it when it does not, and once every host in the floor's pool reads ready the
// floor's runs-on names it -- so an unconverged runner cannot take the floor at all.
data gunbc_browser_ready_label: String = "gunbc-browser-ready"

fn runner_browser_ready_registration_labels(host: HostIdentity) -> RunnerRegistrationLabelsResolution {
  match runner_registration_labels(host: host) {
    RegistrationLabelsRefused { host: h, cause: c } => RegistrationLabelsRefused { host: h, cause: c }
    RegistrationLabelsResolved { labels: ls } =>
      RegistrationLabelsResolved { labels: runner_label_set_union(a: ls, b: [gunbc_browser_ready_label]) }
  }
}

// ── GPU CONTAINER READINESS: A LABEL THE GPU-CONTAINER-TOOLCHAIN CONVERGE GRANTS AND NOTHING ELSE ──
//
// Same shape as browser-ready, and the reason is the same: a capability a host can gain and lose has
// to be a LABEL, so a workflow selects the capability and an unconverged runner cannot take the job.
// gunbc.runner.runner_gpu_container_toolchain gpu_docker_labels_converge_wet writes it as a template
// drop-in when that converge's readback holds (rootless Docker reachable by the job user, the NVIDIA
// container toolkit installed, a CDI spec generated) and removes it when it does not.
//
// IT STATES THE CONTAINER HALF ONLY, and that is the one way this label is NOT a copy of
// browser-ready. It does not assert the slot's job principal is free of root equivalence: the model
// already classes the docker GROUP as root-equivalent
// (gunbc.fleet.fleet_posix_accounts fleet_root_equivalent_group_names lists "docker"), which is why
// the group route is refused and rootless Docker is the shape. A consumer that reads this label as
// the whole precondition has silently dropped the principal half, so consumers assert on both and
// answer exit 2 (no observation) for either -- never green.
data gunbc_gpu_docker_label: String = "gunbc-gpu-docker"

// ── CAPABILITIES AS ROWS, RESTATED BY ONE FOLD ────────────────────────────────────────────────────
//
// THE SECOND ONE IS WHERE THE PATTERN HAS TO GENERALIZE, and review 86550 said so. The first capability
// label (browser, 85-) was written by one producer alone. The second (gpu, 86-) arrived as a second
// producer, and because systemd applies a template's drop-ins in filename order with the LATER value of a
// repeated key REPLACING the earlier one, the 86 file is the only LABELS_JSON a host holding both
// toolchains ever sees — so it had to know the browser label's name and restate it, or silently revoke it.
// A third capability written the same way would have to know about both of its predecessors plus carry its
// own read for each, the cost grows quadratically, and forgetting one name silently revokes a label with
// nothing on the owning side reporting it. That is the same defect this function's own comment describes,
// one capability later.
//
// SO A CAPABILITY IS A ROW, AND THE FOLD IS SHARED. A capability declares a label and the drop-in whose
// bytes are the evidence that it was earned. Any converge that writes a LABELS_JSON drop-in passes the
// rows it OBSERVED plus the label it is granting itself, and one function composes the set. Adding a
// fourth capability adds a row; it does not add a branch to a sibling, and no sibling has to learn its
// name. Each converge still grants only what its own read-back earned — the fold restates what other
// converges earned, and refuses when a sibling's evidence cannot be read at all.
type HostCapabilityRow {
  label: String
  // The drop-in whose bytes are the EVIDENCE that this capability was granted by its own converge. Not the
  // fragment, not a database: the file the owning converge writes when its read-back holds, and removes
  // when it does not. Reading it is asking the host rather than re-deriving a verdict here, which is what
  // keeps this module from becoming a second authority on someone else's toolchain.
  dropin_path: NonEmptyStr
}

// WHAT A READ OF ONE ROW CAN ANSWER, with the third answer not collapsible into the second. ABSENT is a
// decision — the file carries no such label, so it is withheld. UNOBSERVABLE is not a decision, it is the
// read that failed, and treating it as ABSENT would strip a label a host legitimately holds because one ssh
// blipped, with nothing on the owning side reporting it.
//
// THE PREDICATE OVER THESE LIVES BESIDE THE FOLD, in gunbc.runner.runner_capability_labels: deciding
// whether a witness contributes a label is part of composing the set, and splitting the two would let the
// predicate and the fold disagree about what HELD means.
type HostCapabilityWitness
  = CapabilityHeld { label: String }
  | CapabilityAbsent { label: String }
  | CapabilityUnobservable { label: String, cause: String }

// THE FOLD LIVES IN gunbc.runner.runner_capability_labels, beside the rows it validates witnesses
// against, because validating a witness requires seeing the declared rows and this module must not have to
// know them. The types above stay here: they are the vocabulary, and the vocabulary has no opinions about
// which capabilities exist.



// WHETHER AN OBSERVED REGISTRATION CONFORMS TO ITS SLOT. The host's set exactly, or the host's set
// plus the readiness label: those are the only two states the converge writes, so both are healthy,
// and anything else -- another host's label, a stray extra -- is a divergence. Treating the ungranted
// state as diverged would make the recovery path churn every slot on a host whose toolchain is not
// converged yet; withholding the label is already the refusal, because the floor selects on it.
type RegistrationLabelsConformance
  = RegistrationLabelsConform
  | RegistrationLabelsDiverge
  | RegistrationLabelsUnjudged { host: HostIdentity, cause: NonEmptyStr }

// THE READINESS LABEL IS THE FLOOR'S, so only a slot the floor can run on may carry it; the deploy
// slot's label set is exactly its own, and a readiness label on it is a divergence.
fn runner_slot_carries_browser_ready(slot: RunnerSlotIdentity) -> Bool {
  match runner_slot_job_role(slot: slot) {
    CiJobSlot => true
    DeployJobSlot => false
  }
}

fn runner_slot_labels_conform(slot: RunnerSlotIdentity, observed: List<String>) -> RegistrationLabelsConformance {
  match runner_slot_registration_labels(slot: slot) {
    RegistrationLabelsRefused { host: h, cause: c } => RegistrationLabelsUnjudged { host: h, cause: c }
    RegistrationLabelsResolved { labels: host_labels } =>
      if runner_label_sets_equal(a: observed, b: host_labels)
        || (runner_slot_carries_browser_ready(slot: slot)
          && runner_label_sets_equal(a: observed, b: runner_label_set_union(a: host_labels, b: [gunbc_browser_ready_label]))) {
        RegistrationLabelsConform
      } else {
        RegistrationLabelsDiverge
      }
  }
}

fn registration_labels_refused_not_self_hosted(host: HostIdentity) -> RunnerRegistrationLabelsResolution {
  RegistrationLabelsRefused {
    host: host,
    cause: "the host's compute offer did not project to a self-hosted runner spec, so it has no self-hosted registration label set" as NonEmptyStr,
  }
}
