module gunbc.runner.runner_registration_labels

import std.types { String, NonEmptyStr, List, Bool }
import std.optional { Optional, Present, Absent }
import product.host_identity { HostIdentity }
import extdeps.github.actions { SelfHosted, HostedRunner, RunsOnExpression }
import gunbc.ci.ci_fleet { fleet_compute_offer_for }
import gunbc.runner.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.runner.runner_slot_allocation { runner_host_label, runner_label_set_union, runner_label_sets_equal }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity }
import gunbc.runner.runner_slot_desired { gunbc_runner_slot_desired }
import gunbc.runner.runner_host_deploy { runner_job_user_session_hosts }
import gunbc.runner.runner_user_session_receipt {
  RunnerUserSessionConvergeReceipt, RunnerUserSessionReceiptInput, ReceiptSupplied, ReceiptUnreadable, ReceiptAbsent,
  runner_user_session_converge_receipt_failure, runner_user_session_converge_receipt_names_host,
  runner_user_session_converge_receipt_staleness,
}
import gunbc.runner.runner_slot_job_role { RunnerSlotJobRole, CiJobSlot, DeployJobSlot, runner_slot_job_role }
import gunbc.ci.deploy_slot_tenancy { deploy_slot_runner_group_name }

// TWO QUESTIONS, TWO FUNCTIONS, AND NEITHER IS A SECOND ANSWER TO THE OTHER.
//   runner_declared_registration_labels          WHICH LABELS DOES THE HOST'S DECLARATION GIVE IT? Platform, class and
//                                                host label, read from declarations only. No observation enters it.
//   runner_evidence_gated_registration_labels    WHICH LABELS MAY THE HOST REGISTER UNDER NOW? The declared labels plus
//                                                every label an observation licenses (today the user-session label, granted
//                                                by a parsed converge receipt the caller supplies).
// A registration, a replace postcondition or a readback asks the second. A declarative emission asks the first.
//
// ONE COMPOSITION, EVERY PRODUCER. A registration's labels are made of three facts, each read from
// the one place that owns it:
//   platform  self-hosted / os / arch   gunbc.runner.runner_spec_from_offer, from the host's ComputeOffer
//   class     gunbc-heavy                gunbc.runner.runner_slot_desired gunbc_runner_slot_desired
//   host      the host it executes on    gunbc.runner.runner_slot_allocation runner_host_label
// Unit-file registration, JIT mint, the replace postcondition and the org-roster readback all read
// their labels here. The host-pinned selector (gunbc.ci.ci_deploy_target_host host_pinned_runner_spec)
// reads its platform labels from the same runner_spec_from_offer and its host label from the same
// runner_host_label, so any label it names is one a registration carries.
//
// A HOST WITH NO FLEET COMPUTE OFFER REFUSES. Its OS and architecture are unknown, and filling them
// in with the labels the enrolled hosts carry would register a runner under an architecture nobody
// observed on that host.
type RunnerRegistrationLabelsResolution
  = RegistrationLabelsResolved { labels: List<String> }
  | RegistrationLabelsRefused { host: HostIdentity, cause: NonEmptyStr }

// THE HOST'S REGISTRATION LABELS GIVEN THE CONVERGE RECEIPT THE CALLER OBSERVED. The receipt is a PARAMETER
// and never read here: every production leg obtains it at its own effect edge from
// gunbc.runner.runner_user_session_receipt_observed runner_user_session_receipt_observed, so freshness is
// judged at that leg's read time and this resolution stays pure. ReceiptAbsent is a value a caller may
// still pass (an unrostered host, a run listing with no qualifying run) and answers label-off; no default
// supplies it. Controls drive the parameter with receipts supplied at the boundary the same way the class
// half is driven with a class_labels argument.
fn runner_evidence_gated_registration_labels(host: HostIdentity, receipt: RunnerUserSessionReceiptInput) -> RunnerRegistrationLabelsResolution {
  match runner_declared_registration_labels(host: host) {
    RegistrationLabelsResolved { labels: ls } =>
      RegistrationLabelsResolved {
        labels: runner_label_set_union(a: ls, b: runner_user_session_labels_of_roster(host: host, roster: runner_job_user_session_hosts, receipt: receipt)),
      }
    refused => refused
  }
}

// THE LABELS A HOST'S DECLARATION ALONE GIVES IT: the offer's platform labels, the CI class and the host's own
// label, with no evidence-granted label. It is the whole of the resolution minus the user-session grant, which
// is the one part that depends on a live read. A consumer that answers a DECLARATIVE question -- which hosts
// carry the labels the floor job selects (gunbc.runner.runner_browser_toolchain host_runs_floor_labels,
// consumed while the workflows are emitted) -- reads this, because an emission must not depend on a network
// observation. That is sound only while no consumer's runs-on names the user-session label; the change that
// first selects it has to read the receipt at an effect edge, not here.
fn runner_declared_registration_labels(host: HostIdentity) -> RunnerRegistrationLabelsResolution {
  runner_registration_labels_of_class(host: host, class_labels: gunbc_runner_slot_desired().labels.github_labels)
}

// THE CLASS HALF OF THE COMPOSITION IS THE ONLY PART A ROLE CHANGES. A CI slot carries the class
// label the floor selects on (gunbc-heavy); the deploy slot carries the label of its restricted
// runner group (gunbc.ci.deploy_slot_tenancy deploy_slot_runner_group_name) and NOT gunbc-heavy, so
// a job that selects the CI class can never be satisfied by it. The group, not this label, is the
// wall -- a label is set membership and any workflow can name one -- which is why the label is
// necessary for fleet-converge to reach the slot and not sufficient to keep anything else off it.
fn runner_registration_labels_of_class(host: HostIdentity, class_labels: List<String>) -> RunnerRegistrationLabelsResolution {
  match fleet_compute_offer_for(host: host) {
    Absent =>
      RegistrationLabelsRefused {
        host: host,
        cause: "host has no fleet compute offer, so its platform labels (os, architecture) are unknown and no registration label set is derived" as NonEmptyStr,
      }
    Present { value: offer } =>
      match runner_spec_from_offer(offer: offer) {
        SelfHosted { labels: platform } =>
          RegistrationLabelsResolved {
            labels: runner_label_set_union(
              a: runner_user_session_label_stripped(labels: runner_label_set_union(a: platform, b: class_labels)),
              b: [runner_host_label(host: host)],
            ),
          }
        HostedRunner { label: _ } => registration_labels_refused_not_self_hosted(host: host)
        RunsOnExpression { expression: _ } => registration_labels_refused_not_self_hosted(host: host)
      }
  }
}

// THE DEPLOY SLOT TAKES NO RECEIPT: a different principal, so no evidence-granted label reaches it and the
// signature carries no parameter that could grant one.
fn runner_deploy_slot_registration_labels(slot: RunnerSlotIdentity) -> RunnerRegistrationLabelsResolution {
  runner_registration_labels_of_class(host: slot.host, class_labels: [deploy_slot_runner_group_name as String])
}

// ── USER-SESSION READINESS: A LABEL THE CONVERGE RECEIPT GRANTS AND NOTHING ELSE ──────────────────
//
// A job account with no lingering user manager cannot start the daemons a job needs: they die with
// the transient scope the job ran in (the defect fleet-converge run 40222057493's mode exists to fix).
// A host's user session is therefore a capability, and -- per the browser-ready and gpu-docker rulings
// and review 86550's "a capability a host can gain and lose has to be a LABEL" -- it reaches the
// registration as a label, so a workflow can select it and a host that never went through the converge
// simply never appears in its pool.
//
// THE LABEL HAS TWO INPUTS, EACH WITH ONE JOB, AND NEITHER IS A SENTENCE ABOUT THE OTHER:
// gunbc.runner.runner_host_deploy runner_job_user_session_hosts is the ROSTER -- the population an
// administrator put on the converge (it is the converge's INPUT list; runner_job_user_session_on reads
// it to decide whom to converge). gunbc.runner.runner_user_session_receipt
// RunnerUserSessionConvergeReceipt is the EVIDENCE -- the three readings a converge run actually
// reported for one host (enable-linger ran clean, Linger=yes, the bus answers), PARSED from the
// document that run wrote, and supplied to the grant as a PARAMETER. There is no receipt data in-tree:
// an earlier revision carried hand-typed rows copied from what fleet-converge run 40270496735 printed
// on srv4, and reviews 87051/87054/87126/87136/87155 correctly rejected that (DESIGN 6: name the
// instrument, never transcribe its output -- a copied row keeps granting after the host loses its
// linger, and nothing can re-read it). The producer-side gate evidence the PR body cites is
// fleet-converge run 40270496735 on srv4: enable_linger=ok, linger=yes, bus=present, manager reachable.
//
// THE LABEL IS ON WHILE A FRESH RECEIPT HOLDS. Every production leg observes the receipt at its own effect edge
// (gunbc.runner.runner_user_session_receipt_observed runner_user_session_receipt_observed: the newest
// qualifying fleet-converge run's receipt ARTIFACT, downloaded and parsed with the read_at its own clock
// stamps) and hands it here; no qualifying run is ReceiptAbsent and answers label-off. The grant ages the
// receipt's own probed_at against the read instant and refuses one older than
// gunbc.runner.runner_user_session_receipt runner_user_session_converge_receipt_max_age, so no state in the
// tree can keep advertising the label after the host loses its manager. No consumer's runs-on selects the label
// yet; that change lifts the declared-labels guard (test.claim.runner.runner_user_session_label_witness
// no_emitted_runs_on_names_the_user_session_label) and reads the receipt at an effect edge.
data gunbc_user_session_label: String = "gunbc-user-session"

// THE GRANT IS TYPED STATE, NOT A SILENT LIST (review 87126; DESIGN 3 "each fact lives in exactly one
// place", DESIGN 5 "every path succeeds fully or fails with a typed, located diagnostic"). Granted only
// when the host is rostered AND a receipt was supplied AND it is ABOUT that host AND every reading in it
// holds AND it is still FRESH at the read (its probed_at ages against
// the caller's read instant inside the declared bound). RosteredUnconverged carries WHY there is no label
// -- no receipt supplied, the bytes did not
// parse, a named reading failed (which reading, from the receipt module's own locator), the document was
// stale or undatable at the read (staleness, from the receipt module's own locator), or the receipt
// was written about a different host -- so the difference between "not in the population" and "rostered
// but unconverged" is assertable, never inferred from an empty list. ReceiptedUnrostered names the
// mismatch in the other direction: evidence supplied for a host the roster does not name (a stale or
// stray read) is refused and NAMED, not silently ignored, and the plain outsider is Unadmitted.
//
// THE ROSTER IS A PARAMETER with the fleet list as its only argument at every real call site -- exactly
// the class_labels discipline above -- so a control can pass a forged roster and prove the receipt, not
// the list, is what grants; and the receipt is a parameter for the same reason: a control can forge one
// and prove the grant reads its READINGS. The grant is added at the job entry, not inside
// runner_registration_labels_of_class: the roster is about the job account's user manager, and the deploy
// slot runs the separate deploy principal (whose own labels the role drop-in sets) -- gating inside
// _of_class would hand a capability the deploy principal never earned. Every producer reads the job
// entry (unit fragment, JIT mint, the replace postcondition, the roster readback, and the conformance
// check's desired set), so the grant, the registration and the observed-vs-desired comparison cannot
// disagree about it.
type RunnerUserSessionGrant
  = RunnerUserSessionGranted { receipt: RunnerUserSessionConvergeReceipt }
  | RunnerUserSessionRosteredUnconverged { host: HostIdentity, cause: NonEmptyStr }
  | RunnerUserSessionReceiptedUnrostered { host: HostIdentity }
  | RunnerUserSessionUnadmitted { host: HostIdentity }

fn runner_user_session_grant_of_roster(
  host: HostIdentity,
  roster: List<HostIdentity>,
  receipt: RunnerUserSessionReceiptInput,
) -> RunnerUserSessionGrant {
  let rostered = any(roster, h => (h as String) == (host as String))
  if !rostered {
    match receipt {
      ReceiptSupplied { value: _ } => RunnerUserSessionReceiptedUnrostered { host: host }
      ReceiptUnreadable { why: _ } => RunnerUserSessionReceiptedUnrostered { host: host }
      ReceiptAbsent => RunnerUserSessionUnadmitted { host: host }
    }
  } else {
    match receipt {
      ReceiptSupplied { value: r, read_at: read_at } =>
        if !runner_user_session_converge_receipt_names_host(receipt: r, host: host) {
          RunnerUserSessionRosteredUnconverged {
            host: host,
            cause: "the supplied converge receipt was written about another host, so it is not evidence about this one" as NonEmptyStr,
          }
        } else {
          // FRESHNESS BEFORE TRUST (review 87218): a document that names this host and holds every reading
          // is still not evidence if the read that supplied it is older than the declared bound, or if its
          // probed_at cannot be aged at all. A receipt is evidence about a LIVE manager; the age gate is
          // what stops a document left in the artifact store from a run before a re-image from granting a
          // label on a host whose manager is gone -- the silent-wrong-answer DESIGN 5 hard-rejects.
          match runner_user_session_converge_receipt_staleness(receipt: r, read_at: read_at) {
            Present { value: why } =>
              RunnerUserSessionRosteredUnconverged {
                host: host,
                cause: join(["the converge receipt for this host was supplied but is stale evidence: ", why], "") as NonEmptyStr,
              }
            Absent =>
              match runner_user_session_converge_receipt_failure(receipt: r) {
                Absent => RunnerUserSessionGranted { receipt: r }
                Present { value: why } =>
                  RunnerUserSessionRosteredUnconverged {
                    host: host,
                    cause: join(["the converge receipt for this host did not hold: ", why], "") as NonEmptyStr,
                  }
              }
          }
        }
      ReceiptAbsent =>
        RunnerUserSessionRosteredUnconverged {
          host: host,
          cause: "no converge receipt was supplied for this rostered host (no successful producer run was found, so the label stays off)" as NonEmptyStr,
        }
      ReceiptUnreadable { why: w } =>
        RunnerUserSessionRosteredUnconverged {
          host: host,
          cause: join(["the converge receipt for this rostered host was not readable as a receipt document: ", w], "") as NonEmptyStr,
        }
    }
  }
}

// THE RENDERER. Only a Granted state contributes the label; every other state renders no label -- but
// callers and controls read the GRANT, so the reason is visible and assertable, not inferred from a
// length.
fn runner_user_session_grant_labels(grant: RunnerUserSessionGrant) -> List<String> {
  match grant {
    RunnerUserSessionGranted { receipt: _ } => [gunbc_user_session_label]
    RunnerUserSessionRosteredUnconverged { host: _, cause: _ } => []
    RunnerUserSessionReceiptedUnrostered { host: _ } => []
    RunnerUserSessionUnadmitted { host: _ } => []
  }
}

fn runner_user_session_labels_of_roster(host: HostIdentity, roster: List<HostIdentity>, receipt: RunnerUserSessionReceiptInput) -> List<String> {
  runner_user_session_grant_labels(grant: runner_user_session_grant_of_roster(host: host, roster: roster, receipt: receipt))
}

// THE GRANT IS NOT FORGEABLE THROUGH A CALLER OR AN OFFER ROW. Both halves a host can reach the
// registration through -- its own compute-offer platform labels and the class labels a caller passes --
// are STRIPPED of this label, which is then added only from the row. Without the strip, editing one
// label in a host's offer row, or one class_labels argument, would advertise a user session that host
// never had; that is exactly why the browser-ready label is a written drop-in rather than a
// host-chosen string. test.claim.runner.runner_user_session_label_witness drives both channels.
fn runner_user_session_label_stripped(labels: List<String>) -> List<String> {
  filter(labels, l => l != gunbc_user_session_label)
}

// ── BROWSER READINESS: A LABEL THE BROWSER-TOOLCHAIN CONVERGE GRANTS AND NOTHING ELSE ─────────────
//
// The floor runs real-Chromium wet claims inside its claim_executor run, so a runner on a host whose
// browser toolchain was never converged refuses them (a wet claim on srv1 at the missing toolchain tree). The
// host's readiness is therefore a LABEL: gunbc.runner.runner_browser_toolchain
// browser_ready_labels_converge_wet writes it as a template drop-in when that converge's readback
// holds and removes it when it does not, and once every host in the floor's pool reads ready the
// floor's runs-on names it -- so an unconverged runner cannot take the floor at all.
data gunbc_browser_ready_label: String = "gunbc-browser-ready"

fn runner_browser_ready_registration_labels(host: HostIdentity, receipt: RunnerUserSessionReceiptInput) -> RunnerRegistrationLabelsResolution {
  match runner_evidence_gated_registration_labels(host: host, receipt: receipt) {
    RegistrationLabelsRefused { host: h, cause: c } => RegistrationLabelsRefused { host: h, cause: c }
    RegistrationLabelsResolved { labels: ls } =>
      RegistrationLabelsResolved { labels: runner_label_set_union(a: ls, b: [gunbc_browser_ready_label]) }
  }
}

// ── GPU CONTAINER READINESS: A LABEL THE GPU-CONTAINER-TOOLCHAIN CONVERGE GRANTS AND NOTHING ELSE ──
//
// Same shape as browser-ready, and the reason is the same: a capability a host can gain and lose has
// to be a LABEL, so a workflow selects the capability and an unconverged runner cannot take the job.
// gunbc.runner.runner_gpu_container_toolchain gpu_docker_labels_converge_wet writes it as a template
// drop-in when that converge's readback holds (rootless Docker reachable by the job user, the NVIDIA
// container toolkit installed, a CDI spec generated) and removes it when it does not.
//
// IT STATES THE CONTAINER HALF ONLY, and that is the one way this label is NOT a copy of
// browser-ready. It does not assert the slot's job principal is free of root equivalence: the model
// already classes the docker GROUP as root-equivalent
// (gunbc.fleet.fleet_posix_accounts fleet_root_equivalent_group_names lists "docker"), which is why
// the group route is refused and rootless Docker is the shape. A consumer that reads this label as
// the whole precondition has silently dropped the principal half, so consumers assert on both and
// answer exit 2 (no observation) for either -- never green.
data gunbc_gpu_docker_label: String = "gunbc-gpu-docker"

// ── CAPABILITIES AS ROWS, RESTATED BY ONE FOLD ────────────────────────────────────────────────────
//
// THE SECOND ONE IS WHERE THE PATTERN HAS TO GENERALIZE, and review 86550 said so. The first capability
// label (browser, 85-) was written by one producer alone. The second (gpu, 86-) arrived as a second
// producer, and because systemd applies a template's drop-ins in filename order with the LATER value of a
// repeated key REPLACING the earlier one, the 86 file is the only LABELS_JSON a host holding both
// toolchains ever sees — so it had to know the browser label's name and restate it, or silently revoke it.
// A third capability written the same way would have to know about both of its predecessors plus carry its
// own read for each, the cost grows quadratically, and forgetting one name silently revokes a label with
// nothing on the owning side reporting it. That is the same defect this function's own comment describes,
// one capability later.
//
// SO A CAPABILITY IS A ROW, AND THE FOLD IS SHARED. A capability declares a label and the drop-in whose
// bytes are the evidence that it was earned. Any converge that writes a LABELS_JSON drop-in passes the
// rows it OBSERVED plus the label it is granting itself, and one function composes the set. Adding a
// fourth capability adds a row; it does not add a branch to a sibling, and no sibling has to learn its
// name. Each converge still grants only what its own read-back earned — the fold restates what other
// converges earned, and refuses when a sibling's evidence cannot be read at all.
type HostCapabilityRow {
  label: String
  // The drop-in whose bytes are the EVIDENCE that this capability was granted by its own converge. Not the
  // fragment, not a database: the file the owning converge writes when its read-back holds, and removes
  // when it does not. Reading it is asking the host rather than re-deriving a verdict here, which is what
  // keeps this module from becoming a second authority on someone else's toolchain.
  dropin_path: NonEmptyStr
}

// WHAT A READ OF ONE ROW CAN ANSWER, with the third answer not collapsible into the second. ABSENT is a
// decision — the file carries no such label, so it is withheld. UNOBSERVABLE is not a decision, it is the
// read that failed, and treating it as ABSENT would strip a label a host legitimately holds because one ssh
// blipped, with nothing on the owning side reporting it.
//
// THE PREDICATE OVER THESE LIVES BESIDE THE FOLD, in gunbc.runner.runner_capability_labels: deciding
// whether a witness contributes a label is part of composing the set, and splitting the two would let the
// predicate and the fold disagree about what HELD means.
type HostCapabilityWitness
  = CapabilityHeld { label: String }
  | CapabilityAbsent { label: String }
  | CapabilityUnobservable { label: String, cause: String }

// THE FOLD LIVES IN gunbc.runner.runner_capability_labels, beside the rows it validates witnesses
// against, because validating a witness requires seeing the declared rows and this module must not have to
// know them. The types above stay here: they are the vocabulary, and the vocabulary has no opinions about
// which capabilities exist.



// WHETHER AN OBSERVED REGISTRATION CONFORMS TO ITS SLOT. The host's set exactly, or the host's set
// plus the readiness label: those are the only two states the converge writes, so both are healthy,
// and anything else -- another host's label, a stray extra -- is a divergence. Treating the ungranted
// state as diverged would make the recovery path churn every slot on a host whose toolchain is not
// converged yet; withholding the label is already the refusal, because the floor selects on it.
type RegistrationLabelsConformance
  = RegistrationLabelsConform
  | RegistrationLabelsDiverge
  | RegistrationLabelsUnjudged { host: HostIdentity, cause: NonEmptyStr }

// THE READINESS LABEL IS THE FLOOR'S, so only a slot the floor can run on may carry it; the deploy
// slot's label set is exactly its own, and a readiness label on it is a divergence.
fn runner_slot_carries_browser_ready(slot: RunnerSlotIdentity) -> Bool {
  match runner_slot_job_role(slot: slot) {
    CiJobSlot => true
    DeployJobSlot => false
  }
}

// THE ONE OPTIONAL LABEL A SLOT'S REGISTRATION MAY CARRY BEYOND ITS EXPECTED SET: browser-ready (a converge wrote its
// drop-in), licensed by an observation the readback does not re-judge. The user-session label is NOT optional: it is
// part of the expected set exactly when the receipt the readback was handed grants it.
fn runner_slot_optional_registration_labels(slot: RunnerSlotIdentity) -> List<String> {
  if runner_slot_carries_browser_ready(slot: slot) { [gunbc_browser_ready_label] } else { [] }
}

// THE EXPECTED SET OF ONE SLOT: a CI slot's evidence-gated labels (the user-session label iff `receipt` grants it for
// the slot's host; an UNREADABLE receipt leaves the grant undecided, so the readback is Unjudged rather than a
// divergence that would replace every slot on a transient read failure), the deploy slot's own declared set. The receipt is the one the leg read at its effect edge, the
// same value registration resolved its labels from, so desired and readback never disagree about the grant.
fn runner_expected_slot_registration_labels(slot: RunnerSlotIdentity, receipt: RunnerUserSessionReceiptInput) -> RunnerRegistrationLabelsResolution {
  match runner_slot_job_role(slot: slot) {
    CiJobSlot =>
      match receipt {
        ReceiptUnreadable { why: _ } =>
          RegistrationLabelsRefused {
            host: slot.host,
            cause: "the converge receipt read failed, so whether this host's registration should carry the user-session label is undecided and the readback judges nothing" as NonEmptyStr,
          }
        ReceiptSupplied { value: _, read_at: _ } => runner_evidence_gated_registration_labels(host: slot.host, receipt: receipt)
        ReceiptAbsent => runner_evidence_gated_registration_labels(host: slot.host, receipt: receipt)
      }
    DeployJobSlot => runner_deploy_slot_registration_labels(slot: slot)
  }
}

// THE DECLARED SET OF ONE SLOT: the host's declared labels with the class its role gives it, and no label an
// observation grants.
fn runner_declared_slot_registration_labels(slot: RunnerSlotIdentity) -> RunnerRegistrationLabelsResolution {
  match runner_slot_job_role(slot: slot) {
    CiJobSlot => runner_declared_registration_labels(host: slot.host)
    DeployJobSlot => runner_deploy_slot_registration_labels(slot: slot)
  }
}

fn runner_slot_labels_conform(slot: RunnerSlotIdentity, observed: List<String>, receipt: RunnerUserSessionReceiptInput) -> RegistrationLabelsConformance {
  match runner_expected_slot_registration_labels(slot: slot, receipt: receipt) {
    RegistrationLabelsRefused { host: h, cause: c } => RegistrationLabelsUnjudged { host: h, cause: c }
    RegistrationLabelsResolved { labels: expected } =>
      if runner_label_sets_equal(a: filter(observed, l => !fold(runner_slot_optional_registration_labels(slot: slot), init: false, f: (found, o) => found || o == l)), b: expected) {
        RegistrationLabelsConform
      } else {
        RegistrationLabelsDiverge
      }
  }
}

fn registration_labels_refused_not_self_hosted(host: HostIdentity) -> RunnerRegistrationLabelsResolution {
  RegistrationLabelsRefused {
    host: host,
    cause: "the host's compute offer did not project to a self-hosted runner spec, so it has no self-hosted registration label set" as NonEmptyStr,
  }
}
