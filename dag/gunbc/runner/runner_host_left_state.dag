module gunbc.runner.runner_host_left_state

import std.types { String, List, Bool, NonEmptyStr }

// WHAT THE HOST IS LEFT IN, stated on every result. Three facts, kept apart:
//   HostAdmitting          every unit unmasked, active and read back
//   HostAdmittingWithHeld  every ADMITTED unit as above; `held` are desired units deliberately not started
//                          because the host is at its admitted concurrency (gunbc.plans.host_thermal_operating_point).
//                          A permanent intended hold: neither converged nor stuck, so never a drain.
//   HostLeftDrained        a refused, pending or unread unit (fail-closed), or no unit admitting at all
type HostLeftState
  = HostAdmitting
  | HostAdmittingWithHeld { held: List<NonEmptyStr> }
  | HostLeftDrained { units: List<NonEmptyStr> }

// ONE UNIT'S RE-ADMISSION READING, reduced to what the host-left decision needs. Kept here, away from
// SlotActuationOutcome, so the decision resolves in a small closure; the projection from the outcome lives
// beside it in runner_host_cap_bracket (readmit_fact_of).
type ReadmitFact
  = ReadmitSettled { unit: NonEmptyStr }
  | ReadmitHeldByCooling { unit: NonEmptyStr }
  | ReadmitStuck { unit: NonEmptyStr }

fn host_left_wire(l: HostLeftState) -> String {
  match l {
    HostAdmitting => "host left admitting (every slot unmasked, active and read back)"
    HostAdmittingWithHeld { held: hs } => join(["host left admitting every admitted slot (unmasked, active and read back); cooling-held by design, NOT converged: ", join(map(hs, u => u as String), " ")], "")
    HostLeftDrained { units: us } => join(["host left DRAINED: still masked or not read back: ", join(map(us, u => u as String), " ")], "")
  }
}

fn readmit_fact_unit(f: ReadmitFact) -> NonEmptyStr {
  match f {
    ReadmitSettled { unit: u } => u
    ReadmitHeldByCooling { unit: u } => u
    ReadmitStuck { unit: u } => u
  }
}

fn readmit_fact_is_stuck(f: ReadmitFact) -> Bool { match f { ReadmitStuck { unit: _ } => true ReadmitSettled { unit: _ } => false ReadmitHeldByCooling { unit: _ } => false } }

fn readmit_fact_is_held(f: ReadmitFact) -> Bool { match f { ReadmitHeldByCooling { unit: _ } => true ReadmitSettled { unit: _ } => false ReadmitStuck { unit: _ } => false } }

// Every unit needs exactly one reading. A stuck or missing one leaves the host DRAINED naming only the stuck
// units (held ones are not named). Held units with every other unit settled leave it admitting-with-held.
// ALL units held means nothing is admitting, so DRAINED naming the held units: a host serving zero slots is
// not admitting, and a zero-width admission is the thermal gate's to refuse, not a bracket success.
fn host_left_of_facts(units: List<NonEmptyStr>, facts: List<ReadmitFact>) -> HostLeftState {
  let stuck = map(filter(facts, f => readmit_fact_is_stuck(f: f)), f => readmit_fact_unit(f: f))
  let held = map(filter(facts, f => readmit_fact_is_held(f: f)), f => readmit_fact_unit(f: f))
  if length(stuck) > 0 { HostLeftDrained { units: stuck } }
  else if length(facts) != length(units) { HostLeftDrained { units: units } }
  else if length(held) == 0 { HostAdmitting }
  else if length(held) == length(facts) { HostLeftDrained { units: held } }
  else { HostAdmittingWithHeld { held: held } }
}
