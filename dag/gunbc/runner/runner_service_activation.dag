module gunbc.runner.runner_service_activation

import std.types { String, NonEmptyStr, Bool, Int, List, list_length }
import std.content_hash { content_hash_of_value, serialize_content_hash }
import extdeps.posix.shell_command_language { posix_single_quote }
import std.disposition { ConstructionMechanism, SingleAuthority }
import gunbc.executor_privileged_operation {
  ExecutorPrivilegedOperation,
  SystemdEnableUnit,
  SystemdStartUnit,
  executor_privileged_operation_shell_command,
}
import gunbc.runner.runner_host_deploy {
  RunnerHostDeploy, RunnerHostAdmission, RunnerHostEnrolled, RunnerHostUnenrolled,
  fleet_runner_host_deploys,
}
import gunbc.runner.runner_activation {
  BuildCacheInstanceReady, HostCompilePoolReady,
  RunnerActivationAdmission, RunnerActivationAdmitted, RunnerActivationRefused,
  admit_runner_activation,
}
import gunbc.runner.runner_slot_provision { desired_runner_slot_members }
import gunbc.guarantee_stall { stall_report_message }
import gunbc.guarantee_stall.runner_activation_reachability_stall { runner_activation_reachability_stall }
import gunbc.guarantee_stall.runner_activation_safety_stall { runner_activation_safety_stall }
import gunbc.runner.runner_unit { runner_unit_name_of_registration }

data runner_service_activation_scope_disposition: ConstructionMechanism = SingleAuthority

// ENABLE AND START ARE TWO TRANSITIONS AND THIS MODULE IS THE PLACE THEY STAY TWO. The emitted
// apply.sh carried daemon-reload and disable and nothing else: enable count zero, start count zero,
// so convergence materialized runner trees and the host's serving capacity did not move. Every
// capacity increase of 2026-08-25 -- srv1, srv3 and srv4 each 5 to 21 -- was finished by a hand-run
// `systemctl enable --now` loop after apply reported success, which is manual application committed
// to nothing.
//
// THE HAND LOOP IS NOT THE SPECIFICATION FOR THE REPAIR, and re-emitting what it did would re-fuse
// the two facts it fused. `enable` is DURABLE BOOT INTENT: it authorizes a future boot to start the
// broker under readiness conditions that nobody will re-observe at that boot, which makes it the
// STRONGER of the two grants rather than the milder-sounding one. `start` is IMMEDIATE ACTIVITY
// under conditions observable right now. They are separately admitted here, separately granted in
// gunbc.executor_privileged_operation, and separately rendered, so `enable --now` has no spelling
// on this path -- not by convention, but because no sudoers line derived from either operation
// matches the fused argv.
//
// BOTH CONSUME THE SAME ACTIVATION ADMISSION, which is gunbc.runner.runner_activation's wall and not a
// second one. That wall exists because letting a slot accept work is what lets its first cache-miss
// compile spawn a build-cache server inside the runner's own cgroup, and materializing a slot
// cannot.
type RunnerServiceTransition
  = RunnerEnableTransition
  | RunnerStartTransition

// THE OBSERVATION ARRIVES AS A PARAMETER AND HAS ITS OWN UNAVAILABLE ARM, rather than being
// manufactured here. A planner that built its own BuildCacheInstanceReady would be fabricating the
// observation the receipt exists to carry -- the forgeable-receipt residual
// gunbc.runner.runner_activation's own note names, committed deliberately instead of inherited. So this
// module never constructs a receipt; it consumes one or it consumes the reason none was available.
//
// WHY THE UNAVAILABLE ARM IS NOT FOLDED INTO A REFUSED ADMISSION AT THE CALLER: `no observation
// transaction exists to ask` and `the observation answered and disagreed` have different owners and
// different repairs, and the second is a host fact while the first is a gap in this repository.
// Collapsing them would make a missing seam read as a converged host failing a check. The arm
// carries its reason, the admission it produces carries that reason forward, and the emitted script
// prints it -- so a reader of apply.sh learns which of the two they are looking at.
//
// IT ALSO MAKES THE RED AUTHORABLE, which is the property that decides whether the witness below is
// evidence or decoration (DESIGN section 4b). If this module answered `unobserved` from a constant,
// no fixture could ever reach the admitted arm, the emitted-activation assertion would be
// permanently red, and its green counterpart would be unwritable. With the observation as an input,
// a fixture authors both poles.
type RunnerActivationReadiness
  = ActivationReadinessObserved {
      cache_ready: BuildCacheInstanceReady
      pool_ready: HostCompilePoolReady
    }
  | ActivationReadinessUnobserved { reason: NonEmptyStr }

// WHAT THE HOST SAYS ABOUT EACH DESIRED UNIT, READ BEFORE ANY TRANSITION IS PLANNED.
//
// The planner used to enumerate every desired unit and ask readiness to admit enable and start for
// all of them, so a host whose five units were already enabled and running planned two refusals
// about work that did not exist -- and the terminal counted them. That is the empty-observation
// narrow in its planning form: not reading the unit's state was rendered as "every unit needs
// both transitions". Standing is the observed pair per unit; a unit that is already enabled needs
// no enable, one already active needs no start, and readiness is consulted ONLY for the units that
// still need a transition. Unobserved standings degrade to the old shape -- every unit needs
// everything -- which is the fail-closed direction, since it plans a refusal rather than silence.
type RunnerUnitStanding {
  unit: NonEmptyStr
  active: Bool
  enabled: Bool
}

type RunnerUnitStandings
  = UnitStandingsObserved { units: List<RunnerUnitStanding> }
  | UnitStandingsUnobserved { reason: NonEmptyStr }

data runner_unit_standings_unobserved_no_transaction: RunnerUnitStandings = UnitStandingsUnobserved {
  reason: "no unit-state observation was taken for this host, so every desired unit is planned as needing both transitions" as NonEmptyStr,
}

fn runner_unit_standing_wire(standing: RunnerUnitStanding) -> String {
  join([
    "unit:", standing.unit as String, "=",
    if standing.active { "active" } else { "inactive" }, ",",
    if standing.enabled { "enabled" } else { "disabled" },
  ], "")
}

fn runner_unit_standings_baseline_rows(standings: RunnerUnitStandings) -> List<String> {
  match standings {
    UnitStandingsObserved { units: us } => map(us, u => runner_unit_standing_wire(standing: u))
    UnitStandingsUnobserved { reason: _ } => ["units:unobserved"]
  }
}

fn runner_unit_standing_needs(transition: RunnerServiceTransition, standing: RunnerUnitStanding) -> Bool {
  match transition {
    RunnerEnableTransition => !standing.enabled
    RunnerStartTransition => !standing.active
  }
}

// THE UNITS A TRANSITION STILL HAS TO TOUCH. A desired unit with no observed standing row is
// treated as needing the transition: an observation that named only some of the desired units has
// not answered for the rest, and answering "converged" for a unit nobody looked at would be the
// narrow this module exists to remove.
fn runner_units_needing_transition(
  transition: RunnerServiceTransition,
  units: List<NonEmptyStr>,
  standings: RunnerUnitStandings,
) -> List<NonEmptyStr> {
  match standings {
    UnitStandingsUnobserved { reason: _ } => units
    UnitStandingsObserved { units: observed } =>
      filter(units, u =>
        match first(filter(observed, o => (o.unit as String) == (u as String))) {
          Present { value: standing } => runner_unit_standing_needs(transition: transition, standing: standing)
          Absent => true
        }
      )
  }
}

type RunnerTransitionPlan
  = TransitionAdmitted {
      transition: RunnerServiceTransition
      operations: List<ExecutorPrivilegedOperation>
    }
  | TransitionRefused {
      transition: RunnerServiceTransition
      host_label: NonEmptyStr
      reason: NonEmptyStr
      affected_units: List<NonEmptyStr>
    }
  | TransitionConverged {
      transition: RunnerServiceTransition
      units: List<NonEmptyStr>
    }

fn runner_transition_verb_label(transition: RunnerServiceTransition) -> String {
  match transition {
    RunnerEnableTransition => "enable"
    RunnerStartTransition => "start"
  }
}

// THE TRANSITION'S OWN STAKE, SPELLED PER MEMBER, because a shared refusal sentence would make the
// two transitions look like one operation reported twice. What a reader needs from a refusal is what
// they are being denied, and the two denials are not the same denial.
fn runner_transition_stake(transition: RunnerServiceTransition) -> String {
  match transition {
    RunnerEnableTransition =>
      "enable is durable boot intent: it authorizes every FUTURE boot to start this unit under readiness conditions nobody re-observes at that boot, so it is the stronger of the two grants and is withheld first"
    RunnerStartTransition =>
      "start is immediate activity: it lets this unit accept work now, and the first cache-miss compile of that work is what spawns a build-cache server in whichever cgroup the slot sits in"
  }
}

fn runner_transition_operation(
  transition: RunnerServiceTransition,
  unit: NonEmptyStr,
) -> ExecutorPrivilegedOperation {
  match transition {
    RunnerEnableTransition => SystemdEnableUnit { unit: unit }
    RunnerStartTransition => SystemdStartUnit { unit: unit }
  }
}

// THE UNITS ARE THE DESIRED SLOT MEMBERS, NOT THE COMMITTED WIDTH. desired_runner_slot_members
// already removes the fabric execution slot from the roster, and reaching for the raw index
// sequence here would activate a GitHub Actions unit on top of a slot this fleet carved out for
// compute fabric -- gunbc.runner.runner_slot_provision records that exact defect as one it already fixed
// once, and re-deriving the roster locally would reintroduce it in a second place.
fn runner_host_activation_units(deploy: RunnerHostDeploy) -> List<NonEmptyStr> {
  map(
    desired_runner_slot_members(deploy: deploy),
    m => runner_unit_name_of_registration(registration_name: m.instance_name),
  )
}

fn runner_activation_admission_from_readiness(
  host_admission: RunnerHostAdmission,
  readiness: RunnerActivationReadiness,
) -> RunnerActivationAdmission {
  match readiness {
    ActivationReadinessObserved { cache_ready: c, pool_ready: p } =>
      admit_runner_activation(host_admission: host_admission, cache_ready: c, pool_ready: p)
    ActivationReadinessUnobserved { reason: why } =>
      match host_admission {
        RunnerHostEnrolled { deploy: d } =>
          RunnerActivationRefused {
            host_label: d.host_label,
            reason: concat(
              "runner_service_activation: no activation-readiness observation was available for this host, so neither transition can be admitted. This is an unread question, not a failed check -- ",
              why as String,
            ) as NonEmptyStr,
          }
        RunnerHostUnenrolled { host_label: l, reason: r } =>
          RunnerActivationRefused { host_label: l, reason: r }
      }
  }
}

// EACH TRANSITION IS ADMITTED ON ITS OWN CALL. The admission value is shared -- there is one wall,
// and inventing a second for start would be a nickname for it -- but the ADMISSION EVENT is per
// transition, so a future policy that grants durable boot intent while withholding immediate
// activity (or the reverse, which is what a drain does) has a place to sit that is not a rewrite.
// A single function returning both plans at once would have foreclosed that by construction.
fn admit_runner_transition(
  transition: RunnerServiceTransition,
  admission: RunnerActivationAdmission,
  units: List<NonEmptyStr>,
) -> RunnerTransitionPlan {
  match admission {
    RunnerActivationAdmitted { deploy: _, cache_ready: _, pool_ready: _ } =>
      TransitionAdmitted {
        transition: transition,
        operations: map(units, u => runner_transition_operation(transition: transition, unit: u)),
      }
    RunnerActivationRefused { host_label: l, reason: r } =>
      TransitionRefused {
        transition: transition,
        host_label: l,
        affected_units: units,
        reason: concat(
          concat(
            concat("systemctl ", runner_transition_verb_label(transition: transition)),
            " is not admitted on this host: ",
          ),
          concat(concat(r as String, " -- "), runner_transition_stake(transition: transition)),
        ) as NonEmptyStr,
      }
  }
}

// ENABLE PRECEDES START, AND THE ORDER IS THE ONE THE TRANSITIONS THEMSELVES IMPLY rather than a
// preference: a unit started before it is enabled serves until the next boot and then silently
// stops being capacity, which is the state this whole lane was dispatched to remove. The list is
// the emission order.
fn runner_host_transition_plan(
  transition: RunnerServiceTransition,
  admission: RunnerActivationAdmission,
  units: List<NonEmptyStr>,
  standings: RunnerUnitStandings,
) -> RunnerTransitionPlan {
  let needing = runner_units_needing_transition(transition: transition, units: units, standings: standings)
  if list_length(items: needing) == 0 {
    TransitionConverged { transition: transition, units: units }
  } else {
    admit_runner_transition(transition: transition, admission: admission, units: needing)
  }
}

fn runner_host_transition_plans(
  host_admission: RunnerHostAdmission,
  readiness: RunnerActivationReadiness,
  units: List<NonEmptyStr>,
  standings: RunnerUnitStandings,
) -> List<RunnerTransitionPlan> {
  let admission = runner_activation_admission_from_readiness(
    host_admission: host_admission,
    readiness: readiness,
  )
  [
    runner_host_transition_plan(transition: RunnerEnableTransition, admission: admission, units: units, standings: standings),
    runner_host_transition_plan(transition: RunnerStartTransition, admission: admission, units: units, standings: standings),
  ]
}

fn runner_activation_plans_for_deploy(
  host_admission: RunnerHostAdmission,
  deploy: RunnerHostDeploy,
  readiness: RunnerActivationReadiness,
  standings: RunnerUnitStandings,
) -> List<RunnerTransitionPlan> {
  runner_host_transition_plans(
    host_admission: host_admission,
    readiness: readiness,
    units: runner_host_activation_units(deploy: deploy),
    standings: standings,
  )
}

// A REFUSED TRANSITION EMITS A REFUSAL LINE AND THE SIBLINGS CONTINUE. It does NOT exit, and that
// is the deliberate half of the shape rather than the lenient half. Materialization is authorized
// independently of activation -- writing a slot's files cannot spawn a cache server -- so aborting
// apply on an activation refusal would withdraw an authorized effect because an unrelated one was
// denied. What must never happen is the third arm: emitting nothing, which is what the script did
// before this module existed and is indistinguishable from a host with no activation work. The
// refusal is typed, located on the host, carries its cause and its affected population, and is
// counted by the row below.
//
// THE DIAGNOSTIC IS POSIX-QUOTED, AND THE FIRST VERSION HAND-WRAPPED IT IN SINGLE QUOTES. That was a
// latent shell defect of the worst kind: dormant, and dormant precisely BECAUSE the arm that would
// trigger it is unreachable. Real RunnerActivationRefused reasons contain single-quoted values --
// admit_runner_activation's host-mismatch arm says "names host 'srv3' but activation was requested
// for 'srv4'" -- and an apostrophe landing inside a hand-written '...' literal closes the quoting and
// emits malformed shell. The one reason production can currently reach happens to contain no
// apostrophe, so no test and no run could have shown it, and the first observed readiness would have
// armed it. Quoting is a property of the shell that carries the words (the same reasoning
// gunbc.executor_privileged_operation states for its argv rendering), so it comes from the POSIX
// authority that owns the encoding and never from an author counting quotes.
fn runner_transition_refusal_echo(message: String) -> String {
  concat("echo ", concat(posix_single_quote(spelling: message), " >&2"))
}

// THE REFUSAL NAMES HOW MANY UNITS IT WITHHELD AND WHICH SET THEY WERE, because "activation was
// refused" without a population is a verdict whose magnitude a reader has to guess -- and the two
// hosts in this fleet differ by exactly one unit, so guessing is wrong in a way nobody would notice.
// The count is the magnitude; the digest is the IDENTITY, so two refusals over different rosters are
// distinguishable even at equal counts, which a count alone cannot do.
fn runner_transition_affected_set_identity(units: List<NonEmptyStr>) -> String {
  serialize_content_hash(
    hash: content_hash_of_value(
      value: join(map(units, u => u as String), ",") as NonEmptyStr,
    ),
  ) as String
}

fn runner_transition_affected_population_render(units: List<NonEmptyStr>) -> String {
  concat(
    concat(" units=", to_string(list_length(items: units))),
    concat(" unit_set=", runner_transition_affected_set_identity(units: units)),
  )
}

fn runner_transition_apply_lines(plan: RunnerTransitionPlan) -> List<String> {
  match plan {
    TransitionAdmitted { transition: _, operations: ops } =>
      map(ops, op => executor_privileged_operation_shell_command(op: op))
    TransitionRefused { transition: _, host_label: l, reason: r, affected_units: us } =>
      [
        runner_transition_refusal_echo(
          message: concat(
            concat("fleet_converge_apply: REFUSED-ACTIVATION host=", l as String),
            concat(
              runner_transition_affected_population_render(units: us),
              concat(" ", r as String),
            ),
          ),
        ),
      ]
    TransitionConverged { transition: t, units: us } =>
      [
        concat(
          concat("# runner-service ", runner_transition_verb_label(transition: t)),
          concat(": converged", runner_transition_affected_population_render(units: us)),
        ),
      ]
  }
}

fn runner_transition_plan_line(plan: RunnerTransitionPlan) -> String {
  match plan {
    TransitionAdmitted { transition: t, operations: ops } =>
      concat(
        concat("ACTIVATE runner-service ", runner_transition_verb_label(transition: t)),
        concat(" units=", to_string(list_length(items: ops))),
      )
    TransitionRefused { transition: t, host_label: l, reason: r, affected_units: us } =>
      concat(
        concat("REFUSED-ACTIVATION runner-service ", runner_transition_verb_label(transition: t)),
        concat(
          concat(" host=", l as String),
          concat(
            runner_transition_affected_population_render(units: us),
            concat(" ", r as String),
          ),
        ),
      )
    TransitionConverged { transition: t, units: us } =>
      concat(
        concat("CONVERGED runner-service ", runner_transition_verb_label(transition: t)),
        runner_transition_affected_population_render(units: us),
      )
  }
}

// THE ONE SPELLING OF "NOBODY CAN ASK THIS YET". Every production caller in the tree supplies this
// row rather than authoring its own sentence, because the reason is a fact about the REPOSITORY --
// there is no host observation transaction -- and not about the caller that noticed. Two callers
// with two wordings would drift the moment the transaction lands for one of them, and the drift
// would be invisible: both would still say "unobserved".
//
// IT IS DATA AND NOT A FUNCTION, so the day the transaction exists this row's deletion is what
// breaks every caller that was leaning on it, one by one, loudly (DESIGN section 3, delete-first).
data runner_activation_readiness_unobserved_no_transaction: RunnerActivationReadiness = ActivationReadinessUnobserved {
  reason: "no host observation transaction exists yet: fleet convergence observes directory membership, the generation store and the hostname, and nothing reads the build-cache endpoint owner or the compile-pool slice, so neither receipt gunbc.runner.runner_activation requires can be produced (docs/plans/runner-service-capacity-convergence.md, the shared blocker)" as NonEmptyStr,
}

// THE EMISSION ORDER, READABLE AS A VALUE. A consumer that wanted to assert enable-before-start had
// to destructure the plan list positionally, which reads the ORDER out of the shape of the list
// rather than out of the transitions themselves. This renders the sequence the transitions name.
fn runner_transition_plan_transition(plan: RunnerTransitionPlan) -> RunnerServiceTransition {
  match plan {
    TransitionAdmitted { transition: t, operations: _ } => t
    TransitionRefused { transition: t, host_label: _, reason: _, affected_units: _ } => t
    TransitionConverged { transition: t, units: _ } => t
  }
}

fn runner_transition_sequence_label(plans: List<RunnerTransitionPlan>) -> String {
  fold(
    plans,
    init: "",
    f: (acc, p) => {
      let v = runner_transition_verb_label(transition: runner_transition_plan_transition(plan: p))
      if acc == "" { v } else { concat(acc, concat(",", v)) }
    },
  )
}

fn runner_transition_is_refused(plan: RunnerTransitionPlan) -> Bool {
  match plan {
    TransitionAdmitted { transition: _, operations: _ } => false
    TransitionRefused { transition: _, host_label: _, reason: _, affected_units: _ } => true
    TransitionConverged { transition: _, units: _ } => false
  }
}

fn runner_activation_refusal_count(plans: List<RunnerTransitionPlan>) -> Int {
  fold(plans, init: 0, f: (acc, p) => if runner_transition_is_refused(plan: p) { acc + 1 } else { acc })
}

fn runner_activation_admitted_operation_count(plans: List<RunnerTransitionPlan>) -> Int {
  fold(
    plans,
    init: 0,
    f: (acc, p) =>
      match p {
        TransitionAdmitted { transition: _, operations: ops } => acc + list_length(items: ops)
        TransitionRefused { transition: _, host_label: _, reason: _, affected_units: _ } => acc
        TransitionConverged { transition: _, units: _ } => acc
      },
  )
}

fn runner_activation_reachability_report() -> String {
  stall_report_message(s: runner_activation_reachability_stall)
}

fn runner_activation_safety_report() -> String {
  stall_report_message(s: runner_activation_safety_stall)
}
