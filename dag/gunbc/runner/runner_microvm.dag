data runner_microvm_disposition: Disposition = SingleAuthority

// THE GUEST IMAGE IS AN IDENTITY, NOT A PATH.
//
// A path names where an image happens to sit on one host; two hosts holding different bytes at the
// same path is exactly the drift this fleet keeps losing track of. The distribution, its release
// and the runner baked into it are what make two images the same image, so they are the fields.
//
// THE RUNNER IS CARRIED AS THE CITED RELEASE ROW, NOT AS A VERSION STRING. extdeps.github.
// actions_runner already owns which Actions runner this fleet installs, with the upstream digests
// and a measured note about why the previous pin was retired server-side. A version literal here
// would be a SECOND authority for one fact, and the two would drift the moment either moved -- the
// exact nicknaming failure the guest-image-as-identity paragraph above is about, committed one
// field lower. Whatever the host path installs, the VM path installs, because it is one row.
type RunnerGuestImage {
  distribution: NonEmptyStr
  release_series: NonEmptyStr
  arch: NonEmptyStr
  runner: ActionsRunnerRelease
}

// THE GUEST IMAGE PINS 2.337.0 AND THE FLEET'S HOST SLOTS PIN 2.336.0, AND THAT DIVERGENCE IS NOW
// DECLARED RATHER THAN ACCIDENTAL. It arrived accidentally: the Mt. Collins guest image was built
// against the then-latest runner while this row still said 2.336.0, and the canary reported
// "Current runner version: 2.337.0" to GitHub -- one concept answering two ways, found in review and
// not by anything in this repository.
//
// IT IS RESOLVED FORWARD RATHER THAN BACKWARD because 2.337.0 is what actually ran and was verified:
// the shipped tarball's digest equals the one extdeps.github.actions_runner records from upstream's
// release body. Pinning back to 2.336.0 would make the model agree with itself by describing an
// artifact no run has exercised.
//
// THE FLEET'S HOST-SLOT PIN IS DELIBERATELY NOT MOVED HERE. gunbc.runner_slot_provision,
// gunbc.runner_lifecycle and gunbc.fleet_converge_plan all install 2.336.0, and changing that
// re-provisions every slot on every host -- a fleet migration with its own blast radius, which must
// not ride along inside a canary receipt. Converging the two pins is its own change.
//
// SO THE STANDING OBLIGATION IS EXPLICIT: two live pins is the state this row leaves behind, and it
// is a divergence to close rather than a design. What makes it survivable meanwhile is that each
// names its own release row and neither is a version string typed twice.
data gunbc_runner_guest_image: RunnerGuestImage = RunnerGuestImage {
  distribution: "ubuntu",
  release_series: "24.04",
  arch: "aarch64",
  runner: actions_runner_release_2_337_0,
}

// THE CREDENTIAL REACHES THE GUEST AS A READ-ONLY BLOCK DEVICE, AND THAT IS THE WHOLE POINT.
//
// Today a slot's credential is a FILE IN A DIRECTORY THE NEXT INCARNATION ALSO OWNS, which is how
// an orphaned listener deletes a live job's credentials: same path, different process, no wall.
// A per-registration drive has no such sharing to express -- the device is attached to one VM, is
// read-only to the guest, and ceases to exist when that VM does. AttemptScopedSecrets is therefore
// a property of the CARRIER rather than a promise the handler makes.
type JitCredentialTransport
  = JitConfigOnReadOnlyDrive { drive_id: NonEmptyStr }
  | JitConfigInSharedSlotDirectory { path: FilePath }

data gunbc_runner_jit_transport: JitCredentialTransport = JitConfigOnReadOnlyDrive {
  drive_id: "jitcfg",
}

// WHAT ONE RUNNER VM IS SIZED AT, IN GROUNDED MAGNITUDES RATHER THAN BARE INTEGERS.
//
// An earlier revision carried these as `Int`, mirroring Firecracker's own field names inward. That
// is the right shape AT the cited boundary -- extdeps models what the API actually accepts -- and
// the wrong shape one layer in: a bare Int is a second representation of a magnitude std.measure
// already owns, and the fabric envelope this VM will eventually answer to already speaks
// HardwareThreadCount and the Memory measure family. Two spellings of one quantity is the §3
// failure, and it is exactly what lets a vcpu count be compared against a memory size without
// anything refusing.
//
// THE SCALE IS Mebi RATHER THAN One, DELIBERATELY. Firecracker's field is denominated in MiB, so
// `Measure<Memory, Mebi, Nat>` grounds it EXACTLY -- same authority as ByteSize, one scale along
// the axis that authority exists to carry, with no lossy multiply on the way in. Converting to
// bytes here would restate the unit rather than ground it, and the boundary conversion back to the
// API's integer is then a single named call instead of an arithmetic assumption.
type RunnerMicroVmSize {
  vcpu_count: HardwareThreadCount
  memory: Mebibyte
}

// THREE QUANTITIES, NOT ONE -- THIS IS THE REPAIR, AND THE OLD CODE HAD ONLY THE FIRST.
//
// The withdrawn derivation set the guest's RAM to the cell's whole MemoryMax. That treated ONE
// number as answering three different questions, and the safety property is a relation between
// all three:
//
//   CELL MEMORY ENVELOPE     what the bounded cell is granted -- gunbc_runner_slot_desired.memory_max
//   GUEST MEMORY REQUEST     what the guest would be handed -- Firecracker's machine_config.mem_size_mib
//   REALIZATION RESERVE      what the VMM PROCESS ITSELF costs, INSIDE that same cell
//
// The reserve was zero and unnamed, so guest == envelope read as correct and the slice would have
// OOM-killed the VM it exists to bound. Equality is not the property; CONTAINMENT is:
//
//   guest + reserve <= envelope
//
// A guest SMALLER than the envelope FITS. The withdrawn control asserted the opposite -- it refused
// the 4 GiB MVP configuration against a 16 GiB cell -- so both arms of that pair were wrong in
// opposite directions while the pair looked discriminating.
type CellMemoryEnvelope { bytes: ByteSize }
type GuestMemoryRequest { bytes: ByteSize }

// THE FIRECRACKER MACHINE CONFIG IS A SIGNED EXTERNAL BOUNDARY, AND IT IS VALIDATED HERE OR
// NOWHERE.
//
// FirecrackerMachineConfig carries `vcpu_count: Int` and `mem_size_mib: Int` -- upstream's own
// shape, faithfully modeled, and SIGNED. The spelling `Nat` downstream does not rescue it: the
// generated realization is i64 and byte_size constructs the measure from whatever count it is
// handed. So a config with mem_size_mib = -1 previously flowed straight through
// mebibyte -> mebibyte_to_byte_size -> GuestMemoryRequest and satisfied -1 MiB + 256 MiB <= 16 GiB,
// reaching GuestFitsWithinCell and then RunnerMicroVmAdmitted. A fail-open arm INSIDE the very
// relation this module exists to establish.
//
// It is not enough to be caught later: nothing downstream re-reads the sign, and the admission is
// the last gate before a VM is provisioned. So the signed values become VALIDATED MAGNITUDES or a
// typed refusal, BEFORE fit and before admission, and the fit function is never handed an
// unvalidated number.
//
// THE UPPER BOUND IS THE REPRESENTABLE ONE, not a policy guess. mebibyte_to_byte_size multiplies by
// 2^20, so any mem_size_mib above (2^63 - 1) / 2^20 makes the byte magnitude unrepresentable in the
// i64 the realization uses. Refusing there is refusing the arithmetic we cannot perform, which is
// the honest boundary; picking a smaller "reasonable" ceiling would be an unstated policy wearing
// a representability argument's clothes.
data guest_memory_mib_representable_max: Int = 8796093022207

type GuestResources
  = GuestResourcesValidated { memory: GuestMemoryRequest, vcpus: HardwareThreadCount }
  | GuestResourcesInvalid { cause: String }

fn guest_resources_of_machine_config(mc: FirecrackerMachineConfig) -> GuestResources {
  if mc.mem_size_mib <= 0 {
    GuestResourcesInvalid {
      cause: "the guest machine configuration declares a memory size that is zero or negative, which is not a magnitude; a guest cannot be provisioned with it and no fit judgment against the cell is meaningful",
    }
  } else {
    if mc.mem_size_mib > guest_memory_mib_representable_max {
      GuestResourcesInvalid {
        cause: "the guest machine configuration declares a memory size whose conversion to bytes is not representable, so the fit comparison cannot be performed rather than being performed on a wrapped value",
      }
    } else {
      if mc.vcpu_count <= 0 {
        GuestResourcesInvalid {
          cause: "the guest machine configuration declares a vCPU count that is zero or negative, which is not a cardinality; the guest could not be started with it",
        }
      } else {
        GuestResourcesValidated {
          memory: GuestMemoryRequest {
            bytes: mebibyte_to_byte_size(m: mebibyte(count: mc.mem_size_mib)),
          },
          vcpus: hardware_thread_count(count: mc.vcpu_count),
        }
      }
    }
  }
}

// THE RESERVE IS AN INPUT, NOT A GLOBAL, AND THAT IS WHAT MAKES THE FIT CONTROLS AUTHORABLE.
//
// Production cannot supply one: no VMM footprint is cited anywhere, so gunbc_runner_microvm_
// realization_reserve returns ReserveUnmodeled and every production path refuses. If the reserve
// were read from a global instead of passed, that refusal would be the ONLY reachable outcome and
// neither fit arm could ever execute -- a wall whose red cannot be authored, which DESIGN 4b calls
// a decoration. Taking it as a parameter lets a witness declare one from a controlled fixture and
// drive BOTH polarities, while production stays honest.
type RealizationReserve
  = ReserveDeclared { bytes: ByteSize }
  | ReserveUnmodeled { cause: String }

type MemoryFitJudgment
  = GuestFitsWithinCell
  | GuestExceedsCell { detail: String }
  | MemoryFitUnresolved { cause: String }

// THE ADDITION IS ABSENT ON PURPOSE, AND IT MUST NOT BE HELPFULLY RESTORED. `guest + reserve <=
// envelope` is the law this function decides, but EVALUATING that left side can exceed the
// representable range on a hostile guest value and then wrap, answering the wrong question
// silently. So the comparison is performed by SUBTRACTION -- guest <= envelope - reserve -- which
// stays inside the range for any non-negative input. A reader who sees no overflow handling here
// is not looking at an oversight: there is no overflow to handle, because the operation that could
// overflow does not exist. That is DESIGN 4b rung 4 rather than a checked-add guard at rung 1, and
// restoring the add to give a guard something to point at would step the class back down.
//
// THE reserve > envelope SPLIT IS LOAD-BEARING FOR THAT CLAIM, not a redundant early-out: it is
// what keeps the subtraction from ever running below zero. Its control is
// test.claim.runner_microvm_witness_test a_reserve_larger_than_the_whole_envelope_admits_no_guest,
// which is the reason the branch may not be refactored away casually.
fn guest_memory_fits(
  guest: GuestMemoryRequest,
  reserve: RealizationReserve,
  envelope: CellMemoryEnvelope,
) -> MemoryFitJudgment {
  match reserve {
    ReserveUnmodeled { cause: c } =>
      MemoryFitUnresolved {
        cause: concat("the guest's memory cannot be judged against the cell without the realization's own reserve: ", c),
      }
    ReserveDeclared { bytes: r } =>
      if byte_size_count(b: r) > byte_size_count(b: envelope.bytes) {
        GuestExceedsCell {
          detail: "the realization's own reserve alone exceeds the cell's MemoryMax, so no guest of any size fits beside it",
        }
      } else {
        if byte_size_count(b: guest.bytes) <= byte_size_count(b: envelope.bytes) - byte_size_count(b: r) {
          GuestFitsWithinCell
        } else {
          GuestExceedsCell {
            detail: "the guest's memory plus the realization's reserve exceeds the cell's MemoryMax, so the slice would kill the VM it exists to bound",
          }
        }
      }
  }
}

// THE RESERVE IS AN ALLOCATION THIS FLEET SETS ASIDE, NOT A MEASUREMENT IT RECOVERED.
//
// The refusal this replaces was right about the quantity it could not find, and that reasoning is
// preserved rather than overturned: extdeps.virtualization.firecracker cites no VMM memory
// overhead, and the quantity may not exist as a constant at all -- a VMM's resident footprint
// scales with guest size through page tables, with the device model, and with host page size, so
// what upstream documents is a MEASURED overhead for one stated configuration. Waiting for that
// number to become citable was waiting for a fact in a shape nothing produces.
//
// SO THE STANDING CHANGES AND THE NUMBER DOES NOT PRETEND TO BE DERIVED. This is the same move
// gunbc_runner_microvm_declared_size already made for the guest's own size: a product decision
// standing where no computation exists. It is operator allocation policy, not a measured
// Firecracker footprint. Inventing it as a SUBTRAHEND in a derivation would still be the fabricated
// plausible output DESIGN 5 forbids; declaring it as policy, with the containment check below still
// deciding fit, is not.
//
// WHAT WOULD REVISE IT, STATED CAREFULLY, BECAUSE AN OOM IS NOT ONE EVIDENCE CLASS. Its adequacy is
// revised from host- or cell-boundary memory-pressure evidence attributable to the admitted
// realization. A guest that exhausts its own 4 GiB workload OOMs INSIDE the guest and says nothing
// about this allowance; only pressure at the cell boundary implicates it. No Firecracker release
// note revises it either, because upstream does not publish the quantity.
//
// IT IS A MINIMUM RESERVED HEADROOM, NOT A CAP ON THE VMM. The containment check establishes
// guest + allowance <= cell envelope. It does NOT establish VMM usage <= allowance, and nothing
// here enforces that -- with the declared guest inside the cell there is materially more real slack
// than this floor claims.
//
// WITHOUT IT THE MEMORY-FIT LEG CANNOT BE DECIDED, WHICH IS THE WHOLE REASON THIS ROW EXISTS.
// guest_memory_fits returns MemoryFitUnresolved on an unmodeled reserve, so
// gunbc_runner_microvm_admission refused EVERY configuration on that leg alone: the fleet's own size
// and reserve binding could never satisfy it, whatever else was true. The reserve was the last
// MEMORY-FIT quantity standing between the declared size and an admissible configuration.
//
// IT IS NOT THE LAST PRODUCTION-LAUNCH PREREQUISITE, AND THIS ROW DOES NOT CLAIM TO BE. Nothing in
// production calls gunbc_runner_microvm_admission and no production binding selects a
// VmmProcessTopology, so a launch path remains separate, unbuilt work.
//
// THE CELL'S CPU AXIS IS NOW ABSOLUTE WHEN THE SLOT SURVEY RESOLVES. fabric_cell_slice_quota_
// directives emits slice_cpu_quota from the same RunnerSlotCpuQuota this function reads, and
// runner_microvm_shape below admits the Work's thread count against that ceiling.
data gunbc_runner_microvm_declared_realization_allowance: Gibibyte = gibibyte(count: 1)

fn gunbc_runner_microvm_realization_reserve() -> RealizationReserve {
  ReserveDeclared {
    bytes: gibibyte_to_byte_size(gunbc_runner_microvm_declared_realization_allowance),
  }
}

// THE CPU AXIS IS THE CELL'S SURVEYED QUOTA, READ HERE RATHER THAN RESTATED.
//
// On memory the quantity may exist and merely be uncited. On CPU the cell now emits CPUQuota= when
// gunbc_runner_slot_cpu_quota resolves, and fabric_cell_acquire reads CPUQuotaPerSecUSec back.
// This function is that same quota seen as a guest-sizing entitlement: Resolved is Absolute,
// Refused is RelativeOnly carrying the survey cause -- never a second invented ceiling, and never
// the CPUWeight-only story that was true before the slice directive existed.
//
// runner_microvm_shape consumes this: an Absolute entitlement bounds the Work's thread count, and
// a RelativeOnly one refuses the shape, because a guest whose vCPUs nothing bounds is not a guest
// the cell can be said to contain.
type CellCpuEntitlement
  = CpuEntitlementAbsolute { threads: HardwareThreadCount }
  | CpuEntitlementRelativeOnly { cause: String }

fn gunbc_runner_microvm_cell_cpu_entitlement() -> CellCpuEntitlement {
  match gunbc_runner_slot_desired().cpu_quota {
    CpuQuotaResolved { threads: t } => CpuEntitlementAbsolute { threads: t }
    CpuQuotaRefused { cause: c } => CpuEntitlementRelativeOnly { cause: c }
  }
}

// THE srv4 MVP SIZE, KEPT AS THE BOOT-SMOKE FIXTURE AND NO LONGER A PRODUCTION SIZING ARM. Until
// 2026-09-19 this row was served whenever the cell granted only a relative CPU share, and the
// absolute arm refused because the derivation below did not exist. The derivation exists now, so a
// cell that grants no absolute entitlement REFUSES the shape rather than being handed a size that
// nothing bounded -- a declared row that keeps answering after its forcing condition is gone is the
// absorbing fallback DESIGN 5 forbids. The row survives because the boot smoke and the attempt
// planner's witnesses drive a guest of exactly this size, which is the size srv4 was observed to
// boot; it is a fixture with a receipt behind it, not a sizing anyone provisions against.
data gunbc_runner_microvm_declared_size: RunnerMicroVmSize = RunnerMicroVmSize {
  vcpu_count: hardware_thread_count(count: 4),
  memory: mebibyte(count: 4096),
}

// THE PER-ATTEMPT WORKSPACE GRANT: X's WORKGB=4 (`dd bs=1M count=0 seek=$((WORKGB*1024))`), four
// gibibytes as a Mebibyte seek. It lives beside the workspace drive it sizes rather than in the
// planner, because the shape below judges the Work's storage demand against it and the planner
// only realizes it. It is a GRANT rather than a derivation: the cell places no numeric bound on
// disk (gunbc.runner_slot_allocation: disk admits nothing numeric anywhere), so there is no
// remainder to derive a workspace from the way memory derives from the cell's ceiling, and a
// workspace sized exactly to a measured lower bound would ENOSPC on the first byte of growth. The
// fit check is what keeps the grant honest: a demand the grant does not hold refuses the shape.
data runner_microvm_workspace_grant: Mebibyte = mebibyte(count: 4096)

// THE GUEST SHAPE, DERIVED FROM THE WORK AND THE CELL RATHER THAN DECLARED BESIDE THEM.
//
// Four quantities, each with one source:
//
//   vCPUs        the Work's own hard thread requirement, admitted against the cell's absolute
//                CPU entitlement. The guest is sized to what the Work asks for, not to the whole
//                quota: the VMM's own threads -- the API thread, the block and net device threads
//                -- draw on the same CPUQuota, and a guest holding every entitled thread leaves
//                them nothing, exactly as a guest holding the whole MemoryMax left the VMM nothing.
//   memory       the cell's MemoryMax less the realization reserve: everything the cell admits
//                beside the VMM, admitted only if it is at least the Work's stated minimum PLUS
//                the guest's cache allowance. The Work's minimum is what it must hold
//                (gunbc.floor_demand: the non-reclaimable partition); the allowance is what this
//                realization grants its kernel for file pages above that, because a guest with
//                exactly its anonymous demand as RAM thrashes. The guest is granted the whole
//                REMAINDER rather than the sum because the minimum is a censored lower bound and
//                guest RAM is lazily faulted, so headroom costs nothing until touched. Floor
//                division to MiB keeps guest + reserve <= MemoryMax by construction, so
//                guest_memory_fits admits the derived guest without a second relation.
//   workspace    the attempt's workspace grant, admitted only if it holds the Work's stated
//                storage minimum.
//   task ceiling the cell's TasksMax, carried INTO the guest as kernel.pid_max. In the lifecycle-
//                controller topology the cell's TasksMax bounds only the VMM's handful of threads;
//                the floor's processes live behind the guest kernel, where the cell cannot count
//                them. Re-applying the same row inside the guest keeps the 2026-06-21 incident's
//                repair value (gunbc.runner_slot_allocation: TasksMax=512 was the EAGAIN outage)
//                governing the workload that produced the incident.
//
// EVERY REFUSAL IS TYPED AND CARRIES THE TWO NUMBERS THAT DISAGREED, because the remedy differs by
// arm: a Work exceeding the cell's remainder is either a cell row to raise (a fleet decision with
// a slot cost) or a demand to reduce, a Work exceeding the entitlement is a thread count to
// revisit, and an unstated Work axis is a Work to complete. Collapsing them into a String would
// send the reader to the wrong authority.
type RunnerMicroVmShape {
  size: RunnerMicroVmSize
  workspace: Mebibyte
  task_ceiling: Int
}

type RunnerMicroVmShapeRefusal
  = ShapeRefusedCpuEntitlementRelativeOnly { cause: String }
  | ShapeRefusedWorkThreadsExceedEntitlement { required: HardwareThreadCount, entitled: HardwareThreadCount }
  | ShapeRefusedWorkMemoryUnstated
  | ShapeRefusedReserveUnmodeled { cause: String }
  | ShapeRefusedReserveExceedsCell { reserve: ByteSize, envelope: ByteSize }
  | ShapeRefusedWorkMemoryExceedsCellRemainder { required: ByteSize, allowance: ByteSize, remainder: ByteSize }
  | ShapeRefusedWorkStorageExceedsWorkspace { required: ByteSize, workspace: ByteSize }

type RunnerMicroVmShapeResolution
  = MicroVmShapeResolved { shape: RunnerMicroVmShape }
  | MicroVmShapeRefused { refusal: RunnerMicroVmShapeRefusal }

fn runner_microvm_shape_refusal_text(r: RunnerMicroVmShapeRefusal) -> String {
  match r {
    ShapeRefusedCpuEntitlementRelativeOnly { cause: c } =>
      concat("the cell grants no absolute CPU entitlement, so no vCPU count is bounded by it: ", c)
    ShapeRefusedWorkThreadsExceedEntitlement { required: r, entitled: e } =>
      join(["the work requires ", to_string(hardware_thread_count_value(t: r)), " threads and the cell entitles ", to_string(hardware_thread_count_value(t: e))], "")
    ShapeRefusedWorkMemoryUnstated =>
      "the work states no memory requirement, so no guest memory can be judged sufficient for it"
    ShapeRefusedReserveUnmodeled { cause: c } =>
      concat("the realization reserve is unmodeled, so the cell's remainder cannot be computed: ", c)
    ShapeRefusedReserveExceedsCell { reserve: r, envelope: e } =>
      join(["the realization reserve of ", to_string(byte_size_count(b: r)), " bytes exceeds the cell's MemoryMax of ", to_string(byte_size_count(b: e))], "")
    ShapeRefusedWorkMemoryExceedsCellRemainder { required: r, allowance: a, remainder: m } =>
      join(["the work's memory demand of ", to_string(byte_size_count(b: r)), " bytes plus the guest's cache allowance of ", to_string(byte_size_count(b: a)), " bytes exceeds the ", to_string(byte_size_count(b: m)), " bytes the cell admits beside the realization reserve; raise the cell row, lower the allowance or reduce the demand"], "")
    ShapeRefusedWorkStorageExceedsWorkspace { required: r, workspace: w } =>
      join(["the work's storage demand of ", to_string(byte_size_count(b: r)), " bytes exceeds the ", to_string(byte_size_count(b: w)), " byte workspace grant"], "")
  }
}

fn runner_microvm_shape(
  work: ExecutionRequirements,
  storage: StorageRequirement,
  cpu: CellCpuEntitlement,
  envelope: CellMemoryEnvelope,
  reserve: RealizationReserve,
  cache_allowance: Gibibyte,
  task_ceiling: Int,
  workspace: Mebibyte,
) -> RunnerMicroVmShapeResolution {
  match cpu {
    CpuEntitlementRelativeOnly { cause: c } =>
      MicroVmShapeRefused { refusal: ShapeRefusedCpuEntitlementRelativeOnly { cause: c } }
    CpuEntitlementAbsolute { threads: entitled } =>
      if hardware_thread_count_value(t: work.shape.hard.threads) > hardware_thread_count_value(t: entitled) {
        MicroVmShapeRefused {
          refusal: ShapeRefusedWorkThreadsExceedEntitlement { required: work.shape.hard.threads, entitled: entitled },
        }
      } else {
        match work.shape.envelope.memory {
          Absent => MicroVmShapeRefused { refusal: ShapeRefusedWorkMemoryUnstated }
          Present { value: need } =>
            runner_microvm_shape_after_cpu(
              vcpus: work.shape.hard.threads,
              need: need.min_bytes,
              storage: storage,
              envelope: envelope,
              reserve: reserve,
              cache_allowance: cache_allowance,
              task_ceiling: task_ceiling,
              workspace: workspace,
            )
        }
      }
  }
}

// THE SUBTRACTION STAYS IN RANGE FOR THE SAME REASON guest_memory_fits GIVES: reserve > envelope is
// split off before envelope - reserve is evaluated, so the remainder is never negative.
fn runner_microvm_shape_after_cpu(
  vcpus: HardwareThreadCount,
  need: ByteSize,
  storage: StorageRequirement,
  envelope: CellMemoryEnvelope,
  reserve: RealizationReserve,
  cache_allowance: Gibibyte,
  task_ceiling: Int,
  workspace: Mebibyte,
) -> RunnerMicroVmShapeResolution {
  match reserve {
    ReserveUnmodeled { cause: c } =>
      MicroVmShapeRefused { refusal: ShapeRefusedReserveUnmodeled { cause: c } }
    ReserveDeclared { bytes: r } =>
      if byte_size_count(b: r) > byte_size_count(b: envelope.bytes) {
        MicroVmShapeRefused { refusal: ShapeRefusedReserveExceedsCell { reserve: r, envelope: envelope.bytes } }
      } else {
        let remainder = byte_size_count(b: envelope.bytes) - byte_size_count(b: r)
        let allowance = gibibyte_to_byte_size(cache_allowance)
        if remainder < byte_size_count(b: need) + byte_size_count(b: allowance) {
          MicroVmShapeRefused {
            refusal: ShapeRefusedWorkMemoryExceedsCellRemainder { required: need, allowance: allowance, remainder: byte_size(remainder) },
          }
        } else {
          let workspace_bytes = mebibyte_to_byte_size(m: workspace)
          if byte_size_count(b: storage.min_bytes) > byte_size_count(b: workspace_bytes) {
            MicroVmShapeRefused {
              refusal: ShapeRefusedWorkStorageExceedsWorkspace { required: storage.min_bytes, workspace: workspace_bytes },
            }
          } else {
            MicroVmShapeResolved {
              shape: RunnerMicroVmShape {
                size: RunnerMicroVmSize {
                  vcpu_count: vcpus,
                  memory: mebibyte(count: remainder / mebibyte_scale_factor_bytes()),
                },
                workspace: workspace,
                task_ceiling: task_ceiling,
              },
            }
          }
        }
      }
  }
}

// THE GUEST'S CACHE ALLOWANCE IS OPERATOR POLICY, NOT A MEASUREMENT, AND IT IS NAMED AS SUCH. A
// guest whose RAM equals the Work's non-reclaimable demand runs the floor with no file cache at
// all, re-reading every source and object from the workspace image on each touch. ITS EVIDENCE IS
// THE DEMAND RECEIPT'S OWN TWO BEATS (gunbc.floor_demand gunbc_floor_non_reclaimable_receipt_2026_09_19):
// with about 1.8 GiB of cache beside the anonymous peak the host slot stalled zero faults per
// minute, and with that cache reclaimed to 13 MiB it took sixty-seven thousand a minute -- so two
// gibibytes is the smallest whole-gibibyte grain above the cache the run held while it was not
// thrashing. It is a floor on a working operating point, not a measured optimum; the operator may
// revise it, and its revision trigger is the in-guest cold receipt
// (gunbc.floor_cold_build_receipt), which reads the same partition inside a guest.
data gunbc_runner_microvm_guest_cache_allowance: Gibibyte = gibibyte(count: 2)

// THE FLEET'S OWN SHAPE: the floor's Work against this fleet's cell, reserve, cache allowance,
// task row and workspace grant. Every input is read from the authority that owns it; nothing here is a
// parameter a caller could use to hand the guest an envelope the cell did not declare.
fn gunbc_runner_microvm_shape() -> RunnerMicroVmShapeResolution {
  let cell = gunbc_runner_slot_desired()
  runner_microvm_shape(
    work: floor_execution_requirements(),
    storage: floor_storage_requirement(),
    cpu: gunbc_runner_microvm_cell_cpu_entitlement(),
    envelope: CellMemoryEnvelope { bytes: cell.memory_max },
    reserve: gunbc_runner_microvm_realization_reserve(),
    cache_allowance: gunbc_runner_microvm_guest_cache_allowance,
    task_ceiling: cell.tasks_max,
    workspace: runner_microvm_workspace_grant,
  )
}

// THE TASK CEILING REACHES THE GUEST AS A KERNEL COMMAND-LINE SYSCTL, rendered by the cited
// kernel-parameters authority rather than spelled here. The guest reads it back as
// /proc/sys/kernel/pid_max; a guest kernel too old to honour `sysctl.` boots with its default and
// the readback, not this argument, is what establishes the ceiling.
fn runner_microvm_task_ceiling_boot_arg(shape: RunnerMicroVmShape) -> String {
  kernel_cmdline_arg_wire(
    arg: sysctl_cmdline_arg(parameter: "kernel.pid_max", value: to_string(shape.task_ceiling)),
  )
}

fn runner_microvm_isolation_profile() -> IsolationProfile {
  dedicated_kernel_sandbox_profile()
}

fn runner_microvm_provides_dedicated_kernel() -> Bool {
  isolation_profile_satisfies(
    required: IsolationProfile { guarantees: [DedicatedKernel] },
    provided: runner_microvm_isolation_profile(),
  )
}

// THE VMM PROCESS TOPOLOGY IS A FACT WITH OPPOSITE CONSEQUENCES, SO IT IS CARRIED RATHER THAN
// ASSUMED.
//
// An earlier revision of this module refused every microVM under an orphanable lifecycle intent, on
// the reasoning that a microVM relocates the orphan to the VMM rather than removing it. That
// reasoning is sound for ONE topology and wrong for the other, and collapsing the two into a single
// unconditional refusal would have refused a correct design:
//
//   VmmIsMainProcess -- the unit execs the jailer, which execs Firecracker, so the VMM IS MainPID.
//     Killing MainPID destroys the guest and everything in it. No process can outlive that kill, so
//     no kill mode or exit type can produce an orphan here. The guarantee is not needed.
//
//   VmmUnderLifecycleController -- a controller stays MainPID so it can wait for the VMM, tear down
//     the epoch's disk, tap and secret, read back their absence and return one classified status.
//     That controller is worth having, and it puts the VMM back underneath a parent, which is
//     exactly the shape that orphans today. The guarantee IS needed.
//
// So the prerequisite belongs to the topology, not to virtualization. Stating it the other way
// would have been a claim about microVMs that the mechanism does not support.
type VmmProcessTopology = VmmIsMainProcess | VmmUnderLifecycleController

// THERE IS DELIBERATELY NO `topology_requires_cgroup_reaching_teardown(..) -> Bool` BESIDE THIS
// TYPE, and its absence is the same repair gunbc.commit_workflow made at its CheckRemoval selection
// (review 57017): a Bool classifying coproduct arms is a parallel surface over a vocabulary that
// already answers, and it destroys exhaustiveness at every call site. A THIRD topology -- a VMM
// supervised by a per-attempt controller that itself execs, say -- would be absorbed into one side
// of that predicate and no consumer would ever be asked which side it belongs on. Matched in place
// in runner_microvm_admission below, a third arm fails to compile exactly where the prerequisite
// has to be decided for it.

// ADMISSION, AND THE PREREQUISITE IS A REFUSAL RATHER THAN A PARAGRAPH.
//
// Under a lifecycle-controller topology whose teardown does not reach the whole cgroup, a microVM
// does not close the orphan class -- it moves the orphan up one level, and an orphaned VMM keeps
// its guest alive holding the same credential. "Everything inside the VM dies together" is true and
// does not help when the VM is what survived.
//
// gunbc.runner_unit already owns the deciding predicate and the measured input (whether the tracked
// main process exits when the incarnation ends), so this consumes that authority rather than
// re-deriving it. Stating the dependency in prose would have left it satisfiable by an author who
// never read the paragraph.
//
// THIS IS A NECESSARY GATE, NOT A SUFFICIENT ONE, and the gap is a declared frontier. The predicate
// is static: it says a finished incarnation makes systemd issue a stop that reaches the cgroup. It
// cannot say the VMM is gone afterwards -- a task in uninterruptible sleep survives SIGKILL, and a
// main process that outlives its incarnation issues no stop at all -- nor that the cell is safe to
// reuse. That is gunbc.product.fabric.sanitation's CellReadiness, established by a terminalizer's
// readback, which this admission will consume once the terminalizer lands. Until then an Admitted
// verdict here is not sufficient grounds to run customer work.
type RunnerMicroVmAdmission
  = RunnerMicroVmAdmitted
  | RunnerMicroVmRefusedOrphanableUnit { reason: String }
  | RunnerMicroVmRefusedSharedCredential { reason: String }
  | RunnerMicroVmRefusedMalformedVm { reason: String }
  | RunnerMicroVmRefusedEnvelopeDisagreement { reason: String }
  | RunnerMicroVmRefusedEnvelopeUnresolved { reason: String }

// THE ADMISSION IS A CASCADE OF MATCHES, NOT A CHAIN OF BOOLEAN PREDICATES, and that shape is the
// point rather than a rendering of it. Each coproduct this admission depends on -- the topology,
// the credential carrier, the cell's resource envelope -- is matched HERE, where the consequence is
// decided, so a new variant on any of them fails to compile at the place that has to rule on it
// instead of being silently absorbed into one side of a `-> Bool` helper.
//
// THE ENVELOPE HAS TWO REFUSAL ARMS AND THEY ARE NOT INTERCHANGEABLE. An envelope that did not
// RESOLVE and an envelope the VM DISAGREES WITH are different states with different owners: the
// first is a survey or a ceiling this module cannot read, and its remedy is in
// gunbc.runner_slot_allocation; the second is an authored VM, and its remedy is to derive the size
// instead of writing it. Collapsing them into one cause is the state-space conflation DESIGN names,
// and it would send an operator to the wrong module.
fn runner_microvm_admission(
  topology: VmmProcessTopology,
  intent: RunnerUnitLifecycleIntent,
  main_exits_when_incarnation_ends: Bool,
  transport: JitCredentialTransport,
  config: FirecrackerVmConfig,
  reserve: RealizationReserve,
) -> RunnerMicroVmAdmission {
  match topology {
    VmmIsMainProcess =>
      runner_microvm_admission_after_topology(transport: transport, config: config, reserve: reserve)
    VmmUnderLifecycleController =>
      if lifecycle_intent_stops_finished_incarnation(intent: intent, main_exits_when_incarnation_ends: main_exits_when_incarnation_ends) {
        runner_microvm_admission_after_topology(transport: transport, config: config, reserve: reserve)
      } else {
        RunnerMicroVmRefusedOrphanableUnit {
          reason: "this topology keeps a lifecycle controller above the VMM, and the unit's teardown can leave a live process behind, so an orphaned VMM would keep its guest and its credential alive -- the microVM relocates the orphan rather than removing it. Deploy the declared intent (ExitType=main with KillMode=control-group), or exec the VMM directly as MainPID",
        }
      }
  }
}

fn runner_microvm_admission_after_topology(
  transport: JitCredentialTransport,
  config: FirecrackerVmConfig,
  reserve: RealizationReserve,
) -> RunnerMicroVmAdmission {
  match transport {
    JitConfigInSharedSlotDirectory { path: _ } =>
      RunnerMicroVmRefusedSharedCredential {
        reason: "the JIT credential is carried in a directory shared across incarnations, which is the exact carrier that lets one incarnation delete another's credential mid-job; a per-VM read-only drive is required",
      }
    JitConfigOnReadOnlyDrive { drive_id: _ } =>
      runner_microvm_admission_after_credential(config: config, reserve: reserve)
  }
}

// THE ADMISSION JUDGES FIT, NOT AGREEMENT, AND THE DIFFERENCE IS THE WHOLE REPAIR.
//
// The withdrawn arm asked whether the guest's configuration EQUALLED a derived envelope. That is
// the wrong question twice over: it admits a guest sized at the whole ceiling, which leaves the
// VMM process nothing inside the same cell, and it refuses a guest SMALLER than the ceiling, which
// fits comfortably. Containment is the property -- guest plus reserve within the envelope -- and a
// smaller guest passing is a REQUIREMENT of the repair rather than a tolerated side effect.
//
// The cell's envelope is read here rather than passed because it is not the disputed quantity:
// gunbc_runner_slot_desired is the single authority for what the cell is granted, and reading it
// is what keeps this from becoming a second envelope. The RESERVE is the parameterised one.
fn runner_microvm_admission_after_credential(
  config: FirecrackerVmConfig,
  reserve: RealizationReserve,
) -> RunnerMicroVmAdmission {
  if !firecracker_config_has_single_root(config: config) {
    RunnerMicroVmRefusedMalformedVm {
      reason: "the Firecracker configuration does not name exactly one root device, so the guest either cannot boot or its root is ambiguous",
    }
  } else {
    match guest_resources_of_machine_config(mc: config.machine_config) {
      GuestResourcesInvalid { cause: c } =>
        RunnerMicroVmRefusedMalformedVm {
          reason: concat("the guest machine configuration does not carry usable magnitudes, so it is refused before any fit judgment: ", c),
        }
      GuestResourcesValidated { memory: g, vcpus: _ } =>
        match guest_memory_fits(
          guest: g,
          reserve: reserve,
          envelope: CellMemoryEnvelope { bytes: gunbc_runner_slot_desired().memory_max },
        ) {
          MemoryFitUnresolved { cause: c } =>
            RunnerMicroVmRefusedEnvelopeUnresolved {
              reason: concat("this guest cannot be judged against the bounded cell, so no VM is admissible: ", c),
            }
          GuestExceedsCell { detail: d } =>
            RunnerMicroVmRefusedEnvelopeDisagreement {
              reason: concat("the guest would not fit the bounded cell FCI-1 admitted: ", d),
            }
          GuestFitsWithinCell => RunnerMicroVmAdmitted
        }
    }
  }
}

// THE VM CONFIGURATION, DERIVED FROM THE FACTS ABOVE RATHER THAN AUTHORED BESIDE THEM.
//
// Every field a caller could get wrong independently is instead a consequence: the root drive is
// the image, the second drive is the credential transport's own drive_id, and the size is the
// declared size. A hand-authored config beside these rows would be a second spelling of one VM.
// A GUEST WITH NO INTERFACE IS A DIFFERENT KIND OF VM, NOT A VM MISSING AN ARGUMENT.
//
// The builder previously required a tap device and a MAC, so the only configuration it could express
// was one with egress -- and a boot smoke, which has no tap because the per-slot network is a later
// slice, could not be expressed at all without handing it the name of a device that does not exist.
// A guest that cannot reach the network is not a degraded runner: it CANNOT REGISTER, so it is not a
// runner at all, and saying so in the type is what stops a caller from expecting one to appear in
// the runner list. GuestNetworkAbsent carries its cause for the same reason every refusal here does.
type RunnerMicroVmNetworking
  = GuestNetworkTap { device: NonEmptyStr, guest_mac: NonEmptyStr }
  | GuestNetworkAbsent { cause: String }

fn runner_microvm_network_interfaces(net: RunnerMicroVmNetworking) -> List<FirecrackerNetworkInterface> {
  match net {
    GuestNetworkAbsent { cause: _ } => [] as List<FirecrackerNetworkInterface>
    GuestNetworkTap { device: d, guest_mac: m } => [
      FirecrackerNetworkInterface { iface_id: "eth0", host_dev_name: d, guest_mac: m },
    ]
  }
}

fn runner_microvm_vm_config(
  rootfs_path: FilePath,
  jit_config_path: FilePath,
  kernel_path: FilePath,
  net: RunnerMicroVmNetworking,
  size: RunnerMicroVmSize,
  transport: JitCredentialTransport,
) -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: FirecrackerBootSource {
      kernel_image_path: kernel_path,
      boot_args: "keep_bootcon console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw",
    },
    drives: [
      FirecrackerDrive {
        drive_id: "rootfs",
        path_on_host: rootfs_path,
        is_root_device: true,
        is_read_only: false,
      },
      FirecrackerDrive {
        drive_id: jit_transport_drive_id(t: transport),
        path_on_host: jit_config_path,
        is_root_device: false,
        is_read_only: true,
      },
    ],
    network_interfaces: runner_microvm_network_interfaces(net: net),
    machine_config: FirecrackerMachineConfig {
      vcpu_count: hardware_thread_count_value(t: size.vcpu_count),
      mem_size_mib: mebibyte_count(m: size.memory),
    },
  }
}

fn jit_transport_drive_id(t: JitCredentialTransport) -> NonEmptyStr {
  match t {
    JitConfigOnReadOnlyDrive { drive_id: d } => d
    JitConfigInSharedSlotDirectory { path: _ } => "jitcfg"
  }
}

data runner_microvm_workspace_drive_id: NonEmptyStr = "work"

fn runner_microvm_workspace_drive(path: FilePath) -> FirecrackerDrive {
  FirecrackerDrive {
    drive_id: runner_microvm_workspace_drive_id,
    path_on_host: path,
    is_root_device: false,
    is_read_only: false,
  }
}

fn attach_workspace_drive(config: FirecrackerVmConfig, path: FilePath) -> FirecrackerVmConfig {
  FirecrackerVmConfig {
    boot_source: config.boot_source,
    drives: append(config.drives, items: [runner_microvm_workspace_drive(path: path)]),
    network_interfaces: config.network_interfaces,
    machine_config: config.machine_config,
  }
}

// THE FLEET'S OWN ADMISSION, EVALUATED AGAINST THE DECLARED INTENT.
//
// This is the row that answers "may we run runners in microVMs today", and it answers by consuming
// gunbc_runner_lifecycle_intent rather than by an author's assertion. It moves the day that intent
// is deployed, and not before.
fn gunbc_runner_microvm_admission(
  topology: VmmProcessTopology,
  config: FirecrackerVmConfig,
) -> RunnerMicroVmAdmission {
  runner_microvm_admission(
    topology: topology,
    intent: gunbc_runner_lifecycle_intent,
    main_exits_when_incarnation_ends: gunbc_runner_main_exits_when_incarnation_ends,
    transport: gunbc_runner_jit_transport,
    config: config,
    reserve: gunbc_runner_microvm_realization_reserve(),
  )
}

// THE FLEET'S OWN VM, WHOSE SIZE IS NOT A PARAMETER.
//
// runner_microvm_vm_config above takes a size because it is the SHAPE -- one Firecracker
// configuration, derived from whatever facts a caller holds -- and the shape is reusable. This row
// is this fleet's binding of it, and the difference that matters is that the size axis is GONE:
// there is no argument here through which a caller could hand a guest an envelope the bounded cell
// did not declare. The admission wall still stands for configurations arriving from elsewhere; on
// this path there is nothing left for it to catch, which is what construction over validation looks
// like when it succeeds (DESIGN 5).
//
// IT RETURNS A RESOLUTION RATHER THAN A CONFIGURATION, because the envelope itself can fail to
// resolve and a VM is not constructible without it. Substituting the MVP size here -- or any
// plausible default -- would be the absorbing fallback: a guest that boots at the wrong ceiling and
// reports success is strictly worse than one that refuses, because the ceiling is not observable
// from inside the job it kills.
type RunnerMicroVmConfigResolution
  = MicroVmConfigResolved { config: FirecrackerVmConfig }
  | MicroVmConfigUnresolved { cause: String }

fn gunbc_runner_microvm_vm_config(
  rootfs_path: FilePath,
  jit_config_path: FilePath,
  kernel_path: FilePath,
  net: RunnerMicroVmNetworking,
) -> RunnerMicroVmConfigResolution {
  match gunbc_runner_microvm_shape() {
    MicroVmShapeRefused { refusal: r } =>
      MicroVmConfigUnresolved { cause: runner_microvm_shape_refusal_text(r: r) }
    MicroVmShapeResolved { shape: s } =>
      MicroVmConfigResolved {
        config: runner_microvm_vm_config(
          rootfs_path: rootfs_path,
          jit_config_path: jit_config_path,
          kernel_path: kernel_path,
          net: net,
          size: s.size,
          transport: gunbc_runner_jit_transport,
        ),
      }
  }
}
