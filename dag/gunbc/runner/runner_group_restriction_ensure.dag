module gunbc.runner_group_restriction_ensure

import std.types { NonEmptyStr, String, Bool, Int, List }
import extdeps.github.org_actions { SelectedRepositories, runner_group_visibility_wire }
import gunbc.repository { gunbc_repository_numeric_identity }
import gunbc.auth.heal_publisher_federation { private_heal_publisher_federation, heal_publisher_federation_workflow_ref }
import gunbc.fleet.org_actions_inspection { org_actions_organization, RunnerGroupListDecode }
import gunbc.runner.runner_qualification_ref_pin {
  qualification_runner_group_name, qualification_pin_prefix, qualification_unpinned_selected_workflow,
}
import gunbc.runner_group_restriction_observation {
  RestrictedRunnerGroup, MicrovmRunnerGroupStanding,
  RunnerGroupRestrictedToWorkflow, RunnerGroupRestrictionRefused,
  RunnerGroupAbsent, observe_runner_group_restriction, observe_pinned_runner_group, microvm_shakedown_runner_group_name,
  microvm_shakedown_selected_workflow, runner_group_restriction_refusal_text,
}

// THE MICROVM RUNNER GROUP, ENSURED: read first, create only when absent, read back after.
//
// The group gunbc.runner_jit_mint plan_jit_mint requires is one the organization does not have
// until it is created, and creating it is an org-admin effect. This module owns the PLAN -- what
// the group must be, and which of three things a read of the organization's groups says to do --
// so the effect is never performed on a guess: a group already restricted to exactly its
// workflow is left alone (no request is filed, no operator is asked), an absent one is created, and
// a group holding the name with any other restriction is REFUSED rather than edited, because the
// update is a different effect that nobody has modeled or approved. After a create, the
// organization is read again and the same sealed observer
// (gunbc.runner_group_restriction_observation) must hold, or the create is refused: a 201 is
// GitHub saying it accepted the request, and only the readback says the group is what the mint
// needs.

// What varies between restricted groups: the organization, the name, the one selected repository
// and the one selected workflow. The three walls every restricted group holds -- SELECTED visibility,
// no public repositories, restricted to workflows -- are NOT fields: an open group has no
// representation here, so the create body emits them as constants
// (gunbc.runner_group_restriction_ensure_run microvm_runner_group_create_under) and no check over a
// subject is needed to keep one from being sent (review 76277, DESIGN §5: construction, not
// validation).
type RunnerGroupCreateSubject {
  organization: NonEmptyStr
  name: NonEmptyStr
  selected_repository_id: Int
  selected_workflow: NonEmptyStr
  workflow_policy: GroupWorkflowPolicy
}

// WHAT A GROUP'S WORKFLOW RESTRICTION IS EXPECTED TO BE ONCE IT EXISTS. Most groups select one fixed
// workflow forever. The dedicated qualification group is re-pinned every attempt to the qualification
// workflow at that attempt's branch (gunbc.runner.runner_qualification_ref_pin), so its expected
// restriction is the pin family, and a group already pinned to some attempt is the same group, left
// alone -- never re-created and never edited by this ensure.
type GroupWorkflowPolicy
  = FixedSelectedWorkflow
  | PinnedPerAttempt { pin_prefix: NonEmptyStr }

// EVERY RESTRICTED GROUP IS THIS SHAPE: one repository and exactly one workflow, the three walls
// being the create body's constants rather than members.
fn restricted_runner_group_subject(name: NonEmptyStr, repository_id: Int, selected_workflow: NonEmptyStr) -> RunnerGroupCreateSubject {
  RunnerGroupCreateSubject {
    organization: org_actions_organization,
    name: name,
    selected_repository_id: repository_id,
    selected_workflow: selected_workflow,
    workflow_policy: FixedSelectedWorkflow,
  }
}

fn microvm_runner_group_create_subject() -> RunnerGroupCreateSubject {
  restricted_runner_group_subject(
    name: microvm_shakedown_runner_group_name,
    repository_id: gunbc_repository_numeric_identity.repository_id,
    selected_workflow: microvm_shakedown_selected_workflow(),
  )
}

// GUNBC-PRIVATE'S HEAL PUBLISHER IS HEADED FOR microVMs, IN A GROUP ONLY ITS PUBLISHER MAY USE
// (operator 2026-09-29). Its identity (gunbc.auth.heal_publisher_federation
// private_heal_publisher_federation) will admit a self-hosted runner, and the OIDC token cannot say
// WHICH one -- so the wall that keeps pull-request code off the machine is this group: restricted to
// exactly the publisher's workflow at the default branch, and to gunbc-private alone. The selected
// workflow IS the federation's workflow_ref, one string for both. The group name is also the runner
// label the publish job selects (strategy.private_heal_publisher_workflow).
//
// CREATING THE GROUP NARROWS AND WIDENS NOTHING, so it is ensured now. The federation's pin stays
// github-hosted until a controller mints guests into this group after reading its restriction back
// (review 72445): the flip and that minting path land together, in one change.
data private_heal_publisher_runner_group_name: NonEmptyStr = "heal-publisher-private"

fn private_heal_publisher_runner_group_subject() -> RunnerGroupCreateSubject {
  restricted_runner_group_subject(
    name: private_heal_publisher_runner_group_name,
    repository_id: private_heal_publisher_federation().numeric_identity.repository_id,
    selected_workflow: heal_publisher_federation_workflow_ref(f: private_heal_publisher_federation()) as NonEmptyStr,
  )
}

// THE ROSTER THE ENSURE RUN WALKS, like gcp_iam_converge_targets: each group is read, left alone when
// already restricted, created under its own approval when absent, and refused when it holds the
// name with any other restriction.
// THE DEDICATED QUALIFICATION GROUP (decision: eager-gull-22, 2026-10-04). The same three walls as
// every restricted group, which the create body carries as constants -- created pinned to the reserved unpinned branch, which no attempt can
// name, so it admits nothing until the first attempt pins it. Its expected restriction afterwards is
// the pin family (PinnedPerAttempt). This ensure only ever creates it; the per-attempt re-pin is
// gunbc.runner.runner_qualification_ref_pin's, and only on this group.
fn qualification_runner_group_subject() -> RunnerGroupCreateSubject {
  RunnerGroupCreateSubject {
    organization: org_actions_organization,
    name: qualification_runner_group_name,
    selected_repository_id: gunbc_repository_numeric_identity.repository_id,
    selected_workflow: qualification_unpinned_selected_workflow(),
    workflow_policy: PinnedPerAttempt { pin_prefix: qualification_pin_prefix() },
  }
}

fn restricted_runner_groups() -> List<RunnerGroupCreateSubject> {
  [microvm_runner_group_create_subject(), private_heal_publisher_runner_group_subject(), qualification_runner_group_subject()]
}

fn observe_subject_restriction(subject: RunnerGroupCreateSubject, listed: RunnerGroupListDecode) -> MicrovmRunnerGroupStanding {
  match subject.workflow_policy {
    FixedSelectedWorkflow => observe_runner_group_restriction(name: subject.name, selected_workflow: subject.selected_workflow, listed: listed)
    PinnedPerAttempt { pin_prefix: p } => observe_pinned_runner_group(name: subject.name, pin_prefix: p, listed: listed)
  }
}

// The subject as one line, the text the operator reads and the intent a request digests.
fn runner_group_create_subject_text(s: RunnerGroupCreateSubject) -> String {
  join([
    "create runner group ", s.name as String, " in org ", s.organization as String,
    ": visibility=", runner_group_visibility_wire(v: SelectedRepositories) as String,
    " repository_id=", to_string(s.selected_repository_id),
    " allows_public_repositories=false",
    " restricted_to_workflows=true",
    " selected_workflows=[", s.selected_workflow as String, "]",
  ], "")
}

type RunnerGroupEnsurePlan
  = GroupAlreadyRestricted { restriction: RestrictedRunnerGroup }
  | GroupCreateRequired { subject: RunnerGroupCreateSubject }
  | GroupEnsureRefused { cause: NonEmptyStr }

// Absent is the ONE refusal that plans the create; every other refusal of the observer -- an
// unreadable list, a duplicated name, a group holding the name with another restriction -- refuses
// the ensure, because the update is a different effect nobody has modeled or approved.
fn plan_runner_group_ensure(subject: RunnerGroupCreateSubject, listed: RunnerGroupListDecode) -> RunnerGroupEnsurePlan {
  match observe_subject_restriction(subject: subject, listed: listed) {
    RunnerGroupRestrictedToWorkflow { restriction } => GroupAlreadyRestricted { restriction: restriction }
    RunnerGroupRestrictionRefused { name: _, cause: RunnerGroupAbsent } => GroupCreateRequired { subject: subject }
    RunnerGroupRestrictionRefused { name, cause } =>
      GroupEnsureRefused { cause: join([
        "RunnerGroupNotEnsurable: ", name as String, ": ", runner_group_restriction_refusal_text(cause: cause),
        "; updating an existing group is an effect this module does not perform",
      ], "") as NonEmptyStr }
  }
}

// THE READBACK AFTER A CREATE. The only admitted outcome is the sealed restriction; an absent group
// after a 201 is as much a refusal as a wrongly restricted one.
type RunnerGroupCreateReadback
  = CreatedGroupRestricted { restriction: RestrictedRunnerGroup }
  | CreatedGroupNotRestricted { cause: NonEmptyStr }

// THE READBACK JUDGES THE EXACT BODY THAT WAS SENT, whatever the subject's later policy: a group
// created pinned to qualification/unpinned must read back pinned to exactly that, not to any member of
// the pin family -- a readback naming some attempt's branch is not the group this create made.
// PinnedPerAttempt governs only the no-op planning of an existing group.
fn readback_after_create(subject: RunnerGroupCreateSubject, listed: RunnerGroupListDecode) -> RunnerGroupCreateReadback {
  match observe_runner_group_restriction(name: subject.name, selected_workflow: subject.selected_workflow, listed: listed) {
    RunnerGroupRestrictedToWorkflow { restriction } => CreatedGroupRestricted { restriction: restriction }
    RunnerGroupRestrictionRefused { name: _, cause: RunnerGroupAbsent } =>
      CreatedGroupNotRestricted { cause: "RunnerGroupAbsentAfterCreate: the create returned success and the readback names no such group" as NonEmptyStr }
    RunnerGroupRestrictionRefused { name: n, cause: c } =>
      CreatedGroupNotRestricted { cause: join(["RunnerGroupCreateReadbackMismatch: ", n as String, ": ", runner_group_restriction_refusal_text(cause: c)], "") as NonEmptyStr }
  }
}
