module gunbc.runner.runner_spec_from_offer

import extdeps.github.actions { RunnerSpec, SelfHosted, self_hosted_provenance_label, runner_os_label, runner_arch_label, self_hosted_labels }
import gunbc.ci.ci_fleet { ComputeOffer, gunbc_ci_fleet_offer }
import gunbc.fleet.fleet_intent { compute_host_primary_cpu, PrimaryCpuMeasured, PrimaryCpuAbsentFromSurvey, PrimaryCpuCensusUnread }
import extdeps.cpu { cpu_facts_architecture }
import extdeps.toolchain.types { Architecture }
import std.os.types { KernelFamily, Linux }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE FLEET OFFER'S LABELS, spelled apart from RunnerSpec because the restricted-group selection needs
// them WITHOUT going through the sum: an offer's execution facts - its kernel and its primary cpu -
// produce SELF-HOSTED labels by construction, so "what if the fleet offer projected a hosted spec?" is
// not a question this type can answer, it is a question that cannot be asked. That is why joining a
// runner group is a label concat here rather than a match over RunnerSpec with a fallback arm: a fallback
// there would invent a spec, and an earlier one did (it dropped every label the offer described and
// published a self-hosted spec whose only label was the group name - a runs-on matching nothing the offer
// said, gunbc.design_argument::fail_closed's fabricated default).
fn runner_self_hosted_labels_from_offer(offer: ComputeOffer) -> List<String> {
  let os = offer.supply.execution.os
  match compute_host_primary_cpu(host: offer.supply.physical) {
    // NO ARCH LABEL EITHER WAY, FOR TWO DIFFERENT REASONS. A surveyed host with no CPU row has no architecture to
    // name; an UNSURVEYED host has no architecture anyone has read. Both publish the narrower label set rather than
    // inventing one (gunbc.design_argument::fail_closed), and the standing keeps the two distinguishable upstream.
    PrimaryCpuAbsentFromSurvey { host: _ } => concat([self_hosted_provenance_label], [runner_os_label(kernel: os.kernel)])
    PrimaryCpuCensusUnread { host: _ } => concat([self_hosted_provenance_label], [runner_os_label(kernel: os.kernel)])
    PrimaryCpuMeasured { cpu: cpu } => self_hosted_labels(kernel: os.kernel, arch: cpu_facts_architecture(cpu: cpu), custom: [])
  }
}

fn runner_spec_from_offer(offer: ComputeOffer) -> RunnerSpec {
  SelfHosted { labels: runner_self_hosted_labels_from_offer(offer: offer) }
}

data gunbc_ci_runner_spec_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "\u{1f7e1} dissolve-on: CUT D of the fabric recut, WITH A PRECONDITION THAT DOES NOT EXIST YET. This is the pre-seam direct projection of the CI runner spec. gunbc.ci.ci_runner_target is the selection authority and gunbc_ci_selected_runner_spec is its projection; since Cut C no CI workflow emitter calls this function, and it is NOT a second answer to prefer at a CI call site. Its remaining callers are ci_runner_target_spec's FleetSelfHosted arm, test.claim.ci.ci_runner_target_witness (which asserts the two are equal and is what makes that equality a fact rather than a hope), and gunbc.fleet.fleet_converge_workflow, which is deliberately NOT migrated to the CI seam: which machine runs CI and which machine converges the fleet are two different questions whose answers merely coincide today, and routing fleet convergence through a selection row designed to be flipped would let a cloud-runner flip send the converger to a machine that cannot reach the hosts it converges (operator ruling 2026-08-19). CONSEQUENCE FOR CUT D: D classifies runner_spec_from_offer as an execution-environment consumer and re-sources the FleetSelfHosted derivation from an execution class, but it cannot delete this function while fleet convergence still calls it, so fleet convergence needs its own fleet-derived runner authority first. That precondition is recorded in the recut program, not built here. UNBOUND rather than bound to a DeclarationAppears trigger deliberately: neither Cut D's execution-class declaration nor the fleet runner authority exists yet, and naming a symbol that has never been declared is the fabricated-citation class (gunbc.design_argument::single_authority), which cost this lane real work twice on 2026-08-19. It binds when those declarations land.")

fn gunbc_ci_runner_spec() -> RunnerSpec {
  runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

// THE CI BUILD POOL'S OWN CPU ARCHITECTURE LABEL, read from the model -- the pool is not arm64 by fiat.
// The fleet-converge build job compares this to a host-bound run's executor arch (gunbc.fleet.machine_board
// fleet_converge_runner_arch_label, published by the plan-revision job as `arch`): on the pool when they
// agree (srv1-srv4 arm64 builds keep the fast pool), on the executor host when they differ (an x86 executor
// such as ken gets bins built for its own arch). Absent when the pool host has no surveyed primary CPU.
// THE CI POOL'S ARCHITECTURE, from the survey -- the enum, so a comparison against the executor host's
// arch (fleet_converge_runner_arch) is enum-vs-enum, never rendered strings (clever-raven-401 ruling).
fn gunbc_ci_pool_runner_arch() -> Architecture? {
  match compute_host_primary_cpu(host: gunbc_ci_fleet_offer.supply.physical) {
    PrimaryCpuMeasured { cpu } => Present { value: cpu_facts_architecture(cpu: cpu) }
    PrimaryCpuAbsentFromSurvey { host: _ } => Absent
    PrimaryCpuCensusUnread { host: _ } => Absent
  }
}

fn gunbc_ci_pool_runner_arch_label() -> String? {
  match gunbc_ci_pool_runner_arch() {
    Absent => Absent
    Present { value: architecture } => Present { value: runner_arch_label(arch: architecture) }
  }
}

// THE BUILD JOB'S RUNNER FOR A HOST-BOUND RUN, decided ONCE by the one rule (the manager co-owned
// design, msg_824e7b84). When the executor host's architecture EQUALS the CI pool's architecture the
// fast pool builds the software; when they DIFFER the executor host builds natively, so the binaries it
// installs match its own architecture -- this is what lets ken, an x86_64 host, get x86_64 bins instead
// of queueing forever for an arm64 runner that no longer names it. The comparison is Architecture-enum
// to Architecture-enum, NEVER a rendered label string: two spellings that mean the same arch compare
// equal as enums and would not as strings, and the enum is the single source the label is derived from.
// The executor host's own labels are built by self_hosted_labels -- the same single author the host
// runner job and the pool labels use -- so "the executor host's runner labels" is authored in one place,
// not restated here. Absent when EITHER the pool or the executor has no architecture the fleet can
// establish: there is no honest default runner, so the caller refuses rather than borrowing the old
// hard-coded arm64 (gunbc.design_argument::fail_closed). resolve_executor_arch and the machine_board
// witness claim both call THIS so the rule cannot be stated twice.
fn gunbc_ci_build_runner_spec(exec_arch: Architecture, host_text: String) -> RunnerSpec? {
  match gunbc_ci_pool_runner_arch() {
    Absent => Absent
    Present { value: pool } =>
      if exec_arch == pool
        then Present { value: gunbc_ci_runner_spec() }
        else Present { value: SelfHosted { labels: self_hosted_labels(kernel: Linux, arch: exec_arch, custom: [host_text]) } }
  }
}
