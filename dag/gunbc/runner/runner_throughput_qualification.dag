import std.integer { int_to_decimal_string }

// A RUNNER-THROUGHPUT ASSESSMENT SAYS WHETHER A SELECTED OFFER DELIVERS, AND NOTHING ELSE.
//
// Mt. Collins unit 1 booted under the modeled approval gate (the census lane's boot 22). Booting
// is not qualifying: a host that reaches userspace with 160 threads and 250 GiB has established
// nothing about how much fleet work it can carry, and the fleet's capacity vocabulary must not be
// allowed to read a hardware census as a capacity class.
//
// SELECTION PRECEDES THE ASSESSMENT (DESIGN section 3d; operator hold on gunbc#11722, 2026-09-19).
// The selected offer, the requirements the offer is claimed to deliver, the selected conserving
// host allocation, the selected slot, the sampling policy and the baseline wall allowance are INPUTS --
// `SelectedRunnerQualification` -- chosen by the fleet before any run and projected from the
// fleet's own authorities by `gunbc.runner.runner_throughput_selection`, which also carries the
// independently selected `ExecutorSanction` the fabric admits on. This module mints none of them:
// an earlier draft derived the sanction and the supply row FROM the assessment, which reversed
// `gunbc.fabric.fabric_executor_class`'s meaning (a sanction is permission decided before fungibility,
// not a performance conclusion) and let the same fast run be labelled either class. What this
// module produces is an assessment bound to that exact selection, and the fabric's existing
// admission -- `product.fabric.capacity_admission admit_delivered_offer` through
// `product.fabric.node_qualification OfferClaimsRunnerDelivery` -- joins policy and qualification.
//
// WHY THIS MODULE IS A LEAF AND THE SELECTION MODULE IS NOT. product.fabric.node_qualification
// imports this module for the assessment type, so this module's import closure joins the fabric's.
// Measured on the seed at gunbc#11722 (2026-09-20): adding an import edge from that closure to
// gunbc.build_cache.build_cache_instance -- through gunbc.runner.runner_slot_allocation, gunbc.fleet.fleet_host_budget or
// gunbc.fabric.fabric_executor_class, each already reachable in the closure by other paths -- makes
// gunbc.harness.harness_backend's bare `split` and `last` fail to resolve, with the module set
// unchanged. That is a seed resolution defect reported to the parent lane, not a modeling fact, and
// this module routes around it: the fleet authorities are consumed one module up and projected
// into the carriers below, so the sealed record and the fold stay reachable from the fabric.
// DECLARED DEPARTURE (DESIGN section 3b), not silence: the split exists for that defect and for
// nothing else, and it is owned by dashboard work item adhoc-3bd6c9ef-59c ("seed: import-edge
// shape changes bare algebra-template receiver inference in an unrelated module", eager-owl-205);
// when that lane names the mechanism and lands its red, this annotation retires and the split is
// reconsidered.
//
// THE OBSERVED RUN IS PRODUCER-OWNED AND SEALED. `ObservedRunnerQualificationRun` carries every
// identity the assessment joins on -- host, program, revision, image and runtime, slot unit and
// incarnation, the EFFECTIVE unit properties read back, every subject step's wall and memory receipt
// (whose limit is the bound), the workspace locus as READ -- and nothing in it is copied from the selection.
// It is `sole_constructor`: only `observed_run` mints one, and the producer that will call it is a
// declared frontier below. The assessment is `sole_constructor` too, minted only by
// `assess_runner_throughput`, whose first act is the SUBJECT JOIN: a run from another host,
// another program with the same step count, another cgroup, an NVMe-backed workspace, or a unit
// whose effective bound is not the selected bound is refused by name on the axis that differs.
// An admitted disposition cannot be authored: there is no constructor for it outside this module.
//
// NOTHING HERE IS A NEW BENCHMARK, AND THE BASELINE IS NOT A LITERAL (operator decision A, 2026-10-27). Every
// instrument is one today's required floor already emits: each subject step's wall from the job record and its
// gunbc test memory receipt. Walls are judged against the SAME steps of the same revision run on an existing fleet host
// (FleetBaselineRun), under an allowance the selection supplies as policy. The conclusion is NARROWED to what is
// assessed (`assessed_facts`): the slot memory envelope over every step and every step's wall against the baseline.
//
// EACH AXIS IS THREE-VALUED, AS product.fabric.node_qualification RULES: holds with the numbers,
// falls short with the numbers, or unread. Unread is never agreement and there is no Bool that
// answers false for it. Sampling is a supplied policy and aggregation is conservative per axis --
// minimum width, maximum peak and wall, unread dominating -- so no single internally
// chosen run speaks for axes it did not measure.

// ── THE WORKLOAD: TODAY'S FLOOR AT A PINNED REVISION ─────────────────────────────────────────
//
// `program` names the producer (gunbc.fabric.fabric_witness_run floor_work_contract names the same one) and
// `revision` pins the corpus it walked. Two runs differing in either measured different work. The floor is the
// required job's own work (gunbc.runner.runner_qualification_floor_job): a seed build, then one gunbc test step per
// gunbc.emitted_subject_build_gate emitted_subject_build_rows row. The withdrawn floor's calibration specimen is gone
// with it (gunbc.plans.mtcollins1_ci_service_legs G3, operator decision A).
type FloorWorkloadPin {
  program: NonEmptyStr
  revision: CommitSha
}

// THE RUNTIME THE WORKLOAD RAN IN IS SELECTED, NOT MERELY OBSERVED. The pin says what work ran; this
// says what it ran IN -- the runner image by its measured digest and the toolchain closure inside it.
// Two runs of one pinned workload in different images measured different subjects, so both are join
// axes; before this carrier existed the observed run carried both and nothing compared them.
type SelectedRunnerRuntime {
  image_digest: NonEmptyStr
  runtime_closure: NonEmptyStr
}

// WHERE THE WORKSPACE BYTES LAND IS ONE FACT WITH THREE ANSWERS. The selection DECLARES a backing;
// the observed run carries the locus as READ; the join compares them. On a diskless live host a
// tmpfs workspace is charged to the cgroup that faults its pages in, so the peak is
// workspace-inclusive, and a peak taken over NVMe is a different number for the same work.
type WorkspaceBacking
  = RamBackedTmpfs
  | HostLocalDisk
  | PeerScratchExport { peer: HostIdentity }

type WorkspaceBytesLocus
  = OnSubjectChargedToSlot
  | OnSubjectUncharged
  | OffSubject { peer: HostIdentity }

fn workspace_bytes_locus(backing: WorkspaceBacking) -> WorkspaceBytesLocus {
  match backing {
    RamBackedTmpfs => OnSubjectChargedToSlot
    HostLocalDisk => OnSubjectUncharged
    PeerScratchExport { peer: p } => OffSubject { peer: p }
  }
}

fn workspace_locus_eq(a: WorkspaceBytesLocus, b: WorkspaceBytesLocus) -> Bool {
  match a {
    OnSubjectChargedToSlot => match b { OnSubjectChargedToSlot => true  OnSubjectUncharged => false  OffSubject { peer: _ } => false }
    OnSubjectUncharged => match b { OnSubjectChargedToSlot => false  OnSubjectUncharged => true  OffSubject { peer: _ } => false }
    OffSubject { peer: p } => match b { OnSubjectChargedToSlot => false  OnSubjectUncharged => false  OffSubject { peer: q } => (p as String) == (q as String) }
  }
}

// ── THE INSTRUMENT READINGS, ONE PER RUN ──────────────────────────────────────────────────────

// EACH SUBJECT STEP'S WALL AND MEMORY RECEIPT, read from the run by gunbc.runner.runner_qualification_subject_readings
// (SubjectStepReading): the step's own start and completion times from the job record, and the receipt gunbc test
// printed at the step's bounding cgroup. The withdrawn floor's per-phase walls over required_ci_phases, its eval-step
// count and its calibration rate are deleted, not carried unread (operator decision A, 2026-10-27).

// THE UNIT'S PROPERTIES AS systemd REPORTS THEM AFTER THE RUN STARTED -- what bound the run, as
// opposed to what was asked for. The join compares them to the selected slot. THE CPU QUOTA IS
// CARRIED AS A PROJECTION of gunbc.runner.runner_slot_desired RunnerSlotCpuQuota: a thread count when
// a ceiling is declared, absent when the fleet declares none (SlotCpuQuotaUnbounded), the same
// projection on both sides of the join; gunbc.runner.runner_throughput_selection performs it for the
// selected side, and the producer reads CPUQuotaPerSecUSec=infinity as absent for the observed.
type SlotQuotaThreads = HardwareThreadCount?

type EffectiveSlotProperties {
  memory_max: ByteSize
  memory_high: ByteSize
  tasks_max: Int
  cpu_quota_threads: SlotQuotaThreads
}

fn cpu_quota_eq(a: SlotQuotaThreads, b: SlotQuotaThreads) -> Bool {
  match a {
    Absent => match b { Absent => true Present { value: _ } => false }
    Present { value: x } =>
      match b {
        Present { value: y } => hardware_thread_count_value(t: x) == hardware_thread_count_value(t: y)
        Absent => false
      }
  }
}

// ── THE OBSERVED RUN: SEALED, PRODUCER-OWNED ──────────────────────────────────────────────────
//
// sole_constructor: no module but this one can write the record, and this module writes it in
// exactly one place, `observed_run`, from readings. The producer that will call it -- the
// collect stage of the route parsing the run's own rows -- is the frontier
// `qualification_run_producer_frontier`; when it lands, `admit_callers` on `observed_run` names
// it and the witness's fixture route closes.
type ObservedRunnerQualificationRun sole_constructor {
  run: GitHubWorkflowRunId
  attempt_label: NonEmptyStr
  observed_at: Timestamp
  host: HostIdentity
  program: NonEmptyStr
  revision: CommitSha
  image_digest: NonEmptyStr
  runtime_closure: NonEmptyStr
  slot_unit: NonEmptyStr
  incarnation: NonEmptyStr
  effective: EffectiveSlotProperties
  host_threads: HardwareThreadCount
  host_architecture: Architecture
  workspace: WorkspaceBytesLocus
  subjects: List<SubjectStepReading>
}

fn observed_run(
  run: GitHubWorkflowRunId,
  attempt_label: NonEmptyStr,
  observed_at: Timestamp,
  host: HostIdentity,
  program: NonEmptyStr,
  revision: CommitSha,
  image_digest: NonEmptyStr,
  runtime_closure: NonEmptyStr,
  slot_unit: NonEmptyStr,
  incarnation: NonEmptyStr,
  effective: EffectiveSlotProperties,
  host_threads: HardwareThreadCount,
  host_architecture: Architecture,
  workspace: WorkspaceBytesLocus,
  subjects: List<SubjectStepReading>,
) -> ObservedRunnerQualificationRun {
  ObservedRunnerQualificationRun {
    run: run, attempt_label: attempt_label, observed_at: observed_at,
    host: host, program: program, revision: revision,
    image_digest: image_digest, runtime_closure: runtime_closure,
    slot_unit: slot_unit, incarnation: incarnation, effective: effective,
    host_threads: host_threads, host_architecture: host_architecture, workspace: workspace,
    subjects: subjects,
  }
}

// ── THE SELECTION: EVERYTHING THE ASSESSMENT CONSUMES AND NEVER MINTS ─────────────────────────

// THE HOST ALLOCATION IS A RECEIPT, NOT FACTS TO RE-PLAN FROM. `gunbc.fleet.fleet_host_budget
// fleet_host_plan_for` derives the plan (refusing on unverified oomd,
// an unset headroom) and `host_allocation_verdict` says whether it conserves with the control plane
// charged; `gunbc.runner.runner_throughput_selection selected_host_allocation` projects the two into this
// carrier, admitting the slice and the effective runner CPU cap only when the plan derived AND the
// allocation conserves, and carrying the fleet's own reason otherwise. The assessment reads the
// slice and the cap off it and chooses no sibling claim of its own (hold item 4).
type SelectedHostAllocation
  = HostAllocationAdmitted { runner_slice_cap: ByteSize, effective_runner_cpu_cap: HardwareThreadCount }
  | HostAllocationRefused { cause: NonEmptyStr }

// THE SELECTED SLOT IS THE FLEET'S RunnerSlotDesired PROJECTED to the properties the join reads,
// plus the unit it will run as, and the floor's minimum viable armed budget the high line must
// clear (`gunbc_floor_minimum_viable_armed_budget`, carried by the selection module).
type SelectedSlot {
  unit: NonEmptyStr
  memory_max: ByteSize
  memory_high: ByteSize
  tasks_max: Int
  cpu_quota_threads: SlotQuotaThreads
  floor_minimum_armed_budget: ByteSize
}

// HOW MANY RUNS SPEAK, DECIDED BEFORE THE FOLD. ExactlyOneReconciledRun admits one run and refuses
// a sample of any other size; ConservativePerAxis aggregates every run per axis and refuses a
// sample below its minimum.
type SamplingPolicy
  = ExactlyOneReconciledRun
  | ConservativePerAxis { minimum_runs: Int }

// THE WALL ALLOWANCE AGAINST THE FLEET BASELINE IS POLICY THE SELECTION SUPPLIES (operator decision A): each subject
// step's wall on the subject may be at most numerator/denominator of the same step's wall on the baseline run. The
// allowance is a declared policy ratio, never a wall literal; the walls it multiplies are both observed.
type BaselineWallAllowance {
  numerator: Int
  denominator: Int
}

type SelectedRunnerQualification<P> {
  offer: SupplierOffer<P>
  host: HostIdentity
  requirements: ExecutionRequirements
  workload: FloorWorkloadPin
  runtime: SelectedRunnerRuntime
  host_allocation: SelectedHostAllocation
  slot: SelectedSlot
  workspace: WorkspaceBacking
  cores_per_slot: HardwareThreadCount
  sampling: SamplingPolicy
  wall_allowance: BaselineWallAllowance
}

// ── THE SUBJECT JOIN ──────────────────────────────────────────────────────────────────────────
//
// One axis per identity the run must share with the selection. The first axis that differs is
// the refusal; nothing downstream is computed over a run that is not the subject's.
type SubjectJoinAxis
  = HostAxis
  | ProgramAxis
  | RevisionAxis
  | ImageDigestAxis
  | RuntimeClosureAxis
  | HostThreadsAxis
  | HostArchitectureAxis
  | SlotUnitAxis
  | EffectiveMemoryMaxAxis
  | EffectiveMemoryHighAxis
  | EffectiveTasksMaxAxis
  | EffectiveCpuQuotaAxis
  | WorkspaceAxis
  | BoundAxis

fn subject_join_axis_wire(a: SubjectJoinAxis) -> String {
  match a {
    HostAxis => "host"
    ProgramAxis => "program"
    RevisionAxis => "revision"
    ImageDigestAxis => "image digest"
    RuntimeClosureAxis => "runtime closure"
    HostThreadsAxis => "host threads"
    HostArchitectureAxis => "host architecture"
    SlotUnitAxis => "slot unit"
    EffectiveMemoryMaxAxis => "effective MemoryMax"
    EffectiveMemoryHighAxis => "effective MemoryHigh"
    EffectiveTasksMaxAxis => "effective TasksMax"
    EffectiveCpuQuotaAxis => "effective CPUQuota"
    WorkspaceAxis => "workspace locus"
    BoundAxis => "cgroup bound"
  }
}

type SubjectJoin
  = SubjectJoined
  | SubjectJoinRefused { run: GitHubWorkflowRunId, axis: SubjectJoinAxis, selected: String, observed: String }

fn join_axis(run: GitHubWorkflowRunId, axis: SubjectJoinAxis, holds: Bool, selected: String, observed: String) -> SubjectJoin {
  if holds { SubjectJoined } else { SubjectJoinRefused { run: run, axis: axis, selected: selected, observed: observed } }
}

fn first_refused(joins: List<SubjectJoin>) -> SubjectJoin {
  fold(joins, init: SubjectJoined, f: (acc, j) =>
    match acc {
      SubjectJoinRefused { run: _, axis: _, selected: _, observed: _ } => acc
      SubjectJoined => j
    }
  )
}

fn cpu_quota_wire(q: SlotQuotaThreads) -> String {
  match q {
    Absent => "unbounded"
    Present { value: t } => concat(nat_to_decimal_string(value: hardware_thread_count_value(t: t)), " threads")
  }
}

fn locus_wire(l: WorkspaceBytesLocus) -> String {
  match l {
    OnSubjectChargedToSlot => "on subject, charged to slot"
    OnSubjectUncharged => "on subject, uncharged"
    OffSubject { peer: p } => concat("off subject on ", p as String)
  }
}

// THE BOUND AXIS: every subject step's receipt must report the selected slot's high as the limit that bound it (the
// receipt's limit_high, read at the step's bounding cgroup). A run with no subject readings, or a step bounded by any
// other high, ran outside the subject's envelope, so nothing it measured is about the subject: a join refusal, not a
// memory standing. The comparison is of decoded limits (review 86991): `max` is CgroupMemoryUnlimited and never equals a
// byte count, whatever its spelling.
fn receipt_bound_by(limit: CgroupMemoryLimitValue, high: ByteSize) -> Bool {
  match limit {
    CgroupMemoryLimited { bytes: b } => byte_size_count(b: b) == byte_size_count(b: high)
    CgroupMemoryUnlimited => false
    CgroupMemoryLimitUnparseable { body: _ } => false
  }
}

fn bound_join<P>(selection: SelectedRunnerQualification<P>, run: ObservedRunnerQualificationRun) -> SubjectJoin {
  let want = nat_to_decimal_string(value: byte_size_count(b: selection.slot.memory_high))
  match run.subjects.first() {
    Absent => SubjectJoinRefused { run: run.run, axis: BoundAxis, selected: want, observed: "no subject step was read" }
    Present { value: _ } =>
      match run.subjects |> filter(r => !receipt_bound_by(limit: r.receipt.limit_high, high: selection.slot.memory_high)) |> first() {
        Absent => SubjectJoined
        Present { value: off } => SubjectJoinRefused { run: run.run, axis: BoundAxis, selected: want, observed: cgroup_memory_limit_kernel_text(v: off.receipt.limit_high) }
      }
  }
}

// THE HOST AXES JOIN AGAINST THE SELECTED OFFER'S OWN SHAPE: its hard thread count, and the
// architecture its CPU envelope states. An offer whose envelope states no architecture made no claim
// the run could be about, so the join refuses rather than admitting any architecture (section 5).
fn offer_architecture<P>(selection: SelectedRunnerQualification<P>) -> Architecture? {
  match selection.offer.shape.envelope.cpu {
    Absent => none
    Present { value: c } => c.architecture
  }
}

// THE JOIN DECIDES ON THE OPTIONAL, NOT ON ITS SPELLING: an unstated architecture holds for no run,
// whatever the observed architecture's diagnostic name happens to be.
fn architecture_joins<P>(selection: SelectedRunnerQualification<P>, observed: Architecture) -> Bool {
  match offer_architecture(selection: selection) {
    Absent => false
    Present { value: a } => (architecture_diagnostic_name(arch: a) as String) == (architecture_diagnostic_name(arch: observed) as String)
  }
}

fn offer_architecture_wire<P>(selection: SelectedRunnerQualification<P>) -> String {
  match offer_architecture(selection: selection) {
    Absent => "unstated"
    Present { value: a } => architecture_diagnostic_name(arch: a) as String
  }
}

fn subject_join<P>(selection: SelectedRunnerQualification<P>, run: ObservedRunnerQualificationRun) -> SubjectJoin {
  let want = selection.slot
  first_refused(joins: [
    join_axis(run: run.run, axis: HostAxis, holds: (selection.host as String) == (run.host as String), selected: selection.host as String, observed: run.host as String),
    join_axis(run: run.run, axis: ProgramAxis, holds: (selection.workload.program as String) == (run.program as String), selected: selection.workload.program as String, observed: run.program as String),
    join_axis(run: run.run, axis: RevisionAxis, holds: selection.workload.revision == run.revision, selected: selection.workload.revision, observed: run.revision),
    join_axis(run: run.run, axis: ImageDigestAxis, holds: (selection.runtime.image_digest as String) == (run.image_digest as String), selected: selection.runtime.image_digest as String, observed: run.image_digest as String),
    join_axis(run: run.run, axis: RuntimeClosureAxis, holds: (selection.runtime.runtime_closure as String) == (run.runtime_closure as String), selected: selection.runtime.runtime_closure as String, observed: run.runtime_closure as String),
    join_axis(run: run.run, axis: HostThreadsAxis, holds: hardware_thread_count_value(t: selection.offer.shape.hard.threads) == hardware_thread_count_value(t: run.host_threads), selected: nat_to_decimal_string(value: hardware_thread_count_value(t: selection.offer.shape.hard.threads)), observed: nat_to_decimal_string(value: hardware_thread_count_value(t: run.host_threads))),
    join_axis(run: run.run, axis: HostArchitectureAxis, holds: architecture_joins(selection: selection, observed: run.host_architecture), selected: offer_architecture_wire(selection: selection), observed: architecture_diagnostic_name(arch: run.host_architecture) as String),
    join_axis(run: run.run, axis: SlotUnitAxis, holds: (selection.slot.unit as String) == (run.slot_unit as String), selected: selection.slot.unit as String, observed: run.slot_unit as String),
    join_axis(run: run.run, axis: EffectiveMemoryMaxAxis, holds: byte_size_count(b: want.memory_max) == byte_size_count(b: run.effective.memory_max), selected: nat_to_decimal_string(value: byte_size_count(b: want.memory_max)), observed: nat_to_decimal_string(value: byte_size_count(b: run.effective.memory_max))),
    join_axis(run: run.run, axis: EffectiveMemoryHighAxis, holds: byte_size_count(b: want.memory_high) == byte_size_count(b: run.effective.memory_high), selected: nat_to_decimal_string(value: byte_size_count(b: want.memory_high)), observed: nat_to_decimal_string(value: byte_size_count(b: run.effective.memory_high))),
    join_axis(run: run.run, axis: EffectiveTasksMaxAxis, holds: want.tasks_max == run.effective.tasks_max, selected: int_to_decimal_string(value: want.tasks_max), observed: int_to_decimal_string(value: run.effective.tasks_max)),
    join_axis(run: run.run, axis: EffectiveCpuQuotaAxis, holds: cpu_quota_eq(a: want.cpu_quota_threads, b: run.effective.cpu_quota_threads), selected: cpu_quota_wire(q: want.cpu_quota_threads), observed: cpu_quota_wire(q: run.effective.cpu_quota_threads)),
    join_axis(run: run.run, axis: WorkspaceAxis, holds: workspace_locus_eq(a: workspace_bytes_locus(backing: selection.workspace), b: run.workspace), selected: locus_wire(l: workspace_bytes_locus(backing: selection.workspace)), observed: locus_wire(l: run.workspace)),
    bound_join(selection: selection, run: run),
  ])
}

fn first_join_refusal<P>(selection: SelectedRunnerQualification<P>, runs: List<ObservedRunnerQualificationRun>) -> SubjectJoin {
  first_refused(joins: map(runs, r => subject_join(selection: selection, run: r)))
}

// ── THREE-VALUED STANDINGS, ONE PER AXIS ──────────────────────────────────────────────────────

// THE SLOT ENVELOPE MUST HOLD THE FLOOR TWICE OVER: its high line must sit at or above
// `gunbc_floor_minimum_viable_armed_budget` (or the executor refuses to arm at all), and the
// MAXIMUM peak over every subject step of every run must sit within that line, or a step was held by the throttle
// rather than measured -- the censored-lower-bound lesson `gunbc.runner.runner_slot_allocation` records. AND EVERY STEP'S
// ENVELOPE MUST HAVE HELD (operator decision A, the RED): a receipt that reports the envelope violated, an OOM kill the
// step added or any swap refuses the qualification whatever its peak, naming the subject.
type MemoryEnvelopeStanding
  = PeakWithinSlotHigh { peak: ByteSize, high: ByteSize }
  | PeakExceedsSlotHigh { peak: ByteSize, high: ByteSize }
  | SlotHighBelowFloorMinimum { high: ByteSize, minimum: ByteSize }
  | MemoryEnvelopeViolatedAt { subject: NonEmptyStr, verdict: MemoryEnvelopeVerdict }
  | MemoryReceiptDisagreesAt { subject: NonEmptyStr, printed_violated: Bool, verdict: MemoryEnvelopeVerdict }
  | MemoryUnread { reason: NonEmptyStr }

// THE SUBJECT ROSTER IS AN IDENTITY JOIN, NOT A COUNT: every emitted subject row read exactly once in every run.
type SubjectRosterStanding
  = SubjectRosterComplete
  | SubjectMissing { subject: NonEmptyStr }
  | SubjectDuplicated { subject: NonEmptyStr }
  | SubjectRosterNotAssessed { because: NonEmptyStr }

// THE BASELINE IS OBSERVED, NEVER A LITERAL (operator decision A): a run of the same subject rows at the same revision
// on an existing fleet host, read through the same decoder (gunbc.runner.runner_qualification_subject_readings) and
// sealed here. sole_constructor: only observed_baseline mints one, from readings.
type FleetBaselineRun sole_constructor {
  run: GitHubWorkflowRunId
  host: HostIdentity
  revision: CommitSha
  slot_unit: NonEmptyStr
  subjects: List<SubjectStepReading>
}

fn observed_baseline(run: GitHubWorkflowRunId, host: HostIdentity, revision: CommitSha, slot_unit: NonEmptyStr, subjects: List<SubjectStepReading>) -> FleetBaselineRun {
  FleetBaselineRun { run: run, host: host, revision: revision, slot_unit: slot_unit, subjects: subjects }
}

// EACH SUBJECT STEP'S WALL ON THE SUBJECT, AGAINST THE SAME STEP ON THE BASELINE UNDER THE SELECTED ALLOWANCE. The
// subject's wall is the maximum over the sample (conservative per axis). A baseline that is not about the same work --
// taken on the subject host itself, at another revision, or missing a subject -- is not a baseline, and refuses.
type SubjectWallStanding
  = SubjectWallsWithinBaseline
  | SubjectWallExceedsBaseline { subject: NonEmptyStr, wall: Second, baseline: Second, allowance: BaselineWallAllowance }
  | BaselineOnTheSubjectHost { host: HostIdentity }
  | BaselineAtAnotherRevision { selected: CommitSha, baseline: CommitSha }
  | BaselineMissingSubject { subject: NonEmptyStr }
  | BaselineAllowanceMalformed { allowance: BaselineWallAllowance }
  | SubjectWallsNotAssessed { because: NonEmptyStr }

// THE SLOT COUNT IS READ OFF THE SELECTED ALLOCATION: its runner slice over the selected slot's
// MemoryMax, and its effective runner CPU cap over the fleet's cores-per-slot policy; the minimum
// commits. A refused allocation (unsound plan, unchargeable or oversubscribed) derives no width.
type SlotWidthStanding
  = SlotWidthDerived { by_memory: Int, by_cpu: Int, slots: Int }
  | SlotWidthUnderivable { cause: NonEmptyStr }

fn subject_label(row: EmittedSubjectBuildRow) -> NonEmptyStr {
  emitted_subject_build_label_text(row: row) as NonEmptyStr
}

fn reading_is_row(r: SubjectStepReading, row: EmittedSubjectBuildRow) -> Bool {
  (subject_label(row: r.row) as String) == (subject_label(row: row) as String)
}

fn run_roster_standing(run: ObservedRunnerQualificationRun, rows: List<EmittedSubjectBuildRow>) -> SubjectRosterStanding {
  fold(rows, init: SubjectRosterComplete, f: (acc, row) =>
    match acc {
      SubjectRosterComplete => {
        let n = count(run.subjects |> filter(r => reading_is_row(r: r, row: row)))
        if n == 0 { SubjectMissing { subject: subject_label(row: row) } } else if n > 1 { SubjectDuplicated { subject: subject_label(row: row) } } else { acc }
      }
      SubjectMissing { subject: _ } => acc
      SubjectDuplicated { subject: _ } => acc
      SubjectRosterNotAssessed { because: _ } => acc
    })
}

fn subject_roster_standing(runs: List<ObservedRunnerQualificationRun>, rows: List<EmittedSubjectBuildRow>) -> SubjectRosterStanding {
  fold(runs, init: SubjectRosterComplete, f: (acc, r) =>
    match acc {
      SubjectRosterComplete => run_roster_standing(run: r, rows: rows)
      SubjectMissing { subject: _ } => acc
      SubjectDuplicated { subject: _ } => acc
      SubjectRosterNotAssessed { because: _ } => acc
    })
}

fn peak_standing(peak: ByteSize, envelope: SelectedSlot) -> MemoryEnvelopeStanding {
  if byte_size_count(b: peak) < byte_size_count(b: envelope.memory_high) {
    PeakWithinSlotHigh { peak: peak, high: envelope.memory_high }
  } else {
    PeakExceedsSlotHigh { peak: peak, high: envelope.memory_high }
  }
}

fn max_subject_peak(runs: List<ObservedRunnerQualificationRun>) -> Nat {
  fold(runs, init: byte_size_count(b: byte_size(count: 0)), f: (acc, r) => fold(r.subjects, init: acc, f: (inner, s) => {
    let p = byte_size_count(b: s.receipt.peak)
    if p > inner { p } else { inner }
  }))
}

// THE FIRST SUBJECT WHOSE RECEIPT DID NOT HOLD, CARRYING WHY (review 86993): a violated envelope and a receipt whose
// printed sentence disagrees with its own numbers are different findings, so each keeps its own standing and verdict.
fn subject_receipt_refusal(s: SubjectStepReading) -> MemoryEnvelopeStanding? {
  match memory_receipt_standing(r: s.receipt) {
    MemoryReceiptHeld => none
    MemoryReceiptViolated { verdict: v } => Present { value: MemoryEnvelopeViolatedAt { subject: subject_label(row: s.row), verdict: v } }
    MemoryReceiptSentenceDisagrees { printed_violated: p, verdict: v } => Present { value: MemoryReceiptDisagreesAt { subject: subject_label(row: s.row), printed_violated: p, verdict: v } }
  }
}

fn first_unheld_receipt(runs: List<ObservedRunnerQualificationRun>) -> MemoryEnvelopeStanding? {
  fold(runs, init: none, f: (acc, r) =>
    fold(r.subjects, init: acc, f: (inner, s) =>
      match inner {
        Present { value: _ } => inner
        Absent => subject_receipt_refusal(s: s)
      }))
}

fn aggregate_memory(envelope: SelectedSlot, runs: List<ObservedRunnerQualificationRun>) -> MemoryEnvelopeStanding {
  let high = byte_size_count(b: envelope.memory_high)
  let minimum = byte_size_count(b: envelope.floor_minimum_armed_budget)
  if high < minimum {
    SlotHighBelowFloorMinimum { high: envelope.memory_high, minimum: envelope.floor_minimum_armed_budget }
  } else if count(runs) == 0 || (runs |> any(r => count(r.subjects) == 0)) {
    MemoryUnread { reason: "a run in the sample carries no subject step, so no memory receipt was read" as NonEmptyStr }
  } else {
    match first_unheld_receipt(runs: runs) {
      Present { value: refused } => refused
      Absent => peak_standing(peak: byte_size(max_subject_peak(runs: runs)), envelope: envelope)
    }
  }
}

fn max_subject_wall(runs: List<ObservedRunnerQualificationRun>, row: EmittedSubjectBuildRow) -> Nat {
  fold(runs, init: second_count(second(count: 0)), f: (acc, r) => fold(r.subjects |> filter(s => reading_is_row(r: s, row: row)), init: acc, f: (inner, s) => {
    let w = second_count(s.wall)
    if w > inner { w } else { inner }
  }))
}

fn baseline_wall(baseline: FleetBaselineRun, row: EmittedSubjectBuildRow) -> Second? {
  match baseline.subjects |> filter(s => reading_is_row(r: s, row: row)) |> first() {
    Absent => none
    Present { value: s } => Present { value: s.wall }
  }
}

fn subject_wall_standing<P>(selection: SelectedRunnerQualification<P>, runs: List<ObservedRunnerQualificationRun>, baseline: FleetBaselineRun, rows: List<EmittedSubjectBuildRow>) -> SubjectWallStanding {
  let allowance = selection.wall_allowance
  if (baseline.host as String) == (selection.host as String) {
    BaselineOnTheSubjectHost { host: baseline.host }
  } else if baseline.revision != selection.workload.revision {
    BaselineAtAnotherRevision { selected: selection.workload.revision, baseline: baseline.revision }
  } else if allowance.numerator < 1 || allowance.denominator < 1 {
    BaselineAllowanceMalformed { allowance: allowance }
  } else {
    fold(rows, init: SubjectWallsWithinBaseline, f: (acc, row) =>
      match acc {
        SubjectWallsWithinBaseline =>
          match baseline_wall(baseline: baseline, row: row) {
            Absent => BaselineMissingSubject { subject: subject_label(row: row) }
            Present { value: b } => {
              let observed = max_subject_wall(runs: runs, row: row)
              if (observed as Int) * allowance.denominator > (second_count(b) as Int) * allowance.numerator {
                SubjectWallExceedsBaseline { subject: subject_label(row: row), wall: second(count: observed), baseline: b, allowance: allowance }
              } else {
                acc
              }
            }
          }
        _ => acc
      })
  }
}

fn qualify_slot_width<P>(selection: SelectedRunnerQualification<P>) -> SlotWidthStanding {
  match selection.host_allocation {
    HostAllocationRefused { cause: c } => SlotWidthUnderivable { cause: c }
    HostAllocationAdmitted { runner_slice_cap: slice, effective_runner_cpu_cap: cpu_cap } => {
      let per_slot_threads = hardware_thread_count_value(t: selection.cores_per_slot)
      let per_slot_bytes = byte_size_count(b: selection.slot.memory_max)
      if per_slot_threads == 0 || per_slot_bytes == 0 {
        SlotWidthUnderivable { cause: "the selected slot admits zero threads or zero bytes per slot, so no width divides" as NonEmptyStr }
      } else {
        let by_memory = byte_size_count(b: slice) / per_slot_bytes
        let by_cpu = hardware_thread_count_value(t: cpu_cap) / per_slot_threads
        SlotWidthDerived { by_memory: by_memory, by_cpu: by_cpu, slots: if by_cpu < by_memory { by_cpu } else { by_memory } }
      }
    }
  }
}

// ── CONCURRENCY: THE WIDTH IS OBSERVED, NOT ONLY DIVIDED ──────────────────────────────────────
//
// qualify_slot_width DIVIDES the admitted slice and CPU cap by the slot shape; that says how many
// slots the host's budget admits, and nothing about whether that many ran at once and each did its
// work. Delivering at a width therefore needs a sealed concurrent cohort AT that width
// (product.capacity.cohort_observation): exactly `slots` seats, all active at one instant, each seat
// one of the assessed runs -- so every seat is the subject and was measured -- and each seat's work
// settled as a success. Repeatability sampling (SamplingPolicy) is a different question and stays
// separate: N runs one after another establish a rate, not a width.
type RunnerCohortEvidence
  = NoCohortObserved
  | CohortObserved { seal: CohortSeal<GitHubWorkflowRunId> }

type ConcurrencyStanding
  = ConcurrencyObservedAtWidth { population: Int }
  | ConcurrencyUnobserved
  | ConcurrencyCohortRefused { cause: NonEmptyStr }
  | ConcurrencyPopulationIsNotTheWidth { population: Int, width: Int }
  | ConcurrencySeatNotAnAssessedRun { seat: GitHubWorkflowRunId }
  | ConcurrencySeatFailed { seat: GitHubWorkflowRunId, cause: NonEmptyStr }
  | ConcurrencyNotAssessed { because: NonEmptyStr }

fn run_key(r: GitHubWorkflowRunId) -> String { github_workflow_run_id_wire_text(id: r) }

type SeatStanding
  = SeatsHold
  | SeatStandingRefused { standing: ConcurrencyStanding }

fn qualify_concurrency(cohort: RunnerCohortEvidence, runs: List<ObservedRunnerQualificationRun>, width: SlotWidthStanding) -> ConcurrencyStanding {
  match width {
    SlotWidthUnderivable { cause: c } => ConcurrencyNotAssessed { because: concat("no width to observe: ", c as String) as NonEmptyStr }
    SlotWidthDerived { by_memory: _, by_cpu: _, slots: slots } =>
      match cohort {
        NoCohortObserved => ConcurrencyUnobserved
        CohortObserved { seal: seal } =>
          match seal {
            CohortRefused { refusal: r } => ConcurrencyCohortRefused { cause: cohort_refusal_wire(r: r, seat_key: run_key) as NonEmptyStr }
            CohortSealed { cohort: c } => {
              let assessed = fold(runs, init: empty_map(), f: fn(m, r) { map_insert(m: m, key: run_key(r: r.run), value: true) })
              let seats = fold(c.seats, init: SeatsHold, f: (acc, w) =>
                match acc {
                  SeatStandingRefused { standing: _ } => acc
                  SeatsHold =>
                    match map_lookup(m: assessed, key: run_key(r: w.seat)) {
                      Absent => SeatStandingRefused { standing: ConcurrencySeatNotAnAssessedRun { seat: w.seat } }
                      Present { value: _ } =>
                        match w.settled {
                          SeatSucceeded => SeatsHold
                          SeatFailed { cause: why } => SeatStandingRefused { standing: ConcurrencySeatFailed { seat: w.seat, cause: why } }
                        }
                    }
                })
              match seats {
                SeatStandingRefused { standing: st } => st
                SeatsHold =>
                  if c.population == slots { ConcurrencyObservedAtWidth { population: c.population } }
                  else { ConcurrencyPopulationIsNotTheWidth { population: c.population, width: slots } }
              }
            }
          }
      }
  }
}

fn concurrency_refusal(s: ConcurrencyStanding) -> List<ThroughputRefusal> {
  match s {
    ConcurrencyObservedAtWidth { population: _ } => []
    ConcurrencyUnobserved => [ConcurrencyDidNotHold { standing: s }]
    ConcurrencyCohortRefused { cause: _ } => [ConcurrencyDidNotHold { standing: s }]
    ConcurrencyPopulationIsNotTheWidth { population: _, width: _ } => [ConcurrencyDidNotHold { standing: s }]
    ConcurrencySeatNotAnAssessedRun { seat: _ } => [ConcurrencyDidNotHold { standing: s }]
    ConcurrencySeatFailed { seat: _, cause: _ } => [ConcurrencyDidNotHold { standing: s }]
    ConcurrencyNotAssessed { because: _ } => [ConcurrencyDidNotHold { standing: s }]
  }
}

fn concurrency_standing_wire(s: ConcurrencyStanding) -> String {
  match s {
    ConcurrencyObservedAtWidth { population: n } => concat("a concurrent cohort of ", concat(int_to_decimal_string(value: n), " seats was observed at the width"))
    ConcurrencyUnobserved => "no concurrent cohort was observed, so the width is divided, not observed"
    ConcurrencyCohortRefused { cause: c } => concat("the concurrent cohort was refused: ", c as String)
    ConcurrencyPopulationIsNotTheWidth { population: n, width: w } => join(["the cohort ran ", int_to_decimal_string(value: n), " seats but the derived width is ", int_to_decimal_string(value: w)], "")
    ConcurrencySeatNotAnAssessedRun { seat: r } => concat("a cohort seat is not one of the assessed runs: ", run_key(r: r))
    ConcurrencySeatFailed { seat: r, cause: c } => join(["cohort seat ", run_key(r: r), " failed: ", c as String], "")
    ConcurrencyNotAssessed { because: b } => concat("concurrency not assessed: ", b as String)
  }
}

// ── THE REFUSALS ──────────────────────────────────────────────────────────────────────────────

type ThroughputRefusal
  = SubjectJoinDidNotHold { join: SubjectJoin }
  | SamplingDidNotHold { policy: SamplingPolicy, observed_runs: Int }
  | MemoryEnvelopeDidNotHold { standing: MemoryEnvelopeStanding }
  | SubjectRosterDidNotHold { standing: SubjectRosterStanding }
  | SubjectWallDidNotHold { standing: SubjectWallStanding }
  | SlotWidthDidNotHold { standing: SlotWidthStanding }
  | ConcurrencyDidNotHold { standing: ConcurrencyStanding }

fn sampling_refusal(policy: SamplingPolicy, observed_runs: Int) -> List<ThroughputRefusal> {
  match policy {
    ExactlyOneReconciledRun => if observed_runs == 1 { [] } else { [SamplingDidNotHold { policy: policy, observed_runs: observed_runs }] }
    ConservativePerAxis { minimum_runs: m } =>
      if observed_runs >= m && observed_runs >= 1 { [] } else { [SamplingDidNotHold { policy: policy, observed_runs: observed_runs }] }
  }
}

fn memory_refusal(s: MemoryEnvelopeStanding) -> List<ThroughputRefusal> {
  match s {
    PeakWithinSlotHigh { peak: _, high: _ } => []
    PeakExceedsSlotHigh { peak: _, high: _ } => [MemoryEnvelopeDidNotHold { standing: s }]
    SlotHighBelowFloorMinimum { high: _, minimum: _ } => [MemoryEnvelopeDidNotHold { standing: s }]
    MemoryEnvelopeViolatedAt { subject: _, verdict: _ } => [MemoryEnvelopeDidNotHold { standing: s }]
    MemoryReceiptDisagreesAt { subject: _, printed_violated: _, verdict: _ } => [MemoryEnvelopeDidNotHold { standing: s }]
    MemoryUnread { reason: _ } => [MemoryEnvelopeDidNotHold { standing: s }]
  }
}

fn subject_roster_refusal(s: SubjectRosterStanding) -> List<ThroughputRefusal> {
  match s {
    SubjectRosterComplete => []
    SubjectMissing { subject: _ } => [SubjectRosterDidNotHold { standing: s }]
    SubjectDuplicated { subject: _ } => [SubjectRosterDidNotHold { standing: s }]
    SubjectRosterNotAssessed { because: _ } => [SubjectRosterDidNotHold { standing: s }]
  }
}

fn subject_wall_refusal(s: SubjectWallStanding) -> List<ThroughputRefusal> {
  match s {
    SubjectWallsWithinBaseline => []
    SubjectWallExceedsBaseline { subject: _, wall: _, baseline: _, allowance: _ } => [SubjectWallDidNotHold { standing: s }]
    BaselineOnTheSubjectHost { host: _ } => [SubjectWallDidNotHold { standing: s }]
    BaselineAtAnotherRevision { selected: _, baseline: _ } => [SubjectWallDidNotHold { standing: s }]
    BaselineMissingSubject { subject: _ } => [SubjectWallDidNotHold { standing: s }]
    BaselineAllowanceMalformed { allowance: _ } => [SubjectWallDidNotHold { standing: s }]
    SubjectWallsNotAssessed { because: _ } => [SubjectWallDidNotHold { standing: s }]
  }
}

// A WIDTH OF ZERO IS A REFUSAL, NOT A SMALL FLEET, exactly as gunbc.ci.ci_runner_placement refuses a
// zero-width host by name rather than deploying nothing to it.
fn slot_width_refusal(s: SlotWidthStanding) -> List<ThroughputRefusal> {
  match s {
    SlotWidthDerived { by_memory: _, by_cpu: _, slots: n } => if n >= 1 { [] } else { [SlotWidthDidNotHold { standing: s }] }
    SlotWidthUnderivable { cause: _ } => [SlotWidthDidNotHold { standing: s }]
  }
}

// ── THE ASSESSMENT: SEALED, MINTED ONLY HERE ─────────────────────────────────────────────────
//
// `assessed_facts` is the whole of what the claim covers: the slot memory envelope over every subject step's receipt,
// and every subject step's wall against the fleet baseline under the selected allowance, plus the concurrent cohort
// when one was observed at the width. An assessment whose subject join or sampling refused covers NOTHING and says so
// with an empty list, rather than naming facts it never computed (review 68940).
type AssessedFact
  = SlotMemoryEnvelope
  | SubjectWallsAgainstFleetBaseline
  | ConcurrentCohortAtWidth

type RunnerThroughputAssessment<P> sole_constructor {
  offer: FabricIdentity<P, OfferKey>
  host: HostIdentity
  workload: FloorWorkloadPin
  runs: List<GitHubWorkflowRunId>
  baseline: GitHubWorkflowRunId
  join: SubjectJoin
  memory: MemoryEnvelopeStanding
  subject_roster: SubjectRosterStanding
  subject_walls: SubjectWallStanding
  slot_width: SlotWidthStanding
  concurrency: ConcurrencyStanding
  assessed_facts: List<AssessedFact>
  refusals: List<ThroughputRefusal>
}

fn join_holds(j: SubjectJoin) -> Bool {
  match j {
    SubjectJoined => true
    SubjectJoinRefused { run: _, axis: _, selected: _, observed: _ } => false
  }
}

// THE SUBJECT ROWS ARE THE GATE'S OWN (gunbc.emitted_subject_build_gate emitted_subject_build_rows), the rows today's
// floor runs; the assessment is parameterized on them so a claim can supply a roster and read the join.
fn assess_runner_throughput<P>(
  selection: SelectedRunnerQualification<P>,
  runs: List<ObservedRunnerQualificationRun>,
  baseline: FleetBaselineRun,
  cohort: RunnerCohortEvidence,
) -> RunnerThroughputAssessment<P> {
  assess_runner_throughput_over(selection: selection, runs: runs, baseline: baseline, cohort: cohort, rows: emitted_subject_build_rows())
}

fn assess_runner_throughput_over<P>(
  selection: SelectedRunnerQualification<P>,
  runs: List<ObservedRunnerQualificationRun>,
  baseline: FleetBaselineRun,
  cohort: RunnerCohortEvidence,
  rows: List<EmittedSubjectBuildRow>,
) -> RunnerThroughputAssessment<P> {
  let join = first_join_refusal(selection: selection, runs: runs)
  let sampling = sampling_refusal(policy: selection.sampling, observed_runs: runs.length())
  let joined = join_holds(j: join) && sampling.length() == 0
  let not_assessed = "not assessed: the subject join or the sampling policy refused" as NonEmptyStr
  let memory = if joined { aggregate_memory(envelope: selection.slot, runs: runs) } else { MemoryUnread { reason: not_assessed } }
  let roster = if joined { subject_roster_standing(runs: runs, rows: rows) } else { SubjectRosterNotAssessed { because: not_assessed } }
  let walls = if joined { subject_wall_standing(selection: selection, runs: runs, baseline: baseline, rows: rows) } else { SubjectWallsNotAssessed { because: not_assessed } }
  let width = qualify_slot_width(selection: selection)
  let concurrency = if joined { qualify_concurrency(cohort: cohort, runs: runs, width: width) } else { ConcurrencyNotAssessed { because: not_assessed } }
  let join_refusals = if join_holds(j: join) { [] } else { [SubjectJoinDidNotHold { join: join }] }
  RunnerThroughputAssessment {
    offer: selection.offer.id,
    host: selection.host,
    workload: selection.workload,
    runs: map(runs, r => r.run),
    baseline: baseline.run,
    join: join,
    memory: memory,
    subject_roster: roster,
    subject_walls: walls,
    slot_width: width,
    concurrency: concurrency,
    assessed_facts: if joined {
      concat([SlotMemoryEnvelope, SubjectWallsAgainstFleetBaseline], match concurrency { ConcurrencyObservedAtWidth { population: _ } => [ConcurrentCohortAtWidth] _ => [] })
    } else { [] },
    refusals: concat(
      join_refusals,
      concat(
        sampling,
        concat(memory_refusal(s: memory), concat(subject_roster_refusal(s: roster), concat(subject_wall_refusal(s: walls), concat(slot_width_refusal(s: width), concurrency_refusal(s: concurrency))))),
      ),
    ),
  }
}

fn assessment_holds<P>(a: RunnerThroughputAssessment<P>) -> Bool {
  a.refusals.length() == 0
}

// ── WHAT PRODUCES A RUN: DECLARED, NOT CLAIMED ────────────────────────────────────────────────
//
// On this branch `observed_run` is called by fixtures and `assess_runner_throughput` is read by
// its witness and by product.fabric.node_qualification's delivery claim. The producer -- the
// route's collect stage parsing a real run's rows into `observed_run` -- is a frontier carried as
// one (DESIGN section 3c). A DeclarationRef to its landing would stop the parse phase today, so the
// leg names the capability the landing must be SUFFICIENT FOR (section 4b(3)).
//
// AN AUTHORITY EXISTING IS NOT A LEG BEING WIRED. A leg whose authority is implemented but has no
// production caller on the route performs nothing when the route runs, so it is its own arm:
// LegAuthorityImplemented names the authority AND the wiring still owed, at capability grain. Only
// LegWired counts toward route_is_executable; reading an implemented authority as a wired leg is
// the specification-without-execution DESIGN §5 forbids, one layer up.
type RouteLegStanding
  = LegWired { authority: DeclarationRef }
  | LegAuthorityImplemented { authority: DeclarationRef, wiring_owed: NonEmptyStr }
  | LegAwaitingAuthority { lands_with: NonEmptyStr, sufficient_for: NonEmptyStr }

fn leg_is_wired(leg: RouteLegStanding) -> Bool {
  match leg {
    LegWired { authority: _ } => true
    LegAuthorityImplemented { authority: _, wiring_owed: _ } => false
    LegAwaitingAuthority { lands_with: _, sufficient_for: _ } => false
  }
}

fn leg_authority(leg: RouteLegStanding) -> DeclarationRef? {
  match leg {
    LegWired { authority: a } => Present { value: a }
    LegAuthorityImplemented { authority: a, wiring_owed: _ } => Present { value: a }
    LegAwaitingAuthority { lands_with: _, sufficient_for: _ } => none
  }
}

data qualification_run_producer_frontier: RouteLegStanding = LegAwaitingAuthority {
  lands_with: "a collect stage on the qualification route that reads the floor job's step times and its log into gunbc.runner.runner_qualification_subject_readings subject_readings_of at the attempt unit, the unit's effective properties and the guest's idle meminfo, and mints observed_run from them; and the same reading of a named fleet host's required run of the same rows into observed_baseline" as NonEmptyStr,
  sufficient_for: "minting ObservedRunnerQualificationRuns, a FleetBaselineRun and a sealed concurrent cohort from real runs of the floor, so assess_runner_throughput is fed by execution rather than fixtures" as NonEmptyStr,
}

// ── WIRE ──────────────────────────────────────────────────────────────────────────────────────

fn nat_wire(n: Nat) -> String {
  nat_to_decimal_string(value: n)
}

fn memory_standing_wire(s: MemoryEnvelopeStanding) -> NonEmptyStr {
  match s {
    PeakWithinSlotHigh { peak: p, high: h } =>
      join(["peak ", nat_wire(n: byte_size_count(b: p)), " B within slot high ", nat_wire(n: byte_size_count(b: h))], "") as NonEmptyStr
    PeakExceedsSlotHigh { peak: p, high: h } =>
      join(["peak ", nat_wire(n: byte_size_count(b: p)), " B reaches or exceeds slot high ", nat_wire(n: byte_size_count(b: h))], "") as NonEmptyStr
    SlotHighBelowFloorMinimum { high: h, minimum: m } =>
      join(["slot high ", nat_wire(n: byte_size_count(b: h)), " B is below the floor's minimum viable armed budget ", nat_wire(n: byte_size_count(b: m))], "") as NonEmptyStr
    MemoryEnvelopeViolatedAt { subject: x, verdict: _ } => concat("the memory envelope did not hold for subject ", x as String) as NonEmptyStr
    MemoryReceiptDisagreesAt { subject: x, printed_violated: p, verdict: _ } =>
      join(["the memory receipt of subject ", x as String, if p { " prints a violation its own numbers do not show" } else { " shows a violation it did not print" }], "") as NonEmptyStr
    MemoryUnread { reason: r } => concat("memory unread: ", r as String) as NonEmptyStr
  }
}

fn subject_wall_wire(s: SubjectWallStanding) -> String {
  match s {
    SubjectWallsWithinBaseline => "every subject step's wall is within the baseline allowance"
    SubjectWallExceedsBaseline { subject: x, wall: w, baseline: b, allowance: a } =>
      join(["subject ", x as String, " wall ", nat_wire(n: second_count(w)), "s exceeds the baseline ", nat_wire(n: second_count(b)), "s times ", int_to_decimal_string(value: a.numerator), "/", int_to_decimal_string(value: a.denominator)], "")
    BaselineOnTheSubjectHost { host: h } => concat("the baseline run is on the subject host itself: ", h as String)
    BaselineAtAnotherRevision { selected: x, baseline: b } => join(["the baseline ran revision ", b as String, ", the subject runs ", x as String], "")
    BaselineMissingSubject { subject: x } => concat("the baseline carries no reading of subject ", x as String)
    BaselineAllowanceMalformed { allowance: a } => join(["the wall allowance ", int_to_decimal_string(value: a.numerator), "/", int_to_decimal_string(value: a.denominator), " is not a positive ratio"], "")
    SubjectWallsNotAssessed { because: b } => concat("subject walls not assessed: ", b as String)
  }
}

fn slot_width_wire(s: SlotWidthStanding) -> NonEmptyStr {
  match s {
    SlotWidthDerived { by_memory: m, by_cpu: c, slots: n } =>
      join(["slots ", int_to_decimal_string(value: n), " (memory admits ", int_to_decimal_string(value: m), ", cpu admits ", int_to_decimal_string(value: c), ")"], "") as NonEmptyStr
    SlotWidthUnderivable { cause: c } => concat("slot width underivable: ", c as String) as NonEmptyStr
  }
}

fn refusal_wire(r: ThroughputRefusal) -> String {
  match r {
    SubjectJoinDidNotHold { join: j } =>
      match j {
        SubjectJoined => "subject joined"
        SubjectJoinRefused { run: run, axis: a, selected: s, observed: o } =>
          join(["run ", run_key(r: run), " is not the subject on ", subject_join_axis_wire(a: a), ": selected ", s, ", observed ", o], "")
      }
    SamplingDidNotHold { policy: p, observed_runs: n } =>
      match p {
        ExactlyOneReconciledRun => join(["sampling policy wants exactly one reconciled run, observed ", int_to_decimal_string(value: n)], "")
        ConservativePerAxis { minimum_runs: m } => join(["sampling policy wants at least ", int_to_decimal_string(value: m), " runs, observed ", int_to_decimal_string(value: n)], "")
      }
    MemoryEnvelopeDidNotHold { standing: s } => memory_standing_wire(s: s) as String
    SubjectRosterDidNotHold { standing: s } =>
      match s {
        SubjectRosterComplete => "subject roster complete"
        SubjectMissing { subject: x } => concat("subject missing from the run: ", x as String)
        SubjectDuplicated { subject: x } => concat("subject read more than once: ", x as String)
        SubjectRosterNotAssessed { because: b } => concat("subject roster not assessed: ", b as String)
      }
    SubjectWallDidNotHold { standing: s } => subject_wall_wire(s: s)
    SlotWidthDidNotHold { standing: s } => slot_width_wire(s: s) as String
    ConcurrencyDidNotHold { standing: s } => concurrency_standing_wire(s: s)
  }
}

fn assessment_wire<P>(a: RunnerThroughputAssessment<P>) -> NonEmptyStr {
  if a.refusals.length() == 0 {
    join([
      "offer delivers on ", a.host as String, " from runs ", join(map(a.runs, r => run_key(r: r)), ","), ": ",
      memory_standing_wire(s: a.memory) as String, "; ", subject_wall_wire(s: a.subject_walls),
      "; ", slot_width_wire(s: a.slot_width) as String,
    ], "") as NonEmptyStr
  } else {
    join(["offer does not deliver on ", a.host as String, ": ", join(map(a.refusals, x => refusal_wire(r: x)), "; ")], "") as NonEmptyStr
  }
}

data non_fold_residue_frontier: List<FrontierRow> = [
  FrontierRow { subject: PathSubject { path: "assess_runner_throughput" }, reason: nfr_reason_typed_census_ca5ed1724b, dissolution: nfr_dissolve_owning_fold },
]
