data runner_microvm_lifecycle_realize_disposition: Disposition = SingleAuthority

// THE WET HALF OF THE microVM SLOT LIFECYCLE: THE PROCESS THE SLOT UNIT EXECS AS ITS MainPID.
//
// gunbc.runner_microvm_lifecycle owns every DECISION this controller makes and this module adds
// none. What it owns is the other half that module deliberately cannot have: reaching the host.
// Each producer below turns one host reading into one of that module's observation carriers, and
// the controller then hands those carriers to the folds that decide. A producer that decided
// anything would be a second authority for a verdict (DESIGN section 3), so none of them does:
// the arms they return are the arms that module declares.
//
// WHY THE PRODUCERS ARE SEPARATE FUNCTIONS RATHER THAN ONE OBSERVING FOLD. Each reads a different
// interface -- the kernel's cgroup hierarchy, a path's existence, systemd's kill -- and each has
// its own failure. Folding them into one would put every reading behind one refusal and lose which
// one could not be taken, which is the distinction FactUnobservable exists to carry outward to an
// operator.

// --- the recursive cgroup readback ---

// cgroup.events `populated` IS THE VERDICT AND THE WALK IS ONLY THE DETAIL, which is the whole
// reason this readback is trustworthy without a complete traversal.
//
// The admin guide documents `populated` as "1 if the cgroup OR ITS DESCENDANTS contains any live
// processes" -- so the kernel already answers the recursive question, in one read, with no walk to
// get wrong. cgroup.procs cannot: it lists the pids attached to ONE cgroup and reads empty for an
// inner node whose every process sits in a child, which is exactly the double-forked daemon moved
// one level down that gunbc.runner_microvm_lifecycle names. A hand-rolled walk asked to decide
// EMPTY would have to be complete, and an incomplete walk reporting empty is the silent narrow this
// whole lane exists to close. Here the walk cannot say empty at all: it runs only after the kernel
// has already said populated, and it exists to name the pids an operator must go look at.
//
// SO A WALK THAT RUNS OUT OF DEPTH TRUNCATES A DETAIL AND NEVER A VERDICT. The bound is real --
// recursion in this substrate is bounded and forward (DESIGN section 4) -- and what it can cost is
// a pid missing from a refusal message, never a cell released on an unread subtree.
data cgroup_walk_depth_bound: Int = 8

type CgroupWalkNode { path: NonEmptyStr, pids: List<Int> }

type CgroupWalk { nodes: List<CgroupWalkNode> }

fn cgroup_procs_path(cgroup_path: NonEmptyStr) -> NonEmptyStr {
  cgroup_v2_child_path(parent: cgroup_path, child: cgroup_v2_procs_interface_file)
}

fn cgroup_procs_pids(cgroup_path: NonEmptyStr) -> List<Int>
  uses net: Network
{
  let read = linux.CgroupV2.ReadInterfaceFile(file_path: cgroup_procs_path(cgroup_path: cgroup_path))
  if read.success == false {
    no_pids()
  } else {
    decode_cgroup_procs(body: read.value)
  }
}

fn no_pids() -> List<Int> {
  [] as List<Int>
}

fn cgroup_child_names(cgroup_path: NonEmptyStr) -> List<String>
  uses net: Network
{
  let listed = linux.CgroupV2.ListChildCgroups(cgroup_path: cgroup_path)
  if listed.success == false {
    []
  } else {
    filter(split(s: listed.value, delimiter: "\n"), n => trim(s: n) != "")
  }
}

fn walk_cgroup(cgroup_path: NonEmptyStr, depth: Int) -> CgroupWalk
  uses net: Network
{
  let here = CgroupWalkNode { path: cgroup_path, pids: cgroup_procs_pids(cgroup_path: cgroup_path) }
  if depth <= 0 {
    CgroupWalk { nodes: [here] }
  } else {
    fold(cgroup_child_names(cgroup_path: cgroup_path), init: CgroupWalk { nodes: [here] }, f: (acc, name) =>
      CgroupWalk {
        nodes: concat(
          acc.nodes,
          walk_cgroup(cgroup_path: cgroup_v2_child_path(parent: cgroup_path, child: trim(s: name) as NonEmptyStr), depth: depth - 1).nodes,
        ),
      })
  }
}

fn walk_pids(walk: CgroupWalk) -> List<Int> {
  fold(walk.nodes, init: [], f: (acc, n) => concat(acc, n.pids))
}

fn walk_populated_cgroups(walk: CgroupWalk) -> List<NonEmptyStr> {
  map(filter(walk.nodes, n => (n.pids |> count) > 0), n => n.path)
}

// A CELL WHOSE CGROUP IS NOT THERE HOLDS NO PROCESSES, and that is a reading rather than a gap.
// The kernel represents a cgroup AS a directory, so "no directory" and "no tasks under it" are one
// fact in its own representation; systemd removes an empty slice, so refusing here would quarantine
// every cell whose teardown worked. The opposite arm is the one that must never be taken by
// default: a directory that IS there and cannot be read is CgroupSubtreeReadFailed below.
// THE HIERARCHY IS CONFIRMED BEFORE AN ABSENCE IS READ AS EMPTINESS, and this is what makes the
// "no directory means no tasks" arm below sound rather than convenient. That arm is correct only
// while we are looking at a live cgroup v2 hierarchy: if the mount is gone, or something is mounted
// OVER it, every cell's path is absent and every cell reads clean. `cgroup.controllers` exists on
// every cgroup v2 node including the root, so a mount point that cannot produce it is not a cgroup
// hierarchy, and the honest answer for the whole reading is that it could not be taken
// (zesty-pike-444's review named the masked-mount case).
fn cgroup_hierarchy_is_live() -> Bool
  uses net: Network
{
  linux.CgroupV2.ReadInterfaceFile(
    file_path: cgroup_v2_child_path(parent: cgroup_v2_mount_point, child: "cgroup.controllers" as NonEmptyStr),
  ).success
}

fn observe_cgroup_subtree(slice: NonEmptyStr) -> CgroupSubtreeReadback
  uses net: Network
{
  if !cgroup_hierarchy_is_live() {
    CgroupSubtreeReadFailed {
      reason: join([cgroup_v2_mount_point as String, " does not answer as a cgroup v2 hierarchy, so an absent cell cgroup says nothing about the cell"], "") as NonEmptyStr,
    }
  } else {
    observe_slice_subtree(slice: slice)
  }
}

fn observe_slice_subtree(slice: NonEmptyStr) -> CgroupSubtreeReadback
  uses net: Network
{
  match systemd_slice_cgroup_path(mount_point: cgroup_v2_mount_point, slice: slice) {
    SliceNameNotASlice { spelling: sp } =>
      CgroupSubtreeReadFailed {
        reason: join([sp, " is not a slice unit name, so it addresses no cgroup"], "") as NonEmptyStr,
      }
    SliceCgroupPath { path: p } => observe_cgroup_at(path: p)
  }
}

// THE SLICE'S CGROUP IS NOT `<mount point>/<slice name>` AND THE FIRST WET RUN IS WHAT SAID SO.
// systemd expands a dashed slice name into a path (extdeps.systemd systemd_slice_cgroup_path), and
// every cell slice is dashed -- fabric-cell-<host>-<NN>.slice. Joined directly, the readback would
// have found no directory at all and reported the subtree EMPTY, which is this whole lane's worst
// arm: every cell released clean, whatever was running in it. It read green on a hermetic witness
// because a supplied CgroupSubtreeReadback never touches a path.
fn observe_cgroup_at(path: NonEmptyStr) -> CgroupSubtreeReadback
  uses net: Network
{
  if linux.CgroupV2.PathIsDirectory(path: path).success == false {
    CgroupSubtreeEmpty
  } else {
    let events = linux.CgroupV2.ReadEvents(events_path: cgroup_v2_events_path(cgroup_path: path))
    if events.success == false {
      CgroupSubtreeReadFailed {
        reason: join(["cgroup.events under ", path as String, " could not be read"], "") as NonEmptyStr,
      }
    } else {
      match decode_cgroup_events_populated(body: events.value) {
        CgroupEventsUnparseable { cause: c } =>
          CgroupSubtreeReadFailed {
            reason: join(["cgroup.events under ", path as String, " did not decode: ", c], "") as NonEmptyStr,
          }
        CgroupEventsDecoded { populated: p } =>
          if p == false {
            CgroupSubtreeEmpty
          } else {
            populated_readback(path: path)
          }
      }
    }
  }
}

// THE PIDS ARE THE DETAIL AND THE KERNEL'S `populated` IS THE VERDICT, so a walk that finds nothing
// under a cgroup the kernel calls populated still reports POPULATED. The two readings are taken at
// different instants and a process can exit between them; trusting the later, emptier one would let
// a cell be released because the walk was slow, which is the readback's verdict following the
// instrument's convenience. The cgroup itself is named so the message is still actionable.
fn populated_readback(path: NonEmptyStr) -> CgroupSubtreeReadback
  uses net: Network
{
  let walk = walk_cgroup(cgroup_path: path, depth: cgroup_walk_depth_bound)
  let pids = walk_pids(walk: walk)
  let holders = walk_populated_cgroups(walk: walk)
  CgroupSubtreePopulated {
    pids: pids,
    cgroups: if (holders |> count) == 0 { [path] } else { holders },
  }
}

// --- the per-resource absence readback ---

// EXISTENCE IS READ FROM `test -e`'s EXIT STATUS, WHICH IS TOTAL, AND THE THIRD ARM IS THE POINT.
// POSIX gives `test` exit 0 for true and 1 for false, and reserves anything else for the utility
// itself failing. So exit 1 is the only reading that means ABSENT; every other nonzero status is an
// instrument that did not answer, and reading it as absent is how a broken probe would release a
// cell holding the previous tenant's writable layer. Matching on stderr text instead would be the
// heuristic DESIGN section 4 rules out where a total discriminator exists -- and one does, here, in
// the utility's own documented status.
fn observe_resource_absence(path: String) -> ResourceReadback
  uses net: Network
{
  if path == "" {
    ResourceUnreadable { reason: "the resource to prove absent has no path, so nothing was read" as NonEmptyStr }
  } else {
    resource_absence_at(path: path as NonEmptyStr)
  }
}

// THE PATH IS NONEMPTY BEFORE ANYTHING IS RUN, so the detail below crosses nothing. An empty path is
// not a resource that is absent -- `test -e ""` exits 1 and would have read as ABSENT, releasing a
// cell on a reading of nothing at all.
fn resource_absence_at(path: NonEmptyStr) -> ResourceReadback
  uses net: Network
{
  match run_shell_command_capture(command: test_exists_command(path: path as String), transport: LocalExec) {
    ProcessOutputPresent { text: _ } => ResourcePresent { detail: path }
    ProcessOutputAbsent => ResourcePresent { detail: path }
    ProcessRefused { exit_code: code, stderr: e } =>
      if code == 1 {
        ResourceAbsent
      } else {
        ResourceUnreadable {
          reason: join(["`test -e ", path as String, "` exited ", to_string(code), ": ", trim(s: e)], "") as NonEmptyStr,
        }
      }
  }
}

// THE GROUND CHECK IS THE SAME READING ASKED BEFORE THE ATTEMPT RUNS. gunbc.runner_attempt_launch
// AttemptGround is the host's own answer to "is anything of a previous attempt still here", and the
// controller consumes it at start (gunbc.runner_microvm_lifecycle controller_start). An UNREADABLE
// resource counts as OCCUPIED here and that asymmetry is deliberate: before the attempt, not knowing
// whether residue is present must refuse; there is no arm in which a failed probe clears the ground.
fn observe_attempt_ground(attempt: MicroVmAttempt) -> AttemptGround
  uses net: Network
{
  let readings = [
    observe_resource_absence(path: runner_microvm_attempt_jail_base(attempt: attempt)),
    observe_resource_absence(path: runner_microvm_attempt_dir(attempt: attempt)),
  ]
  match filter(readings, r => resource_is_absent(r: r) == false).first() {
    Present { value: _ } => GroundOccupied
    Absent => GroundClear
  }
}

fn resource_is_absent(r: ResourceReadback) -> Bool {
  match r {
    ResourceAbsent => true
    ResourcePresent { detail: _ } => false
    ResourceUnreadable { reason: _ } => false
  }
}

// --- the bounded stop ---

// THE GRACE AND THE FORCE BOUND ARE TWO DURATIONS BECAUSE THEY ANSWER TWO QUESTIONS. The grace is
// how long a well-behaved guest is given to finish; the force bound is how long the host waits for
// the kernel to finish a SIGKILL, which it does promptly for every task that is not in
// uninterruptible sleep. A task still present after the force bound is not slow, it is unkillable,
// and that is the arm gunbc.runner_microvm_lifecycle ForceStopBoundExceeded carries.
data attempt_stop_grace: Second = second(count: 30)

data attempt_force_stop_bound: Second = second(count: 10)

data attempt_stop_poll_interval: Second = second(count: 1)

// THE STOP IS TWO STEPS AT TWO DIFFERENT SUBJECTS, AND THE ASYMMETRY IS THE WHOLE DESIGN.
//
// THE GRACEFUL ASK IS THE UNIT'S. `systemctl kill --signal=SIGTERM --kill-whom=all <unit>` reaches
// the processes in THAT UNIT's control group -- the attempt's own -- which is exactly who a graceful
// ask is addressed to. `--kill-whom=all` rather than the default because the default reaches only
// the main process, and a VMM's children are the point.
//
// THE FORCE IS THE CELL'S, AND THIS WAS A DEFECT UNTIL A REVIEW FOUND IT (vivid-stag-809 on this PR,
// relayed by sunny-ant-606). The force used to signal the same UNIT, under an annotation claiming it
// "reaches the whole control group". It does not: it reaches the UNIT's cgroup. A process that moved
// itself into a scope BESIDE the service under the same cell slice is still accounted to the cell,
// is still found by the slice-wide readback, and was never reached by that kill -- so it survived
// the force and quarantined a cell that a correct force would have cleaned. This file's own wet RED
// proved it and the annotation contradicted it one function away, which is prose claiming more than
// the code enforced.
//
// SO THE FORCE IS A WRITE TO THE CELL SLICE'S cgroup.kill, which is the kernel's own answer: it takes
// the whole SUBTREE and is atomic against forking, so nothing escapes by forking mid-kill the way it
// can between an enumeration and a signal loop. What must be true after a teardown is a fact about
// the CELL, so the operation that establishes it is addressed to the cell.
//
// WHAT THAT MEANS FOR ForceStopBoundExceeded: after this repair the arm is reachable only by a task
// the KERNEL could not end -- uninterruptible sleep, or a frozen cgroup -- which is what the type
// always meant. A process merely hiding in a sibling cgroup no longer reaches it.
//
// WHY NOT `systemctl stop`: it sends SIGTERM and escalates to SIGKILL on the unit's own
// TimeoutStopSec and reports one success, so a unit whose child ignored SIGTERM and one that exited
// on it return the same thing, and StoppedGracefully would be indistinguishable from StoppedByForce.
// Doing each step here, and reading the cgroup between them, is what lets the controller say WHICH of
// the three happened.
type StopQuiescence
  = CgroupQuiet
  | CgroupStillHolding { readback: CgroupSubtreeReadback }

fn cgroup_quiescence(slice: NonEmptyStr) -> StopQuiescence
  uses net: Network
{
  let r = observe_cgroup_subtree(slice: slice)
  match r {
    CgroupSubtreeEmpty => CgroupQuiet
    CgroupSubtreePopulated { pids: _, cgroups: _ } => CgroupStillHolding { readback: r }
    CgroupSubtreeReadFailed { reason: _ } => CgroupStillHolding { readback: r }
  }
}

// A CGROUP THAT COULD NOT BE READ IS NOT QUIET. The poll below treats an unreadable subtree exactly
// as it treats a populated one -- it keeps waiting and then escalates -- because "I could not tell"
// is not evidence that the stop worked. The readback taken AFTER the stop reports the unreadability
// on its own, at its own grain, where it quarantines the cell.
fn poll_until_quiet(slice: NonEmptyStr, polls_remaining: Int) -> StopQuiescence
  uses net: Network
{
  match cgroup_quiescence(slice: slice) {
    CgroupQuiet => CgroupQuiet
    CgroupStillHolding { readback: r } =>
      if polls_remaining <= 0 {
        CgroupStillHolding { readback: r }
      } else {
        let _slept = sleep_delay_seconds_second_carrier_projection(duration: attempt_stop_poll_interval)
        poll_until_quiet(slice: slice, polls_remaining: polls_remaining - 1)
      }
  }
}

fn polls_for(bound: Second) -> Int {
  second_count(s: bound) / second_count(s: attempt_stop_poll_interval)
}

// THE FORCE'S OUTCOME IS DERIVED FROM THE READBACK'S OWN ARM, NOT FROM A PID LIST FLATTENED OUT OF
// IT. This used to be a `survivors_of` that answered EMPTY for a read failure, and poll_until_quiet
// correctly treats unreadable as not-quiet, so the two composed into an exceeded-bound carrying no
// survivors -- a refutation whose cause nobody observed. The mapping is now total over the readback:
// populated refutes, unreadable is unobservable, and empty cannot arrive here because
// poll_until_quiet would have said quiet.
fn force_stop_outcome(q: StopQuiescence) -> TeardownStop {
  match q {
    CgroupQuiet => StoppedByForce
    CgroupStillHolding { readback: r } =>
      match r {
        CgroupSubtreePopulated { pids: p, cgroups: _ } => ForceStopBoundExceeded { survivors: p }
        CgroupSubtreeReadFailed { reason: reason } =>
          ForceStopOutcomeUnobservable {
            reason: join(["the cell's cgroup subtree could not be read after the bounded force-stop: ", reason as String], "") as NonEmptyStr,
          }
        CgroupSubtreeEmpty => StoppedByForce
      }
  }
}

// A GRACEFUL STOP IS CLAIMED ONLY WHEN THE GRACEFUL ASK WAS ACCEPTED, and the first cut claimed it
// whenever the cgroup happened to be quiet afterwards.
//
// The TERM result was computed and discarded. `systemctl kill` REFUSES for a unit the manager never
// heard of, or one already unloaded -- which this lane's own wet log produces routinely ("Unit ...
// not loaded") -- and if the cell's cgroup then read empty, the controller reported
// StoppedGracefully. Nothing was asked and nothing complied; the receipt claimed both. That is the
// same defect as the discarded readback one function later, one function earlier: a field's honesty
// must not rest on a sibling field, because the first consumer to read the stop alone reads a
// fabricated claim (review 69001, relayed by sunny-ant-606).
//
// THE REPAIR ADDS NO ARM, AND DELIBERATELY. A refused ask over a quiet cell is not a fourth state to
// model: it is simply not a graceful stop, so the controller goes on to the force step and reports
// what that step did. StoppedByForce over an already-quiet cell says the force ran and the cell is
// quiet, which is exactly what happened -- a weaker and true claim in place of a stronger and false
// one. Both arms defer to the cgroup readback for the sanitation verdict, so the cell's disposition
// is unchanged either way; what changes is whether the receipt describes the run.
fn stop_attempt(unit: NonEmptyStr, slice: NonEmptyStr) -> TeardownStop
  uses net: Network, fs: Filesystem
{
  let asked = systemd.Systemctl.KillUnitTerm(unit: unit).success
  match poll_until_quiet(slice: slice, polls_remaining: polls_for(bound: attempt_stop_grace)) {
    CgroupQuiet =>
      if asked {
        StoppedGracefully
      } else {
        force_stop_attempt(unit: unit, slice: slice)
      }
    CgroupStillHolding { readback: _ } => force_stop_attempt(unit: unit, slice: slice)
  }
}

// A CELL WHOSE CGROUP IS NOT THERE HAS NOTHING TO KILL, and that is not a failure to force-stop: the
// subtree is gone, so the graceful ask ended everything. It is reported as a stop by force because
// the force step ran and the cell is quiet, which is the honest reading of what happened.
fn force_stop_attempt(unit: NonEmptyStr, slice: NonEmptyStr) -> TeardownStop
  uses net: Network, fs: Filesystem
{
  match systemd_slice_cgroup_path(mount_point: cgroup_v2_mount_point, slice: slice) {
    SliceNameNotASlice { spelling: sp } =>
      ForceStopOutcomeUnobservable {
        reason: join([sp, " is not a slice unit name, so the cell's cgroup could not be addressed to force-stop it"], "") as NonEmptyStr,
      }
    SliceCgroupPath { path: p } => force_stop_subtree(path: p, slice: slice)
  }
}

fn force_stop_subtree(path: NonEmptyStr, slice: NonEmptyStr) -> TeardownStop
  uses net: Network, fs: Filesystem
{
  let _killed = Filesystem.Write(
    path: cgroup_v2_kill_path(cgroup_path: path) as String,
    content: cgroup_v2_kill_trigger_value,
  )
  force_stop_outcome(q: poll_until_quiet(slice: slice, polls_remaining: polls_for(bound: attempt_force_stop_bound)))
}

// --- the teardown observation, assembled for one bound attempt ---

// THE ATTEMPT'S INVOCATION ID IS CARRIED INTO THE UNIT AND READ BACK OUT OF IT, AND THE FIRST CUT
// READ THE WRONG IDENTIFIER ENTIRELY.
//
// gunbc.runner_microvm_lifecycle's teardown join compares the OBSERVED stop's invocation id against
// the one the STORE recorded for this attempt, and that recorded value is the ATTEMPT's invocation
// id -- written at WriteAttemptStarted, BEFORE anything is staged, so it cannot be systemd's
// InvocationID, which does not exist until the unit starts. This module used to fill the observed
// side with systemd's InvocationID: two different identifiers compared for equality, so the join
// would have refused EVERY teardown and the controller could never have settled a cell. Nothing
// here would have caught it -- the hermetic witness supplies both sides, and the wet receipt stops
// short of assembling a teardown (zesty-pike-444's review, relayed by sunny-ant-606).
//
// SO THE UNIT CARRIES THE ATTEMPT'S OWN ID AND THE CONTROLLER READS IT BACK FROM THE UNIT. The launch
// sets it as an Environment property; teardown reads the unit's Environment before signalling. That
// keeps the observed side an OBSERVATION rather than a second copy of the request: a value read off
// the unit says which attempt THAT unit was started for, so a unit left over from a previous
// incarnation answers with the previous attempt's id and the join refuses -- which is exactly the
// stale-incarnation case a warm pool produces.
//
// IT DEPENDS ON THE UNIT STILL BEING LOADED, which is why the launch uses systemd-run's RETAINED
// form: --collect unloads the unit the moment it exits and takes its Environment, its Result and its
// ExecMainStatus with it.
data attempt_invocation_env_key: String = "GUNBC_ATTEMPT_INVOCATION_ID"

fn attempt_invocation_env_setting(invocation_id: NonEmptyStr) -> SystemdRunProperty {
  SystemdRunProperty {
    property: EnvironmentProperty,
    value: join([attempt_invocation_env_key, "=", invocation_id as String], "") as NonEmptyStr,
  }
}

// THE UNIT'S Environment IS A LIST OF ASSIGNMENTS AND ONLY ONE OF THEM IS OURS. systemd renders the
// property as space-separated `KEY=VALUE` words, so the reading splits on whitespace and takes the
// assignment whose key is ours. An absent key reads as the empty string, which no attempt's
// invocation id can equal, so the join refuses rather than matching.
// THE GUARD IS BEFORE THE CROSSING, NOT AFTER IT, and the first cut had it the wrong way round.
// It returned a String that was "" when the property could not be read or the key was absent, and
// the caller crossed that into NonEmptyStr inside a record literal -- which is decided only when it
// EVALUATES, so the designed empty case never reached the refusal the annotation promised. It would
// have aborted inside the teardown instead, untyped and unlocated, after the stop had already been
// asked: a failure arm that neither refuses nor is located, on the exact path this module exists to
// make observable (review 69057). The three states are separated here, where they are produced, and
// the empty string has no way out of this function.
fn observe_unit_attempt_invocation(unit: NonEmptyStr) -> UnitInvocationReading
  uses net: Network
{
  let shown = systemd.Systemctl.ShowProperty(
    unit: unit,
    property: systemd_unit_property_wire(property: EnvironmentProperty),
  )
  if shown.success == false {
    UnitInvocationUnread {
      reason: join(["the unit's Environment could not be read, so the attempt it was started for is unknown: ", unit as String], "") as NonEmptyStr,
    }
  } else {
    invocation_of_environment(unit: unit, environment: trim(s: shown.value))
  }
}

// THE UNIT'S Environment IS A LIST OF ASSIGNMENTS AND ONLY ONE OF THEM IS OURS. systemd renders the
// property as space-separated `KEY=VALUE` words, so the reading splits on whitespace and takes the
// assignment whose key is ours. A missing key and an EMPTY value are the same answer here -- neither
// names an attempt -- and both are Unread rather than a value nothing can equal.
fn invocation_of_environment(unit: NonEmptyStr, environment: String) -> UnitInvocationReading {
  let found = fold(split(s: environment, delimiter: " "), init: "", f: (acc, word) =>
    if starts_with(s: word, prefix: join([attempt_invocation_env_key, "="], "")) {
      substring(s: word, start: string_length(s: attempt_invocation_env_key) + 1, end: string_length(s: word))
    } else {
      acc
    })
  if found == "" {
    UnitInvocationUnread {
      reason: join(["the unit carries no ", attempt_invocation_env_key, " assignment, so it names no attempt: ", unit as String], "") as NonEmptyStr,
    }
  } else {
    UnitInvocationRead { invocation_id: found as NonEmptyStr }
  }
}

// THE STOP AND THE READBACKS ARE ONE STEP IN ONE ORDER, AND THE ORDER IS THE EVIDENCE. Every
// readback below is taken AFTER the stop has finished, because a cgroup read taken while the stop is
// still running measures the stop's progress rather than its result. The stop's own outcome travels
// out beside the readings, so surviving_process_observation can require BOTH host facts -- the stop
// did not exceed its bound AND the subtree holds no pid -- exactly as
// gunbc.runner_microvm_lifecycle declares.
//
// THE FUNCTION MUTATES, AND ITS NAME SAYS SO. It signals the unit. Naming it `observe_` would hide
// the one step in this module that changes the host.
fn perform_teardown_and_observe(
  bound: CellBoundAttempt,
  network: BoundSlotNetworkReadback,
) -> ObservedTeardown
  uses net: Network, fs: Filesystem
{
  let attempt = bound.attempt.attempt
  let unit = in_flight_attempt_unit(attempt: bound.attempt)
  let slice = fabric_cell_slice_name(slot: attempt.slot) as NonEmptyStr
  let invocation = observe_unit_attempt_invocation(unit: unit)
  let outcome = stop_attempt(unit: unit, slice: slice)
  let jail = runner_microvm_attempt_jail_base(attempt: attempt)
  let dir = runner_microvm_attempt_dir(attempt: attempt)
  let drive = bound.attempt.credential_device_path
  ObservedTeardown {
    host: attempt.slot.host as String,
    generation: bound.generation,
    stop: ObservedStop { unit: unit, invocation_id: invocation, outcome: outcome },
    cgroup: ObservedCgroup { root: slice, readback: observe_cgroup_subtree(slice: slice) },
    mounts: ObservedPath { path: jail, readback: observe_resource_absence(path: jail) },
    attempt_storage: ObservedPath { path: dir, readback: observe_resource_absence(path: dir) },
    credential_disk: ObservedPath { path: drive, readback: observe_resource_absence(path: drive) },
    network: network,
  }
}

// THE RETAINED UNIT IS RELEASED ONLY AFTER EVERY READING HAS BEEN TAKEN, and it takes the readings
// as its argument so it cannot be hoisted above them. The launch keeps the unit loaded on purpose --
// its Environment, Result and ExecMainStatus are the evidence -- so something has to unload it, and
// the only moment at which that is safe is when nothing will read it again. The reset is not
// conditional on the teardown's verdict: a quarantined cell keeps its RECORD, which is where the
// evidence lives durably, and leaving a failed unit loaded as well would accumulate one per attempt.
fn release_retained_unit(after: ObservedTeardown) -> Bool
  uses net: Network
{
  systemd.Systemctl.ResetFailedUnit(unit: after.stop.unit).success
}

// THE TERMINAL PATH, WHOLE: stop, read back, join against the attempt, settle, record.
//
// THERE IS NO ARM THAT SETTLES WITHOUT THE JOIN. attempt_teardown_readback is the only producer of
// an AttemptTeardownReadback and settle_teardown takes nothing else, so a readback whose subject
// disagrees with the attempt cannot reach a verdict here -- it leaves as
// TeardownSubjectRefused, which records nothing and releases nothing. That is the fail-closed
// direction: an unjoinable readback is evidence about some other subject, and a cell released on it
// is a cell released on a reading of a different slot.
type TeardownRun
  = TeardownSettled { settlement: TeardownSettlement, persisted: CellReadinessStorePersist }
  | TeardownSubjectRefused { binding: TeardownReadbackBinding }

fn run_teardown(
  bound: CellBoundAttempt,
  network: BoundSlotNetworkReadback,
  trigger: TerminalTrigger,
) -> TeardownRun
  uses net: Network, fs: Filesystem
{
  let observed = perform_teardown_and_observe(bound: bound, network: network)
  let _released = release_retained_unit(after: observed)
  match attempt_teardown_readback(bound: bound, observed: observed) {
    TeardownReadbackForeignSubject { subject: s, expected: e, observed: o } =>
      TeardownSubjectRefused {
        binding: TeardownReadbackForeignSubject { subject: s, expected: e, observed: o },
      }
    TeardownReadbackSubjectUnobservable { subject: s, reason: r } =>
      TeardownSubjectRefused {
        binding: TeardownReadbackSubjectUnobservable { subject: s, reason: r },
      }
    TeardownReadbackBound { readback: rb } => {
      let settlement = settle_teardown(readback: rb, trigger: trigger)
      TeardownSettled {
        settlement: settlement,
        persisted: persist_cell_readiness_write(write: settlement.record),
      }
    }
  }
}

// --- staging, and the one route to a running VMM ---

fn command_exit_code(outcome: ProcessOutcome) -> Int {
  match outcome {
    ProcessOutputPresent { text: _ } => 0
    ProcessOutputAbsent => 0
    ProcessRefused { exit_code: c, stderr: _ } => c
  }
}

// THE SUPERBLOCK READING NAMES THE IMAGE IT READ, because the path is what
// gunbc.runner_attempt_launch workspace_standing compares against the plan's own workspace_path.
// Reading some other image -- a previous attempt's, another slot's -- and reporting its size would
// otherwise pass as this plan's workspace being ready.
fn read_workspace_superblock(workspace_path: String) -> WorkspaceReadback
  uses net: Network
{
  match run_shell_command_capture(command: workspace_readback_command(workspace_path: workspace_path), transport: LocalExec) {
    ProcessRefused { exit_code: c, stderr: e } =>
      WorkspaceReadbackFailed {
        reason: join(["dumpe2fs on ", workspace_path, " exited ", to_string(c), ": ", trim(s: e)], "") as NonEmptyStr,
      }
    ProcessOutputAbsent =>
      WorkspaceReadbackFailed { reason: join(["dumpe2fs on ", workspace_path, " printed no superblock"], "") as NonEmptyStr }
    ProcessOutputPresent { text: t } =>
      match decode_dumpe2fs_superblock(body: t) {
        Ext2SuperblockUnreadable { cause: c } =>
          WorkspaceReadbackFailed { reason: join([workspace_path, ": ", c], "") as NonEmptyStr }
        Ext2SuperblockRead { magic: m, block_count: bc, block_size: bs } =>
          WorkspaceSuperblockRead {
            image_path: workspace_path,
            ext_magic: m == ext2_superblock_magic,
            bytes: byte_size(count: bc * bs),
          }
      }
  }
}

// STAGING IS NOT A VERDICT AND THIS FUNCTION DOES NOT PRODUCE ONE. It runs what the plan said to
// run and reads back what the host did, then hands BOTH stagings to
// gunbc.runner_attempt_launch attempt_staging_verdict, which is the single authority for whether
// a jailer may be released. A refused plan has nothing to stage -- its arms carry no commands --
// so this reports that no staging was attempted rather than manufacturing observations to feed a
// fold whose answer for those arms is already fixed.
type AttemptStaging
  = AttemptStaged { verdict: AttemptStagingVerdict }
  | AttemptStagingNotPlanned { plan: AttemptLaunchPlan }

fn stage_attempt(plan: AttemptLaunchPlan) -> AttemptStaging
  uses net: Network, fs: Filesystem
{
  match plan {
    LaunchAuthorized {
      authorization: _,
      jit_runner_name: _,
      jit_registration_id: _,
      jit_device: device,
      tap_device: _,
      guest_ip_boot_arg: _,
      slice: _,
      jail_root: _,
      stage_jail_root: stage_root,
      stage_kernel: stage_kernel,
      stage_rootfs: stage_rootfs,
      workspace_path: workspace_path,
      workspace_create: create,
      workspace_format: format,
      kvm_device: _,
      vm_config: _,
      jailer: _,
    } => {
      let _root = run_shell_command_capture(command: stage_root, transport: LocalExec)
      let _kernel = run_shell_command_capture(command: stage_kernel, transport: LocalExec)
      let _rootfs = run_shell_command_capture(command: stage_rootfs, transport: LocalExec)
      let create_outcome = run_shell_command_capture(command: create, transport: LocalExec)
      let format_outcome = run_shell_command_capture(command: format, transport: LocalExec)
      AttemptStaged {
        verdict: attempt_staging_verdict(
          plan: plan,
          jit: stage_jit_device(device: device),
          workspace: WorkspaceStagingObservation {
            create_exit: command_exit_code(outcome: create_outcome),
            format_exit: command_exit_code(outcome: format_outcome),
            readback: read_workspace_superblock(workspace_path: workspace_path),
          },
        ),
      }
    }
    refused => AttemptStagingNotPlanned { plan: refused }
  }
}

// THE VMM STARTS FROM THE RECEIPT AND FROM NOWHERE ELSE.
//
// This is the consumption gunbc.runner_attempt_launch's workspace_staging_consumer_frontier and
// jit_mint_lifecycle_controller_consumer_frontier were waiting for, and it is the whole reason the
// receipt is sealed. AttemptStagingReceipt is constructible only inside attempt_staging_verdict's
// admitting arm, and the jailer argv is reachable only out of a receipt -- so there is no path from
// this function to a running VMM that does not pass through a JIT device staged FOR THIS ATTEMPT and
// a workspace read back as this plan's. Workspace readiness alone cannot release the jailer, because
// the value that carries the jailer cannot exist without the other premise.
//
// THE UNIT IS THE ATTEMPT'S AND THE SLICE IS THE CELL'S, both derived from the attempt rather than
// passed in: a VMM started outside the cell's slice is a guest whose CPU, memory and task
// consumption no reservation accounts for (gunbc.runner_microvm_attempt), and Slice= cannot be added
// after the fact.
type AttemptLaunch
  = VmmStarted { unit: NonEmptyStr, receipt: AttemptStagingReceipt }
  | VmmRefusedStaging { verdict: AttemptStagingVerdict }
  | VmmNotPlanned { plan: AttemptLaunchPlan }
  | VmmStartFailed { unit: NonEmptyStr, detail: String }

fn launch_attempt(attempt: MicroVmAttempt, invocation_id: NonEmptyStr, plan: AttemptLaunchPlan) -> AttemptLaunch
  uses net: Network, fs: Filesystem
{
  match stage_attempt(plan: plan) {
    AttemptStagingNotPlanned { plan: p } => VmmNotPlanned { plan: p }
    AttemptStaged { verdict: v } =>
      match v {
        StagingAdmitsJailer { receipt: r } => run_jailer_in_cell(attempt: attempt, invocation_id: invocation_id, receipt: r)
        refused => VmmRefusedStaging { verdict: refused }
      }
  }
}

fn run_jailer_in_cell(attempt: MicroVmAttempt, invocation_id: NonEmptyStr, receipt: AttemptStagingReceipt) -> AttemptLaunch
  uses net: Network
{
  let unit = runner_microvm_attempt_unit_name(attempt: attempt)
  let started = systemd.SystemdRun.RunTransientRetained(
    unit: unit,
    property_argv: systemd_run_property_argv(properties: [
      runner_microvm_attempt_slice_property(attempt: attempt),
      attempt_invocation_env_setting(invocation_id: invocation_id),
    ]),
    command_argv: concat([receipt.jailer.program as String], receipt.jailer.arguments),
  )
  if started.success {
    VmmStarted { unit: unit, receipt: receipt }
  } else {
    VmmStartFailed { unit: unit, detail: trim(s: started.stderr) }
  }
}

// --- waiting for a terminal condition ---

// THE DEADLINE IS A TERMINAL TRIGGER AND NOT AN ERROR PATH. A guest that runs past its deadline is
// torn down exactly as one that exited, through the same stop and the same readbacks, and the cell's
// readiness is decided by what the host finds afterwards. That is gunbc.runner_microvm_lifecycle's
// rule made operational: the trigger starts a teardown and never decides its outcome.
//
// THE EXIT CODE IS CARRIED AND GOES NOWHERE. VmmExited holds it because an operator reading a
// quarantine wants it; no fold downstream takes it, so a job that succeeded cannot argue its way
// past a dirty readback.
fn unit_exec_main_status(unit: NonEmptyStr) -> Int
  uses net: Network
{
  let shown = systemd.Systemctl.ShowProperty(unit: unit, property: systemd_unit_property_wire(property: ExecMainStatus))
  if shown.success == false {
    -1
  } else {
    match parse_int(s: trim(s: shown.value)) {
      Present { value: n } => n
      Absent => -1
    }
  }
}

fn await_terminal(unit: NonEmptyStr, polls_remaining: Int) -> TerminalTrigger
  uses net: Network
{
  if systemd.Systemctl.IsActive(unit: unit).active == false {
    VmmExited { exit_code: unit_exec_main_status(unit: unit) }
  } else if polls_remaining <= 0 {
    DeadlineReached
  } else {
    let _slept = sleep_delay_seconds_second_carrier_projection(duration: attempt_stop_poll_interval)
    await_terminal(unit: unit, polls_remaining: polls_remaining - 1)
  }
}

// --- the controller ---

// DECLARED FRONTIER (DESIGN 3c). The bring-up progression above VmmStarted -- GuestBooted,
// RunnerListening, SlotServing -- is decided by gunbc.runner_microvm_lifecycle advance_bring_up from
// BringUpEvents the GUEST reports, and this controller emits none of them: there is no channel from
// the guest to the host in this tree yet. What the controller establishes on its own is
// AttemptPrepared (staging read back) and VmmStarted (the host saw systemd start the unit in the
// cell's slice), and it then waits for a terminal condition. NAMED CONSUMER of the missing half: this
// module's run_controller, which will call advance_bring_up once a guest channel delivers a
// BringUpEvent. TRIGGER: a modeled guest-to-host readiness channel -- the capability, not an
// artifact -- carrying the runner's own listening report bound to this attempt's invocation id.
// SUFFICIENT FOR deleting this row. NOT satisfied by the controller polling the host for something
// the guest alone can know.
//
// WHY THAT IS SAFE TO DECLARE RATHER THAN FAKE. The progression decides only whether the slot is
// SERVING. It never decides whether the cell is CLEAN, so a controller that never advances past
// VmmStarted runs the job and settles the cell correctly; what it cannot do is tell a guest that
// failed to boot from one that booted and is idle, and it will reach the deadline in both cases.
data guest_bring_up_channel_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: gunbc.runner_microvm_lifecycle_realize run_controller, calling gunbc.runner_microvm_lifecycle advance_bring_up. TRIGGER: a modeled guest-to-host readiness channel carrying the runner's own listening report bound to this attempt's invocation id, so GuestBooted and RunnerListening are guest events the host receives rather than host guesses. SUFFICIENT FOR deleting this row. NOT satisfied by the controller polling host-side facts, which cannot distinguish a guest that failed to boot from one that booted and is idle." as NonEmptyStr,
)

// THE ORDER IS THE SAFETY PROPERTY AND IT IS NOT NEGOTIABLE.
//
// The in-flight record is written BEFORE anything is staged, and a record that did not persist stops
// the controller before it stages or launches. That is the durable half of boot recovery
// (gunbc.runner_microvm_cell_readiness): a controller lost at any later point leaves a record saying
// cleanup is owed, rather than the previous attempt's settled Ready readmitting a cell whose VMM may
// still be running. Launching first and recording afterwards would make the window between them
// invisible, which is the one window in this whole lane that nobody can observe after the fact.
//
// AND THE TEARDOWN RUNS WHATEVER THE LAUNCH DID. A refused staging, a jailer that would not start and
// a job that ran to completion all reach run_teardown, because all three can leave something behind
// -- a staged credential device, a half-built workspace, a process. The trigger differs; the
// obligation does not.
type ControllerOutcome
  = ControllerRefusedAdmission { admission: CellIncarnationAdmission }
  | ControllerRefusedBinding { binding: CellBinding }
  | ControllerQuarantinedUnattributedResidue { persisted: CellReadinessStorePersist }
  | ControllerStartNotRecorded { persisted: CellReadinessStorePersist }
  | ControllerRecovered { teardown: TeardownRun }
  | ControllerRanAttempt { launch: AttemptLaunch, trigger: TerminalTrigger, teardown: TeardownRun }

fn run_controller(
  identity: AttemptIdentity,
  allocation_generation: Int,
  plan: AttemptLaunchPlan,
  network: BoundSlotNetworkReadback,
) -> ControllerOutcome
  uses net: Network, fs: Filesystem
{
  let cell = runner_slot_instance_name(slot: identity.attempt.slot) as CellId
  let admission = cell_incarnation_admission(
    store: read_cell_readiness_store(),
    cell: cell,
    allocation_generation: allocation_generation,
  )
  match controller_start(admission: admission, ground: observe_attempt_ground(attempt: identity.attempt), identity: identity) {
    StartRefused { admission: a } => ControllerRefusedAdmission { admission: a }
    StartBindingRefused { binding: b } => ControllerRefusedBinding { binding: b }
    StartQuarantineUnattributedResidue { trigger: _, record: r } =>
      ControllerQuarantinedUnattributedResidue { persisted: persist_cell_readiness_write(write: r) }
    StartRecovery { bound: b, trigger: t } => ControllerRecovered { teardown: run_teardown(bound: b, network: network, trigger: t) }
    StartAttempt { bound: b, record: r } => run_started_attempt(bound: b, record: r, plan: plan, network: network)
  }
}

fn run_started_attempt(
  bound: CellBoundIdentity,
  record: CellReadinessWrite,
  plan: AttemptLaunchPlan,
  network: BoundSlotNetworkReadback,
) -> ControllerOutcome
  uses net: Network, fs: Filesystem
{
  let persisted = persist_cell_readiness_write(write: record)
  match persisted {
    StorePersisted { record: _ } => run_launched_attempt(bound: bound, plan: plan, network: network)
    refused => ControllerStartNotRecorded { persisted: refused }
  }
}

fn run_launched_attempt(
  bound: CellBoundIdentity,
  plan: AttemptLaunchPlan,
  network: BoundSlotNetworkReadback,
) -> ControllerOutcome
  uses net: Network, fs: Filesystem
{
  let launch = launch_attempt(
    attempt: bound.attempt.attempt.attempt,
    invocation_id: bound.attempt.attempt.invocation_id,
    plan: plan,
  )
  let trigger = terminal_trigger_of_launch(launch: launch)
  ControllerRanAttempt {
    launch: launch,
    trigger: trigger,
    teardown: run_teardown(bound: bound.attempt, network: network, trigger: trigger),
  }
}

// A LAUNCH THAT NEVER STARTED STILL HAS A TERMINAL TRIGGER, and it is StopRequested rather than an
// invented exit: nothing ran, so there is no exit code to report, and the teardown that follows is a
// stop asked for by the controller. Reporting VmmExited with a fabricated code would put a number
// into a quarantine message that no process ever produced.
fn terminal_trigger_of_launch(launch: AttemptLaunch) -> TerminalTrigger
  uses net: Network
{
  match launch {
    VmmStarted { unit: u, receipt: _ } => await_terminal(unit: u, polls_remaining: polls_for(bound: runner_attempt_vmm_deadline))
    VmmRefusedStaging { verdict: _ } => StopRequested
    VmmNotPlanned { plan: _ } => StopRequested
    VmmStartFailed { unit: _, detail: _ } => StopRequested
  }
}
