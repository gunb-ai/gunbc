module gunbc.runner.runner_slot_job_role

import std.types { NonEmptyStr, List, Bool, Int }
import std.nat { Nat }
import product.host_identity { HostIdentity }
import gunbc.build_cache.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.fleet.fleet_host_identity { operator_host_srv1 }
import gunbc.ci.deploy_slot_tenancy { deploy_slot_job_user, deploy_slot_runner_group_name, DeploySlotReading }
import gunbc.runner.runner_host_deploy { srv1_runner_host_spec }
import gunbc.runner.runner_group_restriction_observation { runner_group_restriction_not_yet_observed }
import gunbc.runner.runner_slot_allocation {
  host_committed_identities_at,
  identity_in_list,
  identity_is_fabric_execution_member,
  gunbc_runner_committed_width,
  RunnerWidthDerived,
  RunnerWidthUnresolved,
}

// WHO A SLOT'S JOBS RUN AS IS A FACT OF THE SLOT, NOT OF THE HOST.
//
// RunnerHostDeploy.job_user is one value per host, and the depriv drop-in that renders it is a
// template-level file, so every slot of a host ran its jobs as one account. That is the gap the
// srv1 deploy-principal split names (gunbc.plans.srv1_deploy_principal_split, D3): a same-repository
// pull_request job and the fleet-converge deploy share one uid, so the deploy's ssh-agent and mux
// sockets are reachable by PR code. A group cannot close it, because a group gates which workflow
// is SCHEDULED onto a runner and not which processes share a uid.
//
// THE ROLE IS A CLOSED SUM AND THE USER IS SELECTED BY IT, with no default arm: a third role is a
// new constructor that every selection refuses to compile until it answers. It is deliberately not
// a third RunnerSlotPurpose. A deploy slot IS a GitHub Actions runner -- it has the same add
// sequence, the same lifecycle, the same local standing -- so adding it to the purpose sum would
// make runner_capacity_plan, runner_lifecycle, runner_local_state and fabric_cell_converge each
// answer a question about it that is the same answer; what differs is only the account and the
// label set, and those are this module's.
type RunnerSlotJobRole
  = CiJobSlot
  | DeployJobSlot

// srv1-02 IS THE DEPLOY SLOT (operator-adopted plan decision D4 = A, resolved by the width
// instrument in the plan: a fifth slot is refused, so an existing fleet slot is repurposed and CI
// width on srv1 falls from two to one). The index is authored for the reason
// gunbc_microvm_shakedown_slot_index gives -- renaming live state is not free -- and only the
// fleet range is derived.
data srv1_deploy_slot_index: Nat = 2

fn srv1_deploy_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv1, slot_index: srv1_deploy_slot_index }
}

data deploy_slot_identities: List<RunnerSlotIdentity> = [srv1_deploy_slot()]

fn runner_slot_job_role(slot: RunnerSlotIdentity) -> RunnerSlotJobRole {
  if identity_in_list(identity: slot, members: deploy_slot_identities) {
    DeployJobSlot
  } else {
    CiJobSlot
  }
}

// THE SAME QUESTION ASKED OF AN INSTANCE NAME, because the provisioner holds members by name and
// not by identity (gunbc.runner.runner_slot_provision RunnerSlotMember). It compares against the
// names the deploy identities render, so the two spellings cannot disagree.
fn runner_instance_job_role(host: HostIdentity, instance_name: NonEmptyStr) -> RunnerSlotJobRole {
  if any(
    deploy_slot_identities,
    d => (d.host as String) == (host as String) && runner_slot_instance_name(slot: d) == (instance_name as String)
  ) {
    DeployJobSlot
  } else {
    CiJobSlot
  }
}

// THE CI USER IS THE HOST'S job_user, supplied; the deploy user is deploy_slot_job_user. Neither
// arm falls through to the other.
fn runner_slot_job_user(role: RunnerSlotJobRole, ci_job_user: NonEmptyStr) -> NonEmptyStr {
  match role {
    CiJobSlot => ci_job_user
    DeployJobSlot => deploy_slot_job_user
  }
}

// THE DEPLOY SLOT RUNS NO CONTAINERS, and that is a requirement and not a convenience. The
// template-level drop-in sets DOCKER_HOST to the CI job user's rootless socket
// (docker_host_from_uid_reading), so an instance left to inherit it would hand the deploy account a
// path into the CI account's docker daemon -- the cross-uid reach the distinct user exists to remove.
fn runner_slot_job_role_runs_containers(role: RunnerSlotJobRole) -> Bool {
  match role {
    CiJobSlot => true
    DeployJobSlot => false
  }
}

// THE CI POPULATION IS THE COMMITTED GITHUB MEMBERS THAT ARE NOT THE DEPLOY SLOT. Both counts are
// projections of host_committed_identities_at, the population the width instrument admits, and
// never an authority for it: the deploy slot is a member the width already counts, so repurposing it
// moves one member from the CI count to the deploy count and changes the width by nothing.
fn host_committed_github_members(host: HostIdentity, committed: Int) -> List<RunnerSlotIdentity> {
  filter(
    host_committed_identities_at(host: host, committed: committed),
    id => !identity_is_fabric_execution_member(identity: id)
  )
}

fn host_committed_deploy_members(host: HostIdentity, committed: Int) -> List<RunnerSlotIdentity> {
  filter(
    host_committed_github_members(host: host, committed: committed),
    id => identity_in_list(identity: id, members: deploy_slot_identities)
  )
}

fn host_committed_ci_job_members(host: HostIdentity, committed: Int) -> List<RunnerSlotIdentity> {
  filter(
    host_committed_github_members(host: host, committed: committed),
    id => !identity_in_list(identity: id, members: deploy_slot_identities)
  )
}

// A MEMBER IS KEYED BY ITS INSTANCE NAME, so the account that owns its tree is selected from the name
// by the same role the unit's drop-in reads: the slot directory, the sudoers install line that
// creates it and the drop-in that runs it as that account cannot name different users.
fn runner_instance_job_user(host: HostIdentity, instance_name: NonEmptyStr, ci_job_user: NonEmptyStr) -> NonEmptyStr {
  runner_slot_job_user(role: runner_instance_job_role(host: host, instance_name: instance_name), ci_job_user: ci_job_user)
}

fn runner_host_has_deploy_slot(host: HostIdentity) -> Bool {
  any(deploy_slot_identities, d => (d.host as String) == (host as String))
}

// WHAT srv1's MODEL SAYS A READ OF THE HOST WILL HOLD, WITH THE GROUP STILL UNOBSERVED. The deploy
// user and every other slot's user are the model's (the deploy slot's role user; each committed CI
// member's job user), but the group is runner_group_restriction_not_yet_observed, so
// deploy_slot_observed_tenancy answers shared until a live org-group read replaces that one member.
// A refused width leaves the CI population unknown, and unknown reads as one shared CI user.
fn srv1_modeled_deploy_slot_reading() -> DeploySlotReading {
  let ci_user = srv1_runner_host_spec.job_user
  DeploySlotReading {
    group: runner_group_restriction_not_yet_observed(name: deploy_slot_runner_group_name),
    deploy_slot_job_user: runner_slot_job_user(role: runner_slot_job_role(slot: srv1_deploy_slot()), ci_job_user: ci_user),
    other_slot_job_users: match gunbc_runner_committed_width(host: operator_host_srv1) {
      RunnerWidthDerived { slots: n } =>
        map(host_committed_ci_job_members(host: operator_host_srv1, committed: n), id => runner_slot_job_user(role: runner_slot_job_role(slot: id), ci_job_user: ci_user))
      RunnerWidthUnresolved { cause: _ } => [ci_user]
    },
  }
}
