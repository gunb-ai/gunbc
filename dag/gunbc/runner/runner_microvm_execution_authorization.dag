module gunbc.runner_microvm_execution_authorization

import std.types { String, NonEmptyStr }
import std.disposition { Disposition, SingleAuthority }
import product.fabric.execution { ExecutionGrant, grant_lease_generation }
import product.fabric.identity { fabric_identity_eq, FabricIdentity, WorkKey, DemandKey, OfferKey }
import product.fabric.budget { MoneyAccount, fence_admits }

data runner_microvm_execution_authorization_disposition: Disposition = SingleAuthority

// THIS MODULE ANSWERS ONE QUESTION: DOES A GRANT AUTHORIZE THE RESERVED CELL?
//
// It does NOT compose a launch or order a mint. That composition was deleted rather than moved:
// it performed FCI-3's job -- what causes the target process -- while skipping FCI-2's grant, and
// `gunbc.fabric_ci_program` names `process-start` in FCI-2's non-goals. The ordering argument that
// stood here (mint last, reachable only from an admitted launch) was true of that composition and
// is NOT re-stated as an invariant of this module, because no mint or launch remains for it to
// range over. It belongs with the FCI-3 executor when that exists.
//
// DECLARED FRONTIER FOR THE RULE THIS MODULE KEEPS -- NOT ONLY FOR WHAT IT DELETED (DESIGN 3c).
// An earlier revision stated a frontier for the deleted launch composition and said nothing about
// grant_authorizes_reservation itself, which left the rule DANGLING rather than declared: the
// difference between the two honest states is whether the consumer and trigger are stated beside
// the declaration, and for the rule they were not.
//
// NAMED CONSUMER: the FCI-3 executor, whose exit predicate in gunbc.fabric_ci_program is that a
// persistent executor re-reads the committed Grant before starting, so an absent, corrupt or
// expired Grant yields ZERO target processes. This rule is the agreement half of that predicate.
// TRIGGER: that executor existing. Nothing in the runner path calls this today -- not
// bind_microvm_to_cell, which takes a snapshot and never sees an ExecutionGrant -- and the honest
// route is that it stays uncalled until FCI-3 lands.
//
// STATED WITH ITS COST RATHER THAN AS A REASSURANCE: that trigger is NOT near. The displacement
// analysis establishes that the production actuation FCI-3 must displace is authored in no
// repository, so a prerequisite stands before FCI-3 is even priceable. A reader deciding whether
// this module has earned its place should weigh that against what it does carry: four typed refusal
// arms, each with its own discriminating RED, mutation-proven to red ALONE. Its correctness is
// established by execution; only its production consumption is deferred.

// THE REFUSAL ARMS ARE NOT COLLAPSED INTO ONE `cause` STRING. Each names the authority that owns
// the remedy -- the money fence belongs to product.fabric.budget, the Work/Demand/Offer agreement
// to product.fabric.identity -- because collapsing them is the state-space conflation DESIGN
// names, and it sends an operator to the wrong module.

// THE AUTHORIZATION RULE, OVER THE COORDINATES THEMSELVES SO ITS RED IS AUTHORABLE.
//
// A grant that fences money proves the money; it proves nothing about WHICH execution was
// authorized. Presented against another cell's reservation it would pass whenever the supplied
// account fenced -- and that is worse than no grant, because the grant's presence reads as
// authorization while authorizing nothing about the subject. The grant carries work, demand and
// offer, and a reserved snapshot carries its own, so the join is available and is made here.
//
// IT TAKES THE COORDINATES RATHER THAN A SNAPSHOT, AND THAT IS WHAT MAKES IT TESTABLE.
// RequiredBuildCellSnapshot is sole_constructor, so no witness outside its module can build a
// DISAGREEING one; a rule reading the snapshot directly would have an unauthorable RED and be a
// DESIGN 4b decoration -- permanently green and cited as coverage. FabricIdentity is an ordinary
// record, so over coordinates the disagreement is writable, and four claims write it.
//
// WHAT THIS DOES NOT ESTABLISH, stated because the name would otherwise read as more than it is:
// ExecutionGrant is an ordinary constructible record, so a caller can author one. This proves
// AGREEMENT between a presented grant and a presented reservation, not that fabric issuance
// durably committed either. The unforgeable form re-reads the committed grant from durable storage
// after the submitter terminates -- FCI-3's own exit predicate, and not something a pure rule can
// assert about itself.
type AuthorizationAgreement
  = AuthorizationAgrees
  | AuthorizationDisagrees { cause: String }

fn grant_authorizes_reservation(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  work: FabricIdentity<NonEmptyStr, WorkKey>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  offer: FabricIdentity<NonEmptyStr, OfferKey>,
) -> AuthorizationAgreement {
  if !fence_admits(
    a: account,
    reference: grant.money_reservation,
    presented: grant_lease_generation(g: grant),
  ) {
    AuthorizationDisagrees {
      cause: "the execution grant presented for this launch does not fence against the account that issued it, so the authorization is stale or superseded and no target process may start",
    }
  } else if !fabric_identity_eq(left: grant.context.work, right: work) {
    AuthorizationDisagrees {
      cause: "the execution grant authorizes a different Work than the reserved cell holds, so this launch would run one subject under another's authorization",
    }
  } else if !fabric_identity_eq(left: grant.context.demand, right: demand) {
    AuthorizationDisagrees {
      cause: "the execution grant answers a different Demand than the reservation was taken for, so the two describe different executions",
    }
  } else if !fabric_identity_eq(left: grant.object.offer, right: offer) {
    AuthorizationDisagrees {
      cause: "the execution grant was issued against a different Offer than the cell was reserved from, so the supply it priced is not the supply this launch would consume",
    }
  } else {
    AuthorizationAgrees
  }
}
