module gunbc.runner_jit_mint

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.disposition { ConstructionMechanism, SingleAuthority }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.github.effect { GitHubEffect, GenerateOrganizationJitConfig, GitHubOrganizationRef }
import extdeps.github.actions_jit_runner {
  JitRunnerConfigRequest, JitRunnerName, JitRunnerGroupId, JitRunnerLabel, JitWorkFolder,
}
import gunbc.runner_group_restriction_observation {
  MicrovmRunnerGroupStanding, RunnerGroupRestrictedToWorkflow, RunnerGroupRestrictionRefused,
  RunnerGroupRestrictionRefusal, microvm_shakedown_selected_workflow,
}
import gunbc.runner.runner_jit_admission {
  attempt_binding_admits_mint_name, JitAdmissionAxisStanding,
}
import gunbc.auth.github_apps { GitHubAppControlPlaneState }
import gunbc.auth.github_credential {
  GitHubCredentialAuthority, CredentialCapability, credential_authorizes, unsatisfied_capabilities,
}
import extdeps.github.actions { self_hosted_provenance_label }
import gunbc.runner_microvm_attempt {
  MicroVmAttempt, MicroVmCellBinding, VmBoundToOwnedCell, VmUnboundCellNotOwned,
  runner_microvm_attempt_unit_name,
}
import gunbc.runner.runner_host_unit_slot {
  HostUnitSlot, HostUnitSlotStanding, HostUnitSlotBound, HostUnitSlotRefused, HostUnitSlotRefusal,
}

data runner_jit_mint_disposition: ConstructionMechanism = SingleAuthority

// THE MINT IS PLANNED, NOT PERFORMED, AND THE SPLIT IS THE POINT.
//
// Two facts have to be true before a credential exists at all: the cell must be OWNED (otherwise a
// guest would run outside every limit the cell carries) and the App credential must actually hold
// organization self-hosted-runners write. Those are different authorities -- gunbc.runner_microvm_attempt
// owns the first and gunbc.auth.github_credential owns the second -- so this module joins them and
// owns neither.
//
// Planning them together rather than at the call site is what makes the ordering unwritable: a
// caller cannot mint first and check ownership after, because the only value that names the attempt
// a credential belongs to is produced by the arm that already proved both.

// ONE MINT, TWO BINDINGS. A JIT registration is minted for a SLOT, and a slot is realized either
// as a microVM attempt in an owned cell or as a transient systemd unit on a managed host
// (gunbc.runner.runner_host_unit_slot). The plan below is one fold over this sum, not one fold per
// binding (DESIGN §3: transport is realization) -- the credential, attempt-binding and runner-group
// gates are the same gates whichever arm the slot is, and only the slot's existence proof and the
// name and labels it registers under are the binding's own.
type JitSlotBinding
  = MicroVmSlotBinding { binding: MicroVmCellBinding }
  | HostUnitSlotBinding { standing: HostUnitSlotStanding }

type JitSlot
  = MicroVmJitSlot { attempt: MicroVmAttempt }
  | HostUnitJitSlot { slot: HostUnitSlot }

type JitMintPlan
  = JitMintAuthorized {
      slot: JitSlot
      request: JitRunnerConfigRequest
    }
  | JitMintRefusedCellNotOwned { cause: String }
  | JitMintRefusedHostUnitSlot { refusal: HostUnitSlotRefusal }
  | JitMintRefusedCredential {
      organization: NonEmptyStr
      unsatisfied: List<CredentialCapability>
    }
  | JitMintRefusedAttemptUnbound { cause: String }
  | JitMintRefusedRunnerGroupUnrestricted { group: NonEmptyStr, cause: RunnerGroupRestrictionRefusal }
  | JitMintRefusedRunnerGroupForAnotherWorkflow { group: NonEmptyStr, selected: NonEmptyStr, intended: NonEmptyStr }

// THE RUNNER NAME IS THE UNIT NAME, not a fresh identifier minted beside it. A second naming scheme
// for one attempt is a nickname (DESIGN §3), and it is the expensive kind: an orphaned GitHub runner
// registration can only be reconciled against a host by name, so a name that does not appear on the
// host makes the orphan unattributable.
fn jit_runner_name_for(attempt: MicroVmAttempt) -> JitRunnerName {
  JitRunnerName { value: runner_microvm_attempt_unit_name(attempt: attempt) }
}

// THE WORK FOLDER IS GUEST-RELATIVE, not the host attempt directory. The host path is meaningless
// inside the VM, and handing it over would be a path from one namespace asserted in another.
data jit_guest_work_folder: JitWorkFolder = JitWorkFolder { value: "_work" as NonEmptyStr }

// THE LABELS ARE THE ATTEMPT'S OWN, AND NO CALLER CAN HAND IN ANY OTHERS. A microVM attempt answers
// to exactly two labels: the provenance label every self-hosted runner carries, and its OWN
// registration name, which is the attempt's unit name and so names this attempt and no other. It
// does NOT answer to the host's registration set (gunbc.runner_registration_labels), because that
// set is what production jobs target: `[self-hosted, linux, arm64, srv1]` is fleet-desired.yml and
// every srv1-pinned fleet-converge job, and a guest registered under it could take a production
// converge job into a trusted-shakedown VM. So the list is not a parameter: the request is derived
// from the attempt alone, and a job reaches this runner only by naming the attempt in its runs-on --
// the binding gunbc.runner_bound_attempt_receipt already relies on for the mtcollins canary.
//
// WHAT THIS DOES NOT CLOSE, declared rather than assumed. GitHub documents that the runner agent
// applies default labels (self-hosted, OS, architecture) at registration (extdeps.github.actions
// self_hosted_provenance_label's directory row); whether a JIT registration also receives the OS and
// architecture defaults is not modeled here. If it does, this runner would ALSO match
// `[self-hosted, linux, arm64]`, which witnesses.yml, heal.yml and a fleet-converge job use. That arm
// is closed by the runner group, not the label: see microvm_jit_runner_group_restriction_frontier.
fn microvm_attempt_registration_labels(attempt: MicroVmAttempt) -> List<String> {
  [self_hosted_provenance_label, jit_runner_name_for(attempt: attempt).value as String]
}

// THE RUNNER GROUP IS A STANDING, NOT A BARE ID, and the mint refuses every standing but one. The
// org's Default group admits every workflow; if a JIT registration also receives GitHub's OS and
// architecture defaults, a runner there would match witnesses.yml, heal.yml and a fleet-converge
// job. So a mint is authorized only into a group OBSERVED restricted to the shakedown workflow
// file, found by name (gunbc.runner_group_restriction_observation
// microvm_shakedown_runner_group_name) -- its id reaches the request only from that reading. The standing is gunbc.runner_group_restriction_observation
// MicrovmRunnerGroupStanding, whose authorizing arm carries a sole_constructor record only that
// module's observer can write; every other reading is RunnerGroupRestrictionRefused with a named
// cause, which the refusal below carries to the controller unchanged.
fn jit_slot_runner_name(slot: JitSlot) -> JitRunnerName {
  match slot {
    MicroVmJitSlot { attempt: a } => jit_runner_name_for(attempt: a)
    HostUnitJitSlot { slot: h } => JitRunnerName { value: h.unit }
  }
}

// THE WORKFLOW A SLOT EXISTS TO RUN. A restricted group is observed restricted to ONE workflow
// (gunbc.runner_group_restriction_observation RestrictedRunnerGroup selected_workflow), and a slot
// registered into a group restricted to a different workflow would take that workflow's jobs and
// never its own. So the slot carries its intended workflow -- the microVM slot's is the shakedown's,
// derived; a host-unit slot's is its caller's -- and the mint compares the two before it uses the
// group id at all.
fn jit_slot_workflow(slot: JitSlot) -> NonEmptyStr {
  match slot {
    MicroVmJitSlot { attempt: _ } => microvm_shakedown_selected_workflow()
    HostUnitJitSlot { slot: h } => h.workflow
  }
}

fn jit_slot_registration_labels(slot: JitSlot) -> List<String> {
  match slot {
    MicroVmJitSlot { attempt: a } => microvm_attempt_registration_labels(attempt: a)
    HostUnitJitSlot { slot: h } => h.labels
  }
}

data microvm_jit_runner_group_restriction_frontier: DissolutionCondition = unbound_dissolution(
  description: "NAMED CONSUMER: plan_jit_mint, which refuses every RunnerGroupRestrictionRefused (JitMintRefusedRunnerGroupUnrestricted). The controller now passes the sealed observer's result over a live read under its installation token (gunbc.runner_microvm_slot_controller mint_attempt_credential), so the code half of this row's trigger has fired; the remaining half is a fact about the organization, and until it holds every real attempt refuses at the mint with RunnerGroupAbsent. TRIGGER: the organization holds the group microvm_shakedown_runner_group_name restricted to exactly microvm_shakedown_selected_workflow, created by one run of fleet-converge mode microvm_runner_group_ensure (gunbc.runner_group_restriction_ensure_run) under one operator approval, with its readback receipt recorded. SUFFICIENT FOR deleting this row: a JIT registration that received the OS and architecture defaults still cannot take a witnesses.yml, heal.yml or fleet-converge job. Until then every real attempt refuses at the mint." as NonEmptyStr,
)

fn jit_config_request_for(
  slot: JitSlot,
  runner_group_id: JitRunnerGroupId,
) -> JitRunnerConfigRequest {
  JitRunnerConfigRequest {
    name: jit_slot_runner_name(slot: slot),
    runner_group_id: runner_group_id,
    labels: map(jit_slot_registration_labels(slot: slot), l => JitRunnerLabel { value: l as NonEmptyStr }),
    work_folder: jit_guest_work_folder,
  }
}

type JitSlotResolution
  = JitSlotResolved { slot: JitSlot }
  | JitSlotUnresolved { refusal: JitMintPlan }

fn resolve_jit_slot(binding: JitSlotBinding) -> JitSlotResolution {
  match binding {
    MicroVmSlotBinding { binding: b } =>
      match b {
        VmUnboundCellNotOwned { cause: c } => JitSlotUnresolved { refusal: JitMintRefusedCellNotOwned { cause: c } }
        VmBoundToOwnedCell {
          attempt: attempt,
          rootfs_path: _,
          vm_config_path: _,
          unit_name: _,
          slice_property: _,
        } => JitSlotResolved { slot: MicroVmJitSlot { attempt: attempt } }
      }
    HostUnitSlotBinding { standing: st } =>
      match st {
        HostUnitSlotRefused { refusal: r } => JitSlotUnresolved { refusal: JitMintRefusedHostUnitSlot { refusal: r } }
        HostUnitSlotBound { slot: h } => JitSlotResolved { slot: HostUnitJitSlot { slot: h } }
      }
  }
}

fn plan_jit_mint(
  binding: JitSlotBinding,
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  organization: GitHubOrganizationRef,
  runner_group: MicrovmRunnerGroupStanding,
  attempt_binding: JitAdmissionAxisStanding
) -> JitMintPlan {
  match resolve_jit_slot(binding: binding) {
    JitSlotUnresolved { refusal: r } => r
    JitSlotResolved { slot: slot } =>
      if credential_authorizes(
           authority: authority,
           control_plane: control_plane,
           effect: GenerateOrganizationJitConfig { organization: organization }
         ) {
        if attempt_binding_admits_mint_name(standing: attempt_binding) {
          match runner_group {
            RunnerGroupRestrictionRefused { name: n, cause: c } =>
              JitMintRefusedRunnerGroupUnrestricted { group: n, cause: c }
            RunnerGroupRestrictedToWorkflow { restriction: r } =>
              if (r.selected_workflow as String) != (jit_slot_workflow(slot: slot) as String) {
                JitMintRefusedRunnerGroupForAnotherWorkflow {
                  group: r.name,
                  selected: r.selected_workflow,
                  intended: jit_slot_workflow(slot: slot),
                }
              } else {
                JitMintAuthorized {
                  slot: slot,
                  request: jit_config_request_for(slot: slot, runner_group_id: r.group),
                }
              }
          }
        } else {
          JitMintRefusedAttemptUnbound {
            cause: "attempt-binding is not required on the mint name, so a planned credential would not be the attempt's identity",
          }
        }
      } else {
        JitMintRefusedCredential {
          organization: organization.login,
          unsatisfied: unsatisfied_capabilities(
            authority: authority,
            control_plane: control_plane,
            effect: GenerateOrganizationJitConfig { organization: organization },
          ),
        }
      }
  }
}
