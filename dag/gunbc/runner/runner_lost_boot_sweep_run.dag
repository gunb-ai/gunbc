// THE LOST-BOOT SWEEP RUN (fleet-converge mode service_runner_lost_boot_sweep): the production consumer of
// gunbc.runner.runner_jit_deregistration lost_boot_sweep. Authority: ruling
// gunbc.design_ruling mtcollins1_ci_runner_enrolment_approved, and
// fleet_converge_modes_are_outside_the_job_roster for the mode's place in the workflow; the
// registration effect is pre-approved under the dispatching run's authorization (operator ruling
// 2026-10-03) and rowed in gunbc.auth.privileged_effect_census.
//
// THE ORDER IS READ, SELECT, DEREGISTER, READ BACK. The organization listing is read in full (an
// incomplete page refuses inside lost_boot_sweep), the registrations whose embedded boot id is not the
// CURRENT one are selected, and each selected registration goes through ensure_jit_runner_deregistered
// with SlotLostBoot, which succeeds only on absence read back. Current, non-grammar and other-host
// names are never deleted.
//
// THE CAPTURE RECORDS A BOOT; IT DOES NOT ESTABLISH THE CURRENT ONE (review 82195, then the HOLD at
// 82eaac6e). The dispatch input is the path of the sweep host's capture, and the boot id it carries is
// the kernel boot id that gunbc.runner.runner_host_medium runner_host_up_readback_of establishes from a
// closed envelope bound to the sweep host. That is the RECORDED boot. A host that rebooted from A to B
// still has an authentic closed A capture, and sweeping under A would delete B's live registrations. So
// the recorded boot is admitted only by a join to a CurrentBootObservation of the same host and the
// same boot, produced by the host's own observation route; a missing or mismatched observation
// refuses before any credential is read. No operator-typed id, latest-timestamp rule or age threshold
// stands in for that observation.
//
// THE OBSERVATION ROUTE IS THE HOST TRANSPORT, A PARAMETER. lost_boot_observe_current_boot reads
// /proc/sys/kernel/random/boot_id through host_operation_exec (ProcfsReadBootId) over a HostEffectTransport and
// is the only place the evidence is minted. The run reaches the swept host over the one live anchored transport
// (gunbc.host.anchored_host_transport anchored_host_transport_live: the host's known-hosts anchor as the only trusted
// row, the presented key scanned, the operator's go), so a host with no anchor, no go or a presented key that is not
// the anchor's is unobserved and refuses at the join. The read, its refusals and the mint are exercised in
// test.claim.runner.runner_lost_boot_sweep_run_witness. HOST BINDING IS STRUCTURE: the observer takes a
// gunbc.host.host_bound_transport HostBoundTransport, whose host is derived from the transport's address
// through the managed-host join and cannot be stated, so evidence for a host other than the one reached is
// unwritable; see lost_boot_sweep_effect_pairing_frontier for what remains.
//
// TWO ARMS, ONE ADMISSION (gunbc.plans.mtcollins1_ci_service_legs F4). The dry run (fleet-converge mode
// service_runner_lost_boot_sweep_dry_run, lost_boot_sweep_dry_run_wet) admits the current boot, plans against the real
// organization roster and writes the admitted boot and the selection to its receipt; it never reaches
// deregister_selection. The deleting arm (service_runner_lost_boot_sweep, lost_boot_sweep_wet) refuses every dispatch
// before any read while lost_boot_sweep_apply_standing is gated. The dry run's receipt is the minted evidence the
// pairing obligation asks for (lost_boot_sweep_effect_pairing_frontier).
//
// THE CREDENTIAL IS THE RUN'S OWN: the gunbai-ci App key is staged from Secret Manager under the
// run's federated identity, signs the installation-token mint and the control-plane observation, and
// is removed on every arm. No host credential and no env token are read.

data lost_boot_sweep_host_env_name: String = "FLEET_CONVERGE_LOST_BOOT_SWEEP_HOST"
data lost_boot_sweep_capture_path_env_name: String = "FLEET_CONVERGE_HOST_CAPTURE_PATH"
data lost_boot_sweep_wif_access_token_env_name: String = "WIF_ACCESS_TOKEN"
data lost_boot_sweep_runner_temp_env_name: String = "RUNNER_TEMP"
data lost_boot_sweep_key_file_name: String = "lost-boot-sweep-app-key"
data lost_boot_sweep_dry_run_key_file_name: String = "lost-boot-sweep-dry-run-app-key"
data lost_boot_sweep_receipt_path: String = "artifacts/service-runner-lost-boot-sweep-receipt.txt"
data lost_boot_sweep_dry_run_receipt_path: String = "artifacts/service-runner-lost-boot-sweep-dry-run-receipt.txt"
data lost_boot_sweep_attempt_prefix: String = "lost-boot-sweep"
data lost_boot_sweep_artifact_glob: String = "artifacts/service-runner-lost-boot-sweep-*"

data lost_boot_sweep_prelude_allowance: Second = second(count: 120)
data lost_boot_sweep_per_registration_allowance: Second = second(count: 60)
fn lost_boot_sweep_step_timeout_minutes() -> Minute {
  let secs = second_count(s: lost_boot_sweep_prelude_allowance)
    + lost_boot_sweep_registration_ceiling * second_count(s: lost_boot_sweep_per_registration_allowance)
  minute(count: (secs + 59) / 60)
}

// ── The dispatch input ────────────────────────────────────────────────────────────────────────

type LostBootCurrentInput
  = LostBootCurrentPresent { host: NonEmptyStr, boot: ServiceBootId }
  | LostBootCurrentRefused { cause: String }

// WHAT THE HOST'S OWN ROUTE SAYS ITS BOOT IS NOW, of one named host.
// The successful reading is a sole_constructor record, so a UUID alone cannot become evidence: a literal
// outside its one mint is refused, and the mint is admitted only to the observation authority
// (lost_boot_observed_over, reached only from lost_boot_observe_current_boot, which answers unobserved until the
// enrolment supplies a host-bound transport) and to the witness fixture, which is itself restricted to its named terminal claims.
type CurrentBootEvidence sole_constructor {
  host: String
  boot: ServiceBootId
}

type CurrentBootObservation
  = CurrentBootObserved { evidence: CurrentBootEvidence }
  | CurrentBootUnobserved { cause: String }

fn mint_current_boot_evidence(host: String, boot: ServiceBootId) -> CurrentBootEvidence admit_callers: [
  decl_ref(module_path: "gunbc.runner.runner_lost_boot_sweep_run", decl_name: "lost_boot_observed_over"),
  decl_ref(module_path: "test.claim.runner.runner_lost_boot_sweep_run_witness", decl_name: "observed_on"),
  decl_ref(module_path: "test.claim.runner.runner_machine_boot_teardown_witness", decl_name: "observed_boot"),
] {
  CurrentBootEvidence { host: host, boot: boot }
}

// THE OBSERVATION IS THE HOST'S OWN READ of /proc/sys/kernel/random/boot_id (ProcfsReadBootId) over a
// HostEffectTransport the caller holds, and the evidence is minted only here. The transport is a parameter, not
// a constant: a run with no host-authenticated transport to the sweep host (a known-hosts anchor plus an SSH
// credential, each from an executed selection) passes none and answers unobserved, so the mode keeps refusing
// at the join. That transport is the declared frontier the live dry run waits on
// (lost_boot_sweep_effect_pairing_frontier). A refused operation, a failed exit or stdout that is not a kernel
// boot id is unobserved with its own cause, never a boot.
fn lost_boot_observe_current_boot(transport: HostBoundTransport?) -> CurrentBootObservation {
  match transport {
    Absent => CurrentBootUnobserved { cause: "no host-bound transport is held by this run, so its current kernel boot id is not observed" }
    Present { value: t } => lost_boot_observed_over(bound: t, read: host_operation_exec(transport: t.transport, operation: ProcfsReadBootId))
  }
}

// THE EVIDENCE'S HOST IS THE TRANSPORT'S HOST. There is no host parameter to disagree with the bound
// transport, so the only way to ask a machine about a different host is to hold a transport to that host;
// a sweep of host A over a transport to B then reads B's evidence and is refused at the join
// (lost_boot_current_joined). The read outcome is the supplied boundary of the hermetic witnesses; the
// production route is lost_boot_observe_current_boot, and this is its only continuation.
fn lost_boot_observed_over(bound: HostBoundTransport, read: HostOperationOutcome) -> CurrentBootObservation {
  match boot_id_read_verdict(host: bound.host as String, read: read) {
    BootIdReadUnreadable { cause: c } => CurrentBootUnobserved { cause: c }
    BootIdReadEstablished { boot: b } => CurrentBootObserved { evidence: mint_current_boot_evidence(host: bound.host as String, boot: b) }
  }
}

// THE READ'S OUTCOME IS THE SUPPLIED BOUNDARY (DESIGN 3), AND THE VERDICT MINTS NOTHING: a witness supplies
// outcomes to boot_id_read_verdict, whose result is a ServiceBootId and never evidence, so the only mint stays
// inside lost_boot_observe_current_boot and one inhabitance claim runs the dispatch itself.
type BootIdReadVerdict
  = BootIdReadEstablished { boot: ServiceBootId }
  | BootIdReadUnreadable { cause: String }

fn boot_id_read_verdict(host: String, read: HostOperationOutcome) -> BootIdReadVerdict {
  match read {
    HostOperationRefused { operation: _, reason: why } => BootIdReadUnreadable { cause: concat("the boot id read was refused: ", why) }
    HostOperationObserved { stdout: out, success: ok, stderr: _ } =>
      if ok == false {
        BootIdReadUnreadable { cause: join(["the boot id read on ", host, " exited unsuccessfully"], "") }
      } else {
        match uuid_of(text: trim(out)) {
          Absent => BootIdReadUnreadable { cause: join(["the boot id read on ", host, " is not a uuid"], "") }
          Present { value: u } =>
            match service_boot_id_of(run: KernelBootId { boot_id: u }) {
              Absent => BootIdReadUnreadable { cause: join(["the boot id read on ", host, " is not a kernel boot identity"], "") }
              Present { value: b } => BootIdReadEstablished { boot: b }
            }
        }
      }
  }
}

fn lost_boot_current_joined(host: NonEmptyStr, recorded: ServiceBootId, observed: CurrentBootObservation) -> LostBootCurrentInput {
  match observed {
    CurrentBootUnobserved { cause: c } => LostBootCurrentRefused { cause: concat("lost-boot sweep: the capture records a boot but the current boot is unobserved: ", c) }
    CurrentBootObserved { evidence: e } =>
      if e.host != (host as String) {
        LostBootCurrentRefused { cause: join(["lost-boot sweep: the current-boot observation is of host ", e.host, ", not ", host as String], "") }
      } else if (e.boot.boot_id as String) != (recorded.boot_id as String) {
        LostBootCurrentRefused { cause: join(["lost-boot sweep: the capture records boot ", recorded.boot_id as String, " but the host is now on boot ", e.boot.boot_id as String], "") }
      } else {
        LostBootCurrentPresent { host: host, boot: recorded }
      }
  }
}

fn lost_boot_current_from_capture(host: NonEmptyStr, capture: String, observed: CurrentBootObservation) -> LostBootCurrentInput {
  match runner_host_up_readback_of(capture: capture, machine: host, label: runner_host_medium_volume_id) {
    RunnerHostUpPending { reason: r } => LostBootCurrentRefused { cause: concat("lost-boot sweep: the host capture is not a closed envelope: ", r) }
    RunnerHostUpRefused { refusals: rs } => LostBootCurrentRefused { cause: concat("lost-boot sweep: the host capture does not establish runner-host-up: ", join(map(rs, x => runner_host_up_refusal_text(refusal: x)), "; ")) }
    RunnerHostUpObserved { up: up } =>
      match up.run {
        HistoricalAttemptOrdinal { ordinal: _ } => LostBootCurrentRefused { cause: "lost-boot sweep: the host capture names a historical attempt ordinal, not a kernel boot id" }
        KernelBootId { boot_id: u } =>
          match service_boot_id_of(run: KernelBootId { boot_id: u }) {
            Present { value: b } => lost_boot_current_joined(host: host, recorded: b, observed: observed)
            Absent => LostBootCurrentRefused { cause: "lost-boot sweep: the current boot id is not a kernel boot identity" }
          }
      }
  }
}

fn lost_boot_current_input(host: String, capture_path: String, observed: CurrentBootObservation) -> LostBootCurrentInput {
  if host == "" || capture_path == "" {
    LostBootCurrentRefused { cause: join(["lost-boot sweep: ", lost_boot_sweep_host_env_name, " and ", lost_boot_sweep_capture_path_env_name, " are required and never defaulted"], "") }
  } else {
    let read = Filesystem.Read(path: capture_path)
    match filesystem_read_outcome(content: read.content, success: read.success, error: read.error) {
      FilesystemReadRefused { error: e } => LostBootCurrentRefused { cause: concat("lost-boot sweep: the host capture is unreadable: ", e) }
      FilesystemReadSucceeded { content: text } => lost_boot_current_from_capture(host: host as NonEmptyStr, capture: text, observed: observed)
    }
  }
}

// ── One receipt line per runner, and the exit over them ───────────────────────────────────────

fn deregistration_refusal_text(refusal: JitDeregistrationRefusal) -> String {
  match refusal {
    DeregistrationTokenForAnotherInstallation { app: _, installation: _ } => "token-for-another-installation"
    DeregistrationAuthorityForAnotherInstallation => "authority-for-another-installation"
    DeregistrationCredentialRefused { unsatisfied: _ } => "credential-refused"
    DeregistrationListingUnreadable { reason: _, cause: c } => concat("listing-unreadable: ", c as String)
    DeregistrationReadbackForAnotherSubject { organization: _, name: _, app: _, installation: _ } => "readback-for-another-subject"
    DeregistrationRunnerStillListed { ids: ids, deletes: _ } => concat("still-listed ids=", to_string(count(ids)))
  }
}

fn deregistration_line(outcome: JitDeregistration) -> String {
  match outcome {
    JitRunnerDeregistered { receipt: r } =>
      join(["lost-boot-sweep runner=", deregistration_name(subject: r.subject).value as String, " deregistered=absent-on-readback deletes=", to_string(count(r.deletes))], "")
    JitDeregistrationRefused { subject: sub, exit: _, refusal: refusal } =>
      join(["lost-boot-sweep runner=", deregistration_name(subject: sub).value as String, " refused=", deregistration_refusal_text(refusal: refusal)], "")
  }
}

fn untouched_line(name: String) -> String {
  concat("lost-boot-sweep runner=", concat(name, " untouched"))
}

// THE EXIT IS NON-ZERO ON ANY REFUSAL: one line per selected runner, then one per untouched name.
fn sweep_report_lines(outcomes: List<JitDeregistration>, untouched: List<String>) -> List<String> {
  concat(outcomes |> map(o => deregistration_line(outcome: o)), untouched |> map(n => untouched_line(name: n)))
}

fn sweep_all_deregistered(outcomes: List<JitDeregistration>) -> Bool {
  fold(outcomes, init: true, f: (ok, o) => ok && jit_runner_deregistered(result: o))
}

fn population_refusal_text(refusal: CurrentServicePopulationRefusal) -> String {
  match refusal {
    CurrentPopulationWidthUnresolved { cause: _ } => "lost-boot sweep: the current boot's slot population is not derivable: runner width unresolved"
    CurrentPopulationHostNotControlled { refusal: _ } => "lost-boot sweep: the current boot's slot population is not derivable: host not controlled"
    CurrentPopulationSlotRefused { refusal: _ } => "lost-boot sweep: the current boot's slot population is not derivable: a slot was refused"
    CurrentPopulationEmpty => "lost-boot sweep: the current boot's slot population is empty"
  }
}

// ── The standing the sweep is taken under ─────────────────────────────────────────────────────

// THE HOST ENTERS ONLY THROUGH ITS managed_host ROW. A host the corpus does not manage has no standing,
// so the sweep refuses it rather than naming a runner population from a string.
type SweepHostStanding
  = SweepHostBound { host: HostIdentity, standing: HostControlStanding }
  | SweepHostNotManaged { host: String }

fn sweep_host_standing(host: NonEmptyStr) -> SweepHostStanding {
  match managed_host_binding_for(host: host) {
    ManagedHostNotManaged { host: h } => SweepHostNotManaged { host: h as String }
    ManagedHostFound { host: _, control: c } => SweepHostBound { host: host as HostIdentity, standing: bmc_controlled_host(host: host as HostIdentity, standing: c) }
    ManagedHostFoundUnderDeclaredDrop { host: _, control: c, drop: _, standing_subject: _, current_subject: _ } =>
      SweepHostBound { host: host as HostIdentity, standing: bmc_controlled_host(host: host as HostIdentity, standing: c) }
  }
}

// ── The wet entry ─────────────────────────────────────────────────────────────────────────────

fn write_sweep_receipt(lines: List<String>) -> ProcessExit {
  let kept = Filesystem.Write(path: lost_boot_sweep_receipt_path, content: concat(join(lines, "\n"), "\n"))
  if kept.success { ExitSuccess } else { exit_failure(reason: concat("lost-boot sweep: receipt write refused: ", kept.error)) }
}

// THE LIVE OBSERVATION: the one anchored transport to the swept host, then the boot id read over it. A refusal to
// bind is the observation's own cause, so the join refuses with it and nothing past the join runs.
fn lost_boot_live_observation(host: String) -> CurrentBootObservation {
  if host == "" {
    CurrentBootUnobserved { cause: concat(lost_boot_sweep_host_env_name, " is unset, so no host is reached") }
  } else {
    match actions_run_attempt_label_of_run(prefix: lost_boot_sweep_attempt_prefix) {
      Absent => CurrentBootUnobserved { cause: "GITHUB_RUN_ID or GITHUB_RUN_ATTEMPT is unset, so the SSH context has no attempt-owned path" }
      Present { value: label } =>
        match anchored_host_transport_live(host: host as HostIdentity, attempt_raw: label as String) {
          AnchoredBindingBound { bound: b } => lost_boot_observe_current_boot(transport: Present { value: b })
          other => CurrentBootUnobserved { cause: concat("no host-authenticated transport: ", anchored_host_binding_refusal_reason(b: other)) }
        }
    }
  }
}

// THE ADMISSION BOTH ARMS SHARE: both inputs present before the host is contacted, the recorded boot joined to the
// live observation, the run's federation token and RUNNER_TEMP, and the host's managed row. Nothing is staged and
// nothing is read from GitHub before it holds.
type LostBootSweepAdmission
  = SweepAdmitted { host: HostIdentity, standing: HostControlStanding, current: ServiceBootId, wif: Secret, temp: String }
  | SweepNotAdmitted { cause: String }

fn lost_boot_sweep_admission() -> LostBootSweepAdmission {
  let host_name = actions_variable_trimmed(name: lost_boot_sweep_host_env_name)
  let capture_path = actions_variable_trimmed(name: lost_boot_sweep_capture_path_env_name)
  if host_name == "" || capture_path == "" {
    SweepNotAdmitted { cause: join(["lost-boot sweep: ", lost_boot_sweep_host_env_name, " and ", lost_boot_sweep_capture_path_env_name, " are required and never defaulted"], "") }
  } else {
    match lost_boot_current_input(host: host_name, capture_path: capture_path, observed: lost_boot_live_observation(host: host_name)) {
      LostBootCurrentRefused { cause } => SweepNotAdmitted { cause: cause }
      LostBootCurrentPresent { host: admitted, boot } => {
        let wif = actions_variable_trimmed(name: lost_boot_sweep_wif_access_token_env_name)
        let temp = actions_variable_trimmed(name: lost_boot_sweep_runner_temp_env_name)
        if wif == "" || temp == "" {
          SweepNotAdmitted { cause: "lost-boot sweep: the run's federation token or RUNNER_TEMP is unset" }
        } else {
          match sweep_host_standing(host: admitted) {
            SweepHostNotManaged { host } => SweepNotAdmitted { cause: concat("lost-boot sweep: host is not a managed_host row: ", host) }
            SweepHostBound { host, standing } => SweepAdmitted { host: host, standing: standing, current: boot, wif: wif as Secret, temp: temp }
          }
        }
      }
    }
  }
}

// THE DELETING ARM IS GATED BY DECLARATION (gunbc.plans.mtcollins1_ci_service_legs F4). It refuses every dispatch before
// any read until merry-fox-82 relays the operator's go after the dry run has recorded its receipt, and the go is a
// change to this row naming its ruling, never an input of the run. While it is gated the mode reaches no host and
// deletes nothing, so it consumes no fleet SSH key; admitting it moves the mode to FleetSshKeyConsumed with it.
type LostBootSweepApplyStanding
  = SweepApplyGated { reason: NonEmptyStr }
  | SweepApplyAdmitted { ruling: NonEmptyStr }

data lost_boot_sweep_apply_standing: LostBootSweepApplyStanding = SweepApplyGated {
  reason: "GATED: the deleting lost-boot sweep refuses until the operator's go, relayed by merry-fox-82 after the read-only service_runner_lost_boot_sweep_dry_run has recorded its receipt; nothing was read or deleted" as NonEmptyStr,
}

fn lost_boot_sweep_wet() -> ProcessExit
  uses net: Network
{
  match lost_boot_sweep_apply_standing {
    SweepApplyGated { reason: r } => exit_failure(reason: r as String)
    SweepApplyAdmitted { ruling: _ } =>
      match lost_boot_sweep_admission() {
        SweepNotAdmitted { cause } => exit_failure(reason: cause)
        SweepAdmitted { host, standing, current, wif, temp } =>
          sweep_under_staged_key(host: host, standing: standing, current: current, wif: wif, key_path: join([temp, "/", lost_boot_sweep_key_file_name], "") as NonEmptyStr)
      }
  }
}

// ── The dry run: plan against the real roster, record, delete nothing ────────────────────────

// THE RECEIPT RECORDS THE ADMITTED BOOT AND THE PLAN. The first line is the current boot the live observation minted
// and the capture joined; one line per registration the deleting arm would deregister and per name it would leave;
// the last line states that this arm made no deletion request. No token, key or credential is a field of any line.
fn dry_run_boot_line(host: HostIdentity, current: ServiceBootId) -> String {
  join(["lost-boot-sweep-dry-run current-boot host=", host as String, " boot=", current.boot_id as String, " observed=boot-id-over-anchored-transport"], "")
}

fn dry_run_report_lines(host: HostIdentity, current: ServiceBootId, selection: SweepSelection) -> List<String> {
  concat(
    concat([dry_run_boot_line(host: host, current: current)], selection.subjects |> map(sub => join(["lost-boot-sweep-dry-run runner=", deregistration_name(subject: sub).value as String, " would-deregister"], ""))),
    concat(selection.untouched |> map(n => join(["lost-boot-sweep-dry-run runner=", n, " untouched"], "")), ["lost-boot-sweep-dry-run deletion-requests=0"]),
  )
}

fn dry_run_refused_lines(host: HostIdentity, current: ServiceBootId, cause: String) -> List<String> {
  [dry_run_boot_line(host: host, current: current), concat("lost-boot-sweep-dry-run plan-refused: ", cause), "lost-boot-sweep-dry-run deletion-requests=0"]
}

fn write_dry_run_receipt(lines: List<String>) -> ProcessExit {
  let kept = Filesystem.Write(path: lost_boot_sweep_dry_run_receipt_path, content: concat(join(lines, "\n"), "\n"))
  if kept.success { ExitSuccess } else { exit_failure(reason: concat("lost-boot sweep dry run: receipt write refused: ", kept.error)) }
}

fn lost_boot_sweep_dry_run_wet() -> ProcessExit
  uses net: Network
{
  match lost_boot_sweep_admission() {
    SweepNotAdmitted { cause } => exit_failure(reason: cause)
    SweepAdmitted { host, standing, current, wif, temp } =>
      dry_run_under_staged_key(host: host, standing: standing, current: current, wif: wif, key_path: join([temp, "/", lost_boot_sweep_dry_run_key_file_name], "") as NonEmptyStr)
  }
}

// THE KEY IS REMOVED ON EVERY ARM, as in the deleting arm; the token reads the roster and nothing else.
fn dry_run_under_staged_key(host: HostIdentity, standing: HostControlStanding, current: ServiceBootId, wif: Secret, key_path: NonEmptyStr) -> ProcessExit
  uses net: Network
  admit_callers: [decl_ref(module_path: "gunbc.runner.runner_lost_boot_sweep_run", decl_name: "lost_boot_sweep_dry_run_wet")]
{
  match stage_controller_app_key(wif_access_token: wif, key_path: key_path) {
    ControllerKeyNotStaged { cause } => exit_failure(reason: cause)
    ControllerKeyStaged { key } => {
      let exit = match mint_controller_installation_token(installation: gunbai_ci_declared_installation_id, key: key) {
        ControllerTokenNotMinted { performance: _ } => exit_failure(reason: "lost-boot sweep dry run: the gunbai-ci installation token was not minted")
        ControllerTokenMinted { token } => plan_without_deleting(host: host, standing: standing, current: current, token: token)
      }
      match remove_staged_controller_key(key_path: key_path) {
        Present { value: cause } => exit_failure(reason: cause)
        Absent => exit
      }
    }
  }
}

// THE PLAN IS THE DELETING ARM'S OWN (sweep_plan over the same population and the same roster read), so what the dry
// run records is what the deleting arm would select. A refused plan is recorded beside the admitted boot and fails the
// run; a selected one is recorded and the run succeeds having requested no deletion.
fn plan_without_deleting(host: HostIdentity, standing: HostControlStanding, current: ServiceBootId, token: ControllerInstallationToken) -> ProcessExit
  uses net: Network
  admit_callers: [decl_ref(module_path: "gunbc.runner.runner_lost_boot_sweep_run", decl_name: "dry_run_under_staged_key")]
{
  let organization = github_organization_ref()
  match current_service_population(host: standing, boot: current) {
    CurrentServicePopulationRefused { refusal } => exit_failure(reason: population_refusal_text(refusal: refusal))
    CurrentServicePopulationDerived { population } =>
      match sweep_plan(organization: organization, population: population, report: organization_runner_roster_report_via_rest(org: organization.login, page_size: github_max_page_size, token: token.token)) {
        SweepPlanRefused { cause } => {
          let wrote = write_dry_run_receipt(lines: dry_run_refused_lines(host: host, current: current, cause: cause))
          match wrote {
            ExitSuccess => exit_failure(reason: cause)
            ExitFailure { code: _, reason: _ } => wrote
          }
        }
        SweepPlanSelected { selection } => write_dry_run_receipt(lines: dry_run_report_lines(host: host, current: current, selection: selection))
      }
  }
}

// THE KEY IS REMOVED ON EVERY ARM, AND A KEY THAT STAYED FAILS THE RUN beside whatever the sweep
// answered.
fn sweep_under_staged_key(host: HostIdentity, standing: HostControlStanding, current: ServiceBootId, wif: Secret, key_path: NonEmptyStr) -> ProcessExit
  uses net: Network
  admit_callers: [decl_ref(module_path: "gunbc.runner.runner_lost_boot_sweep_run", decl_name: "lost_boot_sweep_wet")]
{
  match stage_controller_app_key(wif_access_token: wif, key_path: key_path) {
    ControllerKeyNotStaged { cause } => exit_failure(reason: cause)
    ControllerKeyStaged { key } => {
      let exit = match mint_controller_installation_token(installation: gunbai_ci_declared_installation_id, key: key) {
        ControllerTokenNotMinted { performance: _ } => exit_failure(reason: "lost-boot sweep: the gunbai-ci installation token was not minted")
        ControllerTokenMinted { token } => {
          let control_plane = observe_github_app_control_plane(
            app: gunbai_ci_declared,
            key: key,
            installation: gunbai_ci_declared_installation_id,
            required: gunbai_ci_registration_goal.required_permissions,
            reason: "the lost-boot sweep observes the gunbai-ci App control plane before deregistering stale registrations" as NonEmptyStr,
          )
          sweep_and_deregister(standing: standing, current: current, token: token, control_plane: control_plane)
        }
      }
      match remove_staged_controller_key(key_path: key_path) {
        Present { value: cause } => exit_failure(reason: cause)
        Absent => exit
      }
    }
  }
}

fn sweep_and_deregister(standing: HostControlStanding, current: ServiceBootId, token: ControllerInstallationToken, control_plane: GitHubAppControlPlaneState) -> ProcessExit
  uses net: Network
  admit_callers: [decl_ref(module_path: "gunbc.runner.runner_lost_boot_sweep_run", decl_name: "sweep_under_staged_key")]
{
  let organization = github_organization_ref()
  match current_service_population(host: standing, boot: current) {
    CurrentServicePopulationRefused { refusal } => exit_failure(reason: population_refusal_text(refusal: refusal))
    CurrentServicePopulationDerived { population } =>
      match sweep_plan(organization: organization, population: population, report: organization_runner_roster_report_via_rest(org: organization.login, page_size: github_max_page_size, token: token.token)) {
        SweepPlanRefused { cause } => exit_failure(reason: cause)
        SweepPlanSelected { selection } => {
          let outcomes = deregister_selection(selection: selection, token: token, control_plane: control_plane, current: current)
          let wrote = write_sweep_receipt(lines: sweep_report_lines(outcomes: outcomes, untouched: selection.untouched))
          if sweep_all_deregistered(outcomes: outcomes) { wrote } else { exit_failure(reason: "lost-boot sweep: at least one selected registration was not deregistered; see the receipt") }
        }
      }
  }
}
