import gunbc.host_converge { gunbc_runner_jobserver_service }

data gunbc_runner_unit_file_scope_disposition: Disposition = SingleAuthority

// THE RUNNER UNIT, MODELLED RATHER THAN COPIED.
//
// `gunbc.runner_unit` already owns what a runner unit is NAMED and, since #9235, what its teardown
// must GUARANTEE -- `RunnerUnitLifecycleIntent` plus `lifecycle_intent_cannot_orphan`, which proves
// that a stop cannot leave a live process behind only when the kill reaches the whole cgroup AND
// systemd does not call the service finished while processes remain. That intent was declared and
// UNROUTED: nothing rendered a unit, so the fleet's live template still carries `KillMode=process`
// and no `ExitType=` at all, and the property the repository had proved was true of nothing.
//
// This module is the missing route. It is the single place a runner unit becomes bytes.
//
// IT IS MODELLED FROM THE EVIDENCE, NOT REPRODUCED FROM IT. The live unit descends from ctrl's
// `host/actions-runner@.service`, and that file is EVIDENCE OF WHAT WAS NEEDED rather than a
// specification to match: ctrl `host/` is being deleted, so reproducing it faithfully -- comments,
// substitution placeholders, redundant defaults and all -- would preserve a corpse and cement its
// accidents (DESIGN §7 rules a byte-identical fixed point out for exactly this reason). Every
// directive below was therefore asked two questions: WHAT FACT IS THIS, and WHERE DOES THAT FACT
// ALREADY LIVE. The answers are what the imports are.
//
// WHAT WAS DROPPED, AND WHY EACH IS A DECISION RATHER THAN AN OMISSION:
//
//   TasksMax=4096 -- NOT dropped as a behavior, dropped as a SECOND AUTHORITY. `gunbc.host_converge`
//   already converges the per-slot task ceiling as the drop-in `50-fleet-tasks.conf`, derived from
//   `RunnerHostDeployment.per_runner_tasks_max`. Rendering it here as well would put one fact in two
//   places, one of which is converged and read back and one of which is not, and a drop-in wins over
//   the unit -- so the unit's copy would be the silent loser of a disagreement nothing could refuse.
//
//   KillSignal=SIGTERM -- systemd's own default for that directive. Restating a default in the file
//   makes the file longer without making any state unreachable.
//
// WHAT WAS KEPT BECAUSE DROPPING IT WOULD HAVE BEEN A SILENT LOSS, and each was measured rather
// than inherited:
//
//   After=/Wants=ctrl-jobserver.service -- the ordering dependency. The unit's MAKEFLAGS hands cargo
//   a jobserver FIFO the daemon owns; without the ordering, a runner that starts first gets a job
//   whose FIRST cargo invocation fails on a FIFO nobody is serving. This was found ABSENT from the
//   live srv1 unit on 2026-08-26 -- the host had drifted to a 28-line file that had lost both lines
//   -- so it is not a directive copied for safety, it is one the fleet is currently missing.
//
//   StartLimitIntervalSec=0 -- an ephemeral runner exits after every job and is restarted, which is
//   normal operation and not failure. systemd's default rate limiter (five starts in ten seconds)
//   would put a busy slot into FAILED and keep it there, so the limiter has to be off for a unit of
//   this shape. Removing it would look like tidying and would stop the fleet under load.
//
//   TimeoutStopSec=5min -- how long a stop is allowed before SIGKILL. It becomes MORE load-bearing
//   under the teardown fix below, not less: `ExitType=cgroup` means the stop now waits on the whole
//   cgroup, so this is the bound on that wait.

// THE ON-HOST APP KEY PATH, WHICH IS THE MATERIALIZATION OF A SECRET THAT ALREADY HAS AN AUTHORITY.
//
// `gunbc.auth.github_apps` `gunbai_ci_app_pem_secret` names the secret; this is where a runner host
// carries the materialized copy that `jit-runner.sh` reads to mint a JIT registration. The two are
// different facts -- one is where the key lives in Secret Manager, the other is where it lands on
// the host -- and until now only the first had a home, so the second was spelled in ctrl's installer
// and in no gunbc carrier at all.
data runner_host_app_pem_path: String = "/etc/actions-runner/app.pem"

// The per-slot working directory is the base directory joined with the systemd instance name, and
// both halves come from their own authority: the base directory from the cited runner dependency,
// the instance specifier from the module that owns systemd's grammar.
fn runner_slot_instance_directory() -> String {
  join([actions_runner_base_dir, "/", systemd_instance_name_specifier], "")
}

// THE ADVERTISED LABELS ARE THE SELECTOR THE WORKFLOWS PIN AGAINST, SO THEY ARE THE SAME VALUE READ
// ONCE, NOT TWO LISTS THAT AGREE TODAY.
//
// A runner registers with a label set and a workflow's `runs-on` selects on it. If the unit spelled
// its own list, the failure of a disagreement would be a job that is queued forever against a label
// nothing advertises -- no diagnostic anywhere, because neither side is wrong on its own terms. So
// the render takes the `RunnerSpec` that `gunbc.ci_deploy_target_host` `host_pinned_runner_spec`
// derives, and this module spells no label literal.
//
// THE TWO NON-SELF-HOSTED SPECS REFUSE, AND THEY REFUSE SEPARATELY, because they are different
// facts with different remedies. A hosted-runner spec names a machine GitHub owns -- there is no
// unit to install and no label set to advertise, so the caller pointed this render at the wrong
// host. A `runs-on` expression is unresolved at this layer: it may well denote a self-hosted label
// set, but nothing here has evaluated it, so the honest answer is that the labels are unknown rather
// than absent. Collapsing them into one absent answer is the not-applicable-rendered-as-malformed
// conflation, and rendering either as an empty JSON array would silently deliver a runner that
// registers with no labels and that no workflow can ever select.
type RunnerUnitLabelsRendering
  = RunnerUnitLabels { json_text: String }
  | RunnerUnitLabelsHostedRunner
  | RunnerUnitLabelsUnresolvedExpression { expression: String }

fn runner_unit_labels_json(spec: RunnerSpec) -> RunnerUnitLabelsRendering {
  match spec {
    SelfHosted { labels: labels } =>
      RunnerUnitLabels {
        json_text: serialize_json(v: json_array(elements: map(labels, l => json_string(s: l)))),
      }
    HostedRunner { label: _ } => RunnerUnitLabelsHostedRunner
    RunsOnExpression { expression: e } => RunnerUnitLabelsUnresolvedExpression { expression: e }
  }
}

// The JSON authority's array separator is ", " rather than ctrl's compact ",". That is a deliberate
// non-chase: the value is consumed by `jq --argjson`, which parses JSON rather than matching bytes,
// so reproducing the compact spelling would mean spelling JSON here instead of asking the module that
// owns it -- the exact fork DESIGN section 3 forbids, bought with nothing.

// `Environment=` values reach the wrapper as-is. The LABELS one is single-quoted because its value
// carries JSON punctuation and systemd's own unquoted parse of such a value is not a thing to rely
// on; every other value here is a bare path, identifier or integer.
fn runner_unit_environment(name: String, value: String) -> SystemdServiceDirective {
  Environment { assignment: join([name, "=", value], "") as NonEmptyStr }
}

fn runner_unit_quoted_environment(name: String, value: String) -> SystemdServiceDirective {
  Environment { assignment: join(["'", name, "=", value, "'"], "") as NonEmptyStr }
}

fn runner_unit_app_environment(app: GithubAppRunnerConfig) -> List<SystemdServiceDirective> {
  [
    runner_unit_environment(name: "APP_ID", value: to_string(app.app.app_id.value)),
    runner_unit_environment(name: "INSTALLATION_ID", value: to_string(app.installation_id.value)),
    runner_unit_environment(name: "ORG", value: github_app_runner_org(config: app) as String),
    runner_unit_environment(name: "PEM", value: runner_host_app_pem_path),
  ]
}

// BOTH JOBSERVER LINES ARE DERIVED FROM ONE PATH, which is what makes them incapable of disagreeing.
// ctrl's own template carries a comment warning that splitting them is what creates a
// silent-misconfig boundary; here they cannot be split, because there is one parameter and the
// MAKEFLAGS spelling comes from the cited jobserver authority rather than from a second literal.
// UNDER THE CUTOVER ARM THERE IS NO MAKEFLAGS, AND THAT ABSENCE IS THE POINT. Invocation-local
// parallelism advertises no shared pool, so handing cargo an auth clause would point it at a FIFO
// nobody serves -- and cargo does not refuse an unrecognised clause, it builds unbounded. The bound
// moves to CARGO_BUILD_JOBS, which cargo applies per invocation and which therefore cannot survive
// the process that read it.
fn runner_unit_jobserver_environment(scope: CompileParallelismRealization) -> List<SystemdServiceDirective> {
  match scope {
    BorrowerHeldCooperativeHostFifo { fifo_path: p, daemon_service: _ } =>
      [
        runner_unit_environment(name: "CTRL_JOBSERVER_FIFO", value: p as String),
        runner_unit_environment(
          name: "MAKEFLAGS",
          value: jobserver_makeflags_fifo_auth(fifo_path: p as String),
        ),
      ]
    InvocationLocalCargo { jobs_per_slot: j } =>
      [
        runner_unit_environment(
          name: "CARGO_BUILD_JOBS",
          value: to_string(hardware_thread_count_value(t: j)),
        ),
      ]
  }
}

// THE ORDERING DEPENDENCY IS PART OF THE SAME FACT, not a constant beside it. Under the host-
// persistent arm a runner that starts before the daemon gets a job whose first cargo invocation
// fails on an unserved FIFO -- the pair was found ABSENT from the live srv1 unit on 2026-08-26.
// Under the invocation-local arm the service does not exist, and a unit ordering itself After a
// unit systemd cannot resolve is a fresh failure introduced by the cutover. So the dependency
// arrives and departs WITH the environment that needs it.
// Two accessors rather than one pair, because the emitted unit interleaves them -- After=network,
// After=daemon, Wants=network, Wants=daemon -- and a single function returning the pair would have
// reordered the file. The bytes are the artifact here (gunbc.generated_artifact_boundary), so a
// refactor that changes them is a change, not a cleanup.
fn runner_unit_jobserver_after(scope: CompileParallelismRealization) -> List<SystemdUnitDirective> {
  match scope {
    BorrowerHeldCooperativeHostFifo { fifo_path: _, daemon_service: svc } => [After { target: svc }]
    InvocationLocalCargo { jobs_per_slot: _ } => []
  }
}

fn runner_unit_jobserver_wants(scope: CompileParallelismRealization) -> List<SystemdUnitDirective> {
  match scope {
    BorrowerHeldCooperativeHostFifo { fifo_path: _, daemon_service: svc } => [Wants { target: svc }]
    InvocationLocalCargo { jobs_per_slot: _ } => []
  }
}

// THE TEARDOWN PAIR IS THE WHOLE POINT OF THIS MODULE, AND IT IS A PARAMETER RATHER THAN A CONSTANT.
//
// Taking the intent as an argument is what lets a witness render the fleet's CURRENT teardown --
// `ExitType=main` implied by its absence, `KillMode=process` -- and show that the same renderer
// produces a unit whose property `lifecycle_intent_cannot_orphan` REFUSES. Fixing the pair here as a
// constant would leave the discriminating case unauthorable, which §4b calls a check that cannot go
// red.
fn runner_unit_teardown_directives(intent: RunnerUnitLifecycleIntent) -> List<SystemdServiceDirective> {
  [
    ServiceExitType { exit_type: intent.exit_type },
    ServiceKillMode { mode: intent.kill_mode },
  ]
}

type RunnerUnitFileRendering
  = RunnerUnitFileRendered { file: SystemdUnitFile }
  | RunnerUnitFileRefused { reason: NonEmptyStr }

fn runner_unit_file(
  deploy: RunnerHostDeploy,
  spec: RunnerSpec,
  permit_scope: CompileParallelismRealization,
  intent: RunnerUnitLifecycleIntent,
) -> RunnerUnitFileRendering {
  match runner_unit_labels_json(spec: spec) {
    RunnerUnitLabelsHostedRunner =>
      RunnerUnitFileRefused {
        reason: "runner_unit_file: the runner spec names a GitHub-hosted runner, so there is no self-hosted unit to install and no label set to advertise; the render was pointed at the wrong host" as NonEmptyStr,
      }
    RunnerUnitLabelsUnresolvedExpression { expression: e } =>
      RunnerUnitFileRefused {
        reason: join([
          "runner_unit_file: the runner spec is an unevaluated runs-on expression (",
          e,
          "), so the label set this unit would register with is unknown rather than empty; resolve the expression before rendering",
        ], "") as NonEmptyStr,
      }
    RunnerUnitLabels { json_text: labels_json } =>
      RunnerUnitFileRendered {
        file: ServiceUnitFile {
          unit: concat(
            [
              Description {
                text: join([
                  "Ephemeral GitHub Actions Runner (",
                  systemd_instance_name_specifier,
                  ")",
                ], "") as NonEmptyStr,
              },
              After { target: "network-online.target" as NonEmptyStr },
            ],
            concat(
              runner_unit_jobserver_after(scope: permit_scope),
              concat(
                [Wants { target: "network-online.target" as NonEmptyStr }],
                concat(
                  runner_unit_jobserver_wants(scope: permit_scope),
                  [StartLimitIntervalSec { duration: "0" as NonEmptyStr }],
                ),
              ),
            ),
          ),
          service: concat(
            concat(
              [
                ServiceType { mode: "simple" as NonEmptyStr },
                ServiceUser { name: deploy.runner_user },
                WorkingDirectory { path: runner_slot_instance_directory() as NonEmptyStr },
              ],
              concat(
                runner_unit_app_environment(app: deploy.app),
                [
                  runner_unit_environment(name: "RUNNER_DIR", value: runner_slot_instance_directory()),
                  runner_unit_environment(name: "RUNNER_NAME_PREFIX", value: systemd_instance_name_specifier),
                  runner_unit_quoted_environment(name: "LABELS_JSON", value: labels_json),
                ],
              ),
            ),
            concat(
              runner_unit_jobserver_environment(scope: permit_scope),
              concat(
                [
                  ExecStart { command: runner_lifecycle_jit_wrapper_path as NonEmptyStr },
                  Restart { policy: "always" as NonEmptyStr },
                  RestartSec { duration: "5" as NonEmptyStr },
                ],
                concat(
                  runner_unit_teardown_directives(intent: intent),
                  [TimeoutStopSec { duration: "5min" as NonEmptyStr }],
                ),
              ),
            ),
          ),
          install: Installable { directives: [WantedBy { target: "multi-user.target" as NonEmptyStr }] },
        },
      }
  }
}

// THE FLEET'S UNIT IS THIS RENDER AT THE DECLARED INTENT, so nothing downstream chooses a teardown.
fn gunbc_runner_unit_file(
  deploy: RunnerHostDeploy,
  spec: RunnerSpec,
  permit_scope: CompileParallelismRealization,
) -> RunnerUnitFileRendering {
  runner_unit_file(
    deploy: deploy,
    spec: spec,
    permit_scope: permit_scope,
    intent: gunbc_runner_lifecycle_intent,
  )
}

type RunnerUnitTextRendering
  = RunnerUnitText { text: String }
  | RunnerUnitTextRefused { reason: NonEmptyStr }

fn runner_unit_text(rendering: RunnerUnitFileRendering) -> RunnerUnitTextRendering {
  match rendering {
    RunnerUnitFileRendered { file: f } => RunnerUnitText { text: serialize_systemd_unit_file(file: f) }
    RunnerUnitFileRefused { reason: r } => RunnerUnitTextRefused { reason: r }
  }
}

data runner_unit_system_path: String = join(["/etc/systemd/system/", runner_unit_template_name as String], "")
