// THE RETIREMENT ROUTE, WHOSE EXECUTOR IS NOT ITS TARGET.
//
// Every other host-scoped mode in `gunbc.fleet_converge_workflow` takes ONE host input and uses it
// three times: as the runner label the job is pinned to, as the Actions concurrency group, and as the
// subject the entry converges. That collapse is invisible while the subject is a healthy host, and it
// is fatal here. Retiring srv2 means removing srv2's runners, so a route that requires a runnable
// srv2 runner to reach srv2 can only ever operate on a host it has not yet finished retiring -- and
// the last slot it retires is the one it is standing on.
//
// SO THE TWO ROLES ARE TWO INPUTS, AND THE REFUSAL IS BETWEEN THEM RATHER THAN INSIDE EITHER.
//
//   EXECUTOR -- where this process runs. A retained host with a working runner. The workflow pins
//               runs-on to this label.
//   TARGET   -- what this process reads and decides about, reached over the fleet SSH edge.
//
// THE RUN MUST NOT SELECT ITS OWN EXECUTION SLOT, and that is checked here as an equality between the
// two inputs rather than assumed from their being different fields. A form with two boxes admits the
// same value in both.
//
// WHY NOT A HOST LABEL ON A PEER. The obvious way to make srv2 schedulable is to add an `srv2` label
// to a runner on some retained host, so `runs-on: [self-hosted, srv2]` resolves. That makes the route
// work and destroys the distinction it exists to carry: a host label denotes WHERE A RUNNER
// EXECUTES, and lending srv2's name to a peer's runner makes every later reader of that label wrong
// about which machine is which. The executor/target split is the repair; a borrowed label is the
// defect wearing the repair's result.
data runner_retirement_executor_env_name: String = "RUNNER_RETIREMENT_EXECUTOR"
data runner_retirement_target_env_name: String = "RUNNER_RETIREMENT_TARGET"
data runner_slot_retire_attempt_raw: String = "runner-slot-retire-ci"
data runner_slot_retire_receipt_path: String = "target/runner-slot-retire-receipt.txt"

// ── THE DISPATCH ADMISSION, WHICH RUNS IN THE BUILD JOB AND NOT IN THIS ONE ──────────────────
//
// THE HOLE THIS CLOSES IS ALREADY ON THE RECORD ONE JOB OVER. `retirement_executor` is
// `required: false`, because it is meaningful for exactly one mode, and its value is interpolated
// into the retirement job's runs-on. A dispatch of `mode=runner_slot_retire` that omits it -- which
// an API or `gh workflow run` dispatch does by supplying "" -- passes the job's `if:` gate and asks
// for labels ["self-hosted","linux","arm64",""]. No runner carries an empty label, so the job QUEUES
// until the backstop and dies with no diagnostic, no receipt and no upload: the entry's own refusal
// in `retirement_route_admission` is never reached, because no step of that job ever exists.
//
// SO THE REFUSAL HAS TO LAND SOMEWHERE THAT IS ALWAYS SCHEDULABLE, which is the build job -- generic
// labels, no interpolation, and every host-scoped job needs it. This is the same construction review
// 61950 required for `reset_observer`, applied to the input that reintroduces its exact failure
// shape; adding a second interpolated optional input without it would have re-opened a closed class.
//
// IT REFUSES WITH A CAUSE RATHER THAN SKIPPING, for the reason the reset gate records: a gate that
// silently declines to run reads as a pass to anyone looking at the job list. The not-this-mode arm
// exits SUCCESSFULLY and says so.
//
// THE TARGET IS CHECKED HERE TOO, though an empty target would not stall the queue -- it would reach
// the entry and refuse there. Checking both in one place means an operator fixes one dispatch rather
// than two.
data runner_slot_retire_dispatch_mode_env: String = "GUNBC_RUNNER_RETIRE_DISPATCH_MODE"
data runner_slot_retire_dispatch_mode_wire: String = "runner_slot_retire"

type RetirementDispatchAdmission
  = RetirementDispatchNotThisMode { mode: String }
  | RetirementDispatchAdmitted { executor: String, target: String }
  | RetirementDispatchUnnamed { cause: String }

fn admit_retirement_dispatch(mode: String, executor: String, target: String) -> RetirementDispatchAdmission {
  if trim(s: mode) != runner_slot_retire_dispatch_mode_wire {
    RetirementDispatchNotThisMode { mode: trim(s: mode) }
  } else if trim(s: executor) == "" {
    RetirementDispatchUnnamed {
      cause: join([
        "mode=", runner_slot_retire_dispatch_mode_wire, " was dispatched without ", runner_retirement_executor_env_name,
        ": the retirement job's runs-on interpolates that label, so an empty value asks for a runner label no machine carries and the job queues until its backstop with no receipt. Re-dispatch naming the RETAINED host whose runner should execute the job -- not the host being retired",
      ], ""),
    }
  } else if trim(s: target) == "" {
    RetirementDispatchUnnamed {
      cause: join([
        "mode=", runner_slot_retire_dispatch_mode_wire, " was dispatched without ", runner_retirement_target_env_name,
        ": a retirement route with no subject would read whichever host it happened to land on",
      ], ""),
    }
  } else if trim(s: executor) == trim(s: target) {
    RetirementDispatchUnnamed {
      cause: join([
        "mode=", runner_slot_retire_dispatch_mode_wire, " names ", trim(s: target),
        " as both executor and target: this run would select its own execution slot. Refused before anything is scheduled, because the job would otherwise be pinned to the machine it is retiring",
      ], ""),
    }
  } else {
    RetirementDispatchAdmitted { executor: trim(s: executor), target: trim(s: target) }
  }
}

fn runner_slot_retire_dispatch_admission_wet() -> ProcessExit
  uses net: Network
{
  let mode_raw = match actions_variable_read(name: runner_slot_retire_dispatch_mode_env) {
    ActionsVariableAbsent { variable: _, detail: _ } => ""
    ActionsVariablePresent { value: v } => v
  }
  let executor_raw = match actions_variable_read(name: runner_retirement_executor_env_name) {
    ActionsVariableAbsent { variable: _, detail: _ } => ""
    ActionsVariablePresent { value: v } => v
  }
  let target_raw = match actions_variable_read(name: runner_retirement_target_env_name) {
    ActionsVariableAbsent { variable: _, detail: _ } => ""
    ActionsVariablePresent { value: v } => v
  }
  match admit_retirement_dispatch(mode: mode_raw, executor: executor_raw, target: target_raw) {
    RetirementDispatchNotThisMode { mode: _ } => ExitSuccess
    RetirementDispatchAdmitted { executor: _, target: _ } => ExitSuccess
    RetirementDispatchUnnamed { cause: c } => exit_failure(reason: join(["runner_slot_retire dispatch refused: ", c], ""))
  }
}

type RetirementRouteSubject {
  executor: NonEmptyStr
  target: HostIdentity
  ssh_target: SshTarget
}

type RetirementRouteAdmission
  = RetirementRouteAdmitted { subject: RetirementRouteSubject }
  | RetirementRouteRefused { cause: String }

// THE HOST MUST BE DECLARED RETIRING BEFORE THIS ROUTE WILL READ IT, which is the third refusal and
// the one that keeps this from becoming a general-purpose remote systemctl. A target with no declared
// retirement has no obligation for this route to assess, and reading one anyway would put a
// retirement-shaped receipt beside a host nobody retired.
fn retirement_route_admission(executor_raw: String, target_raw: String) -> RetirementRouteAdmission {
  let executor = trim(s: executor_raw)
  let target = trim(s: target_raw)
  if executor == "" {
    RetirementRouteRefused {
      cause: join([runner_retirement_executor_env_name, " is empty; the executor label decides where this process runs and cannot be defaulted to the target"], ""),
    }
  } else if target == "" {
    RetirementRouteRefused {
      cause: join([runner_retirement_target_env_name, " is empty; a retirement route with no subject would read whichever host it happened to land on"], ""),
    }
  } else if executor == target {
    RetirementRouteRefused {
      cause: join([
        "the retirement executor and the retirement target are both ", target,
        ": this run would select its own execution slot, so the last slot it retired would be the one it is standing on and the readback would die with the runner that was taking it",
      ], ""),
    }
  } else {
    match host_retirement_standing(host: target as HostIdentity) {
      HostNotRetiring { host: _, cause: c } => RetirementRouteRefused { cause: c }
      HostRetirementDeclared { retirement: r } =>
        RetirementRouteAdmitted {
          subject: RetirementRouteSubject {
            executor: executor as NonEmptyStr,
            target: r.host,
            ssh_target: SshTarget {
              endpoint: fleet_probe_endpoint_for(host: r.host as String) as NonEmptyStr,
              principal: executor_bootstrap_principal.login,
            },
          },
        }
    }
  }
}

// ONE TRANSPORT, ALREADY MODELLED, POINTED AT THE TARGET RATHER THAN AT THIS MACHINE. `FleetSsh` is
// the arm `gunbc.host_operation_exec` already dispatches, so every observer in
// `gunbc.runner_slot_retirement` reaches srv2 through the fleet edge without a line of new transport
// and without anything resident on the subject.
fn retirement_route_transport(
  subject: RetirementRouteSubject,
  context: FleetSshExecutionContext,
) -> HostEffectTransport {
  FleetSsh { target: subject.ssh_target, context: context }
}

// A REQUIRED SUBJECT WITH NO STANDING IS UNOBSERVED, NEVER SKIPPED. `observe_retirement_standings`
// maps over the obligation, so the lists agree today; joining by identity rather than by position
// means they keep agreeing when one of them later does not.
// THE SAME AUTHORITATIVE JOIN THE CLOSURE USES. This folded with last-matching-wins, which is an
// unresolved selection rule rather than a decision: two disagreeing readings for one unit resolved to
// whichever came later. Absence and contradiction now both land on an UNOBSERVED standing, which is
// the arm the invocation fold already treats as pending.
fn standing_for_required(standings: List<RunnerRetirementStanding>, unit: NonEmptyStr) -> RunnerRetirementStanding {
  match authoritative_standing_for(standings: standings, unit: unit as String) {
    StandingUnique { standing: s } => s
    StandingAbsent { unit: u } =>
      RetirementUnobserved {
        unit: u,
        cause: "this required retiree has no standing in this assessment's readback, so nothing is known about it",
      }
    StandingConflicting { unit: u, readings: n } =>
      RetirementUnobserved {
        unit: u,
        cause: join([to_string(n), " disagreeing readings were taken for ", u, " in this assessment, so none of them is authoritative"], ""),
      }
  }
}

fn retirement_evidence_for(target: HostIdentity) -> SlotRetirementEvidence {
  match interruption_authorization_for_host(host: target) {
    HostInterruptionAuthorizationAbsent { host: _, cause: c } => SlotRetirementEvidenceAbsent { cause: c }
    HostInterruptionAuthorizationPresent { authorization: a } =>
      transition_retirement_admission(host: target, auth: a)
  }
}

// ── The reconcile mechanism reading ─────────────────────────────────────────────────────────────

// THREE PROPERTIES, BECAUSE ENABLEMENT ALONE CANNOT ANSWER THE QUESTION. The first version of this
// read only `UnitFileState` and mapped everything that was not `enabled` onto "retired" -- which
// discharges on a blank string, on a spelling it did not recognize, and on a timer that had been
// disabled while still running. systemd documents that `disable` does not stop a unit. The reading is
// now the triple `gunbc.runner_host_retirement` folds, and every leg is three-valued so a refused
// read blocks instead of defaulting to off.
//
// THE TRIGGERED SERVICE IS READ BY NAME, derived from the timer's stem, because a reconcile
// invocation already in flight keeps restoring runners after its timer is gone.
fn reconcile_property_read(transport: HostEffectTransport, unit: NonEmptyStr, property: SystemdUnitProperty) -> ReconcilePropertyReading
  uses net: Network
{
  match systemctl_show_property_read(transport: transport, unit: unit, property: property) {
    SystemdPropertyCaptureRefused { reason: r } => ReconcilePropertyUnreadable { cause: r }
    SystemdPropertyBlank => ReconcilePropertyValue { value: "" }
    SystemdPropertyCaptured { value: v } => ReconcilePropertyValue { value: trim(s: v) }
  }
}

fn observe_reconcile_mechanism_reading(transport: HostEffectTransport) -> ReconcileMechanismReading
  uses net: Network
{
  ReconcileMechanismReading {
    timer_load_state: reconcile_property_read(
      transport: transport,
      unit: runner_liveness_reconcile_timer_unit,
      property: LoadState,
    ),
    timer_unit_file_state: reconcile_property_read(
      transport: transport,
      unit: runner_liveness_reconcile_timer_unit,
      property: UnitFileState,
    ),
    timer_active_state: reconcile_property_read(
      transport: transport,
      unit: runner_liveness_reconcile_timer_unit,
      property: ActiveState,
    ),
    service_active_state: reconcile_property_read(
      transport: transport,
      unit: runner_liveness_reconcile_service_unit,
      property: ActiveState,
    ),
  }
}

// ── The assessment ───────────────────────────────────────────────────────────────────────────────

type RetirementRouteRun {
  subject: RetirementRouteSubject
  basis: RetireeObligationBasis
  discovery: List<NonEmptyStr>
  discovery_standings: List<RunnerRetirementStanding>
  required: List<NonEmptyStr>
  standings: List<RunnerRetirementStanding>
  invocations: List<SlotRetirementInvocation>
  timer: EstateObligationStanding
  timer_reading: ReconcileMechanismReading
}

fn run_retirement_route(
  subject: RetirementRouteSubject,
  context: FleetSshExecutionContext,
) -> RetirementRouteRun
  uses net: Network
{
  let transport = retirement_route_transport(subject: subject, context: context)
  let required = transition_required_retiring(host: subject.target)
  let discovery = host_retirement_discovery_subjects(host: subject.target)
  let standings = observe_retirement_standings(transport: transport, units: required)
  let discovery_standings = observe_retirement_standings(transport: transport, units: discovery)
  let evidence = retirement_evidence_for(target: subject.target)
  let timer_reading = observe_reconcile_mechanism_reading(transport: transport)
  RetirementRouteRun {
    subject: subject,
    basis: host_retirement_obligation_basis(host: subject.target),
    discovery: discovery,
    discovery_standings: discovery_standings,
    required: required,
    standings: standings,
    invocations: map(required, u =>
      slot_retirement_invocation(
        evidence: evidence,
        unit: u,
        standing: standing_for_required(standings: standings, unit: u),
      )),
    timer: reconcile_timer_estate_standing(
      intent: runner_liveness_reconcile_timer_intent(host: subject.target),
      reading: timer_reading,
    ),
    timer_reading: timer_reading,
  }
}

// THE TWO ESTATE OBLIGATIONS THIS ROUTE CANNOT SEE, DECLARED AS UNOBSERVED RATHER THAN OMITTED.
//
// Registration removal is remote GitHub state reached with the App credential, which this job does
// not hold; tree removal is authorized per identity by `slot_removal_realization` inside the reviewed
// plan/apply artifact, not here. Both are real obligations of this retirement and neither is
// discharged by anything above, so they enter the fold as unobserved and the estate standing stays
// outstanding -- which is the whole content of "slot retirement satisfied is not estate cleanup".
fn retirement_route_estate_standings(run: RetirementRouteRun) -> List<EstateObligationStanding> {
  [
    run.timer,
    EstateObligationUnobserved {
      obligation: RegistrationRemoval,
      cause: "this route holds no GitHub App credential, so the organization's registrations for this host are unobserved from here; the removal and its independent readback are a separate authorized write",
    },
    EstateObligationUnobserved {
      obligation: RunnerTreeRemoval,
      cause: "runner tree removal is authorized per identity by slot_removal_realization inside the reviewed plan artifact and executed by fleet apply; this route deliberately does not delete trees, so it can report nothing about them",
    },
  ]
}

// THE ROSTER IS UNOBSERVED FROM HERE AND SAYS SO. This is not a placeholder: it is the state the
// ruling names -- until the complete roster read succeeds the remote registrations are unobserved,
// not four confirmed registrations and not zero -- and feeding it to the closure fold is what makes
// the closure REFUSE to converge rather than silently converge over a roster nobody read.
//
// DECLARED FRONTIER. The producer that replaces this is the App-credentialed roster read; when it
// lands, this function's caller passes the real evidence and `surplus_identity_disposition` gets the
// non-empty population it is written for. Until then the blocker is visible on every receipt.
fn retirement_route_roster_evidence() -> OrganizationRunnerRosterEvidence {
  RosterReadUnavailable {
    reason: "the runner slot retirement route holds no GitHub App credential and performs no organization roster read; the remote registrations for this host are therefore unobserved from this invocation",
  }
}

// THE SUBJECTS WHOSE ONLY REMAINING MODELLED METHOD IS THE UNIMPLEMENTED ONE.
//
// When no operator interruption authorization is bound to this convergence, the disruptive method is
// not available for any subject, and the only other method this module models is
// `GracefulRetirement` -- which refuses explicitly because it is not implemented. Those subjects are
// therefore blocked on an UNIMPLEMENTED METHOD, which is a different blocker from "not yet retired"
// and needs saying: an operator reading only the second would reasonably conclude the remedy is to
// wait, when the remedy is either an exact authorization or L2b.
//
// A SETTLED SUBJECT IS NOT LISTED. A slot whose postcondition already holds needs no method at all,
// and naming an unavailable one against it would manufacture a blocker over a discharged obligation.
fn retirement_route_graceful_subjects(run: RetirementRouteRun) -> List<String> {
  match retirement_evidence_for(target: run.subject.target) {
    SlotRetirementEvidencePresent { authorization: _, standings: _ } => []
    SlotRetirementEvidenceAbsent { cause: _ } =>
      run.invocations
        |> filter(i => !slot_retirement_invocation_settled(i: i))
        |> map(i => slot_retirement_invocation_unit(i: i))
  }
}

// THE PLANNER'S OWN DISPOSITION, WHICH IS WHAT THE CLOSURE ASKS FOR RATHER THAN AN OPERATION COUNT. A
// run that could not read every required subject FILTERED them, whatever its operation list looks
// like, and saying so is the difference between an empty plan that is settled and one that is silent.
// COMPLETENESS IS DECIDED BY THE OBLIGATION BASIS, NOT BY A COUNT.
//
// This asked `list_length(required) == 0` and called an empty population a refusal. That cannot tell
// a COMPLETE capture that genuinely found nothing -- a host whose slot population really is gone --
// from an UNKNOWN one, and after the obligation boundary moved it would have called every ungrounded
// host refused for the wrong reason. The basis already distinguishes the three, so the disposition
// reads it: a grounded population is complete at whatever size it has, including zero, and an
// ungrounded one is UNRESOLVED rather than refused-for-access.
fn retirement_route_emitted_operations(run: RetirementRouteRun) -> Int {
  list_length(
    items: run.invocations |> filter(i => match i {
      SlotRetirementActuate { unit: _, method_label: _, operation: _ } => true
      SlotRetirementAlreadySatisfied { unit: _ } => false
      SlotRetirementPending { unit: _, cause: _ } => false
      SlotRetirementRefused { unit: _, cause: _ } => false
      SlotRetirementSubjectMismatch { unit: _, standing_unit: _ } => false
    }),
  )
}

fn retirement_route_planner_disposition(run: RetirementRouteRun) -> PlannerDisposition {
  match run.basis {
    ObligationAbsent { host: h } =>
      PlannerRefusedAccess {
        cause: join([h as String, " carries no retirement obligation authority at all, so this assessment has no subject"], ""),
      }
    ObligationFromSearchBound { units: us, bound: _, cause: c } =>
      PlannerFilteredSubjects {
        filtered: us,
        cause: join(["the owned-identity population for this host is not grounded, so these identities were observed as DISCOVERY subjects only and none of them entered the obligation: ", c], ""),
      }
    ObligationFromCapturedSnapshot { observed_on: _, units: _ } =>
      PlannerSawCompleteSubject { operations_emitted: retirement_route_emitted_operations(run: run) }
  }
}

// A COMPLETE-EMPTY CAPTURE SETTLES THE SLOT-POPULATION PORTION WITHOUT INVENTING RETIREES, and an
// ungrounded one never settles. The previous test required a non-empty population, which refused a
// genuinely empty host for the same reason it refused an unknown one.
fn retirement_route_succeeded(run: RetirementRouteRun) -> Bool {
  match run.basis {
    ObligationAbsent { host: _ } => false
    ObligationFromSearchBound { units: _, bound: _, cause: _ } => false
    ObligationFromCapturedSnapshot { observed_on: _, units: _ } =>
      all(run.invocations, i => slot_retirement_invocation_settled(i: i))
  }
}

fn invocation_line(i: SlotRetirementInvocation) -> String {
  join([
    "invocation unit=", slot_retirement_invocation_unit(i: i),
    " disposition=", slot_retirement_invocation_wire(i: i),
    " method=", match invocation_method_disposition(i: i) {
      MethodSelectedNotPerformed { method_label: l } => join(["SELECTED-NOT-PERFORMED ", l, " (executed by fleet apply out of the reviewed plan artifact, not by this assessment)"], "")
      MethodNotSelected { reason: r } => join(["<none> ", r], "")
    },
    "\n",
  ], "")
}

fn retirement_route_text(run: RetirementRouteRun) -> String {
  join([
    "executor=", run.subject.executor as String, " target=", run.subject.target as String, "\n",
    "required-subjects=", to_string(list_length(items: run.required)),
    " basis=", retiree_obligation_basis_wire(b: host_retirement_obligation_basis(host: run.subject.target)), "\n",
    "discovery-subjects=", to_string(list_length(items: run.discovery)), " (observed read-only; no obligation)\n",
    join(map(run.discovery_standings, s => join(["discovery unit=", retirement_unit(s: s), " ", retirement_standing_wire(s: s), "\n"], "")), ""),
    join(map(run.standings, s => join(["standing unit=", retirement_unit(s: s), " ", retirement_standing_wire(s: s), "\n"], "")), ""),
    join(map(run.invocations, i => invocation_line(i: i)), ""),
    "reconcile-timer intent=", reconcile_timer_intent_wire(i: runner_liveness_reconcile_timer_intent(host: run.subject.target)),
    " reading=", reconcile_reading_text(reading: run.timer_reading), "\n",
    "planner=", planner_disposition_wire(d: retirement_route_planner_disposition(run: run)), "\n",
    "graceful-method=", match retirement_method_availability(method: GracefulRetirement, unit: run.subject.target as String) {
      MethodAvailable { method: _ } => "available"
      MethodUnavailable { method_label: l, cause: c } => join([l, " UNAVAILABLE ", c], "")
    }, "\n",
  ], "")
}

// ── The CI entry ─────────────────────────────────────────────────────────────────────────────────

// ── WHAT REVISION THIS ASSESSMENT ACTUALLY RAN AGAINST ───────────────────────────────────────
//
// THE EVENT BINDING IS NOT A CHECKOUT OBSERVATION, AND AN EARLIER REPAIR TREATED IT AS ONE.
//
// `observe_actions_run_binding` reads `GITHUB_SHA` into `binding.run_revision`, and
// `admit_run_revision` compares that to `RLM_EXPECTED_REVISION`. GitHub defines `GITHUB_SHA` as the
// commit of the TRIGGERING EVENT. So the pair establishes exactly one thing -- event revision equals
// expected revision -- and the comment beside it claimed it established that the source and the
// executable used for the assessment correspond to that revision. It does not, and the job's other
// candidate is not one either: `claim_executor --verify-build-artifacts` checks that each path is a
// file, is executable and is nonempty, and says nothing about revision or build identity.
//
// THREE SEPARATE FACTS, KEPT SEPARATE:
//
//   EVENT      -- GITHUB_SHA versus the operator-selected R. Already checked; retained.
//   CHECKOUT   -- what `git rev-parse HEAD` reports in the tree this process is reading. Observed
//                 here, and a disagreement REFUSES: this job checks out
//                 `expected_revision || github.ref`, so the checkout is the fact that actually
//                 decides which sources produced the assessment.
//   EXECUTABLE -- which revision built the binary performing the assessment. THERE IS NO PRODUCER
//                 FOR THIS. Nothing in this repository binds a release binary to the revision that
//                 built it, so the honest state is unresolved, and it is carried as a named blocker
//                 rather than asserted or omitted. The run identity travels on the receipt so the
//                 eventual package can join this assessment to its actual producer.
type CheckoutRevisionReading
  = CheckoutRevisionRead { revision: String }
  | CheckoutRevisionUnreadable { cause: String }

fn observe_checkout_revision() -> CheckoutRevisionReading {
  let head = git.Inspect.HeadCommit(expect: ExpectSuccess)
  if !head.success || (head.sha as String) == "" {
    CheckoutRevisionUnreadable {
      cause: "git.Inspect.HeadCommit refused or returned an empty revision, so the tree this assessment read cannot be identified",
    }
  } else {
    CheckoutRevisionRead { revision: head.sha as String }
  }
}

type RevisionCorroboration
  = RevisionCorroborated { revision: String }
  | RevisionCorroborationRefused { cause: String }

fn corroborate_checkout_revision(expected: String, reading: CheckoutRevisionReading) -> RevisionCorroboration {
  match reading {
    CheckoutRevisionUnreadable { cause: c } => RevisionCorroborationRefused { cause: c }
    CheckoutRevisionRead { revision: r } =>
      if trim(s: r) == trim(s: expected) {
        RevisionCorroborated { revision: trim(s: r) }
      } else {
        RevisionCorroborationRefused {
          cause: join([
            "the checked-out revision is ", trim(s: r), " but the operator selected ", trim(s: expected),
            "; the event SHA agreeing with the selection does not make the tree this assessment read the selected one",
          ], ""),
        }
      }
  }
}

// THE BUILD PROVENANCE BLOCKER IS NOW A JOIN, AND IT BLOCKS ONLY WHEN THE JOIN REFUSES.
//
// The first version of this route carried an unconditional blocker under the subject
// `assessment-build-provenance`: no producer bound the executable performing the assessment to
// the revision that built it, so every assessment was blocked on its own provenance. The join is
// gunbc.build_provenance_join: the running interpreter reports the source commit compiled into it
// (`gunbc.Cli.RunningVersion` over /proc/self/exe, so the report is of the process evaluating this
// route and not of a path), and that commit must equal the revision this run admitted and
// corroborated above. Three refusals keep their own arms -- built from another commit, built
// dirty, identity unobserved -- and each becomes one blocker under the same subject, so a closure
// reading the receipt sees WHICH provenance fact failed. All agree -> no blocker, which is the only
// way this subject leaves the blocker list.
fn build_provenance_blockers(verdict: BuildProvenanceJoin, run_id: String) -> List<ClosureBlocker> {
  if build_provenance_join_holds(verdict: verdict) {
    []
  } else {
    [ClosureBlocker {
      subject: "assessment-build-provenance",
      cause: join([build_provenance_join_text(verdict: verdict), " (run ", run_id, ")"], ""),
    }]
  }
}

// THE EXIT STATUS MAY NEVER BE MORE OPTIMISTIC THAN THE ASSESSMENT.
//
// The previous version decided the process status from `retirement_route_succeeded` alone and spliced
// the verdict into the receipt as text, reasoning that a bounded per-host execution cannot establish
// the closure package and so must not let its exit code claim one. That reasoning is right and it
// justified the wrong asymmetry: it argued against a green exit CLAIMING the closure, and what it
// produced was a green exit ALONGSIDE a fold that says BLOCKED.
//
// The failure is reachable and it is the direction that matters. Once srv2's units are actually
// masked, stopped and quiescent, every invocation is `SlotRetirementAlreadySatisfied`,
// `retirement_route_succeeded` is true, and the step exits zero -- while the receipt still carries
// `assessment=BLOCKED` over an unread GitHub roster and an unresolved build provenance. The green is
// what an operator and the next lane read; the refusal is a string inside an uploaded file. DESIGN
// section 6 names that tier exactly: the machinery exists and nothing gates on it, and an inert lens
// is itself a lie.
//
// SO THE TERMINAL IS A CONJUNCTION, AND THE TWO HALVES STILL MEAN DIFFERENT THINGS. A blocked
// assessment forces a non-zero exit, because this run must never report success over its own refusal.
// A clear assessment does NOT mint the closure -- that is still a join across a plan artifact,
// authorized apply receipts, an independent readback and a second assessment at one revision, and it
// is not this process's to claim. The exit says "this invocation found nothing outstanding that it
// could see"; the verdict says what it could see.
type RetirementRouteTerminal
  = RouteSettled
  | RouteRefused { cause: String }

fn retirement_route_terminal(
  succeeded: Bool,
  verdict: RetirementAssessmentVerdict,
) -> RetirementRouteTerminal {
  if !succeeded {
    RouteRefused {
      cause: "not every required subject of this host is settled",
    }
  } else if !assessment_is_clear_of_blockers(v: verdict) {
    RouteRefused {
      cause: "every required subject is settled and this assessment still carries blockers; exiting zero here would report success over this run's own refusal",
    }
  } else {
    RouteSettled
  }
}

fn retirement_route_terminal_wire(t: RetirementRouteTerminal) -> String {
  match t {
    RouteSettled => "settled"
    RouteRefused { cause: c } => join(["REFUSED ", c], "")
  }
}

fn retirement_route_terminal_is_settled(t: RetirementRouteTerminal) -> Bool {
  match t {
    RouteSettled => true
    RouteRefused { cause: _ } => false
  }
}

fn runner_slot_retire_ci_wet() -> ProcessExit
  uses net: Network
{
  match observe_actions_run_binding() {
    ActionsRunUnbound { variable: v, detail: d } =>
      exit_failure(reason: join(["runner_slot_retire: RunUnbound -- ", v, " ", d, "; this mode mints a run-bound receipt and runs only inside the fleet-converge workflow"], ""))
    ActionsRunBound { binding: run } =>
      match read_expected_revision() {
        ExpectedRevisionAbsent { variable: v, detail: d } =>
          exit_failure(reason: join(["runner_slot_retire: ExpectedRevisionAbsent -- ", v, " ", d, "; an assessment whose revision is not the operator-selected R cannot be joined into a closure at R"], ""))
        ExpectedRevisionPresent { revision: expected_r } =>
          match admit_run_revision(binding: run, expected: expected_r) {
            RunRevisionRefused { expected: e, observed: o } =>
              exit_failure(reason: join(["runner_slot_retire: RunRevisionRefused -- the operator selected ", e, " but this run's own revision is ", o, "; refusing rather than attaching an uncorroborated revision to the receipt"], ""))
            RunRevisionAdmitted { revision: revision } =>
              match corroborate_checkout_revision(expected: revision, reading: observe_checkout_revision()) {
                RevisionCorroborationRefused { cause: c } =>
                  exit_failure(reason: join(["runner_slot_retire: CheckoutRevisionRefused -- ", c], ""))
                RevisionCorroborated { revision: checked_out } =>
                  runner_slot_retire_bound_wet(revision: checked_out, run_id: run.run_id)
              }
          }
      }
  }
}

fn runner_slot_retire_bound_wet(revision: String, run_id: String) -> ProcessExit
  uses net: Network
{
  match actions_variable_read(name: runner_retirement_executor_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: join(["runner_slot_retire: ", v, " ", d], ""))
    ActionsVariablePresent { value: executor_raw } =>
      match actions_variable_read(name: runner_retirement_target_env_name) {
        ActionsVariableAbsent { variable: v, detail: d } =>
          exit_failure(reason: join(["runner_slot_retire: ", v, " ", d], ""))
        ActionsVariablePresent { value: target_raw } =>
          match retirement_route_admission(executor_raw: executor_raw, target_raw: target_raw) {
            RetirementRouteRefused { cause: c } => exit_failure(reason: join(["runner_slot_retire: ", c], ""))
            RetirementRouteAdmitted { subject: subject } =>
              match prepare_fleet_ssh_agent_context(attempt_raw: runner_slot_retire_attempt_raw) {
                FleetSshContextRefused { cause: c } => exit_failure(reason: join(["runner_slot_retire: ", c], ""))
                FleetSshContextReady { context: context, receipt: context_receipt } => {
                  let run = run_retirement_route(subject: subject, context: context)
                  let provenance = join_build_provenance(expected: revision, reading: observe_running_seed_identity())
                  let verdict = retirement_assessment_verdict(
                    revision: revision as NonEmptyStr,
                    host: subject.target,
                    roster: retirement_route_roster_evidence(),
                    required: run.required,
                    standings: run.standings,
                    method_subjects: retirement_route_graceful_subjects(run: run),
                    method_availability: retirement_method_availability(method: GracefulRetirement, unit: subject.target as String),
                    planner: retirement_route_planner_disposition(run: run),
                    basis: run.basis,
                    obligation_population: transition_required_retiring(host: subject.target),
                    extra: build_provenance_blockers(verdict: provenance, run_id: run_id),
                    estate: estate_cleanup_standing(standings: retirement_route_estate_standings(run: run)),
                  )
                  let terminal = retirement_route_terminal(
                    succeeded: retirement_route_succeeded(run: run),
                    verdict: verdict,
                  )
                  let body = join([
                    "runner_slot_retire probed_at=", probed_at_word(reading: clock_now_probed_at()) as String, "\n",
                    "revision=", revision, " run_id=", run_id, "\n",
                    "executable_build_provenance=", build_provenance_join_text(verdict: provenance), "\n",
                    context_receipt,
                    retirement_route_text(run: run),
                    assessment_verdict_text(v: verdict),
                    "terminal=", retirement_route_terminal_wire(t: terminal), "\n",
                  ], "")
                  let w = Filesystem.Write(path: runner_slot_retire_receipt_path, content: body)
                  if w.success == false {
                    exit_failure(reason: join(["runner_slot_retire: receipt write failed: ", w.error, "\n", body], ""))
                  } else if retirement_route_terminal_is_settled(t: terminal) == false {
                    exit_failure(reason: body)
                  } else {
                    ExitSuccess
                  }
                }
              }
          }
      }
  }
}
