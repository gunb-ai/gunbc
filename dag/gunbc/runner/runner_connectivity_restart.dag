module gunbc.runner.runner_connectivity_restart

import std.types { Bool, String, NonEmptyStr }
import std.disposition { ConstructionMechanism, SingleAuthority }
import gunbc.fleet.fleet_runner_connectivity {
  RunnerSlotConnectivityVerdict, RunnerSlotIdentity,
  SlotConnectivityHealthy, SlotConnectivityDetached, SlotConnectivityLabelsDiverge,
  SlotConnectivityOrphaned, SlotConnectivityUnknown, SlotConnectivityUnexpectedRegistration,
}
import gunbc.runner.runner_lost_agent { LostAgentObservation, LostAgentDetected, lost_agent_slot_is_reclaimable }

data runner_connectivity_restart_authority_disposition: ConstructionMechanism = SingleAuthority

// THE RESTART LEG'S DECISION, ISOLATED FROM ITS EFFECT. This is a pure gate: given what the connectivity
// join says about a slot and what the lost-agent observer says about that slot's job, may the slot be
// restarted? The effect (runner_slot_actuation.restart_runner_slot_over, read back on a changed MainPID)
// is separate, and the realization that runs both is separate again. Keeping the gate here, pure, is
// what lets every disposition be witnessed without an SSH leg.
//
// IT RESTARTS ONLY DETACHED, ORPHANED, OR LOST. Everything else refuses, and the refuses are as
// load-bearing as the permits:
//   - HEALTHY is a slot that is doing its job; restarting it is a self-inflicted wedge.
//   - LABELS_DIVERGE is a label mismatch — the remedy is a re-label, not a process cycle. Restarting a
//     slot to fix labels would look like progress while hiding the actual defect.
//   - UNKNOWN (which is where an UNRESOLVED registration or an UNREADABLE read lands) is a slot we have
//     not actually seen. DESIGN section 5: could-not-see is never a verdict, and here it is certainly
//     never a permission to act.
//   - UNEXPECTED_REGISTRATION is not a local slot at all; there is nothing here to restart.
// A full LOST-AGENT detection is its OWN positive trigger, independent of the verdict: the runner process
// may look up-and-running to systemd and the roster (so the verdict is not Detached) while a job sits
// stranded against the slot with no agent — exactly the case the verdicts cannot express. A lost-agent
// read that was REFUSED (a field we could not see) is not a detection and confers no permission.

type RestartLegDecision
  = RestartLegPermit { slot: RunnerSlotIdentity, why: NonEmptyStr }
  | RestartLegRefuse { why: NonEmptyStr }

fn restart_leg_decision(verdict: RunnerSlotConnectivityVerdict, lost: LostAgentObservation) -> RestartLegDecision {
  if lost_agent_slot_is_reclaimable(obs: lost) {
    match verdict {
      // A lost-agent detection on a slot we can name reclaims it even when the verdict is not itself a
      // restart case (the runner process is up; the job is stranded). A verdict that cannot name a slot
      // (UnexpectedRegistration) is not reclaimed on a lost-agent signal — there is no local slot to take.
      SlotConnectivityDetached { slot: s, registration_id: _ } => RestartLegPermit { slot: s, why: "the job was stranded against a detached slot" }
      SlotConnectivityOrphaned { slot: s } => RestartLegPermit { slot: s, why: "the job was stranded against an orphaned slot" }
      SlotConnectivityHealthy { slot: s, registration_id: _ } => RestartLegPermit { slot: s, why: "the slot reports online but its job never reached an agent (lost agent)" }
      SlotConnectivityLabelsDiverge { slot: s, registration_id: _ } => RestartLegPermit { slot: s, why: "the slot's job never reached an agent (lost agent), notwithstanding its labels" }
      SlotConnectivityUnknown { slot: s, reason: _ } => RestartLegPermit { slot: s, why: "the slot's job never reached an agent (lost agent), notwithstanding the unreadable roster read" }
      SlotConnectivityUnexpectedRegistration { registration_id: _, registration_name: _, decoded: _ } =>
        RestartLegRefuse { why: "a lost-agent signal cannot authorize a restart on a registration that is not a local slot" }
    }
  } else {
    match verdict {
      SlotConnectivityDetached { slot: s, registration_id: _ } => RestartLegPermit { slot: s, why: "the slot's registration is offline (detached)" }
      SlotConnectivityOrphaned { slot: s } => RestartLegPermit { slot: s, why: "the slot has no registration GitHub will acknowledge (orphaned)" }
      SlotConnectivityHealthy { slot: _, registration_id: _ } => RestartLegRefuse { why: "the slot is healthy; a restart would be a self-inflicted wedge" }
      SlotConnectivityLabelsDiverge { slot: _, registration_id: _ } => RestartLegRefuse { why: "labels diverge is a re-label, not a process restart" }
      SlotConnectivityUnknown { slot: _, reason: r } => RestartLegRefuse { why: concat("the slot's connectivity is unknown, not actionable: ", r) }
      SlotConnectivityUnexpectedRegistration { registration_id: _, registration_name: _, decoded: _ } => RestartLegRefuse { why: "the registration is not a local slot; there is nothing here to restart" }
    }
  }
}

fn restart_leg_permits(decision: RestartLegDecision) -> Bool {
  match decision {
    RestartLegPermit { slot: _, why: _ } => True
    RestartLegRefuse { why: _ } => False
  }
}
