module gunbc.runner_microvm_attempt

import std.types { String, NonEmptyStr, Bool, List }
import std.disposition { Disposition, SingleAuthority }
import extdeps.systemd { SystemdUnitProperty, SliceProperty }
import extdeps.systemd.systemd_run { SystemdRunProperty }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.fabric_cell_converge {
  fabric_cell_attempt_root_path, fabric_cell_slice_name,
}

data runner_microvm_attempt_disposition: Disposition = SingleAuthority

// A GUEST IS RESOURCES BELONGING TO ONE OWNED ATTEMPT, NOT A VM AT A FIXED PATH.
//
// gunbc.runner.runner_microvm_boot_probe deliberately runs OUTSIDE the fabric-cell path: one probe
// rootfs, one probe config, both at paths derived from the executor's home. That was correct for
// answering "does this image boot" and it is the wrong shape for running a job, which a review of
// the microVM lane stated directly: changing the guest command from "print version" to "start
// runner" is not the integration. A runner started that way executes inside a VM that no
// reservation owns, whose storage no attempt accounts for, and whose exit releases nothing.
//
// THE THREE BINDINGS THAT MAKE A GUEST THE ATTEMPT'S, rather than merely concurrent with it:
//
//   STORAGE   every writable file the guest touches lives under the attempt root, so a second
//             attempt cannot inherit bytes the first wrote and cleanup has ONE subtree to prove
//             empty rather than a fixed path shared by every attempt that ever ran.
//   BOUNDARY  the VMM runs in the cell's slice, so the guest's CPU, memory and task consumption is
//             accounted to the cell that was reserved -- a VM outside the slice is invisible to
//             every limit the cell carries and to every observation that reads them.
//   LIFETIME  the cell is not releasable until teardown is PROVEN, not attempted.
//
// A guest missing any one of these is refused rather than downgraded, because each failure is
// silent in production: unbound storage looks like a working VM until two attempts collide,
// unbound accounting looks like a working VM until the host runs out of memory, and unproven
// teardown looks like a working VM until a leaked VMM outlives its cell.
type MicroVmAttempt {
  slot: RunnerSlotIdentity
  attempt_id: NonEmptyStr
}

fn runner_microvm_attempt_dir(attempt: MicroVmAttempt) -> String {
  join([
    fabric_cell_attempt_root_path(slot: attempt.slot),
    "/",
    attempt.attempt_id as String,
  ], "")
}

fn runner_microvm_attempt_rootfs_path(attempt: MicroVmAttempt) -> String {
  join([runner_microvm_attempt_dir(attempt: attempt), "/rootfs.ext4"], "")
}

fn runner_microvm_attempt_jit_drive_path(attempt: MicroVmAttempt) -> String {
  join([runner_microvm_attempt_dir(attempt: attempt), "/jit.img"], "")
}

fn runner_microvm_attempt_vm_config_path(attempt: MicroVmAttempt) -> String {
  join([runner_microvm_attempt_dir(attempt: attempt), "/vm-config.json"], "")
}

// THE VMM'S TRANSIENT UNIT NAMES THE ATTEMPT, so a leaked unit says which attempt leaked it. A
// name derived from the slot alone would collide across attempts on one slot, which is the case a
// leak check most needs to tell apart.
fn runner_microvm_attempt_unit_name(attempt: MicroVmAttempt) -> NonEmptyStr {
  join([
    "gunbc-microvm-",
    runner_slot_instance_name(slot: attempt.slot),
    "-",
    attempt.attempt_id as String,
  ], "") as NonEmptyStr
}

// Slice= IS THE BINDING, AND IT IS THE ONE THAT CANNOT BE ADDED AFTERWARDS. A process placed in a
// slice at start lives under that slice's limits for its whole life; moving a running VMM into a
// cgroup later is a different operation with different guarantees and no atomicity. So the property
// travels with the launch or the launch is wrong.
fn runner_microvm_attempt_slice_property(attempt: MicroVmAttempt) -> SystemdRunProperty {
  SystemdRunProperty {
    property: SliceProperty,
    value: fabric_cell_slice_name(slot: attempt.slot) as NonEmptyStr,
  }
}

// THE CELL MUST BE OWNED BEFORE A GUEST MAY USE IT, and this is a REFUSAL rather than a warning.
// gunbc.fabric_required_build_cell already decides ownership over cell members; this consumes that
// verdict instead of re-deriving one, because a second ownership opinion is a second authority for
// the fact the cell layer exists to hold.
type MicroVmCellBinding
  = VmBoundToOwnedCell {
      attempt: MicroVmAttempt
      rootfs_path: String
      jit_drive_path: String
      vm_config_path: String
      unit_name: NonEmptyStr
      slice_property: SystemdRunProperty
    }
  | VmUnboundCellNotOwned { cause: String }

fn bind_microvm_to_cell(attempt: MicroVmAttempt, cell_owned: Bool) -> MicroVmCellBinding {
  if cell_owned {
    VmBoundToOwnedCell {
      attempt: attempt,
      rootfs_path: runner_microvm_attempt_rootfs_path(attempt: attempt),
      jit_drive_path: runner_microvm_attempt_jit_drive_path(attempt: attempt),
      vm_config_path: runner_microvm_attempt_vm_config_path(attempt: attempt),
      unit_name: runner_microvm_attempt_unit_name(attempt: attempt),
      slice_property: runner_microvm_attempt_slice_property(attempt: attempt),
    }
  } else {
    VmUnboundCellNotOwned {
      cause: join([
        "the fabric cell for ",
        runner_slot_instance_name(slot: attempt.slot),
        " is not owned, so no guest may consume it; a VM launched here would run outside every limit the cell carries",
      ], ""),
    }
  }
}

// TEARDOWN IS PROVEN, NOT ATTEMPTED, AND THE CELL IS NOT RELEASABLE WITHOUT THE PROOF.
//
// The arms are separate because they are different events with different remedies. A VMM that
// exited but left its attempt directory populated is a cleanup bug; a VMM still running is a
// LEAK, and releasing the cell under it would hand a reserved boundary to a second guest while the
// first still executes in it. There is deliberately no arm meaning "probably fine".
type MicroVmTeardownVerdict
  = TeardownProven
  | TeardownVmmStillRunning { unit: NonEmptyStr }
  | TeardownResidueRemains { path: String }
  | TeardownNotObserved { cause: String }

fn microvm_cell_releasable(verdict: MicroVmTeardownVerdict) -> Bool {
  match verdict {
    TeardownProven => true
    TeardownVmmStillRunning { unit: _ } => false
    TeardownResidueRemains { path: _ } => false
    TeardownNotObserved { cause: _ } => false
  }
}

fn microvm_teardown_verdict_text(v: MicroVmTeardownVerdict) -> String {
  match v {
    TeardownProven => "teardown=proven"
    TeardownVmmStillRunning { unit: u } =>
      join(["teardown=REFUSED vmm still running (", u as String, "); releasing the cell would hand a live boundary to a second guest"], "")
    TeardownResidueRemains { path: p } =>
      join(["teardown=REFUSED residue remains at ", p], "")
    TeardownNotObserved { cause: c } =>
      join(["teardown=REFUSED not observed (", c, "); an unobserved teardown is not a completed one"], "")
  }
}
