  JitMintPlan, JitMintAuthorized, JitMintRefusedCellNotOwned, JitMintRefusedCredential,
  plan_jit_mint,
}

data runner_microvm_launch_plan_disposition: Disposition = SingleAuthority

// MINTING IS LAST, AND THE ORDER IS THE WHOLE REASON THIS MODULE EXISTS RATHER THAN ITS CALLERS
// COMPOSING THE FOUR STAGES THEMSELVES.
//
// A JIT mint is not a local computation: it creates a RUNNER IDENTITY AT GITHUB. Every other stage
// here is pure and free to fail -- an unowned cell, an unresolved size, a topology that can orphan
// its VMM -- but if any of them refuses AFTER a mint, the identity is already registered against an
// organization for a VM that will never start. Nothing on this host then knows to delete it,
// because the plan that would have named it refused. Orphaned registrations accumulate silently,
// count against the org, and are reconcilable only by name.
//
// So the mint is the LAST stage, and it is not merely "called last": its authorized value is
// reachable only from inside LaunchAdmitted, so a caller cannot hold a mint authorization for a
// launch that was refused. Ordering enforced by an author remembering it is exactly the arrangement
// that produced the ownership-before-credential defect this fleet already paid for.
//
// THE REFUSAL ARMS ARE NOT COLLAPSED INTO ONE `cause` STRING. Each names the authority that owns
// the remedy -- the cell belongs to gunbc.fabric_required_build_cell, the size to
// gunbc.runner_slot_allocation, the topology to gunbc.runner_unit, the credential to
// gunbc.auth.github_credential -- because collapsing them is the state-space conflation DESIGN
// names, and it sends an operator to the wrong module.
type MicroVmLaunchPlan
  = LaunchAdmitted {
      attempt: MicroVmAttempt
      config: FirecrackerVmConfig
      unit_name: NonEmptyStr
      slice_property: SystemdRunProperty
      rootfs_path: String
      jit_drive_path: String
      mint_endpoint_path: String
      mint_request: JitRunnerConfigRequest
    }
  | LaunchRefusedGrant { cause: String }
  | LaunchRefusedCell { cause: String }
  | LaunchRefusedConfig { cause: String }
  | LaunchRefusedAdmission { reason: String }
  | LaunchRefusedCredential {
      organization: NonEmptyStr
      unsatisfied: List<CredentialCapability>
    }

fn launch_after_admission(
  attempt: MicroVmAttempt,
  binding: MicroVmCellBinding,
  config: FirecrackerVmConfig,
  unit_name: NonEmptyStr,
  slice_property: SystemdRunProperty,
  rootfs_path: String,
  jit_drive_path: String,
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  organization: GitHubOrganizationRef,
  runner_group_id: JitRunnerGroupId,
  labels: List<JitRunnerLabel>,
) -> MicroVmLaunchPlan {
  match plan_jit_mint(
    binding: binding,
    authority: authority,
    control_plane: control_plane,
    organization: organization,
    runner_group_id: runner_group_id,
    labels: labels,
  ) {
    JitMintRefusedCellNotOwned { cause: c } => LaunchRefusedCell { cause: c }
    JitMintRefusedCredential { organization: org, unsatisfied: u } =>
      LaunchRefusedCredential { organization: org, unsatisfied: u }
    JitMintAuthorized {
      attempt: _,
      endpoint_path: path,
      request: req,
      drive_destination: _,
    } =>
      LaunchAdmitted {
        attempt: attempt,
        config: config,
        unit_name: unit_name,
        slice_property: slice_property,
        rootfs_path: rootfs_path,
        jit_drive_path: jit_drive_path,
        mint_endpoint_path: path,
        mint_request: req,
      }
  }
}

// EVERY ADMISSION ARM IS MATCHED INSIDE THIS FUNCTION rather than funnelled through a helper
// taking RunnerMicroVmAdmission. Such a helper would need an arm for RunnerMicroVmAdmitted that
// cannot occur there, and the only thing to put in it is a fabricated refusal -- the
// plausible-output failure DESIGN forbids, sitting in the one place nothing can observe it.
// Matched in place, a new admission arm fails to compile exactly where a launch must rule on it.
//
// THE AUTHORIZATION RULE, FACTORED OUT OF THE SEAL SO IT HAS AN AUTHORABLE RED.
//
// RequiredBuildCellSnapshot is sole_constructor precisely so a caller cannot manufacture a
// reservation, which also means no witness outside its module can build one -- so a control aimed
// at seal_execution_binding could never construct the disagreeing input it exists to catch. Its RED
// would be unauthorable and the check would be a DESIGN 4b decoration: permanently green, cited as
// coverage. Exposing a snapshot builder for tests would instead punch the hole the seal exists to
// close, which is the tradeoff runner_microvm_attempt's own witness records.
//
// So the rule lives here, over the coordinates themselves, where a witness CAN construct a
// disagreeing pair; the seal reads those coordinates off the snapshot and delegates. One authority,
// and the discriminating input is writable.
type AuthorizationAgreement
  = AuthorizationAgrees
  | AuthorizationDisagrees { cause: String }

fn grant_authorizes_reservation(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  work: FabricIdentity<NonEmptyStr, WorkKey>,
  demand: FabricIdentity<NonEmptyStr, DemandKey>,
  offer: FabricIdentity<NonEmptyStr, OfferKey>,
) -> AuthorizationAgreement {
  if !fence_admits(
    a: account,
    reference: grant.money_reservation,
    presented: grant_lease_generation(g: grant),
  ) {
    AuthorizationDisagrees {
      cause: "the execution grant presented for this launch does not fence against the account that issued it, so the authorization is stale or superseded and no target process may start",
    }
  } else if !fabric_identity_eq(left: grant.context.work, right: work) {
    AuthorizationDisagrees {
      cause: "the execution grant authorizes a different Work than the reserved cell holds, so this launch would run one subject under another's authorization",
    }
  } else if !fabric_identity_eq(left: grant.context.demand, right: demand) {
    AuthorizationDisagrees {
      cause: "the execution grant answers a different Demand than the reservation was taken for, so the two describe different executions",
    }
  } else if !fabric_identity_eq(left: grant.object.offer, right: offer) {
    AuthorizationDisagrees {
      cause: "the execution grant was issued against a different Offer than the cell was reserved from, so the supply it priced is not the supply this launch would consume",
    }
  } else {
    AuthorizationAgrees
  }
}

// THE SEALED AUTHORIZATION, AND WHY A GRANT PARAMETER ALONE WAS NOT FABRIC INTEGRATION.
//
// Requiring an ExecutionGrant closed the absent-grant case and nothing else. The grant and the cell
// binding arrived as INDEPENDENT arguments, and the only thing read off the grant was its money
// reservation, so a grant issued for execution A composed with the reserved cell for execution B
// passed whenever the supplied account fenced A. That is worse than no grant: the grant's presence
// reads as authorization while authorizing nothing about the subject.
//
// The grant already carries the coordinates that close it -- work, demand, offer, lease, executor,
// attempt -- and the reserved snapshot carries work, demand and offer of its own. So the join is
// available, and the honest form is CONSTRUCTION rather than a check inside the planner: the
// mismatched pair must have no constructor at all. MicroVmExecutionBinding is sole_constructor and
// reachable only through seal_execution_binding, which refuses unless every coordinate agrees.
//
// WHAT THIS STILL DOES NOT ESTABLISH, stated because the type name would otherwise read as more
// than it is. ExecutionGrant is an ordinary constructible record, so a caller can author one; this
// seal proves AGREEMENT between a presented grant and a presented reservation, not that fabric
// issuance durably committed either. The unforgeable form is a persistent executor that re-reads
// the committed grant from durable storage after the submitter terminates, which is FCI-3's own
// exit predicate and the next slice -- not something a pure planner can assert about itself.
type MicroVmExecutionBinding sole_constructor {
  grant: ExecutionGrant<NonEmptyStr>
  binding: MicroVmCellBinding
}

type MicroVmExecutionSeal
  = ExecutionBindingSealed { sealed: MicroVmExecutionBinding }
  | ExecutionBindingRefusedSubject { cause: String }

fn seal_execution_binding(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  snapshot: RequiredBuildCellSnapshot,
) -> MicroVmExecutionSeal {
  match grant_authorizes_reservation(
    grant: grant,
    account: account,
    work: snapshot.work,
    demand: snapshot.demand,
    offer: snapshot.offer,
  ) {
    AuthorizationDisagrees { cause: c } => ExecutionBindingRefusedSubject { cause: c }
    AuthorizationAgrees =>
      ExecutionBindingSealed {
        sealed: MicroVmExecutionBinding {
          grant: grant,
          binding: bind_microvm_to_cell(snapshot: snapshot),
        },
      }
  }
}

// THE GRANT IS AN INPUT RATHER THAN SOMETHING THIS MODULE LOOKS UP, and that is what keeps the
// micro-VM a realization UNDER the fabric contract instead of a second execution system beside it.
// gunbc.fabric_ci_program FCI-3 owns the question this function answers -- what causes the target
// process -- and its exit predicate is that a persistent executor re-reads the committed Grant
// before starting, so an absent, corrupt or expired Grant yields ZERO target processes. Taking the
// grant as a required parameter makes the absent case unconstructible rather than validated: there
// is no arm a caller can reach without one. The fence check covers the other two, because a grant
// whose lease generation no longer admits against the issuing account is precisely a superseded or
// expired authorization.
//
// FCI-1's non-goals name Work-process-start and ExecutionGrant explicitly, and FCI-2's name
// process-start. A launch composed straight from a cell binding would therefore perform FCI-3's job
// while skipping FCI-2 -- which is the shape ROADMAP forbids when it says the fabric is four
// consumers of one contract and not four execution systems.
//
// THE FIVE STAGES ARE ORDERED CHEAPEST-AND-MOST-FUNDAMENTAL FIRST, and the order is load-bearing
// rather than stylistic: grant authorization, cell ownership, the VM config, admission, then the
// mint. Authorization leads because nothing may start without it whatever the cell's state. Every
// stage before the last is pure and free to refuse; the mint is not, so it runs only once nothing
// else can refuse.
fn plan_microvm_launch_of_sealed(
  sealed: MicroVmExecutionBinding,
  reserve: RealizationReserve,
  kernel_path: String,
  net: RunnerMicroVmNetworking,
  topology: VmmProcessTopology,
  intent: RunnerUnitLifecycleIntent,
  listener_is_main_process: Bool,
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  organization: GitHubOrganizationRef,
  runner_group_id: JitRunnerGroupId,
  labels: List<JitRunnerLabel>,
) -> MicroVmLaunchPlan {
  plan_microvm_launch_of_binding(
    binding: sealed.binding,
    reserve: reserve,
    kernel_path: kernel_path,
    net: net,
    topology: topology,
    intent: intent,
    listener_is_main_process: listener_is_main_process,
    authority: authority,
    control_plane: control_plane,
    organization: organization,
    runner_group_id: runner_group_id,
    labels: labels,
  )
}

// THE PLANNING STAGES, WHICH MAKE NO AUTHORIZATION CLAIM AND MUST NOT LOOK LIKE THEY DO.
//
// This takes a binding and no grant, deliberately. A function that accepted a grant and read only
// its money reservation is what created the substitution opening: the grant's presence read as
// authorization of the subject while authorizing nothing about it. Taking no grant at all is the
// honest signature for cell ownership, VM config, admission and the mint -- none of which are
// authorization questions.
//
// Reaching it in production requires a MicroVmExecutionBinding, which is sole_constructor and
// obtainable only from seal_execution_binding, so the authorization gate cannot be routed around.
// Witnesses drive this level for the planning refusals and grant_authorizes_reservation for the
// authorization ones, because each has an authorable RED exactly there.
fn plan_microvm_launch_of_binding(
  binding: MicroVmCellBinding,
  reserve: RealizationReserve,
  kernel_path: String,
  net: RunnerMicroVmNetworking,
  topology: VmmProcessTopology,
  intent: RunnerUnitLifecycleIntent,
  listener_is_main_process: Bool,
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  organization: GitHubOrganizationRef,
  runner_group_id: JitRunnerGroupId,
  labels: List<JitRunnerLabel>,
) -> MicroVmLaunchPlan {
  match binding {
    VmUnboundCellNotOwned { cause: c } => LaunchRefusedCell { cause: c }
    VmBoundToOwnedCell {
      attempt: attempt,
      rootfs_path: rootfs,
      jit_drive_path: drive,
      vm_config_path: _,
      unit_name: unit_name,
      slice_property: slice_property,
    } =>
      match gunbc_runner_microvm_vm_config(
        rootfs_path: rootfs,
        jit_config_path: drive,
        kernel_path: kernel_path,
        net: net,
      ) {
        MicroVmConfigUnresolved { cause: c } => LaunchRefusedConfig { cause: c }
        MicroVmConfigResolved { config: config } =>
          match runner_microvm_admission(
            topology: topology,
            intent: intent,
            listener_is_main_process: listener_is_main_process,
            transport: gunbc_runner_jit_transport,
            config: config,
            reserve: reserve,
          ) {
            RunnerMicroVmAdmitted =>
              launch_after_admission(
                attempt: attempt,
                binding: binding,
                config: config,
                unit_name: unit_name,
                slice_property: slice_property,
                rootfs_path: rootfs,
                jit_drive_path: drive,
                authority: authority,
                control_plane: control_plane,
                organization: organization,
                runner_group_id: runner_group_id,
                labels: labels,
              )
            RunnerMicroVmRefusedOrphanableUnit { reason: r } => LaunchRefusedAdmission { reason: r }
            RunnerMicroVmRefusedSharedCredential { reason: r } => LaunchRefusedAdmission { reason: r }
            RunnerMicroVmRefusedMalformedVm { reason: r } => LaunchRefusedAdmission { reason: r }
            RunnerMicroVmRefusedEnvelopeDisagreement { reason: r } => LaunchRefusedAdmission { reason: r }
            RunnerMicroVmRefusedEnvelopeUnresolved { reason: r } => LaunchRefusedAdmission { reason: r }
          }
      }
  }
}


// THE RESERVE IS AN INPUT TO THIS JUDGMENT, NOT A ROW THIS MODULE READS, and threading it was a
// real repair rather than a testing convenience. Reading gunbc_runner_microvm_realization_reserve()
// inside the composition made the admitted arm unreachable from ANY caller: production's reserve is
// ReserveUnmodeled -- deliberately, because no VMM resident footprint is a cited quantity and
// inventing one would be a fabricated plausible output -- so every launch refuses at
// MemoryFitUnresolved and the mint stage below it was dead code no input could reach. A positive
// control over it would have been asserting a state that cannot exist, which is the decoration
// DESIGN 4b warns about, written into the test rather than the production path.
//
// As a parameter, the fit judgment is decided by the caller that owns the reserve, the ordering
// below becomes reachable and therefore witnessable, and production keeps refusing honestly at the
// entry point rather than by accident inside a composition.

// THE SNAPSHOT ENTRY IS A PROJECTION AND NOTHING ELSE, and that is deliberate rather than a missing
// abstraction. RequiredBuildCellSnapshot is sole_constructor -- a caller must not be able to
// manufacture a reservation -- which also means no witness outside its module can build one. If
// this function carried the four-stage ordering, that ordering would be unwitnessable, and the
// project has already seen what happens next: an annotation claiming coverage exists somewhere
// upstream, believed by a review, false.
//
// So every decision lives in plan_microvm_launch_of_binding, where a witness reaches it through a
// binding it can construct, and this function does the one thing the seal genuinely forces: turn a
// snapshot into a binding. A defect here is a wiring defect visible in five lines; a defect in the
// ordering is a live runner identity minted for a VM that never starts, and that one is tested.
fn plan_microvm_launch(
  grant: ExecutionGrant<NonEmptyStr>,
  account: MoneyAccount,
  snapshot: RequiredBuildCellSnapshot,
  kernel_path: String,
  net: RunnerMicroVmNetworking,
  topology: VmmProcessTopology,
  intent: RunnerUnitLifecycleIntent,
  listener_is_main_process: Bool,
  authority: GitHubCredentialAuthority,
  control_plane: GitHubAppControlPlaneState,
  organization: GitHubOrganizationRef,
  runner_group_id: JitRunnerGroupId,
  labels: List<JitRunnerLabel>,
) -> MicroVmLaunchPlan {
  match seal_execution_binding(grant: grant, account: account, snapshot: snapshot) {
    ExecutionBindingRefusedSubject { cause: c } => LaunchRefusedGrant { cause: c }
    ExecutionBindingSealed { sealed: sealed } =>
  plan_microvm_launch_of_sealed(
    sealed: sealed,
    reserve: gunbc_runner_microvm_realization_reserve(),
    kernel_path: kernel_path,
    net: net,
    topology: topology,
    intent: intent,
    listener_is_main_process: listener_is_main_process,
    authority: authority,
    control_plane: control_plane,
    organization: organization,
    runner_group_id: runner_group_id,
    labels: labels,
  )
  }
}
