// VOID CITATION RETIRED (operator ruling 2026-08-06): ctrl:scripts/session-dashboard/host/* path
// literals and void_note twins were deleted — ctrl is a dead repo, not a live upstream. Runner slot
// materialization is owned in gunbc.runner.runner_slot_provision / gunbc.runner.runner_lifecycle on
// host_effect_apply. runner_host_installer_command_argv remains a legacy argv builder taking
// installer_path as a parameter; it is not an authority row citing ctrl.

type GithubAppRunnerConfig {
  app: DeclaredGitHubApp
  installation_id: GitHubAppInstallationId
  app_pem_secret: SecretRef
}

fn github_app_runner_org(config: GithubAppRunnerConfig) -> NonEmptyStr {
  config.app.owner_login
}

data gunbc_ci_github_app: GithubAppRunnerConfig = GithubAppRunnerConfig {
  app: gunbai_ci_declared,
  installation_id: gunbai_ci_declared_installation_id,
  app_pem_secret: gunbai_ci_app_pem_secret,
}

// THE NON-CAPACITY FACTS ARE THEIR OWN CARRIER, AND THEY EXIST WHATEVER THE WIDTH RESOLVES TO.
//
// A host's address, its principals and its GitHub app are true of srv2 exactly as they are of srv1 --
// none of them depends on how many runner slots it may carry. Only `runner_count` does. Keeping them
// in one record with the width forced a choice between constructing a MISLEADING deploy for a host
// whose width refuses, or having no way to name that host at all.
type RunnerHostSpec {
  host_label: NonEmptyStr
  ssh_target: NonEmptyStr
  runner_user: NonEmptyStr
  unit_user: NonEmptyStr
  job_user: NonEmptyStr
  app: GithubAppRunnerConfig
}

// AN OPERATIONAL DEPLOY IS A SPEC PLUS AN ADMITTED WIDTH, and it is constructed in exactly one place.
//
// An earlier revision of this repair inspected a CANDIDATE: it built an ordinary
// `RunnerHostDeploy { runner_count: 0 }` for srv2 and handed it to an admission function, which
// returned a refusal. That repaired CONSUMPTION and left the zero representable and actually
// constructed on the normal resolution path -- two authorities again, the misleading value plus a
// later wrapper deciding who may read it. The handback claimed "no deploy row" while the row was
// being built on every resolution.
//
// `runner_host_deploy_of` is now the only constructor, and it cannot produce a row without a positive
// width because the refusal arm has no `deploy` field to fill.
type RunnerHostDeploy {
  host_label: NonEmptyStr
  ssh_target: NonEmptyStr
  runner_user: NonEmptyStr
  unit_user: NonEmptyStr
  job_user: NonEmptyStr
  app: GithubAppRunnerConfig
  runner_count: Int
}

fn runner_host_spec_of(deploy: RunnerHostDeploy) -> RunnerHostSpec {
  RunnerHostSpec {
    host_label: deploy.host_label,
    ssh_target: deploy.ssh_target,
    runner_user: deploy.runner_user,
    unit_user: deploy.unit_user,
    job_user: deploy.job_user,
    app: deploy.app,
  }
}

data runner_job_user_env_name: String = "CTRL_RUNNER_JOB_USER"

// runner_user is the fragment's User= (the account that owns the runner tree). unit_user is the
// depriv drop-in's User= (root mints the JIT config). job_user is CTRL_RUNNER_JOB_USER after
// setpriv. Borrowing another host's principal for any of the three is the neighbour-row arm
// runner_host_deploy_for already refuses.

// srv4's historical five-slot pin is RETIRED (operator ruling 2026-08-06) and runner_count on
// srv4_runner_host_spec names the materialization target, DERIVED from
// gunbc.runner.runner_slot_allocation gunbc_runner_committed_width rather than authored here. Disk binding lives in APPLY-TIME preflight
// in gunbc.runner.runner_lifecycle runner_width_disk_preflight -- not a silent row pin, and never an
// absorbing fallback to 5 when disk is unobservable.
//
// THE WIDTH AND THE DISK ARITHMETIC IN THIS NOTE WERE BOTH SIX AND ARE NOW TWENTY-ONE, AND THE
// SECOND CHANGE IS NOT COSMETIC. The prior text sized the per-slot disk charge at width 6 (~38GB
// per slot against a 500GB class disk) and read as reassurance. At the width the CPU axis committed
// on 2026-08-23 the same charge is 21 x 40.96 GB, about 860 GB, against a Samsung 970 EVO 500GB --
// so runner_width_disk_preflight is EXPECTED TO REFUSE srv4 at its committed width. srv1-3 carry
// 2TB and are unaffected.
//
// SO THIS ROW NO LONGER RECORDS A MARGIN; IT RECORDS AN EXPECTED REFUSAL. That is the apply-time
// gate doing exactly what the 2026-08-06 ruling built it to do, and it means srv4 currently has a
// committed width it cannot materialize. Nothing here lowers the commitment to hide that --
// absorbing to a width the disk happens to permit is the fallback that ruling removed.
//
// WHETHER THE REFUSAL IS REAL IS UNRESOLVED, because the charge is circular. gunbc.runner.runner_lifecycle
// runner_slot_disk_budget_per_slot_note derives 40.96 GB from "about 38GB per slot at width 7 on
// 500GB class disk" -- disk size divided by desired width, so the number was computed FROM a width
// and is now used to constrain one. A live observation of per-slot usage under an active reclaimer
// came in near 2.5 GB, two orders of magnitude off. A circular charge refusing a derived width is
// two unmeasured numbers meeting, and neither side of that refusal is currently evidence.
//
// Every ephemeral runner keeps a _work tree plus caches, so the real figure is not zero and the
// question is genuinely open. DISSOLVE-ON: a measured per-slot disk series on srv4.

// runner_count IS DERIVED, NOT AUTHORED, AND THAT CLOSES A FORK THAT WOULD HAVE SILENTLY EATEN A
// WIDTH CHANGE. These rows carried a literal 6 while gunbc.runner.runner_slot_allocation
// gunbc_runner_committed_width independently answered the same question -- how many slots does this
// host carry -- so one concept had two authorings and the deploy side was the one nobody
// re-derived. The cost was not hypothetical: the 2026-08-23 CPU-axis change moved committed width
// to 21 on srv3 and srv4, and with the literal in place PROVISIONING WOULD STILL HAVE STOOD UP SIX.
// The allocation model and the materialization path would have disagreed about the fleet with no
// diagnostic anywhere, which is exactly the roster-versus-prose failure
// gunbc.runner.runner_slot_allocation width_is_a_minimum_over_axes_note records for srv4.
//
// THE DIRECTION IS DELIBERATE. Width is decided by the conservation and admission axes and
// materialization CONSUMES that decision; a deploy row is not a place to re-decide it. The disk
// question that the old srv4 note worried about is unaffected and still lives where it belongs --
// apply-time gunbc.runner.runner_lifecycle runner_width_disk_preflight refuses on insufficient or
// unobservable headroom rather than lowering the count here.
//
// srv1 AND srv2 NOW HAVE ROWS, closing the gap this note declared on 2026-08-23. All four hosts are
// modeled for materialization and every row derives its width from the same authority, so the fleet
// is covered rather than partially covered.

// srv1 AND srv2 ARE MODELED FOR MATERIALIZATION AS OF 2026-08-23, closing a gap that made the width
// authority unactionable on half the fleet. Until this row pair existed only srv3 and srv4 had
// deploy rows, so gunbc_runner_committed_width could say srv1 carries twenty-one slots and NOTHING
// COULD ACT ON IT -- the number was real and there was no provisioning target to hand it to.
//
// THE ADDRESSES ARE MEASURED, NOT ASSUMED. Both were read over SSH on 2026-08-23 by connecting and
// asking the host its own name: srv1 answers at 192.168.1.185 and srv2 at 192.168.1.188 (both moved
// by hand to their 1G I210 NICs on 2026-10-24: srv1 now .203, srv2 now .201, DHCP). That
// matters because this lane started the night with 192.168.1.183 and .184 for these two, which are
// their BMC addresses rather than their host addresses, and an ssh_target pointing at a management
// controller would fail in a way that looks like an unreachable host rather than a wrong row.
//
// BOTH CARRY INTERACTIVE SESSIONS AND THAT IS ALREADY PRICED. gunbc.session_residency places
// session containers on exactly these two hosts, and the conservation wall charges each of them a
// sessions slice out of the same RAM before any width is admitted -- which is why srv2 was held at five before the 26/25 transition deleted that arm (it now yields a typed width refusal and no deploy row)
// where srv3 and srv4 commit twenty-one. Nothing here re-decides that; the row consumes the width
// the admission axes produced.
//
// srv1 AND srv2 DIFFER FROM EACH OTHER FOR A HARDWARE REASON, not a policy one: srv1 took the 64
// GiB DIMM upgrade and srv2's failed memory training and was reverted. srv1 is bound by cores at
// twelve under the 26/25 slot. srv2 commits nothing -- its width refuses and it has no deploy row -- and this row previously said it was BOUND BY MEMORY at five
// -- which was false, and false in the direction that reads as a measurement. That five came from
// subtracting a session reservation that is UNESTABLISHED on srv2, so no memory axis ever measured
// it; with the axis honestly unmeasured nothing sits at srv2's committed width and the five is a
// HELD allocation, reached by a held arm that gunbc.runner.runner_slot_allocation has since deleted. The distinction
// is operationally load-bearing here, in the module that hands a width to a provisioning target: a
// memory bound is relieved by buying DIMMs, and a held width is relieved by nothing except
// re-grounding the denominator. Two rows that look identical here still resolve to very different
// widths, and that is the derivation working rather than an inconsistency.

data srv1_runner_host_spec: RunnerHostSpec = RunnerHostSpec {
  host_label: "srv1",
  ssh_target: "briansrls@192.168.1.203",
  runner_user: "briansrls",
  unit_user: "root",
  job_user: "ghrunner",
  app: gunbc_ci_github_app,
}

// ZERO MAY NOT INHABIT `RunnerHostDeploy`, AND srv2 IS WHY.
//
// This row was an ordinary deploy whose `runner_count` came from the scalar
// `gunbc_runner_slots_per_host` (since deleted), which mapped an unresolved derivation to 0. srv2's session denominator
// is unestablished, so the row asserted BOTH "this is an operational deploy" and "it desires zero
// runners" -- while every consumer was expected to remember that the zero means REFUSED. That is
// sentinel encoding: construct the misleading value, then require each reader to reinterpret it.
//
// The late guard in `fleet_converge_slot_family` (`runner_count == 0` -> SlotFamilyHostRefused)
// prevented the immediate remove-all plan and did NOT repair the producer. `no_deploy_row_out_commits_
// the_memory_budget` states the real law over every row -- `runner_count > 0` -- and srv2's row
// violated it, which is the invariant catching the encoding rather than a control needing an
// exception.
//
// SO THE RESOLUTION IS TYPED AND THE OPERATIONAL ROW EXISTS ONLY IN THE ADMITTED ARM. A refused host
// yields a cause, not a number. The refusal is preserved as its own disposition rather than filtered
// away, because dropping srv2 from the fleet authority would convert "refused" into "not modeled" --
// a different fact with a different remedy, and the one that lets a fleet total look complete.
// THE REFUSAL CARRIES THE SPEC, so a refused host is still fully named -- address, principals, app --
// and a consumer that needs those facts (a generated sudoers projection, say) is not forced to
// reconstruct them or to fabricate a deploy to get at them.
type RunnerHostDeployAdmission
  = RunnerHostDeployAdmitted { deploy: RunnerHostDeploy }
  | RunnerHostDeployWidthRefused { spec: RunnerHostSpec, host: HostIdentity, cause: String }

// THE WIDTH IS RESOLVED BEFORE ANY ROW EXISTS, AND THE ROW IS BUILT ONLY IN THE ADMITTED ARM.
//
// Every host goes through this one constructor, so there is no second place a deploy can be authored
// with an unchecked count -- srv1, srv3 and srv4 are not hand-written rows that happen to be positive,
// they are specs admitted by the same test srv2 fails. `runner_count` is written exactly once, from
// the resolved width, and only where that width is positive.
fn runner_host_deploy_of(host: HostIdentity, spec: RunnerHostSpec) -> RunnerHostDeployAdmission {
  match gunbc_runner_committed_width(host: host) {
    RunnerWidthUnresolved { cause: c } =>
      RunnerHostDeployWidthRefused {
        spec: spec,
        host: host,
        cause: runner_width_unresolved_cause_text(cause: c),
      }
    RunnerWidthDerived { slots: width } =>
      if width > 0 {
        runner_host_deploy_admitted_at_width(host: host, spec: spec, width: width)
      } else {
        RunnerHostDeployWidthRefused {
          spec: spec,
          host: host,
          cause: "this host's committed width DERIVES to zero: an admission axis admitted no slot at the declared slot size, which is a grounded zero rather than an unresolved derivation, and no operational deploy row is constructed for it",
        }
      }
  }
}

fn runner_host_deploy_admitted_at_width(host: HostIdentity, spec: RunnerHostSpec, width: Int) -> RunnerHostDeployAdmission {
  RunnerHostDeployAdmitted {
      deploy: RunnerHostDeploy {
        host_label: spec.host_label,
        ssh_target: spec.ssh_target,
        runner_user: spec.runner_user,
        unit_user: spec.unit_user,
        job_user: spec.job_user,
        app: spec.app,
        runner_count: width,
      },
  }
}

fn admitted_deploy_or_refusal(host: HostIdentity, spec: RunnerHostSpec) -> RunnerHostDeployResolution {
  match runner_host_deploy_of(host: host, spec: spec) {
    RunnerHostDeployAdmitted { deploy: d } => RunnerHostDeployFound { deploy: d }
    RunnerHostDeployWidthRefused { spec: _, host: h, cause: c } => RunnerHostDeployRefused { host: h, cause: c }
  }
}

data srv2_runner_host_spec: RunnerHostSpec = RunnerHostSpec {
  host_label: "srv2",
  ssh_target: "briansrls@192.168.1.201",
  runner_user: "briansrls",
  unit_user: "root",
  job_user: "ghrunner",
  app: gunbc_ci_github_app,
}
data srv3_runner_host_spec: RunnerHostSpec = RunnerHostSpec {
  host_label: "srv3",
  ssh_target: "briansrls@192.168.1.221",
  runner_user: "briansrls",
  unit_user: "root",
  job_user: "ghrunner",
  app: gunbc_ci_github_app,
}

data srv4_runner_host_spec: RunnerHostSpec = RunnerHostSpec {
  host_label: "srv4",
  ssh_target: "briansrls@192.168.1.196",
  runner_user: "briansrls",
  unit_user: "root",
  job_user: "ghrunner",
  app: gunbc_ci_github_app,
}

// A REFUSED HOST IS A THIRD DISPOSITION, NOT A SPELLING OF UNMODELED. srv2 is modeled precisely
// enough to know its width cannot be derived; calling that "unmodeled" would hand it the remedy for a
// host nobody described, and would let a fleet total read as complete because the refusal vanished
// into an absence.
type RunnerHostDeployResolution
  = RunnerHostDeployFound { deploy: RunnerHostDeploy }
  | RunnerHostDeployUnmodeled { host: HostIdentity }
  | RunnerHostDeployRefused { host: HostIdentity, cause: String }

// AN UNMODELED HOST REFUSES RATHER THAN BORROWING A NEIGHBOUR'S ROW. This dispatch is the seam
// where a width becomes a provisioning target, and the tempting failure arm is to hand an
// unclassified host whichever row is nearest -- which would provision it against another machine's
// ssh_target, runner user and slot count. RunnerHostDeployUnmodeled names the host and carries no
// deploy, so a caller cannot proceed by accident; the four enrolled hosts are the whole population
// and a fifth is a row someone must author, not a default someone inherits.
//
// This mirrors gunbc.runner.runner_slot_allocation gunbc_runner_committed_width, which answers
// RunnerWidthUnresolved for an unknown host on the same reasoning: an unclassified machine is
// unknown, not typical. An earlier revision of this sentence said that authority "answers zero
// slots for an unknown host" -- which was true of the deleted Int API and is the exact conflation
// this change removed, left standing as prose in the module that turns a width into a provisioning
// target (DESIGN 4c: an annotation is never evidence that a machine claim holds, and a drifted one
// is a second account of a fact the declaration already carries).

fn runner_host_deploy_for(host: HostIdentity) -> RunnerHostDeployResolution {
  match runner_host_spec_for(host: host) {
    RunnerHostSpecFound { spec: s } => admitted_deploy_or_refusal(host: host, spec: s)
    RunnerHostSpecAbsent { host: h } => RunnerHostDeployUnmodeled { host: h }
  }
}

// THE ROSTER IS THE ENROLLED CI POPULATION, EVERY HOST THROUGH THE SAME RESOLUTION. It is read off
// gunbc.fleet.fleet_enrollment rather than listed here, so a host enrolled for CI appears with whatever
// disposition it has: a refused width stays a member rather than an absence, and an enrolled host
// with no runner spec -- a provider guest whose runner role is not modeled -- appears as Unmodeled,
// so a fleet total that walks this roster cannot look complete while one host cannot be deployed.
fn fleet_runner_host_resolutions() -> List<RunnerHostDeployResolution> {
  runner_host_resolutions_among(intents: fleet_enrollment_intents)
}

fn runner_host_resolutions_among(intents: List<HostEnrollmentIntent>) -> List<RunnerHostDeployResolution> {
  map(hosts_enrolled_among(intents: intents, wanted: CiRunnerParticipation), h => runner_host_deploy_for(host: h))
}

// THE ADMITTED ROW FOR ONE HOST, OPTIONAL BECAUSE ADMISSION IS NOT GUARANTEED. A consumer that wants
// "srv3's deploy" asks for it and handles the absence, rather than reading a data row that exists
// whether or not the host can be sized. There is no arm here that manufactures a row for a refused
// host, which is the property the whole split exists to hold.
// THE SPEC IS AVAILABLE WHETHER OR NOT THE WIDTH ADMITS, which is the point of splitting it out: a
// refused host is still fully named, so a generated projection can render its non-capacity grants
// without anyone fabricating a deploy to reach them.
// A NAMED COPRODUCT RATHER THAN Optional SUGAR, matching this module's own vocabulary for exactly
// this shape (`RunnerHostDeployResolution` next to it) instead of introducing a second spelling for
// "found or not" in one file.
type RunnerHostSpecLookup
  = RunnerHostSpecFound { spec: RunnerHostSpec }
  | RunnerHostSpecAbsent { host: HostIdentity }

// One row per host that has a runner spec, keyed by the host's stable identity. The specs stay
// per-host physical facts (ssh target, users, app); only the dispatch over them is a lookup now, so
// adding a host's spec is a row here and never a new arm in every switch that used to repeat it.
type RunnerHostSpecRow {
  host: HostIdentity
  spec: RunnerHostSpec
}

data runner_host_spec_rows: List<RunnerHostSpecRow> = [
  RunnerHostSpecRow { host: operator_host_srv1, spec: srv1_runner_host_spec },
  RunnerHostSpecRow { host: operator_host_srv2, spec: srv2_runner_host_spec },
  RunnerHostSpecRow { host: operator_host_srv3, spec: srv3_runner_host_spec },
  RunnerHostSpecRow { host: operator_host_srv4, spec: srv4_runner_host_spec },
]

// WHICH HOSTS' JOB ACCOUNTS HOLD A USER SYSTEMD MANAGER (loginctl linger). gunbc.runner.runner_user_session
// converges it: enable-linger for the host's job_user, then a readback that logind records Linger=yes AND the
// manager answers over /run/user/<uid>/bus. srv4 only (operator decision relayed on gunbc#14972, 2026-10-25); a
// host joins by joining this list. Declared frontier (DESIGN 3c), in order: once this converge's readback has held
// on a host from main, a capability runner label derived from this row (gunbc.runner.runner_registration_labels)
// -- DONE: gunbc_user_session_label, added to the job composition only by the EVIDENCE ENTRY
// (runner_registration_labels_with_user_session_receipt, which takes a converge receipt parsed by
// gunbc.runner.runner_user_session_receipt from the bytes a converge run wrote -- the roster here is the
// converge's INPUT population, and the receipt is the EVIDENCE; hand-copied receipt rows were rejected as
// DESIGN 6's transcribed output), and stripped from any caller-spelled or offer-spelled half; until the
// fleet-converge receipt read (the follow-up in the PR body of gunbc#15253) supplies a receipt, the label is
// granted to nobody in production; then gunbc#14972's systemd credential
// rows select on that label -- the CONSUMER of the label, the jobs that run a command under the job account's
// user manager. gunbc.runner.runner_user_session runner_user_session_converge_ci_wet is the leg that
// establishes the capability; the credential rows' runs-on switch is the next step, to land once every host in
// that pool reads ready -- until then a row for a host without the label would strand its runs-on).
data runner_job_user_session_hosts: List<HostIdentity> = [operator_host_srv4]

fn runner_job_user_session_on(host: HostIdentity) -> Bool {
  any(runner_job_user_session_hosts, h => (h as String) == (host as String))
}

fn runner_host_spec_for(host: HostIdentity) -> RunnerHostSpecLookup {
  match filter(runner_host_spec_rows, r => (r.host as String) == (host as String)).first() {
    Present { value: r } => RunnerHostSpecFound { spec: r.spec }
    Absent => RunnerHostSpecAbsent { host: host }
  }
}

fn admitted_deploy_for(host: HostIdentity) -> RunnerHostDeploy? {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployFound { deploy: d } => Present { value: d }
    RunnerHostDeployRefused { host: _, cause: _ } => Absent
    RunnerHostDeployUnmodeled { host: _ } => Absent
  }
}

fn admitted_deploy_rows() -> List<RunnerHostDeploy> {
  fleet_runner_host_resolutions() |> flat_map(r => match r {
    RunnerHostDeployFound { deploy: d } => [d]
    RunnerHostDeployRefused { host: _, cause: _ } => []
    RunnerHostDeployUnmodeled { host: _ } => []
  })
}

// THE ADMITTED LIST CARRIES ONLY OPERATIONAL ROWS, and a refused or unmodeled host is absent from it
// because it has no such row -- not because it was filtered. Every disposition is carried separately
// by `fleet_runner_host_deploy_resolutions`, so a consumer that wants the whole enrolled CI fleet gets
// one disposition per host and a consumer that wants deployable hosts gets only the positive rows.
// Neither can silently read the other's population as complete.
data fleet_runner_host_deploys: List<RunnerHostDeploy> = admitted_deploy_rows()

data fleet_runner_host_deploy_resolutions: List<RunnerHostDeployResolution> = fleet_runner_host_resolutions()

// runner_count names slots via runner_instance_names / runner_index_seq but does NOT reach
// runner_host_installer_command_argv — install-actions-runner.sh has no slot-count parameter
// (per-host handler only). Width realization lives in gunbc.runner.runner_slot_provision.

// Execution-surface prereqs the runner host must satisfy (gunbc.fleet.fleet_intent
// fleet_intent_execution_surface declares container_engine: the cited Docker Engine row deployed
// rootless (extdeps.container.docker_engine, extdeps.container.engine) + toolchains: [sccache], so
// the surface no longer lies). These two scripts provision that surface on a fresh host BEFORE
// install-actions-runner.sh: docker_ce (the rootless-docker apt prereq the ctrl installer assumes)
// then sccache (the pinned binary install-ctrl-sccache.sh assumes on PATH). Each cites its
// upstream; the shell leaves carry dissolution triggers in their extdeps modules.

// THERE IS NO DOCKER INSTALL SCRIPT ON THIS PATH ANY MORE, and the deletion is the point. This function
// used to return extdeps.container.docker_ce docker_ce_repo_install_script — a POSIX program assembled by
// joining string literals — which gunbc.runner.runner_gpu_container_toolchain staged to a file and ran with
// `sh`. Review 86503 blocked on it: the same converge models the NVIDIA repository as typed actions, so a
// hand-written shell sitting beside it is parallel authority, and §6 names that a scaffold tell. What
// replaces it is not a marker on the old path but the absence of one:
//   - the repository (pinned row docker_ce_apt_repo_noble_arm64) is a FIELD OF THE PER-HOST ROW below, and
//     provisioning stages it as typed argv legs beside the NVIDIA ones;
//   - the packages (docker_ce_packages) are a FIELD OF THE SAME ROW and reach the host through the ONE
//     modeled apt route, runner_gpu_container_toolchain_ensure_steps over srv3_ensure_apt — the same route
//     the nvidia packages use, which is why there is no `apt-get install` in any leg;
//   - the sources line is written as FILE CONTENT by the sealed typed writer, from
//     extdeps.container.docker_ce docker_ce_apt_source_line.
// extdeps.container.docker_ce keeps its own script and dissolution trigger for the fleet paths that
// predate this module (gunbc.runner.runner_provision_actions and the realization census); deleting them from
// here is not the same as deleting them from main, and this PR does not touch them.

// ── THE GPU CONTAINER TOOLCHAIN IS A DECLARED PER-HOST CAPABILITY, AND DESIRE IS NOT PRESENCE ──
//
// Operator decision 2026-10-25 (work item node://adhoc-0cabf47d-be0): fleet CI jobs must run
// containers that see GPUs WITHOUT root equivalence. Two .dag gates depend on it — the S1b
// //gunbc/instruments:router-proxy-falsifier (#15089) and the serving benchmark. The shape the
// decision names is rootless Docker for the job user plus the NVIDIA container toolkit with a
// generated CDI spec, so `docker run --device nvidia.com/gpu=all` resolves.
//
// WHY A DECLARATION HERE RATHER THAN AN INSTALL. A host either carries this capability or it does
// not, and the ONLY thing that may change that is converge: nothing here is hand-installed. So this
// row states the DESIRED state — which host is meant to be able to run GPU containers, from which
// pinned repository — and gunbc.runner.runner_gpu_container_toolchain turns the same fact into a
// runner registration label ONLY after a readback on the machine holds. Desire and presence are two
// different claims and get two different carriers; a host can be Desired-and-not-yet-Ready, which is
// exactly the state converge exists to leave behind, and it can never be Ready-without-Desired.
//
// WHY THE DOCKER GROUP IS NOT THE FIX. gunbc.fleet.fleet_posix_accounts
// fleet_root_equivalent_group_names lists "docker" as root-equivalent: the rootful socket IS the root
// socket, so adding the job user to it buys the capability by granting root, which the decision
// forbids. Every row here therefore means the ROOTLESS shape — the job user's own
// unix:///run/user/<uid>/docker.sock, which gunbc.runner.runner_unit_file docker_host_from_uid_reading
// already forms for the slot's job user. A host that only has the rootful socket has NOT got this
// capability, however well its nvidia-smi reads.
type RunnerHostGpuContainerToolchain
  = GpuContainerToolchainDesired {
      repo: NvidiaContainerToolkitAptRepo
      // THE DOCKER REPOSITORY IS PART OF WHAT IS DESIRED, not an incidental of installing it. The two
      // pinned rows come from different upstreams (download.docker.com and nvidia.github.io) and each
      // carries its own signing-key fingerprint, so both have to be named where the host's desire is
      // declared — a host that gets one and not the other has a dockerd with no GPU route, or a toolkit
      // with no daemon, and neither is a state converge should be able to reach by omission.
      docker_repo: DockerCeAptRepo
      packages: List<NonEmptyStr>
    }
  | GpuContainerToolchainNotWanted { reason: NonEmptyStr }
  // UNMEASURED IS NOT NOT-WANTED. srv2 and srv4 have never been probed for GPUs, container
  // toolchains, or a rootless socket, and "nobody looked" must not be recorded as "this host does not
  // want GPU containers" — the first is a gap that blocks converge, the second is a decision that
  // justifies it. A host with no row at all is a fourth, distinct answer (RunnerHostGpuToolchainAbsent).
  | GpuContainerToolchainUnmeasured { }

type RunnerHostGpuContainerToolchainLookup
  = RunnerHostGpuToolchainFound { host: HostIdentity, toolchain: RunnerHostGpuContainerToolchain }
  | RunnerHostGpuToolchainAbsent { host: HostIdentity }

type RunnerHostGpuContainerToolchainRow {
  host: HostIdentity
  toolchain: RunnerHostGpuContainerToolchain
}

// srv3: the host the two gates need, measured 2026-10-25 — `nvidia-smi -L` reports the two RTX 2000
// Ada cards and a driver, and NEITHER docker NOR the container toolkit is installed, so this row is
// the instruction to install them. srv1: measured the same day to already carry the rootless shape
// (docker-ce-rootless-extras, nvidia-container-toolkit, /etc/cdi/nvidia.yaml, and the job user's own
// socket answering), and `docker run --device nvidia.com/gpu=all` ran as the job user and saw the
// card. Both rows cite the same pinned repository row and the same package closure; a per-host
// divergence in either would be a supply-chain difference smuggled in as topology.
//
// THE DRIVER VERSION IS NOT DECLARED HERE, ON PURPOSE. srv3's driver read 580.126.09 on one probe and
// 595.91.07 on another within the same day, so any pin authored from a message would be a coin flip.
// The toolkit is what makes a container see whatever driver is present; the driver belongs to the host
// OS axis, not to this one, and converge reads it rather than asserting it.
data runner_host_gpu_container_toolchain_rows: List<RunnerHostGpuContainerToolchainRow> = [
  RunnerHostGpuContainerToolchainRow {
    host: operator_host_srv1,
    toolchain: GpuContainerToolchainDesired {
      repo: nvidia_container_toolkit_apt_repo_stable,
      docker_repo: docker_ce_apt_repo_noble_arm64,
      // ONE PACKAGE CLOSURE, ONE INSTALL ROUTE. Both upstreams' packages ride the same modeled apt ensure
      // below, so "install the toolkit" and "install the engine" cannot drift into two code paths with two
      // notions of success. The order is the one dpkg needs no help with: the engine's rootless extras are
      // what make the job user's own socket exist, and they are listed with their engine rather than
      // smuggled in as a runtime assumption.
      packages: append(nvidia_container_toolkit_packages, items: docker_ce_packages),
    },
  },
  RunnerHostGpuContainerToolchainRow {
    host: operator_host_srv3,
    toolchain: GpuContainerToolchainDesired {
      repo: nvidia_container_toolkit_apt_repo_stable,
      docker_repo: docker_ce_apt_repo_noble_arm64,
      // ONE PACKAGE CLOSURE, ONE INSTALL ROUTE. Both upstreams' packages ride the same modeled apt ensure
      // below, so "install the toolkit" and "install the engine" cannot drift into two code paths with two
      // notions of success. The order is the one dpkg needs no help with: the engine's rootless extras are
      // what make the job user's own socket exist, and they are listed with their engine rather than
      // smuggled in as a runtime assumption.
      packages: append(nvidia_container_toolkit_packages, items: docker_ce_packages),
    },
  },
  RunnerHostGpuContainerToolchainRow {
    host: operator_host_srv2,
    toolchain: GpuContainerToolchainUnmeasured { },
  },
  RunnerHostGpuContainerToolchainRow {
    host: operator_host_srv4,
    toolchain: GpuContainerToolchainUnmeasured { },
  },
]

fn runner_host_gpu_container_toolchain_for(host: HostIdentity) -> RunnerHostGpuContainerToolchainLookup {
  match filter(runner_host_gpu_container_toolchain_rows, r => (r.host as String) == (host as String)).first() {
    Present { value: r } => RunnerHostGpuToolchainFound { host: host, toolchain: r.toolchain }
    Absent => RunnerHostGpuToolchainAbsent { host: host }
  }
}

// THE ONE QUESTION A CONSUMER IS ALLOWED TO ASK. Granting anything on the strength of this row alone
// would read a wish as a fact, so this returns true only for the DESIRED arm and every consumer that
// ships capacity has to reach for the readback in gunbc.runner.runner_gpu_container_toolchain as
// well. Kept as a single fold rather than letting each caller pattern-match, because the failure that
// matters — a host being treated as GPU-capable because it was merely named — is easier to commit in
// three scattered matches than in one function.
fn runner_host_gpu_container_toolchain_declared(host: HostIdentity) -> Bool {
  match runner_host_gpu_container_toolchain_for(host: host) {
    RunnerHostGpuToolchainFound { host: _, toolchain: t } => match t {
      GpuContainerToolchainDesired { repo: _, docker_repo: _, packages: _ } => true
      GpuContainerToolchainNotWanted { reason: _ } => false
      GpuContainerToolchainUnmeasured { } => false
    }
    RunnerHostGpuToolchainAbsent { host: _ } => false
  }
}

// THE GPU TOOLCHAIN ROW IS READ AS TYPED DATA, NOT RENDERED TO A SCRIPT. This module once carried
// runner_host_gpu_container_toolchain_provision_script, which returned the whole provisioning sequence as a
// String? for the converge to stage and run — and it returned Absent for three quite different situations
// (unwanted, unmeasured, no row at all) collapsed into one answer. Both halves are gone. The plan reads the
// typed GpuContainerToolchainDesired { repo, docker_repo, packages } through runner_host_gpu_container_toolchain_for
// above and builds the install itself, so the host row is the single place that says what a host should
// have AND the only shape that fact travels in: there is no string in this system that has to stay in
// step with the row, and an absence is distinguished by reason at the site that refuses.

// THE SCCACHE PREREQ USES THE GENERIC VERIFIED DOWNLOAD-PLUS-INSTALL EFFECT, run with sccache's
// boundary values (gunbc.host.sccache_verified_install). It used to call
// extdeps.cache.sccache.sccache_install_script, a script body concatenated in an extdeps module; that
// declaration is deleted with this swap, and the url, digest, member path, destination and mode are now
// PARAMETERS supplied here.
//
// THIS CALL SITE STILL OWES THE SHELL LEAF, AND THE DEBT IS TRACKED HERE RATHER THAN ELSEWHERE.
// `sccache_verified_install_script` renders a `set -e` script string (through
// gunbc.host.verified_binary_install.verified_binary_install_shell), so what this prereq returns is a
// script, not an effect: it is one of the three consumers named in that function's
// `verified_binary_install_shell_dissolution_trigger` and in
// gunbc.host.sccache_verified_install.`sccache_verified_install_script_dissolution_trigger`, and those two
// rows -- not this paragraph -- are the record of what is owed. Deleting the old trigger together with its
// declaration, as an earlier revision of this comment claimed, would have turned tracked debt into
// untracked debt: DESIGN 4b allows a rung to be lowered only by declaring previous rung, temporary rung,
// reason, bounded population and restoration trigger, and DESIGN 5 forbids hiding a deficit by installing a
// second path. WHAT RETIRES THE DEBT is this prereq binding
// gunbc.host.verified_binary_install.verified_binary_install_admitted_plan through typed argv, WITHOUT THE
// SHELL LEAF; when it does, `verified_binary_install_shell` and `sccache_verified_install_script` are
// deleted. Until then, do not read the deletion of `sccache_install_script` as this site being clean.
// (The build-cache consumer, by contrast, IS discharged: gunbc.host.build_cache_daemon_ensure sequences the
// typed plan with no shell leaf anywhere.)
fn runner_host_sccache_provision_script(arch: NonEmptyStr, sha256: NonEmptyStr) -> String {
  sccache_verified_install_script(
    rel: sccache_release_0_15_0,
    arch: arch,
    digest: sha256_digest(hex: sha256),
  )
}

fn runner_host_sccache_provision_aarch64() -> String {
  sccache_verified_install_script(
    rel: sccache_release_0_15_0,
    arch: "aarch64",
    digest: sccache_release_0_15_0.digest_aarch64,
  )
}

// THE ENROLLMENT WALL, and it is CONSTRUCTION rather than a check (DESIGN §5). A host takes no
// fleet work until it is a row in gunbc.fleet.fleet_intent.fleet_intent_known_hosts. This is the standing
// rule the srv4 host-convergence OOM priced (gunbc.plans.fleet_subsumption_manual_gaps section C):
// converge emitted against an unenrolled host derives NOTHING for it — or worse, stamps template
// drop-ins carrying ANOTHER host's widths — and the enrolled intent row is exactly where
// runner_deployment_plan's conservation wall gets the host RAM it needs to check whether N runners
// at the declared caps even fit, refusing PlanUnsound if not. The incident is prevented by
// arithmetic, and the arithmetic has no inputs until the host is enrolled. Why construction and not
// a validating predicate: a fleet_intent_admits_host(deploy) check returning Bool concedes that the
// unenrolled command IS constructible and merely asks callers to look first — one forgotten call
// site and the incident class is back. Instead there is NO function in this module that takes a
// bare RunnerHostDeploy and yields an ArgvCommand: the command builders consume a
// RunnerHostAdmission, and the refusal arm carries no command at all, so 'run the installer on an
// unenrolled host' is unrepresentable rather than discouraged (the EffectsOrRefusal shape already
// blessed in gunbc.membership_reconcile). HONEST RESIDUAL, stated rather than papered over: .dag
// has no visibility modifiers yet, so a caller CAN hand-write RunnerHostEnrolled { deploy } for an
// unenrolled host. That is now an explicit lie in the source rather than an accident of a forgotten
// check — the strongest wall this substrate currently supports. It closes fully when node/subtree
// visibility grants land (DESIGN open thread: 'node/subtree visibility grants'), at which point the
// Enrolled constructor becomes private to this module and the evidence is unforgeable.

type RunnerHostAdmission
  = RunnerHostEnrolled { deploy: RunnerHostDeploy }
  | RunnerHostUnenrolled { host_label: NonEmptyStr, reason: NonEmptyStr }

type RunnerCommandOrRefusal
  = RunnerCommandReady { command: ArgvCommand }
  | RunnerCommandRefused { host_label: NonEmptyStr, reason: NonEmptyStr }

fn fleet_intent_enrolls_host_label(label: NonEmptyStr) -> Bool {
  fold(
    fleet_intent_known_hosts,
    init: false,
    f: (acc, h) => acc || (h.identity as String) == (label as String),
  )
}

fn admit_runner_host(deploy: RunnerHostDeploy) -> RunnerHostAdmission {
  if fleet_intent_enrolls_host_label(label: deploy.host_label) {
    RunnerHostEnrolled { deploy: deploy }
  } else {
    RunnerHostUnenrolled {
      host_label: deploy.host_label,
      reason: concat(
        concat("runner_host_deploy: host '", deploy.host_label as String),
        "' is absent from gunbc.fleet.fleet_intent.fleet_intent_known_hosts; it takes no fleet work until it is an intent row with a converge receipt. Enrolling it is what gives runner_deployment_plan the host RAM to check the slot caps against. Fail-closed, no unenrolled install.",
      ) as NonEmptyStr,
    }
  }
}

// FIVE JOINED "NAME=value" STRINGS BECOME FIVE MODELED BINDINGS. The joins were not merely verbose:
// a value carrying an `=` or a space was indistinguishable from a second binding once flattened, and
// nothing in the old shape could tell them apart. The invocation is now three composed facts --
// the environment (extdeps.tools.env), the elevation that must preserve it (extdeps.sudo.elevation
// -E), and the script the elevated shell runs (extdeps.languages.bash.invocation) -- each owned by
// the authority that knows its spelling.
fn runner_host_installer_command_argv(deploy: RunnerHostDeploy, installer_path: NonEmptyStr, pem_src_path: NonEmptyStr) -> ArgvCommand {
  env_prefixed_command(
    bindings: [
      EnvSet { name: "CTRL_RUNNER_HOST_LABEL", value: deploy.host_label as String },
      EnvSet { name: "CTRL_RUNNER_USER", value: deploy.runner_user as String },
      EnvSet { name: runner_job_user_env_name, value: deploy.job_user as String },
      EnvSet { name: "CTRL_RUNNER_APP_PEM_SRC", value: pem_src_path as String },
    ],
    command: sudo_preserve_environment_command(
      command: bash_script_argv(script_path: installer_path as String),
    ),
  )
}

fn runner_host_installer_command(
  admission: RunnerHostAdmission,
  installer_path: NonEmptyStr,
  pem_src_path: NonEmptyStr,
) -> RunnerCommandOrRefusal {
  match admission {
    RunnerHostEnrolled { deploy: d } =>
      RunnerCommandReady {
        command: runner_host_installer_command_argv(
          deploy: d,
          installer_path: installer_path,
          pem_src_path: pem_src_path,
        )
      }
    RunnerHostUnenrolled { host_label: l, reason: r } =>
      RunnerCommandRefused { host_label: l, reason: r }
  }
}

fn runner_instance_name(deploy: RunnerHostDeploy, index: Int) -> String {
  join([deploy.host_label as String, "-", runner_slot_index_suffix(index: index)], "")
}

fn runner_index_seq(n: Int) -> List<Int> {
  if n <= 0 {
    []
  } else {
    append(runner_index_seq(n: n - 1), items: [n])
  }
}

// THE ACTIONS RUNNER UNITS ARE THE FLEET RANGE, NOT 1..runner_count. On the host carrying the
// microVM shakedown slot, runner_count includes that slot at its authored index, so the Actions
// units stop one below the count (gunbc.runner.runner_slot_allocation host_fleet_slot_indices).
fn runner_instance_names(deploy: RunnerHostDeploy) -> List<String> {
  map(
    host_fleet_slot_indices(host: deploy.host_label as HostIdentity, committed: deploy.runner_count),
    i => runner_instance_name(deploy: deploy, index: i as Int)
  )
}

// EVERY COMMITTED SLOT IDENTITY ON THE DEPLOY'S HOST: the fleet range plus any authored member
// above it (gunbc.runner.runner_slot_allocation host_committed_identities_at), one answer for every
// consumer that enumerates a host's slots from its deploy row.
fn runner_slot_identities_of(deploy: RunnerHostDeploy) -> List<RunnerSlotIdentity> {
  host_committed_identities_at(host: deploy.host_label as HostIdentity, committed: deploy.runner_count)
}

fn runner_enable_command_argv(deploy: RunnerHostDeploy) -> ArgvCommand {
  systemctl_enable_now_command(
    units: map(
      runner_instance_names(deploy: deploy),
      n => runner_unit_name_of_registration(registration_name: n as NonEmptyStr) as String,
    ),
  )
}

// runner_enable_command USED TO LIVE HERE and is deleted rather than deprecated. It took a
// RunnerHostAdmission and returned an enable command, so a host that was merely ENROLLED could be
// activated — no managed cache endpoint, no compile pool, nothing about where the first cache-miss
// compile would put its server. That is the path every host in this fleet was actually activated
// through, and it produced four different broken states: srv1 stranded in a retired slot, srv2 and
// srv3 runner-owned in active ones, srv4 trapped behind a stale socket.
//
// Activation now lives in gunbc.runner.runner_activation and consumes a readiness receipt. This module
// keeps MATERIALIZATION — the installer command, the slot names, the argv builder — because writing
// a slot's files cannot spawn a cache server; only letting it accept work can.
// runner_enable_command_argv stays exported precisely because it is the inert half: an ArgvCommand
// value with no admission attached, which the activation module wraps in its own wall.
//
// Deprecating instead of deleting would have left the readiness-blind constructor in the namespace,
// and a wall with a door beside it is a sign.

// RED-control fixture modeling the forbidden arm: an admission-blind builder that hands back a
// runnable command for a host the fleet never enrolled. This is what the module looked like before
// the wall, and it is what the srv4 incident ran through. It must never ship as the authority;
// runner_host_admission_gate_accepts rejects it.

fn runner_command_admission_blind_widen_sketch(
  deploy: RunnerHostDeploy,
  admission: RunnerHostAdmission,
) -> RunnerCommandOrRefusal {
  RunnerCommandReady { command: runner_enable_command_argv(deploy: deploy) }
}

fn runner_host_admission_gate_accepts(
  outcome: RunnerCommandOrRefusal,
  admission: RunnerHostAdmission,
) -> Bool {
  match admission {
    RunnerHostEnrolled { deploy: _ } => true
    RunnerHostUnenrolled { host_label: _, reason: _ } =>
      match outcome {
        RunnerCommandReady { command: _ } => false
        RunnerCommandRefused { host_label: _, reason: _ } => true
      }
  }
}

// ── SUBORDINATE IDS: THE DECLARATION ROOTLESS DOCKER CANNOT START WITHOUT ───────────────────────
//
// /etc/subuid and /etc/subgid are per-host state, so they are declared per host, beside the other
// per-host facts this module owns. They belong in the MODEL rather than in an installer because the
// failure mode is silent and cross-account: RootlessKit maps the daemon's uid 0 onto the first uid of
// the account's subordinate range, so when two accounts hold the SAME range the second daemon to start
// builds a namespace over ids a namespace already claims, and fails — with a message that names neither
// file. Neither account's own state reveals the collision; only the file does, and only read whole.
//
// EVERY NUMBER HERE IS COPIED FROM A HOST OR DERIVED FROM NUMBERS COPIED FROM A HOST, on 2026-10-25.
// The rule for the re-grant is that it lands above the highest range the plan does not delete, so
// adjacency is allowed and overlap is not — a range ending at 362143 and the next starting at 362144 is
// free, while a range starting at 296608 would sit on top of gunbc-worker.
//
// THE JOB USER KEEPS ITS CURRENT RANGE ON BOTH HOSTS, and that is a deliberate choice rather than an
// accident of measurement. The operator decision of 2026-10-25 says to give the NEW range to whichever
// account has no rootless container store, because a subordinate range is baked into the ownership of
// every file a rootless daemon has ever written under that account: pull a range out from under a
// account with images and its store becomes unreadable uid numbers. On srv1 that means ghrunner stays at
// 100000:65536 (its daemon is running against a 149 MB store) and briansrls — which has no
// ~/.local/share/docker — is what moves. On srv3 nobody has a store yet, so the job user keeps the low
// range and the admin account is displaced.
//
// BEING DECLARED IS NOT BEING PERMITTED. gunbc.runner.runner_gpu_container_toolchain re-reads both
// files, refuses to touch any range belonging to an account other than the declared-displaceable one,
// and re-establishes at run time that the displaceable account still holds no container store — the
// latter matters because the store's absence is a fact about today, not about the model's lifetime.
type RunnerHostSubordinateIds {
  // The range the JOB USER must hold. This is the one rootless Docker needs.
  job_user_first: Int
  job_user_count: Int
  // The one account permitted to be moved off that range, if it currently occupies it.
  displaceable: NonEmptyStr
  // Where the displaced account is re-granted. It is MOVED, never stripped: it arrived holding a range,
  // and anything already running under it was built expecting one. Width is preserved from the file.
  displacee_regrant_first: Int
}

type RunnerHostSubordinateIdsFile
  = SubordinateIdsRowDeclared { ids: RunnerHostSubordinateIds }
  | SubordinateIdsRowUnmeasured {}

type RunnerHostSubordinateIdRow {
  host: HostIdentity
  ids: RunnerHostSubordinateIdsFile
}

type RunnerHostSubordinateIdsResolution
  = RunnerHostSubordinateIdsDeclared { spec: RunnerHostSubordinateIds }
  | RunnerHostSubordinateIdsUnmeasured { reason: String }


data runner_host_subordinate_id_rows: List<RunnerHostSubordinateIdRow> = [
  // srv1 /etc/subuid as read: briansrls 100000:65536, ghrunner 100000:65536 (COLLIDE),
  // gunbc-fleet 165536:65536, ubuntu 231072:65536, gunbc-worker 296608:65536. The plan therefore keeps
  // ghrunner at 100000:65536 — which it already holds, so it costs no usermod — drops briansrls's
  // colliding range, and re-grants briansrls above gunbc-worker's end at 362143.
  RunnerHostSubordinateIdRow {
    host: operator_host_srv1,
    ids: SubordinateIdsRowDeclared { ids: RunnerHostSubordinateIds {
      job_user_first: 100000, job_user_count: 65536,
      displaceable: "briansrls" as NonEmptyStr, displacee_regrant_first: 362144,
    } },
  },
  // srv3 /etc/subuid as read: ghrunner 100000:65536, ubuntu 100000:65536 (COLLIDE),
  // briansrls 165536:65536. The job user keeps 100000:65536 and ubuntu is re-granted above
  // briansrls's end at 231071.
  RunnerHostSubordinateIdRow {
    host: operator_host_srv3,
    ids: SubordinateIdsRowDeclared { ids: RunnerHostSubordinateIds {
      job_user_first: 100000, job_user_count: 65536,
      displaceable: "ubuntu" as NonEmptyStr, displacee_regrant_first: 231072,
    } },
  },
  // srv2 and srv4 are never measured, so nothing is declared. A range here would be a value with no
  // measurement behind it, and the converge would usermod accounts on a host whose subordinate file has
  // not been read — on a host where, for all we know, both accounts already have container stores. The
  // gap is recorded as a gap and the converge refuses, which is the honest arm.
  RunnerHostSubordinateIdRow { host: operator_host_srv2, ids: SubordinateIdsRowUnmeasured {} },
  RunnerHostSubordinateIdRow { host: operator_host_srv4, ids: SubordinateIdsRowUnmeasured {} },
]

data runner_host_subordinate_id_row_count_bound: Int = 8

fn subordinate_ids_declared_for(host: HostIdentity) -> RunnerHostSubordinateIdsResolution {
  if length(runner_host_subordinate_id_rows) > runner_host_subordinate_id_row_count_bound {
    RunnerHostSubordinateIdsUnmeasured {
      reason: concat("gunbc.runner.runner_host_deploy: the subordinate-id row table has ",
                     to_string(length(runner_host_subordinate_id_rows)),
                     " rows, over its bound of ", to_string(runner_host_subordinate_id_row_count_bound),
                     " — refusing to read a table that may be truncated"),
    }
  } else {
    match filter(runner_host_subordinate_id_rows, row => row.host == host).first() {
      Absent => RunnerHostSubordinateIdsUnmeasured {
        reason: concat("gunbc.runner.runner_host_deploy: host ", host as String,
                       " has no subordinate-id row, so the job user has no declared range to be given"),
      }
      Present { value: row } => match row.ids {
        SubordinateIdsRowUnmeasured {} => RunnerHostSubordinateIdsUnmeasured {
          reason: concat("gunbc.runner.runner_host_deploy: host ", host as String,
                         " declares no subordinate range because its /etc/subuid has never been read"),
        }
        SubordinateIdsRowDeclared { ids: d0 } => match d0 {
          RunnerHostSubordinateIds { job_user_first: f, job_user_count: c, displaceable: d, displacee_regrant_first: g } =>
          RunnerHostSubordinateIdsDeclared {
            spec: RunnerHostSubordinateIds {
              job_user_first: f, job_user_count: c, displaceable: d, displacee_regrant_first: g,
            },
          },
        }
      }
    }
  }
}
