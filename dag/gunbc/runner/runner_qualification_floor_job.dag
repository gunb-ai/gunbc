module gunbc.runner.runner_qualification_floor_job

import std.optional { Absent, Present }
import std.types { Int, List, NonEmptyStr, String }
import extdeps.github.actions { Job, Step, RunStep, DispatchInput, InputString, RunsOnExpression }
import extdeps.languages.yaml.types { kv, yaml_string }
import gunbc.witness.compiler_gate_workflow { compiler_gate_floor_steps_after_checkout }

// THE QUALIFICATION FLOOR JOB'S CONTRACT, BELOW BOTH OF ITS READERS. gunbc.fleet.fleet_converge_workflow emits the
// job and gunbc.runner.runner_qualification_dispatch admits a workflow only when the job keeps this contract; the
// dispatch module already reads the fleet-converge model, so the contract cannot live in either without a cycle.
// Moved here unchanged from runner_qualification_dispatch (gunbc.plans.mtcollins1_ci_service_legs G1).

data qualification_attempt_dispatch_input: DispatchInput = DispatchInput {
  name: "runner_attempt_label",
  description: Present { value: "the per-boot attempt label the ephemeral qualification slot registered with; the floor job's runs-on reads it" },
  required: true,
  default: none,
  type: InputString,
}

// THE GUARD, AS THE ONE STEP THE FLOOR JOB MUST BEGIN WITH. It fetches and checks out the revision
// input into the runner's empty workspace and fails the job unless HEAD is exactly that revision; GitHub
// skips every later step of a failed job unless the step opts in with an if: condition, which the floor
// contract forbids (gunbc.runner.runner_qualification_dispatch qualification_floor_admission). An empty input
// fails the fetch, so an unnamed revision refuses here too.
//
// THE REVISION INPUT IS THE WORKFLOW'S, PASSED IN. Why the floor runs a pinned revision named by an input
// (decision: eager-gull-22, 2026-10-04 -- sha-checkout) is recorded on
// gunbc.runner.runner_qualification_dispatch qualification_revision_dispatch_input, which names the one input that
// carries it. This module sits below the workflow model, so it takes that input rather than naming it.
fn qualification_floor_revision_guard_step(revision_input: DispatchInput) -> Step {
  RunStep {
    name: Present { value: "Check out the pinned qualification revision and refuse on any mismatch" },
    id: Present { value: "qualification_revision_guard" },
    run: join([
      "set -euo pipefail",
      "git init -q .",
      "git remote add origin \"https://github.com/$GITHUB_REPOSITORY\"",
      "git fetch -q --no-tags --depth=1 origin \"$QUALIFICATION_REVISION\"",
      "git checkout -q --force --detach FETCH_HEAD",
      "observed=\"$(git rev-parse HEAD)\"",
      "if [ \"$observed\" != \"$QUALIFICATION_REVISION\" ]; then echo \"QualificationRevisionMismatch: expected=$QUALIFICATION_REVISION observed=$observed\" >&2; exit 1; fi",
    ], "\n"),
    shell: none,
    env: Present { value: [kv(key: "QUALIFICATION_REVISION", value: yaml_string(s: join(["${{ inputs.", revision_input.name, " }}"], "")))] },
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none,
  }
}

// THE JOB: the guard first, then the required job's own floor (gunbc.witness.compiler_gate_workflow
// compiler_gate_floor_steps_after_checkout), on exactly the runner the attempt registered. The condition is the
// caller's (the workflow's mode check); nothing else of the job is a parameter.
data qualification_floor_job_id: NonEmptyStr = "qualification-floor"

data qualification_floor_job_name: String = "qualification floor"

fn qualification_floor_job(revision_input: DispatchInput, if_condition: String, timeout_minutes: Int) -> Job {
  Job {
    id: qualification_floor_job_id as String,
    name: Present { value: qualification_floor_job_name },
    runner: RunsOnExpression { expression: join(["${{ inputs.", qualification_attempt_dispatch_input.name, " }}"], "") },
    environment: none,
    steps: concat([qualification_floor_revision_guard_step(revision_input: revision_input)], compiler_gate_floor_steps_after_checkout()),
    needs: [],
    env: none,
    outputs: none,
    if_condition: Present { value: if_condition },
    timeout_minutes: Present { value: timeout_minutes },
    continue_on_error: none,
    concurrency: none,
    permissions: none,
  }
}
