module gunbc.runner.runner_host_hardware_observation

import std.types { Bool, Int, NonEmptyStr, String }

// THE MEASURED HARDWARE INPUTS A STATELESS HOST IMAGE'S KERNEL CONFIG DEPENDS ON, taken from the
// unit rather than inferred from its product brief. These are observations this repository made
// about a machine it operates, so they live in the observing layer (DESIGN section 3's external
// decomposition, the same rule gunbc.fleet.fleet_host_power states for its own subject) rather than
// being authored into the Ampere or AMI modules as properties of the product.
//
// THEY WERE TAKEN FROM FIRMWARE, NOT FROM LINUX, and that is worth recording because it bounds what
// they establish. The unit was carrying an installer with no reachable shell, so the enumeration
// comes from the UEFI Interactive Shell over IPMI SOL. A PCI vendor and device id is exactly what
// decides which in-tree driver binds; it is not a substitute for observing that driver actually
// bind, which happens the first time the host image boots.
//
// WHY THIS WAS THE BLOCKING MEASUREMENT: the host image is a kernel plus an initramfs, and a kernel
// that lacks the driver for the only NIC is a brick with no console recourse beyond serial. Reading
// PXE's Arch:00011 as "EFI arm64" establishes that FIRMWARE can drive the adapter and says nothing
// about which Linux module does.
type HostHardwareObservation {
  subject_unit: NonEmptyStr
  observed_at: NonEmptyStr
  observed_from: NonEmptyStr
  finding: NonEmptyStr
  consequence_for_host_image: NonEmptyStr
}

data mtcollins1_uefi_hardware_artifact: NonEmptyStr = "artifacts/bmc/mtcollins1-uefi-hardware.json"

// THE ONE THAT DECIDES THE KERNEL CONFIG. An Intel I350 is driven by the in-tree igb module and
// carries its own EEPROM, so no firmware blob has to be staged into the initramfs -- which removes
// an entire class of redistribution and pinning work the image would otherwise owe.
data mtcollins1_host_nic: HostHardwareObservation = HostHardwareObservation {
  subject_unit: "bmc-mtcollins1",
  observed_at: "2026-09-06",
  observed_from: "UEFI Interactive Shell v2.2 (EDK II, UEFI v2.70, AMI 0x0005000F) over IPMI SOL",
  finding: "two Ethernet controller functions at 02:02:00.00 and 02:02:00.01, vendor 8086 device 1521 -- Intel I350 dual port. The host NIC that attempted PXE reported MAC 28-C1-3C-8A-D6-4A.",
  consequence_for_host_image: "the host kernel needs the in-tree igb driver and NO external firmware blob; the initramfs owes no firmware payload for networking",
}

// SECURE BOOT BEING OFF IS A SIMPLIFICATION THAT MUST NOT BECOME AN ASSUMPTION. It means the first
// image needs no signing or key enrollment. It does not mean the unit cannot be switched to enforce
// later, and an image built with no signing story would then stop booting -- so this is recorded as
// an observed state with a date, not as a property of the platform.
data mtcollins1_secure_boot: HostHardwareObservation = HostHardwareObservation {
  subject_unit: "bmc-mtcollins1",
  observed_at: "2026-09-06",
  observed_from: "dmpstore of EFIGlobalVariable:SecureBoot from the UEFI shell",
  finding: "SecureBoot variable present, DataSize 0x01, value 0x00 -- Secure Boot disabled",
  consequence_for_host_image: "an EFI image presented to this unit today needs no signature and no enrolled key; a signing policy is not a prerequisite for the first image and becomes one if Secure Boot is ever enabled",
}

// NO MASS-STORAGE CONTROLLER IS THE HARDWARE-LEVEL FORM OF "DISKLESS", and it is stronger than the
// absence of a disk: there is no controller for one to hang off, so a boot design that reaches for
// local storage has nowhere to reach even in principle.
data mtcollins1_no_mass_storage: HostHardwareObservation = HostHardwareObservation {
  subject_unit: "bmc-mtcollins1",
  observed_at: "2026-09-06",
  observed_from: "full PCI enumeration from the UEFI shell",
  finding: "zero mass-storage controllers in the PCI enumeration; a Renesas uPD720201 USB 3.0 controller at 04:03:00.00 is the path the BMC virtual media arrives on, and ASPEED graphics at 1A03:2000 is the BMC's VGA",
  consequence_for_host_image: "the image plans for no block root at all, and needs no graphics driver because the console is serial; a USB driver matters only if the running host must read the presented medium after boot, which an initramfs-resident root does not",
}

// PXE IS PRESENT AND UNUSABLE, AND THOSE ARE DIFFERENT FACTS. The firmware asked and nothing
// answered, so a network boot route is not blocked on the unit -- it is blocked on infrastructure
// this fleet has not stood up. That is why virtual media stays the proven transport for now.
data mtcollins1_pxe_unanswered: HostHardwareObservation = HostHardwareObservation {
  subject_unit: "bmc-mtcollins1",
  observed_at: "2026-09-06",
  observed_from: "serial console during firmware boot-option processing",
  finding: "'Start PXE over IPv6 on MAC: 28-C1-3C-8A-D6-4A' followed by 'PXE-E16: No valid offer received'; firmware offers DEL/ESC for Setup, F11 for the boot menu and F12 for PXE",
  consequence_for_host_image: "network boot needs DHCP and a boot service stood up before it can be a transport. UEFI HTTP Boot specifically is NOT established by any of this -- no HTTP Boot device was observed and PXE support does not imply the HTTP Boot driver -- so it stays a separate measurement rather than a planned route",
}

// A NEGATIVE THAT COST NOTHING TO GET AND WOULD HAVE COST A BUILD CYCLE TO DISCOVER LATER. An ISO
// that boots elsewhere is not thereby bootable HERE, over THIS controller's virtual-USB-CD
// presentation. The derived media envelope for the host image has to be verified to present an ESP
// this firmware maps, rather than assumed to work because it is an ISO.
data mtcollins1_alpine_iso_did_not_boot: HostHardwareObservation = HostHardwareObservation {
  subject_unit: "bmc-mtcollins1",
  observed_at: "2026-09-06",
  observed_from: "boot attempt of alpine-virt-3.24.1-aarch64.iso, published digest-verified and attached through gunbc.bmc.megarac_media_attach",
  finding: "the firmware mapped BLK0 at PcieRoot(0x60000)/Pci(0x3,0x0)/Pci(0x0,0x0)/USB(0x5,0x0)/USB(0x0,0x0) with NO FS alias, reported 'Boot option loading failed', and fell through to the UEFI shell -- it saw a block device and found no filesystem it could mount",
  consequence_for_host_image: "the virtual-media envelope must be verified to carry an EFI/BOOT/BOOTAA64.EFI on a filesystem this firmware recognises. Ubuntu's arm64 ISO boots by the same route on the same unit, so the difference is in EFI boot-path layout rather than in the transport",
}
