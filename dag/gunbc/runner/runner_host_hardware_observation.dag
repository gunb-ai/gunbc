module gunbc.runner.runner_host_hardware_observation

import std.types { List, NonEmptyStr }
// PCI observations are imported to document the dependency even though the driver
// requirement derivation is currently a static mapping. A future enrichment should
// derive `igb` from the observed vendor/device ids rather than restating the mapping;
// this import makes that dependency visible to tooling and to human readers.
import gunbc.machine_intake_mtcollins1_pci_observation {
  mtcollins1_observed_pci_functions,
}
import gunbc.machine_intake_mtcollins1_firmware_security_observation {
  mtcollins1_secure_boot_standing,
  EfiSignatureRequirement,
  efi_signature_requirement,
}

// DERIVED PLATFORM REQUIREMENTS FOR THE HOST IMAGE. The raw PCI and Secure Boot
// observations now live in gunbc.machine_intake_mtcollins1_pci_observation and
// gunbc.machine_intake_mtcollins1_firmware_security_observation respectively (R5
// split, bmc cleanup). This module owns only what the RUNNER HOST needs — the
// qualification of those observations into kernel driver requirements, firmware
// file requirements, and Secure Boot delivery policy. OBSERVATION AND QUALIFICATION
// ARE SEPARATED: the machine-intake side says what was measured; this module says
// what the built image must provide.
//
// THE CONCRETE HARM THIS SEPARATION PREVENTS is the fork this repository keeps
// finding. If the image lane had to re-author CONFIG_IGB, "no firmware blob"
// and "unsigned EFI permitted" as fresh literals beside the observations that
// justify them, two authorities would exist for one fact, agreeing until someone
// edited one. Splitting observation from qualification means the observation
// modules remain the single authority on what was measured, and this module is
// the single authority on what the image needs.

// ── kernel driver requirements ───────────────────────────────────────────────────────────────────

type LinuxKernelDriverRequirement {
  driver: NonEmptyStr
  linkage: KernelDriverLinkage
  reason: NonEmptyStr
}

type KernelDriverLinkage = BuiltIn | LoadableModule

data BuiltIn: KernelDriverLinkage = BuiltIn

// ── Secure Boot delivery policy ──────────────────────────────────────────────────────────────────

type PersistentRootRequirement = PersistentRootForbidden | PersistentRootRequired

data PersistentRootForbidden: PersistentRootRequirement = PersistentRootForbidden

// ── consolidated requirements ────────────────────────────────────────────────────────────────────

type RunnerHostPlatformRequirements {
  kernel_drivers: List<LinuxKernelDriverRequirement>
  firmware_files: List<NonEmptyStr>
  secure_boot_delivery: EfiSignatureRequirement
  persistent_root: PersistentRootRequirement
}

// The PCI observations (mtcollins1_observed_pci_functions) are imported above and
// inform the driver requirement. The driver derivation is currently a static mapping
// from (vendor 8086, device 1521) to igb — a future enrichment could derive this
// from the observed PCI ids directly rather than restating the mapping here.
data mtcollins1_platform_requirements: RunnerHostPlatformRequirements = RunnerHostPlatformRequirements {
  kernel_drivers: [
    LinuxKernelDriverRequirement {
      driver: "igb",
      linkage: BuiltIn,
      reason: "the only observed Ethernet functions are 8086:1521, which igb claims; built in rather than loadable so the host has no need to load kernel code after boot",
    },
  ],
  firmware_files: [],
  secure_boot_delivery: efi_signature_requirement(standing: mtcollins1_secure_boot_standing),
  persistent_root: PersistentRootForbidden,
}
