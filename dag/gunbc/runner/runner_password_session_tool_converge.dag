module gunbc.runner_password_session_tool_converge

import std.types { Bool, List, NonEmptyStr, String }
import v2.std.optional { Present, Absent }
import extdeps.tools { CliTool, apt_package_of }
import gunbc.host_cli_dependency { password_session_host_cli_requirements }
import gunbc.host_effect { HostEffectTransport, FleetSsh }
import gunbc.host_effect_realize {
  Srv3HostPredicate,
  Srv3PredicateHolds,
  Srv3PredicateFails,
  Srv3PredicateUnobserved,
  srv3_ensure_apt_tool,
}
import product.placement_supply { HostIdentity }
import gunbc.fleet_reach_endpoint { fleet_probe_endpoint_for }
import gunbc.fleet_known_hosts_anchor { SshTarget, FleetSshExecutionContext }
import gunbc.runner_host_deploy { RunnerHostDeployFound, RunnerHostDeployUnmodeled, runner_host_deploy_for }
import gunbc.runner_host_grants { executor_bootstrap_principal }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.resources { Network }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.clock_read { clock_now_probed_at, probed_at_word }
import gunbc.actions_run_binding { actions_variable_read, ActionsVariablePresent, ActionsVariableAbsent }
import gunbc.fleet_converge_receipt { fleet_converge_expected_host_env_name }
import gunbc.fleet_ssh_locus { prepare_fleet_ssh_agent_context, FleetSshContextReady, FleetSshContextRefused }

// THE OTHER HALF OF #11061, AND THE ONLY HALF THAT CHANGES A HOST. That change enrolled sshpass as
// a host_cli_dependency and made a password-session leg refuse, before exec, with a typed cause
// naming the binary -- which turned `failed to execute 'sshpass': No such file or directory` into a
// legible refusal but left srv3 and srv4 exactly as unable to run the leg as before. A refusal with
// no route to a fix is the defect docs/plans/dependency-acquisition-gap-analysis.md names: it hands
// a person a sentence, and no modeled thing acts on it. This module is that route.
//
// THE ROSTER IS THE SUBJECT, NOT A SECOND LIST. Which tools must be present is
// gunbc.host_cli_dependency password_session_host_cli_requirements, the same declaration the
// REFUSAL reads. So the thing that converges a runner and the thing that refuses on it cannot
// disagree about what is required: adding a tool to that roster extends both at once, and there is
// no second place to forget. The apt package likewise is not re-authored here -- it is read off the
// CliTool's own installable_via through extdeps.tools apt_package_of, so "which package provides
// this binary" stays one fact (§3).
//
// WHICH HOSTS: the runner roster, gunbc.runner_host_deploy fleet_runner_host_deploys, resolved per
// host through runner_host_deploy_for, which refuses a machine with no deploy row rather than
// borrowing a neighbour's. "Executes a password-session leg" is a property of the TRANSPORT a
// runner must be able to spawn, not of the fleet the far side belongs to -- so the population is
// every runner host, which is exactly the measured incident: spark_grants died on srv3 and srv4
// while srv1 and srv2 carried the binary.

type PasswordSessionToolSubjectAdmission
  = PasswordSessionToolSubjectAdmitted { host: HostIdentity, target: SshTarget }
  | PasswordSessionToolSubjectRefused { cause: String }

// A HOST WITH NO RUNNER DEPLOY ROW IS UNKNOWN, NOT TYPICAL. It refuses rather than converging a
// machine this repository does not model, for the reason runner_host_deploy states in its own
// resolution type: an unclassified machine has no declared administrator principal, so there is no
// account this convergence could honestly act as.
fn password_session_tool_subject(host: HostIdentity) -> PasswordSessionToolSubjectAdmission {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployUnmodeled { host: h } =>
      PasswordSessionToolSubjectRefused {
        cause: join([
          "runner_password_session_tool_converge: ",
          h as String,
          " has no runner deploy row, so it is not a runner host and carries no declared administrator principal",
        ], ""),
      }
    RunnerHostDeployFound { deploy: _ } =>
      PasswordSessionToolSubjectAdmitted {
        host: host,
        target: SshTarget {
          endpoint: fleet_probe_endpoint_for(host: host as String) as NonEmptyStr,
          principal: executor_bootstrap_principal.login,
        },
      }
  }
}

// A TOOL WITH NO APT SOURCE REFUSES RATHER THAN GUESSING ITS PACKAGE. apt_package_of returns
// Optional precisely so this decision is made here, by the caller that knows why it wanted a
// package: a roster tool installed from a GitHub release or shipped with coreutils has no apt
// package, and inventing `apt install <binary name>` would be right often enough to look correct
// and wrong exactly where the two differ -- mosquitto_pub comes from mosquitto-clients, busybox
// from busybox-static, both already in this corpus (§5, no fabricated plausible output).
type PasswordSessionToolOutcome {
  tool: NonEmptyStr
  verdict: Srv3HostPredicate
}

type PasswordSessionToolPlan
  = PasswordSessionToolAptPackage { tool: NonEmptyStr, package: NonEmptyStr }
  | PasswordSessionToolUnacquirable { tool: NonEmptyStr }

fn password_session_tool_plan(tool: CliTool) -> PasswordSessionToolPlan {
  match apt_package_of(tool: tool) {
    Present { value: p } => PasswordSessionToolAptPackage { tool: tool.name, package: p }
    Absent => PasswordSessionToolUnacquirable { tool: tool.name }
  }
}

// require_version_probe IS FALSE, AND THAT IS DERIVED RATHER THAN CHOSEN. sshpass_cli_tool declares
// min_version: none, so there is no version constraint to gate on and a version probe would be
// asserting against nothing. It is also what makes the second run reach no install: with the probe
// off, srv3_ensure_apt_tool returns Srv3PredicateHolds the moment the tool is observed present and
// the install arm is never evaluated. Zero mutation on a converged host is therefore a property of
// the fold's shape, not an assertion laid over it.
//
// THE INSTALLER IS REUSED, NOT RE-AUTHORED, and srv3_ensure_apt_tool is the one this corpus already
// paid for twice: its annotation records that the install must never run on an UNOBSERVED probe (a
// transport that cannot answer must refuse, not install blind) and that the install must sit in a
// BRANCH rather than an argument position (a past regression evaluated the privileged apt install
// on every ensure, including of already-present, correctly-versioned tools). Calling it is how this
// module inherits both walls instead of re-deriving them. Its `srv3_` prefix is now misleading --
// the function is generic over tool and transport -- and renaming it is a follow-up, deliberately
// not this change.
fn converge_one_password_session_tool(
  tool: CliTool,
  transport: HostEffectTransport,
) -> PasswordSessionToolOutcome {
  match password_session_tool_plan(tool: tool) {
    PasswordSessionToolUnacquirable { tool: t } =>
      PasswordSessionToolOutcome {
        tool: t,
        verdict: Srv3PredicateUnobserved {
          reason: join([
            "runner_password_session_tool_converge: ",
            t as String,
            " is enrolled in password_session_host_cli_requirements but its CliTool declares no apt install source, so this convergence has no modeled way to acquire it",
          ], ""),
        },
      }
    PasswordSessionToolAptPackage { tool: t, package: p } =>
      PasswordSessionToolOutcome {
        tool: t,
        verdict: srv3_ensure_apt_tool(
          tool_name: t,
          package: p,
          require_version_probe: false,
          transport: transport,
        ),
      }
  }
}

fn converge_password_session_tools(
  transport: HostEffectTransport,
) -> List<PasswordSessionToolOutcome> {
  map(
    password_session_host_cli_requirements,
    t => converge_one_password_session_tool(tool: t, transport: transport),
  )
}

// THE FLEET EDGE IS THE ONLY ROUTE, and that is a security decision this corpus already made for
// this exact population. apt-get install is root-evaluated, and gunbc.runner_host_file_converge
// refuses to obtain that as the CI job user: "A sudo grant letting the fleet-converge job user
// install them would let every CI job on the host, pull requests included, stage its own content
// and become root. So the writes run over the fleet SSH edge as the declared administrator
// principal." The same reasoning binds here -- a job-user apt grant is a root escalation available
// to every pull request that runs on the host -- so this convergence reaches the runner as the
// administrator principal over FleetSsh even though the step executes ON the target.
fn password_session_tool_transport(
  target: SshTarget,
  context: FleetSshExecutionContext,
) -> HostEffectTransport {
  FleetSsh { target: target, context: context }
}

fn password_session_tool_outcome_holds(outcome: PasswordSessionToolOutcome) -> Bool {
  match outcome.verdict {
    Srv3PredicateHolds => true
    Srv3PredicateFails => false
    Srv3PredicateUnobserved { reason: _ } => false
  }
}

fn password_session_tools_all_hold(outcomes: List<PasswordSessionToolOutcome>) -> Bool {
  fold_list(
    xs: outcomes,
    empty: true,
    cons: fn(acc, o) { acc && password_session_tool_outcome_holds(outcome: o) },
  )
}

// THE RECEIPT IS DERIVED FROM THE SAME OUTCOMES THE CONVERGENCE PRODUCED, so a tool cannot appear
// in one and not the other and its label cannot disagree with its verdict. Unobserved is rendered
// distinctly from fails because they have different remedies: fails means the host answered and the
// tool is still absent, unobserved means nothing was established and an operator must not read it
// as either.
fn password_session_tool_receipt_entry(outcome: PasswordSessionToolOutcome) -> String {
  concat(
    concat(outcome.tool as String, "="),
    match outcome.verdict {
      Srv3PredicateHolds => "present"
      Srv3PredicateFails => "absent"
      Srv3PredicateUnobserved { reason: _ } => "unobserved"
    },
  )
}

fn password_session_tool_receipt(outcomes: List<PasswordSessionToolOutcome>) -> String {
  concat(
    "PasswordSessionToolConvergeReceipt: ",
    join(map(outcomes, o => password_session_tool_receipt_entry(outcome: o)), " "),
  )
}

data runner_password_session_tool_converge_attempt_raw: String = "runner-password-session-tool-converge-ci"

data runner_password_session_tool_converge_receipt_path: String = "target/runner-password-session-tool-converge-receipt.txt"

// ONE HOST PER RUN, NAMED BY THE DISPATCH, which is why the host arrives through the environment
// rather than by folding the roster here. The fleet-converge job is pinned to a runner ON the named
// host, so a run that converged every rostered runner would be reaching three machines from a
// fourth for no reason and would report one verdict over four independent outcomes. The roster
// still decides WHICH TOOLS; the dispatch decides WHICH HOST.
//
// THE RECEIPT IS WRITTEN BEFORE THE VERDICT IS RETURNED, and on the failing path too. A convergence
// whose receipt only survives success is unreadable exactly when it is needed: the operator asking
// "what happened on srv4" is usually asking after a failure.
func runner_password_session_tool_converge_ci_wet() -> ProcessExit
  uses net: Network
{
  match actions_variable_read(name: fleet_converge_expected_host_env_name) {
    ActionsVariableAbsent { variable: v, detail: d } =>
      exit_failure(reason: join([
        "runner_password_session_tool_converge: ", v, " ", d,
        "; one host per run, named by the dispatch",
      ], ""))
    ActionsVariablePresent { value: raw_host } =>
      match password_session_tool_subject(host: raw_host as HostIdentity) {
        PasswordSessionToolSubjectRefused { cause: c } => exit_failure(reason: c)
        PasswordSessionToolSubjectAdmitted { host: h, target: target } =>
          match prepare_fleet_ssh_agent_context(
            attempt_raw: runner_password_session_tool_converge_attempt_raw,
          ) {
            FleetSshContextRefused { cause: c } => exit_failure(reason: c)
            FleetSshContextReady { context: context, receipt: context_receipt } => {
              let outcomes = converge_password_session_tools(
                transport: password_session_tool_transport(target: target, context: context),
              )
              let body = join([
                "runner_password_session_tool_converge host=", h as String,
                " probed_at=", probed_at_word(reading: clock_now_probed_at()) as String, "\n",
                context_receipt,
                password_session_tool_receipt(outcomes: outcomes),
                "\n",
              ], "")
              let w = Filesystem.Write(
                path: runner_password_session_tool_converge_receipt_path,
                content: body,
              )
              if w.success == false {
                exit_failure(reason: join([
                  "runner_password_session_tool_converge: receipt write failed: ", w.error, "\n", body,
                ], ""))
              } else if password_session_tools_all_hold(outcomes: outcomes) == false {
                exit_failure(reason: body)
              } else {
                ExitSuccess
              }
            }
          }
      }
  }
}
