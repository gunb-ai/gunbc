data runner_microvm_slot_controller_disposition: Disposition = SingleAuthority

// THE PROCESS THE microVM SLOT UNIT EXECS AS ITS MainPID (gunbc.runner_microvm_slot_unit): the one
// production route into gunbc.runner_microvm_lifecycle_realize run_controller, and the consumer
// that dissolved its controller_main_pid_consumer_frontier row.
//
// WHAT THIS MODULE IS AND IS NOT. It is COMPOSITION and nothing else: every decision it reaches is
// made by a module that already owned it -- cell admission by the readiness store, the reservation
// re-read by gunbc.fabric_required_build_cell, cell binding by gunbc.runner_microvm_attempt, the
// credential mint by gunbc.runner.runner_jit_perform and gunbc.github_effect_perform, the guest shape
// by gunbc.runner_microvm, the launch plan by gunbc.runner_attempt_launch, the sanitation subject by
// gunbc.runner_microvm_network, and the attempt itself by the lifecycle controller. This module
// obtains each one's INPUTS from the host and hands the outputs down in the order the world
// requires; it adds no verdict and no second orchestration model (DESIGN section 3, replacement
// migrations: integrate the landed controller, never stand a second one beside it).
//
// THE ORDER IS THE SAFETY PROPERTY. Nothing is minted before the slot is bound to this machine and
// its reservation has been re-read from the host CAS; nothing is staged before run_controller has
// recorded the attempt in flight; and every stage before the mint is free of host mutation, so a
// refusal there leaves the host exactly as it was found.
//
// EVERY STAGE THAT CANNOT PROCEED REFUSES WITH THE STAGE NAMED AND THE HOST UNTOUCHED. The refusal
// carrier below has one arm per stage so an operator reading a receipt knows which authority said
// no and what to go and read -- the environment, the roster, the machine's own name, the locus,
// the guest image, the reservation, the cell's ownership, the App control plane, the shape, or the
// network receipt. A String would send them to the wrong module.
type SlotControllerRefusal
  = EnvironmentAbsent { name: String }
  | SlotNotAFabricMember { instance: String }
  | SlotHostBindingRefused { cause: MicrovmHostBindingRefusal }
  | ReleaseLocusIncomplete { path: String }
  | GuestImageIncomplete { path: String }
  | ReservationNotObserved { observation: RequiredBuildCellObservation }
  | CellNotBound { cause: String }
  | ShapeRefused { detail: String }
  | NetworkReceiptUnreadable { path: String, detail: String }
  | NetworkReceiptMalformed { path: String, cause: NonEmptyStr }
  | SanitationSubjectNotAdmitted { refusal: SanitationSubjectRefusal }
  | LaunchNotPlanned { plan: AttemptLaunchPlan }

type SlotControllerOutcome
  = SlotControllerRefused { refusal: SlotControllerRefusal }
  | SlotControllerRan { outcome: ControllerOutcome }

// ── stage 1: the slot, from the unit's own instance ─────────────────────────────────────────────

fn environment_value(name: String) -> String? {
  match shell.Env.Get(name: name as NonEmptyStr).value {
    Absent => none
    Present { value: v } => if trim(s: v) == "" { none } else { Present { value: trim(s: v) } }
  }
}

// THE SLOT IS SELECTED OUT OF THE FABRIC ROSTER, NOT PARSED OUT OF A STRING. The unit instance is
// %i, which the emitter sets to the slot's instance name; matching it against
// fabric_execution_slot_identities is the same selection-over-candidates the network receipt parser
// uses, and it refuses by construction for any instance the roster does not admit -- a GitHub slot,
// a typo, a host that has no fabric member.
fn slot_of_instance(instance: String) -> RunnerSlotIdentity? {
  fold(fabric_execution_slot_identities(), init: none, f: (acc, s) =>
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if runner_slot_instance_name(slot: s) == instance { Present { value: s } } else { none }
    })
}

// THE MACHINE MUST BE THE SLOT'S HOST, READ FROM THE KERNEL AND JOINED THROUGH THE SAME BINDING THE
// FLEET-CONVERGE micro-VM MODES USE (gunbc.runner_microvm_host_ready microvm_host_binding_of):
// a unit for srv1-13 started on any other machine refuses before reading anything else.
fn bind_slot_host(slot: RunnerSlotIdentity) -> MicrovmHostBinding {
  match hostname_short_read(transport: LocalShell) {
    HostnameShortCaptureRefused { reason: r } =>
      MicrovmHostBindingRefused { cause: HostObservationFailed { reason: r } }
    HostnameShortCaptured { value: v } =>
      if trim(s: v) == "" {
        MicrovmHostBindingRefused { cause: HostObservationFailed { reason: "hostname -s returned empty output" } }
      } else {
        microvm_host_binding_of(expected: slot.host as NonEmptyStr, observed: trim(s: v) as NonEmptyStr)
      }
  }
}

// ── stage 2: the locus and the guest image, read as existence ───────────────────────────────────

fn path_is_executable(path: String) -> Bool
  uses net: Network
{
  process_outcome_admitted(outcome: run_shell_command_capture(command: test_executable_command(path: path), transport: LocalExec))
}

fn path_exists(path: String) -> Bool
  uses net: Network
{
  process_outcome_admitted(outcome: run_shell_command_capture(command: test_exists_command(path: path), transport: LocalExec))
}

// THE VMM AND THE JAILER ARE THE LOCUS'S, root-owned and installed beside this binary by the same
// deploy (gunbc.live_deploy.emit microvm_controller_vmm_install_steps). The job-user copy under
// the executor's HOME (gunbc.runner_microvm_host_ready) is never read here, which is what this
// reference buys: the VMM the controller launches is the locus's, not a binary sitting in the
// executor's writable HOME. It is NOT a claim that the job user cannot reach the locus -- ghrunner's
// path-unrestricted sudo install says otherwise on srv1 (gunbc.rung_drop
// the_job_user_holds_a_path_unrestricted_root_grant), and this is the trusted-workload shakedown
// that makes no isolation claim, exactly as the guest-image note below states (review 70080).
type LocusBinaries { firecracker: String, jailer: String }

fn locus_binaries(release_dir: String) -> LocusBinaries {
  LocusBinaries {
    firecracker: microvm_controller_vmm_binary(release_dir: release_dir),
    jailer: microvm_controller_jailer_binary(release_dir: release_dir),
  }
}

// THE GUEST IMAGE SOURCES ARE THE JOB USER'S BUILT IMAGE (gunbc.runner_guest_image, built by the
// guest_image_converge mode under the executor's HOME) and the cited kernel beside it. STATED
// RATHER THAN HIDDEN: those files are job-user-writable and the plan copies them into a root-owned
// jail, so a hostile job on this host could alter the next attempt's guest. This is the trusted-
// workload shakedown and makes no isolation claim; moving the image into the root-owned locus is
// the same repair the VMM already had and is named, not done, here.
type GuestImageSources { kernel: String, rootfs: String }

fn guest_image_sources(spec: RunnerHostSpec) -> GuestImageSources {
  let root = runner_guest_image_root(executor_home: fleet_posix_home_directory(login: spec.job_user) as String)
  GuestImageSources {
    kernel: runner_guest_base_artifact_path(root: root, artifact: runner_guest_kernel_artifact),
    rootfs: runner_guest_image_path(root: root, image: gunbc_runner_guest_image),
  }
}

// ── stage 3: the reservation, re-read from the host CAS ─────────────────────────────────────────

// THE DEMAND AND OFFER ARE DERIVED, NOT REMEMBERED (gunbc.runner_microvm_shakedown): the same
// authority the placer used, so the hold owner the CAS carries is one this process can name.
fn observe_reservation(slot: RunnerSlotIdentity) -> RequiredBuildCellObservation
  uses net: Network, fs: Filesystem
{
  observe_required_build_cell_wet(
    root: fabric_control_plane_store_root(),
    host: slot.host,
    slot: slot,
    demand: microvm_shakedown_demand(slot: slot),
    offer: microvm_shakedown_offer(slot: slot),
  )
}

// ── stage 4: the credential ─────────────────────────────────────────────────────────────────────

// THE CONTROL PLANE IS OBSERVED FROM THIS PROCESS, UNDER THE CONTROLLER'S OWN KEY, EVERY ATTEMPT.
// gunbc.runner_jit_mint plan_jit_mint admits a mint only under a GitHubAppControlPlaneState that
// reports the installation grant, and gunbc.auth.github_app_control_plane_observe
// observe_github_app_control_plane is the producer that seals it: signer custody (the key's
// signature accepted by GitHub), the App registration's permissions against the goal, and the
// installation's grant. An unreachable or refusing control plane is carried INSIDE the state rather
// than as a separate arm here, and the mint's credential join refuses on it -- so there is no
// "not observable" path for this module to invent.
fn observe_app_control_plane() -> GitHubAppControlPlaneState
  uses net: Network
{
  observe_github_app_control_plane(
    app: lifecycle_controller_app,
    key: lifecycle_controller_app_key,
    installation: gunbai_ci_declared_installation_id,
    required: gunbai_ci_registration_goal.required_permissions,
    reason: "the microVM slot controller observes the gunbai-ci App control plane before minting an attempt's JIT registration" as NonEmptyStr,
  )
}

fn controller_credential_authority() -> GitHubCredentialAuthority {
  ManagedAppInstallationCredential {
    app: gunbai_ci_declared,
    installation: gunbai_ci_declared_installation_id,
    profile: GitHubCredentialProfileRef { name: "microvm-slot-controller" },
  }
}

fn mint_attempt_credential(binding: MicroVmCellBinding, state: GitHubAppControlPlaneState) -> JitMintPerformance
  uses net: Network
{
  perform_organization_jit_mint(dispatch: dispatch_jit_mint(
    binding: binding,
    authority: controller_credential_authority(),
    control_plane: state,
    organization: github_organization_ref(),
    runner_group: RunnerGroupRestrictionUnobserved { group: microvm_shakedown_runner_group },
    attempt_binding: jit_admission_axis_standing(axis: AttemptBindingAxis),
  ))
}

// ── stage 5: the slot network receipt, read from its durable host path ──────────────────────────

// THE RECEIPT IS READ FROM ITS DURABLE ROOT-OWNED PATH (gunbc.runner_microvm_network
// runner_microvm_converged_receipt_path), PARSED, AND THE SUBJECT DERIVED FROM THE PARSED VALUE --
// the consumption gunbc.runner_microvm_network's converged_slot_network_parse_consumer_frontier
// named. The producer is the administrator-edge observe the network lane owns (parent ruling
// 2026-09-21: never a job-user-writable file that root believes); until it lands every read here
// is Unreadable, which refuses the attempt BEFORE the mint rather than quarantining a cell after a
// run. The brief's network-quarantine arm is reached only once a receipt exists and the readings
// themselves are Unreadable.

type NetworkSubjectResolution
  = NetworkSubjectResolved { subject: SlotNetworkSanitationSubject }
  | NetworkSubjectRefused { refusal: SlotControllerRefusal }

fn resolve_network_subject(slot: RunnerSlotIdentity) -> NetworkSubjectResolution
  uses fs: Filesystem
{
  let read = Filesystem.Read(path: runner_microvm_converged_receipt_path)
  if !read.success {
    NetworkSubjectRefused { refusal: NetworkReceiptUnreadable { path: runner_microvm_converged_receipt_path, detail: read.error } }
  } else {
    match parse_converged_slot_network(text: read.content, candidates: fabric_execution_slot_identities()) {
      ConvergedSlotNetworkMalformed { cause: c } =>
        NetworkSubjectRefused { refusal: NetworkReceiptMalformed { path: runner_microvm_converged_receipt_path, cause: c } }
      ConvergedSlotNetworkParsed { receipt: r } =>
        match slot_network_sanitation_subject(slot: slot, receipt: r) {
          SanitationSubjectRefused { refusal: rf } => NetworkSubjectRefused { refusal: SanitationSubjectNotAdmitted { refusal: rf } }
          SanitationSubjectAdmitted { subject: s } => NetworkSubjectResolved { subject: s }
        }
    }
  }
}

// ── the composition ─────────────────────────────────────────────────────────────────────────────

fn slot_controller(instance: String, release_dir: String, invocation_id: NonEmptyStr) -> SlotControllerOutcome
  uses net: Network, fs: Filesystem
{
  match slot_of_instance(instance: instance) {
    Absent => SlotControllerRefused { refusal: SlotNotAFabricMember { instance: instance } }
    Present { value: slot } =>
      match bind_slot_host(slot: slot) {
        MicrovmHostBindingRefused { cause: c } => SlotControllerRefused { refusal: SlotHostBindingRefused { cause: c } }
        MicrovmHostBound { spec: spec, host: _ } =>
          slot_controller_on_host(slot: slot, spec: spec, release_dir: release_dir, invocation_id: invocation_id)
      }
  }
}

fn slot_controller_on_host(slot: RunnerSlotIdentity, spec: RunnerHostSpec, release_dir: String, invocation_id: NonEmptyStr) -> SlotControllerOutcome
  uses net: Network, fs: Filesystem
{
  let bins = locus_binaries(release_dir: release_dir)
  let image = guest_image_sources(spec: spec)
  if !path_is_executable(path: bins.firecracker) {
    SlotControllerRefused { refusal: ReleaseLocusIncomplete { path: bins.firecracker } }
  } else if !path_is_executable(path: bins.jailer) {
    SlotControllerRefused { refusal: ReleaseLocusIncomplete { path: bins.jailer } }
  } else if !path_exists(path: image.kernel) {
    SlotControllerRefused { refusal: GuestImageIncomplete { path: image.kernel } }
  } else if !path_exists(path: image.rootfs) {
    SlotControllerRefused { refusal: GuestImageIncomplete { path: image.rootfs } }
  } else {
    match observe_reservation(slot: slot) {
      RequiredBuildCellObserved { snapshot: snapshot } =>
        slot_controller_on_reservation(slot: slot, snapshot: snapshot, bins: bins, image: image, invocation_id: invocation_id)
      not_observed => SlotControllerRefused { refusal: ReservationNotObserved { observation: not_observed } }
    }
  }
}

fn slot_controller_on_reservation(
  slot: RunnerSlotIdentity,
  snapshot: RequiredBuildCellSnapshot,
  bins: LocusBinaries,
  image: GuestImageSources,
  invocation_id: NonEmptyStr,
) -> SlotControllerOutcome
  uses net: Network, fs: Filesystem
{
  let binding = bind_microvm_to_cell(snapshot: snapshot)
  match binding {
    VmUnboundCellNotOwned { cause: c } => SlotControllerRefused { refusal: CellNotBound { cause: c } }
    VmBoundToOwnedCell { attempt: attempt, rootfs_path: _, vm_config_path: _, unit_name: _, slice_property: _ } =>
      match gunbc_runner_microvm_shape_for_slot(slot: slot) {
        MicroVmShapeRefused { refusal: r } => SlotControllerRefused { refusal: ShapeRefused { detail: runner_microvm_shape_refusal_text(r: r) } }
        MicroVmShapeResolved { shape: shape } =>
          match resolve_network_subject(slot: slot) {
            NetworkSubjectRefused { refusal: r } => SlotControllerRefused { refusal: r }
            NetworkSubjectResolved { subject: subject } =>
              {
                let state = observe_app_control_plane()
                  slot_controller_launch(
                    snapshot: snapshot, attempt: attempt, shape: shape, subject: subject, bins: bins, image: image,
                    invocation_id: invocation_id,
                    mint: mint_attempt_credential(binding: binding, state: state),
                  )
              }
          }
      }
  }
}

// THE MINT HAPPENS BEFORE THE PLAN, SO A REFUSED PLAN CAN ALREADY HAVE A REGISTRATION BEHIND IT,
// AND THAT DECIDES WHICH ARM A REFUSAL TAKES (review 69759 found the first cut running the
// controller only on an authorized plan while its note claimed otherwise). Two facts, two arms:
//   - the plan refused and the mint DELIVERED a registration (LaunchRefusedJitCredential and
//     LaunchRefusedPriorResources are exactly the post-mint refusals): run_controller runs anyway,
//     because its in-flight record carries the registration id and its teardown runs whatever the
//     launch did -- which for a refused plan is VmmNotPlanned and the stop-and-observe readbacks --
//     so the registration is RECORDED against the cell rather than lost. What no module does today
//     is delete the organization registration itself: the JIT registration is ephemeral on GitHub's
//     side and this lane names it as a residue rather than claiming a reconciliation it does not
//     perform.
//   - the plan refused and no registration was delivered (the mint itself refused, or the
//     authorization refused before the credential was admitted): nothing exists to reconcile, and
//     the refusal is reported with the host untouched.
// The identity's credential device path is derived the way the planner derives it -- the jail root
// for this attempt and the jail's credential path -- so the readback proves absent the path a
// launch would have used, not a path invented for the refusal.
fn minted_registration(mint: JitMintPerformance) -> Int? {
  match mint {
    JitMintReceived { delivery: d } =>
      match d {
        JitCredentialBoundToAttempt { attempt: _, credential: _, runner_id: id } => Present { value: id }
        JitCredentialNotDispatched { refusal: _ } => none
        JitCredentialMintNotCreated { outcome: _ } => none
      }
    JitMintAppKeyNotCustodied { app: _ } => none
    JitMintClockUnread { detail: _ } => none
    JitMintAppJwtUnsigned { detail: _ } => none
    JitMintStepNotSucceeded { step: _, performance: _ } => none
  }
}

fn attempt_identity_for(
  snapshot: RequiredBuildCellSnapshot,
  attempt: MicroVmAttempt,
  invocation_id: NonEmptyStr,
  registration: Int,
  bins: LocusBinaries,
) -> AttemptIdentity {
  AttemptIdentity {
    attempt: attempt,
    allocation_generation: snapshot.generation,
    invocation_id: invocation_id,
    jit_registration_id: to_string(registration) as NonEmptyStr,
    credential_device_path: join([attempt_jail_chroot_root(attempt: attempt, firecracker_binary: bins.firecracker), jail_jit_path as String], ""),
    guest_image: gunbc_runner_guest_image,
  }
}

fn slot_controller_launch(
  snapshot: RequiredBuildCellSnapshot,
  attempt: MicroVmAttempt,
  shape: RunnerMicroVmShape,
  subject: SlotNetworkSanitationSubject,
  bins: LocusBinaries,
  image: GuestImageSources,
  invocation_id: NonEmptyStr,
  mint: JitMintPerformance,
) -> SlotControllerOutcome
  uses net: Network, fs: Filesystem
{
  let plan = plan_attempt_launch_reservation_authorized(
    snapshot: snapshot,
    work: microvm_shakedown_work(),
    allocation_generation: snapshot.generation,
    attempt: attempt,
    mint: mint,
    ground: observe_attempt_ground(attempt: attempt),
    jailer_binary: bins.jailer,
    firecracker_binary: bins.firecracker,
    kernel_source: image.kernel,
    rootfs_source: image.rootfs,
    shape: shape,
  )
  match minted_registration(mint: mint) {
    Present { value: registration } =>
      SlotControllerRan {
        outcome: run_controller(
          identity: attempt_identity_for(snapshot: snapshot, attempt: attempt, invocation_id: invocation_id, registration: registration, bins: bins),
          allocation_generation: snapshot.generation,
          plan: plan,
          subject: subject,
        ),
      }
    Absent => SlotControllerRefused { refusal: LaunchNotPlanned { plan: plan } }
  }
}

// ── the entry the unit execs, and its receipt ───────────────────────────────────────────────────

fn slot_controller_receipt_path(instance: String, invocation_id: NonEmptyStr) -> String {
  join([microvm_slot_controller_receipt_dir, "/", instance, "-", invocation_id as String, ".txt"], "")
}

fn refusal_text(r: SlotControllerRefusal) -> String {
  match r {
    EnvironmentAbsent { name: n } => join(["EnvironmentAbsent ", n, " -- the unit did not set it, so the controller cannot name its slot or locus"], "")
    SlotNotAFabricMember { instance: i } => join(["SlotNotAFabricMember ", i, " -- not in gunbc.runner_slot_allocation fabric_execution_slot_identities"], "")
    SlotHostBindingRefused { cause: c } => join(["SlotHostBindingRefused ", microvm_host_binding_refusal_text(c: c)], "")
    ReleaseLocusIncomplete { path: p } => join(["ReleaseLocusIncomplete ", p, " is not an executable in the release locus"], "")
    GuestImageIncomplete { path: p } => join(["GuestImageIncomplete ", p, " is absent"], "")
    ReservationNotObserved { observation: o } => join(["ReservationNotObserved ", reservation_observation_text(o: o)], "")
    CellNotBound { cause: c } => join(["CellNotBound ", c], "")
    ShapeRefused { detail: d } => join(["ShapeRefused ", d], "")
    NetworkReceiptUnreadable { path: p, detail: d } => join(["NetworkReceiptUnreadable ", p, ": ", d], "")
    NetworkReceiptMalformed { path: p, cause: c } => join(["NetworkReceiptMalformed ", p, ": ", c as String], "")
    SanitationSubjectNotAdmitted { refusal: _ } => "SanitationSubjectNotAdmitted -- the converged receipt does not admit this slot's sanitation subject"
    LaunchNotPlanned { plan: _ } => "LaunchNotPlanned -- the planner refused and no registration was minted, so there is nothing on the host or at GitHub to reconcile and the controller was not entered"
  }
}

fn reservation_observation_text(o: RequiredBuildCellObservation) -> String {
  match o {
    RequiredBuildCellObserved { snapshot: _ } => "observed"
    ReservationAbsent { slot_key: k } => join(["no reservation holds ", k as String], "")
    ReservationUnreadable { slot_key: k } => join(["the allocation store could not be read for ", k as String], "")
    ReservationPayloadUndecodable { slot_key: k } => join(["the hold payload for ", k as String, " did not decode"], "")
    ReservationPayloadWorkMismatch { slot_key: k } => join(["the hold on ", k as String, " belongs to a different demand/offer than the shakedown's"], "")
    SelectedOfferCellMismatch { slot_key: k, executor: e } => join(["the shakedown offer's executor ", e as String, " is not the slot key ", k as String], "")
    CellSubstrateNotConverged { cell: c } => join(["the cell substrate for ", c as String, " is not converged"], "")
    UnownedCell { cell: c } => join(["the cell ", c as String, " is not owned"], "")
  }
}

fn outcome_text(o: SlotControllerOutcome) -> String {
  match o {
    SlotControllerRefused { refusal: r } => join(["refused: ", refusal_text(r: r)], "")
    SlotControllerRan { outcome: c } => join(["ran: ", controller_outcome_label(c: c)], "")
  }
}

fn controller_outcome_label(c: ControllerOutcome) -> String {
  match c {
    ControllerRefusedAdmission { admission: _ } => "controller-refused-admission"
    ControllerRefusedBinding { binding: _ } => "controller-refused-binding"
    ControllerQuarantinedUnattributedResidue { persisted: _ } => "controller-quarantined-unattributed-residue"
    ControllerStartNotRecorded { persisted: _ } => "controller-start-not-recorded"
    ControllerRecovered { teardown: _ } => "controller-recovered"
    ControllerRanAttempt { launch: _, trigger: _, bring_up: b, teardown: t } => join(["controller-ran-attempt ", guest_bring_up_text(r: b), " ", teardown_cleanup_text(t: t)], "")
  }
}

// THE EXIT IS ZERO ONLY WHEN THE CONTROLLER RAN AND ITS RECEIPT IS ON DISK. A run that quarantined
// its cell still exits zero: the unit's job was to run the attempt and settle the cell, and it did.
// A refusal before the controller exits non-zero with the stage named, so systemd's own failed
// state is the operator's first signal that no attempt happened. AND A RECEIPT THAT COULD NOT BE
// WRITTEN IS ITSELF A FAILURE (review 69796: the first cut discarded the write's result): the
// receipt is the one operator-facing artifact of an incarnation, and Restart=no exists so a
// refused slot stays refused until someone has read it -- exiting zero over an unwritten receipt
// would be the fabricated success DESIGN section 5 forbids.
fn microvm_slot_controller_main() -> ProcessExit
  uses net: Network, fs: Filesystem
{
  match environment_value(name: microvm_slot_env_name) {
    Absent => exit_failure(reason: refusal_text(r: EnvironmentAbsent { name: microvm_slot_env_name }))
    Present { value: instance } =>
      match environment_value(name: microvm_release_dir_env_name) {
        Absent => exit_failure(reason: refusal_text(r: EnvironmentAbsent { name: microvm_release_dir_env_name }))
        Present { value: release_dir } =>
          match environment_value(name: systemd_invocation_id_env_name) {
            Absent => exit_failure(reason: refusal_text(r: EnvironmentAbsent { name: systemd_invocation_id_env_name }))
            Present { value: invocation } =>
              controller_exit(
                instance: instance,
                invocation_id: invocation as NonEmptyStr,
                outcome: slot_controller(instance: instance, release_dir: release_dir, invocation_id: invocation as NonEmptyStr),
              )
          }
      }
  }
}

// systemd SETS $INVOCATION_ID FOR EVERY SERVICE IT STARTS (systemd.exec(5)): a 128-bit id unique
// to this unit incarnation. It is the attempt's invocation id -- written to the readiness store
// before staging, set on the VMM unit's Environment, read back at teardown -- so the whole attempt
// is keyed on the one identifier systemd itself minted for this process.
data systemd_invocation_id_env_name: String = "INVOCATION_ID"

fn controller_exit(instance: String, invocation_id: NonEmptyStr, outcome: SlotControllerOutcome) -> ProcessExit
  uses fs: Filesystem
{
  let text = outcome_text(o: outcome)
  let path = slot_controller_receipt_path(instance: instance, invocation_id: invocation_id)
  let w = Filesystem.Write(path: path, content: concat(text, "\n"))
  if !w.success {
    exit_failure(reason: join(["microvm_slot_controller ", instance, ": receipt write refused at ", path, ": ", w.error, " -- outcome was: ", text], ""))
  } else {
    match outcome {
      SlotControllerRan { outcome: _ } => ExitSuccess
      SlotControllerRefused { refusal: _ } => exit_failure(reason: join(["microvm_slot_controller ", instance, ": ", text], ""))
    }
  }
}
