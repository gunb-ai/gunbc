// THE HOST FILES A RUNNER HOST MUST CARRY FOR ITS SLOTS TO BE TORN DOWN WHOLE, CONVERGED OVER THE
// FLEET EDGE AS THE HOST'S ADMINISTRATOR.
//
// WHAT IT FIXES, MEASURED. apt-daily-upgrade installs security updates every morning; when one of them
// replaces a library a runner maps (libc6 on 2026-09-11), needrestart runs `systemctl restart` over
// every actions-runner@ unit. The live unit is `KillMode=process`, so the restart kills the listener
// and nothing else: srv1's journal records `Unit process ... (Runner.Worker) remains running after unit
// stopped` for the in-flight job's worker, claim_executor and gunbc, then `Found left-over process ...
// Ignoring`, and thirteen seconds later a new listener takes a new job into the SAME _work directory.
// The two jobs then delete each other's toolchain and checkout and share one slot's memory ceiling --
// the vanished rustc, registry sources and toolchain components the CI floor reported that morning.
// srv1's dpkg log shows needrestart restarting runner units on ten separate days since June.
//
// TEARDOWN AND NEEDRESTART STILL REACH THE FLEET WHEN DEPRIV CANNOT. Those two files are the orphan
// class; neither is sufficient alone, and neither depends on the job-user docker uid. Depriv is a
// per-file refusal while runner_job_user_xdg_runtime_uid is TranscribedUncited: it is withheld
// (counted, not written) so live depriv.conf is not overwritten from a bet. The fragment waits
// with it: installing the unit file without a modeled depriv drop-in would be correct only on
// hosts that still happen to carry a hand-placed depriv.conf. Fragment User= is still
// deploy.runner_user, not root, when the figure is CitedToAuthority and both files land.
//
// WHO WRITES, AND WHY NOT THE CI JOB USER. Both files are evaluated by root: systemd merges the drop-in
// and needrestart `eval`s its conf.d snippet as Perl. A sudo grant letting the fleet-converge job user
// install them would let every CI job on the host, pull requests included, stage its own content and
// become root. So the writes run over the fleet SSH edge as the declared administrator principal
// (gunbc.fleet.fleet_bootstrap_principal executor_bootstrap_principal), and the job user gains no grant.
//
// NOTHING HERE RESTARTS A SLOT. The drop-in takes effect at daemon-reload for every loaded unit, and a
// running job keeps running; the next stop of that slot, from any source, reaches the whole cgroup.
//
// EVERY DECISION IS DERIVED FROM WHAT THE HOST REPORTS, NOT FROM WHAT THIS RUN DID, so a run that stops
// partway is finished by the next one. Whether a reload is owed is the manager's own NeedDaemonReload,
// not "this invocation wrote a file" -- the latter is false on the retry after a reload failed, which
// would leave the bytes right and the manager stale forever. Whether the teardown holds is read from
// EVERY slot unit, desired or merely loaded, not from a representative one. And a file is only left in
// place when its bytes AND its ownership are right: root evaluates both files, so an identical file a
// CI user could rewrite is not converged.

type FleetHostFileDesired {
  subject: NonEmptyStr
  path: FilePath
  content: String
  mode: RemoteFileMode
  validation: RemoteFileValidation
}

type RunnerHostFileWithheld {
  subject: NonEmptyStr
  cause: NonEmptyStr
}

type RunnerHostFileDesiredPopulation
  = RunnerHostFilesDesired { files: List<FleetHostFileDesired>, withheld: List<RunnerHostFileWithheld> }
  | RunnerHostFilesDesiredRefused { cause: NonEmptyStr }

// Every desired path lives under /etc, and typed_remote_file_write refuses a path outside the scope it
// is sealed against, so this row is the whole of what the converge may write.
data fleet_host_file_scope: FileTreeScope = FileTreeScope { root_path: "/etc" as NonEmptyStr }

data runner_needrestart_conf_d_stem: NonEmptyStr = "50-gunbc-actions-runner" as NonEmptyStr

// THE SLOT'S CPU CEILING, AS THE DROP-IN THE CONVERGE OWNS. 60-fleet-cpu.conf is the managed name
// (gunbc.host.host_converge gunbc_runner_per_slot_cpu_dropin_path), and its one value is the per-slot
// quota gunbc.ci.ci_runner_placement host_cpu_allocation derives for this host -- the same field the
// unit's CARGO_BUILD_JOBS binds to. Writing it here replaces whatever occupies that path, including
// a hand-placed copy, so the path cannot be left as orphan drift. It does not depend on the job
// user's uid, so it reaches a host whose uid read failed.
type RunnerSlotCpuDesired
  = SlotCpuDesired { per_slot: HardwareThreadCount, file: FleetHostFileDesired }
  | SlotCpuRefused { cause: NonEmptyStr }

fn runner_slot_cpu_desired(host: HostIdentity) -> RunnerSlotCpuDesired {
  match runner_host_deployment_for(p: runner_deployment_plan(), host: host) {
    HostRunnerDeploymentRefused { refusal: r } =>
      SlotCpuRefused { cause: concat("runner_host_file_converge: the runner deployment refuses, so no per-slot CPU quota is derived: ", host_deployment_refusal_text(c: r.cause)) as NonEmptyStr }
    HostRunnerDeploymentDerived { deployment: d } =>
      match d.per_runner_cpu_boundary {
        NoCpuCeiling => SlotCpuRefused { cause: "runner_host_file_converge: the deployment declares no per-slot CPU ceiling" as NonEmptyStr }
        CapacityQuota { threads: t } =>
          SlotCpuDesired {
            per_slot: t,
            file: FleetHostFileDesired {
              subject: "runner-cpu-dropin" as NonEmptyStr,
              path: gunbc_runner_per_slot_cpu_dropin_path as FilePath,
              content: cap_dropin_content(
                property: systemd_cpu_quota_property,
                bytes_value: systemd_directive_value_wire(value: DirectiveCpuTime { threads: t }) as NonEmptyStr,
              ),
              mode: RemoteFileModeOwnerReadWriteWorldRead,
              validation: NoValidation,
            },
          }
      }
  }
}

fn runner_host_teardown_and_needrestart(prefix: NeedrestartUnitNamePrefix) -> List<FleetHostFileDesired> {
  [
    FleetHostFileDesired {
      subject: "runner-teardown-dropin" as NonEmptyStr,
      path: runner_unit_teardown_dropin_path() as FilePath,
      content: gunbc_runner_unit_teardown_dropin_text(),
      mode: RemoteFileModeOwnerReadWriteWorldRead,
      validation: NoValidation,
    },
    FleetHostFileDesired {
      subject: "needrestart-runner-deferral" as NonEmptyStr,
      path: needrestart_conf_d_path(stem: runner_needrestart_conf_d_stem) as FilePath,
      content: needrestart_conf_d_text(overrides: [
        NeedrestartServiceSelectionOverride { units: prefix, selection: RestartDeferredByDefault },
      ]),
      mode: RemoteFileModeOwnerReadWriteWorldRead,
      validation: NoValidation,
    },
  ]
}

fn runner_host_fragment_file(fragment: String) -> FleetHostFileDesired {
  FleetHostFileDesired {
    subject: "runner-unit-fragment" as NonEmptyStr,
    path: runner_unit_system_path as FilePath,
    content: fragment,
    mode: RemoteFileModeOwnerReadWriteWorldRead,
    validation: NoValidation,
  }
}

fn runner_host_depriv_file(depriv: String) -> FleetHostFileDesired {
  FleetHostFileDesired {
    subject: "runner-depriv-dropin" as NonEmptyStr,
    path: runner_unit_depriv_dropin_path() as FilePath,
    content: depriv,
    mode: RemoteFileModeOwnerReadWriteWorldRead,
    validation: NoValidation,
  }
}

// A DEPLOY SLOT'S ROLE DROP-IN IS A FILE OF THE POPULATION, one per deploy slot of the host, delivered
// by the same converge and read back by the same byte comparison as the template drop-ins. A host
// with no deploy slot owes none. A refused rendering is WITHHELD with its own cause and never skipped,
// and what remains is delivered: the slot then keeps whatever drop-in it has, and its tenancy
// reading (gunbc.ci.deploy_slot_tenancy deploy_slot_observed_tenancy) says what it runs as.
fn runner_host_slot_role_file(deploy: RunnerHostDeploy, slot: RunnerSlotIdentity) -> FleetHostFileDesired? {
  match runner_unit_slot_role_dropin_text(deploy: deploy, slot: slot) {
    Absent => Absent
    Present { value: RunnerUnitTextRefused { reason: _ } } => Absent
    Present { value: RunnerUnitText { text: text } } =>
      Present { value: FleetHostFileDesired {
        subject: "runner-slot-role-dropin" as NonEmptyStr,
        path: runner_unit_slot_role_dropin_path(slot: slot) as FilePath,
        content: text,
        mode: RemoteFileModeOwnerReadWriteWorldRead,
        validation: NoValidation,
      } }
  }
}

fn runner_host_slot_role_withheld(deploy: RunnerHostDeploy, slot: RunnerSlotIdentity) -> List<RunnerHostFileWithheld> {
  match runner_unit_slot_role_dropin_text(deploy: deploy, slot: slot) {
    Present { value: RunnerUnitTextRefused { reason: r } } =>
      [RunnerHostFileWithheld { subject: "runner-slot-role-dropin" as NonEmptyStr, cause: r }]
    _ => []
  }
}

// ── Every managed drop-in loads its own keys ─────────────────────────────────────────────────────

fn runner_host_path_is_unit_dropin(path: String) -> Bool { ends_with(s: path_parent(path: path), suffix: ".service.d") }

fn runner_host_path_is_template_dropin(path: String) -> Bool { string_contains(s: path_parent(path: path), pattern: "@.service.d") }

// THE GUARD ON A MANAGED DROP-IN: the loaded drop-ins of the host's desired units are read, and the file is
// refused if a loaded drop-in that does not sort before it sets one of its keys (read_dropin_override_over).
// A template drop-in exempts the converge's own INSTANCE drop-ins, whose purpose is to override it for one
// unit; whether they sort after it is a claim over the managed population, not a runtime finding. A file
// that is not a unit drop-in is not guarded.
fn runner_host_dropin_guard_over(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, file: FleetHostFileDesired, managed: List<FleetHostFileDesired>) -> DropinOverrideReading? {
  let path = file.path as String
  if !runner_host_path_is_unit_dropin(path: path) { none } else {
    let exempt = if runner_host_path_is_template_dropin(path: path) {
      map(filter(managed, m => runner_host_path_is_unit_dropin(path: m.path as String) && !runner_host_path_is_template_dropin(path: m.path as String)), m => m.path as NonEmptyStr)
    } else { [] }
    Present { value: read_dropin_override_over(subject: subject, context: context, units: subject.desired_units, written: [file], exempt: exempt) }
  }
}

// A REFUSED GUARD IS A REFUSED PLAN: the file is not written or left as settled, so the run does not
// reload or actuate on a drop-in whose keys would not load.
fn runner_host_file_result_guarded(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, mode: FleetHostFileConvergeMode, privilege: FleetHostPrivilegeStanding, file: FleetHostFileDesired, managed: List<FleetHostFileDesired>) -> FleetHostFileResult {
  let planned = plan_fleet_host_file(subject: fleet_subject_of(s: subject), context: context, file: file)
  let guarded = match runner_host_dropin_guard_over(subject: subject, context: context, file: file, managed: managed) {
    Absent => planned
    Present { value: DropinsNoLaterSetter } => planned
    Present { value: DropinsLaterSetter { files: fs } } =>
      FleetHostFilePlanned { file: planned.file, observation: planned.observation, action: HostFileActionRefused { reason: concat("a loaded drop-in that sorts at or after this one sets a key it sets, so its value would not load: ", join(map(non_empty_to_list(xs: fs), x => x as String), " ")) } }
    Present { value: DropinsUnread { cause: c } } =>
      FleetHostFilePlanned { file: planned.file, observation: planned.observation, action: HostFileActionRefused { reason: concat("whether a later-sorting drop-in overrides this one could not be read: ", c) } }
  }
  fleet_host_file_result_of_planned(subject: fleet_subject_of(s: subject), context: context, mode: mode, privilege: privilege, planned: guarded)
}

// ── A renamed managed drop-in retires its old name ───────────────────────────────────────────────

// THE ROLE DROP-IN'S SUPERSEDED NAME (gunbc.runner.runner_unit_file
// runner_unit_slot_role_superseded_dropin_file_name) is a file this converge placed and now removes, so a host
// never keeps a second copy of a role that loses to the template. Absent is the converged state; present is
// removed as root and read again, and only a re-read that finds it gone settles. The observation and the
// removal are the retired-path rule the unit residue uses (retired_path_standing_over,
// retired_file_removal_leg). It is not a RetiredHostResidue row because that shape retires a UNIT -- it stops
// and disables it -- and the unit here is the live deploy slot whose old drop-in alone is retired.
// DISSOLUTION: srv1 is the only host that ever carried the old name; once a converge of every host with a
// deploy slot reads it absent, runner_unit_slot_role_superseded_dropin_file_name and this step are deleted.
type SupersededDropinResult
  = SupersededDropinAbsent { path: String }
  | SupersededDropinRemoved { path: String }
  | SupersededDropinPresentObserved { path: String }
  | SupersededDropinRefused { path: String, reason: String }

fn runner_host_superseded_dropin_paths(host: HostIdentity) -> List<String> {
  map(filter(deploy_slot_identities, s => (s.host as String) == (host as String)), s => runner_unit_slot_role_superseded_dropin_path(slot: s) as String)
}

// THE SET-PROPERTY SHADOWS OF THE CAPS THIS CONVERGE OWNS retire by the same rule. `systemctl set-property`
// on a runner unit (the root-era caps of 2026-08-11) leaves 50-<Property>.conf under the unit's .d in
// /etc/systemd/system.control or /run/systemd/system.control, and those directories outrank the
// template's cap drop-ins, so a shadow of a cap property is a second writer of that cap. This converge is
// the runner-unit drop-ins' one writer, so it removes exactly those files for its desired units and the
// properties its cap members set (gunbc.host.host_axis_caps control_shadow_residue_paths,
// runner_slot_cap_properties) -- never the unit's other drop-ins, which `systemctl revert` would take
// (gunbc.recurring_failure_mode a_residue_teardown_removes_every_dropin_of_the_unit_it_names).
fn runner_host_control_shadow_paths(subject: RunnerHostFileSubject) -> List<String> {
  flat_map(subject.desired_units, u => map(control_shadow_residue_paths(unit: u, properties: runner_slot_cap_properties()), p => p as String))
}

// A SHADOW IS REMOVED ONLY OVER SETTLED CAPS. Removing a set-property shadow exposes the template's cap
// drop-ins; while the cap phase has not settled them (reload_barred), that could raise a slot's effective
// caps to bytes nobody admitted, so an apply refuses the path instead of removing it, and an observe-only
// run reads it as usual.
fn retire_control_shadow_over(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, mode: FleetHostFileConvergeMode, privilege: FleetHostPrivilegeStanding, caps_settled: Bool, path: String) -> SupersededDropinResult {
  match mode {
    FleetHostFilesObserveOnly => retire_superseded_dropin_over(subject: subject, context: context, mode: mode, privilege: privilege, path: path)
    FleetHostFilesApply =>
      if caps_settled {
        retire_superseded_dropin_over(subject: subject, context: context, mode: mode, privilege: privilege, path: path)
      } else {
        SupersededDropinRefused { path: path, reason: "not removed: the slot memory-cap phase has not settled the template cap drop-ins, so removing a set-property shadow could expose unadmitted caps" }
      }
  }
}

fn retire_superseded_dropin_over(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, mode: FleetHostFileConvergeMode, privilege: FleetHostPrivilegeStanding, path: String) -> SupersededDropinResult {
  match retired_path_standing_over(subject: subject, context: context, path: path) {
    HostFilePathAbsent => SupersededDropinAbsent { path: path }
    HostFilePathUnreadable { cause: c } => SupersededDropinRefused { path: path, reason: c }
    HostFilePathPresent =>
      match mode {
        FleetHostFilesObserveOnly => SupersededDropinPresentObserved { path: path }
        FleetHostFilesApply =>
          match privilege {
            AdministratorPrivilegeRefused { reason: why } => SupersededDropinRefused { path: path, reason: concat("administrator privilege refused: ", why) }
            AdministratorPrivilegeAvailable =>
              match retire_leg(subject: subject, context: context, step: retired_file_removal_leg(path: path).step, argv: retired_file_removal_leg(path: path).argv) {
                Present { value: why } => SupersededDropinRefused { path: path, reason: why }
                Absent =>
                  match retired_path_standing_over(subject: subject, context: context, path: path) {
                    HostFilePathAbsent => SupersededDropinRemoved { path: path }
                    HostFilePathPresent => SupersededDropinRefused { path: path, reason: "still present after removal" }
                    HostFilePathUnreadable { cause: c } => SupersededDropinRefused { path: path, reason: concat("unread after removal: ", c) }
                  }
              }
          }
      }
  }
}

fn superseded_dropin_settled(r: SupersededDropinResult) -> Bool {
  match r {
    SupersededDropinAbsent { path: _ } => true
    SupersededDropinRemoved { path: _ } => true
    SupersededDropinPresentObserved { path: _ } => false
    SupersededDropinRefused { path: _, reason: _ } => false
  }
}

fn superseded_dropin_observed(r: SupersededDropinResult) -> Bool {
  match r {
    SupersededDropinAbsent { path: _ } => true
    SupersededDropinRemoved { path: _ } => true
    SupersededDropinPresentObserved { path: _ } => true
    SupersededDropinRefused { path: _, reason: _ } => false
  }
}

fn superseded_dropin_removed(r: SupersededDropinResult) -> Bool {
  match r {
    SupersededDropinRemoved { path: _ } => true
    SupersededDropinAbsent { path: _ } => false
    SupersededDropinPresentObserved { path: _ } => false
    SupersededDropinRefused { path: _, reason: _ } => false
  }
}

fn superseded_dropin_line(r: SupersededDropinResult) -> String {
  match r {
    SupersededDropinAbsent { path: p } => join(["retired-dropin path=", p, " absent"], "")
    SupersededDropinRemoved { path: p } => join(["retired-dropin path=", p, " removed-and-read-back"], "")
    SupersededDropinPresentObserved { path: p } => join(["retired-dropin path=", p, " PRESENT (observe-only)"], "")
    SupersededDropinRefused { path: p, reason: r } => join(["retired-dropin path=", p, " REFUSED ", r], "")
  }
}

fn runner_host_slot_role_files(host: HostIdentity) -> List<FleetHostFileDesired> {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployFound { deploy: d } =>
      list_flat_map(
        filter(deploy_slot_identities, s => (s.host as String) == (host as String)),
        s => match runner_host_slot_role_file(deploy: d, slot: s) { Present { value: f } => [f] Absent => [] },
      )
    _ => []
  }
}

fn runner_host_slot_role_withheld_files(host: HostIdentity) -> List<RunnerHostFileWithheld> {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployFound { deploy: d } =>
      list_flat_map(
        filter(deploy_slot_identities, s => (s.host as String) == (host as String)),
        s => runner_host_slot_role_withheld(deploy: d, slot: s),
      )
    _ => []
  }
}

// THE SUDOERS DROP-IN IS THE RENDERED ARTIFACT'S BYTES, FROM THE ONE PRODUCER OF THEM. The content is
// gunbc.runner.runner_host_grants runner_host_sudoers_body -- the same fold
// tier_o_artifact_emit consumes, that decides, per host, between runner_host_sudoers_content and the refused-width variant, and the
// one the drift watch compares the committed file with -- so what lands on the host is what is
// committed, never a second rendering. It is installed by the ADMINISTRATOR, which holds its own
// root through the bootstrap edge and so does not need the grants this file confers (the grantee
// cannot install its own grant). Only the rendered lines are written: 0440 root-owned, validated by
// visudo on the staging path before the rename, and read back byte-for-byte by the converge.
// A host whose body cannot be rendered is WITHHELD with the producer's own cause, not skipped.
type RunnerHostSudoersDesired
  = SudoersFileDesired { file: FleetHostFileDesired }
  | SudoersFileWithheld { withheld: RunnerHostFileWithheld }

fn runner_host_sudoers_desired(host: HostIdentity) -> RunnerHostSudoersDesired {
  match runner_host_sudoers_body(host: host, artifact_path: artifact_path(a: RunnerHostSudoersArtifact { host: host })) {
    RunnerHostSudoersBodyProduced { content: c } =>
      SudoersFileDesired {
        file: FleetHostFileDesired {
          subject: "runner-host-sudoers" as NonEmptyStr,
          path: runner_host_sudoers_install_path as FilePath,
          content: c,
          mode: RemoteFileModeOwnerGroupRead,
          validation: VisudoCheck,
        },
      }
    RunnerHostSudoersBodyRefused { reason: r } =>
      SudoersFileWithheld {
        withheld: RunnerHostFileWithheld {
          subject: "runner-host-sudoers" as NonEmptyStr,
          cause: concat("runner_host_file_converge: the rendered sudoers body is refused, so nothing is installed: ", r) as NonEmptyStr,
        },
      }
  }
}

fn runner_host_files_with_optional_depriv(
  fragment: String,
  prefix: NeedrestartUnitNamePrefix,
  depriv: String?,
) -> List<FleetHostFileDesired> {
  let tail = runner_host_teardown_and_needrestart(prefix: prefix)
  match depriv {
    Absent => tail
    Present { value: text } =>
      concat(
        [runner_host_fragment_file(fragment: fragment), runner_host_depriv_file(depriv: text)],
        tail,
      )
  }
}

// A REFUSED WIDTH IS NOT AN UNMODELED HOST, AND CARRYING ITS CAUSE IS THE WHOLE POINT.
//
// `runner_host_deploy_for` answers three ways and this fold reads all three. srv2 IS modeled --
// address, principals and app are all declared -- and what refuses is its admitted runner width, so
// the refused arm and the unmodeled arm answer different questions: a reader told "no runner deploy
// row" would go looking for a missing declaration that is present. The width refusal's own cause
// travels into the desired-population refusal unedited, rather than being restated here.
//
// THIS BLOCK SITS ON THE DECLARATION BECAUSE DESIGN SECTION 4c ADMITS NOTHING ELSE. It was first
// written inside the match arm it describes, which the parse phase refuses -- "source annotation
// sits inside a declaration body" -- and that refusal is the same one gunbc#8976 hit.
// THE CPU DROP-IN JOINS EVERY ADMITTED POPULATION, uid read or not; a refused population stays refused.
fn runner_host_file_desired_population_from_uid_reading(
  host: HostIdentity,
  reading: RunnerJobUserUidReading,
  receipt: RunnerUserSessionReceiptInput,
) -> RunnerHostFileDesiredPopulation {
  match runner_host_unit_files_desired(host: host, reading: reading, receipt: receipt) {
    RunnerHostFilesDesiredRefused { cause: c } => RunnerHostFilesDesiredRefused { cause: c }
    RunnerHostFilesDesired { files: fs, withheld: ws } =>
      match runner_slot_cpu_desired(host: host) {
        SlotCpuRefused { cause: c } => RunnerHostFilesDesiredRefused { cause: c }
        SlotCpuDesired { per_slot: _, file: f } =>
          match runner_host_sudoers_desired(host: host) {
            SudoersFileDesired { file: sf } =>
              RunnerHostFilesDesired {
                files: concat(concat(fs, [f, sf]), runner_host_slot_role_files(host: host)),
                withheld: concat(ws, runner_host_slot_role_withheld_files(host: host)),
              }
            SudoersFileWithheld { withheld: sw } =>
              RunnerHostFilesDesired {
                files: concat(concat(fs, [f]), runner_host_slot_role_files(host: host)),
                withheld: concat(concat(ws, [sw]), runner_host_slot_role_withheld_files(host: host)),
              }
          }
      }
  }
}

// THE UNIT FRAGMENT IS DELIVERED, AND THEREFORE ITS ENVIRONMENT IS OWED, EXACTLY WHEN THE POPULATION
// CARRIES IT. Where the job user's uid could not be read the fragment is withheld, the host keeps
// whatever unit it already runs, and the slot environment is reported rather than judged.
fn runner_host_files_deliver_fragment(files: List<FleetHostFileDesired>) -> Bool {
  any(files, f => (f.path as String) == (runner_unit_system_path as String))
}

fn runner_host_unit_files_desired(
  host: HostIdentity,
  reading: RunnerJobUserUidReading,
  receipt: RunnerUserSessionReceiptInput,
) -> RunnerHostFileDesiredPopulation {
  match needrestart_unit_name_prefix(raw: runner_unit_prefix) {
    NeedrestartUnitNamePrefixRefused { cause: c } => RunnerHostFilesDesiredRefused { cause: c }
    NeedrestartUnitNamePrefixAdmitted { prefix: p } =>
      match runner_host_deploy_for(host: host) {
        RunnerHostDeployUnmodeled { host: h } =>
          RunnerHostFilesDesiredRefused {
            cause: join(["runner_host_file_converge: ", h as String, " has no runner deploy row, so there is no fragment or depriv drop-in to deliver"], "") as NonEmptyStr,
          }
        RunnerHostDeployRefused { host: h, cause: c } =>
          RunnerHostFilesDesiredRefused {
            cause: join(["runner_host_file_converge: ", h as String, " has no runner deploy row because ", c, ", so there is no fragment or depriv drop-in to deliver"], "") as NonEmptyStr,
          }
        RunnerHostDeployFound { deploy: d } =>
          match gunbc_runner_unit_fragment_from_deploy(deploy: d, host: host, receipt: receipt) {
            RunnerUnitTextRefused { reason: r } => RunnerHostFilesDesiredRefused { cause: r }
            RunnerUnitText { text: fragment } =>
              match gunbc_runner_unit_depriv_dropin_text_from_reading(deploy: d, host: host, reading: reading) {
                RunnerUnitTextRefused { reason: r } =>
                  RunnerHostFilesDesired {
                    files: runner_host_files_with_optional_depriv(
                      fragment: fragment,
                      prefix: p,
                      depriv: none,
                    ),
                    withheld: [
                      RunnerHostFileWithheld {
                        subject: "runner-depriv-dropin" as NonEmptyStr,
                        cause: r,
                      },
                      RunnerHostFileWithheld {
                        subject: "runner-unit-fragment" as NonEmptyStr,
                        cause: "runner_host_file_converge: fragment waits until depriv can be authored; writing the unit file without that drop-in is only correct if an unread depriv.conf happens to exist" as NonEmptyStr,
                      },
                    ],
                  }
                RunnerUnitText { text: depriv } =>
                  RunnerHostFilesDesired {
                    files: runner_host_files_with_optional_depriv(
                      fragment: fragment,
                      prefix: p,
                      depriv: Present { value: depriv },
                    ),
                    withheld: [],
                  }
              }
          }
      }
  }
}

// ── The subject host ─────────────────────────────────────────────────────────────────────────────

// A FLEET HOST WITH DECLARED FILE ROWS: the host and the SSH target its administrator is reached at. The
// file core -- the privilege probe, the plan, the write and the mode readback -- reads nothing else, so it
// takes this subject and serves any fleet host whose rows are declared, runner or not. Its first
// non-runner consumer is a declared frontier: the BMC export host's reader rows, which has no runner slot
// (the second change of the boot medium reader route, work item adhoc-0abea207-7ec).
type FleetHostFileSubject {
  host: HostIdentity
  target: SshTarget
}

// A RUNNER HOST IS A FLEET HOST WITH SLOT ROWS: the units its slot phases (caps, actuations, retirement)
// act on, beside the host and target the file core reads.
type RunnerHostFileSubject {
  host: HostIdentity
  target: SshTarget
  desired_units: List<NonEmptyStr>
  retired_units: List<NonEmptyStr>
  fabric_units: List<NonEmptyStr>
}

fn fleet_subject_of(s: RunnerHostFileSubject) -> FleetHostFileSubject {
  FleetHostFileSubject { host: s.host, target: s.target }
}

type RunnerHostFileSubjectAdmission
  = RunnerHostFileSubjectAdmitted { subject: RunnerHostFileSubject }
  | RunnerHostFileSubjectRefused { cause: String }

// A host with no runner deploy row has no slots to protect and no declared administrator, and a host
// whose deploy row names no desired slot has no unit the teardown could be verified on; both refuse
// rather than converging files nothing would consume.
fn runner_host_file_subject(host: HostIdentity) -> RunnerHostFileSubjectAdmission {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployUnmodeled { host: h } =>
      RunnerHostFileSubjectRefused {
        cause: join(["runner_host_file_converge: ", h as String, " has no runner deploy row, so it is not a runner host"], ""),
      }
    RunnerHostDeployRefused { host: h, cause: c } =>
      RunnerHostFileSubjectRefused {
        cause: join(["runner_host_file_converge: ", h as String, " is refused as a runner host (", c, ")"], ""),
      }
    RunnerHostDeployFound { deploy: d } =>
      if !bootstrap_principal_is_not_the_grantee(bootstrap: executor_bootstrap_principal, deploy: d) {
        RunnerHostFileSubjectRefused {
          cause: join(["runner_host_file_converge: the administrator principal ", executor_bootstrap_principal.login as String, " is the job user on ", host as String, ", so the account that writes root-evaluated files would be the one CI jobs run as"], ""),
        }
      } else {
        let units = map(desired_runner_slot_members(deploy: d), m => runner_unit_name_of_registration(registration_name: m.instance_name))
        if length(units) == 0 {
          RunnerHostFileSubjectRefused {
            cause: join(["runner_host_file_converge: ", host as String, " has no desired runner slot, so no unit exists to verify the teardown on"], ""),
          }
        } else {
          runner_host_file_subject_over_obligation(
            host: host,
            units: units,
            obligation: required_retirees_for_host(host: host),
          )
        }
      }
  }
}

// A HOST WHOSE RETIREMENT OBLIGATION IS NOT DERIVABLE GETS NO SUBJECT, because retired_units is
// what this module tells the host to tear down. `required_retirees_for_host` answers
// `RetireesUnresolved` when the host's committed width does not resolve, and reading that as an
// empty retiree list would converge the host's files against "nothing is retiring" -- the silence
// this change removes everywhere else, surviving in the one module that decides teardown. The
// refusal arm already exists here, so the obligation joins the other two conditions this
// constructor refuses on.
// WHO WE REACH A RUNNER HOST AS, in one place. The endpoint comes from the fleet reach authority and
// the principal is the declared administrator; neither depends on the deploy row, so a converge that
// resolves its subject some other way -- gunbc.fleet.host_credential_custody_converge resolves custody
// from the host SPEC, because the App key does not depend on slot width -- consumes this rather than
// spelling the pair again (DESIGN §3).
fn administrator_ssh_target(host: HostIdentity) -> SshTargetResolution {
  fleet_ssh_target_at_standard_port(endpoint: fleet_probe_endpoint_for(host: host as String), principal: executor_bootstrap_principal.login)
}

fn runner_host_file_subject_over_obligation(
  host: HostIdentity,
  units: List<NonEmptyStr>,
  obligation: RequiredRetirees,
) -> RunnerHostFileSubjectAdmission {
  match obligation {
    RetireesUnresolved { host: uh, cause: c } =>
      RunnerHostFileSubjectRefused {
        cause: join([
          "runner_host_file_converge: the retirement obligation for ", uh as String,
          " is not derivable, so the set of units this host would be told to tear down cannot be stated: ",
          c,
        ], ""),
      }
    RetireesKnown { units: retired } =>
      match administrator_ssh_target(host: host) {
        SshTargetRefused { endpoint: e, refusal: why } =>
          RunnerHostFileSubjectRefused { cause: join(["runner_host_file_converge: ", ssh_target_refusal_text(endpoint: e, refusal: why)], "") }
        SshTargetResolved { target: target } =>
          RunnerHostFileSubjectAdmitted {
            subject: RunnerHostFileSubject {
              host: host,
              target: target,
              desired_units: units,
              retired_units: retired,
              fabric_units: runner_host_fabric_member_units(host: host),
            },
          }
      }
  }
}

// THE SLOTS THIS HOST LENDS TO FABRIC EXECUTION ARE NOT RUNNER SLOTS (gunbc.runner.runner_slot_allocation
// fabric_execution_slot_identities: srv1's microvm shakedown slot 13, srv3/srv4 slots 6 and 7). Their
// actions-runner@ unit is not desired, so a masked or absent one is the declared state and a loaded
// one is a runner occupying a slot the model gave to fabric -- neither is "a desired slot masked by
// mistake", which is how observe run 38662663858 misread srv1-13.
fn runner_host_fabric_member_units(host: HostIdentity) -> List<NonEmptyStr> {
  fabric_execution_slot_identities()
    |> filter(id => (id.host as String) == (host as String))
    |> map(id => runner_slot_unit_name(slot: id))
}

// ── File observation and plan (pure) ─────────────────────────────────────────────────────────────

type FleetHostFileStanding
  = HostFileIdentical
  | HostFileDiffers
  | HostFileAbsent
  | HostFileUnobservable { reason: String }

// THE PROBE READS METADATA; IT DOES NOT ANSWER PRESENCE. This was `test -e`, whose exit 1 was read
// here as HostFileAbsent -- and GNU `test -e` is stat(path) == 0, so ENOENT, EACCES on an ancestor
// directory, ELOOP, ENOTDIR and EIO all answer 1 with an empty stderr. "The file is not there" and
// "I could not look" arrived as one value, and they license opposite actions: the absent arm walks
// into the write-admission and comparison path for a file this module exists to keep root-owned and
// non-injectable. The read has two honest outcomes and absence is not one of them.
//
// WHAT THE READ ESTABLISHES IS THAT THE PATH'S METADATA WAS REPORTED, AND NOTHING ABOUT ITS KIND
// (review 80352). The probe is `extdeps.tools.stat` `stat_default_report_command` because a `-c %F`
// format cannot cross the fleet SSH edge, and the default report is human text: carrying any of it as
// a "file type" would give one field two meanings. No consumer here needs the kind -- the comparison
// and root-only reads that follow decide what the path is -- so the arm carries no payload.
type FleetHostFileMetadataReading
  = HostFileMetadataReported
  | HostFileMetadataUnread { cause: String }

// A COMPLETED READ THAT PRINTED NOTHING IS NOT A REPORT. Exit success is a fact about the CALL, never
// about whether the output carrying the answer arrived, so an empty report is unread -- the same
// separation gunbc.fabric.fabric_cell_acquire draws over this operation.
fn classify_host_file_metadata(exit_code: Int, stdout: String, stderr: String) -> FleetHostFileMetadataReading {
  if exit_code == 0 {
    let w = trim(s: stdout)
    if w == "" {
      HostFileMetadataUnread { cause: "the metadata read exited successfully and printed no report, so the path is unanswered" }
    } else {
      HostFileMetadataReported
    }
  } else {
    HostFileMetadataUnread { cause: join(["stat could not read the path's metadata; exit=", to_string(exit_code), " ", trim(s: stderr)], "") }
  }
}

// THE THREE OUTCOMES THE PROBE OWES, WITH ABSENCE ESTABLISHED BY THE PARENT AND NEVER BY THE PROBE'S
// SILENCE. The read decides presence; when it failed, what the containing directory already said
// about this entry decides whether nothing is there or nobody could look. The parent standing is
// gunbc.live_deploy.member_observe `entry_presence`, the landed authority for that rule over a
// transport, consumed rather than restated (DESIGN section 3).
type FleetHostFilePathStanding
  = HostFilePathPresent
  | HostFilePathAbsent
  | HostFilePathUnreadable { cause: String }

fn classify_host_file_path(reading: FleetHostFileMetadataReading, parent: EntryPresence) -> FleetHostFilePathStanding {
  match reading {
    HostFileMetadataReported => HostFilePathPresent
    HostFileMetadataUnread { cause: c } =>
      match parent {
        EntryAbsent => HostFilePathAbsent
        EntryPresent =>
          HostFilePathUnreadable { cause: join(["the containing directory holds this entry and ", c], "") }
        EntryPresenceIndeterminate { cause: pc } =>
          HostFilePathUnreadable { cause: join([c, "; and the containing directory could not establish absence: ", pc], "") }
      }
  }
}

// THE SETTLED ARM, AT THE STANDING'S OWN GRAIN. A path that was read continues into the byte
// comparison and is not settled here, so this answers `none` for it; absence and unreadability are
// settled, and they land on DIFFERENT standings -- which is the whole repair, because `test -e`
// sent both to HostFileAbsent and HostFileAbsent plans a write.
fn fleet_host_file_settled_standing(st: FleetHostFilePathStanding) -> FleetHostFileStanding? {
  match st {
    HostFilePathPresent => none
    HostFilePathAbsent => Present { value: HostFileAbsent }
    HostFilePathUnreadable { cause: c } => Present { value: HostFileUnobservable { reason: c } }
  }
}

// THE PROBE MUST CROSS THE EDGE IT RUNS OVER. It was `stat -c %F`, and `%` is outside the fleet SSH
// portability alphabet, so every file leg and every residue leg reported "NOT attempted" on every
// host (observe runs 38350252200, 38662663858, 38662666227, 38662668957) while a witness pinned the
// refused words as correct. The default report needs no format word; only the exit status and whether
// any report was printed are read, and the reading carries no kind (FleetHostFileMetadataReading).
fn runner_host_file_metadata_probe_argv(path: String) -> List<String> {
  argv_words(command: stat_default_report_command(path: path))
}

// WHO CAN CHANGE A FILE IS PART OF WHAT THE FILE IS, when root evaluates it. A byte-exact needrestart
// snippet that the CI user owns, or that sits in a directory the CI user can write, is a root-code
// injection point that merely happens to hold the right bytes today. So every path the file depends on
// -- the file and each ancestor directory up to the write scope -- must be owned by root and writable by
// no group and no other user.
type FleetHostPathMetadata
  = PathsRootOnly
  | PathsNotRootOnly { paths: List<String>, detail: String }
  | PathsUnobservable { reason: String }
  | PathsNotApplicable

// The directories a file's safety rests on: every ancestor from the write scope's root down to the
// file's own directory. Each is a prefix of the path ending just before one of its separators.
fn fleet_host_path_ancestors(path: String) -> List<String> {
  path_ancestors_within_scope(scope: fleet_host_file_scope, path: path)
}

// THE SAME RULE OVER ANY WRITE SCOPE: a custody row on a different medium roots its ancestors at its
// own scope (gunbc.fleet.host_credential_custody_converge custody_medium_scope), not at /etc.
fn path_ancestors_within_scope(scope: FileTreeScope, path: String) -> List<String> {
  filter(
    path_ancestor_prefixes(path: path),
    a => a == (scope.root_path as String)
      || starts_with(s: a, prefix: concat(scope.root_path as String, "/")),
  )
}

// The predicate is evaluated FAR-SIDE by find, which prints exactly the named paths that are of the
// given type, owned by root:root, and carry neither the group- nor the other-write bit; `-maxdepth 0`
// keeps it to the named paths themselves. What comes back is therefore the SAFE set, and anything
// requested and not printed failed at least one clause -- including not existing, and a symlink where a
// file or directory was expected, since find does not follow links here.
fn runner_host_root_only_find_argv(paths: List<String>, kind: String) -> List<String> {
  concat(["find"], concat(paths, ["-maxdepth", "0", "-type", kind, "-user", "root", "-group", "root", "-not", "-perm", "/022"]))
}

// A FILE IS ROOT-ONLY AT ITS DESIRED MODE, NOT AT "ANY MODE NOBODY ELSE CAN WRITE". Same far-side find, same
// printed-set classification (classify_root_only_paths), but the permission clause is the EXACT mode, spelled
// by typed_remote_file_write's own remote_file_mode_octal -- the spelling the chmod leg uses, so the observation
// and the write cannot disagree about what 0440 is. An identical-bytes root-owned 0644 file is therefore not
// printed for a 0440 desire, and the action is a repair write rather than an adoption.
fn runner_host_file_mode_find_argv(path: String, mode: RemoteFileMode) -> List<String> {
  ["find", path, "-maxdepth", "0", "-type", "f", "-user", "root", "-group", "root", "-perm", remote_file_mode_octal(mode: mode)]
}

// A FIND THAT DID NOT SUCCEED OBSERVED NOTHING, FOR EVERY CALLER. The transport's "converged" means a result
// came back, not that the command succeeded, and this classifier used to decide from stdout alone:
// exit 1 with an empty stdout ("Permission denied") read as a repairable mismatch (a write), and a failed
// run that happened to print the path read as a match (an adoption or a go-ahead to install). So an
// unsuccessful execution is unobservable BEFORE stdout is read; only a successful run may establish a
// match or a mismatch. find exits 0 whether or not the predicate printed a path, so exit 0 is the whole
// success signal.
fn classify_root_only_paths(requested: List<String>, exit_code: Int, stdout: String, stderr: String) -> FleetHostPathMetadata {
  if exit_code != 0 {
    PathsUnobservable { reason: join(["the far-side find did not succeed, so its output establishes neither a match nor a mismatch; exit=", to_string(exit_code), " ", trim(s: stderr)], "") }
  } else {
    classify_printed_root_only_paths(requested: requested, exit_code: exit_code, stdout: stdout, stderr: stderr)
  }
}

fn classify_printed_root_only_paths(requested: List<String>, exit_code: Int, stdout: String, stderr: String) -> FleetHostPathMetadata {
  let printed = filter(map(split(s: stdout, delimiter: "\n"), l => trim(s: l)), l => l != "")
  let unsafe = filter(requested, r => !any(printed, p => p == r))
  if length(unsafe) == 0 {
    PathsRootOnly
  } else {
    PathsNotRootOnly {
      paths: unsafe,
      detail: join(["not printed by find as root:root with no group/other write (missing, wrong owner, wrong mode or writable, or wrong type); find exit=", to_string(exit_code), " ", trim(s: stderr)], ""),
    }
  }
}

fn runner_host_path_metadata_wire(m: FleetHostPathMetadata) -> String {
  match m {
    PathsRootOnly => "root-only"
    PathsNotRootOnly { paths: ps, detail: d } => join(["NOT-ROOT-ONLY ", join(ps, ","), " ", d], "")
    PathsUnobservable { reason: r } => concat("UNOBSERVABLE ", r)
    PathsNotApplicable => "n/a"
  }
}

// `ancestors` is the root-only reading of the ancestor directories that EXIST; `absent_ancestors` is the
// tail of the chain that does not, established by listing each one's parent (entry_presence), never read
// from a failed find. A file whose drop-in directory was never created is therefore an observed absence
// with a declared repair, not an unobservable path.
type FleetHostFileObservation {
  content: FleetHostFileStanding
  file_metadata: FleetHostPathMetadata
  ancestors: FleetHostPathMetadata
  absent_ancestors: List<String>
}

type FleetHostFileAction
  = HostFileLeaveInPlace
  | HostFileWrite
  | HostFileActionRefused { reason: String }

// The ancestors are decided first because the converge does not own them: a writable directory above
// the file cannot be repaired by writing the file, and writing into it would publish root-evaluated
// bytes where a CI user can replace them. Unsafe FILE metadata, by contrast, IS repaired by a write --
// the staged file is created by root and renamed over the old one, replacing its owner and mode.
fn fleet_host_file_action(observation: FleetHostFileObservation) -> FleetHostFileAction {
  if length(observation.absent_ancestors) > 0 {
    fleet_host_file_action_under_absent_ancestors(observation: observation)
  } else {
    fleet_host_file_action_under_present_ancestors(observation: observation)
  }
}

// THE DIRECTORIES ARE CREATED ONLY WHERE NOTHING ELSE COULD HAVE PLACED THE FILE: the ancestors that exist
// must be root-only (the same refusal as a write into an existing tree), and the file must read absent,
// since a file cannot exist below a directory that does not. Any other content reading under an absent
// directory contradicts the presence walk and refuses.
fn fleet_host_file_action_under_absent_ancestors(observation: FleetHostFileObservation) -> FleetHostFileAction {
  match observation.ancestors {
    PathsNotRootOnly { paths: ps, detail: d } =>
      HostFileActionRefused { reason: join(["ancestor directory not root-only: ", join(ps, ","), " ", d], "") }
    PathsUnobservable { reason: r } => HostFileActionRefused { reason: concat("ancestor metadata unobservable: ", r) }
    PathsNotApplicable => HostFileActionRefused { reason: "ancestor metadata was not read" }
    PathsRootOnly =>
      match observation.content {
        HostFileAbsent => HostFileWrite
        HostFileUnobservable { reason: r } => HostFileActionRefused { reason: r }
        HostFileIdentical => HostFileActionRefused { reason: concat("the file reads present below an ancestor the listing found absent: ", join(observation.absent_ancestors, ",")) }
        HostFileDiffers => HostFileActionRefused { reason: concat("the file reads present below an ancestor the listing found absent: ", join(observation.absent_ancestors, ",")) }
      }
  }
}

fn fleet_host_file_action_under_present_ancestors(observation: FleetHostFileObservation) -> FleetHostFileAction {
  match observation.ancestors {
    PathsNotRootOnly { paths: ps, detail: d } =>
      HostFileActionRefused { reason: join(["ancestor directory not root-only: ", join(ps, ","), " ", d], "") }
    PathsUnobservable { reason: r } => HostFileActionRefused { reason: concat("ancestor metadata unobservable: ", r) }
    PathsNotApplicable => HostFileActionRefused { reason: "ancestor metadata was not read" }
    PathsRootOnly =>
      match observation.content {
        HostFileUnobservable { reason: r } => HostFileActionRefused { reason: r }
        HostFileAbsent => HostFileWrite
        HostFileDiffers =>
          match observation.file_metadata {
            PathsRootOnly => HostFileWrite
            PathsNotRootOnly { paths: _, detail: _ } => HostFileWrite
            PathsUnobservable { reason: r } => HostFileActionRefused { reason: concat("file metadata unobservable: ", r) }
            PathsNotApplicable => HostFileActionRefused { reason: "differing content but file metadata was not read" }
          }
        HostFileIdentical =>
          match observation.file_metadata {
            PathsRootOnly => HostFileLeaveInPlace
            PathsNotRootOnly { paths: _, detail: _ } => HostFileWrite
            PathsUnobservable { reason: r } => HostFileActionRefused { reason: concat("file metadata unobservable: ", r) }
            PathsNotApplicable => HostFileActionRefused { reason: "identical content but file metadata was not read" }
          }
      }
  }
}

fn runner_host_file_standing_wire(standing: FleetHostFileStanding) -> String {
  match standing {
    HostFileIdentical => "identical"
    HostFileDiffers => "differs"
    HostFileAbsent => "absent"
    HostFileUnobservable { reason: r } => concat("unobservable ", r)
  }
}

fn runner_host_file_action_wire(action: FleetHostFileAction) -> String {
  match action {
    HostFileLeaveInPlace => "leave-in-place"
    HostFileWrite => "write"
    HostFileActionRefused { reason: r } => concat("REFUSED ", r)
  }
}

type FleetHostFilePlanned {
  file: FleetHostFileDesired
  observation: FleetHostFileObservation
  action: FleetHostFileAction
}

// ── Slot population and teardown (pure) ──────────────────────────────────────────────────────────

// One slot unit as the manager reports it. Every value is carried as the manager spells it; the
// judgment below decides what each means.
type RunnerSlotUnitReading {
  unit: NonEmptyStr
  load_state: String
  need_daemon_reload: String
  kill_mode: String
  exit_type: String
  cpu_quota_per_sec: String
  environment: String
}

// WHAT A SLOT MUST CARRY BEYOND ITS TEARDOWN: the derived CPU ceiling, always; CARGO_BUILD_JOBS at
// the same per-slot figure where this run delivers the unit fragment that renders it; and no
// MAKEFLAGS whenever the fragment is delivered OR the jobserver residue is absent -- a host whose
// daemon is gone (retired here or by hand) must not hand cargo an auth clause for a FIFO nobody
// serves, whoever wrote its unit.
type RunnerSlotExpectation {
  intent: RunnerUnitLifecycleIntent
  cpu_quota_identity: String
  compile_jobs: HardwareThreadCount?
  forbid_makeflags: Bool
  role_environments: List<SlotRoleEnvironment>
}

// A SLOT WHOSE ROLE DROP-IN REPLACES THE TEMPLATE'S JOB USER IS JUDGED ON THE ENVIRONMENT IT LOADED, not on
// the file that was written: the manager's merged Environment must assign the role's job user and, where
// the role runs no containers, carry no DOCKER_HOST but an empty one. srv1-02 was read 'effective' in L2
// run 40950610061 while depriv.conf's ghrunner won over its role (gunbc.runner.runner_unit_file
// runner_unit_slot_role_dropin_file_name). Only slots with a role drop-in carry a row: a CI slot's job user
// is the template's, which a host may not have opted into, so asserting it here would be a new fleet-wide
// requirement this change does not make.
type SlotRoleEnvironment {
  unit: NonEmptyStr
  job_user: NonEmptyStr
  docker_host_cleared: Bool
}

fn runner_host_role_environments(host: HostIdentity) -> List<SlotRoleEnvironment> {
  match runner_host_deploy_for(host: host) {
    RunnerHostDeployFound { deploy: d } =>
      map(filter(deploy_slot_identities, s => (s.host as String) == (host as String)), s => {
        let role = runner_slot_job_role(slot: s)
        SlotRoleEnvironment {
          unit: runner_unit_name_of_registration(registration_name: runner_slot_instance_name(slot: s) as NonEmptyStr),
          job_user: runner_slot_job_user(role: role, ci_job_user: d.job_user),
          docker_host_cleared: !runner_slot_job_role_runs_containers(role: role),
        }
      })
    _ => []
  }
}

fn runner_slot_expectation_with_roles(expect: RunnerSlotExpectation, host: HostIdentity) -> RunnerSlotExpectation {
  RunnerSlotExpectation {
    intent: expect.intent,
    cpu_quota_identity: expect.cpu_quota_identity,
    compile_jobs: expect.compile_jobs,
    forbid_makeflags: expect.forbid_makeflags,
    role_environments: runner_host_role_environments(host: host),
  }
}

fn slot_role_environment_problem(environment: String, unit: NonEmptyStr, expect: RunnerSlotExpectation) -> String? {
  match first(filter(expect.role_environments, r => (r.unit as String) == (unit as String))) {
    Absent => none
    Present { value: r } =>
      if !slot_environment_assigns(environment: environment, name: runner_job_user_env_name, value: r.job_user as String) {
        Present { value: join(["Environment does not assign ", runner_job_user_env_name, "=", r.job_user as String, " (the slot's role); a later-sorting drop-in overrides it"], "") }
      } else if r.docker_host_cleared && slot_environment_names(environment: environment, name: docker_host_env_var) && !slot_environment_assigns(environment: environment, name: docker_host_env_var, value: "") {
        Present { value: join(["Environment carries a ", docker_host_env_var, " the slot's role clears"], "") }
      } else { none }
  }
}

fn runner_slot_expectation(per_slot: HardwareThreadCount, fragment_delivered: Bool, residue_absent: Bool) -> RunnerSlotExpectation {
  RunnerSlotExpectation {
    intent: gunbc_runner_lifecycle_intent,
    cpu_quota_identity: systemd_cpu_quota_per_sec_magnitude_identity(usec: systemd_cpu_quota_per_sec_of_threads(threads: per_slot)),
    compile_jobs: if fragment_delivered { Present { value: per_slot } } else { none },
    forbid_makeflags: fragment_delivered || residue_absent,
    role_environments: [],
  }
}

// systemctl prints Environment= as space-separated NAME=value words; a quoted LABELS_JSON word may
// contain spaces, so a variable is matched as a word START, never by splitting on '='.
fn slot_environment_names(environment: String, name: String) -> Bool {
  starts_with(s: environment, prefix: concat(name, "=")) || string_contains(s: environment, pattern: concat(" ", concat(name, "=")))
}

fn slot_environment_assigns(environment: String, name: String, value: String) -> Bool {
  let w = join([name, "=", value], "")
  environment == w || starts_with(s: environment, prefix: concat(w, " ")) || ends_with(s: environment, suffix: concat(" ", w)) || string_contains(s: environment, pattern: join([" ", w, " "], ""))
}

// ONE JUDGMENT OVER A LOADED, RELOADED, TEARDOWN-EFFECTIVE SLOT. An undecodable quota is not a
// match; a missing MAKEFLAGS is required, not merely tolerated, where the fragment was delivered.
fn classify_slot_allocation(reading: RunnerSlotUnitReading, expect: RunnerSlotExpectation) -> RunnerSlotUnitStanding {
  let observed = systemd_cpu_quota_per_sec_identity(q: parse_systemd_cpu_quota_per_sec_show(raw: trim(s: reading.cpu_quota_per_sec)))
  let cpu_ok = match observed { Absent => false Present { value: q } => q == expect.cpu_quota_identity }
  if !cpu_ok {
    SlotAllocationNotEffective { detail: join(["CPUQuotaPerSecUSec=", trim(s: reading.cpu_quota_per_sec), " want=", expect.cpu_quota_identity, "us"], "") }
  } else {
    let env = trim(s: reading.environment)
    match slot_role_environment_problem(environment: env, unit: reading.unit, expect: expect) {
      Present { value: why } => SlotAllocationNotEffective { detail: why }
      Absent => classify_slot_environment(env: env, expect: expect)
    }
  }
}

fn classify_slot_environment(env: String, expect: RunnerSlotExpectation) -> RunnerSlotUnitStanding {
  if expect.forbid_makeflags && slot_environment_names(environment: env, name: make_makeflags_env_name) {
    SlotAllocationNotEffective { detail: "Environment still carries MAKEFLAGS" }
  } else {
    match expect.compile_jobs {
      Absent => SlotTeardownEffective
      Present { value: jobs } =>
        if !slot_environment_assigns(environment: env, name: cargo_environment_variable_name(variable: CargoBuildJobsEnv) as String, value: to_string(hardware_thread_count_value(t: jobs))) {
          SlotAllocationNotEffective { detail: join(["Environment does not assign CARGO_BUILD_JOBS=", to_string(hardware_thread_count_value(t: jobs))], "") }
        } else {
          SlotTeardownEffective
        }
    }
  }
}

type RunnerSlotUnitStanding
  = SlotTeardownEffective
  | SlotTeardownNotEffective { kill_mode: String, exit_type: String }
  | SlotAllocationNotEffective { detail: String }
  | SlotFabricMemberNotARunner { load_state: String }
  | SlotFabricMemberRunsARunner
  | SlotReloadPending
  | SlotUnitNotLoaded { load_state: String }
  | SlotRetiredAsDeclared
  | SlotRetirementIncomplete { cause: String }
  | SlotUnitUnread

// ORDER MATTERS AND IS THE POINT. A unit the manager has not loaded still gets a show block, carrying
// the manager's DEFAULTS -- and the default KillMode is control-group, so reading KillMode first would
// certify a slot that does not exist. A loaded unit whose configuration changed on disk reports the
// OLD values until a reload, so NeedDaemonReload is read before the pair it would otherwise vouch for.
//
// THE POPULATION IS JUDGED AGAINST THE SLOTS THAT SHOULD EXIST, NOT AGAINST THE GLOB. A masked unit is
// discharged only by the retirement authority's OWN verdict on it: `retirements` carries
// gunbc.runner.runner_slot_retirement runner_retirement_standing for each unit the width transition obliges
// retired, and only RetirementComplete -- mask held, service not running, workload cgroup empty or
// absent -- reads SlotRetiredAsDeclared. Masked is the inhibit, not the drain: a retiree masked mid-job
// still holds its worker, so a pending or unobserved retirement refuses as SlotRetirementIncomplete.
// A masked unit with no retirement standing -- one the authority does NOT retire -- stays not-loaded,
// because ignoring masked units would hide a slot masked by mistake; a retiree still loaded is still
// judged on its teardown, because it can still run a job.
fn classify_runner_slot_unit_against_retirement(reading: RunnerSlotUnitReading, expect: RunnerSlotExpectation, retirements: List<RunnerRetirementStanding>) -> RunnerSlotUnitStanding {
  let intent = expect.intent
  let own = filter(retirements, st => retirement_unit(s: st) == (reading.unit as String))
  if trim(s: reading.load_state) == (systemd_unit_load_state_masked_wire as String) && length(own) > 0 {
    fold(own, init: SlotRetiredAsDeclared, f: (acc, st) => match st {
      RetirementComplete { unit: _ } => acc
      RetirementPendingDrain { unit: _, cause: c } => SlotRetirementIncomplete { cause: c }
      RetirementUnobserved { unit: _, cause: c } => SlotRetirementIncomplete { cause: c }
    })
  } else if trim(s: reading.load_state) != "loaded" {
    SlotUnitNotLoaded { load_state: trim(s: reading.load_state) }
  } else if trim(s: reading.need_daemon_reload) != "no" {
    SlotReloadPending
  } else if trim(s: reading.kill_mode) == systemd_kill_mode_wire(mode: intent.kill_mode)
      && trim(s: reading.exit_type) == systemd_exit_type_wire(exit_type: intent.exit_type) {
    classify_slot_allocation(reading: reading, expect: expect)
  } else {
    SlotTeardownNotEffective { kill_mode: trim(s: reading.kill_mode), exit_type: trim(s: reading.exit_type) }
  }
}

fn runner_slot_unit_standing_wire(standing: RunnerSlotUnitStanding) -> String {
  match standing {
    SlotTeardownEffective => "effective"
    SlotTeardownNotEffective { kill_mode: k, exit_type: e } => join(["NOT-EFFECTIVE KillMode=", k, " ExitType=", e], "")
    SlotAllocationNotEffective { detail: d } => concat("ALLOCATION-NOT-EFFECTIVE ", d)
    SlotFabricMemberNotARunner { load_state: l } => concat("fabric-member-not-a-runner LoadState=", l)
    SlotFabricMemberRunsARunner => "FABRIC-MEMBER-RUNS-A-RUNNER LoadState=loaded"
    SlotReloadPending => "RELOAD-PENDING"
    SlotUnitNotLoaded { load_state: l } => concat("NOT-LOADED LoadState=", l)
    SlotRetiredAsDeclared => "retired-as-declared LoadState=masked"
    SlotRetirementIncomplete { cause: c } => concat("MASKED-RETIREMENT-INCOMPLETE ", c)
    SlotUnitUnread => "UNREAD"
  }
}

// THE RELOAD STATE IS ITS OWN FACT, never a value of the lifecycle standing. A loaded unit that owes a
// reload is still a fabric member running a runner, or a teardown-effective slot, and a later
// classification of the lifecycle must not overwrite it. Derived once, from the raw show observation.
//
// WHETHER A TEMPLATE RELOAD WOULD REACH A LIVE CGROUP IS A SECOND, INDEPENDENT FACT (`reach`): it holds
// for every loaded unit whether or not it owes a reload. A unit is Inert when its OWN show block says
// LoadState Masked or NotFound only, ActiveState=inactive and no ControlGroup -- a reload applies limits to a running
// cgroup, and this unit has none. Derived once here, from that block alone (never from fabric or
// retiree membership, and any missing key reads ReachesLiveCgroup); every cap-phase arm that asks
// about exposure to the reload reads this field. Arms asking something else (retirement completion,
// idleness, live-cap readability) do not.
type SlotReloadStatus = SlotReloadNotPending | SlotReloadOwed | SlotReloadUnobserved
type SlotReloadReach = ReachesLiveCgroup | ReloadInert

type RunnerSlotUnitResult {
  unit: NonEmptyStr
  standing: RunnerSlotUnitStanding
  reload: SlotReloadStatus
  reach: SlotReloadReach
}

fn slot_reload_status_for(unit: NonEmptyStr, show_stdout: String) -> SlotReloadStatus {
  match parse_runner_slot_reading_for(unit: unit, show_stdout: show_stdout) {
    Absent => SlotReloadUnobserved
    Present { value: rd } =>
      if trim(s: rd.need_daemon_reload) == "no" {
        SlotReloadNotPending
      } else {
        SlotReloadOwed
      }
  }
}

fn slot_reload_reach_for(unit: NonEmptyStr, show_stdout: String) -> SlotReloadReach {
  if slot_unit_inert_in_show(unit: unit, show_stdout: show_stdout) { ReloadInert } else { ReachesLiveCgroup }
}

// A LoadState has no unit file a reload could load ONLY for Masked and NotFound. UnitLoaded has one;
// BadSetting and Error leave a file a reload re-reads and may load, so they fail closed; a word the parser
// does not recognize answers nothing and reads like a missing key (not inert).
fn slot_load_state_has_no_unit_file(load: String) -> Bool {
  match parse_systemd_unit_load_state(raw: load) {
    Absent => false
    Present { value: st } => match st {
      UnitLoadMasked => true
      UnitLoadNotFound => true
      UnitLoaded => false
      UnitLoadBadSetting => false
      UnitLoadError => false
    }
  }
}

// NO UNIT FILE (LoadState Masked or NotFound only), STOPPED, NO CGROUP -- all three read
// from the unit's own block; any key missing is not inert. Stopped is ActiveState inactive OR failed: a
// unit whose last run failed has no process either, and with a blank ControlGroup a reload reaches nothing.
// Inactive alone read srv1-02 (masked after crash-looping, ActiveState=failed, no cgroup) as reaching a
// live cgroup, which withheld the cap phase, which barred the reload its own role drop-in needed (L2 run
// 41154097819, 2026-10-31). Activating, deactivating and reloading are not stopped, whatever the cgroup.
fn slot_active_state_is_stopped(active: String) -> Bool {
  match parse_systemd_unit_active_state(raw: active) {
    Absent => false
    Present { value: st } => match st {
      Inactive => true
      Failed => true
      Active => false
      Activating => false
      Deactivating => false
      Reloading => false
    }
  }
}

fn slot_unit_inert_in_show(unit: NonEmptyStr, show_stdout: String) -> Bool {
  fold(split(s: show_stdout, delimiter: "\n\n"), init: false, f: (acc, b) => {
    let lines = map(split(s: b, delimiter: "\n"), l => trim(s: l))
    match show_block_value(lines: lines, property: IdProperty) {
      Absent => acc
      Present { value: id } =>
        if trim(s: id) != (unit as String) {
          acc
        } else {
          match show_block_value(lines: lines, property: LoadState) {
            Absent => false
            Present { value: load } =>
              match show_block_value(lines: lines, property: ActiveState) {
                Absent => false
                Present { value: act } =>
                  match show_block_value(lines: lines, property: ControlGroup) {
                    Absent => false
                    Present { value: cg } => slot_load_state_has_no_unit_file(load: trim(s: load)) && slot_active_state_is_stopped(active: trim(s: act)) && trim(s: cg) == ""
                  }
              }
          }
        }
    }
  })
}

type RunnerSlotPopulation
  = SlotPopulationObserved { units: List<RunnerSlotUnitResult> }
  | SlotPopulationUnobservable { reason: String }

// The last three are the retirement authority's readings (gunbc.runner.runner_slot_retirement
// retirement_observation_from_readings), carried by the SAME show so a retiree costs no round trip.
data runner_slot_show_properties: List<SystemdUnitProperty> = [IdProperty, LoadState, NeedDaemonReload, KillModeProperty, ExitTypeProperty, UnitFileState, ActiveState, ControlGroup, CPUQuotaPerSecUSec, EnvironmentProperty]

fn runner_unit_name_is_slot(name: String) -> Bool {
  starts_with(s: name, prefix: runner_unit_prefix) && ends_with(s: name, suffix: runner_unit_suffix)
}

// Plain list-units rows carry the unit name as the first field; every other field is presentation.
fn runner_slot_units_from_list_units(stdout: String) -> List<String> {
  filter(
    map(filter(split(s: stdout, delimiter: "\n"), l => trim(s: l) != ""), l => fold(split(s: trim(s: l), delimiter: " "), init: "", f: (acc, w) => if acc == "" { w } else { acc })),
    n => runner_unit_name_is_slot(name: n),
  )
}

// THE POPULATION IS THE UNION, DESIRED FIRST, THEN THE REQUIRED RETIREES, THEN LOADED EXTRAS. A
// desired slot the manager does not hold must be seen as NOT-LOADED rather than skipped, and a loaded
// slot outside both rosters -- a leftover incarnation, a slot added by hand -- is still a unit a
// restart can orphan from. A required retiree is a member BY DECLARATION, never by listing: absence
// from list-units is not retirement, whose completion is the retirement authority's verdict over
// inhibition, a stopped service and an empty or absent cgroup. list-units names each unit the manager
// holds once, so the loaded half needs no de-duplication of its own.
fn runner_slot_population_units(desired: List<NonEmptyStr>, retired: List<NonEmptyStr>, loaded: List<String>) -> List<NonEmptyStr> {
  let declared = concat(desired, filter(retired, r => !any(desired, d => (d as String) == (r as String))))
  concat(declared, map(filter(loaded, l => !any(declared, d => (d as String) == l)), l => l as NonEmptyStr))
}

fn show_block_value(lines: List<String>, property: SystemdUnitProperty) -> String? {
  let key = concat(systemd_unit_property_wire(property: property) as String, "=")
  fold(lines, init: none, f: (acc, l) =>
    if starts_with(s: l, prefix: key) {
      Present { value: substring(s: l, start: string_length(s: key), end: string_length(s: l)) }
    } else {
      acc
    })
}

fn parse_runner_slot_show_block(block: String) -> RunnerSlotUnitReading? {
  let lines = map(split(s: block, delimiter: "\n"), l => trim(s: l))
  match show_block_value(lines: lines, property: IdProperty) {
    Absent => none
    Present { value: id } =>
      match show_block_value(lines: lines, property: LoadState) {
        Absent => none
        Present { value: load } =>
          match show_block_value(lines: lines, property: NeedDaemonReload) {
            Absent => none
            Present { value: reload } =>
              match show_block_value(lines: lines, property: KillModeProperty) {
                Absent => none
                Present { value: kill } =>
                  match show_block_value(lines: lines, property: ExitTypeProperty) {
                    Absent => none
                    Present { value: exit } =>
                      match show_block_value(lines: lines, property: CPUQuotaPerSecUSec) {
                        Absent => none
                        Present { value: cpu } =>
                          match show_block_value(lines: lines, property: EnvironmentProperty) {
                            Absent => none
                            Present { value: env } =>
                              if id == "" { none } else {
                                Present { value: RunnerSlotUnitReading { unit: id as NonEmptyStr, load_state: load, need_daemon_reload: reload, kill_mode: kill, exit_type: exit, cpu_quota_per_sec: cpu, environment: env } }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

// Each requested unit is joined to the block that NAMES it; a unit with no block of its own is UNREAD,
// never borrowed from a neighbour's.
// A fabric member's runner unit is judged before anything else: masked or not-found is the declared
// state; loaded is a runner on a slot the model gave to fabric, and it refuses by name. A member that
// list-units named but `systemctl show` returned no block for is a failed read and stays
// SlotUnitUnread -- never mapped to the declared state.
fn classify_fabric_member_unit(reading: RunnerSlotUnitReading) -> RunnerSlotUnitStanding {
  if trim(s: reading.load_state) == "loaded" { SlotFabricMemberRunsARunner } else { SlotFabricMemberNotARunner { load_state: trim(s: reading.load_state) } }
}

fn classify_runner_slot_population_with_fabric(units: List<NonEmptyStr>, fabric: List<NonEmptyStr>, retirements: List<RunnerRetirementStanding>, show_stdout: String, expect: RunnerSlotExpectation) -> List<RunnerSlotUnitResult> {
  map(classify_runner_slot_population(units: units, retirements: retirements, show_stdout: show_stdout, expect: expect), r =>
    if any(fabric, f => (f as String) == (r.unit as String)) {
      RunnerSlotUnitResult {
        unit: r.unit,
        standing: match parse_runner_slot_reading_for(unit: r.unit, show_stdout: show_stdout) {
          Absent => SlotUnitUnread
          Present { value: rd } => classify_fabric_member_unit(reading: rd)
        },
        reload: r.reload,
        reach: r.reach,
      }
    } else { r })
}

fn parse_runner_slot_reading_for(unit: NonEmptyStr, show_stdout: String) -> RunnerSlotUnitReading? {
  fold(split(s: show_stdout, delimiter: "\n\n"), init: none, f: (acc, b) => match parse_runner_slot_show_block(block: b) {
    Present { value: r } => if (r.unit as String) == (unit as String) { Present { value: r } } else { acc }
    Absent => acc
  })
}

fn classify_runner_slot_population(units: List<NonEmptyStr>, retirements: List<RunnerRetirementStanding>, show_stdout: String, expect: RunnerSlotExpectation) -> List<RunnerSlotUnitResult> {
  let readings = flat_map(split(s: show_stdout, delimiter: "\n\n"), b => match parse_runner_slot_show_block(block: b) {
    Present { value: r } => [r]
    Absent => []
  })
  map(units, u =>
    RunnerSlotUnitResult {
      unit: u,
      standing: fold(readings, init: SlotUnitUnread, f: (acc, r) =>
        if (r.unit as String) == (u as String) { classify_runner_slot_unit_against_retirement(reading: r, expect: expect, retirements: retirements) } else { acc }),
      reload: slot_reload_status_for(unit: u, show_stdout: show_stdout),
      reach: slot_reload_reach_for(unit: u, show_stdout: show_stdout),
    })
}

fn runner_slot_population_owes_reload(population: RunnerSlotPopulation) -> Bool {
  match population {
    SlotPopulationUnobservable { reason: _ } => false
    SlotPopulationObserved { units: us } =>
      any(us, r => match r.standing {
        SlotReloadPending => true
        SlotTeardownEffective => false
        SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberNotARunner { load_state: _ } => false SlotFabricMemberRunsARunner => false
        SlotUnitNotLoaded { load_state: _ } => false
        SlotRetiredAsDeclared => false
        SlotRetirementIncomplete { cause: _ } => false
        SlotUnitUnread => false
      })
  }
}

fn runner_slot_population_effective(population: RunnerSlotPopulation) -> Bool {
  match population {
    SlotPopulationUnobservable { reason: _ } => false
    SlotPopulationObserved { units: us } =>
      any(us, r => match r.standing { SlotTeardownEffective => true SlotReloadPending => false SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberNotARunner { load_state: _ } => false SlotFabricMemberRunsARunner => false SlotUnitNotLoaded { load_state: _ } => false SlotRetiredAsDeclared => false SlotRetirementIncomplete { cause: _ } => false SlotUnitUnread => false })
        && all(us, r => match r.standing {
        SlotTeardownEffective => true
        SlotRetiredAsDeclared => true
        SlotFabricMemberNotARunner { load_state: _ } => true
        SlotRetirementIncomplete { cause: _ } => false
        SlotReloadPending => false
        SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberRunsARunner => false
        SlotUnitNotLoaded { load_state: _ } => false
        SlotUnitUnread => false
      })
  }
}

fn runner_slot_population_read_completely(population: RunnerSlotPopulation) -> Bool {
  match population {
    SlotPopulationUnobservable { reason: _ } => false
    SlotPopulationObserved { units: us } =>
      length(us) > 0 && all(us, r => match r.standing {
        SlotUnitUnread => false
        SlotTeardownEffective => true
        SlotReloadPending => true
        SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => true SlotAllocationNotEffective { detail: _ } => true SlotFabricMemberNotARunner { load_state: _ } => true SlotFabricMemberRunsARunner => true
        SlotUnitNotLoaded { load_state: _ } => true
        SlotRetiredAsDeclared => true
        SlotRetirementIncomplete { cause: _ } => true
      })
  }
}

// ── Remote legs ──────────────────────────────────────────────────────────────────────────────────

// EVERY ARGV THIS ROUTE SENDS OVER THE FLEET EDGE IS ONE OF THESE LEGS, and fleet_host_leg_argv is
// the only place one becomes words. The legs are a closed coproduct so the portability witness can
// derive the command set from the route rather than list it by hand: a new remote call has to add an
// arm here, and runner_host_leg_kind (exhaustive) plus runner_host_leg_kinds make the witness cover it.
// The typed_remote_file_write legs (stage, chmod, rename, compare, unlink) and the parent listing of
// gunbc.live_deploy.member_observe run through their own modules' builders and are covered there.
type FleetHostRemoteLeg
  = LegAdministratorPrivilegeProbe
  | LegRootOnlyFind { paths: List<String>, kind: String }
  | LegFileModeFind { path: String, mode: RemoteFileMode }
  | LegMetadataProbe { path: String }
  | LegListServiceUnits
  | LegShowSlotProperties { units: List<NonEmptyStr> }
  | LegRetireeCgroupEvents { argv: List<String> }
  | LegJobUserPasswd { job_user: NonEmptyStr }
  | LegJobUserIdentity { job_user: NonEmptyStr }
  | LegResidueLoadState { unit: NonEmptyStr }
  | LegElevated { command: List<String> }

fn fleet_host_leg_argv(leg: FleetHostRemoteLeg) -> List<String> {
  match leg {
    LegAdministratorPrivilegeProbe => elevated_argv(command: ["true"])
    LegRootOnlyFind { paths: ps, kind: k } => runner_host_root_only_find_argv(paths: ps, kind: k)
    LegFileModeFind { path: p, mode: m } => runner_host_file_mode_find_argv(path: p, mode: m)
    LegMetadataProbe { path: p } => elevated_argv(command: runner_host_file_metadata_probe_argv(path: p))
    LegListServiceUnits => systemctl_list_all_service_units_argv()
    LegShowSlotProperties { units: us } => systemctl_show_properties_argv(units: us, properties: runner_slot_show_properties)
    LegRetireeCgroupEvents { argv: a } => a
    LegJobUserPasswd { job_user: u } => argv_words(command: getent_passwd_command(key: u))
    LegJobUserIdentity { job_user: u } => argv_words(command: id_user_record_command(user: u))
    LegResidueLoadState { unit: u } => systemctl_show_load_state_argv(unit: u)
    LegElevated { command: c } => elevated_argv(command: c)
  }
}

fn runner_host_leg_kind(leg: FleetHostRemoteLeg) -> String {
  match leg {
    LegAdministratorPrivilegeProbe => "privilege-probe"
    LegRootOnlyFind { paths: _, kind: _ } => "root-only-find"
    LegFileModeFind { path: _, mode: _ } => "file-mode-find"
    LegMetadataProbe { path: _ } => "metadata-probe"
    LegListServiceUnits => "list-service-units"
    LegShowSlotProperties { units: _ } => "show-slot-properties"
    LegRetireeCgroupEvents { argv: _ } => "retiree-cgroup-events"
    LegJobUserPasswd { job_user: _ } => "job-user-passwd"
    LegJobUserIdentity { job_user: _ } => "job-user-identity"
    LegResidueLoadState { unit: _ } => "residue-load-state"
    LegElevated { command: _ } => "elevated"
  }
}

data runner_host_leg_kinds: List<String> = ["privilege-probe", "root-only-find", "file-mode-find", "metadata-probe", "list-service-units", "show-slot-properties", "retiree-cgroup-events", "job-user-passwd", "job-user-identity", "residue-load-state", "elevated"]

fn run_fleet_host_leg(subject: FleetHostFileSubject, context: FleetSshExecutionContext, leg: FleetHostRemoteLeg) -> TypedArgvExecOutcome
{
  typed_argv_exec_over_fleet_ssh(target: subject.target, context: context, argv: fleet_host_leg_argv(leg: leg))
}

// THE LEGS ONE HOST'S RUN CAN ISSUE, from that host's own subject, desired files and residue, with
// representative stand-ins only where the route builds the argv from a host answer (the retiree
// events read uses the real builder over the subject's own retirees). A witness checks each against
// the transport's portability admission.
fn runner_host_run_legs(subject: RunnerHostFileSubject, files: List<FleetHostFileDesired>, residue: RetiredHostResidue) -> List<FleetHostRemoteLeg> {
  let population = runner_slot_population_units(desired: subject.desired_units, retired: subject.retired_units, loaded: [])
  concat(
    [LegAdministratorPrivilegeProbe, LegListServiceUnits, LegShowSlotProperties { units: population }, LegResidueLoadState { unit: residue.unit }, LegElevated { command: systemctl_daemon_reload_argv() }]
      + list_flat_map(runner_host_control_shadow_paths(subject: subject), p => [LegMetadataProbe { path: p }, LegElevated { command: retired_file_removal_leg(path: p).argv }]),
    concat(
      list_flat_map(files, f => [
        LegMetadataProbe { path: f.path as String },
        LegFileModeFind { path: f.path as String, mode: f.mode },
        LegRootOnlyFind { paths: fleet_host_path_ancestors(path: f.path as String), kind: "d" },
      ] + map(fleet_host_path_ancestors(path: f.path as String), a => LegElevated { command: fleet_host_ancestor_directory_argv(path: a) })),
      concat(
        map(concat(residue.files, residue.directories), p => LegMetadataProbe { path: p }),
        concat(
          map(retire_legs_for(residue: residue, observation: ResiduePresent { unit_known: true, present: concat(residue.files, residue.directories) }), l => LegElevated { command: l.argv }),
          concat(
            match runner_host_deploy_for(host: subject.host) {
              RunnerHostDeployFound { deploy: d } => [LegJobUserPasswd { job_user: d.job_user }]
              RunnerHostDeployRefused { host: _, cause: _ } => []
              RunnerHostDeployUnmodeled { host: _ } => []
            },
            if runner_host_has_deploy_slot(host: subject.host) {
              list_flat_map(runner_host_superseded_dropin_paths(host: subject.host), p => [LegMetadataProbe { path: p }, LegElevated { command: retired_file_removal_leg(path: p).argv }]) + [
                LegJobUserPasswd { job_user: deploy_slot_job_user },
                LegElevated { command: map(executor_privileged_operation_argv(op: deploy_slot_account_operation()), w => w as String) },
              ] + list_flat_map(filter(deploy_slot_identities, d => (d.host as String) == (subject.host as String)), d => {
                let dir = runner_slot_dir_path(slot: d) as String
                [
                  LegElevated { command: deploy_slot_tree_owned_find_argv(slot_dir: dir) },
                  LegElevated { command: argv_words(command: ls_long_numeric_entries_command(paths: concat(path_ancestor_prefixes(path: dir), [dir]))) },
                  LegElevated { command: argv_words(command: ls_long_numeric_listing_command(directory: dir)) },
                ]
              }) + match runner_host_deploy_for(host: subject.host) {
                RunnerHostDeployFound { deploy: d } => [LegJobUserIdentity { job_user: d.job_user }]
                RunnerHostDeployRefused { host: _, cause: _ } => []
                RunnerHostDeployUnmodeled { host: _ } => []
              }
            } else { [] },
          ),
        ),
      ),
    ),
  )
}

fn elevated_argv(command: List<String>) -> List<String> {
  let inv = sudo_elevate(command: command)
  concat([inv.bin_path], inv.args)
}

type FleetHostPrivilegeStanding
  = AdministratorPrivilegeAvailable
  | AdministratorPrivilegeRefused { reason: String }

fn observe_fleet_host_administrator_privilege(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
) -> FleetHostPrivilegeStanding
{
  match run_fleet_host_leg(subject: subject, context: context, leg: LegAdministratorPrivilegeProbe) {
    TypedArgvExecRefused { reason: why } => AdministratorPrivilegeRefused { reason: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        AdministratorPrivilegeAvailable
      } else {
        AdministratorPrivilegeRefused {
          reason: join(["non-interactive sudo as ", subject.target.principal as String, " exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], ""),
        }
      }
  }
}

fn observe_fleet_host_paths(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  paths: List<String>,
  kind: String,
) -> FleetHostPathMetadata
{
  match run_fleet_host_leg(subject: subject, context: context, leg: LegRootOnlyFind { paths: paths, kind: kind }) {
    TypedArgvExecRefused { reason: why } => PathsUnobservable { reason: why }
    TypedArgvExecConverged { result: r } =>
      classify_root_only_paths(requested: paths, exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr)
  }
}

// THE ANCESTOR CHAIN, WITH ITS ABSENT TAIL. One find over every ancestor answers the common case. find
// exits nonzero when a named path does not exist, and that exit alone cannot tell absence from a refusal,
// so a failed find is followed by the presence question for each ancestor (entry_presence, the walk that
// already establishes a file's own absence). Absent ancestors must be a tail of the chain; the find is
// then re-run over the ancestors that exist, so their root-only reading is still a successful find.
type FleetHostAncestorsReading {
  metadata: FleetHostPathMetadata
  absent: List<String>
}

fn observe_fleet_host_ancestors(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  path: String,
) -> FleetHostAncestorsReading
{
  let chain = fleet_host_path_ancestors(path: path)
  match observe_fleet_host_paths(subject: subject, context: context, paths: chain, kind: "d") {
    PathsUnobservable { reason: r } => {
      let presence = map(chain, a => AncestorPresence {
        path: a,
        presence: entry_presence(arm: OverTransport { transport: FleetSsh { target: subject.target, context: context } }, path: a),
      })
      fleet_host_ancestors_after_presence(
        subject: subject,
        context: context,
        chain: chain,
        presence: presence,
        find_refusal: r,
      )
    }
    PathsRootOnly => FleetHostAncestorsReading { metadata: PathsRootOnly, absent: [] }
    PathsNotRootOnly { paths: ps, detail: d } => FleetHostAncestorsReading { metadata: PathsNotRootOnly { paths: ps, detail: d }, absent: [] }
    PathsNotApplicable => FleetHostAncestorsReading { metadata: PathsNotApplicable, absent: [] }
  }
}

type AncestorPresence {
  path: String
  presence: EntryPresence
}

fn fleet_host_ancestors_after_presence(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  chain: List<String>,
  presence: List<AncestorPresence>,
  find_refusal: String,
) -> FleetHostAncestorsReading
{
  match classify_fleet_host_ancestor_presence(chain: chain, presence: presence) {
    AncestorTailUndetermined { cause: c } =>
      FleetHostAncestorsReading { metadata: PathsUnobservable { reason: join([find_refusal, "; ", c], "") }, absent: [] }
    AncestorTailNone =>
      FleetHostAncestorsReading { metadata: PathsUnobservable { reason: find_refusal }, absent: [] }
    AncestorTailAbsent { present: ps, absent: ab } =>
      FleetHostAncestorsReading {
        metadata: if length(ps) == 0 { PathsUnobservable { reason: "no ancestor of the file exists within the write scope" } } else {
          observe_fleet_host_paths(subject: subject, context: context, paths: ps, kind: "d")
        },
        absent: ab,
      }
  }
}

// THE PURE HALF: which ancestors exist and which do not, from one presence answer per ancestor, in the
// chain's root-to-leaf order. Any undetermined answer undetermines the whole reading, and an absent
// ancestor above a present one contradicts itself, so both refuse rather than create.
type AncestorTail
  = AncestorTailNone
  | AncestorTailAbsent { present: List<String>, absent: List<String> }
  | AncestorTailUndetermined { cause: String }

fn classify_fleet_host_ancestor_presence(chain: List<String>, presence: List<AncestorPresence>) -> AncestorTail {
  let undetermined = list_flat_map(presence, a => match a.presence {
    EntryPresenceIndeterminate { cause: c } => [join([a.path, ": ", c], "")]
    EntryPresent => []
    EntryAbsent => []
  })
  let present = list_flat_map(presence, a => match a.presence { EntryPresent => [a.path] EntryAbsent => [] EntryPresenceIndeterminate { cause: _ } => [] })
  let absent = list_flat_map(presence, a => match a.presence { EntryAbsent => [a.path] EntryPresent => [] EntryPresenceIndeterminate { cause: _ } => [] })
  if length(undetermined) > 0 {
    AncestorTailUndetermined { cause: concat("ancestor presence undetermined: ", join(undetermined, "; ")) }
  } else if !(map(presence, a => a.path) == chain) {
    AncestorTailUndetermined { cause: "the presence answers do not cover the ancestor chain in order" }
  } else if length(absent) == 0 {
    AncestorTailNone
  } else if !(concat(present, absent) == chain) {
    AncestorTailUndetermined { cause: concat("an absent ancestor lies above a present one: ", join(absent, ",")) }
  } else {
    AncestorTailAbsent { present: present, absent: absent }
  }
}

// THE DIRECTORY AN ABSENT ANCESTOR IS CREATED AS: root-owned, at the executor's managed directory mode,
// which carries no group or other write bit, so the root-only readback admits exactly what was created.
fn fleet_host_ancestor_directory_argv(path: String) -> List<String> {
  map(executor_privileged_operation_argv(op: EnsureOwnedDirectory {
    path: path as NonEmptyStr, owner: "root" as NonEmptyStr, group: "root" as NonEmptyStr, mode: executor_managed_directory_mode,
  }), w => w as String)
}

fn observe_fleet_host_file_mode(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  file: FleetHostFileDesired,
) -> FleetHostPathMetadata
{
  match run_fleet_host_leg(subject: subject, context: context, leg: LegFileModeFind { path: file.path as String, mode: file.mode }) {
    TypedArgvExecRefused { reason: why } => PathsUnobservable { reason: why }
    TypedArgvExecConverged { result: r } =>
      classify_root_only_paths(requested: [file.path as String], exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr)
  }
}

fn fleet_host_file_write_admission(file: FleetHostFileDesired) -> TypedRemoteFileWriteAdmission {
  typed_remote_file_write_seal(path: file.path, content: file.content, allowed_scope: fleet_host_file_scope)
}

fn fleet_host_file_standing_of_report(report: RemoteFileComparisonReport) -> FleetHostFileStanding {
  match report {
    ComparisonIdentical => HostFileIdentical
    ComparisonDiffers { reason: _ } => HostFileDiffers
    ComparisonUnavailable { reason: r } => HostFileUnobservable { reason: r }
  }
}

// THE PARENT IS ENUMERATED ONLY WHEN THE READ FAILED, because that is the only outcome whose
// meaning the parent decides. `entry_presence` is a remote leg -- `ls -1 -A --` of the parent over
// the same transport, recursing up the ancestor chain when a listing refuses -- so asking it beside
// a read that already answered buys a standing the classifier discards (DESIGN section 2, and
// section 6's bare minimum cost). Both of the classifier's parent-dependent outcomes stay inhabited
// by production, because this arm is the only route that can reach them (DESIGN section 3c).
fn observe_fleet_host_file_path(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  path: String,
  reading: FleetHostFileMetadataReading,
) -> FleetHostFilePathStanding
{
  match reading {
    HostFileMetadataReported => HostFilePathPresent
    HostFileMetadataUnread { cause: _ } =>
      classify_host_file_path(
        reading: reading,
        parent: entry_presence(
          arm: OverTransport { transport: FleetSsh { target: subject.target, context: context } },
          path: path,
        ),
      )
  }
}

// THE PLAN'S "IDENTICAL" AND THE APPLY'S "CONVERGED" ARE ONE JUDGMENT OVER ONE LEG. The comparison is
// typed_remote_file_write's own far-side `cmp -s -` with the declared bytes on stdin, classified by
// its own exit vocabulary, so an observation cannot call a file converged that the write's read-back
// would call different.
fn observe_fleet_host_file_content(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  file: FleetHostFileDesired,
) -> FleetHostFileStanding
{
  match run_fleet_host_leg(subject: subject, context: context, leg: LegMetadataProbe { path: file.path as String }) {
    TypedArgvExecRefused { reason: why } => HostFileUnobservable { reason: why }
    TypedArgvExecConverged { result: metadata } =>
      match fleet_host_file_settled_standing(st: observe_fleet_host_file_path(
        subject: subject,
        context: context,
        path: file.path as String,
        reading: classify_host_file_metadata(exit_code: metadata.exit_code, stdout: metadata.stdout, stderr: metadata.stderr),
      )) {
        Present { value: settled } => settled
        Absent =>
          match fleet_host_file_write_admission(file: file) {
            TypedRemoteFileWriteAdmissionRefused { cause: c } => HostFileUnobservable { reason: c as String }
            TypedRemoteFileWriteAdmitted { write: w } =>
              match typed_remote_file_step(
                target: subject.target,
                context: context,
                raws: remote_file_privileged_argv(privilege: RemoteFileViaNonInteractiveSudo, argv: typed_remote_file_compare_argv(write: w)),
                stdin_payload: w.content,
              ) {
                TypedRemoteFileStepArgvRefused => HostFileUnobservable { reason: "comparison argv refused as non-portable under the far-side shell re-parse allowlist" }
                TypedRemoteFileStepLegRefused { cause: why } => HostFileUnobservable { reason: why as String }
                TypedRemoteFileStepRan { result: back } =>
                  fleet_host_file_standing_of_report(
                    report: classify_typed_remote_file_comparison(write: w, compare_exit_code: back.exit_code, compare_stderr: back.stderr),
                  )
              }
          }
      }
  }
}

fn observe_fleet_host_file(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  file: FleetHostFileDesired,
) -> FleetHostFileObservation
{
  let content = observe_fleet_host_file_content(subject: subject, context: context, file: file)
  let ancestors = observe_fleet_host_ancestors(subject: subject, context: context, path: file.path as String)
  FleetHostFileObservation {
    content: content,
    file_metadata: match content {
      HostFileAbsent => PathsNotApplicable
      HostFileUnobservable { reason: _ } => PathsNotApplicable
      HostFileIdentical => observe_fleet_host_file_mode(subject: subject, context: context, file: file)
      HostFileDiffers => observe_fleet_host_file_mode(subject: subject, context: context, file: file)
    },
    ancestors: ancestors.metadata,
    absent_ancestors: ancestors.absent,
  }
}

// ── Every required retiree, read from the population's own two reads ────────────────────────────────

// A RETIREE'S THREE RETIREMENT READINGS OUT OF THE BATCHED SHOW, OR NOTHING. A retiree whose block is
// missing, or whose block lacks any of the three keys, is `RetireeNotShown` and reads unobserved --
// never retired: absence from an output is not retirement, exactly as absence from list-units is not.
type RetireeShowReading
  = RetireeShown { unit: NonEmptyStr, unit_file_state: String, active_state: String, control_group: String }
  | RetireeNotShown { unit: NonEmptyStr }

fn runner_retiree_show_reading(unit: NonEmptyStr, show_stdout: String) -> RetireeShowReading {
  fold(split(s: show_stdout, delimiter: "\n\n"), init: RetireeNotShown { unit: unit }, f: (acc, b) => {
    let lines = map(split(s: b, delimiter: "\n"), l => trim(s: l))
    match show_block_value(lines: lines, property: IdProperty) {
      Absent => acc
      Present { value: id } =>
        if trim(s: id) != (unit as String) {
          acc
        } else {
          match show_block_value(lines: lines, property: UnitFileState) {
            Absent => acc
            Present { value: fs } =>
              match show_block_value(lines: lines, property: ActiveState) {
                Absent => acc
                Present { value: act } =>
                  match show_block_value(lines: lines, property: ControlGroup) {
                    Absent => acc
                    Present { value: cg } => RetireeShown { unit: unit, unit_file_state: fs, active_state: act, control_group: cg }
                  }
              }
          }
        }
    }
  })
}

fn runner_retiree_show_readings(retired: List<NonEmptyStr>, show_stdout: String) -> List<RetireeShowReading> {
  map(retired, r => runner_retiree_show_reading(unit: r, show_stdout: show_stdout))
}

// THE ONE EVENTS READ, AND IT NAMES A DIRECTORY RATHER THAN THE FILES. Every retiree's own cgroup
// path carries systemd's escaped slice component, which the fleet's typed argv edge REFUSES
// (portable_remote_word_char_allowed admits no backslash) -- so an argv listing those paths never
// executes. gunbc.runner.runner_slot_retirement retirement_cgroup_events_read_root derives the deepest
// UNESCAPED ancestor instead, and grep walks it for the one file name. Still one exec whatever the
// number of retirees.
//
// THREE ARMS, BECAUSE THERE ARE THREE FACTS. An optional collapsed "no retiree holds a cgroup" into
// "their roots disagree", so the only population that ever read the collapsed cause was the one it
// described wrongly, and the roots naming the disagreement were dropped on the floor. A read that is
// NOT OWED is not a read that was REFUSED.
type RetireeCgroupEventsRead
  = RetireeCgroupEventsNotOwed
  | RetireeCgroupEventsArgv { argv: List<String> }
  | RetireeCgroupEventsRefused { cause: String }

fn runner_retiree_cgroup_events_read(readings: List<RetireeShowReading>) -> RetireeCgroupEventsRead {
  match retirement_cgroup_events_read_root(control_groups: flat_map(readings, r => match r {
    RetireeNotShown { unit: _ } => []
    RetireeShown { unit: _, unit_file_state: _, active_state: _, control_group: cg } => [cg]
  })) {
    CgroupEventsReadRootNone => RetireeCgroupEventsNotOwed
    CgroupEventsReadRootAmbiguous { roots: rs } =>
      RetireeCgroupEventsRefused {
        cause: join(["this population's retirees sit under cgroup roots that disagree, and one read was not widened to cover them: ", join(rs, " ")], ""),
      }
    CgroupEventsReadRootOne { root: root } =>
      RetireeCgroupEventsArgv {
        argv: grep_fixed_string_in_tree_argv(
          pattern: cgroup_v2_events_populated_key,
          file_name: cgroup_v2_events_interface_file,
          root: root,
        ),
      }
  }
}

// The two arms that issue no exec, as the batch a retiree reads. NotOwed reaches no reader -- every
// retiree of such a population reports a blank ControlGroup, which cgroup_occupancy_from_batched_events
// answers as CgroupAbsent without consulting the batch -- so its cause says what it is, not what the
// refused arm's says.
fn runner_retiree_cgroup_events_unread(read: RetireeCgroupEventsRead) -> CgroupEventsBatch {
  match read {
    RetireeCgroupEventsNotOwed => CgroupEventsBatchUnread { cause: "no retiree of this population holds a workload cgroup, so no read was owed" }
    RetireeCgroupEventsRefused { cause: c } => CgroupEventsBatchUnread { cause: c }
    RetireeCgroupEventsArgv { argv: _ } => CgroupEventsBatchUnread { cause: "the batched read was issued and its outcome is the caller's" }
  }
}

fn runner_retiree_standings(readings: List<RetireeShowReading>, batch: CgroupEventsBatch) -> List<RunnerRetirementStanding> {
  map(readings, r => runner_retirement_standing(o: match r {
    RetireeNotShown { unit: u } => retirement_observation_unreadable(unit: u, cause: "systemctl show returned no complete block for this required retiree")
    RetireeShown { unit: u, unit_file_state: fs, active_state: act, control_group: cg } =>
      retirement_observation_from_readings(unit: u, unit_file_state: fs, active_state: act, occupancy: cgroup_occupancy_from_batched_events(control_group: cg, batch: batch))
  }))
}

fn observe_runner_slot_population(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  expect: RunnerSlotExpectation,
) -> RunnerSlotPopulation
{
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegListServiceUnits) {
    TypedArgvExecRefused { reason: why } => SlotPopulationUnobservable { reason: why }
    TypedArgvExecConverged { result: listed } =>
      if !listed.success {
        SlotPopulationUnobservable { reason: join(["systemctl list-units exit=", to_string(listed.exit_code), " ", trim(s: listed.stderr)], "") }
      } else {
        let units = runner_slot_population_units(desired: subject.desired_units, retired: subject.retired_units, loaded: runner_slot_units_from_list_units(stdout: listed.stdout))
        match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegShowSlotProperties { units: units }) {
          TypedArgvExecRefused { reason: why } => SlotPopulationUnobservable { reason: why }
          TypedArgvExecConverged { result: shown } =>
            if !shown.success {
              SlotPopulationUnobservable { reason: join(["systemctl show exit=", to_string(shown.exit_code), " ", trim(s: shown.stderr)], "") }
            } else {
              let readings = runner_retiree_show_readings(retired: subject.retired_units, show_stdout: shown.stdout)
              let read = runner_retiree_cgroup_events_read(readings: readings)
              let batch = match read {
                RetireeCgroupEventsNotOwed => runner_retiree_cgroup_events_unread(read: read)
                RetireeCgroupEventsRefused { cause: _ } => runner_retiree_cgroup_events_unread(read: read)
                RetireeCgroupEventsArgv { argv: argv } =>
                  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegRetireeCgroupEvents { argv: argv }) {
                    TypedArgvExecRefused { reason: why } => CgroupEventsBatchUnread { cause: why }
                    TypedArgvExecConverged { result: ev } => CgroupEventsBatchRead { stdout: ev.stdout, stderr: ev.stderr }
                  }
              }
              let retirements = runner_retiree_standings(readings: readings, batch: batch)
              SlotPopulationObserved { units: classify_runner_slot_population_with_fabric(units: units, fabric: subject.fabric_units, retirements: retirements, show_stdout: shown.stdout, expect: expect) }
            }
        }
      }
  }
}

// ── The job user's uid, read from the host ──────────────────────────────────────────────────────

// THE UID IS READ OVER THE ADMINISTRATOR EDGE THIS RUN ALREADY HOLDS, from the deploy row's job
// user, and is never committed (operator approval 2026-10-14). A refused or unparseable read is
// JobUserUidUnobserved, which withholds depriv and the unit fragment for this host only.
fn observe_runner_job_user_uid(subject: RunnerHostFileSubject, context: FleetSshExecutionContext) -> RunnerJobUserUidReading
{
  match runner_host_deploy_for(host: subject.host) {
    RunnerHostDeployUnmodeled { host: _ } => JobUserUidUnobserved { cause: "no runner deploy row names the job user" as NonEmptyStr }
    RunnerHostDeployRefused { host: _, cause: c } => JobUserUidUnobserved { cause: concat("the runner deploy row refuses: ", c) as NonEmptyStr }
    RunnerHostDeployFound { deploy: d } =>
      match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegJobUserPasswd { job_user: d.job_user }) {
        TypedArgvExecRefused { reason: why } => JobUserUidUnobserved { cause: concat("getent passwd leg refused: ", why) as NonEmptyStr }
        TypedArgvExecConverged { result: r } =>
          runner_job_user_uid_reading(job_user: d.job_user, exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr)
      }
  }
}

// ── The deploy slot's account ──────────────────────────────────────────────────────────────────
// A HOST WITH A DEPLOY SLOT OWES ITS ACCOUNT BEFORE ITS ROLE DROP-IN (gunbc.runner.runner_slot_job_role
// srv1_deploy_slot). The drop-in names the account the slot's jobs run as, and the listener refuses
// to start when that account does not exist (ctrl jit-runner.sh: "is not a user on this host"), so a
// drop-in delivered before its account would take the slot down at its next restart. The converge
// reads the account, creates it as the administrator when it is absent and the run applies, reads it
// back, and withholds the role drop-in by name whenever the account is not there. Observe mode reads
// and creates nothing. Absent is only getent's own key-not-found status; any other failure is
// unreadable, which is not absence and creates nothing.
type DeploySlotAccountStanding
  = HostHasNoDeploySlot
  | DeploySlotAccountPresent { uid: Int, passwd_line: NonEmptyStr }
  | DeploySlotAccountCreated { uid: Int, passwd_line: NonEmptyStr }
  | DeploySlotAccountMissing { cause: NonEmptyStr }

type DeploySlotAccountRead
  = DeploySlotAccountReadPresent { uid: Int, passwd_line: NonEmptyStr }
  | DeploySlotAccountReadAbsent
  | DeploySlotAccountReadUnreadable { cause: NonEmptyStr }

fn classify_deploy_slot_account_read(exit_code: Int, stdout: String, stderr: String) -> DeploySlotAccountRead {
  if exit_code == getent_key_not_found_exit {
    DeploySlotAccountReadAbsent
  } else {
    match runner_job_user_uid_reading(job_user: deploy_slot_job_user, exit_code: exit_code, stdout: stdout, stderr: stderr) {
      JobUserUidObserved { uid: u, passwd_line: l } => DeploySlotAccountReadPresent { uid: u, passwd_line: l }
      JobUserUidUnobserved { cause: c } => DeploySlotAccountReadUnreadable { cause: c }
    }
  }
}

fn observe_deploy_slot_account(subject: RunnerHostFileSubject, context: FleetSshExecutionContext) -> DeploySlotAccountRead
{
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegJobUserPasswd { job_user: deploy_slot_job_user }) {
    TypedArgvExecRefused { reason: why } => DeploySlotAccountReadUnreadable { cause: concat("getent passwd leg refused: ", why) as NonEmptyStr }
    TypedArgvExecConverged { result: r } => classify_deploy_slot_account_read(exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr)
  }
}

// THE DECISION AFTER THE FIRST READ, pure: what the run does next and what it reports when it does
// nothing. Only an absent account in an apply run with the administrator's privilege is created.
type DeploySlotAccountStep
  = DeploySlotAccountSettled { standing: DeploySlotAccountStanding }
  | DeploySlotAccountCreate

fn deploy_slot_account_step(read: DeploySlotAccountRead, mode: FleetHostFileConvergeMode, privilege: FleetHostPrivilegeStanding) -> DeploySlotAccountStep {
  match read {
    DeploySlotAccountReadPresent { uid: u, passwd_line: l } => DeploySlotAccountSettled { standing: DeploySlotAccountPresent { uid: u, passwd_line: l } }
    DeploySlotAccountReadUnreadable { cause: c } => DeploySlotAccountSettled { standing: DeploySlotAccountMissing { cause: concat("the account could not be read, so it is neither confirmed nor created: ", c) as NonEmptyStr } }
    DeploySlotAccountReadAbsent =>
      match mode {
        FleetHostFilesObserveOnly => DeploySlotAccountSettled { standing: DeploySlotAccountMissing { cause: "absent; observe mode creates nothing" as NonEmptyStr } }
        FleetHostFilesApply =>
          match privilege {
            AdministratorPrivilegeAvailable => DeploySlotAccountCreate
            AdministratorPrivilegeRefused { reason: r } => DeploySlotAccountSettled { standing: DeploySlotAccountMissing { cause: concat("absent, and the administrator holds no privilege to create it: ", r) as NonEmptyStr } }
          }
      }
  }
}

fn converge_deploy_slot_account(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
) -> DeploySlotAccountStanding
{
  if !runner_host_has_deploy_slot(host: subject.host) {
    HostHasNoDeploySlot
  } else {
    match deploy_slot_account_step(read: observe_deploy_slot_account(subject: subject, context: context), mode: mode, privilege: privilege) {
      DeploySlotAccountSettled { standing: st } => st
      DeploySlotAccountCreate =>
        match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegElevated { command: map(executor_privileged_operation_argv(op: deploy_slot_account_operation()), w => w as String) }) {
          TypedArgvExecRefused { reason: why } => DeploySlotAccountMissing { cause: concat("useradd leg refused: ", why) as NonEmptyStr }
          TypedArgvExecConverged { result: r } =>
            match observe_deploy_slot_account(subject: subject, context: context) {
              DeploySlotAccountReadPresent { uid: u, passwd_line: l } => DeploySlotAccountCreated { uid: u, passwd_line: l }
              DeploySlotAccountReadAbsent => DeploySlotAccountMissing { cause: join(["useradd exit=", to_string(r.exit_code), " ", trim(s: r.stderr), "; the account is still absent on readback"], "") as NonEmptyStr }
              DeploySlotAccountReadUnreadable { cause: c } => DeploySlotAccountMissing { cause: concat("created, but the readback could not read it: ", c) as NonEmptyStr }
            }
        }
    }
  }
}

// ── The deploy slot's tree ───────────────────────────────────────────────────────────────────────
// A SLOT'S WHOLE TREE IS OWNED BY ITS JOB USER (gunbc.runner.runner_slot_provision: the provisioner
// removes, recreates and extracts it as that user), so a slot that was a CI slot carries a tree any
// pull request job on it could have rewritten: the runner binaries, run.sh, its env file, its hooks,
// and the checkouts under _work. A deploy slot's jobs hold the administrator's key, so the tree is
// never handed over by a change of owner: it is drained, removed, and re-extracted from the pinned,
// digest-verified runner archive the provisioner installs (fleet_runner_slot_artifact), owned by the
// deploy account from its first byte. The test that the slot is already through the transition is
// its tree's owner uid equal to the deploy account's. A slot whose job is still running is masked
// and left pending, settled by a later run, as every drain is.
type DeploySlotTreeStanding
  = DeploySlotTreeHeld { unit: NonEmptyStr }
  | DeploySlotTreeRebuilt { unit: NonEmptyStr }
  | DeploySlotTreePending { unit: NonEmptyStr, cause: NonEmptyStr }
  | DeploySlotTreeRefused { unit: NonEmptyStr, cause: NonEmptyStr }

fn deploy_slot_tree_held(standing: DeploySlotTreeStanding) -> Bool {
  match standing {
    DeploySlotTreeHeld { unit: _ } => true
    DeploySlotTreeRebuilt { unit: _ } => true
    DeploySlotTreePending { unit: _, cause: _ } => false
    DeploySlotTreeRefused { unit: _, cause: _ } => false
  }
}

fn deploy_slot_tree_unit(standing: DeploySlotTreeStanding) -> NonEmptyStr {
  match standing {
    DeploySlotTreeHeld { unit: u } => u
    DeploySlotTreeRebuilt { unit: u } => u
    DeploySlotTreePending { unit: u, cause: _ } => u
    DeploySlotTreeRefused { unit: u, cause: _ } => u
  }
}

fn deploy_slot_account_is_held(standing: DeploySlotAccountStanding) -> Bool {
  match standing {
    DeploySlotAccountPresent { uid: _, passwd_line: _ } => true
    DeploySlotAccountCreated { uid: _, passwd_line: _ } => true
    DeploySlotAccountMissing { cause: _ } => false
    HostHasNoDeploySlot => false
  }
}

// WHETHER THE TREE IS THE ACCOUNT'S, asked far side by find in the module's own portable-word idiom
// (runner_host_root_only_find_argv): the directory is printed exactly when it is a directory owned by
// the account. A stat format would carry a percent sign the fleet transport refuses
// (the_percent_format_stat_probe_is_refused_by_the_transport).
// THE MODE IS PART OF HOLDING IT: an owned tree at any mode but the deploy role's owner-only one
// (gunbc.runner.runner_slot_job_role runner_slot_job_role_tree_mode) is rebuilt like an unowned one, so a
// tree created before the confidentiality wall, and the 0644 registration inside it, do not survive.
fn deploy_slot_tree_mode_octal() -> String {
  file_mode_octal(mode: runner_slot_job_role_tree_mode(role: DeployJobSlot))
}

fn deploy_slot_tree_owned_find_argv(slot_dir: String) -> List<String> {
  ["find", slot_dir, "-maxdepth", "0", "-type", "d", "-user", deploy_slot_job_user as String, "-perm", deploy_slot_tree_mode_octal()]
}

// Printed: owned. Exit 0 and nothing printed: not owned. Anything else: not read.
fn classify_deploy_slot_tree_owned(slot_dir: String, exit_code: Int, stdout: String) -> Bool? {
  if exit_code != 0 { none }
  else if trim(s: stdout) == slot_dir { Present { value: true } }
  else if trim(s: stdout) == "" { Present { value: false } }
  else { none }
}

fn observe_deploy_slot_tree_owned(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, slot_dir: String) -> Bool? {
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegElevated { command: deploy_slot_tree_owned_find_argv(slot_dir: slot_dir) }) {
    TypedArgvExecRefused { reason: _ } => none
    TypedArgvExecConverged { result: r } => classify_deploy_slot_tree_owned(slot_dir: slot_dir, exit_code: r.exit_code, stdout: r.stdout)
  }
}

// THE TREE'S NEXT STEP AFTER THE OWNER READ, pure.
type DeploySlotTreeStep
  = DeploySlotTreeSettled { standing: DeploySlotTreeStanding }
  | DeploySlotTreeDrainThenRebuild

fn deploy_slot_tree_step(unit: NonEmptyStr, account_held: Bool, owned: Bool?, mode: FleetHostFileConvergeMode, privilege: FleetHostPrivilegeStanding) -> DeploySlotTreeStep {
  if !account_held {
    DeploySlotTreeSettled { standing: DeploySlotTreeRefused { unit: unit, cause: "the deploy account is not held, so no tree can be owned by it" as NonEmptyStr } }
  } else {
      match owned {
        Absent => DeploySlotTreeSettled { standing: DeploySlotTreeRefused { unit: unit, cause: "whether the tree is the deploy account's could not be read" as NonEmptyStr } }
        Present { value: o } =>
          if o { DeploySlotTreeSettled { standing: DeploySlotTreeHeld { unit: unit } } }
          else {
            match mode {
              FleetHostFilesObserveOnly => DeploySlotTreeSettled { standing: DeploySlotTreePending { unit: unit, cause: join(["the tree is not owned by ", deploy_slot_job_user as String, " at mode ", deploy_slot_tree_mode_octal(), "; an apply drains and rebuilds it"], "") as NonEmptyStr } }
              FleetHostFilesApply =>
                match privilege {
                  AdministratorPrivilegeRefused { reason: r } => DeploySlotTreeSettled { standing: DeploySlotTreeRefused { unit: unit, cause: concat("the administrator holds no privilege to rebuild it: ", r) as NonEmptyStr } }
                  AdministratorPrivilegeAvailable => DeploySlotTreeDrainThenRebuild
                }
            }
          }
      }
  }
}

// THE REBUILD, AS ONE VERIFIED INSTALL: the archive is fetched by the administrator into a stage of
// its own, verified against the release's pinned digest, and only then is the tree removed,
// recreated owned by the deploy account, and extracted AS that account, so no file in it is owned by
// anyone else; the stage is removed last.
//
// THE STAGE IS WRITABLE BY ROOT ALONE FROM BEFORE THE FETCH UNTIL AFTER THE EXTRACT, because the digest
// is checked by one leg and the bytes are read by a later one: an archive any other account could
// replace between them would be extracted unverified under the deploy key while the run reports it
// verified. So the stage is not in /tmp (the CI slots' jobs share it, gunbc.plans.srv1_deploy_principal_split)
// but a member of the host-state tree, which root owns and nobody else writes
// (gunbc.host_state_root host_state_tree_root); it is removed and recreated root-owned before the
// fetch, so nothing left in it by an earlier run survives, and the fetch itself runs as root, so the
// archive is root's file.
fn deploy_slot_runner_stage_dir() -> String {
  join([host_state_tree_path(tree: host_state_tree()) as String, "/deploy-slot-runner-stage"], "")
}

fn deploy_slot_runner_stage_fetch_commands(stage: String, url: String, tarball: String) -> List<ArgvCommand> {
  [
    executor_privileged_operation_elevated_command(op: RemoveDirectoryTree { path: stage as NonEmptyStr }),
    executor_privileged_operation_elevated_command(op: EnsureOwnedDirectory {
      path: stage as NonEmptyStr, owner: "root" as NonEmptyStr, group: "root" as NonEmptyStr, mode: executor_managed_directory_mode,
    }),
    sudo_elevate_command(command: argv_words(command: curl_download_command(url: url, destination: tarball))),
  ]
}

// The extract leaves the tree's own mode alone (extdeps.tools.tar tar_extract_command):
// the runner archive's `./` entry carries 0755, and a default extract re-applied it to the 0700 tree
// (gunbc.recurring_failure_mode an_archive_extract_reapplies_its_directory_mode_to_the_destination).
fn deploy_slot_tree_rebuild_commands(slot_dir: String, stage: String, tarball: String) -> List<ArgvCommand> {
  [
    executor_privileged_operation_elevated_command(op: RemoveDirectoryTree { path: slot_dir as NonEmptyStr }),
    executor_privileged_operation_elevated_command(op: EnsureOwnedDirectory {
      path: slot_dir as NonEmptyStr, owner: deploy_slot_job_user, group: deploy_slot_job_user, mode: runner_slot_job_role_tree_mode(role: DeployJobSlot),
    }),
    sudo_elevate_as_command(user: deploy_slot_job_user, command: argv_words(command: tar_extract_command(archive: tarball, into_directory: slot_dir, strip_components: 0, existing_directories: TarNoOverwriteDir))),
    executor_privileged_operation_elevated_command(op: RemoveDirectoryTree { path: stage as NonEmptyStr }),
  ]
}

fn rebuild_deploy_slot_tree(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, slot: RunnerSlotIdentity) -> DeploySlotTreeStanding
{
  let unit = runner_slot_unit_name(slot: slot)
  let dir = runner_slot_dir_path(slot: slot) as String
  match fleet_runner_slot_artifact() {
    Absent => DeploySlotTreeRefused { unit: unit, cause: "no published runner artifact for the fleet's architecture" as NonEmptyStr }
    Present { value: a } => {
      let stage = deploy_slot_runner_stage_dir()
      let tarball = join([stage, "/", actions_runner_tarball_filename(artifact: a)], "")
      let outcome = verified_archive_install(
        fetch: deploy_slot_runner_stage_fetch_commands(stage: stage, url: actions_runner_download_url(artifact: a), tarball: tarball),
        archive: tarball as NonEmptyStr,
        pin: ArchiveSha256 { hex: actions_runner_release_digest(artifact: a).hex },
        install: deploy_slot_tree_rebuild_commands(slot_dir: dir, stage: stage, tarball: tarball),
        transport: FleetSsh { target: subject.target, context: context },
      )
      if !verified_archive_install_holds(outcome: outcome) {
        DeploySlotTreeRefused { unit: unit, cause: verified_archive_install_text(outcome: outcome) as NonEmptyStr }
      } else {
        match observe_deploy_slot_tree_owned(subject: subject, context: context, slot_dir: dir) {
          Present { value: owned_after } =>
            if owned_after { DeploySlotTreeRebuilt { unit: unit } }
            else { DeploySlotTreeRefused { unit: unit, cause: join(["rebuilt, but the tree does not read back owned by ", deploy_slot_job_user as String, " at mode ", deploy_slot_tree_mode_octal()], "") as NonEmptyStr } }
          Absent => DeploySlotTreeRefused { unit: unit, cause: "rebuilt, but the tree's owner could not be read back" as NonEmptyStr }
        }
      }
    }
  }
}

fn converge_deploy_slot_tree(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  account: DeploySlotAccountStanding,
  slot: RunnerSlotIdentity,
) -> DeploySlotTreeStanding
{
  let unit = runner_slot_unit_name(slot: slot)
  let account_held = deploy_slot_account_is_held(standing: account)
  let owned = if account_held { observe_deploy_slot_tree_owned(subject: subject, context: context, slot_dir: runner_slot_dir_path(slot: slot) as String) } else { none }
  match deploy_slot_tree_step(unit: unit, account_held: account_held, owned: owned, mode: mode, privilege: privilege) {
    DeploySlotTreeSettled { standing: st } => st
    DeploySlotTreeDrainThenRebuild =>
      match drain_and_mask_runner_slot_over(target: subject.target, context: context, unit: unit) {
        SlotDrainPending { unit: _, cause: _ } => DeploySlotTreePending { unit: unit, cause: "masked; a job is still running or the unit is still stopping, so the rebuild waits for a later run" as NonEmptyStr }
        SlotActuationRefused { unit: _, step: st, reason: why } => DeploySlotTreeRefused { unit: unit, cause: join(["the drain refused at ", st, ": ", why], "") as NonEmptyStr }
        SlotActivated { unit: _ } => DeploySlotTreeRefused { unit: unit, cause: "the drain answered activated" as NonEmptyStr }
        SlotNotInstalled { unit: _ } => DeploySlotTreeRefused { unit: unit, cause: "the slot's unit is not installed, so there is no drained slot whose tree this run may remove" as NonEmptyStr }
        // drain_and_mask_runner_slot_over answers Noop only for DrainAlreadyMasked: an earlier run masked
        // the slot while a job ran, and it has since stopped. That is the pending drain settling, so the
        // slot is as drained as SlotDrainedAndMasked and its tree is rebuilt.
        SlotActuationNoop { unit: _, state: _ } => rebuild_deploy_slot_tree(subject: subject, context: context, slot: slot)
        SlotDrainedAndMasked { unit: _ } => rebuild_deploy_slot_tree(subject: subject, context: context, slot: slot)
      }
  }
}

fn converge_deploy_slot_trees(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  account: DeploySlotAccountStanding,
) -> List<DeploySlotTreeStanding>
{
  map(filter(deploy_slot_identities, d => (d.host as String) == (subject.host as String)),
    slot => converge_deploy_slot_tree(subject: subject, context: context, mode: mode, privilege: privilege, account: account, slot: slot))
}

// ── The deploy slot's host reading ───────────────────────────────────────────────────────────────
// WHAT THE HOST HOLDS FOR THE DEPLOY ROUTE, read after the slots are, as the administrator: the job user
// each slot's loaded Environment assigns, and, for the deploy slot's tree and every file the listener
// keeps in it (extdeps.github.actions_runner actions_runner_state_paths), the owner, group and mode of
// the path and of each ancestor, judged against every other runnable slot's account
// (gunbc.ci.deploy_slot_tenancy deploy_slot_privacy). Paths are judged one by one, never from the tree's
// mode alone (operator, 2026-10-30): a 0644 file inside a later-widened tree must fail on the file.
fn deploy_slot_private_paths(slot: RunnerSlotIdentity) -> List<NonEmptyStr> {
  let dir = runner_slot_dir_path(slot: slot)
  concat([dir], map(actions_runner_state_paths(root: dir), p => p as NonEmptyStr))
}

// The value a loaded Environment assigns to one name: the word that starts with `NAME=`, to the next
// blank. A job user carries no blank (extdeps.access.posix PosixLoginName).
fn slot_environment_value(environment: String, name: String) -> String? {
  let key = concat(name, "=")
  match first(filter(split(s: environment, delimiter: " "), w => starts_with(s: w, prefix: key))) {
    Absent => none
    Present { value: w } => Present { value: substring(s: w, start: string_length(s: key), end: string_length(s: w)) }
  }
}

// A SLOT CAN RUN unless the manager holds it masked or holds no unit for it; an inactive, loaded slot
// can be started and is a tenant.
fn slot_load_state_can_run(load_state: String) -> Bool {
  let l = trim(s: load_state)
  l != "masked" && l != "not-found"
}

fn deploy_slot_entry_readings(paths: List<String>, exit_code: Int, stdout: String) -> List<DeploySlotPathReading> {
  let entries = map(filter(split(s: stdout, delimiter: "\n"), l => trim(s: l) != ""), l => ls_long_entry_of_line(line: l))
  map(paths, p => fold(entries, init: DeploySlotPathUnread { path: p as NonEmptyStr, reason: join(["ls printed no entry for it (exit=", to_string(exit_code), ")"], "") }, f: (acc, e) =>
    match e {
      LsLongEntryRead { name: n, directory: d, ownership: o, mode: m } => if n == p { DeploySlotPathRead { path: p as NonEmptyStr, directory: d, ownership: o, mode: m } } else { acc }
      LsLongEntryRefused { name: n, reason: why } => if n == p { DeploySlotPathUnread { path: p as NonEmptyStr, reason: why } } else { acc }
    }))
}

// THE STATE PATHS FROM ONE LISTING OF THE TREE. A name the successful listing does not carry is absent;
// a listing that failed reads nothing, so every state path is unread rather than absent.
fn deploy_slot_listing_readings(directory: String, paths: List<String>, exit_code: Int, stdout: String) -> List<DeploySlotPathReading> {
  if exit_code != 0 {
    map(paths, p => DeploySlotPathUnread { path: p as NonEmptyStr, reason: join(["the tree's listing failed (exit=", to_string(exit_code), ")"], "") })
  } else {
    let entries = map(filter(split(s: stdout, delimiter: "\n"), l => trim(s: l) != "" && !starts_with(s: trim(s: l), prefix: "total ")), l => ls_long_entry_of_line(line: l))
    map(paths, p => {
      let name = substring(s: p, start: string_length(s: directory) + 1, end: string_length(s: p))
      fold(entries, init: DeploySlotPathAbsent { path: p as NonEmptyStr }, f: (acc, e) =>
        match e {
          LsLongEntryRead { name: n, directory: d, ownership: o, mode: m } => if n == name { DeploySlotPathRead { path: p as NonEmptyStr, directory: d, ownership: o, mode: m } } else { acc }
          LsLongEntryRefused { name: n, reason: why } => if n == name { DeploySlotPathUnread { path: p as NonEmptyStr, reason: why } } else { acc }
        })
    })
  }
}

fn deploy_slot_job_user_identity(user: NonEmptyStr, exit_code: Int, stdout: String) -> DeploySlotJobUserIdentity {
  if exit_code != 0 {
    DeploySlotJobUserUnread { user: user, reason: join(["id exit=", to_string(exit_code)], "") }
  } else {
    match id_credentials_of_line(line: stdout) {
      IdCredentialsUnobserved { reason: why } => DeploySlotJobUserUnread { user: user, reason: why }
      IdCredentialsObserved { uid: u, primary_gid: g, supplementary_gids: gs } => DeploySlotJobUserRead { user: user, uid: u, gids: concat([g], gs) }
    }
  }
}

// WHERE THE DEPLOY SLOT'S HOST HALF IS READ FROM. The converge reads it over the administrator edge it
// already holds. The controller install reads it ON THE SLOT, as the deploy slot's own user and before
// the job's agent holds any key, because that reading is what decides whether the key may be loaded
// at all: read over the edge, it would rest on the credential whose safety it establishes. Every read
// below is one an unprivileged account can make of its own slot: systemctl show and list-units are the
// manager's answer to anyone, id reads the account database, and the path listings name the slot
// tree's ancestors and the tree the slot's user owns. On the edge the listings run elevated, as the
// converge always ran them.
type DeploySlotReadRoute
  = DeploySlotReadOverFleetEdge { subject: RunnerHostFileSubject, context: FleetSshExecutionContext }
  | DeploySlotReadOnTheSlot

type DeploySlotReadLeg
  = DeploySlotListUnits
  | DeploySlotShowUnits { units: List<NonEmptyStr> }
  | DeploySlotUserIdentity { user: NonEmptyStr }
  | DeploySlotPathListing { command: ArgvCommand }

type DeploySlotReadLegOutcome
  = DeploySlotReadLegRan { exit_code: Int, stdout: String, stderr: String }
  | DeploySlotReadLegRefused { reason: String }

fn deploy_slot_read_leg_on_the_slot(leg: DeploySlotReadLeg) -> ArgvCommand {
  match leg {
    DeploySlotListUnits => systemctl_list_all_service_units_command()
    DeploySlotShowUnits { units: us } => systemctl_show_units_properties_command(units: us, properties: runner_slot_show_properties)
    DeploySlotUserIdentity { user: u } => id_user_record_command(user: u)
    DeploySlotPathListing { command: c } => c
  }
}

fn deploy_slot_read_leg_over_the_edge(leg: DeploySlotReadLeg) -> FleetHostRemoteLeg {
  match leg {
    DeploySlotListUnits => LegListServiceUnits
    DeploySlotShowUnits { units: us } => LegShowSlotProperties { units: us }
    DeploySlotUserIdentity { user: u } => LegJobUserIdentity { job_user: u }
    DeploySlotPathListing { command: c } => LegElevated { command: argv_words(command: c) }
  }
}

fn run_deploy_slot_read_leg(route: DeploySlotReadRoute, leg: DeploySlotReadLeg) -> DeploySlotReadLegOutcome {
  match route {
    DeploySlotReadOverFleetEdge { subject: subject, context: context } =>
      match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: deploy_slot_read_leg_over_the_edge(leg: leg)) {
        TypedArgvExecRefused { reason: why } => DeploySlotReadLegRefused { reason: why }
        TypedArgvExecConverged { result: r } => DeploySlotReadLegRan { exit_code: r.exit_code, stdout: r.stdout, stderr: r.stderr }
      }
    DeploySlotReadOnTheSlot =>
      match run_shell_command_observe_outcome(command: deploy_slot_read_leg_on_the_slot(leg: leg), transport: LocalExec) {
        ProcessNotSpawned { program: p, cause: why } => DeploySlotReadLegRefused { reason: join([p as String, " was not spawned: ", why as String], "") }
        ProcessRan { observation: o } => DeploySlotReadLegRan { exit_code: o.exit_code, stdout: o.stdout, stderr: o.stderr }
      }
  }
}

fn observe_deploy_slot_job_user_identity(route: DeploySlotReadRoute, user: NonEmptyStr) -> DeploySlotJobUserIdentity {
  match run_deploy_slot_read_leg(route: route, leg: DeploySlotUserIdentity { user: user }) {
    DeploySlotReadLegRefused { reason: why } => DeploySlotJobUserUnread { user: user, reason: why }
    DeploySlotReadLegRan { exit_code: c, stdout: out, stderr: _ } => deploy_slot_job_user_identity(user: user, exit_code: c, stdout: out)
  }
}

fn observe_deploy_slot_path_readings(route: DeploySlotReadRoute, slot: RunnerSlotIdentity) -> List<DeploySlotPathReading> {
  let dir = runner_slot_dir_path(slot: slot) as String
  let chain = concat(path_ancestor_prefixes(path: dir), [dir])
  let states = map(actions_runner_state_paths(root: dir as NonEmptyStr), p => p)
  let chain_readings = match run_deploy_slot_read_leg(route: route, leg: DeploySlotPathListing { command: ls_long_numeric_entries_command(paths: chain) }) {
    DeploySlotReadLegRefused { reason: why } => map(chain, p => DeploySlotPathUnread { path: p as NonEmptyStr, reason: why })
    DeploySlotReadLegRan { exit_code: c, stdout: out, stderr: _ } => deploy_slot_entry_readings(paths: chain, exit_code: c, stdout: out)
  }
  let state_readings = match run_deploy_slot_read_leg(route: route, leg: DeploySlotPathListing { command: ls_long_numeric_listing_command(directory: dir) }) {
    DeploySlotReadLegRefused { reason: why } => map(states, p => DeploySlotPathUnread { path: p as NonEmptyStr, reason: why })
    DeploySlotReadLegRan { exit_code: c, stdout: out, stderr: _ } => deploy_slot_listing_readings(directory: dir, paths: states, exit_code: c, stdout: out)
  }
  concat(chain_readings, state_readings)
}

// ONE SHOW OF EVERY SLOT UNIT NAMED, then the deploy slot's user, every other runnable slot's user,
// each of those users' identity, and the deploy slot's paths. The names are the converge's population
// or the install's own listing (observe_deploy_slot_host_reading_on_the_slot); both derive them through
// runner_slot_population_units, so the two reads cover one set of units.
fn observe_deploy_slot_host_reading(route: DeploySlotReadRoute, names: List<NonEmptyStr>, slot: RunnerSlotIdentity) -> DeploySlotHostReading {
  let unit = runner_slot_unit_name(slot: slot)
  match run_deploy_slot_read_leg(route: route, leg: DeploySlotShowUnits { units: names }) {
    DeploySlotReadLegRefused { reason: why } => DeploySlotHostUnread { unit: unit, cause: concat("systemctl show refused: ", why) }
    DeploySlotReadLegRan { exit_code: _, stdout: show_stdout, stderr: _ } => {
      let readings = flat_map(names, n => match parse_runner_slot_reading_for(unit: n, show_stdout: show_stdout) { Absent => [] Present { value: rd } => [rd] })
      if count(readings) != count(names) {
        DeploySlotHostUnread { unit: unit, cause: "systemctl show returned no block for some slot" }
      } else {
        match first(filter(readings, rd => (rd.unit as String) == (unit as String))) {
          Absent => DeploySlotHostUnread { unit: unit, cause: "the deploy slot's unit was not read" }
          Present { value: own } =>
            match slot_environment_value(environment: trim(s: own.environment), name: runner_job_user_env_name) {
              Absent => DeploySlotHostUnread { unit: unit, cause: concat("the deploy slot's Environment assigns no ", runner_job_user_env_name) }
              Present { value: deploy_user } => {
                let runnable = filter(readings, rd => (rd.unit as String) != (unit as String) && slot_load_state_can_run(load_state: rd.load_state))
                let unassigned = filter(runnable, rd => match slot_environment_value(environment: trim(s: rd.environment), name: runner_job_user_env_name) { Absent => true Present { value: v } => v == "" })
                match first(unassigned) {
                  Present { value: bad } => DeploySlotHostUnread { unit: unit, cause: join(["slot ", bad.unit as String, " can run and its Environment assigns no ", runner_job_user_env_name], "") }
                  Absent => {
                    let others = fold(runnable, init: [], f: (acc, rd) => match slot_environment_value(environment: trim(s: rd.environment), name: runner_job_user_env_name) {
                      Absent => acc
                      Present { value: v } => if any(acc, a => (a as String) == v) { acc } else { concat(acc, [v as NonEmptyStr]) }
                    })
                    DeploySlotHostRead {
                      unit: unit,
                      deploy_slot_job_user: deploy_user as NonEmptyStr,
                      other_slot_job_users: others,
                      privacy: deploy_slot_privacy(
                        private_paths: deploy_slot_private_paths(slot: slot),
                        readings: observe_deploy_slot_path_readings(route: route, slot: slot),
                        others: map(others, o => observe_deploy_slot_job_user_identity(route: route, user: o)),
                      ),
                    }
                  }
                }
              }
            }
        }
      }
    }
  }
}

fn observe_deploy_slot_host_readings(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, slots: RunnerSlotPopulation) -> List<DeploySlotHostReading> {
  map(filter(deploy_slot_identities, d => (d.host as String) == (subject.host as String)),
    slot => match slots {
      SlotPopulationUnobservable { reason: r } => DeploySlotHostUnread { unit: runner_slot_unit_name(slot: slot), cause: concat("the slot population was not read: ", r) }
      SlotPopulationObserved { units: us } => observe_deploy_slot_host_reading(route: DeploySlotReadOverFleetEdge { subject: subject, context: context }, names: map(us, r => r.unit), slot: slot)
    })
}

// THE DEPLOY SLOT'S HOST HALF, READ ON THE SLOT by the job that runs there, before any key is loaded:
// the slot units the host lists beside the ones its deploy row names, then the same reading the
// converge prints. A host that is not a runner host, or whose units cannot be listed, is an unread
// reading, never a private one. Run anywhere but the deploy slot's own host, the slot's unit is not
// among the manager's and the reading is unread.
fn observe_deploy_slot_host_reading_on_the_slot(slot: RunnerSlotIdentity) -> DeploySlotHostReading {
  let unit = runner_slot_unit_name(slot: slot)
  match runner_host_file_subject(host: slot.host) {
    RunnerHostFileSubjectRefused { cause: c } => DeploySlotHostUnread { unit: unit, cause: c }
    RunnerHostFileSubjectAdmitted { subject: subject } =>
      match run_deploy_slot_read_leg(route: DeploySlotReadOnTheSlot, leg: DeploySlotListUnits) {
        DeploySlotReadLegRefused { reason: why } => DeploySlotHostUnread { unit: unit, cause: concat("systemctl list-units refused: ", why) }
        DeploySlotReadLegRan { exit_code: c, stdout: listed, stderr: err } =>
          if c != 0 {
            DeploySlotHostUnread { unit: unit, cause: join(["systemctl list-units exit=", to_string(c), " ", trim(s: err)], "") }
          } else {
            observe_deploy_slot_host_reading(
              route: DeploySlotReadOnTheSlot,
              names: runner_slot_population_units(desired: subject.desired_units, retired: subject.retired_units, loaded: runner_slot_units_from_list_units(stdout: listed)),
              slot: slot,
            )
          }
      }
  }
}

fn deploy_slot_host_reading_observed(r: DeploySlotHostReading) -> Bool {
  match r {
    DeploySlotHostRead { unit: _, deploy_slot_job_user: _, other_slot_job_users: _, privacy: _ } => true
    DeploySlotHostUnread { unit: _, cause: _ } => false
  }
}

// WHY THE ROLE DROP-IN MAY NOT BE DELIVERED, if it may not: the account is not held, or a deploy
// slot's tree is not yet its account's. The drop-in is then withheld by name, so an apply refuses
// rather than restarting a slot under no user or over a tree another user could have written.
fn deploy_slot_role_dropin_bar(account: DeploySlotAccountStanding, trees: List<DeploySlotTreeStanding>) -> NonEmptyStr? {
  match account {
    DeploySlotAccountMissing { cause: c } => Present { value: join(["the deploy slot's account ", deploy_slot_job_user as String, " is not held: ", c as String], "") as NonEmptyStr }
    _ => {
      let pending = filter(trees, t => !deploy_slot_tree_held(standing: t))
      if length(pending) == 0 { none } else {
        Present { value: join(["the deploy slot's tree is not yet its account's: ", join(map(pending, t => deploy_slot_tree_line(standing: t)), "; ")], "") as NonEmptyStr }
      }
    }
  }
}

type RunnerHostFilesAdmitted {
  files: List<FleetHostFileDesired>
  withheld: List<RunnerHostFileWithheld>
}

fn admit_files_for_deploy_slot(files: List<FleetHostFileDesired>, withheld: List<RunnerHostFileWithheld>, bar: NonEmptyStr?) -> RunnerHostFilesAdmitted {
  match bar {
    Absent => RunnerHostFilesAdmitted { files: files, withheld: withheld }
    Present { value: c } =>
      RunnerHostFilesAdmitted {
        files: filter(files, f => (f.subject as String) != "runner-slot-role-dropin"),
        withheld: concat(withheld, map(filter(files, f => (f.subject as String) == "runner-slot-role-dropin"), f => RunnerHostFileWithheld { subject: f.subject, cause: c })),
      }
  }
}

// A DEPLOY SLOT WHOSE TREE IS NOT HELD IS NOT ACTIVATED: activating it would unmask the old tree under
// the old role. Its outcome is the tree's own, pending or refused, never an activation.
fn deploy_slot_tree_actuation(standing: DeploySlotTreeStanding) -> SlotActuationOutcome? {
  match standing {
    DeploySlotTreeHeld { unit: _ } => none
    DeploySlotTreeRebuilt { unit: _ } => none
    DeploySlotTreePending { unit: u, cause: _ } => Present { value: SlotDrainPending { unit: u, cause: DrainPendingJobRunning } }
    DeploySlotTreeRefused { unit: u, cause: c } => Present { value: SlotActuationRefused { unit: u, step: "deploy-slot-tree", reason: c as String } }
  }
}

fn deploy_slot_tree_line(standing: DeploySlotTreeStanding) -> String {
  match standing {
    DeploySlotTreeHeld { unit: u } => join(["deploy-slot-tree unit=", u as String, " held"], "")
    DeploySlotTreeRebuilt { unit: u } => join(["deploy-slot-tree unit=", u as String, " rebuilt"], "")
    DeploySlotTreePending { unit: u, cause: c } => join(["deploy-slot-tree unit=", u as String, " PENDING ", c as String], "")
    DeploySlotTreeRefused { unit: u, cause: c } => join(["deploy-slot-tree unit=", u as String, " REFUSED ", c as String], "")
  }
}

fn deploy_slot_account_line(standing: DeploySlotAccountStanding) -> String {
  match standing {
    HostHasNoDeploySlot => ""
    DeploySlotAccountPresent { uid: u, passwd_line: l } => join(["deploy-slot-account=present uid=", to_string(u), " passwd=", l as String, "\n"], "")
    DeploySlotAccountCreated { uid: u, passwd_line: l } => join(["deploy-slot-account=created uid=", to_string(u), " passwd=", l as String, "\n"], "")
    DeploySlotAccountMissing { cause: c } => join(["deploy-slot-account=MISSING ", c as String, "\n"], "")
  }
}

fn runner_job_user_uid_reading_line(reading: RunnerJobUserUidReading) -> String {
  match reading {
    JobUserUidObserved { uid: u, passwd_line: l } => join(["job-user-uid=", to_string(u), " passwd=", l as String, "\n"], "")
    JobUserUidUnobserved { cause: c } => join(["job-user-uid=UNOBSERVED ", c as String, "\n"], "")
  }
}

// ── Retired host residue: the ctrl-jobserver ─────────────────────────────────────────────────────

// WHAT THE RETIRED DAEMON LEFT ON A HOST, AS ITS INSTALLER PLACED IT. Cited from gunb-ai/ctrl
// scripts/session-dashboard/host/install-ctrl-jobserver.sh: the daemon at /usr/local/sbin, its unit
// at /etc/systemd/system, its knobs at /etc/default, and the FIFO's directory /var/lib/ctrl/jobserver
// (the FIFO lived inside it; the names are gunbc.host.ctrl_jobserver_residue). Operator
// ruling 2026-10-14 retires it: allocation is declared up front as each slot's CPU ceiling, so
// nothing lends permits at runtime and nothing can leak them.
//
// ABSENT IS THE CONVERGED STATE, NOT A FAILURE. The residue may already have been removed by hand,
// or by gunb-ai/ctrl deleting its installers; a host with no unit and none of the paths is a Noop
// whose readback passes. Whatever is present is stopped, disabled and removed, the manager is
// reloaded if the unit file went, and the SAME observation is re-read: the result is settled only
// when that re-read finds nothing.
type RetiredHostResidue {
  unit: NonEmptyStr
  files: List<String>
  directories: List<String>
}

data ctrl_jobserver_retired_residue: RetiredHostResidue = RetiredHostResidue {
  unit: ctrl_jobserver_unit,
  files: ctrl_jobserver_residue_files,
  directories: ctrl_jobserver_residue_directories,
}

type RetiredResidueObservation
  = ResidueAbsent
  | ResiduePresent { unit_known: Bool, present: List<String> }
  | ResidueUnobservable { cause: String }

// LoadState is the one reading that tells an absent unit from a present one; any other answer than
// not-found is a unit the manager still knows. Each path is settled by the same metadata-then-parent
// rule the desired files use, so "could not look" never reads as "absent".
type ResiduePathReading {
  path: String
  standing: FleetHostFilePathStanding
}

fn classify_retired_residue(load_state_exit: Int, load_state: String, readings: List<ResiduePathReading>) -> RetiredResidueObservation {
  let paths = map(readings, r => r.standing)
  let unreadable = filter(paths, p => match p {
    HostFilePathUnreadable { cause: _ } => true
    HostFilePathPresent => false
    HostFilePathAbsent => false
  })
  if load_state_exit != 0 {
    ResidueUnobservable { cause: join(["systemctl show LoadState exit=", to_string(load_state_exit)], "") }
  } else if length(unreadable) > 0 {
    ResidueUnobservable { cause: join(map(unreadable, p => match p { HostFilePathUnreadable { cause: c } => c HostFilePathPresent => "" HostFilePathAbsent => "" }), "; ") }
  } else {
    let unit_known = trim(s: load_state) != (systemd_unit_load_state_not_found_wire as String)
    let present = flat_map(readings, r => match r.standing {
      HostFilePathPresent => [r.path]
      HostFilePathAbsent => []
      HostFilePathUnreadable { cause: _ } => []
    })
    if !unit_known && length(present) == 0 { ResidueAbsent } else { ResiduePresent { unit_known: unit_known, present: present } }
  }
}

fn observe_retired_residue(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, residue: RetiredHostResidue) -> RetiredResidueObservation
{
  let names = concat(residue.files, residue.directories)
  let readings = map(names, n => ResiduePathReading { path: n, standing: retired_path_standing_over(subject: subject, context: context, path: n) })
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegResidueLoadState { unit: residue.unit }) {
    TypedArgvExecRefused { reason: why } => ResidueUnobservable { cause: why }
    TypedArgvExecConverged { result: r } => classify_retired_residue(load_state_exit: r.exit_code, load_state: r.stdout, readings: readings)
  }
}

type RetiredResidueResult
  = ResidueAlreadyAbsent
  | ResidueRetired
  | ResidueObservedPresent { observation: RetiredResidueObservation }
  | ResidueRetireRefused { step: String, reason: String }
  | ResidueNotAttempted { reason: String }
  | ResidueRetirementWithheld { reason: String }

// One elevated leg; a nonzero exit is a refusal at that step, never swallowed.
fn retire_leg(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, step: String, argv: List<String>) -> String?
{
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegElevated { command: argv }) {
    TypedArgvExecRefused { reason: why } => Present { value: concat(step, concat(": ", why)) }
    TypedArgvExecConverged { result: r } =>
      if r.success { none } else { Present { value: join([step, " exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") } }
  }
}

fn retire_legs_for(residue: RetiredHostResidue, observation: RetiredResidueObservation) -> List<RetireLeg> {
  match observation {
    ResidueAbsent => []
    ResidueUnobservable { cause: _ } => []
    ResiduePresent { unit_known: k, present: ps } =>
      concat(
        if k { [RetireLeg { step: "stop", argv: systemctl_stop_argv(unit: residue.unit) }, RetireLeg { step: "disable", argv: systemctl_disable_now_argv(unit: residue.unit) }] } else { [] },
        concat(
          map(filter(ps, p => any(residue.files, f => f == p)), p => retired_file_removal_leg(path: p)),
          concat(
            map(filter(ps, p => any(residue.directories, d => d == p)), p => RetireLeg { step: concat("remove-tree ", p), argv: ["rm", "-r", "-f", "--one-file-system", "--", p] }),
            [RetireLeg { step: "daemon-reload", argv: systemctl_daemon_reload_argv() }],
          ),
        ),
      )
  }
}

type RetireLeg {
  step: String
  argv: List<String>
}

// ONE RULE FOR A RETIRED PATH, shared by the unit residue above and a superseded managed drop-in
// (retire_superseded_dropin_over): how it is observed -- the metadata probe settled by the
// metadata-then-parent rule, so "could not look" never reads as absent -- and how a retired file is removed.
fn retired_path_standing_over(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, path: String) -> FleetHostFilePathStanding {
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegMetadataProbe { path: path }) {
    TypedArgvExecRefused { reason: why } => HostFilePathUnreadable { cause: why }
    TypedArgvExecConverged { result: m } =>
      observe_fleet_host_file_path(subject: fleet_subject_of(s: subject), context: context, path: path, reading: classify_host_file_metadata(exit_code: m.exit_code, stdout: m.stdout, stderr: m.stderr))
  }
}

fn retired_file_removal_leg(path: String) -> RetireLeg {
  RetireLeg { step: concat("remove ", path), argv: ["rm", "-f", "--", path] }
}

fn run_retire_legs(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, legs: List<RetireLeg>) -> String?
{
  fold(legs, init: none, f: (acc, leg) => match acc {
    Present { value: _ } => acc
    Absent => retire_leg(subject: subject, context: context, step: leg.step, argv: leg.argv)
  })
}

// RETIREMENT WAITS FOR ITS REPLACEMENT TO HOLD (review 80136). The daemon is removed only once the
// unit fragment that stops pointing cargo at its FIFO has landed on this host AND every slot reads
// back that environment; otherwise retiring it would leave units still carrying MAKEFLAGS for a FIFO
// nobody serves while the run reported success. Absent residue is a Noop whatever the gate says.
type ResidueRetirementGate
  = ResidueRetirementAdmitted
  | ResidueRetirementGated { reason: String }

fn residue_retirement_gate(withheld: List<RunnerHostFileWithheld>, fragment_delivered: Bool, slots_effective: Bool) -> ResidueRetirementGate {
  if length(withheld) > 0 {
    ResidueRetirementGated { reason: join(["withheld: ", join(map(withheld, w => w.subject as String), ",")], "") }
  } else if !fragment_delivered {
    ResidueRetirementGated { reason: "the unit fragment is not part of this run" }
  } else if !slots_effective {
    ResidueRetirementGated { reason: "the slot readback does not yet hold the fragment's environment" }
  } else {
    ResidueRetirementAdmitted
  }
}

// THE DECISION BEFORE ANY LEG, pure so its RED is authorable: Present is the final result with no
// actuation, Absent means retire now.
fn retired_residue_precheck(
  observed: RetiredResidueObservation,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  gate: ResidueRetirementGate,
) -> RetiredResidueResult? {
  match observed {
    ResidueAbsent => Present { value: ResidueAlreadyAbsent }
    ResidueUnobservable { cause: c } => Present { value: ResidueNotAttempted { reason: concat("residue unobservable: ", c) } }
    ResiduePresent { unit_known: _, present: _ } =>
      match mode {
        FleetHostFilesObserveOnly => Present { value: ResidueObservedPresent { observation: observed } }
        FleetHostFilesApply =>
          match gate {
            ResidueRetirementGated { reason: why } => Present { value: ResidueRetirementWithheld { reason: why } }
            ResidueRetirementAdmitted =>
              match privilege {
                AdministratorPrivilegeRefused { reason: why } => Present { value: ResidueNotAttempted { reason: concat("administrator privilege refused: ", why) } }
                AdministratorPrivilegeAvailable => none
              }
          }
      }
  }
}

fn converge_retired_residue(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  residue: RetiredHostResidue,
  observed: RetiredResidueObservation,
  gate: ResidueRetirementGate,
) -> RetiredResidueResult
{
  match retired_residue_precheck(observed: observed, mode: mode, privilege: privilege, gate: gate) {
    Present { value: settled } => settled
    Absent =>
      match run_retire_legs(subject: subject, context: context, legs: retire_legs_for(residue: residue, observation: observed)) {
        Present { value: why } => ResidueRetireRefused { step: "retire", reason: why }
        Absent =>
          match observe_retired_residue(subject: subject, context: context, residue: residue) {
            ResidueAbsent => ResidueRetired
            ResidueUnobservable { cause: c } => ResidueRetireRefused { step: "readback", reason: c }
            ResiduePresent { unit_known: k, present: ps } =>
              ResidueRetireRefused { step: "readback", reason: join(["still present after retirement: unit_known=", if k { "yes" } else { "no" }, " paths=", join(ps, ",")], "") }
          }
      }
  }
}

fn retired_residue_settled(result: RetiredResidueResult) -> Bool {
  match result {
    ResidueAlreadyAbsent => true
    ResidueRetired => true
    ResidueObservedPresent { observation: _ } => false
    ResidueRetireRefused { step: _, reason: _ } => false
    ResidueNotAttempted { reason: _ } => false
    ResidueRetirementWithheld { reason: _ } => false
  }
}

// Observe-only succeeds when it could SEE the residue, present or not.
fn retired_residue_observed(result: RetiredResidueResult) -> Bool {
  match result {
    ResidueAlreadyAbsent => true
    ResidueRetired => true
    ResidueObservedPresent { observation: _ } => true
    ResidueRetireRefused { step: _, reason: _ } => false
    ResidueNotAttempted { reason: _ } => false
    ResidueRetirementWithheld { reason: _ } => true
  }
}

fn retired_residue_result_line(result: RetiredResidueResult) -> String {
  join(["retired-residue unit=", ctrl_jobserver_retired_residue.unit as String, " ", match result {
    ResidueAlreadyAbsent => "already-absent"
    ResidueRetired => "retired-and-read-back-absent"
    ResidueObservedPresent { observation: o } => match o {
      ResiduePresent { unit_known: k, present: ps } => join(["PRESENT unit_known=", if k { "yes" } else { "no" }, " paths=", join(ps, ",")], "")
      ResidueAbsent => "absent"
      ResidueUnobservable { cause: c } => concat("UNOBSERVABLE ", c)
    }
    ResidueRetireRefused { step: st, reason: why } => join(["REFUSED step=", st, " ", why], "")
    ResidueNotAttempted { reason: why } => concat("NOT-ATTEMPTED ", why)
    ResidueRetirementWithheld { reason: why } => concat("RETIREMENT-WITHHELD ", why)
  }, "\n"], "")
}

// ── Apply ────────────────────────────────────────────────────────────────────────────────────────

type FleetHostFileConvergeMode
  = FleetHostFilesObserveOnly
  | FleetHostFilesApply

type FleetHostFileOutcome
  = HostFileLeftInPlace
  | HostFileConvergedByWrite { converged: RemoteFileConverged }
  | HostFileWriteRefused { step: String, reason: String }
  | HostFileNotAttempted { reason: String }
  | HostFileNotAppliedObserveOnly

type FleetHostFileResult {
  planned: FleetHostFilePlanned
  outcome: FleetHostFileOutcome
}

// The judgment over the post-write metadata reading, apart from the leg that takes it: the reason a wrong
// mode, a wrong owner or an unreadable reading refuses at the metadata readback even though the bytes read
// back, or nothing when the file is root-only at its desired mode.
fn fleet_host_file_readback_refusal(metadata: FleetHostPathMetadata) -> String? {
  match metadata {
    PathsRootOnly => none
    PathsNotRootOnly { paths: _, detail: d } => Present { value: d }
    PathsUnobservable { reason: r } => Present { value: r }
    PathsNotApplicable => Present { value: "file metadata was not read after the write" }
  }
}

// A write is converged only when its bytes read back AND the published file is root-only at its desired mode. The byte
// read-back is typed_remote_file_write's; the ownership read-back is here, because that carrier
// deliberately claims nothing about metadata it never reads.
fn apply_fleet_host_file(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  planned: FleetHostFilePlanned,
) -> FleetHostFileOutcome
{
  match planned.action {
    HostFileLeaveInPlace => HostFileLeftInPlace
    HostFileActionRefused { reason: r } => HostFileNotAttempted { reason: r }
    HostFileWrite =>
      match create_fleet_host_absent_ancestors(subject: subject, context: context, planned: planned) {
        Present { value: why } => HostFileWriteRefused { step: "ancestor-directories", reason: why }
        Absent => write_fleet_host_file(subject: subject, context: context, planned: planned)
      }
  }
}

// THE ABSENT ANCESTORS ARE CREATED TOP-DOWN AS ROOT, AND THE WHOLE CHAIN IS READ BACK before any byte is
// written: a write lands only beneath directories this run read as root-only, whether they existed or
// were just created. Nothing is created when the observation found every ancestor present.
fn create_fleet_host_absent_ancestors(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  planned: FleetHostFilePlanned,
) -> String?
{
  if length(planned.observation.absent_ancestors) == 0 {
    none
  } else {
    let failed = list_flat_map(planned.observation.absent_ancestors, d =>
      match run_fleet_host_leg(subject: subject, context: context, leg: LegElevated { command: fleet_host_ancestor_directory_argv(path: d) }) {
        TypedArgvExecRefused { reason: why } => [join([d, ": ", why], "")]
        TypedArgvExecConverged { result: r } =>
          if r.exit_code == 0 { [] } else { [join([d, ": exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "")] }
      })
    if length(failed) > 0 {
      Present { value: concat("creating an absent ancestor refused: ", join(failed, "; ")) }
    } else {
      match observe_fleet_host_paths(subject: subject, context: context, paths: fleet_host_path_ancestors(path: planned.file.path as String), kind: "d") {
        PathsRootOnly => none
        PathsNotRootOnly { paths: ps, detail: d } => Present { value: join(["after creation the ancestors do not read back root-only: ", join(ps, ","), " ", d], "") }
        PathsUnobservable { reason: r } => Present { value: concat("after creation the ancestors could not be read back: ", r) }
        PathsNotApplicable => Present { value: "after creation the ancestors were not read back" }
      }
    }
  }
}

fn write_fleet_host_file(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  planned: FleetHostFilePlanned,
) -> FleetHostFileOutcome
{
  match converge_typed_remote_file(
    target: subject.target,
    context: context,
    admission: fleet_host_file_write_admission(file: planned.file),
    mode: planned.file.mode,
    privilege: RemoteFileViaNonInteractiveSudo,
    validation: planned.file.validation,
  ) {
    TypedRemoteFileConvergenceRefused { step: st, reason: why } => HostFileWriteRefused { step: st, reason: why }
    TypedRemoteFileConverged { converged: c } =>
      match fleet_host_file_readback_refusal(metadata: observe_fleet_host_file_mode(subject: subject, context: context, file: planned.file)) {
        Absent => HostFileConvergedByWrite { converged: c }
        Present { value: why } => HostFileWriteRefused { step: "metadata-readback", reason: why }
      }
  }
}

fn fleet_host_file_outcome_settled(outcome: FleetHostFileOutcome) -> Bool {
  match outcome {
    HostFileLeftInPlace => true
    HostFileConvergedByWrite { converged: _ } => true
    HostFileWriteRefused { step: _, reason: _ } => false
    HostFileNotAttempted { reason: _ } => false
    HostFileNotAppliedObserveOnly => false
  }
}

fn runner_host_file_outcome_wire(outcome: FleetHostFileOutcome) -> String {
  match outcome {
    HostFileLeftInPlace => "left-in-place"
    HostFileConvergedByWrite { converged: _ } => "written-and-read-back"
    HostFileWriteRefused { step: st, reason: why } => join(["REFUSED step=", st, " ", why], "")
    HostFileNotAttempted { reason: why } => concat("NOT-ATTEMPTED ", why)
    HostFileNotAppliedObserveOnly => "observe-only"
  }
}

type RunnerHostManagerReload
  = ManagerReloadNotOwed
  | ManagerReloaded
  | ManagerReloadRefused { reason: String }
  | ManagerReloadOwedNotAttempted { reason: String }

fn reload_runner_host_manager(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
) -> RunnerHostManagerReload
{
  match run_fleet_host_leg(subject: fleet_subject_of(s: subject), context: context, leg: LegElevated { command: systemctl_daemon_reload_argv() }) {
    TypedArgvExecRefused { reason: why } => ManagerReloadRefused { reason: why }
    TypedArgvExecConverged { result: r } =>
      if r.success {
        ManagerReloaded
      } else {
        ManagerReloadRefused { reason: join(["daemon-reload exit=", to_string(r.exit_code), " ", trim(s: r.stderr)], "") }
      }
  }
}

fn runner_host_manager_reload_wire(reload: RunnerHostManagerReload) -> String {
  match reload {
    ManagerReloadNotOwed => "not-owed"
    ManagerReloaded => "reloaded"
    ManagerReloadRefused { reason: why } => concat("REFUSED ", why)
    ManagerReloadOwedNotAttempted { reason: why } => concat("OWED-NOT-ATTEMPTED ", why)
  }
}

fn runner_host_privilege_wire(privilege: FleetHostPrivilegeStanding) -> String {
  match privilege {
    AdministratorPrivilegeAvailable => "available"
    AdministratorPrivilegeRefused { reason: why } => concat("REFUSED ", why)
  }
}

// ── The run ──────────────────────────────────────────────────────────────────────────────────────

type RunnerHostFileRun {
  subject: RunnerHostFileSubject
  mode: FleetHostFileConvergeMode
  privilege: FleetHostPrivilegeStanding
  results: List<FleetHostFileResult>
  withheld: List<RunnerHostFileWithheld>
  pre_actuation_reload: RunnerHostManagerReload
  actuation_admission: RunnerHostActuationAdmission
  actuations: List<SlotActuationOutcome>
  residue: RetiredResidueResult
  reload: RunnerHostManagerReload
  slots: RunnerSlotPopulation
  cap_phase: RunnerHostCapPhase
  deploy_account: DeploySlotAccountStanding
  deploy_trees: List<DeploySlotTreeStanding>
  superseded: List<SupersededDropinResult>
  deploy_readings: List<DeploySlotHostReading>
}

fn plan_fleet_host_file(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  file: FleetHostFileDesired,
) -> FleetHostFilePlanned
{
  let observation = observe_fleet_host_file(subject: subject, context: context, file: file)
  FleetHostFilePlanned { file: file, observation: observation, action: fleet_host_file_action(observation: observation) }
}

// The reload decision reads the manager AFTER the writes, so it covers this run's writes and any
// earlier run's write whose reload never happened; the slots are then read again, and that second
// reading is the one the terminal is judged on.
fn runner_host_manager_reload_step(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  before: RunnerSlotPopulation,
) -> RunnerHostManagerReload
{
  if !runner_slot_population_owes_reload(population: before) {
    ManagerReloadNotOwed
  } else {
    match mode {
      FleetHostFilesObserveOnly => ManagerReloadOwedNotAttempted { reason: "observe-only" }
      FleetHostFilesApply =>
        match privilege {
          AdministratorPrivilegeRefused { reason: why } => ManagerReloadOwedNotAttempted { reason: concat("administrator privilege refused: ", why) }
          AdministratorPrivilegeAvailable => reload_runner_host_manager(subject: subject, context: context)
        }
    }
  }
}

// THE SLOT POPULATION IS BROUGHT TO THE COMMITTED WIDTH BEFORE ITS CPU CEILING IS WRITTEN. Apply mode
// activates every desired runner slot (gunbc.runner.runner_slot_actuation activate_runner_slot_over) and
// drains and masks every fabric member and required retiree (drain_and_mask_runner_slot_over) over the
// same administrator edge; observe mode actuates nothing. The per-slot quota divides the host by the
// committed width, so writing it while fewer slots run would hold the live runners to a share sized
// for slots that are not there -- the CPU drop-in is withheld until every actuation settled.
fn runner_host_slot_actuations(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  trees: List<DeploySlotTreeStanding>,
) -> List<SlotActuationOutcome>
{
  match mode {
    FleetHostFilesObserveOnly => []
    FleetHostFilesApply =>
      match privilege {
        AdministratorPrivilegeRefused { reason: why } =>
          map(concat(subject.desired_units, runner_host_drain_units(subject: subject)), u => SlotActuationRefused { unit: u, step: "privilege", reason: why })
        AdministratorPrivilegeAvailable =>
          concat(
            map(subject.desired_units, u =>
              match list_head(xs: list_flat_map(filter(trees, t => (deploy_slot_tree_unit(standing: t) as String) == (u as String)), t => match deploy_slot_tree_actuation(standing: t) { Present { value: o } => [o] Absent => [] })) {
                Present { value: held_back } => held_back
                Absent => activate_runner_slot_over(target: subject.target, context: context, unit: u)
              }),
            map(runner_host_drain_units(subject: subject), u => drain_and_mask_runner_slot_over(target: subject.target, context: context, unit: u)),
          )
      }
  }
}

fn runner_host_drain_units(subject: RunnerHostFileSubject) -> List<NonEmptyStr> {
  concat(subject.fabric_units, filter(subject.retired_units, r => !any(subject.fabric_units, f => (f as String) == (r as String))))
}

type RunnerHostCpuDropinGate {
  files: List<FleetHostFileDesired>
  withheld: List<RunnerHostFileWithheld>
}

fn runner_host_cpu_dropin_gate(
  files: List<FleetHostFileDesired>,
  withheld: List<RunnerHostFileWithheld>,
  actuations: List<SlotActuationOutcome>,
  admission: RunnerHostActuationAdmission,
) -> RunnerHostCpuDropinGate {
  let unsettled = filter(actuations, a => !slot_actuation_settled(o: a))
  let skipped = match admission { ActuationAdmitted => false ActuationSkipped { cause: _ } => true }
  if length(unsettled) == 0 && !skipped {
    RunnerHostCpuDropinGate { files: files, withheld: withheld }
  } else {
    RunnerHostCpuDropinGate {
      files: filter(files, f => (f.path as String) != (gunbc_runner_per_slot_cpu_dropin_path as String)),
      withheld: concat(withheld, [RunnerHostFileWithheld {
        subject: "runner-cpu-dropin" as NonEmptyStr,
        cause: join(["the slot population is not yet at the committed width (", if skipped { "actuations skipped" } else { concat(to_string(length(unsettled)), " actuations unsettled") }, "), so the per-slot quota sized for that width is not written"], "") as NonEmptyStr,
      }]),
    }
  }
}

// ── The slot memory-cap phase ────────────────────────────────────────────────────────────────────

// THE CAP DROP-INS ARE RUNNER-HOST FILES, SIBLINGS OF THE CPU DROP-IN, AND THEIR CONTENT HAS ONE
// AUTHORITY: gunbc.host.host_axis_caps derived_runner_slot_cap_members, the same member list
// gunbc.live_deploy renders for srv1 (its memory members are the unchanged prefix of this list). They are
// written only after the retirement gate (cap_raise_standing) admits, exactly as the srv1 route is
// gated, and a written file is not convergence: each slot is then converged on its LIVE cgroup
// (gunbc.runner.runner_slot_cap_converge), because the drop-in is template-level and a running slot keeps
// the caps it started with.
fn runner_host_cap_files() -> List<FleetHostFileDesired> {
  map(derived_runner_slot_cap_members(), m => FleetHostFileDesired {
    subject: concat("runner-cap-dropin ", m.dropin_path as String) as NonEmptyStr,
    path: m.dropin_path as FilePath,
    content: m.content,
    mode: RemoteFileModeOwnerReadWriteWorldRead,
    validation: NoValidation,
  })
}

fn runner_host_cap_retirement_gate(retired_units: List<NonEmptyStr>, population: RunnerSlotPopulation) -> CapRaiseStanding {
  cap_raise_standing(
    required_retiring: retired_units,
    observation: match population {
      SlotPopulationUnobservable { reason: r } => SurplusSlotsUnobserved { cause: r }
      SlotPopulationObserved { units: us } => {
        let done = map(filter(us, r => match r.standing { SlotRetiredAsDeclared => true SlotRetirementIncomplete { cause: _ } => false SlotTeardownEffective => false SlotReloadPending => false SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberNotARunner { load_state: _ } => false SlotFabricMemberRunsARunner => false SlotUnitNotLoaded { load_state: _ } => false SlotUnitUnread => false }), r => r.unit)
        SurplusSlotsObserved {
          retired: done,
          still_present: filter(retired_units, u => !any(done, d => (d as String) == (u as String))),
        }
      }
    },
  )
}

fn runner_host_cap_gate_cause(standing: CapRaiseStanding) -> String? {
  match standing {
    CapRaiseAdmitted => none
    CapRaiseBlockedPendingRetirement { still_present: sp } => Present { value: concat("surplus slots have not retired: ", join(map(sp, u => u as String), " ")) }
    CapRaiseBlockedIncompleteEvidence { missing: ms } => Present { value: concat("retirement evidence is missing for: ", join(map(ms, u => u as String), " ")) }
    CapRaiseBlockedUnobserved { cause: c } => Present { value: concat("the slot population was not observed: ", c) }
  }
}

type RunnerHostCapPhase
  = CapPhaseNotOwed
  | CapPhaseWithheld { cause: String }
  | CapPhaseObserved { readings: List<SlotCapUnitStanding> }
  // `certified` is what the drain bracket ADMITTED: one typed {unit, registration} record per admitted idle
  // listener, each naming the JIT-minted identity the roster was joined on. It comes from the bracket's own
  // verdict (BracketDrained.certified) and is not re-read, so the receipt can state what was certified for
  // these caps without a second host leg; the receipt RENDERS the record, it does not parse a packed string.
  // The admitted units downstream are derived from these records, so there is one authority, not two lists
  // that must agree. In apply mode this is the only place that identity reaches an operator: the
  // observe-only slot-registration line is deliberately absent here, because an apply must not ask the host
  // who is registered AFTER its own writes have landed.
  | CapPhaseRan { files: List<FleetHostFileResult>, reload: RunnerHostManagerReload, slots: List<SlotCapOutcome>, certified: List<CertifiedListener> }

data runner_host_cap_phase_not_owed: RunnerHostCapPhase = CapPhaseNotOwed

// THE OBSERVED PHASE IS SETTLED WHEN EVERY READING READ. A cap that could not be looked at is never a
// settled no: SlotCapUnread / SlotCapsUnread keep the phase unsettled, so an unreadable cap cannot hide
// behind a mode (§5). AtDesired, Drifted (ReadingsDisagree), Owed (NeedRestart) and Stopped all READ
// something, and reading something IS what observe mode came for -- settledness here names the quality
// of the observation, not whether a change was applied.
fn runner_host_cap_phase_observed_settled(readings: List<SlotCapUnitStanding>) -> Bool {
  all(readings, r => match r.standing {
    SlotCapsUnread { cause: _ } => false
    _ => true
  })
}

fn runner_host_cap_phase_settled(phase: RunnerHostCapPhase) -> Bool {
  match phase {
    CapPhaseNotOwed => true
    CapPhaseWithheld { cause: _ } => false
    CapPhaseObserved { readings: rs } => runner_host_cap_phase_observed_settled(readings: rs)
    CapPhaseRan { files: fs, reload: rl, slots: ss, certified: _ } =>
      all(fs, r => fleet_host_file_outcome_settled(outcome: r.outcome))
        && runner_host_manager_reload_settled(r: rl)
        // THE RUN-LEVEL FOLD (slot_cap_outcome_host_settled), not the per-unit one: a bracket that excluded
        // its own holder, wrote every cap file, reloaded the manager once and read back every drained slot
        // has done all a pass CAN do on this host; its holder is DEFERRED-SELF, owed and named on the wire
        // (row and caps-slots-on-old-shape both list it), to be bracketed by the next pass from another
        // slot. Failing the run for the holder would red every srv3/srv4 converge forever -- the wall the
        // CI gate needs down is not this. What the run must NEVER do is claim the holder converged: that
        // claim belongs only to SlotCapsSelfAtDesired, judged per-unit by slot_cap_outcome_settled.
        && all(ss, o => slot_cap_outcome_host_settled(o: o))
  }
}

// THE OBSERVE VERDICT ON THE CAP PHASE: observe succeeds only if the phase IS an observation and one
// that was fully READ. Withheld (could not look at the population) and any Unread reading (could not
// look at a slot) refuse -- a cap observation that could not be completed is not a success (section 5:
// loud, never a pass). CapPhaseNotOwed refuses in observe too: production's observe arm cannot produce
// it since P4, so one arriving on an observe run record was hand-fabricated -- the base defect, the
// two-valued answer that hides "could not look". CapPhaseRan is the APPLY arm; a Ran phase riding an
// observe run is from another route's run and says nothing about what THIS mode looked at.
// At-desired is NOT required: Owed, Drifted/ReadingsDisagree and Stopped are all fully read, and the
// READING is what observe came for -- a host that owes caps is observed, not failed.
fn runner_host_cap_phase_observed_verdict(phase: RunnerHostCapPhase) -> Bool {
  match phase {
    // An EMPTY readings list observed nothing either -- all([]) is vacuously true, and a zero-reading
    // "observation" is the same hiding as the base's two-valued answer. The featured observation has
    // at least the featured unit; nothing to read is a subject refusal upstream, not a phase.
    CapPhaseObserved { readings: rs } => length(rs) > 0 && runner_host_cap_phase_observed_settled(readings: rs)
    CapPhaseNotOwed => false
    CapPhaseWithheld { cause: _ } => false
    CapPhaseRan { files: _, reload: _, slots: _, certified: _ } => false
  }
}

fn runner_host_cap_phase_text(phase: RunnerHostCapPhase) -> String {
  match phase {
    CapPhaseNotOwed => ""
    CapPhaseWithheld { cause: c } => join(["caps WITHHELD ", c, "\n"], "")
    CapPhaseObserved { readings: rs } =>
      join(
        map(rs, r => concat(slot_cap_standing_wire(unit: r.unit, s: r.standing), "\n")),
        "",
      )
    CapPhaseRan { files: fs, reload: rl, slots: ss, certified: cs } =>
      join([
        join(map(fs, r => runner_host_file_result_line(r: r)), ""),
        "caps-reload=", runner_host_manager_reload_wire(reload: rl), "\n",
        // WHAT THE BRACKET CERTIFIED, named. A cap applied to a JIT-registered listener is only provable
        // against the registration the bracket actually joined on, and that name cannot be recovered later
        // from the slot: the next job re-mints it. So the receipt that says "caps applied" has to say which
        // registration was admitted while it still holds the answer.
        "caps-certified=", if length(cs) == 0 { "none (no listener needed a roster join)" } else { join(map(cs, c => certified_listener_line(c: c)), " ") }, "\n",
        join(map(ss, o => concat(slot_cap_outcome_wire(o: o), "\n")), ""),
        "caps-slots-on-old-shape=", join(map(filter(ss, o => !slot_cap_outcome_settled(o: o)), o => match o { SlotCapsLeftInPlace { unit: u } => u as String SlotCapsRestartedAndRead { unit: u } => u as String SlotCapsSelfAtDesired { unit: u } => u as String SlotCapsSelfDeferred { unit: u, detail: _ } => u as String SlotCapsHolderLedgerRefused { unit: u, cause: _ } => u as String SlotCapsRefused { unit: u, step: _, reason: _ } => u as String }), " "), "\n",
      ], "")
  }
}

// THE AFFECTED POPULATION IS EVERY UNIT A RELOAD WOULD REACH, not only the declared sets: the template
// reload reaches an instance nobody declared. Declared and retired units are ours to drain; a unit
// outside both is an EXTRA, which this route reads (caps, idleness) but never drains, activates or
// retires. An extra is a hazard exactly when the template reload would reach a live cgroup for it (`reach`,
// derived once from its own show block): an extra with no unit file (masked or not-found), inactive and cgroupless has nothing to apply to.
// The lifecycle standing never vetoes that fact: LoadState and ActiveState are independent, so a masked
// but ACTIVE extra is reached however it is classified.
fn runner_host_cap_extras(desired_units: List<NonEmptyStr>, retired_units: List<NonEmptyStr>, population: RunnerSlotPopulation) -> List<NonEmptyStr> {
  match population {
    SlotPopulationUnobservable { reason: _ } => []
    SlotPopulationObserved { units: us } =>
      map(filter(us, r => !any(desired_units, d => (d as String) == (r.unit as String)) && !any(retired_units, d => (d as String) == (r.unit as String)) && (match r.reach { ReachesLiveCgroup => true ReloadInert => false })), r => r.unit)
  }
}

// THE CAP FILES ARE OBSERVED THROUGH THE EXISTING FILE ROUTE FIRST. Settled means files AND live limits,
// so a missing, stale or wrong-mode drop-in is a difference even when the live caps match.
fn runner_host_cap_files_state(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, privilege: FleetHostPrivilegeStanding) -> CapFilesState {
  let planned = map(runner_host_cap_files(), f => fleet_host_file_result(subject: fleet_subject_of(s: subject), context: context, mode: FleetHostFilesObserveOnly, privilege: privilege, file: f))
  let refused = filter(map(planned, r => match r.planned.action { HostFileActionRefused { reason: why } => concat(r.planned.file.path as String, concat(": ", why)) HostFileLeaveInPlace => "" HostFileWrite => "" }), c => c != "")
  if length(refused) > 0 {
    CapFilesUnreadable { cause: join(refused, "; ") }
  } else {
    // One partition: a file either differs or contributes nothing, and the nonempty carrier is built at
    // that split, so a difference with no named file cannot be written.
    let differing: FreeSemigroup<NonEmptyStr>? = fold(planned, init: none, f: (acc, r) =>
      match r.planned.action {
        HostFileWrite => {
          let one = non_empty_singleton(item: r.planned.file.path as NonEmptyStr)
          match acc { Absent => Present { value: one } Present { value: xs } => Present { value: non_empty_append(left: xs, right: one) } }
        }
        HostFileLeaveInPlace => acc
        HostFileActionRefused { reason: _ } => acc
      })
    match differing {
      Absent => CapFilesSettled
      Present { value: ps } => CapFilesDiffer { paths: ps }
    }
  }
}

// A UNIT-FILE CHANGE IS PENDING when any observed instance owes a reload, read from its own reload status
// (never from the lifecycle standing, which a fabric or retirement classification replaces); an instance
// that could not be read is unknown and counts as pending (an unread unit proves nothing about what a reload would load).
// systemd reports an instance's NeedDaemonReload for the template's drop-ins too. The answer is LOCATED:
// the units and which of the two each is, kept typed until the refusal is rendered.
fn runner_host_cap_pending_reloads(population: RunnerSlotPopulation, bracket_units: List<NonEmptyStr>) -> HostPendingReloads {
  match population {
    SlotPopulationUnobservable { reason: r } => HostPopulationUnobserved { reason: r }
    SlotPopulationObserved { units: us } => {
      // One partition: a unit either owes a kind of pending reload or contributes nothing, and the
      // nonempty carrier is built at that split, so an empty "pending" cannot be written.
      let located: FreeSemigroup<UnitPendingReload>? = fold(us, init: none, f: (acc, r) =>
        match slot_reload_pending_kind(status: r.reload, reach: r.reach, in_bracket: any(bracket_units, b => (b as String) == (r.unit as String))) {
          Absent => acc
          Present { value: k } => {
            let one = non_empty_singleton(item: UnitPendingReload { unit: r.unit, kind: k })
            match acc {
              Absent => Present { value: one }
              Present { value: xs } => Present { value: non_empty_append(left: xs, right: one) }
            }
          }
        })
      match located {
        Absent => HostNoReloadPending
        Present { value: xs } => HostReloadsPending { units: xs }
      }
    }
  }
}

// An inert owed reload contributes nothing for a unit the bracket never touches. Inside the bracket's set it
// is kept, typed as inert: the bracket's activation unmasks, enables and starts every unit in that set, so
// there a masked unit stops being inert mid-bracket and its pending change would load onto a live cgroup;
// host_cap_plan withholds the bracket arm on it and nothing else. Fabric members are outside that set by
// construction (desired_runner_slot_members), and the width phase only masks and stops them, never unmasks.
fn slot_reload_pending_kind(status: SlotReloadStatus, reach: SlotReloadReach, in_bracket: Bool) -> PendingReloadKind? {
  match status {
    SlotReloadNotPending => none
    SlotReloadOwed => match reach {
      ReachesLiveCgroup => Present { value: PendingReloadOwed }
      ReloadInert => if in_bracket { Present { value: PendingReloadOwedInertUntilActivated } } else { none }
    }
    SlotReloadUnobserved => Present { value: PendingReloadUnobserved }
  }
}

// THE BAR ON EVERY OTHER RELOAD SITE. A withheld phase means a cap differs (or is unknown) and the host was
// not quiescent; a phase that ran but did not settle left a cap file written, partly applied or unread.
// Either way a later ordinary reload could load a lower-cap file onto a busy slot, so it is barred. Only a
// phase that owed nothing, or ran and settled, leaves the reload sites open.
fn runner_host_cap_phase_bars_reload(phase: RunnerHostCapPhase) -> Bool {
  match phase {
    CapPhaseWithheld { cause: _ } => true
    CapPhaseNotOwed => false
    // An observed-but-unread cap leaves the cap state UNKNOWN exactly as an unsettled ran phase does, so
    // it bars host-wide reloads the same way. A reading that came back (any other standing) answers the
    // question and opens the sites.
    CapPhaseObserved { readings: rs } => !runner_host_cap_phase_observed_settled(readings: rs)
    CapPhaseRan { files: _, reload: _, slots: _, certified: _ } => !runner_host_cap_phase_settled(phase: phase)
  }
}

// ORDER, HOST-WIDE (ruling of clever-crane-830): the drop-ins are template-level, so write + daemon-reload
// re-applies the caps to every running instance and can OOM-kill a busy slot's job. This phase runs
// FIRST, before any ordinary write or reload. The retirement gate, then EVERY loaded instance's live caps
// and idleness and the cap files' own standing are read with no mutation. One busy or unproven slot, an
// unreadable or disagreeing reading, or an unexpected loaded instance refuses the WHOLE host: no write,
// no reload, and a withheld phase BARS the later reload sites too (a pending lower-cap file would
// otherwise be loaded by an unrelated reload). Files and live caps both at desired are left in place.
// Otherwise every declared slot is drained and masked, the files are written, the manager reloaded,
// every slot activated, and each one's live cgroup read back.
// THE OBSERVE ARM OF THE CAP PHASE. It invokes the SAME live read the apply uses,
// read_host_cap_standings_over (systemctl show + the /sys/fs/cgroup file reads, over
// typed_argv_exec_over_fleet_ssh), for the same affected population -- and stops there. It writes no
// drop-in, reloads no manager, drains no slot: the mode chooses the action, never whether the host was
// looked at (§5, and the T2.2 ruling of clever-crane-830: an observation gated behind apply was the
// defect -- observe claiming "not owed" while nothing was read was the two-valued answer that hides
// "could not look"). An unobservable population withholds exactly as apply does: the cause is named,
// never a silent settled.
fn observe_runner_host_cap_phase(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  population: RunnerSlotPopulation,
) -> RunnerHostCapPhase
{
  match population {
    SlotPopulationUnobservable { reason: r } => CapPhaseWithheld { cause: concat("the slot population was not observed: ", r) }
    SlotPopulationObserved { units: _ } => {
      let affected = concat(subject.desired_units, runner_host_cap_extras(desired_units: subject.desired_units, retired_units: subject.retired_units, population: population))
      CapPhaseObserved { readings: read_host_cap_standings_over(target: subject.target, context: context, units: affected, desired: gunbc_runner_slot_desired()) }
    }
  }
}

fn run_runner_host_cap_phase(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  population: RunnerSlotPopulation,
) -> RunnerHostCapPhase
{
  match mode {
    // Observe asks the OBSERVER; the apply never reaches this arm. One route to the reading, whichever
    // mode asked (the old NotOwed arm here claimed a settled no with nothing looked at).
    FleetHostFilesObserveOnly => observe_runner_host_cap_phase(subject: subject, context: context, population: population)
    FleetHostFilesApply =>
      match population {
        SlotPopulationUnobservable { reason: r } => CapPhaseWithheld { cause: concat("the slot population was not observed: ", r) }
        SlotPopulationObserved { units: _ } => {
          let desired = gunbc_runner_slot_desired()
          let extras = runner_host_cap_extras(desired_units: subject.desired_units, retired_units: subject.retired_units, population: population)
          let affected = concat(subject.desired_units, extras)
          let standings = read_host_cap_standings_over(target: subject.target, context: context, units: affected, desired: desired)
          match host_cap_plan(
            standings: standings,
            files: runner_host_cap_files_state(subject: subject, context: context, privilege: privilege),
            extras: extras,
            pending_reloads: runner_host_cap_pending_reloads(population: population, bracket_units: subject.desired_units),
            retirement_cause: runner_host_cap_gate_cause(standing: runner_host_cap_retirement_gate(retired_units: subject.retired_units, population: population)),
          ) {
            HostCapsWithheld { cause: c } => CapPhaseWithheld { cause: c }
            // Nothing was drained and no join was needed, so there is no identity to name: an empty list
            // here is a real answer, not a gap. A non-empty list with no drain would be a fabrication.
            HostCapsLeaveInPlace => CapPhaseRan {
              files: [],
              reload: ManagerReloadNotOwed,
              slots: map(subject.desired_units, u => SlotCapsLeftInPlace { unit: u }),
              certified: [],
            }
            HostCapsWriteInPlace { paths: ps } => write_runner_host_caps_in_place_over(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, units: affected, differing: ps)
            HostCapsDrainWriteRestart =>
              match actions_variable_read(name: runner_host_cap_step_budget_env_name) {
                ActionsVariableAbsent { variable: v, detail: d } => CapPhaseWithheld { cause: join(["host untouched, nothing masked: the enclosing step did not declare its budget (", v, " ", d, ")"], "") }
                ActionsVariablePresent { value: raw_budget } =>
                  match parse_int(s: trim(s: raw_budget)) {
                    Absent => CapPhaseWithheld { cause: join(["host untouched, nothing masked: the declared step budget is not an integer: ", raw_budget], "") }
                    Present { value: seconds } =>
                      match bracket_start_over(policy: runner_host_cap_drain_policy, given: second(count: seconds)) {
                        BracketStartRefused { refusal: rf } => CapPhaseWithheld { cause: join(["host untouched, nothing masked: ", bracket_refusal_wire(r: rf)], "") }
                        BracketStartAt { started: started } => run_runner_host_cap_bracket(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, started: started)
                      }
                  }
              }
          }
        }
      }
  }
}

// WHETHER A MANAGED DROP-IN'S KEYS ARE THE ONES THAT LOAD. systemd merges a unit's drop-ins -- the
// template's and the instance's -- in one file-name order (extdeps.systemd.unit_file
// systemd_drop_in_applies_after), so a loaded drop-in sorting at or after a managed one that sets one of
// its keys wins over it, whatever directory either sits in. Each affected unit's loaded drop-ins are read,
// and a managed drop-in refuses if such a file sets a key it sets, or if that cannot be read. One check for
// every managed drop-in this converge writes or leaves (the deploy slot's role drop-in lost its job user to
// depriv.conf exactly this way, L2 run 40950610061), the in-place cap write included. The one declared
// exemption is a managed INSTANCE drop-in over a template one: that override is the instance's purpose, and
// its order is a claim over the managed population, not a runtime finding.
type DropinOverrideReading
  = DropinsNoLaterSetter
  | DropinsLaterSetter { files: FreeSemigroup<NonEmptyStr> }
  | DropinsUnread { cause: String }

// THE KEYS A DROP-IN SETS, as grep fixed strings `Key=`: every `Key=value` line, skipping section headers
// and comments. Read from the content this converge renders, so the keys are the write's own.
fn dropin_setting_keys(content: String) -> List<NonEmptyStr> {
  list_flat_map(map(split(s: content, delimiter: "\n"), l => trim(s: l)), l =>
    if l == "" || starts_with(s: l, prefix: "#") || starts_with(s: l, prefix: ";") || starts_with(s: l, prefix: "[") || !string_contains(s: l, pattern: "=") { [] }
    else { [concat(trim(s: list_head_or(xs: split(s: l, delimiter: "="), fallback: "")), "=") as NonEmptyStr] })
}

fn list_head_or(xs: List<String>, fallback: String) -> String {
  match list_head(xs: xs) { Present { value: x } => x Absent => fallback }
}

// THE LOADED DROP-INS THAT COULD WIN OVER A WRITTEN FILE: every distinct loaded path, other than a written
// one or an exempt one, that the written file does not apply after -- a later name, or an equal name in
// another directory, which replaces the written file outright.
fn dropins_that_could_override(written: List<NonEmptyStr>, loaded: List<String>, exempt: List<NonEmptyStr>) -> List<NonEmptyStr> {
  let candidates = filter(loaded, p => trim(s: p) != "" && !any(written, w => (w as String) == p) && !any(exempt, e => (e as String) == p) && any(written, w => !systemd_drop_in_applies_after(later_file_name: path_basename(path: w as String), earlier_file_name: path_basename(path: p))))
  map(fold(candidates, init: [], f: (acc, p) => if any(acc, a => a == p) { acc } else { concat(acc, [p]) }), p => p as NonEmptyStr)
}

// `systemctl show --property=DropInPaths` over N units prints one `DropInPaths=` line per unit (empty
// after the `=` when the unit has none). Fewer lines than units is an incomplete read, never "no drop-ins".
fn parse_loaded_dropin_paths(show_stdout: String, unit_count: Int) -> List<String>? {
  let lines = filter(map(split(s: show_stdout, delimiter: "\n"), l => trim(s: l)), l => starts_with(s: l, prefix: "DropInPaths="))
  if length(lines) != unit_count { none } else {
    Present { value: list_flat_map(lines, l => filter(split(s: substring(s: l, start: string_length(s: "DropInPaths="), end: string_length(s: l)), delimiter: " "), p => p != "")) }
  }
}

// grep -l: exit 1 is no candidate setting a key; exit 0 names the files that do; anything else is unread.
fn classify_dropin_override(candidates: List<NonEmptyStr>, exit_code: Int, stdout: String) -> DropinOverrideReading {
  if length(candidates) == 0 { DropinsNoLaterSetter }
  else if exit_code == 1 { DropinsNoLaterSetter }
  else if exit_code == 0 {
    let named: FreeSemigroup<NonEmptyStr>? = fold(filter(map(split(s: stdout, delimiter: "\n"), l => trim(s: l)), l => l != ""), init: none, f: (acc, l) => {
      let one = non_empty_singleton(item: l as NonEmptyStr)
      match acc { Absent => Present { value: one } Present { value: xs } => Present { value: non_empty_append(left: xs, right: one) } }
    })
    match named {
      Absent => DropinsUnread { cause: "grep -l exited 0 and named no file" }
      Present { value: fs } => DropinsLaterSetter { files: fs }
    }
  } else { DropinsUnread { cause: join(["grep -l exited ", to_string(exit_code)], "") } }
}

fn read_dropin_override_over(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, units: List<NonEmptyStr>, written: List<FleetHostFileDesired>, exempt: List<NonEmptyStr>) -> DropinOverrideReading {
  match typed_argv_exec_over_fleet_ssh(target: subject.target, context: context, argv: systemctl_show_properties_argv(units: units, properties: [DropInPathsProperty])) {
    TypedArgvExecRefused { reason: r } => DropinsUnread { cause: concat("systemctl show DropInPaths: ", r) }
    TypedArgvExecConverged { result: shown } =>
      if shown.exit_code != 0 { DropinsUnread { cause: join(["systemctl show DropInPaths exited ", to_string(shown.exit_code)], "") } }
      else {
        match parse_loaded_dropin_paths(show_stdout: shown.stdout, unit_count: length(units)) {
          Absent => DropinsUnread { cause: "systemctl show returned fewer DropInPaths lines than units" }
          Present { value: loaded } => {
            let candidates = dropins_that_could_override(written: map(written, f => f.path as NonEmptyStr), loaded: loaded, exempt: exempt)
            let keys = list_flat_map(written, f => dropin_setting_keys(content: f.content))
            if length(candidates) == 0 { DropinsNoLaterSetter } else {
              match typed_argv_exec_over_fleet_ssh(target: subject.target, context: context, argv: grep_files_with_fixed_strings_argv(patterns: keys, paths: candidates)) {
                TypedArgvExecRefused { reason: r } => DropinsUnread { cause: concat("grep over the later drop-ins: ", r) }
                TypedArgvExecConverged { result: g } => classify_dropin_override(candidates: candidates, exit_code: g.exit_code, stdout: g.stdout)
              }
            }
          }
        }
      }
  }
}

fn cap_in_place_readback_outcome(x: SlotCapUnitStanding) -> SlotCapOutcome {
  match x.standing {
    SlotCapsAtDesired => SlotCapsLeftInPlace { unit: x.unit }
    SlotCapsStopped => SlotCapsLeftInPlace { unit: x.unit }
    SlotCapsNeedRestart { detail: _ } => SlotCapsRefused { unit: x.unit, step: "in-place-readback", reason: slot_cap_standing_wire(unit: x.unit, s: x.standing) }
    SlotCapsReadingsDisagree { detail: _ } => SlotCapsRefused { unit: x.unit, step: "in-place-readback", reason: slot_cap_standing_wire(unit: x.unit, s: x.standing) }
    SlotCapsUnread { cause: _ } => SlotCapsRefused { unit: x.unit, step: "in-place-readback", reason: slot_cap_standing_wire(unit: x.unit, s: x.standing) }
  }
}

fn write_runner_host_caps_in_place_over(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  desired: RunnerSlotDesired,
  units: List<NonEmptyStr>,
  differing: FreeSemigroup<NonEmptyStr>,
) -> RunnerHostCapPhase
{
  let written = filter(runner_host_cap_files(), f => any(non_empty_to_list(xs: differing), d => (d as String) == (f.path as String)))
  let named = join(map(non_empty_to_list(xs: differing), d => d as String), " ")
  match read_dropin_override_over(subject: subject, context: context, units: units, written: written, exempt: []) {
    DropinsUnread { cause: c } => CapPhaseWithheld { cause: join(["host untouched: the in-place cap write (", named, ") could not read whether a later-sorting drop-in sets a key it sets: ", c], "") }
    DropinsLaterSetter { files: fs } => CapPhaseWithheld { cause: join(["host untouched: a later-sorting drop-in sets a key the in-place cap write (", named, ") sets, so the written value might not be the one a reload loads: ", join(map(non_empty_to_list(xs: fs), f => f as String), " ")], "") }
    DropinsNoLaterSetter => {
      let files = map(runner_host_cap_files(), f => fleet_host_file_result(subject: fleet_subject_of(s: subject), context: context, mode: mode, privilege: privilege, file: f))
      let reload = runner_host_pre_actuation_reload(subject: subject, context: context, mode: mode, privilege: privilege, results: files, also_changed: false)
      let written_ok = all(files, r => fleet_host_file_outcome_settled(outcome: r.outcome)) && runner_host_manager_reload_settled(r: reload)
      CapPhaseRan {
        files: files,
        reload: reload,
        slots: if written_ok { map(read_host_cap_standings_over(target: subject.target, context: context, units: units, desired: desired), x => cap_in_place_readback_outcome(x: x)) } else { map(units, u => SlotCapsRefused { unit: u, step: "write", reason: "the in-place cap drop-ins did not converge or the manager reload did not settle; no slot was drained, so none is left masked" }) },
        certified: [],
      }
    }
  }
}

fn run_runner_host_cap_bracket(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  desired: RunnerSlotDesired,
  started: EpochMs,
) -> RunnerHostCapPhase
{
  match bracket_holder_identify(target: subject.target, context: context, units: subject.desired_units) {
    // FAIL CLOSED BEFORE ANY WET EFFECT, AND ONLY WHERE THE ANSWER IS ACTUALLY UNKNOWN (review 86600).
    // The bracket runs on a slot of the host it converges, and it can only exclude the slot it runs on if
    // it can PROVE which one that is (its own cgroup leaf, joined to that unit's current registration and
    // the RUNNER_NAME the Actions job carries). An unverifiable holder means an unverifiable exclusion,
    // and a wrong exclusion is exactly the accident this whole module exists to prevent -- so nothing is
    // masked, nothing is written, and the cause is named.
    HolderUnidentified { cause: c } => CapPhaseWithheld { cause: join(["host untouched, nothing masked: the bracket could not identify the slot it runs on: ", c], "") }
    // A JOB THAT RUNS NOWHERE ON THIS HOST HAS NOTHING TO EXCLUDE, and that is decidable, not a failure:
    // a dispatcher or another host's slot holds no unit here, so the exclusion set is EMPTY and every
    // desired unit is bracketed exactly as before the holder work existed. Refusing here would silently
    // narrow the target -- a host could then only ever be converged from one of its own slots -- with no
    // safety to show for it (DESIGN §5: a decidable case gets its full answer, not a refusal).
    HolderNotOnSubject { why: w } => run_cap_bracket_excluding(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, started: started, holder: HolderNotOnSubject { why: w })
    HolderIdentified { unit: holder } => run_cap_bracket_excluding(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, started: started, holder: HolderIdentified { unit: holder })
  }
}

// THE BRACKET ITSELF, once the holder question is answered: acquire the units the holder may not be
// drained of, drain them, then the post-drain phase. One route for both the on-host (excludes one unit)
// and off-host (excludes nothing) shapes, so the two cases cannot drift apart.
fn run_cap_bracket_excluding(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  desired: RunnerSlotDesired,
  started: EpochMs,
  holder: BracketHolder,
) -> RunnerHostCapPhase
{
  let to_bracket = bracket_units_to_bracket(units: subject.desired_units, holder: holder)
  match acquire_bracket_over(target: subject.target, context: context, host: subject.host as String, units: to_bracket) {
    BracketNotAcquired { refusal: rf } => CapPhaseWithheld { cause: join(["host untouched, nothing masked: ", bracket_refusal_wire(r: rf)], "") }
    BracketAcquired { owned: owned } =>
      match drain_until_quiescent_over(target: subject.target, context: context, observed: to_bracket, owned: owned, policy: runner_host_cap_drain_policy, ticks_left: host_cap_drain_ticks(policy: runner_host_cap_drain_policy), started: started) {
        BracketDrained { certified: certified } => cap_phase_after_drain_over(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, owned: owned, certified: certified, holder: holder)
        BracketAdmissionNotClosed { listeners: ls, causes: cs } => withheld_after_readmit(subject: subject, context: context, owned: owned, head: bracket_refusal_wire(r: BracketRefusedAdmissionNotClosed { listeners: ls, causes: cs }))
        BracketBoundExceeded { busy: bz, unproven: up } => withheld_after_readmit(subject: subject, context: context, owned: owned, head: bracket_refusal_wire(r: BracketRefusedBoundExceeded { busy: bz, unproven: up, waited: runner_host_cap_drain_policy.wait_bound }))
        BracketWaiting { ticks_left: _ } => withheld_after_readmit(subject: subject, context: context, owned: owned, head: "the drain wait ended mid-wait, so nothing was written")
      }
  }
}

// EVERYTHING AFTER A DRAINED BRACKET, as one function so the order is executable on its own: the fresh
// admission reading, then (only if it admits) the first cap-applying effect.
fn cap_phase_after_drain_over(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  desired: RunnerSlotDesired,
  owned: List<NonEmptyStr>,
  certified: List<CertifiedListener>,
  holder: BracketHolder,
) -> RunnerHostCapPhase
{
  // THE FRESH ADMISSION READING GATES THE FIRST CAP-APPLYING EFFECT, FOR EVERY AFFECTED LIVE LISTENER. The
  // write and the reload that follows it are what apply a cap to a running unit, so the three readings
  // are taken again for every observed unit, owned or foreign, before the write and not only before the stop.
  // THE HOLDER IS NOT OBSERVED HERE: it carries a live Runner.Worker BY DESIGN (it is the job running this
  // bracket), so gating on it would either trip the fresh-drain re-check or count it as a foreign live
  // listener and refuse the very write that converges the host -- the exclusion the driver chose is
  // honoured here too, and the holder answers for itself through the live cgroup read-back below.
  let gated = bracket_units_to_bracket(units: subject.desired_units, holder: holder)
  match cap_write_gate_of(closure: runner_host_cap_admission_closure, observed: gated, owned: owned, readings: read_slot_drain_pass_over(target: subject.target, context: context, units: gated)) {
    CapWriteRefused { causes: cs } => withheld_after_readmit(subject: subject, context: context, owned: owned, head: concat("no cap was written, reloaded, stopped or started: the admission was read again immediately before the first cap-applying effect and no longer holds: ", join(cs, "; ")))
    CapWriteAdmitted => write_reload_and_restart_admitted_over(subject: subject, context: context, mode: mode, privilege: privilege, desired: desired, owned: owned, certified: certified, holder: holder)
  }
}

fn write_reload_and_restart_admitted_over(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  desired: RunnerSlotDesired,
  owned: List<NonEmptyStr>,
  certified: List<CertifiedListener>,
  holder: BracketHolder,
) -> RunnerHostCapPhase
{
  // WHICH units to stop-and-restart is DERIVED from what the bracket certified, not carried alongside it as
  // a second list that would have to agree by luck (§3): each record names its own unit and the registration
  // that unit was joined on, so there is one authority for the admitted set.
  let admitted = map(certified, c => c.unit)
  let files = map(runner_host_cap_files(), f => fleet_host_file_result(subject: fleet_subject_of(s: subject), context: context, mode: mode, privilege: privilege, file: f))
  let reload = runner_host_pre_actuation_reload(subject: subject, context: context, mode: mode, privilege: privilege, results: files, also_changed: false)
  let written = all(files, r => fleet_host_file_outcome_settled(outcome: r.outcome)) && runner_host_manager_reload_settled(r: reload)
  // RE-ADMISSION ON THE FAILED-WRITE PATH TOO: a slot left masked would stay out of service.
  let readmitted = if written { [] } else { release_owned_slots_over(target: subject.target, context: context, units: owned) }
  // ONLY AN OWNED UNIT IS ACTIVATED: a unit someone else masked is not unmasked here (activation would
  // lift their mask); its caps are not proven by this run, so it is reported unsettled by name.
  // AN ADMITTED IDLE LISTENER IS STOPPED ONLY AFTER ITS THREE READINGS ARE TAKEN AGAIN (stop_admitted_listener_over);
  // the activation then starts it, which is what applies the caps. A listener whose reading no longer holds
  // is not stopped and is reported by name with the residual; the obligation stays held, so the release finalizer unmasks it.
  let restarts = if written { map(filter(owned, u => any(admitted, a => a == u)), u => stop_admitted_listener_over(target: subject.target, context: context, unit: u)) } else { [] }
  let owned_slots = map(owned, u => if written {
    match first(filter(restarts, r => listener_restart_unit(r: r) == u)) {
      Present { value: r } => match listener_restart_refusal(r: r) {
        Present { value: why } => SlotCapsRefused { unit: u, step: "listener-restart", reason: why }
        Absent => activate_and_read_back_slot_caps_over(target: subject.target, context: context, unit: u, desired: desired)
      }
      Absent => activate_and_read_back_slot_caps_over(target: subject.target, context: context, unit: u, desired: desired)
    }
  } else {
    SlotCapsRefused { unit: u, step: "write", reason: join(["the cap drop-ins did not converge or the manager reload did not settle; ", host_left_wire(l: host_left_of_readmit(units: owned, outcomes: readmitted)), " re-admission: ", join(map(readmitted, o => slot_actuation_outcome_wire(o: o)), " ")], "") }
  })
  let foreign_slots = map(filter(bracket_units_to_bracket(units: subject.desired_units, holder: holder), u => length(filter(owned, o => o == u)) == 0), u =>
    SlotCapsRefused { unit: u, step: "foreign-mask", reason: "masked by someone else before this run: not unmasked and not activated, so its caps are applied when its owner re-admits it and are not proven here" })
  // THE HOLDER IS JUDGED ONLY BY ITS LIVE CGROUP (the parent ruling): the holder counts as converged ONLY
  // when memory.max, memory.swap.max and memory.high all read back from its live cgroup at the desired
  // bytes -- no carve-out for who wrote the drop-in. Value-disagreement is DEFERRED (only a pass dispatched
  // from ANOTHER slot can stop/start the holder), but the deferral is COUNTED on the host and BOUNDED
  // (review 86146, finding 2): the ledger in the holder's slot directory counts deferred passes, past
  // the fleet bound the same reading refuses red, and a converged holder clears the count. A ledger this
  // pass cannot read or write REFUSES red (review 86323, finding 1) and this pass resets it behind that
  // loud step -- see holder_ledger_after_verdict. A FAILED READ of the live cgroup is likewise a
  // REFUSAL, not a deferral (review 86146, finding 1; DESIGN §5: a failure arm refuses, never widens).
  let holder_slots = match holder {
    // UNREACHABLE FROM THE ROUTE: the entry withholds on this arm before any bracket effect, so no drain
    // can complete with an unidentified holder. Refusing loudly here (rather than returning []) keeps the
    // impossible case impossible: a future caller that skipped the entry's check could not add an empty
    // holder row and call the host converged.
    HolderUnidentified { cause: c } => [SlotCapsRefused { unit: "bracket-holder" as NonEmptyStr, step: "holder-unidentified", reason: join(["a bracket completed while the holder was unidentified, which the entry forbids: ", c], "") }]
    HolderNotOnSubject { why: _ } => []
    HolderIdentified { unit: u } => {
  let holder_ledger = holder_deferral_ledger_read(host: subject.host as String, unit: u)
  let holder_slot = slot_cap_holder_standing_over(target: subject.target, context: context, unit: u, desired: desired, ledger: holder_ledger)
  // BOOKKEEPING FOLLOWS THE VERDICT: clear on converged, count on deferred, reset behind the ledger
  // refusal, untouched otherwise. A bookkeeping failure on a DEFERRAL upgrades the holder to a REFUSAL
  // (review 86323, finding 1, same principle DESIGN §5): a deferral whose count cannot be written would
  // be read back at the SAME stale number by every future pass, and a count that never advances can never
  // reach the bound -- that is a permanent green wearing a number, which is exactly the uncounted
  // degradation the bound exists to make impossible. Refusing here is loud, counted, and self-healing:
  // the next pass retries the write from the same number.
  let holder_bookkeeping = holder_ledger_after_verdict(host: subject.host as String, unit: u, verdict: holder_slot, ledger: holder_ledger)
  match holder_bookkeeping {
    Absent => [holder_slot]
    Present { value: why } => [match holder_slot {
      SlotCapsSelfDeferred { unit: du, detail: _ } => SlotCapsHolderLedgerRefused { unit: du, cause: join(["the holder is owed caps but its deferral could not be counted on the host: ", why, " -- a deferral whose count cannot advance is a permanent green the bound can never stop, so it refuses; the next pass retries the count from where this one stopped"], "") }
      other => other
    }]
  }
    }
  }
  let slots = concat(concat(owned_slots, foreign_slots), holder_slots)
  // DISCHARGED ONLY AFTER A READ-BACK THAT THE HOST ADMITS AGAIN; otherwise the obligation stays held.
  // The host-settled fold is used, not the unit-settled one: a DEFERRED SELF is the bracket physically
  // completing everything it CAN do on this host (see slot_cap_outcome_host_settled), so it must not strand
  // the obligation and deny service to every drained slot. It never claims the unit converged -- the wire
  // row for a deferred self says so loudly, and slot_cap_outcome_settled stays false for it.
  let admitting = if written { all(owned_slots, o => slot_cap_outcome_host_settled(o: o)) } else { match host_left_of_readmit(units: owned, outcomes: readmitted) { HostAdmitting => true _ => false } }
  let discharged = if admitting { write_bracket_obligation(host: subject.host as String, units: owned, discharged: true) } else { Present { value: "host not read back as admitting" } }
  // A discharge that did not land is reported, not hidden: release would then find the units unmasked and issue no argv.
  let discharge_note = match discharged { Present { value: w } => if admitting { map(bracket_units_to_bracket(units: subject.desired_units, holder: holder), u => SlotCapsRefused { unit: u, step: "discharge", reason: w }) } else { [] } Absent => [] }
  CapPhaseRan { files: files, reload: reload, slots: concat(slots, discharge_note), certified: certified }
}

fn withheld_after_readmit(subject: RunnerHostFileSubject, context: FleetSshExecutionContext, owned: List<NonEmptyStr>, head: String) -> RunnerHostCapPhase
{
  let restored = release_owned_slots_over(target: subject.target, context: context, units: owned)
  let left = host_left_of_readmit(units: owned, outcomes: restored)
  let discharged = match left { HostAdmitting => write_bracket_obligation(host: subject.host as String, units: owned, discharged: true) HostLeftDrained { units: _ } => Present { value: "not admitting" } }
  CapPhaseWithheld { cause: join([head, "; ", host_left_wire(l: left), " restored=", join(map(restored, o => slot_actuation_outcome_wire(o: o)), " "), "; ", release_envelope_wire(policy: runner_host_cap_drain_policy), match discharged { Present { value: w } => concat(" obligation-discharge: ", w) Absent => "" }], "") }
}

// ORDER: privilege, observe every file, write the ones that need it, read every slot, reload if the
// manager owes one, read every slot again. The privilege leg runs FIRST and gates every write, so a host
// where the declared administrator cannot sudo reports that by name. Observation does not need
// privilege and still runs, so an observe-only dispatch against such a host still says what WOULD be
// written and what the slots hold.
fn fleet_host_file_result(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  file: FleetHostFileDesired,
) -> FleetHostFileResult
{
  fleet_host_file_result_of_planned(subject: subject, context: context, mode: mode, privilege: privilege, planned: plan_fleet_host_file(subject: subject, context: context, file: file))
}

fn fleet_host_file_result_of_planned(
  subject: FleetHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  planned: FleetHostFilePlanned,
) -> FleetHostFileResult
{
  let p = planned
  FleetHostFileResult {
    planned: p,
    outcome: match mode {
      FleetHostFilesObserveOnly => HostFileNotAppliedObserveOnly
      FleetHostFilesApply =>
        match privilege {
          AdministratorPrivilegeRefused { reason: why } => HostFileNotAttempted { reason: concat("administrator privilege refused: ", why) }
          AdministratorPrivilegeAvailable => apply_fleet_host_file(subject: subject, context: context, planned: p)
        }
    },
  }
}

// A WRITTEN UNIT FILE IS LOADED BEFORE ANY SLOT IS ACTUATED. When this run wrote a file, the manager
// is reloaded first, so an activation starts the unit the fragment just declared rather than a stale
// one. The answer is the run's own typed reload standing (RunnerHostManagerReload), never a slot result.
fn runner_host_pre_actuation_reload(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  mode: FleetHostFileConvergeMode,
  privilege: FleetHostPrivilegeStanding,
  results: List<FleetHostFileResult>,
  also_changed: Bool,
) -> RunnerHostManagerReload
{
  let wrote = also_changed || any(results, r => match r.outcome {
    HostFileConvergedByWrite { converged: _ } => true
    HostFileLeftInPlace => false
    HostFileWriteRefused { step: _, reason: _ } => false
    HostFileNotAttempted { reason: _ } => false
    HostFileNotAppliedObserveOnly => false
  })
  if !wrote { ManagerReloadNotOwed } else {
    match mode {
      FleetHostFilesObserveOnly => ManagerReloadOwedNotAttempted { reason: "observe-only" }
      FleetHostFilesApply =>
        match privilege {
          AdministratorPrivilegeRefused { reason: why } => ManagerReloadOwedNotAttempted { reason: concat("administrator privilege refused: ", why) }
          AdministratorPrivilegeAvailable => reload_runner_host_manager(subject: subject, context: context)
        }
    }
  }
}

fn runner_host_manager_reload_settled(r: RunnerHostManagerReload) -> Bool {
  match r {
    ManagerReloadNotOwed => true
    ManagerReloaded => true
    ManagerReloadRefused { reason: _ } => false
    ManagerReloadOwedNotAttempted { reason: _ } => false
  }
}

// NO SLOT IS STARTED FROM AN UNRELOADED OR UNWRITTEN UNIT FILE. In apply mode the actuations run only
// when every unit-file write settled and the pre-actuation reload settled; otherwise they are skipped
// whole, the CPU drop-in is withheld with them, and the run refuses on the cause.
type RunnerHostActuationAdmission
  = ActuationAdmitted
  | ActuationSkipped { cause: String }

fn runner_host_actuation_admission(results: List<FleetHostFileResult>, pre_reload: RunnerHostManagerReload) -> RunnerHostActuationAdmission {
  let unsettled = filter(results, r => !fleet_host_file_outcome_settled(outcome: r.outcome))
  if length(unsettled) > 0 {
    ActuationSkipped { cause: join(["unit files not converged: ", join(map(unsettled, r => r.planned.file.subject as String), ",")], "") }
  } else if !runner_host_manager_reload_settled(r: pre_reload) {
    ActuationSkipped { cause: concat("the pre-actuation reload did not settle: ", runner_host_manager_reload_wire(reload: pre_reload)) }
  } else {
    ActuationAdmitted
  }
}

fn run_runner_host_files(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  files: List<FleetHostFileDesired>,
  withheld: List<RunnerHostFileWithheld>,
  mode: FleetHostFileConvergeMode,
  per_slot: HardwareThreadCount,
) -> RunnerHostFileRun
{
  let privilege = observe_fleet_host_administrator_privilege(subject: fleet_subject_of(s: subject), context: context)
  let account = converge_deploy_slot_account(subject: subject, context: context, mode: mode, privilege: privilege)
  let trees = converge_deploy_slot_trees(subject: subject, context: context, mode: mode, privilege: privilege, account: account)
  let admitted = admit_files_for_deploy_slot(files: files, withheld: withheld, bar: deploy_slot_role_dropin_bar(account: account, trees: trees))
  run_runner_host_files_admitted(subject: subject, context: context, files: admitted.files, withheld: admitted.withheld, mode: mode, per_slot: per_slot, privilege: privilege, account: account, trees: trees)
}

// THE RUN OVER THE FILES THE DEPLOY SLOT'S ACCOUNT ADMITS.
fn run_runner_host_files_admitted(
  subject: RunnerHostFileSubject,
  context: FleetSshExecutionContext,
  files: List<FleetHostFileDesired>,
  withheld: List<RunnerHostFileWithheld>,
  mode: FleetHostFileConvergeMode,
  per_slot: HardwareThreadCount,
  privilege: FleetHostPrivilegeStanding,
  account: DeploySlotAccountStanding,
  trees: List<DeploySlotTreeStanding>,
) -> RunnerHostFileRun
{
  // ORDER (review on ff67e67949): every file but the CPU drop-in is written first and the manager
  // reloaded, so a fresh host has the unit fragment before a slot is activated and converges in one
  // pass; then the slots are actuated; only then is the CPU drop-in written, gated on every actuation
  // having settled, so no host carries the committed-width quota over fewer running slots.
  let residue_observed = observe_retired_residue(subject: subject, context: context, residue: ctrl_jobserver_retired_residue)
  let early_expect = runner_slot_expectation(per_slot: per_slot, fragment_delivered: runner_host_files_deliver_fragment(files: files), residue_absent: match residue_observed {
    ResidueAbsent => true
    ResiduePresent { unit_known: _, present: _ } => false
    ResidueUnobservable { cause: _ } => false
  })
  // THE CAP PHASE RUNS BEFORE ANY WRITE OR RELOAD: the template reload is host-wide, so every reload
  // below is barred when the phase withholds.
  // THE OBSERVATION IS NOT GATED BEHIND THE APPLY (defect of record, T2.2): BOTH modes read the live slot
  // caps through the same read_host_cap_standings_over route; the mode chooses only what the phase may DO.
  // Observe reads per-slot standings and writes nothing — a mode that answered "caps not owed" without
  // looking was a two-valued answer hiding "could not look" (§5). The population fold is read once here and
  // shared by both arms; apply's behavior is byte-equal (same reads, same order).
  let early_population = observe_runner_slot_population(subject: subject, context: context, expect: early_expect)
  let cap_phase = match mode {
    FleetHostFilesObserveOnly => observe_runner_host_cap_phase(subject: subject, context: context, population: early_population)
    FleetHostFilesApply => run_runner_host_cap_phase(subject: subject, context: context, mode: mode, privilege: privilege, population: early_population)
  }
  let reload_barred = runner_host_cap_phase_bars_reload(phase: cap_phase)
  let unit_files = filter(files, f => (f.path as String) != (gunbc_runner_per_slot_cpu_dropin_path as String))
  let unit_results = map(unit_files, f => runner_host_file_result_guarded(subject: subject, context: context, mode: mode, privilege: privilege, file: f, managed: files))
  let superseded = concat(
    map(runner_host_superseded_dropin_paths(host: subject.host), p => retire_superseded_dropin_over(subject: subject, context: context, mode: mode, privilege: privilege, path: p)),
    map(runner_host_control_shadow_paths(subject: subject), p => retire_control_shadow_over(subject: subject, context: context, mode: mode, privilege: privilege, caps_settled: !reload_barred, path: p)),
  )
  let pre_reload = if reload_barred { ManagerReloadOwedNotAttempted { reason: "the slot memory-cap phase withheld the host (see caps WITHHELD); no daemon-reload may reach running slots" } } else { runner_host_pre_actuation_reload(subject: subject, context: context, mode: mode, privilege: privilege, results: unit_results, also_changed: any(superseded, r => superseded_dropin_removed(r: r))) }
  let admission = match mode {
    FleetHostFilesObserveOnly => ActuationAdmitted
    FleetHostFilesApply => runner_host_actuation_admission(results: unit_results, pre_reload: pre_reload)
  }
  let actuations = match admission {
    ActuationAdmitted => runner_host_slot_actuations(subject: subject, context: context, mode: mode, privilege: privilege, trees: trees)
    ActuationSkipped { cause: _ } => []
  }
  let gated = runner_host_cpu_dropin_gate(files: files, withheld: withheld, actuations: actuations, admission: admission)
  let cpu_results = map(filter(gated.files, f => (f.path as String) == (gunbc_runner_per_slot_cpu_dropin_path as String)), f => runner_host_file_result_guarded(subject: subject, context: context, mode: mode, privilege: privilege, file: f, managed: files))
  let results = concat(unit_results, cpu_results)
  let fragment_delivered = runner_host_files_deliver_fragment(files: gated.files)
  // THE READ-BACK EXPECTATION CARRIES EACH ROLE SLOT'S ENVIRONMENT, so a slot whose loaded job user is not
  // its role's is not effective (runner_host_role_environments). The early reading above, which the cap
  // phase consumes, does not: whether a slot's role loaded is this run's finding, not a cap precondition.
  let expect = runner_slot_expectation_with_roles(host: subject.host, expect: runner_slot_expectation(per_slot: per_slot, fragment_delivered: fragment_delivered, residue_absent: match residue_observed {
    ResidueAbsent => true
    ResiduePresent { unit_known: _, present: _ } => false
    ResidueUnobservable { cause: _ } => false
  }))
  let before = observe_runner_slot_population(subject: subject, context: context, expect: expect)
  let reload = if reload_barred && runner_slot_population_owes_reload(population: before) { ManagerReloadOwedNotAttempted { reason: "the slot memory-cap phase withheld the host (see caps WITHHELD); no daemon-reload may reach running slots" } } else if reload_barred { ManagerReloadNotOwed } else { runner_host_manager_reload_step(subject: subject, context: context, mode: mode, privilege: privilege, before: before) }
  let slots = match reload {
    ManagerReloaded => observe_runner_slot_population(subject: subject, context: context, expect: expect)
    ManagerReloadNotOwed => before
    ManagerReloadRefused { reason: _ } => before
    ManagerReloadOwedNotAttempted { reason: _ } => before
  }
  let gate = residue_retirement_gate(
    withheld: gated.withheld,
    fragment_delivered: fragment_delivered && all(results, r => fleet_host_file_outcome_settled(outcome: r.outcome)),
    slots_effective: runner_slot_population_effective(population: slots),
  )
  RunnerHostFileRun {
    subject: subject,
    mode: mode,
    privilege: privilege,
    results: results,
    withheld: gated.withheld,
    pre_actuation_reload: pre_reload,
    actuation_admission: admission,
    actuations: actuations,
    residue: converge_retired_residue(subject: subject, context: context, mode: mode, privilege: privilege, residue: ctrl_jobserver_retired_residue, observed: residue_observed, gate: gate),
    reload: reload,
    slots: slots,
    cap_phase: cap_phase,
    deploy_account: account,
    deploy_trees: trees,
    superseded: superseded,
    deploy_readings: observe_deploy_slot_host_readings(subject: subject, context: context, slots: slots),
  }
}

fn runner_host_file_run_mode_wire(mode: FleetHostFileConvergeMode) -> String {
  match mode {
    FleetHostFilesObserveOnly => "observe"
    FleetHostFilesApply => "apply"
  }
}

fn runner_host_file_planned_write(p: FleetHostFilePlanned) -> Bool {
  match p.action {
    HostFileWrite => true
    HostFileLeaveInPlace => false
    HostFileActionRefused { reason: _ } => false
  }
}

fn runner_host_file_planned_refused(p: FleetHostFilePlanned) -> Bool {
  match p.action {
    HostFileActionRefused { reason: _ } => true
    HostFileWrite => false
    HostFileLeaveInPlace => false
  }
}

// WHAT EACH MODE MAY CALL SUCCESS. Observe succeeds when it could SEE everything -- privilege probed,
// every file classified, every slot unit read -- whatever it saw; drift is its finding, not its failure.
// Apply succeeds only when the host now holds every declared file, root-only, and EVERY slot unit
// reports the declared teardown with nothing pending a reload.
fn runner_host_file_run_succeeded(run: RunnerHostFileRun) -> Bool {
  match run.mode {
    FleetHostFilesObserveOnly =>
      (match run.privilege {
        AdministratorPrivilegeAvailable => true
        AdministratorPrivilegeRefused { reason: _ } => false
      })
        && !any(run.results, r => runner_host_file_planned_refused(p: r.planned))
        && retired_residue_observed(result: run.residue)
        && runner_slot_population_read_completely(population: run.slots)
        // THE CAP PHASE IS CONSUMED HERE (manager ruling, review 5588645431): the phase is the last
        // thing observe came for, so a run whose cap observation was withheld or any of it unread
        // REFUSES -- it must not print OBSERVED-UNREAD and still exit success.
        && runner_host_cap_phase_observed_verdict(phase: run.cap_phase)
        && all(run.superseded, r => superseded_dropin_observed(r: r))
        && all(run.deploy_readings, r => deploy_slot_host_reading_observed(r: r))
    FleetHostFilesApply =>
      all(run.results, r => fleet_host_file_outcome_settled(outcome: r.outcome))
        && length(run.withheld) == 0
        && runner_host_manager_reload_settled(r: run.pre_actuation_reload)
        && (match run.actuation_admission { ActuationAdmitted => true ActuationSkipped { cause: _ } => false })
        && all(run.actuations, a => slot_actuation_settled(o: a))
        && retired_residue_settled(result: run.residue)
        && (match run.reload {
          ManagerReloadNotOwed => true
          ManagerReloaded => true
          ManagerReloadRefused { reason: _ } => false
          ManagerReloadOwedNotAttempted { reason: _ } => false
        })
        && runner_slot_population_effective(population: run.slots)
        && runner_host_cap_phase_settled(phase: run.cap_phase)
        && all(run.superseded, r => superseded_dropin_settled(r: r))
        && all(run.deploy_readings, r => deploy_slot_host_walls_hold(r: r))
  }
}

fn runner_host_file_result_line(r: FleetHostFileResult) -> String {
  join([
    "file ", r.planned.file.subject as String,
    " path=", r.planned.file.path as String,
    " content=", runner_host_file_standing_wire(standing: r.planned.observation.content),
    " file-metadata=", runner_host_path_metadata_wire(m: r.planned.observation.file_metadata),
    " ancestors=", runner_host_path_metadata_wire(m: r.planned.observation.ancestors),
    " absent-ancestors=", if length(r.planned.observation.absent_ancestors) == 0 { "none" } else { join(r.planned.observation.absent_ancestors, ",") },
    " action=", runner_host_file_action_wire(action: r.planned.action),
    " outcome=", runner_host_file_outcome_wire(outcome: r.outcome),
    "\n",
  ], "")
}

fn runner_slot_population_text(population: RunnerSlotPopulation) -> String {
  match population {
    SlotPopulationUnobservable { reason: r } => concat("slots UNOBSERVABLE ", concat(r, "\n"))
    SlotPopulationObserved { units: us } =>
      join([
        "slots observed=", to_string(length(us)),
        " effective=", to_string(length(filter(us, r => match r.standing { SlotTeardownEffective => true SlotReloadPending => false SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberNotARunner { load_state: _ } => false SlotFabricMemberRunsARunner => false SlotUnitNotLoaded { load_state: _ } => false SlotRetiredAsDeclared => false SlotRetirementIncomplete { cause: _ } => false SlotUnitUnread => false }))),
        " retired-as-declared=", to_string(length(filter(us, r => match r.standing { SlotRetiredAsDeclared => true SlotRetirementIncomplete { cause: _ } => false SlotTeardownEffective => false SlotReloadPending => false SlotTeardownNotEffective { kill_mode: _, exit_type: _ } => false SlotAllocationNotEffective { detail: _ } => false SlotFabricMemberNotARunner { load_state: _ } => false SlotFabricMemberRunsARunner => false SlotUnitNotLoaded { load_state: _ } => false SlotUnitUnread => false }))),
        "\n",
        join(map(us, r => join(["slot ", r.unit as String, " ", runner_slot_unit_standing_wire(standing: r.standing), "\n"], "")), ""),
      ], "")
  }
}

fn runner_host_file_run_text(run: RunnerHostFileRun) -> String {
  join([
    "host=", run.subject.host as String,
    " mode=", runner_host_file_run_mode_wire(mode: run.mode),
    " principal=", run.subject.target.principal as String,
    " endpoint=", ssh_target_wire(target: run.subject.target) as String, "\n",
    "administrator-privilege=", runner_host_privilege_wire(privilege: run.privilege), "\n",
    deploy_slot_account_line(standing: run.deploy_account),
    join(map(run.deploy_trees, t => concat(deploy_slot_tree_line(standing: t), "\n")), ""),
    join(map(run.results, r => runner_host_file_result_line(r: r)), ""),
    join(map(run.superseded, r => concat(superseded_dropin_line(r: r), "\n")), ""),
    "planned-writes=", to_string(length(filter(run.results, r => runner_host_file_planned_write(p: r.planned)))), "\n",
    "pre-actuation-reload=", runner_host_manager_reload_wire(reload: run.pre_actuation_reload), "\n",
    match run.actuation_admission { ActuationAdmitted => "" ActuationSkipped { cause: c } => join(["actuations SKIPPED ", c, "\n"], "") },
    join(map(run.actuations, a => concat(slot_actuation_outcome_wire(o: a), "\n")), ""),
    runner_host_cap_phase_text(phase: run.cap_phase),
    retired_residue_result_line(result: run.residue),
    "manager-reload=", runner_host_manager_reload_wire(reload: run.reload), "\n",
    runner_slot_population_text(population: run.slots),
    join(map(run.deploy_readings, r => concat(deploy_slot_host_reading_line(r: r), "\n")), ""),
    "terminal=", if runner_host_file_run_succeeded(run: run) { "succeeded" } else { "REFUSED" }, "\n",
  ], "")
}

// ── The CI entries ───────────────────────────────────────────────────────────────────────────────

data runner_host_file_converge_attempt_raw: String = "runner-host-file-converge-ci"

// ONE HOST PER RUN, NAMED BY THE DISPATCH. The fleet-converge workflow already carries the operator's
// chosen host in FLEET_CONVERGE_EXPECTED_HOST; an unset host refuses rather than fanning a root-file
// write across the fleet from an empty variable.
fn runner_host_file_ci_wet(mode: FleetHostFileConvergeMode) -> ProcessExit
{
  // THE SPLIT APPLIES TO THE ACT MODE, NOT THE OBSERVER (operator ruling 2026-10-24, run 40085967610).
  // In OBSERVE mode the run reports on the host the job is pinned to -- reading one's own host is not a
  // drain, and plan mode has always observed the executor. In APPLY mode the run writes AND drains the
  // bracket on a host it must NOT be standing on: the subject arrives as its own input, and the typed
  // precheck refuses before the subject admission, the ssh context, and every leg.
  match mode {
    FleetHostFilesObserveOnly => runner_host_file_ci_wet_hosted(
      mode: mode,
      host: match actions_variable_read(name: fleet_converge_expected_host_env_name) {
        ActionsVariablePresent { value: v } => Present { value: v }
        ActionsVariableAbsent => none
      },
    )
    FleetHostFilesApply => match fleet_converge_split_read() {
      SplitRefused { reason: why } => exit_failure(reason: fleet_converge_split_refusal_line(reason: why))
      SplitOk { executor_runner_name: _, subject_host: subject } =>
        runner_host_file_ci_wet_hosted(mode: mode, host: Present { value: subject })
    }
  }
}

fn runner_host_file_ci_wet_hosted(mode: FleetHostFileConvergeMode, host: String?) -> ProcessExit
{
  match host {
    Absent =>
      exit_failure(reason: "runner_host_file_converge: the host was not named; one host per run, named by the dispatch (apply mode names its subject in FLEET_CONVERGE_SUBJECT_HOST)")
    Present { value: raw_host } =>
      match runner_host_file_subject(host: raw_host as HostIdentity) {
        RunnerHostFileSubjectRefused { cause: c } => exit_failure(reason: c)
        RunnerHostFileSubjectAdmitted { subject: subject } =>
          match prepare_fleet_ssh_agent_context(attempt_raw: runner_host_file_converge_attempt_raw) {
            FleetSshContextRefused { cause: c } => exit_failure(reason: c)
            FleetSshContextReady { context: context, receipt: context_receipt } => {
              let uid_reading = observe_runner_job_user_uid(subject: subject, context: context)
              // THE CONVERGE'S OWN EFFECT EDGE reads the receipt, once, at this leg's read time.
              match runner_host_file_desired_population_from_uid_reading(host: raw_host as HostIdentity, reading: uid_reading, receipt: runner_user_session_receipt_observed(host: raw_host as HostIdentity)) {
                RunnerHostFilesDesiredRefused { cause: c } => exit_failure(reason: c as String)
                RunnerHostFilesDesired { files: files, withheld: withheld } =>
                  match runner_slot_cpu_desired(host: raw_host as HostIdentity) {
                    SlotCpuRefused { cause: c } => exit_failure(reason: c as String)
                    SlotCpuDesired { per_slot: per_slot, file: _ } => {
                  let run = run_runner_host_files(subject: subject, context: context, files: files, withheld: withheld, mode: mode, per_slot: per_slot)
                  let body = join([
                    "runner_host_file_converge probed_at=", probed_at_word(reading: clock_now_probed_at()) as String, "\n",
                    context_receipt,
                    runner_job_user_uid_reading_line(reading: uid_reading),
                    runner_host_current_registration_line(mode: mode, target: subject.target, context: context, units: subject.desired_units),
                    runner_host_withdraw_observe_line_for(host: raw_host, target: subject.target, context: context, units: subject.desired_units),
                    join(map(withheld, w => join(["withheld subject=", w.subject as String, " cause=", w.cause as String, "\n"], "")), ""),
                    runner_host_file_run_text(run: run),
                  ], "")
                  let w = Filesystem.Write(path: gunbc_ci_runner_host_file_converge_receipt_path, content: body)
                  if w.success == false {
                    exit_failure(reason: join(["runner_host_file_converge: receipt write failed: ", w.error, "\n", body], ""))
                  } else if runner_host_file_run_succeeded(run: run) == false {
                    exit_failure(reason: body)
                  } else {
                    ExitSuccess
                  }
                    }
                  }
              }
            }
          }
      }
  }
}

fn runner_host_file_observe_ci_wet() -> ProcessExit
{
  runner_host_file_ci_wet(mode: FleetHostFilesObserveOnly)
}

fn runner_host_file_converge_ci_wet() -> ProcessExit
{
  runner_host_file_ci_wet(mode: FleetHostFilesApply)
}

// THE CURRENT REGISTRATION IDENTITY EACH SLOT'S LISTENER IS RUNNING UNDER, read from the host by
// gunbc.runner.runner_slot_actuation.slot_current_registration_over_unit over the same
// administrator-over-fleet-SSH edge (ssh.Session.ExecPortableWords) every other slot reading uses.
//
// WHY THE FIELD EXISTS. A fleet listener registers under a JIT-minted suffix
// (srv3-02-1792728034-201414), never under the slot's own name, and the suffix changes per job -- so the
// name a listener registered under is a fact about the host that no slot name can supply. The cap bracket
// needs that identity to join the organization roster on it, and today does not have it: the bracket still
// joins on the slot's BARE name, which is why every running idle listener is reported as having no
// registration on the roster and caps are withheld. THIS CHANGE DOES NOT FIX THAT JOIN; it lands only the
// read, so the bracket's later change can consume it. When that change lands it must call
// slot_current_registration_over_unit rather than derive the identity again, and the line should STAY empty
// in apply mode: the bracket will read the identity itself in its cap phase and carry it in its own verdict,
// so a second read here would be a redundant leg on the way to a WRITE, reading the host after writes landed.
//
// SO THE ONE CALLER OF THIS READ, AT THIS HEAD, IS THIS RECEIPT. No consumer exists in the bracket yet; the
// claim made here is about the read's SHAPE, which a real host has to confirm and a witness cannot: the live
// runner_host_file_observe receipt from a srv3/srv4 host is the §3 inhabitance evidence that the host holds
// the suffixed shape. A slot whose identity cannot be read appears as an unreadable naming the unit; the read
// never falls back to the slot's name, so neither does the receipt.
//
// THE MODE DECISION, SEPARATED FROM THE READ. Asked of the host in OBSERVE mode only. In observe mode nothing
// else in this route asks who is registered, so the receipt is the only place an operator can see the identity
// the bracket WOULD join on. In apply mode the line is empty because nothing in this change consumes it there,
// and an unrequired read on the way to a WRITE would report an identity that this run's own writes may have
// just changed.
fn runner_host_current_registration_line(mode: FleetHostFileConvergeMode, target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>) -> String {
  match mode {
    FleetHostFilesObserveOnly => runner_host_current_registration_text(target: target, context: context, units: units)
    FleetHostFilesApply => ""
  }
}

fn runner_host_current_registration_text(target: SshTarget, context: FleetSshExecutionContext, units: List<NonEmptyStr>) -> String {
  join(map(units, u => match slot_current_registration_over_unit(target: target, context: context, unit: u) {
    UnitRegistrationRead { unit: un, instance: _, name: n } => join(["slot-registration unit=", un as String, " agent_name=", n as String, "\n"], "")
    // only two answers are reachable from this read: it asks the host for every unit it is given. A slot
    // that is not running an idle listener still answers with what its tree holds, which is what an
    // operator wants here; the bracket's OWN pass is what decides not to consult the roster for it.
    UnitRegistrationUnreadable { unit: un, cause: c } => join(["slot-registration unit=", un as String, " UNREADABLE ", c, "\n"], "")
  }), "")
}

// THE FINALIZER OF THE CAP BRACKET, RUN AFTER THE CONVERGE STEP WHATEVER ITS FATE (the workflow step is
// `if: always()`, which also runs when the job is cancelled or times out). A converge step killed by its
// timeout after masking leaves the masks in place; this entry re-admits the bracket's OWNED units and reads
// each back. Owned = the host's declared-live slots (subject.desired_units): a declared-masked slot
// (fabric) is never in that set, so it stays masked by construction. Selection is the converge step's own:
// the same dispatch-named host, the same subject. Re-admitting an already-admitting slot is a read-back
// no-op. A release that cannot read the host back as admitting exits failure and names what it left.
fn runner_host_cap_release_ci_wet() -> ProcessExit
{
  // THE SPLIT CARRIED THROUGH THE FINALIZER: the obligation lives in the EXECUTOR's job temp (this job
  // wrote it), but the units it re-admits live on the SUBJECT -- so when the dispatch named one, the
  // release resolves its subject from SUBJECT_HOST, the same host the converge step acted on. Without a
  // named subject it falls back to the dispatch host, the pre-split behavior. A converge step that died
  // before the bracket opened owes nothing: the obligation read comes back absent and the release is a
  // settled no-op, which is exactly what a refused split run leaves behind.
  match actions_variable_read(name: fleet_converge_subject_host_env_name) {
    ActionsVariablePresent { value: named_subject } => runner_host_cap_release_for_host(named_subject)
    ActionsVariableAbsent => match actions_variable_read(name: fleet_converge_expected_host_env_name) {
      ActionsVariablePresent { value: dispatch_host } => runner_host_cap_release_for_host(dispatch_host)
      ActionsVariableAbsent { variable: v, detail: d } =>
        finish_runner_host_cap_release(host: "unknown", decision: ReleaseObligationUntrusted { cause: join(["the release could not start: ", v, " ", d, "; one host per run, named by the dispatch"], "") }, outcomes: [])
    }
  }
}

fn runner_host_cap_release_for_host(raw_host: String) -> ProcessExit
{
  match runner_host_file_subject(host: raw_host as HostIdentity) {
        RunnerHostFileSubjectRefused { cause: c } =>
          finish_runner_host_cap_release(host: raw_host, decision: ReleaseObligationUntrusted { cause: concat("the release could not start: ", c) }, outcomes: [])
        RunnerHostFileSubjectAdmitted { subject: subject } =>
          match prepare_fleet_ssh_agent_context(attempt_raw: runner_host_file_converge_attempt_raw) {
            FleetSshContextRefused { cause: c } =>
              finish_runner_host_cap_release(host: raw_host, decision: ReleaseObligationUntrusted { cause: concat("the release could not start: ", c) }, outcomes: [])
            FleetSshContextReady { context: context, receipt: _ } => {
              let decision = release_decision_of(reading: read_bracket_obligation(host: subject.host as String))
              let outcomes = match decision {
                ReleaseOwes { units: owned } => release_owned_slots_over(target: subject.target, context: context, units: owned)
                _ => []
              }
              finish_runner_host_cap_release(host: raw_host, decision: decision, outcomes: outcomes)
            }
          }
      }
}

// THE ONE FINISHER OF THE RELEASE, for every arm including the ones that could not start: the receipt is
// written from the actual result at the path ci_spec declares (the workflow's cat and upload read the same
// path), a write that fails fails the step, and the exit follows the verdict. The converge receipt is a
// different path and is never touched.
fn finish_runner_host_cap_release(host: String, decision: ReleaseDecision, outcomes: List<SlotActuationOutcome>) -> ProcessExit
{
  let verdict = release_verdict_of(decision: decision, outcomes: outcomes)
  let attempt = match runner_host_cap_obligation_identity(host: host) { Present { value: k } => k Absent => "unknown (GITHUB_RUN_ID or GITHUB_RUN_ATTEMPT unset)" }
  let body = release_receipt_text(attempt: attempt, host: host, decision: decision, outcomes: outcomes, verdict: verdict)
  let w = Filesystem.Write(path: gunbc_ci_runner_host_cap_release_receipt_path, content: body)
  if w.success == false {
    exit_failure(reason: join(["runner_host_cap_release: receipt write failed: ", w.error, "\n", body], ""))
  } else if release_verdict_is_settled(v: verdict) {
    ExitSuccess
  } else {
    exit_failure(reason: body)
  }
}
