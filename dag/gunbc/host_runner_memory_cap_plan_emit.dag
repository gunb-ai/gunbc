module gunbc.host_runner_memory_cap_plan_emit


data runner_memory_cap_plan_protocol: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "" }

data runner_memory_cap_plan_record_knobs: std.languages.SerializationKnobs = {
  assign: "=",
  entry_separator: " ",
  open: "",
  close: "",
  quote_keys: false,
  value_quote: null,
}

data runner_memory_cap_plan_emit_disclaimer: String = "RUNNER-MEMORY-CAP APPLY SHEET — EMIT CLAIMS NOTHING: typed projection of fleet_converge_policy memory-cap knobs (per_slot_memory_max_bytes, per_slot_memory_high_bytes, per_slot_memory_swap_max_bytes) for operator hand-apply only. Modeled-but-not-applied until a separate verify-only receipt reads Converged on the runner instance glob. This emission does not invoke host_effect_apply, systemctl, or any host mutation."

data memory_cap_plan_row_kind_guard_note: String = "memory_cap_plan_row_is_per_slot_memory_cap is a structural ConvergeTarget coproduct guard for plan-emit projection only — PerSlotMemoryCap rows serialize; any other arm emits an UNSOUND line (fail-closed, not silent skip). Dissolve-on: host_converge_realize PerSlotMemoryCap interpreter retires the hand-apply sheet."

fn memory_cap_plan_row_is_per_slot_memory_cap(knob: gunbc.host_converge.ConvergeKnob) -> Bool {
  match knob.target {
    gunbc.host_converge.PerSlotMemoryCap { dropin_path: _, instance_glob: _, property: _, bytes_value: _ } => true
    _ => false
  }
}

fn memory_cap_dropin_stanza(property: String, bytes_value: String) -> String {
  concat(concat(concat("[Service]\n", property), "="), bytes_value)
}

fn memory_cap_plan_row_fields(host: product.placement_supply.HostIdentity, knob: gunbc.host_converge.ConvergeKnob) -> List<std.languages.SerialField> {
  match knob.target {
    gunbc.host_converge.PerSlotMemoryCap { dropin_path: path, instance_glob: glob, property: prop, bytes_value: bytes } =>
      [
        std.serialize.serial_field(key: "host", value: std.serialize.serial_scalar(text: host as String)),
        std.serialize.serial_field(key: "knob_name", value: std.serialize.serial_scalar(text: knob.name)),
        std.serialize.serial_field(key: "dropin_path", value: std.serialize.serial_scalar(text: path)),
        std.serialize.serial_field(key: "property", value: std.serialize.serial_scalar(text: prop)),
        std.serialize.serial_field(key: "bytes_value", value: std.serialize.serial_scalar(text: bytes)),
        std.serialize.serial_field(key: "instance_glob", value: std.serialize.serial_scalar(text: glob)),
        std.serialize.serial_field(
          key: "dropin_stanza",
          value: std.serialize.serial_scalar(text: memory_cap_dropin_stanza(property: prop, bytes_value: bytes))
        ),
      ]
    _ => []
  }
}

fn memory_cap_plan_row_doc(host: product.placement_supply.HostIdentity, knob: gunbc.host_converge.ConvergeKnob) -> std.layout.Doc {
  if memory_cap_plan_row_is_per_slot_memory_cap(knob: knob) {
    std.layout.doc_concat(parts: [
      std.layout.doc_text(text: "runner-memory-cap-plan "),
      std.serialize.serialize_fields_doc(knobs: runner_memory_cap_plan_record_knobs, fields: memory_cap_plan_row_fields(host: host, knob: knob)),
      std.layout.DocLine,
    ])
  } else {
    std.layout.doc_line_of(text: concat("runner-memory-cap-plan UNSOUND: knob ", concat(knob.name, " is not PerSlotMemoryCap")))
  }
}

fn project_runner_memory_cap_plan_doc(host: product.placement_supply.HostIdentity) -> std.layout.Doc {
  match gunbc.host_runner_memory_provision.runner_memory_host_converge(host: host) {
    Present { value: hc } =>
      std.layout.doc_concat(parts: append(
        [
          std.layout.doc_line_of(text: runner_memory_cap_plan_emit_disclaimer),
          std.layout.doc_line_of(text: ""),
        ],
        items: map(gunbc.host_runner_memory_provision.runner_memory_knobs_from(host: hc), knob => memory_cap_plan_row_doc(host: host, knob: knob))
      ))
    Absent =>
      std.layout.doc_line_of(
        text: concat(
          "runner-memory-cap-plan UNSOUND: memory-cap converge knobs absent from fleet_converge_policy for ",
          host as String
        )
      )
  }
}

fn expected_runner_memory_cap_apply_sheet(host: product.placement_supply.HostIdentity) -> String {
  std.layout.render(doc: project_runner_memory_cap_plan_doc(host: host), proto: runner_memory_cap_plan_protocol)
}

fn runner_memory_cap_plan_emit_claims_nothing(host: product.placement_supply.HostIdentity) -> Bool {
  string_contains(
    s: expected_runner_memory_cap_apply_sheet(host: host),
    pattern: "EMIT CLAIMS NOTHING"
  )
    && string_contains(
      s: expected_runner_memory_cap_apply_sheet(host: host),
      pattern: "Modeled-but-not-applied until a separate verify-only receipt reads Converged"
    )
}
