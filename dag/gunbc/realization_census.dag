module gunbc.realization_census

import std.types { String, NonEmptyStr, Int, List }
import std.decl_ref { DeclarationRef }
import std.algebra { FreeSemigroup }
import gunbc.guarantee_rung { GuaranteeRung }

// THE CLOSED VOCABULARIES OF THE REALIZATION CENSUS, AS TYPES. The census (a population of modules
// measured at a revision; its observation shape is gunbc.repository_census_observation) records, per
// module and per realization dimension, WHERE the decision is made today and which guarantee rung
// the module's handling of it sits at. A cell outside these sets is unwritable here rather than
// refused later: the interim producer (gunbc.realization_census_rows_gen) admits each TSV cell
// into these types or refuses the whole run with the cell's location, and emits constructors, so a
// value outside the set never reaches a sheet. SiteOther and DimensionOther are vocabulary members,
// not escapes added here: the census brief made `other` the explicit class for misfits.

type RealizationDimension
  = DimensionStorage
  | DimensionCaching
  | DimensionAccess
  | DimensionAuthz
  | DimensionPlacement
  | DimensionOther

type DecisionSite
  = SiteNone
  | SiteHome
  | SitePassed
  | SiteRederived
  | SiteLiteral
  | SiteForked
  | SiteOther

type RealizationLevel
  = LevelL0
  | LevelL1
  | LevelL2
  | LevelL3
  | LevelL4
  | LevelL5

type CensusModuleClass
  = ClassProduction
  | ClassSeedGenerated
  | ClassSeed
  | ClassRoster
  | ClassTest
  | ClassExtdeps

// THE CENSUS PASS THAT READ A MODULE. The sibling lane read the corpus in phases; these five are the
// labels its method.md uses, and a sixth label refuses at the producer like any closed cell.
type CensusPhase
  = PhaseP0
  | PhaseP0Random
  | PhaseP2
  | PhaseP2Parent
  | PhaseP3

// ONE EVIDENCE CITATION. The census cell is a `; `-joined list; a bare declaration name (optionally
// after its keyword, `data X`) is a declaration of the row's own module and is carried as the
// reference the Node tree can decide, so a stale one is detectable by the lens this hand census
// is the oracle for. Everything else the census wrote there (an effect operation, a glob, a dotted
// path, a name with a parenthetical, any citation in a Rust seed file) is not a declaration of
// that module, and is kept as the text it is rather than forced into a reference it would not
// resolve as.
type EvidenceCitation
  = EvidenceDeclaration { ref: DeclarationRef }
  | EvidenceUncited { text: NonEmptyStr }

type DimensionReading {
  site: DecisionSite
  level: RealizationLevel
}

type ModuleCensusReading {
  module: NonEmptyStr
  module_class: CensusModuleClass
  storage: DimensionReading
  caching: DimensionReading
  access: DimensionReading
  authz: DimensionReading
  placement: DimensionReading
  ambient_calls: Int
  worst_site: DecisionSite
  worst_finding: String
  evidence_symbols: List<EvidenceCitation>
  phase: CensusPhase
}

type FindingCensusReading {
  finding_id: NonEmptyStr
  class_id: NonEmptyStr?
  module: NonEmptyStr
  dimension: RealizationDimension
  level: RealizationLevel
  module_class: CensusModuleClass
  site: DecisionSite
  symbol: String
  specimen: String
  note: String
  existing_authority: String
  fix_shape: String
}

// THE CLASSES TAB'S RUNG IS NOT gunbc.guarantee_rung ALONE. The census writes 0 for a class nothing
// models yet; DESIGN section 4b's OutsideTheLadder is a different fact (external reality,
// undecidable or undeclared intent), so mapping 0 onto it would give one name two meanings.
type CensusClassRung
  = RungUnmodeled
  | RungOnLadder { rung: GuaranteeRung }

// A class's population counts (instances, modules, and their split by module class) are NOT
// carried: they are projections of the findings whose class_id names the class, so the sheet
// derives them and the producer refuses a TSV whose stated counts disagree with that projection.
type ClassCensusReading {
  class_id: NonEmptyStr
  dimension: RealizationDimension
  decision_sites: FreeSemigroup<DecisionSite>
  pattern: String
  current_rung: CensusClassRung
  attainable_ceiling: GuaranteeRung
  ceiling_reason: String
  owning_authority: String
  wall: String
  red_control: String
  residual: String
  next_trigger: String
}

fn decision_site_text(s: DecisionSite) -> String {
  match s {
    SiteNone => "None"
    SiteHome => "Home"
    SitePassed => "Passed"
    SiteRederived => "Rederived"
    SiteLiteral => "Literal"
    SiteForked => "Forked"
    SiteOther => "Other"
  }
}

fn realization_level_text(l: RealizationLevel) -> String {
  match l {
    LevelL0 => "L0"
    LevelL1 => "L1"
    LevelL2 => "L2"
    LevelL3 => "L3"
    LevelL4 => "L4"
    LevelL5 => "L5"
  }
}

fn realization_dimension_text(d: RealizationDimension) -> String {
  match d {
    DimensionStorage => "storage"
    DimensionCaching => "caching"
    DimensionAccess => "access"
    DimensionAuthz => "authz"
    DimensionPlacement => "placement"
    DimensionOther => "other"
  }
}

fn census_module_class_text(c: CensusModuleClass) -> String {
  match c {
    ClassProduction => "production"
    ClassSeedGenerated => "seed-generated"
    ClassSeed => "seed"
    ClassRoster => "roster"
    ClassTest => "test"
    ClassExtdeps => "extdeps"
  }
}

fn census_phase_text(p: CensusPhase) -> String {
  match p {
    PhaseP0 => "P0"
    PhaseP0Random => "P0-random"
    PhaseP2 => "P2"
    PhaseP2Parent => "P2-parent"
    PhaseP3 => "P3"
  }
}

fn evidence_citation_text(c: EvidenceCitation) -> String {
  match c {
    EvidenceDeclaration { ref: r } => r.decl_name as String
    EvidenceUncited { text: t } => t as String
  }
}

// EACH CLOSED VOCABULARY'S MEMBERS, IN DECLARATION ORDER, for a consumer that needs the set rather
// than one member: the sheet sizes a vocabulary column by its longest member's text.
data decision_sites_all: List<DecisionSite> = [SiteNone, SiteHome, SitePassed, SiteRederived, SiteLiteral, SiteForked, SiteOther]

data realization_levels_all: List<RealizationLevel> = [LevelL0, LevelL1, LevelL2, LevelL3, LevelL4, LevelL5]

data realization_dimensions_all: List<RealizationDimension> = [DimensionStorage, DimensionCaching, DimensionAccess, DimensionAuthz, DimensionPlacement, DimensionOther]

data census_module_classes_all: List<CensusModuleClass> = [ClassProduction, ClassSeedGenerated, ClassSeed, ClassRoster, ClassTest, ClassExtdeps]

data census_phases_all: List<CensusPhase> = [PhaseP0, PhaseP0Random, PhaseP2, PhaseP2Parent, PhaseP3]
