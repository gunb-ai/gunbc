module gunbc.cli_dispatch_surface

import std.measure { Millisecond, millisecond_count }
import std.types { Bool, CommitSha, Int, List, Port, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// THE gunbc CLI'S OWN DISPATCH SURFACE, AS ROWS.
//
// This is a PRODUCT fact -- which verbs gunbc offers, which options each takes, and what each
// verb's arm delegates to. It is not a fact about the Rust language and it is not a fact about
// clap. It lives here because DESIGN section 3 separates interface, realization and policy: the
// surface below is policy, `clap` is one realization of it, and `v1.compiler.emit_rust` is where
// that realization is rendered.
//
// WHERE IT LIVED BEFORE, AND WHY THAT WAS WRONG. Every row below was, until this module, a Rust
// string literal inside `emit_main_rs` (`src/v1/05_emit_rust.dag`) -- the GENERIC Rust emitter --
// selected by a `has_pipeline` predicate that asks whether the corpus being compiled contains
// `v1.compiler.compile`. That predicate is an "am I gunbc?" test sitting inside the interface, and
// everything it guards is one product's argv policy welded into the emitter every other product
// shares. The tell DESIGN section 3 names is exact: an argv carrying a literal it should receive
// as a parameter.
//
// WHAT THIS MODULE DOES NOT DO. It renders no Rust. A `Vec<String>` for a repeated option, a
// `u16` for a port, an `Option<u64>` for a budget -- those are target spellings derived from the
// declarations below by whichever emitter is rendering, and spelling them here would move the
// fusion rather than remove it. `CliOptionValue` therefore names the CONCEPT each option carries
// (`std.types.Port`, `std.measure.Millisecond`) and never its machine type.

// HOW MANY VALUES ONE OPTION ADMITS -- and this coproduct is minted here UNDER PROTEST, with the
// reason recorded because minting it is the move this file otherwise argues against.
//
// `std.constructors.Cardinality` is the right authority and was consumed by an earlier revision of
// this module, widened from `Required | Optional` to carry a `Many` arm. It does not work, and the
// failure is not this module's: `v1.compiler.core` declares a SECOND `Cardinality`
// (`Required | CardOptional`), so the two share the variant name `Required` and any module the v1
// seed imports that also reaches `std.constructors` puts both in one closure. Measured by
// execution on the required-regen path: `variant 'Required' appears in both 'Cardinality' and
// 'Cardinality'`, one hard diagnostic, and the emitter is exactly such a module.
//
// The fork is KNOWN and predates this work -- `gunbc.emit_summary_map_consumer_partition` carries
// it as a named specimen, recording that the two are "two DIFFERENT unit-only enums under one
// key" and that the emitter's variant map answers from whichever module its fold reached last.
// Consolidating them is a v1-seed migration across dozens of `CardOptional` sites in `00_core`,
// `04_lookup`, `04_types`, `04_patterns` and the three emitters; it is not this change's to make,
// and doing it badly under cover of a CLI model would be worse than naming it.
//
// So this is a THIRD name for multiplicity and it is debt, not a design. It is preferred to the
// alternatives only because the other two are worse: consuming `std.constructors` does not
// compile, and consuming `v1.compiler.core`'s would make a product model depend on the seed
// compiler's internal node vocabulary. DISSOLVES WHEN: the two `Cardinality` authorities
// consolidate, at which point this type is deleted and the rows take the survivor.
type CliOptionArity
  = CliRequired
  | CliAtMostOne
  | CliRepeated

// WHAT ONE OPTION CARRIES, AND ITS DEFAULT, WHICH ARE THE SAME FACT.
//
// Each arm names an authority that already exists rather than a Rust type: text is `String`, a
// toggle is `Bool`, a port is `std.types.Port` (an `Int` bounded to 1..65535), and a budget is
// `std.measure.Millisecond`. The last two are why this is a coproduct and not a `String` with a
// spelling beside it -- `--port` and `--eval-budget-cpu-ms` differ in what they MEAN, and an
// emitter that knows only "unsigned" has to be told the width by hand at every site.
//
// THE DEFAULT LIVES INSIDE THE ARM, and that placement is doing two jobs. An earlier revision
// carried `default_value: String?` on the row, which flattened four domains into text: `"8080"`
// was a port written as characters, so the row NAMED `Port` while CARRYING a string, and the only
// thing relating the two was this comment. Putting the default in the arm makes the row carry the
// authority it names -- `port_default` IS a `Port`, `millisecond_default` IS a `Millisecond` --
// which is the anemic-leaf decomposition DESIGN section 2 asks for, onto concepts that already
// exist rather than a fresh one.
//
// It also makes a state unwritable rather than checked. `CliToggleValue` has no default field, so
// "a toggle with a default" -- which clap cannot realize, there being no third state for a default
// to select -- has no constructor. A witness asserting toggles declare no default was enrolled
// here and is DELETED rather than kept: its RED is no longer authorable in any source a fixture
// could write, so it would be permanently green by construction and would read as coverage while
// carrying no information (DESIGN section 4b). The climb removes the check, not the guarantee.
type CliOptionValue
  = CliTextValue { text_default: String? }
  | CliToggleValue
  | CliPortValue { port_default: Port? }
  | CliMillisecondValue { millisecond_default: Millisecond? }

// WHETHER THE INSTALLED GENERATED DISPATCH CARRIES THIS ROW TODAY.
//
// This is the divergence census carried at ROW GRAIN, and it replaces a line count. The
// generated sibling is the ordinary admitted artifact that owns the shipped grammar and
// realization selection. `gunbc_cli_shipped_dispatch_gap` answers membership as an identity join
// over declarations, so the result is a fact about the installed surface rather than about a
// discarded main.rs candidate or the day someone counted its lines.
type CliSurfaceEmission
  = CarriedByGeneratedDispatch
  | AbsentFromShippedDispatch

// WHICH IDENTITY `gunbc --version` REPORTS.
//
// A package release number cannot identify a compiler binary built between releases, which is
// the distinction this surface exists to preserve. The interface therefore promises the exact
// source commit. How a target binds that commit at build time is realization; the Rust emitter
// currently renders it from the build-script-provided `GUNBC_BUILD_IDENTITY` value.
type CliVersionIdentity
  = CliCleanSourceCommit { commit: CommitSha }
  | CliDirtySourceCommit { commit: CommitSha }

// WHAT THE ARM DOES, which is a THIRD fact beside the option list and the emission state.
//
// `CliRefusesUnwired` is not a missing arm. `converge`'s arm is a typed refusal naming a
// successor that exists (the modeled convergence spine), and modeling it as absent would erase
// the distinction between a verb nobody wired and a verb deliberately routed elsewhere -- the
// not-applicable-rendered-as-malformed collapse DESIGN lists among the recurring failure modes.
//
// `CliInvokesBoundTargetProducer` CARRIES NO PAYLOAD, AND THE ABSENCE IS THE WHOLE POINT.
// `CliDelegatesToHostFn` names an authored host function as a `String`, which is the stringly
// typed hook this architecture exists to replace: the CLI authority would then be naming a Rust
// symbol, and the binding between the two would hold only by spelling. A verb on this arm instead
// declares that its subject is resolved through `gunbc.target_binding`'s registry and realized by
// whatever that registry binds — so the CLI surface names no realization at all, and the dispatch
// that selects one stays peripheral where DESIGN section 3 puts it.
type CliArmRealization
  = CliDelegatesToHostFn { symbol: String }
  | CliRetainedHostKernel
  | CliRefusesUnwired { successor: String }
  | CliInvokesBoundTargetProducer
  | CliInvokesBootstrapDagOperation { binding: CliBootstrapDagOperationBinding }
  | CliKnownOperationNoRealization { operation: DeclarationRef }

// A TEMPORARY CROSS-SEED BINDING, narrow by construction: only a successor-authored operation may
// inhabit this execution class. Ordinary target producers remain ineligible for the retained
// interpreter seam. The declaration is structural identity; source location and argv projection
// are data consumed by the generic emitter, never literals in an arm renderer.
type CliBootstrapExecutionClass = BootstrapSuccessorOperation {}

// Closed admission population for the temporary interpreter boundary. An ordinary target
// producer has no constructor here, so it cannot acquire BootstrapSuccessorOperation by tagging
// an arbitrary DeclarationRef.
type AdmittedBootstrapOperationIdentity = GunbcProductBuildBootstrapOperation {}

fn admitted_bootstrap_operation_declaration(identity: AdmittedBootstrapOperationIdentity) -> DeclarationRef {
  match identity {
    GunbcProductBuildBootstrapOperation {} => gunbc_build_operation_ref()
  }
}

type CliBootstrapOperandBinding {
  parameter: String
  operand_field: String
}

type CliBootstrapReceiptChannel {
  parameter: String
  path: String
}

type CliBootstrapDagOperationBinding {
  operation: AdmittedBootstrapOperationIdentity
  entry_path: String
  source_roots: List<String>
  public_operands: List<CliBootstrapOperandBinding>
  receipt: CliBootstrapReceiptChannel
  execution_class: CliBootstrapExecutionClass
}

// THE OPERAND AXIS, AND WHY IT IS NOT AN OPTION ROW WITH A DIFFERENT SPELLING.
//
// `gunbc test //gunbc/instruments:heads-reading-differential` names its subject POSITIONALLY, and
// the temptation this module has to refuse is respelling that as `gunbc test --target //...`
// purely because `CliSubcommandRow` already carries an option list. That would be the carrier
// dictating the interface: an operand and an option differ in what the CLI grammar admits, not in
// what a row happens to be convenient to write, and collapsing them would make the surface unable
// to state which of a verb's inputs is positional.
//
// WHAT THE OPERAND CARRIES IS AN AUTHORITY, NOT A SPELLING, which is the same rule
// `CliOptionValue` already holds itself to. `CliAbsoluteLabelOperand` names `extdeps.bazel.label`
// `Label` — so the admissible forms, and every refusal for a form outside them, are decided by the
// cited label grammar and never re-decided here. Target PATTERNS (`...`, `:all`, `:*`) refuse
// there, with their own cause, because a pattern denotes a SET and this operand denotes one
// target; a second pattern test written at this layer would be a second authority for a question
// that authority already answers.
type CliOperandValue
  = CliAbsoluteLabelOperand {}
  | CliScmReadVerbOperand {}
  | CliProgramOperand {}

// EXACTLY ONE, AND THE ARITY IS ITS OWN COPRODUCT RATHER THAN `CliOptionArity` REUSED.
//
// The option arities are `CliRequired | CliAtMostOne | CliRepeated`, and two of the three are
// meaningless positionally in the surface this verb needs: an omitted positional operand is not a
// defaulted option, and a repeated one is the target-pattern question the label grammar already
// refuses. A single arm is what is honestly admitted today; a verb taking a variadic operand list
// adds an arm here and must then decide what it means, rather than inheriting an option's answer.
type CliOperandArity
  = CliExactlyOneOperand {}

type CliOperandRow {
  field: String
  placeholder: String
  value: CliOperandValue
  arity: CliOperandArity
  doc: List<String>
  emission: CliSurfaceEmission
}

type CliOptionRow {
  field: String
  long: String
  value: CliOptionValue
  arity: CliOptionArity
  doc: List<String>
  emission: CliSurfaceEmission
}

type CliSubcommandRow {
  verb: String
  variant: String
  doc: List<String>
  operands: List<CliOperandRow>
  options: List<CliOptionRow>
  realization: CliArmRealization
  emission: CliSurfaceEmission
}

fn gunbc_cli_binary_name() -> String {
  "gunbc"
}

fn gunbc_cli_about() -> String {
  "A causal compiler: write .dag, get Rust/Python/Go."
}

fn gunbc_cli_version_identity(source_commit: CommitSha, source_dirty: Bool) -> CliVersionIdentity {
  if source_dirty {
    CliDirtySourceCommit { commit: source_commit }
  } else {
    CliCleanSourceCommit { commit: source_commit }
  }
}

fn gunbc_cli_version_text(identity: CliVersionIdentity) -> String {
  match identity {
    CliCleanSourceCommit { commit: commit } => commit,
    CliDirtySourceCommit { commit: commit } => concat(commit, "-dirty")
  }
}

// §7 PURE-BOOTSTRAP RECEIPT FOR THE ONE SEED-RETAINED UNIT THIS SURFACE STILL NEEDS.
// The policy and formatting are modeled above; `build.rs` remains the host observation that asks
// Git for HEAD and observes whether the Rust inputs are dirty, then binds GUNBC_BUILD_IDENTITY for
// the Rust realization. This is counted interim HAND-Rust growth, not a census shrink.
data gunbc_cli_build_identity_seed_dissolve_trigger: DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on: the GUNBC_BUILD_IDENTITY observation block in src/v1/stage0/build.rs — exactly one removable seed unit. DISSOLVES WHEN the v1-zero-hand-maintained-rust ROADMAP lane (gunbc.roadmap_authority roadmap_nodes) emits the build-time Git observation from gunbc.cli_dispatch_surface, at which point git_output and the identity block delete together rather than leaving a second producer. Checkable until deletion: GUNBC_BUILD_IDENTITY has exactly one cargo:rustc-env producer in src/v1/stage0/build.rs and gunbc_cli_version_text is its sole formatting authority.")

// WHAT IS DELIBERATELY NOT HERE: `--dry-run`.
//
// It is not a gunbc row. The generic emitter puts a `dry_run` field on EVERY product's parser
// root, because dry-run is a property of how a compiled program's service calls are realized, not
// of gunbc's verbs. Declaring it below would create a second authority for a field this module
// does not own and the emitter would keep emitting from its own -- the parallel-representation
// debt DESIGN section 3 forbids, marked or not. The surface below is the SUBCOMMAND surface, and
// that is the whole of what `has_pipeline` fused into the emitter.

fn gunbc_build_operation_ref() -> DeclarationRef {
  DeclarationRef {
    module_path: "gunbc.devboot.build",
    decl_name: "gunbc_build_cli_entry",
    field: WholeDeclaration,
  }
}

fn gunbc_build_operation_binding() -> CliBootstrapDagOperationBinding {
  CliBootstrapDagOperationBinding {
    operation: GunbcProductBuildBootstrapOperation {},
    entry_path: "dag/gunbc/devboot/build.dag",
    source_roots: ["dag", "src/v2"],
    public_operands: [
      CliBootstrapOperandBinding { parameter: "program", operand_field: "program" },
    ],
    receipt: CliBootstrapReceiptChannel { parameter: "receipt_path", path: ".gunbc-build-receipts" },
    execution_class: BootstrapSuccessorOperation {},
  }
}

data gunbc_build_emitted_seed_growth_note: String = "PURPOSE admission for the emitted `gunbc build` route. It serves the v2 self-host program by making its existing exact self-build operation consumable through the product CLI. Classification against the five refused v1-seed classes: NewLanguageBehavior -- no, the language and compiler semantics are unchanged. NewCompatibilityObligation -- no, the searched production/documentation population contains no predecessor devboot `gunbc run --entry` route. NewEscapeHatchOrAdmissionRow -- no, every missing binding or execution fact refuses without fallback. SeedFeatureCompletion -- no compiler feature is completed. PublicSurfaceGrowth -- yes: one modeled Build row and its single operand become emitted. The successor operation cannot legally enter the frozen seed closure, and mirroring it would fork its semantics, so the narrowly classified BootstrapSuccessorOperation uses the retained in-process evaluator as enumerated, reducible bootstrap residue. OrdinaryTargetProducer remains ineligible. Rung climb: CliArmRealization was declared but inert; emit_main_rs now derives every emitted arm from it. The former independent compile/run arm selection is deleted, while the discriminating known-operation/no-realization RED remains enrolled."

fn cli_realization_missing_refusal(realization: CliArmRealization) -> String? {
  match realization {
    CliKnownOperationNoRealization { operation } =>
      Present { value: join(["known operation, no realization: ", operation.module_path, ".", operation.decl_name], "") }
    CliDelegatesToHostFn { symbol } => none
    CliRetainedHostKernel => none
    CliRefusesUnwired { successor } => none
    CliInvokesBoundTargetProducer => none
    CliInvokesBootstrapDagOperation { binding } => none
  }
}

fn gunbc_cli_subcommands() -> List<CliSubcommandRow> {
  [
    CliSubcommandRow {
      verb: "compile",
      variant: "Compile",
      doc: ["Compile .dag source files to a target language"],
      operands: [],
      options: [
        CliOptionRow {
          field: "source_roots",
          long: "source-root",
          value: CliTextValue { text_default: none },
          arity: CliRepeated,
          doc: [
            "Source root directories (searched recursively for .dag files).",
            "Module imports are resolved transitively from these roots."
          ],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "source_dir",
          long: "source-dir",
          value: CliTextValue { text_default: none },
          arity: CliAtMostOne,
          doc: ["Legacy: single source directory (all .dag files loaded, no import resolution)"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "output_dir",
          long: "output-dir",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: [],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "target",
          long: "target",
          value: CliTextValue { text_default: Present { value: "rust" } },
          arity: CliRequired,
          doc: ["Target language: rust, python, go, dag, or + separated set such as rust+dag"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "dependency_pool_index",
          long: "dependency-pool-index",
          value: CliTextValue { text_default: Present { value: "strict" } },
          arity: CliRequired,
          doc: [],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "entry",
          long: "entry",
          value: CliTextValue { text_default: none },
          arity: CliAtMostOne,
          doc: [
            "Entry `.dag` file: compile only this module and its transitive imports",
            "(not every `.dag` file under the first --source-root). Scopes the compile",
            "to a subtree so a small closure can be emitted without a whole-tree pass."
          ],
          emission: CarriedByGeneratedDispatch
        }
      ],
      realization: CliRetainedHostKernel,
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "run",
      variant: "Run",
      doc: ["Execute a .dag program directly (interpreter)"],
      operands: [],
      options: [
        CliOptionRow {
          field: "source_roots",
          long: "source-root",
          value: CliTextValue { text_default: none },
          arity: CliRepeated,
          doc: ["Source root directories (searched recursively for .dag files)"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "function",
          long: "function",
          value: CliTextValue { text_default: Present { value: "main" } },
          arity: CliRequired,
          doc: ["Entry function to execute (default: \"main\")"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "entry",
          long: "entry",
          value: CliTextValue { text_default: none },
          arity: CliAtMostOne,
          doc: [
            "Entry `.dag` file: load only this module and its transitive imports",
            "(not every file under --source-root). Required for scoped TestClaim runs."
          ],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "claim_run",
          long: "claim-run",
          value: CliToggleValue,
          arity: CliRequired,
          doc: ["TestClaim / witness run: Bool false -> exit 1; requires --entry"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "args",
          long: "arg",
          value: CliTextValue { text_default: none },
          arity: CliRepeated,
          doc: [
            "Named argument for the entry function, repeatable: `--arg name=value`.",
            "Values enter as String; a missing `=` refuses rather than guessing."
          ],
          emission: CarriedByGeneratedDispatch
        }
      ],
      realization: CliDelegatesToHostFn { symbol: "run_verb" },
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "build",
      variant: "Build",
      doc: ["Build one exact executable for a named program"],
      operands: [
        CliOperandRow {
          field: "program",
          placeholder: "PROGRAM",
          value: CliProgramOperand {},
          arity: CliExactlyOneOperand {},
          doc: ["Program name from the offered program roster"],
          emission: CarriedByGeneratedDispatch
        }
      ],
      options: [],
      realization: CliInvokesBootstrapDagOperation { binding: gunbc_build_operation_binding() },
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "converge",
      variant: "Converge",
      doc: [
        "Apply a host's typed converge policy in-process",
        "(`gunbc.fleet_converge_cli.converge_cli_run`) and print a",
        "`converge-receipt` line on the byte-locked receipt grammar."
      ],
      operands: [],
      options: [
        CliOptionRow {
          field: "host",
          long: "host",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: ["Fleet host identity (e.g. \"srv1\") to converge"],
          emission: CarriedByGeneratedDispatch
        }
      ],
      realization: CliRefusesUnwired { successor: "gunbc.fleet_converge_apply" },
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "scm",
      variant: "Scm",
      doc: [
        "Read a gunbc repository: `gunbc scm log` lists its commits,",
        "`gunbc scm status` reports what is checked out and staged.",
        "Both answer from the repository document alone and mutate nothing."
      ],
      operands: [
        CliOperandRow {
          field: "verb",
          placeholder: "VERB",
          value: CliScmReadVerbOperand {},
          arity: CliExactlyOneOperand {},
          doc: ["Which read to perform: `log` or `status`"],
          emission: AbsentFromShippedDispatch
        }
      ],
      options: [
        CliOptionRow {
          field: "path",
          long: "path",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: ["Path to the repository document to read"],
          emission: AbsentFromShippedDispatch
        }
      ],
      realization: CliRefusesUnwired {
        successor: "unwired: gunbc.cli_wire CliWireResponse has no host renderer bound. MEASURED, not assumed -- `gunbc run --entry dag/gunbc/scm/read_command.dag --function scm_read_log --arg path=<p>` binds its argument and READS THE FILE, then the host refuses with `returned ScmReadResult, not ProcessExit`, so the answer is computed and discarded. There is therefore NO route a user can invoke today that yields this answer, and naming one would be a dead end dressed as a redirect."
      },
      emission: AbsentFromShippedDispatch
    },
    CliSubcommandRow {
      verb: "serve",
      variant: "Serve",
      doc: [
        "Long-running HTTP server: compile once, then answer each request by",
        "calling ONE .dag entry `fn(method, path, body) -> ServeWireResponse`.",
        "The seam is parse/write only -- routing and handlers live in .dag."
      ],
      operands: [],
      options: [
        CliOptionRow {
          field: "source_roots",
          long: "source-root",
          value: CliTextValue { text_default: none },
          arity: CliRepeated,
          doc: ["Source root directories (searched recursively for .dag files)"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "entry",
          long: "entry",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: ["Entry `.dag` file: load only this module and its transitive imports"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "function",
          long: "function",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: ["Handler function: fn(method: String, path: String, body: String) -> ServeWireResponse"],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "host",
          long: "host",
          value: CliTextValue { text_default: Present { value: "127.0.0.1" } },
          arity: CliRequired,
          doc: [],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "port",
          long: "port",
          value: CliPortValue { port_default: Present { value: 8080 } },
          arity: CliRequired,
          doc: [],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "release_revision",
          long: "release-revision",
          value: CliTextValue { text_default: none },
          arity: CliRequired,
          doc: [
            "Release revision this process serves, bound ONCE at startup and",
            "immutable for the process lifetime."
          ],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "eval_budget_cpu_ms",
          long: "eval-budget-cpu-ms",
          value: CliMillisecondValue { millisecond_default: none },
          arity: CliAtMostOne,
          doc: ["Per-request THREAD-CPU evaluation budget in milliseconds."],
          emission: CarriedByGeneratedDispatch
        },
        CliOptionRow {
          field: "eval_budget_wall_ms",
          long: "eval-budget-wall-ms",
          value: CliMillisecondValue { millisecond_default: none },
          arity: CliAtMostOne,
          doc: ["Per-request MONOTONIC-WALL evaluation budget in milliseconds."],
          emission: CarriedByGeneratedDispatch
        }
      ],
      realization: CliDelegatesToHostFn { symbol: "handle_serve" },
      emission: CarriedByGeneratedDispatch
    },
    CliSubcommandRow {
      verb: "test",
      variant: "Test",
      doc: [
        "Run one target by its absolute label and report the standing its own",
        "producer answers in. The label is exact: a target PATTERN refuses, and",
        "an unbound or unknown target refuses rather than reporting a pass."
      ],
      operands: [
        CliOperandRow {
          field: "target",
          placeholder: "LABEL",
          value: CliAbsoluteLabelOperand {},
          arity: CliExactlyOneOperand {},
          doc: [
            "Absolute label of exactly one target, e.g.",
            "`//gunbc/instruments:heads-reading-differential`."
          ],
          emission: CarriedByGeneratedDispatch
        }
      ],
      options: [],
      realization: CliInvokesBoundTargetProducer,
      emission: CarriedByGeneratedDispatch
    }
  ]
}

// THE CANONICAL QUERIES, owned here rather than by whoever is rendering.
//
// `CliSurfaceEmission` is this module's coproduct, so the question "does the installed generated
// dispatch carry this row" is this module's to answer. A consumer that matched the variants itself would be a second
// site deciding what each arm means, and a third arm added here would then be answered in two
// places -- once correctly and once by whichever existing arm the consumer's match happened to
// widen into. The emitter asks for the population it should render and never sees the tag.
fn gunbc_cli_generated_dispatch_subcommands() -> List<CliSubcommandRow> {
  gunbc_cli_subcommands() |> filter(sub => match sub.emission {
    CarriedByGeneratedDispatch => true
    AbsentFromShippedDispatch => false
  })
}

fn cli_subcommand_generated_dispatch_options(sub: CliSubcommandRow) -> List<CliOptionRow> {
  sub.options |> filter(opt => match opt.emission {
    CarriedByGeneratedDispatch => true
    AbsentFromShippedDispatch => false
  })
}

fn cli_subcommand_generated_dispatch_operands(sub: CliSubcommandRow) -> List<CliOperandRow> {
  sub.operands |> filter(operand => match operand.emission {
    CarriedByGeneratedDispatch => true
    AbsentFromShippedDispatch => false
  })
}

// THE GAP, AS AN IDENTITY JOIN.
//
// Every declaration the committed CLI carries that `emit_main_rs` does not produce, named at the
// grain a repair acts on: a verb, or one option of a verb. Not a count -- DESIGN's oracle rule
// says completeness is an identity join, and a count equality here would go green the moment two
// unrelated rows moved in opposite directions.
//
// An option under an absent verb is NOT listed separately: the verb subsumes it, and listing both
// would report one repair twice and make the population's size depend on how many options a
// missing verb happens to declare.
fn gunbc_cli_shipped_dispatch_gap() -> List<String> {
  cli_shipped_dispatch_gap_of(subcommands: gunbc_cli_subcommands())
}

// The fold is PARAMETERIZED on the population rather than reaching for the gunbc rows directly,
// so its behaviour is checkable against a controlled fixture whose input and expected output are
// authored independently. Folded over the live rows it would only ever be checkable against a
// transcription of those same rows, which is the change detector DESIGN's oracle rule rejects.
fn cli_shipped_dispatch_gap_of(subcommands: List<CliSubcommandRow>) -> List<String> {
  fold(subcommands, init: [], f: fn(acc, sub) {
    match sub.emission {
      AbsentFromShippedDispatch => concat(acc, [sub.verb])
      CarriedByGeneratedDispatch => {
        let with_operands = fold(sub.operands, init: acc, f: fn(inner, operand) {
          match operand.emission {
            AbsentFromShippedDispatch => concat(inner, [concat(sub.verb, concat(".", operand.placeholder))])
            CarriedByGeneratedDispatch => inner
          }
        })
        fold(sub.options, init: with_operands, f: fn(inner, opt) {
          match opt.emission {
            AbsentFromShippedDispatch => concat(inner, [concat(sub.verb, concat(".", opt.long))])
            CarriedByGeneratedDispatch => inner
          }
        })
      }
    }
  })
}

fn gunbc_cli_shipped_dispatch_gap_rendered() -> String {
  fold(gunbc_cli_shipped_dispatch_gap(), init: "", f: fn(acc, name) {
    if acc == "" { name } else { concat(acc, concat(", ", name)) }
  })
}

// Every option the surface declares, verb-qualified, so a consumer can ask about the whole
// surface without re-walking the nesting.
fn gunbc_cli_qualified_option_names() -> List<String> {
  fold(gunbc_cli_subcommands(), init: [], f: fn(acc, sub) {
    concat(acc, fold(sub.options, init: [], f: fn(inner, opt) {
      concat(inner, [concat(sub.verb, concat(".", opt.long))])
    }))
  })
}
