fn roadmap_instance_rules_tail() -> List<BuildRule> {
  [
    StaticRule { selector: ClassSelector { name: swatch_toggle_class }, decls: [
      decl(prop: FontSize, value: scale_var(t: text_10)),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      role_decl(prop: Color, r: TextDimRole),
      role_decl(prop: Background, r: SurfaceRole),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Padding, value: scale_pair(a: space_1, b: space_6)),
      decl(prop: Cursor, value: "pointer"),
      decl(prop: MinWidth, value: swatch_toggle_reserved_width()),
      decl(prop: TextAlign, value: "center"),
      decl(prop: TextTransform, value: "lowercase"),
      decl(prop: LetterSpacing, value: "0.03em"),
    ] },
    StaticRule { selector: ClassSelector { name: theme_toggle_class }, decls: [
      decl(prop: FontSize, value: scale_var(t: text_10)),
      decl(prop: FontFamily, value: scale_var(t: font_mono)),
      role_decl(prop: Color, r: TextDimRole),
      role_decl(prop: Background, r: SurfaceRole),
      decl(prop: Border, value: scale_border(w: border_1, color_var: "var(--border)")),
      decl(prop: BorderRadius, value: scale_var(t: radius_3)),
      decl(prop: Padding, value: scale_pair(a: space_1, b: space_6)),
      decl(prop: MarginLeft, value: scale_var(t: space_2)),
      decl(prop: Cursor, value: "pointer"),
      decl(prop: MinWidth, value: theme_toggle_reserved_width()),
      decl(prop: TextAlign, value: "center"),
      decl(prop: TextTransform, value: "lowercase"),
      decl(prop: LetterSpacing, value: "0.03em"),
    ] },
  ]
}

fn roadmap_css() -> String {
  join([
    scale_root_css(),
    theme_root_css(base: day_theme, alternate: night_theme),
    band_root_css(),
    auditioner_root_css(),
    serialize_rules(rules: roadmap_rules()),
    reduced_motion_block(rules: roadmap_rules()),
  ], "\n")
}
