module probe.an_unreadable_digest_line_refuses_rather_than_defaulting

test fn an_unreadable_digest_line_refuses_rather_than_defaulting() -> Bool {
  let html_plan =
    sccache_verified_install_admitted_plan(
      rel: sccache_release_0_15_0,
      arch: "aarch64",
      digest: sccache_release_0_15_0.digest_aarch64,
      observed_sha256sum_line: "<html><body>404 Not Found</body></html>",
    ).length() == 0
  let blank_plan =
    sccache_verified_install_admitted_plan(
      rel: sccache_release_0_15_0,
      arch: "aarch64",
      digest: sccache_release_0_15_0.digest_aarch64,
      observed_sha256sum_line: "",
    ).length() == 0
  html_plan && blank_plan
}

// THE BOUNDARY VALUES ARE THE RELEASE ROW'S, NOT THIS FILE'S. The adapter must supply url, member,
// staged path, destination and digest FROM the cited row. Checking them against the row's own fields
// rather than against literals is what turns a rotation that updates the row and forgets the adapter
// into a red claim here instead of a surprise on a host.
