module probe.the_presence_observation_gates_the_install

test fn the_presence_observation_gates_the_install() -> Bool {
  let params = sccache_params()
  let present =
    match verified_binary_install_destination_present(p: params, test_executable_exit: 0) {
      AlreadyInstalled { dest_path: p } => p == sccache_installed_binary_path
      InstallNeeded { dest_path: _ } => false
    }
  let missing =
    match verified_binary_install_destination_present(p: params, test_executable_exit: 1) {
      InstallNeeded { dest_path: p } => p == sccache_installed_binary_path
      AlreadyInstalled { dest_path: _ } => false
    }
  let if_absent = sccache_verified_install_if_absent_script(
    rel: sccache_release_0_15_0,
    arch: "aarch64",
    digest: sccache_release_0_15_0.digest_aarch64,
  )
  present && missing
    && starts_with(s: if_absent, prefix: join(["if [ ! -x '", sccache_installed_binary_path, "' ]; then\nset -e\n"], ""))
}

// ONE INHABITANCE CLAIM ON THE REAL ROUTE. Everything above would pass with the effect wired to
// nothing, so this one renders the script the build-cache provisioning step ACTUALLY emits -- through
// the production entry point gunbc.host.host_effect_realize.build_cache_ensure_daemon_body, with a
// real instance and the release row's own values -- and requires the effect's evidence there: the
// cited url, the version, the two-space digest contract against the staging file, and the pinned
// destination. It fails if a consumer is re-pointed at a hand-rolled string, which is the exact
// regression the deleted sccache_install_script was.
