module probe.the_adapter_supplies_the_release_row_values

test fn the_adapter_supplies_the_release_row_values() -> Bool {
  let params = sccache_params()
  let version = sccache_release_0_15_0.version as String
  let dir = join(["sccache-", version, "-aarch64-unknown-linux-musl"], "")
  params.url == join(["https://github.com/mozilla/sccache/releases/download/", version, "/", dir, ".tar.gz"], "")
    && params.archive_member == join([dir, "/sccache"], "")
    && params.staged_binary_path == join(["/tmp/", dir, "/sccache"], "")
    && params.staged_root == join(["/tmp/", dir], "")
    && params.extract_root == "/tmp"
    && params.dest_path == sccache_installed_binary_path
    && params.digest == sccache_release_0_15_0.digest_aarch64
    && params.elevated
}

// WHERE THE DIGEST CHECK SITS IN THE RENDERED SCRIPT. Position is measured over the render's own
// lines rather than by substring search, because "verified before installed" is a statement about
// ORDER: a script that checked the digest after the move would contain every one of the same
// substrings and still install an unverified binary.
