module probe.the_plan_removes_both_staging_paths

test fn the_plan_removes_both_staging_paths() -> Bool {
  let params = sccache_params()
  let script = sccache_verified_install_script(
    rel: sccache_release_0_15_0,
    arch: "aarch64",
    digest: sccache_release_0_15_0.digest_aarch64,
  )
  string_contains(s: script, pattern: join(["'rm' '-rf' '", params.download_path, "'"], ""))
    && string_contains(s: script, pattern: join(["'rm' '-rf' '", params.staged_root, "'"], ""))
}
