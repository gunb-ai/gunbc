module probe.the_gate_discriminates_on_the_digest_alone

test fn the_gate_discriminates_on_the_digest_alone() -> Bool {
  let line = observed_line_for(hex: sccache_release_0_15_0.digest_aarch64.hex, path: "/tmp/sccache.tar.gz")
  let accepts_the_right_one =
    match verified_binary_install_admission(
      expected: sccache_release_0_15_0.digest_aarch64,
      observed_sha256sum_line: line,
    ) {
      Verified { observed: _ } => true
      Refused { expected: _, observed_line: _ } => false
    }
  let rejects_the_wrong_one =
    match verified_binary_install_admission(
      expected: sccache_release_0_15_0.digest_x86_64,
      observed_sha256sum_line: line,
    ) {
      Refused { expected: _, observed_line: _ } => true
      Verified { observed: _ } => false
    }
  accepts_the_right_one && rejects_the_wrong_one
}

// THE RED'S OTHER HALF: A LINE THAT IS NOT A DIGEST REFUSES RATHER THAN DEFAULTING. A truncated
// fetch, an empty body, or a curl that wrote an error page produces a line whose first field is not
// 64 hex. There is no "assume verified" arm: unreadable is refused, so a fetch that silently produced
// nothing installs nothing.
