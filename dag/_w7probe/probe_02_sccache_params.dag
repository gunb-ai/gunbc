module probe.sccache_params

fn sccache_params() -> VerifiedBinaryInstallParams {
  sccache_verified_install_params(
    rel: sccache_release_0_15_0,
    arch: "aarch64",
    digest: sccache_release_0_15_0.digest_aarch64,
  )
}

// THE POSITIVE CONTROL, FIRST, because every claim below is vacuous if this one is red: with the
// release row's own aarch64 digest and the line that download would print, the gate ADMITS and the
// admitted plan is the install body -- five steps, and the move names the destination the adapter
// says the binary lands at.
