module probe.a_digest_mismatch_refuses_and_installs_nothing

test fn a_digest_mismatch_refuses_and_installs_nothing() -> Bool {
  let wrong_digest = sccache_release_0_15_0.digest_x86_64
  let observed =
    observed_line_for(hex: sccache_release_0_15_0.digest_aarch64.hex, path: "/tmp/sccache.tar.gz")
  let gate_refused =
    match verified_binary_install_admission(expected: wrong_digest, observed_sha256sum_line: observed) {
      Refused { expected: e, observed_line: o } => e == wrong_digest && o == observed
      Verified { observed: _ } => false
    }
  let nothing_installed =
    sccache_verified_install_admitted_plan(
      rel: sccache_release_0_15_0,
      arch: "aarch64",
      digest: wrong_digest,
      observed_sha256sum_line: observed,
    ).length() == 0
  gate_refused && nothing_installed
}

// THE RED'S DISCRIMINATING PAIR. A claim that is red under every input is a broken claim, not a
// refusal. This asserts BOTH directions from one line: the correct digest does not refuse and the
// wrong digest does not admit. Read with the claim above, it shows the gate keys on the digest and
// not on the shape of the line or on which branch happens to be written first.
