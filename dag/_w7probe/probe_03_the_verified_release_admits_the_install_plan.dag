module probe.the_verified_release_admits_the_install_plan

test fn the_verified_release_admits_the_install_plan() -> Bool {
  let params = sccache_params()
  let gate_ok =
    match verified_binary_install_admission(
      expected: params.digest,
      observed_sha256sum_line: observed_line_for(hex: params.digest.hex, path: params.download_path),
    ) {
      Verified { observed: observed } => observed == params.digest
      Refused { expected: _, observed_line: _ } => false
    }
  let plan = sccache_verified_install_admitted_plan(
    rel: sccache_release_0_15_0,
    arch: "aarch64",
    digest: sccache_release_0_15_0.digest_aarch64,
    observed_sha256sum_line: observed_line_for(
      hex: sccache_release_0_15_0.digest_aarch64.hex,
      path: "/tmp/sccache.tar.gz",
    ),
  )
  let move_is_fourth =
    match plan.skip(n: 3).first() {
      Present { value: step } =>
        shell_command_render(command: step)
          == join(["'/usr/bin/sudo' '-n' 'mv' '", params.staged_binary_path, "' '", params.dest_path, "'"], "")
      Absent => false
    }
  gate_ok && plan.length() == 5 && move_is_fourth
}

// THE RED. A DIGEST MISMATCH REFUSES, AND NOTHING GETS INSTALLED.
//
// The wrong digest is not invented: it is the SAME ROW's x86_64 digest handed to the aarch64 install.
// That is the realistic mistake -- a rotated release, a copy-paste across arches, a manifest read
// against the wrong key -- and it is well-formed (64 hex, Sha256), so the gate cannot pass it by
// accident and cannot reject it for a shape reason. The observed line is the line the aarch64 bytes
// would print, i.e. what curl actually wrote.
//
// Two halves, because the refusal has to hold in BOTH realizations: the typed gate says Refused and
// carries both values, and the admitted PLAN IS EMPTY. Not shorter, not best-effort -- empty. That is
// the difference between "the shell exited non-zero" and "no install step was ever produced".
