module probe.the_build_cache_route_actually_runs_the_effect

test fn the_build_cache_route_actually_runs_the_effect() -> Bool {
  let body = build_cache_ensure_daemon_body(
    instance: ci_cache_instance(host: srv1_host.identity),
    arch_token: "aarch64" as NonEmptyStr,
    digest: sccache_release_0_15_0.digest_aarch64,
  )
  string_contains(s: body, pattern: "github.com/mozilla/sccache/releases/download/")
    && string_contains(s: body, pattern: sccache_release_0_15_0.version as String)
    && string_contains(
      s: body,
      pattern: join([sccache_release_0_15_0.digest_aarch64.hex as String, "  /tmp/sccache.tar.gz"], ""),
    )
    && string_contains(s: body, pattern: sccache_installed_binary_path)
}

// THE EFFECT IS GENERIC, NOT SCCACHE-SHAPED. A second product's boundary values -- its own url,
// member, destination, octal mode, and a privilege bit that says un-elevated -- must render a script
// carrying those values and NONE of sccache's. If any of them had been baked into the effect, this is
// the claim that says so. It is also the shape extdeps.container.docker_ce will use when it migrates
// (same effect, its own keyring bytes, its own privilege): the lane rule keeps that a later consumer,
// so nothing here migrates it and its trigger stays live and bound.
