module test.fixture.service_symbol_collision.probe

// Two DISTINCT service identities whose emitted symbols collide under
// v1.emit_core_support.sanitize_service_name, which capitalizes each dotted segment and
// concatenates without preserving the boundary: collision.Probe and CollisionProbe both
// project to CollisionProbe, and service_var_name projects both to the same parameter
// spelling. The pair is authored here rather than discovered in the live corpus because
// the class has no live member -- every service declared in the tree projects distinctly --
// so the discriminating RED is only expressible as fixture source.

import std.types { String, Unit }

service collision.Probe {
  operation PingDotted {
    input { tag: String }
    output { line: String from "stdout" }
    readonly
    transport shell { argv: ["echo", "dotted-{tag}"] }
    exit {
      0 => Unit
    }
  }
}

service CollisionProbe {
  operation PingFlat {
    input { tag: String }
    output { line: String from "stdout" }
    readonly
    transport shell { argv: ["echo", "flat-{tag}"] }
    exit {
      0 => Unit
    }
  }
}
