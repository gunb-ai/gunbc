module test.fixture.sig_unresolved_fallthrough_red.unimported_length_probe

import std.types { Int, List }

// Call 'length' WITHOUT importing it. The name matches a kernel method template,
// so bare_call_non_declaration_binding returns KernelMethodOnly. Without import
// visibility, census_declaration_identity gates → CallableUnresolved → method bridge.
// If the method bridge accepts the call without checking labels, THIS is the blind spot.

fn probe_unimported_length_wrong_label(xs: List<Int>) -> Int {
  length(wrong_label: xs)
}
