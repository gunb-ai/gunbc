module test.fixture.nat_qualified_provider

import test.fixture.structural_peano_nat { StructuralNat, structural_nat_add }

// Pool-edge fixture for
// test.claim.self_host_emitted_call_target_realization_witness_test's
// w_qualified_type_reference_qualifier_disambiguates_the_leaf. The mechanism under test is the
// emitter's qualified-type use-line route, which only sees a reference when the resolver leaves it
// AUTHORED -- and the resolver leaves test.fixture.structural_peano_nat.StructuralNat authored only in a module that does NOT import
// v2.std.nat (the shape v2.lens.fact_density had on the 00_compile closure before the Nat de-fork). The witness pool
// admits a module to the closure only through an import edge, so this fixture holds the edge: the
// probe imports this module, test.fixture.structural_peano_nat enters the closure transitively, and the probe's own
// qualified reference stays authored. The bare import-and-reference below keeps the fixture's own
// emission clean through the authored-import route rather than the route under test.
fn nat_qualified_provider_touch(a: StructuralNat) -> StructuralNat {
  structural_nat_add(a: a, b: a)
}
