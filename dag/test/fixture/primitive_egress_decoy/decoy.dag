module test.fixture.primitive_egress_decoy.decoy

fn length(xs: List<Int>) -> Int {
  count(xs)
}

fn decoy_caller() -> Int {
  length(xs: [1, 2])
}

fn free_call_consumer() -> Int {
  count([1, 2, 3])
}

fn method_form_consumer() -> Int {
  [1, 2] |> count
}

fn aliased_spelling_consumer() -> Bool {
  map_has(empty_map(), "k")
}
