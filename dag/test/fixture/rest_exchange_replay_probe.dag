module test.fixture.rest_exchange_replay_probe

import std.types { Bool, Int, List, String }
import std.serialization { Text }
import extdeps.github.workflow_runs { WorkflowRunList }
import extdeps.cloud.gcp.gcp { WifProviderWire, WifProviderListWire, WifPoolWire }
import extdeps.transports.rest { RestResult }

type WireFileShape {
  encoding: String
  content: String
}

type WirePageShape {
  incomplete_results: Bool
}

// WorkflowRunsPage below serves the real extdeps.github.workflow_runs
// response type through the replay seam, so a witness exercises the interpreter's type-directed
// decode with a recorded GitHub body.
// A nullary coproduct no CoproductWireContract row names and whose module declares no
// wire_contract: the undeclared-spelling control for the type-directed response decode.
type UncontractedArm = Alpha | Beta

// The shape of extdeps.google.userinfo GoogleUserInfoWire's email_verified: an optional Bool.
type WireVerifiedFlag {
  verified: Bool?
}

type WireUncontractedShape {
  arm: UncontractedArm
}

// WifProvidersPage and WifPool carry the OUTPUT SHAPES of extdeps.cloud.gcp.iam_admin
// ListWorkloadIdentityPoolProviders and GetWorkloadIdentityPool verbatim, so a recorded IAM body
// reaches the same type-directed decode gunbc.auth.heal_publisher_provision reads through.
// TextBody spells response_format as the std.serialization WireFormat variant github.Pulls.Diff
// uses, so a plain-text body must come back as text through dispatch_rest rather than through the
// JSON decoder. FormatUnrecognized spells it as no WireFormat variant, which must refuse rather than
// default to Json.
service test.RestReplay {
  config { endpoint: "https://rest-replay.invalid" }

  operation Observe {
    output {
      message: String from "message"
    }
    readonly
    transport rest { method: GET, path: "/answer" }
  }

  operation TextBody {
    output {
      text: String
    }
    readonly
    transport rest { method: GET, path: "/answer", response_format: Text }
    response { 200 => String }
  }

  operation FormatUnrecognized {
    output {
      text: String
    }
    readonly
    transport rest { method: GET, path: "/answer", response_format: "Text" }
    response { 200 => String }
  }

  operation RootArray {
    output {
      pulls: List<Int>
    }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => List<Int> }
  }

  operation RootFile {
    output {
      file: WireFileShape
    }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WireFileShape }
  }

  operation RootPage {
    output {
      page: WirePageShape
    }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WirePageShape }
  }

  operation WorkflowRunsPage {
    output {
      runs: WorkflowRunList
    }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WorkflowRunList }
  }

  operation WifProvidersPage {
    output { providers: List<WifProviderWire>? from "workloadIdentityPoolProviders" }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WifProviderListWire }
  }

  operation WifPool {
    output { pool_name: String from "name", display_name: String? from "displayName", disabled: Bool?, state: String? }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WifPoolWire }
  }

  operation VerifiedFlag {
    output { verified: Bool? }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WireVerifiedFlag }
  }

  operation RootUncontracted {
    output {
      shape: WireUncontractedShape
    }
    readonly
    transport rest { method: GET, path: "/answer" }
    response { 200 => WireUncontractedShape }
  }

  operation Sibling {
    output {
      message: String from "message"
    }
    readonly
    transport rest { method: GET, path: "/answer" }
  }

  operation OptionalObserve {
    output {
      message: String from "message"
      expires_on: String? from "expires_on"
    }
    readonly
    transport rest { method: GET, path: "/answer" }
  }

}
