module test.fixture.fold_empty_init.control_return_fixed

import std.types { Int, List, NonEmptyStr, String }
import std.algebra { concat, filter, fold, length }

fn distinct(values: List<String>) -> List<String> {
  fold(values, init: [], f: (acc, value) => if length(filter(acc, item => item == value)) > 0 { acc } else { concat(acc, [value]) })
}
