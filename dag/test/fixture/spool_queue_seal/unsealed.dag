module test.fixture.spool_queue_seal.unsealed

import std.types { NonEmptyStr, String }
import std.nat { Nat }
import gunbc.spool_queue { SpoolKind, PartitionedSpoolKind }

// THE STRIPPED TWIN for test.claim.spool_queue_seal_witness: the SAME records as gunbc.spool_queue SpoolEntryKey and SpoolStore with the
// SAME field names and types (including the disjoint SpoolKind / PartitionedSpoolKind variants), WITHOUT the
// sole_constructor keyword, so the same forged text can be run against the twin and show the refusal is the keyword
// and not the shape, name or field types.

type SpoolEntryKey {
  kind: SpoolKind
  name: NonEmptyStr
}

type SpoolStore
  = UnpartitionedStore { kind: SpoolKind, instance_root: String }
  | UidPartitionedStore { kind: PartitionedSpoolKind, instance_root: String, uid: Nat }
