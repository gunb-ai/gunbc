module test.fixture.decl_facts_reflection.specimens

import std.types { String, Int }
import std.disposition {
  Disposition,
  Terminal,
  Scaffold,
  SingleAuthority,
  RealizationDispatch,
  ConstructionMechanism,
}
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField }

type LocalCarrierA
  = TaggedA { tag: String }
  | SharedNullaryA
  | OtherA

type LocalCarrierB
  = TaggedB { tag: String }
  | SharedNullaryB
  | OtherB

data whole_declaration_anchor: String = "anchor"

data named_field_anchor: String = "named-anchor"

data disposition_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "test.fixture.decl_facts_reflection.specimens",
    decl_name: "whole_declaration_anchor",
    field: WholeDeclaration,
  },
}

data scaffold_named_field_bind: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "test.fixture.decl_facts_reflection.specimens",
    decl_name: "named_field_anchor",
    field: NamedField { field_name: "dissolves_to" },
  },
}

data terminal_specimen: Disposition = Terminal { reason: "witness-terminal" }

data local_a_scaffold: LocalCarrierA = TaggedA { tag: "carrier-a" }

data local_b_scaffold: LocalCarrierB = TaggedB { tag: "carrier-b" }

data local_a_shared_nullary: LocalCarrierA = SharedNullaryA

data local_b_shared_nullary: LocalCarrierB = SharedNullaryB

data mechanism_single_authority: ConstructionMechanism = SingleAuthority

data mechanism_realization_dispatch: ConstructionMechanism = RealizationDispatch

data missing_variant_specimen: Disposition = Scaffold {
  dissolves_to: Terminal { reason: "phantom-mechanism" },
  bind: DeclarationRef {
    module_path: "test.fixture.decl_facts_reflection.specimens",
    decl_name: "whole_declaration_anchor",
    field: WholeDeclaration,
  },
}

data planted_scaffold_specimen: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "test.fixture.decl_facts_reflection.specimens",
    decl_name: "planted_scaffold_specimen",
    field: WholeDeclaration
  }
}

data planted_terminal_specimen: Disposition = Terminal {
  reason: "fixture terminal arm"
}

data planted_nullary_disposition_specimen: Disposition = SingleAuthority

data planted_named_field_ref_specimen: DeclarationRef = DeclarationRef {
  module_path: "test.fixture.decl_facts_reflection.specimens",
  decl_name: "planted_scaffold_specimen",
  field: NamedField { field_name: "dissolves_to" }
}

data planted_plain_int_specimen: Int = 42

data planted_plain_string_specimen: String = "hello"

