module test.fixture.decl_facts_reflection.witness_support

import std.types { List }
import v2.std.decl_facts_skeleton {
  DeclFactQualifiedNameResolution,
  decl_fact_skeleton_for_resolution,
  resolve_decl_fact_by_qualified_name,
}
import v2.std.decl_index { DeclFact, decl_facts }
import v2.std.node { Node }
import v2.std.collection { Absent, Present }

data decl_facts_reflection_fixture_pool_roots: List<String> = [
  "dag/test/fixture/decl_facts_reflection",
]

fn decl_facts_reflection_fixture_facts() -> List<DeclFact> {
  decl_facts(pool_roots: decl_facts_reflection_fixture_pool_roots)
}

fn decl_fact_skeleton_for_qualified_name(
  facts: List<DeclFact>,
  qn: String
) -> Node? {
  decl_fact_skeleton_for_resolution(
    resolution: resolve_decl_fact_by_qualified_name(facts: facts, qn: qn)
  )
}
