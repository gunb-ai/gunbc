module test.fixture.cross_file_clause_e_fixture


data cross_file_clause_e_fixture_note: String = "Controlled cross-file clause-(e) fixture for witness tests only — hand-built transports exercising projection law. NOT production authority; production admissions must consume parser-produced closures via v1.gunbc.namespace_reference_derived_closure_clause_e_production."

fn cross_file_clause_e_fixture_span() -> std.types.SourceSpan {
  std.types.SourceSpan { file: "app/consumer.dag", start: 1, end: 2 }
}

fn cross_file_clause_e_fixture_path(terminal: std.occurrence_identity.OccurrenceId) -> std.occurrence_identity.OccurrenceContainmentPath {
  std.occurrence_identity.OccurrenceContainmentPath {
    ancestors: [std.occurrence_identity.OccurrenceId { value: 20 }],
    terminal: terminal,
  }
}

fn cross_file_clause_e_fixture_index_entry(
  occurrence: std.occurrence_identity.OccurrenceId,
  authored_name: String,
) -> std.occurrence_identity.OccurrenceIndexEntry {
  std.occurrence_identity.OccurrenceIndexEntry {
    projection: std.occurrence_identity.OccurrenceProjection {
      occurrence: occurrence,
      authored_name: authored_name,
      diagnostic_span: cross_file_clause_e_fixture_span(),
    },
    containment: cross_file_clause_e_fixture_path(terminal: occurrence),
  }
}

fn cross_file_clause_e_fixture_provider_transport() -> std.occurrence_identity.OccurrenceTransport {
  let helper = std.occurrence_identity.OccurrenceId { value: 300 }
  let helper_path = cross_file_clause_e_fixture_path(terminal: helper)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [cross_file_clause_e_fixture_index_entry(occurrence: helper, authored_name: "helper")],
    },
    declarations: [
      std.occurrence_identity.DeclarationOccurrence {
        occurrence: helper,
        containment: helper_path,
        category: std.occurrence_identity.LexicalValueOccurrence,
        diagnostic_span: cross_file_clause_e_fixture_span(),
      },
    ],
    references: [],
  }
}

fn cross_file_clause_e_fixture_consumer_transport() -> std.occurrence_identity.OccurrenceTransport {
  let ref_one = std.occurrence_identity.OccurrenceId { value: 200 }
  let ref_two = std.occurrence_identity.OccurrenceId { value: 201 }
  let ref_one_path = cross_file_clause_e_fixture_path(terminal: ref_one)
  let ref_two_path = cross_file_clause_e_fixture_path(terminal: ref_two)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        cross_file_clause_e_fixture_index_entry(occurrence: ref_one, authored_name: "helper"),
        cross_file_clause_e_fixture_index_entry(occurrence: ref_two, authored_name: "helper"),
      ],
    },
    declarations: [],
    references: [
      std.occurrence_identity.ReferenceOccurrence {
        occurrence: ref_one,
        containment: ref_one_path,
        category: std.occurrence_identity.LexicalValueOccurrence,
        diagnostic_span: cross_file_clause_e_fixture_span(),
      },
      std.occurrence_identity.ReferenceOccurrence {
        occurrence: ref_two,
        containment: ref_two_path,
        category: std.occurrence_identity.LexicalValueOccurrence,
        diagnostic_span: cross_file_clause_e_fixture_span(),
      },
    ],
  }
}

fn cross_file_clause_e_fixture_module_path(dotted: String) -> std.types.NonEmptyStr {
  dotted as std.types.NonEmptyStr
}

fn cross_file_clause_e_fixture_authored_order(occurrence: std.occurrence_identity.OccurrenceId) -> std.occurrence_binding_candidates.AuthoredOrderRow {
  std.occurrence_binding_candidates.AuthoredOrderRow {
    occurrence: occurrence,
    ordinal: std.occurrence_identity.AuthoredTokenOrdinal { value: occurrence.value },
  }
}

fn cross_file_clause_e_fixture_consumer_row() -> std.occurrence_binding_candidates.CrossFileBindingClosureRow {
  let transport = cross_file_clause_e_fixture_consumer_transport()
  let consumer_module = cross_file_clause_e_fixture_module_path(dotted: "app.consumer")
  std.occurrence_binding_candidates.CrossFileBindingClosureRow {
    transport: transport,
    inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 200 }, module_path: consumer_module },
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId { value: 201 }, module_path: consumer_module },
      ],
      exposure_rows: [],
      authored_order_rows: [
        cross_file_clause_e_fixture_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 200 }),
        cross_file_clause_e_fixture_authored_order(occurrence: std.occurrence_identity.OccurrenceId { value: 201 }),
      ],
    },
    module_path: consumer_module,
    file_path: "app/consumer.dag",
  }
}

fn cross_file_clause_e_fixture_provider_row() -> std.occurrence_binding_candidates.CrossFileBindingClosureRow {
  let transport = cross_file_clause_e_fixture_provider_transport()
  let provider_module = cross_file_clause_e_fixture_module_path(dotted: "app.provider")
  let helper = std.occurrence_identity.OccurrenceId { value: 300 }
  let helper_path = cross_file_clause_e_fixture_path(terminal: helper)
  std.occurrence_binding_candidates.CrossFileBindingClosureRow {
    transport: transport,
    inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: helper, module_path: provider_module },
      ],
      exposure_rows: [
        std.occurrence_binding_candidates.DeclarationExposureRow {
          occurrence: helper,
          exposure: std.occurrence_binding_candidates.declaration_exposure_from_containment(
            module_path: provider_module,
            containment: helper_path,
            grounding: std.occurrence_binding_candidates.CrossFileProviderExportedExposure,
          ),
        },
      ],
      authored_order_rows: [cross_file_clause_e_fixture_authored_order(occurrence: helper)],
    },
    module_path: provider_module,
    file_path: "app/provider.dag",
  }
}

fn cross_file_clause_e_fixture_unrelated_loaded_provider_transport(
  declaration_authored_name: String,
) -> std.occurrence_identity.OccurrenceTransport {
  let decl = std.occurrence_identity.OccurrenceId { value: 400 }
  let decl_path = cross_file_clause_e_fixture_path(terminal: decl)
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: [
        cross_file_clause_e_fixture_index_entry(
          occurrence: decl,
          authored_name: declaration_authored_name,
        ),
      ],
    },
    declarations: [
      std.occurrence_identity.DeclarationOccurrence {
        occurrence: decl,
        containment: decl_path,
        category: std.occurrence_identity.LexicalValueOccurrence,
        diagnostic_span: cross_file_clause_e_fixture_span(),
      },
    ],
    references: [],
  }
}

fn cross_file_clause_e_fixture_unrelated_loaded_provider_row(
  declaration_authored_name: String,
  module_dotted: String,
  file_path: std.types.FilePath,
) -> std.occurrence_binding_candidates.CrossFileBindingClosureRow {
  let transport = cross_file_clause_e_fixture_unrelated_loaded_provider_transport(
    declaration_authored_name: declaration_authored_name,
  )
  let provider_module = cross_file_clause_e_fixture_module_path(dotted: module_dotted)
  let decl = std.occurrence_identity.OccurrenceId { value: 400 }
  let decl_path = cross_file_clause_e_fixture_path(terminal: decl)
  std.occurrence_binding_candidates.CrossFileBindingClosureRow {
    transport: transport,
    inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
      module_paths: [
        std.occurrence_binding_candidates.OccurrenceModulePathRow { occurrence: decl, module_path: provider_module },
      ],
      exposure_rows: [
        std.occurrence_binding_candidates.DeclarationExposureRow {
          occurrence: decl,
          exposure: std.occurrence_binding_candidates.declaration_exposure_from_containment(
            module_path: provider_module,
            containment: decl_path,
            grounding: std.occurrence_binding_candidates.CrossFileProviderExportedExposure,
          ),
        },
      ],
      authored_order_rows: [cross_file_clause_e_fixture_authored_order(occurrence: decl)],
    },
    module_path: provider_module,
    file_path: file_path,
  }
}

fn cross_file_clause_e_fixture_baseline_assembled_closure() -> std.occurrence_binding_candidates.AssembledCrossFileBindingClosure {
  std.occurrence_binding_candidates.assemble_cross_file_binding_closure(
    consumer: cross_file_clause_e_fixture_consumer_row(),
    providers: [cross_file_clause_e_fixture_provider_row()],
  )
}

fn cross_file_clause_e_fixture_perturbed_assembled_closure(
  unrelated_loaded_provider: std.occurrence_binding_candidates.CrossFileBindingClosureRow,
) -> std.occurrence_binding_candidates.AssembledCrossFileBindingClosure {
  std.occurrence_binding_candidates.assemble_cross_file_binding_closure(
    consumer: cross_file_clause_e_fixture_consumer_row(),
    providers: [
      cross_file_clause_e_fixture_provider_row(),
      unrelated_loaded_provider,
    ],
  )
}

fn cross_file_clause_e_fixture_assembled_closure() -> std.occurrence_binding_candidates.AssembledCrossFileBindingClosure {
  cross_file_clause_e_fixture_baseline_assembled_closure()
}

fn cross_file_clause_e_fixture_provider_file() -> std.types.FilePath {
  "app/provider.dag"
}
