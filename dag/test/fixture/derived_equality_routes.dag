module test.fixture.derived_equality_routes

import std.occurrence_identity { OccurrenceId, OccurrenceMinted, OccurrenceSynthetic }
import v2.std.node { Atom, Node, NodeOccurrence, Symbol, TypeNode }

// WHAT DERIVED `==` ANSWERS (std.operator_realization EqualityPlan), as plain functions so the SAME
// fixture runs through the interpreter (v2.test.claim.derived_equality_routes) and through seed-emitted
// Rust (gunbc.instruments.derived_equality_routes_native, label //gunbc/instruments:derived-equality-routes).
// Each pair differs in exactly one respect: a bare Node member compares as a VALUE
// (v2.std.node node_equal_ignoring_provenance), a NodeOccurrence member as the SAME OCCURRENCE
// (node_same_occurrence). Each function returns the comparison's raw answer; the expected answer is
// written independently by each consumer.

fn deq_leaf(name: Symbol, at: Int) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: name } }, children: [], occurrence_id: OccurrenceMinted { id: OccurrenceId { value: at } } }
}

fn deq_synthetic_leaf(name: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: name } }, children: [], occurrence_id: OccurrenceSynthetic }
}

type DeqValue {
  value: Node
}

type DeqAt {
  at: NodeOccurrence
}

type DeqBoth {
  value: Node
  at: NodeOccurrence
}

// Structurally equal, distinct occurrences (x1, x2); the same ordinal with a different structure (y1).
fn deq_x1() -> Node { deq_leaf(name: ^deq_x, at: 1) }
fn deq_x2() -> Node { deq_leaf(name: ^deq_x, at: 2) }
fn deq_y1() -> Node { deq_leaf(name: ^deq_y, at: 1) }

// OCCURRENCE-ONLY PAIR.
fn deq_value_member_occurrence_only() -> Bool { DeqValue { value: deq_x1() } == DeqValue { value: deq_x2() } }
fn deq_occurrence_member_occurrence_only() -> Bool { DeqAt { at: NodeOccurrence { node: deq_x1() } } == DeqAt { at: NodeOccurrence { node: deq_x2() } } }

// STRUCTURE-ONLY PAIR.
fn deq_value_member_structure_only() -> Bool { DeqValue { value: deq_x1() } == DeqValue { value: deq_y1() } }
fn deq_occurrence_member_structure_only() -> Bool { DeqAt { at: NodeOccurrence { node: deq_x1() } } == DeqAt { at: NodeOccurrence { node: deq_y1() } } }

// THE SAME OCCURRENCE.
fn deq_occurrence_member_same() -> Bool { DeqAt { at: NodeOccurrence { node: deq_x1() } } == DeqAt { at: NodeOccurrence { node: deq_x1() } } }

// SYNTHETIC: every synthetic node shares OccurrenceSynthetic, so the occurrence question degrades to
// structure, deliberately (v2.std.node NodeOccurrence).
fn deq_synthetic_same_structure() -> Bool { NodeOccurrence { node: deq_synthetic_leaf(name: ^deq_x) } == NodeOccurrence { node: deq_synthetic_leaf(name: ^deq_x) } }
fn deq_synthetic_different_structure() -> Bool { NodeOccurrence { node: deq_synthetic_leaf(name: ^deq_x) } == NodeOccurrence { node: deq_synthetic_leaf(name: ^deq_y) } }

// ONE COMPOSITE ROUTING THROUGH BOTH, each member decided by its own type.
fn deq_composite_value_differs() -> Bool { DeqBoth { value: deq_x1(), at: NodeOccurrence { node: deq_x1() } } == DeqBoth { value: deq_x2(), at: NodeOccurrence { node: deq_x1() } } }
fn deq_composite_occurrence_differs() -> Bool { DeqBoth { value: deq_x1(), at: NodeOccurrence { node: deq_x1() } } == DeqBoth { value: deq_x1(), at: NodeOccurrence { node: deq_x2() } } }
