module test.fixture.legacy_intake_scene

// SRV2'S shell-typed-invocation, BUILT BY THE PRODUCTION VERBS AND AGED THROUGH THE FORMAT IT WAS
// WRITTEN IN, then converted in place and corrected -- the scene the BaseAdvance follow-up's
// supersession claims are about (parent ruling on gunbc#13402).
//
//   c0  root, message 'project base: R0'             (v8 seed)
//   c1  candidate on c0, its attempt branched from R1 (stale)
//   c2  squash of c1 into c0                          (the false integration)
//   c3  candidate on c0, its attempt branched from R1 (stale, never integrated)
//   --- aged through a real v8 document: every commit reads IntakeUnrecordedByFormat ---
//   --- converted (belt_legacy_intake_plan + record_legacy_intakes) ---
//   c4  IntakeAdvance R0..R1, child of c0
//   c5  fresh recapture on c4, touching a path c2 did not (an overlap is a merge conflict an owner
//       resolves, which the supersession admission neither causes nor hides)
//   c6  a second fresh capture on c4
//
// Every row is produced by the production verbs; a setup step that fails yields no scene.

import std.types { String, List, NonEmptyStr, Int }
import std.minted_identity { MintedId }
import extdeps.git.object_store { git_object_id_from_untagged_hex }
import gunbc.scm.ancestry { RepositoryCommitRef }
import gunbc.scm.intake { IntakeRevision, GitIntakeRevision }
import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  encode_repository_v8, decode_repository_v8_index, decode_repository_v7_finish,
  ShardedIndexDecoded, ShardedIndexRefused, RepositoryDecoded, RepositoryDecodeRefused,
  record_legacy_intakes, LegacyIntakesRecorded, LegacyIntakesNothingUnrecorded, LegacyIntakesRefused,
}
import gunbc.scm.squash_merge { squash_merge, SquashMerged }
import gunbc.roadmap.roadmap_belt_commit { belt_candidate_commit_message }
import gunbc.roadmap_belt_actuate {
  belt_legacy_intake_plan, LegacyIntakePlanned, LegacyIntakePlanRefused, BeltLegacyCaptureBase,
  BaseShaObserved, BeltBaseSha,
}
import test.fixture.scm_repository_builder { MbBuild, MbBuilt, MbSetupFailed, mb_start, mb_stage, mb_commit, mb_head, mb_at, mb_intake_advance }

data legacy_r0_hex: String = "d012e00a3f1accbfbdafa732a7f9eb892ffa1e44"
data legacy_r1_hex: String = "b7f9070ca82026ba63fbf55960a9e3a0266b3285"

fn legacy_rev(hex: String) -> IntakeRevision? {
  match git_object_id_from_untagged_hex(hex: hex) {
    Absent => none
    Present { value: id } => Present { value: GitIntakeRevision { id: id } }
  }
}

fn legacy_ref(ordinal: Int) -> RepositoryCommitRef {
  RepositoryCommitRef { identity: MintedId { ordinal: ordinal } }
}

fn aged_through_v8(repository: RepositoryEnvelope) -> RepositoryEnvelope? {
  match decode_repository_v8_index(v: encode_repository_v8(repo: repository)) {
    ShardedIndexRefused { cause: _ } => none
    ShardedIndexDecoded { index } =>
      match decode_repository_v7_finish(v: index.document, store: repository.store, commit_policy: index.commit_policy) {
        RepositoryDecodeRefused { cause: _ } => none
        RepositoryDecoded { envelope } => Present { value: envelope }
      }
  }
}

// c0..c3, as the v8 belt left them.
fn legacy_unconverted() -> RepositoryEnvelope? {
  let base = mb_commit(build: mb_stage(build: mb_start(), path: "src/a.dag", text: "A at R0"), message: join(["project base: ", legacy_r0_hex], ""))
  let c1 = mb_commit(build: mb_stage(build: base, path: "src/a.dag", text: "A as worker 1 left it"), message: belt_candidate_commit_message(node_id: "n", attempt_key: "1") as String)
  match c1 {
    MbSetupFailed => none
    MbBuilt { repository, at: _ } =>
      match squash_merge(repository: repository, target: legacy_ref(ordinal: 0), source: legacy_ref(ordinal: 1), message: "integrate 1") {
        SquashMerged { repository: merged, reference: _ } =>
          match mb_commit(
            build: mb_stage(build: mb_at(build: MbBuilt { repository: merged, at: none }, target: legacy_ref(ordinal: 0)), path: "src/b.dag", text: "B as worker 3 left it"),
            message: belt_candidate_commit_message(node_id: "n", attempt_key: "3") as String,
          ) {
            MbSetupFailed => none
            MbBuilt { repository: with_c3, at: _ } => aged_through_v8(repository: with_c3)
          }
        _ => none
      }
  }
}

fn legacy_observed(c1: String, c3: String) -> List<BeltLegacyCaptureBase> {
  [
    BeltLegacyCaptureBase { commit: 1, base: BaseShaObserved { base_sha: c1 } },
    BeltLegacyCaptureBase { commit: 3, base: BaseShaObserved { base_sha: c3 } },
  ]
}

// c0..c3 converted in place from the observed capture bases.
fn legacy_converted(observed: List<BeltLegacyCaptureBase>) -> RepositoryEnvelope? {
  match legacy_unconverted() {
    Absent => none
    Present { value: legacy } =>
      match belt_legacy_intake_plan(commits: legacy.commits, observed: observed) {
        LegacyIntakePlanRefused { detail: _ } => none
        LegacyIntakePlanned { records } =>
          match record_legacy_intakes(repository: legacy, records: records) {
            LegacyIntakesRecorded { repository } => Present { value: repository }
            LegacyIntakesNothingUnrecorded => none
            LegacyIntakesRefused { cause: _ } => none
          }
      }
  }
}

// c0..c6: the converted line, an advance R0..R1, and two fresh captures on it.
fn legacy_corrective_scene() -> RepositoryEnvelope? {
  match legacy_converted(observed: legacy_observed(c1: legacy_r1_hex, c3: legacy_r1_hex)) {
    Absent => none
    Present { value: converted } =>
      match legacy_rev(hex: legacy_r0_hex) {
        Absent => none
        Present { value: r0 } =>
          match legacy_rev(hex: legacy_r1_hex) {
            Absent => none
            Present { value: r1 } => {
              let advanced = mb_intake_advance(
                build: mb_stage(build: mb_at(build: MbBuilt { repository: converted, at: none }, target: legacy_ref(ordinal: 0)), path: "src/up.dag", text: "upstream at R1"),
                message: "advance R0..R1", from: r0, to: r1,
              )
              let c5 = mb_commit(build: mb_stage(build: advanced, path: "src/d.dag", text: "D as the recapture left it"), message: belt_candidate_commit_message(node_id: "n", attempt_key: "5") as String)
              match c5 {
                MbSetupFailed => none
                MbBuilt { repository, at: _ } =>
                  match mb_commit(
                    build: mb_stage(build: mb_at(build: MbBuilt { repository: repository, at: none }, target: legacy_ref(ordinal: 4)), path: "src/c.dag", text: "C"),
                    message: belt_candidate_commit_message(node_id: "n", attempt_key: "6") as String,
                  ) {
                    MbSetupFailed => none
                    MbBuilt { repository: scene, at: _ } => Present { value: scene }
                  }
              }
            }
          }
      }
  }
}
