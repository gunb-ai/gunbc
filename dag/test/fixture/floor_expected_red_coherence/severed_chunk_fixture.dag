module test.fixture.floor_expected_red_coherence.severed_chunk_fixture

import std.algebra { Cons, Empty }
import v2.std.algebra { list_flat_map }
import v2.std.collection { List }
import v2.std.text { String }

// Mimics floor_expected_red.dag's chunk/aggregator shape at fixture scale: several
// chunk_NN functions, each a pure nested Cons/Empty literal chain of string-literal
// identities, plus a hand-authored aggregator that links them by call. This specimen
// deliberately severs chunk_severed from the aggregator — chunk_severed is declared
// and its body authors two identities, but no call to it appears in
// severed_fixture_chunks(). This is the #8437 incident shape in miniature: the
// aggregator stays well-formed and the roster stays non-empty, so the missing
// identities are invisible to anything that does not compare authored bodies against
// the evaluated roster.

fn severed_fixture_chunk_linked_a() -> List<String> {
  Cons { head: "fixture.severed.linked_a_first", tail: Cons { head: "fixture.severed.linked_a_second", tail: Empty {} } }
}

fn severed_fixture_chunk_linked_b() -> List<String> {
  Cons { head: "fixture.severed.linked_b_only", tail: Empty {} }
}

// SEVERED: authored here, never called below.
fn severed_fixture_chunk_severed() -> List<String> {
  Cons { head: "fixture.severed.orphaned_first", tail: Cons { head: "fixture.severed.orphaned_second", tail: Empty {} } }
}

fn severed_fixture_chunks() -> List<List<String>> {
  Cons { head: severed_fixture_chunk_linked_a(), tail: Cons { head: severed_fixture_chunk_linked_b(), tail: Empty {} } }
}

fn severed_fixture_roster() -> List<String> {
  list_flat_map(xs: severed_fixture_chunks(), f: fn(chunk) { chunk })
}
