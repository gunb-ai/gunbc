module test.fixture.floor_expected_red_coherence.severed_chunk_fixture


// Mimics floor_expected_red.dag's chunk/aggregator shape at fixture scale: several
// chunk_NN functions, each a pure nested std.algebra.Cons/std.algebra.Empty literal chain of string-literal
// identities, plus a hand-authored aggregator that links them by call. This specimen
// deliberately severs chunk_severed from the aggregator — chunk_severed is declared
// and its body authors two identities, but no call to it appears in
// severed_fixture_chunks(). This is the #8437 incident shape in miniature: the
// aggregator stays well-formed and the roster stays non-empty, so the missing
// identities are invisible to anything that does not compare authored bodies against
// the evaluated roster.

fn severed_fixture_chunk_linked_a() -> v2.std.collection.List<v2.std.text.String> {
  std.algebra.Cons { head: "fixture.severed.linked_a_first", tail: std.algebra.Cons { head: "fixture.severed.linked_a_second", tail: std.algebra.Empty {} } }
}

fn severed_fixture_chunk_linked_b() -> v2.std.collection.List<v2.std.text.String> {
  std.algebra.Cons { head: "fixture.severed.linked_b_only", tail: std.algebra.Empty {} }
}

// SEVERED: authored here, never called below.
fn severed_fixture_chunk_severed() -> v2.std.collection.List<v2.std.text.String> {
  std.algebra.Cons { head: "fixture.severed.orphaned_first", tail: std.algebra.Cons { head: "fixture.severed.orphaned_second", tail: std.algebra.Empty {} } }
}

fn severed_fixture_chunks() -> v2.std.collection.List<v2.std.collection.List<v2.std.text.String>> {
  std.algebra.Cons { head: severed_fixture_chunk_linked_a(), tail: std.algebra.Cons { head: severed_fixture_chunk_linked_b(), tail: std.algebra.Empty {} } }
}

fn severed_fixture_roster() -> v2.std.collection.List<v2.std.text.String> {
  v2.std.algebra.list_flat_map(xs: severed_fixture_chunks(), f: fn(chunk) { chunk })
}
