module test.fixture.service_depth_chain.chain

// Executed depth control for the fixed 5-pass budget in v1.service.expand_transitive_services_loop.
// The chain is authored CALLER-FIRST (f0 above f1 above f2 ...), which is the order the fold walks,
// so each pass propagates the service exactly one hop backwards and a 7-link chain needs 6 passes
// to reach f0. Declaration order is load-bearing: the same chain authored callee-first converges in
// one pass, which is why the budget's sufficiency is a property of authoring order rather than of
// the program.

import std.types { String, Unit }

service depth.Probe {
  operation Ping {
    input { tag: String }
    output { line: String from "stdout" }
    readonly
    transport shell { argv: ["echo", "{tag}"] }
    exit {
      0 => Unit
    }
  }
}

fn f0(tag: String) -> String { f1(tag: tag) }
fn f1(tag: String) -> String { f2(tag: tag) }
fn f2(tag: String) -> String { f3(tag: tag) }
fn f3(tag: String) -> String { f4(tag: tag) }
fn f4(tag: String) -> String { f5(tag: tag) }
fn f5(tag: String) -> String { f6(tag: tag) }
fn f6(tag: String) -> String { depth.Probe.Ping(tag: tag).line }
