module test.fixture.systemd_fence_stub

// ONE stand-in for `systemctl`, authored once here and imported by every wet witness whose fence carries a
// systemctl program. Review 90677 (§6b): two witnesses each built such a stub by string concatenation --
// `c_roadmap2_closing_cutover_witness.fx_fence_stub` and `roadmap.attempt_state_move_apply_wet_witness.fence_stub`
// -- and they had already drifted (one matched the verb at $1, the other at $2 after review 90637's typed
// reads added a `show` call). One rule, one home.
//
// WHY THE VERBS ARE NOT LITERALS HERE: they come from `extdeps.systemd.systemctl`'s own verb authorities
// (`systemctl_is_active_verb`, `systemctl_is_enabled_verb`, `systemctl_show_verb`), and the `show` answer
// lines are built through `systemd_unit_property_wire` over `SystemdUnitProperty`. So a producer that
// changes what it asks of systemctl changes this stub too -- which is exactly the drift the two local
// copies were. The stub matches the verb against ANY argument (`for a in "$@"`), not a positional slot,
// because the two producers ask in different shapes: the legacy-writer drift check execs
// `<ctl> is-active <unit>` (`dashboard_legacy_writer_drift`), while the metering-closing observation execs
// `<ctl> --user is-active <unit>` and one `<ctl> --user show --property=... <unit>`
// (`dashboard_metering_closing_writer_observation`). Positional matching is what broke when the second
// call was added; verb matching cannot break the same way.
//
// WHAT THIS SCAFFOLDS: it is a shell stand-in for a host transport. The capability that retires it is the
// bash-emit capability (host-effect scripts compiled from the DAG rather than concatenated here); until
// that lands, this is the single place the stand-in's shell exists.

import std.types { String, NonEmptyStr, List, Int }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.systemd { SystemdUnitProperty, MainPID, ControlGroup, systemd_unit_property_wire }
import extdeps.systemd.systemctl { systemctl_is_active_verb, systemctl_is_enabled_verb, systemctl_show_verb }

// What the stand-in answers per verb. `flip_after` < 0 means the is-active answer never changes; >= 0 means
// the first `flip_after` is-active questions read `active_answer` and every later one reads
// `active_late_answer`, counted through `counter_file` (the shape the move witness's flip control needs).
// `show_lines` are the exact `Name=value` lines one `show` prints -- build them with
// `systemctl_stub_show_line` so the KEY stays the upstream wire name.
type SystemctlStubAnswers {
  active_answer: String,
  active_exit: Int,
  enabled_answer: String,
  enabled_exit: Int,
  show_lines: List<String>,
  show_exit: Int,
  counter_file: String,
  flip_after: Int,
  active_late_answer: String
}

// One `Name=value` line of `systemctl show` output, keyed by the upstream wire name -- not by a literal.
fn systemctl_stub_show_line(unit_property: SystemdUnitProperty, value: String) -> String {
  join([systemd_unit_property_wire(property: unit_property) as String, "=", value], "")
}

// The quiescent baseline every fence witness needs: MainPID=0 (systemd's own answer for no main process,
// systemd.service(5)) and an ESTABLISHED empty ControlGroup (the unit's cgroup has been removed) from a
// `show` that exits 0 -- review 90637 rules that a failed read refuses, so the exit code is part of the
// answer, not decoration. is-active exits 3 for an inactive unit, as systemd does
// (org.freedesktop.systemd1(1)); the producers read the WORD, not the status.
fn systemctl_stub_quiescent_answers(active: String, enabled: String) -> SystemctlStubAnswers {
  SystemctlStubAnswers {
    active_answer: active,
    active_exit: 3,
    enabled_answer: enabled,
    enabled_exit: 0,
    show_lines: [
      systemctl_stub_show_line(unit_property: MainPID, value: "0"),
      systemctl_stub_show_line(unit_property: ControlGroup, value: ""),
    ],
    show_exit: 0,
    counter_file: "",
    flip_after: -1,
    active_late_answer: "",
  }
}

// The script itself: verbs from the upstream authorities, each answer on its verb, unknown verbs exit 1.
fn systemctl_fence_stub_script(answers: SystemctlStubAnswers) -> String {
  let active_arm =
    (if answers.flip_after >= 0 {
      join([
        "n=$(cat ", answers.counter_file, " 2>/dev/null || echo 0); n=$((n+1)); echo $n > ", answers.counter_file,
        "; if [ $n -gt ", to_string(value: answers.flip_after), " ]; then echo ", answers.active_late_answer,
        "; else echo ", answers.active_answer, "; fi; exit ", to_string(value: answers.active_exit), ";;",
      ], "")
    } else {
      join(["echo ", answers.active_answer, "; exit ", to_string(value: answers.active_exit), ";;"], "")
    })
  let show_arm = join([join(map(answers.show_lines, line => join(["printf '%s\\n' '", line, "'; "], "")), ""), "exit ", to_string(value: answers.show_exit), ";;"], "")
  join([
    "#!/bin/sh\nfor a in \"$@\"; do\ncase \"$a\" in\n",
    systemctl_is_active_verb as String, ") ", active_arm, "\n",
    systemctl_is_enabled_verb as String, ") echo ", answers.enabled_answer, "; exit ", to_string(value: answers.enabled_exit), ";;\n",
    systemctl_show_verb as String, ") ", show_arm, "\n",
    "esac\ndone\nexit 1\n",
  ], "")
}

// Write it executable into `dir` and hand back the program path the fence carries. Create-only, then
// read-back-verify: a stub that exists from an earlier run must carry THESE bytes or the witness runs
// against someone else's stub, so the path degrades to a nonexistent program (the claim goes red rather
// than passing on a stale stub).
fn systemctl_fence_stub_write(dir: String, name_tag: String, answers: SystemctlStubAnswers) -> String {
  let path = join([dir, "/../fence-systemctl-", name_tag], "")
  let body = systemctl_fence_stub_script(answers: answers)
  let written = Filesystem.WriteCreateNewWithMode(path: path, content: body, mode: 493).success || Filesystem.Read(path: path).content == body
  if written { path } else { "/nonexistent/fence-stub" }
}
