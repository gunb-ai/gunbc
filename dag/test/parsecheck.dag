module test.parsecheck
import std.types { Bool }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import test.claim.runner_shape_profile_witness_test {
  slot_shape_derives_six_cores_from_the_sixteen_gibibyte_anchor,
  decimal_and_binary_bases_are_not_interchangeable,
  a_basis_less_quote_refuses_to_derive_a_core_count,
  an_exact_multiple_does_not_gain_a_core,
  the_adoption_covers_the_ratio_and_refuses_storage,
}
fn parsecheck_main() -> ProcessExit {
  if slot_shape_derives_six_cores_from_the_sixteen_gibibyte_anchor()
    && decimal_and_binary_bases_are_not_interchangeable()
    && a_basis_less_quote_refuses_to_derive_a_core_count()
    && an_exact_multiple_does_not_gain_a_core()
    && the_adoption_covers_the_ratio_and_refuses_storage() {
    ExitSuccess
  } else {
    exit_failure(reason: "runner shape profile witness returned false")
  }
}
