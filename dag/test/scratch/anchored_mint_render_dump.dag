// TEMPORARY byte oracle for review 85414/85584/85591: renders the anchored host-key mint through
// bash_emit_stmts and writes it verbatim to a file, so the runbook's fenced block can be set to the
// model render byte-for-byte and the the_runbook_mint_block_is_the_model_render claim goes green.
// Deleted once the block lands; not an authority.
module test.scratch.anchored_mint_render_dump
import std.process { ExitSuccess, ExitFailure, ProcessExit, exit_failure }
import gunbc.host.anchored_host_transport { anchored_host_key_mint_shell }

fn mint_render_dump_wet() -> ProcessExit {
  let w = Filesystem.Write(path: "/tmp/mint_render_dump.txt", content: anchored_host_key_mint_shell())
  if w.success { ExitSuccess } else { exit_failure(reason: w.error) }
}
