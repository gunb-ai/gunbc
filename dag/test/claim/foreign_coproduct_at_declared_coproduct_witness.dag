module test.claim.foreign_coproduct_at_declared_coproduct_witness
// Foreign coproduct accepted where a bare nominal COPRODUCT is declared (calm-moth-138).
//
// WHAT THIS PROVES. A carrier coproduct (an `Outcome<T>`, a `Wrapper<T>`, or any foreign
// named coproduct) was ACCEPTED where a bare nominal COPRODUCT was declared, at the fn body
// (declared return), the direct-call argument, and the record-literal field. The product head
// refused it at a PRODUCT (`RefusedProductCoproductHeadMismatch`); #16699's general arm refused
// a structured head at a kernel SCALAR (`RefusedStructuredAtScalar`). Both keyed on the head
// being a different KIND. Coproduct-against-coproduct is the SAME KIND, so neither fired: the
// pair fell to `coproduct_payload_where_parent_required`, whose foreign-coproduct lookup keys on
// the produced SPELLING (`lookup_type_by_name`), so an APPLIED head such as `Outcome<C>` returned
// Absent and the pair was accepted with ZERO diagnostics -- and failed at runtime as a
// non-exhaustive match, or silently returned the wrong arm when the callee closed with `_` (the
// `step_if_text(step: Step)` that returned "", found by zesty-ram-689 in #16721).
//
// THE FIX IS THE DECLARATION-IDENTITY RULE #16699 REACHED, APPLIED TO THE COPRODUCT HEAD. One
// predicate, `v1.compiler.infer::coproduct_declared_head_rejects_foreign_coproduct`, consumed at
// the three positions the scalar arm already holds -- the relation,
// `v1.compiler.infer::declared_type_conformance_diags_core`, and the record-literal field chain --
// each DELEGATING to the one relation, so a coproduct-declared head admits only a value whose head
// resolves to its OWN declaration or a declared ALIAS of it (via `nominal_coproduct_head_name` +
// `application_type_names_compatible`, declaration identity, never spelling). The refusal reason is
// `InhabitanceRefusedReason RefusedDistinctCoproductHead`.
//
// WHAT THE CLAIMS SEPARATE. A RED that goes green is caught by the rule being wrong (an
// always-clean filter) OR by the seam not being compiled (an always-zero census). So every refusal
// is paired, at the SAME position, with the value that legitimately inhabits it -- the SAME
// coproduct, or a declared alias -- and the whole witness is read against a not-idle control that
// plants a different definite refusal on this same census route (`the_harness_is_not_idle`). The
// same coproduct, a declared alias, and a generic formal stay clean. See
// @ref(gunbc.recurring_failure_mode.declared_type_wall_keyed_on_the_value_being_a_kernel::declared_type_wall_keyed_on_the_value_being_a_kernel)
// ::declared_type_wall_keyed_on_the_value_being_a_kernel (the dated 2026-11-19 receipt `#calm-moth-138`).

import std.types { Bool, Int, String }
import gunbc.compile_diagnostic_census { compile_dag_diagnostic_census, CensusObserved, CensusNotRunnable, census_blocking_rows, census_rows_of_class, census_total_count }

fn blocking_of_class(source: String, wanted: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: census_blocking_rows(rows: rows), wanted: wanted))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn blocking_total(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// A bare nominal COPRODUCT and a FOREIGN named coproduct, both spelled in the fixture (no v2.std.
// diagnostic closure is pulled in): the judgment reads a head's DECLARATION, so a same-file coproduct
// exercises the same boundary as a carrier imported from a library. `C` is the declared head; `Pack`
// is a foreign coproduct, so a `Pack` value at a `C` position has no route to `C`.
//
// THE THREE RED SHAPES: the foreign coproduct written at a position declared `C`.
data foreign_coproduct_return_source: String = "module probe_foreign_coproduct_return\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Pack = One { n: String } | Two { m: String }\nfn make_pack() -> Pack { One { n: \"x\" } }\nfn probe() -> C { make_pack() }\n"

data foreign_coproduct_argument_source: String = "module probe_foreign_coproduct_argument\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Pack = One { n: String } | Two { m: String }\nfn make_pack() -> Pack { One { n: \"x\" } }\nfn h(c: C) -> Int { 1 }\nfn probe() -> Int { h(c: make_pack()) }\n"

data foreign_coproduct_record_field_source: String = "module probe_foreign_coproduct_record_field\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Pack = One { n: String } | Two { m: String }\nfn make_pack() -> Pack { One { n: \"x\" } }\ntype Box { c: C }\nfn probe() -> Box { Box { c: make_pack() } }\n"

// THE APPLIED-CARRIER RED (the repro zesty-ram-689 filed): a GENERIC coproduct applied over `C`
// (`Pack<C>`) at a declared `C`. This is the shape the trailing foreign-coproduct lookup missed,
// because `lookup_type_by_name` keys on the whole applied spelling `Pack<C>`, which is not a
// declared name and returns Absent. The head authority resolves it to the constructor `Pack`, a
// different declaration than `C`, and the pair is refused.
data applied_carrier_argument_source: String = "module probe_applied_carrier_argument\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Pack<T> = One { n: T } | Two { m: T }\nfn make_pack<T>(n: T) -> Pack<T> { One { n: n } }\nfn h(c: C) -> Int { 1 }\nfn probe() -> Int { h(c: make_pack(n: \"hello\")) }\n"

// THE DISCRIMINATING CONTROLS. The SAME coproduct, at the SAME three positions, declared as itself:
// a value that legitimately inhabits the head. If the new arm read as a blanket refusal of a
// coproduct at a coproduct, these three go red; that is the whole point of pairing them.
data same_coproduct_return_source: String = "module probe_same_coproduct_return\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\nfn make_c() -> C { A { a: \"hello\" } }\nfn probe() -> C { make_c() }\n"

data same_coproduct_argument_source: String = "module probe_same_coproduct_argument\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\nfn h(c: C) -> Int { 1 }\nfn probe() -> Int { h(c: A { a: \"hello\" }) }\n"

data same_coproduct_record_field_source: String = "module probe_same_coproduct_record_field\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Box { c: C }\nfn probe() -> Box { Box { c: A { a: \"hello\" } } }\n"

// A DECLARED ALIAS of the coproduct, at the parameter and the field: the same declaration written
// under another name. DESIGN.md "Single authority" -- keying on spelling rather than declaration
// identity (text crossings) is the failure this arm must not reintroduce; these controls pin the
// alias route (`alias_identity_in_judgment` and the resolved heads collapsing to one declaration).
data alias_coproduct_argument_source: String = "module probe_alias_coproduct_argument\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Alias = C\nfn make_alias() -> Alias { A { a: \"hello\" } }\nfn h(c: C) -> Int { 1 }\nfn probe() -> Int { h(c: make_alias()) }\n"

data alias_coproduct_record_field_source: String = "module probe_alias_coproduct_record_field\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\ntype Alias = C\nfn make_alias() -> Alias { A { a: \"hello\" } }\ntype Box { c: C }\nfn probe() -> Box { Box { c: make_alias() } }\n"

// THE APPLIED-SAME-COPRODUCT CONTROL. The same constructor at its own applied position: a `Pack<String>`
// at a declared `Pack<String>`. The head AGREES (both resolve to the constructor `Pack`), so the arm
// does not fire and the applied-argument judgments keep their verdict. A head comparison keyed on the
// full applied spelling rather than the constructor would refuse this legitimate value.
data applied_same_coproduct_argument_source: String = "module probe_applied_same_coproduct_argument\nimport std.types { String, Int }\ntype Pack<T> = One { n: T } | Two { m: T }\nfn make_pack<T>(n: T) -> Pack<T> { One { n: n } }\nfn h(p: Pack<String>) -> Int { 1 }\nfn probe() -> Int { h(p: make_pack(n: \"hello\")) }\n"

// THE GENERIC-FORMAL CONTROL. A generic coproduct formal: the relation abstains with
// UndecidableGenericFormal before this arm, and the heads agree in any case. Generic instantiation
// must stay clean -- the arm is granted only the three admitted lanes and keeps every recorded
// abstention.
data generic_coproduct_argument_source: String = "module probe_generic_coproduct_argument\nimport std.types { String, Int }\ntype Pack<T> = One { n: T } | Two { m: T }\nfn make_pack<T>(n: T) -> Pack<T> { One { n: n } }\nfn use_pack<T>(x: Pack<T>) -> Int { 1 }\nfn probe() -> Int { use_pack(x: make_pack(n: \"hello\")) }\n"

// THE NOT-IDLE CONTROL. A kernel String at a coproduct position is refused by a rule that predates
// this PR (the kernel-at-structured arm) and lands on this SAME census route with the SAME class, so
// an always-zero census -- a broken route, a module that silently failed to compile -- cannot pass the
// REDs above as vacuous.
data kernel_at_coproduct_argument_source: String = "module probe_kernel_at_coproduct_argument\nimport std.types { String, Int }\ntype C = A { a: String } | B { b: String }\nfn h(c: C) -> Int { 1 }\nfn probe() -> Int { h(c: \"hello\") }\n"

// --- LIST-LITERAL CONTROLS: a list literal at a FreeMonoid or List parameter stays clean. ---
// THE DEFECT #16798's revert confused: the predicate fired on `right: refusal` (a bare coproduct
// value at FreeMonoid<T>), which IS a genuine refusal. The list-literal form `right: [refusal]`
// must stay clean, proving the wall does not mistake a container's ELEMENT head for the container.

// One-element list literal at a generic FreeMonoid<T> parameter (the firmware shape).
data list_lit_one_at_freemonoid_source: String = "module probe_list_lit_one_at_freemonoid\nimport std.types { String, Int }\nimport std.algebra { FreeMonoid, list_append }\ntype C = A { a: String } | B { b: String }\nfn make_c() -> C { A { a: \"hello\" } }\nfn probe(xs: FreeMonoid<C>) -> FreeMonoid<C> { list_append(left: xs, right: [make_c()]) }\n"

// Multi-element list literal at a generic FreeMonoid<T> parameter.
data list_lit_multi_at_freemonoid_source: String = "module probe_list_lit_multi_at_freemonoid\nimport std.types { String, Int }\nimport std.algebra { FreeMonoid, list_append }\ntype C = A { a: String } | B { b: String }\nfn make_c() -> C { A { a: \"hello\" } }\nfn probe(xs: FreeMonoid<C>) -> FreeMonoid<C> { list_append(left: xs, right: [make_c(), B { b: \"x\" }]) }\n"

// List literal at a concrete List<C> parameter (not generic, uses the kernel container alias).
data list_lit_at_concrete_list_source: String = "module probe_list_lit_at_concrete_list\nimport std.types { String, Int, List }\nimport std.algebra { FreeMonoid }\ntype C = A { a: String } | B { b: String }\nfn h(xs: List<C>) -> Int { 1 }\nfn probe() -> Int { h(xs: [A { a: \"hello\" }]) }\n"

// Positive control: list literal at a FreeMonoid<Int> parameter (scalar element, no coproduct).
data list_lit_at_freemonoid_scalar_control_source: String = "module probe_list_lit_at_freemonoid_scalar\nimport std.types { String, Int }\nimport std.algebra { FreeMonoid, list_append }\nfn probe(xs: FreeMonoid<Int>) -> FreeMonoid<Int> { list_append(left: xs, right: [1]) }\n"

// Positive control: list literal at a concrete List<Int> parameter.
data list_lit_at_concrete_list_scalar_control_source: String = "module probe_list_lit_at_concrete_list_scalar\nimport std.types { String, Int, List }\nimport std.algebra { FreeMonoid }\nfn h(xs: List<Int>) -> Int { 1 }\nfn probe() -> Int { h(xs: [42]) }\n"

// Red control: a bare foreign coproduct (NOT a list literal) at a FreeMonoid return refuses.
data bare_foreign_coproduct_at_freemonoid_source: String = "module probe_bare_foreign_coproduct_at_freemonoid\nimport std.types { String, Int }\nimport std.algebra { FreeMonoid, Empty }\ntype C = A { a: String } | B { b: String }\ntype Pack = One { n: String } | Two { m: String }\nfn make_pack() -> Pack { One { n: \"x\" } }\nfn h() -> FreeMonoid<C> { make_pack() }\n"

// --- RED: a foreign coproduct at a declared coproduct, one claim per position. ---
test fn a_foreign_coproduct_at_a_declared_coproduct_return_refuses() -> Bool {
  blocking_of_class(source: foreign_coproduct_return_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

test fn a_foreign_coproduct_at_a_declared_coproduct_parameter_refuses() -> Bool {
  blocking_of_class(source: foreign_coproduct_argument_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

test fn a_foreign_coproduct_at_a_declared_coproduct_record_field_refuses() -> Bool {
  blocking_of_class(source: foreign_coproduct_record_field_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// THE APPLIED HEAD, THE SHAPE THAT WAS ACCEPTED. This is the defect zesty-ram-689 found: an applied
// carrier over C at a declared C, the case whose foreign-coproduct lookup returned Absent.
test fn an_applied_carrier_at_a_declared_coproduct_parameter_refuses() -> Bool {
  blocking_of_class(source: applied_carrier_argument_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// --- CONTROLS: the same coproduct at the same three positions stays clean. ---
test fn a_coproduct_at_its_own_declared_coproduct_return_is_clean() -> Bool {
  blocking_total(source: same_coproduct_return_source) == 0
}

test fn a_coproduct_at_its_own_declared_coproduct_parameter_is_clean() -> Bool {
  blocking_total(source: same_coproduct_argument_source) == 0
}

test fn a_coproduct_at_its_own_declared_coproduct_record_field_is_clean() -> Bool {
  blocking_total(source: same_coproduct_record_field_source) == 0
}

// --- CONTROLS: a declared alias, the applied-same coproduct, and a generic formal stay clean. ---
test fn a_declared_alias_of_a_coproduct_at_the_coproduct_parameter_is_clean() -> Bool {
  blocking_total(source: alias_coproduct_argument_source) == 0
}

test fn a_declared_alias_of_a_coproduct_at_the_coproduct_record_field_is_clean() -> Bool {
  blocking_total(source: alias_coproduct_record_field_source) == 0
}

test fn an_applied_coproduct_at_its_own_applied_declaration_is_clean() -> Bool {
  blocking_total(source: applied_same_coproduct_argument_source) == 0
}

test fn a_coproduct_value_at_a_generic_coproduct_parameter_is_clean() -> Bool {
  blocking_total(source: generic_coproduct_argument_source) == 0
}

// --- CONTROLS: list literals at FreeMonoid and List parameters stay clean. ---
test fn a_one_element_list_literal_at_generic_freemonoid_is_clean() -> Bool {
  blocking_total(source: list_lit_one_at_freemonoid_source) == 0
}

test fn a_multi_element_list_literal_at_generic_freemonoid_is_clean() -> Bool {
  blocking_total(source: list_lit_multi_at_freemonoid_source) == 0
}

test fn a_list_literal_at_concrete_list_parameter_is_clean() -> Bool {
  blocking_total(source: list_lit_at_concrete_list_source) == 0
}

// Positive controls: same shapes with scalar elements, proving the pass is not accidental.
test fn a_list_literal_at_freemonoid_scalar_is_clean() -> Bool {
  blocking_total(source: list_lit_at_freemonoid_scalar_control_source) == 0
}

test fn a_list_literal_at_concrete_list_scalar_is_clean() -> Bool {
  blocking_total(source: list_lit_at_concrete_list_scalar_control_source) == 0
}

// A bare foreign coproduct (not a list literal) at a FreeMonoid parameter MUST refuse.
test fn a_bare_foreign_coproduct_at_freemonoid_refuses() -> Bool {
  blocking_of_class(source: bare_foreign_coproduct_at_freemonoid_source, wanted: "DeclaredTypeNotInhabited") >= 1
}

// --- NOT-IDLE. ---
test fn the_harness_is_not_idle() -> Bool {
  blocking_of_class(source: kernel_at_coproduct_argument_source, wanted: "DeclaredTypeNotInhabited") >= 1
}
