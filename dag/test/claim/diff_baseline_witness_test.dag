module test.claim.diff_baseline_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data planted_merge_base_sha: String = "abc123def4567890abc123def4567890abc12345"
data planted_head_sha: String = "fedcba0987654321fedcba0987654321fedcba09"

fn planted_oid(hex: String) -> extdeps.git.object_store.GitObjectId {
  match extdeps.git.object_store.git_sha1_object_id(hex: hex) {
    Present { value: oid } => oid
    Absent =>
      extdeps.git.object_store.GitSha1ObjectId {
        digest: std.content_hash.Sha1Digest {
          hex: planted_merge_base_sha as std.content_hash.Sha1DigestHex
        }
      }
  }
}

data planted_target_generation_sha: String = "1111111111111111111111111111111111111111"

fn planted_diff_window() -> gunbc.git_diff_change_window.GitDiffWindowObservation {
  Present {
    value: gunbc.git_diff_change_window.GitDiffWindowObserved {
      window: gunbc.git_diff_change_window.git_exact_diff_window_for_verification(
        target: "origin/main" as std.types.GitRef,
        target_generation: planted_oid(hex: planted_target_generation_sha),
        base: planted_oid(hex: planted_merge_base_sha),
        head: planted_oid(hex: planted_head_sha),
      )
    }
  }
}

fn resolve_case(
  override_ref: String?,
  event_name: String,
  base_ref: String?,
  push_before: gunbc.diff_baseline.PushBeforeInput?,
  head_sha: String?,
  diff_window: gunbc.git_diff_change_window.GitDiffWindowObservation?
) -> gunbc.diff_baseline.DiffBaselineResolution {
  gunbc.diff_baseline.resolve_diff_baseline(
    event: gunbc.diff_baseline.CiDiffEvent {
      override_ref: override_ref,
      event_name: event_name,
      base_ref: base_ref,
      push_before: push_before,
      head_sha: head_sha,
      diff_window: diff_window
    },
    push_parent_ref: gunbc.repo_identity.gunbc_merge_target_ref,
    default_remote_name: gunbc.repo_identity.gunbc_default_remote_name
  )
}

fn arm_tag(res: gunbc.diff_baseline.DiffBaselineResolution) -> String {
  match res {
    gunbc.diff_baseline.BaselineSelected { baseline: gunbc.diff_baseline.MergeTarget { ref: _ } } => "merge_target"
    gunbc.diff_baseline.BaselineSelected { baseline: gunbc.diff_baseline.ExactReplayBoundary { base: _, head: _, observed_relation: _ } } =>
      "exact_replay"
    gunbc.diff_baseline.BaselineSelected { baseline: gunbc.diff_baseline.PushBefore { ref: _ } } => "push_before"
    gunbc.diff_baseline.BaselineSelected { baseline: gunbc.diff_baseline.PushParent { ref: _ } } => "push_parent"
    gunbc.diff_baseline.BaselineSelected { baseline: gunbc.diff_baseline.OperatorOverride { ref: _ } } => "operator_override"
    gunbc.diff_baseline.BaselineRefused { reason: _ } => "refused"
    gunbc.diff_baseline.BaselineSourceConflict { window_detail: _, override_ref: _ } => "source_conflict"
  }
}

fn selected_ref(res: gunbc.diff_baseline.DiffBaselineResolution) -> String {
  match res {
    gunbc.diff_baseline.BaselineSelected { baseline: b } => gunbc.diff_baseline.diff_baseline_ref(b: b) as String
    gunbc.diff_baseline.BaselineRefused { reason: _ } => "<<refused>>"
    gunbc.diff_baseline.BaselineSourceConflict { window_detail: _, override_ref: _ } => "<<source_conflict>>"
  }
}

test fn witness_dashboard_exact_replay_arm_pins_typed_identities() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "pull_request",
    base_ref: Present { value: "main" },
    push_before: none,
    head_sha: none,
    diff_window: planted_diff_window()
  )
  match res {
    gunbc.diff_baseline.BaselineSelected { baseline: b } =>
      gunbc.diff_baseline.diff_baseline_is_exact_replay(b: b)
        && gunbc.diff_baseline.diff_baseline_diff_base(b: b) == planted_merge_base_sha
        && gunbc.diff_baseline.diff_baseline_diff_head(b: b, default_head: "HEAD") == planted_head_sha
    gunbc.diff_baseline.BaselineRefused { reason: _ } => false
    gunbc.diff_baseline.BaselineSourceConflict { window_detail: _, override_ref: _ } => false
  }
}

test fn witness_pull_request_hex_branch_stays_remote_tracking() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "pull_request",
    base_ref: Present { value: planted_merge_base_sha },
    push_before: none,
    head_sha: none,
    diff_window: none
  )
  arm_tag(res: res) == "merge_target"
    && selected_ref(res: res) == concat("origin/", planted_merge_base_sha)
    && selected_ref(res: res) != planted_merge_base_sha
}

test fn witness_stacked_pr_selects_actual_base() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "pull_request",
    base_ref: Present { value: "feature/B" },
    push_before: none,
    head_sha: none,
    diff_window: none
  )
  arm_tag(res: res) == "merge_target"
    && selected_ref(res: res) == "origin/feature/B"
    && selected_ref(res: res) != "origin/main"
}

test fn witness_main_pr_equivalent_to_push_parent() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "pull_request",
    base_ref: Present { value: "main" },
    push_before: none,
    head_sha: none,
    diff_window: none
  )
  arm_tag(res: res) == "merge_target"
    && selected_ref(res: res) == "origin/main"
    && selected_ref(res: res) == (gunbc.repo_identity.gunbc_merge_target_ref as String)
}

test fn witness_push_selects_before_sha() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "push",
    base_ref: none,
    push_before: Present { value: gunbc.diff_baseline.PushBeforeSha { sha: planted_merge_base_sha } },
    head_sha: Present { value: planted_head_sha },
    diff_window: none
  )
  arm_tag(res: res) == "push_before"
    && selected_ref(res: res) == planted_merge_base_sha
    && selected_ref(res: res) != (gunbc.repo_identity.gunbc_merge_target_ref as String)
}

test fn witness_push_absent_before_refuses() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: none,
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_observation_read_refusal_propagates() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present {
        value: gunbc.diff_baseline.PushBeforeInputRefused {
          reason: "push event payload unreadable at /tmp/missing.json — no such file; halting the floor (AFFECTED-SET REFUSAL)"
        }
      },
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_observation_absent_propagates() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present {
        value: gunbc.diff_baseline.PushBeforeInputRefused {
          reason: "push event before SHA absent — push event payload has no before member; halting the floor (AFFECTED-SET REFUSAL)"
        }
      },
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_observation_refusal_propagates() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present {
        value: gunbc.diff_baseline.PushBeforeInputRefused {
          reason: "push event before SHA malformed — GITHUB_EVENT_PATH payload is not valid JSON; halting the floor (AFFECTED-SET REFUSAL)"
        }
      },
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_zero_before_refuses() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present { value: gunbc.diff_baseline.PushBeforeZeroShaInput },
      head_sha: Present { value: planted_head_sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_self_compare_refuses() -> Bool {
  let sha = planted_merge_base_sha
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present { value: gunbc.diff_baseline.PushBeforeSha { sha: sha } },
      head_sha: Present { value: sha },
      diff_window: none
    )
  ) == "refused"
}

test fn witness_push_head_absent_refuses() -> Bool {
  arm_tag(
    res: resolve_case(
      override_ref: none,
      event_name: "push",
      base_ref: none,
      push_before: Present { value: gunbc.diff_baseline.PushBeforeSha { sha: planted_merge_base_sha } },
      head_sha: none,
      diff_window: none
    )
  ) == "refused"
}

test fn witness_workflow_dispatch_keeps_todays_policy() -> Bool {
  let res = resolve_case(
    override_ref: none,
    event_name: "workflow_dispatch",
    base_ref: none,
    push_before: none,
    head_sha: none,
    diff_window: none
  )
  arm_tag(res: res) == "push_parent"
    && selected_ref(res: res) == "origin/main"
}

