module test.claim.domain_name_parse


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn domain_name_parse_fqdn_srv1_tailnet() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "srv1.tailecbe08.ts.net.") {
    Ok { value: host } =>
      host.qualification == FullyQualified
        && extdeps.dns.domain_name.host_name_label_count(host: host) == 4
    Err { value: _ } => false
  }
}

test fn domain_name_parse_partial_single_label() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "altrad8ud-1l2t") {
    Ok { value: host } =>
      host.qualification == extdeps.dns.domain_name.PartiallyQualified
        && extdeps.dns.domain_name.host_name_label_count(host: host) == 1
    Err { value: _ } => false
  }
}

test fn domain_name_parse_accepts_digit_first_label() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "3com") {
    Ok { value: host } =>
      host.qualification == extdeps.dns.domain_name.PartiallyQualified
        && extdeps.dns.domain_name.host_name_label_count(host: host) == 1
    Err { value: _ } => false
  }
}

test fn domain_name_parse_rejects_trailing_hyphen() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "bad-") {
    Err { value: extdeps.dns.domain_name.EdgeHyphen } => true
    Err { value: _ } => false
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_rejects_empty() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "") {
    Err { value: EmptyName } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_rejects_edge_hyphen() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "-bad") {
    Err { value: extdeps.dns.domain_name.BadLabelChar } => true
    Err { value: extdeps.dns.domain_name.EdgeHyphen } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_rejects_label_too_long() -> Bool {
  let long_label = std.render.repeat_string(s: "a", n: 64)
  match extdeps.dns.domain_name.parse_host_name(raw: long_label) {
    Err { value: extdeps.dns.domain_name.LabelTooLong } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_case_fold_equality() -> Bool {
  match extdeps.dns.domain_name.parse_host_name(raw: "SRV1") {
    Ok { value: upper } =>
      match extdeps.dns.domain_name.parse_host_name(raw: "srv1") {
        Ok { value: lower } => extdeps.dns.domain_name.host_name_eq(a: upper, b: lower)
        Err { value: _ } => false
      }
    Err { value: _ } => false
  }
}
