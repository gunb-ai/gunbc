module test.claim.workflow_recursive_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn linearize_steps(steps: List<StageStep>) -> VerdictTree {
  linearize_verdicts(
    verdicts: map(collection: steps, f: fn(s) { s.verdict })
  )
}

fn deep_unknown_tree() -> VerdictTree {
  Decomposed { children: [
    std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 1 } },
    Decomposed { children: [
      std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 2 } },
      std.workflow_recursive.Leaf { verdict: std.reducible.Unknown { missing: "deep-axis" } },
    ] },
    std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 3 } },
  ] }
}

fn all_green_tree() -> VerdictTree {
  Decomposed { children: [
    std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 1 } },
    Decomposed { children: [
      std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 2 } },
      std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 3 } },
    ] },
  ] }
}

fn review_tree_blocks() -> VerdictTree {
  Decomposed { children: [
    std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 1 } },
    std.workflow_recursive.Leaf { verdict: review_step(gunbc.idea_pr_spine.Review { subject: DagModel, reviewer: gunbc.review_verdict.Llm { provider: Claude }, verdict: gunbc.review_verdict.RequestChanges }).verdict },
    std.workflow_recursive.Leaf { verdict: Reduced { last_parts: 9 } },
  ] }
}

type WorkflowLawWitness {
  law_tag: NonEmptyStr
  verified: Bool
}

type WorkflowKernelWitnessed {
  semigroup_associativity: WorkflowLawWitness
  semigroup_absorption_left: WorkflowLawWitness
  semigroup_absorption_right: WorkflowLawWitness
  deep_unknown_latches_located: WorkflowLawWitness
  green_tree_settles_decisive: WorkflowLawWitness
  review_blocks_located_in_tree: WorkflowLawWitness
  linear_instance_green: WorkflowLawWitness
  linear_instance_unknown: WorkflowLawWitness
}

fn witness_semigroup_associativity() -> WorkflowLawWitness {
  let a = Reduced { last_parts: 1 }
  let b = std.reducible.Unknown { missing: "axis-b" }
  let c = Irreducible { witness: "w" }
  WorkflowLawWitness {
    law_tag: "reduce_verdict:semigroup_associativity",
    verified: verdict_eq(
      a: reduce_verdict_combine(
        a: reduce_verdict_combine(a: a, b: b),
        b: c
      ),
      b: reduce_verdict_combine(
        a: a,
        b: reduce_verdict_combine(a: b, b: c)
      )
    ),
  }
}

fn witness_semigroup_absorption_left() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "reduce_verdict:unknown_absorbs_left",
    verified: verdict_eq(
      a: reduce_verdict_combine(
        a: std.reducible.Unknown { missing: "latch-axis" },
        b: Reduced { last_parts: 9 }
      ),
      b: std.reducible.Unknown { missing: "latch-axis" }
    ),
  }
}

fn witness_semigroup_absorption_right() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "reduce_verdict:unknown_absorbs_right",
    verified: verdict_eq(
      a: reduce_verdict_combine(
        a: Reduced { last_parts: 9 },
        b: std.reducible.Unknown { missing: "latch-axis" }
      ),
      b: std.reducible.Unknown { missing: "latch-axis" }
    ),
  }
}

fn witness_deep_unknown_latches_located() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "workflow:deep_unknown_latches_located",
    verified: verdict_eq(
      a: settle_verdict_tree(deep_unknown_tree()),
      b: std.reducible.Unknown { missing: "deep-axis" }
    ),
  }
}

fn witness_green_tree_settles_decisive() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "workflow:green_tree_settles_decisive",
    verified: verdict_eq(
      a: settle_verdict_tree(all_green_tree()),
      b: Reduced { last_parts: 3 }
    ),
  }
}

fn witness_review_blocks_located_in_tree() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "workflow:review_blocks_located_in_tree",
    verified: verdict_eq(
      a: settle_verdict_tree(review_tree_blocks()),
      b: std.reducible.Unknown { missing: "idea-pr:review:dag-model:request-changes" }
    ),
  }
}

fn witness_linear_instance_green() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "workflow:linear_instance_equals_flat_settle_green",
    verified: verdict_eq(
      a: settle_verdict_tree(linearize_steps(demo_spine_green())),
      b: settle(demo_spine_green())
    ),
  }
}

fn witness_linear_instance_unknown() -> WorkflowLawWitness {
  WorkflowLawWitness {
    law_tag: "workflow:linear_instance_equals_flat_settle_unknown",
    verified: verdict_eq(
      a: settle_verdict_tree(linearize_steps(demo_spine_unknown())),
      b: settle(demo_spine_unknown())
    ),
  }
}

fn workflow_kernel_witnessed() -> WorkflowKernelWitnessed {
  WorkflowKernelWitnessed {
    semigroup_associativity: witness_semigroup_associativity(),
    semigroup_absorption_left: witness_semigroup_absorption_left(),
    semigroup_absorption_right: witness_semigroup_absorption_right(),
    deep_unknown_latches_located: witness_deep_unknown_latches_located(),
    green_tree_settles_decisive: witness_green_tree_settles_decisive(),
    review_blocks_located_in_tree: witness_review_blocks_located_in_tree(),
    linear_instance_green: witness_linear_instance_green(),
    linear_instance_unknown: witness_linear_instance_unknown(),
  }
}

fn workflow_kernel_all_verified(w: WorkflowKernelWitnessed) -> Bool {
  fold(
    [
      w.semigroup_associativity.verified,
      w.semigroup_absorption_left.verified,
      w.semigroup_absorption_right.verified,
      w.deep_unknown_latches_located.verified,
      w.green_tree_settles_decisive.verified,
      w.review_blocks_located_in_tree.verified,
      w.linear_instance_green.verified,
      w.linear_instance_unknown.verified,
    ],
    init: true,
    f: fn(acc, v) { acc && v }
  )
}

test fn workflow_recursive_witnesses() -> Bool {
  workflow_kernel_all_verified(w: workflow_kernel_witnessed())
}
