module test.claim.ice40_supply_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn admits(r: extdeps.programmable_logic.ice40.supply.RailRequirement, mv: Int) -> Bool {
  extdeps.programmable_logic.ice40.supply.requirement_admits(r: r, v: std.measure.millivolt(count: mv))
}

fn mode_admits(m: extdeps.programmable_logic.ice40.supply.Ice40ConfigurationMode, mv: Int) -> Bool {
  admits(r: extdeps.programmable_logic.ice40.supply.nvcm_supply_requirement(m: m), mv: mv)
}

fn window_of(r: extdeps.programmable_logic.ice40.supply.Ice40SupplyRail) -> extdeps.programmable_logic.ice40.supply.RailRequirement? {
  extdeps.programmable_logic.ice40.supply.rail_requirement(r: r)
}

// THE CORE WINDOW IS WHY THE MILLIVOLT EXISTS. 1.14 V to 1.26 V is a 120 mV band; at volt grain
// both bounds are 1 and the check admits everything from 1.0 V to 1.99 V. This asserts the band
// discriminates in both directions, which is the property the finer carrier bought — a nominal
// 1.2 V rail is admitted and a 1.0 V one is refused.
test fn w_the_core_window_discriminates_below_volt_grain() -> Bool {
  match window_of(r: extdeps.programmable_logic.ice40.supply.CoreSupply) {
    Absent => false
    Present { value: w } =>
      admits(r: w, mv: 1200)
        && admits(r: w, mv: 1140)
        && admits(r: w, mv: 1260)
        && !admits(r: w, mv: 1000)
        && !admits(r: w, mv: 1300)
  }
}

// THE MODE-DEPENDENT RAIL HAS NO MODE-FREE ANSWER, and this is the central claim. Asking what
// VPP_2V5 must supply without saying how the board configures returns nothing rather than the
// widest window — because the widest window would admit 1.71 V, which master SPI refuses.
test fn w_the_nvcm_rail_refuses_a_mode_free_question() -> Bool {
  match window_of(r: extdeps.programmable_logic.ice40.supply.NvcmProgrammingSupply) {
    Absent => true
    Present { value: _ } => false
  }
}

// AND THE MODES REALLY DIFFER, which is what makes the refusal above load-bearing rather than
// fussy. 1.71 V is a legal VPP_2V5 under slave SPI and illegal under master SPI and NVCM; 3.46 V
// is legal for configuration and illegal while NVCM is being programmed. Both directions are
// asserted, so a table collapsed to one window could not pass this.
test fn w_the_configuration_mode_changes_the_admitted_window() -> Bool {
  mode_admits(m: extdeps.programmable_logic.ice40.supply.SlaveSpiConfiguration, mv: 1710)
    && !mode_admits(m: extdeps.programmable_logic.ice40.supply.MasterSpiConfiguration, mv: 1710)
    && !mode_admits(m: extdeps.programmable_logic.ice40.supply.NvcmConfiguration, mv: 1710)
    && mode_admits(m: extdeps.programmable_logic.ice40.supply.MasterSpiConfiguration, mv: 3460)
    && !mode_admits(m: extdeps.programmable_logic.ice40.supply.NvcmProgramming, mv: 3460)
    && mode_admits(m: extdeps.programmable_logic.ice40.supply.NvcmProgramming, mv: 3000)
}

// A PIN THAT MUST BE LEFT UNCONNECTED ADMITS NO VOLTAGE AT ALL. The failure this prevents is a
// min/max record carrying two invented numbers for a row whose entire content is "do not connect
// this" — so the arm is asserted to refuse a voltage that would sit comfortably inside every
// other rail's window on this device.
test fn w_the_unconnected_pin_admits_no_voltage() -> Bool {
  match window_of(r: extdeps.programmable_logic.ice40.supply.FastProgrammingSupply) {
    Absent => false
    Present { value: w } =>
      match w {
        extdeps.programmable_logic.ice40.supply.MustBeLeftUnconnected => !admits(r: w, mv: 2500) && !admits(r: w, mv: 0)
        extdeps.programmable_logic.ice40.supply.OperatingWindow { minimum: _, maximum: _ } => false
      }
  }
}

// THE I/O STANDARD IS STRICTLY TIGHTER THAN THE RAIL THAT CARRIES IT. A bank rail admits anything
// from 1.71 V to 3.46 V, but a bank driving LVCMOS 3.3 must sit in 3.14 to 3.46 — so 1.8 V is a
// legal bank voltage and an illegal one for that standard. A design checked only against the rail
// would pass while its outputs were out of spec.
test fn w_the_io_standard_is_tighter_than_the_bank_rail() -> Bool {
  match window_of(r: extdeps.programmable_logic.ice40.supply.BankIoSupply) {
    Absent => false
    Present { value: rail } =>
      admits(r: rail, mv: 1800)
        && std.measure.millivolt_count(v: ice40_lvcmos33_supply.minimum) > 1800
        && std.measure.millivolt_count(v: ice40_lvcmos33_supply.minimum) == 3140
        && std.measure.millivolt_count(v: ice40_lvcmos18_supply.typical) == 1800
        && std.measure.millivolt_count(v: ice40_lvcmos18_supply.maximum) < std.measure.millivolt_count(v: ice40_lvcmos33_supply.minimum)
  }
}

// CONSTRAINTS BETWEEN RAILS ARE CARRIED AS THEIR OWN KIND, because none of them is a property of
// any single rail and a per-rail record would have to drop them. Each of the three is asserted to
// be present and distinguishable, so collapsing them into one "see the notes" row would red.
test fn w_the_inter_rail_constraints_are_distinguishable() -> Bool {
  let shared = fold(extdeps.programmable_logic.ice40.supply.ice40_inter_rail_constraints, init: false, f: fn(acc, c) {
    acc || match c {
      extdeps.programmable_logic.ice40.supply.LikeVoltageRailsShareOneSupply { left: l, right: r } =>
        (extdeps.programmable_logic.ice40.supply.supply_rail_symbol(r: l) as String) == "VCCIO" && (extdeps.programmable_logic.ice40.supply.supply_rail_symbol(r: r) as String) == "VCC_SPI"
      extdeps.programmable_logic.ice40.supply.UnusedBankSupplyGoesToCore { bank_rail: _, core_rail: _ } => false
      extdeps.programmable_logic.ice40.supply.PinLeftUnconnected { rail: _ } => false
    }
  })
  let unused = fold(extdeps.programmable_logic.ice40.supply.ice40_inter_rail_constraints, init: false, f: fn(acc, c) {
    acc || match c {
      extdeps.programmable_logic.ice40.supply.UnusedBankSupplyGoesToCore { bank_rail: _, core_rail: cr } => (extdeps.programmable_logic.ice40.supply.supply_rail_symbol(r: cr) as String) == "VCC"
      extdeps.programmable_logic.ice40.supply.LikeVoltageRailsShareOneSupply { left: _, right: _ } => false
      extdeps.programmable_logic.ice40.supply.PinLeftUnconnected { rail: _ } => false
    }
  })
  let floating = fold(extdeps.programmable_logic.ice40.supply.ice40_inter_rail_constraints, init: false, f: fn(acc, c) {
    acc || match c {
      extdeps.programmable_logic.ice40.supply.PinLeftUnconnected { rail: pr } => (extdeps.programmable_logic.ice40.supply.supply_rail_symbol(r: pr) as String) == "VPP_FAST"
      extdeps.programmable_logic.ice40.supply.LikeVoltageRailsShareOneSupply { left: _, right: _ } => false
      extdeps.programmable_logic.ice40.supply.UnusedBankSupplyGoesToCore { bank_rail: _, core_rail: _ } => false
    }
  })
  shared && unused && floating
}

// The PLL rail is the core window, not the bank window, and the two are far apart. A design that
// fed VCCPLL from a 3.3 V bank supply would be feeding a 1.2 V pin nearly three times its maximum.
test fn w_the_pll_rail_follows_the_core_not_the_banks() -> Bool {
  match window_of(r: extdeps.programmable_logic.ice40.supply.PllSupply) {
    Absent => false
    Present { value: pll } =>
      admits(r: pll, mv: 1200)
        && !admits(r: pll, mv: 3300)
        && match window_of(r: extdeps.programmable_logic.ice40.supply.ConfigurationBankSupply) {
          Absent => false
          Present { value: spi } => admits(r: spi, mv: 3300)
        }
  }
}

// THE DISCRIMINANTS ARE DISTINCT, over the enumerated members rather than a count. Rail and mode
// equality decide whether a board's rail matches a requirement and whether a timing row is in
// scope, so two members sharing a tag would silently fuse two rails or two configuration modes.
// The earlier form compared display names, where a copy-edit to documentation could do the fusing;
// this is the failure that replaced it, and unlike the first it is decidable by execution.
test fn w_rail_and_mode_discriminants_are_distinct() -> Bool {
  let rails_distinct = fold(extdeps.programmable_logic.ice40.supply.all_supply_rails, init: true, f: fn(acc, a) {
    acc && fold(extdeps.programmable_logic.ice40.supply.all_supply_rails, init: 0, f: fn(n, b) {
      if extdeps.programmable_logic.ice40.supply.supply_rails_equal(a: a, b: b) { n + 1 } else { n }
    }) == 1
  })
  let modes_distinct = fold(extdeps.programmable_logic.ice40.supply.all_configuration_modes, init: true, f: fn(acc, a) {
    acc && fold(extdeps.programmable_logic.ice40.supply.all_configuration_modes, init: 0, f: fn(n, b) {
      if extdeps.programmable_logic.ice40.supply.configuration_modes_equal(a: a, b: b) { n + 1 } else { n }
    }) == 1
  })
  rails_distinct && modes_distinct
}

// AND EQUALITY DOES NOT FOLLOW THE PROSE. The two supplies whose display names both begin with the
// core's symbol, and the two modes that both configure from NVCM, are the pairs a name-minded
// comparison is most likely to fuse.
test fn w_rail_and_mode_equality_ignore_the_display_prose() -> Bool {
  !extdeps.programmable_logic.ice40.supply.supply_rails_equal(a: extdeps.programmable_logic.ice40.supply.CoreSupply, b: extdeps.programmable_logic.ice40.supply.PllSupply)
    && !extdeps.programmable_logic.ice40.supply.supply_rails_equal(a: extdeps.programmable_logic.ice40.supply.BankIoSupply, b: extdeps.programmable_logic.ice40.supply.ConfigurationBankSupply)
    && extdeps.programmable_logic.ice40.supply.supply_rails_equal(a: extdeps.programmable_logic.ice40.supply.CoreSupply, b: extdeps.programmable_logic.ice40.supply.CoreSupply)
    && !extdeps.programmable_logic.ice40.supply.configuration_modes_equal(a: extdeps.programmable_logic.ice40.supply.NvcmConfiguration, b: extdeps.programmable_logic.ice40.supply.NvcmProgramming)
    && extdeps.programmable_logic.ice40.supply.supply_rail_tag(r: extdeps.programmable_logic.ice40.supply.NvcmProgrammingSupply) != extdeps.programmable_logic.ice40.supply.supply_rail_tag(r: extdeps.programmable_logic.ice40.supply.FastProgrammingSupply)
    && extdeps.programmable_logic.ice40.supply.configuration_mode_tag(m: extdeps.programmable_logic.ice40.supply.SlaveSpiConfiguration) != extdeps.programmable_logic.ice40.supply.configuration_mode_tag(m: extdeps.programmable_logic.ice40.supply.MasterSpiConfiguration)
}
