module test.claim.empty_list_element_fabrication_witness

import std.types { String, Bool, Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.compile_diagnostic_census { census_blocking_rows, CensusObserved, CensusNotRunnable }
import gunbc.compile_census_probe { blocking_class_count_for }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// AN EMPTY LIST WITH NO EXPECTED TYPE ANSWERED `List<Unit>`, AND THE FABRICATION DISABLED ITS OWN REPAIR.
//
// `ExprListLit` cannot know its element type when the literal is empty and nothing expects a
// type. It answered `unit_type` instead of saying so -- a confident wrong answer where an
// unknown was the truth.
//
// WHY IT SURVIVED, and this is the part worth keeping. `List<Unit>` READS AS FULLY RESOLVED.
// The if-join already carries re-inference for exactly this case: where one branch is
// under-resolved and the other is not, re-infer the first against the second. A fabrication
// that looks resolved switches that repair OFF. So the defect did not merely produce a wrong
// type, it consumed the mechanism that existed to correct it -- which is why the RED needs
// BOTH branches empty and the one-typed-branch control is green on main today.
//
// The repair answers a fresh type variable, which is what "I do not know the element type yet"
// is spelled as everywhere else in this module.

data red_both_branches_empty_source: String = "module probe_empty_list_join\ntype Row { label: String }\nfn both_empty(flag: Bool) -> List<String> {\n  let picked = if flag { [] } else { [] }\n  picked |> map(r => r.label)\n}\n"

data green_one_branch_typed_source: String = "module probe_empty_list_typed_arm\ntype Row { label: String }\nfn one_typed(flag: Bool, given: List<Row>) -> List<String> {\n  let picked = if flag { [] } else { given }\n  picked |> map(r => r.label)\n}\n"

data fold_list_empty_accumulator_source: String = "module probe_nl_fold\ntype UMod { module: String }\nfn nl_ms() -> List<UMod> { [UMod { module: \"a\" }] }\nfn nl_fold_list<T, A>(xs: List<T>, empty: A, cons: fn(A, T) -> A) -> A {\n  match xs |> first {\n    Present { value: h } => nl_fold_list(xs: xs |> skip(1), empty: cons(empty, h), cons: cons)\n    Absent => empty\n  }\n}\nfn caller_nl_fold() -> String {\n  let modules = nl_fold_list(xs: nl_ms(), empty: [], cons: fn(acc, m) { list_push(xs: acc, item: m) })\n  match modules |> first {\n    Present { value: m } => m.module\n    Absent => \"\"\n  }\n}\n"

// EVERY ACTUAL THAT COULD BIND A IS UNINFORMATIVE: empty is [], cons is identity. The skip of an
// uninformative actual must not default A to Unit or accept the fold as a String. The body is
// the identity-cons call itself at a declared String return — no incidental `.module` — so the
// enrolled red is the declared-return TypeMismatch, not a field-access refuse and not Unit.
data fold_list_uninformed_accumulator_source: String = "module probe_nl_fold_uninformed\ntype UMod { module: String }\nfn nl_ms() -> List<UMod> { [UMod { module: \"a\" }] }\nfn nl_fold_list<T, A>(xs: List<T>, empty: A, cons: fn(A, T) -> A) -> A {\n  match xs |> first {\n    Present { value: h } => nl_fold_list(xs: xs |> skip(1), empty: cons(empty, h), cons: cons)\n    Absent => empty\n  }\n}\nfn uninformed() -> String {\n  nl_fold_list(xs: nl_ms(), empty: [], cons: fn(acc, m) { acc })\n}\n"

// THE SCALAR RED DOES NOT COVER A GROUND LIST DECLARATION. On main, identity-cons bound A to
// List<Unit> and `-> List<String>` TypeMismatched both-ground. A scalar-only wall left
// List<empty_list_element> unjudged (review 77291).
data fold_list_uninformed_list_return_source: String = "module probe_nl_fold_uninformed_list\ntype UMod { module: String }\nfn nl_ms() -> List<UMod> { [UMod { module: \"a\" }] }\nfn nl_fold_list<T, A>(xs: List<T>, empty: A, cons: fn(A, T) -> A) -> A {\n  match xs |> first {\n    Present { value: h } => nl_fold_list(xs: xs |> skip(1), empty: cons(empty, h), cons: cons)\n    Absent => empty\n  }\n}\nfn uninformed_list() -> List<String> {\n  nl_fold_list(xs: nl_ms(), empty: [], cons: fn(acc, m) { acc })\n}\n"

// A NAMED PRODUCT IS A DEFINITE NON-COLLECTION. The empty-list skip is only for an unsolved
// expected (placeholder or unbound generic formal). `data d: UMod = []` refused on main and
// must still refuse here (review 77133).
data empty_list_at_named_product_source: String = "module probe_empty_list_at_umod\ntype UMod { module: String }\ndata d: UMod = []\n"

// LANGUAGE FOLD(init: []) WHOSE STEP IS acc + [string] MUST INFORM THE ACCUMULATOR. The
// leftover unify pass was a second bind authority (review 77302) and is gone; list concat
// must take the informative right list so a declared List<String> return stays accepted.
data fold_init_concat_informing_source: String = "module probe_fold_init_concat\nfn labels() -> List<String> { [\"a\"] }\nfn gained() -> List<String> {\n  fold(labels(), init: [], f: (acc, s) => acc + [s])\n}\n"

fn compiles_with_no_blocking_diagnostic(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => (census_blocking_rows(rows: rows) |> count) == 0
    CensusNotRunnable { cause: _ } => false
  }
}

test fn an_empty_list_in_both_branches_does_not_fabricate_a_unit_element() -> Bool {
  compiles_with_no_blocking_diagnostic(source: red_both_branches_empty_source)
}

test fn a_typed_branch_beside_an_empty_one_still_resolves() -> Bool {
  compiles_with_no_blocking_diagnostic(source: green_one_branch_typed_source)
}

test fn fold_list_empty_accumulator_does_not_read_back_as_unit() -> Bool {
  compiles_with_no_blocking_diagnostic(source: fold_list_empty_accumulator_source)
}

test fn uninformed_fold_list_accumulator_does_not_silently_typecheck() -> Bool {
  (blocking_class_count_for(source: fold_list_uninformed_accumulator_source, wanted_class: "TypeMismatch") >= 1)
    && (blocking_class_count_for(source: fold_list_uninformed_accumulator_source, wanted_class: "InternalError") == 0)
    && (blocking_class_count_for(source: fold_list_uninformed_accumulator_source, wanted_class: "FieldNotFound") == 0)
}

test fn uninformed_fold_list_list_return_does_not_silently_typecheck() -> Bool {
  (blocking_class_count_for(source: fold_list_uninformed_list_return_source, wanted_class: "TypeMismatch") >= 1)
    && (blocking_class_count_for(source: fold_list_uninformed_list_return_source, wanted_class: "InternalError") == 0)
}

test fn empty_list_against_a_named_product_still_refuses() -> Bool {
  blocking_class_count_for(source: empty_list_at_named_product_source, wanted_class: "InternalError") >= 1
}

test fn fold_init_concat_informs_the_list_element() -> Bool {
  compiles_with_no_blocking_diagnostic(source: fold_init_concat_informing_source)
}
