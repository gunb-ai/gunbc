module test.claim.heal_publication_workflow_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.optional { Present, Absent }
import std.types { String, NonEmptyStr, Bool, List, Int }
import extdeps.languages.yaml.types { YamlValue, YamlKeyValue, YamlString, YamlNull, YamlBool, YamlInt, YamlFloat, YamlSequence, YamlMapping, yaml_string, yaml_bool, kv }
import extdeps.github.actions {
  Step, UsesStep, RunStep, Job, RunnerSpec, HostedRunner, SelfHosted, RunsOnExpression,
  WorkflowPermissions, PermissionLevel, PermRead, PermWrite, PermNone,
  checkout_action, download_artifact_action, google_auth_action
}
import gunbc.heal_workflow {
  heal_workflow_job, heal_workflow_name, heal_job_holds_publication_credential,
  job_permissions_carry_write, permission_is_write, step_uses_action, job_federates_to_a_cloud_identity
}
import gunbc.heal_publisher_workflow {
  heal_publisher_job, heal_publisher_bound_steps, heal_publisher_workflow,
  publisher_job_executes_candidate_code, checkout_step_names_another_subject,
  heal_publication_phases_isolated, heal_publisher_wif_step_id
}
import gunbc.auth.heal_publisher_federation { heal_publisher_wif_provider_resource }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT IS THE JOB THAT WILL RUN, not a description of it. Each claim below reads the emitted
// Job value the workflow authority projects, so a step or grant added later is what the witness sees.

// ── the invariant, in both directions, over the two real jobs ───────────────────────────────

test fn witness_the_two_heal_phases_are_isolated() -> Bool {
  heal_publication_phases_isolated()
}

// gunbc#10887's first direction: the phase that executes pull-request code holds nothing that could
// publish -- no write grant, and no federation step to obtain one with.
test fn witness_the_candidate_job_holds_no_publication_credential() -> Bool {
  !heal_job_holds_publication_credential()
}

// The second direction: the phase that holds publication authority never obtains the candidate's
// code. Its checkout names no ref and no repository, so it is this workflow's own commit.
test fn witness_the_publisher_job_never_checks_out_the_candidates_code() -> Bool {
  !publisher_job_executes_candidate_code()
}

// ── the discriminating reds for each half of that invariant ─────────────────────────────────

fn a_write_grant() -> WorkflowPermissions {
  WorkflowPermissions {
    contents: Present { value: PermWrite },
    pull_requests: none,
    issues: none,
    actions: none,
    id_token: none
  }
}

fn a_read_grant() -> WorkflowPermissions {
  WorkflowPermissions {
    contents: Present { value: PermRead },
    pull_requests: none,
    issues: none,
    actions: none,
    id_token: none
  }
}

// THE RED FOR THE CREDENTIAL HALF. If this ever answered false, the candidate-phase check above
// would be satisfied by a predicate that admits a write grant.
test fn witness_a_write_grant_is_a_publication_credential() -> Bool {
  job_permissions_carry_write(permissions: Present { value: a_write_grant() })
    && !job_permissions_carry_write(permissions: Present { value: a_read_grant() })
}

// AN ID-TOKEN GRANT IS ALSO ONE, because it is the capability to federate to a cloud identity that
// holds the key -- which is exactly how gunbc#10887 reached the App private key from a PR job.
test fn witness_an_id_token_grant_is_a_publication_credential() -> Bool {
  job_permissions_carry_write(permissions: Present { value: WorkflowPermissions {
    contents: Present { value: PermRead },
    pull_requests: none,
    issues: none,
    actions: none,
    id_token: Present { value: PermWrite }
  } })
}

// AN ABSENT GRANT IS TREATED AS WRITE-CAPABLE, not as none: a job that declares no permissions
// inherits the workflow's, so silence is not a restriction.
test fn witness_an_undeclared_grant_is_not_read_only() -> Bool {
  job_permissions_carry_write(permissions: none)
}

fn checkout_with(rows: List<YamlKeyValue>) -> Step {
  UsesStep {
    name: Present { value: "Checkout" },
    id: none,
    uses: checkout_action,
    with: Present { value: rows },
    env: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

// THE RED FOR THE EXECUTION HALF. A checkout naming a ref is fetching something other than this
// workflow's own commit, and for the publisher the only thing it could name is the branch under
// review; the control beside it is the checkout the publisher actually emits.
test fn witness_a_checkout_naming_a_ref_is_another_subject() -> Bool {
  checkout_step_names_another_subject(step: checkout_with(rows: [
    kv(key: "ref", value: yaml_string(s: "${{ github.event.workflow_run.head_sha }}"))
  ]))
    && checkout_step_names_another_subject(step: checkout_with(rows: [
      kv(key: "repository", value: yaml_string(s: "someone/fork"))
    ]))
    && !checkout_step_names_another_subject(step: checkout_with(rows: [
      kv(key: "persist-credentials", value: yaml_bool(b: false))
    ]))
}

// ── the placements that make the credential safe to hold at all ─────────────────────────────

// A GITHUB-HOSTED RUNNER IS A CREDENTIAL-ISOLATION FACT, not a capacity choice: this fleet's
// self-hosted runners also execute pull-request jobs and share a filesystem between slots, so a
// token minted on one is reachable from code a pull request wrote.
test fn witness_the_publisher_runs_on_a_github_hosted_runner() -> Bool {
  match heal_publisher_job().runner {
    HostedRunner { label: _ } => true
    SelfHosted { labels: _ } => false
    RunsOnExpression { expression: _ } => false
  }
}

fn step_name_of(s: Step) -> String {
  match s {
    RunStep { name: n, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: v } => v  Absent => "" }
    UsesStep { name: n, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match n { Present { value: v } => v  Absent => "" }
  }
}

fn publisher_step_names() -> List<String> {
  map(heal_publisher_bound_steps(), b => step_name_of(s: b.step))
}

type StepSearch {
  found: Bool
  index: Int
}

// POSITION OF THE FIRST STEP WHOSE NAME CARRIES A MARKER. Counting stops at the match rather than
// running to the end, so the answer is an index and not a tally of non-matching steps.
fn step_position(marker: String) -> Int {
  fold(publisher_step_names(), init: StepSearch { found: false, index: 0 }, f: fn(acc, n) {
    if acc.found {
      acc
    } else if string_contains(s: n, pattern: marker) {
      StepSearch { found: true, index: acc.index }
    } else {
      StepSearch { found: false, index: acc.index + 1 }
    }
  }).index
}

fn federation_step_position() -> Int {
  step_position(marker: "Federate")
}

fn admission_step_position() -> Int {
  step_position(marker: "Admit the candidate")
}

// ADMISSION HAPPENS BEFORE FEDERATION, and the order is the claim: a candidate that does not admit
// must never cause a token to be minted, so the step that refuses runs before the step that mints.
test fn witness_the_candidate_is_admitted_before_the_publisher_federates() -> Bool {
  admission_step_position() < federation_step_position()
}

// THE PUBLISHER'S IDENTITY IS THE ONE THE FEDERATION AUTHORITY DECLARES, derived rather than spelled
// in the workflow, so the pool that admits the job and the provider the job presents cannot drift.
test fn witness_the_federation_step_presents_the_declared_provider() -> Bool {
  any(heal_publisher_bound_steps(), b =>
    step_uses_action(step: b.step, action: google_auth_action)
      && string_contains(s: step_with_value(step: b.step, key: "workload_identity_provider"), pattern: heal_publisher_wif_provider_resource()))
}

// ONLY A STRING SCALAR HAS TEXT HERE. Every other shape answers the empty string, which no claim
// below treats as a match, so a value that changed shape fails the witness rather than passing it.
fn yaml_scalar_text(v: YamlValue) -> String {
  match v {
    YamlString { value: s } => s
    YamlNull => ""
    YamlBool { value: _ } => ""
    YamlInt { lexeme: _ } => ""
    YamlFloat { lexeme: _ } => ""
    YamlSequence { elements: _ } => ""
    YamlMapping { entries: _ } => ""
  }
}

fn step_with_value(step: Step, key: String) -> String {
  match step {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => ""
    UsesStep { name: _, id: _, uses: _, with: w, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      match w {
        Absent => ""
        Present { value: rows } =>
          fold(rows, init: "", f: fn(acc, row) {
            if (row.key as String) == key { yaml_scalar_text(v: row.value) } else { acc }
          })
      }
  }
}
