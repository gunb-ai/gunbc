// P8c WITNESS: the machine-name convergence fold, its window gate, and its read-back rule.
//
// WHAT THIS FILE IS: the behavioral seam of gunbc.tailscale_machine_name_converge. Every case feeds the fold a
// status DOCUMENT -- the bytes `tailscale status --json` prints -- rather than a stand-in for the leg, so the
// parser that ships is the parser under test, and a fixture that stops matching what the daemon prints breaks
// a case instead of hiding one. The documents are the shape captured off a real fleet host during the read-only
// observe this PR cites; only the names inside them move between cases.
//
// WHAT IT DELIBERATELY DOES NOT DO: it never runs a leg. Every case here is IO-free, so nothing in this file
// can rename anything -- the first wet set is srv4's rename window (plan P9), and that window is scheduled by
// the plan, not by a test.

module test.claim.tailscale_machine_name_converge_witness
import std.algebra { string_contains }
import std.optional { Absent, Present }
import v2.std.text { string_join }
import std.types { Bool, NonEmptyStr, String }
import extdeps.exec.command { argv_words }
import extdeps.sudo.elevation { argv_command_is_sudo_elevated, sudo_elevate_argv, sudo_elevate_command }
import extdeps.tailscale.machine_name {
  ReadingRefused,
  SelfNameRead,
  StatusDocumentUnreadable,
  StatusHostNameEmpty,
  StatusHostNameMemberAbsent,
  StatusHostNameMemberMalformed,
  StatusSelfMemberAbsent,
  tailscale_set_hostname_argv,
  tailscale_set_hostname_command,
  tailscale_status_json_argv,
  tailscale_status_json_command,
  tailscale_status_self_name,
}
import gunbc.fleet.fleet_bootstrap_principal { executor_bootstrap_principal }
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv4 }
import gunbc.fleet.fleet_known_hosts_anchor { SshTargetRefused, SshTargetResolved, ssh_target_destination }
import gunbc.fleet.fleet_tailnet { fleet_tailnet_domain, tailnet_host_from }
import gunbc.runner.runner_host_file_converge { administrator_ssh_target }
import gunbc.tailscale_machine_name_converge {
  ApplyInsideWindow,
  DerivedName,
  DeviceNameAlreadyCurrent,
  DeviceNameChangeOwed,
  DeviceNameReported,
  ObserveOnly,
  ObservationRefused,
  PlanRefused,
  PrepareWindow,
  ReadBackConfirmsRequested,
  ReadBackContradictsRequest,
  ReadBackRefused,
  RenameWindow,
  StatusDocumentRefused,
  TailscaleMachineNameWindow,
  WindowIsNotTheRenameWindow,
  WindowUndeclared,
  tailscale_machine_name_desired,
  tailscale_machine_name_document,
  tailscale_machine_name_plan,
  tailscale_machine_name_read_back,
  tailscale_machine_name_stage_prepare_window_claim,
  tailscale_machine_name_stage_rename_window_claim,
  tailscale_machine_name_window_parse,
}

// A READING, NOT A NAME. Each document below is what one subject's daemon printed at one moment; the cases
// relabel the two name members to walk a rename window forward and then back.
data self_names_srv1_document: String = "{\"Version\": \"1.104.2\", \"Self\": {\"HostName\": \"srv1\", \"DNSName\": \"srv1.tailecbe08.ts.net.\"}}"

data self_names_srv4_document: String = "{\"Version\": \"1.104.2\", \"Self\": {\"HostName\": \"srv4\", \"DNSName\": \"srv4.tailecbe08.ts.net.\"}}"

// THE POSITIVE CONTROL for the structural cases: this document parses cleanly and has no `Self` at all, which
// is a different repair from a document that does not parse at all.
data self_member_absent_document: String = "{\"Version\": \"1.104.2\", \"BackendState\": \"Running\"}"

data document_unreadable: String = "Self: HostName=srv1"

data self_host_name_absent_document: String = "{\"Version\": \"1.104.2\", \"Self\": {\"DNSName\": \"srv1.tailecbe08.ts.net.\"}}"

data self_host_name_empty_document: String = "{\"Version\": \"1.104.2\", \"Self\": {\"HostName\": \"\", \"DNSName\": \"srv1.tailecbe08.ts.net.\"}}"

data self_host_name_wrong_type_document: String = "{\"Self\": {\"HostName\": 7}}"

// THE DNS NAME IS THE TAILNET ADDRESS, NOT THE MACHINE'S NAME. This document carries a reachable tailnet name
// beside a name the plan does not want: it is exactly what a fold that confused the two members would pass.
data self_dns_name_is_not_the_name_document: String = "{\"Version\": \"1.104.2\", \"Self\": {\"HostName\": \"srv4\", \"DNSName\": \"srv1.tailecbe08.ts.net.\"}}"

// THE WINDOW, AS THE CLAIM IN THE INVOCATION ENVIRONMENT. The mode reads these words from its own environment;
// the cases below hold the parse and the gate apart from each other.
data claim_of_rename_window: TailscaleMachineNameWindow = tailscale_machine_name_window_parse(claim: tailscale_machine_name_stage_rename_window_claim)

data claim_of_prepare_window: TailscaleMachineNameWindow = tailscale_machine_name_window_parse(claim: tailscale_machine_name_stage_prepare_window_claim)

data claim_of_no_window: TailscaleMachineNameWindow = WindowUndeclared { claim: "unset" }

// ── NO-OP AND APPLY ARE ONE FOLD OVER TWO DOCUMENTS ─────────────────────────────────────────────────
//
// The device reports `srv1`. The derivation wants `srv1` for one subject identity and `srv4` for the other, so
// the same reading is a no-op for one and one owed write for the other -- and the owed write carries both ends,
// which is what makes a rename window reversible without remembering anything.
test fn a_reading_that_matches_the_derivation_is_a_no_op() -> Bool {
  match tailscale_machine_name_plan(
    host: operator_host_srv1,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  ) {
    DeviceNameAlreadyCurrent { name: name } => name == "srv1"
    _ => false
  }
}

test fn a_reading_that_differs_from_the_derivation_owes_one_write_naming_both_ends() -> Bool {
  match tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  ) {
    DeviceNameChangeOwed { from_name: from_name, to_name: to_name } =>
      from_name == "srv1" && to_name == "srv4"
    _ => false
  }
}

// THE REVERSE DIRECTION IS NOT A SECOND MODE: swapping which registry row the subject is turns the same plan
// into the rename window's rollback. This is the case that fails if the fold ever decides a rename may run one
// way only -- and it is the half of P8c the plan asks for by name.
test fn the_same_plan_over_the_swapped_pair_is_the_rename_window_rollback() -> Bool {
  let forward = tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  )
  let back = tailscale_machine_name_plan(
    host: operator_host_srv1,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv4_document)
  )
  match forward {
    DeviceNameChangeOwed { from_name: here, to_name: there } =>
      match back {
        DeviceNameChangeOwed { from_name: back_here, to_name: back_there } =>
          here == back_there && there == back_here
        _ => false
      }
    _ => false
  }
}

// ── THE WINDOW GATE, AND THE CONTROL THAT KEEPS IT FROM BEING A REFLEXIVE NO ────────────────────────
//
// An apply outside the rename window is refused before anything is read or derived: a name a host has not been
// moved to is a name its peers will fail to reach, so the additive prepare stage must not touch it. The
// observe-only mode outside that window is NOT refused, and without that second case this gate would be
// satisfied by a mode that always says no.
test fn an_apply_outside_the_rename_window_is_refused_by_the_window_gate() -> Bool {
  let inside_prepare = tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_prepare_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  )
  let no_claim_at_all = tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_no_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  )
  match inside_prepare {
    PlanRefused { cause: WindowIsNotTheRenameWindow { window: claimed, mode: ApplyInsideWindow } } =>
      match no_claim_at_all {
        PlanRefused { cause: WindowIsNotTheRenameWindow { window: other, mode: ApplyInsideWindow } } =>
          other == claim_of_no_window && claimed == claim_of_prepare_window
        _ => false
      }
    _ => false
  }
}

test fn an_observe_outside_the_rename_window_is_not_refused_by_the_window_gate() -> Bool {
  match tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_prepare_window,
    mode: ObserveOnly,
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  ) {
    DeviceNameChangeOwed { from_name: from_name, to_name: to_name } => true
    _ => false
  }
}

// THE WINDOW IS A CLAIM THAT IS READ, and an absence is its own arm rather than a default: a run that never
// said which stage it believes it is in has to be reported in those words, and a claim with stray whitespace
// is not the rename window by near-miss.
test fn the_window_claim_parses_to_its_window_and_an_unclaimed_window_stays_unclaimed() -> Bool {
  claim_of_rename_window == RenameWindow
    && claim_of_prepare_window == PrepareWindow
    && tailscale_machine_name_window_parse(claim: "") != RenameWindow
    && tailscale_machine_name_window_parse(claim: "rename-window ") != RenameWindow
}

// ── THE REFUSALS: EACH STRUCTURAL CASE KEEPS ITS OWN CAUSE ──────────────────────────────────────────
//
// The two the brief names -- an unparseable document and an absent `Self` -- plus the member-level cases that
// decide what the mode may ever hand to `set`. Flattening these into "could not read the name" would send an
// operator to the wrong repair: a missing `Self` is tailscaled not answering, a malformed `HostName` is the
// daemon printing something other than the shape the extdeps row cites.
test fn an_unparseable_status_document_refuses_with_that_cause() -> Bool {
  match tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: document_unreadable)
  ) {
    PlanRefused { cause: StatusDocumentRefused { cause: StatusDocumentUnreadable { detail: _ } } } => true
    _ => false
  }
}

test fn a_status_document_without_a_self_member_refuses_with_that_cause() -> Bool {
  match tailscale_machine_name_plan(
    host: operator_host_srv4,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: tailscale_machine_name_document(document: self_member_absent_document)
  ) {
    PlanRefused { cause: StatusDocumentRefused { cause: StatusSelfMemberAbsent } } => true
    _ => false
  }
}

// The read-back goes through the same rule as the plan, so a device that answers without a name refuses at
// either end of the write -- there is no path where a missing name becomes an empty one.
test fn a_self_member_without_a_host_name_refuses_instead_of_inventing_one() -> Bool {
  match tailscale_machine_name_read_back(
    requested: "srv4",
    observation: tailscale_machine_name_document(document: self_host_name_absent_document)
  ) {
    ReadBackRefused { cause: StatusDocumentRefused { cause: StatusHostNameMemberAbsent } } => true
    _ => false
  }
}

test fn an_empty_host_name_refuses_rather_than_becoming_a_name_of_nothing() -> Bool {
  match tailscale_status_self_name(status_json: self_host_name_empty_document) {
    ReadingRefused { cause: StatusHostNameEmpty } => true
    _ => false
  }
}

test fn a_malformed_host_name_keeps_its_own_cause_through_the_parser() -> Bool {
  match tailscale_status_self_name(status_json: self_host_name_wrong_type_document) {
    ReadingRefused { cause: StatusHostNameMemberMalformed { detail: _ } } => true
    _ => false
  }
}

// THE NAME THE FOLD COMPARES IS `Self.HostName`, NEVER `Self.DNSName`. This is the fact the mode rests on, and
// a fold that read the tailnet address as the machine's name would pass every other case in this file.
test fn the_name_compared_is_the_host_name_and_never_the_dns_name() -> Bool {
  let reading = tailscale_machine_name_document(document: self_dns_name_is_not_the_name_document)
  let plan_over_it = tailscale_machine_name_plan(
    host: operator_host_srv1,
    window: claim_of_rename_window,
    mode: ApplyInsideWindow,
    observation: reading
  )
  match reading {
    DeviceNameReported { name: name, dns_name: dns_name } =>
      name == "srv4"
        && match plan_over_it {
             DeviceNameChangeOwed { from_name: from_name, to_name: to_name } =>
               from_name == "srv4" && to_name == "srv1"
             _ => false
           }
    _ => false
  }
}

// ── THE READ-BACK: THE WRITE IS NOT BELIEVED UNTIL THE DEVICE SAYS IT ───────────────────────────────
//
// A second, independent leg through the same parser, compared against what was asked for. "The set command
// exited 0" is not the claim; "status on the device now reports that name" is, and disagreement and silence are
// both refusals rather than a converged run.
test fn a_read_back_reporting_what_was_asked_for_confirms_the_run() -> Bool {
  match tailscale_machine_name_read_back(
    requested: "srv4",
    observation: tailscale_machine_name_document(document: self_names_srv4_document)
  ) {
    ReadBackConfirmsRequested { name: name } => name == "srv4"
    _ => false
  }
}

test fn a_read_back_still_reporting_the_old_name_refuses_the_run() -> Bool {
  match tailscale_machine_name_read_back(
    requested: "srv4",
    observation: tailscale_machine_name_document(document: self_names_srv1_document)
  ) {
    ReadBackContradictsRequest { requested: requested, reported: reported } =>
      requested == "srv4" && reported == "srv1"
    _ => false
  }
}

// A DEVICE THAT STOPS ANSWERING BETWEEN THE WRITE AND THE READ IS A REFUSAL, NOT A FAILURE TO NOTICE -- the
// case that keeps a half-renamed window from being reported as converged.
test fn a_read_back_the_device_cannot_answer_refuses_the_run() -> Bool {
  match tailscale_machine_name_read_back(
    requested: "srv4",
    observation: ObservationRefused { cause: StatusDocumentRefused { cause: StatusSelfMemberAbsent } }
  ) {
    ReadBackRefused { cause: StatusDocumentRefused { cause: StatusSelfMemberAbsent } } => true
    _ => false
  }
}

// ── THE DERIVATION, AND THE ONE AUTHORITY IT BELONGS TO ─────────────────────────────────────────────
//
// TEMPORARY, AND THE CASE SAYS SO: the desired label comes from gunbc.fleet.fleet_tailnet tailnet_host_from
// over the host's fleet identity, which is the placeholder the fleet projects for a tailnet name today. P4
// re-types that projection to take the machine's human name; when it lands this is the seam that re-points,
// and nothing else in the mode moves.
test fn the_desired_name_is_the_label_of_the_one_derivation_the_fleet_already_projects() -> Bool {
  match fleet_tailnet_domain {
    Absent => false
    Present { value: domain } =>
      match tailscale_machine_name_desired(host: operator_host_srv4) {
        DerivedName { name: name } =>
          name == "srv4" && join([name as String, ".", domain as String], "") == tailnet_host_from(host: operator_host_srv4 as NonEmptyStr, domain: Present { value: domain })
        _ => false
      }
  }
}

// ── INHABITATION: THE CLAIMS DRIVE THE REAL EMITTER, NOT A FIXTURE OF AN ARGV ───────────────────────
//
// A fold tested against a hand-written argv proves nothing about what runs. These cases ask the mode's own
// builders -- the extdeps rows, through the carrier that lets them name their program at all -- for the words
// they emit, and compare them to the words tailscale.com documents. `--hostname=` is ONE joined word: a builder
// that split flag from value could pass a name the parser never saw.
test fn the_status_words_are_the_real_emitter_and_carry_no_target_or_host() -> Bool {
  argv_words(command: tailscale_status_json_command()) == ["tailscale", "status", "--json"]
    && tailscale_status_json_argv() == ["status", "--json"]
}

test fn the_write_words_are_one_joined_hostname_word_not_two() -> Bool {
  argv_words(command: tailscale_set_hostname_command(name: "fox")) == ["tailscale", "set", "--hostname=fox"]
    && tailscale_set_hostname_argv(name: "fox") == ["set", "--hostname=fox"]
}

// THE WRITE IS THE ELEVATED LEG: `tailscale set` needs root on the host, and the carrier is the sudo row --
// including its non-interactive claim, which is the row's own rather than something this mode adds. The read
// is not elevated, which is the other half of the case: a mode that wrapped both would be running a read it
// has no reason to run as root.
test fn the_write_carries_the_sudo_row_and_the_read_does_not() -> Bool {
  let elevated = sudo_elevate_argv(command: argv_words(command: tailscale_set_hostname_command(name: "fox")))
  elevated == ["sudo", "-n", "tailscale", "set", "--hostname=fox"]
    && argv_command_is_sudo_elevated(command: sudo_elevate_command(command: tailscale_set_hostname_argv(name: "fox")))
    && !argv_command_is_sudo_elevated(command: tailscale_status_json_command())
}

// THE ROUTE IS THE FLEET REACH MODEL, WHICH IS WHAT MAKES THIS ONE MODE FOR EVERY SUBJECT: what the emitter
// contributes is host-free, and the host enters only as the target the reach model derives for the subject,
// under the fleet's bootstrap principal. Two registry rows give two different routes -- a mode that spelled a
// host would have one route and one host.
test fn the_leg_words_are_host_free_and_the_route_comes_from_the_reach_model() -> Bool {
  let first = administrator_ssh_target(host: operator_host_srv1)
  let second = administrator_ssh_target(host: operator_host_srv4)
  match first {
    SshTargetResolved { target: one } =>
      match second {
        SshTargetResolved { target: other } =>
          ssh_target_destination(target: one) != ssh_target_destination(target: other)
            && one.principal == executor_bootstrap_principal.login
            && !string_contains(
                 s: string_join(fields: argv_words(command: tailscale_status_json_command()), separator: " "),
                 pattern: "srv"
               )
        _ => false
      }
    _ => false
  }
}
