module test.claim.language_residue_census_representability

import std.types { String, NonEmptyStr, Bool, Int, List }
import std.decl_ref { DeclarationRef, decl_ref }
import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_tagged_structural,
  content_hash_combine_structural,
  content_hash_eq_structural,
}
import std.language_target_identity {
  LanguageTargetSurfaceRow,
  LanguageTargetSurfaceLocus,
  surface_locus_eq,
  SurfaceDeclaration,
  SurfaceModule,
  LanguageTargetSurfaceAuthority,
  StdLanguageCatalogue,
  TargetModelDeclaration,
  EmitHostExecution,
  TargetVocabulary,
  RuntimeChecker,
  LegacyFrontier,
}
import gunbc.language_target_registry { language_target_surface_census }
import gunbc.repository_census_observation {
  RepositoryIdentity,
  SourceRootIdentity,
  CensusSubjectKey,
  RepositoryPopulation,
  CensusMethodRunIdentity,
  CensusObservedRow,
  RepositoryCensusObservation,
  census_observed_row,
  census_declaration_ref_identity,
  repository_census_observation,
  repository_census_row_count,
  repository_census_subject_keys,
  repository_census_observation_identity,
  repository_census_observation_identity_eq,
}
import gunbc.guarantee_measurement { MeasurementRevision, GitRevision }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data representability_receipt_note: String = "CENSUS-0A REPRESENTABILITY RECEIPT, blocker 8 first half (operator ruling 2026-08-04: a synthetic witness suite discharges neither half, and 0A must prove that the carrier can faithfully hold a REAL repository census before it is ready). SUBJECT: gunbc.repository_census_observation at 0A head ca75137ee3a5b0796cc89e8de1f0c195fde80cca. CONSUMER: the language-residue census, gunbc.language_target_registry language_target_surface_census, stacked over that head — scaffold retirement is still blocked on the reflection surface and is deliberately not used. This file is NOT part of the 0A pull request; it executes on the stacked branch and its receipt names the exact 0A head above, which is what makes it evidence about that head rather than about whatever the branch later becomes. WHAT IT PROVES, in two separable halves the operator asked for and which must not be blurred. EXPRESSIBILITY: the actual residue rows, at their real two grains, map into CensusObservedRow with intrinsic identities, the actual repository population is expressible, and the observation identity is stable and moves when any measured part moves. POPULATION FAITHFULNESS: the carried population IS the consumer population, established by a CROSS-EQUIVALENCE CARDINALITY CHECK — distinct subject keys under this file's string equality against distinct loci under the consumer's own surface_locus_eq — never by comparing totals of one list against itself. The missing and unexpected set arms are a construction-path guard rather than the establishing evidence, and residue_conjunct_liveness_note says exactly which conjunct carries the claim and why the distinction matters. AN EARLIER REVISION OF THIS RECEIPT SETTLED THE FAITHFULNESS HALF WITH A COUNT EQUALITY AND THAT ASSERTION COULD NOT FAIL: carried was count of the observation rows, which are the census rows mapped, and the consumer figure was count of the census rows, so the claim was count(map(xs)) == count(xs) — true by construction for any total map, and blind to the one defect that matters here. If the subject-key function collided two distinct real surfaces onto one key, every witness still passed, because map preserves length and the identity fold still yields a stable address. A census that silently merges two surfaces is precisely what this carrier exists to prevent, so the receipt was making a population claim with an oracle that could not see the population. DESIGN section 5 names the class exactly: a measurement copied from the same current tree is not an oracle, and completeness is an identity join, not a count equality. THE INDEPENDENT ORACLE now used for distinctness is the CONSUMER OWN EQUALITY: surface_locus_eq decides how many distinct surfaces the residue census has, and that count is compared against the number of distinct subject keys this file derives. Those are two different authorities answering one question, so a collision in the key function shows up as a disagreement rather than being absorbed. WHAT IT DOES NOT PROVE, stated so nobody reads more from a green run: nothing here establishes how much of the target-bearing population the residue census COVERS. The consumer's own maximum-conclusion note is explicit that its population is HAND-DECLARED, so a target-bearing surface nobody wrote a row for is invisible to every assertion over it. STATED PRECISELY, because the imprecise version was corrected in review and the difference is the whole point: three rows naming modules that did not exist were found and FIXED, and under the corrected instrument the census has zero phantoms — the INSTANCES ARE CLOSED. What remains open is the CLASS, and it is uncaught BY CONSTRUCTION rather than by oversight, because the population is the thing being asserted over and no assertion inside a module can validate its own denominator. Citing the closed instances as if they were a live defect would be the same overstatement this receipt was corrected for one paragraph up. The class is what CENSUS-0B's denominator join must close, with a Node-tree observer deriving the population from the real module tree; and that observer must match the containment lens at STRING-PREFIX grain rather than namespace grain, because the lens confines by string prefix and a namespace-shaped instrument manufactures phantoms out of the lens's real rows — v2.workflow.bash covers the siblings v2.workflow.bash_command_fold_serialize and v2.workflow.bash_emit, which share a name stem and are not children of a namespace. Until that observer exists this receipt establishes expressibility and population faithfulness, and says nothing whatever about coverage."

data residue_repository_population: RepositoryPopulation = RepositoryPopulation {
  repository: "gunbc" as RepositoryIdentity,
  first_source_root: "dag" as SourceRootIdentity,
  additional_source_roots: ["src/v2" as SourceRootIdentity],
  inclusion_rule: decl_ref(
    module_path: "gunbc.language_target_registry",
    decl_name: "language_target_surface_census",
  ),
  exclusion_rule: Absent,
}

data residue_subject_revision: MeasurementRevision = GitRevision {
  commit: "ca75137ee3a5b0796cc89e8de1f0c195fde80cca",
}

data residue_method_run: CensusMethodRunIdentity = CensusMethodRunIdentity {
  classifier: decl_ref(
    module_path: "test.claim.language_residue_census_representability",
    decl_name: "residue_row_to_census_row",
  ),
  classifier_revision: residue_subject_revision,
  invocation_identity: content_hash_atom(
    value: "language-target-surface-census-full-roster" as NonEmptyStr,
  ),
}

fn residue_surface_subject_key(locus: LanguageTargetSurfaceLocus) -> CensusSubjectKey {
  match locus {
    SurfaceDeclaration { ref: reference } =>
      concat(
        concat(reference.module_path, "::"),
        reference.decl_name,
      ) as CensusSubjectKey
    SurfaceModule { module_path: path } => path as CensusSubjectKey
  }
}

fn residue_authority_tag(authority: LanguageTargetSurfaceAuthority) -> NonEmptyStr {
  match authority {
    StdLanguageCatalogue => "std-language-catalogue" as NonEmptyStr
    TargetModelDeclaration => "target-model-declaration" as NonEmptyStr
    EmitHostExecution => "emit-host-execution" as NonEmptyStr
    TargetVocabulary => "target-vocabulary" as NonEmptyStr
    RuntimeChecker => "runtime-checker" as NonEmptyStr
    LegacyFrontier => "legacy-frontier" as NonEmptyStr
  }
}

data residue_fact_identity_note: String = "THE DOMAIN-FACT IDENTITY IS DERIVED STRUCTURALLY, WHICH IS THE CHOICE CENSUS-0A DEFERRED TO THIS CONSUMER. The measured fact about a residue surface is which authority declared it and which target it was identified as, or that it was identified as none. Both parts are already declaration references or closed variants with canonical addresses, so this derives an identity by tagged structural combination and never renders anything to text — the concrete reason 0A carries an opaque fact identity rather than a generic value plus a caller-supplied rendering. The identified and unidentified arms are tagged DIFFERENTLY rather than the unidentified case being an absent field, so a surface joined to no target is a measured fact with its own address, not a hole."

fn residue_fact_identity(row: LanguageTargetSurfaceRow) -> Fnv1a64Structural {
  let authority_part = content_hash_tagged_structural(
    tag: "residue-fact-authority",
    payload: content_hash_atom(value: residue_authority_tag(authority: row.authority)),
  )
  let target_part = match row.target {
    Present { value: target } =>
      content_hash_tagged_structural(
        tag: "residue-fact-identified-target",
        payload: census_declaration_ref_identity(reference: target),
      )
    Absent =>
      content_hash_tagged_structural(
        tag: "residue-fact-unidentified",
        payload: content_hash_atom(value: "no-registered-target" as NonEmptyStr),
      )
  }
  content_hash_combine_structural(left: authority_part, right: target_part)
}

fn residue_row_to_census_row(row: LanguageTargetSurfaceRow) -> CensusObservedRow {
  census_observed_row(
    subject: residue_surface_subject_key(locus: row.surface),
    fact: residue_fact_identity(row: row),
  )
}

fn residue_census_observation() -> RepositoryCensusObservation {
  repository_census_observation(
    population: residue_repository_population,
    observed_at_revision: residue_subject_revision,
    method_run: residue_method_run,
    rows: language_target_surface_census |> map(row => residue_row_to_census_row(row: row)),
  )
}

fn residue_subject_key_in(key: CensusSubjectKey, keys: List<CensusSubjectKey>) -> Bool {
  any(keys, k => (k as String) == (key as String))
}

fn residue_distinct_subject_key_count(keys: List<CensusSubjectKey>) -> Int {
  count(
    fold(keys, init: [], f: fn(acc, key) {
      if residue_subject_key_in(key: key, keys: acc) { acc } else { append(acc, [key]) }
    })
  )
}

fn residue_distinct_locus_count(rows: List<LanguageTargetSurfaceRow>) -> Int {
  count(
    fold(rows, init: [], f: fn(acc, row) {
      if any(acc, seen => surface_locus_eq(a: seen, b: row.surface)) {
        acc
      } else {
        append(acc, [row.surface])
      }
    })
  )
}

fn residue_expected_subject_keys() -> List<CensusSubjectKey> {
  language_target_surface_census |> map(row => residue_surface_subject_key(locus: row.surface))
}

data residue_conjunct_liveness_note: String = "WHICH CONJUNCT CARRIES THE CLAIM, and which are guards. Recorded because a discriminating RED for a CONJUNCTION licenses exactly the conjunct it trips, and nothing else — the mutation that collided two real surfaces onto one key tripped the cardinality cross-check, so it established THAT conjunct and said nothing about the others. Crediting one live conjunct to a four-way conjunction is indistinguishable from four live conjuncts, and it is the same substitution class this receipt was already corrected for twice. To claim a conjunction as N pieces of evidence takes N mutations, one per conjunct, each failing for its own reason. WHAT ESTABLISHES POPULATION FAITHFULNESS: distinct_keys == distinct_loci, and only that. It compares distinct subject keys under STRING equality, derived by this file, against distinct loci under surface_locus_eq, the CONSUMER's own STRUCTURAL equality — two authorities with two different notions of identity over one population, so a key collision strictly reduces one side and not the other and the check fires. WHAT THE MISSING AND UNEXPECTED CONJUNCTS ARE: a CONSTRUCTION-PATH GUARD, not evidence of faithfulness. Today they cannot fail, and the path is short enough to state: residue_row_to_census_row sets subject to residue_surface_subject_key of row.surface, the observation constructor is a total map over language_target_surface_census, and residue_expected_subject_keys is that same expression written out — so the two lists are THE SAME LIST BY CONSTRUCTION and the join is a self-join. They are kept deliberately, because they become live the moment that path stops being a total map, which is a real future regression, and because they are strictly stronger than the count equality they replaced: a count misses a substitution and these catch one. They are simply not what makes the population claim true. AN OPEN FRONTIER, NAMED RATHER THAN CLOSED: a SYSTEMATIC MISLABELING THAT PRESERVES INJECTIVITY — every surface mapped to a wrong but distinct key — passes everything in this file. Both cardinalities still agree, and missing and unexpected are empty because the expected side derives from the same function under test. No oracle for that exists here; it needs CENSUS-0B's Node-tree observer deriving keys from the real module tree independently of the key function, at the containment lens's string-prefix grain. Not built here."

test fn witness_subject_key_distinctness_agrees_with_the_consumer_own_locus_equality() -> Bool {
  let observation = residue_census_observation()
  let observed_keys = repository_census_subject_keys(observation: observation)
  let expected_keys = residue_expected_subject_keys()
  let missing = expected_keys |> filter(k => !residue_subject_key_in(key: k, keys: observed_keys))
  let unexpected = observed_keys |> filter(k => !residue_subject_key_in(key: k, keys: expected_keys))
  let distinct_keys = residue_distinct_subject_key_count(keys: observed_keys)
  let distinct_loci = residue_distinct_locus_count(rows: language_target_surface_census)
  count(observed_keys) > 0
    && count(missing) == 0
    && count(unexpected) == 0
    && distinct_keys == distinct_loci
}

test fn witness_no_two_real_surfaces_collide_onto_one_subject_key() -> Bool {
  let observation = residue_census_observation()
  let observed_keys = repository_census_subject_keys(observation: observation)
  let distinct_keys = residue_distinct_subject_key_count(keys: observed_keys)
  let distinct_loci = residue_distinct_locus_count(rows: language_target_surface_census)
  let duplicates = observed_keys |> filter(k =>
    count(observed_keys |> filter(other => (other as String) == (k as String))) > 1
  )
  count(observed_keys) > 0
    && distinct_keys == distinct_loci
    && count(duplicates) == 0
}

test fn witness_the_real_residue_census_is_expressible_as_an_observation() -> Bool {
  let observation = residue_census_observation()
  repository_census_row_count(observation: observation) > 0
}

test fn witness_the_real_observation_identity_is_stable_across_reads() -> Bool {
  let first = residue_census_observation()
  let second = residue_census_observation()
  content_hash_eq_structural(
    left: repository_census_observation_identity(observation: first),
    right: repository_census_observation_identity(observation: second),
  )
    && repository_census_observation_identity_eq(left: first, right: second)
}

test fn witness_both_real_surface_grains_carry_distinct_subject_keys() -> Bool {
  let declaration_subject = residue_surface_subject_key(
    locus: SurfaceDeclaration {
      ref: decl_ref(module_path: "std.languages", decl_name: "rust_language"),
    },
  )
  let module_subject = residue_surface_subject_key(
    locus: SurfaceModule { module_path: "std.languages" },
  )
  (declaration_subject as String) == "std.languages::rust_language"
    && (module_subject as String) == "std.languages"
    && (declaration_subject as String) != (module_subject as String)
}

test fn witness_an_identified_surface_is_a_different_fact_than_an_unidentified_one() -> Bool {
  let unidentified = residue_fact_identity(
    row: LanguageTargetSurfaceRow {
      authority: StdLanguageCatalogue,
      surface: SurfaceDeclaration {
        ref: decl_ref(module_path: "std.languages", decl_name: "rust_language"),
      },
      target: Absent,
    },
  )
  let identified = residue_fact_identity(
    row: LanguageTargetSurfaceRow {
      authority: StdLanguageCatalogue,
      surface: SurfaceDeclaration {
        ref: decl_ref(module_path: "std.languages", decl_name: "rust_language"),
      },
      target: Present {
        value: decl_ref(module_path: "extdeps.languages.bash.subject", decl_name: "gnu_bash"),
      },
    },
  )
  let other_authority = residue_fact_identity(
    row: LanguageTargetSurfaceRow {
      authority: LegacyFrontier,
      surface: SurfaceDeclaration {
        ref: decl_ref(module_path: "std.languages", decl_name: "rust_language"),
      },
      target: Absent,
    },
  )
  !content_hash_eq_structural(left: unidentified, right: identified)
    && !content_hash_eq_structural(left: unidentified, right: other_authority)
}

test fn witness_reclassifying_one_real_surface_moves_the_whole_observation_identity() -> Bool {
  let observed = residue_census_observation()
  let reclassified = repository_census_observation(
    population: residue_repository_population,
    observed_at_revision: residue_subject_revision,
    method_run: residue_method_run,
    rows: language_target_surface_census |> map(row =>
      census_observed_row(
        subject: residue_surface_subject_key(locus: row.surface),
        fact: residue_fact_identity(
          row: LanguageTargetSurfaceRow {
            authority: row.authority,
            surface: row.surface,
            target: Present {
              value: decl_ref(
                module_path: "extdeps.languages.bash.subject",
                decl_name: "gnu_bash",
              ),
            },
          },
        ),
      )
    ),
  )
  let observed_rows = repository_census_row_count(observation: observed)
  let reclassified_rows = repository_census_row_count(observation: reclassified)
  observed_rows == reclassified_rows
    && !repository_census_observation_identity_eq(left: observed, right: reclassified)
}

test fn witness_the_same_residue_rows_under_a_narrower_population_are_a_new_observation() -> Bool {
  let repo_wide = residue_census_observation()
  let dag_only = repository_census_observation(
    population: RepositoryPopulation {
      repository: "gunbc" as RepositoryIdentity,
      first_source_root: "dag" as SourceRootIdentity,
      additional_source_roots: [],
      inclusion_rule: decl_ref(
        module_path: "gunbc.language_target_registry",
        decl_name: "language_target_surface_census",
      ),
      exclusion_rule: Absent,
    },
    observed_at_revision: residue_subject_revision,
    method_run: residue_method_run,
    rows: language_target_surface_census |> map(row => residue_row_to_census_row(row: row)),
  )
  let repo_wide_rows = repository_census_row_count(observation: repo_wide)
  let dag_only_rows = repository_census_row_count(observation: dag_only)
  repo_wide_rows == dag_only_rows
    && !repository_census_observation_identity_eq(left: repo_wide, right: dag_only)
}
