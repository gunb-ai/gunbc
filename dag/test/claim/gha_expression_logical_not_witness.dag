module test.claim.gha_expression_logical_not_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool }
import extdeps.github.expressions { Expression, ContextAccess, Github, StringLiteral, Equals, LogicalAnd, LogicalNot, FunctionCall, Cancelled, serialize_expression, evaluate_expression }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE UNARY `!` (extdeps.github.expressions github_expression_operators_authority): it binds tighter
// than comparison, so an atom operand renders bare and a comparison operand is grouped; under `&&` it
// needs no group. Kept apart from test.claim.gha_expression_roundtrip, which does not resolve today
// (it declares no imports).
test fn logical_not_renders_with_upstream_precedence() -> Bool {
  serialize_expression(expression: LogicalNot { operand: FunctionCall { function: Cancelled, args: [] } }) == "!cancelled()"
    && serialize_expression(expression: LogicalNot { operand: Equals { left: ContextAccess { context: Github, path: ["sha"] }, right: StringLiteral { value: "x" } } }) == "!(github.sha == 'x')"
    && serialize_expression(expression: LogicalAnd { left: LogicalNot { operand: FunctionCall { function: Cancelled, args: [] } }, right: StringLiteral { value: "y" } }) == "!cancelled() && 'y'"
}
