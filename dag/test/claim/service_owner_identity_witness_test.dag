module test.claim.service_owner_identity_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CompileDiagnosticCensusRow,
  CensusObserved,
  CensusNotRunnable,
  census_count_at_key,
  census_blocking_rows,
  census_total_count
}
import std.types { String, Bool, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// A SERVICE RECEIVER IS JOINED BY DECLARATION IDENTITY -- OWNER MODULE PLUS NAME -- NOT BY SPELLING.
// Two real declarations share the name Filesystem: extdeps.filesystem.filesystem_io's SERVICE
// (operation Write -> success, bytes_written, path, error) and std.resources's RESOURCE (capability
// write -> written). The seed's infer used to seed every bare-declared service of the corpus into
// every module and join a receiver to it by leaf name, so importing the resource and calling Write
// was typed from the service's operation (#12185 runner_guest_image; gunbc.recurring_failure_mode
// surface_shorthand_preempts_resolved_identity). The pair below is the discriminating fixture: ONE
// producer, and the arms differ only in which module the import names.
fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// EXACT: this class, this subject, blocking only. The NotRunnable arm is a visible sentinel, never a
// zero, so a harness that could not compile reads as a failure of both arms rather than a pass of one.
fn keyed_count(source: String, wanted_class: String, wanted_subject: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: wanted_class, subject_name: wanted_subject, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn blocking_total(source: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn owner_mismatch_count(source: String) -> Int {
  keyed_count(source: source, wanted_class: "ServiceOwnerMismatch", wanted_subject: "Filesystem")
}

// THE ONE-AXIS PRODUCER. The body reads the SERVICE's output field `success`, so the accepted arm
// asserts the ROUTE as well as the verdict: it compiles clean only if Write was typed from the
// service's operation.
// The constant import puts the service's module into the probe's closure WITHOUT naming the
// service, which is the shape of every real specimen: gunbc.runner_attempt_launch reached
// extdeps.filesystem.filesystem_io transitively while importing only std.resources's Filesystem.
fn write_probe_source(owner_module: String) -> String {
  "module probe_service_owner_identity\nimport std.types { String, Bool }\nimport extdeps.filesystem.filesystem_io { filesystem_read_outcome }\nimport "
    + owner_module
    + " { Filesystem }\nfn stage(path: String, content: String) -> Bool {\n  let wrote = Filesystem.Write(path: path, content: content)\n  wrote.success\n}\n"
}

data service_owner: String = "extdeps.filesystem.filesystem_io"
data resource_owner: String = "std.resources"

// GREEN: the service imported by its owner, Write called -- no blocking diagnostic at all.
test fn the_imported_service_write_is_accepted() -> Bool {
  blocking_total(source: write_probe_source(owner_module: service_owner)) == 0
}

// RED: the same program importing the same-named RESOURCE refuses, exactly once, at the receiver.
test fn the_resource_homonym_write_refuses_at_the_receiver() -> Bool {
  owner_mismatch_count(source: write_probe_source(owner_module: resource_owner)) == 1
}

// The refusal belongs to the receiver, not to the import: a module that imports the resource and
// never uses the name as a receiver is not refused.
data resource_import_only_source: String = "module probe_service_owner_identity_import_only\nimport std.types { Bool }\nimport std.resources { Filesystem }\nfn nothing() -> Bool {\n  true\n}\n"

test fn importing_the_resource_alone_is_not_refused() -> Bool {
  owner_mismatch_count(source: resource_import_only_source) == 0
}

// CONTROL, not a discriminator: with no import the service is not in the probe's closure, so the
// bare name was never joined -- it is an undefined variable before and after this change. It pins
// that the scoping did not turn the unbound case into a service join by another route.
data unimported_write_source: String = "module probe_service_owner_identity_unimported\nimport std.types { String, Bool }\nfn stage(path: String, content: String) -> Bool {\n  let wrote = Filesystem.Write(path: path, content: content)\n  wrote.success\n}\n"

test fn an_unimported_service_is_not_reached_by_its_bare_name() -> Bool {
  keyed_count(source: unimported_write_source, wanted_class: "InternalError", wanted_subject: "variable:Filesystem") == 1
}

// CONTROL for the collision rule: the service AND the same-named resource both imported -- the shape
// of gunbc.runner_microvm_slot_controller, which names the resource in a `uses fs: Filesystem`
// requirement and calls the service's Filesystem.Read. A resource is not a value in receiver
// position, so the pair is two declarations in two positions: the `uses fs: Filesystem` requirement
// names the resource and the receiver's Write is the service's. Asserted by key rather than by a
// blocking total, because std.resources's closure carries blocking diagnostics of its own that are
// not this claim's subject: no owner refusal, and Write's existence established. That key is not
// vacuous: it is exactly what the resource-only arm reports when no service answers Write.
data service_and_resource_source: String = "module probe_service_owner_identity_both\nimport std.types { String, Bool }\nimport extdeps.filesystem.filesystem_io { Filesystem }\nimport std.resources { Filesystem }\nfn stage(path: String, content: String) -> Bool {\n  let wrote = Filesystem.Write(path: path, content: content)\n  wrote.success\n}\nfn stage_under_requirement(path: String, content: String) -> Bool\n  uses fs: Filesystem\n{\n  let wrote = Filesystem.Write(path: path, content: content)\n  wrote.success\n}\n"

test fn a_resource_beside_the_imported_service_does_not_collide() -> Bool {
  owner_mismatch_count(source: service_and_resource_source) == 0
    && keyed_count(source: service_and_resource_source, wanted_class: "MethodExistenceUndecided", wanted_subject: "Write") == 0
}

// RED for the collision rule: two VALUES under one name -- a bare service and a data declaration,
// designed in test.fixture.service_owner_identity because no real pair exists -- have no position to
// tell them apart, so the receiver refuses rather than taking whichever the scope fold inserted last.
data two_values_source: String = "module probe_service_owner_identity_two_values\nimport std.types { String }\nimport test.fixture.service_owner_identity.service { OwnerIdentityProbe }\nimport test.fixture.service_owner_identity.value { OwnerIdentityProbe }\nfn ping() -> String {\n  let r = OwnerIdentityProbe.Ping()\n  r.ok\n}\n"

test fn two_values_under_one_name_refuse_at_the_receiver() -> Bool {
  keyed_count(source: two_values_source, wanted_class: "AmbiguousReference", wanted_subject: "OwnerIdentityProbe") == 1
}

// THE PLURAL HOMONYM, decided over the whole candidate set. Two modules declare a service named
// OwnerIdentityProbe (test.fixture.service_owner_identity.service and .service_b); a data value and a
// resource of that name live beside them. One producer, whose only axis is the ORDERED list of
// import lines, so every order is the same program up to import order -- and the verdict may not
// move with it.
fn owner_probe_source(import_lines: String) -> String {
  "module probe_service_owner_plural\nimport std.types { String }\n"
    + import_lines
    + "fn ping() -> String {\n  let r = OwnerIdentityProbe.Ping()\n  r.ok\n}\n"
}

data svc_a_named: String = "import test.fixture.service_owner_identity.service { OwnerIdentityProbe }\n"
data svc_b_named: String = "import test.fixture.service_owner_identity.service_b { OwnerIdentityProbe }\n"
data svc_a_all: String = "import test.fixture.service_owner_identity.service\n"
data svc_b_all: String = "import test.fixture.service_owner_identity.service_b\n"
data resource_named: String = "import test.fixture.service_owner_identity.resource { OwnerIdentityProbe }\n"
data value_named: String = "import test.fixture.service_owner_identity.value { OwnerIdentityProbe }\n"

fn ambiguous_count(import_lines: String) -> Int {
  keyed_count(source: owner_probe_source(import_lines: import_lines), wanted_class: "AmbiguousReference", wanted_subject: "OwnerIdentityProbe")
}

// ADMITTED, and by the route: no ambiguity, no owner refusal, and Ping's existence established --
// the key the unresolved arm reports, so a zero here is not vacuous.
fn admitted(import_lines: String) -> Bool {
  let src = owner_probe_source(import_lines: import_lines)
  keyed_count(source: src, wanted_class: "AmbiguousReference", wanted_subject: "OwnerIdentityProbe") == 0
    && keyed_count(source: src, wanted_class: "ServiceOwnerMismatch", wanted_subject: "OwnerIdentityProbe") == 0
    && keyed_count(source: src, wanted_class: "MethodExistenceUndecided", wanted_subject: "Ping") == 0
}

test fn two_same_named_services_refuse_in_either_order() -> Bool {
  ambiguous_count(import_lines: svc_a_named + svc_b_named) == 1
    && ambiguous_count(import_lines: svc_b_named + svc_a_named) == 1
}

test fn two_same_named_services_through_import_all_refuse_in_either_order() -> Bool {
  ambiguous_count(import_lines: svc_a_all + svc_b_all) == 1
    && ambiguous_count(import_lines: svc_b_all + svc_a_all) == 1
}

test fn either_service_alone_is_admitted_while_both_exist() -> Bool {
  admitted(import_lines: svc_a_named) && admitted(import_lines: svc_b_named)
}

test fn either_service_alone_through_import_all_is_admitted() -> Bool {
  admitted(import_lines: svc_a_all) && admitted(import_lines: svc_b_all)
}

test fn a_service_beside_a_same_named_resource_is_admitted_in_either_order() -> Bool {
  admitted(import_lines: svc_a_named + resource_named) && admitted(import_lines: resource_named + svc_a_named)
}

test fn service_resource_and_value_refuse_in_either_order() -> Bool {
  ambiguous_count(import_lines: svc_a_named + resource_named + value_named) == 1
    && ambiguous_count(import_lines: value_named + resource_named + svc_a_named) == 1
}
