}

fn signed_off_dispatch_node() -> RoadmapNode {
  let base = ready_dispatch_node()
  RoadmapNode {
    identity: "rnfx_08P5JSFSS1NH1YY20PWV" as RoadmapNodeIdentity,
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    sizing: base.sizing,
    execution: base.execution,
    owner: base.owner,
    signoff: gunbc.roadmap_authority.signed(by: "op", works: RedControlExecuted { witness_module: "test.fixture", witness_fn: "fixture_red_control", executed_on: "2026-07-28" }, scope_equivalent: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] }, as_expected: true),
  }
}

fn dispatch_doc_page(rn: RoadmapNode) -> Fragment {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  roadmap_page(doc: doc, merged: [])
}

data server_zero_furniture_note: String = "The attention rule's server half (A2): a rendered row carries NO workflow furniture — no pre-rendered stage chips, no lamp strip, no hidden progress container, no 'waiting' text. Activity DOM exists only when the client paints it from the decided /workflow.json view of a live attempt. The former version of this witness pinned the seven server-rendered pending chips as a POSITIVE; the same patterns are now the discriminating negatives, so reintroducing preloaded furniture reds here."

test fn witness_ready_node_doc_emits_button_and_external_script() -> Bool {
  let h = dispatch_doc_html_for(rn: ready_dispatch_node())
  string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
    && string_contains(s: h, pattern: "data-node=")
    && !string_contains(s: h, pattern: "workflow-progress")
    && !string_contains(s: h, pattern: "data-workflow-stage=")
    && !string_contains(s: h, pattern: "workflow-strip")
    && !string_contains(s: h, pattern: "workflow-lamp")
    && !string_contains(s: h, pattern: "class=\"node-activity\"")
    && string_contains(s: h, pattern: "<script src=\"/assets/roadmap-dispatch.js\"")
    && !string_contains(s: h, pattern: "querySelectorAll")
    && !string_contains(s: h, pattern: "j.status")
}

data client_reads_decided_activity_note: String = "A2 flip of the belt-B contract pins: the client consumes the DECIDED activity object (attempt.activity — arm, attention, summary, evidence) and the segment roster; the former positives provider_activity / workflow_status / remaining_obligations are now the discriminating NEGATIVES, because a client that re-derives a summary or a remaining count from the raw fields is a second projection authority. The segments receiver is pinned in its grouped spelling — (attempt.segments || []).forEach — the exact shape whose ungrouped form was the 2026-08-01 silent no-op."

test fn witness_dispatch_asset_reads_belt_b_status_contract() -> Bool {
  let js = dispatch_client_js_source()
  string_contains(s: js, pattern: "fetch('/dispatch/")
    && string_contains(s: js, pattern: "fetch('/workflow.json')")
    && string_contains(s: js, pattern: "attempt.activity")
    && string_contains(s: js, pattern: "av.arm")
    && string_contains(s: js, pattern: "av.attention")
    && string_contains(s: js, pattern: "(attempt.segments || []).forEach")
    && !string_contains(s: js, pattern: "provider_activity")
    && !string_contains(s: js, pattern: "workflow_status")
    && !string_contains(s: js, pattern: "remaining_obligations")
    && string_contains(s: js, pattern: "gunbcRefreshWorkflow().finally")
    && string_contains(s: js, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: js, pattern: "s === 'already_live' ? 'ok'")
    && all(
      belt_dispatch_all_status_labels(),
      label => string_contains(s: js, pattern: join(["'", label, "'"], "")),
    )
    && !string_contains(s: js, pattern: "j.node)")
}

test fn witness_page_script_census_clean() -> Bool {
  page_script_census(page: dispatch_doc_page(rn: ready_dispatch_node())).length() == 0
}

fn hand_inline_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [], children: [ FragmentText { content: "alert('rogue')" } ] },
  ] }
}

test fn witness_inline_hand_script_reds() -> Bool {
  let v = page_script_census(page: hand_inline_script_page())
  v.length() == 1 && all(v, x => x.kind == "inline-js" && x.detail == "alert('rogue')")
}

fn rogue_src_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [ attr(name: "src", value: "https://evil.example/x.js" ) ], children: [] },
  ] }
}

test fn witness_rogue_src_script_reds() -> Bool {
  let v = page_script_census(page: rogue_src_script_page())
  v.length() == 1 && all(v, x => x.kind == "unknown-src")
}

test fn witness_signed_off_node_doc_has_no_button() -> Bool {
  let h = dispatch_doc_html_for(rn: signed_off_dispatch_node())
  !string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
}

