module test.claim.roadmap_page_witness

import std.markup { Fragment, Element, FragmentText, attr }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }
import gunbc.roadmap_page {
  roadmap_page_for_authority,
  roadmap_page,
  nodes_ul,
  page_script_census,
  dispatch_client_script,
}
import gunbc.roadmap_document { RoadmapDocument, RoadmapSection }
import gunbc.roadmap_model {
  RoadmapNode,
  RoadmapEdge,
  section_group,
}
import gunbc.roadmap_component { dispatch_client_js_source }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn authority_page_html() -> String {
  match try_serialize_html_source(node: roadmap_page_for_authority()) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

data header_gained_the_sound_toggle_note: String = "The two header assertions below moved because the header genuinely gained a control: the mute toggle sits after the h1, pushed to the far edge. They are updated rather than loosened — the toggle is spelled out in the expected string, so the header's shape stays pinned exactly as tightly as before and a THIRD element appearing would still red. Loosening them to stop at </h1> would have been the easy fix and would have quietly retired the assertion."

test fn witness_authority_serializes_with_structure() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: "<header><svg viewBox=\"0 0 120 72\" class=\"mark mark-d1\"")
    && string_contains(
      s: h,
      pattern: "</svg><h1>gunbc — roadmap</h1><button class=\"sound-toggle\" type=\"button\"></button><button class=\"theme-toggle\" type=\"button\"></button></header>")
    && string_contains(s: h, pattern: "<main class=\"roadmap\">")
    && string_contains(s: h, pattern: "class=\"roadmap-section\"")
    && string_contains(s: h, pattern: "class=\"status status-")
}

fn empty_doc_html() -> String {
  let empty = RoadmapDocument { preamble: [], lead_lanes: [], sections: [] }
  match try_serialize_html_source(node: roadmap_page(doc: empty, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_empty_doc_is_minimal_shell() -> Bool {
  let h = empty_doc_html()
  starts_with(s: h, prefix: "<html><head><meta charset=\"utf-8\"")
    && string_contains(s: h, pattern: "<title>gunbc — roadmap</title></head>")
    && string_contains(s: h, pattern: "<body><header><svg viewBox=\"0 0 120 72\" class=\"mark mark-d1\"")
    && string_contains(
      s: h,
      pattern: "</svg><h1>gunbc — roadmap</h1><button class=\"sound-toggle\" type=\"button\"></button><button class=\"theme-toggle\" type=\"button\"></button></header><main class=\"roadmap\"></main></body></html>")
}

test fn witness_authority_differs_from_empty() -> Bool {
  !(authority_page_html() == empty_doc_html())
}

test fn witness_authority_shows_three_gate_progress() -> Bool {
  let authority = authority_page_html()
  let empty = empty_doc_html()
  string_contains(s: authority, pattern: "class=\"three-gate-progress\"")
    && string_contains(s: authority, pattern: "v1-delete bar: three gates")
    && !string_contains(s: empty, pattern: "class=\"three-gate-progress\"")
    && string_contains(s: authority, pattern: "Gate 1 — the emitter re-emits itself")
    && string_contains(s: authority, pattern: "Gate 3 — verification ledger green by execution")
    && !string_contains(s: authority, pattern: "Cutover and delete")
    && !string_contains(s: authority, pattern: "std_dup-gated modules")
}

fn depth_chain_html(fuel: Int) -> String {
  let parent = gunbc.roadmap_authority.authored(id: "p", done: false, content: "parent-node")
  let child = gunbc.roadmap_authority.authored(id: "c", done: false, content: "child-node-title")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  match try_serialize_html_source(node: nodes_ul(items: [parent], nodes: [parent, child], edges: [edge], merged: [], fuel: fuel)) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn bold_title_html() -> String {
  let rn = gunbc.roadmap_authority.authored(id: "bold1", done: false, content: "**bold** item")
  match try_serialize_html_source(node: nodes_ul(items: [rn], nodes: [rn], edges: [], merged: [], fuel: 0)) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_bold_title_renders_strong() -> Bool {
  let h = bold_title_html()
  string_contains(s: h, pattern: "<strong>bold</strong>")
    && !string_contains(s: h, pattern: "**")
}

test fn witness_depth_cap_fails_honest() -> Bool {
  let truncated = depth_chain_html(fuel: 0)
  let expanded = depth_chain_html(fuel: 1)
  string_contains(s: truncated, pattern: "depth limit")
    && !string_contains(s: truncated, pattern: "child-node-title")
    && string_contains(s: expanded, pattern: "child-node-title")
    && !string_contains(s: expanded, pattern: "depth limit")
}

fn dispatch_doc_html_for(rn: RoadmapNode) -> String {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  match try_serialize_html_source(node: roadmap_page(doc: doc, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn open_dispatch_node() -> RoadmapNode {
  gunbc.roadmap_authority.authored(id: "disp1", done: false, content: "dispatch-me")
}

fn signed_off_dispatch_node() -> RoadmapNode {
  let base = open_dispatch_node()
  RoadmapNode {
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    sizing: base.sizing,
    owner: base.owner,
    signoff: gunbc.roadmap_authority.signed(by: "op", works: true, scope_equivalent: true, as_expected: true),
  }
}

fn dispatch_doc_page(rn: RoadmapNode) -> Fragment {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  roadmap_page(doc: doc, merged: [])
}

test fn witness_open_node_doc_emits_button_and_external_script() -> Bool {
  let h = dispatch_doc_html_for(rn: open_dispatch_node())
  string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
    && string_contains(s: h, pattern: "data-node=")
    && string_contains(s: h, pattern: "<script src=\"/assets/roadmap-dispatch.js\"")
    && !string_contains(s: h, pattern: "querySelectorAll")
    && !string_contains(s: h, pattern: "j.status")
}

test fn witness_dispatch_asset_reads_belt_b_status_contract() -> Bool {
  let js = dispatch_client_js_source()
  string_contains(s: js, pattern: "fetch('/dispatch/")
    && string_contains(s: js, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: js, pattern: "s === 'already_live' ? 'ok'")
    && !string_contains(s: js, pattern: "j.ok")
    && !string_contains(s: js, pattern: "j.node)")
}

test fn witness_page_script_census_clean() -> Bool {
  page_script_census(page: dispatch_doc_page(rn: open_dispatch_node())).length() == 0
}

fn hand_inline_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [], children: [ FragmentText { content: "alert('rogue')" } ] },
  ] }
}

test fn witness_inline_hand_script_reds() -> Bool {
  let v = page_script_census(page: hand_inline_script_page())
  v.length() == 1 && all(v, x => x.kind == "inline-js" && x.detail == "alert('rogue')")
}

fn rogue_src_script_page() -> Fragment {
  Element { tag: "body", attributes: [], children: [
    dispatch_client_script(),
    Element { tag: "script", attributes: [ attr(name: "src", value: "https://evil.example/x.js" ) ], children: [] },
  ] }
}

test fn witness_rogue_src_script_reds() -> Bool {
  let v = page_script_census(page: rogue_src_script_page())
  v.length() == 1 && all(v, x => x.kind == "unknown-src")
}

test fn witness_signed_off_node_doc_has_no_button() -> Bool {
  let h = dispatch_doc_html_for(rn: signed_off_dispatch_node())
  !string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
}

fn superseded_dispatch_node() -> RoadmapNode {
  gunbc.roadmap_authority.superseded(id: "disp1", by: "successor-lane", content: "dispatch-me")
}

test fn witness_superseded_node_marked_no_button() -> Bool {
  let h = dispatch_doc_html_for(rn: superseded_dispatch_node())
  string_contains(s: h, pattern: "node node-superseded")
    && string_contains(s: h, pattern: "→ successor-lane")
    && !string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
}

data readable_witness_enrollment_note: String = "The six readability witnesses below (raw-text style serialization, chip min-width, container centering, the <details> disclosure, the dispatch accent) were authored with the fixes they verify but never bundled into this file's only `test fn`, and discovery keys on the `test fn `/`test data ` prefix — so they had ZERO executing consumers and CI was blind to the exact regressions they were written to catch. Proven by execution rather than by reading, 2026-07-24: reverting `.status` min-width back to width (the original defect) left roadmap_page_keystone_holds returning true. That is the orphaned-enrollment shape DESIGN calls coverage by illusion, and an inert witness is a lie about coverage, so they are enrolled here. Every witness in this file is now reachable from this one entry; adding an unbundled `fn witness_*` is the defect to look for in review."

test fn witness_ticket_rows_render_structured() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: "class=\"item-detail ticket-row\"><summary><span class=\"disclosure-mark\">›</span>ticket</summary>")
    && string_contains(s: h, pattern: "class=\"ticket-brief\"")
    && string_contains(s: h, pattern: ">displaced cost</span>")
    && string_contains(s: h, pattern: "class=\"ticket-updates\"")
    && string_contains(s: h, pattern: "href=\"https://github.com/gunb-ai/gunbc/blob/main/docs/plans/dispatch-maintain-cc.md\"")
}

fn long_brief_fixture() -> RoadmapNode {
  gunbc.roadmap_authority.ticket_row(id: "brief-overrun-fixture", done: false, t: TicketFields {
    headline: "fixture",
    brief: "w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w",
    displaced_cost: "",
    current_state: "",
    first_slice: "",
    red_control: "",
    out_of_scope: "",
    handback: "",
    updates: [],
    authored_on: "",
    last_verified_on: "",
  })
}

test fn witness_ticket_brief_budget_holds_and_reds() -> Bool {
  let planted = ticket_brief_violations(nodes: [long_brief_fixture()])
  count(roadmap_ticket_brief_violations()) == 0
    && count(planted) == 1
    && all(planted, v => v.node == "brief-overrun-fixture" && v.words == 101)
}

test fn witness_style_child_combinator_unescaped() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: ".node-superseded > .title")
    && !string_contains(s: h, pattern: "&gt; .title")
}

test fn witness_raw_text_close_guard_refuses() -> Bool {
  let bad = Element {
    tag: "style",
    attributes: [],
    children: [ FragmentText { content: "a \{ color: red } </style><p>escaped</p>" } ],
  }
  match try_serialize_html_source(node: bad) {
    EmitOk { html: _ } => false
    EmitRejected { reason: r } => string_contains(s: r, pattern: "close sequence")
  }
}

test fn witness_item_detail_disclosure_present() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: "<details class=\"item-detail\"><summary><span class=\"disclosure-mark\">›</span>brief</summary>")
    && string_contains(s: h, pattern: "class=\"item-body\"")
}

test fn witness_status_chip_min_width() -> Bool {
  string_contains(s: authority_page_html(), pattern: "min-width: var(--w-status)")
}

test fn witness_dispatch_button_carries_accent() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: ".dispatch-btn")
    && string_contains(s: h, pattern: "border-color: var(--band-invite)")
}

test fn witness_page_containers_centered() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: ".roadmap { padding: var(--space-16) var(--space-24); max-width: var(--measure); margin-left: auto; margin-right: auto }")
}

test fn witness_authority_leads_within_budget() -> Bool {
  roadmap_authority_lead_budget_violations().length() == 0
}

fn overlong_lead_node() -> RoadmapNode {
  let chunk = "a lead with no separator so the whole line stands "
  gunbc.roadmap_authority.authored(
    id: "overlong-lead",
    done: false,
    content: join([chunk, chunk, chunk, chunk, chunk, chunk, chunk], ""),
  )
}

test fn witness_overlong_lead_reds() -> Bool {
  let v = lead_budget_violations(nodes: [overlong_lead_node()])
  v.length() == 1
    && all(v, x => x.node == "overlong-lead" && x.lead_chars > roadmap_lead_budget_chars())
    && lead_budget_violations(nodes: [open_dispatch_node()]).length() == 0
}
