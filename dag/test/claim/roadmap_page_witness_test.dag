data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data dispatch_asset_status_contract_note: String = "The dispatch client consumes the belt's LABEL authority, so the discriminating assertion is total coverage of belt_dispatch_all_status_labels() in the emitted band chain — a boolean-ok wire contract cannot satisfy it, and a new belt label that the client cannot band reds here. The former blob-wide `!j.ok` negative did not scope to the dispatch handler: the separately-modeled POST /cleanup/ route legitimately answers a boolean, so scanning the whole asset for `j.ok` reported a contract violation that the dispatch path never committed."

data page_witness_unfocused_note: String = "Rendered UNFOCUSED deliberately. These claims are about ROW MARKUP, not about which lanes appear; leaving them on the focused page made them silently depend on the focus setting and go red when a lane they sampled was hidden. The served page's own focus behaviour is covered by roadmap_focus_witness_test, where it belongs."

fn authority_page_html() -> String {
  match try_serialize_html_source(node: roadmap_page_for_doc(doc: gunbc.roadmap_authority.roadmap_authority_for(focus: NoFocus))) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

data header_pin_a1_note: String = "The header assertions moved TWICE at A1 (presentation recon, operator feedback 2026-08-01). First the content: the unselected site mark (candidate A, whose aria-label said gunb.ai on a gunbc tool surface) is replaced by the text wordmark, the h1 carries the PAGE name alone so it never restates the wordmark, and both toggles are server-rendered with visible content and an accessible name — the theme toggle with its parse-time-true initial state ('theme · auto': no data-theme exists until the client program runs, so prefers-color-scheme governs, which IS auto), the sound toggle with its name only (its state has no parse-time truth; see gunbc.roadmap_page.sound_toggle_placement_note). Second the SHAPE of the assertion: the former whole-header byte pin asserted the accidental composition — element order and adjacency that nobody decided — so it redded on any reorder while proving nothing semantic. Each assertion below is now ONE claim (wordmark exists; page-name h1 exists; each control is labeled before JavaScript). Header composition is deliberately NOT pinned: the A1 list layout is a provisional renderer, per the PR's own scope statement."

test fn witness_authority_serializes_with_structure() -> Bool {
  let h = authority_page_html()
  string_contains(s: h, pattern: "<span class=\"wordmark\">gunbc</span>")
    && string_contains(s: h, pattern: "<h1>roadmap</h1>")
    && string_contains(s: h, pattern: "<button class=\"sound-toggle\" type=\"button\">sound</button>")
    && string_contains(s: h, pattern: "<button class=\"theme-toggle\" type=\"button\">theme · auto</button>")
    && !string_contains(s: h, pattern: "class=\"mark mark-d1\"")
    && !string_contains(s: h, pattern: "<h1>gunbc — roadmap</h1>")
    && string_contains(s: h, pattern: "<main class=\"roadmap\">")
    && string_contains(s: h, pattern: "class=\"roadmap-section\"")
    && string_contains(s: h, pattern: "class=\"status status-")
}

test fn witness_authority_page_preserves_multi_parent_dependencies() -> Bool {
  string_contains(
    s: authority_page_html(),
    pattern: "requires all: v1-materialization-kernel, v1-emitter-fixed-point",
  )
}

fn empty_doc_html() -> String {
  let empty = RoadmapDocument { preamble: [], lead_lanes: [], sections: [] }
  match try_serialize_html_source(node: roadmap_page(doc: empty, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_empty_doc_is_minimal_shell() -> Bool {
  let h = empty_doc_html()
  starts_with(s: h, prefix: "<html lang=\"en\"><head><meta charset=\"utf-8\"")
    && string_contains(s: h, pattern: "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"")
    && string_contains(s: h, pattern: "<title>gunbc — roadmap</title></head>")
    && string_contains(s: h, pattern: "<span class=\"wordmark\">gunbc</span>")
    && string_contains(s: h, pattern: "<h1>roadmap</h1>")
    && string_contains(s: h, pattern: "<button class=\"sound-toggle\" type=\"button\">sound</button>")
    && string_contains(s: h, pattern: "<button class=\"theme-toggle\" type=\"button\">theme · auto</button>")
    && string_contains(s: h, pattern: "<main class=\"roadmap\"></main></body></html>")
    && !string_contains(s: h, pattern: "<script")
}

test fn witness_authority_differs_from_empty() -> Bool {
  !(authority_page_html() == empty_doc_html())
}

test fn witness_authority_shows_finish_line_progress() -> Bool {
  let authority = authority_page_html()
  let empty = empty_doc_html()
  string_contains(s: authority, pattern: "class=\"finish-line-progress\"")
    && string_contains(s: authority, pattern: "v1 exit: four finish lines")
    && string_contains(s: authority, pattern: " of 4 complete")
    && string_contains(s: authority, pattern: "Compiler fixed point")
    && string_contains(s: authority, pattern: "Interpreter deleted")
    && string_contains(s: authority, pattern: "Products v1-free")
    && string_contains(s: authority, pattern: "Zero hand-maintained Rust")
    && string_contains(s: authority, pattern: "v1-products-v1-free")
    && !string_contains(s: authority, pattern: " declared · ")
    && !string_contains(s: authority, pattern: "class=\"three-gate-progress\"")
    && !string_contains(s: empty, pattern: "class=\"finish-line-progress\"")
}

data finish_line_variant_fixture_note: String = "The accepted variant is proven by FIXTURE, not by live-population absence (A1; the former !contains('finish-line-accepted') negative both redded on the stylesheet — which now legitimately carries the .finish-line-accepted rule — and was the live-state transcription class the operator ruled against: it would have reported 'a finish line was accepted', which is news, not a defect). Both reachable variants render from constructed inputs: the same spec accepted and not accepted, so the state class, the chip word, and their divergence are pinned independent of today's roadmap population."

test fn witness_finish_line_variants_render_from_fixture() -> Bool {
  let s = first(v1_exit_finish_lines()).value
  let accepted_html = match try_serialize_html_source(node: finish_line_row(spec: s, accepted_ids: [s.node])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
  let active_html = match try_serialize_html_source(node: finish_line_row(spec: s, accepted_ids: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
  string_contains(s: accepted_html, pattern: "class=\"finish-line finish-line-accepted\"")
    && string_contains(s: accepted_html, pattern: ">accepted<")
    && string_contains(s: active_html, pattern: "class=\"finish-line finish-line-active\"")
    && string_contains(s: active_html, pattern: ">active<")
    && !string_contains(s: active_html, pattern: "finish-line-accepted")
}

data daily_leads_operational_note: String = "The A1 placement wall (presentation recon, operator-signed 2026-08-01): the daily workspace's declared archetype is Operational (gunbc.design.archetype dashboard_archetype), so / may not open with the four strategic finish-line claims — it carries the one-line program-progress summary with the LOCAL denominator, and the full narrative block lives on /roadmap only. The 'of 4' magnitude is structural, not a live-population transcription: v1_exit_finish_lines is the authored four-row design list, unlike the deleted global declared/accepted/active counts this section used to show (see live_state_count_transcription_note in test.claim.roadmap_authority)."

test fn witness_daily_leads_operational_not_narrative() -> Bool {
  let h = match try_serialize_html_source(node: gunbc.roadmap_page.roadmap_daily_workspace_page_for_authority()) {
    EmitOk { html: page } => page
    EmitRejected { reason: _ } => ""
  }
  string_contains(s: h, pattern: "class=\"program-progress\"")
    && string_contains(s: h, pattern: " of 4 finish lines complete")
    && !string_contains(s: h, pattern: "class=\"finish-line-progress\"")
    && !string_contains(s: h, pattern: "class=\"finish-line-claim\"")
}

fn depth_chain_html(fuel: Int) -> String {
  let parent = gunbc.roadmap_authority.authored(identity: "rnfx_716835YJMPRW9JAC4H1Z", id: "p", done: false, content: "parent-node")
  let child = gunbc.roadmap_authority.authored(identity: "rnfx_DY971T4PDGRTPY6WDHDR", id: "c", done: false, content: "child-node-title")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  match try_serialize_html_source(node: nodes_ul(items: [parent], nodes: [parent, child], edges: [edge], merged: [], fuel: fuel)) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn bold_title_html() -> String {
  let rn = gunbc.roadmap_authority.authored(identity: "rnfx_4JKJ1ZMAYSR30YJW8T8B", id: "bold1", done: false, content: "**bold** item")
  match try_serialize_html_source(node: nodes_ul(items: [rn], nodes: [rn], edges: [], merged: [], fuel: 0)) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_bold_title_renders_strong() -> Bool {
  let h = bold_title_html()
  string_contains(s: h, pattern: "<strong>bold</strong>")
    && !string_contains(s: h, pattern: "**")
}

test fn witness_depth_cap_fails_honest() -> Bool {
  let truncated = depth_chain_html(fuel: 0)
  let expanded = depth_chain_html(fuel: 1)
  string_contains(s: truncated, pattern: "depth limit")
    && !string_contains(s: truncated, pattern: "child-node-title")
    && string_contains(s: expanded, pattern: "child-node-title")
    && !string_contains(s: expanded, pattern: "depth limit")
}

fn dispatch_doc_html_for(rn: RoadmapNode) -> String {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  match try_serialize_html_source(node: roadmap_page(doc: doc, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn dispatch_doc_html_for_with_merged(rn: RoadmapNode, merged: List<Int>) -> String {
  let sec = RoadmapSection { title: "Belt", elements: [ section_group(label: "", nodes: [rn], edges: []) ] }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  match try_serialize_html_source(node: roadmap_page(doc: doc, merged: merged)) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

