  string_contains(s: h, pattern: "class=\"workflow-controls\"")
    && string_contains(s: h, pattern: "<button class=\"dispatch-btn\"")
}

data supporting_facts_disclosure_note: String = "The A1 row-reduction wall (presentation recon, operator-signed 2026-08-01): the head row carries the row's PRIMARY facts only — status, title, state badges, the dependency line — plus the actuator; owner, sizing codes, and carrier links are SUPPORTING facts and render inside the disclosure's item-facts block. Both pins are exact-shape over a constructed fixture: a supporting fact reappearing in node-mid reds the first, the facts block dropping (rather than demoting) the fact reds the second. A row with facts but no body still discloses under the 'facts' summary label, so demotion never becomes deletion."

test fn witness_supporting_facts_live_in_disclosure_not_head() -> Bool {
  let h = dispatch_doc_html_for(rn: ready_dispatch_node())
  string_contains(s: h, pattern: "<span class=\"node-mid\"><span class=\"title\">dispatch-me</span></span>")
    && string_contains(
      s: h,
      pattern: "<details class=\"item-detail\"><summary><span class=\"disclosure-mark\">›</span>facts</summary><div class=\"item-body\"><div class=\"item-facts\"><span class=\"sizing\">i:low v:small gunbc</span></div></div></details>")
    && !string_contains(s: h, pattern: "class=\"title\">dispatch-me</span><span class=\"sizing\"")
}

fn blocked_dispatch_workspace_html() -> String {
  let policy_blocker = gunbc.roadmap_authority.authored(identity: "rnfx_ENDCMSJ7A7XTXK91KKZD", id: "disp-policy-blocker",
    done: false,
    content: "policy prerequisite")
  let model_blocker = gunbc.roadmap_authority.authored(identity: "rnfx_2R3ZJWEHE8BDYVGJ82Z9", id: "disp-model-blocker",
    done: false,
    content: "model prerequisite")
  let blocked = gunbc.roadmap_authority.authored_wi(identity: "rnfx_VRBYQ6ZVRKNMCNVXFCG6", id: "disp-blocked",
    done: false,
    content: "blocked work",
    intricacy: IntricacyLow,
    volume: VolumeSmall,
    repo: "gunbc")
  let edges = [
    RoadmapEdge { child: blocked.node, parent: policy_blocker.node },
    RoadmapEdge { child: blocked.node, parent: model_blocker.node },
  ]
  let sec = RoadmapSection {
    title: "Belt",
    elements: [ section_group(label: "", nodes: [policy_blocker, model_blocker, blocked], edges: edges) ],
  }
  let doc = RoadmapDocument { preamble: [], lead_lanes: [], sections: [sec] }
  match try_serialize_html_source(node: roadmap_daily_workspace_page(doc: doc, merged: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

test fn witness_upcoming_node_keeps_manual_out_of_order_dispatch() -> Bool {
  let h = blocked_dispatch_workspace_html()
  string_contains(s: h, pattern: "class=\"frontier-bucket frontier-upcoming\"")
