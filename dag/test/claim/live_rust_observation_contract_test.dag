module test.claim.live_rust_observation_contract


// Controls 2 through 7 of the live observation closing contract, executed HERMETICALLY against constructed observations. This file publishes no Git mock and claims no liveness: it exercises the pure fold admit_live_rust_observation, which is why it can run in the ordinary discovery corpus at no host cost.
//
// Control 1 -- observed revision equals the workflow's immutable tested SHA -- is deliberately absent here, because it is the one claim that cannot be made without the host. It lives in the wet entry, and asserting it here against a constructed observation would be the fabricated-evidence failure this whole contract exists to prevent: two constants agreeing proves nothing about any repository.
//
// Control 8 is structural rather than asserted. The fold takes its observation as a parameter and never calls the host, so nothing in this file can reach Git even by accident; only live_rust_observation_wet can, and it is not imported here.
data test_revision: std.types.CommitSha = "0123456789abcdef0123456789abcdef01234567"
data other_revision: std.types.CommitSha = "fedcba9876543210fedcba9876543210fedcba98"

fn observation_at(
  revision: std.types.CommitSha,
  tracked: List<String>,
  prior: List<String>,
  cargo: List<String>
) -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  gunbc.stage0_rust_host_observation.RustManifestObserved {
    repository_revision: revision,
    manifest_content_identity: std.content_hash.Fnv1a64Structural { digest: "c0a750000000000d" },
    tracked_rust_repo_paths: tracked,
    prior_tracked_rust_repo_paths: prior,
    cargo_bin_repo_paths: cargo,
    emit_population_evidence: gunbc.stage0_rust_host_observation.EmitPopulationConfirmed {
      emitted_stage0_repo_paths: []
    }
  }
}

fn populated_observation(revision: std.types.CommitSha) -> gunbc.stage0_rust_host_observation.RustSourceHostObservation {
  observation_at(
    revision: revision,
    tracked: ["src/v1/stage0/src/main.rs", "src/v1/stage0/src/cli_run.rs"],
    prior: ["src/v1/stage0/src/main.rs"],
    cargo: ["src/v1/stage0/src/main.rs"]
  )
}

fn request_for(revision: std.types.CommitSha) -> gunbc.live_rust_observation.LiveRustObservationRequest {
  gunbc.live_rust_observation.LiveRustObservationRequest { expected_repository_revision: revision }
}

test fn control_matching_revision_admits_with_exact_counts() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: populated_observation(revision: test_revision)
  ) {
    gunbc.live_rust_observation.LiveObservationAdmitted { receipt: receipt } =>
      receipt.observed_repository_revision == test_revision
        && receipt.expected_repository_revision == test_revision
        && receipt.tracked_path_count == 2
        && receipt.prior_path_count == 1
        && receipt.cargo_target_count == 1
    gunbc.live_rust_observation.LiveObservationRefused { cause: _ } => false
  }
}

test fn control_2_wrong_expected_sha_refuses() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: other_revision),
    observation: populated_observation(revision: test_revision)
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveRevisionMismatch { expected: expected, observed: observed } } =>
      expected == other_revision && observed == test_revision
    _ => false
  }
}

test fn control_2_absent_expectation_refuses_rather_than_passes() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: ""),
    observation: populated_observation(revision: test_revision)
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveExpectationEmpty { detail: detail } } => !(detail == "")
    _ => false
  }
}

test fn control_missing_runner_sha_is_distinct_typed_refusal() -> Bool {
  match gunbc.live_rust_observation.admit_current_actions_rust_observation(
    actions: extdeps.github.actions_environment.ActionsShaMissing { detail: "GITHUB_SHA was not set" },
    observation: populated_observation(revision: test_revision)
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveExpectationMissing { detail: detail } } =>
      detail == "GITHUB_SHA was not set"
    _ => false
  }
}

test fn control_empty_runner_sha_is_distinct_typed_refusal() -> Bool {
  match gunbc.live_rust_observation.admit_current_actions_rust_observation(
    actions: extdeps.github.actions_environment.ActionsShaEmpty { detail: "GITHUB_SHA was present but empty" },
    observation: populated_observation(revision: test_revision)
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveExpectationEmpty { detail: detail } } =>
      detail == "GITHUB_SHA was present but empty"
    _ => false
  }
}

test fn control_3_git_refusal_stays_typed_and_distinct() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: gunbc.stage0_rust_host_observation.GitObservationRefused { detail: "git rev-parse refused" }
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveGitRefused { detail: detail } } => detail == "git rev-parse refused"
    _ => false
  }
}

test fn control_4_manifest_read_refusal_stays_typed_and_distinct() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: gunbc.stage0_rust_host_observation.RustManifestReadRefused { detail: "manifest object unreadable" }
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveManifestReadRefused { detail: detail } } =>
      detail == "manifest object unreadable"
    _ => false
  }
}

test fn control_5_toml_parse_refusal_stays_typed_and_distinct() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: gunbc.stage0_rust_host_observation.RustManifestParseRefused { detail: "not valid TOML" }
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveManifestParseRefused { detail: detail } } => detail == "not valid TOML"
    _ => false
  }
}

test fn control_6_empty_tracked_population_cannot_be_success() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: observation_at(
      revision: test_revision,
      tracked: [],
      prior: ["src/v1/stage0/src/main.rs"],
      cargo: ["src/v1/stage0/src/main.rs"]
    )
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveTrackedPopulationEmpty } => true
    _ => false
  }
}

test fn control_6_empty_prior_population_cannot_be_success() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: observation_at(
      revision: test_revision,
      tracked: ["src/v1/stage0/src/main.rs"],
      prior: [],
      cargo: ["src/v1/stage0/src/main.rs"]
    )
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LivePriorPopulationEmpty } => true
    _ => false
  }
}

test fn control_6_empty_cargo_targets_cannot_be_success() -> Bool {
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: observation_at(
      revision: test_revision,
      tracked: ["src/v1/stage0/src/main.rs"],
      prior: ["src/v1/stage0/src/main.rs"],
      cargo: []
    )
  ) {
    gunbc.live_rust_observation.LiveObservationRefused { cause: gunbc.live_rust_observation.LiveCargoTargetsEmpty } => true
    _ => false
  }
}

test fn control_7_receipt_verdict_is_the_fold_of_the_same_observation() -> Bool {
  let observation = populated_observation(revision: test_revision)
  match gunbc.live_rust_observation.admit_live_rust_observation(
    request: request_for(revision: test_revision),
    observation: observation
  ) {
    gunbc.live_rust_observation.LiveObservationAdmitted { receipt: receipt } =>
      match receipt.verdict {
        gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldOk =>
          match gunbc.stage0_rust_source_lifecycle_scaffold.rust_source_manifest_state_verdict(observation: observation) {
            gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldOk => true
            gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldRefused { cause: _ } => false
          }
        gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldRefused { cause: _ } =>
          match gunbc.stage0_rust_source_lifecycle_scaffold.rust_source_manifest_state_verdict(observation: observation) {
            gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldOk => false
            gunbc.stage0_rust_source_lifecycle_scaffold.ManifestStateScaffoldRefused { cause: _ } => true
          }
      }
    gunbc.live_rust_observation.LiveObservationRefused { cause: _ } => false
  }
}
