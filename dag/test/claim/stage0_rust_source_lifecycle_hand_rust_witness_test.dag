module test.claim.stage0_rust_source_lifecycle_hand_rust_witness

import gunbc.stage0_rust_source_lifecycle_hand_rust_scaffold {
  git_tracked_rust_repo_paths_host_bridge_scaffold,
  stage0_cargo_manifest_hand_rust_test_discriminator_parse_complete,
  stage0_cargo_manifest_hand_rust_test_discriminator_path_without_spaces,
  stage0_cargo_manifest_hand_rust_test_discriminator_unparsed_bin_reds,
  stage0_cargo_manifest_host_bridge_scaffold,
  stage0_rust_lifecycle_hand_rust_census_shrink_note,
  stage0_rust_lifecycle_hand_rust_dissolve_trigger,
  stage0_rust_lifecycle_hand_rust_lane_note,
  stage0_rust_lifecycle_hand_rust_loc_delta_net,
  stage0_rust_lifecycle_hand_rust_receipt_plan_anchor,
  stage0_rust_lifecycle_hand_rust_roadmap_anchor
}
import std.disposition { Scaffold, SingleAuthority }
import v2.std.text { String }

data stage0_rust_source_lifecycle_hand_rust_witness_note: String = "HAND-Rust scaffold receipt (review 44325): Disposition rows for cargo-manifest + git-tracked census, ROADMAP.md:42 / v1_deletion_plan ^hand_queue_drain lane, measured +406 net Rust LOC delta, discriminating Rust tests."

test fn stage0_cargo_manifest_host_bridge_scaffold_is_seed_retained() -> Bool {
  match stage0_cargo_manifest_host_bridge_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn git_tracked_rust_repo_paths_host_bridge_scaffold_is_seed_retained() -> Bool {
  match git_tracked_rust_repo_paths_host_bridge_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn stage0_rust_lifecycle_hand_rust_lane_names_roadmap_row() -> Bool {
  string_contains(s: stage0_rust_lifecycle_hand_rust_lane_note, pattern: "ROADMAP.md")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_lane_note, pattern: "hand_queue_drain")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_roadmap_anchor, pattern: "ROADMAP.md:42")
}

test fn stage0_rust_lifecycle_dissolve_trigger_names_finish_line_and_lane() -> Bool {
  string_contains(s: stage0_rust_lifecycle_hand_rust_dissolve_trigger, pattern: "stage0_cargo_bin_repo_paths_from_manifest")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_dissolve_trigger, pattern: "git_tracked_rust_repo_paths")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_dissolve_trigger, pattern: "#7393")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_dissolve_trigger, pattern: "hand-maintained-Rust-to-zero")
}

test fn stage0_rust_lifecycle_hand_rust_receipt_anchor_is_checkable() -> Bool {
  string_contains(
    s: stage0_rust_lifecycle_hand_rust_receipt_plan_anchor,
    pattern: "rust_source_tracked_manifest_note"
  ) && stage0_rust_lifecycle_hand_rust_loc_delta_net == 406
}

test fn stage0_rust_lifecycle_hand_rust_census_shrink_honest() -> Bool {
  string_contains(s: stage0_rust_lifecycle_hand_rust_census_shrink_note, pattern: "+406")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_census_shrink_note, pattern: "cli_run.rs +347")
    && string_contains(s: stage0_rust_lifecycle_hand_rust_census_shrink_note, pattern: "not counted in loc_delta_net")
}

test fn stage0_rust_lifecycle_hand_rust_discriminating_tests_named() -> Bool {
  string_contains(
    s: stage0_cargo_manifest_hand_rust_test_discriminator_parse_complete,
    pattern: "parses_bin_path"
  )
    && string_contains(
      s: stage0_cargo_manifest_hand_rust_test_discriminator_unparsed_bin_reds,
      pattern: "rejects_bin_table"
    )
    && string_contains(
      s: stage0_cargo_manifest_hand_rust_test_discriminator_path_without_spaces,
      pattern: "without_spaces"
    )
}

test fn stage0_cargo_manifest_unparsed_bin_fixture_red_holds() -> Bool {
  stage0_cargo_bin_manifest_unparsed_bin_fixture_holds()
}
