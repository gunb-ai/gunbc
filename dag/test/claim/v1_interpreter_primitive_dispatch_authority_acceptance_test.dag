module test.claim.v1_interpreter_primitive_dispatch_authority_acceptance

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.v1_interpreter_primitive_surface {
  AuthoredInRoster,
  DeclaredHere,
  FreeCall,
  MethodCall,
  ServiceDispatch,
  arm_declares_dissolution_trigger,
  v1_interpreter_declared_arms,
  v1_interpreter_derived_arms,
  v1_interpreter_free_call_arms,
  v1_interpreter_roster_seed_scaffold,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data closing_contract_note: String = "THE CLOSING CHECK FOR v1-interpreter-primitive-dispatch-authority. R1 inverts the roster: gunbc.v1_interpreter_primitive_surface v1_interpreter_authored_roster_arms is the canonical authority; generated lookup in v1_interpreter_dispatch_generated.rs routes spellings to typed arm identities derived from arm identity, and the interpreter dispatch macros consult that lookup before matching handler bodies. The checks here are structural properties that survive roster growth -- not population pins.\n\nCOMPILE-TIME EXHAUSTIVENESS has no Bool half: a roster row without a handler macro arm fails cargo build via a non-exhaustive inner match on the generated enum. The positive control is a green build; the discriminating RED is documented in src/v1/stage0/tests/interpreter_dispatch_authority.rs as a roster/lookup alignment witness executed alongside this contract.\n\nWHAT MAKES THIS ABLE TO FAIL. Reverting derived rows to DerivedFromDispatch, reintroducing the interpreter_dispatch_arm_rows bridge spelling, dropping a declared residual row's dissolution trigger, or removing the generated lookup path each reds a clause."

fn roster_rows_are_authored_in_roster_not_transcribed_from_rust() -> Bool {
  count(v1_interpreter_derived_arms()) > 0
    && (v1_interpreter_derived_arms() |> all(r => r.enumeration == AuthoredInRoster))
}

fn self_reading_bridge_arm_is_deleted() -> Bool {
  !v1_interpreter_free_call_arms()
    |> any(r => r.authored_spelling == "interpreter_dispatch_arm_rows")
}

fn declared_residual_rows_retain_independent_dispositions() -> Bool {
  let expected = ["eval_method_call", "eval_service_call"]
  let actual = v1_interpreter_declared_arms() |> map(r => r.dispatch_symbol)
  count(actual |> filter(s => !expected |> any(e => e == s))) == 0
    && count(expected |> filter(e => !actual |> any(s => s == e))) == 0
    && (v1_interpreter_declared_arms() |> all(r =>
      match r.enumeration {
        DeclaredHere { dissolve_on: _ } => arm_declares_dissolution_trigger(arm: r)
        _ => false
      }))
    && (v1_interpreter_declared_arms() |> any(r => r.form == MethodCall))
    && (v1_interpreter_declared_arms() |> any(r => r.form == ServiceDispatch))
}

fn handler_body_scaffold_names_remaining_residue() -> Bool {
  let scaffold = v1_interpreter_roster_seed_scaffold()
  scaffold.target_roadmap_node == "v1-interpreter-primitive-dispatch-authority"
    && string_contains(s: scaffold.deletion_condition, pattern: "v1_interpreter_primitive_surface.dag")
    && string_contains(s: scaffold.deletion_condition, pattern: "arm identity")
}

test fn v1_interpreter_primitive_dispatch_authority_acceptance_contract_holds() -> Bool {
  roster_rows_are_authored_in_roster_not_transcribed_from_rust()
    && self_reading_bridge_arm_is_deleted()
    && declared_residual_rows_retain_independent_dispositions()
    && handler_body_scaffold_names_remaining_residue()
}
