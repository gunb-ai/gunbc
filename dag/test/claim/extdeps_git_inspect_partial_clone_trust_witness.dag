module test.claim.extdeps_git_inspect_partial_clone_trust_witness

import std.logic { Bool }
import std.types { String, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.operation_argv { operation_argv_bind_text, operation_argv_tokens_or_refusal_label, shell_materialize_operation_argv }

// WITNESS: the three partial-clone probes in extdeps.git.inspect -- ConfigGetInRepo,
// ConfigGetRegexpInRepo and IsShallowRepository -- build a `git` argv that carries the per-invocation
// trust grant as TWO SEPARATE tokens `-c` and `safe.directory=<repository_path>`, IMMEDIATELY BEFORE the
// two separate tokens `-C` and `<repository_path>` -- the same shape their already-trusted siblings
// (HeadCommitIn, ReadTreeIntoIndex, StatusAgainstIndex, IgnoredAgainstIndex, IndexFlagsIn) carry and the
// same words extdeps.git git_in_trusted_repository_args builds for the transported legs.
//
// WHY A TOKEN LIST, NOT A JOINED STRING. `git -c k=v ...` is argument-sensitive: `["git", "-c",
// "safe.directory=/repo", ...]` runs, but `["git", "-c safe.directory=/repo", ...]` (the grant merged into
// ONE token) makes git exit 129 -- it reads `-c safe.directory=/repo` as one unknown option. So the
// assertion is made on the materialized List<String> token vector against token-list goldens, never on a
// space-joined string: a join cannot tell the two apart, which would let a correct AND a broken argv pass.
// THE COMPARISON IS STRUCTURAL (== / != on List<String>).
//
// THE FOUR MUTATION TARGETS this witness must turn red. One named mutant each:
//   * the three *_carries_the_trusted_repository_grant claims each die when THAT op's grant is removed
//     (its token list then differs from the golden);
//   * the three *_is_not_the_merged_grant_token claims each die when THAT op's `-c` / `safe.directory=`
//     pair is collapsed into a single token.
// The positive claims are the grant-removal detectors; the merged-token claims are the token-boundary
// detectors. Together they cover the four mutation shapes (one grant removed per op, plus the merge).
//
// WHY THIS IS WITNESSED AT ALL. inspect.dag's header paragraph records that a flag inside a `transport
// shell` literal "cannot be called by a test"; std.operation_argv shell_materialize_operation_argv lifts the
// literal out far enough to READ the declaration that actually ships, with the operation's declared inputs
// bound by name.
//
// WHY THE PROBES NEEDED THE GRANT. Their consumer, extdeps.git partial_clone object_source_serve_admission,
// is run by repository_convergence_placement's owner leg as the service user against the runner's checkout
// (a tree another principal owns). Without the grant the read dies at git's dubious-ownership gate -- `git
// config extensions.partialClone` exits 128 -- the model reads that fail-closed and refuses operands. The
// model's refusal on 128 is correct; the defect was the argv. The grant is derived from the input path, so
// it names neither a different repository nor the wildcard, and writes nothing to any config.

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data inspect_module_path: String = "dag/extdeps/git/inspect.dag"
data inspect_service: String = "git.Inspect"

// The runner checkout srv1 tree-sync reads as a different principal; the SHAPE is asserted, not the
// location, so this fixed absolute path stands in for the host-specific one.
data probe_repo: String = "/opt/actions-runner/srv1-09/_work/gunbc/gunbc"
data partial_clone_key: String = "extensions.partialClone"
data promisor_pattern: String = "remote\\..*\\.promisor"

// THE GOLDENS. Index 1 and 2 are the grant as two tokens; indices 3 and 4 are `-C <repo>`. A grant merged
// into one token shifts everything left (one fewer element) and is structurally unequal to these.
data golden_config_get_in_repo: List<String> = ["git", "-c", "safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "config", "--local", "--get", "extensions.partialClone"]
data golden_config_get_regexp_in_repo: List<String> = ["git", "-c", "safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "config", "--local", "--get-regexp", "remote\\..*\\.promisor"]
data golden_is_shallow_repository: List<String> = ["git", "-c", "safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "rev-parse", "--is-shallow-repository"]

// THE MERGED-TOKEN MUTANTS: the same argvs with the `-c` / `safe.directory=` pair collapsed into one token
// -- the spelling that makes git exit 129. A correct declaration's token list is NEVER equal to one of
// these; each merged-token control goes red the moment its op's grant is written as a single token.
data merged_config_get_in_repo: List<String> = ["git", "-c safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "config", "--local", "--get", "extensions.partialClone"]
data merged_config_get_regexp_in_repo: List<String> = ["git", "-c safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "config", "--local", "--get-regexp", "remote\\..*\\.promisor"]
data merged_is_shallow_repository: List<String> = ["git", "-c safe.directory=/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "-C", "/opt/actions-runner/srv1-09/_work/gunbc/gunbc", "rev-parse", "--is-shallow-repository"]

// MUTATION TARGET: grant removed from ConfigGetInRepo turns the first claim red (7 tokens vs 9); the grant
// merged into one token turns the second claim red.
test fn config_get_in_repo_carries_the_trusted_repository_grant() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "ConfigGetInRepo",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo),
        operation_argv_bind_text(name: "key", text: partial_clone_key)
      ]
    )
  ) == golden_config_get_in_repo
}

test fn config_get_in_repo_is_not_the_merged_grant_token() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "ConfigGetInRepo",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo),
        operation_argv_bind_text(name: "key", text: partial_clone_key)
      ]
    )
  ) != merged_config_get_in_repo
}

// MUTATION TARGET: grant removed from ConfigGetRegexpInRepo turns the first claim red; merge turns the
// second red.
test fn config_get_regexp_in_repo_carries_the_trusted_repository_grant() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "ConfigGetRegexpInRepo",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo),
        operation_argv_bind_text(name: "pattern", text: promisor_pattern)
      ]
    )
  ) == golden_config_get_regexp_in_repo
}

test fn config_get_regexp_in_repo_is_not_the_merged_grant_token() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "ConfigGetRegexpInRepo",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo),
        operation_argv_bind_text(name: "pattern", text: promisor_pattern)
      ]
    )
  ) != merged_config_get_regexp_in_repo
}

// MUTATION TARGET: grant removed from IsShallowRepository turns the first claim red; merge turns the
// second red.
test fn is_shallow_repository_carries_the_trusted_repository_grant() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "IsShallowRepository",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo)
      ]
    )
  ) == golden_is_shallow_repository
}

test fn is_shallow_repository_is_not_the_merged_grant_token() -> Bool {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      inspect_module_path,
      inspect_service,
      "IsShallowRepository",
      [
        operation_argv_bind_text(name: "repository_path", text: probe_repo)
      ]
    )
  ) != merged_is_shallow_repository
}
