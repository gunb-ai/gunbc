data probe_fixture_module: v2.std.text.String = "test.claim.synthetic_quarantine_probe_witness"
data probe_fixture_entry: v2.std.text.String = "dag/test/claim/synthetic_quarantine_probe_witness_test.dag"
data probe_fixture_function: v2.std.text.String = "synthetic_probe_holds"

fn probe_fixture_subject() -> gunbc.quarantine_probe_disposition.QuarantineProbeSubject {
  gunbc.quarantine_probe_disposition.QuarantineProbeSubject {
    module: probe_fixture_module,
    entry: probe_fixture_entry,
    function: probe_fixture_function
  }
}

fn probe_fixture_identity() -> v2.std.text.String {
  gunbc.quarantine_probe_disposition.quarantine_probe_identity(module: probe_fixture_module, function: probe_fixture_function)
}

