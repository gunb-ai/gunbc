fn disposition_is_held_by(disposition: gunbc.quarantine_probe_disposition.QuarantineProbeDisposition, expected: gunbc.quarantine_probe_disposition.QuarantineProbeHolder) -> v2.std.logic.Bool {
  match disposition {
    gunbc.quarantine_probe_disposition.HeldByExactlyOne { identity: i, holder: h } => quarantine_probe_holder_eq(a: h, b: expected)
    gunbc.quarantine_probe_disposition.QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    gunbc.quarantine_probe_disposition.QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn quarantine_probe_holder_eq(a: gunbc.quarantine_probe_disposition.QuarantineProbeHolder, b: gunbc.quarantine_probe_disposition.QuarantineProbeHolder) -> v2.std.logic.Bool {
  match a {
    gunbc.quarantine_probe_disposition.FloorExpectedRedHeld => match b {
      gunbc.quarantine_probe_disposition.FloorExpectedRedHeld => true
      _ => false
    }
    gunbc.quarantine_probe_disposition.RouteGapHeldNoVerdict => match b {
      gunbc.quarantine_probe_disposition.RouteGapHeldNoVerdict => true
      _ => false
    }
    gunbc.quarantine_probe_disposition.NeverRunDeclinedByHomePolicy { matched_prefix: pa } => match b {
      gunbc.quarantine_probe_disposition.NeverRunDeclinedByHomePolicy { matched_prefix: pb } => pa == pb
      _ => false
    }
    gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead { entry: ea } => match b {
      gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead { entry: eb } => ea == eb
      _ => false
    }
    gunbc.quarantine_probe_disposition.NeverRunPathExcluded { matched_substring: sa } => match b {
      gunbc.quarantine_probe_disposition.NeverRunPathExcluded { matched_substring: sb } => sa == sb
      _ => false
    }
  }
}

fn disposition_is_now_passing(disposition: gunbc.quarantine_probe_disposition.QuarantineProbeDisposition) -> v2.std.logic.Bool {
  match disposition {
    gunbc.quarantine_probe_disposition.HeldByExactlyOne { identity: i, holder: h } => false
    gunbc.quarantine_probe_disposition.QuarantineProbeNowPassing { identity: i, entry: e, function: f } => i == probe_fixture_identity()
    gunbc.quarantine_probe_disposition.QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn disposition_is_held_by_more_than_one(disposition: gunbc.quarantine_probe_disposition.QuarantineProbeDisposition) -> v2.std.logic.Bool {
  match disposition {
    gunbc.quarantine_probe_disposition.HeldByExactlyOne { identity: i, holder: h } => false
    gunbc.quarantine_probe_disposition.QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    gunbc.quarantine_probe_disposition.QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => true
  }
}

fn fixture_disposition(facts: gunbc.quarantine_probe_disposition.QuarantineProbeHoldingFacts) -> gunbc.quarantine_probe_disposition.QuarantineProbeDisposition {
  gunbc.quarantine_probe_disposition.quarantine_probe_disposition(subject: probe_fixture_subject(), facts: facts)
}

// THE POSITIVE CONTROL, ONE ARM AT A TIME. Each holder in isolation derives gunbc.quarantine_probe_disposition.HeldByExactlyOne and
// carries the holder it found -- including gunbc.quarantine_probe_disposition.NeverRunPathExcluded, whose derivation is exercised here even
// though no live row inhabits it, and gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead. An arm with no live inhabitant is
// not an unexercised arm.
test fn each_holder_alone_derives_exactly_one_disposition() -> v2.std.logic.Bool {
  disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: gunbc.quarantine_probe_disposition.FloorExpectedRedHeld {})
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_route_gap()), expected: gunbc.quarantine_probe_disposition.RouteGapHeldNoVerdict {})
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_home_prefix()),
      expected: gunbc.quarantine_probe_disposition.NeverRunDeclinedByHomePolicy { matched_prefix: "test.claim.synthetic_" }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_live_tree_decline()),
      expected: gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead { entry: probe_fixture_entry }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_path_exclusion()),
      expected: gunbc.quarantine_probe_disposition.NeverRunPathExcluded { matched_substring: "test/claim/synthetic_" }
    )
}

// THE DISCRIMINATING RED, AND IT IS THE WHOLE POINT OF THE LANE. A probe no mechanism holds
// derives the ALARM and does NOT hold. There is no accepting arm for this state anywhere in the
// model, so a corpus in this condition cannot be made green by classification -- only by
// deleting the admission row or by giving it a mechanism that really holds it.
test fn a_probe_held_by_nothing_is_an_alarm_and_does_not_hold() -> v2.std.logic.Bool {
  disposition_is_now_passing(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !gunbc.quarantine_probe_disposition.quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !gunbc.quarantine_probe_disposition.quarantine_probe_dispositions_all_hold(
      subjects: std.algebra.Cons { head: probe_fixture_subject(), tail: v2.std.algebra.Empty {} },
      facts: probe_fixture_no_facts()
    )
}

// TWO MECHANISMS FOR ONE OBLIGATION REFUSES, and refusing is the ruled-correct answer rather
// than a false positive: two authorities for one fact means someone has to decide which one
// actually holds it. No live row exercises this today, so the control is what keeps the arm
// real.
test fn a_probe_held_by_two_mechanisms_refuses() -> v2.std.logic.Bool {
  disposition_is_held_by_more_than_one(disposition: fixture_disposition(facts: facts_with_two_holders()))
    && !gunbc.quarantine_probe_disposition.quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: facts_with_two_holders()))
}

// THE JOIN IS ON EXACT IDENTITY, NOT CONTAINMENT. A roster row whose name merely CONTAINS the
// probe's identity does not hold it. Without this, a rename or a near-miss would read as
// covered, which is the substring weakness the exact-admission authority was built to remove.
test fn a_roster_row_that_merely_contains_the_identity_does_not_hold_it() -> v2.std.logic.Bool {
  let near_miss = gunbc.quarantine_probe_disposition.QuarantineProbeHoldingFacts {
    expected_red_roster: std.algebra.Cons { head: concat(probe_fixture_identity(), "_extra"), tail: v2.std.algebra.Empty {} },
    route_gap_roster: v2.std.algebra.Empty {},
    home_prefixes: v2.std.algebra.Empty {},
    live_tree_declined_entries: v2.std.algebra.Empty {},
    path_exclusion_substrings: v2.std.algebra.Empty {}
  }
  disposition_is_now_passing(disposition: fixture_disposition(facts: near_miss))
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: gunbc.quarantine_probe_disposition.FloorExpectedRedHeld {})
}

// THE ANCHORED AGREEMENT POINT WITH THE PRODUCER. legacy_test_behavior_unclassified_frontier_is_zero
// is the one live row this witness classifies gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead, and the floor
// really does decline it: main run 32553487573 (sha 967b5bc1b92) reports
// `offered=11812 routed=10439 declined_long=543 declined_live=830`, and 10439 + 543 + 830 =
// 11812 exactly, so the three arms partition the offered sites and the declined population is
// real rather than inferred. Run directly, the witness FAILS (claim_batch, cpu=183ms) -- so it
// is a live red control, not a stale row, and the reading that would have deleted it was the
// destructive one. This test asserts the classification half, which is the half this fold owns;
// the run receipt above is the producer half and is prose because no .dag consumer can read a
// workflow log.
test fn the_live_tree_declined_row_is_the_one_the_floor_declines() -> v2.std.logic.Bool {
  let facts = live_quarantine_probe_facts()
  let subject = gunbc.quarantine_probe_disposition.QuarantineProbeSubject {
    module: "test.claim.legacy_test_behavior_disposition_acceptance_test",
    entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance_test.dag",
    function: "legacy_test_behavior_unclassified_frontier_is_zero"
  }
  disposition_is_held_by(
    disposition: gunbc.quarantine_probe_disposition.quarantine_probe_disposition(subject: subject, facts: facts),
    expected: gunbc.quarantine_probe_disposition.NeverRunDeclinedByLiveTreeRead {
      entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance_test.dag"
    }
  )
}

// THE LIVE-TREE DERIVATION IS DISCRIMINATING, not a predicate that answers the same way for
// everything: the entry that declares ReadsLiveTree reads true, and a sibling admission entry
// that does not declare it reads false. Both are live files, so this control also fails if the
// read itself stops working.
test fn the_live_tree_declaration_read_discriminates() -> v2.std.logic.Bool {
