fn facts_with_two_holders() -> gunbc.quarantine_probe_disposition.QuarantineProbeHoldingFacts {
  gunbc.quarantine_probe_disposition.QuarantineProbeHoldingFacts {
    expected_red_roster: std.algebra.Cons { head: probe_fixture_identity(), tail: v2.std.algebra.Empty {} },
    route_gap_roster: std.algebra.Cons { head: probe_fixture_identity(), tail: v2.std.algebra.Empty {} },
    home_prefixes: v2.std.algebra.Empty {},
    live_tree_declined_entries: v2.std.algebra.Empty {},
    path_exclusion_substrings: v2.std.algebra.Empty {}
  }
