  let f = live_quarantine_probe_facts()
  gunbc.quarantine_probe_disposition.QuarantineProbeHoldingFacts {
    expected_red_roster: f.expected_red_roster,
    route_gap_roster: f.route_gap_roster,
    home_prefixes: f.home_prefixes,
    live_tree_declined_entries: probe_no_strings(),
