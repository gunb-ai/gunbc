// THE LIVE JOIN plus its discriminating controls. The model is in
// gunbc.quarantine_probe_disposition; this file supplies the three live populations from the
// authorities that own them and asserts that every live quarantine probe derives EXACTLY ONE
// holding disposition.
//
// NO `live_tree_disposition` DECLARATION HERE, AND THAT IS DELIBERATE RATHER THAN AN OMISSION.
// This witness reads the live tree (the module-declaration index and a declaration control), so
// declaring SubstrateInputsOnly would be false. Undeclared remains the fail-closed affected-set
// selection position; the required floor now executes it and lets the interpreter classify the
// actual effects.
data quarantine_probe_disposition_witness_note: String = "Live claim plus controls for the total quarantine-probe disposition join. THE LIVE CLAIM IS DELIBERATELY NOT WHERE THE DISCRIMINATION LIVES: it is a universal over the live admission rows, so it stays meaningful at any population size including zero, and it would pass vacuously on an empty roster. The discrimination is carried by the synthetic controls below, which are authored here and cannot lose their subject when a live quarantine dissolves -- each of the five holder arms is shown to derive HeldByExactlyOne on its own, held-by-nothing is shown to derive the alarm, and held-by-two is shown to refuse. The controls therefore prove the fold DISCRIMINATES rather than merely agreeing with today's tree."

fn witness_pool_roots() -> List<String> {
  ["dag", "src/v2"]
}

// THE ENTRY-PATH -> AUTHORED-MODULE JOIN, from the same declaration the floor reads.
//
// A path-shaped guess is NOT available here and the corpus proves it: the admission entry
// src/v2/test/claim/manual/english_emit_add_test.dag declares module v2.test.manual.english_emit_add,
// dropping a segment and a suffix, and dag/test/claim/self_host_03_normalize_behavioral_witness_test.dag
// declares test.claim.self_host_03_normalize_behavioral_witness. Deriving the identity from the
// path would silently miss the roster this fold joins against, and a miss reads as an alarm.
fn module_for_entry(facts: List<ModuleDeclarationFact>, entry: String) -> String {
  fold_list(
    xs: facts,
    empty: "",
    cons: fn(acc, fact) { if fact.path == entry { fact.module } else { acc } }
  )
}

// `LiveTreeDisposition` still owns affected-set selection eligibility after the required-floor
// decline is deleted. This scan exercises that surviving declaration question only; it does not
// predict whether the interpreter can execute the witness hermetically.
fn entry_declares_reads_live_tree_for_selection(entry: String) -> Bool {
  let source = filesystem_read(path: entry).content
  source.contains("LiveTreeDisposition") && source.contains("ReadsLiveTree")
}

fn subject_for_admission(
  facts: List<ModuleDeclarationFact>,
  row: ExplicitWitnessAdmission
) -> QuarantineProbeSubject {
  QuarantineProbeSubject {
    module: module_for_entry(facts: facts, entry: row.witness.entry),
    entry: row.witness.entry,
    function: row.witness.function
  }
}

fn live_quarantine_probe_subjects() -> List<QuarantineProbeSubject> {
  let facts = module_declaration_facts_live(pool_roots: witness_pool_roots())
  fold_list(
    xs: quarantine_probe_admissions(rows: explicit_witness_admissions),
    empty: Empty {},
    cons: fn(acc, row) { Cons { head: subject_for_admission(facts: facts, row: row), tail: acc } }
  )
}

// Declaring ReadsLiveTree still controls affected-set eligibility, but no longer declines
// execution at the required-floor root. This holder population therefore has no live rows.
fn live_quarantine_probe_facts() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: floor_expected_red_roster(),
    route_gap_roster: floor_route_gap_roster(),
    home_prefixes: long_home_prefixes(),
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

// THE LIVE CLAIM. Every QuarantineProbeExpectRed admission derives exactly one holder.
//
// PATH EXCLUSIONS ARE PASSED EMPTY, and the two facts that makes true are different. The arm's
// live inhabitant count is measured ZERO at 967b5bc1b92; its inhabitant count IN PRODUCTION is
// UNMEASURED, because the floor's exclusion list is a Rust literal that no .dag caller can read
// -- and cannot become one, since that list decides which modules enter the prepared subject
// and so cannot be evaluated from inside it. Mirroring the literal here would be a second
// representation that drifts silently. Unmeasured and zero are different states, and this guard
// exists to refuse exactly that conflation, so it does not commit it in its own witness.
test fn every_quarantine_probe_derives_exactly_one_disposition() -> Bool {
  quarantine_probe_dispositions_all_hold(
    subjects: live_quarantine_probe_subjects(),
    facts: live_quarantine_probe_facts()
  )
}

// THE LIVE CLAIM IS NOT VACUOUS, PROVEN BY MUTATION RATHER THAN ASSERTED. Each of the three
// supplied live populations is dropped in turn and the live claim must go RED, then the unmutated
// fold must go green. Without this, a fold that answered "held" for everything -- or a join that
// silently matched nothing -- would pass the live claim exactly as it does now. Measured on
// 967b5bc1b92: dropping the expected-red roster unholds 5 probes, the route-gap roster 6, the
// home prefixes 7. The live-tree and path-exclusion axes are not mutated here because the
// required floor no longer has a live-tree decline and neither arm holds a live row.
test fn every_supplied_population_is_load_bearing_on_the_live_claim() -> Bool {
  let subjects = live_quarantine_probe_subjects()
  !quarantine_probe_dispositions_all_hold(subjects: subjects, facts: live_facts_without_expected_red())
    && !quarantine_probe_dispositions_all_hold(subjects: subjects, facts: live_facts_without_route_gap())
    && !quarantine_probe_dispositions_all_hold(subjects: subjects, facts: live_facts_without_home_prefixes())
    && quarantine_probe_dispositions_all_hold(subjects: subjects, facts: live_quarantine_probe_facts())
}

fn probe_no_strings() -> List<String> {
  Empty {}
}

fn live_facts_without_expected_red() -> QuarantineProbeHoldingFacts {
  let f = live_quarantine_probe_facts()
  QuarantineProbeHoldingFacts {
    expected_red_roster: probe_no_strings(),
    route_gap_roster: f.route_gap_roster,
    home_prefixes: f.home_prefixes,
    live_tree_declined_entries: f.live_tree_declined_entries,
    path_exclusion_substrings: f.path_exclusion_substrings
  }
}

fn live_facts_without_route_gap() -> QuarantineProbeHoldingFacts {
  let f = live_quarantine_probe_facts()
  QuarantineProbeHoldingFacts {
    expected_red_roster: f.expected_red_roster,
    route_gap_roster: probe_no_strings(),
    home_prefixes: f.home_prefixes,
    live_tree_declined_entries: f.live_tree_declined_entries,
    path_exclusion_substrings: f.path_exclusion_substrings
  }
}

fn live_facts_without_home_prefixes() -> QuarantineProbeHoldingFacts {
  let f = live_quarantine_probe_facts()
  QuarantineProbeHoldingFacts {
    expected_red_roster: f.expected_red_roster,
    route_gap_roster: f.route_gap_roster,
    home_prefixes: probe_no_strings(),
    live_tree_declined_entries: f.live_tree_declined_entries,
    path_exclusion_substrings: f.path_exclusion_substrings
  }
}

data probe_fixture_module: String = "test.claim.synthetic_quarantine_probe_witness"
data probe_fixture_entry: String = "dag/test/claim/synthetic_quarantine_probe_witness_test.dag"
data probe_fixture_function: String = "synthetic_probe_holds"

fn probe_fixture_subject() -> QuarantineProbeSubject {
  QuarantineProbeSubject {
    module: probe_fixture_module,
    entry: probe_fixture_entry,
    function: probe_fixture_function
  }
}

fn probe_fixture_identity() -> String {
  quarantine_probe_identity(module: probe_fixture_module, function: probe_fixture_function)
}

fn probe_fixture_no_facts() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

fn facts_with_expected_red() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

fn facts_with_route_gap() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

fn facts_with_home_prefix() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Cons { head: "test.claim.synthetic_", tail: Empty {} },
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

fn facts_with_live_tree_decline() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Cons { head: probe_fixture_entry, tail: Empty {} },
    path_exclusion_substrings: Empty {}
  }
}

fn facts_with_path_exclusion() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Cons { head: "test/claim/synthetic_", tail: Empty {} }
  }
}

fn facts_with_two_holders() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    route_gap_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
}

fn disposition_is_held_by(disposition: QuarantineProbeDisposition, expected: QuarantineProbeHolder) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => quarantine_probe_holder_eq(a: h, b: expected)
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn quarantine_probe_holder_eq(a: QuarantineProbeHolder, b: QuarantineProbeHolder) -> Bool {
  match a {
    FloorExpectedRedHeld => match b {
      FloorExpectedRedHeld => true
      _ => false
    }
    RouteGapHeldNoVerdict => match b {
      RouteGapHeldNoVerdict => true
      _ => false
    }
    NeverRunDeclinedByHomePolicy { matched_prefix: pa } => match b {
      NeverRunDeclinedByHomePolicy { matched_prefix: pb } => pa == pb
      _ => false
    }
    NeverRunDeclinedByLiveTreeRead { entry: ea } => match b {
      NeverRunDeclinedByLiveTreeRead { entry: eb } => ea == eb
      _ => false
    }
    NeverRunPathExcluded { matched_substring: sa } => match b {
      NeverRunPathExcluded { matched_substring: sb } => sa == sb
      _ => false
    }
  }
}

fn disposition_is_now_passing(disposition: QuarantineProbeDisposition) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => false
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => i == probe_fixture_identity()
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn disposition_is_held_by_more_than_one(disposition: QuarantineProbeDisposition) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => false
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => true
  }
}

fn fixture_disposition(facts: QuarantineProbeHoldingFacts) -> QuarantineProbeDisposition {
  quarantine_probe_disposition(subject: probe_fixture_subject(), facts: facts)
}

// THE POSITIVE CONTROL, ONE ARM AT A TIME. Each holder in isolation derives HeldByExactlyOne and
// carries the holder it found -- including NeverRunPathExcluded, whose derivation is exercised here even
// though no live row inhabits it, and NeverRunDeclinedByLiveTreeRead. An arm with no live inhabitant is
// not an unexercised arm.
test fn each_holder_alone_derives_exactly_one_disposition() -> Bool {
  disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: FloorExpectedRedHeld {})
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_route_gap()), expected: RouteGapHeldNoVerdict {})
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_home_prefix()),
      expected: NeverRunDeclinedByHomePolicy { matched_prefix: "test.claim.synthetic_" }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_live_tree_decline()),
      expected: NeverRunDeclinedByLiveTreeRead { entry: probe_fixture_entry }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_path_exclusion()),
      expected: NeverRunPathExcluded { matched_substring: "test/claim/synthetic_" }
    )
}

// THE DISCRIMINATING RED, AND IT IS THE WHOLE POINT OF THE LANE. A probe no mechanism holds
// derives the ALARM and does NOT hold. There is no accepting arm for this state anywhere in the
// model, so a corpus in this condition cannot be made green by classification -- only by
// deleting the admission row or by giving it a mechanism that really holds it.
test fn a_probe_held_by_nothing_is_an_alarm_and_does_not_hold() -> Bool {
  disposition_is_now_passing(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !quarantine_probe_dispositions_all_hold(
      subjects: Cons { head: probe_fixture_subject(), tail: Empty {} },
      facts: probe_fixture_no_facts()
    )
}

// TWO MECHANISMS FOR ONE OBLIGATION REFUSES, and refusing is the ruled-correct answer rather
// than a false positive: two authorities for one fact means someone has to decide which one
// actually holds it. No live row exercises this today, so the control is what keeps the arm
// real.
test fn a_probe_held_by_two_mechanisms_refuses() -> Bool {
  disposition_is_held_by_more_than_one(disposition: fixture_disposition(facts: facts_with_two_holders()))
    && !quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: facts_with_two_holders()))
}

// THE JOIN IS ON EXACT IDENTITY, NOT CONTAINMENT. A roster row whose name merely CONTAINS the
// probe's identity does not hold it. Without this, a rename or a near-miss would read as
// covered, which is the substring weakness the exact-admission authority was built to remove.
test fn a_roster_row_that_merely_contains_the_identity_does_not_hold_it() -> Bool {
  let near_miss = QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: concat(probe_fixture_identity(), "_extra"), tail: Empty {} },
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {}
  }
  disposition_is_now_passing(disposition: fixture_disposition(facts: near_miss))
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: FloorExpectedRedHeld {})
}

// The former live-tree specimen now executes and is held by its observed expected-red verdict.
// Keeping an assertion that it is never routed would restate the deleted floor policy.
test fn the_former_live_tree_declined_row_is_now_expected_red() -> Bool {
  let facts = live_quarantine_probe_facts()
  let subject = QuarantineProbeSubject {
    module: "test.claim.legacy_test_behavior_disposition_acceptance_test",
    entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance_test.dag",
    function: "legacy_test_behavior_unclassified_frontier_is_zero"
  }
  disposition_is_held_by(
    disposition: quarantine_probe_disposition(subject: subject, facts: facts),
    expected: FloorExpectedRedHeld {}
  )
}

// THE LIVE-TREE DERIVATION IS DISCRIMINATING, not a predicate that answers the same way for
// everything: the entry that declares ReadsLiveTree reads true, and a sibling admission entry
// that does not declare it reads false. Both are live files, so this control also fails if the
// read itself stops working.
test fn the_live_tree_declaration_read_discriminates() -> Bool {
  entry_declares_reads_live_tree_for_selection(entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance_test.dag")
    && !entry_declares_reads_live_tree_for_selection(entry: "dag/test/claim/method_arg_declared_contract_witness_test.dag")
}
