module test.claim.generic_slot_substitution_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_rows_of_class,
  census_total_count
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// A GENERIC BOUND TO AN APPLICATION IS STILL SUBSTITUTED BY A LATER BINDING. substitute_generics replaces a
// typed slot (a Map or one-child collection position) with the bound application inside a slot; the
// slot is a container, so a later binding (A -> Int) reaches the application's argument (Box<A> -> Box<Int>).
// A bare argument position (a user generic's argument) takes the bound type itself. Each arm is a producer
// control: the accepted arm fails if the argument is left unsubstituted, the refused arm fails if the
// application is dropped. gunbc.recurring_failure_mode an_untyped_empty_map_fold_seed_is_emitted_with_a_bare_alias_head.
fn refusal_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch"))
      + census_total_count(rows: census_rows_of_class(rows: rows, wanted: "DeclaredTypeNotInhabited"))
      + census_total_count(rows: census_rows_of_class(rows: rows, wanted: "InternalError"))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data slot_bound_application_source: String = "module probe_slot_bound_application\nimport std.types { Int, Bool }\nimport std.algebra { empty_map, map_insert }\ntype Box<T> { v: T }\nfn wrap<A>(a: A) -> Map<String, Box<A>> { map_insert(empty_map(), \"k\", Box { v: a }) }\nfn take(m: Map<String, Box<Int>>) -> Int { 0 }\nfn p() -> Int { take(m: wrap(a: 1)) }\n"

test fn w_slot_bound_application_takes_the_later_binding() -> Bool {
  refusal_count(source: slot_bound_application_source) == 0
}

data slot_bound_application_mismatch_source: String = "module probe_slot_bound_application_bad\nimport std.types { Int, Bool }\nimport std.algebra { empty_map, map_insert }\ntype Box<T> { v: T }\nfn wrap<A>(a: A) -> Map<String, Box<A>> { map_insert(empty_map(), \"k\", Box { v: a }) }\nfn take(m: Map<String, Box<Bool>>) -> Int { 0 }\nfn p() -> Int { take(m: wrap(a: 1)) }\n"

test fn w_slot_bound_application_keeps_its_argument_and_refuses_a_mismatch() -> Bool {
  refusal_count(source: slot_bound_application_mismatch_source) >= 1
}

data bare_argument_source: String = "module probe_bare_argument\nimport std.types { Int, Bool }\ntype Box<T> { v: T }\nfn wrap<A>(a: A) -> Box<A> { Box { v: a } }\nfn take(b: Box<Int>) -> Int { 0 }\nfn p() -> Int { take(b: wrap(a: 1)) }\n"

test fn w_bare_argument_is_substituted_without_a_slot() -> Bool {
  refusal_count(source: bare_argument_source) == 0
}

data list_slot_source: String = "module probe_list_slot\nimport std.types { Int, Bool }\ntype Box<T> { v: T }\nfn wrap<A>(a: A) -> List<Box<A>> { [Box { v: a }] }\nfn take(m: List<Box<Int>>) -> Int { 0 }\nfn p() -> Int { take(m: wrap(a: 1)) }\n"

test fn w_list_slot_takes_the_later_binding() -> Bool {
  refusal_count(source: list_slot_source) == 0
}
