module test.claim.workspace_commissioning_plan_credential_witness

import std.types { Bool, String, NonEmptyStr, CommitSha }
import std.measure { hardware_thread_count, byte_size }
import gunbc.runner.runner_slot_allocation { workspace_execution_slot_identities }
import gunbc.runner.runner_microvm_slot_unit { microvm_controller_root }
import gunbc.live_deploy.release_locus { release_locus_dir, RevisionBoundAtEmission }
import gunbc.workspace_commissioning_transaction { WorkspaceCommissioningProvenance }
import gunbc.workspace_commissioning_executor_plan { workspace_executor_credential_row, workspace_executor_plan_credential }
import gunbc.workspace_commissioning_directive { workspace_commissioning_directive_from_text, WorkspaceCommissioningDirectiveReady, WorkspaceCommissioningDirectiveRefused }
import gunbc.workspace_commissioning_fleet {
  workspace_commissioning_basis_from_privileged, WorkspaceCommissioningFleetObservation,
  WorkspaceCommissioningFleetObserved, WorkspaceCommissioningFleetDependencyObserved, WorkspaceCommissioningFleetRefused,
}
import gunbc.fleet.fleet_converge_plan { WorkspaceSlotCommissioningConverge, fleet_converge_plan_artifact_of_request }

// SUPPLIED AT THE BOUNDARY: the privileged observer's response text. The basis is not built here;
// it is decoded by the production adapter decode (workspace_commissioning_basis_from_privileged),
// the only route a basis has into the plan. The installed observer itself runs on srv1.
data witness_revision: String = "0123456789abcdef0123456789abcdef01234567"

fn witness_provenance() -> WorkspaceCommissioningProvenance? {
  match filter(workspace_execution_slot_identities(), slot => (slot.host as String) == "srv1").first() {
    Absent => none
    Present { value: slot } => Present { value: WorkspaceCommissioningProvenance {
      slot: slot,
      plan_hash: "witness-plan-hash",
      source_revision: witness_revision as NonEmptyStr,
      installed_tree_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      controller_digest: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      guest_image_digest: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      cpu_budget: hardware_thread_count(count: 2),
      attempt_envelope: byte_size(count: 1073741824),
      no_swap: true,
      sanitation_observation: "witness-sanitation",
    } }
  }
}

fn witness_privileged_basis(provenance: WorkspaceCommissioningProvenance) -> WorkspaceCommissioningFleetObservation {
  let installed = release_locus_dir(root: microvm_controller_root, revision: RevisionBoundAtEmission { revision: witness_revision as CommitSha })
  workspace_commissioning_basis_from_privileged(
    text: join([workspace_executor_credential_row(provenance: provenance),
      concat("commissioning-release:", installed),
      "commissioning-prestate:witness-prestate",
      "commissioning-already-committed:false"], "\n"),
    host: "srv1",
    revision: witness_revision as CommitSha,
  )
}

// The executor admits a plan body only with exactly one credential row, so a plan that renders the
// row twice is a plan its own executor refuses. The credential it reads must decode back to the
// provenance the observer reported.
test fn the_commissioning_plan_carries_one_credential_its_executor_reads() -> Bool {
  match witness_provenance() {
    Absent => false
    Present { value: provenance } => match witness_privileged_basis(provenance: provenance) {
      WorkspaceCommissioningFleetObserved { basis } =>
        match fleet_converge_plan_artifact_of_request(request: WorkspaceSlotCommissioningConverge { basis: basis }, prior_generation: 20) {
          Absent => false
          Present { value: artifact } => count(filter(split(s: artifact.plan_body, delimiter: "\n"),
              line => line == workspace_executor_credential_row(provenance: provenance))) == 1
            && (match workspace_executor_plan_credential(plan_body: artifact.plan_body) {
              Present { value: credential } => match workspace_commissioning_directive_from_text(text: credential) {
                WorkspaceCommissioningDirectiveReady { provenance: read } => read == provenance
                WorkspaceCommissioningDirectiveRefused { reason: _ } => false
              }
              Absent => false
            })
        }
      WorkspaceCommissioningFleetDependencyObserved { plan: _ } => false
      WorkspaceCommissioningFleetRefused { reason: _ } => false
    }
  }
}
