module test.claim.guarantee_floor_parse_if_block_witness

// COMPLETENESS WITNESS for roadmap node floor-parse-formation-wall (rn_VNYPK344GM56QEWP34G7VCG4OA).
// The measured false refusal (recurring_failure_mode row guarantee.seed_checklist.parse_formation_silent):
// a block after a bare uppercase identifier in if-condition position refused with a parse error
// ("expected RParen, found Colon" family) -- parse_ident_expr routed uppercase+'{' into
// parse_record_literal unconditionally, so `if x == Upper { ... }` ate the branch brace.
// The wall marks if-condition position (ParseContext.no_record_brace, set by parse_if) and, only
// under the mark, the record-literal parse is ATTEMPTED and falls back to the plain variable when
// the attempt refuses. A legitimate record literal in the same position keeps its own brace group.
//
// CENSIS DISCIPLINE (learned by measurement, not assumed): blocking_class_census rows count every
// BLOCKING diagnostic of the pipeline -- an undefined name inflates the count with a resolution
// finding and disguises a formation result. Every fixture below is a FULLY DECLARED program: it
// compiles to ZERO blocking rows on the fixed compiler (measured first in the probe slot), so the
// only thing that can move a count is formation.

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
}
import gunbc.compile_census_probe { blocking_class_census, census_verdict, census_verdict_all, CensusVerdict }
import std.types { String }
import std.process { ProcessExit }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn blocking_verdict(source: String, wanted: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_verdict(census: blocking_class_census(source: source, wanted_class: wanted), holds: holds)
}

// PASS SHAPE (the false refusal, now closed): the condition ends in the declared uppercase constant
// BrandNominal and the branch block follows immediately. On the unfixed compiler the primary parse
// eats `{ 1 }` as a record literal and the program refuses; with the wall the attempt (field-less
// brace group) refuses, the fallback yields the plain variable, and the whole program compiles
// clean -- zero blocking rows.
data if_block_after_upper_condition_source: String =
  "module fixture.if_block_after_upper_condition\nfn call_with(d: Int, n: Int) -> Int { d }\ndata BrandNominal: Int = 1\nfn classify(x: Int) -> Int {\n  if x == BrandNominal { call_with(d: 1, n: 2) } else { 0 }\n}\n"

// NAMED NEGATIVE: a record literal in ordinary expression position keeps its formation refusal.
// The mark is set by parse_if ONLY; expression-position record parsing is untouched by this wall,
// so a brace group without field spelling in expression position still refuses. Same bytes on
// both sides; must hold on both (the wall cannot have widened the grammar).
data malformed_record_expression_position_source: String =
  "module fixture.malformed_record_expression_position\ntype Shape\n  = Rect { label: Int }\nfn probe(p: Shape) -> Int {\n  let y = Rect { label 1 }\n  y\n}\n"

// A LEGITIMATE record literal in if-condition position parses AS THE RECORD LITERAL IT IS: the
// attempt succeeds (field spelling `label: 1`), no fallback, and the program still compiles clean.
// The record literal KEEPS the brace group it legitimately owns -- the branch block is a second,
// separate brace group. Control leg: holds on both compilers.
data record_literal_in_condition_position_source: String =
  "module fixture.record_literal_in_condition_position\ntype Shape\n  = Rect { label: Int }\nfn probe(p: Shape) -> Int {\n  if p == Rect { label: 1 } { 2 } else { 0 }\n}\n"

// VERBATIM carrier input (the measured false refusal): condition ends in the declared uppercase
// constant; the block body is a lowercase call, so the record attempt must refuse and the fallback
// must yield the block. The surrounding declarations make it a complete program: zero blocking rows
// on the fixed compiler is the closed-defect observation.
data measured_carrier_if_block_input_source: String =
  "module fixture.measured_carrier_if_block_input\ndata BrandNominalDistinctDeclarations: Int = 1\nfn record_lit_union_name_is_not_an_arm(d: Int, n: Int) -> Int { d }\nfn union_arm_gate(d: Int, n: Int, brand_verdict: Int) -> Int {\n  if brand_verdict == BrandNominalDistinctDeclarations { record_lit_union_name_is_not_an_arm(d, n) } else { 0 }\n}\n"

// LEG 1 (decider for the completeness slice): the false refusal is closed -- the block parses and
// the declared program compiles with zero blocking rows.
test fn if_block_after_bare_upper_identifier_parses_as_block() -> ProcessExit {
  census_verdict_all([
    blocking_verdict(source: if_block_after_upper_condition_source, wanted: "ParseError", holds: fn(n) { n == 0 })
  ])
}

// LEG 2 (named negative): expression-position record refusal untouched -- at least one blocking row.
test fn malformed_record_in_expression_position_still_refuses() -> ProcessExit {
  census_verdict_all([
    blocking_verdict(source: malformed_record_expression_position_source, wanted: "ParseError", holds: fn(n) { n >= 1 })
  ])
}

// LEG 3 (control): legitimate record formation compiles clean on both compilers.
test fn record_literal_in_condition_position_still_parses_as_record() -> ProcessExit {
  census_verdict_all([
    blocking_verdict(source: record_literal_in_condition_position_source, wanted: "ParseError", holds: fn(n) { n == 0 })
  ])
}

// LEG 4: the verbatim carrier input, the measured false refusal, compiles clean on the fixed compiler.
test fn measured_carrier_if_block_input_parses_clean() -> ProcessExit {
  census_verdict_all([
    blocking_verdict(source: measured_carrier_if_block_input_source, wanted: "ParseError", holds: fn(n) { n == 0 })
  ])
}
