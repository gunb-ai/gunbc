module test.claim.namespace_unique_on_chain_policy_hand_rust_witness_test

import std.disposition { Scaffold, SingleAuthority }
import test.retirement.model { TestModuleRetirement, RetainedNonMigratable }
import test.retirement.namespace_unique_on_chain_policy_retained {
  namespace_unique_on_chain_policy_retention,
}
import gunbc.namespace_unique_on_chain_policy_scaffold {
  namespace_unique_on_chain_policy_hand_rust_scaffold,
  namespace_unique_on_chain_policy_hand_rust_dissolve_trigger,
  namespace_unique_on_chain_policy_hand_rust_receipt_plan_anchor,
  namespace_unique_on_chain_policy_hand_rust_loc_before,
  namespace_unique_on_chain_policy_hand_rust_loc_after,
  namespace_unique_on_chain_policy_containment_census_test_discriminator,
  namespace_unique_on_chain_policy_zero_on_chain_test_discriminator,
  namespace_unique_on_chain_policy_single_off_chain_test_discriminator,
  namespace_unique_on_chain_policy_loc_delta_net,
  namespace_unique_on_chain_policy_cli_run_hand_rust_loc_delta_net,
  namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
  namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_loc_delta_net,
  namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_census_note,
  namespace_unique_on_chain_policy_merge_repair_hand_rust_loc_delta_net,
  namespace_unique_on_chain_policy_merge_repair_hand_rust_census_note,
}

test fn namespace_unique_on_chain_policy_cli_run_growth_is_censused() -> Bool {
  namespace_unique_on_chain_policy_cli_run_hand_rust_loc_delta_net > 0 &&
    string_contains(
      s: namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
      pattern: "cli_run.rs",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
      pattern: "DISSOLVE-ON",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
      pattern: "namespace-canonical-binding",
    )
}

test fn namespace_unique_on_chain_policy_parsed_dag_file_growth_is_censused() -> Bool {
  namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_loc_delta_net > 0 &&
    string_contains(
      s: namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_census_note,
      pattern: "parsed_dag_file.rs",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_census_note,
      pattern: "DISSOLVE-ON",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_census_note,
      pattern: "namespace-canonical-binding",
    )
}

test fn namespace_unique_on_chain_policy_hand_rust_total_is_the_sum_of_its_rows() -> Bool {
  (((namespace_unique_on_chain_policy_loc_delta_net +
    namespace_unique_on_chain_policy_cli_run_hand_rust_loc_delta_net) +
    namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_loc_delta_net) +
    namespace_unique_on_chain_policy_merge_repair_hand_rust_loc_delta_net) == 205 &&
    string_contains(
      s: namespace_unique_on_chain_policy_parsed_dag_file_hand_rust_census_note,
      pattern: "= +205",
    )
}

test fn namespace_unique_on_chain_policy_merge_repair_growth_is_censused() -> Bool {
  namespace_unique_on_chain_policy_merge_repair_hand_rust_loc_delta_net == 4 &&
    string_contains(
      s: namespace_unique_on_chain_policy_merge_repair_hand_rust_census_note,
      pattern: "+4 lines",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_merge_repair_hand_rust_census_note,
      pattern: "typecheck_module",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_merge_repair_hand_rust_census_note,
      pattern: "DISSOLVE-ON:",
    )
}

test fn namespace_unique_on_chain_policy_retention_defers_to_one_census_authority() -> Bool {
  match namespace_unique_on_chain_policy_retention.disposition {
    RetainedNonMigratable { reason: reason } =>
      !string_contains(s: reason, pattern: "net=+") &&
        !string_contains(s: reason, pattern: "after=") &&
        string_contains(s: reason, pattern: "ONE LOC census authority")
    _ => false
  }
}

test fn namespace_unique_on_chain_policy_cli_run_carries_no_stale_absolutes() -> Bool {
  !string_contains(
    s: namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
    pattern: "goes 32513",
  ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_cli_run_hand_rust_census_note,
      pattern: "ONLY as a delta",
    )
}

test fn namespace_unique_on_chain_policy_hand_rust_scaffold_is_seed_retained() -> Bool {
  match namespace_unique_on_chain_policy_hand_rust_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn namespace_unique_on_chain_policy_hand_rust_dissolve_trigger_names_lane() -> Bool {
  string_contains(
    s: namespace_unique_on_chain_policy_hand_rust_dissolve_trigger,
    pattern: "namespace-canonical-binding",
  ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_hand_rust_dissolve_trigger,
      pattern: "NameResolutionPolicy",
    )
}

test fn namespace_unique_on_chain_policy_hand_rust_receipt_plan_anchor_is_checkable() -> Bool {
  string_contains(
    s: namespace_unique_on_chain_policy_hand_rust_receipt_plan_anchor,
    pattern: "gunbc.roadmap_authority",
  ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_hand_rust_receipt_plan_anchor,
      pattern: "namespace-canonical-binding",
    ) &&
    namespace_unique_on_chain_policy_hand_rust_loc_before > 0 &&
    namespace_unique_on_chain_policy_hand_rust_loc_after >
      namespace_unique_on_chain_policy_hand_rust_loc_before &&
    namespace_unique_on_chain_policy_loc_delta_net ==
      (namespace_unique_on_chain_policy_hand_rust_loc_after -
        namespace_unique_on_chain_policy_hand_rust_loc_before)
}

test fn namespace_unique_on_chain_policy_discriminating_tests_named() -> Bool {
  string_contains(
    s: namespace_unique_on_chain_policy_containment_census_test_discriminator,
    pattern: "containment_census",
  ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_zero_on_chain_test_discriminator,
      pattern: "zero_on_chain",
    ) &&
    string_contains(
      s: namespace_unique_on_chain_policy_single_off_chain_test_discriminator,
      pattern: "single_off_chain",
    )
}
