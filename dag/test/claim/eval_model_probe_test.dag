module test.claim.eval_model_probe

import extdeps.shell
import extdeps.filesystem.filesystem_io
import std.logic { Bool }
import std.types { Int }

test fn let_is_eager_when_unused() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let file_exists_before = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  let removed = shell.Remove.RecursiveForce(path: dir.path)
  let file_exists_after = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  dir.success && marker_file.success
    && file_exists_before.is_file
    && !file_exists_after.is_file
}

test fn let_is_eager_when_consumed() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let removed = shell.Remove.RecursiveForce(path: dir.path)
  let file_exists = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  dir.success && marker_file.success && removed.success && !file_exists.is_file
}

// THE POLARITY OF THE NEXT TWO FUNCTIONS WAS RE-DERIVED FROM A NEW MEASUREMENT, NOT EDITED TO STAY
// GREEN. Before std.operator_realization operand_demand existed, both asserted that the marker was
// GONE -- a claim that `&&` demanded its right operand under a false left, which is what the
// interpreter then did and what the emitted Rust never did (gunbc.recurring_failure_mode
// realization_arms_diverge_on_whether_the_program_refuses). The row is now declared, both
// realizations read it, and And declares DemandsRightOnlyWhenLeftIs { deciding: true }. So the
// removal under a false left does NOT run and the marker SURVIVES, in both realizations. The
// assertion is inverted because the measured fact inverted; a probe whose polarity is chosen to
// match the wall it is pointed at measures nothing. `a_let_bound_effect_still_runs` below is the
// control that keeps this honest: it establishes the removal is reachable at all, so a surviving
// marker here is short-circuiting and not a broken harness.
test fn and_does_not_demand_right_when_left_false() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let left_operand = false
  let combined = left_operand && shell.Remove.RecursiveForce(path: dir.path).success
  let file_exists = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  let cleanup = shell.Remove.RecursiveForce(path: dir.path)
  dir.success && marker_file.success && file_exists.is_file && !combined
}

test fn and_short_circuit_direct_probe() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let combined = false && shell.Remove.RecursiveForce(path: dir.path).success
  let file_exists = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  let cleanup = shell.Remove.RecursiveForce(path: dir.path)
  dir.success && marker_file.success && file_exists.is_file && !combined
}

// THE POSITIVE CONTROL, and it is what makes the two probes above discriminating rather than
// vacuous: the SAME removal on the SAME right operand, under a TRUE left, does run and the marker
// is gone. The pair differs in exactly one character.
test fn and_with_true_left_removes_file() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let combined = true && shell.Remove.RecursiveForce(path: dir.path).success
  let file_exists = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  dir.success && marker_file.success && combined && !file_exists.is_file
}

// THE CONTROL FOR THE TWO SHORT-CIRCUIT PROBES, because a surviving marker proves short-circuiting
// only if the removal was capable of running. A `let` is demanded by both realizations regardless
// of the demand row, so this establishes that this exact removal on this exact path works.
test fn a_let_bound_effect_still_runs() -> Bool {
  let dir = shell.Mktemp.Dir()
  let marker_file = Filesystem.Write(path: concat(dir.path, "/marker.txt"), content: "probe")
  let removed = shell.Remove.RecursiveForce(path: dir.path)
  let file_exists = shell.Test.IsFile(path: concat(dir.path, "/marker.txt"))
  dir.success && marker_file.success && removed.success && !file_exists.is_file
}

// THE FILED ROW'S OWN RED, ENROLLED. gunbc.recurring_failure_mode
// realization_arms_diverge_on_whether_the_program_refuses measured this pair on 2026-09-02:
// at n = 0 the interpreter refused DivisionByZero while the emitted Rust returned false, because
// `&&` demanded its right operand in one arm and not the other. Division by zero was chosen there
// because BOTH realizations abort identically IF the expression is evaluated, so evaluation order
// is the only variable in the pair. It is carried here rather than in a wet probe because its
// effect row is EMPTY: an effect-shaped wall would never have seen it, and it is the reason this
// change declares the demand rather than refusing effects under operands.
fn guarded_division(n: Int) -> Bool {
  n != 0 && (100 / n) > 1
}

test fn a_guard_short_circuits_a_refusing_right_operand() -> Bool {
  !guarded_division(n: 0)
}

test fn the_same_guard_admits_its_right_operand_when_it_holds() -> Bool {
  guarded_division(n: 5)
}

// NULL-COALESCING'S OWN PAIR, THE SAME SHAPE AS guarded_division AND FOR THE SAME REASON. `??` had
// the identical divergence the operand_demand row exists to close -- the interpreter evaluated both
// operands before selecting, while extdeps.languages.rust.emit rust_null_coalesce_template renders
// `{0}.unwrap_or_else(|| {1})`, whose closure body is demanded only when the left is absent -- so it
// is declared DemandsRightOnlyWhenLeftIsAbsent. These two claims are what make that declaration a
// READING rather than a hypothesis. The right operand REFUSES if it is evaluated, so the pair turns
// on demand alone: division by zero aborts identically in both realizations IF it runs at all.
fn coalesced_division(left: Int?, divisor: Int) -> Int {
  left ?? (100 / divisor)
}

test fn null_coalesce_skips_a_refusing_right_when_left_is_present() -> Bool {
  coalesced_division(left: 7, divisor: 0) == 7
}

test fn null_coalesce_demands_its_right_when_left_is_absent() -> Bool {
  coalesced_division(left: none, divisor: 5) == 20
}
