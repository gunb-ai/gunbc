module test.claim.instrument_physical_witness




data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data instrument_physical_witness_note: String = "The physical-character amendment and the focal audition, each law with the control that reds it. Three of these claims exist because a review found the corresponding hole: an amplitude was a signed Int so two channels could cancel and pass the budget; the enclosure and the focal plate were admitted by SEPARATE gates so each passed while the plate moved farther than either bound described; and the composed law said below while the arithmetic admitted equality. The reading claims that used to live here moved to the sandbox witness when the camera was rewired to read gunbc.roadmap_program_view instead of authored rows."

fn preference_over_budget() -> gunbc.design.instrument_physical.InstrumentPreference {
  gunbc.design.instrument_physical.InstrumentPreference {
    optical_jitter: gunbc.design.instrument_physical.ChannelAmplitudePx { px: 6 },
    vertical_shift: gunbc.design.instrument_physical.ChannelAmplitudePx { px: 6 },
    buoyant_drift: gunbc.design.instrument_physical.ChannelAmplitudePx { px: 6 },
    impulse_glitch: gunbc.design.instrument_physical.ChannelAmplitudePx { px: 6 },
    glitch_duration: gunbc.design.instrument_physical.ImpulseLong,
  }
}

fn witness_no_instrument_channel_may_carry_a_domain_fact() -> Bool {
  !gunbc.design.instrument_physical.channel_may_carry_domain_fact(c: gunbc.design.instrument_physical.ChannelOpticalJitter)
    && !gunbc.design.instrument_physical.channel_may_carry_domain_fact(c: gunbc.design.instrument_physical.ChannelVerticalShift)
    && !gunbc.design.instrument_physical.channel_may_carry_domain_fact(c: gunbc.design.instrument_physical.ChannelBuoyantDrift)
    && !gunbc.design.instrument_physical.channel_may_carry_domain_fact(c: gunbc.design.instrument_physical.ChannelImpulseGlitch)
}

fn witness_every_channel_off_position_is_total() -> Bool {
  gunbc.design.instrument_physical.instrument_displacement_px(p: gunbc.design.instrument_physical.preference_still) == 0
    && gunbc.design.instrument_physical.amplitude_px(a: gunbc.design.instrument_physical.channel_amplitude(p: gunbc.design.instrument_physical.preference_still, c: gunbc.design.instrument_physical.ChannelOpticalJitter)) == 0
    && gunbc.design.instrument_physical.amplitude_px(a: gunbc.design.instrument_physical.channel_amplitude(p: gunbc.design.instrument_physical.preference_still, c: gunbc.design.instrument_physical.ChannelVerticalShift)) == 0
    && gunbc.design.instrument_physical.amplitude_px(a: gunbc.design.instrument_physical.channel_amplitude(p: gunbc.design.instrument_physical.preference_still, c: gunbc.design.instrument_physical.ChannelBuoyantDrift)) == 0
    && gunbc.design.instrument_physical.amplitude_px(a: gunbc.design.instrument_physical.channel_amplitude(p: gunbc.design.instrument_physical.preference_still, c: gunbc.design.instrument_physical.ChannelImpulseGlitch)) == 0
    && !gunbc.design.instrument_physical.glitch_is_armed(g: preference_still.glitch_duration)
}

fn witness_composed_displacement_stays_under_the_register_attraction_travel() -> Bool {
  gunbc.design.instrument_physical.instrument_displacement_max_px == gunbc.design.salience.attraction_travel_max_px
    && gunbc.design.instrument_physical.instrument_displacement_px(p: gunbc.design.instrument_physical.preference_default) < gunbc.design.salience.attraction_travel_max_px
    && match gunbc.design.instrument_physical.displacement_admission(p: gunbc.design.instrument_physical.preference_default) {
         gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => total_px == 6
         gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } => false
         gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } => false
       }
}

fn witness_red_four_legal_channels_can_sum_to_an_illegal_instrument() -> Bool {
  match gunbc.design.instrument_physical.displacement_admission(p: preference_over_budget()) {
    gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } =>
      total_px == 24 && max_px == gunbc.design.salience.attraction_travel_max_px
    gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } =>
      character_px == 18 && max_px == gunbc.design.salience.attraction_travel_max_px
    gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => false
  }
}

fn witness_only_a_present_sensor_delivers_impulses() -> Bool {
  gunbc.design.instrument_physical.sensor_may_deliver_impulses(a: gunbc.design.instrument_physical.SensorPresent)
    && !gunbc.design.instrument_physical.sensor_may_deliver_impulses(a: gunbc.design.instrument_physical.SensorAbsent)
    && !gunbc.design.instrument_physical.sensor_may_deliver_impulses(a: gunbc.design.instrument_physical.SensorPermissionNotRequested)
    && !gunbc.design.instrument_physical.sensor_may_deliver_impulses(a: gunbc.design.instrument_physical.SensorPermissionDenied)
    && !gunbc.design.instrument_physical.sensor_may_deliver_impulses(a: gunbc.design.instrument_physical.SensorAvailabilityUnknown)
}

fn witness_red_an_uninterrogated_sensor_stays_distinct_from_a_missing_one() -> Bool {
  gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorAvailabilityUnknown) != gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorAbsent)
    && gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorPermissionDenied) != gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorAbsent)
    && gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorPermissionNotRequested) != gunbc.design.instrument_physical.sensor_availability_key(a: gunbc.design.instrument_physical.SensorPermissionDenied)
    && match gunbc.design.instrument_physical.admit_impulse(p: gunbc.design.instrument_physical.preference_default, s: gunbc.design.instrument_physical.HostAccelerometer, sensor: gunbc.design.instrument_physical.SensorAvailabilityUnknown) {
         gunbc.design.instrument_physical.ImpulseSourceUnavailable { source, availability } => availability == "availability-unknown"
         gunbc.design.instrument_physical.ImpulseAdmitted { source, settle } => false
         gunbc.design.instrument_physical.ImpulseChannelDisabled { source } => false
       }
}

fn witness_the_synthetic_source_auditions_on_a_machine_with_no_sensor() -> Bool {
  match gunbc.design.instrument_physical.admit_impulse(p: gunbc.design.instrument_physical.preference_default, s: gunbc.design.instrument_physical.SyntheticImpulse, sensor: gunbc.design.instrument_physical.SensorAbsent) {
    gunbc.design.instrument_physical.ImpulseAdmitted { source, settle } => source == "synthetic" && settle.duration_ms > 0
    gunbc.design.instrument_physical.ImpulseSourceUnavailable { source, availability } => false
    gunbc.design.instrument_physical.ImpulseChannelDisabled { source } => false
  }
}

fn witness_red_a_disabled_glitch_channel_refuses_a_real_impulse() -> Bool {
  match gunbc.design.instrument_physical.admit_impulse(p: gunbc.design.instrument_physical.preference_still, s: gunbc.design.instrument_physical.SyntheticImpulse, sensor: gunbc.design.instrument_physical.SensorPresent) {
    gunbc.design.instrument_physical.ImpulseChannelDisabled { source } => source == "synthetic"
    gunbc.design.instrument_physical.ImpulseAdmitted { source, settle } => false
    gunbc.design.instrument_physical.ImpulseSourceUnavailable { source, availability } => false
  }
}

fn witness_red_a_denied_permission_refuses_with_its_own_cause() -> Bool {
  match gunbc.design.instrument_physical.admit_impulse(p: gunbc.design.instrument_physical.preference_default, s: gunbc.design.instrument_physical.HostDeviceMotion, sensor: gunbc.design.instrument_physical.SensorPermissionDenied) {
    gunbc.design.instrument_physical.ImpulseSourceUnavailable { source, availability } =>
      source == "host-device-motion" && availability == "permission-denied"
    gunbc.design.instrument_physical.ImpulseAdmitted { source, settle } => false
    gunbc.design.instrument_physical.ImpulseChannelDisabled { source } => false
  }
}

fn audition_admitted(i: gunbc.design.instrument_audition.AuditionIntensity) -> Bool {
  match gunbc.design.instrument_audition.admit_audition(i: i, role: gunbc.design.salience.SalienceFocal, subject_key: "compiler-fixed-point") {
    gunbc.design.instrument_audition.AuditionAdmitted { intensity, emission, attraction, displacement_px } =>
      intensity == gunbc.design.instrument_audition.audition_intensity_key(i: i) && displacement_px <= gunbc.design.salience.attraction_travel_max_px
    gunbc.design.instrument_audition.AuditionEmissionRefused { intensity, grant } => false
    gunbc.design.instrument_audition.AuditionAttractionOutsideEnvelope { intensity } => false
    gunbc.design.instrument_audition.AuditionDisplacementOverBudget { intensity, total_px, max_px } => false
  }
}

fn witness_all_three_intensities_are_admitted_at_the_focal_role() -> Bool {
  count(gunbc.design.instrument_audition.audition_intensities) == 3
    && audition_admitted(i: gunbc.design.instrument_audition.AuditionRestrained)
    && audition_admitted(i: gunbc.design.instrument_audition.AuditionExpressive)
    && audition_admitted(i: gunbc.design.instrument_audition.AuditionHero)
}

fn witness_the_restrained_baseline_requests_no_emission_and_no_attraction() -> Bool {
  match gunbc.design.instrument_audition.audition_emission(i: gunbc.design.instrument_audition.AuditionRestrained) {
    gunbc.design.instrument_audition.AuditionNoEmission => match gunbc.design.instrument_audition.audition_attraction(i: gunbc.design.instrument_audition.AuditionRestrained) {
      gunbc.design.instrument_audition.AuditionNoAttraction => true
      gunbc.design.instrument_audition.AuditionAttracts { field } => false
    }
    gunbc.design.instrument_audition.AuditionEmits { spec } => false
  }
}

fn witness_red_the_same_audition_refuses_at_a_supporting_role() -> Bool {
  match gunbc.design.instrument_audition.admit_audition(i: gunbc.design.instrument_audition.AuditionHero, role: gunbc.design.salience.SalienceSupporting, subject_key: "compiler-fixed-point") {
    gunbc.design.instrument_audition.AuditionEmissionRefused { intensity, grant } => intensity == "hero"
    gunbc.design.instrument_audition.AuditionAdmitted { intensity, emission, attraction, displacement_px } => false
    gunbc.design.instrument_audition.AuditionAttractionOutsideEnvelope { intensity } => false
    gunbc.design.instrument_audition.AuditionDisplacementOverBudget { intensity, total_px, max_px } => false
  }
}

fn witness_red_the_restrained_baseline_still_renders_at_a_supporting_role() -> Bool {
  match gunbc.design.instrument_audition.admit_audition(i: gunbc.design.instrument_audition.AuditionRestrained, role: gunbc.design.salience.SalienceSupporting, subject_key: "compiler-fixed-point") {
    gunbc.design.instrument_audition.AuditionAdmitted { intensity, emission, attraction, displacement_px } =>
      intensity == "restrained" && displacement_px == 0
    gunbc.design.instrument_audition.AuditionEmissionRefused { intensity, grant } => false
    gunbc.design.instrument_audition.AuditionAttractionOutsideEnvelope { intensity } => false
    gunbc.design.instrument_audition.AuditionDisplacementOverBudget { intensity, total_px, max_px } => false
  }
}

// The three holes the review found in the first displacement model, each with the control that would have caught it: signed amplitudes could cancel, the prose said below while the check admitted equality, and the enclosure and the focal plate were bounded by separate gates that could not see each other.
fn witness_red_enclosure_and_attraction_cannot_pass_separately() -> Bool {
  match gunbc.design.instrument_physical.admit_composed_displacement(d: gunbc.design.instrument_physical.compose_displacement(
    p: gunbc.design.instrument_physical.preference_default,
    focal_attraction_px: gunbc.design.salience.attraction_travel_max_px,
  )) {
    gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } =>
      total_px == 6 + gunbc.design.salience.attraction_travel_max_px && max_px == gunbc.design.salience.attraction_travel_max_px
    gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => false
    gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } => false
  }
}

fn witness_the_headroom_is_what_the_enclosure_left_unspent() -> Bool {
  gunbc.design.instrument_physical.focal_attraction_headroom_px(p: gunbc.design.instrument_physical.preference_default) == gunbc.design.salience.attraction_travel_max_px - 6
    && match gunbc.design.instrument_physical.admit_composed_displacement(d: gunbc.design.instrument_physical.compose_displacement(
         p: gunbc.design.instrument_physical.preference_default,
         focal_attraction_px: gunbc.design.instrument_physical.focal_attraction_headroom_px(p: gunbc.design.instrument_physical.preference_default),
       )) {
         gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => total_px == gunbc.design.salience.attraction_travel_max_px
         gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } => false
         gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } => false
       }
}

fn witness_red_enclosure_character_alone_may_not_reach_response_travel() -> Bool {
  match gunbc.design.instrument_physical.admit_composed_displacement(d: gunbc.design.instrument_physical.ComposedVisualDisplacement {
    enclosure_character_px: gunbc.design.salience.attraction_travel_max_px,
    focal_attraction_px: 0,
    impulse_transient_px: 0,
  }) {
    gunbc.design.instrument_physical.EnclosureCharacterReachesResponseTravel { character_px, max_px } =>
      character_px == gunbc.design.salience.attraction_travel_max_px && max_px == gunbc.design.salience.attraction_travel_max_px
    gunbc.design.instrument_physical.DisplacementAdmitted { total_px } => false
    gunbc.design.instrument_physical.DisplacementOverBudget { total_px, max_px } => false
  }
}

// The provenance is an edge now, so it is checkable: three channels resolve to axes cited on a real product declaration, and the drift resolves to an axis this repository originated. A prose paragraph could not be asked either question.
fn witness_channel_provenance_is_a_typed_edge() -> Bool {
  gunbc.design.instrument_physical.channel_is_cited_precedent(c: gunbc.design.instrument_physical.ChannelOpticalJitter)
    && gunbc.design.instrument_physical.channel_is_cited_precedent(c: gunbc.design.instrument_physical.ChannelVerticalShift)
    && gunbc.design.instrument_physical.channel_is_cited_precedent(c: gunbc.design.instrument_physical.ChannelImpulseGlitch)
    && !gunbc.design.instrument_physical.channel_is_cited_precedent(c: gunbc.design.instrument_physical.ChannelBuoyantDrift)
    && gunbc.design.reference_instrument.behaviour_axis_key(a: gunbc.design.instrument_physical.channel_behaviour_axis(c: gunbc.design.instrument_physical.ChannelBuoyantDrift)) == "buoyant-drift"
    && gunbc.design.reference_instrument.behaviour_axis_key(a: gunbc.design.instrument_physical.channel_behaviour_axis(c: gunbc.design.instrument_physical.ChannelOpticalJitter)) == "optical-instability"
}

// The transient names are ours and say so; the cited Persistent behaviour is a latch we do not model, so no arm claims it.
fn witness_the_transient_vocabulary_is_local_and_decaying() -> Bool {
  gunbc.design.instrument_physical.glitch_duration_key(g: gunbc.design.instrument_physical.ImpulseOff) == "off"
    && gunbc.design.instrument_physical.glitch_duration_key(g: gunbc.design.instrument_physical.ImpulseBrief) == "brief"
    && gunbc.design.instrument_physical.glitch_duration_key(g: gunbc.design.instrument_physical.ImpulseLong) == "long"
    && gunbc.design.instrument_physical.glitch_settle(g: gunbc.design.instrument_physical.ImpulseLong).duration_ms > gunbc.design.instrument_physical.glitch_settle(g: gunbc.design.instrument_physical.ImpulseBrief).duration_ms
}

test fn instrument_physical_keystone_holds() -> Bool {
  witness_no_instrument_channel_may_carry_a_domain_fact()
    && witness_every_channel_off_position_is_total()
    && witness_composed_displacement_stays_under_the_register_attraction_travel()
    && witness_red_four_legal_channels_can_sum_to_an_illegal_instrument()
    && witness_only_a_present_sensor_delivers_impulses()
    && witness_red_an_uninterrogated_sensor_stays_distinct_from_a_missing_one()
    && witness_the_synthetic_source_auditions_on_a_machine_with_no_sensor()
    && witness_red_a_disabled_glitch_channel_refuses_a_real_impulse()
    && witness_red_a_denied_permission_refuses_with_its_own_cause()
    && witness_all_three_intensities_are_admitted_at_the_focal_role()
    && witness_the_restrained_baseline_requests_no_emission_and_no_attraction()
    && witness_red_the_same_audition_refuses_at_a_supporting_role()
    && witness_red_the_restrained_baseline_still_renders_at_a_supporting_role()
    && witness_red_enclosure_and_attraction_cannot_pass_separately()
    && witness_the_headroom_is_what_the_enclosure_left_unspent()
    && witness_red_enclosure_character_alone_may_not_reach_response_travel()
    && witness_channel_provenance_is_a_typed_edge()
    && witness_the_transient_vocabulary_is_local_and_decaying()
}
