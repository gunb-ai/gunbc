module test.claim.network_boot_predecessor_census_witness

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.network_boot_predecessor_census {
  AuthoredPlanNotEstablishment,
  DurableOriginNotBootOrigin,
  FrozenMachineLocalNotFleetAuthority,
  HttpBootConstructorBesideNotInstead,
  KeepMeasuredClientFactUnextended,
  NetworkBootPredecessorDisposition,
  SiteAdapterMayConsumeFormat,
  predecessor_disposition_of,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn disposition_is(module_path: String, decl_name: String, expected: NetworkBootPredecessorDisposition) -> Bool {
  match predecessor_disposition_of(module_path: module_path, decl_name: decl_name) {
    Absent => false
    Present { value: d } => d == expected
  }
}

test fn census_identity_joins_the_named_predecessors() -> Bool {
  disposition_is(module_path: "gunbc.bmc_netboot_serve", decl_name: "srv4_bmc_netboot_serve_plan", expected: FrozenMachineLocalNotFleetAuthority)
    && disposition_is(module_path: "gunbc.os_install", decl_name: "srv3_pxe_network_boot_chain", expected: AuthoredPlanNotEstablishment)
    && disposition_is(module_path: "gunbc.machine_intake_mtcollins1_netboot_client_observation", decl_name: "mtcollins1_pxe_vendor_class", expected: KeepMeasuredClientFactUnextended)
    && disposition_is(module_path: "gunbc.cloudflare.r2_origin", decl_name: "fabric_durable_origin_standing", expected: DurableOriginNotBootOrigin)
    && disposition_is(module_path: "extdeps.formats.dnsmasq", decl_name: "dnsmasq_protocol", expected: SiteAdapterMayConsumeFormat)
    && disposition_is(module_path: "extdeps.firmware.uefi_http_boot", decl_name: "extdeps_external_authority_anchor", expected: HttpBootConstructorBesideNotInstead)
    && disposition_is(module_path: "gunbc.spark.dgx_pxe_boot", decl_name: "SparkUefiPxeConfiguration", expected: FrozenMachineLocalNotFleetAuthority)
    && disposition_is(module_path: "extdeps.provisioning.network_boot", decl_name: "network_uefi_bootloader_artifact", expected: AuthoredPlanNotEstablishment)
}

test fn unknown_predecessor_has_no_disposition() -> Bool {
  match predecessor_disposition_of(module_path: "gunbc.network_boot_delivery", decl_name: "join_network_boot_delivery") {
    Absent => true
    Present { value: _ } => false
  }
}
