module test.claim.spark_managed_grant_reconcile_witness


// srv6's actual listing shape, and the reason the reboot leg failed: linger is granted, reboot is
// not, and nothing computed the difference.
//
// THESE TWO FIXTURES WERE WRONG, and the way they were wrong is the reason this file needed
// changing. They were written from the model's own sudoers_command rather than captured from a
// host, so they said "/usr/bin/loginctl enable-linger" with no subject -- a line srv5 and srv6 have
// never held. A fixture derived from the thing it is supposed to be an oracle for cannot refute
// that thing; it agrees with it by construction, including when it is wrong. Both now carry the
// line measured on both hosts 2026-08-22 via `sudo -n -l`:
//
//     (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation
data srv6_listing_before: String = "Matching Defaults entries for gunbc-automation on srv6:\n    env_reset\n\nUser gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation\n"

data srv6_listing_after: String = "User gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation\n    (root) NOPASSWD: /usr/bin/systemctl reboot\n"

test fn a_listing_naming_only_linger_puts_reboot_in_the_install_set() -> Bool {
  let missing = gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_before })
  missing.length() == 1
    && any(missing, m => match m {
         gunbc.spark.managed_access_bootstrap.RebootThisHost => true
         gunbc.spark.managed_access_bootstrap.EnableLingerForOwnAccount { subject: _ } => false
       })
}

// THE DISCRIMINATING PAIR. The same function over the same shape of input answers differently once
// the grant is present, which is what makes it a reconcile rather than a constant.
test fn the_same_listing_with_reboot_added_installs_nothing() -> Bool {
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_after }).length() == 0
    && gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_after })
    && !gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_before })
}

// Sudo demanding a password IS the answer "none", successfully obtained, so every desired grant is
// missing and the remedy is to install them.
test fn a_password_demand_is_an_observation_that_no_grant_is_held() -> Bool {
  let o = gunbc.spark.managed_access_bootstrap.GrantAbsent { detail: "exit=1 stderr=sudo: a password is required" }
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: o).length() == spark_managed_grant_population.length()
    && gunbc.spark.managed_grant_reconcile.spark_managed_grants_unobserved(outcome: o).length() == 0
}

// THE ARM THAT KEEPS IGNORANCE OUT OF THE INSTALL SET, and the reason the standing is three-way. A
// probe that failed for any other reason must not be read as "no grants held" -- installing sudoers
// entries on a host we could not measure is actuating on ignorance, and it is the exact shape of the
// absorbing fallback the repo forbids.
test fn a_probe_that_failed_for_another_reason_installs_nothing() -> Bool {
  let o = gunbc.spark.managed_access_bootstrap.GrantAbsent { detail: "exit=255 stderr=ssh: connect to host srv6 port 22: No route to host" }
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: o).length() == 0
    && gunbc.spark.managed_grant_reconcile.spark_managed_grants_unobserved(outcome: o).length() == spark_managed_grant_population.length()
    && !gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: o)
}

// A refused leg is unobserved for the same reason, on a different channel.
test fn a_refused_probe_leg_is_unobserved_and_never_converged() -> Bool {
  let o = gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "non-portable-remote-word" }
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: o).length() == 0
    && !gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: o)
}

// AN EMPTY INSTALL LIST IS NOT CONVERGENCE. A fully unobserved host produces one, and reading it as
// "nothing to do" is the empty-observation narrow: the run would report a host needing no work
// precisely when it learned nothing about it.
test fn nothing_to_install_does_not_imply_converged() -> Bool {
  let unobserved = gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "leg refused" }
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: unobserved).length() == 0
    && !gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: unobserved)
    && gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_after })
}

// The subject the live hosts actually grant. Named once so the assertions below join against one
// value rather than each re-spelling the login.
fn linger_grant() -> gunbc.spark.managed_access_bootstrap.SparkManagedGrant {
  gunbc.spark.managed_access_bootstrap.EnableLingerForOwnAccount { subject: "gunbc-automation" as std.types.NonEmptyStr }
}

// THE LINE THIS REPOSITORY WOULD INSTALL, held against the line srv5 and srv6 ACTUALLY HOLD,
// captured 2026-08-22 by `sudo -n -l` as the grantee. This is the oracle the old test lacked: an
// independently observed string, not a second reading of the model.
data measured_installed_linger_command: String = "/usr/bin/loginctl enable-linger gunbc-automation"
data measured_installed_reboot_command: String = "/usr/bin/systemctl reboot"

// THE OLD TEST HERE WAS VACUOUS AND ITS NAME CLAIMED OTHERWISE. It asserted
//
//     any(spark_managed_grant_argv(grant: g).skip(n: 2), w => string_contains(command, w))
//
// under the name the_sudoers_line_authorizes_exactly_the_argv_the_actuator_runs. An ANY over
// substring containment: "loginctl" is inside "/usr/bin/loginctl enable-linger", so it passed. It
// would have passed with the argv truncated to [sudo, -n, loginctl], with a bogus word appended, and
// -- as it did for however long it stood -- with the subject account missing from both sides while
// the hosts required it. "Exactly" was a word in an identifier over a body asserting almost nothing.
//
// The replacement joins at ARGV GRAIN and against the MEASURED line: every word of the argv after
// `sudo -n` must appear in the command in order, and the command must equal what the host holds.
test fn the_sudoers_command_equals_the_line_the_hosts_actually_hold() -> Bool {
  gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: linger_grant()) as String == measured_installed_linger_command
    && gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: gunbc.spark.managed_access_bootstrap.RebootThisHost) as String == measured_installed_reboot_command
}

// THE ARGV AND THE COMMAND ARE THE SAME WORDS, asserted as an equality over the word list rather
// than as containment. The argv is `sudo -n <words>`; the command is those same <words> with the
// binary made absolute. Reconstructing one from the other and comparing is what the old ANY could
// not do.
test fn the_sudoers_line_authorizes_exactly_the_argv_the_actuator_runs() -> Bool {
  fold(gunbc.spark.managed_access_bootstrap.spark_managed_grant_population, init: true, f: fn(acc, g) {
    let words = gunbc.spark.managed_access_bootstrap.spark_managed_grant_argv(grant: g).skip(n: 2)
    let command = gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: g) as String
    let content = gunbc.spark.managed_grant_reconcile.spark_managed_grant_sudoers_content(grant: g)
    acc
      && gunbc.spark.managed_access_bootstrap.spark_managed_grant_argv(grant: g).length() == words.length() + 2
      && command == concat(extdeps.systemd.systemd_binary_directory as String, concat("/", join(words, " ")))
      && string_contains(content, "gunbc-automation ALL=(root) NOPASSWD: ")
      && string_contains(content, command)
  })
}

// THE DISCRIMINATING RED. The pre-change spelling -- the subject dropped from the command -- must
// FAIL the assertion above. Without this the new test could be as vacuous as the one it replaces and
// nothing would say so: a test that greens a correct change is indistinguishable from one that
// greens the next wrong change unless a known-wrong input is shown to red it.
test fn the_pre_change_spelling_without_the_subject_is_refused() -> Bool {
  let pre_change = "/usr/bin/loginctl enable-linger"
  pre_change != measured_installed_linger_command
    && !string_contains(pre_change, "gunbc-automation")
    && gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: linger_grant()) as String != pre_change
}

// AND THE MIRROR OF IT ON THE ARGV, because the two halves of the fork failed differently: the
// command dropped the subject, the argv dropped the subject AND the absolute path. An argv that
// cannot execute under the installed grant must not be derivable.
test fn the_derived_argv_carries_the_subject_the_grant_requires() -> Bool {
  join(gunbc.spark.managed_access_bootstrap.spark_managed_grant_argv(grant: linger_grant()), " ")
    == "sudo -n loginctl enable-linger gunbc-automation"
    && join(gunbc.spark.managed_access_bootstrap.spark_managed_grant_argv(grant: gunbc.spark.managed_access_bootstrap.RebootThisHost), " ") == "sudo -n systemctl reboot"
}

// Narrow on every axis sudoers offers. A wildcard command would make the population decorative,
// since one entry would then authorize everything the others name.
test fn no_grant_is_written_as_a_wildcard() -> Bool {
  fold(gunbc.spark.managed_access_bootstrap.spark_managed_grant_population, init: true, f: fn(acc, g) {
    acc && !string_contains(gunbc.spark.managed_grant_reconcile.spark_managed_grant_sudoers_content(grant: g), "ALL\n")
        && !string_contains(gunbc.spark.managed_grant_reconcile.spark_managed_grant_sudoers_content(grant: g), "NOPASSWD: ALL")
  })
}

// Distinct files per grant: appending to one file has no idempotent form, so a second reconcile run
// would differ from the first.
test fn each_grant_lands_in_its_own_dropin_file() -> Bool {
  gunbc.spark.managed_grant_reconcile.spark_managed_grant_dropin_path(grant: gunbc.spark.managed_access_bootstrap.RebootThisHost) as String
    != gunbc.spark.managed_grant_reconcile.spark_managed_grant_dropin_path(grant: linger_grant()) as String
    && string_contains(gunbc.spark.managed_grant_reconcile.spark_managed_grant_dropin_path(grant: gunbc.spark.managed_access_bootstrap.RebootThisHost) as String, "/etc/sudoers.d/")
}

// The report names the gap and its remedy in the same line, because the failure this replaces said
// only "a password is required" -- naming neither the grant nor where it goes.
test fn the_report_names_the_missing_grant_and_where_it_goes() -> Bool {
  let text = gunbc.spark.managed_grant_reconcile.spark_managed_grant_report(host: "srv6", outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_before })
  string_contains(text, "converged=false")
    && string_contains(text, "standing=not-held")
    && string_contains(text, "/etc/sudoers.d/gunbc-reboot")
    && string_contains(text, "standing=held")
}

test fn a_held_grant_reports_held_rather_than_silence() -> Bool {
  match gunbc.spark.managed_grant_reconcile.spark_managed_grant_standing_from_outcome(
    grant: linger_grant(),
    outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_before },
  ) {
    gunbc.spark.managed_grant_reconcile.GrantHeld { grant: _ } => true
    gunbc.spark.managed_grant_reconcile.GrantNotHeld { grant: _ } => false
    gunbc.spark.managed_grant_reconcile.GrantStandingUnobserved { grant: _, cause: _ } => false
  }
}

// THE PREFIX-BLINDNESS THE SUBSTRING JOIN ADMITTED, as an executing refusal rather than a claim.
//
// This listing authorizes a WIDER grant than the population desires: the entry ends in a subject
// the desired command does not name, so the host holds more privilege than the model asked for.
// `string_contains(listing, "/usr/bin/loginctl enable-linger")` is TRUE over it -- the desired
// command is a proper prefix of the installed one -- so the join this PR replaces reported
// converged and named nothing. The entry-grained join answers not-held, which is the honest
// answer: what is installed is not what was modeled.
//
// This is the discriminating RED for the change. Restoring the substring join turns this test
// green, which is the only reason it can be trusted to be measuring the fix.
data srv6_listing_wider_than_desired: String = "User gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger some-other-account\n"

//
// IT ASSERTS THE INSTALL-SET SIZE, NOT CONVERGENCE, and the difference is the whole test. An
// earlier draft asserted `!converged` over this listing and was VACUOUS: the fixture names no
// reboot entry, so the reboot grant is unheld under either join and convergence is false whichever
// way the linger question is answered. The mutation control proved it -- restoring the substring
// join left the test GREEN, so it was measuring the reboot grant's absence and nothing about the
// change it was written for. Counting the install set isolates the one grant whose standing the
// two joins disagree about: 2 under the entry-grained join (neither grant held), 1 under the
// substring join (linger wrongly held).
test fn an_entry_that_merely_starts_with_the_desired_command_is_not_that_grant() -> Bool {
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_wider_than_desired }).length() == 2
}

// A BANNER LINE CONTRIBUTES NOTHING RATHER THAN A NEGATIVE VOTE. The listing's prose header names
// the account and the host and carries no `NOPASSWD:` marker, so it yields no command at all -- the
// join skips it instead of counting it as an entry that failed to match.
test fn the_listing_banner_is_not_read_as_an_entry() -> Bool {
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: srv6_listing_after })
    && !gunbc.spark.managed_grant_reconcile.spark_managed_grants_converged(outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: "User gunbc-automation may run the following commands on srv6:\n" })
}

// THE ORDERING WITNESS. It is RED on this branch by construction and that is its whole function.
//
// The exactness fix above and the grant-spelling correction in gunbc#8860 are two defects that
// CANCEL. Today the modeled linger command omits the subject the hosts actually hold, and the
// substring join is the only reason that mismatch does not surface: `/usr/bin/loginctl
// enable-linger` is a substring of the installed `/usr/bin/loginctl enable-linger
// gunbc-automation`, so the grant reads HELD despite the model naming a different command. Make
// the join exact FIRST and the linger grant reads NOT-HELD on two converged live hosts, and the
// remedy the reconcile reports is to install a grant that is already there.
//
// So the order is load-bearing: #8860's spelling must land before this join tightens. A note in a
// PR body cannot enforce that -- it depends on a human merging two PRs in one direction -- so the
// constraint is executed instead. This asserts the modeled command is BYTE-EQUAL to the line
// measured on srv5 and srv6, which is false until #8860 merges and true after. Merging this branch
// first therefore cannot go green.
//
// It is not written against #8860's variant shape, deliberately: it reads only the population's
// rendered command strings, so it compiles identically before and after that PR and measures the
// one fact the ordering depends on.
data measured_installed_linger_command: String = "/usr/bin/loginctl enable-linger gunbc-automation"

test fn the_modeled_linger_command_is_byte_equal_to_the_line_the_hosts_hold() -> Bool {
  any(gunbc.spark.managed_access_bootstrap.spark_managed_grant_population, g =>
    gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: g) as String == measured_installed_linger_command)
}

// A MULTI-COMMAND ENTRY LINE, which sudo renders comma-separated for one Cmnd_Spec. MEASURED on
// both live hosts 2026-08-22: each grant is its own drop-in and so its own line, so this shape does
// not occur on srv5 or srv6 today. It is covered because it is a shape sudo MAY emit, and reading
// such a line as one command would match neither grant it names -- convergence would never complete
// on a host that plainly holds both, and the diagnostic would report grants missing that are
// visibly present.
//
// THE FIXTURE IS BUILT FROM THE POPULATION, NOT HAND-SPELLED, and that is what keeps this test
// about the PARSE. A hand-written line has to pick a spelling, and the linger spelling is exactly
// what gunbc#8860 changes -- so the first draft of this test hardcoded the post-#8860 command and
// returned FALSE here, reporting a comma-splitting defect when what it had actually measured was
// the subject's absence from today's modeled command. Two ordering-dependent tests where one was
// intended, and the second one lying about which axis it failed on.
//
// Rendering the line from `spark_managed_grant_sudoers_command` makes it agree with the model on
// spelling BY CONSTRUCTION -- normally the thing that disqualifies a fixture, since one that agrees
// by construction cannot falsify what it renders from. It is right here because the spelling axis
// is OWNED BY ANOTHER TEST in this file, `the_modeled_linger_command_is_byte_equal_to_the_line_the
// _hosts_hold`, which pins the modeled command against a line measured on srv5 and srv6. This test
// owns only the entry-splitting axis. Do not "fix" this back into a hand-spelled literal: that
// silently restores the two-axis failure and makes a parse test fail for a spelling reason. What it still discriminates is its own axis: drop the
// comma split and the line reads as one command, neither grant matches, and the install set is 2
// rather than 0.
fn spark_grant_line_naming_every_grant_on_one_line() -> String {
  join(
    ["    (root) NOPASSWD: ",
     join(map(gunbc.spark.managed_access_bootstrap.spark_managed_grant_population, g => gunbc.spark.managed_access_bootstrap.spark_managed_grant_sudoers_command(grant: g) as String), ", "),
     "\n"],
    "")
}

test fn two_commands_on_one_entry_line_are_two_grants() -> Bool {
  gunbc.spark.managed_grant_reconcile.spark_managed_grants_to_install(
    outcome: gunbc.spark.managed_access_bootstrap.GrantEnumerated { listing: spark_grant_line_naming_every_grant_on_one_line() }
  ).length() == 0
}
