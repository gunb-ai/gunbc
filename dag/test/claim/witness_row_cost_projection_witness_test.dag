fn two_readings_of_one_clock_refuse_rather_than_picking_holds() -> Bool {
  let ambiguous: List<std.observation.TimedMeasurement> = [
    std.observation.TimedMeasurement { basis: WallClock, elapsed: std.observation.MeasuredValue { value: witness_wall_ms(count: 40) } },
    std.observation.TimedMeasurement { basis: WallClock, elapsed: std.observation.MeasuredValue { value: witness_wall_ms(count: 90) } }
  ]
  match observation_duration_of(durations: ambiguous, basis: WallClock) {
    MeasuredValue { value: _ } => false
    MeasuredUnavailable { cause: _ } => true
  }
}

test fn witness_row_cost_projection_holds() -> Bool {
  two_events_project_one_exact_tsv_row_holds() &&
  missing_parent_resolve_refuses_holds() &&
  multiple_parent_resolve_refuses_holds() &&
  resolve_wall_is_shared_not_divided_holds() &&
  refused_outcome_distinct_from_failed_in_projection_holds() &&
  w2_ambient_suppress_retains_complete_receipt_row_holds() &&
  malformed_nested_resolve_event_refuses_holds() &&
  typed_event_role_extract_classifies_entry_and_declaration_holds() &&
  rss_unavailable_carries_cause_on_modeled_events_holds() &&
  duplicate_declaration_identity_refuses_holds() &&
  non_concluded_timing_event_refuses_holds() &&
  native_seed_events_preserve_order_outcome_and_perturbation_holds() &&
  exact_nanosecond_projection_and_same_millisecond_order_holds() &&
  seed_timed_out_event_carries_the_pair_and_is_not_failed_holds() &&
  timed_out_red_control_is_neither_done_nor_failed_holds() &&
  row_carries_both_clocks_and_does_not_confuse_them_holds() &&
  wall_only_row_reports_cpu_absent_rather_than_zero_holds() &&
  eval_with_no_wall_clock_refuses_rather_than_projecting_holds() &&
  two_readings_of_one_clock_refuse_rather_than_picking_holds()
}

