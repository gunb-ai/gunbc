  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl("duplicate")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 10)),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: witness_eval_ms(count: 1), outcome: Done),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: witness_eval_ms(count: 2), outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } =>
      string_contains(s: c, pattern: "duplicate declaration")
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn non_concluded_timing_event_refuses_holds() -> Bool {
  let concluded = witness_cost_seed_done_event(
    entry: sample_entry(),
    module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
    function: "begun_only" as std.types.NonEmptyStr,
    eval: witness_eval_ms(count: 1)
  )
  let begun = std.observation.ObservationEvent {
    subject: concluded.subject,
    transition: Begin,
    durations: concluded.durations,
    rss: concluded.rss
  }
  match project_witness_cost_receipt(events: [
    witness_cost_entry_resolve_event(entry: sample_entry(), resolve: witness_wall_ms(count: 10)),
    begun
  ]) {
    WitnessCostProjectionRefused { cause: c } =>
      string_contains(s: c, pattern: "non-concluded")
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn native_seed_events_preserve_order_outcome_and_perturbation_holds() -> Bool {
  let entry = sample_entry()
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    witness_cost_seed_refused_event(
      entry: entry,
      module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
      function: "first_refused" as std.types.NonEmptyStr,
      eval: witness_eval_ms(count: 7),
      diagnostic: "typed refusal" as std.types.NonEmptyStr
    ),
    witness_cost_seed_failed_event(
      entry: entry,
      module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
      function: "second_failed" as std.types.NonEmptyStr,
      eval: witness_eval_ms(count: 19),
      error: "runtime failure" as std.types.NonEmptyStr
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: "" as String, f: (acc, row) =>
        concat(acc, concat(row.declaration.decl_name, ":"))
      ) == "first_refused:second_failed:" &&
      fold(rows, init: 0, f: (acc, row) =>
        acc + row_wall_ms_count(row: row)
      ) == 26 &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Refused { diagnostic: d } => d == ("typed refusal" as std.types.NonEmptyStr)
          Done => false
          Failed { error: _, output: _ } => false
          TimedOut { basis: _, budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Failed { error: e, output: _ } => e == ("runtime failure" as std.types.NonEmptyStr)
          Done => false
          Refused { diagnostic: _ } => false
          TimedOut { basis: _, budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      string_contains(s: witness_cost_native_production_note, pattern: "sole semantic row input")
  }
}

fn exact_nanosecond_projection_and_same_millisecond_order_holds() -> Bool {
  let entry = sample_entry()
  let one = test.claim.witness_row_cost_projection.sample_decl(name: "one_ns")
  let sub_ms = test.claim.witness_row_cost_projection.sample_decl(name: "sub_ms")
  let one_ms = test.claim.witness_row_cost_projection.sample_decl(name: "one_ms")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: nanosecond(count: 7)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: one,
      eval: witness_eval_ns(count: 1),
      outcome: Done
    ),
    witness_cost_declaration_event(
      entry: entry,
      declaration: sub_ms,
      eval: witness_eval_ns(count: 999999),
      outcome: Done
    ),
    witness_cost_declaration_event(
      entry: entry,
      declaration: one_ms,
      eval: witness_eval_ns(count: 1000000),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 3 &&
      fold(rows, init: "" as String, f: (acc, row) =>
        concat(acc, concat(row.declaration.decl_name, ":"))
      ) == "one_ns:sub_ms:one_ms:" &&
      fold(rows, init: true, f: (acc, row) =>
        let eval_ns = row_clock_ns(row: row, basis: WallClock)
        let warm_ns = nanosecond_count(n: row.warm)
        acc &&
        nanosecond_count(n: row.resolve) == 7 &&
        warm_ns == eval_ns + 7 &&
        if row.declaration == one {
          eval_ns == 1
        } else if row.declaration == sub_ms {
          eval_ns == 999999
        } else if row.declaration == one_ms {
          eval_ns == 1000000
        } else {
          false
        }
      )
  }
}

fn seed_timed_out_event_carries_the_pair_and_is_not_failed_holds() -> Bool {
  let entry = sample_entry()
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    witness_cost_seed_timed_out_event(
      entry: entry,
      module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
      function: "killed_at_deadline" as std.types.NonEmptyStr,
      eval: witness_eval_ms(count: 900794),
      basis: WallClock,
      budget: millisecond(count: 900000),
      elapsed: millisecond(count: 900001)
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          TimedOut { basis: k, budget: b, elapsed: e } =>
            clock_basis_eq(a: k, b: WallClock) &&
            !clock_basis_eq(a: k, b: CpuClock) &&
            millisecond_count(m: b) == 900000 && millisecond_count(m: e) == 900001
          Done => false
          Refused { diagnostic: _ } => false
          Failed { error: _, output: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn timed_out_red_control_is_neither_done_nor_failed_holds() -> Bool {
  let entry = sample_entry()
  let killed = witness_cost_seed_timed_out_event(
    entry: entry,
    module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
    function: "killed" as std.types.NonEmptyStr,
    eval: witness_eval_ms(count: 5),
    basis: CpuClock,
    budget: millisecond(count: 4),
    elapsed: millisecond(count: 5)
  )
  match project_witness_cost_receipt(events: [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 10)),
    killed
  ]) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      fold(rows, init: true, f: (acc, row) =>
        acc && match row.outcome {
          Done => false
          Failed { error: _, output: _ } => false
          Refused { diagnostic: _ } => false
          TimedOut { basis: _, budget: _, elapsed: _ } => true
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn row_carries_both_clocks_and_does_not_confuse_them_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "two_clock_witness")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: witness_eval_cpu_and_wall(cpu_ms: 3, wall_ms: 40),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: true, f: (acc, row) =>
        acc &&
        row_clock_ns(row: row, basis: WallClock) == nanosecond_count(n: witness_wall_ms(count: 40)) &&
        row_clock_ns(row: row, basis: CpuClock) == nanosecond_count(n: witness_wall_ms(count: 3)) &&
        row_clock_ns(row: row, basis: WallClock) != row_clock_ns(row: row, basis: CpuClock) &&
        row_wall_ms_count(row: row) == 40 &&
        witness_wall_ms_count(wall: row.warm) == 140
      )
  }
}

