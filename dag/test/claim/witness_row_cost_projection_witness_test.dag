module test.claim.witness_row_cost_projection

import gunbc.witness_row_cost {
  WitnessCostProjectionComplete,
  WitnessCostProjectionRefused,
  WitnessCostReceiptRow,
  WitnessCostEventRole,
  EntryResolveParent,
  DeclarationWitness,
  project_witness_cost_receipt,
  witness_cost_event_role,
  witness_cost_entry_resolve_event,
  witness_cost_declaration_event,
  witness_cost_nested_resolve_under_declaration_event,
  witness_cost_module_resolve_event,
  witness_cost_seed_done_event,
  witness_cost_seed_refused_event,
  witness_cost_seed_failed_event,
  witness_cost_warm,
  witness_cost_rss_unavailable_cause,
  witness_cost_native_production_note,
  witness_cost_event_role_note,
}
import std.logic { Bool }
import std.nat { Nat }
import std.types { NonEmptyStr, List, Int }
import std.measure { millisecond, millisecond_count }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.observation {
  ObservationEvent,
  MeasuredUnavailable,
  MeasuredValue,
  Done,
  Refused,
  Failed,
  TimedOut,
  Skipped,
  Final,
  Begin,
  AttentionBasis,
  Ambient,
  observation_attention,
}
import gunbc.observation_ci_render {
  InsideCollapsedGroup,
  OutsideGroup,
  ci_line_placement,
}
import v2.std.text { String }

data witness_row_cost_projection_note: String = "Executing REDs for the #5 ObservationEvent join projection (N+1 per entry). (1) DeclarationSegment key/grain totality lives in observation_model_witness_test. (2) Two modeled events → one exact TSV row. (3) Missing or multiple parent resolve events REFUSE the row set. (4) W2 Ambient suppress does not delete the complete receipt row. (5) Declaration-/module-nested resolve phases do NOT count as the entry-level parent (collision RED — review 43409). Resolve wall is entry-level/shared — repeated as a column, never divided, never summed N times as a corpus total. Role classification is witness_cost_event_role (typed extract), not is_* Bool filters."

fn sample_decl(name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: "test.claim.witness_row_cost_projection" as NonEmptyStr,
    decl_name: name as NonEmptyStr,
    field: WholeDeclaration
  }
}

fn sample_entry() -> NonEmptyStr {
  "dag/test/claim/witness_row_cost_projection_witness_test.dag" as NonEmptyStr
}

fn two_events_project_one_exact_tsv_row_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl(name: "fast_witness")
  let resolve = millisecond(count: 100)
  let eval = millisecond(count: 20)
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: eval, outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: true, f: (acc, row) =>
        acc &&
        row.entry == entry &&
        row.declaration == decl &&
        millisecond_count(m: row.eval) == 20 &&
        millisecond_count(m: row.resolve) == 100 &&
        millisecond_count(m: row.warm) == 120 &&
        row.warm == witness_cost_warm(eval: eval, resolve: resolve) &&
        match row.outcome {
          Done => true
          Refused { diagnostic: _ } => false
          Failed { error: _, output: _ } => false
          TimedOut { budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn missing_parent_resolve_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl(name: "orphan_witness")
  let events: List<ObservationEvent> = [
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: millisecond(count: 20),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } =>
      c != ("silent" as NonEmptyStr)
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn multiple_parent_resolve_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl(name: "ambiguous_parent")
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 100)),
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 200)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: millisecond(count: 20),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } => c != ("" as NonEmptyStr)
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn resolve_wall_is_shared_not_divided_holds() -> Bool {
  let entry = sample_entry()
  let d1 = sample_decl(name: "w1")
  let d2 = sample_decl(name: "w2")
  let resolve = millisecond(count: 100)
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_cost_declaration_event(entry: entry, declaration: d1, eval: millisecond(count: 10), outcome: Done),
    witness_cost_declaration_event(entry: entry, declaration: d2, eval: millisecond(count: 30), outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: true, f: (acc, row) =>
        acc && millisecond_count(m: row.resolve) == 100
      ) &&
      fold(rows, init: 0, f: (acc, row) => acc + millisecond_count(m: row.resolve)) == 200 &&
      millisecond_count(m: resolve) == 100
  }
}

fn refused_outcome_distinct_from_failed_in_projection_holds() -> Bool {
  let entry = sample_entry()
  let d_refused = sample_decl(name: "refused_w")
  let d_failed = sample_decl(name: "failed_w")
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 50)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: d_refused,
      eval: millisecond(count: 5),
      outcome: Refused { diagnostic: "typed refuse" as NonEmptyStr }
    ),
    witness_cost_declaration_event(
      entry: entry,
      declaration: d_failed,
      eval: millisecond(count: 5),
      outcome: Failed { error: "boom" as NonEmptyStr, output: "" }
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Refused { diagnostic: d } => d == ("typed refuse" as NonEmptyStr)
          Failed { error: _, output: _ } => false
          Done => false
          TimedOut { budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Failed { error: e, output: _ } => e == ("boom" as NonEmptyStr)
          Refused { diagnostic: _ } => false
          Done => false
          TimedOut { budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn w2_ambient_suppress_retains_complete_receipt_row_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl(name: "ambient_w")
  let eval = millisecond(count: 5)
  let resolve = millisecond(count: 10)
  let witness_event = witness_cost_declaration_event(
    entry: entry,
    declaration: decl,
    eval: eval,
    outcome: Done
  )
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_event
  ]
  let basis = AttentionBasis {
    average: millisecond(count: 1000),
    maximum: millisecond(count: 5000)
  }
  observation_attention(event: witness_event, basis: basis) == Ambient &&
  ci_line_placement(attention: Ambient) == InsideCollapsedGroup &&
  ci_line_placement(attention: Ambient) != OutsideGroup &&
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: true, f: (acc, row) =>
        acc && millisecond_count(m: row.eval) == 5 && millisecond_count(m: row.resolve) == 10
      )
  }
}

fn rss_unavailable_carries_cause_on_modeled_events_holds() -> Bool {
  let e = witness_cost_entry_resolve_event(
    entry: sample_entry(),
    resolve: millisecond(count: 1)
  )
  match e.rss {
    MeasuredUnavailable { cause: c } => c == witness_cost_rss_unavailable_cause()
    MeasuredValue { value: _ } => false
  }
}

fn malformed_nested_resolve_event_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl("nested")
  let nested = witness_cost_nested_resolve_under_declaration_event(
    entry: entry,
    declaration: decl,
    resolve: millisecond(count: 999)
  )
  let module_resolve = witness_cost_module_resolve_event(
    entry: entry,
    module_path: "test.claim.witness_row_cost_projection" as NonEmptyStr,
    resolve: millisecond(count: 888)
  )
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 100)),
    nested,
    module_resolve,
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: millisecond(count: 5),
      outcome: Done
    )
  ]
  match witness_cost_event_role(event: nested) {
    Present { value: _ } => false
    Absent =>
      match witness_cost_event_role(event: module_resolve) {
        Present { value: _ } => false
        Absent =>
          match project_witness_cost_receipt(events: events) {
            WitnessCostProjectionRefused { cause: c } =>
              string_contains(s: c, pattern: "malformed")
            WitnessCostProjectionComplete { rows: _ } => false
          }
      }
  }
}

fn typed_event_role_extract_classifies_entry_and_declaration_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl("role")
  let parent = witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 1))
  let child = witness_cost_declaration_event(
    entry: entry,
    declaration: decl,
    eval: millisecond(count: 2),
    outcome: Done
  )
  match witness_cost_event_role(event: parent) {
    Present { value: EntryResolveParent } =>
      match witness_cost_event_role(event: child) {
        Present { value: DeclarationWitness } =>
          string_contains(s: witness_cost_event_role_note, pattern: "review 43409") &&
          string_contains(s: witness_cost_event_role_note, pattern: "entry-level")
        Present { value: EntryResolveParent } => false
        Absent => false
      }
    Present { value: DeclarationWitness } => false
    Absent => false
  }
}

fn duplicate_declaration_identity_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = sample_decl("duplicate")
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 10)),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: millisecond(count: 1), outcome: Done),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: millisecond(count: 2), outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } =>
      string_contains(s: c, pattern: "duplicate declaration")
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn non_concluded_timing_event_refuses_holds() -> Bool {
  let concluded = witness_cost_seed_done_event(
    entry: sample_entry(),
    module_path: "test.claim.witness_row_cost_projection" as NonEmptyStr,
    function: "begun_only" as NonEmptyStr,
    eval: millisecond(count: 1)
  )
  let begun = ObservationEvent {
    subject: concluded.subject,
    transition: Begin,
    wall: concluded.wall,
    rss: concluded.rss
  }
  match project_witness_cost_receipt(events: [
    witness_cost_entry_resolve_event(entry: sample_entry(), resolve: millisecond(count: 10)),
    begun
  ]) {
    WitnessCostProjectionRefused { cause: c } =>
      string_contains(s: c, pattern: "non-concluded")
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn native_seed_events_preserve_order_outcome_and_perturbation_holds() -> Bool {
  let entry = sample_entry()
  let events: List<ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: millisecond(count: 100)),
    witness_cost_seed_refused_event(
      entry: entry,
      module_path: "test.claim.witness_row_cost_projection" as NonEmptyStr,
      function: "first_refused" as NonEmptyStr,
      eval: millisecond(count: 7),
      diagnostic: "typed refusal" as NonEmptyStr
    ),
    witness_cost_seed_failed_event(
      entry: entry,
      module_path: "test.claim.witness_row_cost_projection" as NonEmptyStr,
      function: "second_failed" as NonEmptyStr,
      eval: millisecond(count: 19),
      error: "runtime failure" as NonEmptyStr
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: "" as String, f: (acc, row) =>
        concat(acc, concat(row.declaration.decl_name, ":"))
      ) == "first_refused:second_failed:" &&
      fold(rows, init: 0, f: (acc, row) =>
        acc + millisecond_count(m: row.eval)
      ) == 26 &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Refused { diagnostic: d } => d == ("typed refusal" as NonEmptyStr)
          Done => false
          Failed { error: _, output: _ } => false
          TimedOut { budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Failed { error: e, output: _ } => e == ("runtime failure" as NonEmptyStr)
          Done => false
          Refused { diagnostic: _ } => false
          TimedOut { budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      string_contains(s: witness_cost_native_production_note, pattern: "sole semantic row input")
  }
}

test fn witness_row_cost_projection_holds() -> Bool {
  two_events_project_one_exact_tsv_row_holds() &&
  missing_parent_resolve_refuses_holds() &&
  multiple_parent_resolve_refuses_holds() &&
  resolve_wall_is_shared_not_divided_holds() &&
  refused_outcome_distinct_from_failed_in_projection_holds() &&
  w2_ambient_suppress_retains_complete_receipt_row_holds() &&
  malformed_nested_resolve_event_refuses_holds() &&
  typed_event_role_extract_classifies_entry_and_declaration_holds() &&
  rss_unavailable_carries_cause_on_modeled_events_holds() &&
  duplicate_declaration_identity_refuses_holds() &&
  non_concluded_timing_event_refuses_holds() &&
  native_seed_events_preserve_order_outcome_and_perturbation_holds()
}
