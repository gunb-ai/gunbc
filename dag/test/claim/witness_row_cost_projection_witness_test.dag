fn eval_with_no_wall_clock_refuses_rather_than_projecting_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "cpu_only_witness")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: [std.observation.TimedMeasurement { basis: CpuClock, elapsed: std.observation.MeasuredValue { value: witness_wall_ms(count: 3) } }],
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionComplete { rows: _ } => false
    WitnessCostProjectionRefused { cause: _ } => true
