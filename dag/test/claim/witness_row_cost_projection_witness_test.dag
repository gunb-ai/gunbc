module test.claim.witness_row_cost_projection


data witness_row_cost_projection_note: String = "Executing REDs for the #5 ObservationEvent join projection (N+1 per entry). (1) DeclarationSegment key/grain totality lives in observation_model_witness_test. (2) Two modeled events → one exact TSV row. (3) Missing or multiple parent resolve events REFUSE the row set. (4) W2 Ambient suppress does not delete the complete receipt row. (5) Declaration-/module-nested resolve phases do NOT count as the entry-level parent (collision RED — review 43409). Resolve wall is entry-level/shared — repeated as a column, never divided, never summed N times as a corpus total. Role classification is witness_cost_event_role (typed extract), not is_* Bool filters."

fn sample_decl(name: String) -> std.decl_ref.DeclarationRef {
  std.decl_ref.DeclarationRef {
    module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
    decl_name: name as std.types.NonEmptyStr,
    field: WholeDeclaration
  }
}

fn sample_entry() -> std.types.NonEmptyStr {
  "dag/test/claim/witness_row_cost_projection_witness_test.dag" as std.types.NonEmptyStr
}

fn witness_wall_ns(count: std.nat.Nat) -> std.measure.Nanosecond {
  millisecond_to_nanosecond(m: millisecond(count: count))
}

fn witness_wall_ms(count: std.nat.Nat) -> std.measure.Nanosecond {
  witness_wall_ns(count: count)
}

fn witness_eval_ms(count: std.nat.Nat) -> List<std.observation.TimedMeasurement> {
  observation_durations_wall(elapsed: witness_wall_ns(count: count))
}

fn witness_eval_ns(count: std.nat.Nat) -> List<std.observation.TimedMeasurement> {
  observation_durations_wall(elapsed: nanosecond(count: count))
}

fn witness_eval_cpu_and_wall(cpu_ms: std.nat.Nat, wall_ms: std.nat.Nat) -> List<std.observation.TimedMeasurement> {
  observation_durations_cpu_and_wall(
    cpu: witness_wall_ns(count: cpu_ms),
    wall: witness_wall_ns(count: wall_ms)
  )
}

fn witness_wall_ms_count(wall: std.measure.Nanosecond) -> std.nat.Nat {
  millisecond_count(m: nanosecond_to_millisecond_floor(n: wall))
}

fn row_clock_ns(row: gunbc.witness_row_cost.WitnessCostReceiptRow, basis: std.measure.ClockBasis) -> std.nat.Nat {
  match observation_duration_of(durations: row.eval, basis: basis) {
    MeasuredValue { value: v } => nanosecond_count(n: v)
    MeasuredUnavailable { cause: _ } => 0
  }
}

fn row_clock_is_unavailable(row: gunbc.witness_row_cost.WitnessCostReceiptRow, basis: std.measure.ClockBasis) -> Bool {
  match observation_duration_of(durations: row.eval, basis: basis) {
    MeasuredValue { value: _ } => false
    MeasuredUnavailable { cause: _ } => true
  }
}

fn row_wall_ms_count(row: gunbc.witness_row_cost.WitnessCostReceiptRow) -> std.nat.Nat {
  millisecond_count(m: nanosecond_to_millisecond_floor(n: nanosecond(count: row_clock_ns(row: row, basis: WallClock))))
}

fn two_events_project_one_exact_tsv_row_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "fast_witness")
  let resolve = witness_wall_ms(count: 100)
  let eval_wall = witness_wall_ms(count: 20)
  let eval = witness_eval_ms(count: 20)
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_cost_declaration_event(entry: entry, declaration: decl, eval: eval, outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: true, f: (acc, row) =>
        acc &&
        row.entry == entry &&
        row.declaration == decl &&
        row_wall_ms_count(row: row) == 20 &&
        witness_wall_ms_count(wall: row.resolve) == 100 &&
        witness_wall_ms_count(wall: row.warm) == 120 &&
        row.warm == witness_cost_warm(eval: eval_wall, resolve: resolve) &&
        match row.outcome {
          Done => true
          Refused { diagnostic: _ } => false
          Failed { error: _, output: _ } => false
          TimedOut { basis: _, budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn missing_parent_resolve_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "orphan_witness")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: witness_eval_ms(count: 20),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } =>
      c != ("silent" as std.types.NonEmptyStr)
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn multiple_parent_resolve_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "ambiguous_parent")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 200)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: witness_eval_ms(count: 20),
      outcome: Done
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: c } =>
      c == ("multiple parent resolve-phase events for an entry (refuse; never silently pick)" as std.types.NonEmptyStr)
    WitnessCostProjectionComplete { rows: _ } => false
  }
}

fn resolve_wall_is_shared_not_divided_holds() -> Bool {
  let entry = sample_entry()
  let d1 = test.claim.witness_row_cost_projection.sample_decl(name: "w1")
  let d2 = test.claim.witness_row_cost_projection.sample_decl(name: "w2")
  let resolve = witness_wall_ms(count: 100)
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_cost_declaration_event(entry: entry, declaration: d1, eval: witness_eval_ms(count: 10), outcome: Done),
    witness_cost_declaration_event(entry: entry, declaration: d2, eval: witness_eval_ms(count: 30), outcome: Done)
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: true, f: (acc, row) =>
        acc && witness_wall_ms_count(wall: row.resolve) == 100
      ) &&
      fold(rows, init: 0, f: (acc, row) => acc + witness_wall_ms_count(wall: row.resolve)) == 200 &&
      witness_wall_ms_count(wall: resolve) == 100
  }
}

fn refused_outcome_distinct_from_failed_in_projection_holds() -> Bool {
  let entry = sample_entry()
  let d_refused = test.claim.witness_row_cost_projection.sample_decl(name: "refused_w")
  let d_failed = test.claim.witness_row_cost_projection.sample_decl(name: "failed_w")
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 50)),
    witness_cost_declaration_event(
      entry: entry,
      declaration: d_refused,
      eval: witness_eval_ms(count: 5),
      outcome: Refused { diagnostic: "typed refuse" as std.types.NonEmptyStr }
    ),
    witness_cost_declaration_event(
      entry: entry,
      declaration: d_failed,
      eval: witness_eval_ms(count: 5),
      outcome: Failed { error: "boom" as std.types.NonEmptyStr, output: "" }
    )
  ]
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 2 &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Refused { diagnostic: d } => d == ("typed refuse" as std.types.NonEmptyStr)
          Failed { error: _, output: _ } => false
          Done => false
          TimedOut { basis: _, budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      ) &&
      fold(rows, init: false, f: (acc, row) =>
        acc || match row.outcome {
          Failed { error: e, output: _ } => e == ("boom" as std.types.NonEmptyStr)
          Refused { diagnostic: _ } => false
          Done => false
          TimedOut { basis: _, budget: _, elapsed: _ } => false
          Skipped { reason: _ } => false
          Final { shown_failures: _ } => false
        }
      )
  }
}

fn w2_ambient_suppress_retains_complete_receipt_row_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl(name: "ambient_w")
  let eval = witness_eval_ms(count: 5)
  let resolve = witness_wall_ms(count: 10)
  let witness_event = witness_cost_declaration_event(
    entry: entry,
    declaration: decl,
    eval: eval,
    outcome: Done
  )
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: resolve),
    witness_event
  ]
  let basis = std.observation.AttentionBasis {
    average: millisecond(count: 1000),
    maximum: millisecond(count: 5000)
  }
  observation_attention(event: witness_event, basis: basis) == Ambient &&
  ci_line_placement(attention: Ambient) == InsideCollapsedGroup &&
  ci_line_placement(attention: Ambient) != OutsideGroup &&
  match project_witness_cost_receipt(events: events) {
    WitnessCostProjectionRefused { cause: _ } => false
    WitnessCostProjectionComplete { rows: rows } =>
      count(rows) == 1 &&
      fold(rows, init: true, f: (acc, row) =>
        acc && row_wall_ms_count(row: row) == 5 &&
        witness_wall_ms_count(wall: row.resolve) == 10
      )
  }
}

fn rss_unavailable_carries_cause_on_modeled_events_holds() -> Bool {
  let e = witness_cost_entry_resolve_event(
    entry: sample_entry(),
    resolve: witness_wall_ms(count: 1)
  )
  match e.rss {
    MeasuredUnavailable { cause: c } => c == witness_cost_rss_unavailable_cause()
    MeasuredValue { value: _ } => false
  }
}

fn malformed_nested_resolve_event_refuses_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl("nested")
  let nested = witness_cost_nested_resolve_under_declaration_event(
    entry: entry,
    declaration: decl,
    resolve: witness_wall_ms(count: 999)
  )
  let module_resolve = witness_cost_module_resolve_event(
    entry: entry,
    module_path: "test.claim.witness_row_cost_projection" as std.types.NonEmptyStr,
    resolve: witness_wall_ms(count: 888)
  )
  let events: List<std.observation.ObservationEvent> = [
    witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 100)),
    nested,
    module_resolve,
    witness_cost_declaration_event(
      entry: entry,
      declaration: decl,
      eval: witness_eval_ms(count: 5),
      outcome: Done
    )
  ]
  match witness_cost_event_role(event: nested) {
    Present { value: _ } => false
    Absent =>
      match witness_cost_event_role(event: module_resolve) {
        Present { value: _ } => false
        Absent =>
          match project_witness_cost_receipt(events: events) {
            WitnessCostProjectionRefused { cause: c } =>
              string_contains(s: c, pattern: "malformed")
            WitnessCostProjectionComplete { rows: _ } => false
          }
      }
  }
}

fn typed_event_role_extract_classifies_entry_and_declaration_holds() -> Bool {
  let entry = sample_entry()
  let decl = test.claim.witness_row_cost_projection.sample_decl("role")
  let parent = witness_cost_entry_resolve_event(entry: entry, resolve: witness_wall_ms(count: 1))
  let child = witness_cost_declaration_event(
    entry: entry,
    declaration: decl,
    eval: witness_eval_ms(count: 2),
    outcome: Done
  )
  match witness_cost_event_role(event: parent) {
    Present { value: EntryResolveParent } =>
      match witness_cost_event_role(event: child) {
        Present { value: DeclarationWitness } =>
          string_contains(s: witness_cost_event_role_note, pattern: "review 43409") &&
          string_contains(s: witness_cost_event_role_note, pattern: "entry-level")
        Present { value: EntryResolveParent } => false
        Absent => false
      }
    Present { value: DeclarationWitness } => false
    Absent => false
  }
}

