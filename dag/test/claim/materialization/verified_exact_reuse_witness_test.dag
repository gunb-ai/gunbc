module test.claim.materialization.verified_exact_reuse_witness_test

import std.types { Bool, String, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.cutover_receipt {
  CutoverReceipt, CutoverReading, ReceiptUnrecorded, ReceiptRecorded,
  cutover_receipt_is_recorded, cutover_receipt_has_reading, cutover_receipt_names_runs,
  verified_exact_reuse_first_run_receipt
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ACCEPTANCE ORACLE FOR materialization-verified-exact-reuse-arm, RED BY DESIGN. PINNED AT LAUNCH.
// The arm itself lands as D15 in gunbc.plans.demand_engine_program; this oracle pins its first run.

// RED TODAY: the first pull-request run that printed VerifiedExactReuse is recorded with its
// producing receipt.
test fn a_pull_request_reuse_carries_its_producing_receipt() -> Bool {
  cutover_receipt_is_recorded(r: verified_exact_reuse_first_run_receipt)
    && cutover_receipt_has_reading(r: verified_exact_reuse_first_run_receipt, name: "producing_receipt")
    && cutover_receipt_has_reading(r: verified_exact_reuse_first_run_receipt, name: "request_key")
}

// CONTROL: a reuse with no producing receipt refuses.
test fn a_reuse_without_a_producing_receipt_refuses() -> Bool {
  !cutover_receipt_has_reading(r: ReceiptRecorded {
    run_ids: ["r"], host: "h", readings: [CutoverReading { name: "request_key", value: "k" }]
  }, name: "producing_receipt")
}

// CONTROL: a receipt recorded for another request key does not serve this one.
test fn a_receipt_for_another_request_key_refuses() -> Bool {
  fn_key_matches(recorded: "k1", requested: "k2") == false
}

// CONTROL: merge_group revisions never reuse; the arm is admitted for the pull_request event only.
test fn a_merge_group_revision_never_reuses() -> Bool {
  event_admits_reuse(event: "pull_request") && !event_admits_reuse(event: "merge_group")
}

fn fn_key_matches(recorded: String, requested: String) -> Bool {
  recorded == requested
}

fn event_admits_reuse(event: String) -> Bool {
  event == "pull_request"
}
