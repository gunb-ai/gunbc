module test.claim.approve_ios_enrolment_machine_witness

import std.logic { Bool }
import std.types { String, list_length }
import gunbc.approve_ios_enrolment_machine {
  EnrolmentPhase, PhaseSignedOut, PhaseEnrolled, PhaseRevoked,
  EnrolmentAnswer, AnswerSignedIn, AnswerRefused, AnswerUnanswered, AnswerServerReportsRevoked, NewKey, SameKey,
  enrolment_next, phase_name, enrolment_phases, enrolment_answers,
}

fn after(from: EnrolmentPhase, answer: EnrolmentAnswer) -> String {
  phase_name(p: enrolment_next(from: from, answer: answer)) as String
}

// The ruling, stated independently of the machine's own transition table.
test fn a_sign_in_enrols_a_signed_out_phone() -> Bool {
  after(from: PhaseSignedOut, answer: AnswerSignedIn { key: NewKey }) == "enrolled"
    && after(from: PhaseSignedOut, answer: AnswerSignedIn { key: SameKey }) == "enrolled"
}

test fn a_refusal_or_no_answer_leaves_a_signed_out_phone_signed_out() -> Bool {
  after(from: PhaseSignedOut, answer: AnswerRefused) == "signedOut"
    && after(from: PhaseSignedOut, answer: AnswerUnanswered) == "signedOut"
}

test fn the_server_reporting_revoked_revokes_an_enrolment() -> Bool {
  after(from: PhaseEnrolled, answer: AnswerServerReportsRevoked) == "revoked"
}

test fn only_a_new_key_leaves_revoked() -> Bool {
  after(from: PhaseRevoked, answer: AnswerSignedIn { key: NewKey }) == "enrolled"
    && after(from: PhaseRevoked, answer: AnswerSignedIn { key: SameKey }) == "revoked"
    && after(from: PhaseRevoked, answer: AnswerRefused) == "revoked"
    && after(from: PhaseRevoked, answer: AnswerUnanswered) == "revoked"
}

test fn a_failed_sign_in_does_not_undo_an_enrolment() -> Bool {
  after(from: PhaseEnrolled, answer: AnswerRefused) == "enrolled"
    && after(from: PhaseEnrolled, answer: AnswerUnanswered) == "enrolled"
}

// The product is closed at three phases and five answers; a new one owes this witness a ruling.
test fn the_machine_is_the_three_phase_product() -> Bool {
  list_length(items: enrolment_phases()) == 3 && list_length(items: enrolment_answers()) == 5
}
