data gated_env: NonEmptyStr = srv1_production_environment_name
data ungated_env: NonEmptyStr = "gcp-iam-converge"
data other_env: NonEmptyStr = "mtcollins1-boot"

// THE OTHER BOUNDARIES, AS WHOLE SUBJECTS (side chat, blocker 2). The forgery this design had to close
// was not "an environment name that differs"; it was a GENUINE pair of receipts, witnessed honestly on a
// different subject, unlocking THIS subject's reviewer removal. So the fixtures have to be whole
// boundaries rather than strings: the sibling lane's environment in this repository, and a fork that
// happens to have named its environment srv1-production. Both carry a real Repository, because a
// repository-less name is exactly the shape that let the forgery through.
data sibling_env: NonEmptyStr = "gcp-iam-bootstrap"

data sibling_boundary: DeploymentGateBoundary = DeploymentGateBoundary {
  repository: gunbc_repository,
  environment_name: sibling_env,
}

// SAME ENVIRONMENT NAME, DIFFERENT REPOSITORY. An environment is a per-repository object, so "it says
// srv1-production" is not evidence about THIS repository's srv1-production. This is the half the old
// signature could not even express, let alone refuse.
data fork_boundary: DeploymentGateBoundary = DeploymentGateBoundary {
  repository: Repository {
    owner: "gunb-ai",
    name: "someone-elses-fork",
    full_name: "gunb-ai/someone-elses-fork",
    private: false,
    default_branch: "main",
  },
  environment_name: srv1_production_environment_name,
}
data gate_run_id: GitHubWorkflowRunId = GitHubWorkflowRunId { value: 35447067113 }
// THE CARRIERS, imported rather than invented: an installation id and an app id are typed upstream,
// so the fixtures build the same types the model produces.
data gate_app_id: GitHubAppId = GitHubAppId { value: 1900000001 }
data gate_installation_id: GitHubAppInstallationId = GitHubAppInstallationId { value: 888800001 }
data other_app_id: GitHubAppId = GitHubAppId { value: 7777777 }
data other_installation_id: GitHubAppInstallationId = GitHubAppInstallationId { value: 777 }

// ---------------------------------------------------------------------------
// Fixtures: the three sources, kept genuinely separate
// ---------------------------------------------------------------------------

// What the WORKFLOW claims, filed by the earlier ungated job in the same run.
data gate_claim: GateRequestClaim = GateRequestClaim {
  run_id: GitHubWorkflowRunId { value: 35447067113 },
  environment: gated_env,
  escalation_id: "srv1-gate-35447067113",
  request_revision: "rev-1",
  attempt: "fleet-converge-35447067113" as AttemptIdentity,
}

// What the OPERATOR tapped, authenticated by the broker's MAC over escalation + revision + attempt.
fn gate_capability(decision: ProposedDecision) -> ApprovalCapability {
  ApprovalCapability {
    claims: ApprovalCapabilityClaims {
      protocol: "gunbc.approval-capability.v1",
      issuer: "gunbc.auth.approval_broker",
      audience: "gunbc.auth.approval_broker",
      authority: "gunbc.auth.scoped_authorization",
      escalation_id: "srv1-gate-35447067113",
      request_revision: "rev-1",
      decision: decision,
      attempt: "fleet-converge-35447067113" as AttemptIdentity,
      issued_at: "2026-10-18T09:01:00Z" as Timestamp,
      expires_at: "2026-10-18T09:11:00Z" as Timestamp,
      key_id: "broker-key-1" as MacKeyId,
    },
    tag_b64url: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  }
}

// THE OPERATOR'S CLAIM — a configuration value, deliberately ordinary so it can be typed here. It is
// the thing the readbacks are asked to corroborate, never the authority for anything: `mintable_installation_id`
// reads the token's source off the JOINED ownership, not off this record.
data fx_claim: GateInstallationClaim = GateInstallationClaim {
  installation_id: gate_installation_id,
  app_id: gate_app_id,
}

// A RESPONSE BODY as the wire reports it: every field present, so the parse succeeds. The refusals
// below hand it a body with one field missing and require the refusal to name that field.
fn fx_wire() -> InstallationWireFields {
  InstallationWireFields {
    id: Present { value: 888800001 },
    app_id: Present { value: 1900000001 },
    app_slug: Present { value: "gunbc-deployment-gate" },
  }
}

// THE OBSERVED IDENTITY, minted by the only producer — the installation readback route. It is admitted
// to this witness because the witness carries a real response; a FOREIGN module is refused the call
// entirely, which is the red the probe enrols.
fn fx_observed_installation() -> ObservedGateInstallation?
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "observe_rule_ownership_for"
    ),
  ]
{
  match observe_gate_installation(
    owner: "gunb-ai",
    repo: "gunbc",
    status: installation_readback_success_status,
    wire: fx_wire(),
    claim: fx_claim,
  ) {
    InstallationObserved { observed: o } => Present { value: o }
    InstallationObservationRefused { because: _ } => none
  }
}

// THE OBSERVATION PROBE: the only admitted call to the identity route besides fx_observed_installation.
// Every argument passes through untouched, so a test can hand the route a body with a field missing, a
// 404, a 500, or a claim that disagrees with what GitHub read — and read the route's OWN refusal back.
fn fx_observation_probe(
  status: HttpStatus,
  wire: InstallationWireFields,
  claim: GateInstallationClaim
) -> InstallationObservation
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "a_readback_whose_app_is_not_the_claimed_app_is_refused_on_the_app_axis"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "the_identity_readback_refuses_by_name_and_by_status"
    ),
  ]
{
  observe_gate_installation(
    owner: "gunb-ai",
    repo: "gunbc",
    status: status,
    wire: wire,
    claim: claim,
  )
}

// THE IDENTITY ROUTE REFUSES THE THREE WAYS THAT ARE DIFFERENT OPERATOR ACTIONS, which is the whole
// point of having a reason sum here instead of a Bool. A malformed body, a repository with no
// installation, and a read that did not answer are three different problems; collapsing them (an earlier
// revision sent every non-200 to NoInstallationForThisRepository, so a GitHub 500 told the operator to
// re-install a working App) is what these tests keep apart.
// THE OTHER AXIS, WHICH NEEDS ITS OWN CASE. The refusal above varies the INSTALLATION and leaves the
// app matching, so a model that lost the app check entirely (replace `identity.app_id.value !=
// claim.app_id.value` with `false`) stays green here — and it is not green here by accident of the
// fixture: fx_wire and fx_claim agree on the app id, so this file never fed the route a disagreeing app
// until now. An App id that is wrong is not a smaller mistake than an installation id that is wrong: the
// token would be minted for a DIFFERENT GitHub App, one that may hold permissions this gate never
// granted. Both ids come back, because "which of my two numbers is stale" is the operator's question.
test fn a_readback_whose_app_is_not_the_claimed_app_is_refused_on_the_app_axis() -> Bool {
  // installation id MATCHES the claim; only the App id disagrees.
  (match fx_observation_probe(
         status: installation_readback_success_status,
         wire: InstallationWireFields {
           id: Present { value: 888800001 },
           app_id: Present { value: 7777777 },
           app_slug: Present { value: "gunbc-deployment-gate" },
         },
         claim: fx_claim,
       ) {
         InstallationObservationRefused {
           because: ClaimDisagreesOnApp { claimed_app_id: claimed_app, observed_app_id: seen_app },
         } => claimed_app.value == 1900000001 && seen_app.value == 7777777
         InstallationObservationRefused { because: _ } => false
         InstallationObserved { observed: _ } => false
       })
    // AND IT IS NOT REPORTED AS THE INSTALLATION REFUSAL. Two arms, two axes: a model that answers the
    // app disagreement with the installation variant has thrown away which axis disagreed, which is the
    // defect this pair of cases exists to keep visible.
    && (match fx_observation_probe(
          status: installation_readback_success_status,
          wire: InstallationWireFields {
            id: Present { value: 888800001 },
            app_id: Present { value: 7777777 },
            app_slug: Present { value: "gunbc-deployment-gate" },
          },
          claim: fx_claim,
        ) {
          InstallationObservationRefused {
            because: ClaimDisagreesOnInstallation {
              claimed_installation_id: _,
              observed_installation_id: _,
            },
          } => false
          InstallationObservationRefused { because: _ } => true
          InstallationObserved { observed: _ } => false
        })
    // THE CONTROL: the same read with both axes agreeing is observed. Without it the two refusals above
    // could be a route that refuses everything.
    && (match fx_observation_probe(
          status: installation_readback_success_status,
          wire: fx_wire(),
          claim: fx_claim,
        ) {
          InstallationObserved { observed: o } => o.installation_id.value == 888800001
            && o.app_id.value == 1900000001
          InstallationObservationRefused { because: _ } => false
        })
}

test fn the_identity_readback_refuses_by_name_and_by_status() -> Bool {
  // 1. A 200 whose body is missing app_slug refuses with the FIELD NAME — no default is filled in for a
  // required upstream field (§5, loud typed refusal), and the pin makes it required.
  (match fx_observation_probe(
         status: installation_readback_success_status,
         wire: InstallationWireFields {
           id: Present { value: 888800001 },
           app_id: Present { value: 1900000001 },
           app_slug: Absent,
         },
         claim: fx_claim,
       ) {
         InstallationObservationRefused {
           because: WireIncomplete { missing_field: f },
         } => f == installation_field_app_slug
         _ => false
       })
    // 2. A 404 is GitHub saying this repository has no installation. That is the ONLY refusal whose
    // remedy is an install, which is why the 500 below may not share its name.
    && (match fx_observation_probe(
          status: 404,
          wire: fx_wire(),
          claim: fx_claim,
        ) {
          InstallationObservationRefused { because: NoInstallationForThisRepository } => true
          _ => false
        })
    // 3. A 500 is a read that did not answer, carrying the status GitHub actually sent.
    && (match fx_observation_probe(
          status: 500,
          wire: fx_wire(),
          claim: fx_claim,
        ) {
          InstallationObservationRefused { because: ReadbackDidNotAnswer { status: got } } =>
            got == 500
          _ => false
        })
    // 4. THE CLAIM DISAGREES WITH THE READ. GitHub named a different installation than the operator
    // recorded: the token would be minted from an identity nobody approved, so the read wins and the
    // refusal carries BOTH ids for the operator to compare.
    && (match fx_observation_probe(
          status: installation_readback_success_status,
          wire: fx_wire(),
          claim: GateInstallationClaim { installation_id: other_installation_id, app_id: gate_app_id },
        ) {
          InstallationObservationRefused {
            because: ClaimDisagreesOnInstallation {
              claimed_installation_id: claimed_id,
              observed_installation_id: seen_id,
            },
          } => claimed_id.value == 777 && seen_id.value == 888800001
          _ => false
        })
    // 5. The honest read still succeeds — the control that keeps the four refusals above from passing
    // because the route stopped answering altogether.
    && (match fx_observation_probe(
          status: installation_readback_success_status,
          wire: fx_wire(),
          claim: fx_claim,
        ) {
          InstallationObserved { observed: o } =>
            o.installation_id.value == 888800001
              && o.app_id.value == gate_app_id.value
              && (o.app_slug as String) == "gunbc-deployment-gate"
              && (o.owner as String) == "gunb-ai"
              && (o.repo as String) == "gunbc"
          _ => false
        })
}

// THE RULE READBACK, passed straight to the join so the tests can vary the rows. This is the ONLY way
// any test here obtains an ownership: there is no literal for the owned arm, because its payload is a
// sealed record that only this fold produces.
fn observe_rule_ownership_for(
  rules: List<EnabledDeploymentProtectionRule>,
  environment_name: NonEmptyStr
) -> EnvironmentRuleOwnership
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "an_unestablished_or_mismatched_ownership_never_answers"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "minted_ownership"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "ownership_is_minted_only_from_an_enabled_rule_attributed_to_this_app"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_authorization_witness",
      decl_name: "the_ownership_reason_the_readback_gave_is_the_reason_the_broker_reports"
    ),
  ]
{
  match fx_observed_installation() {
    Present { value: observed } =>
      observe_rule_ownership(
        rules: rules, environment_name: environment_name, observed: observed
      )
    none => NotOwnedByGateApp { because: ReadbackCarriedNoRules }
  }
}

// What a READBACK minted: an enabled rule on the gated environment, attributed to the gate App.
