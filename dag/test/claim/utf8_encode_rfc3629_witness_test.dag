module test.claim.utf8_encode_rfc3629_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.error_primitives { Result, Ok, Err }
import std.encoding {
  Utf8SurrogateRefused, Utf8OutOfRangeRefused,
  utf8_encode_code_point, utf8_encode_octets,
}
import std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RFC 3629 §3 encodes a scalar in one to four octets by its range. One scalar per length class,
// each at a value whose octets are published in the RFC's own §7 examples or are the class
// boundary, and expected octets written from the §3 table -- not read back from std.encoding.

// U+0041 'A' → 41 (one octet; ASCII is its own encoding).
test fn one_octet_class_holds() -> Bool {
  utf8_encode_code_point(cp: 65) == Ok { value: [65] }
}

// U+00E9 'é' → C3 A9 (two octets).
test fn two_octet_class_holds() -> Bool {
  utf8_encode_code_point(cp: 233) == Ok { value: [195, 169] }
}

// U+20AC '€' → E2 82 AC (three octets).
test fn three_octet_class_holds() -> Bool {
  utf8_encode_code_point(cp: 8364) == Ok { value: [226, 130, 172] }
}

// U+1F600 → F0 9F 98 80 (four octets).
test fn four_octet_class_holds() -> Bool {
  utf8_encode_code_point(cp: 128512) == Ok { value: [240, 159, 152, 128] }
}

// Class boundaries: the last of each class stays in it. 0x7F, 0x7FF, 0xFFFF, 0x10FFFF.
test fn class_boundaries_hold() -> Bool {
  utf8_encode_code_point(cp: 127) == Ok { value: [127] }
    && utf8_encode_code_point(cp: 2047) == Ok { value: [223, 191] }
    && utf8_encode_code_point(cp: 65535) == Ok { value: [239, 191, 191] }
    && utf8_encode_code_point(cp: 1114111) == Ok { value: [244, 143, 191, 191] }
}

// Surrogates have no UTF-8 encoding (RFC 3629 §3); above U+10FFFF is not a scalar at all.
test fn surrogates_and_out_of_range_refuse() -> Bool {
  match utf8_encode_code_point(cp: 55296) {
    Err { value: Utf8SurrogateRefused { cp: c } } => c == 55296
    _ => false
  }
  && match utf8_encode_code_point(cp: 1114112) {
    Err { value: Utf8OutOfRangeRefused { cp: c } } => c == 1114112
    _ => false
  }
}

// THE STRING ROUTE, the one extdeps.crypto.mac consumes: a String's scalars, in order, each encoded.
test fn a_mixed_string_encodes_in_order() -> Bool {
  utf8_encode_octets(s: "Aé€") == Ok { value: [65, 195, 169, 226, 130, 172] }
}
