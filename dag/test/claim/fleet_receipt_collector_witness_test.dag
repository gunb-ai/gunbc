module test.claim.fleet_receipt_collector_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Join 5 (operator verdict): the collector's parse is the BACKWARD read of the same
// byte-locked line the CLI renders forward — a rendered receipt round-trips to an equal
// receipt, and the three refusal shapes (wrong prefix, missing field, unknown verdict
// label) all refuse rather than guessing a verdict.
test fn witness_receipt_line_round_trips_and_refuses_malformed() -> Bool {
  let r = ConvergeCliReceipt { host: "srv2", applied: 3, drifted: 1, verdict: VerdictConverged, reason: none }
  match parse_converge_receipt_line(line: converge_cli_receipt_line(r: r)) {
    Present { value: back } =>
      back.host == "srv2"
        && back.applied == 3
        && back.drifted == 1
        && converge_cli_receipt_converged(r: back)
    Absent => false
  }
    && match parse_converge_receipt_line(line: "not-a-receipt host=srv2 applied=0 drifted=0 verdict=converged") {
      Present { value: _ } => false
      Absent => true
    }
    && match parse_converge_receipt_line(line: "converge-receipt host=srv2 applied=0 drifted=0 verdict=plausible") {
      Present { value: _ } => false
      Absent => true
    }
    && match parse_converge_receipt_line(line: "converge-receipt host=srv2 verdict=converged") {
      Present { value: _ } => false
      Absent => true
    }
}

// A parsed non-converged label stays non-converged (drifted/absent never launder into
// converged through the round trip).
test fn witness_parse_preserves_non_converged_verdicts() -> Bool {
  match parse_converge_receipt_line(line: "converge-receipt host=srv1 applied=0 drifted=2 verdict=drifted") {
    Present { value: r } =>
      !converge_cli_receipt_converged(r: r)
        && r.drifted == 2
        && converge_verdict_label(v: r.verdict) == "drifted"
    Absent => false
  }
    && match parse_converge_receipt_line(line: "converge-receipt host=srv1 applied=0 drifted=0 verdict=absent") {
      Present { value: r } =>
        !converge_cli_receipt_converged(r: r) && converge_verdict_label(v: r.verdict) == "absent"
      Absent => false
    }
    && match parse_converge_receipt_line(line: "converge-receipt host=srv1 applied=x drifted=0 verdict=converged") {
      Present { value: _ } => false
      Absent => true
    }
}

// Only Collected rows reach the fold: Absent and Unparseable are typed evidence that
// keep the host knob-unobserved, never silently dropped INTO the fold as data and never
// widened into a fabricated receipt.
test fn witness_only_collected_rows_enter_the_fold_registry() -> Bool {
  let collected = [
    ReceiptCollected {
      host: "srv1",
      receipt: ConvergeCliReceipt { host: "srv1", applied: 1, drifted: 0, verdict: VerdictConverged, reason: none },
    },
    ReceiptAbsent { host: "srv2", cause: "No such file or directory" },
    ReceiptUnparseable { host: "srv3", line: "converge-receipt host=srv3 verdict=???" },
  ]
  let rows = collected_receipts_only(collected: collected)
  length(rows) == 1
    && match rows.first() {
      Present { value: r } => r.host == "srv1"
      Absent => false
    }
    && string_contains(s: collected_line(c: ReceiptAbsent { host: "srv2", cause: "x" }), pattern: "outcome=absent")
    && string_contains(
      s: collected_line(c: ReceiptUnparseable { host: "srv3", line: "y" }),
      pattern: "outcome=unparseable"
    )
}

// The composed fold over a collector-shaped registry: one collected-converged receipt
// alone still yields FleetNotConverged (unobserved cells and knob-unobserved hosts
// block), pinning that the collector cannot manufacture fleet convergence from partial
// collection — the leg-f hermetic RED at the collector seam.
test fn witness_partial_collection_never_yields_fleet_converged() -> Bool {
  let rows = collected_receipts_only(collected: [
    ReceiptCollected {
      host: "srv1",
      receipt: ConvergeCliReceipt { host: "srv1", applied: 1, drifted: 0, verdict: VerdictConverged, reason: none },
    },
  ])
  match fleet_convergence_verdict(enrollments: fleet_subsumption_enrollments, receipts: rows) {
    FleetConverged { host_count: _ } => false
    FleetNotConverged { standings: s } => length(s) > 0
  }
}
