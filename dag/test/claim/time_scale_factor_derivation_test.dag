module test.claim.time_scale_factor_derivation

import std.logic { Bool }
import std.nat { Nat }
import std.measure { Scale, One, Sixty, time_scale_factor_seconds }

fn factor_is(s: Scale, expected: Nat) -> Bool {
  match time_scale_factor_seconds(s: s) {
    Present { value: n } => n == expected
    Absent => false
  }
}

test fn time_scale_factors_derive_correctly() -> Bool {
  factor_is(s: One, expected: 1)
    && factor_is(s: Sixty, expected: 60)
}
