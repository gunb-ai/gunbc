module test.claim.time_scale_factor_derivation


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn factor_is(s: Scale, expected: std.nat.Nat) -> Bool {
  match time_scale_factor_seconds(s: s) {
    Present { value: n } => n == expected
    Absent => false
  }
}

test fn time_scale_factors_derive_correctly() -> Bool {
  factor_is(s: One, expected: 1)
    && factor_is(s: Sixty, expected: 60)
}

test fn scale_exponent_refuses_sixty() -> Bool {
  match scale_exponent(s: Sixty) {
    Present { value: _ } => false
    Absent => true
  }
}
