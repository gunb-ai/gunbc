  served_surface_audience_observable_map,
}

fn observed_chrome_fixture(
  empty_replaced: Bool,
  body_replaced: Bool,
) -> BrowserPresentationProfile {
  match google_chrome_error_presentation {
    BrowserPresentationObserved { browser_build: _, http_error: _, receipt } =>
      BrowserPresentationObserved {
        browser_build: BrowserRelease {
          product: GoogleChrome,
          exact_version: "fixture-1" as NonEmptyStr,
        },
        http_error: BrowserHttpErrorPresentationPair {
          empty_body: if empty_replaced {
            BrowserReplacesHttpErrorResponse
          } else {
            BrowserRendersHttpErrorResponse
          },
          nonempty_body: if body_replaced {
            BrowserReplacesHttpErrorResponse
          } else {
            BrowserRendersHttpErrorResponse
          },
        },
        receipt: receipt,
      }
    BrowserPresentationUnobserved { product, reason } =>
      BrowserPresentationUnobserved { product: product, reason: reason }
  }
}

test fn witness_seven_hops_remain_seven_rows() -> Bool {
  count(served_surface_audience_observable_map(browser: google_chrome_error_presentation)) == 7
    && count(served_surface_audience_observable_map(browser: mozilla_firefox_error_presentation)) == 7
    && count(served_surface_audience_observable_map(browser: apple_safari_error_presentation)) == 7
}

test fn witness_executed_chrome_receipt_drives_production_cells() -> Bool {
  audience_observable(
    state: GunbcServeCompileWindow,
    browser: google_chrome_error_presentation,
  ) == BrowserOwned
    && audience_observable(
      state: GunbcServeApplication500 { body: "typed" as NonEmptyStr },
      browser: google_chrome_error_presentation,
    ) == BodyOwned { surface: GunbcTypedErrorBody }
}

test fn witness_wire_observables_do_not_collapse() -> Bool {
  let dns = served_surface_wire_observable(
    state: DnsTailnetFailure { failure: NameResolutionRefused })
  let tls = served_surface_wire_observable(state: TlsCertificateFailure)
  let proxy_down = served_surface_wire_observable(
    state: TailscaleServeProxyFailure { failure: ConnectionRefused })
  let process_down = served_surface_wire_observable(
    state: GunbcServeProcessFailure { absence: GunbcServeCrashed })
  let compiling = served_surface_wire_observable(state: GunbcServeCompileWindow)
  let app = served_surface_wire_observable(
    state: GunbcServeApplication500 { body: "typed failure" as NonEmptyStr })
  let poll = served_surface_wire_observable(
    state: ServedSurfaceClientPollingFailure { failure: ClientPollNetworkFailure })
  match dns {
    NoHttpResponse { failure: NameResolutionRefused } => match tls {
      TlsHandshakeRefused => match proxy_down {
        NoHttpResponse { failure: ConnectionRefused } => match process_down {
          ProxyGeneratedBodyless502 => match compiling {
            ProxyGeneratedBodyless502 => match app {
              GunbcTyped500Response { body } => body == "typed failure" && match poll {
                LoadedDocumentPollingRefused { failure: ClientPollNetworkFailure } => true
                _ => false
              }
              _ => false
            }
            _ => false
          }
          _ => false
        }
        _ => false
      }
      _ => false
    }
    _ => false
  }
}

test fn witness_observed_browser_pair_discriminates_ownership() -> Bool {
  let profile = observed_chrome_fixture(empty_replaced: true, body_replaced: false)
  let bodyless = audience_observable(state: GunbcServeCompileWindow, browser: profile)
  let bodied = audience_observable(
    state: GunbcServeApplication500 { body: "typed" as NonEmptyStr },
    browser: profile)
  let polling = audience_observable(
    state: ServedSurfaceClientPollingFailure { failure: ClientPollNetworkFailure },
    browser: profile)
  bodyless == BrowserOwned
    && bodied == BodyOwned { surface: GunbcTypedErrorBody }
    && polling == BodyOwned { surface: GunbcClientPollingRefusalSurface }
}

test fn witness_rendered_empty_response_is_proxy_fabricated() -> Bool {
  let profile = observed_chrome_fixture(empty_replaced: false, body_replaced: false)
  let observable = audience_observable(state: GunbcServeCompileWindow, browser: profile)
  observable == ProxyFabricated
    && audience_observable_fix_ceiling(
      state: GunbcServeCompileWindow,
      observable: observable) == ProxyResponseConstructionRequired
}

test fn witness_browser_owned_compile_window_names_blue_green_mover() -> Bool {
  audience_observable_fix_ceiling(
    state: GunbcServeCompileWindow,
    observable: BrowserOwned,
  ) == ConstructionMoveRequired { mover: BlueGreenServeFlipLane }
}

test fn witness_body_owned_cell_has_body_change_ceiling() -> Bool {
  audience_observable_fix_ceiling(
    state: GunbcServeApplication500 { body: "typed" as NonEmptyStr },
    observable: BodyOwned { surface: GunbcTypedErrorBody },
  ) == BodyPresentationChangeAvailable { surface: GunbcTypedErrorBody }
}

test fn witness_unobserved_browser_never_fabricates_presentation() -> Bool {
  let profile = BrowserPresentationUnobserved {
    product: MozillaFirefox,
    reason: "not executed" as NonEmptyStr,
  }
  let observable = audience_observable(state: GunbcServeCompileWindow, browser: profile)
  match observable {
    AudienceObservableUnobserved { browser: MozillaFirefox, reason } =>
      reason == "not executed" && match audience_observable_fix_ceiling(
        state: GunbcServeCompileWindow,
        observable: observable,
      ) {
        BrowserObservationRequired { browser: MozillaFirefox, reason: r2 } => r2 == reason
        _ => false
      }
    _ => false
  }
}

test fn witness_execution_receipt_retains_full_specimens() -> Bool {
  match google_chrome_error_presentation {
    BrowserPresentationObserved { browser_build: _, http_error: _, receipt } =>
      receipt.connection_refused.requested_url == "http://127.0.0.1:43822/refused"
        && receipt.connection_refused.browser_build.exact_version == "151.0.7922.34"
        && receipt.connection_refused.http_status == NoHttpResponseStatus
        && count(receipt.connection_refused.response_headers) == 0
        && receipt.connection_refused.response_body_bytes == EmptyResponseBodyBytes
        && receipt.connection_refused.navigation_result == NavigationRejected {
          error: "net::ERR_CONNECTION_REFUSED" as NonEmptyStr,
        }
        && receipt.connection_refused.dom_ownership == BrowserErrorDocumentOwned
        && receipt.connection_refused.screenshot.sha256 ==
          "637bf51bb5163ec58e6f325d1ed304bfa3618940ac75cb493ddd81d4895b29d3"
        && receipt.connection_refused.recovery_behavior == RecoveryVisibleAfterExplicitReload
        && receipt.connection_refused.reload_requirement == ExplicitReloadRequired
        && receipt.empty_response.requested_url == "http://127.0.0.1:43821/empty"
        && receipt.empty_response.browser_build.exact_version == "151.0.7922.34"
        && receipt.empty_response.http_status == HttpResponseStatus { status: 502 }
        && count(receipt.empty_response.response_headers) == 2
        && receipt.empty_response.response_body_bytes == EmptyResponseBodyBytes
        && receipt.empty_response.navigation_result == NavigationRejected {
          error: "net::ERR_HTTP_RESPONSE_CODE_FAILURE" as NonEmptyStr,
        }
        && receipt.empty_response.dom_ownership == BrowserErrorDocumentOwned
        && receipt.empty_response.screenshot.sha256 ==
          "f8a0b51701f18c0ff3ea22825103e5016fe68e69c7eca1190ed8162c05df22c6"
        && receipt.empty_response.recovery_behavior == RecoveryVisibleAfterExplicitReload
        && receipt.empty_response.reload_requirement == ExplicitReloadRequired
        && receipt.nonempty_response.requested_url == "http://127.0.0.1:43821/body"
        && receipt.nonempty_response.browser_build.exact_version == "151.0.7922.34"
        && receipt.nonempty_response.http_status == HttpResponseStatus { status: 502 }
        && count(receipt.nonempty_response.response_headers) == 3
        && receipt.nonempty_response.response_body_bytes == Utf8ResponseBodyBytes {
          body: "GUNBC_TYPED_ERROR_SENTINEL" as NonEmptyStr,
          byte_count: 26,
        }
        && receipt.nonempty_response.navigation_result == NavigationReturnedResponse { status: 502 }
        && receipt.nonempty_response.dom_ownership == HttpResponseDocumentOwned
        && receipt.nonempty_response.screenshot.sha256 ==
          "165dea20b5ecdaa9a864ff11c3924e9e6d3bbd956fa94f6b7827d948acc5bf71"
        && receipt.nonempty_response.recovery_behavior == RecoveryVisibleAfterExplicitReload
        && receipt.nonempty_response.reload_requirement == ExplicitReloadRequired
    BrowserPresentationUnobserved { product: _, reason: _ } => false
  }
}

test fn witness_matrix_retains_wire_interpretation_and_surface() -> Bool {
  let row = served_surface_audience_observable_row(
    failure: GunbcServeCompileWindow,
    browser: google_chrome_error_presentation)
  row.wire == ProxyGeneratedBodyless502
    && match row.browser_interpretation {
      BrowserHttpErrorInterpretation { body_class: _, read: _ } => true
      _ => false
    }
    && row.observable == BrowserOwned
}

test fn witness_continuity_boundary_stops_at_failed_domains() -> Bool {
  served_surface_continuity_boundary(
    state: DnsTailnetFailure { failure: Srv1HostDown },
  ) == RequiresAnotherFailureDomain { domain: Srv1HostFailureDomain }
    && served_surface_continuity_boundary(
      state: TailscaleServeProxyFailure { failure: ConnectionRefused },
    ) == RequiresAnotherFailureDomain { domain: TailscaledFailureDomain }
    && served_surface_continuity_boundary(
      state: TlsCertificateFailure,
    ) == RequiresAnotherFailureDomain { domain: TailnetDnsTlsFailureDomain }
    && served_surface_continuity_boundary(
      state: GunbcServeProcessFailure { absence: GunbcServeCrashed },
    ) == OwnedSurfaceGuarantee { guarantees: [DashboardProcessRestartContinuity] }
    && served_surface_continuity_boundary(
      state: GunbcServeCompileWindow,
    ) == OwnedSurfaceGuarantee {
      guarantees: [CandidateStartupContinuity, PlannedDeployContinuity],
    }
    && served_surface_continuity_boundary(
      state: GunbcServeApplication500 { body: "typed" as NonEmptyStr },
    ) == OwnedSurfaceGuarantee { guarantees: [TypedBackendRefusalContinuity] }
    && served_surface_continuity_boundary(
      state: ServedSurfaceClientPollingFailure { failure: ClientPollNetworkFailure },
    ) == OwnedSurfaceGuarantee { guarantees: [DynamicObserverUnavailableContinuity] }
}
