      ) {
        InspectedLegAxisMismatch => true
        InspectedLegBound { jobs_name_join } => false
        InspectedLegNameMismatch => false
        InspectedLegUninspected { cause } => false
      }
  same_values_wrong_axis
    && match candidate_run_identity(c: candidate_pdns_axis_name_mismatch_control) {
      RunIdentityMismatched { cause } => match baseline_admission(c: candidate_pdns_axis_name_mismatch_control) {
        BaselineRefused { cause } => true
        BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
      }
      ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } => false
      WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } => false
      RunIdentityUnresolved { cause } => false
    }
}

