        BaselineRefused { cause } => true
        BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
      }
      ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector } => false
      WorkflowBlobEquivalent { repository, inspected_commit, observed_head, workflow_path, workflow_blob_sha, job_key, matrix_selector } => false
      RunIdentityUnresolved { cause } => false
    }
}

test fn witness_a_green_job_without_tests_is_not_a_baseline() -> Bool {
  match candidate_openobserve_arm_build.observed {
    JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } => match correctness {
      NoTestsExecuted { note } => match baseline_admission(c: candidate_openobserve_arm_build) {
        BaselineRefused { cause } => true
        BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
      }
      TestsExecuted { step } => false
    }
    NoRunObserved { obligation } => false
  }
}

test fn witness_matrix_name_rendering_stays_an_uncited_bet() -> Bool {
  match workflow_job_name_matrix_parenthetical_standing {
    TranscribedUncited { read_obligation } => true
    CitedToAuthority { authority } => false
  }
}

fn all_claims_hold() -> Bool {
  witness_x64_catalog_label_is_never_arm_evidence()
    && witness_an_unresolved_label_is_not_reported_as_x64()
    && witness_selected_population_is_three_complementary_jobs()
    && witness_rejected_and_unresolved_remain_visible()
    && witness_every_row_is_job_scoped_and_versioned()
    && witness_biome_baseline_is_admitted_and_openobserve_is_not()
    && witness_pdns_declared_architecture_stays_unresolved_while_observed_is_arm()
    && witness_declared_and_observed_providers_are_separate_readings()
    && witness_openobserve_amd64_is_catalog_x64_and_rejected()
    && witness_observed_labels_and_attempt_are_read_from_the_job_resource()
    && witness_unobserved_cache_is_never_warm()
    && witness_effect_disposition_is_derived_from_kind()
    && witness_admitted_same_revision_and_blob_equivalent_hold()
    && witness_blob_mismatch_is_refused_even_when_tests_ran()
    && witness_matrix_selector_mismatch_is_refused_when_display_name_matches()
    && witness_job_key_mismatch_is_refused_when_display_name_and_matrix_match()
    && witness_uninspected_yaml_job_name_is_not_defaulted_to_job_key()
    && witness_multiple_labels_are_not_resolved_from_the_first()
    && witness_a_green_job_without_tests_is_not_a_baseline()
    && witness_matrix_name_rendering_stays_an_uncited_bet()
}

fn public_workload_census_witness_main() -> ProcessExit {
  if all_claims_hold() {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "one or more public workload census claims did not hold" }
  }
}
