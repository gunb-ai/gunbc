  let same_values_wrong_axis =
    (candidate_pdns_axis_name_mismatch_control.job_key as String)
      == (candidate_pdns_dnsdist_arm.job_key as String)
      && candidate_pdns_axis_name_mismatch_control.matrix_selector
        != candidate_pdns_dnsdist_arm.matrix_selector
      && match inspected_leg_binding(
        job_name: "build dnsdist (asan+ubsan, full, -arm)",
        job_key: candidate_pdns_axis_name_mismatch_control.job_key,
        matrix: candidate_pdns_axis_name_mismatch_control.matrix_selector,
