test fn witness_plural_yaml_job_name_rows_are_uninspected() -> Bool {
  let fixture_plural = match inspected_yaml_job_name_join(
    rows: yaml_dup_name_fixture,
    repository: "biomejs/biome",
    workflow_path: ".github/workflows/main.yml",
    job_key: "yaml-dup",
  ) {
    YamlJobNameUninspected { cause } =>
      (cause as String) == "multiple inspected YAML job-name rows for this repository, workflow path, and job_key"
    YamlJobNameBound { prefix } => false
  }
  let production_has_no_phantom = match inspected_yaml_job_name_join(
    rows: inspected_yaml_job_names,
    repository: "biomejs/biome",
    workflow_path: ".github/workflows/main.yml",
    job_key: "yaml-dup",
  ) {
    YamlJobNameUninspected { cause } =>
      (cause as String) == "no inspected YAML job-name row for this repository, workflow path, and job_key"
    YamlJobNameBound { prefix } => false
  }
  fixture_plural && production_has_no_phantom
}

