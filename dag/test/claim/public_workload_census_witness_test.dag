  JobRunObserved, TestsExecuted, ReplayAdmitted, SpendUnobserved,
  ResourceRequirementsObserved,
  replay_derivation_note, spend_unobserved_note, trial_authorization_from_census,
  DeclaredProviderKnown, DeclaredProviderUnresolved,
  candidate_declared_architecture, candidate_observed_architecture,
  candidate_declared_provider, candidate_observed_provider,
  candidate_warm_cache_count,
  effect_disposition, CoverageUpload, WorkflowArtifactUpload,
  RemovedFromBothRealizations, RetainedAndTimed,
  workload_census, selected_workloads, correctness_admitted_workloads,
  rejected_candidates, unresolved_candidates, census_contains_subject,
  observed_run_is_the_inspected_workload,
  candidate_biome_test, candidate_pdns_dnsdist_arm, candidate_openobserve_arm_build,
  candidate_openobserve_amd64, candidate_openobserve_manifest,
  candidate_biome_test_windows, candidate_biome_test_macos, candidate_openobserve_summary,
}

