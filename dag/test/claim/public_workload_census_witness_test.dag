fn catalog_not_arm(label: String, observed_at: Rfc3339Timestamp) -> Bool {
  match arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at)) {
    NotArmConfirmed { label, architecture, snapshot } => architecture == X86_64
    ArmConfirmed { label, snapshot } => false
    ArmUndetermined { label, cause } => false
  }
}

fn catalog_is_arm(label: String, observed_at: Rfc3339Timestamp) -> Bool {
  match arm_standing(r: resolve_runner_label(label: label, observed_at: observed_at)) {
    ArmConfirmed { label, snapshot } => true
    NotArmConfirmed { label, architecture, snapshot } => false
    ArmUndetermined { label, cause } => false
  }
}

test fn witness_x64_catalog_label_is_never_arm_evidence() -> Bool {
  catalog_not_arm(label: "ubicloud-standard-8", observed_at: "2026-09-01T10:02:15Z")
    && catalog_not_arm(label: "ubicloud-standard-16", observed_at: "2026-09-01T10:02:15Z")
    && catalog_not_arm(label: "depot-ubuntu-24.04-16", observed_at: "2026-09-04T16:03:32Z")
    && catalog_not_arm(label: "ubuntu-24.04", observed_at: "2026-09-04T09:57:28Z")
    && catalog_is_arm(label: "ubicloud-standard-16-arm", observed_at: "2026-09-01T10:02:21Z")
    && catalog_is_arm(label: "depot-ubuntu-24.04-arm-16", observed_at: "2026-09-04T16:03:32Z")
    && catalog_is_arm(label: "ubuntu-24.04-arm", observed_at: "2026-09-04T09:57:28Z")
}

test fn witness_an_unresolved_label_is_not_reported_as_x64() -> Bool {
  match arm_standing(r: resolve_runner_label(label: "ubuntu-latest", observed_at: "2026-09-01T10:29:11Z")) {
    ArmUndetermined { label, cause } => true
    ArmConfirmed { label, snapshot } => false
    NotArmConfirmed { label, architecture, snapshot } => false
  }
}

test fn witness_selected_population_is_three_complementary_jobs() -> Bool {
  let selected = selected_workloads()
  count(selected) == 3
    && census_contains_subject(rows: correctness_admitted_workloads(), needle: candidate_pdns_dnsdist_arm)
    && !census_contains_subject(rows: correctness_admitted_workloads(), needle: candidate_biome_test)
    && !census_contains_subject(rows: correctness_admitted_workloads(), needle: candidate_openobserve_arm_build)
    && candidate_biome_test.job_key == "test"
    && candidate_pdns_dnsdist_arm.job_key == "build-dnsdist"
    && candidate_openobserve_arm_build.job_key == "build_pr_image_arm64"
    && candidate_biome_test.repository != candidate_pdns_dnsdist_arm.repository
}

test fn witness_rejected_and_unresolved_remain_visible() -> Bool {
  census_contains_subject(rows: rejected_candidates(), needle: candidate_openobserve_amd64)
    && census_contains_subject(rows: rejected_candidates(), needle: candidate_openobserve_manifest)
    && census_contains_subject(rows: unresolved_candidates(), needle: candidate_biome_test_windows)
    && census_contains_subject(rows: unresolved_candidates(), needle: candidate_biome_test_macos)
    && census_contains_subject(rows: unresolved_candidates(), needle: candidate_openobserve_summary)
    && census_contains_subject(rows: selected_workloads(), needle: candidate_biome_test)
    && census_contains_subject(rows: selected_workloads(), needle: candidate_pdns_dnsdist_arm)
    && census_contains_subject(rows: selected_workloads(), needle: candidate_openobserve_arm_build)
    && match candidate_biome_blob_mismatch_control.selection {
      SelectedWorkload { rank, complementarity } =>
        match candidate_run_identity(c: candidate_biome_blob_mismatch_control) {
          RunIdentityMismatched { cause } =>
            !census_contains_subject(rows: workload_census, needle: candidate_biome_blob_mismatch_control)
          ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } => false
          WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } => false
          RunIdentityUnresolved { cause } => false
        }
      CandidateRejected { reason } => false
      CandidateUnresolved { obligation } => false
    }
}

test fn witness_every_row_is_job_scoped_and_versioned() -> Bool {
  all(workload_census, c => match candidate_run_identity(c: c) {
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } =>
      revision == c.inspected_commit
        && (repository as String) == (c.repository as String)
        && (job_key as String) == (c.job_key as String)
        && matrix_selector == c.matrix_selector
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } =>
      inspected == c.inspected_commit
        && (blob as String) == (c.workflow_blob_sha as String)
        && inspected != observed
    RunIdentityMismatched { cause } => true
    RunIdentityUnresolved { cause } => true
  })
}

test fn witness_biome_baseline_is_admitted_and_openobserve_is_not() -> Bool {
  let biome = match candidate_run_identity(c: candidate_biome_test) {
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } =>
      match baseline_admission(c: candidate_biome_test) {
        BaselineRefused { cause } => true
        BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
      }
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } => false
    RunIdentityMismatched { cause } => false
    RunIdentityUnresolved { cause } => false
  }
  let pdns = match baseline_admission(c: candidate_pdns_dnsdist_arm) {
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => true
    BaselineRefused { cause } => false
  }
  let openobserve = match baseline_admission(c: candidate_openobserve_arm_build) {
    BaselineRefused { cause } => true
    BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
  }
  biome && pdns && openobserve
}

test fn witness_pdns_declared_architecture_stays_unresolved_while_observed_is_arm() -> Bool {
  let declared = candidate_declared_architecture(c: candidate_pdns_dnsdist_arm)
  let declared_unresolved = match declared {
    DeclaredArchitectureUnresolved { via, cause } => true
    DeclaredArm { via } => false
    DeclaredNotArm { via, architecture } => false
  }
  let observed_arm = match candidate_observed_architecture(c: candidate_pdns_dnsdist_arm) {
    ArmConfirmed { label, snapshot } => true
    NotArmConfirmed { label, architecture, snapshot } => false
    ArmUndetermined { label, cause } => false
  }
  declared_unresolved && observed_arm
}

test fn witness_declared_and_observed_providers_are_separate_readings() -> Bool {
  let biome_declared = match candidate_declared_provider(c: candidate_biome_test) {
    DeclaredProviderKnown { via, provider_module } =>
      provider_module as String == "extdeps.ci_runner.depot"
    DeclaredProviderUnresolved { via, cause } => false
  }
  let pdns_declared_open = match candidate_declared_provider(c: candidate_pdns_dnsdist_arm) {
    DeclaredProviderUnresolved { via, cause } => true
    DeclaredProviderKnown { via, provider_module } => false
  }
  let pdns_observed_github = match candidate_observed_provider(c: candidate_pdns_dnsdist_arm) {
    ProviderFromCatalog { provider, label, snapshot } =>
      provider.module_path == "extdeps.ci_runner.github_actions"
    ProviderUnresolved { label, cause } => false
  }
  biome_declared && pdns_declared_open && pdns_observed_github
}

test fn witness_openobserve_amd64_is_catalog_x64_and_rejected() -> Bool {
  let declared = candidate_declared_architecture(c: candidate_openobserve_amd64)
  let not_arm = match declared {
    DeclaredNotArm { via, architecture } => architecture == X86_64
    DeclaredArm { via } => false
    DeclaredArchitectureUnresolved { via, cause } => false
  }
  let rejected = match candidate_openobserve_amd64.selection {
    CandidateRejected { reason } => true
    SelectedWorkload { rank, complementarity } => false
    CandidateUnresolved { obligation } => false
  }
  not_arm && rejected
}

test fn witness_observed_labels_and_attempt_are_read_from_the_job_resource() -> Bool {
  match candidate_biome_test.observed {
    JobRunObserved { job, repository, workflow_path, workflow_blob_sha_at_head, head_sha, correctness } =>
      observed_job_labels(job: job) == ["depot-ubuntu-24.04-arm-16"]
        && observed_job_run_attempt(job: job) == 1
    NoRunObserved { obligation } => false
  }
}

test fn witness_unobserved_cache_is_never_warm() -> Bool {
  count(filter(workload_census, c => candidate_warm_cache_count(c: c) > 0)) == 0
}

test fn witness_effect_disposition_is_derived_from_kind() -> Bool {
  match effect_disposition(kind: CoverageUpload { service: "Coveralls" }) {
    RemovedFromBothRealizations { cause } => match effect_disposition(kind: WorkflowArtifactUpload { artifact: "dnsdist binaries" }) {
      RetainedAndTimed { cause } => true
      RemovedFromBothRealizations { cause } => false
    }
    RetainedAndTimed { cause } => false
  }
}

test fn witness_admitted_same_revision_and_blob_equivalent_hold() -> Bool {
  let pdns_same = match candidate_run_identity(c: candidate_pdns_dnsdist_arm) {
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } =>
      revision == candidate_pdns_dnsdist_arm.inspected_commit
        && match jobs_name_join {
          JobsNameMatrixParenthetical { standing } => match standing {
            TranscribedUncited { read_obligation } => true
            CitedToAuthority { authority } => false
          }
          JobsNamePrefixOnly => false
        }
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } => false
    RunIdentityMismatched { cause } => false
    RunIdentityUnresolved { cause } => false
  }
  let biome_blob = match candidate_run_identity(c: candidate_biome_test) {
    WorkflowEquivalentOnly { inspected, observed, blob, jobs_name_join } =>
      inspected != observed
        && (blob as String) == "99f1255bbfa20a11197716a8fdb4c4e3359a588b"
    ObservedAtInspectedRevision { repository, revision, workflow_path, job_key, matrix_selector, jobs_name_join } => false
    RunIdentityMismatched { cause } => false
    RunIdentityUnresolved { cause } => false
  }
  pdns_same && biome_blob
    && match architecture_join_standing(c: candidate_pdns_dnsdist_arm) {
      ArchitectureJoinOnInspectedRevision => true
      ArchitectureJoinOnWorkflowEquivalentOnly { inspected, observed, blob } => false
      ArchitectureJoinRefused { cause } => false
    }
    && match architecture_join_standing(c: candidate_biome_test) {
      ArchitectureJoinOnWorkflowEquivalentOnly { inspected, observed, blob } =>
        inspected != observed
      ArchitectureJoinOnInspectedRevision => false
      ArchitectureJoinRefused { cause } => false
    }
    && match baseline_admission(c: candidate_pdns_dnsdist_arm) {
      BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => true
      BaselineRefused { cause } => false
    }
    && match baseline_admission(c: candidate_biome_test) {
      BaselineRefused { cause } => true
      BaselineAdmitted { job_id, run_id, run_attempt, head_sha, test_step, observed_label } => false
    }
    && match inspected_leg_binding(
      job_name: "build dnsdist (asan+ubsan, full, -arm)",
      job_key: candidate_pdns_dnsdist_arm.job_key,
      matrix: candidate_pdns_dnsdist_arm.matrix_selector,
      repository: candidate_pdns_dnsdist_arm.repository,
      workflow_path: candidate_pdns_dnsdist_arm.workflow_path,
    ) {
      InspectedLegBound { jobs_name_join } => match jobs_name_join {
        JobsNameMatrixParenthetical { standing } => match standing {
          TranscribedUncited { read_obligation } => true
          CitedToAuthority { authority } => false
        }
        JobsNamePrefixOnly => false
      }
      InspectedLegNameMismatch => false
      InspectedLegAxisMismatch => false
      InspectedLegUninspected { cause } => false
    }
}

