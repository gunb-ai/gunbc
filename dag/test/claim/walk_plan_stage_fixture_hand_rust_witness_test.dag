module test.claim.walk_plan_stage_fixture_hand_rust_witness



test fn walk_plan_stage_fixture_hand_rust_scaffold_is_seed_retained() -> Bool {
  match gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_scaffold {
    std.disposition.Scaffold { dissolves_to: std.disposition.SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn walk_plan_stage_fixture_hand_rust_receipt_is_checkable() -> Bool {
  !(std.dissolution.dissolution_description(condition: gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_dissolve_trigger) == "")
    && !(gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_receipt_plan_anchor == "")
    && !(gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_roadmap_lane_anchor == "")
    && gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_receipt_witness_entry == "dag/test/claim/walk_plan_stage_fixture_hand_rust_witness_test.dag"
    && gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_loc_delta_net == v2.std.algebra.length(xs: gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_paths)
}

test fn walk_plan_stage_fixture_hand_rust_roadmap_anchor_names_row() -> Bool {
  string_contains(
    s: gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_roadmap_lane_anchor,
    pattern: "ROADMAP.md"
  )
    && string_contains(
      s: gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_roadmap_lane_anchor,
      pattern: "v1-materialization-kernel"
    )
    && string_contains(
      s: std.dissolution.dissolution_description(condition: gunbc.walk_plan_stage_fixture_scaffold.walk_plan_stage_fixture_hand_rust_dissolve_trigger),
      pattern: "v1-materialization-kernel"
    )
}

test fn walk_plan_stage_fixture_recipes_carry_common_attempt_id() -> Bool {
  string_contains(s: v2.test.fixture.walk_plan_stage.plan.walk_plan_stage_overlap_barrier_recipe, pattern: v2.test.fixture.walk_plan_stage.common.walk_plan_stage_attempt_id)
    && string_contains(
      s: v2.test.fixture.walk_plan_stage.plan.walk_plan_stage_overlap_barrier_recipe,
      pattern: v2.test.fixture.walk_plan_stage.common.walk_plan_stage_stage1_receipt_path
    )
}
