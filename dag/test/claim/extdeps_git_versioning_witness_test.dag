module test.claim.extdeps_git_versioning_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn w_git_2_0_anchor() -> Bool {
  extdeps.git.versioning.git_2_0_release.major == 2
    && extdeps.git.versioning.git_2_0_release.minor == 0
    && extdeps.git.versioning.git_2_0_release.patch == 0
}

fn w_release_version_compare_major_minor_patch() -> Bool {
  let older = extdeps.git.versioning.GitReleaseVersion { major: 2, minor: 43, patch: 0 }
  let newer = extdeps.git.versioning.GitReleaseVersion { major: 2, minor: 44, patch: 0 }
  let same = extdeps.git.versioning.GitReleaseVersion { major: 2, minor: 43, patch: 1 }
  match extdeps.git.versioning.git_release_version_compare(a: older, b: newer) {
    Less =>
      match extdeps.git.versioning.git_release_version_compare(a: newer, b: older) {
        Greater =>
          match extdeps.git.versioning.git_release_version_compare(a: older, b: same) {
            Less =>
              match extdeps.git.versioning.git_release_version_compare(a: older, b: older) {
                Equal => true
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

fn w_major_breaking_release_orders_above_prior_minor_series() -> Bool {
  let git_1_9 = extdeps.git.versioning.GitReleaseVersion { major: 1, minor: 9, patch: 5 }
  match extdeps.git.versioning.git_release_version_compare(a: git_1_9, b: extdeps.git.versioning.git_2_0_release) {
    Less => true
    _ => false
  }
}

fn w_platform_suffix_is_structural_not_stringly() -> Bool {
  let gunbc.roadmap_authority.plain = extdeps.git.versioning.GitCliReportedVersion {
    git_release: extdeps.git.versioning.git_2_0_release,
    suffix: extdeps.git.versioning.GitVersionPlain
  }
  let windows = extdeps.git.versioning.GitCliReportedVersion {
    git_release: extdeps.git.versioning.git_2_0_release,
    suffix: extdeps.git.versioning.GitVersionWindows { build: 1 }
  }
  gunbc.roadmap_authority.plain.suffix != windows.suffix
}

fn w_spec_citation_points_at_breaking_changes_doc() -> Bool {
  string_contains(s: extdeps.git.versioning.git_release_versioning_spec_url, pattern: "BreakingChanges.html")
}

fn w_git_release_to_version_identity() -> Bool {
  extdeps.git.versioning.git_release_to_version_identity(v: extdeps.git.versioning.git_2_0_release) == "2.0.0"
}

fn w_git_release_version_scheme_equal() -> Bool {
  match extdeps.git.versioning.git_release_version_scheme.compare(
    a: extdeps.git.versioning.git_release_to_version_identity(v: extdeps.git.versioning.git_2_0_release),
    b: "2.0.0"
  ) {
    Equal => true
    _ => false
  }
}

fn w_min_git_version_grounded() -> Bool {
  min_git_version == ">= 2.0.0"
}

test fn extdeps_git_versioning_witnesses() -> Bool {
  w_git_2_0_anchor()
    && w_release_version_compare_major_minor_patch()
    && w_major_breaking_release_orders_above_prior_minor_series()
    && w_platform_suffix_is_structural_not_stringly()
    && w_spec_citation_points_at_breaking_changes_doc()
    && w_git_release_to_version_identity()
    && w_git_release_version_scheme_equal()
    && w_min_git_version_grounded()
}
