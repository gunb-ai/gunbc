module test.claim.transition_inhibition_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE TRANSITION INHIBITION STORE IS MINTED FROM ITS DECLARATION AND CANNOT BE SPELLED OR MINTED FROM A PATH.
// gunbc.deploy_transition_store TransitionInhibitionStore is sole_constructor; gunbc.deploy_transition's inhibition
// functions take it, and only transition_inhibition_store builds it, from the instance alone (the path is derived
// there from transition_inhibition_slots). Each RED hands the compiler a module outside the defining file and
// asserts the refusal on the real acceptance path:
//   - a forged store literal, a forged cast, and a store whose operations close over a LITERAL PATH: each EXACTLY
//     ONE SoleConstructorViolation on its subject;
//   - the deleted root-taking standing (transition_actuation_standing(instance_root:)) and the deleted guard-only
//     set_transition_inhibition (which wrote under guard.subject.instance_root): each at least one blocking diagnostic beyond a baseline importing the same closure, which cancels the shared
//     closure (gunbc.compile_diagnostic_census).
// A root read out of a store is ACCEPTED today and is recorded as an expecting-red probe, below.
// The GREEN is the lawful route, transition_inhibition_store into set_transition_inhibition and
// transition_actuation_standing, which adds no blocking diagnostic and draws no seal violation. NOT witnessed,
// because it is not expressible: a store minted for instance A refused where B is required (one type for both).
// NOT closed here: any module can still read or write the inhibition's bytes with Filesystem.* over a path it
// spells itself, because Filesystem.* is ambient (gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module); that is not holding a TransitionInhibitionStore.
// Seal residuals: variant construction (test.claim.sole_constructor_completeness_audit_probe f13) and parameter
// defaults (f19), so the record is neither generic nor a variant arm.

fn seal_violations(source: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: "TransitionInhibitionStore")
}

fn blocking_delta(hostile: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: closure_baseline_source), holds: holds)
}

data forged_store_literal_source: String = "module probe_transition_inhibition_forged_store_literal\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(s: TransitionInhibitionStore) -> TransitionInhibitionStore {\n  TransitionInhibitionStore { instance: s.instance, root: s.root }\n}\n"

data forged_store_cast_source: String = "module probe_transition_inhibition_forged_store_cast\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(r: NonEmptyStr) -> TransitionInhibitionStore {\n  r as TransitionInhibitionStore\n}\n"

data literal_path_store_source: String = "module probe_transition_inhibition_literal_path_store\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f() -> TransitionInhibitionStore {\n  TransitionInhibitionStore { instance: \"srv1-lab\" as NonEmptyStr, root: \"/tmp/forged-instance\" as NonEmptyStr }\n}\n"

data root_standing_source: String = "module probe_transition_inhibition_root_standing\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f() -> ActuationStanding {\n  transition_actuation_standing(instance_root: \"/tmp/forged-instance\")\n}\n"

data guard_only_set_source: String = "module probe_transition_inhibition_guard_only_set\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(g: TransitionGuard) -> TransitionActuation {\n  set_transition_inhibition(guard: g)\n}\n"

data root_out_of_store_source: String = "module probe_transition_inhibition_root_out_of_store\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(s: TransitionInhibitionStore) -> NonEmptyStr {\n  s.root\n}\n"

data lawful_mint_route_source: String = "module probe_transition_inhibition_lawful_mint_route\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(i: HostDashboardInstance, g: TransitionGuard) -> TransitionActuation {\n  match transition_inhibition_store(instance: i) {\n    TransitionInhibitionStoreReady { store } => set_transition_inhibition(inhibition: store, guard: g)\n    TransitionInhibitionStoreUnready { detail } => TransitionActuationRefused { cause: detail }\n  }\n}\nfn h(i: HostDashboardInstance) -> ActuationStanding {\n  transition_actuation_standing(inhibition: transition_inhibition_store(instance: i))\n}\n"

data closure_baseline_source: String = "module probe_transition_inhibition_closure_baseline\nimport std.types { NonEmptyStr, String }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionActuation, TransitionActuationRefused, transition_actuation_standing, set_transition_inhibition }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"

test fn a_forged_inhibition_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_literal_source), holds: fn(n) { n == 1 }))
}

test fn a_forged_inhibition_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_cast_source), holds: fn(n) { n == 1 }))
}

test fn an_inhibition_store_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_path_store_source), holds: fn(n) { n == 1 }))
}

test fn no_root_taking_standing_resolves() -> ProcessExit {
  census_exit(blocking_delta(hostile: root_standing_source, holds: fn(n) { n >= 1 }))
}

test fn no_set_derives_its_path_from_the_guard() -> ProcessExit {
  census_exit(blocking_delta(hostile: guard_only_set_source, holds: fn(n) { n >= 1 }))
}

// AN EXPECTING-RED PROBE, recorded as what holds TODAY: a foreign module reads the root out of a store and is
// accepted, because sole_constructor seals construction and not field reads (the residual #14944 records for its
// claim store, test.claim.slot_store_seal_witness a_root_is_readable_through_a_claim_store_today). It must flip,
// and is then inverted into that wall's RED, in the change that makes a sealed record's fields readable only in its
// declaring module.
test fn a_root_is_readable_through_an_inhibition_store_today() -> ProcessExit {
  census_exit(blocking_delta(hostile: root_out_of_store_source, holds: fn(n) { n <= 0 }))
}

test fn the_lawful_mint_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_mint_route_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_route_source), holds: fn(n) { n == 0 }),
  ])
}
