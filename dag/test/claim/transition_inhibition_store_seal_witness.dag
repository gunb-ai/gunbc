module test.claim.transition_inhibition_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// ONE TRANSITION, ONE INSTANCE, AND NO STORE OR CONTEXT SPELLED OR MINTED FROM A PATH. gunbc.deploy_transition_store
// TransitionInhibitionStore and TransitionContext are sole_constructor, and so are gunbc.deploy_transition
// TransitionGuard and TransitionResidue: the context is minted from the instance alone (transition_context), the
// guard only by the lease acquisition over a context, the residue only by reading that context's own store. Every
// transition operation derives its locations from one of them. Each RED hands the compiler a module outside the
// defining files and asserts the refusal on the real acceptance path:
//   - a forged store literal, a forged cast, a store over a LITERAL PATH, a context pairing instance B's inhibition
//     store with instance A's lease store, a guard acquired at A rebound to context B (keeping A's hold), and a residue pairing context B with
//     evidence observed at A: each EXACTLY ONE SoleConstructorViolation on its subject;
//   - the deleted forms that took a location beside the guard -- set and mark with a foreign store, clear with a
//     free instance root and a foreign store -- and the deleted root-taking standing: each at least one blocking
//     diagnostic beyond a baseline importing the same closure, which cancels the shared closure
//     (gunbc.compile_diagnostic_census).
// The behavioral half of the two-root RED (a guard at A writes, marks and clears A only; a residue at B leaves A and
// B unchanged) is test.claim.deploy_transition_wet_witness two_roots_one_guard_reaches_only_its_own_instance.
// Two routes are ACCEPTED today and recorded as expecting-red probes, below: a root read out of a store, and a
// context minted over an instance root the caller chose (route 3 of gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module). The GREEN is the lawful route. NOT closed here: any
// module can still read or write the records' bytes with Filesystem.* over a path it spells itself (route 1 of
// the same row). Seal residuals: variant construction (test.claim.sole_constructor_completeness_audit_probe f13)
// and parameter defaults (f19), so no sealed record here is generic or a variant arm.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: closure_baseline_source), holds: holds)
}
data forged_store_literal_source: String = "module probe_transition_forged_store_literal\nimport std.types { NonEmptyStr, String, Bool, FilePath }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store, TransitionContext, TransitionContextReading, TransitionContextReady, TransitionContextUnready, transition_context }\nimport gunbc.deploy_transition_lease_store { TransitionLeaseStore }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionSubject, TransitionActor, TransitionActuation, TransitionActuationRefused, TransitionResidue, TransitionResidueReading, TransitionResidueObserved, TransitionResidueUnobserved, ResidueEvidence, ClearanceBasis, ClearedByHolder, ClearedByEvidence, LeaseAcquisition, LeaseAcquired, LeaseHeldBy, LeaseHeldUndecodable, LeaseAcquireLost, LeaseUnobtainable, transition_actuation_standing, set_transition_inhibition, mark_transition_partial, clear_transition_records, acquire_transition_lease, transition_residue }\nfn f(s: TransitionInhibitionStore) -> TransitionInhibitionStore {\n  TransitionInhibitionStore { instance: s.instance, root: s.root }\n}\n"
