data chosen_instance_root_context_source: String = "module probe_transition_chosen_instance_root_context\nimport std.types { NonEmptyStr, String, Bool, FilePath }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store, TransitionContext, TransitionContextReading, TransitionContextReady, TransitionContextUnready, transition_context }\nimport gunbc.deploy_transition_lease_store { TransitionLeaseStore }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionSubject, TransitionActor, TransitionActuation, TransitionActuationRefused, TransitionResidue, TransitionResidueReading, TransitionResidueObserved, TransitionResidueUnobserved, ResidueEvidence, ClearanceBasis, ClearedByHolder, ClearedByEvidence, LeaseAcquisition, LeaseAcquired, LeaseHeldBy, LeaseHeldUndecodable, LeaseAcquireLost, LeaseUnobtainable, transition_actuation_standing, set_transition_inhibition, mark_transition_partial, clear_transition_records, acquire_transition_lease, transition_residue }\nfn f(subject: TransitionSubject, holder: TransitionActor) -> LeaseAcquisition {\n  match transition_context(instance: isolated_dashboard_instance(deployment: deployment_id(name: \"any\" as NonEmptyStr), instance_id: \"any\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/any/chosen/dir\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)) {\n    TransitionContextReady { context } => acquire_transition_lease(context: context, subject: subject, holder: holder)\n    TransitionContextUnready { detail } => LeaseUnobtainable { cause: detail }\n  }\n}\n"
data lawful_mint_route_source: String = "module probe_transition_lawful_mint_route\nimport std.types { NonEmptyStr, String, Bool, FilePath }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store, TransitionContext, TransitionContextReading, TransitionContextReady, TransitionContextUnready, transition_context }\nimport gunbc.deploy_transition_lease_store { TransitionLeaseStore }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionSubject, TransitionActor, TransitionActuation, TransitionActuationRefused, TransitionResidue, TransitionResidueReading, TransitionResidueObserved, TransitionResidueUnobserved, ResidueEvidence, ClearanceBasis, ClearedByHolder, ClearedByEvidence, LeaseAcquisition, LeaseAcquired, LeaseHeldBy, LeaseHeldUndecodable, LeaseAcquireLost, LeaseUnobtainable, transition_actuation_standing, set_transition_inhibition, mark_transition_partial, clear_transition_records, acquire_transition_lease, transition_residue }\nfn f(i: HostDashboardInstance, subject: TransitionSubject, holder: TransitionActor) -> TransitionActuation {\n  match transition_context(instance: i) {\n    TransitionContextUnready { detail } => TransitionActuationRefused { cause: detail }\n    TransitionContextReady { context } =>\n      match acquire_transition_lease(context: context, subject: subject, holder: holder) {\n        LeaseAcquired(g) => {\n          let s1 = set_transition_inhibition(guard: g)\n          let m1 = mark_transition_partial(guard: g, detail: \"partial\")\n          clear_transition_records(basis: ClearedByHolder(g), readback_converged: true)\n        }\n        LeaseHeldBy { holder } => TransitionActuationRefused { cause: holder }\n        LeaseHeldUndecodable { cause } => TransitionActuationRefused { cause: cause }\n        LeaseAcquireLost { cause } => TransitionActuationRefused { cause: cause }\n        LeaseUnobtainable { cause } => TransitionActuationRefused { cause: cause }\n      }\n  }\n}\nfn e(c: TransitionContext) -> TransitionActuation {\n  match transition_residue(context: c, head_observed: true, observed_head: \"aaaa\", observation_detail: \"observed\") {\n    TransitionResidueObserved(r) => clear_transition_records(basis: ClearedByEvidence(r), readback_converged: false)\n    TransitionResidueUnobserved { cause } => TransitionActuationRefused { cause: cause }\n  }\n}\nfn h(i: HostDashboardInstance) -> ActuationStanding {\n  transition_actuation_standing(inhibition: transition_inhibition_store(instance: i))\n}\n"
data closure_baseline_source: String = "module probe_transition_closure_baseline\nimport std.types { NonEmptyStr, String, Bool, FilePath }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport gunbc.deploy_transition_store { TransitionInhibitionStore, TransitionInhibitionStoreReading, TransitionInhibitionStoreReady, TransitionInhibitionStoreUnready, transition_inhibition_store, TransitionContext, TransitionContextReading, TransitionContextReady, TransitionContextUnready, transition_context }\nimport gunbc.deploy_transition_lease_store { TransitionLeaseStore }\nimport gunbc.deploy_transition { ActuationStanding, TransitionGuard, TransitionSubject, TransitionActor, TransitionActuation, TransitionActuationRefused, TransitionResidue, TransitionResidueReading, TransitionResidueObserved, TransitionResidueUnobserved, ResidueEvidence, ClearanceBasis, ClearedByHolder, ClearedByEvidence, LeaseAcquisition, LeaseAcquired, LeaseHeldBy, LeaseHeldUndecodable, LeaseAcquireLost, LeaseUnobtainable, transition_actuation_standing, set_transition_inhibition, mark_transition_partial, clear_transition_records, acquire_transition_lease, transition_residue }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"

test fn a_forged_inhibition_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_literal_source, subject: "TransitionInhibitionStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_inhibition_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_store_cast_source, subject: "TransitionInhibitionStore"), holds: fn(n) { n == 1 }))
}

test fn an_inhibition_store_over_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: literal_path_store_source, subject: "TransitionInhibitionStore"), holds: fn(n) { n == 1 }))
}

test fn a_context_pairing_two_instances_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_context_source, subject: "TransitionContext"), holds: fn(n) { n == 1 }))
}

test fn a_guard_rebound_to_another_context_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: rebound_guard_source, subject: "TransitionGuard"), holds: fn(n) { n == 1 }))
}

test fn a_residue_pairing_a_context_with_foreign_evidence_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: forged_residue_source, subject: "TransitionResidue"), holds: fn(n) { n == 1 }))
}

test fn no_root_taking_standing_resolves() -> ProcessExit {
  census_exit(blocking_delta(hostile: root_standing_source, holds: fn(n) { n >= 1 }))
}

test fn no_set_takes_a_store_beside_the_guard() -> ProcessExit {
  census_exit(blocking_delta(hostile: foreign_store_set_source, holds: fn(n) { n >= 1 }))
}

test fn no_mark_takes_a_store_beside_the_guard() -> ProcessExit {
  census_exit(blocking_delta(hostile: foreign_store_mark_source, holds: fn(n) { n >= 1 }))
}

test fn no_clear_takes_a_location_beside_its_basis() -> ProcessExit {
  census_exit(blocking_delta(hostile: foreign_store_clear_source, holds: fn(n) { n >= 1 }))
}

// AN EXPECTING-RED PROBE, recorded as what holds TODAY: a foreign module reads the root out of a store and is
// accepted, because sole_constructor seals construction and not field reads (route 2 of
// gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module, the residual
// test.claim.slot_store_seal_witness a_root_is_readable_through_a_claim_store_today records for the claim store).
// It must flip, and is then inverted into that wall's RED, in the change that makes a sealed record's fields
// readable only in its declaring module.
test fn a_root_is_readable_through_an_inhibition_store_today() -> ProcessExit {
  census_exit(blocking_delta(hostile: root_out_of_store_source, holds: fn(n) { n <= 0 }))
}

// AN EXPECTING-RED PROBE, recorded as what holds TODAY: a foreign module builds a HostDashboardInstance over a root
// it chose (gunbc.roadmap.roadmap_dashboard_instance isolated_dashboard_instance is public and takes any path),
// mints a TransitionContext from it, and acquires the transition lease there -- ACCEPTED, with no blocking
// diagnostic beyond the baseline and no seal violation. The context fixes that one transition's records share one
// instance; it does not fix WHICH instance. Route 3 of gunbc.recurring_failure_mode
// a_slot_store_is_built_over_a_literal_path_by_any_module, beside the claim store's
// test.claim.slot_store_seal_witness a_claim_store_over_a_chosen_instance_root_is_accepted_today. It must go red in
// the change that makes a dashboard instance sealed or admitted.
test fn a_transition_context_over_a_chosen_instance_root_is_accepted_today() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: chosen_instance_root_context_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: chosen_instance_root_context_source, subject: "TransitionContext"), holds: fn(n) { n == 0 }),
  ])
}

test fn the_lawful_mint_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: lawful_mint_route_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_route_source, subject: "TransitionInhibitionStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_route_source, subject: "TransitionContext"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_route_source, subject: "TransitionGuard"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_mint_route_source, subject: "TransitionResidue"), holds: fn(n) { n == 0 }),
  ])
}
