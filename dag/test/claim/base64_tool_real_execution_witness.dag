module test.claim.base64_tool_real_execution_witness

import std.types { Bool, NonEmptyStr, String }
import std.content_hash { Sha256Hash }
import extdeps.shell
import extdeps.tools.base64 { Base64FileEncoded, Base64FileUnreadable, base64_encode_file_via_shell }
import gunbc.output_policy { OutcomeIsData }
import gunbc.retained_shell_script { retained_runtime }
import gunbc.fleet.site_pxe_edge_converge { site_pxe_edge_chainloader_pin, site_pxe_edge_chainloader_target }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE COMMITTED CHAINLOADER THROUGH THE REAL base64 OPERATION. The pairing obligation of the supplied-status
// witnesses in test.claim.base64_tool_witness: base64_encode_file_via_shell runs the real coreutils `base64`
// over artifacts/ipxe/snponly-arm64.efi, the encoding is written to a temp file (never argv), decoded by
// `base64 -d`, and the sha256 of the decoded bytes must equal the digest the pin carries. Swapping the blob
// or changing the argv's wrapping flag reds here; the supplied-status witnesses never execute the argv.
// Refused by the hermetic envelope (shell.Exec and shell.Mktemp.Dir have no mock_response), so excluded from
// discovery and enrolled in gunbc.ci.ci_layer_roots as a real-execution witness.

fn pin_digest_hex() -> String {
  match site_pxe_edge_chainloader_target(pin: site_pxe_edge_chainloader_pin) {
    Absent => ""
    Present { value: b } =>
      match b.digest {
        Sha256Hash(d) => d.hex as String
        _ => ""
      }
  }
}

data committed_image_path: NonEmptyStr = "artifacts/ipxe/snponly-arm64.efi" as NonEmptyStr

// POSITIVE CONTROL: encode, decode, hash equals the pin's digest.
test fn the_committed_chainloader_round_trips_through_the_real_base64_to_the_pin_digest() -> Bool {
  match base64_encode_file_via_shell(path: committed_image_path) {
    Base64FileEncoded { text: t } => {
      let dir = shell.Mktemp.Dir()
      if dir.success == false {
        false
      } else {
        let enc = join([dir.path as String, "/image.b64"], "")
        let w = Filesystem.Write(path: enc, content: t)
        let r = shell.Exec.Run(script: retained_runtime(body: concat("base64 -d ", concat(enc, " | sha256sum")), reason: "base64 real-execution witness: decode the encoding and hash it" as NonEmptyStr), expect: OutcomeIsData)
        let cleaned = shell.Remove.RecursiveForce(path: dir.path)
        contains(t, "\n") == false && w.success && r.success && cleaned.success && pin_digest_hex() != "" && contains(r.stdout, pin_digest_hex())
      }
    }
    Base64FileUnreadable { stderr: _ } => false
    _ => false
  }
}

// RED: a path that does not exist is the real status 1 arm, not an encoding.
test fn a_missing_file_is_the_real_unreadable_arm() -> Bool {
  match base64_encode_file_via_shell(path: "artifacts/ipxe/does-not-exist.efi" as NonEmptyStr) {
    Base64FileUnreadable { stderr: _ } => true
    _ => false
  }
}
