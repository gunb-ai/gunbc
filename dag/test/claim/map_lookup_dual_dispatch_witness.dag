module test.claim.map_lookup_dual_dispatch_witness

import std.algebra { map_lookup }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn map_get_method_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("a", 10)
  let o = m |> get("a")
  match o {
    Present { value: v } => v == 10
    Absent => false
  }
}

test fn map_index_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("b", 42)
  let o = m["b"]
  match o {
    Present { value: v } => v == 42
    Absent => false
  }
}

test fn lookup_builtin_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("k", 7)
  match lookup(m, "k") {
    Present { value: v } => v == 7
    Absent => false
  }
}

// lookup routes through the dual-dispatch chokepoint, which wraps the hit in the Optional coproduct
// (Present { value } | Absent) — the v1_rt Witness<V> carrier was deleted
// (v1_rt-witness-diagnostic-carrier-decouple-design.md); lookup now returns Option<V> natively.
// Matching Present is still the discriminating form — a raw 7 here would mean the bare builtin
// BYPASSED the chokepoint, and Present/Absent proves the modeled dispatch runs.

test fn std_graph_build_adjacency_views_evaluates() -> Bool {
  let names = ["a", "b"]
  let graph = CallGraph { edges: [GraphEdge { caller: "a", callee: "b" }] }
  let views = build_adjacency_views(names: names, graph: graph)
  match map_get(views.forward, "a") {
    Present { value: ns } => ns == ["b"]
    Absent => false
  }
}

// THE map_get -> map_lookup WAVE MOVES A CALL TO THE DECLARED FREE FN, SO IT MUST MEAN THE SAME ANSWER on both outcomes of a
// keyed read: a present key answers Present with its value, an absent key answers Absent. Each claim states the answer for
// the declared head and for the ambient head on the SAME map, so neither can drift alone and still pass.
test fn map_lookup_present_key_answers_present_value() -> Bool {
  let m = empty_map() |> map_insert("k", 7)
  let declared = match map_lookup(m, "k") {
    Present { value: v } => v == 7
    Absent => false
  }
  let ambient = match map_get(m, "k") {
    Present { value: v } => v == 7
    Absent => false
  }
  declared && ambient
}

test fn map_lookup_absent_key_answers_absent() -> Bool {
  let m = empty_map() |> map_insert("k", 7)
  let declared = match map_lookup(m, "missing") {
    Present { value: _ } => false
    Absent => true
  }
  let ambient = match map_get(m, "missing") {
    Present { value: _ } => false
    Absent => true
  }
  declared && ambient
}
