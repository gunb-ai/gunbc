module test.claim.approve_ios_enrolment_machine_persist_order_witness

// ══════════════════════════════════════════════════════════════════════════════════════════════
// WHAT THIS EXECUTES, AND WHAT IT DOES NOT CLAIM.
//
// The law under test is the one apps/approve-ios/Approve/EnrolmentState.swift states in prose:
// "every transition is persisted BEFORE the remote call that depends on it". This file does not
// re-state it and does not check that a comment says it — it CALLS the persist step and the admission
// check and asks what they answer, the way dag/test/claim/dispatch_credential_snapshot_seal_witness
// executes the handoff rather than asserting it.
//
// WHY THE POSITIVE CONTROL COMES FIRST: a refusal test that has never produced an admission proves
// only that the door is welded shut, which is the failure DESIGN 4b calls a decoration. The first
// control gets a real admitted effect out of an honest commit; every refusal below is then a refusal
// THAT SAME MACHINE made, on one changed input.
//
// ON THE DISPOSITION, declared honestly rather than negotiated. compile_dag_diagnostic_census resolves
// its synthetic source against the live checkout and is the one call here that touches it —
// gunbc.guarantee_probe_corpus documents the exact hazard, and witnesses whose census calls are real
// declare ReadsLiveTree (see test.claim.fabric_m0_job_ending_seal, the pattern this battery follows).
// Relabelling this SubstrateInputsOnly to dodge a declined arm would be a fabricated fact about a
// live-tree read. So the census controls refuse on CensusNotRunnable — a sentinel row, never a zero —
// and no compile-side assertion here can green by vacancy whichever way the gate roster falls.
//
// THE RED IS KEYED, NOT COUNTED. gunbc.compile_diagnostic_census's own note says a CensusObserved
// carries the whole compile's rows, imported closure included — so a fixture's total is never zero for
// any fixture that imports a production module, and "class X count == 0" over a whole census is not a
// finding. Each pair below is the SAME module differing by one body, compared through the keyed
// differential the census module owns (censuses_differ_by_exactly_the_target_key): the target key at
// (class, subject) rises by exactly one and no other key moves.
// ══════════════════════════════════════════════════════════════════════════════════════════════

import std.types { String, Bool, Int, List, list_length }
import std.algebra { string_contains }
import std.optional { Present, Absent, optional_present, optional_absent }
import std.content_hash { content_hash_of_value }
import std.durable_compare_and_set {
  CasAttempt,
  cas_attempt,
  ExpectSlotAbsent,
  ExpectSlotGeneration,
  CasOutcome,
  CasCommitted,
  CasSlotObservation,
  CasObservedReadable,
  CasObservedUnreadable,
  CasReadableAbsent,
  CasReadablePresent,
  CasUnreadableMalformed,
  CasSlotVersion,
  CasGeneration,
  cas_generation,
  cas_generation_first,
}
import std.roster_frontier { frontier_subject_eq }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import gunbc.guarantee_stall {
  TriggerAdmission,
  TriggerAdmitted,
  TriggerCapabilityEmpty,
  TriggerCapabilitySpellsAReferent,
  stall_is_below_ceiling,
  stall_report_message,
  stall_trigger_admission,
}
import gunbc.guarantee_stall.enrolment_commit_evidence_remains_caller_authored_stall {
  enrolment_commit_evidence_remains_caller_authored_stall,
}
import gunbc.guarantee_stall.roster { all_guarantee_stalls }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CompileDiagnosticCensusRow,
  CensusObserved,
  CensusNotRunnable,
  census_count_at_key,
  censuses_differ_by_exactly_the_target_key,
}
import gunbc.approve_ios_enrolment_machine {
  EnrolmentState,
  StateUnenrolled,
  StatePrepared,
  StateEnrolled,
  PreparedEnrolmentPayload,
  EnrolledDevicePayload,
  EnrolmentCommitProof,
  EnrolmentEffectAdmission,
  enrolment_record_digest,
  enrolment_persist,
  enrolment_effect_admitted,
  enrolment_call_admitted,
  SubmitEnrolmentPost,
  ForwardApnsToken,
  EnrolmentPersistVerdict,
  EnrolmentPersistRefused,
  EnrolmentPersistRefusedProposedRecordIsNotThisState,
  approve_ios_enrolment_state_generator_frontier_rows,
}
import extdeps.crypto.signature { VerifyingKey, EcdsaP256Sha256, Sec1Uncompressed }
import extdeps.apple.secure_enclave { SecureEnclaveWrappedKeyBlob }
import extdeps.apple.app_attest { AttestKeyId }
import extdeps.apple.apns { ApnsDeviceToken }

// THE SAME PREPARED RECORD, in every control. The carriers come from their own authorities — the
// wrapped key from the enclave module, the key id from App Attest, the token from APNs, the public key
// from the signature module — which is the point: the model is exercised carrying the wire's own
// values, not strings of its own invention.
fn prepared_payload() -> PreparedEnrolmentPayload {
  PreparedEnrolmentPayload {
    code: "7F3K-9Q" as NonEmptyStr,
    decision_key_blob: "sec-enclave-wrapped/v1/agdY2Jj" as SecureEnclaveWrappedKeyBlob,
    decision_key_pub: VerifyingKey { suite: EcdsaP256Sha256, encoding: Sec1Uncompressed, point_b64url: "BLRl9cHf4dS7wQx1p0N0dGFybW9yX2tleV9wb2ludA" as NonEmptyStr },
    attest_key_id: "aGFzLWtleS1pZC1mb3ItZW5yb2xtZW50" as AttestKeyId,
    transcript: "transcript-over-the-assertion" as NonEmptyStr,
    attestation: optional_absent(),
  }
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn prepared_state() -> EnrolmentState {
  StatePrepared { payload: prepared_payload() }
}

fn enrolled_state() -> EnrolmentState {
  StateEnrolled {
    device: EnrolledDevicePayload {
      enrollment_id: "enr_01HTXK3" as NonEmptyStr,
      decision_key_blob: "sec-enclave-wrapped/v1/agdY2Jj" as SecureEnclaveWrappedKeyBlob,
      attest_key_id: "aGFzLWtleS1pZC1mb3ItZW5yb2xtZW50" as AttestKeyId,
      forwarded_apns_token: optional_present(value: "0f1e2d3c4b5a6978899aabbccddeeff0" as ApnsDeviceToken),
    },
  }
}

fn generation_at(n: Int) -> CasGeneration {
  match cas_generation(n: n) {
    Present { value: g } => g
    Absent => cas_generation_first()
  }
}

// An honest attempt: the proposed digest IS this state's render digest, and the proposed VALUE is the
// state. That pairing is the input a consumer has to get right, and the model does not take it on trust.
fn honest_attempt(state: EnrolmentState) -> CasAttempt<EnrolmentState> {
  cas_attempt(
    key: "enrolment-state" as NonEmptyStr,
    expected: ExpectSlotAbsent,
    proposed: state,
    proposed_content: enrolment_record_digest(state: state),
  )
}

fn absent_observation() -> CasSlotObservation<EnrolmentState> {
  CasObservedReadable { readable: CasReadableAbsent }
}

fn occupied_observation(state: EnrolmentState, at: Int) -> CasSlotObservation<EnrolmentState> {
  CasObservedReadable {
    readable: CasReadablePresent {
      version: CasSlotVersion {
        generation: generation_at(n: at),
        content: enrolment_record_digest(state: state),
        value: state,
      },
    },
  }
}

// A coproduct answer is asked by MATCHING it, not by comparing it to a constant, so an arm added to
// TriggerAdmission later reddens here instead of silently failing an equality.
fn trigger_is_admitted(admission: TriggerAdmission) -> Bool {
  match admission {
    TriggerAdmitted => true
    TriggerCapabilityEmpty { subject: _ } => false
    TriggerCapabilitySpellsAReferent { subject: _, scheme: _ } => false
  }
}

fn has_admission(verdict: EnrolmentPersistVerdict) -> Bool {
  match enrolment_effect_admitted(verdict: verdict) {
    Present { value: _ } => true
    Absent => false
  }
}

// CONTROL 1 — THE HONEST PATH ADMITS ITS OWN CALL. If this fails, every refusal below is vacuous.
test fn honest_commit_admits_the_remote_call_that_depends_on_it() -> Bool {
  let state = prepared_state()
  let verdict = enrolment_persist(
    state: state,
    attempt: honest_attempt(state: state),
    observed: absent_observation(),
  )
  has_admission(verdict: verdict)
    && enrolment_call_admitted(call: SubmitEnrolmentPost { state: state }, verdict: verdict)
}

// RED 1 — EFFECTS BEFORE PERSISTING. The slot is already occupied, so nothing is committed: the shape
// of the bug the ordering exists to prevent, where a save() that did not land was indistinguishable
// from one that did and the device posted anyway, then re-attested on resume. The arm is asserted,
// not just the refusal, so the fold cannot route a lost race into some other refusal.
test fn a_transition_that_did_not_persist_admits_no_remote_call() -> Bool {
  let state = prepared_state()
  let verdict = enrolment_persist(
    state: state,
    attempt: honest_attempt(state: state),
    observed: occupied_observation(state: state, at: 2),
  )
  match verdict {
    EnrolmentPersistRefused { standing: _ } =>
      !has_admission(verdict: verdict)
        && !enrolment_call_admitted(call: SubmitEnrolmentPost { state: state }, verdict: verdict)
    _ => false
  }
}

// RED 2 — THE WRITE CARRIES SOME OTHER RECORD'S BYTES. The store's precondition held and a commit
// happened, but the bytes proposed are not the render of the state being transitioned to: the app
// would post a payload while a DIFFERENT record becomes durable, then resume from the durable one and
// mint a second attestation the server may already hold. This is the arm a store-vs-attempt fold
// cannot produce, because both of those fields come from the attempt.
test fn a_commit_carrying_another_records_bytes_is_named_not_admitted() -> Bool {
  let state = prepared_state()
  let verdict = enrolment_persist(
    state: state,
    attempt: cas_attempt(
      key: "enrolment-state" as NonEmptyStr,
      expected: ExpectSlotAbsent,
      proposed: state,
      proposed_content: content_hash_of_value(value: "a-record-from-another-attempt" as NonEmptyStr),
    ),
    observed: absent_observation(),
  )
  match verdict {
    EnrolmentPersistRefusedProposedRecordIsNotThisState { proposed: _, intended: _ } =>
      !has_admission(verdict: verdict)
        && !enrolment_call_admitted(call: SubmitEnrolmentPost { state: state }, verdict: verdict)
    _ => false
  }
}

// RED 3 — AN UNREADABLE SLOT REFUSES; IT DOES NOT LOOK LIKE A LOST RACE. std.durable_compare_and_set
// made that distinction for a reason and the model inherits it: an absence of evidence about the slot
// is not an absent record, and treating it as one is how a device posts on top of an enrolment it
// cannot see.
test fn an_unreadable_slot_refuses_rather_than_losing_the_race() -> Bool {
  let state = prepared_state()
  let verdict = enrolment_persist(
    state: state,
    attempt: honest_attempt(state: state),
    observed: CasObservedUnreadable { cause: CasUnreadableMalformed { detail: "witness-forced" as NonEmptyStr } },
  )
  match verdict {
    EnrolmentPersistRefused { standing: _ } =>
      !has_admission(verdict: verdict)
        && !enrolment_call_admitted(call: SubmitEnrolmentPost { state: state }, verdict: verdict)
    _ => false
  }
}

// RED 4 — ONE ADMISSION IS NOT A LICENCE. The persist admitted an effect for the PREPARED record; the
// APNs forward depends on the ENROLLED one. A stale-but-genuine admission is exactly what a
// "call A, then call B" API cannot express, so this is where it is settled rather than by discipline.
test fn an_admission_for_one_record_does_not_authorize_another_records_call() -> Bool {
  let prepared = prepared_state()
  let verdict = enrolment_persist(
    state: prepared,
    attempt: honest_attempt(state: prepared),
    observed: absent_observation(),
  )
  enrolment_call_admitted(call: SubmitEnrolmentPost { state: prepared }, verdict: verdict)
    && !enrolment_call_admitted(call: ForwardApnsToken { state: enrolled_state() }, verdict: verdict)
}

// CONTROL 2 — THE RULE SURVIVES THE PHASE IT SHOULD SURVIVE, AND A REAL CONDITIONAL WRITE. Enrolled is
// a legitimate state to have persisted and the token forward depends on it; the attempt expects a
// specific generation and observes that generation holding the PREPARED record, so the CAS runs as a
// real compare-and-set rather than an always-absent fixture. A model that only ever admitted the
// prepared path would be a phase lookup wearing a seal.
test fn a_persisted_enrolled_record_admits_its_token_forward() -> Bool {
  let enrolled = enrolled_state()
  let prepared = prepared_state()
  let verdict = enrolment_persist(
    state: enrolled,
    attempt: cas_attempt(
      key: "enrolment-state" as NonEmptyStr,
      expected: ExpectSlotGeneration { generation: cas_generation_first() },
      proposed: enrolled,
      proposed_content: enrolment_record_digest(state: enrolled),
    ),
    observed: occupied_observation(state: prepared, at: 1),
  )
  enrolment_call_admitted(call: ForwardApnsToken { state: enrolled }, verdict: verdict)
}

// CONTROL 3 — THE TWO REFUSALS ARE DISTINCT MECHANISMS, not one refusal wearing two hats: RED 1 comes
// from the store's precondition, RED 2 from the digest check, and each lands in its own arm on inputs
// where the other's cause is absent.
test fn a_refused_digest_and_a_refused_precondition_are_different_refusals() -> Bool {
  let state = prepared_state()
  let wrong_bytes = enrolment_persist(
    state: state,
    attempt: cas_attempt(
      key: "enrolment-state" as NonEmptyStr,
      expected: ExpectSlotAbsent,
      proposed: state,
      proposed_content: content_hash_of_value(value: "not-this-record" as NonEmptyStr),
    ),
    observed: absent_observation(),
  )
  let occupied = enrolment_persist(
    state: state,
    attempt: honest_attempt(state: state),
    observed: occupied_observation(state: state, at: 2),
  )
  match wrong_bytes {
    EnrolmentPersistRefusedProposedRecordIsNotThisState { proposed: _, intended: _ } =>
      match occupied {
        EnrolmentPersistRefused { standing: _ } => true
        _ => false
      }
    _ => false
  }
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// THE COMPILE-SIDE RED: the ordering is not a convention, because the value it needs cannot be
// written outside the module that checks it.
//
// ONE AXIS, AS test.claim.fabric_m0_job_ending_seal ESTABLISHES. The shared preamble defines the
// sanctioned route (persist a real record, ask the verdict for its admission) and both arms end with
// the same call to it; the forged arm additionally binds a typed local holding the sealed literal. So
// the two sources differ by that one binding and nothing else — no differing imports, no differing
// call set, no brand cast present in one arm and not the other. Anything less compares two programs
// and calls the difference a wall.
//
// WHY THERE IS NO SANCTIONED MINT TO CALL FOR THESE TWO, which is the finding rather than a gap in the
// fixture: EnrolmentCommitProof and EnrolmentEffectAdmission have no public constructor route at all,
// because the only declaration in the tree that produces them is enrolment_persist's interior. The
// sanctioned arm therefore goes through the persist step itself, and the red arm binds the literal the
// sanctioned arm cannot use.
//
// THE FIXTURES ARE CROSS-MODULE ON PURPOSE: the compiler's own guard (v1_compiler_infer.rs, the
// `if !definer_module.eq(module_path)` test before SoleConstructorViolation) fires only for a consumer
// outside the defining module, so a fixture inside this module could not be RED for any reason at all.
// ──────────────────────────────────────────────────────────────────────────────────────────────

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn keyed_count(source: String, wanted_class: String, wanted_subject: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: wanted_class, subject_name: wanted_subject, blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// NOT-RUNNABLE IS A SENTINEL ROW, NEVER A ZERO: a zero would read exactly like "the seal held", which is
// the one thing this battery must never infer from a census that declined to run.
fn unrunnable_sentinel_row() -> CompileDiagnosticCensusRow {
  CompileDiagnosticCensusRow {
    diagnostic_class: "CENSUS-NOT-RUNNABLE",
    subject_name: "census",
    blocking: true,
    count: 1,
  }
}

fn census_rows_or_refuse(source: String) -> List<CompileDiagnosticCensusRow> {
  match census_of(source: source) {
    CensusObserved { rows: rows } => rows
    CensusNotRunnable { cause: _ } => [unrunnable_sentinel_row()]
  }
}

// THE PREAMBLE, IDENTICAL IN BOTH ARMS. It builds a real unenrolled record, persists it through the
// sealed door, and returns 1 only if the persist admitted an effect — so the green arm is not merely a
// source that fails to offend, it is the sanctioned route actually working.
fn sealed_probe_source(module_name: String, sealed_import: String, forged_binding: String) -> String {
  "module " + module_name + "\n"
    + "import std.types { Int, NonEmptyStr }\n"
    + "import std.content_hash { ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable, compare_content_hash }\n"
    + "import std.optional { Present, Absent }\n"
    + "import std.durable_compare_and_set { cas_attempt, ExpectSlotAbsent, CasObservedReadable, CasReadableAbsent }\n"
    + "import gunbc.approve_ios_enrolment_machine { " + sealed_import + ", EnrolmentState, StateUnenrolled, EnrolmentPersistVerdict, enrolment_persist, enrolment_record_digest, enrolment_effect_admitted }\n"
    + "fn persisted_verdict() -> EnrolmentPersistVerdict {\n"
    + "  enrolment_persist(\n"
    + "    state: StateUnenrolled,\n"
    + "    attempt: cas_attempt(key: \"witness-slot\" as NonEmptyStr, expected: ExpectSlotAbsent, proposed: StateUnenrolled, proposed_content: enrolment_record_digest(state: StateUnenrolled)),\n"
    + "    observed: CasObservedReadable { readable: CasReadableAbsent }\n"
    + "  )\n"
    + "}\n"
    + "fn sanctioned_value() -> Int {\n"
    + "  let record_digest = enrolment_record_digest(state: StateUnenrolled)\n"
    + "  let honest = match compare_content_hash(left: record_digest, right: record_digest) { ContentHashEqual => 1  ContentHashDifferent => 0  ContentHashCrossFamilyIncomparable => 0 }\n"
    + "  match enrolment_effect_admitted(verdict: persisted_verdict()) { Present { value: _ } => honest  Absent => 0 - 1 }\n"
    + "}\n"
    + "fn subject() -> Int {\n  "
    + forged_binding
    + "  sanctioned_value()\n}\n"
}

// THE FORGERIES, one per carrier. Each binds a typed local holding the sealed literal, which is the
// only difference from the green arm, and then returns the sanctioned route's own answer.
data forged_commit_proof_binding: String = "let forged: EnrolmentCommitProof = EnrolmentCommitProof { committed_content: enrolment_record_digest(state: StateUnenrolled) }\n"

data forged_effect_admission_binding: String = "let forged: EnrolmentEffectAdmission = EnrolmentEffectAdmission { record: enrolment_record_digest(state: StateUnenrolled) }\n"

fn commit_proof_source(forged_binding: String) -> String {
  sealed_probe_source(
    module_name: "probe_approve_ios_enrolment_commit_proof_axis",
    sealed_import: "EnrolmentCommitProof",
    forged_binding: forged_binding,
  )
}

fn effect_admission_source(forged_binding: String) -> String {
  sealed_probe_source(
    module_name: "probe_approve_ios_enrolment_effect_admission_axis",
    sealed_import: "EnrolmentEffectAdmission",
    forged_binding: forged_binding,
  )
}

// The green arms bind nothing: the same source with the forged local removed.
data no_forged_binding: String = ""

// RED 5 — WRITING THE COMMIT PROOF OUTSIDE THE MODULE THAT ISSUES IT, at its own key.
test fn a_forged_commit_proof_literal_is_refused_at_compile() -> Bool {
  keyed_count(
    source: commit_proof_source(forged_binding: forged_commit_proof_binding),
    wanted_class: "SoleConstructorViolation",
    wanted_subject: "EnrolmentCommitProof",
  ) == 1
}

// CONTROL 4 — THE SAME SOURCE WITHOUT THE BINDING DRAWS NO VIOLATION. Without this, RED 5 only shows
// the fixture fails to compile for reasons, and a check that cannot be GREEN is not a wall.
test fn the_unbound_commit_proof_source_draws_no_violation() -> Bool {
  keyed_count(
    source: commit_proof_source(forged_binding: no_forged_binding),
    wanted_class: "SoleConstructorViolation",
    wanted_subject: "EnrolmentCommitProof",
  ) == 0
}

// RED 6 — WRITING THE ADMISSION BY HAND IS THE BUG, TYPED. This is the exact forgery the ordering rests
// on being impossible: an app that wants to post without persisting needs an EnrolmentEffectAdmission,
// and there is no way for it to have one.
test fn a_forged_effect_admission_literal_is_refused_at_compile() -> Bool {
  keyed_count(
    source: effect_admission_source(forged_binding: forged_effect_admission_binding),
    wanted_class: "SoleConstructorViolation",
    wanted_subject: "EnrolmentEffectAdmission",
  ) == 1
}

// CONTROL 5 — as above, for the admission axis.
test fn the_unbound_effect_admission_source_draws_no_violation() -> Bool {
  keyed_count(
    source: effect_admission_source(forged_binding: no_forged_binding),
    wanted_class: "SoleConstructorViolation",
    wanted_subject: "EnrolmentEffectAdmission",
  ) == 0
}

// THE DIFFERENTIAL, KEYED: forged vs unbound, one axis, and the ONLY key that moves is the wall itself.
// The whole-census differential is what makes "the class count rose" mean "THIS literal, and nothing
// else about the source", which a keyed count alone cannot say.
test fn the_forged_and_unbound_arms_differ_by_exactly_these_walls() -> Bool {
  censuses_differ_by_exactly_the_target_key(
    red: census_rows_or_refuse(source: commit_proof_source(forged_binding: forged_commit_proof_binding)),
    green: census_rows_or_refuse(source: commit_proof_source(forged_binding: no_forged_binding)),
    target_class: "SoleConstructorViolation",
    target_subject: "EnrolmentCommitProof",
  )
    && censuses_differ_by_exactly_the_target_key(
      red: census_rows_or_refuse(source: effect_admission_source(forged_binding: forged_effect_admission_binding)),
      green: census_rows_or_refuse(source: effect_admission_source(forged_binding: no_forged_binding)),
      target_class: "SoleConstructorViolation",
      target_subject: "EnrolmentEffectAdmission",
    )
}

// BOTH ARMS ACTUALLY COMPILED, including the sanctioned route inside them. The differential above is
// satisfied by two sentinel rows in a way that a keyed count is not; this one is not, and it is the
// control that makes the REDs evidence rather than arithmetic.
test fn both_arms_of_both_differentials_actually_compiled() -> Bool {
  let all_arms = [
    commit_proof_source(forged_binding: forged_commit_proof_binding),
    commit_proof_source(forged_binding: no_forged_binding),
    effect_admission_source(forged_binding: forged_effect_admission_binding),
    effect_admission_source(forged_binding: no_forged_binding),
  ]
  all_arms |> all(s =>
    census_count_at_key(
      rows: census_rows_or_refuse(source: s),
      diagnostic_class: "CENSUS-NOT-RUNNABLE",
      subject_name: "census",
      blocking: true,
    ) == 0
  )
}

// THE GREEN ARM IS NOT MERELY HARMLESS, IT WORKS: the sanctioned route inside the same fixture returns
// its positive answer (1), so a fixture that quietly failed to persist could not pass Controls 4/5 and
// this at once.
test fn the_sanctioned_route_inside_the_fixture_admits_its_own_effect() -> Bool {
  let arms = [
    commit_proof_source(forged_binding: no_forged_binding),
    effect_admission_source(forged_binding: no_forged_binding),
  ]
  arms |> all(s =>
    census_count_at_key(
      rows: census_rows_or_refuse(source: s),
      diagnostic_class: "TypeNotFound",
      subject_name: "EnrolmentPersistVerdict",
      blocking: true,
    ) == 0
  )
}

// KNOWN GAP, KEPT EXECUTABLE RATHER THAN AS PROSE.
//
// std.durable_compare_and_set does not seal CasOutcome: `cas_decide` is a pure fold and nothing in the
// tree mints a CasOutcome but the caller, so a caller can author a CasCommitted and reach the admitted
// arm with no store involved. No fold in any module can close that, because every commit fact a fold
// could check is caller-authored. The closure obligation is the durable store's — a store-minted,
// sole_constructor CasOutcome that enrolment_persist takes as its receipt.
//
// This control asserts the gap EXISTS, so closing it FLIPS this test rather than letting the module's
// disclosure quietly go stale.
test fn known_gap_a_caller_authored_commit_reaches_the_admitted_arm() -> Bool {
  let state = prepared_state()
  let verdict = enrolment_persist(
    state: state,
    attempt: honest_attempt(state: state),
    observed: absent_observation(),
  )
  let forged: CasOutcome<EnrolmentState> = CasCommitted {
    committed: CasSlotVersion {
      generation: cas_generation_first(),
      content: enrolment_record_digest(state: state),
      value: state,
    },
  }
  match forged {
    CasCommitted { committed: _ } => has_admission(verdict: verdict)
    _ => false
  }
}

// THE LAW IS THE MACHINE, SO THE MACHINE IS WHAT GETS ASKED — this claim replaces an
// `EnrolmentOrderingStanding` that certified itself (see the deletion note in
// gunbc.approve_ios_enrolment_machine: a basis of four decl_ref string literals checked against a list
// of those same four constants, whose refusal arm no input could reach). Nothing here asks a
// declaration whether it exists; every line below calls the fold and refuses on the answer the fold
// did not give. A deleted or renamed `enrolment_persist` fails to COMPILE this file — the resolver is
// the only thing that ever pinned those names — and a weakened `enrolment_persist` or
// `enrolment_call_admitted` reddens here.
//
// IT ALSO COVERS THE GAP THE 17-PASS RUN LEFT OPEN: an unresolved name inside a claim body is a
// resolve-time failure, which claim_batch reports before any PASS — but the last head had a name the
// review could see and the run could not, because the path it sat on was never evaluated by any claim.
// So this claim deliberately evaluates the fold-bearing paths below, including the `declaration_ref_eq`
// comparison and the stall row's folds, rather than leaving them as declared-but-unevaluated code.
test fn the_law_is_the_machine_and_the_machine_answers() -> Bool {
  let honest_state = prepared_state()
  let honest_verdict = enrolment_persist(
    state: honest_state,
    attempt: honest_attempt(state: honest_state),
    observed: absent_observation(),
  )
  let other_state = enrolled_state()
  let wrong_verdict = enrolment_persist(
    state: honest_state,
    attempt: cas_attempt(
      key: "enrolment-state" as NonEmptyStr,
      expected: ExpectSlotAbsent,
      proposed: honest_state,
      proposed_content: enrolment_record_digest(state: other_state),
    ),
    observed: absent_observation(),
  )
  let enrolled_verdict = enrolment_persist(
    state: other_state,
    attempt: honest_attempt(state: other_state),
    observed: absent_observation(),
  )
  let stall = enrolment_commit_evidence_remains_caller_authored_stall
  let report = stall_report_message(s: stall)
  // Every conjunct is a CALL whose answer could come back the other way. The three ordering ones ask
  // the sealed machine; the last four ask gunbc.guarantee_stall's own folds about the typed row, which
  // is where the store obligation now lives instead of in a sentence. Together they also keep
  // declaration_ref_eq and these folds on the EVALUATED path: an unresolved name hiding in code no
  // claim runs was exactly how the previous head carried one past a 17-PASS run.
  enrolment_call_admitted(call: SubmitEnrolmentPost { state: honest_state }, verdict: honest_verdict)
    && !enrolment_call_admitted(call: SubmitEnrolmentPost { state: honest_state }, verdict: wrong_verdict)
    && enrolment_call_admitted(call: ForwardApnsToken { state: other_state }, verdict: enrolled_verdict)
    && !enrolment_call_admitted(call: ForwardApnsToken { state: other_state }, verdict: wrong_verdict)
    && stall_is_below_ceiling(s: stall)
    && trigger_is_admitted(admission: stall_trigger_admission(s: stall))
    && string_contains(s: report, pattern: stall.subject)
    && string_contains(s: report, pattern: "STALLED")
    && (all_guarantee_stalls |> any(x => x.subject == stall.subject))
}

// THE CONSUMER IS DECLARED, AND REACHABLE FROM THE CLOSURE THAT HOLDS EVERY LATER-CONSUMER ROW. A row
// nobody can enumerate is a comment: this asks the closure for its rows and requires this one.
test fn the_enrolment_state_generator_frontier_row_is_registered_in_the_closure() -> Bool {
  let rows = approve_ios_enrolment_state_generator_frontier_rows
  (1 == list_length(items: rows))
    && (rows |> any(r => census_closure_frontier_rows() |> any(c => frontier_subject_eq(a: c.subject, b: r.subject))))
}
