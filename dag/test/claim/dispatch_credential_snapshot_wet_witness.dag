test fn a_replaced_receipt_does_not_authenticate_held_writable_bytes() -> Bool {
  let dir = fx_dir(label: "replace-red")
  let content = "declared-version-bytes\n"
  let wrote = dir != "" && Filesystem.Write(path: fx_custody(dir: dir), content: content).success
  let decl = fx_declaration(dir: dir)
  let held_rec = fx_receipt_for(decl: decl, content: content, version: fx_version(), placement: decl.path)
  let replacement_rec = fx_receipt_for(
    decl: decl,
    content: content,
    version: "projects/gunbai-secrets/secrets/cursor-api-key-harness/versions/2" as SmResolvedVersionIdentity,
    placement: decl.path,
  )
  let dest = host_custody_export_receipt_path(placed_path: decl.path) as String
  let valid_path = join([dir, "/valid-receipt"], "")
  let planted_held = wrote && fx_plant_receipt(decl: decl, body: host_custody_export_receipt_wire(receipt: held_rec))
  let made_writable = planted_held && shell.Exec.RunArgv(program: "chmod", arguments: ["0660", dest]).exit_code == 0
  let planted_valid = made_writable && Filesystem.WriteOwnerOnly(
    path: valid_path,
    content: host_custody_export_receipt_wire(receipt: replacement_rec),
  ).success && shell.Chmod.OwnerReadWriteFile(path: valid_path as FilePath).success
  let dir_obs = observe_snapshot_receipt_directory(receipt_path: dest, declared: decl)
  let body_prog = posix_sh_receipt_object_body_program()
  let ran = match body_prog {
    Rejected { diagnostics: _ } => false
    Accepted { value: body, diagnostics: _ } =>
      planted_valid && match dir_obs {
        SnapshotReceiptDirectoryDecisionRefused { reason: _ } => false
        SnapshotReceiptDirectoryAsDeclared => {
          let run = shell.Exec.RunArgv(
            program: "sh",
            arguments: [
              "-c",
              "exec < \"$0\"\nmv -- \"$1\" \"$2\"\nsh -c \"$3\" \"$2\"",
              dest,
              valid_path,
              dest,
              body,
            ],
          )
          run.exit_code == 0 && match snapshot_receipt_join_from_object_bytes(
            declared: decl,
            custody_buffer: content,
            object_stdout: run.stdout,
          ) {
            SnapshotReceiptJoinRefused { reason } =>
              match reason { SnapshotReceiptGroupOrOtherWritable => true  _ => false }
            SnapshotReceiptJoined { receipt: _ } => false
          }
        }
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ran && cleaned
}

test fn a_group_writable_directory_refuses_before_the_custody_read() -> Bool {
  let dir = fx_dir(label: "dir-writable")
  let wrote = dir != "" && Filesystem.Write(path: fx_custody(dir: dir), content: "published\n").success
  let decl = fx_declaration(dir: dir)
  let rec = fx_receipt_for(decl: decl, content: "published\n", version: fx_version(), placement: decl.path)
  let planted = wrote && fx_plant_receipt(decl: decl, body: host_custody_export_receipt_wire(receipt: rec))
  let opened_dir = planted && shell.Exec.RunArgv(program: "chmod", arguments: ["0770", dir]).exit_code == 0
  let removed_custody = opened_dir && shell.Remove.FileForce(path: fx_custody(dir: dir) as FilePath).success
  let ok = removed_custody && match fx_run_take(dir: dir, attempt: fx_unlaunched_attempt(), executor: ClaudeFromSnapshot) {
    DispatchSnapshotRefused { reason } =>
      match reason {
        SnapshotReceiptDirectoryGroupOrOtherWritable => true
        SnapshotCustodyUnreadable { path: _, detail: _ } => false
        _ => false
      }
    DispatchSnapshotTaken { snapshot: _ } => false
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn a_character_device_on_held_stdin_is_not_a_regular_receipt() -> Bool {
  let dir = fx_dir(label: "dev-null")
  let content = "published\n"
  let wrote = dir != "" && Filesystem.Write(path: fx_custody(dir: dir), content: content).success
  let decl = fx_declaration(dir: dir)
  let body_prog = posix_sh_receipt_object_body_program()
  let ran = match body_prog {
    Rejected { diagnostics: _ } => false
    Accepted { value: body, diagnostics: _ } =>
      if !wrote {
        false
      } else {
        let run = shell.Exec.RunArgv(
          program: "sh",
          arguments: ["-c", "exec < \"$0\"\nsh -c \"$1\" \"$0\"", "/dev/null", body],
        )
        run.exit_code == 0 && match snapshot_receipt_join_from_object_bytes(
          declared: decl,
          custody_buffer: content,
          object_stdout: run.stdout,
        ) {
          SnapshotReceiptJoinRefused { reason } =>
            match reason { SnapshotReceiptNotRegularFile => true  _ => false }
          SnapshotReceiptJoined { receipt: _ } => false
        }
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ran && cleaned
}

test fn a_fifo_object_read_refuses_at_the_timeout() -> Bool {
  let dir = fx_dir(label: "fifo-timeout")
  let fifo_path = join([dir, "/fifo-receipt"], "")
  let made = dir != "" && shell.Exec.RunArgv(program: "mkfifo", arguments: [fifo_path]).exit_code == 0
  let ok = made && match read_snapshot_receipt_object(receipt_path: fifo_path as NonEmptyStr) {
    SnapshotReceiptObjectReadOk { stdout: _ } => false
    SnapshotReceiptObjectReadRefused { reason } =>
      match reason {
        SnapshotReceiptReadTimedOut { path: _ } => true
        _ => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}
