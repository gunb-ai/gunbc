fn fx_numeric_version() -> SmResolvedVersionIdentity {
  join(
    ["projects/", fleet_secrets_project_number, "/secrets/", cursor_api_key_harness_secret_id as String, "/versions/1"],
    "",
  ) as SmResolvedVersionIdentity
}

fn fx_take_version(
  dir: String,
  content: String,
  attempt: DispatchAttempt,
  executor: SnapshotExecutor,
  version: SmResolvedVersionIdentity,
) -> DispatchCredentialSnapshot {
  if dir == "" {
    DispatchSnapshotRefused { reason: SnapshotCustodyUnreadable { path: "/" as NonEmptyStr, detail: "the fixture directory was not created" } }
  } else {
    let wrote = Filesystem.Write(path: fx_custody(dir: dir), content: content)
    if !wrote.success {
      DispatchSnapshotRefused { reason: SnapshotCustodyUnreadable { path: fx_custody(dir: dir) as NonEmptyStr, detail: wrote.error } }
    } else {
      let decl = fx_declaration(dir: dir)
      let rec = fx_receipt_for(decl: decl, content: content, version: version, placement: decl.path)
      if !fx_plant_receipt(decl: decl, body: host_custody_export_receipt_wire(receipt: rec)) {
        DispatchSnapshotRefused { reason: SnapshotReceiptUnreadable { path: host_custody_export_receipt_path(placed_path: decl.path), detail: "fixture receipt was not written" } }
      } else {
        dispatch_credential_snapshot_take(attempt: attempt, executor: executor, custody: decl\)
      }
    }
  }
}

test fn a_fleet_numeric_receipt_is_accepted_with_the_fleet_project_id() -> Bool {
  let dir = fx_dir(label: "numeric-pos")
  let content = "numeric-fleet-bytes\n"
  let ok = match fx_take_version(
    dir: dir,
    content: content,
    attempt: fx_unlaunched_attempt(),
    executor: CursorFromSnapshot,
    version: fx_numeric_version(),
  ) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      (taken_credential_snapshot_generation(snapshot: snapshot).sm_version as String) == (fx_numeric_version() as String)
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

