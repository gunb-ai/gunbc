module test.claim.unicode_ident_xid_grounding


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn unicode_ident_xid_grounding_holds() -> Bool {
  let e_acute_start = is_xid_start(cp: 233)
  let alpha_start = is_xid_start(cp: 945)
  let digit_not_start = is_xid_start(cp: 48) == false
  let digit_is_continue = is_xid_continue(cp: 48)
  let emoji_start = is_emoji_ident(cp: 128512)
  let nbsp_not_xid = is_xid_start(cp: 160) == false
  e_acute_start && alpha_start && digit_not_start && digit_is_continue
    && emoji_start && nbsp_not_xid
}
