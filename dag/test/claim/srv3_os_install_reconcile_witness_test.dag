module test.claim.srv3_os_install_reconcile

import std.logic { Bool }
import std.types { NonEmptyStr, Timestamp }
import std.temporal_effect {
  PlanAwaitApproval,
  PlanApply,
  GrantAbsent,
  GrantActive,
  DurableApprovalGrant,
  NoPriorReceipt,
}
import gunbc.os_install_deduction {
  CompleteForUnattended,
  KvmFirmwareIdleObserved,
}
import gunbc.srv3_os_install_reconcile {
  reconcile_srv3_os_install_dry_run_fixture,
  srv3_held_lease_from_serve,
  boot_once_apply_read_back_ok,
  parse_durable_approval_grant_file,
  plan_boot_once_cd_step,
  parse_observed_at_from_stdout,
}
import gunbc.srv3_os_install_reconcile_types {
  DeductionRuntimePresent,
  srv3_install_effect_attempt_intent,
}
import gunbc.srv3_os_install_reconcile_receipt {
  srv3_install_reconcile_receipt_line,
  srv3_install_reconcile_full_receipt,
}
import gunbc.srv3_os_install_diagnostic {
  srv3_os_install_attempt_intent,
  Srv3InstallDebugObservation,
  ServeObserved,
  ServeProcessesPresent,
  ServePortListening,
  TokenPresent,
  IsoPresent,
  WebsocketUpgradeAccepted,
  AttachedToExpectedServe,
  BootOverrideConsumedNoInstallEvidence,
  RedfishBootObservation,
  BootProgressNone,
  SolConsoleContentObservation,
}
import gunbc.srv3_seeded_install_media { srv3_seeded_install_media_content_hash }
import gunbc.network_identity_subsumption { srv3_pre_install_lease_table }
import extdeps.bmc.types { BootOverrideDisabled, BootTargetNone, BootOverrideOnce, BootTargetCd, On }
import extdeps.bmc.webui.nbd_proxy_serve { srv3_nbd_proxy_local_port }
import std.measure { byte_size }

data witness_uefi_stuck_observation: Srv3InstallDebugObservation = Srv3InstallDebugObservation {
  actuator_serve: ServeObserved {
    process: ServeProcessesPresent,
    port: ServePortListening {
      port: srv3_nbd_proxy_local_port,
      owner_matches_expected: true,
    },
    session: TokenPresent,
    iso: IsoPresent { observed_content_hash: srv3_seeded_install_media_content_hash },
  },
  bmc_websocket: WebsocketUpgradeAccepted,
  redfish_boot: RedfishBootObservation {
    power_state: On,
    boot_override_enabled: BootOverrideDisabled,
    boot_override_target: BootTargetNone,
    boot_progress: BootProgressNone,
  },
  virtual_media_session: AttachedToExpectedServe,
  sol: Present {
    value: SolConsoleContentObservation {
      bytes_captured: byte_size(0),
      duration_ms: 3600000,
      contains_grub: false,
      contains_subiquity: false,
      contains_autoinstall: false,
      contains_firmware_menu: true,
      contains_error: false,
      capture_available: true,
    }
  },
  router_lease_table: Present { value: srv3_pre_install_lease_table },
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 3600000 },
}

data witness_router_unknown_observation: Srv3InstallDebugObservation = Srv3InstallDebugObservation {
  actuator_serve: witness_uefi_stuck_observation.actuator_serve,
  bmc_websocket: witness_uefi_stuck_observation.bmc_websocket,
  redfish_boot: witness_uefi_stuck_observation.redfish_boot,
  virtual_media_session: witness_uefi_stuck_observation.virtual_media_session,
  sol: witness_uefi_stuck_observation.sol,
  router_lease_table: Absent,
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 3600000 },
}

test fn reconcile_preflight_is_complete_for_unattended() -> Bool {
  let result = reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  match result.preflight {
    CompleteForUnattended => true
    _ => false
  }
}

test fn reconcile_uefi_stuck_maps_kvm_firmware_idle() -> Bool {
  let result = reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  match result.diagnostic {
    BootOverrideConsumedNoInstallEvidence => true
    _ => false
  }
    && match result.deduction_runtime {
      DeductionRuntimePresent { verdict: KvmFirmwareIdleObserved } => true
      _ => false
    }
}

test fn reconcile_uefi_stuck_plans_boot_once_awaiting_approval() -> Bool {
  let result = reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  result.pending_step_id == ("boot-once-cd" as NonEmptyStr)
    && match result.temporal_plan {
      PlanAwaitApproval { escalation_id: e } =>
        e == ("srv3-boot-once-cd" as NonEmptyStr)
      _ => false
    }
}

test fn reconcile_receipt_line_names_preflight_and_deduction() -> Bool {
  let line = srv3_install_reconcile_receipt_line(
    result: reconcile_srv3_os_install_dry_run_fixture(observation: witness_uefi_stuck_observation),
  )
  string_contains(s: line, pattern: "preflight=CompleteForUnattended")
    && string_contains(s: line, pattern: "deduction_runtime=KvmFirmwareIdleObserved")
    && string_contains(s: line, pattern: "Srv3InstallReconcileReceipt:")
}

test fn reconcile_full_receipt_typed_router_and_virtual_media() -> Bool {
  let observation = witness_uefi_stuck_observation
  let result = reconcile_srv3_os_install_dry_run_fixture(observation: observation)
  let lease = srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let receipt = srv3_install_reconcile_full_receipt(
    result: result,
    intent: srv3_os_install_attempt_intent,
    observation: observation,
    grant: GrantAbsent,
    prior: NoPriorReceipt,
    lease: lease,
    git_branch: "witness" as NonEmptyStr,
    git_commit: "witness" as NonEmptyStr,
  )
  string_contains(s: receipt, pattern: "router_lease_state=OnlyBmcLeasePresent")
    && string_contains(s: receipt, pattern: "virtual_media_observation=AttachedExpectedIso")
    && string_contains(s: receipt, pattern: "serve_lease_state=NbdServeLeaseRunningExpected")
    && string_contains(s: receipt, pattern: "boot_override_consumed=true")
}

test fn reconcile_full_receipt_router_unknown_operator_required() -> Bool {
  let observation = witness_router_unknown_observation
  let result = reconcile_srv3_os_install_dry_run_fixture(observation: observation)
  let lease = srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let receipt = srv3_install_reconcile_full_receipt(
    result: result,
    intent: srv3_os_install_attempt_intent,
    observation: observation,
    grant: GrantAbsent,
    prior: NoPriorReceipt,
    lease: lease,
    git_branch: "witness" as NonEmptyStr,
    git_commit: "witness" as NonEmptyStr,
  )
  string_contains(s: receipt, pattern: "router_lease_state=RouterLeaseUnknownOperatorRequired")
}

data witness_active_boot_once_grant: DurableApprovalGrant = GrantActive {
  escalation_id: "srv3-boot-once-cd" as NonEmptyStr,
  intent_hash: srv3_seeded_install_media_content_hash,
  granted_by: "operator" as NonEmptyStr,
  granted_at: "2026-07-03T00:00:00Z",
  expires_at: "2026-07-04T00:00:00Z",
}

test fn reconcile_active_grant_plans_boot_once_apply() -> Bool {
  let lease = srv3_held_lease_from_serve(serve: witness_uefi_stuck_observation.actuator_serve)
  match plan_boot_once_cd_step(
    intent: srv3_install_effect_attempt_intent,
    escalation_id: "srv3-boot-once-cd" as NonEmptyStr,
    grant: witness_active_boot_once_grant,
    lease: lease,
    prior: NoPriorReceipt,
    observed_at: "2026-07-03T01:00:00Z" as Timestamp,
  ) {
    PlanApply { step_id: s } => s == ("boot-once-cd" as NonEmptyStr)
    _ => false
  }
}

data witness_post_boot_armed_observation: Srv3InstallDebugObservation = Srv3InstallDebugObservation {
  actuator_serve: witness_uefi_stuck_observation.actuator_serve,
  bmc_websocket: witness_uefi_stuck_observation.bmc_websocket,
  redfish_boot: RedfishBootObservation {
    power_state: On,
    boot_override_enabled: BootOverrideOnce,
    boot_override_target: BootTargetCd,
    boot_progress: BootProgressNone,
  },
  virtual_media_session: witness_uefi_stuck_observation.virtual_media_session,
  sol: witness_uefi_stuck_observation.sol,
  router_lease_table: witness_uefi_stuck_observation.router_lease_table,
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 60000 },
}

data witness_ready_to_boot_pre_observation: Srv3InstallDebugObservation = Srv3InstallDebugObservation {
  actuator_serve: witness_uefi_stuck_observation.actuator_serve,
  bmc_websocket: witness_uefi_stuck_observation.bmc_websocket,
  redfish_boot: witness_uefi_stuck_observation.redfish_boot,
  virtual_media_session: witness_uefi_stuck_observation.virtual_media_session,
  sol: witness_uefi_stuck_observation.sol,
  router_lease_table: witness_uefi_stuck_observation.router_lease_table,
  kvm: Absent,
  elapsed_since_boot_once_ms: Absent,
}

data witness_ready_to_boot_post_consumed_observation: Srv3InstallDebugObservation = Srv3InstallDebugObservation {
  actuator_serve: witness_ready_to_boot_pre_observation.actuator_serve,
  bmc_websocket: witness_ready_to_boot_pre_observation.bmc_websocket,
  redfish_boot: witness_ready_to_boot_pre_observation.redfish_boot,
  virtual_media_session: witness_ready_to_boot_pre_observation.virtual_media_session,
  sol: witness_ready_to_boot_pre_observation.sol,
  router_lease_table: witness_ready_to_boot_pre_observation.router_lease_table,
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 45000 },
}

test fn reconcile_boot_once_read_back_ok_rejects_noop_when_already_consumed() -> Bool {
  !boot_once_apply_read_back_ok(
    pre: witness_uefi_stuck_observation,
    post: witness_uefi_stuck_observation,
    apply_succeeded: true,
  )
}

test fn reconcile_boot_once_read_back_ok_rejects_armed_to_consumed_without_install_progress() -> Bool {
  !boot_once_apply_read_back_ok(
    pre: witness_post_boot_armed_observation,
    post: witness_uefi_stuck_observation,
    apply_succeeded: true,
  )
}

test fn reconcile_boot_once_read_back_ok_rejects_elapsed_only_without_install_progress() -> Bool {
  !boot_once_apply_read_back_ok(
    pre: witness_ready_to_boot_pre_observation,
    post: witness_ready_to_boot_post_consumed_observation,
    apply_succeeded: true,
  )
}

test fn reconcile_boot_once_read_back_ok_rejects_still_armed() -> Bool {
  !boot_once_apply_read_back_ok(
    pre: witness_uefi_stuck_observation,
    post: witness_post_boot_armed_observation,
    apply_succeeded: true,
  )
}

test fn parse_observed_at_from_stdout_absent_without_surface() -> Bool {
  match parse_observed_at_from_stdout(stdout: "Srv3InstallObserveReceipt: surface=serve\n") {
    Absent => true
    _ => false
  }
}

test fn parse_observed_at_from_stdout_present_on_surface_line() -> Bool {
  match parse_observed_at_from_stdout(
    stdout: "Srv3InstallObserveReceipt: surface=observed_at=2026-07-03T12:00:00Z\n",
  ) {
    Present { value: t } => t == "2026-07-03T12:00:00Z"
    _ => false
  }
}

test fn reconcile_parse_durable_grant_file_accepts_matching_intent() -> Bool {
  let intent_hash = srv3_seeded_install_media_content_hash as String
  let contents = concat(
    "Srv3InstallApprovalGrant: escalation_id=srv3-boot-once-cd intent_hash=",
    concat(
      intent_hash,
      " granted_by=operator granted_at=2026-07-03T00:00:00Z expires_at=2026-07-04T00:00:00Z",
    ),
  )
  match parse_durable_approval_grant_file(contents: contents) {
    GrantActive { escalation_id: e, intent_hash: h, granted_by: _, granted_at: _, expires_at: _ } =>
      e == ("srv3-boot-once-cd" as NonEmptyStr) && h == srv3_seeded_install_media_content_hash
    _ => false
  }
}

test fn reconcile_parse_durable_grant_file_strips_trailing_newline_on_expires_at() -> Bool {
  let intent_hash = srv3_seeded_install_media_content_hash as String
  let contents = concat(
    "Srv3InstallApprovalGrant: escalation_id=srv3-boot-once-cd intent_hash=",
    concat(
      intent_hash,
      " granted_by=operator granted_at=2026-07-03T00:00:00Z expires_at=2026-07-04T00:00:00Z\n",
    ),
  )
  match parse_durable_approval_grant_file(contents: contents) {
    GrantActive { escalation_id: _, intent_hash: _, granted_by: _, granted_at: _, expires_at: exp } =>
      exp == "2026-07-04T00:00:00Z"
    _ => false
  }
}
