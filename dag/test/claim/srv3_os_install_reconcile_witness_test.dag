module test.claim.srv3_os_install_reconcile


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data witness_uefi_stuck_observation: gunbc.srv3_os_install_diagnostic.Srv3InstallDebugObservation = gunbc.srv3_os_install_diagnostic.Srv3InstallDebugObservation {
  actuator_serve: gunbc.srv3_os_install_diagnostic.ServeObserved {
    process: gunbc.srv3_os_install_diagnostic.ServeProcessesPresent,
    port: gunbc.srv3_os_install_diagnostic.ServePortListening {
      port: extdeps.bmc.webui.nbd_proxy_serve.srv3_nbd_proxy_local_port,
      owner_matches_expected: true,
    },
    session: gunbc.srv3_os_install_diagnostic.TokenPresent,
    iso: gunbc.srv3_os_install_diagnostic.IsoPresent { observed_content_hash: gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash },
  },
  bmc_websocket: gunbc.srv3_os_install_diagnostic.WebsocketUpgradeAccepted,
  redfish_boot: gunbc.srv3_os_install_diagnostic.RedfishBootObservation {
    power_state: On,
    boot_override_enabled: BootOverrideDisabled,
    boot_override_target: BootTargetNone,
    boot_progress: gunbc.srv3_os_install_diagnostic.BootProgressNone,
  },
  virtual_media_session: gunbc.srv3_os_install_diagnostic.AttachedToExpectedServe,
  sol: Present {
    value: gunbc.srv3_os_install_diagnostic.SolConsoleContentObservation {
      bytes_captured: std.measure.byte_size(0),
      duration_ms: 3600000,
      contains_grub: false,
      contains_subiquity: false,
      contains_autoinstall: false,
      contains_firmware_menu: true,
      contains_error: false,
      capture_available: true,
    }
  },
  router_lease_table: Present { value: gunbc.network_identity_subsumption.srv3_pre_install_lease_table },
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 3600000 },
}

data witness_router_unknown_observation: gunbc.srv3_os_install_diagnostic.Srv3InstallDebugObservation = gunbc.srv3_os_install_diagnostic.Srv3InstallDebugObservation {
  actuator_serve: witness_uefi_stuck_observation.actuator_serve,
  bmc_websocket: witness_uefi_stuck_observation.bmc_websocket,
  redfish_boot: witness_uefi_stuck_observation.redfish_boot,
  virtual_media_session: witness_uefi_stuck_observation.virtual_media_session,
  sol: witness_uefi_stuck_observation.sol,
  router_lease_table: Absent,
  kvm: Absent,
  elapsed_since_boot_once_ms: Present { value: 3600000 },
}

test fn reconcile_preflight_is_complete_for_unattended() -> Bool {
  let result = gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  match result.preflight {
    CompleteForUnattended => true
    _ => false
  }
}

test fn reconcile_uefi_stuck_maps_kvm_firmware_idle() -> Bool {
  let result = gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  match result.diagnostic {
    BootOverrideConsumedNoInstallEvidence => true
    _ => false
  }
    && match result.deduction_runtime {
      gunbc.srv3_os_install_reconcile_types.DeductionRuntimePresent { verdict: gunbc.os_install_deduction.KvmFirmwareIdleObserved } => true
      _ => false
    }
}

test fn reconcile_uefi_stuck_plans_boot_once_awaiting_approval() -> Bool {
  let result = gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(
    observation: witness_uefi_stuck_observation,
  )
  result.pending_step_id == ("boot-once-cd" as std.types.NonEmptyStr)
    && match result.temporal_plan {
      std.temporal_effect.PlanAwaitApproval { escalation_id: e } =>
        e == ("srv3-boot-once-cd" as std.types.NonEmptyStr)
      _ => false
    }
}

test fn reconcile_receipt_line_names_preflight_and_deduction() -> Bool {
  let line = gunbc.srv3_os_install_reconcile_receipt.srv3_install_reconcile_receipt_line(
    result: gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(observation: witness_uefi_stuck_observation),
  )
  string_contains(s: line, pattern: "preflight=CompleteForUnattended")
    && string_contains(s: line, pattern: "deduction_runtime=KvmFirmwareIdleObserved")
    && string_contains(s: line, pattern: "Srv3InstallReconcileReceipt:")
}

test fn reconcile_full_receipt_typed_router_and_virtual_media() -> Bool {
  let observation = witness_uefi_stuck_observation
  let result = gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(observation: observation)
  let lease = gunbc.srv3_os_install_reconcile.srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let receipt = gunbc.srv3_os_install_reconcile_receipt.srv3_install_reconcile_full_receipt(
    result: result,
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
    observation: observation,
    grant: std.temporal_effect.GrantAbsent,
    prior: std.temporal_effect.NoPriorReceipt,
    lease: lease,
    git_branch: "witness" as std.types.NonEmptyStr,
    git_commit: "witness" as std.types.NonEmptyStr,
  )
  string_contains(s: receipt, pattern: "router_lease_state=OnlyBmcLeasePresent")
    && string_contains(s: receipt, pattern: "virtual_media_observation=AttachedExpectedIso")
    && string_contains(s: receipt, pattern: "serve_lease_state=NbdServeLeaseRunningExpected")
    && string_contains(s: receipt, pattern: "boot_override_consumed=true")
}

test fn reconcile_full_receipt_router_unknown_operator_required() -> Bool {
  let observation = witness_router_unknown_observation
  let result = gunbc.srv3_os_install_reconcile.reconcile_srv3_os_install_dry_run_fixture(observation: observation)
  let lease = gunbc.srv3_os_install_reconcile.srv3_held_lease_from_serve(serve: observation.actuator_serve)
  let receipt = gunbc.srv3_os_install_reconcile_receipt.srv3_install_reconcile_full_receipt(
    result: result,
    intent: gunbc.srv3_os_install_diagnostic.srv3_os_install_attempt_intent,
    observation: observation,
    grant: std.temporal_effect.GrantAbsent,
    prior: std.temporal_effect.NoPriorReceipt,
    lease: lease,
    git_branch: "witness" as std.types.NonEmptyStr,
    git_commit: "witness" as std.types.NonEmptyStr,
  )
  string_contains(s: receipt, pattern: "router_lease_state=RouterLeaseUnknownOperatorRequired")
}

data witness_active_boot_once_grant: DurableApprovalGrant = std.temporal_effect.GrantActive {
  escalation_id: "srv3-boot-once-cd" as std.types.NonEmptyStr,
  intent_hash: gunbc.srv3_seeded_install_media_artifact.srv3_seeded_install_media_content_hash,
  granted_by: "operator" as std.types.NonEmptyStr,
  granted_at: "2026-07-03T00:00:00Z",
  expires_at: "2026-07-04T00:00:00Z",
}

test fn reconcile_active_grant_plans_boot_once_apply() -> Bool {
  let lease = gunbc.srv3_os_install_reconcile.srv3_held_lease_from_serve(serve: witness_uefi_stuck_observation.actuator_serve)
  match gunbc.srv3_os_install_reconcile.plan_boot_once_cd_step(
    intent: gunbc.srv3_os_install_reconcile_types.srv3_install_effect_attempt_intent,
    escalation_id: "srv3-boot-once-cd" as std.types.NonEmptyStr,
    grant: witness_active_boot_once_grant,
    lease: lease,
    prior: std.temporal_effect.NoPriorReceipt,
    observed_at: "2026-07-03T01:00:00Z" as std.types.Timestamp,
  ) {
    std.temporal_effect.PlanApply { step_id: s } => s == ("boot-once-cd" as std.types.NonEmptyStr)
    _ => false
  }
}

