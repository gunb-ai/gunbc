module test.claim.data_reference_kind_from_resolved_node

import std.logic { Bool }
import std.types { String }
import std.measure { Gigabyte }
import extdeps.vendor.gigabyte { gigabyte }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A DATA REFERENCE IS CLASSIFIED BY THE DECLARATION IT RESOLVES TO, NOT BY A SAME-SPELLED ITEM
// ELSEWHERE. `gigabyte` here is extdeps.vendor.gigabyte's `data`, imported by name; std.measure,
// also in scope, declares `fn gigabyte`. The evaluator used to take the item kind from a bare-name
// registry projection that keeps one homonym in hash-seed order, so on some processes this reference
// evaluated as a function and the field read refused ("cannot access field 'legal_name' on Fn").
// The kind now comes from the resolved node. This is the production homonym, not a synthetic one;
// the isolated four-module geometry is stern-bear-703's fixture on gunbc#11062.
//
// A PROBABILISTIC REGRESSION CONTROL, AND NEVER THIS CLASS'S COVERAGE. A reintroduced fork reds this
// only on processes whose hash seed puts the `fn` last -- about 42% of runs at the rate measured
// when it was written -- so one run misses a regression about 58% of the time, and repeating the
// assertion in-process cannot help because the seed is per process. Over k pushes a reintroduction
// survives with probability about 0.58^k: caught eventually, not reliably at the grain that matters,
// which is one PR. If asked whether this class is caught, the answer is the N-run comparison on
// gunbc#11065 (control 10/24 failed, repair 0/24), not a green run of this witness.
//
// THE CEILING IS NOT PERMANENT. Refusing an ambiguous bare name that reaches the shared slot -- the
// layer after this repair -- turns this behavioural control into a structural refusal: the ambiguity
// becomes unwritable instead of merely unlikely to be observed. This witness's weakness is the reason
// that layer exists.
test fn a_data_reference_is_classified_by_the_declaration_it_resolves_to() -> Bool {
  (gigabyte.legal_name as String) == "GIGA-BYTE Technology Co., Ltd."
}
