module test.claim.codex_initialize_result_disposition_witness

import std.types { Bool, String, Int, NonEmptyStr }
import gunbc.codex_app_server_press {
  disposition_from_initialize_result,
  codex_initialize_result_user_agent_key,
  AccountTripResultOk,
  AccountTripLoginRequiredSignal,
  AccountTripQuotaSignal,
  AccountTripMissing,
  AccountTripNativeCauseUnknown,
  AccountTripNativeCauseNumericCode,
  AccountTripNativeCauseMessageUnreadable,
}
import extdeps.languages.json.emit {
  JsonValue,
  json_object,
  json_kv,
  json_string,
  json_int,
}

// A USER AGENT THAT IS NOT A STRING IS A MISSING USER AGENT, WHICH IS WHAT THIS SITE ALREADY
// SAID ABOUT EVERY OTHER SHAPE IT COULD READ. The member being absent, duplicated, or hanging off
// something that is not an object all answer AccountTripMissing; a member present but carrying a
// number is the same fact -- the initialize result did not identify a user agent. The two sibling
// readers in this module, json_rpc_error_message and disposition_from_account_read_result, already
// carry that arm explicitly, so the answer is the module's, not a new choice made here.
//
// The pair is what discriminates: a numeric member and a real user-agent string differ only in the
// VALUE shape, so a green negative cannot be explained by the key being unreadable.

fn initialize_result_with(value: JsonValue) -> JsonValue {
  json_object(
    members: [
      json_kv(key: codex_initialize_result_user_agent_key as String, value: value),
    ],
  )
}

// EACH WITNESS NAMES THE VARIANT IT EXPECTS AND ANSWERS false FOR EVERY OTHER ONE. An earlier
// shape asked `is it missing?` through one shared Boolean predicate, which cost the positive
// control its whole point: `not missing` is satisfied by any of six dispositions, so a reader
// that answered LoginRequiredSignal for a perfectly good user agent would have passed. The
// expected variant is the claim, so it is what each arm pins.

test fn a_non_string_user_agent_is_missing_not_ok() -> Bool {
  match disposition_from_initialize_result(
    result: initialize_result_with(value: json_int(n: 7)),
  ) {
    AccountTripMissing => true
    AccountTripResultOk => false
    AccountTripLoginRequiredSignal => false
    AccountTripQuotaSignal => false
    AccountTripNativeCauseUnknown { message: _ } => false
    AccountTripNativeCauseNumericCode { code: _ } => false
    AccountTripNativeCauseMessageUnreadable => false
  }
}

test fn a_real_user_agent_string_is_still_ok() -> Bool {
  match disposition_from_initialize_result(
    result: initialize_result_with(value: json_string(s: "codex-cli/1.2.3")),
  ) {
    AccountTripResultOk => true
    AccountTripMissing => false
    AccountTripLoginRequiredSignal => false
    AccountTripQuotaSignal => false
    AccountTripNativeCauseUnknown { message: _ } => false
    AccountTripNativeCauseNumericCode { code: _ } => false
    AccountTripNativeCauseMessageUnreadable => false
  }
}
