module test.claim.native_lane_import_refusal

import v2.compiler.compile {
  native_lane_source_facts, native_lane_universe, native_lane_universe_of_facts,
  native_lane_universe_selected
}
import extdeps.bazel.target_pattern {
  TargetPatternParsed, TargetPatternRefused, parse_target_pattern
}
import v2.std.artifact { Artifact, SourceFile }
import v2.std.diagnostic { Accepted, Rejected }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import extdeps.communication.medium { Lossless, Medium }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.text { String }
import v2.std.integer { Int }
import v2.std.algebra { any, contains, fold_list, length }
import std.algebra { list_snoc_item }
import v2.std.collection { List }
import v2.std.compilers.lexing { symbol_intern_lexeme, symbol_lexeme }
import v2.workflow.floor_discovery_source_authority {
  FloorDiscoveryAccepted,
  FloorDiscoveryRefused,
  discover_floor_rows_for_source,
  floor_discovery_finalize_source_outcomes
}
import gunbc.witness_v2_native_route { native_route_default_pattern, native_route_identity_qualified }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE IMPORT REFUSAL, EXERCISED THROUGH THE DERIVATION IT PROTECTS (review 64474 item 5, control
// requirements of 2026-09-12). An `import ` prefix followed by no token used to be SKIPPED by the
// import scan. A skipped import is a NARROWED CLOSURE: the module the line meant to name is never
// walked, its declarations never reach the universe, and the run ends GREEN over a smaller
// population than the source asked for. DESIGN section 5 forbids exactly that arm -- a failure must
// refuse, never widen or narrow -- and narrowing is the worse direction, because it terminates in a
// pass rather than in a visible over-scan.
//
// THE SUBJECT IS native_lane_universe, NOT THE LINE PREDICATE, and that is the whole point of this
// file. An earlier draft asserted on the detector alone. That would have proved the malformed line
// is RECOGNIZED while proving nothing about whether recognition REACHES the verdict -- and a test
// that stops short of the decision it names is the defect this PR already repaired once, when a
// terminal-marker test turned out to be intercepted by an unrelated earlier refusal and had
// silently stopped exercising its own subject. So these rows drive the derivation end to end and
// assert on the Outcome it returns.
//
// THE TWO INGESTS DIFFER IN ONE LINE. Same module header, same declaration, same path: only the
// import line changes. Anything else differing would leave the refusal attributable to the other
// difference.

data malformed_import_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.test.native_lane_import_subject\nimport \nfn subject() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^native_lane_import_malformed_artifact,
    file_path: "src/v2/test/native_lane_import_subject.dag"
  },
  compilation_unit: ^native_lane_import_malformed_cu,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data well_formed_import_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.test.native_lane_import_subject\nimport v2.std.optional { Present }\nfn subject() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^native_lane_import_wellformed_artifact,
    file_path: "src/v2/test/native_lane_import_subject.dag"
  },
  compilation_unit: ^native_lane_import_wellformed_cu,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

// The bare spelling: `import` with only spaces after it TRIMS TO `import`, with no trailing space,
// so a predicate keyed on the prefix `import ` is false for it. The original scan never classified
// this line as an import at all -- the same narrowed closure by a shorter path -- and the first
// version of this witness disagreed with the first version of the predicate, which is how it was
// found. Removing this row restores the blind spot silently.
data bare_import_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.test.native_lane_import_subject\nimport    \nfn subject() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^native_lane_import_bare_artifact,
    file_path: "src/v2/test/native_lane_import_subject.dag"
  },
  compilation_unit: ^native_lane_import_bare_cu,
  source_root: v2.std.cross_tree.import_model.V2Tree
}

// THE POPULATION THE DERIVATION SELECTS, driven end to end rather than through the predicate in
// isolation. `native_lane_universe_module_for_source` spells each IDENTITY as a label and asks
// `target_pattern_matches` at the default pattern instead of asking `native_route_universe_member`
// per module,
// and these two reads discriminate that: the only difference between them is the DECLARED
// NAMESPACE, one inside the `v2.test.` selection and one outside. Same declarations, no imports.
//
// THE PATH THAT MATTERS IS `compilation_unit`, NOT `artifact.file_path`. Discovery is handed
// `symbol_lexeme(sym: read.compilation_unit)` as its entry path, so a placeholder symbol there
// reads as a path not ending in `_test.dag` and the source refuses on test PLACEMENT before
// selection is ever consulted -- which is how an earlier attempt at these arms failed. The interned
// real path is this fixture's load-bearing detail.
//
// NO `live_tree_disposition` ROW IN THE SUPPLIED TEXT, deliberately: absence is accepted and
// defaults, while a present row must carry a supported initializer -- including one would add a way
// for the fixture to fail that has nothing to do with what it tests.
//
// TWO DECLARATIONS IN THE SELECTED MODULE, also deliberately. A consumer that filtered MODULES and
// then took every declaration would pass a one-declaration fixture; carrying two lets the arm tell
// module-grain filtering from the identity-grain filtering this change introduces.
data selection_inside_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.test.selection_probe\n\ntest fn probe_one() -> Bool { true }\n\ntest fn probe_two() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^selection_inside_artifact,
    file_path: "src/v2/test/selection_inside_test.dag"
  },
  compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/test/selection_inside_test.dag"),
  source_root: v2.std.cross_tree.import_model.V2Tree
}

// `v2.testing.` shares the character prefix `v2.test` and is NOT under the `v2.test.` namespace --
// the case the selection separator exists to separate. It must be excluded by SELECTION alone and
// must not refuse the derivation on its way there; were it to refuse, the whole derivation would
// refuse and this pair would prove nothing.
//
// It is also a universe NON-MEMBER, so discovery no longer walks it at all -- the row-count arm
// below reads that as zero enrolled rows, and the refusal arms further down read it as a sidecar
// violation this lane no longer raises.
data selection_outside_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.testing.selection_probe\n\ntest fn probe_one() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^selection_outside_artifact,
    file_path: "src/v2/testing/selection_outside_test.dag"
  },
  compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/testing/selection_outside_test.dag"),
  source_root: v2.std.cross_tree.import_model.V2Tree
}

// A DECLARATION NO LABEL CAN NAME: `all` is a pattern word, so `//pkg:all` never denotes it. Once
// outside the universe (must not refuse the lane) and once inside (must refuse it, typed).
data unlabelable_outside_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.testing.unlabelable_probe\n\ntest fn all() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^unlabelable_outside_artifact,
    file_path: "src/v2/testing/unlabelable_outside_test.dag"
  },
  compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/testing/unlabelable_outside_test.dag"),
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data unlabelable_inside_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "module v2.test.unlabelable_probe\n\ntest fn all() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^unlabelable_inside_artifact,
    file_path: "src/v2/test/unlabelable_inside_test.dag"
  },
  compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/test/unlabelable_inside_test.dag"),
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data unlabelable_outside_ingest: SourceRootIngest = [selection_inside_read, unlabelable_outside_read]
data unlabelable_inside_ingest: SourceRootIngest = [selection_inside_read, unlabelable_inside_read]

data selection_inside_ingest: SourceRootIngest = [selection_inside_read]
data selection_outside_ingest: SourceRootIngest = [selection_outside_read]
data selection_combined_ingest: SourceRootIngest = [selection_inside_read, selection_outside_read]

data malformed_import_ingest: SourceRootIngest = [malformed_import_read]
data well_formed_import_ingest: SourceRootIngest = [well_formed_import_read]
data bare_import_ingest: SourceRootIngest = [bare_import_read]

// RED: the derivation refuses rather than returning a universe over a silently narrowed closure.
test fn a_malformed_import_refuses_the_universe_derivation() -> Bool {
  match native_lane_universe(ingest: malformed_import_ingest) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_import_line_names_no_module
    Accepted { value: _, diagnostics: _ } => false
  }
}

// RED, second spelling: the form the prefix test cannot see.
test fn a_bare_import_refuses_the_universe_derivation() -> Bool {
  match native_lane_universe(ingest: bare_import_ingest) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_import_line_names_no_module
    Accepted { value: _, diagnostics: _ } => false
  }
}

// POSITIVE CONTROL: an ordinary import is admitted, so the refusal above discriminates on the
// malformed line rather than on anything these fixtures share. Without this row the two RED tests
// are satisfied by a derivation that refuses everything.
test fn a_well_formed_import_is_admitted_by_the_derivation() -> Bool {
  match native_lane_universe(ingest: well_formed_import_ingest) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn universe_qualified_names(ingest: SourceRootIngest) -> List<String> {
  match native_lane_universe(ingest: ingest) {
    Rejected { diagnostics: _ } => []
    Accepted { value: universe, diagnostics: _ } =>
      fold_list(
        xs: universe.identities,
        empty: [],
        cons: fn(acc, identity) {
          list_snoc_item(xs: acc, item: native_route_identity_qualified(identity: identity))
        }
      )
  }
}

fn universe_admits(ingest: SourceRootIngest, qualified: String) -> Bool {
  contains(xs: universe_qualified_names(ingest: ingest), item: qualified, eq: fn(a, b) { a == b })
}

fn universe_accepted(ingest: SourceRootIngest) -> Bool {
  match native_lane_universe(ingest: ingest) {
    Rejected { diagnostics: _ } => false
    Accepted { value: _, diagnostics: _ } => true
  }
}

// THE CONTROL THAT MAKES THE EXCLUSION ATTRIBUTABLE, and it asserts ACCEPTANCE rather than a
// population. The derivation finalizes discovery BEFORE selection filters, so a source that
// refused discovery would refuse the whole thing -- meaning an excluded module and a broken one
// both yield no identity, and a population arm alone cannot tell them apart. This says the
// out-of-selection source is ACCEPTED and contributes no identity; the arm below then attributes
// its absence from the combined ingest to selection and to nothing else.
//
// THE NAME IS DELIBERATELY NOT `..._is_discovered_...`, which is what it was called until discovery
// was scoped to the sources that consult it. This source is a universe non-member, so it is no
// longer walked, and an arm whose name claims it was discovered would assert the opposite of what
// the code now does while staying green -- the stale-name defect, one rename ahead of a reader
// citing it as coverage for a walk that no longer happens. Acceptance is what this arm establishes
// and all it establishes.
test fn the_out_of_selection_source_is_accepted_not_refused() -> Bool {
  universe_accepted(ingest: selection_outside_ingest)
  && (length(xs: universe_qualified_names(ingest: selection_outside_ingest)) == 0)
}

// Both declarations of the selected module reach the universe -- the arm a module-grain filter
// would also pass, kept so the identity-grain one can be told apart from it.
test fn every_declaration_of_a_selected_module_reaches_the_universe() -> Bool {
  universe_admits(ingest: selection_inside_ingest, qualified: "v2.test.selection_probe.probe_one")
  && universe_admits(ingest: selection_inside_ingest, qualified: "v2.test.selection_probe.probe_two")
}

// The pair that pins selection in both directions over ONE ingest carrying both sources: a
// selection admitting everything reds the second conjunct, one admitting nothing reds the first.
test fn the_combined_ingest_selects_by_namespace_not_by_character_prefix() -> Bool {
  universe_admits(ingest: selection_combined_ingest, qualified: "v2.test.selection_probe.probe_one")
  && !universe_admits(
    ingest: selection_combined_ingest,
    qualified: "v2.testing.selection_probe.probe_one"
  )
}

// ── an operator's pattern, through the same producer ──
//
// The arms above run the lane's default. These parse a pattern's TEXT -- the argument `gunbc test`
// will hand over -- and run `native_lane_universe_selected`, the producer the default also runs,
// over the same supplied sources. An unparseable pattern yields no universe, so every arm below
// asserts a positive membership and cannot be held green by a parse refusal.
fn selected_qualified_names(ingest: SourceRootIngest, text: String) -> List<String> {
  match parse_target_pattern(text: text) {
    TargetPatternRefused { cause: _ } => []
    TargetPatternParsed { pattern: pattern } =>
      match native_lane_universe_selected(ingest: ingest, pattern: pattern) {
        Rejected { diagnostics: _ } => []
        Accepted { value: universe, diagnostics: _ } =>
          fold_list(
            xs: universe.identities,
            empty: [],
            cons: fn(acc, identity) {
              list_snoc_item(xs: acc, item: native_route_identity_qualified(identity: identity))
            }
          )
      }
  }
}

fn selected_admits(ingest: SourceRootIngest, text: String, qualified: String) -> Bool {
  contains(xs: selected_qualified_names(ingest: ingest, text: text), item: qualified, eq: fn(a, b) { a == b })
}

// A SINGLE TARGET SELECTS ONE DECLARATION of a module that holds two: the identity grain, driven
// end to end. An admit-everything selection reds the second conjunct, admit-nothing the first.
test fn a_single_target_pattern_selects_one_declaration_of_the_universe() -> Bool {
  let text = "//v2/test/selection_probe:probe_one"
  selected_admits(ingest: selection_combined_ingest, text: text, qualified: "v2.test.selection_probe.probe_one")
  && !selected_admits(ingest: selection_combined_ingest, text: text, qualified: "v2.test.selection_probe.probe_two")
  && (length(xs: selected_qualified_names(ingest: selection_combined_ingest, text: text)) == 1)
}

// A PATTERN CANNOT WIDEN THE UNIVERSE. `//v2/testing/...` names a module that discovers cleanly
// but lies outside the floor's `v2.test.` population: the answer is an ACCEPTED EMPTY universe,
// never that module. Admit-everything reds this arm; so would a selection that replaced the
// universe instead of narrowing it.
test fn a_pattern_outside_the_universe_selects_nothing() -> Bool {
  let text = "//v2/testing/..."
  selected_accepted(ingest: selection_combined_ingest, text: text)
  && (length(xs: selected_qualified_names(ingest: selection_combined_ingest, text: text)) == 0)
}

// EXCLUDED IS NOT REFUSED, AND REFUSED IS NOT EXCLUDED. A pattern that selects nothing in a sound
// corpus is an ACCEPTED empty universe; a corpus refusal outside the pattern still refuses the
// derivation -- a narrower question does not make a broken corpus sound.
fn selected_accepted(ingest: SourceRootIngest, text: String) -> Bool {
  match parse_target_pattern(text: text) {
    TargetPatternRefused { cause: _ } => false
    TargetPatternParsed { pattern: pattern } =>
      match native_lane_universe_selected(ingest: ingest, pattern: pattern) {
        Rejected { diagnostics: _ } => false
        Accepted { value: _, diagnostics: _ } => true
      }
  }
}

test fn a_pattern_selecting_nothing_is_accepted_empty_not_refused() -> Bool {
  selected_accepted(ingest: selection_combined_ingest, text: "//elsewhere/...")
  && (length(xs: selected_qualified_names(ingest: selection_combined_ingest, text: "//elsewhere/...")) == 0)
}

test fn a_corpus_refusal_outside_the_pattern_still_refuses() -> Bool {
  !selected_accepted(ingest: malformed_import_ingest, text: "//elsewhere/...")
}

// THE LABEL REFUSAL IS SCOPED TO THE UNIVERSE (review 69555). Outside it, an unlabelable
// declaration is not the lane's population and the derivation is accepted with the in-universe
// member intact; inside it, the same declaration refuses the derivation with its typed cause.
test fn an_unlabelable_declaration_outside_the_universe_does_not_refuse() -> Bool {
  universe_admits(ingest: unlabelable_outside_ingest, qualified: "v2.test.selection_probe.probe_one")
}

test fn an_unlabelable_declaration_inside_the_universe_refuses_typed() -> Bool {
  match native_lane_universe(ingest: unlabelable_inside_ingest) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_identity_label_refused
    Accepted { value: _, diagnostics: _ } => false
  }
}

// THE FILE-AS-TARGET SPELLING REFUSES AND NAMES THE RIGHT ONE (manager ruling 2026-09-21). Under
// the lane's correspondence `//v2/test:selection_probe` asks for a DECLARATION named
// `selection_probe` in module `v2.test`; none exists, but module `v2.test.selection_probe` does, so
// the route refuses rather than answering with an empty universe, and the detail carries the
// module spelling. A route that returned universe 0 here reds the first conjunct.
test fn a_single_target_naming_a_module_refuses_with_the_module_spelling() -> Bool {
  match parse_target_pattern(text: "//v2/test:selection_probe") {
    TargetPatternRefused { cause: _ } => false
    TargetPatternParsed { pattern: pattern } =>
      match native_lane_universe_selected(ingest: selection_combined_ingest, pattern: pattern) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } =>
          d.head.reason == ^native_lane_pattern_names_a_module
            && any(xs: d.tail, predicate: fn(x) {
                 string_contains(s: symbol_lexeme(sym: x.reason), pattern: "//v2/test/selection_probe:all")
               })
      }
  }
}

// The positive side: the spelling the refusal suggests selects the module's declarations.
test fn the_suggested_module_spelling_selects_the_module() -> Bool {
  selected_admits(ingest: selection_combined_ingest, text: "//v2/test/selection_probe:all", qualified: "v2.test.selection_probe.probe_one")
  && selected_admits(ingest: selection_combined_ingest, text: "//v2/test/selection_probe:all", qualified: "v2.test.selection_probe.probe_two")
}

// ── the facts-taking entry carries every refusal ──────────────────────────────────────────────
//
// WHAT THESE ARMS ESTABLISH, AND THE ARM SHAPE THEY DELIBERATELY DO NOT USE. The lane's rendered
// main binds `source_facts` for the closure derivation and then derived the universe from the
// INGEST again, re-running the whole-corpus discovery fold it already held. The repair splits the
// producer so the main hands in the facts it holds.
//
// THE OBVIOUS WITNESS FOR THAT IS A DECORATION, AND IT WAS WRITTEN AND DELETED HERE RATHER THAN
// SHIPPED. Pairing the two entries over one fixture and asserting they agree reads like a strong
// equivalence control. It is not one: after the split `native_lane_universe_selected(ingest, p)` IS
// `native_lane_universe_of_facts(native_lane_source_facts(ingest), p)`, so the comparison is an
// expression against itself -- permanently green by construction. A mutation dropping a refusal
// from the shared body moves BOTH sides and the agreement still holds. DESIGN section 4b calls that
// worse than absent, because it is cited as coverage. (Measured: bypassing the malformed-import
// check failed four arms here and left the two accepted-path controls green.)
//
// So these arms assert the FACTS-TAKING ENTRY DIRECTLY, over facts derived by a separate call and
// handed in -- coverage that did not exist before, since nothing invoked that body with externally
// supplied facts. The three fixtures cover both refusal causes and the accepted path rather than
// three files; an arm over the accepted path alone would stay green if the entry refused nothing.
//
// WHAT THEY CANNOT REACH, said so the set is not over-read: whether the RENDERED MAIN passes the
// facts it already bound rather than re-deriving them. That is a property of emitted Rust, so no
// `.dag` arm holds it -- and a SUCCESSFUL NATIVE BUILD DOES NOT HOLD IT EITHER, because a build
// proves the emitted program compiles, not that a second fold is gone. Closing it means reading
// the produced main and its call path for the carried binding, with the runtime claim taken from
// the lane's existing `[native-cost-partition]` observations.

fn carried_at_default(ingest: SourceRootIngest) -> Bool {
  match native_lane_universe_of_facts(
    facts: native_lane_source_facts(ingest: ingest),
    pattern: native_route_default_pattern()
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_import_line_names_no_module
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn the_facts_taking_entry_admits_the_well_formed_source() -> Bool {
  match native_lane_universe_of_facts(
    facts: native_lane_source_facts(ingest: well_formed_import_ingest),
    pattern: native_route_default_pattern()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn the_facts_taking_entry_keeps_the_malformed_import_refusal() -> Bool {
  carried_at_default(ingest: malformed_import_ingest)
}

test fn the_facts_taking_entry_keeps_the_bare_import_refusal() -> Bool {
  carried_at_default(ingest: bare_import_ingest)
}

// ── discovery is walked where it is consulted, and nowhere else ────────────────────────────────
//
// THE ARM THAT MAKES THE SCOPING OBSERVABLE RATHER THAN ASSERTED. The refusal arms above cannot
// see it: they check what the derivation ANSWERS, and scoping discovery changes what it SPENDS.
// Both fixtures are accepted either way, so a set that only read verdicts would stay green if the
// walk were restored to every file.
//
// The two reads differ in ONE thing -- the declared namespace, `v2.test.` versus `v2.testing.` --
// and both carry `test fn` declarations that discovery would enrol. So rows on the inside read and
// no rows on the outside read is the scoping itself, at the one place it is decidable: the outside
// module is never consulted by `native_lane_label_universe` (its own universe-member guard) nor by
// `native_lane_unowned_row_path` (it declares a module), and the corpus-wide finalize that was its
// only other reader is repository hygiene the required floor owns.
//
// REMOVING THE SCOPING TURNS THIS RED, which is what distinguishes it from a restatement of the
// fixtures: the outside read would enrol its declaration and the second assertion would fail.

// A read with NO `module` header: the one shape whose discovery rows the unowned-row refusal
// reads, and therefore the one that must keep its walk regardless of membership.
data unowned_row_read: DagSourceReadWitness = DagSourceReadWitness {
  source: Medium {
    carried: "test fn orphan_probe() -> Bool { true }\n",
    fidelity: Lossless
  },
  artifact: Artifact {
    kind: SourceFile,
    id: ^unowned_row_artifact,
    file_path: "src/v2/test/unowned_row_test.dag"
  },
  compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/test/unowned_row_test.dag"),
  source_root: v2.std.cross_tree.import_model.V2Tree
}

data unowned_row_ingest: SourceRootIngest = [unowned_row_read]

fn discovery_row_count(ingest: SourceRootIngest) -> Int {
  fold_list(
    xs: native_lane_source_facts(ingest: ingest),
    empty: 0,
    cons: fn(acc, f) { acc + length(xs: f.discovery.rows) }
  )
}

test fn a_universe_member_is_walked_and_an_outsider_is_not() -> Bool {
  (discovery_row_count(ingest: selection_inside_ingest) == 2)
    && (discovery_row_count(ingest: selection_outside_ingest) == 0)
}

// A module-less file keeps its walk, because the unowned-row refusal reads exactly those rows --
// scoping on membership must not reach the arm that has no membership to test.
test fn a_source_declaring_no_module_is_still_walked() -> Bool {
  discovery_row_count(ingest: unowned_row_ingest) > 0
}

// ── the scoping's boundary, read in REFUSALS rather than in row counts ─────────────────────────
//
// WHY THE ROW-COUNT PAIR ABOVE IS NOT ENOUGH. `a_universe_member_is_walked_and_an_outsider_is_not`
// observes what discovery SPENDS. It does not observe what the lane still REFUSES, and refusing is
// the guarantee the scoping actually moves: `floor_discovery_finalize_source_outcomes` refuses on a
// walk failure, a disposition refusal or a sidecar violation, and handing it a zero state for a
// non-member removes that source's ability to refuse. A set that counted rows alone would stay
// green if the finalize were disarmed outright, because a disarmed finalize still enrols the same
// rows.
//
// THE THREE FIXTURES DIFFER FROM EACH OTHER IN ONE PROPERTY, AND FROM THE ACCEPTED ONES IN ONE
// MORE. Each carries `test fn` at a path that does NOT end `_test.dag`, which is the
// `TestMarkedDecl` sidecar violation -- one real refusal cause, reached through the real producer,
// rather than a hand-built walk state. They then differ only in the module header: `v2.test.`
// (member, walked), `v2.testing.` (non-member, not walked), and none at all (no membership to
// test, so walked). Because the violation arm collects a violation INSTEAD of enrolling rows, the
// module-less fixture enrols nothing and therefore does not trip the unowned-row refusal on its
// way to the finalize -- which is what lets the fourth arm attribute its refusal to the finalize.
//
// THE SECOND ARM IS A NARROWING, AND IT IS STATED AS ONE. It asserts that this lane NO LONGER
// refuses a real corpus violation. On its own that reads as a safety regression, so the third arm
// pairs it: the floor's own producer and finalize, over THE SAME BYTES the lane declined to walk,
// still refuse. Without that arm the second is an unwitnessed loss.
//
// BE EXACT ABOUT WHAT THAT THIRD ARM EXECUTES, because it is easy to claim more. It runs
// `discover_floor_rows_for_source` and `floor_discovery_finalize_source_outcomes` -- the producer
// and finalizer THEMSELVES. It does NOT run the host runner and does not demonstrate a failing CI
// exit. That `required_floor_runner` calls that same finalize, and surfaces its refusal as
// `REQUIRED-FLOOR REFUSAL cause=FloorDiscoveryRefused`, is established by SOURCE INSPECTION of the
// runner, not by a newly executed merge-blocking control. The preserved caller is read; the
// preserved computation is run.

// ONE LOCATION, ONE ARTIFACT IDENTITY, ONE SOURCE ROOT -- the three specimens differ in their
// MODULE HEADER AND IN NOTHING ELSE. They are built by one constructor taking only the content, so
// the isolation is STRUCTURAL rather than a promise three hand-copied records keep. An earlier
// revision authored them separately and let the path vary with the namespace
// (`src/v2/test/...` against `src/v2/testing/...`), which is not a cosmetic difference here:
// `compilation_unit` is what discovery receives as its entry path, so it is an operational input.
//
// THE SHARED PATH IS THE DISCRIMINATOR, NOT MERELY TIDINESS. All three sit at a path under
// `src/v2/test/`, so the NON-MEMBER declares `module v2.testing.violation_probe` from a path whose
// prefix looks like a member's. An implementation that decided membership from the PATH rather than
// from the declared module would walk it, raise its violation, and turn
// `a_non_member_sidecar_violation_no_longer_refuses_the_lane` red. With the paths varying alongside
// the namespace, that wrong implementation satisfied every specimen. This is a missing
// discriminator closed, not a defect found in `native_route_universe_member`, which reads the
// declared module today.
//
// The path deliberately does NOT end `_test.dag`: that is what makes `test fn` in the content a
// `TestMarkedDecl` sidecar violation, which is the real refusal cause these arms are built on.
fn violation_read_for(content: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: content, fidelity: Lossless },
    artifact: Artifact {
      kind: SourceFile,
      id: ^violation_probe_artifact,
      file_path: "src/v2/test/violation_probe.dag"
    },
    compilation_unit: symbol_intern_lexeme(lexeme: "src/v2/test/violation_probe.dag"),
    source_root: v2.std.cross_tree.import_model.V2Tree
  }
}

data member_violation_read: DagSourceReadWitness = violation_read_for(
  content: "module v2.test.violation_probe\n\ntest fn probe_one() -> Bool { true }\n"
)

data non_member_violation_read: DagSourceReadWitness = violation_read_for(
  content: "module v2.testing.violation_probe\n\ntest fn probe_one() -> Bool { true }\n"
)

data module_less_violation_read: DagSourceReadWitness = violation_read_for(
  content: "test fn probe_one() -> Bool { true }\n"
)

data member_violation_ingest: SourceRootIngest = [member_violation_read]
data non_member_violation_ingest: SourceRootIngest = [non_member_violation_read]
data module_less_violation_ingest: SourceRootIngest = [module_less_violation_read]

// A WALKED MEMBER STILL REFUSES: the scoping narrowed which sources are walked, not what a walked
// source's violation does. This is the positive control the two narrowing arms are read against.
test fn a_universe_member_sidecar_violation_still_refuses_the_lane() -> Bool {
  match native_lane_universe(ingest: member_violation_ingest) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_universe_derivation_refused
    Accepted { value: _, diagnostics: _ } => false
  }
}

// THE NARROWING ITSELF, asserted rather than implied. Identical content and identical violation,
// one namespace segment away from the arm above. Restore the walk for non-members and this goes
// red -- which is what makes it the discriminating arm for the scoping and not a restatement of
// the row counts.
test fn a_non_member_sidecar_violation_no_longer_refuses_the_lane() -> Bool {
  match native_lane_universe(ingest: non_member_violation_ingest) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// THE PRESERVED CONSUMER, OVER THE SAME BYTES. The required floor reaches this producer and this
// finalize independently of the lane, so the corpus refusal the arm above gave up still exists at
// its home. The content is READ OFF THE FIXTURE rather than restated, so the two arms cannot drift
// apart into agreeing about different sources.
test fn the_required_floor_producer_still_refuses_that_non_member_violation() -> Bool {
  match floor_discovery_finalize_source_outcomes(
    outcomes: [
      discover_floor_rows_for_source(
        repo_path: symbol_lexeme(sym: non_member_violation_read.compilation_unit),
        content: non_member_violation_read.source.carried
      )
    ]
  ) {
    FloorDiscoveryRefused { reason: _ } => true
    FloorDiscoveryAccepted { rows: _ } => false
  }
}

// A MODULE-LESS SOURCE HAS NO MEMBERSHIP TO TEST, so the scoping must not reach it. The row-count
// arm above establishes that such a file is still walked; this one establishes that its walk still
// REFUSES, which is the property the finalize consumer actually needs and the one a zero state
// would silently remove.
test fn a_module_less_sidecar_violation_still_refuses_the_lane() -> Bool {
  match native_lane_universe(ingest: module_less_violation_ingest) {
    Rejected { diagnostics: d } => d.head.reason == ^native_lane_universe_derivation_refused
    Accepted { value: _, diagnostics: _ } => false
  }
}
