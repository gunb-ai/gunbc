module test.claim.credential_confinement_witness

import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE SEALED CREDENTIAL PATHS ARE CONFINED AS CHAINS, NOT AS ONE EDGE. Each probe below is an unrelated
// module handed to the compiler; it enters exactly ONE construction path of the credential carriers
// (a staged constructor, a helper that could assemble a sealed value from independently supplied
// inputs, a witness fixture that returns sealed evidence, or a direct literal of a sealed record), so
// its refusal is that path's. The control names every carrier and enters none, and must refuse at none
// of the walls -- so a red below is attributable to the entry, not to importing the types.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn blocking_class(c: CompileDiagnosticCensus, wanted: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn blocking_at(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data probe_head: String = "module probe_credential_confinement\nimport std.types { String, Int, Bool, Secret }\nimport std.measure { ObservationInstant }\nimport std.credentials { AcquisitionClockReading, AcquisitionClockRead, CredentialValidity, CredentialDeadline, ValidityBasis, acquisition_clock_reading_of, deadline_after }\nimport extdeps.time.rfc3339 { Rfc3339Instant, Rfc3339InstantParse, rfc3339_parse_offset, rfc3339_parse_fields, rfc3339_parse_fraction }\nimport extdeps.cloud.gcp.iam { GcpImpersonatedAccessCredential, GcpImpersonatedAccessBinding, impersonated_access_credential_of }\nimport extdeps.github.app { GitHubInstallationCredential, GitHubInstallationAcquisition, installation_credential_of }\nimport test.claim.credential_validity_witness { fx_gcp_credential, fx_acquisition, incident_credential }\n"

fn probe(body: String) -> CompileDiagnosticCensus {
  census_of(source: concat(probe_head, body))
}

data admission: String = "ConstructorCallAdmissionRefused"
data sealed: String = "SoleConstructorViolation"

test fn a_source_that_only_names_the_carriers_is_refused_at_no_wall() -> Bool {
  let c = probe(body: "fn names(v: CredentialValidity, c: GcpImpersonatedAccessCredential, g: GitHubInstallationCredential, i: Rfc3339Instant) -> Bool { true }\n")
  blocking_class(c: c, wanted: admission) == 0 && blocking_class(c: c, wanted: sealed) == 0
}

test fn an_unrelated_caller_cannot_pair_its_own_monotonic_instant_with_a_wall_reading() -> Bool {
  blocking_class(c: probe(body: "fn forge(m: ObservationInstant, w: Rfc3339Instant) -> AcquisitionClockRead { acquisition_clock_reading_of(send_monotonic: m, send_wall: w) }\n"), wanted: admission) >= 1
}

test fn an_unrelated_caller_cannot_assign_a_deadline_beside_its_basis() -> Bool {
  blocking_class(c: probe(body: "fn forge(a: AcquisitionClockReading, b: ValidityBasis) -> CredentialValidity { deadline_after(acquisition: a, span_nanos: 3600000000000, basis: b) }\n"), wanted: admission) >= 1
}

test fn an_unrelated_caller_cannot_enter_the_staged_parse_with_decoded_fields() -> Bool {
  blocking_class(c: probe(body: "fn forge() -> Rfc3339InstantParse { rfc3339_parse_offset(text: \"Z\", width: 1, at: 0, local_seconds: 0, nanos: 1000000000, fraction_digits: 0, separator_uppercase: true) }\n"), wanted: admission) >= 1
    && blocking_class(c: probe(body: "fn forge() -> Rfc3339InstantParse { rfc3339_parse_fraction(text: \"x\", width: 1, local_seconds: 0, separator_uppercase: true) }\n"), wanted: admission) >= 1
    && blocking_class(c: probe(body: "fn forge() -> Rfc3339InstantParse { rfc3339_parse_fields(text: \"x\", width: 1) }\n"), wanted: admission) >= 1
}

test fn an_unrelated_caller_cannot_mint_a_provider_credential() -> Bool {
  blocking_class(c: probe(body: "fn forge(t: Secret, a: AcquisitionClockReading) -> GcpImpersonatedAccessCredential { impersonated_access_credential_of(token: t, expire_time: \"2099-01-01T00:00:00Z\", target_service_account: \"x@y\", scopes: [], acquisition: a) }\n"), wanted: admission) >= 1
    && blocking_class(c: probe(body: "fn forge(t: Secret, a: AcquisitionClockReading) -> GitHubInstallationAcquisition { installation_credential_of(token: t, expires_at: \"2099-01-01T00:00:00Z\", installation_id: 1, repositories: [], permissions: [], acquisition: a) }\n"), wanted: admission) >= 1
}

// Serving code importing the witness fixtures gets no synthetic evidence either: every fixture that
// returns a sealed credential or clock reading admits only its witness callers.
test fn serving_code_cannot_reach_the_witness_fixtures() -> Bool {
  blocking_class(c: probe(body: "fn forge() -> AcquisitionClockRead { fx_acquisition() }\n"), wanted: admission) >= 1
    && blocking_class(c: probe(body: "fn forge() -> GcpImpersonatedAccessCredential? { incident_credential() }\n"), wanted: admission) >= 1
    && blocking_class(c: probe(body: "fn forge() -> GcpImpersonatedAccessCredential? { fx_gcp_credential(expire_time: \"2099-01-01T00:00:00Z\", service_account: \"x@y\", scopes: []) }\n"), wanted: admission) >= 1
}

test fn a_sealed_record_literal_refuses_outside_its_module() -> Bool {
  blocking_at(c: probe(body: "fn forge(t: Secret, b: GcpImpersonatedAccessBinding, v: CredentialValidity) -> GcpImpersonatedAccessCredential { GcpImpersonatedAccessCredential { token: t, binding: b, validity: v } }\n"), wanted: sealed, subject: "GcpImpersonatedAccessCredential") >= 1
    && blocking_at(c: probe(body: "fn forge(b: ValidityBasis, u: ObservationInstant) -> CredentialDeadline { CredentialDeadline { basis: b, usable_until: u } }\n"), wanted: sealed, subject: "CredentialDeadline") >= 1
    && blocking_at(c: probe(body: "fn forge() -> Rfc3339Instant { Rfc3339Instant { unix_seconds: 0, nanos: 1000000000 } }\n"), wanted: sealed, subject: "Rfc3339Instant") >= 1
}
