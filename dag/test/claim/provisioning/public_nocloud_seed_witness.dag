module test.claim.provisioning.public_nocloud_seed_witness

import std.types { Bool, List, String }
import std.algebra { string_contains }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.languages.yaml.types { YamlValue, YamlKeyValue, yaml_mapping, yaml_sequence, yaml_string, yaml_int, yaml_bool, kv }
import gunbc.os_install_emit { autoinstall_user_data_document, cloud_config_user_data, AutoinstallUserDataRendered, AutoinstallUserDataRefused }
import gunbc.os_install { srv4_ubuntu_autoinstall_on_iso }
import gunbc.provisioning.public_nocloud_seed {
  admit_public_nocloud_seed,
  PublicSeedAdmission,
  PublicSeedAdmitted,
  PublicSeedRefused,
  PublicSeedFinding,
  SeedCredentialField,
  SeedKeyNotAdmitted,
  SeedPasswordSshEnabled,
  SeedAuthorizedKeyNotPublic,
  SeedCredentialShapedValue,
  SeedRenderRefused,
  SeedUserData,
  SeedMetaData,
  public_nocloud_seed_user_data,
  public_nocloud_seed_meta_data,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data public_key_line: String = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixtureFixtureFixtureFixtureFixtureFixture fixture"

fn ssh_section(allow_pw: Bool, keys: List<YamlValue>) -> YamlKeyValue {
  kv(key: "ssh", value: yaml_mapping(entries: [
    kv(key: "install-server", value: yaml_bool(b: true)),
    kv(key: "authorized-keys", value: yaml_sequence(elements: keys)),
    kv(key: "allow-pw", value: yaml_bool(b: allow_pw)),
  ]))
}

fn user_data_with(extra: List<YamlKeyValue>) -> YamlValue {
  yaml_mapping(entries: [kv(key: "autoinstall", value: yaml_mapping(entries: concat([
    kv(key: "version", value: yaml_int(n: 1)),
    ssh_section(allow_pw: false, keys: [yaml_string(s: public_key_line)]),
  ], extra)))])
}

data meta: YamlValue = yaml_mapping(entries: [kv(key: "instance-id", value: yaml_string(s: "fixture"))])

fn findings_of(a: PublicSeedAdmission) -> List<PublicSeedFinding> {
  match a {
    PublicSeedAdmitted { seed: _ } => []
    PublicSeedRefused { findings: fs } => concat([fs.head], fs.tail)
  }
}

fn refused_with(a: PublicSeedAdmission, finding: PublicSeedFinding) -> Bool {
  match a {
    PublicSeedAdmitted { seed: _ } => false
    PublicSeedRefused { findings: _ } => any(findings_of(a: a), f => f == finding)
  }
}

// CONTROL: a key-only seed is admitted, and its bytes are the one #cloud-config renderer's rendering of the very tree
// that was audited (gunbc.os_install_emit cloud_config_user_data), so the audit and the published bytes cannot drift.
test fn a_key_only_seed_is_admitted_as_the_rendering_of_its_audited_tree() -> Bool {
  let doc = user_data_with(extra: [])
  match admit_public_nocloud_seed(user_data: doc, meta_data: meta) {
    PublicSeedRefused { findings: _ } => false
    PublicSeedAdmitted { seed: sd } =>
      match cloud_config_user_data(document: doc) {
        AutoinstallUserDataRefused { reason: _ } => false
        AutoinstallUserDataRendered { content: c } =>
          public_nocloud_seed_user_data(seed: sd) == c
            && string_contains(s: public_nocloud_seed_user_data(seed: sd), pattern: "allow-pw: false")
            && string_contains(s: public_nocloud_seed_meta_data(seed: sd), pattern: "instance-id")
      }
  }
}

// INHABITANCE OF THE REAL PRODUCER, AS A RED: the seed renderer's own document for the committed srv4 payload carries
// a sha512crypt hash in identity.password, and the admission refuses it on exactly that field. A password-bearing
// seed from the real route cannot be bound to the edge.
test fn the_real_renderers_password_bearing_document_is_refused_on_its_password_field() -> Bool {
  refused_with(
    a: admit_public_nocloud_seed(user_data: autoinstall_user_data_document(payload: srv4_ubuntu_autoinstall_on_iso), meta_data: meta),
    finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.identity.password" },
  )
}

// RED, ONE PER CREDENTIAL FIELD of the two schemas: subiquity identity's password; cloud-init's passwd, hashed_passwd,
// plain_text_passwd under user-data.users, chpasswd, and ssh_keys (host private keys).
test fn every_credential_field_refuses_by_name() -> Bool {
  let user = yaml_mapping(entries: [
    kv(key: "name", value: yaml_string(s: "ubuntu")),
    kv(key: "passwd", value: yaml_string(s: "x")),
    kv(key: "hashed_passwd", value: yaml_string(s: "x")),
    kv(key: "plain_text_passwd", value: yaml_string(s: "x")),
  ])
  let a = admit_public_nocloud_seed(user_data: user_data_with(extra: [
    kv(key: "identity", value: yaml_mapping(entries: [kv(key: "hostname", value: yaml_string(s: "h")), kv(key: "password", value: yaml_string(s: "x"))])),
    kv(key: "user-data", value: yaml_mapping(entries: [
      kv(key: "users", value: yaml_sequence(elements: [user])),
      kv(key: "chpasswd", value: yaml_mapping(entries: [])),
      kv(key: "ssh_keys", value: yaml_mapping(entries: [])),
    ])),
  ]), meta_data: meta)
  refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.identity.password" })
    && refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.user-data.users.passwd" })
    && refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.user-data.users.hashed_passwd" })
    && refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.user-data.users.plain_text_passwd" })
    && refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.user-data.chpasswd" })
    && refused_with(a: a, finding: SeedCredentialField { document: SeedUserData, path: "autoinstall.user-data.ssh_keys" })
}

// RED: password SSH is refused (key-only); an authorized "key" that is not a public key line refuses, and a PEM
// private key there is also credential-shaped.
test fn password_ssh_and_non_public_keys_refuse() -> Bool {
  let pw = admit_public_nocloud_seed(user_data: yaml_mapping(entries: [kv(key: "autoinstall", value: yaml_mapping(entries: [
    ssh_section(allow_pw: true, keys: [yaml_string(s: public_key_line)]),
  ]))]), meta_data: meta)
  let pem = "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAA\n-----END OPENSSH PRIVATE KEY-----"
  let priv = admit_public_nocloud_seed(user_data: yaml_mapping(entries: [kv(key: "autoinstall", value: yaml_mapping(entries: [
    ssh_section(allow_pw: false, keys: [yaml_string(s: pem)]),
  ]))]), meta_data: meta)
  refused_with(a: pw, finding: SeedPasswordSshEnabled { document: SeedUserData, path: "autoinstall.ssh.allow-pw" })
    && refused_with(a: priv, finding: SeedAuthorizedKeyNotPublic { document: SeedUserData, path: "autoinstall.ssh.authorized-keys" })
    && refused_with(a: priv, finding: SeedCredentialShapedValue { document: SeedUserData, path: "autoinstall.ssh.authorized-keys" })
}

// RED: a crypt(3)-shaped hash refuses wherever a string carries it (here inside a late command), and so does a PEM
// private-key block; an unclassified key refuses, in either document.
test fn credential_shaped_values_and_unclassified_keys_refuse() -> Bool {
  let hashed = admit_public_nocloud_seed(user_data: user_data_with(extra: [
    kv(key: "late-commands", value: yaml_sequence(elements: [yaml_string(s: "$6$saltsalt$0123456789abcdefghijABCDEFGHIJ./0123456789abcdefghijABCDEFGHIJ./0123456789abcdefghij")])),
  ]), meta_data: meta)
  let yescrypt = admit_public_nocloud_seed(user_data: user_data_with(extra: [
    kv(key: "late-commands", value: yaml_sequence(elements: [yaml_string(s: "$y$j9T$salt$hash")])),
  ]), meta_data: meta)
  let pem = admit_public_nocloud_seed(user_data: user_data_with(extra: [
    kv(key: "early-commands", value: yaml_sequence(elements: [yaml_string(s: "echo '-----BEGIN EC PRIVATE KEY-----' > /tmp/k")])),
  ]), meta_data: meta)
  let token = admit_public_nocloud_seed(user_data: user_data_with(extra: [kv(key: "api_token", value: yaml_string(s: "abc"))]), meta_data: meta)
  let meta_token = admit_public_nocloud_seed(user_data: user_data_with(extra: []), meta_data: yaml_mapping(entries: [kv(key: "instance-id", value: yaml_string(s: "i")), kv(key: "token", value: yaml_string(s: "t"))]))
  refused_with(a: hashed, finding: SeedCredentialShapedValue { document: SeedUserData, path: "autoinstall.late-commands" })
    && refused_with(a: yescrypt, finding: SeedCredentialShapedValue { document: SeedUserData, path: "autoinstall.late-commands" })
    && refused_with(a: pem, finding: SeedCredentialShapedValue { document: SeedUserData, path: "autoinstall.early-commands" })
    && refused_with(a: token, finding: SeedKeyNotAdmitted { document: SeedUserData, path: "autoinstall.api_token" })
    && refused_with(a: meta_token, finding: SeedKeyNotAdmitted { document: SeedMetaData, path: "token" })
}
