module test.claim.seed_artifact_fetch_forged_probe_witness

import std.types { String, Bool, Int, List }
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE REBOUND-FETCH ROUTES, ENROLLED AS EXECUTED REDS (DESIGN §4b: a state unrepresentable in the
// accepted corpus is still representable as source handed to the compiler). An AdmittedSeedArtifact
// is admitted against one input's seed population and fetched only into that input's seed
// directory under the remaster's work directory. test.probe.seed_artifact_fetch_forged_probe calls
// both fetch helpers from outside the remaster with a seed directory of its own choosing, and mints
// an admitted artifact without the admission; each must refuse at its own subject. A control source
// that only NAMES the modules refuses at none of them, so the refusals are the forgeries'.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn probe() -> CompileDiagnosticCensus {
  census_of(source: filesystem_read(path: "dag/test/probe/seed_artifact_fetch_forged_probe.dag").content)
}

fn blocking(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data control_source: String = "module probe_seed_artifact_fetch_harness_control\nimport std.types { Bool, String }\nimport extdeps.provisioning.ubuntu_seeded_install_media { AdmittedSeedArtifact }\nimport extdeps.provisioning.ubuntu_seeded_install_media_remaster { install_media_remaster_write_nocloud_seed }\nfn named(a: AdmittedSeedArtifact) -> String { a.basename.value as String }\n"

data sealed_helpers: List<String> = ["install_media_remaster_fetch_artifact", "install_media_remaster_fetch_artifacts"]

data sealed_records: List<String> = ["SeedArtifactBasename", "AdmittedSeedArtifact"]

test fn a_source_that_only_names_the_remaster_rebinds_nothing() -> Bool {
  let c = census_of(source: control_source)
  (sealed_helpers |> all(h => blocking(c: c, wanted: "ConstructorCallAdmissionRefused", subject: h) == 0))
    && (sealed_records |> all(r => blocking(c: c, wanted: "SoleConstructorViolation", subject: r) == 0))
}

test fn each_fetch_helper_refuses_a_caller_outside_the_checked_route() -> Bool {
  let c = probe()
  sealed_helpers |> all(h => blocking(c: c, wanted: "ConstructorCallAdmissionRefused", subject: h) >= 1)
}

test fn an_admitted_artifact_cannot_be_minted_without_the_admission() -> Bool {
  let c = probe()
  sealed_records |> all(r => blocking(c: c, wanted: "SoleConstructorViolation", subject: r) >= 1)
}
