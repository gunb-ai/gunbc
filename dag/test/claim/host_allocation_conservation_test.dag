module test.claim.host_allocation_conservation


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn allocation_conserves_when_pools_fit() -> Bool {
  gunbc.fleet_host_budget.host_allocation_conserves(
    host: std.measure.byte_size(134217728000),
    overhead: std.measure.byte_size(17179869184),
    headroom: std.measure.byte_size(8589934592),
    runner_pool: gunbc.fleet_host_budget.gunbc_runner_pool_budget,
    session_pool: std.measure.byte_size(0)
  )
}

test fn allocation_unsound_when_runner_pool_overcommits() -> Bool {
  !gunbc.fleet_host_budget.host_allocation_conserves(
    host: std.measure.byte_size(134217728000),
    overhead: std.measure.byte_size(17179869184),
    headroom: std.measure.byte_size(8589934592),
    runner_pool: std.measure.byte_size(128849018880),
    session_pool: std.measure.byte_size(0)
  )
}

test fn sessions_subtract_from_the_same_budget() -> Bool {
  !gunbc.fleet_host_budget.host_allocation_conserves(
    host: std.measure.byte_size(134217728000),
    overhead: std.measure.byte_size(17179869184),
    headroom: std.measure.byte_size(8589934592),
    runner_pool: gunbc.fleet_host_budget.gunbc_runner_pool_budget,
    session_pool: gunbc.fleet_host_budget.session_pool_bytes(active_sessions: 40)
  )
}

test fn max_concurrent_sessions_falls_out_of_pool() -> Bool {
  gunbc.fleet_host_budget.max_concurrent_sessions(session_pool: gunbc.fleet_host_budget.session_pool_bytes(active_sessions: 12)) == 12
}
