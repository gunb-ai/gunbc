// ── The JWKS realization (frontier 2) ──────────────────────────────────────────────────────────
// These controls drive the REALIZATION's pure folds — the wire decode, the JWKS vocabulary and
// selection, the SPKI assembly — against fixtures computed independently on the host (a real
// openssl-generated RSA key; the fixture bytes below are its published SPKI). The IO arms
// (fetch, cache, the openssl invocation itself) are substrate: the refusal ARMS below never
// reach an effect, which is what makes never-fail-open witnessed rather than asserted.

data witness_fixture_key_id: NonEmptyStr = "fixture-key-1" as NonEmptyStr

data witness_fixture_key_n: NonEmptyStr = "AIz33TZI-pYqz4njL10u54JSglbs1oHlXP9LNSxDQAWMhw1vNK1tAPzT-Msh982yh4h-z0-ohGwS5zeTnxttxzt7y7CvqnAB0gbWYevKN0vfQYYWLv2elHzhIhLcHKv8C6wuxpkUcI1y4XBOmJzPCA2KJ8qIpzQHN1qsC9mHyOIpLqngBoGVTiyl4xR7yiWWUg4Pzbz3pl0wNMBR8BPMyIeNLMwWpLzzxQTM_zxCxCrDe0ualqKS4uGXcA-eKS7BV9xVenBxza2xiH0f6iuTdMSnptx_COVRisJRXR8rqbi-gC_C-4OBCqG54V_QLMy-J6ZHItt4QTH6YGUdjVNd3qU" as NonEmptyStr

data witness_fixture_key_e: NonEmptyStr = "AQAB" as NonEmptyStr

fn witness_fixture_key() -> JwkRsaPublicKey {
  JwkRsaPublicKey {
    key_id: witness_fixture_key_id,
    modulus_b64url: witness_fixture_key_n,
    exponent_b64url: witness_fixture_key_e,
  }
}

// THE WIRE DECODE reads a real compact serialization end to end: the header's alg and kid, the
// required core, the standard claims, and the signing input — the exact bytes the signature
// must cover.
test fn the_wire_decode_reads_header_claims_and_signing_input() -> Bool {
  match oidc_id_token_wire_decode(token: witness_fixture_wire() as JwtCompactSerialization) {
    OidcIdTokenWireRefused { reason: _ } => false
    OidcIdTokenWireDecoded { claims: c, header: h, signing_input: si } =>
      match h.algorithm {
        JwksAlgRs256 => true
      }
        && (h.key_id as String) == "fixture-key-1"
        && jwt_string_or_uri_wire(value: c.issuer) == "https://accounts.google.com"
        && jwt_string_or_uri_wire(value: c.subject) == "fixture-sub-1"
        && match c.audience {
          JwtAudienceSingle { value: a } => jwt_string_or_uri_wire(value: a) == "fixture-client"
          JwtAudienceMultiple { values: _ } => false
        }
        && match c.expires_at {
          NumericDateWholeSeconds { seconds: s } => s == 2000000000
          NumericDateFractionalSeconds { whole_seconds: _, fractional_digits: _ } => false
        }
        && match c.nonce {
          Present { value: n } => (n as String) == "fixture-nonce"
          Absent => false
        }
        && match c.hosted_domain {
          Present { value: hd } => (hd.domain as String) == "gunb.ai"
          Absent => false
        }
        && match c.standard.email_verified {
          Present { value: v } => v
          Absent => false
        }
        && si == concat(concat(witness_fixture_header_segment(), "."), witness_fixture_payload_segment())
  }
}

// A FRACTIONAL NUMERICDATE KEEPS ITS DIGITS, and a missing required-core member refuses with
// the member named: the decode describes the RFC without rounding or normalizing anything away.
test fn the_wire_decode_keeps_fractional_digits_and_refuses_missing_core() -> Bool {
  match oidc_id_token_wire_decode(token: join([witness_fixture_header_segment(), ".", witness_fixture_fractional_payload_segment(), ".c2ln"], "") as JwtCompactSerialization) {
    OidcIdTokenWireRefused { reason: _ } => false
    OidcIdTokenWireDecoded { claims: c, header: _, signing_input: _ } =>
      match c.expires_at {
        NumericDateFractionalSeconds { whole_seconds: w, fractional_digits: f } =>
          w == 2000000000 && (f as String) == "5"
        NumericDateWholeSeconds { seconds: _ } => false
      }
  }
    && match oidc_id_token_wire_decode(token: join([witness_fixture_header_segment(), ".", witness_fixture_noexp_payload_segment(), ".c2ln"], "") as JwtCompactSerialization) {
      OidcIdTokenWireRefused { reason: r } => string_contains(s: r, pattern: "exp")
      OidcIdTokenWireDecoded { claims: _, header: _, signing_input: _ } => false
    }
    && match oidc_id_token_wire_decode(token: join([witness_fixture_badalg_header_segment(), ".", witness_fixture_payload_segment(), ".c2ln"], "") as JwtCompactSerialization) {
      OidcIdTokenWireRefused { reason: r } => string_contains(s: r, pattern: "RS256")
      OidcIdTokenWireDecoded { claims: _, header: _, signing_input: _ } => false
    }
    && match oidc_id_token_wire_decode(token: "two.segments" as JwtCompactSerialization) {
      OidcIdTokenWireRefused { reason: _ } => true
      OidcIdTokenWireDecoded { claims: _, header: _, signing_input: _ } => false
    }
}

// THE SPKI ASSEMBLY reproduces, byte for byte, the SPKI document openssl itself publishes for
// the fixture key — the in-model DER assembler (length encodings, the sign guard on the
// modulus, the algorithm identifier) is exactly right against an independent computation.
test fn the_spki_assembly_matches_openssl_s_own_document() -> Bool {
  match rsa_spki_of_jwk(key: witness_fixture_key()) {
    DerRefused { reason: _ } => false
    DerOctets { octets: assembled } => assembled == witness_fixture_spki_octets()
  }
}

// JWKS SELECTION IS BY KID AND REFUSES A KEY OUTSIDE THE SET: the fold returns the announced
// key, and a kid the set does not hold is JwksKeyNotFound carrying WHICH key was asked for —
// never a fallback to some key in the set.
test fn jwks_selection_answers_the_announced_kid_and_refuses_the_unknown() -> Bool {
  match jwks_select_key(keys: [witness_fixture_key()], key_id: witness_fixture_key_id) {
    JwksKeySelected { key: k } => (k.key_id as String) == "fixture-key-1"
    JwksKeyNotFound { key_id: _ } => false
  }
    && match jwks_select_key(keys: [witness_fixture_key()], key_id: "no-such-key" as NonEmptyStr) {
      JwksKeySelected { key: _ } => false
      JwksKeyNotFound { key_id: k } => (k as String) == "no-such-key"
    }
}

// THE FETCH FAILURE IS TYPED AND NEVER FAILS OPEN: a refused JWKS resolve maps to
// OidcIdTokenSignatureRefused naming the fetch step, and the parts fold is never reached past
// it — the verified arm has no input to stand on, and none is fabricated.
// The decoded wire is SUPPLIED: the claim is about the signature fold's refusal arms, and the
// decode that produces this shape has its own claim over the real wire
// (the_wire_decode_reads_header_claims_and_signing_input).
fn supplied_decoded_wire() -> OidcIdTokenWire {
  OidcIdTokenWireDecoded {
    claims: control_claims(),
    header: OidcIdTokenHeader { algorithm: JwksAlgRs256, key_id: witness_fixture_key_id },
    signing_input: concat(concat(witness_fixture_header_segment(), "."), witness_fixture_payload_segment()),
  }
}

test fn a_jwks_fetch_failure_refuses_the_signature_and_never_verifies() -> Bool {
  match oidc_id_token_signature_of_parts(
    wire: supplied_decoded_wire(),
    resolved: JwksResolveRefused { step: "fetch", reason: "the origin did not answer" },
    signature_segment: "c2ln",
    scratch_dir: "witness-unused",
    verify_id: "witness" as NonEmptyStr,
  ) {
    OidcIdTokenSignatureRefused { reason: r } =>
      string_contains(s: r, pattern: "fetch")
        && string_contains(s: r, pattern: "the origin did not answer")
        && match oidc_id_token_signature_of_parts(
          wire: supplied_decoded_wire(),
          resolved: JwksResolved { body: "{\"keys\":[]}", served_from: JwksServedFromOrigin },
          signature_segment: "c2ln",
          scratch_dir: "witness-unused",
          verify_id: "witness" as NonEmptyStr,
        ) {
          OidcIdTokenSignatureRefused { reason: r2 } => string_contains(s: r2, pattern: "no JWKS key answers")
          OidcIdTokenSignatureVerified { key: _ } => false
        }
    OidcIdTokenSignatureVerified { key: _ } => false
  }
}

// THE VERIFIED ARM HAS EXACTLY ONE SOURCE: openssl's affirmative answer. The pure tail maps a
// valid verification to OidcIdTokenSignatureVerified naming the key, and every other
// verification outcome to a located refusal — so no consumer can reach the verified arm from a
// refused realization, and the verdict fold above it refuses at the signature check.
test fn only_an_affirmative_realization_mints_the_verified_arm() -> Bool {
  match oidc_id_token_signature_of_verification(key: witness_fixture_key(), verification: Rs256SignatureValid) {
    OidcIdTokenSignatureVerified { key: ref } =>
      (ref.key_id as String) == "fixture-key-1"
        && jwt_string_or_uri_wire(value: ref.issuer) == "https://accounts.google.com"
    OidcIdTokenSignatureRefused { reason: _ } => false
  }
    && match oidc_id_token_signature_of_verification(key: witness_fixture_key(), verification: Rs256SignatureInvalid { detail: "bad signature" }) {
      OidcIdTokenSignatureRefused { reason: r } => string_contains(s: r, pattern: "bad signature")
      OidcIdTokenSignatureVerified { key: _ } => false
    }
    && match oidc_id_token_signature_of_verification(key: witness_fixture_key(), verification: Rs256VerificationUnrealizable { detail: "openssl absent" }) {
      OidcIdTokenSignatureRefused { reason: r } => string_contains(s: r, pattern: "openssl absent")
      OidcIdTokenSignatureVerified { key: _ } => false
    }
}

// THE FULL VERDICT CHAIN over the realization's decode: the fixture wire's claims pass the
// landed verdict policy exactly when the fixture key stands behind the signature, and the
// refusal arms the decode produced upstream still refuse downstream. This is the seam the
// serve route binds: verify_oidc_id_token receives the producer's outcome, not a claim set.
test fn the_realized_signature_feeds_the_landed_verdict_fold() -> Bool {
  match oidc_id_token_wire_decode(token: witness_fixture_wire() as JwtCompactSerialization) {
    OidcIdTokenWireRefused { reason: _ } => false
    OidcIdTokenWireDecoded { claims: c, header: _, signing_input: _ } =>
      match verify_oidc_id_token(
        claims: c,
        signature: OidcIdTokenSignatureVerified {
          key: JsonWebKeyRef {
            issuer: JwtUriString { value: "https://accounts.google.com" as NonEmptyStr, scheme: "https" as NonEmptyStr },
            key_id: witness_fixture_key_id,
          },
        },
        policy: OidcIdTokenVerdictPolicy {
          expected_issuer: JwtUriString { value: "https://accounts.google.com" as NonEmptyStr, scheme: "https" as NonEmptyStr },
          admitted_audiences: [JwtBareString { value: "fixture-client" as NonEmptyStr }],
          expected_hosted_domain: OidcHostedDomain { domain: "gunb.ai" as NonEmptyStr },
          expected_nonce: Present { value: "fixture-nonce" as NonEmptyStr },
          observed_at: NumericDateWholeSeconds { seconds: 1700000000 },
        },
      ) {
        OidcIdTokenVerified { claims: v } => jwt_string_or_uri_wire(value: v.subject) == "fixture-sub-1"
        OidcIdTokenRefused { cause: _ } => false
      }
  }
}
