module test.claim.mac_verification_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.crypto.mac {
  MacKey, MacKeyId, MacSuite, HmacSha256, MacVerification, MacVerified,
  MacTagMismatch, MacTagMalformed, MacTagNotHex, MacKeyMaterialMalformed,
  mac_verify, mac_verification_ok,
  MacSigning, MacSigned, MacKeyMaterialNotHex, MacComputationRefused, mac_sign,
}
import std.types { NonEmptyStr, Secret }
import std.logic { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── RFC 4231 test vectors, verified through the modeled HMAC ─────────────────────────────────
// THESE ARE NOT FIXTURES I COMPUTED. RFC 4231 publishes HMAC-SHA-256 test vectors precisely so an
// implementation can be checked against something it did not produce. A fixture generated by the
// code under test would pass whatever that code does, including nothing -- which is the
// asserted-not-produced trap, and the reason a self-consistent crypto test establishes nothing.
//
// Case 1: key = 20 octets of 0x0b, message = "Hi There"
// Case 2: key = "Jefe", message = "what do ya want for nothing?"
// Case 6: key = 131 octets of 0xaa (LONGER than the 64-octet block, so RFC 2104 §2 hashes the key
//         first), message = "Test Using Larger Than Block-Size Key - Hash Key First"

data rfc4231_case1_key: MacKey = MacKey {
  id: "rfc4231-case1" as MacKeyId,
  suite: HmacSha256,
  material: "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" as Secret,
}

data rfc4231_case1_message: NonEmptyStr = "Hi There" as NonEmptyStr
data rfc4231_case1_tag: NonEmptyStr = "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7" as NonEmptyStr

data rfc4231_case2_key: MacKey = MacKey {
  id: "rfc4231-case2" as MacKeyId,
  suite: HmacSha256,
  material: "4a656665" as Secret,
}

data rfc4231_case2_message: NonEmptyStr = "what do ya want for nothing?" as NonEmptyStr
data rfc4231_case2_tag: NonEmptyStr = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" as NonEmptyStr

data rfc4231_case6_key: MacKey = MacKey {
  id: "rfc4231-case6" as MacKeyId,
  suite: HmacSha256,
  material: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as Secret,
}

data rfc4231_case6_message: NonEmptyStr = "Test Using Larger Than Block-Size Key - Hash Key First" as NonEmptyStr
data rfc4231_case6_tag: NonEmptyStr = "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54" as NonEmptyStr

// THE POSITIVE CONTROL, AND IT IS DOING REAL WORK HERE. Every refusal below is only informative if
// the implementation can verify a tag it should. A verifier that answered false unconditionally
// would pass every negative test in this file.
test fn the_published_rfc4231_case1_vector_verifies() -> Bool {
  mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case1_key,
      message: rfc4231_case1_message,
      tag_hex: rfc4231_case1_tag,
    )
  )
}

test fn the_published_rfc4231_case2_vector_verifies() -> Bool {
  mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case2_key,
      message: rfc4231_case2_message,
      tag_hex: rfc4231_case2_tag,
    )
  )
}

// ── The tag is bound to the message ──────────────────────────────────────────────────────────
// THE DISCRIMINATING RED. Case 1's key and case 1's tag, against case 2's MESSAGE. This is the
// substitution the whole envelope design exists to prevent, exercised at the bottom of the stack
// rather than at the policy helper: nothing about the key or the tag changed, only what they are
// claimed to authenticate.
test fn a_valid_tag_does_not_verify_against_a_different_message() -> Bool {
  !mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case1_key,
      message: rfc4231_case2_message,
      tag_hex: rfc4231_case1_tag,
    )
  )
}

// A ONE-BIT CHANGE IN THE MESSAGE. "Hi There" and "Hi there" differ in one letter, and a MAC that
// verified both would not be a MAC.
test fn a_single_character_change_in_the_message_fails_verification() -> Bool {
  !mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case1_key,
      message: "Hi there" as NonEmptyStr,
      tag_hex: rfc4231_case1_tag,
    )
  )
}

// ── The tag is bound to the key ──────────────────────────────────────────────────────────────
// Case 2's key against case 1's message and tag. This is the rotation case: a link signed under a
// retired key must not verify under the current one.
test fn a_tag_does_not_verify_under_a_different_key() -> Bool {
  !mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case2_key,
      message: rfc4231_case1_message,
      tag_hex: rfc4231_case1_tag,
    )
  )
}

// ── A near-miss tag fails ────────────────────────────────────────────────────────────────────
// The published tag with its LAST character changed. A comparison that stopped early, truncated,
// or compared a prefix would accept this. It is also the shape a timing attack produces on its
// final step, which is why mac_verify compares full-scan (extdeps.crypto.mac hmac_tag_difference).
test fn a_tag_differing_in_one_character_fails() -> Bool {
  !mac_verification_ok(
    v: mac_verify(
      key: rfc4231_case1_key,
      message: rfc4231_case1_message,
      tag_hex: "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff8" as NonEmptyStr,
    )
  )
}

// A TRUNCATED TAG IS NOT A PREFIX MATCH. Accepting a short tag that matches as far as it goes is
// the classic MAC-verification defect: it reduces the work of forging one to guessing a byte. It
// refuses as MacTagMalformed naming both lengths -- a length defect, not a mismatch.
test fn a_truncated_tag_fails_rather_than_matching_a_prefix() -> Bool {
  match mac_verify(
    key: rfc4231_case1_key,
    message: rfc4231_case1_message,
    tag_hex: "b0344c61" as NonEmptyStr,
  ) {
    MacTagMalformed { octets_declared: d, octets_expected: x } => d == 4 && x == 32
    _ => false
  }
}

// ── Malformed input is refused, TYPED ────────────────────────────────────────────────────────
// Undecodable input is never answered as a mismatch (gunbc#11628 qualification). A tag that is not
// lowercase hex is MacTagNotHex; key material that is not hex is MacKeyMaterialMalformed. Neither
// is authentication, and neither pretends to be a tag that happened not to match.
test fn a_non_hex_tag_refuses_as_not_hex() -> Bool {
  match mac_verify(key: rfc4231_case1_key, message: rfc4231_case1_message, tag_hex: "zzzz" as NonEmptyStr) {
    MacTagNotHex { key_id: k } => k == "rfc4231-case1"
    _ => false
  }
}

test fn non_hex_key_material_refuses_as_malformed_key() -> Bool {
  match mac_verify(
    key: MacKey { id: "bad" as MacKeyId, suite: HmacSha256, material: "not-hex" as Secret },
    message: rfc4231_case1_message,
    tag_hex: rfc4231_case1_tag,
  ) {
    MacKeyMaterialMalformed { key_id: k } => k == "bad"
    _ => false
  }
}

// A well-formed tag that differs is the ONE case that is a mismatch -- pinned by arm, not only by
// "not ok", so a refactor that turns tampering into a refusal (or the reverse) is red.
test fn a_well_formed_wrong_tag_is_a_mismatch() -> Bool {
  match mac_verify(key: rfc4231_case2_key, message: rfc4231_case1_message, tag_hex: rfc4231_case1_tag) {
    MacTagMismatch { key_id: k } => k == "rfc4231-case2"
    _ => false
  }
}

// THE LONG-KEY ARM. Case 6's key exceeds the block, so K0 = H(K) zero-extended. An implementation
// that zero-extended or truncated the raw key instead would produce a different tag.
test fn the_published_rfc4231_case6_long_key_vector_verifies() -> Bool {
  mac_verification_ok(
    v: mac_verify(key: rfc4231_case6_key, message: rfc4231_case6_message, tag_hex: rfc4231_case6_tag)
  )
}

// ── The evidence names the message it verified ───────────────────────────────────────────────
// The join gunbc.auth.approval_capability depends on: a success carries the exact message, so a
// consumer can require it to equal the bytes it serialized. Asserted here, at the producer.
test fn a_success_carries_the_message_that_was_verified() -> Bool {
  match mac_verify(
    key: rfc4231_case1_key,
    message: rfc4231_case1_message,
    tag_hex: rfc4231_case1_tag,
  ) {
    MacVerified { verified: v } =>
      v.message == rfc4231_case1_message && v.key_id == "rfc4231-case1"
    _ => false
  }
}

// ── Issuance against the same published vectors ──────────────────────────────────────────────
// mac_sign must PRODUCE the tags RFC 4231 publishes -- not merely a tag its own verifier accepts,
// which a self-consistent pair of wrong implementations would also satisfy.
fn signed_hex(v: MacSigning) -> NonEmptyStr? {
  match v {
    MacSigned { tag: t } => Present { value: t.hex }
    MacKeyMaterialNotHex { key_id: _ } => none
    MacComputationRefused { key_id: _, cause: _ } => none
  }
}

test fn mac_sign_produces_the_published_rfc4231_case1_tag() -> Bool {
  signed_hex(v: mac_sign(key: rfc4231_case1_key, message: rfc4231_case1_message)) == Present { value: rfc4231_case1_tag }
}

test fn mac_sign_produces_the_published_rfc4231_case2_tag() -> Bool {
  signed_hex(v: mac_sign(key: rfc4231_case2_key, message: rfc4231_case2_message)) == Present { value: rfc4231_case2_tag }
}

// "Jefe" is case 2's key BEFORE hex encoding. Signing with it must refuse, not sign some other key.
test fn mac_sign_refuses_key_material_that_is_not_hex() -> Bool {
  let unencoded = MacKey { id: "rfc4231-case2-unencoded" as MacKeyId, suite: HmacSha256, material: "Jefe" as Secret }
  match mac_sign(key: unencoded, message: rfc4231_case2_message) {
    MacKeyMaterialNotHex { key_id: k } => k == unencoded.id
    MacSigned { tag: _ } => false
    MacComputationRefused { key_id: _, cause: _ } => false
  }
}
