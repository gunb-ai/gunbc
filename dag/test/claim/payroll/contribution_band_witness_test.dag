  accrue_period,
}

// THE DISCRIMINATING CLAIMS.
//
// (1) The band clamps the CUMULATIVE position, not the period. Proven discriminating rather than
// assumed: mutating the kernel to clamp per period turns this witness false while the ordinary
// control stays true.
// (2) A period entirely above the cap owes nothing further - the saturating case.
// (3) The above-threshold band is the mirror image, on the row that has one.
// (4) An earnings-period window REFUSES rather than being computed as annual. UK Class 1 assesses
// per pay interval and the same annual earnings give different contributions by how periods fall.
// (5) Aggregation scope must agree.
// (6) Malformed band bounds refuse and the well-formed twin computes - a wall that never admits
// is indistinguishable from one that always refuses.
// (7) CONTRIBUTION BASE, held to the reviewer's bar: every other represented coordinate is
// identical and ONLY the base differs. Social Security wages and Medicare wages coincide for an
// ordinary worker below the cap, which is what made this easy to miss.
// (8) A spec whose base has no position refuses BY NAME instead of borrowing whichever position
// was passed - the fail-open a single-position fold had implicitly.
// (9) Stale year and foreign currency refuse the WHOLE accrual, year checked in both directions.
// (10) The hand-computed control, and the SSA external oracle.

data ss_base: NonEmptyStr = "us-irs-social-security-wages"
data hi_base: NonEmptyStr = "us-irs-medicare-wages"

data probe_crossing_the_cap: AssessedPosition = AssessedPosition {
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
  effective_year: 2025,
  currency: Usd,
  contribution_base: ss_base,
  position_before: money_amount_micro(count: 170000000000),
  this_period: money_amount_micro(count: 10000000000),
}

data probe_above_the_cap: AssessedPosition = AssessedPosition {
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
  effective_year: 2025,
  currency: Usd,
  contribution_base: ss_base,
  position_before: money_amount_micro(count: 180000000000),
  this_period: money_amount_micro(count: 5000000000),
}

data probe_crossing_the_threshold: AssessedPosition = AssessedPosition {
  assessment_window: CalendarYearAssessed,
  aggregation_scope: EmployerWorkerRelationship,
  effective_year: 2025,
  currency: Usd,
  contribution_base: hi_base,
  position_before: money_amount_micro(count: 190000000000),
  this_period: money_amount_micro(count: 20000000000),
}

