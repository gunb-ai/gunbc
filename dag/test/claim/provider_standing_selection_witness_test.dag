module test.claim.provider_standing_selection_witness_test


test fn model_rejection_does_not_erase_account_eligibility() -> Bool {
  limit_observations_are_selection_eligible(
    observations: [
      gunbc.provider_standing.LimitRejected {
        subject: gunbc.provider_standing.ProviderModelLimit {
          credential: LimitCredentialUnspecified,
          model: "fable" as std.types.NonEmptyStr,
        },
        native_token: "model_rejected" as std.types.NonEmptyStr,
        reason: "model not entitled" as std.types.NonEmptyStr,
      },
      gunbc.provider_standing.LimitObservedAvailable {
        subject: gunbc.provider_standing.ProviderAccountLimit {
          credential: LimitCredentialUnspecified,
        },
      },
    ],
    draw: LimitDispatchDrawUnspecified,
  )
}

test fn model_rejection_blocks_dispatch_under_unspecified_draw() -> Bool {
  !limit_observation_blocks_dispatch(
    observation: gunbc.provider_standing.LimitRejected {
      subject: gunbc.provider_standing.ProviderModelLimit {
        credential: LimitCredentialUnspecified,
        model: "fable" as std.types.NonEmptyStr,
      },
      native_token: "model_rejected" as std.types.NonEmptyStr,
      reason: "model not entitled" as std.types.NonEmptyStr,
    },
    draw: LimitDispatchDrawUnspecified,
  )
}

test fn authenticated_available_bundle_is_selection_eligible() -> Bool {
  provider_standing_bundle_is_selection_eligible(
    bundle: fixture_standing_bundle_authenticated_available(),
    draw: LimitDispatchDrawAutomatic,
  )
}

test fn weekly_cap_blocks_automatic_draw() -> Bool {
  !provider_standing_bundle_is_selection_eligible(
    bundle: fixture_standing_bundle_authenticated_unavailable_until_reset(),
    draw: LimitDispatchDrawAutomatic,
  )
}

test fn cursor_capability_gap_does_not_block_selection() -> Bool {
  provider_standing_bundle_is_selection_eligible(
    bundle: fixture_standing_bundle_cursor_capability_gap(),
    draw: LimitDispatchDrawAutomatic,
  )
}

test fn claude_profile_present_token_absent_is_ineligible() -> Bool {
  !provider_standing_bundle_is_selection_eligible(
    bundle: fixture_standing_bundle_claude_profile_present_token_absent(),
    draw: LimitDispatchDrawAutomatic,
  )
}

test fn provider_standing_selection_witness_keystone_holds() -> Bool {
  model_rejection_does_not_erase_account_eligibility()
    && model_rejection_blocks_dispatch_under_unspecified_draw()
    && authenticated_available_bundle_is_selection_eligible()
    && weekly_cap_blocks_automatic_draw()
    && cursor_capability_gap_does_not_block_selection()
    && claude_profile_present_token_absent_is_ineligible()
}
