module test.claim.fabric_cell_converge

import std.logic { Bool }
import std.types { list_length, String, NonEmptyStr }
import gunbc.build_cache_instance { RunnerSlotIdentity, runner_slot_instance_name }
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }
import gunbc.ownership { Owned }
import gunbc.fabric_cell_converge {
  fabric_cell_id_for_slot,
  fabric_cell_ids,
  fabric_cell_resource_addresses,
  fabric_cell_resource_address_wire,
  FabricCellResourceAddress,
  FabricCellRootAddress,
  FabricCellAttemptRootAddress,
  FabricCellResourceBoundaryAddress,
  FabricCellMember,
  fabric_cell_member_key,
  fabric_cell_desired_members,
  fabric_cell_desired_state_digest,
  fabric_cell_family_membership,
  FabricCellFamilyMembership,
  FabricCellIsAFamilyMember,
  SlotIsNotAFabricExecutionMember,
  SlotIsNotACommittedMemberOfItsHost,
  FabricCellReadback,
  FabricCellAddressObservation,
  AddressObserved,
  AddressAbsent,
  AddressObservationRefused,
  fabric_cell_address_disposition,
  FabricCellAddressDisposition,
  AddressPresent,
  AddressMissingOnHost,
  AddressUnobserved,
  AddressContradicted,
  AddressUnreadable,
  fabric_cell_substrate_verdict,
  FabricCellSubstrateVerdict,
  FabricCellSubstrateProvisioned,
  FabricCellSubstrateUnprovisioned,
  FabricCellSubstrateObservationRefused,
  fabric_cell_readback_without_observations,
}

fn srv3_fabric_slot() -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv3, slot_index: 6 }
}

fn desired_member(address: FabricCellResourceAddress) -> FabricCellMember {
  FabricCellMember {
    host: operator_host_srv3,
    slot: srv3_fabric_slot(),
    address: address,
    state_digest: fabric_cell_desired_state_digest(slot: srv3_fabric_slot(), address: address),
    ownership: Owned,
  }
}

fn converged_readback() -> FabricCellReadback {
  FabricCellReadback {
    cell: fabric_cell_id_for_slot(slot: srv3_fabric_slot()),
    observations: [
      AddressObserved { member: desired_member(address: FabricCellRootAddress) },
      AddressObserved { member: desired_member(address: FabricCellAttemptRootAddress) },
      AddressObserved { member: desired_member(address: FabricCellResourceBoundaryAddress) },
    ]
  }
}

fn readback_plus(extra: FabricCellAddressObservation) -> FabricCellReadback {
  FabricCellReadback {
    cell: fabric_cell_id_for_slot(slot: srv3_fabric_slot()),
    observations: concat(converged_readback().observations, [extra])
  }
}

fn membership_is_family_member(m: FabricCellFamilyMembership) -> Bool {
  match m {
    FabricCellIsAFamilyMember { cell: _ } => true
    SlotIsNotAFabricExecutionMember { reason: _ } => false
    SlotIsNotACommittedMemberOfItsHost { reason: _ } => false
  }
}

fn membership_refuses_wrong_family(m: FabricCellFamilyMembership) -> Bool {
  match m {
    SlotIsNotAFabricExecutionMember { reason: _ } => true
    FabricCellIsAFamilyMember { cell: _ } => false
    SlotIsNotACommittedMemberOfItsHost { reason: _ } => false
  }
}

fn membership_refuses_uncommitted(m: FabricCellFamilyMembership) -> Bool {
  match m {
    SlotIsNotACommittedMemberOfItsHost { reason: _ } => true
    FabricCellIsAFamilyMember { cell: _ } => false
    SlotIsNotAFabricExecutionMember { reason: _ } => false
  }
}

// THE EXACT FABRIC MEMBER IS THE FAMILY, AND ITS NEIGHBOURS ARE NOT -- BOTH DIRECTIONS, because only
// one of them is the safety claim and only the other proves the gate is not vacuous. srv3-05 is the
// same host one index down; srv4-06 is the same index on the other host of the same committed width.
// A gate that answered "family member" for everything would satisfy the first row alone.
test fn witness_fabric_cell_family_is_exactly_the_declared_member() -> Bool {
  membership_is_family_member(m: fabric_cell_family_membership(host: operator_host_srv3, slot_index: 6))
    && membership_refuses_wrong_family(m: fabric_cell_family_membership(host: operator_host_srv3, slot_index: 5))
    && membership_refuses_wrong_family(m: fabric_cell_family_membership(host: operator_host_srv4, slot_index: 6))
}

// MEMBERSHIP IS ASKED BEFORE PURPOSE: an index the host was never admitted to carry is refused as an
// uncommitted member, not classified as a non-fabric slot.
test fn witness_fabric_cell_refuses_uncommitted_index() -> Bool {
  membership_refuses_uncommitted(m: fabric_cell_family_membership(host: operator_host_srv3, slot_index: 99))
}

// THE CELL NAME IS THE SLOT NAME. If these ever disagree, a second naming authority was minted.
test fn witness_fabric_cell_id_is_the_slot_instance_name() -> Bool {
  (fabric_cell_id_for_slot(slot: srv3_fabric_slot()) as String) == "srv3-06"
    && (fabric_cell_id_for_slot(slot: srv3_fabric_slot()) as String)
        == runner_slot_instance_name(slot: srv3_fabric_slot())
    && list_length(items: fabric_cell_ids()) == 1
}

// THE DESIRED POPULATION IS THREE RESOURCE-ADDRESSED MEMBERS ON THE ONE FABRIC HOST, AND NONE ON A
// HOST THAT CARRIES NO FABRIC MEMBER. The second half is what stops the family proposing cells fleet
// wide the moment it is threaded into converge.
test fn witness_fabric_cell_desired_population_is_host_exact() -> Bool {
  list_length(items: fabric_cell_desired_members(host: operator_host_srv3)) == 3
    && list_length(items: fabric_cell_desired_members(host: operator_host_srv4)) == 0
    && list_length(items: fabric_cell_resource_addresses()) == 3
}

// MEMBER KEYS ARE DISTINCT PER ADDRESS. If two addresses collided the reconcile would see a
// duplicate key and refuse the whole roster -- correct behaviour for a real collision, and a
// self-inflicted outage if the key function is wrong.
test fn witness_fabric_cell_member_keys_are_address_distinct() -> Bool {
  fabric_cell_member_key(member: desired_member(address: FabricCellRootAddress))
    == "srv3|srv3-06|cell-root"
    && fabric_cell_member_key(member: desired_member(address: FabricCellAttemptRootAddress))
        == "srv3|srv3-06|attempt-root"
    && fabric_cell_member_key(member: desired_member(address: FabricCellResourceBoundaryAddress))
        == "srv3|srv3-06|resource-boundary"
}

fn verdict_is_provisioned(v: FabricCellSubstrateVerdict) -> Bool {
  match v {
    FabricCellSubstrateProvisioned { cell: _ } => true
    FabricCellSubstrateUnprovisioned { cell: _, missing_or_drifted: _ } => false
    FabricCellSubstrateObservationRefused { cell: _, blocked: _ } => false
  }
}

fn verdict_is_unprovisioned(v: FabricCellSubstrateVerdict) -> Bool {
  match v {
    FabricCellSubstrateUnprovisioned { cell: _, missing_or_drifted: _ } => true
    FabricCellSubstrateProvisioned { cell: _ } => false
    FabricCellSubstrateObservationRefused { cell: _, blocked: _ } => false
  }
}

fn verdict_is_observation_refused(v: FabricCellSubstrateVerdict) -> Bool {
  match v {
    FabricCellSubstrateObservationRefused { cell: _, blocked: _ } => true
    FabricCellSubstrateProvisioned { cell: _ } => false
    FabricCellSubstrateUnprovisioned { cell: _, missing_or_drifted: _ } => false
  }
}

test fn witness_fabric_cell_converged_readback_is_provisioned() -> Bool {
  verdict_is_provisioned(v: fabric_cell_substrate_verdict(readback: converged_readback(), slot: srv3_fabric_slot()))
}

// AN EMPTY READBACK IS UNPROVISIONED, NOT PROVISIONED AND NOT REFUSED. This is the arm that makes the
// seed honest: a fold seeded at present would report a cell nobody looked at as ready.
test fn witness_fabric_cell_empty_readback_is_unprovisioned() -> Bool {
  verdict_is_unprovisioned(
    v: fabric_cell_substrate_verdict(
      readback: fabric_cell_readback_without_observations(
        cell: fabric_cell_id_for_slot(slot: srv3_fabric_slot())
      ),
      slot: srv3_fabric_slot()
    )
  )
}

fn disposition_is_contradicted(d: FabricCellAddressDisposition) -> Bool {
  match d {
    AddressContradicted { address: _ } => true
    AddressPresent { address: _, member: _ } => false
    AddressMissingOnHost { address: _ } => false
    AddressUnobserved { address: _ } => false
    AddressUnreadable { address: _, cause: _ } => false
  }
}

fn disposition_is_present(d: FabricCellAddressDisposition) -> Bool {
  match d {
    AddressPresent { address: _, member: _ } => true
    AddressContradicted { address: _ } => false
    AddressMissingOnHost { address: _ } => false
    AddressUnobserved { address: _ } => false
    AddressUnreadable { address: _, cause: _ } => false
  }
}

// THE DISCRIMINATING RED FOR THE FAIL-OPEN CLASS. A readback carrying BOTH an observed member and an
// absent observation for one address is contradictory, and a fold that took the first match would
// call it present -- the observed member is authored FIRST in this fixture precisely so that a
// first-match implementation would go green here. The verdict must not be a function of list order.
test fn witness_fabric_cell_contradiction_does_not_resolve_by_order() -> Bool {
  let contradicted = readback_plus(
    extra: AddressAbsent { slot: srv3_fabric_slot(), address: FabricCellRootAddress }
  )
  disposition_is_contradicted(
    d: fabric_cell_address_disposition(readback: contradicted, slot: srv3_fabric_slot(), address: FabricCellRootAddress)
  )
    && disposition_is_present(
      d: fabric_cell_address_disposition(readback: contradicted, slot: srv3_fabric_slot(), address: FabricCellAttemptRootAddress)
    )
    && verdict_is_observation_refused(v: fabric_cell_substrate_verdict(readback: contradicted, slot: srv3_fabric_slot()))
}

// AN UNREADABLE RESOURCE NEVER ARRIVES AS AN ABSENT ONE. This is the empty-observation narrow in its
// most dangerous form: a probe that cannot read the cgroup returning nothing, and the reconcile
// planning a full provision over a cell it could not see.
test fn witness_fabric_cell_unreadable_address_refuses_rather_than_reading_as_absent() -> Bool {
  let refused = readback_plus(
    extra: AddressObservationRefused {
      slot: srv3_fabric_slot(),
      address: FabricCellResourceBoundaryAddress,
      cause: "probe could not read the cell resource boundary"
    }
  )
  verdict_is_observation_refused(v: fabric_cell_substrate_verdict(readback: refused, slot: srv3_fabric_slot()))
}

// A MISSING ADDRESS IS UNPROVISIONED AND NOT REFUSED -- absent and unreadable have different
// remedies, and the verdict keeps them apart.
test fn witness_fabric_cell_absent_address_is_unprovisioned_not_refused() -> Bool {
  let partial = FabricCellReadback {
    cell: fabric_cell_id_for_slot(slot: srv3_fabric_slot()),
    observations: [
      AddressObserved { member: desired_member(address: FabricCellRootAddress) },
      AddressObserved { member: desired_member(address: FabricCellAttemptRootAddress) },
      AddressAbsent { slot: srv3_fabric_slot(), address: FabricCellResourceBoundaryAddress },
    ]
  }
  verdict_is_unprovisioned(v: fabric_cell_substrate_verdict(readback: partial, slot: srv3_fabric_slot()))
}

// DRIFT IS UNPROVISIONED, NOT PROVISIONED. A present resource carrying the wrong value is the case a
// presence-only check reports as converged, which is how a cell keeps the previous slot authority's
// memory ceiling after the fleet row moves.
test fn witness_fabric_cell_drifted_digest_is_unprovisioned() -> Bool {
  let drifted = FabricCellReadback {
    cell: fabric_cell_id_for_slot(slot: srv3_fabric_slot()),
    observations: [
      AddressObserved { member: desired_member(address: FabricCellRootAddress) },
      AddressObserved { member: desired_member(address: FabricCellAttemptRootAddress) },
      AddressObserved {
        member: FabricCellMember {
          host: operator_host_srv3,
          slot: srv3_fabric_slot(),
          address: FabricCellResourceBoundaryAddress,
          state_digest: "fabric-cell-srv3-06.slice;memory_max=1" as NonEmptyStr,
          ownership: Owned,
        }
      },
    ]
  }
  verdict_is_unprovisioned(v: fabric_cell_substrate_verdict(readback: drifted, slot: srv3_fabric_slot()))
    && verdict_is_provisioned(v: fabric_cell_substrate_verdict(readback: converged_readback(), slot: srv3_fabric_slot()))
}
