module test.claim.dhcp_v4_mac_pinned_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn dhcp_mac_pinned_static_reservation_not_contradictory() -> Bool {
  extdeps.dhcp.v4.dhcp_mac_pinned_reservation_not_contradictory(
    address_origin: DhcpClient,
    assignment_policy: extdeps.dhcp.v4.StaticReservation,
  )
}

test fn dhcp_static_config_dynamic_assignment_contradictory() -> Bool {
  !extdeps.dhcp.v4.dhcp_mac_pinned_reservation_not_contradictory(
    address_origin: extdeps.dhcp.v4.StaticConfig,
    assignment_policy: DynamicLease,
  )
}
