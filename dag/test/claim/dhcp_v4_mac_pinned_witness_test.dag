module test.claim.dhcp_v4_mac_pinned_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn dhcp_mac_pinned_static_reservation_not_contradictory() -> Bool {
  dhcp_mac_pinned_reservation_not_contradictory(
    address_origin: DhcpClient,
    assignment_policy: StaticReservation,
  )
}

test fn dhcp_static_config_dynamic_assignment_contradictory() -> Bool {
  !dhcp_mac_pinned_reservation_not_contradictory(
    address_origin: StaticConfig,
    assignment_policy: DynamicLease,
  )
}
