data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data falsifier_alert_decision_witness_note: String = "ALERT-4's evidence. alert_decision performs no GitHub calls, so every property here is a fixture and a comparison — no live issue, no live run, no live clock. That is what makes the arms that are hardest to reach in production the cheapest to prove: the heartbeat boundary, the corrupt-marker refusal and the escalation-survives-undeclared-ownership property are all one call each.\\n\\nEach claim exercises ONE arm and asserts the arm itself, not merely that something happened. A decision procedure with sixteen terminal arms, eight of them refusals, is exactly the shape where `it returned a refusal` passes while the WRONG refusal is returned — and those eight route to eight different investigations, so the wrong one sends a human to the wrong place."

data falsifier_alert_decision_red_receipts_note: String = "DISCRIMINATING REDS, EXECUTED PER ARM RATHER THAN AS ONE AGGREGATE. Each mutation below was applied to gunbc.falsifier_alert_decision, the named claims run, and the mutation reverted; the third column is the control that stayed GREEN under the same mutation, which is what makes each claim discriminating rather than merely sensitive.\\n\\nDropping failure_mode from component_signature_member reds a_changed_failure_class_notifies_immediately_inside_the_window while an_unchanged_red_inside_the_window_refreshes_without_notifying stays green. Weakening the heartbeat comparison from >= to > reds an_unchanged_red_notifies_at_the_heartbeat_boundary while one_millisecond_before_the_boundary_still_suppresses stays green. Reading a malformed marker as IncidentAbsent — which is precisely the defect of a corrupt marker opening a NEW incident — reds both malformed claims while a_first_red_opens_an_issue_and_notifies stays green. Making notification_escalates consult the routings reds both halves of the escalation/ownership separation while the same control stays green. Testing the receipt before the admission reds an_untrusted_event_refuses_even_when_the_receipt_is_undecodable while an_untrusted_event_refuses_before_anything_else stays green — the ordering claim is therefore proven by the case that distinguishes it, not inferred from the case that would hold under either order.\\n\\nThat last pair is the reason both were written. A trust-first guard and a receipt-first guard agree on every input where the receipt is fine, so the only witness that can tell them apart is the one where the receipt is broken AND the event is untrusted, and it is the one that matters: it is the input on which a receipt-first program decodes an attacker-supplied artifact before deciding it was never allowed to look."

data mutation_that_reds_nothing_note: String = "A MUTATION THAT REDS NOTHING IS A SIGNAL, NOT A NULL RESULT — and it is ambiguous in a way worth stating, because the two readings have opposite remedies. It means EITHER the witness is vacuous (it would pass however the code behaved, so it is measuring nothing) OR the code is redundant (some other copy of the same rule is still enforcing the property). You cannot tell which without looking at what stayed green and why.\\n\\nBoth diagnoses came out of the same probe on this lane. Deleting the outer malformed-state guard here left every claim green because the rule also sat in both verdict folds — three copies agreeing by diligence, which is what produced AlertIncidentState. Elsewhere the same probe found a control that stayed green because the live population simply did not exhibit the property being checked, which is the vacuous case. Same instrument, opposite findings.\\n\\nThe standing move: after a wall lands, delete the wall and confirm that something reds. A wall whose removal changes nothing is not yet load-bearing, and finding out which of the two reasons applies is the cheapest diagnosis available."

data alert_expected_schema: NonEmptyStr = "floor-component-receipt/v1"

fn trusted_event_json_with_conclusion(conclusion: String) -> String {
  concat(concat(
    "{\"action\":\"completed\",\"repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"workflow_run\":{\"id\":31000000001,\"workflow_id\":161803,\"path\":\".github/workflows/falsifier.yml\",\"name\":\"affected-set-falsifier\",\"conclusion\":\"",
    conclusion),
    "\",\"html_url\":\"https://x\",\"run_started_at\":\"2026-08-06T00:00:00Z\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"head_branch\":\"main\",\"head_repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"event\":\"schedule\"}}")
}

fn untrusted_event_json() -> String {
  "{\"action\":\"completed\",\"repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"workflow_run\":{\"id\":31000000001,\"workflow_id\":161803,\"path\":\".github/workflows/falsifier.yml\",\"name\":\"affected-set-falsifier\",\"conclusion\":\"failure\",\"html_url\":\"https://x\",\"run_started_at\":\"2026-08-06T00:00:00Z\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"head_branch\":\"topic/experiment\",\"head_repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"event\":\"schedule\"}}"
}

fn admission_of(json: String) -> FalsifierAlertAdmission {
  falsifier_alert_admit(observation: workflow_run_event_from_json(text: json))
}

fn red_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "failure"))
}

fn green_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "success"))
}

fn cancelled_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "cancelled"))
}

data one_failing_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\",\"error\":\"claim is false\",\"output\":\"\",\"failure_mode\":\"WitnessRed\"}"

data other_failing_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\",\"error\":\"runner died\",\"output\":\"\",\"failure_mode\":\"Infra\"}"

fn receipt_text_with(component: String) -> String {
  concat(concat(concat(
    "{\"schema\":\"floor-component-receipt/v1\",\"workflow_name\":\"affected-set-falsifier\",\"run_id\":\"31000000001\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"component_count\":1,\"affected_set_cold_control\":null,\"selection_degradation\":null,\"unsuccessful_components\":[",
    component), "],\"components\":["), concat(component, "]}"))
}

fn receipt_input_with(component: String) -> AlertReceiptInput {
  match floor_component_receipt_decode_with(text: receipt_text_with(component: component), expected_schema: alert_expected_schema) {
    ReceiptDecoded { document: d } => ReceiptAdmitted { document: d }
    _ => ReceiptUndecodable { decoding: ReceiptNotJson { detail: "fixture failed to decode" } }
  }
}

fn red_receipt() -> AlertReceiptInput {
  receipt_input_with(component: one_failing_component)
}

fn red_receipt_other_class() -> AlertReceiptInput {
  receipt_input_with(component: other_failing_component)
}

fn signature_struct_of(component: String) -> IncidentSignature {
  match floor_component_receipt_decode_with(text: receipt_text_with(component: component), expected_schema: alert_expected_schema) {
    ReceiptDecoded { document: d } => alert_signature_of(doc: d)
    _ => IncidentSignature { members: [] }
  }
}

fn signature_struct_of_fixture() -> IncidentSignature {
  signature_struct_of(component: one_failing_component)
}

fn signature_of_fixture(component: String) -> NonEmptyStr {
  incident_signature_render(sig: signature_struct_of(component: component))
}

data escalation_handle: NonEmptyStr = "@briansrls"

fn declared_escalation() -> EscalationRecipient {
  EscalationDeclared { handle: escalation_handle }
}

fn undeclared_escalation() -> EscalationRecipient {
  EscalationUndeclared { cause: "no escalation recipient declared" as NonEmptyStr }
}

data unowned_routings_note: String = "The routing fixture is deliberately the LIVE shape: the lane owner roster in gunbc.falsifier_lane is empty, so every real routing today is RoutingOwnerUndeclared. Witnessing against the shape production actually produces is what makes the escalation-survives-unowned property mean something."

fn unowned_routings() -> List<FalsifierRouting> {
  [RoutingOwnerUndeclared {
    index: 6,
    lane: LaneSubstrateLongLane,
    cause: "no owner row for this lane" as NonEmptyStr
  }]
}

fn owned_routings() -> List<FalsifierRouting> {
  [RoutedToOwner {
    index: 6,
    lane: LaneSubstrateLongLane,
    owner: LaneOwnerHandle { handle: "@someone" as NonEmptyStr }
  }]
}

fn current_state(signature: NonEmptyStr, last: Int) -> FalsifierAlertStateDecoding {
  CurrentState {
    state: FalsifierAlertState {
      first_red: FirstRedObserved { at: 1000 },
      signature: signature,
      last_notification_at: last
    }
  }
}

fn fixture_issue() -> Issue {
  Issue {
    number: 4242,
    title: "affected-set falsifier is red" as NonEmptyStr,
    body: "",
    state: Open,
    html_url: "https://github.com/gunb-ai/gunbc/issues/4242" as NonEmptyStr,
    created_at: "2026-08-01T00:00:00Z" as Timestamp,
    updated_at: "2026-08-06T00:00:00Z" as Timestamp
  }
}

fn observed(state: FalsifierAlertStateDecoding) -> AlertIssueObservation {
  OneOpenAlertIssue { issue: fixture_issue(), state: state }
}

fn decide_observed(
  admission: FalsifierAlertAdmission,
  receipt: AlertReceiptInput,
  observation: AlertIssueObservation,
  now: Int
) -> AlertDecision {
  alert_decision(
    admission: admission,
    receipt: receipt,
    observation: observation,
    now: now,
    escalation: declared_escalation(),
    routings: unowned_routings()
  )
}

fn decide(
  admission: FalsifierAlertAdmission,
  receipt: AlertReceiptInput,
  state: FalsifierAlertStateDecoding,
  now: Int
) -> AlertDecision {
  decide_observed(admission: admission, receipt: receipt, observation: observed(state: state), now: now)
}

test fn a_first_red_opens_an_issue_and_notifies() -> Bool {
  let d = decide_observed(admission: red_admission(), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 5000)
  match d {
    OpenIssue { signature: sig, next_state: _, notification: _ } =>
      incident_signature_eq(left: sig, right: signature_struct_of_fixture())
        && alert_decision_notifies(d: d)
    _ => false
  }
}

test fn an_unchanged_red_inside_the_window_refreshes_without_notifying() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5001)
  match d {
    RefreshIssueWithoutNotification { signature: _, silent_for: s } =>
      millisecond_count(m: s) == 1 && !alert_decision_notifies(d: d)
    _ => false
  }
}

test fn an_unchanged_red_notifies_at_the_heartbeat_boundary() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let boundary = 5000 + millisecond_count(m: falsifier_alert_heartbeat_window)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: boundary)
  match d {
    RefreshAndNotifyHeartbeat { signature: _, silent_for: s, notification: _ } =>
      millisecond_count(m: s) == millisecond_count(m: falsifier_alert_heartbeat_window)
        && alert_decision_notifies(d: d)
    _ => false
  }
}

data heartbeat_boundary_note: String = "The boundary is asserted at exactly last + window and one millisecond BELOW it, because an off-by-one in that comparison is invisible in production — it shifts a twenty-hour heartbeat by a millisecond — and is exactly the kind of thing that only a fixture can pin."

test fn one_millisecond_before_the_boundary_still_suppresses() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let just_under = 5000 + millisecond_count(m: falsifier_alert_heartbeat_window) - 1
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: just_under) {
    RefreshIssueWithoutNotification { signature: _, silent_for: _ } => true
    _ => false
  }
}

data changed_class_note: String = "The two fixtures differ ONLY in failure_mode — Infra versus WitnessRed on the same index and label — and both map to outcome `failed`. That is the collapse this whole lane started from: a change of owner reading as no change at all. If the signature ever stops keying on failure_mode, this claim reds while every other claim here stays green."

test fn a_changed_failure_class_notifies_immediately_inside_the_window() -> Bool {
  let previous = signature_of_fixture(component: other_failing_component)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: previous, last: 5000), now: 5001)
  match d {
    RefreshAndNotifyChangedClass { issue: _, previous: p, current: c, next_state: _, notification: _ } =>
      incident_signature_eq(left: p, right: signature_struct_of(component: other_failing_component))
        && incident_signature_eq(left: c, right: signature_struct_of_fixture())
        && alert_decision_notifies(d: d)
    _ => false
  }
}

test fn a_green_run_notifies_and_closes_an_open_incident() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let d = decide(admission: green_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 6000)
  match d {
    NotifyGreenAndClose { notification: _ } => alert_decision_notifies(d: d)
    _ => false
  }
}

test fn a_green_run_with_no_open_incident_does_nothing() -> Bool {
  match decide_observed(admission: green_admission(), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000) {
    NoAction { reason: r } =>
      match r {
        GreenWithNoOpenIncident => true
        _ => false
      }
    _ => false
  }
}

test fn an_unexplained_cancellation_is_its_own_reason() -> Bool {
  match decide_observed(admission: cancelled_admission(), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000) {
    NoAction { reason: r } =>
      match r {
        CancellationUnexplained => true
        _ => false
      }
    _ => false
  }
}

test fn a_legacy_marker_sends_one_migration_notification() -> Bool {
  let d = decide(
    admission: red_admission(),
    receipt: red_receipt(),
    state: LegacyStateWithoutLastNotification { first_red: FirstRedObserved { at: 1000 }, signature: "old" as NonEmptyStr },
    now: 6000
  )
  match d {
    NotifyLegacyStateMigration { first_red: f, signature: _, notification: _ } =>
      match f { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false } && alert_decision_notifies(d: d)
    _ => false
  }
}

data malformed_precedes_verdict_note: String = "The corrupt-marker refusal is asserted under BOTH a red and a green run, because the ordering choice is the substantive one: a green run with a corrupt marker refuses rather than closing. Closing would look friendlier and would destroy the corrupt marker in the process — the one artifact a human needs to find out what wrote it."

test fn a_malformed_marker_reports_a_controller_failure_under_a_red_run() -> Bool {
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: StateMalformed { detail: "bad" }, now: 6000)
  match d {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: disp, notification: _ } =>
      alert_decision_notifies(d: d)
        && match c { ControllerMarkerMalformed { detail: dd } => dd == "bad", _ => false }
        && match disp { ControllerIssueObserved { issue: _ } => true, ControllerIssueUntouched => false }
    _ => false
  }
}

test fn a_malformed_marker_does_not_close_the_issue_under_a_green_run() -> Bool {
  match decide(admission: green_admission(), receipt: red_receipt(), state: StateMalformed { detail: "bad" }, now: 6000) {
    NotifyAlertControllerUnavailable { cause: _, issue_disposition: _, notification: _ } => true
    _ => false
  }
}

data guard_order_divergence_note: String = "THE TWO CLAIMS BELOW ARE NOT REDUNDANT, AND DELETING THE SECOND WOULD DELETE THE WHOLE CLAIM. Read quickly they look like the same witness twice: both feed an untrusted event and both expect RefuseUntrustedEvent. The difference is the receipt, and the difference is the entire point.\\n\\nAN ORDERING CLAIM NEEDS AN INPUT ON WHICH THE ORDERINGS DIVERGE. Trust-first and receipt-first agree on every input where the receipt decodes, so the first claim — untrusted event, good receipt — passes under BOTH orderings and therefore proves the ordering by inference rather than by measurement. Anywhere two candidate implementations agree, a test between them is measuring something else. The second claim — untrusted event AND an undecodable receipt — is the only shape on which they disagree, and it is exactly the security-relevant one: a receipt-first program decodes attacker-supplied content before concluding it was never allowed to look at it. That is the input the trust wall exists for.\\n\\nThis is recorded here rather than only in the pull request because the pull request is not where the next author will be standing. Anyone tidying this file will see two near-identical witnesses and reach for the shorter one; the shorter one is the one that carries nothing."

test fn an_untrusted_event_refuses_before_anything_else() -> Bool {
  match decide_observed(admission: admission_of(json: untrusted_event_json()), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000) {
    RefuseUntrustedEvent { admission: a } =>
      match a {
        AlertRefusedHeadBranchNotMain { observed: o, expected: _ } => o == "topic/experiment"
        _ => false
      }
    _ => false
  }
}

test fn an_untrusted_event_refuses_even_when_the_receipt_is_undecodable() -> Bool {
  match decide_observed(
    admission: admission_of(json: untrusted_event_json()),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "x" } },
    observation: NoOpenAlertIssue,
    now: 6000
  ) {
    RefuseUntrustedEvent { admission: _ } => true
    _ => false
  }
}

test fn a_mismatched_receipt_refuses_distinctly_from_a_malformed_one() -> Bool {
  let mismatch = decide_observed(
    admission: red_admission(),
    receipt: ReceiptSubjectRejected {
      mismatch: ReceiptSubjectRunIdMismatch { receipt: "999" as NonEmptyStr, event: "31000000001" as NonEmptyStr }
    },
    observation: NoOpenAlertIssue,
    now: 6000
  )
  let malformed = decide_observed(
    admission: red_admission(),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "x" } },
    observation: NoOpenAlertIssue,
    now: 6000
  )
  match mismatch {
    NotifyAlertControllerUnavailable { cause: cm, issue_disposition: _, notification: _ } =>
      match cm {
        ControllerReceiptMismatch { mismatch: _ } =>
          match malformed {
            NotifyAlertControllerUnavailable { cause: cd, issue_disposition: _, notification: _ } =>
              match cd { ControllerReceiptMalformed { decoding: _ } => true, _ => false }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

data escalation_separation_claims_note: String = "The two halves of the escalation/ownership separation, asserted in both directions. Fusing them is the easy mistake — there is exactly one handle in the tree and no lane owners at all — and fusing them either way loses a real fact."

test fn every_notifying_arm_carries_the_escalation_mention() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let opened = decide_observed(admission: red_admission(), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 5000)
  let heartbeat = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5000 + millisecond_count(m: falsifier_alert_heartbeat_window))
  let changed = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: signature_of_fixture(component: other_failing_component), last: 5000), now: 5001)
  let green = decide(admission: green_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 6000)
  let legacy = decide(admission: red_admission(), receipt: red_receipt(), state: LegacyStateWithoutLastNotification { first_red: FirstRedObserved { at: 1000 }, signature: "old" as NonEmptyStr }, now: 6000)
  fold([opened, heartbeat, changed, green, legacy], init: true, f: (acc, d) =>
    acc && match alert_decision_notification(d: d) {
      Present { value: n } => notification_escalates(n: n)
      Absent => false
    })
}

test fn an_undeclared_lane_owner_does_not_suppress_escalation() -> Bool {
  let d = alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: NoOpenAlertIssue,
    now: 5000,
    escalation: declared_escalation(),
    routings: unowned_routings()
  )
  match alert_decision_notification(d: d) {
    Present { value: n } => notification_escalates(n: n) && notification_has_unowned_routing(n: n)
    Absent => false
  }
}

data escalation_refusal_supersedes_the_old_claim_note: String = "This claim previously asserted that a notification built with an undeclared escalation recipient carried no mention and no unowned routing. It passed, and it was measuring the wrong thing: a notification that mentions nobody is not the correct handling of a missing recipient, it is the incident this lane exists to prevent, rendered structurally. The corrected behaviour refuses before any notifying arm can be constructed, so the claim now asserts the refusal AND that a declared lane owner does not rescue it — ownership of the failing lane says nothing about who is told the observer is broken."

test fn a_declared_lane_owner_does_not_substitute_for_a_missing_escalation_recipient() -> Bool {
  match alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: NoOpenAlertIssue,
    now: 5000,
    escalation: undeclared_escalation(),
    routings: owned_routings()
  ) {
    RefuseEscalationRecipientUndeclared { cause: _ } => true
    _ => false
  }
}

test fn a_non_notifying_arm_carries_no_notification_at_all() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let quiet = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5001)
  match alert_decision_notification(d: quiet) {
    Absent => !alert_decision_notifies(d: quiet)
    Present { value: _ } => false
  }
}

data payload_driven_claims_note: String = "THE SAME SIX ARMS, REACHED THROUGH THE PAYLOAD DECODER RATHER THAN THROUGH A HAND-BUILT STATE VALUE. The claims above construct CurrentState and StateMalformed directly, which isolates the decision but skips the seam that produces them in production: the alert reads a JSON marker out of an issue body, and falsifier_alert_state_from_payload is what turns those bytes into the coproduct. A decision that is correct on hand-built inputs and a decoder that is correct in isolation can still disagree about which value a given marker denotes, and no witness on either side alone would see it.\\n\\nThese six moved here when FalsifierAlertNotificationDecision was deleted. They previously exercised a SECOND throttle implementation in gunbc.falsifier_alert_state that computed the same window comparison, the same signature comparison and the same silent_for as alert_decision_red — one rule, two copies, and the copy had no production consumer at all. A review read the overlap as intentional lane staging; it was not, it was a fork, and forked rules stay in agreement only by diligence. The rule now lives once and these witnesses point at it, so the payload-decoder coverage they carry survived the consolidation instead of being deleted with the machinery."

fn state_marker_current(first_red: Int, signature: String, last: Int) -> String {
  concat(
    concat(concat("{\"first_red\":", first_red as String), concat(",\"signature\":\"", signature)),
    concat(concat("\",\"last_notification_at\":", last as String), "}")
  )
}

fn state_marker_legacy(first_red: Int, signature: String) -> String {
  concat(
    concat(concat("{\"first_red\":", first_red as String), concat(",\"signature\":\"", signature)),
    "\"}"
  )
}

fn decide_from_marker(admission: FalsifierAlertAdmission, payload: String, now: Int) -> AlertDecision {
  decide(admission: admission, receipt: red_receipt(), state: falsifier_alert_state_from_payload(payload: payload), now: now)
}

data absence_is_not_a_payload_note: String = "AN ABSENT MARKER IS NOT AN EMPTY PAYLOAD, AND THIS CLAIM PINS THE DIFFERENCE. StateAbsent means the issue body carried no marker at all; falsifier_alert_state_from_payload never produces it, because by the time bytes reach the decoder a marker was found. Absence is decided one seam earlier, by whoever searched the body.\\n\\nThis witness was first written as `an empty payload opens a first red` and it FAILED, which is the useful part: an empty string is not valid JSON, so it decodes to StateMalformed and the alert refuses. That is the correct answer and the fixture was the thing that was wrong — but the failure is worth keeping as a claim rather than a deleted mistake, because the tempting repair is on the wrong side. Making the decoder map an empty payload to StateAbsent would turn `I read a marker and could not understand it` into `there was no marker`, which is the empty-observation narrow DESIGN names: an unreadable incident record would silently start a NEW incident and overwrite the old one. The refusal is load-bearing, so it is asserted."

test fn an_empty_payload_refuses_rather_than_reading_as_an_absent_marker() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: "", now: 9999999) {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: _, notification: _ } =>
      match c { ControllerMarkerMalformed { detail: _ } => true, _ => false }
    _ => false
  }
}

test fn a_decoded_legacy_marker_notifies_exactly_once_as_a_migration() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: state_marker_legacy(first_red: 1000, signature: "a:b:c"), now: 9999999) {
    NotifyLegacyStateMigration { issue: _, first_red: f, signature: _, next_state: _, notification: _ } =>
      match f { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false }
    _ => false
  }
}

test fn a_decoded_changed_signature_always_notifies_even_inside_the_window() -> Bool {
  let previous = incident_signature_render(sig: signature_struct_of(component: other_failing_component))
  let marker = state_marker_current(first_red: 1000, signature: previous as String, last: 5000)
  match decide_from_marker(admission: red_admission(), payload: marker, now: 5001) {
    RefreshAndNotifyChangedClass { issue: _, previous: p, current: _, next_state: _, notification: _ } =>
      incident_signature_eq(left: p, right: signature_struct_of(component: other_failing_component))
    _ => false
  }
}

test fn a_decoded_unchanged_signature_is_suppressed_inside_the_window() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component) as String
  match decide_from_marker(admission: red_admission(), payload: state_marker_current(first_red: 1000, signature: sig, last: 5000), now: 5001) {
    RefreshIssueWithoutNotification { signature: _, silent_for: s } => millisecond_count(m: s) == 1
    _ => false
  }
}

test fn a_decoded_unchanged_signature_heartbeats_once_the_window_elapses() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component) as String
  let marker = state_marker_current(first_red: 1000, signature: sig, last: 5000)
  match decide_from_marker(admission: red_admission(), payload: marker, now: 5000 + millisecond_count(m: falsifier_alert_heartbeat_window)) {
    RefreshAndNotifyHeartbeat { signature: _, silent_for: s, notification: _ } =>
      millisecond_count(m: s) == millisecond_count(m: falsifier_alert_heartbeat_window)
    _ => false
  }
}

test fn a_decoded_malformed_marker_refuses_instead_of_starting_a_new_incident() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: "{\"first_red\":\"not-a-number\",\"signature\":\"x\"}", now: 9999999) {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: _, notification: _ } =>
      match c { ControllerMarkerMalformed { detail: _ } => true, _ => false }
    _ => false
  }
}

data operator_verdict_claims_note: String = "The operator verdict's five #7935 corrections. Each one had a fixture that decoded and decided cleanly BEFORE the correction — the decision was always well-typed, it was simply deciding on a fact it did not have — so every claim here is written on the input that separates the corrected behaviour from the original, not on one that merely exercises the arm."

test fn an_existing_issue_without_a_marker_is_adopted_rather_than_duplicated() -> Bool {
  match decide_observed(admission: red_admission(), receipt: red_receipt(), observation: observed(state: StateAbsent), now: 6000) {
    NotifyLegacyStateMigration { issue: iss, first_red: f, signature: _, next_state: ns, notification: _ } =>
      iss.number == 4242
        && match f { FirstRedUnknownBeforeTracking => true, FirstRedObserved { at: _ } => false }
        && match ns.first_red { FirstRedUnknownBeforeTracking => true, FirstRedObserved { at: _ } => false }
    _ => false
  }
}

test fn an_existing_issue_without_a_marker_is_closed_on_green_rather_than_ignored() -> Bool {
  match decide_observed(admission: green_admission(), receipt: red_receipt(), observation: observed(state: StateAbsent), now: 6000) {
    NotifyGreenAndClose { issue: iss, notification: _ } => iss.number == 4242
    _ => false
  }
}

test fn two_open_alert_issues_refuse_rather_than_picking_one() -> Bool {
  match decide_observed(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: MultipleOpenAlertIssues { issues: [fixture_issue(), fixture_issue()] },
    now: 6000
  ) {
    RefuseMultipleOpenIssues { count: n } => n == 2
    _ => false
  }
}

test fn a_failed_issue_lookup_refuses_rather_than_reading_as_no_issue() -> Bool {
  match decide_observed(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: AlertIssueLookupRefused { cause: "api unavailable" as NonEmptyStr },
    now: 6000
  ) {
    RefuseIssueLookup { cause: _ } => true
    _ => false
  }
}

test fn an_undeclared_escalation_recipient_refuses_before_any_notification_is_built() -> Bool {
  match alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: NoOpenAlertIssue,
    now: 5000,
    escalation: undeclared_escalation(),
    routings: unowned_routings()
  ) {
    RefuseEscalationRecipientUndeclared { cause: _ } => true
    _ => false
  }
}

data signature_structure_claims_note: String = "The order- and delimiter-independence of the incident identity, asserted directly on the structure. The receipt fixtures cannot easily be reordered through the decoder, so these compare signatures built from the same members in two orders — which is the property that matters and the one the joined string did not have."

fn identity_member(index: Nat, outcome: String, mode: String) -> ComponentIncidentIdentity {
  ComponentIncidentIdentity { index: index, outcome_tag: outcome as NonEmptyStr, failure_mode_tag: mode as NonEmptyStr }
}

test fn the_same_failing_set_in_a_different_order_is_the_same_incident() -> Bool {
  let a = IncidentSignature { members: [identity_member(index: 6, outcome: "failed", mode: "WitnessRed"), identity_member(index: 2, outcome: "failed", mode: "Infra")] }
  let b = IncidentSignature { members: [identity_member(index: 2, outcome: "failed", mode: "Infra"), identity_member(index: 6, outcome: "failed", mode: "WitnessRed")] }
  incident_signature_eq(left: a, right: b)
}

test fn a_different_failure_class_is_a_different_incident() -> Bool {
  let a = IncidentSignature { members: [identity_member(index: 6, outcome: "failed", mode: "WitnessRed")] }
  let b = IncidentSignature { members: [identity_member(index: 6, outcome: "failed", mode: "Infra")] }
  !incident_signature_eq(left: a, right: b)
}

test fn a_rendered_signature_reads_back_into_the_same_structure() -> Bool {
  let sig = IncidentSignature { members: [identity_member(index: 2, outcome: "failed", mode: "Infra"), identity_member(index: 6, outcome: "refused", mode: "BudgetExceeded")] }
  match alert_signature_of_marker(marker: incident_signature_render(sig: sig)) {
    Present { value: back } => incident_signature_eq(left: sig, right: back)
    Absent => false
  }
}

test fn an_unparseable_stored_signature_refuses_rather_than_reading_as_changed() -> Bool {
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: "not-a-signature" as NonEmptyStr, last: 5000), now: 5001) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}

data next_state_claims_note: String = "The next-state policy, one claim per writing arm, because the arms disagree about first_red and that disagreement is the entire content of the policy. The changed-class claim is the load-bearing one: it is the arm where restarting the incident clock would be most tempting and most wrong."

test fn a_first_red_starts_the_incident_clock_and_the_notification_clock_together() -> Bool {
  match decide_observed(admission: red_admission(), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 5000) {
    OpenIssue { signature: _, next_state: ns, notification: _ } =>
      match ns.first_red { FirstRedObserved { at: t } => t == 5000, FirstRedUnknownBeforeTracking => false }
        && ns.last_notification_at == 5000
    _ => false
  }
}

test fn a_heartbeat_preserves_the_incident_clock_and_moves_the_notification_clock() -> Bool {
  let sig = incident_signature_render(sig: signature_struct_of_fixture())
  let now = 5000 + millisecond_count(m: falsifier_alert_heartbeat_window)
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: now) {
    RefreshAndNotifyHeartbeat { issue: _, signature: _, next_state: ns, silent_for: _, notification: _ } =>
      match ns.first_red { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false } && ns.last_notification_at == now
    _ => false
  }
}

test fn a_silent_refresh_moves_neither_clock() -> Bool {
  let sig = incident_signature_render(sig: signature_struct_of_fixture())
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5001) {
    RefreshIssueWithoutNotification { issue: _, signature: _, next_state: ns, silent_for: _ } =>
      match ns.first_red { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false } && ns.last_notification_at == 5000
    _ => false
  }
}

test fn a_changed_class_preserves_the_incident_clock_rather_than_restarting_it() -> Bool {
  let previous = incident_signature_render(sig: IncidentSignature { members: [identity_member(index: 6, outcome: "failed", mode: "Infra")] })
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: previous, last: 5000), now: 5001) {
    RefreshAndNotifyChangedClass { issue: _, previous: _, current: _, next_state: ns, notification: _ } =>
      match ns.first_red { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false } && ns.last_notification_at == 5001
    _ => false
  }
}

data conclusion_policy_claims_note: String = "A run that never reached a corpus verdict is not a green corpus. These three assert the split the operator ruled on, and the startup-failure one is the case the original mapped to silence — a falsifier failing at startup on every run would have been reported by nobody while every run produced a clean NoAction."

test fn a_startup_failure_notifies_that_the_observer_is_unavailable() -> Bool {
  let d = decide_observed(admission: admission_of(json: trusted_event_json_with_conclusion(conclusion: "startup_failure")), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000)
  match d {
    OpenObserverIncident { conclusion_tag: t, next_state: ns, notification: _ } =>
      (t as String) == "startup_failure" && alert_decision_notifies(d: d) && ns.last_notification_at == 6000
    _ => false
  }
}

test fn a_timed_out_run_notifies_that_the_observer_is_unavailable() -> Bool {
  match decide_observed(admission: admission_of(json: trusted_event_json_with_conclusion(conclusion: "timed_out")), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000) {
    OpenObserverIncident { conclusion_tag: t, next_state: _, notification: _ } => (t as String) == "timed_out"
    _ => false
  }
}

test fn a_skipped_run_is_a_configuration_fact_not_a_green_corpus() -> Bool {
  match decide_observed(admission: admission_of(json: trusted_event_json_with_conclusion(conclusion: "skipped")), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000) {
    NoAction { reason: r } =>
      match r {
        RunPreventedByConfiguration { conclusion_tag: t } => (t as String) == "skipped"
        _ => false
      }
    _ => false
  }
}

data routing_join_claims_note: String = "The routing join, one claim per mismatch direction. The missing-routing case is the one that matters operationally: an issue that names no owner for a failing component looks exactly like an issue for a component nobody owns, and the difference is whether the routing computation is broken."

fn routing_for(index: Nat) -> FalsifierRouting {
  RoutingOwnerUndeclared { index: index, lane: LaneSubstrateLongLane, cause: "no owner row for this lane" as NonEmptyStr }
}

fn decide_with_routings(routings: List<FalsifierRouting>) -> AlertDecision {
  alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    observation: NoOpenAlertIssue,
    now: 5000,
    escalation: declared_escalation(),
    routings: routings
  )
}

test fn a_failing_component_with_no_routing_refuses() -> Bool {
  match decide_with_routings(routings: []) {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: _, notification: _ } =>
      match c {
        ControllerRoutingJoinRefused { mismatch: m } =>
          match m { RoutingsMissingForComponents { indices: xs } => count(xs) == 1, _ => false }
        _ => false
      }
    _ => false
  }
}

test fn a_routing_for_a_non_failing_component_refuses() -> Bool {
  match decide_with_routings(routings: [routing_for(index: 6), routing_for(index: 99)]) {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: _, notification: _ } =>
      match c {
        ControllerRoutingJoinRefused { mismatch: m } =>
          match m { RoutingsForNonFailingComponents { indices: xs } => count(xs) == 1, _ => false }
        _ => false
      }
    _ => false
  }
}

test fn a_duplicated_routing_refuses() -> Bool {
  match decide_with_routings(routings: [routing_for(index: 6), routing_for(index: 6)]) {
    NotifyAlertControllerUnavailable { cause: c, issue_disposition: _, notification: _ } =>
      match c {
        ControllerRoutingJoinRefused { mismatch: m } =>
          match m { RoutingsDuplicated { indices: _ } => true, _ => false }
        _ => false
      }
    _ => false
  }
}

test fn an_exact_routing_join_proceeds() -> Bool {
  match decide_with_routings(routings: [routing_for(index: 6)]) {
    OpenIssue { signature: _, next_state: _, notification: _ } => true
    _ => false
  }
}

data live_head_verdict_claims_note: String = "The operator live-head items 1-4 plus review 49873. Each of these was a case the previous revision handled plausibly and wrongly: a timed-out run reported the floor's writer broken, an adopted issue claimed to know when the incident started, a controller failure completed the workflow in silence, and a hand-edited marker index parsed into a valid-looking identity."

test fn a_timed_out_run_with_no_receipt_reports_the_observer_not_the_writer() -> Bool {
  match alert_decision(
    admission: admission_of(json: trusted_event_json_with_conclusion(conclusion: "timed_out")),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "no receipt was written" } },
    observation: NoOpenAlertIssue,
    now: 6000,
    escalation: declared_escalation(),
    routings: []
  ) {
    OpenObserverIncident { conclusion_tag: t, next_state: _, notification: _ } => (t as String) == "timed_out"
    _ => false
  }
}

test fn a_repeated_observer_outage_refreshes_the_same_incident() -> Bool {
  match alert_decision(
    admission: admission_of(json: trusted_event_json_with_conclusion(conclusion: "timed_out")),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "no receipt" } },
    observation: observed(state: current_state(signature: "observer-unavailable:timed_out" as NonEmptyStr, last: 5000)),
    now: 6000,
    escalation: declared_escalation(),
    routings: []
  ) {
    RefreshObserverIncident { issue: iss, conclusion_tag: _, next_state: ns, silent_for: _, notification: _ } =>
      iss.number == 4242
        && match ns.first_red { FirstRedObserved { at: t } => t == 1000, FirstRedUnknownBeforeTracking => false }
    _ => false
  }
}

test fn an_adopted_issue_does_not_claim_to_know_when_the_incident_started() -> Bool {
  match decide_observed(admission: red_admission(), receipt: red_receipt(), observation: observed(state: StateAbsent), now: 6000) {
    NotifyLegacyStateMigration { issue: _, first_red: f, signature: _, next_state: ns, notification: _ } =>
      match f { FirstRedUnknownBeforeTracking => true, FirstRedObserved { at: _ } => false }
        && match ns.first_red { FirstRedUnknownBeforeTracking => true, FirstRedObserved { at: _ } => false }
    _ => false
  }
}

test fn an_unknown_first_red_round_trips_through_the_marker() -> Bool {
  let marker = serialize_json(v: falsifier_alert_state_json(state: FalsifierAlertState {
    first_red: FirstRedUnknownBeforeTracking,
    signature: "6:failed:WitnessRed" as NonEmptyStr,
    last_notification_at: 5000
  }))
  match falsifier_alert_state_from_payload(payload: marker) {
    CurrentState { state: st } =>
      match st.first_red { FirstRedUnknownBeforeTracking => true, FirstRedObserved { at: _ } => false }
    _ => false
  }
}

test fn a_controller_failure_notifies_rather_than_completing_in_silence() -> Bool {
  let d = decide_observed(
    admission: red_admission(),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "receipt is not valid JSON" } },
    observation: NoOpenAlertIssue,
    now: 6000
  )
  alert_decision_notifies(d: d)
}

test fn an_untrusted_event_still_does_not_notify() -> Bool {
  let d = decide_observed(admission: admission_of(json: untrusted_event_json()), receipt: red_receipt(), observation: NoOpenAlertIssue, now: 6000)
  !alert_decision_notifies(d: d)
}

test fn a_negative_index_in_a_stored_marker_refuses_rather_than_reading_as_changed() -> Bool {
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: "-1:failed:WitnessRed" as NonEmptyStr, last: 5000), now: 5001) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}

test fn a_fractional_index_in_a_stored_marker_refuses() -> Bool {
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: "6.5:failed:WitnessRed" as NonEmptyStr, last: 5000), now: 5001) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}
