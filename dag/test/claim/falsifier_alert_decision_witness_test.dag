module test.claim.falsifier_alert_decision_witness_test

import std.types { Bool, Int, String, NonEmptyStr, EpochMs }
import std.measure { millisecond_count }
import extdeps.github.workflow_run_event { workflow_run_event_from_json }
import gunbc.falsifier_alert_admission {
  FalsifierAlertAdmission, AlertRefusedHeadBranchNotMain,
  falsifier_alert_admit
}
import gunbc.falsifier_alert_state {
  FalsifierAlertState,
  FalsifierAlertStateDecoding,
  CurrentState, LegacyStateWithoutLastNotification, StateAbsent, StateMalformed,
  falsifier_alert_heartbeat_window,
  falsifier_alert_state_from_payload
}
import gunbc.floor_component_receipt_document {
  ReceiptDecoded, ReceiptNotJson,
  ReceiptSubjectRunIdMismatch,
  floor_component_receipt_decode_with
}
import gunbc.falsifier_lane {
  FalsifierRouting, RoutedToOwner, RoutingOwnerUndeclared,
  LaneOwnerHandle, LaneSubstrateLongLane
}
import gunbc.falsifier_alert_decision {
  AlertDecision,
  NoAction, OpenIssue, RefreshIssueWithoutNotification,
  RefreshAndNotifyChangedClass, RefreshAndNotifyHeartbeat,
  NotifyGreenAndClose, NotifyLegacyStateMigration,
  RefuseMalformedState, RefuseUntrustedEvent, RefuseReceiptMismatch, RefuseReceiptMalformed,
  ConclusionNotActionable, GreenWithNoOpenIncident,
  AlertReceiptInput, ReceiptAdmitted, ReceiptSubjectRejected, ReceiptUndecodable,
  EscalationRecipient, EscalationDeclared, EscalationUndeclared,
  AlertNotification,
  alert_decision, alert_decision_notifies, alert_decision_notification,
  notification_escalates, notification_has_unowned_routing,
  alert_signature_of
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data falsifier_alert_decision_witness_note: String = "ALERT-4's evidence. alert_decision performs no GitHub calls, so every property here is a fixture and a comparison — no live issue, no live run, no live clock. That is what makes the arms that are hardest to reach in production the cheapest to prove: the heartbeat boundary, the corrupt-marker refusal and the escalation-survives-undeclared-ownership property are all one call each.\\n\\nEach claim exercises ONE arm and asserts the arm itself, not merely that something happened. A decision procedure with eleven terminal arms is exactly the shape where `it returned a refusal` passes while the wrong refusal is returned, and the four Refuse arms route to four different people."

data falsifier_alert_decision_red_receipts_note: String = "DISCRIMINATING REDS, EXECUTED PER ARM RATHER THAN AS ONE AGGREGATE. Each mutation below was applied to gunbc.falsifier_alert_decision, the named claims run, and the mutation reverted; the third column is the control that stayed GREEN under the same mutation, which is what makes each claim discriminating rather than merely sensitive.\\n\\nDropping failure_mode from component_signature_member reds a_changed_failure_class_notifies_immediately_inside_the_window while an_unchanged_red_inside_the_window_refreshes_without_notifying stays green. Weakening the heartbeat comparison from >= to > reds an_unchanged_red_notifies_at_the_heartbeat_boundary while one_millisecond_before_the_boundary_still_suppresses stays green. Reading a malformed marker as IncidentAbsent — which is precisely the defect of a corrupt marker opening a NEW incident — reds both malformed claims while a_first_red_opens_an_issue_and_notifies stays green. Making notification_escalates consult the routings reds both halves of the escalation/ownership separation while the same control stays green. Testing the receipt before the admission reds an_untrusted_event_refuses_even_when_the_receipt_is_undecodable while an_untrusted_event_refuses_before_anything_else stays green — the ordering claim is therefore proven by the case that distinguishes it, not inferred from the case that would hold under either order.\\n\\nThat last pair is the reason both were written. A trust-first guard and a receipt-first guard agree on every input where the receipt is fine, so the only witness that can tell them apart is the one where the receipt is broken AND the event is untrusted, and it is the one that matters: it is the input on which a receipt-first program decodes an attacker-supplied artifact before deciding it was never allowed to look."

data mutation_that_reds_nothing_note: String = "A MUTATION THAT REDS NOTHING IS A SIGNAL, NOT A NULL RESULT — and it is ambiguous in a way worth stating, because the two readings have opposite remedies. It means EITHER the witness is vacuous (it would pass however the code behaved, so it is measuring nothing) OR the code is redundant (some other copy of the same rule is still enforcing the property). You cannot tell which without looking at what stayed green and why.\\n\\nBoth diagnoses came out of the same probe on this lane. Deleting the outer malformed-state guard here left every claim green because the rule also sat in both verdict folds — three copies agreeing by diligence, which is what produced AlertIncidentState. Elsewhere the same probe found a control that stayed green because the live population simply did not exhibit the property being checked, which is the vacuous case. Same instrument, opposite findings.\\n\\nThe standing move: after a wall lands, delete the wall and confirm that something reds. A wall whose removal changes nothing is not yet load-bearing, and finding out which of the two reasons applies is the cheapest diagnosis available."

data alert_expected_schema: NonEmptyStr = "floor-component-receipt/v1"

fn trusted_event_json_with_conclusion(conclusion: String) -> String {
  concat(concat(
    "{\"action\":\"completed\",\"repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"workflow_run\":{\"id\":31000000001,\"workflow_id\":161803,\"path\":\".github/workflows/falsifier.yml\",\"name\":\"affected-set-falsifier\",\"conclusion\":\"",
    conclusion),
    "\",\"html_url\":\"https://x\",\"run_started_at\":\"2026-08-06T00:00:00Z\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"head_branch\":\"main\",\"head_repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"event\":\"schedule\"}}")
}

fn untrusted_event_json() -> String {
  "{\"action\":\"completed\",\"repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"workflow_run\":{\"id\":31000000001,\"workflow_id\":161803,\"path\":\".github/workflows/falsifier.yml\",\"name\":\"affected-set-falsifier\",\"conclusion\":\"failure\",\"html_url\":\"https://x\",\"run_started_at\":\"2026-08-06T00:00:00Z\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"head_branch\":\"topic/experiment\",\"head_repository\":{\"full_name\":\"gunb-ai/gunbc\"},\"event\":\"schedule\"}}"
}

fn admission_of(json: String) -> FalsifierAlertAdmission {
  falsifier_alert_admit(observation: workflow_run_event_from_json(text: json))
}

fn red_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "failure"))
}

fn green_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "success"))
}

fn cancelled_admission() -> FalsifierAlertAdmission {
  admission_of(json: trusted_event_json_with_conclusion(conclusion: "cancelled"))
}

data one_failing_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\",\"failure_mode\":\"WitnessRed\"}"

data other_failing_component: String = "{\"index\":6,\"label\":\"witness discovery\",\"outcome\":\"failed\",\"failure_mode\":\"Infra\"}"

fn receipt_text_with(component: String) -> String {
  concat(concat(concat(
    "{\"schema\":\"floor-component-receipt/v1\",\"workflow_name\":\"affected-set-falsifier\",\"run_id\":\"31000000001\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"component_count\":1,\"affected_set_cold_control\":null,\"selection_degradation\":null,\"unsuccessful_components\":[",
    component), "],\"components\":["), concat(component, "]}"))
}

fn receipt_input_with(component: String) -> AlertReceiptInput {
  match floor_component_receipt_decode_with(text: receipt_text_with(component: component), expected_schema: alert_expected_schema) {
    ReceiptDecoded { document: d } => ReceiptAdmitted { document: d }
    _ => ReceiptUndecodable { decoding: ReceiptNotJson { detail: "fixture failed to decode" } }
  }
}

fn red_receipt() -> AlertReceiptInput {
  receipt_input_with(component: one_failing_component)
}

fn red_receipt_other_class() -> AlertReceiptInput {
  receipt_input_with(component: other_failing_component)
}

fn signature_of_fixture(component: String) -> NonEmptyStr {
  match floor_component_receipt_decode_with(text: receipt_text_with(component: component), expected_schema: alert_expected_schema) {
    ReceiptDecoded { document: d } => alert_signature_of(doc: d)
    _ => "undecodable" as NonEmptyStr
  }
}

data escalation_handle: NonEmptyStr = "@briansrls"

fn declared_escalation() -> EscalationRecipient {
  EscalationDeclared { handle: escalation_handle }
}

fn undeclared_escalation() -> EscalationRecipient {
  EscalationUndeclared { cause: "no escalation recipient declared" as NonEmptyStr }
}

data unowned_routings_note: String = "The routing fixture is deliberately the LIVE shape: the lane owner roster in gunbc.falsifier_lane is empty, so every real routing today is RoutingOwnerUndeclared. Witnessing against the shape production actually produces is what makes the escalation-survives-unowned property mean something."

fn unowned_routings() -> List<FalsifierRouting> {
  [RoutingOwnerUndeclared {
    index: 6,
    lane: LaneSubstrateLongLane,
    cause: "no owner row for this lane" as NonEmptyStr
  }]
}

fn owned_routings() -> List<FalsifierRouting> {
  [RoutedToOwner {
    index: 6,
    lane: LaneSubstrateLongLane,
    owner: LaneOwnerHandle { handle: "@someone" as NonEmptyStr }
  }]
}

fn current_state(signature: NonEmptyStr, last: Int) -> FalsifierAlertStateDecoding {
  CurrentState {
    state: FalsifierAlertState {
      first_red: 1000,
      signature: signature,
      last_notification_at: last
    }
  }
}

fn decide(
  admission: FalsifierAlertAdmission,
  receipt: AlertReceiptInput,
  state: FalsifierAlertStateDecoding,
  now: Int
) -> AlertDecision {
  alert_decision(
    admission: admission,
    receipt: receipt,
    state: state,
    now: now,
    escalation: declared_escalation(),
    routings: unowned_routings()
  )
}

test fn a_first_red_opens_an_issue_and_notifies() -> Bool {
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: StateAbsent, now: 5000)
  match d {
    OpenIssue { signature: sig, notification: _ } =>
      (sig as String) == (signature_of_fixture(component: one_failing_component) as String)
        && alert_decision_notifies(d: d)
    _ => false
  }
}

test fn an_unchanged_red_inside_the_window_refreshes_without_notifying() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5001)
  match d {
    RefreshIssueWithoutNotification { signature: _, silent_for: s } =>
      millisecond_count(m: s) == 1 && !alert_decision_notifies(d: d)
    _ => false
  }
}

test fn an_unchanged_red_notifies_at_the_heartbeat_boundary() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let boundary = 5000 + millisecond_count(m: falsifier_alert_heartbeat_window)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: boundary)
  match d {
    RefreshAndNotifyHeartbeat { signature: _, silent_for: s, notification: _ } =>
      millisecond_count(m: s) == millisecond_count(m: falsifier_alert_heartbeat_window)
        && alert_decision_notifies(d: d)
    _ => false
  }
}

data heartbeat_boundary_note: String = "The boundary is asserted at exactly last + window and one millisecond BELOW it, because an off-by-one in that comparison is invisible in production — it shifts a twenty-hour heartbeat by a millisecond — and is exactly the kind of thing that only a fixture can pin."

test fn one_millisecond_before_the_boundary_still_suppresses() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let just_under = 5000 + millisecond_count(m: falsifier_alert_heartbeat_window) - 1
  match decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: just_under) {
    RefreshIssueWithoutNotification { signature: _, silent_for: _ } => true
    _ => false
  }
}

data changed_class_note: String = "The two fixtures differ ONLY in failure_mode — Infra versus WitnessRed on the same index and label — and both map to outcome `failed`. That is the collapse this whole lane started from: a change of owner reading as no change at all. If the signature ever stops keying on failure_mode, this claim reds while every other claim here stays green."

test fn a_changed_failure_class_notifies_immediately_inside_the_window() -> Bool {
  let previous = signature_of_fixture(component: other_failing_component)
  let d = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: previous, last: 5000), now: 5001)
  match d {
    RefreshAndNotifyChangedClass { previous: p, current: c, notification: _ } =>
      (p as String) == (previous as String)
        && (c as String) == (signature_of_fixture(component: one_failing_component) as String)
        && alert_decision_notifies(d: d)
    _ => false
  }
}

test fn a_green_run_notifies_and_closes_an_open_incident() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let d = decide(admission: green_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 6000)
  match d {
    NotifyGreenAndClose { notification: _ } => alert_decision_notifies(d: d)
    _ => false
  }
}

test fn a_green_run_with_no_open_incident_does_nothing() -> Bool {
  match decide(admission: green_admission(), receipt: red_receipt(), state: StateAbsent, now: 6000) {
    NoAction { reason: r } =>
      match r {
        GreenWithNoOpenIncident => true
        _ => false
      }
    _ => false
  }
}

test fn a_non_actionable_conclusion_does_nothing_and_says_why() -> Bool {
  match decide(admission: cancelled_admission(), receipt: red_receipt(), state: StateAbsent, now: 6000) {
    NoAction { reason: r } =>
      match r {
        ConclusionNotActionable { conclusion_tag: t } => (t as String) == "cancelled"
        _ => false
      }
    _ => false
  }
}

test fn a_legacy_marker_sends_one_migration_notification() -> Bool {
  let d = decide(
    admission: red_admission(),
    receipt: red_receipt(),
    state: LegacyStateWithoutLastNotification { first_red: 1000, signature: "old" as NonEmptyStr },
    now: 6000
  )
  match d {
    NotifyLegacyStateMigration { first_red: f, signature: _, notification: _ } =>
      f == 1000 && alert_decision_notifies(d: d)
    _ => false
  }
}

data malformed_precedes_verdict_note: String = "The corrupt-marker refusal is asserted under BOTH a red and a green run, because the ordering choice is the substantive one: a green run with a corrupt marker refuses rather than closing. Closing would look friendlier and would destroy the corrupt marker in the process — the one artifact a human needs to find out what wrote it."

test fn a_malformed_marker_refuses_under_a_red_run() -> Bool {
  match decide(admission: red_admission(), receipt: red_receipt(), state: StateMalformed { detail: "bad" }, now: 6000) {
    RefuseMalformedState { detail: d } => d == "bad"
    _ => false
  }
}

test fn a_malformed_marker_refuses_under_a_green_run_rather_than_closing() -> Bool {
  match decide(admission: green_admission(), receipt: red_receipt(), state: StateMalformed { detail: "bad" }, now: 6000) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}

data guard_order_divergence_note: String = "THE TWO CLAIMS BELOW ARE NOT REDUNDANT, AND DELETING THE SECOND WOULD DELETE THE WHOLE CLAIM. Read quickly they look like the same witness twice: both feed an untrusted event and both expect RefuseUntrustedEvent. The difference is the receipt, and the difference is the entire point.\\n\\nAN ORDERING CLAIM NEEDS AN INPUT ON WHICH THE ORDERINGS DIVERGE. Trust-first and receipt-first agree on every input where the receipt decodes, so the first claim — untrusted event, good receipt — passes under BOTH orderings and therefore proves the ordering by inference rather than by measurement. Anywhere two candidate implementations agree, a test between them is measuring something else. The second claim — untrusted event AND an undecodable receipt — is the only shape on which they disagree, and it is exactly the security-relevant one: a receipt-first program decodes attacker-supplied content before concluding it was never allowed to look at it. That is the input the trust wall exists for.\\n\\nThis is recorded here rather than only in the pull request because the pull request is not where the next author will be standing. Anyone tidying this file will see two near-identical witnesses and reach for the shorter one; the shorter one is the one that carries nothing."

test fn an_untrusted_event_refuses_before_anything_else() -> Bool {
  match decide(admission: admission_of(json: untrusted_event_json()), receipt: red_receipt(), state: StateAbsent, now: 6000) {
    RefuseUntrustedEvent { admission: a } =>
      match a {
        AlertRefusedHeadBranchNotMain { observed: o, expected: _ } => o == "topic/experiment"
        _ => false
      }
    _ => false
  }
}

test fn an_untrusted_event_refuses_even_when_the_receipt_is_undecodable() -> Bool {
  match decide(
    admission: admission_of(json: untrusted_event_json()),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "x" } },
    state: StateAbsent,
    now: 6000
  ) {
    RefuseUntrustedEvent { admission: _ } => true
    _ => false
  }
}

test fn a_mismatched_receipt_refuses_distinctly_from_a_malformed_one() -> Bool {
  let mismatch = decide(
    admission: red_admission(),
    receipt: ReceiptSubjectRejected {
      mismatch: ReceiptSubjectRunIdMismatch { receipt: "999" as NonEmptyStr, event: "31000000001" as NonEmptyStr }
    },
    state: StateAbsent,
    now: 6000
  )
  let malformed = decide(
    admission: red_admission(),
    receipt: ReceiptUndecodable { decoding: ReceiptNotJson { detail: "x" } },
    state: StateAbsent,
    now: 6000
  )
  match mismatch {
    RefuseReceiptMismatch { mismatch: _ } =>
      match malformed {
        RefuseReceiptMalformed { decoding: _ } => true
        _ => false
      }
    _ => false
  }
}

data escalation_separation_claims_note: String = "The two halves of the escalation/ownership separation, asserted in both directions. Fusing them is the easy mistake — there is exactly one handle in the tree and no lane owners at all — and fusing them either way loses a real fact."

test fn every_notifying_arm_carries_the_escalation_mention() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let opened = decide(admission: red_admission(), receipt: red_receipt(), state: StateAbsent, now: 5000)
  let heartbeat = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5000 + millisecond_count(m: falsifier_alert_heartbeat_window))
  let changed = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: signature_of_fixture(component: other_failing_component), last: 5000), now: 5001)
  let green = decide(admission: green_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 6000)
  let legacy = decide(admission: red_admission(), receipt: red_receipt(), state: LegacyStateWithoutLastNotification { first_red: 1000, signature: "old" as NonEmptyStr }, now: 6000)
  fold([opened, heartbeat, changed, green, legacy], init: true, f: (acc, d) =>
    acc && match alert_decision_notification(d: d) {
      Present { value: n } => notification_escalates(n: n)
      Absent => false
    })
}

test fn an_undeclared_lane_owner_does_not_suppress_escalation() -> Bool {
  let d = alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    state: StateAbsent,
    now: 5000,
    escalation: declared_escalation(),
    routings: unowned_routings()
  )
  match alert_decision_notification(d: d) {
    Present { value: n } => notification_escalates(n: n) && notification_has_unowned_routing(n: n)
    Absent => false
  }
}

test fn a_declared_lane_owner_does_not_substitute_for_a_missing_escalation_recipient() -> Bool {
  let d = alert_decision(
    admission: red_admission(),
    receipt: red_receipt(),
    state: StateAbsent,
    now: 5000,
    escalation: undeclared_escalation(),
    routings: owned_routings()
  )
  match alert_decision_notification(d: d) {
    Present { value: n } => !notification_escalates(n: n) && !notification_has_unowned_routing(n: n)
    Absent => false
  }
}

test fn a_non_notifying_arm_carries_no_notification_at_all() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component)
  let quiet = decide(admission: red_admission(), receipt: red_receipt(), state: current_state(signature: sig, last: 5000), now: 5001)
  match alert_decision_notification(d: quiet) {
    Absent => !alert_decision_notifies(d: quiet)
    Present { value: _ } => false
  }
}

data payload_driven_claims_note: String = "THE SAME SIX ARMS, REACHED THROUGH THE PAYLOAD DECODER RATHER THAN THROUGH A HAND-BUILT STATE VALUE. The claims above construct CurrentState and StateMalformed directly, which isolates the decision but skips the seam that produces them in production: the alert reads a JSON marker out of an issue body, and falsifier_alert_state_from_payload is what turns those bytes into the coproduct. A decision that is correct on hand-built inputs and a decoder that is correct in isolation can still disagree about which value a given marker denotes, and no witness on either side alone would see it.\\n\\nThese six moved here when FalsifierAlertNotificationDecision was deleted. They previously exercised a SECOND throttle implementation in gunbc.falsifier_alert_state that computed the same window comparison, the same signature comparison and the same silent_for as alert_decision_red — one rule, two copies, and the copy had no production consumer at all. A review read the overlap as intentional lane staging; it was not, it was a fork, and forked rules stay in agreement only by diligence. The rule now lives once and these witnesses point at it, so the payload-decoder coverage they carry survived the consolidation instead of being deleted with the machinery."

fn state_marker_current(first_red: Int, signature: String, last: Int) -> String {
  concat(
    concat(concat("{\"first_red\":", first_red as String), concat(",\"signature\":\"", signature)),
    concat(concat("\",\"last_notification_at\":", last as String), "}")
  )
}

fn state_marker_legacy(first_red: Int, signature: String) -> String {
  concat(
    concat(concat("{\"first_red\":", first_red as String), concat(",\"signature\":\"", signature)),
    "\"}"
  )
}

fn decide_from_marker(admission: FalsifierAlertAdmission, payload: String, now: Int) -> AlertDecision {
  decide(admission: admission, receipt: red_receipt(), state: falsifier_alert_state_from_payload(payload: payload), now: now)
}

data absence_is_not_a_payload_note: String = "AN ABSENT MARKER IS NOT AN EMPTY PAYLOAD, AND THIS CLAIM PINS THE DIFFERENCE. StateAbsent means the issue body carried no marker at all; falsifier_alert_state_from_payload never produces it, because by the time bytes reach the decoder a marker was found. Absence is decided one seam earlier, by whoever searched the body.\\n\\nThis witness was first written as `an empty payload opens a first red` and it FAILED, which is the useful part: an empty string is not valid JSON, so it decodes to StateMalformed and the alert refuses. That is the correct answer and the fixture was the thing that was wrong — but the failure is worth keeping as a claim rather than a deleted mistake, because the tempting repair is on the wrong side. Making the decoder map an empty payload to StateAbsent would turn `I read a marker and could not understand it` into `there was no marker`, which is the empty-observation narrow DESIGN names: an unreadable incident record would silently start a NEW incident and overwrite the old one. The refusal is load-bearing, so it is asserted."

test fn an_empty_payload_refuses_rather_than_reading_as_an_absent_marker() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: "", now: 9999999) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}

test fn a_decoded_legacy_marker_notifies_exactly_once_as_a_migration() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: state_marker_legacy(first_red: 1000, signature: "a:b:c"), now: 9999999) {
    NotifyLegacyStateMigration { first_red: f, signature: _, notification: _ } => f == 1000
    _ => false
  }
}

test fn a_decoded_changed_signature_always_notifies_even_inside_the_window() -> Bool {
  let marker = state_marker_current(first_red: 1000, signature: "6:discovery:Infra:failed", last: 5000)
  match decide_from_marker(admission: red_admission(), payload: marker, now: 5001) {
    RefreshAndNotifyChangedClass { previous: p, current: _, notification: _ } =>
      (p as String) == "6:discovery:Infra:failed"
    _ => false
  }
}

test fn a_decoded_unchanged_signature_is_suppressed_inside_the_window() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component) as String
  match decide_from_marker(admission: red_admission(), payload: state_marker_current(first_red: 1000, signature: sig, last: 5000), now: 5001) {
    RefreshIssueWithoutNotification { signature: _, silent_for: s } => millisecond_count(m: s) == 1
    _ => false
  }
}

test fn a_decoded_unchanged_signature_heartbeats_once_the_window_elapses() -> Bool {
  let sig = signature_of_fixture(component: one_failing_component) as String
  let marker = state_marker_current(first_red: 1000, signature: sig, last: 5000)
  match decide_from_marker(admission: red_admission(), payload: marker, now: 5000 + millisecond_count(m: falsifier_alert_heartbeat_window)) {
    RefreshAndNotifyHeartbeat { signature: _, silent_for: s, notification: _ } =>
      millisecond_count(m: s) == millisecond_count(m: falsifier_alert_heartbeat_window)
    _ => false
  }
}

test fn a_decoded_malformed_marker_refuses_instead_of_starting_a_new_incident() -> Bool {
  match decide_from_marker(admission: red_admission(), payload: "{\"first_red\":\"not-a-number\",\"signature\":\"x\"}", now: 9999999) {
    RefuseMalformedState { detail: _ } => true
    _ => false
  }
}
