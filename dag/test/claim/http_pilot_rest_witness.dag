module test.claim.http_pilot_rest_witness

import extdeps.transports.rest { RestResult, RestAnswered, RestRefused }
import extdeps.test.http_pilot

fn witness_get_post_title_nonempty() -> Bool {
  match test.HttpPilot.GetPost(post_id: 1) {
    RestAnswered { answer } => (answer.title != "") && (answer.post_id == 1)
    RestRefused { refusal: _ } => false
  }
}

fn http_pilot_rest_keystone_holds() -> Bool {
  witness_get_post_title_nonempty()
}
