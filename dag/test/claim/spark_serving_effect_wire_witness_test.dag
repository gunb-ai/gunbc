module test.claim.spark_serving_effect_wire_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// EVERY VARIANT REACHES ITS OWN ARM. Removing the wildcard is only half the fix; the other half is
// that the twelve bare names really are variant PATTERNS. A bare lowercase-or-not name in pattern
// position could bind instead of match, and a binder in the first arm would swallow every later
// effect -- reinstating the wildcard invisibly and making the exhaustiveness look real while one
// arm answered for all of them. This distinguishes those two worlds by execution: under a binder
// every call below returns the first non-linger arm's string.
test fn w_each_serving_effect_wires_to_its_own_name() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.EnableLingerForOwnAccount) == "EnableLingerForOwnAccount"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.WriteSystemUnitFile) == "WriteSystemUnitFile"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.ReloadSystemManager) == "ReloadSystemManager"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.EnableSystemUnit) == "EnableSystemUnit"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.WriteUserUnitFile) == "WriteUserUnitFile"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.ReloadUserManager) == "ReloadUserManager"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.EnableUserUnit) == "EnableUserUnit"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.InstallRuntimePackage) == "InstallRuntimePackage"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.InstallOwnedRuntimeClosure) == "InstallOwnedRuntimeClosure"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.MaterializeModelArtifact) == "MaterializeModelArtifact"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.GrantContainerRuntimeAccess) == "GrantContainerRuntimeAccess"
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.RunContainerAsOwnUser) == "RunContainerAsOwnUser"
}

// AND THE NAMES ARE DISTINCT, so the assertion above cannot be satisfied by a fold that returns one
// constant. Twelve equalities against twelve different literals is the discriminating shape; this
// pins that no two arms collapsed onto the same wire label.
test fn w_no_two_effects_share_a_wire_label() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.WriteSystemUnitFile)
    != fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.WriteUserUnitFile)
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.ReloadSystemManager)
      != fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.ReloadUserManager)
    && fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.EnableSystemUnit)
      != fleet_converge_spark_serving_effect_wire(effect: gunbc.spark.serving_realization.EnableUserUnit)
}
