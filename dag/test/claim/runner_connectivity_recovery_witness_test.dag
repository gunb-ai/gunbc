module test.claim.runner_connectivity_recovery_witness

import std.types { String, Bool, List, Timestamp }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import product.placement_supply { HostIdentity }
import gunbc.build_cache_instance { RunnerSlotIdentity, ProcessIdentity }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv2, operator_host_srv3 }
import gunbc.runner_connectivity_recovery {
  RunnerLocalIncarnation,
  RunnerLocalObservation,
  RunnerRemoteObservation,
  RunnerRemoteRegistration,
  RunnerRemoteOnline,
  RunnerRemoteOffline,
  RunnerRemoteBusy,
  RunnerSlotConnectivitySnapshot,
  RunnerConnectivityAction,
  RunnerConnectedNoop,
  RunnerIncarnationReplace,
  RunnerRepairRefused,
  RunnerRemotelyBusy,
  ObservationStale,
  HostReachAdmissionRefused,
  HostReachAdmitted,
  CanaryAwaitingVerification,
  ControlPlaneDegraded,
  RunnerControlPlaneHealthy,
  RunnerControlPlaneDegraded,
  RemoteRegistrationOfflineWhileLocalAlive,
  ReplaceVerified,
  ReplacePostconditionFailed,
  process_identity_eq,
  decide_runner_connectivity_action,
  plan_slot_connectivity_action,
  classify_control_plane_standing,
  verify_incarnation_replace_postcondition,
  action_is_replace,
  action_is_noop,
  host_reach_admission_for_fleet_host,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn act_ts(s: String) -> Timestamp {
  s as Timestamp
}

data witness_note: String = "Discriminating witnesses for the runner remote-lease recovery controller (PR B). Models the acquire-job wedge: local systemd active while GitHub registration is offline/absent. Acceptance path: before local active + remote offline -> Replace once -> after new incarnation + remote online -> rerun Noop. RED controls refuse naive watchdog shapes (busy restart, stale observation, fleet fanout while degraded). No wet actuation — plan and verified postcondition only."

fn fixture_slot(host: HostIdentity, index: Int) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: host, slot_index: index }
}

fn fixture_incarnation(slot: RunnerSlotIdentity, pid: Int, start: String) -> RunnerLocalIncarnation {
  RunnerLocalIncarnation {
    slot: slot,
    process: ProcessIdentity {
      boot_id: "boot-a" as NonEmptyStr,
      pid: pid,
      start_time: start as NonEmptyStr,
    },
    unit: "actions-runner@srv1-01.service" as NonEmptyStr,
  }
}

fn fixture_labels() -> List<String> {
  ["self-hosted", "linux", "arm64", "gunbc-heavy"]
}

fn wedged_snapshot(act_at: Timestamp) -> RunnerSlotConnectivitySnapshot {
  let slot = fixture_slot(host: operator_host_srv1, index: 1)
  let inc = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: RunnerLocalObservation {
      incarnation: inc,
      systemd_active: true,
      observed_at: act_at,
    },
    remote: RunnerRemoteObservation {
      registration: RunnerRemoteOffline,
      observed_at: act_at,
      control_plane_error_burst: false,
    },
    confirmed_at: act_at,
    last_restart_at: Absent,
  }
}

fn connected_snapshot(act_at: Timestamp, pid: Int, start: String) -> RunnerSlotConnectivitySnapshot {
  let slot = fixture_slot(host: operator_host_srv1, index: 1)
  let inc = fixture_incarnation(slot: slot, pid: pid, start: start)
  RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: RunnerLocalObservation {
      incarnation: inc,
      systemd_active: true,
      observed_at: act_at,
    },
    remote: RunnerRemoteObservation {
      registration: RunnerRemoteOnline {
        runner_name: "actions-runner@srv1-01.service" as NonEmptyStr,
        labels: fixture_labels(),
      },
      observed_at: act_at,
      control_plane_error_burst: false,
    },
    confirmed_at: act_at,
    last_restart_at: Absent,
  }
}

test fn wedged_slot_requests_incarnation_replace() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = wedged_snapshot(act_at: act)
  match decide_runner_connectivity_action(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: HostReachAdmitted,
    allow_replace: true,
  ) {
    RunnerIncarnationReplace { slot: _, from: _, cause: RemoteRegistrationOfflineWhileLocalAlive } => true
    RunnerConnectedNoop { local: _, remote: _ } => false
    RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

test fn connected_slot_is_noop() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 5000, start: "90000000")
  action_is_noop(
    action: decide_runner_connectivity_action(
      snap: snap,
      prior: snap,
      act_at: act,
      reach: HostReachAdmitted,
      allow_replace: true,
    ),
  )
}

test fn remotely_busy_slot_refuses_restart() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: operator_host_srv1, index: 2)
  let inc = fixture_incarnation(slot: slot, pid: 1111, start: "70000000")
  let snap = RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: RunnerLocalObservation { incarnation: inc, systemd_active: true, observed_at: act },
    remote: RunnerRemoteObservation {
      registration: RunnerRemoteBusy { detail: "job assigned" as NonEmptyStr },
      observed_at: act,
      control_plane_error_burst: false,
    },
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match decide_runner_connectivity_action(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: HostReachAdmitted,
    allow_replace: true,
  ) {
    RunnerRepairRefused { slot: _, cause: RunnerRemotelyBusy } => true
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    RunnerConnectedNoop { local: _, remote: _ } => false
  }
}

test fn stale_observation_refuses_restart() -> Bool {
  let snap = wedged_snapshot(act_at: act_ts(s: "2026-08-06T20:00:00Z"))
  match decide_runner_connectivity_action(
    snap: snap,
    prior: snap,
    act_at: act_ts(s: "2026-08-06T20:05:00Z"),
    reach: HostReachAdmitted,
    allow_replace: true,
  ) {
    RunnerRepairRefused { slot: _, cause: ObservationStale { observed_at: _, act_at: _ } } => true
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    RunnerConnectedNoop { local: _, remote: _ } => false
  }
}

test fn degraded_fleet_allows_only_canary_replace() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let s1 = wedged_snapshot(act_at: act)
  let s2 = RunnerSlotConnectivitySnapshot {
    slot: fixture_slot(host: operator_host_srv1, index: 2),
    local: s1.local,
    remote: s1.remote,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  let standing = classify_control_plane_standing(
    snapshots: [s1, s2],
    degraded_threshold_percent: 50,
  )
  let canary = s1.slot
  let canary_action = plan_slot_connectivity_action(
    snap: s1,
    prior: s1,
    act_at: act,
    reach: HostReachAdmitted,
    standing: standing,
    canary_slot: canary,
    canary_verified: false,
  )
  let sibling_action = plan_slot_connectivity_action(
    snap: s2,
    prior: s2,
    act_at: act,
    reach: HostReachAdmitted,
    standing: standing,
    canary_slot: canary,
    canary_verified: false,
  )
  action_is_replace(action: canary_action)
    && match sibling_action {
         RunnerRepairRefused { slot: _, cause: CanaryAwaitingVerification } => true
         RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
         RunnerConnectedNoop { local: _, remote: _ } => false
       }
}

test fn srv3_reach_refused_while_srv1_continues() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let srv1 = wedged_snapshot(act_at: act)
  let srv3_slot = fixture_slot(host: operator_host_srv3, index: 1)
  let srv3 = RunnerSlotConnectivitySnapshot {
    slot: srv3_slot,
    local: RunnerLocalObservation {
      incarnation: fixture_incarnation(slot: srv3_slot, pid: 2222, start: "60000000"),
      systemd_active: true,
      observed_at: act,
    },
    remote: RunnerRemoteObservation {
      registration: RunnerRemoteOffline,
      observed_at: act,
      control_plane_error_burst: false,
    },
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match decide_runner_connectivity_action(
    snap: srv3,
    prior: srv3,
    act_at: act,
    reach: host_reach_admission_for_fleet_host(host: operator_host_srv3),
    allow_replace: true,
  ) {
    RunnerRepairRefused { slot: _, cause: HostReachAdmissionRefused { reason: _ } } => true
    RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    RunnerConnectedNoop { local: _, remote: _ } => false
  }
    && action_is_replace(
         action: decide_runner_connectivity_action(
           snap: srv1,
           prior: srv1,
           act_at: act,
           reach: host_reach_admission_for_fleet_host(host: operator_host_srv1),
           allow_replace: true,
         ),
       )
}

test fn postcondition_verifies_new_incarnation_and_remote_online() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: operator_host_srv1, index: 1)
  let prior = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  let after_local = RunnerLocalObservation {
    incarnation: fixture_incarnation(slot: slot, pid: 5151, start: "91000000"),
    systemd_active: true,
    observed_at: act,
  }
  let after_remote = RunnerRemoteObservation {
    registration: RunnerRemoteOnline {
      runner_name: "actions-runner@srv1-01.service" as NonEmptyStr,
      labels: fixture_labels(),
    },
    observed_at: act,
    control_plane_error_burst: false,
  }
  match verify_incarnation_replace_postcondition(
    slot: slot,
    prior: prior,
    after_local: after_local,
    after_remote: after_remote,
    expected_labels: fixture_labels(),
  ) {
    ReplaceVerified { slot: _, prior: _, successor: _, remote: _ } => true
    ReplacePostconditionFailed { slot: _, reason: _ } => false
  }
}

test fn postcondition_fails_when_prior_process_survives() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: operator_host_srv1, index: 1)
  let prior = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  let after_local = RunnerLocalObservation {
    incarnation: prior,
    systemd_active: true,
    observed_at: act,
  }
  let after_remote = RunnerRemoteObservation {
    registration: RunnerRemoteOnline {
      runner_name: "actions-runner@srv1-01.service" as NonEmptyStr,
      labels: fixture_labels(),
    },
    observed_at: act,
    control_plane_error_burst: false,
  }
  match verify_incarnation_replace_postcondition(
    slot: slot,
    prior: prior,
    after_local: after_local,
    after_remote: after_remote,
    expected_labels: fixture_labels(),
  ) {
    ReplacePostconditionFailed { slot: _, reason: _ } => true
    ReplaceVerified { slot: _, prior: _, successor: _, remote: _ } => false
  }
}

test fn rerun_after_successful_replace_is_noop() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 5151, start: "91000000")
  action_is_noop(
    action: decide_runner_connectivity_action(
      snap: snap,
      prior: snap,
      act_at: act,
      reach: HostReachAdmitted,
      allow_replace: true,
    ),
  )
}

test fn control_plane_burst_classifies_degraded() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 1, start: "1")
  let burst = RunnerSlotConnectivitySnapshot {
    slot: snap.slot,
    local: snap.local,
    remote: RunnerRemoteObservation {
      registration: RunnerRemoteOffline,
      observed_at: act,
      control_plane_error_burst: true,
    },
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match classify_control_plane_standing(snapshots: [snap, burst], degraded_threshold_percent: 75) {
    RunnerControlPlaneDegraded { offline_slots: _, total_slots: _, reason: _ } => true
    RunnerControlPlaneHealthy => false
  }
}
