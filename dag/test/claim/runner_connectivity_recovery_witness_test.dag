module test.claim.runner_connectivity_recovery_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn act_ts(s: String) -> std.types.Timestamp {
  s as std.types.Timestamp
}

data witness_note: String = "Discriminating witnesses for the runner remote-lease recovery controller (PR B). Models the acquire-job wedge: local systemd active while GitHub registration is offline/absent. Acceptance path: before local active + remote offline -> Replace once -> after new incarnation + remote online -> rerun Noop. RED controls refuse naive watchdog shapes (busy restart, stale observation, fleet fanout while degraded). No wet actuation — plan and verified postcondition only."

fn fixture_slot(host: product.placement_supply.HostIdentity, index: Int) -> gunbc.build_cache_instance.RunnerSlotIdentity {
  gunbc.build_cache_instance.RunnerSlotIdentity { host: host, slot_index: index }
}

fn fixture_incarnation(slot: gunbc.build_cache_instance.RunnerSlotIdentity, pid: Int, start: String) -> gunbc.runner_connectivity_recovery.RunnerLocalIncarnation {
  gunbc.runner_connectivity_recovery.RunnerLocalIncarnation {
    slot: slot,
    process: gunbc.build_cache_instance.ProcessIdentity {
      boot_id: "boot-a" as NonEmptyStr,
      pid: pid,
      start_time: start as NonEmptyStr,
    },
    unit: "actions-runner@srv1-01.service" as NonEmptyStr,
  }
}

fn fixture_labels() -> List<String> {
  ["self-hosted", "linux", "arm64", "gunbc-heavy"]
}

fn remote_offline_evidence() -> gunbc.runner_broker_progress_watchdog.RemoteRegistrationEvidence {
  gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved {
    registration: gunbc.runner_broker_progress_watchdog.RunnerRemoteOffline,
    registration_id: "",
    grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence,
  }
}

fn remote_online_evidence(labels: List<String>) -> gunbc.runner_broker_progress_watchdog.RemoteRegistrationEvidence {
  gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved {
    registration: gunbc.runner_broker_progress_watchdog.RunnerRemoteOnline {
      runner_name: "actions-runner@srv1-01.service" as NonEmptyStr,
      labels: labels,
    },
    registration_id: "reg-1",
    grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence,
  }
}

fn remote_busy_evidence() -> gunbc.runner_broker_progress_watchdog.RemoteRegistrationEvidence {
  gunbc.runner_broker_progress_watchdog.RemoteRegistrationObserved {
    registration: gunbc.runner_broker_progress_watchdog.RunnerRemoteBusy { detail: "job assigned" as NonEmptyStr },
    registration_id: "",
    grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence,
  }
}

fn wedged_broker_progress() -> BrokerProgressObservation {
  gunbc.runner_broker_progress_watchdog.BrokerProgressSilent {
    silence_seconds: gunbc.runner_broker_progress_watchdog.runner_broker_progress_silence_bound_seconds,
    grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence,
  }
}

fn wedged_worker_observation() -> gunbc.runner_broker_progress_watchdog.RunnerWorkerObservation {
  gunbc.runner_broker_progress_watchdog.RunnerWorkerAbsent { grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence }
}

fn wedged_snapshot(act_at: std.types.Timestamp) -> gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 1)
  let inc = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation {
      incarnation: inc,
      systemd_active: true,
      observed_at: act_at,
    },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_offline_evidence(),
      observed_at: act_at,
      control_plane_error_burst: false,
    },
    broker: wedged_broker_progress(),
    worker: wedged_worker_observation(),
    registration_grace_elapsed: true,
    confirmed_at: act_at,
    last_restart_at: Absent,
  }
}

fn connected_snapshot(act_at: std.types.Timestamp, pid: Int, start: String) -> gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 1)
  let inc = fixture_incarnation(slot: slot, pid: pid, start: start)
  gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation {
      incarnation: inc,
      systemd_active: true,
      observed_at: act_at,
    },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_online_evidence(labels: fixture_labels()),
      observed_at: act_at,
      control_plane_error_burst: false,
    },
    broker: wedged_broker_progress(),
    worker: wedged_worker_observation(),
    registration_grace_elapsed: true,
    confirmed_at: act_at,
    last_restart_at: Absent,
  }
}

test fn wedged_slot_requests_incarnation_replace() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = wedged_snapshot(act_at: act)
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: gunbc.runner_connectivity_recovery.RemoteRegistrationOfflineWhileLocalAlive } => true
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: _ } => false
  }
}

test fn connected_slot_is_noop() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 5000, start: "90000000")
  gunbc.runner_connectivity_recovery.action_is_noop(
    action: gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
      snap: snap,
      prior: snap,
      act_at: act,
      reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
      allow_replace: true,
    ),
  )
}

test fn remotely_busy_slot_refuses_restart() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 2)
  let inc = fixture_incarnation(slot: slot, pid: 1111, start: "70000000")
  let snap = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation { incarnation: inc, systemd_active: true, observed_at: act },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_busy_evidence(),
      observed_at: act,
      control_plane_error_burst: false,
    },
    broker: wedged_broker_progress(),
    worker: wedged_worker_observation(),
    registration_grace_elapsed: true,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.RunnerRemotelyBusy } => true
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
  }
}

test fn stale_observation_refuses_restart() -> Bool {
  let snap = wedged_snapshot(act_at: act_ts(s: "2026-08-06T20:00:00Z"))
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: snap,
    act_at: act_ts(s: "2026-08-06T20:05:00Z"),
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.ObservationStale { observed_at: _, act_at: _ } } => true
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
  }
}

test fn degraded_fleet_allows_only_canary_replace() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let s1 = wedged_snapshot(act_at: act)
  let s2 = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 2),
    local: s1.local,
    remote: s1.remote,
    broker: s1.broker,
    worker: s1.worker,
    registration_grace_elapsed: s1.registration_grace_elapsed,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  let standing = gunbc.runner_connectivity_recovery.classify_control_plane_standing(
    snapshots: [s1, s2],
    degraded_threshold_percent: 50,
  )
  let canary = s1.slot
  let canary_action = gunbc.runner_connectivity_recovery.plan_slot_connectivity_action(
    snap: s1,
    prior: s1,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    standing: standing,
    canary_slot: canary,
    canary_verified: false,
  )
  let sibling_action = gunbc.runner_connectivity_recovery.plan_slot_connectivity_action(
    snap: s2,
    prior: s2,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    standing: standing,
    canary_slot: canary,
    canary_verified: false,
  )
  gunbc.runner_connectivity_recovery.action_is_replace(action: canary_action)
    && match sibling_action {
         gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.CanaryAwaitingVerification } => true
         gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
         gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
       }
}

test fn srv3_reach_refused_while_srv1_continues() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let srv1 = wedged_snapshot(act_at: act)
  let srv3_slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv3, index: 1)
  let srv3 = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: srv3_slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation {
      incarnation: fixture_incarnation(slot: srv3_slot, pid: 2222, start: "60000000"),
      systemd_active: true,
      observed_at: act,
    },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_offline_evidence(),
      observed_at: act,
      control_plane_error_burst: false,
    },
    broker: wedged_broker_progress(),
    worker: wedged_worker_observation(),
    registration_grace_elapsed: true,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: srv3,
    prior: srv3,
    act_at: act,
    reach: gunbc.runner_connectivity_recovery.host_reach_admission_for_fleet_host(host: gunbc.fleet_intent_network.operator_host_srv3),
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.HostReachAdmissionRefused { reason: _ } } => true
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
  }
    && gunbc.runner_connectivity_recovery.action_is_replace(
         action: gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
           snap: srv1,
           prior: srv1,
           act_at: act,
           reach: gunbc.runner_connectivity_recovery.host_reach_admission_for_fleet_host(host: gunbc.fleet_intent_network.operator_host_srv1),
           allow_replace: true,
         ),
       )
}

test fn postcondition_verifies_new_incarnation_and_remote_online() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 1)
  let prior = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  let after_local = gunbc.runner_connectivity_recovery.RunnerLocalObservation {
    incarnation: fixture_incarnation(slot: slot, pid: 5151, start: "91000000"),
    systemd_active: true,
    observed_at: act,
  }
  let after_remote = gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
    evidence: remote_online_evidence(labels: fixture_labels()),
    observed_at: act,
    control_plane_error_burst: false,
  }
  match gunbc.runner_connectivity_recovery.verify_incarnation_replace_postcondition(
    slot: slot,
    prior: prior,
    after_local: after_local,
    after_remote: after_remote,
    expected_labels: fixture_labels(),
  ) {
    gunbc.runner_connectivity_recovery.ReplaceVerified { slot: _, prior: _, successor: _, remote: _ } => true
    gunbc.runner_connectivity_recovery.ReplacePostconditionFailed { slot: _, reason: _ } => false
  }
}

test fn postcondition_fails_when_prior_process_survives() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 1)
  let prior = fixture_incarnation(slot: slot, pid: 4242, start: "80000000")
  let after_local = gunbc.runner_connectivity_recovery.RunnerLocalObservation {
    incarnation: prior,
    systemd_active: true,
    observed_at: act,
  }
  let after_remote = gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
    evidence: remote_online_evidence(labels: fixture_labels()),
    observed_at: act,
    control_plane_error_burst: false,
  }
  match gunbc.runner_connectivity_recovery.verify_incarnation_replace_postcondition(
    slot: slot,
    prior: prior,
    after_local: after_local,
    after_remote: after_remote,
    expected_labels: fixture_labels(),
  ) {
    gunbc.runner_connectivity_recovery.ReplacePostconditionFailed { slot: _, reason: _ } => true
    gunbc.runner_connectivity_recovery.ReplaceVerified { slot: _, prior: _, successor: _, remote: _ } => false
  }
}

test fn rerun_after_successful_replace_is_noop() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 5151, start: "91000000")
  gunbc.runner_connectivity_recovery.action_is_noop(
    action: gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
      snap: snap,
      prior: snap,
      act_at: act,
      reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
      allow_replace: true,
    ),
  )
}

test fn control_plane_burst_classifies_degraded() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let snap = connected_snapshot(act_at: act, pid: 1, start: "1")
  let burst = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: snap.slot,
    local: snap.local,
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_offline_evidence(),
      observed_at: act,
      control_plane_error_burst: true,
    },
    broker: snap.broker,
    worker: snap.worker,
    registration_grace_elapsed: snap.registration_grace_elapsed,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match gunbc.runner_connectivity_recovery.classify_control_plane_standing(snapshots: [snap, burst], degraded_threshold_percent: 75) {
    gunbc.runner_connectivity_recovery.RunnerControlPlaneDegraded { offline_slots: _, total_slots: _, reason: _ } => true
    gunbc.runner_connectivity_recovery.RunnerControlPlaneHealthy => false
  }
}

test fn fleet_plan_enforces_per_host_replace_cap() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let s1 = wedged_snapshot(act_at: act)
  let s2 = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 2),
    local: s1.local,
    remote: s1.remote,
    broker: s1.broker,
    worker: s1.worker,
    registration_grace_elapsed: s1.registration_grace_elapsed,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  let s3 = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 3),
    local: s1.local,
    remote: s1.remote,
    broker: s1.broker,
    worker: s1.worker,
    registration_grace_elapsed: s1.registration_grace_elapsed,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  let plan = gunbc.runner_connectivity_recovery.plan_fleet_connectivity_repair(
    snapshots: [s1, s2, s3],
    act_at: act,
    canary_verified: true,
  )
  gunbc.runner_connectivity_recovery.count_replace_actions_for_host(
    actions: plan.actions,
    host: gunbc.fleet_intent_network.operator_host_srv1,
  ) <= gunbc.runner_connectivity_recovery.runner_connectivity_max_replacements_per_host_per_tick
    && match plan.actions.skip(n: 2).first() {
         Present { value: action } =>
           match action {
             gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.HostReplacementCapExceeded { host: _, cap: _ } } =>
               true
             gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
             gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
           }
         Absent => false
       }
}

test fn offline_with_recent_broker_progress_refuses_replace() -> Bool {
  let act = act_ts(s: "2026-08-06T20:00:00Z")
  let slot = fixture_slot(host: gunbc.fleet_intent_network.operator_host_srv1, index: 4)
  let inc = fixture_incarnation(slot: slot, pid: 3333, start: "50000000")
  let snap = gunbc.runner_connectivity_recovery.RunnerSlotConnectivitySnapshot {
    slot: slot,
    local: gunbc.runner_connectivity_recovery.RunnerLocalObservation { incarnation: inc, systemd_active: true, observed_at: act },
    remote: gunbc.runner_connectivity_recovery.RunnerRemoteObservation {
      evidence: remote_offline_evidence(),
      observed_at: act,
      control_plane_error_burst: false,
    },
    broker: gunbc.runner_broker_progress_watchdog.BrokerProgressObserved {
      last_event: gunbc.runner_broker_progress_watchdog.AcquireAttempt,
      last_at: act,
      grade: gunbc.runner_broker_progress_watchdog.ObservedEvidence,
    },
    worker: wedged_worker_observation(),
    registration_grace_elapsed: true,
    confirmed_at: act,
    last_restart_at: Absent,
  }
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: snap,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.BrokerProgressStillRecent { silence_seconds: _ } } => true
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
  }
}

test fn reobservation_refuses_when_act_at_advances_after_decision_receipt() -> Bool {
  let prior = wedged_snapshot(act_at: act_ts(s: "2026-08-06T20:00:00Z"))
  let act = act_ts(s: "2026-08-06T20:05:00Z")
  let snap = wedged_snapshot(act_at: act)
  match gunbc.runner_connectivity_recovery.decide_runner_connectivity_action_for_snapshot(
    snap: snap,
    prior: prior,
    act_at: act,
    reach: gunbc.runner_broker_progress_watchdog.HostReachAdmitted,
    allow_replace: true,
  ) {
    gunbc.runner_connectivity_recovery.RunnerRepairRefused { slot: _, cause: gunbc.runner_connectivity_recovery.ReobservationRefused { reason: _ } } => true
    gunbc.runner_connectivity_recovery.RunnerIncarnationReplace { slot: _, from: _, cause: _ } => false
    gunbc.runner_connectivity_recovery.RunnerConnectedNoop { local: _, remote: _ } => false
  }
}
