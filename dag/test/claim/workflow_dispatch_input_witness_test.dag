module test.claim.workflow_dispatch_input_witness

import extdeps.github.actions {
  WorkflowDispatch, DispatchInput, InputString, InputChoice
}
import gunbc.fleet_converge_workflow {
  FleetConvergeWorkflowMode, fleet_converge_workflow_modes, fleet_converge_workflow_mode_wire,
  fleet_converge_mode_step_if, fleet_converge_mode_scope,
  FullHostPlan, LaunchEnvironmentPlan, AllocationStorePlan, DashboardDeploy,
  fleet_converge_spark_bootstrap_step_if, fleet_converge_mode_options,
  fleet_converge_workflow, expected_fleet_converge_yml,
  FleetConvergeYamlGenerated, FleetConvergeYamlGenerationRefused,
}
import gunbc.ci_spec { gunbc_ci_fleet_converge_apply_invoke, gunbc_ci_org_actions_converge_invoke, gunbc_ci_spark_bootstrap_invoke }
import extdeps.languages.yaml.gha_workflow { workflow_trigger_entry }
import extdeps.languages.yaml.types {
  YamlValue, YamlNull, YamlBool, YamlString, YamlInt, YamlFloat, YamlSequence, YamlMapping
}

fn value_is_expected_input(v: YamlValue) -> Bool {
  match v {
    YamlMapping { entries } =>
      fold(entries, init: false, f: fn(acc, entry) {
        acc || (entry.key == "inputs" && match entry.value {
          YamlMapping { entries: inputs } =>
            fold(inputs, init: false, f: fn(found, row) {
              found || (row.key == "expected_healed_sha" && match row.value {
                YamlMapping { entries: fields } =>
                  fold(fields, init: false, f: fn(has_type, field) {
                    has_type || (field.key == "type" && match field.value {
                      YamlString { value } => value == "string"
                      YamlNull => false
                      YamlBool { value: _ } => false
                      YamlInt { lexeme: _ } => false
                      YamlFloat { lexeme: _ } => false
                      YamlSequence { elements: _ } => false
                      YamlMapping { entries: _ } => false
                    })
                  })
                YamlNull => false
                YamlBool { value: _ } => false
                YamlInt { lexeme: _ } => false
                YamlFloat { lexeme: _ } => false
                YamlString { value: _ } => false
                YamlSequence { elements: _ } => false
              })
            })
          YamlNull => false
          YamlBool { value: _ } => false
          YamlInt { lexeme: _ } => false
          YamlFloat { lexeme: _ } => false
          YamlString { value: _ } => false
          YamlSequence { elements: _ } => false
        })
      })
    YamlNull => false
    YamlBool { value: _ } => false
    YamlInt { lexeme: _ } => false
    YamlFloat { lexeme: _ } => false
    YamlString { value: _ } => false
    YamlSequence { elements: _ } => false
  }
}

test fn workflow_dispatch_nonempty_inputs_are_realized_not_dropped() -> Bool {
  let entry = workflow_trigger_entry(trigger: WorkflowDispatch {
    inputs: [DispatchInput {
      name: "expected_healed_sha",
      description: Present { value: "immutable subject" },
      required: false,
      default: none,
      type: InputString
    }]
  })
  entry.key == "workflow_dispatch" && value_is_expected_input(v: entry.value)
}

test fn workflow_dispatch_empty_inputs_preserve_null_projection() -> Bool {
  match workflow_trigger_entry(trigger: WorkflowDispatch { inputs: [] }).value {
    YamlNull => true
    YamlBool { value: _ } => false
    YamlInt { lexeme: _ } => false
    YamlFloat { lexeme: _ } => false
    YamlString { value: _ } => false
    YamlSequence { elements: _ } => false
    YamlMapping { entries: _ } => false
  }
}

fn mode_input_has_choice_options(v: YamlValue) -> Bool {
  match v {
    YamlMapping { entries } =>
      fold(entries, init: false, f: fn(acc, entry) {
        acc || (entry.key == "inputs" && match entry.value {
          YamlMapping { entries: inputs } =>
            fold(inputs, init: false, f: fn(found, row) {
              found || (row.key == "mode" && match row.value {
                YamlMapping { entries: fields } =>
                  fold(fields, init: false, f: fn(has_opts, field) {
                    has_opts || (field.key == "options" && match field.value {
                      YamlSequence { elements: opts } =>
                        length(opts) == length(fleet_converge_mode_options)
                          && all(fleet_converge_mode_options, m => any(opts, o => match o { YamlString { value } => value == m  _ => false }))
                      YamlNull => false
                      YamlBool { value: _ } => false
                      YamlInt { lexeme: _ } => false
                      YamlFloat { lexeme: _ } => false
                      YamlString { value: _ } => false
                      YamlMapping { entries: _ } => false
                    })
                  })
                YamlNull => false
                YamlBool { value: _ } => false
                YamlInt { lexeme: _ } => false
                YamlFloat { lexeme: _ } => false
                YamlString { value: _ } => false
                YamlSequence { elements: _ } => false
              })
            })
          YamlNull => false
          YamlBool { value: _ } => false
          YamlInt { lexeme: _ } => false
          YamlFloat { lexeme: _ } => false
          YamlString { value: _ } => false
          YamlSequence { elements: _ } => false
        })
      })
    YamlNull => false
    YamlBool { value: _ } => false
    YamlInt { lexeme: _ } => false
    YamlFloat { lexeme: _ } => false
    YamlString { value: _ } => false
    YamlSequence { elements: _ } => false
  }
}

test fn workflow_dispatch_choice_input_projects_options_list() -> Bool {
  let entry = workflow_trigger_entry(trigger: fleet_converge_workflow.on[0])
  entry.key == "workflow_dispatch" && mode_input_has_choice_options(v: entry.value)
}

// THE COUNT IS KEPT BESIDE THE NAMES DELIBERATELY, and it moved from 2 to 3 because a
// `dashboard-deploy` job was added -- not because the check was in the way. Naming each job without
// pinning the total would let a fourth job appear unobserved; pinning the total without naming them
// would pass for any three jobs at all. Together they are an exact partition, which is the identity
// join DESIGN section 5 asks for rather than a count standing in for one.
//
// BOTH DEPLOYING JOBS NEED `build`, and that is the property this witness is really about: the
// release binaries are produced once and consumed by everything that installs them, so a job that
// mutates a host without that edge would be installing whatever happened to be lying around.
test fn fleet_converge_workflow_has_build_job_needs_release_bins() -> Bool {
  fleet_converge_workflow.jobs.length() == 4
    && fleet_converge_workflow.jobs[0].id == "build"
    && fleet_converge_workflow.jobs[1].id == "fleet-converge"
    && fleet_converge_workflow.jobs[1].needs == ["build"]
    && fleet_converge_workflow.jobs[2].id == "dashboard-deploy"
    && fleet_converge_workflow.jobs[2].needs == ["build"]
    && fleet_converge_workflow.jobs[3].id == "rlm-launch-deployment-receipt"
    && fleet_converge_workflow.jobs[3].needs == ["build"]
}

fn expected_fleet_converge_yml_content() -> String {
  match expected_fleet_converge_yml() {
    FleetConvergeYamlGenerated { content } => content
    FleetConvergeYamlGenerationRefused { reason: _ } => ""
  }
}

test fn fleet_converge_workflow_has_no_heal_revalidation_paste_through() -> Bool {
  !string_contains(s: expected_fleet_converge_yml_content(), pattern: "expected_healed_sha")
}

test fn fleet_converge_apply_step_binds_plan_hash_to_env_not_shell_literal() -> Bool {
  string_contains(
    s: expected_fleet_converge_yml_content(),
    pattern: "EXPECTED_HASH: $\{\{ github.event.inputs.plan_artifact_hash \}\}",
  )
    && !string_contains(
      s: expected_fleet_converge_yml_content(),
      pattern: "EXPECTED=\"$\{\{ github.event.inputs.plan_artifact_hash \}\}\"",
    )
    && string_contains(s: gunbc_ci_fleet_converge_apply_invoke(), pattern: "$\{EXPECTED_HASH:-\}")
}

// The org-actions mode mints its credential in-run from the App key: the step names the App's
// installation token endpoint and the key's Secret Manager version, and the workflow carries no
// repository secret for it (the interim PAT design was superseded before it was ever taken).
// The bootstrap mode is the runner-side shape of the workstation apply: same prelude as the grant
// install (fleet key agent, per-target administrator credential file), one target per run.
test fn fleet_converge_spark_bootstrap_mode_reuses_the_grant_prelude_and_names_its_entry() -> Bool {
  let invoke = gunbc_ci_spark_bootstrap_invoke()
  string_contains(s: invoke, pattern: "--entry dag/gunbc/spark/managed_access_apply.dag --function spark_managed_access_bootstrap_ci_wet")
    && string_contains(s: invoke, pattern: "GUNBC_SPARK_BOOTSTRAP_CREDENTIAL_FILE")
    && string_contains(s: invoke, pattern: "SparkAdministratorCredentialHostUnrostered")
    && string_contains(s: fleet_converge_spark_bootstrap_step_if, pattern: "mode == 'spark_bootstrap'")
}

test fn fleet_converge_org_actions_mode_binds_secret_and_modeled_entry_holds() -> Bool {
  let invoke = gunbc_ci_org_actions_converge_invoke()
  string_contains(s: invoke, pattern: "--entry dag/gunbc/fleet/org_actions_converge.dag --function org_actions_converge_wet")
    && string_contains(s: invoke, pattern: "app/installations/104134109/access_tokens")
    && string_contains(s: invoke, pattern: "secrets/ci-github-app-private-key/")
    && string_contains(s: invoke, pattern: "openssl dgst -sha256 -sign")
    && string_contains(s: invoke, pattern: "OrgAdminInstallationTokenRefused")
    && string_contains(s: invoke, pattern: "OrgAdminAppKeyUnreadable")
    && !string_contains(s: invoke, pattern: "curl -sSf -H @\"$HDR_FILE\" \"https://secretmanager")
    && !string_contains(s: expected_fleet_converge_yml_content(), pattern: "secrets.GUNBC_ORG_ADMIN_TOKEN")
}


// THE VOCABULARY IS THE ONLY SPELLING AUTHORITY, and these are the facts that make that a claim
// rather than a hope.
//
// COUNT AND DISTINCTNESS TOGETHER. Fifteen members is not enough on its own: two members returning
// the same wire string would still be fifteen, and the dispatch menu would silently offer one option
// twice while one mode became unselectable. Counting the DISTINCT wire values is what refuses that.
test fn the_mode_vocabulary_has_fifteen_members_with_fifteen_distinct_wire_values() -> Bool {
  let wires = map(fleet_converge_workflow_modes, m => fleet_converge_workflow_mode_wire(mode: m))
  count(fleet_converge_workflow_modes) == 15
    && count(wires) == 15
    && unique(xs: wires, eq: (a, b) => a == b)
}

// EVERY DISPATCH OPTION IS A WIRE VALUE, tying the menu GitHub renders to the vocabulary rather than
// to a hand-kept list that merely happens to agree with it today.
test fn every_dispatch_option_is_a_wire_value_of_the_vocabulary() -> Bool {
  let wires = map(fleet_converge_workflow_modes, m => fleet_converge_workflow_mode_wire(mode: m))
  count(fleet_converge_mode_options) == 15
    && all(fleet_converge_mode_options, o => any(wires, w => w == o))
}

// THE STEP CONDITION IS DERIVED, not spelled beside the option. The discriminating half is the
// second conjunct: a projection that returned a constant, or ignored its argument, would satisfy the
// first and fail this.
test fn a_step_condition_is_the_wire_value_of_the_mode_it_selects() -> Bool {
  fleet_converge_mode_step_if(mode: DashboardDeploy) == "github.event.inputs.mode == 'dashboard_deploy'"
    && fleet_converge_mode_step_if(mode: FullHostPlan) != fleet_converge_mode_step_if(mode: DashboardDeploy)
}

// DASHBOARD DEPLOYMENT IS EXPLICITLY OUTSIDE THE SCOPE PROJECTION, and this witness exists so that
// changing it is a deliberate act with a red here rather than a quiet consequence of adding a member
// to FleetConvergeScope. The three modes that DO name a scope are asserted beside it, so a projection
// that answered `none` for everything cannot pass.
test fn dashboard_deploy_names_no_fleet_scope_while_the_plan_modes_do() -> Bool {
  let deploy_absent = match fleet_converge_mode_scope(mode: DashboardDeploy) {
    Absent => true
    Present { value: _ } => false
  }
  let plans_present = all(
    [FullHostPlan, LaunchEnvironmentPlan, AllocationStorePlan],
    m => match fleet_converge_mode_scope(mode: m) { Present { value: _ } => true  Absent => false },
  )
  deploy_absent && plans_present
}
