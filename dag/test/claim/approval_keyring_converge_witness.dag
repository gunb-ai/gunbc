module test.claim.approval_keyring_converge_witness
import std.optional { Absent, Optional, Present }


import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, List }
import std.algebra { list_head }
import std.process { ExitSuccess }
import gunbc.auth.approval_keyring_pins { approval_mac_key_payload_sha256_prefix, approval_submission_mac_key_payload_sha256_prefix, approval_store_receipt_mac_key_payload_sha256_prefix }
import gunbc.auth.approval_keyring_converge {
  sha256_prefix_compare, Sha256PrefixMatches, Sha256PrefixMismatch, Sha256Unavailable,
  keyring_host_must_be_broker_host_under,
  approval_keyring_converge_refuses_off_broker_host_under, approval_mac_key_digest_standing,
  keyring_mkdir_argv, store_root_mkdir_argv, claim_store_root_mkdir_argv,
  roadmap_unit_restart_argv,
}
import gunbc.auth.approval_broker_state_directories {
  approval_decision_store_directory,
  broker_state_directory_install_argv,
}
import gunbc.fleet.fleet_host_identity { operator_host_srv1, operator_host_srv2 }
import gunbc.deployment_risk { NoProdRole, ProdRoleHeldBy, srv1_daily_workspace_deployment, srv2_deploy_deployment }
import gunbc.auth.approval_broker_placement { approval_broker_host_under }
import gunbc.live_deploy.desired { prod_role_actuated_realization_in }
import gunbc.deployment_risk { srv2_preview_codex_feedback_deployment }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, prod_role_realization_in, srv1_live_dashboard_instance, srv2_deploy_dashboard_instance }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn matching_prefix_is_converged() -> Bool {
  match sha256_prefix_compare(observed_hex: "113a3274bd95aabb", expected_prefix: approval_mac_key_payload_sha256_prefix) {
    Sha256PrefixMatches { prefix: p } => p == approval_mac_key_payload_sha256_prefix
    _ => false
  }
}

test fn mismatched_prefix_refuses() -> Bool {
  match sha256_prefix_compare(observed_hex: "000000000000aabb", expected_prefix: approval_mac_key_payload_sha256_prefix) {
    Sha256PrefixMismatch { expected: e, observed: o } =>
      e == approval_mac_key_payload_sha256_prefix && o as String == "000000000000"
    _ => false
  }
}

test fn short_digest_is_unavailable_not_a_match() -> Bool {
  match sha256_prefix_compare(observed_hex: "11", expected_prefix: approval_mac_key_payload_sha256_prefix) {
    Sha256Unavailable { detail: _ } => true
    _ => false
  }
}

fn keyring_roster() -> List<HostDashboardInstance> {
  [srv1_live_dashboard_instance(), srv2_deploy_dashboard_instance()]
}

test fn keyring_converge_follows_the_broker_host_not_srv1() -> Bool {
  let on_srv1 = prod_role_realization_in(selection: ProdRoleHeldBy { deployment: srv1_daily_workspace_deployment }, instances: keyring_roster())
  let on_srv2 = prod_role_realization_in(selection: ProdRoleHeldBy { deployment: srv2_deploy_deployment }, instances: keyring_roster())
  keyring_host_must_be_broker_host_under(host: operator_host_srv1 as String, broker_host: approval_broker_host_under(realization: on_srv1))
    && !keyring_host_must_be_broker_host_under(host: operator_host_srv2 as String, broker_host: approval_broker_host_under(realization: on_srv1))
    && keyring_host_must_be_broker_host_under(host: operator_host_srv2 as String, broker_host: approval_broker_host_under(realization: on_srv2))
    && !keyring_host_must_be_broker_host_under(host: operator_host_srv1 as String, broker_host: approval_broker_host_under(realization: on_srv2))
    && match approval_keyring_converge_refuses_off_broker_host_under(host: operator_host_srv2 as String, broker_host: approval_broker_host_under(realization: on_srv2)) { ExitSuccess => true  _ => false }
    && match approval_keyring_converge_refuses_off_broker_host_under(host: operator_host_srv1 as String, broker_host: approval_broker_host_under(realization: on_srv2)) { ExitSuccess => false  _ => true }
}

test fn keyring_converge_refuses_every_host_under_no_prod_role() -> Bool {
  let none_held = prod_role_realization_in(selection: NoProdRole, instances: keyring_roster())
  !keyring_host_must_be_broker_host_under(host: operator_host_srv1 as String, broker_host: approval_broker_host_under(realization: none_held))
    && match approval_keyring_converge_refuses_off_broker_host_under(host: operator_host_srv1 as String, broker_host: approval_broker_host_under(realization: none_held)) { ExitSuccess => false  _ => true }
}

test fn digest_standing_admits_the_modeled_prefix_and_refuses_a_mismatch() -> Bool {
  match approval_mac_key_digest_standing(observed_hex: "113a3274bd95aabb", expected_prefix: approval_mac_key_payload_sha256_prefix, role: "capability") { ExitSuccess => true  _ => false }
    && match approval_mac_key_digest_standing(observed_hex: "000000000000aabb", expected_prefix: approval_mac_key_payload_sha256_prefix, role: "capability") { ExitSuccess => false  _ => true }
    && match approval_mac_key_digest_standing(observed_hex: "01f19b2e2c7aaabb", expected_prefix: approval_submission_mac_key_payload_sha256_prefix, role: "submission") { ExitSuccess => true  _ => false }
    && match approval_mac_key_digest_standing(observed_hex: "000000000000aabb", expected_prefix: approval_submission_mac_key_payload_sha256_prefix, role: "submission") { ExitSuccess => false  _ => true }
    && match approval_mac_key_digest_standing(observed_hex: "d36ebaa4e653aabb", expected_prefix: approval_store_receipt_mac_key_payload_sha256_prefix, role: "store-receipt") { ExitSuccess => true  _ => false }
    && match approval_mac_key_digest_standing(observed_hex: "01f19b2e2c7aaabb", expected_prefix: approval_store_receipt_mac_key_payload_sha256_prefix, role: "store-receipt") { ExitSuccess => false  _ => true }
}

test fn keyring_mkdir_is_install_not_a_local_sudo() -> Bool {
  match list_head(xs: keyring_mkdir_argv()) {
    Present { value: w } => w == "install"
    _ => false
  }
}

test fn store_root_mkdir_is_install_not_a_local_sudo() -> Bool {
  match list_head(xs: store_root_mkdir_argv()) {
    Present { value: w } => w == "install"
    _ => false
  }
}

// THE SINGLE SOURCE (DESIGN §3): the converge lane's store-root argv IS the census row's projection —
// the keyring lane no longer states owner/mode/path for /var/lib/gunbc/approvals; it projects
// gunbc.auth.approval_broker_state_directories.approval_decision_store_directory through the one
// projection both lanes share. If either lane re-Inline its own spelling and drifts, this fails.
test fn the_store_root_argv_projects_the_census_row() -> Bool {
  store_root_mkdir_argv() == broker_state_directory_install_argv(d: approval_decision_store_directory())
}

// THE PIN THE PROJECTION MUST STILL SATISFY: the converge step installs the operator's owner-only root
// at the live srv1 shape. The path and mode are spelled LITERALLY here (not pulled from the declaring
// modules) so this is a third, independent statement of what /var/lib/gunbc/approvals must be: if the
// row's dependents or principal change and silently widen or re-home the directory, this fails on the
// converge side — where the secrets live — not only on the deploy side.
test fn the_projected_store_root_argv_is_the_operators_owner_only_install() -> Bool {
  store_root_mkdir_argv()
    == ["install", "-d", "-m", "00700", "-o", "briansrls", "-g", "briansrls", "/var/lib/gunbc/approvals"]
}

test fn claim_store_root_mkdir_is_install_for_the_ci_runner() -> Bool {
  match list_head(xs: claim_store_root_mkdir_argv()) {
    Present { value: w } => w == "install"
    _ => false
  }
}

test fn roadmap_unit_restart_is_systemctl_restart() -> Bool {
  match list_head(xs: roadmap_unit_restart_argv()) {
    Present { value: w } => w == "systemctl"
    _ => false
  }
}

// A holder in the public instance roster with NO desired_deployment_roster row (srv2-preview) is
// unactuatable: the keyring converge refuses every requested host rather than authorizing credential
// installation and a unit restart on a host nothing deploys to. The realization is the real joined
// route (prod_role_actuated_realization_in over the real desired roster).
test fn an_unactuatable_holder_refuses_the_keyring_converge_on_every_host() -> Bool {
  let broker = approval_broker_host_under(realization: prod_role_actuated_realization_in(selection: ProdRoleHeldBy { deployment: srv2_preview_codex_feedback_deployment }))
  !keyring_host_must_be_broker_host_under(host: operator_host_srv1 as String, broker_host: broker)
    && !keyring_host_must_be_broker_host_under(host: operator_host_srv2 as String, broker_host: broker)
    && match approval_keyring_converge_refuses_off_broker_host_under(host: operator_host_srv1 as String, broker_host: broker) { ExitSuccess => false  _ => true }
    && match approval_keyring_converge_refuses_off_broker_host_under(host: operator_host_srv2 as String, broker_host: broker) { ExitSuccess => false  _ => true }
}
