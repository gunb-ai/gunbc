module test.claim.map_key_derive_requirement_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// Executing floor witness for the USAGE-DERIVED half of v1.compiler.trait_derive_emit derive selection
// (v1.compiler.trait_derive_emit v1_with_map_key_requirement). compile_dag_rust_emit_check is the
// enrolled consumer: it
// compiles an inline fixture through the real emit path and asserts emitted Rust spellings, so a claim
// here is green by execution rather than by declaration. THE SUBJECT: a type that reaches a keyed-
// collection key position must derive Eq + Hash, because the container Map lowers to im::HashMap whose
// key parameter is bounded K: Hash + Eq — a fact about the type's USE that no shape classification
// produces. Every positive row is paired with a control that must stay silent, because the failure
// mode this mechanism can have is not missing the requirement (rustc refuses loudly) but fabricating
// it on a type no one keys by, which nothing downstream would ever report.
// w_non_key_record_derives_no_hash is that control at record grain and
// w_map_value_position_does_not_seed is the sharper one: it puts the SAME type in the VALUE position
// of the same container, so a rule that keyed on 'mentioned by a Map' rather than 'occupies the key
// slot' goes red on it while every other row here stays green.
// w_map_key_requirement_propagates_to_field_types pins the fixpoint rather than a one-hop read, and
// w_nullary_coproduct_key_gains_only_hash pins the union's idempotence — a nullary coproduct already
// deriving Eq and Ord from its shape roster must gain Hash alone, which is the asymmetry a wider
// constant roster cannot express and the reason the union is append-only.
// w_fn_field_record_as_map_key_refuses pins the fail-closed arm: Rc<dyn Fn> is neither Eq nor Hash, so
// a callable-field record in a key position is refused with compile_error! rather than emitted with a
// derive that cannot hold.
fn w_map_key_record_earns_eq_and_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.keyed\n\ntype PositionKey {\n  position: Int\n}\n\ntype MemoTable {\n  entries: Map<PositionKey, Int>\n}\n",
    "src/map_key_witness_keyed.rs",
    ["Eq, std::hash::Hash)]\npub struct PositionKey"],
    []
  )
}

fn w_non_key_record_derives_no_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.unkeyed\n\ntype PlainRecord {\n  position: Int\n}\n\ntype PlainHolder {\n  held: PlainRecord\n}\n",
    "src/map_key_witness_unkeyed.rs",
    ["pub struct PlainRecord"],
    ["std::hash::Hash"]
  )
}

fn w_map_value_position_does_not_seed() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.valued\n\ntype ValueOnly {\n  payload: Int\n}\n\ntype ValueTable {\n  entries: Map<String, ValueOnly>\n}\n",
    "src/map_key_witness_valued.rs",
    ["pub struct ValueOnly"],
    ["std::hash::Hash"]
  )
}

fn w_map_key_requirement_propagates_to_field_types() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.propagate\n\ntype InnerLeaf {\n  tag: Int\n}\n\ntype OuterKey {\n  inner: InnerLeaf\n}\n\ntype PropagateTable {\n  entries: Map<OuterKey, Int>\n}\n",
    "src/map_key_witness_propagate.rs",
    [
      "Eq, std::hash::Hash)]\npub struct InnerLeaf",
      "Eq, std::hash::Hash)]\npub struct OuterKey"
    ],
    []
  )
}

fn w_fn_return_type_seeds_the_requirement() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.returned\n\ntype ReturnedKey {\n  tag: Int\n}\n\nfn empty_returned_table() -> Map<ReturnedKey, Int> {\n  empty_map()\n}\n",
    "src/map_key_witness_returned.rs",
    ["Eq, std::hash::Hash)]\npub struct ReturnedKey"],
    []
  )
}

fn w_nullary_coproduct_key_gains_only_hash() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.nullary_key\n\ntype ChoiceKey\n  = ChoiceLeft\n  | ChoiceRight\n\ntype ChoiceTable {\n  entries: Map<ChoiceKey, Int>\n}\n",
    "src/map_key_witness_nullary_key.rs",
    ["pub enum ChoiceKey", "Ord, serde::Serialize, serde::Deserialize, std::hash::Hash)]"],
    ["serde::Deserialize, Eq"]
  )
}

fn w_fn_field_record_as_map_key_refuses() -> Bool {
  compile_dag_rust_emit_check(
    "module map_key_witness.callable\n\ntype CallableKey {\n  step: fn(Int) -> Int\n}\n\ntype CallableTable {\n  entries: Map<CallableKey, Int>\n}\n",
    "src/map_key_witness_callable.rs",
    ["compile_error!"],
    ["std::hash::Hash)]\npub struct CallableKey"]
  )
}

test fn map_key_record_earns_eq_and_hash() -> Bool {
  w_map_key_record_earns_eq_and_hash()
}

test fn non_key_record_derives_no_hash() -> Bool {
  w_non_key_record_derives_no_hash()
}

test fn map_value_position_does_not_seed() -> Bool {
  w_map_value_position_does_not_seed()
}

test fn map_key_requirement_propagates_to_field_types() -> Bool {
  w_map_key_requirement_propagates_to_field_types()
}

test fn fn_return_type_seeds_the_requirement() -> Bool {
  w_fn_return_type_seeds_the_requirement()
}

test fn nullary_coproduct_key_gains_only_hash() -> Bool {
  w_nullary_coproduct_key_gains_only_hash()
}

test fn fn_field_record_as_map_key_refuses() -> Bool {
  w_fn_field_record_as_map_key_refuses()
}
