module test.claim.external_model_scope_live_cover_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data live_cover_witness_note: String = "The WET half of the ExternalModelScope enrollment wall (split out of external_model_scope_witness_test after the d4bef96 floor red: hermetic discovery executed these fns against the mock corpus, where Filesystem.List directory walks and git.Core.DiffNameStatus have no published operations, so they refused — correct hermetic behavior, wrong lane). This file performs genuinely live host effects (a real directory walk of dag/extdeps; a real git diff freeze..HEAD) and is discovery-excluded via the gunbc.ci_layer_roots wet-integration posture with a documented local recipe. The pure decision fns it executes (scope_cover_holds, manifest_freeze_holds) live on gunbc.extdeps_scope_frontier and keep their hermetic RED controls discovery-enrolled in external_model_scope_witness_test, where the carrier-content check (filesystem_read carve-out, hermetic-safe) also stays per-PR — the discriminating logic runs per-PR; only the live observations (directory walk, git diff) run on the wet lane."

fn read_manifest_rows_live() -> List<String> {
  let r = filesystem_read(path: gunbc.extdeps_scope_frontier.legacy_extdeps_scope_frontier_manifest_path)
  gunbc.extdeps_scope_frontier.parse_frontier_manifest(content: r.content)
}

fn scope_roster_union_live() -> List<String> {
  concat(gunbc.extdeps_scope_frontier.scope_carrier_paths, concat(gunbc.extdeps_scope_frontier.scope_machinery_exempt_paths, read_manifest_rows_live()))
}

type ScopeCoverWalk {
  files: List<String>
  walk_failures: Int
}

fn scope_cover_walk(path: String) -> ScopeCoverWalk {
  let l = Filesystem.List(path: path)
  if l.success {
    if l.entries == "" {
      ScopeCoverWalk { files: [], walk_failures: 0 }
    } else {
      fold(split(l.entries, separator: "\n"), init: ScopeCoverWalk { files: [], walk_failures: 0 }, f: fn(acc, name) {
        let child = concat(path, "/", name)
        if name.ends_with(suffix: ".dag") {
          ScopeCoverWalk { files: concat(acc.files, [child]), walk_failures: acc.walk_failures }
        } else {
          let sub = scope_cover_walk(path: child)
          ScopeCoverWalk { files: concat(acc.files, sub.files), walk_failures: acc.walk_failures + sub.walk_failures }
        }
      })
    }
  } else {
    ScopeCoverWalk { files: [], walk_failures: 1 }
  }
}

test fn red_cover_walker_refuses_missing_root() -> Bool {
  let w = scope_cover_walk(path: "dag/extdeps_nonexistent_probe_root")
  w.walk_failures == 1 && (w.files |> count) == 0
}

test fn frontier_cover_of_live_extdeps_tree_holds() -> Bool {
  let w = scope_cover_walk(path: "dag/extdeps")
  w.walk_failures == 0
    && gunbc.extdeps_scope_frontier.scope_cover_holds(walked: w.files, union: scope_roster_union_live())
    && (w.files |> count) > 150
}

test fn manifest_rows_all_predate_freeze_sha() -> Bool {
  gunbc.extdeps_scope_frontier.manifest_freeze_holds(manifest: read_manifest_rows_live(), observation: tools.extdeps_scope_placement_gate.scope_placement_added_paths())
}
