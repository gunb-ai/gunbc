}

test fn witness_srv2_cursor_selection_resolves() -> Bool {
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_and_cursor_available(
      instance: srv2_lab_dashboard_instance(),
    ),
    request: gunbc.dispatch_selection.SelectCursor {
      profile: ProfileAutomatic,
      credential: CursorLocalLoginRef,
      model: extdeps.llm.cursor_cli.cursor_model_auto,
      agent_mode: "default-edit",
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      receipt.provider_kind == CursorCliProvider
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_receipt_records_requested_and_resolved() -> Bool {
  let request = gunbc.dispatch_selection.SelectAutomatically { profile: ProfileAutomatic }
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    request: request,
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.requested_selection {
        SelectAutomatically { profile: ProfileAutomatic } =>
          match receipt.resolved_selection {
            ResolvedCodex { selection: s, instance: _, account_binding: _ } =>
              s.effort == ReasoningMedium
                && receipt.applied_effort == ReasoningMedium
                && receipt.provider_kind == CodexCliProvider
                && match receipt.resolved_execution {
                  DispatchResolvedExecution {
                    provider_instance: inst,
                    credential_binding: CodexCredentialBinding { binding: _ },
                    model_identity: DispatchModelNamed { model: m },
                    provider_control: CodexProviderControl { effort: e },
                    provider_version: _,
                    temporal_bounds: DispatchTemporalUnobserved { reason: _ },
                    usage_observations: DispatchUsageUnobserved { reason: _ },
                    attempt_identity: DispatchAttemptUnassigned { reason: _ },
                  } =>
                    inst.kind == CodexCliProvider
                      && m == dispatch_codex_default_model
                      && e == ReasoningMedium
                }
            _ => false
          }
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_carrier_notes_record_directive_addendum() -> Bool {
  string_contains(
    s: dispatch_execution_preference_alias_note,
    pattern: "ExecutionPreference",
  )
    && string_contains(
      s: dispatch_deep_selection_heuristic_note,
      pattern: "RISK/JUDGMENT",
    )
    && string_contains(
      s: dispatch_execution_receipt_bar_note,
      pattern: "REQUESTED",
    )
}

