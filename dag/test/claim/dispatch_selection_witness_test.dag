fn fixture_multibucket_codex_standing_inventory(
  instance: HostDashboardInstance,
) -> ProviderInventory {
  ProviderInventory {
    offers: [
      fixture_codex_offer_with_standing(
        instance: instance,
        standing: provider_standing_from_fixture_bundle(
          provider: ProviderInstance {
            kind: CodexCliProvider,
            host: ProviderInstanceFieldUnobserved { reason: "fixture" as NonEmptyStr },
            executable: "codex" as NonEmptyStr,
            observed_version: ProviderInstanceFieldUnobserved { reason: "fixture" as NonEmptyStr },
            state_directory: ProviderInstanceFieldUnobserved { reason: "fixture" as NonEmptyStr },
            credential_storage_method: ProviderInstanceFieldUnobserved {
              reason: "fixture" as NonEmptyStr,
            },
            service_identity: ProviderInstanceFieldUnobserved { reason: "fixture" as NonEmptyStr },
          },
          bundle: ProviderStandingBundle {
            installation: InstallationReady,
            authentication: AuthenticationAuthenticated,
            entitlement: EntitlementObservedAvailable,
            limits: [
              LimitExhausted {
                subject: ProviderNativeLimitBucket {
                  credential: LimitCredentialUnspecified,
                  native_key: codex_default_native_limit_bucket,
                },
                native_token: codex_default_native_limit_bucket,
              },
              LimitObservedAvailable {
                subject: ProviderNativeLimitBucket {
                  credential: LimitCredentialUnspecified,
                  native_key: codex_bengalfox_native_limit_bucket,
                },
              },
            ],
            turn: TurnNotStarted,
            tool_environment: ToolEnvironmentReady,
          },
        ),
      ),
    ],
  }
}

test fn witness_automatic_codex_preserves_medium_effort() -> Bool {
  automatic_codex_behavior_preservation_holds(
    instance: srv1_live_dashboard_instance(),
  )
}

test fn witness_intricacy_does_not_change_automatic_effort() -> Bool {
  let inventory = fixture_inventory_codex_only_available(
    instance: srv1_live_dashboard_instance(),
  )
  let high = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Sized {
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  let low = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Sized {
      intricacy: IntricacyLow,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  match high {
    DispatchSelectionResolved { receipt: high_receipt } =>
      match low {
        DispatchSelectionResolved { receipt: low_receipt } =>
          high_receipt.applied_effort == ReasoningMedium
            && low_receipt.applied_effort == ReasoningMedium
            && high_receipt.applied_effort == low_receipt.applied_effort
        DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } =>
          false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_deep_profile_refuses_without_realization() -> Bool {
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    request: SelectAutomatically { profile: ProfileDeep },
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => true
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_srv1_inventory_includes_codex() -> Bool {
  inventory_includes_provider_kind(
    inventory: ProviderInventory {
      offers: [
        fixture_codex_offer_with_standing(
          instance: srv1_live_dashboard_instance(),
          standing: provider_standing_inventory_unobserved(),
        ),
      ],
    },
    kind: CodexCliProvider,
  )
}

test fn witness_srv2_inventory_includes_cursor() -> Bool {
  let instance = srv2_lab_dashboard_instance()
  inventory_includes_provider_kind(
    inventory: ProviderInventory {
      offers: [
        fixture_codex_offer_with_standing(
          instance: instance,
          standing: provider_standing_inventory_unobserved(),
        ),
        OfferCursor {
          offer: CursorOffer {
            instance: ProviderInstance {
              kind: CursorCliProvider,
              host: ProviderInstanceFieldUnobserved {
                reason: "fixture cursor inventory row" as NonEmptyStr,
              },
              executable: "cursor-agent" as NonEmptyStr,
              observed_version: ProviderInstanceFieldUnobserved {
                reason: "fixture cursor inventory row" as NonEmptyStr,
              },
              state_directory: ProviderInstanceFieldUnobserved {
                reason: "fixture cursor inventory row" as NonEmptyStr,
              },
              credential_storage_method: ProviderInstanceFieldUnobserved {
                reason: "fixture cursor inventory row" as NonEmptyStr,
              },
              service_identity: ProviderInstanceFieldUnobserved {
                reason: "fixture cursor inventory row" as NonEmptyStr,
              },
            },
            credential: CursorLocalLoginRef,
            standing: provider_standing_inventory_unobserved(),
            default_model: cursor_model_auto,
            process_fingerprint: dispatch_cursor_process_fingerprint,
          },
        },
      ],
    },
    kind: CursorCliProvider,
  )
}

test fn witness_srv2_cursor_selection_resolves() -> Bool {
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_and_cursor_available(
      instance: srv2_lab_dashboard_instance(),
    ),
    request: SelectCursor {
      profile: ProfileAutomatic,
      credential: CursorLocalLoginRef,
      model: cursor_model_auto,
      agent_mode: "default-edit",
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      receipt.provider_kind == CursorCliProvider
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_receipt_records_requested_and_resolved() -> Bool {
  let request = SelectAutomatically { profile: ProfileAutomatic }
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    request: request,
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.requested_selection {
        SelectAutomatically { profile: ProfileAutomatic } =>
          match receipt.resolved_selection {
            ResolvedCodex { selection: s, instance: _, account_binding: _ } =>
              s.effort == ReasoningMedium
                && receipt.applied_effort == ReasoningMedium
                && receipt.provider_kind == CodexCliProvider
                && match receipt.resolved_execution {
                  DispatchResolvedExecution {
                    provider_instance: inst,
                    credential_binding: CodexCredentialBinding { binding: _ },
                    model_identity: DispatchModelNamed { model: m },
                    provider_control: CodexProviderControl { effort: e },
                    provider_version: _,
                    temporal_bounds: DispatchTemporalUnobserved { reason: _ },
                    usage_observations: DispatchUsageUnobserved { reason: _ },
                    attempt_identity: DispatchAttemptUnassigned { reason: _ },
                  } =>
                    inst.kind == CodexCliProvider
                      && m == dispatch_codex_default_model
                      && e == ReasoningMedium
                }
            _ => false
          }
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_carrier_notes_record_directive_addendum() -> Bool {
  string_contains(
    s: dispatch_execution_preference_alias_note,
    pattern: "ExecutionPreference",
  )
    && string_contains(
      s: dispatch_deep_selection_heuristic_note,
      pattern: "RISK/JUDGMENT",
    )
    && string_contains(
      s: dispatch_execution_receipt_bar_note,
      pattern: "REQUESTED",
    )
}

test fn witness_wrong_selection_shape_refuses() -> Bool {
  match dispatch_selection_for_instance(
    instance: srv1_live_dashboard_instance(),
    request: SelectCursor {
      profile: ProfileAutomatic,
      credential: CursorLocalLoginRef,
      model: cursor_model_auto,
      agent_mode: "default-edit",
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      reason == dispatch_selection_shape_mismatch_reason
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_probe_bridge_ineligible_standing_refuses_selection() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let inventory = ProviderInventory {
    offers: [
      fixture_codex_offer_with_standing(
        instance: instance,
        standing: provider_standing_from_observed_bundle(
          fact_id: selection_fixture_standing_fact_id,
          provider: codex_offer_for_instance_with_standing(
            instance: instance,
            standing: provider_standing_inventory_unobserved(),
          ).instance,
          bundle: provider_standing_bundle_from_codex_dashboard_probes(
            observation: CodexProviderDashboardProbeObservation {
              state_root: CodexStateRootPresent,
              runtime: ProviderDashboardExecProbeReported {
                succeeded: true,
                stdout: "codex-cli 0.145.0" as String,
                stderr: "" as String,
              },
              auth: ProviderDashboardExecProbeReported {
                succeeded: true,
                stdout: "" as String,
                stderr: "Logged in using ChatGPT" as String,
              },
            },
          ),
        ),
      ),
    ],
  }
  match resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      reason == dispatch_selection_standing_ineligible_reason
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_claude_request_refuses_on_codex_only_inventory() -> Bool {
  match dispatch_selection_for_instance(
    instance: srv1_live_dashboard_instance(),
    request: provider_selection_request_for_kind(kind: ClaudeCliProvider),
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      reason == dispatch_selection_shape_mismatch_reason
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_exact_override_requires_explicit_provider_arm() -> Bool {
  match dispatch_selection_for_instance(
    instance: srv1_live_dashboard_instance(),
    request: SelectAutomatically { profile: ProfileExactOverride },
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => true
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_automatic_multibucket_native_exhaustion_refuses_join_undetermined() -> Bool {
  let inventory = fixture_multibucket_codex_standing_inventory(
    instance: srv1_live_dashboard_instance(),
  )
  match resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      reason == dispatch_selection_automatic_native_bucket_join_undetermined_refusal(native_key: codex_default_native_limit_bucket)
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_explicit_override_bengalfox_admitted_from_same_inventory() -> Bool {
  let inventory = fixture_multibucket_codex_standing_inventory(
    instance: srv1_live_dashboard_instance(),
  )
  match resolve_dispatch_selection(
    inventory: inventory,
    request: SelectCodex {
      profile: ProfileExactOverride,
      account: codex_roadmap_account_selection(),
      model: dispatch_codex_default_model,
      effort: ReasoningMedium,
      operator_asserted_native_limit_bucket: Present {
        value: codex_bengalfox_native_limit_bucket,
      },
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.resolved_selection {
        ResolvedCodex { selection: s } =>
          receipt.provider_kind == CodexCliProvider
            && s.model == dispatch_codex_default_model
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn dispatch_selection_keystone_holds() -> Bool {
  witness_automatic_codex_preserves_medium_effort()
    && witness_intricacy_does_not_change_automatic_effort()
    && witness_deep_profile_refuses_without_realization()
    && witness_srv1_inventory_includes_codex()
    && witness_srv2_inventory_includes_cursor()
    && witness_srv2_cursor_selection_resolves()
    && witness_receipt_records_requested_and_resolved()
    && witness_carrier_notes_record_directive_addendum()
    && witness_wrong_selection_shape_refuses()
    && witness_probe_bridge_ineligible_standing_refuses_selection()
    && witness_claude_request_refuses_on_codex_only_inventory()
    && witness_exact_override_requires_explicit_provider_arm()
    && witness_automatic_multibucket_native_exhaustion_refuses_join_undetermined()
    && witness_explicit_override_bengalfox_admitted_from_same_inventory()
}
