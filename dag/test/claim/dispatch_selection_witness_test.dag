    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_receipt_records_requested_and_resolved() -> Bool {
  let request = gunbc.dispatch_selection.SelectAutomatically { profile: gunbc.dispatch_selection.ProfileAutomatic }
  match gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: gunbc.dispatch_selection.fixture_inventory_codex_only_available(
      instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
    ),
    request: request,
    node_sizing: gunbc.roadmap_model.Unsized,
  ) {
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt } =>
      match receipt.requested_selection {
        gunbc.dispatch_selection.SelectAutomatically { profile: gunbc.dispatch_selection.ProfileAutomatic } =>
          match receipt.resolved_selection {
            gunbc.dispatch_selection.ResolvedCodex { selection: s, instance: _, account_binding: _ } =>
              s.effort == extdeps.llm.cli.ReasoningMedium
                && receipt.applied_effort == extdeps.llm.cli.ReasoningMedium
                && receipt.provider_kind == extdeps.llm.cli_lifecycle.CodexCliProvider
                && match receipt.resolved_execution {
                  gunbc.dispatch_selection.DispatchResolvedExecution {
                    provider_instance: inst,
                    credential_binding: gunbc.dispatch_selection.CodexCredentialBinding { binding: _ },
                    model_identity: gunbc.dispatch_selection.DispatchModelNamed { model: m },
                    provider_control: gunbc.dispatch_selection.CodexProviderControl { effort: e },
                    provider_version: _,
                    temporal_bounds: gunbc.dispatch_selection.DispatchTemporalUnobserved { reason: _ },
                    usage_observations: gunbc.dispatch_selection.DispatchUsageUnobserved { reason: _ },
                    attempt_identity: gunbc.dispatch_selection.DispatchAttemptUnassigned { reason: _ },
                  } =>
                    inst.kind == extdeps.llm.cli_lifecycle.CodexCliProvider
                      && m == gunbc.dispatch_selection.dispatch_codex_default_model
                      && e == extdeps.llm.cli.ReasoningMedium
                }
            _ => false
          }
        _ => false
      }
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_carrier_notes_record_directive_addendum() -> Bool {
  string_contains(
    s: gunbc.dispatch_selection.dispatch_execution_preference_alias_note,
    pattern: "ExecutionPreference",
  )
    && string_contains(
      s: gunbc.dispatch_selection.dispatch_deep_selection_heuristic_note,
      pattern: "RISK/JUDGMENT",
    )
    && string_contains(
      s: gunbc.dispatch_selection.dispatch_execution_receipt_bar_note,
      pattern: "REQUESTED",
    )
}

