  }
}

test fn witness_probe_bridge_ineligible_standing_refuses_selection() -> Bool {
  let instance = srv1_live_dashboard_instance()
  match dashboard_instance_provider_executable(instance: instance) {
    Absent => false
    Present { value: executable } =>
      match resolve_dispatch_selection(
        inventory: gunbc.dispatch_selection.ProviderInventory {
          offers: [
            fixture_codex_offer_with_standing(
              instance: instance,
              standing: provider_standing_from_observed_bundle(
                fact_id: selection_fixture_standing_fact_id,
                provider: codex_offer_for_instance_with_standing(
                  instance: instance,
                  standing: provider_standing_inventory_unobserved(),
                  executable: executable,
                  process_fingerprint: fixture_codex_process_fingerprint_standing(),
                ).instance,
                bundle: provider_standing_bundle_from_codex_dashboard_probes(
                  observation: gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
                    state_root: CodexStateRootPresent,
                    runtime: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "codex-cli 0.145.0" as String,
                      stderr: "" as String,
                    },
                    auth: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "" as String,
                      stderr: "Logged in using ChatGPT" as String,
                    },
                  },
                ),
              ),
              executable: executable,
            ),
          ],
        },
        request: default_provider_selection_request(),
        node_sizing: Unsized,
      ) {
        DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
          reason == dispatch_selection_standing_ineligible_reason
        DispatchSelectionResolved { receipt: _ } => false
      }
  }
}

test fn witness_srv1_claude_selection_resolves_with_fixture_standing() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let claude_provider = extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: ClaudeCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture claude inventory row" as std.types.NonEmptyStr },
    executable: "claude" as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
  }
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_then_claude(
      instance: instance,
      codex_standing: provider_standing_inventory_unobserved(),
      claude_standing: provider_standing_from_fixture_bundle(
        provider: claude_provider,
        bundle: fixture_standing_bundle_authenticated_available(),
      ),
    ),
    request: provider_selection_request_for_kind(kind: ClaudeCliProvider),
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.resolved_selection {
        ResolvedClaude { selection: s, instance: _ } =>
          receipt.provider_kind == ClaudeCliProvider
            && s.effort == ReasoningMedium
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

