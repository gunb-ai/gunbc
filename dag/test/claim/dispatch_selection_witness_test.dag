      profile: gunbc.dispatch_selection.ProfileAutomatic,
      credential: gunbc.dispatch_selection.CursorLocalLoginRef,
      model: extdeps.llm.cursor_cli.cursor_model_auto,
      agent_mode: "default-edit",
