test fn witness_probe_bridge_ineligible_standing_refuses_selection() -> Bool {
  let instance = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  match gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable(instance: instance) {
    Absent => false
    Present { value: executable } =>
      match gunbc.dispatch_selection.resolve_dispatch_selection(
        inventory: gunbc.dispatch_selection.ProviderInventory {
          offers: [
            gunbc.dispatch_selection.fixture_codex_offer_with_standing(
              instance: instance,
              standing: gunbc.provider_standing.provider_standing_from_observed_bundle(
                fact_id: gunbc.provider_standing.selection_fixture_standing_fact_id,
                provider: gunbc.dispatch_selection.codex_offer_for_instance_with_standing(
                  instance: instance,
                  standing: gunbc.provider_standing.provider_standing_inventory_unobserved(),
                  executable: executable,
                  process_fingerprint: gunbc.dispatch_selection.fixture_codex_process_fingerprint_standing(),
                ).instance,
                bundle: gunbc.provider_standing_probe_bridge.provider_standing_bundle_from_codex_dashboard_probes(
                  observation: gunbc.provider_standing_probe_bridge.CodexProviderDashboardProbeObservation {
                    state_root: gunbc.provider_standing_probe_bridge.CodexStateRootPresent,
                    runtime: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "codex-cli 0.145.0" as String,
                      stderr: "" as String,
                    },
                    auth: gunbc.provider_standing_probe_bridge.ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "" as String,
                      stderr: "Logged in using ChatGPT" as String,
                    },
                  },
                ),
              ),
              executable: executable,
            ),
          ],
        },
        request: gunbc.dispatch_selection.default_provider_selection_request(),
        node_sizing: gunbc.roadmap_model.Unsized,
      ) {
        gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
          reason == gunbc.dispatch_selection.dispatch_selection_standing_ineligible_reason
        gunbc.dispatch_selection.DispatchSelectionResolved { receipt: _ } => false
      }
  }
}

test fn witness_srv1_claude_selection_resolves_with_fixture_standing() -> Bool {
  let instance = gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()
  let claude_provider = extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture claude inventory row" as std.types.NonEmptyStr },
    executable: "claude" as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
  }
  match gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: gunbc.dispatch_selection.fixture_inventory_codex_then_claude(
      instance: instance,
      codex_standing: gunbc.provider_standing.provider_standing_inventory_unobserved(),
      claude_standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
        provider: claude_provider,
        bundle: gunbc.provider_standing.fixture_standing_bundle_authenticated_available(),
      ),
    ),
    request: gunbc.dispatch_selection.provider_selection_request_for_kind(kind: extdeps.llm.cli_lifecycle.ClaudeCliProvider),
    node_sizing: gunbc.roadmap_model.Unsized,
  ) {
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt } =>
      match receipt.resolved_selection {
        gunbc.dispatch_selection.ResolvedClaude { selection: s, instance: _ } =>
          receipt.provider_kind == extdeps.llm.cli_lifecycle.ClaudeCliProvider
            && s.effort == extdeps.llm.cli.ReasoningMedium
        _ => false
      }
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

