module test.claim.dispatch_selection_witness


fn fixture_multibucket_codex_standing_inventory(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> gunbc.dispatch_selection.ProviderInventory {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable(instance: instance) {
    Absent => gunbc.dispatch_selection.ProviderInventory { offers: [] }
    Present { value: executable } =>
      gunbc.dispatch_selection.ProviderInventory {
        offers: [
          gunbc.dispatch_selection.fixture_codex_offer_with_standing(
            instance: instance,
            executable: executable,
            standing: gunbc.provider_standing.provider_standing_from_fixture_bundle(
              provider: extdeps.llm.cli_lifecycle.ProviderInstance {
                kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
                host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                executable: "codex" as std.types.NonEmptyStr,
                observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
                  reason: "fixture" as std.types.NonEmptyStr,
                },
                service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
              },
              bundle: gunbc.provider_standing.ProviderStandingBundle {
                installation: gunbc.provider_standing.InstallationReady,
                authentication: gunbc.provider_standing.AuthenticationAuthenticated,
                entitlement: gunbc.provider_standing.EntitlementObservedAvailable,
                limits: [
                  gunbc.provider_standing.LimitExhausted {
                    subject: gunbc.provider_standing.ProviderNativeLimitBucket {
                      credential: gunbc.provider_standing.LimitCredentialUnspecified,
                      native_key: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
                    },
                    native_token: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
                  },
                  gunbc.provider_standing.LimitObservedAvailable {
                    subject: gunbc.provider_standing.ProviderNativeLimitBucket {
                      credential: gunbc.provider_standing.LimitCredentialUnspecified,
                      native_key: extdeps.llm.codex_app_server.codex_bengalfox_rate_limit_id,
                    },
                  },
                ],
                turn: gunbc.provider_standing.TurnNotStarted,
                tool_environment: gunbc.provider_standing.ToolEnvironmentReady,
              },
            ),
          ),
        ],
      }
  }
}

test fn witness_automatic_codex_preserves_medium_effort() -> Bool {
  gunbc.dispatch_selection.automatic_codex_behavior_preservation_holds(
    instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
  )
}

test fn witness_intricacy_does_not_change_automatic_effort() -> Bool {
  let inventory = gunbc.dispatch_selection.fixture_inventory_codex_only_available(
    instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
  )
  let high = gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: inventory,
    request: gunbc.dispatch_selection.default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Sized {
      intricacy: gunbc.roadmap_model.IntricacyHigh,
      volume: gunbc.roadmap_model.VolumeMedium,
      repo: "gunbc",
      acceptance: gunbc.roadmap_model.PrsMerged,
    },
  )
  let low = gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: inventory,
    request: gunbc.dispatch_selection.default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Sized {
      intricacy: gunbc.roadmap_model.IntricacyLow,
      volume: gunbc.roadmap_model.VolumeMedium,
      repo: "gunbc",
      acceptance: gunbc.roadmap_model.PrsMerged,
    },
  )
  match high {
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt: high_receipt } =>
      match low {
        gunbc.dispatch_selection.DispatchSelectionResolved { receipt: low_receipt } =>
          high_receipt.applied_effort == extdeps.llm.cli.ReasoningMedium
            && low_receipt.applied_effort == extdeps.llm.cli.ReasoningMedium
            && high_receipt.applied_effort == low_receipt.applied_effort
        gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } =>
          false
      }
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_deep_profile_refuses_without_realization() -> Bool {
  match gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: gunbc.dispatch_selection.fixture_inventory_codex_only_available(
      instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
    ),
    request: gunbc.dispatch_selection.SelectAutomatically { profile: gunbc.dispatch_selection.ProfileDeep },
    node_sizing: gunbc.roadmap_model.Unsized,
  ) {
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => true
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_production_codex_selection_refuses_unobserved_fingerprint() -> Bool {
  let inventory = gunbc.dispatch_selection.provider_inventory_for_instance(
    instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
  )
  let production_offer_is_unobserved = any(inventory.offers, offer =>
    match offer {
      gunbc.dispatch_selection.OfferCodex { offer: o } =>
        match o.process_fingerprint {
          gunbc.codex_provider_runtime_receipt.CodexProcessFingerprintUnobserved { reason: _ } => true
          _ => false
        }
      _ => false
    }
  )
  match gunbc.dispatch_selection.resolve_dispatch_selection(
    inventory: inventory,
    request: gunbc.dispatch_selection.default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Unsized,
  ) {
    gunbc.dispatch_selection.DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      production_offer_is_unobserved
        && (
          reason == gunbc.dispatch_selection.dispatch_codex_process_fingerprint_unobserved_selection_refusal
          || reason == gunbc.dispatch_selection.dispatch_selection_standing_ineligible_reason
        )
    gunbc.dispatch_selection.DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_srv1_inventory_includes_codex() -> Bool {
  match gunbc.roadmap_dashboard_instance.dashboard_instance_provider_executable(instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance()) {
