              instance: gunbc.roadmap_dashboard_instance.srv1_live_dashboard_instance(),
              standing: gunbc.provider_standing.provider_standing_inventory_unobserved(),
              executable: executable,
            ),
          ],
        },
        kind: extdeps.llm.cli_lifecycle.CodexCliProvider,
      )
  }
}

