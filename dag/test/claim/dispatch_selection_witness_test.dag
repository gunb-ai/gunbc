module test.claim.dispatch_selection_witness


fn fixture_multibucket_codex_standing_inventory(
  instance: gunbc.roadmap_dashboard_instance.HostDashboardInstance,
) -> gunbc.dispatch_selection.ProviderInventory {
  match dashboard_instance_provider_executable(instance: instance) {
    Absent => gunbc.dispatch_selection.ProviderInventory { offers: [] }
    Present { value: executable } =>
      gunbc.dispatch_selection.ProviderInventory {
        offers: [
          fixture_codex_offer_with_standing(
            instance: instance,
            executable: executable,
            standing: provider_standing_from_fixture_bundle(
              provider: extdeps.llm.cli_lifecycle.ProviderInstance {
                kind: CodexCliProvider,
                host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                executable: "codex" as std.types.NonEmptyStr,
                observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
                credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
                  reason: "fixture" as std.types.NonEmptyStr,
                },
                service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture" as std.types.NonEmptyStr },
              },
              bundle: gunbc.provider_standing.ProviderStandingBundle {
                installation: InstallationReady,
                authentication: AuthenticationAuthenticated,
                entitlement: EntitlementObservedAvailable,
                limits: [
                  gunbc.provider_standing.LimitExhausted {
                    subject: gunbc.provider_standing.ProviderNativeLimitBucket {
                      credential: LimitCredentialUnspecified,
                      native_key: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
                    },
                    native_token: extdeps.llm.codex_app_server.codex_default_rate_limit_id,
                  },
                  gunbc.provider_standing.LimitObservedAvailable {
                    subject: gunbc.provider_standing.ProviderNativeLimitBucket {
                      credential: LimitCredentialUnspecified,
                      native_key: codex_bengalfox_rate_limit_id,
                    },
                  },
                ],
                turn: TurnNotStarted,
                tool_environment: ToolEnvironmentReady,
              },
            ),
          ),
        ],
      }
  }
}

test fn witness_automatic_codex_preserves_medium_effort() -> Bool {
  automatic_codex_behavior_preservation_holds(
    instance: srv1_live_dashboard_instance(),
  )
}

test fn witness_intricacy_does_not_change_automatic_effort() -> Bool {
  let inventory = fixture_inventory_codex_only_available(
    instance: srv1_live_dashboard_instance(),
  )
  let high = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Sized {
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  let low = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: gunbc.roadmap_model.Sized {
      intricacy: IntricacyLow,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  match high {
    DispatchSelectionResolved { receipt: high_receipt } =>
      match low {
        DispatchSelectionResolved { receipt: low_receipt } =>
          high_receipt.applied_effort == ReasoningMedium
            && low_receipt.applied_effort == ReasoningMedium
            && high_receipt.applied_effort == low_receipt.applied_effort
        DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } =>
          false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_deep_profile_refuses_without_realization() -> Bool {
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    request: gunbc.dispatch_selection.SelectAutomatically { profile: ProfileDeep },
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => true
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_production_codex_selection_refuses_unobserved_fingerprint() -> Bool {
  let inventory = provider_inventory_for_instance(
    instance: srv1_live_dashboard_instance(),
  )
  let production_offer_is_unobserved = any(inventory.offers, offer =>
    match offer {
      OfferCodex { offer: o } =>
        match o.process_fingerprint {
          CodexProcessFingerprintUnobserved { reason: _ } => true
          _ => false
        }
      _ => false
    }
  )
  match resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      production_offer_is_unobserved
        && (
          reason == dispatch_codex_process_fingerprint_unobserved_selection_refusal
          || reason == dispatch_selection_standing_ineligible_reason
        )
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_srv1_inventory_includes_codex() -> Bool {
  match dashboard_instance_provider_executable(instance: srv1_live_dashboard_instance()) {
    Absent => false
    Present { value: executable } =>
      inventory_includes_provider_kind(
        inventory: gunbc.dispatch_selection.ProviderInventory {
          offers: [
            fixture_codex_offer_with_standing(
              instance: srv1_live_dashboard_instance(),
              standing: provider_standing_inventory_unobserved(),
              executable: executable,
            ),
          ],
        },
        kind: CodexCliProvider,
      )
  }
}

