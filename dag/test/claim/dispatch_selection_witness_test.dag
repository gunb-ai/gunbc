test fn witness_automatic_multibucket_native_exhaustion_refuses_join_undetermined() -> Bool {
  let inventory = fixture_multibucket_codex_standing_inventory(
    instance: srv1_live_dashboard_instance(),
  )
  match resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Unsized,
  ) {
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
      reason == dispatch_selection_automatic_native_bucket_join_undetermined_refusal(native_key: extdeps.llm.codex_app_server.codex_default_rate_limit_id)
    DispatchSelectionResolved { receipt: _ } => false
  }
}

test fn witness_explicit_override_bengalfox_admitted_from_same_inventory() -> Bool {
  let inventory = fixture_multibucket_codex_standing_inventory(
    instance: srv1_live_dashboard_instance(),
  )
  match resolve_dispatch_selection(
    inventory: inventory,
    request: gunbc.dispatch_selection.SelectCodex {
      profile: ProfileExactOverride,
      account: codex_roadmap_account_selection(),
      model: dispatch_codex_default_model,
      effort: ReasoningMedium,
      operator_asserted_native_limit_bucket: Present {
        value: codex_bengalfox_rate_limit_id,
      },
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.resolved_selection {
        ResolvedCodex { selection: s } =>
          receipt.provider_kind == CodexCliProvider
            && s.model == dispatch_codex_default_model
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_select_claude_automatic_honors_request_credential_and_model() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let request_credential = gunbc.dispatch_selection.ClaudeStateRootRef {
    root: "/managed/claude-enrollment" as std.types.FilePath,
  }
  let request_model = "claude-managed-model" as std.types.NonEmptyStr
  let claude_provider = extdeps.llm.cli_lifecycle.ProviderInstance {
    kind: ClaudeCliProvider,
    host: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved { reason: "fixture claude inventory row" as std.types.NonEmptyStr },
    executable: "claude" as std.types.NonEmptyStr,
    observed_version: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    state_directory: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    credential_storage_method: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
    service_identity: extdeps.llm.cli_lifecycle.ProviderInstanceFieldUnobserved {
      reason: "fixture claude inventory row" as std.types.NonEmptyStr,
    },
  }
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_then_claude(
      instance: instance,
      codex_standing: provider_standing_inventory_unobserved(),
      claude_standing: provider_standing_from_fixture_bundle(
        provider: claude_provider,
        bundle: fixture_standing_bundle_authenticated_available(),
      ),
    ),
    request: gunbc.dispatch_selection.SelectClaude {
      profile: ProfileAutomatic,
      credential: request_credential,
      model: request_model,
      effort: ReasoningHigh,
      workflow_mode: dispatch_claude_default_workflow_mode,
    },
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      match receipt.resolved_selection {
        ResolvedClaude { selection: s, instance: _ } =>
          s.credential == request_credential
            && s.model == request_model
            && s.effort == ReasoningMedium
        _ => false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn dispatch_selection_keystone_holds() -> Bool {
  witness_automatic_codex_preserves_medium_effort()
    && witness_intricacy_does_not_change_automatic_effort()
    && witness_deep_profile_refuses_without_realization()
    && witness_production_codex_selection_refuses_unobserved_fingerprint()
    && witness_srv1_inventory_includes_codex()
    && witness_srv1_inventory_includes_claude()
    && witness_production_inventory_excludes_claude()
    && witness_srv2_inventory_includes_cursor()
    && witness_srv2_cursor_selection_resolves()
    && witness_srv1_claude_selection_resolves_with_fixture_standing()
    && witness_select_claude_automatic_honors_request_credential_and_model()
    && witness_receipt_records_requested_and_resolved()
    && witness_carrier_notes_record_directive_addendum()
    && witness_wrong_selection_shape_refuses()
    && witness_probe_bridge_ineligible_standing_refuses_selection()
    && witness_claude_request_refuses_on_codex_only_inventory()
    && witness_exact_override_requires_explicit_provider_arm()
    && witness_automatic_multibucket_native_exhaustion_refuses_join_undetermined()
    && witness_explicit_override_bengalfox_admitted_from_same_inventory()
}
