module test.claim.scm_authoring_witness

import std.types { Bool, String, List }
import v2.std.node { Node, Symbol, TypeNode, ComputationNode, Atom, node_synthetic }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.proposal {
  Requirement,
  RequireBinding,
  RequireBindingAbsent,
  Proposal,
  requirement_role,
}
import gunbc.scm.authoring {
  author_requirement,
  proposal_states_role,
  empty_proposal,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// NAMES ARE QUALIFIED BECAUSE A TOP-LEVEL DEFINITION IS CORPUS-WIDE, the same reason
// scm_role_requirement_integration_witness_test qualifies its helpers: the resolver admits duplicate top-level definitions
// and silently selects one (#8707), so `role_a` or `node_named` here would not be a local
// convenience -- it would make the binding for that name arbitrary across every module sharing the
// scope. This file's subject is precisely a layer whose other witness file already collided once.
fn authoring_witness_role_a() -> Symbol { ^a }
fn authoring_witness_role_b() -> Symbol { ^b }

// Built exactly as gunbc.scm.role_requirement_integration's own witnesses build theirs
// (scm_role_requirement_integration_witness_test `atom_node`), so the two test corpora cannot disagree about what a distinguishable node is.
fn authoring_witness_atom(name: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: name } }, children: [])
}

fn authoring_witness_role_names(proposal: Proposal) -> List<String> {
  map(proposal.requirements, r => requirement_role(r: r) as String)
}

fn authoring_witness_value_name(r: Requirement) -> String {
  match r {
    RequireBinding { role: _, value: v } =>
      match v.kind {
        TypeNode { connective: Atom { identity: n } } => n as String
        TypeNode { connective: _ } => "not-an-atom"
        ComputationNode { behavior: _ } => "not-a-type-node"
      }
    RequireBindingAbsent { role: _ } => "absent"
  }
}

fn authoring_witness_value_for_role(proposal: Proposal, role: Symbol) -> String {
  fold(proposal.requirements, init: "none", f: fn(found, r) {
    if found == "none" {
      if (requirement_role(r: r) as String) == (role as String) { authoring_witness_value_name(r: r) } else { found }
    } else { found }
  })
}

test fn authoring_one_requirement_states_its_role() -> Bool {
  let p = author_requirement(
    proposal: empty_proposal(),
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v1) },
  )
  proposal_states_role(proposal: p, role: authoring_witness_role_a())
    && !proposal_states_role(proposal: p, role: authoring_witness_role_b())
    && count(p.requirements) == 1
}

// THE DERIVED RULE, ASSERTED. Re-authoring a role REPLACES rather than accumulating, and this is the
// claim the module's annotation argues for from merge.dag's own reasoning: merge refuses to pick
// between two AUTHORS because "last" there is a fold artifact, while here "last" is one author's own
// sequence of intent. If this accumulated instead, the ordinary loop -- edit, add, notice a mistake,
// edit, add -- would leave two requirements for one role and hand merge a self-contest that it would
// correctly refuse, making a staged mistake uncorrectable except by discarding the proposal.
test fn re_authoring_a_role_replaces_rather_than_accumulating() -> Bool {
  let p1 = author_requirement(
    proposal: empty_proposal(),
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v1) },
  )
  let p2 = author_requirement(
    proposal: p1,
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v2) },
  )
  count(p2.requirements) == 1 && authoring_witness_value_for_role(proposal: p2, role: authoring_witness_role_a()) == "v2"
}

// THE DISCRIMINATOR FOR THE ABOVE, and without it "replaces" is satisfied by a function that simply
// throws the proposal away. An unrelated role must SURVIVE the revision untouched.
test fn re_authoring_a_role_leaves_other_roles_untouched() -> Bool {
  let p1 = author_requirement(
    proposal: empty_proposal(),
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v1) },
  )
  let p2 = author_requirement(
    proposal: p1,
    requirement: RequireBinding { role: authoring_witness_role_b(), value: authoring_witness_atom(name: ^other) },
  )
  let p3 = author_requirement(
    proposal: p2,
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v2) },
  )
  count(p3.requirements) == 2
    && authoring_witness_value_for_role(proposal: p3, role: authoring_witness_role_a()) == "v2"
    && authoring_witness_value_for_role(proposal: p3, role: authoring_witness_role_b()) == "other"
}

// DELETE IS A STATED REQUIREMENT AND IT SUPERSEDES A PRESENT BINDING ON THE SAME ROLE. This is the
// half merge.dag's own reasoning makes load-bearing: silence means PRESERVE, so an author who adds a
// module and then removes it must end with a STATED ABSENCE, not with an empty proposal. An empty
// proposal would be read downstream as "leave the target alone" -- the exact inversion of the
// request, and the reason delete-by-omission is not modelled anywhere in this layer.
test fn authoring_an_absence_supersedes_a_present_binding_for_that_role() -> Bool {
  let p1 = author_requirement(
    proposal: empty_proposal(),
    requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v1) },
  )
  let p2 = author_requirement(
    proposal: p1,
    requirement: RequireBindingAbsent { role: authoring_witness_role_a() },
  )
  count(p2.requirements) == 1
    && authoring_witness_value_for_role(proposal: p2, role: authoring_witness_role_a()) == "absent"
    && proposal_states_role(proposal: p2, role: authoring_witness_role_a())
}

test fn authoring_order_of_distinct_roles_is_preserved() -> Bool {
  let p = author_requirement(
    proposal: author_requirement(
      proposal: empty_proposal(),
      requirement: RequireBinding { role: authoring_witness_role_a(), value: authoring_witness_atom(name: ^v1) },
    ),
    requirement: RequireBinding { role: authoring_witness_role_b(), value: authoring_witness_atom(name: ^v2) },
  )
  authoring_witness_role_names(proposal: p) == ["a", "b"]
}
