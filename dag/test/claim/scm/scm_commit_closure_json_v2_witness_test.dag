// ------------------------------------------------------------------------------------------------
// Fixtures. Every name here is prefixed so it cannot collide corpus-wide: a top-level definition is
// corpus-scoped and the resolver ADMITS duplicates while silently selecting one, so a generic
// helper name is a live correctness hazard rather than a style question (#8719).
// ------------------------------------------------------------------------------------------------

// THE RAW ENCODER NOW TAKES A SEALED CARRIER, so a fixture cannot hand it a store and a root. That is
// the point of the seal: `.dag` has no module privacy, and a judgment written only at the intended
// entry points left this importable and the wrong-kind state representable through it. Every fixture
// below therefore states the kind judgment out loud. The refusing arm is unreachable for these
// fixtures -- none of them puts a file under a node's locator -- and it answers an empty document
// rather than a plausible one, so a fixture that ever did reach it fails its own assertion.
fn scm_image_encode_or_empty(store: ObjectStore, root: SemanticNodeTarget) -> JsonValue {
  match admit_well_kinded_closure(closure: CommitClosure { store: store, root: root }) {
    NotWellKinded { source_occupied: _, manifest_occupied: _ } => json_object(members: [])
    WellKinded { admitted: image, unresolved: _ } => encode_closure_document(image: image)
  }
}

fn closure_doc_atom(identity: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: identity } }, children: [])
}

fn closure_doc_named(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn closure_doc_program() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      closure_doc_named(name: ^alpha, target: closure_doc_atom(identity: ^A)),
      closure_doc_named(name: ^beta, target: closure_doc_atom(identity: ^B)),
    ],
  )
}

// A DIFFERENT program, used only to prove the comparison below can answer no.
fn scm_image_other_program() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [closure_doc_named(name: ^alpha, target: closure_doc_atom(identity: ^A))],
  )
}

// One atom referenced by TWO parents. Sharing is the property positions exist to preserve, so the
// fixture that proves it must actually share.
fn scm_image_shared_program() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      closure_doc_named(name: ^left, target: closure_doc_atom(identity: ^S)),
      closure_doc_named(name: ^right, target: closure_doc_atom(identity: ^S)),
    ],
  )
}

type ScmImagePut {
  store: ObjectStore
  identity: SemanticNodeTarget
}

fn scm_image_put(store: ObjectStore, n: Node) -> ScmImagePut {
  match store_node(store: store, n: n) {
    Stored { store: s, node: node } => ScmImagePut { store: s, identity: node_target_of(reference: node) }
    LocatorCollision { identity: i, existing: _, incoming: _ } =>
      ScmImagePut { store: store, identity: SemanticNodeTarget { locator: i } }
  }
}

fn scm_image_encoded(n: Node) -> JsonValue {
  let put = scm_image_put(store: empty_store(), n: n)
  scm_image_encode_or_empty(store: put.store, root: put.identity)
}

// The reconstructed program compared on CONTENT IDENTITY, not on occurrence provenance. checkout
// rebuilds with OccurrenceSynthetic throughout, and the store deliberately does not preserve
// occurrence identity, so asserting on it would assert the one property the model says must not
// matter. The expectation is canonicalized for the same reason store_node canonicalizes: named-edge
// order is not a fact this store preserves.
fn scm_image_loads_as(loaded: ClosureDocLoadOutcome, expected: Node) -> Bool {
  match loaded {
    ClosureDocRefused { cause: _ } => false
    ClosureDocLoaded { store: store, root: root } =>
      match checkout(store: store, commit: commit_of_root(root: root)) {
        CheckoutRefused { cause: _ } => false
        CheckedOut { program: program } =>
          (content_hash(n: program).digest as String)
            == (content_hash(n: canonicalize_node_for_content_hash(n: expected)).digest as String)
      }
  }
}

// REFUSAL-ONLY ASSERTIONS ARE WHY THE MISATTRIBUTION SURVIVED. Every claim in this file said only
// "the document was refused", and a decoder that reports the wrong owner refuses exactly as loudly as
// one that reports the right owner -- so the whole file stayed green while a closure root that named
// no object was reported as an EDGE target unresolved: an edge that does not exist, inside an object
// nobody named. This reader is what lets a claim name the cause, and the three claims below are the
// ones that go red if the owners are ever merged again.
fn scm_image_cause_tag(loaded: ClosureDocLoadOutcome) -> String {
  match loaded {
    ClosureDocLoaded { store: _, root: _ } => "loaded"
    ClosureDocRefused { cause: c } =>
      match c {
        ClosureDocMemberReadRefused { cause: _ } => "member_read"
        ClosureDocFormatUnrecognized { found: _ } => "format"
        ClosureDocRootPositionUnresolved { reference: _ } => "root_position"
        ClosureDocNodeTableRefused { cause: t } =>
          match t {
            NodeTableEdgeTargetUnresolved { reference: _ } => "edge_target"
            NodeTableObjectCollision { identity: _ } => "collision"
            NodeTableEntryRefused { cause: e } =>
              match e {
                NodeEntryUnknownKindTag { found: _ } => "kind"
                NodeEntryUnknownConnectiveTag { found: _ } => "connective"
                NodeEntryUnknownBehaviorTag { found: _ } => "behavior"
                NodeEntryUnknownLabelTag { found: _ } => "label"
                NodeEntryTargetReferenceRefused { cause: _ } => "table_target_reference"
                NodeEntryMemberReadRefused { cause: _ } => "table_member_read"
                NodeEntryUnexpectedMember { context: _, key: _ } => "table_unexpected_member"
              }
          }
        ClosureDocUnexpectedMember { key: _ } => "unexpected_member"
        ClosureDocTargetReferenceRefused { cause: _ } => "target_reference"
      }
  }
}

fn scm_image_refused(loaded: ClosureDocLoadOutcome) -> Bool {
  match loaded {
    ClosureDocRefused { cause: _ } => true
    ClosureDocLoaded { store: _, root: _ } => false
  }
}

// ------------------------------------------------------------------------------------------------
// The round trip.
// ------------------------------------------------------------------------------------------------

test fn scm_image_round_trips_to_the_same_program() -> Bool {
  scm_image_loads_as(
    loaded: decode_closure_document(v: scm_image_encoded(n: closure_doc_program())),
    expected: closure_doc_program(),
  )
}

// CONTROL for the claim above. Without this, a comparison that always answered true would pass.
test fn scm_image_round_trip_comparison_can_say_no() -> Bool {
  !scm_image_loads_as(
    loaded: decode_closure_document(v: scm_image_encoded(n: closure_doc_program())),
    expected: scm_image_other_program(),
  )
}

// THE TEXT IS THE POINT. Comparing JsonValue to JsonValue would never exercise serialize_json or
// parse_json, so the durable artifact -- the bytes that actually reach a file -- would be untested.
test fn scm_image_survives_serialization_to_text_and_back() -> Bool {
  let text = serialize_json(v: scm_image_encoded(n: closure_doc_program()))
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap: _ } => false
    JsonDocumentParsed { value: reparsed } =>
      scm_image_loads_as(loaded: decode_closure_document(v: reparsed), expected: closure_doc_program())
  }
}

// SHARING IS MEASURED ON THE ENCODED FORM, AND THE FIRST VERSION OF THIS CLAIM WAS NOT.
//
// It asserted that the DECODED store held two objects. That observation is structurally incapable of
// failing: decode routes every object through insert_from_structure, and insert_derived answers the
// idempotent arm for a record it already holds, so an encoder that inlined the shared atom once per
// parent would still decode to exactly two objects. The claim would have been green whether or not
// sharing survived -- measuring the deduplicator rather than the encoding.
//
// Counting entries in the emitted `objects` array is the measurement that can go red: an expanding
// encoder writes three, a sharing one writes two.
fn scm_image_objects_member_count(acc: Int, m: JsonKeyValue) -> Int {
  if m.key == "objects" {
    match m.value {
      JsonArray { elements: es } => count(es)
      _ => acc
    }
  } else {
    acc
  }
}

fn scm_image_count_objects_member(members: List<JsonKeyValue>) -> Int {
  fold(members, init: 0, f: fn(acc, m) { scm_image_objects_member_count(acc: acc, m: m) })
}

fn scm_image_encoded_object_count(v: JsonValue) -> Int {
  scm_image_count_objects_member(members: scm_image_members(v: v))
}

test fn scm_image_preserves_sharing_rather_than_expanding_it() -> Bool {
  scm_image_encoded_object_count(v: scm_image_encoded(n: scm_image_shared_program())) == 2
}

// CONTROL for the claim above: the counter must be able to report something other than 2, or the
// assertion above is satisfied by a function that always answers 2. The two-atom program has three
// distinct objects -- two unequal atoms and the root -- so this pins the counter to the encoding.
test fn scm_image_the_object_counter_distinguishes_a_larger_program() -> Bool {
  scm_image_encoded_object_count(v: scm_image_encoded(n: closure_doc_program())) == 3
}

// ------------------------------------------------------------------------------------------------
// The refusals. Each mutates ONE thing about an otherwise-valid image.
// ------------------------------------------------------------------------------------------------

fn scm_image_members(v: JsonValue) -> List<JsonKeyValue> {
  match v {
    JsonObject { members: ms } => ms
    _ => []
  }
}

// FIELD ACCESS MOVED OUT OF THE LAMBDA, and the shape is load-bearing rather than indirection.
// `filter(members, m => m.key != key)` refused here with `no field 'key' on type 'T'` -- the lambda
// parameter stayed generic. Routing `m` through a typed parameter instead mirrors a spelling that
// resolves elsewhere in the corpus (extdeps.github.effect `filter(paths, p => ...(path: p))`).
//
// THE MECHANISM IS NOT ESTABLISHED, and saying so is the point: extdeps.languages.json.parse
// `json_object_members_named` uses the refused spelling over this VERY type and resolves, so neither
// "field access cannot drive inference" nor "imported element types fail" survives contact with the
// corpus. What is recorded here is the observation and the working alternative, not a rule -- a
// confident mechanism written from one failure would be a fabricated explanation sitting in the
// tree, and the next reader would plan against it.
fn scm_image_key_differs(m: JsonKeyValue, key: String) -> Bool {
  m.key != key
}

fn scm_image_drop_key(members: List<JsonKeyValue>, key: String) -> List<JsonKeyValue> {
  filter(members, m => scm_image_key_differs(m: m, key: key))
}

fn scm_image_without(v: JsonValue, key: String) -> JsonValue {
  json_object(members: scm_image_drop_key(members: scm_image_members(v: v), key: key))
}

fn scm_image_with(v: JsonValue, key: String, value: JsonValue) -> JsonValue {
  json_object(
    members: concat(
      scm_image_drop_key(members: scm_image_members(v: v), key: key),
      [json_kv(key: key, value: value)]
    )
  )
}

test fn scm_image_an_unrecognized_format_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: scm_image_with(
        v: scm_image_encoded(n: closure_doc_program()),
        key: "format",
        value: json_string(s: "gunbc-scm-commit-closure-v99"),
      )
    )
  )
}

// THE PREDECESSOR'S OWN TAG, FROZEN, AND REFUSED AS A PROTOCOL GAP RATHER THAN AS DAMAGE.
//
// The re-review asked for independent old-writer evidence: bytes not produced by the current
// encoder. Versioning changed what that evidence has to show. Before the bump, the question was
// whether a predecessor document still decoded; now the v2 tag is a version this build does not
// implement, so the required behaviour is a REFUSAL -- and specifically the unsupported-protocol
// one, never malformed, because those have opposite remedies and only malformed permits
// supersession (gunbc.scm.supersession standing_permission_refusal). A reader that filed a
// predecessor document as damaged could discard a generation it simply cannot read.
//
// The document below is authored as a literal rather than derived from the current encoder, which
// is the whole point: it is what the predecessor emitted -- a node-only object table under the v2
// tag -- and nothing in this file can quietly re-derive it.
data scm_image_legacy_v2_tag: String = "gunbc-scm-commit-closure-v2"

fn scm_image_legacy_v2_document() -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: scm_image_legacy_v2_tag)),
      json_kv(key: "objects", value: json_array(elements: [scm_image_empty_node_entry()])),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])
      ),
    ]
  )
}

test fn scm_image_a_frozen_predecessor_document_refuses_as_its_format() -> Bool {
  scm_image_cause_tag(loaded: decode_closure_document(v: scm_image_legacy_v2_document())) == "format"
}

// AND THE STANDING IS THE PROTOCOL ONE. The claim above pins the cause; this pins what a consumer
// deciding whether to overwrite is told, which is the half that actually carries the consequence.
test fn scm_image_a_frozen_predecessor_document_is_a_protocol_gap_not_damage() -> Bool {
  match decode_closure_document(v: scm_image_legacy_v2_document()) {
    ClosureDocLoaded { store: _, root: _ } => false
    ClosureDocRefused { cause: c } =>
      match closure_document_load_standing(cause: c) {
        LoadUnsupportedProtocol => true
        LoadComplete => false
        LoadPartial => false
        LoadDocumentMalformed => false
        LoadIdentityCollision => false
        LoadRequirementAtWrongKind => false
      }
  }
}

// CONTROL, one fact apart: the identical document under THIS build's tag loads. Without it, a
// decoder that refused every hand-authored document would satisfy both claims above.
test fn scm_image_the_same_document_under_the_current_tag_loads() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: json_object(
        members: [
          json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
          json_kv(key: "objects", value: json_array(elements: [scm_image_empty_node_entry()])),
          json_kv(
            key: "root",
            value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])
          ),
        ]
      )
    )
  ) == "loaded"
}

test fn scm_image_a_missing_format_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(v: scm_image_without(v: scm_image_encoded(n: closure_doc_program()), key: "format"))
  )
}

test fn scm_image_a_missing_objects_member_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(v: scm_image_without(v: scm_image_encoded(n: closure_doc_program()), key: "objects"))
  )
}

// A DUPLICATED key is its own refusal and not a last-wins read. This is the arm a naive decoder
// silently accepts while the file carries two different answers.
test fn scm_image_a_duplicated_root_member_refuses() -> Bool {
  let encoded = scm_image_encoded(n: closure_doc_program())
  scm_image_refused(
    loaded: decode_closure_document(
      v: json_object(
        members: concat(scm_image_members(v: encoded), [json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))]))])
      )
    )
  )
}

// THE ROOT CLAIM HAD TO BE REPAIRED BEFORE IT COULD DISCRIMINATE, and the repair is the reason it is
// worth anything. It previously supplied a BARE STRING root, which is refused as a wrong-shape member
// read before root resolution is ever reached -- so a claim named for "a root naming no object" was
// green without executing the operation it names, and would have stayed green under any routing of
// unresolved positions whatsoever. The object shape is what reaches the resolver.
test fn scm_image_a_root_naming_no_object_refuses_as_the_roots_own_cause() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: scm_image_with(
        v: scm_image_encoded(n: closure_doc_program()),
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "9999"))]),
      )
    )
  ) == "root_position"
}

// THE BARE-STRING ROOT KEPT AS ITS OWN CLAIM, because the repair above would otherwise DELETE a real
// distinction: a root that is not an object at all is a member-read defect, not an unresolved
// position, and the two must not collapse into one another.
test fn scm_image_a_bare_string_root_is_a_member_read_refusal() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: scm_image_with(
        v: scm_image_encoded(n: closure_doc_program()),
        key: "root",
        value: json_string(s: "9999"),
      )
    )
  ) == "member_read"
}

// An edge naming a position that has not been decoded yet. Only earlier positions are in scope, so
// this is the arm that makes back-references safe rather than merely conventional.
test fn scm_image_an_edge_naming_a_later_position_refuses_as_the_edges_own_cause() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: json_object(
        members: [
          json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
          json_kv(
            key: "objects",
            value: json_array(
              elements: [
                json_object(
                  members: [
                    json_kv(
                      key: "kind",
                      value: json_object(
                        members: [
                          json_kv(key: "kind", value: json_string(s: "type")),
                          json_kv(key: "connective", value: json_string(s: "conj")),
                        ]
                      )
                    ),
                    json_kv(
                      key: "children",
                      value: json_array(
                        elements: [
                          json_object(
                            members: [
                              json_kv(key: "label", value: json_string(s: "named")),
                              json_kv(key: "name", value: json_string(s: "alpha")),
                              json_kv(key: "target", value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])),
                            ]
                          )
                        ]
                      )
                    ),
                  ]
                )
              ]
            )
          ),
          json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])),
        ]
      )
    )
  ) == "edge_target"
}

test fn scm_image_an_unknown_connective_tag_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: json_object(
        members: [
          json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
          json_kv(
            key: "objects",
            value: json_array(
              elements: [
                json_object(
                  members: [
                    json_kv(
                      key: "kind",
                      value: json_object(
                        members: [
                          json_kv(key: "kind", value: json_string(s: "type")),
                          json_kv(key: "connective", value: json_string(s: "not-a-connective")),
                        ]
                      )
                    ),
                    json_kv(key: "children", value: json_array(elements: [])),
                  ]
                )
              ]
            )
          ),
          json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])),
        ]
      )
    )
  )
}

// CONTROL for every refusal above: the SAME hand-authored image shape, with nothing wrong with it,
// must LOAD. Without this, a decoder that refused every hand-built object would pass the two
// hand-authored refusal claims for the wrong reason -- they would be measuring "hand-authored"
// rather than "malformed".
test fn scm_image_the_hand_authored_shape_itself_loads() -> Bool {
  scm_image_loads_as(
    loaded: decode_closure_document(
      v: json_object(
        members: [
          json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
          json_kv(
            key: "objects",
            value: json_array(
              elements: [
                json_object(
                  members: [
                    json_kv(
                      key: "kind",
                      value: json_object(
                        members: [
                          json_kv(key: "kind", value: json_string(s: "type")),
                          json_kv(key: "connective", value: json_string(s: "atom")),
                          json_kv(key: "identity", value: json_string(s: "A")),
                        ]
                      )
                    ),
                    json_kv(key: "children", value: json_array(elements: [])),
                  ]
                )
              ]
            )
          ),
          json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])),
        ]
      )
    ),
    expected: closure_doc_atom(identity: ^A),
  )
}


// ------------------------------------------------------------------------------------------------
// THE CHECKED ENCODER. encode_closure_document cannot refuse -- it returns a JsonValue -- so an incomplete
// closure encodes to a document carrying the empty reference, which decode rejects. That is correct
// and it is too late for any writer: the adjudication has to happen BEFORE bytes exist, or a
// successful write reports success over content that will never load.
//
// copy_object copies ONE record without its children, so it is the sanctioned way to build the
// incomplete closure these claims need -- no hand-authored broken store, no representation reach.
// ------------------------------------------------------------------------------------------------

fn scm_image_encode_refused(outcome: ClosureDocEncodeOutcome) -> Bool {
  match outcome {
    ClosureDocEncodeRefused { cause: _ } => true
    ClosureDocEncoded { value: _ } => false
  }
}

fn scm_image_orphan_parent_store() -> ScmImagePut {
  let full = scm_image_put(store: empty_store(), n: closure_doc_program())
  match copy_object(
    from: full.store,
    to: empty_store(),
    identity: node_target_locator(target: full.identity),
  ) {
    Copied { store: s, reference: _ } => ScmImagePut { store: s, identity: full.identity }
    CopySourceAbsent { identity: _ } => ScmImagePut { store: empty_store(), identity: full.identity }
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } =>
      ScmImagePut { store: empty_store(), identity: full.identity }
  }
}

test fn scm_image_a_root_absent_from_the_store_refuses_to_encode() -> Bool {
  let full = scm_image_put(store: empty_store(), n: closure_doc_program())
  scm_image_encode_refused(
    outcome: encode_complete_closure_document(closure: CommitClosure { store: empty_store(), root: full.identity })
  )
}

test fn scm_image_a_root_whose_child_is_absent_refuses_to_encode() -> Bool {
  let orphan = scm_image_orphan_parent_store()
  scm_image_encode_refused(
    outcome: encode_complete_closure_document(closure: CommitClosure { store: orphan.store, root: orphan.identity })
  )
}

// THE POSITIVE CONTROL. Without it the two refusals above are satisfied by an encoder that refuses
// everything, and DESIGN section 4b requires the accepted arm alongside the discriminating red.
test fn scm_image_a_complete_closure_encodes() -> Bool {
  let full = scm_image_put(store: empty_store(), n: closure_doc_program())
  match encode_complete_closure_document(closure: CommitClosure { store: full.store, root: full.identity }) {
    ClosureDocEncoded { value: v } =>
      serialize_json(v: v)
        == serialize_json(v: scm_image_encode_or_empty(store: full.store, root: full.identity))
    ClosureDocEncodeRefused { cause: _ } => false
  }
}


// ------------------------------------------------------------------------------------------------
// THE NODE IDENTITY PROTOCOL, ACROSS A PERMUTED WIRE ORDER.
//
// A decoded image supplies child order from a document nobody in this process authored, and
// insert_from_structure hands that order to content_hash_of_children. Until content_hash_of_children
// canonicalized its own input, a hand-edited image listing `beta` before `alpha` minted an ObjectId
// under the fold of `beta, alpha`, while the SAME reconstructed node's ordinary content_hash folds
// `alpha, beta` -- so find_object(H1) could answer a node whose content_hash is H2, which is not a
// stale document or a lossy round trip but a break in the meaning of ObjectId = v2.std.node.Hash.
//
// The pair below is what makes the repair falsifiable, and it has to be a PAIR: canonicalizing
// everything would satisfy the named claim while silently destroying positional structure, where
// order IS the meaning. Revert the canonicalization in content_hash_of_children and the named claim
// goes red; canonicalize positional children too and the positional claim goes red.
// ------------------------------------------------------------------------------------------------

fn scm_image_identity_of(outcome: StoreOutcome, fallback: ObjectId) -> ObjectId {
  match outcome {
    Stored { store: _, node: n } => n.locator
    LocatorCollision { identity: _, existing: _, incoming: _ } => fallback
  }
}

type ScmImageTwoAtoms { store: ObjectStore, first: ObjectId, second: ObjectId }

fn scm_image_two_atoms() -> ScmImageTwoAtoms {
  let a = scm_image_put(store: empty_store(), n: closure_doc_atom(identity: ^A))
  let b = scm_image_put(store: a.store, n: closure_doc_atom(identity: ^B))
  ScmImageTwoAtoms {
    store: b.store,
    first: node_target_locator(target: a.identity),
    second: node_target_locator(target: b.identity),
  }
}

fn scm_image_insert_children(kind: NodeKind, children: List<StoredEdge>, fallback: ObjectId) -> ObjectId {
  scm_image_identity_of(
    outcome: insert_from_structure(store: scm_image_two_atoms().store, kind: kind, children: children),
    fallback: fallback
  )
}

// THE FIXTURE'S EDGES ARE UNRESOLVED TARGETS, and that is what a fixture holding only a locator can
// honestly say. It never resolved these addresses against a store, so it has no node reference to
// carry; the assembly rule under test consumes the locator either way, so the claim is unchanged
// while the fixture stops asserting a kind it did not establish.
fn scm_image_named_stored(name: Symbol, target: ObjectId) -> StoredEdge {
  StoredEdge { label: Named { name: name }, target: SemanticNodeTarget { locator: target } }
}

fn scm_image_positional_stored(target: ObjectId) -> StoredEdge {
  StoredEdge { label: Positional, target: SemanticNodeTarget { locator: target } }
}

// NAMED children permuted: the SAME identity, and it is the identity the ordinary content_hash of
// the assembled node derives -- asserting the two inserts merely agree with EACH OTHER would be
// satisfied by any consistent wrong rule, including one that hashes wire order on both sides.
test fn scm_image_permuted_named_children_reconstruct_the_canonical_identity() -> Bool {
  let atoms = scm_image_two_atoms()
  let canonical = content_hash(n: closure_doc_program())
  let forward = scm_image_insert_children(
    kind: TypeNode { connective: Conj },
    children: [
      scm_image_named_stored(name: ^alpha, target: atoms.first),
      scm_image_named_stored(name: ^beta, target: atoms.second),
    ],
    fallback: atoms.first
  )
  let swapped = scm_image_insert_children(
    kind: TypeNode { connective: Conj },
    children: [
      scm_image_named_stored(name: ^beta, target: atoms.second),
      scm_image_named_stored(name: ^alpha, target: atoms.first),
    ],
    fallback: atoms.second
  )
  object_id_eq(left: forward, right: swapped) && object_id_eq(left: forward, right: canonical)
}

// POSITIONAL children permuted: a DIFFERENT identity. Under a positional discipline the order is the
// content, so a canonicalizer that sorted here would fuse `f(x, y)` with `f(y, x)`.
test fn scm_image_permuted_positional_children_are_a_different_identity() -> Bool {
  let atoms = scm_image_two_atoms()
  let forward = scm_image_insert_children(
    kind: TypeNode { connective: Cardinality },
    children: [
      scm_image_positional_stored(target: atoms.first),
      scm_image_positional_stored(target: atoms.second),
    ],
    fallback: atoms.first
  )
  let swapped = scm_image_insert_children(
    kind: TypeNode { connective: Cardinality },
    children: [
      scm_image_positional_stored(target: atoms.second),
      scm_image_positional_stored(target: atoms.first),
    ],
    fallback: atoms.second
  )
  object_id_eq(left: forward, right: swapped) == false
}


// ------------------------------------------------------------------------------------------------
// THE CLOSED MEMBER SET. A matched format tag means "I understand this exact schema", not "I
// understand some subset of whatever this writer may have meant". A silently ignored member is a
// fact the writer stated, the reader discarded, and the next re-encode deleted -- with every
// operation reporting success. The controls matter as much as the refusals: member ORDER is still
// irrelevant, and the members each variant legitimately carries must still load.
// ------------------------------------------------------------------------------------------------

fn scm_image_kind_object(members: List<JsonKeyValue>) -> JsonKeyValue {
  json_kv(key: "kind", value: json_object(members: members))
}

fn scm_image_atom_kind_members() -> List<JsonKeyValue> {
  [
    json_kv(key: "kind", value: json_string(s: "type")),
    json_kv(key: "connective", value: json_string(s: "atom")),
    json_kv(key: "identity", value: json_string(s: "A")),
  ]
}

fn scm_image_one_object_image(object_members: List<JsonKeyValue>, extra: List<JsonKeyValue>) -> JsonValue {
  json_object(
    members: concat(
      [
        json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
        json_kv(key: "objects", value: json_array(elements: [json_object(members: object_members)])),
        json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])),
      ],
      extra
    )
  )
}

fn scm_image_atom_object_members(kind_members: List<JsonKeyValue>, extra: List<JsonKeyValue>) -> List<JsonKeyValue> {
  concat(
    [
      scm_image_kind_object(members: kind_members),
      json_kv(key: "children", value: json_array(elements: [])),
    ],
    extra
  )
}

test fn scm_image_an_unknown_envelope_member_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: scm_image_one_object_image(
        object_members: scm_image_atom_object_members(kind_members: scm_image_atom_kind_members(), extra: []),
        extra: [json_kv(key: "future_field", value: json_string(s: "x"))]
      )
    )
  )
}

test fn scm_image_an_unknown_object_record_member_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: scm_image_one_object_image(
        object_members: scm_image_atom_object_members(
          kind_members: scm_image_atom_kind_members(),
          extra: [json_kv(key: "identity", value: json_string(s: "0"))]
        ),
        extra: []
      )
    )
  )
}

// `identity` is REQUIRED on an atom and forbidden on every other connective, so this is the claim
// that the member set is closed PER VARIANT rather than closed over the union of every variant's
// members -- a union-shaped check would accept this document.
test fn scm_image_identity_on_a_non_atom_kind_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: scm_image_one_object_image(
        object_members: scm_image_atom_object_members(
          kind_members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "conj")),
            json_kv(key: "identity", value: json_string(s: "A")),
          ],
          extra: []
        ),
        extra: []
      )
    )
  )
}

test fn scm_image_behavior_on_a_type_kind_refuses() -> Bool {
  scm_image_refused(
    loaded: decode_closure_document(
      v: scm_image_one_object_image(
        object_members: scm_image_atom_object_members(
          kind_members: concat(
            scm_image_atom_kind_members(),
            [json_kv(key: "behavior", value: json_string(s: "value"))]
          ),
          extra: []
        ),
        extra: []
      )
    )
  )
}

// THE ORDER CONTROL. Closed member population is not positional parsing: the same members in a
// different order must still load. Without this, a check that accidentally depended on member order
// would satisfy every refusal claim above.
test fn scm_image_the_same_members_in_a_different_order_still_load() -> Bool {
  scm_image_loads_as(
    loaded: decode_closure_document(
      v: json_object(
        members: [
          json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])),
          json_kv(
            key: "objects",
            value: json_array(
              elements: [
                json_object(
                  members: [
                    json_kv(key: "children", value: json_array(elements: [])),
                    scm_image_kind_object(
                      members: [
                        json_kv(key: "identity", value: json_string(s: "A")),
                        json_kv(key: "connective", value: json_string(s: "atom")),
                        json_kv(key: "kind", value: json_string(s: "type")),
                      ]
                    ),
                  ]
                )
              ]
            )
          ),
          json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
        ]
      )
    ),
    expected: closure_doc_atom(identity: ^A),
  )
}

// THE POSITIVE CONTROL FOR THE ATOM VARIANT: `identity` is not merely tolerated on an atom, it is
// required, so the refusals above cannot be satisfied by a rule that rejects `identity` everywhere.
test fn scm_image_an_atom_carrying_its_identity_still_loads() -> Bool {
  scm_image_loads_as(
    loaded: decode_closure_document(
      v: scm_image_one_object_image(
        object_members: scm_image_atom_object_members(kind_members: scm_image_atom_kind_members(), extra: []),
        extra: []
      )
    ),
    expected: closure_doc_atom(identity: ^A),
  )
}






// ------------------------------------------------------------------------------------------------
// A DOCUMENT CAN POINT A PROGRAM'S EDGE AT A FILE, AND THAT IS THE PRODUCTION PATH TO THE
// AUTHORED-SOURCE REFUSAL.
//
// gunbc#9891 added `ObjectIsAuthoredSource` to checkout, and the reachability argument for it was a
// CALL-GRAPH argument: checkout_object is called from production, and the decoder is a production
// producer of authored objects, therefore the arm is production-reachable. Side-chat review cautioned
// that the two halves might not meet -- authored objects decode, but a CHECKOUT might never be able
// to land on one, because every edge the ENCODER emits was derived from a node record. That caution
// is correct about the encoder and wrong about the decoder, and the difference is worth executing
// rather than reasoning about.
//
// The decoder resolves `{"target": {"at": "<n>"}}` through the position map, and the position map now
// holds authored entries alongside node entries. So a document may name an authored entry as a node's
// CHILD, which no encoder would ever emit and which is exactly the input this repository does not
// control. The claim below builds that document by hand and checks that checkout refuses with the
// authored-source cause rather than with MissingObject -- the two have opposite remedies, and the
// object in question is present.
fn scm_image_authored_entry() -> JsonValue {
  json_object(members: [json_kv(key: "source", value: json_string(s: "not a program\n"))])
}

fn scm_image_node_entry_targeting(position: String) -> JsonValue {
  json_object(
    members: [
      json_kv(
        key: "kind",
        value: json_object(
          members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "conj")),
          ]
        )
      ),
      json_kv(
        key: "children",
        value: json_array(
          elements: [
            json_object(
              members: [
                json_kv(key: "label", value: json_string(s: "positional")),
                json_kv(
                  key: "target",
                  value: json_object(members: [json_kv(key: "at", value: json_string(s: position))])
                ),
              ]
            )
          ]
        )
      ),
    ]
  )
}

// Position 0 is the file, position 1 is a node whose only child targets position 0, and the root is
// position 1. Children-before-parents is the order the decoder requires, so this document is
// well-formed by the format's own rules -- it is not a malformed image, it is a legitimate one that
// says something the model must refuse to reconstruct.
fn scm_image_program_over_a_file_document() -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(
        key: "objects",
        value: json_array(
          elements: [scm_image_authored_entry(), scm_image_node_entry_targeting(position: "0")]
        )
      ),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])
      ),
    ]
  )
}

fn scm_image_checkout_cause_tag(loaded: ClosureDocLoadOutcome) -> String {
  match loaded {
    ClosureDocRefused { cause: _ } => "document_refused"
    ClosureDocLoaded { store: store, root: root } =>
      match checkout(store: store, commit: commit_of_root(root: root)) {
        CheckedOut { program: _ } => "checked_out"
        CheckoutRefused { cause: c } =>
          match c {
            MissingObject { identity: _ } => "missing"
            ObjectIsAuthoredSource { identity: _ } => "authored_source"
            ObjectIsCorpusManifest { identity: _ } => "corpus_manifest"
          }
      }
  }
}

// CONTROL, and it is the one that makes the claim above about the FILE rather than about the
// document shape: the identical document with a node at position 0 instead of a file checks out.
// Without it, a decoder that refused this shape for any reason would satisfy the claim above.
fn scm_image_program_over_a_node_document() -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(
        key: "objects",
        value: json_array(
          elements: [
            json_object(
              members: [
                json_kv(
                  key: "kind",
                  value: json_object(
                    members: [
                      json_kv(key: "kind", value: json_string(s: "type")),
                      json_kv(key: "connective", value: json_string(s: "conj")),
                    ]
                  )
                ),
                json_kv(key: "children", value: json_array(elements: [])),
              ]
            ),
            scm_image_node_entry_targeting(position: "0"),
          ]
        )
      ),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])
      ),
    ]
  )
}

test fn scm_image_the_same_document_shape_checks_out_over_a_node() -> Bool {
  scm_image_checkout_cause_tag(
    loaded: decode_closure_document(v: scm_image_program_over_a_node_document())
  ) == "checked_out"
}

// ------------------------------------------------------------------------------------------------
// THE SOURCE CLASSIFIER'S OWNERS, EXECUTED.
//
// The classifier that decides node-entry vs authored-source-entry first reads `source`. Its initial
// cut treated every failed read as "no source member, try the node arm", so a null source, a
// DUPLICATED source, and a non-object entry were each reported as a missing `kind` or an unexpected
// member -- refusing, but attributing the fault to the wrong owner. These claims pin the owner, not
// merely the refusal, which is the distinction this file's cause-tag reader exists to make.
fn scm_image_document_with_object_entry(entry: JsonValue) -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(key: "objects", value: json_array(elements: [entry])),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "0"))])
      ),
    ]
  )
}

fn scm_image_entry_cause_tag(entry: JsonValue) -> String {
  scm_image_cause_tag(loaded: decode_closure_document(v: scm_image_document_with_object_entry(entry: entry)))
}

fn scm_image_empty_node_entry() -> JsonValue {
  json_object(
    members: [
      json_kv(
        key: "kind",
        value: json_object(
          members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "conj")),
          ]
        )
      ),
      json_kv(key: "children", value: json_array(elements: [])),
    ]
  )
}

// THE ROLE-REQUIREMENT INTEGRATION PATH OVER A DOCUMENT, AND WHERE ITS FILE ARM MOVED TO.
//
// This section once carried the `TargetChildIsAuthoredSource` claim, on the reasoning that only a
// DOCUMENT could put a file in a child edge. That reasoning was correct then and is obsolete now: a
// contained edge target is resolved before it is written, so this document no longer loads at all --
// `scm_image_a_child_edge_naming_a_file_refuses_at_decode` above is what the same input produces.
//
// The integration arm is still reachable, through the UNRESOLVED edge target, whose kind nothing has
// established until a consumer resolves it. That input is built without a document, from
// insert_from_structure over a store that holds the file, so its claim lives beside the integration
// in test.claim.scm_role_requirement_integration_witness -- where the input can be constructed, which is the same rule
// that put it here in the first place.
//
// What remains here is the ROLE PATH ITSELF: a document whose root has a named child integrates, which
// is the control the moved claim needs and the reason this reader stays.
fn scm_image_integration_refusal_tag(o: RoleRequirementIntegrationOutcome) -> String {
  match o {
    RoleRequirementsIntegrated { store: _, commit: _, roles: _ } => "integrated"
    RoleRequirementsContested { role: _, alternatives: _ } => "contested"
    RoleRequirementIntegrationRefused { cause: cause } =>
      match cause {
        TargetRootMissing { identity: _ } => "root_missing"
        TargetRootIsAuthoredSource { identity: _ } => "root_source"
        TargetRootIsCorpusManifest { identity: _ } => "root_manifest"
        TargetChildMissing { role: _, identity: _ } => "child_missing"
        TargetChildIsAuthoredSource { role: _, identity: _ } => "child_source"
        TargetChildIsCorpusManifest { role: _, identity: _ } => "child_manifest"
        BindingLocatorCollision { role: _, identity: _ } => "collision"
        RequiredDependencyRemoved { dependency: _, removed_role: _ } => "dependency"
        DependencyKindUnsupportedForRoleRequirementIntegration { dependent: _, required: _, kind: _ } => "kind"
      }
  }
}

// The child edge must be NAMED for the integration to read it as a role, so this document differs from the
// checkout one in exactly that: label "named" rather than "positional".
fn scm_image_named_node_entry_targeting(position: String, name: String) -> JsonValue {
  json_object(
    members: [
      json_kv(
        key: "kind",
        value: json_object(
          members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "conj")),
          ]
        )
      ),
      json_kv(
        key: "children",
        value: json_array(
          elements: [
            json_object(
              members: [
                json_kv(key: "label", value: json_string(s: "named")),
                json_kv(key: "name", value: json_string(s: name)),
                json_kv(
                  key: "target",
                  value: json_object(members: [json_kv(key: "at", value: json_string(s: position))])
                ),
              ]
            )
          ]
        )
      ),
    ]
  )
}

fn scm_image_role_over_a_file_document() -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(
        key: "objects",
        value: json_array(
          elements: [
            scm_image_authored_entry(),
            scm_image_named_node_entry_targeting(position: "0", name: "s"),
          ]
        )
      ),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])
      ),
    ]
  )
}

fn scm_image_integration_tag_for(document: JsonValue) -> String {
  match decode_closure_document(v: document) {
    ClosureDocRefused { cause: _ } => "document_refused"
    ClosureDocLoaded { store: store, root: root } =>
      scm_image_integration_refusal_tag(
        o: integrate_role_requirements(
          store: store,
          target: commit_of_root(root: root),
          target_dependencies: [],
          proposals: [],
        )
      )
  }
}

test fn scm_image_a_role_whose_value_is_a_file_refuses_the_document() -> Bool {
  scm_image_integration_tag_for(document: scm_image_role_over_a_file_document()) == "document_refused"
}

// CONTROL: the identical document with a NODE at position 0 integrates, so the refusal above is about
// the child's kind rather than about a single-role target or an empty proposal list.
fn scm_image_role_over_a_node_document() -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(
        key: "objects",
        value: json_array(
          elements: [
            json_object(
              members: [
                json_kv(
                  key: "kind",
                  value: json_object(
                    members: [
                      json_kv(key: "kind", value: json_string(s: "type")),
                      json_kv(key: "connective", value: json_string(s: "conj")),
                    ]
                  )
                ),
                json_kv(key: "children", value: json_array(elements: [])),
              ]
            ),
            scm_image_named_node_entry_targeting(position: "0", name: "s"),
          ]
        )
      ),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])
      ),
    ]
  )
}

test fn scm_image_a_role_whose_value_is_a_node_integrates() -> Bool {
  scm_image_integration_tag_for(document: scm_image_role_over_a_node_document()) == "integrated"
}

// ------------------------------------------------------------------------------------------------
// THE AUTHORED-SOURCE ROUND TRIP, BOTH ARMS, THROUGH THE REAL CODEC.
//
// The re-review's bar asked for this and it was the one item still missing. Every other source claim
// in this file drives a HAND-AUTHORED document into the decoder, which is the right shape for
// refusals -- a refusal fixture must be able to author bytes no encoder would emit. It is the wrong
// shape for the question this asks, which is whether the encoder and decoder agree about a file:
// bytes in, document out, document in, and the SAME object back.
//
// BOTH ARMS, because AuthoredSourceContent has two constructors and the empty one is the one with a
// reason to differ: it has no NonEmptyStr to carry, its identity comes from a different payload, and
// an encoder that dropped it entirely would leave a document that still decodes. The claim compares
// the decoded content against the content the store derived from the original text, so a codec that
// round-tripped the empty file as a one-space file, or as nothing at all, goes red.
//
// The root is a NODE, not either file: a root naming a file is its own refusal
// (scm_image_a_root_naming_a_file_refuses_at_decode), so a round trip rooted at one would be
// asserting the refusal rather than the round trip.
type SourceRoundTrip {
  store: ObjectStore
  root: SemanticNodeTarget
  empty_locator: ObjectId
  text_locator: ObjectId
  ok: Bool
}

fn scm_image_source_round_trip_fixture() -> SourceRoundTrip {
  match store_authored_source(store: empty_store(), text: "") {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
      SourceRoundTrip {
        store: empty_store(),
        root: SemanticNodeTarget { locator: content_hash(n: closure_doc_atom(identity: ^unused)) },
        empty_locator: content_hash(n: closure_doc_atom(identity: ^unused)),
        text_locator: content_hash(n: closure_doc_atom(identity: ^unused)),
        ok: false,
      }
    SourceStored { store: with_empty, source: empty_ref } =>
      match store_authored_source(store: with_empty, text: "a \"quoted\" file\n") {
        SourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
          SourceRoundTrip {
            store: empty_store(),
            root: SemanticNodeTarget { locator: empty_ref.locator },
            empty_locator: empty_ref.locator,
            text_locator: empty_ref.locator,
            ok: false,
          }
        SourceStored { store: with_both, source: text_ref } =>
          match store_node(store: with_both, n: closure_doc_atom(identity: ^round_trip_root)) {
            LocatorCollision { identity: _, existing: _, incoming: _ } =>
              SourceRoundTrip {
                store: empty_store(),
                root: SemanticNodeTarget { locator: empty_ref.locator },
                empty_locator: empty_ref.locator,
                text_locator: text_ref.locator,
                ok: false,
              }
            Stored { store: full, node: root } =>
              SourceRoundTrip {
                store: full,
                root: node_target_of(reference: root),
                empty_locator: empty_ref.locator,
                text_locator: text_ref.locator,
                ok: true,
              }
          }
      }
  }
}

fn scm_image_content_at(store: ObjectStore, locator: ObjectId) -> AuthoredSourceContent? {
  match find_authored_source_record(store: store, identity: locator) {
    AuthoredSourceFound(record) => Present { value: record.content }
    AuthoredSourceAbsent { identity: _ } => none
    AuthoredSourceIsSemanticNode { identity: _ } => none
    AuthoredSourceIsCorpusManifest { identity: _ } => none
  }
}

fn scm_image_content_matches(store: ObjectStore, locator: ObjectId, text: String) -> Bool {
  match scm_image_content_at(store: store, locator: locator) {
    Absent => false
    Present { value: content } => content == authored_source_content(text: text)
  }
}

// THE DURABLE LEG, AND IT IS LOAD-BEARING BY DATAFLOW RATHER THAN BY THIS COMMENT.
//
// Both source claims below used to hand decode_closure_document the value encode returned, in memory.
// That executes the codec but NOT the wire: the payload carries a newline, and inside a JsonString a
// newline is just a character -- its escaping and re-parsing are never exercised, so a defect at the
// serialize/parse boundary would leave both claims green. Review named this precisely and it was
// right; the earlier commit message calling this route a round trip through the wire overstated it.
//
// The only successful arm returns the REPARSED value, so a claim physically cannot read reconstructed
// content from anything but text that was serialized and parsed back. An unreadable parse is false.
// AN UNREADABLE PARSE IS ABSENT, NOT A DECODE REFUSAL. Manufacturing some ClosureDocRefusal arm here
// would report a decoder verdict for something the decoder never saw -- a fabricated plausible output
// of exactly the kind DESIGN section 5 forbids, and it would make a serializer defect arrive wearing
// the decoder's name. The option has no arm to lie in: Absent means the text did not parse, and every
// caller answers false to it.
fn scm_image_reload_through_text(store: ObjectStore, root: SemanticNodeTarget) -> ClosureDocLoadOutcome? {
  match parse_json_document(s: serialize_json(v: scm_image_encode_or_empty(store: store, root: root))) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: reparsed } => Present { value: decode_closure_document(v: reparsed) }
  }
}

// ------------------------------------------------------------------------------------------------
// THE WRONG-KIND STANDING, EXECUTED AGAINST A REAL DOCUMENT.
//
// LoadRequirementAtWrongKind had an implementation, exhaustive plumbing at every consumer, and
// NO executed evidence that an external document actually reaches it rather than LoadPartial. That is
// the shape DESIGN section 5 names: a typed carrier and a tag are not a consumer.
//
// The document is authored by hand because the encoders now REFUSE to produce it -- which is the
// point of the seal, and also why the RED has to be authored as source rather than encoded. Section
// 4b's test applies exactly here: the state is unrepresentable in the accepted corpus and perfectly
// representable as bytes handed to the decoder, which is what a codec's regression probes are for.
//
//   object 0 = an authored source
//   object 1 = a semantic node whose only child target is UNCONTAINED and names object 0's locator
//   root     = object 1
//
// The child is spelled uncontained rather than contained because a contained edge naming a source is
// refused at decode -- a different, already-witnessed arm. This document loads CLEANLY; what it
// asserts is unsatisfiable, and the standing is the only place that can say so.
fn scm_image_source_entry(text: String) -> JsonValue {
  json_object(members: [json_kv(key: "source", value: json_string(s: text))])
}

fn scm_image_node_over_uncontained(digest: String) -> JsonValue {
  json_object(
    members: [
      json_kv(
        key: "kind",
        value: json_object(
          members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "conj")),
          ]
        )
      ),
      json_kv(
        key: "children",
        value: json_array(
          elements: [
            json_object(
              members: [
                json_kv(key: "label", value: json_string(s: "positional")),
                json_kv(
                  key: "target",
                  value: json_object(
                    members: [json_kv(key: "uncontained", value: json_string(s: digest))]
                  )
                ),
              ]
            )
          ]
        )
      ),
    ]
  )
}

fn scm_image_two_object_document(first: JsonValue, second: JsonValue) -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(key: "objects", value: json_array(elements: [first, second])),
      json_kv(
        key: "root",
        value: json_object(members: [json_kv(key: "at", value: json_string(s: "1"))])
      ),
    ]
  )
}

fn scm_image_source_digest(text: String) -> String {
  match store_authored_source(store: empty_store(), text: text) {
    SourceLocatorCollision { identity: i, existing: _, incoming: _ } => i.digest as String
    SourceStored { store: _, source: s } => s.locator.digest as String
  }
}

fn scm_image_standing_of(v: JsonValue) -> LoadStanding {
  closure_document_standing(outcome: decode_closure_document(v: v))
}

// CONTROL ONE, one fact apart: nothing at that locator. A genuine absence IS partial, and IS loaded.
test fn scm_image_a_requirement_over_nothing_is_partial_and_loaded() -> Bool {
  let doc = scm_image_two_object_document(
    first: scm_image_empty_node_entry(),
    second: scm_image_node_over_uncontained(digest: "0000000000000000"),
  )
  match scm_image_standing_of(v: doc) {
    LoadPartial => standing_loaded(standing: LoadPartial)
    _ => false
  }
}

// CONTROL TWO, and it is the cell that keeps the pair from being about presence rather than KIND. A
// SEMANTIC NODE carried at that locator resolves the SAME uncontained spelling to a complete closure.
// Without it, the two cells above are satisfied by a decoder that treats every uncontained target as
// unresolved regardless of what the document carries -- which would make LoadComplete unreachable
// through this spelling and delete the reason dependency order is derived at all.
fn scm_image_leaf_entry(tag: String) -> JsonValue {
  json_object(
    members: [
      json_kv(
        key: "kind",
        value: json_object(
          members: [
            json_kv(key: "kind", value: json_string(s: "type")),
            json_kv(key: "connective", value: json_string(s: "atom")),
            json_kv(key: "identity", value: json_string(s: tag)),
          ]
        )
      ),
      json_kv(key: "children", value: json_array(elements: [])),
    ]
  )
}

fn scm_image_leaf_digest(tag: Symbol) -> String {
  match store_node(
    store: empty_store(),
    n: node_synthetic(kind: TypeNode { connective: Atom { identity: tag } }, children: []),
  ) {
    LocatorCollision { identity: i, existing: _, incoming: _ } => i.digest as String
    Stored { store: _, node: n } => n.locator.digest as String
  }
}

test fn scm_image_a_requirement_over_a_carried_node_is_complete_and_loaded() -> Bool {
  let doc = scm_image_two_object_document(
    first: scm_image_leaf_entry(tag: "carried_leaf"),
    second: scm_image_node_over_uncontained(digest: scm_image_leaf_digest(tag: ^carried_leaf)),
  )
  match scm_image_standing_of(v: doc) {
    LoadComplete => standing_loaded(standing: LoadComplete)
    _ => false
  }
}

// THE DOWNSTREAM DESTINATION, because a standing that no actuator consumes is a value with a name and
// no consequence. This drives the standing THAT DOCUMENT ACTUALLY PRODUCES -- not a literal handed to
// the actuator -- into the real supersession path, with every other condition admitting, so the only
// thing that can refuse is the standing itself.
fn scm_image_wrong_kind_document() -> JsonValue {
  scm_image_two_object_document(
    first: scm_image_source_entry(text: "a carried file\n"),
    second: scm_image_node_over_uncontained(digest: scm_image_source_digest(text: "a carried file\n")),
  )
}

fn scm_image_slot() -> HeadSlot {
  HeadSlot { slot: "head", generation: scm_image_generation(tag: ^scm_image_current) }
}

fn scm_image_generation(tag: Symbol) -> ObjectId {
  match store_node(
    store: empty_store(),
    n: node_synthetic(kind: TypeNode { connective: Atom { identity: tag } }, children: []),
  ) {
    Stored { store: _, node: n } => n.locator
    LocatorCollision { identity: i, existing: _, incoming: _ } => i
  }
}

// ---------------------------------------------------------------------------
// A v4 contained root can only be a node, and these three say why
// ---------------------------------------------------------------------------

// THE ROOT WRONG-KIND REFUSALS ARE GONE, AND THAT IS A CLAIM ABOUT THE TYPE RATHER THAN ABOUT
// COVERAGE. ClosureDocRootIsAuthoredSource and its manifest sibling used to guard the arm where a
// contained root resolved to something that was not a node. The v4 table's positions are
// Map<String, SemanticNodeObjectRef>, so that state has no constructor and the guard had nothing
// left to refuse -- an arm in a closed result type that no producer could produce.
//
// Deleting a refusal is exactly the move that deserves suspicion, because "nobody reached it" and
// "it cannot be reached" look identical from the outside and only one of them is a wall. These three
// separate the two by distinguishing the three fates a root reference can now have, and the middle
// one is the control that keeps the other two from being satisfied by a decoder that refuses
// everything.

fn scm_image_document_with_entries_and_root(entries: List<JsonValue>, at: String) -> JsonValue {
  json_object(
    members: [
      json_kv(key: "format", value: json_string(s: closure_document_format_tag)),
      json_kv(key: "objects", value: json_array(elements: entries)),
      json_kv(key: "root", value: json_object(members: [json_kv(key: "at", value: json_string(s: at))])),
    ]
  )
}

// ONE. A NON-NODE ENTRY REFUSES BEFORE ROOT RESOLUTION EVER RUNS. This is what makes the deletion
// safe rather than lucky: a `{source}` entry never becomes a decoded position at all, so root
// resolution is never handed one to be wrong about. The cause is the node entry's own member set --
// `source` is not in {kind, children} -- and NOT a root cause, which is the whole point.
test fn scm_image_a_source_entry_refuses_before_root_resolution() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: scm_image_document_with_entries_and_root(
        entries: [json_object(members: [json_kv(key: "source", value: json_string(s: "text"))])],
        at: "0",
      )
    )
  ) == "table_unexpected_member"
}

// TWO, THE CONTROL. An ordinary node entry at position 0 with a root naming it still loads. Without
// this the claim above and the one below are satisfied by a decoder that refuses every document, and
// the deletion would have been measured against nothing.
test fn scm_image_a_node_position_is_a_valid_contained_root() -> Bool {
  scm_image_loads_as(
    loaded: decode_closure_document(
      v: scm_image_document_with_entries_and_root(
        entries: [scm_image_empty_node_entry()],
        at: "0",
      )
    ),
    expected: node_synthetic(kind: TypeNode { connective: Conj }, children: []),
  )
}

// THREE. A position nothing defined is UNRESOLVED, and it is a separate claim from the first because
// the collapse this branch keeps re-committing would merge them: reporting a wrong-kind position as
// unresolved reads exactly like this. With the wrong-kind state unconstructible, "unresolved" now
// means only what it says -- no position, rather than the wrong thing at one.
test fn scm_image_a_root_naming_no_position_is_unresolved() -> Bool {
  scm_image_cause_tag(
    loaded: decode_closure_document(
      v: scm_image_document_with_entries_and_root(
        entries: [scm_image_empty_node_entry()],
        at: "999",
      )
    )
  ) == "root_position"
}
