module test.claim.scm_checkout_verb_witness

// THE CHECKOUT VERB AT REPOSITORY GRAIN. The reconstruction half of checkout is already covered by
// scm_object_store_witness; these claims are about SELECTION -- which commit a repository is
// positioned at, what refuses, and what checkout does and does not depend on.
//
// THE CLAIM THIS FILE EXISTS FOR is scm_ck_a_commit_with_a_missing_parent_still_checks_out. Checkout
// does not consult ancestry: a fixture can mint a valid parent and child, then assemble an envelope
// retaining only the child. The history is truncated while the child's program remains intact.

import std.types { Bool, Int, String, List, NonEmptyStr }
import std.minted_identity { MintedId, MintedIdAllocator }
import v2.std.node { Node, Symbol, TypeNode, Atom, node_synthetic }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.object_store {
  ObjectStore,
  ObjectId,
  empty_store,
  store_node,
  Stored,
  LocatorCollision,
  SemanticNodeTarget,
  CorpusManifestTarget,
  CorpusManifestEntry,
  CorpusManifestStored,
  CorpusManifestDuplicatePath,
  CorpusManifestLocatorCollision,
  store_corpus_manifest,
  SourceStored,
  SourceLocatorCollision,
  store_authored_source,
  authored_source_target_of,
  authored_source_target_locator,
  corpus_manifest_target_locator,
  object_id_eq,
  AuthoredSourceContent,
  AuthoredSourceEmpty,
  AuthoredSourceText,
}
import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryCommit,
  commit_at_reference,
  repository_history,
  RepositoryCommitMinted,
  RepositoryCommitMintAllocatorInvalid,
  RepositoryCommitMintParentMissing,
  RepositoryCommitMintRootIsAuthoredSource,
  RepositoryCommitMintRootIsSemanticNode,
  RepositoryCommitMintRootMissing,
  mint_repository_commit,
  encode_repository_checked,
  RepositoryEncoded,
  RepositoryEncodeRefused,
  decode_repository,
  RepositoryDecoded,
  RepositoryDecodeRefused,
}
import gunbc.scm.proposal { Proposal }
import gunbc.scm.status {
  StatusCheckout,
  NothingCheckedOut,
  CheckedOutCommit,
  CheckedOutCommitMissing,
  RepositoryStatus,
  repository_status,
}
import gunbc.scm.ancestry {
  CommitAncestry,
  RootCommit,
  DescendsFrom,
  RepositoryCommitRef,
  AncestryWalk,
  AncestryTraced,
  AncestryBrokenAt,
  AncestryStartNotInHistory,
  AncestryRevisitsACommit,
  ancestry_walk,
}
import gunbc.scm.checkout {
  Commit,
  CheckoutRefusal,
  MissingObject,
  ObjectIsAuthoredSource,
  ObjectIsCorpusManifest,
  RepositoryCheckout,
  RepositoryCheckedOut,
  CheckoutSnapshotMissingFromStore,
  CheckoutSnapshotIsAuthoredSource,
  CheckoutSnapshotIsSemanticNode,
  CheckoutCorpusUnrecoverable,
  CorpusEntrySourceMissing,
  CorpusEntrySourceIsSemanticNode,
  CorpusEntrySourceIsCorpusManifest,
  RecoveredSourceFile,
  CheckoutReferenceUnresolved,
  checkout_repository_at,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Names qualified: top-level definitions are corpus-wide and the resolver silently selects among
// duplicates (#8707), which this layer's witness files already document hitting.
type ScmCkPut {
  store: ObjectStore
  identity: SemanticNodeTarget
}

fn scm_ck_put(store: ObjectStore, n: Node) -> ScmCkPut {
  match store_node(store: store, n: n) {
    Stored { store: s, node: node } => ScmCkPut { store: s, identity: node_target_of(reference: node) }
    LocatorCollision { identity: identity, existing: _, incoming: _ } =>
      ScmCkPut { store: store, identity: SemanticNodeTarget { locator: identity } }
  }
}

fn scm_ck_atom(name: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: name } }, children: [])
}

fn scm_ck_ref(ordinal: Int) -> RepositoryCommitRef {
  RepositoryCommitRef { identity: MintedId { ordinal: ordinal } }
}

fn scm_ck_repository_with_store(store: ObjectStore) -> RepositoryEnvelope {
  RepositoryEnvelope {
    store: store,
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 0 },
    checked_out: none,
  }
}

fn scm_ck_minted_or(repo: RepositoryEnvelope, root: CorpusManifestTarget, message: String, parent: RepositoryCommitRef?) -> RepositoryEnvelope {
  match mint_repository_commit(repository: repo, root: root, message: message, parent: parent) {
    RepositoryCommitMinted { repository: minted, reference: _ } => minted
    RepositoryCommitMintAllocatorInvalid { next_ordinal: _ } => repo
    RepositoryCommitMintParentMissing { parent: _ } => repo
    RepositoryCommitMintRootMissing { root: _ } => repo
    RepositoryCommitMintRootIsAuthoredSource { root: _ } => repo
    RepositoryCommitMintRootIsSemanticNode { root: _ } => repo
  }
}

type ScmCkSnapshot { store: ObjectStore, identity: CorpusManifestTarget }

// A SNAPSHOT WHOSE SOURCE IS ACTUALLY PRESENT. Recovery walks the entries, so a manifest over a
// dangling source would make the recovered arm unreachable and every positive control below would
// pass by refusing.
fn scm_ck_snapshot(store: ObjectStore, path: NonEmptyStr, text: String) -> ScmCkSnapshot {
  match store_authored_source(store: store, text: text) {
    SourceLocatorCollision { identity: id, existing: _, incoming: _ } =>
      ScmCkSnapshot { store: store, identity: CorpusManifestTarget { locator: id } }
    SourceStored { store: with_source, source: source } =>
      scm_ck_manifest_over(
        store: with_source,
        entry: CorpusManifestEntry { path: path, source: authored_source_target_of(reference: source) }
      )
  }
}

fn scm_ck_manifest_over(store: ObjectStore, entry: CorpusManifestEntry) -> ScmCkSnapshot {
  match store_corpus_manifest(store: store, entries: [entry]) {
    CorpusManifestDuplicatePath { path: _ } =>
      ScmCkSnapshot { store: store, identity: CorpusManifestTarget { locator: authored_source_target_locator(target: entry.source) } }
    CorpusManifestLocatorCollision { identity: id, existing: _, incoming: _ } =>
      ScmCkSnapshot { store: store, identity: CorpusManifestTarget { locator: id } }
    CorpusManifestStored { store: next, manifest: manifest } =>
      ScmCkSnapshot { store: next, identity: CorpusManifestTarget { locator: manifest.locator } }
  }
}

// A repository with two commits, the second stating the first as its parent, and BOTH snapshots
// present in the store.
fn scm_ck_two_commit_repository() -> RepositoryEnvelope {
  let first = scm_ck_snapshot(store: empty_store(), path: "alpha.dag" as NonEmptyStr, text: "module alpha")
  let second = scm_ck_snapshot(store: first.store, path: "beta.dag" as NonEmptyStr, text: "module beta")
  let first_commit = scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: second.store),
    root: first.identity,
    message: "first",
    parent: none,
  )
  scm_ck_minted_or(
    repo: first_commit,
    root: second.identity,
    message: "second",
    parent: Present { value: scm_ck_ref(ordinal: 0) },
  )
}

test fn scm_ck_checking_out_a_commit_positions_the_repository_at_it() -> Bool {
  let repo = scm_ck_two_commit_repository()
  match checkout_repository_at(repo: repo, reference: scm_ck_ref(ordinal: 1)) {
    RepositoryCheckedOut { repository: r, corpus: _ } =>
      match r.checked_out {
        Absent => false
        Present { value: selected } => selected == scm_ck_ref(ordinal: 1)
      }
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// THE ARGUMENT IS NOT MUTATED. A verb that edited its input in place would make "check out, then
// compare against where we were" impossible, and every caller would need a copy it did not ask for.
test fn scm_ck_checkout_leaves_its_argument_unpositioned() -> Bool {
  let repo = scm_ck_two_commit_repository()
  match checkout_repository_at(repo: repo, reference: scm_ck_ref(ordinal: 1)) {
    RepositoryCheckedOut { repository: _, corpus: _ } =>
      match repo.checked_out {
        Absent => true
        Present { value: _ } => false
      }
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// A REFERENCE NAMING NO COMMIT IS THE CALLER'S FACT. It asserts the arm AND the reference, not merely
// that something refused: a checkout that refused everything would satisfy a bare refusal claim, and
// the positive control above is what stops that reading.
test fn scm_ck_a_reference_naming_no_commit_is_unresolved() -> Bool {
  match checkout_repository_at(repo: scm_ck_two_commit_repository(), reference: scm_ck_ref(ordinal: 7)) {
    CheckoutReferenceUnresolved { reference: r } => r == scm_ck_ref(ordinal: 7)
    RepositoryCheckedOut { repository: _, corpus: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// A repository whose commit names a root the store does not hold: the commit exists, the program
// does not.
fn scm_ck_lost_object_repository() -> RepositoryEnvelope {
  let present = scm_ck_snapshot(store: empty_store(), path: "alpha.dag" as NonEmptyStr, text: "module alpha")
  let absent = scm_ck_snapshot(store: empty_store(), path: "gamma.dag" as NonEmptyStr, text: "module gamma")
  let minted = scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: absent.store),
    root: absent.identity,
    message: "lost",
    parent: none,
  )
  RepositoryEnvelope {
    store: present.store,
    commits: minted.commits,
    commit_allocator: minted.commit_allocator,
    checked_out: none,
  }
}

// A LOST OBJECT IS THE STORE'S FACT, NOT THE CALLER'S, and this is the claim that keeps the two
// refusals from being collapsed. The reference resolves perfectly -- the commit is right there in
// the log -- and the failure is that the repository has lost an object it needs. Reporting "no such
// commit" here would tell a user their commit does not exist while it sits in front of them.
test fn scm_ck_a_lost_object_is_the_stores_fact_not_the_callers() -> Bool {
  match checkout_repository_at(repo: scm_ck_lost_object_repository(), reference: scm_ck_ref(ordinal: 0)) {
    CheckoutSnapshotMissingFromStore { reference: r, root: _ } => r == scm_ck_ref(ordinal: 0)
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
    RepositoryCheckedOut { repository: _, corpus: _ } => false
  }
}

// DESIGNATION AND RECOVERABILITY ARE DIFFERENT FACTS, and this is the control that keeps them apart.
// The commit names a manifest the store HOLDS -- so the snapshot designation is perfect, and the arm
// above does not fire -- while the source that manifest names was never stored. Reporting this as a
// missing snapshot would send the operator to repair the commit rather than fetch the source, and
// reporting it as a successful checkout would hand back a corpus with a file silently absent.
// The absent source's locator, derived the same way the manifest entry derives it, so the claim below
// can assert WHICH object is missing rather than only that something was.
fn scm_ck_absent_source_locator() -> ObjectId {
  match store_authored_source(store: empty_store(), text: "module never_stored") {
    SourceLocatorCollision { identity: i, existing: _, incoming: _ } => i
    SourceStored { store: _, source: source } => source.locator
  }
}

fn scm_ck_unrecoverable_source_repository() -> RepositoryEnvelope {
  let orphan = store_authored_source(store: empty_store(), text: "module never_stored")
  match orphan {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } => scm_ck_two_commit_repository()
    SourceStored { store: _, source: source } =>
      let held = scm_ck_manifest_over(
        store: empty_store(),
        entry: CorpusManifestEntry {
          path: "never_stored.dag" as NonEmptyStr,
          source: authored_source_target_of(reference: source),
        }
      )
      scm_ck_minted_or(
        repo: scm_ck_repository_with_store(store: held.store),
        root: held.identity,
        message: "manifest held, source absent",
        parent: none,
      )
  }
}

test fn scm_ck_a_held_snapshot_with_an_absent_source_is_unrecoverable_not_missing() -> Bool {
  match checkout_repository_at(repo: scm_ck_unrecoverable_source_repository(), reference: scm_ck_ref(ordinal: 0)) {
    CheckoutCorpusUnrecoverable { reference: r, cause: cause } =>
      r == scm_ck_ref(ordinal: 0)
        && match cause {
             CorpusEntrySourceMissing { path: p, source: missing } =>
               (p as String) == "never_stored.dag"
                 && object_id_eq(left: missing, right: scm_ck_absent_source_locator())
             CorpusEntrySourceIsSemanticNode { path: _, source: _ } => false
             CorpusEntrySourceIsCorpusManifest { path: _, source: _ } => false
           }
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    RepositoryCheckedOut { repository: _, corpus: _ } => false
  }
}

// Both commits are constructed through the mint while the parent is present. The envelope is a
// separate, unsealed carrier, so retaining only the child is still authorable and demonstrates the
// precise boundary of the construction wall: the mint admits one commit; it does not seal every
// later assembly of a commit list.
fn scm_ck_truncated_history_repository() -> RepositoryEnvelope {
  let parent = scm_ck_snapshot(store: empty_store(), path: "parent.dag" as NonEmptyStr, text: "module parent")
  let child = scm_ck_snapshot(store: parent.store, path: "child.dag" as NonEmptyStr, text: "module child")
  let with_parent = scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: child.store),
    root: parent.identity,
    message: "parent",
    parent: none,
  )
  let with_child = scm_ck_minted_or(
    repo: with_parent,
    root: child.identity,
    message: "child",
    parent: Present { value: scm_ck_ref(ordinal: 0) },
  )
  match commit_at_reference(commits: with_child.commits, reference: scm_ck_ref(ordinal: 1)) {
    Absent => with_child
    Present { value: child_commit } =>
      RepositoryEnvelope {
        store: with_child.store,
        commits: [child_commit],
        commit_allocator: with_child.commit_allocator,
        checked_out: none,
      }
  }
}

// Checkout reconstructs the selected commit's root closure, not its ancestry graph. Losing a parent
// must not cost access to a program whose own closure remains complete.
test fn scm_ck_a_commit_with_a_missing_parent_still_checks_out() -> Bool {
  match checkout_repository_at(
    repo: scm_ck_truncated_history_repository(),
    reference: scm_ck_ref(ordinal: 1),
  ) {
    RepositoryCheckedOut { repository: _, corpus: _ } => true
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// The positive control proves that the same fixture's history really is truncated; otherwise the
// checkout claim above could pass without demonstrating checkout's independence from ancestry.
test fn scm_ck_that_same_commit_has_a_broken_ancestry() -> Bool {
  let repo = scm_ck_truncated_history_repository()
  match ancestry_walk(
    start: scm_ck_ref(ordinal: 1),
    history: repository_history(commits: repo.commits),
  ) {
    AncestryBrokenAt { commit: at, missing_parent: missing } =>
      at == scm_ck_ref(ordinal: 1) && missing == scm_ck_ref(ordinal: 0)
    AncestryTraced { chain: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// ------------------------------------------------------------------------------------------------
// A selection names a ROW, not a root (review 56230)
// ------------------------------------------------------------------------------------------------

// TWO COMMITS, ONE ROOT, DIFFERENT MESSAGES. This is legal and gunbc.scm.log has its own witness for
// it -- two_commits_sharing_a_root_still_get_distinct_references -- so a root is NOT a unique key
// into the commit list.
fn scm_ck_shared_root_repository() -> RepositoryEnvelope {
  let only = scm_ck_snapshot(store: empty_store(), path: "shared.dag" as NonEmptyStr, text: "module shared")
  let first = scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: only.store),
    root: only.identity,
    message: "FIRST",
    parent: none,
  )
  scm_ck_minted_or(repo: first, root: only.identity, message: "SECOND", parent: none)
}

// THE DEFECT REVIEW 56230 FOUND, ASSERTED END TO END. Measured before the repair, this returned
// FALSE: the selection stored the commit's ROOT, every reader resolved a root to the FIRST matching
// row, and a user who checked out the second commit was told by `status` that they were on the
// first. Nothing refused -- the wrong answer was reported as an ordinary success.
//
// It asserts through STATUS rather than through the envelope field, because the field being right is
// not the claim; the claim is that the user is told which commit they are on.
test fn scm_ck_checking_out_the_second_of_two_shared_root_commits_reports_its_own_message() -> Bool {
  match checkout_repository_at(repo: scm_ck_shared_root_repository(), reference: scm_ck_ref(ordinal: 1)) {
    RepositoryCheckedOut { repository: r, corpus: _ } =>
      match repository_status(
        envelope: r,
        pending: Proposal { requirements: [], dependencies: [] },
      ) {
        RepositoryStatus { checkout: co, commit_count: _, staged: _ } =>
          match co {
            CheckedOutCommit { root: _, message: m } => m == "SECOND"
            NothingCheckedOut => false
            CheckedOutCommitMissing { reference: _ } => false
          }
      }
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// THE POSITIVE CONTROL, and it is what stops the claim above from being satisfied by a reader that
// always returns the LAST row instead of always the first. Checking out the first identity must report
// FIRST -- so the two together pin the selection to the row named, not to an end of the list.
test fn scm_ck_checking_out_the_first_of_two_shared_root_commits_reports_its_own_message() -> Bool {
  match checkout_repository_at(repo: scm_ck_shared_root_repository(), reference: scm_ck_ref(ordinal: 0)) {
    RepositoryCheckedOut { repository: r, corpus: _ } =>
      match repository_status(
        envelope: r,
        pending: Proposal { requirements: [], dependencies: [] },
      ) {
        RepositoryStatus { checkout: co, commit_count: _, staged: _ } =>
          match co {
            CheckedOutCommit { root: _, message: m } => m == "FIRST"
            NothingCheckedOut => false
            CheckedOutCommitMissing { reference: _ } => false
          }
      }
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// A MULTI-FILE SNAPSHOT, INCLUDING SOURCE THIS BUILD CANNOT INGEST AND A GENUINELY EMPTY FILE.
// The malformed entry is the point: recovery must not require successful semantic ingestion, which is
// the whole reason a commit freezes authored bytes rather than a semantic root. The empty file is
// here so "an empty source" and "an empty corpus" cannot be confused -- E2's mutation returns the
// latter and would otherwise look like the former.
fn scm_ck_mixed_snapshot() -> ScmCkSnapshot {
  match store_authored_source(store: empty_store(), text: "module ok") {
    SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
      ScmCkSnapshot { store: empty_store(), identity: CorpusManifestTarget { locator: i } }
    SourceStored { store: s1, source: ok } =>
      match store_authored_source(store: s1, text: "module { ) unparseable <<<") {
        SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
          ScmCkSnapshot { store: s1, identity: CorpusManifestTarget { locator: i } }
        SourceStored { store: s2, source: broken } =>
          match store_authored_source(store: s2, text: "") {
            SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
              ScmCkSnapshot { store: s2, identity: CorpusManifestTarget { locator: i } }
            SourceStored { store: s3, source: blank } =>
              match store_corpus_manifest(store: s3, entries: [
                CorpusManifestEntry { path: "ok.dag" as NonEmptyStr, source: authored_source_target_of(reference: ok) },
                CorpusManifestEntry { path: "broken.dag" as NonEmptyStr, source: authored_source_target_of(reference: broken) },
                CorpusManifestEntry { path: "blank.dag" as NonEmptyStr, source: authored_source_target_of(reference: blank) },
              ]) {
                CorpusManifestStored { store: next, manifest: manifest } =>
                  ScmCkSnapshot { store: next, identity: CorpusManifestTarget { locator: manifest.locator } }
                CorpusManifestDuplicatePath { path: _ } =>
                  ScmCkSnapshot { store: s3, identity: CorpusManifestTarget { locator: ok.locator } }
                CorpusManifestLocatorCollision { identity: i, existing: _, incoming: _ } =>
                  ScmCkSnapshot { store: s3, identity: CorpusManifestTarget { locator: i } }
              }
          }
      }
  }
}

fn scm_ck_mixed_repository() -> RepositoryEnvelope {
  let snapshot = scm_ck_mixed_snapshot()
  scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: snapshot.store),
    root: snapshot.identity,
    message: "mixed",
    parent: none,
  )
}

fn scm_ck_recovered_text(f: RecoveredSourceFile) -> String {
  match f.content {
    AuthoredSourceEmpty => ""
    AuthoredSourceText(t) => t as String
  }
}

// THE SUCCESSFUL CORPUS IS ASSERTED BY CONTENT, WHICH EVERY CONTROL ABOVE DISCARDED.
//
// This exists because of a source-traced counterexample the reviewer of gunbc#10560 supplied: every
// other successful match in this file binds `corpus: _`, so changing ONLY the success arm to return
// `corpus: []` -- leaving every recovery decision and every refusal branch intact -- would leave the
// whole suite green while every checkout returned nothing. Selection was asserted, refusals were
// asserted, and the value the verb exists to produce was not.
//
// So this asserts the complete population, the paths, AND the contents. It includes source this build
// cannot ingest, because recovery must not require successful semantic ingestion -- if it did, a
// repository holding one malformed file would become uncheckoutable, which is precisely what freezing
// authored bytes exists to prevent. And it includes an empty file so that an EMPTY SOURCE and an
// EMPTY CORPUS cannot be read as the same observation.
test fn scm_ck_a_successful_checkout_recovers_every_authored_file_by_content() -> Bool {
  match checkout_repository_at(repo: scm_ck_mixed_repository(), reference: scm_ck_ref(ordinal: 0)) {
    RepositoryCheckedOut { repository: _, corpus: corpus } =>
      map(corpus, f => f.path as String) == ["blank.dag", "broken.dag", "ok.dag"]
        && map(corpus, f => scm_ck_recovered_text(f: f))
          == ["", "module { ) unparseable <<<", "module ok"]
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
    CheckoutCorpusUnrecoverable { reference: _, cause: _ } => false
  }
}

// E1, THE OTHER HALF: THE MISSING REQUIREMENT IS RECOVERABLE ONCE SUPPLIED, AND THE SNAPSHOT DOES NOT
// MOVE WHEN IT IS. One partial snapshot, driven through both consumers, because the two answers only
// mean something together: the codec admitting a partial corpus is honest ONLY IF the deficit is still
// reported where it is observed, and reporting the deficit is useful ONLY IF supplying the source
// repairs it without minting a different commit.
//
// The snapshot designation is asserted to be UNCHANGED across the repair -- same manifest locator,
// same commit -- which is what distinguishes "the source arrived" from "a new snapshot was frozen".
fn scm_ck_partial_snapshot() -> ScmCkSnapshot {
  match store_authored_source(store: empty_store(), text: "module held") {
    SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
      ScmCkSnapshot { store: empty_store(), identity: CorpusManifestTarget { locator: i } }
    SourceStored { store: with_held, source: held } =>
      match store_corpus_manifest(store: with_held, entries: [
        CorpusManifestEntry { path: "held.dag" as NonEmptyStr, source: authored_source_target_of(reference: held) },
        CorpusManifestEntry {
          path: "gone.dag" as NonEmptyStr,
          source: AuthoredSourceTarget { locator: scm_ck_absent_source_locator() },
        },
      ]) {
        CorpusManifestStored { store: next, manifest: manifest } =>
          ScmCkSnapshot { store: next, identity: CorpusManifestTarget { locator: manifest.locator } }
        CorpusManifestDuplicatePath { path: _ } =>
          ScmCkSnapshot { store: with_held, identity: CorpusManifestTarget { locator: held.locator } }
        CorpusManifestLocatorCollision { identity: i, existing: _, incoming: _ } =>
          ScmCkSnapshot { store: with_held, identity: CorpusManifestTarget { locator: i } }
      }
  }
}

fn scm_ck_partial_repository(store: ObjectStore, root: CorpusManifestTarget) -> RepositoryEnvelope {
  scm_ck_minted_or(
    repo: scm_ck_repository_with_store(store: store),
    root: root,
    message: "partial",
    parent: none,
  )
}

// THE SUBJECT IS THE DECODED IMAGE, NOT A SECOND FIXTURE, and an earlier cut of this claim got that
// wrong. It built its own partial snapshot, refused, supplied a source and recovered -- all useful,
// and all about a repository that had never been through the codec. The story only means something
// joined up: the codec admitting a partial corpus is honest ONLY IF the deficit is still reported
// where it is observed, on the representation that was actually written and read back.
//
// So this encodes, decodes, and checks out THE DECODED ENVELOPE. Its missing object is the same
// authored source test.claim.scm_repository_envelope_witness omits from its document, so both halves
// name one subject rather than two absences that merely rhyme.
//
// The snapshot designation is asserted UNCHANGED across the repair -- same commit, same manifest
// locator -- which is what separates "the source arrived" from "a different snapshot was frozen".
//
// THE FINAL OBSERVATION IS ON THE RETURNED REPOSITORY, AT THE REQUESTED REFERENCE, AGAINST THE
// ORIGINALLY MINTED MANIFEST. An earlier cut compared two copies of the same commit list, which
// verifies no property of the value the verb produced -- a success arm returning an empty commit list
// would have passed it. This resolves the requested reference IN THE RETURNED REPOSITORY and compares
// that commit's root to the manifest the fixture froze before any encoding happened, so the snapshot
// is asserted to survive mint, encode, decode, repair and checkout as ONE identity. The returned
// selection is checked too, because moving the selection is the other half of what checkout is for.
fn scm_ck_decoded(repo: RepositoryEnvelope) -> RepositoryEnvelope? {
  match encode_repository_checked(repo: repo) {
    RepositoryEncodeRefused { cause: _ } => none
    RepositoryEncoded { value: wire } =>
      match decode_repository(v: wire) {
        RepositoryDecodeRefused { cause: _ } => none
        RepositoryDecoded { envelope: e } => Present { value: e }
      }
  }
}

test fn scm_ck_a_partial_snapshot_refuses_then_recovers_once_its_source_arrives() -> Bool {
  let snapshot = scm_ck_partial_snapshot()
  match scm_ck_decoded(repo: scm_ck_partial_repository(store: snapshot.store, root: snapshot.identity)) {
    Absent => false
    Present { value: decoded } =>
      let supplied = match store_authored_source(store: decoded.store, text: "module never_stored") {
        SourceLocatorCollision { identity: _, existing: _, incoming: _ } => decoded.store
        SourceStored { store: s, source: _ } => s
      }
      let repaired = RepositoryEnvelope {
        store: supplied,
        commits: decoded.commits,
        commit_allocator: decoded.commit_allocator,
        checked_out: decoded.checked_out,
      }
      match checkout_repository_at(repo: decoded, reference: scm_ck_ref(ordinal: 0)) {
        CheckoutCorpusUnrecoverable { reference: r, cause: cause } =>
          r == scm_ck_ref(ordinal: 0)
            && match cause {
                 CorpusEntrySourceMissing { path: p, source: missing } =>
                   (p as String) == "gone.dag"
                     && object_id_eq(left: missing, right: scm_ck_absent_source_locator())
                 CorpusEntrySourceIsSemanticNode { path: _, source: _ } => false
                 CorpusEntrySourceIsCorpusManifest { path: _, source: _ } => false
               }
        _ => false
      }
        && match checkout_repository_at(repo: repaired, reference: scm_ck_ref(ordinal: 0)) {
             RepositoryCheckedOut { repository: returned, corpus: corpus } =>
               map(corpus, f => f.path as String) == ["gone.dag", "held.dag"]
                 && map(corpus, f => scm_ck_recovered_text(f: f)) == ["module never_stored", "module held"]
                 && match scm_ck_root_locator_at(repo: returned, reference: scm_ck_ref(ordinal: 0)) {
                      Absent => false
                      Present { value: got } =>
                        object_id_eq(
                          left: got,
                          right: corpus_manifest_target_locator(target: snapshot.identity),
                        )
                    }
                 && scm_ck_selection_is(repo: returned, reference: scm_ck_ref(ordinal: 0))
             _ => false
           }
  }
}

// THE DESIGNATION IS READ AT A NAMED REFERENCE, NOT BY FOLDING THE ROW LIST. The helper this replaces
// overwrote its accumulator on every row, so it answered the LAST commit's root rather than the root
// of the commit anyone asked about. On a single-commit fixture those coincide, which is exactly why it
// established nothing: it would keep agreeing while naming a different subject. Optional fixed
// missingness and did not fix SUBJECT SELECTION. It goes through commit_at_reference, the same
// resolution the verbs use, so the observation cannot drift from theirs.
fn scm_ck_root_locator_at(repo: RepositoryEnvelope, reference: RepositoryCommitRef) -> ObjectId? {
  match commit_at_reference(commits: repo.commits, reference: reference) {
    Absent => none
    Present { value: c } => Present { value: c.root.locator }
  }
}

fn scm_ck_selection_is(repo: RepositoryEnvelope, reference: RepositoryCommitRef) -> Bool {
  match repo.checked_out {
    Absent => false
    Present { value: selected } => selected == reference
  }
}

// RECOVERY MUST NOT RETURN ITS ACCUMULATED PREFIX AS A CORPUS, and the specimen has to put the
// MISSING entry LAST to reach that. The partial snapshot above sorts "gone.dag" before "held.dag"
// under canonical_manifest_entries, so its fold refuses on the first entry and never accumulates.
//
// AN EARLIER WORDING OF THIS NOTE SAID A LEAK WOULD "LOOK IDENTICAL TO A CORRECT REFUSAL" THERE, AND
// THAT WAS WRONG: that claim rejects every RepositoryCheckedOut, including one carrying an empty
// corpus, so an unconditional leak is caught. What it cannot catch is narrower and is the real gap --
// an implementation that refuses correctly when its accumulator is EMPTY and leaks a NONEMPTY prefix
// as success. With nothing ever accumulated there, that behaviour is unreachable and so unobserved.
//
// Here two entries resolve before the third does not. A recovery that exposed what it had gathered
// would hand back a two-file corpus and call it a successful checkout, which is the silently narrowed
// reconstruction the manifest exists to prevent: the caller receives a corpus that is well formed,
// smaller than the snapshot it names, and carries nothing saying so.
fn scm_ck_trailing_gap_snapshot() -> ScmCkSnapshot {
  match store_authored_source(store: empty_store(), text: "module a") {
    SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
      ScmCkSnapshot { store: empty_store(), identity: CorpusManifestTarget { locator: i } }
    SourceStored { store: s1, source: a } =>
      match store_authored_source(store: s1, text: "module b") {
        SourceLocatorCollision { identity: i, existing: _, incoming: _ } =>
          ScmCkSnapshot { store: s1, identity: CorpusManifestTarget { locator: i } }
        SourceStored { store: s2, source: b } =>
          match store_corpus_manifest(store: s2, entries: [
            CorpusManifestEntry { path: "a.dag" as NonEmptyStr, source: authored_source_target_of(reference: a) },
            CorpusManifestEntry { path: "b.dag" as NonEmptyStr, source: authored_source_target_of(reference: b) },
            CorpusManifestEntry {
              path: "z_gone.dag" as NonEmptyStr,
              source: AuthoredSourceTarget { locator: scm_ck_absent_source_locator() },
            },
          ]) {
            CorpusManifestStored { store: next, manifest: manifest } =>
              ScmCkSnapshot { store: next, identity: CorpusManifestTarget { locator: manifest.locator } }
            CorpusManifestDuplicatePath { path: _ } =>
              ScmCkSnapshot { store: s2, identity: CorpusManifestTarget { locator: a.locator } }
            CorpusManifestLocatorCollision { identity: i, existing: _, incoming: _ } =>
              ScmCkSnapshot { store: s2, identity: CorpusManifestTarget { locator: i } }
          }
      }
  }
}

test fn scm_ck_a_gap_after_recoverable_entries_refuses_rather_than_returning_the_prefix() -> Bool {
  let snapshot = scm_ck_trailing_gap_snapshot()
  match checkout_repository_at(
    repo: scm_ck_partial_repository(store: snapshot.store, root: snapshot.identity),
    reference: scm_ck_ref(ordinal: 0),
  ) {
    CheckoutCorpusUnrecoverable { reference: r, cause: cause } =>
      r == scm_ck_ref(ordinal: 0)
        && match cause {
             CorpusEntrySourceMissing { path: p, source: missing } =>
               (p as String) == "z_gone.dag"
                 && object_id_eq(left: missing, right: scm_ck_absent_source_locator())
             CorpusEntrySourceIsSemanticNode { path: _, source: _ } => false
             CorpusEntrySourceIsCorpusManifest { path: _, source: _ } => false
           }
    RepositoryCheckedOut { repository: _, corpus: _ } => false
    CheckoutReferenceUnresolved { reference: _ } => false
    CheckoutSnapshotMissingFromStore { reference: _, root: _ } => false
    CheckoutSnapshotIsAuthoredSource { reference: _, root: _ } => false
    CheckoutSnapshotIsSemanticNode { reference: _, root: _ } => false
  }
}
