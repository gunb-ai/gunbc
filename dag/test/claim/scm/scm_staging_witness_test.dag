module test.claim.scm_staging_witness

// THE CONTROLS FOR add / commit, BUILT TO THE FAILURES RATHER THAN TO THE HAPPY PATH.
//
// Every claim below was chosen because a specific WRONG implementation passes the obvious test. The
// staging surface's characteristic defect is that its wrong answers are well-formed: a candidate that
// dropped a file is a valid manifest, a commit that froze the wrong snapshot is a valid commit, and a
// publication that discarded a concurrent one reports success. So a control that asserts "it worked"
// discriminates nothing here, and each claim states the mutation it is aimed at.

import std.types { Bool, String, List, Int, NonEmptyStr }
import std.minted_identity { MintedId, MintedIdAllocator }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.object_store {
  ObjectStore, ObjectId, empty_store, object_id_eq,
  CorpusManifestEntry, CorpusManifestObjectRef, CorpusManifestTarget,
  CorpusManifestStored, CorpusManifestDuplicatePath, CorpusManifestLocatorCollision,
  store_corpus_manifest,
  SourceStored, SourceLocatorCollision, store_authored_source,
  AuthoredSourceTarget,
  CorpusManifestFound, CorpusManifestAbsent,
  CorpusManifestIsAuthoredSource, CorpusManifestIsSemanticNode,
  find_corpus_manifest_record, find_authored_source_record,
  AuthoredSourceFound, AuthoredSourceAbsent,
  AuthoredSourceIsSemanticNode, AuthoredSourceIsCorpusManifest,
  AuthoredSourceEmpty, AuthoredSourceText,
}
import gunbc.scm.ancestry { RepositoryCommitRef, RootCommit, DescendsFrom }
import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryCommitMinted,
  RepositoryCommitMintAllocatorInvalid,
  RepositoryCommitMintRootIsAuthoredSource,
  RepositoryCommitMintRootIsSemanticNode,
  RepositoryCommitMintRootMissing,
  RepositoryCommitMintParentMissing,
  mint_repository_commit,
  commit_at_reference,
  encode_repository_checked,
  RepositoryEncoded,
  RepositoryEncodeRefused,
  decode_repository,
  RepositoryDecoded,
  RepositoryDecodeRefused,
}
import gunbc.scm.staging {
  StagingRefusal,
  StagePathEmpty,
  StageBaseUnresolved,
  StageManifestMissingFromStore,
  StagingOutcome,
  Staged,
  StagingRefused,
  StagedEntries,
  StagedEntriesRefused,
  staged_entries,
  stage_authored_source,
  StageStanding,
  StageMatchesBase,
  StageDiffersFromBase,
  StageWithNoBase,
  NoCandidateAndNoBase,
  StageStandingRefused,
  stage_standing,
  StagedCommit,
  StagedCommitted,
  NothingToCommit,
  StagedCommitRefused,
  StagedCommitCandidateRefused,
  commit_staged,
}
import gunbc.scm.checkout {
  RepositoryCheckout,
  RepositoryCheckedOut,
  CheckoutWouldDiscardStagedWork,
  CheckoutCandidateUnreadable,
  CheckoutReferenceUnresolved,
  CheckoutSnapshotMissingFromStore,
  CheckoutSnapshotIsAuthoredSource,
  CheckoutSnapshotIsSemanticNode,
  CheckoutCorpusUnrecoverable,
  checkout_repository_at,
  RecoveredSourceFile,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn stg_empty_repository() -> RepositoryEnvelope {
  RepositoryEnvelope {
    store: empty_store(),
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 0 },
    checked_out: none,
    staged: none,
  }
}

// STAGE-THEN-COMMIT AS ONE HELPER, because every specimen below needs a base and building one by hand
// each time would let the specimens drift apart in ways the claims do not mention.
fn stg_staged_or(repository: RepositoryEnvelope, path: String, text: String) -> RepositoryEnvelope {
  match stage_authored_source(repository: repository, path: path, text: text) {
    Staged { repository: next, staged: _ } => next
    StagingRefused { cause: _ } => repository
  }
}

fn stg_committed_or(repository: RepositoryEnvelope, message: String) -> RepositoryEnvelope {
  match commit_staged(repository: repository, message: message) {
    StagedCommitted { repository: next, reference: _ } => next
    NothingToCommit { standing: _ } => repository
    StagedCommitRefused { mint: _ } => repository
    StagedCommitCandidateRefused { cause: _ } => repository
  }
}

// THE ENTRY FOR ONE PATH, READ BACK BY CONTENT RATHER THAN BY COUNT. A count answers "how many
// bindings" and every mutation below preserves the count while changing WHICH bindings; reading the
// bytes through the store is what makes the assertion about the thing the author cares about.
fn stg_text_at(repository: RepositoryEnvelope, path: String) -> String {
  match staged_entries(repository: repository) {
    StagedEntriesRefused { cause: _ } => "<candidate unreadable>"
    StagedEntries { entries: entries } =>
      fold(entries, init: "<not bound>", f: fn(found, e) {
        if (e.path as String) == path {
          match find_authored_source_record(store: repository.store, identity: e.source.locator) {
            AuthoredSourceFound(record) =>
              match record.content {
                AuthoredSourceEmpty => ""
                AuthoredSourceText(t) => t as String
              }
            AuthoredSourceAbsent { identity: _ } => "<source missing>"
            AuthoredSourceIsSemanticNode { identity: _ } => "<source is a node>"
            AuthoredSourceIsCorpusManifest { identity: _ } => "<source is a manifest>"
          }
        } else { found }
      })
  }
}

fn stg_bound_path_count(repository: RepositoryEnvelope) -> Int {
  match staged_entries(repository: repository) {
    StagedEntriesRefused { cause: _ } => 0 - 1
    StagedEntries { entries: entries } => count(entries)
  }
}

// ------------------------------------------------------------------------------------------------
// THE CANDIDATE IS A FULL SNAPSHOT
// ------------------------------------------------------------------------------------------------

// THE CONTROL FOR THE DATA-LOSS DEFECT THIS MODULE SHIPPED AND CORRECTED. Two files are committed;
// ONE of them is then re-staged. The claim is about the file that was NOT touched.
//
// MUTATION IT IS AIMED AT: `manifest_entries_binding` dropping the entries it was given instead of
// binding one path into them, so the candidate becomes only what the last `add` mentioned.
//
// IT IS NOT A CONTROL ON THE INHERITANCE RULE, AND THE FIRST WRITING OF THIS NOTE SAID IT WAS. That
// claim was tested and is false: `commit_candidate` leaves `staged` PRESENT, so this specimen never
// has an absent stage and never reaches `candidate_inherited_from_base` at all. Reverting the
// inheritance rule leaves this claim GREEN -- measured, by running exactly that mutation. The
// inheritance path is reached only where the stage is absent AND a commit is selected, and the claims
// that do reach it are below. Naming a mutation a claim does not discriminate is the inflation DESIGN section 4b forbids,
// arriving in the evidence rather than in the production code.
//
// THE EXPECTED CONTENT IS FIXED BEFORE THE OPERATION, not read back from the same value the mutation
// would change: "B0" is written here as a literal, so a candidate that dropped or replaced b.dag
// cannot agree with it.
test fn scm_stg_a_first_add_over_history_keeps_every_untouched_path() -> Bool {
  let base = stg_committed_or(
    repository: stg_staged_or(
      repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
      path: "b.dag",
      text: "B0",
    ),
    message: "two files",
  )
  let edited = stg_staged_or(repository: base, path: "a.dag", text: "A1")
  stg_text_at(repository: edited, path: "a.dag") == "A1"
    && stg_text_at(repository: edited, path: "b.dag") == "B0"
    && stg_bound_path_count(repository: edited) == 2
}

// THE SAME PROPERTY ACROSS A COMMIT, which is the shape an author actually runs and the one the
// no-clear rule is about. add, commit, add again: the second `add` must extend the corpus the first
// commit froze.
//
// MUTATION IT IS AIMED AT: clearing the candidate on commit. That mutation leaves `status` reporting
// clean -- which is what the correct code reports too, so a status assertion discriminates nothing --
// and shows up here, as the first file vanishing from the second candidate.
//
// A CLEARING MUTATION AND THE INHERITANCE RULE INTERACT, so this claim's discrimination depends on
// which is broken. Clearing `staged` alone leaves the base selected, so the inheritance rule supplies
// the committed snapshot and this claim stays GREEN -- the two states are equivalent, exactly as the
// review predicted. It goes red when clearing is combined with an inheritance that answers empty,
// which is the pair that actually loses the file. Stated because the alternative is to believe this
// claim guards more than it does.
test fn scm_stg_an_add_after_a_commit_extends_the_committed_corpus() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let second = stg_staged_or(repository: first, path: "b.dag", text: "B0")
  stg_text_at(repository: second, path: "a.dag") == "A0"
    && stg_text_at(repository: second, path: "b.dag") == "B0"
    && stg_bound_path_count(repository: second) == 2
}

// THE CONTROL THAT ACTUALLY REACHES THE INHERITANCE RULE, ADDED AFTER MEASURING THAT THE TWO CLAIMS
// ABOVE DO NOT.
//
// The inheritance path needs a stage that is ABSENT while a commit is SELECTED, and neither claim
// above produces one, because committing leaves the stage present.
//
// THIS SPECIMEN CONSTRUCTS THAT SHAPE DIRECTLY, AND THAT IS THE LIMIT OF WHAT IT ESTABLISHES. Two
// ordinary routes also produce it -- a v4 predecessor document, which records no stage at all, and a
// repository just after a clean checkout -- and an earlier wording of this note said this claim
// covered them. It does not: building the post-normalization envelope by hand BYPASSES the decoder
// and the checkout that would produce it, which are exactly the steps such a claim would be about.
// What this one tests is the inheritance rule over an in-memory state, which is worth testing on its
// own and is not a migration control. The decoder route has its own claim below; the checkout route
// is covered by scm_stg_a_clean_checkout_re_derives_the_candidate_from_the_new_base, which obtains
// its state through checkout_repository_at rather than constructing an equivalent envelope.
//
// MUTATION IT IS AIMED AT: `candidate_inherited_from_base` answering the empty corpus. Under it the
// `add` below yields a one-entry candidate, `b.dag` is deleted, and nothing refuses -- which is the
// data-loss defect this module corrected, on the one repository shape that can still reach it.
test fn scm_stg_an_add_with_no_override_inherits_the_selected_commits_corpus() -> Bool {
  let committed = stg_committed_or(
    repository: stg_staged_or(
      repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
      path: "b.dag",
      text: "B0",
    ),
    message: "two files",
  )
  let no_override = RepositoryEnvelope {
    store: committed.store,
    commits: committed.commits,
    commit_allocator: committed.commit_allocator,
    checked_out: committed.checked_out,
    staged: none,
  }
  let edited = stg_staged_or(repository: no_override, path: "a.dag", text: "A1")
  stg_text_at(repository: edited, path: "a.dag") == "A1"
    && stg_text_at(repository: edited, path: "b.dag") == "B0"
    && stg_bound_path_count(repository: edited) == 2
}

// AND READING THAT SAME SHAPE REPORTS CLEAN RATHER THAN EMPTY. An absent override over a selected
// commit denotes that commit's own snapshot, so the derived difference is empty -- and a candidate
// answering the empty corpus there would report every tracked path as staged for deletion.
test fn scm_stg_no_override_over_a_commit_reads_as_clean_not_empty() -> Bool {
  let committed = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let no_override = RepositoryEnvelope {
    store: committed.store,
    commits: committed.commits,
    commit_allocator: committed.commit_allocator,
    checked_out: committed.checked_out,
    staged: none,
  }
  stg_bound_path_count(repository: no_override) == 1
    && stg_text_at(repository: no_override, path: "a.dag") == "A0"
    && match stage_standing(repository: no_override) {
      StageMatchesBase { candidate: _ } => true
      _ => false
    }
    && match commit_staged(repository: no_override, message: "again") {
      NothingToCommit { standing: _ } => true
      _ => false
    }
}

// RE-BINDING A PATH REPLACES ITS BINDING AND DOES NOT DUPLICATE IT. store_corpus_manifest refuses a
// duplicated path, so a `manifest_entries_binding` that appended without displacing would turn an
// ordinary second `add` into a refusal -- which is why the count is asserted beside the content.
test fn scm_stg_staging_one_path_twice_replaces_rather_than_duplicating() -> Bool {
  let once = stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0")
  let twice = stg_staged_or(repository: once, path: "a.dag", text: "A1")
  stg_text_at(repository: twice, path: "a.dag") == "A1" && stg_bound_path_count(repository: twice) == 1
}

// ------------------------------------------------------------------------------------------------
// THE DERIVED DIFFERENCE, AND WHAT COMMIT DOES WITH IT
// ------------------------------------------------------------------------------------------------

// A COMMIT PUBLISHES THE SELECTION, WHICH THE MINT DOES NOT DO. mint_repository_commit preserves
// `checked_out` and returns the new reference without selecting it.
//
// MUTATION IT IS AIMED AT: saving the mint's envelope unchanged. The commit still appears in the log,
// so a history assertion passes; what breaks is that the author is left standing on the old commit,
// and the NEXT commit takes the old parent. Both halves are asserted: the selection resolves to the
// new reference, and that commit's root is the candidate that was staged.
test fn scm_stg_a_commit_leaves_the_author_standing_on_what_they_committed() -> Bool {
  let staged = stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0")
  match commit_staged(repository: staged, message: "first") {
    StagedCommitted { repository: after, reference: reference } =>
      match after.checked_out {
        Absent => false
        Present { value: selected } =>
          selected.identity.ordinal == reference.identity.ordinal
            && match commit_at_reference(commits: after.commits, reference: selected) {
              Absent => false
              Present { value: commit } =>
                match after.staged {
                  Absent => false
                  Present { value: candidate } =>
                    object_id_eq(left: commit.root.locator, right: candidate.locator)
                }
            }
      }
    _ => false
  }
}

// THE SECOND COMMIT DESCENDS FROM THE FIRST, which is the consequence of the selection being
// published and is asserted separately because it is a different fact from the selection itself.
test fn scm_stg_a_second_commit_descends_from_the_first() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let second = stg_committed_or(
    repository: stg_staged_or(repository: first, path: "b.dag", text: "B0"),
    message: "second",
  )
  count(second.commits) == 2
    && match second.checked_out {
      Absent => false
      Present { value: selected } =>
        match commit_at_reference(commits: second.commits, reference: selected) {
          Absent => false
          Present { value: commit } =>
            match commit.ancestry {
              RootCommit => false
              DescendsFrom { parent: parent } =>
                match first.checked_out {
                  Absent => false
                  Present { value: base } => parent.identity.ordinal == base.identity.ordinal
                }
            }
        }
    }
}

// COMMITTING TWICE WITH NOTHING CHANGED IN BETWEEN MINTS NOTHING. Under the inheritance rule an
// absent override denotes the base's own snapshot, so "there is a candidate" and "there is something
// to commit" are different questions.
//
// MUTATION IT IS AIMED AT: committing whenever the stage pointer is present. That mints a commit
// whose root equals its parent's root -- a history row freezing nothing, indistinguishable to a later
// reader from a real one.
test fn scm_stg_committing_an_unchanged_candidate_mints_nothing() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  match commit_staged(repository: first, message: "again") {
    NothingToCommit { standing: standing } =>
      match standing {
        StageMatchesBase { candidate: _ } => count(first.commits) == 1
        _ => false
      }
    _ => false
  }
}

// AN EMPTY REPOSITORY HAS NOTHING TO COMMIT, and it reaches that answer through a DIFFERENT standing
// than the unchanged-candidate case above. Folding the two would lose which of them an operator is in.
test fn scm_stg_an_empty_repository_has_nothing_to_commit() -> Bool {
  match commit_staged(repository: stg_empty_repository(), message: "nothing") {
    NothingToCommit { standing: standing } =>
      match standing {
        NoCandidateAndNoBase => true
        _ => false
      }
    _ => false
  }
}

// A CANDIDATE OVER NO HISTORY IS COMMITTABLE, which is the ordinary first commit and must not be
// confused with the empty case above.
test fn scm_stg_a_candidate_over_no_history_is_the_first_commit() -> Bool {
  let staged = stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0")
  match stage_standing(repository: staged) {
    StageWithNoBase { candidate: _ } =>
      match commit_staged(repository: staged, message: "first") {
        StagedCommitted { repository: after, reference: _ } => count(after.commits) == 1
        _ => false
      }
    _ => false
  }
}

// AN EDIT AFTER A COMMIT IS REPORTED AS A DIFFERENCE, which is the positive control for the standing
// that every "nothing to commit" claim above depends on being distinguishable.
test fn scm_stg_an_edit_after_a_commit_differs_from_its_base() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  match stage_standing(repository: stg_staged_or(repository: first, path: "a.dag", text: "A1")) {
    StageDiffersFromBase { candidate: candidate, committed: committed } =>
      !object_id_eq(left: candidate.locator, right: committed.locator)
    _ => false
  }
}

// ------------------------------------------------------------------------------------------------
// ABSENCE IS NOT DAMAGE, AND DAMAGE IS NOT ABSENCE
// ------------------------------------------------------------------------------------------------

// A BASE THAT CANNOT BE RESOLVED REFUSES RATHER THAN INHERITING THE EMPTY CORPUS.
//
// MUTATION IT IS AIMED AT: answering `[]` when the base cannot be read. That reintroduces the
// deletion through the failure arm -- the absorbing fallback -- and it does it on exactly the
// repository least able to survive it.
test fn scm_stg_an_unresolvable_base_refuses_rather_than_inheriting_nothing() -> Bool {
  let dangling = RepositoryEnvelope {
    store: empty_store(),
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 4 },
    checked_out: Present { value: RepositoryCommitRef { identity: MintedId { ordinal: 2 } } },
    staged: none,
  }
  match staged_entries(repository: dangling) {
    StagedEntriesRefused { cause: cause } =>
      match cause {
        StageBaseUnresolved { reference: reference } => reference.identity.ordinal == 2
        _ => false
      }
    StagedEntries { entries: _ } => false
  }
}

// AND STAGING OVER IT REFUSES TOO, rather than starting a fresh corpus on top of a repository whose
// history it could not read.
test fn scm_stg_staging_over_an_unresolvable_base_refuses() -> Bool {
  let dangling = RepositoryEnvelope {
    store: empty_store(),
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 4 },
    checked_out: Present { value: RepositoryCommitRef { identity: MintedId { ordinal: 2 } } },
    staged: none,
  }
  match stage_authored_source(repository: dangling, path: "a.dag", text: "A0") {
    StagingRefused { cause: StageBaseUnresolved { reference: _ } } => true
    _ => false
  }
}

// THE EMPTY PATH REFUSES AND IS NOT ADMITTED AS A NAME.
test fn scm_stg_the_empty_path_refuses() -> Bool {
  match stage_authored_source(repository: stg_empty_repository(), path: "", text: "A0") {
    StagingRefused { cause: StagePathEmpty } => true
    _ => false
  }
}

// AN EMPTY FILE IS STAGEABLE AND IS NOT THE SAME AS NO FILE. AuthoredSourceEmpty is a real content
// with its own identity, so a path bound to it is bound.
test fn scm_stg_an_empty_file_stages_as_itself() -> Bool {
  let staged = stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "")
  stg_text_at(repository: staged, path: "a.dag") == "" && stg_bound_path_count(repository: staged) == 1
}

// ------------------------------------------------------------------------------------------------
// MOVING THE BASE
// ------------------------------------------------------------------------------------------------

// CHECKING OUT ANOTHER COMMIT WITH WORK STAGED REFUSES.
//
// MUTATION IT IS AIMED AT: the `staged: none` this function used to carry unconditionally. Under it
// the checkout succeeds and the author's uncommitted candidate is gone, with no refusal and no
// report. The refusal names both manifests, which is what makes it actionable rather than merely
// loud.
test fn scm_stg_a_checkout_that_would_discard_staged_work_refuses() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let second = stg_committed_or(
    repository: stg_staged_or(repository: first, path: "b.dag", text: "B0"),
    message: "second",
  )
  let dirty = stg_staged_or(repository: second, path: "c.dag", text: "C0")
  match first.checked_out {
    Absent => false
    Present { value: back_to_first } =>
      match checkout_repository_at(repo: dirty, reference: back_to_first) {
        CheckoutWouldDiscardStagedWork { reference: r, candidate: _, committed: committed } =>
          r.identity.ordinal == back_to_first.identity.ordinal
            && match committed {
              Present { value: _ } => true
              Absent => false
            }
        _ => false
      }
  }
}

// A CLEAN CHECKOUT IS ADMITTED AND NORMALIZES THE OVERRIDE, so the candidate re-derives from the new
// base rather than continuing to denote the old one. This is the positive control for the refusal
// above: without it, a checkout that refused EVERYTHING would satisfy that claim.
//
// THE ASSERTION IS ABOUT THE NEW BASE'S CONTENT, not merely that the checkout succeeded. After
// returning to the first commit the candidate must bind `a.dag` and must NOT bind `b.dag`.
test fn scm_stg_a_clean_checkout_re_derives_the_candidate_from_the_new_base() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let second = stg_committed_or(
    repository: stg_staged_or(repository: first, path: "b.dag", text: "B0"),
    message: "second",
  )
  match first.checked_out {
    Absent => false
    Present { value: back_to_first } =>
      match checkout_repository_at(repo: second, reference: back_to_first) {
        RepositoryCheckedOut { repository: moved, corpus: _ } =>
          stg_bound_path_count(repository: moved) == 1
            && stg_text_at(repository: moved, path: "a.dag") == "A0"
            && stg_text_at(repository: moved, path: "b.dag") == "<not bound>"
            && match stage_standing(repository: moved) {
              StageMatchesBase { candidate: _ } => true
              _ => false
            }
        _ => false
      }
  }
}

// AND COMMITTING AFTER THAT CHECKOUT DOES NOT REVERT. This is the sequence the checkout rule exists
// for, run to its end: without the rule the retained candidate freezes the OLD snapshot on top of the
// new base, and every intermediate observation looks healthy.
test fn scm_stg_a_commit_after_moving_the_base_does_not_revert_it() -> Bool {
  let first = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  let second = stg_committed_or(
    repository: stg_staged_or(repository: first, path: "b.dag", text: "B0"),
    message: "second",
  )
  match first.checked_out {
    Absent => false
    Present { value: back_to_first } =>
      match checkout_repository_at(repo: second, reference: back_to_first) {
        RepositoryCheckedOut { repository: moved, corpus: _ } =>
          match commit_staged(repository: moved, message: "should mint nothing") {
            NothingToCommit { standing: _ } => count(moved.commits) == 2
            _ => false
          }
        _ => false
      }
  }
}

// ------------------------------------------------------------------------------------------------
// THE CANDIDATE SURVIVES THE DOCUMENT
// ------------------------------------------------------------------------------------------------

// A STAGED CANDIDATE SURVIVES ENCODING AND DECODING WITH ITS BINDINGS INTACT. Staging that does not
// persist is not staging: `add` and `commit` are separate invocations, so a candidate that lived only
// in memory would be gone before it could be committed.
//
// THE ASSERTION IS ON THE DECODED VALUE, not on the encoder's input -- comparing the envelope to
// itself would pass under any codec at all.
test fn scm_stg_a_staged_candidate_survives_a_document_round_trip() -> Bool {
  let staged = stg_staged_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    path: "b.dag",
    text: "B0",
  )
  match encode_repository_checked(repo: staged) {
    RepositoryEncodeRefused { cause: _ } => false
    RepositoryEncoded { value: wire } =>
      match decode_repository(v: wire) {
        RepositoryDecodeRefused { cause: _ } => false
        RepositoryDecoded { envelope: restored } =>
          stg_bound_path_count(repository: restored) == 2
            && stg_text_at(repository: restored, path: "a.dag") == "A0"
            && stg_text_at(repository: restored, path: "b.dag") == "B0"
            && match restored.staged {
              Absent => false
              Present { value: restored_candidate } =>
                match staged.staged {
                  Absent => false
                  Present { value: original } =>
                    object_id_eq(left: restored_candidate.locator, right: original.locator)
                }
            }
      }
  }
}

// AN ABSENT CANDIDATE SURVIVES AS ABSENT, which is the control that the round trip above is reading a
// member rather than reconstructing one. A codec that always produced a candidate would pass the
// previous claim and fail this one.
test fn scm_stg_an_absent_candidate_survives_as_absent() -> Bool {
  match encode_repository_checked(repo: stg_empty_repository()) {
    RepositoryEncodeRefused { cause: _ } => false
    RepositoryEncoded { value: wire } =>
      match decode_repository(v: wire) {
        RepositoryDecodeRefused { cause: _ } => false
        RepositoryDecoded { envelope: restored } =>
          match restored.staged {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

// A COMMITTED REPOSITORY ROUND-TRIPS WITH ITS SELECTION AND ITS CANDIDATE STILL AGREEING, which is
// the persisted form of the no-clear rule: the clean answer must survive the document, not merely
// hold in the envelope that produced it.
test fn scm_stg_a_committed_repository_reads_back_clean() -> Bool {
  let committed = stg_committed_or(
    repository: stg_staged_or(repository: stg_empty_repository(), path: "a.dag", text: "A0"),
    message: "first",
  )
  match encode_repository_checked(repo: committed) {
    RepositoryEncodeRefused { cause: _ } => false
    RepositoryEncoded { value: wire } =>
      match decode_repository(v: wire) {
        RepositoryDecodeRefused { cause: _ } => false
        RepositoryDecoded { envelope: restored } =>
          match stage_standing(repository: restored) {
            StageMatchesBase { candidate: _ } => stg_text_at(repository: restored, path: "a.dag") == "A0"
            _ => false
          }
      }
  }
}

test fn scm_staging_witness_suite() -> Bool {
  scm_stg_a_first_add_over_history_keeps_every_untouched_path() &&
  scm_stg_an_add_after_a_commit_extends_the_committed_corpus() &&
  scm_stg_an_add_with_no_override_inherits_the_selected_commits_corpus() &&
  scm_stg_no_override_over_a_commit_reads_as_clean_not_empty() &&
  scm_stg_staging_one_path_twice_replaces_rather_than_duplicating() &&
  scm_stg_a_commit_leaves_the_author_standing_on_what_they_committed() &&
  scm_stg_a_second_commit_descends_from_the_first() &&
  scm_stg_committing_an_unchanged_candidate_mints_nothing() &&
  scm_stg_an_empty_repository_has_nothing_to_commit() &&
  scm_stg_a_candidate_over_no_history_is_the_first_commit() &&
  scm_stg_an_edit_after_a_commit_differs_from_its_base() &&
  scm_stg_an_unresolvable_base_refuses_rather_than_inheriting_nothing() &&
  scm_stg_staging_over_an_unresolvable_base_refuses() &&
  scm_stg_the_empty_path_refuses() &&
  scm_stg_an_empty_file_stages_as_itself() &&
  scm_stg_a_checkout_that_would_discard_staged_work_refuses() &&
  scm_stg_a_clean_checkout_re_derives_the_candidate_from_the_new_base() &&
  scm_stg_a_commit_after_moving_the_base_does_not_revert_it() &&
  scm_stg_a_staged_candidate_survives_a_document_round_trip() &&
  scm_stg_an_absent_candidate_survives_as_absent() &&
  scm_stg_a_committed_repository_reads_back_clean()
}
