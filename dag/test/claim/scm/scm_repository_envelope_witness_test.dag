}
import gunbc.scm.commit_closure { table_unresolved_identities }
import gunbc.scm.ancestry { CommitAncestry, RootCommit, DescendsFrom, RepositoryCommitRef }
import gunbc.scm.repository_envelope {
  RepositoryEnvelope, RepositoryCommit,
  RepositoryDecodeOutcome, RepositoryDecoded, RepositoryDecodeRefused,
  empty_repository, encode_repository, decode_repository,
  repository_envelope_format_tag, repository_object_identity_rule_tag,
  RepositoryEncodeOutcome, RepositoryEncoded, RepositoryEncodeRefused,
  RepositoryEncodeRefusal, RepositoryEncodeUncontainedTarget, RepositoryEncodeTargetIsAuthoredSource,
  RepositoryEncodeCommitRootIsAuthoredSource,
  RepositoryEncodeTargetIsCorpusManifest,
