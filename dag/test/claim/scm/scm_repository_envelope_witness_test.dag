module test.claim.scm_repository_envelope_witness

// The repository envelope, executed. What is under test is the layer commit_closure_json_v2 deliberately is not:
// an empty initialized repository with NO root, several commits over ONE shared node population, and
// a checked-out selection that may be absent but may never dangle.
//
// The identity claims matter most. Commit identity is never stored -- it is the root object's
// identity, re-derived from structure on load -- so the round-trip claims assert on the derived
// commit id, not on bytes and not on a stored field, because there is no stored field to assert on.

import std.types { Bool, Int, List, String, NonEmptyStr, list_length }
import std.minted_identity { MintedId, MintedIdAllocator }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

