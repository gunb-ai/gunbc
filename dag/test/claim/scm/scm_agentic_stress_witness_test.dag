module test.claim.scm_agentic_stress_witness

import extdeps.pricing.object_storage {
  AwsS3,
  CloudflareR2,
  Storj,
  Wasabi,
  ByteBasisUnstated,
  DecimalGigabyte,
  r2_class_a_operations,
  r2_class_b_operations,
  r2_egress_free,
  r2_standard,
  s3_egress_first_10tb,
  s3_egress_next_100tb,
  s3_egress_next_40tb,
  s3_egress_over_150tb,
  s3_standard_first_50tb,
  s3_standard_next_450tb,
  s3_standard_over_500tb,
  s3_tier1_requests,
  s3_tier2_requests,
  storj_egress,
  storj_standard_storage,
  wasabi_egress_free,
  wasabi_hot_storage,
}
import gunbc.econ.scm_serving_model {
  BasisAssumed,
  PackedObjects,
  ProviderQuote,
  RequestsBilled,
  RequestsIncludedAtNoCharge,
  ScmWorkloadProfile,
  UnpackedNodeGrain,
  packed_object_count,
  profile_at_user_count,
  profile_with_packed_ops,
  quote_operations_micros,
  quote_provider_monthly,
  quote_total_micros,
}
import std.measure { byte_size }
import std.nat { Nat }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data stress_note: String = "Stressing the profile toward agent-driven development, because the human-authored numbers load the wrong axis. Human baseline: 200 object reads and 20 writes per user-month. Agent-autonomous baseline below: 2,000,000 logical NODE reads and 200,000 node writes per user-month -- four orders of magnitude, which is roughly one agent working continuously at a few thousand node reads an hour, and still conservative for a fleet of agents. Storage and egress are also raised (500 MB held, 2 GB moved) but only by single-digit multiples, because dedup flattens what agents store far more than it flattens what they touch. The finding this witness pins: at these rates operations stop being a rounding error and become the entire bill on request-metered vendors, which INVERTS the provider ranking computed on the human profile."

data stress_basis_assumption: ByteBasisAssumption = BasisAssumed {
  basis: DecimalGigabyte,
  rationale: "Same declared basis as the human-profile matrix so the two are comparable; none of these vendors states one.",
}

data human_profile_10k: ScmWorkloadProfile = ScmWorkloadProfile {
  user_count: 10000,
  stored_bytes_per_user_after_dedup: byte_size(count: 100000000),
  monthly_egress_bytes_per_user: byte_size(count: 500000000),
  monthly_object_reads_per_user: 200,
  monthly_object_writes_per_user: 20,
}

data agentic_base_10k: ScmWorkloadProfile = ScmWorkloadProfile {
  user_count: 10000,
  stored_bytes_per_user_after_dedup: byte_size(count: 500000000),
  monthly_egress_bytes_per_user: byte_size(count: 2000000000),
  monthly_object_reads_per_user: 0,
  monthly_object_writes_per_user: 0,
}

data agentic_logical_node_reads_per_user: Nat = 2000000

data agentic_logical_node_writes_per_user: Nat = 200000

data agentic_unpacked_10k: ScmWorkloadProfile = profile_with_packed_ops(
  base: agentic_base_10k,
  logical_node_reads_per_user: agentic_logical_node_reads_per_user,
  logical_node_writes_per_user: agentic_logical_node_writes_per_user,
  policy: UnpackedNodeGrain,
)

data agentic_packed_10k: ScmWorkloadProfile = profile_with_packed_ops(
  base: agentic_base_10k,
  logical_node_reads_per_user: agentic_logical_node_reads_per_user,
  logical_node_writes_per_user: agentic_logical_node_writes_per_user,
  policy: PackedObjects { nodes_per_object: 1000 },
)

data aws_quote: ProviderQuote = ProviderQuote {
  vendor: AwsS3,
  quote_label: "AWS S3 Standard, us-east-1",
  storage_rows: [s3_standard_first_50tb, s3_standard_next_450tb, s3_standard_over_500tb],
  egress_rows: [s3_egress_first_10tb, s3_egress_next_40tb, s3_egress_next_100tb, s3_egress_over_150tb],
  requests: RequestsBilled { read_row: s3_tier2_requests, write_row: s3_tier1_requests },
  quoted_basis: ByteBasisUnstated,
}

data r2_quote: ProviderQuote = ProviderQuote {
  vendor: CloudflareR2,
  quote_label: "Cloudflare R2 Standard",
  storage_rows: [r2_standard],
  egress_rows: [r2_egress_free],
  requests: RequestsBilled { read_row: r2_class_b_operations, write_row: r2_class_a_operations },
  quoted_basis: ByteBasisUnstated,
}

data wasabi_quote: ProviderQuote = ProviderQuote {
  vendor: Wasabi,
  quote_label: "Wasabi Hot Cloud Storage (pay as you go)",
  storage_rows: [wasabi_hot_storage],
  egress_rows: [wasabi_egress_free],
  requests: RequestsIncludedAtNoCharge { terms: "No fees for egress or API requests." },
  quoted_basis: ByteBasisUnstated,
}

data storj_quote: ProviderQuote = ProviderQuote {
  vendor: Storj,
  quote_label: "Storj Standard (distributed)",
  storage_rows: [storj_standard_storage],
  egress_rows: [storj_egress],
  requests: RequestsIncludedAtNoCharge { terms: "No API fees." },
  quoted_basis: ByteBasisUnstated,
}

fn total_for(quote: ProviderQuote, profile: ScmWorkloadProfile) -> Nat? {
  quote_total_micros(
    result: quote_provider_monthly(profile: profile, quote: quote, assumption: stress_basis_assumption)
  )
}

fn ops_for(quote: ProviderQuote, profile: ScmWorkloadProfile) -> Nat? {
  quote_operations_micros(
    result: quote_provider_monthly(profile: profile, quote: quote, assumption: stress_basis_assumption)
  )
}

fn w_total_equals(quote: ProviderQuote, profile: ScmWorkloadProfile, expected: Nat) -> Bool {
  match total_for(quote: quote, profile: profile) {
    Present { value: t } => t == expected
    _ => false
  }
}

test fn w_packing_divides_the_operation_count() -> Bool {
  (packed_object_count(logical_node_ops: 2000000, policy: UnpackedNodeGrain) == 2000000)
    && (packed_object_count(logical_node_ops: 2000000, policy: PackedObjects { nodes_per_object: 1000 }) == 2000)
    && (packed_object_count(logical_node_ops: 1, policy: PackedObjects { nodes_per_object: 1000 }) == 1)
    && (agentic_unpacked_10k.monthly_object_reads_per_user == 2000000)
    && (agentic_packed_10k.monthly_object_reads_per_user == 2000)
}

test fn w_agentic_unpacked_bills_at_agentic_magnitudes() -> Bool {
  w_total_equals(quote: r2_quote, profile: agentic_unpacked_10k, expected: 16275000000)
    && w_total_equals(quote: aws_quote, profile: agentic_unpacked_10k, expected: 19866200000)
    && w_total_equals(quote: storj_quote, profile: agentic_unpacked_10k, expected: 175000000)
    && w_total_equals(quote: wasabi_quote, profile: agentic_unpacked_10k, expected: 39950000)
}

test fn w_operations_become_essentially_the_whole_request_metered_bill() -> Bool {
  match ops_for(quote: r2_quote, profile: agentic_unpacked_10k) {
    Present { value: ops } =>
      match total_for(quote: r2_quote, profile: agentic_unpacked_10k) {
        Present { value: total } => (ops * 100) > (total * 99)
        _ => false
      }
    _ => false
  }
}

test fn w_operations_are_a_rounding_error_on_the_human_profile() -> Bool {
  match ops_for(quote: r2_quote, profile: human_profile_10k) {
    Present { value: ops } =>
      match total_for(quote: r2_quote, profile: human_profile_10k) {
        Present { value: total } => (ops * 10) < total
        _ => false
      }
    _ => false
  }
}

test fn w_ranking_inverts_between_human_and_agentic_profiles() -> Bool {
  match total_for(quote: r2_quote, profile: human_profile_10k) {
    Present { value: r2_human } =>
      match total_for(quote: storj_quote, profile: human_profile_10k) {
        Present { value: storj_human } =>
          match total_for(quote: r2_quote, profile: agentic_unpacked_10k) {
            Present { value: r2_agentic } =>
              match total_for(quote: storj_quote, profile: agentic_unpacked_10k) {
                Present { value: storj_agentic } =>
                  (r2_human < storj_human) && (r2_agentic > storj_agentic)
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn w_no_request_fee_vendors_win_by_two_orders_of_magnitude() -> Bool {
  match total_for(quote: wasabi_quote, profile: agentic_unpacked_10k) {
    Present { value: wasabi } =>
      match total_for(quote: r2_quote, profile: agentic_unpacked_10k) {
        Present { value: r2 } =>
          match total_for(quote: aws_quote, profile: agentic_unpacked_10k) {
            Present { value: aws } =>
              ((wasabi * 400) < r2) && ((wasabi * 400) < aws)
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn w_packing_collapses_the_request_metered_bill() -> Bool {
  w_total_equals(quote: r2_quote, profile: agentic_packed_10k, expected: 91200000)
    && match total_for(quote: r2_quote, profile: agentic_unpacked_10k) {
      Present { value: unpacked } =>
        match total_for(quote: r2_quote, profile: agentic_packed_10k) {
          Present { value: packed } =>
            (unpacked > (packed * 150)) && (unpacked < (packed * 200))
          _ => false
        }
      _ => false
    }
}

test fn w_packing_leaves_the_byte_axes_untouched() -> Bool {
  (agentic_packed_10k.stored_bytes_per_user_after_dedup == agentic_unpacked_10k.stored_bytes_per_user_after_dedup)
    && (agentic_packed_10k.monthly_egress_bytes_per_user == agentic_unpacked_10k.monthly_egress_bytes_per_user)
}

test fn w_agentic_at_one_million_users_is_a_seven_figure_bill_unpacked() -> Bool {
  match total_for(quote: r2_quote, profile: profile_at_user_count(profile: agentic_unpacked_10k, user_count: 1000000)) {
    Present { value: r2 } =>
      match total_for(quote: wasabi_quote, profile: profile_at_user_count(profile: agentic_unpacked_10k, user_count: 1000000)) {
        Present { value: wasabi } =>
          (r2 == 1627500000000) && (wasabi == 3995000000) && (r2 > (wasabi * 400))
        _ => false
      }
    _ => false
  }
}

test fn w_red_packing_by_one_is_the_unpacked_count() -> Bool {
  packed_object_count(logical_node_ops: 2000000, policy: PackedObjects { nodes_per_object: 1 }) == 2000000
}

test fn w_red_agentic_profile_is_not_the_human_profile() -> Bool {
  match total_for(quote: r2_quote, profile: human_profile_10k) {
    Present { value: human } =>
      match total_for(quote: r2_quote, profile: agentic_unpacked_10k) {
        Present { value: agentic } => agentic > (human * 900)
        _ => false
      }
    _ => false
  }
}

