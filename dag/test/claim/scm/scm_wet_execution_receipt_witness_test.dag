module test.claim.scm.scm_wet_execution_receipt_witness

import std.decl_ref { decl_ref }
import std.types { Bool, Int, NonEmptyStr, String }
import gunbc.roadmap_authority { declared_roadmap_nodes }
import gunbc.roadmap_model { RoadmapNodeIdentity }
import gunbc.scm.scm_wet_execution_receipt {
  ScmWetExecutionAccepted,
  ScmWetExecutionRefused,
  scm_acceptance_wet_execution_receipt,
}
import tools.scm_acceptance { scm_acceptance }

// THE SUBJECT MUST JOIN A DECLARED NODE, because a receipt whose node identity matches nothing is
// evidence filed against a row that does not exist -- and the identity is the durable one rather
// than the slug precisely so a rename cannot orphan it. The fabricated-identity control is what
// makes the positive claim discriminating: without it, a join that matched everything would pass.
fn declared_nodes_carrying_identity(identity: String) -> Int {
  declared_roadmap_nodes()
    |> filter(n => (n.identity as String) == identity)
    |> count
}

test fn wet_receipt_subject_joins_exactly_one_declared_roadmap_node() -> Bool {
  let receipt = scm_acceptance_wet_execution_receipt()
  return declared_nodes_carrying_identity(
    identity: receipt.partial_evidence.node as String,
  ) == 1
}

test fn a_fabricated_wet_subject_identity_joins_no_declared_node() -> Bool {
  return declared_nodes_carrying_identity(identity: "rn_NOT_A_DECLARED_NODE_IDENTITY") == 0
}

// THE CITATION MUST NAME THE SYMBOL THIS MODULE IMPORTS, not a string that merely looks like it.
// The import above is what makes the claim real: if the instrument's entry is renamed or moved, the
// import fails to resolve and this file stops compiling, which is a louder failure than a stale
// string comparison would ever produce.
test fn wet_receipt_cites_the_executed_instrument_symbol() -> Bool {
  let receipt = scm_acceptance_wet_execution_receipt()
  let cited = receipt.partial_evidence.executed_evidence
  return cited.module_path == "tools.scm_acceptance"
    && cited.decl_name == "scm_acceptance"
}

// THE LAUNCHER DIGEST PAIR HAS NO NAMED STANDING, AND THAT ABSENCE IS THE CLAIM. An earlier
// revision of this file asserted ExecutableStableAcrossRun over equal endpoints, with a planted
// A/B pair as its red. Both were green and the derivation was unsound: equal endpoints cannot
// exclude an A-then-B-then-A replacement across a sixty-one minute run, so the arm named absence
// of mid-run replacement from two samples that cannot establish it -- the same defect as the
// TransitionEvidenceStanding fold this change deletes, committed in the act of deleting it. Found
// by external review. The digests stay on the provenance as two observations; a consumer that
// wants endpoint equality compares them and gets exactly that.
//
// THE CANONICAL COMMAND IS ASSERTED INSTEAD, because the invocation identity is what the roadmap
// row required alongside the toolchain fields, and a receipt that names the semantic entry through
// executed_evidence still does not say how it was launched.
test fn the_recorded_invocation_names_the_executed_entry_and_function() -> Bool {
  let receipt = scm_acceptance_wet_execution_receipt()
  let command = receipt.provenance.canonical_command as String
  return contains(haystack: command, needle: "dag/gunbc/instruments/scm_acceptance.dag")
    && contains(haystack: command, needle: "--function scm_acceptance")
}

// THE RECEIPT RECORDS AN ACCEPTED RUN, and the arm carries no exit code because success has nothing
// to compare. The refusal arm is matched here so that a later edit flipping the inhabitant to a
// refusal cannot pass this file unnoticed.
test fn the_recorded_wet_outcome_is_the_accepting_arm() -> Bool {
  let receipt = scm_acceptance_wet_execution_receipt()
  match receipt.provenance.outcome {
    ScmWetExecutionAccepted => true
    ScmWetExecutionRefused { exit_code: _ } => false
  }
}
