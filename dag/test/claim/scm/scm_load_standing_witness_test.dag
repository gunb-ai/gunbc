module test.claim.scm_load_standing_witness

// THE STANDING THAT COULD NOT EXIST, AND NOW HAS A PRODUCER.
//
// The predecessor format had no mechanism that could yield "loaded, and here is what is missing" --
// a position denotes nothing outside its own document, so an unresolved reference was damage and a
// fetchable-absence standing would have been an INVENTED ARM. These witnesses execute the arm end to
// end, which is the difference between a disposition that exists and one that is merely declared.
//
// Each test pairs a cause with a cause that MUST land elsewhere. A classifier that collapsed
// everything onto one standing would satisfy any single-arm assertion and is caught only here.

import std.types { Bool, Int, List }
import v2.std.node { Node, Edge, Named, Conj, Atom, TypeNode, node_synthetic }
import gunbc.scm.object_store {
  ObjectId, ObjectStore, StoreOutcome, Stored, LocatorCollision,
  SemanticNodeTarget, node_target_locator,
  CopyOutcome, Copied, CopySourceAbsent, CopyLocatorCollision,
  empty_store, copy_object, store_node,
}
import gunbc.scm.load_standing {
  LoadStanding, LoadComplete, LoadPartial, LoadUnsupportedProtocol,
  LoadDocumentMalformed, LoadIdentityCollision, LoadRequiresNodeAtAuthoredSource,
  standing_loaded,
}
import std.decl_ref { DeclarationRef }
import gunbc.scm.supersession {
  HeadSlot, SupersessionApplied, SupersessionRefused,
  observe_generation, supersede_head_slot, supersession_applied,
}
import gunbc.scm.json_member {
  MemberReadRefusal, MemberReadSubjectNotObject, MemberReadMissing,
  MemberReadDuplicated, MemberReadWrongShape,
}
import gunbc.scm.target_reference { TargetReferenceNotOneArm, TargetReferenceMemberReadRefused }
import gunbc.scm.object_table_json {
  ObjectTableUnknownKindTag,
  ObjectTableEdgeTargetUnresolved,
  ObjectTableObjectCollision,
  object_table_load_standing,
}
import gunbc.scm.repository_envelope {
  RepositoryFormatUnrecognized,
  RepositoryTargetReferenceRefused,
  RepositoryMemberReadRefused,
  RepositoryIdentityRuleUnrecognized,
  RepositoryUnexpectedMember,
  RepositoryEnvelopeMembers,
  RepositoryCommitRootReferenceUnresolved,
  repository_envelope_load_standing,
}
import gunbc.scm.commit_closure_json_v2 {
  ClosureDocRefusal, ClosureDocFormatUnrecognized, ClosureDocObjectTableRefused,
  ClosureDocMemberReadRefused,
  ClosureDocUnexpectedMember, ClosureDocEnvelopeMembers,
  ClosureDocTargetReferenceRefused,
  closure_document_load_standing, loaded_closure_standing,
}

fn ls_child() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^load_standing_child } }, children: [])
}

fn ls_parent() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Named { name: ^only_child }, target: ls_child() }],
  )
}

type LsBuilt { store: ObjectStore, root: SemanticNodeTarget }

fn ls_full() -> LsBuilt {
  match store_node(store: empty_store(), n: ls_child()) {
    LocatorCollision { identity: i, existing: _, incoming: _ } =>
      LsBuilt { store: empty_store(), root: SemanticNodeTarget { locator: i } }
    Stored { store: s1, node: _ } =>
      match store_node(store: s1, n: ls_parent()) {
        LocatorCollision { identity: i, existing: _, incoming: _ } =>
          LsBuilt { store: empty_store(), root: SemanticNodeTarget { locator: i } }
        Stored { store: s2, node: p } => LsBuilt { store: s2, root: node_target_of(reference: p) }
      }
  }
}

fn ls_grafted() -> ObjectStore {
  let full = ls_full()
  match copy_object(
    from: full.store,
    to: empty_store(),
    identity: node_target_locator(target: full.root),
  ) {
    Copied { store: s, reference: _ } => s
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
  }
}


// THE PERMISSION ARM IS NO LONGER A PREDICATE, so these witnesses drive the real actuator and read
// its verdict. Everything but the standing is held at its admitting value -- same slot, evidence
// examined exactly the generation the slot holds, proposal different from it -- so the only variable
// left is the standing, which is what the three tests below vary. A helper that also varied the
// generation would report false for the wrong reason (DESIGN: a control that does not flip).
fn ls_slot() -> HeadSlot {
  HeadSlot { slot: "head", generation: node_target_locator(target: ls_full().root) }
}

fn ls_other_generation() -> ObjectId {
  ls_child_identity()
}

fn ls_child_identity() -> ObjectId {
  match store_node(store: empty_store(), n: ls_child()) {
    Stored { store: _, node: n } => n.locator
    LocatorCollision { identity: i, existing: _, incoming: _ } => i
  }
}

fn ls_permits(standing: LoadStanding) -> Bool {
  let slot = ls_slot()
  supersession_applied(
    outcome: supersede_head_slot(
      slot: slot,
      evidence: observe_generation(
        slot: slot,
        examined_root: slot.generation,
        schema_identity: "gunbc-scm-commit-closure-v3",
        standing: standing,
        authority: decl_ref(
          module_path: "test.claim.scm_load_standing_witness",
          decl_name: "ls_permits",
        ),
      ),
      proposed_generation: ls_other_generation(),
    )
  )
}

fn standing_eq(a: LoadStanding, b: LoadStanding) -> Bool {
  standing_tag(s: a) == standing_tag(s: b)
}

fn standing_tag(s: LoadStanding) -> Int {
  match s {
    LoadComplete => 0
    LoadPartial => 1
    LoadUnsupportedProtocol => 2
    LoadDocumentMalformed => 3
    LoadIdentityCollision => 4
    LoadRequiresNodeAtAuthoredSource => 5
  }
}

// THE ARM THE RECUT EXISTS FOR. A grafted root lacks its child, so the load succeeds and the standing
// is PARTIAL -- a success with an obligation, not a failure. The pairing against LoadComplete is what
// makes it discriminating: a classifier answering Partial for everything would pass a lone assertion.
test fn an_incomplete_closure_loads_partial_and_a_complete_one_does_not() -> Bool {
  let full = ls_full()
  let partial = loaded_closure_standing(store: ls_grafted(), root: full.root)
  let complete = loaded_closure_standing(store: full.store, root: full.root)
  standing_eq(a: partial, b: LoadPartial)
    && standing_eq(a: complete, b: LoadComplete)
    && standing_loaded(standing: partial)
    && standing_loaded(standing: complete)
}

// A PARTIAL LOAD IS CORRECT AND DELIBERATELY INCOMPLETE, so superseding it would discard a valid
// delta for doing exactly what it was asked to do. This is the arm that did not exist to be got
// wrong before, and it is the one most likely to be got wrong now by treating "not everything" as
// "damaged".
test fn a_partial_load_is_never_supersedable() -> Bool {
  !ls_permits(standing: LoadPartial)
    && !ls_permits(standing: LoadComplete)
}

// MALFORMED IS THE SOLE SUPERSEDABLE STANDING, and the three refusals are refused for three
// different reasons rather than by one rule. If this were the empty set the negative tests above
// would pass vacuously.
test fn malformed_is_the_only_standing_that_permits_replacement() -> Bool {
  ls_permits(standing: LoadDocumentMalformed)
    && !ls_permits(standing: LoadUnsupportedProtocol)
    && !ls_permits(standing: LoadIdentityCollision)
    && !standing_loaded(standing: LoadDocumentMalformed)
}

// ONLY A NAMED-BUT-ABSENT PROTOCOL MEANS THE WRITER MAY BE NEWER; a matched tag carrying an
// unrecognized member or variant is a BROKEN DOCUMENT OF THIS SCHEMA, because this format's own
// policy is that a schema which grows a member grows a new tag. Pairing them is the whole test.
test fn only_an_unrecognized_format_is_a_protocol_gap() -> Bool {
  let protocol = closure_document_load_standing(cause: ClosureDocFormatUnrecognized { found: "v9" })
  let member = closure_document_load_standing(
    cause: ClosureDocUnexpectedMember { context: ClosureDocEnvelopeMembers, key: "provenance" }
  )
  let tag = object_table_load_standing(cause: ObjectTableUnknownKindTag { found: "quantum" })
  standing_eq(a: protocol, b: LoadUnsupportedProtocol)
    && standing_eq(a: member, b: LoadDocumentMalformed)
    && standing_eq(a: tag, b: LoadDocumentMalformed)
}

// AN UNRESOLVED POSITION IS MALFORMED, NOT A FETCHABLE ABSENCE. A position denotes nothing outside
// its own document, so nobody could supply what it names. Fetchable absence is the UNCONTAINED arm,
// which is not a refusal and never reaches this classifier at all.
test fn an_unresolved_position_is_malformed_not_fetchable() -> Bool {
  standing_eq(
    a: object_table_load_standing(cause: ObjectTableEdgeTargetUnresolved { reference: "7" }),
    b: LoadDocumentMalformed
  )
    && standing_eq(
      a: closure_document_load_standing(
        cause: ClosureDocTargetReferenceRefused { cause: TargetReferenceNotOneArm { found: 2 } }
      ),
      b: LoadDocumentMalformed
    )
}

// THE DATA-LOSS GUARD. object_store rules both colliding records legitimate, so a collision means
// the structural locator cannot represent both -- not that either is damaged. Classifying it as
// malformed would let a reader discard a writer's valid generation over an honest hash coincidence.
test fn an_honest_collision_is_its_own_standing_and_never_supersedes() -> Bool {
  let collision = closure_document_load_standing(
    cause: ClosureDocObjectTableRefused {
      cause: ObjectTableObjectCollision { identity: node_target_locator(target: ls_full().root) }
    }
  )
  let malformed = closure_document_load_standing(
    cause: ClosureDocMemberReadRefused { cause: MemberReadSubjectNotObject }
  )
  standing_eq(a: collision, b: LoadIdentityCollision)
    && standing_eq(a: malformed, b: LoadDocumentMalformed)
    && !ls_permits(standing: collision)
    && ls_permits(standing: malformed)
}

// THE THIRD FORMAT NOW CLASSIFIES ITS OWN REFUSALS, and until this landed it did not. gunbc#9258
// made the destination proof-bearing; auditing every PRODUCER reaching it found the repository
// envelope had no classifier at all, so a consumer holding a RepositoryDecodeRefusal had to reach
// into that format's error enum and assign a standing itself -- one format's vocabulary answering a
// format-agnostic question, which is the placement defect that closed gunbc#8940. A missing
// classifier fails silently: nothing refuses, the consumer simply invents the answer.
//
// THE IDENTITY-RULE ARM IS THE ONE WORTH PINNING. The envelope versions its node-identity rule
// separately from its schema, so a document may parse perfectly under a derivation rule this build
// does not implement. Those bytes are unreadable ONLY HERE, exactly like an unrecognized format tag,
// and classifying them as damage would let an older reader destroy a newer writer's repository over
// a rule it simply lacks. The malformed pair beside it is what makes the assertion discriminating: a
// classifier answering UnsupportedProtocol for everything would satisfy the first two clauses alone.
//
// THE LAST TWO CLAUSES CARRY IT THROUGH TO THE DESTINATION rather than stopping at the standing,
// because the standing is only interesting for what it authorizes: the protocol gap must not
// supersede a generation and the malformed document must.
test fn an_unimplemented_identity_rule_is_a_protocol_gap_not_damage() -> Bool {
  let rule = repository_envelope_load_standing(
    cause: RepositoryIdentityRuleUnrecognized { found: "blake3-structural-v2" }
  )
  let format = repository_envelope_load_standing(
    cause: RepositoryFormatUnrecognized { found: "gunbc-scm-repository-v9" }
  )
  let member = repository_envelope_load_standing(
    cause: RepositoryUnexpectedMember { context: RepositoryEnvelopeMembers, key: "provenance" }
  )
  let unresolved = repository_envelope_load_standing(
    cause: RepositoryCommitRootReferenceUnresolved { reference: "11" }
  )
  standing_eq(a: rule, b: LoadUnsupportedProtocol)
    && standing_eq(a: format, b: LoadUnsupportedProtocol)
    && standing_eq(a: member, b: LoadDocumentMalformed)
    && standing_eq(a: unresolved, b: LoadDocumentMalformed)
    && !ls_permits(standing: rule)
    && ls_permits(standing: member)
}


// A MEMBER-READ CAUSE REACHES EACH CLASSIFIER BY TWO ROUTES, AND BOTH MUST ANSWER. Both formats
// wrapped the identical MemberReadRefusal population twice -- once undecorated on their own
// member-read arm, once nested inside a target-reference refusal -- and descended only the first,
// binding the target-reference payload bare. Each of the four causes is driven through BOTH routes
// at BOTH classifiers here, so the nested position is executed rather than merely exhaustive; the
// paired protocol-gap clause is what keeps a collapse-everything classifier from satisfying it.
fn ls_member_cause_is_malformed_everywhere(cause: MemberReadRefusal) -> Bool {
  standing_eq(
    a: closure_document_load_standing(cause: ClosureDocMemberReadRefused { cause: cause }),
    b: LoadDocumentMalformed
  )
    && standing_eq(
      a: closure_document_load_standing(
        cause: ClosureDocTargetReferenceRefused {
          cause: TargetReferenceMemberReadRefused { cause: cause }
        }
      ),
      b: LoadDocumentMalformed
    )
    && standing_eq(
      a: repository_envelope_load_standing(cause: RepositoryMemberReadRefused { cause: cause }),
      b: LoadDocumentMalformed
    )
    && standing_eq(
      a: repository_envelope_load_standing(
        cause: RepositoryTargetReferenceRefused {
          cause: TargetReferenceMemberReadRefused { cause: cause }
        }
      ),
      b: LoadDocumentMalformed
    )
}

test fn a_member_read_cause_is_malformed_by_either_route_at_both_classifiers() -> Bool {
  ls_member_cause_is_malformed_everywhere(cause: MemberReadSubjectNotObject)
    && ls_member_cause_is_malformed_everywhere(cause: MemberReadMissing { key: "at" })
    && ls_member_cause_is_malformed_everywhere(cause: MemberReadDuplicated { key: "at" })
    && ls_member_cause_is_malformed_everywhere(cause: MemberReadWrongShape { key: "at" })
    && !standing_eq(
      a: repository_envelope_load_standing(
        cause: RepositoryIdentityRuleUnrecognized { found: "blake3-structural-v2" }
      ),
      b: LoadDocumentMalformed
    )
}
