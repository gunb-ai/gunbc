module test.claim.scm_commit_closure_witness

// THE ONE CLAIM THESE WITNESSES EXIST FOR: an incomplete closure can NAME WHAT IT IS MISSING, and
// the name it gives is the content address of the actual absent object -- so it says what to fetch.
//
// The predecessor format could not do this at any price. It stored backward POSITIONS, so a
// reference that did not resolve inside the document denoted nothing outside it, and "supply the
// missing object" was unperformable. Every test below would have been unwritable against it -- not
// failing, unwritable, because there was no value to assert about.
//
// So the discriminating question is not "does unresolved_identities return a list". It is whether
// the returned identity is THE MISSING OBJECT'S OWN, which is what makes it fetchable rather than
// merely non-empty. `a_grafted_root_names_exactly_the_child_it_lacks` is the test that decides it.

import std.types { Bool, Int, String, List, list_length, NonEmptyStr }
import v2.std.node { Node, Edge, Symbol, Named, Conj, Atom, Cardinality, Positional, TypeNode, node_synthetic }
import gunbc.scm.object_store {
  ObjectId,
  ObjectStore,
  StoreOutcome,
  Stored,
  LocatorCollision,
  SemanticNodeTarget,
  node_target_locator,
  CopyOutcome,
  Copied,
  CopySourceAbsent,
  CopyLocatorCollision,
  empty_store,
  copy_object,
  store_node,
  object_id_eq,
  store_object_count,
  store_authored_source,
  SourceStoreOutcome,
  SourceStored,
  SourceLocatorCollision,
  insert_from_structure,
  StoredEdge,
  ObjectRecord,
  CorpusManifestEntry,
  store_corpus_manifest,
  CorpusManifestStored,
  CorpusManifestLocatorCollision,
  authored_source_target_of,
  node_target_of,
}
import v2.std.collection { empty_map }
import extdeps.languages.json.emit { serialize_json, json_object, json_kv, json_string, JsonValue, JsonObject }
import extdeps.languages.json.parse {
  parse_json_document,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
}
import gunbc.scm.json_member {
  MemberReadDuplicated,
  MemberReadWrongShape,
  MemberRead,
  MemberArray,
  MemberObject,
  read_member,
}
import gunbc.scm.target_reference {
  TargetReference,
  TargetContainedAt,
  TargetUncontained,
  TargetReferenceRefused,
  TargetReferenceNotOneArm,
  TargetReferenceMemberReadRefused,
  decode_target_reference,
}
import gunbc.scm.commit_closure_json_v2 {
  ClosureDocRefusal,
  ClosureDocIncompleteWithoutAdmission,
  ClosureDocRequiresNodeAtWrongKind,
  ClosureDocEncodeRefusal,
  ClosureDocMemberReadRefused,
  ClosureDocEncodeOutcome,
  ClosureDocEncoded,
  ClosureDocEncodeRefused,
  ClosureDocLoadOutcome,
  ClosureDocLoaded,
  ClosureDocRefused,
  encode_complete_closure_document,
  encode_admitted_partial_closure_document,
  decode_closure_document,
}
import gunbc.scm.commit_closure {
  CommitClosure,
  PartialClosureReason,
  ClosureTrimmedForTransfer,
  ClosureGraftedWithoutChildren,
  admit_partial_commit_closure,
  AdmittedPartialCommitClosure,
  PartialClosureAdmissionOutcome,
  PartialClosureAdmitted,
  ClosureCompleteSoNothingToAdmit,
  ClosureRequiresNodeAtWrongKind,
  admitted_reason,
  admitted_unresolved,
  unresolved_identities,
  closure_is_complete,
  admit_well_kinded_closure,
  admitted_well_kinded,
  WellKindedAdmission,
  WellKinded,
  NotWellKinded,
  well_kinded_nodes,
}

fn child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_child } }, children: [])
}

fn parent_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Named { name: ^only_child }, target: child_node() }],
  )
}

// A store holding the parent AND its child, with the parent's identity.
// THE ROOT IS A SemanticNodeTarget AND THE CHILD IS A LOCATOR, which is the two questions this fixture is
// actually asked. The root is handed to CommitClosure, a node-requiring position; the child is only
// ever compared against the identities a completeness fold reports, which are addresses.
type BuiltStore { store: ObjectStore, root: SemanticNodeTarget, child: ObjectId }

fn build_full_store() -> BuiltStore {
  match store_node(store: empty_store(), n: child_node()) {
    LocatorCollision { identity: _, existing: _, incoming: _ } =>
      BuiltStore {
        store: empty_store(),
        root: SemanticNodeTarget { locator: fallback_id() },
        child: fallback_id(),
      }
    Stored { store: s1, node: child_node_ref } =>
      match store_node(store: s1, n: parent_node()) {
        LocatorCollision { identity: _, existing: _, incoming: _ } =>
          BuiltStore {
            store: empty_store(),
            root: SemanticNodeTarget { locator: fallback_id() },
            child: fallback_id(),
          }
        Stored { store: s2, node: parent_ref } =>
          BuiltStore {
            store: s2,
            root: node_target_of(reference: parent_ref),
            child: child_node_ref.locator,
          }
      }
  }
}

// A deliberately wrong id used only where a probe could not be built; every test asserts a real
// structural fact that this value cannot satisfy, so a build failure cannot pass as a green.
fn fallback_id() -> ObjectId {
  match store_node(store: empty_store(), n: child_node()) {
    Stored { store: _, node: n } => n.locator
    LocatorCollision { identity: i, existing: _, incoming: _ } => i
  }
}

// A store holding ONLY the parent -- object_store's copy_object grafts a record without its children,
// which is the supported route to an incomplete closure and the reason the encoder could not assume
// completeness.
fn build_grafted_store() -> ObjectStore {
  let full = build_full_store()
  match copy_object(
    from: full.store,
    to: empty_store(),
    identity: node_target_locator(target: full.root),
  ) {
    Copied { store: s, reference: _ } => s
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
  }
}

// TWO UNCONTAINED CHILDREN, IN ORDER, and this fixture exists because the ones above cannot see
// order at all. names_exactly is a membership fold and every other closure fixture asserts exactly
// ONE missing identity -- and a one-element list reversed is itself. So the unresolved list could
// have been emitted in any order and nothing here would have noticed.
//
// That was not hypothetical. the census fold accumulates by prepend and reverses once (the cost
// shape DESIGN section 6 requires); dropping that reverse was measured to leave every claim in this
// file GREEN. A comment asserting the reverse was load-bearing would have been describing a wall
// that nothing held up, which is the failure this stack has now produced three times.
//
// The parent's two children are both absent from the grafted store, so both are uncontained, and
// this claim pins WHICH COMES FIRST. Reversing the fold flips alpha and beta and this goes red.
fn closure_alpha_child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_alpha } }, children: [])
}

fn closure_beta_child_node() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^closure_witness_beta } }, children: [])
}

fn closure_two_child_parent_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^alpha }, target: closure_alpha_child_node() },
      Edge { label: Named { name: ^beta }, target: closure_beta_child_node() },
    ],
  )
}

type TwoChildStore { store: ObjectStore, root: SemanticNodeTarget, first: ObjectId, second: ObjectId }

fn two_child_fallback() -> TwoChildStore {
  TwoChildStore {
    store: empty_store(),
    root: SemanticNodeTarget { locator: fallback_id() },
    first: fallback_id(),
    second: fallback_id(),
  }
}

fn build_two_child_store() -> TwoChildStore {
  match store_node(store: empty_store(), n: closure_alpha_child_node()) {
    LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
    Stored { store: s1, node: alpha_ref } =>
      match store_node(store: s1, n: closure_beta_child_node()) {
        LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
        Stored { store: s2, node: beta_ref } =>
          match store_node(store: s2, n: closure_two_child_parent_node()) {
            LocatorCollision { identity: _, existing: _, incoming: _ } => two_child_fallback()
            Stored { store: s3, node: parent_ref } =>
              TwoChildStore {
                store: s3,
                root: node_target_of(reference: parent_ref),
                first: alpha_ref.locator,
                second: beta_ref.locator,
              }
          }
      }
  }
}

fn first_missing_is(missing: List<ObjectId>, expected: ObjectId) -> Bool {
  match fold(missing, init: none, f: fn(acc, id) {
    match acc {
      Present { value: _ } => acc
      Absent => Present { value: id }
    }
  }) {
    Present { value: id } => object_id_eq(left: id, right: expected)
    Absent => false
  }
}

test fn two_uncontained_children_are_named_in_order() -> Bool {
  let built = build_two_child_store()
  let grafted = match copy_object(
    from: built.store,
    to: empty_store(),
    identity: node_target_locator(target: built.root),
  ) {
    Copied { store: s, reference: _ } => s
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
  }
  let missing = unresolved_identities(closure: CommitClosure { store: grafted, root: built.root })
  (store_object_count(store: grafted) == 1)
    && (list_length(items: missing) == 2)
    && first_missing_is(missing: missing, expected: built.first)
    && names_exactly(missing: missing, expected: built.second)
}

// CONTROL. A complete closure names nothing missing, and completeness is DERIVED from the objects
// rather than stored beside them -- there is no flag here that could disagree with the store.
test fn a_complete_closure_names_nothing_missing() -> Bool {
  let full = build_full_store()
  let closure = CommitClosure { store: full.store, root: full.root }
  (list_length(items: unresolved_identities(closure: closure)) == 0)
    && closure_is_complete(closure: closure)
    && (store_object_count(store: full.store) == 2)
}

// THE ACCEPTANCE TEST OF THE RECUT.
//
// A grafted root lacks its child. The closure must name EXACTLY ONE missing object, and that name
// must be the CHILD'S OWN CONTENT ADDRESS -- not a position, not a placeholder, not merely a
// non-empty list. Identity equality against the child id from the full store is what proves the
// answer is fetchable: it names the object a supplier would have to produce.
test fn a_grafted_root_names_exactly_the_child_it_lacks() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  let missing = unresolved_identities(closure: closure)
  (store_object_count(store: grafted) == 1)
    && (list_length(items: missing) == 1)
    && names_exactly(missing: missing, expected: full.child)
    && !closure_is_complete(closure: closure)
}

fn names_exactly(missing: List<ObjectId>, expected: ObjectId) -> Bool {
  fold(missing, init: false, f: fn(acc, id) { acc || object_id_eq(left: id, right: expected) })
}

// THE ROOT IS A REFERENCE LIKE ANY OTHER. A closure whose store does not carry its own root is the
// sharpest incompleteness there is -- a document naming a commit whose top object is absent -- and
// the predecessor encoded the root positionally too, so this was as unnameable as the rest.
test fn a_closure_missing_its_own_root_names_the_root() -> Bool {
  let full = build_full_store()
  let closure = CommitClosure { store: empty_store(), root: full.root }
  let missing = unresolved_identities(closure: closure)
  (list_length(items: missing) == 1)
    && names_exactly(missing: missing, expected: node_target_locator(target: full.root))
    && !closure_is_complete(closure: closure)
}

// THE ADMISSION IS A VALUE THAT SURVIVES BEING PASSED, which is what lets an encoder require one
// instead of trusting a caller's assurance. That `PartialClosureAdmission` is `sole_constructor` --
// so an undeclared partial closure has no constructor at all -- is a TYPECHECK property and cannot
// be witnessed by execution; it is stated in the module header, and a negative compile probe is the
// evidence that belongs with it. What executes here is only that the reason is carried faithfully,
// which is the part a later refactor could silently break.
test fn an_admission_carries_the_decision_that_produced_it() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  match admit_partial_commit_closure(closure: closure, reason: ClosureTrimmedForTransfer) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: transfer } =>
      match admit_partial_commit_closure(closure: closure, reason: ClosureGraftedWithoutChildren) {
        ClosureCompleteSoNothingToAdmit => false
        ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
        PartialClosureAdmitted { admitted: graft } =>
          reason_is_transfer(r: admitted_reason(admitted: transfer))
            && !reason_is_transfer(r: admitted_reason(admitted: graft))
      }
  }
}

// THE ADMISSION NAMES THE POPULATION IT ADMITS, derived from the closure rather than supplied. A
// caller-supplied population would reintroduce the same substitution one field down: an admission
// truthfully about closure A, carrying B's missing objects.
test fn an_admission_names_the_objects_it_admits_as_missing() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      (list_length(items: admitted_unresolved(admitted: a)) == 1)
        && names_exactly(missing: admitted_unresolved(admitted: a), expected: full.child)
  }
}

// THE MINT REFUSES A COMPLETE CLOSURE. Admitting a partial write for something with nothing missing
// is a category error, and letting it through would make the carrier's own name a lie -- an
// AdmittedPartialCommitClosure over a closure that is not partial.
//
// This is also the claim that keeps the mint honest about DERIVING the population: a mint that
// trusted a caller could mint this carrier over a complete closure and nothing here would object.
test fn the_mint_refuses_a_complete_closure() -> Bool {
  let full = build_full_store()
  match admitted_for(store: full.store, root: full.root) {
    PartialClosureAdmitted { admitted: _ } => false
    ClosureCompleteSoNothingToAdmit => true
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
  }
}


// Mints an admission for the closure under test, or reports the refusal. Every claim below routes
// through this, so none of them can accidentally encode a closure the mint never admitted.
fn admitted_for(store: ObjectStore, root: SemanticNodeTarget) -> PartialClosureAdmissionOutcome {
  admit_partial_commit_closure(
    closure: CommitClosure { store: store, root: root },
    reason: ClosureTrimmedForTransfer
  )
}

fn json_is_object(v: JsonValue) -> Bool {
  match v {
    JsonObject { members: _ } => true
    _ => false
  }
}

fn reason_is_transfer(r: PartialClosureReason) -> Bool {
  match r {
    ClosureTrimmedForTransfer => true
    ClosureGraftedWithoutChildren => false
  }
}


// ------------------------------------------------------------------------------------------------
// THE WIRE HALF OF THE ACCEPTANCE TEST.
//
// The witnesses above prove an incomplete closure can NAME what it lacks at the LOGICAL layer. That
// is only half the claim: a format that cannot carry the name would leave the property true in
// memory and unrepresentable in the thing that actually gets written down. These execute the other
// half -- an uncontained reference surviving encode, serialization to text, and decode.
// ------------------------------------------------------------------------------------------------

// A PARTIAL CLOSURE REFUSES TO ENCODE UNTIL SOMEONE DECIDES IT SHOULD, and the two arms of this test
// are the whole admission wall: the same store, the same root, differing only in whether a decision
// token was supplied. The refusing arm is what stops a partial document being written by accident;
// the encoding arm is what stops that refusal being a wall against the feature itself.
test fn a_partial_closure_encodes_only_with_an_admission() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let refused = match encode_complete_closure_document(
    closure: CommitClosure { store: grafted, root: full.root }
  ) {
    ClosureDocEncodeRefused { cause: c } => cause_is_incomplete_without_admission(cause: c)
    ClosureDocEncoded { value: _ } => false
  }
  let admitted = match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      json_is_object(v: encode_admitted_partial_closure_document(admitted: a))
  }
  refused && admitted
}

// THIS HELPER IS NOW TOTAL BY CONSTRUCTION, and saying so is the point rather than an apology.
//
// Before the encode/decode split it discriminated: the cause could have been any of sixteen decode
// refusals and this asked whether it was the encode-only one. ClosureDocEncodeRefusal has a single
// arm, so the match cannot answer anything else, and the runtime question it used to pose is gone.
//
// That is what a climb to structural impossibility LOOKS like from the test side -- the check does
// not get stronger, it becomes unnecessary, because the state it excluded is no longer nameable
// here. DESIGN section 4b(4) says the production machinery a climb obsoletes is deleted while the
// evidence stays enrolled, so this stays as the positive control that encode still refuses an
// unadmitted partial closure; what it no longer carries is the discrimination, which moved to the
// type. The claim that the LOAD classifier cannot name this cause is a compile-time property and is
// recorded by the probe in the commit message, not by a runtime assertion that cannot express it.
fn cause_is_incomplete_without_admission(cause: ClosureDocEncodeRefusal) -> Bool {
  match cause {
    ClosureDocIncompleteWithoutAdmission { identity: _ } => true
    ClosureDocRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
  }
}

// THE CLAIM THE WHOLE RECUT WAS FOR, executed end to end through TEXT.
//
// A partial closure is encoded, SERIALIZED TO A STRING, parsed back, and decoded -- and the object it
// could not carry is still named, by its own content address, on the far side. Going through text
// matters: it is the only arm that proves the identity survives in the BYTES rather than in a value
// that never left memory. The predecessor could not have expressed this at any price.
test fn an_uncontained_object_survives_the_wire_and_is_still_named() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      match parse_json_document(
        s: serialize_json(v: encode_admitted_partial_closure_document(admitted: a))
      ) {
        JsonDocumentUnreadable { gap: _ } => false
        JsonDocumentParsed { value: reparsed } =>
          match decode_closure_document(v: reparsed) {
            ClosureDocRefused { cause: _ } => false
            ClosureDocLoaded { store: store, root: root } =>
              names_exactly(
                missing: unresolved_identities(closure: CommitClosure { store: store, root: root }),
                expected: full.child
              )
          }
      }
  }
}

// A TARGET CARRYING BOTH ARMS IS REFUSED, AND SO IS ONE CARRYING NEITHER.
//
// This exists because the module DOCUMENTED this refusal while the code did not perform it, and no
// witness executed the claim -- review found it by reading. The closed member set admits both keys
// (each is individually legal), so it could never have been what enforced the choice; the earlier
// code then read "at" first and SILENTLY DROPPED a digest sitting beside it. A document asserting
// two contradictory things about one target answered with one of them.
//
// The count is asserted, not just the refusal: `found` distinguishes both-arms from neither-arm,
// which the previous variant could not do because it was hardcoded to 0 at its only construction.
test fn a_target_must_carry_exactly_one_arm() -> Bool {
  let both = json_object(
    members: [
      json_kv(key: "at", value: json_string(s: "0")),
      json_kv(key: "uncontained", value: json_string(s: "0000000000000000")),
    ]
  )
  let neither = json_object(members: [])
  arm_count_refused(v: both, expected: 2) && arm_count_refused(v: neither, expected: 0)
}

fn arm_count_refused(v: JsonValue, expected: Int) -> Bool {
  match decode_target_reference(target_value: v) {
    TargetReferenceRefused { cause: c } =>
      match c {
        TargetReferenceNotOneArm { found: n } => n == expected
        _ => false
      }
    TargetContainedAt { reference: _ } => false
    TargetUncontained { digest: _ } => false
  }
}

// THE POSITIVE CONTROL, without which the two refusals above are satisfied by a decoder that refuses
// every target. One arm, well formed, resolves.
test fn a_target_carrying_one_arm_still_decodes() -> Bool {
  match decode_target_reference(
    target_value: json_object(
      members: [json_kv(key: "uncontained", value: json_string(s: "0000000000000000"))]
    )
  ) {
    TargetUncontained { digest: _ } => true
    TargetContainedAt { reference: _ } => false
    TargetReferenceRefused { cause: _ } => false
  }
}

// A BROKEN `at` IS REPORTED AGAINST `at`, NOT AGAINST THE ARM IT IS NOT.
//
// These two exist because the refusal was real but named the WRONG KEY, which no refusal-only
// assertion could ever have caught -- the decoder said no in both the correct and the broken build,
// so every existing claim here stayed green while the diagnostic pointed at an innocent member.
//
// The defect was selecting the arm on READ SUCCESS: a missing `at` and a malformed `at` both arrive
// as MemberFailed, so "at did not read" was treated as "this is the uncontained arm". A target
// carrying `at` twice fell into the uncontained read, where `uncontained` is legitimately absent,
// and was refused as a wrong-shape `uncontained` -- with the duplication never mentioned at all.
//
// Both claims therefore assert the CAUSE and its KEY, not the refusal. Under the previous code the
// first reports ClosureDocMemberWrongShape("uncontained") and the second ClosureDocMemberMissing(
// "uncontained"), so each goes red for a different wrong answer rather than by a shared accident.
test fn a_duplicated_at_is_refused_against_at() -> Bool {
  match decode_target_reference(
    target_value: json_object(
      members: [
        json_kv(key: "at", value: json_string(s: "0")),
        json_kv(key: "at", value: json_string(s: "1")),
      ]
    )
  ) {
    TargetReferenceRefused { cause: c } =>
      match c {
        TargetReferenceMemberReadRefused { cause: MemberReadDuplicated { key: k } } => k == "at"
        _ => false
      }
    TargetContainedAt { reference: _ } => false
    TargetUncontained { digest: _ } => false
  }
}

test fn a_non_string_at_is_refused_against_at() -> Bool {
  match decode_target_reference(
    target_value: json_object(
      members: [json_kv(key: "at", value: json_object(members: []))]
    )
  ) {
    TargetReferenceRefused { cause: c } =>
      match c {
        TargetReferenceMemberReadRefused { cause: MemberReadWrongShape { key: k } } => k == "at"
        _ => false
      }
    TargetContainedAt { reference: _ } => false
    TargetUncontained { digest: _ } => false
  }
}

// ------------------------------------------------------------------------------------------------
// A NODE REQUIREMENT WHOSE LOCATOR IS OCCUPIED BY A FILE IS NOT A FETCHABLE ABSENCE.
//
// The three cells below differ by ONE FACT -- what, if anything, sits at the child's locator -- and
// they exist because the branch's own carrier cannot tell two of them apart. store_contains_node_target
// resolved through find_node_record, which asks for a SEMANTIC NODE, so a file at L is not a node;
// uncontained_in_record reads every false as a fetchable missing locator and has no wrong-kind arm.
//
// THE ASSERTION IS A PROHIBITION, NOT A DESCRIPTION, and that distinction is the whole design of this
// test. The tempting claim -- "the encoder emits a document this build then refuses" -- is TRUE on the
// defect, so it would be green on the bug it is meant to catch. What must be forbidden is the state
// itself: a locator occupied by the wrong kind may not inhabit the unresolved population, because
// every consumer of that population treats membership as "absent, therefore fetchable" and fetching
// cannot repair an occupied locator.
//
// Each control blocks a repair that would satisfy the others while still being wrong:
//   - source_occupied alone is satisfied by refusing EVERY unresolved target, which would destroy the
//     partial closure the format exists to carry. absent_child forbids that.
//   - absent_child alone is satisfied by treating ANY object at L as sufficient regardless of kind,
//     which is the defect restated. source_occupied forbids that.
//   - both are satisfied by encoding every target as uncontained, dodging the self-refusal by never
//     emitting the contained spelling. present_child forbids that: it requires "at" to round-trip to
//     a complete closure.

fn closure_occupied_file_text() -> String {
  "not a program\n"
}

// The parent is built through insert_from_structure rather than by hand: ObjectRecord is
// sole_constructor, so the fixture chooses the STRUCTURE and the store derives the identity. The
// child target is therefore incomplete-by-construction and this fixture never forges a reference.
type OccupiedFixture { store: ObjectStore, root: SemanticNodeTarget, child: ObjectId, ok: Bool }

fn closure_over_an_occupied_locator() -> OccupiedFixture {
  match store_authored_source(store: empty_store(), text: closure_occupied_file_text()) {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
      OccupiedFixture {
        store: empty_store(),
        root: SemanticNodeTarget { locator: fallback_id() },
        child: fallback_id(),
        ok: false,
      }
    SourceStored { store: with_file, source: file } =>
      match insert_from_structure(
        store: with_file,
        kind: TypeNode { connective: Conj },
        children: [
          StoredEdge { label: Named { name: ^only_child }, target: SemanticNodeTarget { locator: file.locator } },
        ],
      ) {
        LocatorCollision { identity: _, existing: _, incoming: _ } =>
          OccupiedFixture {
            store: empty_store(),
            root: SemanticNodeTarget { locator: fallback_id() },
            child: fallback_id(),
            ok: false,
          }
        Stored { store: assembled, node: root } =>
          OccupiedFixture {
            store: assembled,
            root: node_target_of(reference: root),
            child: file.locator,
            ok: true,
          }
      }
  }
}

fn names_none_of(missing: List<ObjectId>, forbidden: ObjectId) -> Bool {
  fold(
    missing,
    init: true,
    f: fn(acc, m) { acc && !object_id_eq(left: m, right: forbidden) }
  )
}

// CELL A -- the discriminating red. A file occupies the child's locator, so the requirement is
// UNSATISFIED but not ABSENT: it is wrong-kind, and no fetch can repair it. It must not appear in the
// population every consumer reads as fetchable.
test fn a_node_requirement_over_a_file_is_not_a_fetchable_absence() -> Bool {
  let fx = closure_over_an_occupied_locator()
  fx.ok
    && names_none_of(
      missing: unresolved_identities(closure: CommitClosure { store: fx.store, root: fx.root }),
      forbidden: fx.child
    )
}

// CELL B -- the absent control, one fact from cell A. Nothing occupies the locator, so the
// requirement IS a genuine absence: it stays in the unresolved population, admits as partial, and
// survives encode, TEXT, and decode still naming the object it could not carry.
test fn an_absent_child_is_still_a_fetchable_absence() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      match parse_json_document(
        s: serialize_json(v: encode_admitted_partial_closure_document(admitted: a))
      ) {
        JsonDocumentUnreadable { gap: _ } => false
        JsonDocumentParsed { value: reparsed } =>
          match decode_closure_document(v: reparsed) {
            ClosureDocRefused { cause: _ } => false
            ClosureDocLoaded { store: store, root: root } =>
              names_exactly(
                missing: unresolved_identities(closure: CommitClosure { store: store, root: root }),
                expected: full.child
              )
          }
      }
  }
}

// CELL C -- the present control, the other fact from cell A. A real semantic node occupies the
// locator, so the closure is COMPLETE: it encodes the contained spelling and round-trips through text
// to a closure that names nothing missing. This is what forbids the repair that encodes every target
// as uncontained to dodge the contradiction.
test fn a_present_child_round_trips_as_a_complete_closure() -> Bool {
  let full = build_full_store()
  match encode_complete_closure_document(
    closure: CommitClosure { store: full.store, root: full.root }
  ) {
    ClosureDocEncodeRefused { cause: _ } => false

    ClosureDocEncoded { value: encoded } =>
      match parse_json_document(s: serialize_json(v: encoded)) {
        JsonDocumentUnreadable { gap: _ } => false
        JsonDocumentParsed { value: reparsed } =>
          match decode_closure_document(v: reparsed) {
            ClosureDocRefused { cause: _ } => false
            ClosureDocLoaded { store: store, root: root } =>
              closure_is_complete(closure: CommitClosure { store: store, root: root })
          }
      }
  }
}

// ------------------------------------------------------------------------------------------------
// TWO AUTHORED ORDERS OF THE SAME NAMED BINDINGS ARE ONE OBJECT, AND RE-WRITING ONE IS IDEMPOTENT.
//
// content_hash_of_children canonicalizes -- canonicalize_node_for_content_hash SORTS named edges --
// so [alpha, beta] and [beta, alpha] over the same targets derive ONE locator. object_store already
// records this for store_node, which canonicalizes before persisting so that the stored record is the
// canonical one rather than an arbitrary first-observed representative.
//
// insert_from_structure is the OTHER public route to a record and it does not do that: it derives the
// locator from the canonicalized children and then persists the children AS SUPPLIED. So the second
// write finds a record under the same locator, records_equal compares the labeled children in
// supplied order, they differ, and insert_admission reports a LocatorCollision -- for a store being
// asked to do something perfectly ordinary. The refusal is fabricated: nothing collided.
//
// This is the same class the note above store_node describes, surviving on the sibling route, and it
// is a fabricated refusal rather than a missed one -- the store refuses a write it should accept.
fn permutation_alpha_child() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^permutation_alpha } }, children: [])
}

fn permutation_beta_child() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^permutation_beta } }, children: [])
}

type PermutationFixture { store: ObjectStore  alpha: SemanticNodeTarget  beta: SemanticNodeTarget  ok: Bool }

fn permutation_fixture() -> PermutationFixture {
  let unusable = SemanticNodeTarget { locator: fallback_id() }
  match store_node(store: empty_store(), n: permutation_alpha_child()) {
    LocatorCollision { identity: _, existing: _, incoming: _ } =>
      PermutationFixture { store: empty_store(), alpha: unusable, beta: unusable, ok: false }
    Stored { store: s1, node: alpha } =>
      match store_node(store: s1, n: permutation_beta_child()) {
        LocatorCollision { identity: _, existing: _, incoming: _ } =>
          PermutationFixture { store: empty_store(), alpha: unusable, beta: unusable, ok: false }
        Stored { store: s2, node: beta } =>
          PermutationFixture {
            store: s2,
            alpha: node_target_of(reference: alpha),
            beta: node_target_of(reference: beta),
            ok: true,
          }
      }
  }
}

fn insert_two_named(store: ObjectStore, first_label: Symbol, first: SemanticNodeTarget, second_label: Symbol, second: SemanticNodeTarget) -> StoreOutcome {
  insert_from_structure(
    store: store,
    kind: TypeNode { connective: Conj },
    children: [
      StoredEdge { label: Named { name: first_label }, target: first },
      StoredEdge { label: Named { name: second_label }, target: second },
    ],
  )
}

// THE DISCRIMINATING RED. One store, two authored orders, one canonical object. The second write must
// be idempotent, not a collision.
test fn re_writing_the_same_bindings_in_another_order_is_idempotent() -> Bool {
  let fx = permutation_fixture()
  fx.ok
    && match insert_two_named(
      store: fx.store,
      first_label: ^alpha,
      first: fx.alpha,
      second_label: ^beta,
      second: fx.beta,
    ) {
      LocatorCollision { identity: _, existing: _, incoming: _ } => false
      Stored { store: once, node: first_ref } =>
        match insert_two_named(
          store: once,
          first_label: ^beta,
          first: fx.beta,
          second_label: ^alpha,
          second: fx.alpha,
        ) {
          LocatorCollision { identity: _, existing: _, incoming: _ } => false
          Stored { store: _, node: second_ref } =>
            object_id_eq(left: first_ref.locator, right: second_ref.locator)
        }
    }
}

// THE CONTROL, without which the claim above is satisfied by a store that never refuses. Different
// label-to-target ASSOCIATIONS are a genuinely different object, so they derive a different locator
// and both records stand -- this is not a permutation and must not be collapsed into one.
test fn swapping_which_target_each_label_names_is_a_different_object() -> Bool {
  let fx = permutation_fixture()
  fx.ok
    && match insert_two_named(
      store: fx.store,
      first_label: ^alpha,
      first: fx.alpha,
      second_label: ^beta,
      second: fx.beta,
    ) {
      LocatorCollision { identity: _, existing: _, incoming: _ } => false
      Stored { store: once, node: first_ref } =>
        match insert_two_named(
          store: once,
          first_label: ^alpha,
          first: fx.beta,
          second_label: ^beta,
          second: fx.alpha,
        ) {
          LocatorCollision { identity: _, existing: _, incoming: _ } => false
          Stored { store: _, node: second_ref } =>
            !object_id_eq(left: first_ref.locator, right: second_ref.locator)
        }
    }
}

// ------------------------------------------------------------------------------------------------
// A LATE GRAFT COMPLETES THE CLOSURE, AND THE DOCUMENT MUST SAY SO.
//
// store_records_in_dependency_order returns insertion order, and object_store's note beside it argues
// that order is dependency order because store_node recurses into a target before appending its
// parent. That is true for store_node and FALSE for the graft route: copy_object appends one record
// without its children, so copying the parent and then the child leaves the parent EARLIER than the
// child it references.
//
// Completeness does not care -- both objects are present, so the closure is complete. The encoder
// does: it assigns positions in that order, so when it encodes the parent the child has no position
// yet and the target is emitted as UNCONTAINED, naming a digest the document goes on to carry a few
// entries later. That contradicts the declared wire meaning of uncontained -- "this document does NOT
// carry it" -- and lets a complete closure emit a partial spelling.
//
// The pair is the claim: parent alone must encode uncontained, and parent-then-child must encode
// contained. Without the first cell the second is satisfied by an encoder that never emits
// uncontained at all, which would break the partial-closure format this branch exists to add.
fn build_grafted_then_completed_store() -> ObjectStore {
  let full = build_full_store()
  match copy_object(
    from: full.store,
    to: empty_store(),
    identity: node_target_locator(target: full.root),
  ) {
    CopySourceAbsent { identity: _ } => empty_store()
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
    Copied { store: with_parent, reference: _ } =>
      match copy_object(from: full.store, to: with_parent, identity: full.child) {
        CopySourceAbsent { identity: _ } => empty_store()
        CopyLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
        Copied { store: with_both, reference: _ } => with_both
      }
  }
}

// THE DISCRIMINATING RED, AND THE FIRST VERSION OF IT WAS NOT.
//
// The obvious assertion -- encode, round-trip through text, and require the reloaded closure to be
// complete -- PASSES ON THE DEFECT, and finding that out is why this comment exists rather than a
// claim that merely looked thorough. Decode re-stores every object in the table, so the child arrives
// either way and the reloaded closure is complete whichever spelling its parent used. The defect is
// in the BYTES and an assertion that only reads the rebuilt store cannot see it.
//
// So the claim compares IMAGES. The grafted-then-completed store and the naturally-built store are
// the SAME closure -- same objects, same root, same identities -- so they must serialize to the same
// document. Under the insertion-order encoder they do not: one spells the child target contained and
// the other spells it uncontained, and the byte comparison is what refuses that.
//
// THE NAME IS SCOPED TO THE TWO HISTORIES THE FIXTURE ACTUALLY BUILDS. It was
// `one_closure_has_one_image_however_its_store_was_assembled`, which claims GLOBAL image invariance
// across every assembly history -- more than this fixture establishes and more than the repository
// authority grants, since insertion history still decides tie order among INDEPENDENT components.
// External review named the overreach. A claim whose name promises more than its body executes is the
// same inflation as a rung reported above its evidence.
test fn a_completed_parent_first_graft_has_the_naturally_built_image() -> Bool {
  let full = build_full_store()
  let completed = build_grafted_then_completed_store()
  let closure = CommitClosure { store: completed, root: full.root }
  closure_is_complete(closure: closure)
    && match encode_complete_closure_document(closure: closure) {
      ClosureDocEncodeRefused { cause: _ } => false

      ClosureDocEncoded { value: grafted_image } =>
        match encode_complete_closure_document(
          closure: CommitClosure { store: full.store, root: full.root }
        ) {
          ClosureDocEncodeRefused { cause: _ } => false

          ClosureDocEncoded { value: natural_image } =>
            serialize_json(v: grafted_image) == serialize_json(v: natural_image)
        }
    }
}

// THE CONTROL. Without it the claim above is satisfied by an encoder that never spells a target
// uncontained at all -- which would delete the partial-closure format this branch exists to add. The
// parent alone genuinely does not carry its child, so its image must differ from the complete one.
test fn a_genuinely_partial_store_does_not_encode_as_the_complete_one() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      match encode_complete_closure_document(
        closure: CommitClosure { store: full.store, root: full.root }
      ) {
        ClosureDocEncodeRefused { cause: _ } => false

        ClosureDocEncoded { value: natural_image } =>
          serialize_json(v: encode_admitted_partial_closure_document(admitted: a))
            != serialize_json(v: natural_image)
      }
  }
}

// ------------------------------------------------------------------------------------------------
// THE SPELLING ITSELF, BECAUSE BYTE EQUALITY DOES NOT PIN IT.
//
// a_completed_parent_first_graft_has_the_naturally_built_image compares two serializations and requires
// them equal. That catches a DISAGREEMENT between the two assembly routes, which is what the graft
// defect produced -- and external review named the hole it leaves: if the encoder spelled EVERY
// target uncontained, both images would still agree and the claim would still pass. Agreement is not
// correctness; it is only consistency.
//
// So this reads the arm out of the document. The closure is complete, so the parent's child target
// must carry "at" -- and decode_target_reference is the module's own reader, not a second parser
// written here to grade the first one.
fn target_arm_of_first_child(objects: List<JsonValue>) -> TargetReference? {
  fold(objects, init: none, f: fn(found, entry) {
    match found {
      Present { value: _ } => found
      Absent =>
        match read_member(v: entry, key: "children") {
          MemberArray { elements: edges } =>
            fold(edges, init: none, f: fn(inner, edge) {
              match inner {
                Present { value: _ } => inner
                Absent =>
                  match read_member(v: edge, key: "target") {
                    MemberObject { value: t } =>
                      Present { value: decode_target_reference(target_value: t) }
                    _ => none
                  }
              }
            })
          _ => none
        }
    }
  })
}

fn document_objects(v: JsonValue) -> List<JsonValue> {
  match read_member(v: v, key: "objects") {
    MemberArray { elements: e } => e
    _ => []
  }
}

// A COMPLETE CLOSURE SPELLS ITS CHILD CONTAINED, whichever order its store was assembled in.
test fn a_complete_closure_spells_its_child_contained() -> Bool {
  let full = build_full_store()
  let completed = build_grafted_then_completed_store()
  match encode_complete_closure_document(
    closure: CommitClosure { store: completed, root: full.root }
  ) {
    ClosureDocEncodeRefused { cause: _ } => false

    ClosureDocEncoded { value: image } =>
      match target_arm_of_first_child(objects: document_objects(v: image)) {
        Absent => false
        Present { value: arm } =>
          match arm {
            TargetContainedAt { reference: _ } => true
            TargetUncontained { digest: _ } => false
            TargetReferenceRefused { cause: _ } => false
          }
      }
  }
}

// THE CONTROL. A genuinely partial closure must still spell its missing child UNCONTAINED -- without
// this, the claim above is satisfied by an encoder that never emits the uncontained arm, which would
// delete the partial-closure format outright.
test fn a_partial_closure_spells_its_missing_child_uncontained() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  match admitted_for(store: grafted, root: full.root) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      match target_arm_of_first_child(
        objects: document_objects(v: encode_admitted_partial_closure_document(admitted: a))
      ) {
        Absent => false
        Present { value: arm } =>
          match arm {
            TargetUncontained { digest: _ } => true
            TargetContainedAt { reference: _ } => false
            TargetReferenceRefused { cause: _ } => false
          }
      }
  }
}

// THE POSITIONAL CONTROL FOR THE CANONICALIZATION, and it is the half that says the sort is a RULE
// rather than a habit.
//
// insert_from_structure now canonicalizes its children, and re_writing_the_same_bindings_in_another_
// order_is_idempotent says two authored orders of the same NAMED bindings are one object. On its own
// that claim is satisfied by sorting every child list unconditionally -- which would be wrong, and
// silently so: under Cardinality and Instantiation the discipline is PositionalEdges, where position
// IS the meaning and reordering names a different program. External review named this gap.
//
// The canonicalizer already answers correctly, because it dispatches on kind_edge_discipline and
// returns positional items untouched. Nothing here executed that, so the rule was true and unwitnessed
// -- and an unwitnessed rule is one a later local sort can quietly replace.
test fn positional_children_are_not_reordered_by_canonicalization() -> Bool {
  let fx = permutation_fixture()
  fx.ok
    && match insert_from_structure(
      store: fx.store,
      kind: TypeNode { connective: Cardinality },
      children: [
        StoredEdge { label: Positional, target: fx.alpha },
        StoredEdge { label: Positional, target: fx.beta },
      ],
    ) {
      LocatorCollision { identity: _, existing: _, incoming: _ } => false
      Stored { store: once, node: first_ref } =>
        match insert_from_structure(
          store: once,
          kind: TypeNode { connective: Cardinality },
          children: [
            StoredEdge { label: Positional, target: fx.beta },
            StoredEdge { label: Positional, target: fx.alpha },
          ],
        ) {
          LocatorCollision { identity: _, existing: _, incoming: _ } => false
          Stored { store: _, node: second_ref } =>
            !object_id_eq(left: first_ref.locator, right: second_ref.locator)
        }
    }
}

// THE COMPLETE WRITER PRODUCES NO BYTES FOR A WRONG-KIND CLOSURE, and it names the population.
//
// This is the front door the side door already refused. encode_complete_closure_document asked
// unresolved_identities, which projects the ABSENT population -- and for a requirement whose locator
// is occupied by an authored source that population is EMPTY. So the writer saw nothing missing and
// returned bytes, while partial admission refused the identical state. External review found it.
//
// The raw writer beneath it needs no claim of its own any more, and that is the stronger outcome:
// encode_closure_document now takes a WellKindedClosure, which is sole_constructor and mintable only
// through admit_well_kinded_closure. There is no argument a caller can build that carries this state,
// so the refusal is by construction rather than by a judgment the front door happens to run.
test fn the_complete_writer_refuses_a_wrong_kind_closure_and_names_it() -> Bool {
  let fx = closure_over_an_occupied_locator()
  fx.ok
    && match encode_complete_closure_document(
      closure: CommitClosure { store: fx.store, root: fx.root }
    ) {
      ClosureDocEncoded { value: _ } => false
      ClosureDocEncodeRefused { cause: c } =>
        match c {
          ClosureDocRequiresNodeAtWrongKind {
            source_occupied: ids,
            manifest_occupied: manifests,
          } =>
            (list_length(items: ids) == 1)
              && names_exactly(missing: ids, expected: fx.child)
              && (list_length(items: manifests) == 0)
          ClosureDocIncompleteWithoutAdmission { identity: _ } => false
        }
    }
}

// THE CONTROL. Without it the claim above is satisfied by a writer that refuses everything, which
// would delete the format. A genuinely complete closure still encodes.
test fn the_complete_writer_still_encodes_a_complete_closure() -> Bool {
  let full = build_full_store()
  match encode_complete_closure_document(
    closure: CommitClosure { store: full.store, root: full.root }
  ) {
    ClosureDocEncoded { value: v } => json_is_object(v: v)
    ClosureDocEncodeRefused { cause: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The closure is what its root REACHES, not what its store happens to hold
// ---------------------------------------------------------------------------

// THESE FOUR ARE THE DISCRIMINATING SET FOR THE REACHABILITY CUT, and each one goes red against a
// different wrong answer that was available. Without the two controls a derivation that refused
// every store containing anything unrelated would satisfy the RED; without the RED a derivation
// that admitted everything would satisfy the controls; without the parity claim the two admission
// routes could disagree and only the unused one be wrong.

fn manifest_witness_file_text() -> String {
  "the corpus manifest witness file"
}

// A store holding one authored source and a manifest naming it at a path, plus that manifest's
// locator. Nothing here is reachable from any semantic root, which is the whole point.
type ManifestFixture { store: ObjectStore, manifest: ObjectId, source: ObjectId, ok: Bool }

fn a_store_holding_a_manifest() -> ManifestFixture {
  match store_authored_source(store: empty_store(), text: manifest_witness_file_text()) {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } =>
      ManifestFixture { store: empty_store(), manifest: fallback_id(), source: fallback_id(), ok: false }
    SourceStored { store: with_file, source: file } =>
      match store_corpus_manifest(
        store: with_file,
        entries: [
          CorpusManifestEntry {
            path: "witness/only.dag" as NonEmptyStr,
            source: authored_source_target_of(reference: file),
          },
        ],
      ) {
        CorpusManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
          ManifestFixture { store: empty_store(), manifest: fallback_id(), source: fallback_id(), ok: false }
        CorpusManifestStored { store: with_manifest, manifest: manifest } =>
          ManifestFixture {
            store: with_manifest,
            manifest: manifest.locator,
            source: file.locator,
            ok: true,
          }
      }
  }
}

// Grafts the node pair from build_full_store onto a store that already holds a manifest, so the
// result has a legitimate semantic root AND unrelated repository inventory sitting beside it.
type MixedFixture { store: ObjectStore, root: SemanticNodeTarget, manifest: ObjectId, source: ObjectId, ok: Bool }

fn a_store_holding_a_manifest_and_an_unrelated_program() -> MixedFixture {
  let inventory = a_store_holding_a_manifest()
  let full = build_full_store()
  match copy_object(
    from: full.store,
    to: inventory.store,
    identity: full.child,
  ) {
    CopySourceAbsent { identity: _ } =>
      MixedFixture { store: empty_store(), root: full.root, manifest: fallback_id(), source: fallback_id(), ok: false }
    CopyLocatorCollision { identity: _, existing: _, incoming: _ } =>
      MixedFixture { store: empty_store(), root: full.root, manifest: fallback_id(), source: fallback_id(), ok: false }
    Copied { store: with_child, reference: _ } =>
      match copy_object(
        from: full.store,
        to: with_child,
        identity: node_target_locator(target: full.root),
      ) {
        CopySourceAbsent { identity: _ } =>
          MixedFixture { store: empty_store(), root: full.root, manifest: fallback_id(), source: fallback_id(), ok: false }
        CopyLocatorCollision { identity: _, existing: _, incoming: _ } =>
          MixedFixture { store: empty_store(), root: full.root, manifest: fallback_id(), source: fallback_id(), ok: false }
        Copied { store: with_program, reference: _ } =>
          MixedFixture {
            store: with_program,
            root: full.root,
            manifest: inventory.manifest,
            source: inventory.source,
            ok: inventory.ok,
          }
      }
  }
}

fn nodes_hold(nodes: List<ObjectRecord>, identity: ObjectId) -> Bool {
  fold(
    nodes,
    init: false,
    f: fn(seen, record) { seen || object_id_eq(left: record.identity.locator, right: identity) }
  )
}

// CONTROL 1. A repository holding an unrelated manifest can still publish the closure rooted at P.
//
// This is the claim that keeps the refusal from being satisfied by refusing everything -- and the
// wrong answer it excludes was a real candidate: an admission that scanned the whole store for
// manifests and refused on finding one. That would make "serialize the program I asked for" fail on
// inventory the program does not reference, which is a failure arm that widens instead of refusing.
//
// It also pins the POPULATION, not merely the outcome. Asserting only that admission succeeded would
// go green for a carrier that still held the whole store.
test fn an_unrelated_manifest_does_not_enter_the_closure_or_refuse_it() -> Bool {
  let fx = a_store_holding_a_manifest_and_an_unrelated_program()
  fx.ok
    && match admit_well_kinded_closure(
      closure: CommitClosure { store: fx.store, root: fx.root }
    ) {
      NotWellKinded { source_occupied: _, manifest_occupied: _ } => false
      WellKinded { admitted: image, unresolved: _ } =>
        match well_kinded_nodes(admitted: image) {
          nodes =>
            (list_length(items: nodes) == 2)
              && nodes_hold(nodes: nodes, identity: node_target_locator(target: fx.root))
              && !nodes_hold(nodes: nodes, identity: fx.manifest)
        }
    }
}

// CONTROL 2, THE SAME QUESTION ASKED OF THE OTHER UNREACHABLE KIND, AND HALF OF A PAIR.
//
// Its sibling lives in test.claim.scm_repository_envelope_witness and asserts that this same source
// SURVIVES the repository round trip with its exact content arm and derived identity. The two are
// deliberately not one Boolean: they have different owners and either can fail while the other holds
// -- an encoder that dropped every source would satisfy this one, and a closure that carried the
// whole store would satisfy that one. Written against the same constructed store, the pair makes the
// authority split itself executable: route both writers through one population projection and
// exactly one of them goes red. An authored source in the store
// is not closure content either, and it is a separate claim rather than a restatement because the
// two travelled by different routes: the manifest was never encodable at all, while the source WAS
// emitted by every predecessor of this writer. This is the one that would have gone red before the
// cut, and it is the evidence that the format's narrowing actually happened.
test fn an_unreachable_authored_source_is_not_part_of_the_semantic_closure() -> Bool {
  let fx = a_store_holding_a_manifest_and_an_unrelated_program()
  fx.ok
    && match admit_well_kinded_closure(
      closure: CommitClosure { store: fx.store, root: fx.root }
    ) {
      NotWellKinded { source_occupied: _, manifest_occupied: _ } => false
      WellKinded { admitted: image, unresolved: _ } =>
        !nodes_hold(nodes: well_kinded_nodes(admitted: image), identity: fx.source)
    }
}

// A node whose only child names the MANIFEST's locator: a semantic requirement occupied by a corpus
// manifest.
fn closure_over_a_manifest_locator() -> OccupiedFixture {
  let inventory = a_store_holding_a_manifest()
  match insert_from_structure(
    store: inventory.store,
    kind: TypeNode { connective: Conj },
    children: [
      StoredEdge { label: Named { name: ^only_child }, target: SemanticNodeTarget { locator: inventory.manifest } },
    ],
  ) {
    LocatorCollision { identity: _, existing: _, incoming: _ } =>
      OccupiedFixture { store: empty_store(), root: SemanticNodeTarget { locator: fallback_id() }, child: fallback_id(), ok: false }
    Stored { store: s, node: parent } =>
      OccupiedFixture {
        store: s,
        root: node_target_of(reference: parent),
        child: inventory.manifest,
        ok: inventory.ok,
      }
  }
}

// THE RED. A manifest at a required node position refuses, and refuses AS A MANIFEST.
//
// The discrimination that matters is not that it refuses -- it is WHICH population names it. The
// available wrong answers were both well-formed: report it in `absent`, which says "fetch this and
// the closure completes" about a locator that is already occupied and cannot be repaired by any
// fetch; or fold it into `source_occupied`, which reports a manifest as a file. Both are answers of
// the right type and the wrong meaning. So this asserts the manifest population names it AND the
// other two are empty, which is what makes it a discrimination rather than a non-emptiness check.
test fn a_manifest_at_a_required_node_refuses_as_a_manifest() -> Bool {
  let fx = closure_over_a_manifest_locator()
  fx.ok
    && match admit_well_kinded_closure(
      closure: CommitClosure { store: fx.store, root: fx.root }
    ) {
      WellKinded { admitted: _, unresolved: _ } => false
      NotWellKinded { source_occupied: sources, manifest_occupied: manifests } =>
        (list_length(items: manifests) == 1)
          && names_exactly(missing: manifests, expected: fx.child)
          && (list_length(items: sources) == 0)
    }
    && (list_length(
      items: unresolved_identities(closure: CommitClosure { store: fx.store, root: fx.root })
    ) == 0)
}

// PARITY. The ordinary and partial admission routes derive the SAME population.
//
// THE UNRESOLVED POPULATION COMES FROM THE SAME DERIVATION AS THE IMAGE, and this is the claim that
// says so. `admit_partial_commit_closure` no longer walks the closure itself: it delegates to
// `admit_well_kinded_closure` and takes both the image and the unresolved population off the one
// admitted arm. If a later author restores a second walk in the partial route, the two populations
// become independently derived again -- which is the authority substitution this module already
// records catching once, at a different level -- and this claim is what goes red when they disagree.
//
// IT ASSERTS THE POPULATION, NOT MERELY THAT BOTH ARE NONEMPTY. Two independent walks of the same
// closure agree on a count far more readily than on membership, so a count-only assertion would let
// exactly the divergence this exists to catch pass.
test fn the_admitted_arm_and_the_partial_admission_report_one_unresolved_population() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  match admit_well_kinded_closure(closure: closure) {
    NotWellKinded { source_occupied: _, manifest_occupied: _ } => false
    WellKinded { admitted: _, unresolved: unresolved } =>
      match admit_partial_commit_closure(closure: closure, reason: ClosureTrimmedForTransfer) {
        ClosureCompleteSoNothingToAdmit => false
        ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
        PartialClosureAdmitted { admitted: a } =>
          list_length(items: unresolved) > 0
            && (unresolved == admitted_unresolved(admitted: a))
      }
  }
}

// This is the claim with no observable symptom until it is wrong. Both routes mint a
// WellKindedClosure, and until this cut the partial one built the carrier straight from its stored
// closure while the ordinary one ran the census -- so narrowing one and not the other would have
// left partial documents silently carrying the whole repository, with every other claim in this file
// still green. Mutating either route back to the raw store takes this red.
test fn both_admission_routes_derive_the_same_population() -> Bool {
  let full = build_full_store()
  let grafted = build_grafted_store()
  let closure = CommitClosure { store: grafted, root: full.root }
  match admit_partial_commit_closure(closure: closure, reason: ClosureTrimmedForTransfer) {
    ClosureCompleteSoNothingToAdmit => false
    ClosureRequiresNodeAtWrongKind { source_occupied: _, manifest_occupied: _ } => false
    PartialClosureAdmitted { admitted: a } =>
      match admit_well_kinded_closure(closure: closure) {
        NotWellKinded { source_occupied: _, manifest_occupied: _ } => false
        WellKinded { admitted: ordinary, unresolved: _ } =>
          match well_kinded_nodes(admitted: admitted_well_kinded(admitted: a)) {
            partial_nodes =>
              (list_length(items: partial_nodes)
                == list_length(items: well_kinded_nodes(admitted: ordinary)))
                && (list_length(items: partial_nodes) == 1)
                && nodes_hold(
                  nodes: partial_nodes,
                  identity: node_target_locator(target: full.root),
                )
          }
      }
  }
}
