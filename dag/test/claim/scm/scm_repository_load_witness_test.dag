module test.claim.scm_repository_load_witness

// THE LOAD BOUNDARY, ARM BY ARM. `load_repository` is the only place in gunbc.scm that touches the
// host filesystem, and its whole reason for existing is that four different things can go wrong
// with three different OWNERS. These claims exist to keep those four apart: each one drives a
// DIFFERENT arm and asserts the arm it reached, so collapsing any two of them fails here.
//
// WHY EACH ARM IS DRIVEN BY A SEPARATE FIXTURE rather than by one document mutated in place: the
// arms are reached at three different STAGES -- read, parse, decode -- and a single document
// cannot be simultaneously absent, unparseable and well-formed-but-refused. The fixtures are
// hand-authored rather than produced by `encode_repository`, so that a change to the encoder
// cannot silently move what this file calls a valid document.
//
// THE ABSENT-PATH CLAIM IS DELIBERATELY UNDER THE CHECKOUT ROOT. A path outside it (say /tmp)
// would be refused by the interpreter's hermetic carve-out as a host effect rather than answered
// as a failed read, and the claim would be measuring the sandbox instead of this module.

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.repository_load {
  RepositoryLoad,
  RepositoryLoaded,
  RepositoryLoadRefused,
  RepositoryLoadRefusal,
  RepositoryFileUnreadable,
  RepositoryDocumentUnparseable,
  RepositoryDocumentRefused,
  load_repository,
}
import gunbc.scm.repository_envelope {
  RepositoryDecodeRefusal,
  RepositoryFormatUnrecognized,
  repository_envelope_load_standing,
}
import gunbc.scm.load_standing {
  LoadStanding,
  LoadUnsupportedProtocol,
  LoadDocumentMalformed,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data scm_rl_empty_repository_path: String = "dag/test/fixture/scm_repository_load/empty_repository.json"
data scm_rl_malformed_document_path: String = "dag/test/fixture/scm_repository_load/malformed_document.json"
data scm_rl_unknown_format_path: String = "dag/test/fixture/scm_repository_load/unknown_format.json"
data scm_rl_frozen_v1_path: String = "dag/test/fixture/scm_repository_load/frozen_repository_v1.json"

// UNDER THE CHECKOUT ROOT AND NEVER CREATED. See the header: the location is the claim.
data scm_rl_absent_path: String = "dag/test/fixture/scm_repository_load/this_file_is_never_created.json"

test fn scm_rl_a_well_formed_document_loads() -> Bool {
  match load_repository(path: scm_rl_empty_repository_path) {
    RepositoryLoaded { path: p, envelope: _ } => p == scm_rl_empty_repository_path
    _ => false
  }
}

test fn scm_rl_an_absent_file_is_unreadable_not_empty() -> Bool {
  match load_repository(path: scm_rl_absent_path) {
    RepositoryLoadRefused { cause: RepositoryFileUnreadable { path: p, error: _ } } =>
      p == scm_rl_absent_path
    _ => false
  }
}

test fn scm_rl_a_truncated_document_is_unparseable() -> Bool {
  match load_repository(path: scm_rl_malformed_document_path) {
    RepositoryLoadRefused { cause: RepositoryDocumentUnparseable { path: p, gap: _ } } =>
      p == scm_rl_malformed_document_path
    _ => false
  }
}

// THE DISCRIMINATING ONE. A document that PARSES cleanly and is still not a repository must reach
// the decode arm and carry the schema's own refusal -- not the parse arm, whose remedy is "these
// bytes are damaged" rather than "this is a repository of a version I do not know".
test fn scm_rl_a_parseable_non_repository_is_refused_by_schema() -> Bool {
  match load_repository(path: scm_rl_unknown_format_path) {
    RepositoryLoadRefused { cause: RepositoryDocumentRefused { path: p, cause: c } } =>
      p == scm_rl_unknown_format_path &&
        match c {
          RepositoryFormatUnrecognized { found: f } => f == "gunbc-scm-repository-v99"
          _ => false
        }
    _ => false
  }
}

// A REAL FROZEN PREDECESSOR DOCUMENT, NOT AN INVENTED TAG.
//
// The claim above uses "gunbc-scm-repository-v99", a version that never existed. That proves the
// dispatch refuses a tag it does not know; it does NOT prove this build handles the format it
// actually superseded. Those are different questions, and only the second one has a document in the
// world -- this branch changed the tag from gunbc-scm-repository-v1 to -v2, so every repository
// written before it is a real artifact that a real caller can hand to this build today.
//
// The fixture is the v1 document verbatim from origin/main, carrying both v1 axes: the schema tag
// and the fnv1a64-structural-canonical-v1 identity rule this branch also replaced.
//
// THE ASSERTION IS THE STANDING, NOT MERELY THE REFUSAL, and that is the whole point. Refusing is
// easy and the wrong refusal is worse than none: "these bytes are damaged" sends a reader to look
// for corruption in a file that is perfectly intact, while "I do not speak this protocol" names a
// version gap with a real remedy. A refusal-only assertion cannot tell those apart, because both
// arms refuse.
test fn scm_rl_a_frozen_v1_document_is_a_protocol_gap_not_damage() -> Bool {
  match load_repository(path: scm_rl_frozen_v1_path) {
    RepositoryLoadRefused { cause: RepositoryDocumentRefused { path: p, cause: c } } =>
      p == scm_rl_frozen_v1_path
        && match c {
          RepositoryFormatUnrecognized { found: f } => f == "gunbc-scm-repository-v1"
          _ => false
        }
        && match repository_envelope_load_standing(cause: c) {
          LoadUnsupportedProtocol => true
          _ => false
        }
    _ => false
  }
}

// THE CONTROL THE CLAIM ABOVE NEEDS. Without it, a classifier that answered LoadUnsupportedProtocol
// for everything would satisfy it. A genuinely damaged document must still classify as malformed.
test fn scm_rl_a_damaged_document_is_not_a_protocol_gap() -> Bool {
  match load_repository(path: scm_rl_malformed_document_path) {
    RepositoryLoadRefused { cause: RepositoryDocumentUnparseable { path: p, gap: _ } } =>
      p == scm_rl_malformed_document_path
    RepositoryLoadRefused { cause: RepositoryDocumentRefused { path: _, cause: c } } =>
      match repository_envelope_load_standing(cause: c) {
        LoadDocumentMalformed => true
        _ => false
      }
    _ => false
  }
}

test fn scm_repository_load_keystone_holds() -> Bool {
  scm_rl_a_well_formed_document_loads() &&
    scm_rl_an_absent_file_is_unreadable_not_empty() &&
    scm_rl_a_truncated_document_is_unparseable() &&
    scm_rl_a_parseable_non_repository_is_refused_by_schema() &&
    scm_rl_a_frozen_v1_document_is_a_protocol_gap_not_damage() &&
    scm_rl_a_damaged_document_is_not_a_protocol_gap()
}
