module test.claim.scm_log_witness

import std.types { Bool, Int, String, List }
import std.minted_identity { MintedId, MintedIdAllocator }
import v2.std.node { Node, Symbol, TypeNode, Atom, node_synthetic }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.object_store {
  ObjectStore,
  ObjectId,
  empty_store,
  store_node,
  Stored,
  LocatorCollision,
}
import gunbc.scm.ancestry { RepositoryCommitRef }
import gunbc.scm.repository_envelope {
  RepositoryEnvelope,
  RepositoryCommitMinted,
  RepositoryCommitMintAllocatorInvalid,
  RepositoryCommitMintRootIsAuthoredSource,
  RepositoryCommitMintRootMissing,
  RepositoryCommitMintParentMissing,
  mint_repository_commit,
}
import gunbc.scm.log {
  repository_log,
  commit_log_is_fully_held,
  CommitLog,
  NoCommitsYet,
  CommitLogRows,
  CommitLogRow,
  LoggedCommitRootHeld,
  LoggedCommitRootIsAuthoredSource,
  LoggedCommitRootMissingFromStore,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Names qualified: top-level definitions are corpus-wide and the resolver silently selects among
// duplicates (#8707), a hazard this layer's other witness files already document hitting.
fn log_witness_atom(name: Symbol) -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: name } }, children: [])
}

type LogWitnessStored {
  store: ObjectStore
  identity: ObjectId
}

fn log_witness_store_one(store: ObjectStore, name: Symbol) -> LogWitnessStored {
  match store_node(store: store, n: log_witness_atom(name: name)) {
    Stored { store: next, identity: identity } =>
      LogWitnessStored { store: next, identity: identity }
    LocatorCollision { identity: identity, existing: _, incoming: _ } =>
      LogWitnessStored { store: store, identity: identity }
  }
}

fn log_witness_ref(ordinal: Int) -> RepositoryCommitRef {
  RepositoryCommitRef { identity: MintedId { ordinal: ordinal } }
}

fn log_witness_empty(store: ObjectStore) -> RepositoryEnvelope {
  RepositoryEnvelope {
    store: store,
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 0 },
    checked_out: none,
  }
}

fn log_witness_mint(repo: RepositoryEnvelope, root: ObjectId, message: String, parent: RepositoryCommitRef?) -> RepositoryEnvelope {
  match mint_repository_commit(repository: repo, root: root, message: message, parent: parent) {
    RepositoryCommitMinted { repository: minted, reference: _ } => minted
    RepositoryCommitMintAllocatorInvalid { next_ordinal: _ } => repo
    RepositoryCommitMintRootMissing { root: _ } => repo
    RepositoryCommitMintRootIsAuthoredSource { root: _ } => repo
    RepositoryCommitMintParentMissing { parent: _ } => repo
  }
}

fn log_witness_two_commit_repository() -> RepositoryEnvelope {
  let a = log_witness_store_one(store: empty_store(), name: ^a)
  let b = log_witness_store_one(store: a.store, name: ^b)
  let first = log_witness_mint(repo: log_witness_empty(store: b.store), root: a.identity, message: "first", parent: none)
  log_witness_mint(
    repo: first,
    root: b.identity,
    message: "second",
    parent: Present { value: log_witness_ref(ordinal: 0) },
  )
}

// A commit whose root was never stored. The envelope's encoder refuses on
// RepositoryCommitRootNotInStore, so this is a state the model already recognises.
fn log_witness_repository_with_unheld_root() -> RepositoryEnvelope {
  let a = log_witness_store_one(store: empty_store(), name: ^a)
  let orphan = log_witness_store_one(store: empty_store(), name: ^never_stored)
  let both = log_witness_store_one(store: a.store, name: ^never_stored)
  let held = log_witness_mint(repo: log_witness_empty(store: both.store), root: a.identity, message: "held", parent: none)
  let minted = log_witness_mint(repo: held, root: orphan.identity, message: "not held", parent: none)
  RepositoryEnvelope {
    store: a.store,
    commits: minted.commits,
    commit_allocator: minted.commit_allocator,
    checked_out: none,
  }
}

fn log_witness_row_messages(log: CommitLog) -> List<String> {
  match log {
    NoCommitsYet => []
    CommitLogRows { rows: rows } => map(rows, r => r.message)
  }
}

fn log_witness_row_references(log: CommitLog) -> List<RepositoryCommitRef> {
  match log {
    NoCommitsYet => []
    CommitLogRows { rows: rows } => map(rows, r => r.reference)
  }
}

// AN EMPTY HISTORY IS ITS OWN STATE, asserted as NoCommitsYet rather than as "no rows". Written as a
// row-count claim this would also be satisfied by CommitLogRows { rows: [] } -- the exact collapse
// the type exists to make unrepresentable, and the empty-observation narrow DESIGN rules strictly
// worse than a widen because a narrow is silently uncovered rather than merely expensive.
test fn a_fresh_repository_logs_no_commits_yet_rather_than_no_rows() -> Bool {
  match repository_log(envelope: RepositoryEnvelope {
    store: empty_store(),
    commits: [],
    commit_allocator: MintedIdAllocator { next_ordinal: 0 },
    checked_out: none,
  }) {
    NoCommitsYet => true
    CommitLogRows { rows: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE ABOVE, and without it answering NoCommitsYet for everything would
// pass: a repository that HAS commits must produce rows carrying their messages.
test fn a_repository_with_commits_logs_a_row_per_commit() -> Bool {
  log_witness_row_messages(log: repository_log(envelope: log_witness_two_commit_repository()))
    == ["first", "second"]
}

// ROWS COME BACK IN REFERENCE ORDER, AND ROW POSITION AGREES WITH THE REFERENCE IT ADVERTISES. This
// is the claim that makes a row actionable: the reference is the identifier a reader hands back to
// an operation that takes one, so a row whose reference did not match its position would send that
// reader to a different commit.
test fn row_references_are_the_commits_intrinsic_keys() -> Bool {
  log_witness_row_references(log: repository_log(envelope: log_witness_two_commit_repository()))
    == [log_witness_ref(ordinal: 0), log_witness_ref(ordinal: 1)]
}

// THE DUPLICATE-ROOT CASE, WHICH IS WHY THE REFERENCE IS DERIVED FROM POSITION RATHER THAN BY
// LOOKING THE ROOT UP. repository_envelope's header states that two commits may share a root and
// differ only in message -- they name the same program, "which is the point of content addressing
// and not a collision". An identity lookup answers the FIRST match, so both rows would advertise
// the first row's reference and the second commit would be unreachable through its own row's
// identifier.
test fn two_commits_sharing_a_root_still_get_distinct_references() -> Bool {
  let a = log_witness_store_one(store: empty_store(), name: ^shared)
  let first = log_witness_mint(repo: log_witness_empty(store: a.store), root: a.identity, message: "relabelled once", parent: none)
  let repo = log_witness_mint(repo: first, root: a.identity, message: "relabelled twice", parent: none)
  log_witness_row_references(log: repository_log(envelope: repo))
    == [log_witness_ref(ordinal: 0), log_witness_ref(ordinal: 1)]
    && log_witness_row_messages(log: repository_log(envelope: repo))
      == ["relabelled once", "relabelled twice"]
}

// A COMMIT NAMING A ROOT THE STORE DOES NOT HOLD IS MARKED, not listed as ordinary. Listing it
// silently would present a row that cannot be checked out as though it were fine -- the same
// reasoning that gives status its CheckedOutCommitMissing arm.
test fn a_commit_whose_root_is_not_held_is_marked_rather_than_listed_as_ordinary() -> Bool {
  match repository_log(envelope: log_witness_repository_with_unheld_root()) {
    NoCommitsYet => false
    CommitLogRows { rows: rows } =>
      map(rows, r => match r.standing {
        LoggedCommitRootHeld => "held"
        LoggedCommitRootMissingFromStore => "missing"
        LoggedCommitRootIsAuthoredSource => "source"
      }) == ["held", "missing"]
  }
}

// THE ROLL-UP, WITH ITS DISCRIMINATOR. A fully-held repository and a fresh one both answer true, and
// a repository with one unheld root answers false -- so the predicate distinguishes the state it
// names rather than tracking whether any rows exist.
test fn fully_held_distinguishes_an_unheld_root_from_a_healthy_or_empty_log() -> Bool {
  commit_log_is_fully_held(log: repository_log(envelope: log_witness_two_commit_repository()))
    && commit_log_is_fully_held(log: repository_log(envelope: RepositoryEnvelope {
      store: empty_store(),
      commits: [],
      commit_allocator: MintedIdAllocator { next_ordinal: 0 },
      checked_out: none,
    }))
    && !commit_log_is_fully_held(
      log: repository_log(envelope: log_witness_repository_with_unheld_root())
    )
}
