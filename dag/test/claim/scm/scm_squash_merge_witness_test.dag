module test.claim.scm_squash_merge_witness

// CONTROLS FOR THE MERGE VERB, WRITTEN TO WHAT A COMPOSITION GETS WRONG.
//
// THE TWO HALVES ARE ALREADY CONTROLLED ELSEWHERE and are not re-asserted here: merge_base's
// resurrection refusal has its own witness, and manifest_merge's four-line law has its own. What is
// unproven until this file exists is that the JOIN preserves them -- that the verb actually consults
// the base derivation rather than merging against a convenient commit, that a conflict stops the
// commit rather than being counted and passed over, and that the squash records the source as
// consumed so the SECOND merge is refused by the first one's receipt.
//
// THE FAILURE THIS SURFACE PRODUCES IS A SUCCESSFUL MERGE. Every wrong composition below returns a
// well-formed repository with a well-formed new commit; none of them throws. So no claim here
// asserts "a merge happened" -- each states the mutation it refutes.

import std.types { Bool, String, List, Int, NonEmptyStr }
import std.minted_identity { MintedId, MintedIdAllocator }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.object_store {
  ObjectId, object_id_eq,
  ObjectStore, empty_store,
  AuthoredSourceTarget, authored_source_target_of,
  SourceStored, SourceLocatorCollision, store_authored_source,
  CorpusManifestEntry, CorpusManifestObjectRef, CorpusManifestTarget,
  CorpusManifestStored, CorpusManifestDuplicatePath, CorpusManifestLocatorCollision,
  store_corpus_manifest,
  CorpusEntrySourceRefusal,
  CorpusEntrySourceMissing, CorpusEntrySourceIsSemanticNode, CorpusEntrySourceIsCorpusManifest,
}
import gunbc.scm.integration { NoSquashIntegration, SquashIntegrated }
import gunbc.scm.ancestry { RepositoryCommitRef, RootCommit, DescendsFrom, repository_commit_ref_eq }
import gunbc.scm.repository_envelope {
  MergeSideName, MergeBaseCommit, MergeSourceCommit, MergeTargetCommit, RepositoryEnvelope,
  commit_at_reference,
  RepositoryCommitMint, RepositoryCommitMinted, RepositoryCommitMintAllocatorInvalid,
  RepositoryCommitMintRootMissing, RepositoryCommitMintRootIsAuthoredSource,
  RepositoryCommitMintRootIsSemanticNode, RepositoryCommitMintParentMissing,
  mint_repository_commit,
}
import gunbc.scm.staging { StagedEntries, StagedEntriesRefused, staged_entries }
import gunbc.scm.repository_envelope {
  MergeBaseOutcome, MergeBaseDerived, MergeBaseSourceAlreadyConsumed,
  MergeBaseHistoryUnwalkable, MergeBaseHistoriesDisjoint, MergeBaseSourceIsAncestorOfTarget,
}
import gunbc.scm.manifest_merge { ManifestPathConflict, PathState, PathAbsent, PathPresent }
import gunbc.scm.squash_merge {
  SquashMergeOutcome,
  SquashMerged,
  SquashMergeBaseRefused,
  SquashMergeConflicted,
  SquashMergeRootMissing,
  SquashMergeRootIsAuthoredSource,
  SquashMergeRootIsSemanticNode,
  SquashMergeResultLocatorCollision,
  SquashMergeSourceUnrecoverable,
  SquashMergeAllocatorInvalid,
  squash_merge,
}
import test.fixture.scm_repository_builder {
  MbBuild, MbBuilt, MbSetupFailed,
  mb_start, mb_stage, mb_commit, mb_at, mb_head, mb_root_of,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SCENE IS A DIVERGENCE, NOT A FAST-FORWARD, and the distinction is load-bearing. If the target
// had not moved since the base, taking the source's manifest wholesale would be correct, and every
// claim below would pass against an implementation that ignores the base entirely. Both sides
// therefore move, and they move on DIFFERENT paths so the merge is mergeable:
//
//   C0   a = A0                        the shared base
//   T1   a = A0, t = T0    parent C0   the target adds its own path
//   S1   a = A0, s = S0    parent C0   the source adds a different path
//
// The correct merge of T1 and S1 holds all three paths. An implementation that took the source's
// manifest as the answer loses `t`; one that took the target's loses `s`; one that merged against
// the wrong base can lose either.
type Scene
  = Scene { build: MbBuild, base: RepositoryCommitRef, target: RepositoryCommitRef, source: RepositoryCommitRef }
  | SceneUnavailable

fn scene() -> Scene {
  let c0 = mb_commit(
    build: mb_stage(build: mb_start(), path: "a", text: "A0"),
    message: "base",
  )
  match mb_head(build: c0) {
    Absent => SceneUnavailable
    Present { value: base } =>
      let t1 = mb_commit(
        build: mb_stage(build: c0, path: "t", text: "T0"),
        message: "target",
      )
      match mb_head(build: t1) {
        Absent => SceneUnavailable
        Present { value: target } =>
          let s1 = mb_commit(
            build: mb_stage(build: mb_at(build: t1, target: base), path: "s", text: "S0"),
            message: "source",
          )
          match mb_head(build: s1) {
            Absent => SceneUnavailable
            Present { value: source } =>
              Scene { build: s1, base: base, target: target, source: source }
          }
      }
  }
}

fn scene_repository(s: Scene) -> RepositoryEnvelope? {
  match s {
    SceneUnavailable => none
    Scene { build: b, base: _, target: _, source: _ } =>
      match b {
        MbSetupFailed => none
        MbBuilt { repository: r, at: _ } => Present { value: r }
      }
  }
}

// READING THE COMMITTED CORPUS BACK OUT THROUGH THE ORDINARY STAGING READER rather than through the
// outcome value. A claim that inspected the entries it had just handed to the merge would assert
// that the merge returned its own argument; this asserts what the REPOSITORY now contains.
fn paths_after(repository: RepositoryEnvelope, at: RepositoryCommitRef) -> List<String> {
  match commit_at_reference(commits: repository.commits, reference: at) {
    Absent => []
    Present { value: c } =>
      match staged_entries(
        repository: RepositoryEnvelope {
          store: repository.store,
          commits: repository.commits,
          commit_allocator: repository.commit_allocator,
          checked_out: repository.checked_out,
          staged: Present { value: c.root },
        }
      ) {
        StagedEntriesRefused { cause: _ } => []
        StagedEntries { entries: entries } => map(entries, e => e.path as String)
      }
  }
}

// A CONFLICT WHOSE THREE SIDES ARE ALL PRESENT is what a modify-versus-modify looks like, and the
// claim states it rather than asserting a count, because a conflict reported with a fabricated
// absence would still be one conflict on one path.
fn state_is_present(state: PathState) -> Bool {
  match state {
    PathAbsent => false
    PathPresent { source: _ } => true
  }
}

fn conflict_is_all_present(conflict: ManifestPathConflict, path: String) -> Bool {
  (conflict.path as String) == path
    && state_is_present(state: conflict.base)
    && state_is_present(state: conflict.source)
    && state_is_present(state: conflict.target)
}

fn holds(paths: List<String>, path: String) -> Bool {
  fold(paths, init: false, f: fn(found, p) { found || p == path })
}

// THE MERGE TAKES BOTH SIDES' WORK, WHICH IS THE ONE THING A WRONG COMPOSITION CANNOT FAKE. Taking
// either side's manifest wholesale produces a valid repository and a valid commit; it just silently
// drops the other side's file.
test fn scm_sm_a_merge_carries_both_sides_paths() -> Bool {
  match scene() {
    SceneUnavailable => false
    Scene { build: _, base: _, target: target, source: source } =>
      match scene_repository(s: scene()) {
        Absent => false
        Present { value: repository } =>
          match squash_merge(
            repository: repository,
            target: target,
            source: source,
            message: "merge",
          ) {
            SquashMerged { repository: merged, reference: at } =>
              let paths = paths_after(repository: merged, at: at)
              count(paths) == 3
                && holds(paths: paths, path: "a")
                && holds(paths: paths, path: "t")
                && holds(paths: paths, path: "s")
            SquashMergeConflicted { conflicts: _ } => false
            SquashMergeBaseRefused { refusal: _ } => false
            SquashMergeRootMissing { side: _, root: _ } => false
            SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
            SquashMergeRootIsSemanticNode { side: _, root: _ } => false
            SquashMergeSourceUnrecoverable { cause: _ } => false
            SquashMergeResultLocatorCollision { identity: _ } => false
            SquashMergeAllocatorInvalid => false
          }
      }
  }
}

// THE RESULT'S PARENT IS THE TARGET AND ITS INTEGRATION NAMES THE SOURCE. This is the operator's
// squash workflow as a structural fact rather than a convention: ONE lineage edge, and the source
// recorded as consumed rather than as a second parent. An implementation that parented the merge on
// the SOURCE also produces a valid repository holding all three paths, so the previous claim does
// not separate it from this one.
test fn scm_sm_the_result_parents_the_target_and_records_the_source_consumed() -> Bool {
  match scene() {
    SceneUnavailable => false
    Scene { build: _, base: _, target: target, source: source } =>
      match scene_repository(s: scene()) {
        Absent => false
        Present { value: repository } =>
          match squash_merge(
            repository: repository,
            target: target,
            source: source,
            message: "merge",
          ) {
            SquashMerged { repository: merged, reference: at } =>
              match commit_at_reference(commits: merged.commits, reference: at) {
                Absent => false
                Present { value: c } =>
                  match c.integration {
                    NoSquashIntegration => false
                    SquashIntegrated { source: recorded } =>
                      repository_commit_ref_eq(left: recorded, right: source)
                        && match c.ancestry {
                             RootCommit => false
                             DescendsFrom { parent: p } =>
                               repository_commit_ref_eq(left: p, right: target)
                           }
                  }
              }
            SquashMergeConflicted { conflicts: _ } => false
            SquashMergeBaseRefused { refusal: _ } => false
            SquashMergeRootMissing { side: _, root: _ } => false
            SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
            SquashMergeRootIsSemanticNode { side: _, root: _ } => false
            SquashMergeSourceUnrecoverable { cause: _ } => false
            SquashMergeResultLocatorCollision { identity: _ } => false
            SquashMergeAllocatorInvalid => false
          }
      }
  }
}

// MERGING THE SAME SOURCE TWICE IS REFUSED BY THE FIRST MERGE'S OWN RECEIPT, and it is refused
// THROUGH THE BASE DERIVATION rather than by a check this module added. That is what makes the
// composition load-bearing: a verb that derived its base by any other route would merge again
// happily, and the resurrection merge_base exists to prevent would arrive through the verb.
test fn scm_sm_merging_the_same_source_twice_is_refused_by_the_first_merges_receipt() -> Bool {
  match scene() {
    SceneUnavailable => false
    Scene { build: _, base: _, target: target, source: source } =>
      match scene_repository(s: scene()) {
        Absent => false
        Present { value: repository } =>
          match squash_merge(
            repository: repository,
            target: target,
            source: source,
            message: "merge",
          ) {
            SquashMerged { repository: merged, reference: at } =>
              match squash_merge(
                repository: merged,
                target: at,
                source: source,
                message: "merge again",
              ) {
                SquashMergeBaseRefused { refusal: r } =>
                  match r {
                    MergeBaseSourceAlreadyConsumed { recorded_at: rec, consumed: cons, source: _ } =>
                      repository_commit_ref_eq(left: rec, right: at)
                        && repository_commit_ref_eq(left: cons, right: source)
                    MergeBaseDerived { anchors: _ } => false
                    MergeBaseHistoryUnwalkable { side: _, walk: _ } => false
                    MergeBaseHistoriesDisjoint { target: _, source: _ } => false
                    MergeBaseSourceIsAncestorOfTarget { target: _, source: _ } => false
                  }
                SquashMerged { repository: _, reference: _ } => false
                SquashMergeConflicted { conflicts: _ } => false
                SquashMergeRootMissing { side: _, root: _ } => false
                SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
                SquashMergeRootIsSemanticNode { side: _, root: _ } => false
                SquashMergeSourceUnrecoverable { cause: _ } => false
            SquashMergeResultLocatorCollision { identity: _ } => false
                SquashMergeAllocatorInvalid => false
              }
            SquashMergeConflicted { conflicts: _ } => false
            SquashMergeBaseRefused { refusal: _ } => false
            SquashMergeRootMissing { side: _, root: _ } => false
            SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
            SquashMergeRootIsSemanticNode { side: _, root: _ } => false
            SquashMergeSourceUnrecoverable { cause: _ } => false
            SquashMergeResultLocatorCollision { identity: _ } => false
            SquashMergeAllocatorInvalid => false
          }
      }
  }
}

// A CONFLICT STOPS THE LINE. The scene is re-cut so both sides modify the SAME path to different
// content, which the four-line law refuses. What this claim adds over manifest_merge's own controls
// is that the refusal REACHES THE REPOSITORY: no commit is minted, the conflict population arrives
// intact, and the commit list is unchanged -- a verb that counted the conflicts and committed the
// mergeable remainder would produce a corpus neither author wrote.
test fn scm_sm_a_conflicting_path_mints_no_commit() -> Bool {
  let c0 = mb_commit(
    build: mb_stage(build: mb_start(), path: "a", text: "A0"),
    message: "base",
  )
  match mb_head(build: c0) {
    Absent => false
    Present { value: base } =>
      let t1 = mb_commit(
        build: mb_stage(build: c0, path: "a", text: "TARGET"),
        message: "target",
      )
      match mb_head(build: t1) {
        Absent => false
        Present { value: target } =>
          let s1 = mb_commit(
            build: mb_stage(build: mb_at(build: t1, target: base), path: "a", text: "SOURCE"),
            message: "source",
          )
          match mb_head(build: s1) {
            Absent => false
            Present { value: source } =>
              match s1 {
                MbSetupFailed => false
                MbBuilt { repository: repository, at: _ } =>
                  let before = count(repository.commits)
                  match squash_merge(
                    repository: repository,
                    target: target,
                    source: source,
                    message: "merge",
                  ) {
                    SquashMergeConflicted { conflicts: conflicts } =>
                      count(conflicts) == 1
                        && count(repository.commits) == before
                        && fold(conflicts, init: false, f: fn(seen, c) {
                             seen || conflict_is_all_present(conflict: c, path: "a")
                           })
                    SquashMerged { repository: _, reference: _ } => false
                    SquashMergeBaseRefused { refusal: _ } => false
                    SquashMergeRootMissing { side: _, root: _ } => false
                    SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
                    SquashMergeRootIsSemanticNode { side: _, root: _ } => false
                    SquashMergeSourceUnrecoverable { cause: _ } => false
            SquashMergeResultLocatorCollision { identity: _ } => false
                    SquashMergeAllocatorInvalid => false
                  }
              }
          }
      }
  }
}

// THE MERGE-SIDE COMPLETENESS CONTROL, AND WHY THE EXISTING BATTERY DID NOT COVER IT.
//
// `admit_merge_subject` refuses a conflict-free merge whose result retains an entry this store cannot
// produce bytes for. Every claim above builds its sources through the repository builder, which always
// stores the bytes it names -- so all four passed against a merge with NO completeness observation at
// all. External review found this: acknowledging `SquashMergeSourceUnrecoverable` in an exhaustive
// match is not evidence, because an arm no scene reaches is a decoration (DESIGN section 4b).
//
// The scene keeps the divergence shape of `scene()` above and changes exactly one fact: the path the
// BASE contributes -- inherited unchanged by both sides, so it survives any correct merge -- names an
// authored source that was written into a store which was then discarded. The merge is therefore
// conflict-free and its result is unrecoverable, which is precisely the state that would otherwise
// mint a commit and spend the source with a `SquashIntegrated` receipt.
//
//   C0   ghost = <absent>                       the base contributes the unrecoverable path
//   T1   ghost = <absent>, t = T0   parent C0
//   S1   ghost = <absent>, s = S0   parent C0
//
// `present: true` writes those same bytes into the store the repository actually keeps. Nothing else
// differs, so the pair isolates source presence and nothing else.
type SmPartial
  = SmPartialReady {
      repository: RepositoryEnvelope,
      target: RepositoryCommitRef,
      source: RepositoryCommitRef,
    }
  | SmPartialUnavailable

fn sm_ghost_target() -> AuthoredSourceTarget? {
  match store_authored_source(store: empty_store(), text: "module ghost") {
    SourceLocatorCollision { identity: _, existing: _, incoming: _ } => none
    SourceStored { store: _, source: source } =>
      Present { value: authored_source_target_of(reference: source) }
  }
}

fn sm_seeded_store(present: Bool) -> ObjectStore {
  if present {
    match store_authored_source(store: empty_store(), text: "module ghost") {
      SourceLocatorCollision { identity: _, existing: _, incoming: _ } => empty_store()
      SourceStored { store: next, source: _ } => next
    }
  } else {
    empty_store()
  }
}

fn sm_partial_scene(present: Bool) -> SmPartial {
  match sm_ghost_target() {
    Absent => SmPartialUnavailable
    Present { value: ghost } =>
      match store_authored_source(store: sm_seeded_store(present: present), text: "module t") {
        SourceLocatorCollision { identity: _, existing: _, incoming: _ } => SmPartialUnavailable
        SourceStored { store: s1, source: t_src } =>
          match store_authored_source(store: s1, text: "module s") {
            SourceLocatorCollision { identity: _, existing: _, incoming: _ } => SmPartialUnavailable
            SourceStored { store: s2, source: s_src } =>
              sm_partial_manifests(
                store: s2,
                ghost: ghost,
                t_src: authored_source_target_of(reference: t_src),
                s_src: authored_source_target_of(reference: s_src),
              )
          }
      }
  }
}

fn sm_partial_manifests(
  store: ObjectStore,
  ghost: AuthoredSourceTarget,
  t_src: AuthoredSourceTarget,
  s_src: AuthoredSourceTarget,
) -> SmPartial {
  let ghost_entry = CorpusManifestEntry { path: "ghost.dag" as NonEmptyStr, source: ghost }
  match store_corpus_manifest(store: store, entries: [ghost_entry]) {
    CorpusManifestDuplicatePath { path: _ } => SmPartialUnavailable
    CorpusManifestLocatorCollision { identity: _, existing: _, incoming: _ } => SmPartialUnavailable
    CorpusManifestStored { store: m0s, manifest: m0 } =>
      match store_corpus_manifest(
        store: m0s,
        entries: [ghost_entry, CorpusManifestEntry { path: "t.dag" as NonEmptyStr, source: t_src }],
      ) {
        CorpusManifestDuplicatePath { path: _ } => SmPartialUnavailable
        CorpusManifestLocatorCollision { identity: _, existing: _, incoming: _ } => SmPartialUnavailable
        CorpusManifestStored { store: m1s, manifest: m1 } =>
          match store_corpus_manifest(
            store: m1s,
            entries: [ghost_entry, CorpusManifestEntry { path: "s.dag" as NonEmptyStr, source: s_src }],
          ) {
            CorpusManifestDuplicatePath { path: _ } => SmPartialUnavailable
            CorpusManifestLocatorCollision { identity: _, existing: _, incoming: _ } =>
              SmPartialUnavailable
            CorpusManifestStored { store: m2s, manifest: m2 } =>
              sm_partial_commits(
                repository: RepositoryEnvelope {
                  store: m2s,
                  commits: [],
                  commit_allocator: MintedIdAllocator { next_ordinal: 0 },
                  checked_out: none,
                  staged: none,
                },
                m0: m0,
                m1: m1,
                m2: m2,
              )
          }
      }
  }
}

fn sm_partial_commits(
  repository: RepositoryEnvelope,
  m0: CorpusManifestObjectRef,
  m1: CorpusManifestObjectRef,
  m2: CorpusManifestObjectRef,
) -> SmPartial {
  match mint_repository_commit(
    repository: repository,
    root: CorpusManifestTarget { locator: m0.locator },
    message: "base",
    parent: none,
  ) {
    RepositoryCommitMinted { repository: r0, reference: c0 } =>
      match mint_repository_commit(
        repository: r0,
        root: CorpusManifestTarget { locator: m1.locator },
        message: "target",
        parent: Present { value: c0 },
      ) {
        RepositoryCommitMinted { repository: r1, reference: t1 } =>
          match mint_repository_commit(
            repository: r1,
            root: CorpusManifestTarget { locator: m2.locator },
            message: "source",
            parent: Present { value: c0 },
          ) {
            RepositoryCommitMinted { repository: r2, reference: s1 } =>
              SmPartialReady { repository: r2, target: t1, source: s1 }
            RepositoryCommitMintAllocatorInvalid { next_ordinal: _ } => SmPartialUnavailable
            RepositoryCommitMintRootMissing { root: _ } => SmPartialUnavailable
            RepositoryCommitMintRootIsAuthoredSource { root: _ } => SmPartialUnavailable
            RepositoryCommitMintRootIsSemanticNode { root: _ } => SmPartialUnavailable
            RepositoryCommitMintParentMissing { parent: _ } => SmPartialUnavailable
          }
        RepositoryCommitMintAllocatorInvalid { next_ordinal: _ } => SmPartialUnavailable
        RepositoryCommitMintRootMissing { root: _ } => SmPartialUnavailable
        RepositoryCommitMintRootIsAuthoredSource { root: _ } => SmPartialUnavailable
        RepositoryCommitMintRootIsSemanticNode { root: _ } => SmPartialUnavailable
        RepositoryCommitMintParentMissing { parent: _ } => SmPartialUnavailable
      }
    RepositoryCommitMintAllocatorInvalid { next_ordinal: _ } => SmPartialUnavailable
    RepositoryCommitMintRootMissing { root: _ } => SmPartialUnavailable
    RepositoryCommitMintRootIsAuthoredSource { root: _ } => SmPartialUnavailable
    RepositoryCommitMintRootIsSemanticNode { root: _ } => SmPartialUnavailable
    RepositoryCommitMintParentMissing { parent: _ } => SmPartialUnavailable
  }
}

fn sm_names_the_ghost(cause: CorpusEntrySourceRefusal) -> Bool {
  match cause {
    CorpusEntrySourceMissing { path: p, source: _ } => (p as String) == "ghost.dag"
    CorpusEntrySourceIsSemanticNode { path: _, source: _ } => false
    CorpusEntrySourceIsCorpusManifest { path: _, source: _ } => false
  }
}

// THE DISCRIMINATING RED. Deleting the completeness observation from `admit_merge_subject` turns this
// into a `SquashMerged`, which is the defect: a commit published over bytes that cannot be recovered,
// with the source spent.
test fn scm_sm_a_conflict_free_merge_over_an_absent_source_refuses_naming_the_path() -> Bool {
  match sm_partial_scene(present: false) {
    SmPartialUnavailable => false
    SmPartialReady { repository: r, target: t, source: sc } =>
      match squash_merge(repository: r, target: t, source: sc, message: "merge the unrecoverable") {
        SquashMergeSourceUnrecoverable { cause: c } => sm_names_the_ghost(cause: c)
        SquashMerged { repository: _, reference: _ } => false
        SquashMergeConflicted { conflicts: _ } => false
        SquashMergeBaseRefused { refusal: _ } => false
        SquashMergeRootMissing { side: _, root: _ } => false
        SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
        SquashMergeRootIsSemanticNode { side: _, root: _ } => false
        SquashMergeResultLocatorCollision { identity: _ } => false
        SquashMergeAllocatorInvalid => false
      }
  }
}

// THE POSITIVE CONTROL. Identical scene, ghost bytes present. Without it, a merge that refused
// everything would satisfy the claim above, and a merge that never merges is not a safer merge.
test fn scm_sm_the_same_merge_succeeds_once_the_source_is_present() -> Bool {
  match sm_partial_scene(present: true) {
    SmPartialUnavailable => false
    SmPartialReady { repository: r, target: t, source: sc } =>
      match squash_merge(repository: r, target: t, source: sc, message: "merge the recoverable") {
        SquashMerged { repository: _, reference: _ } => true
        SquashMergeSourceUnrecoverable { cause: _ } => false
        SquashMergeConflicted { conflicts: _ } => false
        SquashMergeBaseRefused { refusal: _ } => false
        SquashMergeRootMissing { side: _, root: _ } => false
        SquashMergeRootIsAuthoredSource { side: _, root: _ } => false
        SquashMergeRootIsSemanticNode { side: _, root: _ } => false
        SquashMergeResultLocatorCollision { identity: _ } => false
        SquashMergeAllocatorInvalid => false
      }
  }
}

test fn scm_squash_merge_witnesses_hold() -> Bool {
  scm_sm_a_merge_carries_both_sides_paths()
    && scm_sm_the_result_parents_the_target_and_records_the_source_consumed()
    && scm_sm_merging_the_same_source_twice_is_refused_by_the_first_merges_receipt()
    && scm_sm_a_conflicting_path_mints_no_commit()
    && scm_sm_a_conflict_free_merge_over_an_absent_source_refuses_naming_the_path()
    && scm_sm_the_same_merge_succeeds_once_the_source_is_present()
}
