module test.claim.cursor_pinned_program_witness

import std.types { Bool, String, NonEmptyStr, List, Int }
import std.optional { Present, Absent }
import extdeps.exec.command { argv_words }
import extdeps.llm.cursor_cli { cursor_status_command, cursor_sandbox_preflight_command, cursor_disable_auto_update_flag }
import gunbc.host.cursor_agent_realization { cursor_agent_pinned_program, cursor_agent_executable_path, cursor_agent_pinned_version }
import gunbc.cursor_harness_credential { cursor_worker_turn_inner_argv, cursor_sandbox_discriminating_preflight_command }
import gunbc.worker_turn_standing { cursor_pinned_executable_absent, cursor_pinned_realization_absent_reason }

fn pinned_path() -> String {
  cursor_agent_executable_path(version: cursor_agent_pinned_version)
}

fn word_at(words: List<String>, index: Int) -> String {
  match words.get(index: index) {
    Present { value: w } => w
    Absent => ""
  }
}

// THE THREE OPERATIONS SHARE ONE PROGRAM: each argv starts with the same pinned absolute path, supplied
// as the one identity (gunbc.host.cursor_agent_realization cursor_agent_pinned_program).
test fn status_preflight_and_turn_start_with_the_one_pinned_path() -> Bool {
  let program = cursor_agent_pinned_program()
  let status = word_at(index: 0, words: argv_words(command: cursor_status_command(program: program)))
  let preflight = word_at(index: 0, words: argv_words(command: cursor_sandbox_preflight_command(program: program)))
  let turn = word_at(index: 0, words: cursor_worker_turn_inner_argv(program: program, worktree_path: "/srv/attempt", prompt: "go" as NonEmptyStr))
  starts_with(s: pinned_path(), prefix: "/opt/gunbc/cursor-agent/")
    && status == pinned_path() && preflight == pinned_path() && turn == pinned_path()
}

// The discriminating preflight the draw runs keeps the program after its env prefix.
test fn the_discriminating_preflight_names_the_pinned_path_and_no_path_name() -> Bool {
  let line = join(argv_words(command: cursor_sandbox_discriminating_preflight_command(program: cursor_agent_pinned_program())), " ")
  string_contains(s: line, pattern: pinned_path()) && !string_contains(s: line, pattern: " cursor-agent ")
}

// THE FLAG IS PRESENT ON EVERY PINNED INVOCATION, directly after the program.
test fn every_pinned_invocation_passes_disable_auto_update() -> Bool {
  let program = cursor_agent_pinned_program()
  let flag = cursor_disable_auto_update_flag
  flag == "--disable-auto-update"
    && word_at(index: 1, words: argv_words(command: cursor_status_command(program: program))) == flag
    && word_at(index: 1, words: argv_words(command: cursor_sandbox_preflight_command(program: program))) == flag
    && word_at(index: 1, words: cursor_worker_turn_inner_argv(program: program, worktree_path: "/srv/attempt", prompt: "go" as NonEmptyStr)) == flag
}

// AN ABSENT PINNED EXECUTABLE REFUSES TYPED: sh's not-found status reads as absence and the reason names
// the pinned realization; any other status does not.
test fn an_unrunnable_pinned_path_reads_as_the_missing_realization() -> Bool {
  let reason = cursor_pinned_realization_absent_reason() as String
  cursor_pinned_executable_absent(exit_code: 127)
    && !cursor_pinned_executable_absent(exit_code: 0)
    && !cursor_pinned_executable_absent(exit_code: 1)
    && string_contains(s: reason, pattern: "pinned cursor-agent realization is not installed")
    && string_contains(s: reason, pattern: pinned_path())
    && string_contains(s: reason, pattern: "never falls back to a PATH")
}
