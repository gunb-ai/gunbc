module test.claim.build_cache_instance_readiness


fn owner_fixture() -> gunbc.build_cache_instance.ProcessIdentity {
  gunbc.build_cache_instance.ProcessIdentity {
    boot_id: "73c8153e-0e0e-4480-a36c-bc7560c50e8b" as NonEmptyStr,
    pid: 3975946,
    start_time: "79870020" as NonEmptyStr,
  }
}

fn declared_session_instance() -> gunbc.build_cache_instance.BuildCacheInstance {
  let base = gunbc.build_cache_instance.session_cache_instance(host: "srv1")
  gunbc.build_cache_instance.BuildCacheInstance {
    identity: base.identity,
    implementation: base.implementation,
    endpoint: base.endpoint,
    intended_unit: base.intended_unit,
    intended_principal: base.intended_principal,
    intended_storage: base.intended_storage,
    intended_capacity: base.intended_capacity,
    intended_compile_pool: gunbc.host_layout.CompilePoolSliceDeclared { slice_unit: gunbc.host_layout.gunbc_managed_compile_pool_slice as String },
  }
}

fn declared_ci_instance() -> gunbc.build_cache_instance.BuildCacheInstance {
  let base = gunbc.build_cache_instance.ci_cache_instance(host: "srv1")
  gunbc.build_cache_instance.BuildCacheInstance {
    identity: base.identity,
    implementation: base.implementation,
    endpoint: base.endpoint,
    intended_unit: base.intended_unit,
    intended_principal: base.intended_principal,
    intended_storage: base.intended_storage,
    intended_capacity: base.intended_capacity,
    intended_compile_pool: gunbc.host_layout.CompilePoolSliceDeclared { slice_unit: gunbc.host_layout.gunbc_managed_compile_pool_slice as String },
  }
}

fn ready_pool() -> gunbc.runner_activation.HostCompilePoolReady {
  gunbc.runner_activation.HostCompilePoolReady {
    host: "srv1" as product.placement_supply.HostIdentity,
    slice_unit: gunbc.host_layout.gunbc_managed_compile_pool_slice,
    pool_declared: true,
    pool_observed: true,
  }
}

fn endpoint_for(instance: gunbc.build_cache_instance.BuildCacheInstance, cgroup: NonEmptyStr) -> gunbc.build_cache_instance.BuildCacheEndpointObservation {
  gunbc.build_cache_instance.EndpointOwnerObserved {
    instance: instance,
    owner: owner_fixture(),
    executable: extdeps.cache.sccache.sccache_installed_binary_path as NonEmptyStr,
    principal: instance.intended_principal,
    owner_context: gunbc.build_cache_instance.OwnerInSystemdUnit { unit: instance.intended_unit, observed_cgroup: cgroup },
    memory_limits: none,
    memory_events: none,
  }
}

fn storage_for(instance: gunbc.build_cache_instance.BuildCacheInstance) -> gunbc.build_cache_instance.BuildCacheStorageObservation {
  gunbc.build_cache_instance.BuildCacheStorageObserved {
    instance: instance,
    owner: owner_fixture(),
    configuration: gunbc.build_cache_instance.BuildCacheStorageRootConfigured { root: instance.intended_storage },
  }
}

fn capacity_for(instance: gunbc.build_cache_instance.BuildCacheInstance) -> gunbc.build_cache_instance.BuildCacheCapacityObservation {
  gunbc.build_cache_instance.BuildCacheCapacityObserved {
    instance: instance,
    owner: owner_fixture(),
    configuration: gunbc.build_cache_instance.BuildCacheCapacityConfigured { capacity: std.measure.gibibyte_to_byte_size(g: std.measure.gibibyte(50)) },
  }
}

test fn exact_observations_mint_the_proof_receipt() -> Bool {
  let instance = declared_session_instance()
  match derive_build_cache_instance_readiness(
    endpoint: endpoint_for(instance: instance, cgroup: "/gunbc-compile-pool.slice/gunbc-build-cache-session.service" as NonEmptyStr),
    storage: storage_for(instance: instance),
    capacity: capacity_for(instance: instance),
    pool: ready_pool(),
  ) {
    BuildCacheInstanceObservedReady { receipt: r } =>
      r.instance == instance && r.owner == owner_fixture()
    BuildCacheInstanceObservedNotReady { reason: _ } => false
    BuildCacheInstanceObservationUnavailable { reason: _ } => false
  }
}

test fn a_ready_slice_beside_the_server_does_not_verify_nesting() -> Bool {
  let instance = declared_session_instance()
  match derive_build_cache_instance_readiness(
    endpoint: endpoint_for(instance: instance, cgroup: "/system.slice/gunbc-build-cache-session.service" as NonEmptyStr),
    storage: storage_for(instance: instance),
    capacity: capacity_for(instance: instance),
    pool: ready_pool(),
  ) {
    BuildCacheInstanceObservedNotReady { reason: CacheOwnerOutsidePool } => true
    BuildCacheInstanceObservedReady { receipt: _ } => false
    BuildCacheInstanceObservedNotReady { reason: _ } => false
    BuildCacheInstanceObservationUnavailable { reason: _ } => false
  }
}

test fn unavailable_dominates_a_positive_mismatch() -> Bool {
  let instance = declared_session_instance()
  match derive_build_cache_instance_readiness(
    endpoint: endpoint_for(instance: instance, cgroup: "/system.slice/wrong.service" as NonEmptyStr),
    storage: gunbc.build_cache_instance.BuildCacheStorageObservationUnavailable {
      instance: instance,
      owner: owner_fixture(),
      detail: "/proc owner environment read failed" as NonEmptyStr,
    },
    capacity: capacity_for(instance: instance),
    pool: ready_pool(),
  ) {
    BuildCacheInstanceObservationUnavailable { reason: CacheStorageObservationUnavailable { detail: d } } =>
      (d as String).contains("environment")
    BuildCacheInstanceObservedReady { receipt: _ } => false
    BuildCacheInstanceObservedNotReady { reason: _ } => false
    BuildCacheInstanceObservationUnavailable { reason: _ } => false
  }
}

test fn foreign_unavailable_observation_cannot_classify_this_instance() -> Bool {
  let instance = declared_session_instance()
  match derive_build_cache_instance_readiness(
    endpoint: endpoint_for(instance: instance, cgroup: "/gunbc-compile-pool.slice/gunbc-build-cache-session.service" as NonEmptyStr),
    storage: gunbc.build_cache_instance.BuildCacheStorageObservationUnavailable {
      instance: declared_ci_instance(),
      owner: owner_fixture(),
      detail: "/proc owner environment read failed" as NonEmptyStr,
    },
    capacity: capacity_for(instance: instance),
    pool: ready_pool(),
  ) {
    BuildCacheInstanceObservedNotReady { reason: CacheObservationSubjectMismatch { axis: a } } =>
      (a as String) == "storage"
    BuildCacheInstanceObservedReady { receipt: _ } => false
    BuildCacheInstanceObservedNotReady { reason: _ } => false
    BuildCacheInstanceObservationUnavailable { reason: _ } => false
  }
}

test fn absent_capacity_intent_is_not_vacuously_verified() -> Bool {
  let instance = declared_ci_instance()
  match derive_build_cache_instance_readiness(
    endpoint: endpoint_for(instance: instance, cgroup: "/gunbc-compile-pool.slice/gunbc-build-cache-ci.service" as NonEmptyStr),
    storage: storage_for(instance: instance),
    capacity: gunbc.build_cache_instance.BuildCacheCapacityObserved {
      instance: instance,
      owner: owner_fixture(),
      configuration: gunbc.build_cache_instance.BuildCacheCapacityConfigured { capacity: std.measure.gibibyte_to_byte_size(g: std.measure.gibibyte(10)) },
    },
    pool: ready_pool(),
  ) {
    BuildCacheInstanceObservedNotReady { reason: CacheCapacityIntentUndeclared } => true
    BuildCacheInstanceObservedReady { receipt: _ } => false
    BuildCacheInstanceObservedNotReady { reason: _ } => false
    BuildCacheInstanceObservationUnavailable { reason: _ } => false
  }
}
