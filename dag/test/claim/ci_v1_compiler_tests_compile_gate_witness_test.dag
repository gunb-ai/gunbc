module test.claim.ci_v1_compiler_tests_compile_gate_witness

import v2.workflow.ci_v1_compiler_tests_compile_gate_emit {
  ci_v1_compiler_tests_compile_gate_script,
  ci_v1_compiler_tests_compile_gate_shell_emit_scaffold,
}
import gunbc.ci_spec {
  ci_v1_compiler_tests_compile_gate_run_script,
  ci_release_features,
}
import gunbc.ci_workflow { ci_build_job }
import gunbc.ci_materialization { step_display_name }
import extdeps.github.actions { Step, RunStep, UsesStep }
import std.disposition { Scaffold }

data compile_gate_step_name: String = "cargo test -p v1-compiler-tests --release --no-run (compile-contract gate; reuses release v1-compiler)"
data release_build_step_name: String = "Build release bins (claim_executor + gunbc)"

fn step_index_of(steps: List<Step>, name: String) -> Int {
  let seen = fold(steps, init: { idx: 0, hit: 0 - 1 }, f: fn(acc, s) {
    if step_display_name(s: s) == name {
      if acc.hit >= 0 { { idx: acc.idx + 1, hit: acc.hit } } else { { idx: acc.idx + 1, hit: acc.idx } }
    } else {
      { idx: acc.idx + 1, hit: acc.hit }
    }
  })
  seen.hit
}

test fn w_gate_script_names_release_test_no_run_command() -> Bool {
  let script = ci_v1_compiler_tests_compile_gate_script()
  string_contains(s: script, pattern: "'test'")
    && string_contains(s: script, pattern: "'v1-compiler-tests'")
    && string_contains(s: script, pattern: "'--release'")
    && string_contains(s: script, pattern: "'--no-run'")
    && string_contains(s: script, pattern: "\"$CARGO_BIN\"")
    && !string_contains(s: script, pattern: "'check'")
    && !string_contains(s: script, pattern: "nextest")
}

test fn w_gate_run_script_is_cargo_test_no_run_only() -> Bool {
  let script = ci_v1_compiler_tests_compile_gate_run_script()
  string_contains(s: script, pattern: "'test'")
    && string_contains(s: script, pattern: "'v1-compiler-tests'")
    && string_contains(s: script, pattern: "'--release'")
    && string_contains(s: script, pattern: "'--no-run'")
    && !string_contains(s: script, pattern: "compile_contract_admission_witness")
    && !string_contains(s: script, pattern: "CompileContractAdmissionReceipt")
}

test fn w_gate_carrier_is_scaffold() -> Bool {
  match ci_v1_compiler_tests_compile_gate_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
    _ => false
  }
}

test fn w_build_job_enrolls_compile_gate_after_release_build() -> Bool {
  let steps = ci_build_job().steps
  let build = step_index_of(steps: steps, name: release_build_step_name)
  let gate = step_index_of(steps: steps, name: compile_gate_step_name)
  (build >= 0) && (gate >= 0) && (build < gate)
}

test fn w_release_features_align_test_crate_deps() -> Bool {
  string_contains(s: ci_release_features, pattern: "text_lookup_work_counter")
    && string_contains(s: ci_release_features, pattern: "interp_test_witness")
    && string_contains(s: ci_release_features, pattern: "test_hooks")
}
