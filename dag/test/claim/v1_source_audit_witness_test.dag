module test.claim.v1_source_audit_witness_test

import extdeps.filesystem.filesystem_io
import extdeps.languages.rust.emit {
  rt_functions,
  rt_wraps_result,
  rt_bridge_function_names,
  rust_method_templates,
  rust_method_wraps_result,
}
import extdeps.languages.python.emit { python_method_templates_flat }
import extdeps.languages.go.emit { go_method_templates_flat }

data v1_source_audit_witness_provenance: String = "Floor witnesses migrated from src/v1/tests/src/source_audit.rs (41-test v1 source_audit module, 1238 LOC). Grep-style source audits over the v1 pipeline .dag sources and their stage0 .rs mirror ported to filesystem_read + string_contains; the eight registry/spec derivation-parity tests ported to executable checks over the v2 extdeps.languages rust/python/go emit single-authority folds. Two teeth intentionally not carried, see notes below. Deletes the Rust source_audit module (mod removed from src/v1/tests/src/lib.rs)."

data v1_source_audit_witness_notes: String = "Not carried: (1) emit_backends_do_not_consume_inductive_fields was #[ignore]d (failing, never run in CI) in the Rust module, so porting it green would fabricate a passing witness; it is dropped, matching its live status. (2) no_expr_data_before_catch_all_in_core asserted match-arm ORDERING within a function body (NoExprData arm before the catch-all so it is not shadowed); pure string_contains cannot express positional ordering, so the witness carries only the presence of the NoExprData arm. (3) emit_handles_for_loop additionally compiled a for-loop snippet and asserted the emitted Rust contained iter().cloned(); that is a behavioral emit-output assertion, not a source property, and is covered by the floor emit-host MVP smokes, so the witness carries only the emit_typed_for_each source presence. is_copy_checkpoint_parity is carried as a source-presence witness (checkpoint authority + is_copy definition) rather than an executing call, to avoid importing the v1 coercion module into the v2 witness (de-fork name-collision hazard)."

