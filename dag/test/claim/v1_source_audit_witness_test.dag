data emit_path: String = "src/v1/05_emit.dag"
data emit_go_path: String = "src/v1/05_emit_go.dag"
data emit_python_path: String = "src/v1/05_emit_python.dag"
data emit_rust_path: String = "src/v1/05_emit_rust.dag"
