data rust_types_path: String = "dag/extdeps/languages/rust/types.dag"

fn src_has(path: String, needle: String) -> Bool {
  let r = filesystem_read(path: path)
  string_contains(s: r.content, pattern: needle)
}

fn src_lacks(path: String, needle: String) -> Bool {
  let r = filesystem_read(path: path)
  !string_contains(s: r.content, pattern: needle)
}

fn map_has_key(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}

fn str_map_has_key(m: Map<String, String>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}

