    && src_lacks(complexity_stage0_path, "pub fn recursive_variant_field_key(")
    && src_lacks(complexity_stage0_path, "pub fn scc_members_for(")
    && src_lacks(complexity_stage0_path, ".split(&\"::\".to_string())")
}

