    && src_has(complexity_path, "fn normalize_asymptotic(")
    && src_has(complexity_path, "fn format_cost_class(")
    && src_has(complexity_path, "fn format_cost_inner(")
    && src_has(complexity_path, "fn parenthesize_additive_cost(")
    && src_has(complexity_path, "fn classify_complexity(")
    && src_has(complexity_path, "ExprReturn")
    && src_has(complexity_stage0_path, "pub fn max_path_self_calls(")
    && src_has(complexity_stage0_path, "pub fn max_path_self_calls_with_cont(")
    && src_has(complexity_stage0_path, "pub fn max_path_self_calls_block(")
    && src_has(complexity_stage0_path, "pub fn build_scc_measure_params(")
    && src_has(complexity_stage0_path, "pub fn normalize_asymptotic(")
    && src_has(complexity_stage0_path, "pub fn format_cost_class(")
    && src_has(complexity_stage0_path, "pub fn format_cost_inner(")
    && src_has(complexity_stage0_path, "pub fn parenthesize_additive_cost(")
    && src_has(complexity_stage0_path, "pub fn classify_complexity(")
    && src_has(complexity_stage0_path, "ExprData::ExprReturn")
    && src_has(complexity_path, "fn classify_complexity(expr: CostExpr) -> String")
    && src_has(complexity_stage0_path, "pub fn classify_complexity(expr: Rc<CostExpr>) -> String")
    && src_lacks(complexity_path, "type ComplexityClass")
    && src_lacks(complexity_path, "formatted: String")
    && src_lacks(complexity_path, "fn recursive_variant_field_key(")
    && src_lacks(complexity_path, "fn scc_members_for(")
    && src_lacks(complexity_path, "split(delimiter: \"::\")")
