    && src_has(parse_path, "fn parser_result_witness(")
    && src_has(parse_stage0_path, "pub enum ParserHelperIdentity")
    && src_has(parse_stage0_path, "pub enum ParserResultWitness")
    && src_has(parse_stage0_path, "pub fn parser_progress_flag_var(")
    && src_has(parse_stage0_path, "pub fn parser_helper_identity(")
    && src_has(parse_stage0_path, "pub fn parser_passthrough_state_expr(")
    && src_has(parse_stage0_path, "pub fn parser_result_witness(")
    && src_has(complexity_path, "import v1.compiler.parse \{")
    && src_lacks(complexity_path, "\"skip_newlines\"")
    && src_lacks(complexity_path, "\"skip_continuation_newlines\"")
}

test fn recursive_variant_witnesses_are_structural() -> Bool {
  src_has(env_path, "fn put_inductive_field(")
    && src_has(env_path, "fn merge_inductive_fields(")
    && src_has(infer_env_stage0_path, "pub fn put_inductive_field(")
    && src_has(infer_env_stage0_path, "pub fn merge_inductive_fields(")
    && src_has(infer_path, "import std.node { compiler_inductive_fields")
    && src_has(infer_path, "inductive_fields_list_to_map(fields: compiler_inductive_fields)")
}

test fn compile_gate_keeps_infer_errors_blocking_in_stage0() -> Bool {
  src_has(compile_path, "analyze_complexity: false")
    && src_has(compile_path, "let blocking = resolved.diagnostics |> filter(d => is_interpreter_blocking_diagnostic(d: d.diagnostic))")
    && src_lacks(compile_path, "bootstrap_mode")
    && src_has(compile_stage0_path, "typed_diags")
    && src_lacks(compile_stage0_path, "BOOTSTRAP_MODE")
}

test fn testgen_emits_valid_rust() -> Bool {
  src_lacks(emit_rust_path, "todo!(\"unsupported simple expr")
    && (src_has(emit_rust_path, "compile_error!(\"unsupported simple expr")
        || src_has(emit_rust_path, "emit_error_expr(message: \"unsupported simple expr")
        || src_has(emit_path, "emit_error_expr(message: \"unsupported simple expr"))
    && src_lacks(emit_rust_path, "Ok(Default::default())")
    && src_has(emit_rust_path, "has_mock_prefix")
    && src_lacks(emit_rust_path, "starts_with_prefix")
    && src_has(emit_path, "extract_test_projections")
    && src_has(emit_path, "TestProjection")
    && src_has(languages_path, "Rc<dyn Fn(")
    && src_has(languages_path, "callable_type_template")
    && src_has(emit_path, "callable_type_template")
}

test fn testgen_service_mock_source_gate() -> Bool {
  src_has(emit_rust_path, "emit_test_file")
    && src_has(emit_path, "extract_test_projections")
    && src_has(emit_path, "has_mock_prefix")
    && src_lacks(emit_path, "Ok(Default::default())")
    && src_lacks(emit_path, "Value::Object(Default::default())")
    && src_lacks(emit_path, "_ => \"null\"")
    && src_lacks(emit_path, "extract_mock_props")
    && src_lacks(emit_path, "starts_with_prefix")
}

