module test.claim.ensure_witness

import std.types { Bool, String }
import std.upsert_decision { Noop, Apply, Refuse }
import std.realization_reconcile {
  Applied,
  NotApplied,
  Application,
  ReconciledEffect,
  classify_reconciled,
  EffectConverged,
  EffectNotConverged,
}
import gunbc.ensure {
  EnsureObserveOnly,
  EnsureMayApply,
  EnsureObserved,
  EnsureAbsent,
  EnsureInaccessible,
  EnsurePlanAvailable,
  EnsurePlanUnavailable,
  ensure_decide,
  ensure_reconcile,
  EnsureObservation,
}

// One shape for the three Apply controls: the BEFORE report is a dissatisfied observation under
// EnsureMayApply with a plan, which is the input that makes ensure_decide derive Apply. Only the
// application arm and the after report vary, so each control varies exactly one axis.
fn reconcile_case(
  application: Application,
  after: EnsureObservation<String>,
  after_satisfies: Bool,
) -> ReconciledEffect<String, String> {
  ensure_reconcile(
    policy: EnsureMayApply,
    before: EnsureObserved { evidence: "other-program" },
    before_satisfies: false,
    mismatch_reason: "identity mismatch",
    plan: EnsurePlanAvailable { plan: "would-install" },
    application: application,
    after: after,
    after_satisfies: after_satisfies,
    after_mismatch_reason: "identity mismatch",
  )
}

// The Noop arm needs a SATISFIED before report, which is what makes ensure_decide derive Noop.
fn reconcile_noop_case() -> ReconciledEffect<String, String> {
  ensure_reconcile(
    policy: EnsureMayApply,
    before: EnsureObserved { evidence: "gunbc-help-identity" },
    before_satisfies: true,
    mismatch_reason: "identity mismatch",
    plan: EnsurePlanAvailable { plan: "would-install" },
    application: NotApplied,
    after: EnsureObserved { evidence: "gunbc-help-identity" },
    after_satisfies: true,
    after_mismatch_reason: "identity mismatch",
  )
}

// Test-local, deliberately. std no longer exports a Bool predicate over the outcome coproduct -- the
// canonical surface is classify_reconciled / ReconciledOutcome -- but a witness asserting a verdict
// wants a Bool. Folding it here keeps the predicate out of the authority module while leaving these
// assertions readable.
fn converged(r: ReconciledEffect<String, String>) -> Bool {
  match classify_reconciled(r: r) {
    EffectConverged { converged: _ } => true
    EffectNotConverged { reason: _, attempt: _ } => false
  }
}

test fn ensure_satisfied_is_noop_for_every_policy() -> Bool {
  match ensure_decide(
    policy: EnsureObserveOnly,
    observation: EnsureObserved { evidence: "cargo 1.90" },
    observation_satisfies: true,
    mismatch_reason: "wrong version",
    plan: EnsurePlanAvailable { plan: "unused" },
  ) {
    Noop => true
    _ => false
  }
}

test fn ensure_known_absence_applies_only_with_authority_and_plan() -> Bool {
  let permitted = ensure_decide(
    policy: EnsureMayApply,
    observation: EnsureAbsent { reason: "cargo absent" },
    observation_satisfies: false,
    mismatch_reason: "cargo mismatch",
    plan: EnsurePlanAvailable { plan: "provision-rust-toolchain" },
  )
  let observe_only = ensure_decide(
    policy: EnsureObserveOnly,
    observation: EnsureAbsent { reason: "cargo absent" },
    observation_satisfies: false,
    mismatch_reason: "cargo mismatch",
    plan: EnsurePlanAvailable { plan: "provision-rust-toolchain" },
  )
  match permitted {
    Apply { plan } => plan == "provision-rust-toolchain"
    _ => false
  }
    && match observe_only {
      Refuse { reason } => string_contains(s: reason as String, pattern: "cargo absent")
      _ => false
    }
}

test fn ensure_inaccessible_never_mutates() -> Bool {
  match ensure_decide(
    policy: EnsureMayApply,
    observation: EnsureInaccessible { reason: "probe transport refused" },
    observation_satisfies: false,
    mismatch_reason: "unknown",
    plan: EnsurePlanAvailable { plan: "would-mutate" },
  ) {
    Refuse { reason } =>
      string_contains(s: reason as String, pattern: "transport refused")
    _ => false
  }
}

// FOUR DIRECT CONTROLS OVER ensure_reconcile, replacing the deleted ensure_readback witness rather
// than merely dropping it. The generic witnesses in reconciled_effect_witness_test establish the
// classifier's truth table; these establish that ensure_reconcile CONSTRUCTS and FEEDS that table
// correctly -- that the decision it derives and the reports it forwards land on the arm they should.
test fn ensure_reconcile_apply_applied_over_a_grounding_after_report_converges() -> Bool {
  converged(r: reconcile_case(
    application: Applied,
    after: EnsureObserved { evidence: "gunbc-help-identity" },
    after_satisfies: true,
  ))
}

test fn ensure_reconcile_apply_applied_over_a_non_grounding_after_report_does_not_converge() -> Bool {
  !converged(r: reconcile_case(
    application: Applied,
    after: EnsureObserved { evidence: "other-program" },
    after_satisfies: false,
  ))
}

test fn ensure_reconcile_apply_not_applied_does_not_converge_even_over_a_grounding_report() -> Bool {
  !converged(r: reconcile_case(
    application: NotApplied,
    after: EnsureObserved { evidence: "gunbc-help-identity" },
    after_satisfies: true,
  ))
}

test fn ensure_reconcile_noop_not_applied_over_a_grounding_report_converges() -> Bool {
  converged(r: reconcile_noop_case())
}

test fn generic_ensure_keystone_holds() -> Bool {
  ensure_satisfied_is_noop_for_every_policy()
    && ensure_known_absence_applies_only_with_authority_and_plan()
    && ensure_inaccessible_never_mutates()
    && ensure_reconcile_apply_applied_over_a_grounding_after_report_converges()
    && ensure_reconcile_apply_applied_over_a_non_grounding_after_report_does_not_converge()
    && ensure_reconcile_apply_not_applied_does_not_converge_even_over_a_grounding_report()
    && ensure_reconcile_noop_not_applied_over_a_grounding_report_converges()
}
