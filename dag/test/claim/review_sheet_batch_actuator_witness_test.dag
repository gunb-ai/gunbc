import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_count_at_key,
}

// THE SUBJECT IS FOUR PURE INTERFACES: the lowering (plan -> ranges), the request build
// (plan -> one batch request), the dispatch (mutation standing -> readback owed or settled), and
// the receipt (commit standing x whole-tab assessment -> receipt). Every input is SUPPLIED at its boundary (DESIGN §3, a witness discriminates at one
// interface). The network route -- perform_batch_write, reassess_after_write,
// write_and_verify_review_sheet -- is not executed here and is a declared frontier in
// gunbc.review_sheet_batch_actuator, whose named consumer is private.

fn cell(letter: String, row: Int) -> A1Cell {
  A1Cell { column: A1Column { letter: letter as NonEmptyStr }, row: row }
}

fn span(start_letter: String, end_letter: String, row: Int) -> A1RowSpan {
  A1RowSpan { start: cell(letter: start_letter, row: row), end: cell(letter: end_letter, row: row) }
}

fn patch(listing_id: String, letter: String, row: Int, value: String) -> DerivedCellWrite {
  DerivedCellWrite {
    listing_id: listing_id as NonEmptyStr,
    column: "title" as NonEmptyStr,
    a1: cell(letter: letter, row: row),
    value: value,
  }
}

fn run(start_letter: String, end_letter: String, row: Int, cells: List<String>) -> AppendCellRun {
  AppendCellRun { a1: span(start_letter: start_letter, end_letter: end_letter, row: row), cells: cells, columns: [] }
}

fn append(listing_id: String, sheet_row: Int, runs: List<AppendCellRun>) -> AppendListingRow {
  AppendListingRow { listing_id: listing_id as NonEmptyStr, sheet_row: sheet_row, runs: runs }
}

fn bound(tab: String, patches: List<DerivedCellWrite>, appends: List<AppendListingRow>) -> TabBoundWritePlan {
  TabBoundWritePlan { tab: tab as NonEmptyStr, plan: ReviewSheetWritePlan { patches: patches, appends: appends } }
}

// Two patches and one append row of two runs: four ranges, every kind the plan can carry.
fn w_full_plan() -> TabBoundWritePlan {
  bound(
    tab: "Review",
    patches: [patch(listing_id: "L1", letter: "B", row: 2, value: "alpha"), patch(listing_id: "L2", letter: "B", row: 3, value: "beta")],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [
      run(start_letter: "A", end_letter: "C", row: 4, cells: ["L3", "gamma", "Observed"]),
      run(start_letter: "E", end_letter: "E", row: 4, cells: ["x"]),
    ])],
  )
}

// The wire an element of the plan must become. Cells carry no comma in this fixture, so a comma
// join is injective over it; the claim is about WHICH ranges exist, and the encoding is local.
fn values_wire(rows: List<List<String>>) -> String {
  join(map(rows, r => join(r, ",")), ";")
}

fn range_wire(vr: ValueRangeWrite) -> String {
  join([vr.range, "=", values_wire(rows: vr.values)], "")
}

fn expected_wires(b: TabBoundWritePlan) -> List<String> {
  concat(
    map(b.plan.patches, w => join([b.tab as String, "!", a1_cell_wire(cell: w.a1), "=", w.value], "")),
    fold(b.plan.appends, init: [], f: fn(acc, row) {
      concat(acc, map(row.runs, r => join([b.tab as String, "!", a1_row_span_wire(span: r.a1), "=", join(r.cells, ",")], "")))
    }),
  )
}

fn occurrences(wires: List<String>, wire: String) -> Int {
  count(filter(wires, w => w == wire))
}

// AN IDENTITY JOIN, NOT A COUNT. Every plan element appears exactly once among the lowered ranges,
// and every lowered range is a plan element. A count equality would pass a lowering that dropped
// one range and duplicated another.
fn is_identity_join(expected: List<String>, lowered: List<String>) -> Bool {
  all(expected, e => occurrences(wires: lowered, wire: e) == 1)
    && all(lowered, l => occurrences(wires: expected, wire: l) == 1)
}

test fn lowering_covers_patches_and_append_runs_as_an_identity_join() -> Bool {
  let b = w_full_plan()
  match lower_write_plan(bound: b) {
    WritePlanLowered { ranges: rs } =>
      count(rs) == 4
        && is_identity_join(expected: expected_wires(b: b), lowered: map(rs, r => range_wire(vr: r)))
        && all(rs, r => r.majorDimension == "ROWS")
    WritePlanUnlowerable { refusals: _ } => false
  }
}

test fn the_identity_join_rejects_a_dropped_and_a_duplicated_range() -> Bool {
  let e = ["a", "b", "c"]
  !is_identity_join(expected: e, lowered: ["a", "b"])
    && !is_identity_join(expected: e, lowered: ["a", "b", "b"])
    && !is_identity_join(expected: e, lowered: ["a", "b", "c", "d"])
    && is_identity_join(expected: e, lowered: ["c", "a", "b"])
}

fn refusal_tag(r: WritePlanRefusal) -> String {
  match r {
    EmptyWritePlan => "empty"
    TabTitleUnquotable { tab: _ } => "tab"
    PatchMalformed { listing_id: id, a1: c, defect: d } =>
      join(["patch:", id as String, ":", a1_cell_wire(cell: c), ":", match d {
        PatchColumnUnreadable => "column-unreadable"
        PatchRowBelowOrigin => "row-below-origin"
      }], "")
    AppendRunMalformed { listing_id: id, span: s, defect: d } =>
      join(["append:", id as String, ":", a1_row_span_wire(span: s), ":", match d {
        AppendRunRowBelowOrigin => "row-below-origin"
        AppendRunSpanNotOneRow => "not-one-row"
        AppendRunOffListingRow { sheet_row: r } => join(["off-row-", to_string(r)], "")
        AppendRunSpanColumnUnreadable => "column-unreadable"
        AppendRunWidthMismatch { cell_count: c, span_width: w } => join(["width-", to_string(c), "-of-", to_string(w)], "")
      }], "")
  }
}

fn sole_refusal_tag(b: TabBoundWritePlan) -> String {
  match sole_refusal(b: b) {
    Present { value: r } => refusal_tag(r: r)
    Absent => "<not a sole refusal>"
  }
}

fn sole_refusal(b: TabBoundWritePlan) -> WritePlanRefusal? {
  match lower_write_plan(bound: b) {
    WritePlanLowered { ranges: _ } => none
    WritePlanUnlowerable { refusals: rs } =>
      if count(rs) == 1 { rs |> first } else { none }
  }
}

// A malformed run refuses the WHOLE plan; the well-formed patch beside it is not lowered on its
// own, because a partial lowering is a dropped range wearing a success arm.
test fn lowering_refuses_a_run_whose_cells_do_not_fit_its_span() -> Bool {
  let b = bound(
    tab: "Review",
    patches: [patch(listing_id: "L1", letter: "B", row: 2, value: "alpha")],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [run(start_letter: "A", end_letter: "C", row: 4, cells: ["L3", "gamma"])])],
  )
  sole_refusal_tag(b: b) == "append:L3:A4:C4:width-2-of-3"
}

test fn lowering_refuses_a_run_off_its_listing_row() -> Bool {
  let b = bound(
    tab: "Review",
    patches: [],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [run(start_letter: "A", end_letter: "B", row: 5, cells: ["L3", "gamma"])])],
  )
  sole_refusal_tag(b: b) == "append:L3:A5:B5:off-row-4"
}

test fn lowering_refuses_a_run_spanning_two_rows() -> Bool {
  let two_rows = A1RowSpan { start: cell(letter: "A", row: 4), end: cell(letter: "B", row: 5) }
  let b = bound(
    tab: "Review",
    patches: [],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [AppendCellRun { a1: two_rows, cells: ["L3", "gamma"], columns: [] }])],
  )
  sole_refusal_tag(b: b) == "append:L3:A4:B5:not-one-row"
}

test fn lowering_refuses_an_empty_plan_rather_than_building_a_zero_range_batch() -> Bool {
  sole_refusal_tag(b: bound(tab: "Review", patches: [], appends: [])) == "empty"
}

test fn lowering_refuses_a_tab_title_it_cannot_qualify() -> Bool {
  let b = bound(tab: "Bob's", patches: [patch(listing_id: "L1", letter: "B", row: 2, value: "alpha")], appends: [])
  sole_refusal_tag(b: b) == "tab"
}

// COORDINATES ARE CHECKED, NOT TRUSTED. A patch at AA2 or B0, or an append on row 0, names no cell
// Sheets has; each refuses the whole plan before any request is built.
test fn lowering_refuses_a_patch_at_an_unreadable_column() -> Bool {
  let b = bound(tab: "Review", patches: [patch(listing_id: "L1", letter: "AA", row: 2, value: "alpha")], appends: [])
  sole_refusal_tag(b: b) == "patch:L1:AA2:column-unreadable"
}

test fn lowering_refuses_a_patch_below_row_one() -> Bool {
  let b = bound(tab: "Review", patches: [patch(listing_id: "L1", letter: "B", row: 0, value: "alpha")], appends: [])
  sole_refusal_tag(b: b) == "patch:L1:B0:row-below-origin"
}

test fn lowering_refuses_an_append_below_row_one() -> Bool {
  let b = bound(
    tab: "Review",
    patches: [],
    appends: [append(listing_id: "L3", sheet_row: 0, runs: [run(start_letter: "A", end_letter: "C", row: 0, cells: ["L3", "gamma", "Observed"])])],
  )
  sole_refusal_tag(b: b) == "append:L3:A0:C0:row-below-origin"
}

test fn a_malformed_patch_refuses_the_whole_plan_beside_a_good_append() -> Bool {
  let b = bound(
    tab: "Review",
    patches: [patch(listing_id: "L1", letter: "B", row: 0, value: "alpha")],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [run(start_letter: "A", end_letter: "C", row: 4, cells: ["L3", "gamma", "Observed"])])],
  )
  match batch_values_request(spreadsheet_id: "sheet-1" as NonEmptyStr, bound: b) {
    BatchRequestBuilt { request: _ } => false
    BatchRequestUnlowerable { refusals: rs } => count(rs) == 1
  }
}

// Every defect is reported, not the first: a plan with two malformed runs names both.
test fn lowering_reports_every_refusal_it_found() -> Bool {
  let b = bound(
    tab: "Review",
    patches: [],
    appends: [append(listing_id: "L3", sheet_row: 4, runs: [
      run(start_letter: "A", end_letter: "C", row: 4, cells: ["L3"]),
      run(start_letter: "E", end_letter: "E", row: 5, cells: ["x"]),
    ])],
  )
  match lower_write_plan(bound: b) {
    WritePlanLowered { ranges: _ } => false
    WritePlanUnlowerable { refusals: rs } => count(rs) == 2
  }
}

// THE BATCH REQUEST CARRIES ALL RANGES IN ONE CALL, asserted on the request built: one record,
// one data list, every lowered range in it, RAW as the input option.
test fn batch_request_carries_every_range_of_the_plan_in_one_call() -> Bool {
  let b = w_full_plan()
  match batch_values_request(spreadsheet_id: "sheet-1" as NonEmptyStr, bound: b) {
    BatchRequestBuilt { request: req } =>
      (req.spreadsheet_id as String) == "sheet-1"
        && count(req.data) == 4
        && is_identity_join(expected: expected_wires(b: b), lowered: map(req.data, r => range_wire(vr: r)))
        && match req.value_input_option {
          InputRaw => true
          InputUserEntered => false
        }
    BatchRequestUnlowerable { refusals: _ } => false
  }
}

test fn batch_request_is_not_built_from_an_unlowerable_plan() -> Bool {
  match batch_values_request(spreadsheet_id: "sheet-1" as NonEmptyStr, bound: bound(tab: "Review", patches: [], appends: [])) {
    BatchRequestBuilt { request: _ } => false
    BatchRequestUnlowerable { refusals: rs } => count(rs) == 1
  }
}

// ---- verification: the receipt over a supplied whole-tab assessment ----

fn w_schema() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "title" as NonEmptyStr, kind: DerivedField { source_field: "title" as NonEmptyStr } },
      ReviewColumn { name: "standing" as NonEmptyStr, kind: ListingStanding },
      ReviewColumn { name: "judgement" as NonEmptyStr, kind: OperatorEntered },
      ReviewColumn { name: "erasure" as NonEmptyStr, kind: DerivedErasureMark },
    ]
  }
}

fn w_row(listing_id: String, title: String) -> ProjectionRow {
  ProjectionRow {
    listing_id: listing_id as NonEmptyStr,
    derived: [DerivedCell { column: "title" as NonEmptyStr, value: title }],
  }
}

fn w_projection() -> ReviewSheetProjection {
  ReviewSheetProjection { schema: w_schema(), rows: [w_row(listing_id: "L1", title: "alpha"), w_row(listing_id: "L2", title: "beta")] }
}

fn w_headers() -> List<String> {
  ["listing_id", "title", "standing", "judgement", "erasure"]
}

fn observed_row(listing_id: String, title: String) -> List<String> {
  [listing_id, title, listing_standing_label(state: StandingObserved), "", ""]
}

// A whole-tab FORMATTED_VALUE readback, the shape the fresh read returns.
fn w_readback(rows: List<List<String>>) -> ValueRange {
  ValueRange {
    range: "Review!A1:E",
    majorDimension: Present { value: "ROWS" },
    values: Present { value: concat([w_headers()], rows) },
  }
}

fn w_assess(rows: List<List<String>>) -> ReviewSheetEnsureAssessment {
  review_sheet_ensure_assess(
    requested: review_sheet_get_values_request(tab: "Review" as NonEmptyStr),
    range: w_readback(rows: rows),
    projection: w_projection(),
    erasures: [],
  )
}

fn converged_rows() -> List<List<String>> {
  [observed_row(listing_id: "L1", title: "alpha"), observed_row(listing_id: "L2", title: "beta")]
}

fn committed() -> BatchCommitStanding {
  BatchCommitted { total_updated_cells: Present { value: 4 } }
}

fn ambiguous() -> BatchCommitStanding {
  BatchCommitAmbiguous { detail: "no response arrived for a mutation" as NonEmptyStr }
}

fn refused() -> BatchNonCommitStanding {
  BatchRefused { status: 400, body: "bad range" }
}

fn not_issued() -> BatchNonCommitStanding {
  BatchNotIssued { refusals: [EmptyWritePlan] }
}

test fn the_fixture_readback_classifies_as_converged() -> Bool {
  match w_assess(rows: converged_rows()) {
    ReviewSheetProjectionClassified { observed: _, tab: _, classification: ReviewSheetConverged } => true
    ReviewSheetProjectionClassified { observed: _, tab: _, classification: _ } => false
    ReviewSheetRequestRejected { cause: _ } => false
    ReviewSheetReadbackRejected { reason: _ } => false
  }
}

test fn a_converged_readback_after_a_committed_write_is_verified() -> Bool {
  match review_sheet_write_receipt(commit: committed(), readback_assessment: w_assess(rows: converged_rows())) {
    WriteVerifiedConverged { commit: c, observed: o } =>
      count(o.rows) == 2
        && match c {
          BatchCommitted { total_updated_cells: _ } => true
          BatchCommitAmbiguous { detail: _ } => false
        }
    WriteUnverified { commit: _, readback_assessment: _ } => false
    WriteNotCommitted { cause: _ } => false
  }
}

// A readback missing one range -- the L2 row never landed -- is UNVERIFIED and carries the
// assessment: the residual plan says which listing is still owed an append. Per-range readback of
// the ranges that were sent could not have said this.
test fn a_readback_missing_a_range_is_unverified_with_the_assessment() -> Bool {
  match review_sheet_write_receipt(
    commit: committed(),
    readback_assessment: w_assess(rows: [observed_row(listing_id: "L1", title: "alpha")]),
  ) {
    WriteUnverified { commit: _, readback_assessment: a } =>
      match a {
        ReviewSheetProjectionClassified { observed: _, tab: _, classification: c } =>
          match c {
            ReviewSheetNeedsWrite { plan: p } =>
              count(p.patches) == 0
                && count(p.appends) == 1
                && match p.appends |> first {
                  Present { value: row } => (row.listing_id as String) == "L2" && row.sheet_row == 3
                  Absent => false
                }
            ReviewSheetConverged => false
            ReviewSheetConflict { conflict: _ } => false
            ReviewSheetUnreadable { reason: _ } => false
          }
        ReviewSheetRequestRejected { cause: _ } => false
        ReviewSheetReadbackRejected { reason: _ } => false
      }
    WriteVerifiedConverged { commit: _, observed: _ } => false
    WriteNotCommitted { cause: _ } => false
  }
}

// A readback whose cell holds a value the plan did not choose is a conflict, and a conflict is
// not convergence even after a committed write.
test fn a_conflicting_readback_is_unverified() -> Bool {
  match review_sheet_write_receipt(
    commit: committed(),
    readback_assessment: w_assess(rows: [observed_row(listing_id: "L1", title: "someone else's title"), observed_row(listing_id: "L2", title: "beta")]),
  ) {
    WriteUnverified { commit: _, readback_assessment: a } =>
      match a {
        ReviewSheetProjectionClassified { observed: _, tab: _, classification: ReviewSheetConflict { conflict: _ } } => true
        ReviewSheetProjectionClassified { observed: _, tab: _, classification: _ } => false
        ReviewSheetRequestRejected { cause: _ } => false
        ReviewSheetReadbackRejected { reason: _ } => false
      }
    WriteVerifiedConverged { commit: _, observed: _ } => false
    WriteNotCommitted { cause: _ } => false
  }
}

test fn a_rejected_readback_is_unverified_not_a_success() -> Bool {
  match review_sheet_write_receipt(
    commit: committed(),
    readback_assessment: ReviewSheetReadbackRejected { reason: "values.get refused with status 429" as NonEmptyStr },
  ) {
    WriteUnverified { commit: _, readback_assessment: ReviewSheetReadbackRejected { reason: r } } =>
      (r as String) == "values.get refused with status 429"
    WriteUnverified { commit: _, readback_assessment: _ } => false
    WriteVerifiedConverged { commit: _, observed: _ } => false
    WriteNotCommitted { cause: _ } => false
  }
}

// COMMIT-AMBIGUOUS PLUS A CONVERGED READBACK IS A SUCCESS, and the ambiguity stays in the receipt:
// the sheet is what the projection says, and the receipt still says the remote never confirmed it.
test fn an_ambiguous_commit_with_a_converged_readback_is_verified_and_keeps_the_ambiguity() -> Bool {
  match review_sheet_write_receipt(commit: ambiguous(), readback_assessment: w_assess(rows: converged_rows())) {
    WriteVerifiedConverged { commit: BatchCommitAmbiguous { detail: d }, observed: _ } =>
      (d as String) == "no response arrived for a mutation"
    WriteVerifiedConverged { commit: _, observed: _ } => false
    WriteUnverified { commit: _, readback_assessment: _ } => false
    WriteNotCommitted { cause: _ } => false
  }
}

// AMBIGUOUS IS NOT REFUSED. Committed and ambiguous both owe the fresh read and hand the commit
// standing forward; refused (a 4xx decision before commit) and not-issued (nothing was sent) are
// settled as WriteNotCommitted with no read. The two invalid cross-products the earlier cut could
// mint -- refused + converged readback, not-issued + converged readback -- are now unwritable:
// review_sheet_write_receipt takes BatchCommitStanding, which has no refused or not-issued arm.
fn dispatch_tag(d: WriteDispatch) -> String {
  match d {
    ReadbackOwed { commit: c } =>
      match c {
        BatchCommitted { total_updated_cells: _ } => "readback-owed:committed"
        BatchCommitAmbiguous { detail: _ } => "readback-owed:ambiguous"
      }
    ReceiptSettled { receipt: r } =>
      match r {
        WriteNotCommitted { cause: k } =>
          match k {
            BatchRefused { status: st, body: _ } => join(["settled:not-committed:refused-", to_string(st)], "")
            BatchNotIssued { refusals: rs } => join(["settled:not-committed:not-issued-", to_string(count(rs))], "")
          }
        WriteVerifiedConverged { commit: _, observed: _ } => "settled:verified"
        WriteUnverified { commit: _, readback_assessment: _ } => "settled:unverified"
      }
  }
}

test fn a_committed_write_owes_a_readback() -> Bool {
  dispatch_tag(d: write_dispatch(standing: BatchMayHaveCommitted { commit: committed() })) == "readback-owed:committed"
}

test fn an_ambiguous_write_owes_a_readback_exactly_as_a_committed_one() -> Bool {
  dispatch_tag(d: write_dispatch(standing: BatchMayHaveCommitted { commit: ambiguous() })) == "readback-owed:ambiguous"
}

test fn a_refused_write_is_settled_not_committed_without_a_readback() -> Bool {
  dispatch_tag(d: write_dispatch(standing: BatchDidNotCommit { cause: refused() })) == "settled:not-committed:refused-400"
}

test fn a_not_issued_write_is_settled_not_committed_without_a_readback() -> Bool {
  dispatch_tag(d: write_dispatch(standing: BatchDidNotCommit { cause: not_issued() })) == "settled:not-committed:not-issued-1"
}

// ---- the seal on the wire function ----

// AN OUTSIDE MODULE CANNOT REACH issue_batch_request. The probe is a module an outside author would
// write: import the request record and the wire function, build a request of its own ranges, call.
// The census is keyed (class, subject_name, blocking) -- subject_name is the CALLEE's decl name --
// because a CensusObserved carries the whole closure's rows and a class-only count is attributable
// to the wrong subject (gunbc.compile_diagnostic_census). The green control is the same shape
// calling the public perform_batch_write: zero refusals at that key, so the red is the seal firing
// and not the import failing or the census refusing to run.
fn seal_refusals_at_wire_fn(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: "ConstructorCallAdmissionRefused", subject_name: "issue_batch_request", blocking: true)
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data outside_caller_of_the_wire_fn_source: String = "module probe_batch_wire_outside_caller\nimport std.types { NonEmptyStr, String }\nimport std.resources { Network }\nimport extdeps.google.sheets { ValueRangeWrite, InputRaw }\nimport gunbc.review_sheet_batch_actuator { BatchValuesRequest, BatchMutationStanding, issue_batch_request }\nfn probe_forge(spreadsheet_id: NonEmptyStr) -> BatchMutationStanding uses net: Network {\n  issue_batch_request(request: BatchValuesRequest { spreadsheet_id: spreadsheet_id, value_input_option: InputRaw, data: [ValueRangeWrite { range: \"Review!Z99\", majorDimension: \"ROWS\", values: [[\"forged\"]] }] })\n}\n"

data outside_caller_of_the_plan_fn_source: String = "module probe_batch_plan_outside_caller\nimport std.types { NonEmptyStr }\nimport std.resources { Network }\nimport gunbc.review_sheet_sheets { TabBoundWritePlan }\nimport gunbc.review_sheet_batch_actuator { BatchMutationStanding, perform_batch_write }\nfn probe_plan(spreadsheet_id: NonEmptyStr, bound: TabBoundWritePlan) -> BatchMutationStanding uses net: Network {\n  perform_batch_write(spreadsheet_id: spreadsheet_id, bound: bound)\n}\n"

test fn an_outside_module_calling_the_wire_fn_is_refused_at_that_callee() -> Bool {
  seal_refusals_at_wire_fn(source: outside_caller_of_the_wire_fn_source) >= 1
}

test fn an_outside_module_calling_the_plan_fn_is_not_refused() -> Bool {
  seal_refusals_at_wire_fn(source: outside_caller_of_the_plan_fn_source) == 0
}
