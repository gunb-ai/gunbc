module test.claim.proc_self_cgroup_witness

import extdeps.linux.proc_self_cgroup {
  read_unified_cgroup_membership,
  proc_self_cgroup_line_from_wire,
  proc_self_cgroup_is_unified_v2_line,
  CurrentCgroupObserved,
  MembershipMissing,
  MembershipAmbiguous,
  MembershipMalformed,
  ProcSelfCgroupLineParsed,
  ProcSelfCgroupLineRefused,
  ProcSelfCgroupLineMissingColon,
  OutcomeTagMissing,
  OutcomeTagAmbiguous,
  OutcomeTagMalformed,
  OutcomeTagObserved,
  unified_membership_outcome_tag_from_content,
  read_unified_cgroup_membership_drift_sketch,
  unified_membership_outcome_tag,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fixture_unified_single: String = "0::/user.slice/user-1000.slice/session-3.scope\n"

data fixture_unified_colon_in_path: String = "0::/user.slice/job:build/session.scope\n"

data fixture_unified_duplicate: String = "0::/first.path\n0::/second.path\n"

data fixture_malformed_no_colon: String = "garbage-line\n"

data fixture_missing_unified: String = "1:memory:/legacy.path\n"

data fixture_hierarchy_zero_nonempty_controller: String = "0:cpu:/sys/fs/cgroup\n"

// THE CROSS-REALIZATION LAW, AND WHAT REMAINS OF IT. This file once held two legs of one claim: the
// typed parser's tag, and the SAME tag produced by executing a bash realization of the same fixture
// (test.claim.proc_self_cgroup_real_execution_witness, four bin_witness wet rows over
// v2.extdeps.languages.bash_proc_self_cgroup). The bridge that mints those scripts is Charter 2's
// target and the emitter had no production caller, so both were deleted (2026-10-19); what is left is
// the parser side, and the law is now carried by the parser's own two readings -- the line parser and
// the tag fold -- which are separate functions with separate arms and can genuinely disagree.
// The four canonical fixtures remain the closed subject universe: every one must still be named on
// both readings below (observed, missing, ambiguous, malformed), so a state that stops being
// distinguishable goes red here rather than quietly in production (DESIGN 4b).

// The four canonical fixtures are the closed subject universe for the parser's own two readings. Each
// law row asserts only the parser-side tag.

test fn cross_realization_fixture_law_missing_holds() -> Bool {
  match unified_membership_outcome_tag_from_content(content: fixture_missing_unified) {
    OutcomeTagMissing => true
    _ => false
  }
}

test fn cross_realization_fixture_law_ambiguous_holds() -> Bool {
  match unified_membership_outcome_tag_from_content(content: fixture_unified_duplicate) {
    OutcomeTagAmbiguous => true
    _ => false
  }
}

test fn cross_realization_fixture_law_malformed_holds() -> Bool {
  match unified_membership_outcome_tag_from_content(content: fixture_malformed_no_colon) {
    OutcomeTagMalformed => true
    _ => false
  }
}

test fn cross_realization_fixture_law_observed_holds() -> Bool {
  match unified_membership_outcome_tag_from_content(content: fixture_unified_colon_in_path) {
    OutcomeTagObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    _ => false
  }
}

test fn cross_realization_parser_branch_mutation_red_control_holds() -> Bool {
  !(
    unified_membership_outcome_tag_from_content(
      content: fixture_hierarchy_zero_nonempty_controller,
    )
    ==
    unified_membership_outcome_tag(
      record: read_unified_cgroup_membership_drift_sketch(
        content: fixture_hierarchy_zero_nonempty_controller,
      ),
    )
  )
}


test fn proc_self_cgroup_unified_single_membership_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_single) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/user-1000.slice/session-3.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_colon_in_path_not_truncated_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_colon_in_path) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_missing_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_ambiguous_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
    MembershipAmbiguous { first: f, second: s } =>
      (f as String == "/first.path") && (s as String == "/second.path")
    MembershipMissing => false
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_malformed_is_distinct_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
    MembershipMalformed { cause: ProcSelfCgroupLineMissingColon } => true
    MembershipMissing => false
    MembershipAmbiguous { first: _, second: _ } => false
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMalformed { cause: ProcSelfCgroupLineMissingSecondColon } => false
    MembershipMalformed { cause: ProcSelfCgroupLineEmptyHierarchy } => false
    MembershipMalformed { cause: ProcSelfCgroupLineEmptyPath } => false
  }
}

test fn proc_self_cgroup_hierarchy_zero_nonempty_controller_not_unified_holds() -> Bool {
  match read_unified_cgroup_membership(content: fixture_hierarchy_zero_nonempty_controller) {
    CurrentCgroupObserved { relative_path: _ } => false
    MembershipMissing => true
    MembershipAmbiguous { first: _, second: _ } => false
    MembershipMalformed { cause: _ } => false
  }
}

test fn proc_self_cgroup_unified_v2_requires_empty_controller_field_holds() -> Bool {
  !proc_self_cgroup_is_unified_v2_line(
    hierarchy_id: "0" as NonEmptyStr,
    controller_list: "cpu",
  )
}

test fn proc_self_cgroup_line_parse_splits_on_second_colon_only_holds() -> Bool {
  match proc_self_cgroup_line_from_wire(line: "0::/foo:bar/baz") {
    ProcSelfCgroupLineParsed { hierarchy_id: hid, controller_list: ctl, relative_path: path } =>
      (hid as String == "0") && (ctl == "") && (path as String == "/foo:bar/baz")
    ProcSelfCgroupLineRefused { cause: _ } => false
  }
}

test fn proc_self_cgroup_three_refusal_states_are_distinct_holds() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    _ => false
  })
    && (match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
      MembershipAmbiguous { first: _, second: _ } => true
      _ => false
    })
    && (match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
      MembershipMalformed { cause: _ } => true
      _ => false
    })
}

// THE FOUR REFUSAL-STATE OBSERVATIONS, KEPT AS PURE PARSER CHECKS. These four asserted the same
// state through two INDEPENDENT realizations while the shell emitter existed: the typed parser and
// v2.extdeps.languages.bash_proc_self_cgroup's marker strings, which were written separately and
// could genuinely disagree. That emitter is now deleted as a bridge with no production caller, so
// the pair cannot be re-compared -- and it must not be faked. unified_membership_outcome_tag_from_content
// is DEFINED as unified_membership_outcome_tag(read_unified_cgroup_membership(content)) (and the deleted
// bash_assign_from_content was defined the same way over the record), so an equality between a value
// and its own definition would be green by construction, which DESIGN 4b refuses outright.
// What each check still pins is therefore spelled as DATA on both independent readings: the record the
// line parser produces, and the tag the fold produces. A fold that mapped Ambiguous onto Missing, or a
// parser that lost a cause, goes red here even though the two functions share the reader underneath --
// they are different functions with different arms, and both must answer.
test fn unified_membership_state_missing_is_observed_on_both_readings() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_missing_unified) {
    MembershipMissing => true
    _ => false
  })
    && (match unified_membership_outcome_tag_from_content(content: fixture_missing_unified) {
      OutcomeTagMissing => true
      _ => false
    })
}

test fn unified_membership_state_ambiguous_is_observed_on_both_readings() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_unified_duplicate) {
    MembershipAmbiguous { first: f, second: s } =>
      (f as String == "/first.path") && (s as String == "/second.path")
    _ => false
  })
    && (match unified_membership_outcome_tag_from_content(content: fixture_unified_duplicate) {
      OutcomeTagAmbiguous => true
      _ => false
    })
}

test fn unified_membership_state_malformed_carries_its_cause_on_both_readings() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_malformed_no_colon) {
    MembershipMalformed { cause: ProcSelfCgroupLineMissingColon } => true
    _ => false
  })
    && (match unified_membership_outcome_tag_from_content(content: fixture_malformed_no_colon) {
      OutcomeTagMalformed => true
      _ => false
    })
}

test fn unified_membership_state_observed_keeps_the_colon_bearing_path_on_both_readings() -> Bool {
  (match read_unified_cgroup_membership(content: fixture_unified_colon_in_path) {
    CurrentCgroupObserved { relative_path: path } =>
      path as String == "/user.slice/job:build/session.scope"
    _ => false
  })
    && (match unified_membership_outcome_tag_from_content(content: fixture_unified_colon_in_path) {
      OutcomeTagObserved { relative_path: path } => path as String == "/user.slice/job:build/session.scope"
      _ => false
    })
}







// D1 derived-equality backfill (unified_membership_outcome_tag_eq deleted): the hand fold
// matched all four variants and, for OutcomeTagObserved, compared `ra as String == rb as String`.
// NonEmptyStr is a refinement of String (string_non_empty), so `as String` drops only the
// predicate, not a field — the primitive structural == on the field compares the same underlying
// strings. Discriminating RED: distinct variants and a distinct relative_path must compare
// unequal. Positive control: equal values (each variant) compare equal.
test fn unified_membership_outcome_tag_derived_eq_red_and_positive_holds() -> Bool {
  !(OutcomeTagMissing == OutcomeTagAmbiguous)
    && !(OutcomeTagAmbiguous == OutcomeTagMalformed)
    && !(OutcomeTagMalformed == OutcomeTagObserved { relative_path: "self/1234" as NonEmptyStr })
    && !(OutcomeTagObserved { relative_path: "self/1234" as NonEmptyStr } == OutcomeTagObserved { relative_path: "self/9999" as NonEmptyStr })
    && !(OutcomeTagObserved { relative_path: "self/1234" as NonEmptyStr } == OutcomeTagMissing)
    && (OutcomeTagMissing == OutcomeTagMissing)
    && (OutcomeTagAmbiguous == OutcomeTagAmbiguous)
    && (OutcomeTagMalformed == OutcomeTagMalformed)
    && (OutcomeTagObserved { relative_path: "self/1234" as NonEmptyStr } == OutcomeTagObserved { relative_path: "self/1234" as NonEmptyStr })
}
