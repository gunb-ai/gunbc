module test.claim.full_ci_green_cross_module_witness

import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { String, Bool }
import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_rows_of_class,
  census_total_count,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// compile_dag_diagnostic_census resolves each synthetic forge source against the live module index (ReadsLiveTree). Split per refusal class so affected-set can schedule one census per witness and each row names a single construction wall.
data full_ci_green_forged_literal_source: String = "module probe_full_ci_green_forged_literal\nimport std.types { CommitSha, NonEmptyStr }\nimport gunbc.full_ci_green_receipt { FullCiGreenReceipt }\nimport gunbc.merge_admission { current_gate_roster_hash }\nfn forged_literal() -> FullCiGreenReceipt {\n  FullCiGreenReceipt {\n    head_sha: \"abcdef0123456789abcdef0123456789abcdef01\" as CommitSha,\n    workflow_run_id: \"1\" as NonEmptyStr,\n    gate_roster_hash: current_gate_roster_hash,\n  }\n}\n"

data full_ci_green_forged_mint_source: String = "module probe_full_ci_green_forged_mint\nimport std.types { CommitSha, NonEmptyStr }\nimport gunbc.full_ci_green_receipt { FullCiGreenReceipt, mint_full_ci_green_receipt_from_observed_ci_floor }\nimport gunbc.merge_admission { current_gate_roster_hash }\nfn forged_mint() -> FullCiGreenReceipt {\n  mint_full_ci_green_receipt_from_observed_ci_floor(\n    head_sha: \"abcdef0123456789abcdef0123456789abcdef01\" as CommitSha,\n    workflow_run_id: \"1\" as NonEmptyStr,\n    gate_roster_hash: current_gate_roster_hash,\n  )\n}\n"

test fn witness_cross_module_full_ci_green_literal_refuses() -> Bool {
  match compile_dag_diagnostic_census(source: full_ci_green_forged_literal_source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_rows_of_class(rows: rows, wanted: "SoleConstructorViolation")) >= 1
    CensusNotRunnable { cause: _ } => false
  }
}

test fn witness_cross_module_full_ci_green_mint_refuses() -> Bool {
  match compile_dag_diagnostic_census(source: full_ci_green_forged_mint_source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_rows_of_class(rows: rows, wanted: "ConstructorCallAdmissionRefused")) >= 1
    CensusNotRunnable { cause: _ } => false
  }
}
