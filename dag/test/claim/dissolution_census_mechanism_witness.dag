module test.claim.dissolution_census_mechanism_witness

// Mechanism half of the dissolution-census split (DESIGN.md "witness cost
// derives from purpose", operator ruling 2026-08-04): fold_frontier_expiry's
// bound/pending/fired/unbound classification proven on a planted roster, so
// this file never imports gunbc.census_closure_frontier or the ~20-module
// extdeps fan-in it concatenates. The breadth-preserving half stays the
// irreducible census in dag/test/claim/long/dissolution_census_witness.dag.
import std.decl_ref { DeclarationRef, decl_ref }
import std.dissolution { bound_dissolution, unbound_dissolution, retires_dissolution, dissolution_is_bound }
import extdeps.bmc.serial_console { sol_console_send_bash_emit_dissolution_trigger }
import extdeps.storage.nbd { nbd_server_config_render_dissolution_trigger }
import extdeps.container.docker_ce { docker_ce_install_dissolution_trigger }
import extdeps.standards.rfc_8118 { project_navigable_uri_fragment_decompose_dissolve_on }
// THE TWO ROWS W7 ADDED. They are imported from the modules that CARRY them, not from a fixture:
// the obligation has to live on the declaration that still ships the shell leaf, or it is prose.
import gunbc.host.verified_binary_install {
  verified_binary_install_shell_dissolution_trigger,
  verified_binary_install_shell_bash_emit_dissolution_trigger,
}
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import gunbc.host.sccache_verified_install { sccache_verified_install_script_dissolution_trigger }
import gunbc.dissolution_observation {
  DissolutionCensusAnswered,
  DissolutionCensusRefused,
  dissolution_census_verdict_for,
}
import v2.std.decl_index { decl_facts }
import v2.lens.module_graph { module_declaration_facts_live }
import std.roster_frontier { FrontierRow, frontier_row_decl, fold_frontier_expiry, frontier_expiry_clean }

fn planted_bound_ref() -> DeclarationRef {
  decl_ref(module_path: "test.claim.dissolution_census_mechanism_witness", decl_name: "planted_bound_target")
}

fn planted_rows() -> List<FrontierRow> {
  [
    frontier_row_decl(
      ref: planted_bound_ref(),
      reason: "planted fixture row: bound dissolution mechanism coverage",
      dissolution: bound_dissolution(ref: planted_bound_ref()),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "test.claim.dissolution_census_mechanism_witness", decl_name: "planted_unbound_target"),
      reason: "planted fixture row: unbound dissolution mechanism coverage",
      dissolution: unbound_dissolution(description: "planted fixture: irreducible policy note, never fires"),
    ),
  ]
}

test fn supplying_a_bound_rows_declaration_reds_the_gate() -> Bool {
  let before = fold_frontier_expiry(rows: planted_rows(), present_decls: [])
  let after = fold_frontier_expiry(rows: planted_rows(), present_decls: [planted_bound_ref()])
  before.fired_still_present_count == 0
    && after.fired_still_present_count == 1
    && after.pending_count == before.pending_count - 1
    && after.unbound_count == before.unbound_count
    && !frontier_expiry_clean(report: after)
}

test fn unbound_rows_stay_unbound_under_any_present_decls() -> Bool {
  let probes = [
    decl_ref(module_path: "extdeps.docker.endpoint", decl_name: "docker_default_endpoint"),
    planted_bound_ref(),
  ]
  let base = fold_frontier_expiry(rows: planted_rows(), present_decls: [])
  let probed = fold_frontier_expiry(rows: planted_rows(), present_decls: probes)
  probed.unbound_count == base.unbound_count
}

fn planted_retires_ref() -> DeclarationRef {
  decl_ref(module_path: "test.claim.dissolution_census_mechanism_witness", decl_name: "planted_retires_target")
}

fn planted_retires_rows() -> List<FrontierRow> {
  [
    frontier_row_decl(
      ref: planted_retires_ref(),
      reason: "planted fixture row: retirement-by-disappearance mechanism coverage",
      dissolution: retires_dissolution(ref: planted_retires_ref()),
    ),
  ]
}

// THE DISCRIMINATING PAIR, AND IT RUNS THE OPPOSITE WAY FROM ITS SIBLING ABOVE.
// A forward trigger is discharged by supplying its declaration; a retirement trigger is
// discharged by withholding it. Both directions are asserted here, so an implementation
// that answered `present` for both shapes — the pre-change behaviour — fails this test,
// and so does one that answered `absent` for both.
test fn a_retirement_trigger_is_pending_while_its_declaration_is_present() -> Bool {
  let present = fold_frontier_expiry(rows: planted_retires_rows(), present_decls: [planted_retires_ref()])
  present.pending_count == 1
    && present.fired_still_present_count == 0
    && present.unbound_count == 0
    && frontier_expiry_clean(report: present)
}

test fn a_retirement_trigger_fires_once_its_declaration_is_gone() -> Bool {
  let gone = fold_frontier_expiry(
    rows: planted_retires_rows(),
    present_decls: [decl_ref(module_path: "extdeps.docker.endpoint", decl_name: "docker_default_endpoint")],
  )
  gone.fired_still_present_count == 1
    && gone.pending_count == 0
    && !frontier_expiry_clean(report: gone)
}

// THE PRODUCTION CONSUMERS. Three live retirement obligations whose condition was a
// description string until this change and is now a trigger the fold can answer (three at
// that change; the assertion below carries four, two having joined the census since, and the
// discharges are recorded after it). `dissolution_is_bound` was FALSE for all three before
// the migration, which is what makes this an executing before/after rather than a
// restatement of the constructor.
//
// ONE DISCHARGE RECORDED HERE (state at that change: FIVE REMAINED, NOT SIX): the configfs renderer's obligation (named by
// `configfs_op_render_dissolution_trigger`) was DISCHARGED by the shell-typed-invocation
// migration -- the declaration it retired (`configfs_op_line`) was deleted by the change
// that described the transport, and the trigger went with it, because an obligation whose
// declaration no longer exists is complete and a trigger citing an absent declaration is
// the dead vocabulary this repository removes. Recorded here rather than silently
// dropped: a census row that vanishes unexplained cannot be told from one never measured.
//
// SIX OBLIGATIONS, NOT FOUR -- AND THE FIFTH AND SIXTH ARE THE POINT. The sccache
// installer's obligation (once named by `sccache_install_dissolution_trigger`) was PARTLY
// discharged by W7, and an earlier revision of this comment said DISCHARGED, full stop. That
// word was wrong and review 81885 caught it: the trigger's own text set the condition as
// "host_effect_apply binds a verified-download-plus-install effect (FetchAndVerify then
// InstallBinary) WITHOUT THE SHELL LEAF", and only half of that happened.
//
//   WHAT IS DISCHARGED: the build-cache consumer. gunbc.host.verified_binary_install is the
//   generic effect (FetchAndVerify = `curl_download_command` then the `sha256sum_file_command`
//   digest observation, gated by `verified_binary_install_admission`, which on a mismatch
//   returns the `RefusedToInstall` arm carrying BOTH digests -- not an empty plan: the two
//   helpers that flattened a refusal to "nothing to do" are deleted in this change, because a
//   fabricated nothing-to-do is a silent default; InstallBinary = `tar_extract_command` then
//   the cited move/mode/cleanup, the binary-presence precondition kept as a `test -x`
//   observation), gunbc.host.sccache_verified_install supplies sccache's url, digest, member,
//   destination, mode and privilege as PARAMETERS, and gunbc.host.build_cache_daemon_ensure
//   sequences it through the typed plan with no shell leaf anywhere. `sccache_install_script`
//   is deleted and its trigger went with it -- required-ci refuses CITED-DECLARATION-ABSENT, so
//   a bound answer on a name nothing defines would be the dead vocabulary this removes.
//
//   WHAT IS STILL CARRIED: the runner prerequisite. `runner_host_sccache_provision_script` and
//   `runner_host_sccache_provision_aarch64` (gunbc.runner.runner_host_deploy) still hand a
//   `set -e` string down through `sccache_verified_install_script` into
//   `verified_binary_install_shell`, including the hand-built `echo ... | sha256sum -c -`
//   pipeline. The typed plan is not on that path. Deleting the trigger there would have turned
//   tracked debt into untracked debt (DESIGN 4b: a rung is lowered only by declaring previous
//   rung, temporary rung, reason, bounded population and restoration trigger), so the
//   obligation is now carried on the two declarations that actually hold it -- the two rows
//   asserted below, whose population is exactly those three consumers, and whose trigger is the
//   runner provisioning binding `verified_binary_install_admitted_plan` through typed argv.
//   Routing it there is out of this change's scope (runner_host_deploy is not a retained_srvn
//   site), which is precisely why it needs a tracked trigger rather than a paragraph.
//
// WHAT THE NEXT ROW IS: the four older triggers above include docker_ce, whose installer is the
// same effect shape with apt-keyring bytes as the archive member -- the lane rule says it is a
// later consumer, so it is NOT migrated here and its trigger stays live and bound.
test fn migrated_production_retirement_conditions_are_bound() -> Bool {
  dissolution_is_bound(condition: sol_console_send_bash_emit_dissolution_trigger)
    && dissolution_is_bound(condition: nbd_server_config_render_dissolution_trigger)
    && dissolution_is_bound(condition: docker_ce_install_dissolution_trigger)
    && dissolution_is_bound(condition: project_navigable_uri_fragment_decompose_dissolve_on)
    // THE TWO CARRIED ROWS, and they are the only ones in this list that were minted by the
    // change being reviewed. What `dissolution_is_bound` proves here is the CONSTRUCTOR, exactly
    // as the authority defines it: it calls `dissolution_status` with `present_decls: []`, so
    // BoundDissolution is Pending and an UnboundDissolution is Unbound -- the predicate answers
    // "is this a trigger at all", NOT "does the retired declaration resolve". Deleting either
    // `data` declaration below reddens this claim (the module no longer compiles), and rewriting
    // either into `unbound_dissolution` reddens it by verdict; renaming the retired declaration
    // does NOT, and the reason is stated rather than assumed: firing needs a real
    // `present_decls`, which is the roster's job and lives in
    // dag/test/claim/long/dissolution_census_witness.dag, not here.
    && dissolution_is_bound(condition: verified_binary_install_shell_dissolution_trigger)
    && dissolution_is_bound(condition: sccache_verified_install_script_dissolution_trigger)
}

// THE ON-CARRIER MARKER IS BOUND TO THE SAME DECLARATION AS THE TRIGGER, AND NAMES A CAPABILITY THAT
// DISSOLVES. The ctrl repo's review policy (its scripts/INVARIANTS.md Rule 12 — a path in THAT repo; it does
// not exist in gunbc, so follow it there, review 82112) lets a hand-shell renderer exist only when the intent is
// modelled AND the shell carries an on-carrier marker NAMING THE CAPABILITY that will generate it; this repo's
// own equivalent bar is DESIGN 4b meta-obligation 3 with DESIGN 6 (the mark travels on the carrier). `DissolutionCondition` has no field for the end state -- it carries only a TRIGGER (the
// declaration whose retirement discharges the debt) -- so the end state rides on the companion
// `Disposition` row, and a marker nobody compares is decoration. This claim pins the pair: the marker is
// `Scaffold` (not `Terminal`: the bash-emit path exists, this renderer just has not been routed through
// it yet), it dissolves to a `RealizationDispatch`, and its `bind` names THE SAME DECLARATION the trigger
// retires -- `gunbc.host.verified_binary_install` `verified_binary_install_shell`. Deleting the marker,
// flipping it to `Terminal`, or binding it to any other declaration reddens this claim; that is what makes
// it the RED for the marker rather than a comment with a `data` row beside it. Form follows
// `test.claim.generated_artifact_merge_driver_recipe`, which asserts its own Scaffold row the same way.
test fn the_shell_renderers_on_carrier_marker_binds_the_trigger_subject() -> Bool {
  match verified_binary_install_shell_bash_emit_dissolution_trigger {
    Scaffold { dissolves_to: to, bind: b } =>
      match to {
        RealizationDispatch => true
        _ => false
      }
        && b.module_path as String == "gunbc.host.verified_binary_install"
        && b.decl_name as String == "verified_binary_install_shell"
    Terminal { reason: _ } => false
  }
}

// THE LIVE DISCRIMINATOR, AND IT IS DELIBERATELY NOT A COUNT.
//
// Once `present_decls` is real, the two trigger arms read the population in OPPOSITE
// directions, so a wrong or partial population mass-fires one of them while
// mass-silencing the other — and any assertion phrased as a total is satisfied by both
// mistakes. The pair below is phrased at identity grain instead: one subject KNOWN to be
// present and one KNOWN to be absent, asserted in opposite directions IN THE SAME RUN
// against the same resolver answer. A population that lost the tree fails the first; a
// population that fabricated it fails the second.
//
// The pool is the purpose-built fixture rather than a production directory: the subject
// under test is the RESOLVER's behaviour, and scanning production to establish it prices
// the mechanism at that directory's breadth — the cost-shape defect DESIGN §6 names.
// Measured rather than assumed: pointed at `dag/std` this row was BUDGET-REFUSED at
// 5510ms against the floor's 5000ms deadline and went undecided, which is a worse
// outcome than a failure because nothing then claims it is broken.
data live_discriminator_pool_roots: List<String> = ["dag/test/fixture/dissolution_live_discriminator"]

fn live_discriminator_rows() -> List<FrontierRow> {
  [
    frontier_row_decl(
      ref: decl_ref(module_path: "test.claim.dissolution_census_mechanism_witness", decl_name: "present_subject_row"),
      reason: "live discriminator: subject known present, so its retirement is PENDING",
      dissolution: retires_dissolution(
        ref: decl_ref(
          module_path: "test.fixture.dissolution_live_discriminator.subject",
          decl_name: "present_subject_declaration",
        ),
      ),
    ),
    frontier_row_decl(
      ref: decl_ref(module_path: "test.claim.dissolution_census_mechanism_witness", decl_name: "absent_subject_row"),
      reason: "live discriminator: subject known absent, so its arrival is PENDING",
      dissolution: bound_dissolution(
        ref: decl_ref(
          module_path: "test.fixture.dissolution_live_discriminator.subject",
          decl_name: "absent_subject_declaration",
        ),
      ),
    ),
  ]
}

test fn opposite_trigger_directions_agree_on_one_live_population() -> Bool {
  match dissolution_census_verdict_for(
    rows: live_discriminator_rows(),
    facts: decl_facts(pool_roots: live_discriminator_pool_roots),
    modules: module_declaration_facts_live(pool_roots: live_discriminator_pool_roots),
  ) {
    DissolutionCensusRefused { undecided: _ } => false
    DissolutionCensusAnswered { report: r } =>
      r.pending_count == 2
        && r.fired_still_present_count == 0
        && r.unbound_count == 0
  }
}

fn w_unbound_dissolution_empty_literal_red() -> Bool {
  compile_dag_rust_emit_check(
    "module dissolution_empty_literal_red\nimport std.dissolution { DissolutionCondition, unbound_dissolution }\ndata bad: DissolutionCondition = unbound_dissolution(description: \"\")\n",
    "src/dissolution_empty_literal_red.rs",
    [],
    []
  )
}

fn w_unbound_dissolution_nonempty_literal_green() -> Bool {
  compile_dag_rust_emit_check(
    "module dissolution_nonempty_literal_green\nimport std.dissolution { DissolutionCondition, unbound_dissolution }\ndata ok: DissolutionCondition = unbound_dissolution(description: \"a real condition\")\n",
    "src/dissolution_nonempty_literal_green.rs",
    [],
    []
  )
}

test fn unbound_dissolution_empty_literal_refuses() -> Bool {
  !w_unbound_dissolution_empty_literal_red()
}

test fn unbound_dissolution_nonempty_literal_accepts() -> Bool {
  w_unbound_dissolution_nonempty_literal_green()
}
