module test.claim.floor_component_receipt_witness_test

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data fcr_witness_note: String = "Executing consumer for gunbc.floor_component_receipt. THE PAIR IS THE PROOF: the receipt built from run 30509024051's real component states must report the affected-set cold control VERIFIED (it concluded Done over 5217 witnesses) while still naming the silent-pick gate as the failed component — and the same projection must report NOT verified when that control itself is red, absent, or ambiguous. Either direction alone is satisfiable by a broken projection: always-verified reproduces the alert defect this module exists to kill, always-unverified reproduces the hardcoded 'cold control is dark' story it replaces."

data fcr_run_id: std.types.NonEmptyStr = "30509024051" as std.types.NonEmptyStr

data fcr_workflow_name: std.types.NonEmptyStr = "affected-set-falsifier" as std.types.NonEmptyStr

data fcr_head_sha: std.types.CommitSha = "0123456789abcdef0123456789abcdef01234567" as std.types.CommitSha

fn fcr_control_row_with(outcome_tag: std.types.NonEmptyStr, detail: std.types.NonEmptyStr) -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 1,
    label: "discovery-corpus predict-only" as std.types.NonEmptyStr,
    witnesses: 5217,
    outcome_tag: outcome_tag,
    detail: detail,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1170401)
  )
}

data fcr_silent_pick_diagnostic: std.types.NonEmptyStr = "resolution_divergence_silent_pick_gate_keystone_holds: witness receipt wall budget exceeded: 900001ms elapsed > 900000ms whole-receipt budget" as std.types.NonEmptyStr

fn fcr_silent_pick_row() -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as std.types.NonEmptyStr,
    witnesses: 1,
    outcome_tag: "refused" as std.types.NonEmptyStr,
    detail: fcr_silent_pick_diagnostic,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 905745)
  )
}

fn fcr_timed_out_row() -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as std.types.NonEmptyStr,
    witnesses: 1,
    outcome_tag: "timed_out" as std.types.NonEmptyStr,
    detail: "unused by the TimedOut arm" as std.types.NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 900000),
    elapsed: millisecond(count: 900766),
    shown_failures: 0,
    wall: millisecond(count: 905745)
  )
}

fn fcr_expect_red_row(index: std.nat.Nat) -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: index,
    label: "discovery-corpus expect_red" as std.types.NonEmptyStr,
    witnesses: 6,
    outcome_tag: "done" as std.types.NonEmptyStr,
    detail: "expect_red still-red OK" as std.types.NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1974836)
  )
}

fn fcr_rows_of(opts: List<gunbc.floor_component_receipt.FloorComponentRow?>) -> List<gunbc.floor_component_receipt.FloorComponentRow> {
  fold(opts, init: [], f: (acc, o) =>
    match o {
      Absent => acc
      Present { value: r } => concat(acc, [r])
    })
}

fn fcr_all_present(opts: List<gunbc.floor_component_receipt.FloorComponentRow?>) -> Bool {
  count(fcr_rows_of(opts: opts)) == count(opts)
}

fn fcr_real_run_rows() -> List<gunbc.floor_component_receipt.FloorComponentRow> {
  fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as std.types.NonEmptyStr, detail: "5217 witnesses" as std.types.NonEmptyStr),
    fcr_expect_red_row(index: 2),
    fcr_expect_red_row(index: 3),
    fcr_silent_pick_row()
  ])
}

test fn fcr_real_run_names_the_silent_pick_component() -> Bool {
  let rows = fcr_real_run_rows()
  let failed = floor_unsuccessful_component_rows(rows: rows)
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 4
    && count(failed) == 1
    && string_contains(s: doc, pattern: "\"schema\": \"floor-component-receipt/v1\"")
    && string_contains(s: doc, pattern: "resolution_divergence_silent_pick_gate_keystone_holds")
    && string_contains(s: doc, pattern: "900000ms whole-receipt budget")
    && string_contains(s: doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: doc, pattern: "\"witnesses\": 5217")
}

test fn fcr_timed_out_arm_projects_budget_and_elapsed() -> Bool {
  let rows = fcr_rows_of(opts: [fcr_timed_out_row()])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && string_contains(s: doc, pattern: "\"outcome\": \"timed_out\"")
    && string_contains(s: doc, pattern: "\"budget_ms\": 900000")
    && string_contains(s: doc, pattern: "\"elapsed_ms\": 900766")
}

test fn fcr_red_control_unknown_tags_fail_closed() -> Bool {
  let bad_outcome = floor_component_row(
    run_id: fcr_run_id,
    index: 1,
    label: "x" as std.types.NonEmptyStr,
    witnesses: 1,
    outcome_tag: "probably_fine" as std.types.NonEmptyStr,
    detail: "d" as std.types.NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1)
  )
  (match bad_outcome { Absent => true  Present { value: _ } => false })
    && fcr_all_present(opts: [
         fcr_control_row_with(outcome_tag: "done" as std.types.NonEmptyStr, detail: "ok" as std.types.NonEmptyStr)
       ])
}

test fn fcr_refused_is_distinct_from_failed() -> Bool {
  let refused_rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "refused" as std.types.NonEmptyStr, detail: "provenance gap" as std.types.NonEmptyStr)
  ])
  let failed_rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "failed" as std.types.NonEmptyStr, detail: "provenance gap" as std.types.NonEmptyStr)
  ])
  let refused_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: refused_rows)
  let failed_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: failed_rows)
  string_contains(s: refused_doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: refused_doc, pattern: "\"diagnostic\"")
    && string_contains(s: failed_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: failed_doc, pattern: "\"error\"")
    && !(refused_doc == failed_doc)
}

fn fcr_mode_row(mode: std.types.NonEmptyStr) -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row_of_failure_mode(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as std.types.NonEmptyStr,
    witnesses: 1,
    failure_mode: mode,
    detail: fcr_silent_pick_diagnostic,
    wall: millisecond(count: 905745)
  )
}

fn fcr_not_concluded_mode_row(mode: std.types.NonEmptyStr, detail: std.types.NonEmptyStr) -> gunbc.floor_component_receipt.FloorComponentRow? {
  floor_component_row_not_concluded(
    run_id: fcr_run_id,
    index: 7,
    label: "discovery-corpus wet self-host" as std.types.NonEmptyStr,
    failure_mode: mode,
    detail: detail
  )
}

fn fcr_not_concluded_outcome_is(mode: std.types.NonEmptyStr, expected_outcome: String) -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_not_concluded_mode_row(
      mode: mode,
      detail: "batch not concluded — checkpoint written while the run was still in progress; this component's fate is unknown at write time" as std.types.NonEmptyStr
    )
  ])
  count(rows) == 1
    && string_contains(
         s: floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows),
         pattern: concat(concat("\"outcome\": \"", expected_outcome), "\"")
       )
}

fn fcr_mode_outcome_is(mode: std.types.NonEmptyStr, expected_outcome: String) -> Bool {
  let rows = fcr_rows_of(opts: [fcr_mode_row(mode: mode)])
  count(rows) == 1
    && string_contains(
         s: floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows),
         pattern: concat(concat("\"outcome\": \"", expected_outcome), "\"")
       )
}

test fn fcr_failure_mode_maps_to_the_distinguishing_outcomes() -> Bool {
  fcr_mode_outcome_is(mode: "none" as std.types.NonEmptyStr, expected_outcome: "done")
    && fcr_mode_outcome_is(mode: "BudgetExceeded" as std.types.NonEmptyStr, expected_outcome: "refused")
    && fcr_mode_outcome_is(mode: "HostDependencyAbsent" as std.types.NonEmptyStr, expected_outcome: "refused")
    && fcr_mode_outcome_is(mode: "Infra" as std.types.NonEmptyStr, expected_outcome: "failed")
    && fcr_mode_outcome_is(mode: "WitnessRed" as std.types.NonEmptyStr, expected_outcome: "failed")
}

test fn fcr_not_reached_mode_is_skipped_not_failed() -> Bool {
  fcr_mode_outcome_is(mode: "not_reached" as std.types.NonEmptyStr, expected_outcome: "skipped")
}

data fcr_run_incomplete_note: String = "run_incomplete rows are pending (ComponentNotConcluded), not skipped. Skipped claims the walk produced a verdict of none; pending claims no verdict exists yet because the receipt was written mid-run. not_reached remains skipped: the plan concluded and deliberately skipped the tail. The modes must stay distinct so a SIGKILL checkpoint is not misread as a stop-policy skip."

test fn fcr_run_incomplete_mode_is_pending_not_skipped() -> Bool {
  fcr_not_concluded_outcome_is(mode: "run_incomplete" as std.types.NonEmptyStr, expected_outcome: "pending")
    && !fcr_not_concluded_outcome_is(mode: "run_incomplete" as std.types.NonEmptyStr, expected_outcome: "skipped")
}

test fn fcr_deadline_reached_is_refused_not_skipped() -> Bool {
  fcr_mode_outcome_is(mode: "deadline_reached" as std.types.NonEmptyStr, expected_outcome: "refused")
    && !fcr_mode_outcome_is(mode: "deadline_reached" as std.types.NonEmptyStr, expected_outcome: "skipped")
}

test fn fcr_deadline_reached_is_distinct_from_both_skipped_causes() -> Bool {
  let incomplete_detail = "batch not concluded — checkpoint written while the run was still in progress; this component's fate is unknown at write time" as std.types.NonEmptyStr
  fcr_mode_of(mode: "deadline_reached" as std.types.NonEmptyStr) == "deadline_reached"
    && !(fcr_mode_of(mode: "deadline_reached" as std.types.NonEmptyStr) == fcr_mode_of(mode: "not_reached" as std.types.NonEmptyStr))
    && !(fcr_mode_of(mode: "deadline_reached" as std.types.NonEmptyStr) == fcr_not_concluded_mode_of(mode: "run_incomplete" as std.types.NonEmptyStr, detail: incomplete_detail))
}

fn fcr_not_concluded_mode_of(mode: std.types.NonEmptyStr, detail: std.types.NonEmptyStr) -> String {
  let rows = fcr_rows_of(opts: [fcr_not_concluded_mode_row(mode: mode, detail: detail)])
  fold(rows, init: "no-row", f: (acc, r) => floor_component_failure_mode_tag(m: r.failure_mode))
}

test fn fcr_run_incomplete_is_a_distinct_mode_from_not_reached() -> Bool {
  let detail = "batch not concluded — checkpoint written while the run was still in progress; this component's fate is unknown at write time" as std.types.NonEmptyStr
  fcr_not_concluded_mode_of(mode: "run_incomplete" as std.types.NonEmptyStr, detail: detail) == "run_incomplete"
    && !(fcr_not_concluded_mode_of(mode: "run_incomplete" as std.types.NonEmptyStr, detail: detail) == fcr_mode_of(mode: "not_reached" as std.types.NonEmptyStr))
}

test fn fcr_red_control_unmodelled_failure_mode_refuses_never_widens() -> Bool {
  let unknown = fcr_mode_row(mode: "SomeNewModeAddedLater" as std.types.NonEmptyStr)
  let budget = fcr_mode_row(mode: "BudgetExceeded" as std.types.NonEmptyStr)
  (match unknown { Absent => true  Present { value: _ } => false })
    && (match budget { Absent => false  Present { value: _ } => true })
}

data fcr_failure_mode_edge_note: String = "The row-grain failure-mode edge, and the collapse it exists to undo. floor_component_outcome_of_failure_mode maps Infra and WitnessRed onto the SAME ObservationOutcome (Failed), which is right for the observation record and wrong for anyone deciding what to do next: a dead runner and a genuinely false claim are different faults with different owners. Before the edge, a consumer holding the Failed arm could only tell them apart by reading the diagnostic prose — the string classification the seed boundary already refuses. The pair below asserts BOTH halves of the property, because either alone is satisfiable by a broken projection: the outcomes must still agree (both Failed — the edge did not fork the observation record) AND the modes must differ (Infra vs WitnessRed — the edge actually recovers the distinction). A projection that renamed the outcomes apart would pass a modes-differ check while breaking the record; one that dropped the mode would pass an outcomes-agree check while restoring the blindness."

fn fcr_mode_of(mode: std.types.NonEmptyStr) -> String {
  let rows = fcr_rows_of(opts: [fcr_mode_row(mode: mode)])
  fold(rows, init: "no-row", f: (acc, r) => floor_component_failure_mode_tag(m: r.failure_mode))
}

test fn fcr_infra_and_witness_red_share_an_outcome_but_not_a_mode() -> Bool {
  let infra_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "Infra" as std.types.NonEmptyStr)])
  let red_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "WitnessRed" as std.types.NonEmptyStr)])
  let infra_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: infra_rows)
  let red_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: red_rows)
  count(infra_rows) == 1
    && count(red_rows) == 1
    && string_contains(s: infra_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: red_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: infra_doc, pattern: "\"failure_mode\": \"Infra\"")
    && string_contains(s: red_doc, pattern: "\"failure_mode\": \"WitnessRed\"")
    && !(infra_doc == red_doc)
}

test fn fcr_failure_mode_edge_agrees_with_the_outcome_mapping() -> Bool {
  fcr_mode_of(mode: "none" as std.types.NonEmptyStr) == "none"
    && fcr_mode_of(mode: "BudgetExceeded" as std.types.NonEmptyStr) == "BudgetExceeded"
    && fcr_mode_of(mode: "Infra" as std.types.NonEmptyStr) == "Infra"
    && fcr_mode_of(mode: "WitnessRed" as std.types.NonEmptyStr) == "WitnessRed"
    && fcr_mode_of(mode: "StaleKnownRed" as std.types.NonEmptyStr) == "StaleKnownRed"
    && fcr_mode_of(mode: "ExpectedRedEvidenceAbsent" as std.types.NonEmptyStr) == "ExpectedRedEvidenceAbsent"
    && fcr_mode_of(mode: "not_reached" as std.types.NonEmptyStr) == "not_reached"
}

data fcr_stale_known_red_note: String = "A known-red witness that starts PASSING and a witness that regresses are opposite events with opposite remedies — delete the now-stale admission row, versus fix the code. This asserts the receipt keeps them apart in BOTH directions: StaleKnownRed carries its own mode AND its own outcome, so it can neither be read as an ordinary WitnessRed in the alert's class signature nor be mistaken for a component that is fine. The Done clause is the load-bearing half: an expected-red row that silently went green must not be admitted as success, or the roster accumulates rows nobody revisits."

test fn fcr_stale_known_red_is_a_refusal_distinct_from_witness_red_and_from_done() -> Bool {
  let stale_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "StaleKnownRed" as std.types.NonEmptyStr)])
  let red_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "WitnessRed" as std.types.NonEmptyStr)])
  let stale_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: stale_rows)
  let red_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: red_rows)
  count(stale_rows) == 1
    && string_contains(s: stale_doc, pattern: "\"failure_mode\": \"StaleKnownRed\"")
    && string_contains(s: stale_doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: stale_doc, pattern: "\"diagnostic\"")
    && !string_contains(s: stale_doc, pattern: "\"outcome\": \"done\"")
    && !(stale_doc == red_doc)
}

data fcr_pre_verdict_unverified_note: String = "The THIRD arm on this axis, and it must be distinguishable from BOTH of the others because all three demand different actions. StaleKnownRed says an executed row passed — DELETE the admission. ExpectedRedEvidenceAbsent says a rostered row produced no observation — make it RUN. ExpectedRedPreVerdictUnverified says the row stopped as declared, before any verdict, and nothing yet proves it stopped for the DECLARED REASON — the remedy is neither delete nor rerun but carrying the typed phase and cause across the execution boundary. It renders as refused, never done: a declaration classifies a stop, it does not verify one, and rendering it green was the defect this arm replaces."

test fn fcr_pre_verdict_unverified_is_a_refusal_distinct_from_both_siblings() -> Bool {
  let unverified_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "ExpectedRedPreVerdictUnverified" as std.types.NonEmptyStr)])
  let absent_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "ExpectedRedEvidenceAbsent" as std.types.NonEmptyStr)])
  let stale_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "StaleKnownRed" as std.types.NonEmptyStr)])
  let unverified_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: unverified_rows)
  let absent_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: absent_rows)
  let stale_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: stale_rows)
  count(unverified_rows) == 1
    && string_contains(s: unverified_doc, pattern: "\"failure_mode\": \"ExpectedRedPreVerdictUnverified\"")
    && string_contains(s: unverified_doc, pattern: "\"outcome\": \"refused\"")
    && !string_contains(s: unverified_doc, pattern: "\"outcome\": \"done\"")
    && !(unverified_doc == absent_doc)
    && !(unverified_doc == stale_doc)
}

data fcr_expected_red_evidence_absent_note: String = "The COVERAGE half of the same axis, and the discrimination is that it is neither of its neighbours: not done (a batch whose admitted red control produced no observation is not a batch that is fine), and not StaleKnownRed (nobody observed the witness passing — nobody observed it at all), so the two refusals must render differently or the alert cannot tell delete-the-row from make-the-row-run. Absence establishing neither agreement nor failure is exactly why it needs its own mode rather than being folded into either verdict arm."

test fn fcr_expected_red_evidence_absent_is_a_refusal_distinct_from_stale_and_from_done() -> Bool {
  let absent_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "ExpectedRedEvidenceAbsent" as std.types.NonEmptyStr)])
  let stale_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "StaleKnownRed" as std.types.NonEmptyStr)])
  let absent_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: absent_rows)
  let stale_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: stale_rows)
  count(absent_rows) == 1
    && string_contains(s: absent_doc, pattern: "\"failure_mode\": \"ExpectedRedEvidenceAbsent\"")
    && string_contains(s: absent_doc, pattern: "\"outcome\": \"refused\"")
    && !string_contains(s: absent_doc, pattern: "\"outcome\": \"done\"")
    && !(absent_doc == stale_doc)
}

test fn fcr_red_control_tag_built_row_records_no_mode_rather_than_guessing() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as std.types.NonEmptyStr, detail: "ok" as std.types.NonEmptyStr)
  ])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && string_contains(s: doc, pattern: "\"failure_mode\": \"unrecorded\"")
    && !string_contains(s: doc, pattern: "\"failure_mode\": \"none\"")
}

data receipt_round_trip_note: String = "THE WRITER'S OUTPUT DECODES THROUGH THE STRICT READER, and this witness exists because that once stopped being true. The writer emitted a selection_degradation member only when a selection snapshot existed, while the reader REQUIRED it, so the no-selection path produced a document the reader refused (review 49594). Both members are now deleted with affected-set selection itself — the writer no longer emits them and the reader no longer requires them — so the specific break is gone. The round trip is still witnessed, because what made that defect possible is structural rather than incidental: the writer and the reader are two hand-maintained member lists, and nothing but this execution joins them. Dissolve-on: the document type derives both projections, at which point a writer that omits a required member is unrepresentable and this witness becomes redundant with the type."

test fn fcr_receipt_decodes_through_the_strict_reader() -> Bool {
  let doc = floor_component_receipt_document(
    workflow_name: fcr_workflow_name,
    run_id: fcr_run_id,
    head_sha: fcr_head_sha,
    rows: fcr_real_run_rows()
  )
  match floor_component_receipt_decode_with(text: doc, expected_schema: floor_component_receipt_schema as std.types.NonEmptyStr) {
    ReceiptDecoded { document: d } => (d.subject.run_id as String) == (fcr_run_id as String)
    _ => false
  }
}

data fcr_run_terminal_legacy_absent_note: String = "Pre-PR receipts under artifact retention omit run_terminal entirely. receipt_run_terminal_at maps absent to null so the alert decoder does not refuse them (review 51856); same transitional pattern as component_outcome_wire_legacy_pending_tag_note."

data fcr_legacy_receipt_without_run_terminal: String = "{\"schema\":\"floor-component-receipt/v1\",\"workflow_name\":\"affected-set-falsifier\",\"run_id\":\"30509024051\",\"head_sha\":\"0123456789abcdef0123456789abcdef01234567\",\"component_count\":0,\"unsuccessful_components\":[],\"components\":[]}"

test fn fcr_legacy_receipt_without_run_terminal_member_decodes() -> Bool {
  match floor_component_receipt_decode_with(
    text: fcr_legacy_receipt_without_run_terminal,
    expected_schema: floor_component_receipt_schema as std.types.NonEmptyStr
  ) {
    ReceiptDecoded { document: d } =>
      (d.subject.run_id as String) == "30509024051"
        && !string_contains(s: fcr_legacy_receipt_without_run_terminal, pattern: "\"run_terminal\"")
    _ => false
  }
}

data fcr_incomplete_checkpoint_round_trip_note: String = "The incomplete checkpoint envelope is what claim_executor writes on SIGKILL/step-cap death: run_terminal.disposition=incomplete and pending tail rows (outcome=pending, failure_mode=run_incomplete). The concluded-path round trip was already witnessed; this arm exercises the path this PR exists to fix. SUBJECT IDENTITY IS NOT ON THIS RECEIPT (operator ruling 2026-08-13, #8239 → #8163): in-flight witness identity is a temporary GUNBC_FLOOR_PHASE_JOURNAL projection until measurements and subjects emit on the #8163 RecordedObservation ledger; see floor_component_resource_checkpoint_note and floor_component_phase_journal_scaffold_note."

test fn fcr_incomplete_checkpoint_receipt_decodes_through_the_strict_reader() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as std.types.NonEmptyStr, detail: "batch 1 concluded" as std.types.NonEmptyStr),
    fcr_not_concluded_mode_row(
      mode: "run_incomplete" as std.types.NonEmptyStr,
      detail: "batch not concluded — checkpoint written while the run was still in progress; this component's fate is unknown at write time" as std.types.NonEmptyStr
    )
  ])
  let doc = floor_component_receipt_document_incomplete(
    workflow_name: fcr_workflow_name,
    run_id: fcr_run_id,
    head_sha: fcr_head_sha,
    rows: rows,
    run_terminal_cause: "run_incomplete" as std.types.NonEmptyStr,
    concluded_count: 1,
    pending_from_index: 2
  )
  match floor_component_receipt_decode_with(text: doc, expected_schema: floor_component_receipt_schema as std.types.NonEmptyStr) {
    ReceiptDecoded { document: d } =>
      (d.subject.run_id as String) == (fcr_run_id as String)
        && string_contains(s: doc, pattern: "\"disposition\": \"incomplete\"")
        && string_contains(s: doc, pattern: "\"outcome\": \"pending\"")
        && !string_contains(s: doc, pattern: "\"active_workset\"")
    _ => false
  }
}

test fn fcr_incomplete_checkpoint_receipt_reencodes_through_document_encoder() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as std.types.NonEmptyStr, detail: "batch 1 concluded" as std.types.NonEmptyStr),
    fcr_not_concluded_mode_row(
      mode: "run_incomplete" as std.types.NonEmptyStr,
      detail: "batch not concluded — checkpoint written while the run was still in progress; this component's fate is unknown at write time" as std.types.NonEmptyStr
    )
  ])
  let doc = floor_component_receipt_document_incomplete(
    workflow_name: fcr_workflow_name,
    run_id: fcr_run_id,
    head_sha: fcr_head_sha,
    rows: rows,
    run_terminal_cause: "run_incomplete" as std.types.NonEmptyStr,
    concluded_count: 1,
    pending_from_index: 2
  )
  match floor_component_receipt_decode_with(text: doc, expected_schema: floor_component_receipt_schema as std.types.NonEmptyStr) {
    ReceiptDecoded { document: d } =>
      match floor_component_receipt_decode_with(
        text: floor_component_receipt_document_text(doc: d),
        expected_schema: floor_component_receipt_schema as std.types.NonEmptyStr
      ) {
        ReceiptDecoded { document: roundtrip } =>
          (roundtrip.subject.run_id as String) == (fcr_run_id as String)
            && string_contains(
                 s: floor_component_receipt_document_text(doc: roundtrip),
                 pattern: "\"disposition\": \"incomplete\""
               )
        _ => false
      }
    _ => false
  }
}