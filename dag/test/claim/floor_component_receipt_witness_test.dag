module test.claim.floor_component_receipt_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, String, Bool, List, Int, CommitSha }
import std.nat { Nat }
import std.measure { Millisecond, millisecond }
import std.measure { ClockBasis, CpuClock, WallClock }
import gunbc.floor_component_receipt {
  FloorComponentRow,
  FloorControlState,
  ControlConcluded,
  ControlAbsent,
  ControlAmbiguous,
  floor_component_row,
  floor_component_row_of_failure_mode,
  floor_component_row_is_done,
  floor_affected_set_control_state,
  floor_unsuccessful_component_rows,
  floor_component_receipt_document,
  floor_component_failure_mode_tag,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data fcr_witness_note: String = "Executing consumer for gunbc.floor_component_receipt. THE PAIR IS THE PROOF: the receipt built from run 30509024051's real component states must report the affected-set cold control VERIFIED (it concluded Done over 5217 witnesses) while still naming the silent-pick gate as the failed component — and the same projection must report NOT verified when that control itself is red, absent, or ambiguous. Either direction alone is satisfiable by a broken projection: always-verified reproduces the alert defect this module exists to kill, always-unverified reproduces the hardcoded 'cold control is dark' story it replaces."

data fcr_run_id: NonEmptyStr = "30509024051" as NonEmptyStr

data fcr_workflow_name: NonEmptyStr = "affected-set-falsifier" as NonEmptyStr

data fcr_head_sha: CommitSha = "0123456789abcdef0123456789abcdef01234567" as CommitSha

fn fcr_control_row_with(outcome_tag: NonEmptyStr, detail: NonEmptyStr) -> FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 1,
    label: "discovery-corpus predict-only" as NonEmptyStr,
    selection_tag: "predict_only" as NonEmptyStr,
    witnesses: 5217,
    outcome_tag: outcome_tag,
    detail: detail,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1170401)
  )
}

data fcr_silent_pick_diagnostic: NonEmptyStr = "resolution_divergence_silent_pick_gate_keystone_holds: witness receipt wall budget exceeded: 900001ms elapsed > 900000ms whole-receipt budget" as NonEmptyStr

fn fcr_silent_pick_row() -> FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as NonEmptyStr,
    selection_tag: "applied" as NonEmptyStr,
    witnesses: 1,
    outcome_tag: "refused" as NonEmptyStr,
    detail: fcr_silent_pick_diagnostic,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 905745)
  )
}

fn fcr_timed_out_row() -> FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as NonEmptyStr,
    selection_tag: "applied" as NonEmptyStr,
    witnesses: 1,
    outcome_tag: "timed_out" as NonEmptyStr,
    detail: "unused by the TimedOut arm" as NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 900000),
    elapsed: millisecond(count: 900766),
    shown_failures: 0,
    wall: millisecond(count: 905745)
  )
}

fn fcr_expect_red_row(index: Nat) -> FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: index,
    label: "discovery-corpus expect_red" as NonEmptyStr,
    selection_tag: "applied" as NonEmptyStr,
    witnesses: 6,
    outcome_tag: "done" as NonEmptyStr,
    detail: "expect_red still-red OK" as NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1974836)
  )
}

fn fcr_rows_of(opts: List<FloorComponentRow?>) -> List<FloorComponentRow> {
  fold(opts, init: [], f: (acc, o) =>
    match o {
      Absent => acc
      Present { value: r } => concat(acc, [r])
    })
}

fn fcr_all_present(opts: List<FloorComponentRow?>) -> Bool {
  count(fcr_rows_of(opts: opts)) == count(opts)
}

fn fcr_real_run_rows() -> List<FloorComponentRow> {
  fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as NonEmptyStr, detail: "5217 witnesses" as NonEmptyStr),
    fcr_expect_red_row(index: 2),
    fcr_expect_red_row(index: 3),
    fcr_silent_pick_row()
  ])
}

fn fcr_control_verified(rows: List<FloorComponentRow>) -> Bool {
  match floor_affected_set_control_state(rows: rows) {
    ControlConcluded { row: r } => floor_component_row_is_done(row: r)
    ControlAbsent { cause: _ } => false
    ControlAmbiguous { cause: _, matched: _ } => false
  }
}

test fn fcr_real_run_reports_control_verified_and_names_silent_pick() -> Bool {
  let rows = fcr_real_run_rows()
  let failed = floor_unsuccessful_component_rows(rows: rows)
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 4
    && fcr_control_verified(rows: rows)
    && count(failed) == 1
    && string_contains(s: doc, pattern: "\"schema\": \"floor-component-receipt/v1\"")
    && string_contains(s: doc, pattern: "\"state\": \"present\"")
    && string_contains(s: doc, pattern: "\"verified\": true")
    && string_contains(s: doc, pattern: "resolution_divergence_silent_pick_gate_keystone_holds")
    && string_contains(s: doc, pattern: "900000ms whole-receipt budget")
    && string_contains(s: doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: doc, pattern: "\"witnesses\": 5217")
}

test fn fcr_timed_out_arm_projects_budget_and_elapsed() -> Bool {
  let rows = fcr_rows_of(opts: [fcr_timed_out_row()])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && string_contains(s: doc, pattern: "\"outcome\": \"timed_out\"")
    && string_contains(s: doc, pattern: "\"budget_ms\": 900000")
    && string_contains(s: doc, pattern: "\"elapsed_ms\": 900766")
}

test fn fcr_red_control_control_itself_failed_is_not_verified() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(
      outcome_tag: "failed" as NonEmptyStr,
      detail: "predict-only corpus red" as NonEmptyStr
    ),
    fcr_silent_pick_row()
  ])
  count(rows) == 2 && !fcr_control_verified(rows: rows)
}

test fn fcr_red_control_absent_control_is_not_silently_verified() -> Bool {
  let rows = fcr_rows_of(opts: [fcr_silent_pick_row()])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && !fcr_control_verified(rows: rows)
    && (match floor_affected_set_control_state(rows: rows) {
         ControlConcluded { row: _ } => false
         ControlAbsent { cause: _ } => true
         ControlAmbiguous { cause: _, matched: _ } => false
       })
    && string_contains(s: doc, pattern: "\"state\": \"absent\"")
    && string_contains(s: doc, pattern: "\"verified\": false")
}

test fn fcr_red_control_ambiguous_control_refuses() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as NonEmptyStr, detail: "first" as NonEmptyStr),
    fcr_control_row_with(outcome_tag: "done" as NonEmptyStr, detail: "second" as NonEmptyStr)
  ])
  count(rows) == 2
    && !fcr_control_verified(rows: rows)
    && (match floor_affected_set_control_state(rows: rows) {
         ControlConcluded { row: _ } => false
         ControlAbsent { cause: _ } => false
         ControlAmbiguous { cause: _, matched: m } => m == 2
       })
}

test fn fcr_red_control_unknown_tags_fail_closed() -> Bool {
  let bad_outcome = floor_component_row(
    run_id: fcr_run_id,
    index: 1,
    label: "x" as NonEmptyStr,
    selection_tag: "predict_only" as NonEmptyStr,
    witnesses: 1,
    outcome_tag: "probably_fine" as NonEmptyStr,
    detail: "d" as NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1)
  )
  let bad_selection = floor_component_row(
    run_id: fcr_run_id,
    index: 1,
    label: "x" as NonEmptyStr,
    selection_tag: "whatever" as NonEmptyStr,
    witnesses: 1,
    outcome_tag: "done" as NonEmptyStr,
    detail: "d" as NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 1)
  )
  (match bad_outcome { Absent => true  Present { value: _ } => false })
    && (match bad_selection { Absent => true  Present { value: _ } => false })
    && fcr_all_present(opts: [
         fcr_control_row_with(outcome_tag: "done" as NonEmptyStr, detail: "ok" as NonEmptyStr)
       ])
}

test fn fcr_refused_is_distinct_from_failed() -> Bool {
  let refused_rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "refused" as NonEmptyStr, detail: "provenance gap" as NonEmptyStr)
  ])
  let failed_rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "failed" as NonEmptyStr, detail: "provenance gap" as NonEmptyStr)
  ])
  let refused_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: refused_rows)
  let failed_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: failed_rows)
  string_contains(s: refused_doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: refused_doc, pattern: "\"diagnostic\"")
    && string_contains(s: failed_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: failed_doc, pattern: "\"error\"")
    && !(refused_doc == failed_doc)
}

fn fcr_mode_row(mode: NonEmptyStr) -> FloorComponentRow? {
  floor_component_row_of_failure_mode(
    run_id: fcr_run_id,
    index: 4,
    label: "discovery-corpus silent-pick gate" as NonEmptyStr,
    selection_tag: "applied" as NonEmptyStr,
    witnesses: 1,
    failure_mode: mode,
    detail: fcr_silent_pick_diagnostic,
    wall: millisecond(count: 905745)
  )
}

fn fcr_mode_outcome_is(mode: NonEmptyStr, expected_outcome: String) -> Bool {
  let rows = fcr_rows_of(opts: [fcr_mode_row(mode: mode)])
  count(rows) == 1
    && string_contains(
         s: floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows),
         pattern: concat(concat("\"outcome\": \"", expected_outcome), "\"")
       )
}

test fn fcr_failure_mode_maps_to_the_distinguishing_outcomes() -> Bool {
  fcr_mode_outcome_is(mode: "none" as NonEmptyStr, expected_outcome: "done")
    && fcr_mode_outcome_is(mode: "BudgetExceeded" as NonEmptyStr, expected_outcome: "refused")
    && fcr_mode_outcome_is(mode: "Infra" as NonEmptyStr, expected_outcome: "failed")
    && fcr_mode_outcome_is(mode: "WitnessRed" as NonEmptyStr, expected_outcome: "failed")
}

test fn fcr_not_reached_mode_is_skipped_not_failed() -> Bool {
  fcr_mode_outcome_is(mode: "not_reached" as NonEmptyStr, expected_outcome: "skipped")
}

test fn fcr_red_control_unmodelled_failure_mode_refuses_never_widens() -> Bool {
  let unknown = fcr_mode_row(mode: "SomeNewModeAddedLater" as NonEmptyStr)
  let budget = fcr_mode_row(mode: "BudgetExceeded" as NonEmptyStr)
  (match unknown { Absent => true  Present { value: _ } => false })
    && (match budget { Absent => false  Present { value: _ } => true })
}

data fcr_unreached_control_note: String = "The projection half of the receipt's TOTALITY property (the seed half is claim_executor's unreached_components_carry_planned_identity_not_placeholder). An enrolled component the stop policy never reached is padded into the receipt so the component count stays total. WHICH IDENTITY that padded row carries decides whether the receipt can still tell two different states apart. Carrying the PLANNED selection tag, an unreached cold control stays a predict_only row and resolves to ControlConcluded with a Skipped outcome — enrolled, did not run, verified false. Carrying a placeholder off tag instead, the same run resolves to ControlAbsent, whose cause reads 'the affected-set cold control did not run' — true by accident, and indistinguishable from a run where the control was never enrolled at all. Two states with different remedies collapsing to one output is the state-space conflation this module exists to prevent, so the pair below asserts they stay distinct rather than asserting either arm alone."

fn fcr_unreached_control_row(selection_tag: NonEmptyStr) -> FloorComponentRow? {
  floor_component_row(
    run_id: fcr_run_id,
    index: 2,
    label: "discovery-corpus predict-only" as NonEmptyStr,
    selection_tag: selection_tag,
    witnesses: 0,
    outcome_tag: "skipped" as NonEmptyStr,
    detail: "batch not reached — an earlier batch failed under the stop policy" as NonEmptyStr,
    basis: WallClock,
    budget: millisecond(count: 0),
    elapsed: millisecond(count: 0),
    shown_failures: 0,
    wall: millisecond(count: 0)
  )
}

test fn fcr_unreached_control_keeps_its_identity_and_is_not_verified() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_unreached_control_row(selection_tag: "predict_only" as NonEmptyStr)
  ])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && !fcr_control_verified(rows: rows)
    && (match floor_affected_set_control_state(rows: rows) {
         ControlConcluded { row: _ } => true
         ControlAbsent { cause: _ } => false
         ControlAmbiguous { cause: _, matched: _ } => false
       })
    && string_contains(s: doc, pattern: "\"state\": \"present\"")
    && string_contains(s: doc, pattern: "\"verified\": false")
    && string_contains(s: doc, pattern: "\"outcome\": \"skipped\"")
}

test fn fcr_red_control_placeholder_identity_erases_the_cold_control() -> Bool {
  let padded = fcr_rows_of(opts: [
    fcr_unreached_control_row(selection_tag: "off" as NonEmptyStr)
  ])
  let planned = fcr_rows_of(opts: [
    fcr_unreached_control_row(selection_tag: "predict_only" as NonEmptyStr)
  ])
  let padded_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: padded)
  let planned_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: planned)
  count(padded) == 1
    && count(planned) == 1
    && (match floor_affected_set_control_state(rows: padded) {
         ControlConcluded { row: _ } => false
         ControlAbsent { cause: _ } => true
         ControlAmbiguous { cause: _, matched: _ } => false
       })
    && !(padded_doc == planned_doc)
}

data fcr_failure_mode_edge_note: String = "The row-grain failure-mode edge, and the collapse it exists to undo. floor_component_outcome_of_failure_mode maps Infra and WitnessRed onto the SAME ObservationOutcome (Failed), which is right for the observation record and wrong for anyone deciding what to do next: a dead runner and a genuinely false claim are different faults with different owners. Before the edge, a consumer holding the Failed arm could only tell them apart by reading the diagnostic prose — the string classification the seed boundary already refuses. The pair below asserts BOTH halves of the property, because either alone is satisfiable by a broken projection: the outcomes must still agree (both Failed — the edge did not fork the observation record) AND the modes must differ (Infra vs WitnessRed — the edge actually recovers the distinction). A projection that renamed the outcomes apart would pass a modes-differ check while breaking the record; one that dropped the mode would pass an outcomes-agree check while restoring the blindness."

fn fcr_mode_of(mode: NonEmptyStr) -> String {
  let rows = fcr_rows_of(opts: [fcr_mode_row(mode: mode)])
  fold(rows, init: "no-row", f: (acc, r) => floor_component_failure_mode_tag(m: r.failure_mode))
}

test fn fcr_infra_and_witness_red_share_an_outcome_but_not_a_mode() -> Bool {
  let infra_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "Infra" as NonEmptyStr)])
  let red_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "WitnessRed" as NonEmptyStr)])
  let infra_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: infra_rows)
  let red_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: red_rows)
  count(infra_rows) == 1
    && count(red_rows) == 1
    && string_contains(s: infra_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: red_doc, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: infra_doc, pattern: "\"failure_mode\": \"Infra\"")
    && string_contains(s: red_doc, pattern: "\"failure_mode\": \"WitnessRed\"")
    && !(infra_doc == red_doc)
}

test fn fcr_failure_mode_edge_agrees_with_the_outcome_mapping() -> Bool {
  fcr_mode_of(mode: "none" as NonEmptyStr) == "none"
    && fcr_mode_of(mode: "BudgetExceeded" as NonEmptyStr) == "BudgetExceeded"
    && fcr_mode_of(mode: "Infra" as NonEmptyStr) == "Infra"
    && fcr_mode_of(mode: "WitnessRed" as NonEmptyStr) == "WitnessRed"
    && fcr_mode_of(mode: "StaleKnownRed" as NonEmptyStr) == "StaleKnownRed"
    && fcr_mode_of(mode: "ExpectedRedEvidenceAbsent" as NonEmptyStr) == "ExpectedRedEvidenceAbsent"
    && fcr_mode_of(mode: "not_reached" as NonEmptyStr) == "not_reached"
}

data fcr_stale_known_red_note: String = "A known-red witness that starts PASSING and a witness that regresses are opposite events with opposite remedies — delete the now-stale admission row, versus fix the code. This asserts the receipt keeps them apart in BOTH directions: StaleKnownRed carries its own mode AND its own outcome, so it can neither be read as an ordinary WitnessRed in the alert's class signature nor be mistaken for a component that is fine. The Done clause is the load-bearing half: an expected-red row that silently went green must not be admitted as success, or the roster accumulates rows nobody revisits."

test fn fcr_stale_known_red_is_a_refusal_distinct_from_witness_red_and_from_done() -> Bool {
  let stale_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "StaleKnownRed" as NonEmptyStr)])
  let red_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "WitnessRed" as NonEmptyStr)])
  let stale_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: stale_rows)
  let red_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: red_rows)
  count(stale_rows) == 1
    && string_contains(s: stale_doc, pattern: "\"failure_mode\": \"StaleKnownRed\"")
    && string_contains(s: stale_doc, pattern: "\"outcome\": \"refused\"")
    && string_contains(s: stale_doc, pattern: "\"diagnostic\"")
    && !string_contains(s: stale_doc, pattern: "\"outcome\": \"done\"")
    && !(stale_doc == red_doc)
}

data fcr_expected_red_evidence_absent_note: String = "The COVERAGE half of the same axis, and the discrimination is that it is neither of its neighbours: not done (a batch whose admitted red control produced no observation is not a batch that is fine), and not StaleKnownRed (nobody observed the witness passing — nobody observed it at all), so the two refusals must render differently or the alert cannot tell delete-the-row from make-the-row-run. Absence establishing neither agreement nor failure is exactly why it needs its own mode rather than being folded into either verdict arm."

test fn fcr_expected_red_evidence_absent_is_a_refusal_distinct_from_stale_and_from_done() -> Bool {
  let absent_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "ExpectedRedEvidenceAbsent" as NonEmptyStr)])
  let stale_rows = fcr_rows_of(opts: [fcr_mode_row(mode: "StaleKnownRed" as NonEmptyStr)])
  let absent_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: absent_rows)
  let stale_doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: stale_rows)
  count(absent_rows) == 1
    && string_contains(s: absent_doc, pattern: "\"failure_mode\": \"ExpectedRedEvidenceAbsent\"")
    && string_contains(s: absent_doc, pattern: "\"outcome\": \"refused\"")
    && !string_contains(s: absent_doc, pattern: "\"outcome\": \"done\"")
    && !(absent_doc == stale_doc)
}

test fn fcr_red_control_tag_built_row_records_no_mode_rather_than_guessing() -> Bool {
  let rows = fcr_rows_of(opts: [
    fcr_control_row_with(outcome_tag: "done" as NonEmptyStr, detail: "ok" as NonEmptyStr)
  ])
  let doc = floor_component_receipt_document(workflow_name: fcr_workflow_name, run_id: fcr_run_id, head_sha: fcr_head_sha, rows: rows)
  count(rows) == 1
    && string_contains(s: doc, pattern: "\"failure_mode\": \"unrecorded\"")
    && !string_contains(s: doc, pattern: "\"failure_mode\": \"none\"")
}
