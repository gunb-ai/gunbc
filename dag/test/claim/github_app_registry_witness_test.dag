module test.claim.github_app_registry

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn wire(name: NonEmptyStr) -> GitHubAppPermissionName {
  GitHubAppPermissionName { wire_name: name }
}

fn has_permission(perms: List<GitHubAppPermission>, name: NonEmptyStr) -> Bool {
  permission_name_in_list(name: wire(name: name), names: permission_names(perms: perms))
}

fn access_of(perms: List<GitHubAppPermission>, name: NonEmptyStr) -> GitHubAppPermissionAccess {
  permission_max_access(perms: perms, name: wire(name: name))
}

test fn witness_two_apps_are_distinct() -> Bool {
  gunbai_bot_declared.app_id.value != gunbai_ci_declared.app_id.value
    && gunbai_bot_declared.client_id != gunbai_ci_declared.client_id
    && gunbai_bot_declared.app_id.value == 3909950
    && gunbai_ci_declared.app_id.value == 2653532
    && gunbai_bot_declared.owner_login == gunbai_ci_declared.owner_login
}

test fn witness_bot_permissions_derived_from_consumers() -> Bool {
  let derived = gunbai_bot_required_permissions
  has_permission(perms: derived, name: "contents")
    && access_of(perms: derived, name: "contents") == AppAccessWrite
    && has_permission(perms: derived, name: "actions")
    && access_of(perms: derived, name: "actions") == AppAccessWrite
    && has_permission(perms: derived, name: "metadata")
    && access_of(perms: derived, name: "metadata") == AppAccessRead
}

test fn witness_permission_union_dedupes_by_name() -> Bool {
  let derived = gunbai_bot_required_permissions
  let raw = enrollment_permissions(enrollment: gunbai_bot_enrollment)
  length(permission_names(perms: derived)) == length(derived)
    && length(raw) > length(derived)
    && has_permission(perms: raw, name: "metadata")
}

test fn witness_runner_app_grants_no_contents() -> Bool {
  let derived = gunbai_ci_required_permissions
  !has_permission(perms: derived, name: "contents")
    && !has_permission(perms: derived, name: "pull_requests")
    && has_permission(perms: derived, name: "administration")
    && access_of(perms: derived, name: "administration") == AppAccessWrite
}

data heal_workflow_grant_gap_note: String = "THE LIVE GAP, MADE COUNTABLE. The auto-heal declares it needs workflows:write to repair .github/workflows/** — the self-hosted workflow definitions CI runs under — and the installation does not grant it. Before this change that gap was a sentence in four notes; it is now one row in gunbai_bot_ungranted_permissions and one derived HealPolicy. witness_workflow_grant_gap_is_counted pins the gap's exact membership so a grant landing (or a second requirement appearing) reds this file rather than passing silently. The discriminating pair proving the flip is DATA rather than an edit — the same fold yielding AuthorCommitRequired under an ungranted set and AutoPushEligible under a granted one — is witness_workflow_heal_policy_derives_from_grant, and it lives in test.claim.generated_artifact_drift beside the fold it exercises rather than here: this module declares no imports and so resolves bare across the pool, and importing gunbc.generated_artifact to reach that fold would flip it to import-scoped visibility and unbind every existing reference in it. The runner app is unaffected — it pushes nothing."

test fn witness_workflow_grant_gap_is_counted() -> Bool {
  has_permission(perms: gunbai_bot_required_permissions, name: "workflows")
    && access_of(perms: gunbai_bot_required_permissions, name: "workflows") == AppAccessWrite
    && !app_holds_permission(
         granted: gunbai_bot_installation_granted_permissions,
         required: heal_workflow_projection_permission
       )
    && !heal_app_can_push_workflow_paths()
    && length(gunbai_bot_ungranted_permissions) == 1
    && has_permission(perms: gunbai_bot_ungranted_permissions, name: "workflows")
    && !has_permission(perms: gunbai_ci_required_permissions, name: "workflows")
}

test fn witness_granted_set_covers_every_other_bot_requirement() -> Bool {
  app_holds_permission(
    granted: gunbai_bot_installation_granted_permissions,
    required: GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite }
  ) && app_holds_permission(
    granted: gunbai_bot_installation_granted_permissions,
    required: GitHubAppPermission { name: wire(name: "actions"), access: AppAccessWrite }
  ) && app_holds_permission(
    granted: gunbai_bot_installation_granted_permissions,
    required: GitHubAppPermission { name: wire(name: "metadata"), access: AppAccessRead }
  ) && !app_holds_permission(
    granted: gunbai_bot_installation_granted_permissions,
    required: GitHubAppPermission { name: wire(name: "metadata"), access: AppAccessWrite }
  )
}

test fn witness_ungranted_gap_is_empty_when_everything_is_granted() -> Bool {
  length(ungranted_required_permissions(
    enrollment: gunbai_bot_enrollment,
    granted: gunbai_bot_required_permissions
  )) == 0
    && length(ungranted_required_permissions(
         enrollment: gunbai_bot_enrollment,
         granted: []
       )) == length(gunbai_bot_required_permissions)
}

test fn witness_permission_access_order_is_asymmetric() -> Bool {
  permission_access_at_least(held: AppAccessWrite, requested: AppAccessRead)
    && permission_access_at_least(held: AppAccessRead, requested: AppAccessRead)
    && !permission_access_at_least(held: AppAccessRead, requested: AppAccessWrite)
}

test fn witness_all_verdicts_refuse_until_observed() -> Bool {
  observation_verdict_eq(a: gunbai_bot_key_verdict, b: UnknownRefused)
    && observation_verdict_eq(a: gunbai_bot_permission_verdict, b: UnknownRefused)
    && observation_verdict_eq(a: gunbai_ci_permission_verdict, b: UnknownRefused)
    && !observation_verdict_eq(a: gunbai_bot_permission_verdict, b: Converged)
}

test fn witness_fingerprint_mismatch_drifts() -> Bool {
  let wrong = ManagedGitHubAppKey {
    fingerprint: sha256_base64_key_fingerprint(digest: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="),
    role: ActiveSigningKey,
  }
  observation_verdict_eq(
    a: key_fingerprint_verdict(declared: gunbai_bot_declared_key, observed: AppObserved { value: wrong }),
    b: Drifted
  ) && observation_verdict_eq(
    a: key_fingerprint_verdict(declared: gunbai_bot_declared_key, observed: AppObserved { value: gunbai_bot_declared_key }),
    b: Converged
  )
}

fn installation_holding(perms: List<GitHubAppPermission>) -> GitHubAppInstallation {
  GitHubAppInstallation {
    installation_id: GitHubAppInstallationId { value: 0 },
    account: GitHubUser { login: "gunb-ai", id: 0, type: Organization },
    repository_selection: SelectionAll,
    permissions: perms,
    subscribed_events: [],
  }
}

test fn witness_grant_verdict_catches_both_directions() -> Bool {
  let exact = installation_holding(perms: gunbai_ci_required_permissions)
  let over = installation_holding(perms: concat(
    gunbai_ci_required_permissions,
    [GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite }]
  ))
  let under = installation_holding(perms: [GitHubAppPermission { name: wire(name: "metadata"), access: AppAccessRead }])
  observation_verdict_eq(
    a: app_permission_grant_verdict(enrollment: gunbai_ci_enrollment, observed: AppObserved { value: exact }),
    b: Converged
  ) && observation_verdict_eq(
    a: app_permission_grant_verdict(enrollment: gunbai_ci_enrollment, observed: AppObserved { value: over }),
    b: Drifted
  ) && observation_verdict_eq(
    a: app_permission_grant_verdict(enrollment: gunbai_ci_enrollment, observed: AppObserved { value: under }),
    b: Drifted
  )
}

test fn witness_every_app_has_enrolled_consumers() -> Bool {
  length(gunbai_bot_enrollment.consumers) == 2
    && length(gunbai_ci_enrollment.consumers) == 1
    && length(gunbai_bot_required_permissions) > 0
    && length(gunbai_ci_required_permissions) > 0
}

test fn witness_duplicate_permission_name_refused() -> Bool {
  let dup = [
    GitHubAppPermission { name: wire(name: "contents"), access: AppAccessRead },
    GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite },
  ]
  let ok = [
    GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite },
    GitHubAppPermission { name: wire(name: "metadata"), access: AppAccessRead },
  ]
  match admit_permission_set(perms: dup) {
    PermissionSetDuplicateName { name: n } => n.wire_name == "contents"
    PermissionSetAdmitted { permissions: _ } => false
  } && match admit_permission_set(perms: ok) {
    PermissionSetAdmitted { permissions: p } => length(p) == 2
    PermissionSetDuplicateName { name: _ } => false
  }
}

test fn witness_omitted_narrowing_is_not_empty_selection() -> Bool {
  let inst = installation_holding(perms: [
    GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite },
    GitHubAppPermission { name: wire(name: "metadata"), access: AppAccessRead },
  ])
  length(requested_permissions(narrowing: PermissionNarrowingOmitted, installation: inst)) == 2
    && length(requested_permissions(narrowing: SelectedPermissions { permissions: [] }, installation: inst)) == 0
}

test fn witness_narrowing_may_only_narrow() -> Bool {
  let inst = installation_holding(perms: [
    GitHubAppPermission { name: wire(name: "contents"), access: AppAccessRead },
  ])
  permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [GitHubAppPermission { name: wire(name: "contents"), access: AppAccessRead }] },
    installation: inst
  ) && !permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [GitHubAppPermission { name: wire(name: "contents"), access: AppAccessWrite }] },
    installation: inst
  ) && !permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [GitHubAppPermission { name: wire(name: "actions"), access: AppAccessRead }] },
    installation: inst
  ) && permission_narrowing_is_within(narrowing: PermissionNarrowingOmitted, installation: inst)
}
