module test.claim.github_app_registry

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data github_app_credential_witness_note: String = "THE DISCRIMINATING CONTROLS FOR CREDENTIAL-DEPENDENT AUTHORIZATION. The first one below is the direct falsifier for the cut this file replaced: even if the gunbai app held workflows:write, the live heal pushes with the Actions job credential, and GitHub's permissions vocabulary has no workflows key — so a workflow-path push must refuse regardless of any app grant. A model that consulted the app's permission list would answer AutoPushEligible there and be wrong at the remote.\n\nThe remaining controls walk the control-plane ladder: registration unobserved, approval pending, signer custody missing, grant observed. Each is a different reason a push cannot proceed, and collapsing them into one Boolean is what made the previous cut unable to say whether a human action was owed, and if so which one."

fn wire(name: NonEmptyStr) -> GitHubAppPermissionName {
  GitHubAppPermissionName { wire_name: name }
}

fn perm(name: NonEmptyStr, access: GitHubAppPermissionAccess) -> GitHubAppPermission {
  GitHubAppPermission { name: wire(name: name), access: access }
}

data workflow_advance_effect: GitHubEffect = AdvanceRepositoryBranch {
  repository: gunbc_repository,
  branch: GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [RepositoryPath { value: ".github/workflows/ci.yml" }]
}

data ordinary_advance_effect: GitHubEffect = AdvanceRepositoryBranch {
  repository: gunbc_repository,
  branch: GitBranchRef { name: "refs/heads/attempt" },
  changed_paths: [RepositoryPath { value: "DESIGN.md" }]
}

fn installation_holding(perms: List<GitHubAppPermission>) -> GitHubAppInstallation {
  GitHubAppInstallation {
    installation_id: GitHubAppInstallationId { value: 999 },
    account: GitHubUser { login: "gunb-ai", id: 0, type: Organization },
    repository_selection: SelectionAll,
    permissions: perms,
    subscribed_events: [],
  }
}

data live_signer: SignerCustody = SignerCustodyDeclared {
  pem: gunbai_ci_app_pem_secret,
  fingerprint: gunbai_bot_declared_key.fingerprint
}

data app_credential: GitHubCredentialAuthority = ManagedAppInstallationCredential {
  app: gunbai_bot_declared,
  installation: GitHubAppInstallationId { value: 999 },
  profile: GitHubCredentialProfileRef { name: "heal-branch-advance" }
}

data workflows_write_perm: GitHubAppPermission = perm(name: "workflows", access: AppAccessWrite)
data contents_write_perm: GitHubAppPermission = perm(name: "contents", access: AppAccessWrite)
data metadata_read_perm: GitHubAppPermission = perm(name: "metadata", access: AppAccessRead)

data full_workflow_grant: List<GitHubAppPermission> = [metadata_read_perm, contents_write_perm, workflows_write_perm]

fn observed_grant(perms: List<GitHubAppPermission>) -> GitHubAppControlPlaneState {
  app_control_plane_state(
    app: gunbai_bot_declared,
    custody: live_signer,
    registration: AppRegistrationReadback { requested_permissions: full_workflow_grant },
    observed: InstallationReadback { installation: installation_holding(perms: perms) },
    required: full_workflow_grant,
    reason: "heal branch advance over .github/workflows/**"
  )
}

test fn witness_app_grant_cannot_rescue_actions_job_credential() -> Bool {
  let control_plane = observed_grant(perms: full_workflow_grant)
  !credential_authorizes(
    authority: live_heal_push_credential,
    control_plane: control_plane,
    effect: workflow_advance_effect
  ) && credential_authorizes(
    authority: live_heal_push_credential,
    control_plane: control_plane,
    effect: ordinary_advance_effect
  ) && credential_authorizes(
    authority: app_credential,
    control_plane: control_plane,
    effect: workflow_advance_effect
  )
}

test fn witness_actions_token_refusal_is_kind_not_grant() -> Bool {
  let control_plane = observed_grant(perms: full_workflow_grant)
  let unsatisfied = unsatisfied_capabilities(
    authority: live_heal_push_credential,
    control_plane: control_plane,
    effect: workflow_advance_effect
  )
  count(unsatisfied) == 1
    && fold_list(
         xs: unsatisfied,
         empty: false,
         cons: fn(_acc, c) {
           match c {
             CredentialKindCannotSatisfy { missing } => missing.wire_name == "workflows"
             CredentialGrantNotObserved { missing: _ } => false
             CredentialGrants => false
           }
         }
       )
}

test fn witness_actions_token_scope_vocabulary_has_no_workflows() -> Bool {
  !actions_token_may_write_workflow_files()
    && actions_token_can_carry(name: wire(name: "contents"))
    && actions_token_can_carry(name: wire(name: "actions"))
    && actions_token_can_carry(name: wire(name: "pull_requests"))
    && actions_token_can_carry(name: wire(name: "security_events"))
    && !actions_token_can_carry(name: wire(name: "organization_self_hosted_runners"))
}

test fn witness_installation_approval_pending_when_grant_incomplete() -> Bool {
  match observed_grant(perms: [metadata_read_perm, contents_write_perm]) {
    InstallationPermissionApprovalPending { request } =>
      count(request.accept) == 1
        && request.installation.value == 999
        && fold_list(
             xs: request.accept,
             empty: false,
             cons: fn(_a, p) { p.name.wire_name == "workflows" }
           )
    InstallationGrantObserved { installation: _ } => false
    SignerCustodyMissing { app: _, reason: _ } => false
    AppRegistrationUnobserved { app: _ } => false
    AppRegistrationPermissionMissing { request: _ } => false
  }
}

test fn witness_grant_observed_when_installation_holds_everything() -> Bool {
  match observed_grant(perms: full_workflow_grant) {
    InstallationGrantObserved { installation } => count(installation.permissions) == 3
      && installation.installation_id.value == 999
    InstallationPermissionApprovalPending { request: _ } => false
    SignerCustodyMissing { app: _, reason: _ } => false
    AppRegistrationUnobserved { app: _ } => false
    AppRegistrationPermissionMissing { request: _ } => false
  }
}

test fn witness_signer_custody_missing_precedes_every_readback() -> Bool {
  match app_control_plane_state(
    app: gunbai_bot_declared,
    custody: gunbai_bot_signer_custody,
    registration: AppRegistrationReadback { requested_permissions: full_workflow_grant },
    observed: InstallationReadback { installation: installation_holding(perms: full_workflow_grant) },
    required: full_workflow_grant,
    reason: "heal branch advance"
  ) {
    SignerCustodyMissing { app, reason: _ } => app.app_id.value == 3909950
    InstallationGrantObserved { installation: _ } => false
    InstallationPermissionApprovalPending { request: _ } => false
    AppRegistrationUnobserved { app: _ } => false
    AppRegistrationPermissionMissing { request: _ } => false
  }
}

test fn witness_unobserved_readback_never_authorizes() -> Bool {
  let unobserved = app_control_plane_state(
    app: gunbai_bot_declared,
    custody: live_signer,
    registration: AppRegistrationReadback { requested_permissions: full_workflow_grant },
    observed: InstallationReadbackUnavailable,
    required: full_workflow_grant,
    reason: "heal branch advance"
  )
  !credential_authorizes(
    authority: app_credential,
    control_plane: unobserved,
    effect: workflow_advance_effect
  ) && !credential_authorizes(
    authority: app_credential,
    control_plane: unobserved,
    effect: ordinary_advance_effect
  ) && match unobserved {
    AppRegistrationUnobserved { app: _ } => true
    _ => false
  }
}

test fn witness_live_control_plane_is_signer_custody_missing() -> Bool {
  match live_heal_control_plane {
    SignerCustodyMissing { app, reason: _ } => app.app_id.value == 3909950
    _ => false
  }
}

test fn witness_effect_permissions_are_derived_not_authored() -> Bool {
  count(github_effect_required_permissions(effect: workflow_advance_effect)) == 2
    && count(github_effect_required_permissions(effect: ordinary_advance_effect)) == 1
    && count(github_effect_required_permissions(
         effect: RegisterOrganizationRunner { organization: GitHubOrganizationRef { login: "gunb-ai" } }
       )) == 1
    && fold_list(
         xs: github_effect_required_permissions(
           effect: RegisterOrganizationRunner { organization: GitHubOrganizationRef { login: "gunb-ai" } }
         ),
         empty: false,
         cons: fn(found, p) { found || p.name.wire_name == "organization_self_hosted_runners" }
       )
}

test fn witness_workflow_path_rule_is_prefix_not_substring() -> Bool {
  is_workflow_projection_path(path: RepositoryPath { value: ".github/workflows/ci.yml" })
    && is_workflow_projection_path(path: RepositoryPath { value: ".github/workflows/falsifier.yml" })
    && !is_workflow_projection_path(path: RepositoryPath { value: ".github/live-deploy-srv1-apply.sh" })
    && !is_workflow_projection_path(path: RepositoryPath { value: "docs/.github/workflows/ci.yml" })
    && !is_workflow_projection_path(path: RepositoryPath { value: "DESIGN.md" })
}

test fn witness_two_apps_are_distinct() -> Bool {
  gunbai_bot_declared.app_id.value != gunbai_ci_declared.app_id.value
    && gunbai_bot_declared.client_id != gunbai_ci_declared.client_id
    && gunbai_bot_declared.app_id.value == 3909950
    && gunbai_ci_declared.app_id.value == 2653532
    && gunbai_bot_declared.owner_login == gunbai_ci_declared.owner_login
    && gunbai_ci_declared_installation_id.value == 104134109
}

test fn witness_permission_access_order_is_asymmetric() -> Bool {
  permission_access_at_least(held: AppAccessWrite, requested: AppAccessRead)
    && permission_access_at_least(held: AppAccessRead, requested: AppAccessRead)
    && !permission_access_at_least(held: AppAccessRead, requested: AppAccessWrite)
}

test fn witness_absent_permission_is_absent_not_read() -> Bool {
  match permission_access_in(perms: [contents_write_perm], name: wire(name: "workflows")) {
    Absent => true
    Present { value: _ } => false
  } && match permission_access_in(perms: [contents_write_perm], name: wire(name: "contents")) {
    Present { value: a } => match a { AppAccessWrite => true  AppAccessRead => false }
    Absent => false
  }
}

test fn witness_duplicate_permission_name_refused() -> Bool {
  let dup = [
    perm(name: "contents", access: AppAccessRead),
    perm(name: "contents", access: AppAccessWrite),
  ]
  let ok = [contents_write_perm, metadata_read_perm]
  match admit_permission_set(perms: dup) {
    PermissionSetDuplicateName { name: n } => n.wire_name == "contents"
    PermissionSetAdmitted { permissions: _ } => false
  } && match admit_permission_set(perms: ok) {
    PermissionSetAdmitted { permissions: p } => count(p) == 2
    PermissionSetDuplicateName { name: _ } => false
  }
}

test fn witness_settings_locator_names_the_app_slug() -> Bool {
  app_settings_permissions_locator(app: gunbai_bot_declared).locator == "github.com/organizations/gunb-ai/settings/apps/gunbai/permissions"
}

test fn witness_fingerprint_mismatch_is_detected() -> Bool {
  let wrong = ManagedGitHubAppKey {
    fingerprint: sha256_base64_key_fingerprint(digest: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="),
    role: ActiveSigningKey,
  }
  !key_fingerprint_matches(declared: gunbai_bot_declared_key, observed: wrong)
    && key_fingerprint_matches(declared: gunbai_bot_declared_key, observed: gunbai_bot_declared_key)
}

test fn witness_narrowing_may_only_narrow() -> Bool {
  let inst = installation_holding(perms: [perm(name: "contents", access: AppAccessRead)])
  permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [perm(name: "contents", access: AppAccessRead)] },
    installation: inst
  ) && !permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [contents_write_perm] },
    installation: inst
  ) && !permission_narrowing_is_within(
    narrowing: SelectedPermissions { permissions: [perm(name: "actions", access: AppAccessRead)] },
    installation: inst
  ) && permission_narrowing_is_within(narrowing: PermissionNarrowingOmitted, installation: inst)
}

test fn witness_registration_gap_precedes_installation_approval() -> Bool {
  match app_control_plane_state(
    app: gunbai_bot_declared,
    custody: live_signer,
    registration: AppRegistrationReadback { requested_permissions: [metadata_read_perm, contents_write_perm] },
    observed: InstallationReadback { installation: installation_holding(perms: full_workflow_grant) },
    required: full_workflow_grant,
    reason: "heal branch advance over .github/workflows/**"
  ) {
    AppRegistrationPermissionMissing { request } =>
      count(request.add) == 1
        && request.settings_locator.locator == "github.com/organizations/gunb-ai/settings/apps/gunbai/permissions"
        && fold_list(xs: request.add, empty: false, cons: fn(_a, p) { p.name.wire_name == "workflows" })
    InstallationPermissionApprovalPending { request: _ } => false
    InstallationGrantObserved { installation: _ } => false
    SignerCustodyMissing { app: _, reason: _ } => false
    AppRegistrationUnobserved { app: _ } => false
  }
}

test fn witness_registration_unobserved_is_not_a_gap() -> Bool {
  match app_control_plane_state(
    app: gunbai_bot_declared,
    custody: live_signer,
    registration: AppRegistrationReadbackUnavailable,
    observed: InstallationReadback { installation: installation_holding(perms: full_workflow_grant) },
    required: full_workflow_grant,
    reason: "heal branch advance"
  ) {
    AppRegistrationUnobserved { app } => app.app_id.value == 3909950
    AppRegistrationPermissionMissing { request: _ } => false
    InstallationPermissionApprovalPending { request: _ } => false
    InstallationGrantObserved { installation: _ } => false
    SignerCustodyMissing { app: _, reason: _ } => false
  }
}
