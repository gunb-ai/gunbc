// SUPPLIED READINGS ONLY. The /health and /v1/models bodies below are values handed to the pure standing and
// roster folds; the live probe (harness_observe_operator_reading) is effectful and its live reading is the
// parent's, not a thing this file asserts. The tool-call and reasoning wire of ninfer-serve is deliberately not
// asserted here beyond the one observed member name the reasoning-wire row declares.
//
// INHABITANCE FRONTIER: no claim here executes the real shell probe, so the pairing obligation (§3) for the
// probe is owed to a live run on srv1 (the parent's roster gate), not discharged by this file.

fn w_empty_fold() -> HarnessRosterFold {
  HarnessRosterFold { serving: [], declined: [], unresolved: [] }
}

fn w_models_body(id: String) -> String {
  join(["{\"data\":[{\"id\":\"", id, "\",\"max_model_len\":262144,\"owned_by\":\"ninfer\"}]}"], "")
}

// The front's list as read live on 2026-10-26: the card model and the any-card alias.
fn w_models_body_two(a: String, b: String) -> String {
  join(["{\"data\":[{\"id\":\"", a, "\",\"owned_by\":\"pool\"},{\"id\":\"", b, "\",\"owned_by\":\"pool\"}]}"], "")
}

fn w_models_body_three(a: String, b: String, c: String) -> String {
  join(["{\"data\":[{\"id\":\"", a, "\"},{\"id\":\"", b, "\"},{\"id\":\"", c, "\"}]}"], "")
}

fn w_roster_after(reading: OperatorModelsReading) -> HarnessBackendRoster {
  harness_roster_of(folded: harness_operator_roster_step(acc: w_empty_fold(), route: harness_operator_route, standing: operator_route_standing(route: harness_operator_route, reading: reading)))
}

// ── 1. THE ROSTER SEES THE ROUTE ────────────────────────────────────────────────────────────────
test fn the_roster_sees_the_operator_route_when_models_answers_with_its_model() -> Bool {
  match w_roster_after(reading: OperatorModelsAnswered { body: w_models_body_two(a: "flash-next", b: "slop") }) {
    HarnessRosterServing { serving: s, declined: d, unresolved: _ } =>
      count(s) == 1 && count(d) == 0
    HarnessRosterNoneServing { declined: _, unresolved: _ } => false
  }
}

// RED: the alias is not admitted when it could land on a family whose wire the unit does not carry.
test fn the_alias_is_refused_when_the_front_lists_another_family_behind_it() -> Bool {
  match w_roster_after(reading: OperatorModelsAnswered { body: w_models_body_three(a: "flash-next", b: "slop", c: "glm-5.3-flash") }) {
    HarnessRosterServing { serving: _, declined: _, unresolved: _ } => false
    HarnessRosterNoneServing { declined: d, unresolved: _ } => count(d) == 1
  }
}

// RED: the card model alone, without the alias the request names, is not admitted.
test fn the_card_model_without_the_alias_is_not_admitted() -> Bool {
  match w_roster_after(reading: OperatorModelsAnswered { body: w_models_body(id: "flash-next") }) {
    HarnessRosterServing { serving: _, declined: _, unresolved: _ } => false
    HarnessRosterNoneServing { declined: d, unresolved: _ } => count(d) == 1
  }
}

// ── 2. AN UNANSWERED FRONT REFUSES TYPED, A REJECTED KEY IS NOT AN UNANSWERED FRONT ────────────────────────
test fn an_unanswered_front_reads_unreachable_and_leaves_none_serving() -> Bool {
  match w_roster_after(reading: OperatorFrontUnanswered { url: "https://srv2.tailecbe08.ts.net:3737/pool/v1/models" }) {
    HarnessRosterNoneServing { declined: d, unresolved: _ } =>
      count(d) == 1 && fold(d, init: false, f: (hit, x) => hit || (match x.standing {
        HarnessBackendUnreachable { url: _ } => true
        HarnessBackendUnreadable { cause: _ } => false
        HarnessBackendModelNotAdmitted { advertised: _ } => false
        HarnessBackendServing { model: _, unit: _, readback: _ } => false
      }))
    HarnessRosterServing { serving: _, declined: _, unresolved: _ } => false
  }
}

test fn a_front_that_rejects_the_key_reads_unreadable_not_unreachable() -> Bool {
  match operator_route_standing(route: harness_operator_route, reading: OperatorModelsRefused { url: "https://srv2.tailecbe08.ts.net:3737/pool/v1/models", status: "401" }) {
    OperatorRouteUnreadable { cause: _ } => true
    OperatorRouteServing { model: _ } => false
    OperatorRouteModelNotAdmitted { advertised: _ } => false
    OperatorRouteUnreachable { url: _ } => false
  }
}

test fn a_route_advertising_another_model_is_not_admitted_and_names_what_it_advertises() -> Bool {
  match operator_route_standing(route: harness_operator_route, reading: OperatorModelsAnswered { body: w_models_body(id: "something-else") }) {
    OperatorRouteModelNotAdmitted { advertised: a } => a == "something-else"
    OperatorRouteServing { model: _ } => false
    OperatorRouteUnreachable { url: _ } => false
    OperatorRouteUnreadable { cause: _ } => false
  }
}

test fn an_unparseable_models_body_reads_unreadable() -> Bool {
  match operator_route_standing(route: harness_operator_route, reading: OperatorModelsAnswered { body: "not json" }) {
    OperatorRouteUnreadable { cause: _ } => true
    OperatorRouteServing { model: _ } => false
    OperatorRouteModelNotAdmitted { advertised: _ } => false
    OperatorRouteUnreachable { url: _ } => false
  }
}

// ── 3. THE REQUEST CARRIES THE BEARER HEADER FROM THE FILE'S TEXT, NEVER INLINED ───────────────
test fn an_empty_credential_file_is_refused_not_sent_as_an_empty_bearer() -> Bool {
  match operator_header_text(key_text: "\n", session: "attempt-1" as NonEmptyStr) {
    Absent => true
    Present { value: _ } => false
  }
}

fn custody_path_text(path: NonEmptyStr?) -> String {
  match path {
    Absent => ""
    Present { value: p } => p as String
  }
}

// WHERE THE TWO FILES ARE FOUND. A harness the manager handed a credentials directory reads the route's files there
// under the route's identifiers -- the same identifiers the dedicated worker unit loads them as
// (test.claim.roadmap.dispatch_worker_traversal_witness the_dedicated_worker_unit_loads_both_pool_files_from_the_root_credstore)
// -- and never from a home; one with only a home reads its custody there; one with neither locates nothing.
test fn handed_credentials_are_read_from_the_managers_directory_and_a_home_only_from_its_custody() -> Bool {
  let r = harness_operator_route
  let handed = OperatorCredentialHandedByManager { directory: "/run/credentials/gunbc-attempt-n-k.service" as NonEmptyStr }
  let home = OperatorCredentialInHome { home: "/home/svc" as NonEmptyStr }
  custody_path_text(path: operator_custody_file_path(custody: handed, identifier: r.credential_identifier, relative: r.credential_relative_path))
    == "/run/credentials/gunbc-attempt-n-k.service/gunbc-pool-front-api-key"
    && custody_path_text(path: operator_custody_file_path(custody: handed, identifier: r.certificate_identifier, relative: r.certificate_relative_path))
      == "/run/credentials/gunbc-attempt-n-k.service/gunbc-pool-front-server-pem"
    && custody_path_text(path: operator_custody_file_path(custody: home, identifier: r.credential_identifier, relative: r.credential_relative_path))
      == "/home/svc/.config/gunbc-pool-front/api-key"
    && custody_path_text(path: operator_custody_file_path(custody: OperatorCredentialUnlocated, identifier: r.credential_identifier, relative: r.credential_relative_path)) == ""
}

test fn the_operator_backend_access_hands_the_turn_its_header_file_and_a_seat_has_none() -> Bool {
  let hf = "/tmp/hdr/authorization" as NonEmptyStr
  (match harness_backend_header_file(access: BackendAdmittedByOperatorEndpoint { header_file: hf }) {
    Present { value: f } => (f as String) == "/tmp/hdr/authorization"
    Absent => false
  }) && (match harness_backend_header_file(access: BackendAdmittedBySeat) {
    Absent => true
    Present { value: _ } => false
  })
}

// ── 4. ANY ADMITTED MODEL PLACES ON THE OPERATOR ROUTE (the operator's 2026-10-11 ruling) ──────
test fn any_admitted_model_places_on_the_operator_endpoint_not_a_fleet_seat() -> Bool {
  match harness_requirement_placement(requirement: AnyAdmittedModel, class: BatchQualityTolerant) {
    RunOnOperatorEndpoint => true
    PlacedOnFleetSeat => false
    LeasedFromHostedQuota => false
  }
}

test fn a_quality_sensitive_any_model_turn_keeps_its_fleet_seat() -> Bool {
  match harness_requirement_placement(requirement: AnyAdmittedModel, class: InteractiveQualitySensitive) {
    PlacedOnFleetSeat => true
    RunOnOperatorEndpoint => false
    LeasedFromHostedQuota => false
  }
}

// ── 5. THE QUALITY FLOOR IS NOT SILENT ──────────────────────────────────────────────────────────
test fn the_floor_refuses_a_quality_sensitive_turn_with_its_consequence_and_admits_batch() -> Bool {
  (match operator_class_admission(route: harness_operator_route, class: InteractiveQualitySensitive) {
    OperatorClassRefused { detail: d } => string_contains(s: d, pattern: "Qwen3.8-Flash-Next")
    OperatorClassAdmitted => false
  }) && (match operator_class_admission(route: harness_operator_route, class: BatchQualityTolerant) {
    OperatorClassAdmitted => true
    OperatorClassRefused { detail: _ } => false
  })
}

// ── 6. THE ROUTE'S DECLARED FACTS ───────────────────────────────────────────────────────────────
test fn the_route_urls_are_the_pool_fronts_origin_plus_its_declared_paths() -> Bool {
  (match operator_models_url() { Present { value: u } => (u as String) == "https://srv2.tailecbe08.ts.net:3737/pool/v1/models"  Absent => false })
    && (match operator_chat_completions_url() { Present { value: u } => (u as String) == "https://srv2.tailecbe08.ts.net:3737/pool/v1/chat/completions"  Absent => false })
}

test fn the_route_carries_the_fronts_card_concurrency_and_the_served_model_id() -> Bool {
  harness_operator_route.concurrency_ceiling == 7
    && (harness_unit_model_id(unit: Qwen38FlashNextOnPoolFront) as String) == "slop"
}

test fn the_qwen_unit_refuses_reasoning_off_because_no_per_request_switch_was_read() -> Bool {
  (match harness_reasoning_kwargs_for(unit: Qwen38FlashNextOnPoolFront, level: ReasoningOff) {
    ReasoningLevelUnsupported { unit: _, level: _, cause: _ } => true
    ReasoningKwargsAdmitted { kwargs: _ } => false
  }) && (match harness_reasoning_kwargs_for(unit: Qwen38FlashNextOnPoolFront, level: ReasoningMaximum) {
    ReasoningKwargsAdmitted { kwargs: _ } => true
    ReasoningLevelUnsupported { unit: _, level: _, cause: _ } => false
  })
}

test fn a_models_document_with_no_data_array_is_unreadable_not_an_empty_list() -> Bool {
  match operator_route_standing(route: harness_operator_route, reading: OperatorModelsAnswered { body: "{\"error\":{\"code\":\"invalid_api_key\"}}" }) {
    OperatorRouteUnreadable { cause: _ } => true
    OperatorRouteServing { model: _ } => false
    OperatorRouteModelNotAdmitted { advertised: _ } => false
    OperatorRouteUnreachable { url: _ } => false
  }
}

// ── 7. THE OLD CARD'S MODEL NAME IS NOT THE FRONT'S ───────────────────────────────────────────
test fn the_retired_cards_model_name_is_not_admitted_by_the_fronts_list() -> Bool {
  match w_roster_after(reading: OperatorModelsAnswered { body: w_models_body(id: "qwen") }) {
    HarnessRosterServing { serving: _, declined: _, unresolved: _ } => false
    HarnessRosterNoneServing { declined: d, unresolved: _ } => count(d) == 1
  }
}

test fn the_cards_reasoning_is_read_from_the_member_ninfer_emits() -> Bool {
  (match harness_unit_reasoning_field(unit: Qwen38FlashNextOnPoolFront) { Present { value: _ } => false  Absent => true })
    && (match harness_unit_reasoning_field(unit: Qwen3_8_27bOnNinfer) { Present { value: f } => (f as String) == "reasoning_content"  Absent => false })
}

// ═══ POOL-FRONT-ROUTE-1 CLAIMS (supplied values at each interface) ══════════════════════════════
fn w_post(success: Bool, exit_code: Int, status_line: String, body: String) -> HarnessPostOutcome {
  HarnessPostOutcome {
    body: body,
    success: success,
    headers: Present { value: HeaderDumpRead { text: status_line } },
    fault: operator_round_fault(success: success, curl_exit: exit_code, status: match string_contains(s: status_line, pattern: " 503") { true => Present { value: 503 } false => Absent }),
    retries: [],
  }
}

// CLAIM 1. A request on the pool route carries the bearer key, x-pool-session = the conversation id, and the
// model id. The header file's text is the interface; the model id is the unit's.
test fn a_request_on_the_pool_route_carries_the_bearer_the_session_and_the_model() -> Bool {
  (match operator_header_text(key_text: "k-123\n", session: "attempt-77" as NonEmptyStr) {
    Present { value: t } =>
      (t as String) == "Authorization: Bearer k-123\nx-pool-session: attempt-77\n"
    Absent => false
  }) && (harness_unit_model_id(unit: Qwen38FlashNextOnPoolFront) as String) == (pool_front_any_card_model_id as String)
    && (pool_front_session_header_name as String) == "x-pool-session"
}

test fn a_session_identity_that_could_end_its_header_line_is_refused_not_sent() -> Bool {
  match operator_header_text(key_text: "k", session: "a\nAuthorization: Bearer evil" as NonEmptyStr) {
    Absent => true
    Present { value: _ } => false
  }
}

// CLAIM 2. A presented certificate with another fingerprint refuses before sending: the pin decision is made
// on the custody file's fingerprint, and no request is built for a refused one. A curl peer-verification exit
// is the same refusal in the handshake.
test fn a_certificate_with_another_fingerprint_is_not_pinned() -> Bool {
  (operator_certificate_pin_decision(fingerprint_stdout: join(["sha256 Fingerprint=", operator_pinned_certificate.sha256_fingerprint as String, "\n"], "")))
    && !(operator_certificate_pin_decision(fingerprint_stdout: "sha256 Fingerprint=AA:BB:CC\n"))
    && !(operator_certificate_pin_decision(fingerprint_stdout: ""))
    && !(operator_certificate_pin_decision(fingerprint_stdout: "no fingerprint here"))
}

test fn a_curl_exit_60_is_a_host_verification_refusal_typed_apart_from_a_different_certificate_and_is_never_retried() -> Bool {
  let p = w_post(success: false, exit_code: 60, status_line: "", body: "")
  (match p.fault {
    Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: x } } => x == 60
    Present { value: OperatorCertificateNotPinned { curl_exit: _ } } => false
    Present { value: OperatorNoCapacity } => false
    Absent => false
  }) && !harness_post_is_retryable(posted: p)
}

// The pin firing is curl exit 90 (the pinned public key did not match) and a peer the trust anchor refuses is 51:
// both are a different certificate, typed NotPinned, never retried, never read as no capacity.
fn peer_exit_is_typed_not_pinned_and_never_retried(code: Int) -> Bool {
  let p = w_post(success: false, exit_code: code, status_line: "", body: "")
  (match p.fault {
    Present { value: OperatorCertificateNotPinned { curl_exit: x } } => x == code
    Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: _ } } => false
    Present { value: OperatorNoCapacity } => false
    Absent => false
  }) && !harness_post_is_retryable(posted: p)
}

test fn a_pinned_public_key_mismatch_curl_exit_90_is_not_pinned_and_never_retried() -> Bool {
  peer_exit_is_typed_not_pinned_and_never_retried(code: 90)
}

// Exit 51 is CURLE_OBSOLETE51 at the pinned curl floor (>= 7.68), never emitted: it is no trust outcome, so it
// carries no certificate fault and the round is not a certificate refusal.
test fn curl_exit_51_is_obsolete_and_is_not_typed_as_a_certificate_refusal() -> Bool {
  let p = w_post(success: false, exit_code: 51, status_line: "", body: "")
  match p.fault {
    Present { value: _ } => false
    Absent => true
  }
}

// CLAIM 3. A 503 from the front yields the typed no-capacity outcome: a hold on the retry policy, recorded, and
// NEITHER an unexplained engine refusal NOR an ended session.
test fn a_503_from_the_front_is_typed_no_capacity_and_held_not_unexplained() -> Bool {
  let p = w_post(success: false, exit_code: 22, status_line: "HTTP/1.1 503 Service Unavailable\r\n", body: "")
  (match p.fault {
    Present { value: OperatorNoCapacity } => true
    Present { value: OperatorCertificateNotPinned { curl_exit: _ } } => false
    Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: _ } } => false
    Absent => false
  }) && harness_post_is_retryable(posted: p)
    && (harness_outcome_label(outcome: TurnPoolNoCapacity { retries: 3, steps_taken: 2 }) == "pool-no-capacity")
}

test fn a_503_with_an_empty_body_carries_the_typed_no_capacity_fault() -> Bool {
  // asserts the fault the post carries, which the turn path consults before the unexplained-refusal classifier.
  let p = w_post(success: false, exit_code: 22, status_line: "HTTP/1.1 503 Service Unavailable\r\n", body: "")
  match p.fault {
    Present { value: OperatorNoCapacity } => true
    Present { value: OperatorCertificateNotPinned { curl_exit: _ } } => false
    Present { value: OperatorCertificateNotVerifiedForHost { curl_exit: _ } } => false
    Absent => false
  }
}

// CLAIM 4 (control). An S3 resume keeps the same x-pool-session: the session is the attempt id, so rebinding the
// same attempt writes byte-identical header text, and a different attempt does not.
test fn an_s3_resume_of_the_same_attempt_keeps_the_same_x_pool_session() -> Bool {
  let fresh = operator_header_text(key_text: "k", session: "attempt-9" as NonEmptyStr)
  let resumed = operator_header_text(key_text: "k", session: "attempt-9" as NonEmptyStr)
  let other = operator_header_text(key_text: "k", session: "attempt-10" as NonEmptyStr)
  (match fresh { Present { value: a } => match resumed { Present { value: b } => (a as String) == (b as String)  Absent => false }  Absent => false })
    && (match fresh { Present { value: a } => match other { Present { value: c } => (a as String) != (c as String)  Absent => false }  Absent => false })
}

// CLAIM 5. INHABITANCE: the real HTTPS client realization (the shell transport's materialized argv) produces the
// request shape claim 1 supplies: the pool route's URL, the header FILE that carries bearer and session, the
// pinned certificate and public key, and never a verification-off flag.
test fn the_real_client_argv_inhabits_the_pool_request_shape() -> Bool {
  let req = operator_pinned_post_request(
    url: "https://srv2.tailecbe08.ts.net:3737/pool/v1/chat/completions" as NonEmptyStr,
    request_body_file: "/s/req.json" as NonEmptyStr,
    response_headers_file: "/s/req.headers" as NonEmptyStr,
    max_seconds: "600" as NonEmptyStr,
    hf: "/s/d/authorization" as NonEmptyStr
  )
  let argv = join(operation_argv_tokens_or_refusal_label(m: shell_materialize_operation_argv(
    "dag/extdeps/http/client.dag",
    "http.Client",
    "PostJsonFromFileWithHeaderFilePinned",
    [
      operation_argv_bind_text(name: "url", text: req.url as String),
      operation_argv_bind_text(name: "request_body_file", text: req.request_body_file as String),
      operation_argv_bind_text(name: "header_file", text: req.header_file as String),
      operation_argv_bind_text(name: "response_headers_file", text: req.response_headers_file as String),
      operation_argv_bind_text(name: "ca_file", text: req.ca_file as String),
      operation_argv_bind_text(name: "pinned_pubkey_file", text: req.pinned_pubkey_file as String),
      operation_argv_bind_text(name: "max_seconds", text: req.max_seconds as String),
    ]
  )), " ")
  string_contains(s: argv, pattern: "https://srv2.tailecbe08.ts.net:3737/pool/v1/chat/completions")
    && string_contains(s: argv, pattern: "-H @/s/d/authorization")
    && string_contains(s: argv, pattern: "--cacert /s/d/pinned-ca.pem")
    && string_contains(s: argv, pattern: "--pinnedpubkey /s/d/pinned-pubkey.pem")
    && !string_contains(s: argv, pattern: "--insecure")
    && !string_contains(s: argv, pattern: " -k ")
    && !string_contains(s: argv, pattern: "Bearer")
}

// The front-door probe's request, from the builder the probe's call site takes every field from.
test fn the_probe_argv_trusts_the_pinned_files_beside_the_header_file() -> Bool {
  let req = operator_pinned_probe_request(
    url: "https://srv2.tailecbe08.ts.net:3737/pool/v1/models" as NonEmptyStr,
    dir: "/s/d" as NonEmptyStr,
    max_seconds: "10" as NonEmptyStr,
    hf: "/s/d/authorization" as NonEmptyStr
  )
  let argv = join(operation_argv_tokens_or_refusal_label(m: shell_materialize_operation_argv(
    "dag/extdeps/http/client.dag",
    "http.Client",
    "GetBoundedWithHeaderFilePinned",
    [
      operation_argv_bind_text(name: "url", text: req.url as String),
      operation_argv_bind_text(name: "header_file", text: req.header_file as String),
      operation_argv_bind_text(name: "response_headers_file", text: req.response_headers_file as String),
      operation_argv_bind_text(name: "ca_file", text: req.ca_file as String),
      operation_argv_bind_text(name: "pinned_pubkey_file", text: req.pinned_pubkey_file as String),
      operation_argv_bind_text(name: "max_seconds", text: req.max_seconds as String),
    ]
  )), " ")
  string_contains(s: argv, pattern: "--cacert /s/d/pinned-ca.pem")
    && string_contains(s: argv, pattern: "--pinnedpubkey /s/d/pinned-pubkey.pem")
    && string_contains(s: argv, pattern: "-H @/s/d/authorization")
    && string_contains(s: argv, pattern: "-D /s/d/probe-response-headers")
}

// ── THE FRONT'S STATED LIMITS ARE ENFORCED, NOT ONLY DECLARED ───────────────────────────────────
test fn an_output_budget_above_the_fronts_32k_is_capped_before_sending() -> Bool {
  harness_capped_max_tokens(unit: Qwen38FlashNextOnPoolFront, asked: 40000) == pool_output_budget_policy.value as Int
    && harness_capped_max_tokens(unit: Qwen38FlashNextOnPoolFront, asked: 16384) == 16384
}

test fn a_unit_with_no_stated_output_cap_is_not_capped() -> Bool {
  harness_capped_max_tokens(unit: DeepseekV4FlashOnVllm, asked: 40000) == 40000
}

// The turn refuses over config.context_budget = harness_context_budget_for(unit), which takes the unit's
// declared ceiling; the ceiling is the front's stated maximum context.
test fn the_pool_units_context_ceiling_is_the_fronts_max_context() -> Bool {
  token_count_value(t: harness_unit_declared_context_ceiling(unit: Qwen38FlashNextOnPoolFront)) == pool_context_budget_policy.value
}

// An uncited guess is not consumed as a read fact: while the figures are TranscribedUncited the pool unit
// parses no reasoning member (the projection is absent) and the figure reads refuse.
test fn an_uncited_pool_figure_is_not_read_and_the_projection_parses_nothing() -> Bool {
  (match cited_figure_read(figure: pool_front_message_reasoning_field) { Present { value: _ } => false  Absent => true })
    && (match cited_figure_read(figure: pool_front_thinking_end_token) { Present { value: _ } => false  Absent => true })
    && (match harness_unit_reasoning_projection(unit: Qwen38FlashNextOnPoolFront) { Present { value: _ } => false  Absent => true })
}

// The real harness CLI's exit derivation maps the held turn to exit 1 labelled pool-no-capacity (not success).
test fn a_503_held_turn_exits_failure_labelled_pool_no_capacity() -> Bool {
  match harness_turn_exit(outcome: TurnPoolNoCapacity { retries: 3, steps_taken: 2 }) {
    ExitSuccess => false
    ExitFailure { code, reason } => code == 1 && reason.contains("pool-no-capacity")
  }
}

// CONSUMERS RESPECT THE GATE: while the figures are uncited, no consumer reads a reasoning member, an alias or a closer.
test fn no_consumer_reads_the_uncited_pool_figures() -> Bool {
  (match harness_unit_thinking_end_token(unit: Qwen38FlashNextOnPoolFront) { Present { value: _ } => false  Absent => true })
    && (match harness_unit_model_reasoning_field(unit: Qwen38FlashNextOnPoolFront) { Present { value: _ } => false  Absent => true })
    && list_length(items: harness_unit_reasoning_field_aliases(unit: Qwen38FlashNextOnPoolFront)) == 0
}

// The upstream's limit is the operator's word until read: a transcribed limit is no reading, so the lab's own
// policy is what is enforced; a limit that is read and smaller tightens the policy, never loosens it.
test fn an_unread_pool_limit_is_no_reading_and_the_lab_policy_is_enforced() -> Bool {
  (match cited_figure_read(figure: pool_front_max_output_tokens) { Present { value: _ } => false  Absent => true })
    && pool_budget_enforced(policy: pool_output_budget_policy, upstream: pool_front_max_output_tokens) == pool_output_budget_policy.value
}

// The pin lives in two files beside the header file, one plan the route uses to write the certificate, to
// fingerprint and extract the key FROM, and that curl is handed. The argv rendered from the plan names exactly the
// plan's files (a pin repointed at the source under HOME, or a curl argument spelled elsewhere, no longer matches),
// and both sit in the private directory, not at the source path.
test fn the_pin_plan_is_the_files_curl_is_handed_and_lies_beside_the_header_file() -> Bool {
  let plan = operator_pin_plan(header_file: "/s/d/authorization" as NonEmptyStr)
  (plan.ca_file as String) == "/s/d/pinned-ca.pem"
    && (plan.pubkey_file as String) == "/s/d/pinned-pubkey.pem"
    && !string_contains(s: plan.ca_file as String, pattern: "gunbc-pool-front")
}
