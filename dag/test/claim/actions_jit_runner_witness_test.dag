module gunbc.test.claim.actions_jit_runner_witness_test

import std.types { String, NonEmptyStr, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.github.actions_jit_runner {
  JitConfigMintOutcome, JitConfigMinted, JitConfigMintRefused,
  JitConfigMintNotFound, JitConfigMintConflict, JitConfigMintValidationFailed,
  jit_config_mint_outcome, org_generate_jitconfig_path,
  org_generate_jitconfig_url, jit_config_request_body, jit_config_created_status,
  JitRunnerConfigRequest, JitRunnerName, JitRunnerGroupId, JitRunnerLabel, JitWorkFolder,
  jit_config_not_found_status, jit_config_conflict_status, jit_config_validation_failed_status,
}
import gunbc.runner_jit_perform {
  JitCredentialPlacement, JitCredentialPlaced, JitCredentialRefused,
  jit_status_is_created, jit_placement_admitted,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn mint_did_not_succeed(o: JitConfigMintOutcome) -> Bool {
  match o {
    JitConfigMinted { config: _, runner_id: _ } => false
    JitConfigMintRefused { status: _, reason: _ } => true
    JitConfigMintNotFound { reason: _ } => true
    JitConfigMintConflict { reason: _ } => true
    JitConfigMintValidationFailed { reason: _ } => true
  }
}

// A 201 WITH AN EMPTY BODY IS THE DISCRIMINATING CASE and the reason this function exists at all.
// Status-only branching accepts it, and the guest then boots holding an empty credential drive and
// waits out its whole deadline looking healthy -- a silent wrong answer, which is outside the
// ladder entirely. Both a non-201 AND the empty 201 must refuse, so the positive control below is
// what keeps this from being satisfied by a function that refuses everything.
test fn a_201_with_an_empty_config_is_a_refusal_not_a_credential() -> Bool {
  mint_did_not_succeed(o: jit_config_mint_outcome(
    status: 201, encoded: "", runner_id: 7, error_body: ""
  ))
}

test fn a_forbidden_status_is_a_generic_refusal() -> Bool {
  match jit_config_mint_outcome(
    status: 403, encoded: "", runner_id: 0, error_body: "Resource not accessible by integration"
  ) {
    JitConfigMintRefused { status: s, reason: r } =>
      s == 403 && r == "Resource not accessible by integration"
    _ => false
  }
}

test fn a_404_is_not_found_not_a_generic_refusal() -> Bool {
  match jit_config_mint_outcome(
    status: jit_config_not_found_status, encoded: "", runner_id: 0, error_body: "not found"
  ) {
    JitConfigMintNotFound { reason: r } => r == "not found"
    _ => false
  }
}

test fn a_409_is_conflict_not_validation_or_generic_refusal() -> Bool {
  match jit_config_mint_outcome(
    status: jit_config_conflict_status, encoded: "", runner_id: 0, error_body: "already exists"
  ) {
    JitConfigMintConflict { reason: r } => r == "already exists"
    _ => false
  }
}

test fn a_422_is_validation_failed_not_conflict() -> Bool {
  match jit_config_mint_outcome(
    status: jit_config_validation_failed_status,
    encoded: "ignored-because-the-status-refused",
    runner_id: 0,
    error_body: "validation failed",
  ) {
    JitConfigMintValidationFailed { reason: r } => r == "validation failed"
    _ => false
  }
}

// POSITIVE CONTROL. Without it every assertion above is satisfied by a function that refuses
// unconditionally, and the suite would read as coverage while asserting nothing about minting.
test fn a_created_status_with_a_body_mints() -> Bool {
  match jit_config_mint_outcome(status: 201, encoded: "eyJib2R5Ijoib3BhcXVlIn0=", runner_id: 4242, error_body: "") {
    JitConfigMinted { config: c, runner_id: id } =>
      id == 4242 && (c.encoded as String) == "eyJib2R5Ijoib3BhcXVlIn0="
    _ => false
  }
}

// THE PATH IS DERIVED FROM THE ORG rather than assembled per call site, so a caller cannot address
// another organization's runners. Two distinct orgs must yield two distinct paths -- a constant
// would pass a single-org assertion.
test fn the_jitconfig_path_is_derived_per_organization() -> Bool {
  org_generate_jitconfig_path(org_login: "gunb-ai" as NonEmptyStr)
    == "/orgs/gunb-ai/actions/runners/generate-jitconfig"
    && org_generate_jitconfig_path(org_login: "other-org" as NonEmptyStr)
       == "/orgs/other-org/actions/runners/generate-jitconfig"
}


data witness_jit_request: JitRunnerConfigRequest = JitRunnerConfigRequest {
  name: JitRunnerName { value: "gunbc-microvm-srv1-01-a1" as NonEmptyStr },
  runner_group_id: JitRunnerGroupId { value: 1 },
  labels: [
    JitRunnerLabel { value: "self-hosted" as NonEmptyStr },
    JitRunnerLabel { value: "gunbc-microvm" as NonEmptyStr },
  ],
  work_folder: JitWorkFolder { value: "_work" as NonEmptyStr },
}

// THE REQUEST BODY IS PINNED BYTE FOR BYTE, because it is the one artifact here whose defects are
// entirely invisible to the type checker. Every field spelling is GitHub's, a missing quote or a
// dropped comma is still a String, and the first thing that would notice is the live endpoint
// answering 422 -- after a call that may already have created a runner identity.
test fn the_mint_request_body_renders_the_documented_shape() -> Bool {
  jit_config_request_body(request: witness_jit_request)
    == "{\"name\": \"gunbc-microvm-srv1-01-a1\", \"runner_group_id\": 1, \"labels\": [\"self-hosted\", \"gunbc-microvm\"], \"work_folder\": \"_work\"}"
}

// THE ESCAPING CONTROL, and it is the reason the renderer above is not hand-written. A runner name
// carrying a quote or a backslash is a perfectly ordinary NonEmptyStr -- no type here rejects it --
// and a renderer that concatenated quotes would emit a document that ends the name early and leaves
// the rest of the request as garbage. The first thing to notice would be the live endpoint, with a
// 422, after a call that may already have created a runner identity. This is a DISCRIMINATING RED
// against the previous concatenating renderer: it passed the pin above and would fail this.
test fn a_name_carrying_a_quote_is_escaped_rather_than_ending_the_field() -> Bool {
  jit_config_request_body(
    request: JitRunnerConfigRequest {
      name: JitRunnerName { value: "a\"b" as NonEmptyStr },
      runner_group_id: JitRunnerGroupId { value: 1 },
      labels: [JitRunnerLabel { value: "self-hosted" as NonEmptyStr }],
      work_folder: JitWorkFolder { value: "_work" as NonEmptyStr },
    },
  ) == "{\"name\": \"a\\\"b\", \"runner_group_id\": 1, \"labels\": [\"self-hosted\"], \"work_folder\": \"_work\"}"
}

// THE URL JOINS THE TWO AUTHORITIES THAT OWN ITS HALVES and addresses the org the caller named. A
// path assembled at a call site is how one organization's runners get addressed while a different
// one was intended, which is not a failure any type here would catch.
test fn the_mint_url_addresses_the_named_organization() -> Bool {
  org_generate_jitconfig_url(org_login: "gunb-ai" as NonEmptyStr)
    == "https://api.github.com/orgs/gunb-ai/actions/runners/generate-jitconfig"
}

// ONLY 201 IS CREATED, AND THE TRIMMING IS LOAD-BEARING because the status arrives as curl's own
// -w output rather than as a parsed field. A reader that accepted any 2xx would treat a 200 -- which
// this endpoint does not answer on success -- as a minted credential and place an empty drive.
test fn only_a_created_status_counts_as_created() -> Bool {
  jit_status_is_created(status_text: "201")
    && jit_status_is_created(status_text: " 201\n")
    && !jit_status_is_created(status_text: "200")
    && !jit_status_is_created(status_text: "422")
    && !jit_status_is_created(status_text: "")
    && to_string(jit_config_created_status) == "201"
}

// A REFUSED PLACEMENT IS NOT ADMITTED, which is the arm every caller branches on. Without this the
// placement type could carry a refusal that reads as success at the one call site that matters.
test fn a_refused_placement_is_not_admitted() -> Bool {
  !jit_placement_admitted(p: JitCredentialRefused { cause: "the cell is not owned" })
    && jit_placement_admitted(p: JitCredentialPlaced {
         drive_file: "/opt/fabric-cells/srv1-01/attempts/a1/jit.img",
         runner_name: "gunbc-microvm-srv1-01-a1" as NonEmptyStr,
       })
}
