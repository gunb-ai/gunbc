module test.claim.declared_type_inhabitance_position_matrix_test

// THE POSITION MATRIX FOR DECLARED-TYPE INHABITANCE, ENROLLED SO THE CENSUS EXECUTES.
//
// The invariant: every value accepted at a declared-type position inhabits that declared type.
// DESIGN section 4b puts it in the ORDINARY COMPILER FLOOR, so a failure here is a below-baseline
// safety regression and not a class sitting at mitigatable.
//
// The positions are enumerated FROM THE GRAMMAR -- the call sites of v1.compiler.parse
// parse_type_expr, the one production that reads a declared type from source -- rather than from
// the list of seams someone happened to find. The enumeration, the measured verdicts and the
// instrument are in docs/probes/declared_type_inhabitance_position_census_2026-08-22/.
//
// FOUR SPECIMENS PER POSITION, AND EACH ANSWERS A DIFFERENT QUESTION:
//
//   member    SameRev          a member of the declared coproduct  -- must be ACCEPTED. A wall that
//                              refused this would be a fabricated refusal, which DESIGN section 5
//                              forbids exactly as it forbids a fabricated success.
//   kernel    7                a plain kernel value                -- must REFUSE.
//   payload   mk_inner()       one arm's payload at the PARENT position -- must REFUSE. This is the
//                              shape that caused the 2026-08-22 outage: a value entered the bad
//                              state at a construction site, stayed latent, and surfaced one stage
//                              away as a non-exhaustive match on a value that is not in its type.
//   undefined nosuchname_zzz   an undefined name                   -- must REFUSE, and this is the
//                              REACHABILITY CONTROL. If it refuses, the position is analysed, so a
//                              passing kernel arm is a missing judgment rather than a skipped
//                              fixture. If it PASSES, no analysis reaches the expression at all --
//                              a different and worse defect, and it is measured at two positions
//                              here (param_default, field_default).
//
// WHY THE CONTROL IS NOT CEREMONY: both of the census's first two runs returned a complete table of
// zeroes that read as "no position refuses anything anywhere". The reachability control's own zero
// is what exposed the instrument rather than the compiler, twice. A zero from a measurement is only
// readable beside a nonzero from the same instrument.
//
// WHAT IS RED TODAY IS RED BY DESIGN AND NOT RELAXABLE: the only edit that may green one of these
// is making the ill-typed construction refuse. Per DESIGN section 4b(4) the controls do NOT retire
// when a wall lands -- an expecting-red row deletes and its witness stays enrolled as the permanent
// regression control, because deleting the evidence on the climb recreates
// specification-without-execution one rung up.

import std.types { String, Bool, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CensusObserved, CensusNotRunnable,
  census_blocking_rows, census_total_count, census_rows_of_class
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// -1 distinguishes "the census could not run" from "the census observed nothing", so a
// could-not-measure can never be read as a clean compile.
fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

fn type_mismatch_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch"))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

// ---------------------------------------------------------------------------
// a module-scope `data` initializer
// ---------------------------------------------------------------------------
data src_data_initializer_member: String = "module probe.data_initializer_member\nimport std.types { Int, String, List, Map }\n\ntype Inner { value: Int }\n\ntype Rel\n  = Wrapped { inner: Inner }\n  | SameRev\n\ntype Boxed<T> { inner: T }\n\ntype Holder { rel: Rel }\n\nfn mk_inner() -> Inner { Inner { value: 7 } }\n\ndata d: Rel = SameRev\n"
data src_data_initializer_kernel: String = "module probe.data_initializer_kernel\nimport std.types { Int, String, List, Map }\n\ntype Inner { value: Int }\n\ntype Rel\n  = Wrapped { inner: Inner }\n  | SameRev\n\ntype Boxed<T> { inner: T }\n\ntype Holder { rel: Rel }\n\nfn mk_inner() -> Inner { Inner { value: 7 } }\n\ndata d: Rel = 7\n"
data src_data_initializer_payload: String = "module probe.data_initializer_payload\nimport std.types { Int, String, List, Map }\n\ntype Inner { value: Int }\n\ntype Rel\n  = Wrapped { inner: Inner }\n  | SameRev\n\ntype Boxed<T> { inner: T }\n\ntype Holder { rel: Rel }\n\nfn mk_inner() -> Inner { Inner { value: 7 } }\n\ndata d: Rel = mk_inner()\n"
data src_data_initializer_undefined: String = "module probe.data_initializer_undefined\nimport std.types { Int, String, List, Map }\n\ntype Inner { value: Int }\n\ntype Rel\n  = Wrapped { inner: Inner }\n  | SameRev\n\ntype Boxed<T> { inner: T }\n\ntype Holder { rel: Rel }\n\nfn mk_inner() -> Inner { Inner { value: 7 } }\n\ndata d: Rel = nosuchname_zzz\n"

test fn data_initializer_accepts_a_declared_member() -> Bool {
  blocking_count(source: src_data_initializer_member) == 0
}

test fn data_initializer_refuses_a_plain_kernel_value() -> Bool {
  type_mismatch_count(source: src_data_initializer_kernel) >= 1
}

test fn data_initializer_refuses_an_arm_payload_at_the_parent() -> Bool {
  type_mismatch_count(source: src_data_initializer_payload) >= 1
}

test fn data_initializer_is_reached_at_all() -> Bool {
  blocking_count(source: src_data_initializer_undefined) >= 1
}

