module test.claim.uri_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn uri_scheme_is_http_matches_https_holds() -> Bool {
  extdeps.uri.uri_scheme_is_http(s: extdeps.uri.Https)
}

test fn uri_scheme_is_http_rejects_file_holds() -> Bool {
  extdeps.uri.uri_scheme_is_http(s: extdeps.uri.File) == false
}

test fn uri_is_url_https_projection_holds() -> Bool {
  extdeps.uri.uri_is_url(uri: extdeps.uri.Uri { scheme: extdeps.uri.Https, locator: "example.com/spec" })
}

test fn uri_is_url_file_not_url_holds() -> Bool {
  extdeps.uri.uri_is_url(uri: extdeps.uri.Uri { scheme: extdeps.uri.File, locator: "/doc/spec.pdf" }) == false
}

