module test.claim.v1_compiler_tests_typecheck_module_callers_hand_rust_witness

import gunbc.v1_compiler_tests_typecheck_module_callers_scaffold {
  v1_compiler_tests_typecheck_module_callers_hand_rust_dissolve_trigger,
  v1_compiler_tests_typecheck_module_callers_hand_rust_loc_delta_net,
  v1_compiler_tests_typecheck_module_callers_hand_rust_paths,
  v1_compiler_tests_typecheck_module_callers_hand_rust_receipt_plan_anchor,
  v1_compiler_tests_typecheck_module_callers_hand_rust_receipt_witness_entry,
  v1_compiler_tests_typecheck_module_callers_hand_rust_roadmap_lane_anchor,
  v1_compiler_tests_typecheck_module_callers_hand_rust_scaffold
}
import std.disposition { Scaffold, SingleAuthority }
import std.types { Bool }
import v2.std.algebra { length }
import std.dissolution { dissolution_description }

test fn v1_compiler_tests_typecheck_module_callers_hand_rust_scaffold_is_seed_retained() -> Bool {
  match v1_compiler_tests_typecheck_module_callers_hand_rust_scaffold {
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn v1_compiler_tests_typecheck_module_callers_scaffold_names_receipt_fields() -> Bool {
  !(dissolution_description(condition: v1_compiler_tests_typecheck_module_callers_hand_rust_dissolve_trigger) == "")
    && !(v1_compiler_tests_typecheck_module_callers_hand_rust_receipt_plan_anchor == "")
    && !(v1_compiler_tests_typecheck_module_callers_hand_rust_roadmap_lane_anchor == "")
    && v1_compiler_tests_typecheck_module_callers_hand_rust_receipt_witness_entry == "dag/test/claim/v1_compiler_tests_typecheck_module_callers_hand_rust_witness_test.dag"
}

test fn v1_compiler_tests_typecheck_module_callers_loc_delta_matches_roster() -> Bool {
  v1_compiler_tests_typecheck_module_callers_hand_rust_loc_delta_net == length(xs: v1_compiler_tests_typecheck_module_callers_hand_rust_paths)
}

test fn v1_compiler_tests_typecheck_module_callers_dissolve_trigger_cites_compile_gate_receipt() -> Bool {
  string_contains(
    s: dissolution_description(condition: v1_compiler_tests_typecheck_module_callers_hand_rust_dissolve_trigger),
    pattern: "ci_v1_compiler_tests_compile_gate_emit"
  )
    && string_contains(
      s: dissolution_description(condition: v1_compiler_tests_typecheck_module_callers_hand_rust_dissolve_trigger),
      pattern: "global_variant_base"
    )
}
