// A request's plate plan is placements and support policy only. The physical attempt is derived from
// the request, artifact and printer, so a plate plan that still authors an "attempt" is refused, not
// silently ignored.
test fn request_plate_plan_decodes_without_an_attempt_and_refuses_one() -> Bool {
 (match parse_plate_plan(text:"\{\"placements\":[\{\"id\":\"FIT-RING\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":40000,\"y_um\":70000\}],\"support_free\":[\"FIT-RING\"]\}") {Present {value:p}=>count(p.placements)==1 Absent=>false}) &&
 (match parse_plate_plan(text:"\{\"attempt\":\"a16-plug-fit-ring-v1\",\"placements\":[\{\"id\":\"FIT-RING\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":40000,\"y_um\":70000\}],\"support_free\":[\"FIT-RING\"]\}") {Absent=>true Present {value:_}=>false})
}
