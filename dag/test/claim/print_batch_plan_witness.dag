module test.claim.print_batch_plan_witness
import std.types {Bool}
import product.printed_chassis.print_batch_plan {parse_plan,parse_plate_plan}

// Each independent admission rule has its own counterexample and verdict.
test fn two_printer_plan_decodes() -> Bool {
 match parse_plan(text:"[\{\"printer\":\"printer-01\",\"version\":\"1\",\"plates\":[\{\"attempt\":\"workflow-shadow-lower-printer-01\",\"placements\":[\{\"id\":\"CL-1-1\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":6000,\"y_um\":10000\},\{\"id\":\"CL-11\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":48000,\"y_um\":10000\}],\"support_free\":[]\}]\},\{\"printer\":\"printer-02\",\"version\":\"1\",\"plates\":[\{\"attempt\":\"workflow-shadow-lower-printer-02\",\"placements\":[\{\"id\":\"CL1-1\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":6000,\"y_um\":10000\},\{\"id\":\"CL11\",\"rx\":0,\"ry\":0,\"rz\":0,\"x_um\":48000,\"y_um\":10000\}],\"support_free\":[]\}]\}]") {Present {value:p}=>count(p)==2 Absent=>false}
}

test fn object_is_not_a_fleet() -> Bool {
 match parse_plan(text:"\{\}") {Absent=>true Present {value:_}=>false}
}

test fn empty_fleet_is_refused() -> Bool {
 match parse_plan(text:"[]") {Absent=>true Present {value:_}=>false}
}

