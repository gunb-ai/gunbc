test fn wholesale_join_names_github_depot_and_gitlab() -> Bool {
  count(cloud_arm_reseller_offers()) == 3
}

test fn customer_account_cloud_join_names_runs_on_and_sprinters() -> Bool {
  count(customer_account_cloud_arm_offers()) == 2
}

test fn mac_market_is_excluded_by_scope() -> Bool {
  string_length(s: mac_apple_silicon_ci_excluded_by_scope) > 0
}

test fn hetzner_is_named_as_supply_not_ci_seller() -> Bool {
  string_length(s: hetzner_not_a_ci_seller) > 0
}

data rogue_provider: DeclarationRef = decl_ref(
  module_path: "test.claim.arm_ci_seller_census_witness",
  decl_name: "rogue_provider",
)

data rogue_aarch64_without_cited_label: RunnerShapeRow = RunnerShapeRow {
  provider: rogue_provider,
  label: "uncited-arm",
  architecture: Aarch64,
  entitlement: EntitlementUnstated,
  vcpus: hardware_thread_count(2),
  memory: QuotedWithoutBasis { numeral: 8, unit_label: "GB" },
}

data rogue_catalog: RunnerCatalogAvailability = RunnerShapesCited {
  rows: [rogue_aarch64_without_cited_label],
}

test fn a_row_claiming_aarch64_without_a_cited_label_is_red() -> Bool {
  count(
    aarch64_rows_missing_cited_label(
      availability: rogue_catalog,
      cited_labels: page_cited_arm_labels(),
    ),
  ) == 1
}
