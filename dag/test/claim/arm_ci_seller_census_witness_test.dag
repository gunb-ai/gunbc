import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn offer_scope_nonempty(offer: SellerArmLinuxOffer) -> Bool {
  string_length(s: offer.snapshot.declared_scope) > 0
}

// Labels transcribed here from the same 2026-09-13 vendor pages the modules cite.
// They are NOT derived from RunnerShapeRow.label: a catalog row that claims Aarch64
// with a spelling absent from this list fails the same helper as the rogue fixture.
fn page_cited_arm_labels() -> List<NonEmptyStr> {
  [
    "blacksmith-2vcpu-ubuntu-2404-arm",
    "blacksmith-4vcpu-ubuntu-2404-arm",
    "blacksmith-8vcpu-ubuntu-2404-arm",
    "blacksmith-16vcpu-ubuntu-2404-arm",
    "blacksmith-32vcpu-ubuntu-2404-arm",
    "depot-ubuntu-24.04-arm",
    "depot-ubuntu-24.04-arm-4",
    "depot-ubuntu-24.04-arm-8",
    "depot-ubuntu-24.04-arm-16",
    "depot-ubuntu-24.04-arm-32",
    "depot-ubuntu-24.04-arm-64",
    "warp-ubuntu-latest-arm64-2x",
    "warp-ubuntu-latest-arm64-4x",
    "warp-ubuntu-latest-arm64-8x",
    "warp-ubuntu-latest-arm64-16x",
    "warp-ubuntu-latest-arm64-32x",
    "arm.medium",
    "arm.large",
    "arm.xlarge",
    "arm.2xlarge",
    "ubuntu-latest-arm-2core",
    "ubuntu-latest-arm-4core",
    "ubuntu-latest-arm-5core",
    "ubuntu-latest-arm-8core",
    "ubuntu-latest-arm-16core",
    "ubuntu-latest-arm-32core",
    "ubuntu-latest-arm-64core",
    "ubicloud-standard-2-arm",
    "ubicloud-standard-4-arm",
    "ubicloud-standard-8-arm",
    "ubicloud-standard-16-arm",
    "ubicloud-standard-30-arm",
    "1 vCPU 2 GB",
    "2 vCPU 4 GB",
    "2 vCPU 8 GB",
    "4 vCPU 8 GB",
    "4 vCPU 16 GB",
    "8 vCPU 16 GB",
    "8 vCPU 32 GB",
    "16 vCPU 32 GB",
    "16 vCPU 64 GB",
    "32 vCPU 64 GB",
    "32 vCPU 128 GB",
    "ghcr.io/cirruslabs/ubuntu-runner-arm64:24.04-sm",
    "ghcr.io/cirruslabs/ubuntu-runner-arm64:24.04-md",
    "ghcr.io/cirruslabs/ubuntu-runner-arm64:24.04-lg",
    "LINUX_ARM64_2X4",
    "LINUX_ARM64_4X16",
    "LINUX_ARM64_8X32",
    "LINUX_ARM64_16X64",
    "LINUX_ARM64_32X128",
    "LINUX_ARM64_64X256",
    "saas-linux-small-arm64",
    "saas-linux-medium-arm64",
    "saas-linux-large-arm64",
    "reserved.arm.2cpu.4gib",
    "reserved.arm.4cpu.8gib",
    "reserved.arm.8cpu.16gib",
    "reserved.arm.16cpu.32gib",
    "reserved.arm.32cpu.64gib",
    "r1-standard-2",
    "r1-standard-4",
    "r1-standard-8",
  ]
}

fn offer_aarch64_labels_are_page_cited(offer: SellerArmLinuxOffer) -> Bool {
  count(aarch64_rows_missing_cited_label(
    availability: offer.shapes,
    cited_labels: page_cited_arm_labels(),
  )) == 0
}

test fn surveyed_arm_linux_offers_are_seventeen() -> Bool {
  count(surveyed_arm_linux_offers()) == 17
}

test fn every_surveyed_offer_declares_scope() -> Bool {
  all(surveyed_arm_linux_offers(), o => offer_scope_nonempty(offer: o))
}

test fn every_surveyed_aarch64_shape_carries_a_cited_label() -> Bool {
  all(surveyed_arm_linux_offers(), o => offer_aarch64_labels_are_page_cited(offer: o))
}

test fn blacksmith_snapshot_declares_scope() -> Bool {
  string_length(s: blacksmith_catalog_snapshot.declared_scope) > 0
    && offer_scope_nonempty(offer: blacksmith_arm_linux_offer)
}

