module test.claim.repository_ci_profile_emission_bytes_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.optional { Optional, Present, Absent }
import gunbc.generated_artifact { GeneratedArtifact, WitnessFloorYamlArtifact, HealWorkflowYamlArtifact, HealPublisherWorkflowYamlArtifact, DriftWatchWorkflowYamlArtifact }
import gunbc.generated_workflow_provenance { generated_workflow_provenance_header, GeneratedWorkflowProvenanceHeader, GeneratedWorkflowProvenanceHeaderProduced, GeneratedWorkflowProvenanceHeaderNotApplicable }
import gunbc.witness.compiler_gate_workflow { expected_compiler_gate_yml }
import gunbc.witness.witness_floor_workflow { WitnessFloorGenerationOutcome, WitnessFloorGenerated, WitnessFloorGenerationRefused }
import gunbc.heal_workflow { expected_heal_workflow_yml, HealWorkflowGenerationOutcome, HealWorkflowGenerated, HealWorkflowGenerationRefused }
import gunbc.heal_publisher_workflow { expected_heal_publisher_workflow_yml, HealPublisherWorkflowGenerationOutcome, HealPublisherWorkflowGenerated, HealPublisherWorkflowGenerationRefused }
import gunbc.drift_watch_workflow { expected_drift_watch_workflow_yml, DriftWatchWorkflowGenerationOutcome, DriftWatchWorkflowGenerated, DriftWatchWorkflowGenerationRefused }

// THE BYTE BOUNDARY IS THE EVIDENCE THAT THE PROFILE ROW IS READ, NOT PARALLEL TO IT.
//
// gunbc's four committed workflows are emitted from gunbc.ci.repository_ci_profile: the required gate,
// the heal job, the publisher and the drift watch take their job id, runner, timeout and cadence from the
// repository's profile row rather than from literals beside their step lists. Two copies of those facts -
// a row that says 90 and an emitter that says 90 - would be the failure this whole change exists to
// remove, and no witness comparing two representations closes it: it only keeps the two wrong together.
// So this claim does not compare the row to the emitter. It compares the EMITTED BYTES to the committed
// bytes, at the boundary where a reviewer actually looks. If the row and the emitter disagree about
// anything a workflow carries, one of these claims goes red, and the disagreement is a file that would
// have been committed.
//
// The paths are the committed ones because a workflow is read by GitHub at that path and nowhere else;
// comparing an emission against another emission would prove only that the emitter is self-consistent.

data gate_yml_path: String = ".github/workflows/witnesses.yml"

data heal_yml_path: String = ".github/workflows/heal.yml"

data heal_publish_yml_path: String = ".github/workflows/heal-publish.yml"

data drift_watch_yml_path: String = ".github/workflows/drift-watch.yml"

fn committed_text(path: String) -> String {
  Filesystem.Read(path: path, expect: ExpectSuccess).content
}

// THE REQUIRED GATE, byte for byte. Its job id is the required context name branch protection names, and
// its runner and timeout are profile rows; a profile edit that moved either would land here as a
// difference rather than as a check that quietly stopped matching the setting it claims to describe.
test fn the_committed_required_gate_is_the_emission_of_the_profile_row() -> Bool {
  emitted_workflow_bytes(
    artifact: WitnessFloorYamlArtifact,
    text: outcome_text_of_gate(outcome: expected_compiler_gate_yml())
  ) == committed_text(path: gate_yml_path)
}

// THE HEAL JOB: job id, runner class and timeout come from the profile's heal row. A repository that
// commits no generated mirror deletes that row and this file with it; a repository that keeps committing
// mirrors keeps the file, and the bytes are the proof the row is what produced them.
test fn the_committed_heal_workflow_is_the_emission_of_the_profile_row() -> Bool {
  emitted_workflow_bytes(
    artifact: HealWorkflowYamlArtifact,
    text: outcome_text_of_heal(outcome: expected_heal_workflow_yml())
  ) == committed_text(path: heal_yml_path)
}

// THE PUBLISHER, including the timeout that belongs to a hosted runner class rather than to the fleet,
// and the workflow_run trigger naming the job that seals its candidate.
test fn the_committed_publisher_is_the_emission_of_the_profile_row() -> Bool {
  emitted_workflow_bytes(
    artifact: HealPublisherWorkflowYamlArtifact,
    text: outcome_text_of_publisher(outcome: expected_heal_publisher_workflow_yml())
  ) == committed_text(path: heal_publish_yml_path)
}

// THE DRIFT WATCH, whose cadence is a CronSchedule row. A cadence that lived in the emitter while the
// profile also declared one would be the duplicate this claim exists to catch: the committed file carries
// one cron, and only one of the two representations can produce it.
test fn the_committed_drift_watch_is_the_emission_of_the_profile_row() -> Bool {
  emitted_workflow_bytes(
    artifact: DriftWatchWorkflowYamlArtifact,
    text: outcome_text_of_drift(outcome: expected_drift_watch_workflow_yml())
  ) == committed_text(path: drift_watch_yml_path)
}

// A REFUSAL IS NOT AN EMPTY FILE. Every arm below fails the comparison rather than emitting something,
// and the claim texts are the reason a reader of a red run needs: "the emitter refused" and "the committed
// bytes differ" are different incidents with different fixes.
fn outcome_text_of_gate(outcome: WitnessFloorGenerationOutcome) -> String {
  match outcome {
    WitnessFloorGenerated { content } => content
    WitnessFloorGenerationRefused { reason } => refusal_marker(reason: reason)
  }
}

fn outcome_text_of_heal(outcome: HealWorkflowGenerationOutcome) -> String {
  match outcome {
    HealWorkflowGenerated { content } => content
    HealWorkflowGenerationRefused { reason } => refusal_marker(reason: reason)
  }
}

fn outcome_text_of_publisher(outcome: HealPublisherWorkflowGenerationOutcome) -> String {
  match outcome {
    HealPublisherWorkflowGenerated { content } => content
    HealPublisherWorkflowGenerationRefused { reason } => refusal_marker(reason: reason)
  }
}

fn outcome_text_of_drift(outcome: DriftWatchWorkflowGenerationOutcome) -> String {
  match outcome {
    DriftWatchWorkflowGenerated { content } => content
    DriftWatchWorkflowGenerationRefused { reason } => refusal_marker(reason: reason)
  }
}

fn refusal_marker(reason: String) -> String {
  join(["REFUSAL: ", reason], "")
}

// THE COMMITTED SHAPE OF A GENERATED WORKFLOW IS ITS PROVENANCE HEADER PLUS ITS EMISSION, and that is the
// pair compared. Checking the body alone would let the authority line drift - which is the line that tells
// a reviewer where to regenerate from, and the line that was wrong for two of these files before the
// mirror's fork was traced.
fn emitted_workflow_bytes(artifact: GeneratedArtifact, text: String) -> String {
  join([provenance_header_of(artifact: artifact), text], "")
}

fn provenance_header_of(artifact: GeneratedArtifact) -> String {
  match generated_workflow_provenance_header(a: artifact) {
    GeneratedWorkflowProvenanceHeaderProduced { content } => content
    GeneratedWorkflowProvenanceHeaderNotApplicable => ""
  }
}
