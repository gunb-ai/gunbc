module test.claim.training_resolution_witness

import product.training.resolution {
  AxisResolution, AxisResolved, AxisUnresolved, ResolvedAxis,
  TrainingResolution, TrainingResolved, TrainingResolutionRefused,
  TrainingResolutionObservations, TrainingResolvedManifest,
  TrainingNumericFormat, Bf16, Fp16, Fp32,
  PackingPolicy, NoPacking, ConcatenatedPacking,
  LossMaskPolicy, MaskPromptTokens, AllTokens,
  DropoutPermille, DropoutPermilleAdmission, DropoutPermilleAdmitted, DropoutPermilleOutOfRange,
  dropout_permille, dropout_permille_value,
  SeedAxis, BaseArtifactAxis,
  TrainingRunDesiredAdmitted, TrainingRunDesiredRefused,
  resolve_training, training_work_for, admit_training_run_desired,
  effective_global_batch, resolved_training_manifest,
}
import product.fabric.work { ExecutionRequirements, Shape, HardRequirements }
import product.fabric.isolation { shared_kernel_sandbox_profile }
import product.fabric.envelope { ResourceEnvelope }
import product.fabric.demand { Demand, AdmissionTerms, BuyTerms, SatisfactionRequirement }
import product.fabric.identity { FabricIdentity }
import std.content_hash { ContentHash, content_hash_of_value }
import extdeps.currency.currency { Usd }
import std.integer { PositiveInt }
import std.measure { money_amount_micro, hardware_thread_count }
import std.nat { Nat }
import std.types { NonEmptyStr, Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE HEADLINE PROPERTY IS THAT EVERY SEMANTIC COORDINATE REACHES THE WORK KEY, and it is not
// provable by reading the projection: the failure mode is a coordinate present in the manifest and
// absent from the identity material, which compiles and looks complete. So each control below
// varies exactly ONE coordinate and requires the key to move, and the negative controls vary things
// that must NOT move it. A suite checking only the positive direction would pass equally against a
// projection that hashed the whole manifest and against one that hashed a constant.

fn h(s: NonEmptyStr) -> ContentHash {
  content_hash_of_value(value: s)
}

fn axis_with_receipt<T>(v: T, r: NonEmptyStr) -> AxisResolution<T> {
  AxisResolved { resolved: ResolvedAxis { value: v, receipt: r } }
}

// The bound is real, so the fixture cannot assume it away: dp returns an Optional and every witness
// that needs a dropout value matches it. A helper that fabricated a fallback on refusal would be
// the witness quietly manufacturing the very value the mint exists to refuse.
fn dp(n: Nat) -> DropoutPermille? {
  match dropout_permille(permille: n) {
    DropoutPermilleAdmitted { value: v } => Present { value: v }
    DropoutPermilleOutOfRange { offered: _ } => none
  }
}

data fixture_requirements: ExecutionRequirements = ExecutionRequirements {
  shape: Shape {
    hard: HardRequirements { threads: hardware_thread_count(count: 8) },
    envelope: ResourceEnvelope { cpu: none, gpu: none, memory: none, storage: none, network: none },
  },
  capabilities: "linux-arm64",
  trust_domain: "fleet-owned",
  isolation: shared_kernel_sandbox_profile(),
}

fn resolve(o: TrainingResolutionObservations) -> TrainingResolution {
  resolve_training(observations: o, requirements: fixture_requirements)
}

fn work_key_of(o: TrainingResolutionObservations) -> NonEmptyStr {
  match resolve(o: o) {
    TrainingResolutionRefused { axis: _, cause: _ } => "refused"
    TrainingResolved { resolved: r } =>
      training_work_for(principal: "gunbai" as NonEmptyStr, resolved: r).id.key as NonEmptyStr
  }
}

fn obs(
  base_artifact: ContentHash,
  dataset_manifest: ContentHash,
  tokenizer: ContentHash,
  chat_template: ContentHash,
  trainer_closure: ContentHash,
  target_modules: ContentHash,
  optimizer_config: ContentHash,
  scheduler_config: ContentHash,
  learning_rate_schedule: ContentHash,
  rank: PositiveInt,
  scaling: PositiveInt,
  dropout_permille: DropoutPermille,
  sequence_length: PositiveInt,
  packing: PackingPolicy,
  loss_mask: LossMaskPolicy,
  mixture: ContentHash,
  micro_batch: PositiveInt,
  gradient_accumulation: PositiveInt,
  numeric_format: TrainingNumericFormat,
  seed: Nat,
  data_order_seed: Nat,
  checkpoint_format: ContentHash,
  output_contract: ContentHash,
  receipt: NonEmptyStr,
) -> TrainingResolutionObservations {
  TrainingResolutionObservations {
    base_artifact: axis_with_receipt(v: base_artifact, r: receipt),
    dataset_manifest: axis_with_receipt(v: dataset_manifest, r: receipt),
    tokenizer: axis_with_receipt(v: tokenizer, r: receipt),
    chat_template: axis_with_receipt(v: chat_template, r: receipt),
    trainer_closure: axis_with_receipt(v: trainer_closure, r: receipt),
    target_modules: axis_with_receipt(v: target_modules, r: receipt),
    optimizer_config: axis_with_receipt(v: optimizer_config, r: receipt),
    scheduler_config: axis_with_receipt(v: scheduler_config, r: receipt),
    learning_rate_schedule: axis_with_receipt(v: learning_rate_schedule, r: receipt),
    rank: axis_with_receipt(v: rank, r: receipt),
    scaling: axis_with_receipt(v: scaling, r: receipt),
    dropout_permille: axis_with_receipt(v: dropout_permille, r: receipt),
    sequence_length: axis_with_receipt(v: sequence_length, r: receipt),
    packing: axis_with_receipt(v: packing, r: receipt),
    loss_mask: axis_with_receipt(v: loss_mask, r: receipt),
    mixture: axis_with_receipt(v: mixture, r: receipt),
    micro_batch: axis_with_receipt(v: micro_batch, r: receipt),
    gradient_accumulation: axis_with_receipt(v: gradient_accumulation, r: receipt),
    numeric_format: axis_with_receipt(v: numeric_format, r: receipt),
    seed: axis_with_receipt(v: seed, r: receipt),
    data_order_seed: axis_with_receipt(v: data_order_seed, r: receipt),
    checkpoint_format: axis_with_receipt(v: checkpoint_format, r: receipt),
    output_contract: axis_with_receipt(v: output_contract, r: receipt),
  }
}

fn baseline_obs(d_low: DropoutPermille) -> TrainingResolutionObservations {
  obs(
    base_artifact: h(s: "base-A"),
    dataset_manifest: h(s: "dataset-1"),
    tokenizer: h(s: "tok-1"),
    chat_template: h(s: "tmpl-1"),
    trainer_closure: h(s: "trainer-1"),
    target_modules: h(s: "qkv"),
    optimizer_config: h(s: "adamw-1"),
    scheduler_config: h(s: "cosine-1"),
    learning_rate_schedule: h(s: "lr-1"),
    rank: 16,
    scaling: 32,
    dropout_permille: d_low,
    sequence_length: 4096,
    packing: NoPacking,
    loss_mask: MaskPromptTokens,
    mixture: h(s: "mix-1"),
    micro_batch: 2,
    gradient_accumulation: 8,
    numeric_format: Bf16,
    seed: 7,
    data_order_seed: 99,
    checkpoint_format: h(s: "ckpt-v1"),
    output_contract: h(s: "adapter-out"),
    receipt: "obs-1",
  )
}

// ONE CONTROL PER COORDINATE. A mutation against a single representative field cannot establish
// a hand-enumerated projection over twenty-three of them: the failure mode is a coordinate that
// is present in the manifest and absent from the material, which compiles and looks complete,
// and it is per-field. An earlier revision of this suite varied only the seed and the base
// artifact while the PR claimed the wall covered every semantic coordinate -- the claim was
// stronger than its evidence, which is the inflation this repository rates as worse than sitting
// low, because an overclaimed wall never ranks for the work that would make it real.
