// THE NEGATIVE CONTROL, and it is what makes the positive population mean something. A receipt is
// provenance: it records WHERE a value came from, not WHAT it is. If changing it moved the key the
// projection would be hashing evidence rather than the resolved computation, and two identical runs
// resolved through different observations would be incomparable.
test fn a_different_resolution_receipt_derives_the_same_work_key() -> Bool {
  match dp(n: 50) {
    none => false
    Present { value: d } =>
      work_key_of(o: baseline_obs(d_low: d))
        == work_key_of(o: obs(
             base_artifact: h(s: "base-A"), dataset_manifest: h(s: "dataset-1"),
             tokenizer: h(s: "tok-1"), chat_template: h(s: "tmpl-1"),
             trainer_closure: h(s: "trainer-1"), target_modules: h(s: "qkv"),
             optimizer_config: h(s: "adamw-1"), scheduler_config: h(s: "cosine-1"),
             learning_rate_schedule: h(s: "lr-1"), rank: 16, scaling: 32,
             dropout_permille: d, sequence_length: 4096, packing: NoPacking,
             loss_mask: MaskPromptTokens, mixture: h(s: "mix-1"), micro_batch: 2,
             gradient_accumulation: 8, numeric_format: Bf16, seed: 7, data_order_seed: 99,
             checkpoint_format: h(s: "ckpt-v1"), output_contract: h(s: "adapter-out"),
             receipt: "obs-2",
           ))
  }
}

// THE BOUND IS A WALL, NOT A CONVENTION. A permille above one thousand is not a probability, and
// Nat admits it; the mint refuses it. Both boundary admissions are asserted beside the refusal so
// the wall cannot be satisfied by refusing everything.
test fn dropout_admits_zero_and_one_thousand_and_refuses_above() -> Bool {
  let zero_ok = match dropout_permille(permille: 0) {
    DropoutPermilleAdmitted { value: v } => dropout_permille_value(d: v) == 0
    DropoutPermilleOutOfRange { offered: _ } => false
  }
  let thousand_ok = match dropout_permille(permille: 1000) {
    DropoutPermilleAdmitted { value: v } => dropout_permille_value(d: v) == 1000
    DropoutPermilleOutOfRange { offered: _ } => false
  }
  let above_refused = match dropout_permille(permille: 1001) {
    DropoutPermilleAdmitted { value: _ } => false
    DropoutPermilleOutOfRange { offered: o } => o == 1001
  }
  zero_ok && thousand_ok && above_refused
}

// GLOBAL BATCH IS DERIVED, so it cannot disagree with the coordinates it descends from.
test fn global_batch_is_the_product_of_micro_batch_and_accumulation() -> Bool {
  match dp(n: 50) {
    none => false
    Present { value: d } =>
      match resolve(o: baseline_obs(d_low: d)) {
        TrainingResolutionRefused { axis: _, cause: _ } => false
        TrainingResolved { resolved: r } =>
          effective_global_batch(m: resolved_training_manifest(resolved: r)) == 16
      }
  }
}

test fn an_unresolved_coordinate_refuses_naming_its_axis() -> Bool {
  match dp(n: 50) {
    none => false
    Present { value: d } => {
      let base = baseline_obs(d_low: d)
      let broken = TrainingResolutionObservations {
        base_artifact: base.base_artifact,
        dataset_manifest: base.dataset_manifest,
        tokenizer: base.tokenizer,
        chat_template: base.chat_template,
        trainer_closure: base.trainer_closure,
        target_modules: base.target_modules,
        optimizer_config: base.optimizer_config,
        scheduler_config: base.scheduler_config,
        learning_rate_schedule: base.learning_rate_schedule,
        rank: base.rank,
        scaling: base.scaling,
        dropout_permille: base.dropout_permille,
        sequence_length: base.sequence_length,
        packing: base.packing,
        loss_mask: base.loss_mask,
        mixture: base.mixture,
        micro_batch: base.micro_batch,
        gradient_accumulation: base.gradient_accumulation,
        numeric_format: base.numeric_format,
        seed: AxisUnresolved { cause: "operator did not pin a seed" },
        data_order_seed: base.data_order_seed,
        checkpoint_format: base.checkpoint_format,
        output_contract: base.output_contract,
      }
      match resolve(o: broken) {
        TrainingResolutionRefused { axis: SeedAxis, cause: _ } => true
        _ => false
      }
    }
  }
}

// THE CROSS-PRINCIPAL PAIR. Requester and accounting scope are different roles sharing a
// representation, and an earlier revision derived the work under the REQUESTER, which refused every
// legitimate delegated run. The positive arm is load-bearing: a suite with only same-principal
// fixtures would pass against that collapse.
fn demand_for(requester: NonEmptyStr, scope: NonEmptyStr, work_key: NonEmptyStr) -> Demand<NonEmptyStr> {
  Demand {
    id: FabricIdentity { principal: requester, key: "demand-1" },
    work: FabricIdentity { principal: scope, key: work_key },
    origin: "gunbc.observation.training-1",
    submitted_at: "2026-08-28T00:00:00Z",
    admission: AdmissionTerms {
      deadline: none,
      buy: BuyTerms {
        budget_account: "training",
        currency: Usd,
        reservation_price: money_amount_micro(count: 1),
        maximum_buy_order: money_amount_micro(count: 1000),
      },
    },
    satisfaction: SatisfactionRequirement {
      terminal_receipt_may_satisfy: true,
      new_attempt_required: false,
      step_reuse_permitted: true,
    },
  }
}

test fn a_requester_may_ask_for_work_scoped_to_another_principal() -> Bool {
  match dp(n: 50) {
    none => false
    Present { value: d } =>
      match resolve(o: baseline_obs(d_low: d)) {
        TrainingResolutionRefused { axis: _, cause: _ } => false
        TrainingResolved { resolved: r } => {
          let scoped_key = training_work_for(principal: "gunbai" as NonEmptyStr, resolved: r).id.key
          let dm = demand_for(requester: "brian", scope: "gunbai", work_key: scoped_key as NonEmptyStr)
          match admit_training_run_desired(demand: dm, resolved: r) {
            TrainingRunDesiredAdmitted { desired: _ } => true
            TrainingRunDesiredRefused { demand_work: _, resolved_work: _ } => false
          }
        }
      }
  }
}

test fn a_demand_naming_a_work_this_resolution_does_not_derive_is_refused() -> Bool {
  match dp(n: 50) {
    none => false
    Present { value: d } =>
      match resolve(o: baseline_obs(d_low: d)) {
        TrainingResolutionRefused { axis: _, cause: _ } => false
        TrainingResolved { resolved: r } => {
          let dm = demand_for(requester: "brian", scope: "gunbai", work_key: "some-other-work")
          match admit_training_run_desired(demand: dm, resolved: r) {
            TrainingRunDesiredAdmitted { desired: _ } => false
            TrainingRunDesiredRefused { demand_work: _, resolved_work: _ } => true
          }
        }
      }
  }
}
