module test.claim.approval_request_client_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String, List }
import gunbc.auth.approval_request_client {
  approval_submit_url, approval_status_url, approval_loopback_origin, approval_loopback_origin_for, approval_loopback_origin_of, approval_request_submit_path,
  ApprovalLoopbackOrigin, ApprovalLoopbackOriginResolved, ApprovalLoopbackOriginRefused,
  approval_origin_admission, ApprovalOriginAdmission, ApprovalOriginDialable, ApprovalOriginUnresolved, ApprovalExecutorNotTheOriginHost, ApprovalExecutorHostUnobserved,
  approval_poll_standing, PollStillPending, PollApproved, PollExpired, PollUnreadable,
  StoredApprovalRequest,
}
import gunbc.auth.approval_status_wire {
  parse_filed_approval_status, filed_approval_status_text, submission_filed_text, submission_body_admits_poll,
  StatusNotFiled, StatusPending, StatusApproved, StatusDenied, StatusUnreadable,
}
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance, srv2_deploy_dashboard_instance, ProdRoleRealization, ProdRoleUnheld }
import gunbc.deployment_risk { ProdRoleHeldBy, NoProdRole, srv2_deploy_deployment }
import gunbc.hostname_read { HostnameShortCapture, HostnameShortCaptured, HostnameShortCaptureRefused }
import gunbc.live_deploy.desired { prod_role_actuated_realization, prod_role_actuated_realization_in }
import gunbc.auth.approval_writer_authority { approval_writer_authority, approval_writer_process, ApprovalServingProcess, RoadmapProcess, BrokerProcess }
import gunbc.auth.approval_broker_endpoint { approval_broker_loopback_base_url, approval_broker_listen_port }
import gunbc.auth.approval_request_submission { submission_envelope_json }
import gunbc.auth.approval_decision_store { approval_mac_key_id }
import std.scoped_authorization { AttemptIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_stored() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-1",
    request_revision: "rev-1",
    attempt: "attempt-1" as AttemptIdentity,
    requester: "briansrls@gmail.com",
    purpose: "boot",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-16T21:00:00Z",
    key_id: approval_mac_key_id,
  }
}

fn on_host(h: String) -> HostnameShortCapture {
  HostnameShortCaptured { value: h }
}

fn srv2_holds() -> ProdRoleRealization {
  prod_role_actuated_realization_in(selection: ProdRoleHeldBy { deployment: srv2_deploy_deployment })
}

fn no_prod_role() -> ProdRoleRealization {
  prod_role_actuated_realization_in(selection: NoProdRole)
}

fn resolved_host_and_origin(o: ApprovalLoopbackOrigin) -> List<String> {
  match o {
    ApprovalLoopbackOriginResolved { host, origin } => [host as String, origin as String]
    ApprovalLoopbackOriginRefused { cause: _ } => []
  }
}

fn dialable_url(a: ApprovalOriginAdmission) -> String {
  match a {
    ApprovalOriginDialable { dial } => approval_submit_url(dial: dial) as String
    ApprovalOriginUnresolved { cause: _ } => ""
    ApprovalExecutorNotTheOriginHost { origin_host: _, executor_host: _ } => ""
    ApprovalExecutorHostUnobserved { reason: _ } => ""
  }
}

// (5) POSITIVE CONTROL: today's selection, the broker as writer, an executor on srv1 -- dialable, at
// the broker's loopback, and the URLs are that origin's.
test fn todays_broker_writer_on_the_srv1_holder_is_dialable_from_srv1() -> Bool {
  let broker_origin = approval_broker_loopback_base_url(port: approval_broker_listen_port) as String
  match approval_origin_admission(origin: approval_loopback_origin_for(writer: BrokerProcess, realization: prod_role_actuated_realization()), executor: on_host(h: "srv1")) {
    ApprovalOriginDialable { dial } =>
      (dial.host as String) == "srv1"
        && approval_submit_url(dial: dial) as String == concat(broker_origin, approval_request_submit_path as String)
        && approval_status_url(dial: dial, escalation_id: "esc-1") as String == concat(concat(broker_origin, concat(approval_request_submit_path as String, "/")), "esc-1")
    _ => false
  }
}

// (1) The role on srv2-deploy, the broker as writer, an executor on srv2: resolves and may dial.
test fn a_broker_writer_on_a_srv2_holder_is_dialable_from_srv2() -> Bool {
  match approval_origin_admission(origin: approval_loopback_origin_for(writer: BrokerProcess, realization: srv2_holds()), executor: on_host(h: "srv2")) {
    ApprovalOriginDialable { dial } => (dial.host as String) == "srv2"
    _ => false
  }
}

// (2) The role on srv2-deploy, the broker as writer, an executor on srv1: refuses before any request,
// naming both hosts -- it does not dial srv1's loopback, where a stale broker may still answer.
test fn a_broker_writer_on_a_srv2_holder_refuses_a_srv1_executor_before_any_request() -> Bool {
  match approval_origin_admission(origin: approval_loopback_origin_for(writer: BrokerProcess, realization: srv2_holds()), executor: on_host(h: "srv1")) {
    ApprovalExecutorNotTheOriginHost { origin_host, executor_host } => (origin_host as String) == "srv2" && executor_host == "srv1"
    _ => false
  }
}

// (3) Switching the writer to the roadmap changes the endpoint and keeps the holder's host.
test fn the_roadmap_writer_changes_the_endpoint_and_keeps_the_holders_host() -> Bool {
  let r = srv2_holds()
  let broker = resolved_host_and_origin(o: approval_loopback_origin_for(writer: BrokerProcess, realization: r))
  let roadmap = resolved_host_and_origin(o: approval_loopback_origin_for(writer: RoadmapProcess, realization: r))
  count(broker) == 2 && count(roadmap) == 2
    && broker == ["srv2", approval_broker_loopback_base_url(port: approval_broker_listen_port) as String]
    && roadmap == ["srv2", approval_loopback_origin_of(instance: srv2_deploy_dashboard_instance()) as String]
    && dialable_url(a: approval_origin_admission(origin: approval_loopback_origin_for(writer: RoadmapProcess, realization: r), executor: on_host(h: "srv2"))) != dialable_url(a: approval_origin_admission(origin: approval_loopback_origin_for(writer: BrokerProcess, realization: r), executor: on_host(h: "srv2")))
}

// (4) NoProdRole refuses on both writer arms, whatever the executor is.
test fn no_prod_role_refuses_on_both_writer_arms() -> Bool {
  let unresolved = fn(w: ApprovalServingProcess) -> Bool {
    match approval_origin_admission(origin: approval_loopback_origin_for(writer: w, realization: no_prod_role()), executor: on_host(h: "srv1")) {
      ApprovalOriginUnresolved { cause: ProdRoleUnheld } => true
      _ => false
    }
  }
  unresolved(RoadmapProcess) && unresolved(BrokerProcess)
}

// An executor that cannot read its own hostname does not dial either.
test fn an_executor_whose_host_is_unobserved_refuses() -> Bool {
  match approval_origin_admission(origin: approval_loopback_origin_for(writer: BrokerProcess, realization: prod_role_actuated_realization()), executor: HostnameShortCaptureRefused { reason: "hostname -s exited unsuccessfully" }) {
    ApprovalExecutorHostUnobserved { reason: _ } => true
    _ => false
  }
}

// THE REGRESSION run 37265259209 hit: the live origin is the declared writer's, the broker's loopback
// when the broker writes, never the roadmap's port.
test fn the_live_origin_is_the_declared_writers() -> Bool {
  let r = prod_role_actuated_realization()
  resolved_host_and_origin(o: approval_loopback_origin()) == resolved_host_and_origin(o: approval_loopback_origin_for(writer: approval_writer_process(authority: approval_writer_authority), realization: r))
    && resolved_host_and_origin(o: approval_loopback_origin_for(writer: BrokerProcess, realization: r)) != resolved_host_and_origin(o: approval_loopback_origin_for(writer: RoadmapProcess, realization: r))
}

test fn submit_body_nests_the_stored_request_as_a_json_string() -> Bool {
  let body = submission_envelope_json(request: fixture_stored(), tag_hex: "ab")
  string_contains(s: body, pattern: "\"tag\"")
    && string_contains(s: body, pattern: "\"request\"")
    && string_contains(s: body, pattern: "\\\"kind\\\"")
    && !string_contains(s: body, pattern: "\"kind\":\"request\"")
}

test fn status_words_are_closed() -> Bool {
  match parse_filed_approval_status(body: "standing=pending\nexpires_at=2026-09-16T21:00:00Z\n") {
    StatusPending { expires_at: e } => e == "2026-09-16T21:00:00Z"
    _ => false
  }
    && match parse_filed_approval_status(body: "standing=not-filed\n") { StatusNotFiled => true  _ => false }
    && match parse_filed_approval_status(body: "standing=approved\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nexecute_by=2026-09-16T21:00:00Z\n") {
      StatusApproved { revision: r, decided_by: by, decided_at: _, execute_by: _ } => r as String == "r1" && by as String == "op"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=denied\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nreason=no\n") {
      StatusDenied { revision: _, decided_by: _, decided_at: _, reason: why } => why as String == "no"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=unreadable\ndetail=corrupt\n") {
      StatusUnreadable { detail: d } => d as String == "corrupt"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=maybe\n") { StatusUnreadable { detail: _ } => true  _ => false }
    && match parse_filed_approval_status(body: "standing=approved\n") { StatusUnreadable { detail: _ } => true  _ => false }
}

test fn injected_kv_lines_in_expires_at_are_unreadable_not_approved() -> Bool {
  match parse_filed_approval_status(body: "standing=pending\nexpires_at=2026-09-16T21:00:00Z\nstanding=approved\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nexecute_by=2026-09-16T21:00:00Z\n") {
    StatusUnreadable { detail: _ } => true
    _ => false
  }
}

test fn poll_expires_after_expires_at_unless_already_decided() -> Bool {
  match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T22:00:00Z", expires_at: "2026-09-16T21:00:00Z") {
    PollExpired => true
    _ => false
  }
    && match approval_poll_standing(
      status: StatusApproved {
        revision: "r1" as NonEmptyStr,
        decided_by: "x" as NonEmptyStr,
        decided_at: "2026-09-16T20:30:00Z",
        execute_by: "2026-09-16T21:00:00Z",
      },
      observed_at: "2026-09-16T22:00:00Z",
      expires_at: "2026-09-16T21:00:00Z",
    ) {
      PollApproved { revision: _, decided_by: _, decided_at: _, execute_by: _ } => true
      _ => false
    }
    && match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T20:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollStillPending => true
      _ => false
    }
    && match approval_poll_standing(
      status: StatusUnreadable { detail: "get failed" as NonEmptyStr },
      observed_at: "2026-09-16T22:00:00Z",
      expires_at: "2026-09-16T21:00:00Z",
    ) {
      PollUnreadable { detail: _ } => true
      _ => false
    }
}

// THE FILED WINDOW GOVERNS A PENDING REQUEST, NOT THE CALLER'S: a rerun that computed a fresh,
// later window cannot keep a filing pending past the expires_at the broker filed; and a filing
// still inside its own window stays pending even when the caller's window has passed. The caller's
// window governs only a request that is not filed.
test fn a_pending_filing_expires_by_its_filed_window_not_the_callers() -> Bool {
  match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T21:30:00Z", expires_at: "2026-09-16T23:00:00Z") {
    PollExpired => true
    _ => false
  }
    && match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T23:00:00Z" }, observed_at: "2026-09-16T21:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollStillPending => true
      _ => false
    }
    && match approval_poll_standing(status: StatusNotFiled, observed_at: "2026-09-16T21:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollExpired => true
      _ => false
    }
    && match approval_poll_standing(status: StatusNotFiled, observed_at: "2026-09-16T20:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollNotFiled => true
      _ => false
    }
}

// THE BOUNDARY IS THE CAPABILITY'S: at the exact expires_at the request is expired (the broker
// can no longer redeem the capability), one second before it is still pending / still fileable.
test fn the_exact_expiry_instant_is_expired_and_one_second_before_is_live() -> Bool {
  match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T21:00:00Z", expires_at: "2026-09-16T23:00:00Z") {
    PollExpired => true
    _ => false
  }
    && match approval_poll_standing(status: StatusNotFiled, observed_at: "2026-09-16T21:00:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollExpired => true
      _ => false
    }
    && match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T20:59:59Z", expires_at: "2026-09-16T21:00:00Z") {
      PollStillPending => true
      _ => false
    }
    && match approval_poll_standing(status: StatusNotFiled, observed_at: "2026-09-16T20:59:59Z", expires_at: "2026-09-16T21:00:00Z") {
      PollNotFiled => true
      _ => false
    }
}



test fn post_filed_token_admits_poll_including_notify_failure() -> Bool {
  submission_body_admits_poll(body: submission_filed_text(filed: true, reason: "approval submission: filed esc-1 and notified (ntfy message m)"))
    && submission_body_admits_poll(body: submission_filed_text(filed: true, reason: "approval submission: escalation esc-1 is already filed"))
    && submission_body_admits_poll(body: submission_filed_text(filed: true, reason: "approval submission: filed esc-1 but the notification did not publish: refused 502 x"))
    && !submission_body_admits_poll(body: submission_filed_text(filed: false, reason: "approval submission: requester not enrolled: bad tag"))
    && !submission_body_admits_poll(body: "approval submission: filed esc-1 and notified (ntfy message m)")
}

test fn status_text_round_trips_through_the_same_grammar() -> Bool {
  match parse_filed_approval_status(body: filed_approval_status_text(status: StatusNotFiled)) {
    StatusNotFiled => true
    _ => false
  }
    && match parse_filed_approval_status(body: filed_approval_status_text(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" })) {
      StatusPending { expires_at: e } => e == "2026-09-16T21:00:00Z"
      _ => false
    }
}
