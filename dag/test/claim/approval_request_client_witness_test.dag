module test.claim.approval_request_client_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr }
import gunbc.auth.approval_request_client {
  approval_submit_url, approval_status_url, approval_submit_body_json,
  parse_filed_approval_status, StatusNotFiled, StatusPending, StatusApproved, StatusDenied, StatusUnreadable,
  approval_poll_standing, PollStillPending, PollApproved, PollDenied, PollExpired, PollNotFiled,
  StoredApprovalRequest,
}
import gunbc.auth.approval_decision_store { approval_mac_key_id }
import std.scoped_authorization { AttemptIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_stored() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-1",
    request_revision: "rev-1",
    attempt: "attempt-1" as AttemptIdentity,
    requester: "briansrls@gmail.com",
    purpose: "boot",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-16T21:00:00Z",
    key_id: approval_mac_key_id,
  }
}

test fn submit_and_status_urls_are_loopback() -> Bool {
  approval_submit_url() as String == "http://127.0.0.1:8080/approvals"
    && approval_status_url(escalation_id: "esc-1") as String == "http://127.0.0.1:8080/approvals/esc-1"
}

test fn submit_body_nests_the_stored_request_object() -> Bool {
  let body = approval_submit_body_json(tag_hex: "ab", request: fixture_stored())
  string_contains(s: body, pattern: "\"tag\"")
    && string_contains(s: body, pattern: "\"request\"")
    && string_contains(s: body, pattern: "\"kind\":\"request\"")
    && !string_contains(s: body, pattern: "\\\"kind\\\"")
}

test fn status_words_are_closed() -> Bool {
  match parse_filed_approval_status(body: "{\"state\":\"pending\"}") { StatusPending => true  _ => false }
    && match parse_filed_approval_status(body: "{\"state\":\"not-filed\"}") { StatusNotFiled => true  _ => false }
    && match parse_filed_approval_status(body: "{\"state\":\"approved\"}") { StatusApproved { decided_by: _, decided_at: _ } => true  _ => false }
    && match parse_filed_approval_status(body: "{\"state\":\"denied\"}") { StatusDenied { decided_by: _, decided_at: _ } => true  _ => false }
    && match parse_filed_approval_status(body: "{\"state\":\"maybe\"}") { StatusUnreadable { detail: _ } => true  _ => false }
}

test fn poll_expires_after_expires_at_unless_already_decided() -> Bool {
  match approval_poll_standing(status: StatusPending, observed_at: "2026-09-16T22:00:00Z", expires_at: "2026-09-16T21:00:00Z") {
    PollExpired => true
    _ => false
  }
    && match approval_poll_standing(status: StatusApproved { decided_by: "x" as NonEmptyStr, decided_at: "2026-09-16T20:30:00Z" }, observed_at: "2026-09-16T22:00:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollApproved => true
      _ => false
    }
    && match approval_poll_standing(status: StatusPending, observed_at: "2026-09-16T20:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollStillPending => true
      _ => false
    }
}
