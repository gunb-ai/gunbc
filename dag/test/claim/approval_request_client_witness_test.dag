module test.claim.approval_request_client_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, NonEmptyStr, String }
import gunbc.auth.approval_request_client {
  approval_submit_url, approval_status_url, approval_loopback_origin, approval_request_submit_path,
  approval_poll_standing, approval_post_admits_poll, PollStillPending, PollApproved, PollExpired, PollUnreadable,
  StoredApprovalRequest,
}
import gunbc.auth.approval_status_wire {
  parse_filed_approval_status, filed_approval_status_text, submission_filed_text,
  StatusNotFiled, StatusPending, StatusApproved, StatusDenied, StatusUnreadable,
}
import gunbc.roadmap_dashboard_instance { srv1_live_dashboard_instance }
import gunbc.auth.approval_request_submission { submission_envelope_json }
import gunbc.auth.approval_decision_store { approval_mac_key_id }
import std.scoped_authorization { AttemptIdentity }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_stored() -> StoredApprovalRequest {
  StoredApprovalRequest {
    escalation_id: "esc-1",
    request_revision: "rev-1",
    attempt: "attempt-1" as AttemptIdentity,
    requester: "briansrls@gmail.com",
    purpose: "boot",
    destructive: true,
    issued_at: "2026-09-16T20:00:00Z",
    expires_at: "2026-09-16T21:00:00Z",
    key_id: approval_mac_key_id,
  }
}

test fn submit_and_status_urls_follow_the_srv1_instance_listen_bind() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let origin = approval_loopback_origin() as String
  origin == concat(concat("http://", instance.listen_host as String), concat(":", to_string(instance.listen_port)))
    && approval_submit_url() as String == concat(origin, approval_request_submit_path as String)
    && approval_status_url(escalation_id: "esc-1") as String == concat(concat(origin, concat(approval_request_submit_path as String, "/")), "esc-1")
}

test fn submit_body_nests_the_stored_request_as_a_json_string() -> Bool {
  let body = submission_envelope_json(request: fixture_stored(), tag_hex: "ab")
  string_contains(s: body, pattern: "\"tag\"")
    && string_contains(s: body, pattern: "\"request\"")
    && string_contains(s: body, pattern: "\\\"kind\\\"")
    && !string_contains(s: body, pattern: "\"kind\":\"request\"")
}

test fn status_words_are_closed() -> Bool {
  match parse_filed_approval_status(body: "standing=pending\nexpires_at=2026-09-16T21:00:00Z\n") {
    StatusPending { expires_at: e } => e == "2026-09-16T21:00:00Z"
    _ => false
  }
    && match parse_filed_approval_status(body: "standing=not-filed\n") { StatusNotFiled => true  _ => false }
    && match parse_filed_approval_status(body: "standing=approved\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nexecute_by=2026-09-16T21:00:00Z\n") {
      StatusApproved { revision: r, decided_by: by, decided_at: _, execute_by: _ } => r as String == "r1" && by as String == "op"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=denied\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nreason=no\n") {
      StatusDenied { revision: _, decided_by: _, decided_at: _, reason: why } => why as String == "no"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=unreadable\ndetail=corrupt\n") {
      StatusUnreadable { detail: d } => d as String == "corrupt"
      _ => false
    }
    && match parse_filed_approval_status(body: "standing=maybe\n") { StatusUnreadable { detail: _ } => true  _ => false }
    && match parse_filed_approval_status(body: "standing=approved\n") { StatusUnreadable { detail: _ } => true  _ => false }
}

test fn injected_kv_lines_in_expires_at_are_unreadable_not_approved() -> Bool {
  match parse_filed_approval_status(body: "standing=pending\nexpires_at=2026-09-16T21:00:00Z\nstanding=approved\nrevision=r1\ndecided_by=op\ndecided_at=2026-09-16T20:30:00Z\nexecute_by=2026-09-16T21:00:00Z\n") {
    StatusUnreadable { detail: _ } => true
    _ => false
  }
}

test fn poll_expires_after_expires_at_unless_already_decided() -> Bool {
  match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T22:00:00Z", expires_at: "2026-09-16T21:00:00Z") {
    PollExpired => true
    _ => false
  }
    && match approval_poll_standing(
      status: StatusApproved {
        revision: "r1" as NonEmptyStr,
        decided_by: "x" as NonEmptyStr,
        decided_at: "2026-09-16T20:30:00Z",
        execute_by: "2026-09-16T21:00:00Z",
      },
      observed_at: "2026-09-16T22:00:00Z",
      expires_at: "2026-09-16T21:00:00Z",
    ) {
      PollApproved { revision: _, decided_by: _, decided_at: _, execute_by: _ } => true
      _ => false
    }
    && match approval_poll_standing(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" }, observed_at: "2026-09-16T20:30:00Z", expires_at: "2026-09-16T21:00:00Z") {
      PollStillPending => true
      _ => false
    }
    && match approval_poll_standing(
      status: StatusUnreadable { detail: "get failed" as NonEmptyStr },
      observed_at: "2026-09-16T22:00:00Z",
      expires_at: "2026-09-16T21:00:00Z",
    ) {
      PollUnreadable { detail: _ } => true
      _ => false
    }
}

test fn post_filed_token_admits_poll_including_notify_failure() -> Bool {
  approval_post_admits_poll(success: true, body: submission_filed_text(filed: true, reason: "approval submission: filed esc-1 and notified (ntfy message m)"))
    && approval_post_admits_poll(success: false, body: submission_filed_text(filed: true, reason: "approval submission: escalation esc-1 is already filed"))
    && approval_post_admits_poll(success: false, body: submission_filed_text(filed: true, reason: "approval submission: filed esc-1 but the notification did not publish: refused 502 x"))
    && !approval_post_admits_poll(success: false, body: submission_filed_text(filed: false, reason: "approval submission: requester not enrolled: bad tag"))
    && !approval_post_admits_poll(success: true, body: "approval submission: filed esc-1 and notified (ntfy message m)")
}

test fn status_text_round_trips_through_the_same_grammar() -> Bool {
  match parse_filed_approval_status(body: filed_approval_status_text(status: StatusNotFiled)) {
    StatusNotFiled => true
    _ => false
  }
    && match parse_filed_approval_status(body: filed_approval_status_text(status: StatusPending { expires_at: "2026-09-16T21:00:00Z" })) {
      StatusPending { expires_at: e } => e == "2026-09-16T21:00:00Z"
      _ => false
    }
}
