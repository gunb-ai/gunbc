module test.claim.json_unescape_fast_path_probe

import std.render_repeat_string_bootstrap { repeat_string }
import extdeps.languages.json.parse { parse_json, json_string_value_or_empty }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data json_unescape_fast_path_probe_note: String = "Cost-shape probe for the json_unescape no-backslash fast path. Semantics are already covered by test.claim.json_parse_witness (21 rows); this entry exists so the fast path's effect is MEASURED rather than asserted. Executed A/B on one host, same binary and same probe, varying only the fast path (2026-08-15): escape-free 14400-char string 4818ms without it vs 2285ms with it (2.11x); escape-bearing control 110ms vs 116ms, unchanged. The control is the discriminating half - it must keep decoding on the slow path, so a fast path that swallowed escapes reds here rather than merely getting faster. THE RESIDUE, stated because the 2.11x invites the wrong conclusion: 2285ms remains after json_unescape is bypassed entirely, so roughly half this population's cost is the PARSER, not the unescaper - parse_json_value_at and parse_json_string_at recurse with s: String, and v1 Value::Str is an owned String cloned per call, so the same per-call copy defect sits one layer up and is untouched here. Dissolve-on: parse_json stops threading the whole source through per-call String parameters (cursor or shared-string substrate), at which point this probe and the fast path both retire."

data probe_unit: String = "abcdefghijklmnopqrstuvwxyz0123456789"

test fn a_large_escape_free_string_parses_to_itself() -> Bool {
  let body = repeat_string(s: probe_unit, n: 400)
  let text = concat("\"", concat(body, "\""))
  match parse_json(s: text) {
    Present { value: v } => json_string_value_or_empty(v: v) == body
    Absent => false
  }
}

test fn an_escape_bearing_string_still_decodes_on_the_slow_path() -> Bool {
  let body = repeat_string(s: probe_unit, n: 40)
  let text = concat("\"", concat(body, concat("\\u0041", "\"")))
  match parse_json(s: text) {
    Present { value: v } => json_string_value_or_empty(v: v) == concat(body, "A")
    Absent => false
  }
}
