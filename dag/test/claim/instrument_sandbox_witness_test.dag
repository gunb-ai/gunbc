module test.claim.instrument_sandbox_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { String, Bool, Int, List }
import gunbc.roadmap_serve {
  InstrumentSandboxPageHandler, roadmap_serve_invoke_for_instance,
}
import gunbc.roadmap_dashboard_instance { srv2_preview_dashboard_instance }
import gunbc.roadmap_instrument_sandbox {
  instrument_sandbox_page, instrument_css, instrument_css_at_role,
  instrument_emission_root_css_for, audition_card_class, audition_emission_var,
  audition_subject_key, audition_subject_role, live_program_view_result,
}
import gunbc.design.instrument_audition {
  AuditionIntensity, AuditionRestrained, AuditionExpressive, AuditionHero, audition_intensities,
  AuditionAdmission, AuditionAdmitted, AuditionEmissionRefused,
  AuditionAttractionOutsideEnvelope, AuditionDisplacementOverBudget, admit_audition,
}
import gunbc.design.instrument_physical { preference_default, instrument_displacement_px }
import gunbc.design.salience {
  SalienceRole, SalienceFocal, SalienceSupporting, SalienceGround, salience_key,
}
import gunbc.roadmap_program_view {
  V1ProgramViewResult, ProgramViewDerived, ProgramViewRefused, V1DeletionProgramView,
}
import extdeps.http.server { ServeHttpRequest, ServeHttpResponse, GET, media_type_wire_label }
import extdeps.cloud.gcp.gcp { GcpProjectId }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data instrument_sandbox_witness_note: String = "RESHAPED AROUND THE PRODUCTION JOINS, because the first set proved less than it claimed (review finding, 2026-08-05). Three of its claims were substring theatre: the role witness searched the page for the words focal / supporting / ground / critical, which any page mentioning salience contains whether or not a single role was derived; the theme-block helper checked that one variable existed somewhere and that three selectors existed somewhere, never that the variable appeared INSIDE each block; and the press witness equated one translateY rule with a realized CRT glitch. Worst of all, nothing tested the property that turned out to be broken — that a REFUSED audition cannot paint. The claims below hold the joins instead: the served role is the one the projection derived, emission is present exactly when the admission grants it and absent at every refusing role, the emission variable occurs inside all three theme blocks by position, and the page reads the live derived view rather than an authored list."

fn fixture_request(path: String) -> ServeHttpRequest {
  ServeHttpRequest { method: GET, path: path, body: "" }
}

fn served() -> ServeHttpResponse {
  roadmap_serve_invoke_for_instance(
    instance: srv2_preview_dashboard_instance(),
    handler: InstrumentSandboxPageHandler,
    params: [],
    request: fixture_request(path: "/sandbox/instrument"),
  )
}

fn last_segment(s: String, marker: String) -> String {
  fold(split(s: s, sep: marker), init: "", f: (acc, part) => part)
}

fn first_segment(s: String, marker: String) -> String {
  fold(split(s: s, sep: marker), init: "", f: (acc, part) => if acc == "" { part } else { acc })
}

fn emission_var_ref(i: AuditionIntensity) -> String {
  concat("--", concat(audition_emission_var(i: i), ":"))
}

fn emission_is_none_for(role: SalienceRole, i: AuditionIntensity) -> Bool {
  string_contains(
    s: instrument_emission_root_css_for(role: role),
    pattern: concat(emission_var_ref(i: i), " none"),
  )
}

fn admission_grants(role: SalienceRole, i: AuditionIntensity) -> Bool {
  match admit_audition(i: i, role: role, subject_key: audition_subject_key()) {
    AuditionAdmitted { intensity, emission, attraction, displacement_px } => true
    AuditionEmissionRefused { intensity, grant } => false
    AuditionAttractionOutsideEnvelope { intensity } => false
    AuditionDisplacementOverBudget { intensity, total_px, max_px } => false
  }
}

fn witness_the_instrument_path_serves_html() -> Bool {
  let r = served()
  r.status == 200
    && media_type_wire_label(m: r.content_type) == "text/html; charset=utf-8"
    && string_contains(s: r.body, pattern: "gunbc — instrument study")
    && string_contains(s: r.body, pattern: "lang=\"en\"")
    && string_contains(s: r.body, pattern: "width=device-width")
}

data study_not_instrument_note: String = "The page must not describe itself as the operable instrument, and the header must not carry controls it cannot operate. The dead-control claim is checked against the MARKUP, not the whole document: the register stylesheet is inlined in a style element and legitimately contains .theme-toggle and .sound-toggle rules, so searching the raw body for those words finds the CSS and reds on a page that has no such buttons. The first version of this claim did exactly that and was wrong for a reason worth keeping — a negative substring assertion over a document that embeds its own stylesheet is testing the stylesheet."

fn body_markup(r: ServeHttpResponse) -> String {
  last_segment(s: r.body, marker: "</style>")
}

fn witness_the_page_calls_itself_a_study_and_carries_no_dead_controls() -> Bool {
  let r = served()
  let markup = body_markup(r: r)
  string_contains(s: r.body, pattern: "instrument — static study")
    && !string_contains(s: markup, pattern: "theme-toggle")
    && !string_contains(s: markup, pattern: "sound-toggle")
}

data derived_role_witness_note: String = "The load-bearing claim: the role the audition is admitted at is the one the projection derived for the selected subject, not a literal."

fn witness_the_served_role_is_the_derived_one() -> Bool {
  salience_key(role: audition_subject_role()) == salience_key(role: SalienceFocal)
    && audition_subject_key() == "compiler-fixed-point"
}

fn witness_emission_is_present_exactly_when_the_admission_grants_it() -> Bool {
  let role = audition_subject_role()
  admission_grants(role: role, i: AuditionExpressive)
    && admission_grants(role: role, i: AuditionHero)
    && !emission_is_none_for(role: role, i: AuditionExpressive)
    && !emission_is_none_for(role: role, i: AuditionHero)
    && emission_is_none_for(role: role, i: AuditionRestrained)
}

data refused_cannot_paint_note: String = "THE CONTROL THE FIRST WITNESS SET DID NOT HAVE. Render the same study at a role the register refuses emission for; no emission may appear in the emitted CSS at all. This is the property that was actually broken — the glow painted while the verdict printed refused underneath it — so it is the one claim here whose failure would have caught the original defect."

fn witness_red_a_refused_audition_paints_nothing() -> Bool {
  !admission_grants(role: SalienceSupporting, i: AuditionHero)
    && !admission_grants(role: SalienceGround, i: AuditionHero)
    && emission_is_none_for(role: SalienceSupporting, i: AuditionRestrained)
    && emission_is_none_for(role: SalienceSupporting, i: AuditionExpressive)
    && emission_is_none_for(role: SalienceSupporting, i: AuditionHero)
    && emission_is_none_for(role: SalienceGround, i: AuditionHero)
    && !string_contains(s: instrument_css_at_role(role: SalienceSupporting), pattern: "0 0 20px")
    && !string_contains(s: instrument_css_at_role(role: SalienceSupporting), pattern: "0 0 48px")
}

data block_position_note: String = "Occurrence INSIDE each theme block, not merely somewhere in the stylesheet: the CSS is split on the two later block selectors and the variable is required in every resulting piece. The first version asserted the variable existed and the selectors existed, which one hand-written block would have satisfied while the toggle silently did nothing."

fn witness_the_emission_var_occurs_inside_every_theme_block() -> Bool {
  let css = instrument_emission_root_css_for(role: audition_subject_role())
  let v = emission_var_ref(i: AuditionHero)
  let day_block = first_segment(s: css, marker: ":root[data-theme=")
  let media_block = last_segment(s: css, marker: "@media (prefers-color-scheme:")
  let alt_block = first_segment(s: last_segment(s: css, marker: ":root[data-theme="), marker: "@media")
  string_contains(s: day_block, pattern: v)
    && string_contains(s: alt_block, pattern: v)
    && string_contains(s: media_block, pattern: v)
    && string_contains(s: media_block, pattern: ":root:not([data-theme])")
}

data live_world_note: String = "The page reads the world V0 derives, live. If the projection refuses, the page renders the located causes rather than a smaller program."

fn witness_the_page_reads_the_live_derived_program_view() -> Bool {
  match live_program_view_result() {
    ProgramViewDerived { view } => count(view.finish_lines) == 4 && count(view.fronts) > 0
    ProgramViewRefused { causes } => false
  }
}

fn witness_the_page_renders_real_remaining_and_constraint_readings() -> Bool {
  let r = served()
  string_contains(s: r.body, pattern: "program / remaining")
    && string_contains(s: r.body, pattern: "outcome / status")
    && string_contains(s: r.body, pattern: "node / why")
    && string_contains(s: r.body, pattern: "open fronts")
}

data front_grain_witness_note: String = "The claim review 48579 found missing: the front grain renders the FIRST contributing front. The oracle is independent of the code under test — V0 derives the exemplar's contributing set as namespace-pderive then v2-generation, so the page must name the first front's own title and must NOT name the second's. A last-wins fold renders the second, which is exactly what the page did before the fix, so this claim reds on the real defect rather than on a restatement of the fix. Reading the rendered name rather than the selection function is deliberate: the defect was in what the page showed."

fn witness_the_front_grain_shows_the_first_contributing_front() -> Bool {
  let r = served()
  string_contains(s: r.body, pattern: "front / status")
    && string_contains(s: r.body, pattern: "Namespace / P-derive")
    && !string_contains(s: body_markup(r: r), pattern: "V2 generation and admission")
}

data evidence_refusal_note: String = "Evidence depth refuses, and unlike the previous Why refusal this one is real: gunbc.roadmap_program_view records that the verification-receipt join is test-only, so no carrier can answer it yet. The witness pins the cause text so a future reader can tell this refusal from the fabricated one it replaced."

fn witness_red_evidence_depth_refuses_with_its_real_cause() -> Bool {
  let r = served()
  string_contains(s: r.body, pattern: "evidence / status — unavailable:")
    && string_contains(s: r.body, pattern: "verification-receipt join is test-only")
}

data press_is_a_press_note: String = "The press specimen is asserted as what it is — a bounded translation on a focusable control — and explicitly NOT as a realized CRT glitch. The keyboard claim is the one that matters: the specimen is a button, so it is reachable without a pointer."

fn witness_the_press_specimen_is_a_bounded_translation_on_a_focusable_control() -> Bool {
  let r = served()
  let css = instrument_css()
  string_contains(s: css, pattern: ".instrument-frame:active")
    && string_contains(s: css, pattern: "translateY(-3px)")
    && string_contains(s: r.body, pattern: "<button")
    && string_contains(s: r.body, pattern: "impulse transient")
    && instrument_displacement_px(p: preference_default) == 6
}

test fn instrument_sandbox_keystone_holds() -> Bool {
  witness_the_instrument_path_serves_html()
    && witness_the_page_calls_itself_a_study_and_carries_no_dead_controls()
    && witness_the_served_role_is_the_derived_one()
    && witness_emission_is_present_exactly_when_the_admission_grants_it()
    && witness_red_a_refused_audition_paints_nothing()
    && witness_the_emission_var_occurs_inside_every_theme_block()
    && witness_the_page_reads_the_live_derived_program_view()
    && witness_the_page_renders_real_remaining_and_constraint_readings()
    && witness_the_front_grain_shows_the_first_contributing_front()
    && witness_red_evidence_depth_refuses_with_its_real_cause()
    && witness_the_press_specimen_is_a_bounded_translation_on_a_focusable_control()
}
