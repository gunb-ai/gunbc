module test.claim.derived_type_origin_witness_test

import std.types { Bool, NonEmptyStr }
import std.decl_ref { DeclarationRef, decl_ref, decl_field_ref, decl_type_parameter_ref }
import std.derived_type_origin {
  DerivedTypeOrigin,
  CarriedDeclaration,
  ParameterBinding,
  KernelElementPosition,
  DerivationRefused,
  GenericIdentityVerdict,
  IsGenericParameter,
  NotAGenericParameter,
  GenericIdentityRefused,
  derived_origin_copy,
  generic_identity_of,
  SelfBindingVerdict,
  SelfBinding,
  NotSelfBinding,
  SelfBindingRefused,
  self_binding_of,
}

// THE LAWS OF std.derived_type_origin, executed over supplied origins (DESIGN section 3 witness
// rule: the subject is this interface, so its inputs are constructed, not produced by infer).
// The specimens are the ones gunbc.recurring_failure_mode generic_identity_decided_by_spelling
// measured: a List's element child that SPELLS T, and two owners whose parameter is spelled T.
// Each red-shaped claim pairs with a control one term away.

fn fold_list_t() -> DeclarationRef {
  decl_type_parameter_ref(module_path: "v2.std.algebra", decl_name: "fold_list", parameter: "T")
}

fn head_of_t() -> DeclarationRef {
  decl_type_parameter_ref(module_path: "scratch.joinarg", decl_name: "head_of", parameter: "T")
}

// L3: the kernel element child is never a generic parameter, whatever it is spelled.
test fn a_kernel_element_position_is_not_a_generic_parameter() -> Bool {
  match generic_identity_of(origin: KernelElementPosition { container: "FreeMonoid" as NonEmptyStr, position: 0 }) {
    NotAGenericParameter => true
    _ => false
  }
}

// Control for L3: a carried TypeParameter declaration IS a generic parameter.
test fn a_carried_type_parameter_declaration_is_a_generic_parameter() -> Bool {
  match generic_identity_of(origin: CarriedDeclaration { declaration: fold_list_t() }) {
    IsGenericParameter { parameter: _ } => true
    _ => false
  }
}

// A carried declaration of something else (a field, a whole declaration) is not a parameter.
test fn a_carried_field_or_whole_declaration_is_not_a_generic_parameter() -> Bool {
  let field = match generic_identity_of(origin: CarriedDeclaration { declaration: decl_field_ref(module_path: "std.effects", decl_name: "DeleteEffect", field_name: "key_source") }) {
    NotAGenericParameter => true
    _ => false
  }
  let whole = match generic_identity_of(origin: CarriedDeclaration { declaration: decl_ref(module_path: "std.effects", decl_name: "KeySource") }) {
    NotAGenericParameter => true
    _ => false
  }
  field && whole
}

// L4: a refusal is neither answer.
test fn a_refused_derivation_is_neither_a_parameter_nor_concrete() -> Bool {
  match generic_identity_of(origin: DerivationRefused { constructor: "build_call_application_plan" as NonEmptyStr, cause: "formal read before binder marking" as NonEmptyStr }) {
    GenericIdentityRefused { constructor: _, cause: _ } => true
    _ => false
  }
}

// L1: a copy keeps its input's origin, so a copied parameter is still that parameter.
test fn a_copy_keeps_its_generic_identity() -> Bool {
  match generic_identity_of(origin: derived_origin_copy(input: CarriedDeclaration { declaration: head_of_t() })) {
    IsGenericParameter { parameter: _ } => true
    _ => false
  }
}

// THE srv3 GUARD, by identity: T bound to a List's element child (spelled T) is NOT a self-binding.
test fn binding_t_to_a_kernel_element_spelled_t_is_not_a_self_binding() -> Bool {
  match self_binding_of(parameter: fold_list_t(), binding: KernelElementPosition { container: "FreeMonoid" as NonEmptyStr, position: 0 }) {
    NotSelfBinding => true
    _ => false
  }
}

// Control: T bound to itself IS a self-binding.
test fn binding_t_to_itself_is_a_self_binding() -> Bool {
  match self_binding_of(parameter: fold_list_t(), binding: CarriedDeclaration { declaration: fold_list_t() }) {
    SelfBinding => true
    _ => false
  }
}

// Cross-owner: two owners' parameters spelled T are different parameters.
test fn two_owners_parameters_spelled_alike_are_different() -> Bool {
  match self_binding_of(parameter: fold_list_t(), binding: CarriedDeclaration { declaration: head_of_t() }) {
    NotSelfBinding => true
    _ => false
  }
}

// A substituted node stands in for its parameter; it is not that parameter.
test fn a_parameter_binding_is_not_the_parameter_itself() -> Bool {
  match self_binding_of(parameter: fold_list_t(), binding: ParameterBinding { parameter: fold_list_t() }) {
    NotSelfBinding => true
    _ => false
  }
}

// L4 at the self-binding consumer: a binding whose origin was refused reaches the caller as a refusal,
// never as "not a self-binding" (review 73742 on gunbc#12914).
test fn a_refused_binding_origin_refuses_the_self_binding_question() -> Bool {
  match self_binding_of(parameter: fold_list_t(), binding: DerivationRefused { constructor: "build_call_application_plan" as NonEmptyStr, cause: "formal read before binder marking" as NonEmptyStr }) {
    SelfBindingRefused { constructor: _, cause: _ } => true
    _ => false
  }
}
