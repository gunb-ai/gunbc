module test.claim.push_event_witness_wet


data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data push_event_fixture_path: String = "dag/test/fixture/github_push_event/main_push.json"

// WET event-file projection for extdeps.github.push_event (operator undraft checklist step 5): reads the planted main-push fixture from disk via Filesystem.Read before JSON ingest.
data real_execution_home_doc: String = "These witnesses drive real Filesystem.Read effects (extdeps.filesystem.filesystem_io has no mock_response), so the hermetic discovery corpus refuses them by construction. Excluded from discovery (gunbc.ci_layer_roots witness_exclusion_substrings) and re-enrolled as declared Wet explicit entries (bin_witness_wet_entries), same lane as the srv3 install-media real-execution witnesses."

test fn witness_push_before_from_fixture_file() -> Bool {
  match push_before_from_event_path(path: push_event_fixture_path) {
    PushBeforeObserved { sha: sha } =>
      (sha as String) == "1111111111111111111111111111111111111111"
    PushBeforeAbsent { detail: _ } => false
    PushBeforeZeroSha => false
    PushBeforeMalformed { detail: _ } => false
    PushEventPayloadReadRefused { path: _, cause: _ } => false
  }
}

test fn witness_push_before_payload_read_refused_on_missing_path() -> Bool {
  match push_before_from_event_path(path: "__gunbc_missing_push_event_fixture__.json") {
    PushEventPayloadReadRefused { path: _, cause: _ } => true
    PushBeforeObserved { sha: _ } => false
    PushBeforeAbsent { detail: _ } => false
    PushBeforeZeroSha => false
    PushBeforeMalformed { detail: _ } => false
  }
}
