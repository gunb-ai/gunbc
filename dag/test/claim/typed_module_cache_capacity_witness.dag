module test.claim.typed_module_cache_capacity_witness

import std.logic { Bool }
import std.types { String, Int, NonEmptyStr }
import std.measure { byte_size }
import gunbc.host.host_budget_source {
  HostBudgetResolution,
  HostBudgetResolved,
  HostBudgetUnreadable,
  HostBudgetExternallyBounded,
  BudgetSourceCgroupMemoryMax,
  host_budget_resolved_observation,
}
import gunbc.typed_module_cache_capacity {
  TypedModuleCacheCap,
  CapEntries,
  CapEntryRefused,
  CapEntriesExternallyBounded,
  typed_module_cache_entry_cap,
  typed_module_cache_entry_cap_with_override,
  typed_module_cache_entries_floor,
  typed_module_cache_entries_ceiling,
  cap_entries_externally_bounded_still_interim,
  typed_module_cache_externally_bounded_disposition,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.disposition { Scaffold, Terminal }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Executes the modelled cap derivation that extdeps.realization.reconcile_in_process now cites as
// its RuntimeDerivedLimit authority. The load-bearing cell is
// unreadable_budget_refuses_rather_than_defaulting: the seed's previous unwrap_or(CEIL) turned an
// unknown budget into the MOST PERMISSIVE cap available and OOM-killed the full witness corpus
// twice, so the discriminating question is not whether a cap is produced but whether the refusal
// survives. Both clamp directions are pinned because a one-sided clamp would look correct on the
// ordinary budget and fail exactly at the extremes the clamp exists for.

// 300 entries exactly: 300 * 3 MiB = 943718400 bytes, comfortably inside the band.
fn ordinary_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(
    source: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup" },
    bytes: byte_size(count: 943718400)
  )
}

fn tiny_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(source: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup" }, bytes: byte_size(count: 1048576))
}

fn huge_budget() -> HostBudgetResolution {
  host_budget_resolved_observation(source: BudgetSourceCgroupMemoryMax { cgroup_dir: "/sys/fs/cgroup" }, bytes: byte_size(count: 107374182400))
}

fn unreadable_budget() -> HostBudgetResolution {
  HostBudgetUnreadable { reason: "no modelled source answered on this platform" }
}

fn cap_entries_or(c: TypedModuleCacheCap, fallback: Int) -> Int {
  match c {
    CapEntries { entries: n } => n
    CapEntryRefused { reason: _ } => fallback
    CapEntriesExternallyBounded { entries: _, run_id: _ } => fallback
  }
}

test fn ordinary_budget_derives_the_quotient() -> Bool {
  cap_entries_or(c: typed_module_cache_entry_cap(r: ordinary_budget()), fallback: 0) == 300
}

test fn a_tiny_budget_clamps_up_to_the_floor() -> Bool {
  let derived = cap_entries_or(c: typed_module_cache_entry_cap(r: tiny_budget()), fallback: 0)
  derived == typed_module_cache_entries_floor
}

test fn a_huge_budget_clamps_down_to_the_ceiling() -> Bool {
  let derived = cap_entries_or(c: typed_module_cache_entry_cap(r: huge_budget()), fallback: 0)
  derived == typed_module_cache_entries_ceiling
}

// THE CONTROL THIS FILE EXISTS FOR. An unreadable budget must refuse. The
// specific wrong answer -- the one with a receipt -- is the ceiling, so this
// asserts refusal AND that the value is not the most permissive cap.
test fn unreadable_budget_refuses_rather_than_defaulting() -> Bool {
  match typed_module_cache_entry_cap(r: unreadable_budget()) {
    CapEntries { entries: _ } => false
    CapEntryRefused { reason: _ } => true
    CapEntriesExternallyBounded { entries: _, run_id: _ } => false
  }
}

test fn unreadable_budget_does_not_yield_the_ceiling() -> Bool {
  let derived = cap_entries_or(c: typed_module_cache_entry_cap(r: unreadable_budget()), fallback: 0)
  derived != typed_module_cache_entries_ceiling
}

test fn a_positive_override_is_still_clamped_to_the_ceiling() -> Bool {
  let capped = cap_entries_or(
    c: typed_module_cache_entry_cap_with_override(override_entries: 999999, r: ordinary_budget()),
    fallback: 0
  )
  capped == typed_module_cache_entries_ceiling
}

test fn a_zero_override_falls_through_to_the_derived_cap() -> Bool {
  let fell_through = cap_entries_or(
    c: typed_module_cache_entry_cap_with_override(override_entries: 0, r: ordinary_budget()),
    fallback: 0
  )
  fell_through == 300
}

// A zero override on an UNREADABLE budget must still refuse: falling through
// must reach the derivation, not a number.
test fn a_zero_override_on_an_unreadable_budget_still_refuses() -> Bool {
  match typed_module_cache_entry_cap_with_override(override_entries: 0, r: unreadable_budget()) {
    CapEntries { entries: _ } => false
    CapEntryRefused { reason: _ } => true
    CapEntriesExternallyBounded { entries: _, run_id: _ } => false
  }
}

test fn an_externally_bounded_executor_does_not_reuse_derived_cap_entries() -> Bool {
  match typed_module_cache_entry_cap(
    r: HostBudgetExternallyBounded { run_id: "bb77f2ae-888b-4f04-9bef-6dab045b1548" as NonEmptyStr }
  ) {
    CapEntries { entries: _ } => false
    CapEntryRefused { reason: _ } => false
    CapEntriesExternallyBounded { entries: n, run_id: id } =>
      n == typed_module_cache_entries_floor
        && (id as String) == "bb77f2ae-888b-4f04-9bef-6dab045b1548"
  }
}

test fn the_externally_bounded_cap_arm_carries_a_read_dissolution() -> Bool {
  cap_entries_externally_bounded_still_interim()
    && match typed_module_cache_externally_bounded_disposition {
      Scaffold { dissolves_to: _, bind: r } => (r.decl_name as String) == "CapEntriesExternallyBounded"
      Terminal { reason: _ } => false
    }
}
