import std.optional { Absent, Present }
import v2.std.text { String }
import std.types { NonEmptyStr, List, Map, Int, Bool }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.integer { int_to_decimal_string }
import std.algebra { Cons, Empty, fold_list, empty_map, map_insert, map_lookup }

// THE LIVE JOIN plus its discriminating controls. The model is in
// gunbc.quarantine_probe_disposition; this file supplies the three live populations from the
// authorities that own them and asserts that every live quarantine probe derives EXACTLY ONE
// holding disposition.
//
// NO `live_tree_disposition` DECLARATION HERE, AND THAT IS DELIBERATE RATHER THAN AN OMISSION.
// This witness reads the live tree (the module-declaration index and a declaration control), so
// declaring SubstrateInputsOnly would be false. Undeclared remains the fail-closed affected-set
// selection position; the required floor now executes it and lets the interpreter classify the
// actual effects.
// Live claim plus controls for the total quarantine-probe disposition join. THE LIVE CLAIM IS
// DELIBERATELY NOT WHERE THE DISCRIMINATION LIVES: it is a universal over the live admission rows,
// so it stays meaningful at any population size including zero, and it would pass vacuously on an
// empty roster. The discrimination is carried by the synthetic controls below, which are authored
// here and cannot lose their subject when a live quarantine dissolves -- each of the five holder
// arms is shown to derive HeldByExactlyOne on its own, held-by-nothing is shown to derive the
// alarm, and held-by-two is shown to refuse. The controls therefore prove the fold DISCRIMINATES
// rather than merely agreeing with today's tree.

// THE ENTRY-PATH -> AUTHORED-MODULE JOIN, from the same declaration the floor reads.
//
// A path-shaped guess is NOT available here and the corpus proves it: the admission entry
// src/v2/test/claim/manual/english_emit_add.dag declares module v2.test.claim.manual.english_emit_add,
// dropping a segment and a suffix, and dag/test/claim/self_host_03_normalize_behavioral_witness.dag
// declares test.claim.self_host_03_normalize_behavioral_witness. Deriving the identity from the
// path would silently miss the roster this fold joins against, and a miss reads as an alarm.
// ONE PASS OVER THE CORPUS CENSUS. The admission entries are keyed first, then the census is
// read once and only the entries' own rows are kept, so each subject reads its module by key.
// The earlier shape folded the whole census once per admission row -- rows x corpus, 677,277
// eval steps of the live claim's ~788k measured with claim_batch -- to name a few dozen modules
// (DESIGN section 6, bare minimum cost).
fn entry_modules(facts: List<ModuleDeclarationFact>, rows: List<ExplicitWitnessAdmission>) -> Map<String, String> {
  let wanted = fold_list(xs: rows, empty: empty_map(), cons: fn(acc, row) { map_insert(m: acc, key: row.witness.entry, value: true) })
  fold_list(
    xs: facts,
    empty: empty_map(),
    cons: fn(acc, fact) {
      match map_lookup(m: wanted, key: fact.path) {
        Present { value: _ } => map_insert(m: acc, key: fact.path, value: fact.module)
        Absent => acc
      }
    }
  )
}

fn entry_declares_reads_live_tree_for_selection(entry: String) -> Bool {
  let source = filesystem_read(path: entry).content
  source.contains("LiveTreeDisposition") && source.contains("ReadsLiveTree")
}

fn subject_for_admission(
  modules: Map<String, String>,
  row: ExplicitWitnessAdmission
) -> QuarantineProbeSubject {
  QuarantineProbeSubject {
    module: match map_lookup(m: modules, key: row.witness.entry) {
      Present { value: m } => m
      Absent => ""
    },
    entry: row.witness.entry,
    function: row.witness.function
  }
}

// THE CENSUS IS READ OVER THE ENTRIES' OWN DIRECTORIES, not the whole pool: the only rows the
// join keeps are the admission entries', so scanning the rest of dag and src/v2 was work no
// consumer read. The roots are derived from the entries (each entry's parent directory, once),
// never authored, so an admission added anywhere is covered by construction; an entry whose
// declaration is not found still derives an empty module and reds the live claim as NowPassing.
fn entry_parent_dir(entry: String) -> String {
  let parts = split(s: entry, delimiter: "/")
  join(parts |> take(n: count(parts) - 1), "/")
}

fn entry_census_roots(rows: List<ExplicitWitnessAdmission>) -> List<String> {
  sorted_map_keys(fold_list(xs: rows, empty: empty_map(), cons: fn(acc, row) { map_insert(m: acc, key: entry_parent_dir(entry: row.witness.entry), value: true) }))
}

fn live_quarantine_probe_subjects() -> List<QuarantineProbeSubject> {
  let rows = quarantine_probe_admissions(rows: explicit_witness_admissions)
  let modules = entry_modules(facts: module_declaration_facts_live(pool_roots: entry_census_roots(rows: rows)), rows: rows)
  fold_list(
    xs: rows,
    empty: Empty {},
    cons: fn(acc, row) { Cons { head: subject_for_admission(modules: modules, row: row), tail: acc } }
  )
}

fn live_quarantine_probe_facts() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: floor_expected_red_roster(),
    route_gap_roster: floor_route_gap_roster(),
    home_prefixes: long_home_prefixes(),
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: quarantine_outside_gate_declines,
    gate_admits: fn(m) { required_gate_admits(module_path: m) }
  }
}

// THE LIVE CLAIM. Every QuarantineProbeExpectRed admission derives exactly one holder.
//
// PATH EXCLUSIONS ARE PASSED EMPTY, and the two facts that makes true are different. The arm's
// live inhabitant count is measured ZERO at 967b5bc1b92; its inhabitant count IN PRODUCTION is
// UNMEASURED, because the floor's exclusion list is a Rust literal that no .dag caller can read
// -- and cannot become one, since that list decides which modules enter the prepared subject
// and so cannot be evaluated from inside it. Mirroring the literal here would be a second
// representation that drifts silently. Unmeasured and zero are different states, and this guard
// exists to refuse exactly that conflation, so it does not commit it in its own witness.
//
// THE ALL-HOLD CLAIM. Its name and entry are unchanged (the `gunbc_claim_execution_contract` row in
// `gunbc.roadmap.roadmap_authority` names this function, and the harness maps `ExitSuccess` to a pass),
// so the `ProcessExit` return adds a reason channel without moving the obligation. A Bool here prints
// `FAIL <fn>` and nothing else: one bit for the whole fold, so an owner could not tell which probe was
// mis-held, whether a probe was held by nothing or by two carriers, or how many were affected. The
// reason names the offender count, the population size, and the first offender as `arm: identity @
// entry` -- the arm is in the message because the two refusal arms describe opposite states
// (`QuarantineProbeNowPassing` = an admission NO carrier holds; `QuarantineProbeHeldByMoreThanOne` = an
// admission TWO carriers hold), and a count alone cannot say which one the tree is in.
//
// PREDICATE: some disposition fails to hold, on EITHER refusal arm. `every_admitted_probe_row_has_at_least_one_holder`
// below reads the same ledger through the same filter and selects ONE arm; it is not this claim restated,
// and neither is pacified by the other -- the all-hold claim stays green while a double-held row exists
// that the zero-holder claim ignores, and vice versa.
test fn every_quarantine_probe_derives_exactly_one_disposition() -> ProcessExit {
  let ds = live_dispositions()
  let unheld = unheld_admitted_rows(ds: ds)
  if length(xs: unheld) == 0 {
    ExitSuccess
  } else {
    ExitFailure {
      code: 1,
      reason: concat(
        concat("live quarantine probes not deriving exactly one holder: ", int_to_decimal_string(value: length(xs: unheld))),
        concat(" of ", concat(int_to_decimal_string(value: length(xs: ds)), "; first: ", first_text(xs: unheld)))
      )
    }
  }
}

// THE LIVE CLAIM IS NOT VACUOUS: every supplied live population holds at least one live probe.
// Under exactly-one holding, dropping a population turns every probe it solely holds into
// NowPassing, so "removing P reds the live claim" IS "some live probe's one holder is P". That
// equivalence is read off ONE live evaluation rather than re-folding the whole join once per
// dropped population: the earlier mutation form paid the live join five times and was refused at
// 808,294 eval steps (CI run 36656467027), cost that bought no discrimination the single reading
// lacks (DESIGN section 3, a witness discriminates at one interface). The mutation half of the
// equivalence -- that a dropped population really does unhold -- is asserted on supplied facts by
// the fixture claims below (a_probe_held_by_nothing_is_an_alarm_and_does_not_hold, and the
// outside-gate pair), where it costs nothing. The live-tree and path-exclusion axes are not
// required here because the required floor no longer has a live-tree decline and neither arm
// holds a live row.
fn live_dispositions() -> List<QuarantineProbeDisposition> {
  quarantine_probe_dispositions(subjects: live_quarantine_probe_subjects(), facts: live_quarantine_probe_facts())
}

fn disposition_holds_by(d: QuarantineProbeDisposition, kind: fn(QuarantineProbeHolder) -> Bool) -> Bool {
  match d {
    HeldByExactlyOne { identity: _, holder: h } => kind(h)
    _ => false
  }
}

fn some_disposition_holds_by(ds: List<QuarantineProbeDisposition>, kind: fn(QuarantineProbeHolder) -> Bool) -> Bool {
  fold_list(xs: ds, empty: false, cons: fn(acc, d) { acc || disposition_holds_by(d: d, kind: kind) })
}

// WHY ONE CLAIM PER POPULATION. These four assertions used to be ANDed into a single Bool alongside the
// all-hold fold above, so one `FAIL <fn>` line covered five possible causes and carried no way to tell
// them apart -- a population going empty and a probe going unheld printed the same one-word verdict. Each
// population is now its own claim returning `ProcessExit`, which is the only reason channel the harness
// prints (`ClaimOutcome::ExitFailure` renders `FAIL <fn> (returned ProcessExit::ExitFailure, code N:
// <reason>)`), so a verdict names WHICH population and shows its first member.
//
// WHY THIS IS AFFORDABLE WHERE THE REFUSED MUTATION FORM WAS NOT. The comment above `live_dispositions`
// records a mutation shape that paid the live join once per population inside one claim and was refused;
// the difference is per-claim budgeting, not the number of reads: the witness eval budget is armed per
// claim (`set_witness_eval_budget`, and `claim_batch`'s `--eval-budget-ms`), and `claim_batch` resolves an
// entry once for the whole batch, so four claims here re-pay one resolve and each stays under its own
// budget -- the same shape the probes that located this defect used (two ProcessExit claims over one
// entry in one batch), which is why the split's affordability is a measured property and not an argument.
// DESIGN section 6's defect is re-paying one entry's resolve across chunked children; it is not "two
// claims read the same thing".
fn population_member_count(
  ds: List<QuarantineProbeDisposition>,
  is_kind: fn(QuarantineProbeHolder) -> Bool
) -> Int {
  fold_list(
    xs: ds,
    empty: 0,
    cons: fn(acc, d) { if disposition_holds_by(d: d, kind: is_kind) { acc + 1 } else { acc } }
  )
}

// ONE CLAIM PER REQUIRED POPULATION. Each states its own size and its own verdict, so a FAIL names
// which population stopped being load-bearing rather than pointing at a conjunction.
fn population_is_load_bearing(
  label: String,
  ds: List<QuarantineProbeDisposition>,
  is_kind: fn(QuarantineProbeHolder) -> Bool
) -> ProcessExit {
  let n = population_member_count(ds: ds, is_kind: is_kind)
  if n > 0 {
    ExitSuccess
  } else {
    ExitFailure {
      code: 1,
      reason: concat(
        concat(label, ": no live probe is held by this population any more (n="),
        concat(int_to_decimal_string(value: n), "); the live all-hold claim would go red on its own.")
      )
    }
  }
}

test fn the_enrolled_red_population_is_load_bearing() -> ProcessExit {
  population_is_load_bearing(label: "FloorExpectedRedHeld", ds: live_dispositions(), is_kind: fn(h) { match h { FloorExpectedRedHeld => true _ => false } })
}

test fn the_route_gap_population_is_load_bearing() -> ProcessExit {
  population_is_load_bearing(label: "RouteGapHeldNoVerdict", ds: live_dispositions(), is_kind: fn(h) { match h { RouteGapHeldNoVerdict => true _ => false } })
}

test fn the_home_policy_population_is_load_bearing() -> ProcessExit {
  population_is_load_bearing(
    label: "NeverRunDeclinedByHomePolicy",
    ds: live_dispositions(),
    is_kind: fn(h) { match h { NeverRunDeclinedByHomePolicy { matched_prefix: _ } => true _ => false } }
  )
}

test fn the_outside_gate_population_is_load_bearing() -> ProcessExit {
  population_is_load_bearing(
    label: "NeverRunDeclinedOutsideGate",
    ds: live_dispositions(),
    is_kind: fn(h) { match h { NeverRunDeclinedOutsideGate { module: _, trigger: _ } => true _ => false } }
  )
}

// THE STRUCTURAL CLAIM: every admitted probe row has at least one holder. WHY IT IS A CLAIM AND NOT A
// RESTATEMENT OF THE ONE ABOVE. The ledger claim refuses on EITHER refusal arm; this one refuses on
// exactly one -- `QuarantineProbeNowPassing`, the arm an admitted probe reaches when NO carrier holds it.
// Different predicate, different verdict, one meaning each. The filter selects on the ARM, not on
// `quarantine_probe_disposition_holds`: the all-hold predicate also selects double-held rows, so reusing
// it here would copy the ledger claim's verdict and make this claim's own message false ("no carrier"
// printed for a probe two carriers hold). Selecting the one arm its name names is what keeps both the
// claim and the sentence true.
//
// WHY IT EXISTS, AND WHO CONSUMES IT. The fold reports an unheld admission as an alarm arm, but nothing
// asserted that no row may REACH that arm -- that state was reachable, unowned, silent, which is the
// degradation this repo refuses. CONSUMER AND ROUTE, stated because a claim no job runs must be
// classified rather than left ambiguous (DESIGN section 3c): the consumer is whoever edits
// `gunbc.explicit_witness_admission`, running this file where the rows are authored; the route that
// executes it is NO REQUIRED JOB, and that is declared, not an omission -- `dag/test/claim` is a discovery
// root, and `gunbc.rung_drop.v1_required_lanes_withdrawn` records that the witness lane's
// `claim_executor --required-ci --required-lane witnesses` "is run by no job", "executed by no required
// job"; its restoration trigger is the capability that "on every landing revision, a binary built from an
// emission of v2 ... judges this population on the required path with a discriminating red".
// This claim is therefore a local check at the place the obligation lives, not a gate, and it is written
// to be honest about that: the alternative was worse than useless. Enrolling it in
// `local_repo_wet_schedule` would assert a host effect it does not have and would only register it in
// `gunbc.claim_coverage_census` as enrolled-and-executed-by-nothing (that census's own header: "a roster
// that names a claim is not an executor of it"); a new instrument label would mint a second consumer of
// the ledger. Both were considered and rejected, not overlooked.
//
// It reads the ADMISSION LEDGER as the single authority (through `quarantine_probe_admissions`, the same
// filter `live_quarantine_probe_subjects()` uses), so it cannot be pacified by deleting a row -- deleting
// a row removes its obligation, which is why the repair for a dissolved row is deletion and the repair
// for a live red is giving it a standing. Nor by a lookalike holder:
// `a_roster_row_that_merely_contains_the_identity_does_not_hold_it` proves the substring case does not
// count.
test fn every_admitted_probe_row_has_at_least_one_holder() -> ProcessExit {
  let unheld = zero_holder_rows(ds: live_dispositions())
  if length(xs: unheld) == 0 {
    ExitSuccess
  } else {
    ExitFailure {
      code: 1,
      reason: concat(
        concat("admitted quarantine probe rows held by NO carrier (n=", int_to_decimal_string(value: length(xs: unheld))),
        concat("): ", first_text(xs: unheld))
      )
    }
  }
}

// THE ZERO-HOLDER PROJECTION, one predicate, used by the claim above and exercised by the fixture below.
// THE ARM IS SELECTED BY CONSTRUCTOR, never by comparing the rendered label. An earlier spelling here read
// `unheld_disposition_arm(disposition: d) == "QuarantineProbeNowPassing"`, which made the display string a
// second authority for which arm is the zero-holder arm: rename or reword that label and the filter selects
// nothing, the live claim goes green vacuously, and only the fixture below notices (review 84130, DESIGN §5
// — make the wrong state unwritable where a constructor match is available). `is_zero_holder_disposition`
// is that match, and it is total over the three arms so a fourth cannot default its way in.
fn is_zero_holder_disposition(d: QuarantineProbeDisposition) -> Bool {
  match d {
    QuarantineProbeNowPassing { identity: _, entry: _, function: _ } => true
    HeldByExactlyOne { identity: _, holder: _ } => false
    QuarantineProbeHeldByMoreThanOne { identity: _, holders: _ } => false
  }
}

fn zero_holder_rows(ds: List<QuarantineProbeDisposition>) -> List<String> {
  fold_list(
    xs: ds,
    empty: Empty {},
    cons: fn(acc, d) {
      if is_zero_holder_disposition(d: d) {
        Cons { head: disposition_identity(d: d), tail: acc }
      } else {
        acc
      }
    }
  )
}

// THE PURE HALF, so the state can be exercised by a fixture and not only by live data. ONE fold, shared
// by the claim above and the fixture claim below -- a fixture that tested a different predicate would
// prove nothing. Each element is `arm: identity @ entry`: the arm comes from `unheld_disposition_arm`
// and the identity from `disposition_identity`, so there is no second per-arm match in this file (the
// removed `first_unheld_identity` was exactly that duplicate). `HeldByExactlyOne` never appears in the
// result: a held disposition is not an offender.
fn unheld_admitted_rows(ds: List<QuarantineProbeDisposition>) -> List<String> {
  fold_list(
    xs: ds,
    empty: Empty {},
    cons: fn(acc, d) {
      if quarantine_probe_disposition_holds(disposition: d) {
        acc
      } else {
        Cons {
          head: concat(unheld_disposition_arm(disposition: d), concat(": ", disposition_identity(d: d))),
          tail: acc
        }
      }
    }
  )
}

// THE ARM AS THE MESSAGE NAMES IT. Total over the three arms, because the disposition is a sum type and
// a wildcard here would let a fourth arm print nothing (DESIGN section 5: no plausible output
// fabricated). The two refusal arms mean opposite things -- NowPassing is an admission NO carrier holds,
// HeldByMoreThanOne is an admission TWO carriers hold -- so the reader must not have to re-derive which
// one fired from a count alone.
fn unheld_disposition_arm(disposition: QuarantineProbeDisposition) -> String {
  match disposition {
    QuarantineProbeNowPassing { identity: _, entry: _, function: _ } => "QuarantineProbeNowPassing"
    QuarantineProbeHeldByMoreThanOne { identity: _, holders: _ } => "QuarantineProbeHeldByMoreThanOne"
    HeldByExactlyOne { identity: _, holder: _ } => "HeldByExactlyOne"
  }
}

// THE RED FOR BOTH FOLDS, supplied as a fixture rather than as live data. Neither live claim can show
// its own failure shape (when the ledger is clean there is nothing to point at), so this runs BOTH
// projections over the file's synthetic identity with every carrier emptied -- `zero_holder_rows`, the
// predicate the structural claim runs, and `unheld_admitted_rows`, the predicate the ledger claim runs --
// and requires each to name that identity, the ledger one with its `QuarantineProbeNowPassing: ` arm tag.
// One claim covering both folds rather than two claims over one fixture: the folds differ, the fixture
// does not. Delete the alarm arm, drop the arm tag, or let a substring count as a holder, and this goes
// red.
test fn a_fixture_admission_with_no_holder_is_named_by_the_ledger_claim() -> ProcessExit {
  let one = Cons { head: fixture_disposition(facts: probe_fixture_no_facts()), tail: Empty {} }
  let expected = concat(probe_fixture_identity(), concat(" @ ", probe_fixture_entry))
  // THE DISCRIMINATION THAT MAKES THE TWO PROJECTIONS OBSERVABLY DIFFERENT, checked in the fixture
  // direction: a probe held by TWO carriers is an offender for the ledger claim and NOT for the
  // zero-holder claim. The two folds are otherwise only distinguishable from their green states, and an
  // edit that routed this projection back through the all-hold predicate -- reporting a double-held probe
  // as held by none -- would keep every claim in this file green, because the live population contains no
  // double-held row. That is why this arm is a fixture and not a live reading.
  let two = Cons { head: fixture_disposition(facts: facts_with_two_holders()), tail: Empty {} }
  match zero_holder_rows(ds: two) {
    Empty {} =>
      match unheld_admitted_rows(ds: two) {
        Cons { head: t, tail: _ } =>
          match zero_holder_rows(ds: one) {
            Cons { head: h, tail: z } =>
              match z {
                Empty {} =>
                  if h != expected {
                    ExitFailure { code: 1, reason: concat("the zero-holder row was named wrongly: ", h) }
                  } else {
                    match unheld_admitted_rows(ds: one) {
                      Cons { head: g, tail: u } =>
                        match u {
                          Empty {} =>
                            if g == concat("QuarantineProbeNowPassing: ", expected) {
                              ExitSuccess
                            } else {
                              ExitFailure {
                                code: 1,
                                reason: concat("the ledger projection lost or misplaced the arm tag: ", g)
                              }
                            }
                          _ => ExitFailure {
                            code: 1,
                            reason: "the ledger projection reported more than one offender for one probe",
                          }
                        }
                      Empty {} => ExitFailure {
                        code: 1,
                        reason: "the ledger projection did not report the zero-holder probe at all",
                      }
                    }
                  }
                _ => ExitFailure { code: 1, reason: "the zero-holder fixture produced more than one offender" }
              }
            Empty {} => ExitFailure {
              code: 1,
              reason: concat(
                "an admission with every carrier emptied was NOT reported unheld: ",
                probe_fixture_identity()
              )
            }
          }
        _ => ExitFailure {
          code: 1,
          reason: "the ledger projection did not report the double-held probe as an offender"
        }
      }
    Cons { head: wrong, tail: _ } => ExitFailure {
      code: 1,
      reason: concat("the zero-holder projection claimed a DOUBLE-held probe has no holder: ", wrong)
    }
  }
}

fn first_text(xs: List<String>) -> String {
  match xs {
    Cons { head: h, tail: _ } => h
    Empty {} => "(none)"
  }
}

fn disposition_identity(d: QuarantineProbeDisposition) -> String {
  match d {
    QuarantineProbeNowPassing { identity: i, entry: e, function: _ } => concat(i, concat(" @ ", e))
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: _ } => i
    HeldByExactlyOne { identity: i, holder: _ } => i
  }
}

fn probe_no_declines() -> List<QuarantineOutsideGateDecline> {
  Empty {}
}

data probe_fixture_module: String = "test.claim.synthetic_quarantine_probe_witness"
data probe_fixture_entry: String = "dag/test/claim/synthetic_quarantine_probe_witness_test.dag"
data probe_fixture_function: String = "synthetic_probe_holds"

fn probe_fixture_subject() -> QuarantineProbeSubject {
  QuarantineProbeSubject {
    module: probe_fixture_module,
    entry: probe_fixture_entry,
    function: probe_fixture_function
  }
}

fn probe_fixture_identity() -> String {
  quarantine_probe_identity(module: probe_fixture_module, function: probe_fixture_function)
}

fn probe_fixture_no_facts() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_expected_red() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_route_gap() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_home_prefix() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Cons { head: "test.claim.synthetic_", tail: Empty {} },
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_live_tree_decline() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Cons { head: probe_fixture_entry, tail: Empty {} },
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_path_exclusion() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Cons { head: "test/claim/synthetic_", tail: Empty {} },
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn facts_with_two_holders() -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    route_gap_roster: Cons { head: probe_fixture_identity(), tail: Empty {} },
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
}

fn disposition_is_held_by(disposition: QuarantineProbeDisposition, expected: QuarantineProbeHolder) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => quarantine_probe_holder_eq(a: h, b: expected)
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn quarantine_probe_holder_eq(a: QuarantineProbeHolder, b: QuarantineProbeHolder) -> Bool {
  match a {
    FloorExpectedRedHeld => match b {
      FloorExpectedRedHeld => true
      _ => false
    }
    RouteGapHeldNoVerdict => match b {
      RouteGapHeldNoVerdict => true
      _ => false
    }
    NeverRunDeclinedByHomePolicy { matched_prefix: pa } => match b {
      NeverRunDeclinedByHomePolicy { matched_prefix: pb } => pa == pb
      _ => false
    }
    NeverRunDeclinedByLiveTreeRead { entry: ea } => match b {
      NeverRunDeclinedByLiveTreeRead { entry: eb } => ea == eb
      _ => false
    }
    NeverRunPathExcluded { matched_substring: sa } => match b {
      NeverRunPathExcluded { matched_substring: sb } => sa == sb
      _ => false
    }
    NeverRunDeclinedOutsideGate { module: ma, trigger: ta } => match b {
      NeverRunDeclinedOutsideGate { module: mb, trigger: tb } => ma == mb && (ta as String) == (tb as String)
      _ => false
    }
  }
}

fn disposition_is_now_passing(disposition: QuarantineProbeDisposition) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => false
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => i == probe_fixture_identity()
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => false
  }
}

fn disposition_is_held_by_more_than_one(disposition: QuarantineProbeDisposition) -> Bool {
  match disposition {
    HeldByExactlyOne { identity: i, holder: h } => false
    QuarantineProbeNowPassing { identity: i, entry: e, function: f } => false
    QuarantineProbeHeldByMoreThanOne { identity: i, holders: hs } => true
  }
}

fn fixture_disposition(facts: QuarantineProbeHoldingFacts) -> QuarantineProbeDisposition {
  quarantine_probe_disposition(subject: probe_fixture_subject(), facts: facts)
}

// THE POSITIVE CONTROL, ONE ARM AT A TIME. Each holder in isolation derives HeldByExactlyOne and
// carries the holder it found -- including NeverRunPathExcluded, whose derivation is exercised here even
// though no live row inhabits it, and NeverRunDeclinedByLiveTreeRead. An arm with no live inhabitant is
// not an unexercised arm.
test fn each_holder_alone_derives_exactly_one_disposition() -> Bool {
  disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: FloorExpectedRedHeld {})
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_route_gap()), expected: RouteGapHeldNoVerdict {})
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_home_prefix()),
      expected: NeverRunDeclinedByHomePolicy { matched_prefix: "test.claim.synthetic_" }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_live_tree_decline()),
      expected: NeverRunDeclinedByLiveTreeRead { entry: probe_fixture_entry }
    )
    && disposition_is_held_by(
      disposition: fixture_disposition(facts: facts_with_path_exclusion()),
      expected: NeverRunPathExcluded { matched_substring: "test/claim/synthetic_" }
    )
}

// THE DISCRIMINATING RED, AND IT IS THE WHOLE POINT OF THE LANE. A probe no mechanism holds
// derives the ALARM and does NOT hold. There is no accepting arm for this state anywhere in the
// model, so a corpus in this condition cannot be made green by classification -- only by
// deleting the admission row or by giving it a mechanism that really holds it.
test fn a_probe_held_by_nothing_is_an_alarm_and_does_not_hold() -> Bool {
  disposition_is_now_passing(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: probe_fixture_no_facts()))
    && !quarantine_probe_dispositions_all_hold(
      subjects: Cons { head: probe_fixture_subject(), tail: Empty {} },
      facts: probe_fixture_no_facts()
    )
}

// TWO MECHANISMS FOR ONE OBLIGATION REFUSES, and refusing is the ruled-correct answer rather
// than a false positive: two authorities for one fact means someone has to decide which one
// actually holds it. No live row exercises this today, so the control is what keeps the arm
// real.
test fn a_probe_held_by_two_mechanisms_refuses() -> Bool {
  disposition_is_held_by_more_than_one(disposition: fixture_disposition(facts: facts_with_two_holders()))
    && !quarantine_probe_disposition_holds(disposition: fixture_disposition(facts: facts_with_two_holders()))
}

// THE JOIN IS ON EXACT IDENTITY, NOT CONTAINMENT. A roster row whose name merely CONTAINS the
// probe's identity does not hold it. Without this, a rename or a near-miss would read as
// covered, which is the substring weakness the exact-admission authority was built to remove.
test fn a_roster_row_that_merely_contains_the_identity_does_not_hold_it() -> Bool {
  let near_miss = QuarantineProbeHoldingFacts {
    expected_red_roster: Cons { head: concat(probe_fixture_identity(), "_extra"), tail: Empty {} },
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_no_declines(),
    gate_admits: fn(m) { false }
  }
  disposition_is_now_passing(disposition: fixture_disposition(facts: near_miss))
    && disposition_is_held_by(disposition: fixture_disposition(facts: facts_with_expected_red()), expected: FloorExpectedRedHeld {})
}

// The former live-tree specimen now executes and is held by its observed expected-red verdict.
// Keeping an assertion that it is never routed would restate the deleted floor policy.
test fn the_former_live_tree_declined_row_is_now_expected_red() -> Bool {
  let facts = live_quarantine_probe_facts()
  let subject = QuarantineProbeSubject {
    module: "test.claim.legacy_test_behavior_disposition_acceptance",
    entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance.dag",
    function: "legacy_test_behavior_unclassified_frontier_is_zero"
  }
  disposition_is_held_by(
    disposition: quarantine_probe_disposition(subject: subject, facts: facts),
    expected: FloorExpectedRedHeld {}
  )
}

// THE LIVE-TREE DERIVATION IS DISCRIMINATING, not a predicate that answers the same way for
// everything: the entry that declares ReadsLiveTree reads true, and a sibling admission entry
// that does not declare it reads false. Both are live files, so this control also fails if the
// read itself stops working.
test fn the_live_tree_declaration_read_discriminates() -> Bool {
  entry_declares_reads_live_tree_for_selection(entry: "dag/test/claim/legacy_test_behavior_disposition_acceptance.dag")
    && !entry_declares_reads_live_tree_for_selection(entry: "dag/test/claim/method_arg_declared_contract_witness.dag")
}

// THE OUTSIDE-GATE ARM HOLDS ONLY OUTSIDE THE GATE, AND ONLY AS NEVER-RUN. A decline row for the
// fixture probe holds it while the supplied gate refuses the module, and the holder's standing is
// WitnessNeverRuns -- an unenforced red, never coverage. The SAME row under a gate that admits the
// module derives no holder, so the probe reads NowPassing: a probe the floor would execute cannot
// be parked here. The pair is the discriminating control for the join on module identity.
fn probe_fixture_outside_gate_row() -> List<QuarantineOutsideGateDecline> {
  [
    QuarantineOutsideGateDecline {
      module: probe_fixture_module,
      function: probe_fixture_function,
      trigger: "fixture: its module entering the required gate" as NonEmptyStr
    },
  ]
}

fn facts_with_outside_gate(gate_admits_fixture: Bool) -> QuarantineProbeHoldingFacts {
  QuarantineProbeHoldingFacts {
    expected_red_roster: Empty {},
    route_gap_roster: Empty {},
    home_prefixes: Empty {},
    live_tree_declined_entries: Empty {},
    path_exclusion_substrings: Empty {},
    outside_gate_declines: probe_fixture_outside_gate_row(),
    gate_admits: fn(m) { gate_admits_fixture && m == probe_fixture_module }
  }
}

test fn an_outside_gate_row_holds_only_while_the_gate_refuses_the_module_and_only_as_never_run() -> Bool {
  let outside = fixture_disposition(facts: facts_with_outside_gate(gate_admits_fixture: false))
  let inside = fixture_disposition(facts: facts_with_outside_gate(gate_admits_fixture: true))
  (match outside {
    HeldByExactlyOne { identity: _, holder: h } =>
      (match h { NeverRunDeclinedOutsideGate { module: m, trigger: _ } => m == probe_fixture_module  _ => false })
        && (match quarantine_probe_verification_standing(holder: h) { WitnessNeverRuns => true  _ => false })
    _ => false
  })
    && disposition_is_now_passing(disposition: inside)
}
