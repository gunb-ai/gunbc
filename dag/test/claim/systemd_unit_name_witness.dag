module test.claim.systemd_unit_name_witness

import std.types { Bool, String, Int }
import extdeps.systemd {
  systemd_service_unit_name, systemd_unit_name_wire, systemd_service_unit_suffix,
  systemd_unit_name_max_length,
  SystemdUnitNameAdmitted, SystemdUnitNameStemEmpty, SystemdUnitNameDisallowedCharacter,
  SystemdUnitNameOverlong,
}
import gunbc.systemd_unit_names { dispatch_attempt_unit_name, dispatch_attempt_unit_name_resumed }

fn a_repeat(n: Int) -> String {
  if n <= 0 {
    ""
  } else if n >= 16 {
    join(["aaaaaaaaaaaaaaaa", a_repeat(n: n - 16)], "")
  } else {
    join(["a", a_repeat(n: n - 1)], "")
  }
}

test fn an_empty_stem_is_refused() -> Bool {
  match systemd_service_unit_name(stem: "") {
    SystemdUnitNameStemEmpty => true
    SystemdUnitNameAdmitted { name: _ } => false
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}

test fn a_stem_with_a_space_is_refused() -> Bool {
  match systemd_service_unit_name(stem: "gunbc-attempt-a b-k") {
    SystemdUnitNameDisallowedCharacter { stem: s, character: ch } =>
      s == "gunbc-attempt-a b-k" && ch == " "
    SystemdUnitNameAdmitted { name: _ } => false
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}

test fn a_stem_with_at_is_refused() -> Bool {
  match systemd_service_unit_name(stem: "gunbc-attempt-x@y-k") {
    SystemdUnitNameDisallowedCharacter { stem: _, character: ch } => ch == "@"
    SystemdUnitNameAdmitted { name: _ } => false
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}

test fn a_name_from_valid_parts_renders_as_the_attempt_unit_join() -> Bool {
  match systemd_service_unit_name(stem: join(["gunbc-attempt-", "n1", "-", "k1"], "")) {
    SystemdUnitNameAdmitted { name } =>
      (systemd_unit_name_wire(name: name) as String)
        == join(["gunbc-attempt-", "n1", "-", "k1", systemd_service_unit_suffix], "")
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}

test fn a_stem_that_makes_the_unit_name_over_255_is_refused() -> Bool {
  let stem = a_repeat(n: systemd_unit_name_max_length - string_length(s: systemd_service_unit_suffix) + 1)
  match systemd_service_unit_name(stem: stem) {
    SystemdUnitNameOverlong { length: n } => n == systemd_unit_name_max_length + 1
    SystemdUnitNameAdmitted { name: _ } => false
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
  }
}

test fn a_stem_at_the_255_character_ceiling_is_admitted() -> Bool {
  let stem = a_repeat(n: systemd_unit_name_max_length - string_length(s: systemd_service_unit_suffix))
  match systemd_service_unit_name(stem: stem) {
    SystemdUnitNameAdmitted { name } =>
      string_length(s: systemd_unit_name_wire(name: name) as String) == systemd_unit_name_max_length
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}

// RED (gunbc#15804 continuation resume placements, gap #1): a RESUMED attempt must obtain a fresh placement,
// which is only possible because its worker unit carries the resume ordinal. But the FIRST (ordinal-0) worker
// unit must render BYTE-IDENTICALLY to the exact string every record an OLD build wrote is read by -- the
// reboot-dead pair's seat-ledger entries and the boot-after-hold proof both key on THIS name (gunbc gap #2),
// so the resume feature must not perturb it. This is discriminating at the real record shape: it uses a real
// reboot-dead node/attempt (shell-dag-live-deploy-install-owned / 5560c2c576724b67), not an invented one.
// If the base name ever grows a suffix, or the resume suffix is dropped (so a resume collides with its own
// released slot/seat), this witness fails.
test fn the_first_worker_unit_is_byte_identical_and_a_resumed_unit_carries_the_resume_ordinal() -> Bool {
  let node_id = "shell-dag-live-deploy-install-owned"
  let attempt_key = "5560c2c576724b67"
  let base = dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key)
  let resumed = dispatch_attempt_unit_name_resumed(
    node_id: node_id, attempt_key: attempt_key, resume_segment: "worker-resumed-2")
  match base {
    SystemdUnitNameAdmitted { name: b } =>
      match resumed {
        SystemdUnitNameAdmitted { name: r } =>
          (systemd_unit_name_wire(name: b) as String) == "gunbc-attempt-shell-dag-live-deploy-install-owned-5560c2c576724b67.service"
          && (systemd_unit_name_wire(name: r) as String) == "gunbc-attempt-shell-dag-live-deploy-install-owned-5560c2c576724b67-worker-resumed-2.service"
          && (systemd_unit_name_wire(name: b) as String) != (systemd_unit_name_wire(name: r) as String)
        SystemdUnitNameStemEmpty => false
        SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
        SystemdUnitNameOverlong { length: _ } => false
      }
    SystemdUnitNameStemEmpty => false
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => false
    SystemdUnitNameOverlong { length: _ } => false
  }
}
