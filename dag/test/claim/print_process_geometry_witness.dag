module test.claim.print_process_geometry_witness
import std.types {Bool}
import std.measure {micrometer}
import product.printed_chassis.print_preparation {placement_admitted,PlatePlacement}
import product.printed_chassis.assembly_geometry {LayOnXY,LayOnXZ,LayOnYZ,print_pose,print_pose_rows}
import std.euclidean_geometry {PositiveZ}
import std.orthogonal_geometry {OrthogonalReady,OrthogonalRefused,rotation_y_image}

test fn upright_cradle_rotation_is_refused() -> Bool {
 !placement_admitted(p:PlatePlacement {id:"M140",rx:90,ry:0,rz:0,x_um:micrometer(count: 10000),y_um:micrometer(count: 10000)})
}
test fn upright_grille_rotation_is_refused() -> Bool {
 !placement_admitted(p:PlatePlacement {id:"G140",rx:90,ry:90,rz:0,x_um:micrometer(count: 10000),y_um:micrometer(count: 10000)})
}
test fn modeled_plane_preserves_packing_rotation() -> Bool {
 placement_admitted(p:PlatePlacement {id:"any-part",rx:0,ry:0,rz:90,x_um:micrometer(count: 10000),y_um:micrometer(count: 10000)})
}
test fn inverted_unqualified_part_is_refused() -> Bool {
 !placement_admitted(p:PlatePlacement {id:"any-part",rx:180,ry:0,rz:0,x_um:micrometer(count: 10000),y_um:micrometer(count: 10000)})
}
// Every declared plane mints its pose, and the panels' plane sends part-frame +Y away from the bed, the face the
// review readme names (@ref(product.printed_chassis.assembly_geometry::print_plane_pose)). A mirrored pose needs
// no control here: std.orthogonal_geometry OrthogonalRotation3 has no representation for one.
test fn every_declared_plane_derives_its_print_pose() -> Bool {
 all([LayOnXY,LayOnXZ,LayOnYZ],plane=>match print_pose(plane:plane) {OrthogonalReady {value:_}=>true OrthogonalRefused {cause:_}=>false})
  && match print_pose(plane:LayOnXZ) {
   OrthogonalReady {value:r}=>print_pose_rows(r:r)==[[1,0,0],[0,0,0-1],[0,1,0]] && match rotation_y_image(r:r) {PositiveZ=>true _=>false}
   OrthogonalRefused {cause:_}=>false
  }
}
