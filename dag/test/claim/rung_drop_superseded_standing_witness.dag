module test.claim.rung_drop_superseded_standing_witness

import std.types { String, Bool, NonEmptyStr, List }
import std.algebra { FreeSemigroup }
import std.markdown { MarkdownDocument }
import extdeps.languages.markdown { serialize_markdown_source }
import std.types { CommitSha }
import std.optional { Optional, Present, Absent }
import std.removal_tombstone { RemovalTombstone, RemovalVerdict, RemovalHolds, RemovedModuleStillExists, RemovedModuleUnobservable, RemovalCommitDoesNotResolve, RemovalCommitUnobservable, ModuleObservation, ModulePresent, ModuleAbsent, ModuleUnobservable, CommitObservation, CommitResolves, CommitDoesNotResolve, CommitUnobservable, removal_tombstone_verdict, removal_tombstone_holds }
import v2.lens.module_impact_query { ModuleIdentity }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import gunbc.source_layout { layout_module_storage_path }
import gunbc.rung_drop { population_arm_fits_standing, PopulationRestored, dissolved_is_admissible, RungDrop, RungDropStanding, Standing, Retired, Superseded, Dissolved, TypedDeclaration, Enumerated, PopulationDeleted, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import gunbc.rung_drop.roster { rung_drop_roster }
import gunbc.rung_drop.standing { standing_rung_drops_of, dissolved_populations_empty, superseded_loss_holders_stand }
import gunbc.design_ledgers { rung_drop_standing_suffix, rung_drop_standing_blocks }
import gunbc.rung_drop_amendment { standing_sentence }
import gunbc.rung_drop.rust_unit_tests_over_their_cap { rust_unit_tests_over_their_cap }

// A SUPERSEDED DROP NEVER RENDERS AS ONE WHOSE TRIGGER FIRED. DESIGN 4b(3) retires a drop by its
// trigger and by nothing else, so the projection's "RETIRED -- TRIGGER FIRED" is a claim that the
// trigger fired, and consumers read it that way. The red is the shape the first supersession was
// written in before this arm existed: the ruling stored in Retired.trigger_fired, rendered as
// "RETIRED -- TRIGGER FIRED. NOT BY ITS TRIGGER". Each test renders the SAME text through both arms,
// so a renderer that ignored the arm agrees with itself and is caught.

data supersession_fixture: String = "fixture ruling; fixture decision record"

fn rendered_blocks(blocks_doc: MarkdownDocument) -> String {
  serialize_markdown_source(doc: blocks_doc)
}

fn superseded_fixture_text() -> String {
  rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: Superseded {
    ruling: "fixture ruling" as NonEmptyStr,
    decision_record: "fixture decision record" as NonEmptyStr,
    loss_holder: "fixture_loss_holder" as NonEmptyStr
  }, admissible: true) })
}

fn retired_fixture_text() -> String {
  rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: Retired {
    trigger_fired: supersession_fixture as NonEmptyStr
  }, admissible: true) })
}

// RED, AND ITS CONTROL. The superseded rendering carries the ruling, the decision record and the
// loss holder and does NOT say the trigger fired; the same text through Retired does.
test fn w_RED_a_superseded_row_never_renders_as_trigger_fired() -> Bool {
  let superseded = superseded_fixture_text()
  let retired = retired_fixture_text()
  (superseded.contains("TRIGGER FIRED.") == false)
    && superseded.contains("SUPERSEDED")
    && superseded.contains("fixture ruling")
    && superseded.contains("fixture decision record")
    && superseded.contains("fixture_loss_holder")
    && retired.contains("TRIGGER FIRED.")
}

test fn the_heading_suffix_names_the_arm() -> Bool {
  rung_drop_standing_suffix(standing: Superseded {
    ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, loss_holder: "h" as NonEmptyStr
  }, admissible: true) == " · SUPERSEDED"
    && rung_drop_standing_suffix(standing: Retired { trigger_fired: "t" as NonEmptyStr }, admissible: true) == " · RETIRED"
    && rung_drop_standing_suffix(standing: Standing, admissible: true) == ""
}

// THE AMENDMENT'S CLOSING SENTENCE IS DERIVED FROM THE SAME ARM, so an amended superseded row
// cannot be closed with "has since fired" or "stands whole".
test fn the_amendment_sentence_for_a_superseded_row_says_the_trigger_did_not_fire() -> Bool {
  let s = standing_sentence(standing: Superseded {
    ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, loss_holder: "the_holder" as NonEmptyStr
  }, admissible: true)
  s.contains("did NOT fire") && s.contains("the_holder")
    && (s.contains("has since fired") == false) && (s.contains("stands whole") == false)
}

// THE LIVE ROW: the first real supersession is carried in the arm, names its loss holder, and its
// rendering does not say the trigger fired.
test fn the_live_over_cap_row_is_superseded_and_names_its_loss_holder() -> Bool {
  match rust_unit_tests_over_their_cap.standing {
    Superseded { ruling: _, decision_record: d, loss_holder: h } =>
      (h as String) == "v1_integration_tests_deleted_from_the_unit_lane"
        && (d as String).contains("msg_a8b84443")
        && (rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: rust_unit_tests_over_their_cap.standing, admissible: true) }).contains("TRIGGER FIRED.") == false)
    Standing => false
    Retired { trigger_fired: _ } => false
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => false
  }
}

// THE LOSS HOLDER JOINS TO THE ROSTER, AND IT MUST STAND. Superseded.loss_holder is a string, so the
// join in gunbc.rung_drop.standing superseded_loss_holders_stand is what keeps a typo or a rename
// from silently dropping the loss. Two reds over supplied rosters -- a holder no row names, and a
// holder whose row is itself retired -- and the live roster as the positive control.
fn holder_fixture(id: String, standing: RungDropStanding) -> RungDrop {
  RungDrop {
    identity: id as NonEmptyStr,
    subject: id,
    declared: "2026-01-01",
    standing: standing,
    declaration: TypedDeclaration {
      previous: MechanicallyPreventable,
      temporary: Mitigatable,
      reason: DeletedWithoutReplacement,
      population: Enumerated { members: FreeSemigroup { head: "fixture.population", tail: [] } },
      restoration_trigger: "fixture trigger"
    }
  }
}

fn superseded_fixture_naming(holder: String) -> RungDrop {
  holder_fixture(id: "fixture.superseded", standing: Superseded {
    ruling: "fixture ruling" as NonEmptyStr,
    decision_record: "fixture decision record" as NonEmptyStr,
    loss_holder: holder as NonEmptyStr
  })
}

test fn w_RED_a_superseded_row_naming_a_missing_holder_is_refused() -> Bool {
  let roster = [superseded_fixture_naming(holder: "fixture.holdr"), holder_fixture(id: "fixture.holder", standing: Standing)]
  let control = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: Standing)]
  (superseded_loss_holders_stand(drops: roster, roster: roster) == false)
    && superseded_loss_holders_stand(drops: control, roster: control)
}

test fn w_RED_a_superseded_row_whose_holder_does_not_stand_is_refused() -> Bool {
  let retired_holder = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: Retired { trigger_fired: "fixture fired" as NonEmptyStr })]
  let superseded_holder = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: Superseded { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, loss_holder: "fixture.superseded" as NonEmptyStr })]
  (superseded_loss_holders_stand(drops: retired_holder, roster: retired_holder) == false)
    && (superseded_loss_holders_stand(drops: superseded_holder, roster: superseded_holder) == false)
}

test fn w_RED_a_holder_named_twice_is_refused() -> Bool {
  let doubled = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: Standing), holder_fixture(id: "fixture.holder", standing: Standing)]
  superseded_loss_holders_stand(drops: doubled, roster: doubled) == false
}

// POSITIVE CONTROL OVER THE LIVE ROSTER: every live supersession's holder resolves to exactly one
// standing drop, and the roster carries at least one supersession, so the join is not vacuous.
test fn the_live_roster_loss_holders_resolve_and_stand() -> Bool {
  superseded_loss_holders_stand(drops: rung_drop_roster, roster: rung_drop_roster)
    && dissolved_populations_empty(drops: rung_drop_roster)
    && any(rung_drop_roster, d => match d.standing {
      Superseded { ruling: _, decision_record: _, loss_holder: _ } => true
      Standing => false
      Retired { trigger_fired: _ } => false
      Dissolved { ruling: _, decision_record: _, population_gone: _ } => false
    })
}

// THE DISSOLVED ARM: its rendering says the trigger did not fire and that the population is gone,
// carries no loss holder, and joins to no roster row (nothing holds the loss).
test fn a_dissolved_row_renders_as_not_fired_and_needs_no_loss_holder() -> Bool {
  let st = Dissolved { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, population_gone: "gone" as NonEmptyStr }
  let r = rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: st, admissible: true) })
  r.contains("DISSOLVED") && r.contains("gone") && (r.contains("TRIGGER FIRED.") == false)
    && rung_drop_standing_suffix(standing: st, admissible: true) == " · DISSOLVED"
    && superseded_loss_holders_stand(drops: [holder_fixture(id: "fixture.dissolved", standing: st)], roster: [holder_fixture(id: "fixture.dissolved", standing: st)])
}

// THE DISSOLVED ADMISSION LAW. RED: a Dissolved row over a non-empty typed population is refused.
// Positive control: the same row over an empty population is admitted; the live roster is checked
// by the_live_roster_loss_holders_resolve_and_stand.
test fn w_RED_a_dissolved_row_over_a_live_population_is_refused() -> Bool {
  let st = Dissolved { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, population_gone: "gone" as NonEmptyStr }
  let live = RungDrop {
    identity: "fixture.dissolved" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: Enumerated { members: FreeSemigroup { head: "still-live", tail: [] } }, restoration_trigger: "t" }
  }
  let empty = RungDrop {
    identity: "fixture.dissolved" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: PopulationDeleted { removal: fixture_tombstone() }, restoration_trigger: "t" }
  }
  (dissolved_populations_empty(drops: [live]) == false) && dissolved_populations_empty(drops: [empty])
}

// THE LAW LIVES IN THE CONSUMER, NOT ONLY THE WITNESS. RED: standing_rung_drops_of, the accounting that
// erases a loss, must still count a Dissolved row over a live population (fail closed) and must erase
// one over an empty population (the sha256 shape). Mutating dissolved_is_admissible to always admit
// makes the first conjunct fail.
test fn w_RED_the_standing_accounting_keeps_an_invalid_dissolved_row_live() -> Bool {
  let st = Dissolved { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, population_gone: "gone" as NonEmptyStr }
  let live = RungDrop {
    identity: "fixture.live" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: Enumerated { members: FreeSemigroup { head: "still-live", tail: [] } }, restoration_trigger: "t" }
  }
  let empty = RungDrop {
    identity: "fixture.empty" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: PopulationDeleted { removal: fixture_tombstone() }, restoration_trigger: "t" }
  }
  let kept = map(standing_rung_drops_of(ds: [live, empty]), d => d.identity as String)
  length(xs: filter(kept, i => i == "fixture.live")) == 1 && length(xs: filter(kept, i => i == "fixture.empty")) == 0
}

// THE RENDERERS ASK THE SAME PREDICATE AS THE ACCOUNTING. RED: a Dissolved row over a live population,
// rendered with the admissibility derived from the row, must not assert dissolution in the ledger
// heading, block or amendment sentence; the empty-population row still does.
test fn w_RED_an_invalid_dissolved_row_does_not_render_as_dissolved() -> Bool {
  let st = Dissolved { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, population_gone: "gone" as NonEmptyStr }
  let live = RungDrop {
    identity: "fixture.live" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: Enumerated { members: FreeSemigroup { head: "still-live", tail: [] } }, restoration_trigger: "t" }
  }
  let empty = RungDrop {
    identity: "fixture.empty" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: PopulationDeleted { removal: fixture_tombstone() }, restoration_trigger: "t" }
  }
  let bad = rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: live.standing, admissible: dissolved_is_admissible(drop: live)) })
  let good = rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: empty.standing, admissible: dissolved_is_admissible(drop: empty)) })
  let bad_sentence = standing_sentence(standing: live.standing, admissible: dissolved_is_admissible(drop: live))
  bad.contains("INVALID DISSOLVED") && (bad.contains("NO LONGER EXISTS") == false)
    && rung_drop_standing_suffix(standing: live.standing, admissible: dissolved_is_admissible(drop: live)) == " · INVALID DISSOLVED"
    && bad_sentence.contains("INVALID DISSOLVED") && (bad_sentence.contains("nothing remains") == false)
    && good.contains("NO LONGER EXISTS")
}


data fixture_removed_commit: CommitSha = "fa44b9810259b88f721e55ae0a3bd3cf7bc9b46f" as CommitSha

fn tombstone_over(modules: FreeSemigroup<ModuleIdentity>) -> RemovalTombstone {
  RemovalTombstone { removed_modules: modules, removed_at: fixture_removed_commit, ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr }
}

fn fixture_tombstone() -> RemovalTombstone {
  tombstone_over(modules: FreeSemigroup { head: ModuleIdentity { name: "fixture.gone" }, tail: [] })
}

fn module_looked_up(name: String, modules: List<ModuleDeclarationFact>) -> ModuleObservation {
  match layout_module_storage_path(module: name) {
    Absent => ModuleUnobservable
    Present { value: path } => if length(xs: modules) == 0 {
      ModuleUnobservable
    } else if length(xs: filter(modules, m => m.path == path)) > 0 {
      ModulePresent
    } else {
      ModuleAbsent
    }
  }
}

data tombstone_pool_roots: List<String> = ["dag", "src/v2"]

fn tree_module_observer(m: ModuleIdentity) -> ModuleObservation {
  module_looked_up(name: m.name, modules: module_declaration_facts_live(pool_roots: tombstone_pool_roots))
}

fn commit_not_observable(c: CommitSha) -> CommitObservation { CommitUnobservable }

fn supplied_modules(present: List<String>) -> fn(ModuleIdentity) -> ModuleObservation {
  m => if length(xs: filter(present, p => p == m.name)) > 0 { ModulePresent } else { ModuleAbsent }
}

// POSITIVE CONTROL + RED OF THE CONSUMER, over supplied observations. A named module still present
// must refuse as RemovedModuleStillExists; all absent with a resolving commit holds; an unobservable
// module or commit is a typed verdict and never Holds.
test fn w_RED_a_tombstone_naming_a_still_present_module_refuses() -> Bool {
  let t = tombstone_over(modules: FreeSemigroup { head: ModuleIdentity { name: "a.gone" }, tail: [ModuleIdentity { name: "a.back" }] })
  let resolves = (c => CommitResolves)
  let held = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: resolves)
  let refused = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: ["a.back"]), observe_commit: resolves)
  let blind = removal_tombstone_verdict(tombstone: t, observe_module: (m => ModuleUnobservable), observe_commit: resolves)
  let missing = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: (c => CommitDoesNotResolve))
  let unseen = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: commit_not_observable)
  (match held { RemovalHolds => true  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match refused { RemovalHolds => false  RemovedModuleStillExists { module: m } => m.name == "a.back"  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match blind { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => true  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match missing { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => true  RemovalCommitUnobservable => false })
    && (match unseen { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => true })
}

// THE STANDING FIXES THE ARM. RED: a Retired row over PopulationDeleted and a Dissolved row over
// PopulationRestored must each refuse; the paired arms are the controls.
test fn w_RED_a_population_arm_under_the_wrong_standing_is_refused() -> Bool {
  let retired = Retired { trigger_fired: "fired" as NonEmptyStr }
  let dissolved = Dissolved { ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr, population_gone: "gone" as NonEmptyStr }
  let row = (st, pop) => RungDrop {
    identity: "fixture.arm" as NonEmptyStr, subject: "s", declared: "2026-01-01", standing: st,
    declaration: TypedDeclaration { previous: MechanicallyPreventable, temporary: Mitigatable, reason: DeletedWithoutReplacement, population: pop, restoration_trigger: "t" }
  }
  let deleted = PopulationDeleted { removal: fixture_tombstone() }
  (population_arm_fits_standing(d: row(retired, deleted)) == false)
    && (population_arm_fits_standing(d: row(dissolved, PopulationRestored)) == false)
    && population_arm_fits_standing(d: row(retired, PopulationRestored))
    && population_arm_fits_standing(d: row(dissolved, deleted))
    && (dissolved_populations_empty(drops: [row(retired, deleted)]) == false)
    && (dissolved_populations_empty(drops: [row(dissolved, PopulationRestored)]) == false)
    && dissolved_populations_empty(drops: [row(dissolved, deleted)])
}

// THE LIVE ROSTER'S TOMBSTONES AGAINST THE EVALUATED TREE. The observer reads the corpus through
// the storage lookup; a module that is present (gunbc.rung_drop) must read ModulePresent, so an
// observer that answers Absent for everything cannot pass. The commit half is typed unobservable:
// a claim has no git, so Holds is not claimed here.
test fn the_live_roster_tombstones_name_modules_absent_from_the_tree() -> Bool {
  let present = tree_module_observer(ModuleIdentity { name: "gunbc.rung_drop" })
  let dissolved = filter(rung_drop_roster, d => match d.standing {
    Standing => false
    Retired { trigger_fired: _ } => false
    Superseded { ruling: _, decision_record: _, loss_holder: _ } => false
    Dissolved { ruling: _, decision_record: _, population_gone: _ } => true
  })
  let verdicts = map(dissolved, d => match d.declaration {
    TypedDeclaration { previous: _, temporary: _, reason: _, population: p, restoration_trigger: _ } => match p {
      PopulationDeleted { removal: t } => match removal_tombstone_verdict(tombstone: t, observe_module: tree_module_observer, observe_commit: commit_not_observable) {
        RemovalCommitUnobservable => true
        RemovalHolds => false
        RemovedModuleStillExists { module: _ } => false
        RemovedModuleUnobservable { module: _ } => false
        RemovalCommitDoesNotResolve => false
      }
      Enumerated { members: _ } => false
      DerivedBy { label: _ } => false
      NotYetCounted { cause: _ } => false
      PopulationRestored => false
    }
    AuthoredProse { legacy: _, authored: _ } => false
  })
  (match present { ModulePresent => true  ModuleAbsent => false  ModuleUnobservable => false })
    && length(xs: verdicts) == 2 && all(verdicts, v => v)
}
