module test.claim.rung_drop_superseded_standing_witness

import std.types { String, Bool, NonEmptyStr, List, CommitSha }
import std.algebra { FreeSemigroup }
import std.markdown { MarkdownDocument }
import extdeps.languages.markdown { serialize_markdown_source }
import std.optional { Optional, Present, Absent }
import std.removal_tombstone { RemovalTombstone, RemovalVerdict, RemovalHolds, RemovedModuleStillExists, RemovedModuleUnobservable, RemovalCommitDoesNotResolve, RemovalCommitUnobservable, ModuleObservation, ModulePresent, ModuleAbsent, ModuleUnobservable, CommitObservation, CommitResolves, CommitDoesNotResolve, CommitUnobservable, removal_tombstone_verdict }
import v2.lens.module_impact_query { ModuleIdentity }
import gunbc.source_layout { layout_module_storage_path }
import v2.lens.module_graph { ModuleDeclarationFact, module_declaration_facts_live }
import gunbc.compile_census_probe { total_blocking_census, census_delta_verdict, CensusHeld, CensusDisagreed, CensusUnobserved }
import gunbc.rung_drop { rung_drop_population, RungDrop, RungDropStanding, Standing, Retired, Superseded, Dissolved, TypedDeclaration, EndedTypedDeclaration, RetiredTypedDeclaration, NotYetCounted, MembersNeverEnumeratedBeforeRetirement, rung_drop_population_at_retirement, rung_drop_population_label, rung_drop_declaration_message, RungDropPopulation, Enumerated, DeletedWithoutReplacement }
import gunbc.guarantee_rung { Mitigatable, MechanicallyPreventable }
import gunbc.rung_drop.roster { rung_drop_roster }
import gunbc.rung_drop.standing { standing_rung_drops_of, superseded_loss_holders_stand }
import gunbc.design_ledgers { rung_drop_standing_suffix, rung_drop_standing_blocks }
import gunbc.rung_drop_amendment { standing_sentence }
import gunbc.rung_drop.rust_unit_tests_over_their_cap { rust_unit_tests_over_their_cap }

// A SUPERSEDED DROP NEVER RENDERS AS ONE WHOSE TRIGGER FIRED. DESIGN 4b(3) retires a drop by its
// trigger and by nothing else, so the projection's "RETIRED -- TRIGGER FIRED" is a claim that the
// trigger fired, and consumers read it that way. The red is the shape the first supersession was
// written in before this arm existed: the ruling stored in Retired.trigger_fired, rendered as
// "RETIRED -- TRIGGER FIRED. NOT BY ITS TRIGGER". Each test renders the SAME text through both arms,
// so a renderer that ignored the arm agrees with itself and is caught.

data supersession_fixture: String = "fixture ruling; fixture decision record"

data fixture_live: TypedDeclaration = TypedDeclaration {
  previous: MechanicallyPreventable,
  temporary: Mitigatable,
  reason: DeletedWithoutReplacement,
  population: Enumerated { members: FreeSemigroup { head: "fixture.population", tail: [] } },
  restoration_trigger: "fixture trigger"
}

data fixture_retired: RetiredTypedDeclaration = RetiredTypedDeclaration {
  previous: MechanicallyPreventable,
  temporary: Mitigatable,
  reason: DeletedWithoutReplacement,
  population_at_retirement: Enumerated { members: FreeSemigroup { head: "fixture.retired.member", tail: [] } },
  restoration_trigger: "fixture trigger"
}

data fixture_ended: EndedTypedDeclaration = EndedTypedDeclaration {
  previous: MechanicallyPreventable,
  temporary: Mitigatable,
  reason: DeletedWithoutReplacement,
  restoration_trigger: "fixture trigger"
}

fn rendered_blocks(blocks_doc: MarkdownDocument) -> String {
  serialize_markdown_source(doc: blocks_doc)
}

fn superseded_fixture() -> RungDropStanding {
  Superseded {
    ruling: "fixture ruling" as NonEmptyStr,
    decision_record: "fixture decision record" as NonEmptyStr,
    loss_holder: "fixture_loss_holder" as NonEmptyStr,
    declaration: fixture_live
  }
}

fn retired_fixture() -> RungDropStanding {
  Retired { trigger_fired: supersession_fixture as NonEmptyStr, declaration: fixture_retired }
}

// A SUPERSEDED ROW KEEPS ITS LIVE DECLARATION: it is still a loss somebody holds, so its population
// stays readable; a RETIRED row's declaration is the population-free ended form.
fn superseded_fixture_text() -> String {
  rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: superseded_fixture()) })
}

fn retired_fixture_text() -> String {
  rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: retired_fixture()) })
}

// RED, AND ITS CONTROL. The superseded rendering carries the ruling, the decision record and the
// loss holder and does NOT say the trigger fired; the same text through Retired does.
test fn w_RED_a_superseded_row_never_renders_as_trigger_fired() -> Bool {
  let superseded = superseded_fixture_text()
  let retired = retired_fixture_text()
  (superseded.contains("TRIGGER FIRED.") == false)
    && superseded.contains("SUPERSEDED")
    && superseded.contains("fixture ruling")
    && superseded.contains("fixture decision record")
    && superseded.contains("fixture_loss_holder")
    && retired.contains("TRIGGER FIRED.")
}

test fn the_heading_suffix_names_the_arm() -> Bool {
  rung_drop_standing_suffix(standing: superseded_fixture()) == " · SUPERSEDED"
    && rung_drop_standing_suffix(standing: retired_fixture()) == " · RETIRED"
    && rung_drop_standing_suffix(standing: Standing { declaration: fixture_live }) == ""
}

// THE AMENDMENT'S CLOSING SENTENCE IS DERIVED FROM THE SAME ARM, so an amended superseded row
// cannot be closed with "has since fired" or "stands whole".
test fn the_amendment_sentence_for_a_superseded_row_says_the_trigger_did_not_fire() -> Bool {
  let s = standing_sentence(standing: superseded_fixture())
  s.contains("did NOT fire") && s.contains("fixture_loss_holder")
    && (s.contains("has since fired") == false) && (s.contains("stands whole") == false)
}

// THE LIVE ROW: the first real supersession is carried in the arm, names its loss holder, and its
// rendering does not say the trigger fired.
test fn the_live_over_cap_row_is_superseded_and_names_its_loss_holder() -> Bool {
  match rust_unit_tests_over_their_cap.standing {
    Superseded { ruling: _, decision_record: d, loss_holder: h, declaration: _ } =>
      (h as String) == "v1_integration_tests_deleted_from_the_unit_lane"
        && (d as String).contains("msg_a8b84443")
        && (rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: rust_unit_tests_over_their_cap.standing) }).contains("TRIGGER FIRED.") == false)
    Standing { declaration: _ } => false
    Retired { trigger_fired: _, declaration: _ } => false
    Dissolved { removal: _, declaration: _ } => false
  }
}

// THE LOSS HOLDER JOINS TO THE ROSTER, AND IT MUST STAND. Superseded.loss_holder is a string, so the
// join in gunbc.rung_drop.standing superseded_loss_holders_stand is what keeps a typo or a rename
// from silently dropping the loss. Two reds over supplied rosters -- a holder no row names, and a
// holder whose row is itself retired -- and the live roster as the positive control.
fn holder_fixture(id: String, standing: RungDropStanding) -> RungDrop {
  RungDrop { identity: id as NonEmptyStr, subject: id, declared: "2026-01-01", standing: standing }
}

fn standing_holder(id: String) -> RungDrop {
  holder_fixture(id: id, standing: Standing { declaration: fixture_live })
}

fn superseded_fixture_naming(holder: String) -> RungDrop {
  holder_fixture(id: "fixture.superseded", standing: Superseded {
    ruling: "fixture ruling" as NonEmptyStr,
    decision_record: "fixture decision record" as NonEmptyStr,
    loss_holder: holder as NonEmptyStr,
    declaration: fixture_live
  })
}

test fn w_RED_a_superseded_row_naming_a_missing_holder_is_refused() -> Bool {
  let roster = [superseded_fixture_naming(holder: "fixture.holdr"), standing_holder(id: "fixture.holder")]
  let control = [superseded_fixture_naming(holder: "fixture.holder"), standing_holder(id: "fixture.holder")]
  (superseded_loss_holders_stand(drops: roster, roster: roster) == false)
    && superseded_loss_holders_stand(drops: control, roster: control)
}

test fn w_RED_a_superseded_row_whose_holder_does_not_stand_is_refused() -> Bool {
  let retired_holder = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: retired_fixture())]
  let superseded_holder = [superseded_fixture_naming(holder: "fixture.holder"), holder_fixture(id: "fixture.holder", standing: superseded_fixture())]
  (superseded_loss_holders_stand(drops: retired_holder, roster: retired_holder) == false)
    && (superseded_loss_holders_stand(drops: superseded_holder, roster: superseded_holder) == false)
}

test fn w_RED_a_holder_named_twice_is_refused() -> Bool {
  let doubled = [superseded_fixture_naming(holder: "fixture.holder"), standing_holder(id: "fixture.holder"), standing_holder(id: "fixture.holder")]
  superseded_loss_holders_stand(drops: doubled, roster: doubled) == false
}

// POSITIVE CONTROL OVER THE LIVE ROSTER: every live supersession's holder resolves to exactly one
// standing drop, and the roster carries at least one supersession, so the join is not vacuous.
test fn the_live_roster_loss_holders_resolve_and_stand() -> Bool {
  superseded_loss_holders_stand(drops: rung_drop_roster, roster: rung_drop_roster)
    && any(rung_drop_roster, d => match d.standing {
      Superseded { ruling: _, decision_record: _, loss_holder: _, declaration: _ } => true
      Standing { declaration: _ } => false
      Retired { trigger_fired: _, declaration: _ } => false
      Dissolved { removal: _, declaration: _ } => false
    })
}

// THE DISSOLVED ARM: its rendering says the trigger did not fire and that the population is gone,
// carries no loss holder, and joins to no roster row (nothing holds the loss). The removal is the
// typed tombstone, never a sentence beside the arm.
test fn a_dissolved_row_renders_as_not_fired_and_needs_no_loss_holder() -> Bool {
  let st = Dissolved { removal: fixture_tombstone(), declaration: fixture_ended }
  let r = rendered_blocks(blocks_doc: MarkdownDocument { blocks: rung_drop_standing_blocks(standing: st) })
  let row = holder_fixture(id: "fixture.dissolved", standing: st)
  r.contains("DISSOLVED") && r.contains("NO LONGER EXISTS") && (r.contains("TRIGGER FIRED.") == false)
    && rung_drop_standing_suffix(standing: st) == " · DISSOLVED"
    && superseded_loss_holders_stand(drops: [row], roster: [row])
}

// THE POPULATION EXISTS ONLY WHERE A LOSS IS STILL HELD. Positive: a Standing and a Superseded row
// read their population; RED: a Retired and a Dissolved row have none to read, so the accessor
// answers Absent for them and a consumer cannot mistake a deleted population for an empty one.
fn at_retirement_is_kept(d: RungDrop) -> Bool {
  match rung_drop_population_at_retirement(d: d) {
    Present { value: p } => rung_drop_population_label(p: p) == "fixture.retired.member"
    Absent => false
  }
}

// THE RETIRED ARM KEEPS WHAT IT RECORDED: its members are readable at retirement and the one
// rendering shows them, where a Retired row used to print nothing after this rework dropped them.
test fn a_retired_row_keeps_its_population_at_retirement() -> Bool {
  rung_drop_declaration_message(d: holder_fixture(id: "fixture.retired", standing: retired_fixture())).contains("Population: fixture.retired.member")
}

test fn only_a_standing_or_superseded_row_has_a_population() -> Bool {
  let has = (d => match rung_drop_population(d: d) { Present { value: _ } => true  Absent => false })
  has(standing_holder(id: "fixture.standing"))
    && has(superseded_fixture_naming(holder: "fixture.holder"))
    && (has(holder_fixture(id: "fixture.retired", standing: retired_fixture())) == false)
    && at_retirement_is_kept(d: holder_fixture(id: "fixture.retired", standing: retired_fixture()))
    && (at_retirement_is_kept(d: standing_holder(id: "fixture.standing")) == false)
    && (has(holder_fixture(id: "fixture.dissolved", standing: Dissolved { removal: fixture_tombstone(), declaration: fixture_ended })) == false)
}

// THE ACCOUNTING THAT ERASES A LOSS COUNTS ONLY THE STANDING ROWS: a Dissolved row, whose population
// is gone, and a Retired and a Superseded row are not standing; the Standing row is.
test fn the_standing_accounting_counts_only_standing_rows() -> Bool {
  let dissolved = holder_fixture(id: "fixture.dissolved", standing: Dissolved { removal: fixture_tombstone(), declaration: fixture_ended })
  let kept = map(standing_rung_drops_of(ds: [standing_holder(id: "fixture.live"), dissolved, holder_fixture(id: "fixture.retired", standing: retired_fixture()), superseded_fixture_naming(holder: "fixture.live")]), d => d.identity as String)
  length(xs: kept) == 1 && length(xs: filter(kept, i => i == "fixture.live")) == 1
}

// THE FORBIDDEN STATES ARE UNWRITABLE, AND THIS IS THE RED THAT SAYS SO. Handed to the compiler as
// source, a population on a Dissolved row, and a population spelled in an AuthoredProse
// declaration, are each refused; the same rows without the extra field compile clean. Counted as
// TOTAL blocking rows, with the control as the baseline, so a refusal for an unrelated cause in the
// shared import closure cannot pass as this one: the RED must exceed its own control.
fn dissolved_source(extra_field: String) -> String {
  "module probe_dissolved_population\nimport std.types { NonEmptyStr, CommitSha }\nimport std.algebra { FreeSemigroup }\nimport std.removal_tombstone { RemovalTombstone }\nimport v2.lens.module_impact_query { ModuleIdentity }\nimport gunbc.guarantee_rung { Mitigatable }\nimport gunbc.rung_drop { RungDrop, Dissolved, EndedTypedDeclaration, DeletedWithoutReplacement, Enumerated }\ndata probe_row: RungDrop = RungDrop {\n  identity: \"probe\" as NonEmptyStr,\n  subject: \"s\",\n  declared: \"2026-01-01\",\n  standing: Dissolved {\n    removal: RemovalTombstone { removed_modules: FreeSemigroup { head: ModuleIdentity { name: \"a.gone\" }, tail: [] }, removed_at: \"fa44b9810259b88f721e55ae0a3bd3cf7bc9b46f\" as CommitSha, ruling: \"r\" as NonEmptyStr, decision_record: \"d\" as NonEmptyStr },\n    declaration: EndedTypedDeclaration { previous: Mitigatable, temporary: Mitigatable, reason: DeletedWithoutReplacement, " + extra_field + "restoration_trigger: \"t\" }\n  }\n}\n"
}

fn prose_source(extra_field: String) -> String {
  "module probe_prose_population\nimport std.types { NonEmptyStr }\nimport std.algebra { FreeSemigroup }\nimport gunbc.rung_drop { RungDrop, Standing, AuthoredProse, FloorCutFalsifierCadence, Enumerated }\ndata probe_row: RungDrop = RungDrop {\n  identity: \"probe\" as NonEmptyStr,\n  subject: \"s\",\n  declared: \"2026-01-01\",\n  standing: Standing { declaration: AuthoredProse { legacy: FloorCutFalsifierCadence, " + extra_field + "authored: \"a\" } }\n}\n"
}

data probe_population_field: String = "population: Enumerated { members: FreeSemigroup { head: \"x\", tail: [] } }, "

test fn w_RED_a_population_on_a_dissolved_row_is_a_compile_refusal() -> Bool {
  let control = total_blocking_census(source: dissolved_source(extra_field: ""))
  let red = total_blocking_census(source: dissolved_source(extra_field: probe_population_field))
  match census_delta_verdict(red: red, control: control, holds: fn(n) { n > 0 }) {
    CensusHeld {} => true
    CensusDisagreed { reason: _ } => false
    CensusUnobserved { cause: _ } => false
  }
}

test fn w_RED_an_authored_prose_row_cannot_spell_a_population() -> Bool {
  let control = total_blocking_census(source: prose_source(extra_field: ""))
  let red = total_blocking_census(source: prose_source(extra_field: probe_population_field))
  match census_delta_verdict(red: red, control: control, holds: fn(n) { n > 0 }) {
    CensusHeld {} => true
    CensusDisagreed { reason: _ } => false
    CensusUnobserved { cause: _ } => false
  }
}

data fixture_removed_commit: CommitSha = "fa44b9810259b88f721e55ae0a3bd3cf7bc9b46f" as CommitSha

fn tombstone_over(modules: FreeSemigroup<ModuleIdentity>) -> RemovalTombstone {
  RemovalTombstone { removed_modules: modules, removed_at: fixture_removed_commit, ruling: "r" as NonEmptyStr, decision_record: "d" as NonEmptyStr }
}

fn fixture_tombstone() -> RemovalTombstone {
  tombstone_over(modules: FreeSemigroup { head: ModuleIdentity { name: "fixture.gone" }, tail: [] })
}

fn module_looked_up(name: String, modules: List<ModuleDeclarationFact>) -> ModuleObservation {
  match layout_module_storage_path(module: name) {
    Absent => ModuleUnobservable
    Present { value: path } => if length(xs: modules) == 0 {
      ModuleUnobservable
    } else if length(xs: filter(modules, m => m.path == path)) > 0 {
      ModulePresent
    } else {
      ModuleAbsent
    }
  }
}

data tombstone_pool_roots: List<String> = ["dag", "src/v2"]

fn tree_module_observer(m: ModuleIdentity) -> ModuleObservation {
  module_looked_up(name: m.name, modules: module_declaration_facts_live(pool_roots: tombstone_pool_roots))
}

fn commit_not_observable(c: CommitSha) -> CommitObservation { CommitUnobservable }

fn supplied_modules(present: List<String>) -> fn(ModuleIdentity) -> ModuleObservation {
  m => if length(xs: filter(present, p => p == m.name)) > 0 { ModulePresent } else { ModuleAbsent }
}

// POSITIVE CONTROL + RED OF THE CONSUMER, over supplied observations. A named module still present
// must refuse as RemovedModuleStillExists; all absent with a resolving commit holds; an unobservable
// module or commit is a typed verdict and never Holds.
test fn w_RED_a_tombstone_naming_a_still_present_module_refuses() -> Bool {
  let t = tombstone_over(modules: FreeSemigroup { head: ModuleIdentity { name: "a.gone" }, tail: [ModuleIdentity { name: "a.back" }] })
  let resolves = (c => CommitResolves)
  let held = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: resolves)
  let refused = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: ["a.back"]), observe_commit: resolves)
  let blind = removal_tombstone_verdict(tombstone: t, observe_module: (m => ModuleUnobservable), observe_commit: resolves)
  let missing = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: (c => CommitDoesNotResolve))
  let unseen = removal_tombstone_verdict(tombstone: t, observe_module: supplied_modules(present: []), observe_commit: commit_not_observable)
  (match held { RemovalHolds => true  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match refused { RemovalHolds => false  RemovedModuleStillExists { module: m } => m.name == "a.back"  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match blind { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => true  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => false })
    && (match missing { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => true  RemovalCommitUnobservable => false })
    && (match unseen { RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false  RemovalCommitUnobservable => true })
}

// THE LIVE DISSOLVED ROWS ARE CHECKED AGAINST THE TREE: each live tombstone names modules the tree no
// longer holds, and with no commit observation the verdict is the typed RemovalCommitUnobservable,
// never Holds; at least one row is required so the fold is not vacuous, and the count is not copied from the tree.
test fn the_live_roster_tombstones_name_only_absent_modules() -> Bool {
  let verdicts = flat_map(rung_drop_roster, d => match d.standing {
    Dissolved { removal: t, declaration: _ } => [removal_tombstone_verdict(tombstone: t, observe_module: tree_module_observer, observe_commit: commit_not_observable)]
    Standing { declaration: _ } => []
    Retired { trigger_fired: _, declaration: _ } => []
    Superseded { ruling: _, decision_record: _, loss_holder: _, declaration: _ } => []
  })
  length(xs: verdicts) >= 1
    && length(xs: filter(verdicts, v => match v { RemovalCommitUnobservable => true  RemovalHolds => false  RemovedModuleStillExists { module: _ } => false  RemovedModuleUnobservable { module: _ } => false  RemovalCommitDoesNotResolve => false })) == length(xs: verdicts)
}
