module test.claim.ledger_tail_liveness_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn verdict_of(tail: std.observation.LedgerTail, liveness: std.observation.ProducerState) -> std.observation.LedgerTailVerdict {
  classify_ledger_tail(observed: probe_liveness_for(tail: tail, observed: liveness))
}

fn is_torn(v: std.observation.LedgerTailVerdict) -> Bool {
  match v { TailTorn { bytes: _ } => true, _ => false }
}

fn is_pending(v: std.observation.LedgerTailVerdict) -> Bool {
  match v { TailPending { bytes: _ } => true, _ => false }
}

fn is_indeterminate(v: std.observation.LedgerTailVerdict) -> Bool {
  match v { TailIndeterminate { bytes: _, cause: _ } => true, _ => false }
}

// THE DISCRIMINATING PAIR: identical tail bytes, different producer state, different verdict. If
// these two ever agree, the reader is deciding from the file alone and the discriminator is gone.
test fn w_identical_torn_bytes_classify_by_producer_state_not_by_content() -> Bool {
  let dead = test.claim.ledger_tail_liveness_witness.verdict_of(tail: std.observation.TailIncomplete { bytes: 41 }, liveness: ProducerDead)
  let live = test.claim.ledger_tail_liveness_witness.verdict_of(tail: std.observation.TailIncomplete { bytes: 41 }, liveness: ProducerLive)
  is_torn(v: dead) && is_pending(v: live)
}

// The third arm is its own verdict. Collapsing it into Dead reports a torn record on a healthy run;
// collapsing it into Live hangs `explain` on a finished one.
test fn w_RED_unknown_liveness_is_neither_torn_nor_pending() -> Bool {
  let unknown = test.claim.ledger_tail_liveness_witness.verdict_of(
    tail: std.observation.TailIncomplete { bytes: 41 },
    liveness: std.observation.ProducerLivenessUnknown { cause: "explain: no child handle for this producer" }
  )
  is_indeterminate(v: unknown) && !is_torn(v: unknown) && !is_pending(v: unknown)
}

// A complete tail is complete regardless of liveness — the producer's state cannot make a finished
// record unfinished.
test fn w_RED_a_complete_tail_is_complete_under_every_liveness() -> Bool {
  let d = test.claim.ledger_tail_liveness_witness.verdict_of(tail: TailComplete, liveness: ProducerDead)
  let l = test.claim.ledger_tail_liveness_witness.verdict_of(tail: TailComplete, liveness: ProducerLive)
  let u = test.claim.ledger_tail_liveness_witness.verdict_of(tail: TailComplete, liveness: std.observation.ProducerLivenessUnknown { cause: "no handle" })
  match d { TailRecordsComplete => true, _ => false }
    && match l { TailRecordsComplete => true, _ => false }
    && match u { TailRecordsComplete => true, _ => false }
}

// The torn byte count is CARRIED, not discarded: the tail is where the last active occurrence
// lives, so a reader that drops it silently is the empty-observation narrow at the file layer.
test fn w_RED_the_torn_byte_count_survives_classification() -> Bool {
  match test.claim.ledger_tail_liveness_witness.verdict_of(tail: std.observation.TailIncomplete { bytes: 41 }, liveness: ProducerDead) {
    TailTorn { bytes: n } => n == 41
    _ => false
  }
}

// THE SEAL, asserted rather than assumed. probe_liveness_for is the sole mint and it takes the tail,
// so a ProducerLiveness cannot exist before a LedgerTail does — the check-first sequence has no
// value to construct. This witness pins the mint's shape; a refactor that let liveness be built
// without a tail would have to change this signature to keep it compiling.
test fn w_the_only_route_to_a_liveness_value_carries_the_tail_it_was_probed_against() -> Bool {
  let l = probe_liveness_for(tail: std.observation.TailIncomplete { bytes: 41 }, observed: ProducerDead)
  match l.tail_witnessed { TailIncomplete { bytes: n } => n == 41, _ => false }
}
