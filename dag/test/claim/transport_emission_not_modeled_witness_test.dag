module test.claim.transport_emission_not_modeled_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Permanent regression control for `transport file` EMISSION, and for the refusals that survive
// it. DESIGN 4b(4): a climb deletes the production machinery it obsoletes, but the discriminating
// RED and its positive control stay enrolled -- an expecting-red probe that greens when its wall
// lands flips to a permanent regression control, it does not retire. That is what happened here.
//
// The history in two steps. #8858 found that three per-target renderers each fabricated a read of
// `base_path + "/" + operation_name` for EVERY file operation, so a declared Write emitted a read
// of a path the declaration never named, dropped its `content` argument, and returned a String
// against a declared bool. All three were deleted and every file operation refused; this file
// asserted those refusals. The refusal is now LIFTED for Rust, the only target with a realization
// row bound, so the three file rows below assert emission -- and, critically, assert it is clean
// of every blocking diagnostic rather than merely free of the old one.
//
// The reds did not disappear, they moved to the conditions that genuinely cannot be emitted, and
// each is authored here because each was reachable the moment the handler was bound: a verb
// outside the closed roster, an output field bound to a channel the realization does not produce,
// and a `transport file` with no path -- which the parser does not reject, it substitutes an empty
// string literal, so without this row the handler would emit a write to "" and call it a
// realization.
//
// The two shell/rest rows are NOT decoration. Without them this file cannot distinguish "the file
// arm behaves" from "the transport dispatch is broken for everything", which is the failure mode
// that would make a green suite defend a total outage.
data file_transport_source: String = "module tfx_file\nservice Fs \{\n  operation Write \{\n    input \{ path: String, content: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Delete \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"delete\" \}\n  \}\n\}\n"

data rest_and_shell_source: String = "module tfx_ok\nservice Sh \{\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n\}\n\nservice Net \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n\}\n"

data mixed_transport_source: String = "module tfx_mixed\nservice Mixed \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

data verb_outside_roster_source: String = "module tfx_verb\nservice Fs \{\n  operation Chown \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"chown\" \}\n  \}\n\}\n"

data unproduced_channel_source: String = "module tfx_chan\nservice Fs \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ out: String from \"stdout\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

data pathless_file_source: String = "module tfx_nopath\nservice Fs \{\n  operation List \{\n    input \{ path: String \}\n    output \{ entries: String from \"content\" \}\n    readonly\n    transport file \{ verb: \"list\" \}\n  \}\n\}\n"

fn not_modeled_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TransportEmissionNotModeled")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn blocking_diagnostic_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_file_transport_operations_emit_for_the_bound_target() -> Bool {
  not_modeled_blocking_count(source: file_transport_source) == 0
}

// Stronger than the row above and the reason the pair exists: a handler that emitted SOMETHING
// while tripping a different blocking diagnostic would satisfy the count above and fail here.
test fn w_file_transport_operations_are_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: file_transport_source) == 0
}

test fn w_rest_and_shell_transports_emit_without_refusal() -> Bool {
  not_modeled_blocking_count(source: rest_and_shell_source) == 0
}

test fn w_rest_and_shell_transports_are_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: rest_and_shell_source) == 0
}

test fn w_file_operation_emits_beside_its_rest_and_shell_siblings() -> Bool {
  blocking_diagnostic_count(source: mixed_transport_source) == 0
}

test fn w_verb_outside_the_closed_roster_refuses() -> Bool {
  not_modeled_blocking_count(source: verb_outside_roster_source) == 1
}

test fn w_output_channel_the_realization_does_not_produce_refuses() -> Bool {
  not_modeled_blocking_count(source: unproduced_channel_source) == 1
}

test fn w_file_transport_without_a_path_refuses() -> Bool {
  not_modeled_blocking_count(source: pathless_file_source) == 1
}
