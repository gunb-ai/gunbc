module test.claim.transport_emission_not_modeled_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Permanent regression control for the `transport file` emission class, RETARGETED when the
// #8858 next-rung trigger fired (DESIGN §4b(4): a climb deletes the production machinery it
// obsoletes, but the discriminating RED and its positive control STAY ENROLLED as the executing
// evidence that the higher rung is still real -- deleting the evidence with the machinery would
// recreate specification-without-execution one rung up; an expecting-red probe that greens when
// its wall lands FLIPS to a permanent regression control, it does not retire).
//
// WHAT CHANGED, AND WHY THESE ASSERTIONS MOVED. #8858 refused EVERY file operation on every
// target, so this file asserted "three file operations, three refusals". The transport-binding
// consolidation binds an operation's meaning once, target-neutrally, and the Rust backend now
// renders a bound file operation -- so a WELL-FORMED file operation emits, and its refusal count
// is now zero. Asserting 3 here would pin the wall in place and make the climb unlandable; that
// is why the number moved, and the fixture below is unchanged so the move is legible as a
// behavior change rather than a fixture edit.
//
// THE CLASS IS NOT RETIRED, and the rows below are what keeps that honest. The census compiles
// to Rust (cli_run compile_dag_diagnostic_census), so these rows read the Rust backend:
//
//   - a well-formed file operation EMITS                     -> zero refusals   (the climb)
//   - a file operation the binding cannot bind still REFUSES -> one per operation (the wall)
//
// The second set is the discriminating RED. Without it a binding that bound anything at all --
// including nonsense -- would pass this file, which is precisely the fabrication #8858 deleted.
//
// The rest/shell rows are NOT decoration. Without them this file cannot distinguish "the file
// arm behaves" from "the transport dispatch is broken for everything", which is the failure mode
// that would make a green suite defend a total outage.
data transport_emission_not_modeled_witness_note: String = "Paired control for the file-transport emission class via compile_dag_diagnostic_census, retargeted at the transport-binding consolidation. A well-formed `transport file` operation must now EMIT for Rust with zero TransportEmissionNotModeled rows; an operation the binding cannot bind -- unknown verb, omitted path, write with no content input, output field naming a channel the file realization does not produce -- must still refuse with exactly one counted row. Rest and shell operations must remain unaffected, both alone and when declared beside a file operation in the same module. The mixed rows are the discriminator: they pin both the emission and the refusal to the OPERATION rather than to the service or the module."

data file_transport_source: String = "module tfx_file\nservice Fs \{\n  operation Write \{\n    input \{ path: String, content: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Delete \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"delete\" \}\n  \}\n\}\n"

data rest_and_shell_source: String = "module tfx_ok\nservice Sh \{\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n\}\n\nservice Net \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n\}\n"

data mixed_transport_source: String = "module tfx_mixed\nservice Mixed \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

// The four ways the binding refuses, one operation each. Each is authorable today.
//
// The OMITTED-PATH row is the sharpest of the four and is not a hypothetical: the parser
// SUBSTITUTES an empty string literal when `path:` is absent rather than refusing, so a handler
// that trusted what it was handed would emit a write to "" and report it as a successful
// realization. A binding boundary can be perfectly target-neutral and still produce that, because
// the fabrication happens upstream of it -- which is why the binding checks the value it receives
// is nonempty rather than merely present. The parser's own fabrication is a separate defect and
// is NOT fixed here; this row is the wall that stops it reaching an emitted program.
data unbindable_unknown_verb_source: String = "module tfx_verb\nservice Fs \{\n  operation Frobnicate \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\", verb: \"frobnicate\" \}\n  \}\n\}\n"

data unbindable_omitted_path_source: String = "module tfx_nopath\nservice Fs \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ verb: \"read\" \}\n  \}\n\}\n"

data unbindable_write_without_content_source: String = "module tfx_nocontent\nservice Fs \{\n  operation Write \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"write\" \}\n  \}\n\}\n"

data unbindable_unknown_channel_source: String = "module tfx_chan\nservice Fs \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"stdout_lines\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

// The refusal discriminator at operation grain: one bindable and one unbindable file operation in
// ONE service. Exactly one row must be minted. A wall that refused the whole service, or the whole
// module, or the whole transport kind, goes red here while every single-operation row above stays
// green -- which is the failure this row exists to catch.
data mixed_bindable_and_unbindable_source: String = "module tfx_both\nservice Fs \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Frobnicate \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\", verb: \"frobnicate\" \}\n  \}\n\}\n"

fn not_modeled_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TransportEmissionNotModeled")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn blocking_diagnostic_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_well_formed_file_operations_now_emit_for_rust() -> Bool {
  not_modeled_blocking_count(source: file_transport_source) == 0
}

test fn w_well_formed_file_operations_are_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: file_transport_source) == 0
}

test fn w_rest_and_shell_transports_emit_without_refusal() -> Bool {
  not_modeled_blocking_count(source: rest_and_shell_source) == 0
}

test fn w_rest_and_shell_transports_are_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: rest_and_shell_source) == 0
}

test fn w_a_bindable_file_operation_beside_rest_and_shell_is_clean() -> Bool {
  blocking_diagnostic_count(source: mixed_transport_source) == 0
}

test fn w_unknown_verb_refuses() -> Bool {
  not_modeled_blocking_count(source: unbindable_unknown_verb_source) == 1
}

test fn w_omitted_path_refuses_rather_than_writing_the_empty_path() -> Bool {
  not_modeled_blocking_count(source: unbindable_omitted_path_source) == 1
}

test fn w_write_without_a_content_input_refuses() -> Bool {
  not_modeled_blocking_count(source: unbindable_write_without_content_source) == 1
}

test fn w_output_field_naming_an_unproduced_channel_refuses() -> Bool {
  not_modeled_blocking_count(source: unbindable_unknown_channel_source) == 1
}

test fn w_only_the_unbindable_operation_refuses_among_its_siblings() -> Bool {
  not_modeled_blocking_count(source: mixed_bindable_and_unbindable_source) == 1
}
