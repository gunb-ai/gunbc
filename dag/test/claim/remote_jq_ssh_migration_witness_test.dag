module test.claim.remote_jq_ssh_migration_witness

import std.algebra { Empty }
import std.types { Bool, NonEmptyStr, Secret, String }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.optional { Absent, Optional, Present }
import extdeps.ssh.password_session { PasswordSshSession }
import extdeps.tools.jq {
  JqInvocation,
  JqProgram,
  JqInputFile,
  JqInputStdin,
  JqRawOutput,
  JqLastResultExit,
  JqAdmittedProcessPlan,
  JqOutcome,
  JqOutputAbsent,
  JqOutputPresent,
  JqExecutionRefused,
  jq_invocation_process_plan,
  jq_admitted_plan_surface,
}
import gunbc.remote_shell_command {
  openbmc_dropbear_interpretation,
  RemoteExecInterpretationUnknown,
  Unknown,
}
import extdeps.bmc.openbmc_fan_control {
  OpenBmcIntegerObserved,
  OpenBmcIntegerRefused,
  OpenBmcRemoteJqCommandBuilt,
  OpenBmcRemoteJqCommandRefused,
  OpenBmcRemoteJqStdinUnwired,
  OpenBmcRemoteJqCommandStringRefused,
  OpenBmcRemoteJqExecuted,
  OpenBmcRemoteJqRefused,
  openbmc_fan_config_stepwise_count,
  openbmc_fan_config_stepwise_count_result,
  openbmc_fan_stepwise_count_program,
  openbmc_object_mapper_service_at_program,
  openbmc_remote_jq_command,
  openbmc_remote_jq_execute,
  openbmc_remote_jq_words,
}

// WAVE 2, LANDED: THE FIRST SSH MIGRATION. OpenBmcStepwiseCount is the first remote jq operation
// migrated off its raw sshpass/ssh argv (["jq","-er","<program>","{config_path}"]) onto the
// semantic JqInvocation + remote realization. What is witnessable hermetically is the pure half:
// the JqOutcome decode, the remote word vector, the grammar-owned RFC 4254 command string, and the
// typed refusal for a stdin-fed remote plan. The transport itself (openbmc.PasswordSshTransport
// RunCommand) has no mock_response, so no witness below claims it executed -- the live half is the
// declared, unexecuted remote_exec_command_live_confirmation receipt in gunbc.remote_shell_command.
// docs/plans/cli-invocation-emission-design.md §7 (Wave 2).

data stepwise_config_path: NonEmptyStr = "/etc/openbmc/fan_config.json"

fn stepwise_count_invocation() -> JqInvocation {
  JqInvocation {
    program: JqProgram { source: openbmc_fan_stepwise_count_program },
    bindings: Empty,
    input: JqInputFile { path: stepwise_config_path },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }
}

fn stepwise_count_plan() -> Optional<JqAdmittedProcessPlan> {
  match jq_invocation_process_plan(invocation: stepwise_count_invocation()) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: plan, diagnostics: _ } => Present { value: plan }
  }
}

fn stdin_plan() -> Optional<JqAdmittedProcessPlan> {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: openbmc_fan_stepwise_count_program },
    bindings: Empty,
    input: JqInputStdin { content: "{}" },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: plan, diagnostics: _ } => Present { value: plan }
  }
}

// THE DECODE IS THE OLD DECODE'S CLAIMS, ON JqOutcome. The old openbmc_fan_config_integer read
// success/stdout/stderr; the migrated path reads JqOutcome. Each arm restates one old behavior
// against the typed outcome (DESIGN 3: evidence for a surviving claim survives the representation
// that used to hold it) -- and "no success: Bool survives on the new path" is the point.
test fn stepwise_count_present_integer_is_observed() -> Bool {
  match openbmc_fan_config_stepwise_count_result(outcome: JqOutputPresent { text: "2" }) {
    OpenBmcIntegerObserved { value: count } => count == 2
    _ => false
  }
}

test fn stepwise_count_absent_is_a_refusal() -> Bool {
  match openbmc_fan_config_stepwise_count_result(outcome: JqOutputAbsent) {
    OpenBmcIntegerRefused { reason: reason } => reason == "OpenBMC fan stepwise count is absent"
    _ => false
  }
}

test fn stepwise_count_refusal_carries_stderr() -> Bool {
  match openbmc_fan_config_stepwise_count_result(
    outcome: JqExecutionRefused { exit_code: 2, stderr: "jq: error: Could not open file" },
  ) {
    OpenBmcIntegerRefused { reason: reason } => reason == "jq: error: Could not open file"
    _ => false
  }
}

test fn stepwise_count_non_integer_is_a_refusal() -> Bool {
  match openbmc_fan_config_stepwise_count_result(outcome: JqOutputPresent { text: "many" }) {
    OpenBmcIntegerRefused { reason: reason } => reason == "OpenBMC fan stepwise count is not an integer"
    _ => false
  }
}

// THE REMOTE WORDS ARE "jq" PLUS THE ALREADY-EMITTED SURFACE. The flags come from the semantic
// axes (--raw-output for raw, --exit-status for last-result), the program is exactly ONE word, and
// the file path is exactly one word AFTER the program -- the file operand. The caller spelled none
// of them.
test fn stepwise_count_remote_words_are_jq_plus_emitted_surface() -> Bool {
  match stepwise_count_plan() {
    Absent => false
    Present { value: plan } => {
      let words = openbmc_remote_jq_words(surface: jq_admitted_plan_surface(plan: plan))
      words |> map(w => w as String)
        == ["jq", "--raw-output", "--exit-status", openbmc_fan_stepwise_count_program, stepwise_config_path as String]
    }
  }
}

// THE RFC 4254 COMMAND STRING IS THE GRAMMAR-OWNED SINGLE-QUOTE ENCODING -- one word per quoted
// span, never a raw concatenation and never append(ssh_prefix, inner.argv). The program contains
// double quotes, brackets, a pipe and a select() call; every byte travels inside single-quoted
// spans (IEEE 1003.1-2017 §2.2.2).
//
// This witnesses the PURE EMITTER under a supplied interpretation (openbmc_dropbear_interpretation
// is passed explicitly here as the repo's documented best understanding). It is NOT the production
// gate: openbmc_remote_jq_execute refuses with Unknown until a live target confirms the
// interpretation (review 38602) -- the tests below assert that gate.
test fn stepwise_count_remote_command_string_is_grammar_owned() -> Bool {
  match stepwise_count_plan() {
    Absent => false
    Present { value: plan } =>
      match openbmc_remote_jq_command(plan: plan, interpretation: openbmc_dropbear_interpretation) {
        OpenBmcRemoteJqCommandRefused { cause: _ } => false
        OpenBmcRemoteJqCommandBuilt { command: command } =>
          command as String
            == "'jq' '--raw-output' '--exit-status' '[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")] | length' '/etc/openbmc/fan_config.json'"
      }
  }
}

// THE PRODUCTION GATE (review 38602, REQUEST_CHANGES). openbmc_remote_jq_execute must NOT assume a
// POSIX-shell interpretation for every session: whether the far side hands the RFC 4254 command
// string to a POSIX shell is an OBSERVED deployment fact, and remote_exec_command_live_confirmation
// is declared Unexecuted. So the production path passes Unknown and REFUSES -- DESIGN 4b (external
// reality is observed, refused, or mitigated at a declared boundary, never fabricated) and 5
// (refuse rather than emit a plausible guess). The refusal happens before the transport, so it is
// witnessable hermetically.
test fn remote_jq_execute_gates_on_unknown_interpretation() -> Bool {
  match stepwise_count_plan() {
    Absent => false
    Present { value: plan } =>
      match openbmc_remote_jq_execute(session: witness_session, plan: plan) {
        OpenBmcRemoteJqExecuted { observation: _ } => false
        OpenBmcRemoteJqRefused { cause: cause } =>
          match cause {
            OpenBmcRemoteJqStdinUnwired => false
            OpenBmcRemoteJqCommandStringRefused { cause: inner } =>
              match inner {
                RemoteExecInterpretationUnknown => true
                SimpleCommandArgvRefused { cause: _ } => false
              }
          }
      }
  }
}

// The production caller inherits the gate: openbmc_fan_config_stepwise_count returns a REFUSAL
// naming the live confirmation until the interpretation is observed, never a fabricated count.
test fn fan_config_stepwise_count_refuses_until_live_confirmation() -> Bool {
  match openbmc_fan_config_stepwise_count(session: witness_session, config_path: stepwise_config_path) {
    OpenBmcIntegerObserved { value: _ } => false
    OpenBmcIntegerRefused { reason: reason } =>
      string_contains(s: reason, pattern: "remote-shell interpretation")
  }
}

// STDIN-FED REMOTE JQ IS A TYPED REFUSAL, not an accidental limitation: sshpass -d 0 occupies
// fd 0 with the password, so a remote stdin payload would collide with it (design §10, q2). The
// refusal happens BEFORE the transport, so it is witnessable hermetically.
test fn remote_jq_stdin_plan_refuses_with_the_collision_cause() -> Bool {
  match stdin_plan() {
    Absent => false
    Present { value: plan } =>
      match openbmc_remote_jq_command(plan: plan, interpretation: openbmc_dropbear_interpretation) {
        OpenBmcRemoteJqCommandBuilt { command: _ } => false
        OpenBmcRemoteJqCommandRefused { cause: cause } =>
          match cause {
            OpenBmcRemoteJqStdinUnwired => true
            OpenBmcRemoteJqCommandStringRefused { cause: _ } => false
          }
      }
  }
}

data witness_session: PasswordSshSession = PasswordSshSession {
  host: "bmc-1",
  username: "root",
  password: "pw" as Secret,
  known_hosts_path: "/tmp/known_hosts",
}

test fn remote_jq_execute_refuses_stdin_without_touching_the_transport() -> Bool {
  match stdin_plan() {
    Absent => false
    Present { value: plan } =>
      match openbmc_remote_jq_execute(session: witness_session, plan: plan) {
        OpenBmcRemoteJqRefused { cause: cause } =>
          match cause {
            OpenBmcRemoteJqStdinUnwired => true
            OpenBmcRemoteJqCommandStringRefused { cause: _ } => false
          }
        OpenBmcRemoteJqExecuted { observation: _ } => false
      }
  }
}

// THE INTERPRETATION IS LOAD-BEARING: an Unknown target refuses rather than guessing a shell. This
// is the perturbation that proves the interpretation row decides the emitted command string, not
// decoration.
test fn remote_jq_command_refuses_unknown_interpretation() -> Bool {
  match stepwise_count_plan() {
    Absent => false
    Present { value: plan } =>
      match openbmc_remote_jq_command(plan: plan, interpretation: Unknown) {
        OpenBmcRemoteJqCommandBuilt { command: _ } => false
        OpenBmcRemoteJqCommandRefused { cause: cause } =>
          match cause {
            OpenBmcRemoteJqStdinUnwired => false
            OpenBmcRemoteJqCommandStringRefused { cause: _ } => true
          }
      }
  }
}

// THE REVIEW FIX, PINNED (PR #10148 review). The ObjectMapper service-at program must emit EMPTY
// for an out-of-range index, never NULL: under JqLastResultExit a null last output is a legitimate
// value (exit 1, stdout "null"), which would decode as a service named "null". `null // empty`
// turns the out-of-range arm into no output -> absence (exit 4) -> the missing-index refusal. This
// row is domain-authored jq source (S12, mitigatable), so the pin is the program's exact text.
test fn object_mapper_service_at_program_emits_empty_for_out_of_range() -> Bool {
  openbmc_object_mapper_service_at_program == ".data[0] | keys | .[$index] // empty"
}
