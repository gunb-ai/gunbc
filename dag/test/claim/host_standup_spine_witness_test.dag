module test.claim.host_standup_spine


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn spine_step_tag(step: HostStandupStep) -> Int {
  match step.phase {
    Prefix { phase: BmcCredentialConverge } => 0
    Prefix { phase: OsInstallMechanismResolved } => 1
    Prefix { phase: OsInstallActuated } => 2
    Prefix { phase: HostConvergePolicyDerived } => 3
    Assimilation { phase: HostIdentityConverge } => 4
    Assimilation { phase: ReachSecretsNetwork } => 5
    Assimilation { phase: RunnerDeploySlot } => 6
    Assimilation { phase: BuildCacheProvision } => 7
    Assimilation { phase: CodexRuntimeProvision } => 8
    Assimilation { phase: ComputeFabricEnroll } => 9
    Assimilation { phase: GreenPlaceReadiness } => 10
    Assimilation { phase: SessionPlacementEnrollment } => 11
    Assimilation { phase: StandupAssimilationComplete } => 12
  }
}

type SpineTagAcc {
  ok: Bool
  expected: Int
}

fn spine_tags_are_linear() -> Bool {
  fold(
    host_standup_spine,
    init: SpineTagAcc { ok: true, expected: 0 },
    f: (acc, s) => SpineTagAcc {
      ok: acc.ok && spine_step_tag(step: s) == acc.expected,
      expected: acc.expected + 1
    }
  ).ok
}

test fn host_standup_spine_is_thirteen_step_linear_prefix_then_p0_p5() -> Bool {
  host_standup_spine_length() == 13
    && spine_tags_are_linear()
    && host_standup_gap_ledger.length() == 13
}

test fn p1c_codex_runtime_provision_spine_row_landed() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        Assimilation { phase: CodexRuntimeProvision } =>
          s.label == "P1c:codex-runtime-provision"
            && match s.disposition {
              ModeledCompose { authorities: refs } =>
                refs.length() >= 3
                  && string_contains(s: s.label, pattern: "codex-runtime-provision")
              DeclaredGap { interim_realization: _, refusal: _ } => false
            }
        Prefix { phase: _ } => acc
        Assimilation { phase: _ } => acc
      }
  )
}

test fn p1b_build_cache_provision_spine_row_landed() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        Assimilation { phase: BuildCacheProvision } =>
          s.label == "P1b:build-cache-provision"
            && match s.disposition {
              ModeledCompose { authorities: refs } =>
                refs.length() >= 3
                  && string_contains(s: s.label, pattern: "build-cache-provision")
              DeclaredGap { interim_realization: _, refusal: _ } => false
            }
        Prefix { phase: _ } => acc
        Assimilation { phase: _ } => acc
      }
  )
}

test fn srv3_target_and_install_mechanism_are_grounded() -> Bool {
  srv3_host_standup_target == operator_host_srv3
    && srv3_install_mechanism_refuses_rather_than_falling_back()
}

test fn srv3_live_fleet_offer_carries_ci() -> Bool {
  fleet_intent_offers.length() == 4
    && srv3_offer.supply.physical.identity == operator_host_srv3
}

test fn credential_probe_projection_matches_onboarding_authority() -> Bool {
  credential_probe_maps_factory_default(probe: FactoryCredentialActive)
    && credential_probe_maps_credentials_rotated(probe: RotatedCredentialActive)
}

test fn host_standup_fleet_converge_policy_is_derived_or_unsound() -> Bool {
  match host_standup_fleet_converge_policy() {
    ConvergePolicyDerived { hosts: _ } => true
    ConvergePolicyUnsound { reason: _ } => true
  }
}

test fn compute_fabric_shape_authority_is_referenced_not_redeclared() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        Assimilation { phase: ComputeFabricEnroll } =>
          match s.disposition {
            DeclaredGap { interim_realization: _, refusal: r } =>
              string_contains(s: r, pattern: "product.fabric.work Shape")
                && !string_contains(s: r, pattern: "product.compute_fabric.connect")
            ModeledCompose { authorities: _ } => false
          }
        Prefix { phase: _ } => acc
        Assimilation { phase: _ } => acc
      }
  )
}

test fn green_place_pin_coherent_references_gunbc_gate_not_input_satisfied() -> Bool {
  let default_gate = host_standup_p5_default_green_place_gate_verdict()
  match default_gate {
    GreenPlaceFromGunbcGate {
      noop_satisfied_authority: noop,
      marker_satisfied_authority: marker,
      desired_pin_authority: desired,
      gate_verdict: false,
    } =>
      !green_place_pin_coherent_satisfied(w: default_gate)
        && noop == host_standup_p5_green_place_noop_gate_authority
        && marker == host_standup_p5_green_place_marker_gate_authority
        && desired == host_standup_p5_desired_pin_authority
    GreenPlacePinGap { interim_realization: _ } => false
    GreenPlacePinRefused { reason: _ } => false
  }
}

test fn assimilation_complete_gate_is_fail_closed_on_any_gap_or_refusal() -> Bool {
  let ci_required = assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation)
  let gap_gate = AssimilationCompleteGate {
    obligations: [
      AssimilationObligation {
        input: NodeRegistered,
        witness: InputGap { input: NodeRegistered, interim_realization: "ctrl:node_registry.mjs" },
      },
      AssimilationObligation { input: ResourcesPresent, witness: InputSatisfied },
      AssimilationObligation {
        input: GreenPlacePinCoherent,
        witness: assimilation_input_witness_from_green_place(
          w: GreenPlacePinGap { interim_realization: "ctrl:pending" }
        ),
      },
      AssimilationObligation { input: RunnerSlotHealthy, witness: InputSatisfied },
    ],
  }
  match assimilation_complete(gate: gap_gate, required: ci_required) {
    AssimilationIncomplete { input: NodeRegistered, reason: r } =>
      string_contains(s: r, pattern: "P5:gap-refused:")
    AssimilationComplete => false
  }
    && match assimilation_complete(gate: AssimilationCompleteGate {
      obligations: [
        AssimilationObligation { input: NodeRegistered, witness: InputSatisfied },
        AssimilationObligation {
          input: ResourcesPresent,
          witness: InputRefused { input: ResourcesPresent, reason: "missing cgroup slice" },
        },
        AssimilationObligation {
          input: GreenPlacePinCoherent,
          witness: assimilation_input_witness_from_green_place(
            w: host_standup_p5_default_green_place_gate_verdict()
          ),
        },
        AssimilationObligation { input: RunnerSlotHealthy, witness: InputSatisfied },
      ],
    }, required: ci_required) {
      AssimilationIncomplete { input: ResourcesPresent, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_complete_passes_only_when_all_four_inputs_satisfied() -> Bool {
  let ci_required = assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation)
  let gate = AssimilationCompleteGate {
    obligations: [
      AssimilationObligation { input: NodeRegistered, witness: InputSatisfied },
      AssimilationObligation { input: ResourcesPresent, witness: InputSatisfied },
      AssimilationObligation {
        input: GreenPlacePinCoherent,
        witness: assimilation_input_witness_from_green_place(
          w: GreenPlaceFromGunbcGate {
            noop_satisfied_authority: host_standup_p5_green_place_noop_gate_authority,
            marker_satisfied_authority: host_standup_p5_green_place_marker_gate_authority,
            desired_pin_authority: host_standup_p5_desired_pin_authority,
            gate_verdict: true,
          }
        ),
      },
      AssimilationObligation { input: RunnerSlotHealthy, witness: InputSatisfied },
    ],
  }
  assimilation_complete_all_satisfied(gate: gate, required: ci_required)
    && match assimilation_complete(gate: gate, required: ci_required) {
      AssimilationComplete => true
      AssimilationIncomplete { input: _, reason: _ } => false
    }
}

test fn inference_completion_inputs_exclude_ci_only_obligations() -> Bool {
  assimilation_completion_inputs_for(participation: inference_serving_enrollment_participation).length() == 2
    && assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation).length() == 4
}

test fn both_participation_completion_inputs_union_inference_first() -> Bool {
  let both = assimilation_completion_inputs_for(participation: both_participation_enrollment_participation)
  both.length() == 4
    && assimilation_input_is_required(required: both, wanted: NodeRegistered)
    && assimilation_input_is_required(required: both, wanted: ResourcesPresent)
    && assimilation_input_is_required(required: both, wanted: GreenPlacePinCoherent)
    && assimilation_input_is_required(required: both, wanted: RunnerSlotHealthy)
}

test fn assimilation_gate_refuses_when_required_obligation_missing() -> Bool {
  let ci_required = assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation)
  let incomplete_gate = AssimilationCompleteGate {
    obligations: [
      AssimilationObligation { input: NodeRegistered, witness: InputSatisfied },
      AssimilationObligation { input: ResourcesPresent, witness: InputSatisfied },
    ],
  }
  match assimilation_complete(gate: incomplete_gate, required: ci_required) {
    AssimilationIncomplete { input: _, reason: r } =>
      string_contains(s: r, pattern: "required-obligation-missing")
    AssimilationComplete => false
  }
}

test fn assimilation_gate_refuses_when_unrequired_obligation_present() -> Bool {
  let inference_required = assimilation_completion_inputs_for(participation: inference_serving_enrollment_participation)
  let gate_with_runner = AssimilationCompleteGate {
    obligations: [
      AssimilationObligation { input: NodeRegistered, witness: InputSatisfied },
      AssimilationObligation { input: ResourcesPresent, witness: InputSatisfied },
      AssimilationObligation { input: RunnerSlotHealthy, witness: InputSatisfied },
    ],
  }
  match assimilation_complete(gate: gate_with_runner, required: inference_required) {
    AssimilationIncomplete { input: RunnerSlotHealthy, reason: r } =>
      string_contains(s: r, pattern: "unrequired-obligation-present")
    AssimilationComplete => false
  }
}

test fn p3_green_place_contributes_via_gunbc_gate_after_pinned_tree_lands() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && !host_standup_p3_fail_closed_blocks_complete()
    && match assimilation_complete(
      gate: host_standup_default_assimilation_gate_unsatisfied(),
      required: assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation),
    ) {
      AssimilationIncomplete { input: GreenPlacePinCoherent, reason: r } =>
        string_contains(s: r, pattern: "gunbc gate verdict false")
      AssimilationIncomplete { input: NodeRegistered, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_gate_still_refuses_p0_p2_p4_gaps_when_p3_landed() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(
      gate: host_standup_default_assimilation_gate_unsatisfied(),
      required: assimilation_completion_inputs_for(participation: ci_runner_enrollment_participation),
    ) {
      AssimilationIncomplete { input: NodeRegistered, reason: r } =>
        string_contains(s: r, pattern: "P5:gap-refused:")
      AssimilationComplete => false
    }
}

test fn post_install_dhcp_subsumption_reduces_gap_count_by_one() -> Bool {
  srv3_post_install_actuation_verdict(elapsed: millisecond(count: 0)) == std.upsert_decision.Converged
    && host_standup_gap_count_at_actuation_verdict(verdict: std.upsert_decision.Converged) == (host_standup_gap_count() - 1)
}

test fn declared_gap_steps_carry_interim_realization_authority() -> Bool {
  fold(
    host_standup_spine,
    init: true,
    f: (acc, s) => acc && match s.disposition {
      DeclaredGap { interim_realization: path, refusal: r } =>
        string_contains(s: r, pattern: "host_standup:")
          && (string_contains(s: path, pattern: "ctrl:")
            || string_contains(s: path, pattern: "extdeps.")
            || string_contains(s: path, pattern: "gunbc."))
      ModeledCompose { authorities: refs } => refs.length() > 0
    }
  )
}

test fn p0_gap_ledger_matches_spine_partial_authorities() -> Bool {
  fold(
    host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P0:reach-secrets-network"
        && row.modeling == "partial"
        && string_contains(s: row.authority_or_interim, pattern: "extdeps.tailscale.acl")
        && string_contains(s: row.authority_or_interim, pattern: "gunbc.tailscale_acl"))
  )
}

test fn p3_gap_ledger_notes_green_place_dag_writer_path() -> Bool {
  fold(
    host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P3:green-place-readiness"
        && string_contains(s: row.authority_or_interim, pattern: "green_place.dag")
        && string_contains(s: row.authority_or_interim, pattern: "read-gunbc-pin.sh"))
  )
}

