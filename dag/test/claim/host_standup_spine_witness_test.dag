module test.claim.host_standup_spine



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn spine_step_tag(step: gunbc.host_standup.HostStandupStep) -> Int {
  match test.claim.materialization_ladder_witness.step.phase {
    Prefix { phase: gunbc.host_standup.BmcCredentialConverge } => 0
    Prefix { phase: gunbc.host_standup.OsInstallMechanismResolved } => 1
    Prefix { phase: gunbc.host_standup.OsInstallActuated } => 2
    Prefix { phase: gunbc.host_standup.HostConvergePolicyDerived } => 3
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.HostIdentityConverge } => 4
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.ReachSecretsNetwork } => 5
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.RunnerDeploySlot } => 6
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.BuildCacheProvision } => 7
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.CodexRuntimeProvision } => 8
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.ComputeFabricEnroll } => 9
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.GreenPlaceReadiness } => 10
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.SessionPlacementEnrollment } => 11
    gunbc.host_standup.Assimilation { phase: gunbc.host_standup.StandupAssimilationComplete } => 12
  }
}

type SpineTagAcc {
  ok: Bool
  expected: Int
}

fn spine_tags_are_linear() -> Bool {
  fold(
    test.claim.host_standup_spine,
    init: SpineTagAcc { ok: true, expected: 0 },
    f: (acc, s) => SpineTagAcc {
      ok: acc.ok && spine_step_tag(step: s) == acc.expected,
      expected: acc.expected + 1
    }
  ).ok
}

test fn host_standup_spine_is_thirteen_step_linear_prefix_then_p0_p5() -> Bool {
  gunbc.host_standup.host_standup_spine_length() == 13
    && spine_tags_are_linear()
    && gunbc.host_standup.host_standup_gap_ledger.length() == 13
}

test fn p1c_codex_runtime_provision_spine_row_landed() -> Bool {
  fold(
    test.claim.host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        gunbc.host_standup.Assimilation { phase: gunbc.host_standup.CodexRuntimeProvision } =>
          s.label == "P1c:codex-runtime-provision"
            && match s.disposition {
              gunbc.host_standup.ModeledCompose { authorities: refs } =>
                refs.length() >= 3
                  && string_contains(s: s.label, pattern: "codex-runtime-provision")
              gunbc.host_standup.DeclaredGap { interim_realization: _, refusal: _ } => false
            }
        Prefix { phase: _ } => acc
        gunbc.host_standup.Assimilation { phase: _ } => acc
      }
  )
}

test fn p1b_build_cache_provision_spine_row_landed() -> Bool {
  fold(
    test.claim.host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        gunbc.host_standup.Assimilation { phase: gunbc.host_standup.BuildCacheProvision } =>
          s.label == "P1b:build-cache-provision"
            && match s.disposition {
              gunbc.host_standup.ModeledCompose { authorities: refs } =>
                refs.length() >= 3
                  && string_contains(s: s.label, pattern: "build-cache-provision")
              gunbc.host_standup.DeclaredGap { interim_realization: _, refusal: _ } => false
            }
        Prefix { phase: _ } => acc
        gunbc.host_standup.Assimilation { phase: _ } => acc
      }
  )
}

test fn srv3_target_and_install_mechanism_are_grounded() -> Bool {
  gunbc.host_standup.srv3_host_standup_target == gunbc.fleet_intent_network.operator_host_srv3
    && gunbc.host_standup.srv3_install_mechanism_refuses_rather_than_falling_back()
}

test fn srv3_live_fleet_offer_carries_ci() -> Bool {
  gunbc.ci_fleet.fleet_intent_offers.length() == 4
    && gunbc.ci_fleet.srv3_offer.supply.physical.identity == gunbc.fleet_intent_network.operator_host_srv3
}

test fn credential_probe_projection_matches_onboarding_authority() -> Bool {
  gunbc.host_standup.credential_probe_maps_factory_default(probe: gunbc.bmc_onboarding.FactoryCredentialActive)
    && gunbc.host_standup.credential_probe_maps_credentials_rotated(probe: gunbc.bmc_onboarding.RotatedCredentialActive)
}

test fn host_standup_fleet_converge_policy_is_derived_or_unsound() -> Bool {
  match gunbc.host_standup.host_standup_fleet_converge_policy() {
    gunbc.host_converge.ConvergePolicyDerived { hosts: _ } => true
    gunbc.host_converge.ConvergePolicyUnsound { reason: _ } => true
  }
}

test fn compute_fabric_shape_authority_is_referenced_not_redeclared() -> Bool {
  fold(
    test.claim.host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        gunbc.host_standup.Assimilation { phase: gunbc.host_standup.ComputeFabricEnroll } =>
          match s.disposition {
            gunbc.host_standup.DeclaredGap { interim_realization: _, refusal: r } =>
              string_contains(s: r, pattern: "product.fabric.work Shape")
                && !string_contains(s: r, pattern: "product.compute_fabric.connect")
            gunbc.host_standup.ModeledCompose { authorities: _ } => false
          }
        Prefix { phase: _ } => acc
        gunbc.host_standup.Assimilation { phase: _ } => acc
      }
  )
}

test fn green_place_pin_coherent_references_gunbc_gate_not_input_satisfied() -> Bool {
  let default_gate = gunbc.host_standup.host_standup_p5_default_green_place_gate_verdict()
  match default_gate {
    gunbc.host_standup.GreenPlaceFromGunbcGate {
      noop_satisfied_authority: noop,
      marker_satisfied_authority: marker,
      desired_pin_authority: desired,
      gate_verdict: false,
    } =>
      !gunbc.host_standup.green_place_pin_coherent_satisfied(w: default_gate)
        && noop == gunbc.host_standup.host_standup_p5_green_place_noop_gate_authority
        && marker == gunbc.host_standup.host_standup_p5_green_place_marker_gate_authority
        && desired == gunbc.host_standup.host_standup_p5_desired_pin_authority
    gunbc.host_standup.GreenPlacePinGap { interim_realization: _ } => false
    gunbc.host_standup.GreenPlacePinRefused { reason: _ } => false
  }
}

test fn assimilation_complete_gate_is_fail_closed_on_any_gap_or_refusal() -> Bool {
  let ci_required = gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation)
  let gap_gate = gunbc.host_standup.AssimilationCompleteGate {
    obligations: [
      gunbc.host_standup.AssimilationObligation {
        input: gunbc.host_standup.NodeRegistered,
        witness: gunbc.host_standup.InputGap { input: gunbc.host_standup.NodeRegistered, interim_realization: "ctrl:node_registry.mjs" },
      },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.ResourcesPresent, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation {
        input: gunbc.host_standup.GreenPlacePinCoherent,
        witness: gunbc.host_standup.assimilation_input_witness_from_green_place(
          w: gunbc.host_standup.GreenPlacePinGap { interim_realization: "ctrl:pending" }
        ),
      },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.RunnerSlotHealthy, witness: gunbc.host_standup.InputSatisfied },
    ],
  }
  match gunbc.host_standup.assimilation_complete(gate: gap_gate, required: ci_required) {
    gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.NodeRegistered, reason: r } =>
      string_contains(s: r, pattern: "P5:gap-refused:")
    gunbc.host_standup.AssimilationComplete => false
  }
    && match gunbc.host_standup.assimilation_complete(gate: gunbc.host_standup.AssimilationCompleteGate {
      obligations: [
        gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.NodeRegistered, witness: gunbc.host_standup.InputSatisfied },
        gunbc.host_standup.AssimilationObligation {
          input: gunbc.host_standup.ResourcesPresent,
          witness: gunbc.host_standup.InputRefused { input: gunbc.host_standup.ResourcesPresent, reason: "missing cgroup slice" },
        },
        gunbc.host_standup.AssimilationObligation {
          input: gunbc.host_standup.GreenPlacePinCoherent,
          witness: gunbc.host_standup.assimilation_input_witness_from_green_place(
            w: gunbc.host_standup.host_standup_p5_default_green_place_gate_verdict()
          ),
        },
        gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.RunnerSlotHealthy, witness: gunbc.host_standup.InputSatisfied },
      ],
    }, required: ci_required) {
      gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.ResourcesPresent, reason: _ } => true
      gunbc.host_standup.AssimilationComplete => false
    }
}

test fn assimilation_complete_passes_only_when_all_four_inputs_satisfied() -> Bool {
  let ci_required = gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation)
  let gate = gunbc.host_standup.AssimilationCompleteGate {
    obligations: [
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.NodeRegistered, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.ResourcesPresent, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation {
        input: gunbc.host_standup.GreenPlacePinCoherent,
        witness: gunbc.host_standup.assimilation_input_witness_from_green_place(
          w: gunbc.host_standup.GreenPlaceFromGunbcGate {
            noop_satisfied_authority: gunbc.host_standup.host_standup_p5_green_place_noop_gate_authority,
            marker_satisfied_authority: gunbc.host_standup.host_standup_p5_green_place_marker_gate_authority,
            desired_pin_authority: gunbc.host_standup.host_standup_p5_desired_pin_authority,
            gate_verdict: true,
          }
        ),
      },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.RunnerSlotHealthy, witness: gunbc.host_standup.InputSatisfied },
    ],
  }
  gunbc.host_standup.assimilation_complete_all_satisfied(gate: gate, required: ci_required)
    && match gunbc.host_standup.assimilation_complete(gate: gate, required: ci_required) {
      gunbc.host_standup.AssimilationComplete => true
      gunbc.host_standup.AssimilationIncomplete { input: _, reason: _ } => false
    }
}

test fn inference_completion_inputs_exclude_ci_only_obligations() -> Bool {
  gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.inference_serving_enrollment_participation).length() == 2
    && gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation).length() == 4
}

test fn both_participation_completion_inputs_union_inference_first() -> Bool {
  let both = gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.both_participation_enrollment_participation)
  both.length() == 4
    && gunbc.host_standup.assimilation_input_is_required(required: both, wanted: gunbc.host_standup.NodeRegistered)
    && gunbc.host_standup.assimilation_input_is_required(required: both, wanted: gunbc.host_standup.ResourcesPresent)
    && gunbc.host_standup.assimilation_input_is_required(required: both, wanted: gunbc.host_standup.GreenPlacePinCoherent)
    && gunbc.host_standup.assimilation_input_is_required(required: both, wanted: gunbc.host_standup.RunnerSlotHealthy)
}

test fn assimilation_gate_refuses_when_required_obligation_missing() -> Bool {
  let ci_required = gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation)
  let incomplete_gate = gunbc.host_standup.AssimilationCompleteGate {
    obligations: [
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.NodeRegistered, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.ResourcesPresent, witness: gunbc.host_standup.InputSatisfied },
    ],
  }
  match gunbc.host_standup.assimilation_complete(gate: incomplete_gate, required: ci_required) {
    gunbc.host_standup.AssimilationIncomplete { input: _, reason: r } =>
      string_contains(s: r, pattern: "required-obligation-missing")
    gunbc.host_standup.AssimilationComplete => false
  }
}

test fn assimilation_gate_refuses_when_unrequired_obligation_present() -> Bool {
  let inference_required = gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.inference_serving_enrollment_participation)
  let gate_with_runner = gunbc.host_standup.AssimilationCompleteGate {
    obligations: [
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.NodeRegistered, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.ResourcesPresent, witness: gunbc.host_standup.InputSatisfied },
      gunbc.host_standup.AssimilationObligation { input: gunbc.host_standup.RunnerSlotHealthy, witness: gunbc.host_standup.InputSatisfied },
    ],
  }
  match gunbc.host_standup.assimilation_complete(gate: gate_with_runner, required: inference_required) {
    gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.RunnerSlotHealthy, reason: r } =>
      string_contains(s: r, pattern: "unrequired-obligation-present")
    gunbc.host_standup.AssimilationComplete => false
  }
}

test fn p3_green_place_contributes_via_gunbc_gate_after_pinned_tree_lands() -> Bool {
  gunbc.host_standup.host_standup_p3_gunbc_pinned_tree_landed
    && !gunbc.host_assimilation_program.host_standup_p3_fail_closed_blocks_complete()
    && match gunbc.host_standup.assimilation_complete(
      gate: gunbc.host_assimilation_program.host_standup_default_assimilation_gate_unsatisfied(),
      required: gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation),
    ) {
      gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.GreenPlacePinCoherent, reason: r } =>
        string_contains(s: r, pattern: "gunbc gate verdict false")
      gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.NodeRegistered, reason: _ } => true
      gunbc.host_standup.AssimilationComplete => false
    }
}

test fn assimilation_gate_still_refuses_p0_p2_p4_gaps_when_p3_landed() -> Bool {
  gunbc.host_standup.host_standup_p3_gunbc_pinned_tree_landed
    && match gunbc.host_standup.assimilation_complete(
      gate: gunbc.host_assimilation_program.host_standup_default_assimilation_gate_unsatisfied(),
      required: gunbc.host_assimilation_program.assimilation_completion_inputs_for(participation: gunbc.host_assimilation_program.ci_runner_enrollment_participation),
    ) {
      gunbc.host_standup.AssimilationIncomplete { input: gunbc.host_standup.NodeRegistered, reason: r } =>
        string_contains(s: r, pattern: "P5:gap-refused:")
      gunbc.host_standup.AssimilationComplete => false
    }
}

test fn post_install_dhcp_subsumption_reduces_gap_count_by_one() -> Bool {
  gunbc.host_standup_assimilation_deduction.srv3_post_install_actuation_verdict(elapsed: std.measure.millisecond(count: 0)) == std.upsert_decision.Converged
    && gunbc.host_standup.host_standup_gap_count_at_actuation_verdict(verdict: std.upsert_decision.Converged) == (gunbc.host_standup.host_standup_gap_count() - 1)
}

test fn declared_gap_steps_carry_interim_realization_authority() -> Bool {
  fold(
    test.claim.host_standup_spine,
    init: true,
    f: (acc, s) => acc && match s.disposition {
      gunbc.host_standup.DeclaredGap { interim_realization: path, refusal: r } =>
        string_contains(s: r, pattern: "host_standup:")
          && (string_contains(s: path, pattern: "ctrl:")
            || string_contains(s: path, pattern: "extdeps.")
            || string_contains(s: path, pattern: "gunbc."))
      gunbc.host_standup.ModeledCompose { authorities: refs } => refs.length() > 0
    }
  )
}

test fn p0_gap_ledger_matches_spine_partial_authorities() -> Bool {
  fold(
    gunbc.host_standup.host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P0:reach-secrets-network"
        && row.modeling == "partial"
        && string_contains(s: row.authority_or_interim, pattern: "extdeps.tailscale.acl")
        && string_contains(s: row.authority_or_interim, pattern: "gunbc.tailscale_acl"))
  )
}

test fn p3_gap_ledger_notes_green_place_dag_writer_path() -> Bool {
  fold(
    gunbc.host_standup.host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P3:green-place-readiness"
        && string_contains(s: row.authority_or_interim, pattern: "green_place.dag")
        && string_contains(s: row.authority_or_interim, pattern: "read-gunbc-pin.sh"))
  )
}

