module test.claim.host_standup_spine


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn spine_step_tag(step: HostStandupStep) -> Int {
  match step.phase {
    Prefix { phase: BmcCredentialConverge } => 0
    Prefix { phase: OsInstallMechanismResolved } => 1
    Prefix { phase: OsInstallActuated } => 2
    Prefix { phase: HostConvergePolicyDerived } => 3
    Assimilation { phase: HostIdentityConverge } => 4
    Assimilation { phase: ReachSecretsNetwork } => 5
    Assimilation { phase: RunnerDeploySlot } => 6
    Assimilation { phase: BuildCacheProvision } => 7
    Assimilation { phase: ComputeFabricEnroll } => 8
    Assimilation { phase: GreenPlaceReadiness } => 9
    Assimilation { phase: SessionPlacementEnrollment } => 10
    Assimilation { phase: StandupAssimilationComplete } => 11
  }
}

type SpineTagAcc {
  ok: Bool
  expected: Int
}

fn spine_tags_are_linear() -> Bool {
  fold(
    host_standup_spine,
    init: SpineTagAcc { ok: true, expected: 0 },
    f: (acc, s) => SpineTagAcc {
      ok: acc.ok && spine_step_tag(step: s) == acc.expected,
      expected: acc.expected + 1
    }
  ).ok
}

test fn host_standup_spine_is_twelve_step_linear_prefix_then_p0_p5() -> Bool {
  host_standup_spine_length() == 12
    && spine_tags_are_linear()
    && host_standup_gap_ledger.length() == 12
}

test fn p1b_build_cache_provision_spine_row_landed() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        Assimilation { phase: BuildCacheProvision } =>
          s.label == "P1b:build-cache-provision"
            && match s.disposition {
              ModeledCompose { authorities: refs } =>
                refs.length() >= 3
                  && string_contains(s: s.label, pattern: "build-cache-provision")
              DeclaredGap { interim_realization: _, refusal: _ } => false
            }
        Prefix { phase: _ } => acc
        Assimilation { phase: _ } => acc
      }
  )
}

test fn srv3_target_and_install_mechanism_are_grounded() -> Bool {
  srv3_host_standup_target == operator_host_srv3
    && srv3_install_mechanism_is_nbd_proxy_no_fallback()
}

test fn srv3_live_fleet_offer_carries_ci() -> Bool {
  fleet_intent_offers.length() == 4
    && srv3_offer.supply.physical.identity == operator_host_srv3
}

test fn credential_probe_projection_matches_onboarding_authority() -> Bool {
  credential_probe_maps_factory_default(probe: FactoryCredentialActive)
    && credential_probe_maps_credentials_rotated(probe: RotatedCredentialActive)
}

test fn host_standup_fleet_converge_policy_is_derived_or_unsound() -> Bool {
  match host_standup_fleet_converge_policy() {
    ConvergePolicyDerived { hosts: _ } => true
    ConvergePolicyUnsound { reason: _ } => true
  }
}

test fn compute_fabric_shape_authority_is_referenced_not_redeclared() -> Bool {
  witness_fabric_binds_need_to_opportunity()
}

test fn green_place_pin_coherent_references_gunbc_gate_not_input_satisfied() -> Bool {
  let default_gate = host_standup_p5_default_green_place_gate_verdict()
  match default_gate {
    GreenPlaceFromGunbcGate {
      noop_satisfied_authority: noop,
      marker_satisfied_authority: marker,
      desired_pin_authority: desired,
      gate_verdict: false,
    } =>
      !green_place_pin_coherent_satisfied(w: default_gate)
        && noop == host_standup_p5_green_place_noop_gate_authority
        && marker == host_standup_p5_green_place_marker_gate_authority
        && desired == host_standup_p5_desired_pin_authority
    GreenPlacePinGap { interim_realization: _ } => false
    GreenPlacePinRefused { reason: _ } => false
  }
}

test fn assimilation_complete_gate_is_fail_closed_on_any_gap_or_refusal() -> Bool {
  let gap_gate = AssimilationCompleteGate {
    obligations: [
      AssimilationObligationRow {
        obligation: NodeRegistration,
        witness: ObligationGap { interim_realization: "ctrl:node_registry.mjs" },
      },
      obligation_row_satisfied(obligation: ResourcesPresent),
      AssimilationObligationRow {
        obligation: GreenPlacePinGateCoherent,
        witness: ObligationGap { interim_realization: "ctrl:pending" },
      },
      obligation_row_satisfied(obligation: RunnerSlotHealthy),
    ],
  }
  match assimilation_complete(gate: gap_gate) {
    AssimilationIncomplete { obligation: NodeRegistration, reason: r } =>
      string_contains(s: r, pattern: "P5:gap-refused:")
    AssimilationComplete => false
  }
    && match assimilation_complete(gate: AssimilationCompleteGate {
      obligations: [
        obligation_row_satisfied(obligation: NodeRegistration),
        AssimilationObligationRow {
          obligation: ResourcesPresent,
          witness: ObligationRefused { reason: "missing cgroup slice" },
        },
        AssimilationObligationRow {
          obligation: GreenPlacePinGateCoherent,
          witness: GreenPlaceWitness { w: host_standup_p5_default_green_place_gate_verdict() },
        },
        obligation_row_satisfied(obligation: RunnerSlotHealthy),
      ],
    }) {
      AssimilationIncomplete { obligation: ResourcesPresent, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_complete_passes_only_when_all_extrinsic_obligations_satisfied() -> Bool {
  let gate = AssimilationCompleteGate {
    obligations: [
      obligation_row_satisfied(obligation: NodeRegistration),
      obligation_row_satisfied(obligation: ResourcesPresent),
      AssimilationObligationRow {
        obligation: GreenPlacePinGateCoherent,
        witness: GreenPlaceWitness {
          w: GreenPlaceFromGunbcGate {
            noop_satisfied_authority: host_standup_p5_green_place_noop_gate_authority,
            marker_satisfied_authority: host_standup_p5_green_place_marker_gate_authority,
            desired_pin_authority: host_standup_p5_desired_pin_authority,
            gate_verdict: true,
          },
        },
      },
      obligation_row_satisfied(obligation: RunnerSlotHealthy),
    ],
  }
  assimilation_complete_all_satisfied(gate: gate)
    && match assimilation_complete(gate: gate) {
      AssimilationComplete => true
      AssimilationIncomplete { obligation: _, reason: _ } => false
    }
}

test fn assimilation_completion_obligations_derive_from_ci_program() -> Bool {
  assimilation_completion_obligation_count(intent: default_ci_assimilation_intent) == (host_standup_spine.length() - 1) + 4
}

test fn assimilation_completion_obligations_smaller_for_inference() -> Bool {
  let inference = HostEnrollmentIntent {
    host: operator_host_srv3,
    participation: inference_serving_enrollment_participation,
  }
  let ci_count = assimilation_completion_obligation_count(intent: default_ci_assimilation_intent)
  let inference_count = assimilation_completion_obligation_count(intent: inference)
  inference_count > 0 && inference_count < ci_count
}

test fn derived_gate_roster_matches_obligation_count() -> Bool {
  let gate = host_standup_default_assimilation_gate_unsatisfied()
  gate.obligations.length() == assimilation_completion_obligation_count(intent: default_ci_assimilation_intent)
}

test fn p3_green_place_contributes_via_gunbc_gate_after_pinned_tree_lands() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && !host_standup_p3_fail_closed_blocks_complete()
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { obligation: GreenPlacePinGateCoherent, reason: r } =>
        string_contains(s: r, pattern: "gunbc gate verdict false")
      AssimilationIncomplete { obligation: NodeRegistration, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_gate_still_refuses_gaps_when_p3_landed() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { obligation: NodeRegistration, reason: r } =>
        string_contains(s: r, pattern: "P5:gap-refused:")
      AssimilationComplete => false
    }
}

test fn post_install_dhcp_subsumption_reduces_gap_count_by_one() -> Bool {
  srv3_post_install_actuation_verdict(elapsed: millisecond(count: 0)) == std.upsert_decision.Converged
    && host_standup_gap_count_at_actuation_verdict(verdict: std.upsert_decision.Converged) == (host_standup_gap_count() - 1)
}

test fn declared_gap_steps_carry_interim_realization_authority() -> Bool {
  fold(
    host_standup_spine,
    init: true,
    f: (acc, s) => acc && match s.disposition {
      DeclaredGap { interim_realization: path, refusal: r } =>
        string_contains(s: r, pattern: "host_standup:")
          && (string_contains(s: path, pattern: "ctrl:")
            || string_contains(s: path, pattern: "extdeps.")
            || string_contains(s: path, pattern: "gunbc."))
      ModeledCompose { authorities: refs } => refs.length() > 0
    }
  )
}

test fn p0_gap_ledger_matches_spine_partial_authorities() -> Bool {
  fold(
    host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P0:reach-secrets-network"
        && row.modeling == "partial"
        && string_contains(s: row.authority_or_interim, pattern: "extdeps.tailscale.acl")
        && string_contains(s: row.authority_or_interim, pattern: "gunbc.tailscale_acl"))
  )
}

test fn p3_gap_ledger_notes_green_place_dag_writer_path() -> Bool {
  fold(
    host_standup_gap_ledger,
    init: false,
    f: (acc, row) =>
      acc || (row.phase_label == "P3:green-place-readiness"
        && string_contains(s: row.authority_or_interim, pattern: "green_place.dag")
        && string_contains(s: row.authority_or_interim, pattern: "read-gunbc-pin.sh"))
  )
}

