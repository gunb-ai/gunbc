module test.claim.host_standup_spine


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn spine_step_tag(step: HostStandupStep) -> Int {
  match step.phase {
    Prefix { phase: BmcCredentialConverge } => 0
    Prefix { phase: BmcFirmwareConverge } => 1
    Prefix { phase: BmcSurfaceRediscover } => 2
    Prefix { phase: BmcFanPolicyConverge } => 3
    Prefix { phase: BmcThermalSafetyVerify } => 4
    Prefix { phase: OsInstallMechanismResolved } => 5
    Prefix { phase: OsInstallActuated } => 6
    Prefix { phase: HostConvergePolicyDerived } => 7
    Assimilation { phase: HostIdentityConverge } => 8
    Assimilation { phase: ReachSecretsNetwork } => 9
    Assimilation { phase: RunnerDeploySlot } => 10
    Assimilation { phase: BuildCacheProvision } => 11
    Assimilation { phase: ComputeFabricEnroll } => 12
    Assimilation { phase: GreenPlaceReadiness } => 13
    Assimilation { phase: SessionPlacementEnrollment } => 14
    Assimilation { phase: StandupAssimilationComplete } => 15
  }
}

type SpineTagAcc {
  ok: Bool
  expected: Int
}

fn spine_tags_are_linear() -> Bool {
  fold(
    host_standup_spine,
    init: SpineTagAcc { ok: true, expected: 0 },
    f: (acc, s) => SpineTagAcc {
      ok: acc.ok && spine_step_tag(step: s) == acc.expected,
      expected: acc.expected + 1
    }
  ).ok
}

test fn host_standup_spine_is_sixteen_step_linear_bmc_os_then_p0_p5() -> Bool {
  host_standup_spine_length() == 16
    && spine_tags_are_linear()
    && host_standup_named_gap_count() == 14
    && host_standup_bmc_named_gap_count() == 10
    && !host_standup_gap_present(gap_id: "bmc-fan-live-observer")
    && !host_standup_gap_present(gap_id: "bmc-fan-overlay-actuator")
    && !host_standup_gap_present(gap_id: "bmc-fan-rollback-readback")
    && !host_standup_gap_present(gap_id: "bmc-thermal-postapply-probe")
}

test fn p1b_build_cache_provision_spine_row_landed() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, s) =>
      acc || match s.phase {
        Assimilation { phase: BuildCacheProvision } =>
          s.label == "P1b:build-cache-provision"
            && s.disposition.authorities.length() >= 3
            && s.disposition.gaps.length() == 0
            && string_contains(s: s.label, pattern: "build-cache-provision")
        Prefix { phase: _ } => acc
        Assimilation { phase: _ } => acc
      }
  )
}

test fn srv3_target_and_install_mechanism_are_grounded() -> Bool {
  srv3_host_standup_target == operator_host_srv3
    && srv3_install_mechanism_is_nbd_proxy_no_fallback()
}

test fn srv3_live_fleet_offer_carries_ci() -> Bool {
  fleet_intent_offers.length() == 4
    && srv3_offer.supply.physical.identity == operator_host_srv3
}

test fn credential_probe_projection_matches_onboarding_authority() -> Bool {
  credential_probe_maps_factory_default(probe: FactoryCredentialActive)
    && credential_probe_maps_credentials_rotated(probe: RotatedCredentialActive)
}

test fn host_standup_fleet_converge_policy_is_derived_or_unsound() -> Bool {
  match host_standup_fleet_converge_policy() {
    ConvergePolicyDerived { hosts: _ } => true
    ConvergePolicyUnsound { reason: _ } => true
  }
}

test fn compute_fabric_shape_authority_is_referenced_not_redeclared() -> Bool {
  witness_fabric_binds_need_to_opportunity()
}

test fn green_place_pin_coherent_references_gunbc_gate_not_input_satisfied() -> Bool {
  let default_gate = host_standup_p5_default_green_place_gate_verdict()
  match default_gate {
    GreenPlaceFromGunbcGate {
      noop_satisfied_authority: noop,
      marker_satisfied_authority: marker,
      desired_pin_authority: desired,
      gate_verdict: false,
    } =>
      !green_place_pin_coherent_satisfied(w: default_gate)
        && noop == host_standup_p5_green_place_noop_gate_authority
        && marker == host_standup_p5_green_place_marker_gate_authority
        && desired == host_standup_p5_desired_pin_authority
    GreenPlacePinGap { interim_realization: _ } => false
    GreenPlacePinRefused { reason: _ } => false
  }
}

test fn assimilation_complete_gate_is_fail_closed_on_any_gap_or_refusal() -> Bool {
  let all_gap = AssimilationCompleteGate {
    node_registered: InputGap { input: NodeRegistered, interim_realization: "ctrl:node_registry.mjs" },
    resources_present: InputSatisfied,
    green_place_pin_coherent: GreenPlacePinGap { interim_realization: "ctrl:pending" },
    runner_healthy: InputSatisfied,
  }
  match assimilation_complete(gate: all_gap) {
    AssimilationIncomplete { input: NodeRegistered, reason: r } =>
      string_contains(s: r, pattern: "P5:gap-refused:")
    AssimilationComplete => false
  }
    && match assimilation_complete(gate: AssimilationCompleteGate {
      node_registered: InputSatisfied,
      resources_present: InputRefused { input: ResourcesPresent, reason: "missing cgroup slice" },
      green_place_pin_coherent: host_standup_p5_default_green_place_gate_verdict(),
      runner_healthy: InputSatisfied,
    }) {
      AssimilationIncomplete { input: ResourcesPresent, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_complete_passes_only_when_all_four_inputs_satisfied() -> Bool {
  let gate = AssimilationCompleteGate {
    node_registered: InputSatisfied,
    resources_present: InputSatisfied,
    green_place_pin_coherent: GreenPlaceFromGunbcGate {
      noop_satisfied_authority: host_standup_p5_green_place_noop_gate_authority,
      marker_satisfied_authority: host_standup_p5_green_place_marker_gate_authority,
      desired_pin_authority: host_standup_p5_desired_pin_authority,
      gate_verdict: true,
    },
    runner_healthy: InputSatisfied,
  }
  assimilation_complete_all_satisfied(gate: gate)
    && match assimilation_complete(gate: gate) {
      AssimilationComplete => true
      AssimilationIncomplete { input: _, reason: _ } => false
    }
}

test fn p3_green_place_contributes_via_gunbc_gate_after_pinned_tree_lands() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && !host_standup_p3_fail_closed_blocks_complete()
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { input: GreenPlacePinCoherent, reason: r } =>
        string_contains(s: r, pattern: "gunbc gate verdict false")
      AssimilationIncomplete { input: NodeRegistered, reason: _ } => true
      AssimilationComplete => false
    }
}

test fn assimilation_gate_still_refuses_p0_p2_p4_gaps_when_p3_landed() -> Bool {
  host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { input: NodeRegistered, reason: r } =>
        string_contains(s: r, pattern: "P5:gap-refused:")
      AssimilationComplete => false
    }
}

test fn post_install_dhcp_subsumption_reduces_gap_count_by_one() -> Bool {
  srv3_post_install_actuation_verdict(elapsed: millisecond(count: 0)) == std.upsert_decision.Converged
    && host_standup_gap_count_at_actuation_verdict(verdict: std.upsert_decision.Converged) == (host_standup_gap_count() - 1)
}

test fn every_step_has_authority_or_typed_gap_and_every_gap_refuses() -> Bool {
  fold(
    host_standup_spine,
    init: true,
    f: (acc, s) =>
      acc
        && (s.disposition.authorities.length() > 0 || s.disposition.gaps.length() > 0)
        && fold(
          s.disposition.gaps,
          init: true,
          f: (gaps_ok, gap) =>
            gaps_ok
              && (gap.gap_id as String) != ""
              && (gap.missing as String) != ""
              && string_contains(s: gap.refusal as String, pattern: "host_standup:"),
        )
  )
}

test fn p0_partial_phase_carries_authorities_and_gap_in_one_product() -> Bool {
  fold(
    host_standup_spine,
    init: false,
    f: (acc, step) =>
      acc || (step.label == "P0:reach-secrets-network"
        && step.disposition.authorities.length() >= 3
        && step.disposition.gaps.length() == 1
        && match step.disposition.gaps.first() {
          Present { value: gap } => gap.gap_id == "reach-secrets-live-upsert"
          Absent => false
        })
  )
}

test fn remaining_bmc_gap_projection_is_complete_and_derived_from_spine() -> Bool {
  host_standup_gap_present(gap_id: "bmc-managed-credential-binding")
    && host_standup_gap_present(gap_id: "bmc-firmware-live-observer")
    && host_standup_gap_present(gap_id: "bmc-firmware-approved-artifact")
    && host_standup_gap_present(gap_id: "bmc-firmware-update-actuator")
    && host_standup_gap_present(gap_id: "bmc-firmware-return-readback")
    && host_standup_gap_present(gap_id: "bmc-firmware-recovery-proof")
    && host_standup_gap_present(gap_id: "bmc-subsumption-entrypoint-wiring")
    && host_standup_gap_present(gap_id: "bmc-surface-live-rediscovery")
    && !host_standup_gap_present(gap_id: "bmc-fan-live-observer")
    && !host_standup_gap_present(gap_id: "bmc-fan-overlay-actuator")
    && !host_standup_gap_present(gap_id: "bmc-fan-rollback-readback")
    && !host_standup_gap_present(gap_id: "bmc-thermal-postapply-probe")
    && host_standup_gap_present(gap_id: "bmc-fan-reboot-persistence-witness")
    && host_standup_gap_present(gap_id: "bmc-thermal-operating-envelope")
}
