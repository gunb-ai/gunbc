module test.claim.codex_package_lock_parse_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "Parses the committed provider-runtime/codex/package-lock.json (npm-generated v3). Empty edges by design. RED: unsupported lockfileVersion refuses. Archive digest admission is the pure expected/observed compare — observation realization is the typed file-hash dissolve-on."

data openai_codex_integrity_hex: String = "c86dec3d635d6bfd980084080eaf4caeb8e8093210eebc5833921ab2b1b754172e8422d39207a0fc9cea989ab557df11138309e630b10d75d094e8eb762b4547"

fn committed_codex_lock_text() -> String {
  filesystem_read(path: codex_runtime_lock_path as String).content
}

test fn committed_codex_lock_parses_v3_roster() -> Bool {
  match npm_decode_package_lock_text(text: committed_codex_lock_text()) {
    NpmPackageLockParsed { manager: _, nodes, unsupported, graph } =>
      count(unsupported) == 0
        && count(nodes) == 8
        && count(graph.nodes) == 8
        && count(graph.edges) == 0
        && count(graph.roots) == 1
    NpmPackageLockParseRefused { cause: _ } => false
  }
}

test fn committed_codex_lock_admits_under_codex_profile() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph: _, nodes, registry_artifacts } =>
      count(registry_artifacts) == 7 && count(nodes) == 8
    CodexPackageLockParseFailed { cause: _ } => false
    CodexPackageLockUnsupportedNodes { unsupported: _ } => false
    CodexPackageLockGraphRefused { admission: _ } => false
  }
}

test fn openai_codex_wrapper_selected_by_exact_lock_node_key() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match codex_wrapper_lookup(graph: graph) {
        CodexWrapperUnique { node: _, artifact } =>
          (artifact.version as String) == "0.146.0"
            && match codex_admit_npm_integrity(integrity: artifact.expected_integrity) {
              CodexNpmIntegrityAdmitted { digest } =>
                (digest.hex as String) == openai_codex_integrity_hex
                  && match npm_registry_artifact_pin(artifact: artifact).selection {
                    ExactPin =>
                      match npm_registry_artifact_pin(artifact: artifact).expected_identity {
                        Sha512Hash(pinned) =>
                          (pinned.hex as String) == openai_codex_integrity_hex
                        _ => false
                      }
                    _ => false
                  }
              _ => false
            }
        _ => false
      }
    _ => false
  }
}

test fn linux_arm64_exact_closure_is_wrapper_plus_platform_lock_node() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match codex_map_uname_to_npm_target(kernel: "Linux", machine: "aarch64") {
        CodexNpmRuntimeTargetObserved { target } =>
          match select_codex_exact_target_closure(graph: graph, target: target) {
            CodexExactTargetClosureSelected {
              wrapper: _,
              platform: _,
              target: _,
              platform_lock_key,
              native_executable_rel,
            } =>
              ((platform_lock_key as String) == "node_modules/@openai/codex-linux-arm64")
                && ((native_executable_rel as String) == "node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex")
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn selected_node_with_install_script_refuses() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match codex_wrapper_lookup(graph: graph) {
        CodexWrapperUnique { node, artifact } => {
          let with_script = gunbc.package_delivery.CodexPackageLockNode {
            key: node.key,
            selection: node.selection,
            metadata: extdeps.npm.NpmLockNodeMetadata {
              flags: extdeps.npm.NpmLockNodeFlags {
                dev: node.metadata.flags.dev,
                optional: node.metadata.flags.optional,
                dev_optional: node.metadata.flags.dev_optional,
                in_bundle: node.metadata.flags.in_bundle,
                has_install_script: true,
                has_shrinkwrap: node.metadata.flags.has_shrinkwrap,
              },
              platform: node.metadata.platform,
            },
          }
          match admit_codex_selected_node(
            node: with_script,
            artifact: artifact,
            lock_node_key: "node_modules/@openai/codex" as std.types.NonEmptyStr,
            expect_optional: false,
            expect_version: "0.146.0" as std.types.NonEmptyStr,
            expect_os: none,
            expect_cpu: none,
          ) {
            CodexSelectedNodeInstallScriptRefused { lock_node_key } =>
              (lock_node_key as String) == "node_modules/@openai/codex"
            CodexSelectedNodeIdentityRefused { lock_node_key: _, cause: _ } => false
            CodexSelectedNodeAdmitted {
              node: _,
              artifact: _,
              lock_node_key: _,
            } => false
          }
        }
        _ => false
      }
    _ => false
  }
}

test fn selected_node_wrong_version_keeps_key_but_refuses() -> Bool {
  match admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match codex_wrapper_lookup(graph: graph) {
        CodexWrapperUnique { node, artifact } => {
          let wrong = extdeps.npm.NpmRegistryArtifact {
            package: artifact.package,
            version: "0.145.0" as std.types.NonEmptyStr,
            resolved: artifact.resolved,
            expected_integrity: artifact.expected_integrity,
          }
          match admit_codex_selected_node(
            node: node,
            artifact: wrong,
            lock_node_key: "node_modules/@openai/codex" as std.types.NonEmptyStr,
            expect_optional: false,
            expect_version: "0.146.0" as std.types.NonEmptyStr,
            expect_os: none,
            expect_cpu: none,
          ) {
            CodexSelectedNodeIdentityRefused { lock_node_key, cause: _ } =>
              (lock_node_key as String) == "node_modules/@openai/codex"
            _ => false
          }
        }
        _ => false
      }
    _ => false
  }
}

