data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CLAIMS THAT NEED A SNAPSHOT THE REAL TAKE WROTE. A TakenCredentialSnapshot is sealed
// (gunbc.dispatch_credential_snapshot), so no witness can supply one: every claim here runs the real
// dispatch_credential_snapshot_take over a custody file it writes into a directory it creates, and
// removes that directory before it answers. Each take is given the attempt it is FOR: a claim that
// launches names the same instance, node, attempt and provider the launch receives (fx_subject), so the
// snapshot passes the spawn fold's subject check exactly as a production selection's does; a claim that
// never launches takes for fx_unlaunched_subject. That is the pairing obligation DESIGN states for a
// supplied boundary, met by construction: the only route to a launch that binds a credential is the
// execution of the real take. Filesystem.Write and shell.Mktemp.DirWithTemplate have no hermetic
// response, so this file is a wet witness; its hermetic siblings (test.claim.worker_turn_dispatch_
// witness_test, test.claim.claude_code_dispatch_witness_test, test.claim.roadmap_dispatch_actuator)
// hold the claims that need no snapshot, including the refusals of a launch that holds none.

fn fx_dir(label: String) -> String {
  shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_dispatch_snapshot_", label, ".XXXXXX"], "") as FilePath).path as String
}

fn fx_custody(dir: String) -> String {
  join([dir, "/custody"], "")
}

fn fx_snapshot(dir: String) -> String {
  join([dir, "/snapshot"], "")
}

fn fx_subject(instance: HostDashboardInstance, node: String, attempt: String, provider: DispatchCliProvider) -> CredentialSnapshotSubject {
  dispatch_credential_snapshot_subject_for_instance(
    instance: instance,
    node_id: node as NonEmptyStr as RoadmapNodeId,
    attempt_key: attempt,
    provider: provider,
  )
}

fn fx_unlaunched_subject() -> CredentialSnapshotSubject {
  fx_subject(instance: srv1_live_dashboard_instance(), node: "node-snapshot-unlaunched", attempt: "0000000000000000", provider: ClaudeCodeProvider)
}

// Writes the custody file and runs the REAL take into the same directory. A fixture write that fails
// is a refusal, never a silent pass: every claim matches the Taken arm to go green.
fn fx_take(dir: String, content: String, subject: CredentialSnapshotSubject) -> DispatchCredentialSnapshot {
  let wrote = Filesystem.Write(path: fx_custody(dir: dir), content: content)
  if !wrote.success {
    DispatchSnapshotRefused { reason: join(["the fixture custody file could not be written: ", wrote.error], "") as NonEmptyStr }
  } else {
    dispatch_credential_snapshot_take(subject: subject, source: fx_custody(dir: dir) as NonEmptyStr, snapshot: fx_snapshot(dir: dir) as NonEmptyStr)
  }
}

fn fx_cleanup(dir: String) -> Bool {
  shell.Remove.RecursiveForce(path: dir as FilePath).success
}

fn file_absent(path: String) -> Bool {
  !Filesystem.Read(path: path).success
}

// ── The take ────────────────────────────────────────────────────────────────────────────────────

test fn a_take_copies_the_custody_bytes_to_the_snapshot_path() -> Bool {
  let dir = fx_dir(label: "copy")
  let ok = match fx_take(dir: dir, content: "custody-token-bytes\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      taken_credential_snapshot_path(snapshot: snapshot) as String == fx_snapshot(dir: dir)
        && credential_snapshot_subjects_agree(a: taken_credential_snapshot_subject(snapshot: snapshot), b: fx_unlaunched_subject())
        && Filesystem.Read(path: fx_snapshot(dir: dir)).content == "custody-token-bytes\n"
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn an_absent_custody_file_refuses_naming_it_and_writes_no_snapshot() -> Bool {
  let dir = fx_dir(label: "absent")
  let missing = join([dir, "/no-such-custody"], "")
  let ok = match dispatch_credential_snapshot_take(subject: fx_unlaunched_subject(), source: missing as NonEmptyStr, snapshot: fx_snapshot(dir: dir) as NonEmptyStr) {
    DispatchSnapshotRefused { reason } => string_contains(s: reason as String, pattern: missing) && file_absent(path: fx_snapshot(dir: dir))
    DispatchSnapshotTaken { snapshot: _ } => false
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn an_empty_custody_file_refuses_and_writes_no_snapshot() -> Bool {
  let dir = fx_dir(label: "empty")
  let ok = match fx_take(dir: dir, content: "  \n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason } => string_contains(s: reason as String, pattern: "is empty") && file_absent(path: fx_snapshot(dir: dir))
    DispatchSnapshotTaken { snapshot: _ } => false
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn discard_removes_the_snapshot_the_take_wrote() -> Bool {
  let dir = fx_dir(label: "discard")
  let ok = match fx_take(dir: dir, content: "custody-token-bytes\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_credential_snapshot_discard(snapshot: snapshot, attempt: fx_unlaunched_subject()) {
        CredentialSnapshotRemoved => file_absent(path: fx_snapshot(dir: dir))
        CredentialSnapshotLeftToItsAttempt { reason: _ } => false
        CredentialSnapshotRemovalFailed { reason: _ } => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// ── Claude: the launch binds the taken snapshot ─────────────────────────────────────────────────

fn claude_binding_holds(argv: List<String>, snapshot: TakenCredentialSnapshot) -> Bool {
  list_length(items: argv) == 4 + list_length(items: spawn_argv_tail)
    && match argv.first() {
         Present { value: w } => w == "sh"
         Absent => false
       }
    && any(argv, a => a == taken_credential_snapshot_path(snapshot: snapshot) as String)
    && !any(argv, a => a == claude_code_oauth_harness_host_path as String)
    && any(argv, a => string_contains(s: a, pattern: "'rm' '-f' '--' \"$0\" || exit 79"))
    && any(argv, a => string_contains(s: a, pattern: "'exec' \"$@\""))
    && !any(argv, a => starts_with(s: a, prefix: "CLAUDE_CODE_OAUTH_TOKEN=") && !string_contains(s: a, pattern: "\"$0\""))
}

// The setup-token credential reaches the child through the env wrapper, from the snapshot the take
// wrote, never the custody file and never argv; and the removal is a precondition of the exec (the
// program carries the removal's own failure arm, exit 79).
test fn a_claude_launch_binds_the_taken_snapshot_through_the_env_wrapper_never_argv() -> Bool {
  let dir = fx_dir(label: "claude-bind")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match claude_inner_argv_for_credential(credential: claude_dispatch_credential(), snapshot: snapshot, argv: spawn_argv_tail) {
        DispatchProviderInnerArgvReady { argv } => claude_binding_holds(argv: argv, snapshot: snapshot)
        ClaudeProviderCredentialUnbound { reason: _ } => false
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        CodexProviderOffCustodyHost { reason: _ } => false
        CredentialSnapshotNotConsumed { reason: _ } => false
        CredentialSnapshotForAnotherAttempt { reason: _ } => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// A profile tree is not a credential even when a real snapshot is held: the binding refuses on the
// credential, never on the snapshot.
test fn an_ambient_profile_tree_is_not_a_bindable_credential() -> Bool {
  let dir = fx_dir(label: "claude-profile")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match claude_inner_argv_for_credential(
        credential: ClaudeStateRootRef { root: "~/.claude" as FilePath },
        snapshot: snapshot,
        argv: spawn_argv_tail,
      ) {
        ClaudeProviderCredentialUnbound { reason: _ } => true
        DispatchProviderInnerArgvReady { argv: _ } => false
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        CodexProviderOffCustodyHost { reason: _ } => false
        CredentialSnapshotNotConsumed { reason: _ } => false
        CredentialSnapshotForAnotherAttempt { reason: _ } => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// ── THE REAL-PATH INHABITANCE CLAIM ─────────────────────────────────────────────────────────────
// The route an explicit Claude dispatch takes, through every real producer except the CLI process
// itself, whose stdout is the captured 2.1.289 receipt: the trip's lines become the standing, the
// standing replaces the declared srv1 row, selection resolves Claude, the receipt's kind becomes the
// dispatch provider, and the PRODUCTION spawn fold for srv1 (dispatch_provider_inner_argv_for_instance)
// emits the custody-wrapped claude argv for the snapshot the REAL take wrote. It asserts the ROUTE --
// the wrapper and the taken snapshot reach the argv, the custody file does not -- not only that some
// argv appeared.
test fn the_captured_trip_reaches_a_credential_bound_claude_spawn_on_srv1() -> Bool {
  let dir = fx_dir(label: "claude-route")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv1_live_dashboard_instance(), node: "node-claude", attempt: "0123456789abcdef", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match resolve_dispatch_selection(
        inventory: observed(stdout: trip(lines: [planted_assistant_line, receipt_rate_limit_allowed, receipt_result_success])),
        request: provider_selection_request_for_kind(kind: ClaudeCliProvider),
        sizing_expectation: NoDerivedSizingExpectation,
      ) {
        DispatchSelectionRefused { sizing_expectation: _, requested_selection: _, reason: _ } => false
        DispatchSelectionResolved { receipt } =>
          match dispatch_provider_inner_argv_for_instance(
            instance: srv1_live_dashboard_instance(),
            provider: provider_kind_to_dispatch_cli(kind: receipt.provider_kind),
            effort: receipt.applied_effort,
            model: ProviderAccountDefaultModel,
            session_uuid: "00000000-0000-4000-8000-000000000000",
            node_id: "node-claude" as NonEmptyStr as RoadmapNodeId,
            attempt_key: "0123456789abcdef",
            worktree_path: "/tmp/w",
            brief: "brief",
            alignment_chain_fingerprint: "fp",
            credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
          ) {
            DispatchProviderInnerArgvReady { argv } =>
              first_word_is(argv: argv, word: "sh")
                && any(argv, a => a == taken_credential_snapshot_path(snapshot: snapshot) as String)
                && !any(argv, a => a == claude_code_oauth_harness_host_path as String)
                && any(argv, a => a == "claude")
            ClaudeProviderCredentialUnbound { reason: _ } => false
            CodexProviderExecutableAbsent { reason: _ } => false
            CursorProviderOffCustodyHost { reason: _ } => false
            CursorProviderCredentialUnbound { reason: _ } => false
            CodexProviderOffCustodyHost { reason: _ } => false
            CredentialSnapshotNotConsumed { reason: _ } => false
            CredentialSnapshotForAnotherAttempt { reason: _ } => false
          }
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// The model is carried through the Claude arm of the spawn fold, as it is through the codex arm
// (test.claim.roadmap_dispatch_actuator witness_inner_argv_carries_pinned_model_for_codex).
test fn the_claude_launch_carries_a_pinned_model() -> Bool {
  let dir = fx_dir(label: "claude-model")
  let expected = concat("\0--model\0", witness_pinned_dispatch_model as String)
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv1_live_dashboard_instance(), node: "node-inner", attempt: "feedfacefeedface", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_provider_inner_argv_for_instance(
        instance: srv1_live_dashboard_instance(),
        provider: ClaudeCodeProvider,
        effort: ReasoningHigh,
        model: ProviderModelPinned { model: witness_pinned_dispatch_model },
        session_uuid: "uuid-inner",
        node_id: roadmap_dispatch_actuator_nid(s: "node-inner"),
        attempt_key: "feedfacefeedface",
        worktree_path: "/opt/gunbc/dispatch-worktrees/node-inner",
        brief: "brief",
        alignment_chain_fingerprint: "fp",
        credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
      ) {
        DispatchProviderInnerArgvReady { argv } => string_contains(s: join(argv, separator: "\0"), pattern: expected)
        ClaudeProviderCredentialUnbound { reason: _ } => false
        CodexProviderExecutableAbsent { reason: _ } => false
        CursorProviderOffCustodyHost { reason: _ } => false
        CursorProviderCredentialUnbound { reason: _ } => false
        CodexProviderOffCustodyHost { reason: _ } => false
        CredentialSnapshotNotConsumed { reason: _ } => false
        CredentialSnapshotForAnotherAttempt { reason: _ } => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// review 78389, re-homed here because a Claude spawn now needs a taken snapshot: pipe emission lives
// only on the tmux container arm, so a headless Claude spawn on srv1-live gets the systemd unit
// container, and a pipe-step refusal here is the defect.
test fn witness_headless_claude_spawn_does_not_refuse_as_tmux_event_pipe() -> Bool {
  let dir = fx_dir(label: "claude-headless")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv1_live_dashboard_instance(), node: "claude-headless-spawn", attempt: "feedfacefeedface", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_spawn_commands_for_resolved_instance(
        instance: srv1_live_dashboard_instance(),
        node: sized_derivable(id: "claude-headless-spawn", prs: [], title: "Headless Claude spawn"),
        session_uuid: "00000000-0000-4000-8000-000000000005",
        attempt_key: "feedfacefeedface",
        provider: ClaudeCodeProvider,
        effort: ReasoningMedium,
        model: ProviderAccountDefaultModel,
        origin: FreshFromBase,
        resolution: fixture_ready_resolution(node_id: "claude-headless-spawn", project_ids: []),
        credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
      ) {
        DispatchSpawnRefused { step: _, detail: _ } => false
        DispatchSpawnReady { commands } =>
          match commands.session_container {
            SystemdUnitContainer { plan: _ } => true
            TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => false
          }
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// THE LAB INSTANCE MOVES ITS REPO AND ATTEMPT STATE TOGETHER, shown with the Claude spawn (its
// credential is held on srv1) holding a snapshot the real take wrote. Claude runs headless in a
// transient systemd unit (witness_headless_claude_uses_a_transient_unit_with_stream_json_on_the_events_path),
// so the unit's stdout lands under the lab's attempt-state root and its argv names THAT snapshot; the
// worktree, state directory and current pointer move with the lab; and the path a production selection
// on the lab would take lies under the lab's own attempt-state root. This replaces the claim of the same
// subject in test.claim.roadmap_dispatch_actuator, which still expected a tmux container for Claude and
// was red on main. The codex half (the lab refuses a codex spawn at the custody-host step) is hermetic:
// test.claim.roadmap_dispatch_actuator witness_lab_instance_refuses_a_codex_spawn_at_the_custody_host.
fn lab_instance_moves_together(commands: DispatchSpawnCommands, state_root: String, snapshot_path: String) -> Bool {
  let git_wire = join(commands.worktree_add.args, separator: "\0")
  let state_wire = join(commands.attempt_state_prepare.args, separator: "\0")
  let pointer_wire = join(commands.attempt_current_pointer.args, separator: "\0")
  string_contains(
    s: git_wire,
    pattern: "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempts/ts-dispatch-provider-events-afeedfacefeedface",
  )
    && string_contains(s: git_wire, pattern: "\0origin/main")
    && commands.attempt_state_prepare.program == "/usr/bin/install"
    && string_contains(s: state_wire, pattern: join(["\0", state_root, "/ts-dispatch-provider-events-afeedfacefeedface"], ""))
    && commands.attempt_current_pointer.program == "/usr/bin/ln"
    && string_contains(s: pointer_wire, pattern: join(["\0", state_root, "/ts-dispatch-provider-events-current"], ""))
    && match commands.session_container {
         TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => false
         SystemdUnitContainer { plan } =>
           starts_with(s: plan.stdout_path, prefix: join([state_root, "/"], ""))
             && any(plan.inner_argv, a => a == snapshot_path)
       }
}

test fn witness_lab_instance_moves_repo_and_attempt_state_together() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let state_root = dashboard_instance_dispatch_attempt_state_root(instance: lab) as String
  let dir = fx_dir(label: "lab")
  let derived_under_lab_state = starts_with(
    s: dispatch_credential_snapshot_path_for_instance(
      instance: lab,
      node_id: "ts-dispatch-provider-events" as NonEmptyStr as RoadmapNodeId,
      attempt_key: "feedfacefeedface",
      provider: ClaudeCodeProvider,
    ) as String,
    prefix: join([state_root, "/"], ""),
  )
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: lab, node: "ts-dispatch-provider-events", attempt: "feedfacefeedface", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_spawn_commands_for_resolved_instance(
        instance: lab,
        node: sized_derivable(id: "ts-dispatch-provider-events", prs: [], title: "Provider execution facts"),
        session_uuid: "00000000-0000-4000-8000-000000000001",
        attempt_key: "feedfacefeedface",
        provider: ClaudeCodeProvider,
        effort: ReasoningMedium,
        model: ProviderAccountDefaultModel,
        origin: FreshFromBase,
        resolution: fixture_ready_resolution(node_id: "ts-dispatch-provider-events", project_ids: []),
        credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
      ) {
        DispatchSpawnRefused { step: _, detail: _ } => false
        DispatchSpawnReady { commands } =>
          lab_instance_moves_together(commands: commands, state_root: state_root, snapshot_path: taken_credential_snapshot_path(snapshot: snapshot) as String)
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  derived_under_lab_state && ok && cleaned
}

// ── Cursor: the launch binds the taken snapshot ─────────────────────────────────────────────────

// THE CURSOR ROUTE on the custody host: the key is exported inside the child from the snapshot the
// take wrote, never the mutable custody file (the shared sh wrapper is the first word and the taken
// snapshot is its argument), the agent runs unattended in print mode against the attempt worktree,
// and no word of the argv is --api-key.
test fn a_cursor_turn_on_srv2_binds_the_taken_snapshot_through_the_env_wrapper() -> Bool {
  let dir = fx_dir(label: "cursor-bind")
  let ok = match fx_take(dir: dir, content: "cursor-key\n", subject: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "0123456789abcdef", provider: CursorDispatchProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match ready_argv(inner: inner_for(instance: srv2_lab_dashboard_instance(), provider: CursorDispatchProvider, credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot })) {
        Absent => false
        Present { value: argv } =>
          first_word_is(argv: argv, word: "sh")
            && any(argv, a => a == taken_credential_snapshot_path(snapshot: snapshot) as String)
            && !any(argv, a => a == cursor_worker_turn_api_key_host_path as String)
            && any(argv, a => a == "cursor-agent")
            && any(argv, a => a == "--print")
            && any(argv, a => a == "--force")
            && any(argv, a => a == "--trust")
            && has_pair(argv: argv, flag: "--sandbox", value: "enabled")
            && has_pair(argv: argv, flag: "--workspace", value: "/tmp/w")
            && !any(argv, a => a == "--api-key")
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// THE CURSOR ABANDONMENT CONTROL, by execution. The belt discards the snapshot the selection took for
// every post-selection outcome but a launched child (gunbc.roadmap_belt_actuate
// belt_snapshot_owned_outcome): after a SpawnFailed the file the take wrote is gone, after a Spawned
// it is still there for the child to read. The cursor launch names that same file, and its wrapper
// refuses the exec (exit 79) when it cannot remove it.
test fn an_abandoned_cursor_attempt_leaves_no_snapshot_behind() -> Bool {
  let id = launch_identity_exemplar()
  let abandoned_dir = fx_dir(label: "cursor-abandoned")
  let abandoned = match fx_take(dir: abandoned_dir, content: "cursor-key\n", subject: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "0123456789abcdef", provider: CursorDispatchProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } => {
      let launch_names_it = match ready_argv(inner: inner_for(instance: srv2_lab_dashboard_instance(), provider: CursorDispatchProvider, credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot })) {
        Absent => false
        Present { value: argv } =>
          any(argv, a => a == taken_credential_snapshot_path(snapshot: snapshot) as String)
            && any(argv, a => string_contains(s: a, pattern: "|| exit 79"))
      }
      let outcome = belt_snapshot_owned_outcome(
        snapshot: snapshot,
        attempt: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "0123456789abcdef", provider: CursorDispatchProvider),
        provider_wire_label: "cursor",
        launch: id,
        outcome: SpawnFailed { node_id: "node-worker-turn", step: "cursor-provider-preflight", detail: "refused", provider: "cursor", launch: id },
      )
      let still_failed = match outcome {
        SpawnFailed { node_id: _, step, detail: _, provider: _, launch: _ } => step == "cursor-provider-preflight"
        Spawned { node_id: _, session_name: _, provider: _, launch: _ } => false
        SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => false
        SpawnNotAdmitted { node_id: _, refusal: _ } => false
      }
      launch_names_it && still_failed && file_absent(path: fx_snapshot(dir: abandoned_dir))
    }
  }
  let launched_dir = fx_dir(label: "cursor-launched")
  let launched = match fx_take(dir: launched_dir, content: "cursor-key\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } => {
      let outcome = belt_snapshot_owned_outcome(
        snapshot: snapshot,
        attempt: fx_unlaunched_subject(),
        provider_wire_label: "cursor",
        launch: id,
        outcome: Spawned { node_id: "node-worker-turn", session_name: "gunbc-dispatch-node-worker-turn", provider: "cursor", launch: id },
      )
      let kept = Filesystem.Read(path: fx_snapshot(dir: launched_dir)).success
      match outcome {
        Spawned { node_id: _, session_name: _, provider: _, launch: _ } => kept
        SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => false
        SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => false
        SpawnNotAdmitted { node_id: _, refusal: _ } => false
      }
    }
  }
  let cleaned = fx_cleanup(dir: abandoned_dir) && fx_cleanup(dir: launched_dir)
  abandoned && launched && cleaned
}

// ── An executor that never reads a snapshot refuses a held one ──────────────────────────────────

fn not_consumed(inner: DispatchProviderInnerArgv) -> Bool {
  match inner {
    CredentialSnapshotNotConsumed { reason: _ } => true
    CredentialSnapshotForAnotherAttempt { reason: _ } => false
    DispatchProviderInnerArgvReady { argv: _ } => false
    CodexProviderExecutableAbsent { reason: _ } => false
    CursorProviderOffCustodyHost { reason: _ } => false
    CursorProviderCredentialUnbound { reason: _ } => false
    CodexProviderOffCustodyHost { reason: _ } => false
    ClaudeProviderCredentialUnbound { reason: _ } => false
  }
}

// The belt treats a launched child as the snapshot's consumer; codex and the harness never read one,
// so handing them a held snapshot would leave it on disk after a launch the belt calls a consumption.
// Both refuse on the custody host where every other precondition holds.
test fn codex_and_the_harness_refuse_a_held_snapshot() -> Bool {
  let dir = fx_dir(label: "not-consumed")
  let ok = match fx_take(dir: dir, content: "some-credential\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      not_consumed(inner: inner_for(instance: srv2_lab_dashboard_instance(), provider: CodexDispatchProvider, credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot }))
        && not_consumed(inner: inner_for(instance: srv2_lab_dashboard_instance(), provider: GunbcHarnessProvider, credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot }))
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// ── A snapshot taken for one attempt licenses no other launch ───────────────────────────────────
// Proof that a take ran is not proof that THIS attempt's take ran. The spawn fold compares the subject
// the take recorded with the attempt it is launching (gunbc.roadmap_dispatch_actuator
// held_snapshot_for_another_attempt) and refuses a mismatch typed, before anything is staged. Each RED
// below differs from a launching claim above in exactly one dimension of the subject, and that claim,
// holding the matching subject, is its positive control: the attempt (witness_headless_claude_spawn_
// does_not_refuse_as_tmux_event_pipe), the provider (a_cursor_turn_on_srv2_binds_the_taken_snapshot_
// through_the_env_wrapper), the instance on the same host (the_claude_launch_carries_a_pinned_model).

fn for_another_attempt(inner: DispatchProviderInnerArgv) -> Bool {
  match inner {
    CredentialSnapshotForAnotherAttempt { reason: _ } => true
    CredentialSnapshotNotConsumed { reason: _ } => false
    DispatchProviderInnerArgvReady { argv: _ } => false
    CodexProviderExecutableAbsent { reason: _ } => false
    CursorProviderOffCustodyHost { reason: _ } => false
    CursorProviderCredentialUnbound { reason: _ } => false
    CodexProviderOffCustodyHost { reason: _ } => false
    ClaudeProviderCredentialUnbound { reason: _ } => false
  }
}

test fn a_launch_holding_another_attempts_snapshot_refuses_before_anything_is_staged() -> Bool {
  let dir = fx_dir(label: "other-attempt")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv1_live_dashboard_instance(), node: "claude-headless-spawn", attempt: "0000000000000001", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_spawn_commands_for_resolved_instance(
        instance: srv1_live_dashboard_instance(),
        node: sized_derivable(id: "claude-headless-spawn", prs: [], title: "Headless Claude spawn"),
        session_uuid: "00000000-0000-4000-8000-000000000005",
        attempt_key: "feedfacefeedface",
        provider: ClaudeCodeProvider,
        effort: ReasoningMedium,
        model: ProviderAccountDefaultModel,
        origin: FreshFromBase,
        resolution: fixture_ready_resolution(node_id: "claude-headless-spawn", project_ids: []),
        credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
      ) {
        DispatchSpawnReady { commands: _ } => false
        DispatchSpawnRefused { step, detail } =>
          (step as String) == "credential-snapshot-other-attempt"
            && string_contains(s: detail, pattern: "attempt 0000000000000001")
            && string_contains(s: detail, pattern: "attempt feedfacefeedface")
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn a_cursor_launch_holding_a_claude_snapshot_refuses() -> Bool {
  let dir = fx_dir(label: "other-provider")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "0123456789abcdef", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      for_another_attempt(inner: inner_for(instance: srv2_lab_dashboard_instance(), provider: CursorDispatchProvider, credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot }))
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn a_launch_holding_another_instances_snapshot_refuses() -> Bool {
  let dir = fx_dir(label: "other-instance")
  let ok = match fx_take(dir: dir, content: "oauth-token\n", subject: fx_subject(instance: srv1_lab_dashboard_instance(), node: "node-inner", attempt: "feedfacefeedface", provider: ClaudeCodeProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      for_another_attempt(inner: dispatch_provider_inner_argv_for_instance(
        instance: srv1_live_dashboard_instance(),
        provider: ClaudeCodeProvider,
        effort: ReasoningHigh,
        model: ProviderModelPinned { model: witness_pinned_dispatch_model },
        session_uuid: "uuid-inner",
        node_id: roadmap_dispatch_actuator_nid(s: "node-inner"),
        attempt_key: "feedfacefeedface",
        worktree_path: "/opt/gunbc/dispatch-worktrees/node-inner",
        brief: "brief",
        alignment_chain_fingerprint: "fp",
        credential_snapshot: CredentialSnapshotHeld { snapshot: snapshot },
      ))
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

// ── An attempt removes only its own snapshot ────────────────────────────────────────────────────
// Holding a snapshot is not owning it. An attempt that ends holding another attempt's snapshot -- the
// one the spawn fold refuses above -- must leave that file for the attempt it was taken for, whose
// child is about to read it. Positive controls: discard_removes_the_snapshot_the_take_wrote and the
// abandoned half of an_abandoned_cursor_attempt_leaves_no_snapshot_behind, which discard for the
// attempt the snapshot was taken for.

test fn a_discard_for_another_attempt_leaves_the_snapshot_in_place() -> Bool {
  let dir = fx_dir(label: "discard-other")
  let ok = match fx_take(dir: dir, content: "custody-token-bytes\n", subject: fx_unlaunched_subject()) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } =>
      match dispatch_credential_snapshot_discard(
        snapshot: snapshot,
        attempt: fx_subject(instance: srv1_live_dashboard_instance(), node: "node-snapshot-unlaunched", attempt: "0000000000000001", provider: ClaudeCodeProvider),
      ) {
        CredentialSnapshotLeftToItsAttempt { reason } =>
          string_contains(s: reason as String, pattern: "attempt 0000000000000000")
            && Filesystem.Read(path: fx_snapshot(dir: dir)).content == "custody-token-bytes\n"
        CredentialSnapshotRemoved => false
        CredentialSnapshotRemovalFailed { reason: _ } => false
      }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}

test fn a_failed_attempt_leaves_another_attempts_snapshot_in_place() -> Bool {
  let id = launch_identity_exemplar()
  let dir = fx_dir(label: "belt-other")
  let ok = match fx_take(dir: dir, content: "cursor-key\n", subject: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "0123456789abcdef", provider: CursorDispatchProvider)) {
    DispatchSnapshotRefused { reason: _ } => false
    DispatchSnapshotTaken { snapshot } => {
      let outcome = belt_snapshot_owned_outcome(
        snapshot: snapshot,
        attempt: fx_subject(instance: srv2_lab_dashboard_instance(), node: "node-worker-turn", attempt: "fedcba9876543210", provider: CursorDispatchProvider),
        provider_wire_label: "cursor",
        launch: id,
        outcome: SpawnFailed { node_id: "node-worker-turn", step: "credential-snapshot-other-attempt", detail: "refused", provider: "cursor", launch: id },
      )
      let still_failed = match outcome {
        SpawnFailed { node_id: _, step, detail: _, provider: _, launch: _ } => step == "credential-snapshot-other-attempt"
        Spawned { node_id: _, session_name: _, provider: _, launch: _ } => false
        SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => false
        SpawnNotAdmitted { node_id: _, refusal: _ } => false
      }
      still_failed && Filesystem.Read(path: fx_snapshot(dir: dir)).success
    }
  }
  let cleaned = fx_cleanup(dir: dir)
  ok && cleaned
}
