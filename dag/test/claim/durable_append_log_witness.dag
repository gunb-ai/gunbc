module test.claim.durable_append_log_witness

import std.types { Bool, Int, String, NonEmptyStr, List }
import std.nat { Nat }
import std.measure { ByteSize, byte_size }
import std.optional { Present, Absent }
import gunbc.durable_append_log_store { AppendLogSlot, AppendLogListingVerdict, ListingClean, ListingUnlisted, ListingLegacy, AppendLogLegacyCause, LegacyFramingMismatch, LegacyDuplicateClaim, append_log_listing_verdict, append_log_census_slots }
import gunbc.roadmap.roadmap_attempt_state_store {
  AttemptLogMember, AttemptWorkerLog, AttemptWorkerEvents, AttemptReviewEvents, AttemptReviewLog,
  AttemptAuditEvents, AttemptAuditLog, AttemptSupervisorEvents, AttemptSupervisorLog, attempt_append_log_member_slot,
}
import std.process { ProcessExit }
import gunbc.compile_census_probe { census_delta_verdict, census_exit, census_verdict, total_blocking_census, CensusVerdict, deleted_callable_route_is_gone }
import std.durable_exclusive_hold { DurableHoldOwnerRef, SectionObservedComplete, SectionCompletionUnobservable }
import std.durable_append_log {
  AppendFraming, InPlaceRecordFile, AppendObservation, StreamObserved, InPlaceRecordObserved, InPlaceRecordObservation, InPlaceRecordAbsent, InPlaceRecordDecoded, InPlaceRecordUndecodable, append_readback,
  AppendLogHead, NewlineDelimitedStream, RecordPerGeneration, AppendExpectation, AppendExpected, append_log_expectation,
  AppendStreamObservation, AppendWriterStanding, WriterHoldsWindow, WriterWindowReleased, WriterStandingUnobserved,
  AppendLogReadback, AppendLogSettled, AppendLogOpenPrefix, AppendLogTornTail, AppendLogStandingUnobserved,
  append_stream_readback,
  MemberWriterPolicy, HostOnly, HostCreatesThenSandboxWrites, AppendWriter, HostWriter, SandboxWriter,
  AppendWriteAdmission, AppendWriteAdmitted, AppendWriteRefused,
  AppendWriteRefusal, WriterStandingUnknown,
  append_write_admission, append_host_create_admission,
  WriterExitObservation, WriterExitSeen, WriterExitUnseen, WriterExitedClean, append_window_completion,
}

// THE APPEND-LOG / MULTI-WRITER CONTRACT (std.durable_append_log, gunbc.durable_append_log_store).
// GREEN controls first: the pure contract answers every law it declares. Then the EXPECTING-RED claims the
// implementation lane must make pass: each hands the compiler a source the migrated tree must refuse (or a
// symbol the migrated tree must have deleted) and asserts the refusal. They fail today because the unsealed
// log members are still reachable through the generic attempt-state write and the events initializer, and
// they are enrolled in v2.workflow.floor_expected_red `floor_expected_red_chunk_append_log_store`.
// When the implementation lands they pass, the roster reports them stale, and the row is deleted, leaving
// each as a permanent regression control (DESIGN 4b(4)).

fn worker() -> DurableHoldOwnerRef { "attempt-worker-unit" as DurableHoldOwnerRef }
fn other() -> DurableHoldOwnerRef { "another-writer" as DurableHoldOwnerRef }

fn bytes(n: Nat) -> ByteSize { byte_size(count: n) }

fn obs(records: List<String>, settled: Nat, tail: Nat) -> AppendStreamObservation {
  AppendStreamObservation { complete_records: records, settled_bytes: bytes(n: settled), tail_bytes: bytes(n: tail) }
}

fn handed_off() -> MemberWriterPolicy { HostCreatesThenSandboxWrites { principal: worker() } }

fn refused(a: AppendWriteAdmission) -> Bool {
  match a { AppendWriteRefused { refusal: _ } => true, AppendWriteAdmitted => false }
}

fn admitted(a: AppendWriteAdmission) -> Bool {
  match a { AppendWriteAdmitted => true, AppendWriteRefused { refusal: _ } => false }
}

// ── GREEN: ATOMICITY, ORDER AND READBACK ──────────────────────────────────────────────────────────
test fn an_empty_log_expects_the_slot_absent_and_lands_on_the_first_position() -> Bool {
  match append_log_expectation(head: AppendLogHead { record_count: 0, byte_length: bytes(n: 0) }) {
    AppendExpected { expectation: _, position: p } => p == 1
    _ => false
  }
}

test fn the_next_position_follows_the_observed_head() -> Bool {
  match append_log_expectation(head: AppendLogHead { record_count: 3, byte_length: bytes(n: 90) }) {
    AppendExpected { expectation: _, position: p } => p == 4
    _ => false
  }
}

test fn a_released_stream_ending_on_a_terminator_reads_settled() -> Bool {
  match append_stream_readback(observed: obs(records: ["a", "b"], settled: 4, tail: 0), standing: WriterWindowReleased {}) {
    AppendLogSettled { records: _, head: h } => h.record_count == 2
    _ => false
  }
}

test fn a_released_stream_with_bytes_after_the_last_terminator_is_a_torn_tail_refusal() -> Bool {
  match append_stream_readback(observed: obs(records: ["a"], settled: 2, tail: 5), standing: WriterWindowReleased {}) {
    AppendLogTornTail { complete_records: _, torn_bytes: t, head: h } => t.count == 5 && h.byte_length.count == 2
    _ => false
  }
}

test fn an_open_window_reads_as_a_prefix_not_as_damage() -> Bool {
  match append_stream_readback(observed: obs(records: ["a"], settled: 2, tail: 5), standing: WriterHoldsWindow { owner: worker() }) {
    AppendLogOpenPrefix { records: _, head: _, writer: _ } => true
    _ => false
  }
}

test fn an_unobserved_writer_standing_is_neither_settled_nor_open() -> Bool {
  match append_stream_readback(observed: obs(records: ["a"], settled: 2, tail: 0), standing: WriterStandingUnobserved { cause: "hold unreadable" as NonEmptyStr }) {
    AppendLogStandingUnobserved { cause: _ } => true
    _ => false
  }
}

// The wire member is written in place (harness_turn Filesystem.Write, no rename): it is a single torn-capable
// record file, framed InPlaceRecordFile, and its decoder is the reader's. Bytes it does not accept are refused.
// THE WIRE MEMBER'S DECLARED DISPOSITION, TAKEN THROUGH ITS READBACK. The slot is the one the census declares
// for AttemptDirectoryWire (harness_turn writes its round files in place, so they are torn-capable), and the
// control reads a truncated round through THAT slot's framing: a census that declared RecordPerGeneration
// would read the same bytes as unreadable, not as the torn-tail refusal.
fn census_framing_of(member: String) -> AppendFraming? {
  match filter(append_log_census_slots(), sl => (sl.member as String) == member) {
    Cons { head: sl, tail: _ } => Present { value: sl.framing }
    Empty {} => Absent
  }
}

test fn a_truncated_wire_round_is_refused_through_the_census_framing() -> Bool {
  match census_framing_of(member: "AttemptDirectoryWire") {
    Absent => false
    Present { value: f } => match append_readback(framing: f, observation: InPlaceRecordObserved { record: InPlaceRecordUndecodable { bytes: bytes(n: 9) } }, standing: WriterWindowReleased {}) {
      AppendLogTornTail { complete_records: _, torn_bytes: t, head: _ } => t.count == 9
      _ => false
    }
  }
}

test fn a_whole_wire_round_reads_settled_through_the_census_framing() -> Bool {
  match census_framing_of(member: "AttemptDirectoryWire") {
    Absent => false
    Present { value: f } => match append_readback(framing: f, observation: InPlaceRecordObserved { record: InPlaceRecordDecoded { record: "{}", bytes: bytes(n: 2) } }, standing: WriterWindowReleased {}) {
      AppendLogSettled { records: _, head: h } => h.record_count == 1
      _ => false
    }
  }
}

test fn a_whole_or_absent_framing_does_not_read_undecodable_bytes_as_torn() -> Bool {
  match append_readback(framing: RecordPerGeneration {}, observation: InPlaceRecordObserved { record: InPlaceRecordUndecodable { bytes: bytes(n: 9) } }, standing: WriterWindowReleased {}) {
    AppendLogUnreadable { cause: _ } => true
    _ => false
  }
}

// The eight log members' declared framing comes from the total slot function in the module that declares the
// members, NOT from the census: their MemberCensusRow entries are deleted (review 90246), so a census lookup of
// "AttemptWorkerEvents" now answers Absent. The wire member above still reads the census, because that class has
// no declaring-module slot function.
fn worker_events_declared_framing() -> AppendFraming {
  attempt_append_log_member_slot(member: AttemptWorkerEvents).framing
}

test fn an_events_member_declared_a_stream_refuses_a_record_observation() -> Bool {
  match worker_events_declared_framing() {
    NewlineDelimitedStream {} => match append_readback(framing: worker_events_declared_framing(), observation: InPlaceRecordObserved { record: InPlaceRecordAbsent {} }, standing: WriterWindowReleased {}) {
      AppendLogUnreadable { cause: _ } => true
      _ => false
    }
    _ => false
  }
}

test fn a_foreign_unterminated_record_is_refused_not_adopted() -> Bool {
  match append_stream_readback(observed: obs(records: ["a"], settled: 2, tail: 3), standing: WriterWindowReleased {}) {
    AppendLogTornTail { complete_records: r, torn_bytes: _, head: _ } => r == ["a"]
    _ => false
  }
}

fn slot_under(member: NonEmptyStr, framing: AppendFraming) -> AppendLogSlot {
  AppendLogSlot { member: member, framing: framing, writers: HostOnly {} }
}

fn events_slot() -> AppendLogSlot { slot_under(member: "events" as NonEmptyStr, framing: NewlineDelimitedStream {}) }

// THE LISTING VERDICT DERIVES ITS CLAIMANTS from the listing and the slot's own member name. (The sealed
// AppendLogParent is minted only by the owning store, so the witness drives the verdict the mint folds.)
test fn the_mint_is_ready_over_a_clean_listing() -> Bool {
  match append_log_listing_verdict(slot: events_slot(), listing: Present { value: ["events"] }) {
    ListingClean => true
    _ => false
  }
}

test fn the_mint_is_unready_over_an_unlisted_parent() -> Bool {
  match append_log_listing_verdict(slot: events_slot(), listing: Absent) {
    ListingUnlisted => true
    _ => false
  }
}

test fn the_mint_refuses_two_entries_claiming_the_slot() -> Bool {
  match append_log_listing_verdict(slot: events_slot(), listing: Present { value: ["events", "events"] }) {
    ListingLegacy { cause: LegacyDuplicateClaim { entries: _ } } => true
    _ => false
  }
}

// ── GREEN: WHO MAY WRITE ──────────────────────────────────────────────────────────────────────────
// The create route is append_host_create_admission(policy, member_exists): the ONLY fact a create needs is whether
// the member is already there, because the effect it admits is an exclusive create-new. No standing argument
// exists to fabricate (review 90279); the compile-fed pair further down proves the parameter is absent.
test fn the_host_creates_the_member_once_and_only_while_it_does_not_exist() -> Bool {
  admitted(append_host_create_admission(policy: handed_off(), member_exists: false))
    && refused(append_host_create_admission(policy: handed_off(), member_exists: true))
    && admitted(append_host_create_admission(policy: HostOnly {}, member_exists: false))
    && refused(append_host_create_admission(policy: HostOnly {}, member_exists: true))
}

// APPENDS are what the sandbox window admits -- create is covered by the two claims above, so this one stays
// about the window: its own window admits, a released window refuses, another principal's window refuses.
test fn the_declared_principal_appends_only_inside_its_own_window() -> Bool {
  admitted(append_write_admission(policy: handed_off(), writer: SandboxWriter { principal: worker() }, standing: WriterHoldsWindow { owner: worker() }))
    && refused(append_write_admission(policy: handed_off(), writer: SandboxWriter { principal: worker() }, standing: WriterWindowReleased {}))
    && refused(append_write_admission(policy: handed_off(), writer: SandboxWriter { principal: other() }, standing: WriterHoldsWindow { owner: worker() }))
}

test fn a_host_only_member_refuses_the_sandbox() -> Bool {
  refused(append_write_admission(policy: HostOnly {}, writer: SandboxWriter { principal: worker() }, standing: WriterWindowReleased {}))
}

// The standing decides APPENDS: an unobserved one admits nobody, host or sandbox. (A create has no standing
// parameter at all, so there is nothing here to fabricate for a create -- see the compile-fed pair below.)
test fn an_unobserved_standing_admits_nobody() -> Bool {
  refused(append_write_admission(policy: handed_off(), writer: HostWriter {}, standing: WriterStandingUnobserved { cause: "x" as NonEmptyStr }))
    && refused(append_write_admission(policy: handed_off(), writer: SandboxWriter { principal: worker() }, standing: WriterStandingUnobserved { cause: "x" as NonEmptyStr }))
}

// THE ORDERING IS PINNED BY REFUSAL NAME, not just by "refused" (90415 round 2, requirement (a)). Under
// `HostOnly` the policy fold routes a host writer to `append_host_admission`, whose only refusal is a HELD
// window -- so a fold that consulted POLICY BEFORE THE STANDING would ADMIT a host append whose standing was
// never observed. This claim demands the refusal name the standing, and its accepted twin shows the host is
// admitted the moment a standing IS observed, so the refusal is about the standing and not about host writes.
test fn an_unobserved_standing_refuses_a_host_append_by_naming_the_standing() -> Bool {
  match append_write_admission(policy: HostOnly {}, writer: HostWriter {}, standing: WriterStandingUnobserved { cause: "x" as NonEmptyStr }) {
    AppendWriteRefused { refusal: WriterStandingUnknown { cause: _ } } =>
      admitted(append_write_admission(policy: HostOnly {}, writer: HostWriter {}, standing: WriterWindowReleased {}))
    _ => false
  }
}

// THE STANDING PARAMETER IS ABSENT FROM THE CREATE ADMISSION -- PROVEN AT COMPILE TIME, not by convention.
// Both fixtures share one import closure and one identical helper fn; the ONLY difference is the extra
// `standing:` argument on the create admission, so a blocking-diagnostic delta of >= 1 can only be that
// argument, and the accepted twin must be clean. With the closed route above: a caller cannot hand a standing to
// a create, so it cannot fabricate one either (review 90279).
data host_create_accepted_source: String = "module probe_host_create_free\nimport std.types { Bool }\nimport std.durable_append_log { AppendWriterStanding, MemberWriterPolicy, HostCreatesThenSandboxWrites, WriterWindowReleased, AppendWriteAdmitted, AppendWriteRefused, append_host_create_admission }\nfn standing_shape() -> AppendWriterStanding { WriterWindowReleased {} }\nfn f(p: MemberWriterPolicy) -> Bool {\n  match append_host_create_admission(policy: p, member_exists: false) {\n    AppendWriteAdmitted => true\n    AppendWriteRefused { refusal: _ } => false\n  }\n}\n"

data host_create_with_standing_source: String = "module probe_host_create_standing\nimport std.types { Bool }\nimport std.durable_append_log { AppendWriterStanding, MemberWriterPolicy, HostCreatesThenSandboxWrites, WriterWindowReleased, AppendWriteAdmitted, AppendWriteRefused, append_host_create_admission }\nfn standing_shape() -> AppendWriterStanding { WriterWindowReleased {} }\nfn f(p: MemberWriterPolicy) -> Bool {\n  match append_host_create_admission(policy: p, standing: WriterWindowReleased {}, member_exists: false) {\n    AppendWriteAdmitted => true\n    AppendWriteRefused { refusal: _ } => false\n  }\n}\n"

test fn the_accepted_host_create_route_compiles_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: host_create_accepted_source), holds: fn(n) { n == 0 }))
}

test fn a_standing_handed_to_the_host_create_admission_is_refused_at_compile() -> ProcessExit {
  census_exit(census_delta_verdict(
    red: total_blocking_census(source: host_create_with_standing_source),
    control: total_blocking_census(source: host_create_accepted_source),
    holds: fn(n) { n >= 1 },
  ))
}

// THE HOLE IS A CONSTRUCTION HOLE, SO THE CONTROL IS A COMPILER, NOT A RUNTIME REFUSAL. `AppendWriteIntent`
// is gone and the append admission takes no intent at all: an append call names (policy, writer, standing), and
// the create-intent call below has no such parameter AND names a type that no longer exists. The two fixtures are
// the same call in the same import closure, differing only by that `intent:` argument, so a blocking-diagnostic
// delta of >= 1 can only be the create intent, and the append twin must be clean. No runtime "the create is
// refused" claim is writable any more -- that is the point: the mistake cannot be written, so no arm of any
// admission ever decides whether a standing or a policy speaks about a create.
data append_intent_accepted_source: String = "module probe_append_intent_ok\nimport std.types { Bool }\nimport std.durable_exclusive_hold { DurableHoldOwnerRef }\nimport std.durable_append_log { HostCreatesThenSandboxWrites, HostWriter, WriterWindowReleased, AppendWriteAdmitted, AppendWriteRefused, append_write_admission }\nfn principal() -> DurableHoldOwnerRef { \"worker\" as DurableHoldOwnerRef }\nfn f() -> Bool {\n  match append_write_admission(policy: HostCreatesThenSandboxWrites { principal: principal() }, writer: HostWriter {}, standing: WriterWindowReleased {}) {\n    AppendWriteAdmitted => true\n    AppendWriteRefused { refusal: _ } => false\n  }\n}\n"

data append_intent_create_source: String = "module probe_append_intent_create\nimport std.types { Bool }\nimport std.durable_exclusive_hold { DurableHoldOwnerRef }\nimport std.durable_append_log { HostCreatesThenSandboxWrites, HostWriter, IntentCreateEmpty, WriterWindowReleased, AppendWriteAdmitted, AppendWriteRefused, append_write_admission }\nfn principal() -> DurableHoldOwnerRef { \"worker\" as DurableHoldOwnerRef }\nfn f() -> Bool {\n  match append_write_admission(policy: HostCreatesThenSandboxWrites { principal: principal() }, writer: HostWriter {}, intent: IntentCreateEmpty {}, standing: WriterWindowReleased {}) {\n    AppendWriteAdmitted => true\n    AppendWriteRefused { refusal: _ } => false\n  }\n}\n"

test fn the_append_admission_takes_no_intent_and_constructs_clean() -> ProcessExit {
  census_exit(census_verdict(census: total_blocking_census(source: append_intent_accepted_source), holds: fn(n) { n == 0 }))
}

test fn a_create_intent_handed_to_the_append_admission_does_not_construct() -> ProcessExit {
  census_exit(census_delta_verdict(
    red: total_blocking_census(source: append_intent_create_source),
    control: total_blocking_census(source: append_intent_accepted_source),
    holds: fn(n) { n >= 1 },
  ))
}

// ── EXPECTING-RED: WHAT THE IMPLEMENTATION LANE MUST MAKE PASS ────────────────────────────────────
fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data baseline_source: String = "module probe_append_log_baseline\nimport std.types { String }\nimport gunbc.roadmap.roadmap_attempt_state_store { AttemptState, AttemptWorkerLog, AttemptLaunchIdentity, attempt_state_write, attempt_state_read }\nfn f(s: AttemptState) -> String {\n  \"\"\n}\n"

data log_member_write_source: String = "module probe_append_log_member_write\nimport std.types { String }\nimport gunbc.roadmap.roadmap_attempt_state_store { AttemptState, AttemptWorkerEvents, AttemptWorkerLog, AttemptLaunchIdentity, attempt_state_write, attempt_state_read }\nfn f(s: AttemptState) -> String {\n  let w = attempt_state_write(store: s, member: AttemptWorkerEvents, content: \"x\")\n  \"\"\n}\n"

data plain_member_write_source: String = "module probe_append_log_plain_write\nimport std.types { String }\nimport gunbc.roadmap.roadmap_attempt_state_store { AttemptState, AttemptKeyRecord, attempt_state_write }\nfn f(s: AttemptState) -> String {\n  let w = attempt_state_write(store: s, member: AttemptKeyRecord, content: \"x\")\n  \"\"\n}\n"

data events_initializer_source: String = "module probe_append_log_events_initializer\nimport std.types { String }\nimport gunbc.roadmap.roadmap_attempt_state_store { AttemptState, AttemptWorkerLog, AttemptLaunchIdentity, attempt_state_write, attempt_state_read }\nimport gunbc.roadmap.roadmap_dispatch_actuator { dispatch_attempt_events_initialize_for_instance }\nfn f(s: AttemptState) -> String {\n  \"\"\n}\n"

// GREEN CONTROL (flipped by this PR): the log and sandbox-written members have left AttemptStateMember and are
// reached only through the sealed AppendLogStore, so a log member is NOT a value of the generic write's parameter
// type -- passing one is a keyed type error on the real acceptance path, not a runtime branch.
test fn a_log_member_cannot_be_written_through_the_generic_attempt_state_write() -> ProcessExit {
  census_exit(blocking_delta(hostile: log_member_write_source, safe: baseline_source, holds: fn(n) { n >= 1 }))
}

// POSITIVE CONTROL: the barrier refuses log members WITHOUT rejecting plain members -- writing a plain
// AttemptStateMember through attempt_state_write still compiles clean, so the hostile delta is not a blanket
// "attempt_state_write is broken" but specifically the log member leaving the accepted type.
test fn a_plain_member_is_accepted_by_the_generic_attempt_state_write() -> ProcessExit {
  census_exit(blocking_delta(hostile: plain_member_write_source, safe: baseline_source, holds: fn(n) { n == 0 }))
}

// KEYED CLAIM (flipped GREEN by this PR's deletion): THE EVENTS FILE IS NO LONGER CREATED BY A BARE
// Filesystem.WriteCreateNewWithMode IN dispatch_attempt_events_initialize_for_instance. That callable is deleted,
// so importing it yields a keyed MissingExport on that exact name (== 1) plus a blocking delta over baseline --
// not a mere total-blocking count that any unrelated error could satisfy.
test fn the_raw_events_initializer_is_gone() -> ProcessExit {
  deleted_callable_route_is_gone(source: events_initializer_source, baseline: baseline_source, deleted_callable: "dispatch_attempt_events_initialize_for_instance")
}

// The seal control moved with the seal: a foreign module cannot sole_construct AttemptAppendLogStore (the
// business-key log store), asserted in the roadmap witness. The generic AppendLogParent/AppendLogStore are now an
// unsealed data carrier -- constructible anywhere -- recorded as the same residual as a_slot_store_is_built_over_a_literal_path_by_any_module, so the generic witness no longer asserts they are blocked.

fn census_slot_mint_unclean(slot: AppendLogSlot) -> Bool {
  match append_log_listing_verdict(slot: slot, listing: Present { value: [] }) {
    ListingClean => false
    _ => true
  }
}

// EVERY LOG MEMBER'S SLOT, over the whole closed set: each mints clean over an empty listing and admits its own
// principal's append inside the window. The slots come from the TOTAL match in the declaring module (review 90246),
// not from a string-keyed census row -- a variant without a slot does not compile, so this control's job is the
// VALUE of each slot (framing and writer policy), not whether it exists. The sample list feeds that fn one
// argument per variant; it is not a second authority, the fn is.
fn attempt_log_member_samples() -> List<AttemptLogMember> {
  [
    AttemptWorkerLog,
    AttemptWorkerEvents,
    AttemptReviewEvents { criterion_key: "c", head_sha: "h" },
    AttemptReviewLog { criterion_key: "c" },
    AttemptAuditEvents { head_sha: "h" },
    AttemptAuditLog,
    AttemptSupervisorEvents { turn: 3 },
    AttemptSupervisorLog,
  ]
}

test fn every_declared_log_member_slot_mints_clean_over_an_empty_listing() -> Bool {
  match filter(
    map(attempt_log_member_samples(), m => attempt_append_log_member_slot(member: m)),
    sl => census_slot_mint_unclean(slot: sl),
  ) {
    Empty {} => true
    _ => false
  }
}

// The count a readback states is the length of the records it returns, by construction.
test fn the_head_count_is_the_length_of_the_returned_records() -> Bool {
  match append_stream_readback(observed: obs(records: ["a", "b", "c"], settled: 6, tail: 0), standing: WriterWindowReleased {}) {
    AppendLogSettled { records: _, head: h } => h.record_count == 3
    _ => false
  }
}

// The window ends on evidence: a seen exit completes the section, an unseen one is not a completion.
test fn a_seen_writer_exit_completes_the_window() -> Bool {
  match append_window_completion(observed: WriterExitSeen { exit: WriterExitedClean {} }) {
    SectionObservedComplete { observation: _ } => true
    _ => false
  }
}

test fn an_unseen_writer_exit_does_not_complete_the_window() -> Bool {
  match append_window_completion(observed: WriterExitUnseen { cause: "unit state unreadable" as NonEmptyStr }) {
    SectionCompletionUnobservable { cause: _ } => true
    _ => false
  }
}

// A healthy in-place member (its own file present in the parent) mints clean; only a generation file of its
// key is another framing.
fn wire_slot_verdict(listing: List<String>) -> AppendLogListingVerdict? {
  match filter(append_log_census_slots(), sl => (sl.member as String) == "AttemptDirectoryWire") {
    Cons { head: sl, tail: _ } => Present { value: append_log_listing_verdict(slot: sl, listing: Present { value: listing }) }
    Empty {} => Absent
  }
}

test fn an_in_place_member_with_its_own_file_present_mints_clean() -> Bool {
  match wire_slot_verdict(listing: ["AttemptDirectoryWire"]) {
    Present { value: ListingClean } => true
    _ => false
  }
}
