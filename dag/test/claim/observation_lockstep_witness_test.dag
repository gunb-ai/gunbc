module test.claim.observation_lockstep_witness_test

import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.types { String, Bool, List }
import std.observation { ObservationLaw, observation_laws, observation_heartbeat_period }
import std.measure { millisecond_count }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_note: String = "Lockstep half of the P0 acceptance (docs/plans/progress-observation-design.md section 5): the laws are data rows and the substrate model is the authority, so both are held against the live tree rather than against a restatement. Three couplings are proven by execution here, each with a negative control in the same run — a name known to be absent must read as absent, which is what separates this from a grep that passes vacuously. One, no orphan law: every law row names a declaration that must actually exist in std.observation, so a law cannot be a sentence nobody executes. Two, the SchedulerHold coproduct and the seed governor HoldReason must carry the same variants, so a hold reason added on one side reds instead of silently rendering as a missing cause. Three, the heartbeat cadence the dwell threshold is derived from is read out of the seed that actually sleeps it.\n\nTHE THIRD COUPLING WAS POINTED AT A SUBJECT THAT NO LONGER EXISTED, AND THIS WITNESS COULD NOT SAY SO. Its two heartbeat rows named src/v1/stage0/src/bin/claim_executor.rs and asked for from_secs(60), floor-memory-heartbeat, refusing to fabricate, render_heartbeat_line_mirror and heartbeat_feed_snapshot. #9228 deleted the plan/walk surface those lived on, so from the moment it merged all five needles were absent and both rows were false. Nothing reported it: this module declares ReadsLiveTree, so the required floor DECLINES it before the fold — discovered, counted, never executed. A decline renders identically to a pass, which is the execution-provenance failure DESIGN names, and it is the reason a stale lockstep survived a deletion that falsified it.\n\nWHAT THE ROWS NAME NOW, and it is a live successor rather than a retirement. The floor still emits a periodic progress line; it moved to cli_run.rs spawn_floor_heartbeat as a raw [floor-heartbeat] eprintln with no projection behind it, which gunbc.observation_emit_census already carries as a CountedFrontierSite with its restoration trigger. The cadence row reads that thread period — GUNBC_FLOOR_HEARTBEAT_SECS defaulting to 60 — against observation_heartbeat_period, so the derivation the dwell threshold rests on is grounded in the seed again. The no-fabrication row holds the successor to seed_heartbeat_unreadable_cause: an unreadable measurement renders as the na sentinel and never as a number. That row was RED BY EXECUTION when it was written — floor_resource_sample answered a fabricated 0 for rss_kb, cpu_ms and majflt while its cgroup and vmstat readers already answered na, so rss_kb=0 meant either no resident pages, which a live process cannot have, or an unreadable /proc/self/statm. The seed was repaired to one sentinel and the row is the standing control that it stays that way; its third conjunct asks for the FABRICATING spelling to be absent, so restoring the zero reds here."

data observation_module_path: String = "dag/std/observation.dag"
data governor_source_path: String = "src/v1/stage0/src/memory_governor.rs"
data heartbeat_source_path: String = "src/v1/stage0/src/cli_run.rs"

fn lockstep_source(path: String) -> String {
  let r = filesystem_read(path: path)
  r.content
}

fn lockstep_has(path: String, needle: String) -> Bool {
  string_contains(s: lockstep_source(path: path), pattern: needle)
}

test fn w_every_law_names_a_declaration_that_exists() -> Bool {
  let src = lockstep_source(path: observation_module_path)
  fold(observation_laws, init: true, f: (acc, l) =>
    acc && string_contains(s: src, pattern: concat("fn ", concat(l.enforced_by.decl_name, "(")))
  )
}

test fn w_orphan_law_check_discriminates() -> Bool {
  let src = lockstep_source(path: observation_module_path)
  !string_contains(s: src, pattern: "fn observation_law_with_no_enforcer(")
}

data governor_hold_variants: List<String> = [
  "WindowFull",
  "CurrentHighWater",
  "PsiPressure",
  "SwapGrowth",
  "AwaitFirstCost",
  "InsufficientHeadroom",
  "AdmissionCeiling"
]

test fn w_scheduler_hold_is_in_lockstep_with_the_seed_governor() -> Bool {
  let governor = lockstep_source(path: governor_source_path)
  let model = lockstep_source(path: observation_module_path)
  fold(governor_hold_variants, init: true, f: (acc, v) =>
    acc &&
    string_contains(s: governor, pattern: concat("HoldReason::", v)) &&
    string_contains(s: model, pattern: v)
  )
}

test fn w_lockstep_check_discriminates() -> Bool {
  let governor = lockstep_source(path: governor_source_path)
  let model = lockstep_source(path: observation_module_path)
  !string_contains(s: governor, pattern: "HoldReason::DiskPressure") &&
  !string_contains(s: model, pattern: "DiskPressure")
}

test fn w_heartbeat_period_matches_the_seed_cadence() -> Bool {
  millisecond_count(m: observation_heartbeat_period) == 60000 &&
  lockstep_has(path: heartbeat_source_path, needle: "[floor-heartbeat] wall_s=") &&
  lockstep_has(path: heartbeat_source_path, needle: "GUNBC_FLOOR_HEARTBEAT_SECS") &&
  lockstep_has(path: heartbeat_source_path, needle: ".unwrap_or(60)")
}

test fn w_heartbeat_cadence_check_discriminates() -> Bool {
  !lockstep_has(path: heartbeat_source_path, needle: "GUNBC_FLOOR_HEARTBEAT_MINUTES") &&
  !lockstep_has(path: heartbeat_source_path, needle: "floor-memory-heartbeat")
}

test fn w_heartbeat_source_still_refuses_to_fabricate() -> Bool {
  lockstep_has(path: heartbeat_source_path, needle: "unwrap_or_else(na)") &&
  lockstep_has(path: heartbeat_source_path, needle: ".map(|pages| (pages * 4).to_string())") &&
  !lockstep_has(path: heartbeat_source_path, needle: ".map(|pages| pages * 4)")
}
