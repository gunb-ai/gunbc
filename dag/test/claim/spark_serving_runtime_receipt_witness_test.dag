module test.claim.spark_serving_runtime_receipt_witness_test

import std.types { String, NonEmptyStr, FilePath, Bool }
import product.placement_supply { HostIdentity }
import extdeps.shell
import gunbc.spark_serving_readback_parse {
  SparkServingReadbackPresent,
  SparkServingReadbackAbsent,
  SparkServingReadbackRefused,
}
import gunbc.spark_serving_runtime_receipt {
  SparkServingRuntimeInstallReceipt,
  write_spark_serving_runtime_install_receipt_at_path,
  read_spark_serving_runtime_install_receipt_bytes_at_path,
  spark_serving_runtime_install_receipt_json,
  spark_serving_parse_runtime_receipt_json,
  spark_serving_runtime_receipt_wire_path,
}
import gunbc.package_delivery {
  spark_serving_ollama_runtime_materialization_receipt_write_path,
}

data witness_required_release_asset_digest_hex: String = "79617139521db251c716d6229505d7530171ff4d68e476d0c22dabc15726a237"

data witness_spark_host: HostIdentity = "srv5" as HostIdentity

test fn witness_materialization_writer_targets_reader_wire_path() -> Bool {
  (spark_serving_ollama_runtime_materialization_receipt_write_path(
    host: witness_spark_host,
  ) as String)
    == (spark_serving_runtime_receipt_wire_path(host: witness_spark_host) as String)
}

test fn witness_runtime_install_receipt_json_round_trips_digest() -> Bool {
  let json = spark_serving_runtime_install_receipt_json(
    receipt: SparkServingRuntimeInstallReceipt {
      host: witness_spark_host,
      release_asset_digest_hex: witness_required_release_asset_digest_hex as NonEmptyStr,
    },
  )
  match spark_serving_parse_runtime_receipt_json(stdout: json) {
    SparkServingReadbackPresent { value: hex } =>
      hex == witness_required_release_asset_digest_hex
    SparkServingReadbackAbsent => false
    SparkServingReadbackRefused { cause: _ } => false
  }
}

test fn witness_runtime_install_receipt_write_read_round_trips_digest() -> Bool {
  let staging = shell.Mktemp.Dir()
  if staging.success == false {
    false
  } else {
    let path = concat(staging.path as String, "/ollama-runtime-receipt.json") as FilePath
    let receipt = SparkServingRuntimeInstallReceipt {
      host: witness_spark_host,
      release_asset_digest_hex: witness_required_release_asset_digest_hex as NonEmptyStr,
    }
    if write_spark_serving_runtime_install_receipt_at_path(path: path, receipt: receipt) == false {
      false
    } else {
      match read_spark_serving_runtime_install_receipt_bytes_at_path(path: path) {
        Absent => false
        Present { value: bytes } =>
          match spark_serving_parse_runtime_receipt_json(stdout: bytes) {
            SparkServingReadbackPresent { value: hex } =>
              hex == witness_required_release_asset_digest_hex
            SparkServingReadbackAbsent => false
            SparkServingReadbackRefused { cause: _ } => false
          }
      }
    }
  }
}
