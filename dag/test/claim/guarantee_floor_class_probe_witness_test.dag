test fn floor_v2_module_exemption_silences_the_direct_call_argument_judgment() -> Bool {
  silent_hole_holds(probe: floor_conformance_v2_exemption_hole_probe, source: conformance_v2_exemption_hole_source)
    && blocking_count(source: conformance_v2_exemption_hole_source, wanted: "TypeMismatch") == 0
}

test fn floor_v2_module_exemption_control_outside_v2_refuses_the_same_source() -> Bool {
  row_holds(probe: floor_conformance_v2_exemption_control_probe, source: conformance_v2_exemption_control_source)
    && blocking_count(source: conformance_v2_exemption_control_source, wanted: "TypeMismatch") == 1
}

test fn floor_v2_module_exemption_pair_differs_only_in_the_caller_module_name() -> Bool {
  match census_any_count_for_class(census: census_of(source: conformance_v2_exemption_hole_source), wanted: "TypeMismatch") {
    Present { value: exempt_any } =>
      match census_any_count_for_class(census: census_of(source: conformance_v2_exemption_control_source), wanted: "TypeMismatch") {
        Present { value: plain_any } => exempt_any == 0 && plain_any == 1
        Absent => false
      }
    Absent => false
  }
}

test fn floor_record_completeness_receipt_joins_its_v1_compile_path() -> Bool {
  match active_v1_compile_probe_row(probe: floor_record_completeness_red_probe) {
    Present { value: row } =>
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: record_completeness_red_source),
        subject_revision: synthetic_program_subject_revision(source: record_completeness_red_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      receipt_joins_v1_compile_path(receipt: receipt)
        && receipt_matches_v1_compile_probe_row(receipt: receipt, row: row)
        && observed_is_verdict(o: receipt.observed)
        && observation_refused_count(o: receipt.observed) == 1
        && (receipt.path as String) == (v1_compile_rust_path_id as String)
    Absent => false
  }
}

test fn floor_hole_receipt_records_acceptance_as_the_observation() -> Bool {
  match active_v1_compile_probe_row(probe: floor_generic_instantiation_hole_probe) {
    Present { value: row } =>
      let receipt = build_v1_compile_receipt(
        row: row,
        census: census_of(source: generic_instantiation_hole_source),
        subject_revision: synthetic_program_subject_revision(source: generic_instantiation_hole_source),
        harness_revision: witness_harness_revision(probe: row.probe),
      )
      observation_is_clean(o: receipt.observed)
        && receipt_matches_v1_compile_probe_row(receipt: receipt, row: row)
    Absent => false
  }
}

test fn every_below_floor_hole_row_is_one_of_the_five_declared_holes() -> Bool {
  let declared = [
    floor_exhaustiveness_type_variable_hole_probe as String,
    floor_conformance_v2_exemption_hole_probe as String,
    floor_field_through_generics_hole_probe as String,
    floor_generic_instantiation_hole_probe as String,
    floor_parse_list_separator_hole_probe as String,
  ]
  let hole_ids = guarantee_probe_below_floor_hole_rows() |> map(row => row.probe as String)
  let every_hole_declared = fold(hole_ids, init: true, f: (acc, id) => acc && (declared |> filter(d => d == id) |> count) == 1
  )
  let every_declared_is_a_hole = fold(declared, init: true, f: (acc, id) => acc && (hole_ids |> filter(h => h == id) |> count) == 1
  )
  every_hole_declared && every_declared_is_a_hole
}

test fn every_declared_floor_class_has_registry_rows() -> Bool {
  let classes = [
    floor_closed_match_exhaustiveness_class as String,
    floor_declared_conformance_v2_exemption_class as String,
    floor_field_through_generics_class as String,
    floor_generic_instantiation_class as String,
    floor_parse_list_separator_class as String,
    floor_record_field_completeness_class as String,
  ]
  let rows = guarantee_probe_rows()
  fold(classes, init: true, f: (acc, cls) => acc && count(rows |> filter(row => (row.class as String) == cls)) >= 1)
}
