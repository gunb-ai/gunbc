module test.claim.gha_job_projection_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data gha_job_projection_witness_note: String = "THE CONSTRUCTION-LEVEL WALL AGAINST FUTURE INERT Job FIELDS, and the reason it is one synthetic all-fields job rather than a per-field assertion against ci.yml. job_yaml silently dropped four of the Job type's emittable fields (see job_field_projection_completeness_note); a per-field check against the real workflows could not have caught any of them, because every Job in the corpus sets those fields to none — so the real artifacts are indistinguishable from an emitter that ignores the fields entirely. The only discriminating subject is a job that POPULATES every optional field, which is why one is constructed here. Two directions are asserted and both are load-bearing: all_fields_job proves each populated fact reaches the emitted yaml (a new dropped field reds), and minimal_job proves an absent field emits NO key (a projection that started emitting an empty `outputs: {}` or a bare `name:` also reds). Without the second direction the first is satisfiable by unconditionally emitting every key. This is validation, not construction — DESIGN §5's preference is a model from which the projection is derived so a dropped field is unwritable, and that is not reachable while job_yaml is a hand-written fold over named fields; until it is, this witness is the residue mechanism and it is enrolled rather than inert. A field ADDED to Job without being added here and to job_yaml is the gap this cannot close: it fails open on additions, which is why the note on the emitter side carries the field roster explicitly."

fn probe_step() -> extdeps.github.actions.Step {
  extdeps.github.actions.RunStep {
    name: Present { value: "probe" },
    id: none,
    run: "true",
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

fn all_fields_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "all_fields",
    name: Present { value: "Every Optional Field Populated" },
    runner: extdeps.github.actions.HostedRunner { label: UbuntuLatest },
    steps: [probe_step()],
    needs: ["upstream"],
    env: Present { value: [kv(key: "PROBE_ENV", value: yaml_string(s: "env-value"))] },
    outputs: Present { value: [kv(key: "probe_out", value: yaml_string(s: "output-value"))] },
    if_condition: Present { value: "github.event_name == 'push'" },
    timeout_minutes: Present { value: 7 },
    continue_on_error: Present { value: true },
    concurrency: Present {
      value: extdeps.github.actions.ConcurrencyMappingQueueMax {
        group: "probe-queue-max-group",
        cancel_in_progress: Present { value: QueueMaxCancelInProgressFalse }
      }
    },
    permissions: Present {
      value: extdeps.github.actions.WorkflowPermissions {
        contents: Present { value: PermRead },
        pull_requests: none,
        issues: none,
        actions: none,
        id_token: none
      }
    }
  }
}

fn minimal_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "minimal",
    name: none,
    runner: extdeps.github.actions.HostedRunner { label: UbuntuLatest },
    steps: [probe_step()],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: none,
    permissions: none
  }
}

fn all_fields_yaml() -> String {
  serialize_yaml(v: job_yaml(job: all_fields_job()))
}

fn minimal_yaml() -> String {
  serialize_yaml(v: job_yaml(job: minimal_job()))
}

test fn every_populated_job_field_reaches_the_emitted_yaml() -> Bool {
  let y = all_fields_yaml()
  string_contains(s: y, pattern: "name: Every Optional Field Populated")
    && string_contains(s: y, pattern: "runs-on: ubuntu-latest")
    && string_contains(s: y, pattern: "needs:")
    && string_contains(s: y, pattern: "upstream")
    && string_contains(s: y, pattern: "timeout-minutes: 7")
    && string_contains(s: y, pattern: "if: github.event_name == 'push'")
    && string_contains(s: y, pattern: "permissions:")
    && string_contains(s: y, pattern: "contents: read")
    && string_contains(s: y, pattern: "concurrency:")
    && string_contains(s: y, pattern: "outputs:")
    && string_contains(s: y, pattern: "probe_out: output-value")
    && string_contains(s: y, pattern: "steps:")
    && string_contains(s: y, pattern: "env:")
    && string_contains(s: y, pattern: "PROBE_ENV: env-value")
    && string_contains(s: y, pattern: "continue-on-error: true")
}

data absent_field_adjacency_note: String = "Asserted as ADJACENCY rather than as per-key absence, because a bare !contains(\"name:\") is unsound here: the probe STEP carries `name: probe`, so a key-name absence check over the whole document conflates job-level keys with step-level ones and reds on a correct emitter (observed — this witness failed that way first). Adjacency is also the stronger claim: runs-on is the first key when name is absent and steps is the first key after the optional block, so requiring them CONTIGUOUS proves that none of name/needs/timeout-minutes/if/permissions/concurrency/outputs emitted anything at all — one assertion covering the whole optional block, and it breaks if any single one starts emitting an empty key. The trailing keys (env, continue-on-error) sit after steps and are checked separately at top-level indent."

test fn absent_job_fields_emit_no_key() -> Bool {
  let y = minimal_yaml()
  string_contains(s: y, pattern: "runs-on: ubuntu-latest\nsteps:")
    && !string_contains(s: y, pattern: "\nenv:")
    && !string_contains(s: y, pattern: "\ncontinue-on-error:")
    && !string_contains(s: y, pattern: "\noutputs:")
    && !string_contains(s: y, pattern: "\nconcurrency:")
}

test fn queue_max_emits_the_queue_key() -> Bool {
  let y = all_fields_yaml()
  string_contains(s: y, pattern: "queue: max")
    && string_contains(s: y, pattern: "group: probe-queue-max-group")
    && string_contains(s: y, pattern: "cancel-in-progress: false")
}

fn queue_not_max_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "queue_not_max",
    name: none,
    runner: extdeps.github.actions.HostedRunner { label: UbuntuLatest },
    steps: [probe_step()],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: Present {
      value: extdeps.github.actions.ConcurrencyMappingQueueNotMax {
        group: "probe-queue-max-group",
        cancel_in_progress: Present { value: extdeps.github.actions.CancelInProgressBool { value: false } },
        explicit_single: none
      }
    },
    permissions: none
  }
}

fn queue_max_only_job() -> extdeps.github.actions.Job {
  extdeps.github.actions.Job {
    id: "queue_max_only",
    name: none,
    runner: extdeps.github.actions.HostedRunner { label: UbuntuLatest },
    steps: [probe_step()],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: Present {
      value: extdeps.github.actions.ConcurrencyMappingQueueMax {
        group: "probe-queue-max-group",
        cancel_in_progress: Present { value: QueueMaxCancelInProgressFalse }
      }
    },
    permissions: none
  }
}

test fn queue_max_and_queue_not_max_no_longer_serialize_identically() -> Bool {
  let qmax = serialize_yaml(v: job_yaml(job: queue_max_only_job()))
  let qnot = serialize_yaml(v: job_yaml(job: queue_not_max_job()))
  !(qmax == qnot)
    && string_contains(s: qmax, pattern: "queue: max")
    && !string_contains(s: qnot, pattern: "queue: max")
}

test fn scalar_concurrency_group_still_projects_as_a_bare_string() -> Bool {
  let j = extdeps.github.actions.Job {
    id: "scalar",
    name: none,
    runner: extdeps.github.actions.HostedRunner { label: UbuntuLatest },
    steps: [probe_step()],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    timeout_minutes: none,
    continue_on_error: none,
    concurrency: Present { value: extdeps.github.actions.ConcurrencyScalar { group: "scalar-group" } },
    permissions: none
  }
  let y = serialize_yaml(v: job_yaml(job: j))
  string_contains(s: y, pattern: "concurrency: scalar-group")
    && !string_contains(s: y, pattern: "queue: max")
}
