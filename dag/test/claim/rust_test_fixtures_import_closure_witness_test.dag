module test.claim.rust_test_fixtures_import_closure_witness

import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.class_b_import_closure_overlay { class_b_entry_rel }
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  binding_source_is_listed_import
}
import std.types { String, Bool, List }

data class_b_witness_note: String = "Rows 1-2 of the Class B rust_test_fixtures control (#6985): declared import closure -> ListedImport; unrelated ambient pool provider leaves ListedImport unchanged. Rows 3-4 (stripped overlay + pool coincidence) live in rust_test_fixtures_import_closure_stripped_witness_test.dag and execute via v2.workflow.class_b_import_closure_transport. Consumed on the per-PR floor via discovery for rows 1-2 and by the transport for all four acceptance rows."

data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"

fn class_b_baseline_pool_roots() -> List<String> {
  witness_layer_roots
}

fn class_b_pool_with_perturbation() -> List<String> {
  concat([class_b_perturbation_overlay_rel], witness_layer_roots)
}

fn observe_class_b(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

test fn declared_import_closure_lists_rust_import() -> Bool {
  binding_source_is_listed_import(obs: observe_class_b(pool_roots: class_b_baseline_pool_roots()))
}

test fn ambient_pool_provider_preserves_listed_import() -> Bool {
  let baseline = observe_class_b(pool_roots: class_b_baseline_pool_roots())
  let perturbed = observe_class_b(pool_roots: class_b_pool_with_perturbation())
  binding_source_is_listed_import(obs: baseline)
    && binding_source_is_listed_import(obs: perturbed)
}
