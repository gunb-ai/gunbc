module test.claim.rust_test_fixtures_import_closure_witness

import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  binding_source_is_listed_import,
  row4_pool_coincidence_or_refuse,
  binding_refuses
}
import std.types { String, Bool, List }

data class_b_witness_note: String = "Executing Class B control for rust_test_fixtures (#6985). Four acceptance rows: declared import closure -> ListedImport; same closure + unrelated ambient provider -> unchanged; import removed -> REFUSE; import removed + ambient rust importer -> PoolCoincidence / REFUSE with binding-source classification. Consumed on the per-PR floor via discovery (WitnessHasExecutingConsumer / DiscoverySelection) and by v2.workflow.class_b_import_closure_transport (custom pool roots through run_gunbc_claims)."

data class_b_entry_rel: String = "src/v2/extdeps/languages/rust_test_fixtures.dag"
data class_b_consumer_module: String = "v2.extdeps.languages.rust_test"
data class_b_symbol: String = "rust_selection_policy_node"
data class_b_stripped_overlay_rel: String = "fixtures/class_b_import_closure/stripped_overlay"
data class_b_perturbation_overlay_rel: String = "fixtures/class_b_import_closure/perturbation_overlay"

fn class_b_baseline_pool_roots() -> List<String> {
  witness_layer_roots
}

fn class_b_pool_with_perturbation() -> List<String> {
  concat([class_b_perturbation_overlay_rel], witness_layer_roots)
}

fn class_b_pool_stripped_only() -> List<String> {
  concat([class_b_stripped_overlay_rel], witness_layer_roots)
}

fn class_b_pool_stripped_with_ambient() -> List<String> {
  concat([class_b_stripped_overlay_rel, class_b_perturbation_overlay_rel], witness_layer_roots)
}

fn observe_class_b(
  pool_roots: List<String>
) -> DeclaredImportClosureBindingObservation {
  observe_declared_import_closure_symbol_binding(
    pool_roots: pool_roots,
    entry_path: class_b_entry_rel,
    consumer_module: class_b_consumer_module,
    symbol: class_b_symbol
  )
}

test fn declared_import_closure_lists_rust_import() -> Bool {
  binding_source_is_listed_import(obs: observe_class_b(pool_roots: class_b_baseline_pool_roots()))
}

test fn ambient_pool_provider_preserves_listed_import() -> Bool {
  let baseline = observe_class_b(pool_roots: class_b_baseline_pool_roots())
  let perturbed = observe_class_b(pool_roots: class_b_pool_with_perturbation())
  binding_source_is_listed_import(obs: baseline)
    && binding_source_is_listed_import(obs: perturbed)
}

test fn stripped_import_closure_refuses_binding() -> Bool {
  binding_refuses(obs: observe_class_b(pool_roots: class_b_pool_stripped_only()))
}

test fn stripped_with_ambient_pool_coincidence_or_refuse() -> Bool {
  row4_pool_coincidence_or_refuse(
    obs: observe_class_b(pool_roots: class_b_pool_stripped_with_ambient())
  )
}
