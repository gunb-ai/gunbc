module test.claim.rust_test_fixtures_import_closure_witness

import v2.workflow.class_b_import_closure_transport {
  class_b_declared_import_closure_lists_rust_import,
  class_b_ambient_pool_provider_preserves_listed_import
}
import std.types { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data class_b_gate_witness_note: String = "Required-floor executing consumer for Class B rows 1-2 (#6985). These two claims already execute on the required floor: required_floor.dag excludes the long home by AUTHORED MODULE NAME (long_home_prefixes), and this module carries no long prefix, so the FalsifierSubstrateLongLane WitnessExclusionRow that once path-excluded it was inert and is deleted — this file's note previously claimed PATH-EXCLUDED from per-PR discovery, which stopped being true at the floor cut. SubstrateInputsOnly declares the live-tree disposition; it is not what puts these rows on the floor. Two claims not one: folding both rows into a single claim measured 187s/1.27GB RSS on CI versus ~60s/0.28GB as separate claims. COST: both rows are PassedOverBudget against the 1552ms ceiling and land STALE-QUARANTINE plus BUDGET-REFUSED; the root cause is what class_b_import_closure_transport reaches for, not this file, and splitting a witness to move it under the ceiling is refused as a measurement artifact (gunbc.witness_row_cost witness_decomposition_does_not_reduce_entry_cost_note). Rows 3-4 stay in class_b_import_closure_binding_refusal_witness_test.dag and class_b_strip_receipt_witness_test.dag; wet integration remains run_class_b_import_closure_gate on source_root_ingest_gate."

test fn declared_import_closure_lists_rust_import() -> Bool {
  class_b_declared_import_closure_lists_rust_import()
}

test fn ambient_pool_provider_preserves_listed_import() -> Bool {
  class_b_ambient_pool_provider_preserves_listed_import()
}
