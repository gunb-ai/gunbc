module test.claim.gpu_duct_witness

import std.types { Bool, Int, List }
import std.measure { Micrometer, micrometer, micrometer_count }
import product.printed_chassis.assembly_geometry { AssemblyPart, Primitive }
import product.printed_chassis.assembly_review_checks { Bounds, primitive_bounds, review_model_checks }
import product.printed_chassis.gpu_duct {
  GpuDuctAdmission, GpuDuctAdmitted, GpuDuctInsertReadingsDisagree, GpuDuctFinsAtTheWindowFace, GpuDuctFanMountRefused,
  GpuDuctWindowDeeperThanFan, GpuDuctPlugPassageClosed, EndFaceMeasurement, DuctCardMount, DuctExtent,
  PlugAndFlange, SleeveOverCardEnd, FullDuct, CardFitRing, admit_gpu_duct, a16_end_face, a16_duct_design,
}

fn parts_of(a: GpuDuctAdmission) -> List<AssemblyPart>? {
  match a {
    GpuDuctAdmitted { parts: parts, interfaces: _ } => Present { value: parts }
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => none
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => none
    GpuDuctFanMountRefused { mount: _ } => none
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => none
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => none
  }
}

fn admitted_with_checks(mount: DuctCardMount, extent: DuctExtent, count: Int) -> Bool {
  match admit_gpu_duct(f: a16_end_face, d: a16_duct_design, mount: mount, extent: extent) {
    GpuDuctAdmitted { parts: parts, interfaces: joints } => length(list: parts) == count && review_model_checks(parts: parts, interfaces: joints)
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => false
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => false
    GpuDuctFanMountRefused { mount: _ } => false
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => false
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => false
  }
}

// POSITIVE CONTROL: all four A16 roots admit from the measured face and pass the source-model
// review checks, which include every flange screw hole finding its card insert on one line.
test fn w_the_four_a16_ducts_admit_and_pass_review_checks() -> Bool {
  admitted_with_checks(mount: PlugAndFlange, extent: FullDuct, count: 4)
    && admitted_with_checks(mount: SleeveOverCardEnd, extent: FullDuct, count: 4)
    && admitted_with_checks(mount: PlugAndFlange, extent: CardFitRing, count: 3)
    && admitted_with_checks(mount: SleeveOverCardEnd, extent: CardFitRing, count: 3)
}

// Bounds are in doubled micrometres (assembly_review_checks). Closed boxes: a shared face counts as
// contact, which the CAD check refuses as occupied clearance.
fn touches(a: Bounds, b: Bounds) -> Bool {
  a.lo_x <= b.hi_x && b.lo_x <= a.hi_x && a.lo_y <= b.hi_y && b.lo_y <= a.hi_y && a.lo_z <= b.hi_z && b.lo_z <= a.hi_z
}
fn larger(a: Int, b: Int) -> Int { if a > b { a } else { b } }
fn smaller(a: Int, b: Int) -> Int { if a < b { a } else { b } }
fn meet(a: Bounds, b: Bounds) -> Bounds {
  Bounds { lo_x: larger(a: a.lo_x, b: b.lo_x), lo_y: larger(a: a.lo_y, b: b.lo_y), lo_z: larger(a: a.lo_z, b: b.lo_z),
    hi_x: smaller(a: a.hi_x, b: b.hi_x), hi_y: smaller(a: a.hi_y, b: b.hi_y), hi_z: smaller(a: a.hi_z, b: b.hi_z) }
}
// The cut must remove the contact region with room to spare on every side it does not leave through.
fn strictly_covers(c: Bounds, r: Bounds) -> Bool {
  c.lo_x < r.lo_x && r.hi_x < c.hi_x && c.lo_y < r.lo_y && r.hi_y < c.hi_y && c.lo_z < r.lo_z && r.hi_z < c.hi_z
}

// THE CONNECTOR CLEARANCE IS CONSTRUCTION: every printed primitive that would reach the 8-pin
// keep-out is removed there by a cut of the same part (the sleeve's notch); the plug's flange never
// reaches it at all.
fn keepout_clear(parts: List<AssemblyPart>) -> Bool {
  let keepouts = flat_map(filter(parts, p => p.id == "POWER-KEEPOUT"), p => p.adds)
  length(list: keepouts) == 1 && all(keepouts, k => {
    let kb = primitive_bounds(p: k)
    all(filter(parts, p => p.id == "DUCT" || p.id == "FIT-RING"), p => all(p.adds, q => {
      let qb = primitive_bounds(p: q)
      !touches(a: qb, b: kb) || any(p.cuts, c => strictly_covers(c: primitive_bounds(p: c), r: meet(a: qb, b: kb)))
    }))
  })
}

fn clear_for(mount: DuctCardMount, extent: DuctExtent) -> Bool {
  match parts_of(a: admit_gpu_duct(f: a16_end_face, d: a16_duct_design, mount: mount, extent: extent)) {
    Present { value: parts } => keepout_clear(parts: parts)
    Absent => false
  }
}

test fn w_no_duct_material_remains_in_the_power_keepout() -> Bool {
  clear_for(mount: PlugAndFlange, extent: FullDuct) && clear_for(mount: SleeveOverCardEnd, extent: FullDuct)
    && clear_for(mount: PlugAndFlange, extent: CardFitRing) && clear_for(mount: SleeveOverCardEnd, extent: CardFitRing)
}

// RED for the keep-out check itself: the sleeve without its notch puts its end wall on the
// connector, and the check must see it. The notch is the one cut that leaves the sleeve's outer top
// face (bounds in doubled micrometres).
test fn w_an_unnotched_sleeve_is_seen_in_the_keepout() -> Bool {
  let outer_top = micrometer_count(m: a16_end_face.face_length) as Int + 2 * (micrometer_count(m: a16_duct_design.sleeve_clearance) as Int + micrometer_count(m: a16_duct_design.wall) as Int)
  match parts_of(a: admit_gpu_duct(f: a16_end_face, d: a16_duct_design, mount: SleeveOverCardEnd, extent: CardFitRing)) {
    Present { value: parts } => keepout_clear(parts: parts) && !keepout_clear(parts: map(parts, p => if p.id == "FIT-RING" {
      AssemblyPart { id: p.id, name: p.name, kind: p.kind, scope: p.scope, adds: p.adds, cuts: filter(p.cuts, c => primitive_bounds(p: c).hi_x <= outer_top), at: p.at, explode: p.explode, print_plane: p.print_plane, notes: p.notes }
    } else { p }))
    Absent => false
  }
}

fn face_with(lower_edge: Micrometer, setback: Micrometer, depth: Micrometer) -> EndFaceMeasurement {
  face_with_connector(lower_edge: lower_edge, setback: setback, depth: depth, connector: a16_end_face.connector_from_top)
}
fn face_with_connector(lower_edge: Micrometer, setback: Micrometer, depth: Micrometer, connector: Micrometer) -> EndFaceMeasurement {
  EndFaceMeasurement {
    source: "fixture",
    face_length: a16_end_face.face_length,
    face_thickness: a16_end_face.face_thickness,
    window_length: a16_end_face.window_length,
    window_depth: depth,
    window_from_top: a16_end_face.window_from_top,
    window_from_back: a16_end_face.window_from_back,
    fin_setback: setback,
    insert_spacing: a16_end_face.insert_spacing,
    insert_near_edge_from_back: a16_end_face.insert_near_edge_from_back,
    upper_insert_near_edge_from_top: a16_end_face.upper_insert_near_edge_from_top,
    lower_insert_near_edge_from_bottom: lower_edge,
    connector_from_top: connector,
  }
}

fn refusal(f: EndFaceMeasurement) -> GpuDuctAdmission {
  admit_gpu_duct(f: f, d: a16_duct_design, mount: PlugAndFlange, extent: CardFitRing)
}

// RED: insert readings taken as centres instead of edges no longer close on the face length.
test fn w_insert_readings_that_do_not_close_refuse() -> Bool {
  match refusal(f: face_with(lower_edge: micrometer(count: 9040), setback: a16_end_face.fin_setback, depth: a16_end_face.window_depth)) {
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => true
    GpuDuctAdmitted { parts: _, interfaces: _ } => false
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => false
    GpuDuctFanMountRefused { mount: _ } => false
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => false
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => false
  }
}

// RED: fins at the window face leave no room for a lip.
test fn w_fins_at_the_face_refuse() -> Bool {
  match refusal(f: face_with(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: micrometer(count: 400), depth: a16_end_face.window_depth)) {
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => true
    GpuDuctAdmitted { parts: _, interfaces: _ } => false
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => false
    GpuDuctFanMountRefused { mount: _ } => false
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => false
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => false
  }
}

// RED: a window deeper than the 92 mm fan frame cannot open into the plenum.
test fn w_a_window_deeper_than_the_fan_refuses() -> Bool {
  match admit_gpu_duct(f: face_with(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: a16_end_face.fin_setback, depth: micrometer(count: 95000)), d: a16_duct_design, mount: PlugAndFlange, extent: FullDuct) {
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => true
    GpuDuctAdmitted { parts: _, interfaces: _ } => false
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => false
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => false
    GpuDuctFanMountRefused { mount: _ } => false
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => false
  }
}

// RED: a window so shallow that the plug's own walls close the passage.
test fn w_a_window_too_shallow_for_the_plug_walls_refuses() -> Bool {
  match refusal(f: face_with(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: a16_end_face.fin_setback, depth: micrometer(count: 8000))) {
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => true
    GpuDuctAdmitted { parts: _, interfaces: _ } => false
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => false
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => false
    GpuDuctFanMountRefused { mount: _ } => false
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => false
  }
}

fn admitted(a: GpuDuctAdmission) -> Bool { match parts_of(a: a) { Present { value: _ } => true Absent => false } }

// A plug-only refusal binds the plug and not the sleeve, which has no lip in the fins.
test fn w_a_sleeve_survives_a_plug_only_refusal() -> Bool {
  let f = face_with(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: micrometer(count: 400), depth: a16_end_face.window_depth)
  !admitted(a: admit_gpu_duct(f: f, d: a16_duct_design, mount: PlugAndFlange, extent: CardFitRing)) &&
  admitted(a: admit_gpu_duct(f: f, d: a16_duct_design, mount: SleeveOverCardEnd, extent: CardFitRing))
}

// A fan-stage refusal binds the full duct and not the fit ring, which is the card interface alone.
test fn w_a_fit_ring_survives_a_full_duct_refusal() -> Bool {
  let f = face_with(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: a16_end_face.fin_setback, depth: micrometer(count: 95000))
  !admitted(a: admit_gpu_duct(f: f, d: a16_duct_design, mount: SleeveOverCardEnd, extent: FullDuct)) &&
  admitted(a: admit_gpu_duct(f: f, d: a16_duct_design, mount: SleeveOverCardEnd, extent: CardFitRing))
}

fn keepout_length(f: EndFaceMeasurement) -> Int {
  match parts_of(a: admit_gpu_duct(f: f, d: a16_duct_design, mount: PlugAndFlange, extent: CardFitRing)) {
    Present { value: parts } => match flat_map(filter(parts, p => p.id == "POWER-KEEPOUT"), p => p.adds).first() {
      Present { value: k } => {
        let b = primitive_bounds(p: k)
        b.hi_x - b.lo_x
      }
      Absent => 0
    }
    Absent => 0
  }
}

// The keep-out is derived from the measured connector: moving the outer pin 3 mm further from the
// top lengthens it by 3 mm (bounds are doubled micrometres).
test fn w_the_keepout_follows_the_measured_connector() -> Bool {
  let base = keepout_length(f: a16_end_face)
  let moved = keepout_length(f: face_with_connector(lower_edge: a16_end_face.lower_insert_near_edge_from_bottom, setback: a16_end_face.fin_setback, depth: a16_end_face.window_depth, connector: micrometer(count: 5560)))
  base > 0 && moved - base == 6000
}
