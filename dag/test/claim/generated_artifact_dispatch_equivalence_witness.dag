module test.claim.generated_artifact_dispatch_equivalence_witness

// P3 step 1 witness: the equivalence between the `artifact_producer` registry and the current dispatch
// is established by the fold in gunbc.generated_artifact_dispatch_equivalence. This module supplies the
// producer rows (built from the REAL registry on the positive, from a mutated copy on the RED) and
// asserts the verdict. Executing the real artifact_producer here is the pairing obligation: deleting the
// registry would make the positive fail.

import gunbc.generated_artifact_dispatch_equivalence { adjudicate, route_for, tier3_supplied, tier2_supplied, NameGroup, ProducerRow, EquivRefusal }
import gunbc.generated_artifact { GeneratedArtifact, artifact_producer }
import gunbc.generated_artifact_registry { committed_generated_artifacts }
import std.algebra { Cons, Empty, list_append }
import std.types { List }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// GeneratedArtifact constructor name (the pairing key). Written as an exhaustive match: adding an
// artifact to the type breaks this build until it is updated -- fail-closed on roster drift.
fn discriminant(a: GeneratedArtifact) -> String =
  match a {
    WitnessFloorYamlArtifact => "WitnessFloorYamlArtifact"
    FleetConvergeYamlArtifact => "FleetConvergeYamlArtifact"
    MicrovmShakedownYamlArtifact => "MicrovmShakedownYamlArtifact"
    InstrumentDispatchYamlArtifact => "InstrumentDispatchYamlArtifact"
    HealWorkflowYamlArtifact => "HealWorkflowYamlArtifact"
    HealPublisherWorkflowYamlArtifact => "HealPublisherWorkflowYamlArtifact"
    DriftWatchWorkflowYamlArtifact => "DriftWatchWorkflowYamlArtifact"
    BranchRunGrantBrokerWorkflowYamlArtifact => "BranchRunGrantBrokerWorkflowYamlArtifact"
    GitignoreArtifact => "GitignoreArtifact"
    GitattributesArtifact => "GitattributesArtifact"
    CargoConfigArtifact => "CargoConfigArtifact"
    DesignArtifact => "DesignArtifact"
    DesignFailureModesArtifact => "DesignFailureModesArtifact"
    DesignRungDropsArtifact => "DesignRungDropsArtifact"
    ContributorOnboardingArtifact => "ContributorOnboardingArtifact"
    GithooksPrePushArtifact => "GithooksPrePushArtifact"
    GithooksPreCommitArtifact => "GithooksPreCommitArtifact"
    GeneratedArtifactMergeDriverArtifact => "GeneratedArtifactMergeDriverArtifact"
    RunnerDeployArtifact => "RunnerDeployArtifact"
    Stage0CrateLayoutGeneratedDagArtifact => "Stage0CrateLayoutGeneratedDagArtifact"
    Stage0CrateLayoutGeneratedRsArtifact => "Stage0CrateLayoutGeneratedRsArtifact"
    Stage0CratePartitionGeneratedDagArtifact => "Stage0CratePartitionGeneratedDagArtifact"
    Stage0ExecutableAssemblyGeneratedDagArtifact => "Stage0ExecutableAssemblyGeneratedDagArtifact"
    Stage0LinkedPartitionCratesArtifact => "Stage0LinkedPartitionCratesArtifact"
    SeedRetentionFrontierGeneratedRsArtifact => "SeedRetentionFrontierGeneratedRsArtifact"
    V1InterpreterDispatchGeneratedRsArtifact => "V1InterpreterDispatchGeneratedRsArtifact"
    EvaluationBudgetConsequenceGeneratedRsArtifact => "EvaluationBudgetConsequenceGeneratedRsArtifact"
    ReleaseLocusSeedConstantsGeneratedRsArtifact => "ReleaseLocusSeedConstantsGeneratedRsArtifact"
    FileTransportRealizationGeneratedRsArtifact => "FileTransportRealizationGeneratedRsArtifact"
    NativeRouteSeedBoundaryGeneratedRsArtifact => "NativeRouteSeedBoundaryGeneratedRsArtifact"
    InstrumentRegistryGeneratedRsArtifact => "InstrumentRegistryGeneratedRsArtifact"
    Fci1BoundedExecutionContextArtifact => "Fci1BoundedExecutionContextArtifact"
    AutoinstallUserDataArtifact { spec: _ } => "AutoinstallUserDataArtifact"
    RunnerHostSudoersArtifact { host: _ } => "RunnerHostSudoersArtifact"
    CouponCadQueryProgramArtifact => "CouponCadQueryProgramArtifact"
    WholeCorpusCompileMeasuredRootDemandsArtifact => "WholeCorpusCompileMeasuredRootDemandsArtifact"
    ApprovalDeviceVectorsArtifact => "ApprovalDeviceVectorsArtifact"
    ApproveIosProjectYmlArtifact => "ApproveIosProjectYmlArtifact"
    ApproveIosProtocolSwiftArtifact => "ApproveIosProtocolSwiftArtifact"
    ApproveIosWireSwiftArtifact => "ApproveIosWireSwiftArtifact"
    ApproveIosProtocolVectorTestsSwiftArtifact => "ApproveIosProtocolVectorTestsSwiftArtifact"
    ApproveIosEnrolmentMachineSwiftArtifact => "ApproveIosEnrolmentMachineSwiftArtifact"
    ApproveIosOperationErrorsSwiftArtifact => "ApproveIosOperationErrorsSwiftArtifact"
    ApproveIosEnrolmentMachineTestsSwiftArtifact => "ApproveIosEnrolmentMachineTestsSwiftArtifact"
    ApproveIosOperationErrorsTestsSwiftArtifact => "ApproveIosOperationErrorsTestsSwiftArtifact"
  }

fn row_for(a: GeneratedArtifact) -> ProducerRow {
  let pref = artifact_producer(a: a)
  ProducerRow { discriminant: discriminant(a: a), module_path: pref.module_path, decl_name: pref.decl_name }
}

fn real_rows() -> List<ProducerRow> =
  fold(committed_generated_artifacts(), init: Empty, f: fn(a, x) { list_append(left: a, right: [row_for(a: x)]) })

// Test 1: the real registry rows agree with the current dispatch for every rostered artifact.
test fn positive_all_rows_match_holds() -> Bool =
  length(adjudicate(rows: real_rows())) == 0

// Test 2 (inhabitance / route): a real arm's leaf is bound by TIER 2 (imported), so tier 2 is exercised.
test fn route_binds_via_imported_holds() -> Bool =
  route_for(discriminant: "DesignArtifact") == "imported"

// Test 3 (RED): a supplied wrong-producer row must produce a located typed refusal naming the artifact,
// the named ref, and the reached ref.
fn mutate_heal(rows: List<ProducerRow>) -> List<ProducerRow> =
  fold(rows, init: Empty, f: fn(a, r) {
    if r.discriminant == "HealWorkflowYamlArtifact" {
      list_append(left: a, right: [ProducerRow { discriminant: r.discriminant, module_path: "gunbc.drift_watch_workflow", decl_name: "expected_drift_watch_workflow_yml" }])
    } else {
      list_append(left: a, right: [r])
    }
  })

fn refusal_is_wrong_heal(r: EquivRefusal) -> Bool =
  if r.artifact == "HealWorkflowYamlArtifact" {
    if r.reason == "producer-mismatch" {
      if r.named == "gunbc.drift_watch_workflow.expected_drift_watch_workflow_yml" {
        if r.reached == "gunbc.heal_workflow.expected_heal_workflow_yml" { true } else { false }
      } else { false }
    } else { false }
  } else { false }

test fn wrong_producer_red_refuses_holds() -> Bool =
  fold(adjudicate(rows: mutate_heal(rows: real_rows())), init: false, f: fn(a, r) { if a { true } else { refusal_is_wrong_heal(r: r) } })

// Test 4 (tier-3 logic over a SUPPLIED census): a name declared once binds via global-unique. No real arm
// reaches tier 3 (the positive binds every leaf at tier 2), so the tier-3 decision is exercised here.
test fn tier3_unique_binds_holds() -> Bool =
  tier3_supplied(name: "expected_solo_producer", rows: [NameGroup { bare: "expected_solo_producer", qualified: "gunbc.solo_module.expected_solo_producer" }]) == "unique:gunbc.solo_module.expected_solo_producer"

// Test 5 (tier-3 logic over a SUPPLIED census): a name declared in two modules refuses ambiguous.
test fn tier3_duplicate_refuses_holds() -> Bool =
  tier3_supplied(name: "foo", rows: [NameGroup { bare: "foo", qualified: "gunbc.mod_a.foo" }, NameGroup { bare: "foo", qualified: "gunbc.mod_b.foo" }]) == "ambiguous"

// Test 6 (tier-2 exactness, review 94619): a callee imported from exactly ONE of the dispatching module's
// imports binds at tier 2. Exercises the real de_resolve over a supplied import table (module_path does not
// declare the name, so tier 1 misses; only the declaring import is found).
test fn tier2_unique_binds_holds() -> Bool =
  tier2_supplied(name: "expected_solo_producer", module_path: "gunbc.dispatch_mod", imports: ["gunbc.mod_a", "gunbc.mod_b"], declaring_modules: ["gunbc.mod_a"]) == "bind:imported"

// Test 7 (the discriminating RED for review 94619): a callee whose bare name is declared by TWO admitted
// imports must REFUSE ambiguous, exactly as resolve's LexicalAmbiguous tier does. A first-hit copy would
// silently answer "bind:imported" here -- the silent wrong answer this witness exists to catch.
test fn tier2_ambiguous_refuses_holds() -> Bool =
  tier2_supplied(name: "foo", module_path: "gunbc.dispatch_mod", imports: ["gunbc.mod_a", "gunbc.mod_b"], declaring_modules: ["gunbc.mod_a", "gunbc.mod_b"]) == "ambiguous"
