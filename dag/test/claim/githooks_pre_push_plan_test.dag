module test.claim.githooks_pre_push_plan


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn witness_plan_roster_authority() -> Bool {
  length(gunbc.githooks_pre_push_plan.pre_push_all_bindings()) > 0
    && any(
      gunbc.githooks_pre_push_plan.pre_push_all_bindings(),
      b => match b.kind {
        DocWitnessRun { entry: _, function: _ } => true
        CargoFmtCheck => true
        WitnessCorpusRun { fail_recipe: _ } => true
      }
    )
}

fn witness_plan_fires_on_dag_path() -> Bool {
  length(gunbc.githooks_pre_push_plan.pre_push_active_kinds(changed_paths: ["dag/gunbc/foo.dag"])) > 0
}

fn witness_plan_skips_unrelated_path() -> Bool {
  length(gunbc.githooks_pre_push_plan.pre_push_active_kinds(changed_paths: ["README"])) == 0
}

fn witness_nested_rs_triggers_fmt() -> Bool {
  tools.rust_stage0_gates.path_is_rust_monolith(path: "src/v1/stage0/src/foo.rs")
    && length(
      gunbc.githooks_pre_push_plan.pre_push_active_kinds(changed_paths: ["src/v1/stage0/src/foo.rs"])
    ) > 0
}

fn witness_suffix_glob_matches_nested_rs() -> Bool {
  gunbc.local_tidy_spec.local_tidy_path_matches_glob(path: "src/v1/stage0/src/foo.rs", glob: "*.rs")
}

fn witness_check_only_policy_documented() -> Bool {
  string_contains(s: gunbc.githooks_pre_push_plan.pre_push_check_only_note, pattern: "refuse")
}

fn witness_witness_corpus_plan_authority() -> Bool {
  gunbc.githooks_pre_push_plan.pre_push_witness_corpus_plan_fn_authority() == "gunbc_ci_witness_corpus_only_batches"
}

fn witness_witness_corpus_fires_on_v2_path() -> Bool {
  length(
    gunbc.githooks_pre_push_plan.pre_push_active_kinds(changed_paths: ["src/v2/std/text.dag"])
  ) > 0
}

test fn githooks_pre_push_plan_witnesses() -> Bool {
  witness_plan_roster_authority()
    && witness_plan_fires_on_dag_path()
    && witness_plan_skips_unrelated_path()
    && witness_nested_rs_triggers_fmt()
    && witness_suffix_glob_matches_nested_rs()
    && witness_check_only_policy_documented()
    && witness_witness_corpus_plan_authority()
    && witness_witness_corpus_fires_on_v2_path()
    && gunbc.githooks_pre_push_plan.pre_push_zero_sha_authority() == "0000000000000000000000000000000000000000"
}
