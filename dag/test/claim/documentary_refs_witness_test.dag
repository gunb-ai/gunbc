module test.claim.documentary_refs_witness


data documentary_refs_witness_note: String = "THE PERTURBATIONS ARE THE POINT, AND EACH RUNS AGAINST THE SAME RESOLVER PRODUCTION USES. v2.std.decl_ref_resolution.cited_declaration_ref_refusal_count is v2.std.decl_ref_resolution's own counter -- the one the required cited-symbol gate calls -- so a refusal proved here is a refusal on the real acceptance path rather than a second algorithm agreeing with it. The fact populations below are planted rather than live because the SUBJECT of these claims is the mechanism: that a reference which cannot resolve refuses, and that the same reference against an intact population does not. The smallest crossing specimen is the requirement plus one."

fn fixture_modules() -> List<v2.lens.module_graph.ModuleDeclarationFact> {
  [
    v2.lens.module_graph.ModuleDeclarationFact { module: "v2.std.symbol_index", path: "src/v2/std/symbol_index.dag" },
    v2.lens.module_graph.ModuleDeclarationFact { module: "v2.compiler.resolve", path: "src/v2/compiler/03_resolve.dag" },
    v2.lens.module_graph.ModuleDeclarationFact { module: "gunbc.roadmap_authority", path: "dag/gunbc/roadmap_authority.dag" },
    v2.lens.module_graph.ModuleDeclarationFact { module: "gunbc.v1_maintenance_standing", path: "dag/gunbc/v1_maintenance_standing.dag" },
  ]
}

fn fixture_fact(qualified_name: String, name: String, path: String) -> v2.std.decl_index.DeclFact {
  v2.std.decl_index.DeclFact {
    qualified_name: qualified_name,
    name: name,
    kind: v2.std.decl_index.FnItem,
    node: v2.lens.enforcement.receipts.enforcement_red_probe_body_leaf,
    rel_path: path,
  }
}

data intact_population_note: String = "The four declarations the generated document names, present exactly once each. This is the control that proves the refusals below are caused by the perturbation rather than by a fixture that never resolved anything."

fn intact_facts() -> List<v2.std.decl_index.DeclFact> {
  [
    fixture_fact(
      qualified_name: "std.symbol_index.SymbolIndex",
      name: "SymbolIndex",
      path: "src/v2/std/symbol_index.dag",
    ),
    fixture_fact(
      qualified_name: "std.symbol_index.symbol_index_lexical_lookup",
      name: "symbol_index_lexical_lookup",
      path: "src/v2/std/symbol_index.dag",
    ),
    fixture_fact(
      qualified_name: "compiler.resolve.lookup_symbol_index_atom_identity",
      name: "lookup_symbol_index_atom_identity",
      path: "src/v2/compiler/03_resolve.dag",
    ),
    fixture_fact(
      qualified_name: "gunbc.roadmap_authority.five_minute_ci_gate_program_note",
      name: "five_minute_ci_gate_program_note",
      path: "dag/gunbc/roadmap_authority.dag",
    ),
    fixture_fact(
      qualified_name: "gunbc.v1_maintenance_standing.v1_seed_standing",
      name: "v1_seed_standing",
      path: "dag/gunbc/v1_maintenance_standing.dag",
    ),
  ]
}

fn refusals_against(facts: List<v2.std.decl_index.DeclFact>) -> Int {
  v2.std.decl_ref_resolution.cited_declaration_ref_refusal_count(
    refs: gunbc.documentary_refs.generated_document_declaration_refs(),
    facts: facts,
    modules: fixture_modules(),
  )
}

test fn documentary_refs_intact_population_resolves_clean() -> Bool {
  refusals_against(facts: intact_facts()) == 0
}

data rename_control_note: String = "THE PRODUCT RED. A referenced system is renamed -- here by removing the declaration the document names and leaving the rest of the population intact -- and NO DOCUMENT SOURCE IS EDITED. The refusal count rises, which is the whole claim: the generated paragraph names its systems through typed rows, so the rename reaches the required gate rather than leaving a sentence quietly describing a declaration that no longer exists. Before this change that same rename moved nothing, because the name lived inside a string literal."

fn facts_without(qualified_name: String) -> List<v2.std.decl_index.DeclFact> {
  fold(intact_facts(), init: [], f: fn(acc, f) {
    if f.qualified_name == qualified_name { acc } else { concat(acc, [f]) }
  })
}

test fn documentary_refs_renamed_system_refuses() -> Bool {
  let clean = refusals_against(facts: intact_facts())
  let renamed = refusals_against(
    facts: facts_without(qualified_name: "std.symbol_index.symbol_index_lexical_lookup")
  )
  clean == 0 && renamed == 1
}

data ambiguous_control_note: String = "THE SECOND PERTURBATION, AND IT IS A DIFFERENT FAILURE FROM THE FIRST. A system forked into two same-named declarations still EXISTS -- an existence check passes and a grep passes -- so only a resolver that answers zero/one/many catches it. The document's reference no longer identifies one system, which is exactly the §3 fork the citation rule is about, and it must refuse rather than pick the first."

test fn documentary_refs_ambiguous_system_refuses() -> Bool {
  let forked = concat(
    intact_facts(),
    [
      fixture_fact(
        qualified_name: "std.symbol_index.SymbolIndex",
        name: "SymbolIndex",
        path: "src/v2/std/symbol_index_fork.dag",
      ),
    ]
  )
  refusals_against(facts: forked) == 1
}

data rendered_from_rows_note: String = "THE BYTES COME FROM THE ROWS, WHICH IS WHAT MAKES THE ROWS LOAD-BEARING RATHER THAN DECORATIVE. A typed reference sitting beside a paragraph that independently spells the same name is two representations of one fact -- the rename would move the row and leave the sentence, and the enrolled population would resolve while the document lied. This claim asserts the rendered symbol text of each row appears in the generated document, so the row and the printed name cannot diverge."

test fn documentary_refs_generated_document_renders_the_rows() -> Bool {
  let md = gunbc.design_document.expected_design_md()
  string_contains(s: md, pattern: gunbc.documentary_refs.documentary_ref_symbol_text(reference: gunbc.doc_graph_roots.body_lowering_symbol_index_ref))
    && string_contains(s: md, pattern: gunbc.documentary_refs.documentary_ref_symbol_text(reference: gunbc.doc_graph_roots.body_lowering_lexical_lookup_ref))
    && string_contains(s: md, pattern: gunbc.documentary_refs.documentary_ref_symbol_text(reference: gunbc.doc_graph_roots.body_lowering_production_consumer_ref))
    && string_contains(s: md, pattern: gunbc.documentary_refs.documentary_ref_symbol_text(reference: gunbc.documentary_refs.five_minute_ci_gate_authority_ref))
    && string_contains(s: md, pattern: gunbc.documentary_refs.documentary_ref_symbol_text(reference: gunbc.documentary_refs.v1_maintenance_standing_ref))
}

data population_union_note: String = "The widened denominator is asserted directly, because a union that silently dropped one side would leave exactly the exemption this change removes: the generated refs must all be present in the combined population, and the combined population must be larger than the hand-authored one alone."

test fn documentary_refs_population_is_the_union() -> Bool {
  let all_refs = gunbc.documentary_refs.all_documentary_declaration_refs()
  let hand = gunbc.doc_graph_roots.hand_authored_doc_declaration_refs()
  let generated = gunbc.documentary_refs.generated_document_declaration_refs()
  v2.std.algebra.length(xs: all_refs) == v2.std.algebra.length(xs: hand) + v2.std.algebra.length(xs: generated)
    && v2.std.algebra.length(xs: generated) == 5
}

data retired_prose_substring_control_note: String = "A NEGATIVE PROSE CHECK STOOD HERE AND WAS DELETED RATHER THAN REPAIRED. It asserted the generated document no longer v2.std.algebra.contains the substring 'six-step', to show the superseded numbered sequence is gone. It failed -- and it failed CORRECTLY, because the replacement sentence explains that the paragraph previously carried a numbered six-step copy, so the words survive while the copy does not. The check could not tell a restatement from an explanation of its removal.\n\nTHAT IS THE WHOLE ARGUMENT AGAINST THIS SHAPE, and it is already on record: gunbc.roadmap_authority witness_authority_contains_no_mutable_execution_ledger blacklists substrings in a status field and is structurally unable to catch a stale claim spelled without them. Repairing the needle would have produced a check that passes for this one spelling and decides nothing in general -- validation standing where nothing decidable was available. The positive claim survives instead, in documentary_refs_generated_document_renders_the_rows: the roadmap authority is cited by rendering its typed row, which is a fact a mechanism can actually decide."

