module test.claim.workspace_actor_takeover_witness

import std.types { Bool, NonEmptyStr }
import std.durable_compare_and_set { cas_generation_first }
import std.durable_exclusive_hold { DurableHoldOwnerRef, DurableHoldObservation, HoldSlotAbsent, HoldSlotHeld, HoldObservationUnavailable }
import std.durable_compare_and_set { CasUnreadableReadRefused }
import gunbc.fabric.fabric_control_plane { fabric_hold_owner, fabric_money_reservation_ref }
import gunbc.workspace_reservation_record { WorkspaceReservationPlan }
import gunbc.workspace_allocation_plan {
  workspace_actor_takeover_decision, WorkspaceActorTakeoverDecision,
  TakeoverRecoverHeld, TakeoverRearmActor, TakeoverCancelActor, TakeoverRetain,
  ActorIntentAcquire, ActorIntentRetire,
}
import gunbc.workspace_acquisition_invocation {
  workspace_prior_actor_standing, workspace_slot_unit, workspace_recorded_actor_decode, RecordedActorLegacyBareId, RecordedActorUnreadable,
  WorkspacePriorActorStanding, PriorActorRunning, PriorActorTerminal, PriorActorUnobservable,
}
import gunbc.systemd_unit_invocation_liveness { SystemManager, UnitRunIdentity, UnitInvocationObservation, UnitInvocationPresent, UnitInvocationAbsent, UnitInvocationUnreadable, unit_invocation_observation, unit_run_wire }
import test.claim.workspace_launch_directive_witness { launch_fixture_allocation }

data fixture_boot_id: String = "73c8153e-0e0e-4480-a36c-bc7560c50e8b"
data fixture_proc_stat: String = "cpu 1 2 3\nbtime 1792000000\nprocesses 5\n"

fn fixture_slot(unit: NonEmptyStr, invocation: String) -> UnitInvocationObservation {
  unit_invocation_observation(manager: SystemManager, unit: unit, boot_id_text: fixture_boot_id, proc_stat_text: fixture_proc_stat, invocation_text: invocation)
}

fn fixture_run(unit: NonEmptyStr, invocation: String) -> UnitRunIdentity? {
  match fixture_slot(unit: unit, invocation: invocation) { UnitInvocationPresent { unit: _, run: r } => Present { value: r }  _ => none }
}

fn takeover_plan() -> WorkspaceReservationPlan? {
  match launch_fixture_allocation() {
    Absent => none
    Present { value: fixture } => fixture.plan
  }
}

fn decided(hold: DurableHoldObservation, prior: WorkspacePriorActorStanding, retire: Bool) -> WorkspaceActorTakeoverDecision? {
  match takeover_plan() {
    Absent => none
    Present { value: plan } => Present { value: workspace_actor_takeover_decision(plan: plan, hold: hold, prior: prior,
      intent: if retire { ActorIntentRetire } else { ActorIntentAcquire }) }
  }
}

fn is_rearm(d: WorkspaceActorTakeoverDecision?) -> Bool { match d { Present { value: TakeoverRearmActor } => true _ => false } }
fn is_cancel(d: WorkspaceActorTakeoverDecision?) -> Bool { match d { Present { value: TakeoverCancelActor } => true _ => false } }
fn is_retain(d: WorkspaceActorTakeoverDecision?) -> Bool { match d { Present { value: TakeoverRetain { reason: _ } } => true _ => false } }
fn is_recover(d: WorkspaceActorTakeoverDecision?) -> Bool { match d { Present { value: TakeoverRecoverHeld { reservation: _ } } => true _ => false } }

// A dead actor with no hold: a wanted request re-arms acquisition, a retired one cancels it.
test fn terminal_actor_without_hold_rearms_wanted_and_cancels_retired() -> Bool {
  is_rearm(d: decided(hold: HoldSlotAbsent, prior: PriorActorTerminal, retire: false))
  && is_cancel(d: decided(hold: HoldSlotAbsent, prior: PriorActorTerminal, retire: true))
}

// Discriminating red for the wedge's opposite failure: an actor that may still be running, or
// whose standing cannot be read, is never replaced from an absent-hold observation alone.
test fn live_or_unobservable_actor_is_never_replaced() -> Bool {
  is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorRunning, retire: false))
  && is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorRunning, retire: true))
  && is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorUnobservable { reason: "fixture" }, retire: false))
}

// An UNOBSERVABLE holder (a legacy bare-id record maps to the same standing) retains the acquisition obligation
// under BOTH intents: retirement does not fence an acquisition the elected actor may already have admitted.
test fn unobservable_holder_retains_under_acquire_and_retire() -> Bool {
  is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorUnobservable { reason: "legacy" }, retire: true))
  && is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorUnobservable { reason: "legacy" }, retire: false))
  && is_retain(d: decided(hold: HoldSlotAbsent, prior: PriorActorRunning, retire: true))
  && is_cancel(d: decided(hold: HoldSlotAbsent, prior: PriorActorTerminal, retire: true))
}

// A bare pre-carrier InvocationID is its own typed reading, never a run and never garbage.
test fn legacy_bare_actor_record_decodes_to_its_own_reading() -> Bool {
  let bare = serialize_json(v: json_object(members: [json_kv(key: "invocation", value: json_string(s: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))]))
  let junk = serialize_json(v: json_object(members: [json_kv(key: "invocation", value: json_string(s: "not-an-id"))]))
  (match workspace_recorded_actor_decode(generation: cas_generation_first(), wire: bare) { RecordedActorLegacyBareId { generation: _, invocation_id: _ } => true _ => false })
  && (match workspace_recorded_actor_decode(generation: cas_generation_first(), wire: junk) { RecordedActorUnreadable { reason: _ } => true _ => false })
}

// An unreadable hold retains the obligation even when the actor is known dead.
test fn unreadable_hold_retains_the_obligation() -> Bool {
  is_retain(d: decided(hold: HoldObservationUnavailable { cause: CasUnreadableReadRefused { detail: "fixture" } }, prior: PriorActorTerminal, retire: false))
}

// The exact hold the plan names is recovered rather than re-acquired; a foreign holder is retained.
test fn matching_hold_recovers_and_foreign_hold_retains() -> Bool {
  match takeover_plan() {
    Absent => false
    Present { value: plan } => {
      let owner = fabric_hold_owner(reservation: fabric_money_reservation_ref(demand: plan.reservation.demand, offer: plan.reservation.offer))
      is_recover(d: Present { value: workspace_actor_takeover_decision(plan: plan,
        hold: HoldSlotHeld { generation: cas_generation_first(), owner: owner }, prior: PriorActorTerminal, intent: ActorIntentAcquire) })
      && is_retain(d: Present { value: workspace_actor_takeover_decision(plan: plan,
        hold: HoldSlotHeld { generation: cas_generation_first(), owner: "foreign-holder" as DurableHoldOwnerRef }, prior: PriorActorTerminal, intent: ActorIntentAcquire) })
    }
  }
}

// The slot unit's InvocationID decides the prior actor's standing; an observation of another unit or manager is
// foreign to the holder and never terminal.
test fn prior_actor_standing_follows_the_slot_invocation() -> Bool {
  let old = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let new = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  match takeover_plan() {
    Absent => false
    Present { value: plan } => {
      let u = workspace_slot_unit(plan: plan)
      let foreign = "other-slot.service" as NonEmptyStr
      match fixture_run(unit: u, invocation: old) {
        Absent => false
        Present { value: r } =>
          (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: fixture_slot(unit: u, invocation: new)) { PriorActorTerminal => true _ => false })
          && (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: fixture_slot(unit: u, invocation: "")) { PriorActorTerminal => true _ => false })
          && (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: fixture_slot(unit: u, invocation: old)) { PriorActorRunning => true _ => false })
          && (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: UnitInvocationUnreadable { cause: "fixture" as NonEmptyStr }) { PriorActorUnobservable { reason: _ } => true _ => false })
          && (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: fixture_slot(unit: foreign, invocation: new)) { PriorActorUnobservable { reason: _ } => true _ => false })
          && (match workspace_prior_actor_standing(recorded: r, plan: plan, slot: fixture_slot(unit: foreign, invocation: "")) { PriorActorUnobservable { reason: _ } => true _ => false })
      }
    }
  }
}
