module test.claim.cli_surface_boundary_probe

// WAVE 0 (docs/plans/cli-invocation-emission-design.md).
//
// WHAT AN EARLIER REVISION OF THIS WITNESS GOT WRONG, kept because it is the instructive part:
// it supplied exactly two tokens to a flat one-token-one-argument fold and asserted exactly two
// arguments came out. That CHOSE THE ARGUMENT SPLIT BEFORE THE SERIALIZER RAN. It proved "one
// token supplied, one argument retained" -- a restatement of the fold's own shape -- and not
// "the grammar groups fragments into arguments".
//
// The discriminating question is instead: do the SAME fragments, grouped two ways, produce two
// DIFFERENT surfaces while flattening to the same text? If grouping were not load-bearing, the
// two would be indistinguishable. That is the property an argv vector has and source text does
// not, so it is the property worth executing.

data probe_dash_option_class: String = "probe_dash_option"
data probe_equals_class: String = "probe_equals"
data probe_value_class: String = "probe_value"

fn probe_lex_rules() -> v2.std.compilers.lexing.ModeledLexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: [
        v2.std.compilers.lexing.TokenRule { token_class: ^probe_dash_option, pattern: v2.std.compilers.lexing.LiteralPattern { text: "--color" } },
        v2.std.compilers.lexing.TokenRule { token_class: ^probe_equals, pattern: v2.std.compilers.lexing.LiteralPattern { text: "=" } },
        v2.std.compilers.lexing.TokenRule { token_class: ^probe_value, pattern: v2.std.compilers.lexing.LiteralPattern { text: "never" } },
      ]
    }
  }
}

// ONE AUTHORITY for the fragments. An earlier revision authored the same three tokens in three
// places, so "the SAME fragments grouped two ways" was maintained by author discipline: one
// grouping could drift while the flattening test kept passing. Both groupings and the flattening
// check now derive from this list, which makes the keystone mechanically true instead of copied.
fn probe_fragments() -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.FixedToken { token_class: ^probe_dash_option },
    v2.std.compilers.target_model.FixedToken { token_class: ^probe_equals },
    v2.std.compilers.target_model.FixedToken { token_class: ^probe_value },
  ]
}

// All fragments in ONE argument: within an argument, concatenation is CORRECT.
fn joined_grouping() -> v2.std.collection.List<v2.std.compilers.cli_surface.CliArgumentSyntax> {
  [v2.std.compilers.cli_surface.CliArgumentSyntax { fragments: probe_fragments() }]
}

// Each fragment its OWN argument: across arguments, concatenation DESTROYS.
fn separated_grouping() -> v2.std.collection.List<v2.std.compilers.cli_surface.CliArgumentSyntax> {
  v2.std.algebra.fold_list(
    xs: probe_fragments(),
    empty: std.algebra.Empty,
    cons: fn(acc, fragment) {
      v2.std.algebra.list_snoc_item(xs: acc, item: v2.std.compilers.cli_surface.CliArgumentSyntax { fragments: [fragment] })
    }
  )
}

// Flatten a grouping back to the fragment sequence it was built from, so the keystone compares
// the ACTUAL grouping values rather than a third hand-authored list.
fn flatten_grouping(arguments: v2.std.collection.List<v2.std.compilers.cli_surface.CliArgumentSyntax>) -> v2.std.collection.List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  v2.std.algebra.fold_list(
    xs: arguments,
    empty: std.algebra.Empty,
    cons: fn(acc, argument) { v2.std.algebra.list_append(left: acc, right: argument.fragments) }
  )
}

fn argument_texts(arguments: v2.std.collection.List<v2.std.compilers.cli_surface.CliArgumentSyntax>) -> v2.std.collection.List<String> {
  match v2.std.compilers.cli_surface.serialize_cli_arguments(
    arguments: arguments,
    lex: probe_lex_rules(),
    binding_spellings: v2.std.collection.empty_map()
  ) {
    Accepted { value: surface, diagnostics: _ } =>
      v2.std.algebra.fold_list(
        xs: v2.std.compilers.cli_surface.cli_surface_arguments(surface: surface),
        empty: std.algebra.Empty,
        cons: fn(acc, argument) {
          v2.std.algebra.list_snoc_item(xs: acc, item: v2.std.compilers.cli_surface.cli_argument_text(argument: argument))
        }
      )
    Rejected { diagnostics: _ } => std.algebra.Empty
  }
}

// Grouped as one: exactly one argument, "--color=never".
test fn joined_fragments_render_one_argument() -> Bool {
  match argument_texts(arguments: joined_grouping()) {
    Empty => false
    Cons { head: only, tail: rest } =>
      match rest {
        Empty => only == "--color=never"
        Cons { head: _, tail: _ } => false
      }
  }
}

// Grouped as three: exactly three arguments, and the middle one is bare "=".
test fn separated_fragments_render_three_arguments() -> Bool {
  match argument_texts(arguments: separated_grouping()) {
    Empty => false
    Cons { head: a, tail: r1 } =>
      match r1 {
        Empty => false
        Cons { head: b, tail: r2 } =>
          match r2 {
            Empty => false
            Cons { head: c, tail: r3 } =>
              match r3 {
                Empty => (a == "--color") && (b == "=") && (c == "never")
                Cons { head: _, tail: _ } => false
              }
          }
      }
  }
}

// THE KEYSTONE. Both groupings flatten to the same source text, so the text carrier cannot tell
// them apart at all. Grouping is therefore information the argv carrier holds and text does not
// -- which is exactly the fact the 17 remote jq rows lose at the ssh seam.
fn grouping_flat_text(arguments: v2.std.collection.List<v2.std.compilers.cli_surface.CliArgumentSyntax>) -> String {
  match v2.std.compilers.target_model.bound_tokens_source_text(
    tokens: flatten_grouping(arguments: arguments),
    lex: probe_lex_rules(),
    binding_spellings: v2.std.collection.empty_map()
  ) {
    Accepted { value: text, diagnostics: _ } => v2.std.compilers.target_model.render_target_text(t: text)
    Rejected { diagnostics: _ } => ""
  }
}

// THE KEYSTONE, now comparing the two ACTUAL grouping values rather than a hand-copied list:
// both flatten to identical text, so the text carrier cannot separate them at all, while the
// two assertions above show the argv carrier does. Grouping is exactly the information the argv
// vector holds and source text loses -- which is what the 17 remote jq rows lose at the ssh seam.
test fn both_groupings_flatten_to_the_same_text() -> Bool {
  (grouping_flat_text(arguments: joined_grouping()) == "--color=never")
    && (grouping_flat_text(arguments: joined_grouping())
          == grouping_flat_text(arguments: separated_grouping()))
}

test fn keystone_flat_text_is_nonempty() -> Bool {
  match v2.std.compilers.target_model.bound_tokens_source_text(
    tokens: flatten_grouping(arguments: separated_grouping()),
    lex: probe_lex_rules(),
    binding_spellings: v2.std.collection.empty_map()
  ) {
    Accepted { value: text, diagnostics: _ } =>
      v2.std.compilers.target_model.render_target_text(t: text) == "--color=never"
    Rejected { diagnostics: _ } => false
  }
}

// A MISSING BINDING REFUSES. This is the perturbation control for the fail-open this fold used
// to inherit: target_model's bound-token lookup answers an absent map entry with the binding
// SYMBOL'S OWN NAME, so a generic serializer would have emitted the literal argument
// "probe_unbound_value" -- a plausible-looking argv the process would then have run. Defensible
// for compiler source text, where the symbol name is a legitimate rendering; fabricated
// plausible output for runtime CLI data (DESIGN section 5).
//
// The assertion is deliberately Rejected-vs-Accepted rather than a text comparison: if the
// fallback ever returns, this goes red because the fold ACCEPTS, and no assertion about the
// emitted text is needed to see it.
test fn a_bound_fragment_with_no_spelling_refuses() -> Bool {
  match v2.std.compilers.cli_surface.serialize_cli_arguments(
    arguments: [v2.std.compilers.cli_surface.CliArgumentSyntax {
      fragments: [v2.std.compilers.target_model.BoundToken { token_class: ^probe_value_class, binding: ^probe_unbound_value }]
    }],
    lex: probe_lex_rules(),
    binding_spellings: v2.std.collection.empty_map()
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}
