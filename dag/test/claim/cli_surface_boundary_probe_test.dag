module test.claim.cli_surface_boundary_probe

import std.algebra { Cons, Empty }
import std.types { Bool, String }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.collection { List, empty_map }
import v2.std.compilers.cli_surface {
  CliArgumentSyntax,
  cli_argument_text,
  cli_surface_arguments,
  serialize_cli_arguments
}
import v2.std.compilers.lexing {
  LexRuleSet,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model { FixedToken, bound_tokens_source_text, render_target_text }
import v2.std.diagnostic { Accepted, Rejected }

// WAVE 0 (docs/plans/cli-invocation-emission-design.md).
//
// WHAT AN EARLIER REVISION OF THIS WITNESS GOT WRONG, kept because it is the instructive part:
// it supplied exactly two tokens to a flat one-token-one-argument fold and asserted exactly two
// arguments came out. That CHOSE THE ARGUMENT SPLIT BEFORE THE SERIALIZER RAN. It proved "one
// token supplied, one argument retained" -- a restatement of the fold's own shape -- and not
// "the grammar groups fragments into arguments".
//
// The discriminating question is instead: do the SAME fragments, grouped two ways, produce two
// DIFFERENT surfaces while flattening to the same text? If grouping were not load-bearing, the
// two would be indistinguishable. That is the property an argv vector has and source text does
// not, so it is the property worth executing.

data probe_dash_option_class: String = "probe_dash_option"
data probe_equals_class: String = "probe_equals"
data probe_value_class: String = "probe_value"

fn probe_lex_rules() -> ModeledLexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TokenRule { token_class: ^probe_dash_option, pattern: LiteralPattern { text: "--color" } },
        TokenRule { token_class: ^probe_equals, pattern: LiteralPattern { text: "=" } },
        TokenRule { token_class: ^probe_value, pattern: LiteralPattern { text: "never" } },
      ]
    }
  }
}

// ONE argument composed of three fragments: within an argument, concatenation is CORRECT.
fn joined_grouping() -> List<CliArgumentSyntax> {
  [
    CliArgumentSyntax {
      fragments: [
        FixedToken { token_class: ^probe_dash_option },
        FixedToken { token_class: ^probe_equals },
        FixedToken { token_class: ^probe_value },
      ]
    },
  ]
}

// THREE arguments from the same three fragments: across arguments, concatenation DESTROYS.
fn separated_grouping() -> List<CliArgumentSyntax> {
  [
    CliArgumentSyntax { fragments: [FixedToken { token_class: ^probe_dash_option }] },
    CliArgumentSyntax { fragments: [FixedToken { token_class: ^probe_equals }] },
    CliArgumentSyntax { fragments: [FixedToken { token_class: ^probe_value }] },
  ]
}

fn argument_texts(arguments: List<CliArgumentSyntax>) -> List<String> {
  match serialize_cli_arguments(
    arguments: arguments,
    lex: probe_lex_rules(),
    binding_spellings: empty_map()
  ) {
    Accepted { value: surface, diagnostics: _ } =>
      fold_list(
        xs: cli_surface_arguments(surface: surface),
        empty: Empty,
        cons: fn(acc, argument) {
          list_snoc_item(xs: acc, item: cli_argument_text(argument: argument))
        }
      )
    Rejected { diagnostics: _ } => Empty
  }
}

// Grouped as one: exactly one argument, "--color=never".
test fn joined_fragments_render_one_argument() -> Bool {
  match argument_texts(arguments: joined_grouping()) {
    Empty => false
    Cons { head: only, tail: rest } =>
      match rest {
        Empty => only == "--color=never"
        Cons { head: _, tail: _ } => false
      }
  }
}

// Grouped as three: exactly three arguments, and the middle one is bare "=".
test fn separated_fragments_render_three_arguments() -> Bool {
  match argument_texts(arguments: separated_grouping()) {
    Empty => false
    Cons { head: a, tail: r1 } =>
      match r1 {
        Empty => false
        Cons { head: b, tail: r2 } =>
          match r2 {
            Empty => false
            Cons { head: c, tail: r3 } =>
              match r3 {
                Empty => (a == "--color") && (b == "=") && (c == "never")
                Cons { head: _, tail: _ } => false
              }
          }
      }
  }
}

// THE KEYSTONE. Both groupings flatten to the same source text, so the text carrier cannot tell
// them apart at all. Grouping is therefore information the argv carrier holds and text does not
// -- which is exactly the fact the 17 remote jq rows lose at the ssh seam.
test fn both_groupings_flatten_to_the_same_text() -> Bool {
  match bound_tokens_source_text(
    tokens: [
      FixedToken { token_class: ^probe_dash_option },
      FixedToken { token_class: ^probe_equals },
      FixedToken { token_class: ^probe_value },
    ],
    lex: probe_lex_rules(),
    binding_spellings: empty_map()
  ) {
    Accepted { value: text, diagnostics: _ } =>
      render_target_text(t: text) == "--color=never"
    Rejected { diagnostics: _ } => false
  }
}
