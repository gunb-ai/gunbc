// THE ADMITTED PAIR, MINTED THROUGH THE ONLY DOOR THAT HAS ONE. This file cannot write
// DeploymentGateTrialEvidence { ... }: the type is sole_constructor in
// gunbc.auth.deployment_gate_authorization, so a literal here is refused at the name
// (SoleConstructorViolation), which is the executed red
// gunbc.test.probe.deployment_gate_evidence_forged_probe enrolls. So the only way to get an admitted
// admission is to hand the mint what two readbacks returned and see whether it admits.
fn admitted_pair() -> ReviewerRemovalAdmission
  admit_callers: [// THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_removal_admission_from_one_dispatch_or_the_wrong_environment_is_refused"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_from_another_attempt_or_an_aged_one_is_not_spendable"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "historical_evidence_does_not_outlive_the_rule"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "ready_act"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_is_issued_only_for_the_boundary_the_pair_was_witnessed_on"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_ready_act_claims_no_completion_before_the_human_acts"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_removal_act_is_admitted_only_by_a_typed_prerequisite"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_removal_act_names_its_subject_in_its_identity_and_in_its_route"
    ),
  ]
{
  admit_reviewer_removal(
    approved: approved_trial(run_id: 35447067113),
    rejected: rejected_trial(run_id: 35447067114),
    boundary: srv1_deployment_gate_boundary,
  )
}

// THE ADMITTED PAIR ON SOME OTHER SUBJECT. The receipts are built through the real mints, so this is not
// a cartoon of a wrong pair: it is a pair somebody genuinely witnessed, on a boundary this removal act
// has no business touching. That is what makes the control below a control.
fn admitted_pair_on(
  approved: Optional<AcceptedRuleReviewReceipt>,
  rejected: Optional<AcceptedRuleReviewReceipt>,
  boundary: DeploymentGateBoundary
) -> ReviewerRemovalAdmission
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2): this forwards to the sealed admission,
  // so an open proxy here is a second door to it. Its only consumer is the boundary red below.
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_is_issued_only_for_the_boundary_the_pair_was_witnessed_on"
    ),
  ]
{
  admit_reviewer_removal(approved: approved, rejected: rejected, boundary: boundary)
}

// THE CURRENT READ THE ACT NOW REQUIRES (side chat, blocker 3). THE NAME IS THE ONE THE SEALED MINT
// ADMITS: observe_removal_boundary_standing is confined to the broker's answer route and to exactly the
// witness declarations named in its admit_callers, keyed on (module, decl_name) -- so this file cannot
// grow a second door to a standing, and a foreign module cannot obtain one at all. Everything the read
// depends on is a PARAMETER, so a stale read, a read about another rule, or a read taken after the
// reviewer was already removed is expressible WITHOUT constructing a sealed record by hand.
fn standing_fixture(
  environment: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int,
  reviewer_present: Bool,
  main_only: Bool
) -> RemovalBoundaryStandingObservation {
  standing_at(
    environment: environment,
    installation_id: installation_id,
    identity_repo: identity_repo,
    rule_id: rule_id,
    reviewer_present: reviewer_present,
    main_only: main_only,
    attempt: standing_attempt(),
    observed_at: standing_ts(s: standing_instant),
  )
}

// THE STANDING, AT A CHOSEN ATTEMPT AND INSTANT. The two coordinates blocker 2 adds are PARAMETERS here
// rather than constants, because the staleness and replay reds have to be able to name a second attempt
// and a past instant; a fixture that hard-codes them can only ever demonstrate the honest case. Everything
// still goes through the one sealed mint, so nothing in this file can hold a standing it did not read.
fn standing_at(
  environment: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int,
  reviewer_present: Bool,
  main_only: Bool,
  attempt: AttemptIdentity,
  observed_at: Timestamp
) -> RemovalBoundaryStandingObservation
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_from_another_attempt_or_an_aged_one_is_not_spendable"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "standing_fixture"
    ),
  ]
{
  observe_removal_boundary_standing(
    // THE JOIN FIRST. This is the only door to a standing in the whole corpus, and it now takes the two
    // reads as a JOINED pair: a witness cannot hand the mint an ownership and a protection that name
    // different environments, because it cannot hand it anything the join has not already agreed about.
    joined: join_protection_to_ownership(
      protection: protection_for(
        owner: gate_owner,
        repo: identity_repo,
        environment: environment,
        reviewer_present: reviewer_present,
        main_only: main_only,
      ),
      ownership: ownership_for(
        environment: environment,
        installation_id: installation_id,
        identity_repo: identity_repo,
        rule_id: rule_id,
      ),
    ),
    boundary: standing_boundary_for(environment: environment, identity_repo: identity_repo),
    attempt: attempt as AttemptIdentity,
    observed_at: standing_ts(s: observed_at as String),
  )
}

fn standing_boundary_for(
  environment: NonEmptyStr,
  identity_repo: NonEmptyStr
) -> DeploymentGateBoundary {
  DeploymentGateBoundary {
    repository: Repository {
      owner: gate_owner as String,
      name: identity_repo as String,
      full_name: concat(gate_owner as String, concat("/", identity_repo as String)),
      private: false,
      default_branch: "main",
    },
    environment_name: environment,
  }
}

// THE CURRENT STATE OF THE BOUNDARY, AS READ. Built from the shape gunbc.auth.github_deployment_environment
// already owns for an environment's protection, with the two properties the standing's mint inspects as
// PARAMETERS -- so "the reviewer is already gone" and "the branch rule disappeared" are writable facts,
// not sealed records nobody can build.
fn protection_read(
  environment: NonEmptyStr,
  reviewer_present: Bool,
  main_only: Bool
) -> GitHubEnvironmentProtectionSettings {
  GitHubEnvironmentProtectionSettings {
    name: environment as String,
    deployment_branch_policy: if main_only {
      SelectedBranchesAndTags {
        rules: [DeploymentBranchPolicyRule { name: "main", ref_type: PolicyRefBranch }],
      }
    } else {
      // the branch rule is gone: the environment is reachable from any ref, which is the boundary
      // having ALREADY been weakened
      AllBranchesAndTags
    },
    reviewer_requirement: if reviewer_present { RequiredReviewers } else { NoRequiredReviewers },
  }
}

// THE READ THAT MATCHES THE CANONICAL TRIAL: the rule and the installation the receipts were minted
// against, this repository, and a protection that still carries both properties.
fn standing_for_trial() -> RemovalBoundaryStandingObservation
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "historical_evidence_does_not_outlive_the_rule"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "ready_act"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_is_issued_only_for_the_boundary_the_pair_was_witnessed_on"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_ready_act_claims_no_completion_before_the_human_acts"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_removal_act_is_admitted_only_by_a_typed_prerequisite"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_removal_act_names_its_subject_in_its_identity_and_in_its_route"
    ),
  ]
{
  standing_fixture(
    environment: gate_env,
    installation_id: canonical_installation_id,
    identity_repo: gate_repo,
    rule_id: canonical_rule_id,
    reviewer_present: true,
    main_only: true,
  )
}

// NO READ AT ALL. For the calls whose admission already refuses: the honest value, rather than a
// stand-in that would let a Blocked be cited as "the standing was checked".
fn standing_never_read() -> RemovalBoundaryStandingObservation {
  StandingRefused {
    because: JoinWasRefused {
      because: OwnershipWasNotEstablished { because: ReadbackCarriedNoRules },
    },
  }
}

// THE ACT, THROUGH THE ONLY ROUTE THAT HAS ONE. `reviewer_removal_step` used to be a `data` row here and
// in the module, which is blocker 3: the act that weakens srv1's boundary sat in a public row, so a
// consumer could read it without ever producing an admission. Everything that used to read the row now
// reads it OUT OF the decision, which is the only place it exists.
fn ready_act() -> HumanIntervention?
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_gate_rows_point_at_the_boundary_environment"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_gate_rows_refuse_a_drifted_environment_name"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_last_field_is_the_one_that_weakens_the_gate"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_removal_is_not_collapsed_into_the_enablement"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_witnessed_states_are_githubs_own"
    ),
  ]
{
  match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_for_trial(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
    ReviewerRemovalReady { admitted: a } => Present { value: a.intervention }
    ReviewerRemovalBlocked { missing: _ } => none
  }
}

// ---------------------------------------------------------------------------
// 1. The five acts: the sequence is a record, so what is left to falsify is the BINDING
// ---------------------------------------------------------------------------

// THE ORDER IS THE TYPE NOW (review 82535), and that changes what a witness can usefully do. There used
// to be three checks here — a count that had to be five, a count per identity, and a fold that found the
// removal row after the enablement row — and all three were satisfiable by editing the declaration they
// were supposed to be checking (§5's tell). They are gone, and nothing replaces them as a *check*,
// because there is no list to reorder, drop, or duplicate: `reviewer_removal` is a later FIELD than
// `rule_enablement`, and the only way to reverse the sequence is to write a different record.
//
// WHAT CAN STILL BE WRITTEN WRONGLY. It used to be a field bound to the wrong row -- a swap of the two
// boundary fields compiled, and no fold over a list would have caught it. That swap is NOT WRITABLE any
// more: blocker 3 gave the removal field the TYPE ReviewerRemovalStepDecision, so the two boundary fields
// are different types and binding one to the other's row is a type error rather than a bad edit. What is
// left is falsifiable in two places, and these tests aim at exactly those: each remaining field must hold
// the act its name promises (compared as branded identities, not as strings cast for comparison), and the
// act must be ISSUED only for the boundary the pair was witnessed on -- the subject check that blocker 2
// added, whose control is the other pair of tests below.
test fn each_field_of_the_sequence_holds_the_act_its_name_promises() -> Bool {
  deployment_gate_operator_steps.app_registration.identity == app_registration_step.identity
    && deployment_gate_operator_steps.app_installation.identity
      == app_installation_step.identity
    && deployment_gate_operator_steps.webhook_configuration.identity
      == webhook_configuration_step.identity
    // the two boundary fields, by name and by row
    && deployment_gate_operator_steps.rule_enablement.identity == rule_enablement_step.identity
    // THE FIFTH FIELD IS NO LONGER A ROW TO BIND (blocker 3): it is the typed decision, and at this
    // frontier nothing has been witnessed, so the honest value is a Blocked naming the mint's reason. A
    // Ready act sitting in a published row is exactly the shape that used to be reachable.
    && (match deployment_gate_operator_steps.reviewer_removal {
          ReviewerRemovalReady { admitted: _ } => false
          ReviewerRemovalBlocked { missing: NoApprovingReview } => true
          ReviewerRemovalBlocked { missing: _ } => false
        })
    // every act is once-per-fleet, field by field over the record
    && all_steps_are_fleet_once(steps: deployment_gate_operator_steps)
}

// THE BOUNDARY IS TWO ACTS, NOT ONE ACT WEARING A HAT. If the removal were folded into the enablement row
// the ordering would have nothing to order — the type guarantees two FIELDS, and this guarantees two
// DIFFERENT acts behind them. Distinctness is asserted on the identities directly; an earlier revision
// cast both to String and compared the castings, which was one step removed from the fact.
test fn the_removal_is_not_collapsed_into_the_enablement() -> Bool {
  (rule_enablement_step.instruction as String).contains("Do not remove any reviewer")
    // and the act behind the READY decision is a different act from the enablement one, by identity
    && (match ready_act() {
          Present { value: i } =>
            i.identity != rule_enablement_step.identity
              && deployment_gate_operator_steps.rule_enablement.identity != i.identity
          none => false
        })
}

// THE ORDER IS STILL A CLAIM ABOUT THE WORLD, AND IT IS CHECKABLE WHERE IT IS WRITTEN: the field order
// above has removal last, and the act it names is the one whose instruction removes reviewers while the
// enablement act's instruction says not to. A re-binding of the two fields reddens the test above; this
// one reddens if either instruction stops stating which side of the boundary it is on — the pair of
// claims that keeps an interval with no gate from being described as a handover.
test fn the_last_field_is_the_one_that_weakens_the_gate() -> Bool {
  // each act's own text says the thing its name promises, in words that are actually there
  (match ready_act() {
       Present { value: i } => (i.instruction as String).contains("after the removal")
         // THE ACT NAMES THE SUBJECT IT CHANGES, assembled from the boundary rather than written as a
         // literal that could describe some other one.
         && (i.instruction as String).contains("gunb-ai/gunbc")
         && (i.subject as String).contains(gate_env as String)
       none => false
     })
    && (deployment_gate_operator_steps.rule_enablement.instruction as String).contains("custom deployment protection rule")
    // and the enablement row forbids itself from doing the removal, in its own words
    && (deployment_gate_operator_steps.rule_enablement.instruction as String).contains("must still be present")
    && !(deployment_gate_operator_steps.rule_enablement.instruction as String).contains("after the removal")
}

// THE MUTATION THE BINDING CHECK EXISTS FOR, WRITTEN OUT. The sequence type makes reordering impossible
// as an *edit of the literal* — but a caller can still bind the two boundary fields to each other's rows,
// and that compiles. This is the swapped sequence, built through the type's own constructor: the control
// that shows the identity check above is discriminating rather than automatically true. If the binding
// check were weakened to `true`, this test is where it would be caught — a swapped sequence must NOT look
// like the honest one.
// THE CONTROL THE SIDE CHAT ASKED FOR, and the test the swap used to be. Before blocker 2 the two
// boundary fields could be bound to each other's rows and compile; now they have DIFFERENT TYPES (a
// HumanIntervention versus a ReviewerRemovalStepDecision), so that swap is not writable at all — the
// residue that still needs a control is the SUBJECT the act is issued for, because the admission and the
// act were each checked locally and nothing compared them. Three cases, one per direction:
//   (a) the honest boundary DOES yield the act;
//   (b) a genuine pair on the sibling lane's environment does NOT;
//   (c) a genuine pair in another repository does NOT, even naming srv1-production.
// Each wrong case must refuse TYPED, naming both sides, and must not fall back to the constant act.
// HISTORICAL EVIDENCE DOES NOT OUTLIVE THE RULE (side chat, blocker 3). The trial pair proves the rule
// worked WHEN THE TRIAL RAN. Approve on A, reject on B, then switch the App rule off -- or replace it
// with another rule id, or move it to another installation, or remove the reviewer by hand -- and the
// old admission must not still yield the act that weakens the boundary. Five cases, one per arm the side
// chat named, plus the honest one so the four cannot be green because nothing is ever Ready:
//   (a) the rule is no longer enabled                    -> Blocked (via the standing's own mint)
//   (b) a DIFFERENT rule id is the one enabled now        -> Blocked, naming all three ids
//   (c) the standing is about another installation        -> Blocked, naming all three
//   (d) the human reviewer has already been removed       -> Blocked at the mint
//   (e) the main-only branch rule has gone                -> Blocked at the mint
//   (f) all current                                      -> Ready
//
// (a), (d) and (e) are refused by the standing's MINT rather than by the act function, which is where
// they belong: a standing that fails them cannot exist, so the act function has nothing to re-check
// (R1/§4b: no unreachable re-validation of a construction downstream). The act function's job is to
// CARRY THAT CAUSE INTO ITS OWN DECISION rather than flatten it: "the rule is off", "the reviewer is
// already gone" and "the branch rule has gone" are three different repairs, and a decision that said
// only "no standing" would make the operator re-derive which one -- and would leave the typed refusal
// the mint gives with no consumer at all.
test fn historical_evidence_does_not_outlive_the_rule() -> Bool {
  // (a) THE RULE IS DISABLED NOW. The sealed ownership read requires enabled AND attributed, so a rule
  // switched off arrives as NoEnabledRule rather than as a standing -- which is the point: there is no
  // value of type CurrentRemovalBoundaryStanding that means "the rule is off", so the act function can
  // never be handed one.
  (match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_disabled_rule(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
         ReviewerRemovalReady { admitted: _ } => false
         ReviewerRemovalBlocked {
           missing: StandingWasNotRead {
             because: JoinWasRefused {
               because: OwnershipWasNotEstablished {
                 because: NoEnabledRule,
               },
             },
           },
         } => true
         ReviewerRemovalBlocked { missing: _ } => false
       })
    // (b) A DIFFERENT RULE IS THE ONE ENABLED NOW: the trial answered rule 900000001, the environment
    // now answers 900000002. Refusing here is what "the rule was replaced" means in this model.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
    environment: gate_env,
    installation_id: canonical_installation_id,
    identity_repo: gate_repo,
    rule_id: 900000002,
    reviewer_present: true,
    main_only: true,
),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: ActStandingDisagreesOnRule {
               standing_rule_id: now_rule,
               approved_rule_id: a_rule,
               rejected_rule_id: r_rule,
             },
           } => now_rule == 900000002 && a_rule == canonical_rule_id && r_rule == canonical_rule_id
           ReviewerRemovalBlocked { missing: _ } => false
         })
    // (c) THE STANDING IS ABOUT ANOTHER INSTALLATION: a different App installation now owns an enabled
    // rule on the same environment. The trial's gate is not the gate that is standing.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
    environment: gate_env,
    installation_id: 888800002,
    identity_repo: gate_repo,
    rule_id: canonical_rule_id,
    reviewer_present: true,
    main_only: true,
),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: ActStandingDisagreesOnInstallation {
               standing_installation_id: now_i,
               approved_installation_id: a_i,
               rejected_installation_id: r_i,
             },
           } => now_i.value == 888800002
             && a_i.value == canonical_installation_id
             && r_i.value == canonical_installation_id
           ReviewerRemovalBlocked { missing: _ } => false
         })
    // (d) THE HUMAN REVIEWER IS ALREADY GONE. There is no act to perform, and issuing one is how a
    // second removal gets waved through. Refused where the standing is MADE.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_no_reviewer(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: StandingWasNotRead {
               because: RequiredReviewerIsNoLongerPresent { environment: named },
             },
           } => named == gate_env
           ReviewerRemovalBlocked { missing: _ } => false
         })
    // (e) THE MAIN-ONLY BRANCH RULE HAS GONE: the environment is reachable from any ref, so the
    // boundary has already been weakened and nothing may be removed against it until it is repaired.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_no_branch_rule(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: StandingWasNotRead {
               because: BranchPolicyIsNoLongerMainOnly { environment: named },
             },
           } => named == gate_env
           ReviewerRemovalBlocked { missing: _ } => false
         })
    // (f) THE CONTROL: everything current yields the act. Without this the five above could be green
    // because the act is never issued at all.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_for_trial(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: a } =>
             a.boundary.environment_name == gate_env
               && a.evidence.approved.run_id == 35447067113
           ReviewerRemovalBlocked { missing: _ } => false
         })
}

// THE PROTECTION READ AS A VALUE THIS FILE CANNOT WRITE. EnvironmentProtectionObservation is
// sole_constructor over a GitHubEnvironmentProtectionSettings that carries its OWN name, which is what
// makes "healthy, but for a DIFFERENT environment" expressible -- and refusable. protection_read below
// stays as the settings-only helper; this is the only way to hold an observation.
fn protection_for(
  owner: NonEmptyStr,
  repo: NonEmptyStr,
  environment: NonEmptyStr,
  reviewer_present: Bool,
  main_only: Bool
) -> EnvironmentProtectionObservation
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_cannot_join_ownership_with_another_environments_protection"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "completion_is_a_read_after_the_removal_not_the_admission"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "joined_pair"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "standing_at"
    ),
  ]
{
  observe_environment_protection(
    owner: owner,
    repo: repo,
    environment_name: environment,
    settings: protection_read(
      environment: environment,
      reviewer_present: reviewer_present,
      main_only: main_only,
    ),
  )
}

// THE JOIN, obtained through the one door. Every standing in this file is built from a joined pair,
// so the join function is exercised by the honest cases too, not only by the reds.
fn joined_pair(
  environment: NonEmptyStr,
  reviewer_present: Bool,
  main_only: Bool,
  // WHETHER THE RULE IS STILL ENABLED. Defaulted by every healthy call to true and set false by the
  // one fixture that needs it: a rule switched off between the trial and the removal ask is the case
  // the whole historical-evidence test is about, and it has to arrive through the same join so that
  // nothing else differs.
  enabled: Bool
) -> ProtectionOwnershipJoin
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "standing_disabled_rule"
    ),
  ]
{
  join_protection_to_ownership(
    protection: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: environment,
      reviewer_present: reviewer_present,
      main_only: main_only,
    ),
    ownership: ownership_with_enabled(
      enabled: enabled,
      environment: environment,
      installation_id: canonical_installation_id,
      identity_repo: gate_repo,
      rule_id: canonical_rule_id,
    ),
  )
}

// THE STANDING'S OWN COORDINATES. A standing is now bound to the boundary, the attempt and the instant
// it was read at, so the tests have to say which attempt they mean -- and the replay red has to be able
// to name TWO attempts.
fn standing_attempt() -> AttemptIdentity {
  attempt_or_default(a: attempt_identity_of(run_id: "35447067113", run_attempt: "1"))
}

fn later_attempt() -> AttemptIdentity {
  attempt_or_default(a: attempt_identity_of(run_id: "35447067113", run_attempt: "2"))
}

fn attempt_or_default(a: AttemptIdentity?) -> AttemptIdentity {
  match a {
    Present { value: v } => v
    Absent => "run-35447067113-attempt-1" as AttemptIdentity
  }
}

// THE INSTANTS, AS STRINGS, BANDED AT THE CROSSING BY A DECLARED RETURN TYPE. Timestamp is a
// transparent alias of String, so `x as Timestamp` on a reference keeps String and a `data` row's
// annotation does not brand what callers see either -- the checker then refuses the mint's
// Timestamp parameter. The spelling this corpus proves is a helper whose OWN return type is
// declared, exactly as runner_connectivity_recovery_witness writes `fn act_ts(s: String) ->
// Timestamp { s as Timestamp }`.
fn standing_ts(s: String) -> Timestamp {
  s as Timestamp
}

data standing_instant: String = "2026-10-19T12:00:00Z"

// AN INSTANT at most standing_max_age past standing_instant, and one well past it. The staleness red
// needs both, and needs them as REAL instants rather than as a Bool somebody set.
data standing_instant_fresh: String = "2026-10-19T12:01:00Z"

data standing_instant_stale: String = "2026-10-19T13:00:00Z"

// THE STANDING VARIANTS THE RED NEEDS, each built through the one admitted door with its facts changed.
// THE STANDING CANNOT BE BUILT FROM TWO ENVIRONMENTS (side chat round 4, blocker 1). The standing used
// to take an ownership and a protection read as two loose values and never ask whether they named the
// SAME environment; both protection predicates ignored the settings' own name. So srv1's rule ownership
// joined with a SIBLING environment's healthy protection minted a standing, and the act function read
// only the ownership half -- the environment actually vouched for was never checked. The join now
// happens BEFORE any standing exists and refuses typed, so a mismatched pair has no representation to
// travel with.
// A STANDING IS SPENDABLE ONCE, FOR THE DISPATCH IT WAS READ ON, AND ONLY WHILE THE WORLD HAS NOT MOVED
// (side chat round 4, blocker 2: "the fresh standing is replayable"). The fields blocker 2 added -- the
// boundary, the observation attempt, the instant -- are not decoration: each of the four clauses below is
// the only thing that makes one of those fields load-bearing, and each drops a `true` to a `false` if the
// corresponding comparison in reviewer_removal_act_for is deleted.
//
// THE REPLAY CONTROL IS THE INTERESTING ONE. Read the standing while everything is healthy, then model the
// world as having moved -- the removal is asked for under a NEW attempt, which is also how a rule being
// switched off between the read and the act shows up, since a re-dispatch is what a new pending deployment
// means -- and the old standing must refuse. What cannot be modeled is named as a residual in the plan
// carrier: GitHub offers no compare-and-set on environment protection, and a human clicks after the read.
// THE RESIDUAL IS A ROW, NOT A SENTENCE. reviewer_removal_act_for closes every arm it can and one
// window it cannot: GitHub offers no compare-and-set on environment protection and the removal is
// performed by a HUMAN after the read, so the read-now → click-later gap stays open however many fields
// the standing carries. That gap is declared as data with five fields, and this test is the row's
// consumer (§3c) AND its guard: an empty field, or a field that stopped naming the mechanism it is
// supposed to describe, reddens here instead of leaving a residual written to satisfy a reviewer. Each
// clause below is load-bearing against one edit to the row -- blank a field, drop the ETag evidence,
// drop the If-Match trigger, or strip a mechanism out of enforced_instead, and one `true` becomes a
// `false`. It is deliberately not a rung_drop: nothing has regressed to prose, and a RungDrop would
// promise a restoration that depends on GitHub admitting a conditional mutation it does not have.
test fn the_observation_window_residual_declares_what_it_cannot_close() -> Bool {
  let limit = reviewer_removal_observation_window
  // EVERY FIELD HAS TO SAY SOMETHING, and the way that is checked is by demanding each field carry the
  // content only that field can carry -- a residual with a blank or generic field is the prose case
  // wearing a record's clothes. There is deliberately no `field != ""` clause: the fields are
  // NonEmptyStr, so such a check could never go red (§5). Each of the five fields is instead pinned to
  // a substring below, which is the check that actually bites.
  //
  // WHAT IT CLAIMS TO HAVE TRIED is the compare-and-set it actually lacks.
  (limit.attempted as String).contains("compare-and-set")
    // THE UPSTREAM ABSENCE IS EVIDENCED, not asserted: it names the mechanism it looked for and failed
    // to find on the pinned description.
    && (limit.upstream_absence as String).contains("ETag")
    && (limit.upstream_absence as String).contains("environments")
    // WHAT IS ENFORCED INSTEAD names all three mechanisms the checks really implement, so the row cannot
    // quietly drift away from the model it belongs to. Drop any one of these words from the row's
    // enforced_instead and this reddens -- which is also the red that fires if someone DELETES the check
    // it cites and leaves the row describing a guarantee that no longer exists.
    && (limit.enforced_instead as String).contains("observation_attempt")
    && (limit.enforced_instead as String).contains("standing_max_age")
    && (limit.enforced_instead as String).contains("sealed")
    // THE TRIGGER OBSERVES SOMETHING. A retirement trigger nobody could ever witness is a wish, so it has
    // to name the concrete upstream admission it waits for.
    && (limit.retirement_trigger as String).contains("If-Match")
    // THE WINDOW IS THE READ-TO-CLICK ONE, the same gap the act's age bound narrows without closing: the
    // human's click is in the consequence, not a generic risk.
    && (limit.consequence as String).contains("click")
}

test fn a_standing_from_another_attempt_or_an_aged_one_is_not_spendable() -> Bool {
  // (a) A READ BELONGING TO ANOTHER DISPATCH, asked about by this one.
  (match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_at(
      environment: gate_env,
      installation_id: canonical_installation_id,
      identity_repo: gate_repo,
      rule_id: canonical_rule_id,
      reviewer_present: true,
      main_only: true,
      attempt: later_attempt(),
      observed_at: standing_ts(s: standing_instant),
    ),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
    ReviewerRemovalBlocked {
      missing: ActStandingIsForAnotherAttempt { standing_attempt: a, removal_attempt: r },
    } => a != r && a != standing_attempt()
    ReviewerRemovalBlocked { missing: _ } => false
    ReviewerRemovalReady { admitted: _ } => false
  })
    // (b) THE CONTROL: the same read, asked about by the attempt it was read on, is spendable.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
        environment: gate_env,
        installation_id: canonical_installation_id,
        identity_repo: gate_repo,
        rule_id: canonical_rule_id,
        reviewer_present: true,
        main_only: true,
      ),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
      ReviewerRemovalReady { admitted: a } => a.standing.observation_attempt == standing_attempt()
      ReviewerRemovalBlocked { missing: _ } => false
    })
    // (c) A GENUINE READ THAT HAS AGED PAST THE DECLARED BOUND. Nothing about it is forged and nothing is
    // the wrong subject: it is a true statement about a world that may have moved, and age is the only
    // reason it is refused. The refusal carries the bound it was measured against.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
        environment: gate_env,
        installation_id: canonical_installation_id,
        identity_repo: gate_repo,
        rule_id: canonical_rule_id,
        reviewer_present: true,
        main_only: true,
      ),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant_stale),
    ) {
      ReviewerRemovalBlocked {
        missing: ActStandingIsStale { observed_at: o, now: n, max_age: m },
      } =>
        o == standing_instant && n == standing_instant_stale
          && second_count(s: m) == second_count(s: standing_max_age)
      ReviewerRemovalBlocked { missing: _ } => false
      ReviewerRemovalReady { admitted: _ } => false
    })
    // (d) THE SAME READ INSIDE THE BOUND is spendable, so (c) is refusing on age and not on the instants
    // being unusable values.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
        environment: gate_env,
        installation_id: canonical_installation_id,
        identity_repo: gate_repo,
        rule_id: canonical_rule_id,
        reviewer_present: true,
        main_only: true,
      ),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant_fresh),
    ) {
      ReviewerRemovalReady { admitted: a } => a.standing.observed_at == standing_instant
      ReviewerRemovalBlocked { missing: _ } => false
    })
    // (e) THE ACT CARRIES THE READ THAT AUTHORIZED IT, so the consumer of a Ready act can see which read
    // it stands on rather than taking the act's word for it.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_fixture(
        environment: gate_env,
        installation_id: canonical_installation_id,
        identity_repo: gate_repo,
        rule_id: canonical_rule_id,
        reviewer_present: true,
        main_only: true,
      ),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
      ReviewerRemovalReady { admitted: a } =>
        a.standing.ownership.rule_id == a.evidence.approved.rule_id
          && a.standing.boundary.environment_name == a.boundary.environment_name
      ReviewerRemovalBlocked { missing: _ } => false
    })
}

test fn a_standing_cannot_join_ownership_with_another_environments_protection() -> Bool {
  // THE CONTROL FIRST: ownership and protection both read for srv1 join, and the standing exists.
  (match join_protection_to_ownership(
         protection: protection_for(
           owner: gate_owner,
           repo: gate_repo,
           environment: gate_env,
           reviewer_present: true,
           main_only: true,
         ),
         ownership: ownership_for(
           environment: gate_env,
           installation_id: canonical_installation_id,
           identity_repo: gate_repo,
           rule_id: canonical_rule_id,
         ),
       ) {
         ProtectionJoinEstablished {
           protection: joined_protection,
           ownership: joined_ownership,
         } =>
           joined_protection.environment_name == gate_env
             && joined_ownership.environment_name == gate_env
         ProtectionJoinRefused { because: _ } => false
       })
    // THE MUTATION: the SAME healthy protection, read for the SIBLING environment, against srv1's
    // ownership. Healthy is not the same as THIS one.
    && (match join_protection_to_ownership(
           protection: protection_for(
             owner: gate_owner,
             repo: gate_repo,
             environment: sibling_env,
             reviewer_present: true,
             main_only: true,
           ),
           ownership: ownership_for(
             environment: gate_env,
             installation_id: canonical_installation_id,
             identity_repo: gate_repo,
             rule_id: canonical_rule_id,
           ),
         ) {
           ProtectionJoinEstablished { protection: _, ownership: _ } => false
           ProtectionJoinRefused {
             because: ProtectionWasReadForAnotherEnvironment {
               observed_environment: seen,
               ownership_environment: expected,
             },
           } => seen == sibling_env && expected == gate_env
           ProtectionJoinRefused { because: _ } => false
         })
    // THE INVERSE: the protection is right and the OWNERSHIP is the sibling's. One question, asked once
    // -- not two checks that can disagree about which half matters.
    && (match join_protection_to_ownership(
           protection: protection_for(
             owner: gate_owner,
             repo: gate_repo,
             environment: gate_env,
             reviewer_present: true,
             main_only: true,
           ),
           ownership: ownership_for(
             environment: sibling_env,
             installation_id: canonical_installation_id,
             identity_repo: gate_repo,
             rule_id: canonical_rule_id,
           ),
         ) {
           ProtectionJoinEstablished { protection: _, ownership: _ } => false
           ProtectionJoinRefused {
             because: ProtectionWasReadForAnotherEnvironment {
               observed_environment: seen,
               ownership_environment: expected,
             },
           } => seen == gate_env && expected == sibling_env
           ProtectionJoinRefused { because: _ } => false
         })
    // A PROTECTION READ FROM ANOTHER REPOSITORY does not join either. Environments are per-repository
    // objects: gcp-iam-bootstrap in a fork and gcp-iam-bootstrap here share a NAME and nothing else.
    && (match join_protection_to_ownership(
           protection: protection_for(
             owner: gate_owner,
             repo: other_repo,
             environment: gate_env,
             reviewer_present: true,
             main_only: true,
           ),
           ownership: ownership_for(
             environment: gate_env,
             installation_id: canonical_installation_id,
             identity_repo: gate_repo,
             rule_id: canonical_rule_id,
           ),
         ) {
           ProtectionJoinEstablished { protection: _, ownership: _ } => false
           ProtectionJoinRefused {
             because: ProtectionWasReadForAnotherRepository {
               observed_repository: seen,
               ownership_repository: expected,
             },
           } => seen == other_repo && expected == gate_repo
           ProtectionJoinRefused { because: _ } => false
         })
    // THE JOIN IS THE ONLY DOOR: a standing whose halves came from different environments cannot be
    // minted at all, because the mint takes the JOINED pair rather than two loose values.
    && (match observe_removal_boundary_standing(
           joined: join_protection_to_ownership(
             protection: protection_for(
               owner: gate_owner,
               repo: gate_repo,
               environment: sibling_env,
               reviewer_present: true,
               main_only: true,
             ),
             ownership: ownership_for(
               environment: gate_env,
               installation_id: canonical_installation_id,
               identity_repo: gate_repo,
               rule_id: canonical_rule_id,
             ),
           ),
           boundary: srv1_deployment_gate_boundary,
           attempt: standing_attempt(),
           observed_at: standing_ts(s: standing_instant),
         ) {
           StandingRead { standing: _ } => false
           StandingRefused { because: _ } => true
         })
}

fn standing_disabled_rule() -> RemovalBoundaryStandingObservation
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "historical_evidence_does_not_outlive_the_rule"
    ),
  ]
{
  observe_removal_boundary_standing(
    // THE RULE IS OFF, and everything else is exactly as healthy as the control: joined_pair builds
    // the pair from the two reads, and the disabled rule is the only thing that differs.
    joined: joined_pair(
      environment: gate_env,
      reviewer_present: true,
      main_only: true,
      enabled: false,
    ),
    boundary: standing_boundary_for(environment: gate_env, identity_repo: gate_repo),
    attempt: standing_attempt(),
    observed_at: standing_ts(s: standing_instant),
  )
}

fn standing_no_reviewer() -> RemovalBoundaryStandingObservation {
  standing_fixture(
    environment: gate_env,
    installation_id: canonical_installation_id,
    identity_repo: gate_repo,
    rule_id: canonical_rule_id,
    reviewer_present: false,
    main_only: true,
  )
}

fn standing_no_branch_rule() -> RemovalBoundaryStandingObservation {
  standing_fixture(
    environment: gate_env,
    installation_id: canonical_installation_id,
    identity_repo: gate_repo,
    rule_id: canonical_rule_id,
    reviewer_present: true,
    main_only: false,
  )
}

test fn the_act_is_issued_only_for_the_boundary_the_pair_was_witnessed_on() -> Bool {
  // (a) THE HONEST PAIR, THE HONEST BOUNDARY: the act exists and names that subject.
  (match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_for_trial(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
         ReviewerRemovalReady { admitted: a } =>
           let i = a.intervention
           let e = a.evidence
           (i.subject as String).contains(gate_env as String)
             && (i.subject as String).contains("gunb-ai/gunbc")
             && e.boundary.environment_name == gate_env
         ReviewerRemovalBlocked { missing: _ } => false
       })
    // (b) A GENUINE PAIR ON THE SIBLING LANE'S ENVIRONMENT, asked about srv1. It was witnessed on
    // gcp-iam-bootstrap, so it is evidence about gcp-iam-bootstrap; it must not yield srv1's act.
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair_on(
    approved: receipt_on(run_id: 35447067113, state: Approved, environment: sibling_env),
    rejected: receipt_on(run_id: 35447067114, state: Rejected, environment: sibling_env),
    boundary: sibling_boundary,
),
      standing: standing_for_trial(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: ActAddressedAnotherEnvironment {
               expected_environment: wanted,
               witnessed_environment: seen,
             },
           } => (wanted as String) == (gate_env as String) && (seen as String) == (sibling_env as String)
           ReviewerRemovalBlocked { missing: _ } => false
         })
    // (c) A GENUINE PAIR IN ANOTHER REPOSITORY THAT NAMED ITS ENVIRONMENT srv1-production. The
    // environment half matches; the repository half does not. This is the case the old signature had no
    // argument for, so it is the one that could not even be refused.
    && (match reviewer_removal_act_for(
      boundary: fork_boundary,
      admission: admitted_pair(),
      standing: standing_for_trial(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: _ } => false
           ReviewerRemovalBlocked {
             missing: ActAddressedAnotherRepository {
               expected_repository: wanted_repo,
               witnessed_repository: seen_repo,
             },
           } => (seen_repo as String) == "gunb-ai/gunbc"
             && (wanted_repo as String) == "gunb-ai/someone-elses-fork"
           ReviewerRemovalBlocked { missing: _ } => false
         })
}

// ---------------------------------------------------------------------------
// 3. The removal act needs a typed admission, not an instruction that mentions both outcomes
// ---------------------------------------------------------------------------

// THE DISCRIMINATING RED for the guard itself, in both directions. The frontier refuses, so the act is
// not performable; an admission MINTED THROUGH THE CALL admits it. If the prerequisite were prose
// again, neither clause would be a fact anyone could break — the instruction already contained the
// words APPROVING and REJECTING and proved nothing.
// THE ACT NAMES ITS OWN SUBJECT, IN ITS IDENTITY AND IN ITS ROUTE. Two defects lived here.
//
// (1) The identity was "…reviewer-removal." ++ environment ONLY. Environments are PER-REPOSITORY
// objects, so this repository's srv1-production and a fork's srv1-production shared one intervention
// identity -- and two acts that must be discharged separately cannot share an identity. The repository
// half is in the name now, so the census is asserted against a fork carrying the SAME environment name,
// which is exactly the case the old key could not tell apart.
//
// (2) The readback route was joined with concat("/", readback) while the readback itself began with
// "/environments/", printing "…/gunbc//environments/srv1-production" in the instructions an operator
// follows -- a route no GitHub API answers. So the printed route is checked for the doubled slash, and
// for the readback spelled exactly once.
//
// The identity census is taken on THE BUILDER'S OWN OUTPUT (side chat ruling, R1: exercise a
// construction at its builder rather than re-validating it downstream); the route is read off the act
// the admitted branch actually issued, because that is the text an operator copies.
test fn the_removal_act_names_its_subject_in_its_identity_and_in_its_route() -> Bool {
  let srv1_identity = (reviewer_removal_act_identity(
    boundary: srv1_deployment_gate_boundary,
  ) as String)
  let fork_identity = (reviewer_removal_act_identity(boundary: fork_boundary) as String)
  let sibling_identity = (reviewer_removal_act_identity(
    boundary: sibling_boundary,
  ) as String)
  let expected_identity = concat(
    "github.deployment-rule.reviewer-removal.",
    concat("gunb-ai/gunbc", concat("/", gate_env as String)),
  )
  let expected_route = concat(
    "GET /repos/gunb-ai/gunbc/environments/",
    gate_env as String,
  )
  // THE HONEST ACT EXISTS AND SAYS THE RIGHT THING, so nothing below can be green because no act was
  // ever issued.
  (match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_for_trial(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
         ReviewerRemovalReady { admitted: a } =>
           let i = a.intervention
           let route_text = i.instruction as String
           // BOTH HALVES OF THE SUBJECT, in the act's own words.
           (i.subject as String).contains("gunb-ai/gunbc")
             && (i.subject as String).contains(gate_env as String)
             // THE PRINTED ROUTE IS ONE A GITHUB API ANSWERS: one slash at the join, and the readback
             // spelled exactly once in the instruction.
             && route_text.contains(expected_route as String)
             && !(route_text.contains("//environments/"))
             && !(route_text.contains("gunbc//"))
         ReviewerRemovalBlocked { missing: _ } => false
       })
    // THE IDENTITY IS THE WHOLE SUBJECT, in the order the route uses its parts.
    && srv1_identity == (expected_identity as String)
    // A SIBLING ENVIRONMENT IN THE SAME REPOSITORY gets its own identity, so discharging one lane's act
    // cannot close out the other's.
    && sibling_identity != srv1_identity
    // A DIFFERENT REPOSITORY CARRYING THE SAME ENVIRONMENT NAME gets its own identity. THIS is the
    // regression the old key permitted: same environment string, same identity, one discharge closing
    // two acts.
    && fork_identity != srv1_identity
    // ...and the fork's identity names THE FORK, so the act that unlocks it is not filed under this
    // repository's name.
    && fork_identity.contains("gunb-ai/someone-elses-fork")
}

test fn the_removal_act_is_admitted_only_by_a_typed_prerequisite() -> Bool {
  // stage 1: nothing has been witnessed, so nothing is performable, and the refusal is TYPED — the
  // reason the mint gave, not a Bool that threw it away (review 82571 dissolved the Bool helper that
  // used to answer this question).
  (match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: reviewer_removal_admission,
    // The frontier refuses at the admission, so the standing is never consulted; passing a read
// that did not happen keeps the refusal honest about which axis is empty.
standing: standing_never_read(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
         ReviewerRemovalReady { admitted: _ } => false
         ReviewerRemovalBlocked { missing: NoApprovingReview } => true
         ReviewerRemovalBlocked { missing: _ } => false
       })
    // ...and with a witnessed pair on the named subject, the SAME act becomes performable
    && (match reviewer_removal_act_for(
      boundary: srv1_deployment_gate_boundary,
      admission: admitted_pair(),
      standing: standing_for_trial(),
      removal_attempt: standing_attempt(),
      now: standing_ts(s: standing_instant),
    ) {
           ReviewerRemovalReady { admitted: a } =>
             let i = a.intervention
             let e = a.evidence
             (i.identity as String).contains(gate_env as String)
               && e.approved.run_id == 35447067113
               && e.rejected.run_id == 35447067114
               && e.boundary.environment_name == gate_env
           ReviewerRemovalBlocked { missing: _ } => false
         })
}

// THE ACT CLAIMS NO COMPLETION BEFORE THE HUMAN ACTS. std.human_intervention defines completion evidence
// as the human having done the act, and the authorization selector counts DischargedAt as a substrate
// receipt -- so an act carrying DischargedAt {admit_reviewer_removal} was the model asserting that a
// PREREQUISITE run discharged an act whose only remaining step was the human's click. The admission is the
// prerequisite; the receipt is ReviewerRemovalObserved, minted from the post-removal readback. So Ready
// must carry NoDischargeSiteModeled, and the act's own instructions are what tell the operator to click.
test fn the_ready_act_claims_no_completion_before_the_human_acts() -> Bool {
  match reviewer_removal_act_for(
    boundary: srv1_deployment_gate_boundary,
    admission: admitted_pair(),
    standing: standing_for_trial(),
    removal_attempt: standing_attempt(),
    now: standing_ts(s: standing_instant),
  ) {
    ReviewerRemovalReady { admitted: a } =>
      match a.intervention.completion_evidence {
        NoDischargeSiteModeled => true
        DischargedAt { evidence: _ } => false
      }
    ReviewerRemovalBlocked { missing: _ } => false
  }
}

// THE PREREQUISITE IS NOT THE RECEIPT. The discharge site the model DOES name is the stage-5 post-removal
// readback, reached only through observe_reviewer_removal -- which refuses a read of another subject, a
// read that still shows the reviewer, and a read where the main-only branch policy went with the reviewer.
// A reviewer still present is not a completion, whatever the caller intended, and a read of the SIBLING
// environment is not a completion of this one.
test fn completion_is_a_read_after_the_removal_not_the_admission() -> Bool {
  match observe_reviewer_removal(
    boundary: srv1_deployment_gate_boundary,
    after: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: gate_env,
      reviewer_present: false,
      main_only: true,
    ),
    observed_at: standing_ts(s: standing_instant_fresh),
  ) {
    ReviewerRemovalCompletionRecorded { receipt } =>
      receipt.reviewer_removed && receipt.main_only_policy_present
        && receipt.observed_at == standing_instant_fresh
        && receipt.boundary.environment_name == gate_env
    ReviewerRemovalCompletionRefused { because: _ } => false
  }
  && match observe_reviewer_removal(
    boundary: srv1_deployment_gate_boundary,
    after: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: gate_env,
      reviewer_present: true,
      main_only: true,
    ),
    observed_at: standing_ts(s: standing_instant_fresh),
  ) {
    ReviewerRemovalCompletionRefused { because: ReviewerIsStillPresent { environment: e } } => e == gate_env
    _ => false
  }
  && match observe_reviewer_removal(
    boundary: srv1_deployment_gate_boundary,
    after: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: gate_env,
      reviewer_present: false,
      main_only: false,
    ),
    observed_at: standing_ts(s: standing_instant_fresh),
  ) {
    ReviewerRemovalCompletionRefused { because: BranchPolicyWentWithTheReviewer { environment: e } } =>
      e == gate_env
    _ => false
  }
  && match observe_reviewer_removal(
    boundary: sibling_boundary,
    after: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: sibling_env,
      reviewer_present: false,
      main_only: true,
    ),
    observed_at: standing_ts(s: standing_instant_fresh),
  ) {
    ReviewerRemovalCompletionRecorded { receipt } => receipt.boundary.environment_name == sibling_env
    _ => false
  }
  && match observe_reviewer_removal(
    boundary: srv1_deployment_gate_boundary,
    after: protection_for(
      owner: gate_owner,
      repo: gate_repo,
      environment: sibling_env,
      reviewer_present: false,
      main_only: true,
    ),
    observed_at: standing_ts(s: standing_instant_fresh),
  ) {
    ReviewerRemovalCompletionRefused {
      because: CompletionReadIsOfAnotherSubject { subject: m },
    } => m.requested_environment == gate_env && m.standing_environment == sibling_env
    _ => false
  }
}

// Each mutation is a shortcut someone would actually take: both arms the same state, both arms on the
// SAME dispatch, one arm witnessed on an environment nobody gates, an environment the removal is not
// for. None is expressed as a hand-built record — they are inputs to the mints, because building the
// record is exactly what this file is no longer allowed to do.
// THE TRIAL IS ONE TRIAL OF ONE RULE, THROUGH ONE INSTALLATION, IN ONE REPOSITORY (the manager's
// question, and the answer is: no, "approve on rule A, reject on rule B" is NOT a valid trial). More
// than one rule can be enabled on a single environment, so answering one is no evidence the other
// answers at all — and the removal is the act that WEAKENS the srv1 root boundary. Each case mints both
// arms through the real producers with one value moved; nothing here is a hand-built record.
test fn a_trial_that_answers_two_rules_two_installations_or_two_repositories_is_refused() -> Bool {
  // APPROVE ON RULE A, REJECT ON RULE B. Both readbacks are real, both rules are enabled, both are
  // attributed to this App: only the rule the trial was a trial OF differs.
  (match admit_reviewer_removal(
          approved: canonical_receipt(run_id: 35447067113, state: Approved),
          rejected: receipt_for(
            run_id: 35447067114,
            state: Rejected,
            owner: gate_owner,
            repo: gate_repo,
            environment: gate_env,
            owned_environment: gate_env,
            expected: 204,
            installation_id: canonical_installation_id,
            identity_repo: gate_repo,
            // a DIFFERENT enabled rule of the same App
            rule_id: 900000002,
          ),
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalRefused {
            missing: TrialArmsDifferOnRule { approved_rule_id: a, rejected_rule_id: r },
          } => a == 900000001 && r == 900000002
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // THE ARMS ANSWERED THROUGH DIFFERENT INSTALLATIONS. Same repository, same rule; the identity
    // readback behind one arm is another installation's, so nothing pins WHICH App answered.
    && (match admit_reviewer_removal(
          approved: canonical_receipt(run_id: 35447067113, state: Approved),
          rejected: receipt_for(
            run_id: 35447067114,
            state: Rejected,
            owner: gate_owner,
            repo: gate_repo,
            environment: gate_env,
            owned_environment: gate_env,
            expected: 204,
            installation_id: 999900002,
            identity_repo: gate_repo,
            rule_id: canonical_rule_id,
          ),
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalRefused {
            missing: TrialArmsDifferOnInstallation {
              approved_installation_id: a,
              rejected_installation_id: r,
            },
          } => a.value == 888800001 && r.value == 999900002
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // ONE RUN NUMBER, TWO REPOSITORIES. A run id is not unique across GitHub; the route is
    // owner/repo-scoped, so these are two unrelated calls. Both names come back, because "which arm
    // came from the wrong repository" is the actionable question.
    && (match admit_reviewer_removal(
          approved: canonical_receipt(run_id: 35447067113, state: Approved),
          rejected: receipt_for(
            run_id: 35447067114,
            state: Rejected,
            owner: gate_owner,
            repo: other_repo,
            environment: gate_env,
            // the readback behind this arm saw the OTHER repository, so the mint accepts: the pair the
            // caller addressed and the pair that was read agree. It is the trial check that refuses.
            owned_environment: gate_env,
            expected: 204,
            installation_id: canonical_installation_id,
            identity_repo: other_repo,
            rule_id: canonical_rule_id,
          ),
          boundary: srv1_deployment_gate_boundary,
        ) {
          // THE REFUSAL THAT REPLACED THE PAIRWISE ONE. There used to be an arm comparing the two arms'
          // repositories to EACH OTHER; with each arm compared against the boundary it cannot fire, so it
          // was deleted rather than left green by construction (§4b). The boundary check refuses the same
          // forgery, and says which arm and which repository.
          RemovalRefused {
            missing: TrialArmIsOnAnotherRepository {
              arm: RejectingArm,
              arm_repository: seen,
              expected_repository: wanted,
            },
          } => (seen as String) == "gunb-ai/someone-elses-fork"
            && (wanted as String) == "gunb-ai/gunbc"
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // THE CONTROL: one rule, one installation, one repository — the same pair IS admitted. Without it
    // the three refusals above could be a mint that never produces a receipt.
    && (match admit_reviewer_removal(
          approved: canonical_receipt(run_id: 35447067113, state: Approved),
          rejected: canonical_receipt(run_id: 35447067114, state: Rejected),
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalAdmitted { evidence: _ } => true
          RemovalRefused { missing: _ } => false
        })
}

test fn a_removal_admission_from_one_dispatch_or_the_wrong_environment_is_refused() -> Bool {
  let approve = approved_trial(run_id: 35447067113)
  // ONE DISPATCH DRESSED AS TWO TRIALS.
  (match admit_reviewer_removal(
          approved: approve,
          rejected: rejected_trial(run_id: 35447067113),
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalRefused { missing: BothArmsOneDispatch } => true
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // ...and the arm-mislabelling, refused by name rather than as a generic "no". Both arguments here
    // are the SAME approved receipt: the mint will not produce a receipt whose state contradicts the
    // tap (see the authorization witness), so the arm check is what catches it.
    && (match admit_reviewer_removal(
          approved: approve,
          rejected: approve,
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalRefused { missing: RejectingArmWasNotARejection } => true
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // a receipt witnessed on an environment that is not the gate — the sibling lane's environment,
    // which is a real environment with a real rule, so a name check is the only thing that separates
    // it from a legitimate pair
    && (match admit_reviewer_removal(
          approved: approve,
          rejected: receipt_on(run_id: 35447067115, state: Rejected, environment: sibling_env),
          boundary: srv1_deployment_gate_boundary,
        ) {
          RemovalRefused {
            missing: TrialArmIsOnAnotherEnvironment {
              arm: RejectingArm,
              arm_environment: seen,
              expected_environment: wanted,
            },
          } => (seen as String) == (sibling_env as String) && (wanted as String) == (gate_env as String)
          RemovalRefused { missing: _ } => false
          RemovalAdmitted { evidence: _ } => false
        })
    // a refusal is a refusal, and the obstacle says WHICH one
    && (match reviewer_removal_obstacle(admission: RemovalRefused { missing: NoRejectingReview }) {
          Present { value: NoRejectingReview } => true
          // Every OTHER reason is a different blocker, and this test would be wrong to report it as
          // the missing rejection. Listing the arms is the point: a fold that mixed reasons up would
          // land here and fail.
          Present { value: _ } => false
          Absent => false
        })
    && (match admitted_pair() {
          RemovalAdmitted { evidence: e } =>
            e.approved.run_id != e.rejected.run_id && e.boundary.environment_name == gate_env
          RemovalRefused { missing: _ } => false
        })
}

// THE MINT REFUSES WHAT A LITERAL WOULD HAVE ACCEPTED. A status GitHub does not accept, a path not
// built from that run, a body releasing another environment, or an ownership that attributes nothing to
// the observed identity all produce no receipt — so the pair cannot be assembled from a call that did
// not happen the way the evidence claims. This is the discriminating red on the BINDING: mutate the run
// id or the environment anywhere in the chain and the mint refuses instead of answering.
test fn the_mint_refuses_to_answer_for_a_binding_it_was_not_given() -> Bool {
  let good = receipt_on(run_id: 35447067113, state: Approved, environment: gate_env)
  // the positive control FIRST: if the happy path stopped minting, the four mutations below would all
  // be "absent" for the wrong reason and this test would be green while proving nothing
  (good != Absent)
    // A PATH FOR ANOTHER RUN: the same 204, the same body, a different deployment. This is the
    // operator's mandated red — a mutated run id must not approve.
    && receipt_for(
         run_id: 35447067113,
         state: Approved,
         owner: gate_owner,
         repo: other_repo,
         environment: gate_env,
         owned_environment: gate_env,
         expected: 204,
         installation_id: canonical_installation_id,
         identity_repo: gate_repo,
         rule_id: canonical_rule_id,
       )
         == none
    // A STATUS GITHUB DOES NOT ACCEPT FOR THIS CALL.
    && receipt_for(
         run_id: 35447067113,
         state: Approved,
         owner: gate_owner,
         repo: gate_repo,
         environment: gate_env,
         owned_environment: gate_env,
         expected: 200,
         installation_id: canonical_installation_id,
         identity_repo: gate_repo,
         rule_id: canonical_rule_id,
       )
         == none
    // THE BODY RELEASES ANOTHER ENVIRONMENT while the caller claims srv1-production. This is the
    // other half of the mandated red — a mutated environment binding must not approve either.
    && receipt_for(
         run_id: 35447067113,
         state: Approved,
         owner: gate_owner,
         repo: gate_repo,
         environment: gate_env,
         owned_environment: sibling_env,
         expected: 204,
         installation_id: canonical_installation_id,
         identity_repo: gate_repo,
         rule_id: canonical_rule_id,
       )
         == none
    // AND THE BODY AGAINST THE CLAIM ITSELF.
    && receipt_for(
         run_id: 35447067113,
         state: Approved,
         owner: gate_owner,
         repo: gate_repo,
         environment: sibling_env,
         owned_environment: sibling_env,
         expected: 204,
         installation_id: canonical_installation_id,
         identity_repo: gate_repo,
         rule_id: canonical_rule_id,
       )
         != Absent
}

// The states in the evidence are GitHub's own wire spellings, not strings that merely look like them.
test fn the_witnessed_states_are_githubs_own() -> Bool {
  (review_state_wire(state: Approved) as String) == "approved"
    && (review_state_wire(state: Rejected) as String) == "rejected"
    && (match ready_act() {
           Present { value: i } =>
             (i.instruction as String).contains("deployment_branch_policy")
               && (i.instruction as String).contains("main")
           none => false
         })
}

// ---------------------------------------------------------------------------
// 4. The rows name the boundary they protect, and the webhook row says what it sets
// ---------------------------------------------------------------------------

test fn the_gate_rows_point_at_the_boundary_environment() -> Bool {
  deployment_gate_environment == gate_env
    && (deployment_gate_repository as String) == "gunb-ai/gunbc"
    && (rule_enablement_step.subject as String).contains("srv1-production")
    && (match ready_act() {
           Present { value: i } => (i.subject as String).contains("srv1-production")
           none => false
         })
}

// A drifted environment name is the quiet failure: the gate would be enabled on one environment and
// the reviewers removed from another. Both rows are pinned to the same symbol, and a literal that
// drifted is caught here.
test fn the_gate_rows_refuse_a_drifted_environment_name() -> Bool {
  (rule_enablement_step.subject as String).contains(gate_env as String)
    && (match ready_act() {
           Present { value: i } =>
             (i.subject as String).contains(gate_env as String)
               // the drift this catches: the gate enabled on one environment and the reviewer removed
               // from another. The act's subject is ASSEMBLED from the boundary now, so it cannot drift
               // from the subject the pair was admitted against.
               && (i.subject as String).contains(boundary_repository_label(boundary: srv1_deployment_gate_boundary) as String)
           none => false
         })
    && (rule_enablement_step.subject as String) != "mtcollins1-boot"
}

test fn the_webhook_row_forbids_exposing_the_broker() -> Bool {
  (webhook_configuration_step.instruction as String).contains("DISABLED endpoint")
    && (webhook_configuration_step.instruction as String).contains("rejected alternative")
}

// The webhook row is an OPERATOR ACT with an instruction, not a dependency the gate runs on. On the
// selected route nothing reads a delivery, so a row that made the broker depend on GitHub reaching it
// would describe a component that does not exist — and would open the exposure the route avoids.
test fn the_webhook_row_is_not_mistaken_for_a_dependency() -> Bool {
  (webhook_configuration_step.instruction as String).contains("rule_delivery_independence")
    && (webhook_configuration_step.instruction as String).contains("tailscale")
    && (webhook_configuration_step.subject as String).contains("webhook")
}

// ---------------------------------------------------------------------------
// 5. Readback types and the permission census
// ---------------------------------------------------------------------------

// The enablement row tells the operator to read back protection types. Those types are the upstream's
// three, and the readback that can ANSWER is the enabled-rules endpoint — not the /apps catalogue,
// whose items carry no rule id and no enabled flag.
test fn the_enablement_readback_uses_real_protection_types() -> Bool {
  (environment_protection_rule_type_values |> count) == 3
    && (environment_protection_rule_kind_wire(kind: RequiredReviewersKind) as String)
        == "required_reviewers"
    && (environment_protection_rule_kind_wire(kind: BranchPolicyKind) as String) == "branch_policy"
    && (environment_protection_rule_kind_wire(kind: WaitTimerKind) as String) == "wait_timer"
    && !(enabled_rule_readback_endpoint_path as String).contains("deployment_protection_rules/apps")
    && (enabled_rule_readback_items_field as String) == "custom_deployment_protection_rules"
}

test fn the_gate_app_carries_only_the_rule_permissions() -> Bool {
  (deployment_gate_app_permissions |> count) == 2
    && gate_app_permission_set_is_exact()
    && (deployment_gate_app_permissions
        |> any(p => p.name == DeploymentsAxis && p.access == AppAccessWrite))
    && (deployment_gate_app_permissions
        |> any(p => p.name == ActionsAxis && p.access == AppAccessRead))
}

// THE DISCRIMINATING RED for least privilege: the identical call over a set widened by one axis. The
// App that releases srv1 root mutation must not be able to read source, mint a workload token, or
// administer the repository.
test fn the_permission_set_refuses_a_widened_app() -> Bool {
  gate_app_permission_set_is_admissible()
    && !(deployment_gate_app_permissions
         |> append(GitHubAppPermission { name: ContentsAxis, access: AppAccessWrite })
         |> all(p => gate_app_axis_is_not_forbidden(permission: p)))
    && !(deployment_gate_app_permissions
         |> append(GitHubAppPermission { name: IdTokenAxis, access: AppAccessRead })
         |> all(p => gate_app_axis_is_not_forbidden(permission: p)))
    && !(deployment_gate_app_permissions
         |> append(GitHubAppPermission { name: AdministrationAxis, access: AppAccessWrite })
         |> all(p => gate_app_axis_is_not_forbidden(permission: p)))
}

// The installation the token is minted from is a configured fact, never a field of a readback — the
// enabled-rules response carries an App id and slug and no installation id. A record that could hold
// both confusions is the record that gets written; this checks the type cannot.
test fn the_configured_installation_is_separate_from_the_readback() -> Bool {
  let configured = GateInstallationClaim {
    installation_id: GitHubAppInstallationId { value: 1900000001 },
    app_id: GitHubAppId { value: 1234567 },
  }
    // two separate axes with two separate numbers and two separate carriers: filling either field
    // from the other axis is refused by the checker. The numbers are still compared through .value
    // because equality on these carriers is memberwise — the type does not do this check
    configured.installation_id.value == 1900000001 && configured.app_id.value == 1234567
}
