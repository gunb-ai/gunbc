  observe_gate_installation,
  observe_rule_ownership,
  InstallationObserved,
  InstallationObservationRefused,
  ObservedGateInstallation,
  ReviewerRemovalAdmission,
  RemovalAdmitted,
  RemovalRefused,
  NoRejectingReview,
  RejectingArmWasNotARejection,
  BothArmsOneDispatch,
  TrialArmIsOnAnotherEnvironment,
  TrialArmIsOnAnotherRepository,
  ActAddressedAnotherEnvironment,
  ActAddressedAnotherRepository,
  TrialArmsDifferOnRule,
  TrialArmsDifferOnInstallation,
