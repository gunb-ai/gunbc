module test.claim.deployment_gate_operator_steps_witness

import extdeps.github.workflow_runs { GitHubWorkflowRunId }
// Witness file for the five operator acts that stand up the deployment gate, and for the ordering that
// keeps the gate shut until the app-side rule has been witnessed BOTH ways.
//
// WHY THESE TESTS ARE NOT IN gunbc.auth.deployment_gate_operator_steps. No module under dag/gunbc/auth
// carries a test on main, and the reason is worth stating: a production module that ships fixtures
// ships values someone can mistake for observations. The removal act is guarded by a typed admission;
// if the evidence inside that admission were a fixture sitting in the module the act is decided from,
// the guard would be the prose it replaced wearing a type. So the fixtures live here, and — for the
// trial evidence specifically — they are not literals either: they are minted through the readback fold
// that GitHub's own records feed.
//
// Each test below is written so the WRONG model returns the wrong answer. The ordering control is
// exercised by performing the swap a shortcut would make; the identity census by dropping and doubling
// a row; the permission census by widening the App by one axis; the readback control by citing the
// endpoint that cannot answer the question.

// Timestamp: the instant a standing was read. The standing's fixtures brand their instants with
// `as Timestamp`, the spelling the sibling approval witnesses use, because a data row's annotation
// alone left the value as a plain String at the call sites and the mint refused it.
import std.types {
  String,
  Int,
  Bool,
  NonEmptyStr,
  HttpStatus,
  Timestamp,
}
// AttemptIdentity: the dispatch a standing is bound to, the same carrier the act refuses a mismatch
// against.
import std.scoped_authorization {
  AttemptIdentity,
}
// second_count: the staleness red compares the bound the refusal carried against the declared row,
// comparing the MEASURES rather than a stripped number.
import std.measure {
  second_count,
}
import std.human_intervention { DischargedAt }
import extdeps.github.app { GitHubAppInstallationId, GitHubAppId }
import extdeps.github.deployment_protection_rule {
  // THE RULE-ID CARRIER (review 83825). Witness helpers keep Int parameters and
  // wrap HERE, at the constructions -- exactly how GitHubAppInstallationId is handled
  // (installation_id: Int params, GitHubAppInstallationId { value: installation_id } at the record).
  GitHubDeploymentProtectionRuleId,
  Approved,
  Rejected,
  review_state_wire,
  environment_protection_rule_type_values,
  environment_protection_rule_kind_wire,
  RequiredReviewersKind,
  BranchPolicyKind,
  WaitTimerKind,
  enabled_rule_readback_endpoint_path,
  enabled_rule_readback_items_field,
  DeploymentProtectionRuleReview,
  ReviewState,
  EnabledDeploymentProtectionRule,
  RuleOwningApp,
  InstallationWireFields,
  installation_readback_success_status,
}
import extdeps.github.app {
  GitHubAppPermission,
  ActionsAxis,
  DeploymentsAxis,
  ContentsAxis,
  AdministrationAxis,
  IdTokenAxis,
  AppAccessRead,
  AppAccessWrite,
}
import gunbc.auth.github_deployment_environment { srv1_production_environment_name }
import gunbc.auth.deployment_gate_operator_steps {

  deployment_gate_environment,
  deployment_gate_app_permissions,
  app_registration_step,
  app_installation_step,
  webhook_configuration_step,
  rule_enablement_step,
  deployment_gate_operator_steps,
  all_steps_are_fleet_once,
  reviewer_removal_act_identity,
}
import gunbc.auth.approval_run_identity {attempt_identity_of}
import gunbc.auth.deployment_gate_authorization {
  // THE SEALED INSTANT AND ITS ONLY DOOR (round-4 ruling). The witness reads the clock through
  // read_observed_instant, admitted below; it never WRITES an instant. Naming the type is not
  // constructing it, which is what the control in the forged-probe witness then proves.
  ObservedInstant,
  read_observed_instant,
  mint_accepted_rule_review,
  AcceptedRuleReviewReceipt,
  DeploymentGateTrialEvidence,
  EnvironmentRuleOwnership,
  OwnedByGateApp,
  NotOwnedByGateApp,
  ReadbackCarriedNoRules,
  observe_gate_installation,
  observe_rule_ownership,
  InstallationObserved,
  InstallationObservationRefused,
  ObservedGateInstallation,
  ReviewerRemovalAdmission,
  RemovalAdmitted,
  RemovalRefused,
  NoRejectingReview,
  RejectingArmWasNotARejection,
  BothArmsOneDispatch,
  TrialArmIsOnAnotherEnvironment,
  TrialArmIsOnAnotherRepository,
  ActAddressedAnotherEnvironment,
  ActAddressedAnotherRepository,
  TrialArmsDifferOnRule,
  TrialArmsDifferOnInstallation,
  DeploymentGateBoundary,
  srv1_deployment_gate_boundary,
  boundary_repository_label,
  RejectingArm,
  admit_reviewer_removal,
  NoApprovingReview,
  reviewer_removal_obstacle,
  reviewer_removal_admission,
  gate_app_permissions,
  gate_app_axis_is_not_forbidden,
  gate_app_permission_set_is_admissible,
  gate_app_permission_set_is_exact,
  GateInstallationClaim,

}
// THE DECLARED RESIDUAL, consumed by the test below so the row is not an unconsumed paragraph (§3c).
import gunbc.auth.deployment_gate_operator_steps {
  reviewer_removal_observation_window,
  reviewer_removal_act_for,
  ReviewerRemovalStepDecision,
  ReviewerRemovalReady,
  ReviewerRemovalBlocked,
}
import extdeps.github.github { Repository }
import gunbc.repository { gunbc_repository }
import std.optional { Optional, Present, Absent }

data gate_env: NonEmptyStr = srv1_production_environment_name

// The sibling lane's environment (GCP IAM bootstrap: same rule, different boundary). It is in the
// tests because "a receipt from another environment" has to mean a REAL one, not an empty name — a
// name-check passes against "" only if the check is not a name check.
data sibling_env: NonEmptyStr = "gcp-iam-bootstrap"

// THE SUBJECTS, AS WHOLE VALUES (side chat, blocker 2). The old forgery was not a mismatched string: it
// was a pair of receipts genuinely witnessed on a DIFFERENT SUBJECT unlocking srv1's reviewer removal.
// Two subjects that a witness must be able to name: the sibling lane's environment in this repository,
// and a fork that happens to have called its environment srv1-production. The second one is the case the
// old signature could not express at all — an environment name alone cannot tell a fork from this repo.
data sibling_boundary: DeploymentGateBoundary = DeploymentGateBoundary {
  repository: gunbc_repository,
  environment_name: sibling_env,
}

// THE SAME ENVIRONMENT, THE SAME REPOSITORY NAME, ANOTHER ACCOUNT (round-7 M6). fork_boundary above varies
// the NAME under gunb-ai; this varies the OWNER with the name held constant -- the axis the act's
// site-local `!=`s dropped under the manager's M6 mutation and nobody noticed. full_name follows, because
// that is what GitHub prints for such a repository: someone-else/gunbc is a different repository from
// gunb-ai/gunbc that happens to share a name, not a rename of it.
data foreign_srv1_boundary: DeploymentGateBoundary = DeploymentGateBoundary {
  repository: Repository {
    owner: "someone-else",
    name: "gunbc",
    full_name: "someone-else/gunbc",
    private: false,
    default_branch: "main",
  },
  environment_name: gate_env,
}

data fork_boundary: DeploymentGateBoundary = DeploymentGateBoundary {
  repository: Repository {
    owner: "gunb-ai",
    name: "someone-elses-fork",
    full_name: "gunb-ai/someone-elses-fork",
    private: false,
    default_branch: "main",
  },
  environment_name: gate_env,
}

// THE FIXTURES ARE MINTED, NOT WRITTEN OUT, AND THE DOOR IS THE CALL. An AcceptedRuleReviewReceipt is
// obtainable only through mint_accepted_rule_review, which refuses a status GitHub does not accept, a
// path not built from that run, a body releasing another environment, and an ownership that does not
// attribute an enabled rule to the OBSERVED installation. So the pair below is not two records with
// convenient fields: it is what the mint returns for a review call that got GitHub's 204 with the run
// and the environment named in the path and the body. The fixtures that CANNOT be minted are the point
// — see the refusals asserted under the removal tests.
//
// A mint that refuses returns no receipt, so an unobtainable arm is `Absent`; the admission then
// refuses it, which is exactly what the tests below assert.
// THE REPOSITORY THE CALL ADDRESSES. The mint used to take a `path` and test it with
// `contains(run_id)`, which a path for another run, on another repository, or to another endpoint all
// satisfied. It takes the pair instead and builds the route itself, so the mutations below are mutations
// of what the call ADDRESSED — the only thing a caller can still get wrong from outside.
data gate_owner: NonEmptyStr = "gunb-ai"
data gate_repo: NonEmptyStr = "gunbc"
// THE FOREIGN ACCOUNT for the M1s standing RED and the M6 act RED: another OWNER on the same repository
// NAME (someone-else/gunbc vs gunb-ai/gunbc). Declared HERE, not borrowed -- the identically-named
// foreign_owner in github_app_manifest_witness is a GitHubUser (an installation account), and the compiler
// resolved the bare name there, which is what made the whole index refuse (a name it could not
// authenticate as a local declaration, not a red witness). This one is the plain NonEmptyStr the
// subject mints take for an owner label.
data foreign_owner: NonEmptyStr = "someone-else"
data other_repo: NonEmptyStr = "someone-elses-fork"
// would change WHICH endpoint is addressed if it were spliced into a route unexamined
data hostile_repo: NonEmptyStr = "gunbc/../other"

// THE IDENTITY, READ. ObservedGateInstallation is sole_constructor, so this file cannot write one any
// more than it can write a receipt: the only way to hold it is to call the observation route with a
// GitHub-shaped response body and a claim that agrees with it. That call is admitted to this fixture
// and to no other module — see the probe, which is refused the same call.
// THE IDENTITY READBACK, the only admitted route to an ObservedGateInstallation. The two values that
// decide WHICH installation and WHICH repository are read are parameters, so the trial reds below can
// vary them WITHOUT a second admitted caller being added: admission keys on the module and the
// declaration's name, and the honest set of producers stays { this fixture, the stage-2 route }. A
// fixture per case would have widened the seal for test convenience, which is the thing the seal is for.
fn observed_identity(installation_id: Int, identity_repo: NonEmptyStr) -> ObservedGateInstallation?
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "ownership_with_enabled"
    ),

  ]
{
  match observe_gate_installation(
    owner: "gunb-ai",
    repo: identity_repo,
    status: installation_readback_success_status,
    wire: InstallationWireFields {
      id: Present { value: installation_id },
      app_id: Present { value: 1900000001 },
      app_slug: Present { value: "gunbc-deployment-gate" },
    },
    // the claim follows the parameter: a claim pinned to one installation would make every OTHER
    // installation refuse at the OBSERVATION, and the trial case below would be absent for the wrong
    // reason instead of reaching the arm under test
    claim: GateInstallationClaim {
      installation_id: GitHubAppInstallationId { value: installation_id },
      app_id: GitHubAppId { value: 1900000001 },
    },
  ) {
    InstallationObserved { observed: o } => Present { value: o }
    InstallationObservationRefused { because: _ } => none
  }
}

// THE IDENTITY READ, OWNER EXPOSED (round-6 M1s). `observed_identity` hardcodes owner "gunb-ai", which is
// right for every test that asks "is this our installation" and wrong for the one question M1s asks: what
// happens when BOTH reads are honestly about someone-else/gunbc/srv1-production and only the boundary is
// ours? The twin is the same chain -- same wire fields, same claim-follows-parameter rule -- with the mint's
// OWN owner parameter passed through, so the ownership side derives the foreign owner from the read itself
// (observe_rule_ownership copies `observed.owner`), exactly as production would.
fn observed_identity_for_owner(
  owner: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr
) -> ObservedGateInstallation?
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2): this forwards to a sealed mint, so the
  // roster names every declaration in this module that consumes it and nothing else.
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "ownership_with_enabled_for_owner"
    ),
  ]
{
  match observe_gate_installation(
    owner: owner,
    repo: identity_repo,
    status: installation_readback_success_status,
    wire: InstallationWireFields {
      id: Present { value: installation_id },
      app_id: Present { value: 1900000001 },
      app_slug: Present { value: "gunbc-deployment-gate" },
    },
    // the claim follows the parameter (same rule as observed_identity): a claim pinned to one installation
    // would make every OTHER installation refuse at the OBSERVATION, hiding the subject check under a
    // refusal for an unrelated reason.
    claim: GateInstallationClaim {
      installation_id: GitHubAppInstallationId { value: installation_id },
      app_id: GitHubAppId { value: 1900000001 },
    },
  ) {
    InstallationObserved { observed: o } => Present { value: o }
    InstallationObservationRefused { because: _ } => none
  }
}

// THE OWNERSHIP, OWNER EXPOSED (round-6 M1s). The twin of ownership_with_enabled for the same reason: the
// ownership read's owner is DERIVED from the identity read, so exposing the identity's owner is the honest
// way to build "both reads are about the foreign account".
fn ownership_with_enabled_for_owner(
  owner: NonEmptyStr,
  environment: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int
) -> EnvironmentRuleOwnership
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_refuses_a_pair_witnessed_in_another_account"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_refuses_a_pair_witnessed_on_another_repository"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_standing_refuses_a_pair_witnessed_on_another_environment"
    ),
      decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_refuses_a_standing_sealed_for_another_account_or_another_repository"
    ),
]
{
  match observed_identity_for_owner(
    owner: owner,
    installation_id: installation_id,
    identity_repo: identity_repo,
  ) {
    Present { value: observed } =>
      observe_rule_ownership(
        rules: [
          EnabledDeploymentProtectionRule {
            id: GitHubDeploymentProtectionRuleId { value: rule_id },
            node_id: "DPPR_1",
            enabled: true,
            app: RuleOwningApp { id: GitHubAppId { value: 1900000001 }, slug: "gunbc-deployment-gate" },
          }
        ],
        environment_name: environment,
        observed: observed,
      )
    none => NotOwnedByGateApp { because: ReadbackCarriedNoRules }
  }
}

// THE OWNERSHIP, JOINED RATHER THAN WRITTEN. OwnedByGateApp carries a sealed ObservedRuleOwnership, so
// there is no literal for it here either: the fold produces it from an enabled rule attributed to the
// identity read above. A refusal here (no identity, no enabled rule, a foreign App) makes every receipt
// below refuse, which is the red that keeps this file from testing a claim it never earned.
fn ownership_for(
  environment: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int
) -> EnvironmentRuleOwnership
  admit_callers: [// THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_protection_read_naming_another_environment_never_becomes_a_standing"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_same_named_repository_in_another_account_is_a_different_subject"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_join_refuses_a_read_from_another_environment_or_another_repository"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "receipt_for"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "standing_at"
    ),
  ]
{
  ownership_with_enabled(
    environment: environment,
    installation_id: installation_id,
    identity_repo: identity_repo,
    rule_id: rule_id,
    enabled: true,
  )
}

// The same read with the ENABLED axis exposed: switching the App's rule off is exactly what "the rule
// no longer stands" means upstream, and the ownership read must be able to say it.
fn ownership_with_enabled(
  environment: NonEmptyStr,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int,
  enabled: Bool
) -> EnvironmentRuleOwnership
  admit_callers: [
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "joined_pair"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "ownership_for"
    ),
      decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_refuses_a_standing_sealed_for_another_account_or_another_repository"
    ),
]
{
  match observed_identity(installation_id: installation_id, identity_repo: identity_repo) {
    Present { value: observed } =>
      observe_rule_ownership(
        rules: [
          EnabledDeploymentProtectionRule {
            id: GitHubDeploymentProtectionRuleId { value: rule_id },
            node_id: "DPPR_1",
            enabled: enabled,
            app: RuleOwningApp { id: GitHubAppId { value: 1900000001 }, slug: "gunbc-deployment-gate" },
          }
        ],
        environment_name: environment,
        observed: observed,
      )
    none => NotOwnedByGateApp { because: ReadbackCarriedNoRules }
  }
}

// THE ONE ADMITTED PRODUCER OF RECEIPTS IN THIS FILE. Everything the mint is allowed to refuse is a
// parameter — the repository the call ADDRESSED, the environment claimed and the one the readback saw,
// the status GitHub returned, and (for the trial reds) the installation, the readback's repository and
// the rule. The canonical values are supplied by receipt_on below, so the ordinary cases read as they
// did before.
fn receipt_for(
  run_id: GitHubWorkflowRunId,
  state: ReviewState,
  owner: NonEmptyStr,
  repo: NonEmptyStr,
  environment: NonEmptyStr,
  owned_environment: NonEmptyStr,
  expected: HttpStatus,
  installation_id: Int,
  identity_repo: NonEmptyStr,
  rule_id: Int,
) -> Optional<AcceptedRuleReviewReceipt>
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_trial_that_answers_two_rules_two_installations_or_two_repositories_is_refused"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "receipt_on"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_mint_refuses_to_answer_for_a_binding_it_was_not_given"
    ),
  ]
{
  match mint_accepted_rule_review(
    owner: owner,
    repo: repo,
    run_id: run_id,
    environment_name: environment,
    intended: state,
    review: DeploymentProtectionRuleReview {
      environment_name: environment,
      state: state,
      comment: Present { value: "witness" },
    },
    status: expected,
    ownership: ownership_for(
      environment: owned_environment,
      installation_id: installation_id,
      identity_repo: identity_repo,
      rule_id: rule_id,
    ),
    requested_rule_id: GitHubDeploymentProtectionRuleId { value: rule_id },
  ) {
    // `none`, the spelling this model's Optional arms use. A fixture yielding the other absent
    // constructor would not fall into `none =>` at the consumer; it crashes the match instead of
    // refusing it, which is a worse failure than a red.
    Accepted { receipt: r } => Present { value: r }
    AcceptedReviewRefused { because: _ } => none
  }
}

// THE CANONICAL VALUES, in one place: this App's installation, the repository the identity was read
// from, and the gate's rule. Every ordinary case goes through here, so a case that varies one of them
// says so explicitly at its call site.
data canonical_installation_id: Int = 888800001
data canonical_rule_id: Int = 900000001

// THE WAY A RECEIPT IS OBTAINED: the path built from the run, the body naming the environment the call
// releases, the status GitHub accepts for that call, and the ownership attributing an enabled rule to
// the observed identity. Every argument below is one the caller had to earn.
// THE TRIAL'S CANONICAL ARM: this App's installation, this repository, the gate's rule. Used wherever a
// case varies something on the OTHER arm only, so "which arm drifted" is a single deliberate act.
fn canonical_receipt(run_id: GitHubWorkflowRunId, state: ReviewState) -> Optional<AcceptedRuleReviewReceipt>
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_trial_that_answers_two_rules_two_installations_or_two_repositories_is_refused"
    ),
  ]
{
  receipt_on(run_id: run_id, state: state, environment: gate_env)
}

fn receipt_on(
  run_id: GitHubWorkflowRunId,
  state: ReviewState,
  environment: NonEmptyStr
) -> Optional<AcceptedRuleReviewReceipt>
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_removal_admission_from_one_dispatch_or_the_wrong_environment_is_refused"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "approved_trial"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "canonical_receipt"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "rejected_trial"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_act_is_issued_only_for_the_boundary_the_pair_was_witnessed_on"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "the_mint_refuses_to_answer_for_a_binding_it_was_not_given"
    ),
  ]
{
  receipt_for(
    run_id: run_id,
    state: state,
    owner: gate_owner,
    repo: gate_repo,
    environment: environment,
    owned_environment: environment,
    expected: 204,
    installation_id: canonical_installation_id,
    identity_repo: gate_repo,
    rule_id: canonical_rule_id,
  )
}

fn approved_trial(run_id: GitHubWorkflowRunId) -> Optional<AcceptedRuleReviewReceipt>
  admit_callers: [
  // THE WITNESS DOOR IS NOT A SIDE DOOR (side chat, blocker 2). This helper forwards to a sealed
  // mint, so an OPEN proxy here is a mint with the confine painted on the wall: a foreign module
  // could call the helper and obtain a sealed record without ever being named by the mint. The
  // roster is every declaration IN THIS MODULE that consumes it -- derived from the call sites, not
  // from memory -- and nothing else. The mint rosters stay as narrow as they were; closing the
  // proxies is what makes the chain close end to end, because admission is enforced with no
  // same-module exemption (v2.compiler.infer: a call refuses when no entry names its caller).
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "a_removal_admission_from_one_dispatch_or_the_wrong_environment_is_refused"
    ),
    decl_ref(
      module_path: "test.claim.deployment_gate_operator_steps_witness",
      decl_name: "admitted_pair"
    ),
  ]
{
  receipt_on(run_id: run_id, state: Approved, environment: gate_env)
}

