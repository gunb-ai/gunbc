module test.claim.ci_floor_population_receipt_registry_witness

import std.types { Bool, NonEmptyStr }
import gunbc.ci_floor_population_receipt_registry {
  RegistryWellFormed,
  DuplicateKind,
  DuplicatePath,
  UnknownObservedPath,
  ci_floor_population_receipt_registry_row_count,
  ci_floor_population_receipt_registry_kind_labels,
  ci_floor_population_receipt_registry_paths,
  ci_floor_population_receipt_registry_well_formed,
  ci_floor_population_receipt_registry_fingerprint,
  expected_ci_floor_population_receipt_registry_fingerprint_file,
  ci_floor_population_receipts_upload_glob,
  ci_floor_population_receipts_upload_path_exact_expression,
  ci_floor_population_receipts_walk_attempt_exact_expression,
  registry_rows_well_formed,
  planted_duplicate_kind_rows,
  planted_duplicate_path_rows,
  observe_path_against_registry,
  settlement_required_kind_labels,
  string_list_contains_exact,
}

fn expected_registry_kind_labels() -> List<String> {
  [
    "PreWalkCapture",
    "PhaseJournal",
    "BatchWall",
    "CompileCleanWall",
    "Component",
    "NativeTransition",
    "OnSuccessStage1",
    "OnSuccessStage2",
    "OnSuccessMaterialization",
    "WorkerObservation",
    "WorkerTerminal",
  ]
}

fn expected_registry_paths() -> List<String> {
  [
    "receipts/pre-walk-capture.tsv",
    "phase-journal.tsv",
    "receipts/batch-wall.txt",
    "receipts/compile-clean-wall.txt",
    "receipts/component.json",
    "receipts/native-transition.tsv",
    "stages/1/receipt.tsv",
    "stages/2/receipt.tsv",
    "receipts/on-success-materialization.txt",
    "workers/observation.tsv",
    "workers/terminal-*.tsv",
  ]
}

fn list_string_eq(left: List<String>, right: List<String>) -> Bool {
  length(xs: left) == length(xs: right)
    && fold(left, init: { ok: true, idx: 0 }, f: fn(acc, x) {
      if !acc.ok {
        acc
      } else if !(x == right.skip(n: acc.idx).first()) {
        { ok: false, idx: acc.idx }
      } else {
        { ok: true, idx: acc.idx + 1 }
      }
    }).ok
}

test fn witness_registry_well_formed_exact_identities() -> Bool {
  match ci_floor_population_receipt_registry_well_formed() {
    RegistryWellFormed { row_count } =>
      row_count == 11
        && list_string_eq(
          left: ci_floor_population_receipt_registry_kind_labels(),
          right: expected_registry_kind_labels()
        )
        && list_string_eq(
          left: ci_floor_population_receipt_registry_paths(),
          right: expected_registry_paths()
        )
        && ci_floor_population_receipt_registry_row_count() == 11
    _ => false
  }
}

test fn witness_upload_paths_are_attempt_scoped_glob() -> Bool {
  ci_floor_population_receipts_upload_glob() == "target/floor-evidence/*"
}

test fn witness_production_upload_path_is_exact_not_wildcard() -> Bool {
  let exact = ci_floor_population_receipts_upload_path_exact_expression()
  !string_contains(s: exact, pattern: "*")
    && string_contains(s: exact, pattern: "steps.finalize_floor_evidence.outputs.floor_evidence_root")
    && exact == "${{ steps.finalize_floor_evidence.outputs.floor_evidence_root }}"
}

test fn witness_walk_attempt_expression_names_finalize_step() -> Bool {
  let wa = ci_floor_population_receipts_walk_attempt_exact_expression()
  string_contains(s: wa, pattern: "steps.finalize_floor_evidence.outputs.walk_attempt")
}

test fn witness_registry_fingerprint_file_is_fingerprint_plus_newline() -> Bool {
  let fp = ci_floor_population_receipt_registry_fingerprint()
  let file = expected_ci_floor_population_receipt_registry_fingerprint_file()
  file == concat(fp, "\n")
    && string_contains(s: file, pattern: "PreWalkCapture|receipts/pre-walk-capture.tsv|BeforeFloor|pre-walk-capture|1")
    && !string_contains(s: file, pattern: "PopulationReceiptManifest")
}

test fn witness_manifest_is_not_a_registry_row() -> Bool {
  !string_list_contains_exact(
    xs: ci_floor_population_receipt_registry_kind_labels(),
    needle: "PopulationReceiptManifest"
  )
    && !string_list_contains_exact(
      xs: ci_floor_population_receipt_registry_paths(),
      needle: "manifest.tsv"
    )
    && !string_list_contains_exact(
      xs: settlement_required_kind_labels(),
      needle: "PopulationReceiptManifest"
    )
}

test fn witness_required_kinds_pinned() -> Bool {
  let required = settlement_required_kind_labels()
  length(xs: required) == 9
    && string_list_contains_exact(xs: required, needle: "PreWalkCapture")
    && string_list_contains_exact(xs: required, needle: "OnSuccessStage1")
    && string_list_contains_exact(xs: required, needle: "OnSuccessMaterialization")
    && string_list_contains_exact(xs: required, needle: "NativeTransition")
}

test fn witness_registry_fingerprint_stable() -> Bool {
  let fp = ci_floor_population_receipt_registry_fingerprint()
  string_contains(s: fp, pattern: "PhaseJournal|phase-journal.tsv|DuringFloor|DuringFloor|1")
    && string_contains(s: fp, pattern: "OnSuccessStage2|stages/2/receipt.tsv|OnSuccessStage|on-success-stage-2|1")
    && string_contains(s: fp, pattern: "WorkerTerminal|workers/terminal-*.tsv|OptionalWorker|OptionalWorker|0")
}

test fn witness_planted_duplicate_kind_refuses() -> Bool {
  match registry_rows_well_formed(rows: planted_duplicate_kind_rows()) {
    DuplicateKind { kind_label } => (kind_label as String) == "PhaseJournal"
    _ => false
  }
}

test fn witness_planted_duplicate_path_refuses() -> Bool {
  match registry_rows_well_formed(rows: planted_duplicate_path_rows()) {
    DuplicatePath { path } => (path as String) == "phase-journal.tsv"
    _ => false
  }
}

test fn witness_unknown_observed_path_refuses() -> Bool {
  match observe_path_against_registry(path: "not-a-registered-receipt.txt" as NonEmptyStr) {
    UnknownObservedPath { path } => (path as String) == "not-a-registered-receipt.txt"
    _ => false
  }
}

test fn witness_registered_path_and_wildcard_accept() -> Bool {
  match observe_path_against_registry(path: "phase-journal.tsv" as NonEmptyStr) {
    RegistryWellFormed { row_count: _ } =>
      match observe_path_against_registry(path: "workers/terminal-0-abc.tsv" as NonEmptyStr) {
        RegistryWellFormed { row_count: _ } =>
          match observe_path_against_registry(path: "stages/1/receipt.tsv" as NonEmptyStr) {
            RegistryWellFormed { row_count: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn red_manifest_row_must_not_reappear() -> Bool {
  match observe_path_against_registry(path: "manifest.tsv" as NonEmptyStr) {
    UnknownObservedPath { path } => (path as String) == "manifest.tsv"
    _ => false
  }
}

test fn red_duplicate_kind_must_not_well_form() -> Bool {
  match registry_rows_well_formed(rows: planted_duplicate_kind_rows()) {
    RegistryWellFormed { row_count: _ } => false
    _ => true
  }
}
