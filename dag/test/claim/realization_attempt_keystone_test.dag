module gunbc.test.claim.realization_attempt_keystone_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data keystone_note: String = "CI2-0 Commit B keystone (operator mandate): the realization-attempt harness proven by execution in both directions BEFORE the sweep consumes it. Positive control: a planted minimal module emits through the canonical pipeline (tokenize->parse->normalize->resolve->emit against rust_target_model_staging) and reports V2TranslateSerialized with nonzero bytes. Negative control: planted garbage refuses at PhaseFrontend with a typed cause — the harness cannot report green on input the pipeline rejects. Live keystone: a REAL corpus entry produces a typed standing (either arm) with a nonempty phase label — the attempt never absorbs, never defaults, and bundle membership appears nowhere in the computation."

data planted_minimal_source: String = "module m\n\nfn add(x: Int, y: Int) -> Int { x + y }\n"

data planted_garbage_source: String = "module planted.garbage\n\nfn ((((\n"

test fn witness_planted_minimal_module_emits() -> Bool {
  let a = v2.workflow.realization_attempt.attempt_entry_source(entry: "planted://minimal", source: planted_minimal_source)
  match a.standing {
    v2.workflow.realization_attempt.V2TranslateSerialized { emitted_nonempty: ne } => ne && a.arrow_count == 1
    v2.workflow.realization_attempt.V2RealizationRefused { phase: _, exact_cause: _, located: _ } => false
  }
}

test fn witness_planted_garbage_refuses_frontend_RED() -> Bool {
  let a = v2.workflow.realization_attempt.attempt_entry_source(entry: "planted://garbage", source: planted_garbage_source)
  match a.standing {
    v2.workflow.realization_attempt.V2TranslateSerialized { emitted_nonempty: _ } => false
    v2.workflow.realization_attempt.V2RealizationRefused { phase: p, exact_cause: _, located: _ } => match p {
      v2.workflow.realization_attempt.PhaseFrontend => true
      _ => false
    }
  }
}

test fn witness_real_corpus_entry_produces_typed_standing() -> Bool {
  let a = v2.workflow.realization_attempt.attempt_entry(entry: "dag/test/claim/witness_execution_class_test.dag")
  let label = v2.workflow.realization_attempt.attempt_phase_label(a: a)
  (label != "") && (label != "read")
}

fn ka_read(text: String, id: Symbol, path: String) -> v2.compiler.source_authority.DagSourceReadWitness {
  v2.compiler.source_authority.DagSourceReadWitness {
    source: extdeps.communication.medium.Medium { carried: text, fidelity: extdeps.communication.medium.Lossless },
    artifact: v2.std.artifact.Artifact { kind: v2.std.artifact.SourceFile, id: id, file_path: path },
    compilation_unit: ^ka_unit,
    source_root: V2Tree
  }
}

fn ka_two_module_ingest() -> v2.compiler.source_authority.SourceRootIngest {
  std.algebra.Cons {
    head: ka_read(text: "module ka_importee\n\nfn helper(x: Int) -> Int { x + 1 }\n", id: ^ka_importee_art, path: "src/v2/test/fixture/ka_importee.dag"),
    tail: std.algebra.Cons {
      head: ka_read(text: "module ka_importer\n\nimport ka_importee { helper }\n\nfn subject(x: Int) -> Int { helper(x: x) }\n", id: ^ka_importer_art, path: "src/v2/test/fixture/ka_importer.dag"),
      tail: std.algebra.Empty
    }
  }
}

fn ka_admission() -> v2.compiler.name_resolve.Admission {
  v2.compiler.name_resolve.Admission {
    subject: v2.compiler.name_resolve.ResolutionSubject { name: std.algebra.Cons { head: ^ka_importer, tail: std.algebra.Empty } },
    imports: std.algebra.Cons {
      head: v2.compiler.name_resolve.Import { target: std.algebra.Cons { head: ^ka_importee, tail: std.algebra.Empty }, visibility: v2.compiler.name_resolve.ImportVisible },
      tail: std.algebra.Empty
    }
  }
}

test fn witness_assembled_cross_module_subject_reaches_typed_standing() -> Bool {
  let a = v2.workflow.realization_attempt.attempt_assembled(ingest: ka_two_module_ingest(), admission: ka_admission(), fn_name: ^subject, entry: "planted://ka_importer")
  let label = v2.workflow.realization_attempt.attempt_phase_label(a: a)
  label != ""
}

test fn witness_assembled_identity_absent_refuses_RED() -> Bool {
  let a = v2.workflow.realization_attempt.attempt_assembled(ingest: ka_two_module_ingest(), admission: ka_admission(), fn_name: ^no_such_declaration, entry: "planted://ka_importer")
  match a.standing {
    v2.workflow.realization_attempt.V2TranslateSerialized { emitted_nonempty: _ } => false
    v2.workflow.realization_attempt.V2RealizationRefused { phase: _, exact_cause: c, located: _ } => c == ^realization_attempt_identity_absent
  }
}

