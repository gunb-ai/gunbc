module test.claim.namespace_structural_observations_acceptance

import gunbc.namespace_reference_derived_closure_admission {
  assess_reference_binding_observation,
  ReferenceDerivedClosureAdmission,
  ReferenceDerivedClosureEstablished,
  SameFileEarlierNeighbourVisible,
  SiblingDecisionBranchExcluded,
  LaterDeclarationExcluded,
  DistinctSameSpelledDeclarationsPreserved,
}
import v1.gunbc.namespace_reference_derived_closure_production_observations {
  namespace_structural_binding_observations_a_through_d,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data namespace_structural_observations_acceptance_note: String = "THE CLOSING VALIDATION for roadmap node namespace-structural-observations (N3-A). Assesses the four neutral ReferenceBindingObservation carriers from v1.gunbc.namespace_reference_derived_closure_production_observations at the dag seam and requires all four structural capabilities to establish. Does not touch the parent namespace-reference-derived-closure witness or contract; clauses (e-f) belong to N3-B/N3-C/N3-D."

test fn witness_namespace_structural_observations_closing_contract_holds() -> Bool {
  let admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  count(admissions) == 4
    && [
      SameFileEarlierNeighbourVisible,
      SiblingDecisionBranchExcluded,
      LaterDeclarationExcluded,
      DistinctSameSpelledDeclarationsPreserved,
    ] |> all(capability => admissions |> any(status => match status {
      ReferenceDerivedClosureEstablished { receipt } => receipt.capability == capability
      _ => false
    }))
}
