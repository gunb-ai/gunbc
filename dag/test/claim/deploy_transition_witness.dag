}

fn in_force_record() -> TransitionRecord {
  TransitionRecord {
    actor: "deployer",
    invocation: "run-1",
    repo_root: "/opt/gunbc/gunbc",
    base_ref: "refs/remotes/origin/main",
    candidate: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    phase: TransitionInForce,
  }
}

fn partial_record() -> TransitionRecord {
  TransitionRecord {
    actor: "deployer",
    invocation: "run-1",
    repo_root: "/opt/gunbc/gunbc",
    base_ref: "refs/remotes/origin/main",
    candidate: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    phase: TransitionPartialLeft,
  }
}

fn acquisition_arm(a: LeaseAcquisition) -> String {
  match a {
    LeaseAcquired(_) => "acquired"
    LeaseHeldBy { holder: _ } => "held"
    LeaseHeldUndecodable { cause: _ } => "undecodable"
    LeaseAcquireLost { cause: _ } => "lost"
    LeaseUnobtainable { cause: _ } => "unobtainable"
  }
}

// THE REFUSED ACQUISITIONS NEED NO CONTEXT: a refusal of the lease store carries no held proof, so the refusal fold
// is driven here directly over the store's refusal arms. The admitting arm mints a guard bound to a context and
// carrying a committed hold, which only the context mint over a listed directory and a real acquire yield, so it is
// test.claim.deploy_transition_wet_witness a_held_lease_refuses_a_second_acquire_until_its_holder_releases.
fn acquire_with(refusal: TransitionLeaseRefusal) -> String {
  acquisition_arm(a: lease_acquisition_refused(refusal: refusal))
}

fn occupied() -> TransitionLeaseRefusal {
  TransitionLeaseOccupied { holder: "[\"deployer\", \"run-0\"]", generation: 1 }
}

fn decoded_ok(d: TransitionRecordDecode) -> Bool {
  match d {
    TransitionRecordDecoded { record: _ } => true
    TransitionRecordUndecodable { cause: _ } => false
  }
}

fn decode_cause(d: TransitionRecordDecode) -> String {
  match d {
    TransitionRecordDecoded { record: _ } => ""
    TransitionRecordUndecodable { cause: c } => c
  }
}

fn admission_admits(a: ActuationAdmission) -> Bool {
  match a {
    ActuationAdmitted => true
    ActuationRefused { reason: _ } => false
  }
}

fn admission_reason(a: ActuationAdmission) -> String {
  match a {
    ActuationAdmitted => ""
    ActuationRefused { reason: r } => r
  }
}

fn disposition_arm(d: ResidueDisposition) -> String {
  match d {
    ResidueResolvable { candidate: _ } => "resolvable"
    ResidueTransitionIncomplete { candidate: _, observed_head: _ } => "incomplete"
    ResiduePartialDeclared { candidate: _, observed_head: _ } => "partial"
    ResidueStateUnobservable { cause: _ } => "unobservable"
  }
}

fn instance_rooted(root: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "transition-dry" as NonEmptyStr),
    instance_id: "transition-dry" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: root as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18097,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

fn root_spelling_answer(root: String) -> String {
  match dashboard_instance_root_spelling_refusal(instance: instance_rooted(root: root)) {
    Present { value: why } => why
    Absent => "admitted"
  }
}

// THE INSTANCE'S ROOT RULE, EACH ARM BY ITS OWN INPUT, so a rule that answered one arm unconditionally fails.
// The transition context mints through it (the wet witness drives the mint); this pins the rule itself.
test fn the_instance_root_rule_answers_each_spelling_by_its_own_arm() -> Bool {
  root_spelling_answer(root: "/opt/gunbc") == "admitted"
    && root_spelling_answer(root: "/srv/a.b/c..d") == "admitted"
    && root_spelling_answer(root: "opt/gunbc") == "it is not absolute"
    && root_spelling_answer(root: "") == "it is not absolute"
    && root_spelling_answer(root: "/") == "it is the filesystem root"
    && string_contains(s: root_spelling_answer(root: "/opt/gunbc/"), pattern: "segment")
    && string_contains(s: root_spelling_answer(root: "/opt//gunbc"), pattern: "segment")
    && string_contains(s: root_spelling_answer(root: "//opt/gunbc"), pattern: "segment")
    && string_contains(s: root_spelling_answer(root: "/opt/./gunbc"), pattern: "segment")
    && string_contains(s: root_spelling_answer(root: "/opt/gunbc/.."), pattern: "segment")
}

// THE LAW DISCRIMINATES: one relative or one trailing-separator root among canonical ones fails the set, and the
// canonical set holds. Without this the declared-row claim below could only go red by a change to the rows.
test fn one_badly_spelled_root_fails_the_instance_set() -> Bool {
  let good = [instance_rooted(root: "/opt/gunbc"), instance_rooted(root: "/srv/gunbc")]
  dashboard_instance_roots_are_one_spelling(instances: good)
    && !dashboard_instance_roots_are_one_spelling(instances: [instance_rooted(root: "/opt/gunbc"), instance_rooted(root: "srv/gunbc")])
    && !dashboard_instance_roots_are_one_spelling(instances: [instance_rooted(root: "/srv/gunbc/"), instance_rooted(root: "/opt/gunbc")])
}

// THE DECLARED INSTANCES INHABIT THE RULE: every production root the context would mint over is spelled one way,
// read off the real declared rows. srv1 live is named, so the law cannot be satisfied by an empty roster.
test fn every_declared_instance_root_is_absolute_and_spelled_one_way() -> Bool {
  dashboard_declared_instance_roots_are_one_spelling()
    && root_spelling_answer(root: srv1_live_dashboard_instance().instance_root as String) == "admitted"
}

// THE ONE STORE-FAILURE RENDERING KEEPS EVERY ARM: std.durable_compare_and_set cas_store_failure_detail, which the
// lease store's unavailable and release-refused arms consume. Each arm by its own input, so a fold that answered one
// arm for all, or dropped the exhausted arm into a generic sentence, fails.
test fn the_store_failure_detail_keeps_every_arm() -> Bool {
  let unreadable = cas_store_failure_detail(cause: CasSlotObservationRefused { cause: CasUnreadableReadRefused { detail: "EACCES" as NonEmptyStr } })
  let refused = cas_store_failure_detail(cause: CasGenerationPublicationRefused { detail: "ENOSPC" as NonEmptyStr })
  let exhausted = cas_store_failure_detail(cause: CasGenerationSpaceExhausted { head: cas_generation_first() })
  string_contains(s: unreadable, pattern: "read refused: EACCES")
    && refused == "ENOSPC"
    && string_contains(s: exhausted, pattern: "exhausted at 1")
}

// ALL FOUR REFUSAL ARMS ARE DISTINCT, and none is an acquisition, driven through the one fold over the store's
// refusal. Asserting one arm alone would stay green against a fold that answered it unconditionally.
test fn the_four_refused_acquisitions_are_four_different_answers() -> Bool {
  let held = acquire_with(refusal: occupied())
  let corrupt = acquire_with(refusal: TransitionLeaseUndecodable { detail: "bad" })
  let lost = acquire_with(refusal: TransitionLeaseLost { detail: "raced" })
  let unobtainable = acquire_with(refusal: TransitionLeaseUnavailable { detail: "EACCES" })
  held == "held"
    && corrupt == "undecodable"
    && lost == "lost"
    && unobtainable == "unobtainable"
}

// THE FAIL-CLOSED DIRECTION, and it is the one a reasonable implementation gets wrong. A lease slot that
// does not decode is NOT a free lease: rendering it as absent would hand a second converge the critical
// section a first one is still inside. This witness reds the moment the undecodable arm is folded into
// either neighbour.
test fn a_lease_that_does_not_decode_is_not_a_free_lease() -> Bool {
  let corrupt = acquire_with(refusal: TransitionLeaseUndecodable { detail: "bad" })
  corrupt != "acquired" && corrupt != "held"
}

// A STORE THAT COULD NOT BE READ OR WRITTEN IS NOT A HELD LEASE, AND NOT A LOST RACE EITHER. Permission denied
// on the root and a lease held by a peer have opposite remedies -- fix the host, or wait -- and a lost race is a
// third (re-observe), so a fold that answered one for another would send an operator to the wrong one.
test fn a_store_refusal_is_distinguished_from_a_held_lease_and_a_lost_race() -> Bool {
  let unavailable = acquire_with(refusal: TransitionLeaseUnavailable { detail: "EACCES" })
  unavailable != acquire_with(refusal: occupied())
    && unavailable != acquire_with(refusal: TransitionLeaseLost { detail: "raced" })
}

// THE HELD ARM NAMES THE HOLDER the hold library read off the slot, so a refused converge can say who to wait for.
test fn a_held_lease_names_its_holder() -> Bool {
  match lease_acquisition_refused(refusal: occupied()) {
    LeaseHeldBy { holder: h } => string_contains(s: h, pattern: "run-0")
    LeaseAcquired(_) => false
    LeaseHeldUndecodable { cause: _ } => false
    LeaseAcquireLost { cause: _ } => false
    LeaseUnobtainable { cause: _ } => false
  }
}

// THE ROUND TRIP IS THE ORACLE FOR THE ENCODING, not a golden string: what production writes is what
// production reads back, through the two functions that actually run.
test fn a_written_record_decodes_back_to_the_same_fields() -> Bool {
  match transition_record_decode(text: transition_record_json(record: in_force_record())) {
    TransitionRecordUndecodable { cause: _ } => false
    TransitionRecordDecoded { record: r } =>
      r.actor == "deployer"
        && r.invocation == "run-1"
        && r.repo_root == "/opt/gunbc/gunbc"
        && r.base_ref == "refs/remotes/origin/main"
        && r.candidate == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        && r.phase == TransitionInForce
  }
}

test fn the_partial_phase_survives_the_round_trip_distinctly() -> Bool {
  match transition_record_decode(text: transition_record_json(record: partial_record())) {
    TransitionRecordUndecodable { cause: _ } => false
    TransitionRecordDecoded { record: r } =>
      r.phase == TransitionPartialLeft && r.phase != TransitionInForce
  }
}

// EVERY WAY A RECORD CAN BE WRONG REFUSES, and the positive control above is what stops this from
// being satisfied by a decoder that refuses everything.
test fn a_malformed_record_refuses_rather_than_decoding() -> Bool {
  !decoded_ok(d: transition_record_decode(text: "{"))
    && !decoded_ok(d: transition_record_decode(text: "\"a bare string\""))
    && !decoded_ok(d: transition_record_decode(
      text: "{\"schema\":\"gunbc.deploy_transition/0\",\"actor\":\"a\",\"invocation\":\"i\",\"repo_root\":\"r\",\"base_ref\":\"b\",\"candidate\":\"c\",\"phase\":\"in-force\"}"))
    && !decoded_ok(d: transition_record_decode(
      text: "{\"schema\":\"gunbc.deploy_transition/1\",\"actor\":\"a\",\"invocation\":\"i\",\"repo_root\":\"r\",\"base_ref\":\"b\",\"phase\":\"in-force\"}"))
    && !decoded_ok(d: transition_record_decode(
      text: "{\"schema\":\"gunbc.deploy_transition/1\",\"actor\":\"a\",\"invocation\":\"i\",\"repo_root\":\"r\",\"base_ref\":\"b\",\"candidate\":\"c\",\"phase\":\"whatever\"}"))
}

// A NUMERIC FIELD IS A REFUSAL, NOT AN EMPTY STRING. The shared JSON helper answers "" for a member
// of the wrong shape, and a candidate that decoded to "" would compare unequal to every head -- a
// refusal reached for a fabricated reason, which is worse than the real one because the cause it
// reports sends the reader somewhere else.
test fn a_field_of_the_wrong_shape_refuses_and_names_the_field() -> Bool {
  let d = transition_record_decode(
    text: "{\"schema\":\"gunbc.deploy_transition/1\",\"actor\":\"a\",\"invocation\":\"i\",\"repo_root\":\"r\",\"base_ref\":\"b\",\"candidate\":7,\"phase\":\"in-force\"}")
  !decoded_ok(d: d) && string_contains(s: decode_cause(d: d), pattern: "candidate")
}

// A DUPLICATED IDENTITY FIELD REFUSES RATHER THAN RESOLVING. RFC 8259 does not say which duplicate
// wins, so a last-wins reader accepts whichever candidate was written second -- which is exactly how
// a record carrying two candidates reads as the wrong one.
test fn a_duplicated_field_refuses_rather_than_picking_one() -> Bool {
  !decoded_ok(d: transition_record_decode(
    text: "{\"schema\":\"gunbc.deploy_transition/1\",\"actor\":\"a\",\"invocation\":\"i\",\"repo_root\":\"r\",\"base_ref\":\"b\",\"candidate\":\"c\",\"candidate\":\"d\",\"phase\":\"in-force\"}"))
}

// THE WITNESS CANNOT HAND-BUILD AN ABSENCE EITHER, AND THAT IS THE WALL WORKING. Absence now
// travels as `FilesystemEstablishedAbsence`, whose only mint is in the substrate and requires a
// listing whose success channel was true. So this helper drives the real listing/read join rather
// than asserting an arm: an absent observation here is produced the same way production produces
// one, which is what makes the arms below evidence rather than restatement.
fn observe(listed: Bool, listing: String, read: FilesystemReadOutcome) -> TransitionFileObservation {
  transition_file_observation_of(
    observed: filesystem_file_observation(
      listing: filesystem_listing_observation(
        directory: "/opt/gunbc",
        success: listed,
        entries: listing,
        error: "Permission denied (os error 13)",
      ),
      name: transition_inhibition_slots.member as String,
      path: "/opt/gunbc/transition-inhibition.json",
      read: read,
    ),
  )
}

// AN ESTABLISHED ABSENCE FOR THE ARMS THAT NEED ONE, obtained through the mint rather than written.
fn absent_observation() -> TransitionFileObservation {
  observe(
    listed: true,
    listing: "some-other-file.json",
    read: read_refused(e: "No such file or directory (os error 2)"),
  )
}

fn observation_arm(o: TransitionFileObservation) -> String {
  match o {
    TransitionFileAbsent(_) => "absent"
    TransitionFilePresent { record: _ } => "present"
    TransitionFileIndeterminate { cause: _ } => "indeterminate"
    TransitionFileObservationsDisagree { cause: _ } => "disagree"
  }
}

// THROUGH THE PRODUCER, NOT AROUND IT. These used to be hand-built `FilesystemReadSucceeded` /
// `FilesystemReadRefused` literals, which meant the witnesses started one step DOWNSTREAM of where
// production starts: `transition_inhibition_observe` feeds the raw (content, success, error) channels to
// `filesystem_read_outcome` and consumes what that returns. A literal skips the arm assignment
// entirely, so the mapping production depends on was exercised by nothing here. Same
// asserted-not-produced defect this PR found twice already; found the third time by checking every
// imported producer for a call site rather than by tripping over it.
fn good_bytes() -> FilesystemReadOutcome {
  filesystem_read_outcome(
    content: transition_record_json(record: in_force_record()),
    success: true,
    error: "",
  )
}

fn read_refused(e: String) -> FilesystemReadOutcome {
  filesystem_read_outcome(content: "", success: false, error: e)
}

// ABSENCE IS ESTABLISHED BY A SUCCESSFUL LISTING, NEVER BY A FAILED READ. This is the fail-open the
// first cut of this module shipped, and the configuration that produces it is the steady state
// rather than an edge case: the convergence runs as the repository owner and the belt as the service
// principal, so a marker the belt cannot read is the ordinary case, not a fault. Mapping that to
// "absent" hands the belt a permit exactly when the marker it could not read is the one saying stop.
//
// The three arms are driven over inputs that differ only in the two observations the fold consumes.
test fn a_marker_that_is_listed_and_unreadable_is_not_absent() -> Bool {
  observation_arm(o: observe(
    listed: true,
    listing: "transition-inhibition.json",
    read: read_refused(e: "Permission denied (os error 13)"),
  )) == "indeterminate"
    && observation_arm(o: observe(
      listed: true,
      listing: "receipts\nbin",
      read: read_refused(e: "No such file or directory"),
    )) == "absent"
    && observation_arm(o: observe(
      listed: true,
      listing: "transition-inhibition.json",
      read: good_bytes(),
    )) == "present"
}

// A DIRECTORY THAT CANNOT BE LISTED ESTABLISHES NOTHING. Without this arm the fold would fall back
// on the read, which is the same conflation one level out -- an unreadable directory would present
// as an empty one.
test fn a_directory_that_cannot_be_listed_establishes_no_absence() -> Bool {
  observation_arm(o: observe(
    listed: false,
    listing: "",
    read: read_refused(e: "Permission denied (os error 13)"),
  )) == "indeterminate"
}

// AND THE BELT REFUSES ON IT, which is the half that matters -- the arm above is only a
// classification until something acts on it. This is the end-to-end statement of the defect: an
// unreadable marker must not admit actuation.
test fn an_unreadable_marker_refuses_belt_actuation_rather_than_admitting_it() -> Bool {
  !admission_admits(a: actuation_admission(standing: actuation_standing_of(
    observed: observe(
      listed: true,
      listing: "transition-inhibition.json",
      read: read_refused(e: "Permission denied (os error 13)"),
    ),
  )))
    && admission_admits(a: actuation_admission(standing: actuation_standing_of(
      observed: absent_observation(),
    )))
}

// THIS WITNESS'S POSITIVE CONTROL USED TO BE THE FAIL-OPEN ITSELF, which is worth recording because
// it is the failure mode a control exists to prevent and it still got past review. The control read
// `observe(listed: true, listing: "receipts", read: good_bytes())` -- a listing that does NOT name
// the marker joined with a read of the marker that SUCCEEDED -- and asserted that the belt is
// ADMITTED. Under the three-state fold that configuration returned absence, because the absent arm
// never consulted the read, so the assertion passed. It was not testing that the fold admits a
// clean host; it was pinning the exact state-space conflation this module exists to close, in the
// witness whose subject is that conflation. The arm below is now the disagreement, so the old
// control would go RED -- and the replacement control is an absence the substrate established.
test fn a_marker_the_listing_missed_but_a_read_found_refuses_rather_than_permits() -> Bool {
  let disagreeing = observe(listed: true, listing: "receipts", read: good_bytes())
  observation_arm(o: disagreeing) == "disagree"
    && !admission_admits(a: actuation_admission(standing: actuation_standing_of(
      observed: disagreeing,
    )))
    && admission_admits(a: actuation_admission(standing: actuation_standing_of(
      observed: absent_observation(),
    )))
}

// MEMBERSHIP IS LINE-EXACT, so a marker is not found inside a longer neighbouring name. A substring
// test would report `transition-inhibition.json.tmp` as the marker and inhibit the belt forever on a
// host that merely has a stray temp file.
test fn a_listing_match_is_line_exact_and_not_a_substring() -> Bool {
  observation_arm(o: observe(
    listed: true,
    listing: "transition-inhibition.json.tmp",
    read: read_refused(e: "No such file or directory"),
  )) == "absent"
    && transition_lease_slots.member as String != transition_inhibition_slots.member as String
}

// ONLY ONE STANDING ADMITS. An unreadable inhibition refuses, which is the direction that matters:
// a belt tick that proceeded because it could not tell would act on a tree that is mid-transition
// exactly when the evidence protecting it is damaged.
test fn only_a_permitted_standing_admits_actuation() -> Bool {
  admission_admits(a: actuation_admission(standing: ActuationPermitted))
    && !admission_admits(a: actuation_admission(
      standing: ActuationInhibited { record: in_force_record() }))
    && !admission_admits(a: actuation_admission(
      standing: ActuationStandingUnreadable { cause: "corrupt" }))
}

// AN UNREADABLE STANDING IS NOT A PERMITTED ONE, driven through the observation fold rather than by
// constructing the standing directly, so the witness covers the join and not just the last arm.
test fn an_unreadable_inhibition_refuses_actuation() -> Bool {
  let standing = actuation_standing_of(
    observed: observe(
      listed: true,
      listing: "transition-inhibition.json",
      read: FilesystemReadSucceeded { content: "{\"schema\":\"wrong\"}" },
    ),
  )
  !admission_admits(a: actuation_admission(standing: standing))
    && string_contains(s: admission_reason(a: actuation_admission(standing: standing)), pattern: "unreadable")
}

// A REFUSAL AN OPERATOR CAN ACT ON. "Refused" alone is a verdict they must trust; naming the
// repository, the candidate and the holder lets them go and check it on the host.
test fn an_inhibited_refusal_names_the_holder_and_the_candidate() -> Bool {
  let reason = admission_reason(a: actuation_admission(
    standing: ActuationInhibited { record: in_force_record() }))
  string_contains(s: reason, pattern: "/opt/gunbc/gunbc")
    && string_contains(s: reason, pattern: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    && string_contains(s: reason, pattern: "deployer")
    && string_contains(s: reason, pattern: "run-1")
}

fn evidence(record: TransitionRecord, observed: Bool, head: String) -> ResidueEvidence {
  ResidueEvidence {
    record: record,
    head_observed: observed,
    observed_head: head,
    observation_detail: "rev-parse HEAD refused",
  }
}

// STALENESS IS RESOLVED BY EVIDENCE, NEVER BY DURATION. A record naming a candidate the repository
// is actually at describes a transition that landed whatever killed the process; the same record
// over any other head describes one that did not, and no elapsed time changes that. The two arms
// are driven over inputs differing only in the observed head.
test fn a_residue_resolves_only_when_the_repository_stands_at_its_candidate() -> Bool {
  disposition_arm(d: residue_disposition(evidence: evidence(
    record: in_force_record(),
    observed: true,
    head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ))) == "resolvable"
    && disposition_arm(d: residue_disposition(evidence: evidence(
      record: in_force_record(),
      observed: true,
      head: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    ))) == "incomplete"
}

// A DECLARED PARTIAL TRANSITION IS NOT RESOLVABLE BY A MATCHING HEAD. The phase is a first-hand
// report from the process that was there: it reached the worktree transition and the worktree
// transition failed. A head that matches afterwards means something else moved it, which is more
// alarming than a mismatch and not less -- so this arm stays separate from the resolvable one over
// an input the resolvable arm would otherwise accept.
test fn a_declared_partial_transition_refuses_even_at_a_matching_head() -> Bool {
  disposition_arm(d: residue_disposition(evidence: evidence(
    record: partial_record(),
    observed: true,
    head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ))) == "partial"
}

// AN UNOBSERVABLE REPOSITORY DOMINATES EVERY OTHER READING, including the head field that happens to
// be sitting in the carrier. Reading the head without checking whether it was observed is how a
// default value becomes a verdict.
test fn an_unobservable_repository_refuses_rather_than_reading_a_stale_head() -> Bool {
  disposition_arm(d: residue_disposition(evidence: evidence(
    record: in_force_record(),
    observed: false,
    head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ))) == "unobservable"
}

fn newer_record() -> TransitionRecord {
  TransitionRecord {
    actor: "deployer",
    invocation: "run-2",
    repo_root: "/opt/gunbc/gunbc",
    base_ref: "refs/remotes/origin/main",
    candidate: "cccccccccccccccccccccccccccccccccccccccc",
    phase: TransitionInForce,
  }
}

// SUBJECT IDENTITY IGNORES THE PHASE, and that is required rather than incidental: a transition that
// marked itself partial and then recovered must still be able to clear its OWN marker, and the phase
// is the one field it deliberately rewrote. Matching on it would make a partial transition
// permanently unclearable by the process that owns it.
test fn subject_identity_is_the_transition_and_not_its_phase() -> Bool {
  transition_record_same_subject(a: in_force_record(), b: partial_record())
    && !transition_record_same_subject(a: in_force_record(), b: newer_record())
}

// THE PHASE VOCABULARY IS A COPRODUCT AND THE SPELLINGS LIVE ONLY AT THE WIRE. An earlier revision
// carried the phase as a validated `String`, which conceded that a record with a nonsense phase was
// writable and made every consumer depend on the decoder having been the only way in. The round trip
// is the oracle for the boundary; the refusal is the oracle for everything outside the vocabulary.
test fn the_phase_round_trips_through_its_wire_spelling_and_refuses_anything_else() -> Bool {
  match transition_phase_of_wire(text: transition_phase_wire(phase: TransitionInForce)) {
    Absent => false
    Present { value: a } =>
      match transition_phase_of_wire(text: transition_phase_wire(phase: TransitionPartialLeft)) {
        Absent => false
        Present { value: b } =>
          a == TransitionInForce
            && b == TransitionPartialLeft
            && transition_phase_wire(phase: TransitionInForce)
              != transition_phase_wire(phase: TransitionPartialLeft)
            && match transition_phase_of_wire(text: "in force") {
              Absent => true
              Present { value: _ } => false
            }
      }
  }
}


// THE READ PRODUCER'S OWN ARMS. `filesystem_read_outcome` is what production feeds the raw channels
// to, and until this witness the whole file consumed hand-built variants instead, so an inverted
// success mapping -- a FAILED read rendered as succeeded -- would have gone undetected here. That is
// the fail-open this module exists to close, one layer below where the module can see it.
fn read_arm(o: FilesystemReadOutcome) -> String {
  match o {
    FilesystemReadSucceeded { content: _ } => "succeeded"
    FilesystemReadRefused { error: _ } => "refused"
  }
}

test fn the_read_producer_maps_a_failed_read_to_refused() -> Bool {
  read_arm(o: filesystem_read_outcome(content: "bytes", success: true, error: "")) == "succeeded"
    && read_arm(o: filesystem_read_outcome(content: "", success: false, error: "EACCES")) == "refused"
    && read_arm(o: filesystem_read_outcome(content: "stale", success: false, error: "EACCES")) == "refused"
}
