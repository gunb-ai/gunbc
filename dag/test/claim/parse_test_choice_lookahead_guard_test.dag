module test.claim.parse_test_choice_lookahead_guard

import std.algebra { Cons, Empty }
import v2.std.grammar {
  Choice,
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  LiteralTerminal,
  NotPredicate,
  Optional,
  Sequence,
  StampClass,
  Terminal,
  grammar_atom,
  grammar_empty_sync_tokens,
  node_atom_identity_optional
}
import v2.compiler.parse { grammar_choice_ambiguity_count, parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar, dag_prepared_lex }
import v2.compiler.tokenize { tokenize_prepared }
import v2.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.node { Node, Symbol }
import std.optional { Absent, Optional, Present }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CHOICE-OVERLAP PROOF REMOVES A ROW ONLY WHERE THE DECLARED LOOKAHEAD PROVES THE ALTERNATIVES
// DISJOINT (v2.compiler.parse lookahead_alternatives_overlap). Each grammar here is supplied, so a
// claim's cost is one analysis of a two-production root. The pairs are the ruling's controls: a guard
// that covers the shared prefix removes the row, the same guard missing that prefix keeps it, and
// the unguarded alternative keeps it -- so the removal is the guard's, not the lookahead's alone.
fn clg_tok(c: Symbol) -> GrammarExpr { Terminal { token_class: c, stamp: StampClass } }

fn clg_word(w: Symbol) -> GrammarExpr { LiteralTerminal { token_class: ^clg_ident, lexeme: w } }

fn clg_seq(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr { Sequence { left: left, right: right } }

fn clg_root(choice: GrammarExpr) -> GrammarRoot {
  GrammarRoot {
    start: ^clg_start,
    productions: Cons {
      head: GrammarProduction { name: ^clg_start, expression: choice, emitted: grammar_atom(identity: ^clg_start) },
      tail: Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

// `a :` | X, where X = `a (: | b)`: both alternatives can begin `a :`.
fn clg_named() -> GrammarExpr { clg_seq(left: clg_tok(c: ^clg_a), right: clg_tok(c: ^clg_colon)) }

fn clg_positional() -> GrammarExpr {
  clg_seq(left: clg_tok(c: ^clg_a), right: Choice { left: clg_tok(c: ^clg_colon), right: clg_tok(c: ^clg_b) })
}

fn clg_rows(guard: GrammarExpr) -> Int {
  grammar_choice_ambiguity_count(
    root: clg_root(choice: Choice { left: clg_named(), right: clg_seq(left: NotPredicate { element: guard }, right: clg_positional()) })
  )
}

test fn covering_two_token_guard_removes_the_row() -> Bool {
  clg_rows(guard: clg_named()) == 0
}

test fn near_miss_two_token_guard_keeps_the_row() -> Bool {
  clg_rows(guard: clg_seq(left: clg_tok(c: ^clg_a), right: clg_tok(c: ^clg_b))) == 1
}

test fn unguarded_shared_two_token_prefix_keeps_the_row() -> Bool {
  grammar_choice_ambiguity_count(root: clg_root(choice: Choice { left: clg_named(), right: clg_positional() })) == 1
}

// A guard whose strings would cover but whose form is not plain proves nothing: `a? :` admits `a :`,
// but an Optional is not a token-string set, so it subtracts nothing and the row stands.
test fn non_plain_guard_keeps_the_row() -> Bool {
  clg_rows(guard: clg_seq(left: Optional { element: clg_tok(c: ^clg_a) }, right: clg_tok(c: ^clg_colon))) == 1
}

// `a : x | !(a :) a b?`: the guarded side can be the one token `a`, shorter than the guard, so
// no subtraction from its own prefixes can clear the row. The guard covers the OTHER side's `a :`,
// and that is the proof; the near miss `!(a x)` covers nothing and keeps the row.
fn clg_short_rows(guard: GrammarExpr) -> Int {
  grammar_choice_ambiguity_count(
    root: clg_root(
      choice: Choice {
        left: clg_seq(left: clg_named(), right: clg_tok(c: ^clg_x)),
        right: clg_seq(
          left: NotPredicate { element: guard },
          right: clg_seq(left: clg_tok(c: ^clg_a), right: Optional { element: clg_tok(c: ^clg_b) })
        )
      }
    )
  )
}

test fn guard_covering_the_other_side_clears_a_short_guarded_side() -> Bool {
  clg_short_rows(guard: clg_named()) == 0
}

test fn guard_covering_neither_side_keeps_the_short_row() -> Bool {
  clg_short_rows(guard: clg_seq(left: clg_tok(c: ^clg_a), right: clg_tok(c: ^clg_x))) == 1
}

// A THREE-TOKEN HEAD IS PROVED BY ITS OWN GUARD'S DEPTH. `a b c | !(a b c) a b (c | d)` shares `a b`
// at the base depth; only the guard's own length reads the third token, so the covering guard clears
// the row and the near miss `!(a b d)` keeps it.
fn clg_deep_rows(guard: GrammarExpr) -> Int {
  grammar_choice_ambiguity_count(
    root: clg_root(
      choice: Choice {
        left: clg_seq(left: clg_tok(c: ^clg_a), right: clg_seq(left: clg_tok(c: ^clg_b), right: clg_tok(c: ^clg_c))),
        right: clg_seq(
          left: NotPredicate { element: guard },
          right: clg_seq(left: clg_tok(c: ^clg_a), right: clg_seq(left: clg_tok(c: ^clg_b), right: Optional { element: clg_tok(c: ^clg_c) }))
        )
      }
    )
  )
}

test fn three_token_guard_is_read_at_its_own_depth() -> Bool {
  clg_deep_rows(guard: clg_seq(left: clg_tok(c: ^clg_a), right: clg_seq(left: clg_tok(c: ^clg_b), right: clg_tok(c: ^clg_c)))) == 0
}

test fn three_token_near_miss_guard_keeps_the_row() -> Bool {
  clg_deep_rows(guard: clg_seq(left: clg_tok(c: ^clg_a), right: clg_seq(left: clg_tok(c: ^clg_b), right: clg_tok(c: ^clg_d)))) == 1
}

// The k=1 word shape (op_requires): 'none' | 'opaque' | !('none' | 'opaque') ident.
fn clg_words_guarded(guard: GrammarExpr) -> Int {
  grammar_choice_ambiguity_count(
    root: clg_root(
      choice: Choice {
        left: clg_word(w: ^clg_none),
        right: Choice {
          left: clg_word(w: ^clg_opaque),
          right: clg_seq(left: NotPredicate { element: guard }, right: clg_tok(c: ^clg_ident))
        }
      }
    )
  )
}

test fn excluded_words_guard_removes_both_word_rows() -> Bool {
  clg_words_guarded(guard: Choice { left: clg_word(w: ^clg_none), right: clg_word(w: ^clg_opaque) }) == 0
}

test fn guard_missing_one_word_keeps_that_row() -> Bool {
  clg_words_guarded(guard: clg_word(w: ^clg_none)) == 1
}

// THE ROUTE ON REAL INPUT, for a row the lookahead proof removed with no guard: `stmt`'s `return` head
// against let_sugar's bare `name = e`, whose name admits the keyword. `=` begins no expression, so
// `return 1` and `return = 1` start alike only for one token. The return statement takes its own
// alternative and carries no let_expr. The bare assignment is REFUSED: since gunbc#13168 a keyword is
// not a value name, so `return` can never bind (gunbc.recurring_failure_mode
// seed_admits_a_keyword_as_a_pattern_binder; that row's declared rung is that this position refuses
// unnamed, so this claim asserts the refusal and not its reason).
fn clg_parse(text: String, file: Symbol) -> Outcome<Node> {
  match dag_prepared_grammar() {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: prepared, diagnostics: residue } =>
      bind_outcome(
        o: tokenize_prepared(text: text, file: file, prepared: dag_prepared_lex()),
        f: fn(token_stream) {
          match parse_module_prepared(tokens: token_stream, prepared: prepared, validation_residue: residue) {
            Rejected { diagnostics: r } => Rejected { diagnostics: r }
            Accepted { value: artifact, diagnostics: d } => Accepted { value: artifact.tree, diagnostics: d }
          }
        }
      )
  }
}

fn clg_tree_has_identity(root: Node, identity: Symbol) -> Bool {
  let here = match node_atom_identity_optional(node: root) {
    Present { value: id } => id == identity
    Absent => false
  }
  here || fold(root.children, init: false, f: fn(found, e) { found || clg_tree_has_identity(root: e.target, identity: identity) })
}

fn clg_parsed_has_let(text: String, file: Symbol) -> Optional<Bool> {
  match clg_parse(text: text, file: file) {
    Accepted { value: tree, diagnostics: _ } => Present { value: clg_tree_has_identity(root: tree, identity: ^dag_surface_let_expr) }
    Rejected { diagnostics: _ } => Absent
  }
}

test fn return_statement_takes_the_return_route() -> Bool {
  match clg_parsed_has_let(text: "module probe.clg_return\nfn f() -> Int { return 1 }\n", file: ^clg_return) {
    Present { value: has_let } => !has_let
    Absent => false
  }
}

test fn keyword_named_bare_assignment_is_refused() -> Bool {
  match clg_parsed_has_let(text: "module probe.clg_assign\nfn f() -> Int {\n  return = 1\n  1\n}\n", file: ^clg_assign) {
    Present { value: _ } => false
    Absent => true
  }
}
