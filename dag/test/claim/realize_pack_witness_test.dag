module test.claim.realize_pack_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data realize_pack_witness_note: String = "P4 v0 ACCEPT: memory-safe realize packing. width = min(independence, budget/derived_bound); packing NEVER exceeds budget by construction (the exit-137 control); a BoundUnknown (underivable) bound -> width-1 maturation reserve; an unreadable budget REFUSES rather than fabricating a width (retires realization_width conservative_fallback_width, the §5 finding). NOTE on realize_packs_within_budget: budget 100 / bound 25 = 4 naive, but memory_bounded_shard_count reserves 20% headroom (effective 80 -> floor(80/25) = 3) — the maturation-reserve margin (admitted demand grows post-admission); the safe pack is 3, and 3*25 = 75 <= 100 leaves the headroom by construction."

data budget_100: std.realize_pack.HostBudget = std.realize_pack.BudgetReadable { bytes: std.measure.byte_size(count: 100) }

test fn realize_packs_within_budget_holds() -> Bool {
  let bound = std.realize_pack.BoundDerived { bytes: std.measure.byte_size(count: 25) }
  let v = std.realize_pack.realize_pack_width(bound: bound, budget: budget_100, independence_width: 16)
  let width = std.realize_pack.realize_verdict_width(v: v)
  width == 3
    && std.realize_pack.realize_fits_budget(v: v, bound: bound, budget: budget_100)
    && match v { std.realize_pack.PackedWidth { width: _ } => true  std.realize_pack.MaturationReserve { width: _ } => false  std.realize_pack.BudgetRefused => false }
}

test fn realize_capped_by_independence_holds() -> Bool {
  let bound = std.realize_pack.BoundDerived { bytes: std.measure.byte_size(count: 1) }
  let v = std.realize_pack.realize_pack_width(bound: bound, budget: budget_100, independence_width: 3)
  std.realize_pack.realize_verdict_width(v: v) == 3
    && std.realize_pack.realize_fits_budget(v: v, bound: bound, budget: budget_100)
}

test fn realize_never_exceeds_budget_holds() -> Bool {
  let bound = std.realize_pack.BoundDerived { bytes: std.measure.byte_size(count: 60) }
  let v = std.realize_pack.realize_pack_width(bound: bound, budget: budget_100, independence_width: 16)
  std.realize_pack.realize_verdict_width(v: v) == 1
    && std.realize_pack.realize_fits_budget(v: v, bound: bound, budget: budget_100)
}

test fn realize_unknown_peak_maturation_reserve_holds() -> Bool {
  let v = std.realize_pack.realize_pack_width(bound: std.realize_pack.BoundUnknown, budget: budget_100, independence_width: 16)
  std.realize_pack.realize_verdict_width(v: v) == 1
    && match v { std.realize_pack.MaturationReserve { width: _ } => true  std.realize_pack.PackedWidth { width: _ } => false  std.realize_pack.BudgetRefused => false }
}

test fn realize_unreadable_budget_refuses_holds() -> Bool {
  let bound = std.realize_pack.BoundDerived { bytes: std.measure.byte_size(count: 25) }
  let v = std.realize_pack.realize_pack_width(bound: bound, budget: std.realize_pack.BudgetUnreadable, independence_width: 16)
  match v { std.realize_pack.BudgetRefused => true  std.realize_pack.PackedWidth { width: _ } => false  std.realize_pack.MaturationReserve { width: _ } => false }
    && std.realize_pack.realize_verdict_width(v: v) == 0
    && std.realize_pack.realize_fits_budget(v: v, bound: bound, budget: std.realize_pack.BudgetUnreadable)
}

test fn realize_derived_vs_frontier_bound_holds() -> Bool {
  let derived: std.measure.ByteSize? = Present { value: std.measure.byte_size(count: 25) }
  let frontier: std.measure.ByteSize? = none
  match std.realize_pack.derived_bound_of(derived_space: derived) { std.realize_pack.BoundDerived { bytes: _ } => true  std.realize_pack.BoundUnknown => false }
    && match std.realize_pack.derived_bound_of(derived_space: frontier) { std.realize_pack.BoundDerived { bytes: _ } => false  std.realize_pack.BoundUnknown => true }
}
