module test.claim.virtual_media_unification

import std.logic { Bool }
import std.types { String }
import extdeps.bmc.virtual_media {
  VirtualMediaIntent,
  NbdProxyWebsocatParams,
  NbdProxyWebsocatTransport,
  virtual_media_transport_kind,
}
import gunbc.bmc_virtual_media {
  srv4_virtual_media_intent,
  srv4_configfs_transport,
  srv4_configfs_params,
  bmc_virtual_media_plan_of,
}
import extdeps.bmc.webui.nbd_proxy_serve { nbd_proxy_serve_intent_of_virtual_media }

test fn one_intent_two_transports_single_authority() -> Bool {
  let intent = srv4_virtual_media_intent
  let cfg_plan = bmc_virtual_media_plan_of(intent: intent, params: srv4_configfs_params)
  let proxy_params = NbdProxyWebsocatParams { session_token: "TOK", ws_path: "/nbd/0", local_nbd_port: 10809 }
  let proxy_intent = nbd_proxy_serve_intent_of_virtual_media(vm: intent, params: proxy_params)
  (cfg_plan.iso_path as String == proxy_intent.iso_path as String)
    && (cfg_plan.bmc_host as String == proxy_intent.bmc_host as String)
    && (virtual_media_transport_kind(transport: srv4_configfs_transport) == "configfs-gadget")
    && (virtual_media_transport_kind(transport: NbdProxyWebsocatTransport { params: proxy_params }) == "nbdproxy-websocat")
}
