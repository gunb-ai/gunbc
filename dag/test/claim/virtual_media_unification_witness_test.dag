module test.claim.virtual_media_unification


test fn one_intent_two_transports_single_authority() -> Bool {
  let intent = gunbc.bmc_virtual_media.srv4_virtual_media_intent
  let cfg_plan = gunbc.bmc_virtual_media.bmc_virtual_media_plan_of(intent: intent, params: gunbc.bmc_virtual_media.srv4_configfs_params)
  let proxy_params = extdeps.bmc.virtual_media.NbdProxyWebsocatParams { session_token: "TOK", ws_path: "/nbd/0", local_nbd_port: 10809 }
  let proxy_intent = extdeps.bmc.webui.nbd_proxy_serve.nbd_proxy_serve_intent_of_virtual_media(vm: intent, params: proxy_params)
  (cfg_plan.iso_path as String == proxy_intent.iso_path as String)
    && (cfg_plan.bmc_host as String == proxy_intent.bmc_host as String)
    && (extdeps.bmc.virtual_media.virtual_media_transport_kind(transport: gunbc.bmc_virtual_media.srv4_configfs_transport) == "configfs-gadget")
    && (extdeps.bmc.virtual_media.virtual_media_transport_kind(transport: extdeps.bmc.virtual_media.NbdProxyWebsocatTransport { params: proxy_params }) == "nbdproxy-websocat")
}
