module test.claim.secret_rotation_witness

// Imported from the definer rather than left as bare references. The
// no-import shape most witnesses in this directory use resolves only when some
// unrelated file elsewhere in the assembled closure has already dragged the
// target module into the pool, which is the accidental-coverage class the
// import-strip diagnosis names; a module this new is in nobody else's closure,
// so the references simply do not bind. Naming them makes this witness's
// dependencies a fact of the file instead of a property of the batch it runs in.
import std.types { String, NonEmptyStr, Bool, Int, List }
import extdeps.cloud.gcp.secret_ref { SecretRef }
import extdeps.cloud.gcp.secret_manager {
  GcpSecretVersion,
  ListSecretVersionsResponse,
  SmVersionState,
  SmEnabled,
  SmDisabled,
  SmDestroyed,
}
import gunbc.assimilate.bmc_wif_delegation_chain { bmc_srv3_admin_secret_ref }
import gunbc.auth.secret_rotation {
  SecretVersionSelector, ExactVersion, AliasLatest,
  classify_version_selector, secret_ref_selector, selector_is_alias,
  secret_version_at, version_resource_of, version_named,
  RotationConsumer,
  ConsumerVersionEvidence, ResolvedVersionObserved, ConsumerReportedSuccessOnly, ConsumerUnreachable,
  ConsumerProofOutcome, ConsumerProven, ConsumerProofRefused,
  ConsumerProofRefusal, ResolvedVersionUnobserved, ConsumerOnOtherVersion, ConsumerObservationFailed,
  prove_consumer_on_version, proof_is_proven,
  RotationConsumerRoster, census_missing_consumers, census_is_complete,
  VersionInventory, InventoryComplete, InventoryTruncated, inventory_from_list_response,
  RotationStage, VersionAdded, ConsumersProven, PriorDisabled, PriorDestroyed,
  RotationAdvance, RotationAdvanced, RotationRefused,
  RotationRefusal, ConsumerNotProvenOnAddedVersion, ConsumerCensusIncomplete,
  InventoryIncomplete, AddedVersionNotEnabled, DestroyWithoutNoConsumerConfirmation, StageOutOfOrder,
  NoConsumerObstacle, InventoryWasTruncated, PriorVersionReEnabled,
  CensusReachedNoOne, CensusMissedConsumers, ConsumerNotProvenForDestroy,
  advance_to_proven, advance_to_disabled, advance_to_destroyed, rotation_advanced,
  destroy_on_silence_sketch, alias_success_is_proof_sketch,
  bmc_srv3_admin_rotation_consumer, bmc_srv3_admin_target_version,
  bmc_srv3_admin_today_evidence, bmc_srv3_admin_proof_today,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The fixture's expected resource names are authored HERE as literals rather
// than produced by version_resource_of, so the join between a version number
// and a full resource path has an oracle independent of the function under
// test. Deriving them from the same builder would make every name-matching
// claim below a tautology that passes whichever way that builder is wrong.
data v1_name: String = "projects/gunbai-secrets/secrets/bmc-srv3-admin/versions/1"
data v2_name: String = "projects/gunbai-secrets/secrets/bmc-srv3-admin/versions/2"
data v3_name: String = "projects/gunbai-secrets/secrets/bmc-srv3-admin/versions/3"

data added_version: NonEmptyStr = "3"

fn test_secret() -> SecretRef {
  bmc_srv3_admin_secret_ref
}

fn version_row(name: String, state: SmVersionState) -> GcpSecretVersion {
  GcpSecretVersion {
    name: name,
    state: state,
    create_time: "2026-08-07T00:00:00Z",
    etag: none,
    destroy_time: none,
  }
}

fn alias_consumer(name: String) -> RotationConsumer {
  RotationConsumer { name: name as NonEmptyStr, selector: AliasLatest }
}

fn exact_consumer(name: String, version: NonEmptyStr) -> RotationConsumer {
  RotationConsumer { name: name as NonEmptyStr, selector: ExactVersion { number: version } }
}

fn roster_of(consumers: List<RotationConsumer>) -> RotationConsumerRoster {
  RotationConsumerRoster { secret: test_secret(), consumers: consumers }
}

// ---------------------------------------------------------------------------
// The resource-name join, in both directions
// ---------------------------------------------------------------------------

test fn version_resource_is_built_to_the_expected_path() -> Bool {
  version_resource_of(secret: test_secret(), version: added_version) == v3_name
}

test fn version_named_matches_only_its_own_version() -> Bool {
  version_named(listed: version_row(name: v3_name, state: SmEnabled), secret: test_secret(), version: added_version)
    && !version_named(listed: version_row(name: v2_name, state: SmEnabled), secret: test_secret(), version: added_version)
}

test fn swapping_a_version_leaves_the_rest_of_the_ref_alone() -> Bool {
  let swapped = secret_version_at(secret: test_secret(), version: added_version)
  swapped.project == test_secret().project
    && swapped.secret == test_secret().secret
    && (swapped.version as String) == "3"
}

// ---------------------------------------------------------------------------
// Selector classification
// ---------------------------------------------------------------------------

test fn latest_is_an_alias_and_a_number_is_not() -> Bool {
  selector_is_alias(selector: classify_version_selector(version: "latest" as NonEmptyStr))
    && !selector_is_alias(selector: classify_version_selector(version: "3" as NonEmptyStr))
}

test fn the_live_bmc_ref_is_alias_pinned_today() -> Bool {
  selector_is_alias(selector: secret_ref_selector(ref: bmc_srv3_admin_secret_ref))
}

// ---------------------------------------------------------------------------
// The proof rule — the discriminating claim and its positive controls
// ---------------------------------------------------------------------------

// THE discriminating case: success with no version named, selected through the
// moving alias. This is bmc-srv3-admin's shape today and it must refuse.
test fn alias_pinned_success_only_is_refused_as_unobserved() -> Bool {
  match bmc_srv3_admin_proof_today() {
    ConsumerProofRefused { cause: c } =>
      match c {
        ResolvedVersionUnobserved { consumer: who } => (who as String) == "bmc_assimilate_srv3"
        _ => false
      }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}

// Positive control 1: the SAME success-only evidence proves the claim once the
// consumer pins the added version exactly. Without this the refusal above
// could be explained by "success-only evidence is never accepted".
test fn exact_pinned_success_only_is_proven() -> Bool {
  match prove_consumer_on_version(
    consumer: exact_consumer(name: "c", version: added_version),
    evidence: ConsumerReportedSuccessOnly { consumer: "c" as NonEmptyStr },
    added: added_version,
  ) {
    ConsumerProven { consumer: _, on_version: v } => (v as String) == "3"
    ConsumerProofRefused { cause: _ } => false
  }
}

// Positive control 2: an ALIAS-pinned consumer that reports the version it
// actually resolved is proven. Without this the refusal could be explained by
// "alias-pinned consumers are never accepted", which is not the rule.
test fn alias_pinned_consumer_that_reports_its_version_is_proven() -> Bool {
  match prove_consumer_on_version(
    consumer: alias_consumer(name: "c"),
    evidence: ResolvedVersionObserved { consumer: "c" as NonEmptyStr, resolved: added_version },
    added: added_version,
  ) {
    ConsumerProven { consumer: _, on_version: v } => (v as String) == "3"
    ConsumerProofRefused { cause: _ } => false
  }
}

test fn a_consumer_resolved_to_the_prior_version_is_refuted_by_name() -> Bool {
  match prove_consumer_on_version(
    consumer: alias_consumer(name: "c"),
    evidence: ResolvedVersionObserved { consumer: "c" as NonEmptyStr, resolved: "2" as NonEmptyStr },
    added: added_version,
  ) {
    ConsumerProofRefused { cause: c } =>
      match c {
        ConsumerOnOtherVersion { consumer: _, observed: o, expected: e } =>
          (o as String) == "2" && (e as String) == "3"
        _ => false
      }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}

// An unreachable consumer is not a negative answer. It gets its own cause,
// because "could not ask" and "asked and was told no" have different remedies.
test fn an_unreachable_consumer_is_an_observation_failure_not_a_refutation() -> Bool {
  match prove_consumer_on_version(
    consumer: exact_consumer(name: "c", version: added_version),
    evidence: ConsumerUnreachable { consumer: "c" as NonEmptyStr, cause: "timeout" as NonEmptyStr },
    added: added_version,
  ) {
    ConsumerProofRefused { cause: c } =>
      match c {
        ConsumerObservationFailed { consumer: _, cause: why } => (why as String) == "timeout"
        _ => false
      }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The census is an identity join, not a count
// ---------------------------------------------------------------------------

// Two declared consumers, two pieces of evidence — but both from the same
// consumer. A count comparison passes here; the identity join must not, and
// must name the consumer that never reported.
test fn duplicate_evidence_does_not_cover_a_silent_consumer() -> Bool {
  let roster = roster_of(consumers: [alias_consumer(name: "a"), alias_consumer(name: "b")])
  let evidence = [
    ResolvedVersionObserved { consumer: "a" as NonEmptyStr, resolved: added_version },
    ResolvedVersionObserved { consumer: "a" as NonEmptyStr, resolved: added_version },
  ]
  let missing = census_missing_consumers(roster: roster, evidence: evidence)
  (evidence |> count) == (roster.consumers |> count)
    && !census_is_complete(roster: roster, evidence: evidence)
    && (missing |> count) == 1
    && (missing.first() as String) == "b"
}

test fn a_census_covering_every_declared_consumer_is_complete() -> Bool {
  let roster = roster_of(consumers: [alias_consumer(name: "a"), alias_consumer(name: "b")])
  census_is_complete(
    roster: roster,
    evidence: [
      ResolvedVersionObserved { consumer: "a" as NonEmptyStr, resolved: added_version },
      ResolvedVersionObserved { consumer: "b" as NonEmptyStr, resolved: added_version },
    ],
  )
}

// ---------------------------------------------------------------------------
// Inventory: a page is not the population
// ---------------------------------------------------------------------------

test fn a_continuation_token_makes_the_inventory_truncated() -> Bool {
  match inventory_from_list_response(
    response: ListSecretVersionsResponse {
      versions: [version_row(name: v3_name, state: SmEnabled)],
      next_page_token: Present { value: "tok" },
      total_size: none,
    },
  ) {
    InventoryTruncated { seen: seen } => seen == 1
    InventoryComplete { versions: _ } => false
  }
}

test fn an_empty_token_makes_the_inventory_complete() -> Bool {
  match inventory_from_list_response(
    response: ListSecretVersionsResponse {
      versions: [version_row(name: v3_name, state: SmEnabled)],
      next_page_token: Present { value: "" },
      total_size: none,
    },
  ) {
    InventoryComplete { versions: vs } => (vs |> count) == 1
    InventoryTruncated { seen: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Stage ordering
// ---------------------------------------------------------------------------

fn complete_inventory(versions: List<GcpSecretVersion>) -> VersionInventory {
  InventoryComplete { versions: versions }
}

fn proven_stage() -> RotationStage {
  ConsumersProven { added: added_version, proofs: [] }
}

test fn disable_selects_every_enabled_version_except_the_added_one() -> Bool {
  match advance_to_disabled(
    stage: proven_stage(),
    secret: test_secret(),
    inventory: complete_inventory(versions: [
      version_row(name: v1_name, state: SmEnabled),
      version_row(name: v2_name, state: SmEnabled),
      version_row(name: v3_name, state: SmEnabled),
    ]),
  ) {
    RotationAdvanced { stage: s } =>
      match s {
        PriorDisabled { added: _, disabled: d } =>
          (d |> count) == 2 && d.first() == v1_name
        _ => false
      }
    RotationRefused { cause: _ } => false
  }
}

test fn disable_ignores_versions_that_are_already_disabled_or_destroyed() -> Bool {
  match advance_to_disabled(
    stage: proven_stage(),
    secret: test_secret(),
    inventory: complete_inventory(versions: [
      version_row(name: v1_name, state: SmDestroyed),
      version_row(name: v2_name, state: SmDisabled),
      version_row(name: v3_name, state: SmEnabled),
    ]),
  ) {
    RotationAdvanced { stage: s } =>
      match s {
        PriorDisabled { added: _, disabled: d } => (d |> count) == 0
        _ => false
      }
    RotationRefused { cause: _ } => false
  }
}

// If the added version is not enabled, the add did not take — and disabling
// every OTHER enabled version would leave the secret with nothing usable.
test fn disable_refuses_when_the_added_version_is_not_enabled() -> Bool {
  match advance_to_disabled(
    stage: proven_stage(),
    secret: test_secret(),
    inventory: complete_inventory(versions: [
      version_row(name: v1_name, state: SmEnabled),
      version_row(name: v2_name, state: SmEnabled),
    ]),
  ) {
    RotationRefused { cause: c } =>
      match c {
        AddedVersionNotEnabled { added: a } => (a as String) == "3"
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

test fn disable_refuses_a_truncated_inventory() -> Bool {
  match advance_to_disabled(
    stage: proven_stage(),
    secret: test_secret(),
    inventory: InventoryTruncated { seen: 4 },
  ) {
    RotationRefused { cause: c } =>
      match c {
        InventoryIncomplete { seen: s } => s == 4
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// A wrong-stage advance must say the caller sequenced wrongly, NOT invent a
// finding about a census it never ran.
test fn destroy_from_an_unadvanced_stage_reports_stage_order_not_a_census_finding() -> Bool {
  match advance_to_destroyed(
    stage: VersionAdded { added: added_version },
    roster: roster_of(consumers: [exact_consumer(name: "a", version: added_version)]),
    evidence: [ConsumerReportedSuccessOnly { consumer: "a" as NonEmptyStr }],
    inventory: complete_inventory(versions: []),
  ) {
    RotationRefused { cause: c } =>
      match c {
        StageOutOfOrder { expected: e } => (e as String) == "PriorDisabled"
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

test fn prove_from_a_disabled_stage_reports_stage_order() -> Bool {
  match advance_to_proven(
    stage: PriorDisabled { added: added_version, disabled: [] },
    roster: roster_of(consumers: []),
    evidence: [],
  ) {
    RotationRefused { cause: c } =>
      match c {
        StageOutOfOrder { expected: e } => (e as String) == "VersionAdded"
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The destroy gate — silence is not confirmation
// ---------------------------------------------------------------------------

fn disabled_stage() -> RotationStage {
  PriorDisabled { added: added_version, disabled: [v2_name] }
}

fn post_disable_inventory() -> VersionInventory {
  complete_inventory(versions: [
    version_row(name: v2_name, state: SmDisabled),
    version_row(name: v3_name, state: SmEnabled),
  ])
}

// THE central refusal: a census that reached nobody produces no complaints,
// and the gate must read that as ignorance rather than as confirmation.
test fn destroy_refuses_when_the_census_reached_no_one() -> Bool {
  match advance_to_destroyed(
    stage: disabled_stage(),
    roster: roster_of(consumers: [exact_consumer(name: "a", version: added_version)]),
    evidence: [],
    inventory: post_disable_inventory(),
  ) {
    RotationRefused { cause: c } =>
      match c {
        DestroyWithoutNoConsumerConfirmation { cause: o } =>
          match o {
            CensusReachedNoOne { roster_size: n } => n == 1
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// RED CONTROL. On the exact input above, the forbidden fold says "destroy".
// This is what makes the refusal a decision rather than a coincidence: the
// two agree everywhere the census reached someone and part company here.
test fn the_silence_fold_would_have_destroyed_what_the_gate_refuses() -> Bool {
  let roster = roster_of(consumers: [exact_consumer(name: "a", version: added_version)])
  destroy_on_silence_sketch(roster: roster, evidence: [], added: added_version)
    && !rotation_advanced(
      advance: advance_to_destroyed(
        stage: disabled_stage(),
        roster: roster,
        evidence: [],
        inventory: post_disable_inventory(),
      ),
    )
}

// The two folds must AGREE once the census actually reached someone, or the
// divergence above would be explained by the gate simply refusing everything.
test fn the_silence_fold_and_the_gate_agree_when_the_census_reached_someone() -> Bool {
  let roster = roster_of(consumers: [exact_consumer(name: "a", version: added_version)])
  let evidence = [ConsumerReportedSuccessOnly { consumer: "a" as NonEmptyStr }]
  destroy_on_silence_sketch(roster: roster, evidence: evidence, added: added_version)
    && rotation_advanced(
      advance: advance_to_destroyed(
        stage: disabled_stage(),
        roster: roster,
        evidence: evidence,
        inventory: post_disable_inventory(),
      ),
    )
}

test fn destroy_refuses_an_empty_roster_as_reaching_no_one() -> Bool {
  match advance_to_destroyed(
    stage: disabled_stage(),
    roster: roster_of(consumers: []),
    evidence: [],
    inventory: post_disable_inventory(),
  ) {
    RotationRefused { cause: c } =>
      match c {
        DestroyWithoutNoConsumerConfirmation { cause: o } =>
          match o {
            CensusReachedNoOne { roster_size: n } => n == 0
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// Something re-enabling a version this rotation disabled is a consumer
// signalling need in the loudest form available.
test fn destroy_refuses_when_a_disabled_version_came_back_enabled() -> Bool {
  match advance_to_destroyed(
    stage: disabled_stage(),
    roster: roster_of(consumers: [exact_consumer(name: "a", version: added_version)]),
    evidence: [ConsumerReportedSuccessOnly { consumer: "a" as NonEmptyStr }],
    inventory: complete_inventory(versions: [
      version_row(name: v2_name, state: SmEnabled),
      version_row(name: v3_name, state: SmEnabled),
    ]),
  ) {
    RotationRefused { cause: c } =>
      match c {
        DestroyWithoutNoConsumerConfirmation { cause: o } =>
          match o {
            PriorVersionReEnabled { version: v } => v == v2_name
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

test fn destroy_refuses_a_truncated_inventory() -> Bool {
  match advance_to_destroyed(
    stage: disabled_stage(),
    roster: roster_of(consumers: [exact_consumer(name: "a", version: added_version)]),
    evidence: [ConsumerReportedSuccessOnly { consumer: "a" as NonEmptyStr }],
    inventory: InventoryTruncated { seen: 2 },
  ) {
    RotationRefused { cause: c } =>
      match c {
        DestroyWithoutNoConsumerConfirmation { cause: o } =>
          match o {
            InventoryWasTruncated { seen: s } => s == 2
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

test fn destroy_names_the_consumer_still_short_of_the_added_version() -> Bool {
  match advance_to_destroyed(
    stage: disabled_stage(),
    roster: roster_of(consumers: [alias_consumer(name: "a")]),
    evidence: [ResolvedVersionObserved { consumer: "a" as NonEmptyStr, resolved: "2" as NonEmptyStr }],
    inventory: post_disable_inventory(),
  ) {
    RotationRefused { cause: c } =>
      match c {
        DestroyWithoutNoConsumerConfirmation { cause: o } =>
          match o {
            ConsumerNotProvenForDestroy { cause: p } =>
              match p {
                ConsumerOnOtherVersion { consumer: who, observed: _, expected: _ } =>
                  (who as String) == "a"
                _ => false
              }
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The whole sequence, end to end
// ---------------------------------------------------------------------------

test fn a_fully_evidenced_rotation_traverses_all_four_stages() -> Bool {
  let roster = roster_of(consumers: [exact_consumer(name: "a", version: added_version)])
  let evidence = [ResolvedVersionObserved { consumer: "a" as NonEmptyStr, resolved: added_version }]
  let inventory_before = complete_inventory(versions: [
    version_row(name: v2_name, state: SmEnabled),
    version_row(name: v3_name, state: SmEnabled),
  ])
  match advance_to_proven(
    stage: VersionAdded { added: added_version },
    roster: roster,
    evidence: evidence,
  ) {
    RotationAdvanced { stage: proven } =>
      match advance_to_disabled(stage: proven, secret: test_secret(), inventory: inventory_before) {
        RotationAdvanced { stage: disabled } =>
          match advance_to_destroyed(
            stage: disabled,
            roster: roster,
            evidence: evidence,
            inventory: post_disable_inventory(),
          ) {
            RotationAdvanced { stage: done } =>
              match done {
                PriorDestroyed { added: a, destroyed: d } =>
                  (a as String) == "3" && (d |> count) == 1 && d.first() == v2_name
                _ => false
              }
            RotationRefused { cause: _ } => false
          }
        RotationRefused { cause: _ } => false
      }
    RotationRefused { cause: _ } => false
  }
}

// The same sequence stops at the prove stage with the fleet's ACTUAL consumer,
// which is the discriminating end-to-end claim: bmc-srv3-admin cannot be
// rotated to v3 today, and the model says exactly why.
test fn the_live_bmc_consumer_stops_the_rotation_at_the_prove_stage() -> Bool {
  match advance_to_proven(
    stage: VersionAdded { added: bmc_srv3_admin_target_version },
    roster: roster_of(consumers: [bmc_srv3_admin_rotation_consumer]),
    evidence: [bmc_srv3_admin_today_evidence],
  ) {
    RotationRefused { cause: c } =>
      match c {
        ConsumerNotProvenOnAddedVersion { cause: p } =>
          match p {
            ResolvedVersionUnobserved { consumer: who } => (who as String) == "bmc_assimilate_srv3"
            _ => false
          }
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}

// RED CONTROL for the proof wall: the forbidden reading accepts the very
// evidence the authority refuses.
test fn the_alias_proof_sketch_accepts_what_the_wall_refuses() -> Bool {
  alias_success_is_proof_sketch(evidence: bmc_srv3_admin_today_evidence)
    && !proof_is_proven(outcome: bmc_srv3_admin_proof_today())
}

// A census missing a consumer is refused BEFORE any proof runs, so the
// missing consumer is reported as missing rather than as unproven.
test fn prove_refuses_an_incomplete_census_by_name() -> Bool {
  match advance_to_proven(
    stage: VersionAdded { added: added_version },
    roster: roster_of(consumers: [
      exact_consumer(name: "a", version: added_version),
      exact_consumer(name: "b", version: added_version),
    ]),
    evidence: [ConsumerReportedSuccessOnly { consumer: "a" as NonEmptyStr }],
  ) {
    RotationRefused { cause: c } =>
      match c {
        ConsumerCensusIncomplete { missing: m } =>
          (m |> count) == 1 && (m.first() as String) == "b"
        _ => false
      }
    RotationAdvanced { stage: _ } => false
  }
}
