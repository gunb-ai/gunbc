module test.claim.secret_rotation_witness

// Imported from the definer rather than left as bare references. The no-import
// shape most witnesses here use resolves only when some unrelated file in the
// assembled closure has already dragged the target module into the pool — the
// accidental-coverage class the import-strip diagnosis names. A module this new
// is in nobody else's closure, so the references simply do not bind.

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// Expected resource names are authored HERE as literals rather than produced by
// version_resource_of, so the number-to-path join has an oracle independent of
// the function under test. Deriving them from the same builder would make every
// name-matching claim a tautology that passes whichever way that builder is wrong.
data v1_name: String = "projects/example-project/secrets/example-secret/versions/1"
data v2_name: String = "projects/example-project/secrets/example-secret/versions/2"
data v3_name: String = "projects/example-project/secrets/example-secret/versions/3"

fn v1() -> extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity { v1_name as extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
fn v2() -> extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity { v2_name as extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }
fn v3() -> extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity { v3_name as extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity }

// SYNTHETIC subject. This witness proves the generic version lifecycle, so it
// authors its own secret rather than importing a fleet credential: a witness
// that referenced a live SecretRef would tie a mechanism claim to a subject
// whose real state nobody here has observed.
fn test_secret() -> extdeps.cloud.gcp.secret_ref.SecretRef {
  extdeps.cloud.gcp.secret_ref.SecretRef {
    project: "example-project" as extdeps.cloud.gcp.gcp.GcpProjectId,
    secret: "example-secret" as std.types.NonEmptyStr,
    version: "latest" as std.types.NonEmptyStr,
    hash_state: HashPending,
  }
}

fn version_row(identity: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity, state: extdeps.cloud.gcp.secret_manager.SmVersionState) -> extdeps.cloud.gcp.secret_manager.GcpSecretVersion {
  extdeps.cloud.gcp.secret_manager.GcpSecretVersion {
    name: identity,
    state: state,
    create_time: "2026-08-07T00:00:00Z",
    etag: Present { value: concat("etag-", identity as String) },
    destroy_time: none,
  }
}

// A version observed WITHOUT an etag: no target may be built from it, because
// acting on it means acting on whatever is at that name now rather than on the
// version this rotation actually read.
fn version_row_without_etag(identity: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity, state: extdeps.cloud.gcp.secret_manager.SmVersionState) -> extdeps.cloud.gcp.secret_manager.GcpSecretVersion {
  extdeps.cloud.gcp.secret_manager.GcpSecretVersion {
    name: identity,
    state: state,
    create_time: "2026-08-07T00:00:00Z",
    etag: none,
    destroy_time: none,
  }
}

fn alias_consumer(name: String) -> gunbc.auth.secret_rotation.RotationConsumer {
  gunbc.auth.secret_rotation.RotationConsumer { id: name as gunbc.auth.secret_rotation.ConsumerId, selector: AliasLatest }
}

fn exact_consumer(name: String, version: std.types.NonEmptyStr) -> gunbc.auth.secret_rotation.RotationConsumer {
  gunbc.auth.secret_rotation.RotationConsumer { id: name as gunbc.auth.secret_rotation.ConsumerId, selector: gunbc.auth.secret_rotation.ExactVersion { number: version } }
}

fn intent_with(consumers: List<gunbc.auth.secret_rotation.RotationConsumer>, policy: gunbc.auth.secret_rotation.RetirementPolicy) -> gunbc.auth.secret_rotation.SecretRotationIntent {
  gunbc.auth.secret_rotation.SecretRotationIntent {
    intent_id: "t" as std.types.NonEmptyStr,
    subject: test_secret(),
    prior_version: v2(),
    replacement: gunbc.auth.secret_rotation.GeneratedInWorkflow { generator: "g" as std.types.NonEmptyStr, entropy_bits: bit_width(128) },
    verification: gunbc.auth.secret_rotation.ConsumerVerificationRequirement { consumers: consumers },
    retirement: policy,
  }
}

fn complete_inventory(versions: List<extdeps.cloud.gcp.secret_manager.GcpSecretVersion>) -> gunbc.auth.secret_rotation.VersionInventory {
  gunbc.auth.secret_rotation.InventoryComplete { versions: versions }
}

fn post_disable_inventory() -> gunbc.auth.secret_rotation.VersionInventory {
  complete_inventory(versions: [
    version_row(identity: v2(), state: SmDisabled),
    version_row(identity: v3(), state: SmEnabled),
  ])
}


fn applied_disable() -> gunbc.auth.secret_rotation.RetirementEffect {
  match admit_disable_receipt(version: v2(), observed_state: SmDisabled) {
    Present { value: r } => gunbc.auth.secret_rotation.RetirementApplied { disabled: [r], destroyed: [] }
    Absent => gunbc.auth.secret_rotation.RetirementNotAttempted { cause: "unreachable: disabled reads disabled" as std.types.NonEmptyStr }
  }
}

fn applied_destroy() -> gunbc.auth.secret_rotation.RetirementEffect {
  match admit_destroy_receipt(version: v2(), observed_state: SmDestroyed) {
    Present { value: r } => gunbc.auth.secret_rotation.RetirementApplied { disabled: [], destroyed: [r] }
    Absent => gunbc.auth.secret_rotation.RetirementNotAttempted { cause: "unreachable: destroyed reads destroyed" as std.types.NonEmptyStr }
  }
}

fn v2_target() -> gunbc.auth.secret_rotation.VersionTarget {
  gunbc.auth.secret_rotation.VersionTarget { identity: v2(), etag: concat("etag-", v2_name) }
}

// ---------------------------------------------------------------------------
// Identity join, built not parsed
// ---------------------------------------------------------------------------

// `first()` answers `ConsumerId?`, and reading the id back with `as String` compared the WRAPPER:
// on an empty census the assertion compared the literal text `Absent` against "b", so it failed for
// the right reason by accident, and on a present one it would have compared
// `Present { value: b }`. The compiler now refuses that cast; the elimination makes the absent case
// fail because the list is empty rather than because a wrapper does not spell like an id.
fn first_consumer_is(consumers: List<ConsumerId>, expected: String) -> Bool {
  match consumers.first() {
    Present { value: consumer } => (consumer as String) == expected
    Absent => false
  }
}

test fn version_resource_is_built_to_the_expected_path() -> Bool {
  version_resource_of(secret: test_secret(), version: "3" as std.types.NonEmptyStr) == v3_name
}

test fn identity_comparison_distinguishes_versions() -> Bool {
  identity_is(identity: v3(), other: v3()) && !identity_is(identity: v3(), other: v2())
}

test fn swapping_a_version_leaves_the_rest_of_the_ref_alone() -> Bool {
  let swapped = secret_version_at(secret: test_secret(), version: "3" as std.types.NonEmptyStr)
  swapped.project == test_secret().project
    && swapped.secret == test_secret().secret
    && (swapped.version as String) == "3"
}

test fn latest_is_an_alias_and_a_number_is_not() -> Bool {
  selector_is_alias(selector: classify_version_selector(version: "latest" as std.types.NonEmptyStr))
    && !selector_is_alias(selector: classify_version_selector(version: "3" as std.types.NonEmptyStr))
}

// ---------------------------------------------------------------------------
// AddVersion exactly once
// ---------------------------------------------------------------------------

test fn add_is_authorized_only_from_a_not_started_attempt() -> Bool {
  match authorize_add_version(attempt: gunbc.auth.secret_rotation.AttemptNotStarted { intent_id: "t" as std.types.NonEmptyStr }) {
    AddVersionAuthorized { intent_id: id } => (id as String) == "t"
    AddVersionRefused { cause: _ } => false
  }
}

// An attempt whose add was ISSUED but never confirmed must NOT re-add. This is
// the arm where a naive retry mints a second live credential.
test fn add_refuses_when_an_add_was_already_issued() -> Bool {
  match authorize_add_version(attempt: gunbc.auth.secret_rotation.AttemptAddIssued { intent_id: "t" as std.types.NonEmptyStr }) {
    AddVersionRefused { cause: c } =>
      match c {
        AddAlreadyIssued { intent_id: id } => (id as String) == "t"
        _ => false
      }
    AddVersionAuthorized { intent_id: _ } => false
  }
}

test fn add_refuses_when_the_add_already_succeeded() -> Bool {
  match authorize_add_version(attempt: gunbc.auth.secret_rotation.AttemptAdded { intent_id: "t" as std.types.NonEmptyStr, added: v3() }) {
    AddVersionRefused { cause: c } =>
      match c {
        AddAlreadySucceeded { added: a } => identity_is(identity: a, other: v3())
        _ => false
      }
    AddVersionAuthorized { intent_id: _ } => false
  }
}

// Re-running a COMPLETED rotation reports AlreadyRotated carrying the version
// it produced, and mints nothing.
test fn rerunning_a_completed_rotation_reports_already_rotated() -> Bool {
  match authorize_add_version(attempt: gunbc.auth.secret_rotation.AttemptCompleted { intent_id: "t" as std.types.NonEmptyStr, added: v3() }) {
    AddVersionRefused { cause: c } =>
      match c {
        AlreadyRotated { added: a } => identity_is(identity: a, other: v3())
        _ => false
      }
    AddVersionAuthorized { intent_id: _ } => false
  }
}

// RED CONTROL: retry-by-re-adding authorizes every attempt state, including the
// three the kernel refuses. It agrees with the kernel only on not-started.
test fn the_re_add_retry_sketch_would_authorize_what_the_kernel_refuses() -> Bool {
  retry_by_re_adding_sketch(attempt: gunbc.auth.secret_rotation.AttemptAddIssued { intent_id: "t" as std.types.NonEmptyStr })
    && retry_by_re_adding_sketch(attempt: gunbc.auth.secret_rotation.AttemptCompleted { intent_id: "t" as std.types.NonEmptyStr, added: v3() })
    && match authorize_add_version(attempt: gunbc.auth.secret_rotation.AttemptAddIssued { intent_id: "t" as std.types.NonEmptyStr }) {
         AddVersionRefused { cause: _ } => true
         AddVersionAuthorized { intent_id: _ } => false
       }
}

// An issued-but-unconfirmed add is resolved by OBSERVING the store.
test fn an_issued_attempt_that_landed_is_resolved_from_the_inventory() -> Bool {
  match resolve_issued_attempt(
    inventory: complete_inventory(versions: [version_row(identity: v3(), state: SmEnabled)]),
    expected: v3(),
  ) {
    IssuedAttemptDidAdd { added: a } => identity_is(identity: a, other: v3())
    _ => false
  }
}

test fn an_issued_attempt_that_did_not_land_is_resolved_as_did_not_add() -> Bool {
  match resolve_issued_attempt(
    inventory: complete_inventory(versions: [version_row(identity: v2(), state: SmEnabled)]),
    expected: v3(),
  ) {
    IssuedAttemptDidNotAdd => true
    _ => false
  }
}

// A truncated inventory cannot settle whether the add landed. Answering
// "did not add" here would authorize a SECOND AddVersion -- the sprawl.
test fn an_issued_attempt_against_a_truncated_inventory_refuses() -> Bool {
  match resolve_issued_attempt(inventory: gunbc.auth.secret_rotation.InventoryTruncated { seen: 2 }, expected: v3()) {
    IssuedAttemptUnresolvable { cause: _ } => true
    _ => false
  }
}

// ---------------------------------------------------------------------------
// Read-back: refusals carry their cause, never a happy-path value
// ---------------------------------------------------------------------------

test fn read_back_confirms_a_matching_identity_and_payload() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v3_name, data_b64: "aGk="),
    expected: v3(),
    payload: PayloadMatchesWritten,
  ) {
    ReadBackConfirmed { added: a, payload: p } =>
      identity_is(identity: a, other: v3())
        && match p { PayloadMatchesWritten => true _ => false }
    ReadBackRefused { cause: _ } => false
  }
}

// A decode refusal from the IMPORTED decoder must arrive as a refusal carrying
// its typed cause -- never as a confirmed read-back.
test fn read_back_carries_the_imported_identity_refusal() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: "not-a-resource-name", data_b64: "aGk="),
    expected: v3(),
    payload: PayloadMatchesWritten,
  ) {
    ReadBackRefused { cause: c } =>
      match c {
        ReadBackIdentityRefused { cause: ic } =>
          match ic { SmResolvedVersionIdentityMalformed => true _ => false }
        _ => false
      }
    ReadBackConfirmed { added: _, payload: _ } => false
  }
}

test fn read_back_carries_the_imported_payload_refusal() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v3_name, data_b64: ""),
    expected: v3(),
    payload: PayloadMatchesWritten,
  ) {
    ReadBackRefused { cause: c } =>
      match c {
        ReadBackPayloadRefused { cause: pc } =>
          match pc { SmAccessVersionPayloadEmpty => true _ => false }
        _ => false
      }
    ReadBackConfirmed { added: _, payload: _ } => false
  }
}

// RED CONTROL, and this one IS the incident: the forbidden reading answers
// "usable" on the refusal arm, which is what a path does when it binds a typed
// refusal to `_` and returns a fabricated credential. verify_read_back differs
// on exactly that input.
test fn the_fabricated_secret_sketch_accepts_a_refusal_the_kernel_rejects() -> Bool {
  let refused = decode_sm_access_version_wire_response(name: "not-a-resource-name", data_b64: "")
  decode_refusal_is_usable_sketch(decoded: refused)
    && match verify_read_back(decoded: refused, expected: v3(), payload: PayloadMatchesWritten) {
         ReadBackRefused { cause: _ } => true
         ReadBackConfirmed { added: _, payload: _ } => false
       }
}

// Positive control: the two agree on a genuinely good read, so the divergence
// above is about the refusal arm and not blanket strictness.
test fn the_fabricated_secret_sketch_and_the_kernel_agree_on_a_good_read() -> Bool {
  let ok = decode_sm_access_version_wire_response(name: v3_name, data_b64: "aGk=")
  decode_refusal_is_usable_sketch(decoded: ok)
    && match verify_read_back(decoded: ok, expected: v3(), payload: PayloadMatchesWritten) {
         ReadBackConfirmed { added: _, payload: _ } => true
         ReadBackRefused { cause: _ } => false
       }
}

// A well-formed read of the WRONG version is a mismatch, not a confirmation.
test fn read_back_refuses_a_well_formed_identity_that_is_not_the_added_one() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v2_name, data_b64: "aGk="),
    expected: v3(),
    payload: PayloadMatchesWritten,
  ) {
    ReadBackRefused { cause: c } =>
      match c {
        ReadBackIdentityMismatch { observed: o, expected: e } => o == v2_name && e == v3_name
        _ => false
      }
    ReadBackConfirmed { added: _, payload: _ } => false
  }
}

test fn read_back_refuses_a_payload_that_differs_from_what_was_written() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v3_name, data_b64: "aGk="),
    expected: v3(),
    payload: PayloadDiffersFromWritten,
  ) {
    ReadBackRefused { cause: c } => match c { ReadBackPayloadMismatch => true _ => false }
    ReadBackConfirmed { added: _, payload: _ } => false
  }
}

// Unverified is NOT a mismatch: nobody looked, which is a different situation
// from the store holding something else.
test fn read_back_refuses_an_unverified_payload_distinctly_from_a_mismatch() -> Bool {
  match verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v3_name, data_b64: "aGk="),
    expected: v3(),
    payload: gunbc.auth.secret_rotation.PayloadIdentityUnverified { cause: "probe absent" as std.types.NonEmptyStr },
  ) {
    ReadBackRefused { cause: c } =>
      match c { ReadBackPayloadUnverified { cause: _ } => true _ => false }
    ReadBackConfirmed { added: _, payload: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Consumer proof
// ---------------------------------------------------------------------------


// Positive control 1: the SAME success-only evidence proves once the consumer
// pins the added version exactly.
test fn exact_pinned_success_only_is_proven() -> Bool {
  match prove_consumer_on_version(
    consumer: exact_consumer(name: "c", version: "3" as std.types.NonEmptyStr),
    evidence: gunbc.auth.secret_rotation.ConsumerReportedSuccessOnly { consumer: "c" as gunbc.auth.secret_rotation.ConsumerId },
    secret: test_secret(),
    added: v3(),
  ) {
    ConsumerProven { consumer: _, on_version: v } => identity_is(identity: v, other: v3())
    ConsumerProofRefused { cause: _ } => false
  }
}

// Positive control 2: an ALIAS-pinned consumer that reports the version it
// resolved IS proven, so the rule is about evidence and not about pin shape.
test fn alias_pinned_consumer_that_reports_its_version_is_proven() -> Bool {
  match prove_consumer_on_version(
    consumer: alias_consumer(name: "c"),
    evidence: gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "c" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() },
    secret: test_secret(),
    added: v3(),
  ) {
    ConsumerProven { consumer: _, on_version: v } => identity_is(identity: v, other: v3())
    ConsumerProofRefused { cause: _ } => false
  }
}

test fn a_consumer_resolved_to_the_prior_version_is_refuted_by_name() -> Bool {
  match prove_consumer_on_version(
    consumer: alias_consumer(name: "c"),
    evidence: gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "c" as gunbc.auth.secret_rotation.ConsumerId, resolved: v2() },
    secret: test_secret(),
    added: v3(),
  ) {
    ConsumerProofRefused { cause: c } =>
      match c {
        ConsumerOnOtherVersion { consumer: _, observed: o, expected: e } =>
          o == v2_name && e == v3_name
        _ => false
      }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}

test fn an_unreachable_consumer_is_an_observation_failure_not_a_refutation() -> Bool {
  match prove_consumer_on_version(
    consumer: exact_consumer(name: "c", version: "3" as std.types.NonEmptyStr),
    evidence: gunbc.auth.secret_rotation.ConsumerUnreachable { consumer: "c" as gunbc.auth.secret_rotation.ConsumerId, cause: "timeout" as std.types.NonEmptyStr },
    secret: test_secret(),
    added: v3(),
  ) {
    ConsumerProofRefused { cause: c } =>
      match c {
        ConsumerObservationFailed { consumer: _, cause: why } => (why as String) == "timeout"
        _ => false
      }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}


// ---------------------------------------------------------------------------
// Census: identity join, not count
// ---------------------------------------------------------------------------

test fn duplicate_evidence_does_not_cover_a_silent_consumer() -> Bool {
  let req = gunbc.auth.secret_rotation.ConsumerVerificationRequirement {
    consumers: [alias_consumer(name: "a"), alias_consumer(name: "b")],
  }
  let evidence = [
    gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() },
    gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() },
  ]
  let missing = census_missing_consumers(requirement: req, evidence: evidence)
  (evidence |> count) == (req.consumers |> count)
    && !gunbc.auth.secret_rotation.census_is_complete(requirement: req, evidence: evidence)
    && (missing |> count) == 1
    && first_consumer_is(consumers: missing, expected: "b")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

test fn a_continuation_token_makes_the_inventory_truncated() -> Bool {
  match inventory_from_list_response(
    response: extdeps.cloud.gcp.secret_manager.ListSecretVersionsResponse {
      versions: [version_row(identity: v3(), state: SmEnabled)],
      next_page_token: Present { value: "tok" },
      total_size: none,
    },
  ) {
    InventoryTruncated { seen: seen } => seen == 1
    InventoryComplete { versions: _ } => false
  }
}

test fn an_empty_token_makes_the_inventory_complete() -> Bool {
  match inventory_from_list_response(
    response: extdeps.cloud.gcp.secret_manager.ListSecretVersionsResponse {
      versions: [version_row(identity: v3(), state: SmEnabled)],
      next_page_token: Present { value: "" },
      total_size: none,
    },
  ) {
    InventoryComplete { versions: vs } => (vs |> count) == 1
    InventoryTruncated { seen: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Retirement authorization
// ---------------------------------------------------------------------------

fn proven_evidence() -> List<gunbc.auth.secret_rotation.ConsumerVersionEvidence> {
  [gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() }]
}

fn proven_intent(policy: gunbc.auth.secret_rotation.RetirementPolicy) -> gunbc.auth.secret_rotation.SecretRotationIntent {
  intent_with(consumers: [alias_consumer(name: "a")], policy: policy)
}

test fn retirement_targets_every_enabled_version_except_the_added_one() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: proven_evidence(),
    inventory: complete_inventory(versions: [
      version_row(identity: v1(), state: SmEnabled),
      version_row(identity: v2(), state: SmEnabled),
      version_row(identity: v3(), state: SmEnabled),
    ]),
  ) {
    RetirementAuthorized { targets: t, destroy_permitted: d } =>
      (t |> count) == 2 && !d && t.first().etag == concat("etag-", v1_name)
    RetirementRefused { cause: _ } => false
  }
}

// A failed consumer check leaves the prior version ENABLED and yields NO
// targets at all -- the refusal cannot be mistaken for an empty target list.
test fn retirement_refuses_when_a_consumer_is_not_proven() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: [gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v2() }],
    inventory: post_disable_inventory(),
  ) {
    RetirementRefused { cause: c } =>
      match c {
        ConsumerNotProvenOnAddedVersion { cause: p } =>
          match p { ConsumerOnOtherVersion { consumer: _, observed: _, expected: _ } => true _ => false }
        _ => false
      }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

test fn retirement_refuses_an_incomplete_census_by_name() -> Bool {
  match authorize_retirement(
    intent: intent_with(
      consumers: [alias_consumer(name: "a"), alias_consumer(name: "b")],
      policy: DisableOnly,
    ),
    added: v3(),
    evidence: proven_evidence(),
    inventory: post_disable_inventory(),
  ) {
    RetirementRefused { cause: c } =>
      match c {
        ConsumerCensusIncomplete { missing: m } =>
          (m |> count) == 1 && first_consumer_is(consumers: m, expected: "b")
        _ => false
      }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

test fn retirement_refuses_when_the_added_version_is_not_enabled() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: proven_evidence(),
    inventory: complete_inventory(versions: [version_row(identity: v2(), state: SmEnabled)]),
  ) {
    RetirementRefused { cause: c } =>
      match c { AddedVersionNotEnabled { added: a } => a == v3_name _ => false }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

test fn retirement_refuses_a_prior_version_whose_etag_was_not_observed() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: proven_evidence(),
    inventory: complete_inventory(versions: [
      version_row_without_etag(identity: v2(), state: SmEnabled),
      version_row(identity: v3(), state: SmEnabled),
    ]),
  ) {
    RetirementRefused { cause: c } =>
      match c { VersionEtagUnobserved { version: v } => v == v2_name _ => false }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

// Positive control for the etag wall: same shape advances once the etag is there.
test fn retirement_advances_when_the_prior_version_carries_an_etag() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: proven_evidence(),
    inventory: complete_inventory(versions: [
      version_row(identity: v2(), state: SmEnabled),
      version_row(identity: v3(), state: SmEnabled),
    ]),
  ) {
    RetirementAuthorized { targets: t, destroy_permitted: _ } =>
      (t |> count) == 1 && t.first().etag == concat("etag-", v2_name)
    RetirementRefused { cause: _ } => false
  }
}

test fn retirement_refuses_a_truncated_inventory() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: proven_evidence(),
    inventory: gunbc.auth.secret_rotation.InventoryTruncated { seen: 4 },
  ) {
    RetirementRefused { cause: c } =>
      match c { InventoryIncomplete { seen: s } => s == 4 _ => false }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

// ---------------------------------------------------------------------------
// The destroy gate
// ---------------------------------------------------------------------------

// A DisableOnly intent cannot reach destroy by ANY path.
test fn destroy_is_unreachable_under_a_disable_only_policy() -> Bool {
  match authorize_destroy(
    intent: proven_intent(policy: DisableOnly),
    evidence: proven_evidence(),
    inventory: post_disable_inventory(),
    added: v3(),
    disabled: [v2_target()],
  ) {
    DestroyRefused { cause: c } => match c { DestroyNotPermittedByPolicy => true _ => false }
    DestroyAuthorized { targets: _ } => false
  }
}

// THE central refusal: a census that reached nobody produces no complaints.
test fn destroy_refuses_when_the_census_reached_no_one() -> Bool {
  match authorize_destroy(
    intent: proven_intent(policy: DisableThenDestroy),
    evidence: [],
    inventory: post_disable_inventory(),
    added: v3(),
    disabled: [v2_target()],
  ) {
    DestroyRefused { cause: c } =>
      match c { CensusReachedNoOne { roster_size: n } => n == 1 _ => false }
    DestroyAuthorized { targets: _ } => false
  }
}

// RED CONTROL: on that exact input the forbidden fold says "destroy".
test fn the_silence_fold_would_have_destroyed_what_the_gate_refuses() -> Bool {
  let intent = proven_intent(policy: DisableThenDestroy)
  destroy_on_silence_sketch(intent: intent, evidence: [], added: v3())
    && match authorize_destroy(
         intent: intent,
         evidence: [],
         inventory: post_disable_inventory(),
         added: v3(),
         disabled: [v2_target()],
       ) {
         DestroyRefused { cause: _ } => true
         DestroyAuthorized { targets: _ } => false
       }
}

// ...and they AGREE once the census reached someone, so the divergence is
// about ignorance and not about the gate refusing everything.
test fn the_silence_fold_and_the_gate_agree_when_the_census_reached_someone() -> Bool {
  let intent = proven_intent(policy: DisableThenDestroy)
  destroy_on_silence_sketch(intent: intent, evidence: proven_evidence(), added: v3())
    && match authorize_destroy(
         intent: intent,
         evidence: proven_evidence(),
         inventory: post_disable_inventory(),
         added: v3(),
         disabled: [v2_target()],
       ) {
         DestroyAuthorized { targets: t } => (t |> count) == 1
         DestroyRefused { cause: _ } => false
       }
}

test fn destroy_refuses_an_empty_roster_as_reaching_no_one() -> Bool {
  match authorize_destroy(
    intent: intent_with(consumers: [], policy: DisableThenDestroy),
    evidence: [],
    inventory: post_disable_inventory(),
    added: v3(),
    disabled: [v2_target()],
  ) {
    DestroyRefused { cause: c } =>
      match c { CensusReachedNoOne { roster_size: n } => n == 0 _ => false }
    DestroyAuthorized { targets: _ } => false
  }
}

// Something re-enabling a disabled version is a consumer signalling need.
test fn destroy_refuses_when_a_disabled_version_came_back_enabled() -> Bool {
  match authorize_destroy(
    intent: proven_intent(policy: DisableThenDestroy),
    evidence: proven_evidence(),
    inventory: complete_inventory(versions: [
      version_row(identity: v2(), state: SmEnabled),
      version_row(identity: v3(), state: SmEnabled),
    ]),
    added: v3(),
    disabled: [v2_target()],
  ) {
    DestroyRefused { cause: c } =>
      match c { PriorVersionReEnabled { version: v } => v == v2_name _ => false }
    DestroyAuthorized { targets: _ } => false
  }
}

test fn destroy_refuses_a_truncated_inventory() -> Bool {
  match authorize_destroy(
    intent: proven_intent(policy: DisableThenDestroy),
    evidence: proven_evidence(),
    inventory: gunbc.auth.secret_rotation.InventoryTruncated { seen: 2 },
    added: v3(),
    disabled: [v2_target()],
  ) {
    DestroyRefused { cause: c } =>
      match c { InventoryWasTruncated { seen: s } => s == 2 _ => false }
    DestroyAuthorized { targets: _ } => false
  }
}

// ---------------------------------------------------------------------------
// Standings stay apart
// ---------------------------------------------------------------------------

test fn a_disabled_prior_version_is_disabled_not_destroyed() -> Bool {
  match credential_standing_for_effect(
    effect: applied_disable(),
  ) {
    PriorCredentialDisabled => true
    _ => false
  }
}

test fn a_destroyed_prior_version_is_destroyed_not_merely_disabled() -> Bool {
  match credential_standing_for_effect(effect: applied_destroy()) {
    PriorCredentialDestroyed => true
    _ => false
  }
}

// Retirement not attempted is KNOWN-still-live, not unknown: reporting it as
// unknown would understate what the rotation actually established.
test fn retirement_not_attempted_leaves_the_prior_credential_known_live() -> Bool {
  match credential_standing_for_effect(
    effect: gunbc.auth.secret_rotation.RetirementNotAttempted { cause: "consumer unproven" as std.types.NonEmptyStr },
  ) {
    PriorCredentialStillLive => true
    _ => false
  }
}

// ---------------------------------------------------------------------------
// The receipt
// ---------------------------------------------------------------------------

fn confirmed_read_back() -> gunbc.auth.secret_rotation.ReadBackOutcome {
  verify_read_back(
    decoded: decode_sm_access_version_wire_response(name: v3_name, data_b64: "aGk="),
    expected: v3(),
    payload: PayloadMatchesWritten,
  )
}

test fn a_receipt_records_identities_verdicts_and_both_standings() -> Bool {
  match emit_rotation_receipt(
    intent: proven_intent(policy: DisableOnly),
    read_back: confirmed_read_back(),
    proofs: [gunbc.auth.secret_rotation.ConsumerProven { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, on_version: v3() }],
    effect: applied_disable(),
    branch: BranchNotCleaned,
  ) {
    Rotated { receipt: r } =>
      identity_is(identity: r.added_version, other: v3())
        && identity_is(identity: r.prior_version, other: v2())
        && (r.disabled_versions |> count) == 1
        && (r.destroyed_versions |> count) == 0
        && match r.payload_identity { PayloadMatchesWritten => true _ => false }
        && match r.credential_standing { PriorCredentialDisabled => true _ => false }
        && match r.branch_standing { BranchNotCleaned => true _ => false }
    _ => false
  }
}

// The two standings are independent: a cleaned branch does not make the
// credential revoked, and this receipt carries both facts unmixed.
test fn a_cleaned_branch_does_not_imply_a_revoked_credential() -> Bool {
  match emit_rotation_receipt(
    intent: proven_intent(policy: DisableOnly),
    read_back: confirmed_read_back(),
    proofs: [],
    effect: gunbc.auth.secret_rotation.RetirementNotAttempted { cause: "consumer unproven" as std.types.NonEmptyStr },
    branch: BranchCleaned,
  ) {
    Rotated { receipt: r } =>
      match r.branch_standing { BranchCleaned => true _ => false }
        && match r.credential_standing { PriorCredentialStillLive => true _ => false }
    _ => false
  }
}

// A refused read-back yields NO receipt: there is no path on which a rotation
// reports success from an observation that failed.
test fn a_refused_read_back_produces_no_receipt() -> Bool {
  let outcome = emit_rotation_receipt(
    intent: proven_intent(policy: DisableOnly),
    read_back: verify_read_back(
      decoded: decode_sm_access_version_wire_response(name: "not-a-resource-name", data_b64: "aGk="),
      expected: v3(),
      payload: PayloadMatchesWritten,
    ),
    proofs: [],
    effect: gunbc.auth.secret_rotation.RetirementNotAttempted { cause: "read-back failed" as std.types.NonEmptyStr },
    branch: BranchNotCleaned,
  )
  !rotation_is_rotated(outcome: outcome)
    && match outcome {
         RotationRefused { cause: c } =>
           match c { ReadBackFailed { cause: _ } => true _ => false }
         _ => false
       }
}

// ---------------------------------------------------------------------------
// Evidence selection classifies: missing / unique / ambiguous, never first-wins
// ---------------------------------------------------------------------------

// TWO reports for one consumer, disagreeing about where it is. First-wins would
// answer whichever the list ordered first, turning a contradiction into a
// verdict. Ambiguity is its own refusal.
test fn two_disagreeing_reports_for_one_consumer_are_ambiguous_not_first_wins() -> Bool {
  let evidence = [
    gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() },
    gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v2() },
  ]
  match select_consumer_evidence(evidence: evidence, id: "a" as gunbc.auth.secret_rotation.ConsumerId) {
    EvidenceAmbiguous { consumer: c, report_count: n } => (c as String) == "a" && n == 2
    _ => false
  }
}

test fn ambiguous_evidence_refuses_the_proof_by_its_own_cause() -> Bool {
  match authorize_retirement(
    intent: proven_intent(policy: DisableOnly),
    added: v3(),
    evidence: [
      gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v3() },
      gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId, resolved: v2() },
    ],
    inventory: post_disable_inventory(),
  ) {
    RetirementRefused { cause: c } =>
      match c {
        ConsumerNotProvenOnAddedVersion { cause: p } =>
          match p { ConsumerEvidenceAmbiguous { consumer: _, report_count: n } => n == 2 _ => false }
        _ => false
      }
    RetirementAuthorized { targets: _, destroy_permitted: _ } => false
  }
}

test fn a_single_report_selects_uniquely() -> Bool {
  match select_consumer_evidence(evidence: proven_evidence(), id: "a" as gunbc.auth.secret_rotation.ConsumerId) {
    EvidenceUnique { evidence: _ } => true
    _ => false
  }
}

test fn no_report_selects_as_missing() -> Bool {
  match select_consumer_evidence(evidence: [], id: "a" as gunbc.auth.secret_rotation.ConsumerId) {
    EvidenceMissing { consumer: c } => (c as String) == "a"
    _ => false
  }
}

// ---------------------------------------------------------------------------
// A retirement receipt is admitted only from a CONFIRMING observed state
// ---------------------------------------------------------------------------

test fn a_disable_receipt_is_admitted_only_when_the_version_reads_disabled() -> Bool {
  match admit_disable_receipt(version: v2(), observed_state: SmDisabled) {
    Present { value: r } => identity_is(identity: r.version, other: v2())
    Absent => false
  }
}

// "We issued the call" is not a receipt: a version still reading enabled
// refuses, so a retirement cannot report success from having asked.
test fn a_disable_receipt_refuses_when_the_version_still_reads_enabled() -> Bool {
  match admit_disable_receipt(version: v2(), observed_state: SmEnabled) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn a_destroy_receipt_refuses_a_merely_disabled_version() -> Bool {
  match admit_destroy_receipt(version: v2(), observed_state: SmDisabled) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn a_destroy_receipt_is_admitted_when_the_version_reads_destroyed() -> Bool {
  match admit_destroy_receipt(version: v2(), observed_state: SmDestroyed) {
    Present { value: r } => identity_is(identity: r.version, other: v2())
    Absent => false
  }
}

// An "applied" retirement carrying no receipt cannot claim a standing.
test fn applied_with_no_receipts_leaves_the_standing_unknown() -> Bool {
  match credential_standing_for_effect(
    effect: gunbc.auth.secret_rotation.RetirementApplied { disabled: [], destroyed: [] },
  ) {
    CredentialStandingUnknown { cause: _ } => true
    _ => false
  }
}

// ---------------------------------------------------------------------------
// The alias wall, on a synthetic consumer
// ---------------------------------------------------------------------------

// THE discriminating case: success with no version named, selected through the
// moving alias -- a green equally true before the added version existed.
test fn alias_pinned_success_only_is_refused_as_unobserved() -> Bool {
  match prove_consumer_on_version(
    consumer: alias_consumer(name: "a"),
    evidence: gunbc.auth.secret_rotation.ConsumerReportedSuccessOnly { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId },
    secret: test_secret(),
    added: v3(),
  ) {
    ConsumerProofRefused { cause: c } =>
      match c { ResolvedVersionUnobserved { consumer: who } => (who as String) == "a" _ => false }
    ConsumerProven { consumer: _, on_version: _ } => false
  }
}

// RED CONTROL for that wall.
test fn the_alias_proof_sketch_accepts_what_the_wall_refuses() -> Bool {
  let ev = gunbc.auth.secret_rotation.ConsumerReportedSuccessOnly { consumer: "a" as gunbc.auth.secret_rotation.ConsumerId }
  alias_success_is_proof_sketch(evidence: ev)
    && !proof_is_proven(
         outcome: prove_consumer_on_version(
           consumer: alias_consumer(name: "a"),
           evidence: ev,
           secret: test_secret(),
           added: v3(),
         ),
       )
}
