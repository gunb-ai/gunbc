module test.claim.publication_publisher_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data synthetic_head: std.types.CommitSha = "synthetic-head-sha"
data synthetic_ordinary_session: tools.publication_publisher.ModeledSessionId = "synthetic-ordinary-session" as tools.publication_publisher.ModeledSessionId
data synthetic_policy_version: std.types.NonEmptyStr = "policy-v1" as std.types.NonEmptyStr

fn synthetic_subject(path: std.types.FilePath, identity: String) -> gunbc.public_projection.PublicProjectionSubject {
  gunbc.public_projection.PublicProjectionSubject {
    subject_identity: std.content_hash.content_hash_of_value(value: identity as std.types.NonEmptyStr),
    content_identity: std.content_hash.content_hash_of_value(value: identity as std.types.NonEmptyStr),
    path: path,
  }
}

fn public_docs_policy() -> gunbc.publication_policy.PublicationPolicy {
  gunbc.publication_policy.PublicationPolicy {
    version: synthetic_policy_version,
    default_disposition: gunbc.publication_policy.publication_policy_default_disposition,
    rules: [gunbc.publication_policy.SubtreePublishRule {
      prefix: "docs/plans" as std.types.FilePath,
      disposition: gunbc.publication_policy.PublishPublic,
    }],
  }
}

fn admitted_public_docs_policy() -> AdmittedPublicationPolicy {
  match gunbc.publication_policy.admit_publication_policy(policy: public_docs_policy()) {
    gunbc.publication_policy.PublicationPolicyAccepted { admitted: admitted } => admitted
    gunbc.publication_policy.PublicationPolicyRefused { cause: _ } =>
      AdmittedPublicationPolicy { policy: public_docs_policy() }
  }
}

fn synthetic_decision_receipt(subject: gunbc.public_projection.PublicProjectionSubject) -> gunbc.publication_decision.PublicationDecisionReceipt {
  gunbc.publication_decision.PublicationDecisionReceipt {
    subject_identity: subject.subject_identity,
    content_identity: subject.content_identity,
    audience: gunbc.publication_decision.UniversalPublicationAudience,
    policy_version: synthetic_policy_version,
    authority: tools.publication_publisher.sole_publication_authority_id,
  }
}

fn synthetic_push() -> extdeps.git.hooks.PrePushStdinRow {
  extdeps.git.hooks.PrePushStdinRow {
    local_ref: "refs/heads/session/synthetic-ordinary-session",
    local_sha: synthetic_head,
    remote_ref: "refs/heads/session/synthetic-ordinary-session",
    remote_sha: extdeps.git.hooks.zero_sha,
  }
}

test fn ordinary_session_lacks_public_write_authority_holds() -> Bool {
  tools.publication_publisher.ordinary_session_lacks_public_write_authority(session: synthetic_ordinary_session)
    && match tools.publication_publisher.session_publication_posture(session: synthetic_ordinary_session) {
      tools.publication_publisher.OrdinarySession { session: session } => session == synthetic_ordinary_session
      tools.publication_publisher.SoleModeledPublisher { session: _ } => false
    }
}

test fn sole_publisher_posture_is_unique() -> Bool {
  match tools.publication_publisher.session_publication_posture(session: tools.publication_publisher.sole_modeled_publisher_session) {
    tools.publication_publisher.SoleModeledPublisher { session: session } => session == tools.publication_publisher.sole_modeled_publisher_session
    tools.publication_publisher.OrdinarySession { session: _ } => false
  }
}

test fn git_push_shape_is_modeled_not_raw_argv() -> Bool {
  let update = extdeps.git.publication_transport.GitRefUpdateSpec {
    local_ref: "refs/heads/session/example" as std.types.GitRef,
    remote_ref: "refs/heads/session/example" as std.types.GitRef,
  }
  let request = extdeps.git.publication_transport.GitPushRequest {
    remote: "origin" as std.types.NonEmptyStr,
    ref_updates: [update],
  }
  request.remote == ("origin" as std.types.NonEmptyStr) && request.ref_updates == [update]
}

test fn publication_policy_refuses_unknown_top_level_root() -> Bool {
  match gunbc.publication_policy.admit_publication_policy(policy: gunbc.publication_policy.PublicationPolicy {
    version: synthetic_policy_version,
    default_disposition: gunbc.publication_policy.publication_policy_default_disposition,
    rules: [gunbc.publication_policy.SubtreePublishRule {
      prefix: "private-overlay/secret" as std.types.FilePath,
      disposition: gunbc.publication_policy.PublishPublic,
    }],
  }) {
    gunbc.publication_policy.PublicationPolicyAccepted { admitted: _ } => false
    gunbc.publication_policy.PublicationPolicyRefused { cause: cause } =>
      match cause {
        gunbc.publication_policy.UnknownTopLevelRoot { prefix: _ } => true
        gunbc.publication_policy.ConflictingSubtreeRule { prefix: _ } => false
      }
  }
}

test fn publication_policy_refuses_conflicting_prefix_rules() -> Bool {
  match gunbc.publication_policy.admit_publication_policy(policy: gunbc.publication_policy.PublicationPolicy {
    version: synthetic_policy_version,
    default_disposition: gunbc.publication_policy.WithholdPrivate,
    rules: [
      gunbc.publication_policy.SubtreePublishRule { prefix: "docs/plans" as std.types.FilePath, disposition: gunbc.publication_policy.PublishPublic },
      gunbc.publication_policy.SubtreePublishRule { prefix: "docs/plans" as std.types.FilePath, disposition: gunbc.publication_policy.WithholdPrivate },
    ],
  }) {
    gunbc.publication_policy.PublicationPolicyAccepted { admitted: _ } => false
    gunbc.publication_policy.PublicationPolicyRefused { cause: cause } =>
      match cause {
        gunbc.publication_policy.ConflictingSubtreeRule { prefix: _ } => true
        gunbc.publication_policy.UnknownTopLevelRoot { prefix: _ } => false
      }
  }
}

test fn publication_policy_most_specific_rule_wins() -> Bool {
  let policy = gunbc.publication_policy.PublicationPolicy {
    version: synthetic_policy_version,
    default_disposition: gunbc.publication_policy.WithholdPrivate,
    rules: [
      gunbc.publication_policy.SubtreePublishRule { prefix: "docs" as std.types.FilePath, disposition: gunbc.publication_policy.WithholdPrivate },
      gunbc.publication_policy.SubtreePublishRule { prefix: "docs/plans" as std.types.FilePath, disposition: gunbc.publication_policy.PublishPublic },
    ],
  }
  match gunbc.publication_policy.admit_publication_policy(policy: policy) {
    gunbc.publication_policy.PublicationPolicyAccepted { admitted: accepted } =>
      gunbc.publication_policy.resolve_disposition_for_path(policy: accepted.policy, path: "docs/plans/sole-modeled-publisher-design.md" as std.types.FilePath) == gunbc.publication_policy.PublishPublic
        && gunbc.publication_policy.resolve_disposition_for_path(policy: accepted.policy, path: "docs/other.md" as std.types.FilePath) == gunbc.publication_policy.WithholdPrivate
    gunbc.publication_policy.PublicationPolicyRefused { cause: _ } => false
  }
}

test fn public_projection_plan_derives_from_policy_not_pathname_census() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/sole-modeled-publisher-design.md" as std.types.FilePath,
    identity: "subject-docs-plan",
  )
  let plan = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  gunbc.public_projection.public_projection_includes_subject(plan: plan, subject_identity: subject.subject_identity)
    && count(plan.omitted_subjects) == 0
}

test fn change_local_admission_classifies_newly_public_delta() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/new.md" as std.types.FilePath,
    identity: "subject-new-doc",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match gunbc.publication_admission_delta.admit_change_local_projection(request: gunbc.publication_admission_delta.ChangeLocalAdmissionRequest {
    current: Absent,
    candidate: candidate,
  }) {
    gunbc.publication_admission_delta.ChangeLocalAdmitted { delta: delta, candidate: _ } =>
      count(filter(delta, item => match item {
        gunbc.publication_admission_delta.NewlyPublic { subject: admitted } => admitted.subject_identity == subject.subject_identity
        _ => false
      })) > 0
    gunbc.publication_admission_delta.ChangeLocalRefused { cause: _ } => false
  }
}

test fn change_local_admission_refuses_tampered_projection_digest() -> Bool {
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [synthetic_subject(
      path: "docs/plans/tampered.md" as std.types.FilePath,
      identity: "subject-tampered",
    )],
  )
  let tampered = gunbc.public_projection.PublicProjectionPlan {
    source_revision: candidate.source_revision,
    policy_version: candidate.policy_version,
    included_subjects: candidate.included_subjects,
    omitted_subjects: candidate.omitted_subjects,
    projection_digest: std.content_hash.content_hash_of_value(value: "tampered-digest" as std.types.NonEmptyStr),
  }
  match gunbc.publication_admission_delta.admit_change_local_projection(request: gunbc.publication_admission_delta.ChangeLocalAdmissionRequest {
    current: Absent,
    candidate: tampered,
  }) {
    gunbc.publication_admission_delta.ChangeLocalRefused { cause: cause } =>
      match cause {
        gunbc.publication_admission_delta.CandidateDigestInconsistent { expected: _, observed: _ } => true
        WholeProjectionAuditRequired { detail: _ } => false
      }
    gunbc.publication_admission_delta.ChangeLocalAdmitted { delta: _, candidate: _ } => false
  }
}

test fn change_local_admission_classifies_deletion_as_newly_withheld() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/deleted.md" as std.types.FilePath,
    identity: "subject-deleted",
  )
  let current = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [],
  )
  match gunbc.publication_admission_delta.admit_change_local_projection(request: gunbc.publication_admission_delta.ChangeLocalAdmissionRequest {
    current: Present { value: current },
    candidate: candidate,
  }) {
    gunbc.publication_admission_delta.ChangeLocalAdmitted { delta: delta, candidate: _ } =>
      count(filter(delta, item => match item {
        gunbc.publication_admission_delta.NewlyWithheld { subject: withheld } => withheld.subject_identity == subject.subject_identity
        _ => false
      })) > 0
    gunbc.publication_admission_delta.ChangeLocalRefused { cause: _ } => false
  }
}

test fn publication_decision_authorizes_matching_policy_authority_and_audience() -> Bool {
  let subject = synthetic_subject(
    path: "docs/plans/receipt-auth.md" as std.types.FilePath,
    identity: "subject-receipt-auth",
  )
  gunbc.publication_decision.publication_decision_authorizes_newly_public(
    receipt: synthetic_decision_receipt(subject: subject),
    subject: subject,
    policy_version: synthetic_policy_version,
    authority: tools.publication_publisher.sole_publication_authority_id,
  )
}

test fn sole_publisher_refuses_stale_policy_version_receipt() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/stale-receipt.md" as std.types.FilePath,
    identity: "subject-stale-receipt",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  let stale_receipt = gunbc.publication_decision.PublicationDecisionReceipt {
    subject_identity: subject.subject_identity,
    content_identity: subject.content_identity,
    audience: gunbc.publication_decision.UniversalPublicationAudience,
    policy_version: "stale-policy" as std.types.NonEmptyStr,
    authority: tools.publication_publisher.sole_publication_authority_id,
  }
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [stale_receipt],
    pushed_refs: [synthetic_push()],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.DecisionReceiptNotAuthorizing { session: _, subject_identity: id, detail: _ } =>
          id == (std.content_hash.serialize_content_hash(hash: subject.subject_identity) as String)
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_refuses_wrong_authority_receipt() -> Bool {
  let subject = synthetic_subject(
    path: "docs/plans/wrong-authority.md" as std.types.FilePath,
    identity: "subject-wrong-authority",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  let wrong_authority_receipt = gunbc.publication_decision.PublicationDecisionReceipt {
    subject_identity: subject.subject_identity,
    content_identity: subject.content_identity,
    audience: gunbc.publication_decision.UniversalPublicationAudience,
    policy_version: synthetic_policy_version,
    authority: "not-the-publisher" as gunbc.publication_decision.PublicationAuthorityId,
  }
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [wrong_authority_receipt],
    pushed_refs: [synthetic_push()],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.DecisionReceiptNotAuthorizing { session: _, subject_identity: _, detail: _ } => true
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

