  let narrow_receipt = PublicationDecisionReceipt {
    subject_identity: subject.subject_identity,
    content_identity: subject.content_identity,
    audience: EnumeratedPublicationAudience { label: "private-team" },
    policy_version: synthetic_policy_version,
    authority: sole_publication_authority_id,
  }
  match admit_public_write(
    session: sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [narrow_receipt],
    pushed_refs: [synthetic_push()],
  ) {
    PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        DecisionReceiptNotAuthorizing { session: _, subject_identity: _, detail: _ } => true
        _ => false
      }
    PublicWriteAdmitted { authority: _ } => false
  }
}

test fn publication_decision_binds_content_identity_not_pathname() -> Bool {
  let receipt = PublicationDecisionReceipt {
    subject_identity: content_hash_of_value(value: "subject-a" as NonEmptyStr),
    content_identity: content_hash_of_value(value: "content-v1" as NonEmptyStr),
    audience: UniversalPublicationAudience,
    policy_version: synthetic_policy_version,
    authority: sole_publication_authority_id,
  }
  publication_decision_requires_refresh(
    receipt: receipt,
    subject_identity: content_hash_of_value(value: "subject-a" as NonEmptyStr),
    content_identity: content_hash_of_value(value: "content-v2" as NonEmptyStr),
  )
}

test fn ordinary_session_reds_before_projection_check() -> Bool {
  let candidate = derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [synthetic_subject(
      path: "docs/plans/x.md" as FilePath,
      identity: "subject-x",
    )],
  )
  match admit_public_write(
    session: synthetic_ordinary_session,
    current: Absent,
    candidate: candidate,
    decisions: [],
    pushed_refs: [synthetic_push()],
  ) {
    PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        NotTheSolePublisher { session: _, sole_publisher: sole } => sole == sole_modeled_publisher_session
        _ => false
      }
    PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_admits_change_local_projection() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/y.md" as FilePath,
    identity: "subject-y",
  )
  let candidate = derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match admit_public_write(
    session: sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [synthetic_push()],
  ) {
    PublicWriteAdmitted { authority: authority } =>
      authority.authority_id == sole_publication_authority_id
        && authority.projection.plan.source_revision == synthetic_head
    PublicWriteRefused { session: _, cause: _ } => false
  }
}

test fn sole_publisher_refuses_newly_public_without_receipt() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/no-receipt.md" as FilePath,
    identity: "subject-no-receipt",
  )
  let candidate = derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match admit_public_write(
    session: sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [],
    pushed_refs: [synthetic_push()],
  ) {
    PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        DecisionReceiptMissing { session: _, subject_identity: id } =>
          id == (serialize_content_hash(hash: subject.subject_identity) as String)
        _ => false
      }
    PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_refuses_push_head_mismatch() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/mismatch.md" as FilePath,
    identity: "subject-mismatch",
  )
  let candidate = derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  let bad_push = PrePushStdinRow {
    local_ref: "refs/heads/session/synthetic-ordinary-session",
    local_sha: "wrong-head" as CommitSha,
    remote_ref: "refs/heads/session/synthetic-ordinary-session",
    remote_sha: zero_sha,
  }
  match admit_public_write(
    session: sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [bad_push],
  ) {
    PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        UnauthorizedPublicPush { session: _, local_ref: _, local_sha: _, detail: _ } => true
        _ => false
      }
    PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_refuses_empty_pushed_refs() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/empty-push.md" as FilePath,
    identity: "subject-empty-push",
  )
  let candidate = derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match admit_public_write(
    session: sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [],
  ) {
    PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        NoPushedRefsPresented { session: session } =>
          session == sole_modeled_publisher_session
        _ => false
      }
    PublicWriteAdmitted { authority: _ } => false
  }
}

test fn shadow_replay_counts_ordinary_session_refusals() -> Bool {
  let candidate = derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [synthetic_subject(
      path: "docs/plans/z.md" as FilePath,
      identity: "subject-z",
    )],
  )
  let observed = ObservedPublicPush {
    session: synthetic_ordinary_session,
    head: synthetic_head,
    push: synthetic_push(),
    candidate: candidate,
    decisions: [],
  }
  shadow_refusal_count(entries: shadow_replay_public_pushes(current: Absent, events: [observed])) == 1
    && shadow_would_refuse_ordinary_session(current: Absent, observed: observed)
}
