test fn publication_decision_binds_content_identity_not_pathname() -> Bool {
  let receipt = gunbc.publication_decision.PublicationDecisionReceipt {
    subject_identity: std.content_hash.content_hash_of_value(value: "subject-a" as std.types.NonEmptyStr),
    content_identity: std.content_hash.content_hash_of_value(value: "content-v1" as std.types.NonEmptyStr),
    audience: gunbc.publication_decision.UniversalPublicationAudience,
    policy_version: synthetic_policy_version,
    authority: tools.publication_publisher.sole_publication_authority_id,
  }
  gunbc.publication_decision.publication_decision_requires_refresh(
    receipt: receipt,
    subject_identity: std.content_hash.content_hash_of_value(value: "subject-a" as std.types.NonEmptyStr),
    content_identity: std.content_hash.content_hash_of_value(value: "content-v2" as std.types.NonEmptyStr),
  )
}

test fn ordinary_session_reds_before_projection_check() -> Bool {
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [synthetic_subject(
      path: "docs/plans/x.md" as std.types.FilePath,
      identity: "subject-x",
    )],
  )
  match tools.publication_publisher.admit_public_write(
    session: synthetic_ordinary_session,
    current: Absent,
    candidate: candidate,
    decisions: [],
    pushed_refs: [synthetic_push()],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.NotTheSolePublisher { session: _, sole_publisher: sole } => sole == tools.publication_publisher.sole_modeled_publisher_session
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_admits_change_local_projection() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/y.md" as std.types.FilePath,
    identity: "subject-y",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [synthetic_push()],
  ) {
    tools.publication_publisher.PublicWriteAdmitted { authority: authority } =>
      authority.authority_id == tools.publication_publisher.sole_publication_authority_id
        && authority.projection.plan.source_revision == synthetic_head
    tools.publication_publisher.PublicWriteRefused { session: _, cause: _ } => false
  }
}

test fn sole_publisher_refuses_newly_public_without_receipt() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/no-receipt.md" as std.types.FilePath,
    identity: "subject-no-receipt",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [],
    pushed_refs: [synthetic_push()],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.DecisionReceiptMissing { session: _, subject_identity: id } =>
          id == (std.content_hash.serialize_content_hash(hash: subject.subject_identity) as String)
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_refuses_push_head_mismatch() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/mismatch.md" as std.types.FilePath,
    identity: "subject-mismatch",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  let bad_push = extdeps.git.hooks.PrePushStdinRow {
    local_ref: "refs/heads/session/synthetic-ordinary-session",
    local_sha: "wrong-head" as std.types.CommitSha,
    remote_ref: "refs/heads/session/synthetic-ordinary-session",
    remote_sha: extdeps.git.hooks.zero_sha,
  }
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [bad_push],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.UnauthorizedPublicPush { session: _, local_ref: _, local_sha: _, detail: _ } => true
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

test fn sole_publisher_refuses_empty_pushed_refs() -> Bool {
  let admitted = admitted_public_docs_policy()
  let subject = synthetic_subject(
    path: "docs/plans/empty-push.md" as std.types.FilePath,
    identity: "subject-empty-push",
  )
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted,
    source_revision: synthetic_head,
    authored_subjects: [subject],
  )
  match tools.publication_publisher.admit_public_write(
    session: tools.publication_publisher.sole_modeled_publisher_session,
    current: Absent,
    candidate: candidate,
    decisions: [synthetic_decision_receipt(subject: subject)],
    pushed_refs: [],
  ) {
    tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
      match cause {
        tools.publication_publisher.NoPushedRefsPresented { session: session } =>
          session == tools.publication_publisher.sole_modeled_publisher_session
        _ => false
      }
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
  }
}

test fn shadow_replay_counts_ordinary_session_refusals() -> Bool {
  let candidate = gunbc.public_projection.derive_public_projection_plan(
    admitted: admitted_public_docs_policy(),
    source_revision: synthetic_head,
    authored_subjects: [synthetic_subject(
      path: "docs/plans/z.md" as std.types.FilePath,
      identity: "subject-z",
    )],
  )
  let observed = tools.publication_push_shadow.ObservedPublicPush {
    session: synthetic_ordinary_session,
    head: synthetic_head,
    push: synthetic_push(),
    candidate: candidate,
    decisions: [],
  }
  tools.publication_push_shadow.shadow_refusal_count(entries: tools.publication_push_shadow.shadow_replay_public_pushes(current: Absent, events: [observed])) == 1
    && tools.publication_push_shadow.shadow_would_refuse_ordinary_session(current: Absent, observed: observed)
}
