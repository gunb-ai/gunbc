module test.claim.computation_demand_duplication_witness

import tools.emit_determinism_transport {
  emit_corpus_x2_diff_zero_program,
  emit_determinism_replication_intent
}
import v2.lens.duplicate_computation {
  SingleRun,
  duplicate_computation_clean_holds,
  duplicate_computation_violation_count,
  shell_program_computation_demands
}
import v2.std.logic { Bool }

test fn emit_determinism_oracle_pair_is_declared_and_admissible() -> Bool {
  return duplicate_computation_clean_holds(facts: shell_program_computation_demands(
    site: "tools.emit_determinism_transport.emit_corpus_x2_diff_zero_program",
    program: emit_corpus_x2_diff_zero_program(),
    replication: emit_determinism_replication_intent
  ))
}

test fn emit_determinism_pair_without_declaration_reds() -> Bool {
  return duplicate_computation_violation_count(facts: shell_program_computation_demands(
    site: "tools.emit_determinism_transport.emit_corpus_x2_diff_zero_program",
    program: emit_corpus_x2_diff_zero_program(),
    replication: SingleRun
  )) == 1
}

data compile_clean_subject_dissolved_note: String = "The former compile-clean subject (tools.dag_compile_clean_transport.clean_tree_compile_program) dissolved when that transport went typed-argv: there is no ShellProgram to walk, and its single gunbc compile invocation is one typed WitnessBin.Run by construction. When tools.emit_determinism_transport converts, the duplicate_computation lens needs a typed-args demand projection or this ShellProgram walker dissolves with it."
