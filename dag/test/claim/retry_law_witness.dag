module test.claim.retry_law_witness

import std.types { Bool, Int, List, NonEmptyStr, String, EpochSecs }
import std.nat { Nat, Zero }
import std.measure { second, second_count }
import std.retry_law {
  RetryLaw, RetryHistoryEvent, RetryObservedClass, RealWorkFailure, RealWorkSuccess, ProbeOutcome, Cancelled,
  RetryAdmissible, RetryAdmissibleNow, RetryTerminalExhausted, RetryTerminalCancelled, RetryAlreadySucceeded,
  RetryHintUnreadable, RetryHintUnanchored, retry_admissibility, retry_no_hint, retry_hint_from_delta, retry_hint_unresolved,
}

data witness_law: RetryLaw = RetryLaw {
  initial_delay: second(count: 2),
  delay_cap: second(count: 32),
  real_work_failure_bound: 3,
}

fn ev(class: RetryObservedClass, at: EpochSecs) -> RetryHistoryEvent {
  RetryHistoryEvent { class: class, at: at }
}

test fn a_probe_success_does_not_reset_a_failing_real_work_series() -> Bool {
  let history = [
    ev(class: RealWorkFailure, at: 100),
    ev(class: ProbeOutcome { succeeded: true }, at: 110),
    ev(class: RealWorkFailure, at: 120),
  ]
  match retry_admissibility(law: witness_law, history: history, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAdmissible { earliest: e, real_work_failures: n } => (n as Int) == 2 && e == 120 + 4
    _ => false
  }
}

test fn a_resume_does_not_reset_the_whole_history_bound() -> Bool {
  let prior_session = [
    ev(class: RealWorkFailure, at: 1),
    ev(class: RealWorkFailure, at: 2),
  ]
  let after_resume = concat(prior_session, [ev(class: RealWorkFailure, at: 80)])
  (match retry_admissibility(law: witness_law, history: prior_session, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAdmissible { earliest: _, real_work_failures: n } => (n as Int) == 2
    _ => false
  }) && (match retry_admissibility(law: witness_law, history: after_resume, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryTerminalExhausted { real_work_failures: n } => (n as Int) == 3
    _ => false
  })
}

test fn a_probe_success_is_not_counted_toward_the_failure_bound() -> Bool {
  let history = [
    ev(class: RealWorkFailure, at: 1),
    ev(class: ProbeOutcome { succeeded: true }, at: 2),
    ev(class: ProbeOutcome { succeeded: true }, at: 3),
  ]
  match retry_admissibility(law: witness_law, history: history, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAdmissible { earliest: _, real_work_failures: n } => (n as Int) == 1
    _ => false
  }
}

test fn an_upstream_retry_after_is_a_lower_bound_never_a_shortening() -> Bool {
  let history = [ev(class: RealWorkFailure, at: 50)]
  let with_hint = retry_admissibility(law: witness_law, history: history, hint: retry_hint_from_delta(delay: second(count: 10)), jitter: second(count: Zero))
  let without = retry_admissibility(law: witness_law, history: history, hint: retry_no_hint(), jitter: second(count: Zero))
  let below_backoff = retry_admissibility(law: witness_law, history: history, hint: retry_hint_from_delta(delay: second(count: 1)), jitter: second(count: Zero))
  match with_hint {
    RetryAdmissible { earliest: hinted, real_work_failures: _ } =>
      match without {
        RetryAdmissible { earliest: plain, real_work_failures: _ } =>
          match below_backoff {
            RetryAdmissible { earliest: not_lowered, real_work_failures: _ } =>
              hinted == 50 + 10 && plain == 50 + 2 && hinted > plain && not_lowered == plain
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn a_real_work_success_ends_the_item_even_if_later_failures_are_appended() -> Bool {
  let history = [
    ev(class: RealWorkSuccess, at: 4),
    ev(class: RealWorkFailure, at: 5),
  ]
  match retry_admissibility(law: witness_law, history: history, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAlreadySucceeded => true
    _ => false
  }
}

test fn exhaustion_and_cancellation_are_persisted_terminals() -> Bool {
  let exhausted_hist = [
    ev(class: RealWorkFailure, at: 1),
    ev(class: RealWorkFailure, at: 2),
    ev(class: RealWorkFailure, at: 3),
  ]
  let cancelled_hist = [ev(class: Cancelled { by: "operator" as NonEmptyStr }, at: 9)]
  let succeeded = [ev(class: RealWorkSuccess, at: 4)]
  (match retry_admissibility(law: witness_law, history: exhausted_hist, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryTerminalExhausted { real_work_failures: n } => (n as Int) == 3
    _ => false
  }) && (match retry_admissibility(law: witness_law, history: cancelled_hist, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryTerminalCancelled { by: who } => (who as String) == "operator"
    _ => false
  }) && (match retry_admissibility(law: witness_law, history: succeeded, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAlreadySucceeded => true
    _ => false
  })
}

test fn no_real_work_failure_is_admissible_now_not_epoch_zero() -> Bool {
  let probes_only = [ev(class: ProbeOutcome { succeeded: true }, at: 50)]
  (match retry_admissibility(law: witness_law, history: [], hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAdmissibleNow { real_work_failures: n } => (n as Int) == 0
    _ => false
  }) && (match retry_admissibility(law: witness_law, history: probes_only, hint: retry_no_hint(), jitter: second(count: Zero)) {
    RetryAdmissibleNow { real_work_failures: n } => (n as Int) == 0
    _ => false
  })
}

test fn a_delay_hint_without_a_real_work_failure_is_unanchored() -> Bool {
  let probes_only = [ev(class: ProbeOutcome { succeeded: true }, at: 50)]
  match retry_admissibility(
    law: witness_law,
    history: probes_only,
    hint: retry_hint_from_delta(delay: second(count: 10)),
    jitter: second(count: Zero),
  ) {
    RetryHintUnanchored { delay: d } => second_count(s: d) == 10
    _ => false
  }
}

test fn an_unreadable_hint_is_not_admissible() -> Bool {
  let history = [ev(class: RealWorkFailure, at: 50)]
  match retry_admissibility(
    law: witness_law,
    history: history,
    hint: retry_hint_unresolved(cause: "Retry-After was not delta-seconds" as NonEmptyStr),
    jitter: second(count: Zero),
  ) {
    RetryHintUnreadable { cause: c } => (c as String) == "Retry-After was not delta-seconds"
    _ => false
  }
}
