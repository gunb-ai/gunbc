module test.claim.primitive_identity_join_witness_test


data primitive_identity_join_witness_note: String = "D0/D1 slice (NOT closing contract): join mechanism + five refusal variants typed, three detectors executing on census plus two scaffold detectors on planted RED inputs (primitive_d0_refusal_execution_note); subject universe derived across all five surfaces including InterpreterDispatch from gunbc.v1_interpreter_primitive_surface. D1: measurement scaffold deleted, primitive_surface_census_derived absorbs interpreter roster. Open denominator counted by primitive_d0_open_denominator_receipt_holds and primitive_d0_derived_rows_missing_identity_count."

test fn w_open_denominator_counted_receipt() -> Bool {
  std.primitive_identity.primitive_d0_open_denominator_receipt_holds()
    && std.primitive_identity.primitive_d0_derived_surface_authority_count == 5
    && std.primitive_identity.primitive_d0_parallel_roster_surface_authority_count == 2
    && std.primitive_identity.primitive_d0_open_surface_authority_count == 0
    && std.primitive_identity.primitive_d0_derived_rows_missing_identity_count() > 0
}

test fn w_interpreter_census_consumes_roster_authority() -> Bool {
  std.primitive_identity.primitive_d0_interpreter_census_matches_roster()
    && std.primitive_identity.primitive_d0_interpreter_surface_row_count() == gunbc.v1_interpreter_primitive_surface.v1_interpreter_row_count()
    && gunbc.v1_interpreter_primitive_surface.distinct_arm_identity_count() < gunbc.v1_interpreter_primitive_surface.v1_interpreter_row_count()
    && gunbc.v1_interpreter_primitive_surface.authored_spelling_count() < gunbc.v1_interpreter_primitive_surface.distinct_arm_identity_count()
}

test fn w_derived_surface_census_population() -> Bool {
  let registry_rows = count(std.primitives.builtin_registry_surface_names())
  let derived_rows = std.primitive_identity.primitive_d0_surface_census_derived_row_count()
  derived_rows > registry_rows && derived_rows > 100
}

test fn w_interpreter_surface_rows_marked_derived_from_authority() -> Bool {
  std.primitive_identity.primitive_d0_interpreter_rows_are_from_authority()
}

test fn w_derived_rows_marked_derived_from_authority() -> Bool {
  std.primitive_identity.primitive_d0_derived_rows_are_from_authority()
}

test fn w_map_keys_joins_all_five_surfaces() -> Bool {
  std.primitive_identity.primitive_d0_map_keys_five_surface_join_holds()
}

test fn w_fold_list_spelling_fork_named_finding() -> Bool {
  std.primitive_identity.primitive_d0_fold_list_spelling_fork_holds()
}

test fn w_fold_list_registry_gap_proves_open_denominator() -> Bool {
  std.primitive_identity.primitive_d0_fold_list_registry_gap_holds()
}

test fn w_index_by_registry_algebra_gap_named_finding() -> Bool {
  std.primitive_identity.primitive_d0_index_by_registry_algebra_gap_holds()
}

test fn w_unknown_realization_refuses() -> Bool {
  match std.primitive_identity.primitive_realization_unknown_primitive_violation(
    realization: std.primitive_identity.PrimitiveRealization {
      primitive: std.primitive_identity.primitive_map_keys,
      target: std.primitive_identity.EmitRust,
      handler: std.decl_ref.decl_ref(module_path: "std.primitive_identity", decl_name: "missing_handler"),
    },
    definitions: [],
  ) {
    Present { value: std.primitive_identity.RealizationNamesUnknownPrimitive { target: _, handler: _ } } => true
    Absent => false
  }
}

test fn w_duplicate_semantic_definition_refuses() -> Bool {
  match std.primitive_identity.primitive_duplicate_semantic_definition_violation(
    definitions: std.primitive_identity.primitive_d0_definitions,
    target: std.primitive_identity.primitive_map_keys,
  ) {
    Present { value: _ } => false
    Absent => true
  }
    && match std.primitive_identity.primitive_duplicate_semantic_definition_violation(
      definitions: [std.primitive_identity.primitive_map_keys_definition, std.primitive_identity.primitive_map_keys_definition],
      target: std.primitive_identity.primitive_map_keys,
    ) {
      Present { value: std.primitive_identity.DuplicateSemanticDefinition { identity } } =>
        std.primitive_identity.primitive_identity_eq(left: identity, right: std.primitive_identity.primitive_map_keys)
      Absent => false
    }
}

test fn w_host_unspecified_traversal_classified_for_map_projections() -> Bool {
  std.primitive_identity.primitive_d0_host_unspecified_traversal_classified()
    && std.primitive_identity.primitive_d0_traversal_facts |> any(fact =>
      std.primitive_identity.primitive_identity_eq(left: fact.primitive, right: std.primitive_identity.primitive_sorted_map_keys)
        && fact.order == std.primitive_identity.CanonicalOrder
    )
    && count(std.primitive_identity.primitive_d0_traversal_facts) == 5
}

test fn w_red_missing_identity_on_joined_surface() -> Bool {
  let planted = std.primitive_identity.surface_row(
    authority: std.primitive_identity.InterpreterDispatch,
    authored_symbol: "map_keys",
    authority_ref: std.decl_ref.decl_ref(module_path: "v1_interpreter", decl_name: "eval_builtin_inner"),
    primitive: Absent,
    provenance: std.primitive_identity.MeasurementOnly,
  )
  match std.primitive_identity.primitive_surface_missing_identity_violation(row: planted) {
    Present { value: std.primitive_identity.SurfaceMissingPrimitiveIdentity { authority, authored_symbol } } =>
      authority == std.primitive_identity.InterpreterDispatch && (authored_symbol as String) == "map_keys"
    Absent => false
  }
}

test fn w_red_surface_joins_two_identities() -> Bool {
  let left = std.primitive_identity.surface_row(
    authority: std.primitive_identity.BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: std.decl_ref.decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: std.primitive_identity.primitive_map_keys },
    provenance: std.primitive_identity.MeasurementOnly,
  )
  let right = std.primitive_identity.surface_row(
    authority: std.primitive_identity.BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: std.decl_ref.decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: std.primitive_identity.primitive_map_values },
    provenance: std.primitive_identity.MeasurementOnly,
  )
  match std.primitive_identity.primitive_surface_joins_two_identities_violation(left: left, right: right) {
    Present { value: std.primitive_identity.SurfaceJoinsTwoIdentities { authority, authored_symbol, first, second } } =>
      authority == std.primitive_identity.BuiltinRegistry
        && (authored_symbol as String) == "map_keys"
        && std.primitive_identity.primitive_identity_eq(left: first, right: std.primitive_identity.primitive_map_keys)
        && std.primitive_identity.primitive_identity_eq(left: second, right: std.primitive_identity.primitive_map_values)
    Absent => false
  }
}

test fn w_red_cross_authority_identity_fork() -> Bool {
  let registry_row = std.primitive_identity.surface_row(
    authority: std.primitive_identity.BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: std.decl_ref.decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: std.primitive_identity.primitive_map_keys },
    provenance: std.primitive_identity.MeasurementOnly,
  )
  let contract_row = std.primitive_identity.surface_row(
    authority: std.primitive_identity.PrimitiveContractRow,
    authored_symbol: "map_keys",
    authority_ref: std.decl_ref.decl_ref(module_path: "std.primitives", decl_name: "map_keys_contract"),
    primitive: Present { value: std.primitive_identity.primitive_map_values },
    provenance: std.primitive_identity.MeasurementOnly,
  )
  match std.primitive_identity.primitive_surface_joins_two_identities_violation(left: registry_row, right: contract_row) {
    Present { value: std.primitive_identity.IncompatibleInvocationAssignment { authored_symbol, first, second } } =>
      (authored_symbol as String) == "map_keys"
        && std.primitive_identity.primitive_identity_eq(left: first, right: std.primitive_identity.primitive_map_keys)
        && std.primitive_identity.primitive_identity_eq(left: second, right: std.primitive_identity.primitive_map_values)
    Absent => false
  }
}

test fn w_red_incompatible_invocation_assignment() -> Bool {
  match std.primitive_identity.primitive_incompatible_invocation_assignment_violation(
    authored_symbol: "keys",
    first: std.primitive_identity.primitive_map_keys,
    second: std.primitive_identity.primitive_map_values,
  ) {
    Present { value: std.primitive_identity.IncompatibleInvocationAssignment { authored_symbol, first, second } } =>
      (authored_symbol as String) == "keys"
        && std.primitive_identity.primitive_identity_eq(left: first, right: std.primitive_identity.primitive_map_keys)
        && std.primitive_identity.primitive_identity_eq(left: second, right: std.primitive_identity.primitive_map_values)
    Absent => false
  }
}
