module test.claim.primitive_identity_join_witness_test

import std.primitive_identity {
  BuiltinRegistry,
  CanonicalOrder,
  DuplicateSemanticDefinition,
  InterpreterDispatch,
  IncompatibleInvocationAssignment,
  PrimitiveContractRow,
  RealizationNamesUnknownPrimitive,
  SurfaceJoinsTwoIdentities,
  SurfaceMissingPrimitiveIdentity,
  primitive_d0_definitions,
  primitive_d0_derived_rows_missing_identity_count,
  primitive_d0_derived_surface_authority_count,
  primitive_d0_fold_list_registry_gap_holds,
  primitive_d0_fold_list_spelling_fork_holds,
  primitive_d0_derived_rows_are_from_authority,
  primitive_d0_host_unspecified_traversal_classified,
  primitive_d0_index_by_registry_algebra_gap_holds,
  primitive_d0_interpreter_rows_are_from_authority,
  primitive_d0_interpreter_census_matches_roster,
  primitive_d0_interpreter_surface_row_count,
  primitive_d0_map_keys_five_surface_join_holds,
  primitive_d0_open_denominator_receipt_holds,
  primitive_d0_open_surface_authority_count,
  primitive_d0_parallel_roster_surface_authority_count,
  primitive_d0_surface_census,
  primitive_d0_surface_census_derived_row_count,
  primitive_d0_traversal_facts,
  primitive_fold_list,
  primitive_duplicate_semantic_definition_violation,
  primitive_identity_eq,
  primitive_incompatible_invocation_assignment_violation,
  primitive_map_keys,
  primitive_map_keys_definition,
  primitive_map_values,
  primitive_sorted_map_keys,
  primitive_realization_unknown_primitive_violation,
  primitive_surface_joins_two_identities_violation,
  primitive_surface_missing_identity_violation,
  PrimitiveRealization,
  EmitRust,
  MeasurementOnly,
  surface_row,
}
import std.decl_ref { decl_ref }
import gunbc.v1_interpreter_primitive_surface {
  authored_spelling_count,
  distinct_arm_identity_count,
  v1_interpreter_row_count,
}
import std.primitives { builtin_registry_surface_names }
import std.types { Bool, List, String }

data primitive_identity_join_witness_note: String = "D0/D1 slice (NOT closing contract): join mechanism + five refusal variants typed, three detectors executing on census plus two scaffold detectors on planted RED inputs (primitive_d0_refusal_execution_note); subject universe derived across all five surfaces including InterpreterDispatch from gunbc.v1_interpreter_primitive_surface. D1: measurement scaffold deleted, primitive_surface_census_derived absorbs interpreter roster. Open denominator counted by primitive_d0_open_denominator_receipt_holds and primitive_d0_derived_rows_missing_identity_count."

test fn w_open_denominator_counted_receipt() -> Bool {
  primitive_d0_open_denominator_receipt_holds()
    && primitive_d0_derived_surface_authority_count == 5
    && primitive_d0_parallel_roster_surface_authority_count == 2
    && primitive_d0_open_surface_authority_count == 0
    && primitive_d0_derived_rows_missing_identity_count() > 0
}

test fn w_interpreter_census_consumes_roster_authority() -> Bool {
  primitive_d0_interpreter_census_matches_roster()
    && primitive_d0_interpreter_surface_row_count() == v1_interpreter_row_count()
    && distinct_arm_identity_count() < v1_interpreter_row_count()
    && authored_spelling_count() < distinct_arm_identity_count()
}

test fn w_derived_surface_census_population() -> Bool {
  let registry_rows = count(builtin_registry_surface_names())
  let derived_rows = primitive_d0_surface_census_derived_row_count()
  derived_rows > registry_rows && derived_rows > 100
}

test fn w_interpreter_surface_rows_marked_derived_from_authority() -> Bool {
  primitive_d0_interpreter_rows_are_from_authority()
}

test fn w_derived_rows_marked_derived_from_authority() -> Bool {
  primitive_d0_derived_rows_are_from_authority()
}

test fn w_map_keys_joins_all_five_surfaces() -> Bool {
  primitive_d0_map_keys_five_surface_join_holds()
}

test fn w_fold_list_spelling_fork_named_finding() -> Bool {
  primitive_d0_fold_list_spelling_fork_holds()
}

test fn w_fold_list_registry_gap_proves_open_denominator() -> Bool {
  primitive_d0_fold_list_registry_gap_holds()
}

test fn w_index_by_registry_algebra_gap_named_finding() -> Bool {
  primitive_d0_index_by_registry_algebra_gap_holds()
}

test fn w_unknown_realization_refuses() -> Bool {
  match primitive_realization_unknown_primitive_violation(
    realization: PrimitiveRealization {
      primitive: primitive_map_keys,
      target: EmitRust,
      handler: decl_ref(module_path: "std.primitive_identity", decl_name: "missing_handler"),
    },
    definitions: [],
  ) {
    Present { value: RealizationNamesUnknownPrimitive { target: _, handler: _ } } => true
    Absent => false
  }
}

test fn w_duplicate_semantic_definition_refuses() -> Bool {
  match primitive_duplicate_semantic_definition_violation(
    definitions: primitive_d0_definitions,
    target: primitive_map_keys,
  ) {
    Present { value: _ } => false
    Absent => true
  }
    && match primitive_duplicate_semantic_definition_violation(
      definitions: [primitive_map_keys_definition, primitive_map_keys_definition],
      target: primitive_map_keys,
    ) {
      Present { value: DuplicateSemanticDefinition { identity } } =>
        primitive_identity_eq(left: identity, right: primitive_map_keys)
      Absent => false
    }
}

test fn w_host_unspecified_traversal_classified_for_map_projections() -> Bool {
  primitive_d0_host_unspecified_traversal_classified()
    && primitive_d0_traversal_facts |> any(fact =>
      primitive_identity_eq(left: fact.primitive, right: primitive_sorted_map_keys)
        && fact.order == CanonicalOrder
    )
    && count(primitive_d0_traversal_facts) == 5
}

test fn w_red_missing_identity_on_joined_surface() -> Bool {
  let planted = surface_row(
    authority: InterpreterDispatch,
    authored_symbol: "map_keys",
    authority_ref: decl_ref(module_path: "v1_interpreter", decl_name: "eval_builtin_inner"),
    primitive: Absent,
    provenance: MeasurementOnly,
  )
  match primitive_surface_missing_identity_violation(row: planted) {
    Present { value: SurfaceMissingPrimitiveIdentity { authority, authored_symbol } } =>
      authority == InterpreterDispatch && (authored_symbol as String) == "map_keys"
    Absent => false
  }
}

test fn w_red_surface_joins_two_identities() -> Bool {
  let left = surface_row(
    authority: BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: primitive_map_keys },
    provenance: MeasurementOnly,
  )
  let right = surface_row(
    authority: BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: primitive_map_values },
    provenance: MeasurementOnly,
  )
  match primitive_surface_joins_two_identities_violation(left: left, right: right) {
    Present { value: SurfaceJoinsTwoIdentities { authority, authored_symbol, first, second } } =>
      authority == BuiltinRegistry
        && (authored_symbol as String) == "map_keys"
        && primitive_identity_eq(left: first, right: primitive_map_keys)
        && primitive_identity_eq(left: second, right: primitive_map_values)
    Absent => false
  }
}

test fn w_red_cross_authority_identity_fork() -> Bool {
  let registry_row = surface_row(
    authority: BuiltinRegistry,
    authored_symbol: "map_keys",
    authority_ref: decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
    primitive: Present { value: primitive_map_keys },
    provenance: MeasurementOnly,
  )
  let contract_row = surface_row(
    authority: PrimitiveContractRow,
    authored_symbol: "map_keys",
    authority_ref: decl_ref(module_path: "std.primitives", decl_name: "map_keys_contract"),
    primitive: Present { value: primitive_map_values },
    provenance: MeasurementOnly,
  )
  match primitive_surface_joins_two_identities_violation(left: registry_row, right: contract_row) {
    Present { value: IncompatibleInvocationAssignment { authored_symbol, first, second } } =>
      (authored_symbol as String) == "map_keys"
        && primitive_identity_eq(left: first, right: primitive_map_keys)
        && primitive_identity_eq(left: second, right: primitive_map_values)
    Absent => false
  }
}

test fn w_red_incompatible_invocation_assignment() -> Bool {
  match primitive_incompatible_invocation_assignment_violation(
    authored_symbol: "keys",
    first: primitive_map_keys,
    second: primitive_map_values,
  ) {
    Present { value: IncompatibleInvocationAssignment { authored_symbol, first, second } } =>
      (authored_symbol as String) == "keys"
        && primitive_identity_eq(left: first, right: primitive_map_keys)
        && primitive_identity_eq(left: second, right: primitive_map_values)
    Absent => false
  }
}
