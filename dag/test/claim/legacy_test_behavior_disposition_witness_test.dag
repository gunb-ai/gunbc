module test.claim.legacy_test_behavior_disposition_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data fixture_covered_behavior: gunbc.legacy_test_behavior_disposition.LegacyTestBehavior = gunbc.legacy_test_behavior_disposition.LegacyTestBehavior {
  source_file: "fixture/legacy.rs" as std.types.FilePath,
  test_fn: "covered_behavior" as std.types.NonEmptyStr,
}

data fixture_retained_behavior: gunbc.legacy_test_behavior_disposition.LegacyTestBehavior = gunbc.legacy_test_behavior_disposition.LegacyTestBehavior {
  source_file: "fixture/legacy.rs" as std.types.FilePath,
  test_fn: "retained_behavior" as std.types.NonEmptyStr,
}

data fixture_witness: gunbc.legacy_test_behavior_disposition.TestBehaviorWitness = gunbc.legacy_test_behavior_disposition.TestBehaviorWitness {
  entry: "fixture/replacement_test.dag" as std.types.FilePath,
  test_fn: "replacement_catches_regression" as std.types.NonEmptyStr,
}

data fixture_covered_disposition: gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorDisposition = gunbc.legacy_test_behavior_disposition.CoveredByWitness {
  behavior: fixture_covered_behavior,
  witness: fixture_witness,
  distinguishing_failure: "planted regression changes the replacement verdict from true to false" as std.types.NonEmptyStr,
}

data fixture_retained_disposition: gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorDisposition = gunbc.legacy_test_behavior_disposition.RetainedNonMigratableBehavior {
  behavior: fixture_retained_behavior,
  reason: "fixture host-only behavior cannot yet execute through the substrate" as std.types.NonEmptyStr,
  dissolution: std.dissolution.unbound_dissolution(description: "the fixture host surface becomes a modeled effect"),
}

fn fixture_discovered_legacy() -> List<String> {
  [
    gunbc.legacy_test_behavior_disposition.legacy_test_behavior_id(behavior: fixture_covered_behavior),
    gunbc.legacy_test_behavior_disposition.legacy_test_behavior_id(behavior: fixture_retained_behavior),
  ]
}

fn fixture_discovered_witnesses() -> List<String> {
  [gunbc.legacy_test_behavior_disposition.test_behavior_witness_id(witness: fixture_witness)]
}

fn fixture_complete_dispositions() -> List<gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorDisposition> {
  [fixture_covered_disposition, fixture_retained_disposition]
}

test fn legacy_test_behavior_live_discovery_and_first_file_mapping_hold() -> Bool {
  gunbc.legacy_test_behavior_disposition.legacy_test_behavior_declared_slice_holds()
}

test fn legacy_test_behavior_complete_fixture_is_admitted() -> Bool {
  gunbc.legacy_test_behavior_disposition.legacy_test_behavior_disposition_graph_holds(
    discovery_holds: true,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: fixture_complete_dispositions(),
  )
}

test fn legacy_test_behavior_planted_unclassified_function_reds() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_disposition_graph_holds(
    discovery_holds: true,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: [fixture_covered_disposition],
  )
}

test fn legacy_test_behavior_planted_misclassification_reds() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_disposition_graph_holds(
    discovery_holds: true,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: [],
    dispositions: fixture_complete_dispositions(),
  )
}

data fixture_family: gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorFamily = gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorFamily {
  name: "fixture-family" as std.types.NonEmptyStr,
  source_files: ["fixture/legacy.rs" as std.types.FilePath],
}

data fixture_absent_family: gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorFamily = gunbc.legacy_test_behavior_disposition.LegacyTestBehaviorFamily {
  name: "fixture-absent-family" as std.types.NonEmptyStr,
  source_files: ["fixture/never_discovered.rs" as std.types.FilePath],
}

data fixture_outside_family_behavior: gunbc.legacy_test_behavior_disposition.LegacyTestBehavior = gunbc.legacy_test_behavior_disposition.LegacyTestBehavior {
  source_file: "fixture/other.rs" as std.types.FilePath,
  test_fn: "outside_family_behavior" as std.types.NonEmptyStr,
}

fn fixture_discovered_legacy_with_outsider() -> List<String> {
  [
    gunbc.legacy_test_behavior_disposition.legacy_test_behavior_id(behavior: fixture_covered_behavior),
    gunbc.legacy_test_behavior_disposition.legacy_test_behavior_id(behavior: fixture_retained_behavior),
    gunbc.legacy_test_behavior_disposition.legacy_test_behavior_id(behavior: fixture_outside_family_behavior),
  ]
}

test fn legacy_test_behavior_family_complete_fixture_is_admitted() -> Bool {
  gunbc.legacy_test_behavior_disposition.legacy_test_behavior_family_complete(
    discovery_holds: true,
    family: fixture_family,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: fixture_complete_dispositions(),
  )
}

test fn legacy_test_behavior_family_ignores_unclassified_outside_its_files() -> Bool {
  gunbc.legacy_test_behavior_disposition.legacy_test_behavior_family_complete(
    discovery_holds: true,
    family: fixture_family,
    discovered_legacy: fixture_discovered_legacy_with_outsider(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: fixture_complete_dispositions(),
  )
    && !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_disposition_graph_holds(
      discovery_holds: true,
      discovered_legacy: fixture_discovered_legacy_with_outsider(),
      discovered_witnesses: fixture_discovered_witnesses(),
      dispositions: fixture_complete_dispositions(),
    )
}

test fn legacy_test_behavior_family_planted_unclassified_member_reds() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_family_complete(
    discovery_holds: true,
    family: fixture_family,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: [fixture_covered_disposition],
  )
}

test fn legacy_test_behavior_family_with_no_discovered_member_reds() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_family_complete(
    discovery_holds: true,
    family: fixture_absent_family,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: fixture_discovered_witnesses(),
    dispositions: fixture_complete_dispositions(),
  )
}

test fn legacy_test_behavior_family_unresolved_witness_reds() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_family_complete(
    discovery_holds: true,
    family: fixture_family,
    discovered_legacy: fixture_discovered_legacy(),
    discovered_witnesses: [],
    dispositions: fixture_complete_dispositions(),
  )
}

test fn legacy_test_behavior_discovery_refusal_cannot_fabricate_green() -> Bool {
  !gunbc.legacy_test_behavior_disposition.legacy_test_behavior_disposition_graph_holds(
    discovery_holds: false,
    discovered_legacy: [],
    discovered_witnesses: [],
    dispositions: [],
  )
}
