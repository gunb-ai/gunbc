module test.claim.c_roadmap2_credential_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE CREDENTIAL-STORE RECORD AND THE TAKE'S DESTINATION ARE BOTH SEALED, AND THE PRE-SEAL SPELLINGS ARE
// GONE. gunbc.dispatch_credential_acquisition CursorAttemptRuntimeRoot is sole_constructor: the record can
// be built only by this module's own routes, each of which takes a sealed input -- a CredentialAcquisitionStore
// (cursor_attempt_runtime_root, cursor_attempt_runtime_parent) or a TakenCredentialSnapshot
// (credential_taken_cursor_runtime_root) -- so the instance whose records a fold reads and the directory that
// fold creates, observes and removes can never be paired from two roots a caller chose. And
// gunbc.dispatch_credential_snapshot dispatch_credential_snapshot_take no longer accepts `snapshot:`: the
// path is DERIVED inside the take from the attempt whose bytes are taken, so a caller cannot aim the take at
// a file of its choosing (the pre-seal code also spelled that path a second time from the dispatch actuator's
// own literals, dispatch_credential_snapshot_path_for_attempt; that export is deleted too). Each RED asserts
// EXACTLY ONE located refusal on its subject, so a RED cannot come from an unrelated diagnostic; the
// stripped twin (test.fixture.c_roadmap2_credential_store_seal) is the paired control that says the seal --
// not the source -- is what refuses; the GREEN is the lawful route, which adds no blocking diagnostic and
// draws no seal violation. What these probes do NOT establish is recorded once, in the pattern's own witness
// (test.claim.slot_store_seal_witness): field reads are not module-private, a plain store over a literal path
// is still reachable through the ambient filesystem, and a store minted for instance A is not refused where
// B is required. This file claims construction and the deletion of the routes.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn missing_export(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "MissingExport", wanted_subject: subject)
}

// THE CLASS A CALL SHAPE THAT NO LONGER EXISTS DRAWs: the compiler locates it on the ARGUMENT NAME
// (src/v1/stage0/src/cli_run/compile_clean.rs CompilerDiagnostic::CallArgumentNameUnknown), which is exactly
// the spelling the seal removed -- `instance_root:` on the root routes, `snapshot:` on the take.
fn unknown_argument(source: String, argument: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "CallArgumentNameUnknown", wanted_subject: argument)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data closure_baseline_source: String = "module probe_credential_seal_closure_baseline\nimport std.types { NonEmptyStr, FilePath, String }\nimport std.optional { Present }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, CursorAttemptRuntimeRoot, credential_acquisition_store }\nimport gunbc.dispatch_credential_snapshot { DispatchCredentialSnapshot, DispatchSnapshotTaken, DispatchSnapshotRefused, ClaudeFromSnapshot, SnapshotExecutor, TakenCredentialSnapshot, dispatch_credential_snapshot_take, taken_credential_snapshot_path }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.host_custody_export_receipt { SnapshotCustodyDeclaration }\nimport gunbc.roadmap.roadmap_dashboard_instance { isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nfn baseline(p: NonEmptyStr) -> NonEmptyStr? {\n  Present { value: p }\n}\n"

// ── the forged root ─────────────────────────────────────────────────────────────────────────────────────

data forged_cursor_runtime_root_source: String = "module probe_fcarr\nimport std.types { String }\nimport gunbc.dispatch_credential_acquisition { CursorAttemptRuntimeRoot }\nfn f() -> CursorAttemptRuntimeRoot { CursorAttemptRuntimeRoot { base: \"/home/admin/.gunbc/instances/some-other-instance/cursor-attempt-runtime/chosen-by-the-caller\" } }\n"

test fn a_forged_cursor_runtime_root_is_refused() -> ProcessExit {
  census_exit(verdict: census_verdict(census: seal_violations(source: forged_cursor_runtime_root_source, subject: "CursorAttemptRuntimeRoot"), holds: fn(n) { n == 1 }))
}

// THE CLAIM THE PRODUCTION COMMENT CITES (gunbc.dispatch_credential_acquisition, above the sealed record).
// The root over a directory a caller chose is not constructible: the literal is refused, and the two routes
// that used to take a caller-chosen instance root refuse the argument they no longer have.
test fn the_cursor_runtime_root_cannot_be_built_over_a_root_a_caller_chose() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: forged_cursor_runtime_root_source, subject: "CursorAttemptRuntimeRoot"), holds: fn(n) { n == 1 }),
    census_verdict(census: unknown_argument(source: deleted_root_taking_route_source, argument: "instance_root"), holds: fn(n) { n == 1 }),
    census_verdict(census: unknown_argument(source: deleted_parent_taking_route_source, argument: "instance_root"), holds: fn(n) { n == 1 }),
  ])
}

// ── the take's destination ──────────────────────────────────────────────────────────────────────────────

data deleted_take_snapshot_argument_source: String = "module probe_tsa\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.host_custody_export_receipt { SnapshotCustodyDeclaration }\nimport gunbc.dispatch_credential_snapshot { DispatchCredentialSnapshot, SnapshotExecutor, dispatch_credential_snapshot_take }\nfn f(a: DispatchAttempt, e: SnapshotExecutor, c: SnapshotCustodyDeclaration, p: NonEmptyStr) -> DispatchCredentialSnapshot { dispatch_credential_snapshot_take(attempt: a, executor: e, custody: c, snapshot: p) }\n"

// THE CLAIM THE PRODUCTION COMMENTS CITE (gunbc.dispatch_credential_snapshot above the slots declaration and
// above the take; gunbc.dispatch_credential_acquisition above credential_register_then_take). The take keeps
// no destination parameter: a caller that hands it a path is refused at the argument, and the dispatch
// actuator's own second spelling of that path is no longer exported at all.
test fn the_take_cannot_be_handed_a_path_its_caller_chose() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: unknown_argument(source: deleted_take_snapshot_argument_source, argument: "snapshot"), holds: fn(n) { n == 1 }),
    census_verdict(census: missing_export(source: deleted_actuator_path_route_source, subject: "dispatch_credential_snapshot_path_for_attempt"), holds: fn(n) { n == 1 }),
  ])
}

// ── the deleted routes ──────────────────────────────────────────────────────────────────────────────────

data deleted_root_taking_route_source: String = "module probe_drr\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_acquisition { CursorAttemptRuntimeRoot, cursor_attempt_runtime_root }\nfn f(root: NonEmptyStr, reference: NonEmptyStr) -> CursorAttemptRuntimeRoot { cursor_attempt_runtime_root(instance_root: root, reference: reference) }\n"

data deleted_parent_taking_route_source: String = "module probe_dpr\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_credential_acquisition { cursor_attempt_runtime_parent }\nfn f(root: NonEmptyStr) -> NonEmptyStr { cursor_attempt_runtime_parent(instance_root: root) }\n"

data deleted_actuator_path_route_source: String = "module probe_dap\nimport std.types { NonEmptyStr }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.dispatch_credential_snapshot { SnapshotExecutor }\nimport gunbc.roadmap.roadmap_dispatch_actuator { dispatch_credential_snapshot_path_for_attempt }\nfn f(a: DispatchAttempt, e: SnapshotExecutor) -> NonEmptyStr { dispatch_credential_snapshot_path_for_attempt(attempt: a, executor: e) }\n"

test fn the_root_taking_route_the_pre_seal_code_exported_is_gone() -> ProcessExit {
  census_exit(verdict: census_verdict(census: unknown_argument(source: deleted_root_taking_route_source, argument: "instance_root"), holds: fn(n) { n == 1 }))
}

test fn the_parent_taking_route_the_pre_seal_code_exported_is_gone() -> ProcessExit {
  census_exit(verdict: census_verdict(census: unknown_argument(source: deleted_parent_taking_route_source, argument: "instance_root"), holds: fn(n) { n == 1 }))
}

test fn the_actuator_path_route_the_pre_seal_code_exported_is_gone() -> ProcessExit {
  census_exit(verdict: census_verdict(census: missing_export(source: deleted_actuator_path_route_source, subject: "dispatch_credential_snapshot_path_for_attempt"), holds: fn(n) { n == 1 }))
}

// ── the stripped twin: the seal is the wall, not the source ─────────────────────────────────────────────

// THE STRIPPED TWIN: the same hostile source against two definer fixtures that differ in nothing but the
// `sole_constructor` keyword.
data sealed_twin_cursor_runtime_root_source: String = "module probe_twin_sealed\nimport std.types { NonEmptyStr }\nimport test.fixture.c_roadmap2_credential_store_seal.definer { CursorAttemptRuntimeRoot }\nfn forged() -> CursorAttemptRuntimeRoot { CursorAttemptRuntimeRoot { base: \"/chosen/by/the/caller\" } }\n"

data stripped_twin_cursor_runtime_root_source: String = "module probe_twin_stripped\nimport std.types { NonEmptyStr }\nimport test.fixture.c_roadmap2_credential_store_seal.stripped_definer { CursorAttemptRuntimeRoot }\nfn forged() -> CursorAttemptRuntimeRoot { CursorAttemptRuntimeRoot { base: \"/chosen/by/the/caller\" } }\n"

test fn the_cursor_runtime_root_seal_is_what_refuses_construction() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: seal_violations(source: sealed_twin_cursor_runtime_root_source, subject: "CursorAttemptRuntimeRoot"), holds: fn(n) { n == 1 }),
    census_verdict(census: seal_violations(source: stripped_twin_cursor_runtime_root_source, subject: "CursorAttemptRuntimeRoot"), holds: fn(n) { n == 0 }),
    blocking_delta(hostile: sealed_twin_cursor_runtime_root_source, safe: stripped_twin_cursor_runtime_root_source, holds: fn(n) { n == 1 }),
  ])
}

// ── the lawful routes are admitted ──────────────────────────────────────────────────────────────────────

data lawful_cursor_runtime_root_route_source: String = "module probe_g1\nimport std.types { NonEmptyStr, FilePath, String }\nimport std.optional { Present }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, cursor_attempt_runtime_root, cursor_attempt_runtime_parent }\nimport gunbc.dispatch_credential_snapshot { DispatchSnapshotTaken, DispatchSnapshotRefused, ClaudeFromSnapshot, dispatch_credential_snapshot_take, taken_credential_snapshot_path }\nimport gunbc.dispatch_attempt { DispatchAttempt }\nimport gunbc.host_custody_export_receipt { SnapshotCustodyDeclaration }\nimport gunbc.roadmap.roadmap_dashboard_instance { isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nfn f() -> String {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"witness\" as NonEmptyStr), instance_id: \"witness\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/tmp/witness\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match credential_acquisition_store(instance: i) {\n    CredentialAcquisitionStoreReady { store: s } => cursor_attempt_runtime_root(credentials: s, reference: \"k\" as NonEmptyStr).base\n    CredentialAcquisitionStoreUnready { detail: d } => d\n  }\n}\nfn parent() -> NonEmptyStr {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"witness\" as NonEmptyStr), instance_id: \"witness\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/tmp/witness\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match credential_acquisition_store(instance: i) {\n    CredentialAcquisitionStoreReady { store: s } => cursor_attempt_runtime_parent(credentials: s)\n    CredentialAcquisitionStoreUnready { detail: _ } => \"unready\" as NonEmptyStr\n  }\n}\nfn take(a: DispatchAttempt, c: SnapshotCustodyDeclaration) -> NonEmptyStr? {\n  match dispatch_credential_snapshot_take(attempt: a, executor: ClaudeFromSnapshot, custody: c) {\n    DispatchSnapshotTaken { snapshot: s } => Present { value: taken_credential_snapshot_path(snapshot: s) }\n    DispatchSnapshotRefused { reason: _ } => none\n  }\n}\n"

test fn the_lawful_cursor_runtime_root_route_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    census_verdict(census: missing_export(source: lawful_cursor_runtime_root_route_source, subject: "cursor_attempt_runtime_root"), holds: fn(n) { n == 0 }),
    census_verdict(census: missing_export(source: lawful_cursor_runtime_root_route_source, subject: "dispatch_credential_snapshot_take"), holds: fn(n) { n == 0 }),
    census_verdict(census: unknown_argument(source: lawful_cursor_runtime_root_route_source, argument: "instance_root"), holds: fn(n) { n == 0 }),
    census_verdict(census: unknown_argument(source: lawful_cursor_runtime_root_route_source, argument: "snapshot"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: lawful_cursor_runtime_root_route_source, subject: "CursorAttemptRuntimeRoot"), holds: fn(n) { n == 0 }),
    blocking_delta(hostile: lawful_cursor_runtime_root_route_source, safe: closure_baseline_source, holds: fn(n) { n == 0 }),
  ])
}
