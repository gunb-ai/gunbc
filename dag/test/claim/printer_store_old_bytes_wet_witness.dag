module test.claim.printer_store_old_bytes_wet_witness

import extdeps.shell
import std.types { Bool, String, NonEmptyStr, FilePath }
import std.optional { Present, Absent }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.emit { JsonValue, json_object, json_kv, json_string, serialize_json }
import std.content_hash { sha256_hex_digest }
import std.durable_exclusive_hold { DurableHoldOwnerRef, DurableHoldReleaseRef }
import std.durable_compare_and_set { CasObservedReadable, CasObservedUnreadable, CasReadablePresent, CasReadableAbsent }
import gunbc.durable_cas_file_store { slot_observe }
import gunbc.durable_exclusive_hold_file_store { file_hold_acquire, file_hold_release_assess, file_hold_release_commit, FileHoldReleasePlanned, FileHoldReleaseNotEligible, FileHoldReleased, FileHoldReleaseLost, FileHoldReleaseStoreUnavailable, FileHoldReleaseKeyNotSlotAddressable, FileHoldAcquired, FileHoldOccupied, FileHoldAcquireLost, FileHoldAcquireStoreUnavailable, FileHoldSlotUndecodable, FileHoldKeyNotSlotAddressable }
import gunbc.host_state_root { HostStateTree, isolated_host_state_tree }
import gunbc.fleet.fleet_asset_identity { PhysicalAssetIdentity }
import gunbc.fleet.print_request { PrintRequest, PrintRequestRecord, print_attempt_id, request_record_name }
import gunbc.fleet.printer_workflow_artifact { printer_starts_path }
import gunbc.fleet.print_record_stores { print_request_store, PrintRequestStoreReady, PrintRequestStoreUnready, print_request_path, print_request_read, RecordPresent, RecordAbsent, RecordRefused, record_json, print_completion_store, PrintCompletionStoreReady, PrintCompletionStoreUnready, print_completion_path, print_completion_presence, CompletionListed, CompletionNotListed, CompletionPresenceUnreadable }
import gunbc.fleet.printer_actuation { printer_start_claims, PrinterStartClaimsReady, PrinterStartClaimsUnready, printer_start_claim_path, printer_start_claim_listed, printer_start_claim_version, start_claim_evidence_prefix, printer_start_claim_commit, PrinterStartClaimed, PrinterStartClaimRefused }
import product.printed_chassis.assembly_inventory_store { cassette_inventory_store, CassetteInventoryStoreReady, CassetteInventoryStoreUnready, cassette_inventory_path, inventory_slot }
import product.printing.cad_runtime_store { cad_runtime_store, CadRuntimeStoreReady, CadRuntimeStoreUnready, print_runtime_path, cad_environment_publication, CadEnvironmentPublished, CadEnvironmentNotBuilt, CadEnvironmentUnpublished, CadEnvironmentMarkerWrong, CadEnvironmentStoreUnreadable, cad_environment_prefix, cad_environment_ready_marker }
import product.printing.cad_runtime_spec { cad_runtime_spec, cad_runtime_spec_text }

// OLD BYTES READ THROUGH THE NEW STORES, over a throwaway host-state tree. Files are planted with raw writes in the
// shapes the old code wrote them (in place);
// every store is the production function.

fn fresh_tree() -> HostStateTree? {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_printer_oldbytes.XXXXXX").path
  let tree = isolated_host_state_tree(dir: dir as NonEmptyStr)
  let made = [printer_starts_path(tree: tree) as String, print_request_path(tree: tree) as String, print_completion_path(tree: tree) as String, printer_start_claim_path(tree: tree) as String, cassette_inventory_path(tree: tree) as String]
  if all(made, d => shell.Mkdir.Parents(path: d as FilePath).success) { Present { value: tree } } else { none }
}

fn plant(tree: HostStateTree, name: String, content: String) -> Bool {
  Filesystem.WriteCreateNew(path: join([printer_starts_path(tree: tree) as String, "/", name], ""), content: content).success
}

// A request record in the format the old code wrote (its serializer, record_json, is byte-identical to the old code's, a git diff of the function is empty), planted in the
// request member where it always lived, reads back as RecordPresent through the new store; and the store's own
// serialization of the same record is byte-equal to that text.
test fn o_an_old_request_record_reads_through_the_request_store() -> Bool {
  match fresh_tree() {
    Absent => false
    Present { value: tree } => {
      let digest_hex = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      match sha256_hex_digest(hex: digest_hex) {
        Absent => false
        Present { value: digest } => {
          let request = PrintRequest { request_id: "req-1" as NonEmptyStr, root: "root-1" as NonEmptyStr, recipe: "recipe-1" as NonEmptyStr, printer: "printer-01" as PhysicalAssetIdentity }
          let attempt = print_attempt_id(request: request, artifact_sha256: digest)
          let record = PrintRequestRecord { request: request, source_revision: "rev-1" as NonEmptyStr, artifact_sha256: digest, artifact_location: "loc-1" as NonEmptyStr, attempt_id: attempt }
          let planted = Filesystem.WriteCreateNew(path: join([print_request_path(tree: tree) as String, "/", request_record_name(request_id: request.request_id)], ""), content: record_json(r: record)).success
          match print_request_store(tree: tree) {
            PrintRequestStoreUnready { detail: _ } => false
            PrintRequestStoreReady { store: store } => {
              let read = match print_request_read(store: store, request: request) { RecordPresent { record: r } => record_json(r: r) == record_json(r: record) RecordAbsent => false RecordRefused { cause: _ } => false }
              planted && read
            }
          }
        }
      }
    }
  }
}

// A CAD environment the old code published (prefix + ready marker holding the exact spec text, no lock) is
// Published through the new store.
test fn o_an_old_cad_ready_marker_is_published_through_the_cad_store() -> Bool {
  match fresh_tree() {
    Absent => false
    Present { value: tree } => match cad_runtime_store(tree: tree) {
      CadRuntimeStoreUnready { detail: _ } => false
      CadRuntimeStoreReady { store: store } => {
        let prefix = cad_environment_prefix(store: store, spec: cad_runtime_spec)
        let planted = shell.Mkdir.Parents(path: prefix as FilePath).success && Filesystem.WriteCreateNew(path: join([prefix, "/", cad_environment_ready_marker], ""), content: cad_runtime_spec_text(spec: cad_runtime_spec)).success
        planted && match cad_environment_publication(store: store, spec: cad_runtime_spec) {
          CadEnvironmentPublished => true
          CadEnvironmentNotBuilt => false
          CadEnvironmentUnpublished { prefix: _ } => false
          CadEnvironmentMarkerWrong { prefix: _ } => false
          CadEnvironmentStoreUnreadable { reason: _ } => false
        }
      }
    }
  }
}
