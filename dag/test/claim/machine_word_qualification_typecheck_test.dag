module test.claim.machine_word_qualification_typecheck

import std.types { String, Bool, Int }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable, census_blocking_rows, census_total_count }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }

// THE CARRIER IS ONLY A WALL IF THE BAD CALL ACTUALLY FAILS TO COMPILE, AND THAT IS NOT SOMETHING
// THE ACCEPTED CORPUS CAN SHOW.
//
// std.machine_word moved its qualification into two carriers -- QualifiedWord, produced only by
// word_qualified / word_pair_qualified, and RealizableWidth, produced only by
// word_realizable_width -- so that every helper below the public boundary cannot be handed an
// unqualified value. .dag has no module-private, so that is a sealed-wrapper convention rather than
// a private constructor, and the whole claim rests on ONE property: handing a bare Word where a
// QualifiedWord is declared does not typecheck.
//
// THAT PROPERTY IS UNWRITABLE IN THE ACCEPTED CORPUS BY CONSTRUCTION -- if it were writable there,
// the tree would not compile. DESIGN section 4b is explicit that this is not a ceiling: a state
// unrepresentable in the accepted corpus may still be perfectly representable as SOURCE HANDED TO
// THE COMPILER BY A FIXTURE, and where the refusal is authorable there, declining to enrol it is
// specification-without-execution. So the sources below are compiled through the real acceptance
// path, and the wall is read off what the compiler says about them rather than off the fact that
// the repository happens to build.
//
// THIS MODULE IS SEPARATE FROM machine_word_witness_test DELIBERATELY. That file is stamped
// SubstrateInputsOnly and the stamp is true: it computes over supplied values and reads nothing.
// compile_dag_diagnostic_census walks the checkout, so putting these claims there would have made
// that stamp a lie of exactly the kind the corpus already records as a failure mode -- a
// SubstrateInputsOnly entry whose body reaches a live-checkout sink. Splitting them is what keeps
// both stamps honest.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// NOT-RUNNABLE IS NOT ZERO, and here it is not a positive count either. A census that could not run
// has observed nothing; reporting that as "no diagnostics" would let a broken harness satisfy the
// GREEN control, and reporting it as "some diagnostics" would let the same broken harness satisfy
// the REDs. 0 - 1 is neither, so a harness that stops working fails in both directions at once.
fn blocking_count_for(source: String, wanted: String) -> Int {
  match census_blocking_count_for_class(census: census_of(source: source), wanted: wanted) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// THE FOUR SOURCES DIFFER FROM THE GREEN ON ONE AXIS EACH: whether the argument handed to a
// carrier-typed parameter is the carrier or the bare value it used to accept. Same module, same
// callee, same arity, same field names -- so a verdict cannot be attributed to anything else.
data projection_bare_word_red_source: String = "module probe_machine_word_projection_bare\nimport std.machine_word { Word, Width8, octet_int_values }\nimport std.types { List, Int }\nfn f() -> List<Int> { octet_int_values(octets: [Word \{ width: Width8, value: 1 \}]) }\n"

data from_octets_bare_width_red_source: String = "module probe_machine_word_realizable_bare_width\nimport std.machine_word { Word, Width8, Width32, WordResult, word_from_octets_realizable }\nimport extdeps.toolchain.architecture_profile { BigEndian }\nfn f() -> WordResult { word_from_octets_realizable(width: Width32, octets: [], endianness: BigEndian) }\n"

data big_endian_value_bare_member_red_source: String = "module probe_machine_word_be_value_bare\nimport std.machine_word { Word, Width8, octets_big_endian_value }\nimport std.types { Int }\nfn f() -> Int { octets_big_endian_value(octets: [Word \{ width: Width8, value: 1 \}], radix: 256, acc: 0) }\n"

// THE GREEN CONTROL, and it is load-bearing rather than decorative: three REDs alone are satisfied
// by a compiler that has stopped judging argument types at all, or by a harness that reports a
// blocking row for every source it is handed. This one takes the SAME route through the SAME
// carrier and must produce nothing, which is only reachable when the type judgment is live.
data qualified_route_green_source: String = "module probe_machine_word_qualified_route\nimport std.machine_word { Word, Width8, OctetsResult, word_to_octets, word_of_int, WordReady, WordRefused }\nimport extdeps.toolchain.architecture_profile { BigEndian }\nfn f(w: Word) -> OctetsResult { word_to_octets(a: w, endianness: BigEndian) }\n"

test fn a_bare_word_does_not_satisfy_the_projection_carrier_holds() -> Bool {
  blocking_count_for(source: projection_bare_word_red_source, wanted: "TypeMismatch") > 0
}

test fn a_bare_width_does_not_satisfy_the_realizable_carrier_holds() -> Bool {
  blocking_count_for(source: from_octets_bare_width_red_source, wanted: "TypeMismatch") > 0
}

test fn a_bare_member_does_not_satisfy_the_accumulator_carrier_holds() -> Bool {
  blocking_count_for(source: big_endian_value_bare_member_red_source, wanted: "TypeMismatch") > 0
}

// THE GREEN CONTROL ASSERTS ACCEPTANCE, NOT THE ABSENCE OF ONE DIAGNOSTIC CLASS.
//
// It previously read blocking_count_for(..., wanted: "TypeMismatch") == 0, which is satisfied by a
// source that never reached the type judgment at all -- a parse refusal, or an unresolved import,
// leaves it permanently green. That is the decoration DESIGN section 4b names: green by
// construction, carrying no information, and worse than absent because it would be cited as the
// control that makes the three REDs mean something. The defect was live rather than theoretical:
// the probe sources imported BigEndian from std.machine_word, which does not DECLARE it -- it
// imports it from extdeps.toolchain.architecture_profile -- so the import cited the wrong authority
// and the green could have been green for the wrong reason.
//
// Blocking rows of ANY class is the right measure: it says the compiler accepted this source, which
// is the only thing that makes "and the bad ones did not" a statement about type judgment rather
// than about the harness.
fn blocking_total(source: String) -> Int {
  match census_of(source: source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn the_qualified_route_still_compiles_holds() -> Bool {
  blocking_total(source: qualified_route_green_source) == 0
}

// The REDs must also be red for the RIGHT REASON, which the class-scoped count alone does not
// establish -- a source that fails to parse reports no TypeMismatch and would read as "no defect".
// Pairing a positive TypeMismatch with a positive total is what distinguishes "the type judgment
// refused this" from "something else did".
test fn the_red_sources_refuse_on_the_type_judgment_holds() -> Bool {
  blocking_total(source: projection_bare_word_red_source) > 0
    && blocking_total(source: from_octets_bare_width_red_source) > 0
    && blocking_total(source: big_endian_value_bare_member_red_source) > 0
}
