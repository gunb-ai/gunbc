module test.claim.markdown_source_emit

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn sample_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.HeadingBlock { level: H1, inlines: [ std.markdown.TextInline { text: "Roadmap" } ] },
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.TextInline { text: "See " },
          std.markdown.LinkInline {
            inlines: [ std.markdown.TextInline { text: "plan" } ],
            url: "docs/plan.md",
          },
          std.markdown.TextInline { text: "." },
        ],
      },
      std.markdown.TaskListBlock {
        items: [
          std.markdown.MarkdownTaskItem {
            state: Checked,
            blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "done item" } ] } ],
          },
          std.markdown.MarkdownTaskItem {
            state: Unchecked,
            blocks: [
              std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "todo item" } ] },
              std.markdown.UnorderedListBlock {
                items: [
                  std.markdown.MarkdownListItem {
                    blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "subnote" } ] } ],
                  },
                ],
              },
            ],
          },
        ],
      },
      std.markdown.UnorderedListBlock {
        items: [
          std.markdown.MarkdownListItem {
            blocks: [
              std.markdown.ParagraphBlock {
                inlines: [
                  std.markdown.StrongInline { inlines: [ std.markdown.TextInline { text: "bold" } ] },
                  std.markdown.TextInline { text: " and " },
                  std.markdown.EmphasisInline { inlines: [ std.markdown.TextInline { text: "italic" } ] },
                ],
              },
            ],
          },
        ],
      },
      std.markdown.OrderedListBlock {
        items: [
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "one" } ] } ] },
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "two" } ] } ] },
        ],
      },
      std.markdown.CodeBlock { code: "let x = 1;\n" },
      std.markdown.TableBlock {
        header: std.markdown.MarkdownTableRow {
          cells: [
            std.markdown.MarkdownTableCell { inlines: [ std.markdown.TextInline { text: "h1" } ] },
            std.markdown.MarkdownTableCell { inlines: [ std.markdown.TextInline { text: "h2" } ] },
          ],
        },
        alignments: [ AlignNone, AlignCenter ],
        rows: [
          std.markdown.MarkdownTableRow {
            cells: [
              std.markdown.MarkdownTableCell { inlines: [ std.markdown.TextInline { text: "a" } ] },
              std.markdown.MarkdownTableCell { inlines: [ std.markdown.TextInline { text: "b" } ] },
            ],
          },
        ],
      },
      std.markdown.BlockquoteBlock {
        blocks: [
          std.markdown.ParagraphBlock {
            inlines: [
              std.markdown.TextInline { text: "quote " },
              std.markdown.CodeInline { text: "code" },
            ],
          },
        ],
      },
    ],
  }
}

fn expected_markdown() -> String {
  join([
    "# Roadmap\n",
    "\n",
    "See [plan](docs/plan.md).\n",
    "\n",
    "- [x] done item\n",
    "- [ ] todo item\n",
    "  - subnote\n",
    "\n",
    "- **bold** and *italic*\n",
    "\n",
    "1. one\n",
    "2. two\n",
    "\n",
    "```\n",
    "let x = 1;\n",
    "```\n",
    "\n",
    "| h1 | h2 |\n",
    "| --- | :-: |\n",
    "| a | b |\n",
    "\n",
    "> quote `code`\n"
  ], "")
}

test fn witness_exact_bytes() -> Bool {
  serialize_markdown_source(doc: test.claim.markdown_source_emit.sample_doc()) == expected_markdown()
}

fn code_only_doc(code: String) -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument { blocks: [ std.markdown.CodeBlock { code: code } ] }
}

test fn witness_code_block_closing_fence_on_own_line() -> Bool {
  let no_nl = serialize_markdown_source(doc: code_only_doc(code: "let x = 1;"))
  let with_nl = serialize_markdown_source(doc: code_only_doc(code: "let x = 1;\n"))
  (no_nl == "```\nlet x = 1;\n```\n") && (no_nl == with_nl)
}

fn perturbed_bullet_spellings() -> extdeps.languages.markdown.MarkdownSpellings {
  extdeps.languages.markdown.MarkdownSpellings {
    heading_marker: commonmark_gfm_spellings.heading_marker,
    heading_sep: commonmark_gfm_spellings.heading_sep,
    unordered_bullet: "+ ",
    ordered_suffix: commonmark_gfm_spellings.ordered_suffix,
    task_checked: commonmark_gfm_spellings.task_checked,
    task_unchecked: commonmark_gfm_spellings.task_unchecked,
    emphasis_delim: commonmark_gfm_spellings.emphasis_delim,
    strong_delim: commonmark_gfm_spellings.strong_delim,
    code_span_delim: commonmark_gfm_spellings.code_span_delim,
    code_fence: commonmark_gfm_spellings.code_fence,
    link_text_open: commonmark_gfm_spellings.link_text_open,
    link_text_close: commonmark_gfm_spellings.link_text_close,
    link_url_open: commonmark_gfm_spellings.link_url_open,
    link_url_close: commonmark_gfm_spellings.link_url_close,
    image_marker: commonmark_gfm_spellings.image_marker,
    table_pipe: commonmark_gfm_spellings.table_pipe,
    table_cell_pad: commonmark_gfm_spellings.table_cell_pad,
    table_align_none: commonmark_gfm_spellings.table_align_none,
    table_align_left: commonmark_gfm_spellings.table_align_left,
    table_align_center: commonmark_gfm_spellings.table_align_center,
    table_align_right: commonmark_gfm_spellings.table_align_right,
    blockquote_marker: commonmark_gfm_spellings.blockquote_marker,
    list_indent: commonmark_gfm_spellings.list_indent,
    block_separator: commonmark_gfm_spellings.block_separator,
    thematic_break: commonmark_gfm_spellings.thematic_break,
  }
}

fn tiny_list_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.UnorderedListBlock {
        items: [
          std.markdown.MarkdownListItem { blocks: [ std.markdown.ParagraphBlock { inlines: [ std.markdown.TextInline { text: "x" } ] } ] },
        ],
      },
    ],
  }
}

test fn witness_row_driven_bullet() -> Bool {
  let canonical = serialize_markdown_source_with(doc: tiny_list_doc(), sp: commonmark_gfm_spellings)
  let perturbed = serialize_markdown_source_with(doc: tiny_list_doc(), sp: test.claim.markdown_source_emit.perturbed_bullet_spellings())
  (canonical == "- x\n") && (perturbed == "+ x\n") && !(canonical == perturbed)
}

