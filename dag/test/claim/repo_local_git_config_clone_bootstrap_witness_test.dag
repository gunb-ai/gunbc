module test.claim.repo_local_git_config_clone_bootstrap

import gunbc.repo_local_git_config_clone_bootstrap {
  repo_local_git_config_clone_bootstrap_population,
  repo_local_git_config_clone_bootstrap_dissolve_on,
  repo_local_git_config_clone_bootstrap_converge_invoke_entry,
  repo_local_git_config_clone_bootstrap_converge_invoke_function,
  repo_local_git_config_clone_bootstrap_enrolled_path_count,
}

test fn clone_bootstrap_population_covers_session_and_dev() -> Bool {
  repo_local_git_config_clone_bootstrap_population.session_worktrees
    && repo_local_git_config_clone_bootstrap_population.dev_clone_setup_surface
}

test fn clone_bootstrap_points_at_modeled_converge_entry() -> Bool {
  (repo_local_git_config_clone_bootstrap_converge_invoke_function == "converge")
    && (repo_local_git_config_clone_bootstrap_converge_invoke_entry == "dag/gunbc/repo_local_git_config.dag")
}

test fn clone_bootstrap_has_enrolled_paths() -> Bool {
  repo_local_git_config_clone_bootstrap_enrolled_path_count() >= 4
}

test fn clone_bootstrap_carrier_names_dissolve_on() -> Bool {
  string_contains(
    s: repo_local_git_config_clone_bootstrap_dissolve_on,
    pattern: "observed_missing_count",
  )
}
