module test.claim.repo_local_git_config_clone_bootstrap


test fn clone_bootstrap_population_records_missing_session_worktree_enrollment() -> Bool {
  !repo_local_git_config_clone_bootstrap_population.session_worktrees
    && repo_local_git_config_clone_bootstrap_population.dev_clone_setup_surface
}

test fn clone_bootstrap_points_at_modeled_converge_entry() -> Bool {
  (gunbc.repo_local_git_config_clone_bootstrap.repo_local_git_config_clone_bootstrap_converge_invoke_function == "converge")
    && (gunbc.repo_local_git_config_clone_bootstrap.repo_local_git_config_clone_bootstrap_converge_invoke_entry == "dag/gunbc/repo_local_git_config.dag")
}

test fn clone_bootstrap_has_enrolled_paths() -> Bool {
  gunbc.repo_local_git_config_clone_bootstrap.repo_local_git_config_clone_bootstrap_enrolled_path_count() >= 4
}

