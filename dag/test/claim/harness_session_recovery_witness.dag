module test.claim.harness_session_recovery_witness

import std.types { Bool, String, List, Int, NonEmptyStr, list_length }
import std.optional { Present, Absent }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.http.header_dump { HeaderDumpRead }
import gunbc.harness.harness_turn { HarnessPostOutcome, harness_post_drew_no_response, harness_route_is_fleet_engine }
import gunbc.harness.harness_session_recovery {
  UnexplainedEngineRefusal, SessionValidation, SessionValidated, SessionInterrupted, SessionUnresumable, SessionRecoveryMalformed, SessionRecovery, SessionRecoveryNone, SessionRecoveryPending, SessionRecoveryAwaitingCapacity,
  PoolCapacityObservation, CapacityNotAsked, CapacityServing, CapacityNotServing, CapacityUnobserved,
  session_event_capacity_wait, session_event_capacity_resumed, session_capacity_wait_since_for, session_capacity_wait_budget_seconds,
  harness_unexplained_refusal, session_messages_validation, session_conversation_from_request, session_conversation_messages,
  session_event_recovery_needed, session_event_resumed, session_recovery_of_events, session_resume_bound,
}
import gunbc.harness.harness_hosted_route { BackendAdmittedBySeat, BackendAdmittedByOperatorEndpoint }
import gunbc.roadmap.roadmap_attempt_continuation {
  PriorAttemptFacts, ContinuationDecision, ContinuationResume, ContinuationEnded, ContinuationHold, ContinuationRefused, ContinuationCapacityExpired, continuation_decision,
}
import gunbc.roadmap.roadmap_submission { CaptureAbsent }
import gunbc.roadmap.roadmap_refused_retry { RefusedRetryOperatorOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RECEIPT, AS SUPPLIED VALUES (srv1 lab srv1-lab-codex-feedback-v0 at lab-dev 7acf7a3b916,
// 2026-10-16): request 38 drew HTTP 400, headers present, EMPTY body, x-request-id
// req_2ae5021ab9c56e6eb7fe1707af067e27. The conversation it carried answered every tool call of the
// last assistant message.
fn receipt_headers() -> HeaderDumpRead {
  HeaderDumpRead { text: "HTTP/1.1 400 Bad Request\r\nx-request-id: req_2ae5021ab9c56e6eb7fe1707af067e27\r\ncontent-length: 0\r\n\r\n" }
}

fn validated_request() -> String {
  "\{\"model\":\"qwen\",\"messages\":[\{\"role\":\"system\",\"content\":\"s\"},\{\"role\":\"user\",\"content\":\"u\"},\{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[\{\"id\":\"c1\",\"type\":\"function\"},\{\"id\":\"c2\",\"type\":\"function\"}]},\{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"ok\"},\{\"role\":\"tool\",\"tool_call_id\":\"c2\",\"content\":\"ok\"}]}"
}

fn interrupted_request() -> String {
  "\{\"model\":\"qwen\",\"messages\":[\{\"role\":\"system\",\"content\":\"s\"},\{\"role\":\"user\",\"content\":\"u\"},\{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[\{\"id\":\"c1\",\"type\":\"function\"},\{\"id\":\"c2\",\"type\":\"function\"}]},\{\"role\":\"tool\",\"tool_call_id\":\"c1\",\"content\":\"ok\"}]}"
}

fn refusal_of(request: String, route_qualifies: Bool, body: String) -> UnexplainedEngineRefusal? {
  harness_unexplained_refusal(
    route_qualifies: route_qualifies, success: false, body: body,
    headers: Present { value: receipt_headers() }, request_body: request,
  )
}

fn validation_of(request: String) -> SessionValidation {
  match session_conversation_from_request(request_body: request, leading_system: true) {
    Absent => SessionInterrupted { unrecorded_call_ids: ["unreadable"] }
    Present { value: conversation } => session_messages_validation(messages: session_conversation_messages(conversation: conversation))
  }
}

fn recovery_lines(request: String, rounds: Int) -> List<String> {
  match refusal_of(request: request, route_qualifies: true, body: "") {
    Absent => [] as List<String>
    Present { value: refusal } => [session_event_recovery_needed(round: rounds, refusal: refusal, validation: validation_of(request: request))]
  }
}

fn prior_with(recovery: SessionRecovery) -> PriorAttemptFacts {
  prior_observing(recovery: recovery, capacity: CapacityNotAsked)
}

fn prior_observing(recovery: SessionRecovery, capacity: PoolCapacityObservation) -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: "n1", attempt_key: "a1", branch: "dispatch/n1-a1", worker_terminal: true,
    capture: CaptureAbsent, verification: none, review: none, goal_audit: none, recovery: recovery, capacity: capacity, verification_retry: RefusedRetryOperatorOnly,
  }
}

// CLAIM 1 (RED on lab-dev: no recovery state exists). An empty-body engine refusal at a validated
// state is recovery-needed: the stream the refused turn writes reads as Pending, carrying the cause.
test fn s3_claim_1_an_empty_body_refusal_at_a_validated_state_is_recovery_needed() -> Bool {
  match refusal_of(request: validated_request(), route_qualifies: true, body: "") {
    Absent => false
    Present { value: refusal } =>
      refusal.status == 400
        && (match validation_of(request: validated_request()) { SessionValidated => true SessionInterrupted { unrecorded_call_ids: _ } => false _ => false })
        && (match session_recovery_of_events(lines: recovery_lines(request: validated_request(), rounds: 38)) {
          SessionRecoveryPending { causes, resumes_made, interrupted_calls, resume_round } =>
            resumes_made == 0 && resume_round == 38 && list_length(items: interrupted_calls) == 0
              && any(causes, c => c.contains("req_2ae5021ab9c56e6eb7fe1707af067e27"))
          SessionRecoveryNone => false
          SessionRecoveryAwaitingCapacity { cause: _, since: _, budget_seconds: _, resumes_made: _, capacity_resumes: _, interrupted_calls: _, resume_round: _ } => false
          SessionRecoveryMalformed { mismatch: _ } => false
        })
  }
}

// CLAIM 2 (RED on lab-dev: the decision answered Ended). The decision over a recovery-needed prior
// resumes the SAME attempt's session; it neither mints a new attempt nor ends the lineage.
test fn s3_claim_2_a_recovery_needed_prior_resumes_the_same_session() -> Bool {
  match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: recovery_lines(request: validated_request(), rounds: 38))) }) {
    ContinuationResume { reason: _, attempt_key, ordinal, causes } => attempt_key == "a1" && ordinal == 1 && list_length(items: causes) == 1
    _ => false
  }
}

// CLAIM 3 (control). A tool call with no recorded result keeps the session recovery-needed and
// refuses resume: the decision holds and names the unrecorded call.
test fn s3_claim_3_an_interrupted_effect_is_recovery_needed_and_not_resumable() -> Bool {
  match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: recovery_lines(request: interrupted_request(), rounds: 7))) }) {
    ContinuationHold { reason } => reason.contains("c2") && reason.contains("not resumable")
    _ => false
  }
}

// CLAIM 4 (control, green on both). A worker that handed in nothing, with no backend failure recorded,
// still ends the lineage; so does a refusal on a hosted-quota route, and one that explained itself.
test fn s3_claim_4_nothing_handed_in_and_no_refusal_still_ends_the_lineage() -> Bool {
  (match continuation_decision(prior: Present { value: prior_with(recovery: SessionRecoveryNone) }) {
    ContinuationEnded { reason: _ } => true
    _ => false
  })
    && (match refusal_of(request: validated_request(), route_qualifies: false, body: "") { Absent => true Present { value: _ } => false })
    && (match refusal_of(request: validated_request(), route_qualifies: true, body: "\{\"error\":\"context length exceeded\"}") { Absent => true Present { value: _ } => false })
}

// CLAIM 5 (control). Past the bound the lineage ends and lists every recorded cause.
test fn s3_claim_5_past_the_resume_bound_the_lineage_ends_with_every_cause() -> Bool {
  let needed = recovery_lines(request: validated_request(), rounds: 38)
  let resumed = [session_event_resumed(ordinal: 1, round: 38, cause: "c")]
  let lines = concat(concat(concat(needed, resumed), concat(concat(needed, resumed), concat(needed, resumed))), needed)
  session_resume_bound == 3
    && (match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: lines)) }) {
      ContinuationEnded { reason } => reason.contains("every recorded cause") && reason.contains("bound of 3")
      _ => false
    })
    && (match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: concat(concat(needed, resumed), concat(needed, resumed)) |> concat(needed))) }) {
      ContinuationResume { reason: _, attempt_key: _, ordinal, causes: _ } => ordinal == 3
      _ => false
    })
}

// CLAIM 6 (inhabitance). The real post path hands the classifier a HarnessPostOutcome; the receipt's
// shape -- unsuccessful, empty body, headers read -- is the shape harness_send_round passes, it is
// NOT a request that drew no response (so it is never retried in place), and only the fleet's own
// routes qualify.
test fn s3_claim_6_the_real_post_path_shape_for_the_empty_400_is_classified_not_retried() -> Bool {
  let posted = HarnessPostOutcome { body: "", success: false, headers: Present { value: receipt_headers() }, retries: [] as List<String> }
  !harness_post_drew_no_response(posted: posted)
    && (match harness_unexplained_refusal(route_qualifies: true, success: posted.success, body: posted.body, headers: posted.headers, request_body: validated_request()) {
      Present { value: r } => r.status == 400 && r.request_id == Present { value: "req_2ae5021ab9c56e6eb7fe1707af067e27" }
      Absent => false
    })
    && harness_route_is_fleet_engine(access: BackendAdmittedBySeat)
    && harness_route_is_fleet_engine(access: BackendAdmittedByOperatorEndpoint { header_file: "h" as NonEmptyStr })
}

fn is_unresumable(v: SessionValidation) -> Bool {
  match v { SessionUnresumable { cause: _ } => true SessionValidated => false SessionInterrupted { unrecorded_call_ids: _ } => false }
}

fn request_of(messages: String) -> String {
  concat(concat("\{\"model\":\"qwen\",\"messages\":[\{\"role\":\"system\",\"content\":\"s\"},", messages), "]}")
}

// CLAIM 7 (review 81292). A duplicated member is MALFORMED, not absent: a duplicated tool_calls or
// a duplicated call id cannot be read as "the assistant called nothing", so the state is unresumable.
test fn s3_claim_7_a_duplicated_member_is_unresumable_not_validated() -> Bool {
  let dup_calls = request_of(messages: "\{\"role\":\"user\",\"content\":\"u\"},\{\"role\":\"assistant\",\"tool_calls\":[\{\"id\":\"c1\"}],\"tool_calls\":[\{\"id\":\"c2\"}]},\{\"role\":\"tool\",\"tool_call_id\":\"c1\"}")
  let dup_id = request_of(messages: "\{\"role\":\"user\",\"content\":\"u\"},\{\"role\":\"assistant\",\"tool_calls\":[\{\"id\":\"c1\",\"id\":\"c2\"}]},\{\"role\":\"tool\",\"tool_call_id\":\"c1\"}")
  is_unresumable(v: validation_of(request: dup_calls)) && is_unresumable(v: validation_of(request: dup_id))
}

// CLAIM 8 (review 81292). A non-string call id is malformed, not dropped.
test fn s3_claim_8_a_non_string_call_id_is_unresumable_not_dropped() -> Bool {
  is_unresumable(v: validation_of(request: request_of(messages: "\{\"role\":\"user\",\"content\":\"u\"},\{\"role\":\"assistant\",\"tool_calls\":[\{\"id\":7}]},\{\"role\":\"user\",\"content\":\"x\"}")))
}

// CLAIM 9 (review 81292). Messages present but no assistant message is unresumable, not validated.
test fn s3_claim_9_no_assistant_message_is_unresumable_not_validated() -> Bool {
  is_unresumable(v: validation_of(request: request_of(messages: "\{\"role\":\"user\",\"content\":\"u\"}")))
}

// CLAIM 10 (review 81292). A turn.recovery_needed line without a cause member refuses typed -- the
// stream reads Malformed and the decision refuses -- and never fabricates a cause.
test fn s3_claim_10_a_recovery_needed_line_without_a_cause_refuses_typed() -> Bool {
  let line = "\{\"type\":\"turn.recovery_needed\",\"round\":4,\"interrupted_calls\":[]}"
  (match session_recovery_of_events(lines: [line]) { SessionRecoveryMalformed { mismatch } => mismatch.contains("cause") _ => false })
    && (match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: [line])) }) {
      ContinuationRefused { reason } => reason.contains("cause")
      _ => false
    })
}

// POOL-FRONT-ROUTE-1. A turn held by the front's 503 is a CAPACITY WAIT: its own event kind, its own tally, its own
// recorded budget, woken by a capacity observation. It never spends session_resume_bound, which counts unexplained
// engine refusals only.
fn wait_lines(request: String, round: Int, since: Int) -> List<String> {
  [session_event_capacity_wait(round: round, held: 3, since: since, validation: validation_of(request: request), status: 503)]
}

fn waiting_recovery(lines: List<String>) -> SessionRecovery {
  session_recovery_of_events(lines: lines)
}

fn decision_observing(lines: List<String>, capacity: PoolCapacityObservation) -> ContinuationDecision {
  continuation_decision(prior: Present { value: prior_observing(recovery: waiting_recovery(lines: lines), capacity: capacity) })
}

test fn pool_claim_a_503_held_turn_is_a_capacity_wait_that_holds_without_spending_a_resume() -> Bool {
  let lines = wait_lines(request: validated_request(), round: 12, since: 1000)
  (match waiting_recovery(lines: lines) {
    SessionRecoveryAwaitingCapacity { cause, since, budget_seconds, resumes_made, capacity_resumes, interrupted_calls: _, resume_round } =>
      resumes_made == 0 && capacity_resumes == 0 && resume_round == 12 && since == 1000 && budget_seconds == session_capacity_wait_budget_seconds
        && cause.contains("503") && cause.contains("no TLS card")
    _ => false
  }) && (match decision_observing(lines: lines, capacity: CapacityNotServing { at: 1060 }) {
    ContinuationHold { reason } => reason.contains("no resume is spent")
    _ => false
  })
}

// RED on e9ed7e4de1: there the fourth 503 hold read Ended with every cause, the lineage lost to a TLS-card outage.
// Here N consecutive holds (N = 5, past session_resume_bound = 3), each woken and held again at the same round, leave
// the S3 tally at zero and the lineage waiting.
test fn pool_claim_consecutive_503_holds_past_the_resume_bound_do_not_end_the_lineage() -> Bool {
  let wait = wait_lines(request: validated_request(), round: 12, since: 1000)
  let woken = [session_event_capacity_resumed(ordinal: 1, round: 12)]
  let lines = concat(concat(concat(wait, woken), concat(concat(wait, woken), concat(wait, woken))), concat(concat(wait, woken), wait))
  session_resume_bound == 3
    && (match waiting_recovery(lines: lines) {
      SessionRecoveryAwaitingCapacity { cause: _, since: _, budget_seconds: _, resumes_made, capacity_resumes, interrupted_calls: _, resume_round: _ } => resumes_made == 0 && capacity_resumes == 4
      _ => false
    })
    && (match decision_observing(lines: lines, capacity: CapacityNotServing { at: 1100 }) {
      ContinuationHold { reason } => reason.contains("waiting for capacity")
      _ => false
    })
}

// A capacity observation wakes the resume of the SAME attempt (so the same conversation and x-pool-session), numbered
// after every earlier resume of either kind, and the S3 bound is untouched by it.
test fn pool_claim_a_capacity_observation_wakes_the_same_session() -> Bool {
  let wait = wait_lines(request: validated_request(), round: 12, since: 1000)
  let woken = [session_event_capacity_resumed(ordinal: 1, round: 12)]
  let lines = concat(concat(wait, woken), wait)
  (match decision_observing(lines: lines, capacity: CapacityServing { at: 1500 }) {
    ContinuationResume { reason, attempt_key, ordinal, causes: _ } => attempt_key == "a1" && ordinal == 2 && reason.contains("is not spent")
    _ => false
  }) && (match waiting_recovery(lines: concat(lines, [session_event_capacity_resumed(ordinal: 2, round: 12)])) {
    SessionRecoveryNone => true
    _ => false
  })
}

// A capacity that is serving resumes however long the wait lasted; only continued absence past the recorded budget
// reaches the wait's own terminal, which is not Ended and not Refused. An observation that could not be made, or was
// not asked, refuses rather than guessing either answer.
test fn pool_claim_a_wait_past_its_budget_reaches_its_own_typed_terminal() -> Bool {
  let lines = wait_lines(request: validated_request(), round: 12, since: 1000)
  let past = 1000 + session_capacity_wait_budget_seconds + 1
  (match decision_observing(lines: lines, capacity: CapacityNotServing { at: past }) {
    ContinuationCapacityExpired { reason, waited_seconds, budget_seconds } =>
      waited_seconds == session_capacity_wait_budget_seconds + 1 && budget_seconds == session_capacity_wait_budget_seconds && reason.contains("the session was not refused by the engine")
    _ => false
  }) && (match decision_observing(lines: lines, capacity: CapacityNotServing { at: 1000 + session_capacity_wait_budget_seconds }) {
    ContinuationHold { reason: _ } => true
    _ => false
  }) && (match decision_observing(lines: lines, capacity: CapacityServing { at: past }) {
    ContinuationResume { reason: _, attempt_key: _, ordinal: _, causes: _ } => true
    _ => false
  }) && (match decision_observing(lines: lines, capacity: CapacityUnobserved { reason: "key rejected" }) {
    ContinuationRefused { reason } => reason.contains("key rejected")
    _ => false
  }) && (match decision_observing(lines: lines, capacity: CapacityNotAsked) {
    ContinuationRefused { reason: _ } => true
    _ => false
  })
}

// Re-holding the same round does not restart the budget; a later round opens a window of its own. A wait with an
// interrupted tool effect holds as not resumable whatever the front says.
test fn pool_claim_a_rehold_keeps_the_window_and_an_interrupted_effect_still_holds() -> Bool {
  let first = wait_lines(request: validated_request(), round: 12, since: 1000)
  let lines = concat(concat(first, [session_event_capacity_resumed(ordinal: 1, round: 12)]), wait_lines(request: validated_request(), round: 12, since: 5000))
  session_capacity_wait_since_for(lines: first, round: 12, now: 5000) == 1000
    && session_capacity_wait_since_for(lines: first, round: 13, now: 5000) == 5000
    && (match waiting_recovery(lines: lines) {
      SessionRecoveryAwaitingCapacity { cause: _, since, budget_seconds: _, resumes_made: _, capacity_resumes: _, interrupted_calls: _, resume_round: _ } => since == 1000
      _ => false
    })
    && (match decision_observing(lines: wait_lines(request: interrupted_request(), round: 7, since: 1000), capacity: CapacityServing { at: 2000 }) {
      ContinuationHold { reason } => reason.contains("c2") && reason.contains("not resumable")
      _ => false
    })
}

// The S3 count bound is unchanged for unexplained refusals, even interleaved with capacity waits.
test fn pool_claim_capacity_waits_do_not_move_the_s3_bound() -> Bool {
  let needed = recovery_lines(request: validated_request(), rounds: 38)
  let resumed = [session_event_resumed(ordinal: 1, round: 38, cause: "c")]
  let waited = concat(wait_lines(request: validated_request(), round: 40, since: 1), [session_event_capacity_resumed(ordinal: 1, round: 40)])
  let lines = concat(concat(concat(needed, resumed), waited), concat(concat(concat(needed, resumed), waited), concat(concat(needed, resumed), concat(waited, needed))))
  match continuation_decision(prior: Present { value: prior_with(recovery: session_recovery_of_events(lines: lines)) }) {
    ContinuationEnded { reason } => reason.contains("every recorded cause") && reason.contains("bound of 3")
    _ => false
  }
}
