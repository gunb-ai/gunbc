module test.claim.shared_type_leaf_collision_census_witness

import gunbc.instruments.shared_type_leaf_collision_census {
  CollisionSharing, SameSharing, DifferentSharing,
  RustcGrade, RustcNotAttempted,
  LeafCollisionRow,
  collision_sharing_of,
  red_fixture_flags_different_sharing,
  green_fixture_has_no_collision
}

fn copy_pair() -> List<Bool> {
  [false, false]
}

fn share_and_copy() -> List<Bool> {
  [true, false]
}

fn different_row() -> LeafCollisionRow {
  LeafCollisionRow {
    leaf: "Word64",
    declarers: ["stlc.copy_word.Word64", "stlc.shared_word.Word64"],
    would_share: share_and_copy(),
    sharing: DifferentSharing,
    rustc: RustcNotAttempted
  }
}

test fn two_declarers_of_one_leaf_with_unequal_sharing_are_different_sharing() -> Bool {
  collision_sharing_of(would_share: share_and_copy()) == DifferentSharing
}

test fn two_declarers_of_one_leaf_with_equal_sharing_are_same_sharing() -> Bool {
  collision_sharing_of(would_share: copy_pair()) == SameSharing
}

test fn a_supplied_different_sharing_row_is_the_red_control_shape() -> Bool {
  red_fixture_flags_different_sharing(rows: [different_row()])
}

test fn an_empty_collision_list_is_the_green_control_shape() -> Bool {
  green_fixture_has_no_collision(rows: [])
}
