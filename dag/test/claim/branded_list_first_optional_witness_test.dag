module test.claim.branded_list_first_optional_witness


fn hash_list() -> List<std.content_hash.ContentHash> {
  [content_hash_of_value(value: "a" as std.types.NonEmptyStr)]
}

fn empty_hash_list() -> List<std.content_hash.ContentHash> {
  []
}

fn string_list() -> List<String> {
  ["hello"]
}

fn empty_string_list() -> List<String> {
  []
}

test fn branded_list_first_content_hash_method_nonempty() -> Bool {
  match hash_list().first() {
    Present { value: h } =>
      match h {
        std.content_hash.Fnv1a64(left) =>
          match content_hash_of_value(value: "a" as std.types.NonEmptyStr) {
            std.content_hash.Fnv1a64(right) => content_hash_eq_structural(left: left, right: right)
            Sha256Hash(_) => false
            Sha1Hash(_) => false
            Sha512Hash(_) => false
          }
        Sha256Hash(_) => false
        Sha1Hash(_) => false
        Sha512Hash(_) => false
      }
    Absent => false
  }
}

test fn branded_list_first_content_hash_method_empty() -> Bool {
  match empty_hash_list().first() {
    Present { value: _ } => false
    Absent => true
  }
}

test fn branded_list_first_string_method_nonempty() -> Bool {
  match string_list().first() {
    Present { value: s } => s == "hello"
    Absent => false
  }
}

test fn branded_list_first_string_method_empty() -> Bool {
  match empty_string_list().first() {
    Present { value: _ } => false
    Absent => true
  }
}

test fn branded_list_first_content_hash_pipe_nonempty() -> Bool {
  match hash_list() |> first {
    Present { value: h } =>
      match h {
        std.content_hash.Fnv1a64(left) =>
          match content_hash_of_value(value: "a" as std.types.NonEmptyStr) {
            std.content_hash.Fnv1a64(right) => content_hash_eq_structural(left: left, right: right)
            Sha256Hash(_) => false
            Sha1Hash(_) => false
            Sha512Hash(_) => false
          }
        Sha256Hash(_) => false
        Sha1Hash(_) => false
        Sha512Hash(_) => false
      }
    Absent => false
  }
}

test fn branded_list_first_content_hash_pipe_empty() -> Bool {
  match empty_hash_list() |> first {
    Present { value: _ } => false
    Absent => true
  }
}

test fn branded_list_first_string_pipe_nonempty() -> Bool {
  match string_list() |> first {
    Present { value: s } => s == "hello"
    Absent => false
  }
}

test fn branded_list_first_string_pipe_empty() -> Bool {
  match empty_string_list() |> first {
    Present { value: _ } => false
    Absent => true
  }
}
