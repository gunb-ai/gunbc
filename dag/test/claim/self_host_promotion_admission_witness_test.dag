        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault_on(
        subject: pa_candidate_identity(),
        corpus: BehavioralCorpus {
          identity: "SOME-OTHER-corpus",
          expected_cases: pa_corpus_cases
        },
        outcome: ObservationPresent { value: FaultCaught }
