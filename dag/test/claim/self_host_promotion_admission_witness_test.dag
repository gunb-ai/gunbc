    identity: pa_candidate_identity(),
    produced_by_seed: other_seed
  }
  let o = admit_promotion(
    c: v2.compiler.self_host.promotion_admission.SelfHostCandidate {
      candidate: pa_candidate(),
      successor: v2.compiler.self_host.generation.SuccessorGeneration {
        identity: pa_successor_identity(),
        produced_by_candidate: homonym_candidate
      },
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    }
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_successor_not_produced_by_candidate
    )
}

// DISCRIMINATING RED for the population join, and the exact shape that promoted before
// it existed: both receipts name the corpus, both report agreement, both are fresh, and
// the successor compared ONE case where the corpus declares ten. A partially emitted
// compiler produces precisely this — it runs, it agrees on what it reached, and it never
// reached the rest. Under the label-only join the two receipts agreed and the bundle was
// admitted; the count sat beside the name proving nothing.
test fn truncated_successor_run_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: 1,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_corpus_population_mismatch)
}

// The mirror: a run comparing MORE cases than its corpus declares did not execute the
// corpus it names. Refusing only the truncation would let the bar be raised silently by
// whatever the runner happened to do, which is the same unjoined-number defect pointing
// the other way.
test fn overlong_run_against_its_declared_corpus_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases + 5,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_corpus_population_mismatch)
}

// DISCRIMINATING RED for the second half of the corpus join. Both receipts name the SAME
// corpus and each runs exactly the population IT declares, so every per-receipt check
// passes and the label join passes — yet the two ran different corpora under one name.
// Joining identity alone admits this; joining the declared size too refuses it.
test fn same_named_corpus_declaring_two_sizes_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence_on(
        subject: pa_successor_identity(),
        corpus: pa_corpus(expected: 3),
        cases: 3,
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: v2.compiler.self_host.promotion_admission.Observed { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_corpus_mismatch_across_receipts
    )
}

// The observation → receipt seam. A transport observes outcomes; it does not name the
// generation it measured. These prove the projections carry the observed verdict and the
// declared corpus through unchanged, so a transport cannot quietly improve its own
// evidence on the way into a receipt.
fn pa_observation(
  build: ObservedVerdict<v2.compiler.self_host.promotion_admission.BuildOutcome>,
  equivalence: ObservedVerdict<v2.compiler.self_host.promotion_admission.EquivalenceOutcome>,
  fault: ObservedVerdict<v2.compiler.self_host.promotion_admission.FaultOutcome>
) -> v2.compiler.self_host.promotion_admission.BehavioralComparisonObservation {
  v2.compiler.self_host.promotion_admission.BehavioralComparisonObservation {
    corpus: pa_corpus(expected: pa_corpus_cases),
    cases_compared: pa_corpus_cases,
    build: build,
    equivalence: equivalence,
    fault: fault
  }
}

fn pa_bundle_from_observation(
  o: v2.compiler.self_host.promotion_admission.BehavioralComparisonObservation
) -> v2.compiler.self_host.promotion_admission.SelfHostCandidate {
  pa_bundle(
    candidate_build: build_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity()
    ),
    successor_build: build_receipt_from_observation(
      o: o,
      subject: pa_successor_identity()
    ),
    candidate_equivalence: equivalence_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity(),
      oracle: pa_seed_identity()
    ),
    successor_equivalence: equivalence_receipt_from_observation(
      o: o,
      subject: pa_successor_identity(),
      oracle: pa_seed_identity()
    ),
    discriminating_fault: fault_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity(),
      planted_fault: "classical_not called on mismatched input"
    ),
    candidate_provenance: pa_provenance(
      subject: pa_candidate_identity(),
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: pa_candidate_identity()
    )
  )
}

// The positive control: a fully observed run, projected into receipts, is admitted. It
// is what makes the two REDs below discriminating rather than a mechanism that refuses
// everything routed through the seam.
test fn fully_observed_run_projects_into_an_admitted_promotion() -> Bool {
  pa_admitted(
    o: admit_promotion(
      c: pa_bundle_from_observation(
        o: pa_observation(
          build: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen },
          equivalence: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees },
          fault: v2.compiler.self_host.promotion_admission.Observed { value: FaultCaught }
        )
      )
    )
  )
}

// DISCRIMINATING RED. This is the shape the transport's superseded conjunction produced
// whenever the planted-fault process died for its own reasons: the run was nonzero, the
// fault was never reported, and the old test read the exit code as proof of teeth. Routed
// through the seam as the unavailable observation it actually is, admission refuses under
// its own name instead of inheriting a verdict from an exit status.
test fn unreported_fault_observation_refuses_through_the_seam() -> Bool {
  let o = admit_promotion(
    c: pa_bundle_from_observation(
      o: pa_observation(
        build: v2.compiler.self_host.promotion_admission.Observed { value: v2.compiler.self_host.promotion_admission.BuildGreen },
        equivalence: v2.compiler.self_host.promotion_admission.Observed { value: BehaviorAgrees },
        fault: v2.compiler.self_host.promotion_admission.ObservationUnavailable { cause: ^slb_fault_run_unreported }
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_receipt_observation_unavailable
    )
}

// DISCRIMINATING RED for the other half: a build that did not happen cannot yield a
// behavioral verdict, and the observation says so rather than reporting agreement over a
// comparison that never ran.
test fn unbuilt_run_refuses_through_the_seam() -> Bool {
  let o = admit_promotion(
    c: pa_bundle_from_observation(
      o: pa_observation(
        build: v2.compiler.self_host.promotion_admission.ObservationUnavailable { cause: ^slb_stage_incomplete },
        equivalence: v2.compiler.self_host.promotion_admission.ObservationUnavailable { cause: ^slb_comparison_did_not_run },
        fault: v2.compiler.self_host.promotion_admission.ObservationUnavailable { cause: ^slb_fault_run_did_not_run }
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_receipt_observation_unavailable
    )
}
