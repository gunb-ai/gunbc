        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_corpus_mismatch_across_receipts
    )
}

// DISCRIMINATING RED for the homonym splice (review 51231). The successor's declared
// producer has the SAME identity as the bundled candidate but descends from a
// DIFFERENT seed. An identity-only chain join admits this; joining the whole declared
// producer refuses it. Without this control the bypass is unwitnessed.
test fn same_identity_different_seed_splice_is_refused() -> Bool {
  let other_seed = SeedGeneration {
