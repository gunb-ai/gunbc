module test.claim.self_host_promotion_admission_witness

import v2.compiler.self_host.generation {
  GeneratedArtifactIdentity,
  ArtifactMaterialized,
  ArtifactNotMaterialized,
  observed_artifact_digest,
  CandidateGeneration,
  GenerationIdentity,
  SeedGeneration,
  SuccessorGeneration
}
import v2.compiler.self_host.promotion_admission {
  GenerationLensCoverage,
  BehaviorAgrees,
  BehaviorDiverges,
  BehavioralComparisonObservation,
  BehavioralCorpus,
  BehavioralEquivalenceReceipt,
  BuildFailed,
  BuildGreen,
  BuildOutcome,
  BuildReceipt,
  DiscriminatingFaultReceipt,
  EquivalenceOutcome,
  FaultCaught,
  FaultNotCaught,
  FaultOutcome,
  GenerationProvenanceReceipt,
  ObservationPresent,
  ObservationUnavailable,
  ObservationAvailability,
  PromotionOutcome,
  SelfHostCandidate,
  admit_promotion,
  build_receipt_from_observation,
  equivalence_receipt_from_observation,
  fault_receipt_from_observation,
  Promoted,
  PromotionRefused,
  promotion_refusal_carries
}
import v2.compiler.compile {
  CompileLens,
  CompileLensRoot,
  CompileLensSubtree,
  RequiredLensCoverageClosed,
  RequiredLensCoverageRefused,
  RequiredLensCoverageRow,
  RequiredLensRosterEmpty,
  required_lens_roster_digest_of
}
import std.decl_ref { DeclarationRef, decl_ref }
import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.diagnostic { outcome_accepted }
import v2.std.node { Atom, Node, TypeNode }
import v2.std.witness { Holds }
import v2.std.collection { List }
import v2.std.logic { Bool }
import v2.std.node { Hash, symbol_identity_digest }
import v2.std.optional { Absent, Present }
import std.content_hash { content_hash_of_value, sha512_hex_digest }
import std.types { NonEmptyStr }

// Test-side projection. The authority carrier deliberately exposes no is_* Bool over
// PromotionOutcome (review 51217, predicate-dissolution): a witness must return Bool,
// so the collapse belongs here, at the assertion boundary, not on the admission API.
fn pa_admitted(o: PromotionOutcome) -> Bool {
  match o {
    Promoted { successor: _, cases_compared: _ } => true
    PromotionRefused { causes: _ } => false
  }
}

fn pa_artifact(hex: String) -> GeneratedArtifactIdentity {
  match sha512_hex_digest(hex: hex) {
    Present { value: d } =>
      ArtifactMaterialized { digest: observed_artifact_digest(observed: d) }
    Absent => ArtifactNotMaterialized
  }
}

data pa_seed_artifact_hex: String = "36356c8cc805d9d4a762991f9059d3687ef70fd1786b2d90f2806fcad0f9ce916d80cd3220ebf6f13d19df404740ca849cda38a6632cd0c2f92689e3bec80505"

data pa_candidate_artifact_hex: String = "8913ea1d5983297e05f1c0ca75a7f85d551f308ee3cc4f6123ff74980198feb88c08a0167fd6a74b4994b8d9febcec5f8cb7c2132368349b5e9dc1bd86ce8458"

data pa_successor_artifact_hex: String = "cf931ac453463355533c6e57f0bc87105ef261954875975dfcf463e4fcbf9af0f94c76a2bd7f538e84f3264cfaa5291f3b63f34ffd2f6f09214c329d5688c895"

fn pa_digest(label: String) -> Hash {
  symbol_identity_digest(sym: label)
}

fn pa_identity(closure_label: String, artifact_hex: String) -> GenerationIdentity {
  GenerationIdentity {
    producer_compiler: pa_digest(label: "producer-compiler"),
    source_closure: pa_digest(label: closure_label),
    target_model: pa_digest(label: "target-model-rust"),
    toolchain: pa_digest(label: "toolchain-pinned"),
    build_configuration: pa_digest(label: "build-config-release"),
    required_lens_contract: pa_contract_axis(),
    materialized_artifact: pa_artifact(hex: artifact_hex)
  }
}

fn pa_seed_identity() -> GenerationIdentity {
  pa_identity(closure_label: "seed-closure", artifact_hex: pa_seed_artifact_hex)
}

// The candidate's source closure DELIBERATELY differs from the seed's. That is the
// normal, expected case for a real self-host candidate: it emits its own source.
fn pa_candidate_identity() -> GenerationIdentity {
  pa_identity(
    closure_label: "candidate-closure-DIFFERENT-FROM-SEED",
    artifact_hex: pa_candidate_artifact_hex
  )
}

fn pa_successor_identity() -> GenerationIdentity {
  pa_identity(
    closure_label: "successor-closure",
    artifact_hex: pa_successor_artifact_hex
  )
}

// A GENUINELY byte-identical generation: one identity value, so producer compiler,
// source closure, target model, toolchain, build configuration AND artifact digest
// are all equal across seed, candidate and successor. A byte comparison of emitted
// source would report a perfect fixed point here.
fn pa_identical_identity() -> GenerationIdentity {
  pa_identity(closure_label: "seed-closure", artifact_hex: pa_seed_artifact_hex)
}

fn pa_identical_candidate() -> CandidateGeneration {
  CandidateGeneration {
    identity: pa_identical_identity(),
    produced_by_seed: SeedGeneration { identity: pa_identical_identity() }
  }
}

fn pa_seed() -> SeedGeneration {
  SeedGeneration { identity: pa_seed_identity() }
}

fn pa_candidate() -> CandidateGeneration {
  CandidateGeneration {
    identity: pa_candidate_identity(),
    produced_by_seed: pa_seed()
  }
}

fn pa_successor() -> SuccessorGeneration {
  SuccessorGeneration {
    identity: pa_successor_identity(),
    produced_by_candidate: pa_candidate()
  }
}

fn pa_build(
  subject: GenerationIdentity,
  outcome: ObservationAvailability<BuildOutcome>
) -> BuildReceipt {
  BuildReceipt { subject: subject, outcome: outcome }
}

// classical_not over 2 inputs, plus classical_and and classical_or over 4 pairs each:
// 2 + 4 + 4, the population dag/gunbc/instruments/self_host_logic_behavioral_transport actually
// walks — measured by compiling its driver and reading the count the driver reports,
// not by counting the loops in the source.
data pa_corpus_cases: Int = 10

fn pa_corpus(expected: Int) -> BehavioralCorpus {
  BehavioralCorpus {
    identity: "std-logic-classical-truth-table",
    expected_cases: expected
  }
}

// The ordinary fixture runs exactly the corpus it declares. Every witness that means
// to disturb the population says so by calling the _on form, so a bundle drifting off
// its declared corpus is visible at the call site rather than hidden in a default.
fn pa_equivalence(
  subject: GenerationIdentity,
  cases: Int,
  outcome: ObservationAvailability<EquivalenceOutcome>
) -> BehavioralEquivalenceReceipt {
  pa_equivalence_on(
    subject: subject,
    corpus: pa_corpus(expected: pa_corpus_cases),
    cases: cases,
    outcome: outcome
  )
}

fn pa_equivalence_on(
  subject: GenerationIdentity,
  corpus: BehavioralCorpus,
  cases: Int,
  outcome: ObservationAvailability<EquivalenceOutcome>
) -> BehavioralEquivalenceReceipt {
  BehavioralEquivalenceReceipt {
    subject: subject,
    oracle: pa_seed_identity(),
    corpus: corpus,
    cases_compared: cases,
    outcome: outcome
  }
}

fn pa_fault(
  subject: GenerationIdentity,
  outcome: ObservationAvailability<FaultOutcome>
) -> DiscriminatingFaultReceipt {
  pa_fault_on(
    subject: subject,
    corpus: pa_corpus(expected: pa_corpus_cases),
    outcome: outcome
  )
}

fn pa_fault_on(
  subject: GenerationIdentity,
  corpus: BehavioralCorpus,
  outcome: ObservationAvailability<FaultOutcome>
) -> DiscriminatingFaultReceipt {
  DiscriminatingFaultReceipt {
    subject: subject,
    corpus: corpus,
    planted_fault: "classical_not called on mismatched input",
    outcome: outcome
  }
}

fn pa_provenance(
  subject: GenerationIdentity,
  producer: GenerationIdentity
) -> GenerationProvenanceReceipt {
  GenerationProvenanceReceipt { subject: subject, producer: producer }
}

// THE FIXTURE IDENTITIES CITE DECLARATIONS THAT EXIST, which is not a detail: they first cited
// `v2.test.promotion_lens.alpha` and `.beta`, modules invented for the fixture, and the required-ci
// DECLARATIONS phase refused the run with CITED-MODULE-ABSENT. A DeclarationRef is a citation
// whether or not anything dereferences it. They now name this file's own two fixture declarations.
// Worth knowing: claim_batch does not run the declarations phase, so a fabricated module path passes
// every local witness and fails only on a real required-ci run.
fn pa_lens_alpha() -> CompileLens {
  CompileLens {
    identity: decl_ref(
      module_path: "test.claim.self_host_promotion_admission_witness",
      decl_name: "pa_lens_alpha"
    ),
    grain: CompileLensRoot,
    gate: fn(tree) { outcome_accepted(value: Holds { value: pa_lens_probe_node }) }
  }
}

fn pa_lens_beta() -> CompileLens {
  CompileLens {
    identity: decl_ref(
      module_path: "test.claim.self_host_promotion_admission_witness",
      decl_name: "pa_lens_beta"
    ),
    grain: CompileLensRoot,
    gate: fn(tree) { outcome_accepted(value: Holds { value: pa_lens_probe_node }) }
  }
}

data pa_lens_probe_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^pa_lens_probe } },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

// THE CONTRACT THE CANDIDATE IDENTITY COMMITS TO. `pa_candidate_identity` carries
// `required_lens_contract` as the axis digest of exactly these two registrations, so material that
// matches it is BOUND and material that does not is refused without being folded. This is the fact
// the submitter cannot choose: the axis lives on the generation being promoted.
fn pa_contract_material() -> List<CompileLens> {
  [pa_lens_alpha(), pa_lens_beta()]
}

// THE AXIS THE FIXTURE IDENTITIES COMMIT TO, derived from the fixture material through the same
// authority promotion uses. Authoring a literal here would make the binding check compare two
// values this file chose, which is the defect the check exists to catch.
fn pa_contract_axis() -> Hash {
  content_hash_of_value(value: required_lens_roster_digest_of(lenses: pa_contract_material()) as NonEmptyStr)
}

// A SUBTREE-GRAIN REGISTRATION, AND AN IDENTITY THAT COMMITS TO IT. The grain witness cannot simply
// perturb the material of the existing candidate: changing the material changes its derived digest,
// so the BINDING would refuse first and the grain check would never be reached. So this contract has
// its own identity whose axis is the digest of THIS material, which leaves the binding satisfied and
// the grain the only thing left to disagree about.
fn pa_lens_beta_subtree() -> CompileLens {
  CompileLens {
    identity: decl_ref(
      module_path: "test.claim.self_host_promotion_admission_witness",
      decl_name: "pa_lens_beta"
    ),
    grain: CompileLensSubtree,
    gate: fn(tree) { outcome_accepted(value: Holds { value: pa_lens_probe_node }) }
  }
}

fn pa_subtree_material() -> List<CompileLens> {
  [pa_lens_alpha(), pa_lens_beta_subtree()]
}

fn pa_subtree_contract_axis() -> Hash {
  content_hash_of_value(value: required_lens_roster_digest_of(lenses: pa_subtree_material()) as NonEmptyStr)
}

fn pa_candidate_identity_subtree() -> GenerationIdentity {
  GenerationIdentity {
    producer_compiler: pa_candidate_identity().producer_compiler,
    source_closure: pa_candidate_identity().source_closure,
    target_model: pa_candidate_identity().target_model,
    toolchain: pa_candidate_identity().toolchain,
    build_configuration: pa_candidate_identity().build_configuration,
    required_lens_contract: pa_subtree_contract_axis(),
    materialized_artifact: pa_candidate_identity().materialized_artifact
  }
}

fn pa_coverage_row(lens: CompileLens) -> RequiredLensCoverageRow {
  RequiredLensCoverageRow { lens: lens.identity, grain: lens.grain, observations: 1 }
}

fn pa_coverage_for(
  subject: GenerationIdentity,
  material: List<CompileLens>,
  observed: RequiredLensCoverage
) -> GenerationLensCoverage {
  GenerationLensCoverage { subject: subject, contract_material: material, observed: observed }
}

fn pa_closed_over(material: List<CompileLens>) -> RequiredLensCoverage {
  RequiredLensCoverageClosed {
    roster_digest: required_lens_roster_digest_of(lenses: material),
    rows: fold_list(
      xs: material,
      empty: [],
      cons: fn(acc, lens) { list_snoc_item(xs: acc, item: pa_coverage_row(lens: lens)) }
    )
  }
}

fn pa_coverage_closed() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity(),
    material: pa_contract_material(),
    observed: pa_closed_over(material: pa_contract_material())
  )
}

fn pa_coverage_closed_for(subject: GenerationIdentity) -> GenerationLensCoverage {
  pa_coverage_for(
    subject: subject,
    material: pa_contract_material(),
    observed: pa_closed_over(material: pa_contract_material())
  )
}

// CLOSED AND SHORT: bound material, but the join closed over only alpha.
fn pa_coverage_missing_beta() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity(),
    material: pa_contract_material(),
    observed: pa_closed_over(material: [pa_lens_alpha()])
  )
}

// SHORTENED TOGETHER: material AND observations both reduced to alpha, self-consistent throughout.
// The binding to the candidate's contract axis is what refuses it.
fn pa_coverage_shortened_together() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity(),
    material: [pa_lens_alpha()],
    observed: pa_closed_over(material: [pa_lens_alpha()])
  )
}

fn pa_coverage_empty_together() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity(),
    material: [],
    observed: pa_closed_over(material: [])
  )
}

// REFUSED: bound material, and the join could not close at all.
fn pa_coverage_refused() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity(),
    material: pa_contract_material(),
    observed: RequiredLensCoverageRefused { cause: RequiredLensRosterEmpty }
  )
}

fn pa_bundle(
  candidate_lens_coverage: GenerationLensCoverage,
  successor_lens_coverage: GenerationLensCoverage,
  candidate_build: BuildReceipt,
  successor_build: BuildReceipt,
  candidate_equivalence: BehavioralEquivalenceReceipt,
  successor_equivalence: BehavioralEquivalenceReceipt,
  discriminating_fault: DiscriminatingFaultReceipt,
  candidate_provenance: GenerationProvenanceReceipt,
  successor_provenance: GenerationProvenanceReceipt
) -> SelfHostCandidate {
  SelfHostCandidate {
    candidate: pa_candidate(),
    successor: pa_successor(),
    candidate_build: candidate_build,
    successor_build: successor_build,
    candidate_equivalence: candidate_equivalence,
    successor_equivalence: successor_equivalence,
    discriminating_fault: discriminating_fault,
    candidate_provenance: candidate_provenance,
    successor_provenance: successor_provenance,
    candidate_lens_coverage: candidate_lens_coverage,
    successor_lens_coverage: successor_lens_coverage
  }
}

fn pa_good() -> SelfHostCandidate {
  pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
    candidate_build: pa_build(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    successor_build: pa_build(
      subject: pa_successor_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    candidate_equivalence: pa_equivalence(
      subject: pa_candidate_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    successor_equivalence: pa_equivalence(
      subject: pa_successor_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    discriminating_fault: pa_fault(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: FaultCaught }
    ),
    candidate_provenance: pa_provenance(
      subject: pa_candidate_identity(),
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: pa_candidate_identity()
    )
  )
}

// POSITIVE CONTROL, and simultaneously THE HEADLINE CLAIM. This candidate's source
// closure differs from the seed's and it is admitted anyway, because behavior agreed
// on a nonempty corpus with a caught planted fault. Under the superseded byte
// fixed-point authority this exact candidate would have been REFUSED for the sole
// reason that its emitted source bytes were not the seed's.
test fn source_different_but_behaviorally_equivalent_is_promoted() -> Bool {
  pa_admitted(o: admit_promotion(c: pa_good()))
}

// THE OTHER HALF, and the one that matters more. Every identity axis here is
// UNCHANGED — same producer, same source closure, same target, same toolchain, same
// build configuration, same artifact — so a byte comparison would report a perfect
// fixed point. Behavior diverged, so admission refuses. Byte identity buys nothing.
test fn byte_identical_but_behaviorally_wrong_is_refused() -> Bool {
  let ident = pa_identical_identity()
  let cand = pa_identical_candidate()
  let o = admit_promotion(
    c: SelfHostCandidate {
      candidate: cand,
      successor: SuccessorGeneration {
        identity: ident,
        produced_by_candidate: cand
      },
      candidate_build: pa_build(subject: ident, outcome: ObservationPresent { value: BuildGreen }),
      successor_build: pa_build(subject: ident, outcome: ObservationPresent { value: BuildGreen }),
      candidate_equivalence: BehavioralEquivalenceReceipt {
        subject: ident,
        oracle: ident,
        corpus: pa_corpus(expected: pa_corpus_cases),
        cases_compared: pa_corpus_cases,
        outcome: ObservationPresent {
          value: BehaviorDiverges { at_case: "classical_and(True,False)" }
        }
      },
      successor_equivalence: BehavioralEquivalenceReceipt {
        subject: ident,
        oracle: ident,
        corpus: pa_corpus(expected: pa_corpus_cases),
        cases_compared: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      },
      discriminating_fault: pa_fault(
        subject: ident,
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(subject: ident, producer: ident),
      successor_provenance: pa_provenance(subject: ident, producer: ident),
      candidate_lens_coverage: pa_coverage_closed(),
      successor_lens_coverage: pa_coverage_closed()
    }
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_behavior_diverged_from_oracle)
}

// A corpus that never proved it could fail admits nothing. Without this arm the
// equivalence receipt is satisfiable by a corpus that agrees because it cannot
// disagree.
test fn uncaught_planted_fault_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent {
          value: FaultNotCaught { at_case: "classical_not(True)" }
        }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_discriminating_fault_not_caught)
}

// THE UNAVAILABLE-IS-NOT-EQUIVALENT CONTROL. The fault run could not be observed at
// all. That is neither "the fault was caught" nor "the fault escaped", and it must
// not be silently treated as either. Refusal names the unavailability so the deficit
// stays countable rather than being absorbed into a green.
test fn unavailable_fault_observation_is_refused_not_assumed_equivalent() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationUnavailable { cause: ^fault_harness_did_not_run }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_receipt_observation_unavailable
    )
}

// Agreement over zero cases is agreement over nothing.
test fn empty_behavioral_corpus_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence_on(
        subject: pa_candidate_identity(),
        corpus: pa_corpus(expected: 0),
        cases: 0,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence_on(
        subject: pa_successor_identity(),
        corpus: pa_corpus(expected: 0),
        cases: 0,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault_on(
        subject: pa_candidate_identity(),
        corpus: pa_corpus(expected: 0),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_empty_behavioral_corpus)
}

// A receipt gathered under a DIFFERENT toolchain refuses as stale. This is the axis
// most likely to drift unnoticed in practice, because nothing about the source
// changes when the toolchain moves underneath it.
test fn receipt_from_a_different_toolchain_is_refused_as_stale() -> Bool {
  let stale_subject = GenerationIdentity {
    producer_compiler: pa_candidate_identity().producer_compiler,
    source_closure: pa_candidate_identity().source_closure,
    target_model: pa_candidate_identity().target_model,
    toolchain: pa_digest(label: "toolchain-MOVED"),
    build_configuration: pa_candidate_identity().build_configuration,
    required_lens_contract: pa_candidate_identity().required_lens_contract,
    materialized_artifact: pa_candidate_identity().materialized_artifact
  }
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: stale_subject,
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_stale_receipt_subject)
}

// A build that failed is not a build. Stated separately from behavioral divergence
// because a candidate that does not compile and one that compiles and misbehaves are
// different states with different remedies.
test fn failed_successor_build_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildFailed { cause: ^rustc_error } }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_build_not_green)
}

// THE SELF-AUTHORIZATION CONTROL. A provenance receipt claiming the candidate
// produced ITSELF is refused, because provenance is checked against the producer
// fixed by construction when the generation was built, not against whatever the
// receipt asserts.
test fn candidate_cannot_authorize_its_own_provenance() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_candidate_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_provenance_not_declared_producer
    )
}

// DISCRIMINATING RED for the oracle join (review 51140). A receipt naming the
// CANDIDATE as its own oracle is refused. Without the join this bundle is admitted:
// subject matches, behavior "agrees", and the comparison was against itself.
test fn candidate_as_its_own_oracle_is_refused() -> Bool {
  let self_oracle = BehavioralEquivalenceReceipt {
    subject: pa_candidate_identity(),
    oracle: pa_candidate_identity(),
    corpus: pa_corpus(expected: pa_corpus_cases),
    cases_compared: pa_corpus_cases,
    outcome: ObservationPresent { value: BehaviorAgrees }
  }
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: self_oracle,
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_oracle_not_declared_seed)
}

// DISCRIMINATING RED for the unmaterialized-artifact arm at the PROMOTION seam
// (review 51140). The generation-level witness proves two unbuilt artifacts do not
// AGREE; this proves admission refuses an unbuilt candidate by name, which is the
// arm that matters when SH-C's artifact axis is not yet fillable.
test fn unmaterialized_candidate_artifact_is_refused_at_promotion() -> Bool {
  let unbuilt_identity = GenerationIdentity {
    producer_compiler: pa_candidate_identity().producer_compiler,
    source_closure: pa_candidate_identity().source_closure,
    target_model: pa_candidate_identity().target_model,
    toolchain: pa_candidate_identity().toolchain,
    build_configuration: pa_candidate_identity().build_configuration,
    required_lens_contract: pa_candidate_identity().required_lens_contract,
    materialized_artifact: ArtifactNotMaterialized
  }
  let unbuilt_candidate = CandidateGeneration {
    identity: unbuilt_identity,
    produced_by_seed: pa_seed()
  }
  let o = admit_promotion(
    c: SelfHostCandidate {
      candidate: unbuilt_candidate,
      successor: SuccessorGeneration {
        identity: pa_successor_identity(),
        produced_by_candidate: unbuilt_candidate
      },
      candidate_build: pa_build(
        subject: unbuilt_identity,
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: unbuilt_identity,
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: unbuilt_identity,
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: unbuilt_identity,
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: unbuilt_identity
      ),
      candidate_lens_coverage: pa_coverage_closed(),
      successor_lens_coverage: pa_coverage_closed()
    }
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_artifact_not_materialized)
}

// DISCRIMINATING RED: chain splicing. Candidate A is bundled with a successor whose
// own produced_by_candidate names a DIFFERENT candidate B. Every receipt joins
// internally, so without an explicit chain check both halves look valid and the
// successor inherits admission from a candidate that never produced it.
test fn spliced_candidate_and_successor_chains_are_refused() -> Bool {
  let other_candidate = CandidateGeneration {
    identity: pa_identity(
      closure_label: "OTHER-candidate-closure",
      artifact_hex: pa_seed_artifact_hex
    ),
    produced_by_seed: pa_seed()
  }
  let spliced_successor = SuccessorGeneration {
    identity: pa_successor_identity(),
    produced_by_candidate: other_candidate
  }
  let o = admit_promotion(
    c: SelfHostCandidate {
      candidate: pa_candidate(),
      successor: spliced_successor,
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: other_candidate.identity
      ),
      candidate_lens_coverage: pa_coverage_closed(),
      successor_lens_coverage: pa_coverage_closed()
    }
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_successor_not_produced_by_candidate
    )
}

// DISCRIMINATING RED: the planted fault was proven discriminating over a DIFFERENT
// corpus than the one equivalence was measured on, so the fault receipt vouches for
// teeth the equivalence run never had.
test fn fault_proven_on_a_different_corpus_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
