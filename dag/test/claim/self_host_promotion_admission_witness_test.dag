      candidate: pa_candidate(),
      successor: SuccessorGeneration {
        identity: pa_successor_identity(),
        produced_by_candidate: homonym_candidate
      },
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      ),
      candidate_lens_coverage: pa_coverage_closed(),
      successor_lens_coverage: pa_coverage_closed()
    }
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_successor_not_produced_by_candidate
    )
}

// DISCRIMINATING RED for the population join, and the exact shape that promoted before
// it existed: both receipts name the corpus, both report agreement, both are fresh, and
// the successor compared ONE case where the corpus declares ten. A partially emitted
// compiler produces precisely this — it runs, it agrees on what it reached, and it never
// reached the rest. Under the label-only join the two receipts agreed and the bundle was
// admitted; the count sat beside the name proving nothing.
test fn truncated_successor_run_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: 1,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_corpus_population_mismatch)
}

// The mirror: a run comparing MORE cases than its corpus declares did not execute the
// corpus it names. Refusing only the truncation would let the bar be raised silently by
// whatever the runner happened to do, which is the same unjoined-number defect pointing
// the other way.
test fn overlong_run_against_its_declared_corpus_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases + 5,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(o: o, cause: ^refusal_corpus_population_mismatch)
}

// DISCRIMINATING RED for the second half of the corpus join. Both receipts name the SAME
// corpus and each runs exactly the population IT declares, so every per-receipt check
// passes and the label join passes — yet the two ran different corpora under one name.
// Joining identity alone admits this; joining the declared size too refuses it.
test fn same_named_corpus_declaring_two_sizes_is_refused() -> Bool {
  let o = admit_promotion(
    c: pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: pa_candidate_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence_on(
        subject: pa_successor_identity(),
        corpus: pa_corpus(expected: 3),
        cases: 3,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: pa_candidate_identity(),
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_corpus_mismatch_across_receipts
    )
}

// The observation → receipt seam. A transport observes outcomes; it does not name the
// generation it measured. These prove the projections carry the observed verdict and the
// declared corpus through unchanged, so a transport cannot quietly improve its own
// evidence on the way into a receipt.
fn pa_observation(
  build: ObservationAvailability<BuildOutcome>,
  equivalence: ObservationAvailability<EquivalenceOutcome>,
  fault: ObservationAvailability<FaultOutcome>
) -> BehavioralComparisonObservation {
  BehavioralComparisonObservation {
    corpus: pa_corpus(expected: pa_corpus_cases),
    cases_compared: pa_corpus_cases,
    build: build,
    equivalence: equivalence,
    fault: fault
  }
}

fn pa_bundle_from_observation(
  o: BehavioralComparisonObservation
) -> SelfHostCandidate {
  pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
    candidate_build: build_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity()
    ),
    successor_build: build_receipt_from_observation(
      o: o,
      subject: pa_successor_identity()
    ),
    candidate_equivalence: equivalence_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity(),
      oracle: pa_seed_identity()
    ),
    successor_equivalence: equivalence_receipt_from_observation(
      o: o,
      subject: pa_successor_identity(),
      oracle: pa_seed_identity()
    ),
    discriminating_fault: fault_receipt_from_observation(
      o: o,
      subject: pa_candidate_identity(),
      planted_fault: "classical_not called on mismatched input"
    ),
    candidate_provenance: pa_provenance(
      subject: pa_candidate_identity(),
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: pa_candidate_identity()
    )
  )
}

// The positive control: a fully observed run, projected into receipts, is admitted. It
// is what makes the two REDs below discriminating rather than a mechanism that refuses
// everything routed through the seam.
test fn fully_observed_run_projects_into_an_admitted_promotion() -> Bool {
  pa_admitted(
    o: admit_promotion(
      c: pa_bundle_from_observation(
        o: pa_observation(
          build: ObservationPresent { value: BuildGreen },
          equivalence: ObservationPresent { value: BehaviorAgrees },
          fault: ObservationPresent { value: FaultCaught }
        )
      )
    )
  )
}

// DISCRIMINATING RED. This is the shape the transport's superseded conjunction produced
// whenever the planted-fault process died for its own reasons: the run was nonzero, the
// fault was never reported, and the old test read the exit code as proof of teeth. Routed
// through the seam as the unavailable observation it actually is, admission refuses under
// its own name instead of inheriting a verdict from an exit status.
test fn unreported_fault_observation_refuses_through_the_seam() -> Bool {
  let o = admit_promotion(
    c: pa_bundle_from_observation(
      o: pa_observation(
        build: ObservationPresent { value: BuildGreen },
        equivalence: ObservationPresent { value: BehaviorAgrees },
        fault: ObservationUnavailable { cause: ^slb_fault_run_unreported }
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_receipt_observation_unavailable
    )
}

// DISCRIMINATING RED for the other half: a build that did not happen cannot yield a
// behavioral verdict, and the observation says so rather than reporting agreement over a
// comparison that never ran.
test fn unbuilt_run_refuses_through_the_seam() -> Bool {
  let o = admit_promotion(
    c: pa_bundle_from_observation(
      o: pa_observation(
        build: ObservationUnavailable { cause: ^slb_stage_incomplete },
        equivalence: ObservationUnavailable { cause: ^slb_comparison_did_not_run },
        fault: ObservationUnavailable { cause: ^slb_fault_run_did_not_run }
      )
    )
  )
  !pa_admitted(o: o)
    && promotion_refusal_carries(
      o: o,
      cause: ^refusal_receipt_observation_unavailable
    )
}

// ---- REQUIRED-LENS COVERAGE ON THE PROMOTION SUBJECT ----
//
// WHY THE RED HAS TWO HALVES AND NEITHER IMPLIES THE OTHER. A coverage value can fail a generation
// in two different ways, and a suite that tested one would leave the other silent. The join can
// REFUSE, in which case there are no rows at all; or it can CLOSE over a roster that no longer names
// an obligation this generation owes, in which case the value is internally consistent and still
// short. The second is the case a reader of the coverage alone cannot see, which is exactly why the
// required set is carried beside the observation rather than re-read from the live roster.

// A WHOLE CANDIDATE BUILT ON A GIVEN IDENTITY, so the grain witnesses can move the contract axis
// without every OTHER receipt refusing as stale first. Each candidate-side receipt names the same
// identity, which is what leaves the coverage the only thing under test.
fn pa_with_coverage_for(
  candidate_identity: GenerationIdentity,
  candidate_cov: GenerationLensCoverage,
  successor_cov: GenerationLensCoverage
) -> SelfHostCandidate {
  let cand = CandidateGeneration { identity: candidate_identity, produced_by_seed: pa_seed() }
  SelfHostCandidate {
    candidate: cand,
    successor: SuccessorGeneration {
      identity: pa_successor_identity(),
      produced_by_candidate: cand
    },
    candidate_build: pa_build(
      subject: candidate_identity,
      outcome: ObservationPresent { value: BuildGreen }
    ),
    successor_build: pa_build(
      subject: pa_successor_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    candidate_equivalence: pa_equivalence(
      subject: candidate_identity,
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    successor_equivalence: pa_equivalence(
      subject: pa_successor_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    discriminating_fault: pa_fault(
      subject: candidate_identity,
      outcome: ObservationPresent { value: FaultCaught }
    ),
    candidate_provenance: pa_provenance(
      subject: candidate_identity,
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: candidate_identity
    ),
    candidate_lens_coverage: candidate_cov,
    successor_lens_coverage: successor_cov
  }
}

fn pa_with_coverage(
  candidate_cov: GenerationLensCoverage,
  successor_cov: GenerationLensCoverage
) -> SelfHostCandidate {
  pa_bundle(
    candidate_lens_coverage: candidate_cov,
    successor_lens_coverage: successor_cov,
    candidate_build: pa_build(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    successor_build: pa_build(
      subject: pa_successor_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    candidate_equivalence: pa_equivalence(
      subject: pa_candidate_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    successor_equivalence: pa_equivalence(
      subject: pa_successor_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    discriminating_fault: pa_fault(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: FaultCaught }
    ),
    candidate_provenance: pa_provenance(
      subject: pa_candidate_identity(),
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: pa_candidate_identity()
    )
  )
}

// RED, HALF ONE: the join refused, so it reports no rows. Promotion must refuse, and it must refuse
// BY NAME on both counts -- the join's own cause AND the obligations left unaccounted -- because a
// refusal that named only the join would tell a reader the coverage is unusable while leaving them
// to guess what it failed to cover.
test fn refused_candidate_coverage_refuses_promotion_by_name() -> Bool {
  let o = admit_promotion(c: pa_with_coverage(
    candidate_cov: pa_coverage_refused(),
    successor_cov: pa_coverage_closed()
  ))
  promotion_refusal_carries(o: o, cause: ^refusal_required_lens_coverage_not_closed)
    && promotion_refusal_carries(o: o, cause: ^refusal_required_lens_obligation_not_covered)
}

// RED, HALF TWO: the join CLOSED and is short. Nothing in the coverage value is inconsistent, so
// only the carried required set can catch it. This is the witness that fails if the required set is
// ever re-read from the live roster instead of pinned.
test fn closed_but_short_candidate_coverage_refuses_promotion() -> Bool {
  let o = admit_promotion(c: pa_with_coverage(
    candidate_cov: pa_coverage_missing_beta(),
    successor_cov: pa_coverage_closed()
  ))
  promotion_refusal_carries(o: o, cause: ^refusal_required_lens_obligation_not_covered)
    && !promotion_refusal_carries(o: o, cause: ^refusal_required_lens_coverage_not_closed)
}

// THE SUCCESSOR IS JUDGED TOO, not just the candidate. A promotion that checked only the candidate
// would admit a successor whose own compile never ran the required roster, which is the generation
// that actually becomes the next compiler.
test fn refused_successor_coverage_refuses_promotion() -> Bool {
  promotion_refusal_carries(
    o: admit_promotion(c: pa_with_coverage(
      candidate_cov: pa_coverage_closed(),
      successor_cov: pa_coverage_refused()
    )),
    cause: ^refusal_required_lens_coverage_not_closed
  )
}

// THE POSITIVE CONTROL, so the three reds above cannot come from an admission that refuses every
// candidate: identical receipts, closed and complete coverage on both generations, and it promotes.
// EACH GENERATION'S COVERAGE NAMES ITS OWN SUBJECT, and writing it any other way is what this
// witness exists to keep honest: handing the successor the candidate's coverage reads as complete
// and is refused, because a receipt about one generation says nothing about the other.
test fn closed_and_complete_coverage_on_both_generations_promotes() -> Bool {
  match admit_promotion(c: pa_with_coverage(
    candidate_cov: pa_coverage_closed(),
    successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
  )) {
    Promoted { successor: _, cases_compared: _ } => true
    PromotionRefused { causes: _ } => false
  }
}

// THE PRE-EXISTING CAUSES SURVIVE THE ADDITION, which the ruling asked for explicitly. A candidate
// that is bad for an OLD reason and clean on coverage must still refuse for that old reason -- the
// new arms must not shadow or replace the ones already there.
fn pa_build_failed_with_clean_coverage() -> SelfHostCandidate {
  pa_bundle(
    candidate_lens_coverage: pa_coverage_closed(),
    successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
    candidate_build: pa_build(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: BuildFailed { cause: ^rustc_error } }
    ),
    successor_build: pa_build(
      subject: pa_successor_identity(),
      outcome: ObservationPresent { value: BuildGreen }
    ),
    candidate_equivalence: pa_equivalence(
      subject: pa_candidate_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    successor_equivalence: pa_equivalence(
      subject: pa_successor_identity(),
      cases: pa_corpus_cases,
      outcome: ObservationPresent { value: BehaviorAgrees }
    ),
    discriminating_fault: pa_fault(
      subject: pa_candidate_identity(),
      outcome: ObservationPresent { value: FaultCaught }
    ),
    candidate_provenance: pa_provenance(
      subject: pa_candidate_identity(),
      producer: pa_seed_identity()
    ),
    successor_provenance: pa_provenance(
      subject: pa_successor_identity(),
      producer: pa_candidate_identity()
    )
  )
}

test fn adding_coverage_preserves_the_existing_refusal_causes() -> Bool {
  let o = admit_promotion(c: pa_build_failed_with_clean_coverage())
  promotion_refusal_carries(o: o, cause: ^refusal_build_not_green)
    && !promotion_refusal_carries(o: o, cause: ^refusal_required_lens_coverage_not_closed)
    && !promotion_refusal_carries(o: o, cause: ^refusal_required_lens_obligation_not_covered)
}

// THE BINDING RED, AND IT REPLACES THE DIGEST-VS-DIGEST WITNESS THAT CAME BEFORE IT. That one
// compared a digest derived from the submitted material against a digest submitted beside it, and
// the HOLD on this PR showed why that is not a check: both move together, so material shortened to
// [alpha] with a recomputed digest passed, and so did material shortened to nothing. The comparison
// is now against the `required_lens_contract` axis of the generation being promoted, which the
// submitter does not supply.
test fn material_shortened_with_its_observations_is_refused_as_unbound() -> Bool {
  let o = admit_promotion(c: pa_with_coverage(
    candidate_cov: pa_coverage_shortened_together(),
    successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
  ))
  promotion_refusal_carries(o: o, cause: ^refusal_required_lens_contract_material_unbound)
}

// THE DEGENERATE CASE OF THE SAME DEFECT, kept separate because an empty population is the one a
// fold over the supplied list reports nothing about: every obligation is vacuously covered.
test fn empty_contract_material_is_refused_as_unbound() -> Bool {
  let o = admit_promotion(c: pa_with_coverage(
    candidate_cov: pa_coverage_empty_together(),
    successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
  ))
  promotion_refusal_carries(o: o, cause: ^refusal_required_lens_contract_material_unbound)
}

// AN UNBOUND MATERIAL DOES NOT ALSO REPORT UNCOVERED OBLIGATIONS, because the obligations this
// generation owes are unknown until the binding holds. Reporting a population that was never
// established would be answering a question the receipt cannot pose.
test fn an_unbound_material_reports_no_uncovered_population() -> Bool {
  !promotion_refusal_carries(
    o: admit_promotion(c: pa_with_coverage(
      candidate_cov: pa_coverage_shortened_together(),
      successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
    )),
    cause: ^refusal_required_lens_obligation_not_covered
  )
}

// ---- THE REQUIRED-LENS-CONTRACT AXIS, EXERCISED THROUGH THE RECEIPT PATHS ----
//
// WHY THESE ARE THREE WITNESSES AND NOT ONE BUNDLE. A single candidate carrying the stale subject on
// every receipt refuses on the first path the fold reaches, and a path that had stopped checking its
// subject would be invisible behind that early refusal. Each witness below moves the contract axis
// on exactly ONE receipt and leaves the others clean, so the refusal it observes can only have come
// from the path it names.
//
// AND THE CLAIM IS THE NARROW ONE. Moving this axis does not assert the generation misbehaves or
// that its requirements went unmet; it says the receipt describes a generation produced under a
// DIFFERENT required contract than the one being promoted, which is a stale subject exactly as a
// moved toolchain is.
fn pa_contract_moved_subject() -> GenerationIdentity {
  GenerationIdentity {
    producer_compiler: pa_candidate_identity().producer_compiler,
    source_closure: pa_candidate_identity().source_closure,
    target_model: pa_candidate_identity().target_model,
    toolchain: pa_candidate_identity().toolchain,
    build_configuration: pa_candidate_identity().build_configuration,
    required_lens_contract: pa_candidate_identity().required_lens_contract,
    required_lens_contract: pa_digest(label: "required-lens-contract-MOVED"),
    materialized_artifact: pa_candidate_identity().materialized_artifact
  }
}

fn pa_contract_stale_on(which: Symbol) -> PromotionOutcome {
  admit_promotion(
    c: pa_bundle(
      candidate_lens_coverage: pa_coverage_closed(),
      successor_lens_coverage: pa_coverage_closed_for(subject: pa_successor_identity()),
      candidate_build: pa_build(
        subject: if which == ^on_build { pa_contract_moved_subject() } else { pa_candidate_identity() },
        outcome: ObservationPresent { value: BuildGreen }
      ),
      successor_build: pa_build(
        subject: pa_successor_identity(),
        outcome: ObservationPresent { value: BuildGreen }
      ),
      candidate_equivalence: pa_equivalence(
        subject: if which == ^on_equivalence { pa_contract_moved_subject() } else { pa_candidate_identity() },
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      successor_equivalence: pa_equivalence(
        subject: pa_successor_identity(),
        cases: pa_corpus_cases,
        outcome: ObservationPresent { value: BehaviorAgrees }
      ),
      discriminating_fault: pa_fault(
        subject: pa_candidate_identity(),
        outcome: ObservationPresent { value: FaultCaught }
      ),
      candidate_provenance: pa_provenance(
        subject: if which == ^on_provenance { pa_contract_moved_subject() } else { pa_candidate_identity() },
        producer: pa_seed_identity()
      ),
      successor_provenance: pa_provenance(
        subject: pa_successor_identity(),
        producer: pa_candidate_identity()
      )
    )
  )
}

test fn a_contract_stale_build_receipt_refuses_naming_that_axis() -> Bool {
  let o = pa_contract_stale_on(which: ^on_build)
  !pa_admitted(o: o) && promotion_refusal_carries(o: o, cause: ^refusal_stale_receipt_subject)
}

test fn a_contract_stale_equivalence_receipt_refuses_naming_that_axis() -> Bool {
  let o = pa_contract_stale_on(which: ^on_equivalence)
  !pa_admitted(o: o) && promotion_refusal_carries(o: o, cause: ^refusal_stale_receipt_subject)
}

test fn a_contract_stale_provenance_receipt_refuses_naming_that_axis() -> Bool {
  let o = pa_contract_stale_on(which: ^on_provenance)
  !pa_admitted(o: o) && promotion_refusal_carries(o: o, cause: ^refusal_stale_receipt_subject)
}

// THE POSITIVE CONTROL FOR ALL THREE: the same bundle with no axis moved promotes, so the refusals
// above are about the contract axis and not about the shape of this fixture.
test fn the_same_bundle_with_no_axis_moved_promotes() -> Bool {
  pa_admitted(o: pa_contract_stale_on(which: ^on_nothing))
}

// ---- CONTROL (3): COVERAGE SPLICED FROM ANOTHER GENERATION ----
//
// The lens identities and grains MATCH, so the obligation walk is satisfied and the binding holds --
// this coverage is a perfectly good receipt about a DIFFERENT compile. Only the subject join can see
// it, which is the whole reason a coverage receipt carries one. Candidate and successor are checked
// separately because a checker that joined only the candidate would admit a successor whose own
// compile never ran the roster, and that is the generation that becomes the next compiler.
test fn candidate_coverage_from_another_generation_is_refused() -> Bool {
  promotion_refusal_carries(
    o: admit_promotion(c: pa_with_coverage(
      candidate_cov: pa_coverage_closed_for(subject: pa_successor_identity()),
      successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
    )),
    cause: ^refusal_stale_receipt_subject
  )
}

test fn successor_coverage_from_another_generation_is_refused() -> Bool {
  promotion_refusal_carries(
    o: admit_promotion(c: pa_with_coverage(
      candidate_cov: pa_coverage_closed(),
      successor_cov: pa_coverage_closed()
    )),
    cause: ^refusal_stale_receipt_subject
  )
}

// AND THE SWAP IS REFUSED IN BOTH DIRECTIONS AT ONCE, which is the shape a caller would actually
// produce by wiring the two fields the wrong way round. Naming a field `successor_lens_coverage`
// does not make its contents about the successor.
test fn swapping_the_two_coverages_is_refused() -> Bool {
  promotion_refusal_carries(
    o: admit_promotion(c: pa_with_coverage(
      candidate_cov: pa_coverage_closed_for(subject: pa_successor_identity()),
      successor_cov: pa_coverage_closed()
    )),
    cause: ^refusal_stale_receipt_subject
  )
}

// ---- GRAIN IS PART OF THE OBLIGATION ----
//
// The contract requires beta at SUBTREE grain; the coverage observes beta once at ROOT. Every
// identity the contract names has a row, the binding holds because the material is the one the
// identity commits to, and the ONLY thing wrong is the shape of the execution. A lens registered at
// subtree grain runs per node, so a single root observation is not that lens having run -- it is a
// different execution wearing the same name. Before the grain check this promoted.
fn pa_coverage_root_rows_for_subtree_contract() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity_subtree(),
    material: pa_subtree_material(),
    observed: RequiredLensCoverageClosed {
      roster_digest: required_lens_roster_digest_of(lenses: pa_subtree_material()),
      rows: [
        pa_coverage_row(lens: pa_lens_alpha()),
        pa_coverage_row(lens: pa_lens_beta())
      ]
    }
  )
}

test fn coverage_at_the_wrong_grain_refuses_and_names_the_grain() -> Bool {
  let o = admit_promotion(
    c: pa_with_coverage_for(
      candidate_identity: pa_candidate_identity_subtree(),
      candidate_cov: pa_coverage_root_rows_for_subtree_contract(),
      successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
    )
  )
  promotion_refusal_carries(o: o, cause: ^refusal_required_lens_obligation_covered_at_wrong_grain)
    && !promotion_refusal_carries(o: o, cause: ^refusal_required_lens_obligation_not_covered)
    && !promotion_refusal_carries(o: o, cause: ^refusal_required_lens_contract_material_unbound)
}

// THE BOUNDARY: the same contract with the beta row observed at the grain it was registered at
// promotes, so the refusal above is about the grain and not about this fixture's shape.
fn pa_coverage_matching_grain_for_subtree_contract() -> GenerationLensCoverage {
  pa_coverage_for(
    subject: pa_candidate_identity_subtree(),
    material: pa_subtree_material(),
    observed: RequiredLensCoverageClosed {
      roster_digest: required_lens_roster_digest_of(lenses: pa_subtree_material()),
      rows: [
        pa_coverage_row(lens: pa_lens_alpha()),
        pa_coverage_row(lens: pa_lens_beta_subtree())
      ]
    }
  )
}

test fn coverage_at_the_registered_grain_promotes() -> Bool {
  match admit_promotion(
    c: pa_with_coverage_for(
      candidate_identity: pa_candidate_identity_subtree(),
      candidate_cov: pa_coverage_matching_grain_for_subtree_contract(),
      successor_cov: pa_coverage_closed_for(subject: pa_successor_identity())
    )
  ) {
    Promoted { successor: _, cases_compared: _ } => true
    PromotionRefused { causes: _ } => false
  }
}
