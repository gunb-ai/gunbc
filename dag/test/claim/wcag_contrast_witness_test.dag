module test.claim.wcag_contrast_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn witness_extremes_exact() -> Bool {
  let white = extdeps.accessibility.wcag_contrast.relative_luminance_scaled(hue: 0, sat_pct: 0, light_pct: 100)
  let black = extdeps.accessibility.wcag_contrast.relative_luminance_scaled(hue: 0, sat_pct: 0, light_pct: 0)
  white == 10000
    && black == 0
    && extdeps.accessibility.wcag_contrast.contrast_ratio_x100(lum_a_scaled: white, lum_b_scaled: black) == 2100
    && extdeps.accessibility.wcag_contrast.contrast_ratio_x100(lum_a_scaled: white, lum_b_scaled: white) == 100
}

test fn witness_gamma_kernel_pinned() -> Bool {
  let full = extdeps.accessibility.wcag_contrast.linearize_channel_scaled(c_scaled: 10000)
  let half = extdeps.accessibility.wcag_contrast.linearize_channel_scaled(c_scaled: 5000)
  let low = extdeps.accessibility.wcag_contrast.linearize_channel_scaled(c_scaled: 300)
  full == 10000
    && half >= 2120 && half <= 2160
    && low == (300 * 100) / 1292
}

test fn witness_reviewer_oracle_night_text() -> Bool {
  let r = extdeps.accessibility.wcag_contrast.hsl_contrast_ratio_x100(hue_a: 35, sat_a: 14, light_a: 78, hue_b: 226, sat_b: 30, light_b: 7)
  r >= 1100 && r <= 1200
}

test fn witness_reviewer_oracle_day_brass_marks_only() -> Bool {
  let r = extdeps.accessibility.wcag_contrast.hsl_contrast_ratio_x100(hue_a: 42, sat_a: 52, light_a: 38, hue_b: 40, sat_b: 32, light_b: 95)
  r >= 375 && r <= 420
    && extdeps.accessibility.wcag_contrast.hsl_contrast_at_least(hue_a: 42, sat_a: 52, light_a: 38, hue_b: 40, sat_b: 32, light_b: 95, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_large_text_and_graphics_hundredths)
    && !extdeps.accessibility.wcag_contrast.hsl_contrast_at_least(hue_a: 42, sat_a: 52, light_a: 38, hue_b: 40, sat_b: 32, light_b: 95, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
}

test fn witness_same_color_refuses_all_thresholds() -> Bool {
  !extdeps.accessibility.wcag_contrast.hsl_contrast_at_least(hue_a: 226, sat_a: 30, light_a: 7, hue_b: 226, sat_b: 30, light_b: 7, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_large_text_and_graphics_hundredths)
}

test fn witness_live_themes_clear_hardened_law() -> Bool {
  gunbc.design.theme.theme_contrast_ok(t: gunbc.design.theme.night_theme) && gunbc.design.theme.theme_contrast_ok(t: gunbc.design.theme.day_theme)
}

fn mud_theme() -> gunbc.design.theme.Theme {
  gunbc.design.theme.Theme { name: "mud", scheme: "dark", assignments: [
    gunbc.design.theme.assign(role: gunbc.design.theme.CanvasRole, material: gunbc.design.theme.night_canvas),
    gunbc.design.theme.assign(role: gunbc.design.theme.SurfaceRole, material: gunbc.design.theme.night_canvas),
    gunbc.design.theme.assign(role: gunbc.design.theme.TextRole, material: gunbc.design.theme.night_canvas),
    gunbc.design.theme.assign(role: gunbc.design.theme.TextDimRole, material: gunbc.design.theme.night_canvas),
    gunbc.design.theme.assign(role: gunbc.design.theme.FigureRole, material: gunbc.design.theme.night_canvas),
    gunbc.design.theme.assign(role: gunbc.design.theme.FocusRole, material: gunbc.design.theme.night_canvas),
  ] }
}

test fn witness_mud_theme_refused() -> Bool {
  !gunbc.design.theme.theme_contrast_ok(t: mud_theme())
}

