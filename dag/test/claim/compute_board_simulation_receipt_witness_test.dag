module test.claim.compute_board_simulation_receipt_witness

import std.types { String, List }
import product.compute_board.admission {
  BoardArticleAdmitted,
  BoardArticleRefused,
  AdmittedBoardPowerInterfaceArticle,
  admit_board_article,
}
import product.compute_board.article { BoardPowerInterfaceArticle, power_interlock_article }
import product.compute_board.analog {
  AnalogCircuitIntent,
  ComponentInstanceIdentity,
  ElectricalNet,
  NetIdentity,
  TerminalIdentity,
  terminal_ref,
}
import product.compute_board.spice_projection {
  SpiceSliceProjected,
  SpiceSliceRefused,
  project_article_to_spice,
  project_article_to_ngspice_run,
}
import product.compute_board.verilog_projection {
  VerilogModuleEmitted,
  VerilogProjectionRefused,
  project_article_to_verilog,
  power_interlock_verilog_bindings,
}
import product.compute_board.simulation_receipt {
  SimulationOutcome,
  conditioning_network_artifact,
  conditioning_network_run,
  executed_runs,
  interlock_verilog_artifact,
  interlock_verilog_run,
  outcome_is_accepted,
  run_of,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE JOIN, and it is the only thing that keeps a recorded run from decaying into folklore. The
// receipt says a tool accepted these exact bytes; this asserts the product still emits exactly
// those bytes. Without it the receipt would keep vouching for an artifact the projection stopped
// producing, which is worse than having no receipt at all — it reads as evidence.
fn admitted() -> AdmittedBoardPowerInterfaceArticle? {
  match admit_board_article(a: power_interlock_article) {
    BoardArticleAdmitted { article: adm } => Present { value: adm }
    BoardArticleRefused { causes: _ } => none
  }
}

test fn w_the_executed_verilog_is_what_the_product_emits_today() -> Bool {
  match admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_verilog(admitted: adm, bindings: power_interlock_verilog_bindings) {
        VerilogProjectionRefused { cause: _ } => false
        VerilogModuleEmitted { receipt: r } => r.source == interlock_verilog_artifact
      }
  }
}

test fn w_the_executed_deck_is_what_the_product_emits_today() -> Bool {
  match admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_ngspice_run(admitted: adm) {
        SpiceSliceRefused { cause: _ } => false
        SpiceSliceProjected { receipt: r } => r.source == conditioning_network_artifact
      }
  }
}

// The runnable deck and the receipt deck describe ONE circuit. A run that exercised a different
// netlist from the one the receipt carries would prove something about a circuit nobody emits;
// the shared spice_netlist construction is what makes that unwritable, and this is the executing
// check that it stayed shared.
test fn w_the_run_deck_contains_the_receipt_circuit() -> Bool {
  match admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_spice(admitted: adm) {
        SpiceSliceRefused { cause: _ } => false
        SpiceSliceProjected { receipt: r } =>
          match project_article_to_ngspice_run(admitted: adm) {
            SpiceSliceRefused { cause: _ } => false
            SpiceSliceProjected { receipt: run } => run.source == concat(r.source, "\n.op\n.end")
          }
      }
  }
}

// Both recorded runs were accepted by their tool. A receipt whose outcome arm was never checked
// would let a refusal sit in the corpus looking like evidence of success.
test fn w_every_recorded_run_was_accepted() -> Bool {
  fold(executed_runs, init: true, f: fn(acc, o) { acc && outcome_is_accepted(outcome: o) })
}

// The observations are not empty, and they are DIFFERENT from one another. An empty observation
// would make every claim above vacuous, and one shared observation string would mean a copy
// rather than two runs.
test fn w_the_observations_are_distinct_and_present() -> Bool {
  let v = run_of(outcome: interlock_verilog_run)
  let s = run_of(outcome: conditioning_network_run)
  v.observation != "" && s.observation != "" && v.observation != s.observation
}

// THE OPERATING POINT NAMES THE SCALE. Twelve volts across ten kilohms is 1.2 mA; a deck that had
// emitted a bare "10" would have solved cleanly and reported 1.2 A. This asserts the observation
// recorded the milliamp figure, which is the only part of the run that discriminates the suffix.
test fn w_the_operating_point_discriminates_the_scale_suffix() -> Bool {
  let s = run_of(outcome: conditioning_network_run)
  list_length(items: split(s: s.observation, delimiter: "-1.20000e-03")) > 1
}

// BOTH SPICE PATHS SIT BEHIND ONE REFUSAL GATE. This is the review finding that produced the
// change: the runnable deck used to be built directly and returned as a bare String, so an
// article admission accepts and the projection REFUSES could still hand bytes to a simulator —
// and component_node maps a terminal on no net to Ground, so those bytes would have simulated
// cleanly while describing a different board. A String return is what made it possible, because
// a String has nowhere to put a refusal. The fixture below is admitted (netting is deliberately
// not an article-level fact) and has a floating terminal, so it discriminates exactly that.
// The production circuit with ONE net member removed: pg_filt terminal 1 now sits on no net. The
// article is otherwise untouched, so admission accepts it — a terminal's netting is a SPICE
// requirement rather than a fact about the board, which is exactly why the projection has to be
// the thing that refuses.
data floating_analog: AnalogCircuitIntent = AnalogCircuitIntent {
  title: power_interlock_article.analog.title,
  components: power_interlock_article.analog.components,
  nets: [
    ElectricalNet {
      identity: "pg_raw" as NetIdentity,
      members: [
        terminal_ref(component: "logic_in" as ComponentInstanceIdentity, terminal: "1" as TerminalIdentity),
        terminal_ref(component: "pg_cond" as ComponentInstanceIdentity, terminal: "1" as TerminalIdentity),
      ],
    },
    ElectricalNet {
      identity: "power_return" as NetIdentity,
      members: [
        terminal_ref(component: "logic_in" as ComponentInstanceIdentity, terminal: "2" as TerminalIdentity),
        terminal_ref(component: "pg_cond" as ComponentInstanceIdentity, terminal: "2" as TerminalIdentity),
        terminal_ref(component: "pg_filt" as ComponentInstanceIdentity, terminal: "2" as TerminalIdentity),
      ],
    },
  ],
}

data floating_terminal_article: BoardPowerInterfaceArticle = BoardPowerInterfaceArticle {
  identity: power_interlock_article.identity,
  analog: floating_analog,
  model_bindings: power_interlock_article.model_bindings,
  reference_net: power_interlock_article.reference_net,
  digital_control: power_interlock_article.digital_control,
  bonds: power_interlock_article.bonds,
  platform_firmware: power_interlock_article.platform_firmware,
  physical: power_interlock_article.physical,
  manufacturing: power_interlock_article.manufacturing,
}

fn floating_article() -> AdmittedBoardPowerInterfaceArticle? {
  match admit_board_article(a: floating_terminal_article) {
    BoardArticleAdmitted { article: adm } => Present { value: adm }
    BoardArticleRefused { causes: _ } => none
  }
}

test fn w_the_floating_fixture_is_admitted_so_the_test_is_about_the_projection() -> Bool {
  match floating_article() {
    Present { value: _ } => true
    Absent => false
  }
}

test fn w_both_spice_paths_refuse_the_same_article() -> Bool {
  match floating_article() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_spice(admitted: adm) {
        SpiceSliceProjected { receipt: _ } => false
        SpiceSliceRefused { cause: _ } =>
          match project_article_to_ngspice_run(admitted: adm) {
            SpiceSliceProjected { receipt: _ } => false
            SpiceSliceRefused { cause: _ } => true
          }
      }
  }
}
