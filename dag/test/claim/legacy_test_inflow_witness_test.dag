module test.claim.legacy_test_inflow_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// EVERY FIXTURE PLANTS WHAT IT ASSERTS. The kernel folds diff text, so these witnesses author the diff rather than sampling one: the arrival witnesses plant a known `#[test]` and require it back BY NAME, not by count, so a fold that counted attribute lines without resolving declarations would pass a count assertion and fails these. The controls are chosen to separate the three ways this counter could be wrong in the direction that matters — reporting zero when something arrived (the added-in-new-file and attribute-above-existing-function fixtures), reporting an arrival when none did (the migration-direction, removal, and touched-without-adding fixtures), and reporting zero when the observation itself failed (the refusal fixtures, which are the fail-closed half audit mode does not relax).
data fixture_new_legacy_test_file_diff: String = "diff --git a/src/v1/tests/src/planted_inflow_test.rs b/src/v1/tests/src/planted_inflow_test.rs\nnew file mode 100644\n--- /dev/null\n+++ b/src/v1/tests/src/planted_inflow_test.rs\n@@ -0,0 +1,4 @@\n+#[test]\n+fn planted_arrival() {\n+    assert!(true);\n+}\n"

data fixture_attribute_above_existing_fn_diff: String = "diff --git a/src/v1/tests/src/existing_module_test.rs b/src/v1/tests/src/existing_module_test.rs\n--- a/src/v1/tests/src/existing_module_test.rs\n+++ b/src/v1/tests/src/existing_module_test.rs\n@@ -10,6 +10,7 @@\n fn helper() -> bool { true }\n \n+#[test]\n fn promoted_to_a_test() {\n     assert!(helper());\n }\n"

data fixture_floor_witness_added_diff: String = "diff --git a/dag/test/claim/planted_floor_witness_test.dag b/dag/test/claim/planted_floor_witness_test.dag\nnew file mode 100644\n--- /dev/null\n+++ b/dag/test/claim/planted_floor_witness_test.dag\n@@ -0,0 +1,3 @@\n+test fn planted_floor_behavior() -> Bool {\n+  true\n+}\n"

data fixture_legacy_test_touched_without_arrival_diff: String = "diff --git a/src/v1/tests/src/existing_module_test.rs b/src/v1/tests/src/existing_module_test.rs\n--- a/src/v1/tests/src/existing_module_test.rs\n+++ b/src/v1/tests/src/existing_module_test.rs\n@@ -12,7 +12,7 @@\n #[test]\n fn already_present() {\n-    assert_eq!(1, 1);\n+    assert_eq!(2, 2);\n }\n"

data fixture_legacy_test_removed_diff: String = "diff --git a/src/v1/tests/src/existing_module_test.rs b/src/v1/tests/src/existing_module_test.rs\n--- a/src/v1/tests/src/existing_module_test.rs\n+++ b/src/v1/tests/src/existing_module_test.rs\n@@ -12,8 +12,3 @@\n-#[test]\n-fn departing_behavior() {\n-    assert!(true);\n-}\n-\n fn helper() -> bool { true }\n"

data fixture_seed_test_outside_population_diff: String = "diff --git a/src/v1/stage0/src/v1_tests_claim_planted_test.rs b/src/v1/stage0/src/v1_tests_claim_planted_test.rs\nnew file mode 100644\n--- /dev/null\n+++ b/src/v1/stage0/src/v1_tests_claim_planted_test.rs\n@@ -0,0 +1,3 @@\n+#[test]\n+fn outside_the_counted_population() {\n+}\n"

data fixture_unresolved_attribute_diff: String = "diff --git a/src/v1/tests/src/truncated_module_test.rs b/src/v1/tests/src/truncated_module_test.rs\n--- a/src/v1/tests/src/truncated_module_test.rs\n+++ b/src/v1/tests/src/truncated_module_test.rs\n@@ -4,2 +4,3 @@\n fn helper() -> bool { true }\n+#[test]\n"

data fixture_renamed_legacy_test_zero_context_diff: String = "diff --git a/src/v1/tests/src/existing_module_test.rs b/src/v1/tests/src/existing_module_test.rs\n--- a/src/v1/tests/src/existing_module_test.rs\n+++ b/src/v1/tests/src/existing_module_test.rs\n@@ -565 +1168 @@ fn key_is_deterministic_in_its_axes() {\n-fn same_subject_refuses_v1_disk_hit() {\n+fn same_subject_hits_v2_disk() {\n"

data fixture_attribute_only_addition_zero_context_diff: String = "diff --git a/src/v1/tests/src/existing_module_test.rs b/src/v1/tests/src/existing_module_test.rs\n--- a/src/v1/tests/src/existing_module_test.rs\n+++ b/src/v1/tests/src/existing_module_test.rs\n@@ -20,0 +21 @@ fn helper() -> bool { true }\n+#[test]\n"


fn inflow_measured_ids(observation: gunbc.legacy_test_inflow.LegacyTestInflowObservation) -> List<String> {
  match gunbc.legacy_test_inflow.inflow_observation_tally(observation: observation) {
    gunbc.legacy_test_inflow.InflowCountMeasured { count: _, ids } => ids
    gunbc.legacy_test_inflow.InflowCountUnavailable { reason: _ } => ["REFUSED"]
  }
}

fn inflow_measured_count(observation: gunbc.legacy_test_inflow.LegacyTestInflowObservation) -> Int {
  match gunbc.legacy_test_inflow.inflow_observation_tally(observation: observation) {
    gunbc.legacy_test_inflow.InflowCountMeasured { count: n, ids: _ } => n
    gunbc.legacy_test_inflow.InflowCountUnavailable { reason: _ } => 0 - 1
  }
}

test fn inflow_renamed_legacy_test_is_not_an_arrival() -> Bool {
  let observation = gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_renamed_legacy_test_zero_context_diff)
  gunbc.legacy_test_inflow.inflow_observation_is_measured(observation: observation)
    && inflow_measured_count(observation: observation) == 0
}

test fn inflow_attribute_only_addition_without_context_refuses_loudly() -> Bool {
  !gunbc.legacy_test_inflow.inflow_observation_is_measured(
    observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_attribute_only_addition_zero_context_diff),
  )
}

test fn inflow_planted_new_legacy_test_is_detected_by_name() -> Bool {
  inflow_measured_ids(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_new_legacy_test_file_diff),
  ) == ["src/v1/tests/src/planted_inflow_test.rs::planted_arrival"]
}

test fn inflow_attribute_added_above_existing_fn_is_detected_by_name() -> Bool {
  inflow_measured_ids(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_attribute_above_existing_fn_diff),
  ) == ["src/v1/tests/src/existing_module_test.rs::promoted_to_a_test"]
}

test fn inflow_added_floor_witness_is_not_an_arrival() -> Bool {
  inflow_measured_count(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_floor_witness_added_diff),
  ) == 0
}

test fn inflow_touched_legacy_module_without_new_test_is_zero() -> Bool {
  inflow_measured_count(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_legacy_test_touched_without_arrival_diff),
  ) == 0
}

test fn inflow_removed_legacy_test_is_not_an_arrival() -> Bool {
  inflow_measured_count(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_legacy_test_removed_diff),
  ) == 0
}

test fn inflow_seed_test_outside_counted_population_is_zero() -> Bool {
  inflow_measured_count(observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_seed_test_outside_population_diff),
  ) == 0
}

test fn inflow_empty_diff_is_measured_zero_not_refused() -> Bool {
  let observation = gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: "")
  gunbc.legacy_test_inflow.inflow_observation_is_measured(observation: observation)
    && inflow_measured_count(observation: observation) == 0
}

test fn inflow_unresolved_attribute_refuses_rather_than_counting() -> Bool {
  !gunbc.legacy_test_inflow.inflow_observation_is_measured(
    observation: gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: fixture_unresolved_attribute_diff),
  )
}

test fn inflow_failed_observation_refuses_rather_than_reporting_zero() -> Bool {
  let observation = gunbc.legacy_test_inflow.inflow_observation_of_unified_diff_result(
    observed: false,
    diff_text: "",
    failure_reason: "git diff exited nonzero",
  )
  !gunbc.legacy_test_inflow.inflow_observation_is_measured(observation: observation)
    && !gunbc.legacy_test_inflow.inflow_tally_is_measured(tally: gunbc.legacy_test_inflow.inflow_observation_tally(observation: observation))
}

test fn inflow_refusal_has_no_count_to_read() -> Bool {
  let refused = gunbc.legacy_test_inflow.inflow_observation_of_unified_diff_result(
    observed: false,
    diff_text: "",
    failure_reason: "git diff exited nonzero",
  )
  let measured = gunbc.legacy_test_inflow.inflow_observation_of_diff(diff_text: "")
  inflow_measured_count(observation: refused) != inflow_measured_count(observation: measured)
    && inflow_measured_count(observation: measured) == 0
}
