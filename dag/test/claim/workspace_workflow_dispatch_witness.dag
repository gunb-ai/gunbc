module test.claim.workspace_workflow_dispatch_witness

import std.types { Bool, String }
import gunbc.fleet.fleet_converge_workflow {
  WorkspaceAllocationPlan, WorkspaceImageBuild, RevisionJobImageBuild,
  fleet_converge_job_with_steps, fleet_converge_shared_job_if, fleet_converge_dispatch_inputs, fleet_converge_mode_scope, fleet_converge_mode_job_id, fleet_converge_shared_job_id,
  fleet_converge_mode_release_product, CompilerPairOnly,
  fleet_converge_mode_fleet_ssh_key_demand, FleetSshKeyNotConsumed,
}
import gunbc.fleet.fleet_converge_scope { WorkspaceAllocationOnly }
import gunbc.ci.ci_spec { gunbc_ci_workspace_image_build_invoke, gunbc_ci_revision_job_image_build_invoke }
import gunbc.workspace_image_delivery { workspace_image_artifact_paths }
import gunbc.revision_job_image_delivery { revision_job_image_artifact_paths }

test fn workspace_allocation_uses_its_existing_scope() -> Bool {
  (match fleet_converge_mode_scope(mode: WorkspaceAllocationPlan) {
    Present { value: WorkspaceAllocationOnly } => true
    Present { value: _ } => false
    Absent => false
  }) && all([WorkspaceImageBuild, RevisionJobImageBuild], mode =>
    match fleet_converge_mode_scope(mode: mode) { Absent => true Present { value: _ } => false })
}

test fn workspace_operations_use_the_serialized_host_job_without_fleet_credentials() -> Bool {
  all([WorkspaceAllocationPlan, WorkspaceImageBuild, RevisionJobImageBuild], mode =>
    fleet_converge_mode_job_id(mode: mode) == fleet_converge_shared_job_id
      && fleet_converge_mode_release_product(mode: mode) == CompilerPairOnly
      && fleet_converge_mode_fleet_ssh_key_demand(mode: mode) == FleetSshKeyNotConsumed)
}

test fn workspace_image_build_preserves_ownership_and_archives_only_the_product() -> Bool {
  let build = gunbc_ci_workspace_image_build_invoke()
  let paths = workspace_image_artifact_paths()
  string_contains(s: build, pattern: "fakeroot -- ")
    && string_contains(s: build, pattern: "workspace_image_build_wet")
    && string_contains(s: paths, pattern: "/workspace.ext4")
    && !string_contains(s: paths, pattern: "workspace-tree")
    && !string_contains(s: paths, pattern: "squashfs")
}

test fn revision_job_image_build_archives_only_the_product_and_its_digest_receipt() -> Bool {
  let build = gunbc_ci_revision_job_image_build_invoke()
  let paths = revision_job_image_artifact_paths()
  string_contains(s: build, pattern: "fakeroot -- ")
    && string_contains(s: build, pattern: "revision_job_image_build_wet")
    && string_contains(s: paths, pattern: "/revision-job.ext4")
    && string_contains(s: paths, pattern: "/toolchain")
    && string_contains(s: paths, pattern: "build-receipt.txt")
    && !string_contains(s: paths, pattern: "revision-job-tree")
    && !string_contains(s: paths, pattern: "squashfs")
}

test fn fleet_dispatch_stays_within_github_input_limit() -> Bool {
  count(fleet_converge_dispatch_inputs) <= 25
}

// SUPPLIED AT THE BOUNDARY: an empty step list avoids constructing unrelated deployment
// programs. The production job envelope still owns the actual if-condition assignment. Shared
// modes must select it positively; dedicated modes cannot select the credentialed shared job. The job's
// condition is the grant-wait gate (fleet_converge_after_grant_wait_if) around the mode selector, so the
// selector is read as contained in it and the no-negative-clause law is asked of the selector alone.
test fn dedicated_installs_do_not_also_run_the_shared_credentialed_job() -> Bool {
  match fleet_converge_job_with_steps(steps: []).if_condition {
    Absent => false
    Present { value: condition } => string_contains(s: condition, pattern: fleet_converge_shared_job_if)
      && string_contains(s: condition, pattern: "github.event.inputs.mode == 'workspace_image_build'")
      && string_contains(s: condition, pattern: "github.event.inputs.mode == 'revision_job_image_build'")
      && string_contains(s: condition, pattern: "github.event.inputs.mode == 'workspace_allocation_plan'")
      && string_contains(s: condition, pattern: "github.event.inputs.mode == 'plan'")
      && !string_contains(s: condition, pattern: "microvm_controller_install")
      && !string_contains(s: condition, pattern: "dashboard_deploy")
      && !string_contains(s: condition, pattern: "gcp_iam_converge")
      && !string_contains(s: fleet_converge_shared_job_if, pattern: " != ")
  }
}
