module test.claim.belt_occurrence_record_absence_witness

import std.types { Bool, String, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.roadmap_belt_actuate {
  belt_occurrence_attempt_directory_standing,
  belt_occurrence_record_from_launch_observation,
  AttemptDirectoryStanding,
  AttemptDirectoryListed,
  AttemptDirectoryDecided,
  AttemptOccurrenceRecordRead,
  AttemptOccurrenceRecordDecoded,
  AttemptOccurrenceRecordAbsent,
  AttemptOccurrenceRecordRefused,
}
import gunbc.roadmap_dispatch_actuator { DispatchAttemptRef }
import gunbc.filesystem_file_observe { filesystem_entry_presence_of_path, filesystem_file_observation_of_path }
import extdeps.filesystem.filesystem_io {
  FilesystemEntryPresence,
  FilesystemEntryAbsent,
  FilesystemEntryListed,
  FilesystemEntryPresenceIndeterminate,
  FilesystemEntrySubjectRefused,
  FilesystemFileObservation,
  FilesystemFileAbsent,
  FilesystemFileRead,
  FilesystemFileIndeterminate,
  FilesystemFileObservationsDisagree,
  FilesystemFileSubjectRefused,
  filesystem_listing_observation,
  filesystem_entry_presence,
  filesystem_file_observation,
  filesystem_read_outcome,
}

// AN ESTABLISHED ABSENCE IS NO RECORD; AN UNOBSERVED ONE STILL REFUSES. srv1 (2026-10-10) held ten
// dispatch branches older than launch identities -- two with no attempt directory at all, eight
// with a directory and no launch-identity.json -- and each refused the whole live-session census.
//
// The census observes in sequence: the attempt directory's presence first, the launch record only
// when the directory is listed (review 78482: observing both up front joined two instants). The
// pure controls drive each step with supplied boundary values; the two wet claims at the end are
// the inhabitance readings that the real producers emit those shapes for a missing directory --
// Absent from the parent listing, and Indeterminate (never Absent) from the record's own listing,
// which is why the sequenced fold never consults the record when the directory is absent.

data root: String = "/opt/gunbc/attempt-state"
data dir: String = "/opt/gunbc/attempt-state/ts-wf-lamps-v0-ad3401a4a71e004e9"
data launch: String = "/opt/gunbc/attempt-state/ts-wf-lamps-v0-ad3401a4a71e004e9/launch-identity.json"

fn attempt() -> DispatchAttemptRef {
  DispatchAttemptRef {
    node_id: "ts-wf-lamps-v0" as NonEmptyStr,
    branch: "dispatch/ts-wf-lamps-v0-ad3401a4a71e004e9" as NonEmptyStr,
    attempt_key: "d3401a4a71e004e9",
  }
}

fn directory_listed_as(success: Bool, entries: String) -> FilesystemEntryPresence {
  filesystem_entry_presence(
    listing: filesystem_listing_observation(directory: root, success: success, entries: entries, error: "Permission denied (os error 13)"),
    name: "ts-wf-lamps-v0-ad3401a4a71e004e9",
  )
}

fn launch_observed_as(list_success: Bool, entries: String, read_success: Bool, content: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: dir, success: list_success, entries: entries, error: "No such file or directory (os error 2)"),
    name: "launch-identity.json",
    path: launch,
    read: filesystem_read_outcome(content: content, success: read_success, error: "No such file or directory (os error 2)"),
  )
}

fn is_absent(r: AttemptOccurrenceRecordRead) -> Bool {
  match r {
    AttemptOccurrenceRecordAbsent { absence: _ } => true
    AttemptOccurrenceRecordDecoded { record: _ } => false
    AttemptOccurrenceRecordRefused { reason: _ } => false
  }
}

fn is_refused(r: AttemptOccurrenceRecordRead) -> Bool {
  match r {
    AttemptOccurrenceRecordRefused { reason: _ } => true
    AttemptOccurrenceRecordAbsent { absence: _ } => false
    AttemptOccurrenceRecordDecoded { record: _ } => false
  }
}

fn decided_absent(s: AttemptDirectoryStanding) -> Bool {
  match s {
    AttemptDirectoryDecided { read } => is_absent(r: read)
    AttemptDirectoryListed => false
  }
}

fn decided_refused(s: AttemptDirectoryStanding) -> Bool {
  match s {
    AttemptDirectoryDecided { read } => is_refused(r: read)
    AttemptDirectoryListed => false
  }
}

test fn an_attempt_directory_the_root_listing_omits_is_no_record() -> Bool {
  decided_absent(s: belt_occurrence_attempt_directory_standing(
    attempt: attempt(),
    directory: directory_listed_as(success: true, entries: "ts-wf-lamps-v0-a8704c55c32b629f2\nsession-attempts"),
  ))
}

test fn a_root_that_could_not_be_listed_still_refuses() -> Bool {
  decided_refused(s: belt_occurrence_attempt_directory_standing(
    attempt: attempt(),
    directory: directory_listed_as(success: false, entries: ""),
  ))
}

test fn a_listed_directory_defers_to_its_record() -> Bool {
  match belt_occurrence_attempt_directory_standing(
    attempt: attempt(),
    directory: directory_listed_as(success: true, entries: "ts-wf-lamps-v0-ad3401a4a71e004e9"),
  ) {
    AttemptDirectoryListed => true
    AttemptDirectoryDecided { read: _ } => false
  }
}

test fn a_listed_directory_without_a_launch_record_is_no_record() -> Bool {
  is_absent(r: belt_occurrence_record_from_launch_observation(
    attempt: attempt(),
    launch: launch_observed_as(list_success: true, entries: "metering.json\ncommit-outcome-last.json\nintegration\nsubmissions", read_success: false, content: ""),
  ))
}

// THE INSTANT BETWEEN THE TWO OBSERVATIONS: a directory the root listing named and that was gone by
// the time its own listing ran. Its record observation is a failed listing -- Indeterminate -- and
// it refuses rather than reading as absent.
test fn a_directory_that_vanished_after_being_listed_refuses() -> Bool {
  is_refused(r: belt_occurrence_record_from_launch_observation(
    attempt: attempt(),
    launch: launch_observed_as(list_success: false, entries: "", read_success: false, content: ""),
  ))
}

test fn a_listed_record_that_could_not_be_read_still_refuses() -> Bool {
  is_refused(r: belt_occurrence_record_from_launch_observation(
    attempt: attempt(),
    launch: launch_observed_as(list_success: true, entries: "launch-identity.json", read_success: false, content: ""),
  ))
}

test fn a_listed_record_that_does_not_decode_still_refuses() -> Bool {
  is_refused(r: belt_occurrence_record_from_launch_observation(
    attempt: attempt(),
    launch: launch_observed_as(list_success: true, entries: "launch-identity.json", read_success: true, content: "\{not json"),
  ))
}

// INHABITANCE: the real wet producers, executed against the checkout (the claim route reads only
// substrate inputs), over a directory every checkout carries and an entry under it that it does not.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data missing_attempt_directory: String = "dag/std/gunbc-belt-occurrence-witness-no-such-attempt-directory"

test fn the_real_presence_producer_establishes_a_missing_directory_absent() -> Bool {
  match filesystem_entry_presence_of_path(path: missing_attempt_directory) {
    FilesystemEntryAbsent(_) => true
    FilesystemEntryListed { directory: _, name: _ } => false
    FilesystemEntryPresenceIndeterminate { cause: _ } => false
    FilesystemEntrySubjectRefused { directory: _, name: _, cause: _ } => false
  }
}

test fn the_real_record_producer_reads_a_missing_directory_as_indeterminate_not_absent() -> Bool {
  match filesystem_file_observation_of_path(path: join([missing_attempt_directory, "/launch-identity.json"], "")) {
    FilesystemFileIndeterminate { cause: _ } => true
    FilesystemFileAbsent(_) => false
    FilesystemFileRead { path: _, content: _ } => false
    FilesystemFileObservationsDisagree { path: _, cause: _ } => false
    FilesystemFileSubjectRefused { directory: _, name: _, cause: _ } => false
  }
}
