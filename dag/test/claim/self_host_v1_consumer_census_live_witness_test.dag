module test.claim.self_host_v1_consumer_census_live_witness_test

import std.types { Bool }
import gunbc.rust_item_host_observation { RustReferencesObserved, RustReferenceHostRefused }
import gunbc.v1_consumer_census {
  v1_consumers_of, v1_consumer_population,
  v1_bankruptcy_transaction_admitted, V1BlockingCount, V1BlockingCounted, V1BlockingUnmeasured, v1_blocking_count_of,
  ConsumerPopulation, consumer_population_is_complete,
  v1_shim_partition_over, v1_current_rust_references, v1_claimed_successors,
  MintedManifestJoin, MintedManifestJoined, MintedManifestJoinUnobserved, v1_minted_manifest_join
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// SPLIT OUT OF self_host_v1_consumer_census_witness_test.dag SO THE HERMETIC DISCOVERY CORPUS CAN
// RUN. Every fn here reads v1_consumer_population(), which since the Rust reference population
// became a produced observation reaches git.Inspect.HeadCommit, git.Inspect.ListTreePathsAtRevision
// and git.Core.Show through gunbc.rust_item_host_observation observe_rust_references over head_rust_sources. None
// of those carries a mock_response, so under the hermetic envelope the run REFUSES rather than
// skipping, and a refusing discovery member fails its whole batch -- the class
// stage0_rust_host_observation_live_witness_test.dag documents. Publishing mocks is not the answer
// for the same reason it was reverted there: a census whose population is a constant asserts
// nothing about the tree.
//
// WHAT IS LOST, STATED: before the split the assertions here were on the per-PR floor -- but they
// were reading a hand-authored list, so what the floor checked was that the list still said
// what it said. The executing consumer of the live population is now the operator's instrument:
//   gunbc run --source-root dag --source-root src/v2 --entry dag/gunbc/v1/v1_consumer_census.dag --function v1_blocking_consumer_count_report
// and locally this file runs as
//   claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/claim/self_host_v1_consumer_census_live_witness_test.dag --functions <fn,...>
// The bin_witness_wet_entries rows naming this entry, and gunbc.rung_drop
// v1_consumer_census_live_population_off_the_merge_path, carry the population by identity; as
// gunbc.ci_layer_roots excl_bin_wet_reason records, that roster has had no executing consumer
// since 2026-08-15.

// THE LIVE PRODUCER ANSWERS, AND ANSWERS WITH REFERENCES: the tree's own hand Rust outside the
// deletion set is folded, nothing is unscannable, nothing is unattributed, and every produced row
// is cited. The produced grain is the line and the census grain is consumer x authority, so the
// cited column is bounded by the row count, never equal to it by assertion.
fn the_live_reference_population_is_produced() -> Bool {
  match v1_current_rust_references() {
    RustReferenceHostRefused { detail: _ } => false
    RustReferencesObserved { observed_at: v1cc_seen_tree, rows: rs, unattributed: u, unscannable: un } =>
      count(rs) > 0 && count(un) == 0 && count(u) == 0
        && count(v1_shim_partition_over(observed_at: v1cc_seen_tree, rows: rs, unattributed: u).uncitable) == 0
        && count(v1_shim_partition_over(observed_at: v1cc_seen_tree, rows: rs, unattributed: u).cited) > 0
        && count(v1_shim_partition_over(observed_at: v1cc_seen_tree, rows: rs, unattributed: u).cited) <= count(rs)
  }
}

// THE LIVE TREE REFUSES, AND FOR THE REASONS THE CENSUS RECORDS. Stated as a conjunction because
// 'the gate is false' is also what a broken gate returns: the population is a lower bound AND there
// is at least one blocking consumer AND not every consumer blocks -- three independent facts whose
// conjunction is what 'XL-5 has not run yet' means.
fn the_live_transaction_refuses_for_recorded_reasons() -> Bool {
  let p = v1_consumer_population()
  !consumer_population_is_complete(p: p)
    && match v1_blocking_count_of(p: p) {
         V1BlockingCounted { blocking: b, members: m } => b > 0 && b < m
         V1BlockingUnmeasured { reason: _ } => false
       }
}

// THE GATE ITSELF, EXECUTED ON THE LIVE POPULATION, against the most generous realized population
// that can be written -- every successor this census claims, handed to the gate as realized -- so
// the false cannot be coming from an unrealized successor.
fn the_live_gate_refuses_even_with_every_successor_realized() -> Bool {
  let p = v1_consumer_population()
  !v1_bankruptcy_transaction_admitted(population: p, realized: [])
    && !v1_bankruptcy_transaction_admitted(population: p, realized: v1_claimed_successors(rows: v1_consumers_of(p: p)))
}

// THE SEED-LINK JOIN IS OBSERVED ON THE LIVE TREE, and the two directions this census controls are
// clean: no rostered renderer is stale and no token line is unattributed. Undisposed sites are the
// TREE's fact, not this table's -- on a tree that still carries the pre-#10988 probe_manifest edge
// the join reports it undisposed, and that is the true state of that tree -- so they are not
// asserted empty here; they enter the population as Undecided consumers and block.
fn the_live_seed_link_join_is_observed_and_the_roster_is_current() -> Bool {
  match v1_minted_manifest_join() {
    MintedManifestJoinUnobserved { reason: _ } => false
    MintedManifestJoined { observed_at: _, produced: p, undisposed_sites: _, undisposed_uncitable: b, uncitable: uc, stale_rows: c, stale_uncitable: d, unattributed_lines: e } =>
      count(p) > 0 && count(uc) > 0 && count(b) == 0 && count(c) == 0 && count(d) == 0 && count(e) == 0
  }
}

test fn consumer_census_live_reference_population_is_produced() -> Bool { the_live_reference_population_is_produced() }
test fn consumer_census_live_seed_link_join_is_observed_and_the_roster_is_current() -> Bool { the_live_seed_link_join_is_observed_and_the_roster_is_current() }
test fn consumer_census_live_transaction_refuses_for_recorded_reasons() -> Bool { the_live_transaction_refuses_for_recorded_reasons() }
test fn consumer_census_live_gate_refuses_even_with_every_successor_realized() -> Bool { the_live_gate_refuses_even_with_every_successor_realized() }
