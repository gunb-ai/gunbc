  compile_dag_rust_emit_check(
    "module foldcarrier.method\n\nimport std.algebra { list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> List<Int> { xs.fold(init: [], f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_method_emits.rs",
    ["fn gather", "Vec<i64>"],
    []
  )
}

test fn method_call_fold_emits() -> Bool { w_method_call_fold_emits() }

fn w_method_call_fold_carrier_closed() -> Bool {
  compile_dag_rust_emit_check(
    "module foldcarrier.method\n\nimport std.algebra { list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> List<Int> { xs.fold(init: [], f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_method_carrier_closed.rs",
    ["fn gather"],
    ["acc: _"]
  )
}

test fn method_call_fold_carrier_closed() -> Bool { w_method_call_fold_carrier_closed() }

