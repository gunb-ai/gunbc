  compile_dag_rust_emit_check(
    "module foldcarrier.closed\n\nimport std.algebra { list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> List<Int> { fold(xs, init: [0], f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_closed_emits.rs",
    ["fn gather", "Vec<i64>"],
    []
  )
}

test fn closed_init_emits() -> Bool { w_closed_init_emits() }

