module test.claim.fold_carrier_closes_at_step_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// SUBJECT: an open fold carrier (`init: []`) closes at the type the step produces, in BOTH fold forms, so the
// emitted step closure types its accumulator and never renders `|acc: _, ..|` (rustc E0282).
// ROUTE: compile_dag_rust_emit_check runs the seed's real compile and checks the emitted text.
// EACH CASE IS TWO CLAIMS SO A FAILURE IS ATTRIBUTABLE: `<case>_emits` asserts the emission succeeded and carries
// the fold (positive: "fn gather" and "Vec<i64>"); `<case>_carrier_closed` asserts "acc: _" is absent.
// Expected at main (to be measured on a host): every `_emits` PASS; `_carrier_closed` FAIL for free_call_fold,
// method_call_fold, empty_init; PASS for closed_init. Expected at the fix head: all PASS. An `_emits` FAIL is no
// observation for its case. The exact closure-param spelling is not asserted because it has not been observed.

fn w_free_call_fold_emits() -> Bool {
  compile_dag_rust_emit_check(
    "module foldcarrier.free\n\nimport std.algebra { list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> List<Int> { fold(xs, init: [], f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_free_emits.rs",
    ["fn gather", "Vec<i64>"],
    []
  )
}

test fn free_call_fold_emits() -> Bool { w_free_call_fold_emits() }

fn w_free_call_fold_carrier_closed() -> Bool {
  compile_dag_rust_emit_check(
    "module foldcarrier.free\n\nimport std.algebra { list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> List<Int> { fold(xs, init: [], f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_free_carrier_closed.rs",
    ["fn gather"],
    ["acc: _"]
  )
}

test fn free_call_fold_carrier_closed() -> Bool { w_free_call_fold_carrier_closed() }

