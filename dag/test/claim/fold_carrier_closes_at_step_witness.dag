  )
}

test fn closed_init_carrier_closed() -> Bool { w_closed_init_carrier_closed() }

fn w_empty_init_emits() -> Bool {
  compile_dag_rust_emit_check(
    "module foldcarrier.empty\n\nimport std.algebra { Empty, FreeMonoid, list_push }\nimport std.types { Int }\n\nfn gather(xs: List<Int>) -> FreeMonoid<Int> { fold(xs, init: Empty, f: (acc, x) => list_push(acc, x)) }\n",
    "src/foldcarrier_empty_emits.rs",
    ["fn gather", "Vec<i64>"],
    []
  )
}

test fn empty_init_emits() -> Bool { w_empty_init_emits() }

