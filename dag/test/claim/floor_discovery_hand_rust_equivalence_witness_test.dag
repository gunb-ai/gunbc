module test.claim.floor_discovery_hand_rust_equivalence_witness



data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data floor_discovery_hand_rust_equivalence_note: String = "Executes floor_discovery_producer.dag on fixtures (owned-data transport projection, filename hygiene, test-decl scan, wire-contract scan/sidecar, sidecar placement) with RED perturbation controls. Producer authority is exercised here; Rust bridge cross-checks (discover_floor_witness_roster, scan_wire_contract_decl_names) are named in gunbc.floor_discovery_scaffold and proven by cargo test sidecar_placement_hygiene_tests in cli_run.rs on the same fixture spellings."

test fn floor_entry_resolution_host_boundary_is_declared() -> Bool {
  gunbc.floor_discovery_scaffold.floor_entry_resolution_host_boundary_discriminator == "resolve_workspace_entry"
    && string_contains(
      s: gunbc.floor_discovery_scaffold.floor_entry_resolution_host_boundary_note,
      pattern: "WorkspaceRootRelativeEntry",
    )
    && string_contains(
      s: gunbc.floor_discovery_scaffold.floor_entry_resolution_host_boundary_note,
      pattern: "FLOOR_DISCOVERY_PRODUCER_ENTRY",
    )
    && string_contains(
      s: gunbc.floor_discovery_scaffold.floor_entry_resolution_host_boundary_note,
      pattern: "v1-hand-queue-drain",
    )
}

data fixture_witness_entry: String = "dag/test/claim/floor_discovery_roster_fixture_test.dag"
data fixture_witness_function: String = "floor_discovery_roster_fixture_witness"
data fixture_test_fn_content: String = "test fn floor_discovery_roster_fixture_witness() -> Bool { true }\n"
data fixture_test_data_content: String = "test data floor_discovery_data_fixture: Bool = true\n"
data fixture_misplaced_entry: String = "src/v2/lens/example.dag"
data fixture_barren_test_entry: String = "dag/test/claim/floor_discovery_barren_fixture_test.dag"
data fixture_barren_test_content: String = "module test.claim.floor_discovery_barren_fixture_test\n\nfn floor_discovery_barren_helper() -> Bool { true }\n"
data fixture_misplaced_wire_contract_entry: String = "dag/test/fixture/floor_discovery/misplaced_wire_contract.dag"
data fixture_live_tree_entry: String = "dag/test/claim/floor_discovery_roster_fixture_test.dag"

fn fixture_wire_contract_coproduct_content() -> String {
  concat(
    "data foo: Coproduct",
    "WireContract = { coproduct: \"X\", encoding: UntaggedVariant }"
  )
}

fn fixture_wire_contract_variant_content() -> String {
  concat("data bar: Variant", "Encoding = llm_snake_wire_contract")
}

fn fixture_misplaced_wire_contract_content() -> String {
  concat(
    "data anthropic_chat_message_wire_contract: Coproduct",
    "WireContract = { coproduct: \"AnthropicChatMessage\", encoding: UntaggedVariant }\n"
  )
}

fn fixture_live_tree_malformed_variant_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = MaybeLive\n"
  )
}

fn fixture_live_tree_duplicate_decl_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = ReadsLiveTree\n",
    "data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly\n"
  )
}

fn fixture_live_tree_trailing_comment_content() -> String {
  concat(
    "module m\n\ndata live_tree_disposition: LiveTreeDisposition = ReadsLiveTree // was SubstrateInputsOnly\n"
  )
}

fn fixture_bool_witness_record() -> v2.compiler.discovery_enumeration.OwnedDataDeclRecord {
  v2.compiler.discovery_enumeration.OwnedDataDeclRecord {
    entry: "dag/gunbc/floor_discovery_scaffold.dag",
    module: "gunbc.floor_discovery_scaffold",
    decl_name: "unified_claim_floor_discovery_fixture",
    initializer: v2.compiler.discovery_enumeration.OwnedBoolWitnessClaimInit {
      witness_entry: fixture_witness_entry,
      witness_function: fixture_witness_function
    }
  }
}

fn fixture_bool_witness_record_empty_transport() -> v2.compiler.discovery_enumeration.OwnedDataDeclRecord {
  v2.compiler.discovery_enumeration.OwnedDataDeclRecord {
    entry: "dag/gunbc/floor_discovery_scaffold.dag",
    module: "gunbc.floor_discovery_scaffold",
    decl_name: "unified_claim_floor_discovery_fixture_empty",
    initializer: v2.compiler.discovery_enumeration.OwnedBoolWitnessClaimInit {
      witness_entry: "",
      witness_function: ""
    }
  }
}

fn list_contains_string(xs: List<String>, needle: String) -> Bool {
  v2.std.algebra.fold_list(
    xs: xs,
    empty: false,
    cons: fn(found, x) {
      if found {
        true
      } else {
        x == needle
      }
    }
  )
}

fn floor_discovery_rows_contain_entry_function(
  rows: List<v2.workflow.floor_discovery.FloorDiscoveryRow>,
  entry: String,
  function: String
) -> Bool {
  v2.std.algebra.fold_list(
    xs: rows,
    empty: false,
    cons: fn(found, row) {
      if found {
        true
      } else {
        (row.entry == entry) && (row.function == function)
      }
    }
  )
}

fn floor_discovery_first_row_label(rows: List<v2.workflow.floor_discovery.FloorDiscoveryRow>) -> String {
  match v2.std.algebra.list_head(xs: rows) {
    v2.std.algebra.HeadFound { value: row } => row.label
    v2.std.algebra.HeadAbsent => ""
  }
}

fn floor_discovery_first_row_reads_substrate_only(rows: List<v2.workflow.floor_discovery.FloorDiscoveryRow>) -> Bool {
  match v2.std.algebra.list_head(xs: rows) {
    v2.std.algebra.HeadFound { value: row } => row.reads_live_tree == v2.std.live_tree.SubstrateInputsOnly
    v2.std.algebra.HeadAbsent => false
  }
}

test fn floor_discovery_hand_rust_scaffold_binds_producer_authority() -> Bool {
  match gunbc.floor_discovery_scaffold.floor_discovery_hand_rust_scaffold {
    std.disposition.Scaffold { dissolves_to: std.disposition.SingleAuthority, bind: _ } => true
    _ => false
  }
}

test fn floor_discovery_dissolve_trigger_names_producer_authority() -> Bool {
  string_contains(s: std.dissolution.dissolution_description(condition: gunbc.floor_discovery_scaffold.floor_discovery_dissolve_trigger), pattern: "floor_discovery_producer")
    && string_contains(s: std.dissolution.dissolution_description(condition: gunbc.floor_discovery_scaffold.floor_discovery_dissolve_trigger), pattern: "dissolve-on")
}

test fn floor_discovery_surface_text_scan_scaffold_on_carrier() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_surface_text_scan_scaffold {
    std.disposition.Scaffold {
      dissolves_to: std.disposition.SingleAuthority,
      bind: std.decl_ref.DeclarationRef {
        module_path: "v2.workflow.floor_naming_hygiene",
        decl_name: "floor_discovery_scan_test_decl_names",
        field: std.decl_ref.WholeDeclaration
      }
    } => true
    _ => false
  }
}


test fn floor_discovery_producer_entry_is_canonical() -> Bool {
  gunbc.floor_discovery_scaffold.floor_discovery_producer_entry == "src/v2/workflow/floor_discovery_producer.dag"
}

test fn floor_discovery_producer_owned_data_row_holds() -> Bool {
  match v2.workflow.floor_discovery_producer.discover_floor_corpus_rows_from_host_facts(
    source_roots: [],
    exclude_substrings: [],
    owned_data_records: [fixture_bool_witness_record()]
  ) {
    v2.workflow.floor_discovery_producer.FloorDiscoveryAccepted { rows: rows } =>
      (v2.std.algebra.length(xs: rows) == 1)
        && floor_discovery_rows_contain_entry_function(
          rows: rows,
          entry: fixture_witness_entry,
          function: fixture_witness_function
        )
        && (floor_discovery_first_row_label(rows: rows) == "floor_discovery_fixture")
        && floor_discovery_first_row_reads_substrate_only(rows: rows)
    v2.workflow.floor_discovery_producer.FloorDiscoveryRefused { reason: _ } => false
  }
}

test fn floor_discovery_producer_empty_transport_red_control() -> Bool {
  match v2.workflow.floor_discovery_producer.discover_floor_corpus_rows_from_host_facts(
    source_roots: [],
    exclude_substrings: [],
    owned_data_records: [fixture_bool_witness_record_empty_transport()]
  ) {
    v2.workflow.floor_discovery_producer.FloorDiscoveryAccepted { rows: _ } => false
    v2.workflow.floor_discovery_producer.FloorDiscoveryRefused { reason: msg } =>
      string_contains(s: msg, pattern: "malformed BoolWitnessClaim witness")
  }
}

test fn floor_discovery_scan_test_fn_decl_holds() -> Bool {
  list_contains_string(
    xs: v2.workflow.floor_naming_hygiene.floor_discovery_scan_test_decl_names(content: fixture_test_fn_content),
    needle: fixture_witness_function
  )
}

test fn floor_discovery_scan_test_data_decl_holds() -> Bool {
  list_contains_string(
    xs: v2.workflow.floor_naming_hygiene.floor_discovery_scan_test_decl_names(content: fixture_test_data_content),
    needle: "floor_discovery_data_fixture"
  )
}

test fn floor_discovery_sidecar_test_decl_misplaced_red_control() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_test_decl_sidecar_violation(entry_path: fixture_misplaced_entry) {
    v2.std.optional.Present { value: v } =>
      (v.entry_path == fixture_misplaced_entry)
        && string_contains(s: v.required_suffix, pattern: "_test.dag")
    v2.std.optional.Absent => false
  }
}

test fn floor_discovery_sidecar_test_decl_allowed_holds() -> Bool {
  match v2.workflow.floor_discovery.floor_discovery_test_decl_sidecar_violation(
    entry_path: "dag/test/claim/floor_discovery_roster_fixture_test.dag"
  ) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

test fn floor_discovery_equivalence_wire_contract_coproduct_scan_holds() -> Bool {
  v2.workflow.floor_discovery_producer.floor_discovery_content_has_wire_contract_decl(
    content: fixture_wire_contract_coproduct_content()
  )
}

test fn floor_discovery_equivalence_wire_contract_variant_scan_holds() -> Bool {
  v2.workflow.floor_discovery_producer.floor_discovery_content_has_wire_contract_decl(content: fixture_wire_contract_variant_content())
}

test fn floor_discovery_equivalence_misplaced_wire_contract_refuses_holds() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_wire_contract_sidecar_refusal_for_content(
    repo_path: fixture_misplaced_wire_contract_entry,
    content: fixture_misplaced_wire_contract_content()
  ) {
    v2.std.optional.Present { value: msg } =>
      string_contains(s: msg, pattern: "wire-contract decls")
        && string_contains(s: msg, pattern: "_contracts.dag")
        && string_contains(s: msg, pattern: fixture_misplaced_wire_contract_entry)
    v2.std.optional.Absent => false
  }
}

// The `*_test.dag` suffix is one half of a two-sided rule: a `test`-marked decl may live
// ONLY in such a file (the misplaced-decl control above), and such a file must declare at
// least ONE. Without this second half a witness file enrolls nothing and the floor reports
// nothing missing -- discovery cannot distinguish "no witnesses here" from "no witnesses
// authored yet", so the file is silently uncovered. Nine such files stood in tree.
test fn floor_discovery_barren_test_sidecar_refuses_red_control() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_barren_test_sidecar_refusal_for_content(
    repo_path: fixture_barren_test_entry,
    content: fixture_barren_test_content
  ) {
    v2.std.optional.Present { value: msg } =>
      string_contains(s: msg, pattern: "test fn")
        && string_contains(s: msg, pattern: fixture_barren_test_entry)
    v2.std.optional.Absent => false
  }
}

// The positive control: the SAME path with one authored test decl must be admitted, so the
// row above discriminates on the decl scan rather than on the filename.
test fn floor_discovery_populated_test_sidecar_admitted_holds() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_barren_test_sidecar_refusal_for_content(
    repo_path: fixture_barren_test_entry,
    content: fixture_test_fn_content
  ) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

// The other direction: an ordinary module declaring no test decls is not barren -- the rule
// is scoped to entries the sidecar suffix claims, never to the corpus at large.
test fn floor_discovery_non_test_entry_is_never_barren_holds() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_barren_test_sidecar_refusal_for_content(
    repo_path: fixture_misplaced_entry,
    content: fixture_barren_test_content
  ) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

test fn floor_discovery_barren_refusal_reason_carries_its_path_holds() -> Bool {
  let msg = v2.workflow.floor_discovery_producer.floor_discovery_sidecar_refusal_reason(violations: [
    v2.workflow.floor_discovery.FloorDiscoverySidecarViolation {
      entry_path: fixture_barren_test_entry,
      kind: v2.workflow.floor_discovery.BarrenTestSidecar,
      required_suffix: v2.workflow.floor_naming_hygiene.floor_test_sidecar_suffix
    }
  ])
  string_contains(s: msg, pattern: fixture_barren_test_entry)
    && string_contains(s: msg, pattern: "at least one")
}

test fn floor_discovery_sidecar_combined_refusal_reports_both_holds() -> Bool {
  let msg = v2.workflow.floor_discovery_producer.floor_discovery_sidecar_refusal_reason(violations: [
    v2.workflow.floor_discovery.FloorDiscoverySidecarViolation {
      entry_path: fixture_misplaced_entry,
      kind: v2.workflow.floor_discovery.TestMarkedDecl,
      required_suffix: v2.workflow.floor_naming_hygiene.floor_test_sidecar_suffix
    },
    v2.workflow.floor_discovery.FloorDiscoverySidecarViolation {
      entry_path: fixture_misplaced_wire_contract_entry,
      kind: v2.workflow.floor_discovery.WireContractDecl,
      required_suffix: v2.workflow.floor_naming_hygiene.floor_wire_contract_sidecar_suffix
    }
  ])
  string_contains(s: msg, pattern: "`test`-marked")
    && string_contains(s: msg, pattern: fixture_misplaced_entry)
    && string_contains(s: msg, pattern: "wire-contract decls")
    && string_contains(s: msg, pattern: fixture_misplaced_wire_contract_entry)
}

test fn floor_discovery_live_tree_malformed_variant_refuses_red_control() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_malformed_variant_content()
  ) {
    v2.std.optional.Present { value: msg } => string_contains(s: msg, pattern: "unknown variant")
    v2.std.optional.Absent => false
  }
}

test fn floor_discovery_live_tree_duplicate_decl_refuses_red_control() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_duplicate_decl_content()
  ) {
    v2.std.optional.Present { value: msg } => string_contains(s: msg, pattern: "more than once")
    v2.std.optional.Absent => false
  }
}

test fn floor_discovery_live_tree_trailing_comment_refuses_red_control() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: fixture_live_tree_trailing_comment_content()
  ) {
    v2.std.optional.Present { value: msg } => string_contains(s: msg, pattern: "unknown variant")
    v2.std.optional.Absent => false
  }
}

test fn floor_discovery_live_tree_disposition_note_sibling_not_declaration_holds() -> Bool {
  match v2.workflow.floor_discovery_producer.floor_discovery_entry_live_tree_disposition_refusal_for_content(
    entry_path: fixture_live_tree_entry,
    content: "module m\n\ndata live_tree_disposition_note: String = \"doc row\"\n"
  ) {
    v2.std.optional.Absent => true
    v2.std.optional.Present { value: _ } => false
  }
}

test fn floor_discovery_equivalence_rust_tests_named() -> Bool {
  string_contains(
    s: gunbc.floor_discovery_scaffold.floor_discovery_equivalence_test_sidecar_misplaced,
    pattern: "misplaced_wire_contract_decl_drives_discover_to_err"
  ) && string_contains(
    s: gunbc.floor_discovery_scaffold.floor_discovery_equivalence_test_scan_wire_contract,
    pattern: "scan_detects_coproduct_wire_contract_data"
  ) && string_contains(
    s: gunbc.floor_discovery_scaffold.floor_discovery_equivalence_test_narrowed_corpus_control,
    pattern: "clean_dag_file_leaves_narrowed_discovery_ok"
  )
}
