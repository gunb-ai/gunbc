module test.claim.floor_discovery_hand_rust_equivalence_witness

import gunbc.floor_discovery_scaffold {
  floor_discovery_dissolve_trigger,
  floor_discovery_producer_entry,
}
import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data floor_discovery_hand_rust_equivalence_note: String = "Receipt that the HAND-RUST discover_floor_corpus_rows_inner roster walk was deleted after floor_discovery_producer.dag dual-run equivalence went green. The .dag producer is now the sole live authority; cli_run.rs retains only the thin Wet realize bridge (discover_floor_corpus_rows_from_dag_producer + post-validation)."

test fn floor_discovery_dissolve_trigger_names_producer_authority() -> Bool {
  string_contains(s: floor_discovery_dissolve_trigger, pattern: "floor_discovery_producer")
    && string_contains(s: floor_discovery_dissolve_trigger, pattern: "LANDED")
}

test fn floor_discovery_producer_entry_is_canonical() -> Bool {
  floor_discovery_producer_entry == "src/v2/workflow/floor_discovery_producer.dag"
}
