module test.claim.design_palette_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn witness_catalog_admissible() -> Bool {
  gunbc.design.catalog.catalog_admissible()
    && gunbc.design.palette.swatch_set_admissible(s: gunbc.design.catalog.island_pastel)
    && gunbc.design.palette.swatch_set_admissible(s: gunbc.design.catalog.okabe_ito)
    && gunbc.design.palette.swatch_set_admissible(s: gunbc.design.catalog.solarized)
}

test fn witness_hex_serialization_matches_authored() -> Bool {
  gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_mint) == "#9dffb0"
    && gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_aqua) == "#81f1f7"
    && gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_ivory) == "#fffffa"
    && gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_camel) == "#c48d3f"
    && gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_butter) == "#fff563"
    && gunbc.design.palette.swatch_paint(sw: gunbc.design.catalog.island_loam) == "#724d15"
}

test fn witness_pairing_matrix_total() -> Bool {
  gunbc.design.palette.graded_pairings(s: gunbc.design.catalog.island_pastel).length() == 30
}

test fn witness_camel_ivory_near_miss() -> Bool {
  match extdeps.accessibility.wcag_contrast.srgb8_contrast_ratio_x100(a: island_camel.color, b: island_ivory.color) {
    Present { value: r } => r >= 280 && r < 300
      && gunbc.design.palette.grade_rank(g: gunbc.design.palette.grade_of_contrast(contrast_x100: r)) == 0
    Absent => false
  }
}

fn authored_five() -> gunbc.design.palette.SwatchSet {
  gunbc.design.palette.SwatchSet {
    name: "island-pastel-authored",
    provenance: island_pastel.provenance,
    members: fold(island_pastel.members, init: [], f: (acc, m) =>
      if m.swatch.name == "loam" { acc } else { concat(acc, [m]) }),
  }
}

test fn witness_authored_set_has_no_text_pairing() -> Bool {
  let five = authored_five()
  gunbc.design.palette.swatches_of(s: five).length() == 5
    && !gunbc.design.palette.set_text_capable(s: five)
    && gunbc.design.palette.pairings_at_least(s: five, min_rank: 1).length() == 0
}

test fn witness_loam_carries_text_capability() -> Bool {
  gunbc.design.palette.set_text_capable(s: gunbc.design.catalog.island_pastel)
    && extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: island_loam.color, b: island_mint.color, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: island_loam.color, b: island_aqua.color, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: island_loam.color, b: island_butter.color, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths)
    && extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: island_loam.color, b: island_ivory.color, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aaa_normal_text_hundredths)
    && gunbc.design.palette.pairings_at_least(s: gunbc.design.catalog.island_pastel, min_rank: 2).length() == 8
}

test fn witness_grade_kernel_discriminates() -> Bool {
  let black = extdeps.color.srgb.Srgb8 { r: 0, g: 0, b: 0 }
  let white = extdeps.color.srgb.Srgb8 { r: 255, g: 255, b: 255 }
  match extdeps.accessibility.wcag_contrast.srgb8_contrast_ratio_x100(a: black, b: white) {
    Present { value: r_bw } =>
      r_bw == 2100
        && gunbc.design.palette.grade_rank(g: gunbc.design.palette.grade_of_contrast(contrast_x100: 2100)) == 3
        && match extdeps.accessibility.wcag_contrast.srgb8_contrast_ratio_x100(a: island_mint.color, b: island_mint.color) {
          Present { value: r_mm } =>
            r_mm == 100
              && gunbc.design.palette.grade_rank(g: gunbc.design.palette.grade_of_contrast(contrast_x100: 100)) == 0
              && !extdeps.color.srgb.srgb8_admissible(c: extdeps.color.srgb.Srgb8 { r: 256, g: 0, b: 0 })
          Absent => false
        }
    Absent => false
  }
}

test fn witness_camel_hsl_projection() -> Bool {
  match extdeps.color.srgb.srgb8_to_hsl_projection(c: island_camel.color) {
    Present { value: proj } => match proj {
      extdeps.color.srgb.Chromatic { h, s_pct, l_pct } => h == 35 && s_pct == 53 && l_pct == 51
      extdeps.color.srgb.Achromatic { l_pct: _ } => false
    }
    Absent => false
  }
}

test fn witness_hsl_projection_red_on_off_by_one_hue() -> Bool {
  match extdeps.color.srgb.srgb8_to_hsl_projection(c: island_camel.color) {
    Present { value: proj } => match proj {
      extdeps.color.srgb.Chromatic { h, s_pct, l_pct } => !(h == 36 && s_pct == 53 && l_pct == 51)
      extdeps.color.srgb.Achromatic { l_pct: _ } => true
    }
    Absent => false
  }
}

test fn witness_achromatic_maps_to_variant_not_hue_zero() -> Bool {
  match extdeps.color.srgb.srgb8_to_hsl_projection(c: extdeps.color.srgb.Srgb8 { r: 128, g: 128, b: 128 }) {
    Present { value: proj } => match proj {
      extdeps.color.srgb.Achromatic { l_pct: _ } => true
      extdeps.color.srgb.Chromatic { h: _, s_pct: _, l_pct: _ } => false
    }
    Absent => false
  }
}

test fn witness_chromatic_still_projects_hue() -> Bool {
  match extdeps.color.srgb.srgb8_to_hsl_projection(c: extdeps.color.srgb.Srgb8 { r: 255, g: 0, b: 0 }) {
    Present { value: proj } => match proj {
      extdeps.color.srgb.Chromatic { h, s_pct, l_pct: _ } => h >= 0 && s_pct > 0
      extdeps.color.srgb.Achromatic { l_pct: _ } => false
    }
    Absent => false
  }
}

test fn witness_gray_never_yields_hue_zero_as_red() -> Bool {
  match extdeps.color.srgb.srgb8_to_hsl_projection(c: extdeps.color.srgb.Srgb8 { r: 127, g: 127, b: 127 }) {
    Present { value: proj } => match proj {
      extdeps.color.srgb.Chromatic { h: 0, s_pct: 0, l_pct: _ } => false
      extdeps.color.srgb.Chromatic { h: _, s_pct: _, l_pct: _ } => true
      extdeps.color.srgb.Achromatic { l_pct: _ } => true
    }
    Absent => false
  }
}

test fn witness_camel_passes_quiet_envelope() -> Bool {
  gunbc.design.material.quiet_envelope_srgb8(c: island_camel.color)
}

test fn witness_mint_refused_by_quiet_envelope() -> Bool {
  !gunbc.design.material.quiet_envelope_srgb8(c: island_mint.color)
}

test fn witness_ivory_refused_despite_near_achromatic_oklch() -> Bool {
  !gunbc.design.material.quiet_envelope_srgb8(c: island_ivory.color)
}

data ivory_hsl_proxy_defect_note: String = "Teaching case: ivory (255,255,250) is refused by the HSL quiet_envelope despite perceptual near-achromatic OKLCH chroma (~0.007) — documents the HSL-proxy defect that design-register-library.md sect 10 schedules for OKLCH reground; this witness pins the defect, it does not fix it."

test fn witness_cited_palette_counts() -> Bool {
  gunbc.design.palette.swatches_of(s: gunbc.design.catalog.okabe_ito).length() == 8
    && gunbc.design.palette.swatches_of(s: gunbc.design.catalog.solarized).length() == 16
    && palette_catalog.length() == 3
}

fn ladder_step_matches_catalog(step_name: String, step_color: extdeps.color.srgb.Srgb8) -> Bool {
  fold(extdeps.color.solarized.solarized_swatches, init: false, f: (found, row) =>
    found || (row.name == step_name
      && row.color.r == step_color.r
      && row.color.g == step_color.g
      && row.color.b == step_color.b))
}

test fn witness_solarized_base_ladder_order_and_count() -> Bool {
  solarized_base_ladder.length() == 8
    && all(extdeps.color.solarized.solarized_base_ladder, step => ladder_step_matches_catalog(step_name: step.name, step_color: step.color))
}

fn has_solarized_mode_pair(dark: String, light: String) -> Bool {
  fold(extdeps.color.solarized.solarized_base_mode_pairs, init: false, f: (found, p) =>
    found || (p.dark_role == dark && p.light_role == light))
}

fn solarized_mode_partner(name: String) -> String {
  if name == "base03" { "base3" }
  else if name == "base3" { "base03" }
  else if name == "base02" { "base2" }
  else if name == "base2" { "base02" }
  else if name == "base01" { "base1" }
  else if name == "base1" { "base01" }
  else if name == "base00" { "base0" }
  else if name == "base0" { "base00" }
  else { name }
}

test fn witness_solarized_base_mode_pairing_involution() -> Bool {
  solarized_base_mode_pairs.length() == 4
    && has_solarized_mode_pair(dark: "base03", light: "base3")
    && has_solarized_mode_pair(dark: "base02", light: "base2")
    && has_solarized_mode_pair(dark: "base01", light: "base1")
    && has_solarized_mode_pair(dark: "base00", light: "base0")
    && solarized_mode_partner(name: "base03") == "base3"
    && solarized_mode_partner(name: solarized_mode_partner(name: "base03")) == "base03"
}

test fn witness_base16_digit_refuses_out_of_range() -> Bool {
  extdeps.numeric.base16.hex_digit_char_lower(d: 16) == extdeps.numeric.base16.base16_digit_refusal_sentinel
    && extdeps.numeric.base16.hex_digit_char_lower(d: -1) == extdeps.numeric.base16.base16_digit_refusal_sentinel
}

test fn witness_uint8_channel_inclusive_max_value_present() -> Bool {
  match std.integer.uint8_channel_inclusive_max_value_derived() {
    Present { value: derived } => derived == 255
    Absent => false
  }
}

test fn witness_workspace_for_use_completion_admissible() -> Bool {
  gunbc.design.palette.swatch_set_for_use_admissible(u: gunbc.roadmap_style.island_pastel_for_workspace)
    && gunbc.design.palette.swatches_for_use(u: gunbc.roadmap_style.island_pastel_for_workspace).length() == 10
    && gunbc.design.palette.swatches_of(s: gunbc.design.catalog.island_pastel).length() == 6
    && gunbc.design.palette.swatch_paint(sw: gunbc.roadmap_style.island_venom) == "#8a2f23"
}

test fn witness_in_family_inks_carry_their_fills() -> Bool {
  match gunbc.design.palette.grade_pairing(figure: gunbc.roadmap_style.island_mint_ink, ground: gunbc.design.catalog.island_mint) {
    Present { value: p } => gunbc.design.palette.grade_rank(g: p.grade) >= 2
    Absent => false
  }
    && match gunbc.design.palette.grade_pairing(figure: gunbc.roadmap_style.island_butter_ink, ground: gunbc.design.catalog.island_butter) {
      Present { value: p } => gunbc.design.palette.grade_rank(g: p.grade) >= 2
      Absent => false
    }
    && match gunbc.design.palette.grade_pairing(figure: gunbc.roadmap_style.island_aqua_ink, ground: gunbc.design.catalog.island_aqua) {
      Present { value: p } => gunbc.design.palette.grade_rank(g: p.grade) >= 2
      Absent => false
    }
}

test fn witness_venom_carries_ivory_text_and_refuses_loam() -> Bool {
  match gunbc.design.palette.grade_pairing(figure: gunbc.design.catalog.island_ivory, ground: gunbc.roadmap_style.island_venom) {
    Present { value: on_ivory } => match gunbc.design.palette.grade_pairing(figure: gunbc.roadmap_style.island_venom, ground: gunbc.design.catalog.island_loam) {
      Present { value: on_loam } =>
        gunbc.design.palette.grade_rank(g: on_ivory.grade) == 3
          && gunbc.design.palette.grade_rank(g: on_loam.grade) == 0
      Absent => false
    }
    Absent => false
  }
}

test fn witness_graduated_default_clears_text_aa() -> Bool {
  count(gunbc.roadmap_style.workspace_band_paints()) == 5
    && all(gunbc.roadmap_style.workspace_band_paints(), p =>
      extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: p.ink.color, b: p.fill.color, threshold_hundredths: extdeps.accessibility.wcag_contrast.wcag_aa_normal_text_hundredths))
}

test fn witness_pressed_stop_derivation_and_legibility() -> Bool {
  gunbc.design.palette.swatch_paint(sw: gunbc.design.palette.Swatch { name: "probe", color: gunbc.roadmap_style.pressed_stop(c: extdeps.color.srgb.Srgb8 { r: 0, g: 158, b: 115 }) }) == "#008560"
    && all(gunbc.roadmap_style.workspace_band_paints(), p =>
      extdeps.accessibility.wcag_contrast.srgb8_contrast_at_least(a: p.ink.color, b: gunbc.roadmap_style.pressed_stop(c: p.fill.color), threshold_hundredths: wcag_aa_large_text_and_graphics_hundredths))
}

test fn witness_for_use_refuses_empty_and_duplicate() -> Bool {
  !gunbc.design.palette.swatch_set_for_use_admissible(u: gunbc.design.palette.SwatchSetForUse { name: "x", base: gunbc.design.catalog.island_pastel, completions: [], use_note: "control" })
    && !gunbc.design.palette.swatch_set_for_use_admissible(u: gunbc.design.palette.SwatchSetForUse { name: "x", base: gunbc.design.catalog.island_pastel, completions: [gunbc.design.palette.swatch_filed(sw: gunbc.design.palette.Swatch { name: "mint", color: island_venom.color })], use_note: "control" })
}

