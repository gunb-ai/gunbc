module test.claim.review_sheet_format_target_witness

import std.types { Bool, String, NonEmptyStr, Int, List }
import extdeps.google.sheets {
  SpreadsheetRead,
  SheetsSheetRead,
  SheetsSheetPropertiesRead,
  sheets_field_sheet_id,
  sheets_sheet_id_read,
}
import gunbc.review_sheet_tab_locator {
  ReviewTabStanding,
  TabLocated,
  TabAbsent,
  TabAmbiguous,
  TabUnreadable,
  LocatedReviewTab,
  review_tab_standing_from_read,
}
import gunbc.review_sheet_format_actuator {
  FormatRequestPlan,
  format_request_plan,
  review_sheet_format_grid_field_mask,
  review_sheet_format_meta_field_mask,
  located_sheet,
  HeaderRangeStanding,
  HeaderRangeWire,
  HeaderRangeUnqualifiable,
  review_sheet_header_range,
  review_sheet_header_cells,
}
import gunbc.review_sheet_projection { ci_prospect_sheet_schema }

// THE SUBJECT IS THE ADDRESSING, NOT THE FORMATTING. gunbc.review_sheet_format_actuator sends
// three kinds of batchUpdate request and every one of them names a sheetId. Until this change all
// seven named a first-sheet constant of 0 -- so the
// formatter wrote to whichever tab happened to be first in a workbook whose tab identity nothing
// had established. format_request_plan derives all seven from a located tab BEFORE any is sent,
// which is what makes the addressing a value a claim can read.
//
// WHAT THIS DISCRIMINATES AND WHAT IT DOES NOT. It reddens on a plan built from the constant, on a
// plan that takes its id from anywhere but the located tab, and on a header range that is not
// qualified by the located title. It does NOT reach the wire: a step function rewritten to ignore
// the request it was handed would pass this, and closing that needs the three batchUpdate
// operations in extdeps.google.sheets_mock_corpus, which carries only GetValues and
// BatchUpdateValues. That is the trigger, stated rather than implied.

// THE ONLY WAY TO A LocatedReviewTab, HERE AS ANYWHERE. The carrier is sole_constructor and the
// mint is admit_callers-sealed, so this witness cannot write the record it needs -- it supplies a
// response at the locator's interface and takes what the locator makes of it, which is the same
// route production takes with a response Sheets supplied. The refusal that this is the only route
// is test.claim.review_sheet_tab_refusal_probe_witness.
fn located_tab_for_witness(sheet_id: Int, title: String) -> ReviewTabStanding {
  review_tab_standing_from_read(
    spreadsheet_id: "1ciProspectSheetFileId" as NonEmptyStr,
    read: SpreadsheetRead {
      spreadsheetId: none,
      sheets: Present {
        value: [
          SheetsSheetRead {
            properties: Present {
              value: SheetsSheetPropertiesRead {
                sheetId: Present { value: sheet_id },
                title: Present { value: title },
                index: Present { value: 0 },
                gridProperties: none,
              }
            },
            data: none,
            conditionalFormats: none,
          },
        ]
      },
    },
  )
}

data witness_located_sheet_id: Int = 1836271154

// THE FOLD IS THE WITNESS'S, NOT THE ACTUATOR'S. An earlier cut declared
// format_plan_sheet_ids beside format_request_plan, where no production caller ever read it --
// a declaration whose only consumer is a claim, which DESIGN section 3c calls dangling
// (review 68522). FormatRequestPlan's fields are readable from here, so the claim reads the
// record production really builds and the actuator declares nothing for the test's benefit.
fn plan_sheet_ids(plan: FormatRequestPlan) -> List<Int> {
  [
    plan.freeze.sheet_id, plan.header.sheet_id, plan.opportunity.sheet_id,
    plan.arbitrage.sheet_id, plan.incompatible.sheet_id, plan.required.sheet_id,
    plan.replay.sheet_id,
  ]
}

fn plan_sheet_ids_for(sheet_id: Int, title: String) -> List<Int> {
  match located_tab_for_witness(sheet_id: sheet_id, title: title) {
    TabLocated { tab: t } =>
      plan_sheet_ids(plan: format_request_plan(tab: t, schema: ci_prospect_sheet_schema(), standing_col: 3))
    TabAbsent => []
    TabAmbiguous { candidates: _ } => []
    TabUnreadable { cause: _ } => []
  }
}

// EVERY REQUEST, NOT ONE OF THEM. The freeze, the header band and the five conditional rules are
// seven separate batchUpdates and each carries its own sheetId, so a mutation that reverts ONE of
// them to the constant is exactly the defect a claim over a single request would miss.
test fn every_batch_update_request_in_the_plan_addresses_the_located_sheet_id() -> Bool {
  plan_sheet_ids_for(sheet_id: witness_located_sheet_id, title: "Prospects 2026")
    == [
      witness_located_sheet_id, witness_located_sheet_id, witness_located_sheet_id,
      witness_located_sheet_id, witness_located_sheet_id, witness_located_sheet_id,
      witness_located_sheet_id,
    ]
}

// THE POSITIVE CONTROL FOR THE ABOVE, and it is what makes the claim a measurement rather than a
// tautology. The witness id is deliberately not zero, so if the plan were still built from the
// first-sheet constant the claim above would read seven zeros; this asserts the two values really
// are distinguishable, so a green above cannot be an accident of them coinciding.
//
// IT COMPARES AGAINST THE LITERAL BECAUSE THE CONSTANT NO LONGER EXISTS. extdeps.google.sheets
// spreadsheet_first_sheet_id was deleted with its last production consumer (review 68663): once
// the formatter addressed a located tab, the only reference left in the corpus was this line, and
// a declaration whose only consumer is the claim about its own absence is the DESIGN section 3c
// dangling shape -- the same rule this change applied to itself for format_plan_sheet_ids. The
// discriminating power is unchanged: zero is what the removed assumption yielded.
test fn the_witness_sheet_id_is_not_the_first_sheet_index_the_formatter_used_to_address() -> Bool {
  (witness_located_sheet_id == 0) == false
}

// THE HEADER READ IS QUALIFIED BY THE LOCATED TITLE. An unqualified A1 range reads the first tab,
// which gunbc.review_sheet_sheets a1_readback_standing refuses in as many words -- and the
// formatter's readback was sending one. A readback that inspects a different tab from the one the
// writes address is not evidence about the writes at all.
test fn the_header_read_range_is_qualified_by_the_located_tab_title() -> Bool {
  match located_tab_for_witness(sheet_id: witness_located_sheet_id, title: "Prospects2026") {
    TabLocated { tab: t } =>
      match review_sheet_header_range(tab: t) {
        HeaderRangeWire { range: r } => r == join(["'Prospects2026'", "!", review_sheet_header_cells], "")
        HeaderRangeUnqualifiable { cause: _ } => false
      }
    TabAbsent => false
    TabAmbiguous { candidates: _ } => false
    TabUnreadable { cause: _ } => false
  }
}

// A TITLE WITH A SPACE ENCODES, AND THIS CLAIM ASSERTED THE OPPOSITE UNTIL gunbc#11703 LANDED.
// While no encoder existed this branch refused such a title, and the claim here pinned that
// refusal. Quoting makes a space legal, so the refusal was forbidding more than the evidence
// supported (DESIGN section 4d) and the claim was pinning the over-prohibition in place. Both are
// replaced by the real behaviour: extdeps.google.sheets a1_range_encode wraps the title and the
// range is usable. A claim is not owed its old verdict when the world it described has changed.
test fn a_title_with_a_space_is_quoted_by_the_codec_rather_than_declined() -> Bool {
  match located_tab_for_witness(sheet_id: witness_located_sheet_id, title: "Prospects 2026") {
    TabLocated { tab: t } =>
      match review_sheet_header_range(tab: t) {
        HeaderRangeWire { range: r } => r == join(["'Prospects 2026'", "!", review_sheet_header_cells], "")
        HeaderRangeUnqualifiable { cause: _ } => false
      }
    TabAbsent => false
    TabAmbiguous { candidates: _ } => false
    TabUnreadable { cause: _ } => false
  }
}

// AND THE ONE THING THE CODEC REALLY CANNOT SPELL STILL REFUSES. An apostrophe inside a quoted A1
// title has no observed wire spelling -- extdeps.google.sheets a1_title_apostrophe_spelling_standing
// is TranscribedUncited and names the live read that would settle it -- so the encoder declines
// rather than guessing a doubling rule, and the formatter carries that refusal out with the
// codec's own text instead of substituting its own account of why.
test fn a_title_with_an_apostrophe_declines_the_range_rather_than_guessing_an_escape() -> Bool {
  match located_tab_for_witness(sheet_id: witness_located_sheet_id, title: "Jon's Data") {
    TabLocated { tab: t } =>
      match review_sheet_header_range(tab: t) {
        HeaderRangeUnqualifiable { cause: c } => string_contains(s: c as String, pattern: "apostrophe")
        HeaderRangeWire { range: _ } => false
      }
    TabAbsent => false
    TabAmbiguous { candidates: _ } => false
    TabUnreadable { cause: _ } => false
  }
}

// THE READBACK MUST BE ABLE TO FIND THE TAB THE WRITES ADDRESS, AND FOR ONE REVISION IT COULD NOT.
// Selecting the sheet by its located sheetId was landed while both field masks still asked for no
// sheetId, so the selector keyed on a field the request had suppressed: the grid read matched no
// sheet at all and the converge refused every workbook, and the metadata read matched only tab
// zero (review 68553). Every claim above stayed green through it, because all of them read the
// REQUEST PLAN and none of them ran the DECODE against a response shaped by the mask. These three
// close that gap at the seam where it opened.

fn sheet_with_properties(sheet_id: Int) -> SheetsSheetRead {
  SheetsSheetRead {
    properties: Present {
      value: SheetsSheetPropertiesRead {
        sheetId: Present { value: sheet_id },
        title: none,
        index: none,
        gridProperties: none,
      }
    },
    data: none,
    conditionalFormats: none,
  }
}

fn read_of(sheets_read: List<SheetsSheetRead>) -> SpreadsheetRead {
  SpreadsheetRead { spreadsheetId: none, sheets: Present { value: sheets_read } }
}

// (a) THE DECODE FINDS THE LOCATED TAB, and it is asked for a non-zero id beside a zero one so a
// selector that still answered "the first sheet" would pick the wrong record and fail here.
test fn the_readback_selects_the_sheet_carrying_the_located_id_not_the_first_one() -> Bool {
  match located_sheet(
    read: read_of(sheets_read: [sheet_with_properties(sheet_id: 0), sheet_with_properties(sheet_id: 918273645)]),
    sheet_id: 918273645,
  ) {
    Absent => false
    Present { value: sheet } =>
      match sheet.properties {
        Absent => false
        Present { value: props } =>
          match props.sheetId {
            Absent => false
            Present { value: id } => id == 918273645
          }
      }
  }
}

// (b) A RESPONSE CARRYING NO PROPERTIES FINDS NOTHING, which is the shape the narrow grid mask
// produced. The arm itself is correct -- an unread sheet may not be adopted -- and the defect was
// that the REQUEST guaranteed this arm for every tab. Asserting it here pins the decode's honest
// behaviour so the mask claims below carry the whole weight of the repair.
test fn a_response_with_no_properties_locates_no_sheet_rather_than_defaulting_to_the_first() -> Bool {
  match located_sheet(
    read: read_of(sheets_read: [SheetsSheetRead { properties: none, data: none, conditionalFormats: none }]),
    sheet_id: 918273645,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// (c) BOTH MASKS REQUEST THE FIELD THE SELECTOR KEYS ON. This is the claim that would have caught
// the defect, and it is an identity join rather than a spelling check: the masks are composed
// from extdeps.google.sheets sheets_field_sheet_id and this asserts that same row is present in
// each, so a mask narrowed back to its old spelling reddens here.
test fn both_readback_masks_request_the_sheet_id_the_selector_keys_on() -> Bool {
  string_contains(s: review_sheet_format_grid_field_mask, pattern: sheets_field_sheet_id)
    && string_contains(s: review_sheet_format_meta_field_mask, pattern: sheets_field_sheet_id)
}

// (d) THE ORDINARY WORKBOOK, WHICH NO CLAIM ABOVE REACHES. Every id asserted so far is explicitly
// present and non-zero, chosen so a lingering first-sheet assumption could not pass by
// coincidence. That left the COMMON case uncovered: converge_review_spreadsheet mints a one-tab
// workbook whose only tab is sheetId 0, and Sheets omits a field equal to its proto3 default -- so
// on essentially every real run the response carries properties with NO sheetId and the located id
// is 0. The selector reaches that case through extdeps.google.sheets sheets_sheet_id_read, and a
// predicate that answered false to an absent id would refuse the very workbooks this pipeline
// creates while every claim above stayed green.
//
// This gap was found by writing a mutation and discovering nothing reddened, which is the same
// lesson as review 68553 one layer in: the claims clustered where the thinking was, and the case
// left unexercised was the ordinary one.
fn sheet_with_omitted_id() -> SheetsSheetRead {
  SheetsSheetRead {
    properties: Present {
      value: SheetsSheetPropertiesRead { sheetId: none, title: none, index: none, gridProperties: none }
    },
    data: none,
    conditionalFormats: none,
  }
}

test fn a_tab_zero_workbook_whose_response_omits_the_sheet_id_is_still_located() -> Bool {
  match located_sheet(read: read_of(sheets_read: [sheet_with_omitted_id()]), sheet_id: 0) {
    Absent => false
    Present { value: sheet } =>
      match sheet.properties {
        Absent => false
        Present { value: props } => sheets_sheet_id_read(id: props.sheetId) == 0
      }
  }
}

// AND THE OMISSION IS NOT A WILDCARD. The arm above must not become "an absent id matches
// anything": a workbook whose response omitted the id is tab zero, so a selector looking for a
// non-zero located tab must NOT adopt it. Without this, widening the absent arm to satisfy the
// claim above would silently reinstate take-the-first for every tab.
test fn an_omitted_sheet_id_does_not_match_a_non_zero_located_tab() -> Bool {
  match located_sheet(read: read_of(sheets_read: [sheet_with_omitted_id()]), sheet_id: 918273645) {
    Absent => true
    Present { value: _ } => false
  }
}
