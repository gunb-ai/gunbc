module test.claim.build_cache_endpoint_observe

import gunbc.build_cache_instance { ProcessIdentity }

data ambiguous_type_name_import_note: String = "THIS MODULE IMPORTS ProcessIdentity EXPLICITLY BECAUSE THE BARE NAME IS AMBIGUOUS CORPUS-WIDE, AND THE AMBIGUITY RESOLVES SILENTLY. Two types carry that name -- gunbc.build_cache_instance ProcessIdentity (boot_id, pid, start_time) and extdeps.posix ProcessIdentity (id, command, parent) -- and a module with no import block resolves the bare name by last-import-wins rather than refusing, which is one of the three confirmed source-path construction holes DESIGN names beside the sole_constructor wall. The observable cost was measured here rather than reasoned about: a targeted compile of this entry resolved a closure that never loaded extdeps.posix and reported zero blocking diagnostics, while the whole-corpus witness floor loaded both and refused with `no field 'pid' on type 'ProcessIdentity'` at the assertion below. The import is therefore not decoration -- it is the only thing that makes this module's meaning independent of which other modules happen to be in the resolver's population. A green targeted compile is not evidence that a bare name is unambiguous; only a run whose population contains every homonym is."

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data endpoint_observe_witness_doc: String = "THE CONTROLS FOR THE PRODUCER THAT WAS MISSING. Every fixture below is READ TEXT in the shape the live commands emit, and every assertion runs the same decode the realize path runs -- gunbc.build_cache_endpoint_observe survey_build_cache_endpoint, then gunbc.build_cache_ensure admit_ensure_build_cache_instance -- so what is witnessed is the decision realization now makes, not a restatement of the fold's arms. The specimen text is authored from the receipts in docs/plans/build-cache-placement-receipt.md and from proc(5); the two host-only controls (that a second observation does not perturb the subject, and that no read starts a server) remain live receipts rather than witnesses here, because a hermetic fixture cannot falsify them.\n\nTHE DISCRIMINATING RED IS witness_unreadable_listener_refuses_rather_than_admitting. A decoder that treated 'the fd-holder walk printed nothing' and 'the fd-holder walk could not be run' as one state would answer 'no listener' to a question it never got an answer to, and the admission would then ADMIT -- writing a unit and restarting it on a host whose current state was never read. That witness and witness_absent_endpoint_is_admitted differ in exactly one input field and must land on opposite arms; if the HostRead coproduct were collapsed to a String, they would both go green on the admitted arm and the wall would be gone."

fn observe_srv1_ci_instance() -> BuildCacheInstance {
  ci_cache_instance(host: "srv1")
}

data observe_managed_unit_cgroup_text: String = "0::/system.slice/gunbc-build-cache-ci.service\n"
data observe_retired_slot_cgroup_text: String = "0::/system.slice/system-actions-runner.slice/actions-runner@srv1-10.service\n"
data observe_desired_slot_cgroup_text: String = "0::/system.slice/system-actions-runner.slice/actions-runner@srv1-02.service\n"

data proc_net_unix_header: String = "Num       RefCount Protocol Flags    Type St Inode Path\n"

data observe_proc_net_unix_listening_text: String = "Num       RefCount Protocol Flags    Type St Inode Path\n0000000000000000: 00000002 00000000 00010000 0001 01 3894042 /var/lib/ctrl/sccache-ci/server.sock\n0000000000000000: 00000003 00000000 00000000 0001 03 3894099 /run/dbus/system_bus_socket\n"

data observe_proc_net_unix_no_listen_text: String = "Num       RefCount Protocol Flags    Type St Inode Path\n0000000000000000: 00000003 00000000 00000000 0001 03 3894099 /run/dbus/system_bus_socket\n"

data observe_proc_net_unix_sibling_instance_only_text: String = "Num       RefCount Protocol Flags    Type St Inode Path\n0000000000000000: 00000002 00000000 00010000 0001 01 7770001 /var/lib/ctrl/sccache/server.sock\n"

data observe_find_one_holder_text: String = "/proc/3975946/fd/4\n"
data observe_find_two_holders_text: String = "/proc/3975946/fd/4\n/proc/4001122/fd/7\n"

data observe_proc_stat_text: String = "3975946 (sccache) S 1 3975946 3975946 0 -1 4194560 1234 0 0 0 10 5 0 0 20 0 5 0 79870020 2307932160\n"
data observe_proc_stat_adversarial_comm_text: String = "4242 (sc cache (x) ) S 1 4242 4242 0 -1 4194560 7 0 0 0 1 1 0 0 20 0 5 0 51501010 1024\n"
data observe_boot_id_text: String = "73c8153e-0e0e-4480-a36c-bc7560c50e8b\n"

fn observe_listen_inode(unix_text: String) -> gunbc.build_cache_endpoint_observe.EndpointInodeLookup {
  gunbc.build_cache_endpoint_observe.listen_inode_at_path(
    read: gunbc.build_cache_endpoint_observe.HostReadText { text: unix_text },
    path: "/var/lib/ctrl/sccache-ci/server.sock" as NonEmptyStr,
  )
}

fn observe_reads_full(
  path_kind: gunbc.build_cache_endpoint_observe.EndpointPathKind,
  unix_text: String,
  holder_read: gunbc.build_cache_endpoint_observe.HostRead,
  cgroup_text: String,
) -> gunbc.build_cache_endpoint_observe.BuildCacheEndpointReads {
  gunbc.build_cache_endpoint_observe.BuildCacheEndpointReads {
    boot_id: gunbc.build_cache_endpoint_observe.HostReadText { text: observe_boot_id_text },
    path_kind: path_kind,
    listen_inode: observe_listen_inode(unix_text: unix_text),
    listener: gunbc.build_cache_endpoint_observe.fd_holder_of_find_output(read: holder_read),
    owner_cgroup: gunbc.build_cache_endpoint_observe.HostReadText { text: cgroup_text },
    owner_proc_stat: gunbc.build_cache_endpoint_observe.HostReadText { text: observe_proc_stat_text },
    owner_principal: gunbc.build_cache_endpoint_observe.HostReadText { text: "ghrunner\n" },
    owner_executable: gunbc.build_cache_endpoint_observe.HostReadText { text: "/usr/local/bin/sccache\n" },
  }
}

fn observe_admission_full(
  path_kind: gunbc.build_cache_endpoint_observe.EndpointPathKind,
  unix_text: String,
  holder_read: gunbc.build_cache_endpoint_observe.HostRead,
  cgroup_text: String,
) -> EnsureBuildCacheAdmission {
  let instance = observe_srv1_ci_instance()
  let survey = gunbc.build_cache_endpoint_observe.survey_build_cache_endpoint(
    instance: instance,
    reads: observe_reads_full(path_kind: path_kind, unix_text: unix_text, holder_read: holder_read, cgroup_text: cgroup_text),
  )
  admit_ensure_build_cache_instance(
    desired: instance,
    placement: survey.placement,
    observed_path: survey.path,
    currency: survey.currency,
  )
}

fn observe_placement_full(
  path_kind: gunbc.build_cache_endpoint_observe.EndpointPathKind,
  unix_text: String,
  holder_read: gunbc.build_cache_endpoint_observe.HostRead,
  cgroup_text: String,
) -> BuildCacheServerPlacement {
  gunbc.build_cache_endpoint_observe.survey_build_cache_endpoint(
    instance: observe_srv1_ci_instance(),
    reads: observe_reads_full(path_kind: path_kind, unix_text: unix_text, holder_read: holder_read, cgroup_text: cgroup_text),
  ).placement
}

fn observe_path_state_full(
  path_kind: gunbc.build_cache_endpoint_observe.EndpointPathKind,
  unix_text: String,
  holder_read: gunbc.build_cache_endpoint_observe.HostRead,
) -> EndpointPathState {
  gunbc.build_cache_endpoint_observe.survey_build_cache_endpoint(
    instance: observe_srv1_ci_instance(),
    reads: observe_reads_full(path_kind: path_kind, unix_text: unix_text, holder_read: holder_read, cgroup_text: observe_managed_unit_cgroup_text),
  ).path
}

fn observe_one_holder_read() -> gunbc.build_cache_endpoint_observe.HostRead {
  gunbc.build_cache_endpoint_observe.HostReadText { text: observe_find_one_holder_text }
}

fn observe_no_holder_read() -> gunbc.build_cache_endpoint_observe.HostRead {
  gunbc.build_cache_endpoint_observe.HostReadText { text: "" }
}

fn admission_is_refused_with_placement_unknown(admission: EnsureBuildCacheAdmission) -> Bool {
  match admission {
    EnsureBuildCacheRefused { instance: _, reason: r } =>
      match r {
        EnsurePlacementUnknown { detail: _ } => true
        EnsureEndpointOccupied { owner: _ } => false
        EnsureEndpointPathConflict { detail: _ } => false
        EnsureEndpointUnobservable { detail: _ } => false
        EnsureUnlinkRefused { detail: _ } => false
      }
    EnsureAlreadyConverged { desired: _, unit: _ } => false
    EnsureBuildCacheAdmitted { desired: _, preflight: _, unit_lines: _ } => false
  }
}

test fn witness_managed_unit_owner_is_already_converged() -> Bool {
  match observe_admission_full(
    path_kind: gunbc.build_cache_endpoint_observe.PathKindSocket,
    unix_text: observe_proc_net_unix_listening_text,
    holder_read: observe_one_holder_read(),
    cgroup_text: observe_managed_unit_cgroup_text,
  ) {
    EnsureAlreadyConverged { desired: _, unit: u } => (u as String) == "gunbc-build-cache-ci.service"
    EnsureBuildCacheAdmitted { desired: _, preflight: _, unit_lines: _ } => false
    EnsureBuildCacheRefused { instance: _, reason: _ } => false
  }
}

test fn witness_retired_runner_slot_owner_refuses() -> Bool {
  match observe_placement_full(
    path_kind: gunbc.build_cache_endpoint_observe.PathKindSocket,
    unix_text: observe_proc_net_unix_listening_text,
    holder_read: observe_one_holder_read(),
    cgroup_text: observe_retired_slot_cgroup_text,
  ) {
    ServerRunnerOwned { slot: s, lifecycle: lc } =>
      match lc {
        RetiredRunnerSlot => s.slot_index == 10
        DesiredRunnerSlot => false
      }
    ServerManagedUnitOwned { unit: _ } => false
    ServerUnsupervised { cgroup: _ } => false
    ServerPlacementAbsent => false
    ServerPlacementUnknown { detail: _ } => false
  }
}

test fn witness_desired_runner_slot_owner_also_refuses() -> Bool {
  match observe_placement_full(
    path_kind: gunbc.build_cache_endpoint_observe.PathKindSocket,
    unix_text: observe_proc_net_unix_listening_text,
    holder_read: observe_one_holder_read(),
    cgroup_text: observe_desired_slot_cgroup_text,
  ) {
    ServerRunnerOwned { slot: s, lifecycle: lc } =>
      match lc {
        DesiredRunnerSlot => s.slot_index == 2
        RetiredRunnerSlot => false
      }
    ServerManagedUnitOwned { unit: _ } => false
    ServerUnsupervised { cgroup: _ } => false
    ServerPlacementAbsent => false
    ServerPlacementUnknown { detail: _ } => false
  }
}

test fn witness_runner_owned_endpoint_is_not_admitted() -> Bool {
  match observe_admission_full(
    path_kind: gunbc.build_cache_endpoint_observe.PathKindSocket,
    unix_text: observe_proc_net_unix_listening_text,
    holder_read: observe_one_holder_read(),
