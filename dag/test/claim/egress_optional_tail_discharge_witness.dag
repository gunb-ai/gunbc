module test.claim.egress_optional_tail_discharge_witness

// ROW egress-optional-at-required-tail, row 19 DISCHARGE WITNESS.
//
// gunbc.fleet.fleet_show_effective_read::fleet_host_ssh_transport returns
// Optional<HostEffectTransport>. Its Absent arm yields `none`; the refusal is
// discharged by its sole consumer
// gunbc.compile_permit_scope_observe::observe_host_compile_cancellation_for_fleet_host,
// whose Absent arm produces HostCancellationUnobserved{host, cause}.
// Per gunbc.design_argument::interface_realization_policy the refusal policy
// belongs to the consumer; a refusing lookup would duplicate the key it was
// handed.
//
// WHERE THIS WITNESS EXECUTES, stated rather than implied
// (gunbc.design_argument::fail_closed). This module is outside
// v2.workflow.required_floor required_gate_prefixes and
// required_gate_authored_modules (git grep of this module's name across the
// repo on main: 0 hits — no gate plans it, hence DeclinedOutsideGateClosure); it sits under test.claim among
// the claim-module corpus the floor walks, the same position its neighbours
// occupy (the fabric grant witnesses state their own position in the same
// pattern). Corpus-walk discovery is asserted by placement here and shown by
// this row's whole-corpus leg when it runs. The executions this evidence
// gets are (1) local runs and
// this PR's changed-witness selection, and (2) this row's leg D claim_batch
// --entry run, whose raw PASS lines are posted to PR #17041 as a run link —
// a green claimed here without a posted run link is not done. Weakening the
// consumer's typed arm makes both fail, which is how the row detects a silent
// discharge.
//
// DISCRIMINATION: operator_host_srv9 (gunbc.fleet.fleet_host_identity::operator_host_srv9)
// is deliberately absent from fleet_host_ssh_transport_rows (only srv1-4 listed),
// so the .first() site yields Absent for the right reason: the transport table
// does not cover this host. The positive control asserts srv3 IS present in the
// table, confirming the .first() site discriminates on table membership rather
// than yielding Absent for every host. Perturbing the consumer's Absent arm from
// HostCancellationUnobserved to any other standing makes the negative-control arm
// return false, because the match falls to `_ => false` rather than the typed-
// refusal arm.

import std.logic { Bool }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_permit_scope { HostCancellationUnobserved }
import gunbc.compile_permit_scope_observe { observe_host_compile_cancellation_for_fleet_host }
import gunbc.fleet.fleet_host_identity { operator_host_srv3, operator_host_srv9 }
import gunbc.fleet.fleet_show_effective_read { fleet_host_ssh_transport }
import gunbc.host.host_effect { SshShell }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ASSERTION (both sides visible): produced standing must be
// HostCancellationUnobserved with host flow-through == literal "srv9" (the
// carrier-declared value of gunbc.fleet.fleet_host_identity::operator_host_srv9,
// compared as String — not the same expression as the input constant) AND
// cause == literal "no fleet_host_ssh_transport for this host" (the exact
// NonEmptyStr literal the consumer's Absent arm declares in
// #gunbc.compile_permit_scope_observe::observe_host_compile_cancellation_for_fleet_host). Substituting the standing, the
// host, or the typed cause flips this arm to false; each side is reachable.
test fn w_row19_absent_transport_yields_typed_refusal() -> Bool {
  match observe_host_compile_cancellation_for_fleet_host(host: operator_host_srv9) {
    HostCancellationUnobserved { host: h, cause: c } =>
      ((h as String) == "srv9") && ((c as String) == "no fleet_host_ssh_transport for this host")
    _ => false
  }
}

// Positive control: srv3 IS in the transport table, so fleet_host_ssh_transport
// must yield Present — confirming the .first() site discriminates on table
// membership. Without this, a mutation that made .first() always Absent would
// pass the negative control undetected.
// ASSERTION (both sides visible): produced ssh_host, flowed through
// filter()+first()+Present-unwrap and srv3_host_identity_ssh_transport()
// (#gunbc.host.host_identity_adopt::srv3_host_identity_ssh_transport,
// which builds SshShell from operator_host_srv3
// as NonEmptyStr), compared against the CARRIER-DECLARED LITERAL "srv3" — a
// different expression than the fixture's source, so binding srv3's row to
// another host's transport, or a lookup miss (Absent falls to `_ => false`),
// both flip this arm.
test fn w_row19_present_transport_positive_control() -> Bool {
  match fleet_host_ssh_transport(host: operator_host_srv3) {
    Present { value: SshShell { ssh_host: h } } => (h as String) == "srv3"
    _ => false
  }
}
