module test.claim.egress_optional_tail_discharge_witness

// ROW egress-optional-at-required-tail, row 19 DISCHARGE WITNESS.
//
// gunbc.fleet.fleet_show_effective_read::fleet_host_ssh_transport returns
// Optional<HostEffectTransport>. Its Absent arm yields `none`; the refusal is
// discharged by its sole consumer
// gunbc.compile_permit_scope_observe::observe_host_compile_cancellation_for_fleet_host,
// whose Absent arm produces HostCancellationUnobserved{host, cause}.
// Per gunbc.design_argument::interface_realization_policy the refusal policy
// belongs to the consumer; a refusing lookup would duplicate the key it was
// handed. This witness is executed by this row's leg D claim_batch --entry run
// (evidence posted to PR #17041); weakening the consumer's typed arm would make
// that run fail, which is how the row detects a silent discharge.
//
// DISCRIMINATION: operator_host_srv9 (gunbc.fleet.fleet_host_identity::operator_host_srv9)
// is deliberately absent from fleet_host_ssh_transport_rows (only srv1-4 listed),
// so the .first() site yields Absent for the right reason: the transport table
// does not cover this host. Perturbing the consumer's Absent arm from
// HostCancellationUnobserved to any other standing makes this witness return
// false, because the match falls to `_ => false` rather than the typed-refusal arm.

import std.logic { Bool }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.compile_permit_scope { HostCancellationUnobserved }
import gunbc.compile_permit_scope_observe { observe_host_compile_cancellation_for_fleet_host }
import gunbc.fleet.fleet_host_identity { operator_host_srv9 }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn w_row19_absent_transport_yields_typed_refusal() -> Bool {
  match observe_host_compile_cancellation_for_fleet_host(host: operator_host_srv9) {
    HostCancellationUnobserved { host: h, cause: _ } => h == operator_host_srv9
    _ => false
  }
}
