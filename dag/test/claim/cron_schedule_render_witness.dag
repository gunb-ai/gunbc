module test.claim.cron_schedule_render_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.cron.schedule_model { CronSchedule, Wildcard, Exact, Listed, Ranged, Step, parse_cron_step_value, render_cron_field, render_cron_schedule }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CRON FIELD RENDERS AS CRONTAB TEXT, NEVER AS ARITHMETIC OVER ITS BOUNDS (gunbc.recurring_failure_mode
// adjacent_interpolation_holes_fused_into_one_operator_hole). Before gunbc#13436 v1 parsed the
// two-hole templates of the Ranged and offset-Step arms as one hole holding s - e and st / sp, so a
// range 1..5 rendered as the difference of its bounds and an offset step 5 every 15 as their
// quotient. Each input below is chosen so the arithmetic reading DISAGREES with the text: 1 - 5 and
// 5 / 15 are not the strings 1-5 and 5/15 under any rendering of a number.
test fn a_cron_range_renders_as_start_dash_end() -> Bool {
  render_cron_field(f: Ranged { start: 1, end: 5 }) == "1-5"
}

test fn an_offset_cron_step_renders_as_start_slash_step() -> Bool {
  render_cron_field(f: Step { start: 5, step: 15 }) == "5/15"
}

// The one-hole arms beside them, so a regression in the shared renderer is not read as a
// separator defect: an exact value, a list, and a step from zero.
test fn the_one_hole_cron_arms_render_their_values() -> Bool {
  render_cron_field(f: Exact { value: 7 }) == "7"
    && render_cron_field(f: Listed { values: [1, 15, 30] }) == "1,15,30"
    && render_cron_field(f: Step { start: 0, step: 10 }) == "*/10"
}

test fn a_cron_schedule_with_a_range_renders_five_fields() -> Bool {
  render_cron_schedule(s: CronSchedule {
    minute: Step { start: 0, step: 10 },
    hour: Ranged { start: 9, end: 17 },
    day_of_month: Wildcard,
    month: Wildcard,
    day_of_week: Ranged { start: 1, end: 5 }
  }) == "*/10 9-17 * * 1-5"
}

// THE STEP VALUE IS DECIDED AT THE DOOR, AND THE DOOR CARRIES RATHER THAN INVENTS.
// parse_cron_step_value is the sole authority that decides a crontab step's positivity, and both of its
// arms must be load-bearing: the 0 arm is the EXECUTING refusal (the PositiveInt wall is
// `type PositiveInt = Nat where gt_zero` in dag/std/integer.dag, it decides literals only and defers a
// non-literal at a refined position with the WhereRefinementUnenforced advisory -- so it is not what
// refuses here), and the nonzero arm must carry THE SAME NUMBER into the refined position rather than a
// plausible one. Each half therefore fails on a different defect: deleting the 0 arm fails the first, and
// a value that is fabricated, off by one, or clamped fails the second, because the value is read back
// through the renderer that consumes it -- never compared with itself. Supplied as a Nat directly: no
// crontab is parsed here, so this claim stays inside the evaluation budget and says nothing about the
// grammar -- the grammar's refusals are the keystones in dag/test/claim/cron_tag_witness.dag
// (cron_tag_entry_intent_keystone_holds, cron_tag_upsert_protocol_keystone_holds).
test fn the_cron_step_value_refuses_zero_and_carries_a_nonzero() -> Bool {
  (match parse_cron_step_value(n: 0) {
    Present { value: v } => false
    Absent => true
  })
    && (match parse_cron_step_value(n: 15) {
      Absent => false
      Present { value: v } => render_cron_field(f: Step { start: 0, step: v }) == "*/15"
    })
}
