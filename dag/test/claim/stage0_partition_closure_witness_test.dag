module test.claim.stage0_partition_closure_witness_test

import std.types { Bool, String, List, Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.stage0_crate_partition_generated {
  GeneratedPartitionCrateRow,
  GeneratedLayeredCoreCrate,
  generated_partition_crate_rows,
}
import gunbc.stage0_partition_closure {
  PartitionClosureVerdict,
  PartitionClosureHolds,
  PartitionClosureRefused,
  PartitionClosureDefect,
  PartitionAuthorityId,
  PartitionCrateRoster,
  PartitionModuleEdgeList,
  partition_closure_verdict_over,
  reachable_basenames_in,
  list_contains_string,
}
import v2.std.collection { Map, empty_map, map_insert }

data witness_live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data witness_subject_note: String = "SUBJECT: adding one module must be ONE action, and the drift gate must REFUSE when it is not. The incident this reproduces cost three separate hand commits discovered by three CI round trips - the ci.yml heal exclusion list, the stage0 seed .rs, and the crate partition roster plus a lib.rs mod line - because each generator derives from a different partial authority and none knows about the others. The generated-artifact gate reported ZERO DRIFT throughout, because its roster covers neither the emitted stage0 seed nor the partition crate lib.rs files; it was answering a question about its own registered population and being read as answering one about the tree. The RED below removes a roster row from a COPY of the live rows and requires a located refusal naming the roster; the positive controls require that the unmodified live corpus holds and that transitive reexport visibility is honoured, because a check that refuses correct rows is worse than none."

// ---------------------------------------------------------------------------
// Positive controls
// ---------------------------------------------------------------------------

// THE LIVE CENSUS MOVED OUT, and this pointer is here so the pairing stays findable. The row
// that asks whether the LIVE roster holds against the LIVE corpus is
// test.claim.stage0_partition_closure_live_census_test w_live_corpus_partition_closure_holds.
// It costs about 175s of thread CPU because its subject is the corpus breadth, so it runs on
// the falsifier substrate long lane; it is in its own FILE because that lane admits by file
// pattern, and leaving it here would drag these fixtures off per-PR discovery with it.
//
// The two halves are a pair and neither is sufficient alone: a mechanism that never refuses
// fails the REDs below, and one that always refuses fails the census over there.

// Transitive reexport visibility: v1-stage0-std-surface reexports v1-stage0-std-core, so a
// std-core module is reachable from std-surface. Membership alone is not reachability.
test fn w_transitive_reexport_is_reachable() -> Bool {
  let reach = reachable_basenames_in(
    rows: generated_partition_crate_rows,
    package: "v1-stage0-std-surface",
    fuel: 8
  )
  list_contains_string(xs: reach, needle: "std_types")
    && list_contains_string(xs: reach, needle: "std_effects")
}

// A crate that reexports nothing must NOT see another crate's modules. Without this, the
// reachability rule could be vacuously true by returning everything, and the RED below would
// pass for the wrong reason.
test fn w_reachability_is_not_universal() -> Bool {
  let runtime_reach = reachable_basenames_in(
    rows: generated_partition_crate_rows,
    package: "v1-stage0-runtime",
    fuel: 8
  )
  !list_contains_string(xs: runtime_reach, needle: "std_measure")
}

data stage0_partition_closure_fixture_retirement_receipt: String = "RETIREMENT RECEIPT (v1 cut, tree integration/v1-cut, 2026-08-16). FOUR ROWS RETIRED: red_missing_roster_row_refuses, red_refusal_names_the_incomplete_authority, red_reports_every_incomplete_authority_in_one_run, w_verdict_carries_its_extent.\n\nWHAT THEY PROVED. Over a hand-authored crate roster, that partition_closure_verdict_over REFUSES a target no roster claims, that the refusal NAMES the incomplete authority rather than merely reporting a fault, that two dropped modules produce defects for BOTH rather than stopping at the first, and that the verdict carries its extent. The mechanism is untouched by this cut and those are good properties; they are not retired because they stopped mattering.\n\nWHY THE SUBJECT IS GONE. The fixture pinned std_measure, and its own note said why: 'the importer and targets are REAL emitted modules ... so the confirmation step still reads a real file and cannot be satisfied by invented content.' The witness therefore requires an EMITTED MODULE WITH A .dag IDENTITY AND A CROSS-MODULE REFERENCE SET. std_measure.rs is still on disk, but it is no longer emitted: the emission plan derives from cli_run.regen_input_sources, and with the v1 .dag authority deleted the regenerated projection is SEVEN files -- compiler_tests, lib, v1_rt, v1_test_non_ascii_perf_fixture, wt_a, wt_b, wt_common. A file that exists while its role does not is a corpse, and pinning a witness to one is the artifact-versus-authority error.\n\nWHY NOT REPOINTED, MEASURED RATHER THAN ASSUMED. Repointing was tried first. wt_common carries a real cross-module reference (use crate::v1_rt) and BOTH sides are in the live seven, which looked like an exact replacement. It fails on a fact that had to be checked rather than reasoned: NO .dag MODULE EMITS wt_common -- it appears in the corpus only inside the generated projection itself -- and the same holds for v1_test_non_ascii_perf_fixture, wt_a and wt_b. The fixture maps basename to MODULE PATH to targets, and these files have no module path to map to. So the population the witness needs does not merely have a new member to point at; it is empty.\n\nWHY NOT DERIVED FROM THE LIVE PLAN, WITH ITS PRICE. Deriving the fixture subject from live facts is what fixture_cost_note already rejected on measurement: one live verdict costs about 175 seconds of thread CPU against a 5s fast-lane budget, which is why these rows were converted to a fixture in the first place. Re-deriving them would reinstate exactly that cost, and DESIGN's witness-cost rule forbids a gating witness whose size is not derived from what it proves.\n\nRETAINED: w_transitive_reexport_is_reachable and w_reachability_is_not_universal, which exercise reachable_basenames_via_reexports over their own rosters and need no emitted module. They pass. The live-corpus row this file's cost note names as needing a cadence home is not in this file and is unaffected."

// ---------------------------------------------------------------------------
// RED controls — the incident, over a fixture that costs nothing to decide
// ---------------------------------------------------------------------------

data fixture_cost_note: String = "WHY THESE RUN ON A FIXTURE AND NOT THE LIVE ROSTER, corrected against measurement rather than argued. Every RED here previously called the live verdict, and the live verdict derives the whole-corpus edge and declaration facts over pool roots dag and src/v2. Measured on this tree: one live verdict costs about 175 seconds of thread CPU. CI never showed that number, because the 5s fast-lane budget interrupts at about 5040ms and an interrupt is a lower bound on cost, not the cost - so five rows that each re-derived the corpus presented as five witnesses slightly over budget. They merged in #8111 on a CANCELLED check, so they had never once executed.

WHAT THE FIXTURE PRESERVES. The mechanism is partition_closure_verdict_over, whose facts are all supplied: which crate owns which module, which module references which, and how the emitted basename maps back to module identity. The three REDs assert exactly what they asserted before - a target no roster claims REFUSES, the refusal NAMES the roster as the incomplete authority, and two dropped modules produce defects for BOTH rather than stopping at the first.

WHAT IT GIVES UP, STATED. The importer and targets are REAL emitted modules (std_measure references std_types and std_nat in its own emitted source), so the confirmation step still reads a real file and cannot be satisfied by invented content - but the surrounding roster is authored here rather than taken from the tree. The tie to the real corpus is w_live_corpus_partition_closure_holds, which keeps the live roster as its subject and is the row that must find a cadence home; the module authority note is corrected in the same change so it no longer claims these REDs run against live facts."


// std.measure references std.types and std.nat -- the real reference set of the real emitted
// module, which is what keeps the confirmation step honest.

// One crate owning ONLY std_measure. std_types and std_nat are absent from every roster row,
// which is the forgotten-roster-row incident in its smallest form.

// The same crate, but std_types IS claimed -- so only std_nat is missing. This is what makes
// the two-defect assertion below discriminating rather than a restatement of RED 1.



fn defect_targets(v: PartitionClosureVerdict) -> List<String> {
  match v {
    PartitionClosureHolds { extent: _ } => []
    PartitionClosureRefused { extent: _, defects: d } =>
      d |> fold(init: [], f: fn(acc, x) { concat(acc, [x.target_basename as String]) })
  }
}

// RED 1 — THE INCIDENT. std_measure consumes std_types; no roster row claims std_types, and
// the gate must REFUSE. If this returns Holds, the gate is the lie it replaces.

// RED 2 — the refusal must be LOCATED and must name WHICH authority is incomplete, not merely
// report that something is wrong. A refusal that does not name the roster sends the author
// round the loop to find it.

fn authority_is_roster(a: PartitionAuthorityId) -> Bool {
  match a {
    PartitionCrateRoster => true
    PartitionModuleEdgeList => false
  }
}

// RED 3 — ALL incomplete authorities in ONE run. Two missing modules must produce defects for
// both, not just the first one hit. A refusal that stops at the first re-serialises exactly the
// round trips this gate exists to collapse.

// THE VERDICT CARRIES ITS OWN EXTENT. A clean answer that does not state the population it
// covered is the exact shape that let "zero drift" be read as "tree consistent". Asserted over
// the fixture because the property is of the VERDICT, not of the corpus: the extent must be
// populated on both arms, and the refused arm is the one a live-holding corpus cannot reach.
