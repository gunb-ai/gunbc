module test.claim.spark_grant_privileged_operation_witness

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.spark_bootstrap_credential {
  SparkCredentialStanding,
  CredentialMaterialized,
  CredentialMaterializationPending,
}
import gunbc.spark_managed_access_bootstrap { RebootThisHost, spark_managed_grant_population, spark_managed_grant_sudoers_command }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import gunbc.spark_grant_privileged_operation {
  OperatorBootstrapCredentialLease,
  spark_bootstrap_credential_lease,
  lease_secret_resource,
  admitted_root_argv_words,
  admitted_root_argv_label,
  privileged_step_succeeded,
  privileged_step_outcome_wire,
  sudo_rejected_the_credential,
  ValidateStagedSudoers,
  InstallStagedSudoers,
  CredentialNotEnrolled,
  CredentialRejected,
  PrivilegedCommandFailed,
  PrivilegedCommandSucceeded,
}

// A CARRIED name, never a derived one -- the fixture supplies it exactly as an operator would.
fn enrolled() -> SparkCredentialStanding {
  CredentialMaterialized {
    ref: SecretRef {
      project: fleet_secrets_gcp_project,
      secret: "host-srv6-admin" as NonEmptyStr,
      version: "latest" as NonEmptyStr,
      hash_state: HashPending,
    },
  }
}

fn lease_with(standing: SparkCredentialStanding) -> OperatorBootstrapCredentialLease {
  spark_bootstrap_credential_lease(
    host: "srv6",
    administrator: standing,
    grant: RebootThisHost,
    attempt_identity: "fixture-attempt" as NonEmptyStr,
  )
}

// THE LEASE HOLDS A STANDING, NOT A REFERENCE, and this witness is the wall against the defect that
// shipped: an earlier revision built the SecretRef by concatenating a rendered HostIdentity, which
// is exactly what the credential module's 2026-08-07 operator ruling forbids -- secret names are
// CARRIED, never DERIVED. A pending standing must therefore have no resource to name at all, rather
// than a plausible name for a secret nobody has authored.
test fn a_pending_administrator_credential_names_no_secret_resource() -> Bool {
  match lease_secret_resource(lease: lease_with(standing: CredentialMaterializationPending)) {
    Absent => true
    Present { value: _ } => false
  }
}

// And an enrolled one names exactly the carried value, unchanged.
test fn an_enrolled_credential_names_the_carried_secret_verbatim() -> Bool {
  match lease_secret_resource(lease: lease_with(standing: enrolled())) {
    Absent => false
    Present { value: r } =>
      string_contains(r, "/secrets/host-srv6-admin")
        && !string_contains(r, "spark-srv6-bootstrap-admin")
  }
}

// THE PASSWORD GOES OVER STDIN AND NOWHERE ELSE. An argv-borne credential lands in the process
// table, in any command log, and in this repository's own receipts, which print argv verbatim.
test fn the_privileged_argv_reads_its_credential_from_stdin() -> Bool {
  let words = admitted_root_argv_words(command: ValidateStagedSudoers { staged_path: "/home/briansrls/staged" as NonEmptyStr })
  any(words, w => w == "-S") && !any(words, w => w == "-n") && any(words, w => w == "--")
}

test fn the_prompt_is_suppressed_and_options_are_terminated() -> Bool {
  let words = admitted_root_argv_words(command: InstallStagedSudoers {
    staged_path: "/home/briansrls/staged" as NonEmptyStr,
    dropin_path: "/etc/sudoers.d/gunbc-reboot" as NonEmptyStr,
  })
  any(words, w => w == "-p") && any(words, w => w == "--")
    && any(words, w => w == "0440") && any(words, w => w == "root")
}

// THE ADMITTED SET IS CLOSED, which is why this is not a generic { argv, stdin } carrier: widening
// it would reopen arbitrary script bodies through stdin under root, a far larger hole than the one
// being closed. Only the two commands this bootstrap needs have constructors.
test fn only_the_two_bootstrap_commands_can_run_as_root() -> Bool {
  admitted_root_argv_label(command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr }) == "validate-staged-sudoers"
    && admitted_root_argv_label(command: InstallStagedSudoers {
         staged_path: "p" as NonEmptyStr, dropin_path: "d" as NonEmptyStr,
       }) == "install-staged-sudoers"
}

// The lease names the exact grant it authorizes, built from the same rows the installer writes, so a
// credential materialized for one purpose cannot be read as authorization for another.
test fn the_lease_names_the_exact_grant_it_authorizes() -> Bool {
  fold(spark_managed_grant_population, init: true, f: fn(acc, g) {
    acc && string_contains(
      spark_bootstrap_credential_lease(
        host: "srv6", administrator: enrolled(), grant: g,
        attempt_identity: "fixture" as NonEmptyStr,
      ).authorized_purpose as String,
      spark_managed_grant_sudoers_command(grant: g) as String,
    )
  })
    && string_contains(lease_with(standing: enrolled()).authorized_purpose as String, "not retained")
}

// THE THREE FAILURE LAYERS STAY DISTINGUISHABLE because their remedies differ: nothing enrolled is
// an enrolment problem, a rejected credential is a wrong or stale version, and a command that failed
// after sudo admitted it is a host problem.
test fn the_three_failure_layers_are_distinguishable() -> Bool {
  string_contains(
    privileged_step_outcome_wire(outcome: CredentialNotEnrolled { lease: lease_with(standing: CredentialMaterializationPending) }),
    "CREDENTIAL-NOT-ENROLLED",
  )
    && string_contains(
         privileged_step_outcome_wire(outcome: CredentialRejected { lease: lease_with(standing: enrolled()) }),
         "CREDENTIAL-REJECTED",
       )
    && string_contains(
         privileged_step_outcome_wire(outcome: PrivilegedCommandFailed {
           command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr },
           exit_code: 1, stderr: "parse error near line 1",
         }),
         "FAILED validate-staged-sudoers",
       )
}

// THE REJECTED ARM CANNOT PRINT SUDO'S TEXT, because that text is produced while a credential is
// being handled and a carrier holding it would put "is this safe to print" into a renderer, one
// edit from disclosure. The arm has no stderr field at all, so the question cannot arise.
test fn the_rejected_arm_carries_no_sudo_output_to_leak() -> Bool {
  let text = privileged_step_outcome_wire(outcome: CredentialRejected { lease: lease_with(standing: enrolled()) })
  string_contains(text, "wrong or stale")
    && !string_contains(text, "incorrect password attempt")
    && !string_contains(text, "Sorry, try again")
}

// A not-enrolled lease has no secret to name and must not invent one in the receipt either.
test fn the_not_enrolled_receipt_names_no_secret() -> Bool {
  !string_contains(
    privileged_step_outcome_wire(outcome: CredentialNotEnrolled { lease: lease_with(standing: CredentialMaterializationPending) }),
    "/secrets/",
  )
}

test fn only_a_succeeded_command_counts_as_success() -> Bool {
  privileged_step_succeeded(outcome: PrivilegedCommandSucceeded {
    command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr },
  })
    && !privileged_step_succeeded(outcome: CredentialRejected { lease: lease_with(standing: enrolled()) })
    && !privileged_step_succeeded(outcome: CredentialNotEnrolled { lease: lease_with(standing: CredentialMaterializationPending) })
    && !privileged_step_succeeded(outcome: PrivilegedCommandFailed {
         command: ValidateStagedSudoers { staged_path: "p" as NonEmptyStr }, exit_code: 1, stderr: "",
       })
}

// A wrong password is read off sudo's diagnostic, not its exit code: sudo exits 1 for a rejected
// credential AND for a malformed sudoers file, and those have entirely different remedies.
test fn a_rejected_credential_is_read_from_sudos_diagnostic_not_its_exit_code() -> Bool {
  sudo_rejected_the_credential(stderr: "sudo: 1 incorrect password attempt")
    && !sudo_rejected_the_credential(stderr: "visudo: /home/briansrls/staged: parse error near line 1")
}
