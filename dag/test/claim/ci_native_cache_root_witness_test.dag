module test.claim.ci_native_cache_root_witness

import gunbc.ci_workflow { ci_prelude_steps, ci_cargo_build_jobs_count }
import gunbc.ci_yaml_emit { expected_ci_yml }
import gunbc.falsifier_workflow { expected_falsifier_yml }
import v2.workflow.ci_workflow_run_emit {
  ci_isolate_toolchain_script,
  ci_native_cache_root_script,
  ci_native_cache_fabricated_segment_literal,
  ci_native_cache_segment_script_refuses_fabrication,
  ci_isolate_toolchain_script_excludes_segment_derivation,
  ci_native_cache_root_shell_emit_scaffold,
  ci_native_cache_root_shell_emit_dissolution_trigger
}
import std.disposition { Scaffold }
import extdeps.github.actions { RunStep, UsesStep }
import v2.std.collection { list_at_optional }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ci_native_cache_root_witness_note: String = "Discriminating witnesses for the toolchain-segment reorder+refuse fix (operator 2026-07-29): the isolate prelude must NOT derive GUNBC_TOOLCHAIN_SEG from ambient rustc (that either fabricates toolchain-unresolved or silently keys on the wrong toolchain); the dedicated native-cache step after setup-rust-toolchain must refuse on rustc -V failure. RED controls perturb the good emission with the retired fabrication literal so a regression re-opens the absorbing fallback."

test fn witness_isolate_emission_excludes_segment_derivation() -> Bool {
  ci_isolate_toolchain_script_excludes_segment_derivation(
    isolate_script: ci_isolate_toolchain_script(build_jobs_count: ci_cargo_build_jobs_count())
  )
}

test fn witness_native_cache_root_emission_refuses_fabrication() -> Bool {
  ci_native_cache_segment_script_refuses_fabrication(
    script: ci_native_cache_root_script()
  )
}

test fn witness_native_cache_root_fabrication_literal_red_control() -> Bool {
  let good = ci_native_cache_root_script()
  let bad = concat(good, concat("\n", concat("GUNBC_TOOLCHAIN_SEG=", ci_native_cache_fabricated_segment_literal)))
  ci_native_cache_segment_script_refuses_fabrication(script: good) &&
    !ci_native_cache_segment_script_refuses_fabrication(script: bad)
}

test fn witness_prelude_native_cache_root_step_follows_setup_rust() -> Bool {
  match list_at_optional(xs: ci_prelude_steps(), index: 2) {
    Present { value: setup_step } =>
      match setup_step {
        UsesStep { name: Present { value: "Setup Rust" }, .. } =>
          match list_at_optional(xs: ci_prelude_steps(), index: 3) {
            Present { value: cache_step } =>
              match cache_step {
                RunStep {
                  name: Present {
                    value: "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"
                  },
                  ..
                } => true
                _ => false
              }
            Absent => false
          }
        _ => false
      }
    Absent => false
  }
}

test fn witness_emitted_workflows_exclude_fabricated_segment_literal() -> Bool {
  !string_contains(s: expected_ci_yml(), pattern: ci_native_cache_fabricated_segment_literal) &&
    !string_contains(s: expected_falsifier_yml(), pattern: ci_native_cache_fabricated_segment_literal) &&
    string_contains(
      s: expected_ci_yml(),
      pattern: "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"
    ) &&
    string_contains(
      s: expected_falsifier_yml(),
      pattern: "Derive native-cache root (rustc-version segment; after setup-rust-toolchain)"
    )
}

test fn witness_native_cache_root_emission_carries_dissolve_marker() -> Bool {
  string_contains(s: ci_native_cache_root_script(), pattern: ci_native_cache_root_shell_emit_dissolution_trigger)
}

test fn witness_native_cache_root_shell_emit_is_scaffold_holds() -> Bool {
  match ci_native_cache_root_shell_emit_scaffold {
    Scaffold { dissolves_to: _, bind: _ } => true
  }
}

test fn witness_emitted_workflows_refuse_missing_segment_red_control() -> Bool {
  let good = expected_ci_yml()
  let bad = concat(good, ci_native_cache_fabricated_segment_literal)
  !string_contains(s: good, pattern: ci_native_cache_fabricated_segment_literal) &&
    string_contains(s: bad, pattern: ci_native_cache_fabricated_segment_literal)
}
