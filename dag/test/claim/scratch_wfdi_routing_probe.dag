// SCRATCH probe (review 96534 red control): the dispatch-path claim's arms are
// TRUE under the wired argument order and FALSE under the swap — the witness
// flips on the conflation. Delete before merge.
module gunbc.test.claim.scratch_wfdi_routing_probe;

import gunbc.host.network_install_ci {
  CiEdgeReady, NetworkInstallCiIncomplete, network_install_ci_resolve,
};
import gunbc.host.host_identity { HostIdentity, operator_host_srv4 };
import gunbc.provisioning.network_install { NetworkInstallCiMissing };
import gunbc.fleet.fleet_host_identity { fleet_host_identity };
import gunbc.core.string { string_contains };
import gunbc.core.list { any };
import gunbc.core.result { Optional, Present, Absent };
import gunbc.time.epoch_ms { EpochMs };
import gunbc.core.non_empty_str { NonEmptyStr };
import gunbc.test.claim.host.network_install_ci_witness { ci_host, ci_dispatch_id, ci_decided_at, ci_password_path };

fn routing_arms(host: HostIdentity, executor: HostIdentity) -> Bool {
  match network_install_ci_resolve(
    host: host,
    executor: executor,
    dispatch_id: ci_dispatch_id,
    decided_at: ci_decided_at,
    password_file: Present { value: ci_password_path },
    edge_context: Absent,
    edge_view: Present { value: CiEdgeReady },
  ) {
    NetworkInstallCiIncomplete { missing: missing } =>
      any(xs: missing, where: item =>
        string_contains(s: item.input as String, pattern: "firmware release capability row"))
        && !any(xs: missing, where: item =>
          string_contains(s: item.input as String, pattern: "write-controller row"))
        && !any(xs: missing, where: item =>
          string_contains(s: item.input as String, pattern: "arrival population row"))
    _ => false
  }
}

test fn p_routing_as_wired_is_true() -> Bool {
  routing_arms(host: ci_host, executor: operator_host_srv4)
}

test fn p_routing_swapped_is_false() -> Bool {
  !routing_arms(host: operator_host_srv4, executor: ci_host)
}
