module test.claim.nested_generic_equality_repro

// Shape isolate for the #15175 regression: a concrete operand whose walk descends a generic
// holder (Outer<K>) whose member is a NESTED generic application (Inner<K>) whose applied
// argument is the holder's OWN type parameter. std.effects reproduces exactly this:
// IdempotencyEvidence -> EffectShape<KeySource> -> CreateEffect { cause: CreateCause<K> }.

import std.types { String, Bool }

type Inner<K>
  = Boxed { key: K }
  | Nothing

type Outer<K>
  = Has { inner: Inner<K> }
  | Bare

type Carrier
  = Wrap { outer: Outer<String>, tag: String }

fn nested_generic_member_equality_admits(x: Carrier, y: Carrier) -> Bool {
  x == y
}

// Control: the same nesting where the inner application's argument is a plain declared type
// (KeySource's role) — admitted before #15175 and must stay admitted.
type PlainKey
  = KeyA { name: String }
  | KeyB

type Outer2<K>
  = Has2 { inner: Inner<K>, k2: K }
  | Bare2

type Carrier2
  = Wrap2 { outer2: Outer2<PlainKey> }

fn sibling_by_target_argument_admits(x: Carrier2, y: Carrier2) -> Bool {
  x == y
}
