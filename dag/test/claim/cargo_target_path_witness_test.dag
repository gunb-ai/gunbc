module test.claim.cargo_target_path


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn render_file_path_parts(parts: FilePathParts) -> String {
  fold(parts.segments, init: "", f: fn(acc, seg) {
    if acc == "" { concat(acc, seg) } else { concat(acc, concat("/", seg)) }
  })
}

fn render_target(target: CargoTarget, package_name: String) -> String {
  render_file_path_parts(parts: cargo_target_source_path(target: target, package_name: package_name))
}

fn render_candidates(stem: String) -> String {
  fold(rust_module_candidate_paths(stem: stem), init: "", f: fn(acc, parts) {
    if acc == "" { render_file_path_parts(parts: parts) } else { concat(acc, concat(";", render_file_path_parts(parts: parts))) }
  })
}

fn lib_lands_on_src_lib() -> Bool {
  render_target(target: Lib, package_name: "v1-compiler") == "src/lib.rs"
}

fn package_bin_collapses_to_main() -> Bool {
  render_target(target: Bin { name: "v1-compiler" }, package_name: "v1-compiler") == "src/main.rs"
}

fn other_bin_lands_under_src_bin() -> Bool {
  render_target(target: Bin { name: "helper" }, package_name: "v1-compiler") == "src/bin/helper.rs"
}

fn test_example_bench_dirs() -> Bool {
  render_target(target: CargoTest { name: "integration" }, package_name: "v1-compiler") == "tests/integration.rs"
    && render_target(target: Example { name: "demo" }, package_name: "v1-compiler") == "examples/demo.rs"
    && render_target(target: Bench { name: "throughput" }, package_name: "v1-compiler") == "benches/throughput.rs"
}

fn module_stem_two_candidates() -> Bool {
  render_candidates(stem: "parser") == "src/parser.rs;src/parser/mod.rs"
}

fn edition_tokens_render() -> Bool {
  rust_edition_str(edition: Edition2015) == "2015"
    && rust_edition_str(edition: Edition2018) == "2018"
    && rust_edition_str(edition: Edition2021) == "2021"
    && rust_edition_str(edition: Edition2024) == "2024"
    && rust_edition_str(edition: default_rust_edition) == "2021"
}

test fn cargo_target_path_witnesses() -> Bool {
  lib_lands_on_src_lib()
    && package_bin_collapses_to_main()
    && other_bin_lands_under_src_bin()
    && test_example_bench_dirs()
    && module_stem_two_candidates()
    && edition_tokens_render()
}
