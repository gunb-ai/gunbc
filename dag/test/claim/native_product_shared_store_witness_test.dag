module test.claim.native_product_shared_store

import std.types { String, Bool }
import std.optional { Present, Absent }
import std.fabric_blob { FabricBlobGetUnavailable, FabricBlobUnauthorized }
import gunbc.auth.access_token_source { WorkloadIdentityToken }
import gunbc.native_product_shared_store {
  ForkPullRequestRun, SameRepoPullRequestRun, MergeGroupRun, UnattributedRun,
  NativeProductStoreReadWrite, NativeProductStoreNoAccess, native_product_store_access,
  native_product_blob_address,
  NativeProductSharedGetNotAdmitted, NativeProductSharedGetAnswered, native_product_shared_get,
}

data live_key: String = "78fa374e0d6cd0df1339bb3a25abf2e96e9c22bcc6d61d72e2c179d168c8322a"

// A fork has no standing, an unattributed run has none, a same-repo pull request and the merge group do.
test fn only_same_repo_runs_and_the_merge_group_have_standing() -> Bool {
  let fork = match native_product_store_access(standing: ForkPullRequestRun) { NativeProductStoreNoAccess { cause: _ } => true, NativeProductStoreReadWrite => false }
  let other = match native_product_store_access(standing: UnattributedRun) { NativeProductStoreNoAccess { cause: _ } => true, NativeProductStoreReadWrite => false }
  let pr = match native_product_store_access(standing: SameRepoPullRequestRun) { NativeProductStoreReadWrite => true, NativeProductStoreNoAccess { cause: _ } => false }
  let mg = match native_product_store_access(standing: MergeGroupRun) { NativeProductStoreReadWrite => true, NativeProductStoreNoAccess { cause: _ } => false }
  fork && other && pr && mg
}

// The seed's key (lower hex SHA-256) is the address; anything else has no address.
test fn the_request_key_is_the_address_and_a_malformed_key_has_none() -> Bool {
  let ok = match native_product_blob_address(key_hex: live_key) { Present { value: _ } => true, Absent => false }
  let bad = match native_product_blob_address(key_hex: "not-a-digest") { Present { value: _ } => false, Absent => true }
  ok && bad
}

// A fork's read is refused before any credential is reached; a standing run's read refuses CLOSED while
// the cache-blobs credential is unminted (the frontier's trigger), as an Unauthorized fault, never a miss
// that would be mistaken for an absent entry.
test fn a_read_without_standing_or_credential_refuses_closed() -> Bool {
  match native_product_blob_address(key_hex: live_key) {
    Absent => false
    Present { value: addr } => {
      let fork = match native_product_shared_get(standing: ForkPullRequestRun, address: addr, token_source: WorkloadIdentityToken) {
        NativeProductSharedGetNotAdmitted { cause: _ } => true
        NativeProductSharedGetAnswered { result: _ } => false
      }
      let unminted = match native_product_shared_get(standing: SameRepoPullRequestRun, address: addr, token_source: WorkloadIdentityToken) {
        NativeProductSharedGetAnswered { result: r } =>
          match r.verdict {
            FabricBlobGetUnavailable { address: _, fault: FabricBlobUnauthorized { cause: _ } } => true
            _ => false
          }
        NativeProductSharedGetNotAdmitted { cause: _ } => false
      }
      fork && unminted
    }
  }
}
