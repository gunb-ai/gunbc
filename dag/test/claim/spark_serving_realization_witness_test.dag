module test.claim.spark_serving_realization_witness_test


// The terminal Spark intent, named in one place so every control varies ONE axis against it.
//
// endpoint is UnauthenticatedEndpoint by OPERATOR DECLARATION (2026-08-12: the LAN is the boundary).
// An earlier revision of this fixture said AuthenticatedEndpoint, which I had authored myself and
// which no operator had ever declared -- so this fixture was asserting a requirement about the
// operator's intent that came from me. Corrected rather than left, because a fabricated requirement
// sitting in a witness looks exactly like a real one to the next reader.
fn spark_intent() -> gunbc.spark_serving_realization.SparkServingIntent {
  gunbc.spark_serving_realization.SparkServingIntent {
    lifecycle: SurvivesReboot,
    availability: RestartsOnFailure,
    authority: ManagedConvergenceOwned,
    service_identity: gunbc.spark.serving_realization.NoLoginNoSudoIdentity,
    endpoint: UnauthenticatedEndpoint,
    observability: IndependentlyObservable,
  }
}

fn present(evidence: String) -> gunbc.spark_serving_realization.CapabilityObservation {
  gunbc.spark.serving_realization.CapabilityPresent { evidence: evidence as std.types.NonEmptyStr }
}

fn refused(cause: String) -> gunbc.spark_serving_realization.CapabilityObservation {
  gunbc.spark.serving_realization.CapabilityRefused { cause: cause as std.types.NonEmptyStr }
}

// A host where the least-privileged realization already satisfies the intent.
fn host_user_unit_capable() -> gunbc.spark_serving_realization.SparkHostCapabilityObservation {
  gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no passwordless sudo"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
}

// The SAME host after gaining passwordless sudo. Nothing about the intent changed.
fn host_user_unit_capable_plus_sudo() -> gunbc.spark_serving_realization.SparkHostCapabilityObservation {
  gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: present("passwordless sudo granted"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
}

fn least_privilege_policy() -> gunbc.spark_serving_realization.SparkServingRealizationPolicy {
  gunbc.spark_serving_realization.SparkServingRealizationPolicy { privilege: LeastRequiredEffects }
}

// The selection rendered as a comparable label, so the invariance claim can assert that the ANSWER
// is unchanged rather than that it is one particular realization. The earlier form asserted "a user
// unit is selected in both cases", which fused two claims -- privilege does not change the answer,
// AND the answer is a user unit -- and the identity contract has since refuted the second. Fusing
// them meant a correct model change reported as a regression.
fn selection_label(capabilities: gunbc.spark_serving_realization.SparkHostCapabilityObservation) -> String {
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: capabilities,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.UserUnitRealization => "selected:user-unit"
        gunbc.spark.serving_realization.SystemUnitRealization => "selected:system-unit"
        gunbc.spark.serving_realization.RootlessContainerRealization => "selected:rootless-container"
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => "no-realization-admitted"
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => "choice-required"
  }
}

fn selects_user_unit(capabilities: gunbc.spark_serving_realization.SparkHostCapabilityObservation) -> Bool {
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: capabilities,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.UserUnitRealization => true
        gunbc.spark.serving_realization.SystemUnitRealization => false
        gunbc.spark.serving_realization.RootlessContainerRealization => false
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// THE DISCRIMINATING CONTROL, and the one the function this replaces would fail. Granting
// passwordless sudo makes the system-unit realization ADMISSIBLE; it must not make it SELECTED,
// because the serving intent did not change. derive_install_scope returns SystemUnitScope the
// instant passwordless_sudo is true, so this pair is exactly where the old model silently
// "upgraded" the architecture in response to a privilege grant.
// A host where something IS admissible without privilege: it has a container runtime, so the
// rootless container satisfies the intent (its identity contract admits a related container identity)
// with one privileged effect. This fixture is what the invariance claim NEEDS, and building it is
// what exposed that the claim was previously testing something else.
fn host_container_capable() -> gunbc.spark_serving_realization.SparkHostCapabilityObservation {
  gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no passwordless sudo"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: present("rootless container runtime observed"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
}

fn host_container_capable_plus_sudo() -> gunbc.spark_serving_realization.SparkHostCapabilityObservation {
  gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: present("passwordless sudo granted"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: present("rootless container runtime observed"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
}

// THE ANTI-UPGRADE INVARIANT, correctly stated at last. The earlier form asserted that granting sudo
// never changes the selection, full stop -- and that proposition is FALSE, which only became visible
// once the identity contract landed. On a host where nothing else can satisfy the intent, granting
// sudo moves the answer from no-realization-admitted to system-unit, and that is not privilege
// choosing an architecture: it is privilege making the ONLY viable mechanism reachable. Refusing to
// serve at all would not have been the safer answer, it would have been a different wrong one.
//
// What must never happen is the upgrade: a host where a less-privileged realization ALREADY
// satisfies the intent must keep it when privilege appears. That needs a fixture where something is
// admissible without sudo, which the old fixtures did not have -- they passed only because the
// missing identity contract wrongly admitted a user unit in both arms. The claim was green while
// testing a proposition that was not the invariant.
test fn w_granting_sudo_does_not_upgrade_an_already_satisfied_intent() -> Bool {
  selection_label(capabilities: host_container_capable()) == selection_label(capabilities: host_container_capable_plus_sudo())
}

// The pair above is satisfiable by a model that answers identically to everything, so this pins that
// the fixture genuinely selects the LESS privileged mechanism rather than coincidentally matching.
test fn w_the_already_satisfied_host_selects_the_less_privileged_mechanism() -> Bool {
  selection_label(capabilities: host_container_capable_plus_sudo()) == "selected:rootless-container"
}

// And the enablement case, asserted rather than left implicit: with nothing else admissible, privilege
// changes the answer from refusal to the system unit. Stating it keeps the invariant above honest
// about its own scope.
test fn w_privilege_enables_when_nothing_else_can_satisfy_the_intent() -> Bool {
  selection_label(capabilities: host_user_unit_capable()) == "no-realization-admitted" && selection_label(capabilities: host_user_unit_capable_plus_sudo()) == "selected:system-unit"
}

// The invariance claim above is satisfiable by a model that answers the same thing to everything, so
// this pins that the two fixtures are not simply producing a constant: a host where the mechanism
// genuinely differs must select differently.
test fn w_selection_is_not_constant_across_genuinely_different_hosts() -> Bool {
  selection_label(capabilities: host_container_capable()) != selection_label(capabilities: host_user_unit_capable_plus_sudo())
}

fn no_managed_executor_host() -> gunbc.spark_serving_realization.SparkHostCapabilityObservation {
  gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: test.claim.spark_serving_realization_witness_test.refused("only the human bootstrap account exists"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: present("passwordless sudo granted"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
}

// A user unit is NOT selected merely because it is what remains. Under SurvivesReboot it needs
// lingering, and without it the candidate is refused rather than defaulted to.
test fn w_user_unit_refused_when_it_cannot_satisfy_the_lifecycle() -> Bool {
  let no_lingering = gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no passwordless sudo"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: test.claim.spark_serving_realization_witness_test.refused("lingering disabled: unit dies at logout"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: no_lingering,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => true
    gunbc.spark.serving_realization.RealizationSelected { realization: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// UNOBSERVED IS NOT ABSENT AND IS ALSO NOT PRESENT. A capability nobody looked at refuses
// admission, so a realization is never selected on the strength of a question never asked.
test fn w_unobserved_capability_refuses_rather_than_admitting() -> Bool {
  let unobserved = gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv6" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no passwordless sudo"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: gunbc.spark.serving_realization.CapabilityUnobserved,
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: unobserved,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => true
    gunbc.spark.serving_realization.RealizationSelected { realization: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// POSITIVE CONTROL for the pair above: with sudo the ONLY mechanism available, system-unit is
// selected. Without this, a model that refused everything would pass the sudo-invariance control.
test fn w_system_unit_selected_when_it_is_the_only_admitted_mechanism() -> Bool {
  let system_only = gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: present("fleet automation account observed"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: present("passwordless sudo granted"),
    user_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no user unit manager"),
    user_lingering: test.claim.spark_serving_realization_witness_test.refused("no user unit manager"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: system_only,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.SystemUnitRealization => true
        gunbc.spark.serving_realization.UserUnitRealization => false
        gunbc.spark.serving_realization.RootlessContainerRealization => false
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// The managed-executor requirement is a function of the AUTHORITY intent, so a host with no managed
// account cannot serve under ManagedConvergenceOwned however capable it otherwise is. This is what
// makes "briansrls plus the fleet key" insufficient rather than merely untidy.
test fn w_no_managed_executor_refuses_under_managed_authority() -> Bool {
  let human_only = gunbc.spark_serving_realization.SparkHostCapabilityObservation {
    host: "srv5" as std.types.NonEmptyStr,
    managed_executor_account: test.claim.spark_serving_realization_witness_test.refused("only the human bootstrap account exists"),
    no_login_service_identity: present("inference service identity observed"),
    system_unit_manager: test.claim.spark_serving_realization_witness_test.refused("no passwordless sudo"),
    user_unit_manager: present("systemd --user observed"),
    user_lingering: present("lingering enabled"),
    container_runtime: test.claim.spark_serving_realization_witness_test.refused("no container runtime"),
    accelerator_access: present("accelerator device readable"),
    writable_artifact_root: present("artifact root writable"),
    endpoint_bindable: present("endpoint bindable"),
  }
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: human_only,
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => true
    gunbc.spark.serving_realization.RealizationSelected { realization: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// RED CONTROL, stated as a rejection so it PASSES when the model is correct (an enrolled test fn
// returning false is a FAIL, not a control -- a mistake made earlier in this session). The wrong
// outcome is the old function's behavior: selecting system-unit because privilege appeared.
test fn red_control_privilege_does_not_select_the_architecture() -> Bool {
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: host_container_capable_plus_sudo(),
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.SystemUnitRealization => false
        gunbc.spark.serving_realization.UserUnitRealization => true
        gunbc.spark.serving_realization.RootlessContainerRealization => true
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// THE REFUTATION NOW DERIVES, which is the whole point of this addition. Before the identity
// contract, this exact input SELECTED UserUnitRealization: the model checked "a user manager exists"
// and "a no-login identity exists" independently and admitted the user unit when both held. Measured
// on srv5, `systemd-run --user --scope` reports gunbc-automation -- a user unit runs as the user
// whose manager owns it, so the separate existence of gunbc-inference never made it run as that
// account. Two true facts, no realization joining them.
//
// The host below is MAXIMALLY capable for a user unit: manager present, lingering enabled,
// accelerator, artifact root, endpoint. Nothing observational refuses it. Only the structural
// contract does, which is why this claim is the one that would have caught the real defect.
test fn w_user_unit_is_structurally_inadmissible_under_a_separated_service_identity() -> Bool {
  match select_spark_serving_realization(
    intent: spark_intent(),
    capabilities: host_user_unit_capable(),
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.UserUnitRealization => false
        gunbc.spark.serving_realization.SystemUnitRealization => true
        gunbc.spark.serving_realization.RootlessContainerRealization => true
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => true
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => true
  }
}

// POSITIVE CONTROL, and it is what keeps the contract from being a blanket refusal: under
// ExecutorOwnedIdentity -- an intent that does NOT require separation -- the same host and the same
// realization ARE admissible. Without this, the claim above passes on a model that refuses user
// units unconditionally, which would be wrong in the other direction.
test fn w_user_unit_is_admissible_when_the_intent_does_not_require_separation() -> Bool {
  let executor_owned = gunbc.spark_serving_realization.SparkServingIntent {
    lifecycle: SurvivesReboot,
    availability: RestartsOnFailure,
    authority: ManagedConvergenceOwned,
    service_identity: gunbc.spark.serving_realization.ExecutorOwnedIdentity,
    endpoint: UnauthenticatedEndpoint,
    observability: IndependentlyObservable,
  }
  match select_spark_serving_realization(
    intent: executor_owned,
    capabilities: host_user_unit_capable(),
    policy: least_privilege_policy(),
  ) {
    gunbc.spark.serving_realization.RealizationSelected { realization: r } =>
      match r {
        gunbc.spark.serving_realization.UserUnitRealization => true
        gunbc.spark.serving_realization.SystemUnitRealization => false
        gunbc.spark.serving_realization.RootlessContainerRealization => false
      }
    gunbc.spark.serving_realization.NoRealizationAdmitted { first: _, more: _ } => false
    gunbc.spark.serving_realization.RealizationChoiceRequired { first: _, second: _, more: _, cause: _ } => false
  }
}

// THE REFUSAL IS STRUCTURAL, meaning it holds with NO capability observation at all. This is the
// property that distinguishes it from every other requirement in the model: those ask the host a
// question, this one asks only what the mechanism can deliver, so it is decidable on a host nobody
// has looked at.
test fn w_the_identity_refusal_needs_no_host_observation() -> Bool {
  match identity_contract_refusal(intent: spark_intent(), realization: gunbc.spark.serving_realization.UserUnitRealization) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn red_control_system_unit_satisfies_the_identity_contract() -> Bool {
  match identity_contract_refusal(intent: spark_intent(), realization: gunbc.spark.serving_realization.SystemUnitRealization) {
    Absent => true
    Present { value: _ } => false
  }
}

// PRIVILEGE IS COUNTED, NOT ASSIGNED. The old form returned 1/2/3 -- integers the author chose --
// and called the winner least-required-effects. This asserts the ordering follows from the effect
// populations: the rootless container needs ONE privileged effect (granting runtime access), the
// user unit needs one (enable-linger), the system unit needs THREE (write unit, reload manager,
// enable unit) plus the package install shared with the user unit. Getting this wrong now requires
// misstating what an effect does, which a reader can check against the host.
test fn w_privilege_is_counted_from_effects_not_assigned() -> Bool {
  realization_privileged_effect_count(realization: gunbc.spark.serving_realization.SystemUnitRealization) > realization_privileged_effect_count(realization: gunbc.spark.serving_realization.RootlessContainerRealization) && realization_privileged_effect_count(realization: gunbc.spark.serving_realization.RootlessContainerRealization) <= realization_privileged_effect_count(realization: gunbc.spark.serving_realization.UserUnitRealization)
}

// THE INVARIANT THAT SURVIVES THE MECHANISM CHANGE. The sudo-invariance claim above passes under
// both the old integers and the new count, so on its own it proves nothing about this change. This
// one is specific: the ORDERING must come from the effects, so a realization requiring strictly more
// privileged effects must never outrank one requiring fewer.
test fn w_ordering_follows_the_privileged_effect_count() -> Bool {
  let sys = realization_effect_weight(realization: gunbc.spark.serving_realization.SystemUnitRealization)
  let user = realization_effect_weight(realization: gunbc.spark.serving_realization.UserUnitRealization)
  let cont = realization_effect_weight(realization: gunbc.spark.serving_realization.RootlessContainerRealization)
  sys > user && sys > cont
}

// A user unit needing enable-linger is NOT privilege-free, and saying so is the point: an earlier
// reading treated user units as inherently unprivileged, which is what made the narrow sudoers grant
// on the Sparks look like an anomaly rather than a derived requirement.
test fn red_control_user_unit_is_not_privilege_free() -> Bool {
  realization_privileged_effect_count(realization: gunbc.spark.serving_realization.UserUnitRealization) > 0
}
