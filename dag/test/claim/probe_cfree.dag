module test.claim.probe_cfree

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn pa() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", ["struct Pair"], [])
}
test fn pb() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", ["p: Pair"], [])
}
test fn pc() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", ["Rc<Pair>"], [])
}
test fn pd() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", [], ["Rc<Pair>"])
}
test fn pe() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", ["p: Rc<Pair>"], [])
}
test fn pf() -> Bool {
  compile_dag_rust_emit_check("module cfree.flip\n\ntype Pair {\n  name: String\n  items: List<Int>\n}\n\ntype Holder {\n  p: Pair\n  tag: String\n}\n", "src/cfree_flip.rs", ["pub p"], [])
}
