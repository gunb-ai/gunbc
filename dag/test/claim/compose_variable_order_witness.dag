module test.claim.compose_variable_order_witness

// THE ORDERING LAW OF A COMPOSED STEP, CLAIMED. A composed step is a script run under
// `set -euo pipefail`: expanding a variable the step has not assigned YET does not yield an empty word,
// it aborts the script at that line. The field failure this claim exists for: the mirror's
// regenerate-and-seal step opened with `HEAD_TREE="$RUNNER_TMP_ROOT"'/…-head'` one statement BEFORE
// `runner_tmp_root_stmts` declared `RUNNER_TMP_ROOT`, so the step died at its line 6 with
// `RUNNER_TMP_ROOT: unbound variable` -- and because that step carries
// `if: "!cancelled() && github.event_name == 'pull_request'"`, no push ever ran it, so the defect sat
// invisible in the shared emitter while the lane that publishes repairs produced nothing.
//
// WHAT IS CHECKED, AND HOW FAR. The rule is stated once, in `gunbc.ci.repository_compose_overlay`, and
// this claim runs it over every step the compose family emits: the witness lane's compose step, the
// composed gate run, the drift check step, the heal seal step, and `head_tree_compose_statements` named
// on its own so the builder stays covered even if the seal that wraps it changes. Each step is read as
// the STATEMENTS its builder produced, through the bash grammar's own accessors
// (`v2.extdeps.languages.bash_build`) -- never by re-parsing rendered text, because rendered text is a
// second spelling of a fact the builder already holds and a parser over it can only be as correct as its
// author's list of quoting cases. A quoted word carrying `=` is not an assignment there because it is not
// one. The step's declared inputs are read off the rows that emit its `env:` mapping
// (`memory_budget_rows`, `heal_seal_env`), never typed out here. The planted cases are what make this a
// wall rather than a tautology: the pre-fix ordering, built from the same statement builders the emitters
// use, must go red; an undeclared name must go red; declaring it in the step's inputs must green it.

import std.types { Bool, Int, List, String }
import std.integer { int_to_decimal_string }
import std.optional { Optional, Present, Absent }
import extdeps.bazel.label { Label }
import v2.std.node { Node }
import v2.extdeps.languages.bash_build {
  bash_build_assign,
  bash_build_assign_lit,
  bash_build_word_concat_from_nodes
}
import gunbc.ci.repository_compose_overlay {
  ComposeOrderingDefect,
  ComposePathDefect,
  compose_composed_dir_literal,
  compose_step_path_defects,
  compose_step_reads_compose,
  ComposeSpec,
  command,
  command_words,
  compose_gunbc_run_statements,
  compose_preamble_statements,
  compose_step_is_swept,
  compose_step_ordering_defects,
  composed_source_roots,
  head_tree_compose_statements,
  heal_seal_env,
  merge_checkout_compose,
  set_strict_stmt,
  var_word,
  word
}
import gunbc.ci.repository_ci_profile {
  DagInvocation,
  Declared_seed_under_composed_overlay,
  HealSeal,
  OverlayIngest,
  ProjectionDrift,
  PublicSeed,
  RepositoryCiProfile
}
import gunbc.ci.repository_projection_drift_workflow {
  DriftProgram,
  drift_check_statements,
  heal_seal_statements,
  memory_budget_rows
}
import gunbc.witness.repository_witness_workflow { mirror_compose_statements }
import test.claim.repository_ci_profile_witness {
  fixture_overlay, fixture_seed, mirror_drift_program, mirror_profile
}

// The corpus idiom, defined per module so resolution has an established callee.
fn text_at(xs: List<String>, i: Int) -> String {
  match xs.skip(n: i).first() {
    Present { value: v } => v
    Absent => ""
  }
}

// One entry per builder path, so a builder that stops being covered shows up as a MISSING ENTRY (the
// count claim reddens) rather than as a silent pass. An entry carries the BUILDER'S STATEMENTS, not a
// rendered script: the rule reads the syntax the builder produced.
type ComposeOrderingSweep {
  label: String
  steps: List<Node>
  inputs: List<String>
}

// ── FIXTURES, READ OFF THE ROWS ──────────────────────────────────────────────────────────────

fn mirror() -> RepositoryCiProfile {
  mirror_profile(seal: true, publish: true)
}

fn source_seed(profile: RepositoryCiProfile) -> PublicSeed {
  match profile.source {
    Declared_seed_under_composed_overlay { seed: seed, overlay: _, run_roster_step_name: _ } => seed
    _ => fixture_seed()
  }
}

fn source_overlay(profile: RepositoryCiProfile) -> OverlayIngest {
  match profile.source {
    Declared_seed_under_composed_overlay { seed: _, overlay: overlay, run_roster_step_name: _ } => overlay
    _ => fixture_overlay()
  }
}

// The step's declared inputs are the keys of the `env:` mapping the SAME rows emit. Nothing here lists a
// name by hand, so widening the law would take an edit to those rows -- which is the point.
fn seal_inputs(profile: RepositoryCiProfile) -> List<String> {
  concat(
    memory_budget_rows(profile: profile).map(row => row.key),
    heal_seal_env().map(binding => binding.key)
  )
}

fn swept_steps() -> List<ComposeOrderingSweep> {
  let profile = mirror()
  let seed = source_seed(profile: profile)
  let overlay = source_overlay(profile: profile)
  let spec = merge_checkout_compose(seed: seed, overlay: overlay, notes: [])
  let program = mirror_drift_program()
  let lane = [
    ComposeOrderingSweep {
      label: "witness lane compose step",
      steps: mirror_compose_statements(profile: profile, seed: seed),
      inputs: []
    }
  ]
  concat(lane, seal_sweeps(
    profile: profile,
    seed: seed,
    overlay: overlay,
    spec: spec,
    program: program,
    drift_row: profile.drift
  ))
}

// The drift and heal rows are Optional on the profile, so each layer of "does this script exist" gets its
// own function and its own one match: the sweep grows by rows, never by nesting.
fn seal_sweeps(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  spec: ComposeSpec,
  program: DriftProgram,
  drift_row: Optional<ProjectionDrift>
) -> List<ComposeOrderingSweep> {
  match drift_row {
    Absent => []
    Present { value: drift } => composed_sweeps_for_seal(
      profile: profile,
      seed: seed,
      overlay: overlay,
      spec: spec,
      program: program,
      check: drift.check,
      seal_row: drift.seal
    )
  }
}

fn composed_sweeps_for_seal(
  profile: RepositoryCiProfile,
  seed: PublicSeed,
  overlay: OverlayIngest,
  spec: ComposeSpec,
  program: DriftProgram,
  check: Label,
  seal_row: Optional<HealSeal>
) -> List<ComposeOrderingSweep> {
  match seal_row {
    Absent => []
    Present { value: seal } => [
      ComposeOrderingSweep {
        label: "composed gate run",
        steps: concat(
          compose_preamble_statements(seed: seed, c: spec),
          compose_gunbc_run_statements(
            overlay: overlay,
            source_roots: composed_source_roots(
              profile_roots: profile.roster.source_roots,
              overlay: overlay
            ),
            entry: seal.invocation.entry,
            function: seal.invocation.function
          )
        ),
        inputs: []
      },
      ComposeOrderingSweep {
        label: "drift check step",
        steps: drift_check_statements(
          profile: profile,
          seed: seed,
          overlay: overlay,
          program: program,
          check: check
        ),
        inputs: []
      },
      ComposeOrderingSweep {
        label: "heal seal step",
        steps: heal_seal_statements(profile: profile, seed: seed, overlay: overlay, seal: seal),
        inputs: seal_inputs(profile: profile)
      },
      ComposeOrderingSweep {
        label: "head-tree compose",
        steps: head_tree_compose_statements(
          seed: seed,
          overlay: overlay,
          head_tree_dir_name: seal.head_tree_dir_name,
          head_link_name: seal.head_link_name,
          compose_dir_name: seal.compose_dir_name
        ),
        inputs: heal_seal_env().map(binding => binding.key)
      }
    ]
  }
}

fn swept_defects() -> List<String> {
  defects_at(steps: swept_steps(), i: 0, acc: [])
}

fn defects_at(steps: List<ComposeOrderingSweep>, i: Int, acc: List<String>) -> List<String> {
  if i >= count(steps) {
    acc
  } else {
    defects_at(steps: steps, i: i + 1, acc: concat(acc, step_defect_texts(step: text_at(xs: steps, i: i))))
  }
}

// A step the rule cannot be asked about -- empty, not built in the order the law is stated for, or
// reading no variable -- is a sweep that proved nothing, so it is reported as a defect of its own instead
// of passing quietly.
fn step_defect_texts(step: ComposeOrderingSweep) -> List<String> {
  if !compose_step_is_swept(steps: step.steps) {
    [
      concat(
        step.label,
        ": the rule sweeps no statement here (no statements, no strict-mode opening, or none reads a variable)"
      )
    ]
  } else {
    concat(
      concat(
        compose_step_ordering_defects(steps: step.steps, inputs: step.inputs).map(
          d => concat(concat(step.label, ": reads $"), defect_text(defect: d))
        ),
        concat(
          compose_step_path_defects(steps: step.steps).map(
            d => concat(concat(step.label, ": path under $COMPOSE repeats the composed directory: "), path_defect_text(defect: d))
          ),
          path_law_blind_text(step: step)
        )
      )
    )
  }
}

// The path law is blind when a step expands COMPOSE but the statement that assigns it carries no literal
// for the composed directory: it would report nothing about paths it cannot see. Reported, not passed --
// the same anti-vacuity discipline as `compose_step_is_swept`, for the other law.
fn path_law_blind_text(step: ComposeOrderingSweep) -> List<String> {
  if !compose_step_reads_compose(steps: step.steps, i: 0) {
    []
  } else {
    match compose_composed_dir_literal(steps: step.steps, i: 0) {
      Present { value: name } =>
        if name == "" {
          [concat(step.label, ": the step expands $COMPOSE but its assignment carries no composed directory for the path law to read")]
        } else {
          []
        }
      Absent =>
        [concat(step.label, ": the step expands $COMPOSE but assigns it in a shape the path law cannot read")]
    }
  }
}

// One path defect as text: where it was, the name it repeated, and the path that repeated it.
fn path_defect_text(defect: ComposePathDefect) -> String {
  concat(
    concat(concat(int_to_decimal_string(defect.step_index), " "), defect.compose_dir_literal),
    concat(" in ", defect.literal)
  )
}

// One defect as text: the name, the statement that reads it, and the statement that assigns it -- or
// `never`, which is the rule saying it looked and found no assignment.
fn defect_text(defect: ComposeOrderingDefect) -> String {
  let assigned = match defect.assigned_index {
    Present { value: i } => int_to_decimal_string(i)
    Absent => "never"
  }
  concat(
    concat(concat(defect.name, ":"), int_to_decimal_string(defect.read_index)),
    concat(":", assigned)
  )
}

// The i-th defect, or Absent. Absent rather than an empty value: a claim that reads a defect which is not
// there must be unable to say anything true about it.
fn defect_at(defects: List<ComposeOrderingDefect>, i: Int) -> Optional<ComposeOrderingDefect> {
  defects.skip(n: i).first()
}

// The i-th path defect, under the same rule as above: no empty value standing in for "no such defect".
fn defect_path_at(defects: List<ComposePathDefect>, i: Int) -> Optional<ComposePathDefect> {
  defects.skip(n: i).first()
}

// ── THE PLANTED STEPS ────────────────────────────────
// Built from the SAME statement builders the emitters use, so a planted shape is a shape the emitters
// could ship. No script text appears in this file: a rule read over text a builder never produced is a
// rule about the test.

// The scratch-root declaration: the statement shape `runner_tmp_root_stmts` declares it in, without the
// fallback branch (which reads only the caller's own argument). Reads `$RUNNER_TEMP`, which is the
// runner's, and assigns `$RUNNER_TMP_ROOT`, which is the step's to declare.
fn scratch_declaration() -> List<Node> {
  [
    command_words(rest: ["set", "+u"]),
    bash_build_assign(name: "RUNNER_TMP_ROOT", value: var_word(name: "RUNNER_TEMP")),
    command(words: [word(text: "test"), word(text: "-n"), var_word(name: "RUNNER_TMP_ROOT")]),
    command_words(rest: ["set", "-u"])
  ]
}

// The head-tree assignment that reads the scratch root -- the statement whose hoisting was the field
// failure: it died at its own line with `RUNNER_TMP_ROOT: unbound variable`.
fn head_tree_assignment_reading_scratch() -> Node {
  bash_build_assign(
    name: "HEAD_TREE",
    value: bash_build_word_concat_from_nodes(
      parts: [var_word(name: "RUNNER_TMP_ROOT"), word(text: "/head")]
    )
  )
}

// THE PRE-FIX SHAPE: that assignment hoisted above the declaration.
fn pre_fix_seal_prefix() -> List<Node> {
  concat([set_strict_stmt(), head_tree_assignment_reading_scratch()], scratch_declaration())
}

// THE FIXED SHAPE: the same statements with the declaration first. The pair is what makes the claim on
// the pre-fix shape a control rather than an accident of one arrangement.
fn fixed_seal_prefix() -> List<Node> {
  concat(concat([set_strict_stmt()], scratch_declaration()), [head_tree_assignment_reading_scratch()])
}

// A step that reads the runner's own name, a name its `env:` rows declare, and a name nobody assigns.
fn input_probe_steps() -> List<Node> {
  [
    set_strict_stmt(),
    command(words: [word(text: "test"), word(text: "-n"), var_word(name: "RUNNER_TEMP")]),
    command(words: [word(text: "echo"), var_word(name: "HEAD_TREE")])
  ]
}

// A step that reads a name it never assigns.
fn unassigned_probe_steps() -> List<Node> {
  [
    set_strict_stmt(),
    command(words: [word(text: "rm"), word(text: "-rf"), var_word(name: "COMPOSE_DIR")]),
    command(words: [word(text: "cp"), word(text: "-R"), var_word(name: "COMPOSE_DIR")])
  ]
}

// THE GRAMMAR'S OWN CONTROL. `PATTERN=a=b` is a quoted literal WORD, not an assignment statement, so it
// binds nothing -- and the read of `$PATTERN` below is therefore a defect. A rule that read the rendered
// script by looking for `NAME=` would have accepted the quoted word as an assignment and reported nothing:
// this is the input that goes red only when the rule reads the syntax.
fn quoted_equals_steps() -> List<Node> {
  [
    set_strict_stmt(),
    bash_build_assign_lit(name: "COMPOSE_DIR", text: "/tmp/gunbc-mirror-compose"),
    command(
      words: [word(text: "grep"), word(text: "PATTERN=a=b"), var_word(name: "COMPOSE_DIR")]
    ),
    command(words: [word(text: "echo"), var_word(name: "PATTERN")])
  ]
}

// THE COMPOSED-PATH CONTROLS. Every statement is built from the builders the emitters use; the shapes
// differ only in whether the tail between $COMPOSE and the directory it names repeats the composed
// directory name. Each prefix carries the clean `git worktree add --detach $COMPOSE HEAD` that opens every
// real composed step, so a sweep that stopped at the first statement expanding COMPOSE would report
// nothing about the mkdir that follows it and would call a broken step clean.
fn compose_dir_declaration() -> Node {
  bash_build_assign(
    name: "COMPOSE",
    value: bash_build_word_concat_from_nodes(
      parts: [var_word(name: "RUNNER_TMP_ROOT"), word(text: "/gunbc-mirror-compose")]
    )
  )
}

// The first statement in a composed step that expands COMPOSE, and a clean one: it names the directory,
// it does not hang anything off it.
fn worktree_add_statement() -> Node {
  command(words: [
    word(text: "git"),
    word(text: "worktree"),
    word(text: "add"),
    word(text: "--detach"),
    var_word(name: "COMPOSE"),
    word(text: "HEAD")
  ])
}

fn mkdir_under_compose(path_tail: String) -> Node {
  command(words: [
    word(text: "mkdir"),
    word(text: "-p"),
    bash_build_word_concat_from_nodes(parts: [var_word(name: "COMPOSE"), word(text: path_tail)])
  ])
}

fn cd_into_compose() -> Node { command(words: [word(text: "cd"), var_word(name: "COMPOSE")]) }

// Everything before the path being judged: strict mode, the scratch-root declaration, the COMPOSE
// assignment, and the clean read of it. The expected position of the path under test is DERIVED from this
// list, so moving a statement here moves the assertion with it instead of silently rotting a number.
fn compose_plant_prefix() -> List<Node> {
  concat(
    concat([set_strict_stmt()], scratch_declaration()),
    [compose_dir_declaration(), worktree_add_statement()]
  )
}

fn doubled_overlay_step() -> List<Node> {
  concat(
    compose_plant_prefix(),
    [mkdir_under_compose(path_tail: "/gunbc-mirror-compose/private_overlay"), cd_into_compose()]
  )
}

fn singly_overlay_step() -> List<Node> {
  concat(compose_plant_prefix(), [mkdir_under_compose(path_tail: "/private_overlay"), cd_into_compose()])
}

// ── THE CLAIMS ──────────────────────────────────────

// EVERY BUILDER, ORDERED. No composed step reads a name it did not assign earlier in the same step, or
// that the runner and its own `env:` rows do not declare. Five entries, none of them vacuous.
test fn every_compose_builder_emits_an_ordered_step() -> Bool {
  count(swept_steps()) == 5 && count(swept_defects()) == 0
}

// THE PRE-FIX ORDERING GOES RED, and names the name, at the statement it was hoisted to. If this claim
// ever passes on the hoisted shape, the law is decoration.
test fn the_pre_fix_ordering_is_a_defect_the_rule_names() -> Bool {
  let defects = compose_step_ordering_defects(steps: pre_fix_seal_prefix(), inputs: ["HEAD_SHA"])
  match defect_at(defects: defects, i: 0) {
    Present { value: first } =>
      count(defects) == 1
        && first.name == "RUNNER_TMP_ROOT"
        && first.read_index == 2
        && match first.assigned_index {
             Present { value: i } => i > first.read_index
             Absent => false
           }
    Absent => false
  }
}

// THE FIXED ORDERING PASSES ON THE SAME STATEMENTS: declaration first, then the read.
test fn the_declared_then_assigned_ordering_passes() -> Bool {
  count(compose_step_ordering_defects(steps: fixed_seal_prefix(), inputs: ["HEAD_SHA"])) == 0
}

// EXTERNAL INPUTS ARE INPUTS BECAUSE THEY ARE DECLARED. The runner's names (`RUNNER_TEMP`, `GITHUB_*`,
// and the shell's own `PWD`) need no assignment; a name the step invents does, and the step's `env:` rows
// are what excuse it -- so dropping the declaration reddens it and adding it greens it.
test fn external_inputs_are_inputs_only_because_they_are_declared() -> Bool {
  let undeclared = compose_step_ordering_defects(steps: input_probe_steps(), inputs: [])
  let declared = compose_step_ordering_defects(steps: input_probe_steps(), inputs: ["HEAD_TREE"])
  match defect_at(defects: undeclared, i: 0) {
    Present { value: first } =>
      count(undeclared) == 1 && first.name == "HEAD_TREE" && count(declared) == 0
    Absent => false
  }
}

// A NAME THE STEP NEVER ASSIGNS IS REPORTED, not silently allowed: `assigned_index` absent is the rule
// saying it looked and found nothing.
test fn a_name_the_step_never_assigns_is_reported_as_never_assigned() -> Bool {
  let defects = compose_step_ordering_defects(steps: unassigned_probe_steps(), inputs: [])
  match defect_at(defects: defects, i: 0) {
    Present { value: first } =>
      count(defects) == 1
        && first.name == "COMPOSE_DIR"
        && match first.assigned_index {
             Present { value: _ } => false
             Absent => true
           }
    Absent => false
  }
}

// THE RULE READS THE SYNTAX, NOT THE BYTES. A quoted literal word carrying `=` binds nothing, so the read
// it appears to excuse is reported; and a step with nothing to read is not swept, so it cannot pass
// quietly. Both halves matter: the first is what a text scanner got wrong, the second is what a vacuous
// sweep would have hidden.
test fn a_quoted_word_carrying_equals_is_not_an_assignment() -> Bool {
  let defects = compose_step_ordering_defects(steps: quoted_equals_steps(), inputs: [])
  !compose_step_is_swept(steps: [])
    && compose_step_is_swept(steps: quoted_equals_steps())
    && match defect_at(defects: defects, i: 0) {
         Present { value: first } =>
           count(defects) == 1 && first.name == "PATTERN"
             && match first.assigned_index {
                  Present { value: _ } => false
                  Absent => true
                }
         Absent => false
       }
}

// A PATH THAT REPEATS THE COMPOSED DIRECTORY IS REPORTED, and the same step without the repeat is not.
// This is the mirror's seal step: the copy landed at `$COMPOSE/<compose dir>/private_overlay` while the
// run, working in `$COMPOSE`, was told its source root was `private_overlay/dag`. Nothing about either
// statement's own text says which side of the composition a path is on; the statements know, because one
// of them names the directory COMPOSE was assigned from.
test fn a_path_that_repeats_the_composed_directory_is_reported() -> Bool {
  let defects = compose_step_path_defects(steps: doubled_overlay_step())
  // Derived from the fixture, not written: the path is the statement after the prefix.
  let expected_index = count(compose_plant_prefix()) + 1
  match defect_path_at(defects: defects, i: 0) {
    Present { value: first } =>
      count(defects) == 1
        && first.compose_dir_literal == "/gunbc-mirror-compose"
        && first.literal == "/gunbc-mirror-compose/private_overlay"
        && first.step_index == expected_index
        && count(compose_step_path_defects(steps: singly_overlay_step())) == 0
    Absent => false
  }
}

// THE SWEEP WALKS PAST THE CLEAN READ. The real seal step's first COMPOSE-expanding statement is
// `git worktree add --detach $COMPOSE HEAD`, which is clean; a sweep that returned the defects of the
// first such statement and stopped would find nothing in a step whose next statement is the doubled path,
// which is the decoration case this control exists to make red.
test fn the_sweep_walks_past_a_clean_read_of_compose() -> Bool {
  let prefix = concat([set_strict_stmt(), compose_dir_declaration()], [worktree_add_statement()])
  match defect_path_at(
    defects: compose_step_path_defects(
      steps: concat(prefix, [mkdir_under_compose(path_tail: "/gunbc-mirror-compose/private_overlay")])
    ),
    i: 0
  ) {
    Present { value: first } =>
      first.step_index == count(prefix) + 1
        && first.literal == "/gunbc-mirror-compose/private_overlay"
    Absent => false
  }
}

// A SIBLING DIRECTORY NAME IS NOT A REPEAT. The composed directory here is /gunbc-mirror-compose; a path
// that hangs a directory whose name merely BEGINS with it off COMPOSE names a different directory, and a
// law that flagged it would report a step that composes correctly. The boundary is a path segment, not a
// substring -- and the real repeat planted beside it still has to be found, or this control would pass by
// reporting nothing.
test fn a_sibling_directory_name_is_not_reported_as_a_repeat() -> Bool {
  let prefix = compose_plant_prefix()
  let defects = compose_step_path_defects(
    steps: concat(
      prefix,
      [
        mkdir_under_compose(path_tail: "/gunbc-mirror-compose-x/private_overlay"),
        mkdir_under_compose(path_tail: "/gunbc-mirror-compose/private_overlay")
      ]
    )
  )
  match defect_path_at(defects: defects, i: 0) {
    Present { value: first } =>
      count(defects) == 1
        && first.literal == "/gunbc-mirror-compose/private_overlay"
        && first.step_index == count(prefix) + 2
    Absent => false
  }
}

// THE PATH LAW IS NOT ASKED A VACUOUS QUESTION. Both planted steps really do expand COMPOSE (so the
// passing one passed something), and a step that composes nothing is not silently clean: the law reads no
// paths there, and the claim says which of the two it looked at.
test fn the_path_law_reports_only_steps_that_compose() -> Bool {
  compose_step_reads_compose(steps: singly_overlay_step(), i: 0)
    && compose_step_reads_compose(steps: doubled_overlay_step(), i: 0)
    && !compose_step_reads_compose(steps: unassigned_probe_steps(), i: 0)
    && count(compose_step_path_defects(steps: unassigned_probe_steps())) == 0
}

