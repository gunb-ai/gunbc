module test.claim.compiler_gate_workflow_witness

import std.types { Bool, String }
import extdeps.github.actions { SelfHosted, RunsOnExpression }
import gunbc.witness.compiler_gate_workflow {
  compiler_gate_no_merge_path_job_is_hosted, compiler_gate_runner_is_hosted,
  compiler_gate_merge_path_runs_on_the_fleet, compiler_gate_merge_path_job_ids,
  compiler_gate_required_job_id, compiler_gate_checkout_ref
}
import extdeps.github.expressions { ContextAccess, Github }

// THE CLAIMS OVER THE `floor` AND `generated` JOBS LEFT WITH THOSE JOBS (operator ruling 2026-10-09,
// the v1 withdrawal; gunbc.rung_drop v1_required_lanes_withdrawn): the receipt adjudicator bound after
// its producer, the stage0 mirrors adjudicated on every event, and the lint under the status guard
// alone were facts about lanes this workflow no longer runs. The claims over the native product
// store's steps left with the same ruling's second correction: the required job emits and builds
// both products fresh and binds no store (test.claim.compiler_gate_emit_build_lane_witness
// holds the absence).

// ── THE MERGE PATH RUNS ON THE FLEET ──────────────────────────────────────────────────────────
//
// operator ruling 2026-09-28: no lane the required context reads runs on a hosted runner.
// compiler_gate_merge_path_runs_on_the_fleet is an emission conjunct, so a workflow that breaks the
// ruling is refused rather than emitted; these claims establish that the predicate discriminates (a
// supplied merge path that meets the hosted set refuses, one that does not is admitted), that a
// runner decided at dispatch counts as hosted, and that the live merge path both holds and is not
// vacuous -- it names the one required job. The supplied sets below are designed values, not the
// live roster.
test fn w_RED_a_hosted_job_on_the_merge_path_refuses() -> Bool {
  compiler_gate_no_merge_path_job_is_hosted(
    merge_path: ["lane-a", "lane-b", "witnesses"],
    hosted: ["lane-c", "lane-d", "witnesses"]
  ) == false
}

test fn a_merge_path_disjoint_from_the_hosted_jobs_is_admitted() -> Bool {
  compiler_gate_no_merge_path_job_is_hosted(
    merge_path: ["lane-a", "lane-b", "witnesses"],
    hosted: ["lane-c", "lane-d"]
  )
}

test fn w_RED_a_runner_decided_at_dispatch_counts_as_hosted() -> Bool {
  compiler_gate_runner_is_hosted(runner: RunsOnExpression { expression: "${{ inputs.runner }}" })
    && (compiler_gate_runner_is_hosted(runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] }) == false)
}

// THE LIVE MERGE PATH IS EXACTLY THE REQUIRED JOB, at identity grain in both directions: a path that
// grew a second job without the operator sign-off the design document's CI row requires reds here,
// and so does a path that lost the required job.
test fn the_live_merge_path_runs_on_the_fleet_and_is_the_required_job() -> Bool {
  let path = compiler_gate_merge_path_job_ids()
  compiler_gate_merge_path_runs_on_the_fleet()
    && any(path, id => id == compiler_gate_required_job_id())
    && all(path, id => id == compiler_gate_required_job_id())
}

// THE REQUIRED JOB JUDGES THE COMPOSED TREE, NOT THE PULL REQUEST HEAD. main has no merge queue, so a
// head checkout means nothing ever builds head merged with the base, and two individually green pull
// requests broke main (#14539, #14675). github.sha is refs/pull/N/merge on pull_request and the
// triggering commit elsewhere. The first claim is the discriminating RED: the old head ref is a
// different value, so restoring it fails the second. Residue stated in compiler_gate_fleet_checkout_step:
// the merge ref is fixed when the event fires, so this is a mitigation, not the queue's guarantee.
test fn the_required_job_checks_out_the_merge_ref() -> Bool {
  compiler_gate_checkout_ref == ContextAccess { context: Github, path: ["sha"] }
}

test fn w_RED_the_pull_request_head_ref_is_not_the_checkout_ref() -> Bool {
  (compiler_gate_checkout_ref == ContextAccess { context: Github, path: ["event", "pull_request", "head", "sha"] }) == false
}
