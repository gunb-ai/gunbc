  ClaudeSetupTokenFormatMeasured,
  ClaudeSetupTokenFormatObservation,
}
import gunbc.claude_setup_token_enrollment {
  ClaudeEnrollmentSecretVersionAdmission,
  EnrollmentSecretVersionRefusedLatest,
  EnrollmentSecretVersionRefusedEmpty,
  EnrollmentSecretVersionAdmitted,
  ClaudeEnrollmentWriterLeaseAdmission,
  ClaudeEnrollmentWriterLeasePublishAdmission,
  EnrollmentLeaseGranted,
  EnrollmentLeaseRefusedConcurrent,
  EnrollmentLeaseRefusedNewerBindingExists,
  EnrollmentLeasePublishGranted,
  EnrollmentLeasePublishRefusedStaleEpoch,
  ClaudeEnrollmentInitiationSurface,
  EnrollmentInitiationClaudeCli,
  EnrollmentInitiationSdkAttempt,
  ClaudeEnrollmentInitiationAdmission,
  EnrollmentInitiationAdmitted,
  EnrollmentInitiationRefusedSdkPath,
  ClaudeEnrollmentColdStartAdmission,
  EnrollmentColdStartAdmitted,
  EnrollmentColdStartRefusedAmbientPrerequisite,
  ClaudeCredentialArtifactDigest,
  ClaudeCredentialArtifactObservationPair,
  ClaudeCredentialWriteBackAdmission,
  CredentialWriteBackAdmitted,
  CredentialWriteBackRefusedUnchanged,
  CredentialWriteBackRefusedMissingObservation,
  ClaudeSetupTokenCaptureAdmission,
  SetupTokenCaptureRefusedMultipleCandidates,
  SetupTokenCaptureRefusedFormatUnobserved,
  SetupTokenCaptureRefusedNoCandidate,
  SetupTokenCaptureRefusedMalformedPrefix,
  SetupTokenCaptureRefusedMalformedLength,
  SetupTokenCaptureAdmitted,
  admit_enrollment_secret_version,
  admit_enrollment_initiation,
  admit_enrollment_cold_start,
  admit_credential_write_back,
  admit_enrollment_writer_lease,
  admit_enrollment_writer_lease_against_binding,
  admit_enrollment_writer_lease_publish,
  admit_setup_token_capture,
  claude_enrollment_standing_bundle_from_paired_probe_verdict,
  claude_enrollment_limit_subject,
  claude_enrollment_action_for_absent_credential,
  ReconnectClaude,
  ConnectClaude,
  EnrollmentActionNotRequired,
  claude_enrollment_action_for_credential_standing,
