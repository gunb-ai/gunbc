  EntitlementObservedAvailable,
}

test fn witness_secret_version_refuses_latest() -> Bool {
  match admit_enrollment_secret_version(version: "latest") {
    EnrollmentSecretVersionRefusedLatest => true
    _ => false
  }
}

test fn witness_secret_version_refuses_empty() -> Bool {
  match admit_enrollment_secret_version(version: "") {
    EnrollmentSecretVersionRefusedEmpty => true
    _ => false
  }
}

test fn witness_secret_version_admits_exact() -> Bool {
  match admit_enrollment_secret_version(version: "7") {
    EnrollmentSecretVersionAdmitted => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_multiple_candidates() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 2,
    token: Present { value: "sk-ant-oat01-test" },
    format: SetupTokenFormatMeasured {
      format: ClaudeSetupTokenFormatMeasured {
        token_prefix: "sk-ant-oat01-" as NonEmptyStr,
        min_length: character_count(count: 20),
        max_length: character_count(count: 200),
      },
    },
  ) {
    SetupTokenCaptureRefusedMultipleCandidates { count: 2 } => true
    _ => false
  }
}

test fn witness_setup_token_capture_admits_single_candidate() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: Present { value: "sk-ant-oat01-abcdefghijklmnopqrstuvwxyz" },
    format: SetupTokenFormatMeasured {
      format: ClaudeSetupTokenFormatMeasured {
        token_prefix: "sk-ant-oat01-" as NonEmptyStr,
        min_length: character_count(count: 20),
        max_length: character_count(count: 200),
      },
    },
  ) {
    SetupTokenCaptureAdmitted { token_length: _ } => true
    _ => false
  }
}

fn witness_setup_token_format_measured() -> ClaudeSetupTokenFormatObservation {
  SetupTokenFormatMeasured {
    format: ClaudeSetupTokenFormatMeasured {
      token_prefix: "sk-ant-oat01-" as NonEmptyStr,
      min_length: character_count(count: 20),
      max_length: character_count(count: 200),
    },
  }
}

test fn witness_setup_token_capture_refuses_format_unobserved() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: Present { value: "sk-ant-oat01-abcdefghijklmnopqrstuvwxyz" },
    format: SetupTokenFormatUnobserved {
      reason: "pinned executable format not yet measured" as NonEmptyStr,
    },
  ) {
    SetupTokenCaptureRefusedFormatUnobserved { reason } =>
      reason == ("pinned executable format not yet measured" as NonEmptyStr)
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_no_candidate() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 0,
    token: Absent,
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedNoCandidate => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_malformed_prefix() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: Present { value: "wrong-prefix-abcdefghijklmnopqrstuvwxyz" },
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedMalformedPrefix => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_malformed_length() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: Present { value: "sk-ant-oat01-short" },
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedMalformedLength { observed: _, min: _, max: _ } => true
    _ => false
  }
}

test fn witness_paired_probe_native_limit_encoding() -> Bool {
  let seven_day_opus = "seven_day_opus" as NonEmptyStr
  let five_hour = "five_hour" as NonEmptyStr
  let bundle = claude_enrollment_standing_bundle_from_paired_probe_verdict(
    auth_succeeded: true,
    observed_native_limit_keys: [seven_day_opus, five_hour],
    auth_failure_reason: "unused" as NonEmptyStr,
    credential_label: "managed-enrollment" as NonEmptyStr,
  )
  let subject = claude_enrollment_limit_subject(
    credential_label: "managed-enrollment" as NonEmptyStr,
    native_key: seven_day_opus,
  )
  bundle.authentication == AuthenticationAuthenticated
    && bundle.entitlement == EntitlementObservedAvailable
    && list_length(items: bundle.limits) == 2
    && match subject {
      ProviderNativeLimitBucket {
        credential: LimitCredentialLabel { label },
        native_key,
      } =>
        label == ("managed-enrollment" as NonEmptyStr)
          && native_key == seven_day_opus
      _ => false
    }
}

test fn witness_rejected_credential_emits_reconnect_action() -> Bool {
  match claude_enrollment_action_for_credential_standing(
    standing: ClaudeCredentialRejected { reason: "token revoked" as NonEmptyStr },
  ) {
    ReconnectClaude { cause } => cause == ("token revoked" as NonEmptyStr)
    ConnectClaude => false
    EnrollmentActionNotRequired => false
  }
}

test fn witness_usable_credential_emits_no_enrollment_action() -> Bool {
  claude_enrollment_action_for_credential_standing(
    standing: ClaudeCredentialUsable,
  ) == EnrollmentActionNotRequired
}

test fn witness_absent_credential_emits_connect_action() -> Bool {
  claude_enrollment_action_for_absent_credential() == ConnectClaude
}

test fn witness_enrollment_initiation_refuses_sdk_path() -> Bool {
  match admit_enrollment_initiation(surface: EnrollmentInitiationSdkAttempt) {
    EnrollmentInitiationRefusedSdkPath { reason } =>
      string_contains(
        s: reason as String,
        pattern: "setup-token CLI",
      )
    _ => false
  }
}

test fn witness_enrollment_initiation_admits_cli_path() -> Bool {
  match admit_enrollment_initiation(surface: EnrollmentInitiationClaudeCli) {
    EnrollmentInitiationAdmitted => true
    _ => false
  }
}

test fn witness_cold_start_refuses_ambient_prerequisite() -> Bool {
  match admit_enrollment_cold_start(
    relies_on_ambient_enrollment_host_credential: true,
  ) {
    EnrollmentColdStartRefusedAmbientPrerequisite { reason: _ } => true
    _ => false
  }
}

test fn witness_cold_start_admits_isolated_context() -> Bool {
  match admit_enrollment_cold_start(
    relies_on_ambient_enrollment_host_credential: false,
  ) {
    EnrollmentColdStartAdmitted => true
    _ => false
  }
}

test fn witness_credential_write_back_refuses_unchanged_digest() -> Bool {
  let digest = ClaudeCredentialArtifactDigest {
    digest: "sha256:deadbeef" as NonEmptyStr,
  }
  match admit_credential_write_back(
    observation: Present {
      value: ClaudeCredentialArtifactObservationPair {
        before_use: digest,
        after_use: digest,
      },
    },
  ) {
    CredentialWriteBackRefusedUnchanged { digest: observed } =>
      observed.digest == ("sha256:deadbeef" as NonEmptyStr)
    _ => false
  }
}

test fn witness_credential_write_back_admits_changed_digest() -> Bool {
  match admit_credential_write_back(
    observation: Present {
      value: ClaudeCredentialArtifactObservationPair {
        before_use: ClaudeCredentialArtifactDigest {
          digest: "sha256:before" as NonEmptyStr,
        },
        after_use: ClaudeCredentialArtifactDigest {
          digest: "sha256:after" as NonEmptyStr,
        },
      },
    },
  ) {
    CredentialWriteBackAdmitted { prior: _, observed: observed } =>
      observed.digest == ("sha256:after" as NonEmptyStr)
    _ => false
  }
}

test fn witness_credential_write_back_refuses_missing_observation() -> Bool {
  match admit_credential_write_back(observation: Absent) {
    CredentialWriteBackRefusedMissingObservation { reason: _ } => true
    _ => false
  }
}

test fn witness_writer_lease_refuses_concurrent_holder() -> Bool {
  match admit_enrollment_writer_lease(
    holder: "host-b" as NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: Present { value: "host-a" as NonEmptyStr },
    incumbent_version: Present { value: "7" as NonEmptyStr },
    incumbent_epoch: Present { value: 2 },
  ) {
    EnrollmentLeaseRefusedConcurrent {
      incumbent_holder,
      incumbent_binding_version,
      incumbent_epoch,
    } =>
      incumbent_holder == ("host-a" as NonEmptyStr)
        && incumbent_binding_version == ("7" as NonEmptyStr)
        && incumbent_epoch == 2
    _ => false
  }
}

test fn witness_writer_lease_refuses_newer_binding() -> Bool {
  match admit_enrollment_writer_lease_against_binding(
    holder: "host-a" as NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: Absent,
    incumbent_version: "9" as NonEmptyStr,
    incumbent_epoch: Absent,
    attempted_version: "8" as NonEmptyStr,
    incumbent_version_is_newer: true,
  ) {
    EnrollmentLeaseRefusedNewerBindingExists {
      incumbent_version,
      attempted_version,
    } =>
      incumbent_version == ("9" as NonEmptyStr)
        && attempted_version == ("8" as NonEmptyStr)
    _ => false
  }
}

test fn witness_writer_lease_grants_absent_incumbent() -> Bool {
  match admit_enrollment_writer_lease(
    holder: "host-a" as NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: Absent,
    incumbent_version: Absent,
    incumbent_epoch: Absent,
  ) {
    EnrollmentLeaseGranted { holder, epoch } =>
      holder == ("host-a" as NonEmptyStr) && epoch == 1
    _ => false
  }
}

test fn witness_writer_lease_publish_refuses_stale_epoch() -> Bool {
  match admit_enrollment_writer_lease_publish(holder_epoch: 2, current_epoch: 3) {
    EnrollmentLeasePublishRefusedStaleEpoch {
      holder_epoch,
      current_epoch,
    } =>
      holder_epoch == 2 && current_epoch == 3
    _ => false
  }
}

test fn witness_writer_lease_publish_grants_current_epoch() -> Bool {
  match admit_enrollment_writer_lease_publish(holder_epoch: 3, current_epoch: 3) {
    EnrollmentLeasePublishGranted => true
    _ => false
  }
}

test fn claude_setup_token_enrollment_keystone_holds() -> Bool {
  witness_secret_version_refuses_latest()
    && witness_secret_version_refuses_empty()
    && witness_secret_version_admits_exact()
    && witness_enrollment_initiation_refuses_sdk_path()
    && witness_enrollment_initiation_admits_cli_path()
    && witness_cold_start_refuses_ambient_prerequisite()
    && witness_cold_start_admits_isolated_context()
    && witness_credential_write_back_refuses_unchanged_digest()
    && witness_credential_write_back_admits_changed_digest()
    && witness_credential_write_back_refuses_missing_observation()
    && witness_setup_token_capture_refuses_multiple_candidates()
    && witness_setup_token_capture_refuses_format_unobserved()
    && witness_setup_token_capture_refuses_no_candidate()
    && witness_setup_token_capture_refuses_malformed_prefix()
    && witness_setup_token_capture_refuses_malformed_length()
    && witness_setup_token_capture_admits_single_candidate()
    && witness_paired_probe_native_limit_encoding()
    && witness_rejected_credential_emits_reconnect_action()
    && witness_usable_credential_emits_no_enrollment_action()
    && witness_absent_credential_emits_connect_action()
    && witness_writer_lease_refuses_concurrent_holder()
    && witness_writer_lease_refuses_newer_binding()
    && witness_writer_lease_grants_absent_incumbent()
    && witness_writer_lease_publish_refuses_stale_epoch()
    && witness_writer_lease_publish_grants_current_epoch()
}
