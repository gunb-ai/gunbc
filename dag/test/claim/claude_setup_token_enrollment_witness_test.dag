module test.claim.claude_setup_token_enrollment_witness


test fn witness_secret_version_refuses_latest() -> Bool {
  match admit_enrollment_secret_version(version: "latest") {
    EnrollmentSecretVersionRefusedLatest => true
    _ => false
  }
}

test fn witness_secret_version_refuses_empty() -> Bool {
  match admit_enrollment_secret_version(version: "") {
    EnrollmentSecretVersionRefusedEmpty => true
    _ => false
  }
}

test fn witness_secret_version_admits_exact() -> Bool {
  match admit_enrollment_secret_version(version: "7") {
    EnrollmentSecretVersionAdmitted => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_multiple_candidates() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 2,
    token: v2.std.optional.Present { value: "sk-ant-oat01-test" },
    format: extdeps.llm.claude_setup_token_cli.SetupTokenFormatMeasured {
      format: extdeps.llm.claude_setup_token_cli.ClaudeSetupTokenFormatMeasured {
        token_prefix: "sk-ant-oat01-" as std.types.NonEmptyStr,
        min_length: character_count(count: 20),
        max_length: character_count(count: 200),
      },
    },
  ) {
    SetupTokenCaptureRefusedMultipleCandidates { count: 2 } => true
    _ => false
  }
}

test fn witness_setup_token_capture_admits_single_candidate() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: v2.std.optional.Present { value: "sk-ant-oat01-abcdefghijklmnopqrstuvwxyz" },
    format: extdeps.llm.claude_setup_token_cli.SetupTokenFormatMeasured {
      format: extdeps.llm.claude_setup_token_cli.ClaudeSetupTokenFormatMeasured {
        token_prefix: "sk-ant-oat01-" as std.types.NonEmptyStr,
        min_length: character_count(count: 20),
        max_length: character_count(count: 200),
      },
    },
  ) {
    SetupTokenCaptureAdmitted { token_length: _ } => true
    _ => false
  }
}

fn witness_setup_token_format_measured() -> extdeps.llm.claude_setup_token_cli.ClaudeSetupTokenFormatObservation {
  extdeps.llm.claude_setup_token_cli.SetupTokenFormatMeasured {
    format: extdeps.llm.claude_setup_token_cli.ClaudeSetupTokenFormatMeasured {
      token_prefix: "sk-ant-oat01-" as std.types.NonEmptyStr,
      min_length: character_count(count: 20),
      max_length: character_count(count: 200),
    },
  }
}

test fn witness_setup_token_capture_refuses_format_unobserved() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: v2.std.optional.Present { value: "sk-ant-oat01-abcdefghijklmnopqrstuvwxyz" },
    format: extdeps.llm.claude_setup_token_cli.SetupTokenFormatUnobserved {
      reason: "pinned executable format not yet measured" as std.types.NonEmptyStr,
    },
  ) {
    SetupTokenCaptureRefusedFormatUnobserved { reason } =>
      reason == ("pinned executable format not yet measured" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_no_candidate() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 0,
    token: v2.std.optional.Absent,
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedNoCandidate => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_malformed_prefix() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: v2.std.optional.Present { value: "wrong-prefix-abcdefghijklmnopqrstuvwxyz" },
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedMalformedPrefix => true
    _ => false
  }
}

test fn witness_setup_token_capture_refuses_malformed_length() -> Bool {
  match admit_setup_token_capture(
    candidate_count: 1,
    token: v2.std.optional.Present { value: "sk-ant-oat01-short" },
    format: witness_setup_token_format_measured(),
  ) {
    SetupTokenCaptureRefusedMalformedLength { observed: _, min: _, max: _ } => true
    _ => false
  }
}

test fn witness_paired_probe_native_limit_encoding() -> Bool {
  let seven_day_opus = "seven_day_opus" as std.types.NonEmptyStr
  let five_hour = "five_hour" as std.types.NonEmptyStr
  let bundle = claude_enrollment_standing_bundle_from_paired_probe_verdict(
    auth_succeeded: true,
    observed_native_limit_keys: [seven_day_opus, five_hour],
    auth_failure_reason: "unused" as std.types.NonEmptyStr,
    credential_label: "managed-enrollment" as std.types.NonEmptyStr,
  )
  let subject = claude_enrollment_limit_subject(
    credential_label: "managed-enrollment" as std.types.NonEmptyStr,
    native_key: seven_day_opus,
  )
  bundle.authentication == AuthenticationAuthenticated
    && bundle.entitlement == EntitlementObservedAvailable
    && list_length(items: bundle.limits) == 2
    && match subject {
      ProviderNativeLimitBucket {
        credential: LimitCredentialLabel { label },
        native_key,
      } =>
        label == ("managed-enrollment" as std.types.NonEmptyStr)
          && native_key == seven_day_opus
      _ => false
    }
}

test fn witness_rejected_credential_emits_reconnect_action() -> Bool {
  match claude_enrollment_action_for_credential_standing(
    standing: gunbc.claude_setup_token_enrollment.ClaudeCredentialRejected { reason: "token revoked" as std.types.NonEmptyStr },
  ) {
    ReconnectClaude { cause } => cause == ("token revoked" as std.types.NonEmptyStr)
    ConnectClaude => false
    EnrollmentActionNotRequired => false
  }
}

test fn witness_usable_credential_emits_no_enrollment_action() -> Bool {
  claude_enrollment_action_for_credential_standing(
    standing: ClaudeCredentialUsable,
  ) == EnrollmentActionNotRequired
}

test fn witness_absent_credential_emits_connect_action() -> Bool {
  claude_enrollment_action_for_absent_credential() == ConnectClaude
}

test fn witness_enrollment_initiation_refuses_sdk_path() -> Bool {
  match admit_enrollment_initiation(surface: EnrollmentInitiationSdkAttempt) {
    EnrollmentInitiationRefusedSdkPath { reason } =>
      string_contains(
        s: reason as String,
        pattern: "setup-token CLI",
      )
    _ => false
  }
}

test fn witness_enrollment_initiation_admits_cli_path() -> Bool {
  match admit_enrollment_initiation(surface: EnrollmentInitiationClaudeCli) {
    EnrollmentInitiationAdmitted => true
    _ => false
  }
}

test fn witness_cold_start_refuses_ambient_prerequisite() -> Bool {
  match admit_enrollment_cold_start(
    relies_on_ambient_enrollment_host_credential: true,
  ) {
    EnrollmentColdStartRefusedAmbientPrerequisite { reason: _ } => true
    _ => false
  }
}

test fn witness_cold_start_admits_isolated_context() -> Bool {
  match admit_enrollment_cold_start(
    relies_on_ambient_enrollment_host_credential: false,
  ) {
    EnrollmentColdStartAdmitted => true
    _ => false
  }
}

test fn witness_credential_write_back_refuses_unchanged_digest() -> Bool {
  let digest = gunbc.claude_setup_token_enrollment.ClaudeAmbientOAuthArtifactDigest {
    digest: "sha256:deadbeef" as std.types.NonEmptyStr,
  }
  match admit_ambient_oauth_home_write_back(
    observation: v2.std.optional.Present {
      value: gunbc.claude_setup_token_enrollment.ClaudeAmbientOAuthArtifactObservationPair {
        before_use: digest,
        after_use: digest,
      },
    },
  ) {
    AmbientOAuthWriteBackRefusedUnchanged { digest: observed } =>
      observed.digest == ("sha256:deadbeef" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn witness_credential_write_back_admits_changed_digest() -> Bool {
  match admit_ambient_oauth_home_write_back(
    observation: v2.std.optional.Present {
      value: gunbc.claude_setup_token_enrollment.ClaudeAmbientOAuthArtifactObservationPair {
        before_use: gunbc.claude_setup_token_enrollment.ClaudeAmbientOAuthArtifactDigest {
          digest: "sha256:before" as std.types.NonEmptyStr,
        },
        after_use: gunbc.claude_setup_token_enrollment.ClaudeAmbientOAuthArtifactDigest {
          digest: "sha256:after" as std.types.NonEmptyStr,
        },
      },
    },
  ) {
    AmbientOAuthWriteBackAdmitted { prior: _, observed: observed } =>
      observed.digest == ("sha256:after" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn witness_credential_write_back_refuses_missing_observation() -> Bool {
  match admit_ambient_oauth_home_write_back(observation: v2.std.optional.Absent) {
    AmbientOAuthWriteBackRefusedMissingObservation { reason: _ } => true
    _ => false
  }
}

test fn witness_setup_token_standing_is_rotation_unobserved_by_default() -> Bool {
  claude_setup_token_standing_from_capture(
    capture: gunbc.claude_setup_token_enrollment.SetupTokenCaptureAdmitted {
      token_length: character_count(count: 42),
    },
  ) == SetupTokenUsable
}

test fn witness_enrollment_placement_refuses_unbound_operator_choices() -> Bool {
  match admit_enrollment_placement(
    choices: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentOperatorChoices {
      enrollment_host: v2.std.optional.Absent,
      run_as_principal: v2.std.optional.Absent,
      gcp_project: v2.std.optional.Absent,
      secret_id_or_create_authorization: v2.std.optional.Absent,
      account_label: v2.std.optional.Absent,
    },
    claude_runtime: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentRuntimeBinding {
      executable: "claude" as std.types.NonEmptyStr,
      version_pin: "pinned" as std.types.NonEmptyStr,
    },
    sdk_runtime: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentRuntimeBinding {
      executable: "claude-agent-sdk" as std.types.NonEmptyStr,
      version_pin: "0.3.220" as std.types.NonEmptyStr,
    },
  ) {
    EnrollmentPlacementRefusedUnbound { missing_axes } =>
      list_length(items: missing_axes) == 5
    _ => false
  }
}

test fn witness_enrollment_workflow_refuses_host_effects_scaffold() -> Bool {
  match admit_enrollment_workflow_start(
    placement_admission: admit_enrollment_placement(
      choices: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentOperatorChoices {
        enrollment_host: v2.std.optional.Present { value: "enrollment-host.example" as std.types.NonEmptyStr },
        run_as_principal: v2.std.optional.Present { value: "claude-enrollment" as std.types.NonEmptyStr },
        gcp_project: v2.std.optional.Present { value: "operator-selected-project" as std.types.NonEmptyStr },
        secret_id_or_create_authorization: v2.std.optional.Present {
          value: "operator-selected-secret" as std.types.NonEmptyStr,
        },
        account_label: v2.std.optional.Present { value: "operator-selected-label" as std.types.NonEmptyStr },
      },
      claude_runtime: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentRuntimeBinding {
        executable: "claude" as std.types.NonEmptyStr,
        version_pin: "pinned" as std.types.NonEmptyStr,
      },
      sdk_runtime: gunbc.claude_setup_token_enrollment.ClaudeEnrollmentRuntimeBinding {
        executable: "claude-agent-sdk" as std.types.NonEmptyStr,
        version_pin: "0.3.220" as std.types.NonEmptyStr,
      },
    ),
  ) {
    EnrollmentWorkflowRefusedDeploymentModelGap { reason: _ } => true
    _ => false
  }
}

test fn witness_exact_secret_version_binding_admits_write_and_readback() -> Bool {
  match admit_exact_secret_version_binding(
    target: gunbc.claude_setup_token_enrollment.EnrollmentSecretTargetSpecified {
      project: "operator-selected-project" as std.types.NonEmptyStr,
      secret: "operator-selected-secret" as std.types.NonEmptyStr,
    },
    write: gunbc.claude_setup_token_enrollment.EnrollmentSecretWritten { version: "7" as std.types.NonEmptyStr },
    readback: gunbc.claude_setup_token_enrollment.EnrollmentSecretReadBackOk {
      version: "7" as std.types.NonEmptyStr,
      private_content_identity: "sha256:managed-token" as std.types.NonEmptyStr,
      digest_matches: true,
    },
  ) {
    ExactSecretVersionBindingAdmitted { binding } =>
      binding.version == ("7" as std.types.NonEmptyStr)
        && binding.private_content_identity == ("sha256:managed-token" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn witness_writer_lease_refuses_concurrent_holder() -> Bool {
  match admit_enrollment_writer_lease(
    holder: "host-b" as std.types.NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: v2.std.optional.Present { value: "host-a" as std.types.NonEmptyStr },
    incumbent_version: v2.std.optional.Present { value: "7" as std.types.NonEmptyStr },
    incumbent_epoch: v2.std.optional.Present { value: 2 },
  ) {
    EnrollmentLeaseRefusedConcurrent {
      incumbent_holder,
      incumbent_binding_version,
      incumbent_epoch,
    } =>
      incumbent_holder == ("host-a" as std.types.NonEmptyStr)
        && incumbent_binding_version == ("7" as std.types.NonEmptyStr)
        && incumbent_epoch == 2
    _ => false
  }
}

test fn witness_writer_lease_refuses_newer_binding() -> Bool {
  match admit_enrollment_writer_lease_against_binding(
    holder: "host-a" as std.types.NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: v2.std.optional.Absent,
    incumbent_version: "9" as std.types.NonEmptyStr,
    incumbent_epoch: v2.std.optional.Absent,
    attempted_version: "8" as std.types.NonEmptyStr,
    incumbent_version_is_newer: true,
  ) {
    EnrollmentLeaseRefusedNewerBindingExists {
      incumbent_version,
      attempted_version,
    } =>
      incumbent_version == ("9" as std.types.NonEmptyStr)
        && attempted_version == ("8" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn witness_writer_lease_grants_absent_incumbent() -> Bool {
  match admit_enrollment_writer_lease(
    holder: "host-a" as std.types.NonEmptyStr,
    holder_epoch: 1,
    incumbent_holder: v2.std.optional.Absent,
    incumbent_version: v2.std.optional.Absent,
    incumbent_epoch: v2.std.optional.Absent,
  ) {
    EnrollmentLeaseGranted { holder, epoch } =>
      holder == ("host-a" as std.types.NonEmptyStr) && epoch == 1
    _ => false
  }
}

test fn witness_writer_lease_publish_refuses_stale_epoch() -> Bool {
  match admit_enrollment_writer_lease_publish(holder_epoch: 2, current_epoch: 3) {
    EnrollmentLeasePublishRefusedStaleEpoch {
      holder_epoch,
      current_epoch,
    } =>
      holder_epoch == 2 && current_epoch == 3
    _ => false
  }
}

test fn witness_writer_lease_publish_grants_current_epoch() -> Bool {
  match admit_enrollment_writer_lease_publish(holder_epoch: 3, current_epoch: 3) {
    EnrollmentLeasePublishGranted => true
    _ => false
  }
}

test fn witness_setup_token_challenge_extracts_https_url_from_sentence() -> Bool {
  let pane = concat(
    concat("Open https://claude.ai/oauth/verify in your browser", "\n"),
    concat(concat("Enter this code", "\n"), "ABCD-1234"),
  ) as std.types.RenderedTerminalText
  match parse_setup_token_challenge_from_terminal(pane: pane) {
    SetupTokenChallengeParsed {
      challenge: ClaudeSetupTokenBrowserChallenge {
        verification_uri: uri,
        user_code: _,
      },
    } =>
      uri == "https://claude.ai/oauth/verify" as std.types.NonEmptyStr
    SetupTokenChallengeParseRefused { reason: _ } => false
  }
}

test fn witness_setup_token_challenge_refuses_url_line_without_token() -> Bool {
  let pane = concat(
    concat("Openhttps://claude.ai/oauth/verify", "\n"),
    concat(concat("Enter this code", "\n"), "ABCD-1234"),
  ) as std.types.RenderedTerminalText
  match parse_setup_token_challenge_from_terminal(pane: pane) {
    SetupTokenChallengeParseRefused { reason: _ } => true
    SetupTokenChallengeParsed { challenge: _ } => false
  }
}

test fn claude_setup_token_enrollment_keystone_holds() -> Bool {
  witness_secret_version_refuses_latest()
    && witness_secret_version_refuses_empty()
    && witness_secret_version_admits_exact()
    && witness_enrollment_initiation_refuses_sdk_path()
    && witness_enrollment_initiation_admits_cli_path()
    && witness_cold_start_refuses_ambient_prerequisite()
    && witness_cold_start_admits_isolated_context()
    && witness_credential_write_back_refuses_unchanged_digest()
    && witness_credential_write_back_admits_changed_digest()
    && witness_credential_write_back_refuses_missing_observation()
    && witness_setup_token_capture_refuses_multiple_candidates()
    && witness_setup_token_capture_refuses_format_unobserved()
    && witness_setup_token_capture_refuses_no_candidate()
    && witness_setup_token_capture_refuses_malformed_prefix()
    && witness_setup_token_capture_refuses_malformed_length()
    && witness_setup_token_capture_admits_single_candidate()
    && witness_setup_token_challenge_extracts_https_url_from_sentence()
    && witness_setup_token_challenge_refuses_url_line_without_token()
    && witness_paired_probe_native_limit_encoding()
    && witness_rejected_credential_emits_reconnect_action()
    && witness_usable_credential_emits_no_enrollment_action()
    && witness_absent_credential_emits_connect_action()
    && witness_writer_lease_refuses_concurrent_holder()
    && witness_writer_lease_refuses_newer_binding()
    && witness_writer_lease_grants_absent_incumbent()
    && witness_writer_lease_publish_refuses_stale_epoch()
    && witness_writer_lease_publish_grants_current_epoch()
    && witness_enrollment_placement_refuses_unbound_operator_choices()
    && witness_enrollment_workflow_refuses_host_effects_scaffold()
    && witness_exact_secret_version_binding_admits_write_and_readback()
    && witness_setup_token_standing_is_rotation_unobserved_by_default()
}
