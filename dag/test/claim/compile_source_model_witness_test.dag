module test.claim.compile_source_model_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn role_is_entry(r: gunbc.compile_source_model.SourceRootRole) -> Bool {
  match r { EntrySourceRoot => true, DependencyPoolRoot => false }
}

fn role_is_pool(r: gunbc.compile_source_model.SourceRootRole) -> Bool {
  match r { EntrySourceRoot => false, DependencyPoolRoot => true }
}

fn w_flags_parse() -> Bool {
  match gunbc.compile_source_model.dependency_pool_index_from_flag(flag: "strict") {
    Present { value: gunbc.compile_source_model.StrictPoolIndex } => true
    _ => false
  } &&
  match gunbc.compile_source_model.dependency_pool_index_from_flag(flag: "primary-precedence") {
    Present { value: gunbc.compile_source_model.PrimaryPrecedencePoolIndex } => true
    _ => false
  } &&
  match gunbc.compile_source_model.dependency_pool_index_from_flag(flag: "bogus") {
    Absent => true
    Present { value: _ } => false
  }
}

fn w_primary_precedence_roles() -> Bool {
  role_is_entry(r: gunbc.compile_source_model.source_root_role(root_index: 0, pool_index: gunbc.compile_source_model.PrimaryPrecedencePoolIndex)) &&
  role_is_pool(r: gunbc.compile_source_model.source_root_role(root_index: 1, pool_index: gunbc.compile_source_model.PrimaryPrecedencePoolIndex))
}

fn w_strict_roles_all_entry() -> Bool {
  role_is_entry(r: gunbc.compile_source_model.source_root_role(root_index: 0, pool_index: gunbc.compile_source_model.StrictPoolIndex)) &&
  role_is_entry(r: gunbc.compile_source_model.source_root_role(root_index: 1, pool_index: gunbc.compile_source_model.StrictPoolIndex))
}

fn w_pool_fill_only_policy() -> Bool {
  !gunbc.compile_source_model.pool_fill_only_for_role(role: gunbc.compile_source_model.EntrySourceRoot, pool_index: gunbc.compile_source_model.PrimaryPrecedencePoolIndex) &&
  gunbc.compile_source_model.pool_fill_only_for_role(role: gunbc.compile_source_model.DependencyPoolRoot, pool_index: gunbc.compile_source_model.PrimaryPrecedencePoolIndex) &&
  !gunbc.compile_source_model.pool_fill_only_for_role(role: gunbc.compile_source_model.DependencyPoolRoot, pool_index: gunbc.compile_source_model.StrictPoolIndex)
}

fn w_indexing_branch_table() -> Bool {
  gunbc.compile_source_model.skip_pool_module_when_indexed(module_already_indexed: true, pool_fill_only: true) &&
  !gunbc.compile_source_model.skip_pool_module_when_indexed(module_already_indexed: true, pool_fill_only: false) &&
  gunbc.compile_source_model.duplicate_module_path_across_index_is_error(module_already_indexed: true, pool_fill_only: false) &&
  !gunbc.compile_source_model.duplicate_module_path_across_index_is_error(module_already_indexed: true, pool_fill_only: true) &&
  gunbc.compile_source_model.duplicate_module_path_within_root_scan_is_error()
}

fn w_compile_entry_root_index() -> Bool {
  gunbc.compile_source_model.compile_entry_source_root_index() == 0
}

test fn compile_source_model_witnesses() -> Bool {
  w_flags_parse() &&
  w_primary_precedence_roles() &&
  w_strict_roles_all_entry() &&
  w_pool_fill_only_policy() &&
  w_indexing_branch_table() &&
  w_compile_entry_root_index()
}
