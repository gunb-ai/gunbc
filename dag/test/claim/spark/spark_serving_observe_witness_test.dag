// REVIEW 52605. The runner-side observe entry greened on any receipt write, so a host that could
// not be probed at all reported the same exit code as one that answered. The repair adds a
// distinct axis: an observation that was MADE (present or absent) is not an observation that
// SUCCEEDED. These pin both directions, because collapsing them either way is a real defect --
// treating absent as a probe failure would red the step on a correct reading of a bare host.
test fn refused_observation_was_not_made() -> Bool {
  spark_serving_observation_was_made(
    observation: SparkServingObservationRefused {
      host: "srv5",
      cause: "ssh exec refused" as NonEmptyStr,
    },
  ) == false
}

test fn absent_observation_was_made_though_it_did_not_succeed() -> Bool {
  let obs = SparkServingAbsent { host: "srv5" }
  spark_serving_observation_was_made(observation: obs)
    && spark_serving_observation_succeeded(observation: obs) == false
}

test fn report_with_a_refused_host_refuses_even_when_a_sibling_answered() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationsProduced {
      first: ho_from(readback: readback_absent_at(host: "srv5")),
      more: [
        ho_from(readback: readback_inactive_at(host: "srv6")),
      ],
    },
  ) == false
}

test fn report_of_two_bare_hosts_counts_as_observed() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationsProduced {
      first: ho_from(readback: readback_absent_at(host: "srv5")),
      more: [ho_from(readback: readback_absent_at(host: "srv6"))],
    },
  )
}

// P0-C2 CONTROLS AGAINST THE PRODUCTION REPORT CONSTRUCTOR.
//
// The coverage relation's own claims live beside it in v2.test.claim.spark_observation_scope and
// exercise the pure join. These are deliberately different: they run the CONSTRUCTION PATH the
// converge actually calls, because a correct helper wired to nothing is the specification-without-
// execution trap, and the incident being repaired was exactly a green production report over a
// narrowed roster.
fn ho_at(host: HostIdentity) -> SparkServingHostObservation {
  ho_from(readback: readback_absent_at(host: host))
}

fn ho_at_refused(host: HostIdentity) -> SparkServingHostObservation {
  ho_from(readback: readback_inactive_at(host: host))
}

fn report_is_refused(r: SparkServingObservationReport) -> Bool {
  match r {
    SparkServingObservationsProduced { first: _, more: _ } => false
    SparkServingObservationReportRefused { refusal: _ } => true
  }
}

// ASKING WHICH REFUSAL, NOT MERELY WHETHER. The seven controls below originally reduced every
// coverage defect to report_is_refused, which established that the constructor refused and nothing
// about what it carried -- so an implementation that computed the three typed populations and then
// discarded them into a formatted string passed all seven. It did, and review of #9754 found it.
// "Identity join versus cardinality" and "typed result versus rendered cause" are two different
// properties and need two different controls.
fn refusal_missing(r: SparkServingObservationReport) -> List<HostIdentity> {
  match r {
    SparkServingObservationsProduced { first: _, more: _ } => []
    SparkServingObservationReportRefused { refusal: x } =>
      match x {
        SparkServingObservationCoverageIncomplete { missing: m, foreign: _, duplicated: _ } => m
        SparkServingObservationScopeEmpty => []
        SparkServingObservationPrerequisiteRefused { cause: _ } => []
      }
  }
}

fn refusal_foreign(r: SparkServingObservationReport) -> List<HostIdentity> {
  match r {
    SparkServingObservationsProduced { first: _, more: _ } => []
    SparkServingObservationReportRefused { refusal: x } =>
      match x {
        SparkServingObservationCoverageIncomplete { missing: _, foreign: f, duplicated: _ } => f
        SparkServingObservationScopeEmpty => []
        SparkServingObservationPrerequisiteRefused { cause: _ } => []
      }
  }
}

fn refusal_duplicated(r: SparkServingObservationReport) -> List<HostIdentity> {
  match r {
    SparkServingObservationsProduced { first: _, more: _ } => []
    SparkServingObservationReportRefused { refusal: x } =>
      match x {
        SparkServingObservationCoverageIncomplete { missing: _, foreign: _, duplicated: d } => d
        SparkServingObservationScopeEmpty => []
        SparkServingObservationPrerequisiteRefused { cause: _ } => []
      }
  }
}

fn refusal_is_scope_empty(r: SparkServingObservationReport) -> Bool {
  match r {
    SparkServingObservationsProduced { first: _, more: _ } => false
    SparkServingObservationReportRefused { refusal: x } =>
      match x {
        SparkServingObservationScopeEmpty => true
        SparkServingObservationCoverageIncomplete { missing: _, foreign: _, duplicated: _ } => false
        SparkServingObservationPrerequisiteRefused { cause: _ } => false
      }
  }
}

fn only_host(hosts: List<HostIdentity>, host: HostIdentity) -> Bool {
  (hosts |> count) == 1 && any(hosts, h => h == host)
}

// The narrowed roster names srv6 as MISSING specifically -- not merely "something was wrong".
test fn the_narrowed_roster_refusal_names_srv6_as_missing() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5")],
  )
  only_host(hosts: refusal_missing(r: r), host: "srv6")
    && ((refusal_foreign(r: r) |> count) == 0)
    && ((refusal_duplicated(r: r) |> count) == 0)
}

// A foreign host is a SCOPE DISAGREEMENT and must not be reported as a missing one.
test fn the_foreign_host_refusal_names_srv7_as_foreign_and_nothing_as_missing() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at(host: "srv6"), ho_at(host: "srv7")],
  )
  only_host(hosts: refusal_foreign(r: r), host: "srv7")
    && ((refusal_missing(r: r) |> count) == 0)
}

// A duplicate is a roster that counted one machine twice, and srv6 is missing in the same breath --
// two distinct defects carried separately rather than summed into one sentence.
test fn the_duplicate_refusal_names_srv5_duplicated_and_srv6_missing() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at(host: "srv5")],
  )
  any(refusal_duplicated(r: r), h => h == "srv5")
    && only_host(hosts: refusal_missing(r: r), host: "srv6")
}

// The empty scope is its OWN arm, not a coverage result with empty populations -- those are
// different facts and a consumer must be able to tell them apart.
test fn the_empty_scope_refusal_is_its_own_arm_not_an_empty_coverage_result() -> Bool {
  refusal_is_scope_empty(r: spark_serving_observation_report_from_observations(
    expected: [],
    observations: [ho_at(host: "srv5")],
  ))
}

test fn a_coverage_defect_is_never_reported_through_the_prerequisite_arm() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5")],
  )
  !refusal_is_scope_empty(r: r) && ((refusal_missing(r: r) |> count) > 0)
}

// (1) The incident itself: expected {srv5,srv6}, only srv5 answered. Nonempty, and refused.
test fn a_narrowed_roster_refuses_even_though_the_observation_list_is_nonempty() -> Bool {
  report_is_refused(r: spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5")],
  ))
}

// (2) A probe that did not answer still COVERS its subject. Coverage and answered-ness are two
// questions, and collapsing them would make a refused probe look like an unprobed host.
test fn a_refused_probe_satisfies_coverage_while_failing_the_observation_terminal() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at_refused(host: "srv6")],
  )
  !report_is_refused(r: r) && (spark_serving_report_observations_were_made(report: r) == false)
}

// (3) The post-retirement state a read-only instrument must accept: srv6 absent is a real
// observation, not a gap.
test fn an_absent_host_satisfies_coverage_and_the_read_only_report_succeeds() -> Bool {
  let r = spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at(host: "srv6")],
  )
  !report_is_refused(r: r) && spark_serving_report_observations_were_made(report: r)
}

// (4) A host nobody expected is a scope disagreement, not a bonus.
test fn a_foreign_host_refuses() -> Bool {
  report_is_refused(r: spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at(host: "srv6"), ho_at(host: "srv7")],
  ))
}

// (5) A duplicate is a roster that counted one machine twice, and the count it inflates is exactly
// the one the deleted cardinality guard used to read.
test fn a_duplicated_host_refuses_despite_the_row_count_looking_right() -> Bool {
  report_is_refused(r: spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [ho_at(host: "srv5"), ho_at(host: "srv5")],
  ))
}

// (6) Coverage over an empty expected roster is vacuously true -- no host is missing from a roster
// that demands nobody -- which is why the scope is admitted on its own arm before the join runs.
//
// THE OBSERVATIONS HERE ARE DELIBERATELY NONEMPTY. An earlier draft of this claim passed [] for both
// arguments and was measured to pass under a control that restored the old count guard, because an
// empty observation list refuses under EITHER implementation -- the right verdict for the wrong
// reason, which is a claim that cannot see the thing it was written to see. With a real observation
// against an empty scope the two implementations disagree: the count guard produces a clean report,
// the coverage join refuses.
test fn an_empty_expected_scope_refuses_rather_than_covering_vacuously() -> Bool {
  report_is_refused(r: spark_serving_observation_report_from_observations(
    expected: [],
    observations: [ho_at(host: "srv5")],
  ))
}

// (7) The old guard's case still refuses -- through the join now, not through a count. Nonemptiness
// is derived from an admitted scope plus exact coverage, so nothing was lost by deleting it.
test fn an_empty_observation_list_against_a_real_scope_still_refuses() -> Bool {
  report_is_refused(r: spark_serving_observation_report_from_observations(
    expected: ["srv5", "srv6"],
    observations: [],
  ))
}

test fn a_refused_report_is_never_read_as_observed() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationReportRefused {
      refusal: SparkServingObservationPrerequisiteRefused { cause: "no host was probed" as NonEmptyStr },
    },
  ) == false
}

// THE COMMA IS ADMITTED AND THE BRACE IS NOT, asserted as a pair because a widening argued on paper
// and unchecked in the tree is the specification-without-execution trap. The comma is inert in POSIX
// sh; brace expansion is the one context that gives it meaning, and it needs braces, which stay
// refused. If a future edit widens the alphabet toward `{`, this goes red.
test fn the_word_alphabet_admits_a_comma_and_still_refuses_a_brace() -> Bool {
  match portable_remote_words(raws: ["nvidia-smi", "--format=csv,noheader"]) {
    Absent => false
    Present { value: _ } =>
      match portable_remote_words(raws: ["echo", "\{a,b}"]) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

// THE PROBE THAT FORCED IT, asserted against the real argv rather than a hand-written stand-in: the
// read-only observation's nvidia leg had been refused at the transport since it was written, and
// nothing could report why until the refusal reason was carried.
test fn the_nvidia_driver_probe_is_portable() -> Bool {
  match portable_remote_words(raws: spark_serving_nvidia_driver_probe_words) {
    Present { value: _ } => true
    Absent => false
  }
}

// The observation LINE is the production consumer: boot provenance that never reached the emitted
// receipt would be a carrier nobody reads. Asserting the two live cases render differently is what
// makes the field load-bearing rather than present.
test fn the_readback_line_carries_boot_provenance() -> Bool {
  string_contains(
    spark_serving_readback_line(readback: readback_active_complete()),
    "boot-provenance=",
  )
    && string_contains(
         spark_serving_readback_line(readback: readback_active_complete()),
         "boot-provenance=unobserved",
       )
}

// An absent leg is unobserved on the leg's OWN behalf and never a durability verdict, asserted here
// on the wiring rather than only on the classifier it delegates to.
test fn an_absent_boot_probe_leg_is_unobserved_at_the_wiring() -> Bool {
  match spark_serving_boot_provenance_from_probes(active_enter: none, default_target_enter: none, uptime: none) {
    BootProvenanceUnobserved { cause: c } =>
      string_contains(c as String, "ActiveEnterTimestampMonotonic probe leg did not run")
    UnitStartedByManagerAtBoot { active_enter_monotonic: _, uptime: _ } => false
    UnitStartedAfterBoot { active_enter_monotonic: _, uptime: _ } => false
    UnitNotActiveAtAll => false
  }
}

// THE WET RECEIPT IS THE CONSUMER, and this witness exists because the first version of this work
// had none: the field was required, witnessed, and rendered by a function the emitted report never
// called, so a canary run reported a host observed and said nothing about durability. Asserting on
// the report TEXT is the difference between a fact that reaches the operator and one that does not.
test fn the_emitted_report_text_carries_boot_provenance_per_host() -> Bool {
  let text = spark_serving_observation_report_text(
    report: SparkServingObservationsProduced {
      first: ho_from(readback: readback_absent_at(host: "srv5")),
      more: [ho_from(readback: readback_absent_at(host: "srv6"))],
    },
    probed_at: "2026-08-20T00:00:00Z",
    attempt_raw: "fixture",
    materialization_receipt: "",
  )
  string_contains(text, "boot-provenance=")
    && string_contains(text, "observation host=srv5")
    && string_contains(text, "observation host=srv6")
}

// The grant standing rides the same receipt, because a host that is serving but cannot be rebooted
// is a fact about that host, and the run that reads everything else about it is where an operator
// will look. Asserting on the text keeps it from becoming another renderer nobody calls.
test fn the_emitted_report_text_carries_the_grant_standing() -> Bool {
  let text = spark_serving_observation_report_text(
    report: SparkServingObservationsProduced {
      first: ho_from(readback: readback_absent_at(host: "srv5")),
      more: [],
    },
    probed_at: "2026-08-20T00:00:00Z",
    attempt_raw: "fixture",
    materialization_receipt: "",
  )
  string_contains(text, "grant-standing host=srv5")
    && string_contains(text, "converged=false")
    && string_contains(text, "standing=unobserved")
}

// ── the managed-account observation ─────────────────────────────────────────────────────────────
//
// These decode real command output shapes rather than a shape invented for the test: `getent passwd`
// emits the seven-field colon record, and `stat -c '%a %U %G'` emits three space-separated fields.
// The arms are asserted apart, because the whole point of the coproduct is that an account that does
// not exist and an account whose key file could not be read are different states with different
// remedies.

fn account_probe(exit_code: Int, success: Bool, stdout: String) -> SshSessionExecResult? {
  Present {
    value: SshSessionExecResult { exit_code: exit_code, success: success, stdout: stdout, stderr: "" },
  }
}

data fixture_passwd_row: String = "gunbc-automation:x:1002:1002::/home/gunbc-automation:/bin/bash"

test fn a_passwd_row_and_a_stat_line_decode_to_an_observed_account() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(exit_code: 0, success: true, stdout: fixture_passwd_row),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw-------  1 gunbc-automation gunbc-automation 96 Aug 10 19:51 /home/gunbc-automation/.ssh/authorized_keys"),
  ) {
    ManagedAccountObserved { login: l, uid: u, gid: g, shell: sh, authorized_keys_mode: m, authorized_keys_owner: o } =>
      (l as String) == "gunbc-automation"
        && (u as String) == "1002"
        && (g as String) == "1002"
        && (sh as String) == "/bin/bash"
        && (m as String) == "-rw-------"
        && (o as String) == "gunbc-automation"
    _ => false
  }
}

// THE DISCRIMINATING RED for the field positions. A passwd record's shell is field SEVEN and its uid
// is field THREE; an off-by-one in either would still produce a well-formed ManagedAccountObserved
// carrying plausible strings, which is exactly the failure a shape-only assertion cannot see. So this
// asserts the VALUES land in the right fields, on a row whose fields are all distinguishable.
test fn the_passwd_fields_are_read_at_their_real_positions() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(
      exit_code: 0, success: true,
      stdout: "LOGIN:x:UIDFIELD:GIDFIELD:GECOS:/home/dir:SHELLFIELD",
    ),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "drwx------ 2 owner group 4096 Aug 10 19:51 /home/x/.ssh"),
  ) {
    ManagedAccountObserved { login: l, uid: u, gid: g, shell: sh, authorized_keys_mode: _, authorized_keys_owner: _ } =>
      (l as String) == "LOGIN"
        && (u as String) == "UIDFIELD"
        && (g as String) == "GIDFIELD"
        && (sh as String) == "SHELLFIELD"
    _ => false
  }
}

test fn a_missing_account_is_absent_and_not_a_refusal() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(exit_code: 2, success: false, stdout: ""),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw------- 1 x y 96 Aug 10 19:51 /p"),
  ) {
    ManagedAccountAbsent { detail: _ } => true
    _ => false
  }
}

// PARTIAL IS HONEST. The account exists and was read; only the key file could not be stat'd, so the
// arm carries what was measured and names what was not, rather than discarding the account fields or
// filling the key fields with a default.
test fn an_unreadable_key_file_keeps_the_account_fields_it_did_measure() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(exit_code: 0, success: true, stdout: fixture_passwd_row),
    key_probe: account_probe(exit_code: 1, success: false, stdout: ""),
  ) {
    ManagedAccountKeyFileUnread { login: l, uid: _, gid: _, shell: sh, cause: _ } =>
      (l as String) == "gunbc-automation" && (sh as String) == "/bin/bash"
    _ => false
  }
}

test fn a_leg_that_never_ran_is_a_refusal_and_not_an_absent_account() -> Bool {
  match spark_serving_account_observation_from_probes(passwd_probe: none, key_probe: none) {
    ManagedAccountProbeRefused { cause: _ } => true
    _ => false
  }
}

// TOTALITY on a malformed row: a truncated passwd record must not crash the observation, because a
// probe that returns garbage is an observation too. Short fields read empty rather than throwing.
// THIS TEST USED TO ASSERT THE DEFECT. Its earlier form matched a truncated row into
// ManagedAccountObserved and checked that uid and shell came back as the EMPTY STRING out of
// NonEmptyStr fields -- so a test written to prove the decoder was robust was in fact the thing
// pinning a laundered carrier in place, and it is what let the defect reach review. Review 54471
// caught it. The test now asserts the distinction the decoder is supposed to make.
test fn a_truncated_passwd_row_is_refused_not_observed() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(exit_code: 0, success: true, stdout: "onlylogin"),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw------- 1 x y 96 Aug 10 19:51 /p"),
  ) {
    ManagedAccountRowMalformed { detail: d } => string_contains(s: d as String, pattern: "onlylogin")
    _ => false
  }
}

// THE DISCRIMINATING HALF. A truncated row must NOT be distinguishable-in-principle-only: the pair
// below differ by exactly one thing -- whether the passwd row has its seven fields -- and they must
// land in different variants. Asserting only the malformed case would pass on a decoder that
// refused everything.
test fn a_well_formed_passwd_row_still_observes() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(
      exit_code: 0, success: true,
      stdout: "gunbc-automation:x:1001:1001::/home/gunbc-automation:/bin/bash",
    ),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw------- 1 x y 96 Aug 10 19:51 /p"),
  ) {
    ManagedAccountObserved { login: l, uid: u, gid: g, shell: sh, authorized_keys_mode: m, authorized_keys_owner: o } =>
      (l as String) == "gunbc-automation" && (u as String) == "1001"
        && (g as String) == "1001" && (sh as String) == "/bin/bash"
        && (m as String) == "-rw-------" && (o as String) == "x"
    _ => false
  }
}

// AN EMPTY COLUMN IS AS UNUSABLE AS A MISSING ONE, and this is the test that says so. The row below
// has all seven fields; the shell is simply blank. It must refuse, or the empty string reaches a
// NonEmptyStr again by a different route than the one just closed.
test fn an_empty_passwd_column_is_refused_like_a_missing_one() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(
      exit_code: 0, success: true,
      stdout: "gunbc-automation:x:1001:1001::/home/gunbc-automation:",
    ),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw------- 1 x y 96 Aug 10 19:51 /p"),
  ) {
    ManagedAccountRowMalformed { detail: d } => string_contains(s: d as String, pattern: "gunbc-automation")
    _ => false
  }
}

// UNDECODABLE `ls -ld` OUTPUT IS A KEY FILE WE COULD NOT READ, not a malformed account. The passwd
// facts survive; only the mode and owner are missing. This asserts the decoder routes it to the arm
// whose remedy actually matches.
test fn undecodable_key_file_output_keeps_the_account_and_reports_unread() -> Bool {
  match spark_serving_account_observation_from_probes(
    passwd_probe: account_probe(
      exit_code: 0, success: true,
      stdout: "gunbc-automation:x:1001:1001::/home/gunbc-automation:/bin/bash",
    ),
    key_probe: account_probe(exit_code: 0, success: true, stdout: "-rw-------"),
  ) {
    ManagedAccountKeyFileUnread { login: l, uid: u, gid: _, shell: _, cause: c } =>
      (l as String) == "gunbc-automation" && (u as String) == "1001"
        && string_contains(s: c as String, pattern: "does not decode")
    _ => false
  }
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// CURRENT-BOOT DURABILITY STANDING
// ═══════════════════════════════════════════════════════════════════════════════════════

// THIS FIXTURE CARRIED THE EXACT MISMATCH THE MINT NOW FORBIDS: a readback saying SparkServingUnitAbsent
// -- which derives SparkServingAbsent -- stapled to a hand-written SparkServingObservationRefused. The
// two disagreed about what had been seen, and nothing noticed, because the observation was a free
// parameter. Its readback is now SparkServingUnitInactive, which DERIVES the refused arm the fixture
// meant, and the boot provenance these tests actually read is unaffected.
fn ho_with_provenance(p: SparkServingBootProvenance) -> SparkServingHostObservation {
  ho_from(readback: SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitInactive,
    runtime_version: SparkServingReadbackAbsent,
    runtime_materialization_identity: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: p,
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  })
}

data fixture_started_at_boot: SparkServingBootProvenance = UnitStartedByManagerAtBoot {
  active_enter_monotonic: microsecond(count: 10),
  uptime: microsecond(count: 84716000000),
}
data fixture_started_after_boot: SparkServingBootProvenance = UnitStartedAfterBoot {
  active_enter_monotonic: microsecond(count: 10670729),
  uptime: microsecond(count: 84716000000),
}

test fn every_host_up_with_its_boot_exhibits_fleet_wide() -> Bool {
  match spark_serving_current_boot_durability_standing(
    report: SparkServingObservationsProduced {
      first: ho_with_provenance(p: fixture_started_at_boot),
      more: [ho_with_provenance(p: fixture_started_at_boot)],
    },
  ) {
    CurrentBootDurabilityExhibitedFleetWide { observed_hosts: n } => n == 2
    _ => false
  }
}

// THE DISCRIMINATING RED. One host of two differs, and only in its boot provenance -- every
// other field on both fixtures is identical. A standing that reported the fleet by its FIRST
// host, or by any host, would pass the all-exhibiting test above and fail here. This is the
// shape the real fleet is in today: 19:19 measured both hosts started-after-boot.
test fn one_host_not_up_with_its_boot_drops_the_fleet_standing() -> Bool {
  match spark_serving_current_boot_durability_standing(
    report: SparkServingObservationsProduced {
      first: ho_with_provenance(p: fixture_started_at_boot),
      more: [ho_with_provenance(p: fixture_started_after_boot)],
    },
  ) {
    CurrentBootDurabilityNotExhibited { exhibiting: e, observed_hosts: n } => e == 1 && n == 2
    _ => false
  }
}

// NOBODY LOOKED IS NOT THE SAME AS LOOKED AND FOUND NOTHING. A refused report must not arrive
// as "not exhibited, 0 of 0" -- that reads as a measured negative and is the empty-observation
// narrow this standing is built to refuse.
test fn a_refused_report_is_unobserved_not_a_measured_negative() -> Bool {
  match spark_serving_current_boot_durability_standing(
    report: SparkServingObservationReportRefused { refusal: SparkServingObservationPrerequisiteRefused { cause: "transport refused every leg" as NonEmptyStr } },
  ) {
    CurrentBootDurabilityUnobserved { cause: c } => string_contains(s: c as String, pattern: "transport refused")
    _ => false
  }
}

// THE WIRE MUST NOT SAY FAILED. A reader who turns this line into "durability failed on srv6"
// asserts more than the measurement supports, and that mis-reading is the reason the standing
// exists at all.
test fn the_not_exhibited_wire_denies_being_a_failure() -> Bool {
  let line = spark_serving_current_boot_durability_line(
    standing: CurrentBootDurabilityNotExhibited { exhibiting: 1, observed_hosts: 2 },
  )
  string_contains(s: line, pattern: "not-exhibited-this-boot")
    && string_contains(s: line, pattern: "does not establish")
    && string_contains(s: line, pattern: "NOT a finding that durability failed")
}

// THE UNOBSERVED WIRE MUST NAME ITSELF A COVERAGE GAP, for the same reason in the other
// direction: an unobserved fleet reported as a fleet property would be a fabricated verdict.
test fn the_unobserved_wire_names_a_coverage_gap() -> Bool {
  let line = spark_serving_current_boot_durability_line(
    standing: CurrentBootDurabilityUnobserved { cause: "nothing ran" as NonEmptyStr },
  )
  string_contains(s: line, pattern: "unobserved")
    && string_contains(s: line, pattern: "coverage gap")
}

// The property the mint buys, asserted rather than assumed: whatever host the readback names is the
// host the derived observation names. Before #9754's review this was true of the production path by
// coincidence and false of the type; it is now the only state that has a constructor.
test fn the_minted_observation_cannot_disagree_with_its_readback_about_the_host() -> Bool {
  let o = ho_from(readback: readback_inactive_at(host: "srv6"))
  match o.observation {
    SparkServingObserved { host: h, loaded_release: _ } => h == o.readback.host
    SparkServingAbsent { host: h } => h == o.readback.host
    SparkServingObservationRefused { host: h, cause: _ } => h == o.readback.host
  }
}

test fn the_coverage_join_reads_the_host_the_observation_also_reports() -> Bool {
  let o = ho_from(readback: readback_absent_at(host: "srv6"))
  match o.observation {
    SparkServingObserved { host: h, loaded_release: _ } => h == "srv6"
    SparkServingAbsent { host: h } => h == "srv6"
    SparkServingObservationRefused { host: h, cause: _ } => h == "srv6"
  }
}
