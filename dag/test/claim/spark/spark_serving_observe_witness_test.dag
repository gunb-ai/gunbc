// The report carries readback + observation together; these fixtures only vary the observation, so
// the readback is a fixed bare one and the wrapping stays out of every assertion below.
// THE FIXTURE NOW MINTS THROUGH THE CONSTRUCTOR, and that changed what it can express.
//
// It used to take an arbitrary observation and staple it to a fixed readback -- which is exactly the
// disagreeing state review of #9754 found: the observation's host was free to differ from
// readback.host. It cannot be supplied independently any more, so the fixture takes the READBACK and
// lets the observation be derived. Tests that want a particular observation arm now select it by
// choosing a readback that derives to it, which is the same thing the production path does.
// HOST-PARAMETERISED READBACKS. With SparkServingHostObservation minted through its constructor, a
// test selects an observation arm by choosing a readback that DERIVES to it -- the same move the
// production path makes -- rather than by stapling an arm onto an unrelated readback.
fn readback_absent_at(host: HostIdentity) -> SparkServingReadback {
  SparkServingReadback {
    host: host,
    unit_outcome: SparkServingUnitAbsent,
    runtime_version: SparkServingReadbackAbsent,
    runtime_materialization_identity: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }
}

// Derives SparkServingObservationRefused: the unit is present but inactive.
fn readback_inactive_at(host: HostIdentity) -> SparkServingReadback {
  SparkServingReadback {
    host: host,
    unit_outcome: SparkServingUnitInactive,
    runtime_version: SparkServingReadbackAbsent,
    runtime_materialization_identity: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }
}

// Derives SparkServingObserved.
fn readback_active_complete_at(host: HostIdentity) -> SparkServingReadback {
  SparkServingReadback {
    host: host,
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: witness_required_release_asset_digest_hex),
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_satisfied_wire),
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }
}

// These fixtures vary the REPORTING facts, so the member projection stays fixed and empty -- the
// honest value, since no probe ran. Listing a member with a placeholder digest would fabricate a
// state, and absence from the observed list is exactly what makes membership_reconcile plan an
// addition.
//
// Neither the projection's host nor its provenance is stateable here. The mint derives the
// projection from readback.host and always builds the hermetic arm, so a fixture cannot claim this
// observation measured anything -- which is the property the acquired arm's receipt depends on.
fn ho_from(readback: SparkServingReadback) -> SparkServingHostObservation {
  hermetic_host_observation(
    readback: readback,
    account: ManagedAccountProbeRefused { cause: "fixture: no account probe was run" },
    runtime: RuntimeMaterializationAbsent,
    store: ModelStoreAbsent,
    observed_unit: SparkServingObservedUnit {
      state: UserUnitStateUnobserved,
      enablement: UserUnitManagerUnobserved,
      activity: UnitActivityUnobserved,
    },
    linger: LingerUnobservedState,
  )
}

