test fn absent_readback_derives_absent_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_absent()) {
    SparkServingAbsent { host: h } => h == "srv5"
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingObservationRefused { host: _, cause: _ } => false
  }
}

// RED CONTROL: an unreachable host or any probe leg that did not run must refuse observation, never
// license SparkServingAbsent (empty-observation narrow).

test fn unreachable_readback_does_not_derive_absent_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_unreachable()) {
    SparkServingObservationRefused { host: h, cause: _ } => h == "srv5"
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}

test fn load_state_not_found_probe_derives_unit_absent() -> Bool {
  match spark_serving_unit_outcome_from_probe_results(
    load_state: Present {
      value: SshSessionExecResult {
        exit_code: 0,
        success: true,
        stdout: "not-found",
        stderr: "",
      },
    },
    is_active: Present {
      value: SshSessionExecResult {
        exit_code: 3,
        success: false,
        stdout: "inactive",
        stderr: "",
      },
    },
  ) {
    SparkServingUnitAbsent => true
    SparkServingUnitActive => false
    SparkServingUnitInactive => false
    SparkServingUnitObservationRefused { cause: _ } => false
  }
}

test fn load_state_probe_leg_absent_refuses_unit_outcome() -> Bool {
  match spark_serving_unit_outcome_from_probe_results(
    load_state: none,
    is_active: none,
  ) {
    SparkServingUnitObservationRefused { cause: c } =>
      string_contains(s: c as String, pattern: "LoadState probe leg did not run")
    SparkServingUnitAbsent => false
    SparkServingUnitActive => false
    SparkServingUnitInactive => false
  }
}

// POSITIVE CONTROL: a real ollama /api/version payload must parse to the reported version string,
// never the desired pin.

test fn version_json_positive_parses_reported_version() -> Bool {
  match spark_serving_parse_version_json(stdout: witness_version_json_positive) {
    SparkServingReadbackPresent { value: v } => v == witness_pinned_runtime_version_wire
    SparkServingReadbackAbsent => false
    SparkServingReadbackRefused { cause: _ } => false
  }
}

test fn runtime_receipt_json_positive_parses_asset_digest() -> Bool {
  match spark_serving_parse_runtime_receipt_json(stdout: witness_runtime_receipt_json_positive) {
    SparkServingReadbackPresent { value: hex } =>
      hex == witness_required_release_asset_digest_hex
    SparkServingReadbackAbsent => false
    SparkServingReadbackRefused { cause: _ } => false
  }
}

test fn runtime_receipt_probe_success_populates_digest_field() -> Bool {
  match spark_serving_runtime_receipt_field_from_probe(
    probe: Present {
      value: SshSessionExecResult {
        exit_code: 0,
        success: true,
        stdout: witness_runtime_receipt_json_positive,
        stderr: "",
      },
    },
  ) {
    SparkServingReadbackPresent { value: hex } =>
      hex == witness_required_release_asset_digest_hex
    SparkServingReadbackAbsent => false
    SparkServingReadbackRefused { cause: _ } => false
  }
}

// THE TWO RECEIPTS ARE TWO SUBJECTS ON TWO MACHINES, and this pair of claims is what keeps them
// from being confused again. The archive-admission receipt below records which release archive THE
// EXECUTOR admitted; the materialization receipt records which closure was published to THE TARGET.
// The read-only observation asks the second question, and for a while it asked it by cat-ing the
// first receipt's path over SSH on a host where nothing writes it -- measured on srv6 as
// `state=refused cause=... ollama-runtime-receipt.json: No such file or directory` while the
// converge path called the same host converged.
test fn the_materialization_receipt_probe_reads_the_runtime_root_not_the_executor_receipt() -> Bool {
  let words = spark_serving_runtime_materialization_receipt_probe_argv()
  words.length() == 2
    && words.first() == "cat"
    && !string_contains(s: words.skip(n: 1).first(), pattern: "ollama-runtime-receipt.json")
    && string_contains(s: words.skip(n: 1).first(), pattern: "/runtimes/")
}

// A materialization receipt that exists but is EMPTY names no closure, so it refuses rather than
// presenting an empty identity that every comparison would then treat as a real one.
test fn an_empty_materialization_receipt_refuses_rather_than_presenting_nothing() -> Bool {
  match spark_serving_materialization_receipt_field_from_probe(
    probe: Present {
      value: SshSessionExecResult { exit_code: 0, success: true, stdout: "  \n", stderr: "" },
    },
  ) {
    SparkServingReadbackRefused { cause: c } => string_contains(s: c as String, pattern: "empty")
    SparkServingReadbackPresent { value: _ } => false
    SparkServingReadbackAbsent => false
  }
}

// The positive control, so the refusal above is not this reader refusing everything: bare digest
// content is taken as the identity, trimmed, with no JSON structure invented around it.
test fn a_materialization_receipt_presents_its_bare_digest() -> Bool {
  match spark_serving_materialization_receipt_field_from_probe(
    probe: Present {
      value: SshSessionExecResult { exit_code: 0, success: true, stdout: "abc123\n", stderr: "" },
    },
  ) {
    SparkServingReadbackPresent { value: v } => v == "abc123"
    SparkServingReadbackRefused { cause: _ } => false
    SparkServingReadbackAbsent => false
  }
}

test fn runtime_receipt_probe_words_target_executor_receipt_path() -> Bool {
  let words = spark_serving_runtime_receipt_probe_words()
  words.length() == 2
    && words.first() == "cat"
    && string_contains(
      s: words.skip(n: 1).first(),
      pattern: "/home/gunbc-automation/.local/share/gunbc/spark-serving/ollama-runtime-receipt.json",
    )
}

// RED CONTROL: malformed /api/version output must refuse rather than return any version.

test fn malformed_version_json_refuses_parse() -> Bool {
  match spark_serving_parse_version_json(stdout: "{\"version\":") {
    SparkServingReadbackRefused { cause: _ } => true
    SparkServingReadbackPresent { value: _ } => false
    SparkServingReadbackAbsent => false
  }
}

// RED CONTROL: a different reported runtime version must not converge to the pinned release
// identity.

test fn different_runtime_version_refuses_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: SparkServingReadback {
    host: "srv6",
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: "0.11.0-rc1" },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: witness_required_release_asset_digest_hex),
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_satisfied_wire),
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn different_runtime_version_refuses_observation() -> Bool {
  match derive_spark_serving_observation(readback: SparkServingReadback {
    host: "srv6",
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: "10.11.0" },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: witness_required_release_asset_digest_hex),
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_satisfied_wire),
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    SparkServingObservationRefused { host: _, cause: _ } => true
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

test fn tags_json_positive_parses_model_digest() -> Bool {
  let parsed = spark_serving_parse_tags_json(stdout: witness_tags_json_positive)
  match parsed.model_name {
    SparkServingReadbackPresent { value: name } =>
      match parsed.model_tag {
        SparkServingReadbackPresent { value: tag } =>
          match parsed.model_manifest_digest {
            SparkServingReadbackPresent { value: digest } =>
              name == "gpt-oss" && tag == "120b" && digest == witness_model_digest
            SparkServingReadbackAbsent => false
            SparkServingReadbackRefused { cause: _ } => false
          }
        SparkServingReadbackAbsent => false
        SparkServingReadbackRefused { cause: _ } => false
      }
    SparkServingReadbackAbsent => false
    SparkServingReadbackRefused { cause: _ } => false
  }
}

test fn active_incomplete_readback_refuses_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_active_incomplete()) {
    SparkServingObservationRefused { host: h, cause: c } =>
      h == "srv5"
        && (
          string_contains(s: c as String, pattern: "fingerprint")
            || string_contains(s: c as String, pattern: "runtime_materialization_identity")
            || string_contains(s: c as String, pattern: "install receipt")
        )
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}

test fn missing_runtime_receipt_probe_refuses_active_observation() -> Bool {
  match derive_spark_serving_observation(readback: SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: SparkServingReadbackRefused {
      cause: "runtime install receipt probe failed exit=1 stderr=No such file" as NonEmptyStr,
    },
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_satisfied_wire),
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    SparkServingObservationRefused { host: _, cause: c } =>
      string_contains(s: c as String, pattern: "install receipt")
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

