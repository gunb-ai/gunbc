}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data subject_host: HostIdentity = "srv5" as HostIdentity

fn ok(out: String) -> SparkServingProbeOutcome {
  SparkServingProbeExecuted {
    result: SshSessionExecResult { exit_code: 0, success: true, stdout: out, stderr: "" },
  }
}

// THE ONE ADMITTED FIXTURE ROUTE INTO EACH SEALED MINT.
//
// Both mints are sealed with admit_callers to the real producer plus exactly one function here. That
// is what makes the annotations beside them true rather than aspirational: the previous version of
// this file imported the factories directly and built whatever it liked, which is precisely how the
// review established that the "only acquisition can mint this" claim was false. Every fixture below
// goes through these two, so the seal is exercised by the witness rather than bypassed by it.
fn hermetic_capture_fixture(
  request: SparkServingProbeRequest,
  outcome: SparkServingProbeOutcome,
) -> SparkServingProbeLegCapture {
  spark_serving_probe_leg_capture_of(request: request, outcome: outcome)
}

fn hermetic_transaction_fixture(
  captures: List<SparkServingProbeLegCapture>,
) -> SparkServingTransactionAdmission {
  spark_serving_observation_transaction_of(
    host: subject_host,
    attempt: "witness-attempt" as NonEmptyStr,
    locus: "witness-locus" as NonEmptyStr,
    captures: captures,
  )
}

fn capture(request: SparkServingProbeRequest, out: String) -> SparkServingProbeLegCapture {
  hermetic_capture_fixture(request: request, outcome: ok(out: out))
}

// THE COMPLETE POPULATION, BECAUSE A TRANSACTION MISSING ONE OF THEM IS NOT A TRANSACTION.
//
// Coverage is checked at identity grain against the required roster rather than by counting, so
// this fixture enumerates the requests rather than asserting a number: a count would go green for
// any twenty-three captures, including twenty-three copies of the wrong one.
fn every_request() -> List<SparkServingProbeRequest> {
  [
    LoadStateRequest, IsActiveRequest, VersionRequest, TagsRequest, NvidiaDriverRequest,
    RuntimeReceiptRequest, ActiveEnterRequest, DefaultTargetEnterRequest, UptimeRequest,
    GrantsRequest, PasswdRequest, AuthorizedKeysRequest, LingerRequest,
    ModelManifestRequest, ModelBlobsListingRequest, ModelManifestDigestRequest,
    ModelBlobDigestsRequest { digests: ["deadbeef" as NonEmptyStr] },
    UserUnitReadRequest, UserUnitIsEnabledRequest,
    RuntimeRootRequest, RuntimeExecutableRequest, RuntimeExecutableBitRequest,
    RuntimeRootListingRequest,
  ]
}

fn complete_captures() -> List<SparkServingProbeLegCapture> {
  map(every_request(), r => capture(request: r, out: "fixture"))
}

fn admission(captures: List<SparkServingProbeLegCapture>) -> SparkServingTransactionAdmission {
  hermetic_transaction_fixture(captures: captures)
}

fn txn_of(captures: List<SparkServingProbeLegCapture>) -> SparkServingObservationTransaction? {
  match admission(captures: captures) {
    SparkServingTransactionAdmitted { txn: t } => Present { value: t }
    SparkServingTransactionRefused { cause: _ } => none
  }
}

// THE LEG IS PROJECTED FROM THE REQUEST, SO A MISLABELLED CAPTURE IS NOT WRITABLE.
//
// The previous version of this witness was itself the counterexample the review found: its capture
// helper supplied ["systemctl","is-active"] as the argv for every leg it named, including
// ProbeLoadState, and the transaction admitted that as a well-formed capture. There is no argv
// parameter now and no leg parameter either -- one request goes in, and both the label and the
// command are read off it -- so the mislabelling this claim used to demonstrate has no expression.
test fn the_leg_is_projected_from_the_request_not_supplied_beside_it() -> Bool {
  spark_serving_probe_leg_key(leg: spark_serving_probe_request_leg(request: IsActiveRequest))
    == ("is_active" as NonEmptyStr)
    && spark_serving_probe_leg_key(leg: spark_serving_capture_leg(c: capture(request: LoadStateRequest, out: "loaded")))
      == ("load_state" as NonEmptyStr)
}

test fn a_captured_leg_is_readable_from_a_complete_transaction() -> Bool {
  match txn_of(captures: complete_captures()) {
    Absent => false
    Present { value: t } =>
      match spark_serving_transaction_result(txn: t, leg: ProbeIsActive) {
        Absent => false
        Present { value: r } => r.stdout == "fixture"
      }
  }
}

// A MISSING CAPTURE REFUSES, AND THE EMPTY TRANSACTION IS THE STRONGEST CASE OF IT.
//
// The first admission checked duplicates only, so an EMPTY transaction was admitted and this
// witness used it as a positive fixture -- coverage enforced in one direction while the invariant
// claimed both. Every downstream reader would have read Absent for every fact and honestly reported
// unobserved, so the host would have looked measured-and-empty rather than never-acquired.
test fn an_empty_transaction_cannot_be_admitted() -> Bool {
  match admission(captures: []) {
    SparkServingTransactionRefused { cause: _ } => true
    SparkServingTransactionAdmitted { txn: _ } => false
  }
}

test fn dropping_one_required_capture_refuses_and_names_it() -> Bool {
  let without_linger = filter(
    complete_captures(),
    c => !(spark_serving_probe_leg_key(leg: spark_serving_capture_leg(c: c)) == ("linger" as NonEmptyStr)),
  )
  match admission(captures: without_linger) {
    SparkServingTransactionAdmitted { txn: _ } => false
    SparkServingTransactionRefused { cause: why } =>
      string_contains(s: why as String, pattern: "linger")
        && length(without_linger) == (length(complete_captures()) - 1)
  }
}

// The positive control for both directions: the complete roster admits, so the refusals above
// discriminate on coverage rather than rejecting everything.
test fn the_complete_roster_admits() -> Bool {
  match admission(captures: complete_captures()) {
    SparkServingTransactionAdmitted { txn: t } =>
      length(spark_serving_transaction_missing_legs(txn: t)) == 0
        && length(spark_serving_transaction_duplicated_legs(txn: t)) == 0
        && length(spark_serving_required_probe_legs()) == length(t.captures)
    SparkServingTransactionRefused { cause: _ } => false
  }
}

// THE DUPLICATE READ IS REFUSED, NOT TIE-BROKEN.
//
// is_active was genuinely executed twice per host before the carrier -- once for the readback and
// again inside the user-unit observer -- so this is the regression control for that class, at the
// grain where it is detectable rather than at the call sites where it was invisible.
test fn a_leg_captured_twice_refuses_the_transaction() -> Bool {
  match admission(captures: concat(complete_captures(), [capture(request: IsActiveRequest, out: "again")])) {
    SparkServingTransactionRefused { cause: _ } => true
    SparkServingTransactionAdmitted { txn: _ } => false
  }
}

// A TRANSPORT REFUSAL IS NOT A REMOTE EXIT 127.
//
// The first cut manufactured an exec result with exit_code 127 when the transport refused, so "we
// never reached the host" and "the host ran it and it exited 127" were one value. A reader asking
// what happened got a number the far side never produced. The refusal arms read as no result at
// all, which is what every unobserved arm downstream is built to receive.
test fn a_transport_refusal_is_not_a_remote_exit_code() -> Bool {
  let refused = hermetic_capture_fixture(
    request: IsActiveRequest,
    outcome: SparkServingProbeTransportRefused { cause: "no route" as NonEmptyStr },
  )
  let exited_127 = hermetic_capture_fixture(
    request: IsActiveRequest,
    outcome: SparkServingProbeExecuted {
      result: SshSessionExecResult { exit_code: 127, success: false, stdout: "", stderr: "no such" },
    },
  )
  match txn_of(captures: swap_is_active(with: refused)) {
    Absent => false
    Present { value: t_refused } =>
      match txn_of(captures: swap_is_active(with: exited_127)) {
        Absent => false
        Present { value: t_127 } =>
          match spark_serving_transaction_result(txn: t_refused, leg: ProbeIsActive) {
            Present { value: _ } => false
            Absent =>
              match spark_serving_transaction_result(txn: t_127, leg: ProbeIsActive) {
                Absent => false
                Present { value: r } => r.exit_code == 127
              }
          }
      }
  }
}

fn swap_is_active(with: SparkServingProbeLegCapture) -> List<SparkServingProbeLegCapture> {
  concat(
    filter(
      complete_captures(),
      c => !(spark_serving_probe_leg_key(leg: spark_serving_capture_leg(c: c)) == ("is_active" as NonEmptyStr)),
    ),
    [with],
  )
}

// A prerequisite refusal is its own arm: the blob-digest leg with no digests to verify never ran,
// and it is not the same fact as a digest command that ran and failed.
test fn a_prerequisite_refusal_reads_as_no_result() -> Bool {
  let blocked = hermetic_capture_fixture(
    request: ModelBlobDigestsRequest { digests: [] },
    outcome: SparkServingProbePrerequisiteRefused { cause: "manifest named none" as NonEmptyStr },
  )
  let rest = filter(
    complete_captures(),
    c => !(spark_serving_probe_leg_key(leg: spark_serving_capture_leg(c: c))
      == ("model_blob_digests" as NonEmptyStr)),
  )
  match txn_of(captures: concat(rest, [blocked])) {
    Absent => false
    Present { value: t } =>
      match spark_serving_transaction_result(txn: t, leg: ProbeModelBlobDigests) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

// The transaction names its host, attempt and locus, so a value derived from it can state which
// credential path produced it and which instant it belongs to.
test fn the_transaction_names_its_host_attempt_and_locus() -> Bool {
  match txn_of(captures: complete_captures()) {
    Absent => false
    Present { value: t } =>
      t.host == subject_host
        && t.attempt == ("witness-attempt" as NonEmptyStr)
        && t.locus == ("witness-locus" as NonEmptyStr)
  }
}

// PRE-PLAN AND POST-APPLY ARE DIFFERENT OBSERVATIONS OF ONE HOST INSIDE ONE SSH ATTEMPT.
//
// A fleet attempt identifies an invocation, not an observation. The converge slice observes to plan,
// actuates, and observes again to verify -- all under one attempt -- so an identity derived from the
// attempt alone makes the before and after readings indistinguishable, which is precisely the join
// the carrier exists to prevent. The first cut was worse still: every acquisition passed the same
// constant, so no two observations anywhere differed.
test fn observations_of_one_host_in_one_attempt_differ_by_phase() -> Bool {
  let a = spark_serving_observation_attempt_of(
    fleet_attempt: "run-7" as NonEmptyStr, host: subject_host, phase: SparkServingPlanObservation,
  )
  let b = spark_serving_observation_attempt_of(
    fleet_attempt: "run-7" as NonEmptyStr, host: subject_host, phase: SparkServingPostApplyObservation,
  )
  let c = spark_serving_observation_attempt_of(
    fleet_attempt: "run-7" as NonEmptyStr, host: subject_host, phase: SparkServingReportObservation,
  )
  !(a == b) && !(b == c) && !(a == c)
}

// And the same phase on two hosts, or two attempts, is likewise distinct -- so the identity is a
// join of all three facts rather than a phase label that happens to differ.
test fn the_observation_attempt_is_a_join_of_fleet_attempt_host_and_phase() -> Bool {
  let here = spark_serving_observation_attempt_of(
    fleet_attempt: "run-7" as NonEmptyStr, host: subject_host, phase: SparkServingPlanObservation,
  )
  let other_host = spark_serving_observation_attempt_of(
    fleet_attempt: "run-7" as NonEmptyStr,
    host: "srv6" as HostIdentity,
    phase: SparkServingPlanObservation,
  )
  let other_run = spark_serving_observation_attempt_of(
    fleet_attempt: "run-8" as NonEmptyStr, host: subject_host, phase: SparkServingPlanObservation,
  )
  !(here == other_host) && !(here == other_run)
}

// THE POST-APPLY READING IS A DIFFERENT OBSERVATION, NOT A SECOND LOOK AT THE SAME ONE.
//
// spark_serving_replan_rows used to take linger_enabled: Bool, acquire a transaction, and then
// ignore that transaction's linger capture in favour of the Bool -- so a post-apply verdict planned
// against a loginctl reading taken BEFORE the transaction, spliced into facts taken during it. The
// parameter is deleted, so there is nowhere left to put an independently observed value, and the
// phase now travels instead. This claim pins the two phases apart at the identity grain the receipt
// will record.
test fn the_post_apply_reading_carries_its_own_phase_identity() -> Bool {
  let plan = spark_serving_observation_attempt_of(
    fleet_attempt: "run-9" as NonEmptyStr, host: subject_host, phase: SparkServingPlanObservation,
  )
  let post = spark_serving_observation_attempt_of(
    fleet_attempt: "run-9" as NonEmptyStr,
    host: subject_host,
    phase: SparkServingPostApplyObservation,
  )
  !(plan == post)
}

// LINGER APPEARS ONCE PER PHASE, WHICH IS WHAT MAKES "READ IT TWICE" A COVERAGE ERROR RATHER THAN A
// STYLE ONE. A second linger capture in one transaction is a duplicate and refuses; none at all is
// missing and refuses. So each phase has exactly one, by construction rather than by discipline.
test fn exactly_one_linger_capture_belongs_to_a_phase() -> Bool {
  let doubled = concat(complete_captures(), [capture(request: LingerRequest, out: "again")])
  let dropped = filter(
    complete_captures(),
    c => !(spark_serving_probe_leg_key(leg: spark_serving_capture_leg(c: c)) == ("linger" as NonEmptyStr)),
  )
  match admission(captures: doubled) {
    SparkServingTransactionAdmitted { txn: _ } => false
    SparkServingTransactionRefused { cause: _ } =>
      match admission(captures: dropped) {
        SparkServingTransactionAdmitted { txn: _ } => false
        SparkServingTransactionRefused { cause: _ } =>
          match admission(captures: complete_captures()) {
            SparkServingTransactionAdmitted { txn: _ } => true
            SparkServingTransactionRefused { cause: _ } => false
          }
      }
  }
}

// A REFUSED OR HERMETIC PROVENANCE IS NOT SOMETHING TO PLAN FROM.
//
// The post-apply verdict, the plan-time axis and the report all require an ACQUIRED observation.
// This is the property that lets them: only the acquired arm answers with an observation attempt, so
// a consumer that needs one cannot be handed a refusal wearing plausible strings -- which is exactly
// what the old fabricated "unreached: ..." provenance was.
test fn only_an_acquired_provenance_answers_with_an_observation_attempt() -> Bool {
  let hermetic = spark_serving_hermetic_provenance_of(
    host: subject_host,
    fixture_identity: "witness" as NonEmptyStr,
  )
  match spark_serving_provenance_observation_attempt(p: hermetic) {
    Present { value: _ } => false
    Absent =>
      match spark_serving_provenance_credential(p: hermetic) {
        Present { value: _ } => false
        Absent => spark_serving_provenance_host(p: hermetic) == subject_host
      }
  }
}

// THE RECEIPT DISTINGUISHES THE THREE PROVENANCE ARMS, BECAUSE A RENDERER THAT FLATTENED THEM WOULD
// REINTRODUCE THE FABRICATION AT THE PRESENTATION LAYER.
//
// The deleted defect printed plausible attempt and locus strings for an observation that never
// happened. A receipt that rendered acquired, refused and hermetic in one shape would do the same
// thing one layer out: the canary reads these lines to establish that every fact in a report belongs
// to one acquisition, so the line has to be able to say when it does not.
test fn the_receipt_line_says_which_provenance_arm_it_is() -> Bool {
  let hermetic = spark_serving_provenance_receipt_line(
    p: spark_serving_hermetic_provenance_of(
      host: subject_host,
      fixture_identity: "witness" as NonEmptyStr,
    ),
  )
  string_contains(s: hermetic, pattern: "hermetic-fixture=")
    && !string_contains(s: hermetic, pattern: "acquired")
    && !string_contains(s: hermetic, pattern: "observation-attempt=")
}

// The transaction receipt reports coverage and the per-outcome shape, not a single total: 23
// captures is equally true of a transaction whose every leg the transport refused.
test fn the_transaction_receipt_reports_coverage_and_outcome_shape() -> Bool {
  match txn_of(captures: complete_captures()) {
    Absent => false
    Present { value: t } => {
      let line = spark_serving_transaction_receipt_line(txn: t)
      string_contains(s: line, pattern: "missing=0")
        && string_contains(s: line, pattern: "duplicated=0")
        && string_contains(s: line, pattern: "executed=23")
        && string_contains(s: line, pattern: "transport-refused=0")
        && string_contains(s: line, pattern: "prerequisite-refused=0")
        && string_contains(s: line, pattern: "credential-locus=witness-locus")
    }
  }
}

// And the outcome counts move with the outcomes, so the line is a reading rather than a constant.
test fn a_transport_refused_leg_moves_the_receipt_counts() -> Bool {
  let refused = hermetic_capture_fixture(
    request: IsActiveRequest,
    outcome: SparkServingProbeTransportRefused { cause: "no route" as NonEmptyStr },
  )
  match txn_of(captures: swap_is_active(with: refused)) {
    Absent => false
    Present { value: t } => {
      let line = spark_serving_transaction_receipt_line(txn: t)
      string_contains(s: line, pattern: "executed=22")
        && string_contains(s: line, pattern: "transport-refused=1")
        && string_contains(s: line, pattern: "missing=0")
    }
  }
}
