module test.claim.spark.spark_pair_head_unit_digest_witness

import std.types { Bool, NonEmptyStr, String, List }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.content_hash {
  ContentHash,
  compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable,
}
import gunbc.spark.fabric_switch_observed { FabricGroupA, FabricLaneObserved }
import gunbc.spark.pair_serving_desired {
  spark_pair_serving_unit_with, SeqCapacityMeasured, SparkPairServingUnitReady, SparkPairServingUnitRefused,
  spark_pair_serving_engine_args,
}
import gunbc.spark.pair_serving_realization {
  SparkPairUnitRender, SparkPairUnitRendered, SparkPairUnitSealed, SparkPairUnitRenderRefused,
  SparkPairRealization, SparkPairRealized, SparkPairRealizationRefused,
  DeclaredUnitDigestStanding, DeclaredUnitDigested, DeclaredUnitDigestUnavailable,
  SparkPairDeclaredHeadPublish, SparkPairDeclaredHeadPublished, SparkPairDeclaredHeadPublishRefused,
  spark_pair_rendered_unit_artifact, spark_pair_container_spec,
  spark_pair_container_env, spark_pair_head_unit_name, spark_pair_lookup_declared_head_digest,
  spark_pair_realizations, spark_pair_publish_declared_head_artifact,
  spark_pair_seal_unit_render,
  spark_pair_head_unit_unsigned,
}
import gunbc.spark.model_snapshot_acquisition {
  ModelSnapshotDesired, ModelSnapshotPinned, HubCachePlacement, spark_hub_cache_root,
}
import extdeps.huggingface.hub { HubRepoId, HubModelRepo }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data w_fixture_snapshot: ModelSnapshotDesired = ModelSnapshotPinned {
  identity: "fixture-model" as NonEmptyStr,
  repo: HubRepoId { kind: HubModelRepo, path: "deepseek-ai/DeepSeek-V4-Flash" as NonEmptyStr },
  revision: "fixture0000000000000000000000000000000000" as NonEmptyStr,
  revision_provenance: "controlled fixture: this witness hashes renderer bytes, never a resolved revision" as NonEmptyStr,
  placement: HubCachePlacement { cache_root: spark_hub_cache_root },
}

fn w_sealed_head(head: FabricLaneObserved) -> SparkPairUnitRender {
  spark_pair_seal_unit_render(
    render: spark_pair_head_unit_unsigned(
      args: spark_pair_serving_engine_args(tensor_parallel: 4, max_num_seqs: 32),
      snapshot: w_fixture_snapshot,
      head: head,
      spec: spark_pair_container_spec(env: spark_pair_container_env(lane: head)),
    ),
  )
}

fn w_head_render() -> DeclaredUnitDigestStanding {
  match spark_pair_serving_unit_with(group: FabricGroupA, capacity: SeqCapacityMeasured {
    max_num_seqs: 32,
    basis: "controlled fixture: this witness hashes renderer bytes, never a measured capacity" as NonEmptyStr,
  }) {
    SparkPairServingUnitRefused { group: _, cause: c } =>
      DeclaredUnitDigestUnavailable { obligation: c }
    SparkPairServingUnitReady { group: _, engine: _, head: h, workers: _ } =>
      match w_sealed_head(head: h.lane) {
        SparkPairUnitRenderRefused { unit_name: _, cause: c } =>
          DeclaredUnitDigestUnavailable { obligation: c }
        SparkPairUnitSealed { artifact: a } =>
          DeclaredUnitDigested { unit_name: a.unit_name, digest: a.digest }
        SparkPairUnitRendered { unit_name: _, text: _ } =>
          DeclaredUnitDigestUnavailable { obligation: "unsigned unit bytes are not a declared digest; seal at apply publish" as NonEmptyStr }
      }
  }
}

fn w_head_text() -> String? {
  match spark_pair_serving_unit_with(group: FabricGroupA, capacity: SeqCapacityMeasured {
    max_num_seqs: 32,
    basis: "controlled fixture: this witness hashes renderer bytes, never a measured capacity" as NonEmptyStr,
  }) {
    SparkPairServingUnitRefused { group: _, cause: _ } => none
    SparkPairServingUnitReady { group: _, engine: _, head: h, workers: _ } =>
      match w_sealed_head(head: h.lane) {
        SparkPairUnitRenderRefused { unit_name: _, cause: _ } => none
        SparkPairUnitSealed { artifact: a } => Present { value: a.text }
        SparkPairUnitRendered { unit_name: _, text: t } => Present { value: t }
      }
  }
}

// POSITIVE CONTROL: the same rendered bytes hash to the same SHA-256 twice.
test fn hashing_the_same_rendered_bytes_is_stable() -> Bool {
  match w_head_render() {
    DeclaredUnitDigestUnavailable { obligation: _ } => false
    DeclaredUnitDigested { unit_name: n1, digest: d1 } =>
      match w_head_render() {
        DeclaredUnitDigestUnavailable { obligation: _ } => false
        DeclaredUnitDigested { unit_name: n2, digest: d2 } =>
          (n1 as String) == (spark_pair_head_unit_name as String)
            && (n2 as String) == (spark_pair_head_unit_name as String)
            && match compare_content_hash(left: d1, right: d2) {
              ContentHashEqual => true
              ContentHashDifferent => false
              ContentHashCrossFamilyIncomparable => false
            }
      }
  }
}

// RED: one extra byte in the unit text is a different digest.
test fn unit_text_differing_by_one_byte_gives_a_different_digest() -> Bool {
  match w_head_text() {
    Absent => false
    Present { value: t } =>
      match spark_pair_rendered_unit_artifact(unit_name: spark_pair_head_unit_name, text: t) {
        SparkPairUnitRenderRefused { unit_name: _, cause: _ } => false
        SparkPairUnitRendered { unit_name: _, text: _ } => false
        SparkPairUnitSealed { artifact: a } =>
          match spark_pair_rendered_unit_artifact(unit_name: spark_pair_head_unit_name, text: join([t, " "], "")) {
            SparkPairUnitRenderRefused { unit_name: _, cause: _ } => false
            SparkPairUnitRendered { unit_name: _, text: _ } => false
            SparkPairUnitSealed { artifact: a2 } =>
              match compare_content_hash(left: a.digest, right: a2.digest) {
                ContentHashDifferent => true
                ContentHashEqual => false
                ContentHashCrossFamilyIncomparable => false
              }
          }
      }
  }
}

// PRODUCTION PUBLISH THEN LOOKUP: apply seals the unsigned realized head unit and writes text plus
// digest; lookup re-renders the unsigned unit and requires the stored text to match. Placement does
// not DigestStdin.
test fn spark_pair_head_unit_declared_digest_hashes_the_realized_head_unit() -> Bool {
  match first(spark_pair_realizations()) {
    Absent => false
    Present { value: r } =>
      match r {
        SparkPairRealizationRefused { group: g, cause: _ } =>
          match spark_pair_lookup_declared_head_digest(group: g) {
            DeclaredUnitDigestUnavailable { obligation: _ } => true
            DeclaredUnitDigested { unit_name: _, digest: _ } => false
          }
        SparkPairRealized { group: g, head: h, workers: _ } =>
          match spark_pair_publish_declared_head_artifact(realization: r) {
            SparkPairDeclaredHeadPublishRefused { cause: _ } => false
            SparkPairDeclaredHeadPublished { group: _, digest: _ } =>
              match spark_pair_seal_unit_render(render: h.unit) {
                SparkPairUnitRenderRefused { unit_name: _, cause: _ } => false
                SparkPairUnitRendered { unit_name: _, text: _ } => false
                SparkPairUnitSealed { artifact: a } =>
                  match spark_pair_lookup_declared_head_digest(group: g) {
                    DeclaredUnitDigestUnavailable { obligation: _ } => false
                    DeclaredUnitDigested { unit_name: n, digest: from_store } =>
                      (n as String) == (spark_pair_head_unit_name as String)
                        && match compare_content_hash(left: a.digest, right: from_store) {
                          ContentHashEqual => true
                          ContentHashDifferent => false
                          ContentHashCrossFamilyIncomparable => false
                        }
                  }
              }
          }
      }
  }
}
