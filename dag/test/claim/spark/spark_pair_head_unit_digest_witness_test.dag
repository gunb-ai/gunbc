module test.claim.spark.spark_pair_head_unit_digest_witness

import std.types { Bool, String }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.content_hash {
  compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable,
}
import gunbc.spark.fabric_switch_observed { FabricGroupA }
import gunbc.spark.pair_serving_realization {
  SparkPairUnitRender, SparkPairUnitRendered,
  DeclaredUnitDigestStanding, DeclaredUnitDigested, DeclaredUnitDigestUnavailable,
  spark_pair_declared_unit_digest, spark_pair_declared_head_digest,
  spark_pair_head_unit_render_for_group, spark_pair_head_unit_name,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE MINT IS EXECUTED FOR REAL HERE. spark_pair_declared_unit_digest calls
// extdeps.tools.sha256sum Sha256.DigestStdin, which has no mock_response, so every row in this file
// runs on the required floor's local-repo wet lane (v2.workflow.local_repo_wet_terminal
// local_repo_wet_schedule). The rows that do NOT need a digest -- render refusal, empty render --
// are hermetic and live in test.claim.spark.spark_pair_serving_realization_witness instead.
//
// THE INPUT IS A SUPPLIED RENDER, WHICH IS THE ONLY WAY A FIXTURE CAN OBTAIN A STANDING.
// DeclaredUnitDigestEvidence is a sole_constructor record, so no fixture can build one; supplying
// SparkPairUnitRendered (an ordinary variant) to the real mint is the sanctioned route, and it is
// what makes this file the inhabitance claim DESIGN section 3's pairing obligation requires for
// every witness that supplies a DeclaredUnitDigestStanding downstream.

data w_unit_text: String = "[Unit]\nDescription=gunbc spark pair head\n\n[Service]\nExecStart=/bin/true\n"

fn w_render(text: String) -> SparkPairUnitRender {
  SparkPairUnitRendered { unit_name: spark_pair_head_unit_name, text: text }
}

fn w_digest_of(text: String) -> DeclaredUnitDigestStanding {
  spark_pair_declared_unit_digest(render: w_render(text: text))
}

// POSITIVE CONTROL: the same rendered bytes hash to the same SHA-256 twice, and the evidence names
// the unit it was minted for.
test fn hashing_the_same_rendered_bytes_is_stable() -> Bool {
  match w_digest_of(text: w_unit_text) {
    DeclaredUnitDigestUnavailable { obligation: _ } => false
    DeclaredUnitDigested { evidence: e1 } =>
      match w_digest_of(text: w_unit_text) {
        DeclaredUnitDigestUnavailable { obligation: _ } => false
        DeclaredUnitDigested { evidence: e2 } =>
          (e1.unit_name as String) == (spark_pair_head_unit_name as String)
            && (e2.unit_name as String) == (spark_pair_head_unit_name as String)
            && match compare_content_hash(left: e1.digest, right: e2.digest) {
              ContentHashEqual => true
              ContentHashDifferent => false
              ContentHashCrossFamilyIncomparable => false
            }
      }
  }
}

// RED: one extra byte in the unit text is a different digest. Without this row a mint that returned
// a constant, or hashed the unit NAME rather than the bytes, would still pass the stability row.
test fn unit_text_differing_by_one_byte_gives_a_different_digest() -> Bool {
  match w_digest_of(text: w_unit_text) {
    DeclaredUnitDigestUnavailable { obligation: _ } => false
    DeclaredUnitDigested { evidence: e } =>
      match w_digest_of(text: join([w_unit_text, " "], "")) {
        DeclaredUnitDigestUnavailable { obligation: _ } => false
        DeclaredUnitDigested { evidence: e2 } =>
          match compare_content_hash(left: e.digest, right: e2.digest) {
            ContentHashDifferent => true
            ContentHashEqual => false
            ContentHashCrossFamilyIncomparable => false
          }
      }
  }
}

// THE PRODUCTION GROUP-A PRODUCER, EXECUTED. spark_pair_declared_head_digest renders the head unit
// from the CURRENT declarations and digests exactly those bytes -- no store, no receipt, no
// currency check. This is the function harness_bind_seat calls once per bind, so deleting the
// render-to-DigestStdin wire inside it turns this row red.
//
// AND IT IS THE SAME BYTES: re-digesting the group's render through the supplied-input mint above
// must agree with what the group-level producer returned. RED if the group producer ever digested
// something other than the unit text it renders.
test fn spark_pair_head_unit_declared_digest_hashes_the_realized_head_unit() -> Bool {
  match spark_pair_declared_head_digest(group: FabricGroupA) {
    DeclaredUnitDigestUnavailable { obligation: _ } => false
    DeclaredUnitDigested { evidence: e } =>
      match spark_pair_declared_unit_digest(render: spark_pair_head_unit_render_for_group(group: FabricGroupA)) {
        DeclaredUnitDigestUnavailable { obligation: _ } => false
        DeclaredUnitDigested { evidence: again } =>
          (e.unit_name as String) == (spark_pair_head_unit_name as String)
            && match compare_content_hash(left: e.digest, right: again.digest) {
              ContentHashEqual => true
              ContentHashDifferent => false
              ContentHashCrossFamilyIncomparable => false
            }
      }
  }
}
