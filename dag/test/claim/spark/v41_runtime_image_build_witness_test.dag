module test.claim.spark.v41_runtime_image_build_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.content_hash { serialize_content_hash }
import extdeps.exec.command { argv_words }
import extdeps.docker.cli { docker_build_spec_command }
import extdeps.vllm.source_build {
  vllm_07b75534_aarch64_release_recipe, vllm_07b75534_default_recipe,
  vllm_recipe_targeting, vllm_cuda_arch_supported,
}
import extdeps.vllm.deepseek_v4_1_sm12 {
  v41_fp4_weight_surface, v41_fp4_kv_cache_surface, v41_csa2_surface, v41_dspark_surface,
  v41_sm12_demand_symbols, v41_sm12_kv_cache_dtype_admitted,
  v41_fp4_sm120_block, v41_fp4_sm100_block,
}
import extdeps.vllm.deepseek_v4_1_flash_recipe {
  v41_flash_published_registry_entries, v41_flash_published_revision_public_standing,
  v41_flash_published_distribution, v41_flash_published_torch_cuda_arch_list,
  v41_flash_documented_tag_standing, v41_flash_hardware_verified,
}
import gunbc.spark.fabric_reach { ReachManagementLan, spark_reach_endpoint }
import gunbc.spark.v41_runtime_image_build {
  v41_build_host,
  v41_gb10_torch_cuda_arch_list, v41_build_max_jobs, v41_build_nvcc_threads,
  v41_gb10_recipe, v41_build_key, v41_image_tag, v41_build_spec, v41_recipe_arch_is_buildable,
}
