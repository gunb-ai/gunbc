  V41CapabilityPresent, V41CapabilityAbsent, V41CapabilityUnread,
  v41_capability_kv_layout, v41_capability_fp4_weight, v41_capability_architecture,
  v41_probe_script, v41_capability_reading, v41_probe_architecture_class,
  v41_capability_flashinfer_sm120,
  v41_image_unmet_capabilities, v41_reading_for,
}

// THE ONE FIELD THAT DIVERGES FROM UPSTREAM IS THE ONE THE LANE EXISTS FOR. Everything else in the
// fleet recipe is copied from upstream's own aarch64 release row, and this asserts the copy rather
// than trusting it: a future edit that quietly changed the CUDA version or the builder base would go
// red here, which is the whole reason the recipe is derived through vllm_recipe_targeting instead of
// spelled out a second time.
test fn the_fleet_recipe_diverges_from_upstream_only_in_the_arch_list_and_parallelism() -> Bool {
  let fleet = v41_gb10_recipe()
  let upstream = vllm_07b75534_aarch64_release_recipe
  (fleet.source.full_revision as String) == (upstream.source.full_revision as String)
    && (fleet.cuda_version as String) == (upstream.cuda_version as String)
    && (fleet.build_base_image as String) == (upstream.build_base_image as String)
    && (fleet.torch_version as String) == (upstream.torch_version as String)
    && (fleet.flashinfer_version as String) == (upstream.flashinfer_version as String)
    && (fleet.build_target as String) == (upstream.build_target as String)
    && (fleet.torch_cuda_arch_list as String) != (upstream.torch_cuda_arch_list as String)
    && (fleet.torch_cuda_arch_list as String) == (v41_gb10_torch_cuda_arch_list as String)
}

// THE REASON A BUILD IS NEEDED AT ALL, ASSERTED RATHER THAN ASSUMED: neither upstream recipe targets
// 12.1, so no image built from either can carry sm_121 kernels, and 12.1 is nonetheless an
// architecture upstream's own build system accepts.
// THE SUBJECT ARCHITECTURE IS PINNED HERE, and the literal is grounded rather than copied from the
// declaration it checks: GB10 reports compute capability (12, 1) from torch.cuda.get_device_capability
// inside every container probed on spark-a3ee, and this lane's own probe re-derives it on every run
// (it prints COMPUTE_CAPABILITY before it asks anything else), so a build targeting anything else is
// building for hardware the fleet does not have. 🟡 dissolve-on: replaced by a join to
// gunbc.spark.serving_runtime_capability_probe gb10_observed_compute_capability when #11016 lands,
// which is the declared home for that measurement.
test fn neither_upstream_recipe_targets_gb10_and_upstream_still_accepts_it() -> Bool {
  (v41_gb10_torch_cuda_arch_list as String) == "12.1"
    && !string_contains(s: vllm_07b75534_default_recipe.torch_cuda_arch_list as String, pattern: "12.1")
    && !string_contains(s: vllm_07b75534_aarch64_release_recipe.torch_cuda_arch_list as String, pattern: "12.1")
    && vllm_cuda_arch_supported(arch: v41_gb10_torch_cuda_arch_list)
    && v41_recipe_arch_is_buildable()
}

// THE BUILD KEY IS A FUNCTION OF THE INPUTS AND THE TAG IS A FUNCTION OF THE KEY. The discriminating
// half is the second pair: a key that ignored the arch list would give the sm_121 build and a 12.0
// build the same tag, which is exactly the collision the key exists to prevent.
test fn the_key_and_tag_move_with_the_arch_list_and_not_with_parallelism() -> Bool {
  let fleet = v41_gb10_recipe()
  let other_arch = vllm_recipe_targeting(
    base: vllm_07b75534_aarch64_release_recipe,
    torch_cuda_arch_list: "12.0" as NonEmptyStr,
    max_jobs: v41_build_max_jobs,
    nvcc_threads: v41_build_nvcc_threads,
  )
  let other_jobs = vllm_recipe_targeting(
    base: vllm_07b75534_aarch64_release_recipe,
    torch_cuda_arch_list: v41_gb10_torch_cuda_arch_list,
    max_jobs: "1" as NonEmptyStr,
    nvcc_threads: "1" as NonEmptyStr,
  )
  let fleet_key = serialize_content_hash(hash: v41_build_key(r: fleet)) as String
  (serialize_content_hash(hash: v41_build_key(r: other_arch)) as String) != fleet_key
    && (serialize_content_hash(hash: v41_build_key(r: other_jobs)) as String) == fleet_key
    && string_contains(s: v41_image_tag(r: fleet) as String, pattern: fleet_key)
    && (v41_image_tag(r: other_arch) as String) != (v41_image_tag(r: fleet) as String)
}

// THE RENDERED INVOCATION CARRIES THE THREE FACTS THAT DECIDE WHAT IS BUILT, and ends with the
// context. A --build-arg whose name and value were separate argv words would be a different command
// line that the engine reads differently, so the joined spelling is asserted.
test fn the_build_argv_carries_the_arch_list_the_aarch64_base_and_the_context_last() -> Bool {
  let words = argv_words(command: docker_build_spec_command(spec: v41_build_spec(r: v41_gb10_recipe())))
  let line = join(words, " ")
  string_contains(s: line, pattern: "--build-arg torch_cuda_arch_list=12.1")
    && string_contains(s: line, pattern: "--build-arg BUILD_BASE_IMAGE=pytorch/manylinuxaarch64-builder:cuda13.0-b8b5f17a7d9ccfc25bbc5cf17b3fcea12964a042")
    && string_contains(s: line, pattern: "--target vllm-openai")
    && string_contains(s: line, pattern: "--platform linux/arm64")
    && string_contains(s: line, pattern: "/home/briansrls/gunbc-v41-build/src/docker/Dockerfile")
}

// THE PROBE ASKS WHAT THE ROSTER SAYS, AND NOTHING IS SPELLED TWICE. Every symbol in every surface
// appears in the generated script because the script is folded out of those lists; delete a row and
// this goes red, which is the property that keeps the roster the single place a name is written.
fn script_names_all(symbols: List<NonEmptyStr>) -> Bool {
  fold(symbols, init: true, f: (acc, s) => acc && string_contains(s: v41_probe_script(), pattern: s as String))
}

test fn the_generated_probe_script_names_every_symbol_the_roster_declares() -> Bool {
  script_names_all(symbols: v41_fp4_weight_surface.torch_operators)
    && script_names_all(symbols: v41_csa2_surface.python_modules)
    && script_names_all(symbols: v41_dspark_surface.python_modules)
    && script_names_all(symbols: v41_sm12_demand_symbols())
    && string_contains(s: v41_probe_script(), pattern: v41_probe_architecture_class as String)
}

// THE LAYOUT QUESTION IS ASKED BY CALLING THE ADMISSION RULE AND IT ASKS ABOUT THE LAYOUT THAT IS
// REJECTED, which is what makes the answer informative: a probe that only asked about admitted
// dtypes could not distinguish a backend that admits everything from one that admits the right set.
test fn the_layout_block_calls_the_backend_and_asks_about_the_rejected_layout() -> Bool {
  let script = v41_probe_script()
  string_contains(s: script, pattern: "DeepseekV4FlashInferMLASparseBackend")
    && string_contains(s: script, pattern: "supports_combination")
    && string_contains(s: script, pattern: "nvfp4_ds_mla")
    && string_contains(s: script, pattern: "fp8_ds_mla")
    && !v41_sm12_kv_cache_dtype_admitted(dtype: "nvfp4_ds_mla" as NonEmptyStr)
    && v41_sm12_kv_cache_dtype_admitted(dtype: "fp8_ds_mla" as NonEmptyStr)
}

// SILENCE IS NOT ABSENCE, AND THIS IS THE ARM THAT KEEPS A BROKEN PROBE FROM RANKING AN IMAGE OUT. A
// stdout carrying no VERDICT line for a capability reads UNREAD; one carrying the absent line reads
// absent. Collapsing the two would turn an import error inside the container into evidence against
// the built image.
test fn a_capability_with_no_verdict_line_reads_unread_and_never_absent() -> Bool {
  let silent = "DETAIL mla-kv-cache-layout-admitted error ImportError\n"
  let measured = "VERDICT mla-kv-cache-layout-admitted=absent\n"
  let present = "VERDICT fp4-weight-kernels=present\n"
  (match v41_capability_reading(stdout: silent, capability: v41_capability_kv_layout) {
    V41CapabilityUnread { capability: _, cause: _ } => true
    V41CapabilityAbsent { capability: _ } => false
    V41CapabilityPresent { capability: _ } => false
  })
    && (match v41_capability_reading(stdout: measured, capability: v41_capability_kv_layout) {
      V41CapabilityAbsent { capability: _ } => true
      V41CapabilityUnread { capability: _, cause: _ } => false
      V41CapabilityPresent { capability: _ } => false
    })
    && (match v41_capability_reading(stdout: present, capability: v41_capability_fp4_weight) {
      V41CapabilityPresent { capability: _ } => true
      V41CapabilityAbsent { capability: _ } => false
      V41CapabilityUnread { capability: _, cause: _ } => false
    })
    && (match v41_capability_reading(stdout: present, capability: v41_capability_architecture) {
      V41CapabilityUnread { capability: _, cause: _ } => true
      V41CapabilityPresent { capability: _ } => false
      V41CapabilityAbsent { capability: _ } => false
    })
}

// TWO VERDICT LINES FOR ONE CAPABILITY IS NOT A PRESENT READING, and this is the arm that would have
// caught the generator defect that produced it: a vacuous reporter call printed `=present` for the
// architecture capability before the real answer, so a reader taking the first match would have
// reported an unregistered architecture as registered. The generated script no longer emits the
// vacuous line, and this asserts the reader refuses it either way -- the wall stays after the
// producer is fixed, because it is the producer that can regress.
test fn contradictory_verdict_lines_read_unread_rather_than_present() -> Bool {
  let both = "VERDICT architecture-registered=present\nVERDICT architecture-registered=absent\n"
  (match v41_capability_reading(stdout: both, capability: v41_capability_architecture) {
    V41CapabilityUnread { capability: _, cause: _ } => true
    V41CapabilityPresent { capability: _ } => false
    V41CapabilityAbsent { capability: _ } => false
  })
    && !string_contains(s: v41_probe_script(), pattern: "report(\"architecture-registered\", ops=[], modules=[], attrs=[])")
}

// THE ARCH GATE IS CARRIED AS TWO BLOCKS AND THE DS-MLA NVFP4 SOURCE IS IN EXACTLY ONE OF THEM. This
// is the upstream cause a measured FP4 DS-MLA absence on sm_121 points at, so it is asserted rather
// than left as prose that could drift from the lists beside it.
fn block_lists_source(sources: List<NonEmptyStr>, needle: String) -> Bool {
  fold(sources, init: false, f: (acc, s) => acc || string_contains(s: s as String, pattern: needle))
}

test fn the_ds_mla_nvfp4_kernels_are_listed_only_in_the_sm100_block() -> Bool {
  block_lists_source(sources: v41_fp4_sm100_block.sources, needle: "nvfp4_ds_mla_cache_kernels.cu")
    && !block_lists_source(sources: v41_fp4_sm120_block.sources, needle: "nvfp4_ds_mla_cache_kernels.cu")
    && block_lists_source(sources: v41_fp4_sm120_block.sources, needle: "nvfp4_scaled_mm_sm120_kernels.cu")
    && string_contains(s: v41_fp4_sm120_block.arch_set as String, pattern: "12.0f")
    && string_contains(s: v41_fp4_sm100_block.defines as String, pattern: "ENABLE_NVFP4_SM100")
}

// THE FP4-KV OPERATOR ROSTER IS THE CORRECTION ITSELF, so it is asserted rather than left to be read.
// The three names the build obligation originally carried -- concat_and_cache_ds_mla_nvfp4,
// indexer_k_quant_and_cache_fp4, nvfp4_ds_mla_cache -- are not registered operators at this revision,
// and a probe that asked for them recorded a false absence in every image. What IS registered is
// below, namespace-qualified, because torch.ops._C and torch.ops._C_cache_ops are different lookups.
fn roster_contains(symbols: List<NonEmptyStr>, needle: String) -> Bool {
  fold(symbols, init: false, f: (acc, s) => acc || (s as String) == needle)
}

test fn the_fp4_kv_roster_carries_the_registered_operators_and_not_the_names_that_do_not_exist() -> Bool {
  let ops = v41_fp4_kv_cache_surface.torch_operators
  roster_contains(symbols: ops, needle: "_C_cache_ops.concat_and_cache_mla")
    && roster_contains(symbols: ops, needle: "_C_cache_ops.indexer_k_quant_and_cache")
    && !roster_contains(symbols: ops, needle: "concat_and_cache_ds_mla_nvfp4")
    && !roster_contains(symbols: ops, needle: "indexer_k_quant_and_cache_fp4")
    && !roster_contains(symbols: ops, needle: "nvfp4_ds_mla_cache")
    && roster_contains(symbols: v41_fp4_weight_surface.torch_operators, needle: "_C.cutlass_scaled_fp4_mm")
    && !roster_contains(symbols: v41_fp4_weight_surface.torch_operators, needle: "_C.scaled_fp4_quant")
}


// THE BUILD HOST MUST RESOLVE TO AN ENDPOINT THAT IS NOT ITS OWN NAME, and this witness exists
// because the first modeled run refused for exactly the lack of it. fleet_probe_endpoint_for folds
// the router bindings and, finding no match, RETURNS ITS INPUT rather than refusing -- so a host
// named by a vendor label instead of a fleet identity yields a "endpoint" that is the label itself,
// which no anchor has a key for. That fallback is upstream of this lane and is not fixed here; what
// is fixed is that this lane cannot ship a host whose endpoint resolution silently did nothing.
test fn the_build_host_resolves_to_an_endpoint_other_than_its_own_name() -> Bool {
  match spark_reach_endpoint(host: v41_build_host, path: ReachManagementLan) {
    Absent => false
    Present { value: endpoint } => endpoint != (v41_build_host as String) && string_contains(s: endpoint, pattern: ".")
  }
}

// THE RECORDED READINGS ARE ASSERTED AT THE GRAIN THEY WERE TAKEN, so the one absence cannot be
// tidied into a pass and the five presences cannot drift into a claim nobody measured. The
// architecture row is the finding: the image built from the lead commit carries every kernel
// capability the SM12 path asks for and does not register the checkpoint's architecture.
test fn the_built_image_meets_every_kernel_capability_and_registers_no_v41_architecture() -> Bool {
  let unmet = v41_image_unmet_capabilities()
  length(unmet) == 1
    && (match v41_reading_for(capability: v41_capability_architecture) {
      Absent => false
      Present { value: r } =>
        (r.observed as String) == "absent"
          && string_contains(s: r.evidence as String, pattern: "383")
          && string_contains(s: r.evidence as String, pattern: "DeepseekV4ForCausalLM")
    })
    && (match v41_reading_for(capability: v41_capability_flashinfer_sm120) {
      Absent => false
      Present { value: r } => (r.observed as String) == "present"
    })
    && (match v41_reading_for(capability: v41_capability_kv_layout) {
      Absent => false
      Present { value: r } =>
        (r.observed as String) == "present"
          && string_contains(s: r.evidence as String, pattern: "rejected auto, bfloat16 and nvfp4_ds_mla")
    })
}

// THE PUBLISHED IMAGE ANSWERS THE QUESTION OUR BUILD COULD NOT, AND THE TWO FACTS THAT EXPLAIN WHY
// ARE ASSERTED TOGETHER: it carries a registry entry for the architecture, and it is built from a
// revision that is not in the public repository. Either alone would be a curiosity; together they say
// the gap is wiring held outside public main rather than anything about this fleet's build.
test fn the_published_image_registers_the_architecture_from_a_revision_public_main_does_not_have() -> Bool {
  fold(v41_flash_published_registry_entries, init: false, f: (acc, e) =>
    acc || string_contains(s: e as String, pattern: "DeepseekV41ForCausalLM -> (vllm.models.deepseek_v4_1"))
    && string_contains(s: v41_flash_published_revision_public_standing as String, pattern: "No commit found for SHA: 179dd0fa9")
    && string_contains(s: v41_flash_published_distribution as String, pattern: "g179dd0fa9")
    && string_contains(s: v41_flash_published_torch_cuda_arch_list as String, pattern: "12.1")
    && !v41_flash_hardware_verified(hardware: "gb10" as NonEmptyStr)
    && v41_flash_hardware_verified(hardware: "gb200" as NonEmptyStr)
    && string_contains(s: v41_flash_documented_tag_standing as String, pattern: "404")
}
