module test.claim.spark.glm_group_b_launch_authority_witness_test

import std.types { Bool, String, NonEmptyStr, List }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import v2.std.algebra { skip, zip_map }
import extdeps.docker.cli {
  DockerCreateSpec, DockerForegroundRunArgv, DockerForegroundRunRefused,
  docker_create_arguments, docker_run_foreground_argv,
}
import extdeps.vllm.environment {
  VllmEngineReadyTimeoutSeconds, VllmSparseIndexerMaxLogitsMb, vllm_environment_assignment_wire,
}
import extdeps.vllm.usage_stats { vllm_usage_stats_disable_assignment_wire }
import gunbc.spark.serving_arm { glm_native_engine_build, glm_native_engine_build_image }
import gunbc.spark.serving_arm_launch { ArmNodeLaunch }
import gunbc.spark.glm_group_b_launch {
  glm_group_b_engine_ready_timeout_seconds, glm_group_b_sparse_indexer_max_logits_mb,
}
import gunbc.spark.native_serving_realization {
  GlmNativeUnitRender, GlmNativeUnitRendered, GlmNativeUnitRenderRefused,
  glm_native_launch_lines, glm_native_unit_exec_words, glm_native_all_unit_renders,
}

// ── ONE GROUP-B LAUNCH SPECIFICATION, AND THE PROJECTIONS THAT MAY NOT DRIFT FROM IT ──────────
//
// THE DEFECT THIS EXISTS AGAINST WAS LIVE AND SILENT. Group B's launch had two authorities --
// gunbc.spark.serving_arm_launch rendered a DockerCreateSpec for the direct-docker relaunch, and
// gunbc.spark.native_serving_realization hand-assembled a second `docker run` word list for the
// systemd unit -- and they had already disagreed on three fields: the spec carried a --shm-size the
// unit did not spell, the two read their vLLM environment values from different homes, and only the
// unit declared the usage-stats reporter off. Nothing went red, because a comparison needs a shared
// value to be against and there was none. The consolidation removed the second assembler; these rows
// are what keeps the remaining two PROJECTIONS from growing apart again.
//
// WHY THIS IS NOT A DECORATION (DESIGN section 4b). The equality below is not true by construction:
// extdeps.docker.cli's create verb and its foreground verb are two independently written folds over
// one flag body, and either could drop a flag, reorder a group, or start spelling its own. Deleting a
// line from `docker_container_resource_flags`, or adding a word to one verb and not the other, turns
// the first claim red. The second claim's red is the original defect returning: a renderer that
// assembles its own words no longer produces the projection's line.

// A WORD-FOR-WORD COMPARISON, because a set comparison would pass a launch whose flags landed in an
// order docker reads differently, and a length comparison would pass two lines that differ in every
// word.
fn words_equal(a: List<String>, b: List<String>) -> Bool {
  count(a) == count(b) && all(zip_map(a: a, b: b, f: fn(x, y) { x == y }), v => v)
}

// THE ONE FIELD THE TWO VERBS DO NOT SHARE, REMOVED EXPLICITLY RATHER THAN TOLERATED. `docker run
// --rm` conflicts with a restart policy, so the foreground projection refuses any policy but
// RestartNo and spells none; dropping the pair here is what lets the rest be compared exactly,
// instead of the comparison being weakened to "mostly agrees".
fn drop_restart_flag(ws: List<String>) -> List<String> {
  match ws {
    Empty => []
    Cons { head: w, tail: t } =>
      if w == "--restart" {
        skip(xs: t, n: 1)
      } else {
        concat([w], drop_restart_flag(ws: t))
      }
  }
}

fn head_launch() -> ArmNodeLaunch? {
  glm_native_launch_lines().first()
}

fn head_spec() -> DockerCreateSpec? {
  match head_launch() {
    Absent => none
    Present { value: l } => Present { value: l.container }
  }
}

fn head_foreground_words() -> List<String> {
  match head_spec() {
    Absent => []
    Present { value: spec } =>
      match glm_native_unit_exec_words(spec: spec) {
        Absent => []
        Present { value: ws } => ws
      }
  }
}

// ── (1) THE TWO REALIZATION HANDLERS PROJECT THE SAME CONTAINER ───────────────────────────────
//
// The create side loses its verb (one word) and its restart pair; the foreground side loses the
// binary path, `run` and `--rm` (three words). What remains is every field a launch can be wrong
// about -- name, network, ipc, shm size, memlock, gpus, devices, capabilities, mounts, environment,
// image and the engine's own argv -- and it is compared word for word.
test fn w_the_two_launch_projections_agree_word_for_word() -> Bool {
  match head_spec() {
    Absent => false
    Present { value: spec } => {
      let created = drop_restart_flag(ws: skip(xs: docker_create_arguments(spec: spec), n: 1))
      let foreground = skip(xs: head_foreground_words(), n: 3)
      count(created) > 0 && words_equal(a: created, b: foreground)
    }
  }
}

// ── (2) THE UNIT'S ExecStart IS THE PROJECTION, NOT A SECOND ASSEMBLY ─────────────────────────
//
// The rendered unit text must literally contain the foreground argv joined by spaces. A renderer
// that went back to building its own word list would still produce a plausible unit and would fail
// here on the first word that differs.
test fn w_the_head_unit_exec_line_is_the_projection() -> Bool {
  let words = head_foreground_words()
  count(words) > 0 && match glm_native_all_unit_renders().first() {
    Absent => false
    Present { value: r } =>
      match r {
        GlmNativeUnitRenderRefused { unit_name: _, cause: _ } => false
        GlmNativeUnitRendered { unit_name: _, text: t } =>
          string_contains(s: t, pattern: join(["ExecStart=", join(words, " ")], ""))
      }
  }
}

// ── (3) THE THREE FIELDS THAT HAD ACTUALLY DRIFTED ────────────────────────────────────────────
//
// Named individually rather than folded into the equality above, because a general equality that
// goes red tells a reader only THAT something moved. These say which three the fleet has already
// been burned by, so a future loss reports itself by name.
test fn w_the_drifted_fields_reach_the_rendered_unit() -> Bool {
  let words = head_foreground_words()
  count(words) > 0
    && any(words, w => w == "--shm-size")
    && any(words, w => w == vllm_usage_stats_disable_assignment_wire())
    && any(words, w => w == vllm_environment_assignment_wire(
         variable: VllmEngineReadyTimeoutSeconds,
         value: to_string(glm_group_b_engine_ready_timeout_seconds)))
    && any(words, w => w == vllm_environment_assignment_wire(
         variable: VllmSparseIndexerMaxLogitsMb,
         value: to_string(glm_group_b_sparse_indexer_max_logits_mb)))
}

// ── (4) ONE IMAGE, AND IT IS THE DERIVED BUILD ────────────────────────────────────────────────
//
// The plan's image_reference is what both handlers send. It must be the reference the runtime row
// pins rather than a second spelling of the same build: the renderer used to carry the build's
// content-hashed TAG while the plan carried the registry reading's DIGEST, which is one image under
// two names and therefore two answers to "what is running".
test fn w_every_rank_launches_one_image() -> Bool {
  let lines = glm_native_launch_lines()
  count(lines) == 4
    && all(lines, l => (l.image_reference as String) == (l.container.image as String))
    && all(lines, l => match lines.first() {
         Absent => false
         Present { value: h } => (l.image_reference as String) == (h.image_reference as String)
       })
    && !((glm_native_engine_build_image(build: glm_native_engine_build) as String) == "")
}

test fn w_all_glm_group_b_launch_authority_claims_hold() -> Bool {
  w_the_two_launch_projections_agree_word_for_word()
    && w_the_head_unit_exec_line_is_the_projection()
    && w_the_drifted_fields_reach_the_rendered_unit()
    && w_every_rank_launches_one_image()
}
