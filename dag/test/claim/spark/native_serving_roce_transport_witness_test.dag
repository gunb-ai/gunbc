import gunbc.spark.serving_arm_launch { ArmNodeLaunch, arm_rail_gid_selection }

// THE 2026-09-17 CORRECTNESS RULING, ENROLLED. The GLM native arm ran every rank on TCP sockets
// for days -- `NET/IB : No device found.` then `Using network Socket` -- because its container was
// created without the verbs device, the capability, the lock and the endpoint env, and nothing
// refused. The operator ruled the socket fallback a correctness issue: the deployment intends the
// direct fabric line, so these claims pin (a) the arm's plan IS the RoCE arm keyed by the lane
// census, (b) the rendered container line carries every projection of that plan, and (c) the
// apply's post-pass gate refuses a rank that bound Socket.

// THE LANE IS THE REAL CENSUS ROW, NOT A FIXTURE: the claim is precisely that the arm reads the
// interface and the verbs device from fabric_switch_observed, so a fixture here would assert
// nothing about the fleet.
fn srv9_lane() -> FabricLaneObserved {
  match fabric_lane_for_host(host: operator_host_srv9) {
    Absent => FabricLaneObserved { cage: 0, lane: 0, host: operator_host_srv9, spark_hostname: "absent" as NonEmptyStr, leg_netdev: "absent" as NonEmptyStr, leg_netdev_twin: "absent" as NonEmptyStr, leg_rdma_device: "absent" as NonEmptyStr }
    Present { value: l } => l
  }
}

fn argv_has(argv: List<String>, word: String) -> Bool {
  any(argv, w => w == word)
}

// THE SUBJECT IS THE HEAD RANK'S REAL RENDER, taken from the one Group-B launch specification and
// projected through the same foreground verb the unit's ExecStart carries. An earlier revision of
// this witness called a renderer that assembled its own word list; that renderer is gone, and
// reading the projection is what makes these rows claims about what a host is actually sent.
fn head_launch() -> ArmNodeLaunch? {
  glm_native_launch_lines().first()
}

fn head_exec_words() -> List<String> {
  match head_launch() {
    Absent => []
    Present { value: l } =>
      match glm_native_unit_exec_words(spec: l.container) {
        Absent => []
        Present { value: ws } => ws
      }
  }
}


// ── THE PLAN IS THE RoCE ARM, KEYED BY THE LANE ───────────────────────────────────────────────
test fn w_the_native_plan_is_the_roce_arm_keyed_by_the_lane() -> Bool {
  let lane = srv9_lane()
  match head_launch() {
    Absent => false
    Present { value: l } =>
      match l.node.transport {
        SocketOverInterface { interface: _ } => false
        RoceOverInterface { interface: i, rdma_device: d, gid_selection: _ } =>
          (i as String) == (lane.leg_netdev as String)
            && (d as String) == (lane.leg_rdma_device as String)
            && (d as String) == "rocep1s0f1"
      }
  }
}

// ── THE CONTAINER LINE CARRIES EVERY PROJECTION ───────────────────────────────────────────────
//
// One missing word is exactly the failure shape this claim exists against: the arm that fell back
// had the interface env and nothing else. The device, the capability, the lock and BOTH endpoint
// env assignments are asserted individually so a loss names itself.
test fn w_the_container_argv_carries_the_roce_projections() -> Bool {
  let argv = head_exec_words()
  count(argv) > 0
    && argv_has(argv: argv, word: "--device")
    && argv_has(argv: argv, word: "/dev/infiniband:/dev/infiniband:rwm")
    && argv_has(argv: argv, word: "--cap-add")
    && argv_has(argv: argv, word: "IPC_LOCK")
    && argv_has(argv: argv, word: "--ulimit")
    && argv_has(argv: argv, word: "memlock=-1:-1")
    && argv_has(argv: argv, word: "NCCL_IB_HCA=rocep1s0f1")
    && argv_has(argv: argv, word: "UCX_NET_DEVICES=rocep1s0f1:1")
    && argv_has(argv: argv, word: "NCCL_SOCKET_IFNAME=enp1s0f1np1")
}

// ── NO SECOND NCCL PARSER SURVIVES IN THE APPLY ───────────────────────────────────────────────
//
// THE RED IS A RELAPSE, AND IT IS SPELLED AS AN ABSENCE FOR A REASON. This module used to grep the
// unit log for `Using network` and decide the transport itself -- a weaker second authority than
// extdeps.nvidia.nccl, blind to the channel lines and to the announcement/channel contradiction arms,
// and bound to a log path rather than to an incarnation. The verdict now comes from
// gunbc.spark.serving_rank_observe observe_rank_transport on the exact ContainerInspect. If any stage
// script starts spelling NCCL's own words again, that is the fork returning, and these rows go red.
//
// AN ABSENCE CLAIM IS THE WEAK KIND OF EVIDENCE, so it is paired: the positive half is
// w_the_readback_is_incarnation_bound_and_typed below, which asserts the real producers are what the
// transaction consumes. Neither row alone would establish the repair.
test fn w_no_stage_script_parses_nccl_itself() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } => {
          let scripts = join([
            spark_native_preflight_script(unit_name: st.unit_name, unit_text: st.unit_text, spec: st.launch.container, host_model_path: st.launch.host_model_path),
            spark_native_preserve_script(unit_name: st.unit_name, transaction_id: "t"),
            spark_native_rollback_script(unit_name: st.unit_name, transaction_id: "t"),
            spark_native_metadata_cleanup_script(unit_name: st.unit_name, transaction_id: "t"),
            spark_native_front_door_script(port_text: "30000", served_alias: "x" as NonEmptyStr),
          ], "\n")
          !string_contains(s: scripts, pattern: "Using network")
            && !string_contains(s: scripts, pattern: "NET/IB")
            && !string_contains(s: scripts, pattern: "ss -H")
        }
      }
  }
}

// ── THE ARM'S ROSTER IS PLANNED HERE, HEAD FIRST ─────────────────────────────────────────────
//
// Group B left the pair roster on 2026-09-08 (spark_pair_serving_groups = [FabricGroupA]); this
// apply is its authority. The head-first order is load-bearing: workers restarted before the
// head's new rendezvous store existed were observed joining the PREVIOUS epoch's store while the
// head crash-looped on DistStoreError (2026-09-16).
test fn w_the_native_apply_plans_the_whole_arm_head_first() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      length(steps) == 4 && match first(steps) {
        Absent => false
        Present { value: head_step } => host_identity_eq(a: head_step.host, b: operator_host_srv9)
      }
  }
}

// ── WHICH STAGES MAY ROLL THE LIVE ARM BACK, AND WHICH MAY ONLY REFUSE ────────────────────────
//
// THE MEASURED DEFECT THIS ROW IS RED FOR RAN IN BOTH DIRECTIONS. Preserve was marked as having
// touched a host because it writes files -- so a preserve failure, INCLUDING A CREDENTIAL REFUSAL
// where no preserve leg ran at all, entered the rollback path, and rollback restarts every restored
// unit. A failure while making backups could therefore reload the 328 GB live arm and then report the
// untouched serving arm as a partial transaction. The other direction is the one that looks safe and
// is not: marking apply as non-mutating would let a failed apply report a clean refusal over four
// restarted engines. Both are one predicate, so both are one claim.
test fn w_only_preflight_may_report_no_host_touched() -> Bool {
  spark_native_stage_has_mutated_the_serving_arm(st: NativeStagePreflight) == false
    && spark_native_stage_has_mutated_the_serving_arm(st: NativeStagePreserve) == false
    && spark_native_stage_has_mutated_the_serving_arm(st: NativeStageMetadataCleanup) == false
    && spark_native_stage_has_mutated_the_serving_arm(st: NativeStageApply)
    && spark_native_stage_has_mutated_the_serving_arm(st: NativeStageReadback)
    && spark_native_stage_has_mutated_the_serving_arm(st: NativeStageCommit)
}

// ── THE PREFLIGHT ASKS ALL FOUR QUESTIONS BEFORE ANY HOST IS TOUCHED ──────────────────────────
//
// Each is named individually because losing one is silent: an apply that stopped checking for the
// image would still pass preflight on every host and then fail four engines into a pull that cannot
// happen while the GPUs are already released.
test fn w_the_preflight_checks_image_snapshot_and_startability() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } => {
          let script = spark_native_preflight_script(
            unit_name: st.unit_name, unit_text: st.unit_text,
            spec: st.launch.container, host_model_path: st.launch.host_model_path)
          string_contains(s: script, pattern: "docker image inspect")
            && string_contains(s: script, pattern: "PREFLIGHT-REFUSED-image-absent")
            && string_contains(s: script, pattern: "PREFLIGHT-REFUSED-snapshot-absent")
            && string_contains(s: script, pattern: "systemd-analyze verify")
            && string_contains(s: script, pattern: st.launch.host_model_path as String)
            && !string_contains(s: script, pattern: "systemctl restart")
        }
      }
  }
}

// ── THE READBACK COMPARES THE WHOLE REALIZATION, THROUGH THE CANONICAL COMPARISON ─────────────
//
// THE SUBSET THAT WAS BEING CALLED EXACT. An earlier revision compared Config.Image and Config.Cmd in
// shell and named that an exact container readback. It never looked at HostConfig.Devices, CapAdd,
// Ulimits, ShmSize, the binds and their readonly standing, the effective environment, the network and
// IPC modes, or the restart policy -- which is to say it was blind to precisely the fields the Group-B
// transport incident was made of, and to two of the three the one-launch consolidation found had
// already drifted.
//
// ── THE SPEC IS SUPPLIED, AND THAT IS THE §3 RULE RATHER THAN A SHORTCUT ──────────────────────
//
// THIS CLAIM'S SUBJECT IS ONE INTERFACE: what relaunch_delta answers for a spec and a document. An
// earlier revision took its spec from spark_native_arm_steps(), which builds the whole Group-B launch
// plan -- the roster, four transport plans, four container specs and four engine argv lists -- so
// every assertion here paid for the launch planner, and the claim measured 196,704 eval steps against
// a 72,300 budget. The tell DESIGN section 3 names was exactly present: the cost did not move when the
// assertions changed, because the assertions were never the expense.
//
// SO THE SPEC BELOW IS CONSTRUCTED, and it is deliberately small AND complete -- one device, one
// capability, memlock lifted, one readonly bind, two environment assignments, both namespace modes,
// a shm size and a command -- so every one of the eleven compared fields is inhabited and each
// falsifier still moves exactly one of them. The document still goes through the REAL decoder.
//
// THE PAIRING OBLIGATION IS DISCHARGED BY TWO THINGS, because a supplied input is a hypothesis about
// a boundary until something says the real producer emits that shape. The inhabitance claim is
// w_the_readback_is_incarnation_bound_and_typed, which reads the REAL Group-B plan and asserts its
// spec carries devices, capabilities and memlock; and the production route is
// gunbc.spark.native_serving_apply spark_native_rank_readback, which reaches this same comparison
// with a ContainerInspect the live daemon returned. Neither is replaced by the fixture.
data t_spec: DockerCreateSpec = DockerCreateSpec {
  name: "t-ctr" as NonEmptyStr,
  image: "sha256:00" as NonEmptyStr,
  network: NamespaceHost,
  ipc: NamespaceHost,
  shm_size_bytes: 67108864,
  memlock_unlimited: true,
  gpus_all: true,
  devices: [DockerDeviceMapping {
    host_path: "/dev/infiniband" as FilePath,
    container_path: "/dev/infiniband" as FilePath,
    cgroup_permissions: "rwm" as NonEmptyStr,
  }],
  cap_add: ["IPC_LOCK" as NonEmptyStr],
  restart: RestartNo,
  mounts: [BindMount { host_path: "/w" as NonEmptyStr, container_path: "/weights" as NonEmptyStr, readonly: true }],
  env: [
    DockerEnvAssignment { name: "NCCL_DEBUG" as NonEmptyStr, value: "INFO" },
    DockerEnvAssignment { name: "VLLM_HOST_IP" as NonEmptyStr, value: "10.0.0.1" },
  ],
  command: ["/weights", "--node-rank", "0"],
}

// A DAEMON DOCUMENT BUILT FROM THE SPEC, SO ONE FIELD CAN BE TAKEN AWAY AT A TIME. Every field is
// rendered from the spec, so the agreeing document agrees by construction and each falsifier differs
// in exactly one place; a hand-typed document would have drifted from the spec the first time either
// moved, and the claim would have gone red for the wrong reason.
fn t_json_list(xs: List<String>) -> String {
  join(["[", join(map(xs, x => join(["\"", x, "\""], "")), ","), "]"], "")
}

fn t_device_json(d: DockerDeviceMapping) -> String {
  join([
    "{\"PathOnHost\":\"", d.host_path as String,
    "\",\"PathInContainer\":\"", d.container_path as String,
    "\",\"CgroupPermissions\":\"", d.cgroup_permissions as String, "\"}",
  ], "")
}

fn t_mount_bind_json(m: DockerMount) -> String {
  match m {
    BindMount { host_path: h, container_path: c, readonly: ro } =>
      join(["\"", h as String, ":", c as String, if ro { ":ro" } else { "" }, "\""], "")
    VolumeMount { volume: v, container_path: c, readonly: ro } =>
      join(["\"", v as String, ":", c as String, if ro { ":ro" } else { "" }, "\""], "")
    TmpfsMount { container_path: c, size_bytes: _ } => join(["\"", c as String, "\""], "")
  }
}

fn t_inspect_text(spec: DockerCreateSpec, drop_devices: Bool, drop_capadd: Bool, drop_shm: Bool) -> String {
  join([
    "[{\"Id\":\"0123456789ab\",\"Created\":\"2026-09-18T00:00:00Z\",",
    "\"Image\":\"", spec.image as String, "\",",
    "\"Name\":\"/", spec.name as String, "\",",
    "\"State\":{\"Status\":\"running\",\"Running\":true,\"Paused\":false,\"Restarting\":false,\"OOMKilled\":false,\"Dead\":false},",
    "\"Config\":{\"Cmd\":", t_json_list(xs: spec.command), ",",
    "\"Env\":", t_json_list(xs: map(spec.env, e => join([e.name as String, "=", e.value], ""))), "},",
    "\"HostConfig\":{",
    "\"NetworkMode\":\"", docker_namespace_mode_wire(m: spec.network) as String, "\",",
    "\"IpcMode\":\"", docker_namespace_mode_wire(m: spec.ipc) as String, "\",",
    "\"ShmSize\":", if drop_shm { "1" } else { to_string(spec.shm_size_bytes) }, ",",
    "\"CapAdd\":", if drop_capadd { "[]" } else { t_json_list(xs: map(spec.cap_add, c => join(["CAP_", c as String], ""))) }, ",",
    "\"Devices\":[", if drop_devices { "" } else { join(map(spec.devices, d => t_device_json(d: d)), ",") }, "],",
    "\"Ulimits\":[", if spec.memlock_unlimited { "{\"Name\":\"memlock\",\"Soft\":-1,\"Hard\":-1}" } else { "" }, "],",
    "\"Binds\":[", join(map(spec.mounts, m => t_mount_bind_json(m: m)), ","), "],",
    "\"RestartPolicy\":{\"Name\":\"", docker_restart_policy_wire(p: spec.restart) as String, "\",\"MaximumRetryCount\":0}",
    "}}]",
  ], "")
}

fn t_inspect_of(spec: DockerCreateSpec, drop_devices: Bool, drop_capadd: Bool, drop_shm: Bool) -> ContainerInspect? {
  match container_inspect_from_stdout(stdout: t_inspect_text(spec: spec, drop_devices: drop_devices, drop_capadd: drop_capadd, drop_shm: drop_shm)) {
    ContainerInspectUnreadable { cause: _ } => none
    ContainerInspectDecoded { container: c } => Present { value: c }
  }
}

// THE VERDICT IS THE TRANSACTION'S OWN, AND CALLING IT IS THE POINT. spark_native_readback_disagreements
// is what gunbc.spark.native_serving_apply applies to the live comparison, so a widening there -- back
// to the relaunch module's off-axis predicate, say -- turns these rows red rather than passing quietly.
//
// THAT WIDENING IS NOT HYPOTHETICAL: it was the first spelling, and the drop-the-devices falsifier
// PASSED it. A devices or cap_add difference is carried on TransportAxis, so "no off-axis difference"
// is green on a container that mapped no verbs device -- the exact shape of the Group-B incident,
// admitted by the predicate meant to catch it. The relaunch module is right for its own subject
// (successor against incumbent, where an axis difference is the operation); a readback of a plan
// against what was realized from it has no such axis, and these three falsifiers are what says so.
fn t_delta_agrees(spec: DockerCreateSpec, observed: ContainerInspect?) -> Bool {
  match observed {
    Absent => false
    Present { value: c } => {
      let d = relaunch_delta(spec: spec, observed: c, gid_selection: arm_rail_gid_selection)
      count(spark_native_readback_disagreements(comparisons: delta_comparisons(d: d))) == 0
        && count(delta_unclaimed_env(d: d)) == 0
        && count(spark_native_image_readback_gap(spec: spec, observed: c)) == 0
    }
  }
}

// ── FOUR ROWS, NOT ONE, AND THE SPLIT IS THE §3 RULE AGAIN ───────────────────────────────────
//
// THE ACCEPT ROW IS THE POSITIVE CONTROL FOR THE THREE REFUSALS, enrolled as its own claim rather
// than re-evaluated inside each of them. A refusal row on its own establishes only that SOMETHING
// refused, and a comparison that refused every document would satisfy all three; the accept row is
// what says the comparison can say yes. Conjoining them would have paid the accept case four times
// and put every case through one budget, which is the shape that refused this file's roll-up.
//
// AND EACH REFUSAL NAMES ITS OWN FIELD, so a regression reports which field stopped discriminating
// rather than that "the readback" moved. The three are the fields the arm has actually been burned
// on: the verbs device and IPC_LOCK are the Group-B transport incident, and shm size is one of the
// two the one-launch consolidation found had already drifted between the renderers.
test fn w_the_readback_accepts_the_realized_plan() -> Bool {
  t_delta_agrees(spec: t_spec, observed: t_inspect_of(spec: t_spec, drop_devices: false, drop_capadd: false, drop_shm: false))
}

test fn w_the_readback_refuses_a_missing_verbs_device() -> Bool {
  !t_delta_agrees(spec: t_spec, observed: t_inspect_of(spec: t_spec, drop_devices: true, drop_capadd: false, drop_shm: false))
}

test fn w_the_readback_refuses_a_missing_capability() -> Bool {
  !t_delta_agrees(spec: t_spec, observed: t_inspect_of(spec: t_spec, drop_devices: false, drop_capadd: true, drop_shm: false))
}

test fn w_the_readback_refuses_a_changed_shm_size() -> Bool {
  !t_delta_agrees(spec: t_spec, observed: t_inspect_of(spec: t_spec, drop_devices: false, drop_capadd: false, drop_shm: true))
}

// ── THE POSITIVE GATE IS INCARNATION-BOUND, AND THE SOCKET IS NOT IN IT ───────────────────────
//
// WHAT THIS ROW IS THE RED FOR. The commit used to require `ss` seeing a listening socket on the head
// and an established connection on each worker -- host-level reach, which
// gunbc.spark.rendezvous_participation states at length is safe only as a NEGATIVE gate because it
// attributes the socket to no process. A foreign or stale process satisfies it. Reading that as
// positive current-epoch participation is the same overclaim this PR removed from the carrier, put
// back by its consumer.
//
// SO THE CLAIM IS THAT NO STAGE SCRIPT ASKS A SOCKET ANYTHING, paired with the positive half above:
// the transaction's evidence is the container named, its ContainerInspect compared field for field,
// the effective --node-rank read off that same container's argv, and NCCL's typed verdict on that
// incarnation -- a verdict that cannot exist until every rank has joined.
test fn w_the_readback_is_incarnation_bound_and_typed() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } =>
          length(steps) == 4
            && !string_contains(s: spark_native_front_door_script(port_text: "30000", served_alias: "x" as NonEmptyStr), pattern: "ss ")
            && string_contains(s: spark_native_front_door_script(port_text: "30000", served_alias: "x" as NonEmptyStr), pattern: "/v1/models")
            && count(st.launch.container.devices) > 0
            && count(st.launch.container.cap_add) > 0
            && st.launch.container.memlock_unlimited
      }
  }
}

// ── A HOST THAT WAS NEVER PRESERVED IS NOT GUESSED AT ─────────────────────────────────────────
// AND THE STOP IS FAIL-CLOSED. An earlier revision ran `systemctl disable --now <unit> || true` on
// the remove arm, so a real stop failure was discarded and this source could report a successful
// rollback while the SUCCESSOR container was still running and holding the GPUs with its unit file
// deleted -- the worst reachable state, reported as the best. The absence of that `|| true` is
// asserted, and so is the daemon read that establishes the container is actually gone.
test fn w_the_rollback_refuses_an_unpreserved_host() -> Bool {
  let script = spark_native_rollback_script(unit_name: "gunbc-glm-native-head.service" as NonEmptyStr, transaction_id: "t-1")
  string_contains(s: script, pattern: "ROLLBACK-REFUSED-this-host-was-never-preserved")
    && string_contains(s: script, pattern: "rollback-actuation-accepted-incumbent-unit-restored-and-exec-started")
    && string_contains(s: script, pattern: "rollback-actuation-accepted-unit-removed-and-container-gone")
    && string_contains(s: script, pattern: "ROLLBACK-REFUSED-successor-container-still-present-after-stop")
    && !string_contains(s: script, pattern: "|| true")
    && string_contains(s: script, pattern: "FENCE-REFUSED-held-by-another-transaction")
    && string_contains(s: script, pattern: ".gunbc-unresolved-rollback")
}

// ── AN UNVERIFIED ROLLBACK MAY NOT ERASE THE FENCE THAT STOPS ITS ADOPTION ────────────────────
//
// THE TWO BRANCHES END IN DIFFERENT STATES, SO THEY GET DIFFERENT FENCE RULES, and an earlier
// revision gave them the same one. The incumbent-restore branch establishes ExecStarted on a
// Type=simple unit and nothing more -- not the incumbent's image or argv, not one epoch, not
// transport, not the front door -- so clearing the fence would have let the NEXT invocation preserve
// that unverified state as its incumbent and proceed. The fence is renamed to an unresolved-rollback
// marker instead, which preflight refuses on. The remove branch may clear, because its evidence is an
// ABSENCE that was read back from the daemon: the unit is gone and no container answers that name, so
// there is no unverified running thing left to adopt.
test fn w_an_unverified_rollback_keeps_its_fence() -> Bool {
  let script = spark_native_rollback_script(unit_name: "gunbc-glm-native-head.service" as NonEmptyStr, transaction_id: "t-1")
  string_contains(s: script, pattern: join(["mv -f /etc/systemd/system/gunbc-glm-native-head.service.gunbc-transaction /etc/systemd/system/gunbc-glm-native-head.service", ".gunbc-unresolved-rollback"], ""))
    && string_contains(s: script, pattern: "rm -f /etc/systemd/system/gunbc-glm-native-head.service /etc/systemd/system/gunbc-glm-native-head.service.gunbc-had-no-unit /etc/systemd/system/gunbc-glm-native-head.service.gunbc-transaction")
}

// ── TWO TRANSACTIONS: B REFUSES ON A'S FENCE AND CANNOT REMOVE A'S ARTIFACTS ──────────────────
//
// THE INTERLEAVING THIS IS THE RED FOR, STEP BY STEP. A and B both clear preflight; A writes its
// fence and backup; B refuses preserve on A's fence; B's pre-actuation cleanup deletes the fixed
// paths -- A's fence and A's backup -- and A proceeds into mutation with its rollback evidence gone.
// Every step is individually correct and the sequence destroys the artifact the design rests on.
//
// TWO PROPERTIES CLOSE IT AND BOTH ARE ASSERTED. The acquisition is ATOMIC: `set -C` makes the
// redirect O_EXCL, so the loser learns it lost from the write rather than from a check that was true
// a moment ago -- a check-then-write is asserted ABSENT, because that is the shape that was wrong.
// And every removal is OWNERSHIP-CHECKED: cleanup, commit and rollback each read the fence and refuse
// on a foreign identity, so B's cleanup cannot touch A's.
test fn w_a_second_transaction_cannot_remove_the_first_ones_evidence() -> Bool {
  let unit = "gunbc-glm-native-head.service" as NonEmptyStr
  let a_preserve = spark_native_preserve_script(unit_name: unit, transaction_id: "A")
  let b_cleanup = spark_native_metadata_cleanup_script(unit_name: unit, transaction_id: "B")
  let b_commit = spark_native_commit_script(unit_name: unit, transaction_id: "B")
  let b_rollback = spark_native_rollback_script(unit_name: unit, transaction_id: "B")
  string_contains(s: a_preserve, pattern: "set -C")
    && string_contains(s: a_preserve, pattern: "PRESERVE-REFUSED-fence-held-by-")
    && all([b_cleanup, b_commit, b_rollback], sc =>
         string_contains(s: sc, pattern: "FENCE-REFUSED-held-by-another-transaction")
           && string_contains(s: sc, pattern: "'B'"))
    && string_contains(s: b_commit, pattern: "FENCE-REFUSED-no-fence-on-this-host")
    && string_contains(s: b_rollback, pattern: "FENCE-REFUSED-no-fence-on-this-host")
    && string_contains(s: b_cleanup, pattern: "metadata-cleanup-noop-this-transaction-holds-no-fence-here")
}

// ── THE REFUSAL MAY NOT ERASE THE THING IT IS REFUSING ABOUT ─────────────────────────────────
//
// THE HOLE THIS IS THE RED FOR WAS OPENED BY THE FIX FOR THE PREVIOUS ONE, WHICH IS WHY IT NEEDS ITS
// OWN ROW. An incumbent restore renames the ordinary fence to an unresolved-rollback marker, and
// preflight refuses on that marker, correctly. But that refusal routed into the metadata cleanup,
// whose guard did not REQUIRE a fence -- so with the ordinary fence gone the guard passed, and the rm
// list, which named the unresolved marker, deleted it. A third invocation then found nothing and
// adopted the unverified recovery as its baseline. Run 1 restores, run 2 refuses AND erases, run 3
// proceeds: the protection removed by the code path the protection triggered.
//
// FOUR PROPERTIES CLOSE IT AND EACH IS ASSERTED SEPARATELY, because they fail independently.
// Preflight owes no cleanup at all (it creates nothing but a /run candidate). An absent ordinary
// fence makes cleanup a NO-OP rather than permission to delete the fixed paths -- that inference is
// the defect itself, so the no-op arm is asserted by name. The unresolved marker is not in the
// removal list at ALL, rather than guarded out of it. And preflight still refuses on it, which is
// what makes the marker's survival mean something on the next run.
test fn w_a_refusal_cannot_erase_the_unresolved_rollback_marker() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } => {
          let cleanup = spark_native_metadata_cleanup_script(unit_name: st.unit_name, transaction_id: "t-1")
          let preflight = spark_native_preflight_script(unit_name: st.unit_name, unit_text: st.unit_text, spec: st.launch.container, host_model_path: st.launch.host_model_path)
          let rollback = spark_native_rollback_script(unit_name: st.unit_name, transaction_id: "t-1")
          spark_native_stage_created_removable_artifacts(st: NativeStagePreflight) == false
            && spark_native_stage_created_removable_artifacts(st: NativeStagePreserve)
            && string_contains(s: cleanup, pattern: "metadata-cleanup-noop-this-transaction-holds-no-fence-here")
            && !string_contains(s: cleanup, pattern: ".gunbc-unresolved-rollback")
            && string_contains(s: preflight, pattern: ".gunbc-unresolved-rollback")
            && string_contains(s: preflight, pattern: "PREFLIGHT-REFUSED-unresolved-transaction-artifact")
            && string_contains(s: rollback, pattern: ".gunbc-unresolved-rollback")
        }
      }
  }
}

// ── PREFLIGHT VALIDATES THE HOST-SIDE REALIZATION, NOT ONLY THE UNIT'S SYNTAX ─────────────────
//
// `systemd-analyze verify` answers whether systemd can PARSE the unit. It says nothing about whether
// Docker can realize the plan here: /dev/infiniband can be absent, a bind source can be missing, the
// GPU runtime can be unregistered -- and until this stage read them, the FIRST DISCRIMINATOR for any
// of those was the destructive restart, which is the exact mechanism the transaction exists to get in
// front of. Every device path and bind source the spec projects is tested BY NAME, so the claim moves
// with the plan rather than against a literal.
test fn w_preflight_tests_every_device_and_bind_source_by_name() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } => {
          let spec = st.launch.container
          let script = spark_native_preflight_script(unit_name: st.unit_name, unit_text: st.unit_text, spec: spec, host_model_path: st.launch.host_model_path)
          count(spec.devices) > 0
            && count(spec.mounts) > 0
            && all(spec.devices, d => string_contains(s: script, pattern: join(["PREFLIGHT-REFUSED-device-absent-", d.host_path as String], "")))
            && all(spec.mounts, m => match m {
                 BindMount { host_path: h, container_path: _, readonly: _ } =>
                   string_contains(s: script, pattern: join(["PREFLIGHT-REFUSED-bind-source-absent-", h as String], ""))
                 VolumeMount { volume: _, container_path: _, readonly: _ } => true
                 TmpfsMount { container_path: _, size_bytes: _ } => true
               })
            && string_contains(s: script, pattern: "PREFLIGHT-REFUSED-no-nvidia-runtime")
        }
      }
  }
}

// ── A DISPOSITION IS READ, NOT INFERRED ───────────────────────────────────────────────────────
//
// THE HEADLINE THAT MADE THIS NECESSARY said "THIS ARM IS SPLIT: some hosts carry the successor and
// some the incumbent" on a path that had observed no such thing -- a rollback credential refusal
// means no leg ran anywhere, which after a fully applied arm leaves all four hosts on the SUCCESSOR.
// The population is now derived from each leg's own printed word, and a leg that did not run or
// printed something this reader does not know is Unread rather than assigned to a side.
test fn w_a_host_disposition_comes_from_its_own_leg() -> Bool {
  let h = operator_host_srv9
  spark_native_disposition_is_read(d: spark_native_disposition_of(o: SparkPairHostApplied {
    host: h, detail: spark_native_incumbent_restored_word, standing: serving_standing(attempts: []) }))
    && spark_native_disposition_is_read(d: spark_native_disposition_of(o: SparkPairHostApplied {
         host: h, detail: spark_native_unit_removed_word, standing: serving_standing(attempts: []) }))
    && !spark_native_disposition_is_read(d: spark_native_disposition_of(o: SparkPairHostApplyFailed {
         host: h, cause: "ssh refused" }))
    && !spark_native_disposition_is_read(d: spark_native_disposition_of(o: SparkPairHostApplied {
         host: h, detail: "restarted", standing: serving_standing(attempts: []) }))
}

// ── THE FENCE: AN UNRESOLVED TRANSACTION REFUSES THE NEXT ONE ─────────────────────────────────
//
// THE FAILURE THIS FORBIDS IS A RETRY AFTER A PARTIAL TRANSACTION, which is the most dangerous
// invocation this module has. Preserve used to begin by DELETING any prior backup and marker, so a
// second run over a split arm destroyed the only record of what the incumbent had been and adopted
// the mixed state as its new baseline -- the recovery evidence consumed by the recovery attempt.
// Preflight now refuses on any leftover artifact and preserve refuses to clobber one, so the two
// halves say the same thing and the construction is the one that holds.
test fn w_an_unresolved_transaction_refuses_the_next_run() -> Bool {
  match spark_native_arm_steps() {
    NativeArmStepsRefused { cause: _ } => false
    NativeArmSteps { steps: steps, master_endpoint: _ } =>
      match first(steps) {
        Absent => false
        Present { value: st } => {
          let preflight = spark_native_preflight_script(unit_name: st.unit_name, unit_text: st.unit_text, spec: st.launch.container, host_model_path: st.launch.host_model_path)
          let preserve = spark_native_preserve_script(unit_name: st.unit_name, transaction_id: "2026-09-18T00:00:00Z")
          string_contains(s: preflight, pattern: "PREFLIGHT-REFUSED-unresolved-transaction-artifact")
            && string_contains(s: preserve, pattern: "PRESERVE-REFUSED-artifact-already-present")
            && string_contains(s: preserve, pattern: "2026-09-18T00:00:00Z")
            && string_contains(s: preserve, pattern: "PRESERVE-REFUSED-incumbent-inspect-unread")
            && string_contains(s: preserve, pattern: "preserved-incumbent-container-absent")
            && !string_contains(s: preserve, pattern: "rm -f /etc/systemd/system/gunbc-glm-native-head.service.gunbc-incumbent ")
        }
      }
  }
}

// ── THE TELEMETRY REPORTER IS DECLARED OFF, SPELLED BY UPSTREAM'S ROW ─────────────────────────
//
// The route's telemetry standing is discharged by the READING of the answering container's
// effective environment; this row pins the declaration half, so the reading the offer makes after
// converge comes out disabled. The word is derived from extdeps.vllm.usage_stats, never re-typed.
test fn w_the_container_argv_declares_the_reporter_off() -> Bool {
  let argv = head_exec_words()
  count(argv) > 0 && argv_has(argv: argv, word: vllm_usage_stats_disable_assignment_wire())
}

// ── THERE IS NO all_* CONJUNCTION HERE, AND THAT IS THE §3 RULE RATHER THAN AN OMISSION ──────
//
// A ROLL-UP THAT ANDs EVERY CLAIM PAYS EVERY CASE THROUGH ONE BUDGET. This file's did: at 199,092
// eval steps it refused the floor's new-witness budget while every individual row was comfortably
// inside it, and the roll-up asserted nothing its members did not already assert -- each `test fn` is
// enrolled and reported on its own, so the conjunction added a second, more expensive way to learn
// the same thing. DESIGN section 3 names the shape directly: a conjunction of independent cases that
// forces every case through one budget when splitting them loses no coverage.
//
// IT ALSO MADE EVERY FAILURE READ THE SAME. One red row and eight red rows both surfaced as one
// failing conjunction, so the receipt named the roll-up rather than the case.


