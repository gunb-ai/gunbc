module test.claim.spark_secret_access_ensure_witness_test

// WHAT IS LEFT IN THIS FILE AFTER THE MOVE. The reconciler these witnesses used to cover now lives
// at gunbc.auth.gcp_secret_access and is covered by test.claim.gcp_secret_access_witness_test --
// reconciliation, foreign-binding survival, readback discrimination, the role and condition axes,
// conditioned-cell drift, and the principal ceiling. Copying them here as well would be the same
// property asserted in two places, which goes stale in exactly the way §2 describes.
//
// What remains is the fact this module still OWNS: which secret the spark lane wants and under
// which role. That is not covered by the shared file and must not be, because the shared file must
// stay agnostic about who calls it.
import extdeps.cloud.gcp.iam { GcpIamBindingCell, gcp_cell_in, role_secretmanager_secret_accessor }
import gunbc.auth.gcp_secret_access { secret_access_desired_cells }
import gunbc.spark.secret_access_ensure { spark_secret_target, spark_secret_access_grant }
import std.types { String }
import std.logic { Bool }

data convergence_member: String = "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com"

// The ensure must target the exact enrolled secret, not a re-spelled name.
test fn the_ensure_targets_the_enrolled_administrator_secret() -> Bool {
  let t = spark_secret_target()
  t.secret as String == "spark-administrator-password" && t.project as String == "gunbai-secrets"
}

// THE SPARK GRANT IS ACCESSOR AND UNCONDITIONED, asserted on the grant this module hands the shared
// ensure. Now that role and condition are parameters, "which cell does spark ask for" is a fact
// this file owns and a caller could change without touching the reconciler at all -- so a widening
// here, to admin or to a conditioned cell, has to fail a test rather than pass silently.
test fn the_spark_grant_is_the_unconditioned_accessor_cell_on_that_secret() -> Bool {
  let g = spark_secret_access_grant()
  let cells = secret_access_desired_cells(member: convergence_member, grant: g)
  g.role == role_secretmanager_secret_accessor
    && g.target.secret as String == "spark-administrator-password"
    && count(cells) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell {
              role: role_secretmanager_secret_accessor,
              member: convergence_member,
              condition: none
            },
         xs: cells
       )
}
