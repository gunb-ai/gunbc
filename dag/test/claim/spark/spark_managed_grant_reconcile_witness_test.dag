module test.claim.spark_managed_grant_reconcile_witness

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.systemd { systemd_binary_directory }
import gunbc.fleet_posix_accounts { fleet_bootstrap_principal_login }
import extdeps.ethtool { ethtool_binary_directory }
import gunbc.spark.fabric_switch_observed { spark_fabric_leg_netdev }
import gunbc.spark.managed_access_bootstrap {
  SparkManagedGrant,
  ReadFabricModuleEeprom,
  EnableLingerForOwnAccount,
  RebootThisHost,
  InspectServingContainer,
  SparkGrantInstallBasis,
  InstallBasisAbsent,
  OperatorAcceptedUnresolvedDisclosureRisk,
  spark_managed_grant_install_basis,
  spark_install_basis_accepts_risk_for,
  spark_inspect_grant_disclosure_unestablished_obligation,
  spark_managed_grant_population,
  spark_managed_grant_argv,
  spark_managed_grant_sudoers_command,
}
import gunbc.spark.managed_access_bootstrap { GrantEnumerated, GrantAbsent, GrantProbeRefused }
import gunbc.spark.managed_grant_reconcile {
  spark_managed_grant_standing_from_outcome,
  spark_managed_grants_to_install,
  spark_managed_grants_to_install_under,
  spark_managed_grants_withheld,
  spark_managed_grants_withheld_under,
  spark_managed_grants_install_unobserved,
  GrantInstallWithheld,
  GrantInstallAdmitted,
  GrantInstallAdmittedOnAcceptedRisk,
  GrantInstallNotNeeded,
  spark_grant_install_admissions_under,
  spark_grant_install_admission_wire,
  spark_managed_grants_unobserved,
  spark_managed_grants_converged,
  spark_managed_grant_sudoers_content,
  spark_managed_grant_dropin_path,
  spark_managed_grant_report,
  GrantHeld,
  GrantNotHeld,
  GrantStandingUnobserved,
}

// srv6's actual listing shape, and the reason the reboot leg failed: linger is granted, reboot is
// not, and nothing computed the difference.
//
// THESE TWO FIXTURES WERE WRONG, and the way they were wrong is the reason this file needed
// changing. They were written from the model's own sudoers_command rather than captured from a
// host, so they said "/usr/bin/loginctl enable-linger" with no subject -- a line srv5 and srv6 have
// never held. A fixture derived from the thing it is supposed to be an oracle for cannot refute
// that thing; it agrees with it by construction, including when it is wrong. Both now carry the
// line measured on both hosts 2026-08-22 via `sudo -n -l`:
//
//     (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation
data srv6_listing_before: String = "Matching Defaults entries for gunbc-automation on srv6:\n    env_reset\n\nUser gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation\n"

data srv6_listing_after: String = "User gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation\n    (root) NOPASSWD: /usr/bin/systemctl reboot\n"

// AUTHORED, NOT MEASURED. No host holds the container-inspect grant yet (measured 2026-09-13: srv5 and
// srv6 hold linger only), so this listing is the shape sudo would render once the operator installs
// it, spelled independently of the model rather than rendered from spark_managed_grant_sudoers_command.
data srv6_listing_with_inspect: String = "User gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger gunbc-automation\n    (root) NOPASSWD: /usr/bin/systemctl reboot\n    (root) NOPASSWD: /usr/bin/docker container inspect gunbc-spark-pair\n    (root) NOPASSWD: /usr/sbin/ethtool -m enp1s0f1np1 raw on\n    (root) NOPASSWD: /usr/bin/docker container inspect glm-native-tp4\n"

// THE COUNT MOVED WHEN THE DESIRED SET GREW, AND THAT IS THE ASSERTION, NOT A BREAKAGE. The listing
// is a MEASURED fixture -- srv6 holding linger and nothing else -- so it is not edited to keep an old
// number true. The population now carries FIVE grants, so this host is missing reboot, BOTH inspect
// grants and the EEPROM read, and a test that still said "1" would be asserting the population had
// not changed while it had. What stays discriminating is the same thing it always was: linger is held,
// so linger is never in the install set.
test fn a_listing_naming_only_linger_puts_reboot_in_the_install_set() -> Bool {
  let missing = spark_managed_grants_to_install(outcome: GrantEnumerated { listing: srv6_listing_before })
  missing.length() == 4
    && any(missing, m => match m {
         RebootThisHost => true
         EnableLingerForOwnAccount { subject: _ } => false
         InspectServingContainer { container: _ } => false
         ReadFabricModuleEeprom { device: _ } => false
       })
    && any(missing, m => match m {
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
         InspectServingContainer { container: _ } => false
         ReadFabricModuleEeprom { device: d } => d as String == spark_fabric_leg_netdev as String
       })
    && !any(missing, m => match m {
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => true
         InspectServingContainer { container: _ } => false
         ReadFabricModuleEeprom { device: _ } => false
       })
    && all(filter(missing, m => match m {
         InspectServingContainer { container: _ } => true
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
         ReadFabricModuleEeprom { device: _ } => false
       }), m => match m {
         InspectServingContainer { container: c } =>
           c as String == "gunbc-spark-pair" || c as String == "glm-native-tp4"
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
         ReadFabricModuleEeprom { device: _ } => false
       })
}

// THE DISCRIMINATING PAIR. The same function over the same shape of input answers differently once
// the grant is present, which is what makes it a reconcile rather than a constant.
test fn the_same_listing_with_reboot_added_installs_nothing() -> Bool {
  spark_managed_grants_to_install(outcome: GrantEnumerated { listing: srv6_listing_with_inspect }).length() == 0
    && spark_managed_grants_converged(outcome: GrantEnumerated { listing: srv6_listing_with_inspect })
    && !spark_managed_grants_converged(outcome: GrantEnumerated { listing: srv6_listing_before })
}

// THE HOSTS AS THEY STAND TODAY ARE NOT CONVERGED, and they are missing TWO grants: inspect, the
// access capability the live serving readers wait on, and the fabric EEPROM read the 100G question
// waits on. The name says two because it is two; a test named for one grant while asserting over a
// set of two is the kind of stale sentence a rename leaves behind.
test fn the_measured_hosts_are_missing_inspect_and_the_eeprom_read() -> Bool {
  let missing = spark_managed_grants_to_install_under(
    outcome: GrantEnumerated { listing: srv6_listing_after },
    basis: fixture_accepted_risk(),
  )
  missing.length() == 2
    && all(missing, m => match m {
         InspectServingContainer { container: c } => c as String == "gunbc-spark-pair"
         ReadFabricModuleEeprom { device: d } => d as String == spark_fabric_leg_netdev as String
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
       })
    && !spark_managed_grants_converged(outcome: GrantEnumerated { listing: srv6_listing_after })
}

// Sudo demanding a password IS the answer "none", successfully obtained, so every desired grant is
// missing and the remedy is to install them. The install set alone no longer accounts for the
// population now that inspect grants are basis-gated: under a fixture basis naming only the pair
// container, the native arm's inspect grant is missing AND withheld, so installed + withheld -- not
// installed alone -- is the whole population.
test fn a_password_demand_is_an_observation_that_no_grant_is_held() -> Bool {
  let o = GrantAbsent { detail: "exit=1 stderr=sudo: a password is required" }
  spark_managed_grants_to_install_under(
    outcome: o,
    basis: fixture_accepted_risk(),
  ).length() + spark_managed_grants_withheld_under(outcome: o, basis: fixture_accepted_risk()).length()
      == spark_managed_grant_population.length()
    && spark_managed_grants_unobserved(outcome: o).length() == 0
}

// THE ARM THAT KEEPS IGNORANCE OUT OF THE INSTALL SET, and the reason the standing is three-way. A
// probe that failed for any other reason must not be read as "no grants held" -- installing sudoers
// entries on a host we could not measure is actuating on ignorance, and it is the exact shape of the
// absorbing fallback the repo forbids.
test fn a_probe_that_failed_for_another_reason_installs_nothing() -> Bool {
  let o = GrantAbsent { detail: "exit=255 stderr=ssh: connect to host srv6 port 22: No route to host" }
  spark_managed_grants_to_install(outcome: o).length() == 0
    && spark_managed_grants_unobserved(outcome: o).length() == spark_managed_grant_population.length()
    && !spark_managed_grants_converged(outcome: o)
}

// A refused leg is unobserved for the same reason, on a different channel.
test fn a_refused_probe_leg_is_unobserved_and_never_converged() -> Bool {
  let o = GrantProbeRefused { cause: "non-portable-remote-word" }
  spark_managed_grants_to_install(outcome: o).length() == 0
    && !spark_managed_grants_converged(outcome: o)
}

// AN EMPTY INSTALL LIST IS NOT CONVERGENCE. A fully unobserved host produces one, and reading it as
// "nothing to do" is the empty-observation narrow: the run would report a host needing no work
// precisely when it learned nothing about it.
test fn nothing_to_install_does_not_imply_converged() -> Bool {
  let unobserved = GrantProbeRefused { cause: "leg refused" }
  spark_managed_grants_to_install(outcome: unobserved).length() == 0
    && !spark_managed_grants_converged(outcome: unobserved)
    && spark_managed_grants_converged(outcome: GrantEnumerated { listing: srv6_listing_with_inspect })
}

// The subject the live hosts actually grant. Named once so the assertions below join against one
// value rather than each re-spelling the login.
fn linger_grant() -> SparkManagedGrant {
  EnableLingerForOwnAccount { subject: "gunbc-automation" as NonEmptyStr }
}

// THE LINE THIS REPOSITORY WOULD INSTALL, held against the line srv5 and srv6 ACTUALLY HOLD,
// captured 2026-08-22 by `sudo -n -l` as the grantee. This is the oracle the old test lacked: an
// independently observed string, not a second reading of the model.
data measured_installed_linger_command: String = "/usr/bin/loginctl enable-linger gunbc-automation"
data measured_installed_reboot_command: String = "/usr/bin/systemctl reboot"
// Authored from docs.docker.com/reference/cli/docker/container/inspect/ and the container name the
// pair realization creates; not yet measured on a host, because no host holds it.
data authored_inspect_command: String = "/usr/bin/docker container inspect gunbc-spark-pair"

// THE OLD TEST HERE WAS VACUOUS AND ITS NAME CLAIMED OTHERWISE. It asserted
//
//     any(spark_managed_grant_argv(grant: g).skip(n: 2), w => string_contains(command, w))
//
// under the name the_sudoers_line_authorizes_exactly_the_argv_the_actuator_runs. An ANY over
// substring containment: "loginctl" is inside "/usr/bin/loginctl enable-linger", so it passed. It
// would have passed with the argv truncated to [sudo, -n, loginctl], with a bogus word appended, and
// -- as it did for however long it stood -- with the subject account missing from both sides while
// the hosts required it. "Exactly" was a word in an identifier over a body asserting almost nothing.
//
// The replacement joins at ARGV GRAIN and against the MEASURED line: every word of the argv after
// `sudo -n` must appear in the command in order, and the command must equal what the host holds.
test fn the_sudoers_command_equals_the_line_the_hosts_actually_hold() -> Bool {
  spark_managed_grant_sudoers_command(grant: linger_grant()) as String == measured_installed_linger_command
    && spark_managed_grant_sudoers_command(grant: RebootThisHost) as String == measured_installed_reboot_command
    && spark_managed_grant_sudoers_command(grant: InspectServingContainer { container: "gunbc-spark-pair" as NonEmptyStr }) as String == authored_inspect_command
}

// THE INSPECT GRANT IS ONE VERB ON ONE OBJECT. The discriminating inputs are the widenings a later
// edit would reach for: another verb, and a name wildcard. Neither may equal the derived command.
test fn the_inspect_grant_names_no_other_verb_and_no_wildcard() -> Bool {
  let c = spark_managed_grant_sudoers_command(grant: InspectServingContainer { container: "gunbc-spark-pair" as NonEmptyStr }) as String
  c != "/usr/bin/docker container inspect *"
    && c != "/usr/bin/docker container exec gunbc-spark-pair"
    && c != "/usr/bin/docker ps"
    && !string_contains(c, "*")
}

// THE ARGV AND THE COMMAND ARE THE SAME WORDS, asserted as an equality over the word list rather
// than as containment. The argv is `sudo -n <words>`; the command is those same <words> with the
// binary made absolute. Reconstructing one from the other and comparing is what the old ANY could
// not do.
test fn the_sudoers_line_authorizes_exactly_the_argv_the_actuator_runs() -> Bool {
  fold(spark_managed_grant_population, init: true, f: fn(acc, g) {
    let words = spark_managed_grant_argv(grant: g).skip(n: 2)
    let command = spark_managed_grant_sudoers_command(grant: g) as String
    let content = spark_managed_grant_sudoers_content(grant: g)
    acc
      && spark_managed_grant_argv(grant: g).length() == words.length() + 2
      && command == match g {
           EnableLingerForOwnAccount { subject: _ } => concat(systemd_binary_directory as String, concat("/", join(words, " ")))
           RebootThisHost => concat(systemd_binary_directory as String, concat("/", join(words, " ")))
           InspectServingContainer { container: _ } => join(words, " ")
           ReadFabricModuleEeprom { device: _ } => concat(ethtool_binary_directory as String, concat("/", join(words, " ")))
         }
      && string_contains(content, "gunbc-automation ALL=(root) NOPASSWD: ")
      && string_contains(content, command)
  })
}

// THE DISCRIMINATING RED. The pre-change spelling -- the subject dropped from the command -- must
// FAIL the assertion above. Without this the new test could be as vacuous as the one it replaces and
// nothing would say so: a test that greens a correct change is indistinguishable from one that
// greens the next wrong change unless a known-wrong input is shown to red it.
test fn the_pre_change_spelling_without_the_subject_is_refused() -> Bool {
  let pre_change = "/usr/bin/loginctl enable-linger"
  pre_change != measured_installed_linger_command
    && !string_contains(pre_change, "gunbc-automation")
    && spark_managed_grant_sudoers_command(grant: linger_grant()) as String != pre_change
}

// AND THE MIRROR OF IT ON THE ARGV, because the two halves of the fork failed differently: the
// command dropped the subject, the argv dropped the subject AND the absolute path. An argv that
// cannot execute under the installed grant must not be derivable.
test fn the_derived_argv_carries_the_subject_the_grant_requires() -> Bool {
  join(spark_managed_grant_argv(grant: linger_grant()), " ")
    == "sudo -n loginctl enable-linger gunbc-automation"
    && join(spark_managed_grant_argv(grant: RebootThisHost), " ") == "sudo -n systemctl reboot"
    && join(spark_managed_grant_argv(grant: InspectServingContainer { container: "gunbc-spark-pair" as NonEmptyStr }), " ")
      == "sudo -n /usr/bin/docker container inspect gunbc-spark-pair"
    && join(spark_managed_grant_argv(grant: ReadFabricModuleEeprom { device: spark_fabric_leg_netdev }), " ")
      == "sudo -n ethtool -m enp1s0f1np1 raw on"
    && spark_managed_grant_sudoers_command(grant: ReadFabricModuleEeprom { device: spark_fabric_leg_netdev }) as String
      == "/usr/sbin/ethtool -m enp1s0f1np1 raw on"
}

// THE DISCRIMINATING RED FOR THE PATH, and it is not hypothetical: /usr/bin is where this repository
// already declares systemd's clients live, so borrowing that row for ethtool was the available
// mistake. sudo matches a Cmnd_Spec on the RESOLVED path, so a grant written at /usr/bin/ethtool
// authorizes nothing on a host where the binary is at /usr/sbin -- it installs clean, lists clean,
// and refuses at the one moment it is needed. This asserts the two directories are not the same and
// that the derived command takes ethtool's.
test fn the_eeprom_grant_does_not_borrow_systemd_binary_directory() -> Bool {
  ethtool_binary_directory as String != systemd_binary_directory as String
    && !string_contains(
         spark_managed_grant_sudoers_command(grant: ReadFabricModuleEeprom { device: spark_fabric_leg_netdev }) as String,
         concat(systemd_binary_directory as String, "/ethtool"),
       )
}

// Narrow on every axis sudoers offers. A wildcard command would make the population decorative,
// since one entry would then authorize everything the others name.
test fn no_grant_is_written_as_a_wildcard() -> Bool {
  fold(spark_managed_grant_population, init: true, f: fn(acc, g) {
    acc && !string_contains(spark_managed_grant_sudoers_content(grant: g), "ALL\n")
        && !string_contains(spark_managed_grant_sudoers_content(grant: g), "NOPASSWD: ALL")
  })
}

// Distinct files per grant: appending to one file has no idempotent form, so a second reconcile run
// would differ from the first.
test fn each_grant_lands_in_its_own_dropin_file() -> Bool {
  spark_managed_grant_dropin_path(grant: RebootThisHost) as String
    != spark_managed_grant_dropin_path(grant: linger_grant()) as String
    && string_contains(spark_managed_grant_dropin_path(grant: RebootThisHost) as String, "/etc/sudoers.d/")
}

// The report names the gap and its remedy in the same line, because the failure this replaces said
// only "a password is required" -- naming neither the grant nor where it goes.
test fn the_report_names_the_missing_grant_and_where_it_goes() -> Bool {
  let text = spark_managed_grant_report(host: "srv6", outcome: GrantEnumerated { listing: srv6_listing_before })
  string_contains(text, "converged=false")
    && string_contains(text, "standing=not-held")
    && string_contains(text, "/etc/sudoers.d/gunbc-reboot")
    && string_contains(text, "standing=held")
}

test fn a_held_grant_reports_held_rather_than_silence() -> Bool {
  match spark_managed_grant_standing_from_outcome(
    grant: linger_grant(),
    outcome: GrantEnumerated { listing: srv6_listing_before },
  ) {
    GrantHeld { grant: _ } => true
    GrantNotHeld { grant: _ } => false
    GrantStandingUnobserved { grant: _, cause: _ } => false
  }
}

// THE PREFIX-BLINDNESS THE SUBSTRING JOIN ADMITTED, as an executing refusal rather than a claim.
//
// This listing authorizes a WIDER grant than the population desires: the entry ends in a subject
// the desired command does not name, so the host holds more privilege than the model asked for.
// `string_contains(listing, "/usr/bin/loginctl enable-linger")` is TRUE over it -- the desired
// command is a proper prefix of the installed one -- so the join this PR replaces reported
// converged and named nothing. The entry-grained join answers not-held, which is the honest
// answer: what is installed is not what was modeled.
//
// This is the discriminating RED for the change. Restoring the substring join turns this test
// green, which is the only reason it can be trusted to be measuring the fix.
data srv6_listing_wider_than_desired: String = "User gunbc-automation may run the following commands on srv6:\n    (root) NOPASSWD: /usr/bin/loginctl enable-linger some-other-account\n"

//
// IT ASSERTS THE INSTALL-SET SIZE, NOT CONVERGENCE, and the difference is the whole test. An
// earlier draft asserted `!converged` over this listing and was VACUOUS: the fixture names no
// reboot entry, so the reboot grant is unheld under either join and convergence is false whichever
// way the linger question is answered. The mutation control proved it -- restoring the substring
// join left the test GREEN, so it was measuring the reboot grant's absence and nothing about the
// change it was written for. Counting the install set isolates the one grant whose standing the
// two joins disagree about. The figures move with the population and are stated at its CURRENT size
// rather than left at the pair they were written for: the population is five grants, this listing
// holds none of them, so the entry-grained join answers 5 and the substring join answers 4 -- linger
// wrongly held because the desired command is a proper prefix of the installed one. What matters is
// that the two answers still DIFFER by exactly the grant under test; the absolute numbers are a
// consequence of how many grants the population carries and carry no meaning of their own.
test fn an_entry_that_merely_starts_with_the_desired_command_is_not_that_grant() -> Bool {
  spark_managed_grants_to_install(outcome: GrantEnumerated { listing: srv6_listing_wider_than_desired }).length() == 5
}

// A BANNER LINE CONTRIBUTES NOTHING RATHER THAN A NEGATIVE VOTE. The listing's prose header names
// the account and the host and carries no `NOPASSWD:` marker, so it yields no command at all -- the
// join skips it instead of counting it as an entry that failed to match.
test fn the_listing_banner_is_not_read_as_an_entry() -> Bool {
  spark_managed_grants_converged(outcome: GrantEnumerated { listing: srv6_listing_with_inspect })
    && !spark_managed_grants_converged(outcome: GrantEnumerated { listing: "User gunbc-automation may run the following commands on srv6:\n" })
}

// THE ORDERING WITNESS. It is RED on this branch by construction and that is its whole function.
//
// The exactness fix above and the grant-spelling correction in gunbc#8860 are two defects that
// CANCEL. Today the modeled linger command omits the subject the hosts actually hold, and the
// substring join is the only reason that mismatch does not surface: `/usr/bin/loginctl
// enable-linger` is a substring of the installed `/usr/bin/loginctl enable-linger
// gunbc-automation`, so the grant reads HELD despite the model naming a different command. Make
// the join exact FIRST and the linger grant reads NOT-HELD on two converged live hosts, and the
// remedy the reconcile reports is to install a grant that is already there.
//
// So the order is load-bearing: #8860's spelling must land before this join tightens. A note in a
// PR body cannot enforce that -- it depends on a human merging two PRs in one direction -- so the
// constraint is executed instead. This asserts the modeled command is BYTE-EQUAL to the line
// measured on srv5 and srv6, which is false until #8860 merges and true after. Merging this branch
// first therefore cannot go green.
//
// It is not written against #8860's variant shape, deliberately: it reads only the population's
// rendered command strings, so it compiles identically before and after that PR and measures the
// one fact the ordering depends on.

test fn the_modeled_linger_command_is_byte_equal_to_the_line_the_hosts_hold() -> Bool {
  any(spark_managed_grant_population, g =>
    spark_managed_grant_sudoers_command(grant: g) as String == measured_installed_linger_command)
}

// A MULTI-COMMAND ENTRY LINE, which sudo renders comma-separated for one Cmnd_Spec. MEASURED on
// both live hosts 2026-08-22: each grant is its own drop-in and so its own line, so this shape does
// not occur on srv5 or srv6 today. It is covered because it is a shape sudo MAY emit, and reading
// such a line as one command would match neither grant it names -- convergence would never complete
// on a host that plainly holds both, and the diagnostic would report grants missing that are
// visibly present.
//
// THE FIXTURE IS BUILT FROM THE POPULATION, NOT HAND-SPELLED, and that is what keeps this test
// about the PARSE. A hand-written line has to pick a spelling, and the linger spelling is exactly
// what gunbc#8860 changes -- so the first draft of this test hardcoded the post-#8860 command and
// returned FALSE here, reporting a comma-splitting defect when what it had actually measured was
// the subject's absence from today's modeled command. Two ordering-dependent tests where one was
// intended, and the second one lying about which axis it failed on.
//
// Rendering the line from `spark_managed_grant_sudoers_command` makes it agree with the model on
// spelling BY CONSTRUCTION -- normally the thing that disqualifies a fixture, since one that agrees
// by construction cannot falsify what it renders from. It is right here because the spelling axis
// is OWNED BY ANOTHER TEST in this file, `the_modeled_linger_command_is_byte_equal_to_the_line_the
// _hosts_hold`, which pins the modeled command against a line measured on srv5 and srv6. This test
// owns only the entry-splitting axis. Do not "fix" this back into a hand-spelled literal: that
// silently restores the two-axis failure and makes a parse test fail for a spelling reason. What it still discriminates is its own axis: drop the
// comma split and the line reads as one command, neither grant matches, and the install set is 2
// rather than 0.
fn spark_grant_line_naming_every_grant_on_one_line() -> String {
  join(
    ["    (root) NOPASSWD: ",
     join(map(spark_managed_grant_population, g => spark_managed_grant_sudoers_command(grant: g) as String), ", "),
     "\n"],
    "")
}

test fn two_commands_on_one_entry_line_are_two_grants() -> Bool {
  spark_managed_grants_to_install(
    outcome: GrantEnumerated { listing: spark_grant_line_naming_every_grant_on_one_line() }
  ).length() == 0
}

// A FIXTURE DECISION, never a real one: it exists only to show the accepted-risk arm admits.
fn fixture_accepted_risk() -> List<SparkGrantInstallBasis> {
  [OperatorAcceptedUnresolvedDisclosureRisk {
    actor: "fixture" as NonEmptyStr,
    decided_on: "1970-01-01" as NonEmptyStr,
    accepted_for: InspectServingContainer { container: "gunbc-spark-pair" as NonEmptyStr },
  }]
}

// THE RED: WITH NO PRECONDITION, THE INSPECT GRANT IS NOT IN THE INSTALL SET, over the measured
// listing where it is the one grant not held. It is reported withheld with its typed cause and the
// host stays unconverged. Merging the grant installs nothing by itself. This control is driven with
// an explicit absent basis: the production row carried InstallBasisAbsent until the operator's
// 2026-09-14 acceptance, and the production half of this witness moved to
// the_production_basis_admits_inspect_on_accepted_risk below when that row changed.
//
// IT ALSO EXERCISES THE FAIL-CLOSED REFUSAL RENDERING. spark_managed_grant_report resolves the basis
// from the production row, which is now an acceptance, so its "install=withheld" arm is no longer
// reached through the report -- and that arm is the refusal wire any FUTURE data-bearing grant with
// no acceptance falls to. So the wire is driven here directly under the absent basis, keeping its RED
// enrolled per DESIGN 4b(4) rather than leaving it specification-without-execution (review 66129).
test fn without_an_install_basis_inspect_is_withheld_while_the_spec_bounded_read_installs() -> Bool {
  let o = GrantEnumerated { listing: srv6_listing_after }
  spark_managed_grants_to_install_under(outcome: o, basis: [InstallBasisAbsent]).length() == 1
    && all(spark_managed_grants_to_install_under(outcome: o, basis: [InstallBasisAbsent]), g => match g {
         ReadFabricModuleEeprom { device: d } => d as String == spark_fabric_leg_netdev as String
         InspectServingContainer { container: _ } => false
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
       })
    && all(spark_managed_grants_withheld_under(outcome: o, basis: [InstallBasisAbsent]), w => match w {
         GrantInstallWithheld { grant: g, obligation: ob } =>
           ob as String == spark_inspect_grant_disclosure_unestablished_obligation as String
             && match g {
                  InspectServingContainer { container: _ } => true
                  RebootThisHost => false
                  EnableLingerForOwnAccount { subject: _ } => false
                  ReadFabricModuleEeprom { device: _ } => false
                }
         GrantInstallAdmittedOnAcceptedRisk { grant: _, obligation: _, basis: _ } => false
         GrantInstallAdmitted { grant: _ } => false
         GrantInstallStandingUnobserved { grant: _, cause: _ } => false
         GrantInstallNotNeeded => false
       })
    && spark_managed_grants_withheld_under(outcome: o, basis: [InstallBasisAbsent]).length() == 2
    && !spark_managed_grants_converged(outcome: o)
    && any(
         flat_map(spark_grant_install_admissions_under(outcome: o, basis: [InstallBasisAbsent]), a => spark_grant_install_admission_wire(a: a)),
         line => string_contains(line, "install=withheld disclosure=unestablished cause="),
       )
}

// THE PRODUCTION ROWS AFTER THE OPERATOR'S ACCEPTANCES. Over the measured listing both inspect grants
// are now IN the install set through the production basis -- the pair container's on the 2026-09-14
// acceptance, the native arm's on the 2026-09-16 acceptance -- each admitted on accepted risk with the
// disclosure obligation still attached, and nothing is withheld. The spec-bounded EEPROM read needs no
// acceptance and installs beside them. The actor is the operator's fleet
// login and each decision names its container, so the rows are attributable and scoped.
test fn the_production_basis_admits_inspect_on_accepted_risk() -> Bool {
  let o = GrantEnumerated { listing: srv6_listing_after }
  let installing = spark_managed_grants_to_install(outcome: o)
  installing.length() == 3
    && all(installing, g => match g {
         InspectServingContainer { container: c } =>
           c as String == "gunbc-spark-pair" || c as String == "glm-native-tp4"
         ReadFabricModuleEeprom { device: d } => d as String == spark_fabric_leg_netdev as String
         RebootThisHost => false
         EnableLingerForOwnAccount { subject: _ } => false
       })
    && spark_managed_grants_withheld(outcome: o).length() == 0
    && all(spark_grant_install_admissions_under(outcome: o, basis: spark_managed_grant_install_basis), a => match a {
         GrantInstallAdmittedOnAcceptedRisk { grant: _, obligation: ob, basis: b } =>
           ob as String == spark_inspect_grant_disclosure_unestablished_obligation as String
             && match b {
                  OperatorAcceptedUnresolvedDisclosureRisk { actor: who, decided_on: _, accepted_for: _ } =>
                    who as String == fleet_bootstrap_principal_login() as String
                  InstallBasisAbsent => false
                }
         GrantInstallAdmitted { grant: _ } => true
         GrantInstallWithheld { grant: _, obligation: _ } => false
         GrantInstallStandingUnobserved { grant: _, cause: _ } => false
         GrantInstallNotNeeded => true
       })
    && any(spark_grant_install_admissions_under(outcome: o, basis: spark_managed_grant_install_basis), a => match a {
         GrantInstallAdmittedOnAcceptedRisk { grant: InspectServingContainer { container: c }, obligation: _, basis: b } =>
           c as String == "glm-native-tp4" && match b {
             OperatorAcceptedUnresolvedDisclosureRisk { actor: _, decided_on: when, accepted_for: _ } => when as String == "2026-09-16"
             InstallBasisAbsent => false
           }
         _ => false
       })
    && string_contains(spark_managed_grant_report(host: "srv6", outcome: o), "install=admitted-on-accepted-risk")
}

// THE ACCEPTANCE DOES NOT WIDEN. The production basis names one grant; a data-bearing grant it does not
// name -- the same verb over a different container -- is not accepted by it, so a future grant row
// cannot ride in on this decision.
test fn the_production_basis_accepts_no_grant_it_does_not_name() -> Bool {
  spark_install_basis_accepts_risk_for(
    basis: spark_managed_grant_install_basis,
    grant: InspectServingContainer { container: "some-other-container" as NonEmptyStr },
  ) == false
    && spark_install_basis_accepts_risk_for(
         basis: spark_managed_grant_install_basis,
         grant: InspectServingContainer { container: "gunbc-spark-pair" as NonEmptyStr },
       )
}

// THE PRECONDITION IS THE ONLY THING THAT MOVES IT, and it does not move the dataless grants: from the
// same listing, an operator acceptance admits inspect, while reboot is admitted either way.
test fn an_accepted_risk_admits_inspect_and_leaves_dataless_grants_unconditional() -> Bool {
  let o = GrantEnumerated { listing: srv6_listing_before }
  spark_managed_grants_to_install_under(outcome: o, basis: [InstallBasisAbsent]).length() == 2
    && spark_managed_grants_to_install_under(
         outcome: o,
         basis: fixture_accepted_risk(),
       ).length() == 3
}

// THE TWO AXES STAY TWO. Accepting the risk admits the install but does not classify anything: the
// admission still carries the disclosure obligation, and the report says the grant was admitted with the
// disclosure unestablished rather than reading as if the knowledge wall came down.
test fn accepted_risk_admits_the_install_and_keeps_the_obligation_outstanding() -> Bool {
  let o = GrantEnumerated { listing: srv6_listing_after }
  any(spark_grant_install_admissions_under(outcome: o, basis: fixture_accepted_risk()), a => match a {
    GrantInstallAdmittedOnAcceptedRisk { grant: _, obligation: ob, basis: _ } =>
      ob as String == spark_inspect_grant_disclosure_unestablished_obligation as String
    GrantInstallAdmitted { grant: _ } => false
    GrantInstallWithheld { grant: _, obligation: _ } => false
    GrantInstallStandingUnobserved { grant: _, cause: _ } => false
    GrantInstallNotNeeded => false
  })
    && spark_managed_grants_withheld_under(outcome: o, basis: fixture_accepted_risk()).length() == 1
}

// ACCEPTANCE IS SCOPED TO THE GRANT IT NAMES. A basis naming a different container admits nothing.
// THE COUNT WAS STANDING IN FOR AN IDENTITY, AND THE POPULATION GROWING EXPOSED IT. This claim is
// that a basis naming ANOTHER container admits no inspect grant; `length() == 0` said that only while
// inspect was the sole basis-gated grant in the population, so adding one unrelated grant that needs
// no basis turned a true claim red without the property it names having changed. Asserting the
// identity says what was meant and stays true as the population grows -- completeness is an identity
// join, not a count equality.
test fn accepted_risk_for_another_container_does_not_admit_inspect() -> Bool {
  let installing = spark_managed_grants_to_install_under(
    outcome: GrantEnumerated { listing: srv6_listing_after },
    basis: [OperatorAcceptedUnresolvedDisclosureRisk {
      actor: "fixture" as NonEmptyStr,
      decided_on: "1970-01-01" as NonEmptyStr,
      accepted_for: InspectServingContainer { container: "some-other-container" as NonEmptyStr },
    }],
  )
  !any(installing, g => match g {
    InspectServingContainer { container: _ } => true
    RebootThisHost => false
    EnableLingerForOwnAccount { subject: _ } => false
    ReadFabricModuleEeprom { device: _ } => false
  })
}

// HELD AND UNREAD DO NOT SHARE AN ARM. A refused probe leg admits every grant as standing-unobserved,
// while a listing that names every grant admits none that way: the verdict can tell them apart.
test fn an_unread_standing_is_its_own_admission_and_not_nothing_needed() -> Bool {
  spark_managed_grants_install_unobserved(outcome: GrantProbeRefused { cause: "leg refused" }).length()
      == spark_managed_grant_population.length()
    && spark_managed_grants_install_unobserved(outcome: GrantEnumerated { listing: srv6_listing_with_inspect }).length() == 0
}
