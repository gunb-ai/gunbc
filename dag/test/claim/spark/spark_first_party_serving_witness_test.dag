module test.claim.spark.spark_first_party_serving_witness_test

import std.types { Bool, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.content_hash { as_content_hash_structural, content_hash_atom }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey }
import product.fabric.provider_route { CompliancePostureRevision }
import product.fabric.provider_admission {
  ProviderUseScope, ProviderUseAdmission, ProviderUseAdmitted, ProviderUseDenied,
  DispositionStanding, DispositionCleared, DispositionNotEngaged,
  DispositionRefused, DispositionUnresolved,
  refusal_reason, admit_provider_use,
}
import extdeps.vllm.usage_stats {
  VllmUsageStatsLaunchStanding, UsageStatsDisabledByLaunch, UsageStatsEnabledByDefault,
  UsageStatsLaunchUnread,
}
import product.placement_supply { HostIdentity }
import std.measure { token_count }
import v2.std.optional { Present, Absent }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv5, operator_host_srv6 }
import gunbc.spark.pair_serving_realization {
  spark_pair_model_path_in_container, spark_pair_desired_snapshot,
}
import gunbc.spark.vllm_observed {
  VllmModelsRouteReadbackStanding, ModelsRouteRead, ModelsRouteDocumentUnreadable,
  vllm_models_route_readback,
}
import gunbc.spark.first_party_serving {
  SparkServingRealization, spark_serving_usage_stats_standing,
  spark_first_party_use_scope, spark_first_party_admission,
  spark_first_party_sanction_roster, spark_first_party_route_facts, spark_first_party_posture,
  spark_sanctions_disposition, spark_export_disposition, spark_prohibited_use_disposition,
}

// WHAT THESE ROWS ARE FOR. gunbc.spark.first_party_serving admits exactly one use of the Spark
// serving route -- gunbc serving gunbc, on our own material, on operator-owned hardware -- and the
// operator's assertion behind it is explicitly "for now". "For now" is only worth writing down if
// something EXECUTES it, so the refusal rows below are the substance of this file and the admitted
// row is the control that stops them from being satisfied by a producer that refuses everything.

fn t_demand() -> FabricIdentity<NonEmptyStr, DemandKey> {
  FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "harness-turn-demand-1" as DemandKey }
}

fn t_work() -> FabricIdentity<NonEmptyStr, WorkKey> {
  FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "harness-turn-work-1" as WorkKey }
}

fn t_offer() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "group-a@http://192.168.1.225:30000@1" as OfferKey }
}

// THE THIRD-PARTY SCOPE IS THE SAME SCOPE WITH ONE FIELD CHANGED, which is what makes the refusal
// below discriminating: it differs from the admitted scope ONLY in who the customer is, so a
// producer that admitted it would be admitting a customer profile no posture sanctions.
fn t_third_party_profile() -> DeclarationRef {
  decl_ref(module_path: "test.claim.spark.spark_first_party_serving_witness_test", decl_name: "t_third_party_profile")
}

fn t_third_party_scope() -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: t_demand(),
    work: t_work(),
    customer_profile: t_third_party_profile(),
    data_handling_profile: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_own_data_handling_profile"),
    agreement: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_operator_owned_hardware_agreement"),
    prohibited_use_disposition: spark_prohibited_use_disposition(),
    sanctions_disposition: spark_sanctions_disposition(),
    export_disposition: spark_export_disposition(),
  }
}

// THE REALIZATION THAT ANSWERED IS NOW PART OF EVERY SUBJECT, because the route facts are about the
// deployment being offered rather than about a declaration. The pair-serving fixture is the one the
// site allocation covers and whose container environment this module models; the foreign one differs
// in the single field that decides attribution -- the model path the running engine reported.
fn t_readback(path: String) -> VllmModelsRouteReadbackStanding {
  ModelsRouteRead {
    readback: vllm_models_route_readback(
      served_model_id: "deepseek-v4-flash:iq3s-split" as NonEmptyStr,
      configured_model_path: path as NonEmptyStr,
      max_model_len: token_count(count: 1048576)),
  }
}

// THE DECLARED PATH IS TAKEN FROM THE SAME PRODUCER THE MODULE COMPARES AGAINST, never transcribed.
// A literal here would pass whatever the pinned snapshot became, which is the fixture agreeing with
// itself rather than with the launch.
fn t_declared_path() -> String {
  match spark_pair_model_path_in_container(snapshot: spark_pair_desired_snapshot) {
    Present { value: p } => p
    Absent => ""
  }
}

fn t_pair_realization() -> SparkServingRealization {
  SparkServingRealization {
    hosts: [operator_host_srv5, operator_host_srv6],
    readback: t_readback(path: t_declared_path()),
  }
}

// THE FOREIGN DEPLOYMENT DIFFERS IN WHAT THE RUNNING ENGINE REPORTED, not in where it answered. An
// earlier spelling discriminated on the PORT, which review 64424 correctly refused: a replacement
// engine on the same port would inherit an environment nothing observed it to have.
fn t_foreign_realization() -> SparkServingRealization {
  SparkServingRealization {
    hosts: [operator_host_srv5, operator_host_srv6],
    readback: t_readback(path: "/weights/models--zai-org--GLM-5.3-Flash/snapshots/eb9eb208eb0d988989d07a6a12d0fdeb5f52574a"),
  }
}

// POSITIVE CONTROL. The first-party scope admits, and the permit carries the route and posture it
// was admitted under rather than merely existing.
test fn the_first_party_scope_admits_and_the_permit_names_its_posture() -> Bool {
  match spark_first_party_admission(
    realization: t_pair_realization(),
    scope: spark_first_party_use_scope(demand: t_demand(), work: t_work()),
    offer: t_offer(),
  ) {
    ProviderUseDenied { decision: _, cause: _ } => false
    ProviderUseAdmitted { permit: p } =>
      declaration_ref_eq(a: p.route.region, b: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_fleet_site_allocation"))
        && declaration_ref_eq(a: p.posture.authority, b: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_first_party_use_posture"))
  }
}

// THE STOP CONDITION, EXECUTED, AND IT ASSERTS THE ARM RATHER THAN THE REFERENCE. Review 63981 is
// right about why that distinction is the whole test: a row comparing only a DeclarationRef says
// which declaration was cited, not what was CLAIMED, so editing the cited row's text into a real
// clearance would leave it green. Matching DispositionNotEngaged cannot be satisfied that way --
// a permit admitted on a clearance takes the other arm and this goes red -- which is what makes it
// a wall rather than a name check.
fn t_not_engaged_naming(d: DispositionStanding, basis_decl: NonEmptyStr) -> Bool {
  match d {
    DispositionNotEngaged { basis: b } =>
      declaration_ref_eq(a: b, b: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: basis_decl as String))
    DispositionCleared { evidence: _ } => false
    DispositionRefused { cause: _ } => false
    DispositionUnresolved { obligation: _ } => false
  }
}

test fn every_use_program_is_not_engaged_and_names_its_basis() -> Bool {
  match spark_first_party_admission(
    realization: t_pair_realization(),
    scope: spark_first_party_use_scope(demand: t_demand(), work: t_work()),
    offer: t_offer(),
  ) {
    ProviderUseDenied { decision: _, cause: _ } => false
    ProviderUseAdmitted { permit: p } =>
      t_not_engaged_naming(d: p.evidence.sanctions_standing, basis_decl: "spark_sanctions_not_engaged" as NonEmptyStr)
        && t_not_engaged_naming(d: p.evidence.export_standing, basis_decl: "spark_export_not_engaged" as NonEmptyStr)
        && t_not_engaged_naming(d: p.evidence.prohibited_use_standing, basis_decl: "spark_prohibited_use_not_engaged" as NonEmptyStr)
  }
}

// THE ARM IS READ THROUGH refusal_reason, WHICH IS THE MODULE'S OWN EXHAUSTIVE DERIVATION, rather
// than through a ten-arm match copied into this file. A second copy of that match is the same
// coproduct restated in a test, and it rots the day an arm is added; refusal_reason is derived from
// the cause by an exhaustive match in the module that owns it, so a new arm forces an edit there.
// What it costs is the payload -- these rows assert WHICH arm refused, not what it carried -- and
// that is enough here, because each red below differs from the admitted control in exactly one
// input, so no other arm can produce it.

// RED -- "IT IS JUST SERVING US FOR NOW" IS ENFORCED BY EXECUTION. A use whose customer is anybody
// but us reaches the same producer and is refused, and the refusal names the unsupported profile so
// the remedy is the right one: get that profile sanctioned under a posture, not widen this one.
test fn a_non_first_party_use_refuses_as_unsupported() -> Bool {
  match spark_first_party_admission(realization: t_pair_realization(), scope: t_third_party_scope(), offer: t_offer()) {
    ProviderUseAdmitted { permit: _ } => false
    ProviderUseDenied { decision: _, cause: c } => refusal_reason(c: c) == "customer scope unsupported"
  }
}

// RED -- RE-POSTURING MAKES THE STANDING SANCTION STALE RATHER THAN CARRYING IT OVER. This is the
// other half of "for now": the sanction roster is bound to the 2026-09-11 first-party revision, so
// evaluating the SAME first-party use under a later active posture refuses. It calls
// admit_provider_use directly with our own roster and facts, because the producer above pins the
// active posture by design -- the thing under test is the roster's binding, not the pin.
fn t_later_posture() -> CompliancePostureRevision {
  CompliancePostureRevision {
    authority: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_first_party_use_posture"),
    revision: as_content_hash_structural(structural: content_hash_atom(value: "gunbc.spark.serving-someone-else.later" as NonEmptyStr)),
  }
}

test fn a_superseded_posture_makes_the_first_party_sanction_stale() -> Bool {
  match admit_provider_use(
    roster: spark_first_party_sanction_roster(),
    facts: spark_first_party_route_facts(realization: t_pair_realization()),
    active: t_later_posture(),
    scope: spark_first_party_use_scope(demand: t_demand(), work: t_work()),
    offer: t_offer(),
    decision_receipt: decl_ref(module_path: "gunbc.spark.first_party_serving", decl_name: "spark_first_party_use_posture"),
  ) {
    ProviderUseAdmitted { permit: _ } => false
    ProviderUseDenied { decision: _, cause: c } => refusal_reason(c: c) == "posture stale"
  }
}


// THE DROP'S POPULATION AND THE CODE MOVE TOGETHER, WHICH IS WHAT THIS ROW IS FOR. The rung drop
// gunbc.rung_drop.provider_path_jurisdiction_unread_admits is declared against a telemetry path that
// exists only while the serving launch leaves usage reporting on. That standing is now DERIVED from
// gunbc.spark.pair_serving_realization's container environment, so the day somebody adds
// VLLM_NO_USAGE_STATS=1 the path becomes ProviderPathAbsent and the drop is declared against nothing
// -- and this row goes red and says so, rather than leaving a rostered drop describing a path that
// no longer exists.
//
// IT IS NOT A CHANGE DETECTOR: it asserts the arm the fold selects, and the fold reads a declaration
// in another module, so what goes red is a real divergence between the launch and the drop roster
// rather than a number someone has to keep in step by hand.
//
// AND IT ASSERTS THE PATH THE IDENTITY JOIN MATCHED ON, not merely the arm. The arm alone says a
// deployment was identified; naming the path says WHICH ONE, which is what an auditor reading the
// standing needs and what makes the identity payload load-bearing rather than carried (review
// 64492). The expected value comes from the same producer the module compares against, so this
// cannot drift into agreeing with itself.
test fn the_launch_leaves_usage_reporting_on_which_is_what_the_drop_is_declared_against() -> Bool {
  match spark_serving_usage_stats_standing(realization: t_pair_realization()) {
    UsageStatsEnabledByDefault { basis: b } => string_contains(s: b as String, pattern: t_declared_path())
    UsageStatsDisabledByLaunch { mechanism: _ } => false
    UsageStatsLaunchUnread { obligation: _ } => false
  }
}


// RED -- A DEPLOYMENT THIS MODULE HAS NO ENVIRONMENT MODEL FOR DOES NOT INHERIT PAIR-SERVING'S
// ANSWER. Same hosts, same site coverage, and the one thing that differs is the model path the
// engine itself reported: before this repair the telemetry fold read
// gunbc.spark.pair_serving_realization's container environment over the global lane roster and would
// have handed this launch the pair route's answer, so a native GLM engine would have been admitted
// on route facts describing a different container. It is unread now, which refuses.
test fn a_foreign_deployment_on_the_same_hosts_is_unread_not_inherited() -> Bool {
  match spark_serving_usage_stats_standing(realization: t_foreign_realization()) {
    UsageStatsLaunchUnread { obligation: o } => string_contains(s: o as String, pattern: "no environment model for the deployment that answered")
    UsageStatsEnabledByDefault { basis: _ } => false
    UsageStatsDisabledByLaunch { mechanism: _ } => false
  }
}

// RED -- AND THE REFUSAL REACHES ADMISSION RATHER THAN STOPPING AT THE STANDING. An unread telemetry
// path is an unresolved data path, so provider-use admission refuses for that route: the engine can
// be healthy, the site covered and the posture current, and the route still does not admit.
test fn a_foreign_deployment_refuses_provider_use_admission() -> Bool {
  match spark_first_party_admission(
    realization: t_foreign_realization(),
    scope: spark_first_party_use_scope(demand: t_demand(), work: t_work()),
    offer: t_offer(),
  ) {
    ProviderUseAdmitted { permit: _ } => false
    ProviderUseDenied { decision: _, cause: c } => refusal_reason(c: c) == "route facts incomplete"
  }
}

// RED -- A REALIZATION WITH NO READABLE HOST MEMBERSHIP IS UNREAD TOO, and for its own reason rather
// than the foreign-deployment one: the readback identifies the declared launch, so the environment
// WOULD be attributable, and what is missing is which hosts serve it. The obligation must name THAT
// -- reading more of the lane roster answers nothing while the realization names no hosts (review
// 64438).
test fn a_pair_realization_with_no_hosts_is_unread_for_membership() -> Bool {
  match spark_serving_usage_stats_standing(realization: SparkServingRealization {
    hosts: [] as List<HostIdentity>,
    readback: t_readback(path: t_declared_path()),
  }) {
    UsageStatsLaunchUnread { obligation: o } => string_contains(s: o as String, pattern: "no host membership")
    UsageStatsEnabledByDefault { basis: _ } => false
    UsageStatsDisabledByLaunch { mechanism: _ } => false
  }
}


// RED -- A REALIZATION WHOSE HOSTS ARE ONLY PARTLY OBSERVED IS UNREAD, NOT ANSWERED FROM THE HALF
// THAT IS. The earlier spelling refused only an EMPTY lane result, so one observed host and one
// unobserved host resolved from the observed one and silently dropped the other (review 64424).
// Partial evidence is missing evidence: srv5 has an observed lane and srv1 does not, and the answer
// is the obligation rather than srv5's environment.
test fn a_partly_observed_realization_is_unread_rather_than_answered_from_its_observed_half() -> Bool {
  match spark_serving_usage_stats_standing(realization: SparkServingRealization {
    hosts: [operator_host_srv5, operator_host_srv1],
    readback: t_readback(path: t_declared_path()),
  }) {
    UsageStatsLaunchUnread { obligation: o } => string_contains(s: o as String, pattern: "no observed fabric lane")
    UsageStatsEnabledByDefault { basis: _ } => false
    UsageStatsDisabledByLaunch { mechanism: _ } => false
  }
}

// RED -- AN UNRESOLVED READBACK IDENTIFIES NOTHING, so a route whose /v1/models document could not
// be decoded cannot have an environment attributed to it either. This is the arm that makes the
// identity join launch-bound rather than declaration-bound: with nothing reported by the process,
// there is nothing to compare to the declared path.
test fn an_unresolved_readback_leaves_the_deployment_unidentified() -> Bool {
  match spark_serving_usage_stats_standing(realization: SparkServingRealization {
    hosts: [operator_host_srv5, operator_host_srv6],
    readback: ModelsRouteDocumentUnreadable { cause: "the document's data member is not an array" as NonEmptyStr },
  }) {
    UsageStatsLaunchUnread { obligation: o } => string_contains(s: o as String, pattern: "did not resolve")
    UsageStatsEnabledByDefault { basis: _ } => false
    UsageStatsDisabledByLaunch { mechanism: _ } => false
  }
}
