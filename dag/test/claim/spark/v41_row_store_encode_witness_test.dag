module test.claim.spark.v41_row_store_encode_witness

import std.types { Bool, String, List, NonEmptyStr, Int }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import std.integer { UInt8, qualified_octet_members }
import v2.std.optional { Present, Absent }
import extdeps.numeric.base16 { base16_decode_lower }
import extdeps.tools.sha256sum { Sha256FileDigest, Sha256FileDigestUnavailable, sha256sum_stdin_digest_via_shell }
import extdeps.safetensors.format { SafeF8E4M3, SafeF8E8M0 }
import extdeps.vllm.engram_layout { VllmEngramRankRows }
import extdeps.deepseek.deepseek_v4_1_flash {
  deepseek_v4_1_flash_engram, deepseek_v4_1_flash_engram_sharded_entries, deepseek_v4_1_flash_engram_shard_files,
}
import gunbc.spark.v41_runtime_candidate { v41_candidate_partition }
import gunbc.spark.v41_engram_row_store {
  V41RowStoreEncodingSpec, V41SourceRow, V41StoreComplete, V41StoreIncomplete,
  V41RowStoreSpecAdmitted, V41RowStoreSpecRefused, V41PublishedSpansPlanned, V41PublishedSpansUnplannable,
  v41_encoding_spec_of_layers, v41_layer_table, v41_row_geometry_of, v41_source_row,
  v41_place_all, v41_placed_rows, v41_store_bytes, v41_row_store_spec, v41_published_span_plan,
}
import gunbc.spark.v41_row_store_encode {
  V41StoreEncodeArgs, V41StoreEncodePlanned, V41StoreEncodeUnplannable, v41_store_encode_plan,
  v41_store_encode_argv, v41_row_store_encoder_program, v41_row_store_host_realization, v41_magic_hex,
}
import test.claim.vllm.vllm_engram_layout_witness { w_published_head_sizes }

// ── THE DIFFERENTIAL: THE HOST PROGRAM'S BYTES AGAINST THE .dag FOLD'S, OVER REAL PUBLISHED ROWS ──
//
// THE RECEIPT, and how it was produced (2026-09-23, bold-newt-50). Rows 96000562 and 96000563 of
// layers.1.engram.embed.{weight,scale} were read by HTTP range from model-00047-of-00048.safetensors at
// dba1be0a and written at their TRUE file offsets into a sparse copy of that shard. The rendered
// program gunbc.spark.v41_row_store_encode v41_row_store_encoder_program -- the exact text the fleet
// mode ships, whose sha256 is w_program_sha256 -- then ran as `python3 -c <program>` with
//   --a-offset 664 --a-width 256 --b-offset 98305579672 --b-width 8 --first 96000562 --count 2
//   --prefix-hex 454e4752310a --chunk 65536
// and again with --chunk 1, which crosses a chunk boundary between the two rows and wrote the same
// bytes (the offsets and widths are the live plan's for layer 1, asserted by
// the_live_plan_hands_the_encoder_what_the_sample_run_used), and w_host_store is its output file. The
// perturbed receipt is the same run with --b-offset one row further (98305579680): row 0 then
// carries row 1's scale and row 1 carries row 2's.
data w_program_sha256: String = "3d6a9c6d2a4c4423940af2b3f6467e0bf96eb5782e72792f1ffaa3edb681fec2"

data w_weight_96000562: String = ""
data w_scale_96000562: String = "7877777778777777"
data w_weight_96000563: String = ""
data w_scale_96000563: String = "7878787878787878"

data w_host_store: String = ""

data w_host_store_perturbed: String = ""

fn w_sample_args() -> V41StoreEncodeArgs {
  V41StoreEncodeArgs {
    layer: 1, rank: 0, shard: "model-00047-of-00048.safetensors" as NonEmptyStr,
    weight_offset: byte_size(count: 664), scale_offset: byte_size(count: 98305579672), start: 96000562, rows: 2,
    weight_bytes: byte_size(count: 256), scale_bytes: byte_size(count: 8), magic_hex: v41_magic_hex(), out: "/s/out" as NonEmptyStr, expected_size: byte_size(count: 534),
  }
}

fn w_octets(hex: String) -> List<UInt8> {
  match base16_decode_lower(hex: hex) {
    Present { value: q } => qualified_octet_members(q: q)
    Absent => [] as List<UInt8>
  }
}

// THE SAMPLE AS ONE STORE: the live geometry (256 x F8_E4M3 + 8 x F8_E8M0), layer 1, and a rank-0 range
// that is exactly the two sampled rows -- the same range the host program was run over.
fn w_sample_spec() -> V41RowStoreEncodingSpec {
  v41_encoding_spec_of_layers(
    partition: v41_candidate_partition,
    layers: [v41_layer_table(layer: 1, weight: "layers.1.engram.embed.weight" as NonEmptyStr, scale: "layers.1.engram.embed.scale" as NonEmptyStr, rows: 384006168, ranks: [VllmEngramRankRows { rank: 0, start: 96000562, end: 96000564 }])],
    geometry: v41_row_geometry_of(weight_dtype: SafeF8E4M3, scale_dtype: SafeF8E8M0, weight_width: 256, scale_width: 8),
  )
}

fn w_dag_store() -> List<UInt8> {
  let rows = [
    v41_source_row(layer: 1, global_row: 96000562, weight: w_octets(hex: w_weight_96000562), scale: w_octets(hex: w_scale_96000562)),
    v41_source_row(layer: 1, global_row: 96000563, weight: w_octets(hex: w_weight_96000563), scale: w_octets(hex: w_scale_96000563)),
  ]
  match v41_store_bytes(placed: v41_placed_rows(placements: v41_place_all(rows: rows, spec: w_sample_spec())), spec: w_sample_spec(), layer: 1, rank: 0) {
    V41StoreComplete { store: c } => c.bytes
    V41StoreIncomplete { defect: _ } => [] as List<UInt8>
  }
}

test fn the_host_program_writes_exactly_the_folds_store_over_real_published_rows() -> Bool {
  let dag = w_dag_store()
  length(dag) == 6 + 2 * 264 && dag == w_octets(hex: w_host_store)
}

// RED: the same program with its scale table one row off writes a store the fold does not.
test fn a_perturbed_placement_by_the_host_program_is_not_the_folds_store() -> Bool {
  let dag = w_dag_store()
  length(dag) == 6 + 2 * 264 && dag != w_octets(hex: w_host_store_perturbed)
}

// THE RECEIPT DESCRIBES THE RENDERED PROGRAM THE MODE SHIPS: the text that produced it is the text
// v41_store_encode_argv carries. An edit to the program invalidates the receipt until it is re-run.
test fn the_receipt_was_produced_by_the_rendered_program_the_mode_ships() -> Bool {
  match sha256sum_stdin_digest_via_shell(content: v41_row_store_encoder_program) {
    Sha256FileDigest { digest: d } => (d.hex as String) == w_program_sha256
    Sha256FileDigestUnavailable { path: _, reason: _ } => false
  }
}

// THE ARGV CARRIES THAT TEXT, and the declaration says what it realizes.
test fn the_argv_ships_the_rendered_program_as_a_realization_of_v41_place_row() -> Bool {
  let a = v41_store_encode_argv(shard_directory: "/s" as NonEmptyStr, a: w_sample_args())
  match get(xs: a, index: 2) {
    Present { value: prog } => prog == v41_row_store_encoder_program
    Absent => false
  } && (v41_row_store_host_realization.realizes.decl_name as String) == "v41_place_row"
    && (v41_row_store_host_realization.realizes.module_path as String) == "gunbc.spark.v41_engram_row_store"
}

// THE LIVE PLAN HANDS THE ENCODER WHAT THE SAMPLE RUN USED for layer 1: the weight and scale tables at
// their header-derived offsets, the 256 + 8 byte widths and the magic -- and eight stores in all.
test fn the_live_plan_hands_the_encoder_what_the_sample_run_used() -> Bool {
  match v41_row_store_spec(population: map(deepseek_v4_1_flash_engram_sharded_entries, e => e.entry), partition: v41_candidate_partition, tables: deepseek_v4_1_flash_engram, head_sizes: w_published_head_sizes()) {
    V41RowStoreSpecRefused { defects: _ } => false
    V41RowStoreSpecAdmitted { spec: spec } => match v41_published_span_plan(partition: v41_candidate_partition, sharded: deepseek_v4_1_flash_engram_sharded_entries, shards: deepseek_v4_1_flash_engram_shard_files) {
      V41PublishedSpansUnplannable { defects: _ } => false
      V41PublishedSpansPlanned { spans: spans } => match v41_store_encode_plan(spec: spec, spans: spans) {
        V41StoreEncodeUnplannable { defects: _ } => false
        V41StoreEncodePlanned { stores: st } =>
          length(st) == 8
            && any(st, a => a.layer == 1 && a.rank == 0
              && byte_size_count(b: a.weight_offset) == 664 && byte_size_count(b: a.scale_offset) == 98305579672
              && a.start == 0 && a.rows == 96000564
              && byte_size_count(b: a.weight_bytes) == 256 && byte_size_count(b: a.scale_bytes) == 8 && a.magic_hex == "454e4752310a"
              && (a.shard as String) == "model-00047-of-00048.safetensors"
              && byte_size_count(b: a.expected_size) == 25344148902)
      }
    }
  }
}
