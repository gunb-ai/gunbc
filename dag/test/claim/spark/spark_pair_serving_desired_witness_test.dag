module test.claim.spark.spark_pair_serving_desired_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { token_count_value, percent_count }
import product.placement_supply { host_identity_eq }
import extdeps.network.ipv4 { ipv4_address_eq }
import v2.std.optional { Present, Absent }
import std.measure { token_count, percent }
import extdeps.vllm.engine_args {
  vllm_kv_cache_dtype_wire, vllm_distributed_executor_backend_wire,
  VllmEngineArgs, vllm_memory_utilization, KvFp8DsMla, ExecutorRay,
}
import extdeps.deepseek.deepseek_v4 { deepseek_v4_context_length }
import gunbc.spark.pair_serving_realization { spark_pair_vllm_serve_argv }
import gunbc.spark.model_snapshot_acquisition { deepseek_v4_flash_snapshot }
import gunbc.spark.serving_engine { VllmServing, OllamaServing }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8, operator_host_srv9 }
import gunbc.spark.fabric_switch_observed { FabricGroupA, FabricGroupB }
import gunbc.spark.fabric_rail_desired { fabric_rail_address }
import gunbc.spark.pair_serving_desired {
  spark_pair_serving_engine_args,
  spark_pair_serving_unit, spark_pair_serving_unit_with,
  SparkPairServingUnit, SparkPairServingUnitReady, SparkPairServingUnitRefused,
  SparkPairServingSeqCapacity, SeqCapacityMeasured, SeqCapacityUnmeasured, SeqCapacityByOperatorPolicy,
  spark_pair_serving_seq_capacity, spark_pair_serving_seq_capacity_for, spark_pair_serving_groups, spark_pair_serving_desired_hosts,
  spark_pair_serving_unit_wire,
}

// THE RENDERED LINE IS REACHED THROUGH THE DECLARED SNAPSHOT, because that is what the renderer now
// takes. These two assertions arrived on main against a one-argument renderer; this branch made the
// model path come from the snapshot, so the call is adapted rather than the assertions weakened -- an
// unpinned snapshot renders NOTHING, and a witness that silently accepted that would assert about a
// line nobody launches.
fn w_serve_line(args: VllmEngineArgs) -> String {
  match spark_pair_vllm_serve_argv(args: args, snapshot: deepseek_v4_flash_snapshot) {
    Absent => ""
    Present { value: argv } => join(argv, " ")
  }
}

// THE PINNED BATCH BUDGET REACHES THE ARGV, which is the only place it can affect the engine. The
// field is optional and its ABSENT arm renders nothing, so a desired row that silently reverted to
// `none` would still typecheck, still build a valid launch, and still serve -- on whatever default
// the runtime's device probe happened to resolve. That is the exact failure this pin exists to
// prevent, and it is invisible without an assertion on the rendered text.
test fn the_pinned_prefill_budget_is_rendered_into_the_serve_argv() -> Bool {
  string_contains(
    s: w_serve_line(args: spark_pair_serving_engine_args(tensor_parallel: 4, max_num_seqs: 32)),
    pattern: "--max-num-batched-tokens 2048")
}

// THE DISCRIMINATING NEGATIVE. An unrequested policy must emit NO batch flag at all, rather than
// emitting a default we would then be inheriting twice. Without this arm the row above would still
// pass if the renderer hard-coded the flag regardless of the field.
test fn an_unrequested_prefill_policy_renders_no_batch_flag() -> Bool {
  !string_contains(
    s: w_serve_line(args: VllmEngineArgs {
      prefill_scheduling: none,
      tensor_parallel_size: 4,
      gpu_memory_utilization: vllm_memory_utilization(fraction: percent(count: 82)),
      max_model_len: token_count(count: 1048576),
      max_num_seqs: 32,
      kv_cache_dtype: KvFp8DsMla,
      distributed_executor_backend: ExecutorRay,
    }),
    pattern: "--max-num-batched-tokens")
}

// THE ENGINE TUPLE FOR THE ROUTE THAT ACTUALLY SERVES DEEPSEEK. `fp8_ds_mla` is the cache layout of
// DeepSeek's Multi-head Latent Attention and this route serves DeepSeek V4 Flash, so it is the
// correct value here. A revision of this branch set it to plain `fp8` for GLM-5.3-Flash -- right
// about the model it was aimed at, wrong about the route it was applied to, because this module's
// realization builds from an image measured not to register GLM at all.
//
// THE WINDOW IS ASSERTED AGAINST THE MODEL AUTHORITY AND DELIBERATELY NOT AGAINST A LITERAL. Both
// models declare 1,048,576, and that coincidence is exactly what lets a hardcoded window survive a
// model change it was never about: an assertion on the literal stays green through a migration that
// left the field pointing at the wrong authority.
test fn the_group_engine_tuple_carries_this_models_layout_and_window() -> Bool {
  let a = spark_pair_serving_engine_args(tensor_parallel: 4, max_num_seqs: 32)
  a.tensor_parallel_size == 4
    && percent_count(p: a.gpu_memory_utilization.fraction) == 82
    && token_count_value(t: a.max_model_len) == token_count_value(t: deepseek_v4_context_length)
    && (vllm_kv_cache_dtype_wire(request: a.kv_cache_dtype) as String) == "fp8_ds_mla"
    && (vllm_distributed_executor_backend_wire(backend: a.distributed_executor_backend) as String) == "ray"
}

fn w_refused_naming(unit: SparkPairServingUnit, fragment: String) -> Bool {
  match unit {
    SparkPairServingUnitReady { group: _, engine: _, head: _, workers: _ } => false
    SparkPairServingUnitRefused { group: _, cause: c } => string_contains(s: c as String, pattern: fragment)
  }
}

// A CAPACITY WITH NO ANSWER AT ALL STILL REFUSES, and this arm stays reachable and tested even
// though it is not the live state: it is the wall against a group that has neither a measurement nor
// an operator choice.
test fn an_unmeasured_pool_refuses_the_unit_for_that_reason_alone() -> Bool {
  w_refused_naming(unit: spark_pair_serving_unit_with(group: FabricGroupA, capacity: SeqCapacityUnmeasured), fragment: "max-num-seqs")
}

// THE LIVE COUNT IS A MEASUREMENT IN ITS OWN SCENARIO, WHICH IS THE RULE RATHER THAN AN EXCEPTION TO
// IT. The defect this branch set out to remove was carrying 32 ACROSS MODELS -- one DeepSeek launch,
// one quantisation, one KV layout, at tensor-parallel 2, handed to every model thereafter. Used for
// the model and layout it was actually taken on, it is exactly what a measured capacity should be,
// and the basis names that scenario so it cannot travel silently.
test fn the_live_sequence_count_is_measured_in_the_scenario_it_serves() -> Bool {
  match spark_pair_serving_seq_capacity {
    SeqCapacityUnmeasured => false
    SeqCapacityByOperatorPolicy { max_num_seqs: _, basis: _ } => false
    SeqCapacityMeasured { max_num_seqs: n, basis: b } =>
      n == 32
        && string_contains(s: b as String, pattern: "fp8_ds_mla")
        && string_contains(s: b as String, pattern: "may not travel")
  }
}

// THE GROUPS ARE LAUNCHABLE, which is the property an over-corrected revision of this branch
// destroyed by answering Unmeasured: the unit refused, the realization refused, the apply plan
// refused, and no engine could ever start to produce the launch line a measurement needs.
test fn the_promoted_group_is_launchable() -> Bool {
  match spark_pair_serving_unit(group: FabricGroupA) {
    SparkPairServingUnitReady { group: _, engine: _, head: _, workers: _ } => true
    SparkPairServingUnitRefused { group: _, cause: _ } => false
  }
}

// GROUP A IS srv6 AT THE HEAD WITH srv5, srv7 AND srv8 AS WORKERS, EVERY RANK AT ITS RAIL ADDRESS,
// tensor-parallel four, and the engine is vLLM.
test fn group_a_is_four_ranks_headed_by_srv6_at_their_rail_addresses() -> Bool {
  match spark_pair_serving_unit(group: FabricGroupA) {
    SparkPairServingUnitRefused { group: _, cause: _ } => false
    SparkPairServingUnitReady { group: _, engine: e, head: h, workers: ws } =>
      host_identity_eq(a: h.host, b: operator_host_srv6)
        && length(ws) == 3
        && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv5)) && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv7)) && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv8))
        && (match e { VllmServing { args: a } => a.tensor_parallel_size == 4  OllamaServing { profile: _ } => false })
        && (match fabric_rail_address(host: h.host) { Present { value: a } => ipv4_address_eq(a: a, b: h.host_ip)  Absent => false })
        && all(ws, w => match fabric_rail_address(host: w.host) { Present { value: a } => ipv4_address_eq(a: a, b: w.host_ip)  Absent => false })
  }
}

// EACH GROUP HAS EXACTLY ONE OWNER, AND THIS WITNESS ASSERTED BOTH BELONGED TO DEEPSEEK PRODUCTION.
// It required two promoted groups and all eight fabric hosts in the desired projection, which was
// true when written and stopped being true when group B was withdrawn for the GLM canary. A roster
// witness that outlives the roster it describes is the same defect as an annotation that outlives its
// declaration: it keeps asserting a fact nobody holds any more, and it is CI rather than a reader that
// finds out.
//
// THE OWNERSHIP IT NOW ASSERTS: group A is DeepSeek production and reaches the desired hosts; group B
// is NOT in that projection, because it is reserved for the canary. That group B still RESOLVES to a
// ready unit when asked directly is a separate fact and deliberately left alone -- the unit function
// is total, and its arm being reachable is not the same as the roster claiming it.
test fn group_a_is_the_only_promoted_group_and_group_b_is_not_in_the_projection() -> Bool {
  length(spark_pair_serving_groups) == 1
    && length(spark_pair_serving_desired_hosts()) == 4
    && any(spark_pair_serving_desired_hosts(), h => host_identity_eq(a: h, b: operator_host_srv6))
    && !any(spark_pair_serving_desired_hosts(), h => host_identity_eq(a: h, b: operator_host_srv9))
}

test fn the_group_b_wire_names_srv9_at_its_rail_address() -> Bool {
  let w = spark_pair_serving_unit_wire(unit: spark_pair_serving_unit(group: FabricGroupB))
  string_contains(s: w, pattern: "group group-b tp=4 head=srv9@192.168.110.17 workers=")
    && string_contains(s: w, pattern: "srv12@192.168.110.16")
}

test fn the_wire_names_the_group_its_degree_and_every_rank() -> Bool {
  let w = spark_pair_serving_unit_wire(unit: spark_pair_serving_unit(group: FabricGroupA))
  string_contains(s: w, pattern: "group group-a tp=4 head=srv6@192.168.110.14 workers=")
    && string_contains(s: w, pattern: "srv5@192.168.110.11")
}
