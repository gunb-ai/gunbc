module test.claim.spark.v41_serving_load_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { microsecond, microsecond_count, millisecond, millisecond_count, token_count_value }
import v2.std.optional { Present, Absent }
import product.host_identity { HostIdentity }
import extdeps.vllm.bench_serve { VllmBenchServeRequest }
import extdeps.linux.psi { PsiReading, PsiRead, PsiUnparseable }
import extdeps.linux.diskstats { DiskstatsReading, DiskstatsDeviceRead, DiskstatsDeviceAbsent, DiskstatsUnparseable, DiskstatsRow }
import gunbc.spark.serving_load_probe { ClientBenchLatencyUnread }
import gunbc.spark.serving_load_runner { step_subject_mismatch }
import gunbc.spark.v41_capacity_measurement { v41_staircase_concurrencies }
import gunbc.spark.v41_serving_load {
  V41RankPressure, V41RankPressureObserved, V41RankPressureUnread, V41StepPressure,
  V41StepProjected, V41StepUnprojected, V41StepConcurrencyUnbound, v41_project_step, v41_project_for_request, v41_serving_load_step, v41_serving_load_steps,
  v41_serving_load_subject, v41_serving_load_dataset, v41_device_of_findmnt,
}

fn rank(host: String, refault: Nat, psi_full: Nat, ticks: Nat) -> V41RankPressure {
  V41RankPressure {
    host: host as HostIdentity,
    refault_file: refault,
    psi: PsiRead { some_total: microsecond(count: psi_full), full_total: Present { value: microsecond(count: psi_full) } },
    nvme: DiskstatsDeviceRead { row: DiskstatsRow { device: "nvme0n1p2" as NonEmptyStr, reads_completed: 100, sectors_read: 800, read_ticks: millisecond(count: ticks), in_flight: 0 } },
  }
}

fn step(ranks: List<V41RankPressure>) -> V41StepPressure {
  V41StepPressure { ranks: map(ranks, r => V41RankPressureObserved { pressure: r }) }
}

fn rank_after(host: String, refault: Nat, psi_full: Nat, ticks: Nat) -> V41RankPressure {
  V41RankPressure {
    host: host as HostIdentity,
    refault_file: refault,
    psi: PsiRead { some_total: microsecond(count: psi_full), full_total: Present { value: microsecond(count: psi_full) } },
    nvme: DiskstatsDeviceRead { row: DiskstatsRow { device: "nvme0n1p2" as NonEmptyStr, reads_completed: 200, sectors_read: 1600, read_ticks: millisecond(count: ticks), in_flight: 0 } },
  }
}

data metrics_before: String = join(["vllm:num_preemptions_total{", "model_name=\"v41\"} 3.0\n"], "")
data metrics_after: String = join(["vllm:num_preemptions_total{", "model_name=\"v41\"} 3.0\n"], "")

test fn each_stop_rule_reads_its_own_worst_rank() -> Bool {
  let before = step([rank(host: "srv5", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv6", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv7", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv8", refault: 10, psi_full: 0, ticks: 0)])
  let after = step([rank_after(host: "srv5", refault: 20, psi_full: 900, ticks: 10), rank_after(host: "srv6", refault: 11, psi_full: 5, ticks: 10), rank_after(host: "srv7", refault: 510, psi_full: 5, ticks: 10), rank_after(host: "srv8", refault: 12, psi_full: 5, ticks: 400)])
  match v41_project_step(run_id: "run-1" as NonEmptyStr, concurrency: 4, before: before, after: after, before_body: metrics_before, after_body: metrics_after, latency: ClientBenchLatencyUnread { cause: "fixture" as NonEmptyStr }) {
    V41StepUnprojected { concurrency: _, causes: _ } => false
    V41StepConcurrencyUnbound { cause: _ } => false
    V41StepProjected { reading: r } =>
      r.concurrency == 4
        && r.refault_file_after == 510
        && nvme_after_ticks(r: r.nvme_after) == 400
        && (match r.preemptions { Present { value: p } => p == 0  Absent => false })
        && psi_after_full(r: r.memory_pressure_after) == 900
  }
}

fn nvme_after_ticks(r: DiskstatsReading) -> Nat {
  match r {
    DiskstatsDeviceRead { row: w } => millisecond_count(m: w.read_ticks)
    DiskstatsDeviceAbsent { device: _ } => 0
    DiskstatsUnparseable { device: _, line: _ } => 0
  }
}

fn psi_after_full(r: PsiReading) -> Nat {
  match r {
    PsiRead { some_total: _, full_total: f } => match f { Present { value: m } => microsecond_count(m: m)  Absent => 0 }
    PsiUnparseable { body: _, cause: _ } => 0
  }
}

test fn an_unread_rank_unprojects_the_step_and_names_it() -> Bool {
  let before = step([rank(host: "srv5", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv6", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv7", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv8", refault: 10, psi_full: 0, ticks: 0)])
  let after = V41StepPressure { ranks: [
    V41RankPressureObserved { pressure: rank_after(host: "srv5", refault: 20, psi_full: 9, ticks: 10) },
    V41RankPressureObserved { pressure: rank_after(host: "srv6", refault: 20, psi_full: 9, ticks: 10) },
    V41RankPressureUnread { host: "srv7" as HostIdentity, cause: "cat /proc/diskstats unreachable" },
    V41RankPressureObserved { pressure: rank_after(host: "srv8", refault: 20, psi_full: 9, ticks: 10) },
  ] }
  match v41_project_step(run_id: "run-1" as NonEmptyStr, concurrency: 4, before: before, after: after, before_body: metrics_before, after_body: metrics_after, latency: ClientBenchLatencyUnread { cause: "fixture" as NonEmptyStr }) {
    V41StepProjected { reading: _ } => false
    V41StepConcurrencyUnbound { cause: _ } => false
    V41StepUnprojected { concurrency: c, causes: cs } => c == 4 && any(cs, x => contains(x, "after srv7: cat /proc/diskstats unreachable"))
  }
}

test fn every_staircase_step_addresses_the_v41_subject() -> Bool {
  let steps = v41_serving_load_steps()
  length(steps) == length(v41_staircase_concurrencies)
    && (match v41_serving_load_subject() {
      Absent => false
      Present { value: subj } => all(steps, s => match step_subject_mismatch(subject: subj, req: s) { Absent => true  Present { value: _ } => false })
    })
    && all(steps, s => match s.max_concurrency { Present { value: c } => s.num_prompts == 2 * c  Absent => false })
}

test fn the_protocol_row_is_glms_shape_declared_as_v41s_own() -> Bool {
  token_count_value(t: v41_serving_load_dataset.input_len) == 256
    && token_count_value(t: v41_serving_load_dataset.output_len) == 128
    && token_count_value(t: v41_serving_load_dataset.prefix_len) == 0
}

test fn findmnt_source_names_the_diskstats_device() -> Bool {
  (match v41_device_of_findmnt(stdout: "/dev/nvme0n1p2\n") { Present { value: d } => (d as String) == "nvme0n1p2"  Absent => false })
    && (match v41_device_of_findmnt(stdout: "overlay\n") { Present { value: _ } => false  Absent => true })
}

test fn a_request_without_a_concurrency_refuses_instead_of_judging_level_zero() -> Bool {
  let p = v41_serving_load_step(concurrency: 4)
  let unbound = VllmBenchServeRequest {
    backend: p.backend, base_url: p.base_url, model: p.model, tokenizer: p.tokenizer, dataset: p.dataset,
    num_prompts: p.num_prompts, arrival: p.arrival, max_concurrency: none, ignore_eos: p.ignore_eos, seed: p.seed,
  }
  let ranks = step([rank(host: "srv5", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv6", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv7", refault: 10, psi_full: 0, ticks: 0), rank(host: "srv8", refault: 10, psi_full: 0, ticks: 0)])
  let later = step([rank_after(host: "srv5", refault: 11, psi_full: 1, ticks: 1), rank_after(host: "srv6", refault: 11, psi_full: 1, ticks: 1), rank_after(host: "srv7", refault: 11, psi_full: 1, ticks: 1), rank_after(host: "srv8", refault: 11, psi_full: 1, ticks: 1)])
  let refused = match v41_project_for_request(run_id: "run-1" as NonEmptyStr, req: unbound, before: ranks, after: later, before_body: metrics_before, after_body: metrics_after, latency: ClientBenchLatencyUnread { cause: "fixture" as NonEmptyStr }) {
    V41StepConcurrencyUnbound { cause: why } => contains(why, "no max_concurrency")
    V41StepProjected { reading: _ } => false
    V41StepUnprojected { concurrency: _, causes: _ } => false
  }
  let bound = match v41_project_for_request(run_id: "run-1" as NonEmptyStr, req: p, before: ranks, after: later, before_body: metrics_before, after_body: metrics_after, latency: ClientBenchLatencyUnread { cause: "fixture" as NonEmptyStr }) {
    V41StepProjected { reading: r } => r.concurrency == 4
    V41StepConcurrencyUnbound { cause: _ } => false
    V41StepUnprojected { concurrency: _, causes: _ } => false
  }
  refused && bound
}
