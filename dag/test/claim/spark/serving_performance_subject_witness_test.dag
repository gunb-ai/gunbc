// ── THE TRANSPORT AXIS: SOCKET AGAINST RDMA IS A REAL DIFFERENCE, UNREAD IS NOT AN AGREEMENT ───
//
// This is the brief's live question in miniature. A socket measurement and an RDMA decision are
// DIFFERENT subjects, which is what makes the RDMA comparison a comparison rather than a re-read.
test fn w_socket_and_rdma_are_different_subjects() -> Bool {
  let on_ib = serving_performance_subject(
    checkpoint: fx_deepseek_tp4.checkpoint,
    checkpoint_revision: fx_deepseek_tp4.checkpoint_revision,
    runtime: fx_deepseek_tp4.runtime,
    runtime_image_reference: fx_deepseek_tp4.runtime_image_reference,
    topology: fx_deepseek_tp4.topology,
    rank_population: fx_deepseek_tp4.rank_population,
    context_ceiling: fx_deepseek_tp4.context_ceiling,
    max_num_batched_tokens: fx_deepseek_tp4.max_num_batched_tokens,
    max_num_seqs: fx_deepseek_tp4.max_num_seqs,
    kv_cache_dtype: fx_deepseek_tp4.kv_cache_dtype,
    speculative: fx_deepseek_tp4.speculative,
    collective_transport: fx_ib
    )
  let j = serving_subject_reads(measurement_subject: fx_deepseek_tp4, decision_subject: on_ib)
  join_is_different(j: j) && join_names_axis(j: j, a: AxisCollectiveTransport)
}

// THE ABSORBING-FALLBACK ARM, REFUSED. An absent transport reading must not compare EQUAL to a read
// one: NCCL falls back to Socket silently, so "nobody looked" and "these agree" are different facts
// and collapsing them would license quoting a socket number for an RDMA arm. Note the subject below
// is built directly rather than through `serving_subject_standing`, because the point of this row is
// the axis comparison itself; the standing constructor's refusal has its own row.
test fn w_an_unread_transport_is_incomparable_and_never_equal() -> Bool {
  let unread = serving_performance_subject(
    checkpoint: fx_deepseek_tp4.checkpoint,
    checkpoint_revision: fx_deepseek_tp4.checkpoint_revision,
    runtime: fx_deepseek_tp4.runtime,
    runtime_image_reference: fx_deepseek_tp4.runtime_image_reference,
    topology: fx_deepseek_tp4.topology,
    rank_population: fx_deepseek_tp4.rank_population,
    context_ceiling: fx_deepseek_tp4.context_ceiling,
    max_num_batched_tokens: fx_deepseek_tp4.max_num_batched_tokens,
    max_num_seqs: fx_deepseek_tp4.max_num_seqs,
    kv_cache_dtype: fx_deepseek_tp4.kv_cache_dtype,
    speculative: fx_deepseek_tp4.speculative,
    collective_transport: Absent
    )
  join_is_incomparable(j: serving_subject_reads(measurement_subject: unread, decision_subject: fx_deepseek_tp4))
    && join_is_incomparable(j: serving_subject_reads(measurement_subject: fx_deepseek_tp4, decision_subject: unread))
    && join_is_incomparable(j: serving_subject_reads(measurement_subject: unread, decision_subject: unread))
}

// ── AN UNESTABLISHED STANDING REFUSES RATHER THAN GUESSING ─────────────────────────────────────
test fn w_a_partial_standing_names_its_gap_and_the_remedy() -> Bool {
  match serving_subject_standing(
    subject: ServingPerformanceSubject_with_unread(base: fx_deepseek_tp4),
    believed: "fixture belief" as NonEmptyStr,
    would_settle: "fixture remedy" as NonEmptyStr) {
    SubjectPartial { subject: _, unknown_axes: axes, believed: b, would_settle: w } =>
      (axes as String).contains("collective transport")
        && (b as String).contains("fixture belief")
        && (w as String).contains("fixture remedy")
    SubjectEstablished { subject: _ } => false
  }
}

// ── THE CONTROLLED-COMPARISON WITNESS ──────────────────────────────────────────────────────────
//
// A one-axis cut is what makes an attribution a comparison rather than a coincidence, and a cut
// that has drifted onto two axes attributes to the wrong one.
fn is_delta_on(c: SubjectAxisDelta, a: ServingSubjectAxis) -> Bool {
  match c {
    AxisDeltaOnOneAxis { axis: got } =>
      (serving_subject_axis_wire(a: got) as String) == (serving_subject_axis_wire(a: a) as String)
    AxisDeltaNone => false
    AxisDeltaOnManyAxes { axes: _ } => false
    AxisDeltaUndecidable { because: _ } => false
  }
}

test fn w_a_one_axis_cut_is_controlled_and_names_that_axis() -> Bool {
  let on_ib = serving_performance_subject(
    checkpoint: fx_deepseek_tp4.checkpoint,
    checkpoint_revision: fx_deepseek_tp4.checkpoint_revision,
    runtime: fx_deepseek_tp4.runtime,
    runtime_image_reference: fx_deepseek_tp4.runtime_image_reference,
    topology: fx_deepseek_tp4.topology,
    rank_population: fx_deepseek_tp4.rank_population,
    context_ceiling: fx_deepseek_tp4.context_ceiling,
    max_num_batched_tokens: fx_deepseek_tp4.max_num_batched_tokens,
    max_num_seqs: fx_deepseek_tp4.max_num_seqs,
    kv_cache_dtype: fx_deepseek_tp4.kv_cache_dtype,
    speculative: fx_deepseek_tp4.speculative,
    collective_transport: fx_ib
    )
  is_delta_on(
    c: serving_subject_axis_delta(left: SubjectEstablished { subject: fx_deepseek_tp4 }, right: SubjectEstablished { subject: on_ib }),
    a: AxisCollectiveTransport)
}

// TWO AXES IS NOT A CUT. fx_glm_group_b differs from the DeepSeek profile on checkpoint, runtime and
// ceiling at once, so no attribution to any one of them is available from that pair.
test fn w_a_multi_axis_pair_is_uncontrolled_rather_than_attributed() -> Bool {
  match serving_subject_axis_delta(
    left: SubjectEstablished { subject: fx_deepseek_tp4 },
    right: SubjectEstablished { subject: fx_glm_group_b }) {
    AxisDeltaOnManyAxes { axes: axes } =>
      (axes as String).contains("checkpoint") && (axes as String).contains("runtime")
    AxisDeltaOnOneAxis { axis: _ } => false
    AxisDeltaNone => false
    AxisDeltaUndecidable { because: _ } => false
  }
}

test fn w_two_identical_subjects_are_a_repeat_and_not_a_cut() -> Bool {
  match serving_subject_axis_delta(
    left: SubjectEstablished { subject: fx_deepseek_tp4 },
    right: SubjectEstablished { subject: fx_deepseek_tp4 }) {
    AxisDeltaNone => true
    AxisDeltaOnOneAxis { axis: _ } => false
    AxisDeltaOnManyAxes { axes: _ } => false
    AxisDeltaUndecidable { because: _ } => false
  }
}

// ── THE AXIS ROSTER IS POPULATED, AND THIS CLAIM IS NAMED FOR WHAT IT CHECKS ──────────────────
//
// It was called `w_the_axis_roster_covers_every_field_of_the_subject` and asserted a LENGTH, which
// is not field coverage: a field added to the record without an axis arm leaves the roster length
// untouched and the comparison silently ignoring it. The exhaustive match in
// `serving_subject_axis_value` is over ServingSubjectAxis, not over the record's fields, so nothing
// in the language forces the two to stay in step today.
//
// RUNG (DESIGN 4b): this is MITIGATION, not construction, and the honest ceiling is structural --
// a record whose fields ARE its axes has no spelling for the mismatch. TRIGGER: a way to enumerate a
// record's fields as a value, at which point the roster is derived and this claim dissolves rather
// than being maintained. Until then the roster is asserted non-degenerate so the fold cannot quietly
// become an empty list that reads every pair of subjects as the same subject.
test fn w_the_axis_roster_is_not_degenerate() -> Bool {
  length(serving_subject_axes) == 12
}

// ── THE TWO BOUND FLEET ROWS RESOLVE AS THEIR MODULES CLAIM ────────────────────────────────────
//
// These are the rows that make this type CONSUMED rather than declared, and unlike the fixtures
// above they are SUPPOSED to move when a measurement is re-taken. Each asserts the standing its own
// module states in prose, so the prose and the value cannot drift apart.
test fn w_every_batch_arm_carries_its_own_partial_subject() -> Bool {
  length(spark_group_a_measured_arms) > 0
    && fold(spark_group_a_measured_arms, init: true, f: (acc, arm) => acc && arm_subject_is_partial_on_topology(arm: arm))
}

// THE FIRST ARM STANDS FOR THE POPULATION HERE because every arm's standing is built by one
// function; the per-arm claim above is what establishes that each of them actually carries it.
fn first_batch_arm_subject() -> ServingPerformanceSubjectStanding {
  match spark_group_a_measured_arms.first() {
    Absent => batch_arm_subject(budget: token_count(count: 0))
    Present { value: arm } => arm.subject
  }
}

// THE ARM IS PARTIAL ON THE DEGREE AND CARRIES EVERYTHING ELSE, which is the half the first binding
// got wrong: it answered a subject-less standing and threw away six known axes to represent one
// unknown one. This asserts BOTH halves -- the gap is named, and the checkpoint is present -- because
// only the second is what makes a DeepSeek arm refuse to read for a GLM decision.
fn arm_subject_is_partial_on_topology(arm: MeasuredBatchArm) -> Bool {
  match arm.subject {
    SubjectPartial { subject: sub, unknown_axes: axes, believed: b, would_settle: w } =>
      (axes as String).contains("topology")
        && (w as String).contains("794afae389e44952a9049452c0619620")
        && (b as String).contains(to_string(arm.max_num_batched_tokens))
        && (serving_subject_axis_value(s: sub, a: AxisCheckpoint) as String) == (serving_checkpoint_wire(c: DeepseekV4FlashIq3sSplit) as String)
    SubjectEstablished { subject: _ } => false
  }
}

// THE MODULE HOLDS TWO SUBJECTS AND THE JOIN STILL REFUSES, BUT FOR A DIFFERENT REASON THAN THIS
// ROW FIRST ASSERTED -- and the change is the point of the last rework.
//
// It used to read "unestablished on tensor-parallel topology", because the batch arms carried NO
// subject at all and the join could not get past the standing. Now they carry every axis the module
// states and leave absent only the degree and the rank count, so the join compares: every axis both
// sides read AGREES (same checkpoint, revision, runtime, image, ceiling, budget, KV, speculation),
// and what separates them is exactly the axis nobody read. Incomparable is the honest answer, and
// the refusal now names WHICH axes are missing rather than reporting that one side had no subject.
//
// THE DEPTH LAW IS TP=2 AND THE ARMS ARE BELIEVED TP=4, AND THAT IS PRECISELY WHAT MAY NOT BE
// ASSERTED. If the arms' degree were promoted from belief to fact, this would become a
// DifferentSubject on topology; while it is a bet, the join says it cannot tell. That is the
// difference between the two answers, and it is the whole reason the belief stays outside the
// subject.
test fn w_the_depth_law_does_not_read_for_the_batch_arms() -> Bool {
  match serving_subject_standing_reads(
    measurement: spark_group_a_depth_rate.subject,
    decision: first_batch_arm_subject()) {
    SubjectIncomparable { because: b } =>
      (b as String).contains("topology") && (b as String).contains("never read")
    SameSubject => false
    DifferentSubject { axes: _, left: _, right: _ } => false
  }
}

// AND THE KNOWN AXES DO FENCE, which is the half the subject-less standing could not do at all. A
// batch arm read against the GLM profile reports the CHECKPOINT difference rather than "I cannot
// tell" -- on the live carrier, not a fixture. This is the row the PR's headline claim rests on.
test fn w_a_live_batch_arm_refuses_a_glm_decision_by_naming_the_checkpoint() -> Bool {
  let j = serving_subject_reads(
    measurement_subject: standing_subject(st: first_batch_arm_subject()),
    decision_subject: fx_glm_group_b)
  join_is_different(j: j)
    && join_names_axis(j: j, a: AxisCheckpoint)
    && join_names_axis(j: j, a: AxisRuntime)
}

// THE TRANSPORT GUARD IS THE OTHER MECHANISM, PINNED SEPARATELY so each is answerable for its own
// row. The depth rate read against ITSELF has nothing unestablished about it and still refuses,
// because nobody read its NCCL verdict line -- so this row can only be green by way of the transport.
test fn w_the_depth_law_does_not_even_read_for_itself_while_its_transport_is_unread() -> Bool {
  match serving_subject_standing_reads(
    measurement: spark_group_a_depth_rate.subject,
    decision: spark_group_a_depth_rate.subject) {
    SubjectIncomparable { because: b } =>
      (b as String).contains("collective transport") && (b as String).contains("never read")
    SameSubject => false
    DifferentSubject { axes: _, left: _, right: _ } => false
  }
}

// THE TOPOLOGY "CUT" MOVES TWO MODELLED AXES, NOT ONE, AND THE FOLD IS WHAT REVEALED IT.
//
// This row was written expecting AxisDeltaUndecidable, on the reasoning that the transport is unread
// on both arms. It is not undecidable: the arms differ on TOPOLOGY and on RANK POPULATION -- 4 ranks
// against 2 -- and a known difference outranks an unknown axis, so the delta is AxisDeltaOnManyAxes.
//
// THAT IS THE TRUER ANSWER AND THE MODULE'S OWN PROSE ALREADY SAID SO: "the participant count and
// message geometry, each rank's weight shard, per-rank memory traffic, the expert partition, the
// quantized kernel shapes, the reduction order, and the compiled graph shapes all move together".
// Carrying the rank population as its own axis is what turns that paragraph into a fold. A reader
// asking whether this experiment isolates one variable now gets "no, two modelled axes moved" from
// the value rather than from a careful reading of a comment.
//
// AND THE TRANSPORT REMAINS PERMANENTLY UNREAD ON BOTH ARMS. An earlier version of this comment
// promised the row would flip to a one-axis cut "the moment NCCL's verdict is read on a relaunch of
// either arm". Wrong twice: reading ONE arm leaves the other unread, and a transport reading from a
// FUTURE relaunch cannot be attached backwards to performance measured on an earlier launch. A
// relaunch is a new subject and a new experiment, never a repair of this one.
test fn w_the_topology_cut_moves_two_axes_rather_than_isolating_the_degree() -> Bool {
  match spark_group_a_topology_axis_delta {
    AxisDeltaOnManyAxes { axes: axes } =>
      (axes as String).contains("topology") && (axes as String).contains("rank population")
    AxisDeltaUndecidable { because: _ } => false
    AxisDeltaOnOneAxis { axis: _ } => false
    AxisDeltaNone => false
  }
}

// ── THE DEGREE INVERSE IS TOTAL, AND ITS REFUSAL ARM IS REACHABLE ─────────────────────────────
//
// The forward map and its derived inverse agree on every topology the fleet models, and a rank
// count no topology carries answers Absent rather than the nearest plausible degree. That second
// half is the one that matters: the arm it replaced turned every unmapped count into TP=4 on the
// axis this module fences, and an admission arm whose refusal cannot be reached is not a wall.
test fn w_every_modelled_topology_round_trips_through_its_rank_count() -> Bool {
  topology_round_trips(t: SingleSparkTp1)
    && topology_round_trips(t: SparkPairTp2)
    && topology_round_trips(t: FourSparkTp4)
}

fn topology_round_trips(t: ServingTopology) -> Bool {
  match serving_topology_of_rank_count(ranks: serving_topology_rank_count(t: t)) {
    Absent => false
    Present { value: got } => (serving_topology_wire(t: got) as String) == (serving_topology_wire(t: t) as String)
  }
}

test fn w_an_unmodelled_rank_count_refuses_rather_than_choosing_the_nearest() -> Bool {
  match serving_topology_of_rank_count(ranks: 8) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn w_a_zero_rank_count_refuses_too() -> Bool {
  match serving_topology_of_rank_count(ranks: 0) {
    Absent => true
    Present { value: _ } => false
  }
}

// ── THE AXES THE FIRST ROUND OMITTED, EACH ONE LOAD-BEARING ON ITS OWN ────────────────────────
//
// A review found the subject comparing `runtime` by its static enum wire, so a REPIN of the image
// behind one runtime arm kept reading SameSubject -- a subject weaker than gunbc.spark.serving_arm,
// which refuses exactly that move. Same for the checkpoint revision, max_num_seqs (the brief's own
// candidate 3), the speculative policy the prefill module says expires a budget measurement, and the
// rank population the topology arms carry independently of their declared degree. Each gets a row,
// because an axis nothing exercises is an axis that can be dropped without anything going red.
fn moved(base: ServingPerformanceSubject, which: ServingSubjectAxis) -> ServingPerformanceSubject {
  serving_performance_subject(
    checkpoint: base.checkpoint,
    checkpoint_revision: if axis_is(a: which, b: AxisCheckpointRevision) { Present { value: "0000000000000000000000000000000000000000" as NonEmptyStr } } else { base.checkpoint_revision },
    runtime: base.runtime,
    runtime_image_reference: if axis_is(a: which, b: AxisRuntimeImageReference) { "repo@sha256:zzz" as NonEmptyStr } else { base.runtime_image_reference },
    topology: base.topology,
    rank_population: if axis_is(a: which, b: AxisRankPopulation) { bumped_rank(base: base) } else { base.rank_population },
    context_ceiling: base.context_ceiling,
    max_num_batched_tokens: base.max_num_batched_tokens,
    max_num_seqs: if axis_is(a: which, b: AxisMaxNumSeqs) { bumped_seqs(base: base) } else { base.max_num_seqs },
    kv_cache_dtype: base.kv_cache_dtype,
    speculative: if axis_is(a: which, b: AxisSpeculativePolicy) { Present { value: SpeculativeDecodingOn { proposer: "draft" as NonEmptyStr } } } else { base.speculative },
    collective_transport: base.collective_transport
  )
}

// THE BUMP GOES THROUGH THE OPTIONAL rather than substituting a literal, so the moved subject keeps
// the same absent/present shape as its base on every axis but the one under test.
fn bumped_rank(base: ServingPerformanceSubject) -> Nat? {
  match base.rank_population {
    Absent => Present { value: 1 }
    Present { value: r } => Present { value: r + 1 }
  }
}

fn bumped_seqs(base: ServingPerformanceSubject) -> Nat? {
  match base.max_num_seqs {
    Absent => Present { value: 1 }
    Present { value: n } => Present { value: n + 1 }
  }
}

fn axis_is(a: ServingSubjectAxis, b: ServingSubjectAxis) -> Bool {
  (serving_subject_axis_wire(a: a) as String) == (serving_subject_axis_wire(a: b) as String)
}

fn moving_one_axis_prevents_transfer(a: ServingSubjectAxis) -> Bool {
  let j = serving_subject_reads(measurement_subject: fx_deepseek_tp4, decision_subject: moved(base: fx_deepseek_tp4, which: a))
  join_is_different(j: j) && join_names_axis(j: j, a: a)
}

test fn w_a_repinned_runtime_image_is_a_different_subject() -> Bool {
  moving_one_axis_prevents_transfer(a: AxisRuntimeImageReference)
}

test fn w_a_different_checkpoint_revision_is_a_different_subject() -> Bool {
  moving_one_axis_prevents_transfer(a: AxisCheckpointRevision)
}

test fn w_a_different_max_num_seqs_is_a_different_subject() -> Bool {
  moving_one_axis_prevents_transfer(a: AxisMaxNumSeqs)
}

test fn w_turning_speculation_on_is_a_different_subject() -> Bool {
  moving_one_axis_prevents_transfer(a: AxisSpeculativePolicy)
}

test fn w_a_different_rank_population_is_a_different_subject() -> Bool {
  moving_one_axis_prevents_transfer(a: AxisRankPopulation)
}

// ── AN UNKNOWN AXIS MUST NOT ERASE A DIFFERENCE THAT IS ALREADY ESTABLISHED ───────────────────
//
// The first round short-circuited to Incomparable the moment either side's transport was unread,
// BEFORE comparing anything. So two subjects on different checkpoints came back "I cannot tell",
// when the checkpoint alone already settles that the measurement does not transfer. Destroying an
// established counterexample because a DIFFERENT axis is unknown is the absorbing fallback aimed at
// the answer rather than at the ignorance.
test fn w_a_known_checkpoint_difference_survives_an_unread_transport() -> Bool {
  let ds_unread = ServingPerformanceSubject_with_unread(base: fx_deepseek_tp4)
  let glm_unread = ServingPerformanceSubject_with_unread(base: fx_glm_group_b)
  let j = serving_subject_reads(measurement_subject: ds_unread, decision_subject: glm_unread)
  join_is_different(j: j) && join_names_axis(j: j, a: AxisCheckpoint)
    && !join_names_axis(j: j, a: AxisCollectiveTransport)
}

fn ServingPerformanceSubject_with_unread(base: ServingPerformanceSubject) -> ServingPerformanceSubject {
  serving_performance_subject(
    checkpoint: base.checkpoint,
    checkpoint_revision: base.checkpoint_revision,
    runtime: base.runtime,
    runtime_image_reference: base.runtime_image_reference,
    topology: base.topology,
    rank_population: base.rank_population,
    context_ceiling: base.context_ceiling,
    max_num_batched_tokens: base.max_num_batched_tokens,
    max_num_seqs: base.max_num_seqs,
    kv_cache_dtype: base.kv_cache_dtype,
    speculative: base.speculative,
    collective_transport: Absent
  )
}

// AND WHEN NOTHING KNOWN DIFFERS, THE UNKNOWN AXIS IS THE ANSWER. This is the other half: the same
// subject against itself with an unread transport is Incomparable, not Same.
test fn w_an_unread_axis_decides_only_when_nothing_known_differs() -> Bool {
  let a = ServingPerformanceSubject_with_unread(base: fx_deepseek_tp4)
  join_is_incomparable(j: serving_subject_reads(measurement_subject: a, decision_subject: a))
}

// ── A TRANSPORT VARIANT CANNOT CONTRADICT ITS OWN WIRE ────────────────────────────────────────
//
// The read arms used to carry `network_name: NonEmptyStr` and project the caller's string, so
// `NcclTransportSocket { network_name: "IB" }` was writable and every comparator trusted it. The
// name is now derived from the arm, so that state has no spelling; this asserts the derivation.
test fn w_the_transport_wire_is_derived_from_the_variant() -> Bool {
  (nccl_realized_transport_wire(t: fx_socket) as String) == (nccl_network_name_socket as String)
    && (nccl_realized_transport_wire(t: fx_ib) as String) == (nccl_network_name_ib as String)
}

// ── AN ESTABLISHED STANDING IS UNCONSTRUCTIBLE AROUND AN UNREAD AXIS ──────────────────────────
//
// The standing used to be two arms and both bound fleet rows sat in `SubjectEstablished` while
// declaring their transport never read. Absence now lives in ONE place -- the subject's optional
// axes -- and `serving_subject_standing` reads it off the subject, so Established is not refused at
// runtime, it is unreachable for such a subject through the only route that builds one.
test fn w_a_subject_with_an_absent_axis_cannot_become_established() -> Bool {
  match serving_subject_standing(subject: ServingPerformanceSubject_with_unread(base: fx_deepseek_tp4), believed: "fixture belief" as NonEmptyStr, would_settle: "fixture remedy" as NonEmptyStr) {
    SubjectPartial { subject: _, unknown_axes: axes } => (axes as String).contains("collective transport")
    SubjectEstablished { subject: _ } => false
  }
}

// THE POSITIVE CONTROL: a subject with every axis read DOES become established, so the constructor
// is not a wall that refuses everything.
test fn w_a_fully_read_subject_becomes_established() -> Bool {
  match serving_subject_standing(subject: fx_deepseek_tp4, believed: "fixture belief" as NonEmptyStr, would_settle: "fixture remedy" as NonEmptyStr) {
    SubjectEstablished { subject: _ } => true
    SubjectPartial { subject: _, unknown_axes: _ } => false
  }
}

// AND A PARTIAL STANDING STILL CARRIES ITS SUBJECT, which is what lets a known difference survive an
// unknown axis rather than collapsing to "I cannot tell".
test fn w_a_partial_standing_still_carries_its_subject() -> Bool {
  let st = serving_subject_standing(subject: ServingPerformanceSubject_with_unread(base: fx_deepseek_tp4), believed: "fixture belief" as NonEmptyStr, would_settle: "fixture remedy" as NonEmptyStr)
  (serving_subject_axis_value(s: standing_subject(st: st), a: AxisCheckpoint) as String)
    == (serving_subject_axis_value(s: fx_deepseek_tp4, a: AxisCheckpoint) as String)
}

test fn w_all_serving_performance_subject_claims_hold() -> Bool {
  w_a_deepseek_measurement_does_not_read_for_a_glm_decision()
    && w_the_refusal_does_not_name_axes_that_agree()
    && w_a_subject_reads_for_itself()
    && w_moving_the_topology_alone_is_detected_and_named()
    && w_moving_the_batch_budget_alone_is_detected_and_named()
    && w_moving_the_kv_dtype_alone_is_detected_and_named()
    && w_socket_and_rdma_are_different_subjects()
    && w_an_unread_transport_is_incomparable_and_never_equal()
    && w_a_partial_standing_names_its_gap_and_the_remedy()
    && w_a_one_axis_cut_is_controlled_and_names_that_axis()
    && w_a_multi_axis_pair_is_uncontrolled_rather_than_attributed()
    && w_two_identical_subjects_are_a_repeat_and_not_a_cut()
    && w_the_axis_roster_is_not_degenerate()
    && w_a_repinned_runtime_image_is_a_different_subject()
    && w_a_different_checkpoint_revision_is_a_different_subject()
    && w_a_different_max_num_seqs_is_a_different_subject()
    && w_turning_speculation_on_is_a_different_subject()
    && w_a_different_rank_population_is_a_different_subject()
    && w_a_known_checkpoint_difference_survives_an_unread_transport()
    && w_an_unread_axis_decides_only_when_nothing_known_differs()
    && w_the_transport_wire_is_derived_from_the_variant()
    && w_a_subject_with_an_absent_axis_cannot_become_established()
    && w_a_fully_read_subject_becomes_established()
    && w_a_partial_standing_still_carries_its_subject()
    && w_every_modelled_topology_round_trips_through_its_rank_count()
    && w_an_unmodelled_rank_count_refuses_rather_than_choosing_the_nearest()
    && w_a_zero_rank_count_refuses_too()
    && w_every_batch_arm_carries_its_own_partial_subject()
    && w_the_depth_law_does_not_read_for_the_batch_arms()
    && w_a_live_batch_arm_refuses_a_glm_decision_by_naming_the_checkpoint()
    && w_the_depth_law_does_not_even_read_for_itself_while_its_transport_is_unread()
    && w_the_topology_cut_moves_two_axes_rather_than_isolating_the_degree()
}
