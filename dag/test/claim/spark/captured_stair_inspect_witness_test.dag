// The 22 names the readback of launch 37172948981 refused as unplanned -- the vLLM image's own Config.Env.
data captured_stair_image_env_names: List<String> = ["PATH", "NVARCH", "NVIDIA_REQUIRE_CUDA", "NV_CUDA_CUDART_VERSION", "CUDA_VERSION", "LD_LIBRARY_PATH", "NVIDIA_VISIBLE_DEVICES", "NVIDIA_DRIVER_CAPABILITIES", "DEBIAN_FRONTEND", "UV_HTTP_TIMEOUT", "UV_INDEX_STRATEGY", "UV_LINK_MODE", "UV_PYTHON_INSTALL_DIR", "UV_CACHE_DIR", "UV_OVERRIDE", "VLLM_ENABLE_CUDA_COMPATIBILITY", "TORCH_CUDA_ARCH_LIST", "VLLM_USAGE_SOURCE", "VLLM_BUILD_COMMIT", "VLLM_BUILD_PIPELINE", "VLLM_BUILD_URL", "VLLM_IMAGE_TAG"]

fn captured_doc() -> ContainerInspect? {
  match container_inspect_from_stdout(stdout: captured_stair_inspect_srv7) {
    ContainerInspectUnreadable { cause: _ } => none
    ContainerInspectDecoded { container: c } => Present { value: c }
  }
}

fn captured_image_env(c: ContainerInspect) -> List<String> {
  match observed_env_assignments(c: c) {
    Absent => []
    Present { value: env } => filter(env, a => any(captured_stair_image_env_names, n => starts_with(s: a, prefix: join([n, "="], ""))))
  }
}

// THE MOUNT THE RENDERER ASKED FOR IS WHERE THE DAEMON PUT IT: HostConfig.Mounts carries the one read-only
// bind of the Hub cache at /weights, and the document carries no Binds at all.
test fn captured_inspect_reports_the_bind_in_hostconfig_mounts() -> Bool {
  match captured_doc() {
    Absent => false
    Present { value: c } =>
      c.image == "sha256:6ef84cd49a68dbefd957bfca36f0ec458ed80f8194def41642e7b37b34ae76fb"
        && match c.host_config {
             Absent => false
             Present { value: hc } =>
               match hc.mounts {
                 Absent => false
                 Present { value: ms } =>
                   count(ms) == 1
                     && all(ms, m => (m.kind as String) == "bind" && m.source == "/home/briansrls/.cache/huggingface/hub" && (m.target as String) == "/weights" && m.read_only)
               }
           }
  }
}

// THE IMAGE'S OWN ASSIGNMENTS ARE INHERITED BY ASSIGNMENT on the captured document: none of the 22 refuses
// against the image env they came from, and the same names against an image whose PATH differs leave
// exactly the container's PATH as an override nobody planned.
test fn captured_image_env_is_inherited_and_a_changed_path_is_not() -> Bool {
  match captured_doc() {
    Absent => false
    Present { value: c } => {
      let image_env = captured_image_env(c: c)
      let changed = map(image_env, a => if starts_with(s: a, prefix: "PATH=") { "PATH=/usr/bin" } else { a })
      count(image_env) == count(captured_stair_image_env_names)
        && count(spark_native_unplanned_assignments(observed: c, unclaimed_names: captured_stair_image_env_names, image_env: image_env)) == 0
        && spark_native_unplanned_assignments(observed: c, unclaimed_names: captured_stair_image_env_names, image_env: changed)
             == filter(image_env, a => starts_with(s: a, prefix: "PATH="))
    }
  }
}
