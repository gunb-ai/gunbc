// ── FIXTURES, HERMETIC AND NOT REPRESENTABLE AS ACQUIRED EVIDENCE ───────────────────────────────
//
// These drive the CONSTRUCTOR rather than reading the production row. A witness that destructures a
// data declaration is a type dependency: it consumes no decision, and it stays green while the
// function that builds that data is broken. Every claim below calls something.
data w_fixture_host: HostIdentity = "w-vllm-front-door" as HostIdentity

fn w_scope(host: HostIdentity) -> VllmHistoricalFrontDoorScope {
  vllm_historical_front_door_scope(
    front_door_host: host, observed_on: "w-fixture-date" as NonEmptyStr)
}

fn w_models_route() -> VllmModelsRouteReadback {
  vllm_models_route_readback(
    served_model_id: "w-model:iq3s-alias" as NonEmptyStr,
    configured_model_path: "w/path/to/checkpoint" as NonEmptyStr,
    max_model_len: token_count(count: 1024))
}

fn w_not_served() -> VllmEvidenceRouteResponse {
  EvidenceRouteNotServed { http_status: "404" as NonEmptyStr }
}

fn w_answered_unparsed() -> VllmEvidenceRouteResponse { EvidenceRouteAnsweredWithoutParse }

fn w_outcomes(response: VllmEvidenceRouteResponse) -> List<VllmEvidenceRouteOutcome> {
  map(vllm_http_parallel_evidence_routes, r => vllm_evidence_route_outcome(route: r, response: response))
}

fn w_bundle(host: HostIdentity, response: VllmEvidenceRouteResponse) -> VllmHistoricalReadbackBundle {
  vllm_historical_readback_bundle(
    scope: w_scope(host: host),
    models_route: w_models_route(),
    version_route: vllm_version_route_readback(server_version: "w-fixture-build" as NonEmptyStr),
    cache_config_gauge: vllm_cache_config_gauge_readback(
      kv_cache_dtype: "w-dtype" as NonEmptyStr,
      gpu_memory_utilization: basis_point(count: 5000),
      prefix_caching_enabled: true),
    parallel_evidence_observations: w_outcomes(response: response),
  )
}

// ── THE BINDING, WHICH IS THE DEFECT THIS REWORK EXISTS TO CLOSE ────────────────────────────────
//
// The refusal used to be a separate row that named its own host, so the readback could say srv5
// while the refusal said srv6 and every witness stayed green. The constructor now derives it from the
// historical scope. This drives the constructor with two DIFFERENT hosts and asserts the refusal
// followed each -- a claim about the derivation, not about either row.
//
// It is also the LIMIT of what the constructor binds: the route-local observations are independently
// retained facts, and the bundle stamps that their cross-route join was not captured rather than
// pretending this derivation established one.
test fn w_the_refusal_host_is_derived_from_the_historical_scope_it_belongs_to() -> Bool {
  w_bundle(host: w_fixture_host, response: w_not_served()).realization.front_door_host as String
    == w_fixture_host as String
  && w_bundle(host: operator_host_srv5, response: w_not_served()).realization.front_door_host as String
       == operator_host_srv5 as String
}

// ── BOTH LIMITATIONS ARE STAMPED, AND THEY ARE NOT THE SAME LIMITATION ─────────────────────────
//
// The bundle answers two different questions and must keep answering both. `acquisition_join` says
// the route observations could not be joined as one acquisition; `realization.missing` says no
// retained observation established resolved parallel configuration. Collapsing them would lose the
// first, which is the one that makes clear a LATER rank receipt cannot rehabilitate this row.
//
// Neither is caller-supplied: the constructor takes no argument for either, so this drives the real
// constructor and a version that accepted them from outside would not compile against this call.
test fn w_the_bundle_stamps_both_limitations_not_one() -> Bool {
  match w_bundle(host: w_fixture_host, response: w_not_served()).acquisition_join {
    CrossRouteAcquisitionJoinUnestablished { cause: c } => contains(c as String, "capture identity")
  }
  && match w_bundle(host: w_fixture_host, response: w_not_served()).realization.missing {
    ResolvedParallelConfigurationNotObserved => true
    JoinedRankPopulationNotObserved => false
  }
}

// AND AN ANSWER NOBODY PARSED DOES NOT MOVE EITHER OF THEM. This is the state a Bool recorded
// identically to a parsed answer: a 200 whose body was never read. There is no parsed-configuration
// arm to write here at all now -- the caller-authored capture was removed -- so the strongest input a
// fixture can supply still leaves the refusal at its earliest stage.
test fn w_an_unparsed_answer_leaves_the_refusal_at_its_earliest_stage() -> Bool {
  match w_bundle(host: w_fixture_host, response: w_answered_unparsed()).realization.missing {
    ResolvedParallelConfigurationNotObserved => true
    JoinedRankPopulationNotObserved => false
  }
}

// ── THE WORDING PROPERTY, OVER THE WHOLE VOCABULARY ─────────────────────────────────────────────
//
// A refusal phrased as "rank two did not answer" would model the absence of something vLLM never
// promised, and would go green the moment an unrelated server appeared on that port. Quantified over
// both arms so the property belongs to the vocabulary rather than to whichever row is current.
test fn w_no_refusal_wording_blames_an_unanswered_port() -> Bool {
  all(
    [ResolvedParallelConfigurationNotObserved, JoinedRankPopulationNotObserved],
    m => !contains(vllm_tp_realization_missing_wire(missing: m), "port")
           && !contains(vllm_tp_realization_missing_wire(missing: m), "unreachable")
           && !contains(vllm_tp_realization_missing_wire(missing: m), "did not answer"))
    && contains(
         vllm_tp_realization_refusal_cause(
           refusal: w_bundle(host: w_fixture_host, response: w_not_served()).realization),
         "missing positive fact")
}

// ── THE CAPACITY LAW CLASSIFIES SOURCE KINDS; IT ADMITS NO EVIDENCE ────────────────────────────
//
// The previous version took a proposal carrying a "capture" of two arbitrary strings and echoed it
// back as `CapacityEvidenceAdmitted`, so a caller writing ("w-pool", "w-req") received an admission
// and the witness proved only that a caller-authored payload reaches its matching branch. Nothing
// here has a capacity capture, so the law says which KIND of source would be authoritative and stops
// there. Both directions execute.
test fn w_cache_config_block_fields_are_insufficient_as_a_capacity_source() -> Bool {
  match decide_vllm_capacity_source_kind(kind: CacheConfigBlockFields).decision {
    CapacitySourceInsufficient { cause: c } => contains(c, "not a generally sufficient")
    CapacitySourceAuthoritative => false
  }
}

// AND THE REFUSAL NAMES THE TWO AXES SEPARATELY, because the earlier wording called block_size a
// minimum "across ranks" and conflated them: the scheduler selects block_size across resolved cache
// GROUPS, while num_blocks is separately reduced across WORKERS. The product joins values from
// different axes, which is why it is not capacity even when it happens to coincide with it.
test fn w_the_capacity_refusal_does_not_conflate_groups_with_ranks() -> Bool {
  match decide_vllm_capacity_source_kind(kind: CacheConfigBlockFields).decision {
    CapacitySourceInsufficient { cause: c } =>
      contains(c, "MINIMUM ACROSS RESOLVED CACHE GROUPS") && contains(c, "ACROSS WORKERS")
    CapacitySourceAuthoritative => false
  }
}

test fn w_the_group_aware_startup_log_is_the_authoritative_source_kind() -> Bool {
  match decide_vllm_capacity_source_kind(kind: GroupAwareStartupLog).decision {
    CapacitySourceAuthoritative => true
    CapacitySourceInsufficient { cause: _ } => false
  }
}

// AND THE OBSERVATION MODULE ACTUALLY CONSULTS THAT LAW rather than restating it.
test fn w_the_observed_capacity_path_reaches_the_refusal() -> Bool {
  match vllm_capacity_from_cache_config_fields().decision {
    CapacitySourceInsufficient { cause: _ } => true
    CapacitySourceAuthoritative => false
  }
}

// AND THE RULING CANNOT BE RECEIVED WITHOUT THE REVISION THAT BOUNDS IT.
//
// The route population and the health fact each carried `established_against` while the capacity
// ruling did not, so a consumer could hold "cache-config fields are insufficient" with nothing
// saying which source that was read from -- and the revision row could drift while these witnesses
// stayed green. This consumes the exact full revision from the returned assessment, so a drift is a
// red here rather than a silent re-scoping.
test fn w_the_capacity_assessment_carries_the_exact_source_revision() -> Bool {
  decide_vllm_capacity_source_kind(kind: CacheConfigBlockFields).established_against.full_revision as String
    == "1967a5627bc3710b680bbec24ecb99aaddedf22b"
    && vllm_capacity_from_cache_config_fields().established_against.full_revision as String
         == vllm_source_revision_read.full_revision as String
}

// ── THE UPSTREAM FACTS THAT HAD NO WITNESS AT ALL ───────────────────────────────────────────────
//
// Each of these was previously flippable with the whole suite staying green.
test fn w_ray_health_does_not_probe_distributed_workers() -> Bool {
  match vllm_health_coverage_for(backend: RayDistributedExecutor) {
    HealthCoverageEstablished { coverage: c, established_against: _ } => match c {
      HealthDoesNotProbeDistributedWorkers => true
      HealthProbesEveryDistributedWorker => false
    }
    HealthCoverageNotEstablishedForBackend => false
  }
}

// AND A BACKEND THIS REPOSITORY HAS NOT READ THE SOURCE FOR GETS SILENCE, NOT RAY'S ANSWER.
//
// `backend` was written once and read by nothing, under an annotation claiming a consumer asking
// about another backend "gets no answer here rather than a borrowed one" -- which prose cannot make
// true. The only reachable path was the Ray row, so a multiprocessing deployment would have read
// Ray's coverage off it. This is the discriminating RED for that: it was unauthorable before the
// lookup existed, because there was no question to ask.
test fn w_a_backend_with_no_established_coverage_refuses_rather_than_borrowing() -> Bool {
  match vllm_health_coverage_for(backend: MultiprocessingDistributedExecutor) {
    HealthCoverageNotEstablishedForBackend => true
    HealthCoverageEstablished { coverage: _, established_against: _ } => false
  }
}

// AND HEALTH IS ORDINARILY REGISTERED, WHICH IS WHAT MAKES IT THE TEMPTING WRONG SUBSTITUTE: it is
// reachable exactly when the evidence routes are not.
test fn w_health_is_reachable_precisely_when_the_evidence_routes_are_not() -> Bool {
  match vllm_route_health.population {
    OrdinarilyRegistered => true
    RegisteredOnlyUnderDevelopmentMode => false
  }
  && all(vllm_http_parallel_evidence_routes, r => match vllm_parallel_evidence_route_path(route: r).population {
       RegisteredOnlyUnderDevelopmentMode => true
       OrdinarilyRegistered => false
     })
}

// ── THE PRODUCTION ROW, PINNED ONCE ─────────────────────────────────────────────────────────────
//
// The served alias carries a quantisation token that is NOT DERIVABLE from the configured path.
// This is the one claim that reads the production row, because the non-derivability IS the
// observation -- pinned so a later edit that tidies the id to match the path cannot quietly erase the
// evidence that the alias is not artifact identity.
//
// It deliberately does NOT assert a contradiction. A served-model name is allowed to be arbitrary and
// a directory name does not establish what its contents are quantised to, so "the path disagrees"
// would be a stronger claim than anything observed -- the same overreach this module already
// retracted once about the weights.
test fn w_the_served_id_is_not_derivable_from_the_configured_path() -> Bool {
  vllm_served_id_is_not_derivable_from_configured_path(
    readback: vllm_readback_2026_09_03.models_route)
    && match vllm_readback_2026_09_03.realization.missing {
         ResolvedParallelConfigurationNotObserved => true
         JoinedRankPopulationNotObserved => false
       }
}

// ── THE ROUTE IDENTITY DECIDES ITS KIND, AND THE THREE ARE NOT INTERCHANGEABLE ─────────────────
//
// This is the fact the earlier stage law depended on and could not enforce: the kind used to be
// PAIRED with the route by a public constructor, so `(get_world_size, ResolvedParallelConfiguration)`
// was writable and would have been read as configuration-bearing. It is now a projection of a closed
// route identity, so the claim below is about the upstream population rather than about whichever
// pairing a caller last wrote.
//
// A world size of 2 is consistent with TP=2, PP=2 and DP=2 alike, and a per-worker fan-out reports
// population without saying how the parallelism decomposes. Only /server_info returns the resolved
// configuration.
test fn w_only_the_server_info_route_bears_resolved_parallel_configuration() -> Bool {
  vllm_evidence_kind_establishes_configuration(kind: vllm_parallel_evidence_kind(route: ServerInfoRoute))
    && !vllm_evidence_kind_establishes_configuration(kind: vllm_parallel_evidence_kind(route: GetWorldSizeRoute))
    && !vllm_evidence_kind_establishes_configuration(kind: vllm_parallel_evidence_kind(route: CollectiveRpcRoute))
}

// AND EVERY ROUTE IN THE HTTP EVIDENCE POPULATION IS ONE OF THOSE THREE IDENTITIES, so the projection
// above covers the population rather than three rows that happen to be listed.
test fn w_the_http_evidence_population_is_exactly_the_closed_route_identity() -> Bool {
  length(vllm_http_parallel_evidence_routes) == 3
    && any(vllm_http_parallel_evidence_routes, r =>
         vllm_evidence_kind_establishes_configuration(kind: vllm_parallel_evidence_kind(route: r)))
    && length(filter(vllm_http_parallel_evidence_routes, r =>
         vllm_evidence_kind_establishes_configuration(kind: vllm_parallel_evidence_kind(route: r)))) == 1
}

// THE NUMERIC READBACKS ARE COMPARABLE, WHICH IS THE WHOLE POINT OF TYPING THEM.
//
// As captured strings these were blobs: nothing could ask whether the context length was large, or
// whether utilization sat below unity. Both questions are now answerable, and this claim asks them --
// so a regression back to text does not merely change a type, it stops this witness compiling.
test fn w_the_numeric_readbacks_are_measures_that_can_be_compared() -> Bool {
  token_count_value(vllm_readback_2026_09_03.models_route.max_model_len) == 262144
    && basis_point_count(vllm_readback_2026_09_03.cache_config_gauge.gpu_memory_utilization)
         < basis_point_unity_count()
}
