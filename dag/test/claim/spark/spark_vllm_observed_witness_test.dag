module test.claim.spark.spark_vllm_observed_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.spark.vllm_observed {
  VllmModelsRouteReadback,
  VllmVersionRouteReadback,
  VllmCacheConfigGaugeReadback,
  VllmReadbackAcquisition,
  VllmReadbackTransaction,
  vllm_readback_acquisition,
  vllm_models_route_readback,
  vllm_version_route_readback,
  vllm_cache_config_gauge_readback,
  vllm_evidence_route_outcome,
  VllmEvidenceRouteOutcome,
  VllmTpRealizationMissingEvidence,
  ResolvedParallelConfigurationNotObserved,
  JoinedRankPopulationNotObserved,
  VllmTpRealizationRefusal,
  vllm_readback_transaction,
  vllm_missing_evidence_for,
  vllm_tp_realization_missing_wire,
  vllm_tp_realization_refusal_cause,
  vllm_capacity_from_cache_config_fields,
  vllm_readback_2026_09_03,
}
import extdeps.vllm.server {
  VllmRoute,
  VllmRoutePopulation,
  OrdinarilyRegistered,
  RegisteredOnlyUnderDevelopmentMode,
  VllmBuildIdentity,
  vllm_build_identity,
  vllm_parallel_evidence_routes,
  vllm_route_health,
  vllm_ray_health_coverage,
  VllmHealthWorkerCoverage,
  HealthDoesNotProbeDistributedWorkers,
  HealthProbesEveryDistributedWorker,
  VllmCapacityEvidenceProposal,
  GroupAwareStartupLogCapture,
  CacheConfigBlockFields,
  VllmCapacityEvidenceVerdict,
  CapacityEvidenceAdmitted,
  CapacityEvidenceRefused,
  decide_vllm_capacity_evidence,
}

// ── FIXTURES, HERMETIC AND NOT REPRESENTABLE AS ACQUIRED EVIDENCE ───────────────────────────────
//
// These drive the CONSTRUCTOR rather than reading the production row. A witness that destructures a
// data declaration is a type dependency: it consumes no decision, and it stays green while the
// function that builds that data is broken. Every claim below calls something.
data w_fixture_host: HostIdentity = "w-vllm-front-door" as HostIdentity

fn w_acquisition(host: HostIdentity) -> VllmReadbackAcquisition {
  vllm_readback_acquisition(
    front_door_host: host,
    observed_on: "w-fixture-date" as NonEmptyStr,
    build: vllm_build_identity(version_string: "w-fixture-build" as NonEmptyStr))
}

fn w_models_route() -> VllmModelsRouteReadback {
  vllm_models_route_readback(
    served_model_id: "w-model:iq3s-alias" as NonEmptyStr,
    configured_model_path: "w/path/to/checkpoint" as NonEmptyStr,
    max_model_len: "1024" as NonEmptyStr)
}

fn w_outcomes(answered: Bool) -> List<VllmEvidenceRouteOutcome> {
  map(vllm_parallel_evidence_routes, r => vllm_evidence_route_outcome(route: r, answered: answered))
}

fn w_transaction(host: HostIdentity, answered: Bool) -> VllmReadbackTransaction {
  vllm_readback_transaction(
    acquisition: w_acquisition(host: host),
    models_route: w_models_route(),
    version_route: vllm_version_route_readback(server_version: "w-fixture-build" as NonEmptyStr),
    cache_config_gauge: vllm_cache_config_gauge_readback(
      kv_cache_dtype: "w-dtype" as NonEmptyStr,
      gpu_memory_utilization: "0.5" as NonEmptyStr,
      prefix_caching_enabled: true),
    parallel_evidence_outcomes: w_outcomes(answered: answered),
  )
}

// ── THE BINDING, WHICH IS THE DEFECT THIS REWORK EXISTS TO CLOSE ────────────────────────────────
//
// The refusal used to be a separate row that named its own host, so the readback could say srv5
// while the refusal said srv6 and every witness stayed green. The constructor now derives it. This
// drives the constructor with two DIFFERENT hosts and asserts the refusal followed each -- which is
// a claim about the derivation, not about either row.
test fn w_the_refusal_host_is_derived_from_the_acquisition_it_belongs_to() -> Bool {
  w_transaction(host: w_fixture_host, answered: false).realization.front_door_host as String
    == w_fixture_host as String
  && w_transaction(host: operator_host_srv5, answered: false).realization.front_door_host as String
       == operator_host_srv5 as String
}

// ── THE STAGE IS DERIVED FROM THE OUTCOMES, BOTH DIRECTIONS ─────────────────────────────────────
//
// Nothing answered means the configuration stage was never reached, so the refusal is the earlier
// arm. Something answering moves the open question to the population. Both are driven through the
// real function, so an implementation that hardcoded either arm fails here.
test fn w_the_missing_stage_follows_whether_any_evidence_route_answered() -> Bool {
  match vllm_missing_evidence_for(outcomes: w_outcomes(answered: false)) {
    ResolvedParallelConfigurationNotObserved => true
    JoinedRankPopulationNotObserved => false
  }
  && match vllm_missing_evidence_for(outcomes: w_outcomes(answered: true)) {
    JoinedRankPopulationNotObserved => true
    ResolvedParallelConfigurationNotObserved => false
  }
}

// AND THE TRANSACTION CARRIES THAT SAME DERIVATION rather than a separately supplied stage.
test fn w_the_transaction_carries_the_derived_stage_and_not_a_supplied_one() -> Bool {
  match w_transaction(host: w_fixture_host, answered: true).realization.missing {
    JoinedRankPopulationNotObserved => true
    ResolvedParallelConfigurationNotObserved => false
  }
}

// ── THE WORDING PROPERTY, OVER THE WHOLE VOCABULARY ─────────────────────────────────────────────
//
// A refusal phrased as "rank two did not answer" would model the absence of something vLLM never
// promised, and would go green the moment an unrelated server appeared on that port. Quantified over
// both arms so the property belongs to the vocabulary rather than to whichever row is current.
test fn w_no_refusal_wording_blames_an_unanswered_port() -> Bool {
  all(
    [ResolvedParallelConfigurationNotObserved, JoinedRankPopulationNotObserved],
    m => !contains(vllm_tp_realization_missing_wire(missing: m), "port")
           && !contains(vllm_tp_realization_missing_wire(missing: m), "unreachable")
           && !contains(vllm_tp_realization_missing_wire(missing: m), "did not answer"))
    && contains(
         vllm_tp_realization_refusal_cause(
           refusal: w_transaction(host: w_fixture_host, answered: false).realization),
         "missing positive fact")
}

// ── THE CAPACITY LAW, AS A DECISION WITH BOTH DIRECTIONS REACHABLE ──────────────────────────────
//
// The previous shape was a coproduct whose two arms were simultaneous facts, so the rejection of the
// multiplication was carried by prose and by an uninhabited alternative. As a decision both
// directions execute, and the refusal is checked to state the GENERAL law rather than an arithmetic
// complaint -- for a uniform layout the product may coincide with the right answer.
test fn w_cache_config_block_fields_are_refused_as_a_capacity_authority() -> Bool {
  match decide_vllm_capacity_evidence(proposal: CacheConfigBlockFields) {
    CapacityEvidenceRefused { cause: c } => contains(c, "not a generally sufficient")
    CapacityEvidenceAdmitted => false
  }
}

test fn w_the_group_aware_startup_capture_is_the_admitted_capacity_evidence() -> Bool {
  match decide_vllm_capacity_evidence(proposal: GroupAwareStartupLogCapture) {
    CapacityEvidenceAdmitted => true
    CapacityEvidenceRefused { cause: _ } => false
  }
}

// AND THE OBSERVATION MODULE ACTUALLY CONSULTS THAT LAW rather than restating it.
test fn w_the_observed_capacity_path_reaches_the_refusal() -> Bool {
  match vllm_capacity_from_cache_config_fields() {
    CapacityEvidenceRefused { cause: _ } => true
    CapacityEvidenceAdmitted => false
  }
}

// ── THE UPSTREAM FACTS THAT HAD NO WITNESS AT ALL ───────────────────────────────────────────────
//
// Each of these was previously flippable with the whole suite staying green.
test fn w_ray_health_does_not_probe_distributed_workers() -> Bool {
  match vllm_ray_health_coverage.coverage {
    HealthDoesNotProbeDistributedWorkers => true
    HealthProbesEveryDistributedWorker => false
  }
}

// AND HEALTH IS ORDINARILY REGISTERED, WHICH IS WHAT MAKES IT THE TEMPTING WRONG SUBSTITUTE: it is
// reachable exactly when the evidence routes are not.
test fn w_health_is_reachable_precisely_when_the_evidence_routes_are_not() -> Bool {
  match vllm_route_health.population {
    OrdinarilyRegistered => true
    RegisteredOnlyUnderDevelopmentMode => false
  }
  && all(vllm_parallel_evidence_routes, r => match r.population {
       RegisteredOnlyUnderDevelopmentMode => true
       OrdinarilyRegistered => false
     })
}

// ── THE PRODUCTION ROW, PINNED ONCE ─────────────────────────────────────────────────────────────
//
// The id advertises a quantisation the configured path contradicts. This is the one claim that reads
// the production row, because the disagreement IS the observation -- and it is asserted as a
// disagreement so a later edit that tidies the id to match the path cannot quietly erase the
// evidence that an alias can lie.
test fn w_the_served_id_advertises_a_quantisation_the_configured_path_contradicts() -> Bool {
  contains(vllm_readback_2026_09_03.models_route.served_model_id as String, "iq3s")
    && !contains(vllm_readback_2026_09_03.models_route.configured_model_path as String, "iq3s")
    && match vllm_readback_2026_09_03.realization.missing {
         ResolvedParallelConfigurationNotObserved => true
         JoinedRankPopulationNotObserved => false
       }
}
