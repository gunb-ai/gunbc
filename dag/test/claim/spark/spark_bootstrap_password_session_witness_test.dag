module test.claim.spark_bootstrap_password_session_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.ssh.client_options { SshClientOption, BatchMode, serialize_ssh_client_options }
import gunbc.fleet_known_hosts_anchor { fleet_ssh_password_client_options }

// THE PASSWORD SESSION OFFERS THE PASSWORD AND NOTHING THE FAR SIDE HAS NEVER SEEN. A unit on its
// setup credential holds no fleet key, so the administrator legs must not offer one, must let
// sshpass answer the prompt (BatchMode off), and must keep whatever trust options the anchor gave.
fn w_words(trust: List<SshClientOption>) -> List<String> {
  serialize_ssh_client_options(options: fleet_ssh_password_client_options(trust: trust, principal: "briansrls" as NonEmptyStr))
}

test fn the_password_session_authenticates_by_password_with_the_prompt_enabled() -> Bool {
  let words = w_words(trust: [])
  any(words, x => x == "PreferredAuthentications=password,keyboard-interactive")
    && any(words, x => x == "BatchMode=no")
    && any(words, x => x == "User=briansrls")
}

test fn the_password_session_offers_no_identity_and_keeps_the_trust_words() -> Bool {
  let trust = [BatchMode { enabled: true }]
  let words = w_words(trust: trust)
  !any(words, x => starts_with(s: x, prefix: "IdentityFile="))
    && !any(words, x => starts_with(s: x, prefix: "IdentitiesOnly="))
    && (length(words) == length(w_words(trust: [])) + length(serialize_ssh_client_options(options: trust)))
}
