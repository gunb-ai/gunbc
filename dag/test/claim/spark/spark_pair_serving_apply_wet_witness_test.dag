module test.claim.spark.spark_pair_serving_apply_wet_witness

import std.logic { Bool }
import std.types { String, List, EpochSecs }
import v2.std.optional { Present, Absent }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.fabric_event_log_host { now_epoch_seconds }
import gunbc.spark.fabric_reach { ExecutorReachKnown, ExecutorReachUnknown, observe_executor_reach }
import gunbc.spark.pair_serving_apply { spark_pair_apply_plans, spark_pair_apply_plan_refusals }
import gunbc.spark.pair_serving_authority { spark_pair_serving_authorities }
import gunbc.spark.pair_serving_authority_log { CurrentAuthorityRead, CurrentAuthorityUnread, current_pair_serving_authorities }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE OFF-FLEET PREMISE IS SUPPLIED, NOT READ FROM THE RUNNER. test.claim.spark.spark_pair_serving_apply_witness
// drives the plan fold over a SUPPLIED roster. This file is the other half of DESIGN §3's pairing
// obligation: spark_pair_apply_plans resolves the executor's event log layout and reads every
// claimed group's authority from the log before planning anything. This claim once took the
// executor from the runner's hostname and assumed it declared no dashboard instance. That is false
// on srv1 runners, so the claim went red by placement (#12444 floor runs 36355617646 and
// 36361351081). The host is now supplied. The store resolution and the refusal that NAMES THE READ
// run for real on every runner, and nothing is planned from the resting row. Deleting the log read,
// or letting an unreadable log fall back to the row, turns these refusals into plans and this claim
// red.
data witness_host_declaring_no_dashboard_instance: String = "gunbc-witness-host-without-dashboard-instance"
data witness_instant: EpochSecs = 1000

test fn the_apply_seam_reads_the_authority_before_planning_and_refuses_off_fleet() -> Bool {
  let plans = spark_pair_apply_plans(executor: witness_host_declaring_no_dashboard_instance, at: witness_instant)
  let refusals = spark_pair_apply_plan_refusals(plans: plans)
  length(plans) == length(spark_pair_serving_authorities)
    && length(refusals) == length(plans)
    && all(refusals, r => string_contains(s: r, pattern: "the serving authority could not be read"))
}

// THE REAL READ, ON WHATEVER RUNNER THIS LANDS ON: the pairing claim for the supplied host above.
// The executor is the runner's own hostname and the log is really read. The ROUTE holds whether or
// not the runner can read the log: exactly the groups the log could not answer for are refused as
// unread, so an unreadable authority never becomes a plan and a readable one is never reported
// unreadable.
test fn the_apply_seam_refuses_exactly_what_the_runners_log_read_could_not_answer() -> Bool {
  match observe_executor_reach() {
    ExecutorReachUnknown { cause: _ } => false
    ExecutorReachKnown { short_hostname: executor, path: _ } =>
      match now_epoch_seconds() {
        Absent => false
        Present { value: at } => {
          let current = current_pair_serving_authorities(short_hostname: executor, at: at)
          let plans = spark_pair_apply_plans(executor: executor, at: at)
          let unread = filter(current, c => match c {
            CurrentAuthorityUnread { group: _, step: _, reason: _ } => true
            CurrentAuthorityRead { authority: _, head: _, generation: _, grant: _, entry_state: _, previous: _, admitted_by: _, transitions: _ } => false
          })
          let unread_refusals = filter(spark_pair_apply_plan_refusals(plans: plans), r => string_contains(s: r, pattern: "the serving authority could not be read"))
          length(plans) == length(spark_pair_serving_authorities)
            && length(current) == length(spark_pair_serving_authorities)
            && length(unread_refusals) == length(unread)
        }
      }
  }
}
