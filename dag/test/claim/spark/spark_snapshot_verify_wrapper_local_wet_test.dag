module test.claim.spark_snapshot_verify_wrapper_local_wet

import std.logic { Bool }
import std.types { String, NonEmptyStr, List }
import std.resources { Network }
import extdeps.exec.command { LocalExec }
import extdeps.posix.sh_invocation { posix_sh_program_command }
import gunbc.command_runner { run_shell_command_observe }
import gunbc.spark.model_snapshot_materialize {
  sentinel_command_line, read_instrument,
  InstrumentVerified, InstrumentRejectedTheSubject,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE WET CONTRACT IS LOCALLY EXECUTABLE, AND AN EARLIER NOTE ON THIS BRANCH SAID IT WAS NOT. That
// note claimed three constructors -- TransportScript, cli_surface_of_literal_words and ArgvCommand --
// gate every route from text to a running process, concluded a witness could therefore never exercise
// this seam, and deleted the file that tried. Two of those three readings were right and the
// conclusion drawn from them was wrong: there is an ADMITTED bridge, and it was simply not found.
//
// THE ROUTE, EVERY HOP OF IT ADMITTED. extdeps.posix.sh_invocation.posix_sh_program_command is on
// argv_command's own admit_callers list, and gunbc.command_runner.run_shell_command_observe is on
// cli_surface_of_literal_words'. So a witness composes production builders rather than minting a
// bespoke command, which is exactly what those walls require -- they forbid inventing an argv, not
// running one.
//
// AND THIS SUBJECT IS THE BUILDER'S INTENDED CASE, not an evasion of it. Its annotation refuses a
// caller "spelling that program's argv inside a string"; the thing under test here is a genuine shell
// PROGRAM BODY -- `cmd; rc=$?; if [ $rc -eq 0 ] ...; exit $rc` -- which is what the builder exists to
// carry. The distinction matters because the previous deletion was justified by the wall's purpose,
// and the purpose points the other way.
//
// WHAT IS UNDER TEST. The verify wrapper used to read `cmd && echo OK || echo FAILED`, which exits
// ZERO in both branches because echo succeeds; the caller read that status while discarding the
// sentinel, so a verification that REFUSED the bytes returned AcquisitionFetched. A false success is
// the one outcome nothing downstream can catch, and no amount of reasoning about the rendered text
// proves the shell agrees with it.

// ── THE RED ────────────────────────────────────────────────────────────────────────────────────
//
// `false` exits 1 and writes nothing of its own, so every observable here comes from the wrapper.
// BOTH halves are asserted because the defect needed only one to be wrong: the old shape emitted the
// correct sentinel and still exited zero, so a caller reading the status was misled while a caller
// reading the sentinel was not.
test fn a_failing_verify_exits_nonzero_and_says_failed_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["false"])),
    transport: LocalExec,
  )
  obs.exit_code != 0 && read_instrument(stdout: obs.stdout) == InstrumentRejectedTheSubject
}

// ── THE POSITIVE CONTROL ───────────────────────────────────────────────────────────────────────
//
// Without this the red above is satisfied by a wrapper that always fails.
test fn a_passing_verify_exits_zero_and_says_ok_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["true"])),
    transport: LocalExec,
  )
  obs.exit_code == 0 && read_instrument(stdout: obs.stdout) == InstrumentVerified
}

// ── THE STATUS IS THE COMMAND'S OWN ────────────────────────────────────────────────────────────
//
// Not merely nonzero. `exit 3` proves the wrapper PROPAGATES rather than substituting a failure code
// of its own, which is what `rc=$?` ... `exit $rc` claims to do and what the `&&`/`||` form could not.
test fn the_wrapper_propagates_the_exact_exit_status_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["sh", "-c", "exit 3"])),
    transport: LocalExec,
  )
  obs.exit_code == 3 && read_instrument(stdout: obs.stdout) == InstrumentRejectedTheSubject
}

// ── ARGV BOUNDARIES SURVIVE THE RENDER ─────────────────────────────────────────────────────────
//
// A path containing a space must reach the process as ONE argument; this module lost that boundary
// twice before the quoting landed. `test -d` on a directory that does not exist fails either way, so
// what is asserted is that it fails having received ONE argument rather than three.
test fn an_argument_containing_a_space_stays_one_word_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["test", "-d", "/nonexistent path with spaces"])),
    transport: LocalExec,
  )
  obs.exit_code != 0 && read_instrument(stdout: obs.stdout) == InstrumentRejectedTheSubject
}
