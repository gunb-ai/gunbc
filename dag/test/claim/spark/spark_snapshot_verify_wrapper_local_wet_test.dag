module test.claim.spark_snapshot_verify_wrapper_local_wet

import std.logic { Bool }
import std.types { String, NonEmptyStr, List }
import std.resources { Network }
import extdeps.exec.command { LocalExec }
import extdeps.posix.sh_invocation { posix_sh_program_command }
import gunbc.command_runner { run_shell_command_observe }
import gunbc.spark.model_snapshot_materialize {
  sentinel_command_line, read_instrument,
  InstrumentReading, InstrumentDidNotRun,
  InstrumentVerified, InstrumentRejectedTheSubject, InstrumentContradictedItself,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE WET CONTRACT IS LOCALLY EXECUTABLE, AND AN EARLIER NOTE ON THIS BRANCH SAID IT WAS NOT. That
// note claimed three constructors -- TransportScript, cli_surface_of_literal_words and ArgvCommand --
// gate every route from text to a running process, concluded a witness could therefore never exercise
// this seam, and deleted the file that tried. Two of those three readings were right and the
// conclusion drawn from them was wrong: there is an ADMITTED bridge, and it was simply not found.
//
// THE ROUTE, EVERY HOP OF IT ADMITTED. extdeps.posix.sh_invocation.posix_sh_program_command is on
// argv_command's own admit_callers list, and gunbc.command_runner.run_shell_command_observe is on
// cli_surface_of_literal_words'. So a witness composes production builders rather than minting a
// bespoke command, which is exactly what those walls require -- they forbid inventing an argv, not
// running one.
//
// AND THIS SUBJECT IS THE BUILDER'S INTENDED CASE, not an evasion of it. Its annotation refuses a
// caller "spelling that program's argv inside a string"; the thing under test here is a genuine shell
// PROGRAM BODY -- `cmd; rc=$?; if [ $rc -eq 0 ] ...; exit $rc` -- which is what the builder exists to
// carry. The distinction matters because the previous deletion was justified by the wall's purpose,
// and the purpose points the other way.
//
// WHAT IS UNDER TEST. The verify wrapper used to read `cmd && echo OK || echo FAILED`, which exits
// ZERO in both branches because echo succeeds; the caller read that status while discarding the
// sentinel, so a verification that REFUSED the bytes returned AcquisitionFetched. A false success is
// the one outcome nothing downstream can catch, and no amount of reasoning about the rendered text
// proves the shell agrees with it.

// ── THE RED ────────────────────────────────────────────────────────────────────────────────────
//
// `false` exits 1 and writes nothing of its own, so every observable here comes from the wrapper.
// BOTH halves are asserted because the defect needed only one to be wrong: the old shape emitted the
// correct sentinel and still exited zero, so a caller reading the status was misled while a caller
// reading the sentinel was not.
test fn a_failing_verify_exits_nonzero_and_says_failed_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["false"])),
    transport: LocalExec,
  )
  obs.exit_code != 0 && read_instrument(exit_code: obs.exit_code, stdout: obs.stdout) == InstrumentRejectedTheSubject
}

// ── THE POSITIVE CONTROL ───────────────────────────────────────────────────────────────────────
//
// Without this the red above is satisfied by a wrapper that always fails.
test fn a_passing_verify_exits_zero_and_says_ok_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["true"])),
    transport: LocalExec,
  )
  obs.exit_code == 0 && read_instrument(exit_code: obs.exit_code, stdout: obs.stdout) == InstrumentVerified
}

// ── THE STATUS IS THE COMMAND'S OWN ────────────────────────────────────────────────────────────
//
// Not merely nonzero. `exit 3` proves the wrapper PROPAGATES rather than substituting a failure code
// of its own, which is what `rc=$?` ... `exit $rc` claims to do and what the `&&`/`||` form could not.
test fn the_wrapper_propagates_the_exact_exit_status_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["sh", "-c", "exit 3"])),
    transport: LocalExec,
  )
  obs.exit_code == 3 && read_instrument(exit_code: obs.exit_code, stdout: obs.stdout) == InstrumentRejectedTheSubject
}

// ── ARGV BOUNDARIES SURVIVE THE RENDER ─────────────────────────────────────────────────────────
//
// THE FIRST VERSION OF THIS WITNESS WAS GREEN THROUGH THE REGRESSION ITS NAME CLAIMS TO DETECT. It ran
// `test -d "/nonexistent path with spaces"` and asserted only a nonzero exit -- but `test -d` fails
// whether it receives ONE argument or THREE, so a renderer that split the path on spaces produced the
// same verdict as one that quoted it. The assertion could not distinguish the two implementations, and
// a control that cannot fail for the reason it names is worse than absent: it is cited as coverage.
//
// THE OUTPUT IS THE DISCRIMINATOR, NOT THE STATUS. `printf "%s|" "a b"` writes `a b|` when the
// argument arrives whole and `a|b|` when it arrives split, so the two implementations produce
// different TEXT rather than the same exit code. The wrapper's own sentinel still has to appear, which
// keeps this a test of the rendered command rather than of printf.
test fn an_argument_containing_a_space_stays_one_word_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: sentinel_command_line(argv: ["printf", "%s|", "a b"])),
    transport: LocalExec,
  )
  obs.exit_code == 0
    && string_contains(s: obs.stdout, pattern: "a b|")
    && !string_contains(s: obs.stdout, pattern: "a|b|")
    && read_instrument(exit_code: obs.exit_code, stdout: obs.stdout) == InstrumentVerified
}

// ── THE DISCRIMINATOR THE PREVIOUS FIX LEFT OPEN ───────────────────────────────────────────────
//
// A COMMAND THAT PRINTS THE OK MARKER AND THEN EXITS NONZERO. This is the case that reached
// InstrumentVerified -- and therefore AcquisitionFetched -- after the wrapper had already been
// repaired to preserve the exit status, because both readers bound `exit_code: _` and decoded from
// stdout alone. The status was carefully preserved and then discarded two functions later, and the
// repair was reported as complete.
//
// IT IS RUN AS A REAL PROCESS rather than asserted against a hand-built pair, so what is under test is
// the composition -- wrapper, shell, exit status, decoder -- and not a fixture of what one believes
// the shell does.
test fn an_ok_marker_with_a_nonzero_status_is_a_contradiction_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: join([
      "echo ", "GUNBC-VERIFY-OK", "; exit 4",
    ], "")),
    transport: LocalExec,
  )
  obs.exit_code == 4 && w_is_contradiction(r: read_instrument(exit_code: obs.exit_code, stdout: obs.stdout))
}

// AND ITS MIRROR: the FAILED marker beside a zero status, which is exactly what the original
// `cmd && echo OK || echo FAILED` wrapper emitted on every failure. Reading that as a plain rejection
// would be right by luck for that wrapper and wrong for any wrapper that means its status.
test fn a_failed_marker_with_a_zero_status_is_a_contradiction_by_real_execution() -> Bool {
  let obs = run_shell_command_observe(
    command: posix_sh_program_command(script: join([
      "echo ", "GUNBC-VERIFY-FAILED", "; exit 0",
    ], "")),
    transport: LocalExec,
  )
  obs.exit_code == 0 && w_is_contradiction(r: read_instrument(exit_code: obs.exit_code, stdout: obs.stdout))
}

fn w_is_contradiction(r: InstrumentReading) -> Bool {
  match r {
    InstrumentContradictedItself { detail: _ } => true
    InstrumentVerified => false
    InstrumentRejectedTheSubject => false
    InstrumentDidNotRun => false
  }
}
