module test.claim.spark.v41_checkpoint_materialize_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import v2.std.optional { Present, Absent }
import product.placement_supply { HostIdentity }
import extdeps.deepseek.deepseek_v4_1_flash { DeepseekV41PublishedFile, deepseek_v4_1_flash_safetensors_tree_file_bytes }
import gunbc.artifact_acquisition { ContentDigestSha256, UpstreamRevision, SourceArgv, SourceUrl }
import gunbc.spark.fabric_switch_observed { FabricGroupA }
import gunbc.spark.serving_subject { PairServingUnitOn }
import gunbc.spark.host_commitment { spark_serving_admissible_hosts, admit_host_held_by_subject_among }
import gunbc.spark.v41_engram_row_store { V41PublishedSpan }
import extdeps.tools.sha256sum { sha256sum_byte_span_program, sha256sum_byte_span_argv_of }
import gunbc.spark.v41_index_engram_selection { v41_scan_index_text, v41_index_engram_selector }
import gunbc.spark.v41_checkpoint_materialize {
  V41CheckpointPopulation, V41CheckpointPopulationAdmitted, V41CheckpointPopulationRefused,
  v41_checkpoint_population, v41_checkpoint_bytes, v41_checkpoint_subject, v41_required_bytes,
  v41_span_read_argv, v41_checkpoint_directory,
  V41SpanReadOutcome, V41SpanPlanRefused, v41_span_line, v41_span_is_read,
  V41IndexSelectionOutcome, V41IndexSelectionRead, V41IndexSelectionUnread, v41_index_selection_lines, v41_index_selection_is_read, v41_wc_bytes,
}

// THE MODE'S PURE DECISIONS, OVER THE REAL ADMITTED POPULATION. Nothing here reaches a host: the
// host legs are the mode's to run (fleet-converge spark_v41_checkpoint_materialize), and these rows
// establish what it will ask for and what it refuses before it asks.

fn w_files() -> List<DeepseekV41PublishedFile> {
  match v41_checkpoint_population() {
    V41CheckpointPopulationAdmitted { files: f } => f
    V41CheckpointPopulationRefused { defects: _ } => [] as List<DeepseekV41PublishedFile>
  }
}

fn w_file(path: String) -> List<DeepseekV41PublishedFile> {
  filter(w_files(), f => (f.path as String) == path)
}

// THE POPULATION IS 48 SHARDS, THE INDEX AND THREE TOKENIZER FILES, and its shard bytes are the
// publisher's tree total -- the disk requirement is derived from these rows, never transcribed.
test fn the_admitted_population_is_the_shards_the_index_and_the_tokenizer() -> Bool {
  let fs = w_files()
  let shards = filter(fs, f => (f.path as String).ends_with(".safetensors"))
  length(fs) == 52 && length(shards) == 48
    && byte_size_count(b: v41_checkpoint_bytes(files: shards)) == byte_size_count(b: deepseek_v4_1_flash_safetensors_tree_file_bytes)
    && length(w_file(path: "model.safetensors.index.json")) == 1
    && length(w_file(path: "encoding/encoding.py")) == 1
}

// EACH SUBJECT IS KEYED BY THE MANIFEST ROW'S SHA256, lands under the pinned-revision directory, stages
// beside it, and offers the Hub cache copy before the resolve URL at the pinned revision.
test fn a_subject_carries_the_rows_digest_and_the_pinned_route() -> Bool {
  match first(w_file(path: "encoding/encoding.py")) {
    Absent => false
    Present { value: f } => {
      let s = v41_checkpoint_subject(file: f)
      let key_ok = match s.key {
        ContentDigestSha256 { hex: h } => (h as String) == (f.sha256.hex as String)
        UpstreamRevision { revision: _ } => false
      }
      let url_ok = match get(xs: s.sources, index: 1) {
        Absent => false
        Present { value: src } => match src.locator {
          SourceArgv { argv: a } => any(a, w => w == "https://huggingface.co/deepseek-ai/DeepSeek-V4.1-Flash/resolve/dba1be0a40aa45a94ad051997016db3960a90277/encoding/encoding.py")
          SourceUrl { url: _ } => false
        }
      }
      key_ok && url_ok && length(s.sources) == 2
        && (s.install_path as String) == join([v41_checkpoint_directory as String, "/encoding/encoding.py"], "")
        && (s.parent_directory as String) == join([v41_checkpoint_directory as String, "/encoding"], "")
    }
  }
}

// THE TWO-ROW POPULATION THE LISTING CASES JOIN AGAINST. It is the REAL admitted population narrowed
// to two rows, not a fixture: the 52-row shape is the previous claim's subject, and each case below
// discriminates at the listing join and nothing else (DESIGN section 3, a witness discriminates at one
// interface). The narrowing is what keeps three independent listings from costing three whole-
// population folds.
fn w_two_rows() -> List<DeepseekV41PublishedFile> {
  filter(w_files(), f => (f.path as String) == "tokenizer.json" || (f.path as String) == "encoding/encoding.py")
}

fn w_listing_at_size(fs: List<DeepseekV41PublishedFile>) -> List<String> {
  map(fs, f => join([to_string(byte_size_count(b: f.file_bytes)), " ", f.path as String], ""))
}

// THE THREE LISTING CASES ARE THREE WITNESSES, NOT THREE CONJUNCTS. As one claim they forced three
// independent listings through one budget -- the required floor measured 113,763 eval steps against
// the 72,300 new-witness budget and refused. Splitting loses no coverage, because no case reads
// another's value, and it buys what the conjunction could not give: a regression in the one-short arm
// now fails under its own name instead of reading as the same single failure as the all-present arm.
test fn the_disk_requirement_is_the_whole_population_when_nothing_is_present() -> Bool {
  let fs = w_two_rows()
  length(fs) == 2
    && byte_size_count(b: v41_required_bytes(files: fs, listing: [] as List<String>)) == byte_size_count(b: v41_checkpoint_bytes(files: fs))
}

// EVERYTHING PRESENT AT ITS DECLARED SIZE NEEDS NONE OF IT: the listing names the same rows at the
// same sizes, so the requirement is zero rather than merely small.
test fn the_disk_requirement_is_zero_when_every_file_is_present_at_size() -> Bool {
  let fs = w_two_rows()
  length(fs) == 2
    && byte_size_count(b: v41_required_bytes(files: fs, listing: w_listing_at_size(fs: fs))) == 0
}

// ONE FILE AT THE WRONG SIZE NEEDS EXACTLY THAT FILE -- not the whole population and not nothing, so
// the SIZE is compared and not merely the name. The tok > 0 conjunct is the control: a row whose
// tokenizer.json were zero bytes would make the equality true for the wrong reason.
test fn the_disk_requirement_counts_only_the_file_at_the_wrong_size() -> Bool {
  let fs = w_two_rows()
  let one_short = map(fs, f => if (f.path as String) == "tokenizer.json" { "1 tokenizer.json" } else { join([to_string(byte_size_count(b: f.file_bytes)), " ", f.path as String], "") })
  let tok = match first(filter(fs, f => (f.path as String) == "tokenizer.json")) { Present { value: t } => byte_size_count(b: t.file_bytes)  Absent => 0 }
  length(fs) == 2
    && byte_size_count(b: v41_required_bytes(files: fs, listing: one_short)) == tok
    && tok > 0
}

// ONLY A HOST THE GROUP A PAIR SUBJECT HOLDS IS ADMITTED, read through the real admissibility.
test fn only_a_group_a_host_is_admitted() -> Bool {
  let held = spark_serving_admissible_hosts(subject: PairServingUnitOn { group: FabricGroupA })
  length(held) == 4
    && (match admit_host_held_by_subject_among(subject: PairServingUnitOn { group: FabricGroupA }, raw: "srv5" as HostIdentity, held: held) { Absent => true  Present { value: _ } => false })
    && (match admit_host_held_by_subject_among(subject: PairServingUnitOn { group: FabricGroupA }, raw: "srv8" as HostIdentity, held: held) { Absent => true  Present { value: _ } => false })
    && (match admit_host_held_by_subject_among(subject: PairServingUnitOn { group: FabricGroupA }, raw: "srv9" as HostIdentity, held: held) { Absent => false  Present { value: why } => why.contains("is not held by pair-unit@") })
    && (match admit_host_held_by_subject_among(subject: PairServingUnitOn { group: FabricGroupA }, raw: "srv1" as HostIdentity, held: held) { Absent => false  Present { value: _ } => true })
}

// THE SPAN READ PUTS ITS OPERANDS IN THEIR DECLARED SLOTS. The subject is how
// sha256sum_byte_span_argv_of ASSEMBLES the list, which is not a fact about the serializer -- so the
// program is a SUPPLIED value here. Forcing the real one to read index 4 would pay a 204k-eval-step
// render this claim never inspects, which is DESIGN section 3's tell verbatim: a claim dominated by
// one call whose result shape is all it looks at. The RED is authorable and it is the real defect --
// any permutation of the seven slots fails this, where length(argv)==7 would stay green through all
// of them.
test fn the_span_read_puts_its_operands_in_their_declared_slots() -> Bool {
  sha256sum_byte_span_argv_of(program: "P", path: "/m/s.safetensors", offset: "664", length: "98305579008")
    == ["bash", "-c", "P", "bash", "/m/s.safetensors", "664", "98305579008"]
}

// INHABITANCE: the REAL producer emits that shape, with the REAL serialized program in the slot the
// claim above supplies. This is the claim that pays the serialization, once, and it asserts the ROUTE
// and not only the shape -- deleting the integration makes it fail (DESIGN section 3, the pairing
// obligation: supplying inputs may never remove the last execution of the real path).
test fn the_span_read_reads_exactly_its_region() -> Bool {
  v41_span_read_argv(sp: V41PublishedSpan { tensor: "layers.1.engram.embed.weight" as NonEmptyStr, shard: "model-00047-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 664), length: byte_size(count: 98305579008) })
    == sha256sum_byte_span_argv_of(
         program: sha256sum_byte_span_program,
         path: join([v41_checkpoint_directory as String, "/model-00047-of-00048.safetensors"], ""),
         offset: "664",
         length: "98305579008")
}

// AN UNPLANNABLE SPAN PLAN IS CARRIED INTO THE RECEIPT, NOT DROPPED: its defects are the line, and the
// run is not a success on it.
test fn a_refused_span_plan_reaches_the_receipt() -> Bool {
  let refused = V41SpanPlanRefused { defects: ["storage-backed tensor layers.1.engram.embed.weight is not exactly one header row" as NonEmptyStr] }
  v41_span_line(o: refused).contains("span-plan-refused: storage-backed tensor layers.1.engram.embed.weight")
    && !v41_span_is_read(o: refused)
}

// THE INDEX SELECTION'S RECEIPT CARRIES EVERY FIELD THE READING ROW NEEDS, from the scan the mode runs
// over the bytes it fetched; an unread index is a located line and not a success.
test fn the_index_selection_receipt_carries_the_reading() -> Bool {
  let text = "{\"metadata\": {\"total_size\": 1}, \"weight_map\": {\"layers.1.engram.q_weight\": \"model-00047-of-00048.safetensors\", \"head.weight\": \"model-00046-of-00048.safetensors\"}}"
  let read = V41IndexSelectionRead { sha256_hex: "ab", bytes: byte_size(count: 7), scan: v41_scan_index_text(text: text, selector: v41_index_engram_selector) }
  let lines = v41_index_selection_lines(o: read)
  lines.contains("index-selection sha256=ab bytes=7 names=2 selector=.engram.")
    && lines.contains("index-selection member layers.1.engram.q_weight model-00047-of-00048.safetensors")
    && v41_index_selection_is_read(o: read)
    && !v41_index_selection_is_read(o: V41IndexSelectionUnread { cause: "fixture" as NonEmptyStr })
}

// THE DIRECTORY IS THE REPO'S CACHE NAME AND THE PIN, derived rather than spelled.
test fn the_checkpoint_directory_is_derived_from_the_repo_and_the_pin() -> Bool {
  (v41_checkpoint_directory as String) == "/home/briansrls/models/models--deepseek-ai--DeepSeek-V4.1-Flash/dba1be0a40aa45a94ad051997016db3960a90277"
}

// THE SIZE READ REFUSES RATHER THAN WIDENS: wc output that is not a count is no size at all.
test fn an_unreadable_index_size_is_no_size() -> Bool {
  (match v41_wc_bytes(out: "7470294 /x/model.safetensors.index.json") { Present { value: b } => byte_size_count(b: b) == 7470294  Absent => false })
    && (match v41_wc_bytes(out: "") { Present { value: _ } => false  Absent => true })
    && (match v41_wc_bytes(out: "wc: /x: No such file") { Present { value: _ } => false  Absent => true })
}
