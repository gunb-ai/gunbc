    ArmMemorySubjectRefused { cause: _ } => false
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitUnestablished { obligations: os } =>
          length(os) == 1 && any(os, o => o == "fx-no-pool-reading: no byte producer has modeled this pool" as NonEmptyStr)
        _ => false
      }
  }
}

// ── WITNESS 11: THE MEASUREMENT CONTRACT ────────────────────────────────────────────────────────
//
// A MEASUREMENT DISCHARGES AN OBLIGATION ONLY WHEN IT ESTABLISHES A BOUND. A single sample is
// ObservationOnly and changes nothing; a peak-over-runs protocol with lifetime coverage is a
// MeasuredUpperBound and discharges; a measurement for a phase where the component is not
// resident, or with an empty workload, or over zero runs, refuses.
fn fx_measurement(protocol: ArmMeasurementProtocol, covers_lifetime: Bool, phase_witness: ArmMemoryComponent, phase: ArmMemoryFitPhase, observed_gib: Nat) -> ArmMeasurement {
  ArmMeasurement {
    component: phase_witness,
    rank: 0,
    phase: phase,
    workload: token_count(count: 65536),
    covers_lifetime: covers_lifetime,
    protocol: protocol,
    observed: fx_gib(observed_gib),
    receipt: fx_receipt(kind: "fx-measurement" as NonEmptyStr),
  }
}

test fn w_a_single_sample_is_observation_only_and_discharges_nothing() -> Bool {
  let m = fx_measurement(protocol: ProtocolSingleSample, covers_lifetime: true, phase_witness: ArmGraphCapture, phase: ArmPhaseGraphCapture, observed_gib: 1)
  (match arm_classify_measurement(m: m) {
    ObservationOnly { measurement: _, why: w } => string_contains(s: w as String, pattern: "bounds nothing above")
    MeasuredUpperBound { measurement: _ } => false
    MeasuredInterval { lower: _, upper: _, measurement: _ } => false
    MeasurementRefused { cause: _ } => false
  })
    && (match arm_apply_measurement(
      current: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr },
      class: arm_classify_measurement(m: m)) {
      ComponentBoundOpen { obligation: o } => o == "fx-open" as NonEmptyStr
      _ => false
    })
}

test fn w_a_peak_over_runs_protocol_discharges_to_a_ceiling() -> Bool {
  let m = fx_measurement(protocol: ProtocolPeakOverRuns { runs: 3 }, covers_lifetime: true, phase_witness: ArmGraphCapture, phase: ArmPhaseGraphCapture, observed_gib: 1)
  (match arm_classify_measurement(m: m) {
    MeasuredUpperBound { measurement: _ } => true
    _ => false
  })
    && (match arm_apply_measurement(
      current: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr },
      class: arm_classify_measurement(m: m)) {
      ComponentBoundCeiling { bytes: b, receipt: r } =>
        byte_size_count(b: b) == 1073741824 && r == fx_receipt(kind: "fx-measurement" as NonEmptyStr)
      _ => false
    })
}

test fn w_a_measurement_that_does_not_cover_the_lifetime_observes_only() -> Bool {
  let m = fx_measurement(protocol: ProtocolPeakOverRuns { runs: 3 }, covers_lifetime: false, phase_witness: ArmGraphCapture, phase: ArmPhaseGraphCapture, observed_gib: 1)
  match arm_classify_measurement(m: m) {
    ObservationOnly { measurement: _, why: w } => string_contains(s: w as String, pattern: "does not cover the lifetime")
    _ => false
  }
}

test fn w_a_measurement_for_an_absent_mechanism_or_zero_runs_refuses() -> Bool {
  let wrong_phase = fx_measurement(protocol: ProtocolPeakOverRuns { runs: 3 }, covers_lifetime: true, phase_witness: ArmKvCache, phase: ArmPhaseModelLoad, observed_gib: 1)
  let zero_runs = fx_measurement(protocol: ProtocolPeakOverRuns { runs: 0 }, covers_lifetime: true, phase_witness: ArmGraphCapture, phase: ArmPhaseGraphCapture, observed_gib: 1)
  (match arm_classify_measurement(m: wrong_phase) {
    MeasurementRefused { cause: c } => string_contains(s: c as String, pattern: "not resident")
    _ => false
  })
    && (match arm_classify_measurement(m: zero_runs) {
      MeasurementRefused { cause: c } => string_contains(s: c as String, pattern: "zero runs")
      _ => false
    })
}

// ── WITNESS 12: READBACK — INSIDE THE INTERVAL IS CONSISTENT, OUTSIDE FALSIFIES ─────────────────
test fn w_readback_inside_the_predicted_interval_is_consistent_outside_falsifies() -> Bool {
  let interval = fx_interval(lower: 1073741824, upper: 2147483648, how: fx_how(text: "fixture interval" as NonEmptyStr))
  (match arm_readback_observation(component: ArmActivationWorkspace, predicted: interval, observed: fx_gib(2), receipt: "fx-readback-1" as NonEmptyStr) {
    ArmObservationConsistent { component: _, predicted_bound: _, observed: _, receipt: _ } => true
    ArmMemoryModelFalsified { component: _, predicted_bound: _, observed: _, receipt: _ } => false
  })
    && (match arm_readback_observation(component: ArmActivationWorkspace, predicted: interval, observed: fx_gib(3), receipt: "fx-readback-2" as NonEmptyStr) {
      ArmMemoryModelFalsified { component: _, predicted_bound: _, observed: _, receipt: _ } => true
      ArmObservationConsistent { component: _, predicted_bound: _, observed: _, receipt: _ } => false
    })
    && (match arm_readback_observation(
      component: ArmKvCache,
      predicted: ComponentBoundExact { bytes: fx_gib(1), how: fx_how(text: "fixture exact" as NonEmptyStr) },
      observed: fx_gib(2),
      receipt: "fx-readback-3" as NonEmptyStr) {
      ArmMemoryModelFalsified { component: _, predicted_bound: _, observed: _, receipt: _ } => true
      ArmObservationConsistent { component: _, predicted_bound: _, observed: _, receipt: _ } => false
    })
}

// ── WITNESS 13: THE LAUNCH GATE IS VERDICT-AWARE, AND THE EXPERIMENT NEEDS A TYPED PLAN ─────────
fn fx_unestablished_verdict() -> ArmMemoryFitVerdict {
  ArmMemoryFitUnestablished { obligations: ["fx-obligation" as NonEmptyStr] }
}

fn fx_plan() -> ArmMemoryExperimentPlan {
  match arm_memory_fit_experiment_plan(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    workload: fx_shrunk_intent(),
    policy_profile: fx_derived_profile(),
    targets: [ArmKvCache, ArmGraphCapture]) {
    ArmMemoryExperimentAdmitted { plan: p } => p
    ArmMemoryExperimentRefused { cause: _ } => ArmMemoryExperimentPlan {
      checkpoint: Glm53NativeFp8,
      runtime: GunbcGlm53NopeDerivedGb10,
      topology: FourSparkTp4,
      workload: fx_shrunk_intent(),
      profile: fx_derived_profile(),
      targets: [],
      envelope_basis_points: basis_point(count: 8400),
      max_runtime_seconds: 0,
      expected_receipts: [],
      stop: ArmExperimentStopContract {
        timeout_preserves: "unreachable" as NonEmptyStr,
        cleanup: "unreachable" as NonEmptyStr,
        stops_every_rank: ArmEveryRankStopped { witness: "fx" as NonEmptyStr },
        route_enrollment: ArmNoRouteEnrollment { witness: "fx" as NonEmptyStr },
      },
    }
  }
}

test fn w_refused_refuses_the_experiment_too() -> Bool {
  match arm_memory_launch_gate(
    intent: ArmBoundedExperiment,
    verdict: ArmMemoryFitRefused {
      rank: 1, phase: ArmPhaseModelLoad, demand_lower: fx_gib(1), supply_upper: fx_gib(1),
      cause: "fx-refusal" as NonEmptyStr },
    experiment: none) {
    Present { value: c } => string_contains(s: c as String, pattern: "even a bounded experiment refuses")
    Absent => false
  }
}

test fn w_unestablished_refuses_the_experiment_without_a_typed_plan() -> Bool {
  (match arm_memory_launch_gate(intent: ArmBoundedExperiment, verdict: fx_unestablished_verdict(), experiment: none) {
    Present { value: c } => string_contains(s: c as String, pattern: "only through a typed experiment plan")
    Absent => false
  })
    && (match arm_memory_launch_gate(intent: ArmBoundedExperiment, verdict: fx_unestablished_verdict(), experiment: Present { value: fx_plan() }) {
      Present { value: _ } => false
      Absent => true
    })
    && (match arm_memory_launch_gate(intent: ArmBoundedExperiment, verdict: ArmMemoryFitProved { rank: 0, phase: ArmPhaseIdleServing, headroom_bytes: fx_gib(1) }, experiment: none) {
      Present { value: _ } => false
      Absent => true
    })
    && (match arm_memory_launch_gate(intent: ArmNormalServing, verdict: ArmMemoryFitProved { rank: 0, phase: ArmPhaseIdleServing, headroom_bytes: fx_gib(1) }, experiment: none) {
      Present { value: _ } => false
      Absent => true
    })
}

// ── WITNESS 14: THE EXPERIMENT PLAN MINT — TARGETS, ENVELOPE, RUNTIME, RECEIPTS, STOP CONTRACT ────
test fn w_the_experiment_plan_names_targets_runtime_receipts_and_stop_contract() -> Bool {
  let plan = fx_plan()
  length(plan.targets) == 2
    && plan.max_runtime_seconds == arm_memory_experiment_runtime_seconds()
    && plan.max_runtime_seconds > 0
    && plan.expected_receipts == ["KvLayoutReceipt" as NonEmptyStr, "GraphCaptureBound" as NonEmptyStr]
    && (match plan.stop.stops_every_rank { ArmEveryRankStopped { witness: w } => w == "every rank unit of the experiment carries the same admitted runtime bound" as NonEmptyStr })
    && (match plan.stop.route_enrollment { ArmNoRouteEnrollment { witness: w } => w == "the experiment unit renders no [Install] section, so no target enrolls the route" as NonEmptyStr })
    && string_contains(s: plan.stop.timeout_preserves as String, pattern: "receipt")
    && string_contains(s: plan.stop.cleanup as String, pattern: "docker rm -f")
}

test fn w_the_experiment_plan_refuses_empty_or_already_bounded_targets() -> Bool {
