    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions(),
    ranks: [
      fx_rank(rank: 0, checkpoint: surcharge),
      fx_rank(rank: 1, checkpoint: fx_even_checkpoint()),
      fx_rank(rank: 2, checkpoint: fx_even_checkpoint()),
      fx_rank(rank: 3, checkpoint: fx_even_checkpoint()),
    ]) {
    ArmMemorySubjectRefused { cause: _ } => false
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitRefused { rank: r, phase: _, demand_lower: d, supply_upper: _, cause: c } =>
          r == 0
            && byte_size_count(b: d) == 132070244352
            && string_contains(s: c as String, pattern: "checkpoint-residency")
        _ => false
      }
  }
}

// ── WITNESS 8: THE DECIDED ENVELOPE REFUSES AT THE FIRST ENGINE-ADMITTED PHASE ────────────────────
test fn w_the_envelope_refuses_at_the_first_engine_admitted_phase() -> Bool {
  let between = fx_interval(
    lower: 123480309760,
