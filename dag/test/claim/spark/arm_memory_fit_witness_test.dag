// ── WITNESS 9: PHASES KEEP TRANSIENTS IN THEIR PHASE ────────────────────────────────────────────
test fn w_the_loader_transient_is_charged_only_in_its_phases() -> Bool {
  let rd = fx_rank(rank: 0, checkpoint: fx_even_checkpoint())
  let model_upper = match demand_for_phase(rd: rd, phase: ArmPhaseModelLoad).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let idle_upper = match demand_for_phase(rd: rd, phase: ArmPhaseIdleServing).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let loader_upper = match demand_for_phase(rd: rd, phase: ArmPhaseLoaderTransform).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let overlap_upper = match demand_for_phase(rd: rd, phase: ArmPhaseRestartOverlap).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  loader_upper == overlap_upper
    && loader_upper - model_upper == byte_size_count(b: fx_gib(1))
    && idle_upper - model_upper == byte_size_count(b: fx_gib(3))
}

