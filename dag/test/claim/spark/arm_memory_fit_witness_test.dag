// ── THE WITNESS SUBJECTS ARE FIXTURES WITH REAL PRODUCTION NUMBERS WHERE A DERIVATION EXISTS ────
//
// The checkpoint residency, the pool span and the envelope are derived through the same functions
// the launch wall uses, against the real GLM-5.3-Flash row (306 ceil-GiB) and the real GB10 pool
// reading (121 GiB rounded). The component receipts that do not exist yet are supplied as
// ceiling FIXTURES -- each named as the receipt kind the obligation names -- which is exactly the
// stand-in a bounded experiment would replace with a measurement.

fn fx_gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

// 121 GiB, the GB10 reading; 122 GiB minus one byte, the rounding unit's top.
data fx_pool_low: ByteSize = byte_size(count: 129922760704)
data fx_pool_high: ByteSize = byte_size(count: 130996502527)

fn fx_pool() -> ArmPoolBound {
  match closed_interval(low: fx_pool_low, high: fx_pool_high, le: measure_le) {
    IntervalReady { interval: i } =>
      ArmPoolBounded {
        span: i,
        how: "fixture span identical to the one gunbc.spark.arm_memory_fit gb10_pool_bound derives from the rounded reading" as NonEmptyStr,
      }
    IntervalRefused { reason: r } =>
      ArmPoolUnbounded { obligation: r }
  }
}

fn fx_interval(lower: Nat, upper: Nat, how: NonEmptyStr) -> ArmComponentBound {
  match component_bound_interval(lower: byte_size(count: lower), upper: byte_size(count: upper), how: how) {
    ArmComponentBoundReady { bound: b } => b
    ArmComponentBoundRefused { cause: c } => ComponentBoundOpen { obligation: c }
  }
}

fn fx_ceiling_term(component: ArmMemoryComponent, gib: Nat, receipt: NonEmptyStr) -> ArmComponentTermBound {
  ArmComponentTermBound {
    component: component,
    bound: ComponentBoundCeiling { bytes: fx_gib(gib), receipt: receipt },
  }
}

// THE FIXTURE LAYOUT IS HYBRID-SHAPED on purpose: one full-attention group, sixteen-token blocks,
// sixty-four-KiB pages. GLM-5.3-Flash's real per-group shape (MLA plus linear-attention state) is
// an open upstream obligation -- the engine emits no group metadata (extdeps.vllm.kv_layout states
// the trigger) -- so the fixture charges a full-attention cost and says so.
data fx_layout: ResolvedKvLayout = resolved_kv_layout(
  allocator_blocks: allocator_block_count(count: 4096),
  scheduler_block_size: token_count(count: 16),
  hash_block_size: token_count(count: 16),
  max_model_len: token_count(count: 262144),
  max_num_batched_tokens: token_count(count: 2048),
  groups: [KvGroupLayout {
    kind: FullAttention,
    layer_count: attention_layer_count(count: 1),
    block_size: token_count(count: 16),
    page_size_bytes: byte_size(count: 65536),
  }],
  established_at_revision: vllm_source_revision_read,
)

// THE KV TERM IS DERIVED FROM THE SEAT POPULATION OVER THE LAYOUT, per seat: a 64K-token seat at
// sixteen-token blocks holds 4096 blocks of 64 KiB = 256 MiB, and four seats hold 1 GiB. This is
// required_kv_bytes(workload x layout); no current_kv from any run appears anywhere in it.
fn fx_kv_term(seats: Nat) -> ArmComponentTermBound {
  let per_seat = match cold_admission_bytes(layout: fx_layout, sequence_budget: token_count(count: 65536)) {
    AdmissionByteCostBytes { bytes: b } => b
    AdmissionByteCostUnestablished { cause: _ } => byte_size(count: 0)
  }
  ArmComponentTermBound {
    component: ArmKvCache,
    bound: ComponentBoundInterval {
      lower: byte_size(count: byte_size_count(b: per_seat) * seats),
      upper: byte_size(count: byte_size_count(b: per_seat) * seats),
      how: "fixture derivation: seats x cold_admission_bytes(fixture layout, 64K budget); the real arm derives against the observed layout when the engine emits group metadata" as NonEmptyStr,
    },
  }
}

fn fx_terms(ckpt: ArmComponentTermBound, kv: ArmComponentTermBound) -> List<ArmComponentTermBound> {
  [
    ckpt,
    fx_ceiling_term(component: ArmLoaderTransform, gib: 1, receipt: "fx-CheckpointRankResidencyBound" as NonEmptyStr),
    fx_ceiling_term(component: ArmRuntimeFixed, gib: 2, receipt: "fx-RuntimeFixedAllocationBound" as NonEmptyStr),
    fx_ceiling_term(component: ArmCollectiveWorkspace, gib: 1, receipt: "fx-CollectiveWorkspaceBound" as NonEmptyStr),
    fx_ceiling_term(component: ArmActivationWorkspace, gib: 2, receipt: "fx-ActivationWorkspaceBound" as NonEmptyStr),
    fx_ceiling_term(component: ArmGraphCapture, gib: 1, receipt: "fx-GraphCaptureBound" as NonEmptyStr),
    kv,
    fx_ceiling_term(component: ArmFragmentationAllowance, gib: 1, receipt: "fx-AllocatorFragmentationBound" as NonEmptyStr),
  ]
}

fn fx_deductions() -> List<ArmSupplyDeduction> {
  [
    ArmSupplyDeduction {
      term: ArmHostOsControlReserve,
      bound: ComponentBoundCeiling { bytes: fx_gib(8), receipt: "fx-host-reserve-measurement" as NonEmptyStr },
    },
    ArmSupplyDeduction {
      term: ArmForeignResidency,
      bound: ComponentBoundCeiling { bytes: fx_gib(2), receipt: "fx-foreign-residency-inventory" as NonEmptyStr },
    },
  ]
}

fn fx_uniform_ranks(terms: List<ArmComponentTermBound>) -> List<ArmRankDemandBounds> {
  [
    ArmRankDemandBounds { rank: 0, terms: terms },
    ArmRankDemandBounds { rank: 1, terms: terms },
    ArmRankDemandBounds { rank: 2, terms: terms },
    ArmRankDemandBounds { rank: 3, terms: terms },
  ]
}

// THE SHRUNK SERVICE: four cold seats of 64K, batched ceiling 2048 -- the intent the contract
// names as the discriminating workload against the production sixteen-seat 262K profile.
fn fx_shrunk_intent() -> ServingCapacityIntent {
  match uniform_cold_seats(each: token_count(count: 65536), seats: 4, max_batched_tokens: token_count(count: 2048)) {
    ServingCapacityIntentAdmitted { intent: i } => i
    ServingCapacityIntentRefused { cause: _ } => ServingCapacityIntent { cold_sequence_budgets: [], max_batched_tokens: token_count(count: 1) }
  }
}

fn fx_proved_subject() -> ArmMemoryFitSubject {
  ArmMemoryFitSubject {
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: glm_native_serving_profile_2026_09_19,
    intent: fx_shrunk_intent(),
    ranks: fx_uniform_ranks(terms: fx_terms(
      ckpt: checkpoint_residency_term(crow_weight_gib: gibibyte(count: 306), ranks: 4),
      kv: fx_kv_term(seats: 4))),
    pool: fx_pool(),
    deductions: fx_deductions(),
  }
}

// ── WITNESS 1: THE PRODUCTION TUPLE'S VERDICT, AND THE TOPOLOGICAL FRONTIER AROUND IT ───────────
//
// The production subject as the launch wall assembles it -- real checkpoint row, real rounded
// pool, real serving profile, every unmeasured term open -- evaluates to FitUnestablished with
// the missing bounds named; and the SAME checkpoint at fewer ranks is REFUSED outright, by the
// checkpoint's own derived bytes alone, which is the frontier: tp1 and tp2 cannot hold the
// weights under ANY reading, tp4 and tp8 are not refusable on weights but remain unestablished
// until the open terms earn receipts.
test fn w_the_production_tuple_is_unestablished_with_named_obligations() -> Bool {
  match arm_memory_fit_verdict_for_launch(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: glm_native_serving_profile_2026_09_19,
  ) {
    Absent => false
    Present { value: verdict } =>
      match verdict {
        ArmMemoryFitUnestablished { obligations: os } =>
          length(os) == 30
            && !any(os, o => string_contains(s: o as String, pattern: "checkpoint-residency has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "kv-cache has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "loader-transform has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "activation-workspace has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "graph-capture has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "fragmentation-allowance has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "host-os-control-reserve"))
            && any(os, o => string_contains(s: o as String, pattern: "foreign-residency"))
        _ => false
      }
  }
}

test fn w_fewer_ranks_refuse_on_the_checkpoint_bytes_alone() -> Bool {
  let tp1 = arm_memory_fit_verdict_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: SingleSparkTp1, profile: glm_native_initial_profile)
  let tp2 = arm_memory_fit_verdict_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: SparkPairTp2, profile: glm_native_initial_profile)
  let tp8 = arm_memory_fit_verdict_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: EightSparkTp8, profile: glm_native_initial_profile)
  (match tp1 {
    Present { value: ArmMemoryFitRefused { rank: r, phase: p, demand_lower: d, supply_upper: _, cause: _ } } =>
      r == 0 && p == ArmPhaseModelLoad && byte_size_count(b: d) == 327491256321
    _ => false
  })
    && (match tp2 {
      Present { value: ArmMemoryFitRefused { rank: r, phase: _, demand_lower: d, supply_upper: _, cause: _ } } =>
        r == 0 && byte_size_count(b: d) == 163745628160
      _ => false
    })
    && (match tp8 {
      Present { value: ArmMemoryFitUnestablished { obligations: _ } } => true
      _ => false
    })
}

// ── WITNESS 2: THE SHRUNK INTENT, FULLY RECEIPTED, DISCRIMINATES TO A PROOF ─────────────────────
//
// THE SAME ARM at four seats of 64K, with the component ceilings the obligations name, is
// FitProved -- and the proof's worst corner is the peak-serving phase against the decided
// envelope at 8400 basis points, with the headroom the envelope arithmetic gives. Remove the
// receipts (the control) and the identical subject falls back to Unestablished: the verdict
// discriminates on the BOUNDS, not on a tuned pool figure.
test fn w_the_shrunk_fully_receipted_intent_is_proved() -> Bool {
  match arm_memory_fit_verdict(subject: fx_proved_subject()) {
    ArmMemoryFitProved { rank: r, phase: p, headroom_bytes: h } =>
      r == 0 && p == ArmPhasePeakServing && byte_size_count(b: h) == 18403934864
    _ => false
  }
}

fn fx_open_terms_subject() -> ArmMemoryFitSubject {
  ArmMemoryFitSubject {
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: glm_native_serving_profile_2026_09_19,
    intent: fx_shrunk_intent(),
    ranks: fx_uniform_ranks(terms: [
      checkpoint_residency_term(crow_weight_gib: gibibyte(count: 306), ranks: 4),
      ArmComponentTermBound { component: ArmLoaderTransform, bound: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr } },
      fx_ceiling_term(component: ArmRuntimeFixed, gib: 2, receipt: "fx-RuntimeFixedAllocationBound" as NonEmptyStr),
      fx_ceiling_term(component: ArmCollectiveWorkspace, gib: 1, receipt: "fx-CollectiveWorkspaceBound" as NonEmptyStr),
      fx_ceiling_term(component: ArmActivationWorkspace, gib: 2, receipt: "fx-ActivationWorkspaceBound" as NonEmptyStr),
      fx_ceiling_term(component: ArmGraphCapture, gib: 1, receipt: "fx-GraphCaptureBound" as NonEmptyStr),
      fx_kv_term(seats: 4),
      fx_ceiling_term(component: ArmFragmentationAllowance, gib: 1, receipt: "fx-AllocatorFragmentationBound" as NonEmptyStr),
    ]),
    pool: fx_pool(),
    deductions: fx_deductions(),
  }
}

test fn w_the_same_subject_without_one_receipt_is_unestablished() -> Bool {
  match arm_memory_fit_verdict(subject: fx_open_terms_subject()) {
    ArmMemoryFitUnestablished { obligations: os } =>
      length(os) == 4
        && any(os, o => string_contains(s: o as String, pattern: "rank 0 loader-transform has no defensible bound: fx-open"))
        && any(os, o => string_contains(s: o as String, pattern: "rank 3 loader-transform has no defensible bound: fx-open"))
    _ => false
  }
}

// ── WITNESS 3: THE WORST RANK DECIDES, NOT THE AVERAGE ──────────────────────────────────────────
//
// RANK ZERO carries the replicated tensors in this fixture: its checkpoint residency interval is
// authored above anything the pool can supply, while ranks one through three carry the proved
// fixture's exact terms. The verdict refuses at RANK ZERO; the control -- the uniform proved
// subject -- is unchanged, which is what makes the refusal about rank zero and not about the arm.
fn fx_asymmetric_ranks() -> List<ArmRankDemandBounds> {
  let normal = fx_terms(
    ckpt: checkpoint_residency_term(crow_weight_gib: gibibyte(count: 306), ranks: 4),
    kv: fx_kv_term(seats: 4))
  [
    ArmRankDemandBounds {
      rank: 0,
      terms: concat([ArmComponentTermBound {
        component: ArmCheckpointResidency,
        bound: fx_interval(
          lower: 132070244352,
          upper: 140996502528,
          how: "fixture: rank zero carries the replicated tensors and its mandatory checkpoint residency exceeds the most generous supply on its own" as NonEmptyStr),
      }], skip_first(terms: normal)),
    },
    ArmRankDemandBounds { rank: 1, terms: normal },
    ArmRankDemandBounds { rank: 2, terms: normal },
    ArmRankDemandBounds { rank: 3, terms: normal },
  ]
}

fn skip_first(terms: List<ArmComponentTermBound>) -> List<ArmComponentTermBound> {
  terms.skip(n: 1)
}

test fn w_the_worst_rank_decides_the_verdict() -> Bool {
  let subject = ArmMemoryFitSubject {
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: glm_native_serving_profile_2026_09_19,
    intent: fx_shrunk_intent(),
    ranks: fx_asymmetric_ranks(),
    pool: fx_pool(),
    deductions: fx_deductions(),
  }
  match arm_memory_fit_verdict(subject: subject) {
    ArmMemoryFitRefused { rank: r, phase: _, demand_lower: d, supply_upper: _, cause: c } =>
      r == 0
        && byte_size_count(b: d) == 132070244352
        && string_contains(s: c as String, pattern: "checkpoint-residency")
        && (match arm_memory_fit_verdict(subject: fx_proved_subject()) {
          ArmMemoryFitProved { rank: _, phase: _, headroom_bytes: _ } => true
          _ => false
        })
    _ => false
  }
}

// ── WITNESS 4: THE DECIDED ENVELOPE IS A WALL OF ITS OWN, AND ONLY WHERE THE ENGINE IS ADMITTED ──
//
// A rank whose mandatory demand sits BETWEEN the envelope's most generous reading and the pool's
// refuses at the FIRST ENGINE-ADMITTED phase -- profiling, not model load: the load phases are
// governed by the pool wall alone, because the loader's staging is pool-resident but not
// envelope-resident. This is the check the 0.84-effective-0.8233 advice was pointing at: the
// envelope the engine will be ASKED for cannot hold the mandatory residency.
fn fx_envelope_refused_subject() -> ArmMemoryFitSubject {
  let terms = [
    ArmComponentTermBound {
      component: ArmCheckpointResidency,
      bound: fx_interval(
        lower: 123480309760,
        upper: 124527089664,
        how: "fixture: mandatory per-rank demand between the decided envelope's most generous reading and the pool's most generous reading" as NonEmptyStr),
    },
    fx_ceiling_term(component: ArmRuntimeFixed, gib: 2, receipt: "fx-RuntimeFixedAllocationBound" as NonEmptyStr),
  ]
  ArmMemoryFitSubject {
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: glm_native_serving_profile_2026_09_19,
    intent: fx_shrunk_intent(),
    ranks: fx_uniform_ranks(terms: terms),
    pool: fx_pool(),
    deductions: fx_deductions(),
  }
}

test fn w_the_envelope_refuses_at_the_first_engine_admitted_phase() -> Bool {
  match arm_memory_fit_verdict(subject: fx_envelope_refused_subject()) {
    ArmMemoryFitRefused { rank: r, phase: p, demand_lower: d, supply_upper: s, cause: c } =>
      r == 0
        && p == ArmPhaseProfiling
        && byte_size_count(b: d) == 123480309760
        && byte_size_count(b: s) == 110037062123
        && string_contains(s: c as String, pattern: "envelope")
    _ => false
  }
}

// ── WITNESS 5: PHASES KEEP TRANSIENTS IN THEIR PHASE ────────────────────────────────────────────
//
// THE LOADER TRANSIENT EXISTS ONLY WHILE LOADING. With the proved fixture's terms, the
// loader-transform ceiling is present at model load, loader transform and restart overlap, and
// absent at idle and peak serving -- and the restart overlap carries the successor's load profile
// exactly, because the restart admission stops the old engine before the new one loads.
test fn w_the_loader_transient_is_charged_only_in_its_phases() -> Bool {
  let terms = fx_terms(
    ckpt: checkpoint_residency_term(crow_weight_gib: gibibyte(count: 306), ranks: 4),
    kv: fx_kv_term(seats: 4))
  let model_upper = match demand_for_phase(terms: terms, phase: ArmPhaseModelLoad).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let idle_upper = match demand_for_phase(terms: terms, phase: ArmPhaseIdleServing).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let loader_upper = match demand_for_phase(terms: terms, phase: ArmPhaseLoaderTransform).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  let overlap_upper = match demand_for_phase(terms: terms, phase: ArmPhaseRestartOverlap).upper {
    Absent => 0
    Present { value: b } => byte_size_count(b: b)
  }
  loader_upper == overlap_upper
    && loader_upper - model_upper == byte_size_count(b: fx_gib(1))
    && idle_upper - model_upper == byte_size_count(b: fx_gib(3))
}

// ── WITNESS 6: UNKNOWN WITHOUT BOUND REFUSES NORMAL SERVING AND ADMITS THE EXPERIMENT ───────────
//
// THE GATE IS INTENT-SPLIT. FitUnestablished refuses normal serving with the obligations carried
// into the cause; FitRefused refuses with its numbers; FitProved admits; and a bounded experiment
// is admitted on ANY verdict, because the experiment is what mints the receipts that turn
// Unestablished into Proved.
test fn w_unknown_without_bound_refuses_normal_serving_and_not_the_experiment() -> Bool {
  match arm_memory_launch_gate(intent: ArmNormalServing, verdict: ArmMemoryFitUnestablished { obligations: ["fx-obligation" as NonEmptyStr] }) {
    Present { value: c } => string_contains(s: c as String, pattern: "fx-obligation")
    Absent => false
  }
    && (match arm_memory_launch_gate(intent: ArmBoundedExperiment, verdict: ArmMemoryFitUnestablished { obligations: ["fx-obligation" as NonEmptyStr] }) {
      Present { value: _ } => false
      Absent => true
    })
    && (match arm_memory_launch_gate(intent: ArmNormalServing, verdict: ArmMemoryFitProved { rank: 0, phase: ArmPhaseIdleServing, headroom_bytes: fx_gib(1) }) {
      Present { value: _ } => false
      Absent => true
    })
    && (match arm_memory_launch_gate(intent: ArmNormalServing, verdict: ArmMemoryFitRefused {
      rank: 0, phase: ArmPhaseModelLoad, demand_lower: fx_gib(1), supply_upper: fx_gib(1), cause: "fx-refusal" as NonEmptyStr }) {
      Present { value: c } => string_contains(s: c as String, pattern: "fx-refusal")
      Absent => false
    })
}

// ── WITNESS 7: A MEASUREMENT TIGHTENS ONE TERM; AN OBSERVATION ABOVE THE BOUND FALSIFIES ────────
//
// THE READBACK DISCIPLINE, BOTH DIRECTIONS. At or below a ceiling, the observation is consistent
// and the term's bound tightens to the observed value -- a measurement tightens ONE term. Above
// the ceiling -- or anywhere around an exact derived figure -- the model is falsified, and the
// falsification carries the predicted bound, the observation and the receipt: never a silent
// formula replacement.
test fn w_observation_above_the_bound_falsifies_never_retunes() -> Bool {
  (match arm_observe_component(
    component: ArmGraphCapture,
    bound: ComponentBoundCeiling { bytes: fx_gib(1), receipt: "fx-GraphCaptureBound" as NonEmptyStr },
    observed: fx_gib(2),
    receipt: "fx-run-7" as NonEmptyStr) {
    ArmMemoryModelFalsified { component: c, predicted_bound: p, observed: o, receipt: _ } =>
      c == ArmGraphCapture && byte_size_count(b: p) == 1073741824 && byte_size_count(b: o) == 2147483648
    ArmObservationConsistent { component: _, tightened: _, observed: _, receipt: _ } => false
  })
    && (match arm_observe_component(
      component: ArmGraphCapture,
      bound: ComponentBoundCeiling { bytes: fx_gib(2), receipt: "fx-GraphCaptureBound" as NonEmptyStr },
      observed: fx_gib(1),
      receipt: "fx-run-8" as NonEmptyStr) {
      ArmObservationConsistent { component: _, tightened: t, observed: _, receipt: r } =>
        r == "fx-run-8" as NonEmptyStr
          && (match t {
            ComponentBoundCeiling { bytes: b, receipt: r2 } =>
              byte_size_count(b: b) == 1073741824 && r2 == "fx-run-8" as NonEmptyStr
            _ => false
          })
      ArmMemoryModelFalsified { component: _, predicted_bound: _, observed: _, receipt: _ } => false
    })
    && (match arm_observe_component(
      component: ArmActivationWorkspace,
      bound: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr },
      observed: fx_gib(3),
      receipt: "fx-run-9" as NonEmptyStr) {
      ArmObservationConsistent { component: _, tightened: t, observed: _, receipt: _ } =>
        match t {
          ComponentBoundCeiling { bytes: b, receipt: _ } => byte_size_count(b: b) == 3221225472
          _ => false
        }
      ArmMemoryModelFalsified { component: _, predicted_bound: _, observed: _, receipt: _ } => false
    })
}

// ── WITNESS 8: THE INTENT IS DERIVED, AND THE FLOOR PROJECTS INTO IT ────────────────────────────
//
// THE SEAT POPULATION, NOT A POOL FIGURE. The compact envelope projections derive from the
// budgets: four seats of 64K read max_single 64K, max_total 256K, seats 4. The launch profile's
// worst case is every admitted sequence at the full window: sixteen seats of 262144. Coverage is
// explicit policy: a seat population above the profile's max_num_seqs is refused, not silently
// clamped. And the pair floor's uniform row projects forward into the same vocabulary.
test fn w_the_intent_envelope_derives_from_the_seat_population() -> Bool {
  (match serving_capacity_intent(cold_sequence_budgets: [], max_batched_tokens: token_count(count: 2048)) {
    ServingCapacityIntentRefused { cause: _ } => true
    ServingCapacityIntentAdmitted { intent: _ } => false
  })
    && (match uniform_cold_seats(each: token_count(count: 65536), seats: 4, max_batched_tokens: token_count(count: 2048)) {
      ServingCapacityIntentAdmitted { intent: i } =>
        intent_max_active_sequences(i: i) == 4
          && token_count_value(t: intent_max_single_sequence_tokens(i: i)) == 65536
          && token_count_value(t: intent_max_total_resident_tokens(i: i)) == 262144
      ServingCapacityIntentRefused { cause: _ } => false
    })
    && (match intent_for_launch_profile(p: glm_native_serving_profile_2026_09_19) {
      ServingCapacityIntentAdmitted { intent: i } =>
        intent_max_active_sequences(i: i) == 16
          && token_count_value(t: intent_max_total_resident_tokens(i: i)) == 4194304
      ServingCapacityIntentRefused { cause: _ } => false
    })
    && (match minimum_cold_sessions_intent(floor: spark_pair_serving_minimum_cold_sessions, max_batched_tokens: token_count(count: 2048)) {
      ServingCapacityIntentAdmitted { intent: i } =>
        intent_max_active_sequences(i: i) == spark_pair_serving_minimum_cold_sessions.sessions
          && token_count_value(t: intent_max_single_sequence_tokens(i: i)) == 500000
      ServingCapacityIntentRefused { cause: _ } => false
    })
}

// ── WITNESS 9: THE KV BYTE DERIVATION ITSELF ────────────────────────────────────────────────────
//
// THE BLOCK FOLD'S BYTE TWIN, discriminating where a scaled full-context figure would not: the
// fixture layout charges 256 MiB for a 64K seat, and the walls are the block fold's own -- an
// empty budget, a budget past the context cap, and (by the group fold) a zero block size all
// refuse rather than divide or report a free request.
test fn w_the_kv_byte_cost_derives_from_the_layout() -> Bool {
  (match cold_admission_bytes(layout: fx_layout, sequence_budget: token_count(count: 65536)) {
    AdmissionByteCostBytes { bytes: b } => byte_size_count(b: b) == 268435456
    AdmissionByteCostUnestablished { cause: _ } => false
  })
    && (match cold_admission_bytes(layout: fx_layout, sequence_budget: token_count(count: 0)) {
      AdmissionByteCostBytes { bytes: _ } => false
      AdmissionByteCostUnestablished { cause: _ } => true
    })
    && (match cold_admission_bytes(layout: fx_layout, sequence_budget: token_count(count: 262145)) {
      AdmissionByteCostBytes { bytes: _ } => false
      AdmissionByteCostUnestablished { cause: _ } => true
    })
    && (match fx_kv_term(seats: 4).bound {
      ComponentBoundInterval { lower: l, upper: u, how: _ } =>
        byte_size_count(b: l) == 1073741824 && byte_size_count(b: u) == 1073741824
      _ => false
    })
}

test fn w_all_arm_memory_fit_claims_hold() -> Bool {
  w_the_production_tuple_is_unestablished_with_named_obligations()
    && w_fewer_ranks_refuse_on_the_checkpoint_bytes_alone()
    && w_the_shrunk_fully_receipted_intent_is_proved()
    && w_the_same_subject_without_one_receipt_is_unestablished()
    && w_the_worst_rank_decides_the_verdict()
    && w_the_envelope_refuses_at_the_first_engine_admitted_phase()
    && w_the_loader_transient_is_charged_only_in_its_phases()
    && w_unknown_without_bound_refuses_normal_serving_and_not_the_experiment()
    && w_observation_above_the_bound_falsifies_never_retunes()
    && w_the_intent_envelope_derives_from_the_seat_population()
    && w_the_kv_byte_cost_derives_from_the_layout()
}
