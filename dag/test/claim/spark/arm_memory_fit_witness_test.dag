// THE RESTORATION PROFILE, unwrapped through the plain carrier the resolver seam can type (the
// sole-constructor payload's produced identity is erased at the cross-module Present seam).
fn w_restoration_profile() -> ServingLaunchProfile {
  match group_b_restoration_executable() {
    Present { value: executable } => executable.profile
    Absent => glm_native_initial_profile
  }
}


// ── THE WITNESS SUBJECTS ARE FIXTURES WITH REAL PRODUCTION NUMBERS WHERE A DERIVATION EXISTS ────
//
// The pool span, the checkpoint aggregate and the envelope derive through the same functions the
// launch wall uses, against the real GLM-5.3-Flash row (306 ceil-GiB) and the real GB10 pool
// reading (121 GiB rounded). Measured bounds carry receipts NAMING the checkpoint, runtime and
// topology they claim to be measured on -- the mint's provenance check is under test here, so the
// fixtures spell the wires rather than shortcutting them.

fn fx_gib(n: Nat) -> ByteSize {
  gibibyte_to_byte_size(g: gibibyte(count: n))
}

data fx_pool_low: ByteSize = byte_size(count: 129922760704)
data fx_pool_high: ByteSize = byte_size(count: 130996502527)

fn fx_pool() -> ArmPoolBound {
  match closed_interval(low: fx_pool_low, high: fx_pool_high, le: measure_le) {
    IntervalReady { interval: i } =>
      ArmPoolBounded {
        span: i,
        how: "fixture span identical to the one gunbc.spark.arm_memory_fit gb10_pool_bound derives from the rounded reading" as NonEmptyStr,
      }
    IntervalRefused { reason: r } =>
      ArmPoolUnbounded { obligation: r }
  }
}

fn fx_ckpt_wire() -> String {
  serving_checkpoint_wire(c: Glm53NativeFp8) as String
}

fn fx_rt_wire() -> String {
  serving_runtime_wire(r: GunbcGlm53NopeDerivedGb10) as String
}

fn fx_tp_wire() -> String {
  serving_topology_wire(t: FourSparkTp4) as String
}

// A MEASURED RECEIPT NAMES THE IDENTITY, as the provenance check requires: kind, checkpoint,
// runtime, topology, and the fixture receipt id.
fn fx_receipt(kind: NonEmptyStr) -> NonEmptyStr {
  join([
    kind as String, " measured on ", fx_ckpt_wire(), " x ", fx_rt_wire(), " x ", fx_tp_wire(),
    " rank population (fixture receipt fx-r2)",
  ], "") as NonEmptyStr
}

fn fx_how(text: NonEmptyStr) -> NonEmptyStr {
  join([text as String, " -- ", fx_ckpt_wire(), " ", fx_tp_wire(), " fixture derivation"], "") as NonEmptyStr
}

fn fx_interval(lower: Nat, upper: Nat, how: NonEmptyStr) -> ArmComponentBound {
  match component_bound_interval(lower: byte_size(count: lower), upper: byte_size(count: upper), how: how) {
    ArmComponentBoundReady { bound: b } => b
    ArmComponentBoundRefused { cause: c } => ComponentBoundOpen { obligation: c }
  }
}

fn fx_ceiling(component_kind: NonEmptyStr, gib: Nat) -> ArmComponentBound {
  ComponentBoundCeiling { bytes: fx_gib(gib), receipt: fx_receipt(kind: component_kind) }
}

// THE FIXTURE LAYOUT IS HYBRID-SHAPED on purpose: one full-attention group, sixteen-token blocks,
// sixty-four-KiB pages. GLM-5.3-Flash's real per-group shape (MLA plus linear-attention state) is
// an open upstream obligation -- the engine emits no group metadata (extdeps.vllm.kv_layout states
// the trigger) -- so the fixture charges a full-attention cost and says so.
data fx_layout: ResolvedKvLayout = resolved_kv_layout(
  allocator_blocks: allocator_block_count(count: 4096),
  scheduler_block_size: token_count(count: 16),
  hash_block_size: token_count(count: 16),
  max_model_len: token_count(count: 262144),
  max_num_batched_tokens: token_count(count: 2048),
  groups: [KvGroupLayout {
    kind: FullAttention,
    layer_count: attention_layer_count(count: 1),
    block_size: token_count(count: 16),
    page_size_bytes: byte_size(count: 65536),
  }],
  established_at_revision: vllm_source_revision_read,
)

// THE KV TERM IS DERIVED FROM THE SEAT POPULATION OVER THE LAYOUT: a 64K seat at sixteen-token
// blocks holds 4096 blocks of 64 KiB = 256 MiB, and four seats hold 1 GiB. Carried as an Exact
// bound -- the derivation is workload x layout arithmetic, not an estimate.
fn fx_kv_bound() -> ArmComponentBound {
  let per_seat = match cold_admission_bytes(layout: fx_layout, sequence_budget: token_count(count: 65536)) {
    AdmissionByteCostBytes { bytes: b } => b
    AdmissionByteCostUnestablished { cause: _ } => byte_size(count: 0)
  }
  ComponentBoundExact {
    bytes: byte_size(count: byte_size_count(b: per_seat) * 4),
    how: fx_how(text: "required_kv_bytes: 4 seats x cold_admission_bytes(fixture layout, 64K budget) = 1 GiB exactly" as NonEmptyStr),
  }
}

// THE SHRUNK SERVICE: four cold seats of 64K, batched ceiling 2048.
fn fx_shrunk_intent() -> ServingCapacityIntent {
  match uniform_cold_seats(each: token_count(count: 65536), seats: 4, max_batched_tokens: token_count(count: 2048)) {
    ServingCapacityIntentAdmitted { intent: i } => i
    ServingCapacityIntentRefused { cause: _ } => ServingCapacityIntent { cold_sequence_budgets: [], max_batched_tokens: token_count(count: 1) }
  }
}

// THE EXECUTABLE PROFILE THE FIXTURE PRICES, derived from the intent through the same function
// the experiment plan and the subject mint use -- the join under test is between THIS derivation
// and the subject, not between two independently authored values.
fn fx_derived_profile() -> ServingLaunchProfile {
  profile_for_intent(
    intent: fx_shrunk_intent(),
    decided_gpu_memory_basis_points: basis_point(count: 8400),
    kv_cache_dtype_wire: "fp8" as NonEmptyStr,
    serve_port: 30000,
    served_alias: "glm-5.3-flash" as NonEmptyStr,
    prefix_caching: PrefixCachingExplicit { enabled: true })
}

// ONE MEASURED RANK ROW: per-rank checkpoint placement measured even (the ceiling is the split
// share of the 306 ceil-GiB aggregate), every other mechanism carried as a measured ceiling, the
// KV demand exact. Receipts name the identity throughout.
fn fx_rank(rank: Nat, checkpoint: ArmComponentBound) -> ArmRankDemand {
  ArmRankDemand {
    rank: rank,
    checkpoint_residency: checkpoint,
    loader_transform: fx_ceiling(component_kind: "CheckpointRankResidencyBound" as NonEmptyStr, gib: 1),
    runtime_fixed: fx_ceiling(component_kind: "RuntimeFixedAllocationBound" as NonEmptyStr, gib: 2),
    collective_workspace: fx_ceiling(component_kind: "CollectiveWorkspaceBound" as NonEmptyStr, gib: 1),
    activation_workspace: fx_ceiling(component_kind: "ActivationWorkspaceBound" as NonEmptyStr, gib: 2),
    graph_capture: fx_ceiling(component_kind: "GraphCaptureBound" as NonEmptyStr, gib: 1),
    kv_cache: fx_kv_bound(),
    fragmentation_allowance: fx_ceiling(component_kind: "AllocatorFragmentationBound" as NonEmptyStr, gib: 1),
  }
}

fn fx_even_checkpoint() -> ArmComponentBound {
  fx_ceiling(component_kind: "CheckpointRankResidencyBound" as NonEmptyStr, gib: 77)
}

fn fx_four_even_ranks() -> List<ArmRankDemand> {
  [
    fx_rank(rank: 0, checkpoint: fx_even_checkpoint()),
    fx_rank(rank: 1, checkpoint: fx_even_checkpoint()),
    fx_rank(rank: 2, checkpoint: fx_even_checkpoint()),
    fx_rank(rank: 3, checkpoint: fx_even_checkpoint()),
  ]
}

fn fx_deductions() -> ArmSupplyDeductions {
  ArmSupplyDeductions {
    host_os_control_reserve: ComponentBoundCeiling { bytes: fx_gib(8), receipt: "fx-host-reserve-measurement on the serving hosts" as NonEmptyStr },
    foreign_residency: ComponentBoundCeiling { bytes: fx_gib(2), receipt: "fx-foreign-residency-inventory on the serving hosts" as NonEmptyStr },
  }
}

// ── WITNESS 1: THE PRODUCTION TUPLE'S VERDICT, AND THE AGGREGATE FRONTIER AROUND IT ─────────────
//
// The production subject as the launch wall mints it -- the serving profile's maximum admitted
// behavior as the intent, every term open, the rounded pool, both deductions open -- evaluates to
// FitUnestablished with the missing bounds named. The tp1/tp2 frontier below is REFUSED, but by
// the aggregate argument, which never names a rank: the sentinel rank field carries the rank
// count, which is not a valid rank index.
test fn w_the_production_tuple_is_unestablished_with_named_obligations() -> Bool {
  match arm_memory_fit_subject_for_launch(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    profile: w_restoration_profile(),
  ) {
    ArmMemorySubjectRefused { cause: _ } => false
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitUnestablished { obligations: os } =>
          length(os) == 34
            && any(os, o => string_contains(s: o as String, pattern: "rank 0 checkpoint-residency has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "per-rank checkpoint placement is unread"))
            && any(os, o => string_contains(s: o as String, pattern: "rank 3 kv-cache has no defensible bound"))
            && any(os, o => string_contains(s: o as String, pattern: "host-os-control-reserve"))
            && any(os, o => string_contains(s: o as String, pattern: "foreign-residency"))
        _ => false
      }
  }
}

test fn w_fewer_ranks_refuse_by_the_aggregate_argument_without_naming_a_rank() -> Bool {
  let tp1 = verdict_for(subject_mint: arm_memory_fit_subject_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: SingleSparkTp1, profile: glm_native_initial_profile))
  let tp2 = verdict_for(subject_mint: arm_memory_fit_subject_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: SparkPairTp2, profile: glm_native_initial_profile))
  let tp8 = verdict_for(subject_mint: arm_memory_fit_subject_for_launch(
    checkpoint: Glm53NativeFp8, runtime: GunbcGlm53NopeDerivedGb10,
    topology: EightSparkTp8, profile: glm_native_initial_profile))
  (match tp1 {
    Present { value: ArmMemoryFitRefused { rank: r, phase: p, demand_lower: d, supply_upper: _, cause: c } } =>
      r == 1 && p == ArmPhaseModelLoad && byte_size_count(b: d) == 327491256321
        && string_contains(s: c as String, pattern: "at least one rank")
    _ => false
  })
    && (match tp2 {
      Present { value: ArmMemoryFitRefused { rank: r, phase: _, demand_lower: d, supply_upper: _, cause: c } } =>
        r == 2 && byte_size_count(b: d) == 163745628161
          && string_contains(s: c as String, pattern: "at least one rank")
      _ => false
    })
    && (match tp8 {
      Present { value: ArmMemoryFitUnestablished { obligations: _ } } => true
      _ => false
    })
}

fn verdict_for(subject_mint: ArmMemorySubjectMint) -> ArmMemoryFitVerdict? {
  match subject_mint {
    ArmMemorySubjectRefused { cause: _ } => none
    ArmMemorySubjectReady { subject: s } => Present { value: arm_memory_fit_verdict(subject: s) }
  }
}

// ── WITNESS 2: THE JOIN — A PROFILE THAT DOES NOT DERIVE FROM THE INTENT HAS NO SUBJECT ─────────
//
// THE BLOCKER'S DISCRIMINATING CONTROL. The 4-seat x 64K intent beside the sixteen-sequence
// 262K serving profile: the mint refuses, on BOTH mints, before any verdict exists. A FitProved
// for a small service standing next to a large executable is unwritable, not merely detectable.
test fn w_a_profile_that_does_not_derive_from_the_intent_is_refused_at_the_mint() -> Bool {
  (match arm_memory_fit_subject(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: glm_native_concurrent_profile,
    pool: fx_pool(),
    deductions: fx_deductions()) {
    ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "does not derive from the capacity intent")
    ArmMemorySubjectReady { subject: _ } => false
  })
    && (match arm_memory_fit_subject_with_rank_demands(
      checkpoint: Glm53NativeFp8,
      runtime: GunbcGlm53NopeDerivedGb10,
      topology: FourSparkTp4,
      intent: fx_shrunk_intent(),
      requested_profile: glm_native_concurrent_profile,
      pool: fx_pool(),
      deductions: fx_deductions(),
      ranks: fx_four_even_ranks()) {
      ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "does not derive from the capacity intent")
      ArmMemorySubjectReady { subject: _ } => false
    })
}

// THE FORWARD DIRECTION PROVES: the derived profile joins its intent, and the same subject mints
// ready -- the Proved witness below stands on this join.
test fn w_the_derived_profile_joins_and_the_subject_mints() -> Bool {
  match arm_memory_fit_subject(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions()) {
    ArmMemorySubjectReady { subject: _ } => true
    ArmMemorySubjectRefused { cause: _ } => false
  }
}

// ── WITNESS 3: PROVENANCE — A RECEIPT CARRIED ONTO A CHANGED CHECKPOINT OR RUNTIME IS REFUSED ────
test fn w_a_receipt_for_another_checkpoint_or_runtime_is_refused_at_the_mint() -> Bool {
  (match arm_memory_fit_subject_with_rank_demands(
    checkpoint: Glm53Exl3_205,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions(),
    ranks: fx_four_even_ranks()) {
    ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "does not name this checkpoint x runtime x topology")
    ArmMemorySubjectReady { subject: _ } => false
  })
    && (match arm_memory_fit_subject_with_rank_demands(
      checkpoint: Glm53NativeFp8,
      runtime: Gitcommit90Sm121Exl3,
      topology: FourSparkTp4,
      intent: fx_shrunk_intent(),
      requested_profile: fx_derived_profile(),
      pool: fx_pool(),
      deductions: fx_deductions(),
      ranks: fx_four_even_ranks()) {
      ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "does not name this checkpoint x runtime x topology")
      ArmMemorySubjectReady { subject: _ } => false
    })
}

// ── WITNESS 4: ROSTER CONSERVATION — DUPLICATED OR ABSENT RANKS REFUSE; THE RECORD IS COMPLETE ────
test fn w_a_rank_roster_with_a_duplicated_or_absent_index_is_refused() -> Bool {
  (match arm_memory_fit_subject_with_rank_demands(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions(),
    ranks: [
      fx_rank(rank: 0, checkpoint: fx_even_checkpoint()),
      fx_rank(rank: 0, checkpoint: fx_even_checkpoint()),
      fx_rank(rank: 1, checkpoint: fx_even_checkpoint()),
      fx_rank(rank: 2, checkpoint: fx_even_checkpoint()),
    ]) {
    ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "one row per rank")
    ArmMemorySubjectReady { subject: _ } => false
  })
    && (match arm_memory_fit_subject_with_rank_demands(
      checkpoint: Glm53NativeFp8,
      runtime: GunbcGlm53NopeDerivedGb10,
      topology: FourSparkTp4,
      intent: fx_shrunk_intent(),
      requested_profile: fx_derived_profile(),
      pool: fx_pool(),
      deductions: fx_deductions(),
      ranks: [
        fx_rank(rank: 0, checkpoint: fx_even_checkpoint()),
        fx_rank(rank: 1, checkpoint: fx_even_checkpoint()),
        fx_rank(rank: 2, checkpoint: fx_even_checkpoint()),
      ]) {
      ArmMemorySubjectRefused { cause: c } => string_contains(s: c as String, pattern: "against a topology of 4")
      ArmMemorySubjectReady { subject: _ } => false
    })
}

// THE RECORD SHAPE IS THE CONSERVATION: a KV-omitted rank, a duplicated component, an omitted
// deduction have no spelling -- ArmRankDemand and ArmSupplyDeductions carry every field by
// construction. What CAN be written wrong is a roster whose bounds are all open with the right
// rank count, and that must never reach FitProved.
test fn w_all_open_terms_with_the_right_rank_count_is_never_proved() -> Bool {
  match arm_memory_fit_subject(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: ArmSupplyDeductions {
      host_os_control_reserve: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr },
      foreign_residency: ComponentBoundOpen { obligation: "fx-open" as NonEmptyStr },
    }) {
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitUnestablished { obligations: os } =>
          length(os) > 0
            && any(os, o => string_contains(s: o as String, pattern: "rank 0 kv-cache has no defensible bound"))
        _ => false
      }
    ArmMemorySubjectRefused { cause: _ } => false
  }
}

// ── WITNESS 5: THE RANK-SUM CONSERVATION LAW ────────────────────────────────────────────────────
//
// MEASURED PER-RANK UPPER BOUNDS MUST BE ABLE TO HOLD THE CHECKPOINT between them. Four one-GiB
// ceilings cannot hold 306 GiB of checkpoint however honestly they were minted; the law refuses
// the mismatch as an obligation.
test fn w_rank_upper_bounds_that_cannot_hold_the_checkpoint_refuse_to_prove() -> Bool {
  let tiny = fx_ceiling(component_kind: "CheckpointRankResidencyBound" as NonEmptyStr, gib: 1)
  match arm_memory_fit_subject_with_rank_demands(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions(),
    ranks: [
      fx_rank(rank: 0, checkpoint: tiny),
      fx_rank(rank: 1, checkpoint: tiny),
      fx_rank(rank: 2, checkpoint: tiny),
      fx_rank(rank: 3, checkpoint: tiny),
    ]) {
    ArmMemorySubjectRefused { cause: _ } => false
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitUnestablished { obligations: os } =>
          length(os) == 1
            && any(os, o => string_contains(s: o as String, pattern: "cannot hold the checkpoint between them"))
        _ => false
      }
  }
}

// ── WITNESS 6: THE SHRUNK INTENT, FULLY RECEIPTED, DISCRIMINATES TO A PROOF ─────────────────────
test fn w_the_shrunk_fully_receipted_intent_is_proved() -> Bool {
  match arm_memory_fit_subject_with_rank_demands(
    checkpoint: Glm53NativeFp8,
    runtime: GunbcGlm53NopeDerivedGb10,
    topology: FourSparkTp4,
    intent: fx_shrunk_intent(),
    requested_profile: fx_derived_profile(),
    pool: fx_pool(),
    deductions: fx_deductions(),
    ranks: fx_four_even_ranks()) {
    ArmMemorySubjectRefused { cause: _ } => false
    ArmMemorySubjectReady { subject: subject } =>
      match arm_memory_fit_verdict(subject: subject) {
        ArmMemoryFitProved { rank: r, phase: p, headroom_bytes: h } =>
          r == 0 && p == ArmPhasePeakServing && byte_size_count(b: h) == 17867063952
        _ => false
      }
  }
}

