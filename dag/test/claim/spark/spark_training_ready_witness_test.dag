module test.claim.spark.spark_training_ready_witness_test

import std.types { String, Bool, List, NonEmptyStr, Int }
import std.measure { ByteSize, byte_size }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.spark.serving_terminal_health {
  SparkServingProbeCapture,
  ProbeNeverRan,
  ProbeFailed,
  ProbeAnswered,
}
import gunbc.spark.training_ready {
  SparkServingAbsence,
  ServingAbsent,
  ServingStillPresent,
  ServingAbsenceUnobserved,
  SparkServingRetirementObservation,
  SparkUnifiedPoolObservation,
  SparkTrainingReadiness,
  SparkTrainingReady,
  SparkTrainingNotReady,
  spark_training_readiness,
  spark_serving_absence_from_probe,
  spark_serving_absence_refusal,
  SparkServingAbsenceEvidence,
  spark_serving_endpoint_absence_evidence,
  spark_serving_unit_absence_evidence,
  spark_serving_retirement_observation_from_probes,
  spark_unified_pool_observation_from_capture,
  SparkUnifiedPoolReading,
  SparkUnifiedPoolRead,
  SparkUnifiedPoolUnread,
}

data spark_training_ready_witness_note: String = "SPARK-PAIR-0 P0. The readiness gate's discriminating evidence. Every red here is a state the corpus can author — an unreached probe read as absence, a pool measured before the retirement, a serving cell presented as trainable — so none of these claims is green by construction."

// THE FIXTURES GO THROUGH THE PRODUCERS, BECAUSE THE CARRIERS REFUSED TO BE FABRICATED.
//
// The first draft of this file constructed SparkServingRetirementObservation and
// SparkUnifiedPoolObservation directly and did not compile: both are sole_constructor, and the
// compiler refused construction outside their defining module. That refusal is the wall doing its
// job on its own witness, and the repair is the right one -- a fixture now assembles the same
// probe captures a real run would, so these claims exercise the decode path rather than asserting
// past it.
fn w_refused_capture(detail: String) -> SparkServingProbeCapture {
  ProbeFailed { exit_code: 7, stderr: detail }
}

fn w_retired(host: HostIdentity) -> SparkServingRetirementObservation {
  spark_serving_retirement_observation_from_probes(
    host: host,
    endpoint_capture: w_refused_capture(detail: "connection refused"),
    process_capture: w_refused_capture(detail: "no such process"),
    unit_capture: w_refused_capture(detail: "unit not-found"),
  )
}

fn w_retired_srv6() -> SparkServingRetirementObservation {
  w_retired(host: operator_host_srv6)
}

// ONE AXIS SILENT, THE OTHER TWO POSITIVELY ABSENT. The axis under test is handed a capture that
// never ran, so a rule requiring only "no axis answered" would pass all three of these. Three
// fixtures rather than one parameterised by axis name: selecting on a string would put a second,
// stringly spelling of the axis beside the three fields that already name them.
fn w_silent_capture() -> SparkServingProbeCapture {
  ProbeNeverRan { cause: "ssh timed out" as NonEmptyStr }
}

fn w_retired_endpoint_silent() -> SparkServingRetirementObservation {
  spark_serving_retirement_observation_from_probes(
    host: operator_host_srv6,
    endpoint_capture: w_silent_capture(),
    process_capture: w_refused_capture(detail: "no such process"),
    unit_capture: w_refused_capture(detail: "unit not-found"),
  )
}

fn w_retired_process_silent() -> SparkServingRetirementObservation {
  spark_serving_retirement_observation_from_probes(
    host: operator_host_srv6,
    endpoint_capture: w_refused_capture(detail: "connection refused"),
    process_capture: w_silent_capture(),
    unit_capture: w_refused_capture(detail: "unit not-found"),
  )
}

fn w_retired_unit_silent() -> SparkServingRetirementObservation {
  spark_serving_retirement_observation_from_probes(
    host: operator_host_srv6,
    endpoint_capture: w_refused_capture(detail: "connection refused"),
    process_capture: w_refused_capture(detail: "no such process"),
    unit_capture: w_silent_capture(),
  )
}

fn w_pool_or_refused(host: HostIdentity, free_pool: ByteSize, after: Bool) -> SparkUnifiedPoolObservation? {
  match spark_unified_pool_observation_from_capture(
    host: host,
    free_pool: free_pool,
    capture: ProbeAnswered { stdout: "MemAvailable" },
    observed_after_retirement: after,
  ) {
    SparkUnifiedPoolRead { observation: o } => Present { value: o }
    SparkUnifiedPoolUnread { cause: _ } => none
  }
}

fn w_readiness(
  retirement: SparkServingRetirementObservation,
  host: HostIdentity,
  free_pool: ByteSize,
  after: Bool,
) -> Bool {
  match w_pool_or_refused(host: host, free_pool: free_pool, after: after) {
    Absent => false
    Present { value: pool } =>
      match spark_training_readiness(retirement: retirement, pool: pool) {
        SparkTrainingReady { proof: _ } => true
        SparkTrainingNotReady { cause: _ } => false
      }
  }
}

test fn w_a_fully_retired_training_cell_is_ready() -> Bool {
  w_readiness(retirement: w_retired_srv6(), host: operator_host_srv6, free_pool: byte_size(count: 100000000000), after: true)
}

// THE POSITIVE CONTROL'S MIRROR: THE SERVING CELL IS NEVER READY.
//
// srv5's retirement observation is deliberately WELL-FORMED and fully absent here. If role were not
// consulted, this input would be indistinguishable from srv6's and would pass. It refuses on role
// alone, which is what "srv5 is statically reserved" has to mean to be worth anything.
test fn w_a_serving_cell_refuses_even_with_a_perfect_retirement_observation() -> Bool {
  !w_readiness(
    retirement: w_retired(host: operator_host_srv5),
    host: operator_host_srv5,
    free_pool: byte_size(count: 100000000000),
    after: true,
  )
}

// AN UNREACHED PROBE IS NOT ABSENCE, AND THIS IS THE CLAIM THAT COSTS THE MOST TO GET WRONG.
test fn w_an_unobserved_subject_refuses_on_every_axis() -> Bool {
  !w_readiness(retirement: w_retired_endpoint_silent(), host: operator_host_srv6, free_pool: byte_size(count: 100000000000), after: true)
    && !w_readiness(retirement: w_retired_process_silent(), host: operator_host_srv6, free_pool: byte_size(count: 100000000000), after: true)
    && !w_readiness(retirement: w_retired_unit_silent(), host: operator_host_srv6, free_pool: byte_size(count: 100000000000), after: true)
}

// A SERVER THAT ANSWERED IS THE LOUD ARM: the retirement did not happen.
test fn w_a_still_serving_endpoint_refuses() -> Bool {
  !w_readiness(
    retirement: spark_serving_retirement_observation_from_probes(
      host: operator_host_srv6,
      endpoint_capture: ProbeAnswered { stdout: "0.12.11" },
      process_capture: w_refused_capture(detail: "no such process"),
      unit_capture: w_refused_capture(detail: "unit not-found"),
    ),
    host: operator_host_srv6,
    free_pool: byte_size(count: 100000000000),
    after: true,
  )
}

// A POOL READ BEFORE THE RETIREMENT DESCRIBES A MACHINE THAT WAS STILL SERVING.
//
// This input carries the same byte count as the passing case and differs only in when it was taken,
// which is why the ordering is a field the producer answers for rather than something inferable.
test fn w_a_pool_measured_before_the_retirement_refuses() -> Bool {
  !w_readiness(retirement: w_retired_srv6(), host: operator_host_srv6, free_pool: byte_size(count: 100000000000), after: false)
}

test fn w_a_pool_measured_on_another_host_refuses() -> Bool {
  !w_readiness(retirement: w_retired_srv6(), host: operator_host_srv5, free_pool: byte_size(count: 100000000000), after: true)
}

test fn w_a_non_positive_pool_refuses_rather_than_offering_nothing() -> Bool {
  !w_readiness(retirement: w_retired_srv6(), host: operator_host_srv6, free_pool: byte_size(count: 0), after: true)
}

// A CAPTURE THAT DID NOT ANSWER CANNOT CARRY A BYTE COUNT, whatever integer is passed beside it.
test fn w_a_pool_number_without_a_read_is_refused() -> Bool {
  match spark_unified_pool_observation_from_capture(
    host: operator_host_srv6,
    free_pool: byte_size(count: 100000000000),
    capture: ProbeNeverRan { cause: "ssh timed out" as NonEmptyStr },
    observed_after_retirement: true,
  ) {
    SparkUnifiedPoolUnread { cause: _ } => true
    SparkUnifiedPoolRead { observation: _ } => false
  }
}

// A NONZERO EXIT IS NOT ABSENCE, AND THIS IS THE CLAIM THE PREVIOUS DECODER FAILED.
//
// Its earlier shape mapped every ProbeFailed to ServingAbsent, so a permission denial proved a
// retirement. Exit 7 is curl's "failed to connect" and is the only status that establishes nothing
// is listening; 77 (a real curl code, for an unreadable CA bundle) is a failure and must not.
fn w_absence_established(a: SparkServingAbsence) -> Bool {
  match spark_serving_absence_refusal(a: a) {
    Absent => true
    Present { value: _ } => false
  }
}

fn w_endpoint_absence(capture: SparkServingProbeCapture) -> SparkServingAbsence {
  spark_serving_absence_from_probe(
    subject: "endpoint" as NonEmptyStr,
    evidence: spark_serving_endpoint_absence_evidence(),
    capture: capture,
  )
}

test fn w_only_the_documented_no_listener_exit_establishes_endpoint_absence() -> Bool {
  w_absence_established(a: w_endpoint_absence(capture: ProbeFailed { exit_code: 7, stderr: "connection refused" }))
    && !w_absence_established(a: w_endpoint_absence(capture: ProbeFailed { exit_code: 77, stderr: "error setting certificate file" }))
    && !w_absence_established(a: w_endpoint_absence(capture: ProbeFailed { exit_code: 6, stderr: "could not resolve host" }))
    && !w_absence_established(a: w_endpoint_absence(capture: ProbeFailed { exit_code: 28, stderr: "operation timed out" }))
}

test fn w_a_probe_that_never_ran_or_answered_never_establishes_endpoint_absence() -> Bool {
  !w_absence_established(a: w_endpoint_absence(capture: ProbeNeverRan { cause: "host unreachable" as NonEmptyStr }))
    && !w_absence_established(a: w_endpoint_absence(capture: ProbeAnswered { stdout: "0.12.11" }))
}

// THE UNIT AXIS PROVES ABSENCE BY ANSWERING, WHICH IS WHY ONE RULE COULD NOT COVER ALL THREE.
//
// systemctl show exits ZERO and prints `not-found`; systemd's own authority records that a nonzero
// there means the MANAGER was unreadable. So on this axis the old "nonzero means gone" rule was not
// merely too broad, it was inverted -- and this claim is red under it in both directions.
fn w_unit_absence(capture: SparkServingProbeCapture) -> SparkServingAbsence {
  spark_serving_absence_from_probe(
    subject: "unit" as NonEmptyStr,
    evidence: spark_serving_unit_absence_evidence(),
    capture: capture,
  )
}

test fn w_the_unit_axis_establishes_absence_by_answering_not_by_failing() -> Bool {
  w_absence_established(a: w_unit_absence(capture: ProbeAnswered { stdout: "not-found" }))
    && !w_absence_established(a: w_unit_absence(capture: ProbeAnswered { stdout: "loaded" }))
    && !w_absence_established(a: w_unit_absence(capture: ProbeFailed { exit_code: 1, stderr: "failed to connect to bus" }))
}

// THE REFUSAL NAMES EVERY UNSATISFIED AXIS, NOT THE FIRST. An operator deciding whether to re-probe
// or re-run the retirement needs all of them.
test fn w_the_refusal_carries_a_cause_rather_than_a_bare_negative() -> Bool {
  match spark_serving_absence_refusal(a: w_endpoint_absence(capture: ProbeFailed { exit_code: 77, stderr: "error setting certificate file" })) {
    Present { value: c } => length(c as String) > 0
    Absent => false
  }
}
