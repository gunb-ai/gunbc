}

// THE POSITIVE CONTROL THAT EVERYTHING ELSE IN THIS FILE DEPENDS ON.
//
// llama_cpp_rpc_observed returns an Optional, and every claim below that matches on it would be
// satisfied VACUOUSLY by Absent -- a file full of green claims about a deployment that never
// constructed. That is the shape this corpus keeps finding and it is worth one claim of its own:
// the observed deployment EXISTS, so the conditions in its constructor were all met by the measured
// facts rather than merely not contradicted.
test fn the_observed_llama_cpp_rpc_constructs() -> Bool {
  match llama_cpp_rpc_observed() {
    Present { value: _ } => true
    Absent => false
  }
}

// ONE ADDRESS A CLIENT MAY HOLD, and it is the front door. The peer has no sibling accessor, so
// this is the only endpoint the model can hand anyone.
test fn the_client_endpoint_is_the_front_door_only() -> Bool {
  match llama_cpp_rpc_observed() {
    Absent => false
    Present { value: d } =>
      llama_cpp_rpc_client_endpoint(d: d) == "http://192.168.1.232:30000"
  }
}

// THE PEER IS ADDRESSED ON THE FABRIC, NOT THE LAN. The measured difference is 4.2 GB/min against
// 144 GB/min -- 34x -- and nothing in the served behaviour distinguishes them, so this claim is the
// only thing standing between the specified deployment and a working one that is silently slow.
test fn the_rpc_peer_is_addressed_on_the_fabric() -> Bool {
  match llama_cpp_rpc_observed() {
    Absent => false
    Present { value: d } =>
      llama_cpp_rpc_peer_wire(d: d) == "192.168.100.11:50052"
  }
}

// THE `-c` TRAP, ASSERTED AS THE DERIVATION IT NOW IS. The unit carries 10485760 because ten slots
// each get 1048576 -- not because someone typed 10485760 next to a 10. The operator's table records
// what the authored-pair version costs: -c 6291456 with --parallel 16 silently yields 2048 per slot.
test fn the_total_kv_budget_is_derived_from_per_slot_and_slot_count() -> Bool {
  token_count_value(t: llama_cpp_rpc_slot_plan_total_kv(plan: llama_cpp_rpc_observed_slot_plan)) == 10485760
    && token_count_value(t: llama_cpp_rpc_slot_plan_per_slot(plan: llama_cpp_rpc_observed_slot_plan)) == 1048576
}

// A DISCRIMINATING RED: the silent shrink is now unwritable, because there is no second number to
// disagree. Sixteen slots at the same per-slot window derives a LARGER total, never a smaller
// per-slot window -- which is the exact inversion of the failure the operator recorded.
test fn raising_the_slot_count_cannot_shrink_the_per_slot_window() -> Bool {
  let wider = llama_cpp_rpc_slot_plan(
    per_slot_context: token_count(count: 1048576),
    slots: positive_slot_count(count: positive_measure_count(predecessor: 15)))
  token_count_value(t: llama_cpp_rpc_slot_plan_per_slot(plan: wider)) == 1048576
    && token_count_value(t: llama_cpp_rpc_slot_plan_total_kv(plan: wider)) == 16777216
}

// ================= DISCRIMINATING REDS ON THE CONSTRUCTOR =================

// A SPLIT ACROSS ONE MACHINE IS NOT A SPLIT. It is one process addressing itself over a network
// address, and it would report perfectly healthy.
test fn a_deployment_whose_two_ends_are_one_host_refuses() -> Bool {
  {
    let link = llama_cpp_rpc_observed_fabric
      match llama_cpp_rpc_fabric_endpoint_on(fabric: link, host: operator_host_srv8) {
        Absent => false
        Present { value: e } =>
          match llama_cpp_rpc_construct(
            alias: "x" as NonEmptyStr,
            front_door: llama_cpp_rpc_front_door(
              host: operator_host_srv8,
              client_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 233),
              port: 30000),
            weights_peer: llama_cpp_rpc_weights_peer(
              host: operator_host_srv8, fabric_address: e.address, port: 50052),
            fabric: link,
            slot_plan: llama_cpp_rpc_observed_slot_plan,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

// A PEER ADDRESSED OFF THE FABRIC REFUSES. This is the 34x claim as a wall: the deployment would
// work, so no test of its behaviour could catch it.
test fn a_peer_addressed_off_the_fabric_refuses() -> Bool {
  {
    let link = llama_cpp_rpc_observed_fabric
      match llama_cpp_rpc_construct(
        alias: "x" as NonEmptyStr,
        front_door: llama_cpp_rpc_front_door(
          host: operator_host_srv7,
          client_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 232),
          port: 30000),
        weights_peer: llama_cpp_rpc_weights_peer(
          host: operator_host_srv8,
          fabric_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 233),
          port: 50052),
        fabric: link,
        slot_plan: llama_cpp_rpc_observed_slot_plan,
      ) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

// C1, ASKED AS A QUESTION A ROSTER CAN ANSWER. The host holding weights must never be published as
// a serving endpoint by some OTHER roster that does not know this deployment exists -- which is
// exactly how .233 would come to accept a load, given it also runs an unrelated ollama on :11434
// with roughly 105 of 121 GiB already committed and swap disabled.
test fn the_weights_peer_host_is_identifiable_as_one() -> Bool {
  llama_cpp_rpc_host_is_weights_peer(
    deployments: llama_cpp_rpc_observed_units(), host: operator_host_srv8)
    && !llama_cpp_rpc_host_is_weights_peer(
         deployments: llama_cpp_rpc_observed_units(), host: operator_host_srv7)
}


// THERE IS DELIBERATELY NO WITNESS THAT A THRESHOLD IS MET, because the predicate it would have
// exercised has been deleted rather than fixed.
//
// It read the LOW end of the band, which is the fail-closed direction and is why it survived a first
// review. That defence does not hold. The low end is the MINIMUM OF THE SAMPLES TAKEN SO FAR, not a
// proven lower bound over the workloads this unit may meet: a deeper retained context or a different
// context distribution could produce a rate below it, and the predicate would answer "meets" while
// the service disappointed. Rounding down is fail-closed WITHIN the measured samples and says
// nothing about the unmeasured population -- and the name promoted the former into the latter.
//
// The witness that used to stand here is the second half of the reason. Its only consumer was the
// helper it tested, so it established that the helper reads its own low field and nothing else. No
// actuator or selector was ever forced to consult it. A predicate with no production route, proved
// only against itself, is specification-without-execution wearing a green check.
//
// An admissive floor belongs on a workload-qualified service profile -- one carrying occupancy,
// incarnation and request shape -- and this carrier has none of those. Until it does, the honest
// state is that the observation is published and NOTHING is authorised to admit against it.

// A DISCRIMINATING RED: an inverted band has no constructor, so "low 59, high 50" -- the transcription
// error that would silently invert every threshold comparison above -- cannot be authored.
test fn an_inverted_throughput_band_refuses() -> Bool {
  match llama_cpp_rpc_throughput_band(
    slots: llama_cpp_rpc_observed_slot_plan.slots,
    decode_low: tokens_per_second(count: 3),
    decode_high: tokens_per_second(count: 2),
    prefill: tokens_per_second(count: 14),
  ) {
    Absent => true
    Present { value: _ } => false
  }
}


// THE INTERLOCK IS A RESERVATION, NOT A CURRENT PROCESS CENSUS, AND THE NAME USED TO SAY OTHERWISE.
//
// This claim was called `no_serving_cell_is_also_a_weights_peer`, which asserts that the reserved
// host IS CURRENTLY the weights peer. Nothing establishes that. The dated observation says it WAS
// one; the current process topology of that host is UNOBSERVED, and a boolean named for a census it
// never performed is the same absence-as-fact error this module keeps having to unlearn -- once when
// a peer's report stood in for a readback, and once here in the opposite direction.
//
// WHAT IS ENFORCED IS THE RESERVATION'S LIFECYCLE. A positive observation minted it; only a positive
// release receipt clears it; not looking again is not a release. So the refusal does not need to
// prove the host is still a participant. It needs to refuse the one dangerous inference -- "we did
// not re-observe the peer, therefore the host is free" -- and that is exactly what it refuses.
//
// FRONT-DOOR LIVENESS IS DELIBERATELY NOT A CONDITION OF THIS CLAIM. Making it one would read as
// prudence and be FAIL-OPEN: a transient outage would dissolve the hold while the peer's process, its
// boot-enabled unit, its memory commitment and its restart path all survived it untouched. The
// reservation outlives the front door by construction.
//
// WHAT THE 2026-09-03 READBACK ADDS IS URGENCY AND CONTINUITY, NOT THE JOIN. Measured against the
// live service: 192.168.1.232:30000 answers /v1/models with owned_by "llamacpp" at ftype
// "IQ3_S - 3.4375 bpw", /props reports total_slots 10 with per-slot n_ctx 1048576 on all ten and
// is_sleeping false, /slots showed 2 of 10 processing at the read instant, and /version answers 404.
// So a matching front door is live and carrying work. That corroborates the danger and it does NOT
// join the reserved host into the current topology -- and "2 processing" is work at ONE INSTANT, not
// continuous load, not an owner, and not a queue depth.
//
// THE HAZARD IS STATED AT THE STRENGTH THE EVIDENCE SUPPORTS. 192.168.1.233:11434 answers /api/tags
// with deepseek-v4-gguf:no-h3-stop at 86720111694 bytes, IQ2_XXS, so an actuation path to an 86 GB
// artifact EXISTS on the reserved host and is exactly what the serving-cell roster selects. Whether
// loading it would certainly OOM today is NOT established -- that needs a current memory census and
// current peer residency, neither of which was observed. The honest form: loading it is potentially
// catastrophic under the last observed internal-participant and memory state, and current evidence
// has not discharged that risk. Refusing does not require converting an unresolved catastrophic risk
// into a falsely certain claim about today.
//
// THE RULE IS DISJOINTNESS BETWEEN TWO ROSTERS, NOT A NAMED HOST. Nothing here says "srv8 may never
// serve". It says a host carrying an undischarged internal-participant reservation may not enter an
// independent serving roster, which stays the right rule under any partition and dissolves the
// moment a release receipt exists.
//
// THE NON-EMPTINESS CONJUNCT IS NOT DECORATION. `any` over an empty list is false and its negation is
// true, so the disjointness half alone goes GREEN when no reservation exists -- a wall reporting that
// nothing collides because nothing is reserved.
test fn no_serving_cell_uses_an_undischarged_llama_cpp_rpc_peer_reservation() -> Bool {
  length(llama_cpp_rpc_minted_peer_reservations()) > 0
    && all(llama_cpp_rpc_minted_peer_reservations(), r => llama_cpp_rpc_host_has_release_receipt(host: r.host))
    && length(llama_cpp_rpc_undischarged_peer_reservation_hosts()) == 0
    && !any(spark_serving_cell_hosts(), h =>
         llama_cpp_rpc_host_holds_undischarged_reservation(host: h))
}

// THE RELEASE IS A RECEIPT WITH THE NAMED EVIDENCE, NOT A FLAG: the reserved host's receipt states
// its process population, supervisor units, listeners and memory, each non-empty, and the receipt
// clears exactly that host.
test fn the_release_receipt_names_its_evidence_and_clears_only_its_host() -> Bool {
  length(llama_cpp_rpc_release_receipts) == 2
    && any(llama_cpp_rpc_release_receipts, r => host_identity_eq(a: r.host, b: operator_host_srv8) && string_contains(s: r.rpc_server_processes as String, pattern: "none") && string_contains(s: r.memory_state as String, pattern: "GB used"))
    && llama_cpp_rpc_host_has_release_receipt(host: operator_host_srv8)
    && !llama_cpp_rpc_host_has_release_receipt(host: operator_host_srv5)
}


// THE ARTIFACT IDENTITY IS BOUND, established by hashing the four shards in place on the front-door
// host. This is also the positive control for every refusal below: without it they could all be
// satisfied by a constructor that refuses everything.
test fn the_observed_artifact_identity_is_bound() -> Bool {
  match llama_cpp_rpc_observed_artifact() {
    Absent => false
    Present { value: a } =>
      llama_cpp_rpc_artifact_is_bound(a: a) && length(llama_cpp_rpc_observed_shard_digests()) == 4
  }
}

// A DISCRIMINATING RED, AND IT IS THE COUNT-VERSUS-COVERAGE CLASS. "Bound" once meant the digest
// list was non-empty, so an artifact of four shards carrying ONE digest answered true -- a closure
// naming a quarter of the bytes, reported as a fully identified artifact.
//
// THE REFUSAL NOW HAPPENS AT CONSTRUCTION, which is what this claim actually asserts: there is no
// inexact Bound value to hand to a predicate, because minting one from a short chain yields Absent.
test fn a_short_chain_mints_no_bound_identity() -> Bool {
  match llama_cpp_rpc_bound_artifact_identity(
    shards: fx_shard_chain(n: 1),
    shard_count: positive_shard_count(count: positive_measure_count(predecessor: 3))) {
    Present { value: _ } => false
    Absent => true
  }
}

// One well-formed shard digest per ordinal 1..n, so a fixture can vary the CHAIN without varying
// digest validity -- the two conditions the bound arm now carries are then independently testable.
fn fx_shard_chain(n: Int) -> List<LlamaCppRpcShardDigest> {
  flat_map([1, 2, 3, 4], i =>
    if i <= n {
      match llama_cpp_rpc_shard_digest(
        ordinal: positive_measure_count(predecessor: i - 1), hex: fx_digest_hex) {
        Present { value: v } => [v]
        Absent => []
      }
    } else {
      []
    })
}

data fx_digest_hex: String = "1111111111111111111111111111111111111111111111111111111111111111"

// A DISCRIMINATING RED ON THE OTHER HALF OF EXACTNESS: right cardinality, wrong chain. Four digests
// whose ordinals are 1,1,2,3 name a shard set that does not exist, and a length check alone reports
// them as a fully bound artifact. This is the claim that would go green if the ordinal walk were
// removed and the count check left standing.
test fn a_repeated_ordinal_chain_mints_no_bound_identity() -> Bool {
  match llama_cpp_rpc_bound_artifact_identity(
    shards: fx_repeated_chain(),
    shard_count: positive_shard_count(count: positive_measure_count(predecessor: 3))) {
    Present { value: _ } => false
    Absent => true
  }
}

fn fx_repeated_chain() -> List<LlamaCppRpcShardDigest> {
  flat_map([0, 0, 1, 2], pred =>
    match llama_cpp_rpc_shard_digest(
      ordinal: positive_measure_count(predecessor: pred), hex: fx_digest_hex) {
      Present { value: v } => [v]
      Absent => []
    })
}

// A DIGEST IS A TYPED CONTENT HASH, SO A NON-HASH HAS NO CONSTRUCTOR. "banana" is what the previous
// NonEmptyStr carrier accepted as a shard identity; it now yields no ShardDigest at all, which is
// why the chain above cannot be assembled from it in the first place.
test fn a_shard_digest_refuses_a_value_that_is_not_a_sha256_hex() -> Bool {
  match llama_cpp_rpc_shard_digest(
    ordinal: positive_measure_count(predecessor: 0), hex: "banana") {
    Present { value: _ } => false
    Absent => true
  }
}

// POSITIVE CONTROL FOR THE TWO REDS ABOVE: the well-formed four-shard chain DOES mint an identity,
// so the refusals discriminate rather than being a constructor that refuses everything.
test fn a_well_formed_four_shard_chain_mints_a_bound_identity() -> Bool {
  match llama_cpp_rpc_bound_artifact_identity(
    shards: fx_shard_chain(n: 4),
    shard_count: positive_shard_count(count: positive_measure_count(predecessor: 3))) {
    Present { value: _ } => true
    Absent => false
  }
}

// AND THE ARTIFACT REFUSES A SHARD COUNT ITS OWN BOUND IDENTITY CONTRADICTS. Without this the record
// could carry an exact four-shard identity beside a declared count of two, and the identity's
// guarantee would be silently void while every part looked individually valid.
test fn an_artifact_refuses_a_count_its_identity_contradicts() -> Bool {
  match llama_cpp_rpc_bound_artifact_identity(
    shards: fx_shard_chain(n: 4),
    shard_count: positive_shard_count(count: positive_measure_count(predecessor: 3))) {
    Absent => false
    Present { value: bound } =>
      match llama_cpp_rpc_artifact(
        primary_shard_path: "/fixture/shard-00001.gguf" as NonEmptyStr,
        shard_count: positive_shard_count(count: positive_measure_count(predecessor: 1)),
        identity: ArtifactIdentityBound { identity: bound }) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

// THE FRONT DOOR AND THE PEER MAY NOT BE THE SAME PORT ON THE SAME ADDRESS -- the fourth constructor
// condition, which was CLAIMED in the module annotation before it was enforced. This claim is the
// executed evidence that it is now real; it went green vacuously before the guard landed only
// because the string carrier could not compare addresses at all.
test fn a_unit_whose_ends_share_an_address_and_port_has_no_constructor() -> Bool {
  {
    let link = llama_cpp_rpc_observed_fabric
      match llama_cpp_rpc_fabric_endpoint_on(fabric: link, host: operator_host_srv8) {
        Absent => false
        Present { value: e } =>
          match llama_cpp_rpc_construct(
            alias: "fixture" as NonEmptyStr,
            front_door: llama_cpp_rpc_front_door(
              host: operator_host_srv7, client_address: e.address, port: 50052),
            weights_peer: llama_cpp_rpc_weights_peer(
              host: operator_host_srv8, fabric_address: e.address, port: 50052),
            fabric: link,
            slot_plan: llama_cpp_rpc_observed_slot_plan,
          ) {
            Present { value: _ } => false
            Absent => true
          }
      }
  }
}

// THE CLAIM THAT USED TO SIT HERE ASSERTED THE MIXER REFUSED A BAND FROM A DIFFERENT SLOT COUNT.
// The mixer is gone -- it admitted observations drawn from different realizations, which is the
// failure the type names, so a slot-count agreement was not the condition that closed it. With only
// the module's own observation constructible, that RED has no authorable subject, and a claim whose
// forbidden state cannot be written is decoration rather than a weak wall. It is removed rather than
// left permanently green; the trigger that restores it is the realization identity the module's
// annotation names, which needs a second realization to discriminate.

// POSITIVE CONTROL FOR THE JOIN: the observation of 2026-09-02 constructs, so the refusal above is
// discriminating and every claim reading the join is non-vacuous.
test fn the_observed_realization_joins_into_one_observation() -> Bool {
  match llama_cpp_rpc_observed_observation() {
    Present { value: _ } => true
    Absent => false
  }
}

// An unobserved identity is never bound, whatever else the record carries. The unobserved arm still
// CONSTRUCTS -- observation standing permits an artifact whose bytes were never hashed; what it does
// not permit is calling that artifact identified.
test fn an_unobserved_artifact_identity_is_not_bound() -> Bool {
  match llama_cpp_rpc_artifact(
    primary_shard_path: "/fixture/shard-00001.gguf" as NonEmptyStr,
    shard_count: positive_shard_count(count: positive_measure_count(predecessor: 0)),
    identity: ArtifactIdentityUnobserved { cause: "fixture" as NonEmptyStr }) {
    Absent => false
    Present { value: a } => !llama_cpp_rpc_artifact_is_bound(a: a)
  }
}


// THE SNAPSHOT RAIL IS THE RAIL THE OBSERVATION USED. The module carries the 2026-09-02 direct-cable
// rail as its own dated value now that the desired fabric has moved to the switch; this pins every
// field the constructor conditions were checked against, so an edit to the snapshot is an edit to
// history and shows here.
test fn the_snapshot_rail_carries_every_field_the_observation_was_checked_against() -> Bool {
  {
    let link = llama_cpp_rpc_observed_fabric
      match llama_cpp_rpc_fabric_endpoint_on(fabric: link, host: operator_host_srv8) {
        Absent => false
        Present { value: peer } =>
          match llama_cpp_rpc_fabric_endpoint_on(fabric: link, host: operator_host_srv7) {
            Absent => false
            Present { value: door } =>
              render_ipv4_address(addr: peer.address) == "192.168.100.11"
                && render_ipv4_address(addr: door.address) == "192.168.100.10"
                && (peer.interface as String) == "enp1s0f0np0"
                && (door.interface as String) == "enp1s0f0np0"
                && peer.prefix == 24
                && door.prefix == 24
                && byte_size_count(b: peer.mtu) == 9000
                && byte_size_count(b: door.mtu) == 9000
          }
      }
  }
}
