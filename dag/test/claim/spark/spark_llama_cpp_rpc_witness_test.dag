import gunbc.fleet_intent_network {
  operator_host_srv5, operator_host_srv7, operator_host_srv8 }
import gunbc.spark.cell_role { spark_serving_cell_hosts }
import gunbc.spark.llama_cpp_rpc_observed {
  llama_cpp_rpc_observed_fabric, llama_cpp_rpc_fabric_endpoint_on,
  llama_cpp_rpc_front_door,
