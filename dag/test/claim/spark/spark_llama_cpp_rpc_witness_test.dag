  llama_cpp_rpc_slot_plan,
  llama_cpp_rpc_construct,
  llama_cpp_rpc_client_endpoint,
  llama_cpp_rpc_peer_wire,
  llama_cpp_rpc_slot_plan_total_kv,
  llama_cpp_rpc_slot_plan_per_slot,
  llama_cpp_rpc_observed,
  llama_cpp_rpc_observed_units,
  llama_cpp_rpc_observed_slot_plan,
  llama_cpp_rpc_host_is_weights_peer,
  llama_cpp_rpc_undischarged_peer_reservation_hosts,
  llama_cpp_rpc_host_holds_undischarged_reservation,
  llama_cpp_rpc_minted_peer_reservations, llama_cpp_rpc_host_has_release_receipt, llama_cpp_rpc_release_receipts,
  ArtifactIdentityBound,
