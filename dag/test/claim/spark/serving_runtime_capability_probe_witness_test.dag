module test.claim.spark.serving_runtime_capability_probe_witness

import std.types { Bool, List, NonEmptyStr, String }
import gunbc.spark.serving_arm {
  ServingArmVerdict, ServingArmAdmitted, ServingArmRefused,
  Glm53Exl3_205, Glm53NativeFp8, GunbcSparkrunVllmDs4Gb10, Gitcommit90Sm121Exl3,
  SingleSparkTp1, SparkPairTp2, FourSparkTp4,
  serving_arm_admits, runtime_registers, serving_runtime_row, gitcommit90_sm121_exl3_row, gunbc_sparkrun_ds4_row,
}
import extdeps.docker.images.sparkrun_vllm_ds4_gb10 { sparkrun_vllm_ds4_gb10_pinned_reference }
import gunbc.spark.runtime_architecture_registry_reading {
  ArchitectureRegistryReading, registry_reading_for, spark_architecture_registry_readings,
}
import extdeps.docker.images.xomoxcc_dgx_spark_sglang { xomoxcc_dgx_spark_sglang_pinned_reference }
import gunbc.spark.serving_runtime_capability_probe {
  RuntimeKernelCapability, ArchitectureRegistered, Fp4WeightKernels, MlaKvCacheLayoutAdmitted,
  Csa2CompressorKernels, DSparkSpeculator,
  KernelProbeOutcome, KernelObservedPresent, KernelObservedAbsent, KernelProbeRefused,
  KernelProbeSymbolUngrounded, CapabilityProbeSymbol, ProbeSymbolGrounded, ProbeSymbolAwaitingRoster,
  v41_unprobed_capabilities, v41_missing_capabilities,
  runtime_kernel_capability_label,
  V41RuntimeVerdict, V41RuntimeAdmissible, V41RuntimeMissing, V41RuntimeIncompletelyProbed,
  RuntimeCandidateDisposition, CandidateProbed, CandidateNotProbed,
  v41_sm121_capability_probe_rows, v41_sm121_runtime_candidates, v41_runtime_verdict,
  v41_admissible_images, capability_outcome, v41_required_capabilities,
  v41_sm121_build_obligation, v41_capability_probe_symbol,
}

// THE ARCHITECTURE SET IS ASKED BY MEMBERSHIP AND THE TWO RUNTIMES ANSWER DIFFERENTLY, which is the
// discriminating pair: a membership test that always said true, or a set that had silently become
// the same for both images, would fail here rather than pass quietly.
test fn each_runtime_answers_the_membership_question_from_its_own_measured_registry() -> Bool {
  runtime_registers(rrow: gitcommit90_sm121_exl3_row, architecture: "Glm5NextForConditionalGeneration" as NonEmptyStr)
    && !runtime_registers(rrow: gunbc_sparkrun_ds4_row, architecture: "Glm5NextForConditionalGeneration" as NonEmptyStr)
    && runtime_registers(rrow: gunbc_sparkrun_ds4_row, architecture: "DeepseekV4ForCausalLM" as NonEmptyStr)
    && !runtime_registers(rrow: gitcommit90_sm121_exl3_row, architecture: "DeepseekV41ForCausalLM" as NonEmptyStr)
    && !runtime_registers(rrow: gunbc_sparkrun_ds4_row, architecture: "DeepseekV41ForCausalLM" as NonEmptyStr)
}

// THE REFUSAL THE SET REPLACED A BOOL WITH STILL FIRES, AND IT NAMES THE ARCHITECTURE IT LOOKED FOR.
// The pre-change field could only refuse GLM on the DeepSeek image; the cause text is asserted here
// because a refusal that named the wrong architecture would be indistinguishable from a correct one
// by the verdict arm alone.
test fn the_deepseek_image_still_refuses_the_glm_checkpoint_and_names_the_architecture() -> Bool {
  match serving_arm_admits(checkpoint: Glm53Exl3_205, runtime: GunbcSparkrunVllmDs4Gb10, topology: SingleSparkTp1) {
    ServingArmAdmitted => false
    ServingArmRefused { cause: c } =>
      string_contains(s: c as String, pattern: "does not register Glm5NextForConditionalGeneration")
  }
}

// AND THE ADMISSION THAT MUST SURVIVE THE CHANGE: the community image plus the EXL3 checkpoint on one
// Spark was admitted before the membership rewrite and has to stay admitted, or the rewrite tightened
// the wall by accident rather than generalising it.
test fn the_community_image_still_admits_the_exl3_checkpoint_on_one_spark() -> Bool {
  match serving_arm_admits(checkpoint: Glm53Exl3_205, runtime: Gitcommit90Sm121Exl3, topology: SingleSparkTp1) {
    ServingArmAdmitted => true
    ServingArmRefused { cause: _ } => false
  }
}

// THE FOOTPRINT WALL IS UNTOUCHED BY THE ARCHITECTURE WALL, asserted on the tuple where the
// architecture registers and the weights do not fit: if the membership rewrite had swallowed the
// second wall this would read as admitted.
test fn an_architecture_the_runtime_registers_still_fails_the_footprint_wall() -> Bool {
  match serving_arm_admits(checkpoint: Glm53NativeFp8, runtime: Gitcommit90Sm121Exl3, topology: SingleSparkTp1) {
    ServingArmAdmitted => false
    ServingArmRefused { cause: c } => string_contains(s: c as String, pattern: "does not fit the topology")
  }
}

// NO IMAGE PROBED ON A GB10 ADMITS DEEPSEEK V4.1, and this is the sweep's standing rather than a
// statement about images in general -- the candidate roster it folds over is what makes that
// denominator readable. The day an image does admit it, this witness goes red and that is the signal.
test fn no_probed_image_admits_deepseek_v41_on_this_compute_capability() -> Bool {
  length(v41_admissible_images(rows: v41_sm121_capability_probe_rows(), candidates: v41_sm121_runtime_candidates)) == 0
}

// THE VERDICT FOR THE PRODUCTION IMAGE NAMES THE CAPABILITIES THAT WERE MEASURED MISSING, and it is
// deliberately NOT all five. Four were asked with symbols that exist upstream and came back absent;
// the FP4 KV-cache question was asked with names that are not registered ops, so it measured nothing
// and is unprobed. An earlier revision of this witness asserted all five were missing and passed,
// which is what a blind instrument buys you: a confident count over one reading that was never taken.
test fn the_production_image_is_missing_the_four_capabilities_that_were_actually_asked() -> Bool {
  let rows = v41_sm121_capability_probe_rows()
  let image = sparkrun_vllm_ds4_gb10_pinned_reference()
  let missing = v41_missing_capabilities(rows: rows, image_reference: image)
  let unprobed = v41_unprobed_capabilities(rows: rows, image_reference: image)
  match v41_runtime_verdict(rows: rows, image_reference: image) {
    V41RuntimeAdmissible { image_reference: _ } => false
    V41RuntimeIncompletelyProbed { image_reference: _, unprobed: _ } => false
    V41RuntimeMissing { image_reference: _, missing: m } =>
      length(m) == 4
        && length(missing) + length(unprobed) == length(v41_required_capabilities)
        && any(unprobed, u => u as String == "mla-kv-cache-layout-admitted")
        && !any(missing, x => x as String == "mla-kv-cache-layout-admitted")
  }
}

// AN UNGROUNDED SYMBOL MUST NEVER READ AS A MEASURED ABSENCE. This is the wall over the defect that
// produced this revision: the fold that answers "what is missing" and the fold that answers "what
// was never really asked" must disagree about this capability, on every image where it was asked
// with a name that cannot exist. If someone re-types those rows back to KernelObservedAbsent to make
// a count tidy, this goes red.
test fn a_capability_asked_with_an_unauthored_symbol_is_unprobed_and_never_missing() -> Bool {
  all(v41_sm121_capability_probe_rows(), r =>
    match r.outcome {
      KernelProbeSymbolUngrounded { roster: ro, defect: d } =>
        length(ro as String) != 0
          && length(d as String) != 0
          && any(v41_unprobed_capabilities(rows: v41_sm121_capability_probe_rows(), image_reference: r.image.image_reference),
                 u => u as String == runtime_kernel_capability_label(c: r.capability))
          && !any(v41_missing_capabilities(rows: v41_sm121_capability_probe_rows(), image_reference: r.image.image_reference),
                  x => x as String == runtime_kernel_capability_label(c: r.capability))
      KernelObservedPresent { symbol: _ } => true
      KernelObservedAbsent { symbol: _ } => true
      KernelProbeRefused { reason: _ } => true
    })
}

// AND THE OBLIGATION MUST NOT HAND THE BUILD LANE A SYMBOL WE INVENTED. The capability whose roster
// has not landed carries a frontier naming that roster, not a corrected spelling of our own: one
// upstream name, one home.
test fn the_capability_without_a_landed_roster_carries_a_frontier_not_a_spelling() -> Bool {
  match v41_capability_probe_symbol(c: MlaKvCacheLayoutAdmitted) {
    ProbeSymbolGrounded { symbol: _ } => false
    ProbeSymbolAwaitingRoster { roster: ro, trigger: t } =>
      ro as String == "extdeps.vllm.deepseek_v4_1_sm12" && length(t as String) != 0
  }
}

// A REFUSED PROBE IS NOT A MISSING CAPABILITY. The SGLang image answers the registry question and
// refuses the other four, so its four vLLM-vocabulary questions must read as unprobed while its one
// measured negative reads as missing -- the distinction the outcome type exists for.
test fn a_refused_probe_reads_as_unprobed_and_never_as_a_measured_absence() -> Bool {
  match capability_outcome(
    rows: v41_sm121_capability_probe_rows(),
    image_reference: xomoxcc_dgx_spark_sglang_pinned_reference(),
    capability: DSparkSpeculator,
  ) {
    Absent => false
    Present { value: o } =>
      match o {
        KernelProbeRefused { reason: _ } => true
        KernelObservedPresent { symbol: _ } => false
        KernelObservedAbsent { symbol: _ } => false
        KernelProbeSymbolUngrounded { roster: _, defect: _ } => false
      }
  }
}

// THE BUILD OBLIGATION ASKS FOR EXACTLY WHAT THE PROBE ASKED, which is the property that makes it a
// specification rather than a wish: if a capability were added to the probe and not to the
// obligation, a build could be declared discharged while one of the five questions was never put to
// it. Asserted as an identity join over the required list, not a count.
test fn the_build_obligation_requires_every_capability_the_probe_asks() -> Bool {
  length(v41_sm121_build_obligation.required) == length(v41_required_capabilities)
    && all(v41_required_capabilities, c =>
         any(v41_sm121_build_obligation.required, r =>
           runtime_kernel_capability_label(c: r) == runtime_kernel_capability_label(c: c)))
    && all(v41_sm121_build_obligation.required, r =>
         match v41_capability_probe_symbol(c: r) {
           ProbeSymbolGrounded { symbol: sym } => length(sym as String) != 0
           ProbeSymbolAwaitingRoster { roster: ro, trigger: _ } => length(ro as String) != 0
         })
}

// EVERY IMAGE THE ROSTER CALLS PROBED HAS A READING WITH A HOST AND A DATE ON IT. This is the join
// that keeps "probed" from being a label: a candidate could be marked CandidateProbed while no
// receipt of that digest existed anywhere, and the sweep's denominator would then count an image
// nobody read. Asserted against the reading roster by image reference, not by counting either side.
test fn every_candidate_marked_probed_has_a_registry_reading() -> Bool {
  all(v41_sm121_runtime_candidates, c =>
    match c.disposition {
      CandidateNotProbed { reason: _ } => true
      CandidateProbed { image_reference: ref } =>
        match registry_reading_for(readings: spark_architecture_registry_readings, image_reference: ref) {
          Absent => false
          Present { value: r } =>
            length(r.host as String) != 0 && length(r.observed_at as String) != 0 && length(r.instrument as String) != 0
        }
    })
}
