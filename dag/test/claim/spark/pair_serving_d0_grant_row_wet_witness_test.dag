module test.claim.spark.pair_serving_d0_grant_row_wet_witness

import std.types { Bool }
import gunbc.spark.pair_serving_d0_door { captured_grant_row_blob, GrantRowBlobRead, GrantRowBlobUnread }

// THE REAL PRODUCER OF THE GRANT ROW'S BLOB ID, EXECUTED. The captured bytes go to `git hash-object
// --no-filters --stdin` as given, so the id is git's own blob id of exactly those bytes, trailing newline
// included. The oracle is external and independent: git's published id for the blob "hello\n". This runs
// on the required floor's local-repo wet lane (v2.workflow.local_repo_wet_terminal
// local_repo_wet_schedule), because git.Plumbing HashObjectStdinNoWrite has no mock_response and an
// input-blind one would fabricate the very fact this claim establishes. The hermetic control beside it
// is test.claim.spark.pair_serving_d0_release_witness rw_admission_follows_the_captured_row_not_the_path.
test fn the_captured_row_is_hashed_as_its_exact_bytes_by_real_execution() -> Bool {
  match captured_grant_row_blob(content: "hello\n") {
    GrantRowBlobRead { blob: b } => b == "ce013625030ba8dba906f756967f9e9ca394464a"
    GrantRowBlobUnread { cause: _ } => false
  }
}
