module test.claim.spark.deliberate_unit_start_witness_test

import std.types { Bool, String, List, NonEmptyStr }
import v2.std.optional { Present, Absent }
import gunbc.spark.host_effect_quiescence { ArgvRun, ArgvRan, ArgvLegDidNotRun }
import gunbc.spark.deliberate_unit_start { deliberate_unit_start_leg, deliberate_unit_start_script }
import gunbc.spark.host_occupancy_admission { restore_spark_serving_units }
import gunbc.spark.native_serving_apply { spark_native_host_apply_script, spark_native_rollback_script, spark_native_preserve_script, spark_native_commit_script }
import gunbc.spark.serving_arm_launch { glm_native_container_name }

// ── A DELIBERATE START IS ONE OPERATION, AT EVERY SITE (side-chat ruling on #13319, finding 4) ───
//
// THE INCIDENT SHAPE: a bounded unit (StartLimitBurst=1 / 600 s) the previous staircase step just started
// is stopped by the next launch; that launch refuses before actuation, and the incumbent restore must
// start the unit again inside the window. The outer restore (restore_spark_serving_units) used a plain
// SystemctlStart, so it would be refused exactly as the transaction's own rollback was (run 37241423753).
//
// THE SUPPLIED HOST stands in for systemd at the leg interface: each argv is answered as systemctl would.
// A pure claim cannot hold the start-limit counter across calls, so the discriminating RED is the other
// half: a host on which `reset-failed` FAILS makes the restore refuse, which can only happen if the
// restore issues the clear -- a plain start never asks for it and would pass.

data w_unit: NonEmptyStr = "gunbc-glm53-stair-rank.service" as NonEmptyStr

fn w_host(load_state: String, reset_ok: Bool) -> fn(List<String>) -> ArgvRun {
  fn(argv) {
    let line = join(argv, " ")
    if line == "systemctl show gunbc-glm53-stair-rank.service --property=LoadState --value" { ArgvRan { exit_code: 0, stdout: join([load_state, "\n"], ""), stderr: "" } }
    else if line == "systemctl reset-failed gunbc-glm53-stair-rank.service" {
      if reset_ok { ArgvRan { exit_code: 0, stdout: "", stderr: "" } } else { ArgvRan { exit_code: 1, stdout: "", stderr: "Failed to reset failed state of unit" } }
    }
    else if line == "systemctl restart gunbc-glm53-stair-rank.service" { ArgvRan { exit_code: 0, stdout: "", stderr: "" } }
    else if line == "systemctl is-active gunbc-glm53-stair-rank.service" { ArgvRan { exit_code: 0, stdout: "active\n", stderr: "" } }
    else { ArgvLegDidNotRun { cause: join(["the witness host does not answer `", line, "`"], "") } }
  }
}

// THE CONTROL THE RULING ASKS FOR, at the incumbent restore's own interface: a just-started, now-stopped
// bounded unit reads loaded; the restore clears its counter and starts it, and reads it back active.
test fn w_the_incumbent_restore_is_a_deliberate_start() -> Bool {
  match restore_spark_serving_units(run: w_host(load_state: "loaded", reset_ok: true), units: [w_unit]) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE RED: the same restore on a host whose `reset-failed` fails refuses, naming the counter. A restore
// that started with a plain `systemctl start` would never ask and would pass.
test fn w_the_incumbent_restore_refuses_when_the_counter_cannot_be_cleared() -> Bool {
  match restore_spark_serving_units(run: w_host(load_state: "loaded", reset_ok: false), units: [w_unit]) {
    Absent => false
    Present { value: why } => string_contains(s: why, pattern: "start-limit counter could not be cleared")
  }
}

// AN UNLOADED UNIT CARRIES NO COUNTER, so the clear is not issued at all (it would be an error, run
// 37254736596): the same failing reset host starts a not-loaded unit cleanly.
test fn w_an_unloaded_unit_is_started_without_a_clear() -> Bool {
  match deliberate_unit_start_leg(run: w_host(load_state: "not-found", reset_ok: false), unit: w_unit) {
    Absent => true
    Present { value: _ } => false
  }
}

// ONE AUTHORITY: the transaction's apply and its rollback restore render exactly this operation's
// fragment, and no script that does not start the unit clears the counter.
test fn w_every_deliberate_start_renders_the_one_operation() -> Bool {
  let apply = spark_native_host_apply_script(unit_name: w_unit, log_path: "/var/log/gunbc/x.log" as NonEmptyStr, unit_text: "[Unit]\n", container_name: glm_native_container_name)
  let rollback = spark_native_rollback_script(unit_name: w_unit, transaction_id: "T", container_name: glm_native_container_name)
  string_contains(s: apply, pattern: deliberate_unit_start_script(unit_name: w_unit, indent: ""))
    && string_contains(s: rollback, pattern: deliberate_unit_start_script(unit_name: w_unit, indent: "  "))
    && string_contains(s: deliberate_unit_start_script(unit_name: w_unit, indent: ""), pattern: "'systemctl' 'reset-failed' 'gunbc-glm53-stair-rank.service'")
    && !string_contains(s: spark_native_preserve_script(unit_name: w_unit, transaction_id: "T", container_name: glm_native_container_name), pattern: "reset-failed")
    && !string_contains(s: spark_native_commit_script(unit_name: w_unit, transaction_id: "T"), pattern: "reset-failed")
}
