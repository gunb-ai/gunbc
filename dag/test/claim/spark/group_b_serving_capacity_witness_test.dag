module test.claim.spark.group_b_serving_capacity_witness_test

import std.types { Bool }
import v2.std.optional { Present, Absent }
import gunbc.spark.group_b_serving_capacity {
  group_b_restoration_intent_admission, group_b_restoration_intent, group_b_restoration_profile,
  group_b_restoration_utilization, group_b_restoration_seats, group_b_restoration_executable, group_b_experiment_subject_seats,
  group_b_kv_inventory_tokens, group_b_restoration_window_tokens,
  group_b_scheduler_envelope, group_b_route_offer, group_b_route_offer_ceiling, RouteOfferAdmitted, RouteOfferRefused,
}
import gunbc.spark.serving_capacity_intent {
  ServingCapacityIntentAdmitted, ServingCapacityIntentRefused,
  intent_max_active_sequences, intent_max_single_sequence_tokens, intent_max_total_resident_tokens,
  profile_for_envelope, envelope_at_cold_floor,
  envelope_hard_max_num_seqs, envelope_guaranteed_cold_seats, envelope_best_effort_seats,
}
import gunbc.spark.serving_arm {
  glm53_native_launch_policy,
  Glm53NativeFp8, GunbcGlm53NopeDerivedGb10, FourSparkTp4,
  serving_launch_profile_key,
}
import gunbc.spark.arm_memory_fit {
  arm_memory_fit_subject_for_launch, arm_memory_fit_verdict,
  ArmMemoryFitProved, ArmMemoryFitRefused, ArmMemoryFitUnestablished,
  ArmMemorySubjectReady, ArmMemorySubjectRefused,
}
import std.measure { token_count_value, basis_point_count }
import extdeps.vllm.engine_args { vllm_kv_cache_dtype_wire }
import v2.std.algebra { any, length }

// ── THE DECLARED OBLIGATION AND ITS DERIVED EXECUTABLE ────────────────────────────────────────────
//
// THE VERTICAL'S CAPACITY INTENT: what group B is restored TO. The basis rides in the module's
// comment; the witnesses below pin the DERIVATION -- the executable profile's shape is the
// intent's, not an authored row's -- the SEAT COUNT's authority (the engine's measured KV
// inventory, tokens over tokens, the limiting rank named, for the RESTORATION FLOOR of six) --
// the EIGHT-SEAT EXPERIMENT SUBJECT (owner directive 2026-09-28) reading the exact hybrid block
// fold (984/1035 blocks, 4.93% reserve), with the intent's linear resident total deliberately
// pinned ABOVE the linear inventory (2,097,152 > 1,805,689) so the override's different basis
// is explicit and never a silent derivation change -- and the VERDICT PATH: the declared
// intent's subject is UNESTABLISHED until the open terms land, with the 262K prefill workspace
// named among the obligations.

test fn w_the_restoration_intent_derives_from_the_engine_kv_inventory() -> Bool  {
  match group_b_restoration_intent_admission {
    ServingCapacityIntentRefused { cause: _ } => false
    ServingCapacityIntentAdmitted { intent: i } =>
      group_b_kv_inventory_tokens == 1805689
        && group_b_restoration_window_tokens == 262144
        && group_b_restoration_seats == 6
        && group_b_restoration_seats == group_b_kv_inventory_tokens / group_b_restoration_window_tokens
        && intent_max_active_sequences(i: i) == 8
        && intent_max_active_sequences(i: i) == group_b_experiment_subject_seats
        && token_count_value(t: intent_max_single_sequence_tokens(i: i)) == 262144
        && token_count_value(t: intent_max_total_resident_tokens(i: i)) == 2097152
        && token_count_value(t: intent_max_total_resident_tokens(i: i)) > group_b_kv_inventory_tokens
  }
}

// THE SIX-SEAT DERIVATION, PINNED ARITHMETIC: floor(1,805,689 / 262,144) = 6 with
// 1,805,689 = 6 x 262,144 + 232,825, and the basis named -- the inventory was derived by the
// engine FROM THE LIMITING RANK (TP3/srv11, the smallest residual arena), so six is the count
// the worst rank admits.
test fn w_the_six_seat_derivation_is_pinned_to_the_limiting_rank() -> Bool  {
  group_b_kv_inventory_tokens / 262144 == 6
    && group_b_kv_inventory_tokens == 6 * 262144 + 232825
    && group_b_restoration_seats == 6
}

// THE NO-LINEAR-EXTRAPOLATION LAW AS A RED CONTROL. Deriving seats by scaling the inventory from
// TP0/srv9's larger residual arena (24.08 GiB) instead of the limiting rank's (TP3/srv11, 17.03
// GiB) is the forbidden linear route, and its number is pinned: floor(1,805,689 x 2408 / 1703 /
// 262,144) = 9, not 6 -- three fabricated seats. The declared count must never equal it; the row
// goes RED the moment arena bytes become a seat-count input.
test fn w_the_seat_count_refuses_the_residual_arena_route() -> Bool  {
  let seats_via_tp0_arena_linear = (group_b_kv_inventory_tokens * 2408 / 1703) / group_b_restoration_window_tokens
  seats_via_tp0_arena_linear == 9
    && seats_via_tp0_arena_linear != group_b_restoration_seats
    && group_b_restoration_seats == 6
}

test fn w_the_executable_profile_is_the_intents_exact_derivation() -> Bool  {
  match group_b_restoration_intent() {
    Absent => false
    Present { value: intent } =>
      match group_b_restoration_executable() {
        Absent => false
        Present { value: executable } =>
          let profile = executable.profile
          token_count_value(t: profile.max_model_len) == 262144
            && profile.max_num_seqs == 8
            && profile.max_num_seqs == group_b_experiment_subject_seats
            && token_count_value(t: profile.max_num_batched_tokens) == 2048
            && basis_point_count(bp: profile.decided_gpu_memory_basis_points) == 8567
            && (vllm_kv_cache_dtype_wire(request: profile.kv_cache_dtype) as String) == "fp8"
            && (profile.served_alias as String) == "glm-5.3-flash"
            && (serving_launch_profile_key(p: profile) == serving_launch_profile_key(p: profile_for_envelope(
              envelope: envelope_at_cold_floor(cold: intent),
              policy: glm53_native_launch_policy,
              decided_gpu_memory_basis_points: group_b_restoration_utilization,
              serve_port: profile.serve_port,
              served_alias: profile.served_alias,
              prefix_caching: profile.prefix_caching)))
      }
  }
}

// THE RETIRED SHAPE IS GONE: the derived executable is NOT the crash-looping configuration. A
// consumer naming the retired constant fails to compile -- this row is the runtime half of that
// control, pinning that the restoration's engine config differs from the retired row's in the
// fields that mattered (seat count sixteen -> six, utilization 8400 -> 8567) while the window
// coincides BY DESIGN: 262144 is what the derived count buys at the advised envelope, not the
// retired over-provision.
test fn w_the_derived_profile_is_not_the_retired_crash_looping_shape() -> Bool  {
  match group_b_restoration_executable() {
    Absent => false
    Present { value: executable } =>
      let profile = executable.profile
      token_count_value(t: profile.max_model_len) == 262144
        && profile.max_num_seqs == 8
        && profile.max_num_seqs == group_b_experiment_subject_seats
        && !(profile.max_num_seqs == 16)
        && basis_point_count(bp: profile.decided_gpu_memory_basis_points) == 8567
        && !(basis_point_count(bp: profile.decided_gpu_memory_basis_points) == 8400)
  }
}

// ── THE VERDICT PATH: UNESTABLISHED UNTIL THE REAL RECEIPTS LAND ─────────────────────────────────
test fn w_the_declared_intents_subject_is_unestablished_until_real_receipts_land() -> Bool  {
  match group_b_restoration_executable() {
    Absent => false
    Present { value: executable } =>
      match arm_memory_fit_subject_for_launch(
        runtime: GunbcGlm53NopeDerivedGb10,
        topology: FourSparkTp4,
        profile: executable.profile,
      ) {
        ArmMemorySubjectRefused { cause: _ } => false
        ArmMemorySubjectReady { subject: subject } =>
          match arm_memory_fit_verdict(subject: subject) {
            ArmMemoryFitUnestablished { obligations: os } =>
              length(os) > 0
                && any(os, o => string_contains(s: o as String, pattern: "kv-cache has no defensible bound"))
                && any(os, o => string_contains(s: o as String, pattern: "activation-workspace has no defensible bound"))
                && any(os, o => string_contains(s: o as String, pattern: "per-rank checkpoint placement is unread"))
                && any(os, o => string_contains(s: o as String, pattern: "host-os-control-reserve"))
            _ => false
          }
      }
  }
}


// ── THE THREE COUNTS AT 8/8/8 (operator ruling 2026-10-02: behaviour-preserving at the floor) ────
//
// Cold guarantee, scheduler ceiling and route offer are three facts; today all three read eight, and
// the executable renders no scheduler flag, so the launch is the one group B ran before the split.
test fn w_group_b_holds_the_cold_floor_with_no_best_effort_seats() -> Bool  {
  match group_b_scheduler_envelope() {
    Absent => false
    Present { value: e } =>
      envelope_guaranteed_cold_seats(e: e) == 8
        && envelope_hard_max_num_seqs(e: e) == 8
        && envelope_best_effort_seats(e: e) == 0
        && (match group_b_restoration_profile() {
              Absent => false
              Present { value: p } => p.max_num_seqs == 8 && p.guaranteed_cold_seqs == 8
            })
        && (match group_b_route_offer() { RouteOfferAdmitted { seats: n } => n == 8  RouteOfferRefused { cause: _ } => false })
  }
}

// THE OFFER IS BOUNDED BY THE ENGINE'S CEILING, read off the two rows rather than assumed from their
// agreement: a later edit that raised the offer past the ceiling must turn the accessor Absent.
test fn w_the_route_offer_never_exceeds_the_scheduler_ceiling() -> Bool  {
  match group_b_scheduler_envelope() {
    Absent => false
    Present { value: e } =>
      group_b_route_offer_ceiling <= envelope_hard_max_num_seqs(e: e)
        && (match group_b_route_offer() { RouteOfferAdmitted { seats: n } => n <= envelope_hard_max_num_seqs(e: e)  RouteOfferRefused { cause: _ } => false })
  }
}
