module test.claim.spark.group_b_serving_capacity_witness_test

import std.types { Bool }
import v2.std.optional { Present, Absent }
import gunbc.harness.harness_seat { harness_interactive_quality_seats }
import gunbc.spark.group_b_serving_capacity {
  group_b_restoration_intent_admission, group_b_restoration_intent, group_b_restoration_profile,
  group_b_restoration_utilization, group_b_restoration_seats, group_b_restoration_executable,
}
import gunbc.spark.serving_capacity_intent {
  ServingCapacityIntentAdmitted, ServingCapacityIntentRefused,
  intent_max_active_sequences, intent_max_single_sequence_tokens, intent_max_total_resident_tokens,
  profile_for_intent,
}
import gunbc.spark.serving_arm {
  Glm53NativeFp8, GunbcGlm53NopeDerivedGb10, FourSparkTp4,
  serving_launch_profile_key,
}
import gunbc.spark.arm_memory_fit {
  arm_memory_fit_subject_for_launch, arm_memory_fit_verdict,
  ArmMemoryFitProved, ArmMemoryFitRefused, ArmMemoryFitUnestablished,
  ArmMemorySubjectReady, ArmMemorySubjectRefused,
}
import std.measure { token_count_value, basis_point_count }

// ── THE DECLARED OBLIGATION AND ITS DERIVED EXECUTABLE ────────────────────────────────────────────
//
// THE VERTICAL'S CAPACITY INTENT: what group B is restored TO. The basis rides in the module's
// comment; the witness pins the DERIVATION -- the executable profile's shape is the intent's, not
// an authored row's -- and the VERDICT PATH: the declared intent's subject is UNESTABLISHED until
// the experiment's real receipts land. NO fixture ceiling stands in for production evidence here;
// the FitProved discriminator on the fit witness stays a fixture, and this row is the reason it
// cannot be quoted as the arm's.
test fn w_the_restoration_intent_derives_from_the_harness_seat_count() -> Bool {
  match group_b_restoration_intent_admission {
    ServingCapacityIntentRefused { cause: _ } => false
    ServingCapacityIntentAdmitted { intent: i } =>
      group_b_restoration_seats == harness_interactive_quality_seats
        && intent_max_active_sequences(i: i) == harness_interactive_quality_seats
        && token_count_value(t: intent_max_single_sequence_tokens(i: i)) == 65536
        && token_count_value(t: intent_max_total_resident_tokens(i: i)) == harness_interactive_quality_seats * 65536
  }
}

test fn w_the_executable_profile_is_the_intents_exact_derivation() -> Bool {
  match group_b_restoration_intent() {
    Absent => false
    Present { value: intent } =>
      match group_b_restoration_executable() {
        Absent => false
        Present { value: executable } =>
          let profile = executable.profile
          token_count_value(t: profile.max_model_len) == 65536
            && profile.max_num_seqs == harness_interactive_quality_seats
            && token_count_value(t: profile.max_num_batched_tokens) == 2048
            && basis_point_count(bp: profile.decided_gpu_memory_basis_points) == 8567
            && (profile.kv_cache_dtype_wire as String) == "fp8"
            && (profile.served_alias as String) == "glm-5.3-flash"
            && (serving_launch_profile_key(p: profile) == serving_launch_profile_key(p: profile_for_intent(
              intent: intent,
              decided_gpu_memory_basis_points: group_b_restoration_utilization,
              kv_cache_dtype_wire: profile.kv_cache_dtype_wire,
              serve_port: profile.serve_port,
              served_alias: profile.served_alias,
              prefix_caching: profile.prefix_caching)))
      }
  }
}

// THE RETIRED SHAPE IS GONE: the derived executable is NOT the crash-looping configuration. A
// consumer naming the retired constant fails to compile -- this row is the runtime half of that
// control, pinning that the restoration's engine config differs from the retired row's in the
// fields that mattered (window and seat count), while the module graph makes the retired spelling
// itself unwritable.
test fn w_the_derived_profile_is_not_the_retired_crash_looping_shape() -> Bool {
  match group_b_restoration_executable() {
    Absent => false
    Present { value: executable } =>
      let profile = executable.profile
      token_count_value(t: profile.max_model_len) == 65536
        && !(profile.max_num_seqs == 16)
  }
}

// ── THE VERDICT PATH: UNESTABLISHED UNTIL THE REAL RECEIPTS LAND ─────────────────────────────────
test fn w_the_declared_intents_subject_is_unestablished_until_real_receipts_land() -> Bool {
  match group_b_restoration_executable() {
    Absent => false
    Present { value: executable } =>
      match arm_memory_fit_subject_for_launch(
        checkpoint: Glm53NativeFp8,
        runtime: GunbcGlm53NopeDerivedGb10,
        topology: FourSparkTp4,
        profile: executable.profile,
      ) {
        ArmMemorySubjectRefused { cause: _ } => false
        ArmMemorySubjectReady { subject: subject } =>
          match arm_memory_fit_verdict(subject: subject) {
            ArmMemoryFitUnestablished { obligations: os } =>
              length(os) > 0
                && any(os, o => string_contains(s: o as String, pattern: "kv-cache has no defensible bound"))
                && any(os, o => string_contains(s: o as String, pattern: "per-rank checkpoint placement is unread"))
                && any(os, o => string_contains(s: o as String, pattern: "host-os-control-reserve"))
            _ => false
          }
      }
  }
}

test fn w_all_group_b_serving_capacity_claims_hold() -> Bool {
  w_the_restoration_intent_derives_from_the_harness_seat_count()
    && w_the_executable_profile_is_the_intents_exact_derivation()
    && w_the_derived_profile_is_not_the_retired_crash_looping_shape()
    && w_the_declared_intents_subject_is_unestablished_until_real_receipts_land()
}
