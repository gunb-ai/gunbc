// THE INCIDENT THESE ARE THE REDS FOR: fleet-converge run 36918167575 (2026-10-01). One ssh leg to srv7
// timed out over Wi-Fi, the four-host arm aborted, the rollback leg to srv7 timed out too, and the next
// run refused on srv7's leftover had-no-unit marker and fence until a human removed them. Every input
// below is SUPPLIED at the interface it discriminates (DESIGN section 3: a witness discriminates at one
// interface); the leg's session result, the attempt sequence, and the observation's stdout are the
// boundaries, and none of them needs a host.


// The rollback's script text: its prepare and finish legs, around the typed deliberate start.
fn w_rollback_text(unit_name: NonEmptyStr, transaction_id: String, container_name: NonEmptyStr) -> String {
  join([spark_native_rollback_prepare_script(unit_name: unit_name, transaction_id: transaction_id, container_name: container_name),
        spark_native_rollback_finish_script(unit_name: unit_name, transaction_id: transaction_id)], "\n")
}

fn unreached() -> SparkPairHostApplyOutcome {
  SparkPairHostUnreached { host: operator_host_srv9, cause: "management-lan ssh exit=255 stderr=ssh: connect to host 192.168.1.232 port 22: Connection timed out" }
}

fn applied(word: String) -> SparkPairHostApplyOutcome {
  SparkPairHostApplied { host: operator_host_srv9, wire: "management-lan", stdout: word, standing: serving_standing(attempts: []) }
}

fn ran_and_refused() -> SparkPairHostApplyOutcome {
  SparkPairHostApplyFailed { host: operator_host_srv9, cause: "management-lan script-exit=1 stdout=PREFLIGHT-REFUSED-image-absent" }
}

fn reached_on_attempt(n: Int) -> fn(Int) -> SparkPairHostApplyOutcome {
  fn(i) { if i < n { unreached() } else { applied(word: "preflight-ok") } }
}

// ── THE LEG READING: IN-BAND STATUS DECIDES, NOT ssh's 255 ALONE ──────────────────────────────

test fn w_a_connect_timeout_with_no_began_line_reads_unreached() -> Bool {
  spark_pair_host_unreached(o: spark_pair_leg_outcome_of(host: operator_host_srv9, wire: "management-lan", r: SshSessionExecResult {
    exit_code: 255, success: false, stdout: "",
    stderr: "ssh: connect to host 192.168.1.232 port 22: Connection timed out",
  }))
}

// THE RED: a script that began and whose reply was lost ALSO exits 255 at the client. It ran, so it is
// Failed and never retry-eligible.
test fn w_a_255_after_the_script_began_is_failed_not_unreached() -> Bool {
  let o = spark_pair_leg_outcome_of(host: operator_host_srv9, wire: "management-lan", r: SshSessionExecResult {
    exit_code: 255, success: false, stdout: join([remote_leg_began_word, "\nrestarted\n"], ""),
    stderr: "Connection to 192.168.1.232 closed by remote host.",
  })
  !spark_pair_host_unreached(o: o) && !spark_pair_host_applied(o: o)
}

test fn w_a_script_that_ran_and_refused_is_failed_and_its_own_exit_is_read() -> Bool {
  let o = spark_pair_leg_outcome_of(host: operator_host_srv9, wire: "management-lan", r: SshSessionExecResult {
    exit_code: 1, success: false,
    stdout: join([remote_leg_began_word, "\nPREFLIGHT-REFUSED-image-absent\n", spark_pair_leg_exit_prefix, "1\n"], ""),
    stderr: "",
  })
  match o {
    SparkPairHostApplyFailed { host: _, cause: c } => string_contains(s: c, pattern: "script-exit=1") && string_contains(s: c, pattern: "PREFLIGHT-REFUSED-image-absent")
    SparkPairHostApplied { host: _, wire: _, stdout: _, standing: _ } => false
    SparkPairHostUnreached { host: _, cause: _ } => false
  }
}

test fn w_an_applied_leg_detail_omits_the_wrapper_lines() -> Bool {
  match spark_pair_leg_outcome_of(host: operator_host_srv9, wire: "management-lan", r: SshSessionExecResult {
    exit_code: 0, success: true,
    stdout: join([remote_leg_began_word, "\npreflight-ok\n", spark_pair_leg_exit_prefix, "0\n"], ""),
    stderr: "",
  }) {
    SparkPairHostApplied { host: _, wire: w, stdout: out, standing: _ } =>
      out == "preflight-ok" && w == "management-lan"
    SparkPairHostApplyFailed { host: _, cause: _ } => false
    SparkPairHostUnreached { host: _, cause: _ } => false
  }
}

// THE PAYLOAD THE REAL LEG SENDS carries both in-band lines around the script, so the reading above has
// something to read on the production route; the script runs in a subshell so its own `exit` reaches
// the exit line.
test fn w_the_privileged_payload_reports_began_and_exit_around_the_script() -> Bool {
  let p = spark_pair_leg_payload(script: "set -e\necho preflight-ok\n")
  string_contains(s: p, pattern: join(["echo ", remote_leg_began_word, "\n(\nset -e\necho preflight-ok\n"], ""))
    && string_contains(s: p, pattern: join(["echo ", spark_pair_leg_exit_prefix, "$gunbc_leg_rc"], ""))
    && string_contains(s: p, pattern: "exit $gunbc_leg_rc")
}

// ── THE BOUNDED RETRY ─────────────────────────────────────────────────────────────────────────

test fn w_an_unreached_then_reached_leg_succeeds_on_attempt_two() -> Bool {
  let r = spark_native_leg_with_retry(budget: spark_native_unreached_leg_attempt_budget, attempt: reached_on_attempt(n: 2))
  spark_pair_host_applied(o: r.outcome) && spark_native_leg_attempt_count(r: r) == 2 && count(r.earlier_unreached) == 1
}

// THE RED FOR THE BUDGET ITSELF: with a budget of one, the same sequence stays Unreached.
test fn w_a_budget_of_one_does_not_retry() -> Bool {
  let r = spark_native_leg_with_retry(budget: 1, attempt: reached_on_attempt(n: 2))
  spark_pair_host_unreached(o: r.outcome) && spark_native_leg_attempt_count(r: r) == 1
}

test fn w_a_leg_that_ran_and_failed_is_not_retried() -> Bool {
  let r = spark_native_leg_with_retry(budget: spark_native_unreached_leg_attempt_budget, attempt: fn(i) { if i == 1 { ran_and_refused() } else { applied(word: "preflight-ok") } })
  !spark_pair_host_applied(o: r.outcome) && !spark_pair_host_unreached(o: r.outcome) && spark_native_leg_attempt_count(r: r) == 1
}

test fn w_an_always_unreached_leg_stops_at_the_budget_and_reports_every_attempt() -> Bool {
  let r = spark_native_leg_with_retry(budget: spark_native_unreached_leg_attempt_budget, attempt: fn(i) { unreached() })
  spark_pair_host_unreached(o: r.outcome) && spark_native_leg_attempt_count(r: r) == 3 && count(r.earlier_unreached) == 2
}

// ── RE-EXECUTION IS A NO-OP WHERE THE DESIRED STATE HOLDS ─────────────────────────────────────

test fn w_preserve_commit_and_rollback_read_before_they_write() -> Bool {
  let unit = "gunbc-v41-tp4-rank.service" as NonEmptyStr
  let preserve = spark_native_preserve_script(unit_name: unit, transaction_id: "T", container_name: glm_native_container_name)
  let commit = spark_native_commit_script(unit_name: unit, transaction_id: "T")
  let rollback = w_rollback_text(unit_name: unit, transaction_id: "T", container_name: glm_native_container_name)
  string_contains(s: preserve, pattern: "preserve-noop-already-preserved-by-this-transaction")
    && string_contains(s: commit, pattern: "commit-noop-no-transaction-artifact-remains")
    && string_contains(s: rollback, pattern: "rollback-actuation-accepted-incumbent-unit-restored-and-exec-started-already")
    && string_contains(s: rollback, pattern: "rollback-actuation-accepted-unit-removed-and-container-gone-already")
    && string_contains(s: rollback, pattern: "'T'")
}

// ── LEFTOVERS: RESOLVED WHEN CONSISTENT WITH THE HOST, REFUSED WHEN CONTRADICTED ──────────────

fn observed(fence: String, age: String, backup: String, marker: String, unresolved: String, unit: String, same: String, ctr: String) -> String {
  observed_with(fence: fence, age: age, backup: backup, marker: marker, unresolved: unresolved, unit: unit, same: same, ctr: ctr, planned: "not-same", running: "no")
}

fn observed_with(fence: String, age: String, backup: String, marker: String, unresolved: String, unit: String, same: String, ctr: String, planned: String, running: String) -> String {
  join([
    "unit_vs_planned=", planned, "\n",
    "container_running=", running, "\n",
    "management-lan fence=", fence, "\n",
    if fence == "present" { join(["fence_holder=2026-10-01T03:12:44Z/0f0e0d0c-0b0a-0908-0706-050403020100\nfence_age_seconds=", age, "\n"], "") } else { "" },
    "incumbent_backup=", backup, "\n",
    "had_no_unit=", marker, "\n",
    "unresolved_rollback=", unresolved, "\n",
    if unresolved == "present" { "unresolved_holder=2026-10-04T08:59:18Z/ccb8bf05\n" } else { "" },
    "unit_file=", unit, "\n",
    "unit_vs_backup=", same, "\n",
    "container=", ctr, "\n",
  ], "")
}

fn decide(stdout: String) -> SparkNativeLeftoverDecision {
  spark_native_leftover_decision_of_leg(o: applied(word: stdout))
}

fn resolution_is(d: SparkNativeLeftoverDecision, want: SparkNativeLeftoverResolution) -> Bool {
  match d {
    LeftoversResolvable { host: _, resolution: r, holder: _ } =>
      match r {
        ResolveHadNoUnitAndNothingStands => match want { ResolveHadNoUnitAndNothingStands => true  ResolveIncumbentUnitUntouched => false  ResolveFenceOnly => false }
        ResolveIncumbentUnitUntouched => match want { ResolveHadNoUnitAndNothingStands => false  ResolveIncumbentUnitUntouched => true  ResolveFenceOnly => false }
        ResolveFenceOnly => match want { ResolveHadNoUnitAndNothingStands => false  ResolveIncumbentUnitUntouched => false  ResolveFenceOnly => true }
      }
    LeftoversNone { host: _ } => false
    LeftoversAdoptable { host: _, holder: _, running: _ } => false
    LeftoversRecoverable { host: _, holder: _ } => false
    LeftoversRefused { host: _, cause: _ } => false
  }
}

fn refused_with(d: SparkNativeLeftoverDecision, word: String) -> Bool {
  match d {
    LeftoversRefused { host: _, cause: c } => string_contains(s: c, pattern: word)
    LeftoversNone { host: _ } => false
    LeftoversResolvable { host: _, resolution: _, holder: _ } => false
    LeftoversAdoptable { host: _, holder: _, running: _ } => false
    LeftoversRecoverable { host: _, holder: _ } => false
  }
}

// THE SRV7 STATE: had-no-unit marker and fence, no unit file, no container, fence a day old.
test fn w_consistent_had_no_unit_leftovers_resolve() -> Bool {
  resolution_is(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "absent", marker: "present", unresolved: "absent", unit: "absent", same: "not-same", ctr: "absent")),
    want: ResolveHadNoUnitAndNothingStands)
}

test fn w_a_had_no_unit_marker_beside_a_unit_file_refuses() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "absent", marker: "present", unresolved: "absent", unit: "present", same: "not-same", ctr: "absent")),
    word: "LEFTOVER-CONTRADICTION")
}

test fn w_a_had_no_unit_marker_beside_a_running_container_refuses() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "absent", marker: "present", unresolved: "absent", unit: "absent", same: "not-same", ctr: "present")),
    word: "LEFTOVER-CONTRADICTION")
}

test fn w_an_unread_container_is_not_absent() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "absent", marker: "present", unresolved: "absent", unit: "absent", same: "not-same", ctr: "unread")),
    word: "LEFTOVER-UNREAD")
}

test fn w_both_markers_refuse() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "present", marker: "present", unresolved: "absent", unit: "absent", same: "not-same", ctr: "absent")),
    word: "LEFTOVER-CONTRADICTION")
}

test fn w_an_untouched_incumbent_resolves_and_a_replaced_one_refuses() -> Bool {
  resolution_is(
    d: decide(stdout: observed(fence: "present", age: "86400", backup: "present", marker: "absent", unresolved: "absent", unit: "present", same: "same", ctr: "present")),
    want: ResolveIncumbentUnitUntouched)
    && refused_with(
      d: decide(stdout: observed(fence: "present", age: "86400", backup: "present", marker: "absent", unresolved: "absent", unit: "present", same: "not-same", ctr: "present")),
      word: "LEFTOVER-CONTRADICTION")
}

// A FENCE INSIDE THE HORIZON MAY BE A LIVE TRANSACTION: the same consistent srv7 state, ten minutes old.
test fn w_a_young_fence_refuses_as_possibly_live() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "present", age: "600", backup: "absent", marker: "present", unresolved: "absent", unit: "absent", same: "not-same", ctr: "absent")),
    word: "LEFTOVER-POSSIBLY-LIVE")
}

test fn w_the_unresolved_rollback_marker_still_refuses() -> Bool {
  refused_with(
    d: decide(stdout: observed(fence: "absent", age: "", backup: "absent", marker: "absent", unresolved: "present", unit: "present", same: "not-same", ctr: "present")),
    word: "LEFTOVER-UNRESOLVED-ROLLBACK")
}

test fn w_a_missing_field_is_unread_not_absent() -> Bool {
  refused_with(d: decide(stdout: "management-lan fence=absent\nincumbent_backup=absent\n"), word: "LEFTOVER-UNREAD")
}

test fn w_an_unreached_observation_refuses() -> Bool {
  refused_with(d: spark_native_leftover_decision_of_leg(o: unreached()), word: "LEFTOVER-UNREAD")
}

test fn w_a_clean_host_has_no_leftovers() -> Bool {
  match decide(stdout: observed(fence: "absent", age: "", backup: "absent", marker: "absent", unresolved: "absent", unit: "present", same: "not-same", ctr: "present")) {
    LeftoversNone { host: _ } => true
    LeftoversResolvable { host: _, resolution: _, holder: _ } => false
    LeftoversAdoptable { host: _, holder: _, running: _ } => false
    LeftoversRecoverable { host: _, holder: _ } => false
    LeftoversRefused { host: _, cause: _ } => false
  }
}

// THE RESOLUTION RE-READS ITS PREMISES AND REMOVES EXACTLY ITS KIND'S FILES, compare-and-set on the
// observed fence holder; the observation leg removes nothing.
test fn w_the_had_no_unit_resolution_rechecks_and_removes_only_marker_and_fence() -> Bool {
  let unit = "gunbc-v41-tp4-rank.service" as NonEmptyStr
  let script = spark_native_leftover_resolve_script(unit_name: unit, container_name: glm_native_container_name, resolution: ResolveHadNoUnitAndNothingStands, holder: "H-1")
  let observe = spark_native_leftover_observe_script(unit_name: unit, container_name: glm_native_container_name, planned_unit_text: "[Unit]\n")
  string_contains(s: script, pattern: "rm -f /etc/systemd/system/gunbc-v41-tp4-rank.service.gunbc-had-no-unit /etc/systemd/system/gunbc-v41-tp4-rank.service.gunbc-transaction\n")
    && string_contains(s: script, pattern: "LEFTOVER-RESOLVE-REFUSED-fence-changed-since-observation")
    && string_contains(s: script, pattern: "'H-1'")
    && string_contains(s: script, pattern: "LEFTOVER-RESOLVE-REFUSED-container-present")
    && string_contains(s: script, pattern: "LEFTOVER-RESOLVE-REFUSED-unresolved-rollback-present")
    && !string_contains(s: script, pattern: "systemctl")
    && !string_contains(s: observe, pattern: "rm ")
    && !string_contains(s: observe, pattern: "systemctl")
}

// ── THE LAUNCH IS RE-ENTRANT: A TRANSACTION KILLED BETWEEN APPLY AND VERDICT IS ADOPTED ────────
//
// THE INCIDENT: nvfp4-8 launch run 37190290418, killed by the step timeout during the front-door wait;
// every host kept the fence, the fp8-24 incumbent backup and the nvfp4 unit, and the head later exited.

// One host as the run left it: past the horizon, incumbent backup, the PLANNED unit installed.
test fn w_a_host_carrying_this_arms_planned_unit_under_an_old_fence_is_adoptable() -> Bool {
  match decide(stdout: observed_with(fence: "present", age: "86400", backup: "present", marker: "absent", unresolved: "absent", unit: "present", same: "not-same", ctr: "present", planned: "same", running: "yes")) {
    LeftoversAdoptable { host: _, holder: t, running: r } => r && t == "2026-10-01T03:12:44Z/0f0e0d0c-0b0a-0908-0706-050403020100"
    LeftoversRecoverable { host: _, holder: _ } => false
    LeftoversNone { host: _ } => false
    LeftoversResolvable { host: _, resolution: _, holder: _ } => false
    LeftoversRefused { host: _, cause: _ } => false
  }
}

// THE RED FOR THE SPEC TEST: the same leftovers with a unit that is NOT this launch's plan stay the
// contradiction they were -- adoption never reaches another spec's transaction.
test fn w_a_different_spec_under_the_same_fence_is_not_adopted() -> Bool {
  refused_with(
    d: decide(stdout: observed_with(fence: "present", age: "86400", backup: "present", marker: "absent", unresolved: "absent", unit: "present", same: "not-same", ctr: "present", planned: "not-same", running: "yes")),
    word: "LEFTOVER-CONTRADICTION")
}

// The horizon still binds an adoption: a young fence may be a live transaction.
test fn w_a_young_adoptable_fence_still_refuses_as_possibly_live() -> Bool {
  refused_with(
    d: decide(stdout: observed_with(fence: "present", age: "600", backup: "present", marker: "absent", unresolved: "absent", unit: "present", same: "not-same", ctr: "present", planned: "same", running: "yes")),
    word: "LEFTOVER-POSSIBLY-LIVE")
}

// THE DEAD-RANK ARM: every host adoptable under one holder, the head not running -> the adopted
// transaction with the dead rank named, which the body rolls back by its own path with no apply leg.
test fn w_an_adopted_transaction_with_a_dead_rank_names_it_for_rollback() -> Bool {
  match spark_native_adoption_of(decisions: [
    LeftoversAdoptable { host: operator_host_srv10, holder: "T1", running: false },
    LeftoversAdoptable { host: operator_host_srv9, holder: "T1", running: true },
    LeftoversAdoptable { host: operator_host_srv12, holder: "T1", running: true },
    LeftoversAdoptable { host: operator_host_srv11, holder: "T1", running: true },
  ]) {
    AdoptTransaction { holder: t, dead: d } => t == "T1" && count(d) == 1 && all(d, h => (h as String) == "srv10")
    AdoptNothing => false
    RecoverRolledBack { holder: _ } => false
    AdoptRefused { cause: _ } => false
  }
}

// THE LIVE ARM: every rank running -> adopted with no dead rank, so readback and verdict run, no apply.
test fn w_an_adopted_transaction_with_every_rank_running_resumes_at_readback() -> Bool {
  match spark_native_adoption_of(decisions: [
    LeftoversAdoptable { host: operator_host_srv10, holder: "T1", running: true },
    LeftoversAdoptable { host: operator_host_srv9, holder: "T1", running: true },
  ]) {
    AdoptTransaction { holder: _, dead: d } => count(d) == 0
    AdoptNothing => false
    RecoverRolledBack { holder: _ } => false
    AdoptRefused { cause: _ } => false
  }
}

// WHOLE OR NOT AT ALL: one host without the transaction, or two holders, refuses.
test fn w_a_partial_or_split_adoption_refuses() -> Bool {
  let partial = spark_native_adoption_of(decisions: [
    LeftoversAdoptable { host: operator_host_srv10, holder: "T1", running: true },
    LeftoversNone { host: operator_host_srv9 },
  ])
  let two_holders = spark_native_adoption_of(decisions: [
    LeftoversAdoptable { host: operator_host_srv10, holder: "T1", running: true },
    LeftoversAdoptable { host: operator_host_srv9, holder: "T2", running: true },
  ])
  let nothing_held = spark_native_adoption_of(decisions: [LeftoversNone { host: operator_host_srv10 }])
  (match partial { AdoptRefused { cause: c } => string_contains(s: c, pattern: "PARTIAL")  AdoptNothing => false  AdoptTransaction { holder: _, dead: _ } => false  RecoverRolledBack { holder: _ } => false })
    && (match two_holders { AdoptRefused { cause: c } => string_contains(s: c, pattern: "SPLIT")  AdoptNothing => false  AdoptTransaction { holder: _, dead: _ } => false  RecoverRolledBack { holder: _ } => false })
    && (match nothing_held { AdoptNothing => true  AdoptRefused { cause: _ } => false  AdoptTransaction { holder: _, dead: _ } => false  RecoverRolledBack { holder: _ } => false })
}

// ── A ROLLED-BACK ARM RECOVERS THROUGH THE SAME READBACK, OR ITS MARKER STAYS ─────────────────
//
// After run 37200831946's... the nvfp4-8 rollback restored the fp8-24 units and left the marker. A host
// whose RESTORED unit is this launch's planned unit (byte-identical, read on the host) with its rank
// running is recoverable; the transaction then runs only the readback, and only a clean readback clears
// the marker. The RED: the same marker with the rank not running -- or the unit not the plan -- refuses.
test fn w_a_restored_running_arm_under_its_marker_is_recoverable() -> Bool {
  match decide(stdout: observed_with(fence: "absent", age: "", backup: "absent", marker: "absent", unresolved: "present", unit: "present", same: "not-same", ctr: "present", planned: "same", running: "yes")) {
    LeftoversRecoverable { host: _, holder: t } => t == "2026-10-04T08:59:18Z/ccb8bf05"
    LeftoversAdoptable { host: _, holder: _, running: _ } => false
    LeftoversNone { host: _ } => false
    LeftoversResolvable { host: _, resolution: _, holder: _ } => false
    LeftoversRefused { host: _, cause: _ } => false
  }
}

test fn w_a_marker_over_a_dead_or_unplanned_rank_still_refuses() -> Bool {
  refused_with(
    d: decide(stdout: observed_with(fence: "absent", age: "", backup: "absent", marker: "absent", unresolved: "present", unit: "present", same: "not-same", ctr: "absent", planned: "same", running: "no")),
    word: "LEFTOVER-UNRESOLVED-ROLLBACK")
    && refused_with(
      d: decide(stdout: observed_with(fence: "absent", age: "", backup: "absent", marker: "absent", unresolved: "present", unit: "present", same: "not-same", ctr: "present", planned: "not-same", running: "yes")),
      word: "LEFTOVER-UNRESOLVED-ROLLBACK")
}

test fn w_a_recovery_is_read_whole_or_refused() -> Bool {
  let whole = spark_native_adoption_of(decisions: [
    LeftoversRecoverable { host: operator_host_srv10, holder: "T1" },
    LeftoversRecoverable { host: operator_host_srv9, holder: "T1" },
  ])
  let partial = spark_native_adoption_of(decisions: [
    LeftoversRecoverable { host: operator_host_srv10, holder: "T1" },
    LeftoversNone { host: operator_host_srv9 },
  ])
  (match whole { RecoverRolledBack { holder: t } => t == "T1"  AdoptNothing => false  AdoptRefused { cause: _ } => false  AdoptTransaction { holder: _, dead: _ } => false })
    && (match partial { AdoptRefused { cause: c } => string_contains(s: c, pattern: "RECOVERY-PARTIAL")  AdoptNothing => false  RecoverRolledBack { holder: _ } => false  AdoptTransaction { holder: _, dead: _ } => false })
}

// ── THE TRANSACTION'S OWN START IS NOT REFUSED BY THE START LIMIT; NOTHING ELSE IS EXEMPTED ─────
//
// THE INCIDENT: run 37241423753 (2026-10-04). The nvfp4-8 bounded experiment failed readback, and the
// rollback restored the fp8-16 unit file under the SAME unit name and ran `systemctl restart`, which
// systemd refused on all four hosts: the bounded unit's StartLimitBurst=1 / StartLimitIntervalSec=600
// counted the apply's start, and the limit is per unit NAME, so it outlived the unit-file replacement.
// The repair clears the counter as a declared step IMMEDIATELY before each of the transaction's two
// deliberate starts (apply, restore) and nowhere else, so 'one attempt per launch' stays true: the unit
// keeps Restart=no and StartLimitBurst=1 (native_serving_realization_witness_test reads that from the
// rendered unit), and an unrelated crash -- no transaction start -- meets the limit unchanged.

// The deliberate start is one operation, claimed at its own interface and at every site by
// dag/test/claim/spark/deliberate_unit_start_witness_test.dag.

// THE CONTROL: no script that does NOT start the unit clears its start-limit state. If any of these
// did, a crash loop between transactions could be restarted past the limit by an unrelated leg.
test fn w_no_non_starting_transaction_script_clears_the_start_limit() -> Bool {
  let unit = "gunbc-glm53-group-a-rank.service" as NonEmptyStr
  let others = [
    spark_native_preserve_script(unit_name: unit, transaction_id: "T", container_name: glm_native_container_name),
    spark_native_commit_script(unit_name: unit, transaction_id: "T"),
    spark_native_transport_announcement_script(container: glm_native_container_name, ready_within: second(count: 1800)),
    spark_native_front_door_script(port_text: "8000", served_alias: "glm-5.3-flash" as NonEmptyStr, awaited: w_awaited_head, container: glm_native_container_name),
  ]
  all(others, t => !string_contains(s: t, pattern: "reset-failed"))
}

// ── THE AWAITED INCARNATION IS CAPTURED ONCE AND CARRIED (side-chat ruling on #13319 at 43cc61a0) ─────
//
// The decision itself is claimed on its executed path by awaited_incarnation_witness_test; these pin the
// two producers' halves of the seam: the transport wait CAPTURES (id by name, deadline from its own
// StartedAt) and prints both, and the front door is RENDERED FROM the carried value -- it neither resolves
// the id nor derives a deadline.
data w_awaited_head: AwaitedIncarnation = AwaitedIncarnation { host: operator_host_srv9, id: "0f3a9c1d2e4b" as NonEmptyStr, deadline_epoch: 1234567 }

test fn w_the_transport_wait_captures_the_awaited_incarnation_and_prints_it() -> Bool {
  let t = spark_native_transport_announcement_script(container: glm_native_container_name, ready_within: second(count: 3600))
  string_contains(s: t, pattern: "'Using network '")
    && string_contains(s: t, pattern: "' via NET/'")
    && string_contains(s: t, pattern: "started_at=$(docker inspect --format '\{\{.State.StartedAt}}' \"$incarnation\"")
    && string_contains(s: t, pattern: "deadline=$(( started + 3600 ))")
    && string_contains(s: t, pattern: join(["echo \"", awaited_header_word, awaited_field_separator, "$incarnation", awaited_field_separator, "$deadline\""], ""))
    && !string_contains(s: t, pattern: "start=$(date +%s)")
}

test fn w_the_front_door_is_rendered_from_the_carried_incarnation() -> Bool {
  let d = spark_native_front_door_script(port_text: "8000", served_alias: "glm-5.3-flash" as NonEmptyStr, awaited: w_awaited_head, container: glm_native_container_name)
  string_contains(s: d, pattern: "incarnation='0f3a9c1d2e4b'")
    && string_contains(s: d, pattern: "deadline=1234567")
    && !string_contains(s: d, pattern: "StartedAt")
    && !string_contains(s: d, pattern: "--format '\{\{.Id}}' ")
}

// THE READBACK BINDING, from REAL leg output through the real transport verdict: the awaited id binds, a
// replacement refuses naming both, a host with no awaited incarnation refuses.
test fn w_the_readback_refuses_an_incarnation_other_than_the_awaited_one() -> Bool {
  let leg = spark_native_leg_with_retry(budget: 0, attempt: fn(i) { spark_pair_leg_outcome_of(host: operator_host_srv9, wire: "management-lan", r: SshSessionExecResult {
    exit_code: 0, success: true,
    stdout: join([remote_leg_began_word, "\n",
      awaited_header_word, awaited_field_separator, "aaaa1111", awaited_field_separator, "5000\n",
      awaited_poll_word, awaited_field_separator, "aaaa1111 true 0", awaited_field_separator, awaited_probe_ok_word, awaited_field_separator, "aaaa1111 true 0", awaited_field_separator, "4000\n",
      spark_pair_leg_exit_prefix, "0\n"], ""),
    stderr: "" }) })
  let awaited = awaited_of(verdicts: spark_native_transport_verdicts(legs: [WaitLegReturned { leg: leg }]))
  count(awaited) == 1
    && (match awaited_binding_refusal(host: operator_host_srv9, verified_id: "aaaa1111", awaited: awaited) { Absent => true  Present { value: _ } => false })
    && (match awaited_binding_refusal(host: operator_host_srv9, verified_id: "bbbb2222", awaited: awaited) { Absent => false  Present { value: why } => string_contains(s: why, pattern: "replaced between the wait and the readback") })
    && (match awaited_binding_refusal(host: "srv10" as HostIdentity, verified_id: "aaaa1111", awaited: awaited) { Absent => false  Present { value: _ } => true })
}

// THE SERVED WORDS ARE QUOTED (fleet-converge run 37304585650): the line rendered unquoted as
// `echo served|yes`, which the shell reads as a pipe into the `yes` command -- an endless writer that kept
// the front-door leg's ssh channel open for 87 minutes after a successful probe, until the step timeout.
// The field separator is a shell metacharacter, so every line that prints it must quote it. RED: the
// unquoted spelling, or any separator outside quotes in the post-probe report.
test fn w_the_front_door_report_quotes_the_field_separator() -> Bool {
  let d = spark_native_front_door_script(port_text: "8000", served_alias: "glm-5.3-flash" as NonEmptyStr, awaited: w_awaited_head, container: glm_native_container_name)
  string_contains(s: d, pattern: "echo \"served|yes\"")
    && string_contains(s: d, pattern: "echo \"served|no\"")
    && !string_contains(s: d, pattern: "echo served|")
}

// ── A WAIT LEG MAY NOT OUTLIVE ITS BOUND (valiant-crab-775, after run 37304585650) ───────────────────
//
// The front-door probe succeeded at 12:27Z and the leg stayed open until the step timeout at 13:54Z. The
// leg now runs under `timeout` bounded by the awaited deadline plus grace; these supply the session result
// at the decision's own interface. RED: a session `timeout` ended (124, or 137 after the kill-after) with
// no exit line reported reads as a script failure, or a bounded kill is accepted by the front door.
fn w_bounded_session(exit_code: Int, stdout: String) -> SshSessionExecResult {
  SshSessionExecResult { exit_code: exit_code, success: exit_code == 0, stdout: stdout, stderr: "" }
}

test fn w_a_leg_the_bound_killed_is_its_own_outcome_and_the_front_door_refuses_it() -> Bool {
  let began_only = join([remote_leg_began_word, "\n", awaited_header_word, awaited_field_separator, "0f3a9c1d2e4b", awaited_field_separator, "1234567\n"], "")
  let killed = spark_native_wait_leg_of(host: operator_host_srv9, wire: "management-lan", bound: second(count: 441), r: w_bounded_session(exit_code: 124, stdout: began_only))
  let killed_hard = spark_native_wait_leg_of(host: operator_host_srv9, wire: "management-lan", bound: second(count: 441), r: w_bounded_session(exit_code: 137, stdout: began_only))
  (match killed { WaitLegOutlivedBound { host: _, bound: _, stdout: _ } => true  WaitLegReturned { leg: _ } => false })
    && (match killed_hard { WaitLegOutlivedBound { host: _, bound: _, stdout: _ } => true  WaitLegReturned { leg: _ } => false })
    && all(spark_native_front_door_refusals(legs: [killed], awaited: [w_awaited_head]), r => string_contains(s: r, pattern: "outlived its bound of 441s"))
    && count(spark_native_front_door_refusals(legs: [killed], awaited: [w_awaited_head])) == 1
}

// THE CONTROL: the script's own exit 124, REPORTED on its exit line, is the script's outcome, not the bound;
// and a 255 with no exit line is still the transport's (unreached or failed), never the bound.
test fn w_a_reported_124_or_an_ssh_failure_is_not_the_bound() -> Bool {
  let reported = spark_native_wait_leg_of(host: operator_host_srv9, wire: "management-lan", bound: second(count: 441),
    r: w_bounded_session(exit_code: 124, stdout: join([remote_leg_began_word, "\n", spark_pair_leg_exit_prefix, "124\n"], "")))
  let ssh = spark_native_wait_leg_of(host: operator_host_srv9, wire: "management-lan", bound: second(count: 441), r: w_bounded_session(exit_code: 255, stdout: ""))
  (match reported { WaitLegReturned { leg: _ } => true  WaitLegOutlivedBound { host: _, bound: _, stdout: _ } => false })
    && (match ssh { WaitLegReturned { leg: _ } => true  WaitLegOutlivedBound { host: _, bound: _, stdout: _ } => false })
}
