  SparkHostAdmitted, SparkHostRefused, HostEffectHandle, admit_unplaced_host_over, release_host_effect_over,
  HostEffectSettled, HostEffectStillHeld, settle_host_effect_over, spark_host_standings_over, CurrentStandingsRead, CurrentStandingsUnread, spark_standing_of, SparkHostCommitted, SparkHostUncommitted, spark_commitment_causes, AuthorityHeldCommitment, OccupiedByHostEffect,
}
