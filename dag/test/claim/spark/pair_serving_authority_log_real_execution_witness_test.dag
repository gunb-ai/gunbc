  HostEffectClaim, HostEffectClaimed, HostEffectClaimRefused, HostEffectRelease, HostEffectReleasedAt, HostEffectReleaseRefused,
  HostEffectsRead, HostEffectsReadAt, HostEffectsUnread, host_effects_on_host, host_effects_on_partition, pair_authority_partition,
  HostEffectHome, GroupHome, HostHome, host_effect_home, host_effect_admit, host_effect_release, HostEffectHomeRead, HostEffectHomeUnread, host_effect_home_read,
