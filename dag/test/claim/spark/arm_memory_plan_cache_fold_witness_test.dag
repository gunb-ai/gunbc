// THE RESERVE STANDINGS, RECOMPUTED FOR THIS INVENTORY — never copied from the 1035-block launch:
// hard ceiling 8 (inventory alone); ReserveFullLengthSeats{1} holds 123 back and guarantees 7
// (861 <= 889 usable); the 7-seat leftover of 151 blocks prices ReserveBasisPoints{1492} (holds
// 150 back, 7 guaranteed); six as the conservative restoration point prices ReserveBasisPoints
// {2714} — the band 2708..2717 all hold exactly 274 blocks back and select exactly 6, and 274 of
// 1012 is 27.07% of this inventory (round-half: (274 x 10000 + 506) / 1012 = 2708, the band's
// floor), where the old inventory's 28.70% share priced 2870 — which HERE holds 290 back and
// selects only 5, the standing proof that a reserve share does not transfer across inventories.
test fn the_v2_frontier_reserve_policies_are_recomputed_for_this_inventory() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      let supplies = w_uniform_supplies(blocks: 1012, arena: arm_experiment_gib_hundredths_floor(hundredths: 1637))
      (w_frontier_guaranteed(p: p, supplies: supplies, policy: NoOperationalReserve) == 8)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveFullLengthSeats { seats: 1 }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBlocks { blocks: allocator_block_count(count: 151) }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 1492 }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2714 }) == 6)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2870 }) == 5)
        && (w_frontier_reserved(p: p, supplies: supplies, policy: ReserveFullLengthSeats { seats: 1 }) == 123)
        && (w_frontier_reserved(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2714 }) == 274)
        && (w_frontier_reserved(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2870 }) == 290)
        && ((274 * 10000 + 1012 / 2) / 1012 == 2708)
        && (151 * 10000 / 1012 == 1492)
        && (28 * 10000 / 1012 == 276)
  }
}

// THE CONSERVATION RED STILL BITES ON THE WITHDRAWN FIGURE, AT THE V2 POOL TOO: 125,010,432 bytes
// for the six-seat population (738 blocks) is 0.908% of THIS pool's 13,766,049,792 allocated
// bytes — under one percent, so the doctrine's RED sentence mints Refused naming the exact
// block-equivalent spelling (738 x 13,602,816 = 10,038,878,208); the exact figure is Consistent;
// a mere underprice (above 1% of the pool, below the block-equivalent figure) refuses without the
// RED sentence; an overprice refuses; and the v1 plan still refuses every byte claim as
// uncheckable. The RED is a property of the claim against the pool it claims to sit in — it does
// not soften because the pool changed size.
test fn the_conservation_red_still_bites_on_the_withdrawn_figure_at_the_v2_pool() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      (match shared_pool_byte_claim_red(plan: p, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 125010432)) {
        SharedPoolByteClaimRefused { cause: c } =>
          string_contains(s: c as String, pattern: "cannot occupy less than 1% of the same pool")
            && string_contains(s: c as String, pattern: "125010432")
            && string_contains(s: c as String, pattern: "10038878208")
        SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
      })
        && (match shared_pool_byte_claim_red(plan: p, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 738 * 13602816)) {
          SharedPoolByteClaimConsistent { request_blocks: r, block_equivalent_bytes: be } =>
            allocator_block_count_value(c: r) == 738 && byte_size_count(b: be) == 10038878208
          SharedPoolByteClaimRefused { cause: _ } => false
        })
        && (match shared_pool_byte_claim_red(plan: p, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 9000000000)) {
          SharedPoolByteClaimRefused { cause: c } =>
            !string_contains(s: c as String, pattern: "less than 1%")
              && string_contains(s: c as String, pattern: "under the block-equivalent figure")
          SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
        })
        && (match shared_pool_byte_claim_red(plan: p, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 11000000000)) {
          SharedPoolByteClaimRefused { cause: c } => string_contains(s: c as String, pattern: "over the block-equivalent figure")
          SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
        })
        && (match w_minted_real_plan() {
          Absent => false
          Present { value: v1 } =>
            match shared_pool_byte_claim_red(plan: v1, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 125010432)) {
              SharedPoolByteClaimRefused { cause: c } => string_contains(s: c as String, pattern: "v1 emission vintage")
              SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
            }
        })
  }
}

// THE RUN-TO-RUN VARIANCE IS NAMED, NEVER FOLDED: the two 262144x6 bundles stand side by side at
// their own subjects — different launch generations, different inventory decisions (the v1-image
// launch's plan read 1035 blocks, the v2 launch's reads 1012), different arena readings at every
// rank (23.45/18.62/18.90/17.29 against 22.79/20.26/18.75/16.37 GiB) — and neither bundle's
// readings are read as the other's: one launch's plan prices one launch's arenas, and the
// cross-launch drift is the fleet's allocator-stability question, carried by the observation
// layer, not silently averaged into a bound.
test fn the_v2_run_to_run_variance_is_named_never_folded() -> Bool {
  (arm_experiment_2026_09_26_generation as String) != (arm_experiment_kvplan_v2_2026_09_26_generation as String)
    && arm_experiment_kvplan_v2_2026_09_26_arena_derivation_holds()
    && (match first(filter(arm_experiment_2026_09_26_arena_readings, r => r.rank == 3)) {
      Present { value: v1_tp3 } => v1_tp3.kv_arena_hundredths_gib == 1729
      Absent => false
    })
    && (match first(filter(arm_experiment_kvplan_v2_2026_09_26_arena_readings, r => r.rank == 3)) {
      Present { value: v2_tp3 } => v2_tp3.kv_arena_hundredths_gib == 1637
      Absent => false
    })
    && length(arm_experiment_2026_09_26_arena_readings) == 4
    && length(arm_experiment_kvplan_v2_2026_09_26_arena_readings) == 4
}

// ── THE POOL-CONSTRUCTION STANDING BESIDE THE V2 VERDICT: THE SLACK MECHANISM, PINNED, NAMED ─────
//
// THE CONSERVATION FINDING THIS SECTION MODELS: the v2 emission's allocated pool
// (13,766,049,792 bytes over 1012 blocks of 13,602,816 — the engine's own figures, conserving
// exactly) is admitted at EVERY rank's arena — the <= half of the doctrine's construction
// sentence PASSES on all four ranks — while the limiting rank's arena exceeds the allocated pool
// by 3,811,103,866 bytes at the hundredths floor (~3.55 GiB, 280 physical pool blocks), where the
// v1-image launch's construction was tight (slack 346 bytes).
//
// THE SLACK MECHANISM IS PINNED, by the prefill lane's coverage fact (extdeps.vllm.
// sparse_prefill_transient, read off vllm@8d09804c8: gpu_worker.py:580-611 builds the printed
// peak activation as the profiled transient peak PLUS the CUDA-graph estimate, and gpu_worker.py:
// 803-810 measures the actual captured pool; the bundle carries TP1's own estimation line, 0.1 GiB
// actual against 1.82 GiB estimated). The engine's carve basis at this launch sat exactly one
// printed peak-activation below the post-capture free line: the profile line's own figures give
// post-capture free of 16.47 GiB ("Current kv cache memory in use", srv11) minus the printed peak
// activation of 3.65 GiB = 12.82 GiB, which is the engine's own 1012-block carve (1012 x
// 13,602,816 = 13,766,049,792 bytes = 12.82 GiB) up to the block floor. The slack between the
// envelope-derived arena and the constructed pool is therefore the printed peak-activation figure
// itself — profiled transient plus the over-reserved graph estimate — which the pinned fact
// establishes as arena slack, not demand: NONE of it is persistent residency. The candidate
// mechanism text stays on the record beside the allowance; the open obligation closes.
//
// THE ALLOWANCE, per the doctrine's named-allowance construction (an explicit byte figure with its
// reason, never an unnamed fudge): the limiting rank's own printed peak-activation column at this
// launch (srv11, 3.65 GiB at the reporter's hundredths floor = 3,919,157,657 bytes), derived from
// the observation bundle's own row below — not a new constant. THE DISCRIMINATING RED beside it:
// the bare estimate-over-actual residue (1.71 GiB) does NOT close the standing — the allowance
// covers the slack because the whole printed peak-activation rides, not just its graph component.
// THE EXISTING PER-RANK CONTROL still refuses the same evidence with no allowance, unweakened.

fn w_v2_slack_candidate_mechanism() -> NonEmptyStr {
  "TP1/srv10's own profile line at this launch: 'CUDA graph pool memory: 0.1 GiB (actual), 1.82 GiB (estimated), difference: 1.71 GiB (1649.1%)' -- the CUDA graph pool's estimated reservation over-counts its actual footprint by ~1.71 GiB, the largest uncertain term in the envelope-minus-usage arena derivation; the pinned coverage fact (extdeps.vllm.sparse_prefill_transient) establishes the estimate-over-actual residue as arena slack, not demand" as NonEmptyStr
}

// THE NAMED ALLOWANCE, DERIVED FROM THE BUNDLE'S OWN ROW: the limiting rank's printed
// peak-activation column at the v2 launch (srv11: 3.65 GiB), at the hundredths floor --
// 3,919,157,657 bytes. The observation layer owns the figure; this caller only projects it.
fn w_v2_slack_named_allowance_bytes() -> ByteSize {
  match first(filter(arm_experiment_kvplan_v2_2026_09_26_arena_readings, r => r.rank == arm_experiment_kvplan_v2_2026_09_26_limiting_rank)) {
    Present { value: r } => arm_experiment_gib_hundredths_floor(hundredths: r.activation_hundredths_gib)
    Absent => byte_size(count: 0)
  }
}

fn w_v2_slack_named_allowance_reason() -> NonEmptyStr {
  "the limiting rank's own printed peak-activation figure at this launch (gpu_worker.py:867 profile line, srv11: 3.65 GiB): the engine's carve basis sat one printed peak-activation below the post-capture free line -- post-capture free 16.47 GiB (the line's own 'Current kv cache memory in use' figure) minus the printed peak 3.65 GiB = 12.82 GiB, the engine's own 1012-block carve of 13,602,816-byte blocks -- and the pinned coverage fact (extdeps.vllm.sparse_prefill_transient, gpu_worker.py:580-611 and 803-810 at vllm@8d09804c8) establishes that the printed peak's CUDA-graph estimate component (1.82 GiB, TP1's own estimation line) over-reserves the actual captured pool (0.1 GiB): the estimate-over-actual residue is arena slack, not demand, and the profiled transient peak is no persistent residency either, so the whole printed peak-activation names the slack between the envelope-derived arena and the constructed pool" as NonEmptyStr
}

// THE V2 SLACK STANDING AT THE REAL FOUR ARENAS, UNDER THE NAMED ALLOWANCE: the fit half proves
// (13,766,049,792 bytes is admitted at every rank's arena floor) and the tight half now proves
// too -- srv11's 17,577,153,658-byte floor exceeds the pool by 3,811,103,866 bytes, under one
// physical block (13,602,816) plus the named allowance of 3,919,157,657 bytes (3.65 GiB, the
// limiting rank's own printed peak-activation figure) -- and the Proved arm carries the slack
// figure beside the construction facts, said rather than hidden.
test fn the_v2_pool_fits_every_arena_and_the_tight_construction_proves_under_the_named_allowance() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      match kv_allocator_carve_from_plan(plan: p) {
        Absent => false
        Present { value: carve } =>
          byte_size_count(b: w_v2_slack_named_allowance_bytes()) == 3919157657
            && (match pool_construction_slack_standing(
              carve: carve,
              supplies: arm_experiment_kvplan_v2_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1012)),
              allowance_bytes: w_v2_slack_named_allowance_bytes(),
              allowance_reason: w_v2_slack_named_allowance_reason(),
              candidate_mechanism: w_v2_slack_candidate_mechanism()) {
              PoolConstructionSlackProved { physical_pool_block_bytes: b, allocator_blocks: bl, allocated_pool_bytes: a, limiting_rank: lr, limiting_rank_arena_bytes: ab, slack_bytes: sb } =>
                byte_size_count(b: b) == 13602816
                  && allocator_block_count_value(c: bl) == 1012
                  && byte_size_count(b: a) == 13766049792
                  && lr == 3
                  && byte_size_count(b: ab) == 17577153658
                  && byte_size_count(b: sb) == 3811103866
              _ => false
            })
      }
  }
}

// THE DISCRIMINATING RED: THE BARE ESTIMATE-OVER-ACTUAL RESIDUE DOES NOT CLOSE THE STANDING.
// Allowing only TP1's printed estimation-line difference (1.71 GiB at the hundredths floor,
// 1,836,098,519 bytes) leaves the tight half open -- 3,811,103,866 bytes of slack against one
// block plus 1.71 GiB is still 280 blocks over -- and the standing must keep minting
// Unestablished with the candidate text and the open obligation. The allowance above closes the
// standing because the WHOLE printed peak-activation rides, not because its 1.71 GiB graph
// component does: this row pins that difference so a future edit cannot silently shrink the
// allowance to the residue and claim the same proof.
test fn the_estimate_over_actual_residue_alone_still_leaves_the_slack_open() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      match kv_allocator_carve_from_plan(plan: p) {
        Absent => false
        Present { value: carve } =>
          match pool_construction_slack_standing(
            carve: carve,
            supplies: arm_experiment_kvplan_v2_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1012)),
            allowance_bytes: arm_experiment_gib_hundredths_floor(hundredths: arm_experiment_kvplan_v2_2026_09_26_tp1_graph_pool_estimate.difference_hundredths_gib),
            allowance_reason: "TP1's CUDA-graph estimate-over-actual residue alone (the printed 1.71 GiB difference)" as NonEmptyStr,
            candidate_mechanism: w_v2_slack_candidate_mechanism()) {
            PoolConstructionSlackUnestablished { slack_bytes: sb, candidate_mechanism: cm, obligation: o } =>
              byte_size_count(b: sb) == 3811103866
                && string_contains(s: cm as String, pattern: "CUDA graph pool")
                && string_contains(s: o as String, pattern: "3811103866")
                && string_contains(s: o as String, pattern: "candidate, NOT established")
            _ => false
          }
      }
  }
}

// THE EXISTING PER-RANK CONTROL IS NOT WEAKENED: run the v2 evidence through
// pool_construction_per_rank and it refuses — the first over-slacked rank names the cause, the
// reading is not the admitted arena of THIS pool — the same loud refusal the control minted
// against the pre-clamp projections. The slack standing adds the split report; it never loosens
// the gate.
test fn the_existing_per_rank_control_still_refuses_the_v2_slack() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      match kv_allocator_carve_from_plan(plan: p) {
        Absent => false
        Present { value: carve } =>
          match pool_construction_per_rank(
            carve: carve,
            supplies: arm_experiment_kvplan_v2_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1012)),
            allowance_bytes: byte_size(count: 0),
            allowance_reason: "none named" as NonEmptyStr) {
            PoolConstructionRefused { cause: c } =>
              string_contains(s: c as String, pattern: "rank 0")
                && string_contains(s: c as String, pattern: "not the admitted arena of THIS pool")
            _ => false
          }
      }
  }
}

// THE SLACK STANDING STILL ADMITS THE TIGHT CONSTRUCTION, AND STILL REFUSES THE FIT VIOLATION:
// the designed v1 carve (18,564,995,790 bytes over 1035 blocks of 17,937,194) at the v1-image
// launch's four arenas proves -- the limiting rank is srv11 again, its 18,564,996,136-byte floor
// slack 346 bytes, under one physical block -- while the same carve at the v2 launch's smaller
// arenas refuses at rank 3 (16.37 GiB cannot hold an 18.56 GiB pool): the fit half's gate is
// unchanged in both directions.
test fn the_slack_standing_proves_the_tight_case_and_refuses_the_fit_violation() -> Bool {
  match w_carve() {
    Absent => false
    Present { value: carve } =>
      (match pool_construction_slack_standing(
        carve: carve,
        supplies: arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)),
        allowance_bytes: byte_size(count: 0),
        allowance_reason: "none named" as NonEmptyStr,
        candidate_mechanism: "none named" as NonEmptyStr) {
        PoolConstructionSlackProved { physical_pool_block_bytes: b, allocator_blocks: bl, allocated_pool_bytes: a, limiting_rank: lr, limiting_rank_arena_bytes: ab, slack_bytes: sb } =>
          byte_size_count(b: b) == 17937194
            && allocator_block_count_value(c: bl) == 1035
            && byte_size_count(b: a) == 18564995790
            && lr == 3
            && byte_size_count(b: ab) == 18564996136
            && byte_size_count(b: sb) == 346
        _ => false
      })
        && (match pool_construction_slack_standing(
          carve: carve,
          supplies: arm_experiment_kvplan_v2_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1012)),
          allowance_bytes: byte_size(count: 0),
          allowance_reason: "none named" as NonEmptyStr,
          candidate_mechanism: "none named" as NonEmptyStr) {
          PoolConstructionSlackRefused { cause: c } =>
            string_contains(s: c as String, pattern: "rank 3")
              && string_contains(s: c as String, pattern: "exceeds the rank's admitted KV arena")
          _ => false
        })
  }
}

// THE MALFORMED SUPPLIES REFUSE, NOT PROVE: a zero arena reading refuses as bounding nothing, and
// an arena below the allocated pool refuses the fit half naming the rank -- the slack standing
// never mints a standing over a supply side that says nothing.
test fn the_slack_standing_refuses_zero_and_under_arena_readings() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      match kv_allocator_carve_from_plan(plan: p) {
        Absent => false
        Present { value: carve } =>
          (match pool_construction_slack_standing(
            carve: carve,
            supplies: w_uniform_supplies(blocks: 1012, arena: byte_size(count: 0)),
            allowance_bytes: byte_size(count: 0),
            allowance_reason: "none named" as NonEmptyStr,
            candidate_mechanism: "none named" as NonEmptyStr) {
            PoolConstructionSlackRefused { cause: c } => string_contains(s: c as String, pattern: "zero")
            _ => false
          })
            && (match pool_construction_slack_standing(
              carve: carve,
              supplies: w_uniform_supplies(blocks: 1012, arena: byte_size(count: 13000000000)),
              allowance_bytes: byte_size(count: 0),
              allowance_reason: "none named" as NonEmptyStr,
              candidate_mechanism: "none named" as NonEmptyStr) {
              PoolConstructionSlackRefused { cause: c } =>
                string_contains(s: c as String, pattern: "rank 0")
                  && string_contains(s: c as String, pattern: "the fit half fails at this rank")
              _ => false
            })
      }
  }
}

// THE VERDICT CARRIES THE CONSTRUCTION STANDING BESIDE IT: one join over the v2 plan and the v2
// bundle's arenas returns CacheFitProved { rank 3, seats 6, blocks_per_seat 123, blocks_used 738,
// blocks_reserved 123 under ReserveFullLengthSeats{1}, hard_ceiling 8, block_equivalent_bytes
// 10,038,878,208 } BESIDE PoolConstructionSlackProved { limiting rank 3, slack 3,811,103,866
// bytes } -- six seats proven at the block wall and the pool's tight construction proven under
// the named peak-activation allowance, the two facts traveling together so neither can be cited
// without the other.
test fn the_v2_verdict_carries_the_slack_standing_beside_it() -> Bool {
  match w_minted_v2_real_plan() {
    Absent => false
    Present { value: p } =>
      match kv_allocator_carve_from_plan(plan: p) {
        Absent => false
        Present { value: carve } =>
          match cache_fit_with_pool_construction(
            plan: p, shape: glm_5_3_flash_hybrid_shape,
            seats: 6,
            supplies: arm_experiment_kvplan_v2_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1012)),
            rank_count: 4, limiting_rank: 3, reserve_policy: ReserveFullLengthSeats { seats: 1 },
            carve: carve,
            allowance_bytes: w_v2_slack_named_allowance_bytes(),
            allowance_reason: w_v2_slack_named_allowance_reason(),
            candidate_mechanism: w_v2_slack_candidate_mechanism()) {
            CacheFitWithPoolConstruction { cache_verdict: cache, pool_construction: construction } =>
              (match cache {
                CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, blocks_reserved: br, hard_ceiling: hc, block_equivalent_bytes: be } =>
                  lr == 3
                    && s == 6
                    && token_count_value(t: l) == 262144
                    && allocator_block_count_value(c: bps) == 123
                    && allocator_block_count_value(c: bu) == 738
                    && allocator_block_count_value(c: br) == 123
                    && hc == 8
                    && (match be {
                      Present { value: b } => byte_size_count(b: b) == 10038878208
                      Absent => false
                    })
                _ => false
              })
                && (match construction {
                  PoolConstructionSlackProved { limiting_rank: lr2, slack_bytes: sb2 } =>
                    lr2 == 3
                      && byte_size_count(b: sb2) == 3811103866
                  _ => false
                })
            _ => false
          }
      }
  }
}
