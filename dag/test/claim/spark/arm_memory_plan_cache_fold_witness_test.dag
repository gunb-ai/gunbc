        CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "zero seats name no admission"))
        _ => false
      }
  }
}

// THE COMPLETING RUN'S FOUR ARENAS PROVE SIX SEATS AT THE LIMITING RANK: the real evidence
// (gunbc.spark.arm_memory_experiment_observed's 2026-09-26 bundle: TP0/srv9 23.45, TP1/srv10
// 18.62, TP2/srv12 18.90, TP3/srv11 17.29 GiB at the hundredths floor) prices the block wall —
// 6 x 123 = 738 of 1035 blocks — and the verdict carries the bundle's own limiting rank (3), so
// the evidence and the verdict cannot drift apart silently; the bundle's rank-3 reading is
// pinned here as srv11's 17.29 GiB floor (18,564,996,136 bytes), the arena the doctrine's
// reconciliation reads. The v1 plan's block_equivalent_bytes rides Absent: blocks proven, no
// byte conservation claimed.
test fn the_completing_run_evidence_proves_six_seats_at_the_limiting_rank() -> Bool {
  (match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)),
        rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, blocks_reserved: br, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3
            && lr == arm_experiment_2026_09_26_limiting_rank
            && s == 6
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: bu) == 738
            && allocator_block_count_value(c: br) == 0
            && hc == 8
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      }
  })
    && (match first(filter(arm_experiment_2026_09_26_arena_readings, r => r.rank == arm_experiment_2026_09_26_limiting_rank)) {
      Present { value: tp3 } =>
        tp3.host == "srv11" as NonEmptyStr
          && tp3.kv_arena_hundredths_gib == 1729
          && byte_size_count(b: arm_experiment_gib_hundredths_floor(hundredths: tp3.kv_arena_hundredths_gib)) == 18564996136
      Absent => false
    })
}

// THE CONSERVATION CONTROL GENERALIZED INTO EVERY POSITION: drop any one of the four arenas
// (the zero spelling of unobserved) and the fold falls back to CacheFitUnestablished naming
// EXACTLY that rank — the three-unobserved-arenas verdict of 2026-09-25 held in all four
// positions, so a future capture gap is named at the rank that produced it.
test fn dropping_any_one_arena_falls_back_to_unestablished_naming_that_rank() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      w_drop_one_arena_names_that_rank(p: p, dropped: 0)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 1)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 2)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 3)
  }
}

fn w_drop_one_arena_names_that_rank(p: ResolvedKvAllocationPlan, dropped: Nat) -> Bool {
  match cache_fit_verdict_from_plan(
    plan: p, shape: glm_5_3_flash_hybrid_shape,
    seats: 6,
    supplies: map(arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)), s =>
      match s.rank == dropped {
        true => ArmRankCacheSupply { rank: s.rank, allocator_blocks: s.allocator_blocks, admitted_kv_arena_bytes: byte_size(count: 0) }
        false => s
      }),
    rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
    CacheFitUnestablished { obligations: os } =>
      length(os) == 1
        && any(os, o => string_contains(s: o as String, pattern: join(["rank ", to_string(dropped), " carries a zero"], "")))
    _ => false
  }
}

// THE LIMITING RANK IS EVIDENCE, AND OUT-OF-ROSTER EVIDENCE NAMES NO RANK: the verdict carries
// the rank the bundle binds (TP3, the engine's min across ranks already applied to the uniform
// inventory), and a limiting rank the topology does not contain is an obligation, not a proof at
// no rank.
test fn the_limiting_rank_is_carried_and_out_of_roster_evidence_refuses() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3 && s == 6 && hc == 8 && allocator_block_count_value(c: bu) == 738
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 4, reserve_policy: NoOperationalReserve) {
          CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "outside the 4-rank topology"))
          _ => false
        })
  }
}

// THE BLOCK WALL DECIDES WITHOUT READING THE ARENAS: six seats at 738 of the plan's 1035-block
// inventory prove on every rank at the block wall alone — the arenas in the supply rows bound
// nothing here (bytes verify pool construction, never capacity), which is the correction.
test fn six_seats_prove_at_the_block_wall_on_the_real_plan() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3
            && s == 6
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: bu) == 738
            && hc == 8
        _ => false
      }
  }
}

// THE BLOCK ARITHMETIC, PINNED END TO END: 6 seats x 123 blocks = 738 of 1035 — slack 297
// blocks; the ceiling is floor(1035 / 123) = 8 seats (8 x 123 = 984 <= 1035, slack 51), and the
// ninth seat refuses at 1107 > 1035. The block wall is the binding constraint at every seat
// count, and the reserve column of the doctrine's frontier table (28.70%, 16.81%, 4.93% of the
// inventory left) is blocks_left / 1035, priced by the frontier fold below.
test fn the_block_ceiling_is_eight_and_the_ninth_seat_refuses() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 8,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3 && s == 8 && allocator_block_count_value(c: bu) == 984 && hc == 8
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 9,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
          CacheFitRefused { limiting_rank: lr, seats: s, blocks_per_seat: bps, blocks_used: bu, supply_allocator_blocks: sb, cause: _ } =>
            lr == 0 && s == 9 && allocator_block_count_value(c: bps) == 123
              && allocator_block_count_value(c: bu) == 1107
              && allocator_block_count_value(c: sb) == 1035
          _ => false
        })
        && 1035 - 738 == 297
        && 8 * 123 == 984
        && 1035 - 984 == 51
        && 9 * 123 == 1107
  }
}

// THE REQUEST-COST VERDICT IS THE EXACT ROSTER: the plan's six groups and their summed
// blocks_at_requested_length — 123 shared-pool blocks per full-context request, the
// KvAdmissionDemand of one seat. The group's spec pages price the LOGICAL per-group charge
// (blocks_at x group_spec_page_size_bytes = max_memory_usage_bytes, the figure that reproduces
// the printed 8.41x); they never sum into a byte demand — that sum was the withdrawn figure.
test fn the_request_block_cost_is_the_exact_roster() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match request_block_cost(plan: p) {
        RequestBlockCostProved { group_roster: roster, blocks_per_request: bpr } =>
          length(roster) == 6 && allocator_block_count_value(c: bpr) == 123
        RequestBlockCostRefused { cause: _ } => false
      }
  }
}

// THE ADMISSION VERDICT PRICES THE POPULATION AGAINST THE USABLE INVENTORY, RESERVE FIRST: with
// the first production reserve candidate (one full-length seat = 123 blocks) the usable inventory
// is 912 blocks — six (738) and seven (861) admit, eight (984) refuses at the reserve, and nine
// refuses at the bare wall. The reserve is a standing, not a capacity fact: NoOperationalReserve
// admits eight (984 <= 1035).
test fn cache_admission_respects_the_reserve_policy() -> Bool {
  (match cache_admission_verdict(population_blocks: allocator_block_count(count: 738), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
    CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
      allocator_block_count_value(c: r) == 738 && allocator_block_count_value(c: u) == 912
    CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
  })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 861), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
      CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
        allocator_block_count_value(c: r) == 861 && allocator_block_count_value(c: u) == 912
      CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
    })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 984), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
      CacheAdmissionRefused { request_blocks: r, usable_allocator_blocks: u, cause: _ } =>
        allocator_block_count_value(c: r) == 984 && allocator_block_count_value(c: u) == 912
      CacheAdmissionProved { request_blocks: _, usable_allocator_blocks: _ } => false
    })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 984), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 0)) {
      CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
        allocator_block_count_value(c: r) == 984 && allocator_block_count_value(c: u) == 1035
      CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
    })
}

// THE RESERVE POLICY IS CARRIED IN THE VERDICT, BLOCKS ONLY: ReserveFullLengthSeats{1} holds 123
// blocks back (1 x 123), ReserveBlocks{297} holds an explicit count, ReserveBasisPoints{2870}
// holds 2870bp of 1035 = 297 blocks (the six-seat standing reserve: 297 of 1035 blocks left at
// six seats is 28.70% of the inventory, the conservative restoration point's reserve). No byte
// figure rides a reserve: it is a block standing.
test fn the_reserve_policy_is_carried_in_blocks_in_the_verdict() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: ReserveFullLengthSeats { seats: 1 }) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, blocks_reserved: br, block_equivalent_bytes: be } =>
          lr == 3 && s == 6 && allocator_block_count_value(c: bu) == 738 && allocator_block_count_value(c: br) == 123
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: ReserveBlocks { blocks: allocator_block_count(count: 297) }) {
          CacheFitProved { limiting_rank: lr, seats: s, blocks_reserved: br } =>
            lr == 3 && s == 6 && allocator_block_count_value(c: br) == 297
          _ => false
        })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: ReserveBasisPoints { basis_points: 2870 }) {
          CacheFitProved { limiting_rank: lr, seats: s, blocks_reserved: br } =>
            lr == 3 && s == 6 && allocator_block_count_value(c: br) == 297
          _ => false
        })
  }
}

// THE HEADROOM FIGURES, PINNED: the printed pool is a full-context-equivalent projection —
// 1035 blocks over a 123-block request is 8.4146 requests, and 8.4146 x 262,144 tokens =
// 2,205,845 tokens, the printed line — so the printed candidate reads floor(2,205,845 / 262,144)
// = 8 seats, and the direct fold AGREES with the candidate at the floor (8 x 123 = 984 <= 1035).
// The declared six seats hold 1,572,864 tokens, leaving 632,981 printed tokens (≈ 2.4 seats) and
// 297 blocks (≈ 2 seats by the fold) of slack. The candidate stays what it is — a sizing hint no
// verdict consumes — and the fold stays the only proof.
test fn the_headroom_figures_are_pinned() -> Bool {
  (match cache_capacity_candidate(printed_pool_tokens: token_count(count: 2205845), division_length: token_count(count: 262144)) {
    Present { value: c } => c.seats_by_division == 8
    Absent => false
  })
    && 2205845 - 6 * 262144 == 632981
    && 262144 * 6 == 1572864
}

// ── THE CONSERVATION CONTROLS AND THE RED, ON THE DOC-RECONCILED v2 CARVE ────────────────────────
//
// THE DESIGNED v2 PLAN is the real v1 plan plus the two pool figures the v2 emission will carry,
// pinned to the doctrine's own reconciliation (docs/plans/shared-pool-byte-correction.md): TP3's
// observed 17.29 GiB arena at the hundredths floor is 18,564,996,136 bytes over the plan's 1035
// blocks, which self-consistently implies physical_pool_bytes_per_block = 17,937,194 and
// allocated_pool_bytes = 18,564,995,790 — the arena slack is 346 bytes, under one physical block,
// exactly the conservation control's shape. These are the doc-reconciled design constants for the
// controls' witnesses; the engine's own v2 emission replaces them with the read figures the day
// the v2 image flies, and nothing here claims a live engine emitted them.

data w_physical_pool_bytes_per_block: Nat = 17937194

data w_allocated_pool_bytes: Nat = 18564995790

fn w_plan_with_carve(p: ResolvedKvAllocationPlan) -> ResolvedKvAllocationPlan {
  ResolvedKvAllocationPlan {
    runtime: p.runtime,
    image_digest: p.image_digest,
    cache_format: p.cache_format,
    allocator_blocks: p.allocator_blocks,
    physical_pool_bytes_per_block: Present { value: byte_size(count: w_physical_pool_bytes_per_block) },
    allocated_pool_bytes: Present { value: byte_size(count: w_allocated_pool_bytes) },
    requested_length: p.requested_length,
    scheduler_block_size: p.scheduler_block_size,
    groups: p.groups,
    grouping_padding: p.grouping_padding,
  }
}

fn w_carve() -> KvAllocatorCarve? {
  match w_minted_real_plan() {
    Absent => none
    Present { value: p } => kv_allocator_carve_from_plan(plan: w_plan_with_carve(p: p))
  }
}

fn w_capture_of(p: ResolvedKvAllocationPlan) -> KvAllocationPlanCapture {
  KvAllocationPlanCapture {
    observed_at_revision: p.runtime,
    image_digest: p.image_digest,
    cache_format: Present { value: p.cache_format },
    allocator_blocks: Present { value: p.allocator_blocks },
    physical_pool_bytes_per_block: Absent,
    allocated_pool_bytes: Absent,
    requested_length: Present { value: p.requested_length },
    scheduler_block_size: Present { value: p.scheduler_block_size },
    groups: Present { value: map(p.groups, g => KvAllocationPlanCaptureGroup {
      identity: Present { value: g.identity },
      kind: Present { value: g.kind },
      layer_identities: Present { value: g.layer_identities },
      block_size: Present { value: g.block_size },
      group_spec_page_size_bytes: Present { value: g.group_spec_page_size_bytes },
      tokens_per_state: Present { value: g.tokens_per_state },
      max_memory_usage_bytes: Present { value: g.max_memory_usage_bytes },
      blocks_at_requested_length: Present { value: g.blocks_at_requested_length },
    }) },
    grouping_padding: Present { value: p.grouping_padding },
  }
}

fn w_capture_with_pool_fields(c: KvAllocationPlanCapture, pool_block: ByteSize?, allocated: ByteSize?) -> KvAllocationPlanCapture {
  KvAllocationPlanCapture {
    observed_at_revision: c.observed_at_revision,
    image_digest: c.image_digest,
    cache_format: c.cache_format,
    allocator_blocks: c.allocator_blocks,
    physical_pool_bytes_per_block: pool_block,
    allocated_pool_bytes: allocated,
    requested_length: c.requested_length,
    scheduler_block_size: c.scheduler_block_size,
    groups: c.groups,
    grouping_padding: c.grouping_padding,
  }
}

// THE MINT-LEVEL CONSERVATION, BOTH VINTAGES: the v1 real plan mints blocks-only and its
// construction verdict is Unestablished naming the vintage; the designed v2 plan conserves
// (1035 x 17,937,194 = 18,564,995,790 exactly) and its construction verdict is Proved carrying
// the engine-side figures; a non-conserving v2 plan (allocated off by one block) refuses at the
// mint, and a half-emitted pair (exactly one pool field) refuses as a partial vintage.
test fn pool_construction_verdicts_discriminate_both_vintages() -> Bool {
  (match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match pool_construction_verdict(plan: p) {
        PoolConstructionUnestablished { cause: c } => string_contains(s: c as String, pattern: "v1 emission vintage")
        _ => false
      })
        && (match pool_construction_verdict(plan: w_plan_with_carve(p: p)) {
          PoolConstructionProved { physical_pool_block_bytes: b, allocator_blocks: bl, allocated_pool_bytes: a } =>
            byte_size_count(b: b) == w_physical_pool_bytes_per_block
              && allocator_block_count_value(c: bl) == 1035
              && byte_size_count(b: a) == w_allocated_pool_bytes
          _ => false
        })
        && (match resolved_kv_allocation_plan_from_capture(capture: w_capture_with_pool_fields(
          c: w_capture_of(p: p),
          pool_block: Present { value: byte_size(count: w_physical_pool_bytes_per_block) },
          allocated: Absent)) {
          KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "one fact")
          KvAllocationPlanAdmitted { plan: _ } => false
        })
        && (match resolved_kv_allocation_plan_from_capture(capture: w_capture_with_pool_fields(
          c: w_capture_of(p: p),
          pool_block: Present { value: byte_size(count: w_physical_pool_bytes_per_block) },
          allocated: Present { value: byte_size(count: w_allocated_pool_bytes + w_physical_pool_bytes_per_block) })) {
          KvAllocationPlanRefused { cause: c } => string_contains(s: c as String, pattern: "do not conserve")
          KvAllocationPlanAdmitted { plan: _ } => false
        })
  })
    && w_physical_pool_bytes_per_block * 1035 == w_allocated_pool_bytes
}

// THE PER-RANK CONSTRUCTION CONTROL AGAINST THE REAL FOUR ARENAS: the allocated pool is the same
// 1035-block construction on every rank (the engine min-clamped the inventory), so exactly one
// rank's arena can sit within one physical block of it — TP3/srv11's 17.29 GiB floor (slack 346
// bytes) PROVES construction, and the other three readings (23.45/18.62/18.90 GiB floors) refuse
// as not THIS pool's admitted arena: they are the workers' pre-clamp local pool projections, tens
// of physical blocks above the min-clamped allocation. That asymmetry is why the byte wall was
// never a per-rank capacity check — and why the conservation control names its allowance. A zero
// arena reading refuses as bounding nothing.
test fn pool_construction_at_the_real_arenas_proves_only_at_the_limiting_rank() -> Bool {
  match w_carve() {
    Absent => false
    Present { value: carve } =>
      (match pool_construction_per_rank(
        carve: carve,
        supplies: arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)),
        allowance_bytes: byte_size(count: 0),
        allowance_reason: "none named" as NonEmptyStr) {
        PoolConstructionRefused { cause: c } =>
          string_contains(s: c as String, pattern: "rank 0")
            && string_contains(s: c as String, pattern: "not the admitted arena of THIS pool")
        _ => false
      })
        && (match pool_construction_per_rank(
          carve: carve,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1729)),
          allowance_bytes: byte_size(count: 0),
          allowance_reason: "none named" as NonEmptyStr) {
          PoolConstructionProved { physical_pool_block_bytes: b, allocator_blocks: bl, allocated_pool_bytes: a } =>
            byte_size_count(b: b) == w_physical_pool_bytes_per_block
              && allocator_block_count_value(c: bl) == 1035
              && byte_size_count(b: a) == w_allocated_pool_bytes
          _ => false
        })
        && (match pool_construction_per_rank(
          carve: carve,
          supplies: w_uniform_supplies(blocks: 1035, arena: byte_size(count: 18500000000)),
          allowance_bytes: byte_size(count: 0),
          allowance_reason: "none named" as NonEmptyStr) {
          PoolConstructionRefused { cause: c } => string_contains(s: c as String, pattern: "exceeds the rank's admitted KV arena")
          _ => false
        })
        && (match pool_construction_per_rank(
          carve: carve,
          supplies: w_uniform_supplies(blocks: 1035, arena: byte_size(count: 0)),
          allowance_bytes: byte_size(count: 0),
          allowance_reason: "none named" as NonEmptyStr) {
          PoolConstructionRefused { cause: c } => string_contains(s: c as String, pattern: "zero")
          _ => false
        })
  }
}

// THE CONSERVATION RED, PINNING THE WITHDRAWN FIGURE: the 125,010,432-byte claim for the
// six-seat population (738 blocks) is 0.673% of the same pool's allocated bytes — it mints
// Refused naming the doctrine's sentence, NEVER anything a capacity question reads as proved.
// The exact block-equivalent spelling (738 x 17,937,194 = 13,237,649,172 bytes, 71.30% of the
// pool, ~12.33 GiB) is Consistent; an underprice at or above 1% of the pool refuses without the
// RED sentence; an overprice refuses; and the v1 plan refuses every byte claim as uncheckable.
test fn the_conservation_red_pins_the_withdrawn_six_seat_figure() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      let v2 = w_plan_with_carve(p: p)
      (match shared_pool_byte_claim_red(plan: v2, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 125010432)) {
        SharedPoolByteClaimRefused { cause: c } =>
          string_contains(s: c as String, pattern: "cannot occupy less than 1% of the same pool")
            && string_contains(s: c as String, pattern: "125010432")
            && string_contains(s: c as String, pattern: "13237649172")
        SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
      })
        && (match shared_pool_byte_claim_red(plan: v2, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 738 * w_physical_pool_bytes_per_block)) {
          SharedPoolByteClaimConsistent { request_blocks: r, block_equivalent_bytes: be } =>
            allocator_block_count_value(c: r) == 738 && byte_size_count(b: be) == 13237649172
          SharedPoolByteClaimRefused { cause: _ } => false
        })
        && (match shared_pool_byte_claim_red(plan: v2, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 500000000)) {
          SharedPoolByteClaimRefused { cause: c } =>
            !string_contains(s: c as String, pattern: "less than 1%")
              && string_contains(s: c as String, pattern: "under the block-equivalent figure")
          SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
        })
        && (match shared_pool_byte_claim_red(plan: v2, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 14000000000)) {
          SharedPoolByteClaimRefused { cause: c } => string_contains(s: c as String, pattern: "over the block-equivalent figure")
          SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
        })
        && (match shared_pool_byte_claim_red(plan: p, request_blocks: allocator_block_count(count: 738), claimed_block_equivalent_bytes: byte_size(count: 125010432)) {
          SharedPoolByteClaimRefused { cause: c } => string_contains(s: c as String, pattern: "v1 emission vintage")
          SharedPoolByteClaimConsistent { request_blocks: _, block_equivalent_bytes: _ } => false
        })
  }
}

// THE CORRECTED BYTE SPELLING RIDES THE PROVED VERDICT, NAMED: six seats on the designed v2 plan
// prove at the block wall as before, and the verdict now carries block_equivalent_bytes =
// 13,237,649,172 — the ONLY byte figure a capacity verdict may hold, named block_equivalent_bytes
// so it is never read as ordinary memory demand or physical headroom.
test fn the_proved_verdict_carries_the_block_equivalent_spelling_on_the_v2_plan() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: w_plan_with_carve(p: p), shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1729)),
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, blocks_per_seat: bps, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3 && s == 6
            && allocator_block_count_value(c: bu) == 738
            && allocator_block_count_value(c: bps) == 123
            && hc == 8
            && (match be {
              Present { value: b } => byte_size_count(b: b) == 13237649172
              Absent => false
            })
        _ => false
      }
  }
}

// ── THE CACHE FRONTIER: THE LADDER, THE RESERVE SELECTION, AND THE WHOLE-ARM STANDING ────────────

// THE FRONTIER LADDER ON THE REAL PLAN, one fold, the doctrine's table computed: 6/738, 7/861,
// 8/984 prove at the block wall, 9/1107 refuses — shares of the already-allocated 1035-block
// inventory, not additional allocations (vLLM allocated the whole pool at startup). Under the
// first production reserve candidate (ReserveFullLengthSeats{1}: 123 blocks held back) the
// guaranteed seat count is 7 of the hard ceiling 8; six remains the conservative restoration
// point, leaving 297 blocks = 28.70% of the inventory. THE RUNGS RIDE IN ORDER (ceiling − 2
// through ceiling + 1), so the ladder is read by position, each rung discriminated on its own.
test fn the_cache_frontier_ladder_proves_six_seven_eight_and_refuses_nine() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_frontier_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: ReserveFullLengthSeats { seats: 1 }) {
        CacheFrontier { limiting_rank: lr, length: l, blocks_per_seat: bps, inventory: inv, hard_ceiling: hc, reserve_policy: _, blocks_reserved: br, guaranteed_seats: gs, rungs: rungs, block_equivalent_bytes_per_seat: be } =>
          lr == 3
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: inv) == 1035
            && hc == 8
            && allocator_block_count_value(c: br) == 123
            && gs == 7
            && length(rungs) == 4
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
            && w_rung_proved(rungs: rungs, index: 0, seats: 6, used: 738, left: 297)
            && w_rung_proved(rungs: rungs, index: 1, seats: 7, used: 861, left: 174)
            && w_rung_proved(rungs: rungs, index: 2, seats: 8, used: 984, left: 51)
            && (match w_rung_at(rungs: rungs, index: 3) {
              Present { value: CacheFrontierRungRefused { seats: s9, blocks_used: u9, cause: _ } } =>
                s9 == 9 && allocator_block_count_value(c: u9) == 1107
              _ => false
            })
        _ => false
      }
  }
}

fn w_rung_at(rungs: List<CacheFrontierRung>, index: Nat) -> CacheFrontierRung? {
  first(skip(rungs, index))
}

fn w_rung_proved(rungs: List<CacheFrontierRung>, index: Nat, seats: Nat, used: Nat, left: Nat) -> Bool {
  match w_rung_at(rungs: rungs, index: index) {
    Present { value: CacheFrontierRungProved { seats: s, blocks_used: u, blocks_left: l } } =>
      s == seats && allocator_block_count_value(c: u) == used && allocator_block_count_value(c: l) == left
    _ => false
  }
}

fn w_frontier_guaranteed(p: ResolvedKvAllocationPlan, supplies: List<ArmRankCacheSupply>, policy: CacheReservePolicy) -> Nat {
  match cache_frontier_from_plan(
    plan: p, shape: glm_5_3_flash_hybrid_shape,
    supplies: supplies,
    rank_count: 4, limiting_rank: 3, reserve_policy: policy) {
    CacheFrontier { limiting_rank: _, length: _, blocks_per_seat: _, inventory: _, hard_ceiling: _, reserve_policy: _, blocks_reserved: _, guaranteed_seats: g, rungs: _, block_equivalent_bytes_per_seat: _ } => g
    CacheFrontierUnestablished { obligations: _ } => 9999
  }
}

fn w_frontier_reserved(p: ResolvedKvAllocationPlan, supplies: List<ArmRankCacheSupply>, policy: CacheReservePolicy) -> Nat {
  match cache_frontier_from_plan(
    plan: p, shape: glm_5_3_flash_hybrid_shape,
    supplies: supplies,
    rank_count: 4, limiting_rank: 3, reserve_policy: policy) {
    CacheFrontier { limiting_rank: _, length: _, blocks_per_seat: _, inventory: _, hard_ceiling: _, reserve_policy: _, blocks_reserved: br, guaranteed_seats: _, rungs: _, block_equivalent_bytes_per_seat: _ } => allocator_block_count_value(c: br)
    CacheFrontierUnestablished { obligations: _ } => 9999
  }
}

// THE THREE STANDINGS, PINNED: hard ceiling 8 (inventory alone, no reserve); guaranteed seats by
// policy — NoOperationalReserve guarantees to the wall (8), ReserveFullLengthSeats{1} selects 7,
// ReserveBlocks{174} selects 7, ReserveBasisPoints{1681} (the 7-seat leftover share) selects 7;
// and six as the conservative restoration point with its 28.7% reserve — ReserveBasisPoints{2870}
// holds 297 blocks back and selects exactly 6. The reserve SHARES, at two-decimal percent:
// 297/1035 = 28.70%, 174/1035 = 16.81%, 51/1035 = 4.93% of the inventory left at 6/7/8 seats.
test fn the_frontier_reserve_policies_select_their_guaranteed_seats() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      let supplies = w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703))
      (w_frontier_guaranteed(p: p, supplies: supplies, policy: NoOperationalReserve) == 8)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveFullLengthSeats { seats: 1 }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBlocks { blocks: allocator_block_count(count: 174) }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 1681 }) == 7)
        && (w_frontier_guaranteed(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2870 }) == 6)
        && (w_frontier_reserved(p: p, supplies: supplies, policy: ReserveFullLengthSeats { seats: 1 }) == 123)
        && (w_frontier_reserved(p: p, supplies: supplies, policy: ReserveBasisPoints { basis_points: 2870 }) == 297)
        && (297 * 10000 + 1035 / 2) / 1035 == 2870
        && 174 * 10000 / 1035 == 1681
        && 51 * 10000 / 1035 == 492
  }
}

// THE FRONTIER NAMES THE BLOCK-EQUIVALENT PER SEAT ON THE v2 PLAN: 123 blocks per seat at
// 17,937,194 bytes per block = 2,206,274,862 block-equivalent bytes per seat — the frontier's
// only byte figure, named block_equivalent_bytes_per_seat, absent on the v1 vintage.
test fn the_frontier_carries_the_block_equivalent_per_seat_on_the_v2_plan() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_frontier_from_plan(
        plan: w_plan_with_carve(p: p), shape: glm_5_3_flash_hybrid_shape,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1729)),
        rank_count: 4, limiting_rank: 3, reserve_policy: ReserveFullLengthSeats { seats: 1 }) {
        CacheFrontier { limiting_rank: _, length: _, blocks_per_seat: _, inventory: _, hard_ceiling: _, reserve_policy: _, blocks_reserved: _, guaranteed_seats: gs, rungs: _, block_equivalent_bytes_per_seat: be } =>
          gs == 7
            && (match be {
              Present { value: b } => byte_size_count(b: b) == 2206274862
              Absent => false
            })
        _ => false
      }
  }
}

// THE WHOLE ARM STAYS UNESTABLISHED WHILE THE 262K PREFILL TRANSIENT IS OPEN: the frontier proves
// 6/7/8 and refuses 9 at the block wall, and even a Proved cache verdict beside it names the open
// prefill transient in the standing — a proved cache frontier is not a whole-arm fit, and no
// eight-seat persistent service follows from cache capacity alone (the adoption gate the
// doctrine pins: prefill derivation, profile-shape binding, falsification run, SLO evidence).
test fn the_cache_frontier_does_not_promote_the_whole_arm() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      let supplies = w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703))
      let frontier_proves_eight = match cache_frontier_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        supplies: supplies,
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFrontier { limiting_rank: _, length: _, blocks_per_seat: _, inventory: _, hard_ceiling: hc, reserve_policy: _, blocks_reserved: _, guaranteed_seats: _, rungs: rungs, block_equivalent_bytes_per_seat: _ } =>
          hc == 8 && any(rungs, r => match r {
            CacheFrontierRungProved { seats: s, blocks_used: _, blocks_left: _ } => s == 8
            CacheFrontierRungRefused { seats: _, blocks_used: _, cause: _ } => false
          })
        CacheFrontierUnestablished { obligations: _ } => false
      }
      let cache = cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: supplies,
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve)
      let arm = ArmMemoryFitUnestablished { obligations: [arm_prefill_transient_obligation(length: token_count(count: 262144))] }
      let standing = arm_memory_fit_whole_standing(
        cache: cache,
        prefill: PrefillTransientFitUnestablished { obligations: [arm_prefill_transient_obligation(length: token_count(count: 262144))] },
        arm: arm,
        subject_length: token_count(count: 262144))
      frontier_proves_eight
        && (match cache {
          CacheFitProved { limiting_rank: _, seats: s, length: _, blocks_per_seat: _, blocks_used: _, blocks_reserved: _, hard_ceiling: _, block_equivalent_bytes: be } =>
            s == 6 && (match be {
              Absent => true
              Present { value: _ } => false
            })
          _ => false
        })
        && (match standing.arm_verdict {
          ArmMemoryFitUnestablished { obligations: _ } => true
          _ => false
        })
        && any(standing.open_obligations, o => string_contains(s: o as String, pattern: "prefill-transient-fit"))
  }
}

// ── THE V2 CAPTURE AT THE 1012-BLOCK INVENTORY: THE VERDICT AND THE FRONTIER ──────────────────────
