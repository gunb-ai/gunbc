// ── THE DIRECT ROSTER FOLD OVER THE REAL 262144x6 CAPTURE, CORRECTED TO THE SHARED-POOL MODEL ────
//
// THE SUBJECT is the allocation plan the patched engine printed at the bounded 262144x6
// experiment's launch (2026-09-25, engine self-report 0.1.dev1+g8d09804c8, the capture committed
// verbatim beside the shared fixture module and imported as real_262144x6_kv_plan_line), priced
// against the four KV arenas the completing launch read (2026-09-26, the per-rank readback
// bracket, gunbc.spark.arm_memory_experiment_observed's second bundle) — the cross-launch
// composition that bundle names as the designed completion: one experiment, two launches. THE
// BLOCK DEMAND THE REAL BYTES PRICE: group-0 (mla_attention, the 11 sparse layers' k_cache +
// attn) 114 blocks, group-1 (the sparse-indexer tail, window 4) 1 block, the four mamba groups
// (34 KDA layers) 2 blocks each — 123 shared-pool blocks per full-context seat, 738 for six.
//
// THE SHARED-POOL BYTE CORRECTION (docs/plans/shared-pool-byte-correction.md, owner directive
// 2026-09-26) is the standing this suite witnesses: the fold's capacity wall is the BLOCK wall
// alone; the withdrawn byte wall (the sum of blocks x group-spec page bytes against arenas — the
// 125,010,432-byte figure, ~106x under the block-equivalent spelling) has no arm here. The real
// capture is the v1 emission vintage: it carries no physical_pool_bytes_per_block or
// allocated_pool_bytes, so a Proved mints with block_equivalent_bytes ABSENT — blocks proven, no
// byte conservation claimed. The conservation RED over the withdrawn figure, the per-rank
// pool-construction controls, the reserve-policy ladder, and the whole-arm standing are
// witnessed below.

fn w_minted_real_plan() -> ResolvedKvAllocationPlan? {
  match kv_allocation_plan_capture_from_startup_log(captured_stdout: real_262144x6_kv_plan_line) {
    KvPlanCaptureUnreadable { cause: _ } => none
    KvPlanCaptureParsed { capture: c } =>
      match resolved_kv_allocation_plan_from_capture(capture: c) {
        KvAllocationPlanRefused { cause: _ } => none
        KvAllocationPlanAdmitted { plan: p } => Present { value: p }
      }
  }
}

fn w_plan_at_revision(p: ResolvedKvAllocationPlan, rev: VllmSourceRevision) -> ResolvedKvAllocationPlan {
  ResolvedKvAllocationPlan {
    runtime: rev,
    image_digest: p.image_digest,
    cache_format: p.cache_format,
    allocator_blocks: p.allocator_blocks,
    physical_pool_bytes_per_block: p.physical_pool_bytes_per_block,
    allocated_pool_bytes: p.allocated_pool_bytes,
    requested_length: p.requested_length,
    scheduler_block_size: p.scheduler_block_size,
    groups: p.groups,
    grouping_padding: p.grouping_padding,
  }
}

fn w_group_minus_one_identity(g: KvAllocationPlanGroup) -> KvAllocationPlanGroup {
  KvAllocationPlanGroup {
    identity: g.identity,
    kind: g.kind,
    layer_identities: skip(g.layer_identities, 1),
    block_size: g.block_size,
    group_spec_page_size_bytes: g.group_spec_page_size_bytes,
    tokens_per_state: g.tokens_per_state,
    max_memory_usage_bytes: g.max_memory_usage_bytes,
    blocks_at_requested_length: g.blocks_at_requested_length,
  }
}

fn w_plan_with_thinned_kda(p: ResolvedKvAllocationPlan) -> ResolvedKvAllocationPlan {
  ResolvedKvAllocationPlan {
    runtime: p.runtime,
    image_digest: p.image_digest,
    cache_format: p.cache_format,
    allocator_blocks: p.allocator_blocks,
    physical_pool_bytes_per_block: p.physical_pool_bytes_per_block,
    allocated_pool_bytes: p.allocated_pool_bytes,
    requested_length: p.requested_length,
    scheduler_block_size: p.scheduler_block_size,
    groups: map(p.groups, g => match g.kind {
      MambaState => w_group_minus_one_identity(g: g)
      _ => g
    }),
    grouping_padding: p.grouping_padding,
  }
}

fn w_uniform_supplies(blocks: Nat, arena: ByteSize) -> List<ArmRankCacheSupply> {
  map(nat_range_inclusive(lo: 1, hi: 4), i => ArmRankCacheSupply {
    rank: i - 1,
    allocator_blocks: allocator_block_count(count: blocks),
    admitted_kv_arena_bytes: arena,
  })
}

// THE ROSTER BINDS THE EXACT MODEL on the real bytes: the census (34 KDA entries across the mamba
// groups, 11 indexer.k_cache + 11 attn entries in the mla_attention group, 11 tail_cache entries
// in the sliding-window group) holds against glm_5_3_flash_hybrid_shape, so no roster obligation
// fires — and the thinned variant, one identity dropped from every mamba group, refuses naming
// the recurrent population. A proof at one roster says nothing at another.
test fn the_real_plan_roster_binds_the_exact_model() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4, limiting_rank: 0, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, blocks_reserved: br, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 0
            && s == 6
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: bu) == 738
            && allocator_block_count_value(c: br) == 0
            && hc == 8
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: w_plan_with_thinned_kda(p: p), shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
          rank_count: 4, limiting_rank: 0, reserve_policy: NoOperationalReserve) {
          CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "recurrent-layer entries"))
          _ => false
        })
  }
}

// A PLAN FROM ANOTHER REVISION IS A DIFFERENT ENGINE'S ROSTER: the retired 1967a5627 stamp
// refuses at the fold's revision wall naming both revisions — the wall-law flip the advance
// landed, here at the fold itself.
test fn a_pre_patch_revision_plan_refuses_at_the_roster_wall() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: w_plan_at_revision(p: p, rev: vllm_source_revision_1967a5627), shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4, limiting_rank: 0, reserve_policy: NoOperationalReserve) {
        CacheFitUnestablished { obligations: os } =>
          any(os, o => string_contains(s: o as String, pattern: "1967a5627bc3710b680bbec24ecb99aaddedf22b"))
        _ => false
      }
  }
}

// ZERO SEATS NAMES NO ADMISSION: the malformed question is an obligation, not a vacuous proof
// over a zero demand.
test fn zero_seats_name_no_admission() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 0,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4, limiting_rank: 0, reserve_policy: NoOperationalReserve) {
        CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "zero seats name no admission"))
        _ => false
      }
  }
}

// THE COMPLETING RUN'S FOUR ARENAS PROVE SIX SEATS AT THE LIMITING RANK: the real evidence
// (gunbc.spark.arm_memory_experiment_observed's 2026-09-26 bundle: TP0/srv9 23.45, TP1/srv10
// 18.62, TP2/srv12 18.90, TP3/srv11 17.29 GiB at the hundredths floor) prices the block wall —
// 6 x 123 = 738 of 1035 blocks — and the verdict carries the bundle's own limiting rank (3), so
// the evidence and the verdict cannot drift apart silently; the bundle's rank-3 reading is
// pinned here as srv11's 17.29 GiB floor (18,564,996,136 bytes), the arena the doctrine's
// reconciliation reads. The v1 plan's block_equivalent_bytes rides Absent: blocks proven, no
// byte conservation claimed.
test fn the_completing_run_evidence_proves_six_seats_at_the_limiting_rank() -> Bool {
  (match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)),
        rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, blocks_reserved: br, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3
            && lr == arm_experiment_2026_09_26_limiting_rank
            && s == 6
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: bu) == 738
            && allocator_block_count_value(c: br) == 0
            && hc == 8
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      }
  })
    && (match first(filter(arm_experiment_2026_09_26_arena_readings, r => r.rank == arm_experiment_2026_09_26_limiting_rank)) {
      Present { value: tp3 } =>
        tp3.host == "srv11" as NonEmptyStr
          && tp3.kv_arena_hundredths_gib == 1729
          && byte_size_count(b: arm_experiment_gib_hundredths_floor(hundredths: tp3.kv_arena_hundredths_gib)) == 18564996136
      Absent => false
    })
}

// THE CONSERVATION CONTROL GENERALIZED INTO EVERY POSITION: drop any one of the four arenas
// (the zero spelling of unobserved) and the fold falls back to CacheFitUnestablished naming
// EXACTLY that rank — the three-unobserved-arenas verdict of 2026-09-25 held in all four
// positions, so a future capture gap is named at the rank that produced it.
test fn dropping_any_one_arena_falls_back_to_unestablished_naming_that_rank() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      w_drop_one_arena_names_that_rank(p: p, dropped: 0)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 1)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 2)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 3)
  }
}

fn w_drop_one_arena_names_that_rank(p: ResolvedKvAllocationPlan, dropped: Nat) -> Bool {
  match cache_fit_verdict_from_plan(
    plan: p, shape: glm_5_3_flash_hybrid_shape,
    seats: 6,
    supplies: map(arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035)), s =>
      match s.rank == dropped {
        true => ArmRankCacheSupply { rank: s.rank, allocator_blocks: s.allocator_blocks, admitted_kv_arena_bytes: byte_size(count: 0) }
        false => s
      }),
    rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
    CacheFitUnestablished { obligations: os } =>
      length(os) == 1
        && any(os, o => string_contains(s: o as String, pattern: join(["rank ", to_string(dropped), " carries a zero"], "")))
    _ => false
  }
}

// THE LIMITING RANK IS EVIDENCE, AND OUT-OF-ROSTER EVIDENCE NAMES NO RANK: the verdict carries
// the rank the bundle binds (TP3, the engine's min across ranks already applied to the uniform
// inventory), and a limiting rank the topology does not contain is an obligation, not a proof at
// no rank.
test fn the_limiting_rank_is_carried_and_out_of_roster_evidence_refuses() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: arm_experiment_2026_09_26_limiting_rank, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3 && s == 6 && hc == 8 && allocator_block_count_value(c: bu) == 738
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 4, reserve_policy: NoOperationalReserve) {
          CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "outside the 4-rank topology"))
          _ => false
        })
  }
}

// THE BLOCK WALL DECIDES WITHOUT READING THE ARENAS: six seats at 738 of the plan's 1035-block
// inventory prove on every rank at the block wall alone — the arenas in the supply rows bound
// nothing here (bytes verify pool construction, never capacity), which is the correction.
test fn six_seats_prove_at_the_block_wall_on_the_real_plan() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, length: l, blocks_per_seat: bps, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3
            && s == 6
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
            && token_count_value(t: l) == 262144
            && allocator_block_count_value(c: bps) == 123
            && allocator_block_count_value(c: bu) == 738
            && hc == 8
        _ => false
      }
  }
}

// THE BLOCK ARITHMETIC, PINNED END TO END: 6 seats x 123 blocks = 738 of 1035 — slack 297
// blocks; the ceiling is floor(1035 / 123) = 8 seats (8 x 123 = 984 <= 1035, slack 51), and the
// ninth seat refuses at 1107 > 1035. The block wall is the binding constraint at every seat
// count, and the reserve column of the doctrine's frontier table (28.70%, 16.81%, 4.93% of the
// inventory left) is blocks_left / 1035, priced by the frontier fold below.
test fn the_block_ceiling_is_eight_and_the_ninth_seat_refuses() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 8,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, hard_ceiling: hc, block_equivalent_bytes: be } =>
          lr == 3 && s == 8 && allocator_block_count_value(c: bu) == 984 && hc == 8
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 9,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: NoOperationalReserve) {
          CacheFitRefused { limiting_rank: lr, seats: s, blocks_per_seat: bps, blocks_used: bu, supply_allocator_blocks: sb, cause: _ } =>
            lr == 0 && s == 9 && allocator_block_count_value(c: bps) == 123
              && allocator_block_count_value(c: bu) == 1107
              && allocator_block_count_value(c: sb) == 1035
          _ => false
        })
        && 1035 - 738 == 297
        && 8 * 123 == 984
        && 1035 - 984 == 51
        && 9 * 123 == 1107
  }
}

// THE REQUEST-COST VERDICT IS THE EXACT ROSTER: the plan's six groups and their summed
// blocks_at_requested_length — 123 shared-pool blocks per full-context request, the
// KvAdmissionDemand of one seat. The group's spec pages price the LOGICAL per-group charge
// (blocks_at x group_spec_page_size_bytes = max_memory_usage_bytes, the figure that reproduces
// the printed 8.41x); they never sum into a byte demand — that sum was the withdrawn figure.
test fn the_request_block_cost_is_the_exact_roster() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match request_block_cost(plan: p) {
        RequestBlockCostProved { group_roster: roster, blocks_per_request: bpr } =>
          length(roster) == 6 && allocator_block_count_value(c: bpr) == 123
        RequestBlockCostRefused { cause: _ } => false
      }
  }
}

// THE ADMISSION VERDICT PRICES THE POPULATION AGAINST THE USABLE INVENTORY, RESERVE FIRST: with
// the first production reserve candidate (one full-length seat = 123 blocks) the usable inventory
// is 912 blocks — six (738) and seven (861) admit, eight (984) refuses at the reserve, and nine
// refuses at the bare wall. The reserve is a standing, not a capacity fact: NoOperationalReserve
// admits eight (984 <= 1035).
test fn cache_admission_respects_the_reserve_policy() -> Bool {
  (match cache_admission_verdict(population_blocks: allocator_block_count(count: 738), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
    CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
      allocator_block_count_value(c: r) == 738 && allocator_block_count_value(c: u) == 912
    CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
  })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 861), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
      CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
        allocator_block_count_value(c: r) == 861 && allocator_block_count_value(c: u) == 912
      CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
    })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 984), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 123)) {
      CacheAdmissionRefused { request_blocks: r, usable_allocator_blocks: u, cause: _ } =>
        allocator_block_count_value(c: r) == 984 && allocator_block_count_value(c: u) == 912
      CacheAdmissionProved { request_blocks: _, usable_allocator_blocks: _ } => false
    })
    && (match cache_admission_verdict(population_blocks: allocator_block_count(count: 984), inventory: allocator_block_count(count: 1035), reserve_blocks: allocator_block_count(count: 0)) {
      CacheAdmissionProved { request_blocks: r, usable_allocator_blocks: u } =>
        allocator_block_count_value(c: r) == 984 && allocator_block_count_value(c: u) == 1035
      CacheAdmissionRefused { request_blocks: _, usable_allocator_blocks: _, cause: _ } => false
    })
}

// THE RESERVE POLICY IS CARRIED IN THE VERDICT, BLOCKS ONLY: ReserveFullLengthSeats{1} holds 123
// blocks back (1 x 123), ReserveBlocks{297} holds an explicit count, ReserveBasisPoints{2870}
// holds 2870bp of 1035 = 297 blocks (the six-seat standing reserve: 297 of 1035 blocks left at
// six seats is 28.70% of the inventory, the conservative restoration point's reserve). No byte
// figure rides a reserve: it is a block standing.
test fn the_reserve_policy_is_carried_in_blocks_in_the_verdict() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4, limiting_rank: 3, reserve_policy: ReserveFullLengthSeats { seats: 1 }) {
        CacheFitProved { limiting_rank: lr, seats: s, blocks_used: bu, blocks_reserved: br, block_equivalent_bytes: be } =>
          lr == 3 && s == 6 && allocator_block_count_value(c: bu) == 738 && allocator_block_count_value(c: br) == 123
            && (match be {
              Absent => true
              Present { value: _ } => false
            })
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: ReserveBlocks { blocks: allocator_block_count(count: 297) }) {
          CacheFitProved { limiting_rank: lr, seats: s, blocks_reserved: br } =>
            lr == 3 && s == 6 && allocator_block_count_value(c: br) == 297
          _ => false
        })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4, limiting_rank: 3, reserve_policy: ReserveBasisPoints { basis_points: 2870 }) {
          CacheFitProved { limiting_rank: lr, seats: s, blocks_reserved: br } =>
            lr == 3 && s == 6 && allocator_block_count_value(c: br) == 297
          _ => false
        })
  }
}

// THE HEADROOM FIGURES, PINNED: the printed pool is a full-context-equivalent projection —
// 1035 blocks over a 123-block request is 8.4146 requests, and 8.4146 x 262,144 tokens =
// 2,205,845 tokens, the printed line — so the printed candidate reads floor(2,205,845 / 262,144)
// = 8 seats, and the direct fold AGREES with the candidate at the floor (8 x 123 = 984 <= 1035).
// The declared six seats hold 1,572,864 tokens, leaving 632,981 printed tokens (≈ 2.4 seats) and
// 297 blocks (≈ 2 seats by the fold) of slack. The candidate stays what it is — a sizing hint no
// verdict consumes — and the fold stays the only proof.
test fn the_headroom_figures_are_pinned() -> Bool {
  (match cache_capacity_candidate(printed_pool_tokens: token_count(count: 2205845), division_length: token_count(count: 262144)) {
    Present { value: c } => c.seats_by_division == 8
    Absent => false
  })
    && 2205845 - 6 * 262144 == 632981
    && 262144 * 6 == 1572864
}

