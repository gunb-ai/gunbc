// ── THE DIRECT ROSTER FOLD OVER THE REAL 262144x6 CAPTURE ────────────────────────────────────────
//
// THE SUBJECT is the allocation plan the patched engine printed at the bounded 262144x6
// experiment's first launch (2026-09-25, engine self-report 0.1.dev1+g8d09804c8, the capture
// committed verbatim beside the shared fixture module and imported as real_262144x6_kv_plan_line).
// The plan minted off those bytes IS the exact group roster the doctrine required — 6 allocation
// groups rostering the model's 67 layer identities over 45 layers, with the engine's own
// blocks_at_requested_length per group — and gunbc.spark.arm_memory_fit's
// cache_fit_verdict_from_plan prices it: seats x the plan's own figures against every rank's
// allocator evidence. THE DEMAND THE REAL BYTES PRICE: group-0 (mla_attention, the 11 sparse
// layers' k_cache + attn) 114 blocks x 76032 bytes = 8,667,648; group-1 (the sparse-indexer tail,
// window 4) 1 block x 76032 = 76,032; the four mamba groups (34 KDA layers) 2 blocks each x
// 1511424 = 3,022,848 apiece — 123 blocks and 20,835,072 bytes per full-context seat.
//
// THE VERDICT ON TODAY'S EVIDENCE. The first launch's stop legs fired ~35 seconds after the
// head's anchor, before ranks 1-3 printed their own profile lines, and the fold on that evidence
// was CacheFitUnestablished naming exactly the three uncaptured arenas (commit 0fd1d463f5). THE
// COMPLETING LAUNCH (2026-09-26 — the same bounded experiment re-run with the per-rank readback
// bracket, all four rank profile lines at gpu_worker.py:867 captured into the one receipt) IS
// today's evidence: gunbc.spark.arm_memory_experiment_observed's 2026-09-26 bundle binds the four
// KV arenas as observed intervals at the 262144x6 subject — TP0/srv9 23.45 GiB, TP1/srv10 18.62
// GiB, TP2/srv12 18.90 GiB, TP3/srv11 17.29 GiB — and the fold over them PROVES six seats. The
// block wall decides on the plan's 1035-block inventory on every rank (6 x 123 = 738), and the
// byte wall decides per rank against the observed arena: 6 x 20,835,072 = 125,010,432 bytes is
// 67 basis points — 0.67% — even of the worst rank's arena floor (TP3/srv11's 17.29 GiB reads
// 18,564,996,136 bytes at the hundredths floor), and no other rank reads lower. The verdict is
// CacheFitProved { rank: 3, seats: 6 } with the worst-rank headroom carried, and the conservation
// control below pins that the proof is the four arenas TOGETHER: drop any one and the fold falls
// back to CacheFitUnestablished naming exactly that rank. The cross-launch composition (the plan
// from the first launch, the arenas from the completing launch) is the designed completion commit
// 0fd1d463f5 pinned — one experiment, two launches, the second admitted only to capture what the
// first one's early stop legs missed — not a pairing any consumer may generalize.

fn w_minted_real_plan() -> ResolvedKvAllocationPlan? {
  match kv_allocation_plan_capture_from_startup_log(captured_stdout: real_262144x6_kv_plan_line) {
    KvPlanCaptureUnreadable { cause: _ } => none
    KvPlanCaptureParsed { capture: c } =>
      match resolved_kv_allocation_plan_from_capture(capture: c) {
        KvAllocationPlanRefused { cause: _ } => none
        KvAllocationPlanAdmitted { plan: p } => Present { value: p }
      }
  }
}

fn w_plan_at_revision(p: ResolvedKvAllocationPlan, rev: VllmSourceRevision) -> ResolvedKvAllocationPlan {
  ResolvedKvAllocationPlan {
    runtime: rev,
    image_digest: p.image_digest,
    cache_format: p.cache_format,
    allocator_blocks: p.allocator_blocks,
    requested_length: p.requested_length,
    scheduler_block_size: p.scheduler_block_size,
    groups: p.groups,
    grouping_padding: p.grouping_padding,
  }
}

fn w_group_minus_one_identity(g: KvAllocationPlanGroup) -> KvAllocationPlanGroup {
  KvAllocationPlanGroup {
    identity: g.identity,
    kind: g.kind,
    layer_identities: skip(g.layer_identities, 1),
    block_size: g.block_size,
    page_size_bytes: g.page_size_bytes,
    tokens_per_state: g.tokens_per_state,
    max_memory_usage_bytes: g.max_memory_usage_bytes,
    blocks_at_requested_length: g.blocks_at_requested_length,
  }
}

fn w_plan_with_thinned_kda(p: ResolvedKvAllocationPlan) -> ResolvedKvAllocationPlan {
  ResolvedKvAllocationPlan {
    runtime: p.runtime,
    image_digest: p.image_digest,
    cache_format: p.cache_format,
    allocator_blocks: p.allocator_blocks,
    requested_length: p.requested_length,
    scheduler_block_size: p.scheduler_block_size,
    groups: map(p.groups, g => match g.kind {
      MambaState => w_group_minus_one_identity(g: g)
      _ => g
    }),
    grouping_padding: p.grouping_padding,
  }
}

fn w_uniform_supplies(blocks: Nat, arena: ByteSize) -> List<ArmRankCacheSupply> {
  map(nat_range_inclusive(lo: 1, hi: 4), i => ArmRankCacheSupply {
    rank: i - 1,
    allocator_blocks: allocator_block_count(count: blocks),
    admitted_kv_arena_bytes: arena,
  })
}

// TODAY'S EVIDENCE, one row per rank: the plan's 1035-block inventory on every rank (the
// engine-derived launch-level figure) joined with the completing launch's four observed arenas —
// projected by the observation bundle itself (arm_experiment_2026_09_26_cache_supplies), one
// authority for the readings, at the hundredths floor the supply spelling has carried since
// commit 0fd1d463f5.
fn w_four_arena_supplies() -> List<ArmRankCacheSupply> {
  arm_experiment_2026_09_26_cache_supplies(allocator_blocks: allocator_block_count(count: 1035))
}

// THE ROSTER BINDS THE EXACT MODEL on the real bytes: the census (34 KDA entries across the mamba
// groups, 11 indexer.k_cache + 11 attn entries in the mla_attention group, 11 tail_cache entries
// in the sliding-window group) holds against glm_5_3_flash_hybrid_shape, so no roster obligation
// fires — and the thinned variant, one identity dropped from every mamba group, refuses naming
// the recurrent population. A proof at one roster says nothing at another.
test fn the_real_plan_roster_binds_the_exact_model() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4) {
        CacheFitProved { rank: _, seats: s, length: l, demand_bytes: _, headroom_bytes: _ } =>
          s == 6 && token_count_value(t: l) == 262144
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: w_plan_with_thinned_kda(p: p), shape: glm_5_3_flash_hybrid_shape,
          seats: 6,
          supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
          rank_count: 4) {
          CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "recurrent-layer entries"))
          _ => false
        })
  }
}

// A PLAN FROM ANOTHER REVISION IS A DIFFERENT ENGINE'S ROSTER: the retired 1967a5627 stamp
// refuses at the fold's revision wall naming both revisions — the wall-law flip the advance
// landed, here at the fold itself.
test fn a_pre_patch_revision_plan_refuses_at_the_roster_wall() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: w_plan_at_revision(p: p, rev: vllm_source_revision_1967a5627), shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4) {
        CacheFitUnestablished { obligations: os } =>
          any(os, o => string_contains(s: o as String, pattern: "1967a5627bc3710b680bbec24ecb99aaddedf22b"))
        _ => false
      }
  }
}

// ZERO SEATS NAMES NO ADMISSION: the malformed question is an obligation, not a vacuous proof
// over a zero demand.
test fn zero_seats_name_no_admission() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 0,
        supplies: w_uniform_supplies(blocks: 2000000, arena: byte_size(count: 30000000000)),
        rank_count: 4) {
        CacheFitUnestablished { obligations: os } => any(os, o => string_contains(s: o as String, pattern: "zero seats name no admission"))
        _ => false
      }
  }
}

// THE PROOF ON THE COMPLETED EVIDENCE: the byte wall now proves on EVERY rank — 125,010,432 bytes
// is 67 basis points of the worst arena (TP3/srv11's 17.29 GiB floor, 18,564,996,136 bytes) and
// less everywhere else — and the block wall was already proved on every rank (6 x 123 = 738 of
// 1035). The verdict is CacheFitProved naming the limiting rank (rank 3) with the worst-rank
// headroom carried: 18,564,996,136 - 125,010,432 = 18,439,985,704 bytes.
test fn the_four_arena_evidence_proves_six_seats_at_the_limiting_rank() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_four_arena_supplies(),
        rank_count: 4) {
        CacheFitProved { rank: r, seats: s, length: l, demand_bytes: d, headroom_bytes: h } =>
          r == 3
            && s == 6
            && token_count_value(t: l) == 262144
            && byte_size_count(b: d) == 125010432
            && byte_size_count(b: h) == 18439985704
        _ => false
      }
  }
}

// THE CONSERVATION LAW, DISCRIMINATING: the proof is the four arenas TOGETHER. Drop any one
// arena — spell it zero, the supply side's own spelling of unobserved — and the fold falls back
// to CacheFitUnestablished naming EXACTLY that rank and no other: a missing rank is an unnamed
// obligation, never a generous reading, in every one of the four positions. This is the
// three-unobserved-arenas verdict of 2026-09-25 generalized into a control that must hold on
// any rank's evidence, and it pins that the Proved verdict above consumes all four arenas.
test fn dropping_any_one_arena_falls_back_to_unestablished_naming_that_rank() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      w_drop_one_arena_names_that_rank(p: p, dropped: 0)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 1)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 2)
        && w_drop_one_arena_names_that_rank(p: p, dropped: 3)
  }
}

fn w_drop_one_arena_names_that_rank(p: ResolvedKvAllocationPlan, dropped: Nat) -> Bool {
  match cache_fit_verdict_from_plan(
    plan: p, shape: glm_5_3_flash_hybrid_shape,
    seats: 6,
    supplies: map(w_four_arena_supplies(), s => ArmRankCacheSupply {
      rank: s.rank,
      allocator_blocks: s.allocator_blocks,
      admitted_kv_arena_bytes: match s.rank == dropped {
        true => byte_size(count: 0)
        false => s.admitted_kv_arena_bytes
      },
    }),
    rank_count: 4) {
    CacheFitUnestablished { obligations: os } =>
      length(os) == 1
        && any(os, o => string_contains(s: o as String, pattern: join(["rank ", to_string(dropped), " carries a zero"], "")))
    _ => false
  }
}

// THE BYTE HEADROOM BLOCK, PINNED PER RANK: the six-seat demand (125,010,432 bytes) against each
// rank's arena floor as admitted into the fold — TP0/srv9 49 basis points of it, TP1/srv10 62,
// TP2/srv12 61, TP3/srv11 67 — and the headroom the Proved verdict carries: 18,439,985,704 bytes,
// 9,932 basis points (99.33%) of the worst arena left after the demand. The shares are computed
// against the supplies the observation bundle projects — the evidence, not a re-spelled literal —
// and the reporter's rounding unit cannot move any of it: 0.01 GiB is about 10.7 MB against a
// headroom of about 18.44 GB. The block wall's slack (297 blocks, about two seats), the ceiling
// (floor(1035 / 123) = 8, the ninth seat refusing at 1107), and the printed-token figures are
// pinned beside this at the_block_ceiling_is_eight_and_the_ninth_seat_refuses and
// the_headroom_figures_are_pinned.
test fn the_byte_headroom_block_is_pinned_per_rank() -> Bool {
  let supplies = w_four_arena_supplies()
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: supplies,
        rank_count: 4) {
        CacheFitProved { rank: r, seats: _, length: _, demand_bytes: d, headroom_bytes: h } =>
          r == 3
            && byte_size_count(b: d) == 125010432
            && byte_size_count(b: h) == 18439985704
            && w_bytes_share_bp(supplies: supplies, rank: 0, of: d) == 49
            && w_bytes_share_bp(supplies: supplies, rank: 1, of: d) == 62
            && w_bytes_share_bp(supplies: supplies, rank: 2, of: d) == 61
            && w_bytes_share_bp(supplies: supplies, rank: 3, of: d) == 67
            && w_bytes_share_bp(supplies: supplies, rank: 3, of: h) == 9932
        _ => false
      }
  }
}

// THE DEMAND'S SHARE OF ONE RANK'S ARENA in basis points, floor-divided against the arena floor
// the observation bundle admits into the fold: floor(of x 10000 / arena floor). The absurd
// sentinel on a missing rank is a witness refusal, not a generous zero.
fn w_bytes_share_bp(supplies: List<ArmRankCacheSupply>, rank: Nat, of: ByteSize) -> Nat {
  match first(filter(supplies, s => s.rank == rank)) {
    Present { value: s } => byte_size_count(b: of) * 10000 / byte_size_count(b: s.admitted_kv_arena_bytes)
    Absent => 1000000000
  }
}

// THE LIMITING RANK, PINNED TWICE OVER: the observation bundle names rank 3 and this suite names
// its host — TP3/srv11, the smallest arena at the readback bracket (17.29 GiB) — and the rank's
// floor is the least of the four supplies. A drift between the observation's limiting rank and
// the fold's worst-rank corner is red here, at the row that moved.
test fn the_limiting_rank_is_tp3_on_srv11() -> Bool {
  let supplies = w_four_arena_supplies()
  arm_experiment_2026_09_26_limiting_rank == 3
    && (match first(filter(arm_experiment_2026_09_26_arena_readings, x => x.rank == arm_experiment_2026_09_26_limiting_rank)) {
      Present { value: reading } => reading.host as String == "srv11"
      Absent => false
    })
    && (match first(filter(supplies, s => s.rank == arm_experiment_2026_09_26_limiting_rank)) {
      Present { value: worst } =>
        all(supplies, s => byte_size_count(b: s.admitted_kv_arena_bytes) >= byte_size_count(b: worst.admitted_kv_arena_bytes))
      Absent => false
    })
}

// THE WORST-EVER-ARENA FLOOR, STILL PINNED: the 64K run's per-rank bundle read TP3/srv11's KV
// arena at 17.03 GiB — the smallest the arm has ever observed, and STILL the smallest after the
// completing 262144x6 launch (whose own worst is 17.29 GiB). This arm was the designed completion
// commit 0fd1d463f5 pinned while the three arenas stood uncaptured; the real four-arena proof it
// stood in for now lives at the_four_arena_evidence_proves_six_seats_at_the_limiting_rank, and
// this arm stays as the worst-reading floor — nothing about the completion is the sensitive input
// (the demand is 0.68% even of the worst reading the arm has ever taken) and the Proved verdict
// the adoption consumes no longer leans on it.
test fn the_completion_at_the_worst_prior_arena_proves_six_seats() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 6,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4) {
        CacheFitProved { rank: _, seats: s, length: l, demand_bytes: d, headroom_bytes: _ } =>
          s == 6
            && token_count_value(t: l) == 262144
            && byte_size_count(b: d) == 125010432
        _ => false
      }
  }
}

// THE BLOCK ARITHMETIC, PINNED END TO END: 6 seats x 123 blocks = 738 of 1035 — slack 297
// blocks; the ceiling is floor(1035 / 123) = 8 seats (8 x 123 = 984 <= 1035, slack 51), and the
// ninth seat refuses at 1107 > 1035. The byte demand at 8 seats is 166,680,576 — still 0.9% of
// the worst arena — so the block wall is the binding constraint at every seat count through 8.
test fn the_block_ceiling_is_eight_and_the_ninth_seat_refuses() -> Bool {
  match w_minted_real_plan() {
    Absent => false
    Present { value: p } =>
      (match cache_fit_verdict_from_plan(
        plan: p, shape: glm_5_3_flash_hybrid_shape,
        seats: 8,
        supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
        rank_count: 4) {
        CacheFitProved { rank: _, seats: s, length: _, demand_bytes: d, headroom_bytes: _ } =>
          s == 8 && byte_size_count(b: d) == 166680576
        _ => false
      })
        && (match cache_fit_verdict_from_plan(
          plan: p, shape: glm_5_3_flash_hybrid_shape,
          seats: 9,
          supplies: w_uniform_supplies(blocks: 1035, arena: arm_experiment_gib_hundredths_floor(hundredths: 1703)),
          rank_count: 4) {
          CacheFitRefused { rank: _, seats: _, length: _, demand_bytes: _, demand_blocks: db, supply_arena_bytes: _, supply_allocator_blocks: sb, cause: _ } =>
            allocator_block_count_value(c: db) == 1107 && allocator_block_count_value(c: sb) == 1035
          _ => false
        })
        && 1035 - 738 == 297
        && 8 * 123 == 984
        && 1035 - 984 == 51
        && 9 * 123 == 1107
  }
}

// THE HEADROOM FIGURES, PINNED: the printed pool is a full-context-equivalent projection —
// 1035 blocks over a 123-block request is 8.4146 requests, and 8.4146 x 262,144 tokens =
// 2,205,845 tokens, the printed line — so the printed candidate reads floor(2,205,845 / 262,144)
// = 8 seats, and the direct fold AGREES with the candidate at the floor (8 x 123 = 984 <= 1035).
// The declared six seats hold 1,572,864 tokens, leaving 632,981 printed tokens (≈ 2.4 seats) and
// 297 blocks (≈ 2 seats by the fold) of slack. The candidate stays what it is — a sizing hint no
// verdict consumes — and the fold stays the only proof.
test fn the_headroom_figures_are_pinned() -> Bool {
  (match cache_capacity_candidate(printed_pool_tokens: token_count(count: 2205845), division_length: token_count(count: 262144)) {
    Present { value: c } => c.seats_by_division == 8
    Absent => false
  })
    && 2205845 - 6 * 262144 == 632981
    && 262144 * 6 == 1572864
}
