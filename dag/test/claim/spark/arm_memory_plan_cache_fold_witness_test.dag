// correction's vocabulary rides entire: the block wall alone decides capacity; the only byte
// figure minted is block_equivalent_bytes (blocks x the engine's own 13,602,816 pool block); the
// conservation RED still owns the withdrawn 125,010,432-byte claim.

fn w_minted_v2_real_plan() -> ResolvedKvAllocationPlan? {
  match kv_allocation_plan_capture_from_startup_log(captured_stdout: real_262144x6_v2_kv_plan_line) {
    KvPlanCaptureUnreadable { cause: _ } => none
    KvPlanCaptureParsed { capture: c } =>
      match resolved_kv_allocation_plan_from_capture(capture: c) {
        KvAllocationPlanRefused { cause: _ } => none
        KvAllocationPlanAdmitted { plan: p } => Present { value: p }
      }
  }
}

