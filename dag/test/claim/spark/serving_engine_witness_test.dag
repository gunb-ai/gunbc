module test.claim.spark.serving_engine_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { TokenCount, Percent, token_count, percent, PositiveSlotCount, positive_slot_count, positive_measure_count, Millisecond, millisecond }
import extdeps.memory.types { MemoryKind, UnifiedShared, Dram, Hbm }
import extdeps.vllm.engine_args {
  VllmEngineArgs, VllmMemoryUtilization, vllm_memory_utilization,
  VllmKvCacheDtypeRequest, KvFp8,
  VllmDistributedExecutorBackend, ExecutorRay, ExecutorMp, ExecutorExternalLauncher,
  vllm_verified_negatives, vllm_discouraged_args
}
import gunbc.spark.serving_engine {
  OllamaServingLaunchProfile, SparkServingBindListen,
  ServingEngine, OllamaServing, VllmServing, serving_engine_label,
  SparkEngineSlotVerdict, EngineSlotAvailable, EngineSlotRefused,
  SparkEngineSlotRefusal, UnifiedPoolAlreadyOccupied,
  spark_engine_slot_admits,
  MemoryEnforcerKind, RayThresholdMonitor, RayEventMonitor, HostMemGuard, KernelOomKiller,
  DeviceReservationAccounting, CountsReservation, ExcludesReservation, AccountingUnestablished,
  memory_enforcer_device_reservation_accounting,
  EnforcerVerdict, EnforcerAdmitted, EnforcerRefused,
  EnforcerRefusal, NoEnforcerDeclared, MoreThanOneEnforcer,
  DeviceReservationCountingEnforcerOnUnifiedPool,
  UnestablishedReservationAccountingOnUnifiedPool,
  spark_memory_enforcer_admits
}
import extdeps.ollama.api { ollama_default_port }

// THE FIXTURES CARRY NO FLEET FACTS. Every value below is authored here, so a row reds because the
// RULE changed and never because a host row moved underneath it.
data fx_args: VllmEngineArgs = VllmEngineArgs {
  tensor_parallel_size: 2,
  gpu_memory_utilization: vllm_memory_utilization(fraction: percent(count: 82)),
  max_model_len: token_count(count: 262144),
  max_num_seqs: 32,
  kv_cache_dtype: KvFp8,
  distributed_executor_backend: ExecutorRay
}

data fx_vllm: ServingEngine = VllmServing { args: fx_args }

// THE TWO RAY CONFIGURATIONS, SPELLED AS THE FACTORY'S OWN INPUTS. These replace a
// `ray_monitor_disabled: Bool` that every row used to pass. The Bool could not distinguish the two
// ways a threshold monitor stops running from the one way it appears to and does not, so the rows
// below now say which CONFIGURATION they mean and let the citation decide what it builds.
data fx_ray_live_refresh: Millisecond = millisecond(count: 250)
data fx_ray_zero_refresh: Millisecond = millisecond(count: 0)

data fx_ollama: ServingEngine = OllamaServing {
  profile: OllamaServingLaunchProfile {
    bind: SparkServingBindListen { host: "127.0.0.1" as NonEmptyStr, port: ollama_default_port },
    default_context: token_count(count: 1048576),
    serving_slots: positive_slot_count(count: positive_measure_count(predecessor: 3))
  }
}

data fx_guard: MemoryEnforcerKind = HostMemGuard

data fx_ray_monitor: MemoryEnforcerKind = RayThresholdMonitor

fn slot_is_refused_as_occupied(v: SparkEngineSlotVerdict, incumbent: NonEmptyStr, applicant: NonEmptyStr) -> Bool {
  match v {
    EngineSlotAvailable => false
    EngineSlotRefused { cause: c } =>
      match c {
        UnifiedPoolAlreadyOccupied { incumbent: i, applicant: a } => i == incumbent && a == applicant
      }
  }
}

fn slot_is_available(v: SparkEngineSlotVerdict) -> Bool {
  match v {
    EngineSlotAvailable => true
    EngineSlotRefused { cause: _ } => false
  }
}

// ── THE UNIFIED-POOL REFUSAL, AND ITS SCOPE ────────────────────────────────────────────────────

// RED. A second engine on an occupied unified pool must refuse, and must NAME BOTH SIDES: a bare
// refusal tells an operator that something collided and nothing about which launcher to stop.
test fn w_a_second_engine_on_a_unified_pool_refuses_and_names_both() -> Bool {
  slot_is_refused_as_occupied(
    v: spark_engine_slot_admits(memory_kind: UnifiedShared, incumbent: Present { value: fx_ollama }, applicant: fx_vllm),
    incumbent: "ollama" as NonEmptyStr, applicant: "vllm" as NonEmptyStr)
    && slot_is_refused_as_occupied(
      v: spark_engine_slot_admits(memory_kind: UnifiedShared, incumbent: Present { value: fx_vllm }, applicant: fx_ollama),
      incumbent: "vllm" as NonEmptyStr, applicant: "ollama" as NonEmptyStr)
}

// CONTROL. An EMPTY unified pool admits. Without this the refusal above would be satisfied by a rule
// that refuses every unified-memory host unconditionally, which would be a wall against deployment
// rather than against co-tenancy.
test fn w_an_empty_unified_pool_admits() -> Bool {
  slot_is_available(v: spark_engine_slot_admits(memory_kind: UnifiedShared, incumbent: Absent, applicant: fx_vllm))
}

// CONTROL, AND IT IS THE ONE THAT KEEPS THE RULE HONEST RATHER THAN UNIVERSAL. A discrete-memory host
// genuinely arbitrates two engines through the driver, so co-tenancy there is not this rule's
// subject. A rule that refused Dram and Hbm too would be over-broad in a way no fleet row could
// currently falsify, because the fleet has no discrete-memory serving host to notice it.
test fn w_discrete_memory_hosts_are_outside_this_refusal() -> Bool {
  slot_is_available(v: spark_engine_slot_admits(memory_kind: Dram, incumbent: Present { value: fx_ollama }, applicant: fx_vllm))
    && slot_is_available(v: spark_engine_slot_admits(memory_kind: Hbm, incumbent: Present { value: fx_ollama }, applicant: fx_vllm))
}

// ── THE ENFORCER RULE ──────────────────────────────────────────────────────────────────────────

// THE KIND IS PART OF THE CLAIM, SO THE HELPER READS IT. This function used to discard the refusal's
// `kind` with a wildcard and compare only the cause. That is what let a live EVENT monitor be
// reported as `DeviceReservationCountingEnforcerOnUnifiedPool { kind: RayThresholdMonitor }` and
// still go green: the row proved that SOME counting refusal fired, never that the refusal named the
// mechanism actually present. A wildcard in an oracle is the oracle declining to check the field.
fn enforcer_kind_tag(k: MemoryEnforcerKind) -> NonEmptyStr {
  match k {
    RayThresholdMonitor => "ray_threshold" as NonEmptyStr
    RayEventMonitor => "ray_event" as NonEmptyStr
    HostMemGuard => "host_guard" as NonEmptyStr
    KernelOomKiller => "kernel_oom" as NonEmptyStr
  }
}

fn enforcer_refused_with(v: EnforcerVerdict, wanted: NonEmptyStr) -> Bool {
  match v {
    EnforcerAdmitted { enforcer: _ } => false
    EnforcerRefused { cause: c } =>
      match c {
        NoEnforcerDeclared => wanted == "none" as NonEmptyStr
        MoreThanOneEnforcer { count: _ } => false
        DeviceReservationCountingEnforcerOnUnifiedPool { kind: k } =>
          wanted == (concat("counts:", enforcer_kind_tag(k: k) as String) as NonEmptyStr)
        UnestablishedReservationAccountingOnUnifiedPool { kind: k } =>
          wanted == (concat("unestablished:", enforcer_kind_tag(k: k) as String) as NonEmptyStr)
      }
  }
}

// THE COUNT IS PART OF THE CLAIM TOO, SO IT HAS ITS OWN ORACLE. `enforcer_refused_with` matched
// `MoreThanOneEnforcer { count: _ }` and answered on the cause alone, which would have accepted a
// refusal reporting ANY number of enforcers -- including one, which is not "more than one" and would
// mean the population arithmetic had broken. The count is the whole content of that cause, so a row
// asserting it must read it. Rows that mean "two enforcers" now say two.
fn enforcer_refused_as_many(v: EnforcerVerdict, wanted_count: Nat) -> Bool {
  match v {
    EnforcerAdmitted { enforcer: _ } => false
    EnforcerRefused { cause: c } =>
      match c {
        NoEnforcerDeclared => false
        DeviceReservationCountingEnforcerOnUnifiedPool { kind: _ } => false
        UnestablishedReservationAccountingOnUnifiedPool { kind: _ } => false
        MoreThanOneEnforcer { count: n } => n == wanted_count
      }
  }
}

fn accounting_is(a: DeviceReservationAccounting, wanted: NonEmptyStr) -> Bool {
  match a {
    CountsReservation => wanted == "counts" as NonEmptyStr
    ExcludesReservation => wanted == "excludes" as NonEmptyStr
    AccountingUnestablished => wanted == "unestablished" as NonEmptyStr
  }
}

fn enforcer_admitted(v: EnforcerVerdict) -> Bool {
  match v {
    EnforcerAdmitted { enforcer: _ } => true
    EnforcerRefused { cause: _ } => false
  }
}

// RED. No declared enforcer is a refusal, not a default. An undeclared enforcer still EXISTS on the
// host; what is missing is anyone's knowledge of its threshold.
test fn w_no_declared_enforcer_refuses() -> Bool {
  enforcer_refused_with(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [], resource_isolation_enabled: false, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorMp),
    wanted: "none" as NonEmptyStr)
}

// RED. Two enforcers refuse, and the count is carried. This is the measured incident: two enforcers
// with different definitions of "used", the lower one unable to fire first.
test fn w_two_enforcers_refuse_rather_than_layering() -> Bool {
  enforcer_refused_as_many(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_guard, fx_ray_monitor], resource_isolation_enabled: false, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorMp),
    wanted_count: 2)
}

// RED, AND THIS IS THE ROW THAT USED TO NAME THE WRONG FACT. A Ray launch on a unified pool with
// NOTHING declared refused as `NoEnforcerDeclared` while the monitor Ray brings was live the whole
// time -- a true sentence about the declaration and a false one about the host. The implied monitor
// is now a member of the population, so the refusal names what is actually counting.
test fn w_a_live_ray_monitor_on_a_unified_pool_refuses() -> Bool {
  enforcer_refused_with(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [], resource_isolation_enabled: true, monitor_refresh: fx_ray_live_refresh, backend: ExecutorRay),
    wanted: "counts:ray_threshold" as NonEmptyStr)
}

// RED. THE SAME REFUSAL WHEN THE MONITOR IS DECLARED RATHER THAN IMPLIED. Keyed on the backend flag
// alone this admitted silently: a Ray configuration that starts no threshold monitor says nothing
// about a monitor the OPERATOR declared. The rule reads the population, so the route by which an
// enforcer became live cannot change the verdict.
test fn w_a_declared_ray_monitor_refuses_although_ray_started_none() -> Bool {
  enforcer_refused_with(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_ray_monitor], resource_isolation_enabled: false, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorMp),
    wanted: "counts:ray_threshold" as NonEmptyStr)
}

// RED. A declared enforcer BESIDE the implied one is the two-enforcer incident, reached by the
// implication rather than by two declarations. This is the case the old shape could not see at all.
test fn w_a_declared_guard_beside_rays_implied_monitor_is_two_enforcers() -> Bool {
  enforcer_refused_as_many(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_guard], resource_isolation_enabled: true, monitor_refresh: fx_ray_live_refresh, backend: ExecutorRay),
    wanted_count: 2)
}

// RED, AND THE ROW THE OLD SHAPE COULD NOT EXPRESS AT ALL. A zero refresh interval is how Ray's
// monitor is "disabled", and the deleted `ray_monitor_disabled: Bool` reported exactly that: no
// implied enforcer, admitted. It is WRONG. At a zero interval the factory swaps only the THRESHOLD
// monitor for a Noop; the EVENT monitor was pushed before the interval is read and goes on
// enforcing whenever resource isolation is on. So this configuration -- operator believes the
// monitor is off, Ray is still enforcing, unified pool -- admitted silently under the Bool and
// refuses here.
//
// AND IT REFUSES AS THE EVENT MONITOR, NOT THE THRESHOLD ONE. The factory built `[Event, Noop]`, so
// there is no threshold monitor on this host. Reporting one would be a fabricated cause. Whether
// Ray's event monitor counts a device reservation is UNESTABLISHED -- it fires off a cgroup event
// counter rather than a byte comparison, and nothing read for the citation settles it -- so the
// refusal carries that as its own arm. Refusing on unknown accounting is the fail-closed reading:
// admitting would assert safety on the strength of not having checked.
//
// This is the whole reason the extdeps citation exists rather than a local flag: the fleet's model
// of Ray was wrong in the direction that admits, and no amount of care in THIS file could have found
// that, because the fact lives in Ray's factory and not here.
test fn w_a_zero_refresh_with_isolation_on_is_still_a_live_ray_monitor() -> Bool {
  enforcer_refused_with(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [], resource_isolation_enabled: true, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorRay),
    wanted: "unestablished:ray_event" as NonEmptyStr)
}

// CONTROL, AND THE DISCRIMINATOR FOR THE DERIVED FIELD. What an enforcer counts is now a total
// function of what it IS, so this row goes red if any kind's answer is edited -- which is the check
// the deleted `counts_device_reservation` field could never carry, because a caller supplied it.
test fn w_only_rays_monitor_counts_the_device_reservation() -> Bool {
  accounting_is(a: memory_enforcer_device_reservation_accounting(kind: RayThresholdMonitor), wanted: "counts" as NonEmptyStr)
    && accounting_is(a: memory_enforcer_device_reservation_accounting(kind: RayEventMonitor), wanted: "unestablished" as NonEmptyStr)
    && accounting_is(a: memory_enforcer_device_reservation_accounting(kind: HostMemGuard), wanted: "excludes" as NonEmptyStr)
    && accounting_is(a: memory_enforcer_device_reservation_accounting(kind: KernelOomKiller), wanted: "excludes" as NonEmptyStr)
}

// CONTROL. Disabling the monitor admits the same configuration. Without this the row above would be
// satisfied by refusing every Ray realization outright.
test fn w_the_same_configuration_admits_once_the_monitor_is_off() -> Bool {
  enforcer_admitted(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_guard], resource_isolation_enabled: false, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorRay))
}

// CONTROL. A NON-Ray backend on a unified pool admits with the monitor flag untouched -- the rule is
// about what is counting, not about unified memory in general.
test fn w_a_non_ray_backend_is_outside_the_monitor_rule() -> Bool {
  enforcer_admitted(
    v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_guard], resource_isolation_enabled: true, monitor_refresh: fx_ray_live_refresh, backend: ExecutorMp))
    && enforcer_admitted(
      v: spark_memory_enforcer_admits(memory_kind: UnifiedShared, enforcers: [fx_guard], resource_isolation_enabled: true, monitor_refresh: fx_ray_live_refresh, backend: ExecutorExternalLauncher))
}

// CONTROL. Ray's monitor ALONE on a DISCRETE host admits, because there the device reservation and
// the host's own memory are separately accounted and counting the reservation is merely
// conservative. The declared list is empty on purpose: with a guard declared beside it this is the
// two-enforcer refusal instead, which is true on a discrete host as well and would make this row
// green for the wrong reason.
test fn w_ray_on_a_discrete_host_is_outside_the_counting_rule() -> Bool {
  enforcer_admitted(
    v: spark_memory_enforcer_admits(memory_kind: Dram, enforcers: [], resource_isolation_enabled: true, monitor_refresh: fx_ray_live_refresh, backend: ExecutorRay))
    && enforcer_admitted(
      v: spark_memory_enforcer_admits(memory_kind: Hbm, enforcers: [fx_ray_monitor], resource_isolation_enabled: false, monitor_refresh: fx_ray_zero_refresh, backend: ExecutorMp))
}

// ── THE VERIFIED NEGATIVES ARE POPULATED, NOT MERELY DECLARED ──────────────────────────────────
//
// A negative row with no error text is a belief. This asserts the population is non-empty so the
// carrier cannot quietly become an empty list that every consumer reads as "nothing is rejected".
test fn w_the_verified_negatives_carry_upstream_error_text() -> Bool {
  length(vllm_verified_negatives) > 0 && length(vllm_discouraged_args) > 0
}

test fn w_all_serving_engine_claims_hold() -> Bool {
  w_a_second_engine_on_a_unified_pool_refuses_and_names_both()
    && w_an_empty_unified_pool_admits()
    && w_discrete_memory_hosts_are_outside_this_refusal()
    && w_no_declared_enforcer_refuses()
    && w_two_enforcers_refuse_rather_than_layering()
    && w_a_live_ray_monitor_on_a_unified_pool_refuses()
    && w_a_declared_ray_monitor_refuses_although_ray_started_none()
    && w_a_declared_guard_beside_rays_implied_monitor_is_two_enforcers()
    && w_a_zero_refresh_with_isolation_on_is_still_a_live_ray_monitor()
    && w_only_rays_monitor_counts_the_device_reservation()
    && w_the_same_configuration_admits_once_the_monitor_is_off()
    && w_a_non_ray_backend_is_outside_the_monitor_rule()
    && w_ray_on_a_discrete_host_is_outside_the_counting_rule()
    && w_the_verified_negatives_carry_upstream_error_text()
}
