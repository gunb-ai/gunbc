module test.claim.spark.serving_arm_convergence_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import gunbc.spark.serving_arm {
  Glm53NativeFp8, Glm53Exl3_205, Glm53Nvfp4CompressedTensors,
  Gitcommit90Sm121Exl3, VllmOpenaiGlm53Flash,
  SingleSparkTp1, FourSparkTp4,
  gitcommit90_sm121_exl3_row, vllm_openai_glm53_flash_row, runtime_artifact_wire,
}
import gunbc.spark.serving_arm_convergence {
  ServingArmGoal, serving_arm_goal,
  ServingArmReading, ArmArgvRead, ArmNothingRunning, ArmReadUnavailable,
  ServedArmIdentity, served_arm_identity, served_arm_identity_eq, quantization_word,
  inspect_served_arm, plan_arm_remedy,
  ServingArmRemedy, ArmAlreadyConverged, ArmFirstLaunchRequired, ArmReplacementRequired,
  ArmRemedyWithheld, ArmRemedyRefused,
  ArmActuationStanding, ArmActuationAdmitted, ArmActuationWithheld, admit_arm_actuation,
  argv_value_after,
}

// ── THE SUBJECTS ──────────────────────────────────────────────────────────────────────────────
//
// THE CANARY ARGV IS THE REAL ONE, READ OFF THE RUNNING ENGINE, not a plausible reconstruction of it.
// `docker inspect` on spark-0c75 returned exactly these words on 2026-09-10 while the container had been
// up 27 hours. Using the genuine line is what makes the tuning-versus-identity row below evidence rather
// than an argument: the 7168 in it is the value the model does NOT desire, and it is there because the
// engine really is running it.
data canary_argv: List<String> = [
  "serve", "/model",
  "--served-model-name", "glm-5.3-flash-exl3-canary",
  "--quantization", "exl3",
  "--tensor-parallel-size", "1",
  "--kv-cache-dtype", "fp8",
  "--max-model-len", "262144",
  "--max-num-seqs", "1",
  "--max-num-batched-tokens", "7168",
  "--reasoning-parser", "glm45",
  "--tool-call-parser", "glm47",
  "--enable-auto-tool-choice",
  "--no-enable-flashinfer-autotune",
  "--host", "0.0.0.0",
  "--port", "30001",
]

data canary_goal: ServingArmGoal = serving_arm_goal(
  alias: "glm-5.3-flash-exl3-canary" as NonEmptyStr,
  checkpoint: Glm53Exl3_205,
  runtime: Gitcommit90Sm121Exl3,
  topology: SingleSparkTp1,
)

data native_tp4_goal: ServingArmGoal = serving_arm_goal(
  alias: "glm-5.3-flash-native-fp8" as NonEmptyStr,
  checkpoint: Glm53NativeFp8,
  runtime: VllmOpenaiGlm53Flash,
  topology: FourSparkTp4,
)

data unmodelled_goal: ServingArmGoal = serving_arm_goal(
  alias: "glm-5.3-flash-nvfp4" as NonEmptyStr,
  checkpoint: Glm53Nvfp4CompressedTensors,
  runtime: Gitcommit90Sm121Exl3,
  topology: FourSparkTp4,
)

// THE IMAGES ARE READ FROM THE ROWS, NOT SPELLED HERE. A digest copied into a fixture would let this
// witness agree with itself after the roster changed under it, which is the transcribed-measurement failure
// at test grain.
data exl3_image: NonEmptyStr = runtime_artifact_wire(a: gitcommit90_sm121_exl3_row.artifact)
data official_image: NonEmptyStr = runtime_artifact_wire(a: vllm_openai_glm53_flash_row.artifact)

data subject_group_b: NonEmptyStr = "the four hosts on fabric cage 2 (srv9, srv10, srv11, srv12)" as NonEmptyStr

fn remedy_for(goal: ServingArmGoal, reading: ServingArmReading) -> ServingArmRemedy {
  plan_arm_remedy(inspection: inspect_served_arm(subject: subject_group_b, goal: goal, reading: reading))
}

// ── THE ROW THIS MODULE EXISTS FOR ────────────────────────────────────────────────────────────
//
// THE ARM THE CANARY IS SERVING IS THE ARM THE CANARY GOAL DESIRES, and the tuning disagreement does not
// change that. The model desires 2048 batched tokens and this line runs 7168 -- a real drift, and one the
// arm's own basis insists must keep being reported -- but the alias,
// the quantisation and the rank count all agree, so the right model is loaded on the right number of
// GPUs. The cutover this replaces compared whole rendered lines and therefore answered ServeDiffers here,
// which is why converging the fleet appeared to require either editing the desired value to match the
// running one or leaving the arm unowned.
//
// ITS RED IS AUTHORABLE AND CHEAP: change any of the three identity words in `canary_argv` and this row
// goes red, which is the next control below.
test fn an_arm_differing_only_in_tuning_is_already_converged() -> Bool {
  match remedy_for(goal: canary_goal, reading: ArmArgvRead { words: canary_argv, runtime_image_wire: exl3_image }) {
    ArmAlreadyConverged { identity: got } => (got.alias as String) == "glm-5.3-flash-exl3-canary"
    ArmFirstLaunchRequired { desired: _ } => false
    ArmReplacementRequired { desired: _, displaced: _ } => false
    ArmRemedyWithheld { because: _ } => false
    ArmRemedyRefused { cause: _ } => false
  }
}

// THE DISCRIMINATING NEGATIVE. The same reading against the NATIVE goal is a different artifact on a
// different rank count, so it asks for a replacement and names what it would displace. If the comparison
// ever collapsed to "something is serving, good enough", this row would go green as converged.
test fn a_different_arm_serving_asks_for_a_replacement_naming_what_it_displaces() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmArgvRead { words: canary_argv, runtime_image_wire: exl3_image }) {
    ArmReplacementRequired { desired: want, displaced: got } =>
      (quantization_word(q: want.quantization_on_argv) as String) == "none-on-argv"
        && (want.rank_count_wire as String) == "4"
        && (want.runtime_image_wire as String) == (official_image as String)
        && (quantization_word(q: got.quantization_on_argv) as String) == "exl3"
        && (got.rank_count_wire as String) == "1"
        && (got.runtime_image_wire as String) == (exl3_image as String)
    _ => false
  }
}

// ── A FIRST LAUNCH IS NOT A REPLACEMENT ───────────────────────────────────────────────────────
//
// Nothing serving means there is no rollback line to record and nothing to displace. The cutover refused
// this case outright as "a first launch rather than a cutover"; it is the ordinary state of a group that
// has been withdrawn from its previous roster, which is exactly the state group B is in.
test fn nothing_serving_asks_for_a_first_launch() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmNothingRunning { detail: "no listener on the serving port" as NonEmptyStr }) {
    ArmFirstLaunchRequired { desired: want } => (want.rank_count_wire as String) == "4"
    _ => false
  }
}

// ── THE NATIVE ARM'S OWN CORRECT LINE MUST BE RECOGNISABLE ───────────────────────────────────
//
// THIS ROW WAS RED IN SUBSTANCE FOR AS LONG AS THE MODULE EXISTED, and it was green as written because it
// asserted the wrong thing. A line that names no quantisation used to be read as an UNREAD FACT and the
// remedy WITHHELD -- defensible reasoning about a canary whose scheme is not in its config, and simply
// wrong about the native arm, whose launch OMITS `--quantization` ON PURPOSE so the engine reads the
// checkpoint's own config with its block size and its 1509-entry exclusion list intact. The consequence was
// that the native deployment could never be recognised as converged by its own correct argv: nine cutover
// attempts ran toward a state this assessor would have reported as indeterminate forever.
//
// gunbc.spark.serving_arm now owns which checkpoints declare the scheme on the wire, so both sides spell
// the same absence and they match.
data native_argv: List<String> = [
  "serve", "/model",
  "--served-model-name", "glm-5.3-flash-native-fp8",
  "--tensor-parallel-size", "4",
  "--max-model-len", "262144",
]

test fn the_native_arms_own_line_which_names_no_quantisation_is_converged() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmArgvRead { words: native_argv, runtime_image_wire: official_image }) {
    ArmAlreadyConverged { identity: got } =>
      (got.alias as String) == "glm-5.3-flash-native-fp8"
        && (quantization_word(q: got.quantization_on_argv) as String) == "none-on-argv"
    _ => false
  }
}

// ── THE IMAGE IS PART OF THE IDENTITY ────────────────────────────────────────────────────────
//
// THE DISCRIMINATING RED FOR THE AXIS THIS SESSION SPENT NINE ATTEMPTS ON. Same alias, same rank count,
// same absent quantisation flag -- and a DIFFERENT runtime image, which on this fleet is the difference
// between an engine that loads the native fp8 weights and one that cannot. Before the image entered the
// identity these two compared equal, so a convergence could report the desired arm running while the wrong
// runtime held the port.
test fn the_same_line_under_a_different_image_is_not_the_same_arm() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmArgvRead { words: native_argv, runtime_image_wire: exl3_image }) {
    ArmReplacementRequired { desired: want, displaced: got } =>
      (want.runtime_image_wire as String) == (official_image as String)
        && (got.runtime_image_wire as String) == (exl3_image as String)
        && (want.alias as String) == (got.alias as String)
    _ => false
  }
}

// ── A LINE MISSING AN IDENTITY FLAG STILL WITHHOLDS ──────────────────────────────────────────
//
// The indeterminate arm did not disappear with the quantisation repair; it moved to the flags that really
// are unreadable when absent. A line naming no `--tensor-parallel-size` had one resolved by the engine, and
// replacing on a value nobody read would stop a healthy engine on a guess.
data argv_without_rank_count: List<String> = [
  "serve", "/model",
  "--served-model-name", "glm-5.3-flash-native-fp8",
  "--max-model-len", "262144",
]

test fn a_line_missing_the_rank_count_withholds_rather_than_replaces() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmArgvRead { words: argv_without_rank_count, runtime_image_wire: official_image }) {
    ArmRemedyWithheld { because: bs } => count(bs) == 1
    _ => false
  }
}

// ── AN UNREADABLE HOST DECIDES NOTHING ────────────────────────────────────────────────────────
//
// The distinction this row protects is the one that would otherwise launch a second engine onto hosts
// already serving: an unreachable group and an idle group are not the same reading, and only the second
// licenses a launch.
test fn an_unreadable_group_refuses_rather_than_launching() -> Bool {
  match remedy_for(goal: native_tp4_goal, reading: ArmReadUnavailable { cause: "ssh to the group head timed out" as NonEmptyStr }) {
    ArmRemedyRefused { cause: _ } => true
    _ => false
  }
}

// A GOAL NAMING AN UNMODELLED CHECKPOINT IS A MALFORMED QUESTION rather than a divergence: with no row
// there is no desired quantisation, so any verdict would certify a comparison that never ran.
test fn a_goal_whose_checkpoint_has_no_row_refuses() -> Bool {
  match remedy_for(goal: unmodelled_goal, reading: ArmNothingRunning { detail: "nothing serving" as NonEmptyStr }) {
    ArmRemedyRefused { cause: _ } => true
    _ => false
  }
}

// ── KNOWING WHAT TO DO IS NOT PERMISSION TO DO IT ─────────────────────────────────────────────
//
// THESE TWO ROWS ARE ABOUT THE WEIGHTS-AND-GRANT GATE AND NOTHING ELSE, so they use an arm that is
// otherwise ADMISSIBLE. They were written against the native arm and went red in CI when a third
// admission wall landed in gunbc.spark.serving_arm -- the native checkpoint now contributes its own
// obligation, because the runtime it names has not been shown to load it, so "withheld on two grounds"
// became three and "admitted once weights and a grant exist" became never.
//
// THE WALL WAS RIGHT AND THESE ROWS WERE MEASURING THROUGH IT. A control whose fixture can acquire an
// extra obligation from an unrelated gate is not testing the gate it names, which is the same defect as a
// positive control that can fail for a reason outside its subject. The EXL3 arm isolates it: that arm
// admits, so the only obligations reaching the count are the two this row is about.
//
// AND CI FOUND THIS, NOT ME. The floor executes every witness in the corpus; I had re-run only the
// controls in the files I was editing, so two rows in a file I had not touched since the wall landed
// stayed red until a lane that does not share my assumptions evaluated 3,641 of them.
test fn a_correct_remedy_is_withheld_without_weights_and_a_grant() -> Bool {
  match admit_arm_actuation(
    goal: canary_goal,
    remedy: remedy_for(goal: canary_goal, reading: ArmNothingRunning { detail: "nothing serving" as NonEmptyStr }),
    weights_present_on_every_rank: false,
    launch_granted: false,
  ) {
    ArmActuationWithheld { obligations: os } => count(os) == 2
    ArmActuationAdmitted { remedy: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THAT GATE, so the row above is not passing because the gate withholds
// everything. With the weights present and the launch granted, the same remedy is admitted.
test fn the_same_remedy_is_admitted_once_weights_and_a_grant_exist() -> Bool {
  match admit_arm_actuation(
    goal: canary_goal,
    remedy: remedy_for(goal: canary_goal, reading: ArmNothingRunning { detail: "nothing serving" as NonEmptyStr }),
    weights_present_on_every_rank: true,
    launch_granted: true,
  ) {
    ArmActuationAdmitted { remedy: _ } => true
    ArmActuationWithheld { obligations: _ } => false
  }
}

// AND THE THIRD OBLIGATION IS ASSERTED DELIBERATELY RATHER THAN BEING AN ACCIDENT OF ANOTHER ROW'S
// FIXTURE. The native arm on a runtime that has not been shown to load its checkpoint contributes an
// obligation of its own, so even with weights present and a grant in hand it is withheld -- which is the
// behaviour that would have prevented the 2026-09-10 outage, and is now something a reader can see
// asserted instead of inferring it from a count that changed.
test fn the_native_arm_adds_its_own_obligation_even_with_weights_and_a_grant() -> Bool {
  match admit_arm_actuation(
    goal: native_tp4_goal,
    remedy: remedy_for(goal: native_tp4_goal, reading: ArmNothingRunning { detail: "nothing serving" as NonEmptyStr }),
    weights_present_on_every_rank: true,
    launch_granted: true,
  ) {
    ArmActuationWithheld { obligations: os } => count(os) == 1
    ArmActuationAdmitted { remedy: _ } => false
  }
}

// AND A CONVERGED ARM NEEDS NO GRANT, because it needs no action. A gate that demanded authorisation to
// conclude "nothing to do" would make every read of a healthy fleet require a permission slip.
test fn an_already_converged_arm_is_admitted_without_a_grant() -> Bool {
  match admit_arm_actuation(
    goal: canary_goal,
    remedy: remedy_for(goal: canary_goal, reading: ArmArgvRead { words: canary_argv, runtime_image_wire: exl3_image }),
    weights_present_on_every_rank: false,
    launch_granted: false,
  ) {
    ArmActuationAdmitted { remedy: _ } => true
    ArmActuationWithheld { obligations: _ } => false
  }
}

// ── THE ARGV SCAN READS WORDS, NOT SUBSTRINGS ─────────────────────────────────────────────────
//
// The flag's value is the word AFTER it, and a value that happens to equal a flag name elsewhere in the
// line must not be picked up early. A substring search over the joined line would also match the
// characters "--quantization" wherever they appeared, including inside a path.
test fn the_argv_scan_takes_the_word_after_the_flag() -> Bool {
  match argv_value_after(words: canary_argv, flag: "--max-num-batched-tokens") {
    Present { value: v } => v == "7168"
    Absent => false
  }
}

test fn the_argv_scan_declines_a_flag_that_is_absent() -> Bool {
  match argv_value_after(words: canary_argv, flag: "--gpu-memory-utilization") {
    Absent => true
    Present { value: _ } => false
  }
}

// IDENTITY EQUALITY IS FIELD-WISE, and this row is the control that it is not comparing a rendering: two
// identities differing only in rank count are different arms.
test fn identities_differing_only_in_rank_count_are_not_equal() -> Bool {
  let one = served_arm_identity(alias: "a" as NonEmptyStr, quantization_on_argv: Present { value: "fp8" as NonEmptyStr }, rank_count_wire: "1" as NonEmptyStr, runtime_image_wire: official_image)
  let four = served_arm_identity(alias: "a" as NonEmptyStr, quantization_on_argv: Present { value: "fp8" as NonEmptyStr }, rank_count_wire: "4" as NonEmptyStr, runtime_image_wire: official_image)
  !served_arm_identity_eq(a: one, b: four) && served_arm_identity_eq(a: four, b: four)
}
