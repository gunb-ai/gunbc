module test.claim.spark.v41_row_store_encode_run_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import v2.std.optional { Present, Absent }
import gunbc.spark.v41_row_store_encode { V41StoreEncodeArgs }
import gunbc.spark.v41_row_store_encode_run {
  V41StoreRun, V41StorePresent, V41StoreEncoded, V41StoreDigestUnread, V41StoreEncodeFailed, V41StorePresenceFailed,
  V41StoreFound, V41StoreAbsent, V41StorePresenceUnread, v41_store_presence_of,
  V41StoreSizeMismatch, V41StoreSizeUnread, V41SizeReadOk, V41SizeReadFailed, v41_sized, v41_store_expected_size,
  V41EncodeRan, V41EncodeRefusedBeforeRun, v41_encode_succeeded, v41_store_line,
}

// THE RUN'S VERDICT AND RECEIPT, OVER SUPPLIED STORE OUTCOMES (the host legs are the dispatched run's).

fn w_args(layer: Nat, rank: Nat) -> V41StoreEncodeArgs {
  V41StoreEncodeArgs {
    layer: layer, rank: rank, shard: "model-00047-of-00048.safetensors" as NonEmptyStr,
    weight_offset: byte_size(count: 664), scale_offset: byte_size(count: 98305579672), start: 0, rows: 1,
    weight_bytes: byte_size(count: 256), scale_bytes: byte_size(count: 8), magic_hex: "454e4752310a", out: "/m/s" as NonEmptyStr,
  }
}

data w_hex: String = "3e17ab5e78214d961c8ff395020ee135f485c7f5e84f635877e8058dbad7c435"

fn w_sha() -> Sha256Digest {
  Sha256Digest { hex: w_hex as Sha256DigestHex }
}

fn w_read(layer: Nat, rank: Nat) -> V41StoreRun {
  V41StoreEncoded { store: w_args(layer: layer, rank: rank), digest: w_sha(), size: byte_size(count: 270) }
}

fn w_planned() -> List<V41StoreEncodeArgs> {
  [w_args(layer: 1, rank: 0), w_args(layer: 1, rank: 1), w_args(layer: 1, rank: 2), w_args(layer: 1, rank: 3),
   w_args(layer: 14, rank: 0), w_args(layer: 14, rank: 1), w_args(layer: 14, rank: 2), w_args(layer: 14, rank: 3)]
}

fn w_eight() -> List<V41StoreRun> {
  map(w_planned(), a => V41StoreEncoded { store: a, digest: w_sha(), size: byte_size(count: 270) })
}

test fn every_planned_store_digested_succeeds() -> Bool {
  v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: w_eight() })
    && v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(w_eight() |> take(n: 7), [V41StorePresent { store: w_args(layer: 14, rank: 3), digest: w_sha(), size: byte_size(count: 270) }]) })
}

// RED: completeness is an identity join against the PLAN, not a count -- a store whose digest read
// failed, a failed encode, a missing store, a duplicated one, a store the plan does not name, and a
// refusal before the run are each not success.
test fn anything_short_of_the_planned_join_is_not_success() -> Bool {
  let seven = w_eight() |> take(n: 7)
  !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(seven, [V41StoreDigestUnread { store: w_args(layer: 14, rank: 3), encoded: true, cause: "sha256sum exited 1: gone" as NonEmptyStr }]) })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(seven, [V41StoreEncodeFailed { store: w_args(layer: 14, rank: 3), cause: "the host program exited 3: short read" as NonEmptyStr }]) })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: seven })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(seven, [w_read(layer: 1, rank: 0)]) })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(w_eight(), [w_read(layer: 7, rank: 0)]) })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(seven, [V41StorePresenceFailed { store: w_args(layer: 14, rank: 3), cause: "the presence check did not run: timeout" as NonEmptyStr }]) })
    && !v41_encode_succeeded(run: V41EncodeRefusedBeforeRun { cause: "the span plan refused" as NonEmptyStr })
}

// THE RECEIPT LINE CARRIES THE (layer, rank) KEY AND THE DIGEST, which is what is transcribed; an arm
// with no digest says UNREAD and why.
test fn a_store_line_names_its_key_and_digest_or_says_unread() -> Bool {
  let read = v41_store_line(r: w_read(layer: 14, rank: 2))
  let unread = v41_store_line(r: V41StoreEncodeFailed { store: w_args(layer: 1, rank: 0), cause: "the encode leg did not run" as NonEmptyStr })
  let digest_lost = v41_store_line(r: V41StoreDigestUnread { store: w_args(layer: 1, rank: 1), encoded: true, cause: "sha256sum exited 1" as NonEmptyStr })
  read.contains("store layer.14.rank.2 sha256=") && read.contains(w_hex)
    && unread.contains("store layer.1.rank.0 UNREAD") && unread.contains("did not run")
    && digest_lost.contains("store layer.1.rank.1 UNREAD encoded but the digest read failed")
}

// PRESENCE IS THREE-VALUED: exit 0 found, exit 1 absent, anything else a failed check -- never absent,
// which would re-encode a complete store (review 70586). Its receipt line says nothing was encoded.
test fn a_failed_presence_check_is_not_absent_and_encodes_nothing() -> Bool {
  (match v41_store_presence_of(exit_code: 0, stderr: "") { V41StoreFound => true  _ => false })
    && (match v41_store_presence_of(exit_code: 1, stderr: "") { V41StoreAbsent => true  _ => false })
    && (match v41_store_presence_of(exit_code: 2, stderr: "Permission denied") {
      V41StorePresenceUnread { cause: c } => (c as String).contains("Permission denied")
      _ => false
    })
    && v41_store_line(r: V41StorePresenceFailed { store: w_args(layer: 1, rank: 2), cause: "the presence check did not run: timeout" as NonEmptyStr }).contains("presence check failed, nothing encoded")
}

// THE SIZE CHECK (proud-deer-538, 2026-09-24): one row of 256 + 8 bytes after the 6-byte magic is 270
// bytes; a store of any other size is a SIZE-MISMATCH carrying both figures and is not digested, and a
// size that could not be read is not digested either.
test fn a_store_of_the_wrong_size_is_refused_with_both_figures() -> Bool {
  let a = w_args(layer: 1, rank: 0)
  byte_size_count(b: v41_store_expected_size(a: a)) == 270
    && (match v41_sized(a: a, encoded: true, d: w_sha(), size: V41SizeReadOk { size: byte_size(count: 270) }) { V41StoreEncoded { store: _, digest: _, size: _ } => true  _ => false })
    && (match v41_sized(a: a, encoded: true, d: w_sha(), size: V41SizeReadOk { size: byte_size(count: 269) }) {
      V41StoreSizeMismatch { store: _, digest: _, observed: n, derived: e } => byte_size_count(b: n) == 269 && byte_size_count(b: e) == 270
      _ => false
    })
    && (match v41_sized(a: a, encoded: false, d: w_sha(), size: V41SizeReadFailed { cause: "stat exited 1: gone" as NonEmptyStr }) { V41StoreSizeUnread { store: _, digest: _, cause: _ } => true  _ => false })
    && !v41_encode_succeeded(run: V41EncodeRan { planned: w_planned(), stores: concat(w_eight() |> take(n: 7), [V41StoreSizeMismatch { store: w_args(layer: 14, rank: 3), digest: w_sha(), observed: byte_size(count: 269), derived: byte_size(count: 270) }]) })
    && v41_store_line(r: V41StoreSizeMismatch { store: a, digest: w_sha(), observed: byte_size(count: 269), derived: byte_size(count: 270) }).contains("SIZE-MISMATCH")
    && v41_store_line(r: w_read(layer: 1, rank: 0)).contains("size_bytes=270")
}
