module test.claim.spark.spark_pair_serving_apply_witness

import std.types { Bool, List, NonEmptyStr, String, EpochSecs }
import product.host_identity { host_identity_eq }
import gunbc.fleet_host_identity { operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8 }
import gunbc.spark.pair_serving_realization { spark_pair_realizations }
import gunbc.spark.pair_serving_apply {
  SparkPairApplyPlan, SparkPairApplyPlanned, SparkPairApplyRefused, SparkPairHostApplyPlan,
  spark_pair_apply_plan_current, spark_pair_apply_plans_current, spark_pair_apply_plan_refusals, spark_pair_apply_plans,
}
import gunbc.spark.pair_serving_authority { spark_pair_serving_authorities, pair_serving_authority_group }
import gunbc.spark.pair_serving_authority_log { CurrentAuthority, CurrentAuthorityRead, CurrentAuthorityUnread, AuthorityTransitionRecord }
import product.capacity.event_chain { HeadAbsent }

// THE CURRENT AUTHORITY IS SUPPLIED: the resting row of every claimed group at generation 0, which
// is exactly what the log folds to when no transition has been recorded. The log READ is
// exercised by the supplied-host claim at the end of this file.
fn w_current() -> List<CurrentAuthority> {
  map(spark_pair_serving_authorities, a => CurrentAuthorityRead { authority: a, head: HeadAbsent, generation: 0, grant: none, entry_state: none, previous: none, admitted_by: none, transitions: [] as List<AuthorityTransitionRecord> })
}

fn w_plan() -> SparkPairApplyPlan {
  match first(spark_pair_realizations()) {
    Absent => SparkPairApplyRefused { cause: "no realization" }
    Present { value: r } => spark_pair_apply_plan_current(r: r, current: w_current())
  }
}

fn w_planned(f: fn(List<SparkPairHostApplyPlan>, SparkPairHostApplyPlan) -> Bool) -> Bool {
  match w_plan() {
    SparkPairApplyRefused { cause: _ } => false
    SparkPairApplyPlanned { workers: ws, head: h } => f(ws, h)
  }
}

// THE WORKERS ARE APPLIED ON srv5, srv8 AND srv7 AND THE HEAD ON srv6, each script beginning with
// set -e and ending by enabling and reading back the rendered unit, and each retiring exactly its own
// hand-authored predecessor and the old container.
test fn the_plan_applies_workers_then_head_with_each_retiring_its_own_predecessor() -> Bool  {
  w_planned(f: fn(ws, h) {
    length(ws) == 3 && host_identity_eq(a: h.host, b: operator_host_srv6)
      && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv5)) && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv7)) && any(ws, w => host_identity_eq(a: w.host, b: operator_host_srv8))
      && all(ws, w => starts_with(s: w.script, prefix: "set -e\n")) && starts_with(s: h.script, prefix: "set -e\n")
      && all(ws, w => string_contains(s: w.script, pattern: "systemctl disable --now spark-ray-worker.service") && !string_contains(s: w.script, pattern: "spark-vllm.service"))
      && string_contains(s: h.script, pattern: "systemctl disable --now spark-vllm.service")
      && string_contains(s: h.script, pattern: "systemctl enable gunbc-spark-pair-head.service >/dev/null 2>&1\nif [ \"$changed\" = 1 ] || ! systemctl is-active --quiet gunbc-spark-pair-head.service; then systemctl restart gunbc-spark-pair-head.service; echo restarted; else echo unchanged; fi\nsystemctl is-active gunbc-spark-pair-head.service\n")
      && string_contains(s: h.script, pattern: "if cmp -s /etc/systemd/system/gunbc-spark-pair-head.service.next /etc/systemd/system/gunbc-spark-pair-head.service; then changed=0; else changed=1; fi\n")
      && all(ws, w => string_contains(s: w.script, pattern: "systemctl enable gunbc-spark-pair-worker.service >/dev/null 2>&1\nif [ \"$changed\" = 1 ] || ! systemctl is-active --quiet gunbc-spark-pair-worker.service; then systemctl restart gunbc-spark-pair-worker.service; echo restarted; else echo unchanged; fi\nsystemctl is-active gunbc-spark-pair-worker.service\n"))
      && string_contains(s: h.script, pattern: "docker stop dsv4")
  })
}

// EVERY MUTATING LINE IS A PROJECTION OF THE REALIZATION: the Dockerfile and unit text written
// whole, the JIT cache carried over before the old container stops, the daemon reload before any
// enable; the container itself is created by the unit's own lifecycle, never by the script.
test fn the_script_is_made_of_the_rendered_argv_and_carries_the_cache_over() -> Bool  {
  w_planned(f: fn(_ws, h) {
    string_contains(s: h.script, pattern: "> /var/lib/gunbc/spark-pair/runtime/Dockerfile\n")
      && !string_contains(s: h.script, pattern: "\n/usr/bin/docker create")
      && string_contains(s: h.script, pattern: "> /etc/systemd/system/gunbc-spark-pair-head.service.next\n")
      && string_contains(s: h.script, pattern: "mv -f /etc/systemd/system/gunbc-spark-pair-head.service.next /etc/systemd/system/gunbc-spark-pair-head.service\nsystemctl daemon-reload\n")
      && string_contains(s: h.script, pattern: "docker cp dsv4:/cache/huggingface/. /var/lib/gunbc/spark-pair/jit-cache/")
      && string_contains(s: h.script, pattern: "ExecStartPre=/usr/bin/docker create --name gunbc-spark-pair --network host --ipc host --shm-size 10737418240 --restart unless-stopped --ulimit memlock=-1:-1 --gpus all --device /dev/infiniband:/dev/infiniband:rwm --cap-add IPC_LOCK")
      && string_contains(s: h.script, pattern: "ExecStart=/usr/bin/docker exec gunbc-spark-pair /opt/env/bin/vllm serve")
      && !string_contains(s: h.script, pattern: "dsv4-ray:local")
  })
}

// EVERY CLAIMED GROUP PLANS AND NONE REFUSES: one plan per authority row, so one apply carries
// the whole claimed roster. The roster is the authority population -- Group A alone since the
// membership became a projection of gunbc.spark.pair_serving_authority (#11501) -- and this claim
// reads its expected count from that population rather than from a literal, so an earlier
// spelling that named a second group headed by srv9 with srv12 was measuring a roster that no
// longer exists. The head-and-workers shape of the one plan is the claim above.
test fn every_claimed_group_plans_and_none_refuses() -> Bool  {
  let plans = spark_pair_apply_plans_current(current: w_current())
  length(plans) == length(spark_pair_serving_authorities) && length(plans) >= 1
    && length(spark_pair_apply_plan_refusals(plans: plans)) == 0
}

// RED -- AN UNREADABLE AUTHORITY IS NEVER PLANNED FROM THE RESTING ROW. The supplied roster says the
// log could not be read for the claimed group; the plan for that group is a refusal carrying the
// read's cause, and nothing renders. Folding the unread arm back onto the source row would plan
// the incumbent here and turn this red.
test fn an_unread_authority_refuses_the_plan_with_the_reads_cause() -> Bool  {
  let unread = map(spark_pair_serving_authorities, a => CurrentAuthorityUnread { group: pair_serving_authority_group(a: a), step: "fetch" as String, reason: "witness: the partition could not be fetched" as String })
  let plans = spark_pair_apply_plans_current(current: unread)
  let refusals = spark_pair_apply_plan_refusals(plans: plans)
  length(plans) == length(spark_pair_serving_authorities) && length(plans) >= 1
    && length(refusals) == length(plans)
    && all(refusals, r => string_contains(s: r, pattern: "the serving authority could not be read") && string_contains(s: r, pattern: "witness: the partition could not be fetched"))
}

// THE OFF-FLEET PREMISE IS SUPPLIED, NOT READ FROM THE RUNNER. spark_pair_apply_plans resolves the
// executor's event log layout and reads every claimed group's authority from the log before
// planning anything. The executor and instant are supplied, so the verdict does not depend on which
// runner executes it (gunbc.recurring_failure_mode wet_witness_premise_read_from_the_runner_it_happens_to_land_on).
// The store resolution and the refusal that NAMES THE READ run for real, and nothing is planned
// from the resting row. Deleting the log read, or letting an unreadable log fall back to the row,
// turns these refusals into plans and this claim red.
data witness_host_declaring_no_dashboard_instance: String = "gunbc-witness-host-without-dashboard-instance"
data witness_instant: EpochSecs = 1000

test fn the_apply_seam_reads_the_authority_before_planning_and_refuses_off_fleet() -> Bool  {
  let plans = spark_pair_apply_plans(executor: witness_host_declaring_no_dashboard_instance, at: witness_instant)
  let refusals = spark_pair_apply_plan_refusals(plans: plans)
  length(plans) > 0
    && length(plans) == length(spark_pair_serving_authorities)
    && length(refusals) == length(plans)
    && all(refusals, r => string_contains(s: r, pattern: "the serving authority could not be read")
      && string_contains(s: r, pattern: witness_host_declaring_no_dashboard_instance))
}
