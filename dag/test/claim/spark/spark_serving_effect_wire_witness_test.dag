module test.claim.spark_serving_effect_wire_witness

import std.logic { Bool }
import gunbc.fleet_converge_plan { fleet_converge_spark_serving_effect_wire }
import gunbc.spark.serving_realization {
  PlannedInstallEffect,
  EnableLingerForOwnAccount,
  EnableSystemUnit,
  StartSystemUnit,
  EnableUserUnit,
  GrantContainerRuntimeAccess,
  InstallOwnedRuntimeClosure,
  InstallRuntimePackage,
  MaterializeModelArtifact,
  ReloadSystemManager,
  ReloadUserManager,
  RunContainerAsOwnUser,
  StartUserUnit,
  WriteSystemUnitFile,
  WriteUserUnitFile,
  PlannedReactivationEffect,
  RestartSystemUnitForChangedDefinition,
  RestartUserUnitForChangedDefinition,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY VARIANT REACHES ITS OWN ARM. Removing the wildcard is only half the fix; the other half is
// that the twelve bare names really are variant PATTERNS. A bare lowercase-or-not name in pattern
// position could bind instead of match, and a binder in the first arm would swallow every later
// effect -- reinstating the wildcard invisibly and making the exhaustiveness look real while one
// arm answered for all of them. This distinguishes those two worlds by execution: under a binder
// every call below returns the first non-linger arm's string.
test fn w_each_serving_effect_wires_to_its_own_name() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableLingerForOwnAccount }) == "EnableLingerForOwnAccount"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: WriteSystemUnitFile }) == "WriteSystemUnitFile"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: ReloadSystemManager }) == "ReloadSystemManager"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableSystemUnit }) == "EnableSystemUnit"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: StartSystemUnit }) == "StartSystemUnit"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: WriteUserUnitFile }) == "WriteUserUnitFile"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: ReloadUserManager }) == "ReloadUserManager"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableUserUnit }) == "EnableUserUnit"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: InstallRuntimePackage }) == "InstallRuntimePackage"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: InstallOwnedRuntimeClosure }) == "InstallOwnedRuntimeClosure"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: MaterializeModelArtifact }) == "MaterializeModelArtifact"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: GrantContainerRuntimeAccess }) == "GrantContainerRuntimeAccess"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: RunContainerAsOwnUser }) == "RunContainerAsOwnUser"
}

// AND THE NAMES ARE DISTINCT, so the assertion above cannot be satisfied by a fold that returns one
// constant. Twelve equalities against twelve different literals is the discriminating shape; this
// pins that no two arms collapsed onto the same wire label.
test fn w_no_two_effects_share_a_wire_label() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: WriteSystemUnitFile })
    != fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: WriteUserUnitFile })
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: ReloadSystemManager })
      != fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: ReloadUserManager })
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableSystemUnit })
      != fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableUserUnit })
}

// THE THIRD VOCABULARY RENDERS AS ITS OWN KIND. A reactivation is not an install and not a
// retirement, and a plan a human reads must say which of the three it was: `StartUserUnit` beside a
// bare `RestartUserUnit...` would read as two members of one closed install set. The prefix comes
// from the sum's own arm, so the rendering cannot claim a kind the value does not have.
test fn w_reactivation_effects_render_with_their_own_kind_prefix() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: PlannedReactivationEffect { reactivation: RestartUserUnitForChangedDefinition })
    == "reactivate:restart-user-unit-for-changed-definition"
    && fleet_converge_spark_serving_effect_wire(effect: PlannedReactivationEffect { reactivation: RestartSystemUnitForChangedDefinition })
      == "reactivate:restart-system-unit-for-changed-definition"
}

// AND THE THREE KINDS ARE MUTUALLY DISTINGUISHABLE IN THE RENDERED STRING, which is the claim the
// prefix exists to support: a restart of the user unit must not read as its start.
test fn w_a_restart_never_renders_as_a_start() -> Bool {
  fleet_converge_spark_serving_effect_wire(effect: PlannedReactivationEffect { reactivation: RestartUserUnitForChangedDefinition })
    != fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: StartUserUnit })
    && fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: StartSystemUnit })
      != fleet_converge_spark_serving_effect_wire(effect: PlannedInstallEffect { install: EnableSystemUnit })
}
