module test.claim.spark_serving_write_unit_operation_witness_test

import std.types { Bool, String, List, Int }
import std.measure { token_count, positive_slot_count, positive_measure_count }
import gunbc.spark.serving_release { ServingContract }
import gunbc.spark.serving_realization {
  ServingInstallEffect,
  WriteUserUnitFile,
  EnableLingerForOwnAccount,
  RunContainerAsOwnUser,
}
import gunbc.spark.serving_converge_realize {
  SparkServingInstallRemoteCommandsVerdict,
  SparkServingInstallRemoteCommandsPresent,
  SparkServingInstallRemoteCommandsRefused,
  realize_spark_serving_install_effect_commands,
 spark_serving_write_user_unit_operation }
import gunbc.spark.serving_desired { spark_serving_automation_principal_login , spark_serving_desired_bind_listen }
import gunbc.remote_operation {
  RemoteOperation,
  RemoteArgv,
  RemoteFileBytes,
  remote_operation_count,
  remote_operation_file_write_count,
  remote_operations_argv_only,
  remote_operation_label,
  remote_operation_wire,
  remote_operations_wire,
}
import gunbc.typed_remote_file_write {
  typed_remote_file_write_seal,
  TypedRemoteFileWriteAdmitted,
  TypedRemoteFileWriteAdmissionRefused,
  RemoteFileModeOwnerReadWrite,
}
import std.types { NonEmptyStr }
import gunbc.spark.serving_runtime_receipt { spark_serving_executor_home }
import gunbc.file_access { FileTreeScope }
import gunbc.spark.serving_unit_render { spark_serving_desired_user_unit_text }
import gunbc.spark.serving_install_paths { spark_serving_user_unit_path, spark_serving_user_unit_dir }

// Position-wise kind, so an ordering claim asserts WHERE each kind sits, not only how many exist. A
// count-only claim is satisfied by any permutation, including the write before its own directory.

// THE CONTRACT IS A FIXTURE. The fleet no longer declares a window or slot count globally -- both
// come from a per-realization observation, and the live realization has none, so the fleet's own
// contract is a refusal. These witnesses exercise the render/observe path, which is a function of
// the contract it is given; the values are the ones the fleet used to carry, so the assertions keep
// their historical meaning.
fn w_contract() -> ServingContract {
  ServingContract {
    bind: spark_serving_desired_bind_listen,
    default_context: token_count(count: 1048576),
    serving_slots: positive_slot_count(count: positive_measure_count(predecessor: 3)),
  }
}

fn kind_at(ops: List<RemoteOperation>, i: Int) -> String {
  match ops[i] {
    Absent => "<none>"
    Present { value: op } =>
      match op {
        RemoteArgv { argv: _ } => "argv"
        RemoteFileBytes { write: _, mode: _ } => "file"
      }
  }
}

fn realize(effects: List<ServingInstallEffect>) -> SparkServingInstallRemoteCommandsVerdict {
  realize_spark_serving_install_effect_commands(
    effects: effects,
    executor_login: spark_serving_automation_principal_login(),
    contract: w_contract(),
  )
}

// THE TOP-LEVEL OPERATION REFUSES WHILE THE LIVE REALIZATION IS UNOBSERVED. Every witness above
// realizes the unit through a FIXTURE contract, which is what lets them keep asserting the render;
// this one asks the operation the fleet actually exposes, with no fixture, and requires it to stop
// the line with the unobserved key in its reason. It is the executing evidence for the rung drop
// that was retired when the per-realization table landed.
test fn the_unit_write_refuses_at_the_top_level_while_the_realization_is_unobserved() -> Bool {
  match spark_serving_write_user_unit_operation() {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => true
    SparkServingInstallRemoteCommandsPresent { steps: _ } => false
  }
}

// ── The defect this closes ──────────────────────────────────────────────────────────────────────

// THE KEYSTONE. `WriteUserUnitFile` refused as long as the realizer could only produce argv, and
// that refusal reported a MISSING TYPE, not missing work: a file write is bytes, bytes ride stdin,
// so no argv-shaped verdict could express it. It now realizes.
test fn write_user_unit_file_realizes_instead_of_refusing() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operation_count(operations: map(sts, st => st.operation)) == 2
        && remote_operation_file_write_count(operations: map(sts, st => st.operation)) == 1
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// THE BARE-HOST KEYSTONE. `~/.config/systemd/user` does not exist on a machine that has never run a
// user unit, and the file convergence opens a staging sibling with `dd` — it does not create
// missing parents. So the mkdir must come FIRST; reversed, the write refuses on exactly the host
// this effect exists to restore. Order is asserted by position, the only thing distinguishing a
// correct sequence from one containing the same two operations.
test fn the_unit_write_is_preceded_by_a_non_privileged_mkdir() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      match map(sts, st => st.operation).first() {
        Absent => false
        Present { value: first } =>
          match first {
            RemoteArgv { argv: argv } =>
              argv == ["mkdir", "-p", spark_serving_user_unit_dir() as String]
            RemoteFileBytes { write: _, mode: _ } => false
          }
      }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// The mkdir targets the executor's OWN home, so sudo would be an unnecessary privilege escalation
// for a write the account can already perform. Asserted, because a stray sudo would silently
// require a sudoers grant that does not exist.
test fn the_unit_directory_mkdir_is_not_privileged() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      match map(sts, st => st.operation).first() {
        Absent => false
        Present { value: first } =>
          match first {
            RemoteArgv { argv: argv } => argv.first() != Present { value: "sudo" }
            RemoteFileBytes { write: _, mode: _ } => false
          }
      }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// It is a FILE WRITE, not an argv. A file write with an argv projection would mean bytes had been
// routed onto a command line, exactly what the typed-write module exists to prevent.
test fn the_unit_write_carries_no_argv_projection() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      length(remote_operations_argv_only(operations: map(sts, st => st.operation))) == 1
        && remote_operation_file_write_count(operations: map(sts, st => st.operation)) == 1
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// The bytes are the renderer's and the path is the modeled unit path. Asserting exact content makes
// this a claim about delivering the right unit rather than delivering something.
test fn the_unit_write_carries_the_rendered_bytes_at_the_modeled_path() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      match map(sts, st => st.operation)[1] {
        Absent => false
        Present { value: op } =>
          match op {
            RemoteFileBytes { write: w, mode: _ } =>
              w.content == spark_serving_desired_user_unit_text(contract: w_contract())
                && (w.path as String) == (spark_serving_user_unit_path() as String)
            RemoteArgv { argv: _ } => false
          }
      }
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── The two kinds coexist in one ordered sequence ───────────────────────────────────────────────

// Ordering is load-bearing: the unit file must exist before the manager reloads it. A mixed
// sequence must keep both kinds in order rather than partitioning them, and the counts must
// disagree — one operation of each, but only one argv — proving the argv projection is a genuine
// subset, not the whole population.
test fn a_mixed_sequence_keeps_both_kinds_and_their_order() -> Bool {
  match realize(effects: [WriteUserUnitFile, EnableLingerForOwnAccount]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operation_count(operations: map(sts, st => st.operation)) == 3
        && remote_operation_file_write_count(operations: map(sts, st => st.operation)) == 1
        && length(remote_operations_argv_only(operations: map(sts, st => st.operation))) == 2
        && kind_at(ops: map(sts, st => st.operation), i: 0) == "argv"
        && kind_at(ops: map(sts, st => st.operation), i: 1) == "file"
        && kind_at(ops: map(sts, st => st.operation), i: 2) == "argv"
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── What still refuses, so the widening did not become an absorbing arm ─────────────────────────

// Widening the representation must not turn unimplemented effects into successes.
// `RunContainerAsOwnUser` has no realization, and a sequence containing it still refuses whole
// rather than silently realizing the part it understands.
test fn an_unrealized_effect_still_refuses_the_whole_sequence() -> Bool {
  match realize(effects: [WriteUserUnitFile, RunContainerAsOwnUser]) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => true
    SparkServingInstallRemoteCommandsPresent { steps: _ } => false
  }
}

// An argv effect is still an argv operation. The keystone above would also pass if EVERYTHING became
// a file write, so this pins the other direction.
test fn an_argv_effect_is_still_an_argv_operation() -> Bool {
  match realize(effects: [EnableLingerForOwnAccount]) {
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      remote_operation_file_write_count(operations: map(sts, st => st.operation)) == 0
        && length(remote_operations_argv_only(operations: map(sts, st => st.operation))) == 1
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
  }
}

// ── The frozen operations are inside the hash, not merely inside the row ─────────────────────────

// THE DEFECT THIS CLOSES, and it was mine. Freezing the operations into the typed row stopped apply
// from re-deriving the unit bytes — but the row's wire serialized kind, member key and EFFECT NAMES
// only, and the bundle hash is computed over that wire. So the bytes were frozen and unverified: an
// artifact whose unit content had been swapped wholesale still hashed identically and admitted. I
// claimed the hash covered the bytes when it did not. It does now, and this says so.
//
// Two operations differing ONLY in content must produce different wires. Same path, mode, kind,
// count — nothing but the bytes can be doing the work.
test fn two_writes_differing_only_in_content_have_different_wires() -> Bool {
  match typed_remote_file_write_seal(
    path: spark_serving_user_unit_path(),
    content: "[Unit]\nDescription=A\n",
    allowed_scope: FileTreeScope { root_path: spark_serving_executor_home as NonEmptyStr },
  ) {
    TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
    TypedRemoteFileWriteAdmitted { write: a } =>
      match typed_remote_file_write_seal(
        path: spark_serving_user_unit_path(),
        content: "[Unit]\nDescription=B\n",
        allowed_scope: FileTreeScope { root_path: spark_serving_executor_home as NonEmptyStr },
      ) {
        TypedRemoteFileWriteAdmissionRefused { cause: _ } => false
        TypedRemoteFileWriteAdmitted { write: b } =>
          remote_operation_wire(operation: RemoteFileBytes { write: a, mode: RemoteFileModeOwnerReadWrite })
            != remote_operation_wire(operation: RemoteFileBytes { write: b, mode: RemoteFileModeOwnerReadWrite })
            && remote_operation_label(operation: RemoteFileBytes { write: a, mode: RemoteFileModeOwnerReadWrite })
              == remote_operation_label(operation: RemoteFileBytes { write: b, mode: RemoteFileModeOwnerReadWrite })
      }
  }
}

// And the LABEL does not discriminate them — the whole reason the wire had to exist rather than
// reusing the human rendering. Stated separately so a reader sees the label collapsing is
// intentional, not a second bug.
test fn the_wire_discriminates_where_the_label_does_not() -> Bool {
  match realize(effects: [WriteUserUnitFile]) {
    SparkServingInstallRemoteCommandsRefused { reason: _ } => false
    SparkServingInstallRemoteCommandsPresent { steps: sts } =>
      string_contains(remote_operations_wire(operations: map(sts, st => st.operation)), "content=")
        && string_contains(remote_operations_wire(operations: map(sts, st => st.operation)), "mode=600")
  }
}

// An argv operation's words are in the wire too. Without this, freezing an argv and swapping its
// words would be the same silent hole one kind over.
test fn an_argv_operations_words_are_in_its_wire() -> Bool {
  remote_operation_wire(operation: RemoteArgv { argv: ["mkdir", "-p", "/a"] })
    != remote_operation_wire(operation: RemoteArgv { argv: ["mkdir", "-p", "/b"] })
}

// The refusal's text, projected as a String so the interpreter can print it: a coproduct value
// renders as its type name on the run line, a String renders as itself.
fn spark_serving_write_user_unit_refusal_reason() -> String {
  match spark_serving_write_user_unit_operation() {
    SparkServingInstallRemoteCommandsRefused { reason: r } => r
    SparkServingInstallRemoteCommandsPresent { steps: _ } => "PRESENT"
  }
}
