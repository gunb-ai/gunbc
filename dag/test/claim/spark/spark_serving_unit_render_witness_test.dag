module test.claim.spark_serving_unit_render_witness_test

import std.types { Bool, String, NonEmptyStr }
import std.measure {
  TokenCount, token_count, PositiveSlotCount, positive_slot_count, positive_measure_count,
}
import std.nat { Nat }
import gunbc.spark.serving_install_paths {
  SparkServingUserUnitSpec,
  spark_serving_user_unit_spec,
}
import gunbc.spark.serving_unit_render {
  spark_serving_user_unit_text,
  spark_serving_user_unit_content_identity,
  spark_serving_user_unit_content_wire,
  spark_serving_desired_user_unit_text,
  spark_serving_user_unit_definition_identity,
  spark_serving_definition_identity_environment_assignment,
}
import gunbc.spark.serving_desired {
  spark_serving_desired_bind_host_port, spark_serving_desired_bind_listen,
}
import gunbc.spark.serving_release { ServingContract }

// THE CONFIGURED CONTEXT WINDOW IS CAUSAL, AND THESE ARE THE ARMS THAT GO RED IF IT STOPS BEING SO.
//
// The window was declared on the serving policy and rendered nowhere: the unit carried OLLAMA_HOST
// and OLLAMA_MODELS and nothing about context, so `max_model_len` was a number standing beside a
// process it did not configure. Every claim below is stated as a DISCRIMINATION -- two windows must
// produce two different artifacts -- rather than as a substring lookup, because a containment check
// passes as soon as the digits appear anywhere and would still pass if the directive were rendered
// into a field nothing reads.
//
// Each arm is red against the pre-change tree: with no rendering, both windows produce identical
// bytes and an identical content identity.


// THE CONTRACT THESE WITNESSES RENDER AGAINST IS A FIXTURE, NOT THE FLEET'S. The fleet no longer
// declares a window or slot count -- both come from a per-realization observation, and the live
// realization has none, so the fleet's own contract is a refusal. These witnesses test the RENDERER:
// that the unit text is a function of the contract it is given. The values are the ones the fleet
// used to carry globally, kept so the assertions keep their historical meaning.
fn w_contract() -> ServingContract {
  ServingContract {
    bind: spark_serving_desired_bind_listen,
    default_context: token_count(count: 1048576),
    serving_slots: slots(n: 4),
  }
}

fn spec_with_window(window: TokenCount) -> SparkServingUserUnitSpec {
  spark_serving_user_unit_spec(
    bind_host_port: spark_serving_desired_bind_host_port() as NonEmptyStr,
    default_context: window,
    serving_slots: w_contract().serving_slots,
  )
}

fn spec_with_slots(slots: PositiveSlotCount) -> SparkServingUserUnitSpec {
  spark_serving_user_unit_spec(
    bind_host_port: spark_serving_desired_bind_host_port() as NonEmptyStr,
    default_context: w_contract().default_context,
    serving_slots: slots,
  )
}

fn text_with_slots(slots: PositiveSlotCount) -> String {
  spark_serving_user_unit_text(spec: spec_with_slots(slots: slots))
}

fn slots(n: Nat) -> PositiveSlotCount {
  positive_slot_count(count: positive_measure_count(predecessor: n))
}

fn text_with_window(window: TokenCount) -> String {
  spark_serving_user_unit_text(spec: spec_with_window(window: window))
}

fn content_identity_with_window(window: TokenCount) -> NonEmptyStr {
  spark_serving_user_unit_content_identity(
    wire_base64: spark_serving_user_unit_content_wire(text: text_with_window(window: window)),
  )
}

// CONTROL 1: the window reaches the bytes. Two specs differing in NOTHING but the window must not
// render the same file -- which is exactly what they did before the renderer consumed the field.
test fn the_configured_window_changes_the_unit_bytes() -> Bool {
  text_with_window(window: token_count(count: 8192)) != text_with_window(window: token_count(count: 131072))
    && text_with_window(window: token_count(count: 131072)) == text_with_window(window: token_count(count: 131072))
}

// CONTROL 2: the member's identity moves with it. The write side and the observe side compare
// content identities, so a window change that did not reach this value would converge as a no-op
// against a host serving the other window.
test fn the_configured_window_changes_the_unit_content_identity() -> Bool {
  content_identity_with_window(window: token_count(count: 8192)) != content_identity_with_window(window: token_count(count: 131072))
}

// CONTROL 3: THE CAUSAL LINK ITSELF. The desired unit is the one rendered at the window the serving
// policy declares, and is NOT the one rendered at any other window. This is the claim the repair
// exists to make true: it holds only while the policy is the single authority the bytes derive
// from, and it breaks the moment someone re-authors the window beside the policy instead of
// deriving it. Stated in both directions so it cannot be satisfied by a renderer that ignores its
// argument and returns one fixed text.
test fn the_desired_unit_is_rendered_at_the_declared_window() -> Bool {
  spark_serving_desired_user_unit_text(contract: w_contract())
    == text_with_window(window: w_contract().default_context)
    && spark_serving_desired_user_unit_text(contract: w_contract()) != text_with_window(window: token_count(count: 4096))
}


// CONTROL 4: THE SLOT COUNT REACHES THE BYTES, and it is stated separately from the window rather
// than folded into a spec that varies both. A witness that changes two fields at once cannot tell
// which one the renderer consumed, so this arm holds the window at the declared value and varies
// ONLY serving_slots. Without it the OLLAMA_NUM_PARALLEL directive could stop being rendered and
// every other claim in this file would stay green -- which is precisely the condition the window
// arms were written to prevent for the window, one axis late.
//
// Stated in both directions, so a renderer that ignores its argument and returns one fixed text
// fails the equality half rather than passing the inequality half by accident.
test fn the_slot_count_changes_the_unit_bytes() -> Bool {
  text_with_slots(slots: slots(n: 0)) != text_with_slots(slots: slots(n: 3))
    && text_with_slots(slots: slots(n: 3)) == text_with_slots(slots: slots(n: 3))
}

// CONTROL 5: the member identity moves with the slot count too. The write and observe sides compare
// content identities, so a slot change that reached the text but not the identity would converge as
// a no-op against a host serving a different concurrency.
test fn the_slot_count_changes_the_unit_content_identity() -> Bool {
  spark_serving_user_unit_content_identity(
    wire_base64: spark_serving_user_unit_content_wire(text: text_with_slots(slots: slots(n: 0))),
  ) != spark_serving_user_unit_content_identity(
    wire_base64: spark_serving_user_unit_content_wire(text: text_with_slots(slots: slots(n: 3))),
  )
}

// CONTROL 6: the causal link for the concurrency axis. The desired unit is rendered at the slot
// count the serving policy declares and at no other, so the policy stays the single authority the
// bytes derive from.
test fn the_desired_unit_is_rendered_at_the_declared_slot_count() -> Bool {
  spark_serving_desired_user_unit_text(contract: w_contract())
    == text_with_slots(slots: w_contract().serving_slots)
    && spark_serving_desired_user_unit_text(contract: w_contract()) != text_with_slots(slots: slots(n: 0))
}

// The invocation marker is derived from the typed spec and rendered into the unit. Hashing the
// rendered bytes here would be circular because those bytes contain the marker itself; this control
// makes the well-founded direction executable and goes red if the marker stops reaching the file.
test fn the_unit_stamps_its_typed_definition_identity_into_the_invocation() -> Bool {
  let spec = spec_with_window(window: token_count(count: 131072))
  let assignment = spark_serving_definition_identity_environment_assignment(spec: spec)
  string_contains(s: spark_serving_user_unit_text(spec: spec), pattern: assignment as String)
    && string_contains(
      s: assignment as String,
      pattern: spark_serving_user_unit_definition_identity(spec: spec) as String,
    )
}

test fn the_running_definition_identity_changes_with_the_typed_spec() -> Bool {
  spark_serving_user_unit_definition_identity(spec: spec_with_window(window: token_count(count: 8192)))
    != spark_serving_user_unit_definition_identity(spec: spec_with_window(window: token_count(count: 131072)))
}
