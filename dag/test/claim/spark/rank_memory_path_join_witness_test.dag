module test.claim.spark.rank_memory_path_join_witness_test

import std.types { Bool, String, NonEmptyStr, List }
import gunbc.fleet_intent_network { operator_host_srv9, operator_host_srv10 }
import extdeps.nvidia.cuda_driver { CudaQuerySucceeded }
import extdeps.nvidia.gpu_direct_rdma { gpu_direct_rdma_capability }
import extdeps.nvidia.nccl { NcclMemoryPathAgreed, NcclGpuDirectDisabled }
import gunbc.spark.serving_rank_observe {
  ObservedRankSubject, observed_rank_subject,
  RankGpuDirectCapabilityReceipt, RankCudaAttributeReading, RankNcclMemoryPathReceipt,
}
import gunbc.spark.glm_group_b_relaunch_cli {
  RankMemoryPathReading, RankMemoryPathRead, RankMemoryPathProvenanceMismatch, rank_memory_path_reading,
}

// ── THE JOIN REFUSES EVIDENCE FROM TWO SUBJECTS ────────────────────────────────────────────────
//
// The live route addresses one pinned container for every leg, so it never produces a mismatched
// pair; that is exactly why the refusal has to be exercised with SUPPLIED receipts. Two incarnations
// of one container name on one host differ only by id, and that is the red: a stop and recreate
// between the capability read and the log capture.

fn capability_from(s: ObservedRankSubject) -> RankGpuDirectCapabilityReceipt {
  RankGpuDirectCapabilityReceipt {
    from: s,
    device_api: RankCudaAttributeReading { reply: "116 0 0 0 0", outcome: CudaQuerySucceeded { value: 0 } },
    dma_buf: RankCudaAttributeReading { reply: "124 0 0 0 0", outcome: CudaQuerySucceeded { value: 0 } },
    capability: gpu_direct_rdma_capability(
      platform: "GB10" as NonEmptyStr,
      device_api: CudaQuerySucceeded { value: 0 },
      dma_buf: CudaQuerySucceeded { value: 0 },
    ),
  }
}

fn nccl_from(s: ObservedRankSubject) -> RankNcclMemoryPathReceipt {
  RankNcclMemoryPathReceipt {
    from: s,
    reading: NcclMemoryPathAgreed { path: NcclGpuDirectDisabled { read_from: "NET/IB : GPU Direct RDMA Disabled for HCA 0 'rocep1s0f1'" as NonEmptyStr }, readings: 1 },
  }
}

data incarnation_a: ObservedRankSubject = observed_rank_subject(host: operator_host_srv9, container: "0f3a9c1d2e4b" as NonEmptyStr)
data incarnation_b: ObservedRankSubject = observed_rank_subject(host: operator_host_srv9, container: "7b2e5a90c813" as NonEmptyStr)
data other_host_same_id: ObservedRankSubject = observed_rank_subject(host: operator_host_srv10, container: "0f3a9c1d2e4b" as NonEmptyStr)

test fn a_capability_and_a_log_from_different_incarnations_refuse() -> Bool {
  match rank_memory_path_reading(capability: capability_from(s: incarnation_a), nccl: nccl_from(s: incarnation_b)) {
    RankMemoryPathProvenanceMismatch { capability_from: _, nccl_from: _ } => true
    RankMemoryPathRead { facet: _ } => false
  }
}

test fn a_capability_and_a_log_from_different_hosts_refuse() -> Bool {
  match rank_memory_path_reading(capability: capability_from(s: incarnation_a), nccl: nccl_from(s: other_host_same_id)) {
    RankMemoryPathProvenanceMismatch { capability_from: _, nccl_from: _ } => true
    RankMemoryPathRead { facet: _ } => false
  }
}

// THE GREEN CONTROL: the same two receipts from one subject join, so the reds above are refusing on
// provenance alone and not on anything else in the fixture.
test fn a_capability_and_a_log_from_one_incarnation_join() -> Bool {
  match rank_memory_path_reading(capability: capability_from(s: incarnation_a), nccl: nccl_from(s: incarnation_a)) {
    RankMemoryPathRead { facet: _ } => true
    RankMemoryPathProvenanceMismatch { capability_from: _, nccl_from: _ } => false
  }
}
