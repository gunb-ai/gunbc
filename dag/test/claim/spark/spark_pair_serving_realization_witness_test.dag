module test.claim.spark.spark_pair_serving_realization_witness

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.docker { DockerMount, BindMount, VolumeMount, TmpfsMount }
import extdeps.docker.cli { DockerEnvAssignment }
import extdeps.docker.images.sparkrun_vllm_ds4_gb10 { sparkrun_vllm_ds4_gb10_baked_interface_env_names, sparkrun_vllm_ds4_gb10_digest_sha256_hex, gunbc_spark_pair_runtime_dockerfile }
import gunbc.spark.pair_serving_realization {
  SparkPairRealization, SparkPairRealized, SparkPairRealizationRefused,
  SparkPairHostRealization, SparkPairUnitRender, SparkPairUnitRendered, SparkPairUnitRenderRefused,
  spark_pair_realizations, spark_pair_container_env_covers_every_baked_name,
  spark_pair_realization, spark_pair_head_unit_file, spark_pair_container_spec, spark_pair_container_env,
}
import gunbc.spark.pair_serving_desired {
  spark_pair_serving_unit_with, SeqCapacityMeasured,
  SparkPairServingUnit, SparkPairServingUnitReady, SparkPairServingUnitRefused,
  spark_pair_serving_engine_args,
}
import gunbc.spark.fabric_switch_observed { FabricGroupA }
import extdeps.huggingface.hub { HubRepoId, HubModelRepo }
import gunbc.spark.model_snapshot_acquisition {
  ModelSnapshotDesired, ModelSnapshotPinned, ModelSnapshotUnpinned, glm_5_3_flash_snapshot,
  SnapshotPlacement, HubCachePlacement, spark_hub_cache_root,
}

fn w_first() -> SparkPairRealization? { first(spark_pair_realizations()) }

// THE CONTROLLED FIXTURE, AND WHY THE UNIT-FILE TESTS BELOW NEED ONE NOW. The live desired roster
// refuses -- its sequence capacity is unmeasured for GLM-5.3-Flash, and its weights snapshot is
// unobserved -- so nothing on the live path renders a unit file, and every structural assertion about
// unit ORDERING would silently become vacuous if it kept reading that path. The shape of a rendered
// unit is a fact about the renderer, not about today's fleet state, so it is asserted against a
// fixture that supplies both missing facts explicitly. That separation is the point: one test says
// the live roster refuses, the others say what the renderer produces when it does not.
// THE FIXTURE'S REPO IS DEEPSEEK'S, AND IT NAMED GLM WHILE THIS WITNESS ASSERTED NO GLM APPEARS. The
// rendered unit derives its model path from this snapshot, so a GLM repo put the string "GLM" into the
// very text the assertions require to be absent -- and the commit that corrected those assertions
// added an annotation calling this "the DeepSeek-shaped pair route" without changing the repo sitting
// beside it. The prose and the data disagreed, which is the defect that commit existed to fix,
// committed inside the fix.
//
// THE UNPINNED FIXTURE BELOW KEEPS ITS GLM REPO DELIBERATELY: that test asserts a refusal for a
// missing revision and never inspects rendered text, so the repo it names is immaterial to what it
// establishes -- and changing it would suggest the repo mattered there.
//
// THE FIXTURE DECLARES ITS PLACEMENT BECAUSE THE SNAPSHOT NOW HAS ONE, and a fixture that omitted it
// would not compile -- which is the type doing its job. The Hub-cache placement is the right one here:
// this fixture stands for the DeepSeek-shaped pair route, whose weights genuinely live in the Hub cache
// layout (measured on the serving head, `models--deepseek-ai--DeepSeek-V4-Flash/snapshots/<rev>`), and
// the local-directory placement belongs to the canary arm instead.
data w_fixture_snapshot: ModelSnapshotDesired = ModelSnapshotPinned {
  identity: "fixture-model" as NonEmptyStr,
  repo: HubRepoId { kind: HubModelRepo, path: "deepseek-ai/DeepSeek-V4-Flash" as NonEmptyStr },
  revision: "fixture0000000000000000000000000000000000" as NonEmptyStr,
  revision_provenance: "controlled fixture: this witness asserts renderer shape, never a resolved revision" as NonEmptyStr,
  placement: HubCachePlacement { cache_root: spark_hub_cache_root },
}

fn w_fixture_unit() -> SparkPairServingUnit {
  spark_pair_serving_unit_with(group: FabricGroupA, capacity: SeqCapacityMeasured {
    max_num_seqs: 32,
    basis: "controlled fixture: this witness asserts renderer shape, never a measured capacity" as NonEmptyStr,
  })
}

fn w_unit_text(u: SparkPairUnitRender) -> String {
  match u {
    SparkPairUnitRendered { unit_name: _, text: t } => t
    SparkPairUnitRenderRefused { unit_name: _, cause: _ } => ""
  }
}

fn w_realized(f: fn(SparkPairHostRealization, List<SparkPairHostRealization>) -> Bool) -> Bool {
  match Present { value: spark_pair_realization(unit: w_fixture_unit()) } {
    Absent => false
    Present { value: r } =>
      match r {
        SparkPairRealizationRefused { group: _, cause: _ } => false
        SparkPairRealized { group: _, head: h, workers: ws } => f(h, ws)
      }
  }
}

// THE LIVE ROSTER RENDERS DEEPSEEK, AND THIS WITNESS IS WHY IT DOES. A revision of this branch
// pointed the production served-model name at GLM-5.3-Flash while this module still built its
// runtime from `extdeps.docker.images.sparkrun_vllm_ds4_gb10` -- whose vLLM was measured on
// 2026-09-08 not to register `Glm5NextForConditionalGeneration` at all. This witness was RED on that
// revision, and it was right: the production planner had begun admitting a tuple that cannot start.
//
// IT WOULD HAVE BEEN EASY TO MAKE GREEN THE WRONG WAY, by relaxing it to accept whatever the roster
// now renders. That would have blessed the impossible combination instead of reporting it. The
// combination is removed instead: GLM is reached through gunbc.spark.serving_arm_launch, whose plan
// producer admits its exact arm through `serving_arm_admits_for` and then through the measured standing in
// gunbc.spark.serving_compatibility -- the walls that refuse an image that cannot load the checkpoint.
test fn the_live_roster_renders_the_model_its_image_can_actually_load() -> Bool {
  match w_first() {
    Absent => false
    Present { value: r } =>
      match r {
        SparkPairRealizationRefused { group: _, cause: _ } => false
        SparkPairRealized { group: _, head: h, workers: _ } => {
          let t = w_unit_text(u: h.unit)
          string_contains(s: t, pattern: "--served-model-name deepseek-v4-flash:iq3s-split")
            && string_contains(s: t, pattern: "--tool-call-parser deepseek_v4")
            && string_contains(s: t, pattern: "--kv-cache-dtype fp8_ds_mla")
            && !string_contains(s: t, pattern: "GLM")
            && !string_contains(s: t, pattern: "glm")
        }
      }
  }
}

// AN UNPINNED SNAPSHOT CANNOT RENDER A SERVE LINE, asserted with the capacity supplied so that the
// pin is the only thing missing. A path under `snapshots/<revision>/` needs a revision; composing one
// out of a branch name would name a directory whose contents change under it, which is why the
// renderer refuses rather than substituting `main`.
test fn the_head_unit_refuses_while_the_desired_snapshot_carries_no_revision() -> Bool {
  match w_fixture_unit() {
    SparkPairServingUnitRefused { group: _, cause: _ } => false
    SparkPairServingUnitReady { group: _, engine: _, head: h, workers: _ } =>
      match spark_pair_head_unit_file(
        args: spark_pair_serving_engine_args(tensor_parallel: 4, max_num_seqs: 32),
        snapshot: ModelSnapshotUnpinned {
          identity: "fixture-unpinned" as NonEmptyStr,
          repo: HubRepoId { kind: HubModelRepo, path: "zai-org/GLM-5.3-Flash" as NonEmptyStr },
          cause: "fixture" as NonEmptyStr,
        },
        head: h.lane,
        spec: spark_pair_container_spec(env: spark_pair_container_env(lane: h.lane)),
      ) {
        SparkPairUnitRendered { unit_name: _, text: _ } => false
        SparkPairUnitRenderRefused { unit_name: _, cause: c } =>
          string_contains(s: c as String, pattern: "no pinned revision")
      }
  }
}

// THE POSITIVE CONTROL: with the snapshot supplied, the serve line renders and carries THIS MODEL'S
// identity, parser and KV layout -- all three derived from extdeps.zhipu.glm_5_3_flash rather than
// from a reading of whatever was running on 2026-09-03. The refusal above would be satisfied by a
// renderer that refused everything; this is what stops that.
// THIS WITNESS ASSERTED THE WRONG MODEL FOR THIS ROUTE, and it had been red on the required lane for
// hours before anyone read the lane rather than a local run. It demanded GLM's identity, GLM's tool
// parser and a plain `fp8` cache from the PAIR route -- a state an earlier revision of this branch
// briefly created by pointing that route at GLM, and which was deliberately reverted because the
// image this route builds from was measured not to register GLM at all. The revert restored the
// production rows and left the witness asserting the reverted state, so the test was faithfully
// checking a configuration the branch had decided was wrong.
//
// A WITNESS THAT SURVIVES A REVERT IS THE REVERT'S OWN BLIND SPOT. Reverting the rows was the correct
// call and it was incomplete: the assertion is part of the claim, so restoring one without the other
// leaves the corpus asserting both directions at once, and the only thing that noticed was CI.
//
// IT NOW ASSERTS WHAT THE ROUTE SERVES: DeepSeek's served-model name and tool parser, the fp8_ds_mla
// layout its Multi-head Latent Attention requires, no GLM identity anywhere in the rendered text, and
// the batch budget main pinned -- which the previous form explicitly asserted was ABSENT, so it would
// have gone red against main's change even had the model question been settled.
test fn the_rendered_serve_line_carries_this_models_identity_parser_and_layout() -> Bool {
  match w_fixture_unit() {
    SparkPairServingUnitRefused { group: _, cause: _ } => false
    SparkPairServingUnitReady { group: _, engine: _, head: h, workers: _ } =>
      match spark_pair_head_unit_file(
        args: spark_pair_serving_engine_args(tensor_parallel: 4, max_num_seqs: 32),
        snapshot: w_fixture_snapshot,
        head: h.lane,
        spec: spark_pair_container_spec(env: spark_pair_container_env(lane: h.lane)),
      ) {
        SparkPairUnitRenderRefused { unit_name: _, cause: _ } => false
        SparkPairUnitRendered { unit_name: _, text: t } =>
          string_contains(s: t, pattern: "--served-model-name deepseek-v4-flash:iq3s-split")
            && string_contains(s: t, pattern: "--tool-call-parser deepseek_v4")
            && string_contains(s: t, pattern: "--kv-cache-dtype fp8_ds_mla")
            && !string_contains(s: t, pattern: "GLM")
            && !string_contains(s: t, pattern: "glm47")
            && string_contains(s: t, pattern: "--max-num-batched-tokens 2048")
      }
  }
}

// PLACEMENT RELEASED BEFORE LAUNCH IS AN ORDERING FACT OF THE UNIT: start the container, stop the
// Ray session, start the head at the pair's rail-0 endpoint, then the engine; stdout appended to
// the host log the pool line is read from; on-failure restart is what waits for the worker.
test fn the_head_unit_releases_the_ray_session_before_the_engine_and_captures_stdout() -> Bool {
  w_realized(f: fn(h, _ws) {
    let t = w_unit_text(u: h.unit)
    string_contains(s: t, pattern: join([
        "ExecStartPre=/usr/bin/docker start gunbc-spark-pair\n",
        "ExecStartPre=/usr/bin/docker exec gunbc-spark-pair /opt/env/bin/ray stop --force\n",
        "ExecStartPre=/usr/bin/docker exec gunbc-spark-pair /opt/env/bin/ray start --head --node-ip-address=192.168.110.14 --port=6379 --num-cpus=20 --num-gpus=1 --object-store-memory=38867934412\n",
        "ExecStart=/usr/bin/docker exec gunbc-spark-pair /opt/env/bin/vllm serve",
      ], ""))
      && string_contains(s: t, pattern: "StandardOutput=append:/var/log/gunbc/spark-pair-head.log")
      && string_contains(s: t, pattern: "Restart=on-failure")
      && string_contains(s: t, pattern: "Requires=docker.service")
  })
}

// EVERY WORKER HOLDS ITS RANK WITH `ray start --block` AND IS ALWAYS RESTARTED, which is the rejoin
// supervision the polling script did by hand; group A has three workers, each joining the head's rail
// address from its own.
test fn every_worker_unit_blocks_on_its_rank_and_rejoins_by_restart() -> Bool {
  w_realized(f: fn(_h, ws) {
    length(ws) == 3
      && all(ws, w => string_contains(s: w_unit_text(u: w.unit), pattern: "Restart=always"))
      && any(ws, w => string_contains(s: w_unit_text(u: w.unit), pattern: "ExecStart=/usr/bin/docker exec gunbc-spark-pair /opt/env/bin/ray start --address=192.168.110.14:6379 --node-ip-address=192.168.110.11 --num-cpus=20 --num-gpus=1 --object-store-memory=38867934412 --block"))
      && any(ws, w => string_contains(s: w_unit_text(u: w.unit), pattern: "--node-ip-address=192.168.110.13 "))
  })
}

// EVERY INTERFACE NAME THE IMAGE BAKES IS OVERRIDDEN AT CREATE, FROM THE OBSERVED LANE, ON BOTH HOSTS.
// This is the 2026-09-05 drift made unwritable: an identity join against the image's own roster of
// baked names, with the head's values equal to its leg netdev, RDMA device and rail address.
test fn the_container_env_overrides_every_baked_interface_name_from_the_fabric() -> Bool {
  w_realized(f: fn(h, ws) {
    spark_pair_container_env_covers_every_baked_name(env: h.container.env)
      && all(ws, w => spark_pair_container_env_covers_every_baked_name(env: w.container.env))
      && any(h.container.env, e => (e.name as String) == "TP_SOCKET_IFNAME" && e.value == "enp1s0f1np1")
      && any(h.container.env, e => (e.name as String) == "NCCL_SOCKET_IFNAME" && e.value == "enp1s0f1np1")
      && any(h.container.env, e => (e.name as String) == "NCCL_IB_HCA" && e.value == "rocep1s0f1")
      && any(h.container.env, e => (e.name as String) == "VLLM_HOST_IP" && e.value == "192.168.110.14")
      && any(ws, w => any(w.container.env, e => (e.name as String) == "VLLM_HOST_IP" && e.value == "192.168.110.11"))
      && any(h.container.env, e => (e.name as String) == "RAY_memory_monitor_refresh_ms" && e.value == "0")
  })
}

// THE CONTAINER IS CREATED FROM THE RUNTIME BUILT ON THE PINNED DIGEST, with the run configuration
// the pair was observed with, plus the JIT cache bound to a host directory so a recreate keeps it.
test fn the_container_is_created_from_the_built_runtime_with_the_observed_run_config() -> Bool {
  w_realized(f: fn(h, _ws) {
    let a = h.create.arguments
    (h.create.program as String) == "/usr/bin/docker"
      && any(a, x => x == "gunbc-spark-pair-runtime:ray-2.58.0")
      && string_contains(s: gunbc_spark_pair_runtime_dockerfile(), pattern: join(["FROM aidendle94/sparkrun-vllm-ds4-gb10@sha256:", sparkrun_vllm_ds4_gb10_digest_sha256_hex as String, "\nRUN /opt/env/bin/python3 -m pip install --no-cache-dir ray[default]==2.58.0\n"], ""))
      && any(a, x => x == "--network") && any(a, x => x == "--ipc") && any(a, x => x == "memlock=-1:-1")
      && any(a, x => x == "/dev/infiniband:/dev/infiniband:rwm") && any(a, x => x == "IPC_LOCK")
      && any(a, x => x == "type=bind,src=/home/briansrls/.cache/huggingface/hub,dst=/weights,ro")
      && any(a, x => x == "type=bind,src=/var/lib/gunbc/spark-pair/jit-cache,dst=/cache/huggingface")
      && !any(a, x => string_contains(s: x, pattern: "dsv4-ray:local"))
  })
}

// THE BAKED ROSTER IS NOT EMPTY, so the coverage join above can go red.
test fn the_image_names_the_interface_variables_it_bakes() -> Bool {
  length(sparkrun_vllm_ds4_gb10_baked_interface_env_names) == 6
    && !spark_pair_container_env_covers_every_baked_name(env: [DockerEnvAssignment { name: "TP_SOCKET_IFNAME" as NonEmptyStr, value: "x" }])
}
