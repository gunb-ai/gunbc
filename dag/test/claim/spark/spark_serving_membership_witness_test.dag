module test.claim.spark_serving_membership_witness

import std.types { String, List, Bool, Int, NonEmptyStr }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6 }
import gunbc.ownership { Ownership, Owned, Ensured }
import gunbc.membership_reconcile {
  MembershipPlan,
  MemberAdded,
  MemberChanged,
  MemberRemoved,
  MemberRemovalRefused,
  membership_write_count,
  membership_removal_count,
  membership_refusal_count,
  membership_change_count,
  membership_added_count,
  membership_effects,
  EffectsReady,
  ApplyRefused,
  MemberEffect,
  EffectAdd,
  EffectReplace,
  EffectRemove,
}
import gunbc.spark.serving_desired {
  spark_serving_desired_release_admission,
  SparkServingDesiredAdmitted,
  SparkServingDesiredRefused,
  spark_serving_occurrence,
  spark_serving_desired_model_artifact,
  spark_serving_automation_principal,
}
import gunbc.spark.serving_install_paths { spark_serving_user_unit_path }
import gunbc.spark.serving_unit_identity { spark_serving_unit_name }
import gunbc.spark.serving_membership {
  SparkServingMember,
  SparkServingMemberAt,
  SparkServingResourceAddress,
  SparkServingRuntimeRootAddress,
  SparkServingUserUnitAddress,
  SparkServingModelSlotAddress,
  SparkServingLingerAddress,
  spark_serving_member,
  spark_serving_member_key,
  spark_serving_desired_members,
  spark_serving_membership_reconcile,
  spark_serving_membership_effects,
  spark_serving_membership_noop,
  spark_serving_user_unit_state_digest,
  spark_serving_executor_linger_state_digest,
  spark_serving_serving_principal,
  spark_serving_primary_model_slot,
  spark_serving_user_unit_file_write_intent,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn w_host() -> HostIdentity {
  operator_host_srv5
}

fn w_principal() -> NonEmptyStr {
  spark_serving_serving_principal()
}

fn w_runtime_member(state: NonEmptyStr, ownership: Ownership) -> SparkServingMember {
  spark_serving_member(
    host: w_host(),
    principal: w_principal(),
    address: SparkServingRuntimeRootAddress,
    state_digest: state,
    ownership: ownership,
  )
}

fn w_unit_member(state: NonEmptyStr, ownership: Ownership) -> SparkServingMember {
  spark_serving_member(
    host: w_host(),
    principal: w_principal(),
    address: SparkServingUserUnitAddress,
    state_digest: state,
    ownership: ownership,
  )
}

fn w_linger_member(state: NonEmptyStr) -> SparkServingMember {
  spark_serving_member(
    host: w_host(),
    principal: w_principal(),
    address: SparkServingLingerAddress,
    state_digest: state,
    ownership: Ensured,
  )
}

fn plan_has_change_for_address(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  address: SparkServingResourceAddress,
  from_digest: NonEmptyStr,
  to_digest: NonEmptyStr,
) -> Bool {
  any(plan.actions, a =>
    match a {
      MemberChanged { at: _, from: f, to: t } =>
        f.address == address
          && t.address == address
          && f.state_digest == from_digest
          && t.state_digest == to_digest
      _ => false
    }
  )
}

fn plan_has_add_for_address(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  address: SparkServingResourceAddress,
) -> Bool {
  any(plan.actions, a => match a { MemberAdded { at: _, to: m } => m.address == address  _ => false })
}

fn plan_has_refused_address(
  plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>,
  address: SparkServingResourceAddress,
) -> Bool {
  any(plan.actions, a =>
    match a {
      MemberRemovalRefused { from: m, cause: _ } => m.address == address
      _ => false
    }
  )
}

data w_noop_note: String = "Already-correct host converging to ZERO effects is the claim most likely to be quietly false — reinstall-every-time is indistinguishable from correct from the outside. Asserts plan AND membership_effects both empty."

test fn w_spark_serving_desired_release_admits_for_admission_backed_witnesses() -> Bool {
  match spark_serving_desired_release_admission() {
    SparkServingDesiredAdmitted { serving_release: _ } => true
    SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_noop_when_converged() -> Bool {
  match spark_serving_desired_release_admission() {
    SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = spark_serving_occurrence(host: w_host(), serving_release: r)
      let desired = spark_serving_desired_members(occurrence: occ, serving_release: r)
      let plan = spark_serving_membership_reconcile(desired: desired, observed: desired)
      spark_serving_membership_noop(plan: plan)
        && match spark_serving_membership_effects(plan: plan) {
          EffectsReady { effects: es } => count(es) == 0
          ApplyRefused { refusals: _ } => false
        }
    SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_noop_when_converged_synthetic_fixture() -> Bool {
  let m = w_runtime_member(state: "v1" as NonEmptyStr, ownership: Owned)
  let plan = spark_serving_membership_reconcile(desired: [m], observed: [m])
  spark_serving_membership_noop(plan: plan)
    && match spark_serving_membership_effects(plan: plan) {
      EffectsReady { effects: es } => count(es) == 0
      ApplyRefused { refusals: _ } => false
    }
}

test fn w_spark_serving_modified_is_change_not_add() -> Bool {
  let from_unit = spark_serving_user_unit_state_digest()
  let to_unit = "unit-drifted" as NonEmptyStr
  let plan = spark_serving_membership_reconcile(
    desired: [w_unit_member(state: to_unit, ownership: Owned)],
    observed: [w_unit_member(state: from_unit, ownership: Owned)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: SparkServingUserUnitAddress,
    from_digest: from_unit,
    to_digest: to_unit,
  )
    && !plan_has_add_for_address(plan: plan, address: SparkServingUserUnitAddress)
    && membership_change_count(plan: plan) == 1
    && membership_added_count(plan: plan) == 0
}

test fn w_spark_serving_runtime_upgrade_is_change_not_remove_add() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: [w_runtime_member(state: "ollama-0.33.0" as NonEmptyStr, ownership: Owned)],
    observed: [w_runtime_member(state: "ollama-0.32.9" as NonEmptyStr, ownership: Owned)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: SparkServingRuntimeRootAddress,
    from_digest: "ollama-0.32.9" as NonEmptyStr,
    to_digest: "ollama-0.33.0" as NonEmptyStr,
  )
    && !plan_has_add_for_address(plan: plan, address: SparkServingRuntimeRootAddress)
    && membership_added_count(plan: plan) == 0
}

test fn w_spark_serving_added_when_runtime_absent() -> Bool {
  match spark_serving_desired_release_admission() {
    SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = spark_serving_occurrence(host: w_host(), serving_release: r)
      let desired = spark_serving_desired_members(occurrence: occ, serving_release: r)
      let plan = spark_serving_membership_reconcile(desired: desired, observed: [])
      membership_write_count(plan: plan) == count(desired)
        && membership_removal_count(plan: plan) == 0
    SparkServingDesiredRefused { cause: _ } => false
  }
}

test fn w_spark_serving_added_when_runtime_absent_synthetic_fixture() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: [w_runtime_member(state: "v1" as NonEmptyStr, ownership: Owned)],
    observed: [],
  )
  plan_has_add_for_address(plan: plan, address: SparkServingRuntimeRootAddress)
}

test fn w_spark_serving_ensured_linger_converges_on_drift() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: [w_linger_member(state: spark_serving_executor_linger_state_digest())],
    observed: [w_linger_member(state: "linger=drifted" as NonEmptyStr)],
  )
  plan_has_change_for_address(
    plan: plan,
    address: SparkServingLingerAddress,
    from_digest: "linger=drifted" as NonEmptyStr,
    to_digest: spark_serving_executor_linger_state_digest(),
  )
    && membership_removal_count(plan: plan) == 0
    && membership_refusal_count(plan: plan) == 0
}

test fn w_spark_serving_ensured_linger_removal_refused() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: [],
    observed: [w_linger_member(state: spark_serving_executor_linger_state_digest())],
  )
  plan_has_refused_address(plan: plan, address: SparkServingLingerAddress)
    && membership_removal_count(plan: plan) == 0
    && membership_refusal_count(plan: plan) == 1
}

test fn w_spark_serving_key_is_host_principal_address_not_value() -> Bool {
  let a = w_runtime_member(state: "content-a" as NonEmptyStr, ownership: Owned)
  let b = w_runtime_member(state: "content-b" as NonEmptyStr, ownership: Owned)
  spark_serving_member_key(member: a) == spark_serving_member_key(member: b)
    && string_contains(
      s: spark_serving_member_key(member: a),
      pattern: spark_serving_serving_principal() as String,
    )
    && string_contains(s: spark_serving_member_key(member: a), pattern: "runtime-root")
}

test fn w_spark_serving_key_differs_when_host_changes() -> Bool {
  let shared = "same-content" as NonEmptyStr
  let a = spark_serving_member(
    host: operator_host_srv5,
    principal: w_principal(),
    address: SparkServingRuntimeRootAddress,
    state_digest: shared,
    ownership: Owned,
  )
  let b = spark_serving_member(
    host: operator_host_srv6,
    principal: w_principal(),
    address: SparkServingRuntimeRootAddress,
    state_digest: shared,
    ownership: Owned,
  )
  spark_serving_member_key(member: a) != spark_serving_member_key(member: b)
}

test fn w_spark_serving_user_unit_path_uses_unit_identity_authority() -> Bool {
  string_contains(s: spark_serving_user_unit_path() as String, pattern: spark_serving_unit_name)
}

test fn w_spark_serving_unit_write_intent_carries_typed_spec() -> Bool {
  let intent = spark_serving_user_unit_file_write_intent()
  intent.path == spark_serving_user_unit_path()
    && intent.spec.service_type == ("simple" as NonEmptyStr)
    && intent.spec.exec_subcommand == ("serve" as NonEmptyStr)
    && string_contains(s: intent.spec.bind_host_port as String, pattern: ":")
}

test fn w_spark_serving_change_projects_effect_replace() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: [w_runtime_member(state: "v2" as NonEmptyStr, ownership: Owned)],
    observed: [w_runtime_member(state: "v1" as NonEmptyStr, ownership: Owned)],
  )
  match spark_serving_membership_effects(plan: plan) {
    EffectsReady { effects: es } =>
      count(es) == 1
        && any(es, e =>
             match e {
               EffectReplace { from: f, to: t } =>
                 f.address == SparkServingRuntimeRootAddress
                   && f.state_digest == ("v1" as NonEmptyStr)
                   && t.state_digest == ("v2" as NonEmptyStr)
               EffectAdd { to: _ } => false
               EffectRemove { from: _ } => false
             })
    ApplyRefused { refusals: _ } => false
  }
}

test fn w_spark_serving_model_slot_address_is_primary() -> Bool {
  match spark_serving_desired_release_admission() {
    SparkServingDesiredAdmitted { serving_release: r } =>
      let occ = spark_serving_occurrence(host: w_host(), serving_release: r)
      let desired = spark_serving_desired_members(occurrence: occ, serving_release: r)
      any(
        desired,
        m =>
          match m.address {
            SparkServingModelSlotAddress { slot: slot } =>
              slot == spark_serving_primary_model_slot
            _ => false
          },
      )
    SparkServingDesiredRefused { cause: _ } => false
  }
}
