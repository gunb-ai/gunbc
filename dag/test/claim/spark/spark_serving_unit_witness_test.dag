module test.claim.spark_serving_unit_witness

import std.types { Bool, String, NonEmptyStr, Int, List }
import std.measure {
  TokenCount, token_count, token_count_value,
  PositiveSlotCount, positive_slot_count, positive_measure_count,
}
import extdeps.network.ipv4 { ipv4_address }
import gunbc.fleet_intent_network { operator_host_srv7, operator_host_srv8 }
import gunbc.spark.fabric_link_desired { fabric_rail0, fabric_endpoint_on }
import gunbc.spark.cell_role { spark_serving_cell_hosts }
import gunbc.spark.serving_unit_observed {
  ServingUnit,
  serving_unit_front_door,
  serving_unit_weights_peer,
  serving_unit_slot_plan,
  serving_unit_construct,
  serving_unit_client_endpoint,
  serving_unit_rpc_peer_wire,
  serving_unit_slot_plan_total_kv,
  serving_unit_slot_plan_per_slot,
  serving_unit_observed,
  serving_unit_observed_units,
  serving_unit_observed_slot_plan,
  serving_unit_host_is_weights_peer,
  ServingUnitThroughputBand,
  serving_unit_throughput_band,
  serving_unit_observed_throughput,
  serving_unit_throughput_meets,
}

// THE POSITIVE CONTROL THAT EVERYTHING ELSE IN THIS FILE DEPENDS ON.
//
// serving_unit_observed returns an Optional, and every claim below that matches on it would be
// satisfied VACUOUSLY by Absent -- a file full of green claims about a deployment that never
// constructed. That is the shape this corpus keeps finding and it is worth one claim of its own:
// the observed deployment EXISTS, so the conditions in its constructor were all met by the measured
// facts rather than merely not contradicted.
test fn the_observed_serving_unit_constructs() -> Bool {
  match serving_unit_observed() {
    Present { value: _ } => true
    Absent => false
  }
}

// ONE ADDRESS A CLIENT MAY HOLD, and it is the front door. The peer has no sibling accessor, so
// this is the only endpoint the model can hand anyone.
test fn the_client_endpoint_is_the_front_door_only() -> Bool {
  match serving_unit_observed() {
    Absent => false
    Present { value: d } =>
      serving_unit_client_endpoint(d: d) == "http://192.168.1.232:30000"
  }
}

// THE PEER IS ADDRESSED ON THE FABRIC, NOT THE LAN. The measured difference is 4.2 GB/min against
// 144 GB/min -- 34x -- and nothing in the served behaviour distinguishes them, so this claim is the
// only thing standing between the specified deployment and a working one that is silently slow.
test fn the_rpc_peer_is_addressed_on_the_fabric() -> Bool {
  match serving_unit_observed() {
    Absent => false
    Present { value: d } =>
      serving_unit_rpc_peer_wire(d: d) == "192.168.100.11:50052"
  }
}

// THE `-c` TRAP, ASSERTED AS THE DERIVATION IT NOW IS. The unit carries 10485760 because ten slots
// each get 1048576 -- not because someone typed 10485760 next to a 10. The operator's table records
// what the authored-pair version costs: -c 6291456 with --parallel 16 silently yields 2048 per slot.
test fn the_total_kv_budget_is_derived_from_per_slot_and_slot_count() -> Bool {
  serving_unit_slot_plan_total_kv(plan: serving_unit_observed_slot_plan) == 10485760
    && token_count_value(t: serving_unit_slot_plan_per_slot(plan: serving_unit_observed_slot_plan)) == 1048576
}

// A DISCRIMINATING RED: the silent shrink is now unwritable, because there is no second number to
// disagree. Sixteen slots at the same per-slot window derives a LARGER total, never a smaller
// per-slot window -- which is the exact inversion of the failure the operator recorded.
test fn raising_the_slot_count_cannot_shrink_the_per_slot_window() -> Bool {
  let wider = serving_unit_slot_plan(
    per_slot_context: token_count(count: 1048576),
    slots: positive_slot_count(count: positive_measure_count(predecessor: 15)))
  token_count_value(t: serving_unit_slot_plan_per_slot(plan: wider)) == 1048576
    && serving_unit_slot_plan_total_kv(plan: wider) == 16777216
}

// ================= DISCRIMINATING REDS ON THE CONSTRUCTOR =================

// A SPLIT ACROSS ONE MACHINE IS NOT A SPLIT. It is one process addressing itself over a network
// address, and it would report perfectly healthy.
test fn a_deployment_whose_two_ends_are_one_host_refuses() -> Bool {
  match fabric_rail0 {
    Absent => false
    Present { value: link } =>
      match fabric_endpoint_on(link: link, host: operator_host_srv8) {
        Absent => false
        Present { value: e } =>
          match serving_unit_construct(
            alias: "x" as NonEmptyStr,
            front_door: serving_unit_front_door(
              host: operator_host_srv8, bind_address: "192.168.1.233" as NonEmptyStr, port: 30000),
            weights_peer: serving_unit_weights_peer(
              host: operator_host_srv8, fabric_address: e.address, port: 50052),
            fabric: link,
            slot_plan: serving_unit_observed_slot_plan,
          ) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

// A PEER ADDRESSED OFF THE FABRIC REFUSES. This is the 34x claim as a wall: the deployment would
// work, so no test of its behaviour could catch it.
test fn a_peer_addressed_off_the_fabric_refuses() -> Bool {
  match fabric_rail0 {
    Absent => false
    Present { value: link } =>
      match serving_unit_construct(
        alias: "x" as NonEmptyStr,
        front_door: serving_unit_front_door(
          host: operator_host_srv7, bind_address: "192.168.1.232" as NonEmptyStr, port: 30000),
        weights_peer: serving_unit_weights_peer(
          host: operator_host_srv8,
          fabric_address: ipv4_address(octet1: 192, octet2: 168, octet3: 1, octet4: 233),
          port: 50052),
        fabric: link,
        slot_plan: serving_unit_observed_slot_plan,
      ) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

// C1, ASKED AS A QUESTION A ROSTER CAN ANSWER. The host holding weights must never be published as
// a serving endpoint by some OTHER roster that does not know this deployment exists -- which is
// exactly how .233 would come to accept a load, given it also runs an unrelated ollama on :11434
// with roughly 105 of 121 GiB already committed and swap disabled.
test fn the_weights_peer_host_is_identifiable_as_one() -> Bool {
  serving_unit_host_is_weights_peer(
    deployments: serving_unit_observed_units(), host: operator_host_srv8)
    && !serving_unit_host_is_weights_peer(
         deployments: serving_unit_observed_units(), host: operator_host_srv7)
}


// THE THROUGHPUT OBSERVATION IS A BAND AND A THRESHOLD READS ITS LOW END.
//
// 58.8 and 50.9 were the same configuration on two runs. A threshold compared against the high end
// passes or fails depending on which run is quoted, which makes the check a statement about the
// quoting rather than about the unit.
test fn a_threshold_is_met_only_when_the_low_end_meets_it() -> Bool {
  match serving_unit_observed_throughput() {
    Absent => false
    Present { value: b } =>
      serving_unit_throughput_meets(band: b, threshold_tok_s: 45)
        && !serving_unit_throughput_meets(band: b, threshold_tok_s: 55)
  }
}

// A DISCRIMINATING RED: an inverted band has no constructor, so "low 59, high 50" -- the transcription
// error that would silently invert every threshold comparison above -- cannot be authored.
test fn an_inverted_throughput_band_refuses() -> Bool {
  match serving_unit_throughput_band(
    slots: serving_unit_observed_slot_plan.slots,
    aggregate_low_tok_s: 59,
    aggregate_high_tok_s: 50,
    per_stream_tok_s: 6,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}


// THE CROSS-ROSTER REFUSAL, WHICH IS THE ONLY PLACE C1 CAN ACTUALLY BE CHECKED.
//
// The unit's own constructor makes the weights peer unaddressable WITHIN the unit -- there is no
// accessor returning it as an endpoint. What that cannot see is a SEPARATE roster naming the same
// host as a single-host serving cell, and that is the real path by which the peer would accept work.
//
// The measurement makes this concrete rather than theoretical: the peer's host answers 200 on
// :11434/api/tags and offers deepseek-v4-gguf:no-h3-stop, which is precisely what the serving cell
// roster selects. Each roster would be locally correct; the load would be fatal, because with about
// 105 of 121 GiB already committed to weights and swap disabled there is no spill -- the OOM kill
// takes the front door down with it, since the front door cannot serve without these layers.
//
// This claim goes RED the moment a weights-peer host is added to the serving roster, which is the
// regression control the constructor cannot provide.
test fn no_serving_cell_is_also_a_weights_peer() -> Bool {
  !any(spark_serving_cell_hosts(), h =>
    serving_unit_host_is_weights_peer(deployments: serving_unit_observed_units(), host: h))
}
