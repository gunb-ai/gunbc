module test.claim.spark.serving_critical_path_witness

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import gunbc.spark.serving_critical_path {
  PowerEnvelope, spark_system_power_supply, spark_soc_thermal_envelope,
  spark_gpu_power_envelope, spark_peripheral_power_envelope,
  SaturationClaim, GpuComputeSaturated, GpuComputeUnderutilised,
  ClaimConstruction, ClaimConstructible, ClaimNotConstructible,
  busy_fraction_constructs, power_below_ceiling_excludes_saturation,
  PrefillScalingSample, ConcurrencyWitness, spark_group_a_prefill_scaling_samples,
  SampleAdmission, AdmittedToIsolatedFit, ExcludedFromIsolatedFit, sample_admission,
  admitted_scaling_samples,
  AffineFit, PrefillScalingStanding, AffineWithinObservedRange, ScalingUnderObserved,
  prefill_scaling_standing, predicted_micros,
  PerStepFixedCost, PerStepCostBoundedAbove, PerStepCostUnmeasured,
  spark_group_a_per_step_fixed_cost, per_step_upper_micros,
  ScalingSampleExcludedFromIsolatedFit, spark_group_a_co_tenant_outlier,
  CriticalPathMechanism, GrossRankStraggler, HostDispatchGaps, BulkInterconnectBandwidth,
  TokenIndependentStepLatency, TokenProportionalCompute, TokenProportionalCollectivePayload,
  CollectiveSynchronisationWait, MemoryOrKernelEfficiency, PowerOrThermalThrottle, CoTenantDelay,
  MechanismStanding, NotObservedAtThisGrain, WeakenedWithinMeasuredRange, Observed, Unresolved,
  cold_prefill_mechanism_standing,
  BudgetTrade, budget_trade,
  CriticalPathPartition, PartitionIncomplete, PartitionEstablished,
  spark_group_a_cold_prefill_partition, partition_may_calibrate, faster_link_addresses_partition,
}

// THE INFERENCE THAT WAS WRONG IS NOW UNWRITABLE. An earlier version excluded compute saturation
// because power did not rise with load. Low whole-GPU power cannot exclude saturation of a narrow
// bottleneck, and kernel residency decides neither direction.
test fn neither_saturation_nor_underutilisation_is_constructible_from_coarse_telemetry() -> Bool {
  (match busy_fraction_constructs(claim: GpuComputeSaturated) {
     ClaimNotConstructible { because: b } => string_contains(s: b as String, pattern: "residency, not work")
     ClaimConstructible { from: _ } => false
   })
    && (match busy_fraction_constructs(claim: GpuComputeUnderutilised) {
          ClaimNotConstructible { because: b } => string_contains(s: b as String, pattern: "narrow bottleneck")
          ClaimConstructible { from: _ } => false
        })
    && (match power_below_ceiling_excludes_saturation() {
          ClaimNotConstructible { because: b } => string_contains(s: b as String, pattern: "bounds whole-chip utilisation")
          ClaimConstructible { from: _ } => false
        })
}

// THE ENVELOPES NEST, and adding them is the first mistake available. The 120W GPU sits INSIDE the
// 140W SoC TDP, which sits inside what a 240W supply feeds.
test fn the_power_envelopes_nest_rather_than_sum() -> Bool {
  spark_system_power_supply.watts == 240
    && spark_soc_thermal_envelope.watts == 140
    && spark_gpu_power_envelope.watts == 120
    && spark_gpu_power_envelope.watts < spark_soc_thermal_envelope.watts
    && string_contains(s: spark_gpu_power_envelope.covers as String, pattern: "nested inside")
}

// CONCURRENCY COUNT IS NOT THE ADMISSION TEST. Both excluded samples ran at the same maximum running
// count as admitted ones; what excludes them is a quarter-million cached tokens accounted inside a
// window whose own probe was ~1500 tokens. A rule keyed on running count would admit both.
test fn admission_is_keyed_on_foreign_accounting_not_on_concurrency() -> Bool {
  let excluded = filter(spark_group_a_prefill_scaling_samples, s =>
    match sample_admission(s: s) { ExcludedFromIsolatedFit { cause: _ } => true  AdmittedToIsolatedFit => false })
  length(excluded) == 2
    && fold(excluded, init: true, f: (acc, s) => acc && s.cached_tokens > 100000)
    && fold(excluded, init: true, f: (acc, s) => acc && s.concurrency.max_running == 2)
    && length(admitted_scaling_samples()) == 10
}

// THE FIT IS DERIVED, NOT WRITTEN DOWN. This is the discriminator against the module it replaced,
// which carried 250ms and 950 tok/s as literals nothing could falsify. The slope here is a least
// squares projection of the sample rows: ~1.056 ms per token, i.e. ~947 tok/s marginal.
test fn the_marginal_rate_is_a_projection_of_the_samples() -> Bool {
  match prefill_scaling_standing() {
    ScalingUnderObserved { cause: _ } => false
    AffineWithinObservedRange { fit: f } =>
      f.sample_count == 10
        && f.micros_per_thousand_tokens >= 1000000
        && f.micros_per_thousand_tokens <= 1120000
        && f.intercept_micros >= 100000
        && f.intercept_micros <= 210000
  }
}

// AND THE PER-STEP BOUND IS JUSTIFIED BY THOSE RESIDUALS RATHER THAN CHOSEN. Every admitted sample
// lands within the declared per-step upper bound of the fit. That is the whole argument for calling
// the 88ms boundary crossing indistinguishable from zero: it is smaller than the error the fit
// already carries everywhere else. If a future sample missed by more than the bound, this goes red
// and the bound has to be restated -- which is the property a written-down 95000 would not have.
test fn the_per_step_bound_is_the_fits_own_worst_residual() -> Bool {
  let bound = per_step_upper_micros(c: spark_group_a_per_step_fixed_cost)
  match prefill_scaling_standing() {
    ScalingUnderObserved { cause: _ } => false
    AffineWithinObservedRange { fit: f } =>
      fold(admitted_scaling_samples(), init: true, f: (acc, s) => {
        let err = predicted_micros(fit: f, tokens: s.computed_tokens) - s.wall_micros
        acc && err < bound && err > (0 - bound)
      })
  }
}

// THE PER-STEP COST IS A BOUND, AND CANNOT BE READ AS A POINT ESTIMATE. The carrier records that it
// is not distinguishable from zero, so a consumer that wants a single number has to confront that.
test fn the_per_step_cost_is_bounded_and_not_distinguishable_from_zero() -> Bool {
  match spark_group_a_per_step_fixed_cost {
    PerStepCostUnmeasured { cause: _ } => false
    PerStepCostBoundedAbove { upper_micros: u, distinguishable_from_zero: d } => u == 95000 && !d
  }
}

// SO THE BUDGET TRADE COMES OUT AS AN INTERVAL. A smaller budget strictly shortens the co-tenant
// stall; whether it lengthens total prefill is exactly what the unresolved per-step term decides, so
// the two bounds straddle it instead of a single total asserting more than was measured.
test fn the_budget_trade_is_derived_and_returns_an_interval() -> Bool {
  match prefill_scaling_standing() {
    ScalingUnderObserved { cause: _ } => false
    AffineWithinObservedRange { fit: f } =>
      match budget_trade(fit: f, cost: spark_group_a_per_step_fixed_cost, prompt_tokens: 158764, budget_tokens: 512) {
        Absent => false
        Present { value: small } =>
          match budget_trade(fit: f, cost: spark_group_a_per_step_fixed_cost, prompt_tokens: 158764, budget_tokens: 2048) {
            Absent => false
            Present { value: big } =>
              small.step_micros < big.step_micros
                && small.total_prefill_micros_low < small.total_prefill_micros_high
                && small.total_prefill_micros_high > big.total_prefill_micros_low
          }
      }
  }
}

// TOKEN SCALING WEAKENS ONLY THE TOKEN-INDEPENDENT MEMBER. This is the correction that split the old
// lumped collective candidate: payload cost and compute both scale with tokens, so neither is
// decided, and saying otherwise was the over-claim.
test fn scaling_weakens_the_token_independent_term_and_decides_neither_proportional_one() -> Bool {
  (match cold_prefill_mechanism_standing(m: TokenIndependentStepLatency) {
     WeakenedWithinMeasuredRange { by: b } => string_contains(s: b as String, pattern: "2048-token scheduler boundary")
     _ => false
   })
    && (match cold_prefill_mechanism_standing(m: TokenProportionalCompute) { Unresolved { needs: _ } => true  _ => false })
    && (match cold_prefill_mechanism_standing(m: TokenProportionalCollectivePayload) { Unresolved { needs: _ } => true  _ => false })
    && (match cold_prefill_mechanism_standing(m: CollectiveSynchronisationWait) { Unresolved { needs: _ } => true  _ => false })
    && (match cold_prefill_mechanism_standing(m: MemoryOrKernelEfficiency) { Unresolved { needs: _ } => true  _ => false })
}

// THE OUTLIER IS RETAINED AS THE ONLY MAGNITUDE EVIDENCE FOR CO-TENANT DELAY, which is why it is not
// simply dropped from the population. Its standing is Observed while every proportional mechanism is
// Unresolved -- the one thing this sweep actually caught happening.
test fn the_co_tenant_outlier_is_kept_and_is_the_only_observed_mechanism() -> Bool {
  spark_group_a_co_tenant_outlier.computed_tokens == 4840
    && spark_group_a_co_tenant_outlier.wall_micros == 290960000
    && (match cold_prefill_mechanism_standing(m: CoTenantDelay) {
          Observed { by: b } => string_contains(s: b as String, pattern: "not yet parameterised")
          _ => false
        })
}

// THE PARTITION STILL REFUSES TO CALIBRATE, and the rerun on an idle engine is one of the named
// missing requirements rather than a footnote -- every admitted sample had a co-tenant present.
test fn the_partition_remains_incomplete_and_names_the_idle_rerun() -> Bool {
  !partition_may_calibrate(p: spark_group_a_cold_prefill_partition)
    && !faster_link_addresses_partition(p: spark_group_a_cold_prefill_partition)
    && (match spark_group_a_cold_prefill_partition {
          PartitionIncomplete { missing: m } => length(m) == 5
          PartitionEstablished { critical: _, evidence: _ } => false
        })
    && fold(spark_group_a_prefill_scaling_samples, init: true, f: (acc, s) => acc && s.concurrency.max_running > 0)
}
