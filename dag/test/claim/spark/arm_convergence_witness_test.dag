module test.claim.spark.arm_convergence_witness_test

import std.types { Bool, String, List, NonEmptyStr, Int }
import v2.std.optional { Present, Absent }
import product.host_identity { HostIdentity }
import gunbc.spark.host_effect_quiescence { ArgvRun, ArgvRan, ArgvLegDidNotRun }
import std.goal_assessment { GoalAssessment, GoalSatisfied, GoalDiverged, GoalIndeterminate, GoalAssessmentRefused }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import gunbc.spark.arm_convergence {
  ArmRankDesired, ArmRankObservation, ArmRankRead, ArmRankUnread, ArmRankObserved, ArmFact, FactRead, FactAbsent, FactUnread,
  ArmRealizedRanks, ArmRankDeviation, ArmRankUnknown, ArmAssessRefusal, ArmRankReadbackRefusal, ArmConvergeApply,
  ArmCommittedReading, ArmCommitted, ArmNotCommitted,
  arm_rank_observe, arm_planned_unit_sha,
  arm_structural_assessment, arm_assessment_after_readback, arm_converge_decision, arm_converge_apply_restart, arm_converge_apply_removals, ArmRestart, ArmRestartWhole, ArmNoRestart, ArmRetiredRemoval,
  arm_committed_reading, arm_committed_reproduced,
}

// ── ARM RECOVERY AS CONVERGENCE: THE DECISION, OVER SUPPLIED OBSERVATIONS ─────────────────────
//
// Every observation below is SUPPLIED at the assessment's interface (DESIGN section 3: a witness
// discriminates at one interface), written in a compact key=value form this file reads into
// ArmRankObserved. The producer's route -- the typed legs of arm_rank_observe building those facts from
// real operation results -- is its own claim, w_the_typed_observe_reads_each_fact_from_its_own_operation,
// over a supplied host that answers each operation's argv.

data w_hosts: List<String> = ["srv6", "srv5", "srv8", "srv7"]

fn w_desired() -> List<ArmRankDesired> {
  map(w_hosts, h => ArmRankDesired {
    host: h as HostIdentity,
    unit_name: if h == "srv6" { "gunbc-glm53-stair-head.service" as NonEmptyStr } else { "gunbc-glm53-stair-rank.service" as NonEmptyStr },
    container_name: "glm53-stair" as NonEmptyStr,
    is_head: h == "srv6",
  })
}

data w_sha_planned: String = "1111111111111111111111111111111111111111111111111111111111111111"
data w_sha_other: String = "2222222222222222222222222222222222222222222222222222222222222222"

// One rank's facts in key=value form, read by w_obs below into the observation the assessment consumes.
fn w_leg(unit_sha: String, active: String, container: String, committed: String) -> String {
  w_leg_retired(unit_sha: unit_sha, active: active, container: container, committed: committed, retired: [] as List<String>)
}

fn w_leg_retired(unit_sha: String, active: String, container: String, committed: String, retired: List<String>) -> String {
  join([
    "desired_unit_sha=", w_sha_planned, "\n",
    "unit_sha=", unit_sha, "\n",
    "active_state=", active, "\n",
    "container=", container, "\n",
    "committed=", committed, "\n",
    join(map(retired, f => join(["retired_file=", f, "\n"], "")), ""),
    w_end, "\n",
  ], "")
}

data w_end: String = "end"

fn w_fact(lines: List<String>, key: String) -> ArmFact {
  match first(flat_map(lines, l => if starts_with(s: l, prefix: join([key, "="], "")) { [substring(s: l, start: length(key) + 1, end: length(l))] } else { [] as List<String> })) {
    Absent => FactUnread { cause: join(["no ", key], "") }
    Present { value: v } =>
      if v == "absent" { FactAbsent }
      else if starts_with(s: v, prefix: "unread:") { FactUnread { cause: substring(s: v, start: 7, end: length(v)) } }
      else { FactRead { value: v } }
  }
}

fn w_obs(host: String, stdout: String) -> ArmRankObservation {
  let lines = split(s: stdout, delimiter: "\n")
  if !any(lines, l => l == w_end) { ArmRankUnread { host: host as HostIdentity, cause: "the observation did not complete" } }
  else {
    ArmRankRead { observed: ArmRankObserved {
      host: host as HostIdentity,
      desired_unit_sha: w_fact(lines: lines, key: "desired_unit_sha"),
      unit_sha: w_fact(lines: lines, key: "unit_sha"),
      active_state: w_fact(lines: lines, key: "active_state"),
      container: w_fact(lines: lines, key: "container"),
      committed: w_fact(lines: lines, key: "committed"),
      retired_files: flat_map(lines, l => if starts_with(s: l, prefix: "retired_file=") { [substring(s: l, start: 13, end: length(l))] } else { [] as List<String> }),
    } }
  }
}

fn w_running(host: String) -> ArmRankObservation {
  w_obs(host: host, stdout: w_leg(unit_sha: w_sha_planned, active: "active", container: "0123456789ab true 0", committed: join(["fp8-16 ", w_sha_planned], "")))
}

fn w_decide(observed: List<ArmRankObservation>) -> UpsertDecision<ArmConvergeApply> {
  arm_converge_decision(desired: w_desired(), assessment: arm_structural_assessment(desired: w_desired(), observed: observed), after_removal: false)
}

// THE PLAN IS THE WHOLE ARM: Apply, carrying every desired rank, head included, in the desired order.
fn w_applies_the_whole_arm(d: UpsertDecision<ArmConvergeApply>) -> Bool {
  match d {
    Apply { plan: p } => match arm_converge_apply_restart(p: p) {
      ArmRestartWhole { ranks: ranks } =>
        count(ranks) == count(w_hosts)
          && all(zip_hosts(ranks: ranks), x => x)
          && count(filter(ranks, r => r.is_head)) == 1
      ArmNoRestart => false
    }
    Noop => false
    Refuse { reason: _ } => false
  }
}

fn zip_hosts(ranks: List<ArmRankDesired>) -> List<Bool> {
  map(w_hosts, h => any(ranks, r => (r.host as String) == h))
}

fn w_refuses_naming(d: UpsertDecision<ArmConvergeApply>, fragment: String) -> Bool {
  match d {
    Refuse { reason: r } => string_contains(s: r as String, pattern: fragment)
    Noop => false
    Apply { plan: _ } => false
  }
}

// ── TONIGHT'S LESSON (valiant-crab-775, 2026-10-05), THE RED A PER-HOST REPAIR FAILS ────────────
//
// At 03:27Z the head was started alone: the workers had failed at 02:48Z, so the head timed out at the
// rendezvous with 1 of 4 joined. The observation that preceded it: the head's unit present as planned
// but inactive with no container, every worker's unit failed with no container. The plan must restart
// the WHOLE arm -- a plan naming only the head is the red, and ArmConvergeApply has no field that could
// name a subset (its sole constructor is the decision, which always hands it the whole roster).
test fn w_a_stopped_head_beside_failed_workers_restarts_the_whole_arm() -> Bool {
  w_applies_the_whole_arm(d: w_decide(observed: [
    w_obs(host: "srv6", stdout: w_leg(unit_sha: w_sha_planned, active: "inactive", container: "absent", committed: "absent")),
    w_obs(host: "srv5", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
    w_obs(host: "srv8", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
    w_obs(host: "srv7", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
  ]))
}

// THE SAME LESSON FROM THE OTHER SIDE: a head that IS running beside workers that are not is still the
// whole arm's restart -- the head's incarnation joined no epoch the workers are in.
test fn w_a_running_head_beside_stopped_workers_restarts_the_whole_arm() -> Bool {
  w_applies_the_whole_arm(d: w_decide(observed: [
    w_running(host: "srv6"),
    w_obs(host: "srv5", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
    w_obs(host: "srv8", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
    w_obs(host: "srv7", stdout: w_leg(unit_sha: w_sha_planned, active: "failed", container: "absent", committed: "absent")),
  ]))
}

// THE STATE NO LEFTOVER KIND MATCHED (run 37254736596): three ranks rolled back and running, the head
// carrying the restored unit file but stopped. The retired classifier refused it and held Group A down;
// here it is simply GoalDiverged, and the plan restarts the whole arm.
test fn w_the_mixed_state_that_matched_no_leftover_kind_converges() -> Bool {
  let observed = [
    w_obs(host: "srv6", stdout: w_leg(unit_sha: w_sha_planned, active: "inactive", container: "absent", committed: "absent")),
    w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7"),
  ]
  w_applies_the_whole_arm(d: w_decide(observed: observed))
    && match arm_structural_assessment(desired: w_desired(), observed: observed) {
      GoalDiverged { deviations: _ } => true
      GoalSatisfied { evidence: _ } => false
      GoalIndeterminate { known_deviations: _, unknowns: _ } => false
      GoalAssessmentRefused { cause: _ } => false
    }
}

// EVERY RANK RUNNING IS NOT YET ONE EPOCH: a rank whose container has restarted is a deviation, and so is
// a rank the readback refused on an otherwise structurally satisfied arm -- both restart the whole arm.
test fn w_a_restarted_container_or_a_refused_readback_restarts_the_whole_arm() -> Bool {
  let restarted = [w_running(host: "srv6"), w_running(host: "srv5"),
    w_obs(host: "srv8", stdout: w_leg(unit_sha: w_sha_planned, active: "active", container: "0123456789ab true 1", committed: "absent")),
    w_running(host: "srv7")]
  let all_running = [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7")]
  let after_readback = arm_assessment_after_readback(
    structural: arm_structural_assessment(desired: w_desired(), observed: all_running),
    refusals: [ArmRankReadbackRefusal { host: "srv8" as HostIdentity, cause: "the transport verdict is unread" }])
  w_applies_the_whole_arm(d: w_decide(observed: restarted))
    && w_applies_the_whole_arm(d: arm_converge_decision(desired: w_desired(), assessment: after_readback, after_removal: false))
}

// A UNIT FILE THAT IS NOT THE DESIRED STEP'S is a deviation even with everything running: the arm
// serves another step.
test fn w_another_steps_unit_restarts_the_whole_arm() -> Bool {
  w_applies_the_whole_arm(d: w_decide(observed: [
    w_obs(host: "srv6", stdout: w_leg(unit_sha: w_sha_other, active: "active", container: "0123456789ab true 0", committed: "absent")),
    w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7"),
  ]))
}

// THE POSITIVE CONTROL: every rank as planned, active, one running never-restarted container, readback
// clean -> Noop. Nothing is touched.
test fn w_a_realized_arm_is_noop() -> Bool {
  let all_running = [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7")]
  match arm_converge_decision(desired: w_desired(), assessment: arm_assessment_after_readback(
    structural: arm_structural_assessment(desired: w_desired(), observed: all_running), refusals: [] as List<ArmRankReadbackRefusal>), after_removal: false) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

// ── UNKNOWN IS NEVER ABSENT, AND REMEDIATION OVER IT IS REFUSED ────────────────────────────────
//
// A container the daemon could not be asked about, or a leg that never completed, refuses -- and it
// refuses EVEN WHEN another rank's deviation is proven, because unknowns win over deviations
// (std.goal_assessment assess_by_deviations_and_unknowns). The RED this guards: an inspect failure read
// as "no container" would plan a restart over a rank whose state nobody read.
test fn w_an_unread_rank_refuses_naming_it_and_is_never_read_as_absent() -> Bool {
  let unread_container = w_obs(host: "srv8", stdout: w_leg(unit_sha: w_sha_planned, active: "active", container: "unread:Cannot connect to the Docker daemon", committed: "absent"))
  let cut_off = w_obs(host: "srv7", stdout: "desired_unit_sha=x\nunit_sha=y\n")
  w_refuses_naming(d: w_decide(observed: [w_running(host: "srv6"), w_running(host: "srv5"), unread_container, w_running(host: "srv7")]), fragment: "srv8: container unread")
    && w_refuses_naming(d: w_decide(observed: [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), cut_off]), fragment: "srv7: unread")
    && w_refuses_naming(d: w_decide(observed: [
         w_obs(host: "srv6", stdout: w_leg(unit_sha: w_sha_planned, active: "inactive", container: "absent", committed: "absent")),
         w_running(host: "srv5"), unread_container, w_running(host: "srv7")]), fragment: "srv8: container unread")
    && match cut_off { ArmRankUnread { host: _, cause: _ } => true  ArmRankRead { observed: _ } => false }
}

// THE ROSTER IS AN IDENTITY JOIN: three observations for four ranks, or the right count on the wrong
// hosts, refuses rather than assessing a different arm.
test fn w_a_roster_that_is_not_the_desired_arms_refuses() -> Bool {
  w_refuses_naming(d: w_decide(observed: [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8")]), fragment: "not the desired arm's roster")
    && w_refuses_naming(d: w_decide(observed: [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv9")]), fragment: "not the desired arm's roster")
}

// ── THE LAST COMMITTED ARM ───────────────────────────────────────────────────────────────────
//
// A committed arm is one step on EVERY rank; a missing record or two labels is not one. And the return
// is admitted only if the re-rendered step reproduces every recorded unit hash on its own host.
test fn w_the_committed_arm_is_one_label_on_every_rank() -> Bool {
  let all_committed = [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7")]
  let one_missing = [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"),
    w_obs(host: "srv7", stdout: w_leg(unit_sha: w_sha_planned, active: "active", container: "0123456789ab true 0", committed: "absent"))]
  let split = [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"),
    w_obs(host: "srv7", stdout: w_leg(unit_sha: w_sha_planned, active: "active", container: "0123456789ab true 0", committed: join(["fp8-64 ", w_sha_planned], "")))]
  (match arm_committed_reading(observed: all_committed) { ArmCommitted { label: l, unit_shas: s } => (l as String) == "fp8-16" && count(s) == 4  ArmNotCommitted { cause: _ } => false })
    && (match arm_committed_reading(observed: one_missing) { ArmCommitted { label: _, unit_shas: _ } => false  ArmNotCommitted { cause: c } => string_contains(s: c, pattern: "3 of 4") })
    && (match arm_committed_reading(observed: split) { ArmCommitted { label: _, unit_shas: _ } => false  ArmNotCommitted { cause: c } => string_contains(s: c, pattern: "different steps") })
}

test fn w_a_return_is_admitted_only_when_the_rerender_reproduces_the_record() -> Bool {
  let committed = arm_committed_reading(observed: [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7")])
  let same = map(w_hosts, h => w_obs(host: h, stdout: w_leg(unit_sha: w_sha_other, active: "inactive", container: "absent", committed: "absent")))
  let drifted = concat(map(["srv6", "srv5", "srv8"], h => w_obs(host: h, stdout: w_leg(unit_sha: w_sha_other, active: "inactive", container: "absent", committed: "absent"))),
    [w_obs(host: "srv7", stdout: join(["desired_unit_sha=", w_sha_other, "\nunit_sha=absent\nactive_state=inactive\ncontainer=absent\ncommitted=absent\n", w_end, "\n"], ""))])
  arm_committed_reproduced(reading: committed, rerendered: same)
    && !arm_committed_reproduced(reading: committed, rerendered: drifted)
    && !arm_committed_reproduced(reading: ArmNotCommitted { cause: "none" }, rerendered: same)
}

// ── THE TYPED OBSERVE: EACH FACT FROM ITS OWN OPERATION (review 76640; valiant-crab-775) ──────
//
// A supplied host answers each typed leg BY THE ARGV IT RECEIVES -- so the route is asserted, not only
// the answer: a leg that ran a different operation gets "unexpected argv" and its fact reads unread.
// The planned unit's hash is computed by the real sha256_hex; the host's sha256sum line is supplied as
// that same digest, so "as planned" holds only if the two realizations agree on the same octets.
data w_unit_text: String = "[Unit]\n"
// sha256 of w_unit_text, as GNU sha256sum prints it (an independent oracle for arm_planned_unit_sha).
data w_unit_sha: String = "ae6c63cff33bcfa3b6a2d6d0c9dd19521dedaa351146b1a642d2bfc9cf5a1e1f"
data w_unit_path: String = "/etc/systemd/system/gunbc-glm53-stair-head.service"
data w_record_path: String = "/var/lib/gunbc/arm-committed/gunbc-glm53-stair-head.service"
data w_inspect_json: String = "[{\"Id\":\"f7b22cace2ab\",\"Created\":\"2026-10-05T15:28:00Z\",\"Image\":\"sha256:6ef8\",\"State\":{\"Status\":\"running\",\"Running\":true,\"Paused\":false,\"Restarting\":false,\"OOMKilled\":false,\"Dead\":false,\"Pid\":380,\"ExitCode\":0,\"Error\":\"\",\"StartedAt\":\"2026-10-05T15:28:01Z\",\"FinishedAt\":\"0001-01-01T00:00:00Z\"},\"RestartCount\":0}]"

fn w_host_answers(unit_file: ArgvRun, record: ArgvRun) -> fn(List<String>) -> ArgvRun {
  fn(argv) {
    let a = join(argv, " ")
    if a == join(["/usr/bin/stat -c %F -- ", w_unit_path], "") { unit_file }
    else if a == join(["sha256sum -- ", w_unit_path], "") { ArgvRan { exit_code: 0, stdout: join([w_unit_sha, "  ", w_unit_path, "\n"], ""), stderr: "" } }
    else if a == "systemctl show gunbc-glm53-stair-head.service --property=ActiveState --value" { ArgvRan { exit_code: 0, stdout: "active\n", stderr: "" } }
    else if a == "docker container inspect glm53-stair" { ArgvRan { exit_code: 0, stdout: w_inspect_json, stderr: "" } }
    else if a == join(["/usr/bin/stat -c %F -- ", w_record_path], "") { record }
    else if a == join(["head -c 300 -- ", w_record_path], "") { ArgvRan { exit_code: 0, stdout: "fp8-16 abcd\n", stderr: "" } }
    else if starts_with(s: a, prefix: join(["/usr/bin/stat -c %F -- ", w_unit_path, ".gunbc-"], "")) { ArgvRan { exit_code: 1, stdout: "", stderr: "stat: cannot statx: No such file or directory\n" } }
    else { ArgvLegDidNotRun { cause: join(["unexpected argv: ", a], "") } }
  }
}

data w_regular: ArgvRun = ArgvRan { exit_code: 0, stdout: "regular file\n", stderr: "" }
data w_enoent: ArgvRun = ArgvRan { exit_code: 1, stdout: "", stderr: "stat: cannot statx: No such file or directory\n" }

fn w_typed(unit_file: ArgvRun, record: ArgvRun) -> ArmRankObservation {
  arm_rank_observe(run: w_host_answers(unit_file: unit_file, record: record), host: "srv6" as HostIdentity,
    unit_name: "gunbc-glm53-stair-head.service" as NonEmptyStr, container_name: "glm53-stair" as NonEmptyStr, planned_unit_sha: w_unit_sha)
}

fn w_read_fact(f: ArmFact, value: String) -> Bool {
  match f { FactRead { value: v } => v == value  FactAbsent => false  FactUnread { cause: _ } => false }
}

// THE POSITIVE ROUTE: every fact read from its own operation, the hashes agreeing, the container in the
// "<id> <running> <restarts>" shape the assessment compares, the record's text, no retired file.
test fn w_the_typed_observe_reads_each_fact_from_its_own_operation() -> Bool {
  match w_typed(unit_file: w_regular, record: w_regular) {
    ArmRankUnread { host: _, cause: _ } => false
    ArmRankRead { observed: o } =>
      w_read_fact(f: o.unit_sha, value: w_unit_sha)
        && w_read_fact(f: o.desired_unit_sha, value: w_unit_sha)
        && w_read_fact(f: o.active_state, value: "active")
        && w_read_fact(f: o.container, value: "f7b22cace2ab true 0")
        && w_read_fact(f: o.committed, value: "fp8-16 abcd")
        && count(o.retired_files) == 0
  }
}

// RED: an absent unit file and an absent record read ABSENT; a unit path stat could not examine reads
// UNREAD, never absent.
test fn w_the_typed_observe_separates_absent_from_unread() -> Bool {
  let absent = w_typed(unit_file: w_enoent, record: w_enoent)
  let refused = w_typed(unit_file: ArgvRan { exit_code: 1, stdout: "", stderr: "stat: cannot statx: Permission denied\n" }, record: w_enoent)
  (match absent { ArmRankUnread { host: _, cause: _ } => false  ArmRankRead { observed: o } =>
      (match o.unit_sha { FactAbsent => true  FactRead { value: _ } => false  FactUnread { cause: _ } => false })
        && (match o.committed { FactAbsent => true  FactRead { value: _ } => false  FactUnread { cause: _ } => false }) })
    && (match refused { ArmRankUnread { host: _, cause: _ } => false  ArmRankRead { observed: o } =>
      match o.unit_sha { FactUnread { cause: c } => string_contains(s: c, pattern: "Permission denied")  FactAbsent => false  FactRead { value: _ } => false } })
}

// THE PLANNED HASH IS THE REAL DIGEST of the planned text's octets: GNU sha256sum over the same bytes,
// so a renderer that hashed anything else (a trailing newline dropped, a different encoding) is red.
test fn w_the_planned_hash_is_sha256sum_of_the_planned_text() -> Bool {
  arm_planned_unit_sha(planned_unit_text: w_unit_text) == w_unit_sha
}

// ── THE SMALLEST ACTION PER DIVERGED COMPONENT (valiant-crab-775, 2026-10-05) ──────────────────
//
// THE STATE run 37275627394 COMMITTED OVER: every rank serving as planned, but srv6 carrying the retired
// fence and srv5/7/8 the retired unresolved-rollback marker. The retired files' absence is part of the
// desired arm, so that arm is NOT satisfied -- it is diverged in one component whose remedy is to remove
// the files. The plan is remove-only: no restart, and a removal on exactly the hosts carrying one.
fn w_running_retired(host: String, file: String) -> ArmRankObservation {
  w_obs(host: host, stdout: w_leg_retired(unit_sha: w_sha_planned, active: "active", container: "0123456789ab true 0", committed: "absent", retired: [file]))
}

fn w_tonight_after_the_hand_start() -> List<ArmRankObservation> {
  [w_running_retired(host: "srv6", file: "/etc/systemd/system/gunbc-glm53-stair-head.service.gunbc-transaction"),
   w_running_retired(host: "srv5", file: "/etc/systemd/system/gunbc-glm53-stair-rank.service.gunbc-unresolved-rollback"),
   w_running_retired(host: "srv8", file: "/etc/systemd/system/gunbc-glm53-stair-rank.service.gunbc-unresolved-rollback"),
   w_running_retired(host: "srv7", file: "/etc/systemd/system/gunbc-glm53-stair-rank.service.gunbc-unresolved-rollback")]
}

test fn w_retired_files_alone_are_removed_without_a_restart() -> Bool {
  match w_decide(observed: w_tonight_after_the_hand_start()) {
    Apply { plan: p } =>
      (match arm_converge_apply_restart(p: p) { ArmNoRestart => true  ArmRestartWhole { ranks: _ } => false })
        && count(arm_converge_apply_removals(p: p)) == 4
    Noop => false
    Refuse { reason: _ } => false
  }
}

// THE RED FOR THE OVER-REACH: a retired file beside a real serving deviation is still the WHOLE arm's
// restart (the stop removes the files too), never a removal that leaves a broken arm serving.
test fn w_a_retired_file_beside_a_serving_deviation_restarts_the_whole_arm() -> Bool {
  let observed = [
    w_obs(host: "srv6", stdout: w_leg_retired(unit_sha: w_sha_planned, active: "inactive", container: "absent", committed: "absent", retired: ["/etc/systemd/system/gunbc-glm53-stair-head.service.gunbc-transaction"])),
    w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7"),
  ]
  w_applies_the_whole_arm(d: w_decide(observed: observed))
    && match w_decide(observed: observed) { Apply { plan: p } => count(arm_converge_apply_removals(p: p)) == 1  Noop => false  Refuse { reason: _ } => false }
}

// THE PASS AFTER A REMOVAL: a retired file read back present was removed and is still there, so removing
// it again would loop; the decision refuses, naming it. The same arm with the files gone is Noop.
test fn w_a_retired_file_present_after_its_removal_refuses() -> Bool {
  let still = arm_converge_decision(desired: w_desired(), assessment: arm_structural_assessment(desired: w_desired(), observed: w_tonight_after_the_hand_start()), after_removal: true)
  let gone = arm_converge_decision(desired: w_desired(), assessment: arm_structural_assessment(desired: w_desired(),
    observed: [w_running(host: "srv6"), w_running(host: "srv5"), w_running(host: "srv8"), w_running(host: "srv7")]), after_removal: true)
  w_refuses_naming(d: still, fragment: "removed and read back present")
    && match gone { Noop => true  Apply { plan: _ } => false  Refuse { reason: _ } => false }
}
