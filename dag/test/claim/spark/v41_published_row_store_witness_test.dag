module test.claim.spark.v41_published_row_store_witness

import test.claim.vllm.vllm_engram_layout_witness { w_published_head_sizes }
import std.types { Bool, String, List, NonEmptyStr }
import std.nat { Nat }
import std.measure { byte_size, byte_size_count }
import v2.std.optional { Present, Absent }
import std.content_hash { Sha256Digest, Sha256DigestHex, serialize_content_hash }
import extdeps.deepseek.deepseek_v4_1_flash {
  deepseek_v4_1_flash_engram_sharded_entries, deepseek_v4_1_flash_engram_shard_files,
}
import gunbc.spark.v41_identity_input { V41EngramResidencyPartition }
import gunbc.spark.v41_runtime_candidate { v41_candidate_partition }
import gunbc.spark.v41_engram_row_store {
  V41PublishedSpan, V41PublishedSpanPlan, V41PublishedSpansPlanned, V41PublishedSpansUnplannable,
  V41PublishedSpanDigest, V41PublishedSpanReadings, V41PublishedSpansRead, V41PublishedSpansUnread,
  V41PublishedRowStoreKey, V41PublishedRowStoreKeyed, V41PublishedRowStoreUnestablished, V41PublishedRowStoreRefused,
  V41PublishedStoreReadings, V41PublishedStoresRead, V41PublishedStoresUnread, V41RankStoreIdentity, V41ObservedRankStore,
  v41_published_span_plan, v41_row_store_encoding_key, v41_rank_store_identity,
}
import extdeps.safetensors.format { SafetensorsShardFile }

// THE ROW-STORE ENCODING KEY, AT ITS OWN INTERFACE. The span digests and the store digests are SUPPLIED
// values -- fixtures of what a Spark's reads return -- because these claims are about what the key does
// with readings, not about a host. The plan the span readings are joined against is the REAL
// derivation over the publisher's header rows, so the regions below are the ones the mode reads. The
// spans are the encoder's input identity (joined, not hashed); the eight encoded stores key the axis.

fn w_sha(c: String) -> Sha256Digest {
  Sha256Digest { hex: join([c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c], "") as Sha256DigestHex }
}

fn w_plan(p: V41EngramResidencyPartition) -> List<V41PublishedSpan> {
  match v41_published_span_plan(partition: p, sharded: deepseek_v4_1_flash_engram_sharded_entries, shards: deepseek_v4_1_flash_engram_shard_files) {
    V41PublishedSpansPlanned { spans: s } => s
    V41PublishedSpansUnplannable { defects: _ } => [] as List<V41PublishedSpan>
  }
}

fn w_read(spans: List<V41PublishedSpan>, c: String) -> V41PublishedSpanReadings {
  V41PublishedSpansRead { host: "srv5" as NonEmptyStr, observed_at: "fixture" as NonEmptyStr, spans: map(spans, sp => V41PublishedSpanDigest { span: sp, sha256: w_sha(c: c) }) }
}

// THE SIZE EACH LIVE STORE MUST HAVE: 6 bytes of magic plus 264 per row of the rank's range, computed
// independently of v41_store_derived_size (Python, over vLLM's rank bounds for this checkpoint).
fn w_size(layer: Nat, rank: Nat) -> Nat {
  let l1 = [25344148902, 25344310470, 25344505302, 25344663702]
  let l14 = [25344806262, 25345045974, 25345200678, 25345351158]
  match get(xs: if layer == 1 { l1 } else { l14 }, index: rank) {
    Present { value: n } => n
    Absent => 0
  }
}

// ONE STORE PER (LAYER, RANK) OF THE GIVEN LAYERS, ALL WITH DIGEST c, EACH AT ITS DERIVED SIZE.
fn w_stores(layers: List<Nat>, c: String) -> V41PublishedStoreReadings {
  V41PublishedStoresRead { host: "srv5" as NonEmptyStr, observed_at: "fixture" as NonEmptyStr, stores: flat_map(layers, l => map([0, 1, 2, 3], k => V41ObservedRankStore { identity: v41_rank_store_identity(layer: l, rank: k, digest: w_sha(c: c)), size: byte_size(count: w_size(layer: l, rank: k)) })) }
}

data w_candidate_layers: List<Nat> = [1, 14]

fn w_key_with(p: V41EngramResidencyPartition, r: V41PublishedSpanReadings, st: V41PublishedStoreReadings) -> V41PublishedRowStoreKey {
  v41_row_store_encoding_key(partition: p, sharded: deepseek_v4_1_flash_engram_sharded_entries, shards: deepseek_v4_1_flash_engram_shard_files, spans: r, stores: st, head_sizes: fn() { w_published_head_sizes() })
}

fn w_key(p: V41EngramResidencyPartition, r: V41PublishedSpanReadings) -> V41PublishedRowStoreKey {
  w_key_with(p: p, r: r, st: w_stores(layers: w_candidate_layers, c: "c"))
}

fn w_hex(k: V41PublishedRowStoreKey) -> String {
  match k {
    V41PublishedRowStoreKeyed { digest: d } => serialize_content_hash(hash: d) as String
    V41PublishedRowStoreUnestablished { obligation: _ } => ""
    V41PublishedRowStoreRefused { defects: _ } => ""
  }
}

fn w_refused_with(k: V41PublishedRowStoreKey, fragment: String) -> Bool {
  match k {
    V41PublishedRowStoreRefused { defects: d } => any(d, x => (x as String).contains(fragment))
    V41PublishedRowStoreKeyed { digest: _ } => false
    V41PublishedRowStoreUnestablished { obligation: _ } => false
  }
}

// A DIFFERENT TABLE SET: layer 14's embed pair stays storage-backed, layer 1's does not.
data w_other_partition: V41EngramResidencyPartition = V41EngramResidencyPartition {
  storage_backed: ["layers.14.engram.embed.weight" as NonEmptyStr, "layers.14.engram.embed.scale" as NonEmptyStr],
  resident: [] as List<NonEmptyStr>,
}

// THE PLAN IS THE PUBLISHER'S HEADER ARITHMETIC: four spans, and layer 1's weight starts after the
// 8-byte length prefix and shard 47's 656-byte header.
test fn the_span_plan_names_the_four_storage_backed_regions() -> Bool {
  let plan = w_plan(p: v41_candidate_partition)
  length(plan) == 4
    && any(plan, sp => (sp.tensor as String) == "layers.1.engram.embed.weight" && (sp.shard as String) == "model-00047-of-00048.safetensors" && byte_size_count(b: sp.file_offset) == 664 && byte_size_count(b: sp.length) == 98305579008)
    && any(plan, sp => (sp.tensor as String) == "layers.14.engram.embed.scale" && (sp.shard as String) == "model-00048-of-00048.safetensors" && byte_size_count(b: sp.file_offset) == 8 + 664 + 98308270592)
}

fn w_unplannable_with(plan: V41PublishedSpanPlan, fragment: String) -> Bool {
  match plan {
    V41PublishedSpansUnplannable { defects: d } => any(d, x => (x as String).contains(fragment))
    V41PublishedSpansPlanned { spans: _ } => false
  }
}

// THE SHARD-BOUNDS ARMS STAY APART. Two rows for one shard is a contradiction in the supplied files;
// no row is a thing not yet read. Each is refused in its own words and never in the other's.
test fn duplicated_shard_file_rows_refuse_as_contradicted_not_unread() -> Bool {
  let plan = v41_published_span_plan(partition: v41_candidate_partition, sharded: deepseek_v4_1_flash_engram_sharded_entries,
    shards: concat(deepseek_v4_1_flash_engram_shard_files, deepseek_v4_1_flash_engram_shard_files))
  w_unplannable_with(plan: plan, fragment: "has 2 shard file rows") && !w_unplannable_with(plan: plan, fragment: "has no shard file row")
}

test fn an_absent_shard_file_row_refuses_as_unread_not_contradicted() -> Bool {
  let plan = v41_published_span_plan(partition: v41_candidate_partition, sharded: deepseek_v4_1_flash_engram_sharded_entries,
    shards: [] as List<SafetensorsShardFile>)
  w_unplannable_with(plan: plan, fragment: "has no shard file row") && !w_unplannable_with(plan: plan, fragment: "shard file rows")
}

// POSITIVE CONTROL: the exact plan read, and all eight stores read, keys.
test fn a_reading_of_exactly_the_planned_spans_keys() -> Bool {
  w_hex(k: w_key(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "a"))).length() > 0
}

// THE DISCRIMINATING RED: a digest over a different table set does not key the candidate's partition.
// Readings of layer 14's pair alone are two spans short and refuse by name.
// And a STORE set over a different table set -- layer 14's four stores alone -- refuses even with the
// right input spans: the declared layer-1 stores carry no digest.
test fn a_digest_over_a_different_table_set_does_not_key() -> Bool {
  let other = w_read(spans: w_plan(p: w_other_partition), c: "a")
  w_refused_with(k: w_key(p: v41_candidate_partition, r: other), fragment: "layers.1.engram.embed.weight")
    && w_refused_with(k: w_key(p: v41_candidate_partition, r: other), fragment: "was not read")
    && w_refused_with(k: w_key_with(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "a"), st: w_stores(layers: [14], c: "c")), fragment: "layer.1.rank.0")
}

// AND A READING OF A TENSOR THE PARTITION KEEPS RESIDENT IS FOREIGN, EVEN ALONGSIDE THE RIGHT FOUR.
test fn a_reading_of_a_resident_tensor_refuses_as_foreign() -> Bool {
  let resident_span = V41PublishedSpan { tensor: "layers.1.engram.q_weight" as NonEmptyStr, shard: "model-00047-of-00048.safetensors" as NonEmptyStr, file_offset: byte_size(count: 664 + 101377628352), length: byte_size(count: 40960) }
  w_refused_with(k: w_key(p: v41_candidate_partition, r: w_read(spans: concat(w_plan(p: v41_candidate_partition), [resident_span]), c: "a")), fragment: "is not a span this partition stores")
}

// THE RIGHT TENSOR OVER ANOTHER REGION IS NOT ITS READING.
test fn a_shifted_region_refuses() -> Bool {
  let shifted = map(w_plan(p: v41_candidate_partition), sp => V41PublishedSpan { tensor: sp.tensor, shard: sp.shard, file_offset: byte_size(count: byte_size_count(b: sp.file_offset) + 1), length: sp.length })
  w_refused_with(k: w_key(p: v41_candidate_partition, r: w_read(spans: shifted, c: "a")), fragment: "was not read")
}

// THE KEY MOVES WITH THE ENCODED STORES' BYTES AND WITH THE TABLE SET -- and NOT with the input spans'
// digests, which are joined but not hashed, nor with the order the readings arrived in.
test fn the_key_moves_with_the_bytes_and_the_table_set() -> Bool {
  let spans = w_read(spans: w_plan(p: v41_candidate_partition), c: "a")
  let base = w_hex(k: w_key_with(p: v41_candidate_partition, r: spans, st: w_stores(layers: w_candidate_layers, c: "c")))
  let other_store_bytes = w_hex(k: w_key_with(p: v41_candidate_partition, r: spans, st: w_stores(layers: w_candidate_layers, c: "d")))
  let other_span_bytes = w_hex(k: w_key_with(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "b"), st: w_stores(layers: w_candidate_layers, c: "c")))
  let reversed = w_hex(k: w_key_with(p: v41_candidate_partition, r: w_read(spans: reverse(w_plan(p: v41_candidate_partition)), c: "a"), st: w_stores(layers: [14, 1], c: "c")))
  let other_set = w_hex(k: w_key_with(p: w_other_partition, r: w_read(spans: w_plan(p: w_other_partition), c: "a"), st: w_stores(layers: [14], c: "c")))
  base.length() > 0 && other_store_bytes.length() > 0 && other_set.length() > 0
    && base != other_store_bytes && base == other_span_bytes && base == reversed && base != other_set
}

// UNREAD IS AN OBLIGATION, NEVER A KEY: unread spans, or read spans with the stores not yet encoded.
test fn an_unread_reading_is_unestablished() -> Bool {
  (match w_key(p: v41_candidate_partition, r: V41PublishedSpansUnread { obligation: "fixture: not read" as NonEmptyStr }) {
    V41PublishedRowStoreUnestablished { obligation: o } => (o as String).contains("not read")
    V41PublishedRowStoreKeyed { digest: _ } => false
    V41PublishedRowStoreRefused { defects: _ } => false
  }) && (match w_key_with(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "a"), st: V41PublishedStoresUnread { obligation: "fixture: not encoded" as NonEmptyStr }) {
    V41PublishedRowStoreUnestablished { obligation: o } => (o as String).contains("not encoded")
    V41PublishedRowStoreKeyed { digest: _ } => false
    V41PublishedRowStoreRefused { defects: _ } => false
  })
}

// A STORE OF THE WRONG SIZE IS NOT KEYED, even with every digest present: layer 14 rank 3 one byte short
// refuses by name (a digest over a file FileBackedEngramStorage could not open).
test fn a_store_of_the_wrong_size_does_not_key() -> Bool {
  let right = w_stores(layers: w_candidate_layers, c: "c")
  let short = match right {
    V41PublishedStoresRead { host: h, observed_at: t, stores: st } => V41PublishedStoresRead { host: h, observed_at: t, stores: map(st, o => if o.identity.layer == 14 && o.identity.rank == 3 { V41ObservedRankStore { identity: o.identity, size: byte_size(count: w_size(layer: 14, rank: 3) - 1) } } else { o }) }
    V41PublishedStoresUnread { obligation: o } => V41PublishedStoresUnread { obligation: o }
  }
  w_refused_with(k: w_key_with(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "a"), st: short), fragment: "layer.14.rank.3 is 25345351157 bytes and the layout derives 25345351158")
    && w_hex(k: w_key_with(p: v41_candidate_partition, r: w_read(spans: w_plan(p: v41_candidate_partition), c: "a"), st: right)).length() > 0
}
