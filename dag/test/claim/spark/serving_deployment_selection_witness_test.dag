// ── THE PRODUCTION SUBJECTS ANSWER WITH OBLIGATIONS ───────────────────────────────────────────
//
// Neither real subject returns a shape, and each is blocked on SEVERAL independent grounds rather
// than one: no quality assessment for any exact profile, no runtime feasibility observation, an
// unestablished workload demand, and ten unfunded performance dimensions. A single blocking axis
// would mean the whole question turned on one measurement.
test fn the_real_deepseek_subject_returns_obligations_rather_than_a_topology() -> Bool {
  match select_serving_deployment(input: deepseek_decision_input) {
    ServingDeploymentNeedsEvidence { needs: n, component_routes: _ } => count(n) > 0
    _ => false
  }
}

test fn the_real_glm_subject_returns_obligations_rather_than_a_shape() -> Bool {
  match select_serving_deployment(input: glm_decision_input) {
    ServingDeploymentNeedsEvidence { needs: n, component_routes: _ } => count(n) > 0
    _ => false
  }
}

test fn live_select_is_sm12_admit_with_the_extdeps_roster() -> Bool {
  match v4_1_gb10_kv_layout {
    Sm12KvLayoutAdmitted { policy: k } =>
      match k {
        KvFp8DsMlaLayout => v41_sm12_kv_cache_dtype_admitted(dtype: kv_layout_wire(k: k))
        KvAutoLayout => false
        KvFp8Layout => false
        KvFp4Layout => false
      }
    Sm12KvLayoutJoinFailed { wire: _, obligation: _ } => false
  }
    && match select_serving_deployment(input: v4_1_input_for_runtime(runtime: v4_1_runtime_published_arm64, stem: "sm12_designed")) {
      NoFeasibleServingDeployment { causes: cs } =>
        causes_name_axis(cs: cs, axis: ax_component_route)
          && !causes_name_axis(cs: cs, axis: ax_host_fit)
      _ => false
    }
    && decision_snapshot_key(input: deepseek_v4_1_decision_input)
      == decision_snapshot_key(input: v4_1_decision_input_from_sm12(
        wire: v41_sm12_kv_layout,
        admitted: v41_sm12_admitted_kv_cache_dtypes,
      ))
}

// THE DESIGNED NARROWING THIS REPLACES WAS FALSIFIED BY ITS OWN PREMISE EXPIRING, and the record is
// kept here because the narrowing had been measured and reasoned about rather than guessed.
//
// WHAT IT WAS. The runtime is this claim's discriminator, not the field, so the field enumerated two
// designed topologies -- tp4 x 2 replicas and tp8 x 1 -- rather than the twenty `fleet_admitted_topologies`
// yielded over eight hosts. The cost that motivated it was real and measured: 393,216 eval_steps and 508ms
// CPU, over the ceiling, with the cost in per-candidate route-standing production rather than in the
// selection fold.
//
// WHY IT CANNOT STAND. Both designed shapes consume EIGHT ranks. #11308 made the host fit a HARD
// CONSTRAINT over a subject-relative admissible set, and V4.1's subject holds one fabric group, so a
// shape needing eight hosts is now excluded before Pareto on host fit. The field would have reached its
// answer through host-fit exclusion and never through the runtime exclusion it exists to exercise -- a
// fixture that still returns the expected verdict for a reason the claim is not about.
//
// SO THE FIELD IS DERIVED FROM THE ADMISSIBLE SET, which cannot be wrong about host fit by construction,
// and the enumeration it yields is bounded by that set rather than by a hand-picked pair. The cost this
// re-enrols is an obligation to MEASURE from `required_floor_claim_cost` rather than to predict: the host
// set shrank at the same time, so the field is smaller than the twenty measured above, and by how much is
// not something to arithmetic here. If it lands over the ceiling again, the narrowing gets redesigned
// with shapes that FIT the admissible set, established by execution and not by inspection.
// THE DESIGNED FIELD, REBUILT TO INHABIT THE ADMISSIBLE SET RATHER THAN TO IGNORE IT. Both shapes
// consume AT MOST the four ranks the subject's admissible host set holds, so neither can be excluded
// on host fit -- which is the failure the previous hand-picked pair had, both consuming eight.
//
// tp4 x 1 IS THE SHAPE CLOSEST TO FEASIBLE, and that is why it is the one kept: it is the only
// topology whose per-rank Engram share comes within 2 GiB of the budget, so a claim over it
// exercises the real margin and reds if the memory screen ever stops excluding. A field of
// comfortably-infeasible shapes would be excluded by a wider margin and would say less.
//
// ONE TOPOLOGY, NOT TWO, AND THE SECOND ONE'S REASON DID NOT SURVIVE MEASUREMENT. A tp2 x 1 shape
// was carried alongside so the assertion would not rest on a single candidate. That rationale is
// sound where the FIELD is the claim's subject -- and it is not, for either consumer here: their
// subjects are runtime admission and the extdeps roster, and the field is incidental to both. It
// cost 14,000-odd eval steps per topology to assert nothing either claim is about, which put
// `unauthorized_v4_1_runtime_is_excluded_before_unread_axes` 7.5% over the new-witness budget at
// 77,755 against 72,300. Measured, not estimated: 163,305 steps over eight topologies, 77,755 over
// two.
//
// WHAT THIS IS NOT: a return to hand-picked topologies. The lesson of the falsified pair was that a
// designed narrowing must INHABIT its subject, not that narrowing is forbidden -- and inhabitance
// here is CHECKED BY EXECUTION rather than asserted, because each consuming claim must still reach
// its verdict through the mechanism it exists to exercise rather than through host fit. That check
// is the `ax_host_fit` conjunct in both consumers, and it is a standing control rather than
// something an author did once.
data v4_1_designed_topologies: List<TopologyShape> = [
  topology_shape(tensor_parallel_degree: 4, replica_count: 1),
]

fn v4_1_input_for_runtime(runtime: RuntimeRevision, stem: String) -> ServingDeploymentDecisionInput {
  let standings = [v4_1_profile_from_standing(runtime: runtime, standing: v4_1_gb10_kv_layout)]
  let domain = serving_deployment_domain_over_standings(
    artifacts: [artifact_deepseek_v4_1_flash_native],
    topologies: v4_1_designed_topologies,
    standings: standings,
  )
  serving_decision_input(
    field: serving_candidate_field(
      identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: stem),
      domain: domain,
      candidates: derived_candidates_for(stem: stem, domain: domain),
    ),
    evidence: pair_unit_a_evidence_current,
    quality_requirement: deepseek_v4_1_quality_requirement,
    selection_policy: deepseek_v4_1_selection_policy,
    constraints: v4_1_selection_constraints,
    constraint_authority: id_v4_1_constraint_authority,
    axes: v4_1_selection_axes,
  )
}

// ONE FOLD OVER EXCLUSION CAUSES, KEYED BY THE AXIS ASKED ABOUT. The previous shape hard-coded
// ax_authorized_runtime, and the moment a second axis had to be asked about the honest move was to
// generalise the existing fold rather than mint a parallel `causes_name_component_route` beside it.
fn causes_name_axis(cs: List<NonEmptyStr>, axis: DeclarationRef) -> Bool {
  any(cs, s => string_contains(s: s as String, pattern: declaration_ref_display_key(ref: axis)))
}

test fn unauthorized_v4_1_runtime_is_excluded_before_unread_axes() -> Bool {
  match select_serving_deployment(input: v4_1_input_for_runtime(runtime: v4_1_runtime_vllm_gb10_lead, stem: "plant_gb10_lead")) {
    NoFeasibleServingDeployment { causes: cs } => causes_name_axis(cs: cs, axis: ax_authorized_runtime)
    _ => false
  }
    && match select_serving_deployment(input: v4_1_input_for_runtime(runtime: spark_runtime, stem: "plant_spark_runtime")) {
      NoFeasibleServingDeployment { causes: cs } => causes_name_axis(cs: cs, axis: ax_authorized_runtime)
      _ => false
    }
    && match select_serving_deployment(input: v4_1_input_for_runtime(runtime: v4_1_runtime_published_arm64, stem: "plant_published_arm64")) {
      NoFeasibleServingDeployment { causes: cs } =>
        causes_name_axis(cs: cs, axis: ax_component_route)
          && !causes_name_axis(cs: cs, axis: ax_authorized_runtime)
          && !causes_name_axis(cs: cs, axis: ax_host_fit)
      _ => false
    }
    && match v4_1_runtime_published_arm64.vllm_source {
      VllmSourceRevisionUnestablished { reported_version: _, obligation: _ } => true
      VllmSourceRevisionEstablished { git: _ } => false
    }
}

test fn matching_the_authorized_v4_1_digest_does_not_establish_source() -> Bool {
  any(deepseek_v4_1_candidate_field.candidates, c =>
    authorized_v4_1_runtime_holds(c: c)
      && match c.profile.runtime.vllm_source {
        VllmSourceRevisionUnestablished { reported_version: _, obligation: _ } => true
        VllmSourceRevisionEstablished { git: _ } => false
      })
    && any(deepseek_v4_1_candidate_field.candidates, c => !authorized_v4_1_runtime_holds(c: c))
}

// ── FIXTURES ──────────────────────────────────────────────────────────────────────────────────
data suite_ref: DeclarationRef = decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref")

// AN EIGHT-HOST FIXTURE FLEET, FOR THE CLAIMS THAT ARE NOT ABOUT ADMISSIBILITY. The covering-partition
// and identity-join claims below exercise a field over eight hosts, which no production subject is
// admitted any more; a fixture subject over the eight named units keeps those claims about what they
// were about. The identities are named, not counted, and the fixture subject is a fixture arm so it
// can never be mistaken for a production subject's set.
data fixture_subject: ServingSubject = PlacedServingArm { arm: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_subject") }

fn fixture_fleet_over(hosts: List<HostIdentity>) -> FleetSnapshot {
  FleetSnapshot {
    subject: fixture_subject,
    admissible_hosts: hosts,
    bytes_per_host: spark_unified_memory_per_host,
    how: spark_unified_memory_how,
  }
}

data fixture_eight_host_fleet: FleetSnapshot = fixture_fleet_over(hosts: [
  operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8,
  operator_host_srv9, operator_host_srv10, operator_host_srv11, operator_host_srv12,
])

data fixture_fleet_ref: DeclarationRef = decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_eight_host_fleet")

fn contains_host(hosts: List<HostIdentity>, host: HostIdentity) -> Bool {
  any(hosts, h => host_identity_eq(a: h, b: host))
}

data deepseek_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.spark.serving_deployment_selection",
  decl_name: "artifact_deepseek_v4_flash_native",
  field: WholeDeclaration,
}

fn cand(name: String, art: ModelArtifact, t: TopologyShape) -> DeploymentCandidate {
  deployment_candidate(
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name),
    label: name as NonEmptyStr,
    artifact: art,
    topology: t,
  )
}

data native_tp8_x1: DeploymentCandidate = cand(name: "native_tp8_x1", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))
data native_tp4_x2: DeploymentCandidate = cand(name: "native_tp4_x2", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))
data native_tp2_x4: DeploymentCandidate = cand(name: "native_tp2_x4", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 2, replica_count: 4))
data native_tp1_x8: DeploymentCandidate = cand(name: "native_tp1_x8", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8))

// ── CONTROL 1: A PUBLIC HELPER CANNOT MINT A PASSING VERDICT ───────────────────────────────────
//
// The only way to a QualityPassed is a REPORT evaluated against a REQUIREMENT. A report is ordinary
// data -- writing down what a run produced is not a claim it passed -- and the passing arm's payload
// has no exported builder, so no importer can assert admission.
//
// THE PREVIOUS VERSION EXPORTED `serving_quality_receipt`, which took a subject, an arbitrary
// authority name and a prose note and returned an admitted receipt. Anyone could mint "quality is
// fine" and satisfy the hard quality axis with no evaluation. This row is the positive control that
// the replacement path still works; the guarantee that the OLD path is gone is that the function no
// longer exists, which the corpus's own citation and resolution walls enforce.
fn report_at(tp: Nat, divergence: Nat, score_delta: Int) -> ServingQualityReport {
  serving_quality_report(
    subject: execution_profile_of(c: cand(name: "probe", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: tp, replica_count: 1)), p: serving_parameters_current),
    suite: suite_ref,
    reference_profile: execution_profile_of(c: native_tp4_x2, p: serving_parameters_current),
    max_selected_token_divergence_millinats: divergence,
    task_score_delta_hundredths: score_delta,
    how: "fixture report" as NonEmptyStr,
  )
}

test fn a_report_within_the_bar_assesses_as_passed() -> Bool {
  match assess_quality(report: report_at(tp: 4, divergence: 0, score_delta: 0), requirement: deepseek_quality_requirement) {
    QualityPassed { verdict: _ } => true
    _ => false
  }
}

// ── CONTROL 3: A MEASURED FAILURE IS REFUSED, NOT LEFT OPEN ───────────────────────────────────
//
// A same-artifact profile that was TESTED AND FAILED is a decided negative. The previous version
// could not express it: QualityRefused fired only on artifact mismatch, so a tested-and-bad profile
// collapsed into the same absent-receipt state as one nobody had run.
test fn a_measured_quality_failure_is_failed_rather_than_unobserved() -> Bool {
  match assess_quality(report: report_at(tp: 2, divergence: 2238, score_delta: 0), requirement: deepseek_quality_requirement) {
    QualityFailed { subject: _, requirement: _, violations: vs } => count(vs) > 0
    _ => false
  }
}

test fn a_task_score_regression_is_also_a_failure() -> Bool {
  match assess_quality(report: report_at(tp: 4, divergence: 0, score_delta: -150), requirement: deepseek_quality_requirement) {
    QualityFailed { subject: _, requirement: _, violations: vs } => count(vs) > 0
    _ => false
  }
}

// ── CONTROL 2: A RECEIPT FOR ONE EXECUTION PROFILE DOES NOT ADMIT ANOTHER ──────────────────────
//
// The profile digest carries context, memory fraction, batch budget, sequence population, executor,
// KV layout, speculative policy and runtime revision. A receipt acquired at one is not transportable
// to another, which is why quality and runtime feasibility share this exact subject.
data other_runtime_parameters: ServingDecisionParameters = serving_decision_parameters(
  max_model_len: token_count(count: 300000),
  memory_request: VllmMemoryRequest { utilization: Present { value: basis_point(count: 8200) }, kv_cache_bytes: none },
  max_num_batched_tokens: token_count(count: 2048),
  max_num_seqs: 32,
  executor: ExecutorMpProfile,
  kv_layout: KvFp8DsMlaLayout,
  speculative: SpeculationOff,
  runtime: runtime_revision(image: "a different image" as NonEmptyStr, vllm_revision: "a different revision" as NonEmptyStr),
)

data wider_context_parameters: ServingDecisionParameters = serving_decision_parameters(
  max_model_len: token_count(count: 400000),
  memory_request: VllmMemoryRequest { utilization: Present { value: basis_point(count: 8200) }, kv_cache_bytes: none },
  max_num_batched_tokens: token_count(count: 2048),
  max_num_seqs: 32,
  executor: ExecutorRayProfile,
  kv_layout: KvFp8DsMlaLayout,
  speculative: SpeculationOff,
  runtime: spark_runtime,
)

fn evidence_admitting(profiles: List<ServingQualityAssessment>, w: WorkloadDemandStanding) -> ServingDeploymentEvidenceSnapshot {
  serving_evidence_snapshot(
    quality: profiles,
    runtime_feasibility: [],
    workload: w,
    fleet: fixture_eight_host_fleet,
    fleet_receipt: fixture_fleet_ref,
  )
}

test fn a_quality_receipt_is_not_transportable_across_execution_profiles() -> Bool {
  execution_profile_of(c: native_tp4_x2, p: serving_parameters_current)
    != execution_profile_of(c: native_tp4_x2, p: other_runtime_parameters)
    && execution_profile_of(c: native_tp4_x2, p: serving_parameters_current)
      != execution_profile_of(c: native_tp4_x2, p: wider_context_parameters)
    && execution_profile_of(c: native_tp4_x2, p: serving_parameters_current)
      != execution_profile_of(c: native_tp2_x4, p: serving_parameters_current)
}

// ── CONTROL 6: A MEMORY FRACTION ABOVE THE DEVICE REFUSES ─────────────────────────────────────
//
// Above 100 percent the lower-bound screen is handed more usable memory than the host has, turning an
// impossible weight profile into a passing one -- generous in the one direction it must never be.
data impossible_utilisation: ServingDecisionParameters = serving_decision_parameters(
  max_model_len: token_count(count: 300000),
  memory_request: VllmMemoryRequest { utilization: Present { value: basis_point(count: 15000) }, kv_cache_bytes: none },
  max_num_batched_tokens: token_count(count: 2048),
  max_num_seqs: 32,
  executor: ExecutorRayProfile,
  kv_layout: KvFp8DsMlaLayout,
  speculative: SpeculationOff,
  runtime: spark_runtime,
)

data over_utilised_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "over_utilised_field"),
  domain: serving_deployment_domain(artifacts: [artifact_deepseek_v4_flash_native], topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2)], parameters: impossible_utilisation),
  candidates: [native_tp4_x2],
)

test fn a_memory_fraction_above_the_device_makes_the_field_unestablished() -> Bool {
  match establish_serving_candidate_field(field: over_utilised_field) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

// ── CONTROL 5: A DUPLICATE IN THE DECLARED DOMAIN REFUSES ─────────────────────────────────────
//
// Previously two identical expected keys both matched the same single actual row, so a duplicated
// declaration passed unnoticed and the expected population was silently ambiguous.
data duplicated_domain_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "duplicated_domain_field"),
  domain: serving_deployment_domain(
    artifacts: [artifact_deepseek_v4_flash_native],
    topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2), topology_shape(tensor_parallel_degree: 4, replica_count: 2)],
    parameters: serving_parameters_current),
  candidates: [native_tp4_x2],
)

test fn a_duplicated_value_in_the_declared_domain_refuses() -> Bool {
  match establish_serving_candidate_field(field: duplicated_domain_field) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

// ── COMPLETENESS IS A JOIN, IN BOTH DIRECTIONS ────────────────────────────────────────────────
data fixture_four_covering_topologies: List<TopologyShape> = [
  topology_shape(tensor_parallel_degree: 1, replica_count: 8),
  topology_shape(tensor_parallel_degree: 2, replica_count: 4),
  topology_shape(tensor_parallel_degree: 4, replica_count: 2),
  topology_shape(tensor_parallel_degree: 8, replica_count: 1),
]

data full_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(
  artifacts: [artifact_deepseek_v4_flash_native],
  topologies: fixture_four_covering_topologies,
  parameters: serving_parameters_current,
)

data complete_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "complete_field"),
  domain: full_domain,
  candidates: [native_tp8_x1, native_tp4_x2, native_tp2_x4, native_tp1_x8],
)

data field_missing_one: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "field_missing_one"),
  domain: full_domain,
  candidates: [native_tp8_x1, native_tp4_x2, native_tp1_x8],
)

test fn the_complete_field_is_established() -> Bool {
  match establish_serving_candidate_field(field: complete_field) {
    ServingFieldEstablished => true
    ServingFieldUnestablished { causes: _ } => false
  }
}

test fn a_field_missing_a_combination_its_domain_admits_is_unestablished() -> Bool {
  match establish_serving_candidate_field(field: field_missing_one) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

data field_with_extra: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "field_with_extra"),
  domain: full_domain,
  candidates: [native_tp8_x1, native_tp4_x2, native_tp2_x4, native_tp1_x8, cand(name: "undeclared_tp2_x2", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 2, replica_count: 2))],
)

test fn a_candidate_outside_the_declared_domain_is_unestablished() -> Bool {
  match establish_serving_candidate_field(field: field_with_extra) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

// ── CONTROL 7: THE DECISION IDENTITY MOVES WITH EVERY LOAD-BEARING INPUT ───────────────────────
//
// The previous version passed identities BESIDE values and joined neither, so changing the demand
// from 300K to 400K produced a different answer under a receipt whose named authorities were
// byte-identical. This key is derived from the values themselves, so there is no second spelling.
data established_demand: WorkloadDemandStanding = WorkloadDemandEstablished {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "established_demand"),
  required_context: token_count(count: 300000),
  population: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
  reserve: context_reserve_policy(retained_context: token_count(count: 200000), reserved_output: token_count(count: 64000), tool_growth_reserve: token_count(count: 36000)),
}

data wider_established_demand: WorkloadDemandStanding = WorkloadDemandEstablished {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "wider_established_demand"),
  required_context: token_count(count: 400000),
  population: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
  reserve: context_reserve_policy(retained_context: token_count(count: 300000), reserved_output: token_count(count: 64000), tool_growth_reserve: token_count(count: 36000)),
}

data unestablished_demand: WorkloadDemandStanding = WorkloadDemandUnestablished {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "unestablished_demand"),
  scenario_value: token_count(count: 300000),
  obligation: "fixture: no derived context population" as NonEmptyStr,
}

fn passing_quality_for(tp: Nat) -> ServingQualityAssessment {
  assess_quality(report: report_at(tp: tp, divergence: 0, score_delta: 0), requirement: deepseek_quality_requirement)
}

fn input_with(field: ServingDeploymentCandidateField, w: WorkloadDemandStanding) -> ServingDeploymentDecisionInput {
  serving_decision_input(
    field: field,
    evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: w),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
    constraints: serving_selection_constraints,
    constraint_authority: id_constraint_authority,
    axes: serving_selection_axes,
  )
}

data settled_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "settled_field"),
  domain: serving_deployment_domain(artifacts: [artifact_deepseek_v4_flash_native], topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2)], parameters: serving_parameters_current),
  candidates: [native_tp4_x2],
)

// ── A DESIGNED FOUR-CANDIDATE V4.1 FIELD, FOR THE CLAIMS WHOSE SUBJECT IS NOT THE FIELD ────────
//
// MEASURED, not guessed (CI run 34794567396, required_floor_claim_cost.tsv): six claims in this suite
// and its Engram sibling carry 75.8% of their 2,947,650 eval_steps, then a 5.2x cliff, and every one of
// the six drives the LIVE V4.1 field. The cross-subject control is what identifies the cause -- the same
// claim shape costs 438,272 steps for V4.1, 46,261 for GLM and 34,956 for V4-Flash, 9.5x to 12.5x apart
// on identical assertions -- because V4.1 alone enumerates `fleet_admitted_topologies` (twenty topologies
// over eight hosts) where the others use the four-element covering cartesian.
//
// AND THE COST IS IN `routed_candidates`, NOT IN THE SELECTION FOLD. Two of the six call
// `select_serving_deployment` zero times and still cost 239k and 325k steps, because route-standing
// production runs per candidate per component either way. So only a SMALLER FIELD helps; avoiding the
// selection call does not.
//
// THIS FIELD IS DESIGNED TO DISCRIMINATE, NOT TRUNCATED. Each property the claims below assert has a way
// to fail against it:
//   FOUR candidates over TWO distinct execution contexts (tp4 and tp8, two replica counts each), so
//     `count(demands) < count(candidates)` is a real assertion -- candidates SHARE a demand rather than
//     the inequality holding trivially. A single-context field would make it vacuous; a field of one
//     would make it false.
//   the V4.1 artifact, so every candidate carries the Engram component `ComponentPlacedByRoute` and
//     `count(rc.route_standings) == count(components)` has something to align.
//   DISTINCT identities, so the keyed-roster build can actually report a duplicate if the producer ever
//     emits one.
// What it deliberately does NOT carry is the twenty-topology enumeration, because none of these claims
// is about how many topologies the fleet admits.
// WHY THERE IS NO HAND-BUILT V4.1 INPUT HERE, recorded because two successive attempts at one built it
// wrong and a third reader would try again.
//
// A V4.1 DECISION NEEDS MORE THAN A FIELD OF V4.1 CANDIDATES. First attempt used `input_with`, which
// supplies V4-FLASH axes, constraints and quality -- and the axes and constraints ARE part of the decision
// identity (DESIGN 3d), so that is a DIFFERENT decision, not a cheaper one. Second attempt supplied the
// V4.1 axes but built candidates with `cand`, which defaults `profile: serving_parameters_current` -- so
// the candidates carried a V4-Flash execution profile while the V4.1 axes read V4.1 profile facts.
//
// BOTH FAILURES COMPILED CLEAN AND WERE CAUGHT ONLY BY RUNNING. The lesson is in the construction that
// works: a V4.1 candidate must come from `derived_candidates_for` over a domain built from V4.1 PROFILE
// STANDINGS, which is what `v4_1_input_for_runtime` does. So the claims below reuse that builder -- now
// narrowed to two designed topologies -- rather than assembling an input from parts.
fn v4_1_fixture_candidate(name: String, tp: Nat, replicas: Nat) -> DeploymentCandidate {
  cand(name: name, art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: tp, replica_count: replicas))
}

data v4_1_designed_field: ServingDeploymentCandidateField = serving_candidate_field(
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "v4_1_designed_field"),
  domain: serving_deployment_domain(
    artifacts: [artifact_deepseek_v4_1_flash_native],
    topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2), topology_shape(tensor_parallel_degree: 8, replica_count: 1)],
    parameters: serving_parameters_current),
  candidates: [
    v4_1_fixture_candidate(name: "designed_tp4_x2", tp: 4, replicas: 2),
    v4_1_fixture_candidate(name: "designed_tp4_x1", tp: 4, replicas: 1),
    v4_1_fixture_candidate(name: "designed_tp8_x1", tp: 8, replicas: 1),
    v4_1_fixture_candidate(name: "designed_tp2_x4", tp: 2, replicas: 4),
  ],
)

data no_redundancy_goal_flip_constraints: List<HardConstraint> = concat(serving_selection_constraints, [
  HardConstraint { identity: constraint_no_redundancy, axis: ax_no_redundancy, bound_micro: 1 },
])

test fn changing_the_workload_changes_the_decision_identity() -> Bool {
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    != decision_snapshot_key(input: input_with(field: settled_field, w: wider_established_demand))
}

test fn changing_the_candidate_roster_changes_the_decision_identity() -> Bool {
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    != decision_snapshot_key(input: input_with(field: complete_field, w: established_demand))
}

test fn an_unchanged_input_keeps_its_decision_identity() -> Bool {
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    == decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
}

fn profile_with_layout(p: ServingDecisionParameters, k: KvLayoutPolicy) -> ServingDecisionParameters {
  serving_decision_parameters(
    max_model_len: p.max_model_len,
    memory_request: p.memory_request,
    max_num_batched_tokens: p.max_num_batched_tokens,
    max_num_seqs: p.max_num_seqs,
    executor: p.executor,
    kv_layout: k,
    speculative: p.speculative,
    runtime: p.runtime,
  )
}

test fn changing_weight_treatment_changes_the_decision_identity() -> Bool {
  let requant_art = ModelArtifact {
    identity: artifact_deepseek_v4_flash_native.identity,
    label: artifact_deepseek_v4_flash_native.label,
    footprint: artifact_deepseek_v4_flash_native.footprint,
    weight_treatment: RequantisedWeights { distinction: "identity-collision-probe" as NonEmptyStr },
    components: artifact_deepseek_v4_flash_native.components,
    upstream_total: artifact_deepseek_v4_flash_native.upstream_total,
  }
  let requant_field = serving_candidate_field(
    identity: settled_field.identity,
    domain: serving_deployment_domain(
      artifacts: [requant_art],
      topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2)],
      parameters: serving_parameters_current),
    candidates: [cand(name: "requant_same_id", art: requant_art, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))],
  )
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    != decision_snapshot_key(input: input_with(field: requant_field, w: established_demand))
}

test fn candidate_identity_includes_the_complete_profile() -> Bool {
  let t = topology_shape(tensor_parallel_degree: 4, replica_count: 1)
  match v4_1_profile_at(runtime: v4_1_runtime_vllm_gb10_lead) {
    ServingProfileSm12JoinFailed { runtime: _, standing: _ } => false
    ServingProfileReady { profile: p } =>
      !declaration_ref_eq(
        a: derived_candidate_identity(stem: "id", art: artifact_deepseek_v4_1_flash_native, t: t, profile: p),
        b: derived_candidate_identity(stem: "id", art: artifact_deepseek_v4_1_flash_native, t: t, profile: profile_with_layout(p: p, k: KvFp4Layout)),
      )
  }
}

test fn changing_constraint_bounds_changes_the_decision_identity() -> Bool {
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    != decision_snapshot_key(input: serving_decision_input(
      field: settled_field,
      evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
      quality_requirement: deepseek_quality_requirement,
      selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
      constraints: map(serving_selection_constraints, c =>
        if declaration_ref_eq(a: c.axis, b: ax_quality) {
          HardConstraint { identity: c.identity, axis: c.axis, bound_micro: c.bound_micro + 1 }
        } else { c }),
      constraint_authority: id_constraint_authority,
      axes: serving_selection_axes,
    ))
}

test fn changing_axis_goal_changes_the_decision_identity() -> Bool {
  decision_snapshot_key(input: serving_decision_input(
    field: settled_field,
    evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
    constraints: v4_1_selection_constraints,
    constraint_authority: id_constraint_authority,
    axes: v4_1_selection_axes,
  )) != decision_snapshot_key(input: serving_decision_input(
    field: settled_field,
    evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
    constraints: v4_1_selection_constraints,
    constraint_authority: id_constraint_authority,
    axes: map(v4_1_selection_axes, a =>
      if declaration_ref_eq(a: a.identity, b: ax_no_redundancy) {
        SelectionAxis { identity: a.identity, goal: LowerIsBetter }
      } else { a }),
  ))
}

test fn flipping_no_redundancy_goal_on_tp4x2_changes_feasibility() -> Bool {
  match select_serving_deployment(input: serving_decision_input(
    field: settled_field,
    evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
    constraints: no_redundancy_goal_flip_constraints,
    constraint_authority: id_constraint_authority,
    axes: v4_1_selection_axes,
  )) {
    NoFeasibleServingDeployment { causes: _ } =>
      match select_serving_deployment(input: serving_decision_input(
        field: settled_field,
        evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
        quality_requirement: deepseek_quality_requirement,
        selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
        constraints: no_redundancy_goal_flip_constraints,
        constraint_authority: id_constraint_authority,
        axes: map(v4_1_selection_axes, a =>
          if declaration_ref_eq(a: a.identity, b: ax_no_redundancy) {
            SelectionAxis { identity: a.identity, goal: LowerIsBetter }
          } else { a }),
      )) {
        ServingDeploymentNeedsEvidence { needs: n, component_routes: _ } => count(n) > 0
        _ => false
      }
    _ => false
  }
}

test fn changing_funded_axes_changes_the_decision_identity() -> Bool {
  decision_snapshot_key(input: input_with(field: settled_field, w: established_demand))
    != decision_snapshot_key(input: serving_decision_input(
      field: settled_field,
      evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
      quality_requirement: deepseek_quality_requirement,
      selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
      constraints: serving_selection_constraints,
      constraint_authority: id_constraint_authority,
      axes: v4_1_selection_axes,
    ))
}

test fn funded_axes_are_carried_not_inferred_from_constraint_authority() -> Bool {
  match select_serving_deployment(input: serving_decision_input(
    field: settled_field,
    evidence: evidence_admitting(profiles: [passing_quality_for(tp: 4)], w: established_demand),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "suite_ref"),
    constraints: v4_1_selection_constraints,
    constraint_authority: id_constraint_authority,
    axes: v4_1_selection_axes,
  )) {
    NoFeasibleServingDeployment { causes: _ } => true
    _ => false
  }
}

// ── CONTROL 9: AN UNESTABLISHED DEMAND KEEPS THE DECISION AT NEEDS-EVIDENCE ────────────────────
//
// Even beside a passing quality assessment, a scenario workload must not settle a deployment. It has
// its own hard-bounded axis so it cannot hide behind whichever other evidence is missing first.
test fn an_unestablished_workload_alone_keeps_the_decision_at_needs_evidence() -> Bool {
  match select_serving_deployment(input: input_with(field: settled_field, w: unestablished_demand)) {
    ServingDeploymentNeedsEvidence { needs: n, component_routes: _ } => count(n) > 0
    _ => false
  }
}

// AND THE UNFUNDED PERFORMANCE ROSTER DOES THE SAME. Quality passing and the workload established is
// still not enough, because ten dimensions that could change the decision have no reading. This is
// the row that stops a future selection going green on a narrow question.
test fn a_passing_quality_and_established_demand_still_need_the_performance_evidence() -> Bool {
  match select_serving_deployment(input: input_with(field: settled_field, w: established_demand)) {
    ServingDeploymentNeedsEvidence { needs: n, component_routes: _ } => count(n) > 0
    _ => false
  }
}

// ── CONTROL 10: NOTHING HERE CAN MINT A LAUNCH ────────────────────────────────────────────────
//
// The admission's positive arm is ShapeAdmittedForPlacement over a ServingDeploymentShape. There is
// no launch vocabulary in this module at all: binding replica shapes to exact hosts, failure domains
// and endpoints is the fabric's relation, and the shape carries replica ORDINALS rather than host
// identities so it cannot pretend otherwise.
test fn an_under_evidenced_decision_cannot_reach_placement() -> Bool {
  match admit_shape(s: select_serving_deployment(input: deepseek_decision_input)) {
    FabricPlacementRequired { because: _ } => true
    ShapeAdmittedForPlacement { shape: _ } => false
  }
}

// ── THE LOWER BOUND DISPROVES; IT DOES NOT ESTABLISH ──────────────────────────────────────────
test fn the_weight_bound_refuses_a_rank_that_cannot_hold_its_share() -> Bool {
  match weight_fit_of(c: native_tp1_x8, fleet: fixture_eight_host_fleet, p: serving_parameters_current) {
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => true
    _ => false
  } && match weight_fit_of(c: native_tp4_x2, fleet: fixture_eight_host_fleet, p: serving_parameters_current) {
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } => true
    _ => false
  }
}

// AN EXTERNALLY REPORTED FOOTPRINT CANNOT SUPPORT A FEASIBILITY VERDICT HERE. The 2.05-bpw figure
// came from someone else's deployment write-up; the previous version typed it identically to a byte
// count read on a Spark, so it looked exact.
test fn an_externally_reported_footprint_is_underivable_on_this_fleet() -> Bool {
  match weight_fit_of(c: cand(name: "ext", art: artifact_glm_53_flash_2bit, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8)), fleet: fixture_eight_host_fleet, p: serving_parameters_current) {
    WeightFitUnderivable { because: _ } => true
    _ => false
  } && match weight_fit_of(c: cand(name: "unread", art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2)), fleet: fixture_eight_host_fleet, p: serving_parameters_current) {
    WeightFitUnderivable { because: _ } => true
    _ => false
  }
}

// CEILING, AND THE HELPER REFUSES ZERO RANKS ITSELF rather than trusting a guard at its call site.
test fn per_rank_bytes_round_up_and_refuse_zero_ranks() -> Bool {
  match per_rank_bytes_ceiling(total: byte_size(101), ranks: 2) {
    Present { value: v } => byte_size_count(b: v) == 51
    Absent => false
  } && match per_rank_bytes_ceiling(total: byte_size(100), ranks: 2) {
    Present { value: v } => byte_size_count(b: v) == 50
    Absent => false
  } && match per_rank_bytes_ceiling(total: byte_size(1), ranks: 0) {
    Absent => true
    Present { value: _ } => false
  }
}

// ── A DEGENERATE SHAPE IS NOT A CHEAP ONE ─────────────────────────────────────────────────────
test fn a_deployment_of_no_replicas_does_not_fit_the_fleet() -> Bool {
  (match fleet_fit_of(c: cand(name: "zero_replicas", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 0)), fleet: fixture_eight_host_fleet) {
     FleetFitDegenerate { because: _ } => true
     _ => false
   })
    && (match fleet_fit_of(c: cand(name: "zero_ranks", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 0, replica_count: 2)), fleet: fixture_eight_host_fleet) {
         FleetFitDegenerate { because: _ } => true
         _ => false
       })
    && fleet_fit_admits(f: fleet_fit_of(c: native_tp4_x2, fleet: fixture_eight_host_fleet))
}

// ── RED: A SHAPE NEEDING MORE HOSTS THAN THE SUBJECT IS ADMITTED REFUSES, NAMING THE HOSTS ─────
//
// THIS IS THE FAIL-OPEN THE SCALAR CARRIED. Against the production pair unit on group A, a two-replica
// four-rank shape needs eight hosts and the subject is admitted four: the refusal carries exactly
// srv5-srv8 by identity and a shortfall of four, and the positive control -- the one-replica shape
// that runs there today -- is admitted over the same four identities. Before this change the same
// call answered true against `host_count: 8`.
test fn a_shape_wider_than_the_admissible_set_refuses_by_name() -> Bool {
  (match fleet_fit_of(c: native_tp4_x2, fleet: pair_unit_a_fleet_snapshot) {
     FleetFitExceedsAdmissible { subject: s, required: r, admissible: hs, short_by: k } =>
       serving_subject_eq(a: s, b: PairServingUnitOn { group: FabricGroupA })
         && r == 8 && k == 4
         && contains_host(hosts: hs, host: operator_host_srv5)
         && contains_host(hosts: hs, host: operator_host_srv6)
         && contains_host(hosts: hs, host: operator_host_srv7)
         && contains_host(hosts: hs, host: operator_host_srv8)
         && !contains_host(hosts: hs, host: operator_host_srv9)
         && !contains_host(hosts: hs, host: operator_host_srv10)
         && !contains_host(hosts: hs, host: operator_host_srv11)
         && !contains_host(hosts: hs, host: operator_host_srv12)
     _ => false
   })
    && (match fleet_fit_of(c: cand(name: "tp4x1_on_a", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 1)), fleet: pair_unit_a_fleet_snapshot) {
         FleetFitWithinAdmissible { subject: _, required: r, admissible: hs } =>
           r == 4 && contains_host(hosts: hs, host: operator_host_srv5) && !contains_host(hosts: hs, host: operator_host_srv9)
         _ => false
       })
}

// THE PRODUCTION SETS, BY IDENTITY IN BOTH DIRECTIONS. V4.1 resolves to the pair unit on group A
// through the dated transition row and is admitted srv5-srv8 and nothing else; the GLM canary's
// subject is admitted srv9-srv12 and nothing of group A. A set of the right size holding the wrong
// hosts is exactly what a count could not detect, so no length appears here.
test fn the_v4_1_subject_is_admitted_group_a_and_the_canary_subject_group_b() -> Bool {
  let a = pair_unit_a_fleet_snapshot.admissible_hosts
  let b = glm_canary_fleet_snapshot.admissible_hosts
  serving_subject_eq(a: pair_unit_a_fleet_snapshot.subject, b: group_a_served_artifact_transition.subject)
    && serving_subject_eq(a: glm_canary_fleet_snapshot.subject, b: glm_canary_serving_subject)
    && contains_host(hosts: a, host: operator_host_srv5) && contains_host(hosts: a, host: operator_host_srv6)
    && contains_host(hosts: a, host: operator_host_srv7) && contains_host(hosts: a, host: operator_host_srv8)
    && !contains_host(hosts: a, host: operator_host_srv9) && !contains_host(hosts: a, host: operator_host_srv10)
    && !contains_host(hosts: a, host: operator_host_srv11) && !contains_host(hosts: a, host: operator_host_srv12)
    && contains_host(hosts: b, host: operator_host_srv9) && contains_host(hosts: b, host: operator_host_srv10)
    && contains_host(hosts: b, host: operator_host_srv11) && contains_host(hosts: b, host: operator_host_srv12)
    && !contains_host(hosts: b, host: operator_host_srv5) && !contains_host(hosts: b, host: operator_host_srv6)
    && !contains_host(hosts: b, host: operator_host_srv7) && !contains_host(hosts: b, host: operator_host_srv8)
}

// THE TRANSITION ROW IS THE ROUTE, NOT A DECORATION: its subject's group is a group this repository
// claims, its two sides are the two DeepSeek artifacts in the order the ruling names, both DeepSeek
// domains take their artifact from it, and the V4.1 quality requirement is about its TO side.
test fn the_group_a_transition_is_consumed_by_both_deepseek_fields() -> Bool {
  (match group_a_served_artifact_transition.subject {
     PairServingUnitOn { group: g } =>
       any(spark_pair_serving_groups, claimed => (fabric_group_wire(g: claimed) as String) == (fabric_group_wire(g: g) as String))
     PlacedServingArm { arm: _ } => false
   })
    && declaration_ref_eq(a: group_a_served_artifact_transition.from.identity, b: artifact_deepseek_v4_flash_native.identity)
    && declaration_ref_eq(a: group_a_served_artifact_transition.to.identity, b: artifact_deepseek_v4_1_flash_native.identity)
    && all(deepseek_domain.artifacts, a => declaration_ref_eq(a: a.identity, b: group_a_served_artifact_transition.from.identity))
    && all(deepseek_v4_1_candidate_field.domain.artifacts, a => declaration_ref_eq(a: a.identity, b: group_a_served_artifact_transition.to.identity))
    && declaration_ref_eq(a: deepseek_v4_1_quality_requirement.required_artifact, b: group_a_served_artifact_transition.to.identity)
    && (group_a_served_artifact_transition.ruling.ruled_on as String) == "2026-09-12"
    && decision_snapshot_key(input: deepseek_decision_input) != decision_snapshot_key(input: deepseek_v4_1_decision_input)
}

// A PLANTED EIGHT-RANK V4.1 SHAPE IS EXCLUDED BEFORE PARETO, NOT LEFT AS AN OBLIGATION. The production
// V4.1 domain never enumerates it (four admissible hosts), so it is planted: a field of exactly that
// shape over the authorized runtime answers NoFeasible under the host-fit constraint, where the same
// field over the eight-host fixture fleet answers with evidence obligations. This is the exclusion
// deep-crane-826's memory screen relies on host admissibility for (their #11193), and it holds even
// though V4.1's footprint is externally reported -- the host fit is its own reading, never a gap.
test fn a_planted_eight_rank_v4_1_shape_is_infeasible_on_group_a_and_open_on_eight_hosts() -> Bool {
  match v4_1_profile_at(runtime: v4_1_runtime_published_arm64) {
    ServingProfileSm12JoinFailed { runtime: _, standing: _ } => false
    ServingProfileReady { profile: p } => {
      let t = topology_shape(tensor_parallel_degree: 8, replica_count: 1)
      let domain = serving_deployment_domain_over_standings(
        artifacts: [artifact_deepseek_v4_1_flash_native],
        topologies: [t],
        standings: [ServingProfileReady { profile: p }],
      )
      let field = serving_candidate_field(
        identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "a_planted_eight_rank_v4_1_shape_is_infeasible_on_group_a_and_open_on_eight_hosts"),
        domain: domain,
        candidates: derived_candidates_for(stem: "planted_tp8", domain: domain),
      )
      let over_a = serving_decision_input(
        field: field,
        evidence: pair_unit_a_evidence_current,
        quality_requirement: deepseek_v4_1_quality_requirement,
        selection_policy: deepseek_v4_1_selection_policy,
        constraints: v4_1_selection_constraints,
        constraint_authority: id_v4_1_constraint_authority,
        axes: v4_1_selection_axes,
      )
      let over_eight = serving_decision_input(
        field: field,
        evidence: serving_evidence_snapshot(quality: [], runtime_feasibility: [], workload: unestablished_demand, fleet: fixture_eight_host_fleet, fleet_receipt: fixture_fleet_ref),
        quality_requirement: deepseek_v4_1_quality_requirement,
        selection_policy: deepseek_v4_1_selection_policy,
        constraints: v4_1_selection_constraints,
        constraint_authority: id_v4_1_constraint_authority,
        axes: v4_1_selection_axes,
      )
      (match select_serving_deployment(input: over_a) {
         NoFeasibleServingDeployment { causes: cs } => count(cs) > 0
         _ => false
       })
        && (match select_serving_deployment(input: over_eight) {
              ServingDeploymentNeedsEvidence { needs: n } => count(n) > 0
              _ => false
            })
    }
  }
}

// THE EVIDENCE IDENTITY MOVES WITH THE HOST IDENTITIES, NOT WITH THEIR NUMBER. Two fixture fleets of
// the same size over different units are different evidence, which is what a `host_count` in the key
// could never say and what makes a stale decision over a re-cabled fleet mechanically detectable.
fn settled_input_over(f: FleetSnapshot) -> ServingDeploymentDecisionInput {
  serving_decision_input(
    field: settled_field,
    evidence: serving_evidence_snapshot(quality: [passing_quality_for(tp: 4)], runtime_feasibility: [], workload: established_demand, fleet: f, fleet_receipt: fixture_fleet_ref),
    quality_requirement: deepseek_quality_requirement,
    selection_policy: suite_ref,
    constraints: serving_selection_constraints,
    constraint_authority: id_constraint_authority,
    axes: serving_selection_axes,
  )
}

test fn swapping_one_admissible_host_for_another_changes_the_decision_identity() -> Bool {
  let left = fixture_fleet_over(hosts: [operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8])
  let right = fixture_fleet_over(hosts: [operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv9])
  decision_snapshot_key(input: settled_input_over(f: left)) != decision_snapshot_key(input: settled_input_over(f: right))
    && decision_snapshot_key(input: settled_input_over(f: left)) == decision_snapshot_key(input: settled_input_over(f: left))
}

// ── A DIFFERENT ARTIFACT IS A DECIDED NEGATIVE ────────────────────────────────────────────────
//
// The requantised build is not a cheaper way to serve the native checkpoint; it is other weights.
// No report about it can pass a requirement whose subject is the native artifact.
test fn native_quality_is_a_fact_on_the_weight_treatment() -> Bool {
  native_quality_holds(c: native_tp4_x2)
    && native_quality_holds(c: cand(name: "v41", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2)))
    && !native_quality_holds(c: cand(name: "twobit_fact", art: artifact_glm_53_flash_2bit, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8)))
}

test fn replica_count_above_one_fails_no_redundancy() -> Bool {
  no_redundancy_holds(c: native_tp8_x1)
    && no_redundancy_holds(c: cand(name: "tp2x1", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 2, replica_count: 1)))
    && no_redundancy_holds(c: cand(name: "tp4x1", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 1)))
    && !no_redundancy_holds(c: native_tp4_x2)
    && !no_redundancy_holds(c: cand(name: "two_replicas", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 2, replica_count: 2)))
}

fn topology_in(shapes: List<TopologyShape>, tp: Nat, replicas: Nat) -> Bool {
  any(shapes, t => topology_shape_eq(a: t, b: topology_shape(tensor_parallel_degree: tp, replica_count: replicas)))
}

// THE V4.1 DOMAIN IS EVERY SHAPE THE PAIR UNIT ON GROUP A ADMITS, AND NOTHING WIDER: the four
// admissible identities enumerate tp1-tp4, and no five-to-eight-rank shape exists in the domain to
// be screened. That absence is asserted by identity of shape rather than by the domain's length.
test fn v4_1_field_is_complete_over_every_shape_the_fleet_admits() -> Bool {
  let admitted = fleet_admitted_topologies(fleet: pair_unit_a_fleet_snapshot)
  match establish_serving_candidate_field(field: deepseek_v4_1_candidate_field) {
    ServingFieldEstablished =>
      topology_in(shapes: admitted, tp: 4, replicas: 1)
        && topology_in(shapes: admitted, tp: 2, replicas: 1)
        && topology_in(shapes: admitted, tp: 1, replicas: 1)
        && topology_in(shapes: admitted, tp: 2, replicas: 2)
        && !topology_in(shapes: admitted, tp: 5, replicas: 1)
        && !topology_in(shapes: admitted, tp: 6, replicas: 1)
        && !topology_in(shapes: admitted, tp: 7, replicas: 1)
        && !topology_in(shapes: admitted, tp: 8, replicas: 1)
        && !topology_in(shapes: admitted, tp: 4, replicas: 2)
        && all(deepseek_v4_1_candidate_field.domain.topologies, t => topology_in(shapes: admitted, tp: t.tensor_parallel_degree, replicas: t.replica_count))
        && count(v4_1_declared_profiles) == 3
        && (v4_1_runtime_published_arm64.image as String) == (v41_published_arm64_reference() as String)
        && match v4_1_runtime_published_arm64.vllm_source {
          VllmSourceRevisionUnestablished { reported_version: v, obligation: _ } =>
            (v as String) == (v41_published_distribution_name as String)
          VllmSourceRevisionEstablished { git: _ } => false
        }
        && match v41_published_stamped_identifier_lookup {
          PublicCommitAbsent => true
          PublicCommitPresent => false
          PublicCommitUnasked => false
        }
        && match spark_runtime.vllm_source {
          VllmSourceRevisionUnestablished { reported_version: _, obligation: _ } => true
          VllmSourceRevisionEstablished { git: _ } => false
        }
        && match v4_1_runtime_vllm_gb10_lead.vllm_source {
          VllmSourceRevisionEstablished { git: g } =>
            (g as String) == (vllm_deepseek_v4_1_sm12_revision.full_revision as String)
          VllmSourceRevisionUnestablished { reported_version: _, obligation: _ } => false
        }
        && (v4_1_runtime_vllm_gb10_lead.image as String)
          == (gunbc_vllm_dsv41_gb10_registry_reading.image_reference as String)
    ServingFieldUnestablished { causes: _ } => false
  }
}

test fn v4_1_gb10_kv_layout_is_fp8_ds_mla_and_bytes_per_token_are_unestablished() -> Bool {
  token_count_value(t: serving_parameters_current.max_model_len) == 300000
    && all(v4_1_declared_profiles, p =>
      token_count_value(t: p.max_model_len) == 1048576
        && match p.speculative {
          SpeculationDraft { algorithm: _ } => true
          SpeculationOff => false
          SpeculationOn => false
        }
        && match p.kv_layout {
          KvFp8DsMlaLayout => true
          KvAutoLayout => false
          KvFp8Layout => false
          KvFp4Layout => false
        })
    && match v4_1_gb10_kv_layout {
      Sm12KvLayoutAdmitted { policy: k } =>
        match k {
          KvFp8DsMlaLayout => true
          KvAutoLayout => false
          KvFp8Layout => false
          KvFp4Layout => false
        }
        && (kv_layout_wire(k: k) as String) == (v41_sm12_kv_layout as String)
        && v41_sm12_kv_cache_dtype_admitted(dtype: kv_layout_wire(k: k))
      Sm12KvLayoutJoinFailed { wire: _, obligation: _ } => false
    }
    && !v41_sm12_kv_cache_dtype_admitted(dtype: kv_layout_wire(k: KvAutoLayout))
    && native_quality_holds(c: cand(name: "v41_fp8dsmla", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 1)))
    && match kv_bytes_per_token_standing(c: cand(name: "v41_kv", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 1))) {
      KvBytesPerTokenUnestablished { layout: k, obligation: _ } =>
        match k { KvFp8DsMlaLayout => true, KvAutoLayout => false, KvFp8Layout => false, KvFp4Layout => false }
      KvBytesPerTokenNotThisSubject => false
    }
}

fn names_sm12_kv_join(s: NonEmptyStr) -> Bool {
  string_contains(s: s as String, pattern: "v41_sm12_kv_layout")
    && string_contains(s: s as String, pattern: "supports_combination")
    && string_contains(s: s as String, pattern: "v41_sm12_admitted_kv_cache_dtypes")
}

fn planted_join_is_named_failure(wire: NonEmptyStr, admitted: List<NonEmptyStr>) -> Bool {
  match sm12_kv_layout_standing(wire: wire, admitted: admitted) {
    Sm12KvLayoutAdmitted { policy: k } =>
      match k {
        KvAutoLayout => false
        KvFp8DsMlaLayout => false
        KvFp8Layout => false
        KvFp4Layout => false
      }
    Sm12KvLayoutJoinFailed { wire: _, obligation: o } => names_sm12_kv_join(s: o)
  }
}

fn planted_field_names_join_and_keeps_profiles(wire: NonEmptyStr, admitted: List<NonEmptyStr>) -> Bool {
  let standings = v4_1_profile_standings_from(standing: sm12_kv_layout_standing(wire: wire, admitted: admitted))
  let field = v4_1_candidate_field_from_sm12(wire: wire, admitted: admitted)
  count(standings) == 3
    && all(standings, s => match s {
      ServingProfileReady { profile: p } =>
        match p.kv_layout {
          KvAutoLayout => false
          KvFp8DsMlaLayout => false
          KvFp8Layout => false
          KvFp4Layout => false
        }
      ServingProfileSm12JoinFailed { runtime: _, standing: st } =>
        match st {
          Sm12KvLayoutAdmitted { policy: k } =>
            match k { KvAutoLayout => false, KvFp8DsMlaLayout => false, KvFp8Layout => false, KvFp4Layout => false }
          Sm12KvLayoutJoinFailed { wire: _, obligation: o } => names_sm12_kv_join(s: o)
        }
    })
    && match establish_serving_candidate_field(field: field) {
      ServingFieldEstablished => false
      ServingFieldUnestablished { causes: cs } =>
        any(cs, c => names_sm12_kv_join(s: c))
          && !any(cs, c => string_contains(s: c as String, pattern: "no serving profiles"))
    }
    && match select_serving_deployment(input: v4_1_decision_input_from_sm12(wire: wire, admitted: admitted)) {
      ServingDeploymentSelectionRefused { defects: ds } => any(ds, d => names_sm12_kv_join(s: d))
      ServingDeploymentNeedsEvidence { needs: _, component_routes: _ } => false
      ServingDeploymentSelected { selected: _ } => false
      ServingDeploymentNeedsPolicy { survivors: _, component_routes: _ } => false
      NoFeasibleServingDeployment { causes: _ } => false
    }
}

test fn different_failed_sm12_wires_have_different_decision_identities() -> Bool {
  let empty_admit: List<NonEmptyStr> = []
  let unadmitted = kv_layout_wire(k: KvAutoLayout)
  let nomatch_opt = (filter(v41_sm12_admitted_kv_cache_dtypes, d =>
    match kv_layout_policy_matching_wire(wire: d) {
      Absent => true
      Present { value: _ } => false
    })).first()
  match nomatch_opt {
    Absent => false
    Present { value: nomatch } =>
      decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: unadmitted, admitted: v41_sm12_admitted_kv_cache_dtypes))
        != decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: nomatch, admitted: v41_sm12_admitted_kv_cache_dtypes))
        && decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: unadmitted, admitted: v41_sm12_admitted_kv_cache_dtypes))
          != decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: v41_sm12_kv_layout, admitted: empty_admit))
        && decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: nomatch, admitted: v41_sm12_admitted_kv_cache_dtypes))
          != decision_snapshot_key(input: v4_1_decision_input_from_sm12(wire: v41_sm12_kv_layout, admitted: empty_admit))
  }
}

// ONE WITNESS PER PLANTED WIRE, BECAUSE THREE FIELD CONSTRUCTIONS IN ONE CLAIM IS THREE CLAIMS
// WEARING A CONJUNCTION. Each of these drives `v4_1_candidate_field_from_sm12` once, and the previous
// single claim drove it three times for 110,408 eval steps against a 72,300 new-witness budget. The
// split loses no coverage -- every conjunct survives, attached to the wire it is about -- which is the
// difference between splitting and dropping a case. Operator ruling 2026-09-14: a witness
// discriminates at ONE interface, not over cases.
test fn a_planted_unadmitted_wire_keeps_a_named_join_standing() -> Bool {
  let unadmitted = kv_layout_wire(k: KvAutoLayout)
  !v41_sm12_kv_cache_dtype_admitted(dtype: unadmitted)
    && match kv_layout_policy_matching_wire(wire: unadmitted) {
      Present { value: k } =>
        match k { KvAutoLayout => true, KvFp8DsMlaLayout => false, KvFp8Layout => false, KvFp4Layout => false }
      Absent => false
    }
    && planted_join_is_named_failure(wire: unadmitted, admitted: v41_sm12_admitted_kv_cache_dtypes)
    && planted_field_names_join_and_keeps_profiles(wire: unadmitted, admitted: v41_sm12_admitted_kv_cache_dtypes)
    && match sm12_kv_layout_standing(wire: unadmitted, admitted: v41_sm12_admitted_kv_cache_dtypes) {
      Sm12KvLayoutJoinFailed { wire: _, obligation: _ } => true
      Sm12KvLayoutAdmitted { policy: _ } => false
    }
}

// A WIRE THE ROSTER ADMITS BUT NO POLICY MATCHES is the case the unadmitted one cannot reach: admission
// and policy matching are two joins, and a wire can pass the first and fail the second.
test fn a_planted_nomatch_wire_keeps_a_named_join_standing() -> Bool {
  let nomatch_opt = (filter(v41_sm12_admitted_kv_cache_dtypes, d =>
    match kv_layout_policy_matching_wire(wire: d) {
      Absent => true
      Present { value: _ } => false
    })).first()
  match nomatch_opt {
    Absent => false
    Present { value: nomatch } =>
      v41_sm12_kv_cache_dtype_admitted(dtype: nomatch)
        && match kv_layout_policy_matching_wire(wire: nomatch) {
          Absent => true
          Present { value: _ } => false
        }
        && planted_join_is_named_failure(wire: nomatch, admitted: v41_sm12_admitted_kv_cache_dtypes)
        && planted_field_names_join_and_keeps_profiles(wire: nomatch, admitted: v41_sm12_admitted_kv_cache_dtypes)
        && match sm12_kv_layout_standing(wire: nomatch, admitted: v41_sm12_admitted_kv_cache_dtypes) {
          Sm12KvLayoutJoinFailed { wire: _, obligation: _ } => true
          Sm12KvLayoutAdmitted { policy: _ } => false
        }
  }
}

// AN EMPTY ADMITTED ROSTER FAILS THE JOIN FOR A WIRE THAT IS OTHERWISE THE REAL ONE, which is what
// separates "this wire is wrong" from "there is nothing to join against". The positive controls ride
// here because they are about the same real wire: the live field IS established, and the real wire
// against the real roster IS admitted as fp8_ds_mla -- so the three negatives above are failing for
// the planted reason rather than because this join never succeeds.
test fn an_empty_admitted_roster_keeps_a_named_join_standing() -> Bool {
  let empty_admit: List<NonEmptyStr> = []
  planted_join_is_named_failure(wire: v41_sm12_kv_layout, admitted: empty_admit)
    && planted_field_names_join_and_keeps_profiles(wire: v41_sm12_kv_layout, admitted: empty_admit)
}

// THE POSITIVE CONTROL FOR THE PLANTED FAMILY. The three planted claims assert that a BROKEN join is
// named; this asserts the join SUCCEEDS for the real wire against the real roster. Without it all
// three negatives could be passing because that join never succeeds at all.
//
// THE LIVE FIELD'S ESTABLISHMENT IS SUPPLIED HERE AND EXECUTED THERE, which is the strengthened
// obligation applied rather than evaded: a boundary may be supplied in any number of claims so long as
// SOME claim still runs it for real, and the execution that may never be removed is the product root.
//
// THE IMPLICATION IS EXACT AND CHECKABLE FROM TWO BODIES, not asserted. This claim used to call
// `establish_serving_candidate_field(field: deepseek_v4_1_candidate_field)` for ~98,000 of its 108,443
// eval steps. That function IS `establish_serving_candidate_field_over(field, routed_candidates(field))`
// -- and `select_over_routed` makes THAT SAME CALL WITH THE SAME ARGUMENTS as its first act, returning
// `ServingDeploymentSelectionRefused` on `ServingFieldUnestablished`. So
// `the_live_v4_1_serving_decision_excludes_every_admissible_candidate`, which asserts
// `NoFeasibleServingDeployment` and returns FALSE on the refused arm, cannot pass unless the live field
// is established. The establishment was being computed twice and asserted twice.
//
// WHY THIS IS NOT THE MISTAKE MADE EARLIER ON THIS BRANCH. A previous decomposition supplied BOTH
// halves -- behaviour over a designed field, inhabitance with no decision -- and left ZERO executions
// of the live decision, which a reviewer caught. Here one execution survives BY CONSTRUCTION: the
// product root is untouched, and if it is ever deleted this claim's supplied boundary loses its
// warrant. That is the pairing the rule requires, and the execution that carries it is the claim
// `the_live_v4_1_serving_decision_excludes_every_admissible_candidate` in this module.
//
// NAMED AS A SYMBOL RATHER THAN AS A GREP, AND THAT IS NOT PEDANTRY -- THE GREP DOES NOT WORK. Two
// annotations in this file, including this one, discuss that call by quoting it, so a count of the
// pattern reports THREE where one execution exists, and it would still report TWO if the product root
// were deleted. A guard fooled by prose about the guard cannot detect the regression it exists for,
// which is section 3's cite-the-symbol rule earning its keep: the claim's name is reachable from the
// namespace tree and a quoted string in a comment is not.
test fn the_real_sm12_wire_joins_as_fp8_ds_mla() -> Bool {
  match sm12_kv_layout_standing(wire: v41_sm12_kv_layout, admitted: v41_sm12_admitted_kv_cache_dtypes) {
    Sm12KvLayoutAdmitted { policy: k } =>
      match k { KvFp8DsMlaLayout => true, KvAutoLayout => false, KvFp8Layout => false, KvFp4Layout => false }
    Sm12KvLayoutJoinFailed { wire: _, obligation: _ } => false
  }
}

// THE ASSERTION IS AN IDENTITY JOIN, NOT A CARDINALITY. A first cut asserted `count(built) == 3`
// beside three `contains` checks, and when the frontier grew to five subjects the three it named were
// all still present while the count no longer described the producer -- so the witness went red on the
// one thing about it that carried no meaning. Replacing 3 with 5 would have been worse: a count that
// tracks whatever the producer happens to hold is a derivation compared with itself, which DESIGN §5
// names exactly ("if automating the literal's update collapses the assertion to measure() == measure()").
//
// So the expected POPULATION is declared here, and the join is in BOTH directions: every expected
// subject is built, and every built subject is expected. Adding a frontier row without declaring it
// here reds the second direction; dropping one reds the first. Neither can be satisfied by editing a
// number, and the roster build still has to be duplicate-free for either direction to mean anything.
// candidate_component_budget IS ENROLLED HERE because the declaration it defers is this module's. It
// was briefly filed in the route authority's roster instead and that roster refused -- its expected
// subjects are all built with the route module's path, so a row pointing at a serving declaration had
// no counterpart. The join that caught it is the reason both rosters check membership in both
// directions at identity grain rather than comparing counts.
data v4_1_expected_frontier_subjects: List<String> = [
  "fleet_admitted_topologies",
  "v4_1_gb10_kv_bytes_obligation",
  "engram_standing",
  "component_route_gap_over",
  "execution_profile_of",
  "candidate_component_budget",
]

fn v4_1_frontier_subject_key(decl_name: String) -> String {
  declaration_ref_display_key(ref: DeclarationRef {
    module_path: "gunbc.spark.serving_deployment_selection" as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  })
}

test fn v4_1_selection_frontier_is_the_roster_home_for_deferred_kv_and_width_facts() -> Bool {
  let expected = map(v4_1_expected_frontier_subjects, n => v4_1_frontier_subject_key(decl_name: n))
  let actual = frontier_path_subjects(rows: v4_1_selection_frontier)
  frontier_rows_well_formed(rows: v4_1_selection_frontier)
    && match frontier_rows_keyed_roster_build(rows: v4_1_selection_frontier) {
      KeyedRosterBuilt { rows: built } => count(built) == count(actual)
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
    }
    && all(expected, e => any(actual, a => a == e))
    && all(actual, a => any(expected, e => e == a))
}

test fn kv_bytes_axis_is_v4_1_only_and_engram_is_standing_not_an_axis() -> Bool {
  !any(serving_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_kv_bytes_per_token))
    && any(v4_1_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_kv_bytes_per_token))
    && any(v4_1_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_authorized_runtime))
    && !any(serving_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_authorized_runtime))
    && match kv_bytes_per_token_standing(c: cand(name: "glm_kv", art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))) {
      KvBytesPerTokenNotThisSubject => true
      KvBytesPerTokenUnestablished { layout: _, obligation: _ } => false
    }
    && match engram_standing(art: artifact_deepseek_v4_1_flash_native) {
      EngramOffloadZeroPoolGainOnUnifiedMemory { how: _ } => true
      EngramNotAComponentOfThisArtifact => false
    }
    && match engram_standing(art: artifact_glm_53_flash_native) {
      EngramNotAComponentOfThisArtifact => true
      EngramOffloadZeroPoolGainOnUnifiedMemory { how: _ } => false
    }
}

test fn v4_1_selection_policy_is_not_the_quality_requirement() -> Bool {
  !declaration_ref_eq(a: deepseek_v4_1_selection_policy, b: deepseek_v4_1_quality_requirement.identity)
}

// THE EXPECTED CONSTRAINT AUTHORITIES ARE NAMED, AND THE JOIN RUNS BOTH WAYS. A first cut asserted
// `count(v41_ids) == 4` beside three `any` checks; adding `constraint_component_route` made it five, and
// the three named identities were all still present, so the witness failed on the assertion that said
// the least. The identities are declared here as a population and joined in both directions, so a new
// constraint authority on either input must be declared here to pass -- and no edit to a number can
// satisfy it. The GLM roster is asserted the same way, which is what keeps V4.1's additions from
// silently widening the shared subject.
data expected_glm_constraint_authorities: List<DeclarationRef> = [
  id_constraint_authority,
  constraint_native_quality,
]

data expected_v4_1_constraint_authorities: List<DeclarationRef> = [
  id_constraint_authority,
  constraint_native_quality,
  constraint_no_redundancy,
  constraint_authorized_runtime,
  constraint_component_route,
]

fn identity_populations_agree(actual: List<DeclarationRef>, expected: List<DeclarationRef>) -> Bool {
  all(expected, e => any(actual, a => declaration_ref_eq(a: a, b: e)))
    && all(actual, a => any(expected, e => declaration_ref_eq(a: a, b: e)))
}

test fn assessment_dispositions_join_the_constraint_identities_on_the_input() -> Bool {
  let glm_ids = unique_constraint_identities(cs: glm_decision_input.constraints)
  let v41_ids = unique_constraint_identities(cs: deepseek_v4_1_decision_input.constraints)
  identity_populations_agree(actual: glm_ids, expected: expected_glm_constraint_authorities)
    && identity_populations_agree(actual: v41_ids, expected: expected_v4_1_constraint_authorities)
    && !any(glm_ids, id => declaration_ref_eq(a: id, b: constraint_no_redundancy))
    && !any(glm_ids, id => declaration_ref_eq(a: id, b: constraint_component_route))
}

// THE COVERING CARTESIAN IS OVER THE SUBJECT'S ADMISSIBLE SET. GLM covers the canary's four hosts,
// so tp4 x1 is in and tp4 x2 -- eight hosts -- is not; before this change the same claim asserted
// the reverse over a scalar eight. The DeepSeek V4 Flash field covers the pair unit's four hosts and
// carries tp4 x1, the shape that runs on group A today, and not tp8 x1.
test fn glm_and_deepseek_fields_are_the_derived_admitted_cartesian() -> Bool {
  match establish_serving_candidate_field(field: glm_candidate_field) {
    ServingFieldEstablished =>
      count(glm_candidate_field.candidates)
        == count(glm_domain.artifacts) * count(glm_domain.topologies) * count(glm_domain.profiles)
        && topology_in(shapes: glm_domain.topologies, tp: 4, replicas: 1)
        && topology_in(shapes: glm_domain.topologies, tp: 1, replicas: 4)
        && !topology_in(shapes: glm_domain.topologies, tp: 4, replicas: 2)
        && !topology_in(shapes: glm_domain.topologies, tp: 8, replicas: 1)
    ServingFieldUnestablished { causes: _ } => false
  } && match establish_serving_candidate_field(field: deepseek_candidate_field) {
    ServingFieldEstablished =>
      count(deepseek_candidate_field.candidates)
        == count(deepseek_domain.artifacts) * count(deepseek_domain.topologies) * count(deepseek_domain.profiles)
        && topology_in(shapes: deepseek_domain.topologies, tp: 4, replicas: 1)
        && !topology_in(shapes: deepseek_domain.topologies, tp: 8, replicas: 1)
        && !topology_in(shapes: deepseek_domain.topologies, tp: 4, replicas: 2)
    ServingFieldUnestablished { causes: _ } => false
  }
}

test fn a_report_about_a_different_artifact_cannot_pass_this_requirement() -> Bool {
  match assess_quality(
    report: serving_quality_report(
      subject: execution_profile_of(c: cand(name: "twobit", art: artifact_glm_53_flash_2bit, t: topology_shape(tensor_parallel_degree: 1, replica_count: 8)), p: serving_parameters_current),
      suite: suite_ref,
      reference_profile: execution_profile_of(c: native_tp4_x2, p: serving_parameters_current),
      max_selected_token_divergence_millinats: 0,
      task_score_delta_hundredths: 0,
      how: "fixture: a perfect report about the wrong weights" as NonEmptyStr),
    requirement: deepseek_quality_requirement) {
    QualityFailed { subject: _, requirement: _, violations: vs } => count(vs) > 0
    _ => false
  }
}


// ══════════════════════════════════════════════════════════════════════════════════════════════
// DSV41-10: THE ENGRAM ROUTE INTEGRATION, CHECKED AT THE PRODUCT ROOT
// ══════════════════════════════════════════════════════════════════════════════════════════════

// THE CONTROL THAT REDS IF THE INTEGRATION IS REMOVED. This is not a fixture calling an unused
// function: it is the live V4.1 serving decision -- the same `deepseek_v4_1_decision_input` the
// product declares -- and it asserts that the evidence it reports back includes the component-route
// axis. Delete the axis from `v4_1_selection_axes`, or stop `candidate_gaps` from carrying the
// route standing, and this goes red rather than quietly returning the same answer for other reasons.
fn needs_name_axis(needs: List<SelectionEvidenceNeed>, axis: DeclarationRef) -> Bool {
  any(needs, n => match n {
    UnfundedAxis { gap: g } => declaration_ref_eq(a: g.axis, b: axis)
    CandidateStandingIncomplete { candidate: _, cause: _ } => false
    SubjectClosureIncomplete { subject: _, obligation: _ } => false
  })
}

// OBSERVING AN AXIS NAME IS NOT EVIDENCE THE ROUTE'S RESULT REACHED THE ROOT. A first cut asserted
// only that some UnfundedAxis named ax_component_route -- and `std.decision` `unread_axis_gaps`
// synthesises exactly that on any hard-constrained axis with no reading. So removing the route
// contribution from candidate_gaps, while keeping the funded axis, its constraint and the open
// placement's absent reading, left the selector fabricating a gap on the same axis and the control
// accepted it identically: it could not distinguish the connected path from the disconnected one.
//
// The oracle now requires a ROUTE-PRODUCED obligation -- marked with the component identity and the
// exact serving context it was decided under, neither of which the selector's fallback knows. The
// negative below is the disconnection itself, expressed as the selector's own generic gap, and it is
// rejected.
// THE THREE THINGS A ROUTE-PRODUCED OBLIGATION CARRIES AND THE SELECTOR'S FALLBACK CANNOT: the
// marker, the component SUBJECT the route authority decided about, and the consumer that derived the
// serving context. Each is computed from the same declaration production uses, so this oracle carries
// no transcribed string that could drift away from what the code emits.
// THE THREE DISCRIMINATORS ARE COMPUTED ONCE, not once per need. The needs list for the live V4.1
// decision runs to hundreds, and recomputing two declaration keys inside the scan was the same
// copied-accumulator shape the production fold had -- in a control whose whole problem is that it must
// afford to render a verdict.
data expected_route_component_key: String = declaration_ref_display_key(ref: engram_component_identity)
data expected_route_consumer_key: String = declaration_ref_display_key(ref: id_route_consumer)

// THE CONTEXT DIGEST IS PART OF THE DISCRIMINATOR, NOT JUST THE CONSUMER. A first cut asked for the
// marker, the component key and the consumer key, and a cause naming this component and this consumer
// under a DIFFERENT execution profile satisfied all three -- so the oracle would have accepted a route
// obligation decided for another topology, which is precisely the foreign-profile reuse the route model
// refuses. The exact prefixes production can emit for THIS field are derived here, once, from the same
// two folds production uses, and the cause must carry one of them whole.
data expected_route_prefixes: List<String> = map(
  deepseek_v4_1_candidate_field.candidates,
  k => route_obligation_prefix(
    component: engram_component_identity,
    context: candidate_route_context(c: k, p: k.profile)))

fn route_produced_causes(needs: List<SelectionEvidenceNeed>) -> List<NonEmptyStr> {
  flat_map(needs, n => match n {
    UnfundedAxis { gap: g } =>
      if declaration_ref_eq(a: g.axis, b: ax_component_route)
        && string_contains(s: g.cause as String, pattern: route_obligation_marker as String)
        && string_contains(s: g.cause as String, pattern: expected_route_component_key)
        && string_contains(s: g.cause as String, pattern: expected_route_consumer_key)
        && any(expected_route_prefixes, px => string_contains(s: g.cause as String, pattern: px)) {
        [g.cause]
      } else { [] }
    CandidateStandingIncomplete { candidate: _, cause: _ } => []
    SubjectClosureIncomplete { subject: _, obligation: _ } => []
  })
}

// ── THE FIELD SURVIVES, AND THE SHARING ITSELF IS NOT OBSERVABLE FROM HERE ────────────────────
//
// THE EXACTLY-ONCE CHECK WAS QUADRATIC IN THIS WITNESS'S OWN ARITHMETIC, which DESIGN section 6 says
// is always fixed regardless of the realized n. It ran one `filter` over the routed rows PER candidate
// -- about 3600 `declaration_ref_eq` calls at sixty candidates -- and that cost was the INSTRUMENT's,
// not the subject's, so it inflated the only completing full-field measurement this cut has.
//
// AND MOST OF WHAT IT ASSERTED WAS TRUE BY CONSTRUCTION. `routed_candidates` is `map(field.candidates,
// k => RoutedCandidate { candidate: k, ... })`, so each row CARRIES THE CANDIDATE VALUE ITSELF rather
// than a key that has to be resolved back: "every routed candidate belongs to the field" cannot fail,
// and "every field candidate appears in routed" follows from `map` together with the count equality
// below. What remains at risk is a producer that drops one candidate and duplicates another, which
// count equality alone would not see -- so uniqueness is the whole residual content, and
// `std.keyed_roster` is its authority, the same one this cut consumed for the safetensors rosters.
//
// WHAT THIS ESTABLISHES, and the claim is deliberately narrower than the one it replaces. It checks
// that the parent population is preserved -- every candidate returns exactly once, each with a
// standings list positionally aligned to its own artifact's component list -- and that this field
// genuinely CONTAINS candidates sharing a (component, context) demand, which is the precondition that
// makes sharing possible at all. Both are facts about values this entry point returns.
//
// WHAT IT DOES NOT ESTABLISH, corrected from a claim I made and should not have. It does NOT show that
// removing the sharing would red it. An earlier version asserted `count(demands) < count(candidates)`
// and called that a wall against reverting to per-candidate production -- but the witness computes
// `resolved_route_demands` ITSELF, separately from `routed_candidates`. Restore the per-candidate
// implementation and the returned candidate values and cardinalities are identical while the witness's
// own independent demand census still returns fewer, so every assertion stays true with production no
// longer sharing. Checking the right helper independently does not prove the claimed path uses it.
//
// AND THE DEEPER REASON NO OUTPUT-LEVEL CONTROL CAN DO BETTER: the reduction is answer-preserving BY
// CONSTRUCTION -- `engram_route_standing` reads only the component and the context, so two candidates
// with an equal pair cannot differ in any returned value. That property is exactly why the reuse is
// safe and exactly why its removal is invisible to any assertion over outputs. What would detect it is
// a cost measurement, and at this head the full-field controls are censored at the floor's ceiling, so
// that instrument is unavailable. The honest position is that the sharing is currently unwitnessed,
// stated here rather than implied by a control that reads as a wall and is not one.
// THIS CLAIM'S SUBJECT IS THE PRODUCER, NOT THE FIELD. It asserts that route production preserves the
// candidate population, that the roster it builds is duplicate-free, that standings align positionally
// with each artifact's components, and that candidates SHARE demands rather than each minting its own.
// Every one of those is a property of `routed_candidates` and `distinct_route_demands`, and none of them
// is a property of how many topologies the fleet admits -- so it runs on the designed four-candidate
// field. It cost 239,298 eval_steps on the live field with ZERO select_serving_deployment calls, which is
// what located the cost in route-standing production rather than in the selection.
test fn the_candidate_field_survives_route_production_and_shares_a_demand() -> Bool {
  let field = v4_1_designed_field
  let routed = routed_candidates(field: field)
  let demands = distinct_route_demands(routed: routed)
  count(routed) == count(field.candidates)
    && match keyed_roster_build(
      incomings: map(routed, rc => KeyedRow { row_key: rc.candidate.identity, value: rc }),
      key_eq: declaration_ref_eq,
    ) {
      KeyedRosterBuilt { rows: _ } => true
      KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
    }
    && all(routed, rc => count(rc.route_standings) == count(rc.candidate.artifact.components))
    && count(demands) > 0
    && count(demands) < count(field.candidates)
    && all(demands, d => declaration_ref_eq(a: component_route_standing_component(s: d), b: engram_component_identity))
}

// THE DEMAND POPULATION IS READ OFF THE ROWS ALREADY PRODUCED, NOT COMPUTED A SECOND TIME. A first
// cut called `routed_candidates(field)` AND `resolved_route_demands(field)` -- and `routed_candidates`
// computes the demand table internally, so the expensive half ran TWICE: sixteen route selections where
// eight suffice. That is the authored duplication with a shared-state ancestor that DESIGN section 2
// says to rewire rather than cache, committed inside the instrument that measures the repair of exactly
// that defect in production.
//
// The distinct (component, context) pairs are folded out of the standings the rows already carry. The
// accumulator holds one entry per distinct demand -- eight, not sixty -- so this is roughly sixty short
// scans of a very small list rather than a second full route analysis.
//
// AND THE RESIDENT COMPONENTS ARE EXCLUDED, WHICH IS NOT A DETAIL. `resolved_route_demands` accumulates
// only components declared `ComponentPlacedByRoute`; this artifact ALSO carries a `ComponentResident`
// backbone, whose standing is `ComponentRouteNotThisSubject` with `no_routed_component` as its subject.
// A first cut of this fold read every standing and so admitted that one, which silently changed the
// POPULATION rather than only how it was computed -- nine entries instead of eight, one of them naming
// no component at all. The arm is discriminated here so the two definitions agree.
fn routed_demand_standings(routed: List<RoutedCandidate>) -> List<ComponentRouteStanding> {
  filter(flat_map(routed, rc => rc.route_standings), st => match st {
    ComponentRouteNotThisSubject => false
    ComponentRouteSubjectHasNoAuthority { component: _, context: _ } => true
    ComponentRouteDecided { component: _, context: _, result: _, routes: _, evidence: _ } => true
  })
}

fn distinct_route_demands(routed: List<RoutedCandidate>) -> List<ComponentRouteStanding> {
  fold(routed_demand_standings(routed: routed), init: [], f: (acc, st) =>
    if any(acc, a =>
      declaration_ref_eq(
        a: component_route_standing_component(s: a),
        b: component_route_standing_component(s: st))
        && route_subject_key_eq(
          a: component_route_standing_context(s: a),
          b: component_route_standing_context(s: st))) {
      acc
    } else {
      concat(acc, [st])
    })
}

// ── THE PRODUCT ROOT: THE LIVE FIELD IS EMPTY, AND WHY ────────────────────────────────────────
//
// THIS CLAIM ASSERTED NEEDS-EVIDENCE UNTIL 2026-09-14 AND THE EXPECTATION MOVED BECAUSE THE FIELD
// DID, NOT BECAUSE THE CLAIM WAS WRONG WHEN WRITTEN. It was authored while the V4.1 domain was
// generated over an EIGHT-host scalar. #11308 replaced that with the subject's admissible host SET,
// and V4.1's subject holds one fabric group -- so tp5 through tp8 correctly ceased to exist, and
// with them every shape whose per-rank Engram share was small enough to fit.
//
// THE DISCRIMINATOR, STATED HERE BECAUSE "INFEASIBLE" INVITES EXACTLY ONE QUESTION -- would more
// hosts help? Yes, and this is the margin:
//
//   ranks=8   engram needs 23.64 GiB per rank against an 81.14 GiB budget   fits, with room
//   ranks=4   engram needs 47.28 GiB per rank against a  45.42 GiB budget   SHORT BY 1.86 GiB
//
// The budget is what is left of an observed 116.85 GiB idle-free rank reading after the artifact's
// OTHER THREE components -- backbone, vision tower and aligner, and the DSpark draft model. The
// last two are 7.89 GiB that a two-component reading of this problem omits, and they are the
// difference between a two-component sum saying +0.113 GiB of headroom and the fold saying -1.86.
// Corroborated by a second instrument on a different path: the Group A rollout lane, reading the
// published checkpoint index and dividing rather than running this decision, reported 118.81 GiB
// per rank against 116.9 free. Two derivations sharing no method, 0.1 GiB apart.
//
// SO THE ANSWER IS A SCOPED NEGATIVE AND THE MODEL IS RIGHT. Route A is excluded on the per-rank
// resident lower bound; routes B, C and D are excluded on ESTABLISHED mechanism absence, because
// the published image offers a memory-backed Engram placement only. Nothing here is an evidence
// gap dressed as a refusal.
//
// WHAT THIS CLAIM LOST, SAID PLAINLY RATHER THAN QUIETLY DROPPED. It used to assert over
// `component_routes` -- that every candidate carried a typed standing, and that some standing named
// the Engram component under this consumer's context. `NoFeasibleServingDeployment` CARRIES CAUSES
// AND NOTHING ELSE, so those assertions have no arm to stand on and are gone. That is the
// `component_route_gap_over` frontier row's prediction arriving: the exclusion line carries
// identities, not the child's reasons. The claim compensates as far as the arm allows by requiring
// EVERY candidate identity to appear among the causes, which keeps a shrinking field from passing
// silently -- but the typed standings are genuinely not checked on this path, and the row's trigger
// is what restores them.
test fn the_v4_1_aggregation_returns_no_feasible_naming_every_candidate() -> Bool {
  let input = v4_1_input_for_runtime(runtime: v4_1_runtime_published_arm64, stem: "aggregation_behaviour")
  match select_serving_deployment(input: input) {
    NoFeasibleServingDeployment { causes: cs } =>
      count(cs) > 0
        && causes_name_axis(cs: cs, axis: ax_component_route)
        && !causes_name_axis(cs: cs, axis: ax_host_fit)
        && all(input.field.candidates, k => causes_name_axis(cs: cs, axis: k.identity))
    ServingDeploymentNeedsEvidence { needs: _, component_routes: _ } => false
    ServingDeploymentSelected { selected: _ } => false
    ServingDeploymentNeedsPolicy { survivors: _, component_routes: _ } => false
    ServingDeploymentSelectionRefused { defects: _ } => false
  }
}

// THE INHABITANCE HALF, AND IT IS NOT OPTIONAL. Supplying a claim's inputs at an interface is only
// honest while something establishes that the REAL producer emits that shape; without this the pair
// above is a fast green suite testing a fixture, which is DESIGN section 5's
// specification-without-execution at layer granularity rather than at function granularity.
//
// THE FAILURE THIS CATCHES IS ONE THIS FILE ALREADY SUFFERED. An earlier designed field carried two
// topologies that both consumed EIGHT ranks against a four-host admissible set, so every candidate was
// excluded on HOST FIT and the claim reached its expected verdict through a mechanism it was not about.
// The behaviour claim could not see that; only a statement about what the live input actually contains
// can. So: the live input's field is the live candidate field BY IDENTITY, its population is non-empty,
// and every candidate names the real V4.1 artifact -- and NO DECISION IS RUN here, which is the whole
// point of splitting it out.
// WHY candidate_component_budget MAY READ GROUP A FOR EVERY CANDIDATE TODAY, DERIVED OVER THE
// POPULATION THAT CAN ACTUALLY REACH IT RATHER THAN OVER NAMED ARTIFACTS.
//
// THE PREVIOUS SHAPE OF THIS GUARD WAS THE CLASS THIS PR ITSELF FILES. It hand-enumerated four
// artifact declarations and was named "only one artifact is decomposed", while what executed was
// "these four named ones are not" -- so a FIFTH decomposed artifact, precisely the change the guard
// exists to intercept, would have left it green. A hand-picked fixture frozen against the population
// that existed when it was chosen, which is `a_designed_narrowing_stops_inhabiting_the_subject_it_
// narrowed`, and a name claiming more than the execution, which is section 4b rung honesty. Review
// 66350 found it in the guard written to answer review 66293 -- the repair reintroduced the class it
// was repairing.
//
// WHAT IS DERIVED NOW: the fold reaches an artifact ONLY through a candidate in a field, so the
// candidates of the live fields are the population, not the artifacts. Every candidate in all three
// live fields whose artifact carries components must be the V4.1 artifact. Add a decomposed artifact
// to any of these fields and this reds, however it is declared and whatever it is called.
//
// THE RESIDUAL LIMIT, STATED RATHER THAN NAMED AWAY: this enumerates the three live FIELDS. A fourth
// field would sit outside it. That is one level up from where the defect was and it is not derivable
// without a field roster this module does not have -- so it is named here as the limit, and the claim
// is named for what it executes.
test fn every_decomposed_candidate_in_the_live_fields_is_the_v4_1_artifact() -> Bool {
  let live = concat(
    concat(deepseek_v4_1_candidate_field.candidates, glm_candidate_field.candidates),
    deepseek_candidate_field.candidates)
  count(legacy_undecomposed_artifact) == 0
    && count(live) > 0
    && any(live, k => count(k.artifact.components) > 0)
    && all(live, k =>
         if count(k.artifact.components) > 0 {
           declaration_ref_eq(a: k.artifact.identity, b: artifact_deepseek_v4_1_flash_native.identity)
         } else {
           true
         })
}

// THE PRODUCT ROOT, SPLIT INTO ITS TWO JOBS -- operator ruling 2026-09-15. The single claim that
// replaced these did TWO things in one body, and only one of them is a wall.
//
// JOB ONE, THE WIRING, IS STRUCTURAL AND PERMANENT: serving selection must obtain Engram route
// standings for a real candidate through the route integration. Delete the integration and this must
// fail. That is `a_real_v4_1_candidate_obtains_its_engram_route_standing_through_the_integration`.
//
// JOB TWO, TODAY'S ANSWER, IS CURRENT-STATE and correctly goes red when the fleet changes: the closest
// shape to feasible is excluded on the per-rank resident floor. That is
// `the_closest_v4_1_shape_is_excluded_on_the_per_rank_resident_floor`.
//
// WHY THIS IS LIGHTER WITHOUT BECOMING A FIXTURE. Both run on a candidate taken FROM THE LIVE FIELD --
// the real artifact, its four real components, the real observed idle-free reading. What they do not do
// is the 24-candidate select fold, which is where substantially all of 191,441 eval steps went. The
// field-wide verdict is a fold over per-candidate exclusions, so asserting the exclusion on the real
// candidate that matters is the same data path at one candidate's cost.
//
// WHAT COVERS THE AGGREGATION IS A DIFFERENT CLAIM, and it already exists:
// `the_v4_1_aggregation_returns_no_feasible_naming_every_candidate` runs the real
// `select_serving_deployment` over a designed field whose candidates are the REAL artifact with its
// REAL components -- only the topology enumeration is narrowed, and `ax_host_fit` keeps that field
// inhabiting the admissible set so it reds for the right mechanism. Aggregation over a designed field
// plus exclusion over real data covers what one heavy claim covered.
//
// THE CONSEQUENCE I AM NOT HIDING: the non-comment count of select_serving_deployment on
// `deepseek_v4_1_decision_input` is now ZERO, and that is the same count whose going to zero was a
// defect last time. It is admissible here and was not then, for a reason that was PROVEN BY EXECUTION
// rather than asserted -- #11383 requires that SOME claim fail when the integration is removed, and
// last time none did.
//
// THE DELETION WAS RUN. In a scratch checkout with `candidate_component_route_standings` returning `[]`
// -- the wiring severed, the program still well-formed:
//
//   a_real_v4_1_candidate_obtains_its_engram_route_standing_through_the_integration   false  (true intact)
//   the_closest_v4_1_shape_is_excluded_on_the_per_rank_resident_floor                 false  (true intact)
//   the_v4_1_aggregation_returns_no_feasible_naming_every_candidate                   TRUE   (true intact)
//
// AND THE THIRD LINE IS THE REASON THIS SPLIT EXISTS RATHER THAN A FOOTNOTE. The aggregation claim DOES
// NOT DETECT THE REMOVAL. It asserts `ax_component_route` among the causes, and that axis is still named
// with no route standings at all, because exclusion reaches it through `component_resident_footprint`'s
// unread path. So it passes for a reason that survives the deletion, and anything relying on it as the
// product-root control would let the integration be deleted with everything green. The wall rests
// ENTIRELY on the first claim above. That is measured, not reasoned: both directions were executed, and
// a claim that reds on a broken tree without greening on the intact one is a decoration, not a wall.
fn v4_1_live_candidate_at(tp: Nat, replicas: Nat) -> DeploymentCandidate? {
  (filter(deepseek_v4_1_candidate_field.candidates,
    k => k.topology.tensor_parallel_degree == tp && k.topology.replica_count == replicas)).first()
}

fn engram_standing_of(c: DeploymentCandidate) -> ComponentRouteStanding? {
  (filter(candidate_component_route_standings(c: c, p: c.profile),
    st => declaration_ref_eq(a: component_route_standing_component(s: st), b: engram_component_identity))).first()
}

test fn a_real_v4_1_candidate_obtains_its_engram_route_standing_through_the_integration() -> Bool {
  match v4_1_live_candidate_at(tp: 4, replicas: 1) {
    Absent => false
    Present { value: c } =>
      count(candidate_component_route_standings(c: c, p: c.profile)) > 0
        && match engram_standing_of(c: c) {
          Absent => false
          Present { value: st } =>
            declaration_ref_eq(a: component_route_standing_component(s: st), b: engram_component_identity)
              && declaration_ref_eq(a: component_route_standing_context(s: st).consumer, b: id_route_consumer)
        }
  }
}

test fn the_closest_v4_1_shape_is_excluded_on_the_per_rank_resident_floor() -> Bool {
  match v4_1_live_candidate_at(tp: 4, replicas: 1) {
    Absent => false
    Present { value: c } =>
      match engram_standing_of(c: c) {
        Absent => false
        Present { value: st } =>
          match component_route_placement_standing(s: st) {
            ComponentPlacementExcluded { causes: cs } =>
              count(cs) > 0
                && any(cs, x => string_contains(s: x as String,
                     pattern: declaration_ref_display_key(ref: ax_route_per_rank_resident_lower_bound)))
            _ => false
          }
      }
  }
}

test fn the_live_v4_1_decision_input_inhabits_the_real_subject() -> Bool {
  let f = deepseek_v4_1_decision_input.field
  declaration_ref_eq(a: f.identity, b: deepseek_v4_1_candidate_field.identity)
    && count(f.candidates) > 0
    && count(f.candidates) == count(deepseek_v4_1_candidate_field.candidates)
    && all(f.candidates, k =>
         declaration_ref_eq(a: k.artifact.identity, b: artifact_deepseek_v4_1_flash_native.identity))
    && all(f.candidates, k => k.topology.tensor_parallel_degree * k.topology.replica_count
         <= count(pair_unit_a_fleet_snapshot.admissible_hosts))
}

// ── THE MEMORY SCREEN IS PER-CANDIDATE, AND THE DISCRIMINATING PAIR PROVES IT ──────────────────
//
// THIS IS THE CONTROL THE BRIEF'S "DO NOT PICK ONE GLOBAL ENGRAM ROUTE" REQUIREMENT NEEDS, and it is a
// pair rather than a single assertion because either half alone is satisfiable by a defect. A
// TP4 exclusion alone is satisfied by a screen that excludes unconditionally; a TP8 non-exclusion alone
// is satisfied by a screen that never fires. Only the pair establishes that the verdict is a function of
// the candidate.
//
// WHY THE TWO TOPOLOGIES DISAGREE, stated so a reader does not have to re-derive it: the component's
// resident FLOOR is divided by the ranks that share it, while the bytes free on a rank are not. At TP4
// the Engram floor per rank exceeds what the artifact's other components leave free on a rank, and at
// TP8 it does not. That is the whole reason topology is part of this question, and it is why the
// operator's TP4 Group A verdict is NOT a fact about the checkpoint in general.
//
// WHAT THIS PARAGRAPH USED TO SAY, AND WHY IT IS NOW FALSE. It read: the product-root witness still
// reports an EVIDENCE NEED rather than an infeasible field, because the live domain enumerates every tp
// from 1 to the fleet host count and candidates at TP5 and above survive the memory screen on their own
// arithmetic -- what would exclude THEM is host admissibility, separately outstanding.
//
// THAT HOST-ADMISSIBILITY INTEGRATION LANDED (#11308) AND THIS BRANCH MERGED IT. The domain is now the
// subject's ADMISSIBLE host set, which holds four hosts, so TP5 through TP8 do not exist to survive
// anything. Every shape that remains is excluded, and the product-root witness reports
// NoFeasibleServingDeployment rather than an evidence need. The anticipated exclusion became the actual
// one, which is the outcome the old text predicted -- and kept asserting the prediction after it came
// true. Review 66368 found it; it is the same expired-premise class this branch filed twice.
fn v41_candidate_at_tp(tp: Nat, replicas: Nat, name: String) -> DeploymentCandidate {
  cand(name: name, art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: tp, replica_count: replicas))
}

fn engram_placements_of(c: DeploymentCandidate) -> List<ComponentRoutePlacementStanding> {
  map(
    filter(candidate_component_route_standings(c: c, p: c.profile),
      st => declaration_ref_eq(a: component_route_standing_component(s: st), b: engram_component_identity)),
    st => component_route_placement_standing(s: st))
}

fn any_placement_excluded(ps: List<ComponentRoutePlacementStanding>) -> Bool {
  any(ps, pl => match pl {
    ComponentPlacementExcluded { causes: _ } => true
    ComponentPlacementOpen { remedy: _ } => false
    ComponentPlacementSettled { selected: _, receipt: _ } => false
    ComponentPlacementNotThisSubject => false
  })
}

fn any_placement_open(ps: List<ComponentRoutePlacementStanding>) -> Bool {
  any(ps, pl => match pl {
    ComponentPlacementOpen { remedy: _ } => true
    ComponentPlacementExcluded { causes: _ } => false
    ComponentPlacementSettled { selected: _, receipt: _ } => false
    ComponentPlacementNotThisSubject => false
  })
}

test fn the_engram_memory_screen_excludes_the_tp4_candidate_and_not_the_tp8_one() -> Bool {
  let tp4 = engram_placements_of(c: v41_candidate_at_tp(tp: 4, replicas: 2, name: "screen_tp4"))
  let tp8 = engram_placements_of(c: v41_candidate_at_tp(tp: 8, replicas: 1, name: "screen_tp8"))
  count(tp4) == 1
    && count(tp8) == 1
    && any_placement_excluded(ps: tp4)
    && !any_placement_excluded(ps: tp8)
    && any_placement_open(ps: tp8)
}

// THE DISCONNECTION NEGATIVE. This is what the field looks like when the route contribution is gone
// but the axis, the constraint and the absent reading remain: the selector still reports a gap on
// ax_component_route, and the oracle above must NOT accept it. Without this arm the positive control
// is satisfied by the very state it is supposed to detect.
fn disconnected_route_gap() -> AxisGap {
  AxisGap {
    axis: ax_component_route,
    cause: "required funded-axis reading absent" as NonEmptyStr,
  }
}

test fn the_selectors_generic_missing_axis_gap_does_not_satisfy_the_route_oracle() -> Bool {
  count(route_produced_causes(needs: [UnfundedAxis { gap: disconnected_route_gap() }])) == 0
    && needs_name_axis(needs: [UnfundedAxis { gap: disconnected_route_gap() }], axis: ax_component_route)
    && count(route_produced_causes(needs: [UnfundedAxis {
      gap: AxisGap {
        axis: ax_component_route,
        cause: join([route_obligation_marker as String, "[some.other.component@some.other.context] open"], "") as NonEmptyStr,
      },
    }])) == 0
    && count(route_produced_causes(needs: [UnfundedAxis {
      gap: AxisGap {
        axis: ax_component_route,
        cause: route_obligation_cause(
          component: engram_component_identity,
          context: route_subject_key(consumer: id_route_consumer, context_digest: "a-profile-this-field-does-not-contain"),
          cause: "open" as NonEmptyStr),
      },
    }])) == 0
}

// AND THE ROUTE AXIS IS THIS SUBJECT'S, NOT EVERY SUBJECT'S. GLM and V4-Flash declare no components,
// so neither the axis nor its hard constraint appears in their populations and their results are
// reached exactly as before.
test fn the_component_route_axis_and_constraint_are_v4_1_only() -> Bool {
  any(v4_1_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_component_route))
    && !any(serving_selection_axes, a => declaration_ref_eq(a: a.identity, b: ax_component_route))
    && any(v4_1_selection_constraints, c => declaration_ref_eq(a: c.axis, b: ax_component_route))
    && !any(serving_selection_constraints, c => declaration_ref_eq(a: c.axis, b: ax_component_route))
    && count(artifact_glm_53_flash_native.components) == 0
    && count(artifact_deepseek_v4_flash_native.components) == 0
    && count(artifact_glm_53_flash_2bit.components) == 0
    && count(artifact_deepseek_v4_1_flash_native.components) == 4
}

// THE DECOMPOSITION AGREES WITH AN INDEPENDENT UPSTREAM FIGURE, and that is the only version of this
// check worth running. A first cut compared the component sum against the artifact's own footprint --
// which IS that sum, so the assertion was an identity -- and pinned it to a transcribed literal
// 510286023000 beside it. Both halves were wrong in the way DESIGN section 6 names: the oracle has to
// be an independent referent, and it is named rather than copied.
test fn the_v4_1_decomposition_agrees_with_the_cited_upstream_total() -> Bool {
  match artifact_deepseek_v4_1_flash_native.upstream_total {
    Absent => false
    Present { value: upstream } =>
      byte_size_count(b: upstream) == byte_size_count(b: deepseek_v4_1_flash_safetensors_index_total_size)
        && match footprint_bytes(f: sum_component_footprints(cps: v4_1_artifact_components)) {
          Absent => false
          Present { value: parts } => byte_size_count(b: parts) == byte_size_count(b: upstream)
        }
  } && match artifact_decomposition_defect(art: artifact_deepseek_v4_1_flash_native) {
    Absent => true
    Present { value: _ } => false
  } && count(v4_1_artifact_components) == 4
}

// AND A DECOMPOSITION THAT DISAGREES WITH ITS CITED UPSTREAM TOTAL REFUSES. This is the red the
// identity-comparison could never produce: the components sum correctly to the artifact's own derived
// footprint and still contradict the publisher's figure for the same population.
fn artifact_with_wrong_upstream_total() -> ModelArtifact {
  ModelArtifact {
    identity: artifact_deepseek_v4_1_flash_native.identity,
    label: artifact_deepseek_v4_1_flash_native.label,
    footprint: sum_component_footprints(cps: v4_1_artifact_components),
    weight_treatment: PublishedNativeWeights,
    components: v4_1_artifact_components,
    upstream_total: Present { value: byte_size(count: 1 + byte_size_count(b: deepseek_v4_1_flash_safetensors_index_total_size)) },
  }
}

// ── ONE FIELD CHANGES, AND THE COMBINATION IS A DIFFERENT DECISION ────────────────────────────
//
// `upstream_total` is read by `artifact_upstream_agreement_defect`, so it decides admission -- and it
// was absent from `artifact_decomposition_digest` and therefore from the combination key and the
// snapshot key. Two artifacts identical in every other field would have shared a key, so a result
// computed under one would have carried across the change with nothing able to notice. These two
// differ ONLY in that field; dropping it from the digest reds this.
test fn changing_only_the_upstream_total_changes_the_combination_identity() -> Bool {
  let sound = artifact_deepseek_v4_1_flash_native
  let shifted = artifact_with_wrong_upstream_total()
  count(shifted.components) == count(sound.components)
    && artifact_component_digest(art: shifted) == artifact_component_digest(art: sound)
    && artifact_decomposition_digest(art: shifted) != artifact_decomposition_digest(art: sound)
    && !combination_key_eq(
      a: candidate_combination(c: cand(name: "identity_probe", art: sound, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))),
      b: candidate_combination(c: cand(name: "identity_probe", art: shifted, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))))
}

test fn a_decomposition_disagreeing_with_its_upstream_total_refuses() -> Bool {
  match artifact_decomposition_defect(art: artifact_with_wrong_upstream_total()) {
    Present { value: d } => string_contains(s: d as String, pattern: "different tensor populations")
    Absent => false
  } && match establish_serving_candidate_field(field: serving_candidate_field(
    identity: fixture_upstream_mismatch_field_id(),
    domain: serving_deployment_domain(
      artifacts: [artifact_with_wrong_upstream_total()],
      topologies: [topology_shape(tensor_parallel_degree: 8, replica_count: 1)],
      parameters: serving_parameters_current),
    candidates: [cand(name: "upstream_mismatch", art: artifact_with_wrong_upstream_total(), t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))])) {
    ServingFieldUnestablished { causes: cs } => count(cs) > 0
    ServingFieldEstablished => false
  }
}

// AND A DECOMPOSITION THAT DOES NOT SUM IS A STRUCTURAL REFUSAL, not a rounding note. The field
// carrying such an artifact is unestablished, which the product root turns into
// `ServingDeploymentSelectionRefused` rather than a decision over a quantity nobody can name.
fn mismatched_artifact() -> ModelArtifact {
  ModelArtifact {
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "mismatched_artifact"),
    label: "fixture: components that do not sum to the whole" as NonEmptyStr,
    footprint: FootprintObservedOnFleet { bytes: byte_size(count: 1000), how: "fixture" as NonEmptyStr },
    weight_treatment: PublishedNativeWeights,
    components: [
      artifact_component(
        identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "mismatched_artifact"),
        label: "fixture part" as NonEmptyStr,
        footprint: FootprintObservedOnFleet { bytes: byte_size(count: 999), how: "fixture" as NonEmptyStr },
        placement: ComponentResident),
    ],
    upstream_total: none,
  }
}

test fn a_decomposition_that_does_not_sum_refuses_at_the_product_root() -> Bool {
  match artifact_decomposition_defect(art: mismatched_artifact()) {
    Present { value: _ } => true
    Absent => false
  } && match establish_serving_candidate_field(field: serving_candidate_field(
    identity: fixture_mismatched_sum_field_id(),
    domain: serving_deployment_domain(
      artifacts: [mismatched_artifact()],
      topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2)],
      parameters: serving_parameters_current),
    candidates: [cand(name: "mismatched", art: mismatched_artifact(), t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))])) {
    ServingFieldUnestablished { causes: cs } => count(cs) > 0
    ServingFieldEstablished => false
  }
}

// LEGACY BEHAVIOUR IS UNCHANGED OUTSIDE THE NEW SUBJECT. An artifact with no components has a
// resident footprint that IS its whole-artifact footprint, arm for arm and byte for byte, so the
// screen divides exactly what it divided before this change.
test fn an_undecomposed_artifact_divides_exactly_what_it_divided_before() -> Bool {
  let v4 = cand(name: "legacy_v4", art: artifact_deepseek_v4_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2))
  match candidate_resident_footprint(c: v4, p: serving_parameters_current) {
    FootprintObservedOnFleet { bytes: b, how: _ } => byte_size_count(b: b) == 168683720987
    FootprintReportedExternally { bytes: _, source: _ } => false
    FootprintUnread { obligation: _ } => false
  } && match weight_fit_of(c: v4, fleet: pair_unit_a_fleet_snapshot, p: serving_parameters_current) {
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } => true
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => false
    WeightFitUnderivable { because: _ } => false
  } && match candidate_resident_footprint(
    c: cand(name: "legacy_glm", art: artifact_glm_53_flash_native, t: topology_shape(tensor_parallel_degree: 4, replica_count: 2)),
    p: serving_parameters_current) {
    FootprintUnread { obligation: _ } => true
    FootprintObservedOnFleet { bytes: _, how: _ } => false
    FootprintReportedExternally { bytes: _, source: _ } => false
  } && match component_route_reading(route_standings: []) {
    Present { value: r } => r.interval_micro.low == 1
    Absent => false
  }
}

// AND THE V4.1 CANDIDATE'S RESIDENT FOOTPRINT IS UNREAD RATHER THAN SMALLER. With no route selected,
// the Engram component contributes an obligation, so the sum is `FootprintUnread` and the fit stays
// underivable. That is the arm that would be a silent zero if the route's working set were assumed
// away -- and a zero here is exactly what would make a narrow topology look feasible.
test fn a_routed_component_leaves_the_resident_footprint_unread_rather_than_zero() -> Bool {
  let v41 = cand(name: "v41_routed", art: artifact_deepseek_v4_1_flash_native, t: topology_shape(tensor_parallel_degree: 8, replica_count: 1))
  match candidate_resident_footprint(c: v41, p: serving_parameters_current) {
    FootprintUnread { obligation: o } => count(o as String) > 0
    FootprintObservedOnFleet { bytes: _, how: _ } => false
    FootprintReportedExternally { bytes: _, source: _ } => false
  } && match weight_fit_of(c: v41, fleet: pair_unit_a_fleet_snapshot, p: serving_parameters_current) {
    WeightFitUnderivable { because: _ } => true
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } => false
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => false
  }
}

// FIXTURE FIELD IDENTITIES CITE A DECLARATION THAT EXISTS -- a decl_ref naming nothing is a §3
// citation defect the floor's declarations phase reports as CITED-DECLARATION-ABSENT.
fn fixture_upstream_mismatch_field_id() -> DeclarationRef {
  decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_upstream_mismatch_field_id")
}

fn fixture_mismatched_sum_field_id() -> DeclarationRef {
  decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_mismatched_sum_field_id")
}


// THE ENDPOINTS OF THE IDLE FREE-MEMORY READING CANNOT BE TRANSPOSED WITHOUT REFUSAL. Before this
// pair went through `std.interval`, the reading was two sibling `ByteSize` fields hand-typed as
// hundredths of a GiB, and a transposed row would have been a region that denotes nothing which the
// per-rank memory screen then subtracts against. The mint is the wall; these two claims are the
// executing evidence that it is reached FROM THIS SITE rather than only available in `std`.
test fn the_free_memory_mint_refuses_transposed_endpoints() -> Bool {
  match gib_hundredths_interval(low_hundredths: 11695, high_hundredths: 11685) {
    IntervalRefused { reason: r } => count(r as String) > 0
    IntervalReady { interval: _ } => false
  }
}

test fn the_observed_free_memory_endpoints_are_ordered_as_authored() -> Bool {
  match gib_hundredths_interval(low_hundredths: 11685, high_hundredths: 11695) {
    IntervalReady { interval: _ } => true
    IntervalRefused { reason: _ } => false
  }
}

// A REFUSED REGION YIELDS NO GENEROUS ENDPOINT. This is the half that matters to the memory screen:
// the accessor answers Absent rather than reaching into a record that denotes nothing, so the budget
// fold takes its unestablished arm instead of subtracting against a plausible number.
fn free_memory_row_with(free_construction_low: Nat, free_construction_high: Nat) -> GroupRankFreeMemoryObserved {
  GroupRankFreeMemoryObserved {
    group: FabricGroupA,
    reported_free_wire: "a designed row whose endpoints are supplied by this claim" as NonEmptyStr,
    free: gib_hundredths_interval(low_hundredths: free_construction_low, high_hundredths: free_construction_high),
    probed_at: "2026-09-15" as NonEmptyStr,
    instrument: "no instrument: this row exists to exercise the refused-region arm of the accessor" as NonEmptyStr,
    precision_caveat: "not a reading" as NonEmptyStr,
  }
}

test fn a_refused_free_memory_region_offers_no_upper_endpoint() -> Bool {
  match group_rank_free_memory_upper(r: free_memory_row_with(free_construction_low: 11695, free_construction_high: 11685)) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn an_ordered_free_memory_region_offers_its_upper_endpoint() -> Bool {
  match group_rank_free_memory_upper(r: free_memory_row_with(free_construction_low: 11685, free_construction_high: 11695)) {
    Present { value: b } => byte_size_count(b: b) > 0
    Absent => false
  }
}

// THE MINT REFUSING IS NOT EVIDENCE THAT THE AUTHORED ROWS PASS IT. The two claims above establish what
// `gib_hundredths_interval` does with endpoints THIS CLAIM supplies; they say nothing about the rows
// actually in the corpus. Because the construction is stored rather than the interval, a transposed row
// is writable and would otherwise stay silent until a consumer folded it. This is the claim that makes
// an authored transposition red HERE instead -- it is the whole of the class's rung-two standing, and
// deleting it drops the class to rung one.
test fn every_authored_free_memory_row_mints_its_region() -> Bool {
  count(group_rank_free_memory_observed) > 0
    && all(group_rank_free_memory_observed, r => match r.free {
      IntervalReady { interval: _ } => true
      IntervalRefused { reason: _ } => false
    })
}
