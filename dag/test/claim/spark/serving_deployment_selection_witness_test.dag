module test.claim.spark.serving_deployment_selection_witness_test

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.decision { SelectionReceipt }
import std.measure { TokenCount, token_count, token_count_value }
import v2.std.optional { Present, Absent }
import std.pareto { SelectionAxis }
import std.decision {
  HardConstraint, UniqueSurvivorRequired,
  SelectedWithin, SelectionNeedsEvidence, SelectionNeedsPolicy,
  RealizationSelectionRefused, NoFeasibleRealization, CandidateFieldUnestablished,
  select_realization,
}
import gunbc.spark.serving_deployment_selection {
  ModelArtifact, DeploymentCandidate, ReplicaProfile, SpeculationOff, SpeculationOn,
  QualityPolicy, QualityAdmitted, QualityRefused, QualityUnestablished, quality_standing_of,
  WeightsFitWithHeadroom, WeightsExceedRank, WeightFitUnderivable, weight_fit_of,
  FleetSnapshot, WorkloadDemand, spark_fleet_snapshot,
  artifact_deepseek_v4_flash_native, artifact_glm_53_flash_native, artifact_glm_53_flash_2bit,
  glm_candidate_field, project_candidate, serving_selection_axes, serving_selection_constraints,
  useful_context, covers_demand, blast_radius_percent,
  ServingDeploymentSelection, ServingDeploymentSelected, ServingDeploymentNeedsEvidence, ServingDeploymentNeedsPolicy,
  NoFeasibleServingDeployment, ServingDeploymentSelectionRefused,
  select_serving_deployment,
  LaunchAdmitted, LaunchRefused, admit_launch, compared_candidate_count,
  deepseek_launch_admission,
  ax_quality, ax_weight_fit, ax_context_covered,
  serving_deployment_assessment,
}

// ── A FIELD WHOSE FOOTPRINTS ARE MEASURED, so selection can actually complete ─────────────────
//
// The GLM artifact's footprint is deliberately unread, which is the right first answer but cannot
// demonstrate anything downstream of feasibility. These rows use the artifact whose bytes WERE
// measured on the serving host, so the quality wall has something to exclude a winner from.
data demand_300k: WorkloadDemand = WorkloadDemand {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "demand_300k"),
  required_context: token_count(count: 300000),
  basis: "fixture demand" as NonEmptyStr,
}

data native_only: QualityPolicy = QualityPolicy {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "native_only"),
  required_artifact: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "artifact_deepseek_v4_flash_native"),
  rationale: "fixture: the measured native artifact is the subject" as NonEmptyStr,
}

fn cand(name: String, art: ModelArtifact, tp: Nat, replicas: Nat) -> DeploymentCandidate {
  DeploymentCandidate {
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name),
    label: name as NonEmptyStr,
    artifact: art,
    replica: ReplicaProfile {
      tensor_parallel_degree: tp,
      max_model_len: token_count(count: 300000),
      gpu_memory_utilisation_percent: 82,
      speculative: SpeculationOff,
    },
    replica_count: replicas,
  }
}

// The requantised row FITS ON ONE HOST and therefore reaches eight independent replicas with the
// smallest blast radius in the field. On every funded axis it is the best candidate. Only the
// quality constraint keeps it out, which is exactly what makes it the right control.
// EACH CANDIDATE IS ITS OWN DECLARATION, because its identity CITES one. A row whose identity names
// a declaration that does not exist is a positional citation wearing a symbol's clothes -- the
// corpus's citation wall catches it, and it caught this file.
data native_tp2_x4: DeploymentCandidate = cand(name: "native_tp2_x4", art: artifact_deepseek_v4_flash_native, tp: 2, replicas: 4)
data native_tp4_x2: DeploymentCandidate = cand(name: "native_tp4_x2", art: artifact_deepseek_v4_flash_native, tp: 4, replicas: 2)
data native_tp8_x1: DeploymentCandidate = cand(name: "native_tp8_x1", art: artifact_deepseek_v4_flash_native, tp: 8, replicas: 1)
data fast_2bit_tp1_x8: DeploymentCandidate = cand(name: "fast_2bit_tp1_x8", art: artifact_glm_53_flash_2bit, tp: 1, replicas: 8)

data mixed_field: List<DeploymentCandidate> = [native_tp2_x4, native_tp4_x2, native_tp8_x1, fast_2bit_tp1_x8]

fn selected_of(s: ServingDeploymentSelection) -> DeclarationRef? {
  match s {
    ServingDeploymentSelected { candidate: c, receipt: _ } => Present { value: c }
    ServingDeploymentNeedsEvidence { needs: _ } => none
    ServingDeploymentNeedsPolicy { survivors: _ } => none
    NoFeasibleServingDeployment { causes: _ } => none
    ServingDeploymentSelectionRefused { defects: _ } => none
  }
}

// ── THE CONTROL THE WHOLE POLICY RESTS ON ─────────────────────────────────────────────────────
//
// Quality cannot be bought with throughput. The requantised candidate wins every funded axis and
// must still lose, because it is a different set of weights and the subject requires the exact one.
test fn speed_cannot_buy_a_different_artifact() -> Bool {
  match selected_of(s: select_serving_deployment(candidates: mixed_field, fleet: spark_fleet_snapshot, policy: native_only, demand: demand_300k, assessment: serving_deployment_assessment)) {
    Absent => false
    Present { value: c } =>
      !declaration_ref_eq(a: c, b: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fast_2bit_tp1_x8"))
  }
}

// THE MUTATION. Delete the quality constraint and nothing else. The requantised candidate stops
// being excluded before dominance and becomes a live survivor of the field -- the decision that was
// settled turns undecided, with a different set of weights sitting in it as an option. If this row
// ever goes GREEN while the constraint is still in serving_selection_constraints, the constraint
// has stopped excluding anything and the row above is passing for some other reason.
data constraints_without_quality: List<HardConstraint> = [
  HardConstraint { identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints"), axis: ax_weight_fit, bound_micro: 1 },
  HardConstraint { identity: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints"), axis: ax_context_covered, bound_micro: 1 },
]

fn field_contains(refs: List<DeclarationRef>, name: String) -> Bool {
  refs |> any(r => declaration_ref_eq(a: r, b: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name)))
}

test fn without_the_quality_constraint_the_requantised_weights_become_selectable() -> Bool {
  match select_realization(
    assessment: serving_deployment_assessment,
    candidate_field_identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "mixed_field"),
    field: map(mixed_field, c => project_candidate(c: c, fleet: spark_fleet_snapshot, policy: native_only, demand: demand_300k)),
    axes: serving_selection_axes,
    constraints: constraints_without_quality,
    constraint_authority: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "serving_selection_constraints"),
    policy: UniqueSurvivorRequired { identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "native_only") },
    evidence_snapshot: decl_ref(module_path: "gunbc.spark.serving_deployment_selection", decl_name: "spark_fleet_snapshot"),
  ) {
    SelectionNeedsPolicy { survivors: s } =>
      field_contains(refs: s, name: "fast_2bit_tp1_x8") && field_contains(refs: s, name: "native_tp2_x4")
    _ => false
  }
}

// ── AN UNREAD FOOTPRINT IS NOT A FAILURE TO FIT ───────────────────────────────────────────────
//
// The real GLM field returns evidence obligations rather than a shape, because nobody has measured
// the artifact. That is the honest first answer and it is what stops a rumoured byte count being
// divided by four and launched.
test fn the_real_glm_field_needs_evidence_rather_than_choosing() -> Bool {
  match select_serving_deployment(
    candidates: glm_candidate_field, fleet: spark_fleet_snapshot,
    policy: native_only, demand: demand_300k, assessment: serving_deployment_assessment) {
    ServingDeploymentNeedsEvidence { needs: n } => count(n) > 0
    _ => false
  }
}

test fn an_unread_footprint_is_underivable_not_a_misfit() -> Bool {
  match weight_fit_of(c: cand(name: "x", art: artifact_glm_53_flash_native, tp: 4, replicas: 2), fleet: spark_fleet_snapshot) {
    WeightFitUnderivable { because: _ } => true
    WeightsFitWithHeadroom { per_rank_bytes: _, usable_bytes: _, headroom_bytes: _ } => false
    WeightsExceedRank { per_rank_bytes: _, usable_bytes: _ } => false
  }
}

// A single host cannot hold the measured native artifact; four ranks can.
test fn weight_fit_refuses_the_topologies_that_cannot_hold_the_weights() -> Bool {
  match weight_fit_of(c: cand(name: "x", art: artifact_deepseek_v4_flash_native, tp: 1, replicas: 8), fleet: spark_fleet_snapshot) {
    WeightsExceedRank { per_rank_bytes: _, usable_bytes: _ } => true
    _ => false
  } && match weight_fit_of(c: cand(name: "y", art: artifact_deepseek_v4_flash_native, tp: 4, replicas: 2), fleet: spark_fleet_snapshot) {
    WeightsFitWithHeadroom { per_rank_bytes: _, usable_bytes: _, headroom_bytes: _ } => true
    _ => false
  }
}

// ── VALUE SATURATES AT THE DECLARED DEMAND ────────────────────────────────────────────────────
//
// A 400,000-token candidate earns no more context value than a 300,000-token one when the declared
// requirement is 300,000. That is how a knee appears without anyone choosing a decay curve, and it
// is what makes an over-provisioned shape dominated rather than merely more expensive.
fn cand_ctx(name: String, ctx: Nat) -> DeploymentCandidate {
  DeploymentCandidate {
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name),
    label: name as NonEmptyStr,
    artifact: artifact_deepseek_v4_flash_native,
    replica: ReplicaProfile { tensor_parallel_degree: 4, max_model_len: token_count(count: ctx), gpu_memory_utilisation_percent: 82, speculative: SpeculationOff },
    replica_count: 2,
  }
}

test fn exceeding_the_declared_demand_earns_no_further_context_value() -> Bool {
  useful_context(c: cand_ctx(name: "c400", ctx: 400000), demand: demand_300k)
    == useful_context(c: cand_ctx(name: "c300", ctx: 300000), demand: demand_300k)
    && useful_context(c: cand_ctx(name: "c262", ctx: 262144), demand: demand_300k) < 300000
    && !covers_demand(c: cand_ctx(name: "c262b", ctx: 262144), demand: demand_300k)
}

// ── SPECULATION IS NOT ASSUMED LOSSLESS ───────────────────────────────────────────────────────
//
// It is widely described as lossless because draft tokens are verified against the full model, but
// no output-equivalence receipt exists for this profile. Unread is not admitted.
data spec_on: DeploymentCandidate = DeploymentCandidate {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "spec_on"),
  label: "the deployed shape with speculative decoding turned on" as NonEmptyStr,
  artifact: artifact_deepseek_v4_flash_native,
  replica: ReplicaProfile { tensor_parallel_degree: 4, max_model_len: token_count(count: 300000), gpu_memory_utilisation_percent: 82, speculative: SpeculationOn },
  replica_count: 2,
}

test fn speculative_decoding_is_unestablished_rather_than_free() -> Bool {
  match quality_standing_of(c: spec_on, policy: native_only) {
    QualityUnestablished { obligation: _ } => true
    _ => false
  }
}

// ── ONLY A SELECTION MAY LAUNCH ───────────────────────────────────────────────────────────────
test fn an_under_evidenced_decision_cannot_reach_an_engine() -> Bool {
  match admit_launch(s: select_serving_deployment(
    candidates: glm_candidate_field, fleet: spark_fleet_snapshot,
    policy: native_only, demand: demand_300k, assessment: serving_deployment_assessment),
    candidates: glm_candidate_field) {
    LaunchRefused { because: _ } => true
    LaunchAdmitted { profile: _ } => false
  }
}

// ── A SETTLED CHOICE IS A FIELD OF ONE, AND THE RECEIPT SAYS SO ───────────────────────────────
//
// Deciding in advance stays legal. What stops being possible is deciding in advance INVISIBLY: a
// one-candidate field passes the spine and yields a receipt whose compared-candidate count is one,
// so "nothing was compared" is a number a reader can find rather than the silent default it is when
// a launch profile is assembled from literals.
data settled_field: List<DeploymentCandidate> = [native_tp4_x2]

test fn a_settled_choice_still_produces_a_receipt_that_reports_a_field_of_one() -> Bool {
  match admit_launch(
    s: select_serving_deployment(candidates: settled_field, fleet: spark_fleet_snapshot,
       policy: native_only, demand: demand_300k, assessment: serving_deployment_assessment),
    candidates: settled_field) {
    LaunchAdmitted { profile: p } => compared_candidate_count(r: p.receipt) == 1
    LaunchRefused { because: _ } => false
  }
}

// And a real comparison reports what it actually compared, so the two are distinguishable.
test fn a_compared_field_reports_more_than_one_candidate() -> Bool {
  match admit_launch(
    s: select_serving_deployment(candidates: mixed_field, fleet: spark_fleet_snapshot,
       policy: native_only, demand: demand_300k, assessment: serving_deployment_assessment),
    candidates: mixed_field) {
    LaunchAdmitted { profile: p } => compared_candidate_count(r: p.receipt) > 1
    LaunchRefused { because: _ } => false
  }
}

// ── THE DEPLOYED DEEPSEEK SHAPE, ANSWERED RATHER THAN ASSUMED ─────────────────────────────────
//
// This row asserts nothing about WHICH shape wins. It asserts that the question now has an answer
// carrying a receipt -- which is the property the convergence lacked when its topology came from
// `length(hosts)`. What the answer IS belongs in the PR body and to an operator, not in a claim
// that would have to be edited every time the fleet changed size.
test fn the_deployed_deepseek_shape_is_a_decided_question_with_a_receipt() -> Bool {
  match deepseek_launch_admission() {
    LaunchAdmitted { profile: p } => compared_candidate_count(r: p.receipt) == 4
    LaunchRefused { because: _ } => false
  }
}
