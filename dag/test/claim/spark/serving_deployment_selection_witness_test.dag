  topology_shape(tensor_parallel_degree: 1, replica_count: 8),
  topology_shape(tensor_parallel_degree: 2, replica_count: 4),
  topology_shape(tensor_parallel_degree: 4, replica_count: 2),
  topology_shape(tensor_parallel_degree: 8, replica_count: 1),
]

