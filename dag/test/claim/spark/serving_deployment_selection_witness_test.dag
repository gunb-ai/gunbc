  ServingDeploymentCandidateField, serving_candidate_field,
  ServingFieldEstablished, ServingFieldUnestablished, establish_serving_candidate_field,
  ServingDeploymentEvidenceSnapshot, serving_evidence_snapshot,
  ServingDeploymentDecisionInput, serving_decision_input, decision_snapshot_key,
  ServingDeploymentSelection, ServingDeploymentSelected, ServingDeploymentNeedsEvidence,
  select_serving_deployment,
  ShapeAdmittedForPlacement, FabricPlacementRequired, admit_shape, compared_candidate_count,
  glm_decision_input, deepseek_decision_input, deepseek_v4_1_decision_input,
