module test.claim.spark.serving_deployment_selection_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, decl_ref, declaration_ref_eq }
import std.measure { token_count }
import v2.std.optional { Present, Absent }
import gunbc.spark.serving_deployment_selection {
  ModelArtifact, DeploymentCandidate, ReplicaProfile, SpeculationOff, SpeculationOn,
  QualityPolicy, QualityReceipt, ServingQualitySubject,
  QualityAdmitted, QualityRefused, QualityUnestablished, quality_standing_of,
  WeightsNotRuledOutByLowerBound, WeightsImpossibleByLowerBound, WeightFitUnderivable, weight_fit_of,
  per_rank_bytes_ceiling, fleet_fits,
  WorkloadDemand, spark_fleet_snapshot,
  artifact_deepseek_v4_flash_native, artifact_glm_53_flash_native, artifact_glm_53_flash_2bit,
  TopologyShape, ServingDeploymentChoiceDomain, ServingDeploymentCandidateField,
  topology_shape, serving_deployment_domain, serving_candidate_field,
  serving_quality_subject, serving_quality_receipt, serving_decision_input,
  ServingFieldEstablished, ServingFieldUnestablished, establish_serving_candidate_field,
  ServingDeploymentDecisionInput,
  ServingDeploymentSelection, ServingDeploymentSelected, ServingDeploymentNeedsEvidence,
  select_serving_deployment, useful_context, covers_demand,
  LaunchAdmitted, LaunchRefused, admit_launch, compared_candidate_count,
  glm_first_serving_selection, deepseek_serving_selection,
  serving_deployment_assessment, id_subject, id_physical_authority,
}

// ── FIXTURES ──────────────────────────────────────────────────────────────────────────────────
//
// The production subjects deliberately return evidence obligations, so a completed selection needs
// a fixture that ADMITS specific profiles by receipt. That is not a loophole around the quality
// wall -- it is the wall's positive control. Without one, every refusal row below could be
// satisfied vacuously by a mechanism that refuses unconditionally.
data demand_300k: WorkloadDemand = WorkloadDemand {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "demand_300k"),
  required_context: token_count(count: 300000),
  basis: "fixture demand" as NonEmptyStr,
}

data required_artifact_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.spark.serving_deployment_selection",
  decl_name: "artifact_deepseek_v4_flash_native",
  field: WholeDeclaration,
}

fn subject_at(tp: Nat) -> ServingQualitySubject {
  serving_quality_subject(artifact: required_artifact_ref, tensor_parallel_degree: tp, speculative: SpeculationOff)
}

fn receipt_at(tp: Nat) -> QualityReceipt {
  serving_quality_receipt(
    subject: subject_at(tp: tp),
    established_by: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_policy"),
    note: "fixture: quality established for this exact profile" as NonEmptyStr,
  )
}

// EVERY topology in the domain is admitted, so nothing below wins or loses on quality COVERAGE --
// only on the artifact wall itself. A roster admitting one topology would silently turn the
// isolation comparison into a quality comparison.
data fixture_policy: QualityPolicy = QualityPolicy {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_policy"),
  required_artifact: required_artifact_ref,
  admitted_profiles: [receipt_at(tp: 8), receipt_at(tp: 4), receipt_at(tp: 2), receipt_at(tp: 1)],
  rationale: "fixture: the measured native artifact is the subject and each topology carries its own receipt" as NonEmptyStr,
}

fn cand(name: String, art: ModelArtifact, tp: Nat, replicas: Nat) -> DeploymentCandidate {
  DeploymentCandidate {
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name),
    label: name as NonEmptyStr,
    artifact: art,
    replica: ReplicaProfile {
      tensor_parallel_degree: tp,
      max_model_len: token_count(count: 300000),
      gpu_memory_utilisation_percent: 82,
      speculative: SpeculationOff,
    },
    replica_count: replicas,
  }
}

data native_tp8_x1: DeploymentCandidate = cand(name: "native_tp8_x1", art: artifact_deepseek_v4_flash_native, tp: 8, replicas: 1)
data native_tp4_x2: DeploymentCandidate = cand(name: "native_tp4_x2", art: artifact_deepseek_v4_flash_native, tp: 4, replicas: 2)
data native_tp2_x4: DeploymentCandidate = cand(name: "native_tp2_x4", art: artifact_deepseek_v4_flash_native, tp: 2, replicas: 4)
data native_tp1_x8: DeploymentCandidate = cand(name: "native_tp1_x8", art: artifact_deepseek_v4_flash_native, tp: 1, replicas: 8)

data native_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(artifacts: [artifact_deepseek_v4_flash_native], topologies: [
    topology_shape(tensor_parallel_degree: 8, replica_count: 1),
    topology_shape(tensor_parallel_degree: 4, replica_count: 2),
    topology_shape(tensor_parallel_degree: 2, replica_count: 4),
    topology_shape(tensor_parallel_degree: 1, replica_count: 8),
  ])

data native_field: ServingDeploymentCandidateField = serving_candidate_field(identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "native_field"), domain: native_domain, candidates: [native_tp8_x1, native_tp4_x2, native_tp2_x4, native_tp1_x8])

fn input_over(field: ServingDeploymentCandidateField, policy: QualityPolicy) -> ServingDeploymentDecisionInput {
  serving_decision_input(
    subject_identity: id_subject,
    field: field,
    fleet: spark_fleet_snapshot,
    fleet_identity: id_physical_authority,
    quality_policy: policy,
    demand: demand_300k,
    evidence_snapshot: id_physical_authority,
    selection_policy: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "fixture_policy"),
    assessment: serving_deployment_assessment,
  )
}

// ── THE PRODUCTION SUBJECTS ANSWER WITH OBLIGATIONS, NOT WITH A SHAPE ─────────────────────────
//
// This is the row that most needed to change. An earlier version of this module SELECTED a DeepSeek
// topology and reported it as a finding, on a quality gate that could not see topology and a field
// whose only discriminating axes were replica count and capacity share. Both real subjects now
// return evidence needs, which is the correct answer while no topology-specific quality receipt and
// no runtime feasibility observation exist for any profile on this fleet.
test fn the_real_deepseek_subject_returns_obligations_rather_than_a_topology() -> Bool {
  match deepseek_serving_selection() {
    ServingDeploymentNeedsEvidence { needs: n } => count(n) > 0
    _ => false
  }
}

test fn the_real_glm_subject_returns_obligations_rather_than_a_shape() -> Bool {
  match glm_first_serving_selection() {
    ServingDeploymentNeedsEvidence { needs: n } => count(n) > 0
    _ => false
  }
}

// ── QUALITY IS A PROPERTY OF THE PROFILE, NOT OF THE WEIGHTS ──────────────────────────────────
//
// THE DISCRIMINATING ROW. The same required artifact, speculation off, at a topology the policy has
// no receipt for, is UNESTABLISHED rather than admitted. Under the previous gate this answered
// QualityAdmitted, which is what let a topology change be recommended on evidence that could not
// see topology. Restoring artifact-only admission turns this row red and nothing else would notice.
data unrostered_policy: QualityPolicy = QualityPolicy {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "unrostered_policy"),
  required_artifact: required_artifact_ref,
  admitted_profiles: [receipt_at(tp: 4)],
  rationale: "fixture: only the four-rank profile carries a quality receipt" as NonEmptyStr,
}

test fn the_same_weights_at_an_unreceipted_topology_are_unestablished() -> Bool {
  match quality_standing_of(c: native_tp2_x4, policy: unrostered_policy) {
    QualityUnestablished { obligation: _ } => true
    _ => false
  } && match quality_standing_of(c: native_tp4_x2, policy: unrostered_policy) {
    QualityAdmitted { evidence: _ } => true
    _ => false
  }
}

// A DIFFERENT ARTIFACT IS REFUSED, NOT MERELY UNMEASURED. That distinction is the whole quality
// policy: unread is an obligation, wrong weights is a decided negative no receipt can lift.
test fn a_different_artifact_is_refused_rather_than_left_open() -> Bool {
  match quality_standing_of(c: cand(name: "fast_2bit", art: artifact_glm_53_flash_2bit, tp: 1, replicas: 8), policy: fixture_policy) {
    QualityRefused { violated: _ } => true
    _ => false
  }
}

// IDENTITY COMPARISON IS COMPLETE. A ref agreeing on module and name but differing in `field` is a
// different declaration, and comparing only the first two spellings would admit it.
data field_shifted_policy: QualityPolicy = QualityPolicy {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "field_shifted_policy"),
  required_artifact: DeclarationRef {
    module_path: "gunbc.spark.serving_deployment_selection",
    decl_name: "artifact_deepseek_v4_flash_native",
    field: NamedField { field_name: "footprint" as NonEmptyStr },
  },
  admitted_profiles: [receipt_at(tp: 4)],
  rationale: "fixture: same module and name, different field" as NonEmptyStr,
}

test fn an_artifact_ref_differing_only_in_field_is_a_different_artifact() -> Bool {
  match quality_standing_of(c: native_tp4_x2, policy: field_shifted_policy) {
    QualityRefused { violated: _ } => true
    _ => false
  }
}

// ── THE LOWER BOUND DISPROVES; IT DOES NOT ESTABLISH ──────────────────────────────────────────
test fn the_weight_bound_refuses_a_rank_that_cannot_hold_its_share() -> Bool {
  match weight_fit_of(c: native_tp1_x8, fleet: spark_fleet_snapshot) {
    WeightsImpossibleByLowerBound { per_rank_bytes: _, usable_bytes: _ } => true
    _ => false
  } && match weight_fit_of(c: native_tp4_x2, fleet: spark_fleet_snapshot) {
    WeightsNotRuledOutByLowerBound { per_rank_bytes: _, usable_bytes: _, slack_bytes: _ } => true
    _ => false
  }
}

test fn an_unread_footprint_is_underivable_not_a_misfit() -> Bool {
  match weight_fit_of(c: cand(name: "unread", art: artifact_glm_53_flash_native, tp: 4, replicas: 2), fleet: spark_fleet_snapshot) {
    WeightFitUnderivable { because: _ } => true
    _ => false
  }
}

// CEILING, NOT FLOOR. 101 bytes over 2 ranks is 51 per rank. Floor division answers 50, admitting a
// candidate whose ranks cannot hold their share -- the wrong direction for a bound whose only job
// is to disprove.
test fn per_rank_bytes_round_up_so_the_bound_never_understates() -> Bool {
  per_rank_bytes_ceiling(total: 101, ranks: 2) == 51
    && per_rank_bytes_ceiling(total: 100, ranks: 2) == 50
    && per_rank_bytes_ceiling(total: 1, ranks: 8) == 1
}

// ── A DEGENERATE SHAPE IS NOT A CHEAP ONE ─────────────────────────────────────────────────────
//
// Zero replicas consume no hosts, so a fleet-fit test comparing only host counts would admit a
// deployment that serves nothing and then let it win every capacity axis it never paid for.
test fn a_deployment_of_no_replicas_does_not_fit_the_fleet() -> Bool {
  !fleet_fits(c: cand(name: "zero_replicas", art: artifact_deepseek_v4_flash_native, tp: 4, replicas: 0), fleet: spark_fleet_snapshot)
    && !fleet_fits(c: cand(name: "zero_ranks", art: artifact_deepseek_v4_flash_native, tp: 0, replicas: 2), fleet: spark_fleet_snapshot)
    && fleet_fits(c: native_tp4_x2, fleet: spark_fleet_snapshot)
}

// ── COMPLETENESS IS A JOIN AGAINST THE DECLARED DOMAIN ────────────────────────────────────────
//
// THE DOMAIN-DELETION MUTATION. Remove one combination the domain admits and the field must refuse,
// because otherwise an author obtains a preferred winner by omitting the candidate that beats it.
// A count cannot catch this: the short field is still nonempty and duplicate-free.
data field_missing_one: ServingDeploymentCandidateField = serving_candidate_field(identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "field_missing_one"), domain: native_domain, candidates: [native_tp8_x1, native_tp4_x2, native_tp1_x8])

test fn a_field_missing_a_combination_its_domain_admits_is_unestablished() -> Bool {
  match establish_serving_candidate_field(field: field_missing_one) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

test fn the_complete_field_is_established() -> Bool {
  match establish_serving_candidate_field(field: native_field) {
    ServingFieldEstablished => true
    ServingFieldUnestablished { causes: _ } => false
  }
}

// A CANDIDATE THE DOMAIN NEVER ADMITTED IS A DEFECT IN THE OTHER DIRECTION: it enters a comparison
// the declared choice domain does not sanction.
data field_with_extra: ServingDeploymentCandidateField = serving_candidate_field(identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "field_with_extra"), domain: native_domain, candidates: [native_tp8_x1, native_tp4_x2, native_tp2_x4, native_tp1_x8, cand(name: "undeclared_tp2_x2", art: artifact_deepseek_v4_flash_native, tp: 2, replicas: 2)])

test fn a_candidate_outside_the_declared_domain_is_unestablished() -> Bool {
  match establish_serving_candidate_field(field: field_with_extra) {
    ServingFieldUnestablished { causes: c } => count(c) > 0
    ServingFieldEstablished => false
  }
}

// A SETTLED CHOICE IS LEGAL, and it is a domain that genuinely yields one combination rather than a
// truncated roster -- exactly the distinction a receipt count cannot draw.
data settled_domain: ServingDeploymentChoiceDomain = serving_deployment_domain(artifacts: [artifact_deepseek_v4_flash_native], topologies: [topology_shape(tensor_parallel_degree: 4, replica_count: 2)])

data settled_field: ServingDeploymentCandidateField = serving_candidate_field(identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "settled_field"), domain: settled_domain, candidates: [native_tp4_x2])

test fn a_settled_domain_of_one_combination_is_established() -> Bool {
  match establish_serving_candidate_field(field: settled_field) {
    ServingFieldEstablished => true
    ServingFieldUnestablished { causes: _ } => false
  }
}

// ── THE RECEIPT NAMES THE FIELD THAT SUPPLIED THE CANDIDATE ───────────────────────────────────
//
// THE FIELD-IDENTITY MUTATION. A selection over the settled field must not produce a receipt naming
// some other field. The previous version always reported `glm_candidate_field` whatever it was
// handed, and the singleton count row passed anyway -- a count says how many identities a receipt
// carries, never which field they came from.
fn selected_field_identity(s: ServingDeploymentSelection) -> DeclarationRef? {
  match s {
    ServingDeploymentSelected { selected: sel } => Present { value: sel.receipt.candidate_field_identity }
    _ => none
  }
}

test fn the_receipt_names_the_field_the_selection_was_made_over() -> Bool {
  match selected_field_identity(s: select_serving_deployment(input: input_over(field: settled_field, policy: fixture_policy))) {
    Absent => false
    Present { value: id } =>
      declaration_ref_eq(a: id, b: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "settled_field"))
  }
}

// ── VALUE SATURATES AT THE DECLARED DEMAND ────────────────────────────────────────────────────
fn cand_ctx(name: String, ctx: Nat) -> DeploymentCandidate {
  DeploymentCandidate {
    identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: name),
    label: name as NonEmptyStr,
    artifact: artifact_deepseek_v4_flash_native,
    replica: ReplicaProfile { tensor_parallel_degree: 4, max_model_len: token_count(count: ctx), gpu_memory_utilisation_percent: 82, speculative: SpeculationOff },
    replica_count: 2,
  }
}

test fn exceeding_the_declared_demand_earns_no_further_context_value() -> Bool {
  useful_context(c: cand_ctx(name: "c400", ctx: 400000), demand: demand_300k)
    == useful_context(c: cand_ctx(name: "c300", ctx: 300000), demand: demand_300k)
    && useful_context(c: cand_ctx(name: "c262", ctx: 262144), demand: demand_300k) < 300000
    && !covers_demand(c: cand_ctx(name: "c262b", ctx: 262144), demand: demand_300k)
}

// ── SPECULATION IS NOT ASSUMED LOSSLESS ───────────────────────────────────────────────────────
data spec_on: DeploymentCandidate = DeploymentCandidate {
  identity: decl_ref(module_path: "test.claim.spark.serving_deployment_selection_witness_test", decl_name: "spec_on"),
  label: "the deployed shape with speculative decoding turned on" as NonEmptyStr,
  artifact: artifact_deepseek_v4_flash_native,
  replica: ReplicaProfile { tensor_parallel_degree: 4, max_model_len: token_count(count: 300000), gpu_memory_utilisation_percent: 82, speculative: SpeculationOn },
  replica_count: 2,
}

test fn speculative_decoding_is_unestablished_rather_than_free() -> Bool {
  match quality_standing_of(c: spec_on, policy: fixture_policy) {
    QualityUnestablished { obligation: _ } => true
    _ => false
  }
}

// ── ONLY A SELECTION MAY LAUNCH, AND THE LAUNCH IS THE WHOLE FLEET ────────────────────────────
test fn an_under_evidenced_decision_cannot_reach_an_engine() -> Bool {
  match admit_launch(s: deepseek_serving_selection()) {
    LaunchRefused { because: _ } => true
    LaunchAdmitted { plan: _ } => false
  }
}

// THE PLAN EXPRESSES THE DEPLOYMENT THE SELECTION WAS MADE ON. A single ReplicaProfile could
// describe a four-rank replica but not TWO disjoint ones, so the shape the decision turned on was
// not actuable from the result. One placement per replica, and unassigned hosts stay visible.
test fn the_launch_plan_carries_one_placement_per_replica_and_the_leftover_hosts() -> Bool {
  match admit_launch(s: select_serving_deployment(input: input_over(field: settled_field, policy: fixture_policy))) {
    LaunchAdmitted { plan: p } => count(p.replicas) == 2 && p.hosts_assigned == 8 && p.hosts_unassigned == 0
    LaunchRefused { because: _ } => false
  }
}

test fn a_settled_choice_still_produces_a_receipt_that_reports_a_field_of_one() -> Bool {
  match admit_launch(s: select_serving_deployment(input: input_over(field: settled_field, policy: fixture_policy))) {
    LaunchAdmitted { plan: p } => compared_candidate_count(r: p.selected_by) == 1
    LaunchRefused { because: _ } => false
  }
}
