data hermetic_identity_file: NonEmptyStr = "/tmp/gunbc-hermetic-acquisition-fixture-key"

data hermetic_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIHERMETICACQUISITIONFIXTURE000000" as NonEmptyStr,
  comment: "hermetic-acquisition-fixture",
}

data hermetic_fleet_attempt_raw: String = "hermetic-acquisition"

// THE BINDING IS DERIVED, NOT DECLARED.
//
// `FleetSshCredentialBinding` has one reachable mint and it is admitted to the credential classifier
// alone, deliberately: a binding must not exist without a derivation that produced the material
// being hashed. Adding a fixture to that seal would make the seal's annotation false, so this goes
// THROUGH the classifier with a hermetic stdout instead. The equality the classifier establishes is
// real; only the transport that would have produced the line is simulated.
fn hermetic_credential() -> FleetSshCredentialBinding?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_admission"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "the_transaction_carries_its_full_acquisition_identity"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "the_transaction_receipt_reports_coverage_and_outcome_shape"),
  ] {
  match classify_derived_public_key_line(
    identity_file: hermetic_identity_file,
    expected_key: hermetic_key,
    derivation_succeeded: true,
    derivation_stdout: expected_public_key_line(key: hermetic_key),
    derivation_stderr: "",
  ) {
    FleetSshCredentialVerified { binding: b } => Present { value: b }
    FleetSshCredentialIdentityMismatch { expected_line: _, observed_line: _ } => none
    FleetSshCredentialDerivationRefused { cause: _ } => none
  }
}
fn hermetic_fleet_attempt() -> FleetSshAttemptIdentity?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_admission"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "observations_of_one_host_in_one_attempt_differ_by_phase"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "the_observation_attempt_is_a_join_of_fleet_attempt_host_and_phase"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "the_post_apply_reading_carries_its_own_phase_identity"),
  ] {
  fleet_ssh_attempt_identity(raw: hermetic_fleet_attempt_raw)
}

fn hermetic_ok(out: String) -> SparkServingProbeOutcome
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_capture"),
  ] {
  SparkServingProbeExecuted {
    result: SshSessionExecResult { exit_code: 0, success: true, stdout: out, stderr: "" },
  }
}

// THE ONE ADMITTED FIXTURE ROUTE INTO THE CAPTURE MINT.
fn hermetic_capture_of(
  request: SparkServingProbeRequest,
  outcome: SparkServingProbeOutcome,
) -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_capture"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_leg"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "hermetic_capture_fixture"),
  ] {
  spark_serving_probe_leg_capture_of(request: request, outcome: outcome)
}

fn hermetic_capture(request: SparkServingProbeRequest, out: String) -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_complete_captures"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "capture"),
  ] {
  hermetic_capture_of(request: request, outcome: hermetic_ok(out: out))
}

// THE COMPLETE POPULATION, BECAUSE A TRANSACTION MISSING ONE OF THEM IS NOT A TRANSACTION.
//
// Coverage is checked at identity grain against the required roster rather than by counting, so this
// enumerates the requests: a count would be satisfied by twenty-three copies of the wrong one.
fn hermetic_every_request() -> List<SparkServingProbeRequest>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_complete_captures"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "every_request"),
  ] {
  [
    LoadStateRequest, IsActiveRequest, VersionRequest, TagsRequest, NvidiaDriverRequest,
    RuntimeReceiptRequest, ActiveEnterRequest, DefaultTargetEnterRequest, UptimeRequest,
    GrantsRequest, PasswdRequest, AuthorizedKeysRequest, LingerRequest,
    ModelManifestRequest, ModelBlobsListingRequest, ModelManifestDigestRequest,
    ModelBlobDigestsRequest { digests: ["deadbeef" as NonEmptyStr] },
    UserUnitReadRequest, UserUnitIsEnabledRequest,
    RuntimeRootRequest, RuntimeExecutableRequest, RuntimeExecutableBitRequest,
    RuntimeRootListingRequest,
  ]
}

fn hermetic_complete_captures() -> List<SparkServingProbeLegCapture>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "complete_captures"),
  ] {
  map(hermetic_every_request(), r => hermetic_capture(request: r, out: "fixture"))
}

// THE ONE ADMITTED FIXTURE ROUTE INTO THE TRANSACTION MINT.
fn hermetic_transaction_of(
  host: HostIdentity,
  fleet_attempt: FleetSshAttemptIdentity,
  phase: SparkServingObservationPhase,
  credential: FleetSshCredentialBinding,
  captures: List<SparkServingProbeLegCapture>,
) -> SparkServingTransactionAdmission
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_admission"),
  ] {
  spark_serving_observation_transaction_of(
    request: hermetic_request(host: host, fleet_attempt: fleet_attempt, phase: phase),
    credential: credential,
    captures: captures,
  )
}

// Both identity values are OPTIONAL because both are parsed rather than asserted. If either refuses,
// this answers refused rather than substituting a plausible constant, so a claim that needs an
// admitted transaction goes red instead of testing a fabricated one.
// THE ONE ADMITTED FIXTURE ROUTE INTO THE REQUEST MINT.
fn hermetic_request(
  host: HostIdentity,
  fleet_attempt: FleetSshAttemptIdentity,
  phase: SparkServingObservationPhase,
) -> SparkServingObservationRequest
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_transaction_of"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "attempt_for"),
  ] {
  spark_serving_observation_request(host: host, fleet_attempt: fleet_attempt, phase: phase)
}

// OPTIONAL BECAUSE THE FIXTURE'S OWN MATERIAL IS PARSED, NOT ASSERTED.
//
// Absent means this fixture could not build a credential or a fleet attempt at all, which is a
// BROKEN FIXTURE and not a transaction refusal. It cannot be reported as one: a refusal now carries
// the request it refused, and the request needs the very attempt that failed to parse. Conflating
// the two would put a fabricated request inside a refusal -- the same shape as everything else this
// carrier removes -- so the two outcomes stay different types and a caller must handle both.
fn hermetic_admission(
  host: HostIdentity,
  phase: SparkServingObservationPhase,
  captures: List<SparkServingProbeLegCapture>,
) -> SparkServingTransactionAdmission?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_acquired_observation"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "admission_at"),
  ] {
  match hermetic_fleet_attempt() {
    Absent => none
    Present { value: fa } =>
      match hermetic_credential() {
        Absent => none
        Present { value: cr } =>
          Present {
            value: hermetic_transaction_of(
              host: host,
              fleet_attempt: fa,
              phase: phase,
              credential: cr,
              captures: captures,
            ),
          }
      }
  }
}
// The non-acquired arm, kept so a witness can author the value planning must REFUSE.
fn hermetic_fixture_provenance(host: HostIdentity) -> SparkServingObservationProvenance
  admit_callers: [
    decl_ref(module_path: "test.claim.spark_serving_converge_slice_witness", decl_name: "witness_provenance"),
    decl_ref(module_path: "test.claim.spark_serving_full_plan_witness_test", decl_name: "witness_provenance"),
    decl_ref(module_path: "test.claim.spark_serving_model_store_witness_test", decl_name: "witness_provenance"),
  ] {
  spark_serving_hermetic_provenance_of(
    host: host,
    fixture_identity: "hermetic-witness-fixture" as NonEmptyStr,
  )
}

// A READBACK CARRYING NOTHING BUT ITS HOST.
//
// Every field refuses honestly rather than inventing a value a probe would have had to produce. It
// is only reachable through the hermetic route below, so it can never sit under an acquired arm.
fn hermetic_readback(host: HostIdentity) -> SparkServingReadback
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "a_hermetic_host_prints_no_acquired_line_in_the_same_report"),
    decl_ref(module_path: "test.claim.spark_serving_full_plan_witness_test", decl_name: "a_hermetic_observation_cannot_produce_a_bound_plan"),
  ] {
  SparkServingReadback {
    host: host,
    unit_outcome: SparkServingUnitAbsent,
    runtime_version: SparkServingReadbackAbsent,
    runtime_materialization_identity: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
    boot_provenance: BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as NonEmptyStr },
    grants: GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }
}

// THE FIXTURE ROUTE FOR INDEPENDENTLY AUTHORED FACTS, AND IT CANNOT CLAIM ACQUISITION.
//
// Review found the defect this replaces: the previous route took a provenance parameter, so a
// fixture could pair an ACQUIRED provenance projected from a real transaction with runtime, store,
// unit and linger authored independently of that transaction's captures. Authentic arm, fabricated
// facts -- this carrier's own defect one layer up, and none of the REDs caught it because they all
// proved the WRONG ARM is refused rather than that the right arm's facts are real.
//
// There is no provenance parameter now. spark_serving_hermetic_host_observation has none either, so
// the pairing is not expressible from any fixture rather than merely not written by this one.
fn hermetic_host_observation(
  readback: SparkServingReadback,
  account: SparkManagedAccountObservation,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  observed_unit: SparkServingObservedUnit,
  linger: SparkServingObservedLingerState,
) -> SparkServingHostObservation
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "a_hermetic_host_prints_no_acquired_line_in_the_same_report"),
    decl_ref(module_path: "test.claim.spark_serving_full_plan_witness_test", decl_name: "a_hermetic_observation_cannot_produce_a_bound_plan"),
    decl_ref(module_path: "test.claim.spark_serving_observe_witness_test", decl_name: "ho_from"),
  ] {
  spark_serving_hermetic_host_observation(
    readback: readback,
    account: account,
    runtime: runtime,
    store: store,
    observed_unit: observed_unit,
    linger: linger,
    fixture_identity: "hermetic-witness-fixture" as NonEmptyStr,
  )
}

// THE ACQUIRED ROUTE, AND ITS FACTS COME FROM THE CAPTURES OR THEY DO NOT EXIST.
//
// This is the ONLY way a witness obtains an observation whose provenance is the acquired arm, and it
// supplies nothing but captures: the runtime, store, unit, linger, readback, account and projection
// are all derived by the SAME production projectors production uses. To make a particular acquired
// state, a witness chooses capture stdout until the projectors derive it -- which is the cost the
// review correctly insisted on, because paying it is what makes the resulting value evidence.
//
// Absent means the fixture's own transaction refused. It is returned rather than swallowed so a
// broken fixture reddens its claims instead of quietly turning them into refusal tests.
//
// The FIRST entry is the GREEN CONTROL of this roster's own wall. Its probe module makes the same
// call, with the same arguments, as the unadmitted probe beside it in
// test.claim.spark.spark_serving_fixture_admission_witness_test; the two differ in exactly one
// respect, whether this list names the caller. Remove that entry and the control goes red, which is
// what makes the refusal beside it evidence about the seal rather than about the call.
fn hermetic_acquired_observation(
  host: HostIdentity,
  phase: SparkServingObservationPhase,
  captures: List<SparkServingProbeLegCapture>,
) -> SparkServingHostObservation?
  admit_callers: [
    decl_ref(module_path: "probe_spark_fixture_admitted", decl_name: "through_an_admitted_route"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_observation"),
    decl_ref(module_path: "test.claim.spark.spark_serving_observation_transaction_witness_test", decl_name: "acquired_observation_body"),
  ] {
  match hermetic_admission(host: host, phase: phase, captures: captures) {
    Absent => none
    Present { value: SparkServingTransactionRefused { refusal: _ } } => none
    Present { value: SparkServingTransactionAdmitted { txn: t } } =>
      Present { value: spark_serving_host_observation_from_transaction(txn: t) }
  }
}

// ── SHAPING CAPTURES SO THE PRODUCTION PROJECTORS DERIVE A CHOSEN STATE ─────────────────────────

// THIS IS THE COST THE REVIEW INSISTED ON, AND PAYING IT IS WHAT MAKES THE VALUE EVIDENCE.
//
// A witness that wants an acquired observation in a particular state cannot declare that state; it
// must author capture results whose stdout, stderr and exit codes make the SAME projectors
// production uses derive it. So these helpers encode what each probe actually answers -- systemd's
// "enabled", is-active's exit 3, cat's "No such file or directory", loginctl's "Linger=yes" -- and
// if a projector's parse changes, these fixtures move with it or the claims go red. A fixture that
// declared the state instead would keep passing while the parse rotted.
fn hermetic_exec(exit_code: Int, out: String, err: String) -> SparkServingProbeOutcome
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_leg"),
  ] {
  SparkServingProbeExecuted {
    result: SshSessionExecResult {
      exit_code: exit_code,
      success: exit_code == 0,
      stdout: out,
      stderr: err,
    },
  }
}

fn hermetic_leg(
  request: SparkServingProbeRequest,
  exit_code: Int,
  out: String,
  err: String,
) -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_linger_capture"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_linger_unobserved_capture"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_runtime_complete_captures"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_store_complete_captures"),
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_unit_captures"),
  ] {
  hermetic_capture_of(
    request: request,
    outcome: hermetic_exec(exit_code: exit_code, out: out, err: err),
  )
}

// `loginctl show-user -p Linger` answers exactly these two words on success.
fn hermetic_linger_capture(enabled: Bool) -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_linger_state_capture"),
  ] {
  hermetic_leg(
    request: LingerRequest,
    exit_code: 0,
    out: if enabled { "Linger=yes" } else { "Linger=no" },
    err: "",
  )
}

// THE THIRD LINGER STATE IS EARNED THE SAME WAY THE OTHER TWO ARE.
//
// An unobserved linger is not a value a fixture may assert; it is what the production projector
// derives from a loginctl that RAN and answered nonzero. The leg is still executed, so the
// transaction's coverage stays complete and the observation is still acquired -- which is the point:
// this is a host whose linger genuinely was not readable, not a host we declined to probe.
fn hermetic_linger_unobserved_capture() -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_linger_state_capture"),
  ] {
  hermetic_leg(
    request: LingerRequest,
    exit_code: 1,
    out: "",
    err: "Failed to get user: No such process",
  )
}

fn hermetic_linger_state_capture(
  linger: SparkServingObservedLingerState,
) -> SparkServingProbeLegCapture
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  match linger {
    LingerObservedEnabled => hermetic_linger_capture(enabled: true)
    LingerObservedDisabled => hermetic_linger_capture(enabled: false)
    LingerUnobservedState => hermetic_linger_unobserved_capture()
  }
}
// The unit legs: a readable unit file, `systemctl --user is-enabled` answering "enabled", and
// `is-active` answering "active" on exit 0. Together these make the production classifiers derive an
// observed, enabled, running unit -- the state a converged host is in.
fn hermetic_unit_captures() -> List<SparkServingProbeLegCapture>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  [
    hermetic_leg(
      request: UserUnitReadRequest,
      exit_code: 0,
      out: spark_serving_user_unit_content_wire(text: spark_serving_desired_user_unit_text()),
      err: "",
    ),
    hermetic_leg(request: UserUnitIsEnabledRequest, exit_code: 0, out: "enabled", err: ""),
    hermetic_leg(request: IsActiveRequest, exit_code: 0, out: "active", err: ""),
  ]
}
// A COMPLETE ROSTER IN A CHOSEN STATE.
//
// Every required leg is present, so the transaction admits; the legs that decide the planning-visible
// state carry chosen results and the rest carry the generic fixture output. The unit and linger arms
// are parameters because those are the two states the planning claims actually discriminate on.
// ONE AUTHORITY FOR "REPLACE THESE LEGS, KEEP THE REST". Every shaper below is a choice of which
// legs to author; none of them re-implements the replacement, so a leg cannot end up duplicated in
// one shaper and overridden in another.
fn hermetic_override(
  base: List<SparkServingProbeLegCapture>,
  shaped: List<SparkServingProbeLegCapture>,
) -> List<SparkServingProbeLegCapture>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  concat(
    filter(
      base,
      c => length(
        filter(
          shaped,
          sc => spark_serving_probe_leg_eq(
            a: spark_serving_capture_leg(c: sc),
            b: spark_serving_capture_leg(c: c),
          ),
        ),
      ) == 0,
    ),
    shaped,
  )
}
// ── A CONVERGED HOST, ASSEMBLED FROM PROBE OUTPUT AND NOT FROM ASSERTION ────────────────────────
//
// The claims that need "this host is already in exactly the desired state" cannot say so. They must
// hand the production projectors output a converged host would actually produce, and the required
// model digest is the joint: the manifest names it, the blobs listing carries its file, sha256sum
// reports it, and the blob digest line agrees. Author any one of those differently and the store
// projects Incomplete or Corrupt instead -- which is exactly the discrimination a declared
// ModelStoreComplete would have thrown away.
fn hermetic_required_model_hex() -> NonEmptyStr?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  match spark_serving_desired_admission {
    SparkServingDesiredRefused { cause: _ } => none
    SparkServingDesiredAdmitted { serving_release: r } =>
      match r.model.identity {
        Sha256Hash(d) => Present { value: d.hex as NonEmptyStr }
        Fnv1a64(structural) => none
        Sha1Hash(sha1) => none
        Sha512Hash(sha512) => none
      }
  }
}

fn hermetic_runtime_complete_captures() -> List<SparkServingProbeLegCapture>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  [
    hermetic_leg(request: RuntimeRootRequest, exit_code: 0, out: "runtime-root", err: ""),
    hermetic_leg(request: RuntimeExecutableRequest, exit_code: 0, out: "runtime-exe", err: ""),
    hermetic_leg(request: RuntimeExecutableBitRequest, exit_code: 0, out: "x", err: ""),
    hermetic_leg(
      request: RuntimeReceiptRequest,
      exit_code: 0,
      out: ollama_runtime_materialization_identity_for_required_release().digest as String,
      err: "",
    ),
  ]
}

fn hermetic_store_complete_captures(hex: NonEmptyStr) -> List<SparkServingProbeLegCapture>
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_captures"),
  ] {
  [
    hermetic_leg(
      request: ModelManifestRequest,
      exit_code: 0,
      out: join(["{\"config\":{\"digest\":\"sha256:", hex as String, "\"}}"], ""),
      err: "",
    ),
    hermetic_leg(
      request: ModelBlobsListingRequest,
      exit_code: 0,
      out: join(["sha256-", hex as String], ""),
      err: "",
    ),
    hermetic_leg(
      request: ModelManifestDigestRequest,
      exit_code: 0,
      out: join([hex as String, "  manifest"], ""),
      err: "",
    ),
    hermetic_leg(
      request: ModelBlobDigestsRequest { digests: [hex] },
      exit_code: 0,
      out: join([hex as String, "  /blobs/sha256-", hex as String], ""),
      err: "",
    ),
  ]
}

// Captures for a host converged on everything except the linger member, which varies. Absent means
// the required release itself is unadmitted -- returned rather than swallowed so a broken fixture
// reddens its claims instead of quietly turning them into refusal tests.
fn hermetic_converged_captures(
  linger: SparkServingObservedLingerState,
) -> List<SparkServingProbeLegCapture>?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_serving_hermetic_acquisition_fixture", decl_name: "hermetic_converged_observation"),
  ] {
  match hermetic_required_model_hex() {
    Absent => none
    Present { value: hex } =>
      Present {
        value: hermetic_override(
          base: hermetic_complete_captures(),
          shaped: concat(
            concat(hermetic_unit_captures(), hermetic_runtime_complete_captures()),
            concat(
              hermetic_store_complete_captures(hex: hex),
              [hermetic_linger_state_capture(linger: linger)],
            ),
          ),
        ),
      }
  }
}

fn hermetic_converged_observation(
  host: HostIdentity,
  linger: SparkServingObservedLingerState,
) -> SparkServingHostObservation?
  admit_callers: [
    decl_ref(module_path: "test.claim.spark.spark_cell_role_retirement_witness_test", decl_name: "w_artifact"),
    decl_ref(module_path: "test.claim.spark_serving_converge_slice_witness", decl_name: "slice_artifact"),
    decl_ref(module_path: "test.claim.spark_serving_full_plan_witness_test", decl_name: "c3_observation_at"),
  ] {
  match hermetic_converged_captures(linger: linger) {
    Absent => none
    Present { value: cs } =>
      hermetic_acquired_observation(host: host, phase: SparkServingPlanObservation, captures: cs)
  }
}
