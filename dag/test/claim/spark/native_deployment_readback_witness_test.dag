data subject: NonEmptyStr = "the native four-rank deployment on fabric cage 2" as NonEmptyStr
// THIS IS THE STOCK RUNTIME, AND IT IS NOW THE WRONG-IMAGE VALUE RATHER THAN THE FAITHFUL ONE. Every
// fixture below used to report it as the image a healthy rank is running, while the plan pins the runtime
// this fleet derived -- so each of them silently varied the image DIMENSION as well as the one its name
// claims, and a test asserting exactly one deviation was asserting it about two. A rank that pulled the
// stock image instead of the derived one is the realistic failure this value now discriminates.
data pinned_digest: NonEmptyStr = "vllm/vllm-openai@sha256:819ec9c063412e5730d1b0e82046ba540d1bf991f3c4f661a849aae8a0c52374" as NonEmptyStr
data pinned_model_path: NonEmptyStr = "/weights/models--zai-org--GLM-5.3-Flash/snapshots/eb9eb208eb0d988989d07a6a12d0fdeb5f52574a" as NonEmptyStr

// THE FIXTURE RESOLUTION IS 8400 BASIS POINTS, WHICH IS WHAT THE POLICY RESOLVED TO ON 2026-09-10 AGAINST
// THE READINGS THAT REFUSED THE 0.90 LAUNCH. It is written here as a fixture and not as a recommendation:
// this witness is about argv comparison, and the fraction matters only in that the plan cannot exist without
// one.
data readback_fixture_envelope: ResolvedDeviceMemoryEnvelope = ResolvedForAttempt {
  basis_points: 8400,
  binding_node_rank: 1,
  policy: glm_native_device_memory_policy,
  attempt: "readback-witness-fixture" as NonEmptyStr,
  standings: [],
}

fn plan() -> ArmLaunchPlan {
  glm_native_tp4_launch_plan(envelope: readback_fixture_envelope)
}

// A FAITHFUL OBSERVATION MUST BE SHAPED LIKE ONE THE OBSERVER COULD ACTUALLY RETURN. This read `l.argv`,
// the whole "docker run ..." line, and handed it to the assessor as the words a running container reports.
// No container reports those words -- the daemon consumed them at creation -- so the fixture agreed with the
// plan about a list the production reader never produces, and the positive control stayed green across every
// revision in which the real comparison could not pass. The engine argv is the half that survives creation.
fn planned_argv_for(rank: Nat) -> List<String> {
  match plan() {
    ArmLaunchRefused { cause: _ } => []
    ArmLaunchPlanned { lines: ls, master: _ } =>
      join_argv(items: map(filter(ls, l => l.node.node_rank == rank), l => l.engine_argv))
  }
}

// AND THE IMAGE A FAITHFUL RANK REPORTS IS THE ONE THE PLAN PINNED, not a literal transcribed beside it.
// `pinned_digest` still spells the STOCK reference while this plan pins the runtime this fleet derived, so
// a positive control built on the literal asserts agreement with an image the arm does not launch. It stays
// below as the DIVERGENT value, which is the only role a second image reference should play here.
fn planned_image_for(rank: Nat) -> NonEmptyStr {
  match plan() {
    ArmLaunchRefused { cause: _ } => pinned_digest
    ArmLaunchPlanned { lines: ls, master: _ } =>
      match filter(ls, l => l.node.node_rank == rank).first() {
        Absent => pinned_digest
        Present { value: l } => l.image_reference
      }
  }
}

fn join_argv(items: List<List<String>>) -> List<String> {
  fold(items, init: [] as List<String>, f: (acc, x) => concat(acc, x))
}

// A FAITHFUL READING OF ONE RANK: the words the plan rendered for that rank, the pinned digest, the
// pinned revision path, the host the plan named, and the interface the engine reported selecting.
fn faithful_rank(host: HostIdentity, rank: Nat) -> RankObservation {
  rank_observation(
    host: host,
    node_rank: rank,
    image_digest: planned_image_for(rank: rank),
    model_path: pinned_model_path,
    argv: planned_argv_for(rank: rank),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  )
}

data all_four_faithful: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

fn acceptance_of(reading: NativeDeploymentObserved) -> DeploymentAcceptance {
  accept_deployment(inspection: inspect_native_deployment(subject: subject, plan: plan(), reading: reading))
}

fn served() -> NonEmptyStr? {
  Present { value: "glm-5.3-flash" as NonEmptyStr }
}

// ── THE POSITIVE CONTROL ──────────────────────────────────────────────────────────────────────
//
// FOUR RANKS AGREEING WITH THE PLAN THAT LAUNCHED THEM IS ACCEPTED, and this row exists so that every
// rejection below is a discrimination rather than a gate that refuses everything. If the plan itself
// refuses -- which it does whenever the runtime standing does not admit the arm -- this row goes red,
// which is the correct coupling: there is nothing to accept when nothing was planned.
test fn four_faithful_ranks_are_accepted() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: all_four_faithful, endpoint_alias: served() }) {
    DeploymentAccepted { receipt: r } => r.ranks_agreed == 4
    DeploymentRejected { deviations: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
  }
}

// ── THE ROW THIS MODULE EXISTS FOR ────────────────────────────────────────────────────────────
//
// ONE RANK ON A DIFFERENT IMAGE IS REJECTED, AND THE COARSE ARM IDENTITY CANNOT SEE IT. That identity
// reads the served alias, the quantisation word and the rank count off the running line -- all three of
// which are unchanged here. A group where three ranks run the audited digest and one runs something else
// would report as the right arm serving, and this is the check that says otherwise.
data one_rank_wrong_digest: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  faithful_rank(host: operator_host_srv10, rank: 1),
  rank_observation(
    host: operator_host_srv12,
    node_rank: 2,
    image_digest: pinned_digest,
    model_path: pinned_model_path,
    argv: planned_argv_for(rank: 2),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn one_rank_on_a_different_image_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: one_rank_wrong_digest, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// A RANK ON A DIFFERENT CHECKPOINT REVISION IS REJECTED. Two revisions of one repository produce the same
// alias and the same quantisation, so this is the second thing the coarse identity cannot distinguish --
// and it is the difference between serving the audited weights and serving whatever else is on disk.
data one_rank_wrong_revision: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  rank_observation(
    host: operator_host_srv10,
    node_rank: 1,
    image_digest: planned_image_for(rank: 1),
    model_path: "/weights/models--zai-org--GLM-5.3-Flash/snapshots/0000000000000000000000000000000000000000" as NonEmptyStr,
    argv: planned_argv_for(rank: 1),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn one_rank_on_a_different_revision_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: one_rank_wrong_revision, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// A MISSING RANK IS REJECTED AND NAMED. Three ranks of a four-rank arm is not a smaller deployment: the
// engine waits for a peer nobody started, and an acceptance that counted only what answered would report
// a hung group as a healthy one.
data only_three_ranks: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
]

test fn a_missing_rank_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: only_three_ranks, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// ── AN UNREAD FACT IS NOT A PASS ──────────────────────────────────────────────────────────────
//
// THE INTERFACE NCCL ACTUALLY CHOSE IS THE ONE FACT THIS WHOLE ARRANGEMENT CANNOT INFER, because the
// launch is what SET the environment variable -- so reading the variable back and calling it agreement
// would be the check agreeing with itself. A group whose interface was never captured is UNVERIFIED, and
// a transaction that completed on it would record a claim nobody checked. This is the row that keeps
// "we did not look" distinct from "we looked and it was right".
data interface_unread: List<RankObservation> = [
  rank_observation(
    host: operator_host_srv9, node_rank: 0,
    image_digest: planned_image_for(rank: 0), model_path: pinned_model_path,
    argv: planned_argv_for(rank: 0), selected_fabric_interface: none,
  ),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn an_unread_fabric_interface_is_unverified_rather_than_accepted() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: interface_unread, endpoint_alias: served() }) {
    DeploymentUnverified { unknowns: us } => count(us) == 1
    _ => false
  }
}

// AND AN INTERFACE THAT WAS READ AND IS WRONG IS REJECTED, not merely noted. Collectives on the
// management link serve correctly and slowly, with nothing in any log calling it a fault, so the only
// place that difference can be caught is a readback that knows which interface was intended.
data interface_wrong: List<RankObservation> = [
  rank_observation(
    host: operator_host_srv9, node_rank: 0,
    image_digest: planned_image_for(rank: 0), model_path: pinned_model_path,
    argv: planned_argv_for(rank: 0),
    selected_fabric_interface: Present { value: "wlan0" as NonEmptyStr },
  ),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn a_wrong_fabric_interface_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: interface_wrong, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// NOTHING RUNNING IS REJECTED RATHER THAN UNVERIFIED, because an established absence is a fact the reader
// SAW. It is the arm not being deployed, which is a divergence from the goal and not a gap in knowledge.
test fn nothing_running_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentNothingRunning { detail: "no container on any rank" as NonEmptyStr }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// A RANK ON THE WRONG HOST IS REJECTED. The rank-to-host assignment is what the rendezvous is built from,
// so two ranks on one host and none on another is a group that cannot form even when the count is right.
data rank_on_wrong_host: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  faithful_rank(host: operator_host_srv9, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn a_rank_on_the_wrong_host_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: rank_on_wrong_host, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    _ => false
  }
}

// ── SAME LENGTH, DIFFERENT MEANING: THE TWO REDS A WORD COUNT CANNOT SEE ───────────────────────
//
// A COUNT-BASED COMPARISON ACCEPTS BOTH POPULATIONS BELOW, and both describe an engine nobody asked for.
// The readback compares exact ordered argv, so these are the rows that say so rather than leaving it to be
// read off the implementation.
//
// THE FIRST CHANGES ONE WORD -- the memory fraction -- which is precisely the parameter this repository
// spent five attempts learning to get right. A deployment serving at a fraction nobody decided is not the
// deployment that was planned, and it is the most likely single-word divergence this arm has.
//
// THE SWAP IS BY VALUE RATHER THAN BY POSITION, because naming an index would couple this fixture to where
// the flag happens to sit in the rendered line -- the positional dependence the exact comparison exists to
// avoid.
fn swap_word(words: List<String>, target: String, replacement: String) -> List<String> {
  map(words, w => if w == target { replacement } else { w })
}

fn argv_with_one_word_changed(rank: Nat) -> List<String> {
  swap_word(words: planned_argv_for(rank: rank), target: "0.84", replacement: "0.90")
}

data one_word_changed_ranks: List<RankObservation> = [
  rank_observation(
    host: operator_host_srv9, node_rank: 0, image_digest: planned_image_for(rank: 0), model_path: pinned_model_path,
    argv: argv_with_one_word_changed(rank: 0),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn one_changed_word_at_the_same_length_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: one_word_changed_ranks, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    DeploymentAccepted { receipt: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
  }
}

// THE SECOND REORDERS THE LINE WITHOUT CHANGING ANY WORD. The count is identical and so is the multiset;
// only the ORDER differs. vLLM's argv is order-sensitive -- the positional model path and every flag/value
// pairing depend on it -- so a reordered line is a different command, and an unordered comparison would call
// it the same one.
fn argv_reversed(rank: Nat) -> List<String> {
  reverse(planned_argv_for(rank: rank))
}

data reordered_ranks: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  rank_observation(
    host: operator_host_srv10, node_rank: 1, image_digest: planned_image_for(rank: 1), model_path: pinned_model_path,
    argv: argv_reversed(rank: 1),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

test fn a_reordered_argv_of_the_same_words_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: reordered_ranks, endpoint_alias: served() }) {
    DeploymentRejected { deviations: ds } => count(ds) == 1
    DeploymentAccepted { receipt: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
  }
}

// AND THE POSITIVE CONTROL THE TWO REDS REQUIRE: the faithful population is ACCEPTED. Without it a readback
// that rejected everything would satisfy both rows above and establish nothing.
test fn the_faithful_population_is_accepted() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: all_four_faithful, endpoint_alias: served() }) {
    DeploymentAccepted { receipt: _ } => true
    DeploymentRejected { deviations: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
  }
}


// ── A POPULATION THAT IS NOT A BIJECTION IS NOT AN AGREEMENT ──────────────────────────────────
//
// EVERY PLANNED RANK FINDING AT LEAST ONE AGREEABLE ROW IS NOT THE DEPLOYMENT AGREEING, and these two
// rows are the inputs that used to pass. observation_for_rank takes the FIRST row for a rank and the
// assessment iterates the PLANNED lines, so a rank observed twice was reduced to whichever row came
// first, and a rank running that the plan never named was examined by nothing at all. The receipt's
// ranks_agreed is derived from the planned count, so it reported full agreement over a population
// that was neither complete nor exclusive.
data rank_zero_twice: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  rank_observation(
    host: operator_host_srv9,
    node_rank: 0,
    image_digest: pinned_digest,
    model_path: pinned_model_path,
    argv: planned_argv_for(rank: 0),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
]

// THE DUPLICATE ROW AGREES WITH THE PLAN ON EVERY FIELD EXCEPT THE IMAGE, which is what makes this
// discriminating rather than decorative: a check that only counted rows would pass it, and the old
// first-row lookup passed it because the FIRST row for rank zero was the faithful one.
test fn a_rank_observed_twice_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: rank_zero_twice, endpoint_alias: served() }) {
    DeploymentAccepted { receipt: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
    DeploymentRejected { deviations: ds } => count(ds) != 0
  }
}

// AND A PROCESS THE PLAN NEVER NAMED IS A DEVIATION, NOT A SPARE. Four planned ranks all agreeing
// while a fifth serves something else on the same group is the case where a turn would be placed on
// an engine nobody assessed -- and the old fold, which walked only the planned lines, could not see
// it however wrong the extra rank was.
data an_unexpected_fifth_rank: List<RankObservation> = [
  faithful_rank(host: operator_host_srv9, rank: 0),
  faithful_rank(host: operator_host_srv10, rank: 1),
  faithful_rank(host: operator_host_srv12, rank: 2),
  faithful_rank(host: operator_host_srv11, rank: 3),
  rank_observation(
    host: operator_host_srv9,
    node_rank: 4,
    image_digest: pinned_digest,
    model_path: pinned_model_path,
    argv: planned_argv_for(rank: 0),
    selected_fabric_interface: Present { value: fabric_rail_interface_name },
  ),
]

test fn an_unexpected_extra_rank_is_rejected() -> Bool {
  match acceptance_of(reading: DeploymentRanksRead { ranks: an_unexpected_fifth_rank, endpoint_alias: served() }) {
    DeploymentAccepted { receipt: _ } => false
    DeploymentUnverified { unknowns: _ } => false
    DeploymentUnverifiable { cause: _ } => false
    DeploymentRejected { deviations: ds } => count(ds) != 0
  }
}


// ── PROVENANCE IS BOUND TO A LAUNCH, AND THE ACCEPTANCE COMES FROM THE REAL PRODUCER ──────────
//
// THESE LIVE HERE RATHER THAN BESIDE THE GENERIC IDENTITY WITNESSES BECAUSE DeploymentAcceptance IS
// sole_constructor. A fixture cannot mint one, which is the substrate enforcing the property that
// matters: an acceptance must come from accept_deployment over a real plan and a real reading, so
// these rows exercise the authority production uses instead of a shape authored to be convenient.
fn t_source_readings(checkpoint: String) -> ServingSourceResolution {
  resolve_serving_source(
    checkpoint: CoordinateObserved { hash: content_hash_of_value(value: checkpoint as NonEmptyStr) },
    model_config: CoordinateObserved { hash: content_hash_of_value(value: "model-config" as NonEmptyStr) },
    tokenizer: CoordinateObserved { hash: content_hash_of_value(value: "tokenizer" as NonEmptyStr) },
    tokenizer_config: CoordinateObserved { hash: content_hash_of_value(value: "tokenizer-config" as NonEmptyStr) },
    special_tokens: CoordinateAbsentByObservation,
    chat_template: CoordinateObserved { hash: content_hash_of_value(value: "chat-template" as NonEmptyStr) },
    model_side_code: CoordinateAbsentByObservation,
    generation_defaults: CoordinateObserved { hash: content_hash_of_value(value: "generation-defaults" as NonEmptyStr) },
    processor_config: CoordinateObserved { hash: content_hash_of_value(value: "processor-config" as NonEmptyStr) },
    rung: RevisionAddressedUpstreamVerification {
      authority: "probe/repo" as NonEmptyStr,
      revision: "0000000000000000000000000000000000000000" as NonEmptyStr,
    },
  )
}

fn t_runtime_readings() -> ServingRuntimeResolution {
  resolve_serving_runtime(
    runtime_image: CoordinateObserved { hash: content_hash_of_value(value: "runtime-image" as NonEmptyStr) },
    runtime_extensions: CoordinateAbsentByObservation,
    runtime_configuration: CoordinateAbsentByObservation,
  )
}

fn t_launch(group: FabricGroup, endpoint: String, start: String) -> VllmEndpointProcessLaunch {
  vllm_endpoint_process_launch(
    group: group, endpoint: endpoint as NonEmptyStr, process_start_field: start as NonEmptyStr)
}

fn t_bind(launch: VllmEndpointProcessLaunch, reading: NativeDeploymentObserved, checkpoint: String) -> VllmIncarnationOutcome {
  bind_incarnation(
    launch: launch,
    acceptance: acceptance_of(reading: reading),
    ranks_required: 4,
    source: t_source_readings(checkpoint: checkpoint),
    runtime: t_runtime_readings(),
  )
}

fn t_faithful_reading() -> NativeDeploymentObserved {
  DeploymentRanksRead { ranks: all_four_faithful, endpoint_alias: served() }
}

// ── 1. AN ACCEPTED DEPLOYMENT AND A COMPLETE OBSERVATION BIND AN INCARNATION ──────────────────
test fn an_accepted_deployment_binds_an_incarnation() -> Bool {
  match t_bind(launch: t_launch(group: FabricGroupB, endpoint: "e", start: "s"), reading: t_faithful_reading(), checkpoint: "checkpoint-a") {
    IncarnationUnestablished { obligations: _ } => false
    IncarnationBound { provenance: _ } => true
  }
}

// ── 2. A REJECTED DEPLOYMENT BINDS NOTHING, HOWEVER GOOD THE OBSERVATIONS ARE ─────────────────
//
// THE SOURCE AND RUNTIME READINGS HERE ARE THE SAME ONES THE POSITIVE ROW USES, so what changes is
// only the deployment verdict. Without this, a producer that ignored the acceptance entirely would
// still pass row 1.
test fn a_rejected_deployment_binds_no_incarnation() -> Bool {
  match t_bind(launch: t_launch(group: FabricGroupB, endpoint: "e", start: "s"), reading: DeploymentRanksRead { ranks: one_rank_wrong_digest, endpoint_alias: served() }, checkpoint: "checkpoint-a") {
    IncarnationBound { provenance: _ } => false
    IncarnationUnestablished { obligations: os } => count(os) != 0
  }
}

// ── 3. TWO LAUNCHES THAT ONCE SERIALISED ALIKE ARE DISTINCT IN BOTH SENSES ────────────────────
//
// THIS IS THE FIXTURE THAT WOULD HAVE STAYED GREEN AGAINST THE OLD RENDERING. The key used to join
// group, endpoint and process_start_field with "@", so endpoint "a@b" with start "c" and endpoint "a"
// with start "b@c" produced one key and one offer subject. Ordinary fixtures never contain "@", which
// is why such a defect survives a suite that looks thorough. Both halves are asserted: the launches
// are not equal, AND their keys now differ -- because fixing equality alone would leave fabric offer
// identity still collapsing them.
test fn two_launches_that_once_collided_are_distinct_and_key_apart() -> Bool {
  let a = t_launch(group: FabricGroupB, endpoint: "a@b", start: "c")
  let b = t_launch(group: FabricGroupB, endpoint: "a", start: "b@c")
  !vllm_endpoint_process_launch_is(launch: a, other: b)
    && (vllm_endpoint_process_launch_key(launch: a) as String)
         != (vllm_endpoint_process_launch_key(launch: b) as String)
}

// ── 4. PROVENANCE FOR ONE LAUNCH MAY NOT BIND ANOTHER ─────────────────────────────────────────
test fn provenance_for_one_launch_does_not_bind_another() -> Bool {
  let mine = t_launch(group: FabricGroupB, endpoint: "192.168.1.236:30000", start: "start-1")
  let other = t_launch(group: FabricGroupA, endpoint: "192.168.1.226:30000", start: "start-1")
  match t_bind(launch: mine, reading: t_faithful_reading(), checkpoint: "checkpoint-a") {
    IncarnationUnestablished { obligations: _ } => false
    IncarnationBound { provenance: p } =>
      match incarnation_for_launch(candidates: [p], launch: other) {
        IncarnationFound { provenance: _ } => false
        IncarnationAmbiguous { matches: _ } => false
        IncarnationMissing =>
          match incarnation_for_launch(candidates: [p], launch: mine) {
            IncarnationMissing => false
            IncarnationAmbiguous { matches: _ } => false
            IncarnationFound { provenance: _ } => true
          }
      }
  }
}

// ── 5. A RESTART IS A NEW LAUNCH OVER THE SAME EXECUTION ──────────────────────────────────────
//
// THE TWO IDENTITIES MOVE INDEPENDENTLY, which is the whole reason the launch sits beside the
// execution rather than inside the manifests. Identical bytes restarted must not mint a new semantic
// Work, and must mint a new offer.
test fn a_restart_is_a_new_launch_over_the_same_execution() -> Bool {
  let before = t_launch(group: FabricGroupB, endpoint: "192.168.1.236:30000", start: "start-1")
  let after = t_launch(group: FabricGroupB, endpoint: "192.168.1.236:30000", start: "start-2")
  match t_bind(launch: before, reading: t_faithful_reading(), checkpoint: "checkpoint-a") {
    IncarnationUnestablished { obligations: _ } => false
    IncarnationBound { provenance: p1 } =>
      match t_bind(launch: after, reading: t_faithful_reading(), checkpoint: "checkpoint-a") {
        IncarnationUnestablished { obligations: _ } => false
        IncarnationBound { provenance: p2 } =>
          (serving_execution_source_ref(c: p1.execution) as String)
              == (serving_execution_source_ref(c: p2.execution) as String)
            && !incarnation_applies_to(p: p1, launch: after)
      }
  }
}


// ── WORK IDENTITY, BUILT FROM A CLOSURE OBTAINED THE WAY PRODUCTION OBTAINS ONE ────────────────
//
// THESE ROWS LIVE HERE RATHER THAN BESIDE turn_demand BECAUSE THE SEAL IS ADMITTED-ONLY. A
// ServingTurnExecutionClosure can be minted only by the incarnation producer, and that producer needs
// a real DeploymentAcceptance -- so a positive control over Work identity necessarily exercises the
// whole join: acceptance, rank population, source and runtime observation, launch binding. That is a
// stronger control than the one it replaces, which assembled a closure in the fixture.
fn t_request(execution: ServingTurnExecution) -> ServingTurnRequest {
  ServingTurnRequest {
    execution: execution,
    inputs: "probe.inputs" as ArtifactManifestRef,
    effect_contract: "probe.effects" as EffectContractRef,
    output_contract: "probe.outputs" as OutputContractRef,
  }
}

fn t_probe_requirements() -> ExecutionRequirements {
  serving_turn_requirements(
    capacity_class: ControlPlaneCapacity,
    capabilities: "gunbc.capabilities.spark-serving.probe" as CapabilityManifestRef,
    trust_domain: "gunbc.trust.spark-fleet" as TrustDomainRef,
    isolation: IsolationProfile { guarantees: [] },
    shape: Shape { hard: HardRequirements { threads: hardware_thread_count(count: 0) }, envelope: unstated_envelope() },
  )
}

fn t_work_key_for(checkpoint: String) -> String {
  match t_bind(launch: t_launch(group: FabricGroupB, endpoint: "e", start: "s"), reading: t_faithful_reading(), checkpoint: checkpoint) {
    IncarnationUnestablished { obligations: _ } => "unbound"
    IncarnationBound { provenance: p } =>
      match serving_turn_work(
        principal: "gunbc" as NonEmptyStr,
        request: t_request(execution: TurnExecutionBound { closure: p.execution }),
        requirements: t_probe_requirements(),
      ) {
        TurnWorkUnestablished { obligation: _ } => "unestablished"
        TurnWorkBound { work: w } => w.id.key as String
      }
  }
}

test fn an_observed_incarnation_mints_work_through_the_fabric_constructor() -> Bool {
  t_work_key_for(checkpoint: "checkpoint-a") != "unbound"
    && t_work_key_for(checkpoint: "checkpoint-a") != "unestablished"
}

// TWO SOURCES ARE TWO WORKS, and the identity is derived from the contract rather than decided here.
test fn two_incarnation_sources_are_two_works() -> Bool {
  t_work_key_for(checkpoint: "checkpoint-a") != t_work_key_for(checkpoint: "checkpoint-b")
}
