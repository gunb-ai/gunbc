// ── FIXTURE ROSTERS ───────────────────────────────────────────────────────────────────────────
//
// The rosters are fixtures rather than the production ones for the reason gunbc.spark.cell_role gives
// for its own roster-parameterised lookup: a capability's evidence must not depend on which machines
// currently hold what. The reservation arm in particular commits nobody in production today -- the
// one minted reservation was cleared by a release receipt on 2026-09-05 -- so asserting it against
// production data would be a wall reporting that nothing collides because nothing is reserved.
data fixture_units: List<HostIdentity> = [operator_host_srv7, operator_host_srv8, operator_host_srv9]

data fixture_assignments: List<SparkCellRoleAssignment> = [
  SparkCellRoleAssignment { host: operator_host_srv9, role: SparkTrainingCell },
]

data fixture_duplicate_assignments: List<SparkCellRoleAssignment> = [
  SparkCellRoleAssignment { host: operator_host_srv9, role: SparkServingCell },
  SparkCellRoleAssignment { host: operator_host_srv9, role: SparkTrainingCell },
]

fn member(group: FabricGroup, host: HostIdentity) -> ClaimedServingGroupMember {
  ClaimedServingGroupMember { group: group, host: host }
}

fn fixture_standings(held: List<HostIdentity>, arms: List<ServingArmHostClaim>) -> List<SparkHostStanding> {
  spark_host_standings_in(
    units: fixture_units,
    assignments: fixture_assignments,
    claimed_group_members: [],
    arm_claims: arms,
    held_reservation_hosts: held,
    serving_reservations: [],
  )
}

fn fixture_unplaced(held: List<HostIdentity>) -> List<HostIdentity> {
  spark_unplaced_hosts_of(standings: fixture_standings(held: held, arms: []))
}

// The per-host lookup is roster-bounded now, so every fixture call names the unit population it asks
// within; an Absent answer means the host is outside that universe rather than uncommitted in it.
fn fixture_standing(assignments: List<SparkCellRoleAssignment>, claimed: List<ClaimedServingGroupMember>, arms: List<ServingArmHostClaim>, held: List<HostIdentity>, host: HostIdentity) -> SparkHostStanding? {
  spark_host_standing_in(
    units: fixture_units,
    assignments: assignments,
    claimed_group_members: claimed,
    arm_claims: arms,
    held_reservation_hosts: held,
    serving_reservations: [],
    host: host,
  )
}

fn contains_host(hosts: List<HostIdentity>, host: HostIdentity) -> Bool {
  any(hosts, h => host_identity_eq(a: h, b: host))
}

fn is_cell_role(c: SparkHostCommitment) -> Bool {
  match c {
    AuthorityHeldCommitment { cause: o } =>
      match o {
        CommittedToCellRole { role: _ } => true
        MemberOfClaimedServingGroup { group: _ } => false
        OccupiedByServingArm { claim: _ } => false
        HoldsUndischargedRpcReservation => false
        CellRoleUndecidable { assignments: _ } => false
      }
    RulingDerivedCommitment { cause: _ } => false
  }
}

fn is_group_member(c: SparkHostCommitment) -> Bool {
  match c {
    AuthorityHeldCommitment { cause: o } =>
      match o {
        MemberOfClaimedServingGroup { group: _ } => true
        CommittedToCellRole { role: _ } => false
        OccupiedByServingArm { claim: _ } => false
        HoldsUndischargedRpcReservation => false
        CellRoleUndecidable { assignments: _ } => false
      }
    RulingDerivedCommitment { cause: _ } => false
  }
}

fn is_held_reservation(c: SparkHostCommitment) -> Bool {
  match c {
    AuthorityHeldCommitment { cause: o } =>
      match o {
        HoldsUndischargedRpcReservation => true
        MemberOfClaimedServingGroup { group: _ } => false
        CommittedToCellRole { role: _ } => false
        OccupiedByServingArm { claim: _ } => false
        CellRoleUndecidable { assignments: _ } => false
      }
    RulingDerivedCommitment { cause: _ } => false
  }
}

fn is_ruling_reservation_for(c: SparkHostCommitment, subject: ServingSubject) -> Bool {
  match c {
    AuthorityHeldCommitment { cause: _ } => false
    RulingDerivedCommitment { cause: d } =>
      match d {
        ReservedForServingSubject { subject: s, basis: _ } => serving_subject_eq(a: s, b: subject)
      }
  }
}

// ── RED 1: A HOST HOLDING AN UNDISCHARGED RESERVATION IS NEVER IN THE SET ─────────────────────
//
// This is the arm the scalar could not express at all. Under a roster of three units where srv7 holds
// an undischarged internal-participant reservation, the set is srv8 alone -- srv7 because it is held,
// srv9 because it is committed to a role -- and membership is asserted BY IDENTITY in both directions
// rather than by a length, because a count of one would be satisfied by any one host.
test fn a_host_holding_an_undischarged_reservation_is_never_unplaced() -> Bool {
  let unplaced = fixture_unplaced(held: [operator_host_srv7])
  !contains_host(hosts: unplaced, host: operator_host_srv7)
    && contains_host(hosts: unplaced, host: operator_host_srv8)
    && !contains_host(hosts: unplaced, host: operator_host_srv9)
    && length(unplaced) == 1
}

// A COMMITTED HOST CARRIES EVERY CAUSE THAT COMMITS IT. srv9 is committed to a role, claimed by a
// serving group and held by a reservation at once; dropping any of them would make a later release
// receipt look like it freed a host it did not free.
test fn a_committed_host_carries_every_cause_that_commits_it() -> Bool {
  match fixture_standing(assignments: fixture_assignments, claimed: [member(group: FabricGroupB, host: operator_host_srv9)], arms: [], held: [operator_host_srv9], host: operator_host_srv9) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: h, commitments: c } } =>
      host_identity_eq(a: h, b: operator_host_srv9)
        && is_cell_role(c: c.head)
        && (match c.tail {
             Empty => false
             Cons { head: second, tail: rest } =>
               is_group_member(c: second)
                 && (match rest {
                      Empty => false
                      Cons { head: third, tail: _ } => is_held_reservation(c: third)
                    })
           })
  }
}

// ── RED 2: A RELEASE RECEIPT WIDENS THE SET, WITH NO EDIT TO ANY CONSUMER ─────────────────────
//
// A release receipt's whole effect on this join is that its host leaves
// `llama_cpp_rpc_undischarged_peer_reservation_hosts()`; the receipt-to-undischarged fold is
// gunbc.spark.llama_cpp_rpc_observed's own, and its evidence is in
// test.claim.spark.spark_llama_cpp_rpc_witness. What is asserted here is the PROPAGATION: the same
// units and the same assignments, with the hold discharged, admit srv7 and admit strictly more --
// for the placement question here, and for a serving subject's admissible set below.
test fn discharging_a_reservation_widens_the_unplaced_set() -> Bool {
  let held = fixture_unplaced(held: [operator_host_srv7])
  let released = fixture_unplaced(held: [])
  !contains_host(hosts: held, host: operator_host_srv7)
    && contains_host(hosts: released, host: operator_host_srv7)
    && contains_host(hosts: released, host: operator_host_srv8)
    && length(released) == length(held) + 1
}

// ── RED 3: AN UNDECIDABLE ROLE IS NOT FREEDOM ─────────────────────────────────────────────────
//
// Two roster rows naming one host make the commitment unreadable. A lookup that cannot say what a
// host is committed to has not said the host is uncommitted, and the committed arm names that cause
// rather than folding it into either role.
test fn a_host_with_an_ambiguous_role_is_committed_rather_than_free() -> Bool {
  match fixture_standing(assignments: fixture_duplicate_assignments, claimed: [], arms: [], held: [], host: operator_host_srv9) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: _, commitments: c } } =>
      match c.head {
        AuthorityHeldCommitment { cause: o } =>
          match o {
            CellRoleUndecidable { assignments: rows } => length(rows) == 2
            CommittedToCellRole { role: _ } => false
            MemberOfClaimedServingGroup { group: _ } => false
            OccupiedByServingArm { claim: _ } => false
            HoldsUndischargedRpcReservation => false
          }
        RulingDerivedCommitment { cause: _ } => false
      }
  }
}

// ── THE POSITIVE CONTROL: THE WALLS ADMIT SOMETHING ───────────────────────────────────────────
//
// Without this every refusal above would be satisfied by a fold that refuses everything.
test fn an_unclaimed_unheld_unassigned_host_is_uncommitted() -> Bool {
  match fixture_standing(assignments: fixture_assignments, claimed: [], arms: [], held: [], host: operator_host_srv8) {
    Absent => false
    Present { value: SparkHostUncommitted { host: h } } => host_identity_eq(a: h, b: operator_host_srv8)
    Present { value: SparkHostCommitted { host: _, commitments: _ } } => false
  }
}

// EVERY CAUSE RENDERS TO ITS OWN SENTENCE, so a refusal quoting one cannot be read as another -- and
// the ruling-derived cause renders its decider and date, so a policy can never be quoted as a
// standing something holds on the host.
test fn each_commitment_cause_renders_distinctly() -> Bool {
  let role = spark_host_commitment_wire(c: AuthorityHeldCommitment { cause: CommittedToCellRole { role: SparkServingCell } }) as String
  let group = spark_host_commitment_wire(c: AuthorityHeldCommitment { cause: MemberOfClaimedServingGroup { group: FabricGroupA } }) as String
  let held = spark_host_commitment_wire(c: AuthorityHeldCommitment { cause: HoldsUndischargedRpcReservation }) as String
  let ambiguous = spark_host_commitment_wire(c: AuthorityHeldCommitment { cause: CellRoleUndecidable { assignments: fixture_duplicate_assignments } }) as String
  let armed = spark_host_commitment_wire(c: AuthorityHeldCommitment { cause: OccupiedByServingArm { claim: glm_canary_host_claim } }) as String
  let ruled = spark_host_commitment_wire(c: RulingDerivedCommitment { cause: ReservedForServingSubject { subject: glm_canary_serving_subject, basis: glm_group_b_serving_reservation.basis } }) as String
  role != group && role != held && role != ambiguous && role != armed && role != ruled
    && group != held && group != ambiguous && group != armed && group != ruled
    && held != ambiguous && held != armed && held != ruled
    && ambiguous != armed && ambiguous != ruled
    && armed != ruled
    && string_contains(s: armed, pattern: "glm_canary_arm")
    && string_contains(s: group, pattern: "group-a")
    && string_contains(s: ruled, pattern: "reserved by ruling")
    && string_contains(s: ruled, pattern: "2026-09-12")
    && string_contains(s: ruled, pattern: "operator")
}

// THE COMPLETE THREE-CAUSE RENDERING, BOTH SEPARATORS INCLUDED, AGAINST A WRITTEN EXPECTATION.
//
// WHAT THE FIRST CUT OF THIS CLAIM ACTUALLY ESTABLISHED, which is less than its name promised: it
// required the three cause fragments and AT LEAST ONE "; ". Three causes need TWO separators, so a
// render that dropped the second one -- "...cell role; ...claimsholding an undischarged..." -- carried
// every fragment, carried a separator, and passed. It discriminated against dropping the whole tail
// and against omitting every separator, which is why it was worth having, and it did not establish
// the property it is named for.
//
// SO THE EXPECTATION IS WRITTEN OUT, not recomputed. The expected text is a literal for this
// controlled fixture; deriving it through the same map-and-join composition under test would compare
// the renderer to itself, which is the oracle defect DESIGN section 5 names -- a measurement taken
// from the subject is not an oracle for the subject.
data expected_three_cause_rendering: String = "committed to a Spark cell role; a member of a serving group this repository claims (group-b); holding an undischarged llama.cpp RPC peer reservation"

test fn a_multi_cause_host_renders_every_cause_with_both_separators() -> Bool {
  match spark_host_standing_in(
    units: fixture_units,
    assignments: fixture_assignments,
    claimed_group_members: [member(group: FabricGroupB, host: operator_host_srv9)],
    arm_claims: [],
    held_reservation_hosts: [operator_host_srv9],
    serving_reservations: [],
    host: operator_host_srv9,
  ) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: _, commitments: c } } =>
      (spark_commitment_causes_text(c: c) as String) == expected_three_cause_rendering
  }
}

// ── RED 6: THE PER-HOST STANDING PRODUCER REFUSES A HOST OUTSIDE ITS ROSTER ──────────────────
//
// THE CONTROL HAS TO REACH THIS BOUNDARY, not only the admission seam above it. The shape this
// replaces answered `SparkHostUncommitted` for ANY host absent from the four commitment lists --
// including one that is not a DGX Spark unit at all -- which reads as "the fleet looked and nothing
// has claimed it" when the fleet had not looked. The admission seam having its own roster check did
// not close that, because this producer was reachable on its own and produced the same value type.
// Absent is now the answer for anything outside the named universe, and a member still resolves,
// which is the positive half without which this red is satisfied by a function that refuses
// everything.
test fn the_per_host_producer_refuses_a_host_outside_the_named_unit_population() -> Bool {
  (match fixture_standing(assignments: [], claimed: [], arms: [], held: [], host: operator_host_srv2) {
     Absent => true
     Present { value: _ } => false
   })
    && (match fixture_standing(assignments: [], claimed: [], arms: [], held: [], host: operator_host_srv5) {
         Absent => true
         Present { value: _ } => false
       })
    && (match fixture_standing(assignments: [], claimed: [], arms: [], held: [], host: operator_host_srv8) {
         Absent => false
         Present { value: SparkHostUncommitted { host: h } } => host_identity_eq(a: h, b: operator_host_srv8)
         Present { value: SparkHostCommitted { host: _, commitments: _ } } => false
       })
}

// ── THE PRODUCTION SETS, ASSERTED BY IDENTITY ────────────────────────────────────────────────
//
// srv5 and srv6 are committed cells, all four of srv5-srv8 are the hosts of the one serving group
// this repository claims (cage 1 of gunbc.spark.fabric_switch_observed), srv9 carries the GLM
// canary's placement claim, and srv9-srv12 are reserved for the canary's subject by the operator's
// 2026-09-12 ruling. So the UNPLACED set -- no authority holds a standing on the host -- is
// srv10-srv12, and the
// UNCOMMITTED set -- no cause of any kind -- is empty. Both are asserted BY IDENTITY, never by a count:
// a set of the right SIZE holding the wrong hosts is exactly the failure the scalar this replaces
// could not detect, and an empty set is an absorbing value that has to be shown host by host rather
// than assumed. A host outside the Spark unit population is not in either set -- absence from the
// universe is not membership.
//
// AND THE COUNT THAT USED TO SIT AT THE END OF THIS CLAIM IS DELETED (claude review 64144 on #11107).
// `length(spark_uncommitted_hosts) == 4` compared a LIVE repository population, derived from several
// authorities, to a number read off the tree it was measuring -- which DESIGN section 5 forbids in
// exactly these words: completeness is an identity join, not a count equality, and a measurement
// copied from the same current tree is not an oracle. It added no content the join already carries,
// and it would have gone red the next time a role is assigned or a group withdrawn -- the very edit
// this derivation exists to absorb without anyone touching this file.
//
// THE SAME RULING REACHED THE RESERVATION ARM (claude review 65522 on #11107). A conjunct asserting
// that the live undischarged-reservation set has length ZERO was defended here as "emptiness stated
// as such"; it is not -- emptiness of a live derived set is a population measurement too, and it
// would go red when a reservation is legitimately minted. What stays is the partition claim below, a
// structural identity between two derived sets and their universe.
test fn the_production_unplaced_set_is_the_reserved_but_idle_cage_by_identity() -> Bool {
  contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv10)
    && contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv11)
    && contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv12)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv5)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv6)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv7)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv8)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv9)
    && !contains_host(hosts: spark_unplaced_hosts, host: operator_host_srv2)
    && !spark_host_is_unplaced(host: operator_host_srv5)
    && spark_host_is_unplaced(host: operator_host_srv10)
}

fn production_standing_is_committed(host: HostIdentity) -> Bool {
  match spark_host_standing(host: host) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: _, commitments: _ } } => true
  }
}

// THE EMPTYING, SHOWN HOST BY HOST. With group B reserved for the GLM subject, every unit carries a
// cause, so no unit is `SparkHostUncommitted`. This is the consequence the reservation row was
// expected to have and it is asserted rather than assumed, because an empty set would satisfy every
// "not in the set" claim above without saying anything.
test fn every_production_unit_is_committed_so_the_uncommitted_set_is_empty_by_identity() -> Bool {
  all(dgx_spark_reserved_identities(), h => production_standing_is_committed(host: h))
    && production_standing_is_committed(host: operator_host_srv10)
    && production_standing_is_committed(host: operator_host_srv12)
}

// ── RED 4: THE HOST A SERVING ARM IS PLACED ON IS NOT FREE ────────────────────────────────────
//
// THIS IS THE RED FOR A FAIL-OPEN THIS MODULE SHIPPED WITH. The first cut of the census read cell
// roles, claimed pair-serving groups and held llama.cpp reservations, and answered srv9 -- where the
// GLM canary is serving -- as uncommitted, while two consumers stood ready to start an hour-long
// build or pull a 9.6 GB image onto whatever host they were handed. The claim is now a cause, and
// this asserts it BY IDENTITY against the production placement roster rather than by a count.
test fn the_canary_host_is_committed_and_its_cause_names_the_arm() -> Bool {
  host_identity_eq(a: glm_canary_host_claim.host, b: operator_host_srv9)
    && !spark_host_is_unplaced(host: operator_host_srv9)
    && (match spark_host_standing(host: operator_host_srv9) {
         Absent => false
         Present { value: standing } =>
           match standing {
             SparkHostUncommitted { host: _ } => false
             SparkHostCommitted { host: _, commitments: c } =>
               any(spark_authority_held_causes_of(c: c), o => match o {
                 OccupiedByServingArm { claim: claimed } =>
                   host_identity_eq(a: claimed.host, b: operator_host_srv9)
                     && string_contains(s: declaration_ref_display_key(ref: claimed.arm), pattern: "glm_canary_arm")
                 CommittedToCellRole { role: _ } => false
                 MemberOfClaimedServingGroup { group: _ } => false
                 HoldsUndischargedRpcReservation => false
                 CellRoleUndecidable { assignments: _ } => false
               })
           }
       })
}

// A FIXTURE ARM CLAIM COMMITS ITS HOST AND NOTHING ELSE, so the cause is the claim rather than the
// identity srv9, and it would still hold if the canary moved.
test fn an_arm_claim_commits_only_the_host_it_names() -> Bool {
  let claims = [ServingArmHostClaim {
    arm: decl_ref(module_path: "test.claim.spark.spark_host_commitment_witness", decl_name: "an_arm_claim_commits_only_the_host_it_names"),
    host: operator_host_srv8,
    basis: "fixture" as NonEmptyStr,
  }]
  let unplaced = spark_unplaced_hosts_of(standings: fixture_standings(held: [], arms: claims))
  !contains_host(hosts: unplaced, host: operator_host_srv8)
    && contains_host(hosts: unplaced, host: operator_host_srv7)
}

// ── RED 5: THE ONE ADMISSION SEAM REFUSES A CLAIMED HOST, AND SAYS WHY ────────────────────────
//
// The three effectful roots -- the source build, the image build entry and the published-image probe
// -- all reach a host through `admit_unplaced_host_live` (the resting projection here supplies the same standings shape). This is the control that the seam refuses a
// claimed target and that its refusal names the actual cause rather than a generic sentence, which is
// what the deleted hand-maintained producer list could never do. And the positive arm is the
// scoping: srv10 is reserved for the GLM subject by ruling and is still admitted for a build,
// because a ruling-derived serving reservation is not a placement.
test fn the_admission_seam_refuses_a_claimed_host_naming_its_cause() -> Bool {
  (match admit_unplaced_host_resting(raw: "srv9", purpose: "a fixture effect" as NonEmptyStr) {
     SparkHostRefused { cause: why } =>
       string_contains(s: why as String, pattern: "srv9")
         && string_contains(s: why as String, pattern: "serving arm")
         && string_contains(s: why as String, pattern: "not a held claim")
     SparkHostAdmitted { host: _ } => false
   })
    && (match admit_unplaced_host_resting(raw: "srv5", purpose: "a fixture effect" as NonEmptyStr) {
         SparkHostRefused { cause: why } => string_contains(s: why as String, pattern: "cell role")
         SparkHostAdmitted { host: _ } => false
       })
    && (match admit_unplaced_host_resting(raw: "", purpose: "a fixture effect" as NonEmptyStr) {
         SparkHostRefused { cause: why } => string_contains(s: why as String, pattern: "does not pick")
         SparkHostAdmitted { host: _ } => false
       })
    && (match admit_unplaced_host_resting(raw: "srv10", purpose: "a fixture effect" as NonEmptyStr) {
         SparkHostAdmitted { host: h } => host_identity_eq(a: h, b: operator_host_srv10)
         SparkHostRefused { cause: _ } => false
       })
}

// AN UNROSTERED HOST IS NOT ADMITTED EITHER, and its refusal says it is not a Spark unit rather than
// inventing a commitment for it.
test fn a_host_outside_the_unit_population_is_refused_as_unrostered() -> Bool {
  match admit_unplaced_host_resting(raw: "srv2", purpose: "a fixture effect" as NonEmptyStr) {
    SparkHostRefused { cause: why } => string_contains(s: why as String, pattern: "not a DGX Spark unit")
    SparkHostAdmitted { host: _ } => false
  }
}

// THE SERVING GROUP IS WHERE THE COMMITMENT OF srv7 AND srv8 ACTUALLY COMES FROM, and that is worth
// asserting on its own: they carry no cell role and no undischarged reservation, so a derivation that
// consulted only those two authorities would call them free while they sit in the one cage this
// repository claims for serving. (An earlier wording called that cage "the deployed four-rank-by-two
// shape", which is a candidate label meaning two four-rank replicas across eight hosts; cage 1 is
// four hosts, and what exactly runs on it is not established by this module.)
test fn srv7_and_srv8_are_committed_by_the_claimed_serving_group_and_by_nothing_else() -> Bool {
  contains_host(hosts: spark_claimed_serving_group_hosts(), host: operator_host_srv7)
    && contains_host(hosts: spark_claimed_serving_group_hosts(), host: operator_host_srv8)
    && production_commitment_is_group_membership_alone(host: operator_host_srv7)
    && production_commitment_is_group_membership_alone(host: operator_host_srv8)
}

// THE PAYLOAD INSPECTION BOTH HOSTS GET, rather than one host inspected and the other assumed. An
// earlier cut of the claim above checked group membership for both and the exact commitment payload
// for srv7 only, while its name asserted "and by nothing else" about both -- a claim wider than its
// evidence, which is the same over-reach this module keeps having to unlearn one level up.
fn production_commitment_is_group_membership_alone(host: HostIdentity) -> Bool {
  match spark_host_standing(host: host) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: _, commitments: c } } =>
      is_group_member(c: c.head)
        && (match c.tail { Empty => true  Cons { head: _, tail: _ } => false })
  }
}

// THE DERIVATION IS TOTAL OVER ITS UNIVERSE: unplaced plus authority-held partitions the units,
// and nothing here authors a host list. The partition is between the placement projection and its
// complement, which is the pair of derived sets that consumers actually read.
fn production_host_has_authority_held_cause(host: HostIdentity) -> Bool {
  match spark_host_standing(host: host) {
    Absent => false
    Present { value: SparkHostUncommitted { host: _ } } => false
    Present { value: SparkHostCommitted { host: _, commitments: c } } => length(spark_authority_held_causes_of(c: c)) > 0
  }
}

test fn the_derivation_partitions_the_unit_population() -> Bool {
  let units = dgx_spark_reserved_identities()
  all(spark_unplaced_hosts, h => contains_host(hosts: units, host: h))
    && all(units, h => spark_host_is_unplaced(host: h) != production_host_has_authority_held_cause(host: h))
    && all(spark_committed_standings_of(standings: spark_host_standings), s => match s {
         SparkHostUncommitted { host: _ } => false
         SparkHostCommitted { host: h, commitments: _ } => contains_host(hosts: units, host: h)
       })
}

// ── THE RULING-DERIVED CAUSE IS STRUCTURALLY DISTINGUISHABLE FROM THE AUTHORITY-HELD ONES ──────
//
// THE ACCEPTANCE BAR, stated by the manager who confirmed the reservation row (sunny-carp-329,
// 2026-09-13): a fold must be able to answer which of this host's causes an authority holds on it
// and which exist only by ruling, without reading any arm name. (The bar was first phrased as
// "observed or declared"; the outer split is named for what its members actually are, since a
// claimed group and a cell role are desired state rather than observations -- see the type's note.)
// srv10 carries exactly one cause in production and it is ruling-derived; srv9 carries the held arm
// claim AND the ruling's reservation, and the two projections separate them.
test fn authority_held_and_ruling_derived_causes_are_separable_by_a_fold() -> Bool {
  (match spark_host_standing(host: operator_host_srv10) {
     Absent => false
     Present { value: SparkHostUncommitted { host: _ } } => false
     Present { value: SparkHostCommitted { host: _, commitments: c } } =>
       length(spark_authority_held_causes_of(c: c)) == 0
         && length(spark_ruling_derived_causes_of(c: c)) == 1
         && all(spark_commitment_causes(c: c), x => is_ruling_reservation_for(c: x, subject: glm_canary_serving_subject))
   })
    && (match spark_host_standing(host: operator_host_srv9) {
         Absent => false
         Present { value: SparkHostUncommitted { host: _ } } => false
         Present { value: SparkHostCommitted { host: _, commitments: c } } =>
           length(spark_authority_held_causes_of(c: c)) == 1
             && length(spark_ruling_derived_causes_of(c: c)) == 1
             && any(spark_commitment_causes(c: c), x => is_ruling_reservation_for(c: x, subject: glm_canary_serving_subject))
       })
    && string_contains(s: spark_host_commitment_causes_wire(host: operator_host_srv10) as String, pattern: "reserved by ruling")
}

// ── ADMISSIBILITY TO A SERVING SUBJECT ───────────────────────────────────────────────────────
//
// THE PRODUCTION ANSWER, BY IDENTITY IN BOTH DIRECTIONS. The pair unit on group A -- the subject V4.1
// takes over by the operator's 2026-09-12 ruling -- sees exactly its own four hosts: srv5 and srv6
// through their serving roles and group membership, srv7 and srv8 through membership alone. It does
// NOT see srv9 (the canary's arm) nor srv10-srv12 (reserved for the canary's subject). The canary's
// subject sees srv9-srv12 and none of group A. Nothing is free to both, which is the sentence the
// scalar could never say.
data pair_unit_a: ServingSubject = PairServingUnitOn { group: FabricGroupA }

test fn the_pair_unit_on_group_a_is_admitted_exactly_its_own_four_hosts() -> Bool {
  let admissible = spark_serving_admissible_hosts(subject: pair_unit_a)
  contains_host(hosts: admissible, host: operator_host_srv5)
    && contains_host(hosts: admissible, host: operator_host_srv6)
    && contains_host(hosts: admissible, host: operator_host_srv7)
    && contains_host(hosts: admissible, host: operator_host_srv8)
    && !contains_host(hosts: admissible, host: operator_host_srv9)
    && !contains_host(hosts: admissible, host: operator_host_srv10)
    && !contains_host(hosts: admissible, host: operator_host_srv11)
    && !contains_host(hosts: admissible, host: operator_host_srv12)
    && !contains_host(hosts: admissible, host: operator_host_srv2)
}

test fn the_canary_subject_is_admitted_group_b_and_none_of_group_a() -> Bool {
  let admissible = spark_serving_admissible_hosts(subject: glm_canary_serving_subject)
  contains_host(hosts: admissible, host: operator_host_srv9)
    && contains_host(hosts: admissible, host: operator_host_srv10)
    && contains_host(hosts: admissible, host: operator_host_srv11)
    && contains_host(hosts: admissible, host: operator_host_srv12)
    && !contains_host(hosts: admissible, host: operator_host_srv5)
    && !contains_host(hosts: admissible, host: operator_host_srv6)
    && !contains_host(hosts: admissible, host: operator_host_srv7)
    && !contains_host(hosts: admissible, host: operator_host_srv8)
}

// THE REFUSAL NAMES THE CAUSE THAT WAS NOT HELD, so a host held against a subject is explained rather
// than merely absent. srv9 against the pair unit: the arm claim is the unheld cause. srv5 against the
// canary: both the serving role and the group membership are unheld, and the role is unheld BECAUSE
// the subject does not claim the host, which is the sibling-relative arm of the holder rule.
fn unheld_causes_against(host: HostIdentity, subject: ServingSubject) -> List<SparkHostCommitment> {
  flat_map(spark_serving_admissibility(subject: subject), a => match a {
    SparkHostAdmissibleTo { host: _, subject: _ } => []
    SparkHostHeldAgainst { host: h, subject: _, unheld: u } =>
      if host_identity_eq(a: h, b: host) { spark_commitment_causes(c: u) } else { [] }
  })
}

test fn a_host_held_against_a_subject_names_the_unheld_causes() -> Bool {
  let srv9_vs_a = unheld_causes_against(host: operator_host_srv9, subject: pair_unit_a)
  let srv5_vs_canary = unheld_causes_against(host: operator_host_srv5, subject: glm_canary_serving_subject)
  length(srv9_vs_a) == 2
    && any(srv9_vs_a, c => match c {
         AuthorityHeldCommitment { cause: o } =>
           match o {
             OccupiedByServingArm { claim: cl } => host_identity_eq(a: cl.host, b: operator_host_srv9)
             CommittedToCellRole { role: _ } => false
             MemberOfClaimedServingGroup { group: _ } => false
             HoldsUndischargedRpcReservation => false
             CellRoleUndecidable { assignments: _ } => false
           }
         RulingDerivedCommitment { cause: _ } => false
       })
    && any(srv9_vs_a, c => is_ruling_reservation_for(c: c, subject: glm_canary_serving_subject))
    && length(srv5_vs_canary) == 2
    && any(srv5_vs_canary, c => is_cell_role(c: c))
    && any(srv5_vs_canary, c => is_group_member(c: c))
    && length(unheld_causes_against(host: operator_host_srv5, subject: pair_unit_a)) == 0
}

// ── RED 7: A HOST RESERVED BY ANOTHER SUBJECT OR BY AN UNDISCHARGED RPC RESERVATION IS NEVER
// COUNTED, AND A RELEASE RECEIPT WIDENS THE SUBJECT'S SET ─────────────────────────────────────
//
// Over the fixture roster: srv7 and srv8 are members of a claimed group A, srv9 carries a fixture
// arm. Against the pair unit on A, srv9 is never admissible (another subject's), srv7 is not
// admissible while it holds an RPC reservation (nobody's), and discharging the reservation admits
// srv7 back BY IDENTITY with no other change. The RPC arm is the one no serving subject can ever
// hold, so it is asserted against the group's OWN unit -- the subject that holds everything else on
// the host -- because that is the subject a fail-open would have admitted it to.
data fixture_arm: DeclarationRef = decl_ref(module_path: "test.claim.spark.spark_host_commitment_witness", decl_name: "fixture_arm")

fn fixture_admissible_to_a(held: List<HostIdentity>) -> List<HostIdentity> {
  spark_admissible_hosts_to(
    standings: spark_host_standings_in(
      units: fixture_units,
      assignments: [],
      claimed_group_members: [member(group: FabricGroupA, host: operator_host_srv7), member(group: FabricGroupA, host: operator_host_srv8)],
      arm_claims: [ServingArmHostClaim { arm: fixture_arm, host: operator_host_srv9, basis: "fixture" as NonEmptyStr }],
      held_reservation_hosts: held,
      serving_reservations: [],
    ),
    subject: pair_unit_a,
  )
}

test fn a_reserved_host_is_never_admissible_and_a_release_receipt_widens_the_set() -> Bool {
  let held = fixture_admissible_to_a(held: [operator_host_srv7])
  let released = fixture_admissible_to_a(held: [])
  !contains_host(hosts: held, host: operator_host_srv7)
    && contains_host(hosts: held, host: operator_host_srv8)
    && !contains_host(hosts: held, host: operator_host_srv9)
    && contains_host(hosts: released, host: operator_host_srv7)
    && contains_host(hosts: released, host: operator_host_srv8)
    && !contains_host(hosts: released, host: operator_host_srv9)
    && length(released) == length(held) + 1
}

// A DECLARED RESERVATION HOLDS FOR ITS SUBJECT AND AGAINST EVERY OTHER, over a fixture: srv8 reserved
// by ruling for the fixture arm's subject is admissible to that arm and held against the pair unit,
// while a serving cell role on the same host is held by the reserving subject through the
// sibling-relative arm of the holder rule -- a role on a host nobody claims would be held by nobody.
test fn a_declared_reservation_is_held_by_its_subject_and_against_every_other() -> Bool {
  let arm_subject = PlacedServingArm { arm: fixture_arm }
  let standings = spark_host_standings_in(
    units: fixture_units,
    assignments: [SparkCellRoleAssignment { host: operator_host_srv8, role: SparkServingCell }],
    claimed_group_members: [],
    arm_claims: [],
    held_reservation_hosts: [],
    serving_reservations: [SparkServingReservation {
      subject: arm_subject,
      hosts: [operator_host_srv8],
      basis: ServingRulingCitation { decider: "fixture" as NonEmptyStr, ruled_on: "fixture" as NonEmptyStr, ruled: "fixture" as NonEmptyStr },
    }],
  )
  let to_arm = spark_admissible_hosts_to(standings: standings, subject: arm_subject)
  let to_a = spark_admissible_hosts_to(standings: standings, subject: pair_unit_a)
  let unplaced = spark_unplaced_hosts_of(standings: standings)
  contains_host(hosts: to_arm, host: operator_host_srv8)
    && !contains_host(hosts: to_a, host: operator_host_srv8)
    && contains_host(hosts: to_a, host: operator_host_srv7)
    && contains_host(hosts: to_arm, host: operator_host_srv7)
    && !contains_host(hosts: unplaced, host: operator_host_srv8)
    && contains_host(hosts: unplaced, host: operator_host_srv7)
}

// A SERVING ROLE ON A HOST NO SUBJECT CLAIMS IS HELD BY NOBODY, and a training role is held by nobody
// even where a subject does claim the host: the arm of the holder rule that keeps "committed to a
// role" from silently reading as "available to whoever asks".
test fn an_unclaimed_serving_role_and_any_training_role_are_held_by_nobody() -> Bool {
  let standings = spark_host_standings_in(
    units: fixture_units,
    assignments: [
      SparkCellRoleAssignment { host: operator_host_srv7, role: SparkServingCell },
      SparkCellRoleAssignment { host: operator_host_srv8, role: SparkTrainingCell },
    ],
    claimed_group_members: [member(group: FabricGroupA, host: operator_host_srv8)],
    arm_claims: [],
    held_reservation_hosts: [],
    serving_reservations: [],
  )
  let to_a = spark_admissible_hosts_to(standings: standings, subject: pair_unit_a)
  !contains_host(hosts: to_a, host: operator_host_srv7)
    && !contains_host(hosts: to_a, host: operator_host_srv8)
    && contains_host(hosts: to_a, host: operator_host_srv9)
}

// THE PRODUCTION RESERVATION ROW IS THE RULING'S FIRST HALF, DERIVED THROUGH THE CAGE: its hosts are
// group B's observed members, its subject is the canary's, and it is the row the census reads.
test fn the_group_b_reservation_is_the_canary_subject_over_the_observed_cage() -> Bool {
  serving_subject_eq(a: glm_group_b_serving_reservation.subject, b: glm_canary_serving_subject)
    && serving_subject_eq(a: glm_canary_serving_subject, b: PlacedServingArm { arm: glm_canary_host_claim.arm })
    && contains_host(hosts: glm_group_b_serving_reservation.hosts, host: operator_host_srv9)
    && contains_host(hosts: glm_group_b_serving_reservation.hosts, host: operator_host_srv12)
    && !contains_host(hosts: glm_group_b_serving_reservation.hosts, host: operator_host_srv5)
    && (glm_group_b_serving_reservation.basis.ruled_on as String) == "2026-09-12"
    && any(spark_serving_reservations, r => serving_subject_eq(a: r.subject, b: glm_canary_serving_subject))
}
