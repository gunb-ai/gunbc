data start_field: NonEmptyStr = "1789300000.12" as NonEmptyStr

fn fx_launch() -> VllmEndpointProcessLaunchObservation {
  LaunchObserved {
    launch: vllm_endpoint_process_launch(group: FabricGroupB, endpoint: "192.168.1.236:30000" as NonEmptyStr, process_start_field: start_field),
    receipt: "fx" as ObservationReceiptRef,
  }
}

fn metrics_body(running: String, waiting: String, capacity: String, preempt: String, itl_sum: String, itl_count: String, itok_sum: String, itok_count: String, gen: String, start: String) -> String {
  join([
    "vllm:num_requests_waiting{", "model_name=\"glm\"} ", waiting, "\n",
    "vllm:num_requests_running{", "model_name=\"glm\"} ", running, "\n",
    "vllm:num_requests_waiting_by_reason{", "model_name=\"glm\",reason=\"capacity\"} ", capacity, "\n",
    "vllm:num_preemptions_total{", "model_name=\"glm\"} ", preempt, "\n",
    "vllm:prompt_tokens_total{", "model_name=\"glm\"} 0.0\n",
    "vllm:generation_tokens_total{", "model_name=\"glm\"} ", gen, "\n",
    "vllm:inter_token_latency_seconds_sum{", "model_name=\"glm\"} ", itl_sum, "\n",
    "vllm:inter_token_latency_seconds_count{", "model_name=\"glm\"} ", itl_count, "\n",
    "vllm:iteration_tokens_total_sum{", "model_name=\"glm\"} ", itok_sum, "\n",
    "vllm:iteration_tokens_total_count{", "model_name=\"glm\"} ", itok_count, "\n",
    "process_start_time_seconds ", start, "\n",
  ], "")
}

data fx_idle: String = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "10.0", itl_count: "100.0", itok_sum: "1000.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
data fx_after: String = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "12.0", itl_count: "200.0", itok_sum: "99999.0", itok_count: "20.0", gen: "1128.0", start: "1789300000.12")
data fx_reset: String = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.0", itl_count: "10.0", itok_sum: "10.0", itok_count: "1.0", gen: "10.0", start: "1789300000.12")
data fx_busy: String = metrics_body(running: "3.0", waiting: "2.0", capacity: "2.0", preempt: "1.0", itl_sum: "10.0", itl_count: "100.0", itok_sum: "1000.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")

fn closed_ok() -> OperationLedger {
  LedgerClosed { offered: 4, completed: 4, failed: 0 }
}

fn incomplete_failed_summary() -> OperationLedger {
  LedgerIncomplete { because: "failed requests in the aggregate summary" as NonEmptyStr }
}

test fn a_busy_drain_refuses_the_window() -> Bool {
  let d = drain_from_queue(q: harness_queue_from_body(body: fx_busy))
  match window_from_drain(drain: d) {
    WindowIsolationNotEstablished { cause: _, drain: DrainNotIdle { running: n } } => n == 3
    WindowIsolationNotEstablished { cause: _, drain: _ } => false
    WindowIsolated { grant: _, protected: _, deadline: _, drain: _, exclusion: _ } => false
    ForeignTrafficObserved { attributed_receipt: _, drain: _ } => false
    ForeignTrafficNotObserved { drain: _ } => false
    ForeignTrafficUnread { cause: _, drain: _ } => false
  }
}

test fn a_quiet_drain_is_not_an_isolated_window() -> Bool {
  let d = drain_from_queue(q: harness_queue_from_body(body: fx_idle))
  let w = window_from_drain(drain: d)
  match w {
    WindowIsolated { grant: _, protected: _, deadline: _, drain: _, exclusion: _ } => false
    WindowIsolationNotEstablished { cause: _, drain: DrainObservedIdle } => true
    WindowIsolationNotEstablished { cause: _, drain: _ } => false
    ForeignTrafficObserved { attributed_receipt: _, drain: _ } => false
    ForeignTrafficNotObserved { drain: _ } => false
    ForeignTrafficUnread { cause: _, drain: _ } => false
  }
}

test fn exclusion_warning_names_actors_who_might_arrive() -> Bool {
  string_contains(s: glm_native_exclusion_warning as String, pattern: "harness_probe_cli")
    && string_contains(s: glm_native_exclusion_warning as String, pattern: "nccl-tests")
    && string_contains(s: glm_native_exclusion_warning as String, pattern: "operator")
    && string_contains(s: glm_native_exclusion_warning as String, pattern: "70-110k")
}

test fn isolated_window_requires_exclusion_and_idle_drain() -> Bool {
  let grant = lease_grant(
    reference: protected_subject_key(p: glm_native_protected_subject),
    fence: lease_fence_of(admitting_event: "e" as EventId, generation: 1),
    granted_at: 1,
    policy: LeasePolicy { maximum_duration_seconds: 60, release_law: FencedResource },
  )
  match isolated_window(
    grant: grant,
    measured: glm_native_protected_subject,
    deadline: 61,
    drain: DrainObservedIdle,
    exclusion: ExclusionEstablished { how: "named" as NonEmptyStr, protected: glm_native_protected_subject },
  ) {
    WindowIsolated { grant: _, protected: _, deadline: _, drain: _, exclusion: _ } => true
    WindowIsolationNotEstablished { cause: _, drain: _ } => false
    ForeignTrafficObserved { attributed_receipt: _, drain: _ } => false
    ForeignTrafficNotObserved { drain: _ } => false
    ForeignTrafficUnread { cause: _, drain: _ } => false
  }
}

test fn isolated_window_refuses_without_exclusion() -> Bool {
  let grant = lease_grant(
    reference: protected_subject_key(p: glm_native_protected_subject),
    fence: lease_fence_of(admitting_event: "e" as EventId, generation: 1),
    granted_at: 1,
    policy: LeasePolicy { maximum_duration_seconds: 60, release_law: FencedResource },
  )
  match isolated_window(grant: grant, measured: glm_native_protected_subject, deadline: 61, drain: DrainObservedIdle, exclusion: ExclusionNotEstablished { cause: "route was not withdrawn" as NonEmptyStr }) {
    WindowIsolationNotEstablished { cause: _, drain: DrainObservedIdle } => true
    WindowIsolationNotEstablished { cause: _, drain: _ } => false
    WindowIsolated { grant: _, protected: _, deadline: _, drain: _, exclusion: _ } => false
    ForeignTrafficObserved { attributed_receipt: _, drain: _ } => false
    ForeignTrafficNotObserved { drain: _ } => false
    ForeignTrafficUnread { cause: _, drain: _ } => false
  }
}

test fn isolated_window_refuses_a_generic_lease() -> Bool {
  let grant = lease_grant(
    reference: "probe" as NonEmptyStr,
    fence: lease_fence_of(admitting_event: "e" as EventId, generation: 1),
    granted_at: 1,
    policy: LeasePolicy { maximum_duration_seconds: 60, release_law: FencedResource },
  )
  match isolated_window(
    grant: grant,
    measured: glm_native_protected_subject,
    deadline: 61,
    drain: DrainObservedIdle,
    exclusion: ExclusionEstablished { how: "named" as NonEmptyStr, protected: glm_native_protected_subject },
  ) {
    WindowIsolationNotEstablished { cause: _, drain: DrainObservedIdle } => true
    WindowIsolationNotEstablished { cause: _, drain: _ } => false
    WindowIsolated { grant: _, protected: _, deadline: _, drain: _, exclusion: _ } => false
    ForeignTrafficObserved { attributed_receipt: _, drain: _ } => false
    ForeignTrafficNotObserved { drain: _ } => false
    ForeignTrafficUnread { cause: _, drain: _ } => false
  }
}

test fn a_request_that_emitted_then_failed_cannot_be_denominated_in_tokens() -> Bool {
  !ledger_admits_token_denomination(l: incomplete_failed_summary())
    && ledger_admits_token_denomination(l: closed_ok())
}

test fn engine_rate_comes_from_generation_tokens_not_iteration_or_itl() -> Bool {
  match generation_token_delta(before_body: fx_idle, after_body: fx_after) {
    TokenDeltaRead { tokens: t } =>
      t == 128 &&
        match derive_rate_honest(
          ledger: closed_ok(),
          scrape_millis: Present { value: millisecond(count: 2000) },
          client_output: ClientOutputTokensObserved { tokens: t },
        ) {
          RateFromClientOutputTokens { tokens: tok, scrape_millis: ms } =>
            tok == 128 && millisecond_count(m: ms) == 2000 &&
              match tokens_per_observation_second(r: RateFromClientOutputTokens { tokens: tok, scrape_millis: ms }) {
                Absent => false
                Present { value: rate } => rate == 64
              }
          RateUndenominable { because: _ } => false
          RateUnreadable { because: _ } => false
        }
    TokenDeltaUnread { cause: _ } => false
    TokenDeltaReset { cause: _ } => false
    TokenDeltaScoped { tokens: _, incarnation: _ } => false
  }
}

test fn unread_arrival_skew_refuses_a_rate_comparison() -> Bool {
  !arrival_admits_rate_comparison(s: ArrivalSkewUnread { cause: "bench stdout not parsed" as NonEmptyStr })
}

test fn a_generation_counter_reset_is_not_a_rate() -> Bool {
  match generation_token_delta(before_body: fx_idle, after_body: fx_reset) {
    TokenDeltaReset { cause: _ } => true
    TokenDeltaRead { tokens: _ } => false
    TokenDeltaUnread { cause: _ } => false
    TokenDeltaScoped { tokens: _, incarnation: _ } => false
  }
}

test fn generation_tokens_are_unread_across_distinct_incarnations() -> Bool {
  match generation_token_delta_scoped(
    before_incarnation: fx_incarnation(id: "0f3a9c1d2e4b"),
    after_incarnation: fx_incarnation(id: "7b2e5a90c813"),
    before_body: fx_idle,
    after_body: fx_after,
  ) {
    TokenDeltaUnread { cause: _ } => true
    TokenDeltaRead { tokens: _ } => false
    TokenDeltaReset { cause: _ } => false
    TokenDeltaScoped { tokens: _, incarnation: _ } => false
  }
}

test fn generation_tokens_are_unread_without_an_incarnation() -> Bool {
  match generation_token_delta_scoped(
    before_incarnation: none,
    after_incarnation: fx_same_incarnation(),
    before_body: fx_idle,
    after_body: fx_after,
  ) {
    TokenDeltaUnread { cause: _ } => true
    TokenDeltaRead { tokens: _ } => false
    TokenDeltaReset { cause: _ } => false
    TokenDeltaScoped { tokens: _, incarnation: _ } => false
  }
}

test fn a_scoped_generation_delta_names_the_incarnation() -> Bool {
  match generation_token_delta_scoped(
    before_incarnation: fx_same_incarnation(),
    after_incarnation: fx_same_incarnation(),
    before_body: fx_idle,
    after_body: fx_after,
  ) {
    TokenDeltaScoped { tokens: t, incarnation: i } =>
      t == 128 && (i.container.id as String) == "0f3a9c1d2e4b" && i.node_rank == 0
    TokenDeltaRead { tokens: _ } => false
    TokenDeltaUnread { cause: _ } => false
    TokenDeltaReset { cause: _ } => false
  }
}

fn fx_incarnation(id: String) -> ObservedRankIncarnation? {
  match container_incarnation_id(id: id) {
    Absent => none
    Present { value: cid } =>
      Present { value: ObservedRankIncarnation { host: operator_host_srv9, container: cid, node_rank: 0 } }
  }
}

fn fx_same_incarnation() -> ObservedRankIncarnation? {
  fx_incarnation(id: "0f3a9c1d2e4b")
}

fn fx_bench_receipt(stdout: String) -> BenchServeExecution {
  bench_serve_from_remote(
    protocol: glm_native_smoke_protocol,
    remote: RemoteRan { exit_code: 0, stdout: stdout, stderr: "" },
  )
}

fn fx_obs() -> ServingLoadObservation {
  serving_load_observation(
    subject: glm_native_live_subject_standing(),
    window: window_from_drain(drain: DrainObservedIdle),
    continuity: counter_continuity(before: fx_launch(), after: fx_launch()),
    occupancy: occupancy_trace_from_endpoint_scrapes(before_body: fx_idle, after_body: fx_after),
    before_body: fx_idle,
    after_body: fx_after,
    before_incarnation: fx_same_incarnation(),
    after_incarnation: fx_same_incarnation(),
    bench: fx_bench_receipt(stdout: fx_bench_stdout),
  )
}

test fn generation_tokens_without_client_completions_is_foreign_load() -> Bool {
  match derive_rate_honest(
    ledger: LedgerClosed { offered: 4, completed: 0, failed: 4 },
    scrape_millis: Present { value: millisecond(count: 2000) },
    client_output: ClientOutputTokensUnread { cause: "none" as NonEmptyStr },
  ) {
    RateUndenominable { because: _ } => true
    RateFromClientOutputTokens { tokens: _, scrape_millis: _ } => false
    RateUnreadable { because: _ } => false
  }
}

test fn occupancy_above_declared_concurrency_does_not_refuse_the_client_rate() -> Bool {
  match derive_rate_honest(
    ledger: closed_ok(),
    scrape_millis: Present { value: millisecond(count: 2000) },
    client_output: ClientOutputTokensObserved { tokens: 128 },
  ) {
    RateFromClientOutputTokens { tokens: t, scrape_millis: _ } => t == 128
    RateUnreadable { because: _ } => false
    RateUndenominable { because: _ } => false
  }
}

test fn unread_client_output_tokens_refuse_the_rate() -> Bool {
  match derive_rate_honest(
    ledger: closed_ok(),
    scrape_millis: Present { value: millisecond(count: 2000) },
    client_output: ClientOutputTokensUnread { cause: "bench stdout not parsed" as NonEmptyStr },
  ) {
    RateUnreadable { because: _ } => true
    RateFromClientOutputTokens { tokens: _, scrape_millis: _ } => false
    RateUndenominable { because: _ } => false
  }
}

test fn extra_engine_tokens_bound_foreign_work_and_keep_the_client_rate() -> Bool {
  match derive_rate_honest(
    ledger: closed_ok(),
    scrape_millis: Present { value: millisecond(count: 2000) },
    client_output: ClientOutputTokensObserved { tokens: 128 },
  ) {
    RateFromClientOutputTokens { tokens: t, scrape_millis: _ } =>
      t == 128 &&
        match foreign_work_bound(generation: TokenDeltaRead { tokens: 200 }, client_output: ClientOutputTokensObserved { tokens: 128 }) {
          ForeignWorkBounded { engine_generation: g, client_output: c, surplus: s } => g == 200 && c == 128 && s == 72
          ForeignWorkUnread { because: _ } => false
          ForeignWorkContradiction { engine_generation: _, client_output: _, because: _ } => false
        }
    RateUnreadable { because: _ } => false
    RateUndenominable { because: _ } => false
  }
}

test fn unsampled_occupancy_does_not_refuse_the_client_rate() -> Bool {
  match derive_rate_honest(
    ledger: closed_ok(),
    scrape_millis: Present { value: millisecond(count: 2000) },
    client_output: ClientOutputTokensObserved { tokens: 128 },
  ) {
    RateFromClientOutputTokens { tokens: t, scrape_millis: _ } => t == 128
    RateUnreadable { because: _ } => false
    RateUndenominable { because: _ } => false
  }
}

test fn a_long_context_protocol_does_not_mint_an_admission_ceiling() -> Bool {
  match glm_native_workload_admission {
    AdmissionCostUnestablished { cause: _ } =>
      match fx_obs().admission {
        AdmissionCostUnestablished { cause: _ } => true
        AdmissionCostBlocks { blocks: _ } => false
      }
    AdmissionCostBlocks { blocks: _ } => false
  }
}

test fn one_run_does_not_decide_saturation() -> Bool {
  let obs = fx_obs()
  !saturation_from_one_run(obs: obs)
    && !observation_rate_is_stored_separately(obs: obs)
    && match obs.capacity_claim {
      CapacityClaimUnavailable { because: _ } => true
    }
    && match obs.qualified_rate {
      ClientRateUnqualified { because: _ } => true
    }
}

test fn client_output_exceeding_engine_generation_is_a_contradiction() -> Bool {
  match foreign_work_bound(generation: TokenDeltaRead { tokens: 100 }, client_output: ClientOutputTokensObserved { tokens: 512 }) {
    ForeignWorkContradiction { engine_generation: g, client_output: c, because: _ } => g == 100 && c == 512
    ForeignWorkBounded { engine_generation: _, client_output: _, surplus: _ } => false
    ForeignWorkUnread { because: _ } => false
  }
}

test fn occupancy_reads_prompt_tokens_that_are_not_an_integer_lexeme() -> Bool {
  match occupancy_from_body(body: fx_idle) {
    Absent => false
    Present { value: s } => s.running == 0 && s.prompt_tokens == 0
  }
}

test fn an_itl_histogram_sum_with_sub_milli_digits_is_still_a_milli_reading() -> Bool {
  let before = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "10.1234567", itl_count: "100.0", itok_sum: "1000.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  let after = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "12.1234567", itl_count: "200.0", itok_sum: "1000.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  match itl_latency_delta(before_body: before, after_body: after) {
    LatencyHistogramRead { sum: ds, observations: dc } => millisecond_count(m: ds) == 2000 && dc == 100
    LatencyHistogramUnread { cause: _ } => false
    LatencyHistogramReset { cause: _ } => false
  }
}

test fn an_itl_histogram_sum_delta_of_half_a_second_is_500_milliseconds() -> Bool {
  let before = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.0", itl_count: "10.0", itok_sum: "100.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  let after = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.5", itl_count: "15.0", itok_sum: "110.0", itok_count: "12.0", gen: "1000.0", start: "1789300000.12")
  match itl_latency_delta(before_body: before, after_body: after) {
    LatencyHistogramRead { sum: s, observations: n } => millisecond_count(m: s) == 500 && n == 5
    LatencyHistogramUnread { cause: _ } => false
    LatencyHistogramReset { cause: _ } => false
  }
}

test fn an_iteration_tokens_sum_delta_is_booked_tokens_not_a_duration() -> Bool {
  let before = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.0", itl_count: "10.0", itok_sum: "100.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  let after = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.5", itl_count: "15.0", itok_sum: "110.0", itok_count: "12.0", gen: "1000.0", start: "1789300000.12")
  match iteration_tokens_booked_delta(before_body: before, after_body: after) {
    TokenHistogramRead { booked: t, observations: n } => token_count_value(t: t) == 10 && n == 2
    TokenHistogramUnread { cause: _ } => false
    TokenHistogramReset { cause: _ } => false
  }
}

test fn a_fractional_iteration_tokens_sum_delta_refuses_rather_than_rounding() -> Bool {
  let before = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.0", itl_count: "10.0", itok_sum: "100.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  let after = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.5", itl_count: "15.0", itok_sum: "110.5", itok_count: "12.0", gen: "1000.0", start: "1789300000.12")
  match iteration_tokens_booked_delta(before_body: before, after_body: after) {
    TokenHistogramRead { booked: _, observations: _ } => false
    TokenHistogramUnread { cause: _ } => true
    TokenHistogramReset { cause: _ } => false
  }
}

test fn a_sub_milli_token_fraction_refuses_rather_than_truncating() -> Bool {
  let before = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.0", itl_count: "10.0", itok_sum: "100.0", itok_count: "10.0", gen: "1000.0", start: "1789300000.12")
  let after = metrics_body(running: "0.0", waiting: "0.0", capacity: "0.0", preempt: "0.0", itl_sum: "1.5", itl_count: "15.0", itok_sum: "110.0005", itok_count: "12.0", gen: "1000.0", start: "1789300000.12")
  match iteration_tokens_booked_delta(before_body: before, after_body: after) {
    TokenHistogramRead { booked: _, observations: _ } => false
    TokenHistogramUnread { cause: _ } => true
    TokenHistogramReset { cause: _ } => false
  }
}

test fn the_observation_keeps_itl_milliseconds_and_booked_tokens_distinct() -> Bool {
  let obs = fx_obs()
  match obs.itl_latency {
    LatencyHistogramRead { sum: s, observations: n } =>
      millisecond_count(m: s) == 2000 && n == 100
        && match obs.iteration_tokens_booked {
          TokenHistogramRead { booked: t, observations: k } => token_count_value(t: t) == 98999 && k == 10
          TokenHistogramUnread { cause: _ } => false
          TokenHistogramReset { cause: _ } => false
        }
    LatencyHistogramUnread { cause: _ } => false
    LatencyHistogramReset { cause: _ } => false
  }
}

test fn a_sudo_password_prompt_line_does_not_spoil_the_bench_ledger() -> Bool {
  let body = join(["[sudo] password for briansrls:\n", fx_bench_stdout], "")
  match ledger_from_bench_stdout(body: body, offered: 4) {
    LedgerClosed { offered: o, completed: c, failed: f } =>
      o == 4 && c == 4 && f == 0
        && match client_output_from_bench_stdout(body: body) {
          ClientOutputTokensObserved { tokens: n } => n == 512
          ClientOutputTokensUnread { cause: _ } => false
        }
    LedgerIncomplete { because: _ } => false
  }
}

test fn the_holistic_protocol_does_not_corroborate_the_single_stream_bound() -> Bool {
  match decode_corroboration_for_protocol(req: glm_native_holistic_protocol) {
    CorroborationNotApplicable { because: _ } =>
      millisecond_count(m: glm_native_single_stream_decode_bound_millis) == 49
        && match glm_native_single_stream_decode_bound_standing {
          TranscribedUncited { read_obligation: _ } => true
          CitedToAuthority { authority: _ } => false
        }
    CorroborationUnread { because: _ } => false
  }
}

test fn the_smoke_protocol_is_not_the_holistic_envelope() -> Bool {
  !holistic_protocol_is_session_shaped(req: glm_native_smoke_protocol)
    && !vllm_bench_serve_uses_poisson_idle_gaps(req: glm_native_smoke_protocol)
    && millisecond_count(m: glm_native_smoke_client_latency.tpot_milli) == 82
}

test fn a_64_out_wiring_receipt_is_not_the_128_out_sweep_protocol() -> Bool {
  bench_output_len(req: glm_native_wiring_smoke_protocol) == 64
    && bench_output_len(req: glm_native_contended_sweep_c2.protocol) == 128
    && !pinned_load_protocol_matches(a: glm_native_wiring_smoke_protocol, b: glm_native_contended_sweep_c2.protocol)
}

test fn protocol_identity_includes_backend_model_tokenizer_and_arrival() -> Bool {
  vllm_bench_serve_identity_matches(a: glm_native_smoke_protocol, b: glm_native_wiring_smoke_protocol)
    && !vllm_bench_serve_identity_matches(a: glm_native_smoke_protocol, b: glm_native_holistic_protocol)
}

data fx_bench_stdout: String = join([
  "============ Serving Benchmark Result ============\n",
  "Successful requests:                     4\n",
  "Failed requests:                         0\n",
  "Benchmark duration (s):                  22.75\n",
  "Total input tokens:                      1072\n",
  "Total generated tokens:                  512\n",
  "Request throughput (req/s):              0.18\n",
  "Output token throughput (tok/s):         22.51\n",
  "Total Token throughput (tok/s):          69.64\n",
  "Peak concurrent requests:                4.00\n",
  "---------------Time to First Token----------------\n",
  "Mean TTFT (ms):                          996.40\n",
  "-----Time per Output Token (excl. 1st token)------\n",
  "Mean TPOT (ms):                          82.10\n",
  "---------------Inter-token Latency----------------\n",
  "Mean ITL (ms):                           83.20\n",
  "Median ITL (ms):                         82.10\n",
  "P99 ITL (ms):                            165.00\n",
], "")

data fx_bench_stdout_short: String = join([
  "============ Serving Benchmark Result ============\n",
  "Successful requests:                     4\n",
  "Failed requests:                         0\n",
  "Benchmark duration (s):                  10.00\n",
  "Total generated tokens:                  512\n",
], "")

test fn a_cap_2_second_bucket_peak_4_does_not_establish_foreign_work() -> Bool {
  cap_2_bucket_peak_4_is_not_foreign_work(p: SuccessfulClientRequestSecondBucketPeak {
    client_max_concurrency: 2,
    bucket_peak: 4,
  })
}

test fn parsed_itl_distribution_does_not_establish_a_cause() -> Bool {
  let d = client_itl_from_bench_stdout(body: fx_bench_stdout)
  match d {
    ClientItlDistributionObserved { mean_milli: mean_m, median_milli: med, p99_milli: p99, cause: _ } =>
      millisecond_count(m: mean_m) == 83 && millisecond_count(m: med) == 82 && millisecond_count(m: p99) == 165 && itl_tail_cause_is_unestablished(d: d)
    ClientItlDistributionUnread { cause: _ } => false
  }
}

test fn ledger_and_rate_come_from_bench_stdout_not_exit_ok() -> Bool {
  match ledger_from_bench_stdout(body: fx_bench_stdout, offered: 4) {
    LedgerClosed { offered: o, completed: c, failed: f } =>
      o == 4 && c == 4 && f == 0
        && match client_output_from_bench_stdout(body: fx_bench_stdout) {
          ClientOutputTokensUnread { cause: _ } => false
          ClientOutputTokensObserved { tokens: n } =>
            n == 512
              && match scrape_millis_from_bench_stdout(body: fx_bench_stdout) {
                Absent => false
                Present { value: ms } => millisecond_count(m: ms) == 22750
              }
        }
    LedgerIncomplete { because: _ } => false
  }
}

test fn wet_smoke_tpot_is_not_a_protocol_match_to_sweep_c1() -> Bool {
  glm_native_wet_smoke_is_not_sweep_c1_protocol()
}

test fn the_probe_rate_is_completed_output_tokens_not_total_including_prefill() -> Bool {
  glm_native_wet_smoke_rate_is_output_tokens()
}

test fn the_contended_sweep_is_five_shared_window_client_points() -> Bool {
  length(glm_native_contended_sweep_points) == 5
    && glm_native_sweep_num_prompts(concurrency: 1) == 8
    && glm_native_sweep_num_prompts(concurrency: 2) == 8
    && glm_native_sweep_num_prompts(concurrency: 4) == 16
    && milli_tokens_per_second_count(r: glm_native_contended_sweep_c1.latency.output_throughput) == 10860
    && millisecond_count(m: glm_native_contended_sweep_c1.latency.tpot_milli) == 81
    && millisecond_count(m: glm_native_contended_sweep_c1.latency.ttft_milli) == 1542
    && glm_native_contended_sweep_c1.concurrency == 1
}

test fn scaling_elasticity_is_off_the_uncontrolled_series() -> Bool {
  elasticity_is_off_the_uncontrolled_series(s: glm_native_contended_sweep_elasticity)
}

test fn ttft_c8_and_c16_remain_primitive_observations() -> Bool {
  glm_native_sweep_ttft_c8() == 2602 && glm_native_sweep_ttft_c16() == 5218
}

test fn the_49_vs_81_ms_gap_is_why_window_standing_is_a_field() -> Bool {
  millisecond_count(m: glm_native_window_standing_specimen.quieter_engine_tpot_milli) == 49
    && millisecond_count(m: glm_native_window_standing_specimen.contended_client_c1_tpot_milli) == 81
    && window_standing_gap_is_unattributed(s: glm_native_window_standing_specimen)
}

test fn long_context_stays_a_prototype_until_the_qualification_window() -> Bool {
  match glm_native_holistic_execution {
    LongContextLoadProtocolPrototype { until: u } =>
      string_contains(s: u as String, pattern: "qualification-window")
    LongContextRunnable { because: _ } => false
  }
}

test fn the_holistic_protocol_is_poisson_with_session_context_and_prefix() -> Bool {
  holistic_protocol_is_session_shaped(req: glm_native_holistic_protocol)
    && vllm_bench_serve_uses_poisson_idle_gaps(req: glm_native_holistic_protocol)
    && !vllm_bench_serve_uses_poisson_idle_gaps(req: vllm_bench_serve_request(
      backend: OpenaiChat,
      base_url: "http://127.0.0.1:30000" as NonEmptyStr,
      model: "m" as NonEmptyStr,
      tokenizer: "m" as NonEmptyStr,
      dataset: RandomDatasetSpec { input_len: token_count(count: 128), output_len: token_count(count: 128), prefix_len: token_count(count: 0) },
      num_prompts: 4,
      arrival: SendAllImmediately,
      max_concurrency: Absent,
      ignore_eos: true,
      seed: 20260918,
    ))
}

fn words_contain(words: List<String>, needle: String) -> Bool {
  count(filter(words, w => w == needle)) > 0
}

test fn the_rendered_argv_carries_the_prefix_and_a_finite_rate() -> Bool {
  let words = vllm_bench_serve_arguments(req: glm_native_holistic_protocol)
  words_contain(words: words, needle: "--random-prefix-len")
    && words_contain(words: words, needle: "100000")
    && words_contain(words: words, needle: "--request-rate")
    && words_contain(words: words, needle: "0.050")
    && !words_contain(words: words, needle: "inf")
    && words_contain(words: words, needle: "--tokenizer")
    && words_contain(words: words, needle: glm_native_engine_tokenizer_path as String)
    && words_contain(words: words, needle: "--model")
    && words_contain(words: words, needle: "--seed")
    && words_contain(words: words, needle: "20260918")
    && (glm_native_holistic_protocol.model as String) != (glm_native_holistic_protocol.tokenizer as String)
}

test fn this_reading_names_a_split_driver_and_observer() -> Bool {
  match glm_native_live_probe_provenance {
    DriverObserverSplit { driver: _, observer: _ } => true
    SamePrincipal { principal: _ } => false
  }
}

test fn exporter_restart_breaks_counter_continuity() -> Bool {
  let after: VllmEndpointProcessLaunchObservation = LaunchObserved {
    launch: vllm_endpoint_process_launch(group: FabricGroupB, endpoint: "192.168.1.236:30000" as NonEmptyStr, process_start_field: "1789300999.00" as NonEmptyStr),
    receipt: "fx2" as ObservationReceiptRef,
  }
  match counter_continuity(before: fx_launch(), after: after) {
    ExporterChanged { before: _, after: _ } => true
    SameExporter { start_field: _ } => false
    ContinuityUnread { cause: _ } => false
  }
}

test fn mixing_two_bench_stdout_bodies_cannot_write_one_receipt() -> Bool {
  mixed_run_client_facts_cannot_be_written(
    a: fx_bench_receipt(stdout: fx_bench_stdout),
    b: fx_bench_receipt(stdout: fx_bench_stdout_short),
  )
}

