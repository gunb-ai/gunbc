    num_prompts: 4,
    cap: 2,
    start_event_count: 0,
  )
}

test fn qualify_client_rate_refuses_two_boundary_occupancy() -> Bool {
  match occupancy_does_not_count_positively(occupancy: OccupancyBoundariesRead {
    before: OccupancySample { running: 0, waiting: 0, capacity_waiting: 0, preemptions: 0, prompt_tokens: 0 },
    after: OccupancySample { running: 0, waiting: 0, capacity_waiting: 0, preemptions: 0, prompt_tokens: 1 },
  }) {
    ClientRateUnqualified { because: _ } => true
  }
}

