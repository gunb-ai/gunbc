module test.claim.spark.pair_incumbent_identity_witness

import std.logic { Bool }
import std.types { String, NonEmptyStr, List }
import v2.std.optional { Present, Absent }
import std.content_hash { ContentHash, Sha256Hash, sha256_hex_digest, compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable }
import product.placement_supply { HostIdentity }
import product.fabric.demand { ObservationReceiptRef }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8, operator_host_srv1 }
import gunbc.spark.fabric_switch_observed { FabricGroupA, FabricGroupB }
import gunbc.spark.vllm_endpoint_process_launch { vllm_endpoint_process_launch }
import gunbc.spark.vllm_serving_launch { vllm_serving_launch, EndpointIncarnationObservation, endpoint_incarnation_observation }
import gunbc.spark.serving_incarnation_observe { IncarnationUnitNotActive }
import gunbc.spark.pair_serving_realization { spark_pair_head_unit_name, spark_pair_worker_unit_name }
import gunbc.spark.pair_incumbent_identity {
  DeclaredRankUnit, DeclaredPairRealization, declared_pair_realization_of,
  DeclaredPairRealizationStanding, DeclaredPairRealizationKeyed, DeclaredPairRealizationUnavailable, declared_pair_realization,
  ObservedRankUnit, ObservedPairRealization, observed_pair_realization_of,
  ObservedPairRealizationReading, ObservedPairRealizationRead, ObservedPairRealizationRefused,
  PairWorkerUnitRefused,
  PairRealizationAgreement, PairRealizationEstablished, PairRealizationDrifted, PairRealizationRankPopulationDiffers,
  PairRealizationConflict, PairRealizationDeclarationUnavailable, PairRealizationUnread,
  ImageObservedUncompared, pair_realization_agreement, pair_realization_is_established, pair_realization_agreement_lines,
}

// THE CLAIMS DISCRIMINATE AT ONE INTERFACE EACH (DESIGN §3 witness rule). The agreement fold takes
// a declared standing and an observed reading as SUPPLIED VALUES; the fixtures below construct
// them, so no claim re-renders a unit or opens an ssh session to ask what the fold answers. The
// pairing obligation is discharged at the declared boundary by the one inhabitance claim at the
// bottom, which runs the PRODUCTION declared producer over Group A and asserts the route it takes.
// The observed boundary's producer reads four Sparks over the fleet key session and has no CI
// route: its inhabitance is the operator-run instrument gunbc.instruments.pair_incumbent_identity_standing
// and the receipt it writes, the same boundary gunbc.spark.serving_incarnation_observe's witness draws.

fn t_sha(hex: String) -> ContentHash? {
  match sha256_hex_digest(hex: hex) {
    Absent => none
    Present { value: d } => Present { value: Sha256Hash(d) }
  }
}

data t_hex_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data t_hex_b: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data t_hex_c: String = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
data t_hex_img: String = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"

// Every scenario needs the same three digests; folding them once keeps each claim a scenario over
// supplied hashes rather than four Option matches deep.
fn with_digests(scenario: fn(ContentHash, ContentHash, ContentHash, ContentHash) -> Bool) -> Bool {
  match t_sha(hex: t_hex_a) {
    Absent => false
    Present { value: a } =>
      match t_sha(hex: t_hex_b) {
        Absent => false
        Present { value: b } =>
          match t_sha(hex: t_hex_c) {
            Absent => false
            Present { value: c } =>
              match t_sha(hex: t_hex_img) {
                Absent => false
                Present { value: img } => scenario(a, b, c, img)
              }
          }
      }
  }
}

fn t_declared(head_digest: ContentHash, worker_digest: ContentHash) -> DeclaredPairRealization {
  declared_pair_realization_of(
    group: FabricGroupA,
    head: DeclaredRankUnit { host: operator_host_srv5, unit_name: spark_pair_head_unit_name, digest: head_digest },
    workers: [
      DeclaredRankUnit { host: operator_host_srv6, unit_name: spark_pair_worker_unit_name, digest: worker_digest },
      DeclaredRankUnit { host: operator_host_srv7, unit_name: spark_pair_worker_unit_name, digest: worker_digest },
      DeclaredRankUnit { host: operator_host_srv8, unit_name: spark_pair_worker_unit_name, digest: worker_digest },
    ],
  )
}

fn t_head_observation(unit_digest: ContentHash, image: ContentHash) -> EndpointIncarnationObservation {
  endpoint_incarnation_observation(
    endpoint: vllm_endpoint_process_launch(group: FabricGroupA, endpoint: "http://10.0.0.5:8000" as NonEmptyStr, process_start_field: "1" as NonEmptyStr),
    launch: vllm_serving_launch(
      group: FabricGroupA, head: operator_host_srv5,
      systemd_invocation: "fixture-invocation-head" as NonEmptyStr, container_id: "fixture-container" as NonEmptyStr,
      executable_digest: image, unit_digest: unit_digest, started_at: 1788907506,
    ),
    receipt: "test.claim.spark.pair_incumbent_identity_witness fixture" as ObservationReceiptRef,
  )
}

fn t_worker(host: HostIdentity, unit_digest: ContentHash) -> ObservedRankUnit {
  ObservedRankUnit { host: host, unit_name: spark_pair_worker_unit_name, systemd_invocation: "fixture-invocation-worker" as NonEmptyStr, unit_digest: unit_digest }
}

fn t_observed(head_digest: ContentHash, image: ContentHash, workers: List<ObservedRankUnit>) -> ObservedPairRealizationReading {
  ObservedPairRealizationRead {
    observed: observed_pair_realization_of(
      group: FabricGroupA, head: t_head_observation(unit_digest: head_digest, image: image), workers: workers,
      receipt: "test.claim.spark.pair_incumbent_identity_witness fixture" as ObservationReceiptRef,
    ),
  }
}

fn t_three_workers(digest: ContentHash) -> List<ObservedRankUnit> {
  [t_worker(host: operator_host_srv6, unit_digest: digest), t_worker(host: operator_host_srv7, unit_digest: digest), t_worker(host: operator_host_srv8, unit_digest: digest)]
}

fn t_agreement(declared: DeclaredPairRealization, observed: ObservedPairRealizationReading) -> PairRealizationAgreement {
  pair_realization_agreement(declared: DeclaredPairRealizationKeyed { declared: declared }, observed: observed)
}

fn hashes_equal(l: ContentHash, r: ContentHash) -> Bool {
  match compare_content_hash(left: l, right: r) {
    ContentHashEqual => true
    ContentHashDifferent => false
    ContentHashCrossFamilyIncomparable => false
  }
}

// ── THE KEY ────────────────────────────────────────────────────────────────────────────────────

// Same ranks, same key: the key is a function of the declaration and nothing else.
test fn the_declared_key_is_a_function_of_its_ranks() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    hashes_equal(l: t_declared(head_digest: a, worker_digest: b).key, r: t_declared(head_digest: a, worker_digest: b).key)
  })
}

// RED -- one worker's bytes change and the key changes; the head's bytes change and it changes again.
test fn any_ranks_bytes_changing_changes_the_key() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let base = t_declared(head_digest: a, worker_digest: b)
    !hashes_equal(l: base.key, r: t_declared(head_digest: a, worker_digest: c).key)
      && !hashes_equal(l: base.key, r: t_declared(head_digest: c, worker_digest: b).key)
  })
}

// ── THE AGREEMENT ──────────────────────────────────────────────────────────────────────────────

// Every rank's observed unit digest equals its declared one: established, carrying both sides and
// the head's image id as UNCOMPARED -- the observed side has an image id, the declared side has none.
test fn a_pair_matching_every_rank_is_established_with_its_image_uncompared() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let d = t_declared(head_digest: a, worker_digest: b)
    match t_agreement(declared: d, observed: t_observed(head_digest: a, image: img, workers: t_three_workers(digest: b))) {
      PairRealizationEstablished { key: k, declared: _, observed: _, image: ImageObservedUncompared { observed: seen, obligation: _ } } =>
        hashes_equal(l: k, r: d.key) && hashes_equal(l: seen, r: img)
      _ => false
    }
  })
}

// RED -- ONE worker runs a unit whose bytes differ from the declared ones. The verdict is Drifted,
// naming exactly that host, and it is not Established however many ranks agree.
test fn one_drifted_worker_is_drifted_naming_that_host() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let workers = [t_worker(host: operator_host_srv6, unit_digest: b), t_worker(host: operator_host_srv7, unit_digest: c), t_worker(host: operator_host_srv8, unit_digest: b)]
    let verdict = t_agreement(declared: t_declared(head_digest: a, worker_digest: b), observed: t_observed(head_digest: a, image: img, workers: workers))
    match verdict {
      PairRealizationDrifted { key: _, drifted: ds } =>
        length(ds) == 1 && all(ds, x => (x.host as String) == (operator_host_srv7 as String)) && !pair_realization_is_established(a: verdict)
      _ => false
    }
  })
}

// RED -- the HEAD was launched from different unit bytes: the head row drifts through the same
// provenance comparison the offer route uses, so a head drift is a drift and not a population issue.
test fn a_head_launched_from_other_bytes_is_drifted() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    match t_agreement(declared: t_declared(head_digest: a, worker_digest: b), observed: t_observed(head_digest: c, image: img, workers: t_three_workers(digest: b))) {
      PairRealizationDrifted { key: _, drifted: ds } => length(ds) == 1 && all(ds, x => (x.host as String) == (operator_host_srv5 as String))
      _ => false
    }
  })
}

// RED -- a declared worker host with no observed rank: the two sides are not about the same
// machines, which is reported as a population difference and never as agreement over the rest.
test fn a_missing_worker_rank_is_a_population_difference() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let workers = [t_worker(host: operator_host_srv6, unit_digest: b), t_worker(host: operator_host_srv8, unit_digest: b)]
    match t_agreement(declared: t_declared(head_digest: a, worker_digest: b), observed: t_observed(head_digest: a, image: img, workers: workers)) {
      PairRealizationRankPopulationDiffers { key: _, declared_hosts: dh, observed_hosts: oh } => length(dh) == 4 && length(oh) == 3
      _ => false
    }
  })
}

// RED -- the answering head is on a host the declaration does not name as head.
test fn a_head_on_another_host_is_a_population_difference() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let head = endpoint_incarnation_observation(
      endpoint: vllm_endpoint_process_launch(group: FabricGroupA, endpoint: "http://10.0.0.1:8000" as NonEmptyStr, process_start_field: "1" as NonEmptyStr),
      launch: vllm_serving_launch(
        group: FabricGroupA, head: operator_host_srv1,
        systemd_invocation: "fixture-invocation-head" as NonEmptyStr, container_id: "fixture-container" as NonEmptyStr,
        executable_digest: img, unit_digest: a, started_at: 1788907506,
      ),
      receipt: "test.claim.spark.pair_incumbent_identity_witness fixture" as ObservationReceiptRef,
    )
    let observed = ObservedPairRealizationRead {
      observed: observed_pair_realization_of(group: FabricGroupA, head: head, workers: t_three_workers(digest: b), receipt: "test.claim.spark.pair_incumbent_identity_witness fixture" as ObservationReceiptRef),
    }
    match t_agreement(declared: t_declared(head_digest: a, worker_digest: b), observed: observed) {
      PairRealizationRankPopulationDiffers { key: _, declared_hosts: _, observed_hosts: _ } => true
      _ => false
    }
  })
}

// An observation that refused is UNREAD, carrying the refusal and the declared key -- never Drifted
// (nothing was compared) and never Established.
test fn a_refused_observation_is_unread_not_drifted() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let refused = ObservedPairRealizationRefused { refusal: PairWorkerUnitRefused { host: operator_host_srv7, refusal: IncarnationUnitNotActive { unit: spark_pair_worker_unit_name } } }
    let d = t_declared(head_digest: a, worker_digest: b)
    match t_agreement(declared: d, observed: refused) {
      PairRealizationUnread { key: k, refusal: PairWorkerUnitRefused { host: h, refusal: _ } } => hashes_equal(l: k, r: d.key) && (h as String) == (operator_host_srv7 as String)
      _ => false
    }
  })
}

// A declaration that could not be keyed has nothing to agree with, whatever was observed.
test fn an_unavailable_declaration_is_reported_before_the_observation() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    match pair_realization_agreement(
      declared: DeclaredPairRealizationUnavailable { group: FabricGroupA, obligation: "witness" as NonEmptyStr },
      observed: t_observed(head_digest: a, image: img, workers: t_three_workers(digest: b)),
    ) {
      PairRealizationDeclarationUnavailable { group: _, obligation: o } => (o as String) == "witness"
      _ => false
    }
  })
}

// The receipt lines locate the verdict: a drift renders one line per drifted host under its verdict line.
test fn the_receipt_renders_one_line_per_drifted_rank() -> Bool {
  with_digests(scenario: fn(a, b, c, img) {
    let workers = [t_worker(host: operator_host_srv6, unit_digest: c), t_worker(host: operator_host_srv7, unit_digest: c), t_worker(host: operator_host_srv8, unit_digest: b)]
    let lines = pair_realization_agreement_lines(a: t_agreement(declared: t_declared(head_digest: a, worker_digest: b), observed: t_observed(head_digest: a, image: img, workers: workers)))
    length(lines) == 3
  })
}

// ── INHABITANCE: THE PRODUCTION DECLARED PRODUCER, OVER THE REAL GROUP A DECLARATION ───────────
//
// This is the one claim that runs the real declared route: it renders Group A's four units from
// gunbc.spark.pair_serving_realization and digests them. It asserts the ROUTE -- Keyed, one head,
// three workers, and a key that is stable across two derivations -- not merely the shape. Deleting
// the integration (say, declared_pair_realization returning Unavailable for a realized group) fails
// it. Group B has no pair realization and must say so rather than key an empty pair.
test fn the_production_declaration_keys_group_a_and_refuses_group_b() -> Bool {
  match declared_pair_realization(group: FabricGroupA) {
    DeclaredPairRealizationUnavailable { group: _, obligation: _ } => false
    DeclaredPairRealizationKeyed { declared: d } =>
      length(d.workers) == 3
        && (d.head.unit_name as String) == (spark_pair_head_unit_name as String)
        && all(d.workers, w => (w.unit_name as String) == (spark_pair_worker_unit_name as String))
        && (match declared_pair_realization(group: FabricGroupA) {
              DeclaredPairRealizationKeyed { declared: again } => hashes_equal(l: again.key, r: d.key)
              DeclaredPairRealizationUnavailable { group: _, obligation: _ } => false
            })
        && (match declared_pair_realization(group: FabricGroupB) {
              DeclaredPairRealizationUnavailable { group: _, obligation: _ } => true
              DeclaredPairRealizationKeyed { declared: _ } => false
            })
  }
}
