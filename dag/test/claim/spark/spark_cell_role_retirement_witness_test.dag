// SPARK-PAIR-0 P0. The discriminating evidence for role separation and real serving retirement.
// Every claim here is written so that reverting the role assignment, or restoring the empty removal
// remedy, turns it red — an assertion that passes under both the old and the new model would be
// measuring nothing.

fn w_serving_addresses() -> List<SparkServingResourceAddress> {
  [
    SparkServingUserUnitActivityAddress,
    SparkServingUserUnitEnablementAddress,
    SparkServingUserUnitAddress,
    SparkServingUserUnitRegistrationAddress,
  ]
}

fn w_baseline_addresses() -> List<SparkServingResourceAddress> {
  [
    SparkServingRuntimeRootAddress,
    SparkServingModelSlotAddress { slot: spark_serving_primary_model_slot },
    SparkServingLingerAddress,
  ]
}

fn w_member(host: HostIdentity, address: SparkServingResourceAddress) -> SparkServingMember {
  SparkServingMember {
    host: host,
    principal: "gunbc-automation" as NonEmptyStr,
    address: address,
    state_digest: "w-state" as NonEmptyStr,
    ownership: Owned,
  }
}

fn w_retirement_effects(address: SparkServingResourceAddress) -> List<SparkServingRetirementEffect> {
  match spark_serving_retirement_effects_for_address(address: address) {
    SparkServingRetirementRemedyPresent { effects: es } => es
    SparkServingRetirementRemedyRefused { cause: _ } => []
  }
}

// THE ROLES ARE DISJOINT AND TOTAL OVER THE TWO SPARKS.
//
// A cell holding both roles has no constructor, so this claim cannot be about that -- it is about
// the ASSIGNMENT, where the same host appearing in both rosters is still writable. It is the
// assignment, not the type, that this checks.
fn witness_provenance(host: HostIdentity) -> SparkServingObservationProvenance {
  spark_serving_observation_provenance_of(
    host: host,
    attempt: "witness-attempt" as NonEmptyStr,
    locus: "witness-locus" as NonEmptyStr,
  )
}

test fn w_spark_roles_are_disjoint_over_the_assignment() -> Bool {
  length(spark_serving_cell_hosts()) == 1
    && length(spark_training_cell_hosts()) == 1
    && any(spark_serving_cell_hosts(), h => h as String == operator_host_srv5 as String)
    && any(spark_training_cell_hosts(), h => h as String == operator_host_srv6 as String)
    && !any(spark_serving_cell_hosts(), h => h as String == operator_host_srv6 as String)
    && !any(spark_training_cell_hosts(), h => h as String == operator_host_srv5 as String)
}

// A HOST NOBODY ASSIGNED HAS NO ROLE, WHICH IS NOT A ROLE.
//
// The falsifier for a defaulting lookup: if the fold answered SparkServingCell for an unknown host,
// every machine in the fleet would be a serving cell and this goes red.
test fn w_unassigned_host_has_no_spark_role() -> Bool {
  match spark_cell_role_of(host: "srv1" as HostIdentity) {
    SparkCellRoleAbsent => true
    SparkCellRoleUnique { role: _ } => false
    SparkCellRoleAmbiguous { assignments: _ } => false
  }
}

// SERVING DESIRED STATE IS SRV5 ALONE, AND IT GOT THERE BY PROJECTION.
//
// This is the claim that goes red the moment srv6's role is reverted to SparkServingCell -- which is
// the point. Nothing here names srv6 as excluded; the roster simply is what the role authority says,
// so a role change moves it without this file being touched.
test fn w_serving_desired_hosts_are_the_serving_cells() -> Bool {
  length(spark_serving_desired_hosts) == 1
    && any(spark_serving_desired_hosts, h => h as String == operator_host_srv5 as String)
    && !any(spark_serving_desired_hosts, h => h as String == operator_host_srv6 as String)
}

// THE OFFER ROSTER EXCLUDES THE SERVING CELL, ASSERTED OVER THE ROSTER ITSELF.
//
// This asked a `spark_host_offerable_for_training` predicate, which existed only to be asked by this
// claim -- a claim whose whole subject is a function nothing else calls measures its own fixture. The
// subject that matters is the roster P3's supply module will consume, so the claim reads that: srv5
// is absent from it because it serves, srv6 is present because it trains, and an unassigned host is
// in neither roster because it is not a Spark cell.
test fn w_serving_cell_is_not_offerable_to_the_training_fabric() -> Bool {
  let trainable = spark_training_cell_hosts()
  length(trainable) == 1
    && any(trainable, h => h as String == operator_host_srv6 as String)
    && !any(trainable, h => h as String == operator_host_srv5 as String)
    && !any(trainable, h => h as String == "srv1")
    && !any(spark_serving_cell_hosts(), h => h as String == "srv1")
}

// THE FOUR SERVICE ADDRESSES RETIRE; THE THREE BASELINE ADDRESSES REFUSE.
//
// The discriminating half is the refusal, not the presence. A retirement map that answered the empty
// list for the baseline addresses -- the shape this change replaced -- would satisfy any claim that
// only asked the service addresses for their remedies, because the baseline arms would be quietly
// well-typed and empty. Asking them explicitly is what makes the old shape unable to pass.
test fn w_every_service_address_retires_with_exactly_one_operation() -> Bool {
  all(w_serving_addresses(), a =>
    match spark_serving_retirement_effects_for_address(address: a) {
      SparkServingRetirementRemedyPresent { effects: es } => length(es) == 1
      SparkServingRetirementRemedyRefused { cause: _ } => false
    })
}

test fn w_every_baseline_address_refuses_retirement() -> Bool {
  all(w_baseline_addresses(), a =>
    match spark_serving_retirement_effects_for_address(address: a) {
      SparkServingRetirementRemedyPresent { effects: _ } => false
      SparkServingRetirementRemedyRefused { cause: c } => length(c as String) > 0
    })
}

// THE REMEDIES ARE THE ONES THE HOST ACTUALLY NEEDS, EACH AT ITS OWN ADDRESS.
//
// Stop answers activity and disable answers enablement, and the pair is asserted separately in both
// directions: an implementation that stopped without disabling would leave a unit that returns at
// the next boot, and one that disabled without stopping would leave a live server holding the pool.
// Both are green under a single fused `disable --now`, which is why neither is checked by presence
// alone.
test fn w_activity_retires_by_stop_and_not_by_disable() -> Bool {
  let es = w_retirement_effects(address: SparkServingUserUnitActivityAddress)
  spark_serving_retirement_effects_include(effects: es, needle: StopUserUnit)
    && !spark_serving_retirement_effects_include(effects: es, needle: DisableUserUnit)
    && !spark_serving_retirement_effects_include(effects: es, needle: RemoveUserUnitFile)
}

test fn w_enablement_retires_by_disable_and_not_by_stop() -> Bool {
  let es = w_retirement_effects(address: SparkServingUserUnitEnablementAddress)
  spark_serving_retirement_effects_include(effects: es, needle: DisableUserUnit)
    && !spark_serving_retirement_effects_include(effects: es, needle: StopUserUnit)
}

test fn w_content_retires_by_file_removal_and_registration_by_reload() -> Bool {
  let content = w_retirement_effects(address: SparkServingUserUnitAddress)
  let registration = w_retirement_effects(address: SparkServingUserUnitRegistrationAddress)
  spark_serving_retirement_effects_include(effects: content, needle: RemoveUserUnitFile)
    && !spark_serving_retirement_effects_include(effects: content, needle: ReloadUserManagerAfterRemoval)
    && spark_serving_retirement_effects_include(effects: registration, needle: ReloadUserManagerAfterRemoval)
    && !spark_serving_retirement_effects_include(effects: registration, needle: RemoveUserUnitFile)
}

// THE SPLIT PARTITIONS THE ROSTER -- NEITHER SIDE IS EMPTY AND NOTHING IS IN BOTH.
//
// A scope function that answered one way for everything would leave one of these lists empty, and a
// retirement over it would either remove nothing or remove the cache. Both are checked because the
// two failures have opposite consequences and a single count would catch neither.
test fn w_the_address_scope_partitions_the_member_roster() -> Bool {
  let members = concat(
    map(w_serving_addresses(), a => w_member(host: operator_host_srv6, address: a)),
    map(w_baseline_addresses(), a => w_member(host: operator_host_srv6, address: a)),
  )
  let role_scoped = spark_serving_role_scoped_members(members: members)
  let baseline = spark_serving_baseline_members(members: members)
  length(role_scoped) == 4
    && length(baseline) == 3
    && length(role_scoped) + length(baseline) == length(members)
    && length(spark_serving_role_scoped_members(members: role_scoped)) == 4
    && length(spark_serving_baseline_members(members: role_scoped)) == 0
    && length(spark_serving_baseline_members(members: baseline)) == 3
    && length(spark_serving_role_scoped_members(members: baseline)) == 0
}

// THE MODEL AND THE RUNTIME SURVIVE THE RETIREMENT, AND THEY SURVIVE IT BY NOT BEING ASKED.
//
// This is the claim that keeps "retained cache" from becoming a polite word for a step that ran and
// did nothing: the baseline addresses produce no retirement remedy at all, so there is no operation
// whose failure could be swallowed and no receipt that could report a deletion as retention.
test fn w_retained_cache_is_absent_from_the_retirement_rather_than_a_no_op_within_it() -> Bool {
  all(w_baseline_addresses(), a => length(w_retirement_effects(address: a)) == 0)
    && all(w_serving_addresses(), a => length(w_retirement_effects(address: a)) == 1)
}

// THE PLAN FOR A HOST THAT STOPPED SERVING, WHICH IS THE ROW THE GATE ACTUALLY NAMES.
//
// The claims above establish that the retirement VOCABULARY exists and that each address maps to one
// operation. Neither of them establishes what a reconcile DOES when a host leaves the serving
// roster, and that is the question the empty remedy used to answer wrongly: desired loses the four
// service members, observed still has all seven, and the plan must contain four removals that
// realize to four real operations.
//
// The observed population is the full seven and the desired population is the baseline three, which
// is exactly the state srv6 enters when its role changes. Deriving desired by FILTERING observed
// through the scope split, rather than listing three members by hand, is what makes this a claim
// about the split rather than a restatement of it.
fn w_srv6_observed_members() -> List<SparkServingMember> {
  concat(
    map(w_serving_addresses(), a => w_member(host: operator_host_srv6, address: a)),
    map(w_baseline_addresses(), a => w_member(host: operator_host_srv6, address: a)),
  )
}

fn w_srv6_retirement_plan() -> MembershipPlan<SparkServingMember, SparkServingMemberAt> {
  spark_serving_membership_reconcile(
    desired: spark_serving_baseline_members(members: w_srv6_observed_members()),
    observed: w_srv6_observed_members(),
  )
}

fn w_action_is_removal(action: MemberAction<SparkServingMember, SparkServingMemberAt>) -> Bool {
  match action {
    MemberRemoved { at: _, from: _ } => true
    MemberAdded { at: _, to: _ } => false
    MemberChanged { at: _, from: _, to: _ } => false
    MemberRemovalRefused { from: _, cause: _ } => false
    MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => false
  }
}

fn w_action_retirement_effect_count(action: MemberAction<SparkServingMember, SparkServingMemberAt>) -> Int {
  match spark_serving_realization_for_member_action(action: action) {
    Absent => 0
    Present { value: r } =>
      match r {
        SparkServingMemberInstalls { effects: _ } => 0
        SparkServingMemberRetires { effects: es } => length(es)
      }
  }
}

// FOUR REMOVALS AND NOTHING ELSE. The baseline members are in both populations, so they reconcile as
// converged and emit no action at all -- which is the property that makes the retained cache safe
// without any retention effect existing.
test fn w_a_retired_host_plans_exactly_four_removals() -> Bool {
  let plan = w_srv6_retirement_plan()
  length(plan.actions) == 4
    && all(plan.actions, a => w_action_is_removal(action: a))
}

// AND EVERY ONE OF THEM REALIZES TO A REAL OPERATION. This is the claim the old `-> []` fails: under
// it every removal realized to zero effects, so this total would be 0 rather than 4.
test fn w_every_planned_removal_realizes_one_retirement_effect() -> Bool {
  let plan = w_srv6_retirement_plan()
  fold(plan.actions, init: 0, f: fn(acc, a) { acc + w_action_retirement_effect_count(action: a) }) == 4
    && all(plan.actions, a => w_action_retirement_effect_count(action: a) == 1)
}

// A HOST THAT STILL SERVES PLANS NOTHING. The same reconcile over an unchanged roster is the
// idempotence half: without it, "four removals" could be true of a plan that also proposed work on a
// converged host.
test fn w_a_host_that_still_serves_plans_no_action() -> Bool {
  let plan = spark_serving_membership_reconcile(
    desired: w_srv6_observed_members(),
    observed: w_srv6_observed_members(),
  )
  length(plan.actions) == 0
}

// THE FROZEN SCHEDULE FOR A RETIREMENT, WHICH IS THE SEAM THE VOCABULARY COULD NOT REACH.
//
// Everything above this point stops at the membership plan and its per-address remedies. The
// scheduler refused every plan containing a removal, so those four valid removals reached no frozen
// schedule, no scheduled typed actions, and no applicable plan artifact -- the retirement was
// expressible and unroutable, and no amount of host access would have repaired it.
//
// These claims are about the bridge: the plan freezes, and it freezes in the order the host can
// actually execute.
fn w_srv6_frozen_retirement() -> SparkServingScheduleVerdict {
  spark_serving_freeze_execution_schedule(
    plan: w_srv6_retirement_plan(),
    desired_addresses: flat_map(
      spark_serving_baseline_members(members: w_srv6_observed_members()),
      m => [m.address],
    ),
  )
}

fn w_frozen_order(v: SparkServingScheduleVerdict) -> List<SparkServingMemberAt> {
  match v {
    SparkServingScheduleFrozen { schedule: sch } => spark_serving_frozen_schedule_order(schedule: sch)
    SparkServingScheduleRefused { cause: _ } => []
  }
}

test fn w_a_retirement_plan_freezes_instead_of_refusing() -> Bool {
  length(w_frozen_order(v: w_srv6_frozen_retirement())) == 4
}

// THE ORDER IS THE EXECUTABLE ONE, ASSERTED POSITIONALLY -- AND ONLY WHERE A HOST FACT GROUNDS IT.
//
// Positions rather than membership, because this claim's ancestor in this file was a membership
// assertion wearing an order's name and every permutation passed it.
//
// What is asserted is a PARTIAL order, and the missing edge is the point. Stop and disable both
// precede the file removal -- disable reads the unit file, and stopping a unit whose definition is
// gone leaves a process the manager cannot name -- and the reload follows the removal. Nothing
// grounds an edge BETWEEN stop and disable: they answer independent obligations and neither reads the
// other's result, so `disable → stop → rm → reload` is equally safe. An earlier draft declared the
// total chain and this claim required `activity < enablement`, which would have rejected that
// execution for no reason a host fact could be cited for. Asserting the order the facts establish and
// not one edge more is what keeps the claim from cementing an arbitrary convention.
type WIndexScan {
  seen: Int
  found: Int
}

fn w_scan_position(
  order: List<SparkServingMemberAt>,
  address: SparkServingResourceAddress,
) -> WIndexScan {
  fold(order, init: WIndexScan { seen: 0, found: 0 - 1 }, f: fn(acc, at) {
    if string_contains(at, spark_serving_resource_address_wire(address: address)) {
      WIndexScan { seen: acc.seen + 1, found: acc.seen }
    } else {
      WIndexScan { seen: acc.seen + 1, found: acc.found }
    }
  })
}

// -1 MEANS THE ADDRESS IS NOT IN THE ORDER, and the claims below check for it rather than letting it
// compare as "earliest". A missing row silently sorting first is how an order assertion passes over a
// schedule that dropped a step.
fn w_position_of(
  order: List<SparkServingMemberAt>,
  address: SparkServingResourceAddress,
) -> Int {
  w_scan_position(order: order, address: address).found
}

test fn w_the_frozen_retirement_stops_before_it_disables_and_removes_before_it_reloads() -> Bool {
  let order = w_frozen_order(v: w_srv6_frozen_retirement())
  let activity = w_position_of(order: order, address: SparkServingUserUnitActivityAddress)
  let enablement = w_position_of(order: order, address: SparkServingUserUnitEnablementAddress)
  let content = w_position_of(order: order, address: SparkServingUserUnitAddress)
  let registration = w_position_of(order: order, address: SparkServingUserUnitRegistrationAddress)
  activity >= 0
    && enablement >= 0
    && content >= 0
    && registration >= 0
    && activity < content
    && enablement < content
    && content < registration
}

// A PLAN CARRYING BOTH DIRECTIONS STILL REFUSES, and this is the arm that keeps the new scheduling
// from being a widening. The forward and teardown chains touch the same four addresses from opposite
// ends; composing them is a third relation nobody has modeled, so it stops the line.
test fn w_a_plan_mixing_installs_and_removals_refuses() -> Bool {
  let mixed = spark_serving_membership_reconcile(
    desired: concat(
      spark_serving_baseline_members(members: w_srv6_observed_members()),
      [w_member(host: operator_host_srv6, address: SparkServingUserUnitActivityAddress)],
    ),
    observed: spark_serving_role_scoped_members(members: w_srv6_observed_members()),
  )
  match spark_serving_freeze_execution_schedule(
    plan: mixed,
    desired_addresses: flat_map(w_srv6_observed_members(), m => [m.address]),
  ) {
    SparkServingScheduleRefused { cause: c } => length(c) > 0
    SparkServingScheduleFrozen { schedule: _ } => false
  }
}

// THE PRODUCTION JOIN, WHICH IS WHAT THE FIXTURE CLAIMS ABOVE DO NOT REACH.
//
// Every claim before this one builds its membership plan by filtering a fixture through the scope
// split. That proves the split and proves nothing about the planner, which built the full seven-member
// desired state for any host handed to it and never consulted the role authority at all. Two
// production paths existed and neither retired anything: iterate the desired-serving hosts and srv6
// is absent from the loop, so no retirement is planned; or call the planner for srv6 and it restores
// serving on the machine that was supposed to stop.
fn w_release() -> SparkServingRelease {
  SparkServingRelease {
    runtime: RuntimeArtifactIdentity { closure_digest: "w-closure" },
    model: spark_serving_desired_model_artifact(),
  }
}

fn w_occurrence(host: HostIdentity) -> SparkServingOccurrence {
  SparkServingOccurrence {
    host: host,
    release_identity: spark_serving_release_identity(spec: w_release()),
    launch_profile: spark_serving_desired_launch_profile(),
  }
}

fn w_role_scoped_count(host: HostIdentity) -> Int {
  match spark_serving_role_scoped_desired_members(
    occurrence: w_occurrence(host: host),
    serving_release: w_release(),
  ) {
    SparkServingRoleScopedDesiredReady { members: ms } => length(ms)
    SparkServingRoleScopedDesiredRefused { cause: _ } => 0 - 1
  }
}

// THE TRAINING CELL'S DESIRED STATE IS THE BASELINE ALONE, FROM THE ROLE.
//
// Seven for the serving cell, three for the training cell, and the difference is the four service
// members whose removal the teardown schedule orders. Both counts are asserted because a planner that
// returned baseline for EVERY host would satisfy a claim that only checked srv6.
test fn w_the_planner_scopes_desired_state_by_role() -> Bool {
  w_role_scoped_count(host: operator_host_srv5) == 7
    && w_role_scoped_count(host: operator_host_srv6) == 3
}

// A HOST NOBODY ASSIGNED REFUSES RATHER THAN DEFAULTING TO SERVING. This planner is reachable with
// any HostIdentity, and answering "full serving desired state" for an unassigned machine is how a
// convergence installs a model server on the wrong box.
test fn w_the_planner_refuses_a_host_with_no_spark_role() -> Bool {
  w_role_scoped_count(host: "srv1" as HostIdentity) == 0 - 1
}

// ── THE PRODUCTION ROOT, WHICH IS WHERE THE EVIDENCE HAD STOPPED SHORT ──────────────────────────
//
// Every claim above enters through a helper: the role-scoped desired members, the reconcile, the
// freeze. Each is a real production function, and together they are not the production path -- a
// regression that pointed `spark_serving_full_membership_plan` back at the unscoped
// `spark_serving_desired_members` would leave all of them green, because none of them is what the
// converge actuator calls. `spark_serving_fleet_converge_plan_artifact` is, so the closing claim
// enters there and reads the frozen artifact back.
fn w_complete_store() -> ModelStoreObservation {
  match spark_serving_desired_admission {
    SparkServingDesiredRefused { cause: _ } =>
      ModelStoreObservationRefused { cause: "w: no admitted release" as NonEmptyStr }
    SparkServingDesiredAdmitted { serving_release: r } =>
      ModelStoreComplete {
        manifest_identity: serialize_content_hash(hash: r.model.identity) as NonEmptyStr,
        blob_closure_count: 1,
      }
  }
}

fn w_observed_serving_projection(host: HostIdentity) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(
    provenance: witness_provenance(host: host),
    host: host,
    runtime: RuntimeMaterializationComplete {
      identity: ollama_runtime_materialization_identity_for_required_release(),
    },
    store: w_complete_store(),
    unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
    enablement: UserUnitManagerEnabled,
    activity: UnitActivityRunning,
    linger: LingerObservedEnabled,
  )
}

fn w_artifact(host: HostIdentity) -> SparkServingPlanArtifactVerdict {
  spark_serving_fleet_converge_plan_artifact(
    host: host as NonEmptyStr,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    projection: w_observed_serving_projection(host: host),
  )
}

fn w_artifact_rows(host: HostIdentity) -> List<FleetConvergeSparkServingTypedAction> {
  match w_artifact(host: host) {
    SparkServingPlanArtifactReady { artifact: a } => scheduled_rows_list(scheduled: a.spark_serving_typed_actions)
    SparkServingPlanArtifactRefused { cause: _ } => []
  }
}

fn w_row_is_retirement(row: FleetConvergeSparkServingTypedAction) -> Bool {
  w_action_is_removal(action: row.action)
    && length(fleet_converge_spark_serving_row_effects(row: row)) > 0
    && all(fleet_converge_spark_serving_row_effects(row: row), e =>
      match e {
        PlannedRetirementEffect { retirement: _ } => true
        PlannedInstallEffect { install: _ } => false
      })
}

// A FULLY SERVING TRAINING CELL PLANS FOUR RETIREMENTS THROUGH THE PRODUCTION ROOT.
//
// The observation handed in is a host serving perfectly: runtime materialized, model held, unit
// present and enabled and RUNNING, linger on. Under the pre-role planner this input produced zero
// rows -- it is exactly the desired seven-member serving state -- so this claim is red on the old
// production path for the right reason, rather than red because the fixture was rebuilt.
test fn w_the_production_artifact_plans_four_retirements_for_the_training_cell() -> Bool {
  let rows = w_artifact_rows(host: operator_host_srv6)
  length(rows) == 4 && all(rows, r => w_row_is_retirement(row: r))
}

// AND THE SERVING CELL IN THE SAME STATE PLANS NOTHING. Without this, "four rows" could be true of a
// planner that retires every host it is handed.
test fn w_the_production_artifact_plans_no_rows_for_the_converged_serving_cell() -> Bool {
  length(w_artifact_rows(host: operator_host_srv5)) == 0
}

// THE RETAINED CACHE IS ABSENT FROM THE PRODUCTION ROWS, not merely from the fixture reconcile.
test fn w_the_production_retirement_touches_no_baseline_address() -> Bool {
  let rows = w_artifact_rows(host: operator_host_srv6)
  length(rows) == 4
    && !any(rows, r => string_contains(
        fleet_converge_spark_serving_action_at(action: r.action),
        spark_serving_resource_address_wire(address: SparkServingRuntimeRootAddress)))
    && !any(rows, r => string_contains(
        fleet_converge_spark_serving_action_at(action: r.action),
        spark_serving_resource_address_wire(address: SparkServingLingerAddress)))
}

// A HOST WITH NO ROLE REFUSES AT THE PRODUCTION ROOT.
//
// This is the claim that now exercises the role authority rather than the hardcoded srv5-or-srv6
// predicate that used to answer first and would have rejected a newly assigned Spark cell.
test fn w_the_production_artifact_refuses_a_host_with_no_role() -> Bool {
  match w_artifact(host: "srv1" as HostIdentity) {
    SparkServingPlanArtifactRefused { cause: c } => string_contains(c, "no Spark cell role")
    SparkServingPlanArtifactReady { artifact: _ } => false
  }
}

// A PLAN OF REFUSALS IS NOT AN EMPTY PLAN, AND IT NEVER FREEZES.
//
// A plan whose only actions are refusals classified as EMPTY, projected to zero rows, and froze --
// a schedule saying "nothing to do" about a reconcile that said "I could not answer". Both refusal
// actions are checked, because they are produced by different arms of the reconcile.
fn w_freeze_of(plan: MembershipPlan<SparkServingMember, SparkServingMemberAt>) -> SparkServingScheduleVerdict {
  spark_serving_freeze_execution_schedule(plan: plan, desired_addresses: [])
}

fn w_refuses(v: SparkServingScheduleVerdict) -> Bool {
  match v {
    SparkServingScheduleRefused { cause: c } => length(c) > 0
    SparkServingScheduleFrozen { schedule: _ } => false
  }
}

test fn w_a_plan_carrying_only_refusals_refuses_instead_of_freezing_empty() -> Bool {
  let removal_refused = MembershipPlan {
    actions: [
      MemberRemovalRefused {
        from: w_member(host: operator_host_srv6, address: SparkServingRuntimeRootAddress),
        cause: "w-refusal" as NonEmptyStr,
      },
    ],
  }
  let duplicate_refused = MembershipPlan {
    actions: [
      MemberRosterDuplicateKeyRefused {
        roster: "desired" as NonEmptyStr,
        first: w_member(host: operator_host_srv6, address: SparkServingLingerAddress),
        duplicate: w_member(host: operator_host_srv6, address: SparkServingLingerAddress),
      },
    ],
  }
  w_refuses(v: w_freeze_of(plan: removal_refused))
    && w_refuses(v: w_freeze_of(plan: duplicate_refused))
}

// ── THE APPLY READBACK, BECAUSE FOUR ROWS ON THE ARTIFACT IS NOT FOUR OPERATIONS ON THE HOST ─────
//
// The artifact claims above establish that the planner freezes four retirement rows. They do not
// establish that the consumer which APPLIES frozen rows handles the retirement arm: apply reads the
// operations the plan already realized into each row, so a retirement effect that realized to no
// command would arrive here as four effects and zero steps -- reporting a retirement applied while
// executing nothing, which is the fail-open the freeze exists to shut. So the claim continues
// through the real apply reader and counts what it would actually run.
fn w_retirement_apply(host: HostIdentity) -> SparkServingFrozenApplyResult {
  match w_artifact(host: host) {
    SparkServingPlanArtifactRefused { cause: c } =>
      SparkServingFrozenApplyRefused { reason: c }
    SparkServingPlanArtifactReady { artifact: a } =>
      match fleet_converge_plan_artifact_hash(artifact: a) {
        Absent => SparkServingFrozenApplyRefused { reason: "w: artifact carries no bundle hash" }
        Present { value: hex } =>
          spark_serving_apply_reads_frozen_typed_rows(artifact: a, claimed_bundle_hex: hex as String)
      }
  }
}

fn w_retirement_apply_argv() -> List<List<String>> {
  match w_retirement_apply(host: operator_host_srv6) {
    SparkServingFrozenApplyRefused { reason: _ } => []
    SparkServingFrozenApplied { remote_steps: sts, effect_count: _ } =>
      remote_operations_argv_only(operations: map(sts, st => st.operation))
  }
}

fn w_argv_position_of(argvs: List<List<String>>, needle: String) -> Int {
  fold(argvs, init: WIndexScan { seen: 0, found: 0 - 1 }, f: fn(acc, argv) {
    if any(argv, word => word == needle) {
      WIndexScan { seen: acc.seen + 1, found: acc.seen }
    } else {
      WIndexScan { seen: acc.seen + 1, found: acc.found }
    }
  }).found
}

// FOUR EFFECTS AND FOUR EXECUTABLE STEPS, not four effects and a silent nothing.
test fn w_the_frozen_retirement_applies_as_four_real_operations() -> Bool {
  match w_retirement_apply(host: operator_host_srv6) {
    SparkServingFrozenApplyRefused { reason: _ } => false
    SparkServingFrozenApplied { remote_steps: sts, effect_count: n } =>
      n == 4 && length(remote_operations_argv_only(operations: map(sts, st => st.operation))) == 4
  }
}

// AND THE ORDER SURVIVES THE ROUND TRIP TO ARGV, which the artifact-row claim cannot see: the rows
// are frozen in schedule order, and this is the evidence that apply preserves it rather than
// re-deriving or reordering. Both grounded precedences are asserted; the stop/disable pair is not,
// because the partial order does not decide it.
test fn w_the_applied_retirement_stops_and_disables_before_it_removes_and_removes_before_it_reloads() -> Bool {
  let argvs = w_retirement_apply_argv()
  let stop = w_argv_position_of(argvs: argvs, needle: "stop")
  let disable = w_argv_position_of(argvs: argvs, needle: "disable")
  let remove = w_argv_position_of(argvs: argvs, needle: "rm")
  let reload = w_argv_position_of(argvs: argvs, needle: "daemon-reload")
  length(argvs) == 4
    && stop >= 0 && disable >= 0 && remove >= 0 && reload >= 0
    && stop < remove
    && disable < remove
    && remove < reload
}

// AND NOT ONE OPERATION TOUCHES THE RETAINED CACHE. The model blob and the runtime closure are the
// bytes P1 and the training runs both depend on; an `ollama rm` or a runtime deletion reaching the
// host would be the retirement destroying what it was explicitly scoped to keep.
test fn w_the_applied_retirement_runs_no_operation_against_the_retained_cache() -> Bool {
  let argvs = w_retirement_apply_argv()
  length(argvs) == 4
    && !any(argvs, argv => any(argv, w => w == "ollama"))
    && !any(argvs, argv => any(argv, w => w == "loginctl"))
}
