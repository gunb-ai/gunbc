module test.claim.spark.managed_access_apply_repoint_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import gunbc.managed_principal_provider {
  ManagedProviderOutcome, ProviderRealized, ProviderRefused, ProviderUnattempted,
  ManagedAccountProvider, ManagedAuthorizedKeyProvider,
}
import gunbc.spark.managed_access_apply {
  SparkApplyOutcome, ApplyConverged, ApplyRefused, ApplyUnattempted,
  apply_converged, apply_outcome_label,
  third_line_triple, account_readback_of, key_readback_of,
  provider_outcome_as_apply, readback_unread_sentinel,
  readback_no_match_marker, readback_unreadable_marker,
  readback_file_absent_marker, readback_search_error_marker,
  AuthorizedKeyLineOutcome, KeyLineObserved, KeyLineNoMatchInReadFile,
  KeyLineFileEstablishedAbsent, KeyLineContentUnreadable, KeyLineOutcomeUnobtained,
  decode_authorized_key_line, key_line_permits_install, key_line_outcome_text,
}
import gunbc.managed_principal_session { PosixAccountReadback, AuthorizedKeyReadback }

// ── THE PRODUCT ROOT'S OWN SEAMS ──────────────────────────────────────────────────────────────
//
// THIS FILE EXISTS SO THAT REVERTING THE REPOINT BREAKS SOMETHING. The four hand-sequenced legs that used to be
// gunbc.spark.managed_access_apply's body are gone, and what replaced them is a chain of provider terminals plus
// three seams: the readback parse, the sentinel for an unparseable read, and the projection of a provider
// outcome into the receipt's vocabulary. Deleting the provider path would leave these functions with no
// consumer and this module unresolvable -- which is the red the ruling asked for, expressed at the grain the
// apply's pure half can actually be executed at.
//
// THE WET FUNCTION ITSELF IS NOT CALLED HERE, deliberately: it opens ssh sessions. What is asserted is every
// decision the repoint introduced that does NOT need a host, which is where the structural change lives.

// ── THE READBACK PARSE ────────────────────────────────────────────────────────────────────────
//
// THREE LINES, BY POSITION, AND A SHORT OUTPUT PRODUCES NOTHING. A truncated or warning-prefixed stdout must
// not become a readback with empty fields: an empty observed owner would compare unequal to the principal and
// surface as a refusal ABOUT OWNERSHIP, sending a reader to the wrong place entirely.
test fn a_three_line_output_parses_by_position() -> Bool {
  match third_line_triple(stdout: "gunbc-automation\n/home/gunbc-automation\n/bin/bash\n") {
    Present { value: t } => count(t) == 3
    Absent => false
  }
}

test fn a_two_line_output_produces_no_triple() -> Bool {
  match third_line_triple(stdout: "gunbc-automation\n/home/gunbc-automation\n") {
    Absent => true
    Present { value: _ } => false
  }
}

// AND BLANK LINES ARE NOT FIELDS, so a script whose output is padded still parses to the three values it
// printed rather than to blanks that would compare unequal.
test fn blank_lines_are_not_counted_as_fields() -> Bool {
  match third_line_triple(stdout: "\ngunbc-automation\n\n/home/gunbc-automation\n/bin/bash\n\n") {
    Present { value: t } => count(t) == 3
    Absent => false
  }
}

// ── THE SENTINEL IS A LOCATED WORD, NOT AN EMPTY STRING ───────────────────────────────────────
//
// THE DISTINCTION THAT DECIDES WHICH REFUSAL A READER SEES. On a refused or unattempted leg there is no
// readback at all, and the fields say so; an empty string would be compared against the expected principal and
// reported as a mismatch, which describes a host that is fine.
test fn a_refused_leg_yields_an_unread_account_readback() -> Bool {
  let rb = account_readback_of(outcome: ApplyRefused { cause: "the account script exited 1" })
  (rb.observed_principal as String) == (readback_unread_sentinel as String)
    && (rb.observed_home as String) == (readback_unread_sentinel as String)
}

test fn an_unattempted_leg_yields_an_unread_key_readback() -> Bool {
  let rb = key_readback_of(outcome: ApplyUnattempted { blocked_by: "managed-posix-account-upsert" })
  (rb.observed_line as String) == (readback_unread_sentinel as String)
    && (rb.observed_mode as String) == (readback_unread_sentinel as String)
}

// AND A CONVERGED LEG WHOSE STDOUT IS UNPARSEABLE ALSO YIELDS THE SENTINEL, which is the case a positive exit
// status would otherwise carry into an admission as three empty fields.
test fn a_converged_leg_with_unparseable_stdout_yields_the_sentinel() -> Bool {
  let rb = account_readback_of(outcome: ApplyConverged { detail: "only one line" })
  (rb.observed_principal as String) == (readback_unread_sentinel as String)
}

// AND A CONVERGED LEG WITH A REAL THREE-LINE READ CARRIES THE VALUES, so the rows above are not passing because
// the extractor always returns the sentinel.
test fn a_converged_leg_with_three_lines_carries_the_observed_values() -> Bool {
  let rb = account_readback_of(outcome: ApplyConverged { detail: "gunbc-automation\n/home/gunbc-automation\n/bin/bash\n" })
  (rb.observed_principal as String) == "gunbc-automation"
    && (rb.observed_home as String) == "/home/gunbc-automation"
    && (rb.observed_shell as String) == "/bin/bash"
}

// ── THE PROJECTION PRESERVES UNATTEMPTED ──────────────────────────────────────────────────────
//
// THE ROW THAT WOULD UNDO THE WHOLE REPOINT AT ITS LAST STEP. The receipt is what a person reads, so collapsing
// an unattempted provider into a refusal here would put four failures back in front of a reader who has one
// cause and three consequences.
test fn an_unattempted_provider_projects_to_an_unattempted_step() -> Bool {
  match provider_outcome_as_apply(o: ProviderUnattempted { kind: ManagedAuthorizedKeyProvider, blocked_by: ManagedAccountProvider }) {
    ApplyUnattempted { blocked_by: b } => b == "managed-posix-account-upsert"
    ApplyConverged { detail: _ } => false
    ApplyRefused { cause: _ } => false
  }
}

test fn a_refused_provider_projects_to_a_refused_step() -> Bool {
  match provider_outcome_as_apply(o: ProviderRefused { kind: ManagedAccountProvider, cause: "the readback disagrees" as NonEmptyStr }) {
    ApplyRefused { cause: c } => c == "the readback disagrees"
    ApplyConverged { detail: _ } => false
    ApplyUnattempted { blocked_by: _ } => false
  }
}

test fn a_realized_provider_projects_to_a_converged_step() -> Bool {
  match provider_outcome_as_apply(o: ProviderRealized { kind: ManagedAccountProvider, detail: "the host reports it" as NonEmptyStr }) {
    ApplyConverged { detail: d } => d == "the host reports it"
    ApplyRefused { cause: _ } => false
    ApplyUnattempted { blocked_by: _ } => false
  }
}

// ── AND AN UNATTEMPTED STEP IS NOT A PRECONDITION FOR THE NEXT ONE ────────────────────────────
//
// THE FOLD'S TEMPTING WRONG ANSWER. `apply_converged` decides whether a leg licenses the leg after it, and the
// shape an author reaches for is "it did not fail, so carry on" -- which is how a chain that never ran reports
// success and resumes in the middle.
test fn an_unattempted_step_does_not_license_the_next_leg() -> Bool {
  !apply_converged(o: ApplyUnattempted { blocked_by: "managed-posix-account-upsert" })
    && !apply_converged(o: ApplyRefused { cause: "x" })
    && apply_converged(o: ApplyConverged { detail: "y" })
}

// AND THE RECEIPT LABEL SAYS UNATTEMPTED WITHOUT SAYING REFUSED, because a reader scanning four lines must see
// one cause rather than four problems.
test fn the_receipt_label_distinguishes_unattempted_from_refused() -> Bool {
  let label = apply_outcome_label(outcome: ApplyUnattempted { blocked_by: "create-managed-account" })
  string_contains(s: label, pattern: "unattempted")
    && string_contains(s: label, pattern: "create-managed-account")
    && !string_contains(s: label, pattern: "REFUSED")
}

// ── CARDINALITY AND PRESENCE PRESERVATION, AT THE DECISION RATHER THAN AT THE DECODER ──────────
//
// EVERY ROW BELOW ASSERTS THE NEXT ACTION, not that a decoder returned a named arm. A mutation that collapsed
// unreadable into empty must make the INSTALL DECISION wrong and turn a row red; and the legitimate empty and
// absent cases must stay usable, so a blanket refusal cannot satisfy the set.
//
// THE RULE THESE INHABIT: zero members inside an existing thing is not zero occurrences of that thing, and
// neither is "we do not know". Its conformance row is `conformance-cardinality` in gunbc.design_argument.

// ── PAIR 1: OBSERVATION AVAILABILITY ──────────────────────────────────────────────────────────
//
// No usable read versus a completed search that found nothing. The first establishes nothing in either
// direction; the second is ordinary work. An install decision that treated them alike would append to a file it
// never read.
test fn an_unobtained_readback_does_not_permit_an_install() -> Bool {
  !key_line_permits_install(o: decode_authorized_key_line(line: readback_unread_sentinel))
}

test fn a_completed_search_finding_nothing_does_permit_an_install() -> Bool {
  key_line_permits_install(o: decode_authorized_key_line(line: readback_no_match_marker))
}

// ── PAIR 2: RESOURCE PRESENCE ─────────────────────────────────────────────────────────────────
//
// AN ESTABLISHED MISSING FILE VERSUS AN EXISTING FILE WE COULD NOT READ, and this is the pair a `[ ! -r ]`
// precheck got wrong in the dangerous direction: `-r` is false for a missing file too, so a fresh account's
// absent authorized_keys routed into the unreadable arm and WITHHELD -- meaning first installation could never
// proceed. Absence is an ordinary materialization requirement; unread content is not.
test fn an_established_absent_file_permits_creation() -> Bool {
  key_line_permits_install(o: decode_authorized_key_line(line: readback_file_absent_marker))
}

test fn an_existing_unreadable_file_withholds_mutation() -> Bool {
  !key_line_permits_install(o: decode_authorized_key_line(line: readback_unreadable_marker))
}

// AND THE TWO DECODE TO DIFFERENT ARMS, so the shared install verdict in pair 1 is not what makes them
// distinguishable -- a reader deciding whether to investigate permissions needs to know which one happened.
test fn absence_and_unreadability_are_different_outcomes() -> Bool {
  match decode_authorized_key_line(line: readback_file_absent_marker) {
    KeyLineFileEstablishedAbsent =>
      match decode_authorized_key_line(line: readback_unreadable_marker) {
        KeyLineContentUnreadable => true
        _ => false
      }
    _ => false
  }
}

// ── PAIR 3: FAILURE VERSUS NEGATIVE RESULT ────────────────────────────────────────────────────
//
// A SEARCH THAT ERRORED IS NOT A SEARCH THAT FOUND NOTHING. grep exits 1 for "no lines selected" and greater
// than 1 for an error; inferring a negative result from empty stdout would let a genuine read failure license an
// append. The script decodes the exit status, and this row asserts the consequence.
test fn a_failed_search_withholds_while_a_negative_search_proceeds() -> Bool {
  !key_line_permits_install(o: decode_authorized_key_line(line: readback_search_error_marker))
    && key_line_permits_install(o: decode_authorized_key_line(line: readback_no_match_marker))
}

// ── PAIR 4: MEMBERSHIP ────────────────────────────────────────────────────────────────────────
//
// AN OBSERVED LINE IS NOT AN INSTALL OPPORTUNITY. The key is already there, so proceeding would append a
// duplicate -- which `grep -qxF ||` happens to prevent today and which the DECISION must prevent regardless of
// what the script's idempotence buys.
test fn an_observed_line_does_not_permit_another_install() -> Bool {
  !key_line_permits_install(o: decode_authorized_key_line(line: "ssh-ed25519 AAAAREALKEYMATERIAL fleet-automation" as NonEmptyStr))
}

// ── PAIR 5: WHAT A NO-MATCH DOES AND DOES NOT CLAIM ───────────────────────────────────────────
//
// THE LIMITATION IS ASSERTED RATHER THAN PAPERED OVER. A file holding five unrelated keys and a genuinely empty
// file both yield no match for ours, so this readback CANNOT distinguish full-population cardinality -- and the
// honest control is one that says so, because the alternative is a row implying coverage the instrument does not
// have. The outcome text carries the disclaimer, and a future revision that starts claiming population
// knowledge must change this row deliberately.
test fn a_no_match_says_nothing_about_the_rest_of_the_file() -> Bool {
  string_contains(
    s: key_line_outcome_text(o: decode_authorized_key_line(line: readback_no_match_marker)),
    pattern: "says nothing about what else the file holds")
}

// AND THE MARKERS ARE DECODED AT ONE BOUNDARY, so no consumer compares sentinel text as a domain fact. This
// asserts the decoder is total over the markers it declares: a marker that fell through to KeyLineObserved would
// be read as a real key line, which is the sentinel-as-fact tell named in the conformance row.
test fn every_declared_marker_decodes_to_a_non_observed_outcome() -> Bool {
  let markers = [readback_unread_sentinel, readback_no_match_marker, readback_unreadable_marker, readback_file_absent_marker, readback_search_error_marker]
  all(markers, m => match decode_authorized_key_line(line: m) {
    KeyLineObserved { line: _ } => false
    KeyLineNoMatchInReadFile => true
    KeyLineFileEstablishedAbsent => true
    KeyLineContentUnreadable => true
    KeyLineOutcomeUnobtained => true
  })
}
