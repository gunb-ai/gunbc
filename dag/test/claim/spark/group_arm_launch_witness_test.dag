// ── THE STAIRCASE IS A CLOSED SET, AND EVERY STEP KEEPS THE COLD FLOOR ────────────────────────────

// EVERY STEP'S WIRE PARSES BACK TO THAT STEP, AND A NUMBER OFF THE STAIRCASE HAS NO SPELLING.
test fn w_every_staircase_step_round_trips_and_an_off_staircase_word_is_no_step() -> Bool {
  all(glm53_staircase_steps, s => match glm53_step_of_wire(word: glm53_step_wire(s: s) as String) {
    Present { value: back } => (glm53_step_wire(s: back) as String) == (glm53_step_wire(s: s) as String)
    Absent => false
  })
    && length(glm53_staircase_steps) == 11
    && match glm53_step_of_wire(word: "fp8-10") { Present { value: _ } => false  Absent => true }
    && match glm53_step_of_wire(word: "nvfp4-12") { Present { value: _ } => false  Absent => true }
}

// EVERY STEP DERIVES A PROFILE WHOSE COLD FLOOR IS 8 x 262144 AND WHOSE CEILING IS THE STEP'S, WITH THE
// FULL-INPUT GATE AND THE WATERMARK STATED -- the profile the launch renders, not a second row.
test fn w_every_step_keeps_the_cold_floor_and_carries_its_own_ceiling() -> Bool {
  all(glm53_staircase_steps, s => match glm53_step_profile(s: s) {
    Absent => false
    Present { value: p } =>
      p.guaranteed_cold_seqs == 8
        && p.max_num_seqs == glm53_step_ceiling(s: s)
        && p.max_model_len == token_count(count: 262144)
        && match p.scheduler_admission.full_input_admission { FullInputAdmissionExplicit { enabled: e } => e  FullInputAdmissionOmitted => false }
        && match p.scheduler_admission.kv_watermark { KvWatermarkExplicit { fraction: _ } => true  KvWatermarkOmitted => false }
  })
}

// THE DISCRIMINATING RED FOR THE ENVELOPE: a ceiling below the floor refuses, and so does one above it
// without the gate -- through the same scheduler_envelope every step derives from.
test fn w_a_ceiling_below_the_floor_or_above_it_ungated_has_no_envelope() -> Bool {
  match glm53_staircase_cold_intent() {
    Absent => false
    Present { value: cold } => {
      let below = scheduler_envelope(cold: cold, hard_max_num_seqs: 6, admission: glm53_staircase_scheduler_admission)
      let ungated = scheduler_envelope(cold: cold, hard_max_num_seqs: 16, admission: VllmSchedulerAdmissionRequest {
        full_input_admission: FullInputAdmissionExplicit { enabled: false },
        kv_watermark: KvWatermarkExplicit { fraction: basis_point(count: 0) },
      })
      let ok = scheduler_envelope(cold: cold, hard_max_num_seqs: 16, admission: glm53_staircase_scheduler_admission)
      match below { SchedulerEnvelopeAdmitted { envelope: _ } => false  SchedulerEnvelopeRefused { cause: _ } => true }
        && match ungated { SchedulerEnvelopeAdmitted { envelope: _ } => false  SchedulerEnvelopeRefused { cause: _ } => true }
        && match ok { SchedulerEnvelopeAdmitted { envelope: _ } => true  SchedulerEnvelopeRefused { cause: _ } => false }
    }
  }
}

// THE STEP SELECTS ITS CHECKPOINT'S POLICY: the NVFP4 steps launch the NVIDIA checkpoint, the FP8 steps
// the native one, and the profile carries it.
test fn w_each_step_launches_its_own_checkpoint() -> Bool {
  match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats8 }) {
    Absent => false
    Present { value: f } => match glm53_step_inputs(s: Glm53Nvfp4Step { step: Nvfp4Seats32 }) {
      Absent => false
      Present { value: n } =>
        f.profile.checkpoint == f.assignment.checkpoint
          && n.profile.checkpoint == n.assignment.checkpoint
          && f.assignment.checkpoint != n.assignment.checkpoint
          && n.profile.max_num_seqs == 32
    }
  }
}

// ── THE GLM STEP TAKES THE ONE PATH (the pairing obligation) ─────────────────────────────────────
//
// The FP8 eight-seat step's REAL inputs through the REAL planner (group_arm_launch_plan: the arm wall,
// the memory wall under the bounded-experiment intent, the roster) -- nothing about the plan is
// supplied. Only the authority and the occupancy are, at the admission's interface, because the live
// log and the hosts are on the fleet. The route is asserted: four rank lines at the step's ceiling over
// its floor, and an admission that ADMITS on Group A released to the fleet, because the committed
// standing grant covers an arm launch on all four hosts and the produced runtime gives a keyed
// successor. The live entry (mode spark_arm_group_launch_plan) is the same fold with the authority read.
fn w_released(h: ContentHash) -> PairServingGroupAuthority {
  ReleasedToFleet { group: FabricGroupA, release_receipt: h }
}

fn w_vacant_a() -> List<GroupArmHostOccupancy> {
  map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, own_fence: ArmOwnFenceAbsent, admission: HostUnoccupied { available: kibibyte(count: 120000000) } })
}

test fn w_the_glm_fp8_eight_seat_step_takes_the_one_path_and_admits_on_the_released_group() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats8 }) {
      Absent => false
      Present { value: i } => match group_arm_launch_plan(inputs: i) {
        GroupArmLaunchRefused { causes: _ } => false
        GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: _ } => {
          let a = group_arm_launch_admission(
            group: FabricGroupA, purpose: i.purpose, plan: GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: "witness" as NonEmptyStr },
            authority: Present { value: w_released(h: ck) },
            successor: group_arm_row_successor(inputs: i), arm_causes: [],
            held: fabric_group_hosts(g: FabricGroupA), occupancy: w_vacant_a(),
            incumbent: NoIncumbentDeclared, grant_row: StandingGrantRowOnMain)
          let off_main = group_arm_launch_admission(
            group: FabricGroupA, purpose: i.purpose, plan: GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: "witness" as NonEmptyStr },
            authority: Present { value: w_released(h: ck) },
            successor: group_arm_row_successor(inputs: i), arm_causes: [],
            held: fabric_group_hosts(g: FabricGroupA), occupancy: w_vacant_a(),
            incumbent: NoIncumbentDeclared, grant_row: StandingGrantRowNotOnMain { cause: "witness: the row differs from origin/main's" })
          w_refused_with(a: off_main, fragment: "the standing grant is not honored")
            && length(ls) == 4 && prof.max_num_seqs == 8 && prof.guaranteed_cold_seqs == 8
            && (match a { GroupArmLaunchAdmitted => true  GroupArmLaunchAdmittedForAdoptionOnly { hosts: _ } => false  GroupArmLaunchAdmissionRefused { causes: _ } => false })
        }
      }
    }
  })
}

// A RELEASED GROUP REFUSES A LAUNCH THE GRANT DOES NOT COVER (ruling of valiant-crab-775, 2026-10-03):
// one host outside the grant's roster is enough, and a group the grant does not name refuses whatever
// its hosts. The positive control is the grant's own four hosts. Then the same refusal on the admission
// route: the real V4.1 plan, whose hosts are Group A's, admitted under Group B's release refuses by the
// grant cause (and by the host wall), never admits.
test fn w_a_released_group_refuses_a_launch_the_grant_does_not_cover() -> Bool {
  let a_hosts = fabric_group_hosts(g: FabricGroupA)
  length(group_arm_released_launch_causes(group: FabricGroupA, hosts: a_hosts, grant_row: StandingGrantRowOnMain)) == 0
    && length(group_arm_released_launch_causes(group: FabricGroupA, hosts: concat(a_hosts, ["srv9" as HostIdentity]), grant_row: StandingGrantRowOnMain)) == 1
    && length(group_arm_released_launch_causes(group: FabricGroupB, hosts: fabric_group_hosts(g: FabricGroupB), grant_row: StandingGrantRowOnMain)) == 1
    && length(group_arm_released_launch_causes(group: FabricGroupA, hosts: [] as List<HostIdentity>, grant_row: StandingGrantRowOnMain)) == 1
    && with_w_plan(f: fn(p, rk, ck) {
      w_refused_with(a: group_arm_launch_admission(
          group: FabricGroupB, purpose: "witness" as NonEmptyStr, plan: v41_arm_plan(p: p),
          authority: Present { value: ReleasedToFleet { group: FabricGroupB, release_receipt: ck } },
          successor: ArmSuccessorKeyed { key: ck }, arm_causes: [],
          held: fabric_group_hosts(g: FabricGroupB), occupancy: w_vacant_a(), incumbent: NoIncumbentDeclared, grant_row: StandingGrantRowOnMain),
        fragment: "no standing grant covers an arm launch")
    })
}

// THE STAIRCASE'S RUNTIME IS KEYED: the Group A production is pinned by its configuration digest, so
// every step derives a successor key, and two steps on different checkpoints derive different keys.
test fn w_the_produced_runtime_keys_every_step() -> Bool {
  match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats24 }) {
    Absent => false
    Present { value: f } => match glm53_step_inputs(s: Glm53Nvfp4Step { step: Nvfp4Seats8 }) {
      Absent => false
      Present { value: n } => match group_arm_row_successor(inputs: f) {
        ArmSuccessorUnkeyed { causes: _ } => false
        ArmSuccessorKeyed { key: kf } => match group_arm_row_successor(inputs: n) {
          ArmSuccessorUnkeyed { causes: _ } => false
          ArmSuccessorKeyed { key: kn } => !content_hash_equal(left: kf, right: kn)
        }
      }
    }
  }
}

// ── THE DECLARED INCUMBENT (ruling of valiant-crab-775, 2026-10-02) ─────────────────────────────
//
// THE PLAN IS THE V4.1 FIXTURE'S, AS THE ONE PATH'S PLAN: four real rank lines over Group A, which is
// all these claims need -- the incumbent conjuncts are about hosts and units, not about the arm.

fn w_admit(p: GroupArmLaunchPlan, ck: ContentHash, occupancy: List<GroupArmHostOccupancy>, incumbent: ArmDeclaredIncumbent) -> GroupArmLaunchAdmission {
  group_arm_launch_admission(
    group: FabricGroupA, purpose: "the witness launch" as NonEmptyStr, plan: p,
    authority: Present { value: w_suspended_for(successor: ck, stale: false) },
    successor: ArmSuccessorKeyed { key: ck }, arm_causes: [],
    held: fabric_group_hosts(g: FabricGroupA), occupancy: occupancy, incumbent: incumbent, grant_row: StandingGrantRowNotOnMain { cause: "witness: a suspension, so the grant is not read" })
}

data w_old_unit: NonEmptyStr = "gunbc-spark-pair-head.service" as NonEmptyStr

fn w_incumbent_on(hosts: List<HostIdentity>) -> ArmDeclaredIncumbent {
  IncumbentDeclared { units: map(hosts, h => ArmIncumbentUnit { host: h, unit_name: w_old_unit }), provenance: "witness" as NonEmptyStr }
}

fn w_running(unit: NonEmptyStr) -> List<GroupArmHostOccupancy> {
  map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, own_fence: ArmOwnFenceAbsent, admission: HostOccupiedBy {
    occupant: ServingUnitActive { unit: unit, state: Active },
    others: [GpuComputeProcess { pid: 4242, process_name: "python3", used: UsedMemoryReported { used: mebibyte(count: 99000) } }],
    gpu_used: mebibyte(count: 99000) } })
}

fn w_refused_with(a: GroupArmLaunchAdmission, fragment: String) -> Bool {
  match a {
    GroupArmLaunchAdmitted => false
    GroupArmLaunchAdmittedForAdoptionOnly { hosts: _ } => false
    GroupArmLaunchAdmissionRefused { causes: c } => any(c, x => string_contains(s: x, pattern: fragment))
  }
}

// THE POSITIVE CONTROL: the declared unit read back active on every host it is declared on admits, its
// GPU process deferred to the post-stop re-read.
test fn w_a_declared_incumbent_read_back_active_admits() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    match w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: w_old_unit), incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))) {
      GroupArmLaunchAdmitted => true
      GroupArmLaunchAdmittedForAdoptionOnly { hosts: _ } => false
      GroupArmLaunchAdmissionRefused { causes: _ } => false
    }
  })
}

// THE SAME OCCUPANCY WITH NOTHING DECLARED REFUSES EXACTLY AS BEFORE.
test fn w_the_same_occupant_undeclared_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: w_old_unit), incumbent: NoIncumbentDeclared), fragment: "is occupied")
  })
}

// ANY OTHER SERVING UNIT ON A HOST WITH A DECLARED INCUMBENT REFUSES: the declaration names one unit,
// and is never a licence for whatever else runs there.
test fn w_an_undeclared_unit_beside_the_declared_one_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: "gunbc-spark-pair-worker.service" as NonEmptyStr), incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))),
      fragment: "occupied by an undeclared serving unit")
  })
}

// A DECLARED INCUMBENT THAT IS NOT RUNNING REFUSES: it is not the serve the launch was told it supersedes.
test fn w_a_declared_incumbent_not_read_back_active_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck,
      occupancy: map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, own_fence: ArmOwnFenceAbsent, admission: HostUnoccupied { available: kibibyte(count: 120000000) } }),
      incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))),
      fragment: "is not read back active")
  })
}

// A DECLARATION ON A HOST THE PLAN DOES NOT LAUNCH ON REFUSES: stopping it is an effect nothing owes.
test fn w_a_declared_incumbent_off_the_plan_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: w_old_unit),
      incumbent: IncumbentDeclared { units: [ArmIncumbentUnit { host: "srv9" as HostIdentity, unit_name: w_old_unit }], provenance: "witness" as NonEmptyStr }),
      fragment: "which this launch does not run on")
  })
}

// A DECLARED UNIT IS READ: the occupancy reader asks for it by name beside the Spark units and the arm's own.
test fn w_the_reader_asks_for_every_declared_unit_and_the_arms_own() -> Bool {
  let names = map(group_arm_read_units(units: glm53_staircase_units, incumbent: IncumbentDeclared { units: [ArmIncumbentUnit { host: "srv5" as HostIdentity, unit_name: "glm-old.service" as NonEmptyStr }], provenance: "witness" as NonEmptyStr }), u => u as String)
  any(names, n => n == "glm-old.service")
    && any(names, n => n == (glm53_staircase_units.head_unit_name as String))
    && any(names, n => n == (glm53_staircase_units.rank_unit_name as String))
}

// STEP N - 1'S UNITS ARE STEP N'S INCUMBENT: the head unit on rank zero's host, the rank unit elsewhere.
test fn w_the_previous_step_is_this_arms_own_units() -> Bool {
  match glm53_previous_step_incumbent(lines_hosts: fabric_group_hosts(g: FabricGroupA)) {
    NoIncumbentDeclared => false
    IncumbentDeclared { units: us, provenance: _ } =>
      length(us) == length(fabric_group_hosts(g: FabricGroupA))
        && length(filter(us, u => (u.unit_name as String) == (glm53_staircase_units.head_unit_name as String))) == 1
  }
}

// ── THE DISPATCH: CLOSED INPUTS, AND V4.1 TAKES NONE OF THE STAIRCASE'S ───────────────────────

fn w_selected_v41(s: ArmGroupLaunchSelection) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: c } => match c { ArmV41GroupA => true  ArmGlm53GroupAStep { step: _, incumbent: _ } => false }
    ArmGroupLaunchSelectionRefused { cause: _ } => false
  }
}

fn w_selected_glm_step(s: ArmGroupLaunchSelection, wire: String) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: c } => match c { ArmV41GroupA => false  ArmGlm53GroupAStep { step: st, incumbent: _ } => (glm53_step_wire(s: st) as String) == wire }
    ArmGroupLaunchSelectionRefused { cause: _ } => false
  }
}

fn w_refused(s: ArmGroupLaunchSelection) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: _ } => false
    ArmGroupLaunchSelectionRefused { cause: _ } => true
  }
}

test fn w_the_dispatch_selects_only_from_closed_vocabularies() -> Bool {
  w_selected_v41(s: arm_group_launch_select(arm: "v41-group-a", step: "", incumbent: ""))
    && w_refused(s: arm_group_launch_select(arm: "v41-group-a", step: "fp8-8", incumbent: ""))
    && w_selected_glm_step(s: arm_group_launch_select(arm: "glm53-group-a", step: "fp8-12", incumbent: "previous-step"), wire: "fp8-12")
    && w_refused(s: arm_group_launch_select(arm: "glm53-group-a", step: "fp8-13", incumbent: "previous-step"))
    && w_refused(s: arm_group_launch_select(arm: "glm53-group-a", step: "fp8-12", incumbent: "whatever-runs"))
    && w_refused(s: arm_group_launch_select(arm: "glm53-group-b", step: "fp8-12", incumbent: "none"))
}

// THE OBSERVE NEEDS ONLY THE ARM: a GLM observe with no step is admitted, an unknown arm is not.
test fn w_the_observe_reads_only_the_arm_word() -> Bool {
  match arm_group_of_word(arm: "glm53-group-a") { ArmGroupNamed { group: _ } => true  ArmGroupWordRefused { cause: _ } => false }
    && match arm_group_of_word(arm: "glm53-group-b") { ArmGroupNamed { group: _ } => false  ArmGroupWordRefused { cause: _ } => true }
}

// ── A DANGLING TRANSACTION OF THIS ARM ADMITS TO ADOPTION ONLY ───────────────────────────────
//
// nvfp4-8 (runs 37190290418 / 37198685584): the head unit is dead on srv6 under this arm's own fence
// while the other ranks still run. That is the one shape that admits, and it admits ONLY to adoption
// (gunbc.spark.group_arm_launch group_arm_adopt_dangling, which issues no pre-apply, no incumbent stop and
// no apply leg). The REDs: the same inactive unit with no fence of this arm, and the same with the fence
// unread, refuse exactly as a fresh launch always did.
fn w_dangling_on_srv6(fence: ArmOwnFence) -> List<GroupArmHostOccupancy> {
  map(fabric_group_hosts(g: FabricGroupA), h =>
    if (h as String) == "srv6" {
      GroupArmHostOccupancy { host: h, own_fence: fence, admission: HostUnoccupied { available: kibibyte(count: 120000000) } }
    } else {
      GroupArmHostOccupancy { host: h, own_fence: fence, admission: HostOccupiedBy {
        occupant: ServingUnitActive { unit: w_old_unit, state: Active },
        others: [] as List<HostOccupant>,
        gpu_used: mebibyte(count: 99000) } }
    })
}

test fn w_a_dead_rank_under_this_arms_fence_admits_to_adoption_only() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    match w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_dangling_on_srv6(fence: ArmOwnFenceHeld), incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))) {
      GroupArmLaunchAdmittedForAdoptionOnly { hosts: hs } => length(hs) == 1 && all(hs, h => (h as String) == "srv6")
      GroupArmLaunchAdmitted => false
      GroupArmLaunchAdmissionRefused { causes: _ } => false
    }
  })
}

test fn w_an_inactive_incumbent_without_this_arms_fence_still_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_dangling_on_srv6(fence: ArmOwnFenceAbsent), incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))), fragment: "is not read back active")
      && w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_dangling_on_srv6(fence: ArmOwnFenceUnread { cause: "witness" }), incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))), fragment: "is not read back active")
  })
}

// A HOST CARRYING THIS ARM'S UNRESOLVED-ROLLBACK MARKER, its restored units running and declared, admits
// to resolution only (the leftover stage's recovery readback), never to a fresh apply.
test fn w_a_marker_on_a_running_restored_arm_admits_to_resolution_only() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    let occ = map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, own_fence: ArmOwnRollbackUnresolved, admission: HostOccupiedBy {
      occupant: ServingUnitActive { unit: w_old_unit, state: Active }, others: [] as List<HostOccupant>, gpu_used: mebibyte(count: 99000) } })
    match w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: occ, incumbent: w_incumbent_on(hosts: fabric_group_hosts(g: FabricGroupA))) {
      GroupArmLaunchAdmittedForAdoptionOnly { hosts: hs } => length(hs) == 4
      GroupArmLaunchAdmitted => false
      GroupArmLaunchAdmissionRefused { causes: _ } => false
    }
  })
}
