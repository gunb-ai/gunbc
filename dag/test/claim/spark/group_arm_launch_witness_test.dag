// ── THE STAIRCASE IS A CLOSED SET, AND EVERY STEP KEEPS THE COLD FLOOR ────────────────────────────

// EVERY STEP'S WIRE PARSES BACK TO THAT STEP, AND A NUMBER OFF THE STAIRCASE HAS NO SPELLING.
test fn w_every_staircase_step_round_trips_and_an_off_staircase_word_is_no_step() -> Bool {
  all(glm53_staircase_steps, s => match glm53_step_of_wire(word: glm53_step_wire(s: s) as String) {
    Present { value: back } => (glm53_step_wire(s: back) as String) == (glm53_step_wire(s: s) as String)
    Absent => false
  })
    && length(glm53_staircase_steps) == 11
    && match glm53_step_of_wire(word: "fp8-10") { Present { value: _ } => false  Absent => true }
    && match glm53_step_of_wire(word: "nvfp4-12") { Present { value: _ } => false  Absent => true }
}

// EVERY STEP DERIVES A PROFILE WHOSE COLD FLOOR IS 8 x 262144 AND WHOSE CEILING IS THE STEP'S, WITH THE
// FULL-INPUT GATE AND THE WATERMARK STATED -- the profile the launch renders, not a second row.
test fn w_every_step_keeps_the_cold_floor_and_carries_its_own_ceiling() -> Bool {
  all(glm53_staircase_steps, s => match glm53_step_profile(s: s) {
    Absent => false
    Present { value: p } =>
      p.guaranteed_cold_seqs == 8
        && p.max_num_seqs == glm53_step_ceiling(s: s)
        && p.max_model_len == token_count(count: 262144)
        && match p.scheduler_admission.full_input_admission { FullInputAdmissionExplicit { enabled: e } => e  FullInputAdmissionOmitted => false }
        && match p.scheduler_admission.kv_watermark { KvWatermarkExplicit { fraction: _ } => true  KvWatermarkOmitted => false }
  })
}

// THE DISCRIMINATING RED FOR THE ENVELOPE: a ceiling below the floor refuses, and so does one above it
// without the gate -- through the same scheduler_envelope every step derives from.
test fn w_a_ceiling_below_the_floor_or_above_it_ungated_has_no_envelope() -> Bool {
  match glm53_staircase_cold_intent() {
    Absent => false
    Present { value: cold } => {
      let below = scheduler_envelope(cold: cold, hard_max_num_seqs: 6, admission: glm53_staircase_scheduler_admission)
      let ungated = scheduler_envelope(cold: cold, hard_max_num_seqs: 16, admission: VllmSchedulerAdmissionRequest {
        full_input_admission: FullInputAdmissionExplicit { enabled: false },
        kv_watermark: KvWatermarkExplicit { fraction: basis_point(count: 0) },
      })
      let ok = scheduler_envelope(cold: cold, hard_max_num_seqs: 16, admission: glm53_staircase_scheduler_admission)
      match below { SchedulerEnvelopeAdmitted { envelope: _ } => false  SchedulerEnvelopeRefused { cause: _ } => true }
        && match ungated { SchedulerEnvelopeAdmitted { envelope: _ } => false  SchedulerEnvelopeRefused { cause: _ } => true }
        && match ok { SchedulerEnvelopeAdmitted { envelope: _ } => true  SchedulerEnvelopeRefused { cause: _ } => false }
    }
  }
}

// THE STEP SELECTS ITS CHECKPOINT'S POLICY: the NVFP4 steps launch the NVIDIA checkpoint, the FP8 steps
// the native one, and the profile carries it.
test fn w_each_step_launches_its_own_checkpoint() -> Bool {
  match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats8 }) {
    Absent => false
    Present { value: f } => match glm53_step_inputs(s: Glm53Nvfp4Step { step: Nvfp4Seats32 }) {
      Absent => false
      Present { value: n } =>
        f.profile.checkpoint == f.assignment.checkpoint
          && n.profile.checkpoint == n.assignment.checkpoint
          && f.assignment.checkpoint != n.assignment.checkpoint
          && n.profile.max_num_seqs == 32
    }
  }
}

// ── THE GLM STEP TAKES THE ONE PATH (the pairing obligation) ─────────────────────────────────────
//
// The FP8 eight-seat step's REAL inputs through the REAL planner (group_arm_launch_plan: the arm wall,
// the memory wall under the bounded-experiment intent, the roster) -- nothing about the plan is
// supplied. Only the authority and the occupancy are, at the admission's interface, because the live
// log and the hosts are on the fleet. The route is asserted: four rank lines at the step's ceiling over
// its floor, and an admission that ADMITS on Group A released to the fleet, because the committed
// standing grant covers an arm launch on all four hosts and the produced runtime gives a keyed
// successor. The live entry (mode spark_arm_group_launch_plan) is the same fold with the authority read.
fn w_released(h: ContentHash) -> PairServingGroupAuthority {
  ReleasedToFleet { group: FabricGroupA, release_receipt: h }
}

fn w_vacant_a() -> List<GroupArmHostOccupancy> {
  map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, admission: HostUnoccupied { available: kibibyte(count: 120000000) } })
}

test fn w_the_glm_fp8_eight_seat_step_takes_the_one_path_and_admits_on_the_released_group() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats8 }) {
      Absent => false
      Present { value: i } => match group_arm_launch_plan(inputs: i) {
        GroupArmLaunchRefused { causes: _ } => false
        GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: _ } => {
          let a = group_arm_launch_admission(
            group: FabricGroupA, purpose: i.purpose, units: i.units, plan: GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: "witness" as NonEmptyStr },
            authority: Present { value: w_released(h: ck) },
            successor: group_arm_row_successor(inputs: i), arm_causes: [],
            held: fabric_group_hosts(g: FabricGroupA), occupancy: w_vacant_a(),
            grant_row: StandingGrantRowOnMain)
          let off_main = group_arm_launch_admission(
            group: FabricGroupA, purpose: i.purpose, units: i.units, plan: GroupArmLaunchPlanned { lines: ls, profile: prof, master_endpoint: "witness" as NonEmptyStr },
            authority: Present { value: w_released(h: ck) },
            successor: group_arm_row_successor(inputs: i), arm_causes: [],
            held: fabric_group_hosts(g: FabricGroupA), occupancy: w_vacant_a(),
            grant_row: StandingGrantRowNotOnMain { cause: "witness: the row differs from origin/main's" })
          w_refused_with(a: off_main, fragment: "the standing grant is not honored")
            && length(ls) == 4 && prof.max_num_seqs == 8 && prof.guaranteed_cold_seqs == 8
            && (match a { GroupArmLaunchAdmitted => true  GroupArmLaunchAdmissionRefused { causes: _ } => false })
        }
      }
    }
  })
}

// A RELEASED GROUP REFUSES A LAUNCH THE GRANT DOES NOT COVER (ruling of valiant-crab-775, 2026-10-03):
// one host outside the grant's roster is enough, and a group the grant does not name refuses whatever
// its hosts. The positive control is the grant's own four hosts. Then the same refusal on the admission
// route: the real V4.1 plan, whose hosts are Group A's, admitted under Group B's release refuses by the
// grant cause (and by the host wall), never admits.
test fn w_a_released_group_refuses_a_launch_the_grant_does_not_cover() -> Bool {
  let a_hosts = fabric_group_hosts(g: FabricGroupA)
  length(group_arm_released_launch_causes(group: FabricGroupA, hosts: a_hosts, grant_row: StandingGrantRowOnMain)) == 0
    && length(group_arm_released_launch_causes(group: FabricGroupA, hosts: concat(a_hosts, ["srv9" as HostIdentity]), grant_row: StandingGrantRowOnMain)) == 1
    && length(group_arm_released_launch_causes(group: FabricGroupB, hosts: fabric_group_hosts(g: FabricGroupB), grant_row: StandingGrantRowOnMain)) == 1
    && length(group_arm_released_launch_causes(group: FabricGroupA, hosts: [] as List<HostIdentity>, grant_row: StandingGrantRowOnMain)) == 1
    && with_w_plan(f: fn(p, rk, ck) {
      w_refused_with(a: group_arm_launch_admission(
          group: FabricGroupB, purpose: "witness" as NonEmptyStr, units: v41_group_a_units, plan: v41_arm_plan(p: p),
          authority: Present { value: ReleasedToFleet { group: FabricGroupB, release_receipt: ck } },
          successor: ArmSuccessorKeyed { key: ck }, arm_causes: [],
          held: fabric_group_hosts(g: FabricGroupB), occupancy: w_vacant_a(), grant_row: StandingGrantRowOnMain),
        fragment: "no standing grant covers an arm launch")
    })
}

// THE STAIRCASE'S RUNTIME IS KEYED: the Group A production is pinned by its configuration digest, so
// every step derives a successor key, and two steps on different checkpoints derive different keys.
test fn w_the_produced_runtime_keys_every_step() -> Bool {
  match glm53_step_inputs(s: Glm53Fp8Step { step: Fp8Seats24 }) {
    Absent => false
    Present { value: f } => match glm53_step_inputs(s: Glm53Nvfp4Step { step: Nvfp4Seats8 }) {
      Absent => false
      Present { value: n } => match group_arm_row_successor(inputs: f) {
        ArmSuccessorUnkeyed { causes: _ } => false
        ArmSuccessorKeyed { key: kf } => match group_arm_row_successor(inputs: n) {
          ArmSuccessorUnkeyed { causes: _ } => false
          ArmSuccessorKeyed { key: kn } => !content_hash_equal(left: kf, right: kn)
        }
      }
    }
  }
}

// ── THE ARM'S OWN UNITS ARE ITS SUBJECT (docs/plans/arm-convergence-recovery-design.md) ─────────
//
// THE PLAN IS THE V4.1 FIXTURE'S, AS THE ONE PATH'S PLAN: four real rank lines over Group A, which is
// all these claims need -- the occupancy conjunct is about hosts and units, not about the arm.

fn w_admit(p: GroupArmLaunchPlan, ck: ContentHash, occupancy: List<GroupArmHostOccupancy>) -> GroupArmLaunchAdmission {
  group_arm_launch_admission(
    group: FabricGroupA, purpose: "the witness launch" as NonEmptyStr, units: v41_group_a_units, plan: p,
    authority: Present { value: w_suspended_for(successor: ck, stale: false) },
    successor: ArmSuccessorKeyed { key: ck }, arm_causes: [],
    held: fabric_group_hosts(g: FabricGroupA), occupancy: occupancy, grant_row: StandingGrantRowNotOnMain { cause: "witness: a suspension, so the grant is not read" })
}

data w_other_unit: NonEmptyStr = "gunbc-spark-pair-head.service" as NonEmptyStr

fn w_running(unit: NonEmptyStr) -> List<GroupArmHostOccupancy> {
  map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, admission: HostOccupiedBy {
    occupant: ServingUnitActive { unit: unit, state: Active },
    others: [GpuComputeProcess { pid: 4242, process_name: "python3", used: UsedMemoryReported { used: mebibyte(count: 99000) } }],
    gpu_used: mebibyte(count: 99000) } })
}

fn w_refused_with(a: GroupArmLaunchAdmission, fragment: String) -> Bool {
  match a {
    GroupArmLaunchAdmitted => false
    GroupArmLaunchAdmissionRefused { causes: c } => any(c, x => string_contains(s: x, pattern: fragment))
  }
}

// THE POSITIVE CONTROL: this arm's own unit running on every host, its GPU process beside it, admits --
// the converge observes it and, if it deviates, stops it with every rank; the GPU process is judged after
// that stop. This is the state every staircase step after the first launches over.
test fn w_this_arms_own_running_unit_is_its_subject_and_admits() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    match w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: v41_group_a_units.head_unit_name)) {
      GroupArmLaunchAdmitted => true
      GroupArmLaunchAdmissionRefused { causes: _ } => false
    }
  })
}

// THE RED: the same occupancy by a serving unit that is NOT this arm's refuses by name -- the subject is
// this arm, never whatever runs on its hosts.
test fn w_another_serving_unit_refuses() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    w_refused_with(a: w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: w_running(unit: w_other_unit)), fragment: "is occupied by a serving unit that is not this arm's")
  })
}

// GPU PROCESSES WITH NO OWN UNIT ACTIVE are an undeclared occupant and refuse exactly as before: the
// deferral to the post-stop read is licensed only by this arm's own unit running beside them.
test fn w_gpu_processes_without_an_own_unit_refuse() -> Bool {
  with_w_plan(f: fn(p, rk, ck) {
    let occ = map(fabric_group_hosts(g: FabricGroupA), h => GroupArmHostOccupancy { host: h, admission: HostOccupiedBy {
      occupant: GpuComputeProcess { pid: 4242, process_name: "python3", used: UsedMemoryReported { used: mebibyte(count: 99000) } },
      others: [] as List<HostOccupant>,
      gpu_used: mebibyte(count: 99000) } })
    match w_admit(p: v41_arm_plan(p: p), ck: ck, occupancy: occ) {
      GroupArmLaunchAdmitted => false
      GroupArmLaunchAdmissionRefused { causes: c } => length(c) > 0
    }
  })
}

// THE ARM'S OWN UNITS ARE READ: the occupancy reader asks for both, once each, beside the Spark units.
test fn w_the_reader_asks_for_the_arms_own_units() -> Bool {
  let names = map(group_arm_read_units(units: glm53_staircase_units), u => u as String)
  length(filter(names, n => n == (glm53_staircase_units.head_unit_name as String))) == 1
    && length(filter(names, n => n == (glm53_staircase_units.rank_unit_name as String))) == 1
}

// ── THE DISPATCH: CLOSED INPUTS, AND V4.1 TAKES NONE OF THE STAIRCASE'S ───────────────────────

fn w_selected_v41(s: ArmGroupLaunchSelection) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: c } => match c { ArmV41GroupA => true  ArmGlm53GroupAStep { step: _ } => false }
    ArmGroupLaunchSelectionRefused { cause: _ } => false
  }
}

fn w_selected_glm_step(s: ArmGroupLaunchSelection, wire: String) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: c } => match c { ArmV41GroupA => false  ArmGlm53GroupAStep { step: st } => (glm53_step_wire(s: st) as String) == wire }
    ArmGroupLaunchSelectionRefused { cause: _ } => false
  }
}

fn w_refused(s: ArmGroupLaunchSelection) -> Bool {
  match s {
    ArmGroupLaunchSelected { choice: _ } => false
    ArmGroupLaunchSelectionRefused { cause: _ } => true
  }
}

test fn w_the_dispatch_selects_only_from_closed_vocabularies() -> Bool {
  w_selected_v41(s: arm_group_launch_select(arm: "v41-group-a", step: ""))
    && w_refused(s: arm_group_launch_select(arm: "v41-group-a", step: "fp8-8"))
    && w_selected_glm_step(s: arm_group_launch_select(arm: "glm53-group-a", step: "fp8-12"), wire: "fp8-12")
    && w_refused(s: arm_group_launch_select(arm: "glm53-group-a", step: "fp8-13"))
    && w_refused(s: arm_group_launch_select(arm: "glm53-group-b", step: "fp8-12"))
}

// THE OBSERVE NEEDS ONLY THE ARM: a GLM observe with no step is admitted, an unknown arm is not.
test fn w_the_observe_reads_only_the_arm_word() -> Bool {
  match arm_group_of_word(arm: "glm53-group-a") { ArmGroupNamed { group: _ } => true  ArmGroupWordRefused { cause: _ } => false }
    && match arm_group_of_word(arm: "glm53-group-b") { ArmGroupNamed { group: _ } => false  ArmGroupWordRefused { cause: _ } => true }
}

// THE LAUNCH STEP OUTLASTS EVERY ARM'S READINESS DEADLINE PLUS THE TRANSACTION'S BUDGETS: the literal the
// workflow renders against the derivation from each arm's own VLLM_ENGINE_READY_TIMEOUT_S (the front door's
// reader). RED: a step timeout of 60 with a 3600 s readiness deadline (nvfp4-8, fleet-converge 37190290418).
test fn w_the_launch_step_timeout_covers_every_arms_readiness() -> Bool {
  match arm_launch_step_needed() {
    ArmLaunchStepNeedRefused { causes: _ } => false
    ArmLaunchStepNeedDerived { need: n } => (arm_launch_step_timeout_minutes as Int) * 60 >= second_count(s: n) && second_count(s: n) > 3600
  }
}

// ── THE AUTOTUNE POLICY IS PART OF LAUNCH AND PERFORMANCE IDENTITY (side-chat ruling on #13319, finding 3)
//
// THE RED: the same NVFP4 step with and without VLLM_FLASHINFER_AUTOTUNE_SKIP_OPS. With it, rank 0 runs
// tuned tactics and ranks 1-3 heuristic ones, so its throughput is a lower bound; without it every rank
// tunes. If both shared a successor key, a suspension granted to one would admit the other, and if both
// shared a performance subject their calibration evidence would compare as one configuration. Both keys
// must differ, and the load receipt must state the policy.
fn w_without_skip_ops(i: GroupArmLaunchInputs) -> GroupArmLaunchInputs {
  GroupArmLaunchInputs {
    assignment: i.assignment, profile: i.profile, intent: i.intent,
    deployment_env: filter(i.deployment_env, a => (a.name as String) != (vllm_environment_variable_name(v: VllmFlashinferAutotuneSkipOps) as String)),
    container: i.container, units: i.units, purpose: i.purpose,
  }
}

test fn w_skip_ops_present_or_absent_is_a_different_successor_and_subject() -> Bool {
  match glm53_step_inputs(s: Glm53Nvfp4Step { step: Nvfp4Seats8 }) {
    Absent => false
    Present { value: skipping } => {
      let without = w_without_skip_ops(i: skipping)
      length(skipping.deployment_env) == length(without.deployment_env) + 1
        && (match group_arm_row_successor(inputs: skipping) {
          ArmSuccessorUnkeyed { causes: _ } => false
          ArmSuccessorKeyed { key: kw } => match group_arm_row_successor(inputs: without) {
            ArmSuccessorUnkeyed { causes: _ } => false
            ArmSuccessorKeyed { key: ko } => !content_hash_equal(left: kw, right: ko)
          }
        })
        && (match glm53_step_performance_subject(inputs: skipping) {
          Absent => false
          Present { value: pw } => match glm53_step_performance_subject(inputs: without) {
            Absent => false
            Present { value: po } => !serving_subject_key_equal(a: serving_subject_key(s: pw), b: serving_subject_key(s: po))
          }
        })
        && string_contains(s: glm53_autotune_standing_wire(env: skipping.deployment_env), pattern: "LOWER BOUND")
        && !string_contains(s: glm53_autotune_standing_wire(env: without.deployment_env), pattern: "LOWER BOUND")
    }
  }
}
