module test.claim.spark.gpu_direct_capability_witness_test

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.nvidia.cuda_driver {
  CudaDeviceAttribute, GpuDirectRdmaSupportedAttribute, DmaBufSupportedAttribute,
  CudaQueryOutcome, CudaQuerySucceeded, CudaQueryFailed, CudaQueryUnparsed,
  cuda_attribute_outcome, cuda_device_attribute_ordinal, cuda_device_attribute_program,
}
import extdeps.nvidia.gpu_direct_rdma {
  GpuDirectRdmaCapability, GpuDirectRdmaDevicePrerequisiteMet, GpuDirectRdmaDeviceUnsupported, GpuDirectRdmaCapabilityUnread,
  gpu_direct_rdma_capability,
}
import extdeps.nvidia.nccl {
  NcclLogLine, NcclGpuMemoryPath, NcclGpuDirectEnabled, NcclGpuDirectDisabled, NcclGpuMemoryPathUnread,
  nccl_parse_log_line, nccl_gpu_memory_path_of_line, nccl_gpu_memory_path_of_text,
  NcclGpuDirectLineReading, NcclGpuDirectLineEnabled, NcclGpuDirectLineDisabled, NcclNotAGpuDirectLine, NcclGpuDirectLineUnreadable,
  NcclMemoryPathAgreed, NcclMemoryPathDisagrees, NcclMemoryPathUnreadable, NcclMemoryPathAbsent,
}
import gunbc.spark.collective_memory_path_standing {
  CollectiveMemoryPathStanding, MemoryPathDirectAsCapable, MemoryPathStagedAsPlatformRequires,
  MemoryPathBelowCapability, MemoryPathStandingUnread,
  collective_memory_path_standing,
  MemoryPathProducersContradict,
  MemoryPathDefectStanding, DefectEstablished, NoDefectEstablished, DefectStandingUnread, EvidenceContradicts,
  memory_path_defect_standing,
}

// ── THE DECODE CHAIN FOR A CAPABILITY, ONE LAYER AT A TIME ────────────────────────────────────
//
// Each layer is asked its own question on an input sized to that question (DESIGN section 3: a
// witness discriminates at one interface). The layers are: the attribute reply parser, the
// capability fold over two replies, the NCCL log line reader, and the join that decides whether a
// staged path is a defect.
//
// THE PAIRING OBLIGATION. Every supplied input here is a reply shape that a real producer emits, and
// the producer is named beside it: `cuda_device_attribute_program` renders the query whose stdout
// these strings imitate, and `gunbc.spark.spark_gpu_direct_capability` carries the reading actually
// taken from spark-0c75. The row below over that real reading is the inhabitance claim.

// ── 1. THE REPLY PARSER ───────────────────────────────────────────────────────────────────────
test fn w_a_well_formed_reply_parses_to_its_value() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 0 1") {
    CudaQuerySucceeded { value: v } => v == 1
    CudaQueryFailed { result_code: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

// A ZERO FROM A SUCCEEDING QUERY IS AN ANSWER, and it must not read as a failure.
test fn w_a_zero_from_a_succeeding_query_is_a_reading() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 0 0") {
    CudaQuerySucceeded { value: v } => v == 0
    CudaQueryFailed { result_code: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

// AND A NONZERO CUresult IS NOT A ZERO VALUE, which is the distinction the whole module protects.
test fn w_a_failed_query_is_not_an_unsupported_answer() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 3 0") {
    CudaQueryFailed { result_code: rc } => rc == 3
    CudaQuerySucceeded { value: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

test fn w_a_reply_for_another_attribute_is_refused() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "124 0 0 0 1") {
    CudaQueryUnparsed { cause: _ } => true
    CudaQuerySucceeded { value: _ } => false
    CudaQueryFailed { result_code: _ } => false
  }
}

test fn w_a_truncated_reply_refuses_rather_than_reading_a_zero() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 0") {
    CudaQueryUnparsed { cause: _ } => true
    CudaQuerySucceeded { value: _ } => false
    CudaQueryFailed { result_code: _ } => false
  }
}

test fn w_a_non_numeric_field_refuses() -> Bool {
  match cuda_attribute_outcome(a: DmaBufSupportedAttribute, stdout: "124 0 0 0 yes") {
    CudaQueryUnparsed { cause: _ } => true
    CudaQuerySucceeded { value: _ } => false
    CudaQueryFailed { result_code: _ } => false
  }
}

// THE PROGRAM CARRIES THE ORDINAL IT WAS ASKED FOR, so the query and the parser agree by
// construction rather than by an author remembering to keep them in step.
test fn w_the_query_program_names_the_attribute_ordinal() -> Bool {
  string_contains(s: cuda_device_attribute_program(a: DmaBufSupportedAttribute) as String,
                  pattern: to_string(cuda_device_attribute_ordinal(a: DmaBufSupportedAttribute)))
}

// ── 2. THE CAPABILITY FOLD ────────────────────────────────────────────────────────────────────
data gb10: NonEmptyStr = "a unified-memory platform" as NonEmptyStr

test fn w_both_attributes_zero_is_unsupported() -> Bool {
  match gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQuerySucceeded { value: 0 }) {
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
  }
}

test fn w_peer_memory_support_names_its_mechanism() -> Bool {
  match gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 1 }, dma_buf: CudaQuerySucceeded { value: 0 }) {
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => true
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => false
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
  }
}

// DMA-BUF ALONE DOES NOT MAKE THE DEVICE CAPABLE, and this row is the corrected form of one that
// asserted the opposite. Attribute 116 reports whether the device supports the GPUDirect RDMA APIs
// at all; a zero there decides unavailability on its own, and a positive DMA-BUF reading cannot
// overturn it, because DMA-BUF sharing is a prerequisite for one registration route rather than an
// end-to-end capability (review 5243531470).
test fn w_dma_buf_alone_does_not_overturn_an_unsupported_device() -> Bool {
  match gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQuerySucceeded { value: 1 }) {
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
  }
}

// A FAILED QUERY ON THE DECIDING ATTRIBUTE LEAVES THE CAPABILITY UNREAD. This is the row that
// refuses "no module, therefore unsupported": when the device never answered, nothing may stand in
// for the answer.
test fn w_a_failed_decider_query_leaves_the_capability_unread() -> Bool {
  match gpu_direct_rdma_capability(platform: gb10, device_api: CudaQueryFailed { result_code: 3 }, dma_buf: CudaQuerySucceeded { value: 0 }) {
    GpuDirectRdmaCapabilityUnread { cause: _ } => true
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => false
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
  }
}

// BUT A FAILED SECONDARY QUERY AFTER A DECIDED NEGATIVE IS NOT UNREAD, and saying so is the point of
// asking the deciding attribute first: once the device reports no GPUDirect API support, whether
// DMA-BUF could be read changes nothing about the answer.
test fn w_a_failed_secondary_query_does_not_unread_a_decided_negative() -> Bool {
  match gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQueryFailed { result_code: 3 }) {
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => true
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
  }
}

// ── 3. THE NCCL LINE READER ───────────────────────────────────────────────────────────────────
fn memory_path_of(raw: String) -> NcclGpuDirectLineReading {
  match nccl_parse_log_line(raw: raw) {
    Absent => NcclNotAGpuDirectLine
    Present { value: l } => nccl_gpu_memory_path_of_line(line: l)
  }
}

test fn w_a_disabled_line_reads_as_host_staged() -> Bool {
  match memory_path_of(raw: "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Disabled for HCA 0 'rocep1s0f1'") {
    NcclGpuDirectLineDisabled { read_from: _ } => true
    NcclGpuDirectLineEnabled { read_from: _ } => false
    NcclNotAGpuDirectLine => false
    NcclGpuDirectLineUnreadable { cause: _ } => false
  }
}

test fn w_an_enabled_line_reads_as_registered() -> Bool {
  match memory_path_of(raw: "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Enabled for HCA 0 'rocep1s0f1'") {
    NcclGpuDirectLineEnabled { read_from: _ } => true
    NcclGpuDirectLineDisabled { read_from: _ } => false
    NcclNotAGpuDirectLine => false
    NcclGpuDirectLineUnreadable { cause: _ } => false
  }
}

// A LINE ABOUT SOMETHING ELSE IS NOT A GDR LINE, and in particular the transport announcement must
// not answer this question.
test fn w_the_network_announcement_does_not_answer_the_memory_path() -> Bool {
  match memory_path_of(raw: "spark-0c75:385:385 [0] NCCL INFO Using network IB") {
    NcclNotAGpuDirectLine => true
    NcclGpuDirectLineUnreadable { cause: _ } => false
    NcclGpuDirectLineDisabled { read_from: _ } => false
    NcclGpuDirectLineEnabled { read_from: _ } => false
  }
}

// AND A GDR LINE WITH AN UNKNOWN STATE IS UNREADABLE, NOT "NOT A GDR LINE" (review 67523). This is
// the per-line half of the split; the capture-level half is below.
test fn w_a_gdr_line_with_an_unknown_state_is_unreadable_not_absent() -> Bool {
  match memory_path_of(raw: "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Partial for HCA 0 'rocep1s0f1'") {
    NcclGpuDirectLineUnreadable { cause: _ } => true
    NcclNotAGpuDirectLine => false
    NcclGpuDirectLineDisabled { read_from: _ } => false
    NcclGpuDirectLineEnabled { read_from: _ } => false
  }
}

// ── 3b. THE WHOLE-CAPTURE FOLD THE LIVE ROUTE CALLS ───────────────────────────────────────────
//
// gunbc.spark.glm_group_b_relaunch_cli rank_memory_path_text reads a captured log through
// `nccl_gpu_memory_path_of_text`, not the per-line reader, so the fold is claimed directly: agreement,
// disagreement, an unreadable line and a capture with no GDR line are four different answers.
data gdr_disabled_ib: String = "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Disabled for HCA 0 'rocep1s0f1'"
data gdr_disabled_gin: String = "spark-0c75:385:385 [0] NCCL INFO NET/GIN_IB_GDAKI : GPU Direct RDMA Disabled for HCA 0 'rocep1s0f1'"
data gdr_enabled_ib: String = "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Enabled for HCA 1 'rocep1s0f0'"
data gdr_unknown_ib: String = "spark-0c75:385:385 [0] NCCL INFO NET/IB : GPU Direct RDMA Partial for HCA 0 'rocep1s0f1'"
data nccl_unrelated: String = "spark-0c75:385:385 [0] NCCL INFO Using network IB"

fn capture(lines: List<String>) -> String { join(lines, "\n") }

test fn w_agreeing_disabled_lines_fold_to_disabled_with_their_count() -> Bool {
  match nccl_gpu_memory_path_of_text(captured_text: capture(lines: [nccl_unrelated, gdr_disabled_ib, gdr_disabled_gin])) {
    NcclMemoryPathAgreed { path: NcclGpuDirectDisabled { read_from: _ }, readings: n } => n == 2
    _ => false
  }
}

test fn w_lines_that_disagree_refuse_to_answer() -> Bool {
  match nccl_gpu_memory_path_of_text(captured_text: capture(lines: [gdr_disabled_ib, gdr_enabled_ib])) {
    NcclMemoryPathDisagrees { causes: _ } => true
    _ => false
  }
}

// THE RED THE REVIEW NAMED: an unreadable GDR line beside readable ones that agree must refuse, and
// must not read as a capture with no GDR line.
test fn w_an_unreadable_gdr_line_refuses_the_capture_and_is_not_absence() -> Bool {
  match nccl_gpu_memory_path_of_text(captured_text: capture(lines: [gdr_disabled_ib, gdr_unknown_ib, gdr_disabled_gin])) {
    NcclMemoryPathUnreadable { causes: cs } => count(cs) == 1
    _ => false
  }
}

test fn w_a_capture_with_no_gdr_line_is_absent() -> Bool {
  match nccl_gpu_memory_path_of_text(captured_text: capture(lines: [nccl_unrelated])) {
    NcclMemoryPathAbsent => true
    _ => false
  }
}

fn defect_established(s: CollectiveMemoryPathStanding) -> Bool {
  match memory_path_defect_standing(s: s) {
    EvidenceContradicts { cause: _ } => false
    DefectEstablished { cause: _ } => true
    NoDefectEstablished { because: _ } => false
    DefectStandingUnread { cause: _ } => false
  }
}

fn no_defect_established(s: CollectiveMemoryPathStanding) -> Bool {
  match memory_path_defect_standing(s: s) {
    EvidenceContradicts { cause: _ } => false
    NoDefectEstablished { because: _ } => true
    DefectEstablished { cause: _ } => false
    DefectStandingUnread { cause: _ } => false
  }
}

// UNREAD IS ITS OWN ANSWER, and this helper exists so the row below asserts it POSITIVELY rather
// than by the absence of a defect -- which is the fail-open shape the Boolean had.
fn defect_standing_unread(s: CollectiveMemoryPathStanding) -> Bool {
  match memory_path_defect_standing(s: s) {
    EvidenceContradicts { cause: _ } => false
    DefectStandingUnread { cause: _ } => true
    DefectEstablished { cause: _ } => false
    NoDefectEstablished { because: _ } => false
  }
}

// ── 4. THE JOIN THAT DECIDES WHETHER IT IS A DEFECT ───────────────────────────────────────────
data staged: NcclGpuMemoryPath = NcclGpuDirectDisabled { read_from: "NET/IB : GPU Direct RDMA Disabled for HCA 0" as NonEmptyStr }

test fn w_staged_on_an_incapable_platform_is_not_a_defect() -> Bool {
  let s = collective_memory_path_standing(
    capability: gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQuerySucceeded { value: 0 }),
    observed: staged)
  no_defect_established(s: s)
    && match s { MemoryPathStagedAsPlatformRequires { platform: _, capability_receipt: _, observed_from: _ } => true, MemoryPathDirectAsCapable => false, MemoryPathBelowCapability { capability_receipt: _, observed_from: _ } => false, MemoryPathStandingUnread { cause: _ } => false, MemoryPathProducersContradict { capability_receipt: _, observed_from: _ } => false }
}

// THE ONE ARM THAT IS A DEFECT, and the row that makes the type discriminating rather than
// decorative: the same observation, on a platform that says it can do better.
test fn w_staged_on_a_capable_platform_is_a_defect() -> Bool {
  let s = collective_memory_path_standing(
    capability: gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 1 }, dma_buf: CudaQuerySucceeded { value: 0 }),
    observed: staged)
  defect_established(s: s)
    && match s { MemoryPathBelowCapability { capability_receipt: _, observed_from: _ } => true, MemoryPathDirectAsCapable => false, MemoryPathStagedAsPlatformRequires { platform: _, capability_receipt: _, observed_from: _ } => false, MemoryPathStandingUnread { cause: _ } => false, MemoryPathProducersContradict { capability_receipt: _, observed_from: _ } => false }
}

test fn w_an_unread_capability_refuses_to_decide() -> Bool {
  let s = collective_memory_path_standing(
    capability: gpu_direct_rdma_capability(platform: gb10, device_api: CudaQueryFailed { result_code: 3 }, dma_buf: CudaQuerySucceeded { value: 0 }),
    observed: staged)
  defect_standing_unread(s: s)
    && match s { MemoryPathStandingUnread { cause: _ } => true, MemoryPathDirectAsCapable => false, MemoryPathStagedAsPlatformRequires { platform: _, capability_receipt: _, observed_from: _ } => false, MemoryPathBelowCapability { capability_receipt: _, observed_from: _ } => false, MemoryPathProducersContradict { capability_receipt: _, observed_from: _ } => false }
}

// ── 5. THE WHOLE PROBE, FROM THE REPLY THE ROUTE READS ────────────────────────────────────────
//
// The rows above supply a CudaQueryOutcome directly. This one starts one layer lower, at the text
// the probe prints, and drives the same fold the live route drives: the route's reply goes through
// `cuda_attribute_outcome` and then `gpu_direct_rdma_capability`, so a change to either layer that
// broke the join would fail here.
//
// AND IT IS NO LONGER AN AUTHORED CAPABILITY ROW. An earlier revision of this section matched on a
// `spark_gb10_gpu_direct_capability` literal in gunbc.spark.spark_gpu_direct_capability -- a
// transcribed instrument output consumed as the production authority (review 67496, DESIGN section
// 6). That row is deleted; the capability is now read by
// gunbc.spark.serving_rank_observe `observe_rank_gpu_direct_capability`, which cannot run in a
// witness because it needs a live container, so what is exercised here is the reply-to-capability
// fold that route performs.
test fn w_a_device_unsupported_reply_folds_to_unsupported_with_no_defect() -> Bool {
  let capability = gpu_direct_rdma_capability(
    platform: gb10,
    device_api: cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 0 0 0"),
    dma_buf: cuda_attribute_outcome(a: DmaBufSupportedAttribute, stdout: "124 0 0 0 0"),
  )
  match capability {
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } =>
      no_defect_established(s: collective_memory_path_standing(capability: capability, observed: staged))
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
    GpuDirectRdmaCapabilityUnread { cause: _ } => false
  }
}

// AND A LEG THAT COULD NOT RUN MUST NOT READ AS A ZERO. The route hands the refusal text to
// `CudaQueryUnparsed`, and this is the row that says the result is Unread rather than Unsupported --
// the distinction the whole module exists for.
test fn w_a_probe_that_could_not_run_is_unread_and_not_unsupported() -> Bool {
  match gpu_direct_rdma_capability(
    platform: gb10,
    device_api: cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: ""),
    dma_buf: cuda_attribute_outcome(a: DmaBufSupportedAttribute, stdout: ""),
  ) {
    GpuDirectRdmaCapabilityUnread { cause: _ } => true
    GpuDirectRdmaDeviceUnsupported { platform: _, capability_receipt: _ } => false
    GpuDirectRdmaDevicePrerequisiteMet { dma_buf_prerequisite: _, capability_receipt: _ } => false
  }
}


// ── 6. THE CELL THE TYPES THEMSELVES NAMED A CONTRADICTION ────────────────────────────────────
//
// A device reporting no capability while the run announces a registered path means ONE OF THE TWO
// PRODUCERS IS WRONG. An earlier revision put this in the unread arm with a cause string that said
// "a contradiction ... rather than a standing" -- one constructor carrying both "nobody looked" and
// "the evidence conflicts" (review 67449, DESIGN section 3 meaning fork). No row covered the cell,
// so the collapse was invisible. This is that row.
data enabled_announcement: NcclGpuMemoryPath = NcclGpuDirectEnabled { read_from: "NET/IB : GPU Direct RDMA Enabled for HCA 0" as NonEmptyStr }

test fn w_an_incapable_device_announcing_a_registered_path_is_a_contradiction() -> Bool {
  let s = collective_memory_path_standing(
    capability: gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQuerySucceeded { value: 0 }),
    observed: enabled_announcement)
  match s {
    MemoryPathProducersContradict { capability_receipt: _, observed_from: _ } =>
      match memory_path_defect_standing(s: s) {
        EvidenceContradicts { cause: _ } => true
        DefectEstablished { cause: _ } => false
        NoDefectEstablished { because: _ } => false
        DefectStandingUnread { cause: _ } => false
      }
    MemoryPathDirectAsCapable => false
    MemoryPathStagedAsPlatformRequires { platform: _, capability_receipt: _, observed_from: _ } => false
    MemoryPathBelowCapability { capability_receipt: _, observed_from: _ } => false
    MemoryPathStandingUnread { cause: _ } => false
  }
}

// AND A CONTRADICTION IS NOT "NO DEFECT", which is the assertion that keeps an admission consumer
// from treating conflicting evidence as healthy.
test fn w_a_contradiction_does_not_read_as_no_defect() -> Bool {
  let s = collective_memory_path_standing(
    capability: gpu_direct_rdma_capability(platform: gb10, device_api: CudaQuerySucceeded { value: 0 }, dma_buf: CudaQuerySucceeded { value: 0 }),
    observed: enabled_announcement)
  !no_defect_established(s: s) && !defect_standing_unread(s: s)
}

// ── THE TWO FAILURES THE OLD REPLY COULD NOT EXPRESS ──────────────────────────────────────────
//
// The program used to throw away cuInit's and cuDeviceGet's CUresults, so a chain that never ran
// could still print an attribute-shaped line and the reader would mint a reading from it. These are
// the rows that make that unwritable: the value field says 1 in both, and both must still refuse.
test fn w_a_failed_cuinit_refuses_even_with_a_plausible_value() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 3 0 0 1") {
    CudaQueryFailed { result_code: rc } => rc == 3
    CudaQuerySucceeded { value: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

test fn w_a_failed_device_selection_refuses_even_with_a_plausible_value() -> Bool {
  match cuda_attribute_outcome(a: GpuDirectRdmaSupportedAttribute, stdout: "116 0 101 0 1") {
    CudaQueryFailed { result_code: rc } => rc == 101
    CudaQuerySucceeded { value: _ } => false
    CudaQueryUnparsed { cause: _ } => false
  }
}

