module test.claim.spark.v41_source_patch_converge_witness

import std.types { Bool, String, List, NonEmptyStr }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.optional { Present, Absent }
import std.upsert_decision { Noop, Apply, Refuse }
import std.realization_reconcile { Applied, NotApplied, classify_reconciled, EffectConverged, EffectNotConverged }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import extdeps.vllm.source_build { vllm_d2d649e6_revision }
import gunbc.spark.v41_runtime_candidate { v41_engine_patch, V41EnginePatch, v41_storage_backed_patch_population, V41PatchesObserved, V41PatchesUnestablished, V41PatchesAbsentByObservation }
import extdeps.git { git_apply_args, git_reset_hard_args }
import extdeps.crypto.hash { sha256sum_line_digest, sha256sum_file_command, sha256sum_argv }
import extdeps.exec.command { argv_words }
import gunbc.spark.v41_source_patch_converge {
  V41PatchMemberRead, V41SourceTreeRead, V41SourcePatchPlan, V41ObservedSourceIdentity,
  V41PatchedSourceConverged, V41PatchedSourceRefused,
  v41_source_patch_decision, v41_source_patch_reconcile, v41_sha256_of_bytes,
  v41_patch_member_read, v41_source_tree_read, v41_source_patch_plan,
  v41_observed_source_identity_of, v41_patched_source_receipt_line, v41_patched_source_converged,
  v41_needs_content_ownership,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

fn w_sha(c: String) -> Sha256Digest {
  Sha256Digest { hex: join([c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c], "") as Sha256DigestHex }
}

fn w_patch(path: String, c: String) -> List<V41EnginePatch> {
  match v41_engine_patch(path: path as NonEmptyStr, applies_to: vllm_d2d649e6_revision, sha256_hex: w_sha(c: c).hex as String, purpose: "fixture" as NonEmptyStr) {
    Present { value: p } => [p]
    Absent => [] as List<V41EnginePatch>
  }
}

fn w_member(path: String, c: String, reverse_applicable: Bool, forward_applicable: Bool) -> V41PatchMemberRead {
  v41_patch_member_read(path: path as NonEmptyStr, observed_sha256: w_sha(c: c), reverse_applicable: reverse_applicable, forward_applicable: forward_applicable)
}

fn w_read(head: String, porcelain: String, members: List<V41PatchMemberRead>) -> V41SourceTreeRead {
  v41_source_tree_read(head: head as NonEmptyStr, porcelain: porcelain, worktree_diff_sha256: w_sha(c: "d"), members: members, recorded_converged_diff_sha256: none, known_set_diff_sha256s: [] as List<Sha256Digest>)
}

fn w_read_recorded(porcelain: String, diff: String, recorded: String, members: List<V41PatchMemberRead>) -> V41SourceTreeRead {
  v41_source_tree_read(
    head: vllm_d2d649e6_revision.full_revision as NonEmptyStr,
    porcelain: porcelain,
    worktree_diff_sha256: w_sha(c: diff),
    members: members,
    recorded_converged_diff_sha256: Present { value: w_sha(c: recorded) },
    known_set_diff_sha256s: [] as List<Sha256Digest>,
  )
}

fn w_read_known(porcelain: String, diff: String, known: List<String>, members: List<V41PatchMemberRead>) -> V41SourceTreeRead {
  v41_source_tree_read(
    head: vllm_d2d649e6_revision.full_revision as NonEmptyStr,
    porcelain: porcelain,
    worktree_diff_sha256: w_sha(c: diff),
    members: members,
    recorded_converged_diff_sha256: none,
    known_set_diff_sha256s: map(known, k => w_sha(c: k)),
  )
}

// Patch set B = [b1, b2]; the tree carries set A, which this converge recorded (diff "a" == record
// "a"). Neither B member applies forward (a new module already exists) nor reverses.
fn w_is_b(obs: V41ObservedSourceIdentity) -> Bool {
  (obs.worktree_diff_sha256.hex as String) == (w_sha(c: "b").hex as String)
}

fn w_set_b() -> List<V41EnginePatch> {
  concat(w_patch(path: "b1.patch", c: "1"), w_patch(path: "b2.patch", c: "2"))
}

test fn red1_patch_set_b_onto_a_tree_this_converge_recorded_under_a_resets_then_applies_and_reads_back_b() -> Bool {
  let on_a = w_read_recorded(
    porcelain: "A  vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py\nM  vllm/models/deepseek_v4_1/nvidia/engram.py",
    diff: "a",
    recorded: "a",
    members: [w_member(path: "b1.patch", c: "1", reverse_applicable: false, forward_applicable: false), w_member(path: "b2.patch", c: "2", reverse_applicable: false, forward_applicable: false)],
  )
  let after_reset = w_read_recorded(
    porcelain: "",
    diff: "e",
    recorded: "a",
    members: [w_member(path: "b1.patch", c: "1", reverse_applicable: false, forward_applicable: true), w_member(path: "b2.patch", c: "2", reverse_applicable: false, forward_applicable: true)],
  )
  let on_b = w_read_recorded(
    porcelain: "A  vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py",
    diff: "b",
    recorded: "a",
    members: [w_member(path: "b1.patch", c: "1", reverse_applicable: true, forward_applicable: false), w_member(path: "b2.patch", c: "2", reverse_applicable: true, forward_applicable: false)],
  )
  match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: on_a) {
    Apply { plan: p } => p.reset_to_revision_first && length(p.patches) == 2
    Noop => false
    Refuse { reason: _ } => false
  }
    && match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: after_reset) {
      Apply { plan: p } => !p.reset_to_revision_first
      Noop => false
      Refuse { reason: _ } => false
    }
    && match classify_reconciled(r: v41_source_patch_reconcile(
      decision: Apply { plan: v41_source_patch_plan(patches: w_set_b()) }, application: Applied, desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), after: on_b,
    )) {
      EffectConverged { converged: conv } => w_is_b(obs: conv.evidence)
      EffectNotConverged { reason: _, attempt: _ } => false
    }
}

test fn red2_a_tree_with_an_edit_this_converge_did_not_record_refuses_rather_than_resetting() -> Bool {
  let members = [w_member(path: "b1.patch", c: "1", reverse_applicable: false, forward_applicable: false), w_member(path: "b2.patch", c: "2", reverse_applicable: false, forward_applicable: false)]
  let foreign = w_read_recorded(porcelain: " M vllm/engine/llm_engine.py", diff: "f", recorded: "a", members: members)
  let unrecorded = w_read(head: vllm_d2d649e6_revision.full_revision as String, porcelain: " M vllm/engine/llm_engine.py", members: members)
  let untracked = w_read_recorded(porcelain: "?? stray.py", diff: "a", recorded: "a", members: members)
  match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: foreign) {
    Refuse { reason: r } => (r as String).contains("not ours to reset")
    Noop => false
    Apply { plan: _ } => false
  }
    && match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: unrecorded) {
      Refuse { reason: r } => (r as String).contains("not ours to reset")
      Noop => false
      Apply { plan: _ } => false
    }
    && match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: untracked) {
      Refuse { reason: r } => (r as String).contains("untracked")
      Noop => false
      Apply { plan: _ } => false
    }
}

test fn red3_the_same_set_twice_is_a_noop_even_though_the_record_matches() -> Bool {
  let on_b = w_read_recorded(
    porcelain: "A  vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py",
    diff: "b",
    recorded: "b",
    members: [w_member(path: "b1.patch", c: "1", reverse_applicable: true, forward_applicable: false), w_member(path: "b2.patch", c: "2", reverse_applicable: true, forward_applicable: false)],
  )
  match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: on_b) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

// The srv8 case: arm A converged set A before the record existed. With no record, the tree's diff
// digest ("a") equals the derived digest of pin + a declared historical set, so it is ours: reset,
// then apply the current set. The same tree without that derivation still refuses, and a foreign
// diff ("f") matches no known set and refuses.
test fn red4_bootstrap_a_tree_carrying_an_older_declared_set_with_no_record_converges_by_content() -> Bool {
  let members = [w_member(path: "b1.patch", c: "1", reverse_applicable: false, forward_applicable: false), w_member(path: "b2.patch", c: "2", reverse_applicable: false, forward_applicable: false)]
  let on_a = w_read_known(porcelain: "A  vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py", diff: "a", known: ["0", "a", "b"], members: members)
  let underived = w_read_known(porcelain: "A  vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py", diff: "a", known: [] as List<String>, members: members)
  let foreign = w_read_known(porcelain: " M vllm/engine/llm_engine.py", diff: "f", known: ["0", "a", "b"], members: members)
  match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: on_a) {
    Apply { plan: p } => p.reset_to_revision_first
    Noop => false
    Refuse { reason: _ } => false
  }
    && v41_needs_content_ownership(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: underived)
    && !v41_needs_content_ownership(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: on_a)
    && !v41_needs_content_ownership(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: w_read_known(porcelain: "?? stray.py", diff: "a", known: [] as List<String>, members: members))
    && match v41_source_patch_decision(desired_revision: vllm_d2d649e6_revision, desired_patches: w_set_b(), read: foreign) {
      Refuse { reason: r } => (r as String).contains("not ours to reset")
      Noop => false
      Apply { plan: _ } => false
    }
}

test fn git_reset_hard_names_the_pin_not_head() -> Bool {
  git_reset_hard_args(repository_dir: "/tmp/vllm", revision: vllm_d2d649e6_revision.full_revision as String)
    == ["-C", "/tmp/vllm", "reset", "--hard", vllm_d2d649e6_revision.full_revision as String]
}

test fn a_clean_tree_at_r_with_forward_checks_is_apply() -> Bool {
  let ps = concat(w_patch(path: "a.patch", c: "1"), w_patch(path: "b.patch", c: "2"))
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: ps,
    read: w_read(
      head: vllm_d2d649e6_revision.full_revision as String,
      porcelain: "",
      members: [w_member(path: "a.patch", c: "1", reverse_applicable: false, forward_applicable: true), w_member(path: "b.patch", c: "2", reverse_applicable: false, forward_applicable: true)],
    ),
  ) {
    Apply { plan: p } => length(p.patches) == 2
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn reverse_checks_without_forward_are_noop_by_observation() -> Bool {
  let ps = concat(w_patch(path: "a.patch", c: "1"), w_patch(path: "b.patch", c: "2"))
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: ps,
    read: w_read(
      head: vllm_d2d649e6_revision.full_revision as String,
      porcelain: " M vllm/models/deepseek_v4_1/nvidia/engram.py",
      members: [w_member(path: "a.patch", c: "1", reverse_applicable: true, forward_applicable: false), w_member(path: "b.patch", c: "2", reverse_applicable: true, forward_applicable: false)],
    ),
  ) {
    Noop => true
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn a_digest_mismatch_refuses() -> Bool {
  let ps = w_patch(path: "a.patch", c: "1")
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: ps,
    read: w_read(
      head: vllm_d2d649e6_revision.full_revision as String,
      porcelain: "",
      members: [w_member(path: "a.patch", c: "9", reverse_applicable: false, forward_applicable: true)],
    ),
  ) {
    Refuse { reason: r } => (r as String).contains("digest mismatch")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn a_wrong_revision_refuses() -> Bool {
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: [] as List<V41EnginePatch>,
    read: w_read(head: "deadbeef", porcelain: "", members: [] as List<V41PatchMemberRead>),
  ) {
    Refuse { reason: r } => (r as String).contains("wrong revision")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn partial_application_refuses() -> Bool {
  let ps = concat(w_patch(path: "a.patch", c: "1"), w_patch(path: "b.patch", c: "2"))
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: ps,
    read: w_read(
      head: vllm_d2d649e6_revision.full_revision as String,
      porcelain: " M x",
      members: [w_member(path: "a.patch", c: "1", reverse_applicable: true, forward_applicable: false), w_member(path: "b.patch", c: "2", reverse_applicable: false, forward_applicable: true)],
    ),
  ) {
    Refuse { reason: r } => (r as String).contains("partial application")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn noop_readback_grounds_and_apply_without_after_read_does_not() -> Bool {
  let ps = w_patch(path: "a.patch", c: "1")
  let already = w_read(
    head: vllm_d2d649e6_revision.full_revision as String,
    porcelain: " M engram.py",
    members: [w_member(path: "a.patch", c: "1", reverse_applicable: true, forward_applicable: false)],
  )
  let clean = w_read(
    head: vllm_d2d649e6_revision.full_revision as String,
    porcelain: "",
    members: [w_member(path: "a.patch", c: "1", reverse_applicable: false, forward_applicable: true)],
  )
  match classify_reconciled(r: v41_source_patch_reconcile(
    decision: Noop, application: NotApplied, desired_revision: vllm_d2d649e6_revision, desired_patches: ps, after: already,
  )) {
    EffectConverged { converged: _ } => true
    EffectNotConverged { reason: _, attempt: _ } => false
  }
    && match classify_reconciled(r: v41_source_patch_reconcile(
      decision: Apply { plan: v41_source_patch_plan(patches: ps) }, application: Applied, desired_revision: vllm_d2d649e6_revision, desired_patches: ps, after: clean,
    )) {
      EffectNotConverged { reason: why, attempt: _ } => (why as String).contains("still wants Apply")
      EffectConverged { converged: _ } => false
    }
}

test fn digestfile_inhabits_the_committed_patch_population() -> Bool {
  match v41_storage_backed_patch_population() {
    V41PatchesObserved { patches: ps, partition: _ } =>
      length(ps) == 2
        && match get(xs: ps, index: 1) {
          Absent => false
          Present { value: p } => (p.purpose as String).contains("FileBackedParallelEngramEmbedding for every Engram layer")
        }
    V41PatchesAbsentByObservation => false
    V41PatchesUnestablished { obligation: _ } => false
  }
}

test fn empty_diff_has_a_real_digest() -> Bool {
  match v41_sha256_of_bytes(content: "") {
    Absent => false
    Present { value: d } => (d.hex as String).length() == 64
  }
}

test fn git_apply_updates_the_index_so_diff_head_covers_new_modules() -> Bool {
  any(git_apply_args(repository_dir: "/tmp/vllm", patch_path: "engram_file_backed.py.patch"), a => a == "--index")
}

test fn the_placed_patch_digest_is_sha256sum_over_the_remote_path() -> Bool {
  let path = "/tmp/declared-patches/engram_file_backed.py.patch"
  argv_words(command: sha256sum_file_command(path: path)) == sha256sum_argv(path: path)
}

test fn a_sha256sum_line_mismatch_is_authorable_without_the_desired_hex() -> Bool {
  match sha256sum_line_digest(line: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  a.patch") {
    Absent => false
    Present { value: a } =>
      match sha256sum_line_digest(line: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  a.patch") {
        Absent => false
        Present { value: b } => (a.hex as String) != (b.hex as String)
      }
  }
}

test fn an_untracked_new_module_refuses_rather_than_sharing_a_diff_head_identity() -> Bool {
  let ps = w_patch(path: "engram_file_backed.py.patch", c: "1")
  match v41_source_patch_decision(
    desired_revision: vllm_d2d649e6_revision,
    desired_patches: ps,
    read: w_read(
      head: vllm_d2d649e6_revision.full_revision as String,
      porcelain: "?? vllm/models/deepseek_v4_1/nvidia/engram_file_backed.py",
      members: [w_member(path: "engram_file_backed.py.patch", c: "1", reverse_applicable: true, forward_applicable: false)],
    ),
  ) {
    Refuse { reason: r } => (r as String).contains("untracked")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn patched_source_receipt_names_the_observed_tree_not_a_clean_vanilla_checkout() -> Bool {
  let obs = v41_observed_source_identity_of(revision_head: "deadbeef" as NonEmptyStr, worktree_diff_sha256: w_sha(c: "d"))
  let applied = v41_patched_source_receipt_line(c: V41PatchedSourceConverged { patches_already_on_tree: false, observed: obs })
  let refused = v41_patched_source_receipt_line(c: V41PatchedSourceRefused { step: "patch-apply" as NonEmptyStr, cause: "git apply refused" })
  applied.contains("patched source revision=deadbeef")
    && applied.contains("patches_already_on_tree=false")
    && applied.contains("worktree_diff_sha256=")
    && !applied.contains("clean=true")
    && !applied.contains("already_present=")
    && refused.contains("patched source REFUSED")
    && v41_patched_source_converged(c: V41PatchedSourceConverged { patches_already_on_tree: false, observed: obs })
    && !v41_patched_source_converged(c: V41PatchedSourceRefused { step: "patch-apply" as NonEmptyStr, cause: "git apply refused" })
}
