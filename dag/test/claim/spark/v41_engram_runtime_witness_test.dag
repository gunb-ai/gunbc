  v41_staging_request, v41_stage, V41StagingVerified, V41StagingRefused, V41StagingUnestablished,
  v41_group_a_staging_standing, v41_staged_matching, v41_staged_with_readback,
}

data w_closed_population: SafetensorsPopulationStanding = safetensors_population_standing(
  members: deepseek_v4_1_flash_engram_index_members,
  shards: deepseek_v4_1_flash_engram_shard_files,
  closure: MembershipClosedAgainstFullIndex {
    index_population_count: deepseek_v4_1_flash_index_tensor_count,
    how: "fixture: this closure is asserted by the test, not read from the revision's index" as NonEmptyStr,
  },
  reading: deepseek_v4_1_flash_engram_population_reading,
)

fn w_sha(c: String) -> Sha256Digest {
  Sha256Digest { hex: join([c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c], "") as Sha256DigestHex }
}

type WPatchSpec {
  path: String
  c: String
}

fn w_patch(path: String, c: String) -> List<V41EnginePatch> {
  match v41_engine_patch(path: path as NonEmptyStr, applies_to: vllm_d2d649e6_revision, sha256_hex: w_sha(c: c).hex as String, purpose: "fixture" as NonEmptyStr) {
    Present { value: p } => [p]
    Absent => [] as List<V41EnginePatch>
  }
}

fn w_observed(pairs: List<WPatchSpec>, partition: V41EngramPartitionAuthority) -> V41PatchPopulation {
  V41PatchesObserved { patches: flat_map(pairs, x => w_patch(path: x.path, c: x.c)), partition: partition }
}

fn w_two_patches() -> V41PatchPopulation {
  w_observed(pairs: [WPatchSpec { path: "engram_storage.patch", c: "1" }, WPatchSpec { path: "engram_prefetch.patch", c: "2" }], partition: PartitionByLaunchConfiguration)
}

fn w_inputs(patches: V41PatchPopulation, partition: V41EngramResidencyPartition, route: DeclarationRef) -> V41CandidateInputs {
  V41CandidateInputs {
    runtime: V41RuntimeArtifactInputs {
      recipe: vllm_recipe_targeting(base: v41_candidate_recipe(), torch_cuda_arch_list: v41_candidate_recipe().torch_cuda_arch_list, install_kv_connectors: v41_candidate_recipe().install_kv_connectors, max_jobs: 6, nvcc_threads: 2),
      kernel_acquisition: flashinfer_0_6_18_post1,
      kernel_wheels: flashinfer_0_6_18_post1_wheels,
      patches: patches,
    },
    model_source: V41ModelSourceInputs {
      checkpoint_revision: "dba1be0a40aa45a94ad051997016db3960a90277" as NonEmptyStr,
      weights: V41ManifestObserved { digest: w_sha(c: "a") },
      tokenizer: V41ManifestObserved { digest: w_sha(c: "b") },
    },
    engram: V41EngramRealizationInputs { partition: partition, population: w_closed_population, row_store_encoding: V41ManifestObserved { digest: w_sha(c: "c") }, route: route },
    topology: topology_shape(tensor_parallel_degree: 4, replica_count: 1),
    device: gb10_observed_compute_capability,
  }
}

fn w_default(patches: V41PatchPopulation) -> V41CandidateInputs {
  w_inputs(patches: patches, partition: v41_candidate_partition, route: engram_route_b_identity)
}

fn w_key(s: V41CandidateVerdict, which: String) -> String {
  match s.standing {
    V41CandidateKeyed { runtime_artifact: r, model_source: m, engram_realization: e, execution_profile: x, candidate: c, authorization_obligation: _ } =>
      if which == "runtime" { serialize_content_hash(hash: r) as String }
      else if which == "engram" { serialize_content_hash(hash: e) as String }
      else { serialize_content_hash(hash: c) as String }
    V41CandidateUnestablished { obligations: _ } => "unestablished"
    V41CandidateRefused { defects: _ } => "refused"
  }
}

fn w_tiny_spec() -> V41RowStoreEncodingSpec {
  v41_encoding_spec_with_slices(
    partition: v41_candidate_partition,
    slices: [v41_tensor_slice(name: "layers.1.engram.embed.weight" as NonEmptyStr, global_rows: 8, layer: 1)],
  )
}

fn w_row(i: Nat) -> V41SourceRow {
  v41_source_row(tensor: "layers.1.engram.embed.weight" as NonEmptyStr, global_row: i, payload: join(["r", to_string(i)], "") as NonEmptyStr)
}

fn w_source() -> List<V41SourceRow> {
  [w_row(i: 0), w_row(i: 1), w_row(i: 2), w_row(i: 3), w_row(i: 4), w_row(i: 5), w_row(i: 6), w_row(i: 7)]
}

fn w_identified() -> V41RowStoreEncoding? {
  v41_fixture_encoding(source: w_source(), spec: w_tiny_spec())
}

fn w_image() -> V41OciImageDigest {
  v41_oci_image_digest(
    manifest: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as NonEmptyStr,
    config: "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" as NonEmptyStr,
  )
}

fn w_keys() -> List<ContentHash> {
  [
    content_hash_of_value(value: "row0" as NonEmptyStr), content_hash_of_value(value: "row1" as NonEmptyStr),
    content_hash_of_value(value: "row2" as NonEmptyStr), content_hash_of_value(value: "row3" as NonEmptyStr),
    content_hash_of_value(value: "row4" as NonEmptyStr), content_hash_of_value(value: "row5" as NonEmptyStr),
    content_hash_of_value(value: "row6" as NonEmptyStr), content_hash_of_value(value: "row7" as NonEmptyStr),
  ]
}

test fn control_patch_digest_or_order_changes_runtime_and_candidate_keys() -> Bool {
  let a = v41_candidate_standing(c: w_default(patches: w_two_patches()))
  let b = v41_candidate_standing(c: w_default(patches: w_observed(pairs: [WPatchSpec { path: "engram_storage.patch", c: "9" }, WPatchSpec { path: "engram_prefetch.patch", c: "2" }], partition: PartitionByLaunchConfiguration)))
  let ba = v41_candidate_standing(c: w_default(patches: w_observed(pairs: [WPatchSpec { path: "engram_prefetch.patch", c: "2" }, WPatchSpec { path: "engram_storage.patch", c: "1" }], partition: PartitionByLaunchConfiguration)))
  w_key(s: a, which: "runtime") != w_key(s: b, which: "runtime")
    && w_key(s: a, which: "candidate") != w_key(s: b, which: "candidate")
    && w_key(s: a, which: "runtime") != w_key(s: ba, which: "runtime")
}

test fn control_weight_or_tokenizer_change_moves_source_and_candidate_keys() -> Bool {
  let a = w_default(patches: w_two_patches())
  let b = V41CandidateInputs {
    runtime: a.runtime,
    model_source: V41ModelSourceInputs {
      checkpoint_revision: a.model_source.checkpoint_revision,
      weights: V41ManifestObserved { digest: w_sha(c: "z") },
      tokenizer: a.model_source.tokenizer,
    },
    engram: a.engram,
    topology: a.topology,
    device: a.device,
  }
  w_key(s: v41_candidate_standing(c: a), which: "candidate") != w_key(s: v41_candidate_standing(c: b), which: "candidate")
}

test fn control_route_b_versus_d_moves_engram_not_runtime() -> Bool {
  let b = v41_candidate_standing(c: w_default(patches: w_two_patches()))
  let d = v41_candidate_standing(c: w_inputs(patches: w_two_patches(), partition: v41_candidate_partition, route: engram_route_d_identity))
  w_key(s: b, which: "runtime") == w_key(s: d, which: "runtime")
    && w_key(s: b, which: "engram") != w_key(s: d, which: "engram")
}

test fn control_partition_set_reordering_does_not_change_identity() -> Bool {
  let a = v41_candidate_partition
  let swapped = V41EngramResidencyPartition {
    storage_backed: a.storage_backed.sort_by(n => n as String),
    resident: a.resident.sort_by(n => n as String),
  }
  w_key(s: v41_candidate_standing(c: w_default(patches: w_two_patches())), which: "engram")
    == w_key(s: v41_candidate_standing(c: w_inputs(patches: w_two_patches(), partition: swapped, route: engram_route_b_identity)), which: "engram")
}

test fn control_incomplete_manifests_stay_unestablished() -> Bool {
  let a = w_default(patches: w_two_patches())
  let incomplete = V41CandidateInputs {
    runtime: a.runtime,
    model_source: V41ModelSourceInputs {
      checkpoint_revision: a.model_source.checkpoint_revision,
      weights: V41ManifestUnestablished { obligation: "weights unread" as NonEmptyStr },
      tokenizer: a.model_source.tokenizer,
    },
    engram: a.engram,
    topology: a.topology,
    device: a.device,
  }
  match v41_candidate_standing(c: incomplete).standing {
    V41CandidateUnestablished { obligations: o } => any(o, x => (x as String).contains("weights unread"))
    V41CandidateKeyed { runtime_artifact: _, model_source: _, engram_realization: _, execution_profile: _, candidate: _, authorization_obligation: _ } => false
    V41CandidateRefused { defects: _ } => false
  }
}

test fn control_wrong_row_store_encoding_or_range_refuses_faithfulness() -> Bool {
  match v41_transform_fixture(source: w_source(), spec: w_tiny_spec()) {
    V41FixtureCorrespondenceHolds { subject: sub, placed: placed, encoding: _ } => match sub {
      V41FixtureRows { row_count: n, how: how } =>
        n == 8
          && (how as String).contains("not the published")
          && v41_sample_agrees(placed: placed, tensor: "layers.1.engram.embed.weight" as NonEmptyStr, global_row: 3, payload: "r3" as NonEmptyStr)
          && v41_tampered_payload_is_unfaithful(source: w_source(), spec: w_tiny_spec(), tamper: "NOT-THE-SOURCE" as NonEmptyStr)
          && !v41_tampered_payload_is_unfaithful(source: w_source(), spec: w_tiny_spec(), tamper: "r0" as NonEmptyStr)
          && v41_dropped_source_row_is_unfaithful(source: w_source(), spec: w_tiny_spec())
          && length(placed) == 8
      V41PublishedEngramShards => false
    }
    V41PublishedTransformUnestablished { obligation: _ } => false
    V41TransformUnfaithful { defects: _ } => false
  }
}

test fn fixture_correspondence_does_not_establish_the_published_shards() -> Bool {
  match v41_transform_fixture(source: w_source(), spec: w_tiny_spec()) {
    V41FixtureCorrespondenceHolds { subject: sub, placed: placed, encoding: e } => match sub {
      V41PublishedEngramShards => false
      V41FixtureRows { row_count: n, how: _ } =>
        length(placed) == 8
          && n == 8
          && length(v41_rank_stores_of(e: e)) == 4
          && match v41_encoding_spec_key_of(e: e) {
            Absent => false
            Present { value: sk } => match v41_encoding_digest_of(e: e) {
              Absent => false
              Present { value: d } =>
                serialize_content_hash(hash: sk) as String != serialize_content_hash(hash: d) as String
                  && match v41_encoding_spec_of(e: e) {
                    Absent => false
                    Present { value: spec } => (spec.component.decl_name as String) == "deepseek_v4_1_engram_component"
                      && match v41_published_transform_standing() {
                        V41PublishedTransformUnestablished { obligation: o } => (o as String).contains("published Engram shards")
                        V41FixtureCorrespondenceHolds { subject: _, placed: _, encoding: _ } => false
                        V41TransformUnfaithful { defects: _ } => false
                      }
                  }
            }
          }
    }
    V41PublishedTransformUnestablished { obligation: _ } => false
    V41TransformUnfaithful { defects: _ } => false
  }
}

test fn control_mismatched_rank_store_refuses_distributed_launch() -> Bool {
  match w_identified() {
    Absent => false
    Present { value: enc } => match v41_rank_digest_of(e: enc, rank: 0) {
      Absent => false
      Present { value: d0 } => match v41_distributed_launch(
        opened: [
          v41_open_rank_store(path: "/nvme/rank0.engram" as NonEmptyStr, expected: d0, observed: d0, rank: 0),
          v41_open_rank_store(path: "/nvme/rank1.engram" as NonEmptyStr, expected: d0, observed: d0, rank: 1),
        ],
        encoding: enc,
      ) {
        V41StoreOpenRefused { defects: ds } => any(ds, x => (x as String).contains("distributed launch refuses"))
        V41StoreHandle { path: _, expected: _, observed: _, rank: _ } => false
      }
    }
  }
}

test fn control_full_engram_pinned_allocation_refuses_the_candidate() -> Bool {
  match v41_candidate_refuses_full_pin(obs: v41_observe_pinned(pinned_bytes: byte_size(count: 100), table_bytes: byte_size(count: 100))) {
    Present { value: V41CandidateRealizationRefused { defects: d } } => any(d, x => (x as String).contains("full Engram pinned"))
    Present { value: V41CandidateRealized { realized_runtime: _, row_store: _, execution_profile: _, candidate: _, authorization_obligation: _ } } => false
    Present { value: V41CandidateRealizationUnestablished { obligations: _ } } => false
    Absent => false
  }
}

test fn a_bounded_staging_pin_is_not_a_full_table_pin() -> Bool {
  match v41_candidate_refuses_full_pin(obs: v41_observe_pinned(pinned_bytes: byte_size(count: 8), table_bytes: byte_size(count: 100))) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn control_missing_local_store_cannot_use_nfs() -> Bool {
  match v41_token_time(placement: RemoteNetwork, local_present: false) {
    V41TokenTimeRefused { defects: d } => any(d, x => (x as String).contains("NFS"))
    V41TokenTimeLocal { placement: _ } => false
  }
    && match v41_token_time(placement: LocalFilesystem, local_present: false) {
      V41TokenTimeRefused { defects: d } => any(d, x => (x as String).contains("missing"))
      V41TokenTimeLocal { placement: _ } => false
    }
}

test fn control_published_infeasibility_is_not_weakened_by_a_keyed_specification() -> Bool {
  v41_specification_is_not_selectable(spec: v41_candidate_standing(c: w_default(patches: V41PatchesAbsentByObservation)))
    && match v41_candidate().standing {
      V41CandidateUnestablished { obligations: _ } => true
      V41CandidateKeyed { runtime_artifact: _, model_source: _, engram_realization: _, execution_profile: _, candidate: _, authorization_obligation: _ } => false
      V41CandidateRefused { defects: _ } => false
    }
}

test fn a_keyed_specification_is_not_selectable_even_when_every_axis_keys() -> Bool {
  v41_specification_is_not_selectable(spec: v41_candidate_standing(c: w_default(patches: w_two_patches())))
}

test fn realized_identity_requires_produced_image_digest_and_consumed_patches() -> Bool {
  let spec = v41_candidate_standing(c: w_default(patches: w_two_patches()))
  match spec.standing {
    V41CandidateKeyed { runtime_artifact: rk, model_source: _, engram_realization: _, execution_profile: _, candidate: _, authorization_obligation: _ } =>
      match v41_realized_runtime(spec_runtime: rk, image: w_image(), provenance: AdoptedUnderExpectedTag, consumed: V41PatchesConsumedByImage { patch_digests: ["p" as NonEmptyStr] }) {
        V41RuntimeRealizationRefused { defects: d } => any(d, x => (x as String).contains("tag"))
        V41RuntimeRealized { specification_runtime_key: _, image: _, consumed_patches: _, realized_runtime_key: _ } => false
        V41RuntimeRealizationUnestablished { obligations: _ } => false
      }
    V41CandidateUnestablished { obligations: _ } => false
    V41CandidateRefused { defects: _ } => false
  }
}

test fn only_the_realized_candidate_is_selectable() -> Bool {
  let spec = v41_candidate_standing(c: w_default(patches: w_two_patches()))
  match spec.standing {
    V41CandidateKeyed { runtime_artifact: rk, model_source: _, engram_realization: _, execution_profile: _, candidate: _, authorization_obligation: _ } =>
      match w_identified() {
        Absent => false
        Present { value: enc } => match v41_selectable(realized: v41_realized_candidate(
          runtime: v41_realized_runtime(spec_runtime: rk, image: w_image(), provenance: BuiltByThisRun, consumed: V41PatchesConsumedByImage { patch_digests: ["p" as NonEmptyStr] }),
          row_store: enc,
          spec: spec,
        )) {
          V41Selectable { candidate: _ } => true
          V41NotSelectable { reason: _ } => false
        }
      }
    V41CandidateUnestablished { obligations: _ } => false
    V41CandidateRefused { defects: _ } => false
  }
}

test fn adversarial_trace_larger_than_cache_evicts_and_stays_in_bound() -> Bool {
  let limits = v41_residency_limits(
    configured_cache: byte_size(count: 40),
    effective_cache: byte_size(count: 40),
    configured_staging: byte_size(count: 16),
    effective_staging: byte_size(count: 16),
    configured_inflight_io: byte_size(count: 16),
    effective_inflight_io: byte_size(count: 16),
  )
  match v41_residency_under_trace(limits: limits, keys: w_keys(), row_bytes: byte_size(count: 10)) {
    V41ResidencyWithinBound { limits: _, occupancy: o, evicted: e } => e > 0 && byte_size_count(b: o) <= 40
    V41ResidencyExceeded { defects: _ } => false
  }
}

test fn exceeding_configured_cache_refuses() -> Bool {
  let over = v41_residency_limits(
    configured_cache: byte_size(count: 10),
    effective_cache: byte_size(count: 40),
    configured_staging: byte_size(count: 16),
    effective_staging: byte_size(count: 16),
    configured_inflight_io: byte_size(count: 16),
    effective_inflight_io: byte_size(count: 16),
  )
  match v41_residency_under_trace(limits: over, keys: w_keys(), row_bytes: byte_size(count: 10)) {
    V41ResidencyExceeded { defects: d } => any(d, x => (x as String).contains("effective cache exceeds"))
    V41ResidencyWithinBound { limits: _, occupancy: _, evicted: _ } => false
  }
}

test fn staging_verifies_readback_and_refuses_a_wrong_rank_identity() -> Bool {
  match w_identified() {
    Absent => false
    Present { value: enc } => match v41_staging_request(image: w_image(), encoding: enc) {
      Absent => false
      Present { value: req } => {
        let good = v41_staged_matching(encoding: enc)
        let bad = v41_staged_with_readback(encoding: enc, readback: content_hash_of_value(value: "nope" as NonEmptyStr))
        (match v41_stage(request: req, image_readback: w_image().manifest, rank_readbacks: good, provenance: BuiltByThisRun) {
          V41StagingVerified { request_key: _, image_readback: _, ranks: rs } => length(rs) == 4
          V41StagingRefused { defects: _ } => false
          V41StagingUnestablished { obligation: _ } => false
        })
          && (match v41_stage(request: req, image_readback: w_image().manifest, rank_readbacks: bad, provenance: BuiltByThisRun) {
            V41StagingRefused { defects: d } => any(d, x => (x as String).contains("readback"))
            V41StagingVerified { request_key: _, image_readback: _, ranks: _ } => false
            V41StagingUnestablished { obligation: _ } => false
          })
          && (match v41_group_a_staging_standing {
            V41StagingUnestablished { obligation: o } => (o as String).contains("V4 Flash")
            V41StagingVerified { request_key: _, image_readback: _, ranks: _ } => false
            V41StagingRefused { defects: _ } => false
          })
      }
    }
  }
}

test fn the_live_storage_backed_patches_are_not_minted_from_transcribed_hex() -> Bool {
  match v41_storage_backed_patch_population() {
    V41PatchesObserved { patches: _, partition: _ } => false
    V41PatchesAbsentByObservation => false
    V41PatchesUnestablished { obligation: o } =>
      (o as String).contains("DigestFile") && (o as String).contains("engram_file_backed.py")
  }
}

fn w_entry(name: String, shape: List<Nat>) -> SafetensorsEntry {
  safetensors_entry(name: name as NonEmptyStr, dtype: SafeF8E4M3, shape: shape, begin_offset: 0, end_offset: 1)
}

fn w_backed(name: String) -> V41EngramResidencyPartition {
  V41EngramResidencyPartition { storage_backed: [name as NonEmptyStr], resident: [] as List<NonEmptyStr> }
}

test fn a_tensor_name_decomposes_to_its_layer_index_and_refuses_an_unrecognized_spelling() -> Bool {
  match v41_layer_index_from_tensor_name(name: "layers.14.engram.embed.weight" as NonEmptyStr) {
    Present { value: n } => n == 14
    Absent => false
  }
    && match v41_layer_index_from_tensor_name(name: "layers.1.engram.embed.weight" as NonEmptyStr) {
      Present { value: n } => n == 1
      Absent => false
    }
    && match v41_layer_index_from_tensor_name(name: "engram.embed.weight" as NonEmptyStr) {
      Absent => true
      Present { value: _ } => false
    }
    && match v41_row_store_spec(population: [w_entry(name: "not-a-layer.embed.weight", shape: [8])], partition: w_backed(name: "not-a-layer.embed.weight")) {
      V41RowStoreEncodingRefused { defects: d } => any(d, x => (x as String).contains("unrecognized name"))
      V41RowStoreEncodingIdentified { spec: _, spec_key: _, rank_stores: _, content_digest: _ } => false
      V41RowStoreEncodingUnestablished { obligation: _ } => false
    }
}

test fn a_missing_shape_reading_refuses_rather_than_becoming_zero_rows() -> Bool {
  match v41_row_store_spec(population: [w_entry(name: "layers.1.engram.embed.weight", shape: [] as List<Nat>)], partition: w_backed(name: "layers.1.engram.embed.weight")) {
    V41RowStoreEncodingRefused { defects: d } => any(d, x => (x as String).contains("no shape reading"))
    V41RowStoreEncodingIdentified { spec: _, spec_key: _, rank_stores: _, content_digest: _ } => false
    V41RowStoreEncodingUnestablished { obligation: _ } => false
  }
}

test fn the_encoding_spec_key_moves_with_the_geometry_dtypes() -> Bool {
  let slices = [v41_tensor_slice(name: "layers.1.engram.embed.weight" as NonEmptyStr, global_rows: 8, layer: 1)]
  let a = v41_encoding_spec_key(spec: v41_encoding_spec_with_geometry(partition: v41_candidate_partition, slices: slices, geometry: v41_row_geometry_of(weight_dtype: SafeF8E4M3, scale_dtype: SafeF8E8M0, weight_width: 256, scale_width: 8)))
  let b = v41_encoding_spec_key(spec: v41_encoding_spec_with_geometry(partition: v41_candidate_partition, slices: slices, geometry: v41_row_geometry_of(weight_dtype: SafeF16, scale_dtype: SafeF8E8M0, weight_width: 256, scale_width: 8)))
  serialize_content_hash(hash: a) as String != serialize_content_hash(hash: b) as String
}
