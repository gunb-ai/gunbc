module test.claim.spark.v41_engram_access_probe_witness

import std.types { Bool, List, NonEmptyStr, String }
import v2.std.algebra { filter }
import std.measure { nanosecond_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.spark.v41_engram_access_probe {
  V41EngramAccessProbeOutcome, V41AccessProbeRead, V41AccessProbeRefused, v41_admit_access_reading,
  v41_access_per_row, v41_access_probe_argv, v41_access_probe_image, v41_access_probe_script,
  AccessMmapUnregistered, AccessPrefill262k, AccessCold,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ADMISSION AT ITS OWN INTERFACE, OVER SUPPLIED PROGRAM OUTPUT. The program runs only inside the
// arm A image on a Spark (the spark_v41_engram_access_probe fleet mode); these outputs have its
// line grammar.

data w_attrs_on: String = "ATTR pageable_memory_access 1\nATTR concurrent_managed_access 1\nATTR pageable_memory_access_uses_host_page_tables 1\n"
data w_attrs_off: String = "ATTR pageable_memory_access 0\nATTR concurrent_managed_access 1\nATTR pageable_memory_access_uses_host_page_tables 0\n"
data w_pinned: String = "TIME pinned warm decode 96 40 41 40 39\nTIME pinned warm prefill262k 1572864 9000 9000 9100 8990\nCHECK pinned ok\n"
data w_mmap: String = "TIME mmap_unregistered cold decode 96 900 900 910 890\nTIME mmap_unregistered warm decode 96 50 50 51 49\nTIME mmap_unregistered cold prefill262k 1572864 4718592000 4718592000 4800000000 4700000000\nTIME mmap_unregistered warm prefill262k 1572864 12000 12000 12100 11900\nCHECK mmap_unregistered ok\n"
data w_gather: String = "TIME cpu_gather cold decode 96 1200 1200 1210 1190\nTIME cpu_gather warm decode 96 300 300 301 299\nTIME cpu_gather cold prefill262k 1572864 6000000 6000000 6100000 5900000\nTIME cpu_gather warm prefill262k 1572864 400000 400000 401000 399000\nCHECK cpu_gather ok\n"

fn w_run(parts: List<String>) -> String {
  join(parts, "")
}

fn w_refused_with(o: V41EngramAccessProbeOutcome, needle: String) -> Bool {
  match o {
    V41AccessProbeRefused { step: _, cause: c } => contains(c as String, needle)
    V41AccessProbeRead { image_config: _, attributes: _, timings: _, mmap_not_attempted: _ } => false
  }
}

test fn a_complete_run_is_admitted_with_every_cell_and_per_row_latency() -> Bool {
  match v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: w_run(parts: [w_attrs_on, w_pinned, w_mmap, w_gather, "DONE\n"])) {
    V41AccessProbeRead { image_config: _, attributes: a, timings: ts, mmap_not_attempted: skipped } => {
      let cold_prefill = filter(ts, t => match t.path { AccessMmapUnregistered => match t.batch { AccessPrefill262k => match t.temperature { AccessCold => true  gunbc.spark.v41_engram_access_probe.AccessWarm => false }  gunbc.spark.v41_engram_access_probe.AccessDecodeStep => false }  gunbc.spark.v41_engram_access_probe.AccessPinnedUva => false  gunbc.spark.v41_engram_access_probe.AccessCpuGather => false })
      a.pageable_memory_access == 1 && !skipped && length(ts) == 10 && length(cold_prefill) == 1
        && length(filter(cold_prefill, t => nanosecond_count(n: v41_access_per_row(t: t)) == 3000)) == 1
    }
    V41AccessProbeRefused { step: _, cause: _ } => false
  }
}

// WITHOUT PAGEABLE ACCESS, DESIGN A IS NOT ATTEMPTED AND NOT OWED; the run is still a reading.
test fn without_pageable_access_design_a_is_not_owed() -> Bool {
  match v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: w_run(parts: [w_attrs_off, "SKIP mmap_unregistered pageable_memory_access=0\n", w_pinned, w_gather, "DONE\n"])) {
    V41AccessProbeRead { image_config: _, attributes: _, timings: ts, mmap_not_attempted: skipped } => skipped && length(ts) == 6
    V41AccessProbeRefused { step: _, cause: _ } => false
  }
}

// THE REDS: an unread attribute, the program's own refusal, a missing cell, a failed byte check, and
// a run that never reached DONE each refuse instead of reporting.
test fn an_unread_device_attribute_refuses() -> Bool {
  w_refused_with(o: v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: w_run(parts: ["ATTR pageable_memory_access 1\nATTR concurrent_managed_access 1\n", w_pinned, w_mmap, w_gather, "DONE\n"])), needle: "UsesHostPageTables")
}

test fn the_programs_refusal_is_carried() -> Bool {
  w_refused_with(o: v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: w_run(parts: [w_attrs_on, "REFUSED cold not established: 4096 store bytes stayed resident\n"])), needle: "cold not established")
}

test fn a_missing_cell_refuses() -> Bool {
  let no_warm_gather = "TIME cpu_gather cold decode 96 1200 1200\nTIME cpu_gather cold prefill262k 1572864 6000000 6000000\nTIME cpu_gather warm prefill262k 1572864 400000 400000\nCHECK cpu_gather ok\n"
  w_refused_with(o: v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: w_run(parts: [w_attrs_on, w_pinned, w_mmap, no_warm_gather, "DONE\n"])), needle: "cell cpu_gather warm decode appears 0 times")
}

test fn a_failed_byte_check_or_no_done_refuses() -> Bool {
  let unchecked = w_run(parts: [w_attrs_on, w_pinned, w_mmap, "TIME cpu_gather cold decode 96 1 1\nTIME cpu_gather warm decode 96 1 1\nTIME cpu_gather cold prefill262k 1572864 1 1\nTIME cpu_gather warm prefill262k 1572864 1 1\nCHECK cpu_gather mismatch\n", "DONE\n"])
  let unfinished = w_run(parts: [w_attrs_on, w_pinned, w_mmap, w_gather])
  w_refused_with(o: v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: unchecked), needle: "no byte check passed for cpu_gather")
    && w_refused_with(o: v41_admit_access_reading(image_config: "sha256:ea39" as NonEmptyStr, stdout: unfinished), needle: "did not reach DONE")
}

// THE PROGRAM IT SENDS: bounded by timeout, in the arm A image by config digest, run from a file (Triton
// reads kernel source from it), reading the three device attributes and establishing cold by dropping
// and reading back the page cache.
test fn the_probe_runs_the_bounded_program_in_the_arm_a_image() -> Bool {
  let argv = v41_access_probe_argv(image: v41_access_probe_image)
  let script = v41_access_probe_script()
  contains(join(argv, " "), "--entrypoint timeout sha256:ea39410ed01d396caad86339d877c1adb181a983baadffd22c722069109ea664 2700 python3 -c import sys, runpy;")
    && contains(join(argv, " "), "runpy.run_path(path, run_name='__main__')")
    && contains(script, "cudaDeviceGetAttribute")
    && contains(script, "POSIX_FADV_DONTNEED")
    && contains(script, "values = {}")
}
