// ── THE RELEASE DECISION, OVER SUPPLIED READINGS ────────────────────────────────────────────────────
//
// The release settles through the same transaction as a suspension; what is new is the decision over
// the readings and the subject's intent. Both are pure, so every arm is driven here with a constructed
// observation; the fleet readings themselves are D0's observer's, executed by its wet door.

fn rw_sha(hex: String) -> ContentHash? {
  match sha256_hex_digest(hex: hex) {
    Absent => none
    Present { value: d } => Present { value: Sha256Hash(d) }
  }
}

fn rw_release_subject() -> D0Subject {
  D0Subject { group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), operation: D0ReleaseToFleet { cause: "witness cause" as NonEmptyStr, approval: "witness approval" as NonEmptyStr } }
}

fn rw_grant(h: ContentHash) -> OperatorGrant<D0Subject> {
  OperatorGrant {
    escalation_id: "rel-w" as NonEmptyStr,
    subject: rw_release_subject(),
    scopes: [d0_release_scope()],
    purpose: "witness release" as NonEmptyStr,
    attempt: "tx-rel" as AttemptIdentity,
    intent_hash: h,
    granted_by: "witness" as NonEmptyStr,
    granted_at: "2026-10-03T00:00:00Z",
    expires_at: "2026-10-04T00:00:00Z",
  }
}

fn rw_lease(h: ContentHash) -> HeldLease {
  held_lease(epoch: LeaseEpoch { lease_key: "tx-rel" as NonEmptyStr, resource_fingerprint: h, owner_fingerprint: h, generation: 1 }, observed: LeaseRunningExpected)
}

fn rw_active() -> PairServingGroupAuthority {
  PairServingActive { group: FabricGroupA, exact_realization: PairRealizationUnestablished { obligation: "witness" as NonEmptyStr } }
}

fn rw_empty(h: HostIdentity) -> RankVacancyReading {
  RankVacancyReading { host: h, reading: HostOccupancyRead { occupants: [], available: kibibyte(count: 120000000) } }
}

fn rw_quiet_vacancy() -> List<RankVacancyReading> {
  map(fabric_group_hosts(g: FabricGroupA), h => rw_empty(h: h))
}

fn rw_quiet_route() -> IncumbentReading {
  IncumbentDidNotAnswer { receipt: "the front door could not be connected" as NonEmptyStr, head: HeadEndpointQuiet }
}

fn rw_decide(h: ContentHash, incumbent: IncumbentReading, vacancy: List<RankVacancyReading>) -> D0Decision {
  d0_decide(
    declared: DeclaredPairRealizationUnavailable { group: FabricGroupA, obligation: "a release reads no declared realization" as NonEmptyStr },
    observation: D0Observation { group: FabricGroupA, incumbent: incumbent, ranks: [] as List<RankOccupancyReading>, vacancy: vacancy },
    active: rw_active(),
    lease: rw_lease(h: h),
    grant: rw_grant(h: h),
  )
}

fn rw_with(scenario: fn(ContentHash) -> Bool) -> Bool {
  match rw_sha(hex: "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd") {
    Absent => false
    Present { value: h } => scenario(h)
  }
}

fn rw_not_quiescent(d: D0Decision, fragment: String) -> Bool {
  match d {
    D0DecidedFence { next: FencedRefusal { group: _, hosts: _, cause: c, disposition_authority: _ }, cause: D0HostNotQuiescent { cause: _ } } => string_contains(s: c as String, pattern: fragment)
    D0DecidedFence { next: _, cause: _ } => false
    D0DecidedRelease { group: _, hosts: _ } => false
    D0DecidedSuspend { next: _, reconciliation: _ } => false
    D0DecidedRestore { next: _, key: _ } => false
  }
}

// THE POSITIVE CONTROL: a silent route, a quiet head and every host read with no occupant releases --
// and the next authority is ReleasedToFleet naming exactly the recorded receipt, which commits no host.
test fn rw_every_host_quiescent_releases_under_the_receipt() -> Bool {
  rw_with(scenario: fn(h) {
    let d = rw_decide(h: h, incumbent: rw_quiet_route(), vacancy: rw_quiet_vacancy())
    d0_decision_is_eligible(d: d)
      && match d0_decision_next(d: d, entry_state: h) {
        ReleasedToFleet { group: _, release_receipt: r } => content_hash_equal(left: r, right: h)
        _ => false
      }
      && length(pair_serving_committed_hosts(a: d0_decision_next(d: d, entry_state: h))) == 0
  })
}

// ONE REFUSAL PER OCCUPANT READING KIND.
test fn rw_an_answering_front_door_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) { rw_not_quiescent(d: rw_decide(h: h, incumbent: IncumbentAnsweredUnread { cause: "witness 500" as NonEmptyStr }, vacancy: rw_quiet_vacancy()), fragment: "front door answered") })
}

test fn rw_a_listener_on_the_head_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) { rw_not_quiescent(d: rw_decide(h: h, incumbent: IncumbentDidNotAnswer { receipt: "curl 7" as NonEmptyStr, head: HeadEndpointListening { port: 30000, rows: [] as List<TcpSocketRow> } }, vacancy: rw_quiet_vacancy()), fragment: "LISTEN on port 30000") })
}

test fn rw_an_engine_process_on_the_head_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) { rw_not_quiescent(d: rw_decide(h: h, incumbent: IncumbentDidNotAnswer { receipt: "curl 7" as NonEmptyStr, head: HeadEndpointEngineProcess { listing: "4242 vllm" } }, vacancy: rw_quiet_vacancy()), fragment: "engine process") })
}

test fn rw_a_running_serving_unit_on_any_host_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) {
    let vacancy = concat(
      [RankVacancyReading { host: operator_host_srv7, reading: HostOccupancyRead { occupants: [ServingUnitActive { unit: spark_pair_worker_unit_name, state: Active }], available: kibibyte(count: 1) } }],
      map(filter(fabric_group_hosts(g: FabricGroupA), x => (x as String) != (operator_host_srv7 as String)), x => rw_empty(h: x)))
    rw_not_quiescent(d: rw_decide(h: h, incumbent: rw_quiet_route(), vacancy: vacancy), fragment: "srv7 is occupied")
  })
}

test fn rw_a_gpu_process_on_any_host_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) {
    let vacancy = concat(
      [RankVacancyReading { host: operator_host_srv8, reading: HostOccupancyRead { occupants: [GpuComputeProcess { pid: 99, process_name: "python3", used: UsedMemoryReported { used: mebibyte(count: 1000) } }], available: kibibyte(count: 1) } }],
      map(filter(fabric_group_hosts(g: FabricGroupA), x => (x as String) != (operator_host_srv8 as String)), x => rw_empty(h: x)))
    rw_not_quiescent(d: rw_decide(h: h, incumbent: rw_quiet_route(), vacancy: vacancy), fragment: "srv8 is occupied")
  })
}

// ABSENCE IS NOT VACANCY: an unread host, and a host with no reading at all, refuse.
test fn rw_an_unread_or_missing_host_refuses_the_release() -> Bool {
  rw_with(scenario: fn(h) {
    let unread = concat(
      [RankVacancyReading { host: operator_host_srv5, reading: HostOccupancyUnread { cause: "witness: nvidia-smi did not run" } }],
      map(filter(fabric_group_hosts(g: FabricGroupA), x => (x as String) != (operator_host_srv5 as String)), x => rw_empty(h: x)))
    let missing = map(filter(fabric_group_hosts(g: FabricGroupA), x => (x as String) != (operator_host_srv6 as String)), x => rw_empty(h: x))
    rw_not_quiescent(d: rw_decide(h: h, incumbent: rw_quiet_route(), vacancy: unread), fragment: "occupancy unread")
      && rw_not_quiescent(d: rw_decide(h: h, incumbent: rw_quiet_route(), vacancy: missing), fragment: "no occupancy reading was taken")
  })
}

// AN UNREAD ROUTE FENCES as D0's other unread readings do, never releases.
test fn rw_an_unread_route_never_releases() -> Bool {
  rw_with(scenario: fn(h) {
    match rw_decide(h: h, incumbent: IncumbentRouteUnread { cause: "witness" as NonEmptyStr }, vacancy: rw_quiet_vacancy()) {
      D0DecidedRelease { group: _, hosts: _ } => false
      D0DecidedFence { next: _, cause: _ } => true
      D0DecidedSuspend { next: _, reconciliation: _ } => false
      D0DecidedRestore { next: _, key: _ } => false
    }
  })
}

// AN ALREADY-RELEASED GROUP IS REFUSED: a held claim with no write and an authority that is not Active
// has nothing to do under this consent, so the recovery join aborts the claim rather than writing.
test fn rw_an_already_released_group_is_refused() -> Bool {
  rw_with(scenario: fn(h) {
    match d0_recovery(
      claim: D0ClaimAt { state: ClaimedBy { attempt: "tx-rel" as AttemptIdentity, claimed_at: "2026-10-03T00:00:00Z" }, generation: 1 },
      transaction: "tx-rel" as NonEmptyStr,
      lifecycle: Present { value: h },
      executor: "srv1" as NonEmptyStr,
      current: ReleasedToFleet { group: FabricGroupA, release_receipt: h },
      transitions: [] as List<AuthorityTransitionRecord>,
    ) {
      D0RecoverAbort { claim_generation: _, cause: c } => string_contains(s: c, pattern: "not Active")
      _ => false
    }
  })
}

// ── THE INTENT: A RELEASE ROUND-TRIPS UNDER ITS OWN SCOPE, AND IS NOT A SUSPENSION ─────────────────

test fn rw_a_release_intent_round_trips_under_the_release_scope() -> Bool {
  match d0_intent_text(subject: rw_release_subject(), group: FabricGroupA, transaction: "tx-rel" as NonEmptyStr) {
    Absent => false
    Present { value: text } =>
      (match parse_d0_intent_text(text: text) {
        Absent => false
        Present { value: p } => match p.subject.operation {
          D0ReleaseToFleet { cause: c, approval: a } => (c as String) == "witness cause" && (a as String) == "witness approval"
          D0SuspendForSuccessor { successor: _, cleanup: _, term: _ } => false
        }
      })
      && (match parse_intent_scopes(text: text) {
        Absent => false
        Present { value: f } => all(f.scopes, sc => authorization_scope_eq(a: sc, b: d0_release_scope())) && !any(f.scopes, sc => authorization_scope_eq(a: sc, b: d0_required_scope()))
      })
  }
}

// THE RELEASE IS REQUESTED BY ITS ROW: the row's escalation yields a release subject for Group A, any
// other escalation the suspension for the keyed successor.
test fn rw_the_approved_release_row_names_group_a_and_its_escalation() -> Bool {
  match d0_release_row_for(group: FabricGroupA, escalation_id: d0_release_lifecycle_escalation_id) {
    Absent => false
    Present { value: r } => string_contains(s: r.approval as String, pattern: "operator approval 2026-10-03")
  }
    && match d0_release_row_for(group: FabricGroupA, escalation_id: "some-other-escalation" as NonEmptyStr) { Present { value: _ } => false  Absent => true }
}

// THE STORE WALL ADMITS EXACTLY THE RULED RELEASE LIFECYCLE: its escalation on Group A while the row
// stands; another escalation, Group B, or the row retired all refuse.
test fn rw_the_store_wall_admits_only_the_ruled_release_lifecycle() -> Bool {
  d0_single_lifecycle_admits_under(standing: Standing, group: FabricGroupA, escalation_id: d0_release_lifecycle_escalation_id)
    && !d0_single_lifecycle_admits_under(standing: Standing, group: FabricGroupA, escalation_id: "d0-group-a-something-else" as NonEmptyStr)
    && !d0_single_lifecycle_admits_under(standing: Standing, group: FabricGroupB, escalation_id: d0_release_lifecycle_escalation_id)
    && !d0_single_lifecycle_admits_under(standing: Retired { trigger_fired: "witness" as NonEmptyStr }, group: FabricGroupA, escalation_id: d0_release_lifecycle_escalation_id)
}

// ── THE STANDING OPERATOR GRANT (gunbc.auth.standing_operator_grant) ────────────────────────────────

fn rw_release_request(group: FabricGroup, hosts: List<HostIdentity>, h: ContentHash) -> AuthorizationRequest<D0Subject> {
  AuthorizationRequest {
    escalation_id: d0_release_lifecycle_escalation_id,
    scopes: [d0_release_scope()],
    subject: D0Subject { group: group, hosts: hosts, operation: D0ReleaseToFleet { cause: "witness cause" as NonEmptyStr, approval: "witness approval" as NonEmptyStr } },
    purpose: "witness release" as NonEmptyStr,
    attempt: "tx-rel" as AttemptIdentity,
    intent_hash: h,
    destructive: true,
  }
}

// THE POSITIVE CONTROL: a Group A release over srv5-srv8 is admitted under the standing grant, and the
// grant it mints is permitted by std.scoped_authorization authorize over that exact request.
test fn rw_a_group_a_release_is_admitted_under_the_standing_grant() -> Bool {
  rw_with(scenario: fn(h) {
    let req = rw_release_request(group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), h: h)
    match d0_standing_grant_for(request: req) {
      Absent => false
      Present { value: g } =>
        match authorize(authorization: standing_grant_authorization(g: g, request: req, issued: "2026-10-03T05:10:00Z", expires: "2026-10-03T05:40:00Z"), request: req, observed_at: "2026-10-03T05:11:00Z") {
          AuthorizationPermitted { grant: _ } => true
          AuthorizationRefused { cause: _ } => false
        }
    }
  })
}

// THE SAME REQUEST FOR GROUP B IS NOT COVERED: it goes to the broker, and refuses without it.
test fn rw_the_same_release_for_group_b_is_not_covered() -> Bool {
  rw_with(scenario: fn(h) {
    match d0_standing_grant_for(request: rw_release_request(group: FabricGroupB, hosts: fabric_group_hosts(g: FabricGroupB), h: h)) {
      Present { value: _ } => false
      Absent => true
    }
  })
}

// AN EFFECT OUTSIDE THE SCOPE IS NOT COVERED: a host outside srv5-srv8, and a suspension (an effect the
// grant does not name) both fall back to the broker.
test fn rw_an_effect_outside_the_scope_is_not_covered() -> Bool {
  rw_with(scenario: fn(h) {
    let foreign_host = match d0_standing_grant_for(request: rw_release_request(group: FabricGroupA, hosts: concat(fabric_group_hosts(g: FabricGroupA), ["srv9" as HostIdentity]), h: h)) { Present { value: _ } => false  Absent => true }
    let suspend = AuthorizationRequest {
      escalation_id: d0_release_lifecycle_escalation_id,
      scopes: [d0_required_scope()],
      subject: D0Subject { group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), operation: D0SuspendForSuccessor { successor: h, cleanup: QuiescentReservedBaseline, term: second(count: 1000) } },
      purpose: "witness suspend" as NonEmptyStr,
      attempt: "tx-rel" as AttemptIdentity,
      intent_hash: h,
      destructive: true,
    }
    foreign_host && match d0_standing_grant_for(request: suspend) { Present { value: _ } => false  Absent => true }
      && !standing_grant_covers(g: group_a_dev_standing_grant, group: FabricGroupA, effect: StandingArmLaunch, hosts: [] as List<HostIdentity>)
  })
}

// ── A STANDING GRANT IS ONE LIFECYCLE ACROSS RERUNS (side-chat review of #13067) ────────────────────
//
// Each run mints the standing grant with ITS OWN live window, so the binding must not carry that window:
// a crash after the pending write, or after ReleasedToFleet before the claim completed, must be finished by
// a later rerun whose window differs. The binding text is what D0 digests (admitted_with_binding hashes
// exactly this text), so equal texts are equal bindings. Supplied here at the recovery join's interface:
// the lifecycle digests stand in for the SHA-256 of each run's text.
fn rw_permitted(req: AuthorizationRequest<D0Subject>, issued: String, expires: String, at: String) -> OperatorGrant<D0Subject>? {
  match d0_standing_grant_for(request: req) {
    Absent => none
    Present { value: g } =>
      match authorize(authorization: standing_grant_authorization(g: g, request: req, issued: issued, expires: expires), request: req, observed_at: at) {
        AuthorizationPermitted { grant: p } => Present { value: p }
        AuthorizationRefused { cause: _ } => none
      }
  }
}

data rw_standing_basis: D0AuthorizationBasis = D0BasisStandingGrant { identity: group_a_dev_standing_grant.identity }

fn rw_two_runs(h: ContentHash, f: fn(String, String) -> Bool) -> Bool {
  let req = rw_release_request(group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), h: h)
  match rw_permitted(req: req, issued: "2026-10-03T05:10:00Z", expires: "2026-10-03T05:40:00Z", at: "2026-10-03T05:11:00Z") {
    Absent => false
    Present { value: first } => match rw_permitted(req: req, issued: "2026-10-03T09:00:00Z", expires: "2026-10-03T09:30:00Z", at: "2026-10-03T09:01:00Z") {
      Absent => false
      Present { value: later } => f(d0_binding_text_with(grant: first, claim_generation: 1, basis: rw_standing_basis), d0_binding_text_with(grant: later, claim_generation: 1, basis: rw_standing_basis))
    }
  }
}

// THE BINDING: two runs of one standing release with different windows bind the same lifecycle and name
// the grant; the expiry is not in it. (A broker grant keeps its expiry: d0_binding_lifecycle_term's other
// arm, unchanged, exercised by the suspension witnesses.)
test fn rw_a_standing_release_binds_one_lifecycle_across_windows() -> Bool {
  rw_with(scenario: fn(h) {
    rw_two_runs(h: h, f: fn(a, b) {
      a == b && string_contains(s: a, pattern: join(["standing_grant=", group_a_dev_standing_grant.identity as String], "")) && !string_contains(s: a, pattern: "expires_at=")
    })
  })
}

// PENDING -> A LATER RERUN RESUMES: the first run wrote the pending state under its binding and died; the
// later run, with a later window, presents its own binding and the recovery join resumes.
test fn rw_a_pending_release_is_resumed_by_a_later_rerun() -> Bool {
  rw_with(scenario: fn(h) {
    rw_two_runs(h: h, f: fn(a, b) {
      let first = content_hash_of_value(value: a as NonEmptyStr)
      let later = content_hash_of_value(value: b as NonEmptyStr)
      match d0_recovery(
        claim: D0ClaimAt { state: ClaimedBy { attempt: "tx-rel" as AttemptIdentity, claimed_at: "2026-10-03T05:11:00Z" }, generation: 1 },
        transaction: "tx-rel" as NonEmptyStr,
        lifecycle: Present { value: later },
        executor: "witness" as NonEmptyStr,
        current: d0w_pending(tx: "tx-rel", h: first),
        transitions: [d0w_rec_of(id: "e1", tx: "tx-rel", lifecycle: Present { value: first }, next: d0w_pending(tx: "tx-rel", h: first))],
      ) {
        D0RecoverResume { claim_generation: _ } => true
        _ => false
      }
    })
  })
}

// SETTLED RELEASE -> A LATER RERUN COMPLETES THE CLAIM: the release landed (ReleasedToFleet) and the run
// died before completing its claim; the later run finds its own lifecycle's settling record and completes.
test fn rw_a_settled_release_is_completed_by_a_later_rerun() -> Bool {
  rw_with(scenario: fn(h) {
    rw_two_runs(h: h, f: fn(a, b) {
      let first = content_hash_of_value(value: a as NonEmptyStr)
      let later = content_hash_of_value(value: b as NonEmptyStr)
      let released = ReleasedToFleet { group: FabricGroupA, release_receipt: h }
      match d0_recovery(
        claim: D0ClaimAt { state: ClaimedBy { attempt: "tx-rel" as AttemptIdentity, claimed_at: "2026-10-03T05:11:00Z" }, generation: 1 },
        transaction: "tx-rel" as NonEmptyStr,
        lifecycle: Present { value: later },
        executor: "witness" as NonEmptyStr,
        current: released,
        transitions: [d0w_rec_of(id: "e2", tx: "tx-rel", lifecycle: Present { value: first }, next: released)],
      ) {
        D0RecoverComplete { claim_generation: _, settled: _ } => true
        _ => false
      }
    })
  })
}

// ── THE GRANT IS HONORED ONLY AS THE OPERATOR MERGED IT (review 74677) ─────────────────────────────
//
// The judgement over the two reads, supplied at its interface: identical bytes honor; a main with no row,
// a branch-edited row, or an unreadable executed row do not. Then the door's coverage under each standing:
// the same covered Group A release is honored on main and NOT honored off it, so it takes the broker path.
test fn rw_the_grant_row_is_honored_only_when_byte_identical_to_main() -> Bool {
  (match standing_grant_row_judged(executed: "row", executed_read: true, on_main: "row", main_read: true, main_stderr: "") { StandingGrantRowOnMain => true  StandingGrantRowNotOnMain { cause: _ } => false })
    && (match standing_grant_row_judged(executed: "row", executed_read: true, on_main: "", main_read: false, main_stderr: "fatal: path does not exist in origin/main") { StandingGrantRowOnMain => false  StandingGrantRowNotOnMain { cause: c } => string_contains(s: c, pattern: "has not merged") })
    && (match standing_grant_row_judged(executed: "row edited", executed_read: true, on_main: "row", main_read: true, main_stderr: "") { StandingGrantRowOnMain => false  StandingGrantRowNotOnMain { cause: c } => string_contains(s: c, pattern: "differs") })
    && (match standing_grant_row_judged(executed: "", executed_read: false, on_main: "row", main_read: true, main_stderr: "") { StandingGrantRowOnMain => false  StandingGrantRowNotOnMain { cause: _ } => true })
}

// ONE AUTHORIZATION FACT, ONE READ. The standing is judged over the CAPTURED row: the supplied blob
// producer sees only the captured content, so a working path that changed after capture -- here back to
// main's bytes -- cannot rescue a captured row that differs from main, and the proof's digest is always
// the captured row's. RED: a judgment that hashed the path again would admit the changed row.
test fn rw_admission_follows_the_captured_row_not_the_path() -> Bool {
  let blob_of = fn(c) { GrantRowBlobRead { blob: join(["blob(", c, ")"], "") } }
  let main = GrantRowBlobRead { blob: "blob(main row)" }
  let captured_changed = ExecutedGrantRowRead { content: "branch-edited row", digest: "sha256:edited" as NonEmptyStr }
  let captured_main = ExecutedGrantRowRead { content: "main row", digest: "sha256:main" as NonEmptyStr }
  let changed_standing = grant_row_standing_over(executed: captured_changed, blob_of: blob_of, on_main: main)
  let main_standing = grant_row_standing_over(executed: captured_main, blob_of: blob_of, on_main: main)
  (match changed_standing { StandingGrantRowOnMain => false  StandingGrantRowNotOnMain { cause: c } => string_contains(s: c, pattern: "differs") })
    && (match grant_row_proof_over(executed: captured_changed, standing: changed_standing) { D0GrantRowUnproven => true  D0GrantRowApproved { row_digest: _ } => false })
    && (match main_standing { StandingGrantRowOnMain => true  StandingGrantRowNotOnMain { cause: _ } => false })
    && (match grant_row_proof_over(executed: captured_main, standing: main_standing) { D0GrantRowUnproven => false  D0GrantRowApproved { row_digest: d } => d as String == "sha256:main" })
    && (match grant_row_standing_over(executed: captured_main, blob_of: fn(c) { GrantRowBlobUnread { cause: "witness" } }, on_main: main) { StandingGrantRowOnMain => false  StandingGrantRowNotOnMain { cause: _ } => true })
}

test fn rw_a_covered_release_is_honored_only_under_a_matching_frozen_proof() -> Bool {
  rw_with(scenario: fn(h) {
    let req = rw_release_request(group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), h: h)
    let row = ExecutedGrantRowRead { content: "row", digest: "sha256:aa" as NonEmptyStr }
    (match d0_honored_standing_grant(request: req, frozen: D0GrantRowApproved { row_digest: "sha256:aa" as NonEmptyStr }, executed: row) { Present { value: _ } => true  Absent => false })
      && (match d0_honored_standing_grant(request: req, frozen: D0GrantRowUnproven, executed: row) { Present { value: _ } => false  Absent => true })
      && (match d0_honored_standing_grant(request: req, frozen: D0GrantRowApproved { row_digest: "sha256:bb" as NonEmptyStr }, executed: row) { Present { value: _ } => false  Absent => true })
      && (match d0_honored_standing_grant(request: req, frozen: D0GrantRowApproved { row_digest: "sha256:aa" as NonEmptyStr }, executed: ExecutedGrantRowUnread { cause: "witness" }) { Present { value: _ } => false  Absent => true })
  })
}

// THE FILING CARRIES THE PROOF AND ROUND-TRIPS; WITHOUT ONE IT IS BYTE-IDENTICAL TO BEFORE.
test fn rw_the_frozen_filing_round_trips_its_grant_proof() -> Bool {
  let with_proof = d0_frozen_filing_text_with(intent_text: "a=b\n", execution_revision: "aaaa" as NonEmptyStr, proof: D0GrantRowApproved { row_digest: "sha256:aa" as NonEmptyStr })
  let without = d0_frozen_filing_text_with(intent_text: "a=b\n", execution_revision: "aaaa" as NonEmptyStr, proof: D0GrantRowUnproven)
  without == "a=b\nexecution_revision=aaaa\n"
    && (match parse_d0_frozen_filing(text: with_proof) { Present { value: f } => match f.grant_proof { D0GrantRowApproved { row_digest: d } => (d as String) == "sha256:aa" && (f.execution_revision as String) == "aaaa"  D0GrantRowUnproven => false }  Absent => false })
    && (match parse_d0_frozen_filing(text: without) { Present { value: f } => match f.grant_proof { D0GrantRowUnproven => true  D0GrantRowApproved { row_digest: _ } => false }  Absent => false })
}

// PROVENANCE (side-chat review of #13102): the SAME covered release, authorized by the BROKER, keeps broker
// lifecycle identity and expiry -- two windows are two lifecycles, and no standing-grant term appears. Only an
// authorization issued from the grant carries the grant's identity. The grant never relabels a broker one.
test fn rw_a_broker_authorized_covered_release_keeps_broker_identity() -> Bool {
  rw_with(scenario: fn(h) {
    let req = rw_release_request(group: FabricGroupA, hosts: fabric_group_hosts(g: FabricGroupA), h: h)
    match rw_permitted(req: req, issued: "2026-10-03T05:10:00Z", expires: "2026-10-03T05:40:00Z", at: "2026-10-03T05:11:00Z") {
      Absent => false
      Present { value: first } => match rw_permitted(req: req, issued: "2026-10-03T09:00:00Z", expires: "2026-10-03T09:30:00Z", at: "2026-10-03T09:01:00Z") {
        Absent => false
        Present { value: later } => {
          let b1 = d0_binding_text_with(grant: first, claim_generation: 1, basis: D0BasisBroker)
          let b2 = d0_binding_text_with(grant: later, claim_generation: 1, basis: D0BasisBroker)
          b1 != b2 && string_contains(s: b1, pattern: "expires_at=") && !string_contains(s: b1, pattern: "standing_grant=")
            && b1 == d0_binding_text(grant: first, claim_generation: 1)
        }
      }
    }
  })
}
