module test.claim.spark.serving_step_cost_witness

import std.types { Bool, String, Int, NonEmptyStr, List }
import std.nat { Nat }
import v2.std.optional { Present, Absent }
import std.measure { TokenCount, token_count }
import gunbc.spark.serving_step_cost {
  ServingStepShape, StepCostObservation, ColdPrefillRunAggregate,
  spark_group_a_cold_prefill_run, spark_serving_step_costs,
  CoTenantDecodeRate, DecodeRatePredicted, DecodeRateOutsideCalibration, co_tenant_decode_rate,
  computed_prefill_tokens_per_second,
  StepCostLookup, StepCostKnown, StepCostUnmeasured, step_cost_for,
}

// THE PREDICTION THE RUN AGGREGATE EARNS. A decoder cannot emit a token before the current engine
// step completes, so while a co-tenant prefills its rate is bounded by the interval between step
// completions. That interval was DIRECTLY measured -- median 2.30s between consecutive count
// advances -- so the reciprocal, 0.43 tok/s, comes from an observed quantity rather than a derived
// pairing.
//
// The operator's session reported 0.4 tok/s on turns 57-59, turns whose own work was ~640 new tokens
// against ~70k cached. A measurement on a different head, on an idle engine, with a synthetic
// prompt, predicts it.
test fn the_measured_inter_step_interval_predicts_the_co_tenant_rate() -> Bool {
  match co_tenant_decode_rate(run: spark_group_a_cold_prefill_run) {
    DecodeRatePredicted { milli_tokens_per_second: r, from: _ } => r >= 400 && r <= 460
    DecodeRateOutsideCalibration { cause: _ } => false
  }
}

// THROUGHPUT IS RUN-LEVEL AND DERIVED. Total computed tokens over elapsed run time -- both directly
// measured -- so "890 tok/s" is not editable as a literal and moves when either term does.
test fn prefill_throughput_is_derived_from_run_level_terms() -> Bool {
  match computed_prefill_tokens_per_second(run: spark_group_a_cold_prefill_run) {
    Present { value: derived } => derived >= 780 && derived <= 900
    Absent => false
  }
}

// THE ROW THAT KEEPS THE GRAIN HONEST. The run aggregate carries totals and an interval
// distribution. It does NOT carry, and must not be read as, one step's token count paired with one
// step's duration: 158,764/83 = 1,913 is a run-wide AVERAGE and 2,300ms is a MEDIAN, and no step was
// ever observed to be both. An earlier version of this module recorded exactly that pairing as a
// StepCostObservation, which was a fabricated measurement dressed as a calibration cell.
test fn the_aggregate_carries_totals_and_a_distribution_not_a_step_pairing() -> Bool {
  spark_group_a_cold_prefill_run.completed_iterations == 83
    && spark_group_a_cold_prefill_run.elapsed_millis == 185500
    && spark_group_a_cold_prefill_run.inter_iteration_min_millis == 940
    && spark_group_a_cold_prefill_run.inter_iteration_median_millis == 2300
    && spark_group_a_cold_prefill_run.inter_iteration_max_millis == 2680
}

// THE EXACT PER-STEP POPULATION IS EMPTY, AND EVERY LOOKUP REFUSES. This is what stops the run
// aggregate being consumed as though it were a step cell, and what the authorised privileged trace
// exists to change. A simulator asking for a step cost today gets a refusal, not an interpolation
// from a run average.
test fn no_exact_step_cell_exists_yet_and_lookups_refuse() -> Bool {
  length(spark_serving_step_costs) == 0
    && (match step_cost_for(shape: ServingStepShape { computed_prefill: token_count(count: 1913), decode_sequences: 0 }) {
          StepCostUnmeasured { cause: c } => string_contains(s: c as String, pattern: "EMPTY until the privileged step trace")
          StepCostKnown { observation: _ } => false
        })
    && (match step_cost_for(shape: ServingStepShape { computed_prefill: token_count(count: 2048), decode_sequences: 1 }) {
          StepCostUnmeasured { cause: _ } => true
          StepCostKnown { observation: _ } => false
        })
}

// THE AGGREGATE NAMES THE LAUNCH IT WAS MEASURED ON, so a later image, quantisation or topology
// change cannot silently inherit it.
test fn the_aggregate_is_bound_to_the_launch_that_produced_it() -> Bool {
  string_contains(s: spark_group_a_cold_prefill_run.profile as String, pattern: "d140fa39c1174403bf2ce4d7ed8c2d74")
    && string_contains(s: spark_group_a_cold_prefill_run.profile as String, pattern: "TP=4")
    && string_contains(s: spark_group_a_cold_prefill_run.provenance as String, pattern: "200ms poll")
    && string_contains(s: spark_group_a_cold_prefill_run.provenance as String, pattern: "never between polls")
}
