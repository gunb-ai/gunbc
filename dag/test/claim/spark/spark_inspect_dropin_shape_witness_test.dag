module test.claim.spark.spark_inspect_dropin_shape_witness_test

import std.types { String, Bool, List, NonEmptyStr, Int }
import v2.std.algebra { filter, length }
import gunbc.spark.managed_grant_reconcile {
  SparkInspectDropinShape, SharedInspectDropinShape, PerContainerInspectDropinShape, InspectDropinShapeUnobserved,
  spark_inspect_dropin_shape_of_listing,
  spark_sudoers_dropin_listing_argv,
}
import gunbc.fleet_multi_principal_probe { spark_standing_hosts }

// THE SHAPE READING, over supplied listings. Group B's listing (2026-10-04 22:53Z) is the shared file
// alone; a host converged by the #13040 installer carries per-container files and no shared one.

fn is_shared_alone(s: SparkInspectDropinShape) -> Bool {
  match s {
    SharedInspectDropinShape { per_container: pc } => length(pc) == 0
    PerContainerInspectDropinShape { per_container: _ } => false
    InspectDropinShapeUnobserved { cause: _ } => false
  }
}

test fn w_shared_file_alone_reads_shared_shape() -> Bool {
  is_shared_alone(s: spark_inspect_dropin_shape_of_listing(exit_code: 0, stdout: "gunbc-docker-inspect\ngunbc-enable-linger\ngunbc-reboot\nREADME\n", stderr: ""))
}

test fn w_shared_file_beside_per_container_files_is_residue_not_alone() -> Bool {
  match spark_inspect_dropin_shape_of_listing(exit_code: 0, stdout: "gunbc-docker-inspect\ngunbc-docker-inspect-glm53-staircase\nREADME\n", stderr: "") {
    SharedInspectDropinShape { per_container: pc } => pc == ["gunbc-docker-inspect-glm53-staircase"]
    PerContainerInspectDropinShape { per_container: _ } => false
    InspectDropinShapeUnobserved { cause: _ } => false
  }
}

test fn w_per_container_only_reads_per_container_shape() -> Bool {
  match spark_inspect_dropin_shape_of_listing(exit_code: 0, stdout: "gunbc-docker-inspect-a\ngunbc-docker-inspect-b\ngunbc-reboot\n", stderr: "") {
    PerContainerInspectDropinShape { per_container: pc } => length(pc) == 2
    SharedInspectDropinShape { per_container: _ } => false
    InspectDropinShapeUnobserved { cause: _ } => false
  }
}

// An unreadable directory is not an absent shared file.
test fn w_unlistable_directory_is_unobserved_not_per_container() -> Bool {
  match spark_inspect_dropin_shape_of_listing(exit_code: 2, stdout: "", stderr: "ls: cannot open directory '/etc/sudoers.d': Permission denied") {
    InspectDropinShapeUnobserved { cause: _ } => true
    SharedInspectDropinShape { per_container: _ } => false
    PerContainerInspectDropinShape { per_container: _ } => false
  }
}

test fn w_listing_argv_is_read_only() -> Bool {
  spark_sudoers_dropin_listing_argv() == ["ls", "-1", "/etc/sudoers.d"]
}

// ── the probe roster IS the procured roster ───────────────────────────────────────────────────

// Every procured Spark, Group A and Group B alike, is probed by every run. A hand list that dropped
// one (the srv5/srv6-only roster this replaced) reds this.
test fn w_probe_roster_is_every_procured_spark() -> Bool {
  spark_standing_hosts == ["srv5", "srv6", "srv7", "srv8", "srv9", "srv10", "srv11", "srv12"]
}

// Group B's 2026-10-04 listing shape (shared file alone, no per-container file) reads as the
// shared shape the probe will report until an operator-approved converge replaces it.
test fn w_group_b_listing_shape_reads_shared_alone() -> Bool {
  is_shared_alone(s: spark_inspect_dropin_shape_of_listing(exit_code: 0, stdout: "gunbc-docker-inspect\ngunbc-enable-linger\ngunbc-ethtool-module-info\ngunbc-reboot\nREADME\n", stderr: ""))
}
