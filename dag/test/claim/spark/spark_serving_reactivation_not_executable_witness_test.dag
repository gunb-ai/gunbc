module test.claim.spark_serving_reactivation_not_executable_witness_test

import std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE PAIRING THIS WALL FORBIDS IS WRITABLE-SHAPED, WHICH IS WHY A WALL IS NEEDED AT ALL.
//
// gunbc.fleet_converge_plan PlannedEffectExecution carries `effect` and the steps as INDEPENDENT
// fields, and gunbc.spark.serving_converge_realize consumes the steps without ever checking that
// they realize the effect beside them. So membership in SparkServingExecutablePlannedEffect is not
// a rendering convenience: a member is admitted as the LABEL beside commands whose authority is
// independent of that label. Had ServingReactivationEffect been made a member, this source --
//
//   PlannedEffectExecution { effect: <a restart>, first_step: <any step at all>, further_steps: [] }
//
// -- would compile, and nothing downstream would object to a restart's name over commands that do
// not restart anything. Counting producers would not have caught it: zero producers says no current
// site constructs the value, never that the value cannot reach apply.
//
// THE SUBJECT IS THE SUM'S MEMBERSHIP, WHICH IS WHAT THAT FIELD IS DECLARED AS.
//
// The fixture declares its own one-field record whose field is the REAL corpus type
// SparkServingExecutablePlannedEffect -- the exact type of PlannedEffectExecution's `effect` field
// -- and puts a reactivation in it. So this is a claim about THIS repository's sum and not about
// coproduct payload judgment in general, which test.claim.coproduct_payload_soundness_witness_test
// already owns.
//
// STATED SO THE RECEIPT CANNOT CLAIM MORE THAN IT MEASURED: the fixture does not construct a
// PlannedEffectExecution literal directly, because a fixture importing gunbc.fleet_converge_plan
// does not compile under this instrument at all. Measured, not assumed: a fixture whose entire body
// is `import gunbc.fleet_converge_plan { PlannedEffectExecution }` and a function returning `1` is
// refused, while the same shape over gunbc.spark.serving_realization compiles -- that closure
// carries a blocking `unresolved type 'SparkServingObservationProvenance'` in
// gunbc.spark.serving_execution_schedule, a module and a type this change does not touch. Had the
// fixture named PlannedEffectExecution, its refusal would have been that diagnostic rather than
// this wall, and the red would have been vacuous. The residue is exactly the step from "reactivation
// is not a member of the sum" to "reactivation cannot label an execution", which holds by the field's
// declared type and is not independently executed here; making it executable is gated on that
// closure compiling clean under the synthetic-source instrument.
//
// It greens the moment anyone re-widens the sum -- including the moment DCH-0r-c lands, whose
// settled shape is PlannedBoundReactivationExecution { plan, steps } with steps DERIVED from the
// bound plan, precisely so that widening this sum is never the way reactivation becomes executable.
fn reactivation_not_executable_fixture_source() -> String {
  "module srne.probe\n\nimport gunbc.spark.serving_realization { SparkServingExecutablePlannedEffect, RestartUserUnitForChangedDefinition }\n\ntype SrneExecutionHolder {\n  effect: SparkServingExecutablePlannedEffect\n}\n\nfn srne_restart_in_the_executable_field() -> SrneExecutionHolder {\n  SrneExecutionHolder { effect: RestartUserUnitForChangedDefinition }\n}\n"
}

// THE POSITIVE CONTROL, differing on EXACTLY ONE AXIS: the effect placed in that field. Without it
// the red above is satisfied by a compiler that refuses every record literal in that shape, or by
// a fixture whose imports simply do not resolve -- either of which would report a wall while the
// membership question went unasked.
fn install_is_executable_fixture_source() -> String {
  "module srne.control\n\nimport gunbc.spark.serving_realization { SparkServingExecutablePlannedEffect, PlannedInstallEffect, StartUserUnit }\n\ntype SrneExecutionHolder {\n  effect: SparkServingExecutablePlannedEffect\n}\n\nfn srne_install_in_the_executable_field() -> SrneExecutionHolder {\n  SrneExecutionHolder { effect: PlannedInstallEffect { install: StartUserUnit } }\n}\n"
}

// THE DISCRIMINATING RED. A reactivation effect has no constructor into the executable domain, so a
// value of it in that field is refused at compile time rather than caught downstream or left to review.
test fn w_reactivation_is_not_a_member_of_the_executable_effect_domain() -> Bool {
  !compile_dag_rust_emit_check(
    reactivation_not_executable_fixture_source(),
    "src/srne_probe.rs",
    [],
    []
  )
}

// AND THE SAME FIELD STILL ACCEPTS WHAT IT IS FOR.
test fn w_install_is_still_a_member_of_the_executable_effect_domain() -> Bool {
  compile_dag_rust_emit_check(
    install_is_executable_fixture_source(),
    "src/srne_control.rs",
    [],
    []
  )
}
