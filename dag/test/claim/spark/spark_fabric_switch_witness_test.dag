module test.claim.spark.spark_fabric_switch_witness

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { host_identity_eq }
import gunbc.fleet_intent_network { operator_host_srv5, operator_host_srv6, operator_host_srv7, operator_host_srv8, operator_host_srv9, operator_host_srv12, operator_host_srv1 }
import extdeps.mikrotik.crs812 { crs812_lane_speed_wire, Lane50GCr2, crs812_passive_dac_requires_forced_mode }
import extdeps.transceiver.sff_8636 {
  Sff8636NominalRate, NominalRateUnspecified, NominalRateDirect, NominalRateEscaped,
  transceiver_identifier_from_byte, sff8636_encoding_from_byte,
  sff8636_nominal_rate_from_byte140,
  ComplianceUnderstood, ComplianceUnspecified, ComplianceCodeUnmodelled,
  sff8636_interpret_extended_compliance,
}
import extdeps.ethernet.link_mode { ieee_100gbase_cr2, link_mode_eq }
import std.measure { symbol_rate_count }
import product.cable_leg_observation {
  CableLegObservation, cable_leg_observation, cable_leg_declared_nominal_rate,
  SecondaryNotObserved, ExtendedRateNotObserved,
}
import product.cable_plant_assessment { CableLegReading, LegReadingTaken, LegNeverRead }
import gunbc.spark.fabric_switch_observed {
  fabric_lane_observations, fabric_lane_interface, fabric_lane_for_host, fabric_leg_cable_observed,
  fabric_leg_eeprom_observations, fabric_leg_reading, fabric_cable_plant,
  fabric_leg_reading_of_row, FabricLegEepromObservation, AcquisitionInvalidatedByReflash, AcquisitionCurrent,
  fabric_forced_100g_attempts, fabric_forced_100g_ever_trained,
  FabricGroup, FabricGroupA, FabricGroupB, fabric_group_hosts, fabric_group_of_host,
}

// The coding from the FIRST receipt, for the byte-level witnesses below. Reached THROUGH the receipt
// population rather than a shared row, so a witness cannot assert about a leg nobody read. The
// Absent arm cannot be hit while fabric_leg_eeprom_observations is non-empty, and it is deliberately
// an all-sentinel observation rather than a plausible one: if the population is ever emptied, the
// witnesses below fail loudly instead of quietly asserting about a fabricated leg.
fn fabric_delivered_leg_coding_probe() -> CableLegObservation {
  match fabric_leg_eeprom_observations.first() {
    Present { value: r } => r.coding
    Absent => cable_leg_observation(
      identifier: transceiver_identifier_from_byte(code: 0),
      primary_compliance_code: 0,
      secondary_compliance: SecondaryNotObserved,
      encoding: sff8636_encoding_from_byte(code: 0),
      nominal_rate: sff8636_nominal_rate_from_byte140(code: 0),
      extended_rate: ExtendedRateNotObserved)
  }
}

// EIGHT LANES, EIGHT DISTINCT HOSTS, ONE LEG EACH, all on odd lanes of the two 400G cages.
test fn every_unit_has_exactly_one_leg_on_an_odd_lane() -> Bool {
  length(fabric_lane_observations) == 8
    && all(fabric_lane_observations, o => o.lane == 1 || o.lane == 3 || o.lane == 5 || o.lane == 7)
    && all(fabric_lane_observations, o => length(filter(fabric_lane_observations, p => host_identity_eq(a: p.host, b: o.host))) == 1)
    && (match fabric_lane_for_host(host: operator_host_srv6) { Present { value: o } => (fabric_lane_interface(o: o) as String) == "qsfp56-dd-1-7"  Absent => false })
}

// THE GROUPS ARE THE CAGES. srv5..srv8 share cage 1, srv9..srv12 share cage 2, and a host off the
// fabric belongs to neither.
test fn groups_derive_from_the_cage_and_a_host_off_the_fabric_has_none() -> Bool {
  let a = fabric_group_hosts(g: FabricGroupA)
  let b = fabric_group_hosts(g: FabricGroupB)
  length(a) == 4 && length(b) == 4
    && any(a, h => host_identity_eq(a: h, b: operator_host_srv5)) && any(a, h => host_identity_eq(a: h, b: operator_host_srv8))
    && any(b, h => host_identity_eq(a: h, b: operator_host_srv9)) && any(b, h => host_identity_eq(a: h, b: operator_host_srv12))
    && (match fabric_group_of_host(host: operator_host_srv7) { Present { value: FabricGroupA } => true  _ => false })
    && (match fabric_group_of_host(host: operator_host_srv1) { Absent => true  Present { value: _ } => false })
}

// THE LINK STILL RUNS AT 50G AND THE CODING NO LONGER EXPLAINS IT. Before the 2026-09-16 re-flash
// these were one fact: the coding capped the mode and the leg linked at the cap. They have come
// apart: the rate half is asserted here, and the coding half -- every leg now attesting
// 100GBASE-CR2 -- by every_legs_coding_attests_100gbase_cr2_after_the_reflash below. The NIC's
// admitted-mode set used to be asserted here as a substring of a free-text row; that row was deleted
// on main as an anemic leaf, and the set returns as a typed List<LinkMode> with gap G12.
test fn the_link_runs_at_50g_while_the_coding_now_attests_more() -> Bool {
  fabric_leg_cable_observed.linked_speed_gbps == 50
    && (crs812_lane_speed_wire(s: Lane50GCr2) as String) == "50G-baseCR2"
    && crs812_passive_dac_requires_forced_mode
}

// AND FORCING THE MODE WAS TRIED AND FAILED, which is the evidence that keeps the sentence above
// honest. Every recorded attempt reports trained: false, so nothing in this corpus may claim the
// fabric runs at 100G; and the roster is non-empty, so the claim rests on attempts rather than on
// nobody having looked. If a later attempt DOES train, this reds -- which is the correct outcome:
// the 50G rows above become stale in the same change.
test fn forcing_100gbase_cr2_has_never_trained_on_this_plant() -> Bool {
  length(fabric_forced_100g_attempts) == 4
    && fabric_forced_100g_ever_trained() == false
    && any(fabric_forced_100g_attempts, a => (a.nic_forced_modes as String) == "100G_2X" && a.nic_status_opcode == 2)
    && any(fabric_forced_100g_attempts, a => (a.switch_fec as String) == "auto")
}


// BYTE 222 WAS READ ON 2026-09-08 ON TWO LEGS, AND IT IS 6Ah. `ethtool -m <dev> raw on` on
// spark-a3ee and spark-ac79 -- two of the fleet's eight legs, both in cage 1 -- returned byte
// 140 = FFh and byte 222 = 6Ah = 106, which at the specification's 250 MBd unit is a DECLARED
// nominal of 26,500 MBd. This witness is what stops the fabricated figure coming back: the wrong
// behaviour reconstitutes 25500 by multiplying byte 140's escape out, which is what `ethtool`
// prints and what an earlier head recorded as a measurement.
//
// IT IS NOT A CLAIM THAT THE LEG RUNS AT 26.5 GBd, and it is not the mode's rate: ieee_100gbase_cr2
// carries 26.5625 GBd, and byte 222's 250 MBd resolution cannot express that. 106 is a quantized
// nominal consistent with the 50G PAM4 family, which is a weaker and true statement.
test fn the_escape_resolves_to_the_declared_rate_byte_222_holds() -> Bool {
  match cable_leg_declared_nominal_rate(obs: fabric_delivered_leg_coding_probe()) {
    NominalRateDirect { rate: r } => symbol_rate_count(r: r) == 26500000000
    NominalRateEscaped => false
    NominalRateUnspecified => false
  }
}

// THE RAW BYTE IS STILL AN ESCAPE, and resolution does not rewrite it. Following byte 222 answers
// what the module DECLARES its nominal rate to be -- not what the leg signals at, which no EEPROM
// byte can establish -- and it does not turn byte 140 into a direct rate. A later reader must still
// see that this observation stands on an escape that was followed rather than on a byte that spoke
// for itself. Kept beside the resolved witness because the two are different facts.
test fn the_escaped_nominal_rate_is_not_a_measurement() -> Bool {
  match fabric_delivered_leg_coding_probe().nominal_rate {
    NominalRateEscaped => true
    NominalRateDirect { rate: r } => false
    NominalRateUnspecified => false
  }
}


// THE POPULATION CONTROL, NOW THAT THE PLANT IS FULLY READ. It began as the cardinality guard on an
// eight-to-two repair: two legs dumped, six never read, so nothing could map one coding across
// lanes nobody looked at. The 2026-09-16 re-flash dumped all eight, so the guard's job changes
// rather than ending -- it now asserts that every lane's reading is its OWN receipt, which is the
// same regression in its harder form. A broadened plant that mapped one coding to eight lanes would
// satisfy a count of eight; what it cannot satisfy is the distinct-identity witness below.
fn plant_readings_taken() -> Nat {
  length(flat_map(fabric_lane_observations, o =>
    match fabric_leg_reading(o: o) {
      LegReadingTaken { endpoint: e, observation: ob } => [e]
      LegNeverRead { endpoint: e } => []
    }))
}

fn plant_readings_never() -> Nat {
  length(flat_map(fabric_lane_observations, o =>
    match fabric_leg_reading(o: o) {
      LegNeverRead { endpoint: e } => [e]
      LegReadingTaken { endpoint: e, observation: ob } => []
    }))
}

test fn all_eight_legs_carry_a_reading() -> Bool {
  plant_readings_taken() == 8 && plant_readings_never() == 0
}

// AN INVALIDATED ACQUISITION IS NOT A LIVE READING, and the roster now carries a real one: the
// spark-ac79 row read at 0x0B on 2026-09-10 and superseded by the re-flash sits beside its successor
// rather than having been deleted by it. The supplied row is kept anyway, because the claim is about
// the PROJECTION and not about the roster's current membership -- it must stay red if
// fabric_leg_reading_of_row ever promotes an invalidated row, on a day when no real row is invalidated. A leg re-flashed and not re-read must project to LegNeverRead -- NOT to
// LegReadingTaken with its pre-flash coding, which would present a known-false current coding (§5).
// This is the discriminating red for the acquisition-standing projection (DESIGN §4b(4): the red
// stays enrolled after the population it was written against moves); it reds if
// fabric_leg_reading_of_row ever promotes an AcquisitionInvalidatedByReflash row to a live reading.
test fn a_reflashed_but_unread_leg_reads_as_never_not_as_its_stale_value() -> Bool {
  match fabric_leg_eeprom_observations.first() {
    Absent => false
    Present { value: r } =>
      match fabric_leg_reading_of_row(
        endpoint: "qsfp56-dd-1-1" as NonEmptyStr,
        r: FabricLegEepromObservation {
          host: r.host, vendor_serial: r.vendor_serial, date_code: r.date_code,
          observed_on: r.observed_on, coding: r.coding,
          acquisition: AcquisitionInvalidatedByReflash { invalidating_event: "a re-flash with no re-read" as NonEmptyStr },
        },
      ) {
        LegNeverRead { endpoint: _ } => true
        LegReadingTaken { endpoint: _, observation: _ } => false
      }
  }
}

// AND EVERY RECEIPT IS AN INDEPENDENT ROW, not one value read eight times. Distinct vendor serials
// are what make them separate acquisitions, and this is the witness that EARNED its keep: the first
// post-re-flash pass wrote two cage-2 legs with a cage-1 assembly's serial, so S2630771509-3 and -4
// each appeared twice across the roster. A leg cannot be in two cages, so a duplicate serial is a
// programming defect and not a plant fact -- the operator re-flashed exactly those two legs and they
// now read S2630771508-3 and -4. Checking every row against every other, rather than the first row
// against the rest, is what makes a duplicate anywhere in the roster red.
//
// UNIQUENESS IS A PROPERTY OF THE CURRENT ACQUISITION SET, NOT OF EVERY RECEIPT EVER TAKEN, and that
// distinction arrived with the restored history. spark-ac79's superseded 2026-09-10 row carries
// S2630771509-3 -- the mis-written serial, kept exactly as it was read, because rewriting it to the
// corrected value would erase the evidence that the programmer mis-wrote it. Two rows may therefore
// share a serial spelling ACROSS TIME while no two legs share one TODAY, which is what the plant
// claim was always about. Scoping the fold to AcquisitionCurrent is what keeps the claim's content
// while letting the history exist; folding over everything would have forced a choice between the
// two, and the one it would have forced is deleting the history.
fn switch_current_receipts() -> List<FabricLegEepromObservation> {
  filter(fabric_leg_eeprom_observations, r => match r.acquisition {
    AcquisitionCurrent => true
    AcquisitionInvalidatedByReflash { invalidating_event: _ } => false
  })
}

test fn every_receipt_has_a_distinct_module_identity() -> Bool {
  length(switch_current_receipts()) == 8
    && all(switch_current_receipts(), a =>
         length(filter(switch_current_receipts(), r => r.vendor_serial == a.vendor_serial)) == 1)
    && all(switch_current_receipts(), a =>
         length(filter(fabric_lane_observations, o => (o.spark_hostname as String) == (a.host as String))) == 1)
    && length(fabric_leg_eeprom_observations) > length(switch_current_receipts())
}

// THE CODING NOW ATTESTS THE MODE THE FABRIC WAS BOUGHT FOR, asked of the decoder rather than
// asserted. Byte 192 = 0x40 is what the re-flash wrote, and what 0x40 MEANS is
// extdeps.transceiver.sff_8636's to say -- so this witness reads the interpretation off the receipt,
// which is the same route product.cable_plant_assessment takes. Byte 116 stays 00h, so the
// attestation rests on the extended byte alone, exactly as it did when that byte said 0x0B and the
// answer was no.
test fn every_legs_coding_attests_100gbase_cr2_after_the_reflash() -> Bool {
  all(switch_current_receipts(), r =>
    match sff8636_interpret_extended_compliance(code: 64) {
      ComplianceUnderstood { code: c, modes: ms } =>
        any(ms, a => link_mode_eq(a: a.mode, b: ieee_100gbase_cr2))
      ComplianceUnspecified { code: c } => false
      ComplianceCodeUnmodelled { code: c } => false
    })
}
