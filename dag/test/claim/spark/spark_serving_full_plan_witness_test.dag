// THE SERVING SUBJECT IS THE SERVING CELL, AND AFTER SPARK-PAIR-0 THAT IS NO LONGER SRV6.
//
// This file's subject was srv6 throughout, from before any host was assigned a role. Every claim
// below asks the production planner to install the full seven-member serving population on it. Once
// gunbc.spark.cell_role made srv6 a training cell, the planner correctly answers three baseline
// members for that host -- so these claims were not merely mis-aimed, they were asserting the
// pre-role behaviour and would have gone red on the population the production path now produces.
// That is the cross-PR integration surface a green new witness file does not cover: the defect was
// in an existing direct consumer of the function that changed.
//
// The subject moves to srv5, where a seven-member serving install is what the role authority says
// should happen. srv6's retirement claims live in the P0 retirement witness, over the production
// artifact root, because they are claims about the OTHER role.
data subject_host: HostIdentity = "srv5" as HostIdentity

// The subject is the DECLARED release, so these claims move with the real authority rather than a
// fixture that could drift from it. A refused admission has no release to plan against, and the
// witness says so rather than substituting one.
fn subject_release() -> SparkServingRelease? {
  match spark_serving_desired_admission {
    SparkServingDesiredAdmitted { serving_release: r } => Present { value: r }
    SparkServingDesiredRefused { cause: _ } => none
  }
}

fn complete_required_runtime() -> RuntimeMaterializationObservation {
  RuntimeMaterializationComplete {
    identity: ollama_runtime_materialization_identity_for_required_release(),
  }
}

// THE RUNTIME IS STATED, NEVER DEFAULTED. An earlier revision of this helper supplied
// `complete_required_runtime()` for every fixture, which silently asserted that a BARE host already
// had its runtime materialized -- so `a_bare_host_plans_all_seven_members_not_only_linger` planned
// four and the fixture, not the production code, was wrong. A default here re-fuses the very
// subjects the projection separates, so every caller says which runtime it means.
fn project(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  activity: SparkServingObservedActivityState,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(host: host, runtime: runtime, store: store, unit: unit, enablement: enablement, activity: activity, linger: linger, provenance: witness_provenance(host: host))
}

fn bare_runtime() -> RuntimeMaterializationObservation {
  RuntimeMaterializationAbsent
}

// THE STORE IS STATED TOO, for the reason the runtime is. Defaulting it to complete would assert
// that a bare host already holds the model, which is the same fixture lie that made
// `a_bare_host_plans_all_seven_members_not_only_linger` pass while planning four.
fn bare_store() -> ModelStoreObservation {
  ModelStoreAbsent
}

// The digest is taken from the SAME desired release the plan is built against, so "complete" means
// "holds exactly what is desired" rather than "holds something". A literal here would drift from the
// authority and the zero-writes claim would stop meaning anything.
fn complete_required_store() -> ModelStoreObservation {
  match subject_release() {
    Absent => ModelStoreObservationRefused { cause: "no admitted release" as NonEmptyStr }
    Present { value: r } =>
      ModelStoreComplete {
        manifest_identity: serialize_content_hash(hash: r.model.identity) as NonEmptyStr,
        blob_closure_count: 1,
      }
  }
}

fn observed_count(p: SparkServingObservedMemberProjection) -> Int {
  match p {
    SparkServingObservedMembers { members: ms, runtime_observed: _, unit_observed: _, registration_observed: _, enablement_observed: _, linger_observed: _ } => length(ms)
  }
}

fn plan_writes(p: SparkServingFullMembershipPlan) -> Int {
  match p {
    SparkServingFullMembershipPlanRefused { cause: _ } => 0 - 1
    SparkServingFullMembershipPlanReady { plan: plan, unit_observed: _, enablement_observed: _, linger_observed: _, observed_members: _ } =>
      membership_write_count(plan: plan)
  }
}

fn full_plan_writes(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  activity: SparkServingObservedActivityState,
  linger: SparkServingObservedLingerState,
) -> Int {
  match subject_release() {
    Absent => 0 - 2
    Present { value: r } =>
      plan_writes(
        p: spark_serving_full_membership_plan(
          occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
          serving_release: r,
          projection: project(host: host, runtime: runtime, store: store, unit: unit, enablement: enablement, activity: activity, linger: linger),
        ),
      )
  }
}

fn full_plan_refuses(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  activity: SparkServingObservedActivityState,
  linger: SparkServingObservedLingerState,
) -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match spark_serving_full_membership_plan(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
        projection: project(host: host, runtime: runtime, store: store, unit: unit, enablement: enablement, activity: activity, linger: linger),
      ) {
        SparkServingFullMembershipPlanRefused { cause: c } => string_contains(c, "refused")
        SparkServingFullMembershipPlanReady { plan: _, unit_observed: _ } => false
      }
  }
}

// ── The defect this closes ──────────────────────────────────────────────────────────────────────

// The declared desired population is four members. This is the denominator every claim below divides
// by, asserted rather than assumed.
fn witness_provenance(host: HostIdentity) -> SparkServingObservationProvenance {
  hermetic_fixture_provenance(host: host)
}

test fn the_declared_desired_population_is_seven_members() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      length(spark_serving_desired_members(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
      )) == 7
  }
}

// THE KEYSTONE. On a bare host the production plan planned ONE member; the full plan plans all six.
// Without this the unrealized install effects could never be selected however well implemented.
//
// Seven rather than six since activity became its own resource: a bare host drifts at runtime, unit
// content, registration, enablement, ACTIVITY, the model slot and linger.
test fn a_bare_host_plans_all_seven_members_not_only_linger() -> Bool {
  full_plan_writes(
    host: subject_host,
    runtime: bare_runtime(), store: bare_store(),
    unit: UserUnitStateAbsent,
    enablement: UserUnitManagerNotRegistered,
    activity: UnitActivityStopped,
    linger: LingerObservedDisabled,
  ) == 7
}

// The contrast, executed rather than asserted in prose: the superseded plan writes exactly one.
test fn the_superseded_linger_plan_writes_exactly_one() -> Bool {
  membership_write_count(
    plan: spark_serving_linger_membership_plan(host: subject_host, linger_enabled: false),
  ) == 1
}

// ── Observation, never the desired state ────────────────────────────────────────────────────────

// A bare host observes no runtime, unit or model member. If the projection derived observed state
// from the desired release, this would be four and the plan would be empty on a bare machine.
// A bare host observes NO SERVING members, but it does observe the unit's REGISTRATION -- systemd
// answers not-found for a unit that was never written, and that is a fact rather than an absence of
// one. So the observed population is exactly that single REGISTRATION member: runtime, model and
// unit content are genuinely absent, linger is observed disabled and therefore carries nothing, and
// enablement contributes NOTHING because no enablement fact exists over an unregistered unit.
//
// The count is unchanged at one, and the member behind it is a different subject than it used to be:
// before the split this one member was an enablement member carrying not-registered, which is the
// conflation that let an absent subject reconcile as a change to it.
test fn a_bare_host_observes_its_unit_registration_and_its_stopped_activity() -> Bool {
  observed_count(p: project(host: subject_host, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateAbsent, enablement: UserUnitManagerNotRegistered, activity: UnitActivityStopped, linger: LingerObservedDisabled)) == 2
}

// Linger is observed independently, so it is carried even when serving is absent.
test fn linger_is_carried_on_a_bare_host_when_it_is_enabled() -> Bool {
  observed_count(p: project(host: subject_host, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateAbsent, enablement: UserUnitManagerNotRegistered, activity: UnitActivityStopped, linger: LingerObservedEnabled)) == 3
}

// With linger already enabled a bare host needs one fewer write than the fully bare case.
test fn a_bare_host_with_linger_already_enabled_plans_six() -> Bool {
  full_plan_writes(
    host: subject_host,
    runtime: bare_runtime(), store: bare_store(),
    unit: UserUnitStateAbsent,
    enablement: UserUnitManagerNotRegistered,
    activity: UnitActivityStopped,
    linger: LingerObservedEnabled,
  ) == 6
}

// ── The refusal that must not narrow ────────────────────────────────────────────────────────────

// A refused observation may NOT be rendered as an empty observed population: that would plan every
// member as an addition against a host nobody saw. It refuses, and the plan refuses with it.
// RETIRED WITH A RECEIPT: three claims stood here asserting that a refused SERVING observation
// refuses the whole projection, and that its cause names the host.
//
// That behaviour is deliberately gone. The serving observation asked whether the API answers, and an
// unavailable API says nothing about bytes on disk -- so refusing the projection on it erased
// runtime, model, unit, enablement and linger facts that had each been independently established,
// and left ordinary reconciliation unable to select the start or enable that would have fixed it.
// The projection no longer takes that observation at all, so SparkServingObservedMembersRefused has
// no producer and the arm is deleted rather than left unreachable.
//
// The obligation those claims protected -- actuation must not proceed from ignorance -- SURVIVES,
// and is asserted at the subject grain where the evidence actually lives:
// an_unobserved_runtime_refuses_the_plan_and_emits_no_operations,
// an_unobserved_model_store_refuses_the_plan_and_emits_no_pull, and
// the_two_unobserved_walls_name_their_own_subjects. Each names its own probe and its own remedy,
// which the fused projection-level refusal could not.
//
// They are retired rather than deleted quietly, because a witness whose only subject is behaviour
// the design now rejects is how obsolete behaviour grants itself immortality.

// ── Unobserved is not absent ────────────────────────────────────────────────────────────────────

// An unobserved unit is not listed, so it plans as an addition — the same OUTCOME as absent, but the
// two must remain distinguishable because only one of them supports an empty replan.
test fn an_unobserved_unit_does_not_support_an_empty_replan() -> Bool {
  !spark_serving_projection_supports_empty_replan(
    projection: project(host: subject_host, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateUnobserved, enablement: UserUnitManagerUnobserved, activity: UnitActivityUnobserved, linger: LingerObservedEnabled),
  )
}

test fn an_observed_absent_unit_does_support_an_empty_replan() -> Bool {
  spark_serving_projection_supports_empty_replan(
    projection: project(host: subject_host, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateAbsent, enablement: UserUnitManagerNotRegistered, activity: UnitActivityStopped, linger: LingerObservedEnabled),
  )
}

test fn a_refused_projection_never_supports_an_empty_replan() -> Bool {
  !spark_serving_projection_supports_empty_replan(
    projection: project(
      host: subject_host,
      runtime: RuntimeMaterializationObservationRefused { cause: "probe leg unreachable" as NonEmptyStr }, store: ModelStoreObservationRefused { cause: "probe leg unreachable" as NonEmptyStr },
      unit: UserUnitStateUnobserved,
      enablement: UserUnitManagerUnobserved,
      activity: UnitActivityUnobserved, linger: LingerUnobservedState,
    ),
  )
}

// ── The typed-action projection refuses rather than dropping ────────────────────────────────────

// Removing an `Ensured` member is refused by the reconcile, and that refusal used to be ERASED: the
// projection was a flat_map whose `Absent` arm returned the empty list, so the artifact froze fewer
// typed rows than its own plan had actions and reported no diagnostic. Its frequency was zero by
// construction because the only live plan is linger-only and linger always translates -- which is
// exactly why it is worth an executed witness rather than a reading of the code.
fn removal_refusing_plan() -> MembershipPlan<SparkServingMember, SparkServingMemberAt> {
  spark_serving_membership_reconcile(
    desired: [],
    observed: [spark_serving_desired_linger_member(host: subject_host)],
  )
}

// THE WALL MOVED UPSTREAM, AND THIS CLAIM MOVED WITH IT RATHER THAN BEING DELETED.
//
// This plan's single action is a `MemberRemovalRefused`, and the refusal it produces is no longer the
// drop-count comparison downstream: the scheduler now refuses a plan carrying refusal actions before
// any row is projected, because such a plan used to classify as EMPTY and freeze a "nothing to do"
// schedule over a reconcile that had said "I could not answer". So the input still refuses, one stage
// earlier and naming the actual reason.
//
// The downstream drop-count check is NOT thereby decoration: its remaining discriminating input is a
// frozen row whose `at` the reorder fold cannot translate, which is a different failure than a
// refusal action and is still authorable. What this claim can no longer reach is that comparison, so
// it asserts the refusal it actually causes instead of a message it no longer produces.
test fn a_plan_whose_member_cannot_translate_refuses_the_typed_projection() -> Bool {
  match fleet_converge_spark_serving_typed_actions(plan: removal_refusing_plan(), desired: []) {
    SparkServingTypedActionsRefused { cause: c } =>
      string_contains(c, "refusal action") && !string_contains(c, "planned member actions projected")
    SparkServingTypedActionsProjected { rows: _ } => false
  }
}

// The positive control: the ordinary bare-host linger plan still projects, so the refusal above is a
// property of the untranslatable action and not of the projection refusing everything.
test fn an_ordinary_linger_plan_still_projects_its_rows() -> Bool {
  match fleet_converge_spark_serving_typed_actions(
    plan: spark_serving_linger_membership_plan(host: subject_host, linger_enabled: false),
    desired: [spark_serving_desired_linger_member(host: subject_host)],
  ) {
    SparkServingTypedActionsProjected { rows: rows } => length(scheduled_rows_list(scheduled: rows)) == 1
    SparkServingTypedActionsRefused { cause: _ } => false
  }
}

// ── Convergence is reachable ────────────────────────────────────────────────────────────────────

// THE MISSING PROOF. Every claim above measures what happens when something DIFFERS. None of them
// asked the one question that decides whether this machinery can ever finish: given a host in
// exactly the desired state, does the plan write nothing?
//
// It did not. The observed runtime-root and model-slot members both carried the aggregate digest
// over the whole release, while desired carries the runtime closure digest and the model identity
// separately, so neither could ever match and a correctly installed host replanned both members on
// every run. The defect survived review precisely because no witness asserted the zero case -- a
// roster full of drift-detection claims is satisfied by a projection that reports drift always.
fn observed_exactly_desired(r: SparkServingRelease) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(
    provenance: witness_provenance(host: subject_host),
    host: subject_host,
    runtime: complete_required_runtime(),
    store: complete_required_store(),
    unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
    enablement: UserUnitManagerEnabled,
    activity: UnitActivityRunning,
          linger: LingerObservedEnabled,
  )
}

test fn a_host_in_exactly_the_desired_state_plans_no_writes() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match spark_serving_full_membership_plan(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
        projection: observed_exactly_desired(r: r),
      ) {
        SparkServingFullMembershipPlanRefused { cause: _ } => false
        SparkServingFullMembershipPlanReady { plan: plan, unit_observed: observed, enablement_observed: _, linger_observed: _, observed_members: _ } =>
          membership_write_count(plan: plan) == 0 && observed
      }
  }
}

// And the same observation must support an empty replan -- the property that distinguishes "nothing
// to do" from "we never looked at the unit".
test fn an_exactly_desired_host_supports_an_empty_replan() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      spark_serving_projection_supports_empty_replan(projection: observed_exactly_desired(r: r))
  }
}

// The two components must be independently discriminating: if the projection fused them again, a
// runtime-only drift would move the model member too. Four members, exactly one changed.
// THE MODEL IS HELD AT DESIRED HERE, because this claim isolates the RUNTIME. An earlier revision
// passed bare_store() -- inserted mechanically alongside the runtime rather than chosen -- which
// drifted the model too and made a claim named "exactly one member" measure two. The fixture, not
// the plan, was wrong.
test fn a_runtime_only_drift_changes_exactly_one_member() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match spark_serving_full_membership_plan(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
        projection: spark_serving_observed_members(
    provenance: witness_provenance(host: subject_host),
          host: subject_host,
          store: complete_required_store(),
          runtime: RuntimeMaterializationIncomplete {
            identity: ollama_runtime_materialization_identity_for_required_release(),
            first_defect: RuntimeExecutableMissing {
              expected_relative_path: "bin/ollama" as NonEmptyStr,
            },
            further_defects: [],
          },
          unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
          enablement: UserUnitManagerEnabled,
          activity: UnitActivityRunning,
          linger: LingerObservedEnabled,
        ),
      ) {
        SparkServingFullMembershipPlanRefused { cause: _ } => false
        SparkServingFullMembershipPlanReady { plan: plan, unit_observed: _, enablement_observed: _, linger_observed: _, observed_members: _ } =>
          membership_write_count(plan: plan) == 1
      }
  }
}

// ── The cutover: the production plan artifact now plans the whole population ─────────────────────

// THE SPARK-SPECIFIC ARTIFACT ROUTE IS GONE, AND THESE CLAIMS ENTER THE ROW PRODUCER INSTEAD.
//
// The claims below are about WHAT MUST BE DONE to a host in a given observed state -- how many
// members are owed, which refusal fires, which effect is selected. That is a fact about the row
// producer, not about artifact assembly, and none of them reads a field the artifact adds. Routing
// them through a Spark-shaped artifact door was what let that door exist.
//
// A bare projection reaching the row producer is not the privilege leak the cut closed. Rows are not
// a bound plan: `spark_serving_bound_axis_plan` is admit_callers-sealed to
// `spark_serving_axis_for_observation`, so nothing a fixture assembles here can become a plan the
// converge will act on. The binding claims stay on the observation route further down.
fn artifact_verdict(
  host: HostIdentity,
  projection: SparkServingObservedMemberProjection,
) -> SparkServingScheduledRowsVerdict {
  spark_serving_scheduled_rows_for(host: host as NonEmptyStr, projection: projection)
}

fn artifact_refusal_cause(v: SparkServingScheduledRowsVerdict) -> String {
  match v {
    SparkServingScheduledRowsReady { computed: _, plan: _ } => "<ready>"
    SparkServingScheduledRowsRefused { cause: c } => c
  }
}

fn artifact_row_count(v: SparkServingScheduledRowsVerdict) -> Int {
  match v {
    SparkServingScheduledRowsReady { computed: c, plan: _ } => length(scheduled_rows_list(scheduled: c.rows))
    SparkServingScheduledRowsRefused { cause: _ } => 0 - 1
  }
}

// THE CUTOVER KEYSTONE. This function planned a one-member linger list; it now plans the declared
// population. A bare host with linger already on owes the other three members, and the artifact must
// freeze a typed row for each -- not the single linger row the superseded planner produced.
// THE FRONTIER MOVED, AND THIS IS THE BAR IT MOVED TO.
//
// This claim used to assert that a bare host REFUSED, because InstallOwnedRuntimeClosure and
// MaterializeModelArtifact were both unrealized and a plan containing an unrealized effect refuses whole.
// Both are realized now, so the refusal is gone -- and its absence is the operator's stated push
// criterion: a bare host must produce a complete executable plan rather than a typed-action refusal.
//
// So it asserts the new state rather than being deleted. A frontier control that stops holding is
// evidence the frontier moved, and the honest response is to state where it moved to.
//
// It pins the ROW COUNT as a distinct constant rather than merely "not refused", because "no
// refusal" would also be satisfied by a plan that produced nothing at all -- which is the empty
// observation narrow, and on a bare host it is the exact wrong answer.
//
// FOUR, NOT FIVE, and the second half of the claim is what makes that number mean something rather
// than be curve-fitted. The declared population is five members, but this fixture observes linger
// ALREADY ENABLED, so linger converges and owes no action. Flipping only linger to disabled yields
// five. A first attempt asserted five against the linger-enabled fixture and was simply wrong about
// its own subject; carrying both counts states the relationship instead of a remembered constant.
test fn a_bare_host_produces_a_complete_plan_with_no_typed_action_refusal() -> Bool {
  let v = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: bare_runtime(), store: bare_store(),
      unit: UserUnitStateAbsent,
      enablement: UserUnitManagerNotRegistered,
      activity: UnitActivityStopped, linger: LingerObservedEnabled,
    ),
  )
  let with_linger_off = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: bare_runtime(), store: bare_store(),
      unit: UserUnitStateAbsent,
      enablement: UserUnitManagerNotRegistered,
      activity: UnitActivityStopped, linger: LingerObservedDisabled,
    ),
  )
  artifact_refusal_cause(v: v) == "<ready>"
    && artifact_row_count(v: v) == 6
    && artifact_row_count(v: with_linger_off) == 7
}

// AND A SINGLE DRIFTED MEMBER PLANS EXACTLY ONE ROW, which is what stops the claim above from being
// satisfied by a plan that simply emits everything. A host whose runtime and model are already
// correct but whose unit drifted owes one row, not five.
// DRIFTED BYTES ARE TWO FACTS, NOT ONE. The file differs from desired AND the manager is therefore
// holding a definition that is not the desired one, so the plan freezes a write and a reload -- the
// same two operations the bundled content remedy used to emit, now attributed to the two subjects
// that actually own them.
test fn a_unit_only_drift_freezes_exactly_two_rows() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      artifact_row_count(
        v: artifact_verdict(
          host: subject_host,
          projection: project(
        host: subject_host,
            runtime: complete_required_runtime(),
            store: complete_required_store(),
            unit: UserUnitStateObserved { unit_state_digest: "drifted-unit-bytes" as NonEmptyStr },
            enablement: UserUnitManagerEnabled,
            activity: UnitActivityRunning, linger: LingerObservedEnabled,
          ),
        ),
      ) == 2
  }
}

// ── The precondition the publish sequence rests on ──────────────────────────────────────────────

// Counts frozen rows addressed at the RUNTIME ROOT specifically, rather than rows in total. The
// distinction is the whole point: "no writes at all" and "no runtime write" are different facts, and
// only the second is what the publish sequence needs.
fn runtime_rows(v: SparkServingScheduledRowsVerdict) -> Int {
  match v {
    SparkServingScheduledRowsRefused { cause: _ } => 0 - 1
    SparkServingScheduledRowsReady { computed: c, plan: _ } =>
      length(filter(scheduled_rows_list(scheduled: c.rows), row =>
        match row.action {
          MemberAdded { at: _, to: m } => is_runtime_root(address: m.address)
          MemberChanged { at: _, from: _, to: m } => is_runtime_root(address: m.address)
          MemberRemoved { at: _, from: m } => is_runtime_root(address: m.address)
          MemberRemovalRefused { from: _, cause: _ } => false
          MemberRosterDuplicateKeyRefused { roster: _, first: _, duplicate: _ } => false
        }))
  }
}

fn is_runtime_root(address: SparkServingResourceAddress) -> Bool {
  match address {
    SparkServingRuntimeRootAddress => true
    SparkServingUserUnitAddress => false
    SparkServingUserUnitRegistrationAddress => false
    SparkServingUserUnitEnablementAddress => false
    SparkServingUserUnitActivityAddress => false
    SparkServingModelSlotAddress { slot: _ } => false
    SparkServingLingerAddress => false
  }
}

// THE PUBLISH SEQUENCE REMOVES ANY TREE AT THE FINAL PATH, and this is what makes that admissible.
//
// `mv -T` refuses a populated destination, so without a removal step a second attempt after any
// interruption could never republish -- "incomplete is repairable" would be prose. The removal is
// safe only if the sequence is unreachable for a host whose runtime is already Complete, and that is
// a property of reconcile rather than of the realizer: an unchanged member yields no action.
//
// Read in BOTH directions deliberately. Asserting only "a complete runtime freezes no runtime row"
// would also pass if the fixture froze nothing at all, or if the projection had quietly stopped
// producing runtime members -- so the same fixture with the runtime bare must freeze exactly one, and
// the unit drift must be visible in both arms. A claim that cannot distinguish "correctly silent"
// from "structurally mute" is measuring nothing.
test fn a_complete_runtime_plans_no_install_steps() -> Bool {
  let converged_runtime = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: complete_required_runtime(),
      store: complete_required_store(),
      unit: UserUnitStateObserved { unit_state_digest: "drifted-unit-bytes" as NonEmptyStr },
      enablement: UserUnitManagerEnabled,
      activity: UnitActivityRunning, linger: LingerObservedEnabled,
    ),
  )
  let bare_runtime_same_drift = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: bare_runtime(),
      store: complete_required_store(),
      unit: UserUnitStateObserved { unit_state_digest: "drifted-unit-bytes" as NonEmptyStr },
      enablement: UserUnitManagerEnabled,
      activity: UnitActivityRunning, linger: LingerObservedEnabled,
    ),
  )
  runtime_rows(v: converged_runtime) == 0
    && runtime_rows(v: bare_runtime_same_drift) == 1
    && artifact_row_count(v: converged_runtime) == 2
    && artifact_row_count(v: bare_runtime_same_drift) == 3
}

// A host in exactly the desired state freezes NO rows. This is the control that proves convergence
// is reachable through the production entry point and not merely through the plan beneath it: if it
// ever fails, the wet slice writes on every run forever.
test fn the_production_artifact_freezes_no_rows_when_converged() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      artifact_row_count(v: artifact_verdict(host: subject_host, projection: observed_exactly_desired(r: r))) == 0
  }
}

// THE PARTIAL-OBSERVATION WALL. An unobserved unit is ABSENT from the observed list, and absence is
// what makes reconcile plan an addition -- so planning against it would write the unit on every run
// while no replan could ever be empty. It must refuse, and the refusal must say which one it was.
test fn an_unobserved_unit_refuses_the_artifact_rather_than_planning_a_write() -> Bool {
  let cause = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(
        host: subject_host,
        runtime: bare_runtime(), store: bare_store(),
        unit: UserUnitStateUnobserved,
        enablement: UserUnitManagerUnobserved,
        activity: UnitActivityUnobserved, linger: LingerObservedEnabled,
      ),
    ),
  )
  string_contains(cause, "unit-unobserved")
}

// A refused OBSERVATION refuses the artifact too, and is a DIFFERENT cause than the partial one --
// "we could not reach the host" and "we reached it but did not read the unit" have different
// remedies, so one word for both would be the state-space conflation.
test fn a_refused_observation_refuses_the_artifact_with_its_own_cause() -> Bool {
  let cause = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(
        host: subject_host,
        runtime: RuntimeMaterializationObservationRefused { cause: "probe leg unreachable" as NonEmptyStr }, store: ModelStoreObservationRefused { cause: "probe leg unreachable" as NonEmptyStr },
        unit: UserUnitStateUnobserved,
        enablement: UserUnitManagerUnobserved,
        activity: UnitActivityUnobserved, linger: LingerUnobservedState,
      ),
    ),
  )
  string_contains(cause, "observation") && !string_contains(cause, "unit-unobserved")
}

// A non-Spark host refuses, and says SO. Every refusal above used to render as the single word
// "plan-refused", so a reader could not tell an unreachable host from a wrong one; the residue this
// module declared for that is dissolved by the widened return type, and this pins it.
//
// The refusal now comes from the ROLE AUTHORITY rather than from a hardcoded srv5-or-srv6 predicate
// that used to answer first. Those two agreed on today's fleet and would have diverged on the next
// host added to the role roster -- the older list rejecting a cell the authority had assigned. This
// claim's subject is therefore the authority, which is what it was always meant to be about.
test fn a_non_spark_host_refuses_with_a_distinguishable_cause() -> Bool {
  let cause = artifact_refusal_cause(
    v: artifact_verdict(
      host: "srv1" as HostIdentity,
      projection: project(
        host: "srv1" as HostIdentity,
        runtime: bare_runtime(), store: bare_store(),
        unit: UserUnitStateAbsent,
        enablement: UserUnitManagerNotRegistered,
        activity: UnitActivityStopped, linger: LingerObservedEnabled,
      ),
    ),
  )
  string_contains(cause, "no Spark cell role")
}

// The four refusal causes are mutually distinguishable. Asserting each contains its own word is
// satisfied by a cause that contains ALL of them, so the population is compared pairwise.
test fn the_refusal_causes_are_pairwise_distinct() -> Bool {
  let unobserved = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(host: subject_host, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateUnobserved, enablement: UserUnitManagerUnobserved, activity: UnitActivityUnobserved, linger: LingerObservedEnabled),
    ),
  )
  let unreached = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(host: subject_host, runtime: RuntimeMaterializationObservationRefused { cause: "probe leg unreachable" as NonEmptyStr }, store: ModelStoreObservationRefused { cause: "probe leg unreachable" as NonEmptyStr }, unit: UserUnitStateUnobserved, enablement: UserUnitManagerUnobserved, activity: UnitActivityUnobserved, linger: LingerUnobservedState),
    ),
  )
  let wrong_host = artifact_refusal_cause(
    v: artifact_verdict(
      host: "srv1" as HostIdentity,
      projection: project(host: "srv1" as HostIdentity, runtime: bare_runtime(), store: bare_store(), unit: UserUnitStateAbsent, enablement: UserUnitManagerNotRegistered, activity: UnitActivityStopped, linger: LingerObservedEnabled),
    ),
  )
  unobserved != unreached && unreached != wrong_host && unobserved != wrong_host
}

// AN UNOBSERVED LINGER REFUSES, and is a DIFFERENT cause than an unobserved unit. Both project to
// nothing on the member list, so the plan cannot tell them apart from the members alone -- and the
// linger case is the dangerous one, because the effect it would select is privileged. A failed probe
// must stop the plan, not authorize an enable-linger.
test fn an_unobserved_linger_refuses_rather_than_selecting_a_privileged_effect() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      string_contains(
        artifact_refusal_cause(
          v: artifact_verdict(
            host: subject_host,
            projection: project(
        host: subject_host,
              runtime: complete_required_runtime(),
              store: complete_required_store(),
              unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
              enablement: UserUnitManagerEnabled,
              activity: UnitActivityRunning, linger: LingerUnobservedState,
            ),
          ),
        ),
        "linger-unobserved",
      )
  }
}

// And a DISABLED linger does not refuse -- it plans. Without this the claim above would also pass if
// linger observation were broken outright, which is the failure it is meant to exclude.
test fn a_disabled_linger_plans_rather_than_refusing() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      artifact_row_count(
        v: artifact_verdict(
          host: subject_host,
          projection: project(
        host: subject_host,
            runtime: complete_required_runtime(),
            store: complete_required_store(),
            unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
            enablement: UserUnitManagerEnabled,
            activity: UnitActivityRunning, linger: LingerObservedDisabled,
          ),
        ),
      ) == 1
  }
}

// ── Subject independence: one subject's failure stays in its own lane ────────────────────────────

fn observed_addresses(p: SparkServingObservedMemberProjection) -> Int {
  match p {
    SparkServingObservedMembers { members: ms, runtime_observed: _, unit_observed: _, registration_observed: _, enablement_observed: _, linger_observed: _ } => length(ms)
  }
}

// THE CLASS THIS PINS, and it is the one my own split missed. Splitting the member ADDRESSES did not
// separate the subjects: `classify_observed_user_unit` still took the enablement, and an unobserved
// enablement turned a SUCCESSFULLY READ FILE into unobserved content. Failure to establish one fact
// erased an established fact about a different one.
//
// A read that succeeded establishes the content whatever happened to the enablement probe. The unit
// member is present; only the enablement member is missing.
test fn an_unobserved_enablement_leaves_the_observed_content_intact() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match project(
        host: subject_host,
        runtime: complete_required_runtime(),
        store: complete_required_store(),
        unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
        enablement: UserUnitManagerUnobserved,
        activity: UnitActivityUnobserved, linger: LingerObservedEnabled,
      ) {
        SparkServingObservedMembers { members: _, unit_observed: unit_seen, enablement_observed: enab_seen, linger_observed: _ } =>
          unit_seen && !enab_seen
      }
  }
}

// And the mirror: an unreadable unit file does not erase an observed enablement. Without both
// directions this passes on a projection that simply reports everything as observed.
test fn an_unobserved_unit_leaves_the_observed_enablement_intact() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match project(
        host: subject_host,
        runtime: complete_required_runtime(),
        store: complete_required_store(),
        unit: UserUnitStateUnobserved,
        enablement: UserUnitManagerEnabled,
        activity: UnitActivityRunning, linger: LingerObservedEnabled,
      ) {
        SparkServingObservedMembers { members: _, unit_observed: unit_seen, enablement_observed: enab_seen, linger_observed: _ } =>
          !unit_seen && enab_seen
      }
  }
}

// A DISABLED-BUT-RUNNING UNIT PLANS EXACTLY ONE WRITE. This is the payoff of the whole split and the
// direct refutation of the `disabled:` encoding: byte-perfect content that is merely disabled owes
// EnableUserUnit alone, not a file rewrite plus a manager reload.
//
// THE FIXTURE IS RUNNING, and that is the activity split showing its work rather than an adjustment
// to keep a count. Disabled-and-running is a real and specific host state -- somebody started the
// unit by hand, it serves today, and it disappears at the next reboot -- and it is exactly the state
// where enablement is the ONLY thing that drifts. Before activity was its own member this fixture
// could not be written at all: running and stopped were the same observation, so "only enablement
// drifts" had to be asserted against a host that was also dead, and the claim quietly depended on
// activity being unmodeled.
test fn a_correct_but_disabled_and_running_unit_plans_exactly_one_member() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      plan_writes(
        p: spark_serving_full_membership_plan(
          occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
          serving_release: r,
          projection: project(
            host: subject_host,
            runtime: complete_required_runtime(),
            store: complete_required_store(),
            unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
            enablement: UserUnitManagerDisabled,
            activity: UnitActivityRunning, linger: LingerObservedEnabled,
          ),
        ),
      ) == 1
  }
}

// THE MIRROR, AND THE CLAIM THIS WHOLE CHANGE EXISTS FOR. An enabled unit that is DEAD owes exactly
// one write -- the start -- and before the activity member existed it owed ZERO. Every resource
// reconciled as converged, the plan was empty, and the only thing that noticed nothing was serving
// was the generation probe at the end of the run. This claim goes red the moment activity stops
// being a member, which is the property that keeps the split from being quietly undone.
test fn an_enabled_but_dead_unit_plans_exactly_one_member() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      plan_writes(
        p: spark_serving_full_membership_plan(
          occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
          serving_release: r,
          projection: project(
            host: subject_host,
            runtime: complete_required_runtime(),
            store: complete_required_store(),
            unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
            enablement: UserUnitManagerEnabled,
            activity: UnitActivityStopped, linger: LingerObservedEnabled,
          ),
        ),
      ) == 1
  }
}

// THE PRODUCTION-ENTRY CONTROL, and it has to be at the ENTRY. The projection already carried
// enablement_observed correctly; the plan simply never read it -- a match destructuring two of three
// fields typechecks, so adding the field forced no consumer to handle it. A projection-level claim
// would have passed throughout.
//
// Unobserved enablement projects no member, so the desired one reads as absent, so reconcile plans
// MemberAdded, so EnableUserUnit is selected off a probe that never answered. Same class as the
// linger fail-open, reintroduced by adding an address without threading its completeness.
test fn an_unobserved_enablement_refuses_the_artifact_rather_than_enabling() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      string_contains(
        artifact_refusal_cause(
          v: artifact_verdict(
            host: subject_host,
            projection: project(
              host: subject_host,
              runtime: complete_required_runtime(),
              store: complete_required_store(),
              unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
              enablement: UserUnitManagerUnobserved,
              activity: UnitActivityUnobserved, linger: LingerObservedEnabled,
            ),
          ),
        ),
        "unit-enablement-unobserved",
      )
  }
}

// And an OBSERVED enablement still plans, so the refusal is not simply the artifact refusing
// everything once a third completeness fact exists.
test fn an_observed_disabled_enablement_still_plans_through_the_artifact() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      artifact_row_count(
        v: artifact_verdict(
          host: subject_host,
          projection: project(
            host: subject_host,
            runtime: complete_required_runtime(),
            store: complete_required_store(),
            unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
            enablement: UserUnitManagerDisabled,
            activity: UnitActivityRunning, linger: LingerObservedEnabled,
          ),
        ),
      ) == 1
  }
}


// A BARE HOST ENABLES ONCE, NOT TWICE. The content address used to carry EnableUserUnit alongside
// write and reload, and the enablement address carries it too -- so a host where both members drift
// froze two enables for one unit. Adding an address does not divide a responsibility; removing it
// from the old owner does.
test fn a_bare_host_freezes_exactly_one_enable_operation() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      length(flat_map(
        spark_serving_desired_members(
          occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
          serving_release: r,
        ),
        m => spark_serving_install_effects_for_add(member: m),
      ).filter(e => e == EnableUserUnit)) == 1
  }
}

// And the content member no longer claims the enable at all, which is what makes the count above a
// consequence of the decomposition rather than an accident of ordering.
// Content owns bytes and nothing else. It must not enable (that was the two-enables defect) and it
// must no longer reload either: reload is the remedy that establishes REGISTRATION, and leaving it
// here would freeze two daemon-reloads on any host that drifts at both subjects.
test fn the_unit_content_member_writes_only() -> Bool {
  !any(spark_serving_user_unit_install_effects(), e => e == EnableUserUnit)
    && !any(spark_serving_user_unit_install_effects(), e => e == ReloadUserManager)
    && any(spark_serving_user_unit_install_effects(), e => e == WriteUserUnitFile)
    && length(spark_serving_user_unit_install_effects()) == 1
}

// The reload did not vanish, it moved. Asserted so the claim above cannot be satisfied by the
// operation being dropped from the model altogether.
test fn the_registration_member_owns_the_reload() -> Bool {
  let effects = spark_serving_install_effects_for_address(
    address: SparkServingUserUnitRegistrationAddress,
  )
  any(effects, e => e == ReloadUserManager) && length(effects) == 1
}

// ── The walls that refuse actuation from ignorance ──────────────────────────────────────────────

// AN UNOBSERVED RUNTIME REFUSES THE PLAN, AND THIS IS THE HALF THAT WAS MISSING.
//
// The projection carried runtime_observed and the full-plan carrier destructured only unit,
// enablement and linger, so it was silently discarded: a refused runtime probe omitted the member,
// the member read as ABSENT, and InstallOwnedRuntimeClosure became selectable. The remedy for "the
// runtime is not there" is to install it; the remedy for "we could not look" is to fix the probe.
// Omission collapsed the two and picked the destructive one.
//
// This asserts the REFUSAL, not merely that no install was planned -- a plan that produced nothing
// at all would also emit no install, and on a bare host that is the empty-observation narrow. It
// also asserts zero rows, because a refusal carrying rows would let a consumer act on them.
test fn an_unobserved_runtime_refuses_the_plan_and_emits_no_operations() -> Bool {
  let v = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: RuntimeMaterializationObservationRefused { cause: "probe leg did not run" as NonEmptyStr },
      store: bare_store(),
      unit: UserUnitStateAbsent,
      enablement: UserUnitManagerNotRegistered,
      activity: UnitActivityStopped, linger: LingerObservedEnabled,
    ),
  )
  string_contains(artifact_refusal_cause(v: v), "runtime materialization was not observed")
    && artifact_row_count(v: v) == 0 - 1
}

// THE SAME WALL FOR THE MODEL STORE, and it is the more expensive one to get wrong: an unobserved
// store planned as absent pulls a multi-gigabyte artifact onto a host that may already hold it, on
// the strength of a probe that failed.
test fn an_unobserved_model_store_refuses_the_plan_and_emits_no_pull() -> Bool {
  let v = artifact_verdict(
    host: subject_host,
    projection: project(
      host: subject_host,
      runtime: bare_runtime(),
      store: ModelStoreObservationRefused { cause: "blob listing leg did not run" as NonEmptyStr },
      unit: UserUnitStateAbsent,
      enablement: UserUnitManagerNotRegistered,
      activity: UnitActivityStopped, linger: LingerObservedEnabled,
    ),
  )
  string_contains(artifact_refusal_cause(v: v), "model store was not observed")
    && artifact_row_count(v: v) == 0 - 1
}

// THE TWO REFUSALS ARE DISTINCT SENTENCES, because one "incomplete observation" cause would send an
// operator to the wrong probe. Distinct constants, not a Boolean: asserting only that both refuse
// would pass on a single fused message.
test fn the_two_unobserved_walls_name_their_own_subjects() -> Bool {
  let rt = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(
        host: subject_host,
        runtime: RuntimeMaterializationObservationRefused { cause: "x" as NonEmptyStr },
        store: bare_store(),
        unit: UserUnitStateAbsent,
        enablement: UserUnitManagerNotRegistered,
        activity: UnitActivityStopped, linger: LingerObservedEnabled,
      ),
    ),
  )
  let ms = artifact_refusal_cause(
    v: artifact_verdict(
      host: subject_host,
      projection: project(
        host: subject_host,
        runtime: bare_runtime(),
        store: ModelStoreObservationRefused { cause: "x" as NonEmptyStr },
        unit: UserUnitStateAbsent,
        enablement: UserUnitManagerNotRegistered,
        activity: UnitActivityStopped, linger: LingerObservedEnabled,
      ),
    ),
  )
  rt != ms
    && string_contains(rt, "runtime")
    && string_contains(ms, "model store")
    && !string_contains(rt, "model store")
}


// ── ORDERING: THE AXIS EVERY CLAIM ABOVE IS BLIND TO ────────────────────────────────────────────
//
// Thirty-five claims stood above this line and every one of them asked WHAT is planned -- which
// members, how many writes, which effects, which refusal. Not one asked IN WHAT ORDER, and the srv6
// convergence failed on exactly that axis: the remedies were all correct and the first one to run
// was a manager reload for a unit file that no earlier step had written. A test suite that is
// complete on one axis and silent on another does not report the silence, so the gap read as
// coverage. These claims are that axis.

type ScheduleIndexScan { found: Bool, idx: Int, seen: Int }

// THE POSITION OF THE ROW FOR ONE RESOURCE, or -1 when the order does not contain it. The reconcile
// key is host x principal x address wire, so the address wire is a substring of exactly the key for
// that resource -- which is why the scan matches on containment rather than reconstructing the key
// and asserting an equality that would really be testing the key builder.
fn schedule_index_of(order: List<String>, address_wire: String) -> Int {
  let scan = fold(order, init: ScheduleIndexScan { found: false, idx: 0 - 1, seen: 0 }, f: fn(acc, at) {
    if acc.found {
      ScheduleIndexScan { found: true, idx: acc.idx, seen: acc.seen + 1 }
    } else if string_contains(at as String, address_wire) {
      ScheduleIndexScan { found: true, idx: acc.seen, seen: acc.seen + 1 }
    } else {
      ScheduleIndexScan { found: false, idx: 0 - 1, seen: acc.seen + 1 }
    }
  })
  scan.idx
}

fn frozen_order(
  host: HostIdentity,
  runtime: RuntimeMaterializationObservation,
  store: ModelStoreObservation,
  unit: SparkServingObservedUnitState,
  enablement: SparkServingUnitManagerState,
  activity: SparkServingObservedActivityState,
  linger: SparkServingObservedLingerState,
) -> List<String> {
  match subject_release() {
    Absent => []
    Present { value: r } =>
      match spark_serving_full_membership_plan(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
        projection: project(host: host, runtime: runtime, store: store, unit: unit, enablement: enablement, activity: activity, linger: linger),
      ) {
        SparkServingFullMembershipPlanRefused { cause: _ } => []
        SparkServingFullMembershipPlanReady { plan: p, desired_members: d } =>
          match spark_serving_freeze_execution_schedule(
            plan: p,
            desired_addresses: flat_map(d, m => [m.address]),
          ) {
            SparkServingScheduleRefused { cause: _ } => []
            SparkServingScheduleFrozen { schedule: sched } =>
              spark_serving_frozen_schedule_order(schedule: sched)
          }
      }
  }
}

fn bare_host_frozen_order() -> List<String> {
  frozen_order(
    host: subject_host,
    runtime: bare_runtime(), store: bare_store(),
    unit: UserUnitStateAbsent,
    enablement: UserUnitManagerNotRegistered,
    activity: UnitActivityStopped,
    linger: LingerObservedDisabled,
  )
}

// THE REGRESSION FOR THE srv6 FAILURE, stated as the edge it violated.
//
// A reload before a write is the defect verbatim. It is asserted as a position comparison rather
// than as "the first step is the runtime install", because the first-step form would also go green
// on an order that happened to start correctly and then inverted a later pair.
test fn the_frozen_order_writes_the_unit_before_registering_it() -> Bool {
  let order = bare_host_frozen_order()
  let write = schedule_index_of(order: order, address_wire: "user-unit:")
  let reload = schedule_index_of(order: order, address_wire: "user-unit-registration:")
  length(order) == 7 && write >= 0 && reload >= 0 && write < reload
}

test fn the_frozen_order_installs_the_runtime_before_the_unit_names_it() -> Bool {
  let order = bare_host_frozen_order()
  let runtime = schedule_index_of(order: order, address_wire: "runtime-root")
  let write = schedule_index_of(order: order, address_wire: "user-unit:")
  length(order) == 7 && runtime >= 0 && write >= 0 && runtime < write
}

test fn the_frozen_order_registers_the_unit_before_enabling_it() -> Bool {
  let order = bare_host_frozen_order()
  let reload = schedule_index_of(order: order, address_wire: "user-unit-registration:")
  let enable = schedule_index_of(order: order, address_wire: "user-unit-enablement:")
  length(order) == 7 && reload >= 0 && enable >= 0 && reload < enable
}

// THE MODEL PULL TALKS TO THE SERVING API, so it cannot precede the unit being enabled. This edge
// was previously asserted as a property of a hand-authored step list; it is now a consequence of the
// model address requiring UnitEnabled, and this claim is what holds that requirement honest.
test fn the_frozen_order_enables_the_unit_before_pulling_the_model() -> Bool {
  let order = bare_host_frozen_order()
  let enable = schedule_index_of(order: order, address_wire: "user-unit-enablement:")
  let model = schedule_index_of(order: order, address_wire: "model-slot:")
  length(order) == 7 && enable >= 0 && model >= 0 && enable < model
}

// POPULATION CONSERVATION. A schedule that respects every edge while dropping a row would satisfy
// every claim above it, so the count is asserted separately from the order -- the two failures are
// different and one must not be able to hide inside the other.
test fn the_frozen_order_is_a_permutation_of_the_planned_rows() -> Bool {
  let order = bare_host_frozen_order()
  length(order) == 7
    && schedule_index_of(order: order, address_wire: "runtime-root") >= 0
    && schedule_index_of(order: order, address_wire: "user-unit:") >= 0
    && schedule_index_of(order: order, address_wire: "user-unit-registration:") >= 0
    && schedule_index_of(order: order, address_wire: "user-unit-enablement:") >= 0
    && schedule_index_of(order: order, address_wire: "model-slot:") >= 0
    && schedule_index_of(order: order, address_wire: "linger") >= 0
}

// A PARTIAL PLAN STILL SCHEDULES. When only the model is missing, the rows that would have
// established its prerequisites are absent from the plan because the observation already established
// them -- so the schedule must be the single model row, NOT a missing-provider refusal. This is the
// claim that keeps the refusal from being satisfied by refusing everything.
test fn a_host_needing_only_the_model_schedules_that_one_row() -> Bool {
  let order = frozen_order(
    host: subject_host,
    runtime: complete_required_runtime(), store: bare_store(),
    unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
    enablement: UserUnitManagerEnabled,
    activity: UnitActivityRunning,
    linger: LingerObservedEnabled,
  )
  length(order) == 1 && schedule_index_of(order: order, address_wire: "model-slot:") == 0
}

// A BARE HOST IS OBSERVABLE, and this is the arm whose absence blocked srv5's first provisioning.
// `is-active` exits 4 for a unit that does not exist -- a definite reading -- and folding it into
// Unobserved made a host with nothing installed indistinguishable from a host we failed to measure,
// so the plan refused instead of installing. The projection must treat it as observed.
test fn a_host_with_no_unit_at_all_is_observed_not_unobserved() -> Bool {
  spark_serving_activity_was_observed(activity: UnitActivityNoSuchUnit)
    && !spark_serving_activity_was_observed(activity: UnitActivityUnobserved)
}

// It is NOT Stopped either, and the difference is not cosmetic: a stopped unit exists and could be
// started; a unit that does not exist must be installed and registered first, and collapsing the two
// would let a plan select StartUserUnit against a unit file that is not there. A stopped unit
// projects a member; a missing one projects none.
test fn a_missing_unit_projects_no_activity_member_but_a_stopped_one_does() -> Bool {
  spark_serving_observed_unit_activity_members(host: subject_host, activity: UnitActivityNoSuchUnit).length() == 0
    && spark_serving_observed_unit_activity_members(host: subject_host, activity: UnitActivityStopped).length() == 1
    && spark_serving_observed_unit_activity_members(host: subject_host, activity: UnitActivityUnobserved).length() == 0
}

// The silence arm stays load-bearing: a manager we could not reach has not told us the unit is dead,
// and the plan must still refuse rather than start off a probe that never answered.
test fn a_genuinely_unobserved_activity_still_refuses() -> Bool {
  !spark_serving_activity_was_observed(activity: UnitActivityUnobserved)
}

fn c3_projection(
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  c3_projection_at(host: subject_host, linger: linger)
}

fn c3_projection_at(
  host: HostIdentity,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(
    provenance: witness_provenance(host: host),
    host: host,
    store: complete_required_store(),
    runtime: RuntimeMaterializationAbsent,
    unit: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
    enablement: UserUnitManagerEnabled,
    activity: UnitActivityRunning,
    linger: linger,
  )
}

fn c3_rows_count(v: SparkServingScheduledRowsVerdict) -> Int {
  match v {
    SparkServingScheduledRowsRefused { cause: _ } => 0 - 1
    SparkServingScheduledRowsReady { computed: computed, plan: _ } =>
      length(scheduled_rows_list(scheduled: computed.rows))
  }
}

test fn the_extracted_row_producer_plans_real_work_from_an_observation() -> Bool {
  c3_rows_count(v: spark_serving_scheduled_rows_for(
    host: subject_host as NonEmptyStr,
    projection: c3_projection(linger: LingerObservedEnabled),
  )) > 0
}

test fn the_extracted_row_producer_still_refuses_an_unobserved_linger() -> Bool {
  c3_rows_count(v: spark_serving_scheduled_rows_for(
    host: subject_host as NonEmptyStr,
    projection: c3_projection(linger: LingerUnobservedState),
  )) == 0 - 1
}

test fn extraction_did_not_change_what_the_slice_artifact_plans() -> Bool {
  match artifact_verdict(host: subject_host, projection: c3_projection(linger: LingerObservedEnabled)) {
    SparkServingScheduledRowsRefused { cause: _ } => false
    SparkServingScheduledRowsReady { computed: c, plan: _ } =>
      length(scheduled_rows_list(scheduled: c.rows))
        == c3_rows_count(v: spark_serving_scheduled_rows_for(
             host: subject_host as NonEmptyStr,
             projection: c3_projection(linger: LingerObservedEnabled),
           ))
  }
}

// THE GENERIC ARTIFACT CARRIES THE SCHEDULE IT IS HANDED.
//
// The axis now comes from `spark_serving_axis_for_observation` rather than from the row producer,
// because the producer no longer makes one: it answers with a computation, and only the acquired
// route binds that computation into an axis. So this claim compares what the generic artifact froze
// against the rows of the axis it was actually given.
// A DRIFTING host, deliberately: an axis whose schedule is empty would make the equality hold by
// carrying nothing, which is the shape this claim exists to rule out.
test fn the_generic_artifact_carries_the_schedule_it_is_handed() -> Bool {
  let axis = c3_axis(linger: LingerObservedDisabled)
  match fleet_converge_plan_artifact(
    host: subject_host as NonEmptyStr,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    spark_axis: axis,
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: subject_host),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
  ) {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: a } =>
      length(scheduled_rows_list(scheduled: a.spark_serving_typed_actions))
        == length(scheduled_rows_list(scheduled: axis_rows_or_empty(a: axis)))
        && length(scheduled_rows_list(scheduled: a.spark_serving_typed_actions)) > 0
  }
}

// ── The axis disposition: what the pair-of-lists shape could not prevent ─────────────────────────

fn c3_axis(linger: SparkServingObservedLingerState) -> SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction> {
  c3_axis_at(host: subject_host, linger: linger)
}

// A PLANNED AXIS CAN ONLY BE OBTAINED FROM THE PRODUCER NOW.
//
// BoundSparkServingAxisPlan is sole_constructor in the schedule module, so this witness cannot author
// a Planned arm out of a host, a member list and some rows the way it used to -- which is the point:
// that literal was exactly the forgery the artifact's host join could not detect, because all three
// parts agreed by the author's arrangement rather than by provenance. The foreign-host RED is still
// authorable, and that matters: it is minted for srv3 by the real producer and then handed to an
// artifact whose subject is srv5, which is a mismatch no amount of opacity can rule out.
// A PLANNED AXIS COMES FROM ONE ACQUIRED OBSERVATION, THROUGH THE ONE ROUTE.
//
// This used to call `spark_serving_axis_for(host, projection)` -- a second planning route that took
// the two independently and existed because the fixture's provenance was HERMETIC, which the
// production route refuses. So the claims below were exercising a path production does not take,
// against a provenance production rejects. Both are gone: the fixture acquires through the sealed
// transaction mint, so its provenance is the acquired arm, and the axis comes from
// `spark_serving_axis_for_observation`, which is now the only route that binds a plan at all.
//
// Absent means the fixture's own acquisition refused. It is returned rather than swallowed so a
// broken fixture reddens the claims instead of quietly turning them into refusal tests.
fn c3_observation_at(
  host: HostIdentity,
  linger: SparkServingObservedLingerState,
) -> SparkServingHostObservation? {
  hermetic_converged_observation(host: host, linger: linger)
}

fn c3_axis_at(
  host: HostIdentity,
  linger: SparkServingObservedLingerState,
) -> SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction> {
  match c3_observation_at(host: host, linger: linger) {
    Absent =>
      SparkServingAxisRefused {
        host: host,
        cause: "the hermetic acquisition fixture did not admit a transaction",
      }
    Present { value: o } => spark_serving_axis_for_observation(observation: o)
  }
}

fn c3_axis_host(a: SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction>) -> HostIdentity {
  match a {
    SparkServingAxisNotApplicable { host: h } => h
    SparkServingAxisUnobserved { host: h } => h
    SparkServingAxisRefused { host: h, cause: _ } => h
    SparkServingAxisPlanned { plan: p } => p.host
  }
}

// (1) and (2): rows and members travel in ONE arm, so they cannot be sourced from different
// observations or different hosts.
//
// THIS CLAIM WAS NARROWED BECAUSE ITS OLD NAME OVERSOLD IT. It used to be called
// the_axis_binds_its_host_to_the_observation_that_produced_it and simply read back the host it had
// itself passed to spark_serving_axis_for beside an independently supplied projection -- so it
// proved that an accessor returns what a constructor was given, not that the host came from an
// observation. Real provenance now lives in the bound payload, whose host, members, rows, attempt
// and locus are all projections of the producer that consumed one transaction, and whose sole
// constructor makes the old forgery unwritable. What remains here is the accessor's own behaviour,
// stated as that and nothing more.
test fn the_axis_accessor_reads_the_host_off_the_arm_it_is_given() -> Bool {
  c3_axis_host(a: c3_axis(linger: LingerObservedEnabled)) == subject_host
}

// THE PROVENANCE CLAIM PROPER, AND IT IS NOW THE ACQUIRED ARM.
//
// The previous version of this claim asserted the planned axis carried a provenance with NO
// observation attempt -- because the fixture was hermetic -- and called that the provenance
// property. It was the opposite: it pinned that planning accepted a value measured from nothing. The
// production route refuses that arm outright, so the claim was green over a route production never
// takes. The axis now carries the acquired provenance of the transaction the fixture admitted, and
// the identity it reports is the derived one rather than a constant.
test fn a_planned_axis_carries_the_acquired_provenance_of_its_observation() -> Bool {
  match c3_axis(linger: LingerObservedEnabled) {
    SparkServingAxisPlanned { plan: p } =>
      spark_serving_provenance_host(p: p.provenance) == subject_host
        && match spark_serving_provenance_observation_attempt(p: p.provenance) {
          Absent => false
          Present { value: a } =>
            (a as String) == concat(hermetic_fleet_attempt_raw, "/srv5/plan")
        }
    SparkServingAxisNotApplicable { host: _ } => false
    SparkServingAxisUnobserved { host: _ } => false
    SparkServingAxisRefused { host: _, cause: _ } => false
  }
}

// THE DISCRIMINATING RED FOR THE BINDING PRIVILEGE.
//
// A hermetic observation measured nothing, so it must not produce a bound plan -- and this is the
// only place that can be shown, because the bound mint is admitted to the acquired arm alone. If the
// route ever went back to asking "is there an observation attempt" instead of matching the arm, or
// if the binding privilege leaked back into the row producer, this goes green when it must be red.
test fn a_hermetic_observation_cannot_produce_a_bound_plan() -> Bool {
  match spark_serving_axis_for_observation(
    observation: hermetic_host_observation(
      readback: hermetic_readback(host: subject_host),
      account: ManagedAccountProbeRefused { cause: "fixture: no account probe was run" },
      runtime: RuntimeMaterializationAbsent,
      store: complete_required_store(),
      observed_unit: SparkServingObservedUnit {
        state: UserUnitStateObserved { unit_state_digest: spark_serving_user_unit_state_digest() },
        enablement: UserUnitManagerEnabled,
        activity: UnitActivityRunning,
      },
      linger: LingerObservedEnabled,
    ),
  ) {
    SparkServingAxisRefused { host: h, cause: why } =>
      h == subject_host && string_contains(s: why, pattern: "hermetic")
    SparkServingAxisPlanned { plan: _ } => false
    SparkServingAxisNotApplicable { host: _ } => false
    SparkServingAxisUnobserved { host: _ } => false
  }
}

test fn a_planned_axis_carries_members_and_rows_together() -> Bool {
  match c3_axis(linger: LingerObservedDisabled) {
    SparkServingAxisPlanned { plan: p } =>
      length(p.observed_members) > 0 && length(scheduled_rows_list(scheduled: p.rows)) > 0
    SparkServingAxisNotApplicable { host: _ } => false
    SparkServingAxisUnobserved { host: _ } => false
    SparkServingAxisRefused { host: _, cause: _ } => false
  }
}

// (3) Changing the observed population necessarily changes what the artifact fingerprints, because
// the baseline reads its members from the same arm the rows came from.
test fn the_artifact_baseline_moves_with_the_observed_spark_population() -> Bool {
  match artifact_outcome(axis: c3_axis(linger: LingerObservedEnabled)) {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: with_members } =>
      match artifact_outcome(axis: SparkServingAxisNotApplicable { host: subject_host }) {
        FleetConvergePlanArtifactRefused { refusal: _ } => false
        FleetConvergePlanArtifactReady { artifact: without } =>
          !(with_members.observed_baseline_hex == without.observed_baseline_hex)
      }
  }
}

// (4) A refusal cannot become an empty plan. This is the arm that had no producer at all before.
test fn a_refused_axis_refuses_the_artifact_instead_of_planning_nothing() -> Bool {
  match artifact_outcome(axis: c3_axis(linger: LingerUnobservedState)) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: _ } => true
  }
}

// The refusal is a refusal and not a NotApplicable: an unobserved linger is a probe that failed, and
// a non-Spark host is a different fact entirely.
test fn an_unobserved_probe_is_a_refusal_and_not_a_non_spark_subject() -> Bool {
  match c3_axis(linger: LingerUnobservedState) {
    SparkServingAxisRefused { host: _, cause: _ } => true
    SparkServingAxisNotApplicable { host: _ } => false
    SparkServingAxisUnobserved { host: _ } => false
    SparkServingAxisPlanned { plan: _ } => false
  }
}

// A NON-SPARK SUBJECT IS srv3, NOT srv5.
//
// This claim used to build a NotApplicable axis for subject_host -- which is srv5, an enrolled Spark
// -- and call it the non-Spark case. It proved only that the artifact trusts a same-host
// NotApplicable arm it was handed; applicability was SUPPLIED, never derived, so the claim's name
// asserted something its body never asked. srv3 is genuinely outside the observation scope, so the
// subject and the axis now agree on a host for which NotApplicable is true.
test fn a_non_spark_subject_still_assembles_an_artifact() -> Bool {
  match artifact_outcome_for(
    host: operator_host_srv3,
    axis: SparkServingAxisNotApplicable { host: operator_host_srv3 },
  ) {
    FleetConvergePlanArtifactRefused { refusal: _ } => false
    FleetConvergePlanArtifactReady { artifact: a } =>
      length(scheduled_rows_list(scheduled: a.spark_serving_typed_actions)) == 0
  }
}

fn artifact_outcome(
  axis: SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction>,
) -> FleetConvergePlanArtifactOutcome {
  artifact_outcome_for(host: subject_host, axis: axis)
}

fn artifact_outcome_for(
  host: HostIdentity,
  axis: SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction>,
) -> FleetConvergePlanArtifactOutcome {
  fleet_converge_plan_artifact(
    host: host as NonEmptyStr,
    prior_generation: 0,
    observed_timers: [],
    observed_caps: [],
    spark_axis: axis,
    observed_slots: [],
    observed_fabric_cells: fabric_cell_observation_unobserved(host: host),
    observed_activation_readiness: runner_activation_readiness_unobserved_no_transaction,
  observed_unit_standings: runner_unit_standings_unobserved_no_transaction,
  )
}

// THE AXIS AND THE PLAN SUBJECT ARE ONE FACT, NOT TWO THAT HAPPEN TO AGREE.
//
// This is the third instance of the class #9754 opened: a host carried in two places and joined by
// convention. Here the axis is tagged for the host it was observed on, and the artifact is built for
// a subject host, and nothing forced them to be the same host -- so a plan for srv3 could have been
// assembled out of srv5's observed Spark members and fingerprinted as if it described srv3. The
// artifact now reads the axis's own host and refuses when it disagrees.
test fn an_axis_tagged_for_another_host_refuses_instead_of_planning_for_the_subject() -> Bool {
  match artifact_outcome(
    axis: c3_axis_at(host: "srv3" as HostIdentity, linger: LingerObservedEnabled),
  ) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: _ } => true
  }
}

// The positive control that keeps the guard from being satisfied by refusing everything: the same
// arm, tagged for the subject, is admitted.
test fn an_axis_tagged_for_the_subject_is_admitted_by_the_same_guard() -> Bool {
  match artifact_outcome(axis: c3_axis_at(host: subject_host, linger: LingerObservedEnabled)) {
    FleetConvergePlanArtifactReady { artifact: _ } => true
    FleetConvergePlanArtifactRefused { refusal: _ } => false
  }
}

// AN ENROLLED SPARK NOBODY PROBED IS NOT A HOST THE SPARK AXIS FAILS TO GOVERN.
//
// The CLI does not run the serving observer yet. The first cut had it pass NotApplicable for every
// host, which for srv5 and srv6 is a false assertion -- strictly worse than the empty product it
// replaced, because it converted missing evidence into a claim. Unobserved refuses.
test fn an_unobserved_spark_axis_refuses_the_artifact() -> Bool {
  match artifact_outcome(axis: SparkServingAxisUnobserved { host: subject_host }) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: _ } => true
  }
}

// A LOCAL READER FOR THE TEST'S OWN CONVENIENCE, NOT A PRODUCTION PROJECTION.
//
// The production helpers that turned any arm into an empty schedule are deleted -- a refusal has no
// rows. These two claims are about the PLANNED arm's row count, so the reader lives here, in the
// witness, where an empty answer cannot be mistaken for a plan.
fn axis_rows_or_empty(
  a: SparkServingAxisDisposition<FleetConvergeSparkServingTypedAction>,
) -> ScheduledRows<FleetConvergeSparkServingTypedAction> {
  match a {
    SparkServingAxisPlanned { plan: p } => p.rows
    SparkServingAxisNotApplicable { host: _ } => scheduled_rows_empty()
    SparkServingAxisUnobserved { host: _ } => scheduled_rows_empty()
    SparkServingAxisRefused { host: _, cause: _ } => scheduled_rows_empty()
  }
}

// THE CONTROL ASKS WHICH REFUSAL, NOT WHETHER ONE HAPPENED.
//
// A claim that only checks "the artifact refused" is satisfied by any refusal for any reason, so it
// would stay green if the foreign-host arm collapsed into the unobserved one. This recovers both
// identities out of the typed refusal and checks they are the two hosts that actually disagreed.
test fn a_foreign_host_axis_refuses_with_both_identities_recoverable() -> Bool {
  match artifact_outcome(
    axis: c3_axis_at(host: "srv3" as HostIdentity, linger: LingerObservedEnabled),
  ) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: r } =>
      match r {
        SparkAxisSubjectHostMismatch { axis_host: ah, subject_host: sh } =>
          ah == ("srv3" as HostIdentity) && sh == subject_host
        SparkAxisUnobservedRefusal { host: _ } => false
        SparkAxisPlanningRefused { host: _, cause: _ } => false
      }
  }
}

// The enrolled-unobserved case must inhabit its OWN arm, not a generic refusal. These are different
// operator responses -- wire the observer, versus fix a mis-tagged axis -- and prose cannot be asked
// which one it is.
test fn an_unobserved_axis_refuses_as_unobserved_and_not_as_something_else() -> Bool {
  match artifact_outcome(axis: SparkServingAxisUnobserved { host: subject_host }) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: r } =>
      match r {
        SparkAxisUnobservedRefusal { host: h } => h == subject_host
        SparkAxisSubjectHostMismatch { axis_host: _, subject_host: _ } => false
        SparkAxisPlanningRefused { host: _, cause: _ } => false
      }
  }
}

// And a planning refusal inhabits the third arm, so all three are distinguishable rather than three
// spellings of one string.
test fn a_planning_refusal_refuses_as_a_planning_refusal() -> Bool {
  match artifact_outcome(axis: c3_axis(linger: LingerUnobservedState)) {
    FleetConvergePlanArtifactReady { artifact: _ } => false
    FleetConvergePlanArtifactRefused { refusal: r } =>
      match r {
        SparkAxisPlanningRefused { host: h, cause: _ } => h == subject_host
        SparkAxisUnobservedRefusal { host: _ } => false
        SparkAxisSubjectHostMismatch { axis_host: _, subject_host: _ } => false
      }
  }
}

