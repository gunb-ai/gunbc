  }
}

test fn observation_report_refused_is_not_success() -> Bool {
  !spark_serving_observation_report_succeeded(
    report: gunbc.spark.serving_observe.SparkServingObservationReportRefused {
      cause: "attempt identity is not a safe path segment" as std.types.NonEmptyStr,
    },
  )
}

// The report carries readback + observation together; these fixtures only vary the observation, so
// the readback is a fixed bare one and the wrapping stays out of every assertion below.
fn ho(observation: SparkServingObservation) -> SparkServingHostObservation {
  SparkServingHostObservation {
    readback: readback_absent(),
    observation: observation,
    account: ManagedAccountProbeRefused { cause: "fixture: no account probe was run" },
  }
}

test fn per_host_refusal_report_is_not_success() -> Bool {
  match derive_spark_serving_observation(readback: readback_active_complete()) {
    SparkServingObserved { host: _, loaded_release: loaded } =>
      !spark_serving_observation_report_succeeded(
        report: gunbc.spark.serving_observe.SparkServingObservationsProduced {
          first: ho(observation: gunbc.spark.serving_release.SparkServingObserved { host: "srv5", loaded_release: loaded }),
          more: [
            ho(observation: gunbc.spark.serving_release.SparkServingObservationRefused {
              host: "srv6",
              cause: "gunbc-spark-serving.service is inactive" as std.types.NonEmptyStr,
            }),
          ],
        },
      )
    SparkServingAbsent { host: _ } => false
    SparkServingObservationRefused { host: _, cause: _ } => false
  }
}

test fn unobserved_nvidia_driver_refuses_active_observation() -> Bool {
  match derive_spark_serving_observation(readback: gunbc.spark.serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: gunbc.spark.serving_loaded_release.SparkServingUnitActive,
    runtime_version: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: test.claim.spark_serving_observe_witness_test.witness_required_release_asset_digest_hex),
    model_name: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    bind_address: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    boot_provenance: gunbc.spark.serving_boot_provenance.BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as std.types.NonEmptyStr },
    grants: gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    SparkServingObservationRefused { host: _, cause: c } =>
      string_contains(s: c as String, pattern: "unobserved")
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

test fn driver_too_old_refuses_active_observation() -> Bool {
  match derive_spark_serving_observation(readback: gunbc.spark.serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: gunbc.spark.serving_loaded_release.SparkServingUnitActive,
    runtime_version: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: test.claim.spark_serving_observe_witness_test.witness_required_release_asset_digest_hex),
    model_name: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_too_old_wire),
    bind_address: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    boot_provenance: gunbc.spark.serving_boot_provenance.BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as std.types.NonEmptyStr },
    grants: gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    SparkServingObservationRefused { host: _, cause: c } =>
      string_contains(s: c as String, pattern: "below minimum")
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

test fn driver_too_old_report_is_not_success() -> Bool {
  match derive_spark_serving_observation(readback: gunbc.spark.serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: gunbc.spark.serving_loaded_release.SparkServingUnitActive,
    runtime_version: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: test.claim.spark_serving_observe_witness_test.witness_required_release_asset_digest_hex),
    model_name: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: gunbc.spark.serving_readback_parse.SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_too_old_wire),
    bind_address: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    boot_provenance: gunbc.spark.serving_boot_provenance.BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as std.types.NonEmptyStr },
    grants: gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }) {
    SparkServingObservationRefused { host: h, cause: c } =>
      !spark_serving_observation_report_succeeded(
        report: gunbc.spark.serving_observe.SparkServingObservationsProduced {
          first: ho(observation: gunbc.spark.serving_release.SparkServingObservationRefused { host: h, cause: c }),
          more: [],
        },
      )
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

data p0_6_loaded_release_note: String = "P0-6: SparkServingReadback carries no configuration_digest or capacity fields; derive_loaded_spark_serving_release builds SparkServingRelease from runtime closure + model only."

test fn loaded_release_derivation_excludes_desired_policy_fields() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn version_only_without_asset_digest_refuses_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: gunbc.spark.serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: gunbc.spark.serving_loaded_release.SparkServingUnitActive,
