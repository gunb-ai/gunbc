  }) {
    SparkServingObservationRefused { host: _, cause: c } =>
      string_contains(s: c as String, pattern: "install receipt")
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

test fn active_complete_readback_derives_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn active_complete_readback_derives_observed() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Absent => false
    Present { value: expected } =>
      match derive_spark_serving_observation(readback: readback_active_complete()) {
        SparkServingObserved { host: h, loaded_release: r } =>
          h == "srv5"
            && (spark_serving_release_identity(spec: r).digest.digest as String)
              == (expected.digest.digest as String)
        SparkServingAbsent { host: _ } => false
        SparkServingObservationRefused { host: _, cause: _ } => false
      }
  }
}

test fn inactive_unit_readback_refuses_observation() -> Bool {
  match derive_spark_serving_observation(readback: gunbc.spark_serving_loaded_release.SparkServingReadback {
    host: "srv6",
    unit_outcome: SparkServingUnitInactive,
    runtime_version: SparkServingReadbackAbsent,
    runtime_release_asset_digest: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
  }) {
    SparkServingObservationRefused { host: h, cause: c } =>
      h == "srv6" && string_contains(s: c as String, pattern: "inactive")
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}

test fn api_field_refusal_surfaces_before_fingerprint_refusal() -> Bool {
  match derive_spark_serving_observation(readback: gunbc.spark_serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: gunbc.spark_serving_readback_parse.SparkServingReadbackRefused {
      cause: "ollama /api/version body is not parseable JSON" as std.types.NonEmptyStr,
    },
    runtime_release_asset_digest: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackAbsent,
    model_tag: SparkServingReadbackAbsent,
    model_manifest_digest: SparkServingReadbackAbsent,
    nvidia_driver: SparkServingReadbackAbsent,
    bind_address: SparkServingReadbackAbsent,
  }) {
    SparkServingObservationRefused { host: _, cause: c } =>
      string_contains(s: c as String, pattern: "not parseable JSON")
    SparkServingObserved { host: _, loaded_release: _ } => false
