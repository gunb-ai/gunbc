test fn driver_too_old_report_is_not_success() -> Bool {
  match derive_spark_serving_observation(readback: SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: witness_runtime_materialization_identity_present(hex: witness_required_release_asset_digest_hex),
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_too_old_wire),
    bind_address: SparkServingReadbackAbsent,
  }) {
    SparkServingObservationRefused { host: h, cause: c } =>
      !spark_serving_observation_report_succeeded(
        report: SparkServingObservationsProduced {
          first: SparkServingObservationRefused { host: h, cause: c },
          more: [],
        },
      )
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingAbsent { host: _ } => false
  }
}

data p0_6_loaded_release_note: String = "P0-6: SparkServingReadback carries no configuration_digest or capacity fields; derive_loaded_spark_serving_release builds SparkServingRelease from runtime closure + model only."

test fn loaded_release_derivation_excludes_desired_policy_fields() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn version_only_without_asset_digest_refuses_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: SparkServingReadbackPresent { value: witness_pinned_runtime_version_wire },
    runtime_materialization_identity: SparkServingReadbackAbsent,
    model_name: SparkServingReadbackPresent { value: "gpt-oss" },
    model_tag: SparkServingReadbackPresent { value: "20b" },
    model_manifest_digest: SparkServingReadbackPresent { value: witness_model_digest },
    nvidia_driver: witness_nvidia_driver_present(wire: witness_nvidia_driver_satisfied_wire),
    bind_address: SparkServingReadbackAbsent,
  }) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn jetpack5_asset_digest_does_not_match_required_closure_digest() -> Bool {
  match ollama_runtime_materialization_identity_for_observed_release(
    version: witness_pinned_runtime_version_wire,
    asset_digest_hex: witness_jetpack5_release_asset_digest_hex,
  ) {
    Present { value: jetpack_digest } =>
      (jetpack_digest.digest as String) != (ollama_runtime_materialization_identity_for_required_release().digest as String)
        && (jetpack_digest.digest as String) == (ollama_runtime_materialization_identity(rel: ollama_v0_32_9_jetpack5_release).digest as String)
    Absent => false
  }
}

// REVIEW 52605. The runner-side observe entry greened on any receipt write, so a host that could
// not be probed at all reported the same exit code as one that answered. The repair adds a
// distinct axis: an observation that was MADE (present or absent) is not an observation that
// SUCCEEDED. These pin both directions, because collapsing them either way is a real defect --
// treating absent as a probe failure would red the step on a correct reading of a bare host.
test fn refused_observation_was_not_made() -> Bool {
  spark_serving_observation_was_made(
    observation: SparkServingObservationRefused {
      host: "srv5",
      cause: "ssh exec refused" as NonEmptyStr,
    },
  ) == false
}

test fn absent_observation_was_made_though_it_did_not_succeed() -> Bool {
  let obs = SparkServingAbsent { host: "srv5" }
  spark_serving_observation_was_made(observation: obs)
    && spark_serving_observation_succeeded(observation: obs) == false
}

test fn report_with_a_refused_host_refuses_even_when_a_sibling_answered() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationsProduced {
      first: SparkServingAbsent { host: "srv5" },
      more: [
        SparkServingObservationRefused {
          host: "srv6",
          cause: "ssh exec refused" as NonEmptyStr,
        },
      ],
    },
  ) == false
}

test fn report_of_two_bare_hosts_counts_as_observed() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationsProduced {
      first: SparkServingAbsent { host: "srv5" },
      more: [SparkServingAbsent { host: "srv6" }],
    },
  )
}

test fn empty_observation_list_produces_no_report_rather_than_a_clean_one() -> Bool {
  match spark_serving_observation_report_from_observations(observations: []) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn a_refused_report_is_never_read_as_observed() -> Bool {
  spark_serving_report_observations_were_made(
    report: SparkServingObservationReportRefused {
      cause: "no host was probed" as NonEmptyStr,
    },
  ) == false
}

// THE COMMA IS ADMITTED AND THE BRACE IS NOT, asserted as a pair because a widening argued on paper
// and unchecked in the tree is the specification-without-execution trap. The comma is inert in POSIX
// sh; brace expansion is the one context that gives it meaning, and it needs braces, which stay
// refused. If a future edit widens the alphabet toward `{`, this goes red.
test fn the_word_alphabet_admits_a_comma_and_still_refuses_a_brace() -> Bool {
  match portable_remote_words(raws: ["nvidia-smi", "--format=csv,noheader"]) {
    Absent => false
    Present { value: _ } =>
      match portable_remote_words(raws: ["echo", "\{a,b}"]) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

// THE PROBE THAT FORCED IT, asserted against the real argv rather than a hand-written stand-in: the
// read-only observation's nvidia leg had been refused at the transport since it was written, and
// nothing could report why until the refusal reason was carried.
test fn the_nvidia_driver_probe_is_portable() -> Bool {
  match portable_remote_words(raws: spark_serving_nvidia_driver_probe_words) {
    Present { value: _ } => true
    Absent => false
  }
}
