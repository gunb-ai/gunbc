module test.claim.spark_serving_observe_witness_test

import std.types { String, NonEmptyStr }
import extdeps.ssh.session { SshSessionExecResult }
import gunbc.spark_serving_release {
  SparkServingObservation, SparkServingAbsent, SparkServingObserved,
  SparkServingObservationRefused,
}
import gunbc.spark_serving_loaded_release {
  SparkServingReadback,
  SparkServingUnitActive,
  SparkServingUnitInactive,
  SparkServingUnitAbsent,
  SparkServingUnitObservationRefused,
  derive_spark_serving_observation,
  derive_loaded_spark_serving_release_identity,
}
import gunbc.spark_serving_observe { spark_serving_unit_outcome_from_probe_results }

data witness_model_digest: String = "a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456"

data witness_pinned_runtime_version: String = "v0.11.0"

fn readback_absent() -> SparkServingReadback {
  SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitAbsent,
    runtime_version: none,
    model_repository: none,
    model_revision_digest: none,
    bind_address: none,
  }
}

fn readback_unreachable() -> SparkServingReadback {
  SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitObservationRefused {
      cause: "unit LoadState probe leg did not run" as NonEmptyStr,
    },
    runtime_version: none,
    model_repository: none,
    model_revision_digest: none,
    bind_address: none,
  }
}

fn readback_active_incomplete() -> SparkServingReadback {
  SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: Present { value: witness_pinned_runtime_version },
    model_repository: none,
    model_revision_digest: none,
    bind_address: none,
  }
}

fn readback_active_complete() -> SparkServingReadback {
  SparkServingReadback {
    host: "srv5",
    unit_outcome: SparkServingUnitActive,
    runtime_version: Present { value: witness_pinned_runtime_version },
    model_repository: Present { value: "gpt-oss" },
    model_revision_digest: Present { value: witness_model_digest },
    bind_address: none,
  }
}

test fn absent_readback_derives_absent_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_absent()) {
    SparkServingAbsent { host: h } => h == "srv5"
    SparkServingObserved { host: _, loaded_release: _ } => false
    SparkServingObservationRefused { host: _, cause: _ } => false
  }
}

data unreachable_host_red_control_note: String = "RED CONTROL: an unreachable host or any probe leg that did not run must refuse observation, never license SparkServingAbsent (empty-observation narrow)."

test fn unreachable_readback_does_not_derive_absent_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_unreachable()) {
    SparkServingObservationRefused { host: h, cause: _ } => h == "srv5"
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}

test fn load_state_not_found_probe_derives_unit_absent() -> Bool {
  match spark_serving_unit_outcome_from_probe_results(
    load_state: Present {
      value: SshSessionExecResult {
        exit_code: 0,
        success: true,
        stdout: "not-found",
        stderr: "",
      },
    },
    is_active: Present {
      value: SshSessionExecResult {
        exit_code: 3,
        success: false,
        stdout: "inactive",
        stderr: "",
      },
    },
  ) {
    SparkServingUnitAbsent => true
    SparkServingUnitActive => false
    SparkServingUnitInactive => false
    SparkServingUnitObservationRefused { cause: _ } => false
  }
}

test fn load_state_probe_leg_absent_refuses_unit_outcome() -> Bool {
  match spark_serving_unit_outcome_from_probe_results(
    load_state: none,
    is_active: none,
  ) {
    SparkServingUnitObservationRefused { cause: c } =>
      string_contains(s: c as String, pattern: "LoadState probe leg did not run")
    SparkServingUnitAbsent => false
    SparkServingUnitActive => false
    SparkServingUnitInactive => false
  }
}

test fn active_incomplete_readback_refuses_observation() -> Bool {
  match derive_spark_serving_observation(readback: readback_active_incomplete()) {
    SparkServingObservationRefused { host: h, cause: c } =>
      h == "srv5" && string_contains(s: c as String, pattern: "fingerprint")
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}

test fn active_complete_readback_derives_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn active_complete_readback_derives_observed() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: readback_active_complete()) {
    Absent => false
    Present { value: expected } =>
      match derive_spark_serving_observation(readback: readback_active_complete()) {
        SparkServingObserved { host: h, loaded_release: r } =>
          h == "srv5" && (r.digest.digest as String) == (expected.digest.digest as String)
        SparkServingAbsent { host: _ } => false
        SparkServingObservationRefused { host: _, cause: _ } => false
      }
  }
}

data wrong_runtime_version_red_control_note: String = "RED CONTROL: a unit marked active without the pinned runtime version must refuse identity, never fabricate a digest from desired state."

test fn wrong_runtime_version_refuses_loaded_identity() -> Bool {
  match derive_loaded_spark_serving_release_identity(readback: SparkServingReadback {
    host: "srv6",
    unit_outcome: SparkServingUnitActive,
    runtime_version: Present { value: "v0.0.0" },
    model_repository: Present { value: "gpt-oss" },
    model_revision_digest: Present { value: witness_model_digest },
    bind_address: none,
  }) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn inactive_unit_readback_refuses_observation() -> Bool {
  match derive_spark_serving_observation(readback: SparkServingReadback {
    host: "srv6",
    unit_outcome: SparkServingUnitInactive,
    runtime_version: none,
    model_repository: none,
    model_revision_digest: none,
    bind_address: none,
  }) {
    SparkServingObservationRefused { host: h, cause: c } =>
      h == "srv6" && string_contains(s: c as String, pattern: "inactive")
    SparkServingAbsent { host: _ } => false
    SparkServingObserved { host: _, loaded_release: _ } => false
  }
}
