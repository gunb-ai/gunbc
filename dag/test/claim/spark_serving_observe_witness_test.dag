fn readback_absent() -> gunbc.spark.serving_loaded_release.SparkServingReadback {
  gunbc.spark.serving_loaded_release.SparkServingReadback {
    host: "srv5",
    unit_outcome: gunbc.spark.serving_loaded_release.SparkServingUnitAbsent,
    runtime_version: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    runtime_materialization_identity: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    model_name: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    model_tag: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    model_manifest_digest: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    nvidia_driver: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    bind_address: gunbc.spark.serving_readback_parse.SparkServingReadbackAbsent,
    boot_provenance: gunbc.spark.serving_boot_provenance.BootProvenanceUnobserved { cause: "fixture readback carries no boot probe" as std.types.NonEmptyStr },
    grants: gunbc.spark.managed_access_bootstrap.GrantProbeRefused { cause: "fixture readback carries no grant probe" },
  }
}

