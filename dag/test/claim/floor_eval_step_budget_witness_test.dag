  ClaimPreemptionReachability, CooperativelyPollable,
  ClaimEvalStepStanding, EvalStepsWithinBudget, EvalStepsOverBudget, EvalStepsOverBudgetUnderDeclaredDrop,
  claim_eval_step_standing, claim_eval_step_standing_blocks, claim_eval_step_standing_for_identity,
  claim_safety_outcome, claim_safety_outcome_blocks,
  ClaimCeilingTier, GrandfatheredTier, NewWitnessTier,
  claim_ceiling_tier, claim_ceiling_envelope_ms, claim_ceiling_eval_step_budget,
  claim_eval_step_budget_for_identity,
  required_floor_claim_work_envelope_ms, required_floor_per_subject_cpu_line_ms,
  required_floor_new_witness_envelope_ms,
  required_floor_claim_cost_line_ms,
  required_floor_claim_wall_safety_limit_ms,
