  EvalStepRateGrounding, RateIsTheFlooredRatio,
  RateAboveMeasuredRatio, RateBelowMeasuredRatio,
  eval_step_rate_grounding_holds,
  SpecimenStepsGrounding, SpecimenStepsMatchThePin, SpecimenStepsDiffer,
  specimen_steps_grounding, specimen_steps_grounding_holds,
