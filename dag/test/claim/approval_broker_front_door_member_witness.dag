module test.claim.approval_broker_front_door_member_witness
import gunbc.fleet.fleet_posix_accounts { fleet_posix_ci_runner_principal }


import std.types { Bool, String, NonEmptyStr, List, CommitSha }
import v2.std.orchestration { PipelineStep, Do, Run }
import extdeps.tailscale.serve { tailscale_serve_enable_argv, tailscale_serve_off_argv }
import gunbc.auth.approval_broker_cutover {
  approval_front_door_mounts_installed,
  approval_broker_front_door_endpoints,
}
import gunbc.auth.approval_broker_endpoint { approval_broker_listen_port }
import gunbc.auth.approval_device_wire { approval_device_enrol_path }
import gunbc.live_deploy.retract_legs {
  DeployRetractPlan, RetractPlanReady, RetractPlanRefused, deploy_retract_artifact_plan,
  RetractServeOff, RetractDisableIfLoaded, RetractRemoveForce, RetractRemoveEmptyDirectory, RetractRemoveRecursive, RetractDaemonReload, RetractUnitGoneReadback,
}
import gunbc.live_deploy.release_locus { RevisionBoundAtEmission }
import gunbc.live_deploy.spec {
  DeploymentSpec, DeploymentStep, ArtifactStep, Dependency, DeploymentArtifactStep,
  UpsertOwned,
  ApprovalBrokerFrontDoor,
  deployment_approval_broker_front_door_endpoints,
  tailscale_default_https_port,
}
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.shell_command_text { shell_privileged_command_text_of_argv }
import std.optional { Present, Absent }

// THE BROKER'S TAILNET EXPOSURE IS A DEPLOYMENT MEMBER WHOSE PRESENCE IS THE ROUTING ROW. The
// enrolment 404 (2026-09-30) was a cutover that declared its front-door argv and had no deploy
// member realizing it, so the device routes moved to a process nothing could reach. These claims
// sit at the live_deploy interface: they read the spec's steps and the member's emitted commands,
// and supply nothing the real producers compute.

fn front_door_members(spec: DeploymentSpec) -> List<DeploymentArtifactStep> {
  fold(spec.steps, init: [], f: (acc, s) => match s {
    ArtifactStep { step: a } => match a.kind {
      UpsertOwned { kind: ApprovalBrokerFrontDoor } => concat(acc, [a])
      _ => acc
    }
    Dependency { step: _ } => acc
  })
}

fn step_commands(steps: List<PipelineStep>) -> List<String> {
  fold(steps, init: [], f: (acc, s) => match s {
    Do { run: r } =>
      if string_contains(s: r.command, pattern: "__GUNBC_HOST_SCRIPT_STEP__") {
        acc
      } else {
        concat(acc, [r.command])
      }
    _ => acc
  })
}

fn contains_all(cmds: List<String>, wants: List<String>) -> Bool {
  fold(wants, init: true, f: (acc, w) =>
    acc && fold(cmds, init: false, f: (hit, c) => hit || string_contains(s: c, pattern: w)))
}

// THE MEMBER EXISTS EXACTLY WHEN THE ROUTING ROW SAYS THE MOUNTS DO, in both directions. THE RED:
// emit the member unconditionally (the mounts would route to a broker the authority refuses, a 503
// in place of the 404), or drop it (the 404 this repairs).
test fn the_front_door_member_follows_the_routing_row() -> Bool {
  let n = count(front_door_members(spec: deployment_spec_srv1()))
  if approval_front_door_mounts_installed() { n == 1 } else { n == 0 }
}

// THE MEMBER REALIZES THE CUTOVER'S OWN ENDPOINTS, not a second spelling of them: its endpoints are
// the plan's, on the default https listener, backed by the broker's one port.
test fn the_member_endpoints_are_the_cutover_endpoints() -> Bool {
  let mine = map(deployment_approval_broker_front_door_endpoints(), e => join(tailscale_serve_enable_argv(endpoint: e), " "))
  let plan = map(approval_broker_front_door_endpoints(https_port: tailscale_default_https_port, backend_port: approval_broker_listen_port), e => join(tailscale_serve_enable_argv(endpoint: e), " "))
  count(mine) == 2 && mine == plan
}

// THE DEVICE ROUTES RIDE THE /approve MOUNT. The phone's enrolment path is under a mount prefix
// the member installs, so no third mount is owed for them. THE RED: a device path moved outside
// /approve would leave enrolment unrouted again with this member green.
test fn the_device_enrolment_path_is_under_an_installed_mount() -> Bool {
  starts_with(s: approval_device_enrol_path as String, prefix: "/approve/")
    && contains_all(
      cmds: map(deployment_approval_broker_front_door_endpoints(), e => join(tailscale_serve_enable_argv(endpoint: e), " ")),
      wants: ["--set-path=/approve"],
    )
}

fn retract_serve_off_texts(plan: DeployRetractPlan) -> List<String> {
  match plan {
    RetractPlanRefused { step: _, reason: _ } => ["REFUSED"]
    RetractPlanReady { legs: ls } =>
      flat_map(ls, l => match l {
        RetractServeOff { endpoint: e } => [join(tailscale_serve_off_argv(endpoint: e), " ")]
        RetractDisableIfLoaded { unit: _ } => []
        RetractRemoveForce { paths: _ } => []
        RetractRemoveEmptyDirectory { path: _ } => []
        RetractRemoveRecursive { path: _ } => []
        RetractDaemonReload => []
        RetractUnitGoneReadback { unit: _ } => []
      })
  }
}

// The retract half of #14332's apply_and_teardown_realize_both_mappings, whose apply half asserted
// the text of the deleted bash upsert. The typed apply has no front-door-specific claim yet; its
// families are pinned only as a whole by live_deploy_apply_plan_witness. This half reads the real
// retract plan.
test fn teardown_retracts_both_front_door_mappings() -> Bool {
  let spec = deployment_spec_srv1()
  let down_art = DeploymentArtifactStep { kind: UpsertOwned { kind: ApprovalBrokerFrontDoor }, path: "/approve" as NonEmptyStr }
  let down = retract_serve_off_texts(plan: deploy_retract_artifact_plan(art: down_art, spec: spec))
  let plan = approval_broker_front_door_endpoints(https_port: tailscale_default_https_port, backend_port: approval_broker_listen_port)
  count(plan) > 0
    && down == map(plan, e => join(tailscale_serve_off_argv(endpoint: e), " "))
}
