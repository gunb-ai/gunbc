module test.claim.workflow_default_module_scope_witness_test

// EXECUTING evidence that a workflow parameter's CLI default resolves the data declaration ITS
// OWN MODULE authored, and not a same-named declaration in another module of the same compile.
//
// THE DEFECT THIS CLOSES, measured on main. v1.compiler.emit_rust build_data_body_index folded
// every data body of every module into ONE map keyed by the BARE authored name, and
// fold_constant_default_expr read a param default's `ExprVar` through it. Two modules spelling a
// data declaration the same way therefore resolved by last-wins over the fold order, which is the
// sorted source path. gunbc.tools.review declares `data default_model` as a Claude model id and
// gunbc.tools.review_codex declares the same spelling as an OpenAI one; both are consumed as the
// `model` param default of a workflow func; `review.dag` sorts before `review_codex.dag`. So BOTH
// review tools emitted the OpenAI id and the Claude reviewer's CLI default was silently the other
// backend's model. Nothing refused -- a well-formed literal reached the emitted clap default --
// which is DESIGN section 5's fabricated plausible output, below the guarantee ladder rather than
// a rung on it. The repair keys every data body under its declaring module as well as bare, and
// the fold consults the referring module's key first.
//
// WHY THIS IS THE PAIR IT IS. Both arms compile the SAME subject module,
// v2.test.fixture.workflow_default_module_scope.subject, whose `wdms_run` param default names its
// own `wdms_default_model`. The arms differ by one declaration in the entry: the colliding arm
// authors a second `wdms_default_model` with a different value, the control arm authors none. The
// control establishes that the fold reaches this default at all, so the colliding arm's include is
// about WHICH declaration answered rather than about whether anything did; the colliding arm's
// exclusion of the intruder value is what fails before the repair. A repair that simply stopped
// folding would fail the control, and a repair that kept bare last-wins fails the collision arm --
// neither arm is satisfiable by a check that always answers the same way.
//
// THE ENTRY MODULE IS THE INTRUDER, NOT THE SUBJECT, and that is forced rather than chosen.
// compile_dag_rust_emit_check appends the authored entry to its resolved imports LAST, so a
// collision authored entirely inside the entry would have been won by the entry under the old
// index too and could never have gone red.
//
// COST. Two full frontend-and-emitter crossings over a TWO-MODULE closure: the subject imports
// nothing and declares its own `uses` type, following the fixture discipline
// workflow_default_field_projection_fold_witness_test recorded after one of its arms measured
// 62567ms against a 5000ms budget on an std-importing closure.

data wdms_colliding_entry_source: String = "module wdms_probe_collide\n\nimport v2.test.fixture.workflow_default_module_scope.subject\n\ndata wdms_probe_use: String = wdms_probe_marker\n\ndata wdms_default_model: String = \"wdms-intruder\"\n"

data wdms_control_entry_source: String = "module wdms_probe_control\n\nimport v2.test.fixture.workflow_default_module_scope.subject\n\ndata wdms_probe_use: String = wdms_probe_marker\n"

// THE DISCRIMINATING ARM. Red before the repair: the entry's `wdms_default_model` was folded into
// the subject module's workflow default, so the emitted clap default carried "wdms-intruder".
test fn a_param_default_resolves_its_own_module_declaration_over_a_foreign_one() -> Bool {
  compile_dag_rust_emit_check(
    wdms_colliding_entry_source,
    "src/main.rs",
    ["default_value = \"wdms-subject-owned\""],
    ["wdms-intruder"]
  )
}

// THE CONTROL. Same subject, no collision authored: the default folds and reaches the emitted CLI.
// Without it, the arm above is satisfied by any change that stops emitting the intruder value for
// a reason unrelated to scope.
test fn a_param_default_with_no_collision_still_folds_into_the_cli_default() -> Bool {
  compile_dag_rust_emit_check(
    wdms_control_entry_source,
    "src/main.rs",
    ["default_value = \"wdms-subject-owned\""],
    ["wdms-intruder"]
  )
}
