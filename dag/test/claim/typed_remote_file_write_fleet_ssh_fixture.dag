module test.claim.typed_remote_file_write_fleet_ssh_fixture

import std.types { NonEmptyStr }
import gunbc.fleet_known_hosts_anchor {
  FleetSshAttemptIdentity,
  FleetSshExecutionContext,
  FleetOpenSshTrustPolicy,
  KnownHostsAnchor,
  fleet_ssh_attempt_identity,
  fleet_known_hosts_anchor_path,
  fleet_known_hosts_registry_identity,
  known_hosts_anchor_seal,
  fleet_openssh_trust_policy_seal,
  fleet_ssh_execution_context_seal,
}
import extdeps.ssh { SshPublicKey, Ed25519 }
import gunbc.fleet_ssh_credential_verify {
  FleetSshCredentialVerification,
  FleetSshCredentialVerified,
  FleetSshCredentialIdentityMismatch,
  FleetSshCredentialDerivationRefused,
  expected_public_key_line,
  classify_derived_public_key_line,
}

data fixture_attempt_raw: String = "typed-remote-file-write-witness"

fn fixture_attempt() -> FleetSshAttemptIdentity? {
  fleet_ssh_attempt_identity(raw: fixture_attempt_raw)
}

fn known_hosts_anchor_hermetic_witness_fixture(
  attempt: FleetSshAttemptIdentity,
) -> KnownHostsAnchor {
  let registry_identity = fleet_known_hosts_registry_identity()
  known_hosts_anchor_seal(
    path: fleet_known_hosts_anchor_path(attempt: attempt),
    registry_identity: registry_identity,
    materialized_content_identity: registry_identity,
    attempt: attempt,
  )
}

fn fleet_openssh_trust_policy_hermetic_witness_fixture(
  anchor: KnownHostsAnchor,
) -> FleetOpenSshTrustPolicy {
  fleet_openssh_trust_policy_seal(anchor: anchor)
}

// The hermetic credential fixture goes THROUGH the real classifier rather than around it. There is
// no other mint, so the fixture cannot assert a binding into existence; it must present a synthetic
// derivation that matches, which is the same wall production traverses. `fixture_identity_file` is
// never opened -- classification is pure, so no key exists on disk in a witness run.
data fixture_identity_file: NonEmptyStr = "/tmp/gunbc-trfw-witness-key"

data fixture_public_key: SshPublicKey = SshPublicKey {
  algorithm: Ed25519,
  material: "AAAAC3NzaC1lZDI1NTE5AAAAIHERMETICWITNESSFIXTUREKEYMATERIAL0" as NonEmptyStr,
  comment: "typed-remote-file-write-witness",
}

// A derivation whose stdout IS the expected line, so the match arm is reached honestly.
fn fixture_credential_verification() -> FleetSshCredentialVerification {
  classify_derived_public_key_line(
    identity_file: fixture_identity_file,
    expected_key: fixture_public_key,
    derivation_succeeded: true,
    derivation_stdout: expected_public_key_line(key: fixture_public_key),
    derivation_stderr: "",
  )
}

fn fleet_ssh_execution_context_hermetic_witness_fixture() -> FleetSshExecutionContext?
  admit_callers: [
    decl_ref(module_path: "test.claim.typed_remote_file_write_witness", decl_name: "w_over_fleet_ssh_hermetic_mock_exec_accepted"),
  ]
{
  match fixture_attempt() {
    Absent => none
    Present { value: attempt } => {
      let anchor = known_hosts_anchor_hermetic_witness_fixture(attempt: attempt)
      match fixture_credential_verification() {
        FleetSshCredentialVerified { binding: binding } => Present {
          value: fleet_ssh_execution_context_seal(
            attempt: attempt,
            trust: fleet_openssh_trust_policy_hermetic_witness_fixture(anchor: anchor),
            credential: binding,
          ),
        }
        FleetSshCredentialIdentityMismatch { expected_line: _, observed_line: _ } => none
        FleetSshCredentialDerivationRefused { cause: _ } => none
      }
    }
  }
}
