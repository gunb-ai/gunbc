module test.claim.moonshot.kimi_code_k2_8_preview_witness

import std.types { Bool, String, NonEmptyStr }
import std.measure { token_count_value }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.moonshot.kimi_code_k2_8_preview {
  kimi_for_coding_wire_id,
  kimi_k28_preview_served_version_name,
  kimi_k27_code_highspeed_served_version_name,
  kimi_for_coding_k28_preview_assignment,
  kimi_for_coding_highspeed_assignment,
  AliasEndUnobserved,
  AliasEndObserved,
  kimi_code_is_request_model_id,
  kimi_k28_thinking_effort_wire,
  kimi_k28_thinking_effort_wires,
  kimi_k28_default_thinking_effort,
  KimiK28EffortLow,
  KimiK28EffortHigh,
  KimiK28EffortMax,
  kimi_k28_declared_context_ceiling,
  kimi_code_route,
  KimiForCoding,
  KimiK3,
  KimiK3_256k,
  KimiForCodingHighspeed,
  KimiThinkingOff,
  KimiThinkingOn,
  ServedK28PreviewThinkingOff,
  ServedK27CodeHighspeed,
  kimi_code_served_version_name,
  kimi_k28_vendor_characterization_performance_close_to_k3,
  kimi_k28_vendor_characterization_more_efficient_thinking,
  kimi_vendor_characterization_as_quality_reading,
  KimiQualityReadingRefusedUnestablishedMeasurement,
  KimiQualityReadingRefusedVendorCharacterization,
  kimi_k28_artifact_standing,
  OfficialCheckpointNotLocated,
  OfficialCheckpointLocated,
  kimi_k28_local_construction,
  KimiK28LocalModelArtifact,
  KimiK28VllmCandidate,
  KimiK28FitCalculation,
  kimi_k28_local_construction_is_unconstructible,
  kimi_code_executed_version_without_receipt,
  ExecutedVersionUnobserved,
  ExecutedVersionObserved,
  kimi_code_k28_preview_provider_integration_frontier,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn kimi_for_coding_wire_is_unchanged_while_served_version_changes() -> Bool {
  (kimi_for_coding_k28_preview_assignment.model_id as String) == (kimi_for_coding_wire_id as String)
    && (kimi_for_coding_wire_id as String) == "kimi-for-coding"
    && (kimi_for_coding_k28_preview_assignment.served_version as String)
      == (kimi_k28_preview_served_version_name as String)
    && (kimi_for_coding_k28_preview_assignment.effective_from as String) == "2026-09-11"
    && match kimi_for_coding_k28_preview_assignment.effective_until {
      AliasEndUnobserved => true
      AliasEndObserved { on: _ } => false
    }
}

test fn k2_8_preview_name_is_not_a_request_model_id() -> Bool {
  !kimi_code_is_request_model_id(spelling: kimi_k28_preview_served_version_name)
    && kimi_code_is_request_model_id(spelling: kimi_for_coding_wire_id)
}

test fn k2_8_preview_declares_low_high_max_and_defaults_to_max() -> Bool {
  (kimi_k28_thinking_effort_wire(effort: KimiK28EffortLow) as String) == "low"
    && (kimi_k28_thinking_effort_wire(effort: KimiK28EffortHigh) as String) == "high"
    && (kimi_k28_thinking_effort_wire(effort: KimiK28EffortMax) as String) == "max"
    && (kimi_k28_thinking_effort_wires |> count) == 3
    && match kimi_k28_default_thinking_effort {
      KimiK28EffortMax => true
      KimiK28EffortLow => false
      KimiK28EffortHigh => false
    }
}

test fn k2_8_preview_declared_context_ceiling_is_1048576() -> Bool {
  token_count_value(t: kimi_k28_declared_context_ceiling) == 1048576
}

test fn thinking_disabled_routes_k3_ids_to_k2_8_without_relabeling_the_request() -> Bool {
  let k3 = kimi_code_route(requested: KimiK3, thinking: KimiThinkingOff)
  let k3_256k = kimi_code_route(requested: KimiK3_256k, thinking: KimiThinkingOff)
  let k28 = kimi_code_route(requested: KimiForCoding, thinking: KimiThinkingOff)
  (k3.requested_wire as String) == "k3"
    && (k3_256k.requested_wire as String) == "k3-256k"
    && (k28.requested_wire as String) == "kimi-for-coding"
    && match k3.served_version {
      ServedK28PreviewThinkingOff => true
      ServedK28Preview => false
      ServedK3 => false
      ServedK27CodeHighspeed => false
    }
    && match k3_256k.served_version {
      ServedK28PreviewThinkingOff => true
      ServedK28Preview => false
      ServedK3 => false
      ServedK27CodeHighspeed => false
    }
    && match k28.served_version {
      ServedK28PreviewThinkingOff => true
      ServedK28Preview => false
      ServedK3 => false
      ServedK27CodeHighspeed => false
    }
    && (kimi_code_served_version_name(v: k3.served_version) as String) == "K2.8 Preview"
}

test fn highspeed_remains_k2_7_code_highspeed() -> Bool {
  let off = kimi_code_route(requested: KimiForCodingHighspeed, thinking: KimiThinkingOff)
  let on = kimi_code_route(
    requested: KimiForCodingHighspeed,
    thinking: KimiThinkingOn { effort: KimiK28EffortMax },
  )
  (kimi_for_coding_highspeed_assignment.served_version as String)
      == (kimi_k27_code_highspeed_served_version_name as String)
    && (off.requested_wire as String) == "kimi-for-coding-highspeed"
    && (on.requested_wire as String) == "kimi-for-coding-highspeed"
    && match off.served_version {
      ServedK27CodeHighspeed => true
      ServedK28PreviewThinkingOff => false
      ServedK28Preview => false
      ServedK3 => false
    }
    && match on.served_version {
      ServedK27CodeHighspeed => true
      ServedK28PreviewThinkingOff => false
      ServedK28Preview => false
      ServedK3 => false
    }
}

test fn vendor_performance_prose_cannot_construct_a_quality_reading() -> Bool {
  match kimi_vendor_characterization_as_quality_reading(
    characterization: kimi_k28_vendor_characterization_performance_close_to_k3,
  ) {
    KimiQualityReadingRefusedUnestablishedMeasurement { characterization: c } =>
      (c.claim as String) == "Performance close to K3"
    KimiQualityReadingRefusedVendorCharacterization { characterization: _ } => false
  }
    && match kimi_vendor_characterization_as_quality_reading(
      characterization: kimi_k28_vendor_characterization_more_efficient_thinking,
    ) {
      KimiQualityReadingRefusedUnestablishedMeasurement { characterization: c } =>
        (c.claim as String) == "more efficient thinking"
      KimiQualityReadingRefusedVendorCharacterization { characterization: _ } => false
    }
}

test fn unlocated_k2_8_checkpoint_cannot_construct_a_local_model_artifact() -> Bool {
  match kimi_k28_artifact_standing {
    OfficialCheckpointNotLocated { observed_at: at, searched_surfaces: surfaces, trigger: _ } =>
      (at as String) == "2026-09-11" && (surfaces |> count) == 2
    OfficialCheckpointLocated { locator: _, observed_at: _ } => false
  }
    && kimi_k28_local_construction_is_unconstructible(
      attempt: kimi_k28_local_construction(
        standing: kimi_k28_artifact_standing,
        kind: KimiK28LocalModelArtifact,
      ),
    )
    && kimi_k28_local_construction_is_unconstructible(
      attempt: kimi_k28_local_construction(
        standing: kimi_k28_artifact_standing,
        kind: KimiK28VllmCandidate,
      ),
    )
    && kimi_k28_local_construction_is_unconstructible(
      attempt: kimi_k28_local_construction(
        standing: kimi_k28_artifact_standing,
        kind: KimiK28FitCalculation,
      ),
    )
}

test fn executed_version_stays_unobserved_without_a_receipt() -> Bool {
  match kimi_code_executed_version_without_receipt {
    ExecutedVersionUnobserved { reason: _ } => true
    ExecutedVersionObserved { version: _, receipt: _ } => false
  }
}

test fn provider_integration_frontier_names_the_route() -> Bool {
  (kimi_code_k28_preview_provider_integration_frontier |> count) == 1
}
