module test.claim.recorded_observation_envelope_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn a_subject() -> std.observation.ObservationSubject {
  std.observation.ObservationSubject { segments: [
    std.observation.RunSegment { id: "attempt-1" as std.types.NonEmptyStr },
    std.observation.BatchSegment { index: 2, label: "corpus" as std.types.NonEmptyStr },
    std.observation.EntrySegment { source_path: "dag/test/claim/x_test.dag" as std.types.NonEmptyStr },
  ] }
}

fn an_event() -> std.observation.ObservationEvent {
  std.observation.ObservationEvent {
    subject: a_subject(),
    transition: std.observation.Concluded { outcome: std.observation.Done },
    durations: observation_durations_wall(elapsed: nanosecond(count: 1000)),
    rss: std.observation.MeasuredUnavailable { cause: "not sampled" as std.types.NonEmptyStr }
  }
}

fn occ_in(attempt: std.types.NonEmptyStr, id: std.types.NonEmptyStr) -> std.observation.OccurrenceId {
  std.observation.OccurrenceId { attempt: attempt, id: id }
}

fn rec(p: std.observation.ObservationProducer, seq: std.nat.Nat, occ: std.observation.OccurrenceId, origin: std.observation.OccurrenceOrigin) -> std.observation.RecordedObservation {
  std.observation.RecordedObservation {
    producer: p,
    producer_sequence: seq,
    occurrence: occ,
    origin: origin,
    at: std.measure.ObservationInstant {
      domain: std.measure.ProcessMonotonic { process: observation_producer_key(p: p) as std.types.NonEmptyStr },
      basis: CpuClock,
      since_origin: nanosecond(count: seq * 1000)
    },
    event: an_event()
  }
}

fn w(seq: std.nat.Nat) -> std.observation.RecordedObservation {
  rec(p: std.observation.OrdinaryWorkerProducer { worker_index: 3 }, seq: seq, occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ" as std.types.NonEmptyStr), origin: RootOccurrence)
}

// One file per producer, sequences dense and increasing — the append protocol's promise.
test fn w_a_dense_increasing_file_is_intact() -> Bool {
  match classify_producer_file(records: [w(seq: 0), w(seq: 1), w(seq: 2), w(seq: 3)]) {
    SequenceIntact => true
    _ => false
  }
}

// A GAP AND A REORDER ARE DIFFERENT REMEDIES. A gap means records this read never saw, so every
// attribution derived from the file understates; a reorder means the producer violated its own
// append protocol. Reporting either as the other sends the investigation to the wrong layer.
//
// ON THE REORDER FIXTURE: [0, 5, 2] would report a GAP, because 0 to 5 is the first defect and the
// first defect wins. A discriminating reorder fixture must therefore be clean up to the step it
// means to exercise — which is itself the property under test, and is why this one starts at 3.
test fn w_RED_a_gap_and_a_reorder_are_distinct_verdicts_carrying_their_operands() -> Bool {
  let gap = classify_producer_file(records: [w(seq: 0), w(seq: 1), w(seq: 7)])
  let reorder = classify_producer_file(records: [w(seq: 3), w(seq: 4), w(seq: 2)])
  match gap {
    SequenceGap { after: a, before: b } => a == 1 && b == 7
    _ => false
  } && match reorder {
    SequenceReordered { at_index: _, previous: p, observed: o } => p == 4 && o == 2
    _ => false
  }
}

// A defect cannot be greened by the records that follow it: the reduction is incomplete no matter
// how clean the tail reads. The absorbing shape would be a last-wins fold answering Intact here.
test fn w_RED_a_clean_tail_does_not_green_an_earlier_gap() -> Bool {
  match classify_producer_file(records: [w(seq: 0), w(seq: 9), w(seq: 10), w(seq: 11), w(seq: 12)]) {
    SequenceGap { after: _, before: _ } => true
    _ => false
  }
}

// Sequences are PER PRODUCER, so two producers in one file is a layout break upstream of any
// ordering question — not a gap, not a reorder.
test fn w_RED_records_from_two_producers_in_one_file_is_its_own_verdict() -> Bool {
  let mixed = [
    rec(p: CoordinatorProducer, seq: 0, occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "a" as std.types.NonEmptyStr), origin: RootOccurrence),
    rec(p: std.observation.ScopedWorkerProducer { scope_id: "7" as std.types.NonEmptyStr }, seq: 1, occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "b" as std.types.NonEmptyStr), origin: RootOccurrence),
  ]
  match classify_producer_file(records: mixed) {
    SequenceForeignProducer { expected: e, observed: o } => e == "coordinator" && o == "scoped-7"
    _ => false
  }
}

// An empty file is not an intact one. Nothing was appended, so the producer may never have started;
// answering Intact would let a reduction over zero records report a clean run.
test fn w_RED_an_empty_file_is_not_an_intact_file() -> Bool {
  match classify_producer_file(records: []) {
    SequenceEmpty => true
    _ => false
  }
}

// A single record has no step to check, and that is not the same fact as a verified file.
test fn w_a_single_record_reads_intact_because_there_is_no_step_to_violate() -> Bool {
  match classify_producer_file(records: [w(seq: 0)]) {
    SequenceIntact => true
    _ => false
  }
}

// CONTAINMENT AND CAUSATION ARE DIFFERENT RELATIONS. The subject path says a witness ran under a
// batch; ChildOf says another occurrence spawned it. Collapsing them loses the spawner, which is
// exactly the edge a torn tail's active stack is walked along.
test fn w_the_causal_parent_is_carried_beside_the_containment_path_not_derived_from_it() -> Bool {
  let child = rec(
    p: CoordinatorProducer, seq: 4,
    occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-child" as std.types.NonEmptyStr),
    origin: std.observation.ChildOf { parent_id: "occ-parent" as std.types.NonEmptyStr }
  )
  let same_path = length(child.event.subject.segments) == 3
  same_path && match child.origin {
    ChildOf { parent_id: p } => p == "occ-parent"
    RootOccurrence => false
  }
}

test fn w_producer_identity_distinguishes_workers_by_index() -> Bool {
  !observation_producer_eq(
    a: std.observation.OrdinaryWorkerProducer { worker_index: 3 },
    b: std.observation.OrdinaryWorkerProducer { worker_index: 4 }
  ) && observation_producer_key(p: std.observation.ScopedWorkerProducer { scope_id: "7" as std.types.NonEmptyStr }) == "scoped-7"
}

// THE JOIN THE FALSIFIER ACTUALLY MAKES. It compares a prediction receipt against a full-execution
// receipt, which are different attempts by construction, so occurrence ids on the two sides are
// independently minted attempt-local coordinates. Equality between them is a coincidence — and under
// the bare-string form it TYPECHECKED and answered. Now it refuses, naming both attempts.
test fn w_RED_comparing_occurrences_across_two_attempts_refuses_instead_of_answering() -> Bool {
  match compare_occurrences(
    a: occ_in(attempt: "attempt-predict" as std.types.NonEmptyStr, id: "occ-9" as std.types.NonEmptyStr),
    b: occ_in(attempt: "attempt-execute" as std.types.NonEmptyStr, id: "occ-9" as std.types.NonEmptyStr)
  ) {
    OccurrenceCrossAttempt { left: l, right: r } => l == "attempt-predict" && r == "attempt-execute"
    _ => false
  }
}

// Cross-attempt is not "different" — a caller reading it as inequality has been told the answer is
// no when the truth is that the question was wrong.
test fn w_RED_cross_attempt_is_its_own_verdict_not_a_difference() -> Bool {
  let cross = compare_occurrences(
    a: occ_in(attempt: "attempt-predict" as std.types.NonEmptyStr, id: "occ-9" as std.types.NonEmptyStr),
    b: occ_in(attempt: "attempt-execute" as std.types.NonEmptyStr, id: "occ-4" as std.types.NonEmptyStr)
  )
  match cross { DifferentOccurrence => false, SameOccurrence => false, OccurrenceCrossAttempt { left: _, right: _ } => true }
}

test fn w_within_one_attempt_occurrences_compare_normally() -> Bool {
  let a = occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-9" as std.types.NonEmptyStr)
  let b = occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-4" as std.types.NonEmptyStr)
  match compare_occurrences(a: a, b: a) { SameOccurrence => true, _ => false }
    && match compare_occurrences(a: a, b: b) { DifferentOccurrence => true, _ => false }
}

// The attempt has ONE home. A record's attempt is read through its occurrence rather than from a
// second field that could disagree with it.
test fn w_a_records_attempt_is_read_through_its_occurrence() -> Bool {
  recorded_attempt(r: w(seq: 0)) == "attempt-1"
}

// A spawn edge cannot cross attempts, so the parent carries only its id and the attempt comes from
// the child. There is no way to author a parent in another attempt.
test fn w_a_reconstructed_parent_inherits_the_childs_attempt() -> Bool {
  let child = rec(
    p: CoordinatorProducer, seq: 4,
    occ: occ_in(attempt: "attempt-7" as std.types.NonEmptyStr, id: "occ-child" as std.types.NonEmptyStr),
    origin: std.observation.ChildOf { parent_id: "occ-parent" as std.types.NonEmptyStr }
  )
  match parent_occurrence(r: child) {
    Present { value: p } => p.attempt == "attempt-7" && p.id == "occ-parent"
    Absent => false
  }
}

test fn w_RED_a_root_occurrence_has_no_parent_rather_than_a_placeholder_one() -> Bool {
  match parent_occurrence(r: w(seq: 0)) { Absent => true, Present { value: _ } => false }
}

// A worker occurrence is ChildOf an occurrence the COORDINATOR recorded, so the edge crosses files.
// Read the union and it resolves; read the worker's file alone and the SAME edge is out of scope,
// not damaged. If those two ever agree, a single-file read reports a healthy attempt as broken or a
// lost parent silently re-roots the stack to a shallower, plausible, wrong answer.
test fn w_RED_the_same_spawn_edge_resolves_over_the_union_and_is_out_of_scope_in_one_file() -> Bool {
  let coordinator_record = rec(
    p: CoordinatorProducer, seq: 0,
    occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-coord" as std.types.NonEmptyStr),
    origin: RootOccurrence
  )
  let worker_record = rec(
    p: std.observation.OrdinaryWorkerProducer { worker_index: 3 }, seq: 0,
    occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-worker" as std.types.NonEmptyStr),
    origin: std.observation.ChildOf { parent_id: "occ-coord" as std.types.NonEmptyStr }
  )
  let over_union = resolve_parent(
    child: worker_record,
    records: [coordinator_record, worker_record],
    scope: AttemptUnionRead
  )
  let one_file = resolve_parent(
    child: worker_record,
    records: [worker_record],
    scope: std.observation.SingleProducerRead { producer: std.observation.OrdinaryWorkerProducer { worker_index: 3 } }
  )
  match over_union {
    ParentResolved { parent: p } => p.id == "occ-coord" && p.attempt == "attempt-1"
    _ => false
  } && match one_file {
    ParentOutsideReadScope { scope: _, parent_id: id } => id == "occ-coord"
    _ => false
  }
}

// A parent in NO file of the attempt is a real integrity failure, and only a union read may say so.
test fn w_RED_a_parent_absent_from_the_whole_union_is_an_integrity_failure() -> Bool {
  let orphan = rec(
    p: std.observation.OrdinaryWorkerProducer { worker_index: 3 }, seq: 0,
    occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: "occ-worker" as std.types.NonEmptyStr),
    origin: std.observation.ChildOf { parent_id: "occ-never-written" as std.types.NonEmptyStr }
  )
  match resolve_parent(child: orphan, records: [orphan], scope: AttemptUnionRead) {
    ParentMissingFromAttempt { parent_id: id } => id == "occ-never-written"
    _ => false
  }
}

test fn w_a_root_occurrence_resolves_as_root_under_either_scope() -> Bool {
  let r = w(seq: 0)
  match resolve_parent(child: r, records: [], scope: AttemptUnionRead) { OccurrenceIsRoot => true, _ => false }
    && match resolve_parent(child: r, records: [], scope: std.observation.SingleProducerRead { producer: CoordinatorProducer }) {
      OccurrenceIsRoot => true
      _ => false
    }
}

fn began(p: std.observation.ObservationProducer, seq: std.nat.Nat, id: std.types.NonEmptyStr, origin: std.observation.OccurrenceOrigin) -> std.observation.RecordedObservation {
  let base = rec(p: p, seq: seq, occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: id), origin: origin)
  std.observation.RecordedObservation {
    producer: base.producer,
    producer_sequence: base.producer_sequence,
    occurrence: base.occurrence,
    origin: base.origin,
    at: base.at,
    event: std.observation.ObservationEvent {
      subject: a_subject(),
      transition: Begin,
      durations: base.event.durations,
      rss: base.event.rss
    }
  }
}

fn concluded(p: std.observation.ObservationProducer, seq: std.nat.Nat, id: std.types.NonEmptyStr) -> std.observation.RecordedObservation {
  rec(p: p, seq: seq, occ: occ_in(attempt: "attempt-1" as std.types.NonEmptyStr, id: id), origin: RootOccurrence)
}

fn active_ids(a: std.observation.ActiveOccurrences) -> List<String> {
  map(a.occurrences, o => o.id as String)
}

// THE SIGKILL SHAPE. The coordinator, a worker, and a gate are all unfinished at once because
// occurrences nest; a sibling witness finished in between and wrote the LAST record in the file.
// Answering "what was it doing" with the last record names that finished sibling — something already
// over — while the true answer is the set of three.
test fn w_RED_a_killed_attempt_names_every_unfinished_occurrence_not_the_last_record() -> Bool {
  let coord = std.observation.OrdinaryWorkerProducer { worker_index: 0 }
  let recs = [
    began(p: CoordinatorProducer, seq: 0, id: "occ-coord" as std.types.NonEmptyStr, origin: RootOccurrence),
    began(p: coord, seq: 0, id: "occ-worker" as std.types.NonEmptyStr, origin: std.observation.ChildOf { parent_id: "occ-coord" as std.types.NonEmptyStr }),
    began(p: coord, seq: 1, id: "occ-gate" as std.types.NonEmptyStr, origin: std.observation.ChildOf { parent_id: "occ-worker" as std.types.NonEmptyStr }),
    began(p: coord, seq: 2, id: "occ-sibling" as std.types.NonEmptyStr, origin: std.observation.ChildOf { parent_id: "occ-worker" as std.types.NonEmptyStr }),
    concluded(p: coord, seq: 3, id: "occ-sibling" as std.types.NonEmptyStr),
  ]
  let a = active_occurrences(records: recs, scope: AttemptUnionRead)
  let ids = active_ids(a: a)
  length(ids) == 3
    && contains(ids, "occ-coord")
    && contains(ids, "occ-worker")
    && contains(ids, "occ-gate")
    && !contains(ids, "occ-sibling")
}

// The active set crosses producer files, and the chain that explains it does too: occ-gate's parent
// is in the worker's file, whose parent is in the COORDINATOR's. A specimen planting everything in
// one file never executes the case every real floor run is made of.
test fn w_RED_the_active_stack_crosses_a_producer_boundary() -> Bool {
  let coord = std.observation.OrdinaryWorkerProducer { worker_index: 0 }
  let gate = began(p: coord, seq: 1, id: "occ-gate" as std.types.NonEmptyStr, origin: std.observation.ChildOf { parent_id: "occ-worker" as std.types.NonEmptyStr })
  let worker = began(p: coord, seq: 0, id: "occ-worker" as std.types.NonEmptyStr, origin: std.observation.ChildOf { parent_id: "occ-coord" as std.types.NonEmptyStr })
  let coordinator = began(p: CoordinatorProducer, seq: 0, id: "occ-coord" as std.types.NonEmptyStr, origin: RootOccurrence)
  let union = [coordinator, worker, gate]
  let worker_file = [worker, gate]
  let up_one = match resolve_parent(child: worker, records: union, scope: AttemptUnionRead) {
    ParentResolved { parent: p } => p.id == "occ-coord"
    _ => false
  }
  let same_edge_in_one_file = match resolve_parent(
    child: worker, records: worker_file, scope: std.observation.SingleProducerRead { producer: coord }
  ) {
    ParentOutsideReadScope { scope: _, parent_id: _ } => true
    _ => false
  }
  let root_terminates = match resolve_parent(child: coordinator, records: union, scope: AttemptUnionRead) {
    OccurrenceIsRoot => true
    _ => false
  }
  up_one && same_edge_in_one_file && root_terminates
}

// The active set is only as complete as the read, so the scope travels WITH it rather than being
// remembered by the caller.
test fn w_the_active_set_carries_the_scope_it_was_derived_under() -> Bool {
  let a = active_occurrences(records: [], scope: std.observation.SingleProducerRead { producer: CoordinatorProducer })
  length(a.occurrences) == 0 && match a.scope {
    SingleProducerRead { producer: p } => observation_producer_key(p: p) == "coordinator"
    AttemptUnionRead => false
  }
}
