module test.claim.recorded_observation_envelope_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { NonEmptyStr, String, Bool, List }
import std.nat { Nat }
import std.measure {
  nanosecond,
  CpuClock,
  ClockDomain,
  ProcessMonotonic,
  ObservationInstant,
}
import std.observation {
  ObservationSubject,
  RunSegment,
  BatchSegment,
  EntrySegment,
  ObservationEvent,
  ObservationTransition,
  Concluded,
  Done,
  MeasuredUnavailable,
  observation_durations_wall,
  ObservationProducer,
  CoordinatorProducer,
  OrdinaryWorkerProducer,
  ScopedWorkerProducer,
  observation_producer_key,
  observation_producer_eq,
  OccurrenceOrigin,
  RootOccurrence,
  ChildOf,
  RecordedObservation,
  OccurrenceId,
  OccurrenceComparison,
  SameOccurrence,
  DifferentOccurrence,
  OccurrenceCrossAttempt,
  compare_occurrences,
  recorded_attempt,
  parent_occurrence,
  SequenceVerdict,
  SequenceIntact,
  SequenceGap,
  SequenceReordered,
  SequenceForeignProducer,
  SequenceEmpty,
  classify_producer_file,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn a_subject() -> ObservationSubject {
  ObservationSubject { segments: [
    RunSegment { id: "attempt-1" as NonEmptyStr },
    BatchSegment { index: 2, label: "corpus" as NonEmptyStr },
    EntrySegment { source_path: "dag/test/claim/x_test.dag" as NonEmptyStr },
  ] }
}

fn an_event() -> ObservationEvent {
  ObservationEvent {
    subject: a_subject(),
    transition: Concluded { outcome: Done },
    durations: observation_durations_wall(elapsed: nanosecond(count: 1000)),
    rss: MeasuredUnavailable { cause: "not sampled" as NonEmptyStr }
  }
}

fn occ_in(attempt: NonEmptyStr, id: NonEmptyStr) -> OccurrenceId {
  OccurrenceId { attempt: attempt, id: id }
}

fn rec(p: ObservationProducer, seq: Nat, occ: OccurrenceId, origin: OccurrenceOrigin) -> RecordedObservation {
  RecordedObservation {
    producer: p,
    producer_sequence: seq,
    occurrence: occ,
    origin: origin,
    at: ObservationInstant {
      domain: ProcessMonotonic { process: observation_producer_key(p: p) as NonEmptyStr },
      basis: CpuClock,
      since_origin: nanosecond(count: seq * 1000)
    },
    event: an_event()
  }
}

fn w(seq: Nat) -> RecordedObservation {
  rec(p: OrdinaryWorkerProducer { worker_index: 3 }, seq: seq, occ: occ_in(attempt: "attempt-1" as NonEmptyStr, id: "occ" as NonEmptyStr), origin: RootOccurrence)
}

// One file per producer, sequences dense and increasing — the append protocol's promise.
test fn w_a_dense_increasing_file_is_intact() -> Bool {
  match classify_producer_file(records: [w(seq: 0), w(seq: 1), w(seq: 2), w(seq: 3)]) {
    SequenceIntact => true
    _ => false
  }
}

// A GAP AND A REORDER ARE DIFFERENT REMEDIES. A gap means records this read never saw, so every
// attribution derived from the file understates; a reorder means the producer violated its own
// append protocol. Reporting either as the other sends the investigation to the wrong layer.
test fn w_RED_a_gap_and_a_reorder_are_distinct_verdicts_carrying_their_operands() -> Bool {
  let gap = classify_producer_file(records: [w(seq: 0), w(seq: 1), w(seq: 7)])
  // NOTE the fixture: [0, 5, 2] would report a GAP, because 0 to 5 is the first defect and the
  // first defect wins. A discriminating reorder fixture must therefore be clean up to the step it
  // means to exercise, which is itself the property under test.
  let reorder = classify_producer_file(records: [w(seq: 3), w(seq: 4), w(seq: 2)])
  match gap {
    SequenceGap { after: a, before: b } => a == 1 && b == 7
    _ => false
  } && match reorder {
    SequenceReordered { at_index: _, previous: p, observed: o } => p == 4 && o == 2
    _ => false
  }
}

// A defect cannot be greened by the records that follow it: the reduction is incomplete no matter
// how clean the tail reads. The absorbing shape would be a last-wins fold answering Intact here.
test fn w_RED_a_clean_tail_does_not_green_an_earlier_gap() -> Bool {
  match classify_producer_file(records: [w(seq: 0), w(seq: 9), w(seq: 10), w(seq: 11), w(seq: 12)]) {
    SequenceGap { after: _, before: _ } => true
    _ => false
  }
}

// Sequences are PER PRODUCER, so two producers in one file is a layout break upstream of any
// ordering question — not a gap, not a reorder.
test fn w_RED_records_from_two_producers_in_one_file_is_its_own_verdict() -> Bool {
  let mixed = [
    rec(p: CoordinatorProducer, seq: 0, occ: occ_in(attempt: "attempt-1" as NonEmptyStr, id: "a" as NonEmptyStr), origin: RootOccurrence),
    rec(p: ScopedWorkerProducer { scope_id: "7" as NonEmptyStr }, seq: 1, occ: occ_in(attempt: "attempt-1" as NonEmptyStr, id: "b" as NonEmptyStr), origin: RootOccurrence),
  ]
  match classify_producer_file(records: mixed) {
    SequenceForeignProducer { expected: e, observed: o } => e == "coordinator" && o == "scoped-7"
    _ => false
  }
}

// An empty file is not an intact one. Nothing was appended, so the producer may never have started;
// answering Intact would let a reduction over zero records report a clean run.
test fn w_RED_an_empty_file_is_not_an_intact_file() -> Bool {
  match classify_producer_file(records: []) {
    SequenceEmpty => true
    _ => false
  }
}

// A single record has no step to check, and that is not the same fact as a verified file.
test fn w_a_single_record_reads_intact_because_there_is_no_step_to_violate() -> Bool {
  match classify_producer_file(records: [w(seq: 0)]) {
    SequenceIntact => true
    _ => false
  }
}

// CONTAINMENT AND CAUSATION ARE DIFFERENT RELATIONS. The subject path says a witness ran under a
// batch; ChildOf says another occurrence spawned it. Collapsing them loses the spawner, which is
// exactly the edge a torn tail's active stack is walked along.
test fn w_the_causal_parent_is_carried_beside_the_containment_path_not_derived_from_it() -> Bool {
  let child = rec(
    p: CoordinatorProducer, seq: 4,
    occ: occ_in(attempt: "attempt-1" as NonEmptyStr, id: "occ-child" as NonEmptyStr),
    origin: ChildOf { parent_id: "occ-parent" as NonEmptyStr }
  )
  let same_path = length(child.event.subject.segments) == 3
  same_path && match child.origin {
    ChildOf { parent_id: p } => p == "occ-parent"
    RootOccurrence => false
  }
}

test fn w_producer_identity_distinguishes_workers_by_index() -> Bool {
  !observation_producer_eq(
    a: OrdinaryWorkerProducer { worker_index: 3 },
    b: OrdinaryWorkerProducer { worker_index: 4 }
  ) && observation_producer_key(p: ScopedWorkerProducer { scope_id: "7" as NonEmptyStr }) == "scoped-7"
}

// THE JOIN THE FALSIFIER ACTUALLY MAKES. It compares a prediction receipt against a full-execution
// receipt, which are different attempts by construction, so occurrence ids on the two sides are
// independently minted attempt-local coordinates. Equality between them is a coincidence — and under
// the bare-string form it TYPECHECKED and answered. Now it refuses, naming both attempts.
test fn w_RED_comparing_occurrences_across_two_attempts_refuses_instead_of_answering() -> Bool {
  match compare_occurrences(
    a: occ_in(attempt: "attempt-predict" as NonEmptyStr, id: "occ-9" as NonEmptyStr),
    b: occ_in(attempt: "attempt-execute" as NonEmptyStr, id: "occ-9" as NonEmptyStr)
  ) {
    OccurrenceCrossAttempt { left: l, right: r } => l == "attempt-predict" && r == "attempt-execute"
    _ => false
  }
}

// Cross-attempt is not "different" — a caller reading it as inequality has been told the answer is
// no when the truth is that the question was wrong.
test fn w_RED_cross_attempt_is_its_own_verdict_not_a_difference() -> Bool {
  let cross = compare_occurrences(
    a: occ_in(attempt: "attempt-predict" as NonEmptyStr, id: "occ-9" as NonEmptyStr),
    b: occ_in(attempt: "attempt-execute" as NonEmptyStr, id: "occ-4" as NonEmptyStr)
  )
  match cross { DifferentOccurrence => false, SameOccurrence => false, OccurrenceCrossAttempt { left: _, right: _ } => true }
}

test fn w_within_one_attempt_occurrences_compare_normally() -> Bool {
  let a = occ_in(attempt: "attempt-1" as NonEmptyStr, id: "occ-9" as NonEmptyStr)
  let b = occ_in(attempt: "attempt-1" as NonEmptyStr, id: "occ-4" as NonEmptyStr)
  match compare_occurrences(a: a, b: a) { SameOccurrence => true, _ => false }
    && match compare_occurrences(a: a, b: b) { DifferentOccurrence => true, _ => false }
}

// The attempt has ONE home. A record's attempt is read through its occurrence rather than from a
// second field that could disagree with it.
test fn w_a_records_attempt_is_read_through_its_occurrence() -> Bool {
  recorded_attempt(r: w(seq: 0)) == "attempt-1"
}

// A spawn edge cannot cross attempts, so the parent carries only its id and the attempt comes from
// the child. There is no way to author a parent in another attempt.
test fn w_a_reconstructed_parent_inherits_the_childs_attempt() -> Bool {
  let child = rec(
    p: CoordinatorProducer, seq: 4,
    occ: occ_in(attempt: "attempt-7" as NonEmptyStr, id: "occ-child" as NonEmptyStr),
    origin: ChildOf { parent_id: "occ-parent" as NonEmptyStr }
  )
  match parent_occurrence(r: child) {
    Present { value: p } => p.attempt == "attempt-7" && p.id == "occ-parent"
    Absent => false
  }
}

test fn w_RED_a_root_occurrence_has_no_parent_rather_than_a_placeholder_one() -> Bool {
  match parent_occurrence(r: w(seq: 0)) { Absent => true, Present { value: _ } => false }
}
