    })
}

// CHAIN-END COUNTING: the collapsed top row's k of n is the chain END's display children — the
// shell chain's shape, where the residue-zero row counts the arc's tasks (here one done task and
// one open task of two), not the intermediates.
test fn witness_chain_end_tasks_count_in_top_row() -> Bool {
  let nodes = [
    fx_sized(id: "hier-cc-r", content: "residue analogue"),
