  ]
  let rows = map(nodes, rn => fx_hier_view(rn: rn, nodes: nodes, edges: edges, merged: [], activity: NoActiveWork, standing: none))
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: [], members: [])
  let ids = fx_ws_rendered_ids(ws: ws)
  (match row_display_parent_id(rows: rows, edges: edges, members: [], node_id: "hier-shared") {
    Present { value: p } => p == "hier-p2"
    Absent => false
  })
    && count(ids |> filter(i => i == "hier-shared")) == 1
    && (match ws.upcoming |> filter(e => match e {
        BandProject { project } => project.row.node_id == "hier-p1"
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }) |> first {
      Present { value: e } => match e {
        BandProject { project } =>
          project.total_count == 1 && count(project.entries) == 0 && count(project.chain) == 0
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
    && (match ws.upcoming |> filter(e => match e {
        BandProject { project } => project.row.node_id == "hier-p2"
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }) |> first {
      Present { value: e } => match e {
        BandProject { project } =>
          project.total_count == 1
            && count(project.chain) == 0
            && map(project.entries, ent => fx_entry_id(entry: ent)) == ["hier-shared"]
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
}

// THE EXPANSION RULE IS A PURE FUNCTION OF SUBTREE STATE: a project opens when a descendant has a
// live attempt (whether that descendant renders nested or surfaced to the Active band) or a
// non-routine event-log standing (the motion states — here in_progress), and stays collapsed when
// every subtask is quiet. NodeOpen is the routine default and never opens anything.
test fn witness_project_auto_open_follows_subtree_pulse() -> Bool {
  let edges = fx_hier_edges()
  let live = fx_hier_rows(activity_for_open: fx_specimen_activity(), standing_for_open: none)
  let standing = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: Present { value: NodeInProgress { by: "op" as NonEmptyStr, last_note: "working" as NonEmptyStr } })
  let open_standing = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: Present { value: NodeOpen })
  let quiet = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: none)
  fx_project_tree(rows: live, edges: edges, node_id: "hier-project").auto_open
    && fx_project_tree(rows: standing, edges: edges, node_id: "hier-project").auto_open
    && !fx_project_tree(rows: open_standing, edges: edges, node_id: "hier-project").auto_open
    && !fx_project_tree(rows: quiet, edges: edges, node_id: "hier-project").auto_open
    && row_pulses(row: fx_row_of(rows: live, node_id: "hier-task-open"))
    && !row_pulses(row: fx_row_of(rows: quiet, node_id: "hier-task-open"))
}

// SINGLE-CHILD CHAIN COLLAPSE (operator ruling 2026-09-21): a project whose ONLY display child is
// itself a project collapses — the shell-residue-zero → shell-gate-migration →
// shell-effectplan-to-bash → shell-typed-invocation chain shape — rendering as ONE project row
// carrying the topmost identity, the swallowed intermediates as its chain, and the chain end's
// tasks as its entries. The whole chain renders exactly once (chain members are accounted in
// project_tree_row_ids), and the depth the entries sit at is one below the top row.
test fn witness_single_child_chain_collapses() -> Bool {
  let nodes = [
    fx_sized(id: "hier-chain-a", content: "chain top"),
    fx_sized(id: "hier-chain-b", content: "chain mid"),
    fx_sized(id: "hier-chain-c", content: "chain base"),
  ]
  let edges = [
    gunbc.roadmap_authority.edge(child: "hier-chain-a", parent: "hier-chain-b"),
    gunbc.roadmap_authority.edge(child: "hier-chain-b", parent: "hier-chain-c"),
  ]
  let rows = map(nodes, rn => fx_hier_view(rn: rn, nodes: nodes, edges: edges, merged: [], activity: NoActiveWork, standing: none))
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: [], members: [])
  let ids = fx_ws_rendered_ids(ws: ws)
  count(ids) == 3
    && all(rows, r => count(ids |> filter(i => i == r.node_id)) == 1)
    && count(ws.upcoming) == 1
    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandProject { project } =>
          project.row.node_id == "hier-chain-a"
            && project.depth == 1
            && map(project.chain, r => r.node_id) == ["hier-chain-b"]
            && map(project.entries, x => fx_entry_id(entry: x)) == ["hier-chain-c"]
            && project.total_count == 1
            && (match project.entries.first() {
              Present { value: ent } => match ent {
                ProjectLeaf { row } => row.node_id == "hier-chain-c"
                ProjectNested { project: _ } => false
              }
              Absent => false
            })
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
    && band_entry_row_count(entries: ws.ready) == 0
}

// MULTI-CHILD PROJECTS NEVER COLLAPSE: with two display children the recursion keeps its nested
