  let ids = fx_ws_rendered_ids(ws: ws)
  count(ids) == 2
    && all(rows, r => count(ids |> filter(i => i == r.node_id)) == 1)
    && count(ws.active) == 1
    && (match ws.active.first() {
      Present { value: e } => match e {
        BandRow { row } => row.node_id == "hier-solo-active"
        BandFamily { family: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
    && (match ws.ready.first() {
      Present { value: e } => match e {
        BandRow { row } => row.node_id == "hier-solo-idle"
        BandFamily { family: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
}

// MULTI-DEPENDENCY: a task that is a prerequisite of several rendered projects nests under the
// FIRST one in edge declaration order and renders nowhere else — while still counting toward each
// project's denominator. roadmap_primary_parent was consulted for this rule and does not fit (it
// selects a node's own first prerequisite, the opposite direction); the rule is first declared
// banded dependent, pinned here.
test fn witness_shared_task_nests_under_first_declared_parent() -> Bool {
  let nodes = [
    fx_sized(id: "hier-p1", content: "project one"),
    fx_sized(id: "hier-p2", content: "project two"),
    fx_sized(id: "hier-shared", content: "shared task"),
