data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Every witness here runs against CONSTRUCTED fixtures, never the live roadmap population — a live
// count or row is a moving target that turns a semantic claim into a snapshot transcription (the A1
// lesson, and the standing fixtures-not-live-counts rule). The specimen fixture is the operator's
// falsifier row (docs/plans/roadmap-presentation-seam-design.md section 1): seven obligations with
// Environment/Workspace/Agent complete, four pending, worker process exited, session container
// present.

fn fx_specimen_segments() -> List<WorkflowSegment> {
  [
    WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "admission receipt readable" },
    WorkflowSegment { kind: WorkspaceWorkflowSegment, state: WorkflowSegmentComplete, detail: "worktree created" },
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentComplete, detail: "turn.completed and process exit 0" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
  ]
}

fn fx_specimen_activity() -> ActivityView {
  activity_view_from_parts(
    segments: fx_specimen_segments(),
    remaining: 4,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "Worked for 6m 34s",
  )
}

// The operator's worked example verbatim: 'session container present' beside 'process exited' must
// not ship as an uninterpreted evidence pair. The routine specimen summary must (a) state the
// consequence sentence, (b) name the NEXT obligation rather than implying a percentage, and (c)
// carry the ledger's remaining count — the raw container/process facts appear only as labeled
// evidence rows. The RED control: a summary that merely relabels the evidence ('process exited') or
// asserts a scalar ('43%') has no arm that could produce it — the discriminating assertions below
// fail if the consequence, the next obligation, or the derived count is dropped.

test fn witness_specimen_summary_states_consequence_and_next_obligation() -> Bool {
  match fx_specimen_activity() {
    ActiveWork { summary, obligations: _, remaining_obligation_count: remaining, current_activity: _, attention, evidence: _ } =>
      summary == "Agent turn completed; the retained session is no longer running · Verification next · 4 remaining"
        && remaining == 4
        && match attention { ActivityRoutine => true ActivityAnomalous => false }
    NoActiveWork => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

test fn witness_specimen_evidence_rows_carry_raw_facts_as_evidence() -> Bool {
  match fx_specimen_activity() {
    ActiveWork { summary: _, obligations, remaining_obligation_count: _, current_activity: _, attention: _, evidence } =>
      count(evidence) == 3
        && fold(evidence, init: false, f: (acc, row) => acc || (row.label == "session container" && row.value == "present"))
        && fold(evidence, init: false, f: (acc, row) => acc || (row.label == "worker process" && row.value == "process exited"))
        && fold(evidence, init: false, f: (acc, row) => acc || (row.label == "throughput" && row.value == "unmeasured"))
        && count(obligations) == 7
    NoActiveWork => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

test fn witness_agent_running_reads_as_working_not_completed() -> Bool {
  let segments = [
    WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: WorkspaceWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentActive, detail: "" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
  ]
  match activity_view_from_parts(
    segments: segments,
    remaining: 5,
    process: WorkerProcessRunning { command: "codex exec" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  ) {
    ActiveWork { summary, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } =>
      summary == "Agent working"
    NoActiveWork => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

// A refusal is a first-class presentation state with its LOCATED reason, never a styling variant of
// progress (DESIGN 5: typed, located). The discriminating fixture puts the refusal mid-ledger; the
// view must surface a LABEL — the state word plus the short reason — as the summary, keep the full
// (here short) reason as the located reason behind the disclosure, and rank a failed segment as
// anomalous ActiveWork — distinct states with distinct remedies, and a refused ledger outranks a
// failed one because the refusal names an evidence gap the failure count cannot explain.
test fn witness_refused_segment_projects_located_reason() -> Bool {
  let segments = [
    WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
  ]
  match activity_view_from_parts(
    segments: segments,
    remaining: 6,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  ) {
    ActiveWorkRefused { summary, located_reason, evidence: _, obligations: _ } =>
      summary == "Agent · refused — turn.completed with process unobserved: no exit was established"
        && located_reason == "turn.completed with process unobserved: no exit was established"
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    NoActiveWork => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

test fn witness_failed_segment_is_anomalous_active_work() -> Bool {
  let segments = [
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentFailed, detail: "exit 1 before terminal event" },
  ]
  match activity_view_from_parts(
    segments: segments,
    remaining: 6,
    process: WorkerProcessExited { exit_code: 1, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  ) {
    ActiveWork { summary, obligations: _, remaining_obligation_count: _, current_activity: _, attention, evidence: _ } =>
      summary == "Agent failed"
        && match attention { ActivityAnomalous => true ActivityRoutine => false }
    NoActiveWork => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

// The ticket headline is ONE typed field read end-to-end. The discriminating input is a headline
// that CONTAINS the legacy separators (an em-dash clause and a sentence break): under the deleted
// recompose-and-reparse round trip ('**headline** — brief' then split at punctuation) it would come
// back truncated at its own dash. The legacy residue is asserted separately on an AuthoredLine,
// where the lead heuristic is the declared residue of this projection.
test fn witness_ticket_headline_survives_own_punctuation() -> Bool {
  let t = gunbc.roadmap_authority.fields(
    headline: "Close the wall — phase 2. Cleanly",
    boundary: "brief text",
    displaced_cost: "",
    first_slice: "",
    red_control: "",
    out_of_scope: "",
    handback: "")
  let rn = gunbc.roadmap_authority.ticket_row(identity: "rnfx_A2PRES0000000000000001", id: "a2-headline", done: false, t: t)
  row_headline(line: rn.line) == "Close the wall — phase 2. Cleanly"
}

test fn witness_legacy_line_keeps_lead_residue() -> Bool {
  legacy_lead(full: "lead claim — trailing brief") == "lead claim"
    && legacy_lead(full: "First sentence. Second sentence") == "First sentence"
    && legacy_lead(full: "no separator at all") == "no separator at all"
}

test fn witness_summary_is_absent_until_typed_source_exists() -> Bool {
  let rn = gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000002", id: "a2-sum", done: false, content: "content — with dash")
  match row_summary(line: rn.line) {
    Absent => true
    Present { value: _ } => false
  }
}

// The exact-constructor discrimination (operator constraint 3): 'active' is never a disjunction of
// narrower facts. NoActiveAttempt projects to NoActiveWork with zero furniture; an unreadable
// evidence situation projects to ActivityUnobservable PRESERVING its located reason — distinct from
// both refusal and absence; a fully-complete ledger projects to CompletedWork (the receipt-backed
// outcome), never to a routine ActiveWork whose summary happens to say complete. The RED controls
// are the cross-arm assertions: if unobservable collapsed into absence the reason would be dropped
// and the second witness fails; if terminal collapsed into active the third witness's CompletedWork
// arm never matches.

test fn witness_no_attempt_projects_zero_furniture() -> Bool {
  match activity_view_of(facts: NoActiveAttempt) {
    NoActiveWork => true
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

test fn witness_unobservable_preserves_located_reason() -> Bool {
  match activity_view_of(facts: AttemptUnobservable { reason: "attempt state file unreadable: permission denied" }) {
    ActivityUnobservable { reason } => reason == "attempt state file unreadable: permission denied"
    NoActiveWork => false
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
  }
}

test fn witness_all_complete_ledger_is_terminal_not_active() -> Bool {
  let segments = [
    WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: WorkspaceWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
  ]
  match activity_view_from_parts(
    segments: segments,
    remaining: 0,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  ) {
    CompletedWork { outcome, evidence: _, obligations: _ } => outcome == "All obligations complete"
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    NoActiveWork => false
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

fn fx_admitted(node_id: String) -> LaunchAdmission {
  LaunchAdmitted { identity: launch_fixture_identity(node_id: node_id, cause: Operator, mode: ManualReady) }
}

fn fx_blocked() -> LaunchAdmission {
  LaunchRefused { refusal: LaunchDependenciesBlocked { blockers: ["a2-parent-1"] } }
}

// RLM-1: the dispatch action is the launch admission's projection. An admitted row's dispatch is
// Available AND Primary; a refused row's dispatch is Unavailable and Secondary, carrying the
// refusal's wire label and reason -- there is no override arm left to render a blocked row as
// operable.
test fn witness_admitted_dispatch_is_primary_refused_is_unavailable() -> Bool {
  let ready_view = action_view(lifecycle: OpenLifecycle, admission: fx_admitted(node_id: "a2-row"))
  let blocked_view = action_view(lifecycle: OpenLifecycle, admission: fx_blocked())
  let ready_ok = match ready_view.primary_action {
    Present { value: a } =>
      match a.kind { DispatchAction => true ClearSessionAction => false }
        && match a.availability { ActionAvailable => true ActionUnavailable => false }
        && a.label == "admitted"
    Absent => false
  }
  let blocked_primary_empty = match blocked_view.primary_action {
    Absent => true
    Present { value: _ } => false
  }
  let blocked_unavailable = fold(blocked_view.secondary_actions, init: false, f: (acc, a) =>
    acc || (match a.kind { DispatchAction => true ClearSessionAction => false }
      && match a.availability { ActionUnavailable => true ActionAvailable => false }
      && match a.priority { SecondaryAction => true PrimaryAction => false DiagnosticAction => false }
      && a.label == "dependencies_blocked"
      && string_contains(s: a.detail, pattern: "a2-parent-1")))
  ready_ok && blocked_primary_empty && blocked_unavailable
}

test fn witness_done_and_superseded_rows_offer_no_dispatch() -> Bool {
  count(dispatch_action(lifecycle: DoneLifecycle, admission: fx_admitted(node_id: "a2-row"))) == 0
    && count(dispatch_action(lifecycle: SupersededLifecycle, admission: fx_admitted(node_id: "a2-row"))) == 0
}

// The session action derives from the OBSERVED cleanup admission and nothing else (operator blocker
// 4, 2026-08-01). The prior constructor minted an ActionAvailable ClearSessionAction whenever the
// activity arm looked active/refused/completed — availability inferred from presentation state, the
// fabrication the two-axis note forbids in the other direction. The discriminating trio: an allowed
// observed cleanup is Available and Diagnostic; an observed-but-disallowed cleanup is
// ActionUnavailable (this arm's first real consumer) while KEEPING its label and detail so the
// refusal is legible; no observed cleanup action is NoSessionAction, not an empty-labeled button.
// The RED: the deleted arm — action_view over any activity yields no ClearSessionAction — is
// asserted directly, so reintroducing the fabrication reds.

test fn witness_session_action_derives_from_observed_admission() -> Bool {
  let allowed = session_action_view(cleanup_action: "clear", cleanup_allowed: true, cleanup_detail: "only retained tmux session metadata will be removed")
  let disallowed = session_action_view(cleanup_action: "clear", cleanup_allowed: false, cleanup_detail: "pane still running")
  let absent = session_action_view(cleanup_action: "", cleanup_allowed: false, cleanup_detail: "")
  let allowed_ok = match allowed {
    SessionAction { kind, availability, priority, label, detail: _ } =>
      match kind { ClearSessionAction => true DispatchAction => false }
        && match availability { ActionAvailable => true ActionUnavailable => false }
        && match priority { DiagnosticAction => true PrimaryAction => false SecondaryAction => false }
        && label == "clear"
    NoSessionAction => false
  }
  let disallowed_ok = match disallowed {
    SessionAction { kind: _, availability, priority: _, label, detail } =>
      match availability { ActionUnavailable => true ActionAvailable => false }
        && label == "clear" && detail == "pane still running"
    NoSessionAction => false
  }
  let absent_ok = match absent {
    NoSessionAction => true
    SessionAction { kind: _, availability: _, priority: _, label: _, detail: _ } => false
  }
  allowed_ok && disallowed_ok && absent_ok
}

fn action_view_has_no_clear(v: ActionView) -> Bool {
  (match v.primary_action {
    Present { value: a } => match a.kind { ClearSessionAction => false DispatchAction => true }
    Absent => true
  })
    && !fold(v.secondary_actions, init: false, f: (acc, a) =>
      acc || match a.kind { ClearSessionAction => true DispatchAction => false })
}

test fn witness_action_view_never_fabricates_cleanup() -> Bool {
  action_view_has_no_clear(v: action_view(lifecycle: OpenLifecycle, admission: fx_admitted(node_id: "a2-row")))
    && action_view_has_no_clear(v: action_view(lifecycle: OpenLifecycle, admission: fx_blocked()))
    && action_view_has_no_clear(v: action_view(lifecycle: ReviewLifecycle, admission: fx_blocked()))
}

// The decided session line and title detail (operator blocker 5): the client formerly concatenated
// 'session · present — ' + process_state and its own provider-facts title in TypeScript — a second
// prose authority. Both strings are now decided here and the witness pins them, including the
// empty-process-detail arm (no dangling separator).

test fn witness_session_facts_line_and_detail_are_decided() -> Bool {
  let v = session_facts_view(
    process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    process_detail: "exit=0 last-command=codex",
    provider: "codex",
    configured_provider: "codex",
    provider_readiness: "ready",
    session_name: "gunbc-belt-a2-row",
    cleanup_action: "clear",
    cleanup_allowed: true,
    cleanup_detail: "only retained tmux session metadata will be removed")
  let bare = session_facts_view(
    process: WorkerProcessRunning { command: "codex exec" },
    process_detail: "",
    provider: "codex",
    configured_provider: "codex",
    provider_readiness: "ready",
    session_name: "gunbc-belt-a2-row",
    cleanup_action: "",
    cleanup_allowed: false,
    cleanup_detail: "")
  v.line == "session · present — process exited"
    && v.detail == "provider codex (configured codex, readiness ready) — gunbc-belt-a2-row · exit=0 last-command=codex"
    && bare.line == "session · present — process running"
    && bare.detail == "provider codex (configured codex, readiness ready) — gunbc-belt-a2-row"
}

// Lifecycle discriminates on the node's own facts, distinct from frontier scheduling: an Unsigned
// node with unmerged evidence is open; merged evidence without signoff is review — implementation
// artifacts never accept (roadmap_acceptance_boundary_note); an accepting signoff is done; a
// superseded line outranks everything and carries its forwarding pointer.

test fn witness_lifecycle_axes_discriminate() -> Bool {
  let open_node = gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000003", id: "a2-open", done: false, content: "open work")
  let done_line_node = gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000004", id: "a2-review", done: true, content: "review work")
  let signed_node = gunbc.roadmap_authority.sign(rn: open_node, s: gunbc.roadmap_authority.signed(
    by: "operator",
    works: RedControlExecuted { witness_module: "test.claim.roadmap_presentation_witness", witness_fn: "witness_lifecycle_axes_discriminate", executed_on: "2026-08-01" },
    scope_equivalent: HandbackDelivered { first_artifact: "receipt", further_artifacts: [] },
    as_expected: true))
  let superseded_node = gunbc.roadmap_authority.superseded(identity: "rnfx_A2PRES0000000000000005", id: "a2-sup", by: "a2-open", content: "old shape")
  work_lifecycle_key(l: work_lifecycle(rn: open_node, merged: [])) == "open"
    && work_lifecycle_key(l: work_lifecycle(rn: done_line_node, merged: [])) == "review"
    && work_lifecycle_key(l: work_lifecycle(rn: signed_node, merged: [])) == "done"
    && work_lifecycle_key(l: work_lifecycle(rn: superseded_node, merged: [])) == "superseded"
}

// Owner, sizing, and carriers are supporting facts for the disclosure region — present when
// declared, absent (not empty-labeled) when not. The integration witness drives work_row_view
// end-to-end on a fixture node and asserts the composed row: typed headline, honest Absent summary,
// the typed scheduling position with its complete blocker set, and the actions/facts composed from
// the same fixture.

fn fx_row_nodes() -> List<RoadmapNode> {
  [
    gunbc.roadmap_authority.authored_wi(identity: "rnfx_A2PRES0000000000000006", id: "a2-row",
      done: false, content: "row headline — row brief", intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc"),
    gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000007", id: "a2-parent-1", done: false, content: "parent one"),
    gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000008", id: "a2-parent-2", done: false, content: "parent two"),
  ]
}

fn fx_row_edges() -> List<RoadmapEdge> {
  [
    gunbc.roadmap_authority.edge(child: "a2-row", parent: "a2-parent-1"),
    gunbc.roadmap_authority.edge(child: "a2-row", parent: "a2-parent-2"),
  ]
}

fn fx_row_launch(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> LaunchRowContext {
  LaunchRowContext {
    standing: launch_fixture_standing_clear(mode: ManualReady),
    graph: launch_graph_of_document(doc: launch_fixture_doc(nodes: nodes, edges: edges)),
    merged: [],
  }
}

fn fx_row(activity: ActivityView) -> WorkRowView {
  let nodes = fx_row_nodes()
  match nodes.first() {
    Present { value: rn } =>
      work_row_view(rn: rn, nodes: nodes, edges: fx_row_edges(), merged: [], activity: activity,
        rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
        worker_alive: false, standing: none, attempt_stale: false,
        launch: fx_row_launch(nodes: nodes, edges: fx_row_edges()))
    Absent => work_row_view(
      rn: gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000009", id: "a2-unreachable", done: false, content: "unreachable"),
      nodes: [], edges: [], merged: [], activity: activity,
      rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
      worker_alive: false, standing: none, attempt_stale: false,
      launch: fx_row_launch(nodes: [], edges: []))
  }
}

test fn witness_work_row_view_composes_from_fixture() -> Bool {
  let row = fx_row(activity: NoActiveWork)
  row.headline == "row headline"
    && row.node_id == "a2-row"
    && (match row.scheduling {
      SchedulingUpcoming { blockers } =>
        count(blockers) == 2
          && fold(blockers, init: true, f: (acc, b) => acc && (b == "a2-parent-1" || b == "a2-parent-2"))
      SchedulingReady => false
      SchedulingDone => false
      SchedulingSuperseded => false
      SchedulingUnplanned => false
    })
    && work_lifecycle_key(l: row.lifecycle) == "open"
    && row.superseded_by == ""
    && match row.summary { Absent => true Present { value: _ } => false }
    && fold(row.supporting_facts, init: false, f: (acc, fact) => acc || fact.label == "sizing")
    && !fold(row.supporting_facts, init: false, f: (acc, fact) => acc || fact.label == "owner")
    && match row.activity { NoActiveWork => true ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false CompletedWork { outcome: _, evidence: _, obligations: _ } => false ActivityUnobservable { reason: _ } => false }
}

// The scheduling axis discriminates by the SAME predicates spawn_frontier filters (operator blocker
// 2: ready was a caller-assertable Bool; now the position is projected, not asserted). The fixtures
// cover the five arms: a sized dependency-met node is Ready; a sized node under an open parent is
// Upcoming CARRYING that blocker; an unsized node is Unplanned (never conflated with Upcoming — it
// has no blockers to fabricate); a superseded line is Superseded whatever else holds; and the
// dependency line renders only for an Upcoming row with more than one blocker.
test fn witness_scheduling_projects_typed_positions() -> Bool {
  let nodes = fx_row_nodes()
  let edges = fx_row_edges()
  let child = match nodes.first() { Present { value: rn } => rn Absent => gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000010", id: "a2-x", done: false, content: "x") }
  let ready_node = gunbc.roadmap_authority.authored_wi(identity: "rnfx_A2PRES0000000000000011", id: "a2-ready",
    done: false, content: "ready row", intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc")
  let unsized_node = gunbc.roadmap_authority.authored(identity: "rnfx_A2PRES0000000000000012", id: "a2-unsized", done: false, content: "unsized row")
  let superseded_node = gunbc.roadmap_authority.superseded(identity: "rnfx_A2PRES0000000000000013", id: "a2-sup2", by: "a2-ready", content: "old")
  work_scheduling_key(s: work_scheduling(rn: child, nodes: nodes, edges: edges)) == "upcoming"
    && work_scheduling_key(s: work_scheduling(rn: ready_node, nodes: [ready_node], edges: [])) == "ready"
    && work_scheduling_key(s: work_scheduling(rn: unsized_node, nodes: [unsized_node], edges: [])) == "unplanned"
    && work_scheduling_key(s: work_scheduling(rn: superseded_node, nodes: [superseded_node], edges: [])) == "superseded"
}

test fn witness_dependency_line_only_for_multi_blocker_upcoming() -> Bool {
  let two = scheduling_dependency_line(s: SchedulingUpcoming { blockers: ["a2-parent-1", "a2-parent-2"] })
  let one = scheduling_dependency_line(s: SchedulingUpcoming { blockers: ["a2-parent-1"] })
  let ready = scheduling_dependency_line(s: SchedulingReady)
  (match two { Present { value: line } => line == "requires all: a2-parent-1, a2-parent-2" Absent => false })
    && (match one { Absent => true Present { value: _ } => false })
    && (match ready { Absent => true Present { value: _ } => false })
}

// The workspace grouping (operator blocker 6): a row with active or refused work belongs to the
// operator's attention band above every idle Ready row; CompletedWork stays in its scheduling
// bucket because a finished receipt is not work in flight; unobservable rows do not join the active
// band — unknowable never rounds to active any more than to absent.

fn band_entry_row_count(entries: List<WorkBandEntry>) -> Int {
  fold(entries, init: 0, f: (acc, e) => match e {
    BandRow { row: _ } => acc + 1
    BandFamily { family } => acc + count(family.rows)
    BandProject { project } => acc + count(project_tree_row_ids(view: project))
  })
}

fn band_entry_has_active(entries: List<WorkBandEntry>) -> Bool {
  fold(entries, init: false, f: (acc, e) => acc || (match e {
    BandRow { row } => row_is_active_work(row: row)
    BandFamily { family } => fold(family.rows, init: false, f: (a, r) => a || row_is_active_work(row: r))
    BandProject { project: _ } => false
  }))
}

test fn witness_daily_workspace_surfaces_active_above_ready() -> Bool {
  let active_row = fx_row(activity: fx_specimen_activity())
  let idle_row = fx_row(activity: NoActiveWork)
  let ws = daily_workspace_view(rows: [idle_row, active_row], edges: [], program: none, observation: ObservationsNominal, families: [], members: [])
  count(ws.active) == 1
    && band_entry_has_active(entries: ws.active)
    && band_entry_row_count(entries: ws.upcoming) == 1
    && band_entry_row_count(entries: ws.ready) == 0
    && !band_entry_has_active(entries: ws.upcoming)
}

// The family-once receipts, all against constructed facts. Stated-once: two listed members plus one
// UNLISTED lookalike (its headline literally starts with the family claim prose) produce ONE
// BandFamily carrying the claim, member rows whose headlines are the typed SUBJECTS verbatim, and
// the lookalike as an ungrouped BandRow with its fused headline untouched — membership is the typed
// fact list, never a prefix scan, in both directions (a subject CONTAINING claim prose is not
// stripped; a headline MATCHING claim prose is not captured). Attention-outranks-taxonomy: a member
// with active work leaves for the Active band as an individual row while the group keeps only its
// remaining member. Missing decl: a member fact naming an undeclared family renders as its own
// ungrouped row (no fabricated header).
fn fx_family_member_row(node_id: String, headline: String, activity: ActivityView) -> WorkRowView {
  let base = fx_row(activity: activity)
  WorkRowView {
    node_id: node_id,
    headline: headline,
    summary: base.summary,
    lifecycle: base.lifecycle,
    scheduling: base.scheduling,
    superseded_by: base.superseded_by,
    activity: base.activity,
    action: base.action,
    supporting_facts: base.supporting_facts,
    disclosure: base.disclosure,
    rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    worker_alive: false,
    standing: none,
    attempt_stale: false,
  }
}

fn fx_family_claim() -> String { "Write the closing check — one executable done-condition for each gated node below" }

fn fx_family_decls() -> List<WorkFamilyDecl> {
  [ WorkFamilyDecl { id: "closing-contract", claim: fx_family_claim() } ]
}

fn fx_family_members() -> List<WorkFamilyMemberFact> {
  [
    WorkFamilyMemberFact { family_id: "closing-contract", task_node: "cc-a", subject: "Alpha subject" },
    WorkFamilyMemberFact { family_id: "closing-contract", task_node: "cc-b", subject: join([fx_family_claim(), " nested in a subject"], "") },
  ]
}

test fn witness_family_claim_stated_once_rows_carry_subject() -> Bool {
  let m1 = fx_family_member_row(node_id: "cc-a", headline: "Write the closing check for: Alpha subject", activity: NoActiveWork)
  let lookalike = fx_family_member_row(node_id: "solo", headline: join([fx_family_claim(), " for: Unlisted"], ""), activity: NoActiveWork)
  let m2 = fx_family_member_row(node_id: "cc-b", headline: "Write the closing check for: Beta subject", activity: NoActiveWork)
  let ws = daily_workspace_view(rows: [m1, lookalike, m2], edges: [], program: none, observation: ObservationsNominal,
    families: fx_family_decls(), members: fx_family_members())
  count(ws.upcoming) == 2
    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandFamily { family } =>
          family.claim == fx_family_claim()
            && count(family.rows) == 2
            && (match family.rows.first() {
              Present { value: r } => r.headline == "Alpha subject"
              Absent => false
            })
        BandRow { row: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
    && fold(ws.upcoming, init: false, f: (acc, e) => acc || (match e {
      BandRow { row } => row.node_id == "solo" && row.headline == join([fx_family_claim(), " for: Unlisted"], "")
      BandFamily { family: _ } => false
      BandProject { project: _ } => false
    }))
}

test fn witness_family_membership_is_typed_not_parsed() -> Bool {
  let m2 = fx_family_member_row(node_id: "cc-b", headline: "Write the closing check for: Beta subject", activity: NoActiveWork)
  let ws = daily_workspace_view(rows: [m2], edges: [], program: none, observation: ObservationsNominal,
    families: fx_family_decls(), members: fx_family_members())
  fold(ws.upcoming, init: false, f: (acc, e) => acc || (match e {
    BandFamily { family } => fold(family.rows, init: false, f: (a, r) =>
      a || r.headline == join([fx_family_claim(), " nested in a subject"], ""))
    BandRow { row: _ } => false
    BandProject { project: _ } => false
  }))
}

test fn witness_active_family_member_leaves_group() -> Bool {
  let m1 = fx_family_member_row(node_id: "cc-a", headline: "Write the closing check for: Alpha subject", activity: fx_specimen_activity())
  let m2 = fx_family_member_row(node_id: "cc-b", headline: "Write the closing check for: Beta subject", activity: NoActiveWork)
  let ws = daily_workspace_view(rows: [m1, m2], edges: [], program: none, observation: ObservationsNominal,
    families: fx_family_decls(), members: fx_family_members())
  count(ws.active) == 1
    && (match ws.active.first() {
      Present { value: e } => match e {
        BandRow { row } => row.node_id == "cc-a"
        BandFamily { family: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
    && fold(ws.upcoming, init: false, f: (acc, e) => acc || (match e {
      BandFamily { family } => count(family.rows) == 1
      BandRow { row: _ } => false
      BandProject { project: _ } => false
    }))
}

test fn witness_undeclared_family_member_stays_ungrouped_row() -> Bool {
  let m1 = fx_family_member_row(node_id: "cc-a", headline: "Write the closing check for: Alpha subject", activity: NoActiveWork)
  let ws = daily_workspace_view(rows: [m1], edges: [], program: none, observation: ObservationsNominal,
    families: [], members: fx_family_members())
  count(ws.upcoming) == 1
    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandRow { row } => row.headline == "Write the closing check for: Alpha subject"
        BandFamily { family: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
}

// Routine-state collapse both directions: the open default derives chip-hidden (the band and the
// node class still carry the state), and every departing lifecycle derives chip-shown. A future
// lifecycle arm added without a chip decision fails compile at the match, not silently.

test fn witness_lifecycle_chip_only_when_discriminating() -> Bool {
  !lifecycle_chip_renders(l: OpenLifecycle)
    && lifecycle_chip_renders(l: ReviewLifecycle)
    && lifecycle_chip_renders(l: DoneLifecycle)
    && lifecycle_chip_renders(l: SupersededLifecycle)
}

// The one-failure-once discrimination: a workspace-level refusal produces ONE banner (the impact
// view carries the located reason) and covers each row's unobservable narration — only the
// unobservable arm, and only while the workspace impact is present. The REDs: an active row is
// never covered (a live attempt's narration must survive a broken observation channel claim), and
// with a nominal workspace observation a row-specific unobservable reason narrates on its own row
// (coverage false).
test fn witness_workspace_impact_narrates_once() -> Bool {
  let impact = observation_impact_view(workflow_refused: Present { value: "GET /workflow.json refused: connection refused" })
  let nominal = observation_impact_view(workflow_refused: none)
  let impact_ok = match impact {
    WorkspaceObservationImpact { summary, located_reason } =>
      summary == "workflow observation unavailable"
        && located_reason == "GET /workflow.json refused: connection refused"
    ObservationsNominal => false
  }
  let unobs = ActivityUnobservable { reason: "GET /workflow.json refused: connection refused" }
  impact_ok
    && (match nominal { ObservationsNominal => true WorkspaceObservationImpact { summary: _, located_reason: _ } => false })
    && workspace_covers_row_activity(observation: impact, a: unobs)
    && !workspace_covers_row_activity(observation: impact, a: fx_specimen_activity())
    && !workspace_covers_row_activity(observation: nominal, a: unobs)
}

// ── The status-surface ruling (operator, 2026-09-20) ────────────────────────────────────────────
//
// Four receipts, all over constructed payloads: an enumerated dump never renders inline (count +
// bounded excerpt + the receipt pointer, even behind the disclosure); identical lane failures
// aggregate in the label while the per-lane clauses stay reachable but bounded; a refused lane's
// surface text is the state word plus a short reason, never the raw payload; and staleness is a
// revision comparison with two honest empty arms.

fn fx_dump_lines(n: Int) -> List<String> {
  if n <= 0 {
    []
  } else {
    concat(fx_dump_lines(n: n - 1), [
      join(["unparseable .dag source src/lane-", to_string(value: n), ".dag"], ""),
    ])
  }
}

fn fx_lane_keys() -> List<String> {
  [
    "minimize-redundancy", "single-authority", "conformance", "consumption",
    "goal", "fail-closed", "selection-precedes-convergence", "evidence",
    "scope", "simplicity", "external-facts", "realization", "decision", "keys",
  ]
}

fn fx_uniform_review_detail() -> String {
  join(map(fx_lane_keys(), k => join([k, ": reviewer exited 1 without a verdict"], "")), " · ")
}

// The 98-file dump: bounded to count + first excerpt-budget entries + the pointer; the 4th entry
// and the tail never reach the surface. RED: a renderer passing the payload through keeps
// lane-4/lane-98 present and the first assertion fails.
test fn witness_bounded_dump_renders_count_excerpt_and_pointer() -> Bool {
  let bounded = workflow_segment_detail_bounded(detail: join(fx_dump_lines(n: 98), "\n"))
  string_contains(s: bounded, pattern: "95 more of 98")
    && string_contains(s: bounded, pattern: "full list in the attempt receipt artifact")
    && string_contains(s: bounded, pattern: "src/lane-1.dag")
    && string_contains(s: bounded, pattern: "src/lane-3.dag")
    && !string_contains(s: bounded, pattern: "src/lane-4.dag")
    && !string_contains(s: bounded, pattern: "src/lane-98.dag")
}

// The passthrough arm is the control for the bound's discriminating direction: an ordinary
// one-sentence reason renders untouched, so the bound cannot be satisfied by truncating everything.
test fn witness_short_detail_passes_the_bound_untouched() -> Bool {
  workflow_segment_detail_bounded(detail: "turn.completed with process unobserved: no exit was established")
    == "turn.completed with process unobserved: no exit was established"
}

// Fourteen identical lane failures aggregate to one uniform claim; mixed messages do not —
// non-uniformity is information the label may not erase.
test fn witness_uniform_lane_failures_aggregate() -> Bool {
  match activity_uniform_lane_summary(detail: fx_uniform_review_detail()) {
    Present { value: aggregate } =>
      aggregate == "14/14 lanes — reviewer exited 1 without a verdict"
    Absent => false
  }
}

test fn witness_mixed_lane_failures_do_not_aggregate() -> Bool {
  match activity_uniform_lane_summary(detail: join([
    "minimize-redundancy: reviewer exited 1 without a verdict",
    "single-authority: changes requested — drop the second authority",
    "conformance: reviewer exited 1 without a verdict",
    "consumption: reviewer exited 2 without a verdict",
  ], " · ")) {
    Absent => true
    Present { value: _ } => false
  }
}

// The refused Review lane end to end: the surface label is the state word plus the aggregate — no
// criterion key, no raw enumeration — and the located reason behind the disclosure is itself
// bounded (first three lanes + the count + the pointer).
test fn witness_refused_review_lane_labels_and_bounds() -> Bool {
  match activity_view_from_parts(
    segments: [
      WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentRefused, detail: fx_uniform_review_detail() },
    ],
    remaining: 6,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  ) {
    ActiveWorkRefused { summary, located_reason, evidence: _, obligations: _ } =>
      summary == "Review · refused — 14/14 lanes — reviewer exited 1 without a verdict"
        && !string_contains(s: summary, pattern: "minimize-redundancy")
        && string_contains(s: located_reason, pattern: "minimize-redundancy: reviewer exited 1 without a verdict")
        && string_contains(s: located_reason, pattern: "11 more of 14")
        && string_contains(s: located_reason, pattern: "full list in the attempt receipt artifact")
        && !string_contains(s: located_reason, pattern: "consumption: reviewer exited 1 without a verdict")
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    NoActiveWork => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
}

// Staleness is a revision comparison, both honest arms included: a readable launch revision that
// differs from the deployed head is stale; the same revision is not; an unreadable launch record
// (empty observation) dims nothing; and an unobservable current revision dims nothing at all.
test fn witness_stale_attempt_nodes_compares_revisions() -> Bool {
  let observations = [
    AttemptRevisionObservation { node_id: "n-stale", launch_revision_hex: "aaaa" },
    AttemptRevisionObservation { node_id: "n-current", launch_revision_hex: "bbbb" },
    AttemptRevisionObservation { node_id: "n-unreadable", launch_revision_hex: "" },
  ]
  let stale = stale_attempt_nodes(observations: observations, current_revision_hex: "bbbb")
  count(stale) == 1
    && (match stale.first() { Present { value: s } => s == "n-stale" Absent => false })
    && count(stale_attempt_nodes(observations: observations, current_revision_hex: "")) == 0
}

// ── Project hierarchy (operator request 2026-09-20) ────────────────────────────────────────────
//
// The derivation direction, pinned first because it has been inverted twice: edge(child: X,
// parent: Y) means X depends on Y, so a project's TASKS are its PREREQUISITES — the rows named in
// the parent position of its edges. The exemplar is the arc shell-typed-invocation, which the
// authority points at its ten shell-dag-* tasks with edge(child: "shell-typed-invocation",
// parent: "shell-dag-X"). Every fixture here is constructed; no live roadmap population is read.

fn fx_sized(id: String, content: String) -> RoadmapNode {
  gunbc.roadmap_authority.authored_wi(
    identity: join(["rnfx-", id], ""),
    id: id,
    done: false,
    content: content,
    intricacy: IntricacyLow,
    volume: VolumeSmall,
    repo: "gunbc")
}

fn fx_hier_view(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, activity: ActivityView, standing: RoadmapNodeStanding?) -> WorkRowView {
  work_row_view(
    rn: rn, nodes: nodes, edges: edges, merged: merged, activity: activity,
    rounds: RoundsUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    worker_alive: false, standing: standing, attempt_stale: false,
    launch: fx_row_launch(nodes: nodes, edges: edges))
}

fn fx_hier_nodes() -> List<RoadmapNode> {
  [
    fx_sized(id: "hier-project", content: "project headline — project brief"),
    gunbc.roadmap_authority.sign(
      rn: fx_sized(id: "hier-task-done", content: "done task"),
      s: gunbc.roadmap_authority.signed(
        by: "op",
        works: RedControlExecuted { witness_module: "test.claim.roadmap_presentation_witness", witness_fn: "witness_project_progress_counts_accepted_or_superseded_only", executed_on: "2026-09-20" },
        scope_equivalent: HandbackDelivered { first_artifact: "receipt", further_artifacts: [] },
        as_expected: true)),
    gunbc.roadmap_authority.superseded(identity: "rnfx-hier-task-superseded", id: "hier-task-superseded", by: "hier-task-done", content: "old shape"),
    gunbc.roadmap_authority.derivable_wi(
      identity: "rnfx-hier-task-review", id: "hier-task-review",
      prs: [7301], title: "review task", description: "",
      intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc"),
    fx_sized(id: "hier-task-open", content: "open task"),
  ]
}

fn fx_hier_edges() -> List<RoadmapEdge> {
  [
    gunbc.roadmap_authority.edge(child: "hier-project", parent: "hier-task-done"),
    gunbc.roadmap_authority.edge(child: "hier-project", parent: "hier-task-superseded"),
    gunbc.roadmap_authority.edge(child: "hier-project", parent: "hier-task-review"),
    gunbc.roadmap_authority.edge(child: "hier-project", parent: "hier-task-open"),
  ]
}

fn fx_hier_rows(activity_for_open: ActivityView, standing_for_open: RoadmapNodeStanding?) -> List<WorkRowView> {
  let nodes = fx_hier_nodes()
  let edges = fx_hier_edges()
  map(nodes, rn => fx_hier_view(
    rn: rn, nodes: nodes, edges: edges, merged: [7301],
    activity: if (rn.node as String) == "hier-task-open" { activity_for_open } else { NoActiveWork },
    standing: if (rn.node as String) == "hier-task-open" { standing_for_open } else { none }))
}

fn fx_row_of(rows: List<WorkRowView>, node_id: String) -> WorkRowView {
  match rows |> filter(r => r.node_id == node_id) |> first {
    Present { value: r } => r
    Absent => fx_row(activity: NoActiveWork)
  }
}

fn fx_entry_id(entry: ProjectTreeEntry) -> String {
  match entry {
    ProjectLeaf { row } => row.node_id
    ProjectNested { project } => project.row.node_id
  }
}

fn band_entry_ids(entry: WorkBandEntry) -> List<String> {
  match entry {
    BandRow { row } => [ row.node_id ]
    BandFamily { family } => map(family.rows, r => r.node_id)
    BandProject { project } => project_tree_row_ids(view: project)
  }
}

fn fx_ws_rendered_ids(ws: DailyWorkspaceView) -> List<String> {
  concat(
    flat_map(ws.active, e => band_entry_ids(entry: e)),
    concat(
      flat_map(ws.ready, e => band_entry_ids(entry: e)),
      concat(
        flat_map(ws.upcoming, e => band_entry_ids(entry: e)),
        concat(
          flat_map(ws.done, e => band_entry_ids(entry: e)),
          flat_map(ws.superseded, e => band_entry_ids(entry: e))))))
}

fn fx_project_tree(rows: List<WorkRowView>, edges: List<RoadmapEdge>, node_id: String) -> ProjectTreeView {
  project_tree_view(
    row: fx_row_of(rows: rows, node_id: node_id),
    rows: rows, edges: edges, members: [], depth: 1, fuel: count(rows))
}

// THE DIRECTION WALL: the project's display children are the rows in the PARENT position of its
// edges (its prerequisites), in edge declaration order; the prerequisite rows own no tree of their
// own. An inversion of this derivation reds every conjunct.
test fn witness_project_tasks_are_prerequisites() -> Bool {
  let rows = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: none)
  let edges = fx_hier_edges()
  map(project_task_rows(rows: rows, edges: edges, members: [], node_id: "hier-project"), r => r.node_id)
    == ["hier-task-done", "hier-task-superseded", "hier-task-review", "hier-task-open"]
    && count(project_task_rows(rows: rows, edges: edges, members: [], node_id: "hier-task-open")) == 0
    && row_is_project(rows: rows, edges: edges, members: [], row: fx_row_of(rows: rows, node_id: "hier-project"))
    && !row_is_project(rows: rows, edges: edges, members: [], row: fx_row_of(rows: rows, node_id: "hier-task-open"))
}

// PROGRESS COUNTS CLOSURE, NEVER IMPLEMENTATION EVIDENCE: closed = accepted or superseded
// (node_closes_dependency), so the done and superseded tasks close and the review task — a merged
// PR without an accepting signoff — does not. A derivation that counted "has a PR" as closed
// would report 3 of 4 here; the correct answer is 2 of 4. The project itself is upcoming (two
// unmet prerequisites) and carries its four tasks nested in edge declaration order; the bands the
// tasks left behind are empty because every one of them renders exactly once, inside the tree.
test fn witness_project_progress_counts_accepted_or_superseded_only() -> Bool {
  let rows = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: none)
  let edges = fx_hier_edges()
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: [], members: [])
  count(ws.active) == 0
    && count(ws.upcoming) == 1
    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandProject { project } =>
          project.row.node_id == "hier-project"
            && project.total_count == 4
            && project.closed_count == 2
            && map(project.entries, ent => fx_entry_id(entry: ent))
              == ["hier-task-done", "hier-task-superseded", "hier-task-review", "hier-task-open"]
            && !project.auto_open
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
    && band_entry_row_count(entries: ws.ready) == 0
    && band_entry_row_count(entries: ws.done) == 0
    && band_entry_row_count(entries: ws.superseded) == 0
}

// NOTHING VANISHES, NOTHING DUPLICATES, and GROUP-EVERYWHERE (operator feedback 2026-09-21,
// amending ACTIVE-SURFACES): the open task with a live attempt NESTS under its project like every
// other task — the project root joins the Active band because its subtree carries live work,
// renders there as ONE grouped project row (auto-open by the live-subtree pulse), and every
// rendered input row appears in the composed workspace exactly once, in its nested position.
test fn witness_workspace_nesting_loses_no_node_and_duplicates_none() -> Bool {
  let rows = fx_hier_rows(activity_for_open: fx_specimen_activity(), standing_for_open: none)
  let edges = fx_hier_edges()
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: [], members: [])
  let ids = fx_ws_rendered_ids(ws: ws)
  count(ids) == 5
    && all(rows, r => count(ids |> filter(i => i == r.node_id)) == 1)
    && count(ws.active) == 1
    && (match ws.active.first() {
      Present { value: e } => match e {
        BandProject { project } =>
          project.row.node_id == "hier-project"
            && project.total_count == 4
            && map(project.entries, ent => fx_entry_id(entry: ent))
              == ["hier-task-done", "hier-task-superseded", "hier-task-review", "hier-task-open"]
            && project.auto_open
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
    && band_entry_row_count(entries: ws.upcoming) == 0
    && band_entry_row_count(entries: ws.ready) == 0
    && band_entry_row_count(entries: ws.done) == 0
    && band_entry_row_count(entries: ws.superseded) == 0
}

// A projectless row with a live attempt renders FLAT in the Active band (the band's other top-level
// shape), while an idle sibling stays in its scheduling band — the band's membership is root-grain:
// the active row's own position is top-level because nothing nests it, not because it was pulled
// out of a tree.
test fn witness_projectless_active_row_renders_flat_in_active() -> Bool {
  let nodes = [
