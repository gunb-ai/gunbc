    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandProject { project } =>
          project.row.node_id == "hier-multi-a"
            && count(project.chain) == 0
            && map(project.entries, x => fx_entry_id(entry: x)) == ["hier-multi-b", "hier-multi-x"]
            && (match project.entries.first() {
