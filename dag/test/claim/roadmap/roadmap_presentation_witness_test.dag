// THE OWNERSHIP CLAUSE (the fleet-closed-loop-converge interaction): a project collapses through
// its single display child only when it OWNS that child (the child's primary display parent is
// the collapsing project). Here the shared intermediate project M gates both P1 and P2, and M's
// primary parent is P2 (first declared edge): P2 collapses through M and carries M's task, while
// P1 keeps its honest "0 of 1" with no entries and no chain — M joins exactly one chain.
test fn witness_shared_project_child_collapses_only_under_owner() -> Bool {
  let nodes = [
    fx_sized(id: "hier-sp-p1", content: "project one"),
    fx_sized(id: "hier-sp-p2", content: "project two"),
    fx_sized(id: "hier-sp-m", content: "shared project"),
    fx_sized(id: "hier-sp-t", content: "shared project task"),
  ]
  let edges = [
    gunbc.roadmap_authority.edge(child: "hier-sp-p2", parent: "hier-sp-m"),
    gunbc.roadmap_authority.edge(child: "hier-sp-p1", parent: "hier-sp-m"),
    gunbc.roadmap_authority.edge(child: "hier-sp-m", parent: "hier-sp-t"),
  ]
  let rows = map(nodes, rn => fx_hier_view(rn: rn, nodes: nodes, edges: edges, merged: [], activity: NoActiveWork, standing: none))
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: [], members: [])
  let ids = fx_ws_rendered_ids(ws: ws)
  count(ids) == 4
    && all(rows, r => count(ids |> filter(i => i == r.node_id)) == 1)
    && (match ws.upcoming |> filter(e => match e {
        BandProject { project } => project.row.node_id == "hier-sp-p1"
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }) |> first {
      Present { value: e } => match e {
        BandProject { project } =>
          count(project.chain) == 0
            && project.total_count == 1
            && count(project.entries) == 0
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
    && (match ws.upcoming |> filter(e => match e {
        BandProject { project } => project.row.node_id == "hier-sp-p2"
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }) |> first {
      Present { value: e } => match e {
        BandProject { project } =>
          map(project.chain, r => r.node_id) == ["hier-sp-m"]
            && project.total_count == 1
            && map(project.entries, x => fx_entry_id(entry: x)) == ["hier-sp-t"]
        BandRow { row: _ } => false
        BandFamily { family: _ } => false
      }
      Absent => false
    })
}

// FAMILY-FIRST: the closing-contract family is the presentation authority for its generated task
// rows, so a family member that is also a project's prerequisite stays in its family group —
// never nested, never counted, never duplicated — and the would-be project renders as an ordinary
// flat row.
test fn witness_family_member_never_nests() -> Bool {
  let nodes = [
    fx_sized(id: "hier-fam-project", content: "family-adjacent project"),
    fx_sized(id: "hier-fam-task", content: "family member task"),
  ]
  let edges = [
    gunbc.roadmap_authority.edge(child: "hier-fam-project", parent: "hier-fam-task"),
  ]
  let rows = map(nodes, rn => fx_hier_view(rn: rn, nodes: nodes, edges: edges, merged: [], activity: NoActiveWork, standing: none))
  let families = [ WorkFamilyDecl { id: "fx-fam", claim: "fx family claim" } ]
  let members = [ WorkFamilyMemberFact { family_id: "fx-fam", task_node: "hier-fam-task", subject: "fx subject" } ]
  let ws = daily_workspace_view(rows: rows, edges: edges, program: none, observation: ObservationsNominal, families: families, members: members)
  let ids = fx_ws_rendered_ids(ws: ws)
  count(ids) == 2
    && all(rows, r => count(ids |> filter(i => i == r.node_id)) == 1)
    && !row_is_project(rows: rows, edges: edges, members: members, row: fx_row_of(rows: rows, node_id: "hier-fam-project"))
    && (match ws.upcoming.first() {
      Present { value: e } => match e {
        BandRow { row } => row.node_id == "hier-fam-project"
        BandFamily { family: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
    && (match ws.ready.first() {
      Present { value: e } => match e {
        BandFamily { family } => map(family.rows, r => r.node_id) == ["hier-fam-task"]
        BandRow { row: _ } => false
        BandProject { project: _ } => false
      }
      Absent => false
    })
}

// ── Hero rows, red flags, and activity classification (operator request 2026-09-21) ─────────────
//
// The semantic activity-line classes derive from TYPED sources only — the round ledger's segment
// kinds, the decided activity arm and attention — never from the rendered text. Every class has a
// discriminating fixture below, plus one unclassifiable-stays-neutral control; exec is the
// declared vocabulary member with no on-page producer today (its trigger is named in the authority
// comment: ProviderRunning carrying the typed CodexItemActivity).

fn fx_refused_activity() -> ActivityView {
  activity_view_from_parts(
    segments: [
      WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
      WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentRefused, detail: "turn.completed with process unobserved: no exit was established" },
    ],
    remaining: 6,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  )
}

fn fx_completed_activity() -> ActivityView {
  activity_view_from_parts(
    segments: [
      WorkflowSegment { kind: EnvironmentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
      WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentComplete, detail: "" },
    ],
    remaining: 0,
    process: WorkerProcessExited { exit_code: 0, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  )
}

fn fx_failed_activity() -> ActivityView {
  activity_view_from_parts(
    segments: [
      WorkflowSegment { kind: AgentWorkflowSegment, state: WorkflowSegmentFailed, detail: "exit 1 before terminal event" },
    ],
    remaining: 6,
    process: WorkerProcessExited { exit_code: 1, last_command: "" },
    throughput: ThroughputUnobserved { reason: "fixture models no provider event stream" as NonEmptyStr },
    current_activity: "",
  )
}

test fn witness_activity_line_classification_is_typed() -> Bool {
  activity_line_class_key(c: activity_line_class_of_round(k: ReadRound)) == "read"
    && activity_line_class_key(c: activity_line_class_of_round(k: WriteRound)) == "write"
    && activity_line_class_key(c: activity_line_class_of_round(k: ReasonRound)) == "provider-call"
    && activity_line_class_key(c: activity_line_class_of_round(k: UnmeasuredRound)) == "neutral"
    && activity_line_class_key(c: activity_line_class_of_activity(a: fx_specimen_activity())) == "neutral"
    && activity_line_class_key(c: activity_line_class_of_activity(a: fx_refused_activity())) == "error-refusal"
    && activity_line_class_key(c: activity_line_class_of_activity(a: fx_failed_activity())) == "error-refusal"
    && activity_line_class_key(c: activity_line_class_of_activity(a: fx_completed_activity())) == "done"
    && activity_line_class_key(c: activity_line_class_of_activity(a: NoActiveWork)) == "neutral"
    && activity_line_class_key(c: activity_line_class_of_activity(a: ActivityUnobservable { reason: "channel unreadable" })) == "neutral"
    && activity_line_class_key(c: ActivityLineExec) == "exec"
}

// The refused and completed arms carry their obligation roster (the hero stage strip reads it):
// the refused strip shows WHICH segment is red, the completed strip reads all-done. Constructed
// before this increment they had no segments field, and the strip had nothing to paint.
test fn witness_refused_and_completed_arms_carry_the_roster() -> Bool {
  match fx_refused_activity() {
    ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations } =>
      count(obligations) == 2
        && (match obligations |> filter(s => workflow_segment_state_key(state: s.state) == "refused") |> first {
          Present { value: s } => workflow_segment_state_key(state: s.state) == "refused"
          Absent => false
        })
    NoActiveWork => false
    ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
    LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
    CompletedWork { outcome: _, evidence: _, obligations: _ } => false
    ActivityUnobservable { reason: _ } => false
  }
    && match fx_completed_activity() {
      CompletedWork { outcome: _, evidence: _, obligations } =>
        count(obligations) == 2
          && all(obligations, s => workflow_segment_state_key(state: s.state) == "complete")
      NoActiveWork => false
      ActiveWork { summary: _, obligations: _, remaining_obligation_count: _, current_activity: _, attention: _, evidence: _ } => false
      ActiveWorkRefused { summary: _, located_reason: _, evidence: _, obligations: _ } => false
      LegacySupersedableAttempt { summary: _, located_reason: _, attempt_key: _, evidence: _ } => false
      ActivityUnobservable { reason: _ } => false
    }
}

// THE RED FLAG DERIVES FROM DECIDED STATES: a project whose subtree carries a refused or a failed
// (anomalous) attempt flags; the same tree quiet or green does not. The erred row itself keeps the
// attention law and surfaces in the Active band — the flag is derived over display children,
// whether or not they render nested.
test fn witness_project_red_flag_derives_from_decided_states() -> Bool {
  let edges = fx_hier_edges()
  let rows_ok = fx_hier_rows(activity_for_open: NoActiveWork, standing_for_open: none)
  let rows_refused = fx_hier_rows(activity_for_open: fx_refused_activity(), standing_for_open: none)
  let rows_failed = fx_hier_rows(activity_for_open: fx_failed_activity(), standing_for_open: none)
  let rows_done = fx_hier_rows(activity_for_open: fx_completed_activity(), standing_for_open: none)
  !fx_project_tree(rows: rows_ok, edges: edges, node_id: "hier-project").subtree_error
    && fx_project_tree(rows: rows_refused, edges: edges, node_id: "hier-project").subtree_error
    && fx_project_tree(rows: rows_failed, edges: edges, node_id: "hier-project").subtree_error
    && !fx_project_tree(rows: rows_done, edges: edges, node_id: "hier-project").subtree_error
    && row_activity_erred(row: fx_row_of(rows: rows_refused, node_id: "hier-task-open"))
    && row_activity_erred(row: fx_row_of(rows: rows_failed, node_id: "hier-task-open"))
    && !row_activity_erred(row: fx_row_of(rows: rows_ok, node_id: "hier-task-open"))
}

// The wire carries the DECIDED summary class so the client paints it verbatim (the single
// projection authority's wire half): refused flags error-refusal, completed reads done, a routine
// active attempt stays neutral.
test fn witness_wire_carries_decided_summary_class() -> Bool {
  string_contains(s: serialize_json(v: activity_view_json_value(view: fx_refused_activity())), pattern: "\"summary_class\": \"error-refusal\"")
    && string_contains(s: serialize_json(v: activity_view_json_value(view: fx_completed_activity())), pattern: "\"summary_class\": \"done\"")
    && string_contains(s: serialize_json(v: activity_view_json_value(view: fx_specimen_activity())), pattern: "\"summary_class\": \"neutral\"")
    && string_contains(s: serialize_json(v: activity_view_json_value(view: NoActiveWork)), pattern: "\"summary_class\": \"neutral\"")
}
