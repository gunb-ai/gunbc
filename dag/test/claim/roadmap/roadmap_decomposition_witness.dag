module test.claim.roadmap.roadmap_decomposition_witness

import std.types { Bool, Int, List, String }
import gunbc.roadmap.roadmap_authority { nid }
import gunbc.roadmap.roadmap_decomposition {
  roadmap_decompositions, decompositions_all_have_nodes, decomposition_has_node, decomposition, decomposition_nodes_unique,
  decompositions_leaf_days_bounded, piece_leaf_days_within, leaf, probe, reading_family, findings_family, join, decision, piece, waits,
  decompositions_stages_nonempty, piece_stages_nonempty, decomposition_for, stages_leaf_count, stages_findings_families,
  piece_leaf_count, piece_leaf_days, piece_findings_families, decompositions_findings_probes_exist, decomposition_findings_probes_exist,
  decompositions_owners_declared, decompositions_dependencies_well_formed, dependency_is_well_formed,
  decompositions_wait_on_every_decomposed_parent, decomposition_waits_on_every_decomposed_parent,
  LeafCount, LeafPricing, UnprobedFamily, Counted, Uncounted, Priced, Unpriced,
}

// ---- single-match predicates (a match cannot be an operand of && in this dialect; arms are newline-separated) ----
fn counted_members(v: LeafCount, want: Int) -> Bool {
  match v {
    Counted { members: m } => m == want
    Uncounted { families: _ } => false
  }
}
fn priced_days(v: LeafPricing, want: Int) -> Bool {
  match v {
    Priced { days: d } => d == want
    Unpriced { families: _ } => false
  }
}
fn uncounted_naming(v: LeafCount, family: String, probe: String) -> Bool {
  match v {
    Uncounted { families: fams } => fams.head.family == family && fams.head.probe == probe
    Counted { members: _ } => false
  }
}

// A decomposition whose node id is not a declared roadmap node is the undefined variable this carrier refuses.
test fn every_decomposition_names_a_declared_node() -> Bool {
  decompositions_all_have_nodes()
}

test fn a_decomposition_for_an_undeclared_node_is_refused() -> Bool {
  !decomposition_has_node(d: decomposition(node: "no-such-node-2026-11-17", waits_on: [], stages: [[leaf(label: "planted", days: 1)]]))
}

test fn no_node_is_decomposed_twice() -> Bool {
  decomposition_nodes_unique()
}

// THE LEAF RULE: at most five working days, at every depth, for leaves and for a family's per-member work.
test fn every_leaf_is_within_the_leaf_rule() -> Bool {
  decompositions_leaf_days_bounded()
}

test fn a_six_day_leaf_is_refused() -> Bool {
  !piece_leaf_days_within(p: leaf(label: "planted", days: 6))
}

test fn a_six_day_leaf_inside_a_composite_is_refused_at_depth() -> Bool {
  !piece_leaf_days_within(p: piece(label: "outer", stages: [[piece(label: "inner", stages: [[leaf(label: "fine", days: 5)], [reading_family(label: "planted", days: 6, members: 2, on: "2026-11-17", basis: "planted", owner: "native-seven")]])]]))
}

test fn a_decision_needs_two_alternatives() -> Bool {
  !piece_leaf_days_within(p: decision(label: "planted", alternatives: ["only one"])) && piece_leaf_days_within(p: decision(label: "fine", alternatives: ["a", "b"]))
}

test fn no_stage_is_empty() -> Bool {
  decompositions_stages_nonempty()
}

test fn an_empty_stage_is_refused() -> Bool {
  !piece_stages_nonempty(p: piece(label: "outer", stages: [[leaf(label: "fine", days: 1)], []]))
}

// Populations: a Produced or Reading family prices and counts one leaf per member; a FindingsOf family leaves the
// pricing and the count UNPRICED / UNCOUNTED (its population is unknown until the probe runs); a join is no work.
test fn a_family_counts_one_leaf_per_member() -> Bool {
  let f = reading_family(label: "members", days: 2, members: 7, on: "2026-11-17", basis: "planted", owner: "native-seven")
  counted_members(v: piece_leaf_count(p: f), want: 7)
    && priced_days(v: piece_leaf_days(p: f), want: 14)
    && counted_members(v: piece_leaf_count(p: join(label: "j")), want: 0)
    && priced_days(v: piece_leaf_days(p: join(label: "j")), want: 0)
}

// RED FIRST (the count side): an item whose pieces include a FindingsOf family is UNCOUNTED -- the count names the
// family and its probe -- never Counted at leaf+1 as a fabricated one-member price. The findings family is still
// REPORTED (stages_findings_families / piece_findings_families count families, an honest count, not a member count).
test fn a_findings_family_is_counted_as_unknown_and_reported() -> Bool {
  let p = piece(label: "outer", stages: [[leaf(label: "enumerate (probe)", days: 2)], [findings_family(label: "one member", days: 3, probe: "enumerate (probe)", owner: "native-seven")]])
  uncounted_naming(v: piece_leaf_count(p: p), family: "one member", probe: "enumerate (probe)")
    && piece_findings_families(p: p) == 1 && piece_findings_families(p: leaf(label: "sure", days: 1)) == 0
}

// A findings family names a probe leaf of its own item, exactly once.
test fn every_findings_family_names_a_probe_leaf_of_its_item() -> Bool {
  decompositions_findings_probes_exist()
}

test fn a_findings_family_naming_no_probe_is_refused() -> Bool {
  !decomposition_findings_probes_exist(d: decomposition(node: "native-seven", waits_on: [], stages: [[leaf(label: "something else", days: 1)], [findings_family(label: "one finding", days: 1, probe: "no such probe", owner: "native-seven")]]))
}

// A family's owner is a declared node (semantic-home work is charged to its semantic authority).
test fn every_family_owner_is_declared() -> Bool {
  decompositions_owners_declared()
}

// Stage dependencies: each names a declared parent edge and stages both sides have; every decomposed parent is waited on.
test fn every_stage_dependency_is_well_formed() -> Bool {
  decompositions_dependencies_well_formed()
}

test fn a_dependency_on_a_non_parent_is_refused() -> Bool {
  let d = decomposition(node: "second-generation", waits_on: [], stages: [[leaf(label: "x", days: 1)]])
  !dependency_is_well_formed(d: d, w: waits(item: "factory", from_stage: 0, into_stage: 0))
}

test fn a_dependency_on_a_stage_the_parent_lacks_is_refused() -> Bool {
  let d = decomposition(node: "second-generation", waits_on: [], stages: [[leaf(label: "x", days: 1)]])
  dependency_is_well_formed(d: d, w: waits(item: "native-seven", from_stage: 0, into_stage: 0)) && !dependency_is_well_formed(d: d, w: waits(item: "native-seven", from_stage: 9, into_stage: 0))
}

test fn every_decomposed_parent_is_waited_on() -> Bool {
  decompositions_wait_on_every_decomposed_parent()
}

test fn a_child_that_drops_a_decomposed_parent_is_refused() -> Bool {
  !decomposition_waits_on_every_decomposed_parent(d: decomposition(node: "second-generation", waits_on: [], stages: [[leaf(label: "x", days: 1)]]))
}

// The emitter door is its written-file residual, with its closing claim cited as the probe; the grammar is not its population.
test fn the_direct_rust_door_is_its_residual() -> Bool {
  let ds = decomposition_for(node: nid(s: "v2-emitter-direct-rust-door"))
  count(ds) == 1 && all(ds, d => counted_members(v: stages_leaf_count(stages: d.stages), want: 6) && stages_findings_families(stages: d.stages) == 0)
}

test fn an_item_with_no_decomposition_reads_as_none() -> Bool {
  count(decomposition_for(node: nid(s: "shell-typed-invocation"))) == 0
}
