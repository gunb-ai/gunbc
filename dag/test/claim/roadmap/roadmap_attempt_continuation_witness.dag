module test.claim.roadmap.roadmap_attempt_continuation_witness

// THE WITNESS FOR THE ONE DECISION. Each `test fn` is a family of the ContinuationPlan partition,
// and each carries a DISCRIMINATING RED CONTROL: a negative assertion that the plan is NOT a nearby
// variant it could be confused with (a joined lineage is not a spawn; a continued lineage is not a
// completion; a completion spawns nothing). A witness that only asserts the positive arm passes when
// the decision is wrong in the confusable direction -- the red control is what makes it discriminate.

import std.types { Bool, String, Int }
import gunbc.roadmap.roadmap_model {  RoadmapNodeId }
import gunbc.roadmap.roadmap_attempt_continuation {
  PriorExecutionObservation,
  ContinuationPlan, StartInitial, AlreadyRunning, Resume, NextAttempt, AlreadyComplete, Refuse,
  continuation_plan,
}
import gunbc.harness.harness_session_recovery { SessionRecoveryNone }
import gunbc.roadmap.roadmap_submission {
  WorkerSubmission, SubmissionReady, SubmissionBlocked, SubmissionNeedsContext,
  SubmissionCapture, submission_digest, SubmissionCaptureRootBound,
  SubmissionCaptureObservation,
  CaptureForHead, CaptureAbsent, CaptureUnreadable, CaptureNotAttempted,
}
import gunbc.roadmap.roadmap_workflow_stage {
  WorkflowSegment, WorkflowSegmentKind, WorkflowSegmentState, VerificationWorkflowSegment, ReviewWorkflowSegment, GoalAuditWorkflowSegment,
  WorkflowSegmentFailed, WorkflowSegmentComplete, WorkflowSegmentPending,
  WorkflowSegmentActive, WorkflowSegmentRefused, WorkflowSegmentStopped,
}

fn pri(
  capture: SubmissionCaptureObservation,
  verification: WorkflowSegment?,
  review: WorkflowSegment?,
  goal_audit: WorkflowSegment?,
) -> PriorExecutionObservation {
  PriorExecutionObservation {
    node_id: "n1",
    attempt_key: "a1",
    branch: "roadmap/n1/a1",
    worker_terminal: true,
    capture: capture,
    verification: verification,
    review: review,
    goal_audit: goal_audit,
    recovery: SessionRecoveryNone,
  }
}

fn capture_for(submission: WorkerSubmission) -> CaptureForHead {
  CaptureForHead {
    capture: SubmissionCapture {
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      scm_repository: "/instance/attempt-state/projects/n1.gunbc-repository.json",
      scm_commit_ordinal: 3,
      scm_root_locator: SubmissionCaptureRootBound { locator: "0123456789abcdef" },
      digest: submission_digest(submission: submission),
      submission: submission,
    },
  }
}

fn ready_capture() -> CaptureForHead {
  capture_for(submission: WorkerSubmission {
    readiness: SubmissionReady,
    explanation: "implemented the change and ran the acceptance route",
    limitations: "no soak",
  })
}

fn segment(kind: WorkflowSegmentKind, state: WorkflowSegmentState, detail: String) -> WorkflowSegment? {
  Present { value: WorkflowSegment { kind: kind, state: state, detail: detail } }
}

// A CONTINUED lineage carries its branch and says where the new attempt starts -- and it is NOT a
// completion and NOT a join: the red control on every NextAttempt witness.
fn continued_on(plan: ContinuationPlan, pattern: String) -> Bool {
  match plan {
    NextAttempt { reason, from_branch } =>
      reason.contains(pattern) && from_branch == "roadmap/n1/a1" && reason.contains("roadmap/n1/a1") && reason.contains("starts from that branch's head")
    _ => false
  }
}

test fn no_prior_attempt_is_the_first_attempt() -> Bool {
  (match continuation_plan(obs: none) {
    StartInitial { reason: _ } => true
    _ => false
  })
    // RED CONTROL: the first attempt is not mistaken for a continuation (which would need a branch)
    // nor a join.
    && !(match continuation_plan(obs: none) { NextAttempt { reason: _, from_branch: _ } => true, _ => false })
    && !(match continuation_plan(obs: none) { AlreadyRunning { reason: _, attempt_key: _ } => true, _ => false })
}

test fn worker_not_terminal_joins_the_live_attempt_never_double() -> Bool {
  let running = pri(capture: ready_capture(), verification: none, review: none, goal_audit: none)
  let joined = PriorExecutionObservation {
    node_id: running.node_id,
    attempt_key: running.attempt_key,
    branch: running.branch,
    worker_terminal: false,
    capture: running.capture,
    verification: running.verification,
    review: running.review,
    goal_audit: running.goal_audit,
    recovery: SessionRecoveryNone,
  }
  (match continuation_plan(obs: Present { value: joined }) {
    AlreadyRunning { reason, attempt_key } => attempt_key == "a1" && reason.contains("is live") && reason.contains("no second attempt")
    _ => false
  })
    // RED CONTROL: a live attempt is joined, never re-spawned as a first attempt or continued as a
    // new attempt beside the one that is still running.
    && !(match continuation_plan(obs: Present { value: joined }) { StartInitial { reason: _ } => true, _ => false })
    && !(match continuation_plan(obs: Present { value: joined }) { NextAttempt { reason: _, from_branch: _ } => true, _ => false })
}

test fn red_verdict_continues_a_new_attempt_from_branch_head() -> Bool {
  let verify_red = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentFailed, detail: "sandbox render red"), review: none, goal_audit: none)
  let review_red = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "verified"), review: segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentFailed, detail: "dag/a.dag: the arm is missing"), goal_audit: none)
  let audit_red = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "verified"), review: segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"), goal_audit: segment(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentFailed, detail: "the contract's red control is absent"))
  continued_on(plan: continuation_plan(obs: Present { value: verify_red }), pattern: "verification failed: sandbox render red")
    && continued_on(plan: continuation_plan(obs: Present { value: review_red }), pattern: "review requested changes: dag/a.dag: the arm is missing")
    && continued_on(plan: continuation_plan(obs: Present { value: audit_red }), pattern: "goal audit requested changes: the contract's red control is absent")
}

test fn all_green_completes_and_the_continue_is_a_noop() -> Bool {
  let green = pri(
    capture: ready_capture(),
    verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "verified"),
    review: segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"),
    goal_audit: segment(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"),
  )
  (match continuation_plan(obs: Present { value: green }) {
    AlreadyComplete { reason } => reason.contains("the lineage is complete") && reason.contains("nothing spawns")
    _ => false
  })
    // RED CONTROL: a complete lineage is neither joined into a spawn nor continued; it is done.
    && !(match continuation_plan(obs: Present { value: green }) { NextAttempt { reason: _, from_branch: _ } => true, _ => false })
    && !(match continuation_plan(obs: Present { value: green }) { StartInitial { reason: _ } => true, _ => false })
}

test fn handed_in_nothing_continues_from_branch_head() -> Bool {
  let yielded = pri(capture: CaptureAbsent, verification: none, review: none, goal_audit: none)
  let blocked = pri(capture: capture_for(submission: WorkerSubmission { readiness: SubmissionBlocked, explanation: "the acceptance run was still in flight", limitations: "" }), verification: none, review: none, goal_audit: none)
  let needs = pri(capture: capture_for(submission: WorkerSubmission { readiness: SubmissionNeedsContext, explanation: "the contract does not say which artifact the lane renders", limitations: "" }), verification: none, review: none, goal_audit: none)
  continued_on(plan: continuation_plan(obs: Present { value: yielded }), pattern: "without handing in a candidate")
    && continued_on(plan: continuation_plan(obs: Present { value: blocked }), pattern: "its worker reported it was blocked")
    && continued_on(plan: continuation_plan(obs: Present { value: needs }), pattern: "its submission declared needs-context")
}

// LAB BUG #4: a pre-commit-record attempt whose commit step never settled is a LEGACY record; it
// CONTINUES (a new attempt from the branch head) and is never parked in a forever 'capture owed'.
test fn legacy_capture_not_attempted_continues_not_parks() -> Bool {
  let legacy = pri(capture: CaptureNotAttempted { reason: "the belt's commit step has not run for this attempt" }, verification: none, review: none, goal_audit: none)
  continued_on(plan: continuation_plan(obs: Present { value: legacy }), pattern: "commit step never settled")
    // RED CONTROL: not joined (which would wait forever) and not refused.
    && !(match continuation_plan(obs: Present { value: legacy }) { AlreadyRunning { reason: _, attempt_key: _ } => true, _ => false })
    && !(match continuation_plan(obs: Present { value: legacy }) { Refuse { reason: _ } => true, _ => false })
}

test fn a_stopped_segment_is_a_refusal_not_a_fallback() -> Bool {
  let unreadable = pri(capture: CaptureUnreadable { reason: "the capture directory could not be listed" }, verification: none, review: none, goal_audit: none)
  let stopped = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentStopped, detail: "stopped"), review: none, goal_audit: none)
  (match continuation_plan(obs: Present { value: unreadable }) {
    Refuse { reason } => reason.contains("submission store is unreadable") && reason.contains("the capture directory could not be listed")
    _ => false
  })
    && (match continuation_plan(obs: Present { value: stopped }) {
      Refuse { reason } => reason.contains("does not inhabit")
      _ => false
    })
    // RED CONTROL: a refusal is never a spawn.
    && !(match continuation_plan(obs: Present { value: unreadable }) { NextAttempt { reason: _, from_branch: _ } => true, _ => false })
}

// The unbounded worker explanation is bounded and the truncation is marked.
test fn worker_explanation_is_bounded() -> Bool {
  let seed = "block-block-block-block-block-block-block-block-block-"
  let a4 = concat(concat(seed, seed), concat(seed, seed))
  let long_detail = concat(concat(a4, a4), concat(a4, a4))
  let blocked = pri(capture: capture_for(submission: WorkerSubmission { readiness: SubmissionBlocked, explanation: long_detail, limitations: "" }), verification: none, review: none, goal_audit: none)
  match continuation_plan(obs: Present { value: blocked }) {
    NextAttempt { reason, from_branch: _ } => reason.contains(" ...") && string_length(s: reason) < 1400
    _ => false
  }
}

// The waiting states all collapse to the JOIN: a segment owed, pending, active or retried-on-
// environment is a lineage still in motion, joined rather than waited on by a spawn; a stopped
// segment (a state it cannot inhabit) is the damaged-record refusal.
test fn segments_in_motion_join_and_stopped_refuses() -> Bool {
  let owed = pri(capture: ready_capture(), verification: none, review: none, goal_audit: none)
  let pending = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "queued"), review: none, goal_audit: none)
  let active = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentActive, detail: "running"), review: none, goal_audit: none)
  let refused = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentRefused, detail: "toolchain missing"), review: none, goal_audit: none)
  let stopped = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentStopped, detail: "stopped"), review: none, goal_audit: none)
  (match continuation_plan(obs: Present { value: owed }) {
    AlreadyRunning { reason, attempt_key: _ } => reason.contains("verification is owed")
    _ => false
  })
    && (match continuation_plan(obs: Present { value: pending }) {
      AlreadyRunning { reason, attempt_key: _ } => reason.contains("still pending")
      _ => false
    })
    && (match continuation_plan(obs: Present { value: active }) {
      AlreadyRunning { reason, attempt_key: _ } => reason.contains("running")
      _ => false
    })
    && (match continuation_plan(obs: Present { value: refused }) {
      AlreadyRunning { reason, attempt_key: _ } => reason.contains("environment fact") && reason.contains("retries")
      _ => false
    })
    && (match continuation_plan(obs: Present { value: stopped }) {
      Refuse { reason: _ } => true
      _ => false
    })
}
