module test.claim.roadmap.roadmap_attempt_continuation_witness

import std.types { Bool, String, Int }
import gunbc.roadmap.roadmap_attempt_continuation {
  PriorAttemptFacts,
  ContinuationDecision, ContinuationSpawnFresh, ContinuationRefused, ContinuationHold, ContinuationComplete, ContinuationEnded,
  continuation_decision,
}
import gunbc.harness.harness_session_recovery { SessionRecoveryNone }
import gunbc.roadmap.roadmap_submission {
  WorkerSubmission, SubmissionReady, SubmissionBlocked, SubmissionNeedsContext,
  SubmissionCapture, submission_digest, SubmissionCaptureRootBound,
  SubmissionCaptureObservation,
  CaptureForHead, CaptureAbsent, CaptureUnreadable,
}
import gunbc.roadmap.roadmap_workflow_stage {
  WorkflowSegment, WorkflowSegmentKind, WorkflowSegmentState, VerificationWorkflowSegment, ReviewWorkflowSegment, GoalAuditWorkflowSegment,
  WorkflowSegmentFailed, WorkflowSegmentComplete, WorkflowSegmentPending,
  WorkflowSegmentActive, WorkflowSegmentRefused, WorkflowSegmentStopped,
}

fn pri(
  capture: SubmissionCaptureObservation,
  verification: WorkflowSegment?,
  review: WorkflowSegment?,
  goal_audit: WorkflowSegment?,
) -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: "n1",
    attempt_key: "a1",
    branch: "roadmap/n1/a1",
    worker_terminal: true,
    capture: capture,
    verification: verification,
    review: review,
    goal_audit: goal_audit,
    recovery: SessionRecoveryNone,
  }
}

fn capture_for(submission: WorkerSubmission) -> CaptureForHead {
  CaptureForHead {
    capture: SubmissionCapture {
      head_sha: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      scm_repository: "/instance/attempt-state/projects/n1.gunbc-repository.json",
      scm_commit_ordinal: 3,
      scm_root_locator: SubmissionCaptureRootBound { locator: "0123456789abcdef" },
      digest: submission_digest(submission: submission),
      submission: submission,
      handin: none,
    },
  }
}

fn ready_capture() -> CaptureForHead {
  capture_for(submission: WorkerSubmission {
    readiness: SubmissionReady,
    explanation: "implemented the change and ran the acceptance route",
    limitations: "no soak",
  })
}

fn segment(kind: WorkflowSegmentKind, state: WorkflowSegmentState, detail: String) -> WorkflowSegment? {
  Present { value: WorkflowSegment { kind: kind, state: state, detail: detail } }
}

fn ended_with(decision: ContinuationDecision, pattern: String) -> Bool {
  match decision {
    ContinuationEnded { reason } => reason.contains(pattern) && reason.contains("roadmap/n1/a1") && reason.contains("no attempt is started over it")
    _ => false
  }
}

test fn no_prior_attempt_starts_fresh() -> Bool {
  match continuation_decision(prior: none) {
    ContinuationSpawnFresh { reason: _ } => true
    _ => false
  }
}

// A JUDGED CANDIDATE THAT FAILS ENDS ITS LINEAGE AT EVERY STAGE, with the judgement's located reason
// and the branch its work stays on -- never a fresh start over committed work, and never a new
// attempt continuing it (gunbc.plans.harness_session_lifecycle, slice S1).
test fn a_failed_judgement_ends_the_lineage_at_every_stage() -> Bool {
  let verify_red = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentFailed, detail: "sandbox render red at roadmap_sandbox.dag"), review: none, goal_audit: none)
  let green = segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "2 validations")
  let review_red = pri(capture: ready_capture(), verification: green, review: segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentFailed, detail: "dag/a.dag: the arm is missing"), goal_audit: none)
  let approved = segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved")
  let audit_red = pri(capture: ready_capture(), verification: green, review: approved, goal_audit: segment(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentFailed, detail: "the contract's red control is absent"))
  ended_with(decision: continuation_decision(prior: Present { value: verify_red }), pattern: "verification failed: sandbox render red")
    && ended_with(decision: continuation_decision(prior: Present { value: review_red }), pattern: "review requested changes: dag/a.dag: the arm is missing")
    && ended_with(decision: continuation_decision(prior: Present { value: audit_red }), pattern: "goal audit requested changes: the contract's red control is absent")
}

test fn a_fully_approved_lineage_is_complete_and_spawns_nothing() -> Bool {
  let green = pri(
    capture: ready_capture(),
    verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "2 validations"),
    review: segment(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"),
    goal_audit: segment(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"),
  )
  match continuation_decision(prior: Present { value: green }) {
    ContinuationComplete { reason } => reason.contains("the lineage is complete")
    _ => false
  }
}

// A WORKER THAT STOPPED WITHOUT A CANDIDATE ENDS THE LINEAGE: no capture, a declared blocker, or a
// declared need for context each carry their account, bounded, and none of them starts over.
test fn an_end_without_a_candidate_ends_the_lineage_with_its_account() -> Bool {
  let pending = segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "awaiting")
  let yielded = pri(capture: CaptureAbsent, verification: pending, review: none, goal_audit: none)
  let blocked = pri(
    capture: capture_for(submission: WorkerSubmission { readiness: SubmissionBlocked, explanation: "the acceptance run was still in flight", limitations: "acceptance unconfirmed" }),
    verification: pending, review: none, goal_audit: none,
  )
  let needs = pri(
    capture: capture_for(submission: WorkerSubmission { readiness: SubmissionNeedsContext, explanation: "the contract does not say which artifact the lane renders", limitations: "" }),
    verification: pending, review: none, goal_audit: none,
  )
  ended_with(decision: continuation_decision(prior: Present { value: yielded }), pattern: "without handing in a candidate")
    && ended_with(decision: continuation_decision(prior: Present { value: blocked }), pattern: "declared blocked: the acceptance run was still in flight")
    && ended_with(decision: continuation_decision(prior: Present { value: needs }), pattern: "declared needs-context: the contract does not say which artifact the lane renders")
}

// THE ACCOUNT IS BOUNDED: an unbounded explanation is cut, and the cut is marked.
test fn a_long_explanation_is_cut_and_marked() -> Bool {
  let ten = "0123456789"
  let long = join([ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten, ten], "")
  let blocked = pri(
    capture: capture_for(submission: WorkerSubmission { readiness: SubmissionBlocked, explanation: long, limitations: "" }),
    verification: none, review: none, goal_audit: none,
  )
  match continuation_decision(prior: Present { value: blocked }) {
    ContinuationEnded { reason } => reason.contains(" ...") && string_length(s: reason) < string_length(s: long) + 300
    _ => false
  }
}

// RED CONTROL: a ready capture is a candidate, and a candidate is verification's to judge -- the
// decision HOLDS (the belt owes the verification) and never ends or restarts the lineage past an
// unjudged candidate.
test fn a_ready_candidate_holds_for_verification() -> Bool {
  let p = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "awaiting"), review: none, goal_audit: none)
  match continuation_decision(prior: Present { value: p }) {
    ContinuationHold { reason } => reason.contains("still pending")
    _ => false
  }
}

test fn an_unreadable_capture_refuses_with_its_reason() -> Bool {
  let p = pri(capture: CaptureUnreadable { reason: "the capture directory could not be listed" }, verification: none, review: none, goal_audit: none)
  match continuation_decision(prior: Present { value: p }) {
    ContinuationRefused { reason } => reason.contains("the capture directory could not be listed") && reason.contains("does not guess")
    _ => false
  }
}

fn running_prior() -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: "n1",
    attempt_key: "a1",
    branch: "roadmap/n1/a1",
    worker_terminal: false,
    capture: CaptureAbsent,
    verification: none,
    review: none,
    goal_audit: none,
    recovery: SessionRecoveryNone,
  }
}

// AN ACTIVE WORKER IS A HOLD: no spawn arm, and no end, is reachable from a running worker.
test fn a_running_worker_holds_and_never_spawns_fresh() -> Bool {
  match continuation_decision(prior: Present { value: running_prior() }) {
    ContinuationHold { reason } => reason.contains("has not ended")
    _ => false
  }
}

// VERIFICATION OWNED BY THE BELT HOLDS THE LINEAGE: absent, pending, and active segments are the
// belt's outstanding obligation; a refused verification is an environment fact and the obligation
// stays outstanding with the retry named; a stopped segment is a state verification does not
// inhabit and refuses.
test fn verification_owed_pending_active_hold_and_refused_retries_while_stopped_refuses() -> Bool {
  let owed = pri(capture: ready_capture(), verification: none, review: none, goal_audit: none)
  let pending = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "awaiting"), review: none, goal_audit: none)
  let active = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentActive, detail: "running"), review: none, goal_audit: none)
  let refused = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentRefused, detail: "toolchain missing"), review: none, goal_audit: none)
  let stopped = pri(capture: ready_capture(), verification: segment(kind: VerificationWorkflowSegment, state: WorkflowSegmentStopped, detail: "stopped"), review: none, goal_audit: none)
  (match continuation_decision(prior: Present { value: owed }) {
    ContinuationHold { reason } => reason.contains("verification is owed")
    _ => false
  })
    && (match continuation_decision(prior: Present { value: pending }) {
      ContinuationHold { reason } => reason.contains("still pending")
      _ => false
    })
    && (match continuation_decision(prior: Present { value: active }) {
      ContinuationHold { reason } => reason.contains("running")
      _ => false
    })
    && (match continuation_decision(prior: Present { value: refused }) {
      ContinuationHold { reason } => reason.contains("environment fact") && reason.contains("retries")
      _ => false
    })
    && (match continuation_decision(prior: Present { value: stopped }) {
      ContinuationRefused { reason } => reason.contains("does not inhabit")
      _ => false
    })
}
