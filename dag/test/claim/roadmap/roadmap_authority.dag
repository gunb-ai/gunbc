fn nodes() -> List<RoadmapNode> { declared_roadmap_nodes() }
fn edges() -> List<RoadmapEdge> { declared_roadmap_edges() }
fn active_nodes() -> List<RoadmapNode> {
  match active_roadmap_nodes_projection() {
    ActiveRoadmapNodesProjectionRefused { detail: _ } => []
    ActiveRoadmapNodesProjected { nodes: nodes } => nodes
  }
}
fn active_edges() -> List<RoadmapEdge> {
  match active_roadmap_edges_projection() {
    ActiveRoadmapEdgesProjectionRefused { detail: _ } => []
    ActiveRoadmapEdgesProjected { edges: edges } => edges
  }
}

fn live_accepted_node_ids() -> List<RoadmapNodeId>? {
  match frontier_sets_projection(
    history: roadmap_acceptance_event_history_load(), retired: roadmap_retired_node_ids_load(),
  ) {
    FrontierSetsProjected { accepted: ids, withheld: _ } => Present { value: ids }
    FrontierSetsProjectionRefused { detail: _ } => Absent
  }
}

fn live_withheld_node_ids() -> List<RoadmapNodeId>? {
  match withheld_node_ids_projection(
    history: roadmap_acceptance_event_history_load(), retired: roadmap_retired_node_ids_load(),
  ) {
    WithheldNodeIdsProjected { ids: ids } => Present { value: ids }
    WithheldNodeIdsProjectionRefused { detail: _ } => Absent
  }
}

fn tnid(s: String) -> RoadmapNodeId { s }
fn tchash(s: String) -> Fnv1a64Structural { content_hash_atom(value: s as NonEmptyStr) }

fn digest_or_zero(rn: RoadmapNode) -> Fnv1a64Structural {
  match node_criteria_digest(rn: rn) {
    Present { value } => value
    Absent => tchash(s: "0000000000000000")
  }
}

fn declared_node(id: String) -> List<RoadmapNode> {
  nodes() |> filter(n => n.node == id)
}

fn receipt_fixture(node: String, digest: Fnv1a64Structural) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: tnid(s: node),
    criteria_digest: digest,
    red_control: RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn evidenceless_receipt_fixture(rn: RoadmapNode) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: RedControlNotRun,
    handback: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn undelivered_receipt_fixture(rn: RoadmapNode) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackNotDelivered,
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

// ─── THE HERMETIC SCENARIO ───────────────────────────────────────────────────
// WHY THIS EXISTS. Twenty-two of these witnesses were UNOBSERVED, and one refusal explained all of
// them: the only way to an acceptance history was the LIVE load, which walks the event directory
// through Filesystem.List, and the hermetic floor has no arm for that effect (claim_batch is hermetic
// by default; publishing a Filesystem.List mock would FABRICATE the log this ledger's authority rests
// on — the floor refuses it precisely so no witness can invent a history). So each witness now states
// the scenario its own property is about: the events that scenario needs, spelled by the log's own
// emitter, decoded back by the reader's own decoder, and folded by the same fold the live load uses.
// Nothing is stubbed and nothing is shared — 21 scenarios for 21 witnesses, because a witness is
// answerable for the property it names (gunbc.design_argument::witness_is_the_unit_of_change), and a
// shared mega-fixture would be a second home for the acceptance facts (single_authority).
//
// A scenario is not a substitute for the real route. Two witnesses keep it: the committed fixture, read
// by roadmap_events_read_dir so the actual directory walk runs through the checkout carve-out, and the
// same-reader witness that holds the live and committed routes to one reader.

// The scenario's principal. It names an operator, never impersonates one: the subject is legibly a
// fixture, so no scenario byte can be read as a real person's acceptance.
fn scenario_principal() -> EventPrincipalAuthenticated {
  EventPrincipalAuthenticated { ref: PrincipalRef {
    authority: "google-oidc" as NonEmptyStr,
    namespace: "accounts" as NonEmptyStr,
    subject: "sub-roadmap-authority-scenario" as NonEmptyStr,
  } }
}

// THE RECEIPT THE FOLD WILL ADMIT: the node's own criteria digest, a red control executed, a handback
// delivered. A receipt missing any of those is DROPPED by the fold, which is the point — a witness that
// asserts a node was accepted has to spell an acceptance the log would actually honour, not merely say
// so. The digest comes from the DECLARED node, so a scenario cannot accept a node on terms the model
// does not state; a node the model does not declare gets a digest no receipt can match, and stays absent.
fn scenario_digest(id: RoadmapNodeId) -> Fnv1a64Structural {
  match first(nodes() |> filter(n => n.node == id)) {
    Absent => tchash(s: "0000000000000000")
    Present { value: n } => digest_or_zero(rn: n)
  }
}

fn scenario_receipt(id: RoadmapNodeId) -> RoadmapAcceptanceReceipt {
  receipt_fixture(node: id as String, digest: scenario_digest(id: id))
}

// THE ACCEPTANCE WAS EARNED BY A PULL REQUEST, legibly the scenario's: a real url, merge time and head,
// and a url whose number cannot be read as anybody's work. The other evidence case (no pull request at
// all) is a CLOSED SET keyed by the receipt's own bytes, so a scenario could not argue into it even if
// it wanted to — which is exactly why the scenarios do not want to.
fn scenario_evidence() -> AcceptancePrEvidence {
  EarnedByPullRequest {
    pr_url: "https://github.com/gunb-ai/gunbc/pull/0" as NonEmptyStr,
    merged_at: "2026-11-18T00:00:00Z" as NonEmptyStr,
    head_sha: "0000000000000000000000000000000000000000" as NonEmptyStr,
  }
}

fn scenario_acceptance_kind(id: RoadmapNodeId) -> RoadmapEventKind {
  RoadmapEventKind.AcceptanceRecordedEvent { receipt: scenario_receipt(id: id), evidence: scenario_evidence() }
}

fn scenario_revocation_kind(id: RoadmapNodeId, disposition: AcceptanceRevocationDisposition) -> RoadmapEventKind {
  RoadmapEventKind.AcceptanceRevokedEvent {
    receipt: scenario_receipt(id: id),
    disposition: disposition,
    revoked_by: "operator" as NonEmptyStr,
    revoked_on: "2026-11-18",
    reason: "the scenario took the acceptance back" as NonEmptyStr,
    exact_prior_receipt: scenario_receipt(id: id),
  }
}

// ONE SCENARIO EVENT. Every scenario event is recorded at the same instant, so an ordering a witness
// cares about is always the chain — the parent an event names — never a timestamp nobody read.
fn scenario_event(node: RoadmapNodeId, parent: RoadmapEventId?, kind: RoadmapEventKind) -> RoadmapEvent {
  RoadmapEvent {
    node: node, author: scenario_principal(), parent: parent, kind: kind,
    recorded_at: "2026-11-18T00:00:00Z",
  }
}

// ONE NODE'S CHAIN, parent-threaded. A second event that does not name its predecessor's id is a fork,
// and a forked chain refuses the whole fold — so a scenario with more than one event per node goes
// through here rather than hand-numbering ids nobody can check.
fn scenario_chain(node: RoadmapNodeId, kinds: List<RoadmapEventKind>) -> List<RoadmapEvent> {
  scenario_chain_after(node: node, kinds: kinds, after: Absent)
}

fn scenario_chain_after(node: RoadmapNodeId, kinds: List<RoadmapEventKind>, after: RoadmapEvent?) -> List<RoadmapEvent> {
  match first(kinds) {
    Absent => []
    Present { value: k } => {
      let e = scenario_event(
        node: node,
        parent: match after {
          Absent => Absent
          Present { value: p } => Present { value: roadmap_event_id(e: p) }
        },
        kind: k,
      )
      concat([e], scenario_chain_after(node: node, kinds: kinds.skip(n: 1), after: Present { value: e }))
    }
  }
}

// THE SCENARIO'S BYTES, out through the log's own emitter and back through the reader's own decoder —
// the same decoder the directory walk feeds on the live route. A scenario that spells an event the wire
// cannot carry is caught here, before any projection gets to call it a fact.
fn scenario_envelopes(label: RoadmapNodeId, events: List<RoadmapEvent>) -> List<RoadmapEventEnvelope>? {
  match roadmap_events_decode_reads(
    node: label,
    reads: map(events, e => EventFileContent { content: roadmap_event_wire_text(env: roadmap_event_envelope(e: e)) })) {
    EventsRead { envelopes: envs } => Present { value: envs }
    EventsReadRefused { node: _, step: _, reason: _ } => Absent
  }
}

// THE HISTORY THE PROJECTIONS CONSUME: the scenario's envelopes through the fold the live load uses —
// the same causal ordering, the same replay law, the same drop of a receipt whose criteria digest does
// not match its node or whose evidence was never delivered. A refusal is carried as the refusal, never
// swallowed: a scenario that cannot produce a history must make its witness red, not quietly empty.
fn scenario_history(envs: List<RoadmapEventEnvelope>) -> RoadmapAcceptanceEventHistoryLoad {
  match roadmap_operator_acceptance_history_of(envelopes: envs) {
    OperatorAcceptanceHistoryRefused { detail: d } =>
      RoadmapAcceptanceEventHistoryLoadRefused { detail: d }
    OperatorAcceptanceHistoryLoaded { events: events, replayed: _, rows: _ } =>
      RoadmapAcceptanceEventHistoryLoaded { events: events }
  }
}

// WHAT THE SCENARIO RETIRES, read off the same envelopes by the same law.
fn scenario_retired(envs: List<RoadmapEventEnvelope>) -> RoadmapRetiredNodeIds {
  roadmap_retired_node_ids_of(envs: envs)
}

fn scenario_frontier(envs: List<RoadmapEventEnvelope>) -> FrontierSetsProjection {
  frontier_sets_projection(history: scenario_history(envs: envs), retired: scenario_retired(envs: envs))
}

fn scenario_accepted(envs: List<RoadmapEventEnvelope>) -> List<RoadmapNodeId> {
  match scenario_frontier(envs: envs) {
    FrontierSetsProjected { accepted: accepted, withheld: _ } => accepted
    FrontierSetsProjectionRefused { detail: _ } => []
  }
}

fn scenario_withheld(envs: List<RoadmapEventEnvelope>) -> List<RoadmapNodeId> {
  match scenario_frontier(envs: envs) {
    FrontierSetsProjected { accepted: _, withheld: withheld } => withheld
    FrontierSetsProjectionRefused { detail: _ } => []
  }
}

// THE HISTORY AS A LIST, for the witnesses that inspect receipts one by one. A refused fold answers the
// empty list here because every caller of this one asserts about members it found; the refusal still
// reaches a witness that asks for it, through scenario_history directly.
fn scenario_event_history(envs: List<RoadmapEventEnvelope>) -> List<RoadmapAcceptanceEvent> {
  match scenario_history(envs: envs) {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => events
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

// THE AUTHORITY OVER A SCENARIO: the projection the live route would render, driven by the scenario's
// own history and retirements instead of a directory walk.
fn scenario_authority(envs: List<RoadmapEventEnvelope>) -> RoadmapAuthorityProjection {
  roadmap_authority_projection(history: scenario_history(envs: envs), retired: scenario_retired(envs: envs))
}

// THE CLOSING-CONTRACT PAIRS OVER A SCENARIO, in the carrier the probe counts want.
fn scenario_pairs(envs: List<RoadmapEventEnvelope>) -> ClosingContractTaskPairsProjection {
  ClosingContractTaskPairsProjected {
    pairs: closing_contract_task_pairs_for_accepted(
      accepted: scenario_accepted(envs: envs), withheld: scenario_withheld(envs: envs)),
  }
}

// THE ACTIVE FRONTIER OVER A SCENARIO — the same projection the live route renders, with the scenario's
// accepted/withheld sets where the live route would have put the directory walk's.
fn scenario_active_nodes(envs: List<RoadmapEventEnvelope>) -> List<RoadmapNode> {
  active_roadmap_nodes_for_accepted(accepted: scenario_accepted(envs: envs), withheld: scenario_withheld(envs: envs))
}

fn scenario_active_edges(envs: List<RoadmapEventEnvelope>) -> List<RoadmapEdge> {
  active_roadmap_edges_for_accepted(accepted: scenario_accepted(envs: envs), withheld: scenario_withheld(envs: envs))
}

fn scenario_active_id_exists(envs: List<RoadmapEventEnvelope>, id: RoadmapNodeId) -> Bool {
  scenario_active_nodes(envs: envs) |> any(n => n.node == id)
}

fn id_exists(id: RoadmapNodeId) -> Bool {
  nodes() |> any(n => n.node == id)
}

fn id_count(id: RoadmapNodeId) -> Int {
  nodes() |> filter(n => n.node == id) |> count
}

fn active_id_exists(id: RoadmapNodeId) -> Bool {
  active_nodes() |> any(n => n.node == id)
}

fn edge_exists(child: String, parent: String) -> Bool {
  edges() |> any(e => e.child == child && e.parent == parent)
}

fn node_has_carrier_path(path: String) -> Bool {
  nodes() |> any(n => n.carriers |> any(p => p.path == path))
}

fn node_count_with_carrier_path(path: String) -> Int {
  nodes() |> filter(n => n.carriers |> any(p => p.path == path)) |> count
}

fn mechanical_graph() -> CallGraph {
  CallGraph {
    edges: edges() |> map(e => GraphEdge {
      caller: e.parent as String,
      callee: e.child as String,
    }),
  }
}

fn node_names() -> List<String> {
  nodes() |> map(n => n.node as String)
}

fn ticket_fields_complete(ticket: TicketFields) -> Bool {
  !(ticket.headline == "")
        && !(ticket.brief == "")
        && !(ticket.displaced_cost == "")
        && !(ticket.current_state == "")
        && !(ticket.first_slice == "")
        && !(ticket.red_control == "")
        && !(ticket.out_of_scope == "")
        && !(ticket.handback == "")
}

fn active_node_admissible(n: RoadmapNode) -> Bool {
  !item_is_done(item: n.line, merged: [])
    && match line_ticket(item: n.line) {
      Present { value } => ticket_fields_complete(ticket: value)
      Absent => false
    }
    && count(n.carriers) > 0
    && !(n.owner == "")
    && match n.dispatch {
      Dispatchable { repo, acceptance } =>
        repo == "gunbc" && acceptance == ManualAcceptance
      NotDispatchable => true
  }
}

fn red_fixture(line: RoadmapItem) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_8E5PG4F7CAZ148VZ8MNY" as RoadmapNodeIdentity,
    node: "red-fixture",
    line: line,
    carriers: [Pointer { label: "authority", path: "DESIGN.md" }],
    dispatch: Dispatchable {
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: "roadmap-authority",
    parent: none,
    centering: none,
  }
}

// THE RETIRED SET THIS FILE REASONS ABOUT. A retirement is a Retired event in the roadmap event log
// (operator ruling gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08, step 1), so
// a witness states which nodes it assumes retired rather than reading it off a row. These are the two
// nodes step 1(a) retires in the live log; production reads the same set through
// gunbc.roadmap.roadmap_authority roadmap_retired_node_ids_load, which refuses rather than guess.
fn fixture_retired_node_ids() -> List<RoadmapNodeId> {
  [tnid(s: "entry-graph-union-construction"), tnid(s: "shell-dag-floor-peak-calibration-rows")]
}

fn red_ticket() -> RoadmapItem {
  TicketLine {
    ticket: TicketFields {
      headline: "planted completed-row RED",
      brief: "Every required field is populated so only the forbidden completion or acceptance state can reject this fixture.",
      displaced_cost: "none",
      current_state: "fixture",
      first_slice: "fixture",
      red_control: "fixture",
      out_of_scope: "fixture",
      handback: "fixture",
      updates: [],
      authored_on: "",
      last_verified_on: "",
    },
  }
}

test fn witness_declared_graph_has_justified_size() -> Bool {
  // THE SCENARIO: nothing accepted, nothing withdrawn — the frontier is the declared graph itself. This
  // witness asks whether a graph of this size is justified and whether the note names the lane; the live
  // event log has no bearing on either, so it is not read.
  match scenario_envelopes(label: "declared-graph-has-justified-size", events: []) {
    Absent => false
    Present { value: envs } =>
      count(nodes()) > 0 && count(edges()) > 0
        && count(scenario_active_nodes(envs: envs)) > 0 && count(scenario_active_edges(envs: envs)) > 0
  }
}

test fn witness_declared_node_ids_are_unique() -> Bool {
  all(nodes(), n => id_count(id: n.node) == 1)
}

test fn witness_every_edge_endpoint_exists() -> Bool {
  all(edges(), e => id_exists(id: e.child) && id_exists(id: e.parent))
}

test fn witness_declared_graph_is_mechanically_acyclic() -> Bool {
  all(edges(), e => !(e.parent == e.child))
    && !graph_has_multi_node_scc(names: node_names(), graph: mechanical_graph())
}

// Every declared TICKET row is a complete, unsigned, open ticket with a carrier and an owner; a
// sized row is sized for this repository with manual acceptance, and an unsized row is simply not
// ready (gunbc.roadmap.roadmap_readiness). The one superseded history row carries no ticket and is
// outside this population by construction of its line.
test fn witness_every_declared_row_is_complete_unsigned_ticket() -> Bool {
  all(nodes() |> filter(n => match line_ticket(item: n.line) { Present { value: _ } => true  Absent => false }), n => active_node_admissible(n: n))
}

data live_state_count_transcription_note: String = "NO LIVE-STATE COUNT PINS IN THIS FILE, deliberately, and the deleted ones are named so the class does not creep back. Removed: `count(accepted) == 8` here, and `\"63 declared · 8 accepted · 55 active\"` in test.claim.long.roadmap_page_witness. Both TRANSCRIBED a number nobody decided — they mirrored whatever the live authority happened to hold, so authoring any correct roadmap row redded them (observed twice; the second was PR #7463, whose only content was two new rows). A pin like that reports 'the roadmap changed', which is not a defect, while the reviewer's habit becomes editing the number to match — a check satisfied by editing the declaration, which gunbc.design_argument::fail_closed names as the tell that validation stood where construction was available. THE DISTINCTION THAT DECIDES WHETHER A COUNT MAY STAY: does the number come from a fixture the test CONSTRUCTS, or from live corpus state? test.claim.roadmap.roadmap_altitude_witness renders `doc_html(nodes: [done_signed_node(), open_node()])` and asserts `1 open · 1 done` — that is the renderer computing from two known inputs, so it is a specification and it stays; deleting it would remove real coverage. Same for the observation render witnesses over replayed fixture blocks, and for structural counts that encode a design fact rather than a population (two workflow lamps, three static routes). WHAT SURVIVED THE DELETION HERE, and why nothing was lost: this witness's actual invariant is the RELATIONSHIP `count(active_nodes()) == count(nodes()) - count(accepted)`, which is magnitude-independent and still asserted; the eight per-id acceptance assertions also stay, because they pin WHICH acceptances exist and a dropped one is real history loss (scm_prerequisite_acceptance_note). Only the magnitude went. Replacing it with `string_contains(page, roadmap_counts_label())` was considered and rejected as the vacuous form — both sides derive from the same function, so it asserts the page contains what the page computed (operator ruling 2026-07-30: no vacuous or tautological testing)."

test fn witness_active_set_is_declared_minus_accepted() -> Bool {
  // THE SCENARIO: the ten acceptances this witness names, each spelled as the log spells one. They are
  // real declared rows carrying real receipts, so the fold admits them or this witness reddes — which is
  // what keeps the per-id assertions honest now that no directory walk stands behind them. What stays
  // asserted is the RELATIONSHIP this witness is actually for (see live_state_count_transcription_note):
  // active == declared minus accepted minus withheld, with nothing accepted or withheld left inside.
  let wanted = [
    tnid(s: "namespace-occurrence-transport"),
    tnid(s: "pderive-typesafe-nullary-reflection"),
    tnid(s: "pderive-static-supplemental-contract"),
    tnid(s: "v1-test-hygiene-producer-retirement"),
    tnid(s: "2-scm-git-upstream-model"),
    tnid(s: "2-scm-mercurial-upstream-model"),
    tnid(s: "2-scm-pijul-upstream-model"),
    tnid(s: "2-claim-indexed-evidence"),
    tnid(s: "2-scm-compatibility-shape"),
    tnid(s: "2-scm-p0-landing-spine"),
  ]
  match scenario_envelopes(
    label: "active-set-is-declared-minus-accepted",
    events: map(wanted, id => scenario_event(node: id, parent: Absent, kind: scenario_acceptance_kind(id: id)))) {
    Absent => false
    Present { value: envs } => {
      let accepted = scenario_accepted(envs: envs)
      let withheld = scenario_withheld(envs: envs)
      all(wanted, w => accepted |> any(a => a == w))
        && count(active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld))
          == count(nodes()) - count(accepted) - count(withheld)
        && all(active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld),
          n => !(accepted |> any(a => a == n.node)))
        && all(active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld),
          n => !(withheld |> any(w => w == n.node)))
        && all(accepted, a => id_exists(id: a))
    }
  }
}

// ─── THE COMMITTED FIXTURE ───────────────────────────────────────────────────
// A SMALL LOG ON DISK, checked in under the checkout root, so the REAL Filesystem.List walk runs once
// through the floor's checkout carve-out rather than being mocked. Its bytes are THIS table rendered by
// the log's own emitter: gunbc.roadmap.roadmap_authority_fixture_gen writes them, and
// witness_acceptance_receipts_are_valid_and_unique re-encodes every file and reddens on a byte of drift,
// so the fixture cannot rot away from the encoder it was generated with.
//
// Regenerate (from a checkout, wet lane — it is the only lane that may write):
//   mkdir -p fixtures/roadmap_authority/events/{namespace-occurrence-transport,2-scm-git-upstream-model,roadmap-authority-scenario-absent-node}
//   claim_batch --source-root dag --source-root src/v1 --source-root src/v2 \
//     --entry dag/test/claim/roadmap/roadmap_authority.dag --wet \
//     --functions roadmap_authority_fixture_emit
data roadmap_authority_fixture_root: String = "fixtures/roadmap_authority/events"
data roadmap_authority_fixture_worktree: String = "fixtures/roadmap_authority"

type RoadmapAuthorityFixtureFile {
  node: RoadmapNodeId
  name: String
  event: RoadmapEvent
}

// THE ROW THE AUTHORITY DOES NOT DECLARE. The fixture carries an acceptance for it precisely so the
// fail-closed path is exercised by the committed route, not argued about: a log may name a node the
// plan has never heard of, and nothing may be admitted on it — and nothing may crash on it either.
fn roadmap_authority_fixture_absent_node() -> RoadmapNodeId {
  tnid(s: "roadmap-authority-scenario-absent-node")
}

fn roadmap_authority_fixture_files() -> List<RoadmapAuthorityFixtureFile> {
  let accepted_row = tnid(s: "namespace-occurrence-transport")
  let superseded_row = tnid(s: "2-scm-git-upstream-model")
  let absent_row = roadmap_authority_fixture_absent_node()
  let opening = scenario_event(node: accepted_row, parent: Absent, kind: scenario_acceptance_kind(id: accepted_row))
  let granted = scenario_event(node: superseded_row, parent: Absent, kind: scenario_acceptance_kind(id: superseded_row))
  let taken_back = scenario_event(
    node: superseded_row,
    parent: Present { value: roadmap_event_id(e: granted) },
    kind: scenario_revocation_kind(id: superseded_row, disposition: AcceptanceNodeRemainsSuperseded {}),
  )
  let ended = scenario_event(
    node: superseded_row,
    parent: Present { value: roadmap_event_id(e: taken_back) },
    kind: RoadmapEventKind.Retired { reason: "the scenario closed the node" as NonEmptyStr },
  )
  // The absent row is given a digest copied from a DECLARED row, so the only thing wrong with it is the
  // thing under test: the authority does not declare the node the receipt is about.
  let borrowed = scenario_receipt(id: accepted_row)
  let stranger = scenario_event(
    node: absent_row,
    parent: Absent,
    kind: RoadmapEventKind.AcceptanceRecordedEvent {
      receipt: RoadmapAcceptanceReceipt {
        node: absent_row,
        criteria_digest: borrowed.criteria_digest,
        red_control: borrowed.red_control,
        handback: borrowed.handback,
        accepted_by: borrowed.accepted_by,
        accepted_on: borrowed.accepted_on,
      },
      evidence: scenario_evidence(),
    },
  )
  [
    RoadmapAuthorityFixtureFile { node: accepted_row, name: "01-acceptance.json", event: opening },
    RoadmapAuthorityFixtureFile { node: superseded_row, name: "01-acceptance.json", event: granted },
    RoadmapAuthorityFixtureFile { node: superseded_row, name: "02-revocation.json", event: taken_back },
    RoadmapAuthorityFixtureFile { node: superseded_row, name: "03-retired.json", event: ended },
    RoadmapAuthorityFixtureFile { node: absent_row, name: "01-acceptance.json", event: stranger },
  ]
}

// THE BYTES THE GENERATOR WRITES, in one place so the witness and the generator cannot disagree.
fn roadmap_authority_fixture_bytes(f: RoadmapAuthorityFixtureFile) -> String {
  roadmap_event_wire_text(env: roadmap_event_envelope(e: f.event))
}

fn roadmap_authority_fixture_path(f: RoadmapAuthorityFixtureFile) -> String {
  join([roadmap_authority_fixture_root, "/", f.node as String, "/", f.name], "")
}

// THE WRITE, wet lane only. It exists so the committed fixture is produced by the encoder rather than
// transcribed by hand; the witness re-encodes every file, so an edit here without a regeneration reddens.
fn roadmap_authority_fixture_emit() -> Bool {
  all(roadmap_authority_fixture_files(), f => {
    let w = Filesystem.Write(path: roadmap_authority_fixture_path(f: f), content: roadmap_authority_fixture_bytes(f: f))
    w.success
  })
}

// THE FIXTURE AS THE READER SEES IT: the committed route, the real directory walk, the real decode.
fn roadmap_authority_fixture_envelopes() -> List<RoadmapEventEnvelope>? {
  match roadmap_events_read_dir(dir: roadmap_authority_fixture_root) {
    AllEventsRead { envelopes: envs } => Present { value: envs }
    AllEventsReadRefused { step: _, reason: _ } => Absent
  }
}

// THE SAME DIRECTORY THROUGH THE LIVE ROUTE: the live route builds its own path out of the layout and
// calls the same one reader. Aimed at the fixture it must answer identically.
fn roadmap_authority_fixture_live_route_envelopes() -> List<RoadmapEventEnvelope>? {
  match roadmap_events_read_all_synced(layout: RoadmapEventCarrierLayout {
    repo_root: roadmap_authority_fixture_worktree,
    worktree: roadmap_authority_fixture_worktree,
    git_program: "git",
    directory_program: "install",
    remote: "origin",
  }) {
    AllEventsRead { envelopes: envs } => Present { value: envs }
    AllEventsReadRefused { step: _, reason: _ } => Absent
  }
}

// THE LOG'S OWN RETIRED SET, read off the fixture rather than assumed.
fn roadmap_authority_fixture_retired(envs: List<RoadmapEventEnvelope>) -> List<RoadmapNodeId> {
  match roadmap_retired_node_ids_of(envs: envs) {
    RetiredNodeIdsLoaded { ids: ids } => ids
    RetiredNodeIdsRefused { detail: _ } => []
  }
}

test fn witness_acceptance_receipts_are_valid_and_unique() -> Bool {
  // THE COMMITTED ROUTE, END TO END: the real Filesystem.List walk over the checked-in fixture, the real
  // decode, the real fold — then the claim this witness is for, that the log's receipts are valid and
  // one-per-node. The fixture deliberately also carries a row the authority does not declare; that row
  // is the fail-closed half of the claim, and it is answered with types, never a crash.
  match roadmap_authority_fixture_envelopes() {
    Absent => false
    Present { value: envs } => {
      // NO DRIFT FROM THE ENCODER: every committed file re-encoded from the table above must be byte
      // for byte the file on disk. A hand-edit here reddens before any projection is consulted.
      all(roadmap_authority_fixture_files(), f => {
        let r = Filesystem.Read(path: roadmap_authority_fixture_path(f: f))
        r.success && r.content == roadmap_authority_fixture_bytes(f: f)
      })
      && match roadmap_acceptance_receipts(history: scenario_history(envs: envs)) {
        RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
        RoadmapAcceptanceReceiptsProjected { receipts: receipts } => {
          let declared_receipts = receipts |> filter(r => id_exists(id: r.node))
          let absent_receipts = receipts |> filter(r => !id_exists(id: r.node))
          count(declared_receipts) > 0
            && all(declared_receipts, r => count(declared_receipts |> filter(x => x.node == r.node)) == 1)
            && all(declared_receipts, r => all(declared_node(id: r.node as String), n =>
              match receipt_node_match_verdict(r: r, rn: n, retired: fixture_retired_node_ids()) {
                ReceiptMatchesNode => true
                LiveReceiptOnRetiredNode { node: _ } => false
                ReceiptDoesNotMatchNode => false
              }
            ))
            // THE ABSENT ROW IS IN THE LOG AND ANSWERS WITH NOTHING ADMITTED.
            && count(absent_receipts) == 1
            && all(absent_receipts, r => !id_exists(id: r.node))
            && !scenario_active_id_exists(envs: envs, id: roadmap_authority_fixture_absent_node())
            && !(scenario_accepted(envs: envs) |> any(a => a == roadmap_authority_fixture_absent_node()))
            && !(scenario_withheld(envs: envs) |> any(w => w == roadmap_authority_fixture_absent_node()))
        }
      }
    }
  }
}

// A LIVE RECEIPT ON A NODE THE LOG HAS RETIRED REFUSES, with the node named. The receipt is the
// operator's word that the work is done; the Retired event is the operator's word that the node is
// over — and a node cannot be both, so the join says which one it refused on.
test fn witness_live_receipt_on_retired_node_refuses_with_typed_cause() -> Bool {
  let victims = declared_node(id: "entry-graph-union-construction")
  count(victims) == 1
    && all(victims, n =>
      match receipt_node_match_verdict(
        r: receipt_fixture(node: "entry-graph-union-construction", digest: tchash(s: "3502539e920d9e40")),
        rn: n,
        retired: fixture_retired_node_ids(),
      ) {
        LiveReceiptOnRetiredNode { node } => node == n.node
        ReceiptMatchesNode => false
        ReceiptDoesNotMatchNode => false
      }
    )
}

test fn witness_superseded_revocation_does_not_reopen_active_frontier() -> Bool {
  // THE SCENARIO: that node is accepted, then revoked under the disposition that leaves it superseded.
  // A revoked-but-superseded acceptance must NOT put the row back on the frontier -- it stays withheld.
  let gone = tnid(s: "entry-graph-union-construction")
  match scenario_envelopes(label: gone, events: scenario_chain(node: gone, kinds: [
    scenario_acceptance_kind(id: gone),
    scenario_revocation_kind(id: gone, disposition: AcceptanceNodeRemainsSuperseded {}),
  ])) {
    Absent => false
    Present { value: envs } =>
      !scenario_active_id_exists(envs: envs, id: gone)
        && scenario_withheld(envs: envs) |> any(w => w == gone)
  }
}

test fn witness_reopen_revocation_returns_node_to_active_frontier() -> Bool {
  // THE SCENARIO: one accepted row and one row the log says nothing about. An explicit revocation with
  // the REOPEN disposition must put the accepted row back on the frontier. The absent row is the red
  // control for the bug this witness used to carry: first(...) over a node with no receipt returned an
  // Optional, and the fold then reached for a `node` field on it and crashed the claim. The absent row
  // now answers with a Bool -- the typed refusal to claim anything about a node the log never accepted.
  let reopened_row = tnid(s: "namespace-occurrence-transport")
  let absent_row = roadmap_authority_fixture_absent_node()
  match scenario_envelopes(label: "reopen-revocation-returns-node", events: [
    scenario_event(node: reopened_row, parent: Absent, kind: scenario_acceptance_kind(id: reopened_row)),
  ]) {
    Absent => false
    Present { value: envs } => {
      let prior = scenario_event_history(envs: envs)
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: live } =>
          // AN ABSENT NODE IS ANSWERED, NOT CRASHED ON.
          match first(live |> filter(r => r.node == absent_row)) {
            Absent => true
            Present { value: _ } => false
          }
          && match first(live |> filter(r => r.node == reopened_row)) {
            // No receipt for a row the scenario accepted is the scenario's own bug: refuse, with a type.
            Absent => false
            Present { value: receipt } => {
              let reopened = concat(prior, [
                AcceptanceRevoked {
                  exact_prior_receipt: receipt,
                  disposition: AcceptanceNodeReopensActiveFrontier {},
                  reason: "the scenario took the acceptance back and put the row back on the plan" as NonEmptyStr,
                  revoked_by: "operator" as NonEmptyStr,
                  revoked_on: "2026-09-13" as NonEmptyStr,
                },
              ])
              match project_live_acceptance_receipts(history: reopened) {
                LiveAcceptanceReceiptsReplayRefused => false
                LiveAcceptanceReceiptsReplayed { live: reopened_live } => {
                  let accepted = declared_roadmap_nodes()
                    |> filter(n => node_accepted(receipts: reopened_live, rn: n))
                    |> map(n => n.node)
                  let withheld = node_ids_held_off_active_frontier(
                    history: reopened, retired: fixture_retired_node_ids())
                  active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld)
                    |> any(n => n.node == reopened_row)
                }
              }
            }
          }
      }
    }
  }
}

// A REVOCATION THAT LEAVES A NODE OFF THE PLAN JOINS ONLY A NODE THE LOG RETIRED. The join used to
// read `SupersededLine { by: … }` off the row; the row no longer states an ending, and the retired
// set — the log's own — is passed in, so the verdict cannot be manufactured by editing a plan row.
test fn witness_live_remains_superseded_revocations_join_retired_nodes() -> Bool {
  // THE SAME-READER WITNESS. Two routes reach the event log: the committed route names a directory and
  // the live route assembles one from the carrier layout -- and BOTH call roadmap_events_read_dir, the
  // one walk and the one decode (dag/gunbc/roadmap/roadmap_event_carrier.dag). Aimed at the same
  // directory they must answer with the same envelopes; if either route grew its own walk, or its own
  // parser, this reddens while every scenario witness above stays green. Then the join this witness is
  // named for runs over what that reader returned: a revocation that leaves a node off the plan joins
  // only a node THE LOG RETIRED, and the retired set here is the log's own, not a caller's assertion.
  let superseded_row = tnid(s: "2-scm-git-upstream-model")
  match roadmap_authority_fixture_envelopes() {
    Absent => false
    Present { value: committed } => match roadmap_authority_fixture_live_route_envelopes() {
      Absent => false
      Present { value: live } =>
        count(committed) == 5
          && live == committed
          && match remains_superseded_revocations_join(
            history: scenario_event_history(envs: live),
            nodes: declared_roadmap_nodes(),
            retired: roadmap_authority_fixture_retired(envs: live),
          ) {
            RemainsSupersededRevocationsJoined =>
              all(
                declared_node(id: "2-scm-git-upstream-model"),
                n => roadmap_node_ids_contain(
                  ids: roadmap_authority_fixture_retired(envs: live), node: n.node),
              )
            RemainsSupersededRevocationOnUnretiredNode { node: _ } => false
            RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
            RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
          }
          && !(scenario_accepted(envs: live) |> any(a => a == superseded_row))
    }
  }
}

test fn witness_remains_superseded_revocation_on_ticket_line_refuses() -> Bool {
  // THE SCENARIO: that row, accepted by the log. THE CODE PROPERTY: remains-superseded is a state an
  // OPERATOR chose, and only an explicit revocation carries that choice -- a row still standing as a
  // live ticket line must REFUSE the join, naming the node. The absent-node half is the bug this witness
  // used to have: first(...) on a row with no receipt gave an Optional and the fold reached through it
  // for a `node` field. It now answers with a type.
  let victims = declared_node(id: "namespace-occurrence-transport")
  let ticket_row = tnid(s: "namespace-occurrence-transport")
  match scenario_envelopes(label: "remains-superseded-on-ticket-line", events: [
    scenario_event(node: ticket_row, parent: Absent, kind: scenario_acceptance_kind(id: ticket_row)),
  ]) {
    Absent => false
    Present { value: scenario_envs } => {
  let prior = scenario_event_history(envs: scenario_envs)
  match project_live_acceptance_receipts(history: prior) {
    LiveAcceptanceReceiptsReplayRefused => false
    LiveAcceptanceReceiptsReplayed { live: live } => {
  match first(live |> filter(r => r.node == ticket_row)) {
    // NO RECEIPT, A TYPED REFUSAL -- never a field lookup on an Optional.
    Absent => false
    Present { value: receipt } => {
  count(victims) == 1
    && all(victims, n =>
      match n.line {
        TicketLine { ticket: _ } => true
          AuthoredLine { content: _ } => false
        PlainLine { content: _ } => false
        DerivableLine { prs: _, title: _, description: _ } => false
      }
    )
    && match remains_superseded_revocations_join(
      retired: [],
      history: concat(prior, [
        AcceptanceRevoked {
          exact_prior_receipt: receipt,
          disposition: AcceptanceNodeRemainsSuperseded {},
          reason: "fixture remains-superseded on a live ticket line must refuse" as NonEmptyStr,
          revoked_by: "operator" as NonEmptyStr,
          revoked_on: "2026-09-13" as NonEmptyStr,
        },
      ]),
      nodes: declared_roadmap_nodes(),
    ) {
      RemainsSupersededRevocationOnUnretiredNode { node } =>
        node == ticket_row
      RemainsSupersededRevocationsJoined => false
      RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
      RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
    }
    }
    }
    }
    }
    }
  }
}

test fn witness_remains_superseded_revocation_on_undeclared_node_refuses() -> Bool {
  match remains_superseded_revocations_join(
    retired: [],
    history: [
      AcceptanceRevoked {
        exact_prior_receipt: receipt_fixture(
          node: "not-a-declared-roadmap-node-for-join-red",
          digest: tchash(s: "0123456789abcdef"),
        ),
        disposition: AcceptanceNodeRemainsSuperseded {},
        reason: "fixture remains-superseded on an undeclared node must refuse" as NonEmptyStr,
        revoked_by: "operator" as NonEmptyStr,
        revoked_on: "2026-09-13" as NonEmptyStr,
      },
    ],
    nodes: declared_roadmap_nodes(),
  ) {
    RemainsSupersededRevocationOnUndeclaredNode { node } =>
      node == tnid(s: "not-a-declared-roadmap-node-for-join-red")
    RemainsSupersededRevocationsJoined => false
    RemainsSupersededRevocationOnUnretiredNode { node: _ } => false
    RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
  }
}

test fn witness_ambiguous_declared_node_refuses_remains_superseded_join() -> Bool {
  match join_remains_superseded_to_declared_node(
    node: tnid(s: "red-fixture"),
    nodes: [
      red_fixture(line: red_ticket()),
      red_fixture(line: PlainLine { content: "fixture" }),
    ],
    retired: [],
  ) {
    RemainsSupersededRevocationOnAmbiguousDeclaredNode { node } =>
      node == tnid(s: "red-fixture")
    RemainsSupersededRevocationsJoined => false
    RemainsSupersededRevocationOnUnretiredNode { node: _ } => false
    RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
  }
}

test fn witness_orphan_reopen_revocation_refuses_frontier_sets() -> Bool {
  match frontier_sets_projection(history: RoadmapAcceptanceEventHistoryLoaded { events: [
    AcceptanceRevoked {
      exact_prior_receipt: receipt_fixture(
        node: "namespace-occurrence-transport",
        digest: tchash(s: "0123456789abcdef"),
      ),
      disposition: AcceptanceNodeReopensActiveFrontier {},
      reason: "fixture orphan reopen revocation must refuse the frontier projection" as NonEmptyStr,
      revoked_by: "operator" as NonEmptyStr,
      revoked_on: "2026-09-13" as NonEmptyStr,
    },
  ] }, retired: RetiredNodeIdsLoaded { ids: [] }) {
    FrontierSetsProjectionRefused { detail } =>
      detail == "acceptance-history-unreplayable"
    FrontierSetsProjected { accepted: _, withheld: _ } => false
  }
}

// RENAMED to the law it proves. This case used to ask whether a live acceptance replayed for a node whose
// AUTHORED LINE was superseded refuses the frontier projection. There is no superseded line any more: a
// retirement is a Retired event in the roadmap event log (operator ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08), so the question is now whether a
// live acceptance replayed for a node THE LOG RETIRES refuses -- and it must, because retirement ends the
// node's story and acceptance completes it: a log holding both is contradicted, not averaged. The node is
// therefore named in the retired set the claim passes, and the refusal it must locate is the one the
// authority projection emits for that contradiction, located by node
// ('live-receipt-on-retired-node:<node>', dag/gunbc/roadmap/roadmap_authority.dag:6583-6586).
test fn witness_live_receipt_on_a_log_retired_node_refuses_frontier_sets() -> Bool {
  // THE SCENARIO: the log ACCEPTS the row and the log RETIRES it. Acceptance completes a node's story and
  // retirement ends it, so a log holding both is contradicted -- and the frontier sets refuse, naming the
  // row, rather than averaging the two. The retired set here is the carrier's own variant, not a caller's
  // assertion, which is what makes this the log-retired case rather than the caller-retired one.
  let retired_row = tnid(s: "entry-graph-union-construction")
  match scenario_envelopes(label: retired_row, events: [
    scenario_event(node: retired_row, parent: Absent, kind: scenario_acceptance_kind(id: retired_row)),
  ]) {
    Absent => false
    Present { value: envs } => match scenario_history(envs: envs) {
      RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
      RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
        match first(
          prior |> filter(e =>
            match e {
              AcceptanceRecorded { receipt: r } => r.node == retired_row
              AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
                false
            }
          ),
        ) {
          Absent => false
          Present { value: recorded } =>
            match recorded {
              AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
                false
              AcceptanceRecorded { receipt } =>
                match frontier_sets_projection(history: RoadmapAcceptanceEventHistoryLoaded { events: concat(prior, [
                  AcceptanceRecorded { receipt: receipt },
                ]) }, retired: RetiredNodeIdsLoaded {
                  ids: [retired_row],
                }) {
                  FrontierSetsProjectionRefused { detail } =>
                    detail == concat("live-receipt-on-retired-node:", "entry-graph-union-construction")
                  FrontierSetsProjected { accepted: _, withheld: _ } => false
                }
            }
        }
    }
  }
}

// CLASSIFIED LIVE/STATE, NOT CODE, and kept. What this witness asks is not what an acceptance does but
// WHICH rows have in fact been accepted -- a fact whose only home is the synced event log, reached through
// Filesystem.List, which the hermetic floor refuses and which may not be mocked (a stubbed listing would
// fabricate the log; gunbc.design_ruling::fail_closed). So it stays a wet/live witness, run by
// claim_batch --wet over this entry, and it is EXCLUDED from the hermetic set by a typed carrier rather
// than left as a silent gap: gunbc.rung_drop.roadmap_authority_accepted_parents_precede_dependents_live_state_only,
// whose restoration trigger is the capability that would bring it back -- a live-probe home for roadmap
// acceptance facts. The other fifty-one witnesses in this file carry their own events and run hermetically.
test fn witness_accepted_parents_precede_dependents() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      all(accepted, a => all(roadmap_parent_ids(edges: edges(), node: a), p => accepted |> any(x => x == p)))
  }
}

test fn witness_stale_criteria_digest_refuses_acceptance() -> Bool {
  let victims = declared_node(id: "namespace-occurrence-transport")
  count(victims) == 1
    && all(victims, n => !node_accepted(
      receipts: [receipt_fixture(node: "namespace-occurrence-transport", digest: tchash(s: "0000000000000000"))],
      rn: n,
    ))
}

test fn witness_duplicate_receipts_refuse_acceptance() -> Bool {
  // THE SCENARIO: one acceptance of one row. The log holds exactly that receipt; the row is accepted on
  // it; and the same receipt spelled TWICE accepts nothing — a node cannot be accepted twice over.
  let subject = "namespace-occurrence-transport"
  match scenario_envelopes(label: subject, events: [
    scenario_event(node: subject, parent: Absent, kind: scenario_acceptance_kind(id: subject)),
  ]) {
    Absent => false
    Present { value: envs } => match roadmap_acceptance_receipts(history: scenario_history(envs: envs)) {
      RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
      RoadmapAcceptanceReceiptsProjected { receipts: all_receipts } => {
        let rs = all_receipts |> filter(r => r.node == subject)
        let victims = declared_node(id: subject)
        count(rs) == 1
          && count(victims) == 1
          && all(victims, n => node_accepted(receipts: rs, rn: n))
          && all(victims, n => !node_accepted(receipts: concat(rs, rs), rn: n))
      }
    }
  }
}

test fn witness_unexecuted_or_undelivered_evidence_refuses_acceptance() -> Bool {
  let victims = declared_node(id: "namespace-occurrence-transport")
  count(victims) == 1
    && all(victims, n => !node_accepted(receipts: [evidenceless_receipt_fixture(rn: n)], rn: n))
    && all(victims, n => !node_accepted(receipts: [undelivered_receipt_fixture(rn: n)], rn: n))
}

test fn witness_receipt_for_unknown_node_accepts_nothing() -> Bool {
  let ghost = receipt_fixture(node: "no-such-roadmap-node", digest: tchash(s: "0000000000000000"))
  all(nodes(), n => !node_accepted(receipts: [ghost], rn: n))
}

data acceptance_receipt_continuity_witness_note: String = "THE WALL AGAINST SILENT RECEIPT DELETION (acceptance_receipt_continuity_wall_note). Accepted and retired are read from the roadmap event log alone (gunbc.roadmap.roadmap_event_log); roadmap_acceptance_receipts projects live receipts only. The git-observed integrity witness that used to execute here (test.claim.roadmap.roadmap_receipt_continuity_live_witness) went with the carriers it read: it walked a revision-addressed observation carrier through git, and a chain in the log has no such prior — its parent is an event id in the same log. Its law is the fold's own (witness_deleted_history_event_refuses: a removed record with no withdrawal refuses) plus roadmap_acceptance_migration_verify, with RED controls in test.claim.roadmap.roadmap_receipt_continuity_acceptance: plant deleted events, prefix law, empty-prior bypass discriminant, digest-field mutation, wrong prior digest, revocation while live, duplicate revocations, exact revocation admit, criteria rewrite, and the typed load/projection refusal chain."

fn live_acceptance_event_history() -> List<RoadmapAcceptanceEvent> {
  match roadmap_acceptance_event_history_load() {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => events
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

test fn witness_vanished_receipt_without_revocation_refuses() -> Bool {
  // THE SCENARIO: two accepted rows, then the same history with one acceptance quietly gone and no
  // withdrawal to account for it. That is the shape of a silent history deletion, and the fold must
  // refuse it rather than let the plan shrink by one row.
  let kept = "namespace-occurrence-transport"
  let vanished = "2-scm-git-upstream-model"
  match scenario_envelopes(label: "vanished-receipt", events: [
    scenario_event(node: kept, parent: Absent, kind: scenario_acceptance_kind(id: kept)),
    scenario_event(node: vanished, parent: Absent, kind: scenario_acceptance_kind(id: vanished)),
  ]) {
    Absent => false
    Present { value: envs } => {
      let prior = scenario_event_history(envs: envs)
      let current = prior |> filter(e =>
        match e {
          AcceptanceRecorded { receipt: r } => r.node != tnid(s: vanished)
          AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true
        }
      )
      count(prior) == 2 && count(current) == 1 && !acceptance_history_extends_prior(prior: prior, current: current)
    }
  }
}

test fn witness_explicit_revocation_authorizes_vanished_receipt() -> Bool {
  // THE SCENARIO: one accepted row and one row the log says nothing about. The accepted one can be
  // withdrawn by an explicit revocation naming its exact prior receipt; the absent one has no receipt to
  // name, and asking for it answers with a TYPE (the empty case) rather than the crash this witness used
  // to have -- first(...) on an absent node used to reach for a `node` field on an Optional.
  let accepted_row = tnid(s: "namespace-occurrence-transport")
  let absent_row = tnid(s: "roadmap-authority-scenario-absent-node")
  match scenario_envelopes(label: "explicit-revocation-authorizes-vanished-receipt", events: [
    scenario_event(node: accepted_row, parent: Absent, kind: scenario_acceptance_kind(id: accepted_row)),
  ]) {
    Absent => false
    Present { value: envs } => {
      let prior = scenario_event_history(envs: envs)
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: live } => {
          // THE ABSENT NODE ANSWERS TYPED: nothing to revoke, said with a Bool, never a field lookup.
          match first(live |> filter(r => r.node == absent_row)) {
            Absent => true
            Present { value: _ } => false
          }
          && match first(live |> filter(r => r.node == accepted_row)) {
            // No receipt for a row the scenario accepted is the scenario's own bug; refuse, typed.
            Absent => false
            Present { value: receipt } => {
              let current = concat(prior, [
                AcceptanceRevoked {
                  exact_prior_receipt: receipt,
                  disposition: AcceptanceNodeReopensActiveFrontier {},
                  reason: "the scenario took the acceptance back" as NonEmptyStr,
                  revoked_by: "operator" as NonEmptyStr,
                  revoked_on: "2026-08-04" as NonEmptyStr,
                },
              ])
              acceptance_history_extends_prior(prior: prior, current: current)
                && acceptance_history_integrity_holds(
                  history: current,
                  prior_history: prior,
                )
            }
          }
        }
      }
    }
  }
}

test fn witness_accepted_parent_discharges_active_dependency() -> Bool {
  // THE SCENARIO: the four parents whose work has landed. The declared half -- every edge_exists assertion
  // below -- reads the .dag graph and is untouched; what the scenario carries is the frontier, so the
  // claim stays what it always was: an accepted parent discharges its dependent's active dependency.
  let landed = [
    "namespace-occurrence-transport",
    "pderive-typesafe-nullary-reflection",
    "2-scm-compatibility-shape",
    "2-claim-indexed-evidence",
  ]
  match scenario_envelopes(
    label: "accepted-parent-discharges-active-dependency",
    events: map(landed, id => scenario_event(node: id, parent: Absent, kind: scenario_acceptance_kind(id: id)))) {
    Absent => false
    Present { value: scenario_envs } =>
  let act = scenario_active_edges(envs: scenario_envs)
  !(act |> any(e => e.child == "namespace-binding-kernel" && e.parent == "namespace-occurrence-transport"))
    && !(act |> any(e => e.child == "pderive-static-supplemental-contract" && e.parent == "pderive-typesafe-nullary-reflection"))
    && !(act |> any(e => e.child == "2-scm-p0-landing-spine"))
    && is_top_level(edges: act, node: "declaration-identity-switchover")
    && !is_top_level(edges: act, node: "pderive-source-slot-binding")
    && edge_exists(child: "namespace-binding-kernel", parent: "namespace-occurrence-transport")
    && edge_exists(child: "pderive-static-supplemental-contract", parent: "pderive-typesafe-nullary-reflection")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-git-upstream-model")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-mercurial-upstream-model")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-pijul-upstream-model")
    && !edge_exists(child: "2-scm-compatibility-shape", parent: "2-claim-indexed-evidence")
    && edge_exists(child: "2-scm-p0-landing-spine", parent: "2-scm-compatibility-shape")
    && edge_exists(child: "2-scm-p0-landing-spine", parent: "2-claim-indexed-evidence")
    }
}

fn exit_line_bound_to(l: V1FinishLine, node: String) -> Bool {
  let matches = v1_exit_finish_lines()
    |> filter(s => v1_finish_line_key(l: s.line) == v1_finish_line_key(l: l))
  count(matches) == 1 && all(matches, s => s.node == node && id_exists(id: s.node))
}

test fn witness_exit_model_finish_lines_bind_declared_terminals() -> Bool {
  let specs = v1_exit_finish_lines()
  count(specs) == 4
    && all(specs, s => id_exists(id: s.node))
    && exit_line_bound_to(l: CompilerFixedPoint, node: "v1-emitter-fixed-point")
    && exit_line_bound_to(l: InterpreterDeleted, node: "v1-interpreter-delete")
    && exit_line_bound_to(l: ProductsV1Free, node: "v1-products-v1-free")
    && exit_line_bound_to(l: ZeroHandMaintainedRust, node: "v1-zero-hand-maintained-rust")
    // THE SCENARIO, twice: an unrelated acceptance must leave all four exit lines uncounted, and one
    // accepted exit line must be counted -- so the count is shown to track the frontier rather than to
    // read a constant. Neither case is the live log's business; the four rows being open is claimed by
    // the assertions above, which still run against the declared graph.
    && match scenario_envelopes(label: "exit-finish-lines-open", events: [
      scenario_event(node: "namespace-occurrence-transport", parent: Absent, kind: scenario_acceptance_kind(id: "namespace-occurrence-transport")),
    ]) {
      Absent => false
      Present { value: open_envs } => v1_finish_lines_accepted_count(accepted: scenario_accepted(envs: open_envs)) == 0
        && match scenario_envelopes(label: "exit-finish-line-accepted", events: [
          scenario_event(node: "v1-emitter-fixed-point", parent: Absent, kind: scenario_acceptance_kind(id: "v1-emitter-fixed-point")),
        ]) {
          Absent => false
          Present { value: closed_envs } => v1_finish_lines_accepted_count(accepted: scenario_accepted(envs: closed_envs)) == 1
        }
    }
}

// RETIRED WITH ITS SUBJECT, not deleted for convenience: this case read an authored completion flag
// (`red_ticket(done: true)`) to ask whether a finished ticket can come back. That flag is gone -- whether a
// node is over is a fact of the roadmap event log, never of the row (operator ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08) -- so a row fitted with it would be
// the second home the ruling deletes, and the claim would only be proving that a fabricated field fabricates
// nothing. The fact it guarded is claimed where it now lives: an accepted node is off the plan in
// dag/test/claim/roadmap/roadmap_event_log_witness.dag::a_retired_node_leaves_the_plan_the_way_an_accepted_one_does,
// and an over node's dependency edge closes in
// dag/test/claim/roadmap/roadmap_launch_canary_witness.dag::witness_canary_a_retired_parent_closes_the_dependency_and_an_unretired_one_does_not.

// What this case proves now is stated in its name: no row kind that is not an admissible work item is
// admissible, whatever text it carries. The row it used to fit was a 'superseded' line, and there is no
// such row kind any more -- a retirement is a Retired event in the log, claimed in
// dag/test/claim/roadmap/roadmap_event_log_witness.dag -- so the old name no longer described a kind of row.
test fn witness_plain_line_is_not_an_admissible_work_item() -> Bool {
  !active_node_admissible(n: red_fixture(
    line: PlainLine { content: "retired history" },
  ))
}

// witness_active_sizes_are_intentional_and_nonuniform WAS HERE AND IS RETIRED WITH ITS SUBJECT.
// It asserted that the authored size cells across the active rows were deliberate rather than one
// value copied down the file -- every row sized, and at least one row at each end of the range.
// Sizing is derived now and nothing carries a cell, so the claim has no population; weakening it
// to "every row is dispatchable" would leave the witness green while asserting something the row
// shape witness above already checks by identity. It is named in the population of
// gunbc.rung_drop.roadmap_sizing_authored_to_derived beside the forecast controls, and its trigger
// is the condition under which a derived distribution exists to make the claim about again.

// Dated status notes belong on a ticket's updates thread (gunbc.roadmap.roadmap_authority updated), so the
// thread is not what this claims is absent; what must never appear is execution state written into
// the ticket's standing fields.
test fn witness_authority_contains_no_mutable_execution_ledger() -> Bool {
  all(nodes() |> filter(n => match line_ticket(item: n.line) { Present { value: _ } => true  Absent => false }), n => match n.line {
    TicketLine { ticket } =>
      ticket.authored_on == ""
        && ticket.last_verified_on == ""
        && !string_contains(s: ticket.current_state, pattern: "PR #")
        && !string_contains(s: ticket.current_state, pattern: "session/")
        && !string_contains(s: ticket.current_state, pattern: "CI run")
    _ => false
  }) && count(authored_merged_prs()) == 0
}

