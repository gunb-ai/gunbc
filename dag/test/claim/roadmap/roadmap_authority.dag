// The accepted SCM sequence stays declared as receipt-bearing history after the 2026-09-30 cut
// removed the native-SCM program and its open P1 slice: every accepted row is still declared and
// inactive, and nothing open is left in the family.
test fn witness_accepted_scm_sequence_remains_declared_history() -> Bool {
  // THE SCENARIO: the six accepted SCM rows, spelled as the log spells an acceptance. The declared half
  // of this witness is untouched and stays live-reading of the .dag graph itself -- six rows on that
  // carrier, and the three withdrawn ids still absent. What the scenario carries is the frontier fact:
  // an accepted row is off the plan, and it stays declared history.
  let sequence = [
    "2-scm-git-upstream-model",
    "2-scm-mercurial-upstream-model",
    "2-scm-pijul-upstream-model",
    "2-claim-indexed-evidence",
    "2-scm-compatibility-shape",
    "2-scm-p0-landing-spine",
  ]
  match scenario_envelopes(
    label: "accepted-scm-sequence",
    events: map(sequence, id => scenario_event(node: id, parent: Absent, kind: scenario_acceptance_kind(id: id)))) {
    Absent => false
    Present { value: envs } => {
      let accepted = scenario_accepted(envs: envs)
      node_count_with_carrier_path(path: "docs/plans/dag-scm-design.md") == 6
        && all(sequence, id =>
          id_exists(id: id) && !scenario_active_id_exists(envs: envs, id: id) && (accepted |> any(a => a == id)))
        && !id_exists(id: "2-scm-p1-proof-kernel")
        && !id_exists(id: "2-scm-native-authority-program")
        && !id_exists(id: "dag-scm-program")
    }
  }
}

test fn witness_namespace_reference_derived_closure_has_discriminating_contract() -> Bool {
  match bound_execution_contract_for(id: "namespace-reference-derived-closure") {
    ExecutionContractUnspecified => false
    ExecutionContract { validations, extra_capabilities, path_scope: _, source_roots: _ } =>
      count(validations) == 1
        && count(extra_capabilities) == 0
        && validations |> any(validation => match validation {
          GunbcClaimValidation { entry, function } =>
            (entry as String) == "dag/test/claim/namespace_reference_derived_closure_acceptance.dag"
              && function == "witness_namespace_reference_derived_closure_closing_contract_holds"
          CargoTestValidation { filter: _ } => false
          CargoFmtValidation => false
          ClosingContractAuthoringValidation { target: _ } => false
        })
    NotAgentWork { mode: _ } => false
  }
}

test fn witness_v2_emitter_direct_rust_door_has_discriminating_contract() -> Bool {
  match bound_execution_contract_for(id: "v2-emitter-direct-rust-door") {
    ExecutionContractUnspecified => false
    ExecutionContract { validations, extra_capabilities, path_scope: _, source_roots: _ } =>
      count(validations) == 1
        && count(extra_capabilities) == 0
        && validations |> any(validation => match validation {
          GunbcClaimValidation { entry, function } =>
            (entry as String) == "src/v2/test/claim/long/direct_rust_door_production_group.dag"
              && function == "direct_rust_door_production_group_closing_expectation_holds"
          CargoTestValidation { filter: _ } => false
          CargoFmtValidation => false
          ClosingContractAuthoringValidation { target: _ } => false
        })
    NotAgentWork { mode: _ } => false
  }
}

// THE ACTIVE-SET CLAIM READS THE WHOLE PROJECTION: the page's focus row was deleted on 2026-09-30,
// so an accepted row's absence here can only mean it was accepted, never that a view hid it. It
// reads the projected rows themselves rather than their serialized markdown: every clause is a
// fact about which rows the projection carries (an accepted row is absent, an active one present,
// no superseded or awaiting-acceptance row survives), and serializing ~200 rows to find those facts
// cost the markdown emitter's whole fold per run. The markers' spelling is the emitter's own
// subject (test.claim.roadmap_emit_test); the clauses here are the same per-row predicates the
// emitter renders them from (gunbc.roadmap.roadmap_emit acceptance_pending_suffix_inlines). The
// superseded clause left with the authored supersession carrier: a row is out of the plan because it
// is accepted or because the event log retires it, and projected_row_is_active had no caller left to
// make that claim on main, so it goes rather than surviving as an import of a deleted name.
fn inline_text_contains(i: MarkdownInline, pattern: String) -> Bool {
  match i {
    TextInline { text } => string_contains(s: text, pattern: pattern)
    _ => false
  }
}

// The former markdown claim's text clause, split off because it is independent of which rows are
// active: no projected row's line and no preamble paragraph carries an operator TODO.
test fn witness_projection_carries_no_operator_todo() -> Bool {
  // THE SCENARIO: nothing accepted, nothing retired. A leftover "Operator TODO" is a rendering defect of
  // the projection, not a fact about anybody's log, so the projection is driven over a scenario instead.
  match scenario_envelopes(label: "no-operator-todo", events: []) {
    Absent => false
    Present { value: scenario_envs } => match scenario_authority(envs: scenario_envs) {
    RoadmapAuthorityProjectionRefused { detail: _ } => false
    RoadmapAuthorityProjected { doc: d, accepted: _, withheld: _ } =>
      !any(doc_all_nodes(doc: d), n => any(line_inlines(line: n.line), i => inline_text_contains(i: i, pattern: "Operator TODO")))
        && !any(d.preamble, b => match b {
          ParagraphBlock { inlines } => any(inlines, i => inline_text_contains(i: i, pattern: "Operator TODO"))
          _ => false
        })
    }
  }
}

data execution_frontier_witness_note: String = "The execution-contract frontier is a COUNT, and these claims pin both of its halves. Before the first binding the count was zero — dispatch_environment_admit refused on every node, so nothing below Env in the workflow had ever executed end to end and the whole seven-segment strip was unreachable in production. A binding is therefore the gate for every downstream receipt, and an unwitnessed one could regress to zero silently (the way it already did once, when the 2026-07-27 authority refresh deleted the node that carried the prior contract and no claim noticed). The first claim proves the bound node yields a real contract rather than the fail-closed variant; the second proves the platform/task capability JOIN actually happens at admission — 8 fixed dispatch mechanics plus the one capability this contract's validation derives — which is the fact that turns a contract into an admissible environment; the third is the frontier itself, and it is the RED-shaped one: it fails if a binding is lost AND it fails if a second node is bound without this roster being updated, so the count in roadmap_execution_contract_frontier_note cannot silently drift from the authority it describes."

fn bound_execution_contract_for(id: String) -> WorkItemExecutionContract {
  match nodes()
    |> filter(n => (n.node as String) == id)
    |> map(n => n.execution)
    |> first {
    Present { value: c } => c
    Absent => ExecutionContractUnspecified
  }
}

test fn witness_shell_typed_invocation_carries_a_real_contract() -> Bool {
  match bound_execution_contract_for(id: "shell-typed-invocation") {
    ExecutionContractUnspecified => false
    ExecutionContract { validations, extra_capabilities: _, path_scope: _, source_roots: _ } => count(validations) == 1
    NotAgentWork { mode: _ } => false
  }
}

test fn witness_bound_contract_joins_platform_and_task_capabilities() -> Bool {
  let caps = dispatch_required_capabilities(
    contract: bound_execution_contract_for(id: "shell-typed-invocation"),
  )
  count(caps) == 9
    && any(caps, c => execution_capability_label(capability: c) == "gunbc-claim-runner")
}

test fn witness_every_binding_carries_a_validation() -> Bool {
  all(
    nodes() |> filter(n => match n.execution {
        ExecutionContractUnspecified => false
        ExecutionContract { validations: _, extra_capabilities: _, path_scope: _, source_roots: _ } => true
        NotAgentWork { mode: _ } => false
      }),
    n => match n.execution {
        ExecutionContractUnspecified => false
        ExecutionContract { validations, extra_capabilities: _, path_scope: _, source_roots: _ } => count(validations) > 0
        NotAgentWork { mode: _ } => false
      },
  )
}

