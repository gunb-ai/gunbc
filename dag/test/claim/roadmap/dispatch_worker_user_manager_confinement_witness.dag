module test.claim.roadmap.dispatch_worker_user_manager_confinement_witness

import std.types { Bool, List }
import extdeps.systemd.systemd_run { EmptyCapabilityBoundingSet, SystemdRunProperty, systemd_run_property_applies_under_user_manager }
import gunbc.roadmap.dispatch_worker_unit_confinement {
  dispatch_model_driven_privilege_confinement_properties, dispatch_user_manager_privilege_confinement_properties,
}

// THIS MODULE IMPORTS ONLY THE CONFINEMENT AND THE SYSTEMD_RUN UPSTREAM, so its closure does not reach
// gunbc.host.host_effect (the actuator-level witness, dispatch_worker_confinement_witness, does, through
// roadmap_dispatch_actuator). These claims are the DERIVATION: the user-manager list is the full set filtered by the
// upstream fact. The actuator-level inhabitance claim (the review unit's rendered properties carry that list) stays in
// dispatch_worker_confinement_witness as a declared obligation; trigger: the seed accepts host_effect.dag line 248.

fn is_empty_bounding_set(p: SystemdRunProperty) -> Bool {
  match p {
    EmptyCapabilityBoundingSet => true
    _ => false
  }
}

// RED (substituted predicate): making systemd_run_property_applies_under_user_manager answer true for
// EmptyCapabilityBoundingSet puts the bounding set in the user-manager list and fails the first and last conjuncts;
// answering false for NamedUnitSetting empties the list and fails the second and third.
test fn the_user_manager_list_is_the_full_set_filtered_by_the_upstream_fact() -> Bool {
  let user = dispatch_user_manager_privilege_confinement_properties()
  let full = dispatch_model_driven_privilege_confinement_properties()
  all(user, p => systemd_run_property_applies_under_user_manager(property: p))
    && user.length() > 0
    && user.length() + 1 == full.length()
    && !any(user, p => is_empty_bounding_set(p: p))
}

// The system-manager worker keeps the bounding set: RED if the full set loses EmptyCapabilityBoundingSet.
test fn the_full_set_keeps_the_bounding_set_the_user_manager_cannot_apply() -> Bool {
  let full = dispatch_model_driven_privilege_confinement_properties()
  any(full, p => is_empty_bounding_set(p: p))
    && !all(full, p => systemd_run_property_applies_under_user_manager(property: p))
}
