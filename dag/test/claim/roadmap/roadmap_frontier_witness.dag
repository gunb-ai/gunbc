data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn roadmap_frontier_nid(s: String) -> RoadmapNodeId { s }

fn sized_derivable(id: String, prs: List<Int>, title: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_JAGJGPTHTYSG1GEDN9BA" as RoadmapNodeIdentity,
    node: roadmap_frontier_nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: roadmap_launch_canary_execution_contract(),
    owner: "",
    parent: Present { value: AdmittedRoot },
    centering: Present { value: "fixture centering plan" as NonEmptyStr },
  }
}

fn undispatchable_derivable(id: String, prs: List<Int>, title: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_CMY81J4ZCKAVZFQEAEFV" as RoadmapNodeIdentity,
    node: roadmap_frontier_nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    dispatch: NotDispatchable,
    execution: ExecutionContractUnspecified,
    owner: "",
    parent: none,
    centering: none,
  }
}

fn fixture_section(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapSection {
  RoadmapSection {
    title: "Test",
    elements: [Group { group: SectionGroup { label: "test", nodes: nodes, edges: edges } }],
  }
}

fn fixture_doc(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [fixture_section(nodes: nodes, edges: edges)],
  }
}

// THE FRONTIER AND THE DISPATCHER AGREE, from the same document. The parent is in the plan, so it
// is a parent the child waits on; the child's own readiness is decided the same way by both readers.
test fn witness_ready_matches_next_spawnable() -> Bool {
  let node_a = sized_derivable(id: "parent-active", prs: [100], title: "Parent")
  let node_b = sized_derivable(id: "child-ready", prs: [200], title: "Child Ready")
  let edges: List<RoadmapEdge> = []
  let doc = fixture_doc(nodes: [node_a, node_b], edges: edges)
  let frontier = spawn_frontier(doc: doc, merged: [100], accepted: [], withheld: [])
  let spawnable = next_spawnable(doc: doc, merged: [100], accepted: [], withheld: [])
  count(frontier.ready) == count(spawnable)
    && any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "child-ready"))
}

test fn witness_upcoming_is_blocked_sized_node() -> Bool {
  let node_a = sized_derivable(id: "parent-open", prs: [100], title: "Parent Open")
  let node_b = sized_derivable(id: "child-blocked", prs: [200], title: "Child Blocked")
  let edges = [RoadmapEdge { child: roadmap_frontier_nid(s: "child-blocked"), parent: roadmap_frontier_nid(s: "parent-open") }]
  let doc = fixture_doc(nodes: [node_a, node_b], edges: edges)
  let frontier = spawn_frontier(doc: doc, merged: [], accepted: [], withheld: [])
  any(frontier.upcoming, n => n.node == roadmap_frontier_nid(s: "child-blocked"))
    && !any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "child-blocked"))
}

test fn witness_merged_unsigned_node_stays_ready_for_acceptance() -> Bool {
  let node = sized_derivable(id: "review-node", prs: [999], title: "Review Node")
  let doc = fixture_doc(nodes: [node], edges: [])
  let frontier = spawn_frontier(doc: doc, merged: [999], accepted: [], withheld: [])
  any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "review-node"))
    && !any(frontier.upcoming, n => n.node == roadmap_frontier_nid(s: "review-node"))
}

test fn witness_merged_unsigned_parent_does_not_unblock_child() -> Bool {
  let parent = sized_derivable(id: "review-parent", prs: [999], title: "Review Parent")
  let child = sized_derivable(id: "after-review", prs: [1000], title: "After Review")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  let frontier = spawn_frontier(
    doc: fixture_doc(nodes: [parent, child], edges: [edge]),
    merged: [999], accepted: [], withheld: [])
  any(frontier.ready, n => n.node == parent.node)
    && any(frontier.upcoming, n => n.node == child.node)
    && !any(frontier.ready, n => n.node == child.node)
}

// THE CLOSURE IS THE WITHDRAWAL, NOT A ROW'S WORD. When the log ends a node — an acceptance, or a
// retirement — the node leaves the plan and its edges stop gating, so the child is left with nothing
// to wait on. The two asks below are the same document and the same merged set; the only difference
// is what the log has taken off the plan, which is what makes the pair mean withdrawal rather than a
// fixture that never had a parent.
test fn witness_withdrawn_parent_leaves_the_child_ready() -> Bool {
  let parent = sized_derivable(id: "closing-parent", prs: [700], title: "Closing Parent")
  let child = sized_derivable(id: "after-close", prs: [701], title: "After Close")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  let doc = fixture_doc(nodes: [parent, child], edges: [edge])
  let while_open = spawn_frontier(
    doc: doc, merged: [700], accepted: [], withheld: [],
  )
  let after_the_log = spawn_frontier(
    doc: doc, merged: [700], accepted: [], withheld: [parent.node],
  )
  any(while_open.upcoming, n => n.node == child.node)
    && !any(while_open.ready, n => n.node == child.node)
    && any(after_the_log.ready, n => n.node == child.node)
    && count(after_the_log.upcoming) == 0
}

test fn witness_unsized_excluded_from_frontier() -> Bool {
  let node = undispatchable_derivable(id: "unsized-open", prs: [], title: "NotDispatchable")
  let doc = fixture_doc(nodes: [node], edges: [])
  let frontier = spawn_frontier(doc: doc, merged: [], accepted: [], withheld: [])
  count(frontier.ready) == 0
    && count(frontier.upcoming) == 0
}

test fn witness_buckets_are_disjoint() -> Bool {
  let node_a = sized_derivable(id: "a-open", prs: [100], title: "A")
  let node_b = sized_derivable(id: "b-blocked", prs: [200], title: "B")
  let node_c = sized_derivable(id: "c-alone", prs: [300], title: "C")
  let edges = [RoadmapEdge { child: roadmap_frontier_nid(s: "b-blocked"), parent: roadmap_frontier_nid(s: "a-open") }]
  let doc = fixture_doc(nodes: [node_a, node_b, node_c], edges: edges)
  let frontier = spawn_frontier(doc: doc, merged: [300], accepted: [], withheld: [])
  any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "a-open"))
    && any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "c-alone"))
    && any(frontier.upcoming, n => n.node == roadmap_frontier_nid(s: "b-blocked"))
    && !any(frontier.ready, n => n.node == roadmap_frontier_nid(s: "b-blocked"))
    && !any(frontier.upcoming, n => n.node == roadmap_frontier_nid(s: "a-open"))
    && !any(frontier.upcoming, n => n.node == roadmap_frontier_nid(s: "c-alone"))
}

// THE BAND BOUNDARY, SUPPLIED: the workspace view built from the document's rows by the same
// work_row_view / daily_workspace_view the page uses, without the program-progress strip and the
// live family roster (whole-authority reads that cost ~190k steps and carry nothing about bands),
// then serialized through workspace_markup -- the fragment the page embeds. The page composition
// itself is exercised by the page witnesses; these claims are about which band a row lands in.
// The fixture states the event log's decision and hands the SAME two lists to both producers in the view: the
// launch context and the rows. Passing literals to one of the two would let the page's launch cells and its
// readiness cells answer from different populations, which is the split this witness now also checks.
fn fixture_workspace_view(
  doc: RoadmapDocument,
  merged: List<Int>,
  accepted: List<RoadmapNodeId>,
  withheld: List<RoadmapNodeId>,
) -> DailyWorkspaceView {
  let nodes = doc_all_nodes(doc: doc)
  let edges = doc_all_edges(doc: doc)
  let ctx = page_launch_context(
    doc: doc, merged: merged, accepted: accepted, withheld: withheld,
    launch: launch_host_unobserved_static_render())
  let rows = map(nodes, rn => work_row_view(
    rn: rn, nodes: nodes, edges: edges, merged: merged,
    activity: daily_row_activity(node_id: rn.node as String, attempts: [], attempts_refused: none),
    rounds: daily_row_rounds(node_id: rn.node as String, attempts: [], attempts_refused: none),
    worker_alive: false, standing: none, launch: ctx, attempt_stale: false, profiles: [],
    accepted: accepted, withheld: withheld))
  daily_workspace_view(rows: rows, edges: edges, program: none, observation: observation_impact_view(workflow_refused: none), families: [], members: [], memberships: [])
}

fn workspace_band_html(
  doc: RoadmapDocument,
  merged: List<Int>,
  accepted: List<RoadmapNodeId>,
  withheld: List<RoadmapNodeId>,
) -> String {
  match try_serialize_html_source(node: workspace_markup(ws: fixture_workspace_view(
      doc: doc, merged: merged, accepted: accepted, withheld: withheld), edges: doc_all_edges(doc: doc), memberships: [])) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn daily_workspace_header_html() -> String {
  match try_serialize_html_source(node: site_header(page: "daily workspace")) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

// THE BAND VOCABULARY WITHOUT THE BAND SURFACE (owner ruling 2026-09-25, "just copy buganizer";
// the sized fixture is a complete node -- rooted, centered, bound -- so the page reads it ready):
// the frontier's four buckets — ready / upcoming / done / superseded — no longer render as
// frontier-bucket sections; they survive as the table's row vocabulary: the flat rows carry the
// band in data-band (the band chips filter on it) in the same bucket order the view derived, and
// the band CHIPS render for the filter. The forest that presented the buckets retired with the
// tree/bands view tabs.
test fn witness_page_renders_four_buckets() -> Bool {
  let node_a = sized_derivable(id: "ready-node", prs: [10], title: "Ready Title")
  let doc = fixture_doc(nodes: [node_a], edges: [])
  let h = workspace_band_html(doc: doc, merged: [], accepted: [], withheld: [])
  string_contains(s: daily_workspace_header_html(), pattern: "<h1>daily workspace</h1>")
    && string_contains(s: h, pattern: "<section class=\"roadmap-frontier\">")
    && !string_contains(s: h, pattern: "frontier-bucket")
    && !string_contains(s: h, pattern: "<h2>Ready</h2>")
    && string_contains(s: h, pattern: "data-band=\"ready\"")
    && string_contains(s: h, pattern: "data-band-chip=\"ready\"")
    && string_contains(s: h, pattern: "data-band-chip=\"not-ready\"")
    && string_contains(s: h, pattern: "data-band-chip=\"done\"")
}

test fn witness_page_places_ready_node_in_ready_bucket() -> Bool {
  let node = sized_derivable(id: "spawn-me", prs: [42], title: "Spawn Me Now")
  let doc = fixture_doc(nodes: [node], edges: [])
  let h = workspace_band_html(doc: doc, merged: [], accepted: [], withheld: [])
  string_contains(s: h, pattern: "Spawn Me Now")
    && string_contains(s: h, pattern: "data-band=\"ready\"")
    && string_contains(s: h, pattern: "data-node=\"spawn-me\"")
    && !string_contains(s: h, pattern: "frontier-bucket")
    && !string_contains(s: h, pattern: "class=\"status status-open\"")
}

// Every band entry carries its node ids, whatever shape it has: a family or a project tree is not a place a
// row can hide, so asking a band whether it holds a node asks all three variants.
fn band_row_ids(e: WorkBandEntry) -> List<String> {
  match e {
    BandRow { row: r } => [r.node_id]
    BandFamily { family: f } => map(f.rows, r => r.node_id)
    BandProject { project: p } => append([p.row.node_id], items: map(p.chain, r => r.node_id))
  }
}

fn band_has(entries: List<WorkBandEntry>, id: String) -> Bool {
  any(entries, e => any(band_row_ids(e), k => k == id))
}

// THE PAGE'S BANDS AND THE FRONTIER MOVE A CHILD ON THE SAME DECISION. This is the page-bucket sibling of
// gunbc.roadmap.roadmap_spawner's claim that the spawner and the row scheduler answer from one population:
// that one compares per-row scheduling against next_spawnable, this one compares the page's OWN typed buckets
// (DailyWorkspaceView.ready / .not_ready, which is what the bands are made of) against spawn_frontier, and it
// moves a parent between open and accepted — the standing no other claim here pairs with the page. It exists
// because the readiness graph the bands came from used to subtract accepted parents on its own, and no claim
// joined what the page printed to what the frontier said.
test fn witness_page_buckets_and_frontier_move_a_child_on_the_same_decision() -> Bool {
  let parent = sized_derivable(id: "page-parent", prs: [700], title: "Page Parent")
  let child = sized_derivable(id: "page-child", prs: [701], title: "Page Child")
  let edge = RoadmapEdge { child: child.node, parent: parent.node }
  let doc = fixture_doc(nodes: [parent, child], edges: [edge])
  let merged = [700, 701]
  let blocked_ws = fixture_workspace_view(doc: doc, merged: merged, accepted: [], withheld: [])
  let accepted_ws = fixture_workspace_view(
    doc: doc, merged: merged, accepted: [parent.node], withheld: [],
  )
  let blocked_frontier = spawn_frontier(doc: doc, merged: merged, accepted: [], withheld: [])
  let accepted_frontier = spawn_frontier(
    doc: doc, merged: merged, accepted: [parent.node], withheld: [],
  )
  // The body's FIRST item carries no '&&'. A line that begins with '&&' is glued by the parser onto the
  // statement above it, so a chain written entirely with leading '&&' silently became the initializer of
  // 'accepted_frontier' and read it there -- the compiler said 'undefined variable' at a line that looks
  // innocent, under a 'let' that looks innocent. This is the file's own shape (see
  // witness_merged_unsigned_parent_does_not_unblock_child): one expression, then indented '&&' lines.
  //
  // While the parent stands open both readers hold the child back: not in the page's ready band, not in
  // the frontier's ready list. A child rendered nowhere at all would pass a "not in ready" test for the
  // wrong reason, so it is asked for by name in the band it must be in.
  band_has(blocked_ws.not_ready, "page-child")
    && !band_has(blocked_ws.ready, "page-child")
    && any(blocked_frontier.upcoming, n => n.node == child.node)
    && !any(blocked_frontier.ready, n => n.node == child.node)
    // Accept the parent in the log and the child moves in both readers, in the same ask: one event, two
    // surfaces, no second decision to keep in step.
    && band_has(accepted_ws.ready, "page-child")
    && !band_has(accepted_ws.not_ready, "page-child")
    && any(accepted_frontier.ready, n => n.node == child.node)
    && count(accepted_frontier.upcoming) == 0
}
