module test.claim.roadmap_served_observation_witness

import std.types { String, Int, Bool, List, FilePath }
import extdeps.http.server { text_html_utf8, text_plain_utf8, application_json_utf8 }
import gunbc.host_layout { instance_receipts_dir }
import gunbc.roadmap_dashboard_instance {
  srv1_live_dashboard_instance,
  dashboard_instance_dispatch_attempt_state_root,
  dashboard_path_is_under,
}
import gunbc.roadmap_serve { roadmap_serve_route_specs, ObservationJsonHandler }
import gunbc.roadmap_served_observation {
  ServedObservationKind, DailyPage, AttemptsJson, WorkflowJson, SessionsJson,
  ServedObservationSurface,
  ServedObservationSnapshot,
  ServedObservationRead, ServedObservationPresent, ServedObservationAbsent, ServedObservationUnreadable,
  served_observation_schema,
  served_observation_path_for_instance,
  served_observation_wire,
  served_observation_decode,
  served_observation_read_from_filesystem,
  served_observation_identity_hex,
  served_observation_surface_response,
  served_observation_standing_json_value,
  served_observation_standing_http_status,
}
import extdeps.languages.json.emit { serialize_json }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_snapshot() -> ServedObservationSnapshot {
  ServedObservationSnapshot {
    observed_at: "2026-09-04T18:00:00Z",
    surfaces: [
      ServedObservationSurface { kind: DailyPage, status: 200, body: "<!doctype html><html><body>daily</body></html>" },
      ServedObservationSurface { kind: AttemptsJson, status: 200, body: "{\"attempts\":[]}" },
      ServedObservationSurface { kind: WorkflowJson, status: 503, body: "{\"refused\":\"tmux unavailable\"}" },
      ServedObservationSurface { kind: SessionsJson, status: 200, body: "{\"live\":[]}" },
    ],
  }
}

fn fixture_read() -> ServedObservationRead {
  ServedObservationPresent { snapshot: fixture_snapshot() }
}

// Round trip through the wire is the codec's positive control: the producer's bytes decode to a
// snapshot the reader accepts, with the same identity and every surface intact.
test fn wire_round_trip_decodes_to_the_same_snapshot() -> Bool {
  let snap = fixture_snapshot()
  match served_observation_decode(raw: served_observation_wire(snapshot: snap)) {
    ServedObservationPresent { snapshot } =>
      snapshot.observed_at == snap.observed_at
        && count(snapshot.surfaces) == 4
        && served_observation_identity_hex(snapshot: snapshot) == served_observation_identity_hex(snapshot: snap)
    ServedObservationAbsent => false
    ServedObservationUnreadable { reason: _ } => false
  }
}

// RED control: a body edited after the identity was taken is refused, never served.
test fn red_control_tampered_body_is_unreadable() -> Bool {
  let identity = served_observation_identity_hex(snapshot: fixture_snapshot())
  let tampered = join([
    "{\"schema\":\"", served_observation_schema, "\",",
    "\"observed_at\":\"2026-09-04T18:00:00Z\",",
    "\"surfaces\":[{\"kind\":\"daily_page\",\"status\":\"200\",\"body\":\"forged\"}],",
    "\"snapshot_identity\":\"", identity, "\"}",
  ], "")
  match served_observation_decode(raw: tampered) {
    ServedObservationUnreadable { reason } => string_contains(s: reason, pattern: "identity does not match")
    ServedObservationPresent { snapshot: _ } => false
    ServedObservationAbsent => false
  }
}

test fn red_control_status_outside_the_closed_set_is_unreadable() -> Bool {
  let widened = join([
    "{\"schema\":\"", served_observation_schema, "\",",
    "\"observed_at\":\"2026-09-04T18:00:00Z\",",
    "\"surfaces\":[{\"kind\":\"daily_page\",\"status\":\"418\",\"body\":\"x\"}],",
    "\"snapshot_identity\":\"unused\"}",
  ], "")
  match served_observation_decode(raw: widened) {
    ServedObservationUnreadable { reason } => string_contains(s: reason, pattern: "outside the closed set")
    ServedObservationPresent { snapshot: _ } => false
    ServedObservationAbsent => false
  }
}

test fn red_control_unknown_schema_is_unreadable() -> Bool {
  match served_observation_decode(raw: "{\"schema\":\"roadmap-served-observation/v0\",\"observed_at\":\"x\",\"surfaces\":[]}") {
    ServedObservationUnreadable { reason } => string_contains(s: reason, pattern: "schema is unknown")
    ServedObservationPresent { snapshot: _ } => false
    ServedObservationAbsent => false
  }
}

test fn a_missing_file_reads_as_absent_not_unreadable() -> Bool {
  let absent = served_observation_read_from_filesystem(success: false, content: "", error: "No such file or directory")
  let broken = served_observation_read_from_filesystem(success: false, content: "", error: "Permission denied")
  (match absent { ServedObservationAbsent => true  _ => false })
    && (match broken { ServedObservationUnreadable { reason } => string_contains(s: reason, pattern: "Permission denied")  _ => false })
}

// The reader never observes the host for itself: an absent snapshot is a typed 503, and the body
// names the refusal so an operator can tell a stalled belt from a broken reader.
test fn absent_snapshot_refuses_with_a_typed_503_and_never_observes() -> Bool {
  let r = served_observation_surface_response(read: ServedObservationAbsent, kind: DailyPage)
  r.status == 503
    && r.content_type == application_json_utf8
    && string_contains(s: r.body, pattern: "ServedObservationAbsent")
    && string_contains(s: r.body, pattern: served_observation_schema)
}

test fn present_snapshot_serves_the_stored_bytes_status_and_media_type() -> Bool {
  let daily = served_observation_surface_response(read: fixture_read(), kind: DailyPage)
  let attempts = served_observation_surface_response(read: fixture_read(), kind: AttemptsJson)
  let workflow = served_observation_surface_response(read: fixture_read(), kind: WorkflowJson)
  daily.status == 200 && daily.content_type == text_html_utf8 && string_contains(s: daily.body, pattern: "daily")
    && attempts.status == 200 && attempts.content_type == application_json_utf8 && attempts.body == "{\"attempts\":[]}"
    && workflow.status == 503 && workflow.content_type == application_json_utf8 && string_contains(s: workflow.body, pattern: "tmux unavailable")
}

test fn a_refused_daily_render_is_served_as_plain_text_not_html() -> Bool {
  let snap = ServedObservationSnapshot {
    observed_at: "2026-09-04T18:00:00Z",
    surfaces: [ServedObservationSurface { kind: DailyPage, status: 500, body: "page render refused" }],
  }
  let r = served_observation_surface_response(read: ServedObservationPresent { snapshot: snap }, kind: DailyPage)
  r.status == 500 && r.content_type == text_plain_utf8
}

test fn a_surface_the_producer_did_not_render_is_a_typed_503() -> Bool {
  let snap = ServedObservationSnapshot {
    observed_at: "2026-09-04T18:00:00Z",
    surfaces: [ServedObservationSurface { kind: DailyPage, status: 200, body: "<html></html>" }],
  }
  let r = served_observation_surface_response(read: ServedObservationPresent { snapshot: snap }, kind: SessionsJson)
  r.status == 503
    && string_contains(s: r.body, pattern: "ServedObservationSurfaceMissing")
    && string_contains(s: r.body, pattern: "sessions_json")
}

test fn standing_publishes_observed_at_and_identity_when_present() -> Bool {
  let body = serialize_json(v: served_observation_standing_json_value(read: fixture_read()))
  served_observation_standing_http_status(read: fixture_read()) == 200
    && string_contains(s: body, pattern: "\"observed_at\": \"2026-09-04T18:00:00Z\"")
    && string_contains(s: body, pattern: served_observation_identity_hex(snapshot: fixture_snapshot()))
    && string_contains(s: body, pattern: "\"url_path\": \"/workflow.json\"")
    && served_observation_standing_http_status(read: ServedObservationAbsent) == 503
}

// Same law as the belt tick receipt's home: the snapshot is per-instance, under the instance's own
// receipts dir, never under the host-shared attempt-state root.
test fn the_snapshot_is_homed_in_the_instance_receipts_dir_not_the_shared_root() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let shared = dashboard_instance_dispatch_attempt_state_root(instance: instance)
  let path = served_observation_path_for_instance(instance: instance)
  let receipts = instance_receipts_dir(instance_root: instance.instance_root as String)
  starts_with(s: path, prefix: receipts)
    && !dashboard_path_is_under(path: path as FilePath, root: shared)
}

test fn the_standing_route_is_served() -> Bool {
  any(roadmap_serve_route_specs(), r => r.raw == "/observation.json" && (match r.handler { ObservationJsonHandler => true  _ => false }))
}
