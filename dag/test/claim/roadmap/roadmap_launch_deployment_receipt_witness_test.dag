// The v4 decoder refuses a v3 document; the observer records that as an unreadable tick.
test fn witness_v3_tick_on_disk_is_incomplete_at_tick_standing() -> Bool {
  let read = belt_tick_receipt_decode(raw: "{\"schema\":\"roadmap-belt-tick-receipt/v3\",\"observed_at\":\"2026-08-30T12:01:00Z\"}")
  let fact = match read {
    BeltTickReceiptUnreadable { reason: r } => TickUnobserved { detail: r }
    BeltTickReceiptAbsent => TickUnobserved { detail: "absent" }
    BeltTickReceiptPresent { receipt: t } => rlm_tick_fact(t: t)
  }
  (match read { BeltTickReceiptUnreadable { reason: _ } => true  _ => false })
    && incomplete_at(facts: with_tick(f: rlm_complete_facts(), t: fact), member: "tick_standing")
}

