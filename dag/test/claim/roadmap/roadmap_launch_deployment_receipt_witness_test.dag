      expected_surface: Fnv1a64Structural { digest: rlm_fixture_surface as Fnv1a64StructuralDigestHex },
      process_surface: Fnv1a64Structural { digest: "ffffffffffffffff" as Fnv1a64StructuralDigestHex },
    }
  }
