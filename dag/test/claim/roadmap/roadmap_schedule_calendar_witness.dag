module test.claim.roadmap.roadmap_schedule_calendar_witness

// THE DECLARATION of the calendar-binding unit (roadmap-schedule-calendar-binding), a unit of
// gunb-ai/gunbc#16650's chain to the roadmap Gantt. It reads the COMPUTED list schedule from
// gunbc.roadmap.roadmap_schedule (roadmap-schedule-list-scheduling, #16695) -- never recomputing it -- and the
// calendar (extdeps.units.iso8601_calendar), and binds the schedule's ABSTRACT WORKING-DAYS to DATES against a
// read date. The scheduler counts days in WORKING days (gunbc.roadmap.roadmap_decomposition), so five abstract
// days span one calendar week and no working day is spent on a Saturday or Sunday. Day 0 is the read date; a read
// taken on a non-working day reads as the NEXT working day, never the weekend; the same schedule read one week
// later (the same weekday) moves every date by seven days and changes nothing else.
//
// THE HANDBACK, named the way the unit names its own: the dated output for one read, the weekend output, the
// one-week-later output, and the diff. Each is a dated_output string the claims below assert to the character.
//
// LOCAL RECIPE (claims are executed, not parsed):
//   claim_batch --source-root dag --source-root src/v1 --source-root src/v2 \
//     --entry dag/test/claim/roadmap/roadmap_schedule_calendar_witness.dag \
//     --functions first_slice_binds_one_schedule_answer_to_a_read_date_and_prints_the_dated_critical_path,red_control_a_leaf_finishing_on_a_non_working_day_reads_as_the_next_working_day_never_the_weekend,red_control_the_same_schedule_read_one_week_later_moves_every_date_by_seven_days_and_changes_nothing_else,a_working_day_span_that_crosses_the_weekend_is_not_counted_across_it,a_three_week_span_counts_weekends_by_the_seven_day_week,a_dated_leaf_start_and_finish_never_collapse_onto_the_same_date,a_cached_dated_answer_is_recomputed_on_read_and_is_never_authoritative_between_reads,binding_a_schedule_that_was_never_scheduled_is_refused,the_handback_outputs_are_the_one_read_the_weekend_read_and_the_one_week_later_read

import std.types { Bool, Int, List, String }
import std.optional { Present, Absent }
import std.list { first_where }
import gunbc.roadmap.roadmap_decomposition { decomposition, leaf, expand_decomposition }
import gunbc.roadmap.roadmap_schedule { schedule, Schedule, path_key }
import extdeps.units.iso8601_calendar { Iso8601CivilDate, iso8601_days_from_civil, iso8601_civil_from_days }
import gunbc.roadmap.roadmap_schedule_calendar {
  DatedCriticalPath, DatedLeaf,
  bind_critical_path, bind_critical_path_read, dated_is_current, dated_output,
  is_bound, is_unbindable, refusal_cause, dated_at, dated_critical_path, days_between,
  working_days_between, is_working_day, is_non_working_day, date_text, count_source_text,
}

// THE FIXTURE. A THREE-LEAF CHAIN under ONE worker: a (5 days), then b (2 days), then c (3 days). The scheduler
// (#16695) places them on abstract working-days 0..5, 5..7, 7..10, so the critical path is 10 working days long.
// Read on a Monday this is a MULTI-WEEK schedule: leaf a alone spans five working days and its finish crosses a
// whole weekend -- exactly the case that a naive calendar-day mapping gets wrong (a would end on a Saturday, and b
// would collapse from Saturday to Monday onto the same day). Read one week later every date must move by seven.
fn calendar_week_schedule() -> Schedule {
  let chain = decomposition(node: "cal.week", waits_on: [], stages: [
    [leaf(label: "first", days: 5)],
    [leaf(label: "second", days: 2)],
    [leaf(label: "third", days: 3)],
  ])
  schedule(d: chain, e: expand_decomposition(d: chain, findings_count: 1), workers: 1)
}

// THE READ DATE: Monday 16 November 2026. Abstract working-day 0.
fn read_monday() -> Iso8601CivilDate {
  Iso8601CivilDate { year: 2026, month: 11, day: 16 }
}

// The same weekday, ONE WEEK LATER: Monday 23 November 2026.
fn read_one_week_later() -> Iso8601CivilDate {
  Iso8601CivilDate { year: 2026, month: 11, day: 23 }
}

// A READ TAKEN ON A NON-WORKING DAY: Saturday 21 November 2026. A binding against it must NEVER print a Saturday
// or Sunday -- every date reads as the next working day, starting from Monday 23 November.
fn read_saturday() -> Iso8601CivilDate {
  Iso8601CivilDate { year: 2026, month: 11, day: 21 }
}

// The NAIVE CALENDAR date an abstract day would land on if counted as one calendar day per day -- computed HERE in
// the witness (not exported by the unit) so a red control can name the Saturday the working-day advance refuses
// to print. This is the thing the unit must never return; it is asserted non-working and then CONTRADICTED by the
// bound date, proving the correction is real and not a no-op.
fn naive_calendar_date(read: Iso8601CivilDate, day: Int) -> Iso8601CivilDate {
  iso8601_civil_from_days(days: iso8601_days_from_civil(y: read.year, m: read.month, d: read.day) + day)
}

// Any date on a binding (start or finish) that is a non-working day. Zero is the only acceptable answer.
fn any_weekend_date(bound: DatedCriticalPath) -> Bool {
  let dated = dated_critical_path(bound: bound)
  let dates = concat(map(dated, d => d.start_date), map(dated, d => d.finish_date))
  count(filter(dates, d => is_non_working_day(date: d))) > 0
}

// Any dated leaf whose printed start and finish collapse onto the SAME date -- the failure the old calendar-day
// model produced when it rolled both a Saturday start and a Monday finish onto one Monday. Zero is the answer.
fn any_collapsed_leaf(bound: DatedCriticalPath) -> Bool {
  count(filter(dated_critical_path(bound: bound), d => date_text(date: d.start_date) == date_text(date: d.finish_date))) > 0
}

// THE FIRST SLICE. Bind one schedule answer to a read date and print the start and finish dates along its
// critical path. The printed artifact is asserted to the character (the HANDBACK's dated output for one read).
// Read on Monday, the 10-working-day chain ends on Monday 2026-11-30 -- the TENTH working day, two calendar weeks
// out -- not on its tenth calendar day. Leaf a's finish (working day 5) crosses the weekend and reads Monday 23.
fn first_slice_binds_one_schedule_answer_to_a_read_date_and_prints_the_dated_critical_path() -> Bool {
  let bound = bind_critical_path(schedule: calendar_week_schedule(), read_date: read_monday())
  let expected = join([
    "read_date=2026-11-16 workers=1 critical_length=10",
    "  cal.week#0#0#0 days[0..5] dates[2026-11-16 -> 2026-11-23] count=declared",
    "  cal.week#1#0#0 days[5..7] dates[2026-11-23 -> 2026-11-25] count=declared",
    "  cal.week#2#0#0 days[7..10] dates[2026-11-25 -> 2026-11-30] count=declared",
  ], "\n")
  // Each occurrence is keyed by its LeafPath and read back by it (the schedule answer's total read), and its COUNT
  // SOURCE stays visible -- the Declared/Assumed origin of the day count never disappears into the date binding.
  let read_back_by_path = match first_where(dated_critical_path(bound: bound), d => d.finish_day == 5) {
    Absent => false
    Present { value: a } => match dated_at(bound: bound, path: a.path) {
      Absent => false
      Present { value: back } =>
        path_key(p: back.path) == path_key(p: a.path)
        && count_source_text(count: back.count_source) == "declared"
    }
  }
  is_bound(bound: bound)
    && count(dated_critical_path(bound: bound)) == 3
    && dated_output(bound: bound) == expected
    && read_back_by_path
}

// THE FIRST RED CONTROL, named the way the unit names its own: a leaf finishing on a non-working day reads as the
// NEXT working day, never as the weekend. Two ways it fires:
//  (a) A five-working-day leaf read on a Monday: abstract day 5 is the SATURDAY 2026-11-21 on the naive calendar
//      (the control fires only because that naive date IS a non-working day), yet its DATED finish reads as the
//      FOLLOWING Monday 2026-11-23 -- never the Saturday or the Sunday.
//  (b) A read TAKEN on the Saturday 2026-11-21: the whole dated critical path reads off the FOLLOWING Monday and
//      NEVER prints a Saturday or a Sunday anywhere.
fn red_control_a_leaf_finishing_on_a_non_working_day_reads_as_the_next_working_day_never_the_weekend() -> Bool {
  let sched = calendar_week_schedule()
  let read = read_monday()
  let bound = bind_critical_path(schedule: sched, read_date: read)
  // (a) leaf a finishes on abstract working-day 5 -- the naive Saturday 2026-11-21 -- and reads as Monday.
  let naive_finish_is_weekend = is_non_working_day(date: naive_calendar_date(read: read, day: 5))
    && date_text(date: naive_calendar_date(read: read, day: 5)) == "2026-11-21"
  let finish_corrected = match first_where(dated_critical_path(bound: bound), d => d.finish_day == 5) {
    Absent => false
    Present { value: roller } =>
      date_text(date: roller.finish_date) == "2026-11-23"
      && is_working_day(date: roller.finish_date)
      && date_text(date: roller.finish_date) != "2026-11-21"
  }
  // (b) a read taken ON the Saturday prints no weekend date at all, and day 0 reads as the following Monday.
  let weekend_read = bind_critical_path(schedule: sched, read_date: read_saturday())
  let weekend_binds_clean = is_bound(bound: weekend_read)
    && !any_weekend_date(bound: weekend_read)
    && match first_where(dated_critical_path(bound: weekend_read), d => d.finish_day == 5) {
      Absent => false
      Present { value: first_leaf } => date_text(date: first_leaf.start_date) == "2026-11-23"
    }
  naive_finish_is_weekend && finish_corrected && weekend_binds_clean
}

// THE SECOND RED CONTROL, named the way the unit names its own: the same schedule read one week later (the same
// weekday) moves EVERY date by exactly seven days, and EVERYTHING ELSE -- path, abstract start/finish days, and
// count source -- is identical, for every leaf on the 10-working-day critical path (not just the one that rolled).
fn red_control_the_same_schedule_read_one_week_later_moves_every_date_by_seven_days_and_changes_nothing_else() -> Bool {
  let sched = calendar_week_schedule()
  let first = dated_critical_path(bound: bind_critical_path(schedule: sched, read_date: read_monday()))
  let later = dated_critical_path(bound: bind_critical_path(schedule: sched, read_date: read_one_week_later()))
  count(first) == 3 && count(later) == 3
    && pair_unchanged(first, later, 5)
    && pair_unchanged(first, later, 7)
    && pair_unchanged(first, later, 10)
}

// A WORKING-DAY SPAN THAT CROSSES THE WEEKEND IS NOT COUNTED ACROSS IT. Leaf a is five WORKING days but SEVEN
// calendar days end to end (it spans the Saturday and Sunday); the binding must put five working days on the
// calendar, not seven, and must never print the weekend itself. Checked against the dates alone (working_days_between
// is computed from the calendar, independent of the binding), so this is not the unit grading its own homework.
fn a_working_day_span_that_crosses_the_weekend_is_not_counted_across_it() -> Bool {
  let bound = bind_critical_path(schedule: calendar_week_schedule(), read_date: read_monday())
  let all_durations_are_working_days = count(filter(dated_critical_path(bound: bound), d => working_days_between(start: d.start_date, finish: d.finish_date) != d.finish_day - d.start_day)) == 0
  let leaf_a_spans_the_weekend = match first_where(dated_critical_path(bound: bound), d => d.finish_day == 5) {
    Absent => false
    Present { value: a } =>
      // Five working days, but the calendar distance is seven -- the two weekend days are crossed, not scheduled.
      (a.finish_day - a.start_day) == 5
      && days_between(from: a.start_date, to: a.finish_date) == 7
      && working_days_between(start: a.start_date, finish: a.finish_date) == 5
      && is_working_day(date: a.start_date)
      && is_working_day(date: a.finish_date)
  }
  all_durations_are_working_days && leaf_a_spans_the_weekend && !any_weekend_date(bound: bound)
}

// THE ORACLE'S OWN REFERENT, three weeks long. working_days_between is the witness's INDEPENDENT check on the
// binding, so it must be right on its own -- DESIGN fail_closed: "a test's oracle needs an independent referent."
// A SINGLE leaf of fifteen WORKING days read on a Monday spans TWENTY-ONE calendar days and crosses THREE weekends;
// counting those weekends by the five-day working week (total/5) silently returns thirteen, and only the seven-day
// week (total/7) gives fifteen. Fifteen is asserted against the twenty-one-day calendar distance and the printed
// Monday -> Monday, so a wrong oracle -- or a wrong binding -- fails here where the one-week cases cannot tell.
fn a_three_week_span_counts_weekends_by_the_seven_day_week() -> Bool {
  let chain = decomposition(node: "cal.threeweeks", waits_on: [], stages: [[leaf(label: "long", days: 15)]])
  let sched = schedule(d: chain, e: expand_decomposition(d: chain, findings_count: 1), workers: 1)
  match first_where(dated_critical_path(bound: bind_critical_path(schedule: sched, read_date: read_monday())), d => d.finish_day == 15) {
    Absent => false
    Present { value: l } =>
      (l.finish_day - l.start_day) == 15
      && days_between(from: l.start_date, to: l.finish_date) == 21
      && working_days_between(start: l.start_date, finish: l.finish_date) == 15
      && date_text(date: l.start_date) == "2026-11-16"
      && date_text(date: l.finish_date) == "2026-12-07"
  }
}

// A DATED LEAF START AND FINISH NEVER COLLAPSE ONTO THE SAME DATE. The old calendar-day model printed a 3-working-
// day leaf as dates[Mon -> Mon] -- three days scheduled, zero shown. Every leaf here spans at least two working
// days, so no start and finish may share a date. Leaf b (days 5..7) is the exact collapse case: Mon -> Wed, never
// Mon -> Mon.
fn a_dated_leaf_start_and_finish_never_collapse_onto_the_same_date() -> Bool {
  let bound = bind_critical_path(schedule: calendar_week_schedule(), read_date: read_monday())
  let leaf_b_not_collapsed = match first_where(dated_critical_path(bound: bound), d => d.finish_day == 7) {
    Absent => false
    Present { value: b } =>
      date_text(date: b.start_date) == "2026-11-23"
      && date_text(date: b.finish_date) == "2026-11-25"
      && date_text(date: b.start_date) != date_text(date: b.finish_date)
  }
  !any_collapsed_leaf(bound: bound) && leaf_b_not_collapsed
}

// THE HANDBACK, asserted to the character -- the three dated outputs the unit names, plus their relationship.
//  - the dated output for ONE read (Monday 2026-11-16): the 10-working-day chain ends Monday 2026-11-30.
//  - the WEEKEND output (a read taken on Saturday 2026-11-21): the read_date line still says Saturday, but every
//    date is a working day -- day 0 reads as the FOLLOWING Monday 2026-11-23 and no Saturday or Sunday is printed.
//  - the ONE-WEEK-LATER output (Monday 2026-11-23): every date is exactly seven days on from the one-read output.
// The weekend output's DATES are identical to the one-week-later output's: reading on Saturday binds to the very
// next working day, which is that Monday -- so a Saturday read and a Monday read agree. The diff is verified by
// pair_unchanged in the one-week-later red control.
fn the_handback_outputs_are_the_one_read_the_weekend_read_and_the_one_week_later_read() -> Bool {
  let sched = calendar_week_schedule()
  let one_read = dated_output(bound: bind_critical_path(schedule: sched, read_date: read_monday()))
  let weekend_read = dated_output(bound: bind_critical_path(schedule: sched, read_date: read_saturday()))
  let later_read = dated_output(bound: bind_critical_path(schedule: sched, read_date: read_one_week_later()))
  let expected_one = join([
    "read_date=2026-11-16 workers=1 critical_length=10",
    "  cal.week#0#0#0 days[0..5] dates[2026-11-16 -> 2026-11-23] count=declared",
    "  cal.week#1#0#0 days[5..7] dates[2026-11-23 -> 2026-11-25] count=declared",
    "  cal.week#2#0#0 days[7..10] dates[2026-11-25 -> 2026-11-30] count=declared",
  ], "\n")
  let expected_weekend = join([
    "read_date=2026-11-21 workers=1 critical_length=10",
    "  cal.week#0#0#0 days[0..5] dates[2026-11-23 -> 2026-11-30] count=declared",
    "  cal.week#1#0#0 days[5..7] dates[2026-11-30 -> 2026-12-02] count=declared",
    "  cal.week#2#0#0 days[7..10] dates[2026-12-02 -> 2026-12-07] count=declared",
  ], "\n")
  let expected_later = join([
    "read_date=2026-11-23 workers=1 critical_length=10",
    "  cal.week#0#0#0 days[0..5] dates[2026-11-23 -> 2026-11-30] count=declared",
    "  cal.week#1#0#0 days[5..7] dates[2026-11-30 -> 2026-12-02] count=declared",
    "  cal.week#2#0#0 days[7..10] dates[2026-12-02 -> 2026-12-07] count=declared",
  ], "\n")
  one_read == expected_one && weekend_read == expected_weekend && later_read == expected_later
}

// COMPUTED, CACHED, AND RE-READ. A read ALWAYS recomputes: a stale cached answer -- one held against a different
// read -- is NEVER served; the fresh binding wins. And a cache that the recompute confirms is current IS served,
// so `cached` is genuinely consumed (the unit reads it and its value can be the answer), not accepted and ignored.
fn a_cached_dated_answer_is_recomputed_on_read_and_is_never_authoritative_between_reads() -> Bool {
  let sched = calendar_week_schedule()
  let fresh_mon = bind_critical_path(schedule: sched, read_date: read_monday())
  let held_from_last_week = bind_critical_path(schedule: sched, read_date: read_one_week_later())
  // A stale cache (built against the NEXT week's read) must not be served on a Monday read -- the fresh dates win.
  let reread_with_stale = bind_critical_path_read(schedule: sched, read_date: read_monday(), cached: Present { value: held_from_last_week })
  let stale_not_served = dated_output(bound: reread_with_stale) == dated_output(bound: fresh_mon)
    && dated_output(bound: reread_with_stale) != dated_output(bound: held_from_last_week)
  // A current cache (the fresh Monday answer itself) IS served -- proving `cached` is read and can be the result.
  let reread_with_current = bind_critical_path_read(schedule: sched, read_date: read_monday(), cached: Present { value: fresh_mon })
  let current_served = dated_output(bound: reread_with_current) == dated_output(bound: fresh_mon)
  // And the currency test the re-read uses is itself checkable from the outside.
  let currency = dated_is_current(prior: fresh_mon, fresh: fresh_mon) && !dated_is_current(prior: held_from_last_week, fresh: fresh_mon)
  stale_not_served && current_served && currency
}

// FAIL CLOSED: a schedule that was never scheduled (here, a worker count of zero, which the scheduler refuses as
// a non-positive simulation input) cannot be bound to dates -- the binding is a typed refusal, not fabricated
// dates, and carries a visible cause.
fn binding_a_schedule_that_was_never_scheduled_is_refused() -> Bool {
  let chain = decomposition(node: "cal.week", waits_on: [], stages: [
    [leaf(label: "first", days: 5)],
    [leaf(label: "second", days: 2)],
    [leaf(label: "third", days: 3)],
  ])
  let refused = schedule(d: chain, e: expand_decomposition(d: chain, findings_count: 1), workers: 0)
  let bound = bind_critical_path(schedule: refused, read_date: read_monday())
  is_unbindable(bound: bound)
    && refusal_cause(bound: bound) != ""
    && count(dated_critical_path(bound: bound)) == 0
}

// HANDBACK ARTIFACT -- THE DIFF. One leaf of each binding, matched by its abstract finish day, checked: BOTH its
// dates moved by exactly seven calendar days, and NOTHING else -- path, abstract start/finish days, count source
// -- changed.
fn pair_unchanged(first: List<DatedLeaf>, later: List<DatedLeaf>, finish: Int) -> Bool {
  match first_where(first, d => d.finish_day == finish) {
    Absent => false
    Present { value: f } => match first_where(later, d => d.finish_day == finish) {
      Absent => false
      Present { value: l } =>
        days_between(from: f.start_date, to: l.start_date) == 7
        && days_between(from: f.finish_date, to: l.finish_date) == 7
        && l.start_day == f.start_day
        && l.finish_day == f.finish_day
        && path_key(p: l.path) == path_key(p: f.path)
        && count_source_text(count: l.count_source) == count_source_text(count: f.count_source)
    }
  }
}
