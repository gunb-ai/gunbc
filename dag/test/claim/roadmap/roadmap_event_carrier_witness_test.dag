module test.claim.roadmap.roadmap_event_carrier_witness_test

import std.types { Bool, String, FilePath, NonEmptyStr }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.principal_projection { PrincipalRef }
import gunbc.roadmap.roadmap_event_log { RoadmapEvent, Claimed, roadmap_event_envelope, RoadmapEventId, EventPrincipalAuthenticated }
import gunbc.roadmap.roadmap_event_carrier {
  roadmap_event_carrier_layout, roadmap_event_node_dir, roadmap_event_file_relative, roadmap_event_push_refspec, roadmap_event_commit_message,
  roadmap_events_branch, roadmap_events_decode_reads, EventFileRead, EventFileContent, EventFileUnreadable, RoadmapEventsRead, EventsRead, EventsReadRefused,
  RoadmapAllEventsRead, AllEventsRead, AllEventsReadRefused, roadmap_all_events_of_reads,
}
import gunbc.roadmap.roadmap_event_log { roadmap_event_wire_text }

fn self_claimed(node: RoadmapNodeId, author: String, at: String) -> RoadmapEventEnvelope {
  let ref = PrincipalRef { authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: author as NonEmptyStr }
  let principal = EventPrincipalAuthenticated { ref: ref }
  roadmap_event_envelope(e: RoadmapEvent { node: node, author: principal, parent: none, kind: Claimed { assignee: principal, return_to: principal }, recorded_at: at })
}

// The carrier's layout is a function of the instance roots: the worktree hangs under the instance
// root, events are addressed by node and content id, and the push refspec names one branch both ways.
test fn the_layout_addresses_events_by_node_and_id_under_the_instance_root() -> Bool {
  let l = roadmap_event_carrier_layout(repo_root: "/repo" as FilePath, instance_root: "/inst" as FilePath, git_program: "/usr/bin/git", directory_program: "/usr/bin/install")
  let node = "demo-node" as RoadmapNodeId
  let env = self_claimed(node: node, author: "s1", at: "t")
  (l.worktree as String) == "/inst/roadmap-events"
    && roadmap_event_node_dir(layout: l, node: node) == "/inst/roadmap-events/events/demo-node"
    && roadmap_event_file_relative(node: node, id: env.id) == join(["events/demo-node/", env.id as String, ".json"], "")
    && roadmap_event_push_refspec() == join([roadmap_events_branch as String, ":", roadmap_events_branch as String], "")
    && string_contains(s: roadmap_event_commit_message(env: env), pattern: "demo-node")
}

// DISCRIMINATING: no files is the empty set (a node nobody touched); an unreadable file refuses the
// whole read naming the read step; an undecodable file refuses naming the decode step rather than
// dropping the bad file; a well-formed file decodes. All over constructed reads, no filesystem.
test fn an_empty_node_reads_as_no_events_and_a_bad_file_refuses_the_read() -> Bool {
  let node = "demo-node" as RoadmapNodeId
  let good = roadmap_event_wire_text(env: self_claimed(node: node, author: "s1", at: "t"))
  let empty = roadmap_events_decode_reads(node: node, reads: [])
  let unreadable = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: good }, EventFileUnreadable { detail: "permission denied" }])
  let undecodable = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: "not json" }])
  let decoded = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: good }])
  (match empty { EventsRead { node: _, envelopes } => count(envelopes) == 0  EventsReadRefused { node: _, step: _, reason: _ } => false })
    && (match unreadable { EventsReadRefused { node: _, step, reason } => step == "read" && string_contains(s: reason, pattern: "permission denied")  EventsRead { node: _, envelopes: _ } => false })
    && (match undecodable { EventsReadRefused { node: _, step, reason: _ } => step == "decode"  EventsRead { node: _, envelopes: _ } => false })
    && (match decoded { EventsRead { node: _, envelopes } => count(envelopes) == 1  EventsReadRefused { node: _, step: _, reason: _ } => false })
}

// THE ALL-EVENTS COMPOSITION (the recents feed's carrier): per-node reads concatenate with every
// envelope kept, in node order; the first refusal refuses the whole read, named by node and step —
// one damaged directory never silently narrows the population.
test fn the_all_events_read_concatenates_and_the_first_refusal_refuses_the_whole() -> Bool {
  let n1 = "node-one" as RoadmapNodeId
  let n2 = "node-two" as RoadmapNodeId
  let a = self_claimed(node: n1, author: "s1", at: "t1")
  let b = self_claimed(node: n2, author: "s2", at: "t2")
  let c = self_claimed(node: n2, author: "s3", at: "t3")
  let joined = roadmap_all_events_of_reads(reads: [
    EventsRead { node: n1, envelopes: [a] },
    EventsRead { node: n2, envelopes: [b, c] },
  ])
  let refused = roadmap_all_events_of_reads(reads: [
    EventsRead { node: n1, envelopes: [a] },
    EventsReadRefused { node: n2, step: "decode", reason: "corrupt" },
  ])
  let empty = roadmap_all_events_of_reads(reads: [])
  (match joined { AllEventsRead { envelopes } => count(envelopes) == 3  AllEventsReadRefused { step: _, reason: _ } => false })
    && (match refused { AllEventsReadRefused { step, reason } => step == "node node-two decode" && reason == "corrupt"  AllEventsRead { envelopes: _ } => false })
    && (match empty { AllEventsRead { envelopes } => count(envelopes) == 0  AllEventsReadRefused { step: _, reason: _ } => false })
}
