module test.claim.roadmap.roadmap_event_carrier_witness_test

import gunbc.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric_storage_file_store { fabric_storage_file_root }
import test.claim.roadmap.roadmap_task_projection_witness_test { editorial_graph_creation }

import std.types { Bool, String, NonEmptyStr }
import std.fabric_storage { ExpectHeadAbsent, FabricClosureRead, FabricHeadAbsent, FabricHeadAt, FabricStoredObject, FabricObject, fabric_object_ref_of, FabricStoreUnreachable, FabricClosureRefused }
import gunbc.principal_projection { fabric_workflow_principal }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_event_log { RoadmapEvent, Progress, LegacyEmailPrincipal, roadmap_event_envelope, roadmap_event_wire_text, event_principal_authenticated }
import gunbc.roadmap.roadmap_event_carrier {
  roadmap_event_append_snapshot, roadmap_event_carrier_service_layout, EventAppendRefused, RoadmapEventSnapshot, roadmap_migration_gate_check, roadmap_migration_gate_schema, roadmap_event_object, roadmap_event_manifest_schema, roadmap_snapshot_from_closure, roadmap_event_wire_admits,
  RoadmapEventSnapshotObserved, RoadmapEventSnapshotRefused,
  roadmap_events_decode_reads, EventFileContent, EventFileUnreadable, EventsRead, EventsReadRefused,
}

fn roadmap_carrier_test_event(note: NonEmptyStr) -> RoadmapEvent {
  RoadmapEvent { node: "demo-node" as RoadmapNodeId, author: event_principal_authenticated(ref: fabric_workflow_principal), parent: none, kind: Progress { note: note }, recorded_at: "2026-09-27T00:00:00Z" }
}

test fn roadmap_fabric_manifest_preserves_original_event_identity_and_bytes() -> Bool {
  let envelope = roadmap_event_envelope(e: roadmap_carrier_test_event(note: "first"))
  let wire = roadmap_event_wire_text(env: envelope) as NonEmptyStr
  let event = roadmap_event_object(wire: wire)
  let event_ref = fabric_object_ref_of(object: event)
  let manifest = FabricObject { links: [event_ref], body: roadmap_event_manifest_schema }
  let head = fabric_object_ref_of(object: manifest)
  match roadmap_snapshot_from_closure(observation: FabricClosureRead {
    reading: FabricHeadAt { object: head, generation: 1 }, newest_first: [FabricStoredObject { object: head, content: manifest }, FabricStoredObject { object: event_ref, content: event }],
  }) {
    RoadmapEventSnapshotObserved { snapshot } => match snapshot.events.first() {
      Present { value: stored } => snapshot.events.count() == 1 && stored.envelope.id == envelope.id && stored.wire == wire
      Absent => false
    }
    _ => false
  }
}

test fn roadmap_fabric_missing_link_refuses_instead_of_returning_partial_history() -> Bool {
  let event = roadmap_event_object(wire: roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_carrier_test_event(note: "first"))) as NonEmptyStr)
  let manifest = FabricObject { links: [fabric_object_ref_of(object: event)], body: roadmap_event_manifest_schema }
  let head = fabric_object_ref_of(object: manifest)
  match roadmap_snapshot_from_closure(observation: FabricClosureRead { reading: FabricHeadAt { object: head, generation: 1 }, newest_first: [FabricStoredObject { object: head, content: manifest }] }) {
    RoadmapEventSnapshotRefused { step, reason: _ } => step == "read"
    _ => false
  }
}

test fn roadmap_empty_head_and_unreadable_history_are_distinct() -> Bool {
  let empty = roadmap_snapshot_from_closure(observation: FabricClosureRead { reading: FabricHeadAbsent, newest_first: [] })
  let unreadable = roadmap_snapshot_from_closure(observation: FabricClosureRefused { fault: FabricStoreUnreachable { detail: "offline" } })
  (match empty { RoadmapEventSnapshotObserved { snapshot } => snapshot.events.count() == 0 _ => false })
    && (match unreadable { RoadmapEventSnapshotRefused { step, reason: _ } => step == "read" _ => false })
}

test fn an_empty_node_reads_as_no_events_and_a_bad_file_refuses_the_read() -> Bool {
  let node = "demo-node" as RoadmapNodeId
  let good = roadmap_event_wire_text(env: roadmap_event_envelope(e: roadmap_carrier_test_event(note: "first")))
  let empty = roadmap_events_decode_reads(node: node, reads: [])
  let unreadable = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: good }, EventFileUnreadable { detail: "permission denied" }])
  let undecodable = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: "not json" }])
  let decoded = roadmap_events_decode_reads(node: node, reads: [EventFileContent { content: good }])
  (match empty { EventsRead { node: _, envelopes } => count(envelopes) == 0 _ => false })
    && (match unreadable { EventsReadRefused { node: _, step, reason } => step == "read" && string_contains(s: reason, pattern: "permission denied") _ => false })
    && (match undecodable { EventsReadRefused { node: _, step, reason: _ } => step == "decode" _ => false })
    && (match decoded { EventsRead { node: _, envelopes } => count(envelopes) == 1 _ => false })
}

test fn roadmap_current_write_requires_readable_authenticated_event_bytes() -> Bool {
  let valid = roadmap_event_envelope(e: roadmap_carrier_test_event(note: "verified author"))
  let invalid = roadmap_event_envelope(e: RoadmapEvent { node: "demo-node" as RoadmapNodeId,
    author: LegacyEmailPrincipal { email: "legacy@example.test", authentication_unestablished: true },
    parent: none, kind: Progress { note: "unverified new write" }, recorded_at: "2026-09-27T00:00:00Z" })
  roadmap_event_wire_admits(envelope: valid, wire: roadmap_event_wire_text(env: valid) as NonEmptyStr)
    && !roadmap_event_wire_admits(envelope: invalid, wire: roadmap_event_wire_text(env: invalid) as NonEmptyStr)
}

test fn roadmap_production_empty_history_requires_completed_migration() -> Bool {
  match roadmap_migration_gate_check(snapshot: RoadmapEventSnapshot { expected: ExpectHeadAbsent, events: [] },
    observation: FabricClosureRead { reading: FabricHeadAbsent, newest_first: [] }) {
    RoadmapEventSnapshotRefused { step: refused_step, reason: _ } => refused_step == "migration"
    _ => false
  }
}

test fn roadmap_migration_gate_refuses_lost_baseline_history() -> Bool {
  let lost = roadmap_event_object(wire: "lost-history")
  let baseline = FabricObject { links: [fabric_object_ref_of(object: lost)], body: roadmap_event_manifest_schema }
  let baseline_ref = fabric_object_ref_of(object: baseline)
  let receipt = FabricObject { links: [baseline_ref], body: "{\"schema\":\"roadmap-event-import/v1\"}" }
  let receipt_ref = fabric_object_ref_of(object: receipt)
  let marker = FabricObject { links: [baseline_ref, receipt_ref], body: roadmap_migration_gate_schema }
  let marker_ref = fabric_object_ref_of(object: marker)
  match roadmap_migration_gate_check(snapshot: RoadmapEventSnapshot { expected: ExpectHeadAbsent, events: [] },
    observation: FabricClosureRead { reading: FabricHeadAt { object: marker_ref, generation: 1 }, newest_first: [
      FabricStoredObject { object: marker_ref, content: marker }, FabricStoredObject { object: baseline_ref, content: baseline },
      FabricStoredObject { object: receipt_ref, content: receipt }, FabricStoredObject { object: fabric_object_ref_of(object: lost), content: lost },
    ] }) {
    RoadmapEventSnapshotRefused { step: refused_step, reason: _ } => refused_step == "migration"
    _ => false
  }
}


test fn production_append_refuses_unknown_prerequisite_before_storage_effects() -> Bool {
  let layout = roadmap_event_carrier_service_layout(store: FabricStorageLocalFiles { root: fabric_storage_file_root(root: "/tmp/this-fixture-is-never-created") })
  match roadmap_event_append_snapshot(layout: layout, snapshot: RoadmapEventSnapshot { expected: ExpectHeadAbsent, events: [] },
    event: editorial_graph_creation(node: "a", dependencies: ["unknown" as RoadmapNodeId])) {
    EventAppendRefused { id: _, step: failed_step, reason: _ } => failed_step == "relationships"
    _ => false
  }
}
