module test.claim.roadmap.roadmap_review_role_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.algebra { FreeSemigroup }
import gunbc.roadmap.roadmap_review_role {
  review_verdict_instruction,
  HeadVerdict, ReviewApproved, ReviewChangesRequested, ReviewCannotJudge,
  ReviewVerdictDecode, ReviewVerdictDecoded, ReviewVerdictUndecodable,
  ReviewReceiptSource, ReviewReceiptAbsent, ReviewReceiptPresent, ReviewReceiptUnreadable,
  CriterionReviewEvidence, review_reconcile, review_all_approved,
  review_verdict_decode, review_verdict_key, review_verdict_detail, review_brief,
  ConformanceAnswer, Conforms, DivergesStated, DivergesUnstated, conformance_answer_verdict, review_answer_instruction, ReviewReason,
  CriterionStanding, CriterionApproved, CriterionChangesRequested, CriterionCannotJudge,
  CriterionReviewerExitedWithoutVerdict, CriterionReviewerSignaledWithoutVerdict, CriterionReviewerUnobserved, CriterionReviewerRunning, CriterionAwaitingReviewer,
  CriterionUndecodable, CriterionUnreadable,
  standing_ended_without_verdict, review_refusal_cause_class,
  review_receipt_is_approval, review_receipt_present_is_approval, review_carried_approval, review_round_indices_below,
}
import gunbc.roadmap.roadmap_refused_retry { RefusalCauseClass, RefusalCauseInfrastructure, RefusalCauseCandidate }
import gunbc.roadmap.roadmap_review_criteria { review_criteria, review_criteria_grounded_in_the_argument, review_criterion_by_key, review_criteria_homes_match_their_algebra, review_criterion_identity_text, review_home_text, conformance_criterion_from_domain }
import std.decl_ref { DeclarationRef, declaration_ref_display_key, decl_ref }
import gunbc.design_argument { YesIsADefect, ConformanceThreeValued, conformance_domains, ConformanceDomain, ConformanceHomeGroup, conformance_domain_homes }
import gunbc.design_document { expected_design_md, conformance_domain_section }
import extdeps.languages.markdown { serialize_markdown_source }
import std.markdown { MarkdownDocument }
import gunbc.roadmap.roadmap_workflow_stage { WorkflowSegmentComplete, WorkflowSegmentFailed, WorkflowSegmentRefused, WorkflowSegmentActive, WorkflowSegmentPending }
import gunbc.worker_lifecycle { WorkerProcessAbsent, WorkerProcessRunning, WorkerProcessExited }

fn approve_text(summary: String) -> String {
  join(["{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"approve\",\"summary\":\"", summary, "\"}"], "")
}
fn changes_text(path: String, reason: String) -> String {
  join(["{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"request_changes\",\"reasons\":[{\"path\":\"", path, "\",\"reason\":\"", reason, "\"}]}"], "")
}
fn present(key: String, text: String) -> CriterionReviewEvidence {
  CriterionReviewEvidence { criterion_key: key, source: ReviewReceiptPresent { text: text }, process: WorkerProcessAbsent }
}

test fn an_approve_verdict_decodes() -> Bool {
  match review_verdict_decode(text: approve_text(summary: "does what the goal says")) {
    ReviewVerdictDecoded { verdict } => review_verdict_key(v: verdict) == "approved" && review_verdict_detail(v: verdict) == "does what the goal says"
    ReviewVerdictUndecodable { reason: _ } => false
  }
}

test fn request_changes_carries_located_reasons() -> Bool {
  match review_verdict_decode(text: changes_text(path: "dag/a.dag", reason: "the arm is missing")) {
    ReviewVerdictDecoded { verdict } => review_verdict_key(v: verdict) == "changes_requested" && review_verdict_detail(v: verdict) == "dag/a.dag: the arm is missing"
    ReviewVerdictUndecodable { reason: _ } => false
  }
}

// DISCRIMINATING: the decoder refuses rather than guessing -- wrong schema, empty reasons, a bare
// approve with no summary, non-JSON, and an unknown word are each undecodable.
test fn malformed_verdicts_are_undecodable() -> Bool {
  let cases = [
    "{\"schema\":\"other/v1\",\"verdict\":\"approve\",\"summary\":\"x\"}",
    "{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"request_changes\",\"reasons\":[]}",
    "{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"approve\"}",
    "not json at all",
    "{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"maybe\"}",
  ]
  all(cases, c => match review_verdict_decode(text: c) { ReviewVerdictUndecodable { reason: _ } => true  ReviewVerdictDecoded { verdict: _ } => false })
}

// DISCRIMINATING: the reconciliation's dominance order. Reviews of different criteria disagree by
// design; changes-requested fails the head naming its criterion, a cannot-judge blocks, a running
// reviewer is active, an unstarted one is pending, and only all-approved completes.
test fn the_reconciliation_orders_changes_over_blocks_over_running_over_pending_over_approved() -> Bool {
  let a = present(key: "closed-grounded-substrate", text: approve_text(summary: "fits"))
  let b = present(key: "fail-closed", text: changes_text(path: "dag/x.dag", reason: "an arm widens"))
  let c = present(key: "single-authority", text: "{\"schema\":\"roadmap-review-verdict/v1\",\"verdict\":\"cannot_judge\",\"reason\":\"the check refused to start\"}")
  let running = CriterionReviewEvidence { criterion_key: "minimize-redundancy", source: ReviewReceiptAbsent, process: WorkerProcessRunning { command: "gunbc" as NonEmptyStr } }
  let waiting = CriterionReviewEvidence { criterion_key: "how-to-work", source: ReviewReceiptAbsent, process: WorkerProcessAbsent }
  let mixed = review_reconcile(evidence: [a, b, c, running, waiting])
  let blocked = review_reconcile(evidence: [a, c, running])
  let active = review_reconcile(evidence: [a, running, waiting])
  let pending = review_reconcile(evidence: [a, waiting])
  let green = review_reconcile(evidence: [a, present(key: "fail-closed", text: approve_text(summary: "no arm widens"))])
  (match mixed.state { WorkflowSegmentFailed => true  _ => false }) && string_contains(s: mixed.detail, pattern: "fail-closed: changes requested") && !string_contains(s: mixed.detail, pattern: "closed-grounded: approved")
    && (match blocked.state { WorkflowSegmentRefused => true  _ => false }) && string_contains(s: blocked.detail, pattern: "single-authority: cannot judge")
    && (match active.state { WorkflowSegmentActive => true  _ => false })
    && (match pending.state { WorkflowSegmentPending => true  _ => false })
    && (match green.state { WorkflowSegmentComplete => true  _ => false })
    && review_all_approved(evidence: [a, present(key: "fail-closed", text: approve_text(summary: "ok"))])
    && !review_all_approved(evidence: [a, waiting])
    && !review_all_approved(evidence: [])
}

// Every design-grounded criterion names a proposition the modeled argument carries; the roster is
// entailed by gunbc.design_argument, not asserted beside it.
test fn every_review_criterion_is_grounded_in_the_design_argument() -> Bool {
  review_criteria_grounded_in_the_argument() && count(review_criteria) >= 5
    && (match review_criterion_by_key(key: "single-authority") { Present { value: _ } => true  Absent => false })
}

test fn the_brief_carries_the_criterion_the_diff_range_and_the_check_and_the_verdict_instruction_is_separate() -> Bool {
  match review_criterion_by_key(key: "fail-closed") {
    Absent => false
    Present { value: c } => {
      let b = review_brief(criterion: c, node_id: "n1", headline: "H", boundary: "B", out_of_scope: "O", red_control: "R", acceptance_command: "gunbc run x", base_sha: "aaa", head_sha: "bbb", verification_detail: "passed")
      string_contains(s: b, pattern: "git diff aaa..bbb")
        && string_contains(s: b, pattern: "Criterion (fail-closed, grounded on DESIGN proposition fail_closed)")
        && string_contains(s: b, pattern: "Acceptance command: gunbc run x")
        && !string_contains(s: b, pattern: "Write your verdict")
        && string_contains(s: review_verdict_instruction(verdict_path: "/v.json"), pattern: "Write your verdict to /v.json")
    }
  }
}

// THE CONFORMANCE ANSWER IS THREE-VALUED AND ONLY THE UNSTATED DIVERGENCE REQUESTS CHANGES (
// gunbc.design_argument::conformance). The stated divergence is admitted and keeps its reason; the instruction rendered for a
// conformance criterion says all three, while the yes/no instruction says neither.
test fn a_stated_divergence_is_admitted_and_an_unstated_one_requests_changes() -> Bool {
  let stated = conformance_answer_verdict(a: DivergesStated { reason: "the lease home cannot express a sub-second deadline" })
  let unstated = conformance_answer_verdict(a: DivergesUnstated { reasons: [ReviewReason { path: "dag/x.dag", reason: "a sleep where a HeldLease was available" }] })
  let conforms = conformance_answer_verdict(a: Conforms { summary: "inhabits std.temporal_effect HeldLease" })
  review_verdict_key(v: stated) == "approved" && string_contains(s: review_verdict_detail(v: stated), pattern: "reason stated: the lease home")
    && review_verdict_key(v: unstated) == "changes_requested"
    && review_verdict_key(v: conforms) == "approved"
    && string_contains(s: review_answer_instruction(a: ConformanceThreeValued), pattern: "one of three ways")
    && !string_contains(s: review_answer_instruction(a: YesIsADefect), pattern: "one of three ways")
}

// EVERY CONFORMANCE DOMAIN IS A REVIEWER WITH ITS HOMES IN THE BRIEF; no yes/no criterion carries a
// home, and the discriminating half is the negation: the fail-closed brief names no home at all.
// EVERY CONFORMANCE DOMAIN CARRIES A NON-EMPTY LABEL AND OWNS LINE FOR THE DESIGN.MD PROJECTION, AND
// AT LEAST ONE BOUNDARY. The gunbc.design_argument::conformance roster is projected from these rows rather than hand-authored, so an
// empty label would produce a blank heading, an empty owns line would leave the reader without the
// domain's responsibility, and a domain with no stated boundary gives the reader no way to tell it
// from its neighbours.
test fn every_conformance_domain_carries_a_label_owns_and_boundary() -> Bool {
  count(conformance_domains) > 0
    && all(conformance_domains, d => match review_criterion_by_key(key: d.key) {
      Present { value: _ } => d.label != "" && d.owns != "" && count(d.boundaries) > 0 && all(d.boundaries, b => b != "")
      Absent => false
    })
}

fn synthetic_homes(head: String, tail: List<String>) -> FreeSemigroup<DeclarationRef> {
  FreeSemigroup {
    head: decl_ref(module_path: "std.types", decl_name: head),
    tail: map(tail, n => decl_ref(module_path: "std.types", decl_name: n)),
  }
}

fn synthetic_domain(label: String, owns: String) -> ConformanceDomain {
  ConformanceDomain {
    key: "test-synthetic-domain",
    label: label,
    question: "Is this a test?",
    tells: ["a synthetic tell that exists only in this test"],
    owns: owns,
    boundaries: ["a synthetic boundary"],
    home_groups: FreeSemigroup {
      head: ConformanceHomeGroup { label: "Synthetic group", purpose: "exists only in this test", homes: synthetic_homes(head: "Bool", tail: ["Unit"]) },
      tail: [],
    },
  }
}

test fn a_one_element_conformance_home_list_renders_as_before() -> Bool {
  let expected = join([
    "### one element domain\n\n",
    "**Owns.** one home is enough\n\n",
    "**Boundary.** a synthetic boundary\n\n",
    "**Existing authorities**\n\n",
    "- **Synthetic group** — exists only in this test\n",
    "  - `std.types::Bool`\n",
  ], "")
  let d = ConformanceDomain {
    key: "test-one-home",
    label: "one element domain",
    question: "Is this a test?",
    tells: ["a synthetic tell that exists only in this test"],
    owns: "one home is enough",
    boundaries: ["a synthetic boundary"],
    home_groups: FreeSemigroup {
      head: ConformanceHomeGroup {
        label: "Synthetic group",
        purpose: "exists only in this test",
        homes: synthetic_homes(head: "Bool", tail: []),
      },
      tail: [],
    },
  }
  rendered_domain(d: d) == expected
}

fn rendered_domain(d: ConformanceDomain) -> String {
  serialize_markdown_source(doc: MarkdownDocument { blocks: conformance_domain_section(d: d) })
}

// THE gunbc.design_argument::conformance ROSTER IS PROJECTED FROM CONFORMANCE_DOMAINS, NOT HAND-AUTHORED. The
// synthetic-domain proof constructs a domain that does not exist in the production roster and proves
// the renderer produces exactly the expected output for it: one ConformanceDomain row → exactly one
// DESIGN subsection, with its homes grouped and one per line, rather than the weaker "today's
// document mentions today's domains."
test fn a_synthetic_conformance_domain_produces_exactly_one_design_section() -> Bool {
  let expected = join([
    "### synthetic test domain\n\n",
    "**Owns.** this domain exists only to prove the renderer is a pure function of its input\n\n",
    "**Boundary.** a synthetic boundary\n\n",
    "**Existing authorities**\n\n",
    "- **Synthetic group** — exists only in this test\n",
    "  - `std.types::Bool`\n",
    "  - `std.types::Unit`\n",
  ], "")
  rendered_domain(d: synthetic_domain(label: "synthetic test domain", owns: "this domain exists only to prove the renderer is a pure function of its input")) == expected
}

// THE PRODUCTION DOMAINS ARE ALSO PROJECTED, SO ADDING A DOMAIN CREATES BOTH A DESIGN SECTION AND A
// REVIEW CRITERION, AND CHANGING A HOME CHANGES BOTH.
test fn production_conformance_domains_appear_in_generated_design() -> Bool {
  let md = expected_design_md()
  string_contains(s: md, pattern: "## Reference: conformance domains")
    && all(conformance_domains, d =>
      string_contains(s: md, pattern: concat("### ", d.label))
        && all(conformance_domain_homes(d: d), h => string_contains(s: md, pattern: concat("`", concat(review_home_text(h: h), "`"))))
    )
}

// THE PLAN REVISION IS UNAFFECTED BY THE READER-FACING FIELDS. review_criterion_identity_text hashes
// key, question, tells, answer algebra and homes; label, owns, boundaries and group wording are not
// ReviewCriterion fields, so rewording them cannot invalidate a prior observation. Two domains
// differing only there render differently but share one criterion identity.
test fn label_and_owns_change_projection_but_not_criterion_identity() -> Bool {
  let domain_a = synthetic_domain(label: "label A", owns: "owns A")
  let domain_b = synthetic_domain(label: "label B", owns: "owns B")
  let block_a = rendered_domain(d: domain_a)
  let block_b = rendered_domain(d: domain_b)
  let criterion_a = conformance_criterion_from_domain(domain: domain_a, proposition_id: "conformance")
  let criterion_b = conformance_criterion_from_domain(domain: domain_b, proposition_id: "conformance")
  block_a != block_b
    && review_criterion_identity_text(c: criterion_a) == review_criterion_identity_text(c: criterion_b)
    && string_contains(s: block_a, pattern: "label A")
    && string_contains(s: block_b, pattern: "owns B")
}

test fn conformance_reader_text_does_not_affect_plan_revision() -> Bool {
  match review_criterion_by_key(key: "conformance-extdeps") {
    Present { value: c } => {
      let id = review_criterion_identity_text(c: c)
      string_contains(s: id, pattern: "conformance-extdeps")
        && string_contains(s: id, pattern: "conformance-three-valued")
        && string_contains(s: id, pattern: "extdeps.external_authority::ExternalModelScope")
    }
    Absent => false
  }
}

test fn every_conformance_domain_is_a_criterion_whose_brief_names_its_homes() -> Bool {
  review_criteria_homes_match_their_algebra()
    && all(conformance_domains, d => match review_criterion_by_key(key: d.key) {
      Absent => false
      Present { value: c } => {
        let b = review_brief(criterion: c, node_id: "n1", headline: "H", boundary: "B", out_of_scope: "O", red_control: "R", acceptance_command: "gunbc run x", base_sha: "aaa", head_sha: "bbb", verification_detail: "passed")
        string_contains(s: b, pattern: "Home authorities the change must inhabit")
          && string_contains(s: b, pattern: "one of three ways")
          && all(conformance_domain_homes(d: d), h => string_contains(s: b, pattern: declaration_ref_display_key(ref: h)))
      }
    })
    && (match review_criterion_by_key(key: "fail-closed") {
      Absent => false
      Present { value: c } => !string_contains(s: review_brief(criterion: c, node_id: "n1", headline: "H", boundary: "B", out_of_scope: "O", red_control: "R", acceptance_command: "x", base_sha: "a", head_sha: "b", verification_detail: "p"), pattern: "Home authorities")
    })
}

// THE ENVIRONMENT-REFUSED CLASSIFIER (the route-out gate, symmetric to verification's refusal cause).
// A review refusal is an ENVIRONMENT refusal only when NO criterion spoke AND every reviewer ended
// without a verdict -- the srv1 218/CAPABILITIES case (all 17 reviewers died before writing). Anything
// else -- a real verdict, an unreadable/cannot-judge/unobserved/running reviewer, or no criteria at all
// -- is about the candidate and keeps the operator-only disposition. fail_closed: never guess an
// environment cause, because an environment classification is what unlocks the re-run.

fn died(key: String) -> CriterionStanding {
  CriterionReviewerExitedWithoutVerdict { key: key, exit_code: 218 }
}

test fn review_refusal_every_reviewer_died_is_infrastructure() -> Bool {
  // The primitive itself: an ended-without-verdict standing is the environment signature; a verdict is not.
  standing_ended_without_verdict(s: died("a"))
    && standing_ended_without_verdict(s: CriterionReviewerSignaledWithoutVerdict { key: "b", signal: 9 })
    && !standing_ended_without_verdict(s: CriterionApproved { key: "c", summary: "ok" })
    && review_refusal_cause_class(standings: [died("a"), died("b")]) == RefusalCauseInfrastructure
    && review_refusal_cause_class(standings: [CriterionReviewerSignaledWithoutVerdict { key: "a", signal: 9 }]) == RefusalCauseInfrastructure
    // RED CONTROL: a mix of died and signaled is still "nobody spoke" -- infrastructure.
    && review_refusal_cause_class(standings: [died("a"), CriterionReviewerSignaledWithoutVerdict { key: "b", signal: 9 }]) == RefusalCauseInfrastructure
}

test fn review_refusal_one_real_verdict_is_candidate() -> Bool {
  // A SUBSTANTIVE non-approve verdict is the review SPEAKING about the candidate: with or without
  // environment deaths beside it, the review stays candidate-refused -- the operator decides, never a
  // re-run (fail_closed). Cannot-judge is the reviewer's refusal on the candidate's merits; an
  // undecodable/unreadable verdict's bytes are never re-run away.
  review_refusal_cause_class(standings: [CriterionChangesRequested { key: "a", reasons: [] as List<ReviewReason> }]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionChangesRequested { key: "a", reasons: [] as List<ReviewReason> }, died("b")]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionCannotJudge { key: "a", reason: "cannot judge" }, died("b")]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionUndecodable { key: "a", reason: "bad json" }, died("b")]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionUnreadable { key: "a", detail: "eio" }, died("b")]) == RefusalCauseCandidate
}

test fn review_refusal_approvals_with_environment_deaths_is_infrastructure() -> Bool {
  // THE #16401 FOLLOW-UP (srv1 2026-11-13): approvals beside environment deaths, with NOTHING objecting,
  // is an ENVIRONMENT refusal -- some reviewers spoke (approved), the rest died before speaking, so a
  // re-run is owed and the approvals carry forward. #16401 read ANY produced verdict as "about the
  // candidate" and joined the item forever (v1-interpreter-primitive-dispatch-authority, 1c7eac6839e69d42
  // r1: 2 approved, 15 OOM-killed), though nothing objected to the work.
  review_refusal_cause_class(standings: [CriterionApproved { key: "a", summary: "ok" }, died("b")]) == RefusalCauseInfrastructure
    // RED CONTROL: several approvals, several deaths, no substantive objection -> still environment.
    && review_refusal_cause_class(standings: [
      CriterionApproved { key: "a", summary: "ok" },
      CriterionApproved { key: "b", summary: "ok" },
      died("c"),
      CriterionReviewerSignaledWithoutVerdict { key: "d", signal: 9 },
    ]) == RefusalCauseInfrastructure
}

test fn review_refusal_unobserved_or_silent_or_cannot_judge_or_empty_is_candidate() -> Bool {
  // fail_closed: a reviewer we cannot observe, one still running/awaiting, a cannot-judge judgment, or
  // no criteria at all is never classified as an environment death.
  review_refusal_cause_class(standings: [CriterionReviewerUnobserved { key: "a", reason: "no record" }, died("b")]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionReviewerRunning { key: "a" }]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionAwaitingReviewer { key: "a" }]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [CriterionCannotJudge { key: "a", reason: "cannot judge" }]) == RefusalCauseCandidate
    && review_refusal_cause_class(standings: [] as List<CriterionStanding>) == RefusalCauseCandidate
}

test fn the_approval_predicate_is_precise() -> Bool {
  // An approval carries; a changes-requested / cannot-judge / undecodable / unreadable record does not.
  review_receipt_is_approval(text: approve_text(summary: "ok"))
    && !review_receipt_is_approval(text: changes_text(path: "a", reason: "no"))
    && review_receipt_present_is_approval(receipt: ReviewReceiptPresent { text: approve_text(summary: "ok") })
    && !review_receipt_present_is_approval(receipt: ReviewReceiptAbsent)
    && !review_receipt_present_is_approval(receipt: ReviewReceiptUnreadable { detail: "eio" })
}

test fn a_recorded_approval_is_carried_forward() -> Bool {
  // An approval recorded in a PRIOR round (here: the newest prior round was an environment death with no
  // verdict, the one before that approved) is carried forward, verbatim, so the re-run re-launches only
  // the criteria still lacking a verdict -- not the ~10 GiB reviewer that already approved.
  match review_carried_approval(prior_receipts: [ReviewReceiptAbsent, ReviewReceiptPresent { text: approve_text(summary: "meets the goal") }]) {
    ReviewReceiptPresent { text } => text == approve_text(summary: "meets the goal")
    _ => false
  }
}

test fn no_substantive_record_is_carried_forward() -> Bool {
  // ONLY an approval carries -- fail_closed: a changes-requested / cannot-judge / undecodable / unreadable
  // earlier record never silently marks a criterion satisfied, and nothing recorded carries to Absent so
  // the criterion is re-run (the all-died #16401 case is unchanged).
  (match review_carried_approval(prior_receipts: [ReviewReceiptPresent { text: changes_text(path: "a", reason: "nope") }]) { ReviewReceiptAbsent => true _ => false })
    && (match review_carried_approval(prior_receipts: [ReviewReceiptPresent { text: "{not json" }]) { ReviewReceiptAbsent => true _ => false })
    && (match review_carried_approval(prior_receipts: [ReviewReceiptUnreadable { detail: "eio" }, ReviewReceiptAbsent]) { ReviewReceiptAbsent => true _ => false })
    && (match review_carried_approval(prior_receipts: [] as List<ReviewReceiptSource>) { ReviewReceiptAbsent => true _ => false })
}

test fn review_round_indices_below_enumerates_earlier_rounds() -> Bool {
  // The carry-forward scan reads every round BELOW the one being censused, none at or above it.
  review_round_indices_below(round: 0) == ([] as List<Int>)
    && review_round_indices_below(round: 1) == ([0] as List<Int>)
    && review_round_indices_below(round: 3) == ([0, 1, 2] as List<Int>)
}
