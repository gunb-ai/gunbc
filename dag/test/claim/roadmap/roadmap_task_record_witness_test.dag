module test.claim.roadmap_task_record_witness_test

import std.types { Bool, String, NonEmptyStr, FilePath, List }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeId, RoadmapNodeIdentity, Pointer, Dispatchable, PrsMerged, MemberOf }
import gunbc.roadmap_status { TicketLine, TicketFields, TicketUpdate, Unsigned }
import gunbc.roadmap_execution_contract { ExecutionContractUnspecified, gunbc_claims_execution_contract }
import gunbc.roadmap_task_record { roadmap_task_encode, roadmap_task_decode }

fn sample_ticket() -> TicketFields {
  TicketFields { headline: "Create tasks at runtime", brief: "b", displaced_cost: "d", current_state: "c", first_slice: "f", red_control: "r", out_of_scope: "o", handback: "h",
    updates: [TicketUpdate { on: "2026-10-09", note: "n" }], authored_on: "2026-10-09", last_verified_on: "" }
}

fn sample_task() -> RoadmapNode {
  RoadmapNode {
    identity: "task-0001" as RoadmapNodeIdentity, node: "runtime-task-one" as RoadmapNodeId,
    line: TicketLine { done: false, ticket: sample_ticket() },
    carriers: [Pointer { label: "plan", path: "docs/plans/x.md" }],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: gunbc_claims_execution_contract(entry: "dag/test/claim/x_test.dag" as FilePath, functions: ["a" as NonEmptyStr, "b" as NonEmptyStr]),
    owner: "briansrls", signoff: Unsigned,
    parent: Present { value: MemberOf { project: "roadmap-runtime", contribution: "creates tasks" as NonEmptyStr } },
    centering: Present { value: "daily workspace" as NonEmptyStr },
  }
}

// Round trip is exact: decode(encode(task)) re-encodes to the same bytes.
test fn task_record_round_trips() -> Bool {
  match roadmap_task_encode(node: sample_task()) {
    Absent => false
    Present { value: text } => match roadmap_task_decode(text: text) {
      Absent => false
      Present { value: back } => match roadmap_task_encode(node: back) { Absent => false Present { value: again } => again == text }
    }
  }
}

// Strict decode: a wrong schema id and a missing identity are refused, not defaulted.
test fn task_record_decode_refuses_wrong_schema_and_missing_identity() -> Bool {
  match roadmap_task_encode(node: sample_task()) {
    Absent => false
    Present { value: text } => {
      let wrong_schema = replace(text, "gunbc.roadmap-task/v1", "gunbc.roadmap-task/v2")
      let no_identity = replace(text, "\"identity\":", "\"identit\":")
      let none_a = match roadmap_task_decode(text: wrong_schema) { Absent => true Present { value: _ } => false }
      let none_b = match roadmap_task_decode(text: no_identity) { Absent => true Present { value: _ } => false }
      none_a && none_b
    }
  }
}

// A contract with no wire form is refused at encode, never silently narrowed.
test fn task_record_encode_refuses_signed_task() -> Bool {
  let base = sample_task()
  let signed = RoadmapNode { identity: base.identity, node: base.node, line: TicketLine { done: true, ticket: sample_ticket() }, carriers: base.carriers, dispatch: base.dispatch, execution: ExecutionContractUnspecified, owner: base.owner, signoff: Unsigned, parent: base.parent, centering: base.centering }
  match roadmap_task_encode(node: signed) { Absent => true Present { value: _ } => false }
}
