module test.claim.roadmap.attempt_state_store_wet_witness

import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem, FilesystemReadSucceeded, FilesystemReadRefused, FilesystemWritten, FilesystemWriteRefused, FilesystemReadOutcome, FilesystemWriteOutcome }
import std.types { Bool, String, NonEmptyStr, FilePath }
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { deployment_id }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import gunbc.roadmap.roadmap_attempt_state_store {
  AttemptDirectoryRoot, AttemptLaunchIdentity, AttemptSpawnFailure, attempt_state_directory_text,
  attempt_state_read_at, attempt_state_write_at, 
}

// THE STORE'S OPERATIONS RUN WET against a fresh temporary instance: write then read back through the store, the
// bytes an earlier layout wrote (planted under the unchanged file name, independent of the store's own name row)
// read through the store, an attempt directory that does not list refusing both operations, and a member
// staying independent of its sibling. The layout does not move, so the old bytes are the same bytes.

fn fresh_instance(tag: String) -> HostDashboardInstance {
  let dir = shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_binding_", tag, ".XXXXXX"], "")).path
  isolated_dashboard_instance(
    deployment: deployment_id(name: "binding-wet" as NonEmptyStr),
    instance_id: "binding-wet" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: dir as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18098,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

fn read_is(o: FilesystemReadOutcome, expected: String) -> Bool {
  match o {
    FilesystemReadSucceeded { content: c } => c == expected
    FilesystemReadRefused { error: _ } => false
  }
}

fn read_refused(o: FilesystemReadOutcome) -> Bool {
  match o {
    FilesystemReadSucceeded { content: _ } => false
    FilesystemReadRefused { error: _ } => true
  }
}

fn written(o: FilesystemWriteOutcome) -> Bool {
  match o {
    FilesystemWritten { path: _ } => true
    FilesystemWriteRefused { path: _, error: _ } => false
  }
}

fn write_refused(o: FilesystemWriteOutcome) -> Bool {
  match o {
    FilesystemWritten { path: _ } => false
    FilesystemWriteRefused { path: _, error: _ } => true
  }
}

fn with_attempt_directory(instance: HostDashboardInstance) -> HostDashboardInstance {
  let _made = shell.Mkdir.Parents(path: attempt_state_directory_text(instance: instance, node_id: "n1" as NonEmptyStr as RoadmapNodeId, attempt_key: "k1", directory: AttemptDirectoryRoot) as FilePath)
  instance
}

test fn a_written_member_reads_back_through_the_store() -> Bool {
  let i = with_attempt_directory(instance: fresh_instance(tag: "roundtrip"))
  written(o: attempt_state_write_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity, content: "payload"))
    && read_is(o: attempt_state_read_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity), expected: "payload")
}

test fn bytes_an_earlier_layout_wrote_read_through_the_store() -> Bool {
  let i = with_attempt_directory(instance: fresh_instance(tag: "oldbytes"))
  let dir = attempt_state_directory_text(instance: i, node_id: "n1" as NonEmptyStr as RoadmapNodeId, attempt_key: "k1", directory: AttemptDirectoryRoot)
  let planted = Filesystem.Write(path: join([dir, "/launch-identity.json"], ""), content: "old-bytes").success
  planted && read_is(o: attempt_state_read_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity), expected: "old-bytes")
}

test fn an_attempt_directory_that_does_not_list_refuses_read_and_write() -> Bool {
  let i = fresh_instance(tag: "nodir")
  read_refused(o: attempt_state_read_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity))
    && write_refused(o: attempt_state_write_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity, content: "x"))
}

test fn a_member_is_independent_of_its_sibling() -> Bool {
  let i = with_attempt_directory(instance: fresh_instance(tag: "sibling"))
  let _w = attempt_state_write_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptLaunchIdentity, content: "x")
  read_refused(o: attempt_state_read_at(instance: i, node: "n1", attempt_key: "k1", member: AttemptSpawnFailure))
}
