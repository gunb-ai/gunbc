// ── The publication directory is prepared with the attempt directory ────────────────────────────
//
// THE DEFECT: Filesystem.Write does not create parent directories, so a publication receipt written
// into a directory that was never prepared fails with ENOENT — while the interpreter's
// `[file] write <path>` trace, emitted BEFORE the attempt, makes the journal look identical to a
// success. Measured on srv1 2026-08-19: zero of twelve attempt directories had publication/, every
// publish pass reported failed, and the journal showed a write line for each one.
//
// Both operands are asserted through the SAME projections the actuator uses, never as literals, so
// this cannot pass by agreeing with a transcription of today's paths. The third conjunct is the
// discriminating one: it is the publication path SPECIFICALLY, so restoring the single-directory
// install -d reds it while the attempt-directory conjunct stays green.
test fn the_prepare_step_creates_the_publication_directory_with_the_attempt_directory() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let node_id = "belt-cause-probe" as RoadmapNodeId
  let key = "a0123456789abcdef"
  let argv = attempt_state_prepare_argv_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  let wire = join(argv.args, separator: "\0")
  let attempt_dir = dispatch_attempt_state_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  let publication_dir = dispatch_attempt_publication_dir_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  argv.program == "/usr/bin/install"
    && string_contains(s: wire, pattern: attempt_dir)
    && string_contains(s: wire, pattern: publication_dir)
    && string_contains(s: wire, pattern: "-d")
}

// The publication directory must be UNDER the attempt directory, not beside it. install -d takes a
// list and would happily create a sibling, so a projection that lost the containment would still
// produce two created directories and satisfy the claim above. This is the control that says the
// second operand is the attempt's own subdirectory.
test fn the_prepared_publication_directory_is_inside_the_attempt_directory() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let node_id = "belt-cause-probe" as RoadmapNodeId
  let key = "a0123456789abcdef"
  let attempt_dir = dispatch_attempt_state_path_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  let publication_dir = dispatch_attempt_publication_dir_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  publication_dir == join([attempt_dir, "/publication"], "")
    && publication_dir != attempt_dir
}


// THE DISCRIMINATING RED FOR THE DROPPED MODEL. Before extdeps.llm.cli ProviderModelSelection there
// was no parameter for a model on either vendor argv row, so a model resolved by
// gunbc.dispatch_selection reached the launched process nowhere: these four witnesses are red on
// that tree by construction, because the call does not typecheck without the field and the pattern
// is absent from the wire with it defaulted.
//
// THE PIN IS A VENDOR IDENTIFIER, AND THAT IS THE WHOLE SCOPE OF THIS AXIS. An earlier revision
// pinned glm-5.3-flash here and called it the live case. It is not: GLM is served by the LOCAL
// harness backend, whose model is bound per placement from the route that grants the seat
// (gunbc.serving.admitted_model), and nothing on that path travels through --model at all --
// swapping the harness engine is a serving-route fact, not a selection this carrier makes. It was a
// single constant when this was written; the constant is gone, which strengthens the point rather
// than weakening it. Worse, the value
// was pinned into a CLAUDE argv, where `claude --model glm-5.3-flash` is rejected by Anthropic at
// run time. The two CLIs can only be pointed at a local endpoint through provider-endpoint routing
// that this corpus does not carry, so this axis selects among VENDOR models and the specimen says
// so. Driving local models through the vendor CLIs is a separate capability, named here as absent
// rather than implied by a witness value.
//
// The two default-arm witnesses are the POSITIVE CONTROL in the other direction: they are the
// reason the account-default arm may pass no flag at all rather than a sentinel identifier, and
// they go red if a later edit makes the default arm spell a model the provider would have to
// reject at run time.

data witness_pinned_dispatch_model: NonEmptyStr = "claude-opus-4-1-20250805" as NonEmptyStr

test fn witness_pinned_model_reaches_claude_argv() -> Bool {
  let argv = claude_spawn_argv(
    effort: ReasoningHigh,
    model: ProviderModelPinned { model: witness_pinned_dispatch_model },
    brief: "brief",
  )
  string_contains(
    s: join(argv, separator: "\0"),
    pattern: concat("\0--model\0", witness_pinned_dispatch_model as String),
  )
}

