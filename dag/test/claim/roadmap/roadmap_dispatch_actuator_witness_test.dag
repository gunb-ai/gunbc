test fn witness_live_sessions_panel_rows() -> Bool {
  let output = "gunbc-dispatch-panel-a: 1 windows (created Fri Jul  3 04:14:00 2026)\n"
  match parse_tmux_ls_output(output: output) {
    TmuxLsParsed { entries } => {
      let filtered = filter_dispatch_tmux_sessions(entries: entries)
      if count(filtered) == 1 {
        let entry = filtered.first()
        let scope = dispatch_tmux_session_scope_for_process_fingerprint(
          node_id: roadmap_dispatch_actuator_nid(s: "panel-a"),
          process_fingerprint: dispatch_codex_process_fingerprint,
        )
        let row = dispatch_live_session_row_for_scope(
          entry: entry,
          scope: scope,
          instance: dispatch_provider_instance_for(provider: CodexDispatchProvider),
        )
        row.node_id == "panel-a"
          && row.session_name == "gunbc-dispatch-panel-a"
          && row.lease_verdict == UnknownRefused
      } else {
        false
      }
    }
    TmuxLsParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_projection_standing_refusal_specimen_holds() -> Bool {
  let entry = fixture_projection_standing_refusal_tmux_entry()
  let node = sized_derivable(id: "panel-a", prs: [12], title: "Panel")
  let doc = fixture_doc(nodes: [node], edges: [])
  let ready = next_spawnable(doc: doc, merged: [])
  match dispatch_actuator_selection(node_sizing: Unsized) {
    DispatchActuatorSelectionRefused { reason } =>
      reason == dispatch_selection_standing_ineligible_reason
    DispatchActuatorSelectionOk { provider: _, effort: _, process_fingerprint: _ } => false
  }
    && count(dispatch_live_sessions_from_entries(entries: [entry])) == 0
    && match classify_dispatch_request(
      node: node,
      ready: ready,
      tmux_entries: [entry],
      attempt_key: "feedfacefeedface",
    ) {
      DispatchRefused { reason: r } => r == dispatch_selection_standing_ineligible_reason
      DispatchPermitted { session_name: _, worktree_path: _, branch_name: _, brief: _, reasoning_effort: _ } => false
    }
}

test fn witness_name_only_observation_not_converged() -> Bool {
  let scope = dispatch_tmux_session_scope_for_process_fingerprint(
    node_id: roadmap_dispatch_actuator_nid(s: "name-only"),
    process_fingerprint: dispatch_codex_process_fingerprint,
  )
  match classify_tmux_session(
    scope: scope,
    obs: SessionNameObserved {
      session_name: "gunbc-dispatch-name-only" as NonEmptyStr,
      windows: 1,
    },
