// review 44063. The claim is no longer 'the caller remembered to quote' — quoting is the lit-word
// production's job now, so the exact emitted spelling is the oracle: every word single-quoted, and
// an embedded quote closed/escaped/reopened as '\''. The metacharacter fixture stays because it is
// what a spelling regression would smuggle: a $(...) inside the events path must be inert text in
// the payload, never a command substitution. The poison RED holds the serializer-refusal arm dead
// in corpus.

fn emitted_pipe_body_matches(body: String) -> Bool {
  body == "'exec' '/usr/bin/tee' '-a' '--' '/tmp/a'\\'';$(touch nope)'"
}

test fn witness_event_pipe_emits_grammar_quoted_command() -> Bool {
  match dispatch_event_pipe_emission(
    tee_program: "/usr/bin/tee",
    events_path: "/tmp/a';$(touch nope)",
  ) {
    PipeEmitRefused { detail: _ } => false
    PipeEmitted { command } =>
      emitted_pipe_body_matches(body: command.body as String)
  }
}

