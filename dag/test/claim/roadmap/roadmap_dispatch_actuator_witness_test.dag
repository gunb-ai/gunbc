test fn witness_codex_argv_is_unattended_but_sandboxed() -> Bool {
  let argv = codex_spawn_argv(
    effort: ReasoningHigh,
    model: ProviderAccountDefaultModel,
    worktree_path: "/opt/gunbc/dispatch-worktrees/codex-node",
    brief: "brief body",
  )
  let wire = join(argv, separator: "\0")
  starts_with(s: wire, prefix: concat("env\0CODEX_HOME=", dispatch_codex_home))
    && string_contains(s: wire, pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && string_contains(s: wire, pattern: "\0--sandbox\0workspace-write")
    && string_contains(s: wire, pattern: "\0--json")
    && string_contains(s: wire, pattern: "\0-C\0/opt/gunbc/dispatch-worktrees/codex-node")
    && string_contains(s: wire, pattern: "model_reasoning_effort=\"high\"")
    && string_contains(s: wire, pattern: "brief body")
    && !string_contains(s: wire, pattern: "--dangerously-bypass-approvals-and-sandbox")
    && !string_contains(s: wire, pattern: "--ephemeral")
}

// THE TMUX COMMANDS LIVE INSIDE THE SESSION CONTAINER (DispatchSpawnCommands.session_container); a
// unit-backed attempt has none, and this Codex witness is about the tmux arm only.
fn codex_tmux_command_shape_holds(
  cmds: DispatchSpawnCommands,
  codex_executable: String,
) -> Bool {
  match cmds.session_container {
    SystemdUnitContainer { plan: _ } => false
    TmuxSessionContainer { spawn, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start } =>
      codex_tmux_arm_shape_holds(spawn: spawn, provider_start: provider_start, codex_executable: codex_executable)
  }
}

fn codex_tmux_arm_shape_holds(spawn: HostExecArgv, provider_start: HostExecArgv, codex_executable: String) -> Bool {
  let create_wire = join(spawn.args, separator: "\0")
  let provider_wire = join(provider_start.args, separator: "\0")
  spawn.program == "/usr/bin/tmux"
    && string_contains(s: create_wire, pattern: "\0/usr/bin/sh")
    && !string_contains(s: create_wire, pattern: "\0codex\0")
    && string_contains(
      s: provider_wire,
      pattern: concat("\0", concat(codex_executable, "\0--ask-for-approval\0never\0exec")),
    )
    && !string_contains(s: provider_wire, pattern: "\0claude\0")
}

test fn witness_selected_provider_shapes_codex_tmux_command() -> Bool {
  let node = sized_derivable(id: "codex-selected", prs: [1], title: "Codex selected")
  match dispatch_spawn_commands_for_inventory(
    instance: srv2_lab_dashboard_instance(),
    inventory: fixture_inventory_codex_only_available(
      instance: srv2_lab_dashboard_instance(),
    ),
    node: node,
    session_uuid: "uuid-unused-by-codex",
    attempt_key: "feedfacefeedface",
    request: SelectCodex {
      profile: ProfileAutomatic,
      account: codex_roadmap_account_selection(),
      model: dispatch_codex_default_model,
      effort: ReasoningMedium,
      operator_asserted_native_limit_bucket: Absent,
    },
    resolution: fixture_ready_resolution(node_id: "codex-selected", project_ids: []),
  ) {
    DispatchSpawnRefused { step: _, detail: _ } => false
    DispatchSpawnReady { commands: cmds } =>
      codex_tmux_command_shape_holds(
        cmds: cmds,
        codex_executable: match dashboard_instance_provider_executable(
          instance: srv2_lab_dashboard_instance(),
        ) {
          Present { value: executable } => executable as String
          Absent => ""
        },
      )
  }
}

fn lab_instance_command_shape_holds(commands: DispatchSpawnCommands, lab: HostDashboardInstance) -> Bool {
  match commands.session_container {
    SystemdUnitContainer { plan: _ } => false
    TmuxSessionContainer { spawn, default_shell: _, remain_on_exit: _, event_pipe, provider_start } =>
      lab_instance_tmux_shape_holds(commands: commands, lab: lab, spawn: spawn, event_pipe: event_pipe, provider_start: provider_start)
  }
}

fn lab_instance_tmux_shape_holds(commands: DispatchSpawnCommands, lab: HostDashboardInstance, spawn: HostExecArgv, event_pipe: HostExecArgv, provider_start: HostExecArgv) -> Bool {
  let git_wire = join(commands.worktree_add.args, separator: "\0")
  let state_wire = join(commands.attempt_state_prepare.args, separator: "\0")
  let pointer_wire = join(commands.attempt_current_pointer.args, separator: "\0")
  let tmux_wire = join(spawn.args, separator: "\0")
  let pipe_wire = join(event_pipe.args, separator: "\0")
  let provider_wire = join(provider_start.args, separator: "\0")
  string_contains(
    s: git_wire,
    pattern: "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempts/ts-dispatch-provider-events-afeedfacefeedface",
    )
    && string_contains(s: git_wire, pattern: "\0origin/main")
    && commands.attempt_state_prepare.program == "/usr/bin/install"
    && string_contains(
      s: state_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-afeedfacefeedface",
    )
    && string_contains(
      s: state_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-afeedfacefeedface/publication",
    )
    && commands.attempt_current_pointer.program == "/usr/bin/ln"
    && string_contains(
      s: pointer_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-current",
    )
    && starts_with(
      s: tmux_wire,
      prefix: "-L\0srv1-lab-codex-feedback-v0\0new-session\0-d\0-s\0gunbc-dispatch-ts-dispatch-provider-events",
    )
    && string_contains(
      s: pipe_wire,
      pattern: "provider-events.jsonl",
    )
    && string_contains(
      s: provider_wire,
      pattern: dispatch_credential_snapshot_path_for_instance(
        instance: lab,
        node_id: "ts-dispatch-provider-events" as NonEmptyStr as RoadmapNodeId,
        attempt_key: "feedfacefeedface",
        provider: ClaudeCodeProvider,
      ) as String,
    )
}

// THE LAB INSTANCE MOVES ITS REPO, TMUX SERVER AND ATTEMPT STATE TOGETHER, shown with the Claude
// spawn (its credential is held on srv1). It no longer moves a codex state root with it: codex worker
// turns run on the one credential held on its custody host (gunbc.codex_harness_credential, operator
// ruling 2026-10-05), so the same lab refuses a codex spawn at the custody-host step -- the control
// that a codex turn cannot fall back to the lab's ambient codex login.
test fn witness_lab_instance_moves_repo_tmux_and_attempt_state_together() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let node = sized_derivable(id: "ts-dispatch-provider-events", prs: [], title: "Provider execution facts")
  let claude_moves = match dispatch_spawn_commands_for_resolved_instance(
    instance: lab,
    node: node,
    session_uuid: "00000000-0000-4000-8000-000000000001",
    attempt_key: "feedfacefeedface",
    provider: ClaudeCodeProvider,
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
    origin: FreshFromBase,
    resolution: fixture_ready_resolution(node_id: "ts-dispatch-provider-events", project_ids: []),
  ) {
    DispatchSpawnRefused { step: _, detail: _ } => false
    DispatchSpawnReady { commands } => lab_instance_command_shape_holds(commands: commands, lab: lab)
  }
  let codex_refused = match dispatch_spawn_commands_for_resolved_instance(
    instance: lab,
    node: node,
    session_uuid: "00000000-0000-4000-8000-000000000001",
    attempt_key: "feedfacefeedface",
    provider: CodexDispatchProvider,
    effort: ReasoningMedium,
    model: dispatch_codex_default_model,
    origin: FreshFromBase,
    resolution: fixture_ready_resolution(node_id: "ts-dispatch-provider-events", project_ids: []),
  ) {
    DispatchSpawnRefused { step, detail: _ } => step as String == "codex-credential-custody-host"
    DispatchSpawnReady { commands: _ } => false
  }
  claude_moves && codex_refused
}

test fn witness_tmux_attempt_panes_parse_alive_and_exit() -> Bool {
  match parse_tmux_attempt_panes_output(
    output: "gunbc-dispatch-a\t0\t\tnode\ngunbc-dispatch-b\t1\t7\tnode\n",
  ) {
    AttemptPanesParsed { panes } =>
      count(panes) == 2
        && !panes.first().dead
        && panes.skip(n: 1).first().dead
        && panes.skip(n: 1).first().exit_code == Present { value: 7 }
    AttemptPanesParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

