}

test fn witness_foreign_process_fingerprint_is_conflict() -> Bool {
  let scope = dispatch_tmux_session_scope_for_process_fingerprint(
    node_id: roadmap_dispatch_actuator_nid(s: "foreign-proc"),
    process_fingerprint: dispatch_codex_process_fingerprint,
  )
  match classify_dispatch_lease_upsert(
    scope: scope,
    obs: SessionObserved {
      session_name: "gunbc-dispatch-foreign-proc" as NonEmptyStr,
      windows: 1,
      process_fingerprint: "foreign-shell" as NonEmptyStr,
    },
  ) {
    UpsertClassification { verdict: Conflict, decision: Refuse { reason: _ } } => true
    UpsertClassification { verdict: Converged, decision: _ } => false
    _ => false
  }
}

