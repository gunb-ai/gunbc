fn roadmap_dispatch_actuator_nid(s: String) -> RoadmapNodeId { s }

fn sized_derivable(id: String, prs: List<Int>, title: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_R2PE6DBK7RVVR2NHNQN0" as RoadmapNodeIdentity,
    node: roadmap_dispatch_actuator_nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn fixture_section(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapSection {
  RoadmapSection {
    title: "Test",
    elements: [Group { group: SectionGroup { label: "test", nodes: nodes, edges: edges } }],
  }
}

fn fixture_doc(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [fixture_section(nodes: nodes, edges: edges)],
  }
}

test fn witness_tmux_session_name_prefix() -> Bool {
  dispatch_tmux_session_name(node_id: roadmap_dispatch_actuator_nid(s: "node-1")) == "gunbc-dispatch-node-1"
}

test fn witness_brief_fill_includes_node_metadata() -> Bool {
  let node = sized_derivable(id: "brief-node", prs: [1], title: "Brief Title")
  let brief = fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
  string_contains(s: brief, pattern: "Node: brief-node")
    && string_contains(s: brief, pattern: "Brief Title")
}

test fn witness_dispatch_effort_ignores_intricacy() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let inventory = fixture_inventory_codex_only_available(instance: instance)
  let high = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Sized {
      intricacy: IntricacyHigh,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  let low = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    node_sizing: Sized {
      intricacy: IntricacyLow,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: PrsMerged,
    },
  )
  match high {
    DispatchSelectionResolved { receipt: high_receipt } =>
      match low {
        DispatchSelectionResolved { receipt: low_receipt } =>
          reasoning_effort_label(effort: high_receipt.applied_effort) == "medium"
            && reasoning_effort_label(effort: low_receipt.applied_effort) == "medium"
            && high_receipt.applied_effort == low_receipt.applied_effort
        DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } =>
          false
      }
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_claude_argv_uses_dangerous_skip_permissions() -> Bool {
  let argv = claude_spawn_argv(
    effort: ReasoningHigh,
    session_uuid: "uuid-1",
    node_id: roadmap_dispatch_actuator_nid(s: "node-1"),
    brief: "brief body",
  )
  string_contains(s: join(argv, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && string_contains(s: join(argv, separator: "\0"), pattern: "skipDangerousModePermissionPrompt")
    && string_contains(s: join(argv, separator: "\0"), pattern: "--session-id")
    && !string_contains(s: join(argv, separator: "\0"), pattern: "--resume")
}

test fn witness_git_worktree_argv_is_execfile_safe() -> Bool {
  let cmd = git_worktree_add_argv(
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-1",
    branch_name: "dispatch/node-1",
    remote_ref: "origin/main",
  )
  cmd.program == "git"
    && cmd.args == ["worktree", "add", "/opt/gunbc/dispatch-worktrees/node-1", "-b", "dispatch/node-1", "origin/main"]
}

test fn witness_tmux_spawn_argv_threads_claude_argv() -> Bool {
  let claude = claude_spawn_argv(
    effort: ReasoningMedium,
    session_uuid: "uuid-2",
    node_id: roadmap_dispatch_actuator_nid(s: "node-2"),
    brief: "brief",
  )
  let cmd = tmux_spawn_argv(
    session_name: "gunbc-dispatch-node-2",
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-2",
    claude_argv: claude,
  )
  cmd.program == "tmux"
    && starts_with(s: join(cmd.args, separator: " "), prefix: "new-session -d -s gunbc-dispatch-node-2")
    && string_contains(s: join(cmd.args, separator: "\0"), pattern: "CLAUDE_CODE_NO_FLICKER=1")
}

test fn witness_probe_bridge_ineligible_standing_refuses_actuator_selection() -> Bool {
  let instance = srv1_live_dashboard_instance()
  match dashboard_instance_provider_executable(instance: instance) {
    Absent => false
    Present { value: executable } =>
      match resolve_dispatch_selection(
        inventory: ProviderInventory {
          offers: [
            fixture_codex_offer_with_standing(
              instance: instance,
              standing: provider_standing_from_observed_bundle(
                fact_id: selection_fixture_standing_fact_id,
                provider: codex_offer_for_instance_with_standing(
                  instance: instance,
                  standing: provider_standing_inventory_unobserved(),
                  executable: executable,
                  process_fingerprint: fixture_codex_process_fingerprint_standing(),
                ).instance,
                bundle: provider_standing_bundle_from_codex_dashboard_probes(
                  observation: CodexProviderDashboardProbeObservation {
                    state_root: CodexStateRootPresent,
                    runtime: ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "codex-cli 0.145.0",
                      stderr: "",
                    },
                    auth: ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "",
                      stderr: "Logged in using ChatGPT",
                    },
                  },
                ),
              ),
              executable: executable,
            ),
          ],
        },
        request: default_provider_selection_request(),
        node_sizing: Unsized,
      ) {
        DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason } =>
          reason == dispatch_selection_standing_ineligible_reason
        DispatchSelectionResolved { receipt: _ } => false
      }
  }
}

test fn witness_actuator_automatic_selection_refuses_with_standing_reason() -> Bool {
  witness_probe_bridge_ineligible_standing_refuses_actuator_selection()
}

test fn witness_actuator_projection_refuses_missing_provider() -> Bool {
  match dispatch_actuator_selection_for_provider(
    provider: ClaudeCodeProvider,
    node_sizing: Unsized,
  ) {
    DispatchActuatorSelectionRefused { reason: _ } => true
    DispatchActuatorSelectionOk { provider: _, effort: _, process_fingerprint: _ } => false
  }
}

test fn witness_fixture_codex_fingerprint_is_historical_npm_shim_receipt() -> Bool {
  match resolve_dispatch_selection(
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    request: default_provider_selection_request(),
    node_sizing: Unsized,
  ) {
    DispatchSelectionResolved { receipt } =>
      resolved_process_fingerprint(resolved: receipt.resolved_selection) == ("node" as NonEmptyStr)
    DispatchSelectionRefused { node_sizing: _, requested_selection: _, reason: _ } => false
  }
}

test fn witness_codex_argv_is_unattended_but_sandboxed() -> Bool {
  let argv = codex_spawn_argv(
    effort: ReasoningHigh,
    worktree_path: "/opt/gunbc/dispatch-worktrees/codex-node",
    brief: "brief body",
  )
  let wire = join(argv, separator: "\0")
  starts_with(s: wire, prefix: concat("env\0CODEX_HOME=", dispatch_codex_home))
    && string_contains(s: wire, pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && string_contains(s: wire, pattern: "\0--sandbox\0workspace-write")
    && string_contains(s: wire, pattern: "\0--json")
    && string_contains(s: wire, pattern: "\0-C\0/opt/gunbc/dispatch-worktrees/codex-node")
    && string_contains(s: wire, pattern: "model_reasoning_effort=\"high\"")
    && string_contains(s: wire, pattern: "brief body")
    && !string_contains(s: wire, pattern: "--dangerously-bypass-approvals-and-sandbox")
    && !string_contains(s: wire, pattern: "--ephemeral")
}

fn codex_tmux_command_shape_holds(
  cmds: DispatchSpawnCommands,
  codex_executable: String,
) -> Bool {
  let create_wire = join(cmds.tmux_spawn.args, separator: "\0")
  let provider_wire = join(cmds.provider_start.args, separator: "\0")
  cmds.tmux_spawn.program == "/usr/bin/tmux"
    && string_contains(s: create_wire, pattern: "\0/usr/bin/sh")
    && !string_contains(s: create_wire, pattern: "\0codex\0")
    && string_contains(
      s: provider_wire,
      pattern: concat("\0", concat(codex_executable, "\0--ask-for-approval\0never\0exec")),
    )
    && !string_contains(s: provider_wire, pattern: "\0claude\0")
}

test fn witness_selected_provider_shapes_codex_tmux_command() -> Bool {
  let node = sized_derivable(id: "codex-selected", prs: [1], title: "Codex selected")
  match dispatch_spawn_commands_for_inventory(
    instance: srv1_live_dashboard_instance(),
    inventory: fixture_inventory_codex_only_available(
      instance: srv1_live_dashboard_instance(),
    ),
    node: node,
    session_uuid: "uuid-unused-by-codex",
    attempt_key: "feedfacefeedface",
    request: SelectCodex {
      profile: ProfileAutomatic,
      account: codex_roadmap_account_selection(),
      model: dispatch_codex_default_model,
      effort: ReasoningMedium,
      operator_asserted_native_limit_bucket: Absent,
    },
  ) {
    DispatchSpawnRefused { step: _, detail: _ } => false
    DispatchSpawnReady { commands: cmds } =>
      codex_tmux_command_shape_holds(
        cmds: cmds,
        codex_executable: match dashboard_instance_provider_executable(
          instance: srv1_live_dashboard_instance(),
        ) {
          Present { value: executable } => executable as String
          Absent => ""
        },
      )
  }
}

fn lab_instance_command_shape_holds(commands: DispatchSpawnCommands, lab: HostDashboardInstance) -> Bool {
  match dashboard_instance_provider_executable(instance: lab) {
    Absent => false
    Present { value: codex_path } => {
  let codex_executable = codex_path as String
  let git_wire = join(commands.worktree_add.args, separator: "\0")
  let state_wire = join(commands.attempt_state_prepare.args, separator: "\0")
  let pointer_wire = join(commands.attempt_current_pointer.args, separator: "\0")
  let tmux_wire = join(commands.tmux_spawn.args, separator: "\0")
  let pipe_wire = join(commands.tmux_event_pipe.args, separator: "\0")
  let provider_wire = join(commands.provider_start.args, separator: "\0")
  string_contains(
    s: git_wire,
    pattern: "/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempts/ts-dispatch-provider-events-afeedfacefeedface",
    )
    && string_contains(s: git_wire, pattern: "\0origin/main")
    && commands.attempt_state_prepare.program == "/usr/bin/install"
    && string_contains(
      s: state_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-afeedfacefeedface",
    )
    && string_contains(
      s: state_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-afeedfacefeedface/publication",
    )
    && commands.attempt_current_pointer.program == "/usr/bin/ln"
    && string_contains(
      s: pointer_wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/ts-dispatch-provider-events-current",
    )
    && starts_with(
      s: tmux_wire,
      prefix: "-L\0srv1-lab-codex-feedback-v0\0new-session\0-d\0-s\0gunbc-dispatch-ts-dispatch-provider-events",
    )
    && string_contains(
      s: pipe_wire,
      pattern: "provider-events.jsonl",
    )
    && string_contains(
      s: provider_wire,
      pattern: concat("\0CODEX_HOME=/home/briansrls/.codex@gunbc-roadmap\0", codex_executable),
    )
    }
  }
}

