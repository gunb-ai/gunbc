// THE ACTUATOR ARM, not just the argv row. dispatch_provider_inner_argv is the fold the spawn plan
// routes both vendor providers through, and it is where the model was dropped a second time: the
// function carried effort and process fingerprint from the receipt and nothing for the model. This
// witness fails if a future edit re-drops the field between the fold and either argv row, which
// compilation alone would not catch once the parameter exists and could be ignored.

fn witness_inner_argv_wire(inner: DispatchProviderInnerArgv) -> String {
  match inner {
    DispatchProviderInnerArgvReady { argv } => join(argv, separator: "\0")
    CursorProviderOffCustodyHost { reason: r } => r as String
    CursorProviderCredentialUnbound { reason: r } => r as String
    CodexProviderOffCustodyHost { reason: r } => r as String
    CodexProviderExecutableAbsent { reason: r } => r as String
    GunbcHarnessSpawnNeedsInstance { reason: r } => r as String
    ClaudeProviderCredentialUnbound { reason: r } => r as String
  }
}

test fn witness_inner_argv_carries_pinned_model_for_both_vendors() -> Bool {
  let pinned = ProviderModelPinned { model: witness_pinned_dispatch_model }
  let expected = concat("\0--model\0", witness_pinned_dispatch_model as String)
  let claude_wire = witness_inner_argv_wire(
    inner: dispatch_provider_inner_argv(
      provider: ClaudeCodeProvider,
      effort: ReasoningHigh,
      model: pinned,
      session_uuid: "uuid-inner",
      node_id: roadmap_dispatch_actuator_nid(s: "node-inner"),
      worktree_path: "/opt/gunbc/dispatch-worktrees/node-inner",
      brief: "brief",
    ),
  )
  let codex_wire = witness_inner_argv_wire(
    inner: dispatch_provider_inner_argv(
      provider: CodexDispatchProvider,
      effort: ReasoningHigh,
      model: pinned,
      session_uuid: "uuid-inner",
      node_id: roadmap_dispatch_actuator_nid(s: "node-inner"),
      worktree_path: "/opt/gunbc/dispatch-worktrees/node-inner",
      brief: "brief",
    ),
  )
  string_contains(s: claude_wire, pattern: expected)
    && string_contains(s: codex_wire, pattern: expected)
}


// THE REVIEWER'S ATTEMPT IDENTITY IS MINTED AT THE SPAWNER FROM SAFE PIECES. The reviewer was the
// one harness entry the attempt-identity fix missed: harness_reviewer_cli kept building its attempt
// identity from the absolute verdict path, the fleet ssh context's safe-segment law refused it, and
// every reviewer lane exited 1 before any ssh leg with no verdict written (measured 2026-09-20 on
// srv2, all fourteen lanes of one belt review pass). The criterion key is part of the mint because
// the lanes of one attempt share the node id and attempt key, and each lane's identity must stay
// distinct, and the head is part of it because one criterion is reviewed again at each new head.

test fn witness_review_attempt_identity_is_a_safe_path_segment() -> Bool {
  path_segment_is_safe(raw: dispatch_reviewer_attempt_identity(node_id: "node-1", attempt_key: "att-20260920", criterion_key: "conformance-external-facts", head_sha: "abc123"))
}

test fn witness_review_argv_carries_spawner_minted_attempt_identity() -> Bool {
  let argv = gunbc_harness_review_argv(
    gunbc_program: "/opt/gunbc/target/release/gunbc",
    repo_root: "/opt/gunbc/repo",
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-1",
    brief: "brief",
    timeout_program: "/usr/bin/timeout",
    request_scratch_path: "/state/node-1/att/review/c.harness-request.json",
    events_path: "/state/node-1/att/review/c.provider-events.jsonl",
    verdict_dir: "/state/node-1/att/review",
    verdict_name: "abc123.c.json",
    attempt_identity: "reviewer:node-1-att-20260920-c",
  )
  string_contains(s: join(argv, separator: "\0"), pattern: "\0--arg\0attempt_identity=reviewer:node-1-att-20260920-c")
}

// THE SPAWN SITE, not just the argv row: dispatch_review_unit_command is where the mint lives, and it
// is the fold the belt's review pass actually spawns through. This witness fails if a future edit
// re-drops the argument between the unit fold and the argv row, which compilation alone would not
// catch once the parameter exists and could be ignored.

test fn witness_review_unit_argv_mints_per_criterion_attempt_identity() -> Bool {
  match dispatch_review_unit_command(
    instance: srv1_lab_dashboard_instance(),
    node_id: roadmap_dispatch_actuator_nid(s: "node-1"),
    attempt_key: "att-20260920",
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-1",
    brief: "brief",
    head_sha: "abc123",
    criterion_key: "conformance-external-facts",
    exit_hook: "+mkdir -- /i/attempt-exit-spool/inbox/x" as NonEmptyStr,
  ) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command: command } => {
      let cmd = dispatch_unit_exec_argv(command: command, resolved_program: "/usr/bin/systemd-run" as FilePath)
      string_contains(s: join(cmd.args, separator: "\0"), pattern: "attempt_identity=reviewer:6.node-1.12.att-20260920.26.conformance-external-facts.6.abc123")
    }
  }
}

// THE ROW THAT WOULD HAVE CAUGHT THE ORIGINAL BUG: an attempt identity built from a path-bearing
// piece -- the pre-fix reviewer's join(["reviewer:", verdict_path]) -- is refused by the same
// safe-segment law the fleet ssh context enforces.

test fn witness_verdict_path_bearing_attempt_identity_refuses() -> Bool {
  !path_segment_is_safe(raw: join(["reviewer:", "/state/node-1/att/review/abc123.c.json"], ""))
}

// THE ORIGIN REACHES THE WORKTREE ARGV, not just the decision value: a ContinueFromAttempt origin
// must put the PRIOR ATTEMPT'S branch in the worktree-add ref position, so the next turn's tree
// already holds the committed work. This is the fold the belt's spawn consumes through
// belt_resolved_spawn_plan; a regression that fell back to the instance base ref here would
// silently discard the lineage the decision just chose to continue.
test fn witness_continuation_origin_branches_the_worktree_from_the_prior_attempt_branch() -> Bool {
  match dispatch_spawn_commands_for_resolved_instance(
    instance: srv1_lab_dashboard_instance(),
    node: sized_derivable(id: "ts-continuation-origin", prs: [], title: "Continuation origin wiring"),
    session_uuid: "00000000-0000-4000-8000-000000000002",
    attempt_key: "feedfacefeedface",
    provider: ClaudeCodeProvider,
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
    origin: ContinueFromAttempt {
      parent_attempt_key: "deadbeefdeadbeef",
      branch: "roadmap/ts-continuation-origin/deadbeefdeadbeef",
      turn: 2,
      verdict_detail: "the prior turn's submission declared blocked: the acceptance run was still in flight",
    },
    resolution: fixture_ready_resolution(node_id: "ts-continuation-origin", project_ids: ["arc-fixture"]),
  ) {
    DispatchSpawnRefused { step: _, detail: _ } => false
    DispatchSpawnReady { commands: cmds } => {
      let git_wire = join(cmds.worktree_add.args, separator: "\0")
      string_contains(s: git_wire, pattern: "\0roadmap/ts-continuation-origin/deadbeefdeadbeef")
        && !string_contains(s: git_wire, pattern: "\0origin/main")
    }
  }
}

// THE SUPPLIED UNROOTED SPECIMEN (§3: a witness discriminates at one interface). The claims below
// judge the refusal an unrooted chain produces, so the unrooted node is built HERE -- a row with no
// parent -- rather than borrowed from the live roadmap authority, whose parents change for
// unrelated reasons (#13052 gave the former live specimen one and turned both claims red).
fn unrooted_specimen_id() -> String { "fixture-unrooted-specimen" }

fn specimen_row(parent: NodeParent?) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_R2PE6DBK7RVVR2NHNQN0" as RoadmapNodeIdentity,
    node: roadmap_dispatch_actuator_nid(s: unrooted_specimen_id()),
    line: TicketLine {
      done: false,
      ticket: TicketFields {
        headline: "Specimen headline",
        brief: "Specimen brief",
        displaced_cost: "none",
        current_state: "fixture",
        first_slice: "fixture",
        red_control: "fixture",
        out_of_scope: "fixture",
        handback: "fixture",
        updates: [],
        authored_on: "",
        last_verified_on: "",
      },
    },
    carriers: [],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
    parent: parent,
    centering: none,
  }
}

fn unrooted_specimen() -> RoadmapNode { specimen_row(parent: none) }

fn rooted_twin_specimen() -> RoadmapNode { specimen_row(parent: Present { value: AdmittedRoot }) }

fn unrooted_specimen_resolution() -> AlignmentResolution {
  alignment_resolve_chain(
    chain: alignment_chain(node_id: unrooted_specimen_id(), nodes: [unrooted_specimen()]),
    turns_elapsed: 1,
    state: alignment_base_cadence_state(),
  )
}

// THE DISCRIMINATOR AND THE INHABITANCE CHECK: the real lineage rule and the real chain derivation
// refuse the parentless row and accept the same row once it declares AdmittedRoot, so the refusal
// below is the rule's, not a fixture artifact. Not tied to any live node id.
test fn the_real_lineage_rule_refuses_an_unrooted_row_and_roots_its_twin() -> Bool {
  !lineage_is_rooted(w: lineage_walk(node_id: unrooted_specimen_id(), nodes: [unrooted_specimen()]))
    && lineage_is_rooted(w: lineage_walk(node_id: unrooted_specimen_id(), nodes: [rooted_twin_specimen()]))
    && (match alignment_resolve_chain(
      chain: alignment_chain(node_id: unrooted_specimen_id(), nodes: [rooted_twin_specimen()]),
      turns_elapsed: 1,
      state: alignment_base_cadence_state(),
    ) {
      AlignmentReady { chain: _, due_levels: _, rendered_prompt: _ } => true
      AlignmentUnresolved { cause: _ } => false
    })
}

// THE ONE-AUTHORITY PREAMBLE (review finding 2026-09-26): the preamble IS the resolution's
// rendered_prompt — gunbc.roadmap.roadmap_alignment owns the alignment answer and this lane only
// concatenates. For a SUPPLIED row that declares
// no parent the derived chain refuses UNROOTED, so the honest preamble is the refusal marker
// naming where the walk halted (review 5354823380), never a confident projection rendered while
// execution proceeded.
test fn the_preamble_names_the_derived_refusal_for_an_unrooted_node() -> Bool {
  let resolution = unrooted_specimen_resolution()
  let preamble = dispatch_continuation_alignment_preamble(resolution: resolution)
  match resolution {
    AlignmentUnresolved { cause } =>
      preamble.contains("Alignment UNRESOLVED")
        && (match cause {
          AlignmentWalkUnrooted { at, walked } =>
            at == unrooted_specimen_id() && count(walked) == 0
          AlignmentRowUndeclared { node_id: _ } => false
          AlignmentNestingCyclic { node_id: _ } => false
        })
        && string_contains(s: preamble, pattern: unrooted_specimen_id())
    AlignmentReady { chain: _, due_levels: _, rendered_prompt: _ } => false
  }
}

// A RESOLVED CHAIN RENDERS EVERY LEVEL ROOT TO LEAF through the same preamble (review
// 5354823380): the L0 pointer, the root-most project first, the nearer project below it, the task
// contract last, and the bounded ask — each level carrying its ticket's approach and red control,
// not a two-field reduction.
test fn the_preamble_renders_every_chain_level_when_the_resolution_is_ready() -> Bool {
  let preamble = dispatch_continuation_alignment_preamble(
    resolution: fixture_ready_resolution(node_id: "ts-alignment-deep", project_ids: ["arc-near", "arc-far"]),
  )
  preamble.contains(continuation_alignment_l0_pointer)
    && preamble.contains("L1 project intent: arc-far: Purpose of arc-far")
    && preamble.contains("L2 project intent: arc-near: Purpose of arc-near")
    && preamble.contains("L3 task contract: ts-alignment-deep: Fixture purpose")
    && preamble.contains("approach: fixture approach")
    && preamble.contains("red control: fixture red")
    && preamble.contains(continuation_alignment_ask)
}

// A CHAIN WITH NO PROJECT LEVELS renders its task contract as the single level below the
// principles pointer — the shape the admitted root's own chain takes.
test fn a_projectless_ready_chain_renders_its_task_as_the_single_level() -> Bool {
  let preamble = dispatch_continuation_alignment_preamble(
    resolution: fixture_ready_resolution(node_id: "ts-alignment-project-of-one", project_ids: []),
  )
  preamble.contains("L1 task contract: ts-alignment-project-of-one: Fixture purpose")
    && preamble.contains("contribution to parent: fixture contribution")
}

// THE INITIAL BRIEF IS UNCHANGED: the preamble exists only on continuation origins, the fresh
// assembly is byte-identical to the pre-preamble join, and the continuation assembly leads with
// the verdict (the alignment preamble follows it, never precedes it). The fresh brief is handed
// the fixture node's REAL resolution — which is Unresolved, the node declares no authority row —
// and still renders byte-identically: the fresh path's refusal is the spawn fold's gate, not the
// brief's shape, so the brief cannot smuggle an alignment answer onto a fresh dispatch either way.
test fn the_alignment_preamble_is_continuation_only_and_follows_the_verdict() -> Bool {
  let node = sized_derivable(id: "ts-alignment-fresh", prs: [], title: "Fresh brief shape")
  let fields = dispatch_brief_fields_for_environment(
    node: node,
    environment: srv1_lab_dashboard_instance().execution_environment,
  )
  let fresh_resolution = alignment_resolve(node_id: "ts-alignment-fresh", turns_elapsed: 1, state: alignment_base_cadence_state())
  let fresh = dispatch_brief_for_origin(node: node, fields: fields, origin: FreshFromBase, resolution: fresh_resolution)
  let cont = dispatch_brief_for_origin(node: node, fields: fields, origin: ContinueFromAttempt {
    parent_attempt_key: "a1",
    branch: "roadmap/ts-alignment-fresh/a1",
    turn: 2,
    verdict_detail: "verification failed: sandbox render red",
  }, resolution: fixture_ready_resolution(node_id: "ts-alignment-fresh", project_ids: []))
  fresh == dispatch_brief_with_centering(node: node, fields: fields)
    && !fresh.contains("Alignment (re-checked")
    && cont.starts_with("CONTINUATION: this is turn 2 of 3")
    && cont.contains("verification failed: sandbox render red")
    && cont.contains("\nAlignment (re-checked at every checkpoint adjudication):\n")
    && cont.contains(continuation_alignment_ask)
    && (match fresh_resolution {
      AlignmentUnresolved { cause } => (match cause { AlignmentRowUndeclared { node_id } => node_id == "ts-alignment-fresh"  AlignmentWalkUnrooted { at: _, walked: _ } => false
        AlignmentNestingCyclic { node_id: _ } => false })
      AlignmentReady { chain: _, due_levels: _, rendered_prompt: _ } => false
    })
}

// NO SPAWN ON AN UNRESOLVED CHAIN — THE REAL PRODUCER, A SUPPLIED UNROOTED ROW (the review
// finding's discriminating control). The supplied parentless row's chain refuses UNROOTED through
// the real derivation (review 5354823380); the same resolution the belt derives at spawn time is
// handed to the real spawn fold, and the fold's answer is DispatchSpawnRefused at the alignment
// gate — the Refused arm carries no DispatchSpawnCommands, so zero spawn commands exist: no
// worktree add, no state prepare, no session container. The rooted twin (see the lineage claim)
// resolves Ready, so removing the unrooted refusal turns this control red.
test fn an_unresolved_alignment_refuses_the_real_spawn_fold_with_zero_commands() -> Bool {
  match dispatch_spawn_commands_for_resolved_instance(
    instance: srv1_lab_dashboard_instance(),
    node: unrooted_specimen(),
    session_uuid: "00000000-0000-4000-8000-000000000004",
    attempt_key: "feedfacefeedface",
    provider: CodexDispatchProvider,
    effort: ReasoningMedium,
    model: dispatch_codex_default_model,
    origin: FreshFromBase,
    resolution: unrooted_specimen_resolution(),
  ) {
    DispatchSpawnRefused { step, detail } =>
      step as String == "alignment"
        && string_contains(s: detail, pattern: unrooted_specimen_id())
        && string_contains(s: detail, pattern: "admitted root")
    DispatchSpawnReady { commands: _ } => false
  }
}

// ONE SESSION PER ESCALATION RECORD: the unit name, the attempt identity and the confinement all
// derive from (node, attempt, turn) -- the turn is what makes the record's one session distinct
// from the lineage's other turns, and the verdict lands at the basename the continuation decision
// reads. The session invokes the supervisor's own CLI function, never the worker's.
test fn witness_supervisor_unit_argv_shapes_one_session_per_escalation_record() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  match dispatch_supervisor_unit_command(
    instance: lab,
    node_id: roadmap_dispatch_actuator_nid(s: "shell-dag-cron-entry-line-builder"),
    attempt_key: "cd172fe81b806160",
    turn: 3,
    worktree_path: "/x/attempts/wt",
    brief: "BRIEF-MARKER",
  ) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command: command } => {
      let cmd = dispatch_unit_exec_argv(command: command, resolved_program: "/usr/bin/systemd-run" as FilePath)
      let wire = join(cmd.args, separator: "\0")
      wire.contains("gunbc-supervisor-shell-dag-cron-entry-line-builder-cd172fe81b806160-t3.service")
        && wire.contains("\0--function\0harness_supervisor_cli\0")
        && wire.contains("\0worktree=/x/attempts/wt\0")
        && wire.contains("BRIEF-MARKER")
        && wire.contains("\0verdict_name=supervisor-verdict.json\0")
        && wire.contains("/supervisor/harness-request.json")
        && wire.contains("/supervisor/t3.provider-events.jsonl")
        && wire.contains("ReadWritePaths=")
        && wire.contains("/supervisor\0")
        && !wire.contains("harness_worker_cli")
        && dispatch_supervisor_attempt_identity(node_id: "shell-dag-cron-entry-line-builder", attempt_key: "cd172fe81b806160", turn: 3)
          == "supervisor:shell-dag-cron-entry-line-builder-cd172fe81b806160-t3"
        && wire.contains("attempt_identity=supervisor:shell-dag-cron-entry-line-builder-cd172fe81b806160-t3")
    }
  }
}

// The writer/reader pairing for token metering: each launch's argv must name the SAME per-launch
// events path the metering reader opens — a path shared across launches let a later launch
// rewrite an earlier one's stream and erase its token usage (see the comment above
// dispatch_audit_unit_command in the actuator).
fn witness_argv_member(xs: List<String>, x: String) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, y) { acc || (y == x) })
}

test fn witness_auditor_launch_writes_the_events_path_metering_reads() -> Bool {
  let instance = srv1_live_dashboard_instance()
  match dispatch_audit_unit_command(
    instance: instance,
    node_id: roadmap_dispatch_actuator_nid(s: "witness-node"),
    attempt_key: "witness-attempt",
    worktree_path: "/tmp/fci-witness-worktree",
    brief: "witness brief",
    head_sha: "fci1witnesssha",
    exit_hook: "+mkdir -- /i/attempt-exit-spool/inbox/x" as NonEmptyStr,
  ) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command: command } =>
      witness_argv_member(
        xs: argv_words(command: command),
        x: join(
          ["events_path=", dispatch_attempt_audit_events_path_for_instance(instance: instance, node_id: roadmap_dispatch_actuator_nid(s: "witness-node"), attempt_key: "witness-attempt", head_sha: "fci1witnesssha")],
          "",
        ),
      )
  }
}

test fn witness_supervisor_launch_writes_the_events_path_metering_reads() -> Bool {
  let instance = srv1_live_dashboard_instance()
  match dispatch_supervisor_unit_command(
    instance: instance,
    node_id: roadmap_dispatch_actuator_nid(s: "witness-node"),
    attempt_key: "witness-attempt",
    turn: 7,
    worktree_path: "/tmp/fci-witness-worktree",
    brief: "witness brief",
  ) {
    SystemdRunCommandRefused { cause: _ } => false
    SystemdRunCommandReady { command: command } =>
      witness_argv_member(
        xs: argv_words(command: command),
        x: join(
          ["events_path=", dispatch_attempt_supervisor_events_path_for_instance(instance: instance, node_id: roadmap_dispatch_actuator_nid(s: "witness-node"), attempt_key: "witness-attempt", turn: 7)],
          "",
        ),
      )
  }
}

test fn witness_headless_claude_uses_a_transient_unit_with_stream_json_on_the_events_path() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let node_id = "claude-headless"
  let attempt_key = "feedfacefeedface"
  let events = dispatch_attempt_events_path_for_instance(
    instance: instance,
    node_id: roadmap_dispatch_actuator_nid(s: node_id),
    attempt_key: attempt_key,
  )
  let log = dispatch_attempt_worker_log_path_for_instance(
    instance: instance,
    node_id: roadmap_dispatch_actuator_nid(s: node_id),
    attempt_key: attempt_key,
  )
  match dispatch_session_container_for_provider(
    provider: ClaudeCodeProvider,
    instance: instance,
    node_id: node_id,
    attempt_key: attempt_key,
    session_name: "unused",
    events_path: events,
    worker_log_path: log,
    pane_working_directory: "/wt",
    worktree_path: "/wt",
    provider_inner: ["claude", "-p"],
  ) {
    DispatchSessionContainerUnavailable { step: _, detail: _ } => false
    DispatchSessionContainerReady { container } =>
      match container {
        TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => false
        SystemdUnitContainer { plan } =>
          plan.unit == dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key)
            && plan.working_directory == "/wt"
            && plan.stdout_path == events
            && plan.stderr_path == log
      }
  }
}

// review 78389. The spawn fold used to emit the tmux tee/pipe payload before choosing a container, so
// a Claude (systemd stdout) refusal was named tmux-event-pipe-emit. Pipe emission now lives only on
// the tmux container arm; this spawn is the real producer, and a pipe-step refusal here is the defect.
test fn witness_headless_claude_spawn_does_not_refuse_as_tmux_event_pipe() -> Bool {
  match dispatch_spawn_commands_for_resolved_instance(
    instance: srv1_live_dashboard_instance(),
    node: sized_derivable(id: "claude-headless-spawn", prs: [], title: "Headless Claude spawn"),
    session_uuid: "00000000-0000-4000-8000-000000000005",
    attempt_key: "feedfacefeedface",
    provider: ClaudeCodeProvider,
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
    origin: FreshFromBase,
    resolution: fixture_ready_resolution(node_id: "claude-headless-spawn", project_ids: []),
  ) {
    DispatchSpawnRefused { step, detail: _ } => (step as String) != "tmux-event-pipe-emit"
    DispatchSpawnReady { commands } =>
      match commands.session_container {
        SystemdUnitContainer { plan: _ } => true
        TmuxSessionContainer { spawn: _, default_shell: _, remain_on_exit: _, event_pipe: _, provider_start: _ } => false
      }
  }
}
