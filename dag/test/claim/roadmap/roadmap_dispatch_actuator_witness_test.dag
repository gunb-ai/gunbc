test fn witness_tmux_attempt_panes_parse_alive_and_exit() -> Bool {
  match parse_tmux_attempt_panes_output(
    output: "gunbc-dispatch-a\t0\t\tnode\ngunbc-dispatch-b\t1\t7\tnode\n",
  ) {
    AttemptPanesParsed { panes } =>
      count(panes) == 2
        && !panes.first().dead
        && panes.skip(n: 1).first().dead
        && panes.skip(n: 1).first().exit_code == Present { value: 7 }
    AttemptPanesParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_tmux_attempt_panes_malformed_row_refuses() -> Bool {
  match parse_tmux_attempt_panes_output(
    output: "gunbc-dispatch-a\t1\tbogus\tnode\n",
  ) {
    AttemptPanesParsed { panes: _ } => false
    AttemptPanesParseRefused { line_number, raw, reason } =>
      line_number == 1
        && string_contains(s: raw, pattern: "bogus")
        && string_contains(s: reason, pattern: "dead/status")
  }
}

data event_pipe_emission_witness_note: String = "review 44063. The claim is no longer 'the caller remembered to quote' — quoting is the lit-word production's job now, so the exact emitted spelling is the oracle: every word single-quoted, and an embedded quote closed/escaped/reopened as '\\''. The metacharacter fixture stays because it is what a spelling regression would smuggle: a $(...) inside the events path must be inert text in the payload, never a command substitution. The poison RED holds the serializer-refusal arm dead in corpus."

fn emitted_pipe_body_matches(body: String) -> Bool {
  body == "'exec' '/usr/bin/tee' '-a' '--' '/tmp/a'\\'';$(touch nope)'"
}

test fn witness_event_pipe_emits_grammar_quoted_command() -> Bool {
  match dispatch_event_pipe_emission(
    tee_program: "/usr/bin/tee",
    events_path: "/tmp/a';$(touch nope)",
  ) {
    PipeEmitRefused { detail: _ } => false
    PipeEmitted { command } =>
      emitted_pipe_body_matches(body: command.body as String)
  }
}

test fn witness_provider_projection_is_exact_bounded_capability() -> Bool {
  let cmd = dispatch_current_attempt_events_projection_argv_for_instance(
    instance: srv1_lab_dashboard_instance(),
    node_id: roadmap_dispatch_actuator_nid(s: "projection-node"),
  )
  let wire = join(cmd.args, separator: "\0")
  cmd.program == "/usr/bin/jq"
    && starts_with(s: wire, prefix: "--raw-input\0--compact-output\0fromjson |")
    && string_contains(s: wire, pattern: "[0:128]")
    && string_contains(s: wire, pattern: ".[0:4096]")
    && string_contains(
      s: wire,
      pattern: "\0/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-v0/attempt-state/projection-node-current/provider-events.jsonl",
    )
    && !string_contains(s: wire, pattern: "aggregated_output")
}

test fn codex_provider_v0_argv_keystone_holds() -> Bool {
  witness_probe_bridge_ineligible_standing_refuses_actuator_selection()
    && witness_actuator_automatic_selection_refuses_with_standing_reason()
    && witness_projection_standing_refusal_specimen_holds()
    && witness_fixture_codex_fingerprint_is_historical_npm_shim_receipt()
    && witness_codex_argv_is_unattended_but_sandboxed()
    && witness_selected_provider_shapes_codex_tmux_command()
    && witness_lab_instance_moves_repo_tmux_and_codex_state_together()
    && witness_tmux_attempt_panes_parse_alive_and_exit()
    && witness_tmux_attempt_panes_malformed_row_refuses()
    && witness_event_pipe_emits_grammar_quoted_command()
    && witness_provider_projection_is_exact_bounded_capability()
    && witness_host_exec_argv_shapes_bound_to_extdeps()
}

test fn witness_stop_argv_targets_session() -> Bool {
  let cmd = tmux_kill_session_argv(session_name: "gunbc-dispatch-node-3")
  cmd.args == ["kill-session", "-t", "gunbc-dispatch-node-3"]
}

test fn witness_tmux_ls_parse_filters_prefix() -> Bool {
  let output = "other: 1 windows (created Fri Jul  3 04:14:00 2026)\ngunbc-dispatch-node-4: 2 windows (created Fri Jul  3 04:15:00 2026)\n"
  match parse_tmux_ls_output(output: output) {
    TmuxLsParsed { entries } => {
      let filtered = filter_dispatch_tmux_sessions(entries: entries)
      count(filtered) == 1
        && filtered.first().session_name == "gunbc-dispatch-node-4"
        && filtered.first().windows == 2
    }
    TmuxLsParseRefused { line_number: _, raw: _, reason: _ } => false
  }
}

test fn witness_not_ready_node_refused() -> Bool {
  let parent = sized_derivable(id: "parent", prs: [100], title: "Parent")
  let child = sized_derivable(id: "child", prs: [200], title: "Child")
  let edges = [RoadmapEdge { child: roadmap_dispatch_actuator_nid(s: "child"), parent: roadmap_dispatch_actuator_nid(s: "parent") }]
  let doc = fixture_doc(nodes: [parent, child], edges: edges)
  let ready = next_spawnable(doc: doc, merged: [])
  match classify_dispatch_request_for_process_fingerprint(
    node: child,
    ready: ready,
    tmux_entries: [],
    attempt_key: "feedfacefeedface",
    process_fingerprint: dispatch_codex_process_fingerprint,
    effort: ReasoningMedium,
  ) {
    DispatchRefused { reason: r } => string_contains(s: r as String, pattern: "not in ready frontier")
    _ => false
  }
}

test fn witness_ready_node_permitted_without_live_session() -> Bool {
  let node = sized_derivable(id: "ready-node", prs: [10], title: "Ready")
  let doc = fixture_doc(nodes: [node], edges: [])
  let ready = next_spawnable(doc: doc, merged: [])
  match classify_dispatch_request_for_process_fingerprint(
    node: node,
    ready: ready,
    tmux_entries: [],
    attempt_key: "feedfacefeedface",
    process_fingerprint: dispatch_codex_process_fingerprint,
    effort: ReasoningMedium,
  ) {
    DispatchPermitted { session_name: s, worktree_path: w, branch_name: b, brief: br, reasoning_effort: e } =>
      s == "gunbc-dispatch-ready-node"
        && string_contains(s: w, pattern: "ready-node-afeedfacefeedface")
        && b == "dispatch/ready-node-afeedfacefeedface"
        && string_contains(s: br, pattern: "Ready")
        && reasoning_effort_label(effort: e) == "medium"
    _ => false
  }
}

test fn witness_live_lease_refused() -> Bool {
  let node = sized_derivable(id: "leased-node", prs: [11], title: "Leased")
  let doc = fixture_doc(nodes: [node], edges: [])
  let ready = next_spawnable(doc: doc, merged: [])
  let entries = [TmuxLsEntry { session_name: "gunbc-dispatch-leased-node", windows: 1 }]
  match classify_dispatch_request_for_process_fingerprint(
    node: node,
    ready: ready,
    tmux_entries: entries,
    attempt_key: "feedfacefeedface",
    process_fingerprint: dispatch_codex_process_fingerprint,
    effort: ReasoningMedium,
  ) {
    DispatchRefused { reason: r } =>
      string_contains(s: r as String, pattern: "name occupied")
        && string_contains(s: r as String, pattern: "fingerprint unobserved")
    _ => false
  }
}

test fn witness_absent_lease_classifies_spawn() -> Bool {
  let scope = dispatch_tmux_session_scope_for_process_fingerprint(
    node_id: roadmap_dispatch_actuator_nid(s: "lease-absent"),
    process_fingerprint: dispatch_codex_process_fingerprint,
  )
  match classify_dispatch_lease_upsert(scope: scope, obs: SessionAbsent) {
    UpsertClassification { verdict: Absent, decision: Apply { plan: SpawnSession } } => true
    _ => false
  }
}

