fn roadmap_dispatch_actuator_nid(s: String) -> RoadmapNodeId { s }

fn sized_derivable(id: String, prs: List<Int>, title: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_R2PE6DBK7RVVR2NHNQN0" as RoadmapNodeIdentity,
    node: roadmap_dispatch_actuator_nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: "" },
    carriers: [],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
    parent: none,
    centering: none,
  }
}

fn fixture_section(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapSection {
  RoadmapSection {
    title: "Test",
    elements: [Group { group: SectionGroup { label: "test", nodes: nodes, edges: edges } }],
  }
}

fn fixture_doc(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [fixture_section(nodes: nodes, edges: edges)],
  }
}

// FIXTURE RESOLUTIONS, supplied at the boundary: the spawn-fold claims' subject is the command
// shape and the gate, not the authority derivation, so the resolution arrives as a value. A Ready
// fixture rides the REAL resolution fold (alignment_resolve_chain renders the prompt and computes
// the due levels) — the chain is the supplied input, the answer is the production derivation.
fn fixture_ready_resolution(node_id: String, project_ids: List<String>) -> AlignmentResolution {
  alignment_resolve_chain(
    chain: AlignmentChained {
      task: AlignmentChainLink { node_id: node_id, purpose: "Fixture purpose", boundary: "Fixture boundary", current_approach: "fixture approach", red_control: "fixture red", handback: "fixture handback", displaced_cost: "fixture cost", contribution_to_parent: "fixture contribution" },
      projects: map(project_ids, pid => AlignmentChainLink {
        node_id: pid,
        purpose: join(["Purpose of ", pid], ""),
        boundary: join(["Boundary of ", pid], ""),
        current_approach: "fixture approach",
        red_control: "fixture red",
        handback: "fixture handback",
        displaced_cost: "fixture cost",
        contribution_to_parent: "fixture contribution",
      }),
      root: decl_ref(module_path: "gunbc.design_document", decl_name: "design_document"),
    },
    turns_elapsed: 1,
    state: alignment_base_cadence_state(),
  )
}

test fn witness_tmux_session_name_prefix() -> Bool {
  dispatch_tmux_session_name(node_id: roadmap_dispatch_actuator_nid(s: "node-1")) == "gunbc-dispatch-node-1"
}

test fn witness_brief_fill_includes_node_metadata() -> Bool {
  let node = sized_derivable(id: "brief-node", prs: [1], title: "Brief Title")
  let brief = fill_dispatch_brief(
    template: dispatch_brief_template,
    fields: dispatch_brief_fields(node: node),
  )
  string_contains(s: brief, pattern: "Node: brief-node")
    && string_contains(s: brief, pattern: "Brief Title")
}

test fn witness_dispatch_effort_ignores_intricacy() -> Bool {
  let instance = srv1_live_dashboard_instance()
  let inventory = fixture_inventory_codex_only_available(instance: instance)
  let high = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    sizing_expectation: DerivedSizingExpectation {
      sizing: NodeSizing { intricacy: IntricacyHigh, volume: VolumeLarge },
    },
  )
  let low = resolve_dispatch_selection(
    inventory: inventory,
    request: default_provider_selection_request(),
    sizing_expectation: DerivedSizingExpectation {
      sizing: NodeSizing { intricacy: IntricacyLow, volume: VolumeSmall },
    },
  )
  match high {
    DispatchSelectionResolved { receipt: high_receipt } =>
      match low {
        DispatchSelectionResolved { receipt: low_receipt } =>
          reasoning_effort_label(effort: high_receipt.applied_effort) == "medium"
            && reasoning_effort_label(effort: low_receipt.applied_effort) == "medium"
            && high_receipt.applied_effort == low_receipt.applied_effort
        DispatchSelectionRefused { requested_selection: _, reason: _ } =>
          false
      }
    DispatchSelectionRefused { requested_selection: _, reason: _ } => false
  }
}

test fn witness_claude_argv_uses_dangerous_skip_permissions() -> Bool {
  let argv = claude_spawn_argv(
    effort: ReasoningHigh,
    model: ProviderAccountDefaultModel,
    brief: "brief body",
  )
  string_contains(s: join(argv, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && string_contains(s: join(argv, separator: "\0"), pattern: "-p")
    && string_contains(s: join(argv, separator: "\0"), pattern: "stream-json")
    && string_contains(s: join(argv, separator: "\0"), pattern: "--effort")
    && !string_contains(s: join(argv, separator: "\0"), pattern: "--session-id")
    && !string_contains(s: join(argv, separator: "\0"), pattern: "--resume")
}

test fn witness_git_worktree_argv_is_execfile_safe() -> Bool {
  let cmd = git_worktree_add_argv(
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-1",
    branch_name: "dispatch/node-1",
    remote_ref: "origin/main",
  )
  cmd.program == "git"
    && cmd.args == ["worktree", "add", "/opt/gunbc/dispatch-worktrees/node-1", "-b", "dispatch/node-1", "origin/main"]
}

test fn witness_tmux_spawn_argv_threads_claude_argv() -> Bool {
  let claude = claude_spawn_argv(
    effort: ReasoningMedium,
    model: ProviderAccountDefaultModel,
    brief: "brief",
  )
  let cmd = tmux_spawn_argv(
    session_name: "gunbc-dispatch-node-2",
    worktree_path: "/opt/gunbc/dispatch-worktrees/node-2",
    claude_argv: claude,
  )
  cmd.program == "tmux"
    && starts_with(s: join(cmd.args, separator: " "), prefix: "new-session -d -s gunbc-dispatch-node-2")
    && string_contains(s: join(cmd.args, separator: "\0"), pattern: "CLAUDE_CODE_NO_FLICKER=1")
}

test fn witness_probe_bridge_ineligible_standing_refuses_actuator_selection() -> Bool {
  let instance = srv1_live_dashboard_instance()
  match dashboard_instance_provider_executable(instance: instance) {
    Absent => false
    Present { value: executable } =>
      match resolve_dispatch_selection(
        inventory: ProviderInventory {
          offers: [
            fixture_codex_offer_with_standing(
              instance: instance,
              standing: provider_standing_from_observed_bundle(
                fact_id: selection_fixture_standing_fact_id,
                provider: codex_offer_for_instance_with_standing(
                  instance: instance,
                  standing: provider_standing_inventory_unobserved(),
                  executable: executable,
                  process_fingerprint: fixture_codex_process_fingerprint_standing(),
                ).instance,
                bundle: provider_standing_bundle_from_codex_dashboard_probes(
                  observation: CodexProviderDashboardProbeObservation {
                    state_root: CodexStateRootPresent,
                    runtime: ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "codex-cli 0.145.0",
                      stderr: "",
                    },
                    auth: ProviderDashboardExecProbeReported {
                      succeeded: true,
                      stdout: "",
                      stderr: "Logged in using ChatGPT",
                    },
                  },
                ),
              ),
              executable: executable,
            ),
          ],
        },
        request: default_provider_selection_request(),
        sizing_expectation: NoDerivedSizingExpectation,
      ) {
        DispatchSelectionRefused { requested_selection: _, reason } =>
          reason == dispatch_selection_standing_ineligible_reason
        DispatchSelectionResolved { receipt: _ } => false
      }
  }
}

