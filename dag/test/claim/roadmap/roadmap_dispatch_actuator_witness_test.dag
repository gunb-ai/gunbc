test fn witness_host_exec_argv_shapes_bound_to_extdeps() -> Bool {
  let worktree_args = shape_git_worktree_add_argv(
    path: "/opt/gunbc/dispatch-worktrees/bound-node" as FilePath,
    branch: "dispatch/bound-node" as NonEmptyStr,
    remote_ref: "origin/main" as GitRef,
  )
  let bound_worktree = git_worktree_add_argv(
    worktree_path: "/opt/gunbc/dispatch-worktrees/bound-node",
    branch_name: "dispatch/bound-node",
    remote_ref: "origin/main",
  )
  let tmux_args = shape_tmux_new_session_argv(
    session_name: "gunbc-dispatch-bound-node",
    working_dir: "/opt/gunbc/dispatch-worktrees/bound-node",
    inner_argv: ["env", "CLAUDE_CODE_NO_FLICKER=1"],
  )
  let claude_args_dangerous = shape_claude_invoke_argv(
    session_id: "uuid-bound",
    node_id: "bound-node",
    effort: ReasoningHigh,
    settings_json: "{}",
    append_system_prompt: "brief",
    start_prompt: "go",
    permission_args: ["--dangerously-skip-permissions"],
  )
  let claude_args_default = shape_claude_invoke_argv(
    session_id: "uuid-bound",
    node_id: "bound-node",
    effort: ReasoningHigh,
    settings_json: "{}",
    append_system_prompt: "brief",
    start_prompt: "go",
    permission_args: [],
  )
  let codex_args = shape_codex_exec_argv(
    codex_home: "/home/u/.codex-dispatch",
    cwd: "/opt/gunbc/dispatch-worktrees/bound-node",
    prompt: "brief",
    reasoning_effort: ReasoningHigh,
    spec: CodexExecSpec {
      sandbox: CodexWorkspaceWrite,
      approval: CodexApprovalNever,
      json_events: true,
      persist_session: true,
    },
  )
  bound_worktree.args == worktree_args
    && starts_with(s: join(tmux_args, separator: " "), prefix: "new-session -d -s gunbc-dispatch-bound-node")
    && string_contains(s: join(claude_args_dangerous, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && !string_contains(s: join(claude_args_default, separator: "\0"), pattern: "--dangerously-skip-permissions")
    && string_contains(s: join(codex_args, separator: "\0"), pattern: "\0codex\0--ask-for-approval\0never\0exec")
    && string_contains(s: join(codex_args, separator: "\0"), pattern: "\0--sandbox\0workspace-write\0--color\0never\0--json")
    && !string_contains(s: join(codex_args, separator: "\0"), pattern: "--ephemeral")
}

