module test.claim.roadmap.roadmap_task_record_witness

// A sample RoadmapNode fixture shared by roadmap witnesses. The runtime task record it once tested was deleted
// with the fabric task store (2026-11-08).

import std.types { Bool, String, NonEmptyStr, FilePath, List }
import gunbc.roadmap.roadmap_model { RoadmapNode, RoadmapNodeId, RoadmapNodeIdentity, Pointer, Dispatchable, PrsMerged, MemberOf }
import gunbc.roadmap.roadmap_status { TicketLine, TicketFields, TicketUpdate, Unsigned }
import gunbc.roadmap.roadmap_execution_contract { ExecutionContractUnspecified, gunbc_claims_execution_contract }

fn sample_ticket() -> TicketFields {
  TicketFields { headline: "Create tasks at runtime", brief: "b", displaced_cost: "d", current_state: "c", first_slice: "f", red_control: "r", out_of_scope: "o", handback: "h",
    updates: [TicketUpdate { on: "2026-10-09", note: "n" }], authored_on: "2026-10-09", last_verified_on: "" }
}

fn sample_task() -> RoadmapNode {
  RoadmapNode {
    identity: "task-0001" as RoadmapNodeIdentity, node: "runtime-task-one" as RoadmapNodeId,
    line: TicketLine { done: false, ticket: sample_ticket() },
    carriers: [Pointer { label: "plan", path: "docs/plans/x.md" }],
    dispatch: Dispatchable { repo: "gunbc", acceptance: PrsMerged },
    execution: gunbc_claims_execution_contract(entry: "dag/test/claim/x_test.dag" as FilePath, functions: ["a" as NonEmptyStr, "b" as NonEmptyStr]),
    owner: "briansrls", signoff: Unsigned,
    parent: Present { value: MemberOf { project: "roadmap-runtime", contribution: "creates tasks" as NonEmptyStr } },
    centering: Present { value: "daily workspace" as NonEmptyStr },
  }
}
