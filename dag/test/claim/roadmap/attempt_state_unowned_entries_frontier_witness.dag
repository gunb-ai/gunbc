module test.claim.roadmap.attempt_state_unowned_entries_frontier_witness

// The unowned-entries frontier: every unowned durable class beneath the attempt-state root carries its own
// census row keyed by a unique PathSubject identity. THE ORACLE IS AN IDENTITY JOIN, NOT A COUNT.
// Controls:
//   (a) every expected class identity appears exactly once -- missing names the class;
//   (b) no identity appears more than once -- duplicate names the class;
//   (c) the group is a member of the census aggregate by identity.
// The count is NEVER the sole oracle; it is a derived consequence of the identity join.

import std.types { Bool, String, Int, List }
import std.roster_frontier { FrontierRow, FrontierSubject, PathSubject, DeclSubject }
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import gunbc.roadmap.roadmap_attempt_state_store { attempt_state_unowned_entries_frontier_rows }

// The 9 class identities, keyed on the canonical entry-name pattern. This is the roster against which the
// rows are checked; a 10th class requires adding a variant here AND a row in the data, and vice versa.
data attempt_state_unowned_class_identity_roster: List<String> = [
  "job-<pid>.out",
  "job-<pid>.err",
  "<stem>.harness-request.json.response.json",
  "<stem>.harness-request.json.response.headers",
  "handin",
  "supervision-observation-after-turn-<N>",
  "supervision-check-verdict-after-turn-<N>",
  "supervision-check-request-after-turn-<N>",
  "supervision-check-events-after-turn-<N>",
]

fn row_identity_key(row: FrontierRow) -> String {
  match row.subject {
    PathSubject { path: p } => p
    DeclSubject { ref: _ } => ""
  }
}

fn count_with_identity(rows: List<FrontierRow>, identity: String) -> Int {
  match rows {
    Empty {} => 0
    Cons { head: r, tail: rest } =>
      if row_identity_key(row: r) == identity {
        1 + count_with_identity(rows: rest, identity: identity)
      } else {
        count_with_identity(rows: rest, identity: identity)
      }
  }
}

fn first_missing_in(roster: List<String>, rows: List<FrontierRow>) -> String {
  match roster {
    Empty {} => ""
    Cons { head: id, tail: rest } =>
      if count_with_identity(rows: rows, identity: id) == 0 { id }
      else { first_missing_in(roster: rest, rows: rows) }
  }
}

fn first_duplicate_in(roster: List<String>, rows: List<FrontierRow>) -> String {
  match roster {
    Empty {} => ""
    Cons { head: id, tail: rest } =>
      if count_with_identity(rows: rows, identity: id) > 1 { id }
      else { first_duplicate_in(roster: rest, rows: rows) }
  }
}

// (a) For every expected identity, at least one row must carry it.
test fn every_unowned_class_identity_present() -> Bool {
  first_missing_in(roster: attempt_state_unowned_class_identity_roster, rows: attempt_state_unowned_entries_frontier_rows) == ""
}

// (b) No expected identity appears more than once.
test fn no_unowned_class_identity_duplicated() -> Bool {
  first_duplicate_in(roster: attempt_state_unowned_class_identity_roster, rows: attempt_state_unowned_entries_frontier_rows) == ""
}

// (c) Every row in the group carries an identity from the roster (no unknown classes).
test fn every_row_identity_is_in_the_roster() -> Bool {
  any(attempt_state_unowned_entries_frontier_rows, r =>
    any(attempt_state_unowned_class_identity_roster, id => row_identity_key(row: r) == id)
  )
}

// (d) The group is present in the census aggregate (each identity found among all aggregate rows).
test fn the_unowned_entries_frontier_group_is_in_the_census_aggregate() -> Bool {
  let aggregate = census_closure_frontier_rows()
  any(attempt_state_unowned_class_identity_roster, id =>
    any(aggregate, r => row_identity_key(row: r) == id)
  )
}

// (e) Identity join completeness: all roster identities present exactly once in the census aggregate.
test fn unowned_entries_identity_join_complete_in_aggregate() -> Bool {
  let aggregate = census_closure_frontier_rows()
  first_missing_in(roster: attempt_state_unowned_class_identity_roster, rows: aggregate) == ""
}
