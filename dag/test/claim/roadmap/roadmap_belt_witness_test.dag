module test.claim.roadmap_belt_witness

import gunbc.roadmap_model {
  RoadmapNodeId,
  RoadmapNode,
  IntricacyHigh, VolumeMedium,
  PrsMerged,
  Sized,
}
import gunbc.roadmap_status { DerivableLine, Unsigned }
import gunbc.roadmap_execution_contract { ExecutionContractUnspecified }
import gunbc.roadmap_spawner { SpawnFrontier }
import gunbc.roadmap_belt {
  SpawnMode, Paused, ManualReady, AutomaticReady, spawn_mode_label,
  roadmap_belt_production_spawn_mode,
  BeltCapacity,
  BeltReconcile,
  belt_reconcile,
  belt_reconcile_spawn_count,
  belt_reconcile_teardown_count,
  belt_reconcile_refusal_count,
  belt_member_ids,
  belt_reconcile_status_json,
}
import gunbc.roadmap_dispatch_actuator {
  DispatchLiveSession,
  CodexDispatchProvider,
  dispatch_provider_instance_for,
}
import gunbc.worker_lifecycle { worker_observation_without_provider_probe }
import std.upsert_decision {
  ObservationVerdict, Converged, Drifted, Conflict, Inaccessible, UnknownRefused
}
import std.types { String, Int, List, Bool }

fn roadmap_belt_nid(s: String) -> RoadmapNodeId { s }

fn ready_node(id: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_P2E65A1P1148Z5Y175QT" as RoadmapNodeIdentity,
    node: roadmap_belt_nid(s: id),
    line: DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn frontier_ready(ids: List<String>) -> SpawnFrontier {
  SpawnFrontier { ready: map(ids, id => ready_node(id: id)), upcoming: [], done: [], superseded: [] }
}

fn cap(n: Int) -> BeltCapacity { BeltCapacity { max_concurrent: n } }

fn live_session(node_id: String, verdict: ObservationVerdict) -> DispatchLiveSession {
  DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: verdict,
    worker: worker_observation_without_provider_probe(
      instance: dispatch_provider_instance_for(provider: CodexDispatchProvider),
    ),
  }
}

fn spawns_node(r: BeltReconcile, id: String) -> Bool {
  any(belt_member_ids(ms: r.spawns), x => x == id)
}

fn tears_down_node(r: BeltReconcile, id: String) -> Bool {
  any(belt_member_ids(ms: r.teardowns), x => x == id)
}

test fn witness_reconcile_spawns_ready_missing_session() -> Bool {
  let f = frontier_ready(ids: ["a", "b"])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [], cap: cap(n: 3))
  belt_reconcile_spawn_count(r: r) == 2
    && spawns_node(r: r, id: "a")
    && spawns_node(r: r, id: "b")
    && belt_reconcile_teardown_count(r: r) == 0
    && belt_reconcile_refusal_count(r: r) == 0
}

test fn witness_reconcile_noop_when_ready_and_live() -> Bool {
  let f = frontier_ready(ids: ["a"])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [live_session(node_id: "a", verdict: Converged)], cap: cap(n: 3))
  belt_reconcile_spawn_count(r: r) == 0
    && belt_reconcile_teardown_count(r: r) == 0
    && belt_reconcile_refusal_count(r: r) == 0
}

test fn witness_reconcile_reaps_owned_done_session() -> Bool {
  let f = frontier_ready(ids: ["a"])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [live_session(node_id: "z", verdict: Converged)], cap: cap(n: 3))
  belt_reconcile_teardown_count(r: r) == 1
    && tears_down_node(r: r, id: "z")
    && belt_reconcile_spawn_count(r: r) == 1
    && spawns_node(r: r, id: "a")
    && belt_reconcile_refusal_count(r: r) == 0
}

test fn witness_reconcile_reaps_drifted_owned_session() -> Bool {
  let f = frontier_ready(ids: [])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [live_session(node_id: "z", verdict: Drifted)], cap: cap(n: 3))
  belt_reconcile_teardown_count(r: r) == 1 && tears_down_node(r: r, id: "z")
}

test fn witness_r5_refuses_foreign_teardown() -> Bool {
  let f = frontier_ready(ids: ["a"])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [live_session(node_id: "z", verdict: Conflict)], cap: cap(n: 3))
  belt_reconcile_teardown_count(r: r) == 0
    && !tears_down_node(r: r, id: "z")
    && belt_reconcile_refusal_count(r: r) == 1
    && belt_reconcile_spawn_count(r: r) == 1
}

test fn witness_r5_refuses_nameonly_teardown() -> Bool {
  let f = frontier_ready(ids: [])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [live_session(node_id: "z", verdict: UnknownRefused)], cap: cap(n: 3))
  belt_reconcile_teardown_count(r: r) == 0 && belt_reconcile_refusal_count(r: r) == 1
}

test fn witness_reconcile_capacity_defers_surfaced() -> Bool {
  let f = frontier_ready(ids: ["a", "b", "c"])
  let r = belt_reconcile(state: AutomaticReady, frontier: f, live: [], cap: cap(n: 1))
  belt_reconcile_spawn_count(r: r) == 1 && r.deferred == 2
}

// RLM-1 red control (b) at the reconcile layer: ManualReady still PLANS -- the departed member is torn
// down and the ready-not-observed member is planned as an upsert for the tick's admission to refuse --
// so the mode is distinguishable from Paused on the reconcile axis and the reap arm continues.
test fn witness_reconcile_manual_ready_still_reaps_and_plans() -> Bool {
  let f = frontier_ready(ids: ["a"])
  let r = belt_reconcile(state: ManualReady, frontier: f, live: [live_session(node_id: "z", verdict: Converged)], cap: cap(n: 3))
  belt_reconcile_teardown_count(r: r) == 1
    && tears_down_node(r: r, id: "z")
    && belt_reconcile_spawn_count(r: r) == 1
    && spawn_mode_label(m: r.mode) == "manual_ready"
}

test fn witness_reconcile_paused_no_actions() -> Bool {
  let f = frontier_ready(ids: ["a", "b"])
  let r = belt_reconcile(state: Paused, frontier: f, live: [live_session(node_id: "z", verdict: Converged)], cap: cap(n: 3))
  belt_reconcile_spawn_count(r: r) == 0
    && belt_reconcile_teardown_count(r: r) == 0
    && belt_reconcile_refusal_count(r: r) == 0
}

test fn witness_reconcile_status_json_shape() -> Bool {
  let f = frontier_ready(ids: ["a"])
  let j = belt_reconcile_status_json(state: AutomaticReady, frontier: f, live: [live_session(node_id: "z", verdict: Conflict)], cap: cap(n: 3))
  string_contains(s: j, pattern: "roadmap-belt-reconcile/v1")
    && string_contains(s: j, pattern: "would_teardown")
    && string_contains(s: j, pattern: "refusal_count")
    && string_contains(s: j, pattern: "deferred")
}
