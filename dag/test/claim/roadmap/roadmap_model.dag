module test.claim.roadmap.roadmap_model

import gunbc.roadmap.roadmap_status {
  DriftVerdict, Drifted, Clean, Underivable,
}
import gunbc.roadmap.roadmap_model {
  RoadmapNodeId,
  RoadmapEdge,
  RoadmapParent, TopLevel, UnderParent,
  roadmap_primary_parent, roadmap_parent_ids, is_top_level,
}

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data parent_node: RoadmapNodeId = "invert-hand-maintained"
data second_parent_node: RoadmapNodeId = "model-before-implement"
data roadmap_model_child_node: RoadmapNodeId = "pr-checkbox-status"
data orphan_node: RoadmapNodeId = "no-parent-node"

fn edges() -> List<RoadmapEdge> {
  [RoadmapEdge { child: roadmap_model_child_node, parent: parent_node }]
}

fn verdict_is_drifted(v: DriftVerdict) -> Bool {
  match v { Drifted => true  Clean => false  Underivable => false }
}
test fn witness_child_has_parent() -> Bool {
  match roadmap_primary_parent(edges: edges(), node: roadmap_model_child_node) {
    UnderParent { parent: p } => p == parent_node
    TopLevel => false
  }
}

test fn witness_multi_parent_dependencies_are_not_flattened() -> Bool {
  let es = [
    RoadmapEdge { child: roadmap_model_child_node, parent: parent_node },
    RoadmapEdge { child: roadmap_model_child_node, parent: second_parent_node },
  ]
  roadmap_parent_ids(edges: es, node: roadmap_model_child_node) == [parent_node, second_parent_node]
    && match roadmap_primary_parent(edges: es, node: roadmap_model_child_node) {
      UnderParent { parent: p } => p == parent_node
      TopLevel => false
    }
}

test fn witness_orphan_is_top_level() -> Bool {
  is_top_level(edges: edges(), node: orphan_node)
}

test fn witness_parent_is_top_level() -> Bool {
  is_top_level(edges: edges(), node: parent_node)
}
