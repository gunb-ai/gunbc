module test.claim.roadmap.roadmap_attempt_redelivery_wake_witness

// THE LOGIC OF THE REQUEST-PENDING RE-DELIVERY WAKE, at interfaces whose import closure AVOIDS
// gunbc.host.host_effect (main's seed refuses host_effect_is_converge_loop_evidence): the continuation
// decision (roadmap_attempt_continuation), the capture obligation (roadmap_belt_obligation), the wake
// module and the systemd_run command it builds. The route claims -- the belt fold maps the decision to
// SpawnRouteWake, the arm classifier, the wake entry's guards -- live in
// test.claim.roadmap.roadmap_attempt_redelivery_route_witness, which reaches host_effect through
// roadmap_belt_actuate and so is a declared, UNEXECUTED obligation. Supplying the decision here removes
// no execution of the real route: the route witness is the inhabitance claim of this boundary.

import std.types { Bool, EpochSecs, NonEmptyStr, String, List }
import std.optional { Present }
import gunbc.auth.authorization_pattern_selection { PatternSelected, FederatedScopedGrant, select_authorization_pattern, witness_required }
import gunbc.roadmap.roadmap_attempt_redelivery_wake {
  attempt_redelivery_wake_effect,
  WakeAuthorized,
  WakeAuthorizationRefused,
  attempt_redelivery_wake_authorization,
  attempt_redelivery_wake_unit_name,
  attempt_redelivery_wake_command,
}
import gunbc.roadmap.roadmap_attempt_continuation {
  PriorAttemptFacts, ContinuationHold, ContinuationHoldUntil, ContinuationResume, continuation_decision,
}
import gunbc.harness.harness_session_recovery { SessionRecovery, SessionRecoveryRequestPending, PendingUpstreamBusy }
import gunbc.roadmap.roadmap_submission { SubmissionCaptureObservation, CaptureAbsent }
import gunbc.roadmap.roadmap_provider_events { ProviderRequestPending, ProviderRunning }
import gunbc.roadmap.roadmap_belt_obligation { belt_provider_terminal, belt_attempt_outstanding, belt_attempt_obligation_kind_key, CaptureObligation, BeltAttemptObligationKind }
import gunbc.roadmap.roadmap_workflow_stage {
  WorkflowSegment, SubmissionWorkflowSegment, VerificationWorkflowSegment, ReviewWorkflowSegment, GoalAuditWorkflowSegment, PublicationWorkflowSegment,
  WorkflowSegmentPending, WorkflowSegmentFailed, WorkflowSegmentState,
}
import gunbc.roadmap.roadmap_refused_retry { RefusedRetryOperatorOnly }
import extdeps.systemd.systemd_run { SystemdRunCommandReady, SystemdRunCommandRefused, SystemdSetenvBinding, NamedUnitSetting }
import extdeps.systemd { WorkingDirectoryProperty }
import extdeps.exec.command { argv_words }

data wake_now: EpochSecs = 1700000000
data wake_user: NonEmptyStr = "srv1lab"
data wake_key: String = "e5a42384c6a5e13d"
data wake_node: String = "roadmap-belt"

fn wedged_recovery(last_delivery: EpochSecs) -> SessionRecovery {
  SessionRecoveryRequestPending {
    cause: PendingUpstreamBusy,
    since: wake_now,
    re_deliveries: 0,
    wakes_made: 0,
    last_delivery_at: last_delivery,
    resumable: true,
    interrupted_calls: [],
    resume_round: 7,
  }
}

fn wedged_pri(capture: SubmissionCaptureObservation, last_delivery: EpochSecs, worker_terminal: Bool, now: EpochSecs?) -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: wake_node,
    attempt_key: wake_key,
    branch: "still-owl-805-pending-attempt-replay",
    worker_terminal: worker_terminal,
    capture: capture,
    verification: none,
    review: none,
    goal_audit: none,
    recovery: wedged_recovery(last_delivery: last_delivery),
    verification_retry: RefusedRetryOperatorOnly,
    now: now,
  }
}

// THE WAKE IS AUTHORIZED BY THE SELECTOR AT THE INTERFACE THE ROUTE CALLS. attempt_redelivery_wake_authorization is
// the one function the SpawnRouteWake arm executes before arming: for the real wake effect (credential-free,
// reversible, unattended, API surface) the selector answers the federated scoped grant AND no human witness is
// owed, so the reading is WakeAuthorized. The independent selector call beside it cross-checks the answer
// (the pattern the function accepted is the pattern the selector gives), not a re-derivation of the route.
test fn a_wake_effect_is_authorized_only_by_the_federated_grant_with_no_witness_owed() -> Bool {
  (match attempt_redelivery_wake_authorization(operating_user: wake_user) {
    WakeAuthorized => true
    WakeAuthorizationRefused { detail: _ } => false
  })
    && (match select_authorization_pattern(e: attempt_redelivery_wake_effect(operating_user: wake_user)) {
      PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
      _ => false
    })
    && !witness_required(e: attempt_redelivery_wake_effect(operating_user: wake_user))
}

// THE UPGRADE PATH AT THE LOGIC INTERFACES (no fresh dispatch): the already-wedged round-7 attempt. The
// ended request-pending worker owes capture (belt_provider_terminal); with CaptureAbsent recorded the
// continuation HOLDS UNTIL a typed future instant for THIS attempt key; that instant names the wake unit, and
// the armed command is a user-manager --on-calendar timer carrying WorkingDirectory, the attempt-key unit and
// the re-delivery entry. The route that maps the decision to the arming is the route witness's claim.
test fn the_wedged_pending_attempt_holds_until_an_instant_and_names_a_wake() -> Bool {
  let capture_owed = belt_provider_terminal(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" })
  let decision = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: wake_now, worker_terminal: true, now: Present { value: wake_now }) })
  let armed = match decision {
    ContinuationHoldUntil { reason: _, attempt_key, redeliver_at } =>
      attempt_key == wake_key && redeliver_at > wake_now && (match attempt_redelivery_wake_command(
        node_id: wake_node, attempt_key: attempt_key, next_delivery: redeliver_at,
        properties: [NamedUnitSetting { property: WorkingDirectoryProperty, value: "/opt/gunbc-lab/codex-provider-feedback-v0/source" as NonEmptyStr }],
        setenv_bindings: [
          SystemdSetenvBinding { name: "GUNBC_BELT_NODE_ID" as NonEmptyStr, value: wake_node as NonEmptyStr },
          SystemdSetenvBinding { name: "GUNBC_BELT_REDELIVER_INSTANCE_ID" as NonEmptyStr, value: "srv1-lab-codex-feedback-v0" as NonEmptyStr },
        ],
        command_argv: ["gunbc", "run", "--entry", "dag/gunbc/roadmap/roadmap_belt_tick_cli.dag", "--function", "belt_redeliver_attempt_cli"],
      ) {
        SystemdRunCommandReady { command } =>
          let line = join(argv_words(command: command), separator: " ")
          string_contains(s: line, pattern: "--user")
            && string_contains(s: line, pattern: "--on-calendar=")
            && string_contains(s: line, pattern: join(["--unit=", attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: attempt_key, instant: redeliver_at) as String], ""))
            && string_contains(s: line, pattern: "--property=WorkingDirectory=/opt/gunbc-lab/codex-provider-feedback-v0/source")
            && string_contains(s: line, pattern: "--timer-property=RemainAfterElapse=no")
            && string_contains(s: line, pattern: "--setenv=GUNBC_BELT_REDELIVER_INSTANCE_ID=srv1-lab-codex-feedback-v0")
            && string_contains(s: line, pattern: "--function belt_redeliver_attempt_cli")
        SystemdRunCommandRefused { cause: _ } => false
      })
    _ => false
  }
  capture_owed && armed
}

// ONE WAKE PER PENDING WINDOW, AND A RE-PEND WAKES AGAIN. The unit name carries the re-delivery instant,
// so arming the SAME instant twice names the SAME unit (systemd-run's 'already exists' is then true
// idempotence, not a stack), while a re-pend to a LATER instant -- the redelivered-attempt-429-again
// case, where the transport-retry policy computes a new instant -- names a DISTINCT unit and so is
// genuinely re-armed rather than masked by the old one. Both directions, one witness.
test fn a_repended_wake_gets_a_distinct_unit_and_the_same_instant_is_the_same_unit() -> Bool {
  let earlier = wake_now
  let later = wake_now + 30
  let same_instant_is_same_unit = attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
    == attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
  let later_instant_is_distinct_unit = attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
    != attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: later)
  same_instant_is_same_unit && later_instant_is_distinct_unit
}

// ONLY THE NOT-DUE PENDING HOLD CARRIES AN INSTANT. A live (non-terminal) worker yields a plain Hold with no
// instant to wake at, and a worker whose re-delivery is already due yields a Resume for this key, not a
// HoldUntil: neither names a wake. A running worker owes no capture either.
test fn only_the_not_due_pending_hold_carries_a_wake_instant() -> Bool {
  let live = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: wake_now, worker_terminal: false, now: Present { value: wake_now }) })
  let due = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: 1699900000, worker_terminal: true, now: Present { value: wake_now }) })
  (match live { ContinuationHold { reason: _ } => true, _ => false })
    && (match due { ContinuationResume { reason: _, attempt_key, ordinal: _, causes: _ } => attempt_key == wake_key, _ => false })
    && (!belt_provider_terminal(provider: ProviderRunning { activity: "round 7 in flight" }))
}

fn pending_segments(submission: WorkflowSegmentState) -> List<WorkflowSegment> {
  [
    WorkflowSegment { kind: SubmissionWorkflowSegment, state: submission, detail: "" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
    WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentPending, detail: "" },
  ]
}

fn owed_keys(kinds: List<BeltAttemptObligationKind>) -> String {
  join(kinds |> map(k => belt_attempt_obligation_kind_key(kind: k)), ",")
}

// THE CAPTURE THAT WAS NEVER OWED, at the obligation interface: an ended request-pending worker owes the
// capture that records its yield, a running worker owes none, and once the yield is recorded (the submission
// segment settled Failed) the capture is not re-owed every pass.
test fn a_pending_request_worker_owes_capture_until_its_yield_is_recorded() -> Bool {
  let capture_key = belt_attempt_obligation_kind_key(kind: CaptureObligation)
  string_contains(s: owed_keys(kinds: belt_attempt_outstanding(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" }, segments: pending_segments(submission: WorkflowSegmentPending))), pattern: capture_key)
    && (!string_contains(s: owed_keys(kinds: belt_attempt_outstanding(provider: ProviderRunning { activity: "round 7 in flight" }, segments: pending_segments(submission: WorkflowSegmentPending))), pattern: capture_key))
    && (!string_contains(s: owed_keys(kinds: belt_attempt_outstanding(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" }, segments: pending_segments(submission: WorkflowSegmentFailed))), pattern: capture_key))
}
