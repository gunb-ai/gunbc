module test.claim.roadmap.roadmap_attempt_redelivery_wake

// THE WAKE FOR A REQUEST-PENDING ATTEMPT, WITNESSED END TO END. The fix must pick up the ALREADY-WEDGED
// attempt e5a42384c6a5e13d at round 7 (no fresh dispatch on this lab): the projection makes its capture
// owed; the recorded CaptureAbsent lets the continuation reach its request-pending branch and Hold UNTIL
// a TYPED instant (ContinuationHoldUntil.redeliver_at, the transport_retry_next_delivery_at value); the
// belt maps that decision to a SpawnRouteWake and the armed command is a user-manager --on-calendar timer
// named for the same attempt key, execing the instance's own belt_redeliver_attempt_cli route (which
// resolves the instance by repo root, so it works on srv1-lab where belt_dispatch_node_cli's admitted list
// refuses). A plain
// (untimed) Hold, a due-now Resume, and a non-pending recovery map to NO wake -- so only the not-due
// request-pending hold wakes. The authorization pattern is DERIVED from the selector, not borrowed.

import std.types { Bool, EpochSecs, NonEmptyStr }
import std.optional { Present }
import gunbc.auth.authorization_pattern_selection { PatternSelected, FederatedScopedGrant, select_authorization_pattern, witness_required }
import gunbc.roadmap.roadmap_attempt_redelivery_wake {
  attempt_redelivery_wake_effect,
  attempt_redelivery_wake_selects_pattern,
  attempt_redelivery_wake_needs_no_witness,
  attempt_redelivery_wake_unit_name,
  attempt_redelivery_wake_unit_stem,
  attempt_redelivery_wake_command,
}
import gunbc.roadmap.roadmap_attempt_continuation {
  PriorAttemptFacts,
  ContinuationHoldUntil,
  continuation_decision,
}
import gunbc.roadmap.roadmap_belt_actuate { SpawnRouteWake, SpawnRouteNone, SpawnRouteResume, SpawnRouteWorker, belt_spawn_route_for_decision, ExecOk, ExecFailed, ExecRefused, WakeArmed, WakeAlreadyArmed, WakeArmFailed, WakeArmRefused, belt_redelivery_wake_arm }
import gunbc.roadmap.roadmap_dashboard_instance { dashboard_instance_for_repo_root, DashboardInstanceRootUnknown, DashboardInstanceResolved }
import gunbc.harness.harness_session_recovery { SessionRecovery, SessionRecoveryRequestPending }
import gunbc.roadmap.roadmap_submission { SubmissionCaptureObservation, CaptureAbsent }
import gunbc.roadmap.roadmap_provider_events { ProviderRequestPending }
import gunbc.roadmap.roadmap_belt_obligation { belt_capture_recording_owed }
import gunbc.roadmap.roadmap_refused_retry { RefusedRetryOperatorOnly }
import extdeps.systemd.systemd_run { SystemdRunCommandReady, SystemdRunCommandRefused, SystemdSetenvBinding }
import extdeps.exec.command { argv_words }

data wake_now: EpochSecs = 1700000000
data wake_user: NonEmptyStr = "srv1lab"
data wake_key: String = "e5a42384c6a5e13d"
data wake_node: String = "roadmap-belt"

fn wedged_recovery(last_delivery: EpochSecs) -> SessionRecovery {
  SessionRecoveryRequestPending {
    cause: "provider refused round 7 (429 too many requests)",
    since: wake_now,
    re_deliveries: 0,
    wakes_made: 0,
    last_delivery_at: last_delivery,
    resumable: true,
    interrupted_calls: [],
    resume_round: 7,
  }
}

fn wedged_pri(capture: SubmissionCaptureObservation, last_delivery: EpochSecs, worker_terminal: Bool, now: EpochSecs?) -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: wake_node,
    attempt_key: wake_key,
    branch: "still-owl-805-pending-attempt-replay",
    worker_terminal: worker_terminal,
    capture: capture,
    verification: none,
    review: none,
    goal_audit: none,
    recovery: wedged_recovery(last_delivery: last_delivery),
    verification_retry: RefusedRetryOperatorOnly,
    now: now,
  }
}

// THE WAKE EFFECT'S AUTHORIZATION PATTERN IS DERIVED, NOT BORROWED. Credential-free, reversible,
// unattended user-manager unit; the fold must select the federated pattern, not a human-in-the-loop one.
test fn a_wake_effect_selects_federated_grant_by_the_selector() -> Bool {
  attempt_redelivery_wake_selects_pattern(operating_user: wake_user)
    && (match select_authorization_pattern(e: attempt_redelivery_wake_effect(operating_user: wake_user)) {
      PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
      _ => false
    })
}

// A RECURRING WAKE MUST RUN UNATTENDED. Mints no credential, bills nothing, reversible by re-arming.
test fn a_wake_effect_needs_no_human_witness() -> Bool {
  attempt_redelivery_wake_needs_no_witness(operating_user: wake_user)
    && !witness_required(e: attempt_redelivery_wake_effect(operating_user: wake_user))
}

// THE UPGRADE PATH, END TO END (eager-lynx req: no fresh dispatch). The already-wedged round-7 attempt:
// capture owed; with CaptureAbsent recorded the continuation HOLDS UNTIL a typed future instant; that
// decision maps to a SpawnRouteWake for the same attempt key at that instant; the armed command carries
// --user / --on-calendar / the attempt-key unit / belt_redeliver_attempt_cli (repo-root resolution).
test fn the_wedged_pending_attempt_holds_until_an_instant_and_arms_a_wake() -> Bool {
  let capture_owed = belt_capture_recording_owed(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" })
  let decision = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: wake_now, worker_terminal: true, now: Present { value: wake_now }) })
  let is_hold_until = match decision { ContinuationHoldUntil { reason: _, attempt_key, redeliver_at } => attempt_key == wake_key && redeliver_at > wake_now, _ => false }
  let route = belt_spawn_route_for_decision(decision: decision)
  let route_is_wake = match route { SpawnRouteWake { attempt_key, at } => attempt_key == wake_key && at > wake_now, _ => false }
  let dispatch_env = [
    SystemdSetenvBinding { name: "GUNBC_BELT_SPAWN_WORKDIR" as NonEmptyStr, value: "/opt/gunbc-lab/codex-provider-feedback-v0/source" as NonEmptyStr },
    SystemdSetenvBinding { name: "GUNBC_BELT_NODE_ID" as NonEmptyStr, value: wake_node as NonEmptyStr },
    SystemdSetenvBinding { name: "GUNBC_BELT_REDELIVER_INSTANCE_ID" as NonEmptyStr, value: "srv1-lab-codex-feedback-v0" as NonEmptyStr },
  ]
  let dispatch_argv = [
    "gunbc",
    "run",
    "--source-root", "/repo/dag",
    "--source-root", "/repo/src/v2",
    "--entry", "dag/gunbc/roadmap/roadmap_belt_tick_cli.dag",
    "--function", "belt_redeliver_attempt_cli",
  ]
  let armed = match route {
    SpawnRouteWake { attempt_key, at } => match attempt_redelivery_wake_command(node_id: wake_node, attempt_key: attempt_key, next_delivery: at, setenv_bindings: dispatch_env, command_argv: dispatch_argv) {
      SystemdRunCommandReady { command } =>
        let line = join(argv_words(command: command), separator: " ")
        string_contains(s: line, pattern: "--user")
          && string_contains(s: line, pattern: "--on-calendar=")
          && string_contains(s: line, pattern: "gunbc-attempt-redeliver-roadmap-belt-e5a42384c6a5e13d-")
          && string_contains(s: line, pattern: ".timer")
          && string_contains(s: line, pattern: "--timer-property=RemainAfterElapse=no")
          && string_contains(s: line, pattern: "--setenv=GUNBC_BELT_NODE_ID=roadmap-belt")
          && string_contains(s: line, pattern: "--setenv=GUNBC_BELT_REDELIVER_INSTANCE_ID=srv1-lab-codex-feedback-v0")
          && string_contains(s: line, pattern: "--entry dag/gunbc/roadmap/roadmap_belt_tick_cli.dag")
          && string_contains(s: line, pattern: "--function belt_redeliver_attempt_cli")
      SystemdRunCommandRefused { cause: _ } => false
    }
    _ => false
  }
  capture_owed && is_hold_until && route_is_wake && armed
}

// ONE WAKE PER PENDING WINDOW, AND A RE-PEND WAKES AGAIN. The unit name carries the re-delivery instant,
// so arming the SAME instant twice names the SAME unit (systemd-run's 'already exists' is then true
// idempotence, not a stack), while a re-pend to a LATER instant -- the redelivered-attempt-429-again
// case, where the transport-retry policy computes a new instant -- names a DISTINCT unit and so is
// genuinely re-armed rather than masked by the old one. Both directions, one witness.
test fn a_repended_wake_gets_a_distinct_unit_and_the_same_instant_is_the_same_unit() -> Bool {
  let earlier = wake_now
  let later = wake_now + 30
  let same_instant_is_same_unit = attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
    == attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
  let later_instant_is_distinct_unit = attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: earlier)
    != attempt_redelivery_wake_unit_name(node_id: wake_node, attempt_key: wake_key, instant: later)
  same_instant_is_same_unit && later_instant_is_distinct_unit
}

// THE ALREADY-EXISTS REFUSAL IS READ AS ALREADY-ARMED, NOT A FAILURE (review 87556). The same-name start
// that systemd-run refuses with 'Unit ... already exists' on THIS wake's stem classifies as WakeAlreadyArmed,
// so a belt pass that re-runs the arming of the same instant is not a spurious failure. A refusal naming a
// DIFFERENT unit is not ours and stays a real failure; anything unrecognized keeps exit code + stderr.
test fn the_already_exists_refusal_is_idempotence_and_other_exits_stay_failures() -> Bool {
  let stem = attempt_redelivery_wake_unit_stem(node_id: wake_node, attempt_key: wake_key, instant: wake_now)
  let armed = match belt_redelivery_wake_arm(exec: ExecOk { stdout: "" }, unit_stem: stem) { WakeArmed => true, _ => false }
  let already = match belt_redelivery_wake_arm(exec: ExecFailed { program: "systemd-run", exit_code: 1, stderr: "Failed to create transient unit: Unit gunbc-attempt-redeliver-roadmap-belt-e5a42384c6a5e13d-1700000000.timer already exists." }, unit_stem: stem) { WakeAlreadyArmed => true, _ => false }
  let other_unit_is_not_ours = match belt_redelivery_wake_arm(exec: ExecFailed { program: "systemd-run", exit_code: 1, stderr: "Failed to create transient unit: Unit somebody-else.timer already exists." }, unit_stem: stem) { WakeArmFailed { exit_code, stderr } => exit_code == 1 && string_contains(s: stderr, pattern: "already exists"), _ => false }
  let real_failure_keeps_evidence = match belt_redelivery_wake_arm(exec: ExecFailed { program: "systemd-run", exit_code: 7, stderr: "Failed to connect to bus" }, unit_stem: stem) { WakeArmFailed { exit_code, stderr } => exit_code == 7 && string_contains(s: stderr, pattern: "Failed to connect to bus"), _ => false }
  let refused = match belt_redelivery_wake_arm(exec: ExecRefused { program: "systemd-run", reason: "no transport" }, unit_stem: stem) { WakeArmRefused { reason } => reason == "no transport", _ => false }
  armed && already && other_unit_is_not_ours && real_failure_keeps_evidence && refused
}

// A PLAIN (UNTIMED) HOLD IS NOT WOKEN -- THE DISCRIMINATOR. A request-pending recovery whose worker has
// not ended yields a plain ContinuationHold; it maps to SpawnRouteNone, NOT SpawnRouteWake: a live worker
// is mid-turn and must never be re-dispatched by a timer.
test fn a_plain_hold_maps_to_no_spawn_not_a_wake() -> Bool {
  let decision = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: wake_now, worker_terminal: false, now: Present { value: wake_now }) })
  let route = belt_spawn_route_for_decision(decision: decision)
  match route {
    SpawnRouteNone { step, detail: _ } => step == "continuation-hold"
    _ => false
  }
}

// A DUE-NOW RESUME IS NOT WOKEN. Its re-delivery is already due, so the running route re-delivers it now.
test fn a_resume_due_now_maps_to_a_resume_route_not_a_wake() -> Bool {
  let decision = continuation_decision(prior: Present { value: wedged_pri(capture: CaptureAbsent, last_delivery: 1699900000, worker_terminal: true, now: Present { value: wake_now }) })
  let route = belt_spawn_route_for_decision(decision: decision)
  match route {
    SpawnRouteResume { attempt_key, ordinal: _ } => attempt_key == wake_key
    _ => false
  }
}

// A NON-PENDING RECOVERY IS NOT WOKEN. An attempt with no request standing pending spawns fresh; a timer
// belongs only to a request-pending HoldUntil.
test fn a_non_pending_recovery_maps_to_a_spawn_not_a_wake() -> Bool {
  let no_prior = continuation_decision(prior: none)
  let route = belt_spawn_route_for_decision(decision: no_prior)
  match route {
    SpawnRouteWorker => true
    _ => false
  }
}

// THE ENTRY RESOLVES BY REPO ROOT, NOT BY THE ID LIST (hermetic). belt_redeliver_attempt_cli resolves
// the instance via the belt's own belt_instance_from_env -> dashboard_instance_for_repo_root, keyed on the
// SPAWN WORKDIR (repo root) -- NOT belt_dispatch_instance_named's narrow id list (which is what refuses
// srv1-lab-codex-feedback-v0 and is why the wake does NOT use belt_dispatch_node_cli). The discriminator:
// a path no instance is rooted at, and an instance ID (not a path), both return RootUnknown -- the refusal
// belt_redeliver_attempt_cli surfaces before any dispatch. An id the name-admission WOULD accept ("srv1-live")
// is still RootUnknown by the root lookup, proving the key is the root.
test fn the_redelivery_route_resolves_by_repo_root_not_by_id() -> Bool {
  let unknown_path = match dashboard_instance_for_repo_root(repo_root: "/no/such/belt/repo/root/xyzzy") {
    DashboardInstanceRootUnknown { repo_root } => repo_root == "/no/such/belt/repo/root/xyzzy"
    DashboardInstanceResolved { instance: _ } => false
  }
  let id_is_not_a_root = match dashboard_instance_for_repo_root(repo_root: "srv1-live") {
    DashboardInstanceRootUnknown { repo_root } => repo_root == "srv1-live"
    DashboardInstanceResolved { instance: _ } => false
  }
  unknown_path && id_is_not_a_root
}
