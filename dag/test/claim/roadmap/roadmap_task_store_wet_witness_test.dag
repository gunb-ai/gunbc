module test.claim.roadmap_task_store_wet_witness_test

import std.types { Bool, String, NonEmptyStr, List }
import extdeps.shell
import gunbc.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric_storage_file_store { fabric_storage_file_root, fabric_storage_file_root_ensure, FabricStorageRootReady }
import gunbc.roadmap_model { RoadmapNode }
import gunbc.roadmap_status { TicketLine }
import gunbc.roadmap_task_store { roadmap_task_create, roadmap_tasks_listed, RuntimeTaskCreated, RuntimeTaskReplayed, RuntimeTaskConflict, RuntimeTaskRefused }
import test.claim.roadmap_task_record_witness_test { sample_task, sample_ticket }

fn titled(n: RoadmapNode, headline: String) -> RoadmapNode {
  RoadmapNode { identity: n.identity, node: n.node, line: TicketLine { done: false, ticket: gunbc.roadmap_status.TicketFields { headline: headline, brief: "", displaced_cost: "", current_state: "", first_slice: "", red_control: "", out_of_scope: "", handback: "", updates: [], authored_on: "", last_verified_on: "" } }, carriers: n.carriers, dispatch: n.dispatch, execution: n.execution, owner: n.owner, signoff: n.signoff, parent: n.parent, centering: n.centering }
}

// THE WRITE LANDS against a real file store: create commits, the same key replays without a new
// link, a second key extends the roster in order, and the same key with different fields refuses.
test fn task_store_create_replay_and_conflicting_key() -> Bool {
  let directory = shell.Mktemp.Dir()
  let root = fabric_storage_file_root(root: directory.path)
  let store = FabricStorageLocalFiles { root: root }
  if !directory.success { false } else { match fabric_storage_file_root_ensure(root: root) {
    FabricStorageRootReady => {
      let actor = "briansrls" as NonEmptyStr
      let k1 = "op-1" as NonEmptyStr
      let k2 = "op-2" as NonEmptyStr
      let first = roadmap_task_create(store: store, actor: actor, at: 1, operation_key: k1, draft: sample_task())
      let replay = roadmap_task_create(store: store, actor: actor, at: 2, operation_key: k1, draft: sample_task())
      let conflicting = roadmap_task_create(store: store, actor: actor, at: 3, operation_key: k1, draft: titled(n: sample_task(), headline: "Different"))
      let second = roadmap_task_create(store: store, actor: actor, at: 4, operation_key: k2, draft: titled(n: sample_task(), headline: "Second"))
      let listed = roadmap_tasks_listed(store: store)
      let ok_first = match first { RuntimeTaskCreated { task: _ } => true other => false }
      let ok_replay = match replay { RuntimeTaskReplayed { task: _ } => true other => false }
      let ok_conflict = match conflicting { RuntimeTaskRefused { reason: _ } => true other => false }
      let ok_second = match second { RuntimeTaskCreated { task: _ } => true other => false }
      let ok_listed = match listed { Present { value: ts } => count(ts) == 2 && (first_identity(ts: ts) != second_identity(ts: ts)) Absent => false }
      ok_first && ok_replay && ok_conflict && ok_second && ok_listed
    }
    other => false
  } }
}

fn first_identity(ts: List<RoadmapNode>) -> String { match first(ts) { Present { value: t } => t.identity as String Absent => "" } }
fn second_identity(ts: List<RoadmapNode>) -> String { match first(reverse(ts)) { Present { value: t } => t.identity as String Absent => "" } }
