module test.claim.roadmap_row_witness

import gunbc.roadmap_style { roadmap_css }
import gunbc.roadmap_page { roadmap_page_for_authority }
import gunbc.roadmap_component {
  dispatch_reserved_width, workflow_controls_class,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The taskbar composition's receipts (the 2026-09-21 title-in-bar redesign): the served surfaces
// carry the one recursive component — the bar with its overlay fill, the face with title / signal
// / count / actuator — and the RETIRED composition (the node-head three-track grid, the node-mid
// cell) is gone from the emission. The archetype's grid machinery (RowRegion placements, the
// derived template and head columns) dissolved with it; what survives of the density discipline is
// pinned here: the taskbar blocks carry only var() lengths, and the in-bar actuator keeps the
// row's derived-not-set scale (extent from the row token, width from the caption reservation, no
// fresh literal).

fn expected_taskbar_block() -> String {
  ".taskbar { position: relative; display: flex; align-items: center; min-height: var(--h-taskbar); background: var(--surface); border: var(--border-1) solid var(--border); border-radius: var(--radius-3); overflow: hidden }"
}

fn expected_taskbar_face_block() -> String {
  join([
    ".taskbar-face { position: relative; display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-2) var(--space-8); min-height: var(--h-taskbar); min-width: var(--space-0); flex: 1 }",
  ], "")
}

fn expected_row_actuator_block() -> String {
  join([
    ".taskbar .dispatch-btn { font-size: var(--text-11); min-height: var(--h-row); padding: var(--space-0) var(--space-8); margin-left: var(--space-0); max-width: ",
    dispatch_reserved_width(),
    "; overflow: hidden; white-space: nowrap }",
  ], "")
}

test fn roadmap_row_grid_structure_holds() -> Bool {
  return string_contains(s: roadmap_css(), pattern: expected_taskbar_block())
    && string_contains(s: roadmap_css(), pattern: expected_taskbar_face_block())
    && !string_contains(s: roadmap_css(), pattern: ".node-head")
    && !string_contains(s: roadmap_css(), pattern: "grid-template-columns: auto 1fr auto")
}

test fn roadmap_row_page_carries_the_cells() -> Bool {
  match try_serialize_html_source(node: roadmap_page_for_authority()) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } =>
      h.length() > 0
        && string_contains(s: h, pattern: "class=\"taskbar\"")
        && string_contains(s: h, pattern: "class=\"taskbar-face\"")
        && string_contains(s: h, pattern: "class=\"taskbar-title\"")
        && string_contains(s: h, pattern: join(["class=\"", workflow_controls_class, "\""], ""))
        && string_contains(s: h, pattern: "<li class=\"node node-open\" id=\"node-")
        && string_contains(s: h, pattern: " data-band=\"")
        && !string_contains(s: h, pattern: "class=\"node-head\"")
  }
}

// Derived-not-set, both directions on ONE predicate: the block that ships must be the derived one (verbatim presence), and the derived block itself must draw extent from the row token and width from the caption reservation while carrying no fresh literal (no px, no h-control). The planted RED feeds the same predicate the exact block a well-meaning hand retune would write — the discrimination lives in the predicate, not the fixture.
fn actuator_block_derived(block: String) -> Bool {
  block.length() > 0
    && string_contains(s: block, pattern: "min-height: var(--h-row)")
    && string_contains(s: block, pattern: "max-width: ")
    && !string_contains(s: block, pattern: "h-control")
    && !string_contains(s: block, pattern: "px")
}

test fn roadmap_row_actuator_scale_derived_not_set() -> Bool {
  return string_contains(s: roadmap_css(), pattern: expected_row_actuator_block())
    && actuator_block_derived(block: expected_row_actuator_block())
}

test fn roadmap_row_actuator_red_on_hand_scale() -> Bool {
  let hand_scaled = ".taskbar .dispatch-btn { font-size: var(--text-11); min-height: var(--h-control); padding: 3px 8px }"
  return !actuator_block_derived(block: hand_scaled)
}

// The density cells of this composition's own emission, pinned tokened: the expected blocks carry
// only var() lengths. The module-wide untokened-length census walls the class; this locates the
// row's own blocks.

test fn roadmap_row_density_all_tokened() -> Bool {
  return !string_contains(s: expected_taskbar_block(), pattern: "px")
    && !string_contains(s: expected_taskbar_face_block(), pattern: "px")
    && !string_contains(s: expected_row_actuator_block(), pattern: "px")
}
