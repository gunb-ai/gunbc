// ── the publication receipt ────────────────────────────────────────────────────────────────────────
test fn a_publication_receipt_write_lands_at_the_old_path_under_the_projects_directory() -> Bool {
  let i = fresh_instance(tag: "pub")
  let projects = belt_projects_slots_path(instance: i) as String
  let literal = join([projects, "/proj-a.publication-receipt.json"], "")
  made(path: projects) && match belt_publication_receipt_store(instance: i) {
    BeltPublicationReceiptStoreUnready { detail: _ } => false
    BeltPublicationReceiptStoreReady { store } =>
      match belt_publication_receipt_put(store: store, project_key: "proj-a", content: old_bytes) {
        BeltReceiptWriteRefused { error: _ } => false
        BeltReceiptWritten => raw_reads_as(path: literal, want: old_bytes)
      }
  }
}

test fn the_publication_mint_is_unready_with_the_projects_directory_unlisted_and_ready_with_it_restored() -> Bool {
  let i = fresh_instance(tag: "pub-broken")
  let broken = match belt_publication_receipt_store(instance: i) {
    BeltPublicationReceiptStoreUnready { detail } => string_contains(s: detail, pattern: "could not be listed")
    BeltPublicationReceiptStoreReady { store: _ } => false
  }
  let restored = made(path: belt_projects_slots_path(instance: i) as String) && match belt_publication_receipt_store(instance: i) {
    BeltPublicationReceiptStoreReady { store: _ } => true
    BeltPublicationReceiptStoreUnready { detail: _ } => false
  }
  broken && restored
}

// ── the attempt-scoped stores ──────────────────────────────────────────────────────────────────────
fn member_dir(instance: HostDashboardInstance, member: NonEmptyStr) -> String {
  belt_attempt_member_path(instance: instance, node_id: wit_node as RoadmapNodeId, attempt_key: wit_attempt, member: member)
}

test fn an_old_submission_capture_reads_through_the_store_and_a_write_lands_at_the_old_path() -> Bool {
  let i = fresh_instance(tag: "sub")
  let dir = member_dir(instance: i, member: belt_submission_store_slots.member)
  let literal = join([dir, "/", submission_capture_basename(head_sha: wit_head)], "")
  made(path: dir) && planted(path: literal) && match belt_submission_store(instance: i, node_id: wit_node as RoadmapNodeId, attempt_key: wit_attempt) {
    BeltSubmissionStoreUnready { detail: _ } => false
    BeltSubmissionStoreReady { store } =>
      entry_is(reading: belt_submission_store_observe_head(store: store, head_sha: wit_head), want: old_bytes)
        && match belt_submission_store_put_head(store: store, head_sha: wit_head, content: "{\"next\":3}") {
          BeltReceiptWriteRefused { error: _ } => false
          BeltReceiptWritten => raw_reads_as(path: literal, want: "{\"next\":3}")
        }
  }
}

test fn the_submission_mint_is_unready_with_the_directory_unlisted_and_ready_with_it_restored() -> Bool {
  let i = fresh_instance(tag: "sub-broken")
  let broken = match belt_submission_store(instance: i, node_id: wit_node as RoadmapNodeId, attempt_key: wit_attempt) {
    BeltSubmissionStoreUnready { detail } => string_contains(s: detail, pattern: "could not be listed")
    BeltSubmissionStoreReady { store: _ } => false
  }
  let restored = made(path: member_dir(instance: i, member: belt_submission_store_slots.member)) && match belt_submission_store(instance: i, node_id: wit_node as RoadmapNodeId, attempt_key: wit_attempt) {
    BeltSubmissionStoreReady { store: _ } => true
    BeltSubmissionStoreUnready { detail: _ } => false
  }
  broken && restored
}

