fn witness_cas_generation(n: Int) -> CasGeneration {
  match cas_generation(n: n) {
    Present { value: g } => g
    Absent => cas_generation_first()
  }
}

// G5 WITNESSES (side-chat ruling on #13074 at b4d4a42). Three groups:
//   - the reader's BINDING: a record or release that belongs to another attempt or fence is refused;
//   - the settlement DECISION over a slot, pure;
//   - (the settlement PASS run for real over a temporary store is in
//     test.claim.roadmap.session_placement_wet_witness, on the required floor's local-repo wet lane,
//     because it creates a directory -- an effect the hermetic route has no arm for).
// The inhabitance claim: the bytes the real writer produces (session_placement_record_write) are what
// the real reader and the real settlement read back as this attempt's grant.

// The claims are about WHICH SETTINGS the unit binds; rendering the typed properties back to their
// wire words here is a test observation, not a builder -- nothing hands these words to systemd-run.
fn property_words(props: List<SystemdRunProperty>) -> List<String> {
  props |> map(p => match systemd_run_property_assignment(property: p) {
    SystemdRunPropertyAssignmentReady { assignment: a } => a
    SystemdRunPropertyAssignmentRefused { cause: _ } => ""
  })
}
data node_a: String = "g5-node-a"
data key_a: String = "feedfacefeedface"
data node_b: String = "g5-node-b"
data key_b: String = "0123456789abcdef"
data host: String = "srv2"

fn unit_a() -> String {
  match session_unit_wire(node_id: node_a, attempt_key: key_a) {
    Present { value: u } => u as String
    Absent => ""
  }
}
fn unit_b() -> String {
  match session_unit_wire(node_id: node_b, attempt_key: key_b) {
    Present { value: u } => u as String
    Absent => ""
  }
}

fn grant_for(node_id: String, attempt_key: String, slot: AttemptRecord) -> SessionPlacementGrant {
  SessionPlacementGrant {
    node_id: node_id,
    attempt_key: attempt_key,
    unit: match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
      Present { value: u } => u
      Absent => "unnameable" as NonEmptyStr
    },
    lease: LeaseGrant {
      reference: match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
        Present { value: u } => u
        Absent => "unnameable" as NonEmptyStr
      },
      fence: LeaseFence { grant: "evt-7" as NonEmptyStr as GrantIdentity, generation: witness_cas_generation(n: 7) },
      granted_at: 1000,
      maximum_duration_seconds: 14400,
      expires_at: 15400,
    },
    partition: "session-memory-srv2" as NonEmptyStr as PartitionId,
    amount: kibibyte(count: 8388608),
    class_grant: GrantAtCeiling { class: WorkClassAgentSession, amount: kibibyte(count: 8388608), reason: ClassUnmeasured },
    slot: slot,
    slot_generation: cas_generation_first(),
  }
}

fn slot_a(opened: EpochSecs) -> AttemptRecord {
  session_attempt_record(node_id: node_a, attempt_key: key_a, unit: unit_a() as NonEmptyStr, granted: kibibyte(count: 8388608), now: opened)
}

fn record_bytes(node_id: String, attempt_key: String) -> String {
  serialize_json(v: session_placement_record_json(r: session_placement_record_of(host: host, grant: grant_for(node_id: node_id, attempt_key: attempt_key, slot: slot_a(opened: 1000)), launch_manager: UnitRunOnSystemManager, unit_properties: ["MemoryMax=8589934592", "CPUQuota=800%", "TasksMax=4096"])))
}

fn planted(name: String, content: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/state", success: true, entries: join(["unrelated", name], "\n"), error: ""),
    name: name, path: join(["/state/", name], ""),
    read: filesystem_read_outcome(content: content, success: true, error: ""),
  )
}

fn missing(name: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/state", success: true, entries: "unrelated", error: ""),
    name: name, path: join(["/state/", name], ""),
    read: filesystem_read_outcome(content: "", success: false, error: "ENOENT"),
  )
}

fn held(rec: AttemptRecord) -> AttemptSlotReading { AttemptSlotHeld { record: rec, generation: cas_generation_first() } }

fn release_for(node_id: String, attempt_key: String, grant_identity: String, fence: String) -> String {
  join(["{\"schema\":\"gunbc.session-placement/v1\",\"node_id\":\"", node_id, "\",\"attempt_key\":\"", attempt_key,
    "\",\"reference\":\"", match session_unit_wire(node_id: node_id, attempt_key: attempt_key) {
      Present { value: u } => u as String
      Absent => ""
    },
    "\",\"outcome\":\"released\",\"reason\":\"session unit exited 0\",\"detail\":\"released\",\"grant\":{\"grant_identity\":\"", grant_identity, "\",\"fence_generation\":", fence, "}}"], "")
}

fn observe_a(slot: AttemptSlotReading, record: FilesystemFileObservation, released: FilesystemFileObservation) -> SessionPlacementObservation {
  session_placement_observation_of(
    node_id: node_a, attempt_key: key_a, host: host, slot: slot,
    record_path: "/state/r", record: record, release_path: "/state/x", released: released,
  )
}

fn rec_name() -> String { session_placement_record_basename(node_id: node_a, attempt_key: key_a) }
fn rel_name() -> String { session_placement_release_basename(node_id: node_a, attempt_key: key_a) }

// THE SESSION-MEMORY POOL IS THE INSTANCE'S BELT WIDTH, AND ITS APPROPRIATION FOLLOWS AUTOMATICALLY.
// session_placement_pool sizes the AgentSessionPool from the SAME per-instance figure the belt's launch
// admission carries (HostDashboardInstance.belt_max_concurrent), so srv1-live gets belt_max_concurrent_default
// slots and the srv1 lab gets srv1_lab_belt_max_concurrent. host_capacity_pool_appropriation then reserves
// dispatch_worker_memory_max x slots, so the lab's appropriation is the WIDER pool's -- it follows, it is not
// set separately. A single shared belt constant would make both pools equal slots AND both appropriations
// equal, so every claim here is the RED sensor: a shared constant (or a hand-written pool size) fails it.
test fn the_session_pool_is_the_instance_belt_width_and_the_appropriation_follows() -> Bool {
  let live = srv1_live_dashboard_instance()
  let lab = srv1_lab_dashboard_instance()
  let live_pool = session_placement_pool(instance: live)
  let lab_pool = session_placement_pool(instance: lab)
  let live_slots = nat_to_int(n: host_capacity_pool_slots(pool: live_pool))
  let lab_slots = nat_to_int(n: host_capacity_pool_slots(pool: lab_pool))
  let live_approp = nat_to_int(n: kibibyte_count(k: host_capacity_pool_appropriation(instance: live, pool: live_pool)))
  let lab_approp = nat_to_int(n: kibibyte_count(k: host_capacity_pool_appropriation(instance: lab, pool: lab_pool)))
  // THE DISCRIMINATORS: the lab's pool is strictly wider and the appropriations differ. A shared belt
  // constant -- or a hand-written pool size -- makes both pairs equal and fails here.
  // The slots are compared in Int (the pool's slots are a Nat; the belt figure is a Nat; both cross the
  // total nat_to_int so the equality is a single Int comparison, not an Int-vs-Nat mix).
  live_slots == nat_to_int(n: belt_max_concurrent_default)
    && lab_slots == nat_to_int(n: srv1_lab_belt_max_concurrent)
    && live_slots != lab_slots
    && live_approp != lab_approp
    // THE APPROPRIATION IS EACH INSTANCE'S OWN WORKER CAP TIMES ITS OWN SLOTS, read from the instance's
    // dispatch_worker_memory_max (the authority), not a copied figure: a policy edit moves both sides.
    // Granting against the compute ceiling instead fails for the lab (8 GiB cap vs the 22 GiB ceiling).
    // The old proportional-to-slots premise held only while one field was both ceilings.
    && live_approp == nat_to_int(n: kibibyte_count(k: kibibyte_from_byte_size_floor(b: live.dispatch_worker_memory_max))) * live_slots
    && lab_approp == nat_to_int(n: kibibyte_count(k: kibibyte_from_byte_size_floor(b: lab.dispatch_worker_memory_max))) * lab_slots
}

// POSITIVE CONTROL AND INHABITANCE: the real encoder's record, released against the same grant and
// fence, reads back as Observed with the grant identity, the amount, the properties and the release.
test fn a_bound_placement_reads_back_its_slot_grant_and_release() -> Bool {
  match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_a, attempt_key: key_a)), released: planted(name: rel_name(), content: release_for(node_id: node_a, attempt_key: key_a, grant_identity: "evt-7", fence: "7"))) {
    SessionPlacementObserved { slot: _, grant, returned } =>
      (match grant {
        SessionGrantRecorded { record } => record.grant_identity == "evt-7" && cas_generation_count(g: record.fence_generation) == 7 && kibibyte_count(k: record.amount) == 8388608 && contains(record.unit_properties, "CPUQuota=800%")
        SessionGrantNotRecorded { path: _ } => false
        SessionGrantUnreadable { path: _, detail: _ } => false
        SessionGrantForeign { path: _, detail: _ } => false
      })
        && (match returned {
          SessionReleased { reason, detail: _ } => reason == "session unit exited 0"
          SessionReleaseNotRecorded { path: _ } => false
          SessionReleaseNothingHeld { reason: _, detail: _ } => false
          SessionReleaseRefused { reason: _, detail: _ } => false
          SessionReleaseUnreadable { path: _, detail: _ } => false
        })
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
}

fn release_unreadable_naming(r: SessionReleaseObservation, needle: String) -> Bool {
  match r {
    SessionReleaseUnreadable { path: _, detail } => string_contains(s: detail, pattern: needle)
    SessionReleaseNotRecorded { path: _ } => false
    SessionReleased { reason: _, detail: _ } => false
    SessionReleaseNothingHeld { reason: _, detail: _ } => false
    SessionReleaseRefused { reason: _, detail: _ } => false
  }
}

// DISCRIMINATING RED (finding 3): attempt B's placement record at attempt A's path is FOREIGN; a
// release naming the right reference but a different fence is not this grant's release; no slot is
// Absent.
test fn a_record_or_release_from_another_attempt_or_fence_is_refused() -> Bool {
  let foreign = match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_b, attempt_key: key_b)), released: missing(name: rel_name())) {
    SessionPlacementForeign { unit, detail } => unit == unit_a() && string_contains(s: detail, pattern: node_b)
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
  let wrong_fence = match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_a, attempt_key: key_a)), released: planted(name: rel_name(), content: release_for(node_id: node_a, attempt_key: key_a, grant_identity: "evt-7", fence: "8"))) {
    SessionPlacementObserved { slot: _, grant: _, returned } => release_unreadable_naming(r: returned, needle: "fence")
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
  let no_slot = match observe_a(slot: AttemptSlotAbsent, record: missing(name: rec_name()), released: missing(name: rel_name())) {
    SessionPlacementAbsent { unit } => unit == unit_a()
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
  foreign && wrong_fence && no_slot
}

fn releases(d: SessionSettleDecision) -> Bool {
  match d {
    // A retirement as bookkeeping issues no release -- that is the whole point of it.
    SettleRetireUncharged { record: _, generation: _, attempt: _, returned_at: _, by: _, ledger_generation: _, trigger_reading: _ } => false
    SettleTerminateAndRelease { record: _, generation: _, attempt: _, reason: _ } => true
    SettleReleaseOnly { record: _, attempt: _, reason: _ } => true
    SettleKeep { why: _, explain: _ } => false
    SettleDone { why: _ } => false
  }
}

fn launching(rec: AttemptRecord) -> AttemptRecord {
  AttemptRecord { identity: rec.identity, reference: rec.reference, unit: rec.unit, granted: rec.granted, opened_at: rec.opened_at, launch_deadline: rec.launch_deadline, state: AttemptLaunching, owner: rec.owner }
}

// THE DECISION: Reserved frees only after its declared window, Launching only when the unit has
// ended; an unreadable slot, an unobservable unit, or a slot read under another unit's key is kept.
test fn settlement_releases_only_a_closed_window_or_an_ended_unit() -> Bool {
  let k = unit_a() as NonEmptyStr
  let rec = slot_a(opened: 1000)
  releases(d: session_settle_decide(key: k, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: rec.launch_deadline + 1, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: rec.launch_deadline - 1, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitTerminatedSuccess { detail: "0" }, now: 1001, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitStillRunning { detail: "active" }, now: 99999, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitLifecycleUnknown { detail: "systemctl refused" }, now: 99999, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && !releases(d: session_settle_decide(key: k, slot: AttemptSlotUnreadable { detail: "torn" }, lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: 99999, release_settled: false, charge: SeatChargeNeverAcquired { reference: k }))
    && !releases(d: session_settle_decide(key: unit_b() as NonEmptyStr, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: 99999, release_settled: false, charge: SeatChargeNeverAcquired { reference: unit_b() as NonEmptyStr }))
}

// THE UNIT CARRIES THE GRANT, THROUGH THE SHARED FOLD: MemoryMax is the granted amount (not the
// instance ceiling), with the session's CPU and task bounds; the compute provider's unit, from the
// same fold, carries no process bounds.
test fn the_worker_unit_is_capped_at_its_grant_by_the_compute_fold() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = property_words(props: dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", attempt_worktree: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1024), process_bounds: session_process_bounds, exit_hook: "mkdir -- /i/attempt-exit-spool/inbox/n+k+x" as NonEmptyStr))
  let compute = property_words(props: compute_unit_properties(layout: compute_layout_in(instance: inst, store_root: WitnessScratchRoot { root: "/tmp/gunbc_witness_store" }, identity_hex: "abc"), granted: kibibyte(count: 1024), path_virtualization: NoPathVirtualization))
  contains(props, "MemoryMax=1048576")
    && contains(props, "CPUQuota=800%")
    && contains(props, "TasksMax=4096")
    && contains(props, "KillMode=control-group")
    && count(filter(props, p => starts_with(s: p, prefix: "MemoryMax="))) == 1
    && contains(compute, "MemoryMax=1048576")
    && !any(compute, p => starts_with(s: p, prefix: "CPUQuota="))
}

fn observe_record(content: String) -> SessionPlacementObservation {
  observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: content), released: missing(name: rel_name()))
}

// AN INSTANT IS RE-ADMITTED, NOT CAST (review 74749): a record whose granted_at is negative is not a
// placement with a pre-1970 grant, it is unreadable -- and the same bytes with the instant restored
// read back (positive control on the same record).
test fn a_negative_instant_in_a_placement_record_is_unreadable() -> Bool {
  let good = record_bytes(node_id: node_a, attempt_key: key_a)
  let bad = join(good.split(delimiter: "\"granted_at\": 1000"), "\"granted_at\": -1")
  let refused = match observe_record(content: bad) {
    SessionPlacementObserved { slot: _, grant, returned: _ } => match grant {
      SessionGrantUnreadable { path: _, detail } => string_contains(s: detail, pattern: "not an epoch second")
      SessionGrantRecorded { record: _ } => false
      SessionGrantNotRecorded { path: _ } => false
      SessionGrantForeign { path: _, detail: _ } => false
    }
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
  let accepted = match observe_record(content: good) {
    SessionPlacementObserved { slot: _, grant, returned: _ } => match grant {
      SessionGrantRecorded { record } => record.granted_at == 1000 && record.expires_at == 15400
      SessionGrantUnreadable { path: _, detail: _ } => false
      SessionGrantNotRecorded { path: _ } => false
      SessionGrantForeign { path: _, detail: _ } => false
    }
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
    SessionPlacementUnnameable { detail: _ } => false
  }
  bad != good && refused && accepted
}

fn unit_name_overlong_node() -> String {
  join([
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ], "")
}

fn placement_of_node(node_id: String) -> SessionPlacementObservation {
  session_placement_observation_of(
    node_id: node_id, attempt_key: "k", host: host,
    slot: AttemptSlotAbsent,
    record_path: "/state/r", record: missing("r"),
    release_path: "/state/x", released: missing("x"),
  )
}

test fn an_empty_node_id_is_an_unreadable_session_placement() -> Bool {
  match placement_of_node(node_id: "") {
    SessionPlacementUnnameable { detail } => string_contains(s: detail, pattern: "empty")
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
}

test fn an_overlong_node_id_is_an_unreadable_session_placement() -> Bool {
  match placement_of_node(node_id: unit_name_overlong_node()) {
    SessionPlacementUnnameable { detail } => string_contains(s: detail, pattern: "255")
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
}

test fn an_empty_node_id_is_an_unreadable_worker_unit_observation() -> Bool {
  match attempt_worker_unit_observe_for_instance(
    instance: srv2_deploy_dashboard_instance(),
    node_id: "",
    attempt_key: "k",
  ) {
    AttemptUnitUnreadable { reason } => string_contains(s: reason, pattern: "empty")
    AttemptUnitAbsent => false
    AttemptUnitActive => false
    AttemptUnitFinished { exit_status: _ } => false
  }
}

test fn an_overlong_node_id_is_an_unreadable_worker_unit_observation() -> Bool {
  match attempt_worker_unit_observe_for_instance(
    instance: srv2_deploy_dashboard_instance(),
    node_id: unit_name_overlong_node(),
    attempt_key: "k",
  ) {
    AttemptUnitUnreadable { reason } => string_contains(s: reason, pattern: "255")
    AttemptUnitAbsent => false
    AttemptUnitActive => false
    AttemptUnitFinished { exit_status: _ } => false
  }
}

// == THE RECORDED LAUNCH MANAGER, NOT THE UNIT NAME, ADMITS A HOLDER READING =====================
// (branch review 2026-11-07, mgr ruling msg_2b3b7c0c.) THE DEFECT THESE ROWS KILL: the unit NAME's
// prefix decided whether a not-found reading could be admitted as evidence about a session lease, so a
// lease whose name claimed no launcher -- or claimed a different manager than the one that ran it --
// could neither be admitted nor refused on any fact, and its seat wedged. The prefix now only ROUTES
// the reading; the manager RECORDED on the placement record decides, and a lease that predates the
// receipt is admitted only by value, on the legacy list.
//
// THE CLAIM, ONCE: admissibility is (recorded manager, manager the reading came from, legacy list), and
// every refusal NAMES THE FACT THAT IS MISSING. THE RED SENSORS, ONE PER INTERFACE:
//   - unrecorded and off the list => refused, naming the missing receipt;
//   - a refused holder route answers the lifecycle UNKNOWN, carrying that reason, so the charge stands;
//   - the two listed pre-receipt leases => admitted and LABELLED legacy;
//   - recorded user manager meeting a system-manager reading => refused, naming BOTH managers;
//   - a recorded manager plus a name no launcher claims => still refused: no name grants by itself;
//   - the record's own wire: a present value round-trips, an ABSENT field still parses (the pre-receipt
//     records must stay readable), and a value naming neither manager fails closed.
// PURE CONTROLS: no session store, no systemd manager, no host file. These rows are AUTHORED ONLY --
// CI does not execute the claim witnesses, and no control here reads any srv1 lease.

data unlisted_lease_reference: String = "gunbc-attempt-g5-unlisted-lease.service"
data unclaimed_unit_reference: String = "not-a-unit-any-launcher-claims.service"

fn system_route_reference() -> NonEmptyStr { unlisted_lease_reference as NonEmptyStr }

fn recorded_fact(manager: SessionRecordedLaunchManager) -> SessionLaunchManagerReading {
  LaunchManagerRead { manager: manager }
}

test fn an_unrecorded_lease_off_the_legacy_list_refuses_and_names_the_missing_receipt() -> Bool {
  match session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerUnrecorded),
    route: attempt_unit_route(unit: system_route_reference()),
    reference: system_route_reference(),
  ) {
    ManagerAdmissionRefused { detail } =>
      string_contains(s: detail, pattern: "no launch manager recorded")
        && string_contains(s: detail, pattern: "not on the legacy list")
    ManagerAdmissionGranted { manager: _ } => false
    ManagerAdmissionLegacy { reference: _ } => false
  }
}

// THE CHARGE STANDS ON THE REFUSAL. The refusal reaches the settlement as the UNKNOWN lifecycle -- the
// arm the pass keeps the slot on -- and the unknown carries the admissibility reason. A red here would
// be a release of a lease whose holder was never established, or a seat kept with no stated reason.
test fn the_refused_admission_answers_unknown_and_carries_its_reason() -> Bool {
  let verdict = session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerUnrecorded),
    route: attempt_unit_route(unit: system_route_reference()),
    reference: system_route_reference(),
  )
  match verdict {
    ManagerAdmissionRefused { detail } => match session_absent_unit_lifecycle(evidence: SessionHolderEvidenceRefused { detail: detail }, holder_unit: system_route_reference(), artifact_note: "") {
      UnitLifecycleUnknown { detail: why } =>
        string_contains(s: why, pattern: "holder identity is not established") && string_contains(s: why, pattern: "legacy list")
      UnitTerminatedSuccess => false
      UnitTerminatedCauseUnknown { detail: _ } => false
      UnitStillRunning { detail: _ } => false
    }
    ManagerAdmissionGranted { manager: _ } => false
    ManagerAdmissionLegacy { reference: _ } => false
  }
}

// ADMITTED BY VALUE AND LABELLED. Each listed reference is admitted through the Legacy arm (never
// Granted), and its route is still the one the prefix row states -- routing, not deciding.
fn listed_reference_is_admitted_as_legacy(r: String) -> Bool {
  match session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerUnrecorded),
    route: attempt_unit_route(unit: r as NonEmptyStr),
    reference: r as NonEmptyStr,
  ) {
    // ADMITTED, LABELLED, AND THE ROUTE IS STILL THE ONE THE PREFIX ROW STATES (routing, not deciding).
    ManagerAdmissionLegacy { reference: listed } => (listed as String) == r && match attempt_unit_route(unit: r as NonEmptyStr) {
      Present { value: UnitRunOnSystemManager } => true
      Present { value: UnitRunOnUserManager } => false
      Absent => false
    }
    ManagerAdmissionGranted { manager: _ } => false
    ManagerAdmissionRefused { detail: _ } => false
  }
}

test fn each_lease_listed_as_predating_the_receipt_is_admitted_and_labelled_legacy() -> Bool {
  let admitted = filter(session_legacy_recorded_manager_absent_references, r => listed_reference_is_admitted_as_legacy(r: r))
  length(session_legacy_recorded_manager_absent_references) == 2 && length(admitted) == 2
}

// THE PAIR THE OLD RULE COLLAPSED INTO ONE NAME. The record says the user manager ran it; the reading
// was taken on the system manager. Refused, naming BOTH, because two managers' answers are not one
// holder's death.
test fn a_recorded_user_manager_meeting_a_system_manager_reading_refuses_naming_both() -> Bool {
  match session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerRecorded { manager: UnitRunOnUserManager }),
    route: Present { value: UnitRunOnSystemManager },
    reference: system_route_reference(),
  ) {
    ManagerAdmissionRefused { detail } =>
      string_contains(s: detail, pattern: "user") && string_contains(s: detail, pattern: "system")
        && string_contains(s: detail, pattern: "two managers")
    ManagerAdmissionGranted { manager: _ } => false
    ManagerAdmissionLegacy { reference: _ } => false
  }
}

// THE NAME NO LONGER GRANTS. A recorded system manager admitted against the system manager's own
// reading; the SAME recorded fact against a name no launcher claims is refused -- the prefix cannot
// supply the missing half in either direction.
test fn the_recorded_fact_admits_and_no_name_grants_without_it() -> Bool {
  let granted = match session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerRecorded { manager: UnitRunOnSystemManager }),
    route: attempt_unit_route(unit: system_route_reference()),
    reference: system_route_reference(),
  ) {
    ManagerAdmissionGranted { manager: UnitRunOnSystemManager } => true
    ManagerAdmissionGranted { manager: UnitRunOnUserManager } => false
    ManagerAdmissionLegacy { reference: _ } => false
    ManagerAdmissionRefused { detail: _ } => false
  }
  let unclaimed = match session_launch_manager_admissible(
    reading: recorded_fact(manager: LaunchManagerRecorded { manager: UnitRunOnSystemManager }),
    route: attempt_unit_route(unit: unclaimed_unit_reference as NonEmptyStr),
    reference: unclaimed_unit_reference as NonEmptyStr,
  ) {
    ManagerAdmissionRefused { detail } => string_contains(s: detail, pattern: "no launcher")
    ManagerAdmissionGranted { manager: _ } => false
    ManagerAdmissionLegacy { reference: _ } => false
  }
  granted && unclaimed
}

// A record whose launch manager the caller states, for the wire controls below: the fields are copied
// from the real writer's record so the bytes are the writer's shape, not an invention of this file.
fn record_with_manager(manager: SessionRecordedLaunchManager) -> SessionPlacementRecord {
  let base = session_placement_record_of(host: host, grant: grant_for(node_id: node_a, attempt_key: key_a, slot: slot_a(opened: 1000)), launch_manager: UnitRunOnSystemManager, unit_properties: ["MemoryMax=8589934592"])
  SessionPlacementRecord { schema: base.schema, node_id: base.node_id, attempt_key: base.attempt_key, host: base.host, unit: base.unit, reference: base.reference, grant_identity: base.grant_identity, fence_generation: base.fence_generation, granted_at: base.granted_at, expires_at: base.expires_at, partition: base.partition, amount: base.amount, class_grant: base.class_grant, launch_manager: manager, unit_properties: base.unit_properties }
}

test fn a_record_written_with_its_launch_manager_round_trips_the_fact() -> Bool {
  match session_placement_record_decode(doc: session_placement_record_json(r: record_with_manager(manager: LaunchManagerRecorded { manager: UnitRunOnUserManager }))).record {
    Present { value: r } => match r.launch_manager {
      LaunchManagerRecorded { manager: UnitRunOnUserManager } => true
      LaunchManagerRecorded { manager: UnitRunOnSystemManager } => false
      LaunchManagerUnrecorded => false
    }
    Absent => false
  }
}

// THE PRE-RECEIPT RECORD STAYS READABLE. Bumping the schema string or requiring the field would turn the
// two srv1 leases into UNREADABLE records and keep their seats for the wrong reason, so an absent field
// parses and answers Unrecorded -- which is what sends it to the legacy list rather than to a refusal.
test fn a_record_without_the_launch_manager_field_still_parses_and_answers_unrecorded() -> Bool {
  let acc = session_placement_record_decode(doc: session_placement_record_json(r: record_with_manager(manager: LaunchManagerUnrecorded)))
  match acc.record {
    Present { value: r } => match r.launch_manager {
      LaunchManagerUnrecorded => true
      LaunchManagerRecorded { manager: _ } => false
    }
    Absent => false
  }
}

// A PRESENT VALUE THAT NAMES NEITHER MANAGER FAILS CLOSED, naming the field: half a manager is not the
// system one, and a record that half-names its launcher cannot be admitted on it.
test fn a_launch_manager_naming_no_manager_refuses_the_record_and_names_the_field() -> Bool {
  let text = join([
    "{\"schema\":\"", session_placement_schema, "\",\"node_id\":\"g5-node-a\",\"attempt_key\":\"feedfacefeedface\",\"host\":\"", host, "\",\"unit\":\"gunbc-attempt-n-k\",\"reference\":\"gunbc-attempt-n-k\",\"grant_identity\":\"evt-1\",\"fence_generation\":1,\"granted_at\":1000,\"expires_at\":15400,\"partition\":\"session-memory-srv2\",\"amount_kib\":8388608,\"class_grant\":\"agent-session\",\"launch_manager\":\"banana\",\"unit_properties\":[]}",
  ], "")
  match parse_json_document(s: text) {
    JsonDocumentParsed { value: doc } => {
      let acc = session_placement_record_decode(doc: doc)
      match acc.record {
        Absent => string_contains(s: acc.cause, pattern: "launch_manager")
        Present { value: _ } => false
      }
    }
    JsonDocumentUnreadable { gap: _ } => false
  }
}
