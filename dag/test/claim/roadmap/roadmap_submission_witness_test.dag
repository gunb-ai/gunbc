}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn ready_submission() -> WorkerSubmission {
  WorkerSubmission {
    readiness: SubmissionReady,
    explanation: "implemented the change and ran the acceptance route",
    limitations: "no soak",
  }
}

fn capture_at(head: String, submission: WorkerSubmission) -> SubmissionCapture {
  SubmissionCapture {
    head_sha: head,
    scm_repository: "/instance/attempt-state/projects/n1.gunbc-repository.json",
    scm_commit_ordinal: 3,
    scm_root_locator: SubmissionCaptureRootBound { locator: "0123456789abcdef" },
    digest: submission_digest(submission: submission),
    submission: submission,
  }
}

// ------------------------------------------------------------------------------------------------
// The artifact and the record: codec round trips, the schema wall, digest stability.
// ------------------------------------------------------------------------------------------------

test fn the_submission_codec_round_trips() -> Bool {
  match submission_decode(text: submission_text(submission: ready_submission())) {
    SubmissionNotDecodable { reason: _ } => false
    SubmissionDecoded { submission } =>
      match submission.readiness {
        SubmissionReady =>
          submission.explanation == "implemented the change and ran the acceptance route"
            && submission.limitations == "no soak"
        _ => false
      }
  }
}

test fn the_capture_codec_round_trips_the_scm_binding() -> Bool {
  let c = capture_at(head: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", submission: ready_submission())
  match submission_capture_decode(text: submission_capture_text(capture: c)) {
    CaptureNotDecodable { reason: _ } => false
    CaptureDecoded { capture } =>
      capture.head_sha == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        && capture.scm_repository == "/instance/attempt-state/projects/n1.gunbc-repository.json"
        && capture.scm_commit_ordinal == 3
        && capture.digest == c.digest
        && match capture.scm_root_locator {
          SubmissionCaptureRootBound { locator } => locator == "0123456789abcdef"
          SubmissionCaptureRootLegacyUnbound => false
        }
  }
}

// THE v2 POPULATION STAYS READABLE, AND STAYS HONEST: a capture production wrote before the
// root-locator binding decodes as LegacyUnbound -- never as a bound locator someone might trust --
// and re-encodes under the v2 schema it arrived in, so a legacy record this build touches is not
// silently promoted. The document is hand-authored, like the codec claims' other plants, so the
// claim cannot be moved by an encoder change.
test fn a_v2_capture_record_decodes_as_the_legacy_unbound_arm() -> Bool {
  let text = join([
    "{\"schema\": \"roadmap-submission-capture/v2\",",
    " \"head_sha\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",",
    " \"scm_repository\": \"/r.json\",",
    " \"scm_commit_ordinal\": 3,",
    " \"digest\": \"d\",",
    " \"submission\": {\"schema\": \"roadmap-submission/v1\", \"readiness\": \"ready\", \"explanation\": \"x\", \"limitations\": \"y\"}}",
  ], "")
  match submission_capture_decode(text: text) {
    CaptureNotDecodable { reason: _ } => false
    CaptureDecoded { capture } =>
      match capture.scm_root_locator {
        SubmissionCaptureRootLegacyUnbound => true
        SubmissionCaptureRootBound { locator: _ } => false
      }
        && match submission_capture_decode(text: submission_capture_text(capture: capture)) {
          CaptureNotDecodable { reason: _ } => false
          CaptureDecoded { capture: reencoded } =>
            match reencoded.scm_root_locator {
              SubmissionCaptureRootLegacyUnbound => true
              SubmissionCaptureRootBound { locator: _ } => false
            }
        }
  }
}

// THE v3 SCHEMA REQUIRES THE LOCATOR IT ADDS. A v3 document without the member is not read as a
// legacy capture: the schema is the writer's declaration of what it recorded, and a v3 writer that
// recorded no locator has contradicted its own declaration.
test fn a_v3_capture_record_without_the_locator_is_not_decodable() -> Bool {
  let text = join([
    "{\"schema\": \"roadmap-submission-capture/v3\",",
    " \"head_sha\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",",
    " \"scm_repository\": \"/r.json\",",
    " \"scm_commit_ordinal\": 3,",
    " \"digest\": \"d\",",
    " \"submission\": {\"schema\": \"roadmap-submission/v1\", \"readiness\": \"ready\", \"explanation\": \"x\", \"limitations\": \"y\"}}",
  ], "")
  match submission_capture_decode(text: text) {
    CaptureNotDecodable { reason } => string_contains(s: reason, pattern: "scm_root_locator")
    CaptureDecoded { capture: _ } => false
  }
}

test fn a_document_without_the_schema_is_not_a_submission() -> Bool {
  match submission_decode(text: "{\"readiness\": \"ready\", \"explanation\": \"x\", \"limitations\": \"\"}") {
    SubmissionNotDecodable { reason: _ } => true
    SubmissionDecoded { submission: _ } => false
  }
}

test fn readiness_keys_are_three_and_round_trip() -> Bool {
  submission_readiness_key(r: SubmissionReady) == "ready"
    && submission_readiness_key(r: SubmissionBlocked) == "blocked"
    && submission_readiness_key(r: SubmissionNeedsContext) == "needs-context"
    && match submission_readiness_from_key(key: "needs-context") {
      Present { value: r } =>
        match r {
          SubmissionNeedsContext => true
          _ => false
        }
      Absent => false
    }
    && match submission_readiness_from_key(key: "done") {
      Present { value: _ } => false
      Absent => true
    }
}

// ------------------------------------------------------------------------------------------------
// Rule 2 + rule 7: capture freshness. A re-swept declaration is not a new act.
// ------------------------------------------------------------------------------------------------

test fn a_declaration_byte_identical_to_a_captured_one_is_a_checkpoint_naming_the_bound_head() -> Bool {
  match submission_candidate_decision(
    observation: SubmissionDeclared {
      submission: ready_submission(),
      digest: submission_digest(submission: ready_submission()),
    },
    captures: [capture_at(head: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", submission: ready_submission())],
  ) {
    CandidateFresh { submission: _, digest: _ } => false
    CandidateCheckpoint { note } =>
      match note { _ => note != "" }
        && (capture_at(head: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", submission: ready_submission())).head_sha
           == "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  }
}

test fn a_revised_declaration_after_an_edit_is_a_fresh_candidate() -> Bool {
  let revised = WorkerSubmission {
    readiness: SubmissionReady,
    explanation: "second pass after the verdict",
    limitations: "no soak",
  }
  match submission_candidate_decision(
    observation: SubmissionDeclared { submission: revised, digest: submission_digest(submission: revised) },
    captures: [capture_at(head: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", submission: ready_submission())],
  ) {
    CandidateFresh { submission: _, digest } => digest == submission_digest(submission: revised)
    CandidateCheckpoint { note: _ } => false
  }
}

// ------------------------------------------------------------------------------------------------
// Rule 7, state by state: terminal-without-submission is not ready; pass discharges into the
// obligation; the obligation is truthful with the helper off; a non-ready declaration binds but
// does not advance.
// ------------------------------------------------------------------------------------------------

test fn a_running_worker_has_no_handoff_state() -> Bool {
  match candidate_handoff_state(
    provider: ProviderRunning { activity: "working" },
    capture: CaptureAbsent,
    verification: VerificationOutstanding,
    integration: IntegrationOutstanding,
    publication: PublicationReceiptOwed,
  ) {
    HandoffAwaitingWorker => true
    _ => false
  }
}

test fn terminal_without_a_capture_is_yielded_not_ready() -> Bool {
  match candidate_handoff_state(
    provider: ProviderBudgetSpent { activity: "stopped", detail: "round budget" },
    capture: CaptureAbsent,
    verification: VerificationOutstanding,
    integration: IntegrationOutstanding,
    publication: PublicationReceiptOwed,
  ) {
    HandoffYielded { reason } => reason != ""
    _ => false
  }
}

// The old head's capture and verdict exist; the CURRENT head has no capture, so it is yielded
// no matter what the old head established -- the evidence is preserved, not inherited.
test fn a_later_head_inherits_no_prior_heads_evidence() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureAbsent,
    verification: VerificationPassed,
    integration: IntegrationComplete,
    publication: PublicationReceiptOwed,
  ) {
    HandoffYielded { reason: _ } => true
    _ => false
  }
}

test fn a_capture_awaiting_verification_is_submitted() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationOutstanding,
    integration: IntegrationOutstanding,
    publication: PublicationReceiptOwed,
  ) {
    HandoffSubmitted { head_sha } => head_sha == "cccccccccccccccccccccccccccccccccccccccc"
    _ => false
  }
}

// The state vocabulary has no arm for "waits on a human to ask": pass moves the candidate to
// PublicationOwed directly, and the obligation stands until an observed receipt discharges it.
test fn a_passed_candidate_is_publication_owed_with_no_discretionary_ask() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationComplete,
    publication: PublicationReceiptOwed,
  ) {
    HandoffPublicationOwed { head_sha } => head_sha == "cccccccccccccccccccccccccccccccccccccccc"
    HandoffPublished { head_sha: _, pr_number: _, url: _ } => false
    _ => false
  }
}

test fn a_publication_refusal_is_blocked_on_publication_naming_the_cause() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationComplete,
    publication: PublicationReceiptRefused { cause: "no credential is configured to publish it" },
  ) {
    HandoffBlockedOnPublication { head_sha, cause } =>
      head_sha == "cccccccccccccccccccccccccccccccccccccccc" && cause == "no credential is configured to publish it"
    _ => false
  }
}

test fn an_observed_pr_receipt_discharges_the_obligation() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationComplete,
    publication: PublicationReceiptBound { pr_number: 41, url: "https://example/pr/41" },
  ) {
    HandoffPublished { head_sha, pr_number, url } =>
      head_sha == "cccccccccccccccccccccccccccccccccccccccc" && pr_number == 41 && url == "https://example/pr/41"
    _ => false
  }
}

test fn a_blocked_declaration_binds_but_does_not_advance() -> Bool {
  let blocked = WorkerSubmission {
    readiness: SubmissionNeedsContext,
    explanation: "the acceptance route for this module is undeclared",
    limitations: "",
  }
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "dddddddddddddddddddddddddddddddddddddddd", submission: blocked) },
    verification: VerificationOutstanding,
    integration: IntegrationOutstanding,
    publication: PublicationReceiptOwed,
  ) {
    HandoffDeclaredBlocked { head_sha, readiness, explanation } =>
      head_sha == "dddddddddddddddddddddddddddddddddddddddd"
        && match readiness {
          SubmissionNeedsContext => true
          _ => false
        }
        && explanation == "the acceptance route for this module is undeclared"
    _ => false
  }
}

// ------------------------------------------------------------------------------------------------
// Rule 6: resumption discovers the existing PR rather than duplicating it. The helper observes
// FIRST; an observation that the PR already exists is answered as observed, with no actuation,
// and the credential is never consulted on that arm.
// ------------------------------------------------------------------------------------------------

test fn an_already_bound_publication_is_answered_as_observed_never_re_actuated() -> Bool {
  let observed = PublicationBound {
    branch: "dispatch-n1-aabc" as NonEmptyStr,
    pr_number: 41,
    pr_head: "cccccccccccccccccccccccccccccccccccccccc" as CommitSha,
    url: "https://example/pr/41" as NonEmptyStr,
    draft: false,
  }
  match publication_helper_publish_if_unpublished(
    credential: CredentialSourceAbsent { reason: "no token" },
    subject: gunbc.roadmap_publish.RoadmapPublicationSubject {
      node_id: "n1",
      attempt_key: "abc",
      repository: gunbc_repository,
      branch: "dispatch-n1-aabc" as NonEmptyStr,
      expected_base: "main" as NonEmptyStr,
      expected_head: "cccccccccccccccccccccccccccccccccccccccc" as CommitSha,
    },
    worktree: "/wt",
    observed: observed,
  ) {
    PublicationBound { branch: _, pr_number, pr_head: _, url: _, draft: _ } => pr_number == 41
    _ => false
  }
}

// ------------------------------------------------------------------------------------------------
// The bridge parse: NUL rows verbatim, the trailing row dropped.
// ------------------------------------------------------------------------------------------------

test fn the_inventory_parse_splits_nul_rows_and_drops_the_trailer() -> Bool {
  let paths = worktree_inventory_parse(stdout_nul: "dag/a.dag\0dag/b.dag\0")
  count(paths) == 2
    && fold(paths, init: true, f: fn(ok, p) {
      ok && ((p as String) == "dag/a.dag" || (p as String) == "dag/b.dag")
    })
}

// ------------------------------------------------------------------------------------------------
// Rule 7, fanin: two candidates of one project produce ONE integration head carrying both sides;
// a conflicting pair yields the typed conflict population and mints nothing.
// ------------------------------------------------------------------------------------------------

type FaninScene
  = FaninScene { build: MbBuild, base: RepositoryCommitRef, first: RepositoryCommitRef, second: RepositoryCommitRef }
  | FaninSceneUnavailable

//   B    a = A0                        the project's base
//   C1   a = A0, one = ONE  parent B   the first candidate
//   C2   a = A0, two = TWO  parent B   the second candidate -- a disjoint path, so the batch merges
fn fanin_scene() -> FaninScene {
  let b = mb_commit(build: mb_stage(build: mb_start(), path: "a", text: "A0"), message: "base")
  match mb_head(build: b) {
    Absent => FaninSceneUnavailable
    Present { value: base } =>
      let c1 = mb_commit(build: mb_stage(build: b, path: "one", text: "ONE"), message: "candidate one")
      match mb_head(build: c1) {
        Absent => FaninSceneUnavailable
        Present { value: first } =>
          let c2 = mb_commit(build: mb_stage(build: mb_at(build: c1, target: base), path: "two", text: "TWO"), message: "candidate two")
          match mb_head(build: c2) {
            Absent => FaninSceneUnavailable
            Present { value: second } =>
              FaninScene { build: c2, base: base, first: first, second: second }
          }
      }
  }
}

fn fanin_scene_repository(s: FaninScene) -> RepositoryEnvelope? {
  match s {
    FaninSceneUnavailable => none
    FaninScene { build: b, base: _, first: _, second: _ } =>
      match b {
        MbSetupFailed => none
        MbBuilt { repository: r, at: _ } => Present { value: r }
      }
  }
}

fn fanin_conflict_scene() -> FaninScene {
  let b = mb_commit(build: mb_stage(build: mb_start(), path: "a", text: "A0"), message: "base")
  match mb_head(build: b) {
    Absent => FaninSceneUnavailable
    Present { value: base } =>
      let c1 = mb_commit(build: mb_stage(build: b, path: "a", text: "A1"), message: "candidate one")
      match mb_head(build: c1) {
        Absent => FaninSceneUnavailable
        Present { value: first } =>
          let c2 = mb_commit(build: mb_stage(build: mb_at(build: c1, target: base), path: "a", text: "A2"), message: "candidate two")
          match mb_head(build: c2) {
            Absent => FaninSceneUnavailable
            Present { value: second } =>
              FaninScene { build: c2, base: base, first: first, second: second }
          }
      }
  }
}

fn holds_path(paths: List<String>, path: String) -> Bool {
  fold(paths, init: false, f: fn(found, p) { found || p == path })
}

fn paths_at(repository: RepositoryEnvelope, at: RepositoryCommitRef) -> List<String> {
  match commit_at_reference(commits: repository.commits, reference: at) {
    Absent => []
    Present { value: c } =>
      match staged_entries(
        repository: RepositoryEnvelope {
          store: repository.store,
          commits: repository.commits,
          commit_allocator: repository.commit_allocator,
          checked_out: repository.checked_out,
          staged: Present { value: c.root },
        }
      ) {
        StagedEntriesRefused { cause: _ } => []
        StagedEntries { entries } => map(entries, e => e.path as String)
      }
  }
}

test fn two_candidates_fan_in_to_one_integration_head_carrying_both() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base, first, second } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          match fanin_integrate_candidate(repository: repo, integration_head: base, candidate: first, message: "integrate one") {
            FaninConflicted { conflicts: _ } => false
            FaninRefused { detail: _ } => false
            FaninAlreadyIntegrated { head: _ } => false
            FaninIntegrated { repository: repo1, head: h1 } =>
              match fanin_integrate_candidate(repository: repo1, integration_head: h1, candidate: second, message: "integrate two") {
                FaninConflicted { conflicts: _ } => false
                FaninRefused { detail: _ } => false
                FaninAlreadyIntegrated { head: _ } => false
                FaninIntegrated { repository: repo2, head: h2 } => {
                  let paths = paths_at(repository: repo2, at: h2)
                  holds_path(paths: paths, path: "a")
                    && holds_path(paths: paths, path: "one")
                    && holds_path(paths: paths, path: "two")
                }
              }
          }
      }
  }
}

test fn a_conflicting_pair_yields_the_typed_conflict_and_mints_no_head() -> Bool {
  match fanin_conflict_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base, first, second } =>
      match fanin_scene_repository(s: fanin_conflict_scene()) {
        Absent => false
        Present { value: repo } =>
          match fanin_integrate_candidate(repository: repo, integration_head: base, candidate: first, message: "integrate one") {
            FaninConflicted { conflicts: _ } => false
            FaninRefused { detail: _ } => false
            FaninAlreadyIntegrated { head: _ } => false
            FaninIntegrated { repository: repo1, head: h1 } => {
              let commits_before = count(repo1.commits)
              match fanin_integrate_candidate(repository: repo1, integration_head: h1, candidate: second, message: "integrate two") {
                FaninIntegrated { repository: _, head: _ } => false
                FaninRefused { detail: _ } => false
                FaninAlreadyIntegrated { head: _ } => false
                FaninConflicted { conflicts } =>
                  count(conflicts) == 1
                    && (conflicts |> map(c => c.path as String)) == ["a"]
                    && count(repo1.commits) == commits_before
              }
            }
          }
      }
  }
}

// ------------------------------------------------------------------------------------------------
// Integration states of the handoff fold.
// ------------------------------------------------------------------------------------------------

test fn a_verified_candidate_awaits_integration_before_publication_is_owed() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationOutstanding,
    publication: PublicationReceiptOwed,
  ) {
    HandoffAwaitingIntegration { head_sha } => head_sha == "cccccccccccccccccccccccccccccccccccccccc"
    HandoffPublicationOwed { head_sha: _ } => false
    _ => false
  }
}

test fn an_integration_conflict_is_blocked_on_integration_naming_the_population() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationBlockedStanding { cause: "1 conflicting path(s): dag/a.dag" },
    publication: PublicationReceiptOwed,
  ) {
    HandoffBlockedOnIntegration { head_sha, cause } =>
      head_sha == "cccccccccccccccccccccccccccccccccccccccc" && cause == "1 conflicting path(s): dag/a.dag"
    _ => false
  }
}

test fn an_integrated_candidate_is_publication_owed() -> Bool {
  match candidate_handoff_state(
    provider: ProviderCompleted { activity: "done" },
    capture: CaptureForHead { capture: capture_at(head: "cccccccccccccccccccccccccccccccccccccccc", submission: ready_submission()) },
    verification: VerificationPassed,
    integration: IntegrationComplete,
    publication: PublicationReceiptOwed,
  ) {
    HandoffPublicationOwed { head_sha } => head_sha == "cccccccccccccccccccccccccccccccccccccccc"
    _ => false
  }
}

test fn the_integration_receipt_codec_round_trips_both_states() -> Bool {
  let integrated = IntegrationReceipt {
    head_sha: "hhhh", project: "arc", scm_commit_ordinal: 7, state: IntegrationIntegrated,
  }
  let blocked = IntegrationReceipt {
    head_sha: "hhhh", project: "arc", scm_commit_ordinal: 7,
    state: IntegrationBlocked { detail: "1 conflicting path(s): dag/a.dag" },
  }
  match integration_receipt_decode(text: integration_receipt_text(receipt: integrated)) {
    IntegrationReceiptNotDecodable { reason: _ } => false
    IntegrationReceiptDecoded { receipt: r1 } =>
      match r1.state {
        IntegrationIntegrated =>
          match integration_receipt_decode(text: integration_receipt_text(receipt: blocked)) {
            IntegrationReceiptNotDecodable { reason: _ } => false
            IntegrationReceiptDecoded { receipt: r2 } =>
              match r2.state {
                IntegrationBlocked { detail } =>
                  detail == "1 conflicting path(s): dag/a.dag"
                    && r2.scm_commit_ordinal == 7
                    && r2.project == "arc"
                IntegrationIntegrated => false
              }
          }
        _ => false
      }
  }
}

// ------------------------------------------------------------------------------------------------
// Membership derivation (owner ruling: derived from the dependency edges, never rostered).
// ------------------------------------------------------------------------------------------------

fn batch_edges() -> List<RoadmapEdge> {
  [
    RoadmapEdge { child: "shell-arc" as RoadmapNodeId, parent: "task-one" as RoadmapNodeId },
    RoadmapEdge { child: "shell-arc" as RoadmapNodeId, parent: "task-two" as RoadmapNodeId },
  ]
}

test fn a_node_the_arc_depends_on_is_a_member_keyed_by_the_arc() -> Bool {
  match node_project_membership(node_id: "task-one", edges: batch_edges()) {
    MembershipMember { arc } => arc == "shell-arc"
    _ => false
  }
    && match project_key_for_node(node_id: "task-one", edges: batch_edges()) {
      Present { value: key } => key == "shell-arc"
      Absent => false
    }
}

test fn a_node_with_no_dependent_arc_is_a_project_of_one_keyed_by_itself() -> Bool {
  match node_project_membership(node_id: "shell-arc", edges: batch_edges()) {
    MembershipStandalone => true
    _ => false
  }
    && match project_key_for_node(node_id: "shell-arc", edges: batch_edges()) {
      Present { value: key } => key == "shell-arc"
      Absent => false
    }
}

test fn two_arcs_over_one_node_is_a_typed_ambiguity_not_a_default() -> Bool {
  let edges = concat(batch_edges(), [
    RoadmapEdge { child: "other-arc" as RoadmapNodeId, parent: "task-one" as RoadmapNodeId },
  ])
  match node_project_membership(node_id: "task-one", edges: edges) {
    MembershipAmbiguous { arcs } => count(arcs) == 2
    _ => false
  }
    && match project_key_for_node(node_id: "task-one", edges: edges) {
      Present { value: _ } => false
      Absent => true
    }
}

test fn the_project_membership_is_the_arcs_parents_in_declared_order() -> Bool {
  let members = project_member_ids(arc: "shell-arc", edges: batch_edges())
  count(members) == 2
    && fold(members, init: true, f: fn(ok, m) {
      ok && (m == "task-one" || m == "task-two")
    })
}

// ------------------------------------------------------------------------------------------------
// Fanin, continued: re-integration is the restart-safe no-op, and the base finder names the one
// root a candidate must descend from.
// ------------------------------------------------------------------------------------------------

test fn re_integrating_a_consumed_candidate_is_a_typed_noop_not_a_second_merge() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base, first, second: _ } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          match fanin_integrate_candidate(repository: repo, integration_head: base, candidate: first, message: "integrate one") {
            FaninConflicted { conflicts: _ } => false
            FaninRefused { detail: _ } => false
            FaninAlreadyIntegrated { head: _ } => false
            FaninIntegrated { repository: repo1, head: h1 } => {
              let commits_before = count(repo1.commits)
              match fanin_integrate_candidate(repository: repo1, integration_head: h1, candidate: first, message: "integrate one again") {
                FaninIntegrated { repository: _, head: _ } => false
                FaninConflicted { conflicts: _ } => false
                FaninRefused { detail: _ } => false
                FaninAlreadyIntegrated { head } =>
                  count(repo1.commits) == commits_before
                    && repository_commit_ref_eq(left: head, right: h1)
              }
            }
          }
      }
  }
}

// ------------------------------------------------------------------------------------------------
// The capture->integrate binding, authenticated (the 2026-09-22 diagnosis's second hole). The
// ordinal alone is not an identity -- ordinal 1 is this envelope's first commit and a stranger
// envelope's first commit with equal confidence -- so the capture records the commit root's
// content locator at capture time and the integrate verifies commits[ordinal].root against it
// before fanin. These claims drive the real gate over the real scene builders.
// ------------------------------------------------------------------------------------------------

fn capture_with_root(ordinal: Int, root: SubmissionCaptureRoot) -> SubmissionCapture {
  SubmissionCapture {
    head_sha: "cccccccccccccccccccccccccccccccccccccccc",
    scm_repository: "/instance/attempt-state/projects/n1.gunbc-repository.json",
    scm_commit_ordinal: ordinal,
    scm_root_locator: root,
    digest: submission_digest(submission: ready_submission()),
    submission: ready_submission(),
  }
}

fn root_locator_of(commits: List<RepositoryCommit>, at: RepositoryCommitRef) -> String {
  match commit_at_reference(commits: commits, reference: at) {
    Absent => ""
    Present { value: c } => c.root.locator.digest as String
  }
}

// THE HONEST CAPTURE: the recorded locator IS commits[ordinal].root, so the gate has no refusal
// and the candidate integrates -- the arm the whole binding exists to keep reachable.
test fn an_honest_capture_binding_integrates() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base, first, second: _ } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          let capture = capture_with_root(
            ordinal: minted_id_ordinal(id: first.identity),
            root: SubmissionCaptureRootBound { locator: root_locator_of(commits: repo.commits, at: first) },
          )
          match submission_capture_binding_refusal(capture: capture, commits: repo.commits) {
            Present { value: _ } => false
            Absent =>
              match fanin_integrate_candidate(repository: repo, integration_head: base, candidate: first, message: "integrate one") {
                FaninIntegrated { repository: _, head: _ } => true
                FaninConflicted { conflicts: _ } => false
                FaninAlreadyIntegrated { head: _ } => false
                FaninRefused { detail: _ } => false
              }
          }
      }
  }
}

// THE DISCRIMINATING ONE: the submission and the envelope are untouched -- only the recorded
// locator is altered, to the root of a DIFFERENT commit of the same envelope. That is exactly the
// cross-envelope ordinal-resolution hazard in miniature, and the gate refuses typed, carrying both
// the claimed locator and the locator the ordinal actually resolves to.
test fn an_altered_locator_refuses_with_both_sides_named() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base: _, first, second } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          let capture = capture_with_root(
            ordinal: minted_id_ordinal(id: first.identity),
            root: SubmissionCaptureRootBound { locator: root_locator_of(commits: repo.commits, at: second) },
          )
          match submission_capture_binding_refusal(capture: capture, commits: repo.commits) {
            Present { value: CaptureBindingMismatch { claimed, actual } } =>
              claimed == root_locator_of(commits: repo.commits, at: second)
                && actual == root_locator_of(commits: repo.commits, at: first)
            Present { value: CaptureBindingUnverifiable } => false
            Absent => false
          }
      }
  }
}

// CHANGED CONTENT UNDER AN OLD LOCATOR is the same refusal from the other direction: a capture
// whose ordinal now resolves to a commit freezing different content than the recorded locator
// refuses rather than integrating the stranger. (The ordinal is stable per envelope, so this is
// the replaced-envelope shape of the hazard.)
test fn a_changed_commit_under_an_old_locator_refuses_with_both_sides_named() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base: _, first, second } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          let capture = capture_with_root(
            ordinal: minted_id_ordinal(id: second.identity),
            root: SubmissionCaptureRootBound { locator: root_locator_of(commits: repo.commits, at: first) },
          )
          match submission_capture_binding_refusal(capture: capture, commits: repo.commits) {
            Present { value: CaptureBindingMismatch { claimed, actual } } =>
              claimed == root_locator_of(commits: repo.commits, at: first)
                && actual == root_locator_of(commits: repo.commits, at: second)
            Present { value: CaptureBindingUnverifiable } => false
            Absent => false
          }
      }
  }
}

// THE LEGACY ARM: a v2 capture recorded no locator, and the gate refuses with the named cause
// rather than guessing -- an unauthenticated capture is not integrated on the strength of its
// ordinal alone.
test fn a_legacy_capture_refuses_as_binding_unverifiable() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base: _, first, second: _ } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          let capture = capture_with_root(
            ordinal: minted_id_ordinal(id: first.identity),
            root: SubmissionCaptureRootLegacyUnbound,
          )
          match submission_capture_binding_refusal(capture: capture, commits: repo.commits) {
            Present { value: CaptureBindingUnverifiable } => true
            Present { value: CaptureBindingMismatch { claimed: _, actual: _ } } => false
            Absent => false
          }
      }
  }
}

// THE GATE'S SUBJECT IS THE ORDINAL'S RESOLUTION, and an ordinal the envelope does not carry has
// no resolution to authenticate: the gate passes it through, and the integrate's own admissions
// refuse the missing candidate typed -- the pass-through is deliberate, so that refusal keeps the
// vocabulary that owns it (the merge base's unwalkable arm) rather than a binding-shaped fiction.
test fn a_capture_for_a_commit_the_envelope_lacks_passes_through_to_the_integrate() -> Bool {
  match fanin_scene() {
    FaninSceneUnavailable => false
    FaninScene { build: _, base: _, first: _, second: _ } =>
      match fanin_scene_repository(s: fanin_scene()) {
        Absent => false
        Present { value: repo } =>
          let capture = capture_with_root(
            ordinal: 999,
            root: SubmissionCaptureRootBound { locator: "ffffffffffffffff" },
          )
          match submission_capture_binding_refusal(capture: capture, commits: repo.commits) {
            Present { value: _ } => false
            Absent => true
          }
      }
  }
}
