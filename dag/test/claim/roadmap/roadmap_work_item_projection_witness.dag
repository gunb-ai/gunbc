module test.claim.roadmap.roadmap_work_item_projection_witness

// EXECUTING WITNESS for the work-item projection (gunbc.roadmap.roadmap_work_item_projection): the served
// document /projection.json, one row per work item, the shape the ctrl Roadmap Timeline and the gunbc
// planning page read. It runs on the document builder and the log's own answers only -- the standing fold,
// the binding carrier, the event log -- the same graph the standings document test runs on, so it resolves
// and runs under --claim-run. What it proves by RUNNING:
//
//   THE FIRST SLICE -- one item with leaves in flight, then the SAME item after a planted release, both
//           rows against the declared shape field for field (node, intention, layer, item_state, leaves
//           with on_critical_path, in_flight with assignee and return_to, latest_event, acceptance_evidence,
//           events with recorded_at, read_on and the inputs the read used).
//   DERIVED, NOT STORED -- the in-flight leaves come from the log's derived set spelled to the wire, never
//           a list this row keeps; the events are the log's own rows filtered to the item at this read, so
//           another item's events do not ride into this row.
//   A REFUSAL, NOT A GAP -- a planted binding of a row to an intention that does not exist refuses at load,
//           and the whole document refuses rather than serve a row missing a declared field.

import std.types { String, Bool, Int, List, NonEmptyStr }
import std.optional { Optional }
import std.algebra { string_contains }
import std.decl_ref { decl_ref }
import extdeps.languages.json.emit { serialize_json }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import gunbc.roadmap.roadmap_decomposition { Declared }
import gunbc.roadmap.roadmap_schedule_calendar { DatedLeaf }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, LeafPath }
import gunbc.roadmap.roadmap_authority { nid }
import std.checked_arithmetic { checked_int_to_nat }
import gunbc.roadmap.roadmap_belt { BeltCapacity }
import gunbc.roadmap.roadmap_event_log {
  RoadmapEvent, RoadmapEventKind, RoadmapEventEnvelope, RoadmapEventId, RoadmapStandings, StandingsObserved,
  LeafInFlightEntry, Claimed, Released, EventPrincipal, LegacyEmailPrincipal, EventPrincipalAuthenticated, ClaimGrain, AtPath,
  roadmap_event_envelope, roadmap_event_id, roadmap_leaf_in_flight_from_envs, LeafInFlightRead, InFlightLeaves, InFlightRefused,
}
import gunbc.principal_projection { PrincipalRef }
import gunbc.roadmap.roadmap_intention_binding { IntentionBinding }
import gunbc.roadmap.roadmap_work_item_projection {
  ProjectionLeaf, ProjectionInFlight, ProjectionEvent, ProjectionInputs, ProjectionRow, ProjectionRefusal,
  ProjectionRowResult, ProjectionRowBuilt, ProjectionRowRefused, RowScheduleRefused, InFlightUnordered,
  projection_build_row, projection_in_flight_entries, projection_leaf_from_dated, projection_leaves_for_item,
  roadmap_work_item_projection_document_json, projection_row_json,
  roadmap_projection_row_read, roadmap_projection_document_for_read, projection_refusal_step,
}
import gunbc.roadmap.roadmap_served_observation {
  ProjectionJson, ServedObservationKindDecoded, served_observation_kind_url_path,
  served_observation_kind_key, served_observation_kind_of_key,
}

// ---- fixtures ----

fn principal(email: String) -> EventPrincipal {
  LegacyEmailPrincipal { email: email as NonEmptyStr, authentication_unestablished: true }
}

// An AUTHENTICATED principal -- the v3 wire form the producers actually write, whose label round-trips through
// roadmap_event_decode (the from-now read spells every claimed line to the wire and reads it back; a bare legacy
// email is not a v3 principal: label and the WHOLE line is refused as unreadable). The subject is the only thing
// that varies, so the assignee/return_to the row shows is the claim's own and recognizable.
fn auth(subject: String) -> EventPrincipal {
  EventPrincipalAuthenticated {
    ref: PrincipalRef {
      authority: "google-oidc" as NonEmptyStr,
      namespace: "accounts" as NonEmptyStr,
      subject: subject as NonEmptyStr,
    }
  }
}

fn envelope(node: String, kind: RoadmapEventKind, at: String) -> RoadmapEventEnvelope {
  roadmap_event_envelope(e: RoadmapEvent {
    node: nid(s: node), author: principal("system@roadmap"), parent: Absent, kind: kind, recorded_at: at,
  })
}

// A PARENT-LINKED claim then release for one leaf of one item, built the way the real log links them (the
// release names the claim's own computed id as its parent) so they form a single causal chain -- the shape
// the in-flight fold and the causal ordering both require. The caller derives the set through the PRODUCTION
// fold (roadmap_leaf_in_flight_from_envs), never hand-supplies it.
fn claim_event(node: String, at: String) -> RoadmapEvent {
  RoadmapEvent {
    node: nid(s: node), author: auth("alice"), parent: Absent, recorded_at: at,
    kind: Claimed {
      assignee: auth("alice"), return_to: auth("bob"),
      grain: AtPath { path: LeafPath { item: nid(s: node), stage: 0, piece: 0, member: 0 } },
    },
  }
}

fn release_event(linked_to: RoadmapEvent, at: String) -> RoadmapEvent {
  RoadmapEvent {
    node: linked_to.node, author: auth("alice"), parent: Present { value: roadmap_event_id(e: linked_to) },
    recorded_at: at, kind: Released,
  }
}

// How many leaves the PRODUCTION fold reports as in flight for an item over these envelopes -- 0 is the
// derived "nothing held," never a hand-written empty list.
fn derived_in_flight_count(node: String, envs: List<RoadmapEventEnvelope>) -> Int {
  match roadmap_leaf_in_flight_from_envs(node: nid(s: node), envs: envs) {
    InFlightLeaves { leaves: entries, closed: _, pathless_claims: _, absorbed_claims: _ } => count(entries)
    InFlightRefused { cause: _ } => -1
  }
}

fn claimed(node: String) -> RoadmapEventKind {
  Claimed {
    assignee: principal("alice@roadmap"), return_to: principal("bob@roadmap"),
    grain: AtPath { path: LeafPath { item: nid(s: node), stage: 0, piece: 0, member: 0 } },
  }
}

fn bound_node(node: String) -> IntentionBinding {
  IntentionBinding {
    node: nid(s: node),
    intention: decl_ref(module_path: "gunbc.plans.planning_consolidation", decl_name: "planning_consolidation_plan"),
    layer: 2,
  }
}

fn open_standings() -> RoadmapStandings { StandingsObserved { rows: [] } }

fn read_inputs() -> ProjectionInputs {
  ProjectionInputs { worker_count: 1, day_priors: [2, 3], assumed_findings_counts: [0] }
}

fn doc_of(rows: List<ProjectionRow>) -> String {
  serialize_json(v: roadmap_work_item_projection_document_json(
    rows: rows, refused: [] as List<ProjectionRefusal>, read_on: "2026-11-24", inputs: read_inputs()))
}

// The FIRST row: an item with two leaves, one in flight (read off the log's derived set), claimed in the
// log. Every declared field must be on the served document, and the in-flight assignee and return_to must
// be the claim's own. And the two cross-item guards hold: item-b's derived entry and item-b's event never
// ride into item-a's row.
test fn first_slice_item_with_leaves_in_flight_shows_every_declared_field() -> Bool {
  let derived = [
    LeafInFlightEntry {
      leaf: LeafPath { item: nid(s: "item-a"), stage: 0, piece: 0, member: 0 }, claim: "e-claim-1" as RoadmapEventId,
      assignee: principal("alice@roadmap"), return_to: principal("bob@roadmap"), since: "2026-11-01",
    },
    LeafInFlightEntry {
      leaf: LeafPath { item: nid(s: "item-b"), stage: 0, piece: 0, member: 0 }, claim: "e-claim-2" as RoadmapEventId,
      assignee: principal("carol@roadmap"), return_to: principal("dan@roadmap"), since: "2026-11-01",
    },
  ]
  let envs = [ envelope("item-a", claimed("item-a"), "2026-11-01"), envelope("item-b", claimed("item-b"), "2099-01-01") ]
  let leaves = [
    ProjectionLeaf { path: "item-a#0#0#0", start_day: "2026-11-02", finish_day: "2026-11-04", on_critical_path: true },
    ProjectionLeaf { path: "item-a#1#0#0", start_day: "2026-11-05", finish_day: "2026-11-09", on_critical_path: false },
  ]
  match projection_build_row(
    node: "item-a", bindings: [bound_node("item-a")], standings: open_standings(),
    leaves: leaves, in_flight: projection_in_flight_entries(entries: derived, item: "item-a"), envs: envs,
    day_priors: [] as List<Int>,
  ) {
    ProjectionRowBuilt { row: r, day_priors: _ } =>
      let d = doc_of([r])
      string_contains(s: d, pattern: "\"node\"")
      && string_contains(s: d, pattern: "item-a")
      && string_contains(s: d, pattern: "\"intention\"")
      && string_contains(s: d, pattern: "planning_consolidation")
      && string_contains(s: d, pattern: "\"layer\"")
      && string_contains(s: d, pattern: "\"item_state\"")
      && string_contains(s: d, pattern: "open")
      && string_contains(s: d, pattern: "item-a#0#0#0")
      && string_contains(s: d, pattern: "item-a#1#0#0")
      && string_contains(s: d, pattern: "\"on_critical_path\"")
      && string_contains(s: d, pattern: "\"start_day\"")
      && string_contains(s: d, pattern: "\"finish_day\"")
      && string_contains(s: d, pattern: "\"in_flight\"")
      && string_contains(s: d, pattern: "\"assignee\"")
      && string_contains(s: d, pattern: "\"return_to\"")
      && string_contains(s: d, pattern: "alice@roadmap")
      && string_contains(s: d, pattern: "bob@roadmap")
      && string_contains(s: d, pattern: "\"latest_event\"")
      && string_contains(s: d, pattern: "claimed")
      && string_contains(s: d, pattern: "\"acceptance_evidence\"")
      && string_contains(s: d, pattern: "\"events\"")
      && string_contains(s: d, pattern: "2026-11-01")
      && string_contains(s: d, pattern: "\"read_on\"")
      && string_contains(s: d, pattern: "2026-11-24")
      && string_contains(s: d, pattern: "\"worker_count\"")
      && string_contains(s: d, pattern: "\"day_priors\"")
      && string_contains(s: d, pattern: "\"assumed_findings_counts\"")
      && string_contains(s: d, pattern: "\"rows\"")
      && !string_contains(s: d, pattern: "carol@roadmap")
      && !string_contains(s: d, pattern: "2099-01-01")
    ProjectionRowRefused { refusal: _ } => false
  }
}

// THE IN-FLIGHT SET AND THE LATEST EVENT ARE DERIVED THROUGH THE PRODUCTION READER, not hand-supplied
// (manager ruling 2026-11-24): the SAME item read BEFORE a parent-linked release has its claimed leaf held
// and "claimed" latest; read AFTER, the in-flight fold reports NOTHING held (derived off the log, never typed
// in) and "released" is latest, with both events on the row. The empty in_flight is the fold's, so a reader
// cannot tell it from an item nobody ever claimed except by the events -- which is exactly the point: the
// claim and release are both on the row.
test fn in_flight_and_latest_are_derived_through_the_production_reader_across_a_release() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } => {
      // A REAL bound+decomposed item (in roadmap_intention_bindings AND roadmap_decompositions), claimed on
      // its own stage-0 leaf -- the same day-two control roadmap_schedule_from_now uses: the 5-day leaf is
      // claimed Tue 2026-11-17, three working days before the Fri 2026-11-20 read, so the from-now schedule
      // pins it with two working days of prior REMAINING rather than redrawing five. The claim and release
      // carry full ISO instants (the shape the producers write); a bare date would not be admitted.
      let c = claim_event("namespace-reference-derived-closure", "2026-11-17T09:00:00Z")
      let c_env = roadmap_event_envelope(e: c)
      let r = release_event(linked_to: c, at: "2026-11-18T09:00:00Z")
      let r_env = roadmap_event_envelope(e: r)
      match roadmap_projection_row_read(
        node: nid(s: "namespace-reference-derived-closure"), read_date: Iso8601CivilDate { year: 2026, month: 11, day: 20 },
        workers: BeltCapacity { max_concurrent: 4 }, findings_count: findings,
        standings: open_standings(), envs: [c_env]) {
        ProjectionRowBuilt { row: b, day_priors: _ } =>
          match roadmap_projection_row_read(
            node: nid(s: "namespace-reference-derived-closure"), read_date: Iso8601CivilDate { year: 2026, month: 11, day: 20 },
            workers: BeltCapacity { max_concurrent: 4 }, findings_count: findings,
            standings: open_standings(), envs: [c_env, r_env]) {
            // BEFORE: one leaf held, its assignee the claim's own, and "claimed" latest.
            ProjectionRowBuilt { row: a, day_priors: _ } =>
              count(b.in_flight) == 1
              && match b.in_flight.first() { Present { value: h } => h.assignee == "principal:google-oidc/accounts/alice" Absent => false }
              && match b.latest_event { Present { value: w } => w == "claimed" Absent => false }
              // AFTER: nothing held (the fold derived the release), "released" latest, both events on the row.
              && count(a.in_flight) == 0
              && match a.latest_event { Present { value: w } => w == "released" Absent => false }
              && string_contains(s: doc_of([a]), pattern: "released")
              && string_contains(s: doc_of([a]), pattern: "claimed")
              && string_contains(s: doc_of([a]), pattern: "2026-11-18")
              && string_contains(s: doc_of([a]), pattern: "\"in_flight\": []")
            ProjectionRowRefused { refusal: _ } => false
          }
        ProjectionRowRefused { refusal: _ } => false
      }
    }
  }
}

// FILE ORDER DOES NOT DECIDE THE ROW -- the causal chain does (manager ruling 2026-11-24): [Released,
// Claimed] listed in the order the files happened to arrive in still reports the RELEASE as latest and the
// same derived in-flight set as [Claimed, Released], because roadmap_projection_row_read orders by the parent
// links, not the list it was handed. A row whose latest flipped with file order would be a timeline lying
// about what happened last.
test fn permuting_the_log_order_leaves_the_row_unchanged() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } => {
      // A REAL bound+decomposed item; the held leaf is pinned by the from-now schedule, so the claim carries a
      // full ISO instant and is dated inside the working week that precedes the Fri 2026-11-20 read (the same
      // day-two control roadmap_schedule_from_now uses) rather than an unadmittable bare date.
      let c = claim_event("namespace-reference-derived-closure", "2026-11-17T09:00:00Z")
      let c_env = roadmap_event_envelope(e: c)
      let r = release_event(linked_to: c, at: "2026-11-18T09:00:00Z")
      let r_env = roadmap_event_envelope(e: r)
      match roadmap_projection_row_read(
        node: nid(s: "namespace-reference-derived-closure"), read_date: Iso8601CivilDate { year: 2026, month: 11, day: 20 },
        workers: BeltCapacity { max_concurrent: 4 }, findings_count: findings,
        standings: open_standings(), envs: [c_env, r_env]) {
        ProjectionRowBuilt { row: ordered, day_priors: _ } =>
          match roadmap_projection_row_read(
            node: nid(s: "namespace-reference-derived-closure"), read_date: Iso8601CivilDate { year: 2026, month: 11, day: 20 },
            workers: BeltCapacity { max_concurrent: 4 }, findings_count: findings,
            standings: open_standings(), envs: [r_env, c_env]) {
            ProjectionRowBuilt { row: shuffled, day_priors: _ } =>
              match ordered.latest_event {
                Present { value: lo } => match shuffled.latest_event {
                  Present { value: ls } => lo == "released" && ls == lo && count(shuffled.in_flight) == count(ordered.in_flight)
                  Absent => false
                }
                Absent => false
              }
            ProjectionRowRefused { refusal: _ } => false
          }
        ProjectionRowRefused { refusal: _ } => false
      }
    }
  }
}

// A row that could not honestly be built refuses the WHOLE document with a LOCATED reason and NO `rows`
// key -- here a work item with no binding at all (so no intention/layer). The refusal fed to the document is
// the real one build_row produced (not a hand-built one), so the refusal plumbing is exercised end to end.
// NOTE: "a planted binding to an intention that does not exist" is the binding carrier's LOAD-time
// cited-declaration check (roadmap_intention_binding / producer_resolves), which the projection relies on and
// -- per review finding #2 -- deliberately does NOT duplicate as a runtime re-check.
test fn unbound_node_refuses_the_whole_document_not_drops_the_row() -> Bool {
  let built = projection_build_row(
    node: "never-bound", bindings: [bound_node("item-a")], standings: open_standings(),
    leaves: [] as List<ProjectionLeaf>, in_flight: [] as List<ProjectionInFlight>, envs: [] as List<RoadmapEventEnvelope>,
    day_priors: [] as List<Int>,
  )
  match built {
    ProjectionRowBuilt { row: _, day_priors: _ } => false
    ProjectionRowRefused { refusal: r } =>
      let refusal_doc = serialize_json(v: roadmap_work_item_projection_document_json(
        rows: [] as List<ProjectionRow>, refused: [r], read_on: "2026-11-24", inputs: read_inputs()))
      string_contains(s: refusal_doc, pattern: "\"refused\"")
        && string_contains(s: refusal_doc, pattern: "never-bound")
        && !string_contains(s: refusal_doc, pattern: "\"rows\"")
  }
}

// The projection is a projection: the in-flight leaves are the log's DERIVED set spelled to the wire
// (assignee and return_to are the claim's own), never a list this document stores -- and the leaf path is
// spelled as the decomposition spells it.
test fn in_flight_leaves_are_the_derived_set_read_off_the_log() -> Bool {
  let derived = [ LeafInFlightEntry {
    leaf: LeafPath { item: nid(s: "item-a"), stage: 1, piece: 0, member: 2 }, claim: "e-1" as RoadmapEventId,
    assignee: principal("erin@roadmap"), return_to: principal("fred@roadmap"), since: "2026-11-05",
  } ]
  let entries = projection_in_flight_entries(entries: derived, item: "item-a")
  let row_json = serialize_json(v: projection_row_json(row: ProjectionRow {
    node: "item-a", intention: "gunbc.plans.planning_consolidation/planning_consolidation_plan",
    layer: 2, item_state: "claimed", leaves: [] as List<ProjectionLeaf>, in_flight: entries,
    latest_event: Present { value: "claimed" }, acceptance_evidence: Absent, events: [] as List<ProjectionEvent>,
  }))
  count(entries) == 1
    && string_contains(s: row_json, pattern: "item-a#1#0#2")
    && string_contains(s: row_json, pattern: "erin@roadmap")
    && string_contains(s: row_json, pattern: "fred@roadmap")
    && string_contains(s: row_json, pattern: "\"latest_event\": \"claimed\"")
    && string_contains(s: row_json, pattern: "\"acceptance_evidence\": null")
}

// The served surface: the projection is a declared surface at /projection.json, with the same key
// round-trip as the other JSON surfaces.
test fn projection_is_a_served_surface_at_its_path() -> Bool {
  served_observation_kind_url_path(kind: ProjectionJson) == "/projection.json"
    && served_observation_kind_of_key(key: served_observation_kind_key(kind: ProjectionJson))
       == ServedObservationKindDecoded { kind: ProjectionJson }
}

// THE CALENDAR BINDS THE DAYS: a leaf's start_day/finish_day are ISO days (YYYY-MM-DD) spelled by the
// calendar's own date_text off the dated answer -- the SAME dates the item gantt serves, so no reader runs a
// second calendar. The critical-path bit is read off the schedule answer's critical path by the leaf path.
test fn leaves_are_bound_to_iso_days_through_the_calendar() -> Bool {
  let path_a = LeafPath { item: nid(s: "item-a"), stage: 0, piece: 0, member: 0 }
  let dated = DatedLeaf {
    path: path_a, start_day: 0, finish_day: 2,
    start_date: Iso8601CivilDate { year: 2026, month: 11, day: 2 },
    finish_date: Iso8601CivilDate { year: 2026, month: 11, day: 4 },
    count_source: Declared,
  }
  let on_path = projection_leaf_from_dated(d: dated, critical_path: [path_a])
  let off_path = projection_leaf_from_dated(d: dated, critical_path: [] as List<LeafPath>)
  let item_only = projection_leaves_for_item(dated: [dated], critical_path: [path_a], item: "item-a")
  let other = projection_leaves_for_item(dated: [dated], critical_path: [path_a], item: "item-z")
  on_path.start_day == "2026-11-02"
    && on_path.finish_day == "2026-11-04"
    && on_path.on_critical_path == true
    && off_path.on_critical_path == false
    && count(item_only) == 1
    && count(other) == 0
}

// THE ONE READ, DRIVEN WITH CONSTRUCTED INPUTS on a REAL bound+decomposed work item
// (namespace-reference-derived-closure, which is in roadmap_intention_bindings AND roadmap_decompositions):
// row_read expands it, schedules it, binds the answer's leaves through the one calendar, reads its derived
// in-flight set off its own envelopes, and assembles the row off the real binding (intention, layer) and the
// standing (open). This is green-by-execution of the WHOLE composition -- schedule, calendar, in-flight fold
// -- not of a hand-built fixture. The item is chosen because it decomposes for real; the row must build, and
// any leaf it does carry must be an ISO day, never an abstract integer or a fabricated date.
test fn row_read_builds_a_dated_row_for_a_real_bound_item() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } => match roadmap_projection_row_read(
      node: nid(s: "namespace-reference-derived-closure"),
      read_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
      workers: BeltCapacity { max_concurrent: 4 },
      findings_count: findings,
      standings: open_standings(),
      envs: [] as List<RoadmapEventEnvelope>,
    ) {
      // Either a built, dated row -- the composition executed and the schedule placed the item -- OR an honest
      // RowScheduleRefused: with empty envs the in-flight read cannot refuse, the node is bound and has a
      // decomposition, so the ONLY legal refusal here is the schedule refusing to place it. A built row must
      // carry every leaf as an ISO day and its day_priors must align one-for-one with its leaves (a leaf with
      // no prior, or a prior with no leaf, is the silent-widen this node forbids).
      ProjectionRowBuilt { row: r, day_priors: p } =>
        r.node == "namespace-reference-derived-closure"
        && r.item_state == "open"
        && string_length(s: r.intention) > 0
        && count(r.in_flight) == 0
        && count(p) == count(r.leaves)
        && count(filter(r.leaves, l =>
             string_length(s: l.start_day) == 10
             && string_length(s: l.finish_day) == 10
             && string_contains(s: l.start_day, pattern: "-")
             && string_contains(s: l.finish_day, pattern: "-"))) == count(r.leaves)
      ProjectionRowRefused { refusal: RowScheduleRefused { node: n, cause: _ } } => n == "namespace-reference-derived-closure"
      ProjectionRowRefused { refusal: _ } => false
    }
  }
}

// A PLANTED PROJECTION REFUSAL REFUSES THE WHOLE PROJECTION, NOT JUST ONE ROW: a node with no binding at all
// (so no intention/layer to honestly state) makes document_for_read emit refused{step,reason} for the whole
// document with NO rows key -- a Timeline never draws a partial plan as a complete one. The refusal is the
// read's own (UnboundNode), reached through the real read, not a hand-built refusal.
test fn document_for_read_refuses_the_whole_document_on_a_planted_unbound_node() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } =>
      let d = serialize_json(v: roadmap_projection_document_for_read(
        nodes: [nid(s: "namespace-reference-derived-closure"), nid(s: "no-such-bound-node-xyz")],
        read_on_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
        workers: BeltCapacity { max_concurrent: 4 },
        findings_count: findings,
        standings: open_standings(),
        envs: [] as List<RoadmapEventEnvelope>,
      ))
      string_contains(s: d, pattern: "\"refused\"")
      && string_contains(s: d, pattern: "no-such-bound-node-xyz")
      && !string_contains(s: d, pattern: "\"rows\"")
  }
}

// THE SERVED PROJECTION FOR HONESTLY-BUILDABLE ITEMS: every bound item builds, so the document carries its
// rows and the read_on day and the inputs it used (worker_count, the day priors it was handed, the assumed
// findings counts) at the top level, each shown as the input it is (the boundary). This is the single call the
// /projection.json surface makes; the standings surface is a SEPARATE arm and is never reached from here.
test fn document_for_read_serves_built_rows_with_inputs_for_bound_items() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } =>
      let d = serialize_json(v: roadmap_projection_document_for_read(
        nodes: [nid(s: "namespace-reference-derived-closure")],
        read_on_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
        workers: BeltCapacity { max_concurrent: 4 },
        findings_count: findings,
        standings: open_standings(),
        envs: [] as List<RoadmapEventEnvelope>,
      ))
      string_contains(s: d, pattern: "\"rows\"")
      && string_contains(s: d, pattern: "namespace-reference-derived-closure")
      && string_contains(s: d, pattern: "\"read_on\"")
      && string_contains(s: d, pattern: "2026-11-24")
      && string_contains(s: d, pattern: "\"worker_count\"")
      && string_contains(s: d, pattern: "\"day_priors\"")
      && string_contains(s: d, pattern: "\"assumed_findings_counts\"")
  }
}

// A PLANTED PROJECTION REFUSAL IS THE PROJECTION'S OWN, NEVER A STANDINGS BODY (manager ruling 2026-11-24:
// "a refusal of the projection read must produce the refused document for /projection.json ONLY"). The
// /standings.json surface is a SEPARATE arm built by a different function -- untouched here, guarded by its
// own witnesses (roadmap_standings_document_test) which run in CI unchanged. So the honest thing this witness
// can prove without driving the whole tick's I/O is the isolation at the document level: the projection's
// refusal carries the PROJECTION schema and its refused{step,reason}, and carries NONE of the keys that
// belong only to the standings document (log_head / release_identity / standings / source_head). A refusal
// therefore cannot be mistaken for, cannot overwrite, and does not depend on the standings surface -- it is
// contained to /projection.json. The standings arm is still served by its own path regardless of this refusal.
test fn projection_refusal_is_the_projections_own_document_not_a_standings_body() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } =>
      let d = serialize_json(v: roadmap_projection_document_for_read(
        nodes: [nid(s: "no-such-bound-node-xyz")],
        read_on_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
        workers: BeltCapacity { max_concurrent: 4 },
        findings_count: findings,
        standings: open_standings(),
        envs: [] as List<RoadmapEventEnvelope>,
      ))
      string_contains(s: d, pattern: "roadmap-work-item-projection/v1")
      && string_contains(s: d, pattern: "\"refused\"")
      && !string_contains(s: d, pattern: "log_head")
      && !string_contains(s: d, pattern: "release_identity")
      && !string_contains(s: d, pattern: "source_head")
      && !string_contains(s: d, pattern: "\"standings\"")
  }
}

// Two disjoint claim roots for the SAME item = two tips = no single head = the derived in-flight read cannot
// order the history (roadmap_event_causal_chain refuses on more than one tip). `envelope` already pins parent
// to Absent, so two claimed envelopes for the node are two roots and the history is unorderable.

// FAIL-CLOSED (review 97769): an item whose log history CANNOT be causally ordered makes the derived in-flight
// read refuse. The row must REFUSE as InFlightUnordered -- NOT widen to an empty in_flight, which would draw
// an item with held claims as one nobody claimed. This is the silent-widen the fail_closed argument forbids;
// here it is a located refusal. The item is a REAL bound+decomposed node so the read reaches its in-flight fold.
test fn row_read_refuses_on_unorderable_in_flight_history() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } => match roadmap_projection_row_read(
      node: nid(s: "namespace-reference-derived-closure"),
      read_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
      workers: BeltCapacity { max_concurrent: 4 },
      findings_count: findings,
      standings: open_standings(),
      envs: [
        envelope("namespace-reference-derived-closure", claimed("namespace-reference-derived-closure"), "2026-11-24T09:00:00Z"),
        envelope("namespace-reference-derived-closure", claimed("namespace-reference-derived-closure"), "2026-11-24T10:00:00Z"),
      ],
    ) {
      ProjectionRowBuilt { row: _, day_priors: _ } => false   // must never widen to a built row
      ProjectionRowRefused { refusal: InFlightUnordered { node: n } } => n == "namespace-reference-derived-closure"
      ProjectionRowRefused { refusal: _ } => false             // any other refusal here is wrong
    }
  }
}

// FAIL-CLOSED AT THE DOCUMENT (review 97769): one item whose in-flight history cannot be ordered refuses the
// WHOLE projection -- refused{step:"in_flight", reason names the node}, no rows. A reader is never handed a
// document that quietly omits the in-flight state of one item while claiming the timeline is complete.
test fn document_for_read_refuses_whole_document_on_an_unorderable_item() -> Bool {
  match checked_int_to_nat(n: 1) {
    Absent => false
    Present { value: findings } =>
      let d = serialize_json(v: roadmap_projection_document_for_read(
        nodes: [nid(s: "namespace-reference-derived-closure")],
        read_on_date: Iso8601CivilDate { year: 2026, month: 11, day: 24 },
        workers: BeltCapacity { max_concurrent: 4 },
        findings_count: findings,
        standings: open_standings(),
        envs: [
          envelope("namespace-reference-derived-closure", claimed("namespace-reference-derived-closure"), "2026-11-24T09:00:00Z"),
          envelope("namespace-reference-derived-closure", claimed("namespace-reference-derived-closure"), "2026-11-24T10:00:00Z"),
        ],
      ))
      string_contains(s: d, pattern: "\"refused\"")
      && string_contains(s: d, pattern: "in_flight")
      && string_contains(s: d, pattern: "namespace-reference-derived-closure")
      && !string_contains(s: d, pattern: "\"rows\"")
  }
}
