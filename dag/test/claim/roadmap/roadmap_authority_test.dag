// witness_active_sizes_are_intentional_and_nonuniform WAS HERE AND IS RETIRED WITH ITS SUBJECT.
// It asserted that the authored size cells across the active rows were deliberate rather than one
// value copied down the file -- every row sized, and at least one row at each end of the range.
// Sizing is derived now and nothing carries a cell, so the claim has no population; weakening it
// to "every row is dispatchable" would leave the witness green while asserting something the row
// shape witness above already checks by identity. It is named in the population of
// gunbc.rung_drop.roadmap_sizing_authored_to_derived beside the forecast controls, and its trigger
// is the condition under which a derived distribution exists to make the claim about again.

// Dated status notes belong on a ticket's updates thread (gunbc.roadmap_authority updated), so the
// thread is not what this claims is absent; what must never appear is execution state written into
// the ticket's standing fields.
test fn witness_authority_contains_no_mutable_execution_ledger() -> Bool {
  all(nodes() |> filter(n => match line_ticket(item: n.line) { Present { value: _ } => true  Absent => false }), n => match n.line {
    TicketLine { done: _, ticket } =>
      ticket.authored_on == ""
        && ticket.last_verified_on == ""
        && !string_contains(s: ticket.current_state, pattern: "PR #")
        && !string_contains(s: ticket.current_state, pattern: "session/")
        && !string_contains(s: ticket.current_state, pattern: "CI run")
    _ => false
  }) && count(authored_merged_prs()) == 0
}

