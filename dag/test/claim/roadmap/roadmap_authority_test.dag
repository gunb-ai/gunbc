// THE ACTIVE-SET CLAIM READS THE WHOLE PROJECTION: the page's focus row was deleted on 2026-09-30,
// so an accepted row's absence here can only mean it was accepted, never that a view hid it. It
// reads the projected rows themselves rather than their serialized markdown: every clause is a
// fact about which rows the projection carries (an accepted row is absent, an active one present,
// no superseded or awaiting-sign-off row survives), and serializing ~200 rows to find those facts
// cost the markdown emitter's whole fold per run. The markers' spelling is the emitter's own
// subject (test.claim.roadmap_emit_test); the clauses here are the same per-row predicates the
// emitter renders them from (gunbc.roadmap_emit node_is_superseded, signoff_suffix_inlines).
fn inline_text_contains(i: MarkdownInline, pattern: String) -> Bool {
  match i {
    TextInline { text } => string_contains(s: text, pattern: pattern)
    _ => false
  }
}

// One pass per projected row: neither accepted row named below, not superseded, not awaiting
// sign-off.
fn projected_row_is_active(n: RoadmapNode) -> Bool {
  let id = n.node as String
  !(id == "namespace-occurrence-transport")
    && !(id == "pderive-typesafe-nullary-reflection")
    && !node_is_superseded(rn: n)
    && !any(signoff_suffix_inlines(rn: n, merged: authored_merged_prs()), i => inline_text_contains(i: i, pattern: "awaiting sign-off"))
}

// The former markdown claim's text clause, split off because it is independent of which rows are
// active: no projected row's line and no preamble paragraph carries an operator TODO.
test fn witness_projection_carries_no_operator_todo() -> Bool {
  match roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) {
    RoadmapAuthorityProjectionRefused { detail: _ } => false
    RoadmapAuthorityProjected { doc: d, accepted: _, withheld: _ } =>
      !any(doc_all_nodes(doc: d), n => any(line_inlines(line: n.line), i => inline_text_contains(i: i, pattern: "Operator TODO")))
        && !any(d.preamble, b => match b {
          ParagraphBlock { inlines } => any(inlines, i => inline_text_contains(i: i, pattern: "Operator TODO"))
          _ => false
        })
  }
}

data execution_frontier_witness_note: String = "The execution-contract frontier is a COUNT, and these claims pin both of its halves. Before the first binding the count was zero — dispatch_environment_admit refused on every node, so nothing below Env in the workflow had ever executed end to end and the whole seven-segment strip was unreachable in production. A binding is therefore the gate for every downstream receipt, and an unwitnessed one could regress to zero silently (the way it already did once, when the 2026-07-27 authority refresh deleted the node that carried the prior contract and no claim noticed). The first claim proves the bound node yields a real contract rather than the fail-closed variant; the second proves the platform/task capability JOIN actually happens at admission — 8 fixed dispatch mechanics plus the one capability this contract's validation derives — which is the fact that turns a contract into an admissible environment; the third is the frontier itself, and it is the RED-shaped one: it fails if a binding is lost AND it fails if a second node is bound without this roster being updated, so the count in roadmap_execution_contract_frontier_note cannot silently drift from the authority it describes."

fn bound_execution_contract_for(id: String) -> WorkItemExecutionContract {
  match nodes()
    |> filter(n => (n.node as String) == id)
    |> map(n => n.execution)
    |> first {
    Present { value: c } => c
    Absent => ExecutionContractUnspecified
  }
}

