    }
}

data rendered_containment_witness_note: String = "RENDERED NODES ARE DECLARED OR DERIVED — the wall against a second roadmap universe. The 2026-07-31 operator verdict on gunbc#7489 found a section rendering nodes from a section-local list that never entered declared_roadmap_nodes(): those nodes bypassed acceptance receipts, active-set derivation, and every witness in this file, while looking exactly like roadmap rows on the page. The first claim runs the containment predicate over BOTH real documents (the focus-independent authority view and the focused ROADMAP.md view — a ghost hidden by focus in one can render in the other). The second is the RED: a synthetic document carrying one undeclared node must count exactly one ghost, proving the predicate discriminates rather than vacuously passing whatever renders."

test fn witness_ghost_node_outside_authority_is_counted() -> Bool {
  roadmap_ghost_node_red_probe_count() == 1
}

test fn witness_altered_copy_of_declared_node_is_counted() -> Bool {
  roadmap_altered_copy_red_probe_count() == 1
}

test fn witness_projected_dependency_edges_include_closing_contract_projection() -> Bool {
  match closing_contract_task_edges_projection() {
    ClosingContractTaskEdgesProjected { edges: closing_edges } =>
      match projected_roadmap_dependency_edges_projection() {
        ProjectedRoadmapDependencyEdgesProjected { edges: projected } =>
          fold(closing_edges, init: true, f: fn(acc, edge) {
            acc && projected |> any(p => p.child == edge.child && p.parent == edge.parent)
          })
        ProjectedRoadmapDependencyEdgesProjectionRefused { detail: _ } => false
      }
    ClosingContractTaskEdgesProjectionRefused { detail: _ } => false
  }
}

test fn witness_fleet_state_frontier_authority_is_host_converge_carrier() -> Bool {
  node_has_carrier_path(path: "dag/gunbc/host/host_converge.dag")
    && !node_has_carrier_path(path: "docs/plans/host-converge-inventory.md")
    && string_length(s: filesystem_read(path: "dag/gunbc/host/host_converge.dag").content) > 0
}

test fn witness_projected_dependency_edges_include_active_edges() -> Bool {
  match frontier_sets_projection(history: roadmap_acceptance_event_history_load()) {
    FrontierSetsProjected { accepted: accepted, withheld: withheld } =>
      match projected_roadmap_dependency_edges_projection() {
        ProjectedRoadmapDependencyEdgesProjected { edges: projected } =>
          fold(
            active_roadmap_edges_for_accepted(accepted: accepted, withheld: withheld),
            init: true,
            f: fn(acc, edge) {
              acc && projected |> any(p => p.child == edge.child && p.parent == edge.parent)
            }
          )
        ProjectedRoadmapDependencyEdgesProjectionRefused { detail: _ } => false
      }
    FrontierSetsProjectionRefused { detail: _ } => false
  }
}

// ONE NULLARY PRODUCER, ENROLLED WARM (v2.workflow.floor_pure_producer_share): the verdict projects
// the live roadmap twice, more than one claim's new-witness budget, so the claim reads it stored.
test fn witness_withheld_sized_subject_does_not_mint_closing_contract_task() -> Bool {
  withheld_sized_subject_verdict()
}

fn withheld_sized_subject_verdict() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      let unfiltered = startable_nodes_missing_closing_contract_for_accepted(
        accepted: accepted,
        withheld: [],
      )
      if count(unfiltered) == 0 {
        false
      } else {
        match first(unfiltered) {
          Absent => false
          Present { value: victim } =>
            !(startable_nodes_missing_closing_contract_for_accepted(
              accepted: accepted,
              withheld: [victim.node],
            ) |> any(x => x.node == victim.node))
        }
      }
  }
}

// THE AUTHORITY-WIDE HALF OF THE PAGE CLAIMS, AS A CENSUS THAT DOES NOT RENDER. The page claims read
// the served folds over a projection holding a few named declared rows
// (test.claim.roadmap.roadmap_authority_subtree_fixture); what made rendering the whole authority
// look necessary was that the rows they read are the rows the real projection carries. That is an
// identity join over the projection, so it is stated here once: the projected document carries
// every active declared row (the completeness half -- witness_rendered_nodes_are_declared_or_derived
// is the soundness half), and every row a subtree claim names is one of them.
fn projected_document_id_set(doc: RoadmapDocument) -> Map<String, Bool> {
  let empty: Map<String, Bool> = empty_map()
  fold(doc_all_nodes(doc: doc), init: empty, f: (acc, n) => map_insert(m: acc, key: n.node as String, value: true))
}

fn projected_document_carries(ids: Map<String, Bool>, id: String) -> Bool {
  match map_lookup(m: ids, key: id) { Present { value: _ } => true  Absent => false }
}

test fn witness_authority_document_carries_every_active_declared_row() -> Bool {
  match roadmap_authority_projection(history: roadmap_acceptance_event_history_load()) {
    RoadmapAuthorityProjectionRefused { detail: _ } => false
    RoadmapAuthorityProjected { doc: d, accepted, withheld } => {
      let shown = projected_document_id_set(doc: d)
      let active = active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld)
      count(active) > 0
        && all(active, n => projected_document_carries(ids: shown, id: n.node as String))
        && all(fx_subtree_fixture_ids(), id => any(active, n => (n.node as String) == id))
    }
  }
}

// A PREREQUISITE IS A DECLARED EDGE, NOT A SENTENCE IN A BOUNDARY. serve-held-open-response streams
// an attempt's events from the fabric event log, so it waits on fabric-worker-event-log publishing
// them there. Readiness fires only from declared edges, so the claim reads the ONE readiness the
// page and the dispatcher read (node_readiness_in_graph over the declared graph): the dependent row
// names the prerequisite among its dependency blockers, and the prerequisite, which depends on
// nothing, names no dependency gap -- so the blocker is the edge's, not a gap every row carries.
fn declared_dependency_blockers(id: String) -> List<String> {
  let graph = readiness_graph(nodes: nodes(), edges: edges())
  fold(declared_node(id: id), init: [], f: (acc, n) => match node_readiness_in_graph(node: n, graph: graph, merged: []) {
    ReadyToDispatch => acc
    NotReady { missing } => fold(missing, init: acc, f: (inner, g) => match g {
      GapDependencies { blockers } => concat(inner, blockers)
      _ => inner
    })
  })
}

test fn witness_serve_held_open_response_waits_on_the_fabric_worker_event_log() -> Bool {
  count(declared_node(id: "serve-held-open-response")) == 1
    && count(declared_node(id: "fabric-worker-event-log")) == 1
    && (declared_dependency_blockers(id: "serve-held-open-response") |> any(b => b == "fabric-worker-event-log"))
    && count(declared_dependency_blockers(id: "fabric-worker-event-log")) == 0
}
