data acceptance_receipt_continuity_witness_note: String = "THE WALL AGAINST SILENT RECEIPT DELETION (acceptance_receipt_continuity_wall_note). roadmap_acceptance_event_history loads from dag/gunbc/roadmap/roadmap_acceptance_event_history.jsonl; roadmap_acceptance_receipts projects live receipts only. Live git-observed integrity executes in test.claim.roadmap_receipt_continuity_live_witness (ReadsLiveTree, bin_witness_wet_entries). RED controls in test.claim.roadmap_receipt_continuity_acceptance plant deleted events, prefix law, empty-prior bypass discriminant, digest-field mutation, wrong prior digest, revocation while live, duplicate revocations, exact revocation admit, criteria rewrite, git-refusal observation, and typed projection refusal chain."

fn live_acceptance_event_history() -> List<RoadmapAcceptanceEvent> {
  match roadmap_acceptance_event_history_load() {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => events
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

test fn witness_vanished_receipt_without_revocation_refuses() -> Bool {
  let prior = live_acceptance_event_history()
  let current = prior
    |> filter(e =>
      match e {
        AcceptanceRecorded { receipt: r } => r.node != tnid(s: "namespace-occurrence-transport")
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true
      }
    )
  !acceptance_history_extends_prior(prior: prior, current: current)
}

test fn witness_explicit_revocation_authorizes_vanished_receipt() -> Bool {
  let prior = live_acceptance_event_history()
  match project_live_acceptance_receipts(history: prior) {
    LiveAcceptanceReceiptsReplayRefused => false
    LiveAcceptanceReceiptsReplayed { live: live } => {
  let receipt = first(
    live |> filter(r => r.node == tnid(s: "namespace-occurrence-transport")),
  )
  let current = concat(prior, [
    AcceptanceRevoked {
      exact_prior_receipt: receipt,
      disposition: AcceptanceNodeReopensActiveFrontier {},
      reason: "fixture revocation witness" as NonEmptyStr,
      revoked_by: "operator" as NonEmptyStr,
      revoked_on: "2026-08-04" as NonEmptyStr,
    },
  ])
  acceptance_history_extends_prior(prior: prior, current: current)
    && acceptance_history_integrity_holds(
      history: current,
      prior_history: prior,
    )
    }
  }
}

