fn nodes() -> List<RoadmapNode> { declared_roadmap_nodes() }
fn edges() -> List<RoadmapEdge> { declared_roadmap_edges() }
fn active_nodes() -> List<RoadmapNode> {
  match active_roadmap_nodes_projection() {
    ActiveRoadmapNodesProjectionRefused { detail: _ } => []
    ActiveRoadmapNodesProjected { nodes: nodes } => nodes
  }
}
fn active_edges() -> List<RoadmapEdge> {
  match active_roadmap_edges_projection() {
    ActiveRoadmapEdgesProjectionRefused { detail: _ } => []
    ActiveRoadmapEdgesProjected { edges: edges } => edges
  }
}

fn live_accepted_node_ids() -> List<RoadmapNodeId>? {
  match frontier_sets_projection(history: roadmap_acceptance_event_history_load()) {
    FrontierSetsProjected { accepted: ids, withheld: _ } => Present { value: ids }
    FrontierSetsProjectionRefused { detail: _ } => Absent
  }
}

fn live_withheld_node_ids() -> List<RoadmapNodeId>? {
  match withheld_node_ids_projection(history: roadmap_acceptance_event_history_load()) {
    WithheldNodeIdsProjected { ids: ids } => Present { value: ids }
    WithheldNodeIdsProjectionRefused { detail: _ } => Absent
  }
}

fn tnid(s: String) -> RoadmapNodeId { s }
fn tchash(s: String) -> Fnv1a64Structural { content_hash_atom(value: s as NonEmptyStr) }

fn digest_or_zero(rn: RoadmapNode) -> Fnv1a64Structural {
  match node_criteria_digest(rn: rn) {
    Present { value } => value
    Absent => tchash(s: "0000000000000000")
  }
}

fn declared_node(id: String) -> List<RoadmapNode> {
  nodes() |> filter(n => n.node == id)
}

fn receipt_fixture(node: String, digest: Fnv1a64Structural) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: tnid(s: node),
    criteria_digest: digest,
    red_control: RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn evidenceless_receipt_fixture(rn: RoadmapNode) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: RedControlNotRun,
    handback: HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn undelivered_receipt_fixture(rn: RoadmapNode) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackNotDelivered,
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn id_exists(id: RoadmapNodeId) -> Bool {
  nodes() |> any(n => n.node == id)
}

fn id_count(id: RoadmapNodeId) -> Int {
  nodes() |> filter(n => n.node == id) |> count
}

fn active_id_exists(id: RoadmapNodeId) -> Bool {
  active_nodes() |> any(n => n.node == id)
}

fn edge_exists(child: String, parent: String) -> Bool {
  edges() |> any(e => e.child == child && e.parent == parent)
}

fn node_has_carrier_path(path: String) -> Bool {
  nodes() |> any(n => n.carriers |> any(p => p.path == path))
}

fn node_count_with_carrier_path(path: String) -> Int {
  nodes() |> filter(n => n.carriers |> any(p => p.path == path)) |> count
}

fn mechanical_graph() -> CallGraph {
  CallGraph {
    edges: edges() |> map(e => GraphEdge {
      caller: e.parent as String,
      callee: e.child as String,
    }),
  }
}

fn node_names() -> List<String> {
  nodes() |> map(n => n.node as String)
}

fn ticket_fields_complete(ticket: TicketFields) -> Bool {
  !(ticket.headline == "")
        && !(ticket.brief == "")
        && !(ticket.displaced_cost == "")
        && !(ticket.current_state == "")
        && !(ticket.first_slice == "")
        && !(ticket.red_control == "")
        && !(ticket.out_of_scope == "")
        && !(ticket.handback == "")
}

fn active_node_admissible(n: RoadmapNode) -> Bool {
  !item_is_done(item: n.line, merged: [])
    && !signoff_is_present(s: n.signoff)
    && match line_ticket(item: n.line) {
      Present { value } => ticket_fields_complete(ticket: value)
      Absent => false
    }
    && count(n.carriers) > 0
    && !(n.owner == "")
    && match n.dispatch {
      Dispatchable { repo, acceptance } =>
        repo == "gunbc" && acceptance == ManualAcceptance
      NotDispatchable => true
  }
}

fn red_fixture(line: RoadmapItem, signoff: Signoff) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_8E5PG4F7CAZ148VZ8MNY" as RoadmapNodeIdentity,
    node: "red-fixture",
    line: line,
    carriers: [Pointer { label: "authority", path: "DESIGN.md" }],
    dispatch: Dispatchable {
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: "roadmap-authority",
    signoff: signoff,
    parent: none,
    centering: none,
  }
}

fn red_ticket(done: Bool) -> RoadmapItem {
  TicketLine {
    done: done,
    ticket: TicketFields {
      headline: "planted completed-row RED",
      brief: "Every required field is populated so only the forbidden completion or acceptance state can reject this fixture.",
      displaced_cost: "none",
      current_state: "fixture",
      first_slice: "fixture",
      red_control: "fixture",
      out_of_scope: "fixture",
      handback: "fixture",
      updates: [],
      authored_on: "",
      last_verified_on: "",
    },
  }
}

test fn witness_declared_graph_has_justified_size() -> Bool {
  count(nodes()) > 0 && count(edges()) > 0
    && count(active_nodes()) > 0 && count(active_edges()) > 0
}

test fn witness_declared_node_ids_are_unique() -> Bool {
  all(nodes(), n => id_count(id: n.node) == 1)
}

test fn witness_every_edge_endpoint_exists() -> Bool {
  all(edges(), e => id_exists(id: e.child) && id_exists(id: e.parent))
}

test fn witness_declared_graph_is_mechanically_acyclic() -> Bool {
  all(edges(), e => !(e.parent == e.child))
    && !graph_has_multi_node_scc(names: node_names(), graph: mechanical_graph())
}

// Every declared TICKET row is a complete, unsigned, open ticket with a carrier and an owner; a
// sized row is sized for this repository with manual acceptance, and an unsized row is simply not
// ready (gunbc.roadmap.roadmap_readiness). The one superseded history row carries no ticket and is
// outside this population by construction of its line.
test fn witness_every_declared_row_is_complete_unsigned_ticket() -> Bool {
  all(nodes() |> filter(n => match line_ticket(item: n.line) { Present { value: _ } => true  Absent => false }), n => active_node_admissible(n: n))
}

data live_state_count_transcription_note: String = "NO LIVE-STATE COUNT PINS IN THIS FILE, deliberately, and the deleted ones are named so the class does not creep back. Removed: `count(accepted) == 8` here, and `\"63 declared · 8 accepted · 55 active\"` in test.claim.long.roadmap_page_witness. Both TRANSCRIBED a number nobody decided — they mirrored whatever the live authority happened to hold, so authoring any correct roadmap row redded them (observed twice; the second was PR #7463, whose only content was two new rows). A pin like that reports 'the roadmap changed', which is not a defect, while the reviewer's habit becomes editing the number to match — a check satisfied by editing the declaration, which DESIGN §5 names as the tell that validation stood where construction was available. THE DISTINCTION THAT DECIDES WHETHER A COUNT MAY STAY: does the number come from a fixture the test CONSTRUCTS, or from live corpus state? test.claim.roadmap_altitude_witness renders `doc_html(nodes: [done_signed_node(), open_node()])` and asserts `1 open · 1 done` — that is the renderer computing from two known inputs, so it is a specification and it stays; deleting it would remove real coverage. Same for the observation render witnesses over replayed fixture blocks, and for structural counts that encode a design fact rather than a population (two workflow lamps, three static routes). WHAT SURVIVED THE DELETION HERE, and why nothing was lost: this witness's actual invariant is the RELATIONSHIP `count(active_nodes()) == count(nodes()) - count(accepted)`, which is magnitude-independent and still asserted; the eight per-id acceptance assertions also stay, because they pin WHICH acceptances exist and a dropped one is real history loss (scm_prerequisite_acceptance_note). Only the magnitude went. Replacing it with `string_contains(page, roadmap_counts_label())` was considered and rejected as the vacuous form — both sides derive from the same function, so it asserts the page contains what the page computed (operator ruling 2026-07-30: no vacuous or tautological testing)."

test fn witness_active_set_is_declared_minus_accepted() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      (accepted |> any(a => a == "namespace-occurrence-transport"))
        && (accepted |> any(a => a == "pderive-typesafe-nullary-reflection"))
        && (accepted |> any(a => a == "pderive-static-supplemental-contract"))
        && (accepted |> any(a => a == "v1-test-hygiene-producer-retirement"))
        && (accepted |> any(a => a == "2-scm-git-upstream-model"))
        && (accepted |> any(a => a == "2-scm-mercurial-upstream-model"))
        && (accepted |> any(a => a == "2-scm-pijul-upstream-model"))
        && (accepted |> any(a => a == "2-claim-indexed-evidence"))
        && (accepted |> any(a => a == "2-scm-compatibility-shape"))
        && (accepted |> any(a => a == "2-scm-p0-landing-spine"))
        && match live_withheld_node_ids() {
          Absent => false
          Present { value: withheld } =>
            count(active_nodes()) == count(nodes()) - count(accepted) - count(withheld)
              && all(active_nodes(), n => !(accepted |> any(a => a == n.node)))
              && all(active_nodes(), n => !(withheld |> any(w => w == n.node)))
        }
        && all(accepted, a => id_exists(id: a))
  }
}

test fn witness_acceptance_receipts_are_valid_and_unique() -> Bool {
  match roadmap_acceptance_receipts(history: roadmap_acceptance_event_history_load()) {
    RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
    RoadmapAcceptanceReceiptsProjected { receipts: receipts } =>
      count(receipts) > 0
        && all(receipts, r => count(receipts |> filter(x => x.node == r.node)) == 1)
        && all(receipts, r => id_exists(id: r.node))
        && all(receipts, r => all(declared_node(id: r.node as String), n =>
          match receipt_node_match_verdict(r: r, rn: n) {
            ReceiptMatchesNode => true
            LiveReceiptOnSupersededLine { node: _ } => false
            ReceiptDoesNotMatchNode => false
          }
        ))
  }
}

test fn witness_live_receipt_on_superseded_line_refuses_with_typed_cause() -> Bool {
  let victims = declared_node(id: "entry-graph-union-construction")
  count(victims) == 1
    && all(victims, n =>
      match receipt_node_match_verdict(
        r: receipt_fixture(node: "entry-graph-union-construction", digest: tchash(s: "3502539e920d9e40")),
        rn: n,
      ) {
        LiveReceiptOnSupersededLine { node } => node == n.node
        ReceiptMatchesNode => false
        ReceiptDoesNotMatchNode => false
      }
    )
}

test fn witness_superseded_revocation_does_not_reopen_active_frontier() -> Bool {
  !active_id_exists(id: tnid(s: "entry-graph-union-construction"))
    && match live_withheld_node_ids() {
      Absent => false
      Present { value: withheld } =>
        withheld |> any(w => w == tnid(s: "entry-graph-union-construction"))
    }
}

test fn witness_reopen_revocation_returns_node_to_active_frontier() -> Bool {
  let prior = live_acceptance_event_history()
  match project_live_acceptance_receipts(history: prior) {
    LiveAcceptanceReceiptsReplayRefused => false
    LiveAcceptanceReceiptsReplayed { live: live } => {
      let receipt = first(
        live |> filter(r => r.node == tnid(s: "namespace-occurrence-transport")),
      )
      let reopened = concat(prior, [
        AcceptanceRevoked {
          exact_prior_receipt: receipt,
          disposition: AcceptanceNodeReopensActiveFrontier {},
          reason: "fixture reopen revocation still returns the node to the active frontier" as NonEmptyStr,
          revoked_by: "operator" as NonEmptyStr,
          revoked_on: "2026-09-13" as NonEmptyStr,
        },
      ])
      match project_live_acceptance_receipts(history: reopened) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: reopened_live } => {
          let accepted = declared_roadmap_nodes()
            |> filter(n => node_accepted(receipts: reopened_live, rn: n))
            |> map(n => n.node)
          let withheld = node_ids_held_off_active_frontier(history: reopened)
          active_roadmap_nodes_for_accepted(accepted: accepted, withheld: withheld)
            |> any(n => n.node == tnid(s: "namespace-occurrence-transport"))
        }
      }
    }
  }
}

test fn witness_live_remains_superseded_revocations_join_superseded_lines() -> Bool {
  match remains_superseded_revocations_join(
    history: live_acceptance_event_history(),
    nodes: declared_roadmap_nodes(),
  ) {
    RemainsSupersededRevocationsJoined =>
      all(
        declared_node(id: "entry-graph-union-construction"),
        n => match n.line {
          SupersededLine { by: _, content: _ } => true
          TicketLine { done: _, ticket: _ } => false
          AuthoredLine { done: _, content: _ } => false
          PlainLine { content: _ } => false
          DerivableLine { prs: _, title: _, description: _ } => false
        },
      )
    RemainsSupersededRevocationOnNonSupersededNode { node: _ } => false
    RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
    RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
  }
}

test fn witness_remains_superseded_revocation_on_ticket_line_refuses() -> Bool {
  let victims = declared_node(id: "namespace-occurrence-transport")
  let prior = live_acceptance_event_history()
  match project_live_acceptance_receipts(history: prior) {
    LiveAcceptanceReceiptsReplayRefused => false
    LiveAcceptanceReceiptsReplayed { live: live } => {
  let receipt = first(
    live |> filter(r => r.node == tnid(s: "namespace-occurrence-transport")),
  )
  count(victims) == 1
    && all(victims, n =>
      match n.line {
        TicketLine { done: _, ticket: _ } => true
        SupersededLine { by: _, content: _ } => false
        AuthoredLine { done: _, content: _ } => false
        PlainLine { content: _ } => false
        DerivableLine { prs: _, title: _, description: _ } => false
      }
    )
    && match remains_superseded_revocations_join(
      history: concat(prior, [
        AcceptanceRevoked {
          exact_prior_receipt: receipt,
          disposition: AcceptanceNodeRemainsSuperseded {},
          reason: "fixture remains-superseded on a live ticket line must refuse" as NonEmptyStr,
          revoked_by: "operator" as NonEmptyStr,
          revoked_on: "2026-09-13" as NonEmptyStr,
        },
      ]),
      nodes: declared_roadmap_nodes(),
    ) {
      RemainsSupersededRevocationOnNonSupersededNode { node } =>
        node == tnid(s: "namespace-occurrence-transport")
      RemainsSupersededRevocationsJoined => false
      RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
      RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
    }
    }
  }
}

test fn witness_remains_superseded_revocation_on_undeclared_node_refuses() -> Bool {
  match remains_superseded_revocations_join(
    history: [
      AcceptanceRevoked {
        exact_prior_receipt: receipt_fixture(
          node: "not-a-declared-roadmap-node-for-join-red",
          digest: tchash(s: "0123456789abcdef"),
        ),
        disposition: AcceptanceNodeRemainsSuperseded {},
        reason: "fixture remains-superseded on an undeclared node must refuse" as NonEmptyStr,
        revoked_by: "operator" as NonEmptyStr,
        revoked_on: "2026-09-13" as NonEmptyStr,
      },
    ],
    nodes: declared_roadmap_nodes(),
  ) {
    RemainsSupersededRevocationOnUndeclaredNode { node } =>
      node == tnid(s: "not-a-declared-roadmap-node-for-join-red")
    RemainsSupersededRevocationsJoined => false
    RemainsSupersededRevocationOnNonSupersededNode { node: _ } => false
    RemainsSupersededRevocationOnAmbiguousDeclaredNode { node: _ } => false
  }
}

test fn witness_ambiguous_declared_node_refuses_remains_superseded_join() -> Bool {
  match join_remains_superseded_to_declared_line(
    node: tnid(s: "red-fixture"),
    nodes: [
      red_fixture(line: red_ticket(done: false), signoff: Unsigned),
      red_fixture(line: SupersededLine { by: "successor", content: "fixture" }, signoff: Unsigned),
    ],
  ) {
    RemainsSupersededRevocationOnAmbiguousDeclaredNode { node } =>
      node == tnid(s: "red-fixture")
    RemainsSupersededRevocationsJoined => false
    RemainsSupersededRevocationOnNonSupersededNode { node: _ } => false
    RemainsSupersededRevocationOnUndeclaredNode { node: _ } => false
  }
}

test fn witness_orphan_reopen_revocation_refuses_frontier_sets() -> Bool {
  match frontier_sets_projection(history: RoadmapAcceptanceEventHistoryLoaded { events: [
    AcceptanceRevoked {
      exact_prior_receipt: receipt_fixture(
        node: "namespace-occurrence-transport",
        digest: tchash(s: "0123456789abcdef"),
      ),
      disposition: AcceptanceNodeReopensActiveFrontier {},
      reason: "fixture orphan reopen revocation must refuse the frontier projection" as NonEmptyStr,
      revoked_by: "operator" as NonEmptyStr,
      revoked_on: "2026-09-13" as NonEmptyStr,
    },
  ] }) {
    FrontierSetsProjectionRefused { detail } =>
      detail == "acceptance-history-unreplayable"
    FrontierSetsProjected { accepted: _, withheld: _ } => false
  }
}

test fn witness_record_after_remains_superseded_on_superseded_line_refuses_frontier_sets() -> Bool {
  let prior = live_acceptance_event_history()
  match first(
    prior |> filter(e =>
      match e {
        AcceptanceRecorded { receipt: r } =>
          r.node == tnid(s: "entry-graph-union-construction")
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
          false
      }
    ),
  ) {
    Absent => false
    Present { value: recorded } =>
      match recorded {
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
          false
        AcceptanceRecorded { receipt } =>
          match frontier_sets_projection(history: RoadmapAcceptanceEventHistoryLoaded { events: concat(prior, [
            AcceptanceRecorded { receipt: receipt },
          ]) }) {
            FrontierSetsProjectionRefused { detail } =>
              detail == concat("live-receipt-on-superseded-line:", "entry-graph-union-construction")
            FrontierSetsProjected { accepted: _, withheld: _ } => false
          }
      }
  }
}

test fn witness_accepted_parents_precede_dependents() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      all(accepted, a => all(roadmap_parent_ids(edges: edges(), node: a), p => accepted |> any(x => x == p)))
  }
}

