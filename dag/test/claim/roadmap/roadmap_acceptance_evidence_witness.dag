// A pinned seed line as the route will see it: parsed by the operator-law parser, and the identity the log
// stores for it. Empty text means the line is not an acceptance the grammar admits — which the claims
// below take as a failure, never as a skip.
fn identity_of_seed_line(text: String) -> String {
  match roadmap_acceptance_line_of(text: text) {
    Absent => ""
    Present { value: e } => match e {
      AcceptanceRecorded { receipt: r } =>
        roadmap_acceptance_migration_identity(e: roadmap_acceptance_line_of_receipt(receipt: r))
      _ => ""
    }
  }
}

// The same parse, rendered back out by the operator law's own writer: byte-equality with the pinned line is
// what proves the closed set was built from the grammar that admitted these receipts in the first place.
fn rendered_seed_line(text: String) -> String {
  match roadmap_acceptance_line_of(text: text) {
    Absent => ""
    Present { value: e } => match e {
      AcceptanceRecorded { receipt: r } => roadmap_operator_acceptance_receipt_line(receipt: r)
      _ => ""
    }
  }
}

fn seeded_identity_exists(identity: String) -> Bool {
  any(roadmap_migration_acceptance_identities(), id => (id as String) == identity)
}

fn no_receipt() -> RoadmapAcceptanceReceipt? { none }

// The migration's first acceptance, as the route will hold it. Answers none only if the pinned line cannot
// be parsed at all, which the roster claim below fails on; the law claim falls back to a receipt that is
// NOT in the set, so a broken parse fails the "admitted" claim rather than passing it vacuously.
fn first_seed_receipt() -> RoadmapAcceptanceReceipt? {
  fold(seed_acceptance_lines(), init: no_receipt(), f: fn(acc, l) {
    match acc {
      Present { value: held } => Present { value: held }
      Absent => match roadmap_acceptance_line_of(text: l) {
        Absent => none
        Present { value: e } => match e {
          AcceptanceRecorded { receipt: r } => Present { value: r }
          _ => none
        }
      }
    }
  })
}

// How many entries of `hay` equal `needle`, by fold: no filter is imported here to hide a default.
fn occurrences(hay: List<String>, needle: String) -> Int {
  fold(hay, init: 0, f: fn(acc, x) { if x == needle { acc + 1 } else { acc } })
}

test fn the_migration_roster_is_the_pinned_seed_read_byte_for_byte() -> Bool {
  let roster = roadmap_migration_acceptance_identities()
  let pinned = seed_acceptance_lines()
  claim("the closed set and the pinned seed are both the seventeen acceptances the hand-committed file carried",
    length(roster) == 17 && length(pinned) == 17)
  && claim("no identity admits the same receipt twice, so no receipt enters under two spellings",
    fold(roster, init: true, f: fn(acc, a) { acc && occurrences(hay: roster, needle: a) == 1 }))
  && claim("every pinned seed line parses to an acceptance the grammar admits, and re-renders byte for byte, so the closed set was built from the grammar that wrote these receipts",
    fold(map(pinned, l => identity_of_seed_line(text: l) != "" && rendered_seed_line(text: l) == l),
      init: true, f: fn(acc, ok) { acc && ok }))
  && claim("every pinned seed line's identity is in the closed set, and every entry of the closed set is the identity of a pinned line: nothing copied wrong, nothing dropped, nothing invented",
    fold(map(pinned, l => seeded_identity_exists(identity: identity_of_seed_line(text: l))),
      init: true, f: fn(acc, ok) { acc && ok })
    && fold(map(roster, entry => any(pinned, l => identity_of_seed_line(text: l) == entry)),
      init: true, f: fn(acc, ok) { acc && ok }))
}

test fn the_absence_of_a_pull_request_is_admitted_only_for_a_migration_receipt() -> Bool {
  let seeded = match first_seed_receipt() {
    Absent => sample_receipt_on(node: "node-parse-of-the-pinned-line-broke", day: "2026-07-29")
    Present { value: r } => r
  }
  // The backdating the dated door let through: the migration's OWN receipt with one field changed — its
  // claimed day moved a day earlier — is no longer one of the migration's receipts, because membership is
  // the receipt's bytes and not a date its author chose.
  let backdated = RoadmapAcceptanceReceipt {
    node: seeded.node, criteria_digest: seeded.criteria_digest, red_control: seeded.red_control,
    handback: seeded.handback, accepted_by: seeded.accepted_by, accepted_on: "2026-07-28" as NonEmptyStr,
  }
  let other_node = RoadmapAcceptanceReceipt {
    node: "node-not-in-the-migration" as RoadmapNodeId, criteria_digest: seeded.criteria_digest,
    red_control: seeded.red_control, handback: seeded.handback, accepted_by: seeded.accepted_by,
    accepted_on: seeded.accepted_on,
  }
  let law_seeded = issue_command_acceptance_evidence_law(receipt: seeded, evidence: NoPullRequest)
  let law_backdated = issue_command_acceptance_evidence_law(receipt: backdated, evidence: NoPullRequest)
  let law_other_node = issue_command_acceptance_evidence_law(receipt: other_node, evidence: NoPullRequest)
  let law_fresh = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-absent-today", day: "2026-11-12"), evidence: NoPullRequest)
  let law_earned = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-earned-any-day", day: "2026-11-12"), evidence: earned(fact_set()))
  claim("a receipt that IS one of the migration's own is admitted with no pull request — the whole case the closed set exists for",
    match law_seeded { Absent => true, Present { value: _ } => false })
  && claim("the same receipt one day EARLIER refuses: a date typed at a command cannot join the set, which is exactly the hole the dated door left open — an acceptance issued today with an earlier-looking day",
    match law_backdated { Present { value: _ } => true, Absent => false })
  && claim("the same receipt on another node refuses: membership is the whole receipt, node included",
    match law_other_node { Present { value: _ } => true, Absent => false })
  && claim("an absence dated today refuses, and the refusal says where the door is, so the operator is not left guessing",
    match law_fresh {
      Present { value: why } => string_contains(s: why, pattern: "roadmap_migration_acceptance_identities")
      Absent => false })
  && claim("an acceptance earned by a pull request is admitted on any day — the door is on the absence, not on the acceptance",
    match law_earned { Absent => true, Present { value: _ } => false })
}

// Does the door REFUSE an absence dated `day`? Any day that is not a calendar day must answer true here.
fn absence_refuses(day: String) -> Bool {
  match issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-form", day: day), evidence: NoPullRequest) {
    Absent => false
    Present { value: _ } => true
  }
}

// The migration's own receipt with ONE field bent to `day`. Its membership of the closed set is what makes
// these day arms discriminating: a bent receipt is refused, and the baseline beside it is admitted, so the
// refusal is that field and not the door.
fn receipt_with_day(receipt: RoadmapAcceptanceReceipt, day: String) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: receipt.node, criteria_digest: receipt.criteria_digest, red_control: receipt.red_control,
    handback: receipt.handback, accepted_by: receipt.accepted_by, accepted_on: day as NonEmptyStr,
  }
}

// The pinned seed's first acceptance, or a receipt that is certainly NOT in the closed set when the pinned
// line cannot be parsed — so a broken fixture fails the admitting claims instead of passing them.
fn the_seeded_receipt() -> RoadmapAcceptanceReceipt {
  match first_seed_receipt() {
    Absent => sample_receipt_on(node: "node-parse-of-the-pinned-line-broke", day: "2026-07-29")
    Present { value: r } => r
  }
}

// THE DAY IS A CALENDAR DAY, NOT A TEXT THAT SORTS BEFORE ONE. This is where the day law earns its keep: an
// acceptance carrying no pull request used to be admitted by the receipt's own day, compared with
// string_compare_canonical against "2026-11-01", so every spelling below sorted before it and was ADMITTED
// while naming no day at all — a self-attested string judged against a date-shaped literal, which reads as a
// hard rule and fails open, the shape gunbc.design_argument::fail_closed calls a hard reject ("a diff landing
// a silent widen … or escape hatch"). Two things closed that: the door became a closed set over the receipt's
// bytes (roadmap_migration_acceptance_identities), and the day is read through the checked constructor
// gunbc.roadmap.roadmap_event_log roadmap_acceptance_day, whose Absent refuses here, on both arms.
//
// The set is chosen to discriminate, not to decorate:
// - "0", "1999", "2025-13-99" — too short for the form, or beyond any calendar. A text compare admitted all three.
// - "2026-02-30", "2023-02-29" — the right shape, the wrong calendar. A pattern would pass them; the ONE
//   day-in-month rule (extdeps.units.iso8601_calendar, reached through the constructor) refuses them, and the
//   leap-day control two claims below is admitted — so the refusal is the calendar, not a regex.
// - "2026-2-03", "2026-02-3" — a real day in a form that is not fixed width. parse_int reads "2" and "3"
//   happily, so each field is round-tripped through the calendar authority's own two-digit renderer.
// - "+026-11-03" — a signed year: parse_int reads it as 26, and the four-digit year requirement refuses it.
// - "banana--" — ten characters, dashes in place, nothing numeric.
test fn the_absence_refuses_a_day_that_is_not_a_calendar_day() -> Bool {
  claim("'0' refuses: a text that sorts before every date is not a date", absence_refuses(day: "0"))
    && claim("'1999' refuses: four digits, no month, no day", absence_refuses(day: "1999"))
    && claim("'2025-13-99' refuses: month 13 and day 99 are outside the calendar", absence_refuses(day: "2025-13-99"))
    && claim("'2026-02-30' refuses: the shape is right and the day is not", absence_refuses(day: "2026-02-30"))
    && claim("'2023-02-29' refuses: 2023 is not a leap year", absence_refuses(day: "2023-02-29"))
    && claim("'2026-2-03' refuses: the month must be two digits", absence_refuses(day: "2026-2-03"))
    && claim("'2026-02-3' refuses: the day must be two digits", absence_refuses(day: "2026-02-3"))
    && claim("'+026-11-03' refuses: a signed year is not a four-digit year", absence_refuses(day: "+026-11-03"))
    && claim("'banana--' refuses: dashes in the right places do not make a day", absence_refuses(day: "banana--"))
    && claim("a well-formed day is not itself the reason: the migration's own receipt — a real calendar day, no pull request — is admitted, which is what makes the nine refusals above about the day",
      match issue_command_acceptance_evidence_law(receipt: the_seeded_receipt(), evidence: NoPullRequest) {
        Absent => true
        Present { value: _ } => false
      })
}

// THE DAY IS CHECKED ON BOTH ARMS. A pull-request-evidenced acceptance carries a real merge fact, and a merge fact
// is not a substitute for a day: the fold reads the receipt's day, and an event whose accepted_on is not a calendar
// day is refused there (see test.claim.roadmap.roadmap_event_log_witness). The door says so where the operator can
// act on it — at the command — rather than letting the record land and the fold stop believing it afterwards.
test fn the_pull_request_arm_still_requires_a_real_day() -> Bool {
  let bad = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-earned-bad", day: "2025-13-99"), evidence: earned(fact_set()))
  let good = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-earned-good", day: "2026-11-03"), evidence: earned(fact_set()))
  claim("an evidenced acceptance dated with a false day refuses too",
    match bad { Present { value: _ } => true, Absent => false })
    && claim("the same evidence on a real day is admitted, so the refusal is the day and not the arm",
      match good { Absent => true, Present { value: _ } => false })
}

// HOW STRICT THE DAY FORM IS ABOUT WHAT A HUMAN MAY TYPE. These are pinned on the pull-request arm, where
// membership of the closed set cannot be what refused: the same receipt is admitted on its own day and
// refused for a five-digit year, for a leading space, for a trailing one — so the refusals are the form,
// nothing else. The constructor does not trim, and the log is the writer of this field: a stored space is a
// malformed field kept, re-emitted and hashed into the event id as written, so it is refused at the command
// rather than tolerated.
//
// A note on why no claim compares text order to calendar order: once the constructor admits only the
// fixed-width canonical form, the collation order and the day-count order of any two admitted days are the
// same order, so no input can tell those implementations apart.
// The two questions this claim asks, at module scope: a claim body in this tree holds no
// declarations (nothing in dag/test/claim declares a fn inside a test fn), so the helpers that
// turn the door's String? into a yes/no live beside the claim, one answer per arm.
fn admitted(evidence: AcceptancePrEvidence, receipt: RoadmapAcceptanceReceipt) -> Bool {
  match issue_command_acceptance_evidence_law(receipt: receipt, evidence: evidence) {
    Absent => true
    Present { value: _ } => false
  }
}

fn refused(evidence: AcceptancePrEvidence, receipt: RoadmapAcceptanceReceipt) -> Bool {
  match issue_command_acceptance_evidence_law(receipt: receipt, evidence: evidence) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn the_day_form_is_strict_about_what_a_human_may_type() -> Bool {
  let seeded = the_seeded_receipt()
  claim("the migration receipt on its own day, with a pull request, is admitted — the baseline the next arms bend",
    admitted(evidence: earned(fact_set()), receipt: seeded))
    && claim("'19999-11-03' refuses: a five-digit year is not this form, even though it reads early as text",
      refused(evidence: earned(fact_set()), receipt: receipt_with_day(receipt: seeded, day: "19999-11-03")))
    && claim("surrounding space refuses: the field is stored as written, so a day valid only after trimming is refused",
      refused(evidence: earned(fact_set()), receipt: receipt_with_day(receipt: seeded, day: " 2026-07-29"))
      && refused(evidence: earned(fact_set()), receipt: receipt_with_day(receipt: seeded, day: "2026-07-29 ")))
    && claim("the same day without the space is admitted, so those two refusals are the space and nothing else",
      admitted(evidence: earned(fact_set()), receipt: receipt_with_day(receipt: seeded, day: "2026-07-29")))
    && claim("and the day an absence is admitted on is the migration's day, whole: bend it by one day and the closed set no longer knows the receipt",
      refused(evidence: NoPullRequest, receipt: receipt_with_day(receipt: seeded, day: "2026-07-28")))
}



// THE MIGRATION VERIFIER, facet by facet. Each check is its own named claim, because a single Bool over
// seven assertions says only that something is wrong; the refusal the runbook prints has to say WHICH.
// The verifier compares COMPLETE canonical facts (roadmap_acceptance_receipt_members), counts them as a
// multiset, checks closedness in both directions against the manifest's own replay, and reads the retired
// roster. `node_verified` is the node every scenario here accepts; `manifest_replay_closed` is the
// closedness the manifest's live receipts already imply for it.

fn verifier_events_accepted() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRecorded { receipt: sample_receipt("node-multiset") }] as List<RoadmapAcceptanceEvent>
}

fn verifier_events_swapped() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRecorded { receipt: sample_receipt_other_executed_day("node-multiset") }] as List<RoadmapAcceptanceEvent>
}

fn verifier_events_revoked_alone() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRevoked {
    exact_prior_receipt: sample_receipt("node-multiset"),
    disposition: AcceptanceNodeRemainsSuperseded,
    reason: "the floor cut retired this work's subject" as NonEmptyStr,
    revoked_by: "briansrls" as NonEmptyStr,
    revoked_on: "2026-09-13" as NonEmptyStr,
  }] as List<RoadmapAcceptanceEvent>
}

fn verifier_closed() -> List<String> { ["node-multiset"] }
fn verifier_nothing() -> List<String> { [] }

test fn a_migration_verifier_agrees_when_the_log_holds_what_the_manifest_names() -> Bool {
  claim("agreement between the manifest and the log reports no problem at all",
    count(roadmap_acceptance_migration_problems(
      wanted: verifier_events_accepted(), held: verifier_events_accepted(),
      closed_nodes: verifier_closed(), not_retired: verifier_nothing())) == 0)
}

test fn a_migration_verifier_refuses_swapped_evidence_on_both_sides_of_the_difference() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_swapped(),
    closed_nodes: verifier_closed(), not_retired: verifier_nothing())
  claim("swapped evidence refuses on both sides of the difference", count(problems) == 2
    && any(problems, pr => string_contains(s: pr, pattern: "expected 1, the log holds 0"))
    && any(problems, pr => string_contains(s: pr, pattern: "expected 0, the log holds 1")))
}

test fn a_migration_verifier_counts_a_fact_the_manifest_names_twice_against_one_copy() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: concat(verifier_events_accepted(), verifier_events_accepted()), held: verifier_events_accepted(),
    closed_nodes: verifier_closed(), not_retired: verifier_nothing())
  claim("a fact the manifest names twice against one copy in the log reports its counts",
    count(problems) >= 1 && any(problems, pr => string_contains(s: pr, pattern: "expected 2, the log holds 1")))
}

test fn a_migration_verifier_refuses_an_acceptance_the_log_lost_with_its_closedness() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_nothing_events(),
    closed_nodes: verifier_nothing(), not_retired: verifier_nothing())
  claim("an acceptance the log lost refuses as a missing fact and an unmet closedness",
    count(problems) == 2 && any(problems, pr => string_contains(s: pr, pattern: "expected 1, the log holds 0"))
    && any(problems, pr => string_contains(s: pr, pattern: "node-multiset"))
    && any(problems, pr => string_contains(s: pr, pattern: "the log does not say so")))
}

// The empty held-list typed once, so a reader cannot mistake a dropped argument for a typo.
fn verifier_nothing_events() -> List<RoadmapAcceptanceEvent> { [] as List<RoadmapAcceptanceEvent> }

test fn a_migration_verifier_refuses_a_closed_node_the_manifest_never_accepted() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_accepted(),
    closed_nodes: concat(verifier_closed(), ["node-the-manifest-never-accepted"]), not_retired: verifier_nothing())
  claim("a node the log calls closed that the manifest never accepted refuses",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "node-the-manifest-never-accepted")))
}

test fn a_migration_verifier_refuses_a_manifest_that_does_not_replay() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_revoked_alone(), held: verifier_events_revoked_alone(),
    closed_nodes: verifier_nothing(), not_retired: verifier_nothing())
  claim("a manifest that does not replay REFUSES rather than certifying an empty expectation",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "does not replay")))
}

test fn a_migration_verifier_refuses_a_retired_node_the_log_does_not_hold_retired() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_accepted(),
    closed_nodes: verifier_closed(), not_retired: ["node-never-retired"])
  claim("a node the runbook claims retired that the log does not hold retired refuses",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "node-never-retired")))
}

// ── THE LOG'S BYTES ARE THE LINE'S BYTES ────────────────────────────────────────────────
// THE DEFECT THIS ROW EXISTS TO CATCH, witnessed where it can be caught without a carrier. An acceptance is
// written by the log's own canonical emitter and read back by the log's own decoder, and the receipt must
// come home intact. When the receipt's members were flattened into the event, its own "node" sat beside the
// event's "node", json_object_unique_member refused the object and the log could write an acceptance it could
// never read — the wet driver met it as an append that succeeded and a read that refused "event has no node".
// Nesting the receipt under "receipt" / "exact_prior_receipt" is what makes the bytes readable; this row is
// the claim that says so, and it fails if anyone flattens them again.
fn one_grammar_event(kind: RoadmapEventKind) -> RoadmapEvent {
  RoadmapEvent {
    node: "node-one-grammar" as NonEmptyStr as RoadmapNodeId,
    author: opr_principal(),
    parent: Absent,
    kind: kind,
    recorded_at: "2026-11-03T09:00:00Z",
  }
}

fn receipt_facts(receipt: RoadmapAcceptanceReceipt) -> String {
  serialize_json(v: json_object(members: roadmap_acceptance_receipt_members(r: receipt)))
}

test fn an_acceptance_event_written_by_the_log_reads_back_with_its_receipt_intact() -> Bool {
  let receipt = sample_receipt("node-one-grammar")
  let text = roadmap_event_wire_text(env: roadmap_event_envelope(e: one_grammar_event(
    kind: AcceptanceRecordedEvent { receipt: receipt, evidence: NoPullRequest })))
  match roadmap_event_decode(text: text) {
    RoadmapEventUndecodable { reason: _ } => false
    RoadmapEventDecoded { envelope: env } => match env.event.kind {
      AcceptanceRecordedEvent { receipt: back, evidence: _ } => receipt_facts(receipt: back) == receipt_facts(receipt: receipt)
      _ => false
    }
  }
}

// The revocation is the sharper case: it names the receipt it revokes (the live receipt, or the fold refuses
// it), carries its disposition as the tagged sub-fact it is, and keeps the reason that says why. Every one of
// those has to survive the bytes, because the standing the node ends in is read from them and not from what
// was intended when they were written.
test fn an_acceptance_revocation_reads_back_naming_the_receipt_it_revokes() -> Bool {
  let prior = sample_receipt("node-one-grammar")
  let text = roadmap_event_wire_text(env: roadmap_event_envelope(e: one_grammar_event(kind: AcceptanceRevokedEvent {
    receipt: prior,
    disposition: AcceptanceNodeRemainsSuperseded {},
    revoked_by: "briansrls",
    revoked_on: "2026-11-05",
    reason: "The floor cut retired this work's subject",
  })))
  match roadmap_event_decode(text: text) {
    RoadmapEventUndecodable { reason: _ } => false
    RoadmapEventDecoded { envelope: env } => match env.event.kind {
      AcceptanceRevokedEvent { receipt: back, disposition: _, revoked_by: by, revoked_on: on, reason: why } =>
        receipt_facts(receipt: back) == receipt_facts(receipt: prior)
          && (by as String) == "briansrls" && (on as String) == "2026-11-05"
          && string_contains(s: why as String, pattern: "floor cut")
      _ => false
    }
  }
}

// THE ONE GRAMMAR, CHECKED AGAINST THE TRUSTED LAW. The receipt the log nests, wrapped in the acceptance
// line's envelope, must parse under the carrier's own parser — the native seed law that read the eighteen
// lines and that the migration replays. This is the row that fails if the log and the line ever spell the
// same fact differently: the variant words, the nesting, the digest and the member order are the parser's,
// because the parser is the law and the log is its newest reader, not a second authority beside it.
test fn the_receipt_the_log_nests_is_the_line_the_carrier_parser_admits() -> Bool {
  let receipt = sample_receipt("node-one-grammar")
  let line = serialize_json(v: json_object(members: [
    json_kv(key: "variant", value: json_string(s: "acceptance_recorded")),
    json_kv(key: "receipt", value: json_object(members: roadmap_acceptance_receipt_members(r: receipt))),
  ]))
  match parse_roadmap_acceptance_event_history_carrier(text: join([line, ""], "\n")) {
    RoadmapAcceptanceEventHistoryParseRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryParsed { events: parsed } =>
      count(parsed) == 1 && match parsed {
        Cons { head: AcceptanceRecorded { receipt: admitted }, tail: _ } =>
          receipt_facts(receipt: admitted) == receipt_facts(receipt: receipt)
        Empty => false
        _ => false
      }
  }
}
