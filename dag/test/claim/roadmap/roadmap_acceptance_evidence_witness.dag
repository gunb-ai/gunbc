module test.claim.roadmap.roadmap_acceptance_evidence_witness

// EXECUTING WITNESS for the acceptance law of the roadmap event log — the eleven claims this PR added, run
// here rather than in test.claim.roadmap.roadmap_operator_close_retire_witness, and here is why in one
// paragraph. Those claims were first written into the close/retire witness, whose twenty-six claims and
// thirty-odd imports include three files the seed probe itself cannot resolve (`roadmap_authority`,
// `roadmap_serve`, `roadmap_belt_actuate`); adding them pushed that module's whole-graph resolve past the
// point where it stops after `compile.normalize` at any cap tried here, so NEITHER the entry probe NOR
// `gunbc run --claim-run` could execute them — and a witness that cannot run is decoration
// (gunbc.rung_drop.edited_bin_witness_wet_rows_not_executed_by_ci: rows no lane executes are not evidence).
// Everything here is decided BEFORE a byte is written — the operation keys, the pull-request door and the
// migration comparison read only values — so the graph these claims need is the event log, its command
// route and the CLI edge, nothing else: they resolve, they run under `--claim-run`, and the fast lane can
// check them. What only the carrier can answer (that a committed acceptance is really answered by its own
// recording after the head moved, that a claimed second retirement really refuses, that a refusal really
// wrote nothing) needs a real throwaway Git remote and lives in the repo's manual-driver idiom:
// `test.manual.issue_command_wet issue_command_acceptance_wet`, whose header documents the fixture and
// whose executed receipt this PR carries. The close route's claims stayed where they were, with the reader
// they assert on (`roadmap_operator_close_history`).
//
// What they prove by RUNNING:
//   ONE OPERATION, ONE OUTCOME — the key a retry recomputes is the FACT (the node, the kind of fact and
//           the receipt's digest) and never the caller's parent guess, while the retried COMMAND is not the
//           same command once the head has moved: that pairing is exactly why the carrier answers a retry
//           from its operation receipt and may not decide one by command identity. A retirement is keyed the
//           same way, so a replay of the first retirement meets its own recording and a second retirement
//           naming a different reason is a different operation the admission law refuses outright.
//   EVIDENCE — the pull request an acceptance was earned by is one typed fact
//           (gunbc.roadmap.roadmap_event_log AcceptancePrEvidence): half a pull request is refused where
//           the command line's three arguments are read, because it is not a value of the type; the
//           absence is admissible only for an acceptance recorded before the dated cutoff — the one-time
//           migration's case — and the refusal names both the cutoff and the receipt's own day.
//   VERIFIER — the migration gate's seven facets, one named claim each, because the runbook prints WHICH
//           problem it found: agreement reports nothing; swapped evidence refuses on BOTH sides of the
//           difference; a fact the manifest names twice against one copy reports its counts; an acceptance
//           the log lost refuses with the closedness it carried; a node the log closes that the manifest
//           never accepted refuses; a manifest that does not replay REFUSES rather than certifying an empty
//           expectation; and a claimed retirement the log does not hold retired refuses. The comparison
//           reads complete canonical facts, so a swapped or missing field cannot certify a different history.

import std.types { String, Bool, NonEmptyStr, List }
import std.optional { Present, Absent }
import std.algebra { string_contains }
import gunbc.roadmap.roadmap_event_carrier { roadmap_event_same_command }
import gunbc.roadmap.roadmap_issue_command {
  AcceptNode, IssueCommandSubject, issue_command_event, issue_command_acceptance_evidence_law,
}
import gunbc.roadmap.roadmap_event_cli {
  roadmap_retirement_operation_identity, roadmap_acceptance_pr_evidence_from_args,
  roadmap_acceptance_operation_identity, roadmap_acceptance_receipt_digest_text, BuildAcceptCommand,
}
import gunbc.roadmap.roadmap_model {
  RoadmapNodeId, RoadmapAcceptanceReceipt, RoadmapAcceptanceEvent, AcceptanceRecorded, AcceptanceRevoked,
  AcceptanceNodeRemainsSuperseded, roadmap_criteria_digest,
}
import gunbc.roadmap.roadmap_status { TicketFields, TicketUpdate, RedControlExecuted, HandbackDelivered }
import gunbc.roadmap.roadmap_event_log {
  AcceptancePrEvidence, NoPullRequest, EarnedByPullRequest,
  roadmap_acceptance_pr_evidence_cutoff, roadmap_acceptance_migration_problems, EventPrincipalAuthenticated,
}
import gunbc.principal_projection { PrincipalRef }

// THE PULL REQUEST AN ACCEPTANCE WAS EARNED BY, spelled once as the typed fact. A LOCAL fact record: this
// module deliberately does not import the close route (gunbc.roadmap.roadmap_operator_acceptance) — its
// claims are about what the log admits and how it folds, and the close route's own claims live in
// test.claim.roadmap.roadmap_operator_close_retire_witness beside the reader they assert on.
type WitnessPrFacts {
  url: NonEmptyStr
  merged_at: NonEmptyStr
  head: NonEmptyStr
}

fn fact_set() -> WitnessPrFacts {
  WitnessPrFacts {
    url: "https://github.com/gunb-ai/gunbc/pull/16100" as NonEmptyStr,
    merged_at: "2026-11-03T10:00:00Z" as NonEmptyStr,
    head: "abc123def456" as NonEmptyStr,
  }
}

// THE PULL REQUEST THE CLOSE EARNED, spelled once as the typed fact the command carries — the url, the
// merge time and the head arrive together because the type says they do
// (gunbc.roadmap.roadmap_event_log AcceptancePrEvidence).
fn earned(facts: WitnessPrFacts) -> AcceptancePrEvidence {
  EarnedByPullRequest {
    pr_url: facts.url as NonEmptyStr, merged_at: facts.merged_at as NonEmptyStr, head_sha: facts.head as NonEmptyStr,
  }
}

// The ticket whose criteria digest rides the receipt. Local for the same reason as the facts above.
fn witness_ticket() -> TicketFields {
  TicketFields {
    headline: "Acceptance evidence witness", brief: "b", displaced_cost: "d", current_state: "c",
    first_slice: "f", red_control: "r", out_of_scope: "o", handback: "h",
    updates: [TicketUpdate { on: "2026-11-03", note: "n" }],
    authored_on: "2026-11-03", last_verified_on: "",
  }
}

// The witness voice: a named assertion, checked by its own line. The label documents the row;
// the boolean is what the runner reports.
fn claim(label: String, satisfied: Bool) -> Bool { satisfied }

// ── THE WIRE LINE IS CANONICAL AND PARSLES UNDER THE SEED'S OWN LAW ──────────────────────────────
fn sample_receipt(node: String) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: node as NonEmptyStr as RoadmapNodeId,
    criteria_digest: roadmap_criteria_digest(t: witness_ticket()),
    red_control: RedControlExecuted {
      witness_module: "test/claim/roadmap/roadmap_acceptance_evidence_witness" as NonEmptyStr,
      witness_fn: "witness_executes" as NonEmptyStr,
      executed_on: "2026-11-03",
    },
    handback: HandbackDelivered { first_artifact: "commit abc", further_artifacts: [] as List<NonEmptyStr> },
    accepted_by: "briansrls" as NonEmptyStr,
    accepted_on: "2026-11-03" as NonEmptyStr,
  }
}
// The operator's receipt on a chosen acceptance day. The day is what the pull-request evidence law turns
// on, so the witness — and the migration — need a receipt dated on either side of it.
fn sample_receipt_on(node: String, day: String) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: node as NonEmptyStr as RoadmapNodeId,
    criteria_digest: roadmap_criteria_digest(t: witness_ticket()),
    red_control: RedControlExecuted {
      witness_module: "test/claim/roadmap/roadmap_acceptance_evidence_witness" as NonEmptyStr,
      witness_fn: "witness_executes" as NonEmptyStr,
      executed_on: "2026-11-03",
    },
    handback: HandbackDelivered { first_artifact: "commit abc", further_artifacts: [] as List<NonEmptyStr> },
    accepted_by: "briansrls" as NonEmptyStr,
    accepted_on: day as NonEmptyStr,
  }
}
// The same receipt with ONE piece of evidence changed: the day its red control ran. The standing folds
// identically either way — which is exactly why the migration verifier must compare the whole fact and
// not the two fields that happen to decide a standing.
fn sample_receipt_other_executed_day(node: String) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: node as NonEmptyStr as RoadmapNodeId,
    criteria_digest: roadmap_criteria_digest(t: witness_ticket()),
    red_control: RedControlExecuted {
      witness_module: "test/claim/roadmap/roadmap_acceptance_evidence_witness" as NonEmptyStr,
      witness_fn: "witness_executes" as NonEmptyStr,
      executed_on: "2026-11-06",
    },
    handback: HandbackDelivered { first_artifact: "commit abc", further_artifacts: [] as List<NonEmptyStr> },
    accepted_by: "briansrls" as NonEmptyStr,
    accepted_on: "2026-11-03" as NonEmptyStr,
  }
}
// ── THE RETIREMENT FOLD: ANY STANDING, HONEST, FINAL ─────────────────────────────────────────────
fn opr_principal() -> EventPrincipalAuthenticated {
  EventPrincipalAuthenticated { ref: PrincipalRef {
    authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: "sub-opr" as NonEmptyStr,
  } }
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// THE MIGRATION RESUMES, AND THE VERIFIER PRESERVES FACTS (review 92815 findings 1 and 2, review 92911).
// The runbook migrates the operator's recorded acceptances and retirements command by command, and an
// interrupted run is resumed by replaying its commands; the verifier then certifies that the migrated log
// holds what the exported manifest named. Each facet below is its own named claim, so a failing run names
// the facet rather than saying only that something is wrong.
// The retry law, the retirement key and the pull-request door are DECIDED before any byte is written, so
// they are witnessed as pure claims. What only the carrier can answer — that a committed acceptance really
// is answered by its own recording after the head moved, that a claimed second retirement really refuses,
// that a refusal really wrote nothing — is the manual driver's job, because answering it needs a real
// throwaway Git remote: `test.manual.issue_command_wet issue_command_acceptance_wet`, whose header
// documents the fixture and whose executed receipt this PR carries. Splitting the two this way is what the
// repo already does for every route that touches Git (see `test.manual.snapshot_census_wet`), and it is
// what makes these claims runnable at all: no lane executes wet claim rows
// (gunbc.rung_drop.edited_bin_witness_wet_rows_not_executed_by_ci), while a pure claim is checked by the
// fast lane and by `--claim-run` on any workstation.

test fn a_retried_acceptance_is_the_same_operation_though_it_is_not_the_same_command() -> Bool {
  let node = "node-retry-head-moved"
  let receipt = sample_receipt(node)
  let key = roadmap_acceptance_operation_identity(
    node: node, choice: BuildAcceptCommand { receipt: receipt, evidence: earned(fact_set()) })
  let first = AcceptNode {
    subject: IssueCommandSubject { node: node as NonEmptyStr as RoadmapNodeId, author: opr_principal(),
      operation: "op-retry-head-moved" as NonEmptyStr, expected: none },
    receipt: receipt, evidence: earned(fact_set()) }
  let retry = AcceptNode {
    subject: IssueCommandSubject { node: node as NonEmptyStr as RoadmapNodeId, author: opr_principal(),
      operation: "op-retry-head-moved" as NonEmptyStr,
      expected: Present { value: "5f4c0d2b9a1e7c335f4c0d2b9a1e7c335f4c0d2b9a1e7c335f4c0d2b9a1e7c33" as NonEmptyStr } },
    receipt: receipt, evidence: earned(fact_set()) }
  claim("the operation key is the FACT — the node, the kind of fact and the receipt's digest — and never the caller's parent guess",
    string_contains(s: key, pattern: node) && string_contains(s: key, pattern: "-acceptance-")
      && string_contains(s: key, pattern: roadmap_acceptance_receipt_digest_text(receipt: receipt))
      && !string_contains(s: key, pattern: "op-retry-head-moved"))
  && claim("the retried command is NOT the same command once the head has moved, which is why the carrier answers a retry from its operation receipt and never from command identity",
    !roadmap_event_same_command(
      a: issue_command_event(command: first, recorded_at: "2026-11-04T08:00:00Z"),
      b: issue_command_event(command: retry, recorded_at: "2026-11-04T08:00:02Z")))
  && claim("two different receipts on one node are two operations, so a node is not accepted once in its whole life",
    key != roadmap_acceptance_operation_identity(node: node,
      choice: BuildAcceptCommand { receipt: sample_receipt_on(node: node, day: "2026-11-06"), evidence: earned(fact_set()) }))
}

test fn a_retired_node_is_retired_once_because_its_key_is_the_reason_not_the_call() -> Bool {
  let node = "node-retirement-identity"
  let reason = "the row was deleted as an authored row; its work moved"
  let key = roadmap_retirement_operation_identity(node: node, reason: reason)
  claim("the key a retried retirement recomputes names the node and the kind of fact, so it meets its own operation receipt and answers the first recording",
    string_contains(s: key, pattern: node) && string_contains(s: key, pattern: "-retirement-"))
  && claim("the key holds the reason's DIGEST, not the caller's sentence, so a replay from a different shell keeps the same key",
    !string_contains(s: key, pattern: "authored row"))
  && claim("a DIFFERENT retirement of the same node is a different key, which is what lets the admission law refuse it outright instead of absorbing it",
    key != roadmap_retirement_operation_identity(node: node, reason: "a second retirement naming a different reason"))
}

// Half a pull request is refused where the three arguments are READ, by name of what is missing; a whole
// one converts; an absence is the one-time migration's case, admitted only for a receipt the operator
// recorded before the cutoff, and the refusal names both the cutoff and the receipt's own day.
test fn half_a_pull_request_is_refused_where_the_arguments_are_read() -> Bool {
  let facts = fact_set()
  let half = roadmap_acceptance_pr_evidence_from_args(url: facts.url as String, at: "", sha: "")
  let shape = roadmap_acceptance_pr_evidence_from_args(url: "https://github.com/gunb-ai/gunbc/pull/16100", at: " ", sha: "abc123def456")
  let none_conv = roadmap_acceptance_pr_evidence_from_args(url: "", at: "", sha: "")
  let all_conv = roadmap_acceptance_pr_evidence_from_args(url: facts.url as String, at: facts.merged_at as String, sha: facts.head as String)
  claim("half a pull request is refused where the three arguments are read",
    match half { Absent => true, Present { value: _ } => false })
  && claim("a pull request that never merged is refused where they are read",
    match shape { Absent => true, Present { value: _ } => false })
  && claim("three empty arguments are the ONE admissible absence, not three refusals",
    match none_conv { Present { value: NoPullRequest } => true, _ => false })
  && claim("three complete arguments fold into one typed fact",
    match all_conv { Present { value: EarnedByPullRequest { pr_url: _, merged_at: _, head_sha: _ } } => true, _ => false })
}

test fn the_absence_of_a_pull_request_is_admitted_only_before_the_cutoff() -> Bool {
  let cutoff = roadmap_acceptance_pr_evidence_cutoff()
  let before = "2026-07-29"
  let after = "2026-11-03"
  let door_before = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-before", day: before), evidence: NoPullRequest)
  let door_after = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-after", day: after), evidence: NoPullRequest)
  let door_earned = issue_command_acceptance_evidence_law(
    receipt: sample_receipt_on(node: "node-door-earned", day: after), evidence: earned(fact_set()))
  claim("before the cutoff an absence is admitted, because the eighteen recorded acceptances carried none",
    match door_before { none => true, Present { value: _ } => false })
  && claim("on or after it an absence refuses, and the refusal names the cutoff AND the receipt's own day so the operator can find the row",
    match door_after {
      Present { value: why } => string_contains(s: why, pattern: cutoff) && string_contains(s: why, pattern: after)
      none => false })
  && claim("an acceptance earned by a pull request is admitted on any day — the door is on the absence, not on the acceptance",
    match door_earned { none => true, Present { value: _ } => false })
}


// THE MIGRATION VERIFIER, facet by facet. Each check is its own named claim, because a single Bool over
// seven assertions says only that something is wrong; the refusal the runbook prints has to say WHICH.
// The verifier compares COMPLETE canonical facts (roadmap_acceptance_receipt_members), counts them as a
// multiset, checks closedness in both directions against the manifest's own replay, and reads the retired
// roster. `node_verified` is the node every scenario here accepts; `manifest_replay_closed` is the
// closedness the manifest's live receipts already imply for it.

fn verifier_events_accepted() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRecorded { receipt: sample_receipt("node-multiset") }] as List<RoadmapAcceptanceEvent>
}

fn verifier_events_swapped() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRecorded { receipt: sample_receipt_other_executed_day("node-multiset") }] as List<RoadmapAcceptanceEvent>
}

fn verifier_events_revoked_alone() -> List<RoadmapAcceptanceEvent> {
  [AcceptanceRevoked {
    exact_prior_receipt: sample_receipt("node-multiset"),
    disposition: AcceptanceNodeRemainsSuperseded,
    reason: "the floor cut retired this work's subject" as NonEmptyStr,
    revoked_by: "briansrls" as NonEmptyStr,
    revoked_on: "2026-09-13" as NonEmptyStr,
  }] as List<RoadmapAcceptanceEvent>
}

fn verifier_closed() -> List<String> { ["node-multiset"] }
fn verifier_nothing() -> List<String> { [] }

test fn a_migration_verifier_agrees_when_the_log_holds_what_the_manifest_names() -> Bool {
  claim("agreement between the manifest and the log reports no problem at all",
    count(roadmap_acceptance_migration_problems(
      wanted: verifier_events_accepted(), held: verifier_events_accepted(),
      closed_nodes: verifier_closed(), not_retired: verifier_nothing())) == 0)
}

test fn a_migration_verifier_refuses_swapped_evidence_on_both_sides_of_the_difference() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_swapped(),
    closed_nodes: verifier_closed(), not_retired: verifier_nothing())
  claim("swapped evidence refuses on both sides of the difference", count(problems) == 2
    && any(problems, pr => string_contains(s: pr, pattern: "expected 1, the log holds 0"))
    && any(problems, pr => string_contains(s: pr, pattern: "expected 0, the log holds 1")))
}

test fn a_migration_verifier_counts_a_fact_the_manifest_names_twice_against_one_copy() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: concat(verifier_events_accepted(), verifier_events_accepted()), held: verifier_events_accepted(),
    closed_nodes: verifier_closed(), not_retired: verifier_nothing())
  claim("a fact the manifest names twice against one copy in the log reports its counts",
    count(problems) >= 1 && any(problems, pr => string_contains(s: pr, pattern: "expected 2, the log holds 1")))
}

test fn a_migration_verifier_refuses_an_acceptance_the_log_lost_with_its_closedness() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_nothing_events(),
    closed_nodes: verifier_nothing(), not_retired: verifier_nothing())
  claim("an acceptance the log lost refuses as a missing fact and an unmet closedness",
    count(problems) == 2 && any(problems, pr => string_contains(s: pr, pattern: "expected 1, the log holds 0"))
    && any(problems, pr => string_contains(s: pr, pattern: "node-multiset"))
    && any(problems, pr => string_contains(s: pr, pattern: "the log does not say so")))
}

// The empty held-list typed once, so a reader cannot mistake a dropped argument for a typo.
fn verifier_nothing_events() -> List<RoadmapAcceptanceEvent> { [] as List<RoadmapAcceptanceEvent> }

test fn a_migration_verifier_refuses_a_closed_node_the_manifest_never_accepted() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_accepted(),
    closed_nodes: concat(verifier_closed(), ["node-the-manifest-never-accepted"]), not_retired: verifier_nothing())
  claim("a node the log calls closed that the manifest never accepted refuses",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "node-the-manifest-never-accepted")))
}

test fn a_migration_verifier_refuses_a_manifest_that_does_not_replay() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_revoked_alone(), held: verifier_events_revoked_alone(),
    closed_nodes: verifier_nothing(), not_retired: verifier_nothing())
  claim("a manifest that does not replay REFUSES rather than certifying an empty expectation",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "does not replay")))
}

test fn a_migration_verifier_refuses_a_retired_node_the_log_does_not_hold_retired() -> Bool {
  let problems = roadmap_acceptance_migration_problems(
    wanted: verifier_events_accepted(), held: verifier_events_accepted(),
    closed_nodes: verifier_closed(), not_retired: ["node-never-retired"])
  claim("a node the runbook claims retired that the log does not hold retired refuses",
    count(problems) == 1 && any(problems, pr => string_contains(s: pr, pattern: "node-never-retired")))
}
