module test.claim.roadmap.roadmap_attempt_history_evidence_witness

import gunbc.roadmap.roadmap_attempt_state_store {
  AttemptEnvironmentAdmission, AttemptSpawnFailure, AttemptWorkerEvents,
  attempt_state_current_text, attempt_log_current_text,
  attempt_state_text, attempt_log_member_text, attempt_state_entry_name, attempt_state_slots,
}
import std.types { Bool, String, NonEmptyStr, FilePath }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { deployment_id }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision,
}

import gunbc.roadmap.roadmap_model { RoadmapNodeId }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A NAMED ATTEMPT'S RECORDS ARE THAT ATTEMPT'S, NOT ITS NODE'S CURRENT ONE. The evidence builder
// (gunbc.roadmap.roadmap_belt_actuate belt_workflow_attempt_evidence_for_key) reads its admission, provider
// events and spawn failure from the sealed per-attempt store; these claims supply the instance and keys at
// that store's OWN path authority -- `attempt_state_text` for the plain-write members and
// `attempt_log_member_text` for the append-log member, both sealed behind `attempt_state_provision`. Two
// attempts of one node, K1 (historical) and K2: every K1 path names K1's entry (the ONE declaration of the
// entry shape, `attempt_state_entry_name`), differs from K2's, and is not the node's current projection --
// the alias a historical read must never resolve through. The builder's real route is exercised in
// production by the belt's history scan (gunbc.roadmap.roadmap_dogfood_route) over srv2's attempt state.
// PR #15417 sealed these paths into gunbc.roadmap.roadmap_attempt_state_store and deleted the
// belt_attempt_record_paths helper this witness drove, converting this file's current-projection comparison
// but leaving its per-attempt half behind; PR #15576 moved the events member onto the append-log lane.
// The paths are read through the store, never assembled here -- an assembled path would assert this file's
// own string work, not the store's.
fn instance() -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "attempt-history-witness" as NonEmptyStr),
    instance_id: "attempt-history-witness" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: "/instance" as FilePath,
    serve_function: "attempt_history_witness_serve" as NonEmptyStr,
    listen_port: 18097,
    source_anchor_ref: "refs/remotes/origin/main" as NonEmptyStr,
    actuation: DashboardActuating,
    actuator_host: srv1_host_layout().host_identity,
  )
}

data node: String = "witness-node"

data k1: String = "1111111111111111"

data k2: String = "2222222222222222"

fn admission_path(attempt_key: String) -> String {
  attempt_state_text(
    instance: instance(), node_id: node as RoadmapNodeId, attempt_key: attempt_key,
    member: AttemptEnvironmentAdmission,
  )
}

fn events_path(attempt_key: String) -> String {
  attempt_log_member_text(
    instance: instance(), node_id: node as RoadmapNodeId, attempt_key: attempt_key,
    member: AttemptWorkerEvents,
  )
}

fn spawn_failure_path(attempt_key: String) -> String {
  attempt_state_text(
    instance: instance(), node_id: node as RoadmapNodeId, attempt_key: attempt_key,
    member: AttemptSpawnFailure,
  )
}

test fn a_historical_attempts_records_name_its_own_directory() -> Bool {
  let entry = attempt_state_entry_name(node: node, attempt_key: k1)
  let dir = join(["/", entry, "/"], "")
  admission_path(attempt_key: k1).contains(dir) && events_path(attempt_key: k1).contains(dir)
    && spawn_failure_path(attempt_key: k1).contains(dir)
}

test fn two_attempts_of_one_node_never_share_a_record_path() -> Bool {
  admission_path(attempt_key: k1) != admission_path(attempt_key: k2) && events_path(attempt_key: k1) != events_path(attempt_key: k2)
    && spawn_failure_path(attempt_key: k1) != spawn_failure_path(attempt_key: k2)
}

test fn a_historical_attempt_never_reads_through_the_current_projection() -> Bool {
  let nid = node as RoadmapNodeId
  admission_path(attempt_key: k1) != attempt_state_current_text(instance: instance(), node_id: nid, member: AttemptEnvironmentAdmission)
    && events_path(attempt_key: k1) != attempt_log_current_text(instance: instance(), node_id: nid, member: AttemptWorkerEvents)
    && spawn_failure_path(attempt_key: k1) != attempt_state_current_text(instance: instance(), node_id: nid, member: AttemptSpawnFailure)
    && !admission_path(attempt_key: k1).contains(attempt_state_slots.current_suffix)
}
