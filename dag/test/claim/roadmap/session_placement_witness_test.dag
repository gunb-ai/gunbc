module test.claim.roadmap.session_placement_witness_test

import extdeps.shell
import std.types { Bool, String, List, NonEmptyStr, EpochSecs }
import std.measure { kibibyte, kibibyte_count }
import std.durable_compare_and_set { CasGeneration, cas_generation_first }
import product.capacity.lease { LeaseGrant, LeaseFence, GrantIdentity }
import product.capacity.event_chain { PartitionId }
import gunbc.fabric_storage_client { FabricStorageLocalFiles }
import gunbc.fabric_storage_file_store { fabric_storage_file_root }
import gunbc.compute.work_class_grant { WorkClassAgentSession, GrantAtCeiling, ClassUnmeasured }
import gunbc.compute.work_provider_local { compute_layout, compute_unit_properties }
import gunbc.compute.attempt_lifecycle {
  AttemptRecord, AttemptReserved, AttemptLaunching, AttemptTerminal,
  AttemptSlotReading, AttemptSlotAbsent, AttemptSlotHeld, AttemptSlotUnreadable, attempt_slot_read,
  attempt_open, attempt_begin_launch, AttemptAdvanced, AttemptLostRace, AttemptTransitionRefused,
  UnitLifecycle, UnitTerminatedSuccess, UnitTerminatedCauseUnknown, UnitStillRunning, UnitLifecycleUnknown,
}
import gunbc.roadmap_dashboard_instance { srv2_deploy_dashboard_instance }
import gunbc.roadmap_dispatch_actuator { dispatch_worker_unit_properties }
import gunbc.roadmap_session_placement {
  SessionPlacementGrant, SessionPlacementStores, session_process_bounds, session_unit, session_attempt_record,
  session_placement_record_of, session_placement_record_json, session_placement_record_write,
  session_placement_record_basename, session_placement_release_basename, session_placement_note_basename,
  SessionPlacementObservation, SessionPlacementObserved, SessionPlacementAbsent, SessionPlacementUnreadable, SessionPlacementForeign,
  SessionGrantReading, SessionGrantRecorded, SessionGrantNotRecorded, SessionGrantUnreadable, SessionGrantForeign,
  SessionReleaseObservation, SessionReleaseNotRecorded, SessionReleased, SessionReleaseNothingHeld, SessionReleaseRefused, SessionReleaseUnreadable,
  session_placement_observation_of, session_placement_observe_at,
  SessionSettleDecision, SettleTerminateAndRelease, SettleReleaseOnly, SettleKeep, SettleDone, session_settle_decide,
  SessionSettlePass, SessionSettlePassRan, SessionSettlePassRefused, session_placement_settle_pass_at,
  SessionSettlement, SessionSettlementReleaseAttempted, SessionSettlementKept, SessionSettlementDone, SessionSettlementRefused,
}
import extdeps.filesystem.filesystem_io {
  Filesystem, FilesystemFileObservation, filesystem_listing_observation, filesystem_read_outcome, filesystem_file_observation,
}
import extdeps.languages.json.emit { serialize_json }

// G5 WITNESSES (side-chat ruling on #13074 at b4d4a42). Three groups:
//   - the reader's BINDING: a record or release that belongs to another attempt or fence is refused;
//   - the settlement DECISION over a slot, pure;
//   - the settlement PASS run for real over a temporary slot store and records directory, interrupted
//     at each point the ruling names, plus the foreign-record negative: B's placement record planted at
//     A's path cannot release B.
// The inhabitance claim: the bytes the real writer produces (session_placement_record_write) are what
// the real reader and the real settlement read back as this attempt's grant.

data node_a: String = "g5-node-a"
data key_a: String = "feedfacefeedface"
data node_b: String = "g5-node-b"
data key_b: String = "0123456789abcdef"
data host: String = "srv2"

fn unit_a() -> String { session_unit(node_id: node_a, attempt_key: key_a) as String }
fn unit_b() -> String { session_unit(node_id: node_b, attempt_key: key_b) as String }

fn fresh_dir(tag: String) -> String {
  shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_g5_", tag, ".XXXXXX"], "")).path
}

fn stores_at(dir: String) -> SessionPlacementStores {
  SessionPlacementStores {
    slots_root: dir as NonEmptyStr,
    records_dir: dir,
    store: FabricStorageLocalFiles { root: fabric_storage_file_root(root: join([dir, "/ledger"], "") as NonEmptyStr) },
    partition: "session-memory-srv2" as NonEmptyStr as PartitionId,
  }
}

fn grant_for(node_id: String, attempt_key: String, slot: AttemptRecord) -> SessionPlacementGrant {
  SessionPlacementGrant {
    node_id: node_id,
    attempt_key: attempt_key,
    unit: session_unit(node_id: node_id, attempt_key: attempt_key),
    lease: LeaseGrant {
      reference: session_unit(node_id: node_id, attempt_key: attempt_key),
      fence: LeaseFence { grant: "evt-7" as NonEmptyStr as GrantIdentity, generation: 7 },
      granted_at: 1000,
      maximum_duration_seconds: 14400,
      expires_at: 15400,
    },
    partition: "session-memory-srv2" as NonEmptyStr as PartitionId,
    amount: kibibyte(count: 8388608),
    class_grant: GrantAtCeiling { class: WorkClassAgentSession, amount: kibibyte(count: 8388608), reason: ClassUnmeasured },
    store: FabricStorageLocalFiles { root: fabric_storage_file_root(root: "/state/capacity" as NonEmptyStr) },
    slot: slot,
    slot_generation: cas_generation_first(),
  }
}

fn slot_a(opened: EpochSecs) -> AttemptRecord {
  session_attempt_record(node_id: node_a, attempt_key: key_a, granted: kibibyte(count: 8388608), now: opened)
}

fn record_bytes(node_id: String, attempt_key: String) -> String {
  serialize_json(v: session_placement_record_json(r: session_placement_record_of(host: host, grant: grant_for(node_id: node_id, attempt_key: attempt_key, slot: slot_a(opened: 1000)), unit_properties: ["MemoryMax=8589934592", "CPUQuota=800%", "TasksMax=4096"])))
}

fn planted(name: String, content: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/state", success: true, entries: join(["unrelated", name], "\n"), error: ""),
    name: name, path: join(["/state/", name], ""),
    read: filesystem_read_outcome(content: content, success: true, error: ""),
  )
}

fn missing(name: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/state", success: true, entries: "unrelated", error: ""),
    name: name, path: join(["/state/", name], ""),
    read: filesystem_read_outcome(content: "", success: false, error: "ENOENT"),
  )
}

fn held(rec: AttemptRecord) -> AttemptSlotReading { AttemptSlotHeld { record: rec, generation: cas_generation_first() } }

fn release_for(node_id: String, attempt_key: String, grant_identity: String, fence: String) -> String {
  join(["{\"schema\":\"gunbc.session-placement/v1\",\"node_id\":\"", node_id, "\",\"attempt_key\":\"", attempt_key,
    "\",\"reference\":\"", session_unit(node_id: node_id, attempt_key: attempt_key) as String,
    "\",\"outcome\":\"released\",\"reason\":\"session unit exited 0\",\"detail\":\"released\",\"grant\":{\"grant_identity\":\"", grant_identity, "\",\"fence_generation\":", fence, "}}"], "")
}

fn observe_a(slot: AttemptSlotReading, record: FilesystemFileObservation, released: FilesystemFileObservation) -> SessionPlacementObservation {
  session_placement_observation_of(
    node_id: node_a, attempt_key: key_a, host: host, slot: slot,
    record_path: "/state/r", record: record, release_path: "/state/x", released: released,
  )
}

fn rec_name() -> String { session_placement_record_basename(node_id: node_a, attempt_key: key_a) }
fn rel_name() -> String { session_placement_release_basename(node_id: node_a, attempt_key: key_a) }

// POSITIVE CONTROL AND INHABITANCE: the real encoder's record, released against the same grant and
// fence, reads back as Observed with the grant identity, the amount, the properties and the release.
test fn a_bound_placement_reads_back_its_slot_grant_and_release() -> Bool {
  match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_a, attempt_key: key_a)), released: planted(name: rel_name(), content: release_for(node_id: node_a, attempt_key: key_a, grant_identity: "evt-7", fence: "7"))) {
    SessionPlacementObserved { slot: _, grant, returned } =>
      (match grant {
        SessionGrantRecorded { record } => record.grant_identity == "evt-7" && record.fence_generation == 7 && kibibyte_count(k: record.amount) == 8388608 && contains(record.unit_properties, "CPUQuota=800%")
        SessionGrantNotRecorded { path: _ } => false
        SessionGrantUnreadable { path: _, detail: _ } => false
        SessionGrantForeign { path: _, detail: _ } => false
      })
        && (match returned {
          SessionReleased { reason, detail: _ } => reason == "session unit exited 0"
          SessionReleaseNotRecorded { path: _ } => false
          SessionReleaseNothingHeld { reason: _, detail: _ } => false
          SessionReleaseRefused { reason: _, detail: _ } => false
          SessionReleaseUnreadable { path: _, detail: _ } => false
        })
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
}

fn release_unreadable_naming(r: SessionReleaseObservation, needle: String) -> Bool {
  match r {
    SessionReleaseUnreadable { path: _, detail } => string_contains(s: detail, pattern: needle)
    SessionReleaseNotRecorded { path: _ } => false
    SessionReleased { reason: _, detail: _ } => false
    SessionReleaseNothingHeld { reason: _, detail: _ } => false
    SessionReleaseRefused { reason: _, detail: _ } => false
  }
}

// DISCRIMINATING RED (finding 3): attempt B's placement record at attempt A's path is FOREIGN; a
// release naming the right reference but a different fence is not this grant's release; no slot is
// Absent.
test fn a_record_or_release_from_another_attempt_or_fence_is_refused() -> Bool {
  let foreign = match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_b, attempt_key: key_b)), released: missing(name: rel_name())) {
    SessionPlacementForeign { unit, detail } => unit == unit_a() && string_contains(s: detail, pattern: node_b)
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
  }
  let wrong_fence = match observe_a(slot: held(rec: slot_a(opened: 1000)), record: planted(name: rec_name(), content: record_bytes(node_id: node_a, attempt_key: key_a)), released: planted(name: rel_name(), content: release_for(node_id: node_a, attempt_key: key_a, grant_identity: "evt-7", fence: "8"))) {
    SessionPlacementObserved { slot: _, grant: _, returned } => release_unreadable_naming(r: returned, needle: "fence")
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
  let no_slot = match observe_a(slot: AttemptSlotAbsent, record: missing(name: rec_name()), released: missing(name: rel_name())) {
    SessionPlacementAbsent { unit } => unit == unit_a()
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
  foreign && wrong_fence && no_slot
}

fn releases(d: SessionSettleDecision) -> Bool {
  match d {
    SettleTerminateAndRelease { record: _, generation: _, attempt: _, reason: _ } => true
    SettleReleaseOnly { record: _, attempt: _, reason: _ } => true
    SettleKeep { why: _, explain: _ } => false
    SettleDone { why: _ } => false
  }
}

fn launching(rec: AttemptRecord) -> AttemptRecord {
  AttemptRecord { identity: rec.identity, reference: rec.reference, unit: rec.unit, granted: rec.granted, opened_at: rec.opened_at, launch_deadline: rec.launch_deadline, state: AttemptLaunching }
}

// THE DECISION: Reserved frees only after its declared window, Launching only when the unit has
// ended; an unreadable slot, an unobservable unit, or a slot read under another unit's key is kept.
test fn settlement_releases_only_a_closed_window_or_an_ended_unit() -> Bool {
  let k = unit_a() as NonEmptyStr
  let rec = slot_a(opened: 1000)
  releases(d: session_settle_decide(key: k, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: rec.launch_deadline + 1, release_settled: false))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: rec.launch_deadline - 1, release_settled: false))
    && releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitTerminatedSuccess { detail: "0" }, now: 1001, release_settled: false))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitStillRunning { detail: "active" }, now: 99999, release_settled: false))
    && !releases(d: session_settle_decide(key: k, slot: held(rec: launching(rec: rec)), lifecycle: UnitLifecycleUnknown { detail: "systemctl refused" }, now: 99999, release_settled: false))
    && !releases(d: session_settle_decide(key: k, slot: AttemptSlotUnreadable { detail: "torn" }, lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: 99999, release_settled: false))
    && !releases(d: session_settle_decide(key: unit_b() as NonEmptyStr, slot: held(rec: rec), lifecycle: UnitTerminatedCauseUnknown { detail: "absent" }, now: 99999, release_settled: false))
}

// ── THE PASS, WET ──────────────────────────────────────────────────────────────────────────────
fn lifecycle_absent(u: NonEmptyStr) -> UnitLifecycle { UnitTerminatedCauseUnknown { detail: "the user manager has no such unit" } }
fn lifecycle_running(u: NonEmptyStr) -> UnitLifecycle { UnitStillRunning { detail: "the unit is active" } }

fn settlement_of(p: SessionSettlePass) -> SessionSettlement {
  match p {
    SessionSettlePassRan { settlements } => match settlements.first() { Present { value: s } => s  Absent => SessionSettlementRefused { unit: "", detail: "no settlement" } }
    SessionSettlePassRefused { detail } => SessionSettlementRefused { unit: "", detail: detail }
  }
}

fn released_unit(s: SessionSettlement) -> String {
  match s {
    SessionSettlementReleaseAttempted { unit, freed: _, detail: _ } => unit
    SessionSettlementKept { unit: _, why: _ } => ""
    SessionSettlementDone { unit: _, why: _ } => ""
    SessionSettlementRefused { unit: _, detail: _ } => ""
  }
}

fn kept(s: SessionSettlement) -> Bool {
  match s {
    SessionSettlementKept { unit: _, why: _ } => true
    SessionSettlementReleaseAttempted { unit: _, freed: _, detail: _ } => false
    SessionSettlementDone { unit: _, why: _ } => false
    SessionSettlementRefused { unit: _, detail: _ } => false
  }
}

fn slot_is_terminal(dir: String) -> Bool {
  match attempt_slot_read(root: dir as NonEmptyStr, reference: unit_a() as NonEmptyStr) {
    AttemptSlotHeld { record, generation: _ } => match record.state { AttemptTerminal { verdict: _, detail: _ } => true  AttemptReserved => false  AttemptLaunching => false }
    AttemptSlotAbsent => false
    AttemptSlotUnreadable { detail: _ } => false
  }
}

fn opened_ok(dir: String, rec: AttemptRecord) -> Bool {
  match attempt_open(root: dir as NonEmptyStr, record: rec) {
    AttemptAdvanced { state: _, generation: _ } => true
    AttemptLostRace { expected: _, observed: _ } => false
    AttemptTransitionRefused { detail: _ } => false
  }
}

fn launched_ok(dir: String, rec: AttemptRecord) -> Bool {
  match attempt_open(root: dir as NonEmptyStr, record: rec) {
    AttemptAdvanced { state: _, generation: g } =>
      match attempt_begin_launch(root: dir as NonEmptyStr, record: rec, expected: g) {
        AttemptAdvanced { state: _, generation: _ } => true
        AttemptLostRace { expected: _, observed: _ } => false
        AttemptTransitionRefused { detail: _ } => false
      }
    AttemptLostRace { expected: _, observed: _ } => false
    AttemptTransitionRefused { detail: _ } => false
  }
}

fn release_text(dir: String) -> String {
  let r = Filesystem.Read(path: join([dir, "/", rel_name()], ""))
  if r.success { r.content } else { "" }
}

// CONTROL 1, ACQUIRE -> NO PLACEMENT RECORD: the slot opened before the reservation is all that
// survives. Inside its declared window the seat is kept; past it, with no unit, the slot is closed and
// the seat released by reference, with a durable release record that binds no grant.
test fn a_slot_with_no_placement_record_is_kept_in_window_and_released_after() -> Bool {
  let dir = fresh_dir(tag: "c1")
  let stores = stores_at(dir: dir)
  let rec = slot_a(opened: 1000)
  let opened = opened_ok(dir: dir, rec: rec)
  let early = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: rec.launch_deadline - 1))
  let late = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: rec.launch_deadline + 1))
  let rel = release_text(dir: dir)
  opened && kept(s: early) && released_unit(s: late) == unit_a() && slot_is_terminal(dir: dir)
    && string_contains(s: rel, pattern: unit_a()) && !string_contains(s: rel, pattern: "\"grant\"")
}

// CONTROL 2, A MALFORMED SLOT: an unreadable slot keeps its seat and leaves a durable note naming why.
test fn an_unreadable_slot_keeps_its_seat_and_writes_a_note() -> Bool {
  let dir = fresh_dir(tag: "c2")
  let stores = stores_at(dir: dir)
  let torn = Filesystem.Write(path: join([dir, "/", unit_a(), ".1"], ""), content: "{\"identity\":")
  let s = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: 99999))
  let note = Filesystem.Read(path: join([dir, "/", session_placement_note_basename(unit: unit_a())], ""))
  torn.success && kept(s: s) && note.success && string_contains(s: note.content, pattern: "unreadable")
}

// CONTROL 3, PLACEMENT RECORD -> NO UNIT START: the real writer's record and a Reserved slot past its
// window release the seat, and the release record is read back through the real reader, which
// accepts it only as bound to the recorded grant identity and fence (a release naming another grant
// or fence reads Unreadable there, as the pure control above shows).
test fn a_recorded_placement_whose_unit_never_started_is_released_bound_to_its_grant() -> Bool {
  let dir = fresh_dir(tag: "c3")
  let stores = stores_at(dir: dir)
  let rec = slot_a(opened: 1000)
  let opened = opened_ok(dir: dir, rec: rec)
  let wrote = session_placement_record_write(stores: stores, host: host, grant: grant_for(node_id: node_a, attempt_key: key_a, slot: rec), unit_properties: ["MemoryMax=8589934592"])
  let s = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: rec.launch_deadline + 1))
  let bound = match session_placement_observe_at(stores: stores, host: host, node_id: node_a, attempt_key: key_a) {
    SessionPlacementObserved { slot: _, grant, returned } =>
      (match grant {
        SessionGrantRecorded { record } => record.grant_identity == "evt-7" && record.fence_generation == 7
        SessionGrantNotRecorded { path: _ } => false
        SessionGrantUnreadable { path: _, detail: _ } => false
        SessionGrantForeign { path: _, detail: _ } => false
      })
        && (match returned {
          SessionReleased { reason: _, detail: _ } => true
          SessionReleaseNothingHeld { reason: _, detail: _ } => true
          SessionReleaseRefused { reason: _, detail: _ } => true
          SessionReleaseNotRecorded { path: _ } => false
          SessionReleaseUnreadable { path: _, detail: _ } => false
        })
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
    SessionPlacementForeign { unit: _, detail: _ } => false
  }
  opened && released_unit(s: s) == unit_a() && bound
}

// CONTROL 4, UNIT START -> CONTROLLER TERMINATION: a Launching slot is kept while its unit runs and
// released once the unit is gone.
test fn a_launched_session_is_kept_while_running_and_released_when_ended() -> Bool {
  let dir = fresh_dir(tag: "c4")
  let stores = stores_at(dir: dir)
  let launched = launched_ok(dir: dir, rec: slot_a(opened: 1000))
  let running = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_running, now: 99999))
  let ended = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: 99999))
  launched && kept(s: running) && released_unit(s: ended) == unit_a() && slot_is_terminal(dir: dir)
}

// FINDING 3, WET NEGATIVE: attempt B's placement record planted at attempt A's path, A's unit absent.
// Settlement releases A's own reference (the slot's key) -- never B's -- and binds no grant, because
// the record at that path is foreign to A.
test fn a_foreign_placement_record_cannot_release_another_attempts_grant() -> Bool {
  let dir = fresh_dir(tag: "f3")
  let stores = stores_at(dir: dir)
  let launched = launched_ok(dir: dir, rec: slot_a(opened: 1000))
  let planted_b = Filesystem.Write(path: join([dir, "/", rec_name()], ""), content: record_bytes(node_id: node_b, attempt_key: key_b))
  let reads_foreign = match session_placement_observe_at(stores: stores, host: host, node_id: node_a, attempt_key: key_a) {
    SessionPlacementForeign { unit: _, detail: _ } => true
    SessionPlacementObserved { slot: _, grant: _, returned: _ } => false
    SessionPlacementAbsent { unit: _ } => false
    SessionPlacementUnreadable { unit: _, detail: _ } => false
  }
  let s = settlement_of(p: session_placement_settle_pass_at(stores: stores, host: host, lifecycle_of: lifecycle_absent, now: 99999))
  let rel = release_text(dir: dir)
  launched && planted_b.success && reads_foreign && released_unit(s: s) == unit_a()
    && string_contains(s: rel, pattern: unit_a()) && !string_contains(s: rel, pattern: unit_b()) && !string_contains(s: rel, pattern: "\"grant\"")
}

// THE UNIT CARRIES THE GRANT, THROUGH THE SHARED FOLD: MemoryMax is the granted amount (not the
// instance ceiling), with the session's CPU and task bounds; the compute provider's unit, from the
// same fold, carries no process bounds.
test fn the_worker_unit_is_capped_at_its_grant_by_the_compute_fold() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1024), process_bounds: session_process_bounds)
  let compute = compute_unit_properties(layout: compute_layout(instance: inst, identity_hex: "abc"), granted: kibibyte(count: 1024))
  contains(props, "MemoryMax=1048576")
    && contains(props, "CPUQuota=800%")
    && contains(props, "TasksMax=4096")
    && contains(props, "KillMode=control-group")
    && count(filter(props, p => starts_with(s: p, prefix: "MemoryMax="))) == 1
    && contains(compute, "MemoryMax=1048576")
    && !any(compute, p => starts_with(s: p, prefix: "CPUQuota="))
}
