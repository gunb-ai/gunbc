module test.claim.roadmap.roadmap_launch_admission_fixture

import std.types { String, Int, List, Bool, NonEmptyStr, FilePath }
import gunbc.roadmap_model { RoadmapNode, RoadmapEdge, SectionElement, Group, SectionGroup }
import gunbc.roadmap_document { RoadmapDocument, RoadmapSection }
import gunbc.roadmap_execution_contract { WorkItemExecutionContract, gunbc_claim_execution_contract }
import gunbc.roadmap_dashboard_instance { DashboardActuationPosture, DashboardActuating, DashboardObserveOnly }
import gunbc.deploy_transition { ActuationAdmitted, ActuationRefused }
import gunbc.fleet_desired_observe { FleetRevisionStanding, RevisionConverged, RevisionDrifted, RevisionUnobserved }
import extdeps.git.object_store { GitObjectId, git_object_id_from_untagged_hex }
import gunbc.roadmap_dispatch_actuator { DispatchLiveSession, CodexDispatchProvider, dispatch_provider_instance_for }
import gunbc.worker_lifecycle { WorkerProcessEvidence, worker_observation_without_provider_probe_for_process }
import std.upsert_decision { Converged }
import gunbc.roadmap_belt { SpawnMode, ManualReady, BeltCapacity }
import gunbc.roadmap_launch_admission {
  LaunchHostStanding, LaunchHostObserved,
  LaunchSessionsStanding, LaunchSessionsObserved,
}

data launch_fixture_note: String = "Synthetic HOST facts for the launch-admission witnesses (RLM-1). The admission is pure over LaunchHostStanding, so a witness fabricates exactly the host it wants to talk about -- an actuating instance, a clear transition, a converged (or drifted, or unobserved) revision, a chosen live-session set, a capacity and a spawn mode -- and the graph it wants, and asks the same decision production asks. Nothing here touches a host; the two object ids are literal hex pinned by the fixture, never read from git."

data launch_fixture_instance_id: String = "fixture-actuating-instance"

data launch_fixture_desired_hex: String = "1111111111111111111111111111111111111111"
data launch_fixture_local_hex: String = "2222222222222222222222222222222222222222"

fn launch_fixture_oid(hex: String) -> GitObjectId? {
  git_object_id_from_untagged_hex(hex: hex)
}

fn launch_fixture_revision_converged() -> FleetRevisionStanding {
  match launch_fixture_oid(hex: launch_fixture_desired_hex) {
    Present { value: oid } => RevisionConverged { revision: oid }
    Absent => RevisionUnobserved { cause: "fixture object id did not decode" }
  }
}

fn launch_fixture_revision_drifted() -> FleetRevisionStanding {
  match launch_fixture_oid(hex: launch_fixture_desired_hex) {
    Present { value: d } =>
      match launch_fixture_oid(hex: launch_fixture_local_hex) {
        Present { value: l } => RevisionDrifted { desired: d, local: l }
        Absent => RevisionUnobserved { cause: "fixture local object id did not decode" }
      }
    Absent => RevisionUnobserved { cause: "fixture desired object id did not decode" }
  }
}

fn launch_fixture_standing(
  mode: SpawnMode,
  revision: FleetRevisionStanding,
  live: List<DispatchLiveSession>,
  max_concurrent: Int,
) -> LaunchHostStanding {
  LaunchHostObserved {
    instance_id: launch_fixture_instance_id,
    actuation: DashboardActuating,
    transition: ActuationAdmitted,
    revision: revision,
    sessions: LaunchSessionsObserved { live: live },
    capacity: BeltCapacity { max_concurrent: max_concurrent },
    mode: mode,
  }
}

fn launch_fixture_standing_clear(mode: SpawnMode) -> LaunchHostStanding {
  launch_fixture_standing(mode: mode, revision: launch_fixture_revision_converged(), live: [], max_concurrent: 3)
}

fn launch_fixture_standing_observe_only() -> LaunchHostStanding {
  LaunchHostObserved {
    instance_id: launch_fixture_instance_id,
    actuation: DashboardObserveOnly,
    transition: ActuationAdmitted,
    revision: launch_fixture_revision_converged(),
    sessions: LaunchSessionsObserved { live: [] },
    capacity: BeltCapacity { max_concurrent: 3 },
    mode: ManualReady,
  }
}

fn launch_fixture_standing_transition_inhibited() -> LaunchHostStanding {
  LaunchHostObserved {
    instance_id: launch_fixture_instance_id,
    actuation: DashboardActuating,
    transition: ActuationRefused { reason: "fixture: deployment transition in force" },
    revision: launch_fixture_revision_converged(),
    sessions: LaunchSessionsObserved { live: [] },
    capacity: BeltCapacity { max_concurrent: 3 },
    mode: ManualReady,
  }
}

fn launch_fixture_session(node_id: String, process: WorkerProcessEvidence) -> DispatchLiveSession {
  DispatchLiveSession {
    session_name: join(["gunbc-dispatch-", node_id], ""),
    node_id: node_id,
    windows: 1,
    lease_verdict: Converged,
    worker: worker_observation_without_provider_probe_for_process(
      instance: dispatch_provider_instance_for(provider: CodexDispatchProvider),
      process: process,
    ),
  }
}

fn launch_fixture_doc(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [RoadmapSection {
      title: "launch admission fixture (synthetic)",
      elements: [Group { group: SectionGroup { label: "fixture", nodes: nodes, edges: edges } }],
    }],
  }
}

data launch_fixture_contract_note: String = "A closing execution contract for fixture nodes that must pass the contract gate: the same producer the canary binds (gunbc_claim_execution_contract), pointed at a fixture claim identity. The entry is not read by the admission -- contract_closure only asks whether validations exist -- so the fixture never runs it."

fn launch_fixture_contract() -> WorkItemExecutionContract {
  gunbc_claim_execution_contract(
    entry: "dag/test/claim/roadmap/roadmap_launch_admission_witness_test.dag" as FilePath,
    function: "witness_operator_admitted_for_ready_parent" as NonEmptyStr,
  )
}

fn launch_fixture_with_contract(rn: RoadmapNode) -> RoadmapNode {
  RoadmapNode {
    identity: rn.identity,
    node: rn.node,
    line: rn.line,
    carriers: rn.carriers,
    sizing: rn.sizing,
    execution: launch_fixture_contract(),
    owner: rn.owner,
    signoff: rn.signoff,
  }
}
