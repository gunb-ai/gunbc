import gunbc.worker_lifecycle { WorkerProcessExited }

// THE EXIT DRAIN AND THE COLLECTED-WORKER READ, RUN OVER A REAL SPOOL. Each control makes a spool under
// a fresh temp directory with the deployment's stage layout (gunbc.host.host_layout), writes exit records
// the way the stop hook does -- one `mkdir` whose name is the record -- and runs the production drain
// (belt_exit_drain_at) and the production record read (attempt_exit_record_observe). The listings, the
// decodes and every move are the real ones; only starting a unit in a user manager is supplied, by a
// hand-off that answers Started and names the unit it would have started. Enrolled on the required
// floor's local-repo wet lane with the temp-directory write named in gunbc.ci.ci_layer_roots.
import gunbc.spool_queue { SpoolAttemptExit, SpoolRole, RolePending, RoleHandedOff, RoleClaimed, RoleDone, RoleRefused, SpoolListed, SpoolListingUnreadable, spool_open, spool_role_path, spool_queue_list, SpoolKind }

fn fresh_spool(tag: String) -> String {
  let root = shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_exit_spool_", tag, ".XXXXXX"], "")).path
  let made = belt_exec(cmd: host_exec_argv(program: "mkdir", args: ["-p", spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RolePending), spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleHandedOff), spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleClaimed), spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleDone), spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleRefused)]), workdir: "/")
  root
}

fn record(root: String, name: String) -> Bool {
  match belt_exec(cmd: host_exec_argv(program: "mkdir", args: ["--", join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RolePending), "/", name], "")]), workdir: "/") {
    ExecOk { stdout: _ } => true
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn names_in(root: String, stage_is_queued: Bool) -> List<String> {
  match spool_queue_list(store: spool_open(kind: SpoolAttemptExit, instance_root: root), role: if stage_is_queued { RoleHandedOff } else { RolePending }) {
    SpoolListed { names } => names
    SpoolListingUnreadable { reason: _ } => ["<unreadable>"]
  }
}

fn names_at(root: String, stage: SpoolRole) -> List<String> {
  match spool_queue_list(store: spool_open(kind: SpoolAttemptExit, instance_root: root), role: stage) {
    SpoolListed { names } => names
    SpoolListingUnreadable { reason: _ } => ["<unreadable>"]
  }
}

fn claimed_of(root: String) -> List<String> {
  match belt_exit_entries_claim_at(root: root, node_id: "wet-node", attempt_key: "feedfacefeedface") {
    BeltExitClaimed { entries } => entries
    BeltExitClaimRefused { reason: _ } => ["<refused>"]
  }
}

fn held(node_id: String, attempt_key: String) -> BeltObligationEnqueue {
  BeltObligationHeld { unit: belt_attempt_obligation_unit_name(node_id: node_id, attempt_key: attempt_key) }
}

fn sweep_started_for_attempt(drained: BeltExitDrain) -> Bool {
  match drained {
    BeltExitDrained { entries, launch: _ } =>
      any(entries, e => match e {
        BeltExitEntryHanded { entry: _, enqueue: BeltObligationStarted { unit } } => (unit as String) == (belt_attempt_obligation_unit_name(node_id: "wet-node", attempt_key: "feedfacefeedface") as String)
        _ => false
      })
    BeltExitDrainRefused { reason: _ } => false
  }
}

fn gone() -> AttemptUnitObservation {
  AttemptUnitAbsent
}

fn live() -> AttemptUnitObservation {
  AttemptUnitActive
}

fn handed(node_id: String, attempt_key: String) -> BeltObligationEnqueue {
  BeltObligationStarted { unit: belt_attempt_obligation_unit_name(node_id: node_id, attempt_key: attempt_key) }
}

fn launched() -> BeltObligationEnqueue {
  BeltObligationStarted { unit: belt_instance_obligation_unit_name(instance_id: "witness", kind: LaunchObligation) }
}

data worker_exit: String = "wet-node+feedfacefeedface+worker+0123456789abcdef0123456789abcdef+success+exited+0"
data reviewer_exit: String = "wet-node+feedfacefeedface+review.conformance-leasing.abc123+0123456789abcdef0123456789abcdef+success+exited+0"

// RED FIRST, DOGFOOD #4 (the hand-off half): a recorded worker exit is handed to ITS attempt's unit,
// leaves the inbox for queued, and queues the launch; nothing else has to run for that to happen.
test fn a_recorded_worker_exit_is_handed_to_its_attempt_and_leaves_the_inbox() -> Bool {
  let root = fresh_spool(tag: "worker")
  let wrote = record(root: root, name: worker_exit)
  let drained = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let handed_to_attempt = match drained {
    BeltExitDrained { entries, launch } =>
      count(entries) == 2
        && any(entries, e => match e { BeltExitEntryClaimed { entry } => entry == worker_exit _ => false })
        && any(entries, e => match e {
          BeltExitEntryHanded { entry, enqueue: BeltObligationStarted { unit } } => entry == worker_exit && (unit as String) == (belt_attempt_obligation_unit_name(node_id: "wet-node", attempt_key: "feedfacefeedface") as String)
          _ => false
        })
        && (match launch { Present { value: BeltObligationStarted { unit: _ } } => true _ => false })
    BeltExitDrainRefused { reason: _ } => false
  }
  wrote && handed_to_attempt && count(names_in(root: root, stage_is_queued: false)) == 0 && names_in(root: root, stage_is_queued: true) == [worker_exit]
}

// A reviewer's exit is handed to its attempt the same way but frees no worker capacity, so it does
// not queue the launch; a name that is not a record leaves the inbox for refused, not stays to re-fire
// the path unit.
test fn a_reviewer_exit_queues_no_launch_and_a_malformed_entry_is_refused() -> Bool {
  let root = fresh_spool(tag: "reviewer")
  let wrote = record(root: root, name: reviewer_exit) && record(root: root, name: "not-a-record")
  let drained = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let shape = match drained {
    BeltExitDrained { entries, launch } =>
      (match launch { Absent => true _ => false })
        && any(entries, e => match e { BeltExitEntryRefused { entry, reason: _ } => entry == "not-a-record" _ => false })
        && any(entries, e => match e { BeltExitEntryHanded { entry, enqueue: _ } => entry == reviewer_exit _ => false })
    BeltExitDrainRefused { reason: _ } => false
  }
  wrote && shape && count(names_in(root: root, stage_is_queued: false)) == 0
}

// bold-bee-114 CONDITION 3: THE UNIT IS GONE AND THE SPOOL ENTRY ALONE PRODUCES THE EXIT VERDICT. After
// the drain has moved the record to queued and the attempt's run has settled it to done, the worker's
// unit is supplied as collected (the manager answers not-found), and the real record read over the
// real spool yields the worker's exit -- not "never ran", not unobserved.
test fn a_collected_workers_exit_is_read_from_the_spool_alone() -> Bool {
  let root = fresh_spool(tag: "collected")
  let wrote = record(root: root, name: worker_exit)
  let drained = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let unsettled = belt_exit_entries_settle_at(root: root, claimed: claimed_of(root: root))
  let unit = "gunbc-attempt-wet-node-feedfacefeedface.service" as NonEmptyStr
  let verdict = worker_process_from_attempt_unit(
    observation: attempt_worker_unit_observation_of(
      unit: unit,
      loaded: AttemptUnitAbsent,
      record: attempt_exit_record_observe(instance_root: root, node_id: "wet-node", attempt_key: "feedfacefeedface", role: AttemptWorkerRole),
      start: AttemptUnitStartRecorded,
    ),
    unit: unit,
  )
  wrote && count(unsettled) == 0 && count(names_in(root: root, stage_is_queued: true)) == 0
    && (match verdict { WorkerProcessExited { exit_code, last_command: _ } => exit_code == 0 _ => false })
}

// bold-bee-114 NO-LAND (2026-10-09), CUT A -- an exit that arrives AFTER THE RUN'S FINAL OBSERVATION BUT
// BEFORE SETTLEMENT is not acknowledged by a receipt that never observed it. The first exit is claimed
// (queued -> running) and the second arrives while the unit is held; settling the claim moves only the
// first to done, the second stays queued, and a later run's claim is what carries it to done.
test fn an_exit_after_the_final_observation_stays_queued_until_a_later_runs_claim_settles_it() -> Bool {
  let root = fresh_spool(tag: "cut-a")
  let first = record(root: root, name: worker_exit)
  let d1 = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let claim = claimed_of(root: root)
  let second = record(root: root, name: reviewer_exit)
  let d2 = belt_exit_drain_at(root: root, enqueue: (n, k) => held(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => live())
  let unsettled = belt_exit_entries_settle_at(root: root, claimed: claim)
  let after_first_run = claim == [worker_exit]
    && names_at(root: root, stage: RoleDone) == [worker_exit]
    && names_at(root: root, stage: RoleHandedOff) == [reviewer_exit]
    && count(names_at(root: root, stage: RoleClaimed)) == 0
  let next_claim = claimed_of(root: root)
  let unsettled_next = belt_exit_entries_settle_at(root: root, claimed: next_claim)
  first && second && count(unsettled) == 0 && after_first_run && next_claim == [reviewer_exit] && count(unsettled_next) == 0
    && count(names_at(root: root, stage: RoleHandedOff)) == 0 && count(names_at(root: root, stage: RoleDone)) == 2
}

// CUT B -- an exit that arrives AFTER SETTLEMENT BUT BEFORE THE UNIT EXITS is handed to a unit that is
// still held (so the hand-off is a no-op and nothing ran for it). The entry stays queued: the queued
// level starts the drain again, and once the unit is gone the drain's sweep starts a run for the
// attempt, which claims the entry and settles it to done under its own claim.
test fn an_exit_after_settlement_is_swept_to_a_new_run_once_the_unit_is_gone() -> Bool {
  let root = fresh_spool(tag: "cut-b")
  let first = record(root: root, name: worker_exit)
  let d1 = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let unsettled = belt_exit_entries_settle_at(root: root, claimed: claimed_of(root: root))
  let late = record(root: root, name: reviewer_exit)
  let while_held = belt_exit_drain_at(root: root, enqueue: (n, k) => held(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let still_queued = names_at(root: root, stage: RoleHandedOff) == [reviewer_exit] && !(names_at(root: root, stage: RoleDone) == [worker_exit, reviewer_exit])
  let unit_gone = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let new_run_claim = claimed_of(root: root)
  let settled = belt_exit_entries_settle_at(root: root, claimed: new_run_claim)
  first && late && count(unsettled) == 0 && still_queued && sweep_started_for_attempt(drained: unit_gone)
    && new_run_claim == [reviewer_exit] && count(settled) == 0 && count(names_at(root: root, stage: RoleHandedOff)) == 0
    && count(names_at(root: root, stage: RoleDone)) == 2
}

// CUT C -- THE UNIT OR THE HOST IS GONE WHILE AN ENTRY IS QUEUED. The drain runs with an EMPTY inbox, the
// sweep alone finds the queued entry and starts its attempt's run, and that run's claim is the only thing
// that moves it to done.
test fn a_queued_exit_needs_no_new_event_to_reach_done_under_a_runs_claim() -> Bool {
  let root = fresh_spool(tag: "cut-c")
  let first = record(root: root, name: worker_exit)
  let handed_once = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let sweep_only = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let adopted = claimed_of(root: root)
  let settled = belt_exit_entries_settle_at(root: root, claimed: adopted)
  first && sweep_started_for_attempt(drained: sweep_only) && adopted == [worker_exit]
    && count(settled) == 0 && count(names_at(root: root, stage: RoleHandedOff)) == 0 && names_at(root: root, stage: RoleDone) == [worker_exit]
}

// RED (a) -- A LONE ORPHANED CLAIM, NO OTHER EVENT (bold-bee-114, 2026-10-09). The entry was queued, a run
// claimed it into `running`, and the run died before its receipt (host or user-manager restart: no hook ran).
// Inbox and queued are EMPTY and the unit is absent; the drain -- all a boot establishes -- must return the
// claim to queued, start the attempt, and the new run must adopt it and settle it to done under its claim.
test fn a_lone_orphaned_claim_is_recovered_by_the_drain_alone() -> Bool {
  let root = fresh_spool(tag: "orphan-a")
  let first = record(root: root, name: worker_exit)
  let handed_once = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let dead_run_claim = claimed_of(root: root)
  let stranded = names_at(root: root, stage: RoleClaimed) == [worker_exit] && count(names_at(root: root, stage: RolePending)) == 0 && count(names_at(root: root, stage: RoleHandedOff)) == 0
  let boot = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let adopted = claimed_of(root: root)
  let settled = belt_exit_entries_settle_at(root: root, claimed: adopted)
  first && dead_run_claim == [worker_exit] && stranded && sweep_started_for_attempt(drained: boot) && adopted == [worker_exit]
    && count(settled) == 0 && count(names_at(root: root, stage: RoleClaimed)) == 0 && names_at(root: root, stage: RoleDone) == [worker_exit]
}

// A claim whose unit is LIVE is not an orphan: the drain leaves it in running and starts nothing.
test fn a_claim_held_by_a_live_unit_is_not_reclaimed() -> Bool {
  let root = fresh_spool(tag: "orphan-live")
  let first = record(root: root, name: worker_exit)
  let handed_once = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let claimed = claimed_of(root: root)
  let again = belt_exit_drain_at(root: root, enqueue: (n, k) => held(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => live())
  first && claimed == [worker_exit] && names_at(root: root, stage: RoleClaimed) == [worker_exit] && count(names_at(root: root, stage: RoleHandedOff)) == 0
}

data obligation_exit: String = "wet-node+feedfacefeedface+obligation+0123456789abcdef0123456789abcdef+timeout+killed+TERM"

// RED (b) -- THE CLAIMANT IS KILLED BY ITS OWN RuntimeMaxSec. The unit's stop hook (the production
// attempt_exit_hook for AttemptObligationRole) records an `obligation` entry while the unit is still
// stopping. A drain that finds the unit live must NOT consume it; the next drain, the unit gone, returns
// the orphaned claim to queued, consumes the entry, starts the attempt, and the run adopts and settles.
test fn a_claimant_killed_at_its_run_bound_is_rescued_by_its_stop_hook_entry() -> Bool {
  let root = fresh_spool(tag: "orphan-b")
  let inst = srv1_lab_dashboard_instance()
  let hook_renders = match attempt_exit_hook(instance_root: root, node_id: "wet-node", attempt_key: "feedfacefeedface", role: AttemptObligationRole, record_owner: inst.directory_owner) {
    AttemptExitHookRendered { exec_line } => string_contains(s: exec_line as String, pattern: "+obligation+") && string_contains(s: exec_line as String, pattern: spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RolePending))
    AttemptExitHookRefused { reason: _ } => false
  }
  let first = record(root: root, name: worker_exit)
  let handed_once = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let dead_run_claim = claimed_of(root: root)
  let hook = record(root: root, name: obligation_exit)
  let while_stopping = belt_exit_drain_at(root: root, enqueue: (n, k) => held(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => live())
  let kept = names_at(root: root, stage: RolePending) == [obligation_exit] && names_at(root: root, stage: RoleClaimed) == [worker_exit]
  let after_exit = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let adopted = claimed_of(root: root)
  let settled = belt_exit_entries_settle_at(root: root, claimed: adopted)
  hook_renders && first && hook && dead_run_claim == [worker_exit] && kept && sweep_started_for_attempt(drained: after_exit) && adopted == [worker_exit]
    && count(settled) == 0 && count(names_at(root: root, stage: RolePending)) == 0 && count(names_at(root: root, stage: RoleClaimed)) == 0
    && any(names_at(root: root, stage: RoleDone), e => e == worker_exit) && any(names_at(root: root, stage: RoleDone), e => e == obligation_exit)
}

// A SETTLED RUN'S HOOK ENTRY STARTS NOTHING (the loop guard): running is empty, so consuming the entry
// enqueues no unit and the exits stop there.
test fn a_settled_runs_hook_entry_is_consumed_and_starts_nothing() -> Bool {
  let root = fresh_spool(tag: "orphan-settled")
  let hook = record(root: root, name: obligation_exit)
  let drained = belt_exit_drain_at(root: root, enqueue: (n, k) => handed(node_id: n, attempt_key: k), launch: fn() { launched() }, observe: (n, k) => gone())
  let quiet = match drained {
    BeltExitDrained { entries, launch } => count(entries) == 0 && launch == none
    BeltExitDrainRefused { reason: _ } => false
  }
  hook && quiet && count(names_at(root: root, stage: RolePending)) == 0 && names_at(root: root, stage: RoleDone) == [obligation_exit]
}

// ── CLAIM FIRST (a move the drain's principal cannot make leaves no effect to repeat) ───────────────
// srv1 2026-10-21: a root-owned directory in the inbox could not be renamed, and the drain had already
// enqueued its attempt, so every re-fired pass handed the obligation again. A root-owned entry is not
// authorable in unprivileged CI; the supplied seam is the MOVE, which refuses a named entry exactly as
// the rename did. Every other listing, decode and move is the real one, and the hand-off is a recording
// one: each call leaves one directory under `done`, so the count of calls is the count of directories.

fn counting_enqueue(root: String, node_id: String, attempt_key: String) -> BeltObligationEnqueue {
  let marked = shell.Mktemp.DirWithTemplate(template: join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleDone), "/call.XXXXXX"], "")).path
  handed(node_id: node_id, attempt_key: attempt_key)
}

fn refusing_move_of(entry: String, root: String, name: String, from: SpoolRole, to: SpoolRole) -> String? {
  if name == entry { Present { value: "mv exited 1: mv: cannot move: Permission denied" } } else { belt_exit_entry_move_at(root: root, entry: name, from: from, to: to) }
}

fn calls_recorded(root: String) -> Int {
  count(names_at(root: root, stage: RoleDone))
}

fn unmovable_pass(root: String) -> BeltExitDrain {
  belt_exit_drain_moving_at(
    root: root,
    enqueue: (n, k) => counting_enqueue(root: root, node_id: n, attempt_key: k),
    launch: fn() { counting_launch(root: root) },
    observe: (n, k) => gone(),
    move: (r, e, from, to) => refusing_move_of(entry: worker_exit, root: r, name: e, from: from, to: to),
  )
}

fn counting_launch(root: String) -> BeltObligationEnqueue {
  let marked = shell.Mktemp.DirWithTemplate(template: join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleDone), "/call.XXXXXX"], "")).path
  launched()
}

fn is_unmovable(d: BeltExitDrain) -> Bool {
  match d {
    BeltExitDrained { entries, launch } =>
      any(entries, e => match e { BeltExitEntryUnmovable { entry, step: _, cause: _ } => entry == worker_exit _ => false })
        && launch == none
        && count(belt_exit_drain_failures(d: d)) == 1
    BeltExitDrainRefused { reason: _ } => false
  }
}

// RED-a: an entry whose move is refused hands nothing to anyone (no obligation enqueue, no launch) and is
// typed Unmovable, counted in the pass's failures, and stays in the inbox as evidence.
test fn an_unmovable_exit_entry_hands_nothing_and_stays_as_evidence() -> Bool {
  let root = fresh_spool(tag: "unmovable")
  let wrote = record(root: root, name: worker_exit)
  let pass = unmovable_pass(root: root)
  wrote && is_unmovable(d: pass) && calls_recorded(root: root) == 0 && names_in(root: root, stage_is_queued: false) == [worker_exit] && count(names_in(root: root, stage_is_queued: true)) == 0
}

// RED-b2: the enqueue count is the discriminator, stable across repeated passes with the entry still in
// the inbox: the path unit re-fires, and nothing is repeated. Each pass still reports the entry.
test fn re_fired_passes_over_an_unmovable_entry_repeat_no_effect() -> Bool {
  let root = fresh_spool(tag: "refire")
  let wrote = record(root: root, name: worker_exit)
  let p1 = unmovable_pass(root: root)
  let p2 = unmovable_pass(root: root)
  let p3 = unmovable_pass(root: root)
  wrote && is_unmovable(d: p1) && is_unmovable(d: p2) && is_unmovable(d: p3) && calls_recorded(root: root) == 0
}

// An unmovable entry holds no other: a movable sibling is claimed and handed in the same pass.
test fn an_unmovable_entry_does_not_hold_a_movable_sibling() -> Bool {
  let root = fresh_spool(tag: "sibling")
  let wrote = record(root: root, name: worker_exit) && record(root: root, name: reviewer_exit)
  let pass = unmovable_pass(root: root)
  wrote && calls_recorded(root: root) == 1 && names_at(root: root, stage: RoleHandedOff) == [reviewer_exit] && names_in(root: root, stage_is_queued: false) == [worker_exit]
}

// THE LINE STOP. The verdict is the drain's own: this pass claimed nothing and at least one entry was
// unmovable. Only then is a stall record written, create-only, in the sibling stalled/ directory.
test fn a_pass_that_claimed_nothing_behind_an_unmovable_entry_records_the_stall() -> Bool {
  let root = fresh_spool(tag: "stall")
  let wrote = record(root: root, name: worker_exit)
  let pass = unmovable_pass(root: root)
  let reported = belt_exit_stall_failures(root: root, d: pass)
  wrote && count(reported) == 1 && match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
    SpoolStallHeld { entries } => count(entries) == 1 && (entries |> map(e => e.entry)) == [worker_exit]
    _ => false
  }
}

// Positive control: a pass that claimed a sibling is progress, not a stall; and a clean pass records nothing.
test fn a_pass_that_claimed_something_or_nothing_unmovable_records_no_stall() -> Bool {
  let root = fresh_spool(tag: "nostall")
  let wrote = record(root: root, name: worker_exit) && record(root: root, name: reviewer_exit)
  let pass = unmovable_pass(root: root)
  let clean_root = fresh_spool(tag: "clean")
  let clean_wrote = record(root: clean_root, name: reviewer_exit)
  let clean = belt_exit_drain_moving_at(
    root: clean_root,
    enqueue: (n, k) => counting_enqueue(root: clean_root, node_id: n, attempt_key: k),
    launch: fn() { counting_launch(root: clean_root) },
    observe: (n, k) => gone(),
    move: (r, e, from, to) => belt_exit_entry_move_at(root: r, entry: e, from: from, to: to),
  )
  wrote && clean_wrote
    && count(belt_exit_stall_failures(root: root, d: pass)) == 0
    && count(belt_exit_stall_failures(root: clean_root, d: clean)) == 0
    && spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) == SpoolStallNone
    && spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: clean_root)) == SpoolStallNone
}

// The record is create-only: a later stalled pass keeps the first record as the evidence.
test fn the_stall_record_is_create_only() -> Bool {
  let root = fresh_spool(tag: "createonly")
  let wrote = record(root: root, name: worker_exit)
  let p1 = unmovable_pass(root: root)
  let r1 = belt_exit_stall_failures(root: root, d: p1)
  let p2 = unmovable_pass(root: root)
  let r2 = belt_exit_stall_failures(root: root, d: p2)
  wrote && count(r1) == 1 && count(r2) == 1 && match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
    SpoolStallHeld { entries } => count(entries) == 1
    _ => false
  }
}

// Release re-claims first and deletes the record only when nothing is still unmovable.
test fn release_refuses_while_an_entry_is_unmovable_then_clears_the_record_and_hands_it_on() -> Bool {
  let root = fresh_spool(tag: "release")
  let wrote = record(root: root, name: worker_exit)
  let pass = unmovable_pass(root: root)
  let recorded = belt_exit_stall_failures(root: root, d: pass)
  let still = belt_exit_stall_release_at(root: root, move: (r, e, from, to) => refusing_move_of(entry: worker_exit, root: r, name: e, from: from, to: to))
  let held_after = match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) { SpoolStallHeld { entries: _ } => true _ => false }
  let freed = belt_exit_stall_release_at(root: root, move: belt_exit_entry_move_at)
  wrote && count(recorded) == 1 && held_after
    && match still { BeltExitStallStillUnmovable { entries } => count(entries) == 1 _ => false }
    && match freed { BeltExitStallReleased { reclaimed: _ } => true _ => false }
    && spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) == SpoolStallNone
    && names_at(root: root, stage: RoleHandedOff) == [worker_exit]
    && count(names_in(root: root, stage_is_queued: false)) == 0
}

// Analyze classifies ownership only from two successful readings: an unread principal is "owner unknown",
// never "foreign-owned" (which would point the operator at a privileged effect on no observation).
test fn analyze_does_not_call_an_entry_foreign_when_the_principal_is_unread() -> Bool {
  let root = fresh_spool(tag: "analyze")
  let wrote = record(root: root, name: worker_exit)
  let recorded = belt_exit_stall_failures(root: root, d: unmovable_pass(root: root))
  let unread = belt_exit_stall_analyze_at(root: root, whoami: BeltExitStallUnobserved { reason: "id -un refused" })
  let other = belt_exit_stall_analyze_at(root: root, whoami: BeltExitStallObserved { value: "nobody-else" })
  wrote && count(recorded) == 1
    && any(unread, l => string_contains(s: l, pattern: "owner unknown")) && !any(unread, l => string_contains(s: l, pattern: "foreign-owned"))
    && any(other, l => string_contains(s: l, pattern: "foreign-owned"))
}

// One encoding: the record is JSON, so a cause with newlines, quotes and the old " :: " separator round-trips
// byte-for-byte; and a record that is not the schema's JSON is Unreadable, never a shorter list.
test fn the_stall_record_round_trips_any_cause_and_a_corrupt_record_is_unreadable() -> Bool {
  let root = fresh_spool(tag: "json")
  let cause = "mv exited 1:\nmv: \"x\" :: Permission denied"
  let wrote = spool_stall_record_at(stalled_dir: attempt_exit_stalled_dir(instance_root: root), record_path: attempt_exit_stall_record_path(instance_root: root), unmovable: [SpoolStallEntry { entry: worker_exit, step: SpoolStallClaim, cause: cause }])
  let round_trips = match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: root)) {
    SpoolStallHeld { entries } => count(entries) == 1 && (entries |> map(e => e.cause)) == [cause] && (entries |> map(e => e.step)) == [SpoolStallClaim]
    _ => false
  }
  let bad_root = fresh_spool(tag: "badjson")
  let made = belt_exec(cmd: host_exec_argv(program: "/bin/sh", args: ["-c", join(["mkdir -p $(dirname ", attempt_exit_stall_record_path(instance_root: bad_root), ") && printf 'unmovable :: x' > ", attempt_exit_stall_record_path(instance_root: bad_root)], "")]), workdir: "/")
  let unreadable = match spool_stall_read_at(record_path: attempt_exit_stall_record_path(instance_root: bad_root)) { SpoolStallUnreadable { reason: _ } => true _ => false }
  round_trips && unreadable
}

// THE CLEAR'S ADMISSION ON SUPPLIED VALUES (a witness discriminates at one interface): the record, the readings
// (ownership is supplied: a root-owned entry cannot be made without sudo) and the entry are supplied, so each refusal
// is one boundary's answer. The effect and inhabitance claims below run the real route. -- quick-bee-65
data clear_entry: String = "n+a+worker+inv+exit-code+exited+200"

fn held_inbox() -> SpoolStallRead {
  SpoolStallHeld { entries: [SpoolStallEntry { entry: clear_entry, step: SpoolStallMove { from: RolePending, to: RoleHandedOff }, cause: "mv: Permission denied" }] }
}

fn target_refused(t: BeltExitClearTarget) -> Bool {
  match t { BeltExitClearTargetRefused { reason: _ } => true _ => false }
}

fn admission_refused(a: BeltExitClearAdmission) -> Bool {
  match a { BeltExitClearRefused { reason: _ } => true _ => false }
}

fn clear_failed(o: BeltExitClearOutcome) -> Bool {
  match o { BeltExitClearFailed { reason: _ } => true _ => false }
}

fn clear_done(o: BeltExitClearOutcome) -> Bool {
  match o { BeltExitCleared { to_path: _ } => true _ => false }
}

test fn the_clear_target_is_only_an_entry_named_in_the_current_stall_record_with_its_move() -> Bool {
  let root = "/srv/inst"
  let located = match belt_exit_stall_clear_target(root: root, held: held_inbox(), entry: clear_entry) {
    BeltExitClearTargeted { from_path, to_path } =>
      from_path == join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RolePending), "/", clear_entry], "")
        && to_path == join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RoleHandedOff), "/", clear_entry], "")
    BeltExitClearTargetRefused { reason: _ } => false
  }
  located
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: held_inbox(), entry: "someone-else"))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: held_inbox(), entry: "../../etc"))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: held_inbox(), entry: ".."))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: held_inbox(), entry: ""))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: SpoolStallNone, entry: clear_entry))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: SpoolStallUnreadable { reason: "corrupt" }, entry: clear_entry))
    && target_refused(t: belt_exit_stall_clear_target(root: root, held: SpoolStallHeld { entries: [SpoolStallEntry { entry: clear_entry, step: SpoolStallListRequests, cause: "x" }] }, entry: clear_entry))
}

test fn the_clear_admits_only_an_empty_plain_directory_the_drain_principal_does_not_own() -> Bool {
  let me = BeltExitStallObserved { value: "gunbc" }
  let root_dir = BeltExitStallObserved { value: "directory|root|755" }
  let empty = BeltExitStallObserved { value: "" }
  let admitted = match belt_exit_stall_clear_admission(stat: root_dir, whoami: me, contents: empty) { BeltExitClearAdmitted => true _ => false }
  admitted
    && admission_refused(a: belt_exit_stall_clear_admission(stat: root_dir, whoami: me, contents: BeltExitStallObserved { value: "/x/child" }))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: root_dir, whoami: me, contents: BeltExitStallUnobserved { reason: "find refused" }))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: BeltExitStallObserved { value: "directory|gunbc|755" }, whoami: me, contents: empty))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: BeltExitStallObserved { value: "symbolic link|root|777" }, whoami: me, contents: empty))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: BeltExitStallObserved { value: "regular file|root|644" }, whoami: me, contents: empty))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: BeltExitStallUnobserved { reason: "gone" }, whoami: me, contents: empty))
    && admission_refused(a: belt_exit_stall_clear_admission(stat: root_dir, whoami: BeltExitStallUnobserved { reason: "id refused" }, contents: empty))
}

// EFFECT + INHABITANCE: the real stall record, the real stat/find of a real empty entry. The entry is really owned by
// this principal, so the principal reading is supplied as another user to make it foreign-owned (ownership is the one
// supplied value). The clear lands the entry in queued under the same name and removes it from inbox; a re-run with the
// target already present and the source recreated runs only the rmdir; a non-empty, an unrecorded and a symlinked
// entry are refused with nothing created; analyze names this verb.
test fn the_real_clear_re_materializes_the_entry_in_queued_idempotently_and_refuses_the_rest() -> Bool {
  let root = fresh_spool(tag: "clear")
  let wrote = record(root: root, name: worker_exit)
  let recorded = belt_exit_stall_failures(root: root, d: unmovable_pass(root: root))
  let other = BeltExitStallObserved { value: "nobody-else" }
  let report = belt_exit_stall_analyze_at(root: root, whoami: other)
  let inbox_entry = join([spool_witness_dir(kind: SpoolAttemptExit, instance_root: root, role: RolePending), "/", worker_exit], "")
  let filled = belt_exec(cmd: host_exec_argv(program: "mkdir", args: ["--", join([inbox_entry, "/child"], "")]), workdir: "/")
  let refused_full = belt_exit_stall_clear_at(root: root, entry: worker_exit, whoami: other)
  let untouched = names_at(root: root, stage: RolePending) == [worker_exit] && count(names_at(root: root, stage: RoleHandedOff)) == 0
  let emptied = belt_exec(cmd: host_exec_argv(program: "rmdir", args: ["--", join([inbox_entry, "/child"], "")]), workdir: "/")
  let refused_absent = belt_exit_stall_clear_at(root: root, entry: "not-recorded", whoami: other)
  let first = belt_exit_stall_clear_at(root: root, entry: worker_exit, whoami: other)
  let landed = names_at(root: root, stage: RoleHandedOff) == [worker_exit] && count(names_at(root: root, stage: RolePending)) == 0
  let reborn = belt_exec(cmd: host_exec_argv(program: "mkdir", args: ["--", inbox_entry]), workdir: "/")
  let rerun = belt_exit_stall_clear_at(root: root, entry: worker_exit, whoami: other)
  let idempotent = names_at(root: root, stage: RoleHandedOff) == [worker_exit] && count(names_at(root: root, stage: RolePending)) == 0
  let swapped = belt_exec(cmd: host_exec_argv(program: "ln", args: ["-s", "/tmp", inbox_entry]), workdir: "/")
  let linked = belt_exit_stall_clear_at(root: root, entry: worker_exit, whoami: other)
  wrote && count(recorded) == 1
    && clear_failed(o: refused_full) && untouched
    && clear_failed(o: refused_absent)
    && clear_done(o: first) && landed
    && clear_done(o: rerun) && idempotent
    && clear_failed(o: linked)
    && any(report, l => string_contains(s: l, pattern: "belt_exit_stall_clear_cli") && string_contains(s: l, pattern: "entry="))
}

// THE STEP DECODES ONCE, AT READ: every spelling an earlier head wrote still decodes (the lab's live record wrote
// "inbox -> queued"), each decodes to the typed step that renders back to it, and an unknown spelling is refused
// rather than guessed. -- quick-bee-65
test fn a_recorded_step_decodes_once_to_a_typed_step_and_an_unknown_spelling_is_refused() -> Bool {
  let moved = match spool_stall_step_of_text(text: "inbox -> queued") { Present { value: SpoolStallMove { from, to } } => from == RolePending && to == RoleHandedOff _ => false }
  let claim = match spool_stall_step_of_text(text: "claim") { Present { value: SpoolStallClaim } => true _ => false }
  let listed = match spool_stall_step_of_text(text: "list-requests") { Present { value: SpoolStallListRequests } => true _ => false }
  let renders = spool_stall_step_text(step: SpoolStallMove { from: RoleClaimed, to: RoleHandedOff }) == "running -> queued"
  let refused = match spool_stall_step_of_text(text: "inbox => queued") { Absent => true _ => false }
  moved && claim && listed && renders && refused && match spool_stall_step_of_text(text: "somewhere else") { Absent => true _ => false }
}

fn spool_witness_dir(kind: SpoolKind, instance_root: String, role: SpoolRole) -> String {
  match spool_role_path(store: spool_open(kind: kind, instance_root: instance_root), role: role) {
    Present { value: d } => d
    Absent => "<the spool declares no directory for this role>"
  }
}
