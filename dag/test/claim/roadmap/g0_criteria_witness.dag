test fn g0_every_condition_key_listed_once() -> Bool {
  g0_key_listed_once({'key': 'ProtectHomeReadonlyRendered', 'group': 'OperatorHome', 'requires': 'The worker unit property list rendered by gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties on the UnitRunOnSystemManager route contains ProtectHome=read-only (emitted by gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties), rendered to text by gunbc.extdeps.systemd.systemd_run::systemd_run_property_assignment, and the non-hardened route arm does NOT contain it. The negative case: if the check passes on the stripped render, it does not measure the property.', 'mod': 'gunbc.roadmap.dispatch_worker_unit_confinement', 'decl': 'dispatch_worker_unit_stream_properties', 'cites': ['gunbc.extdeps.systemd.systemd_run', 'gunbc.extdeps.systemd.systemd_run::systemd_run_property_assignment', 'gunbc.roadmap.dispatch_worker_unit_confinement', 'gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties', 'gunbc.roadmap.roadmap_dispatch_actuator', 'gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties']})
    && g0_key_listed_once({'key': 'OperatorHomeNotInHandedReadWritePaths', 'group': 'OperatorHome', 'requires': "No rendered ReadWritePaths= entry from the handed set (gunbc.roadmap.dispatch_worker_handed_set) begins with the operator home prefix (/home/<login>) unless the entry lies under the instance's own root. The srv2 preview root is under operator home by design (see the [srv2-root-inside-operator-home] finding). The negative case: a hand-constructed handed set containing /home/briansrls/some-path-outside-the-instance-root makes the check fail.", 'mod': 'gunbc.roadmap.roadmap_dashboard_instance', 'decl': 'srv2_dashboard_preview_root', 'cites': ['gunbc.roadmap.dispatch_worker_handed_set']})
    && g0_key_listed_once({'key': 'ProtectSystemStrictRendered', 'group': 'Credentials', 'requires': 'The worker unit property list rendered by gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties contains ProtectSystem=strict (emitted by gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties) and the non-hardened route arm does not. The negative case: if the check passes on the stripped render, it does not measure the property.', 'mod': 'gunbc.roadmap.dispatch_worker_unit_confinement', 'decl': 'dispatch_worker_unit_stream_properties', 'cites': ['gunbc.roadmap.dispatch_worker_unit_confinement', 'gunbc.roadmap.dispatch_worker_unit_confinement::dispatch_worker_unit_stream_properties', 'gunbc.roadmap.roadmap_dispatch_actuator', 'gunbc.roadmap.roadmap_dispatch_actuator::dispatch_worker_unit_properties']})
