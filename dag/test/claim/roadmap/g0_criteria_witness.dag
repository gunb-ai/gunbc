    && g0_key_listed_once({'key': 'SupplementaryGroupsNoRootEquivalent', 'group': 'PrivilegeGroups', 'requires': 'The intersection of the worker\'s declared supplementary group list (gunbc.fleet.fleet_posix_accounts::fleet_posix_worker_supplementary_groups) and the declared root-equivalent group list (gunbc.fleet.fleet_root_equivalent_groups::fleet_root_equivalent_group_names) is empty. The negative case: a hand-modified supplementary group list containing \\"docker\\" makes the check fail.', 'mod': 'gunbc.fleet.fleet_posix_accounts', 'decl': 'fleet_posix_worker_supplementary_groups', 'cites': ['gunbc.fleet.fleet_posix_accounts', 'gunbc.fleet.fleet_posix_accounts::fleet_posix_worker_supplementary_groups', 'gunbc.fleet.fleet_root_equivalent_groups', 'gunbc.fleet.fleet_root_equivalent_groups::fleet_root_equivalent_group_names']})
