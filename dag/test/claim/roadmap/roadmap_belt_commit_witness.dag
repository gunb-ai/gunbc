module test.claim.roadmap.roadmap_belt_commit_witness

import std.types { Bool, String, Int }
import gunbc.roadmap.roadmap_belt_commit { BeltCommitDecision, CandidateCommitNeeded, CheckpointCommitNeeded, CommitNotNeeded, belt_commit_decision }
import gunbc.roadmap.roadmap_submission { SubmissionAbsent, SubmissionDeclared, SubmissionUndecodable, WorkerSubmission, SubmissionReady, submission_digest }
import gunbc.roadmap.roadmap_provider_events { ProviderExecutionState, ProviderNotStarted, ProviderStarting, ProviderRunning, ProviderCompleted, ProviderFailed, ProviderBudgetSpent, ProviderEventsRefused, ProviderRequestPending }

fn ready_submission() -> WorkerSubmission {
  WorkerSubmission { readiness: SubmissionReady, explanation: "done", limitations: "none" }
}

test fn a_terminal_worktree_without_a_submission_is_a_checkpoint_not_a_candidate() -> Bool {
  match belt_commit_decision(
    provider: ProviderCompleted { activity: "done" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: " M a.dag\0",
    submission: SubmissionAbsent,
    captures: [],
  ) {
    CheckpointCommitNeeded { message, note: _ } => message == "dispatch checkpoint: n1 aabc"
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
    CommitNotNeeded { reason: _ } => false
  }
}

test fn a_budget_spent_worktree_without_a_submission_is_preserved_as_a_checkpoint() -> Bool {
  match belt_commit_decision(
    provider: ProviderBudgetSpent { activity: "stopped", detail: "" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: " M a.dag\0",
    submission: SubmissionAbsent,
    captures: [],
  ) {
    CheckpointCommitNeeded { message: _, note } =>
      match note {
        _ => note != ""
      }
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
    CommitNotNeeded { reason: _ } => false
  }
}

test fn a_fresh_ready_submission_makes_the_commit_a_candidate() -> Bool {
  match belt_commit_decision(
    provider: ProviderCompleted { activity: "done" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: " M a.dag\0",
    submission: SubmissionDeclared { submission: ready_submission(), digest: submission_digest(submission: ready_submission()) },
    captures: [],
  ) {
    CandidateCommitNeeded { message, submission: _, digest: _, handin: _ } => message == "dispatch candidate: n1 aabc"
    CheckpointCommitNeeded { message: _, note: _ } => false
    CommitNotNeeded { reason: _ } => false
  }
}

test fn an_undecodable_submission_is_not_a_declaration() -> Bool {
  match belt_commit_decision(
    provider: ProviderCompleted { activity: "done" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: " M a.dag\0",
    submission: SubmissionUndecodable { reason: "not json" },
    captures: [],
  ) {
    CheckpointCommitNeeded { message: _, note } => note != ""
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
    CommitNotNeeded { reason: _ } => false
  }
}

test fn commit_is_not_needed_for_a_completed_clean_worktree() -> Bool {
  match belt_commit_decision(
    provider: ProviderCompleted { activity: "done" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: "",
    submission: SubmissionAbsent,
    captures: [],
  ) {
    CommitNotNeeded { reason: _ } => true
    CheckpointCommitNeeded { message: _, note: _ } => false
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
  }
}

test fn commit_is_not_needed_while_the_provider_runs() -> Bool {
  match belt_commit_decision(
    provider: ProviderRunning { activity: "x" },
    node_id: "n1",
    attempt_key: "abc",
    entries_nul: " M a.dag\0",
    submission: SubmissionDeclared { submission: ready_submission(), digest: submission_digest(submission: ready_submission()) },
    captures: [],
  ) {
    CommitNotNeeded { reason: _ } => true
    CheckpointCommitNeeded { message: _, note: _ } => false
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
  }
}

test fn a_failed_provider_with_a_dirty_worktree_and_no_submission_still_checkpoints() -> Bool {
  match belt_commit_decision(provider: ProviderFailed { activity: "agent turn failed", detail: "step budget exhausted" }, node_id: "n1", attempt_key: "abc", entries_nul: " M a.dag\0", submission: SubmissionAbsent, captures: []) {
    CheckpointCommitNeeded { message, note: _ } => message as String == "dispatch checkpoint: n1 aabc"
    CandidateCommitNeeded { message: _, submission: _, digest: _, handin: _ } => false
    CommitNotNeeded { reason: _ } => false
  }
}

// THE PENDING REQUEST RUNS THE COMMIT STEP (the yield that records the capture). It is treated exactly
// like a failed worker that handed in nothing: no candidate is minted, but the step SETTLES -- a clean
// worktree is CommitNotNeeded, a dirty round is CheckpointCommitNeeded (the partial work is preserved for
// the re-delivery). Either way the step records itself, so the capture reads CaptureAbsent and the
// continuation can reach its request-pending branch. Before the projection owed it a capture, this arm
// was never reached and the capture stayed not-attempted.
test fn a_pending_request_with_a_dirty_worktree_and_no_submission_checkpoints() -> Bool {
  match belt_commit_decision(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" }, node_id: "n1", attempt_key: "e5a42384c6a5e13d", entries_nul: " M a.dag\0", submission: SubmissionAbsent, captures: []) {
    CheckpointCommitNeeded { message: _, note: _ } => true
    _ => false
  }
}

test fn a_pending_request_with_a_clean_worktree_needs_no_commit() -> Bool {
  match belt_commit_decision(provider: ProviderRequestPending { activity: "request-pending", detail: "{}" }, node_id: "n1", attempt_key: "e5a42384c6a5e13d", entries_nul: "", submission: SubmissionAbsent, captures: []) {
    CommitNotNeeded { reason: _ } => true
    _ => false
  }
}
