module test.claim.roadmap.roadmap_gate

import test.claim.roadmap.roadmap_node_fixture { fx_derivable }

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn mini_doc(node: RoadmapNode) -> RoadmapDocument {
  RoadmapDocument {
    preamble: [],
    lead_lanes: [],
    sections: [RoadmapSection {
      title: "Acceptance gate",
      elements: [section_group(label: "", nodes: [node], edges: [])],
    }],
  }
}

fn emit_node(node: RoadmapNode, merged: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_to_markdown(doc: mini_doc(node: node), merged: merged))
}

test fn witness_clean_not_drift() -> Bool {
  !roadmap_drifted(committed: expected_roadmap_md())
}

test fn witness_hand_edit_drifts() -> Bool {
  roadmap_drifted(committed: concat(expected_roadmap_md(), "\n- [x] **a hand-added line**"))
}

test fn witness_unsigned_with_evidence_awaiting() -> Bool {
  let node = fx_derivable(identity: "rnfx_82B698TW1CS8DZ9WGJBX", id: "acceptance-witness", prs: [5491], title: "**acceptance witness**", description: "")
  let out = emit_node(node: node, merged: [5491])
  string_contains(s: out, pattern: "[ ] **acceptance witness**")
    && string_contains(s: out, pattern: "⏳ awaiting an acceptance receipt")
    && !string_contains(s: out, pattern: "[x] **acceptance witness**")
}

// A merged PR never checks the box: a node definition carries no acceptance, so implementation
// evidence leaves the row unchecked whether or not its PR merged (the acceptance history, not the
// row, is what closes a node).
test fn witness_merge_perturb_does_not_flip_box() -> Bool {
  let unsigned_node = fx_derivable(identity: "rnfx_19FCXZK9ZJR91QKHYAFR", id: "acceptance-witness", prs: [5491], title: "**acceptance witness**", description: "")
  string_contains(s: emit_node(node: unsigned_node, merged: []), pattern: "[ ] **acceptance witness**")
    && string_contains(s: emit_node(node: unsigned_node, merged: [5491]), pattern: "[ ] **acceptance witness**")
}
