import gunbc.harness.harness_wire { WireToolUseBlock }
import gunbc.harness.harness_tool_kind {
  HarnessTool, RunCommandTool, ReadFileTool, WriteFileTool, EditFileTool, harness_tool_wire_name,
}
import std.measure { character_count, character_count_value }
import gunbc.harness.harness_turn { harness_event_placement_waiting, harness_tool_round_events }
import gunbc.roadmap_provider_events {
  CodexItemActivity, CodexRunningCommand, CodexEditingFiles, CodexUsingConnectedTool, CodexSearching,
  CodexUpdatingPlan, CodexReasoningItem, CodexReporting, HarnessReadingFile, HarnessWritingFile,
  HarnessEditingFile, HarnessRefusingUnrecognizedTool, CodexUnclassifiedItem,
  ItemStarted, ItemCompleted,
  ProviderEventsParsed,
  ProviderEventStreamRefused,
  ProviderRunning,
  ProviderAwaitingSeat,
  ProviderCompleted,
  ProviderFailed,
  ProviderBudgetSpent,
  ProviderEventsRefused,
  parse_codex_jsonl,
  parse_codex_jsonl_with_line_budget,
  classify_provider_event_line,
  ProviderEventObserved,
  ProviderEventSkipped,
  ProviderEventLineRefused,
  SkipRateLimitEvent,
  SkipClaudeUserWithoutToolResult,
  ThreadStarted,
  TurnCompleted,
  TurnFailed,
  codex_provider_event_line_observation_budget,
  codex_provider_projection_type_budget,
  codex_provider_projection_detail_budget,
  codex_provider_projection_message_budget,
  codex_provider_event_projection_filter,
  provider_execution_state,
  provider_execution_state_label,
  provider_execution_detail,
}

data successful_codex_jsonl: String = "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item-1\",\"type\":\"file_change\",\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item-1\",\"type\":\"file_change\",\"status\":\"completed\"}}\n{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":10,\"output_tokens\":3}}\n"

test fn a_harness_round_usage_event_is_accounted_not_refused() -> Bool {
  let parsed = parse_codex_jsonl(
    text: "{\"type\":\"turn.started\"}\n{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":900,\"output_tokens\":120,\"epoch_ms\":1000000,\"files_changed\":0}\n{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
  )
  match parsed {
    ProviderEventStreamRefused { events_before_refusal: _, line_number: _, raw: _, reason: _ } => false
    _ =>
      match provider_execution_state(parsed: parsed) {
        ProviderRunning { activity } => activity == "Agent working · running command"
        _ => false
      }
  }
}

test fn codex_stream_classifies_running_activity() -> Bool {
  let parsed = parse_codex_jsonl(
    text: "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
  )
  match provider_execution_state(parsed: parsed) {
    ProviderRunning { activity } => activity == "Agent working · running command"
    _ => false
  }
}

test fn codex_completed_is_terminal_only_from_provider_event() -> Bool {
  match provider_execution_state(parsed: parse_codex_jsonl(text: successful_codex_jsonl)) {
    ProviderCompleted { activity } => activity == "Agent complete"
    _ => false
  }
}

test fn codex_completed_state_is_terminal() -> Bool {
  match provider_execution_state(
    parsed: parse_codex_jsonl(
      text: join([
        successful_codex_jsonl,
        "{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
      ], ""),
    ),
  ) {
    ProviderCompleted { activity } => activity == "Agent complete"
    _ => false
  }
}

test fn codex_turn_failed_preserves_raw_provider_evidence() -> Bool {
  let failed = "{\"type\":\"turn.failed\",\"error\":{\"message\":\"usage exhausted\"}}"
  match provider_execution_state(parsed: parse_codex_jsonl(text: failed)) {
    ProviderFailed { activity, detail } =>
      activity == "agent turn failed"
        && string_contains(s: detail, pattern: "usage exhausted")
    _ => false
  }
}

// DISCRIMINATING: the spent budget is its own terminal. The same stream through turn.failed lands in
// ProviderFailed (the witness above), so a fold that collapsed the two would answer "failed" here.
test fn a_spent_step_budget_is_budget_spent_not_failed() -> Bool {
  let text = "{\"type\":\"turn.started\"}\n{\"type\":\"turn.budget_exhausted\",\"steps_taken\":40}\n"
  let state = provider_execution_state(parsed: parse_codex_jsonl(text: text))
  match state {
    ProviderBudgetSpent { activity, detail } =>
      activity == "Agent stopped at its round budget"
        && string_contains(s: detail, pattern: "\"steps_taken\":40")
        && provider_execution_state_label(state: state) == "budget_spent"
    _ => false
  }
}

test fn codex_error_is_not_absorbed_into_spawned() -> Bool {
  let state = provider_execution_state(
    parsed: parse_codex_jsonl(
      text: "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"error\",\"message\":\"upstream unavailable\"}\n",
    ),
  )
  provider_execution_state_label(state: state) == "failed"
    && string_contains(
      s: provider_execution_detail(state: state),
      pattern: "upstream unavailable",
    )
}

test fn truncated_line_refuses_with_location_and_raw() -> Bool {
  let truncated = "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n{\"type\":\"item.started\""
  match parse_codex_jsonl(text: truncated) {
    ProviderEventsParsed { events: _ } => false
    ProviderEventStreamRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 1
        && line_number == 2
        && raw == "{\"type\":\"item.started\""
        && string_contains(s: reason, pattern: "truncated")
  }
}

test fn unknown_event_refuses_instead_of_guessing_progress() -> Bool {
  let parsed = parse_codex_jsonl(text: "{\"type\":\"future.event\",\"value\":1}\n")
  match provider_execution_state(parsed: parsed) {
    ProviderEventsRefused { activity: _, detail } =>
      string_contains(s: detail, pattern: "unknown provider JSONL event type")
        && string_contains(s: detail, pattern: "future.event")
    _ => false
  }
}

test fn nested_type_token_cannot_fabricate_terminal_success() -> Bool {
  let parsed = parse_codex_jsonl(
    text: "{\"kind\":\"future.event\",\"payload\":{\"type\":\"turn.completed\"}}\n",
  )
  match provider_execution_state(parsed: parsed) {
    ProviderEventsRefused { activity: _, detail } =>
      string_contains(s: detail, pattern: "malformed Claude stream-json line")
    _ => false
  }
}

test fn braced_but_invalid_json_cannot_fabricate_terminal_success() -> Bool {
  match parse_codex_jsonl(text: "{\"type\":\"turn.completed\",}\n") {
    ProviderEventsParsed { events: _ } => false
    ProviderEventStreamRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 0
        && line_number == 1
        && raw == "{\"type\":\"turn.completed\",}"
        && string_contains(s: reason, pattern: "malformed")
  }
}

test fn oversized_event_refuses_without_echoing_payload() -> Bool {
  let secret = "large-command-output-must-stay-in-the-attempt-evidence-file"
  let oversized = join([
    "{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"aggregated_output\":\"",
    secret,
    "\"}}\n",
  ], "")
  match parse_codex_jsonl_with_line_budget(
    text: oversized,
    line_budget: character_count(count: 48),
  ) {
    ProviderEventsParsed { events: _ } => false
    ProviderEventStreamRefused {
      events_before_refusal,
      line_number,
      raw,
      reason,
    } =>
      count(events_before_refusal) == 0
        && line_number == 1
        && string_contains(s: raw, pattern: "oversized")
        && !string_contains(s: raw, pattern: secret)
        && string_contains(s: reason, pattern: "observation line budget 48")
        && string_contains(s: reason, pattern: "full raw remains")
  }
}

test fn refusal_marks_prior_activity_as_historical() -> Bool {
  let parsed = parse_codex_jsonl_with_line_budget(
    text: join([
      "{\"type\":\"item.started\",\"item\":{\"type\":\"command_execution\"}}\n",
      "{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"aggregated_output\":\"payload too large\"}}\n",
    ], ""),
    line_budget: character_count(count: 80),
  )
  match provider_execution_state(parsed: parsed) {
    ProviderEventsRefused { activity, detail } =>
      activity == "last observed · Agent working · running command"
        && string_contains(s: detail, pattern: "observation line budget 80")
    _ => false
  }
}

// Forces the three CharacterCount budget rows to EVALUATE, not merely typecheck. A data row can
// pass every single-entry witness and still fail in CI's affected-set re-eval leg, which evaluates
// changed data items — that is exactly how `2 as Seconds` shipped green from this branch. Reading
// the values here makes an unevaluable budget row red locally.

test fn the_projection_keeps_the_round_usage_clock_and_tokens() -> Bool {
  let f = codex_provider_event_projection_filter as String
  string_contains(s: f, pattern: "$type == \"round.usage\"")
    && string_contains(s: f, pattern: "\"epoch_ms\":(.epoch_ms | num)")
    && string_contains(s: f, pattern: "\"output_tokens\":(.output_tokens | num)")
    && string_contains(s: f, pattern: "{\"files_changed\":.files_changed}")
}

test fn codex_character_budgets_are_measured_counts() -> Bool {
  character_count_value(c: codex_provider_event_line_observation_budget) == 65536
    && character_count_value(c: codex_provider_projection_type_budget) == 128
    && character_count_value(c: codex_provider_projection_detail_budget) == 4096
    && string_contains(
      s: codex_provider_event_projection_filter as String,
      pattern: "[0:128]",
    )
}

// review 44058. The activity read used to scan the WHOLE projected line for a "type":"…" fragment,
// so a sibling or nested object carrying another item type reclassified the pane — the same shape
// the top-level classifier is already anchored against
// (nested_type_token_cannot_fabricate_terminal_success, right above). The pair is discriminating in
// both directions: the forged line puts item.type = agent_message beside a sibling object spelling
// file_change, and the old scan answered "editing files" on it because file_change is tested before
// agent_message; the genuine line proves the anchored walk still finds a real file_change rather
// than having simply stopped working. Reachability: today the projector emits only a top-level type
// plus an item object carrying only its own type, so the sibling shape arrives on projector drift
// or on any future direct read of the raw stream — this is the defense-in-depth the top-level
// anchor already carries, applied to the member beneath it.

fn activity_of(text: String) -> String {
  match provider_execution_state(parsed: parse_codex_jsonl(text: text)) {
    ProviderRunning { activity } => activity
    _ => ""
  }
}

test fn codex_agent_message_completed_is_finishing_not_complete() -> Bool {
  match provider_execution_state(parsed: parse_codex_jsonl(
    text: join([
      "{\"type\":\"thread.started\",\"thread_id\":\"thread-1\"}\n",
      "{\"type\":\"turn.started\"}\n",
      "{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"done\"}}\n",
    ], ""),
  )) {
    ProviderRunning { activity } => activity == "Agent finishing"
    ProviderCompleted { activity: _ } => false
    _ => false
  }
}

test fn codex_item_activity_ignores_a_quoted_type_in_the_payload() -> Bool {
  let forged = activity_of(
    text: "{\"type\":\"item.started\",\"item\":{\"type\":\"agent_message\"},\"echo\":{\"type\":\"file_change\"}}\n",
  )
  let genuine = activity_of(
    text: "{\"type\":\"item.started\",\"item\":{\"type\":\"file_change\"}}\n",
  )
  forged == "Agent working · reporting" && genuine == "Agent working · editing files"
}

// The agent REPORT members of the projection filter, pinned as a string contract because the filter
// is a jq program the substrate assembles but does not itself interpret
// (codex_projection_filter_scaffold_note). Nothing downstream of the shell can prove what the
// projector emitted, so the claims that matter here are: the report bound is the MESSAGE budget and
// not the detail budget beside it (a copy-paste of the wrong bound would still emit valid jq and
// still look fine on a short message, failing only on the day a long one arrived); the truncation
// flag is computed with a length comparison against the ORIGINAL text, so it describes the provider
// output rather than the slice; and the anchored item.type walk is untouched, since the report is
// emitted as a member AFTER item.type and the walk depends on that position. The behavioural half —
// real captured events through real jq — is dag/test/fixture/codex_provider_events, whose third
// line carries the item.text this filter reads.

fn projection_filter_text() -> String { codex_provider_event_projection_filter as String }

fn message_budget_chars() -> Int { character_count_value(c: codex_provider_projection_message_budget) }

fn detail_budget_chars() -> Int { character_count_value(c: codex_provider_projection_detail_budget) }

test fn agent_report_is_bounded_by_the_message_budget() -> Bool {
  string_contains(
    s: projection_filter_text(),
    pattern: concat(".item.text[0:", concat(to_string(message_budget_chars()), "]")),
  )
}

test fn agent_report_budget_is_not_the_detail_budget() -> Bool {
  let m = message_budget_chars()
  let d = detail_budget_chars()
  !(m == d)
}

test fn agent_report_declares_truncation_from_original_length() -> Bool {
  string_contains(s: projection_filter_text(), pattern: "\"truncated\":((.item.text | length) > ")
    && string_contains(s: projection_filter_text(), pattern: "agent_message")
}

test fn agent_report_does_not_disturb_the_item_type_anchor() -> Bool {
  string_contains(s: projection_filter_text(), pattern: "\"item\":{\"type\":item_type,\"message\":agent_report}")
    && string_contains(s: projection_filter_text(), pattern: "\"item\":{\"type\":item_type}")
}

// A WORKER WAITING IN LINE FOR A SEAT IS READ AS WAITING, NOT AS A TURN THAT NEVER STARTED. The line
// is the harness's own producer (gunbc.harness.harness_turn harness_event_placement_waiting), so the
// pair below is the real producer into the real reader: the reason it was refused a seat reaches the
// dashboard detail, and the wait counter with it. Before the arm existed the line classified as an
// unknown event type and the whole stream was refused.
fn waiting_line(wait: Int, reason: String) -> String {
  concat(harness_event_placement_waiting(wait: wait, wait_cap: 1440, reason: reason), "\n")
}

test fn a_placement_wait_is_awaiting_seat_with_its_reason() -> Bool {
  match provider_execution_state(parsed: parse_codex_jsonl(text: waiting_line(wait: 2, reason: "group-b: the engine reports 12 occupant(s)"))) {
    ProviderAwaitingSeat { detail } =>
      string_contains(s: detail, pattern: "group-b: the engine reports 12 occupant(s)")
        && string_contains(s: detail, pattern: "wait 2 of 1440")
    _ => false
  }
}

test fn a_placement_wait_is_labelled_awaiting_seat_and_carries_its_detail() -> Bool {
  let state = provider_execution_state(parsed: parse_codex_jsonl(text: waiting_line(wait: 1, reason: "group-a unavailable")))
  provider_execution_state_label(state: state) == "awaiting_seat"
    && string_contains(s: provider_execution_detail(state: state), pattern: "group-a unavailable")
}

// The wait is not sticky: once placed, the first provider event moves the attempt on.
test fn a_placed_turn_leaves_the_wait_behind() -> Bool {
  match provider_execution_state(parsed: parse_codex_jsonl(text: join([
    waiting_line(wait: 1, reason: "busy"),
    "{\"type\":\"turn.started\"}\n",
  ], ""))) {
    ProviderRunning { activity: _ } => true
    _ => false
  }
}

// And it is pinned through the projector: an unknown type is projected to {"type"} alone, which
// would deliver the wait with its reason stripped.
test fn the_projector_keeps_the_wait_reason() -> Bool {
  string_contains(s: projection_filter_text(), pattern: "elif $type == \"turn.placement_waiting\" then {\"type\":$type,\"wait\":(.wait | num),\"wait_cap\":(.wait_cap | num),\"reason\":(.reason | bounded_text)}")
}

// THE TOOL A ROUND DISPATCHED IS THE ACTIVITY THE READER REPORTS, real emitter into real reader.
// Each stream below is what gunbc.harness.harness_turn harness_tool_round_events writes for one
// tool use, and each is read by parse_codex_jsonl with nothing supplied in between, so deleting the
// derivation at either end reddens these: an emitter that writes one kind for every tool collapses
// the four tags to one, and a reader that re-spells a kind the emitter does not write falls to
// "other". The tag is this file's own exhaustive discriminator over the typed activity, so the
// claims read the arm and not the operator-facing label.
fn activity_tag(activity: CodexItemActivity) -> String {
  match activity {
    CodexRunningCommand => "run"
    HarnessReadingFile => "read"
    HarnessWritingFile => "write"
    HarnessEditingFile => "edit"
    HarnessRefusingUnrecognizedTool => "undeclared"
    CodexEditingFiles => "other"
    CodexUsingConnectedTool => "other"
    CodexSearching => "other"
    CodexUpdatingPlan => "other"
    CodexReasoningItem => "other"
    CodexReporting => "other"
    CodexUnclassifiedItem => "other"
  }
}

fn tool_use_round_tags(name: String) -> String {
  let lines = harness_tool_round_events(
    uses: [WireToolUseBlock { id: "toolu_1", name: name, input: json_object([]) }],
  )
  match parse_codex_jsonl(text: concat(join(lines, "\n"), "\n")) {
    ProviderEventStreamRefused { events_before_refusal: _, line_number: _, raw: _, reason: _ } => "refused"
    ProviderEventsParsed { events } =>
      join(
        fold(
          events,
          init: [],
          f: (acc, e) => concat(acc, [
            match e.kind {
              ItemStarted { activity } => join(["started:", activity_tag(activity: activity)], "")
              ItemCompleted { activity } => join(["completed:", activity_tag(activity: activity)], "")
              _ => "not-an-item"
            },
          ]),
        ),
        ",",
      )
  }
}

fn harness_tool_round_tags(tool: HarnessTool) -> String {
  tool_use_round_tags(name: harness_tool_wire_name(tool: tool) as String)
}

test fn a_harness_command_round_is_read_back_as_running_a_command() -> Bool {
  harness_tool_round_tags(tool: RunCommandTool) == "started:run,completed:run"
}

test fn a_harness_file_read_round_is_read_back_as_reading_not_running() -> Bool {
  harness_tool_round_tags(tool: ReadFileTool) == "started:read,completed:read"
}

test fn a_harness_file_write_round_is_read_back_as_writing() -> Bool {
  harness_tool_round_tags(tool: WriteFileTool) == "started:write,completed:write"
}

test fn a_harness_file_edit_round_is_read_back_as_editing_apart_from_writing() -> Bool {
  harness_tool_round_tags(tool: EditFileTool) == "started:edit,completed:edit"
}

// A NAME THE HARNESS DOES NOT DECLARE IS NEVER REPORTED AS A COMMAND. The dispatcher refuses such a
// use; the stream says it was an undeclared tool rather than guessing a kind for it.
test fn an_undeclared_tool_round_is_read_back_as_undeclared_not_as_a_command() -> Bool {
  tool_use_round_tags(name: "delete_everything") == "started:undeclared,completed:undeclared"
}

test fn classify_claude_system_line_is_thread_started() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"system\",\"subtype\":\"init\"}") {
    ProviderEventObserved { kind } =>
      match kind {
        ThreadStarted => true
        _ => false
      }
    _ => false
  }
}

test fn classify_claude_assistant_tool_use_is_item_started_running() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"name\":\"Bash\"}]}}") {
    ProviderEventObserved { kind } =>
      match kind {
        ItemStarted { activity } =>
          match activity {
            CodexRunningCommand => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn classify_claude_result_success_is_turn_completed() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}") {
    ProviderEventObserved { kind } =>
      match kind {
        TurnCompleted => true
        _ => false
      }
    _ => false
  }
}

test fn classify_claude_result_error_is_turn_failed() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"api_error_status\":401}") {
    ProviderEventObserved { kind } =>
      match kind {
        TurnFailed => true
        _ => false
      }
    _ => false
  }
}

test fn classify_claude_rate_limit_is_skipped() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"unifiedWindows\":{}}}") {
    ProviderEventSkipped { reason } =>
      match reason {
        SkipRateLimitEvent => true
        _ => false
      }
    _ => false
  }
}

test fn classify_claude_user_without_tool_result_is_skipped() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"text\"}]}}") {
    ProviderEventSkipped { reason } =>
      match reason {
        SkipClaudeUserWithoutToolResult => true
        _ => false
      }
    _ => false
  }
}

test fn classify_unknown_event_type_is_refused() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"future.event\",\"value\":1}") {
    ProviderEventLineRefused { reason } =>
      string_contains(s: reason, pattern: "unknown provider JSONL event type")
    _ => false
  }
}

test fn classify_malformed_claude_result_line_is_refused() -> Bool {
  match classify_provider_event_line(raw: "{\"type\":\"result\"}") {
    ProviderEventLineRefused { reason } =>
      string_contains(s: reason, pattern: "malformed Claude stream-json line")
    _ => false
  }
}

// INHABITANCE: the real parse fold over a captured stream shape, including a skipped rate-limit
// line between observations. Deleting parse_codex_jsonl would make this fail.
test fn a_claude_stream_json_turn_is_read_as_provider_events_including_skipped_rate_limit() -> Bool {
  let parsed = parse_codex_jsonl(
    text: "{\"type\":\"system\"}\n{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"unifiedWindows\":{}}}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\"}]}}\n{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}\n",
  )
  match parsed {
    ProviderEventStreamRefused { events_before_refusal: _, line_number: _, raw: _, reason: _ } => false
    ProviderEventsParsed { events } =>
      count(events) == 3
        && match provider_execution_state(parsed: parsed) {
          ProviderCompleted { activity: _ } => true
          _ => false
        }
  }
}

test fn a_harness_tool_round_reaches_the_operator_as_its_own_activity() -> Bool {
  let read_line = concat(join(harness_tool_round_events(
    uses: [WireToolUseBlock { id: "toolu_1", name: harness_tool_wire_name(tool: ReadFileTool) as String, input: json_object([]) }],
  ), "\n"), "\n")
  activity_of(text: read_line) == "Agent working · reading file"
}
