data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data unreadable_carrier_text_fixture: String = "{ not json"

// For the histories a claim BUILDS BY HAND, whose content the claim controls: this log retires NOTHING,
// and — unlike an unreadable lane — that is a fact the read established, so it travels as a Loaded empty
// set: an unreadable retired set would refuse the plan. Claims over the shared CARRIER must not use this:
// the carrier's own last line is a remains-superseded revocation, so the retired set it depends on is
// receipt_continuity_acceptance_carrier_retired_ids, and an empty set there is a contradicted fixture.
fn no_retired_nodes() -> RoadmapRetiredNodeIds {
  RetiredNodeIdsLoaded { ids: [] }
}

fn fixture_history_load() -> RoadmapAcceptanceEventHistoryLoad {
  load_roadmap_acceptance_event_history_from_carrier_text(
    text: receipt_continuity_acceptance_carrier_fixture_text,
  )
}

fn namespace_occurrence_transport_receipt(live: List<RoadmapAcceptanceReceipt>) -> RoadmapAcceptanceReceipt? {
  first(live |> filter(r => r.node == nid(s: "namespace-occurrence-transport")))
}

fn history_without_namespace_occurrence_transport(history: List<RoadmapAcceptanceEvent>) -> List<RoadmapAcceptanceEvent> {
  history
    |> filter(e =>
      match e {
        AcceptanceRecorded { receipt: r } => r.node != nid(s: "namespace-occurrence-transport")
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true
      }
    )
}

fn exact_revocation_for(receipt: RoadmapAcceptanceReceipt) -> RoadmapAcceptanceEvent {
  AcceptanceRevoked {
    exact_prior_receipt: receipt,
    disposition: AcceptanceNodeReopensActiveFrontier {},
    reason: "fixture revocation witness" as NonEmptyStr,
    revoked_by: "operator" as NonEmptyStr,
    revoked_on: "2026-08-04" as NonEmptyStr,
  }
}

fn history_with_exact_revocation_for_namespace_occurrence_transport(
  history: List<RoadmapAcceptanceEvent>,
  receipt: RoadmapAcceptanceReceipt,
) -> List<RoadmapAcceptanceEvent> {
  concat(history, [exact_revocation_for(receipt: receipt)])
}

fn history_with_mutated_first_event_accepted_on(history: List<RoadmapAcceptanceEvent>) -> List<RoadmapAcceptanceEvent> {
  let events = history
  match first(events) {
    Absent => events
    Present { value: event } =>
      match event {
        AcceptanceRecorded { receipt: r } =>
          concat(
            [AcceptanceRecorded {
              receipt: RoadmapAcceptanceReceipt {
                node: r.node,
                criteria_digest: r.criteria_digest,
                red_control: r.red_control,
                handback: r.handback,
                accepted_by: r.accepted_by,
                accepted_on: "1970-01-01" as NonEmptyStr,
              },
            }],
            drop_first_acceptance_event(events: events),
          )
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } =>
          events
      }
  }
}

test fn witness_fixture_history_loads_with_nonempty_live_set() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: events } =>
      count(events) > 0
        && match project_live_acceptance_receipts(history: events) {
          LiveAcceptanceReceiptsReplayRefused => false
          LiveAcceptanceReceiptsReplayed { live: live } =>
            count(live) > 0
              && (live |> any(r => r.node == nid(s: "namespace-occurrence-transport")))
        }
  }
}

test fn witness_deleted_history_event_refuses() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } => {
      let current = drop_first_acceptance_event(events: prior)
      !acceptance_history_integrity_holds(
        history: current,
        prior_history: prior,
      )
    }
  }
}

test fn witness_deleted_event_and_prior_prefix_refuses() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } => {
      let current = history_without_namespace_occurrence_transport(history: prior)
      !acceptance_history_integrity_holds(
        history: current,
        prior_history: prior,
      )
        && !acceptance_history_extends_prior(prior: prior, current: current)
    }
  }
}

test fn witness_wrong_prior_digest_in_revocation_refuses() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: prior_live } => {
          match namespace_occurrence_transport_receipt(live: prior_live) {
            Absent => false
            Present { value: receipt } => {
              let wrong = RoadmapAcceptanceReceipt {
                node: receipt.node,
                criteria_digest: receipt.criteria_digest,
                red_control: receipt.red_control,
                handback: receipt.handback,
                accepted_by: receipt.accepted_by,
                accepted_on: "1970-01-01" as NonEmptyStr,
              }
              let history = concat(
                prior,
                [exact_revocation_for(receipt: wrong)],
              )
              !acceptance_history_integrity_holds(
                history: history,
                prior_history: [],
              )
            }
          }
        }
      }
  }
}

test fn witness_revocation_while_exact_receipt_live_refuses() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: prior_live } => {
          match namespace_occurrence_transport_receipt(live: prior_live) {
            Absent => false
            Present { value: receipt } => {
              let history = concat(
                history_without_namespace_occurrence_transport(history: prior),
                [exact_revocation_for(receipt: receipt)],
              )
              !acceptance_history_integrity_holds(
                history: history,
                prior_history: [],
              )
            }
          }
        }
      }
  }
}

test fn witness_duplicate_revocations_refuse() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: prior_live } => {
          match namespace_occurrence_transport_receipt(live: prior_live) {
            Absent => false
            Present { value: receipt } => {
              let revoke = exact_revocation_for(receipt: receipt)
              let history = concat(prior, [revoke, revoke])
              !acceptance_history_integrity_holds(
                history: history,
                prior_history: [],
              )
            }
          }
        }
      }
  }
}

test fn witness_criteria_rewrite_with_receipt_retained_refuses_node_acceptance() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: prior_live } => {
          let victims = declared_roadmap_nodes()
            |> filter(n => n.node == nid(s: "namespace-occurrence-transport"))
          count(victims) == 1
            && all(victims, n => {
              match namespace_occurrence_transport_receipt(live: prior_live) {
                Absent => false
                Present { value: receipt } => {
                  match first(prior_live |> filter(r => r.node != receipt.node)) {
                    Absent => false
                    Present { value: other } => {
                      let planted = RoadmapAcceptanceReceipt {
                        node: receipt.node,
                        criteria_digest: other.criteria_digest,
                        red_control: receipt.red_control,
                        handback: receipt.handback,
                        accepted_by: receipt.accepted_by,
                        accepted_on: receipt.accepted_on,
                      }
                      let history = prior |> map(e =>
                        match e {
                          AcceptanceRecorded { receipt: r } =>
                            if r.node == receipt.node {
                              AcceptanceRecorded { receipt: planted }
                            } else {
                              e
                            }
                          AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => e
                        }
                      )
                      match project_live_acceptance_receipts(history: history) {
                        LiveAcceptanceReceiptsReplayRefused => false
                        LiveAcceptanceReceiptsReplayed { live: live } => !node_accepted(receipts: live, rn: n)
                      }
                    }
                  }
                }
              }
            })
        }
      }
  }
}

test fn witness_exact_revocation_admits_vanished_receipt() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } =>
      match project_live_acceptance_receipts(history: prior) {
        LiveAcceptanceReceiptsReplayRefused => false
        LiveAcceptanceReceiptsReplayed { live: prior_live } => {
          match namespace_occurrence_transport_receipt(live: prior_live) {
            Absent => false
            Present { value: receipt } => {
              let history = history_with_exact_revocation_for_namespace_occurrence_transport(
                history: prior,
                receipt: receipt,
              )
              acceptance_history_integrity_holds(
                history: history,
                prior_history: prior,
              )
                && acceptance_history_extends_prior(prior: prior, current: history)
                && match project_live_acceptance_receipts(history: history) {
                  LiveAcceptanceReceiptsReplayRefused => false
                  LiveAcceptanceReceiptsReplayed { live: live } =>
                    !(live |> any(r => r.node == nid(s: "namespace-occurrence-transport")))
                }
            }
          }
        }
      }
  }
}

test fn witness_non_empty_prior_prefix_law_catches_deletion_without_seal_coedit() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } => {
      let current = drop_first_acceptance_event(events: prior)
      count(prior) > 0
        && !acceptance_history_integrity_holds(history: current, prior_history: prior)
    }
  }
}

test fn witness_changed_history_empty_prior_bypass_admits_deletion_observed_prior_refuses() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } => {
      let current = drop_first_acceptance_event(events: prior)
      count(prior) > count(current)
        && acceptance_history_integrity_holds(history: current, prior_history: [])
        && !acceptance_history_integrity_holds(history: current, prior_history: prior)
    }
  }
}

test fn witness_digest_field_mutation_without_revocation_refuses_prefix() -> Bool {
  match fixture_history_load() {
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => false
    RoadmapAcceptanceEventHistoryLoaded { events: prior } => {
      let current = history_with_mutated_first_event_accepted_on(history: prior)
      count(prior) > 0
        && !acceptance_history_extends_prior(prior: prior, current: current)
        && !acceptance_history_integrity_holds(history: current, prior_history: prior)
    }
  }
}

test fn witness_withheld_projection_refuses_when_history_load_refuses() -> Bool {
  let history = load_roadmap_acceptance_event_history_from_carrier_text(
    text: unreadable_carrier_text_fixture,
  )
  match history {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: history_detail } =>
      match withheld_node_ids_projection(history: history, retired: no_retired_nodes()) {
        WithheldNodeIdsProjected { ids: _ } => false
        WithheldNodeIdsProjectionRefused { detail: withheld_detail } =>
          withheld_detail == history_detail
            && string_contains(s: history_detail, pattern: "line 1:")
      }
  }
}

test fn witness_accepted_projection_refuses_when_history_load_refuses() -> Bool {
  let history = load_roadmap_acceptance_event_history_from_carrier_text(
    text: unreadable_carrier_text_fixture,
  )
  match history {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: history_detail } =>
      match accepted_node_ids_projection(history: history, retired: no_retired_nodes()) {
        AcceptedNodeIdsProjected { ids: _ } => false
        AcceptedNodeIdsProjectionRefused { detail: accepted_detail } =>
          accepted_detail == history_detail
            && string_contains(s: history_detail, pattern: "line 1:")
      }
  }
}

// The accepted projection and the document projection read one frontier plan, so over the same
// history they carry the same accepted set; a live fixture receipt makes the set nonempty.
test fn witness_accepted_projection_matches_authority_projection_on_fixture_history() -> Bool {
  let history = fixture_history_load()
  match accepted_node_ids_projection(history: history, retired: receipt_continuity_acceptance_carrier_retired_ids()) {
    AcceptedNodeIdsProjectionRefused { detail: _ } => false
    AcceptedNodeIdsProjected { ids: ids } =>
      count(ids) > 0
        && match roadmap_authority_projection(history: history, retired: receipt_continuity_acceptance_carrier_retired_ids()) {
          RoadmapAuthorityProjectionRefused { detail: _ } => false
          RoadmapAuthorityProjected { doc: _, accepted: accepted, withheld: _ } => ids == accepted
        }
  }
}

test fn witness_receipts_projection_refuses_when_history_load_refuses() -> Bool {
  let history = load_roadmap_acceptance_event_history_from_carrier_text(
    text: unreadable_carrier_text_fixture,
  )
  match history {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: history_detail } =>
      match roadmap_acceptance_receipts(history: history) {
        RoadmapAcceptanceReceiptsProjected { receipts: _ } => false
        RoadmapAcceptanceReceiptsProjectionRefused { detail: receipt_detail } =>
          receipt_detail == history_detail
            && string_contains(s: history_detail, pattern: "line 1:")
      }
  }
}

test fn witness_unreadable_carrier_text_refuses_load_with_line_parse_detail() -> Bool {
  match load_roadmap_acceptance_event_history_from_carrier_text(text: unreadable_carrier_text_fixture) {
    RoadmapAcceptanceEventHistoryLoaded { events: _ } => false
    RoadmapAcceptanceEventHistoryLoadRefused { detail: detail } =>
      string_contains(s: detail, pattern: "line 1:")
  }
}

test fn witness_authority_projection_refuses_when_receipts_projection_refuses() -> Bool {
  let history = load_roadmap_acceptance_event_history_from_carrier_text(
    text: unreadable_carrier_text_fixture,
  )
  match roadmap_acceptance_receipts(history: history) {
    RoadmapAcceptanceReceiptsProjected { receipts: _ } => false
    RoadmapAcceptanceReceiptsProjectionRefused { detail: receipt_detail } =>
      match roadmap_authority_projection(history: history, retired: no_retired_nodes()) {
        RoadmapAuthorityProjected { doc: _, accepted: _, withheld: _ } => false
        RoadmapAuthorityProjectionRefused { detail: authority_detail } =>
          authority_detail == receipt_detail
            && string_contains(s: authority_detail, pattern: "line 1:")
      }
  }
}

// THE CONJUNCTION SPLIT (gunbc.design_argument::single_authority): one claim carried two independent cases of the same
// producer through one budget — the refused shape over an unreadable carrier and the projected
// shape over a valid one — so roadmap_authority_projection executed twice per frame and both
// bills landed on one identity. Each case is now its own claim at its own boundary; the producer
// still executes exactly once per claim, and the file's coverage is unchanged.
test fn witness_unreadable_carrier_refuses_with_a_located_detail() -> Bool {
  let history = load_roadmap_acceptance_event_history_from_carrier_text(
    text: unreadable_carrier_text_fixture,
  )
  match roadmap_authority_projection(history: history, retired: no_retired_nodes()) {
    RoadmapAuthorityProjectionRefused { detail: detail } =>
      string_contains(s: detail, pattern: "line 1:")
    RoadmapAuthorityProjected { doc: _, accepted: _, withheld: _ } => false
  }
}

test fn witness_valid_carrier_projects_a_nonempty_document() -> Bool {
  match roadmap_authority_projection(
    history: load_roadmap_acceptance_event_history_from_carrier_text(text: receipt_continuity_acceptance_carrier_fixture_text),
    retired: receipt_continuity_acceptance_carrier_retired_ids()) {
    RoadmapAuthorityProjected { doc: doc, accepted: _, withheld: _ } => count(doc_all_nodes(doc: doc)) > 0
    RoadmapAuthorityProjectionRefused { detail: _ } => false
  }
}

// SPLIT THE SAME WAY (gunbc.design_argument::single_authority): the refusal arm and the projected arm are independent
// cases of roadmap_dispatch_file_content_for_projection over planted fixtures; one claim paid both
// renders per frame. Two claims, one render each, coverage unchanged.
test fn witness_dispatch_refusal_arm_hides_the_brief_template() -> Bool {
  let refused = RoadmapAuthorityProjectionRefused { detail: "fixture planted projection refusal" }
  let refused_dispatch = roadmap_dispatch_file_content_for_projection(proj: refused)
  string_contains(s: refused_dispatch, pattern: "fixture planted projection refusal")
    && string_contains(s: refused_dispatch, pattern: "\"refused\": true")
    && !string_contains(s: refused_dispatch, pattern: "\"brief_template\": ")
}

test fn witness_dispatch_projected_arm_presents_the_dispatch_schema() -> Bool {
  let dispatch = roadmap_dispatch_file_content_for_projection(proj: RoadmapAuthorityProjected {
    doc: RoadmapDocument { preamble: [], lead_lanes: [], sections: [] },
    accepted: [],
    withheld: [],
  })
  string_contains(s: dispatch, pattern: "\"brief_template\": ")
    && string_contains(s: dispatch, pattern: "\"dispatch\": ")
    && string_contains(s: dispatch, pattern: "\"schema\": \"roadmap-dispatch/v3\"")
    && !string_contains(s: dispatch, pattern: "\"refused\": true")
}

// A receipt built here rather than projected from the carrier fixture, so the discriminating pair
// below does not rest on a fixture whose load state it is not testing.
fn standalone_receipt() -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: nid(s: "namespace-occurrence-transport"),
    criteria_digest: content_hash_atom(value: "replay-discriminator" as NonEmptyStr),
    red_control: RedControlExecuted {
      witness_module: "test.claim.roadmap.roadmap_receipt_continuity_acceptance",
      witness_fn: "witness_unreplayable_history_refuses_receipts_projection",
      executed_on: "2026-09-14",
    },
    handback: HandbackDelivered {
      first_artifact: "dag/gunbc/roadmap/roadmap_model.dag",
      further_artifacts: [],
    },
    accepted_by: "operator",
    accepted_on: "2026-09-14",
  }
}

// A lone revocation naming a receipt no earlier event recorded: replay cannot apply it.
fn unreplayable_history() -> List<RoadmapAcceptanceEvent> {
  [exact_revocation_for(receipt: standalone_receipt())]
}

// The same receipt recorded and then exactly revoked: replay succeeds and the live set is empty.
fn replayable_empty_live_history() -> List<RoadmapAcceptanceEvent> {
  let receipt = standalone_receipt()
  [AcceptanceRecorded { receipt: receipt }, exact_revocation_for(receipt: receipt)]
}

// THE DISCRIMINATING PAIR: both histories yield an empty live list under the pre-repair producer.
// Asserted through acceptance_receipts_projection_from_events, the single arm both authority
// wrappers call.
test fn witness_unreplayable_history_refuses_receipts_projection() -> Bool {
  match project_live_acceptance_receipts(history: unreplayable_history()) {
    LiveAcceptanceReceiptsReplayed { live: _ } => false
    LiveAcceptanceReceiptsReplayRefused =>
      match acceptance_receipts_projection_from_events(events: unreplayable_history()) {
        RoadmapAcceptanceReceiptsProjected { receipts: _ } => false
        RoadmapAcceptanceReceiptsProjectionRefused { detail: detail } =>
          string_contains(s: detail, pattern: "replay refused")
      }
  }
}

test fn witness_replayable_empty_live_set_still_projects_affirmatively() -> Bool {
  match project_live_acceptance_receipts(history: replayable_empty_live_history()) {
    LiveAcceptanceReceiptsReplayRefused => false
    LiveAcceptanceReceiptsReplayed { live: live } =>
      count(live) == 0
        && match acceptance_receipts_projection_from_events(
          events: replayable_empty_live_history(),
        ) {
          RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
          RoadmapAcceptanceReceiptsProjected { receipts: receipts } => count(receipts) == 0
        }
  }
}

// THE READ-BACK DOORS DECIDE NOTHING NEW — AND THAT IS THE CLAIM. Each of the exits the live migration gates
// on is a reader's verdict turned into an exit; these hold that the mapping keeps its direction under a
// controlled RED: a reader that refused is never admitted, an empty-but-loaded set IS admitted (an empty retired
// set is a real fact; an unreadable log is not), and nothing here decides by searching words. Review 93664 on
// gunb-ai/gunbc#16189 removed the doors that grepped their own prose; what the runbook gates on is now the
// coproduct every reader already returns, matched once per reader in gunbc.roadmap.roadmap_event_cli
// roadmap_read_back_refusals, and the MIGRATION VERIFIED / MIGRATION REFUSED words exist only in
// roadmap_acceptance_migration_report, the rendering the runbook quotes. These claims hold BOTH halves: the
// admission a variant earns, and the sentence a variant renders. Written in the file's own idiom — a test fn is
// a claim the runner answers with PASS or FAIL.

// The admitted shape of the verifier's answer, and each refusal it can reach. One definition here so every
// claim below differs only in WHICH reader refused — the discriminating part is the count and the name.
fn migration_verified_outcome() -> RoadmapAcceptanceMigrationOutcome {
  MigrationVerified {
    manifest_events: 18, accepted_events: 15, revoked_events: 3,
    retired_named: 2, held_events: 18, event_lines: []
  }
}

fn migration_refused_by(cause: RoadmapMigrationRefusal) -> RoadmapAcceptanceMigrationOutcome {
  MigrationRefused { cause: cause }
}

fn clean_retired_read() -> RoadmapRetiredNodeIds { RetiredNodeIdsLoaded { ids: [] } }

fn clean_history_read() -> RoadmapAcceptanceEventHistoryLoad {
  RoadmapAcceptanceEventHistoryLoaded { events: [] }
}

// A loaded retired set is admitted, empty or not; a refused one is the ONE reader that names itself, so the
// report door exits 1 with the reason the reader gave and never serves a plan that looks unretired
// (gunbc.design_argument::fail_closed: a failure arm refuses, never widens).
test fn a_retired_verdict_maps_to_the_exit_the_log_earned() -> Bool {
  let refused = RetiredNodeIdsRefused { detail: "the event log directory is not opened" as NonEmptyStr }
  count(roadmap_read_back_refusals(
    migration: migration_verified_outcome(), retired: clean_retired_read(),
    history: clean_history_read(), wrote: true)) == 0
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(),
      retired: RetiredNodeIdsLoaded { ids: [nid("a-node")] },
      history: clean_history_read(), wrote: true)) == 0
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(), retired: refused,
      history: clean_history_read(), wrote: true)) == 1
    && string_contains(
      s: join(roadmap_read_back_refusals(
        migration: migration_verified_outcome(), retired: refused,
        history: clean_history_read(), wrote: true), "\n"),
      pattern: "retired read: the one event log refused its retired set")
}

// The same for the acceptance history: loaded is admitted even when empty (a plan with no accepted work yet is
// the log's honest answer), refused names itself once — otherwise the page would serve no accepted work at all
// and look healthy doing it.
test fn an_acceptance_history_verdict_maps_to_the_exit_the_log_earned() -> Bool {
  let refused = RoadmapAcceptanceEventHistoryLoadRefused { detail: "the event log could not be read" }
  count(roadmap_read_back_refusals(
    migration: migration_verified_outcome(), retired: clean_retired_read(),
    history: clean_history_read(), wrote: true)) == 0
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(), retired: clean_retired_read(),
      history: refused, wrote: true)) == 1
    && string_contains(
      s: join(roadmap_read_back_refusals(
        migration: migration_verified_outcome(), retired: clean_retired_read(),
        history: refused, wrote: true), "\n"),
      pattern: "acceptance history: the one event log refused its acceptance history")
}

// THE GATE ADMITS THE VARIANT, NOT THE WORDING. Only MigrationVerified opens the door; every refusal cause
// reaches exactly one named refusal, and each names the cause it actually is — so an edit that reworded a
// message could change the sentence the runbook prints without ever changing which runs are admitted, and the
// reverse (a refusal that admitted) is not reachable by editing text at all.
test fn the_migration_gate_admits_only_the_verified_outcome() -> Bool {
  let causes = [
    InstanceUnregistered { repo_root: "/opt/gunbc/dashboard" },
    LogReadRefused { step: "list", reason: "the carrier directory is not opened" },
    LogDoesNotReplay { detail: "an event references a node it never opened" as NonEmptyStr },
    ManifestLineInvalid { line_index: Zero, detail: "not a valid acceptance event" as NonEmptyStr },
    RetiredLaneUnorderable { detail: "the retired lane reopens a closed node" as NonEmptyStr },
    ManifestDisagrees {
      wanted: 18, held: 17, problems: ["held log is missing the acceptance of node-a"], event_lines: []
    }
  ]
  count(roadmap_read_back_refusals(
    migration: migration_verified_outcome(), retired: clean_retired_read(),
    history: clean_history_read(), wrote: true)) == 0
    && count(map(causes, c => count(roadmap_read_back_refusals(
        migration: migration_refused_by(cause: c), retired: clean_retired_read(),
        history: clean_history_read(), wrote: true)))) == 6
    && all(causes, c => count(roadmap_read_back_refusals(
        migration: migration_refused_by(cause: c), retired: clean_retired_read(),
        history: clean_history_read(), wrote: true)) == 1)
    && string_contains(
      s: join(map(causes, c => join(roadmap_read_back_refusals(
        migration: migration_refused_by(cause: c), retired: clean_retired_read(),
        history: clean_history_read(), wrote: true), "\n")), "\n"),
      pattern: "migration verifier: MIGRATION REFUSED")
}

// THE RENDERING IS PINNED TO THE VARIANT, BOTH WAYS. The words are not free-floating: the verified outcome is
// the only thing that prints MIGRATION VERIFIED and the only one that does not print MIGRATION REFUSED, each
// refusal cause is the only thing printing its own sentence, and the verdict that used to be possible by
// accident — one text carrying BOTH words, which the old grep had to refuse by hand — cannot be built at all.
test fn each_outcome_renders_only_its_own_verdict() -> Bool {
  let verified_report = roadmap_acceptance_migration_report(outcome: migration_verified_outcome())
  let disagreement = roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: ManifestDisagrees {
      wanted: 18, held: 17, problems: ["held log is missing the acceptance of node-a"], event_lines: []
    }))
  string_contains(s: verified_report, pattern: "MIGRATION VERIFIED: 18 manifest events (15 acceptances, 3 revocations), 2 retired node(s) named, all held; 18 acceptance events held in the log:")
    && !string_contains(s: verified_report, pattern: "MIGRATION REFUSED")
    && string_contains(s: disagreement, pattern: "MIGRATION REFUSED: 18 manifest events, 17 held, 1 disagreement(s):")
    && string_contains(s: disagreement, pattern: "  held log is missing the acceptance of node-a")
    && !string_contains(s: disagreement, pattern: "MIGRATION VERIFIED")
    && string_contains(s: roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: InstanceUnregistered { repo_root: "/no/such/instance" })),
      pattern: "no dashboard instance is registered at /no/such/instance")
    && string_contains(s: roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: LogReadRefused { step: "list", reason: "the carrier directory is not opened" })),
      pattern: "the event log read failed at list")
    && string_contains(s: roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: LogDoesNotReplay { detail: "an event references a node it never opened" as NonEmptyStr })),
      pattern: "the event log does not replay")
    && string_contains(s: roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: ManifestLineInvalid { line_index: Zero, detail: "not a valid acceptance event" as NonEmptyStr })),
      pattern: "is not a valid acceptance event")
    && string_contains(s: roadmap_acceptance_migration_report(outcome: migration_refused_by(cause: RetiredLaneUnorderable { detail: "the retired lane reopens a closed node" as NonEmptyStr })),
      pattern: "the retired lane does not order")
}

// THE READ-BACK DOCUMENT IS ADMITTED ONLY WHEN EVERY PART IS. One refusal anywhere refuses the whole, which
// is what keeps a half-read log from being quoted as a migration that completed — including a document the
// host would not let us write, since an unread receipt is not a receipt. Each part is refused by CONSTRUCTION
// of that reader's own refusal, not by a flag a caller could set wrongly.
test fn the_read_back_refuses_when_any_single_part_refuses() -> Bool {
  let retired_refused = RetiredNodeIdsRefused { detail: "the event log directory is not opened" as NonEmptyStr }
  let history_refused = RoadmapAcceptanceEventHistoryLoadRefused { detail: "the event log could not be read" }
  let migration_refused = migration_refused_by(cause: RetiredLaneUnorderable { detail: "the retired lane reopens a closed node" as NonEmptyStr })
  count(roadmap_read_back_refusals(
    migration: migration_verified_outcome(), retired: clean_retired_read(),
    history: clean_history_read(), wrote: true)) == 0
    && count(roadmap_read_back_refusals(
      migration: migration_refused, retired: clean_retired_read(),
      history: clean_history_read(), wrote: true)) == 1
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(), retired: retired_refused,
      history: clean_history_read(), wrote: true)) == 1
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(), retired: clean_retired_read(),
      history: history_refused, wrote: true)) == 1
    && count(roadmap_read_back_refusals(
      migration: migration_verified_outcome(), retired: clean_retired_read(),
      history: clean_history_read(), wrote: false)) == 1
    && count(roadmap_read_back_refusals(
      migration: migration_refused, retired: retired_refused,
      history: history_refused, wrote: false)) == 4
    && string_contains(
      s: join(roadmap_read_back_refusals(
        migration: migration_verified_outcome(), retired: clean_retired_read(),
        history: clean_history_read(), wrote: false), "\n"),
      pattern: "read-back document: the write to the report path did not succeed")
}
