module test.claim.roadmap_service_evidence_witness_test

import std.types { Bool, String, Int, List, NonEmptyStr }
import extdeps.filesystem.filesystem_io {
  FilesystemFileObservation, FilesystemFileIndeterminate,
  filesystem_file_observation, filesystem_listing_observation, filesystem_read_outcome,
}
import extdeps.languages.json.emit { serialize_json }
import gunbc.roadmap_model { RoadmapNodeId }
import gunbc.roadmap_launch_admission { LaunchIdentity, launch_identity_json, launch_identity_null_revision, Operator }
import gunbc.roadmap_belt { ManualReady }
import gunbc.roadmap_service_evidence {
  ReaderField, UnbuiltField, ServiceEvidenceField, ReaderOwnedField, UnbuiltProducerField,
  WorkloadClass, ResourceRequest, WaitTime, ExecutionTime, CompletionTime,
  CacheHits, CacheMisses, CacheSharedMisses, CacheCorruptHitRefusals, Placement, SeatUtilization,
  ArtifactBytes, FailureAttribution, BillableUsage, Egress, HardwareHealth,
  ServiceEvidenceReader, MeteringReader, SessionPlacementReader, SharedComputationReader, ResultReturnedReader,
  ServiceEvidenceReading, EvidenceObserved, EvidenceOwed, EvidenceRefused,
  PendingReader, LandedReaderUnbound, UnbuiltProducer,
  ReaderSlotReading, SlotObserved, SlotOwed, SlotRefused, ServiceEvidenceReceipt,
  ServiceEvidenceObservation, ServiceEvidenceJoined, ServiceEvidenceAttemptUnlaunched, ServiceEvidenceRefused,
  service_evidence_fields, service_evidence_field_wire, service_evidence_reading, reader_field_reader,
  unbuilt_field_owner, service_evidence_observe_from_launch, service_evidence_receipt_join,
  service_evidence_receipt_wire, service_evidence_receipt_digest, service_evidence_owed_fields,
}

// The launch record is planted as the dispatch actuator writes it (launch_identity_json) and read
// through the same composition the real reader uses (filesystem_file_observation over a listing and
// a read), so each claim below exercises the real decoder and join, with only the bytes supplied.

data attempt_dir: String = "/state/n1/a1"
data launch_name: String = "launch-identity.json"

fn launch_for(node: String) -> String {
  serialize_json(v: launch_identity_json(id: LaunchIdentity {
    node_id: node as NonEmptyStr as RoadmapNodeId,
    cause: Operator,
    mode: ManualReady,
    instance_id: "witness-instance" as NonEmptyStr,
    revision: launch_identity_null_revision(),
  }))
}

fn planted(content: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: attempt_dir, success: true, entries: join([launch_name, "\n"], ""), error: ""),
    name: launch_name,
    path: join([attempt_dir, "/", launch_name], ""),
    read: filesystem_read_outcome(content: content, success: true, error: ""),
  )
}

fn unplanted() -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: attempt_dir, success: true, entries: "", error: ""),
    name: launch_name,
    path: join([attempt_dir, "/", launch_name], ""),
    read: filesystem_read_outcome(content: "", success: false, error: "not read: the listing did not name the entry"),
  )
}

fn observe(launch: FilesystemFileObservation) -> ServiceEvidenceObservation {
  service_evidence_observe_from_launch(node_id: "n1", attempt_key: "a1", launch: launch)
}

fn refused(o: ServiceEvidenceObservation) -> Bool {
  match o { ServiceEvidenceRefused { reason: _ } => true  _ => false }
}

fn reader_is(a: ServiceEvidenceReader, b: ServiceEvidenceReader) -> Bool {
  match a {
    MeteringReader => match b { MeteringReader => true  _ => false }
    SessionPlacementReader => match b { SessionPlacementReader => true  _ => false }
    SharedComputationReader => match b { SharedComputationReader => true  _ => false }
    ResultReturnedReader => match b { ResultReturnedReader => true  _ => false }
  }
}

fn owed_pending(r: ServiceEvidenceReceipt, f: ReaderField, reader: ServiceEvidenceReader, pr: Int) -> Bool {
  match service_evidence_reading(r: r, f: ReaderOwnedField { field: f }) {
    EvidenceOwed { producer: PendingReader { reader: got, pr: n } } => reader_is(a: got, b: reader) && n == pr
    _ => false
  }
}

fn owed_unbuilt(r: ServiceEvidenceReceipt, f: UnbuiltField, owner: String) -> Bool {
  match service_evidence_reading(r: r, f: UnbuiltProducerField { field: f }) {
    EvidenceOwed { producer: UnbuiltProducer { owner_node } } => owner_node == owner
    _ => false
  }
}

fn joined() -> ServiceEvidenceReceipt {
  service_evidence_receipt_join(node_id: "n1" as NonEmptyStr, attempt_key: "a1" as NonEmptyStr)
}

// ── the join over a launched attempt ──

test fn a_launched_attempt_joins_a_receipt_for_that_node_and_attempt_with_a_digest() -> Bool {
  match observe(launch: planted(content: launch_for(node: "n1"))) {
    ServiceEvidenceJoined { receipt } =>
      (receipt.node_id as String) == "n1" && (receipt.attempt_key as String) == "a1"
        && service_evidence_receipt_digest(r: receipt) == service_evidence_receipt_digest(r: joined())
        && service_evidence_receipt_wire(r: receipt) != ""
    _ => false
  }
}

// Nothing is observed while every reader is pending: no field defaults to a value, and each is owed
// to its named producer.
test fn with_every_reader_pending_every_field_is_owed_to_its_named_producer() -> Bool {
  let r = joined()
  all(service_evidence_fields, f => match service_evidence_reading(r: r, f: f) { EvidenceOwed { producer: _ } => true  _ => false })
    && owed_pending(r: r, f: CacheCorruptHitRefusals, reader: SharedComputationReader, pr: 13097)
    && owed_pending(r: r, f: BillableUsage, reader: MeteringReader, pr: 13073)
    && owed_pending(r: r, f: FailureAttribution, reader: ResultReturnedReader, pr: 13075)
    && owed_pending(r: r, f: Placement, reader: SessionPlacementReader, pr: 13074)
    && owed_unbuilt(r: r, f: HardwareHealth, owner: "fleet-health-0-live-receipt")
    && owed_unbuilt(r: r, f: Egress, owner: "service-evidence-capture")
}

test fn the_roster_is_the_nodes_twenty_one_fields_and_the_closing_contract_is_red_on_all_of_them() -> Bool {
  count(service_evidence_fields) == 21 && count(service_evidence_owed_fields()) == 21
}

// ── one discriminating red per observation refusal ──

test fn an_attempt_with_no_launch_record_is_unlaunched_not_joined() -> Bool {
  match observe(launch: unplanted()) { ServiceEvidenceAttemptUnlaunched => true  _ => false }
}

test fn a_launch_record_naming_another_node_refuses() -> Bool {
  refused(o: observe(launch: planted(content: launch_for(node: "n2"))))
}

test fn a_launch_record_that_is_not_json_refuses() -> Bool {
  refused(o: observe(launch: planted(content: "not json")))
}

test fn a_launch_record_missing_its_revision_refuses() -> Bool {
  refused(o: observe(launch: planted(content: "{\"node_id\":\"n1\",\"cause\":\"operator\",\"mode\":\"manual_ready\",\"instance_id\":\"i\"}")))
}

test fn an_indeterminate_launch_read_refuses() -> Bool {
  refused(o: observe(launch: FilesystemFileIndeterminate { cause: "listing failed" }))
}

test fn an_empty_attempt_identity_refuses_before_any_read() -> Bool {
  refused(o: service_evidence_observe_from_launch(node_id: "n1", attempt_key: "", launch: planted(content: launch_for(node: "n1"))))
    && refused(o: service_evidence_observe_from_launch(node_id: "", attempt_key: "a1", launch: planted(content: launch_for(node: "n1"))))
}

// ── THE RE-MEASURED FIELD CANNOT EXIST, by construction ──
// A receipt with EVERY slot written as observed -- the most a caller could try to assert -- still
// attributes each observed value to its field's one reader (the slot carries no source), and every
// field with no producer stays owed to its owning node (it has no slot to write into).
fn all_observed() -> ServiceEvidenceReceipt {
  let o = SlotObserved { value: "v" }
  ServiceEvidenceReceipt {
    node_id: "n1" as NonEmptyStr, attempt_key: "a1" as NonEmptyStr,
    workload_class: o, resource_request: o, wait_time: o, execution_time: o, completion_time: o,
    cache_hits: o, cache_misses: o, cache_shared_misses: o, cache_corrupt_hit_refusals: o,
    placement: o, seat_utilization: o, artifact_bytes: o, failure_attribution: o, billable_usage: o,
  }
}

test fn an_observed_value_is_always_attributed_to_its_fields_own_reader_and_an_unbuilt_field_is_never_observed() -> Bool {
  let r = all_observed()
  all(service_evidence_fields, f => match f {
    ReaderOwnedField { field } => match service_evidence_reading(r: r, f: f) {
      EvidenceObserved { value, source } => value == "v" && reader_is(a: source, b: reader_field_reader(f: field))
      _ => false
    }
    UnbuiltProducerField { field } => match service_evidence_reading(r: r, f: f) {
      EvidenceOwed { producer: UnbuiltProducer { owner_node } } => owner_node == unbuilt_field_owner(f: field)
      _ => false
    }
  })
    && match service_evidence_reading(r: r, f: ReaderOwnedField { field: CacheHits }) {
      EvidenceObserved { value: _, source } => reader_is(a: source, b: SharedComputationReader) && !reader_is(a: source, b: MeteringReader)
      _ => false
    }
}

test fn a_refused_slot_projects_its_reason() -> Bool {
  let r = ServiceEvidenceReceipt {
    node_id: "n1" as NonEmptyStr, attempt_key: "a1" as NonEmptyStr,
    workload_class: SlotOwed, resource_request: SlotOwed, wait_time: SlotOwed, execution_time: SlotOwed, completion_time: SlotOwed,
    cache_hits: SlotOwed, cache_misses: SlotOwed, cache_shared_misses: SlotOwed, cache_corrupt_hit_refusals: SlotOwed,
    placement: SlotOwed, seat_utilization: SlotOwed, artifact_bytes: SlotRefused { reason: "the store refused the read" as NonEmptyStr },
    failure_attribution: SlotOwed, billable_usage: SlotOwed,
  }
  match service_evidence_reading(r: r, f: ReaderOwnedField { field: ArtifactBytes }) {
    EvidenceRefused { reason } => (reason as String) == "the store refused the read"
    _ => false
  }
}
