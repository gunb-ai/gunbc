// The attempt's launch record is planted as the belt writes it (attempt_launch_record_json; a legacy
// record as launch_identity_json wrote it before the binding) and read through the composition the
// real reader uses (filesystem_file_observation over a listing and a read), so each claim exercises
// the real versioned decoder and the real binding with only the bytes supplied.

data attempt_dir: String = "/state/n1/a1"
data launch_name: String = "launch-identity.json"

fn identity(node: String, instance: String) -> LaunchIdentity {
  LaunchIdentity {
    node_id: node as NonEmptyStr as RoadmapNodeId,
    cause: Operator,
    mode: ManualReady,
    instance_id: instance as NonEmptyStr,
    revision: launch_identity_null_revision(),
  }
}

fn launch_for(node: String, instance: String, attempt: String) -> String {
  serialize_json(v: attempt_launch_record_json(id: identity(node: node, instance: instance), attempt_key: attempt as NonEmptyStr))
}

fn planted(name: String, content: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: attempt_dir, success: true, entries: join([launch_name, "\n"], ""), error: ""),
    name: name,
    path: join([attempt_dir, "/", name], ""),
    read: filesystem_read_outcome(content: content, success: true, error: ""),
  )
}

fn unplanted(name: String) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: attempt_dir, success: true, entries: "", error: ""),
    name: name,
    path: join([attempt_dir, "/", name], ""),
    read: filesystem_read_outcome(content: "", success: false, error: "not read: the listing did not name the entry"),
  )
}

fn bind(launch: FilesystemFileObservation) -> AttemptBindingOutcome {
  service_evidence_bind_attempt(instance_id: "i1", node_id: "n1", attempt_key: "a1", launch: launch)
}

fn good_launch() -> FilesystemFileObservation { planted(name: launch_name, content: launch_for(node: "n1", instance: "i1", attempt: "a1")) }

fn refused(o: AttemptBindingOutcome) -> Bool {
  match o { AttemptBindingRefused { reason: _ } => true  _ => false }
}

fn bound(o: AttemptBindingOutcome) -> Bool {
  match o { AttemptBound { binding: _ } => true  _ => false }
}

// The node's list, in its order: the oracle the product's ordered view is checked against.
data node_field_list: String = "workload_class,resource_request,wait_time,execution_time,completion_time,cache_hits,cache_misses,cache_shared_misses,cache_corrupt_hit_refusals,placement,seat_utilization,artifact_bytes,egress,failure_attribution,recovery_action,operator_intervention_time,hardware_health,billable_usage,billable_credits,workspace_recovery_point,workspace_recovery_time"

// The G3 and G4 inputs default to their readers' record-absent arms for the bound attempt.
fn inputs_with(attempt: String, o: SessionPlacementObservation) -> ServiceEvidenceInputs {
  inputs_of(o: o, m: MeteringNotYetWritten, rr: ResultNotReturned { attempt_key: attempt }, close: SnapshotNotOpened)
}

fn inputs_of(o: SessionPlacementObservation, m: AttemptMeteringObservation, rr: ResultReturnedObservation, close: CarrierSnapshotClose) -> ServiceEvidenceInputs {
  ServiceEvidenceInputs {
    session_placement: SessionPlacementRead { observation: o },
    metering: MeteringRead { observation: m },
    result_returned: ResultReturnedRead { observation: rr, close: close },
  }
}

fn binding_for(node: String, attempt: String) -> AttemptBinding {
  AttemptBinding { instance_id: "i1" as NonEmptyStr, node_id: node as NonEmptyStr, attempt_key: attempt as NonEmptyStr, revision_hex: "0000000000000000000000000000000000000000" as NonEmptyStr }
}

fn readings_with(node: String, attempt: String, o: SessionPlacementObservation) -> ServiceEvidenceReadings {
  service_evidence_readings(r: ServiceEvidenceReceipt { binding: binding_for(node: node, attempt: attempt), inputs: inputs_with(attempt: attempt, o: o) })
}

fn readings_on_main() -> ServiceEvidenceReadings {
  service_evidence_readings(r: service_evidence_closing_probe())
}

fn reader_is(a: ServiceEvidenceReader, b: ServiceEvidenceReader) -> Bool {
  match a {
    MeteringReader => match b { MeteringReader => true  _ => false }
    SessionPlacementReader => match b { SessionPlacementReader => true  _ => false }
    SharedComputationReader => match b { SharedComputationReader => true  _ => false }
    ResultReturnedReader => match b { ResultReturnedReader => true  _ => false }
  }
}

fn pending_is(a: PendingServiceReader, b: PendingServiceReader) -> Bool {
  match a {
    PendingSharedComputation => match b { PendingSharedComputation => true }
  }
}

fn owed_pending(o: ServiceEvidenceOwed, reader: PendingServiceReader) -> Bool {
  match o { OwedToPendingReader { reader: got } => pending_is(a: got, b: reader)  OwedToUnbuiltProducer { owner_node: _ } => false }
}

fn owed_unbuilt(o: ServiceEvidenceOwed, owner: String) -> Bool {
  match o { OwedToUnbuiltProducer { owner_node } => owner_node == owner  OwedToPendingReader { reader: _ } => false }
}

fn is_refused<T>(r: ServiceEvidenceReading<T>) -> Bool {
  match r { EvidenceRefused { reason: _ } => true  EvidenceObserved { value: _ } => false  EvidenceRecordAbsent => false  EvidenceNotOwed { reason: _ } => false }
}

fn not_observed<T>(r: ServiceEvidenceReading<T>) -> Bool {
  match r { EvidenceObserved { value: _ } => false  EvidenceRefused { reason: _ } => true  EvidenceRecordAbsent => true  EvidenceNotOwed { reason: _ } => true }
}

fn record_absent<T>(r: ServiceEvidenceReading<T>) -> Bool {
  match r { EvidenceRecordAbsent => true  EvidenceObserved { value: _ } => false  EvidenceRefused { reason: _ } => false  EvidenceNotOwed { reason: _ } => false }
}

fn is_not_owed<T>(r: ServiceEvidenceReading<T>) -> Bool {
  match r { EvidenceNotOwed { reason: _ } => true  EvidenceRecordAbsent => false  EvidenceObserved { value: _ } => false  EvidenceRefused { reason: _ } => false }
}

fn standing_owed(x: ServiceEvidenceEntry) -> Bool {
  match x.standing { StandingOwed { producer: _ } => true  StandingObserved { value: _, source: _ } => false  StandingNotOwed { source: _, reason: _ } => false  StandingRefused { reason: _ } => false }
}

fn standing_observed_by_g5(x: ServiceEvidenceEntry) -> Bool {
  match x.standing { StandingObserved { value: _, source } => reader_is(a: source, b: SessionPlacementReader)  StandingOwed { producer: _ } => false  StandingNotOwed { source: _, reason: _ } => false  StandingRefused { reason: _ } => false }
}

// ── the binding: one discriminating red per refusal ──

test fn an_attempt_whose_launch_record_names_it_is_bound_with_the_launch_revision() -> Bool {
  match bind(launch: good_launch()) {
    AttemptBound { binding } =>
      (binding.instance_id as String) == "i1" && (binding.node_id as String) == "n1" && (binding.attempt_key as String) == "a1"
        && (binding.revision_hex as String) == "0000000000000000000000000000000000000000"
    _ => false
  }
}

test fn an_attempt_with_no_launch_record_is_unlaunched_not_bound() -> Bool {
  match bind(launch: unplanted(name: launch_name)) { AttemptUnlaunched => true  _ => false }
}

test fn a_launch_record_naming_another_node_refuses() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: launch_for(node: "n2", instance: "i1", attempt: "a1"))))
}

test fn a_launch_record_copied_from_another_instance_refuses() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: launch_for(node: "n1", instance: "i2", attempt: "a1"))))
}

// Attempt B's launch bytes copied into attempt A's directory: same node, same instance, so only the
// attempt key the record carries can tell them apart.
test fn launch_bytes_copied_from_another_attempt_of_the_same_node_refuse() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: launch_for(node: "n1", instance: "i1", attempt: "b2"))))
}

// A record written before the binding existed carries no attempt key: it decodes as unbound and
// refuses, never defaulting to the requested attempt.
test fn a_legacy_launch_record_with_no_attempt_key_refuses() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: serialize_json(v: launch_identity_json(id: identity(node: "n1", instance: "i1"))))))
}

test fn a_launch_record_that_is_not_json_refuses() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: "not json")))
}

test fn a_launch_record_missing_its_revision_refuses() -> Bool {
  refused(o: bind(launch: planted(name: launch_name, content: "{\"node_id\":\"n1\",\"cause\":\"operator\",\"mode\":\"manual_ready\",\"instance_id\":\"i1\",\"attempt_key\":\"a1\"}")))
}

test fn an_indeterminate_launch_read_refuses() -> Bool {
  refused(o: bind(launch: FilesystemFileIndeterminate { cause: "listing failed" }))
}

test fn an_empty_identity_refuses_before_any_read() -> Bool {
  refused(o: service_evidence_bind_attempt(instance_id: "", node_id: "n1", attempt_key: "a1", launch: good_launch()))
    && refused(o: service_evidence_bind_attempt(instance_id: "i1", node_id: "", attempt_key: "a1", launch: good_launch()))
    && refused(o: service_evidence_bind_attempt(instance_id: "i1", node_id: "n1", attempt_key: "", launch: good_launch()))
}

// ── the readings ──

// The ordered view the wire and the closing contract both read is exactly the node's list, by
// identity and in order: a duplicate plus an omission that keeps the count at 21 is red here.
test fn the_ordered_view_is_exactly_the_nodes_twenty_one_fields_in_order() -> Bool {
  join(map(service_evidence_entries(r: readings_on_main()), x => x.field), ",") == node_field_list
}

// With no placement, metering or result record yet and the shared-computation reader not on main,
// every field is owed to its named producer and none is observed; the closing contract is red on the
// 14 unsourced fields.
test fn with_no_placement_record_every_field_is_owed_to_its_named_producer() -> Bool {
  let r = readings_on_main()
  all(service_evidence_entries(r: r), x => standing_owed(x: x))
    && record_absent(r: r.placement) && record_absent(r: r.workload_class) && record_absent(r: r.resource_request)
    && owed_pending(o: r.cache_corrupt_hit_refusals, reader: PendingSharedComputation)
    && record_absent(r: r.execution_time) && record_absent(r: r.billable_usage)
    && record_absent(r: r.completion_time) && record_absent(r: r.failure_attribution)
    && owed_unbuilt(o: r.hardware_health, owner: "fleet-health-0-live-receipt")
    && owed_unbuilt(o: r.egress, owner: "service-evidence-capture")
    && owed_unbuilt(o: r.wait_time, owner: "service-evidence-capture")
    && owed_unbuilt(o: r.seat_utilization, owner: "service-evidence-capture")
    && count(service_evidence_unsourced_fields(r: r)) == 14
}

// The pending PR is derived from the reader, so the canonical wire names #13097 for shared
// computation without any receipt carrying the number; the landed G3 and G4 readers are named by no
// pull request at all.
test fn the_wire_names_only_the_pending_readers_pull_request() -> Bool {
  let w = service_evidence_receipt_wire(r: service_evidence_closing_probe())
  string_contains(s: w, pattern: "13097") && !string_contains(s: w, pattern: "13073") && !string_contains(s: w, pattern: "13075")
    && string_contains(s: w, pattern: "reader_record_absent")
}

// ── G5 BOUND (gunbc.roadmap_session_placement, landed): the real pure fold over planted records ──

data node_a: String = "g5-node-a"
data key_a: String = "feedfacefeedface"
data node_b: String = "g5-node-b"
data key_b: String = "0123456789abcdef"
data g5_host: String = "srv2"

fn grant_for(node_id: String, attempt_key: String, slot: AttemptRecord) -> SessionPlacementGrant {
  SessionPlacementGrant {
    node_id: node_id,
    attempt_key: attempt_key,
    unit: session_unit(node_id: node_id, attempt_key: attempt_key),
    lease: LeaseGrant {
      reference: session_unit(node_id: node_id, attempt_key: attempt_key),
      fence: LeaseFence { grant: "evt-7" as NonEmptyStr as GrantIdentity, generation: 7 },
      granted_at: 1000,
      maximum_duration_seconds: 14400,
      expires_at: 15400,
    },
    partition: "session-memory-srv2" as NonEmptyStr as PartitionId,
    amount: kibibyte(count: 8388608),
    class_grant: GrantAtCeiling { class: WorkClassAgentSession, amount: kibibyte(count: 8388608), reason: ClassUnmeasured },
    store: FabricStorageLocalFiles { root: fabric_storage_file_root(root: "/state/capacity" as NonEmptyStr) },
    slot: slot,
    slot_generation: cas_generation_first(),
  }
}

fn slot_a() -> AttemptRecord {
  session_attempt_record(node_id: node_a, attempt_key: key_a, granted: kibibyte(count: 8388608), now: 1000)
}

fn g5_record_bytes(node_id: String, attempt_key: String) -> String {
  serialize_json(v: session_placement_record_json(r: session_placement_record_of(host: g5_host, grant: grant_for(node_id: node_id, attempt_key: attempt_key, slot: slot_a()), unit_properties: ["MemoryMax=8589934592"])))
}

fn g5_file(name: String, content: String, present: Bool) -> FilesystemFileObservation {
  filesystem_file_observation(
    listing: filesystem_listing_observation(directory: "/state", success: true, entries: if present { join(["unrelated", name], "\n") } else { "unrelated" }, error: ""),
    name: name, path: join(["/state/", name], ""),
    read: filesystem_read_outcome(content: content, success: present, error: if present { "" } else { "ENOENT" }),
  )
}

fn g5_observe(slot: AttemptSlotReading, record_node: String, record_key: String) -> SessionPlacementObservation {
  session_placement_observation_of(
    node_id: node_a, attempt_key: key_a, host: g5_host, slot: slot,
    record_path: "/state/r", record: g5_file(name: session_placement_record_basename(node_id: node_a, attempt_key: key_a), content: g5_record_bytes(node_id: record_node, attempt_key: record_key), present: true),
    release_path: "/state/x", released: g5_file(name: session_placement_release_basename(node_id: node_a, attempt_key: key_a), content: "", present: false),
  )
}

fn g5_held() -> AttemptSlotReading { AttemptSlotHeld { record: slot_a(), generation: cas_generation_first() } }

// POSITIVE CONTROL: a bound placement observes exactly the facts G5 establishes, as TYPED carriers
// (named placement parts, the work-class grant, Kibibyte -- review 75015), and the wire renders them
// as structured JSON attributed to G5.
test fn a_bound_placement_observes_placement_workload_class_and_granted_resource_from_g5() -> Bool {
  let r = readings_with(node: node_a, attempt: key_a, o: g5_observe(slot: g5_held(), record_node: node_a, record_key: key_a))
  (match r.placement {
    EvidenceObserved { value } => value.host == "srv2" && value.partition == "session-memory-srv2" && value.unit == (session_unit(node_id: node_a, attempt_key: key_a) as String)
    EvidenceRecordAbsent => false
    EvidenceRefused { reason: _ } => false
    EvidenceNotOwed { reason: _ } => false
  })
    && (match r.resource_request {
      EvidenceObserved { value } => kibibyte_count(k: value) == 8388608
      EvidenceRecordAbsent => false
      EvidenceRefused { reason: _ } => false
      EvidenceNotOwed { reason: _ } => false
    })
    && (match r.workload_class {
      EvidenceObserved { value } => value.class_grant != ""
      EvidenceRecordAbsent => false
      EvidenceRefused { reason: _ } => false
      EvidenceNotOwed { reason: _ } => false
    })
    && all(filter(service_evidence_entries(r: r), x => x.field == "placement" || x.field == "workload_class" || x.field == "resource_request"), x => standing_observed_by_g5(x: x))
    && owed_unbuilt(o: r.wait_time, owner: "service-evidence-capture")
    && owed_unbuilt(o: r.seat_utilization, owner: "service-evidence-capture")
    && count(service_evidence_unsourced_fields(r: r)) == 14
    && string_contains(s: service_evidence_receipt_wire(r: ServiceEvidenceReceipt { binding: binding_for(node: node_a, attempt: key_a), inputs: inputs_with(attempt: key_a, o: g5_observe(slot: g5_held(), record_node: node_a, record_key: key_a)) }), pattern: "\"kib\": 8388608")
}

// DISCRIMINATING REDS: no foreign, unreadable or mis-bound placement yields an observed field.
test fn a_foreign_placement_record_never_yields_an_observed_field() -> Bool {
  let r = readings_with(node: node_a, attempt: key_a, o: g5_observe(slot: g5_held(), record_node: node_b, record_key: key_b))
  is_refused(r: r.placement) && is_refused(r: r.workload_class) && is_refused(r: r.resource_request)
}

test fn an_unreadable_placement_never_yields_an_observed_field() -> Bool {
  let r = readings_with(node: node_a, attempt: key_a, o: SessionPlacementUnreadable { unit: "u", detail: "the slot store refused" })
  is_refused(r: r.placement) && is_refused(r: r.workload_class) && is_refused(r: r.resource_request)
}

// The placement reader answered for attempt A, but the receipt is bound to attempt B: refused.
test fn a_placement_for_another_attempt_than_the_binding_is_refused() -> Bool {
  let r = readings_with(node: node_a, attempt: key_b, o: g5_observe(slot: g5_held(), record_node: node_a, record_key: key_a))
  is_refused(r: r.placement) && not_observed(r: r.workload_class) && not_observed(r: r.resource_request)
}

test fn no_placement_slot_is_owed_to_g5_not_observed() -> Bool {
  let r = readings_with(node: node_a, attempt: key_a, o: g5_observe(slot: AttemptSlotAbsent, record_node: node_a, record_key: key_a))
  record_absent(r: r.placement) && record_absent(r: r.workload_class) && record_absent(r: r.resource_request)
}

// The pinned wire is a function of the bound receipt: the same binding and inputs pin the same
// digest, and a different attempt pins a different one.
test fn the_pinned_digest_follows_the_binding() -> Bool {
  match bind(launch: good_launch()) {
    AttemptBound { binding } => {
      let r = ServiceEvidenceReceipt { binding: binding, inputs: service_evidence_closing_probe().inputs }
      service_evidence_receipt_digest(r: r) == service_evidence_receipt_digest(r: ServiceEvidenceReceipt { binding: binding, inputs: service_evidence_closing_probe().inputs })
        && match service_evidence_bind_attempt(instance_id: "i1", node_id: "n1", attempt_key: "b2", launch: planted(name: launch_name, content: launch_for(node: "n1", instance: "i1", attempt: "b2"))) {
          AttemptBound { binding: other } => service_evidence_receipt_digest(r: r) != service_evidence_receipt_digest(r: ServiceEvidenceReceipt { binding: other, inputs: service_evidence_closing_probe().inputs })
          _ => false
        }
    }
    _ => false
  }
}

// ── THE PINNED SNAPSHOT ──
//
// A pinning consumer persists the canonical wire and reads it back only through
// service_evidence_snapshot_decode, which decodes every standing payload to its typed entry and
// requires the whole wire to re-encode to the persisted bytes. canonical_wire is the exact wire the
// encoder writes for the probe-shaped receipt below; the first claim holds that inhabitance, and every
// other claim derives its subject from that literal by one targeted edit, so each pays one decode.
data canonical_wire: String = "{\"schema\": \"service-evidence-receipt/v2\", \"instance_id\": \"i1\", \"node_id\": \"g5-node-a\", \"attempt_key\": \"feedfacefeedface\", \"launch_revision\": \"0000000000000000000000000000000000000000\", \"fields\": [{\"field\": \"workload_class\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"}}, {\"field\": \"resource_request\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"}}, {\"field\": \"wait_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, {\"field\": \"execution_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}}, {\"field\": \"completion_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}}, {\"field\": \"cache_hits\", \"standing\": \"owed\", \"producer\": {\"kind\": \"pending_reader\", \"reader\": \"gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt\", \"pr\": 13097}}, {\"field\": \"cache_misses\", \"standing\": \"owed\", \"producer\": {\"kind\": \"pending_reader\", \"reader\": \"gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt\", \"pr\": 13097}}, {\"field\": \"cache_shared_misses\", \"standing\": \"owed\", \"producer\": {\"kind\": \"pending_reader\", \"reader\": \"gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt\", \"pr\": 13097}}, {\"field\": \"cache_corrupt_hit_refusals\", \"standing\": \"owed\", \"producer\": {\"kind\": \"pending_reader\", \"reader\": \"gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt\", \"pr\": 13097}}, {\"field\": \"placement\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"}}, {\"field\": \"seat_utilization\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, {\"field\": \"artifact_bytes\", \"standing\": \"owed\", \"producer\": {\"kind\": \"pending_reader\", \"reader\": \"gunbc.roadmap_belt_actuate shared_computation_observe_for_attempt\", \"pr\": 13097}}, {\"field\": \"egress\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, {\"field\": \"failure_attribution\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}}, {\"field\": \"recovery_action\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, {\"field\": \"operator_intervention_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, {\"field\": \"hardware_health\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"fleet-health-0-live-receipt\"}}, {\"field\": \"billable_usage\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}}, {\"field\": \"billable_credits\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"failure-billing-outcomes\"}}, {\"field\": \"workspace_recovery_point\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"fabric-storage\"}}, {\"field\": \"workspace_recovery_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"fabric-storage\"}}]}"

data placement_owed: String = "{\"field\": \"placement\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"}}"

data placement_observed: String = "{\"field\": \"placement\", \"standing\": \"observed\", \"value\": {\"host\": \"srv2\", \"partition\": \"p\", \"unit\": \"u\"}, \"source\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"}"

fn snapshot_admits(wire: String) -> Bool {
  match service_evidence_snapshot_decode(wire: wire) { SnapshotDecoded { snapshot: _ } => true  SnapshotInvalid { reason: _ } => false }
}

fn edited(from: String, to: String) -> String { replace(s: canonical_wire, from: from, to: to) }

test fn the_encoder_writes_the_canonical_wire_literal() -> Bool {
  service_evidence_receipt_wire(r: ServiceEvidenceReceipt { binding: binding_for(node: node_a, attempt: key_a), inputs: inputs_with(attempt: key_a, o: SessionPlacementAbsent { unit: "gunbc-session-g5-node-a" }) }) == canonical_wire
}

test fn the_canonical_wire_decodes_with_its_binding_and_revision() -> Bool {
  match service_evidence_snapshot_decode(wire: canonical_wire) {
    SnapshotDecoded { snapshot } => snapshot.node_id == node_a && snapshot.attempt_key == key_a && snapshot.instance_id == "i1" && length(snapshot.fields) == 21 && snapshot.digest != ""
    SnapshotInvalid { reason: _ } => false
  }
}

test fn an_observed_typed_value_from_its_reader_decodes() -> Bool {
  snapshot_admits(wire: edited(from: placement_owed, to: placement_observed))
}

test fn an_observed_field_without_its_value_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: replace(s: placement_observed, from: "\"value\": {\"host\": \"srv2\", \"partition\": \"p\", \"unit\": \"u\"}, ", to: "")))
}

test fn an_observed_field_without_its_source_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: replace(s: placement_observed, from: ", \"source\": \"gunbc.roadmap_session_placement session_placement_observe_for_attempt\"", to: "")))
}

test fn an_observed_field_from_the_wrong_reader_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: replace(s: placement_observed, from: "gunbc.roadmap_session_placement session_placement_observe_for_attempt", to: "gunbc.roadmap_attempt_metering metering_observe_for_attempt")))
}

test fn an_owed_field_without_its_producer_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: "{\"field\": \"placement\", \"standing\": \"owed\"}"))
}

test fn a_malformed_producer_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "\"kind\": \"reader_record_absent\"", to: "\"kind\": \"something_else\""))
}

test fn a_pending_reader_with_the_wrong_pull_request_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "\"pr\": 13097", to: "\"pr\": 1"))
}

test fn a_missing_or_malformed_launch_revision_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "0000000000000000000000000000000000000000", to: "zz"))
}

test fn an_extra_member_does_not_re_encode_and_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "\"schema\": \"service-evidence-receipt/v2\", ", to: "\"schema\": \"service-evidence-receipt/v2\", \"extra\": 1, "))
}

test fn an_unknown_field_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "\"field\": \"egress\"", to: "\"field\": \"egresz\""))
}

test fn a_count_preserving_duplicate_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "\"field\": \"egress\"", to: "\"field\": \"wait_time\""))
}

test fn a_reordered_population_does_not_decode() -> Bool {
  !snapshot_admits(wire: replace(s: edited(from: "\"field\": \"workload_class\"", to: "\"field\": \"TMP\""), from: "\"field\": \"resource_request\"", to: "\"field\": \"workload_class\""))
}

test fn an_omitted_field_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: "{\"field\": \"egress\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}, ", to: ""))
}

test fn a_refused_standing_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: "{\"field\": \"placement\", \"standing\": \"refused\", \"reason\": \"torn\"}"))
}

test fn a_summary_shaped_wire_does_not_decode() -> Bool {
  !snapshot_admits(wire: "{\"schema\": \"service-evidence-receipt/v2\", \"instance_id\": \"i1\", \"node_id\": \"n1\", \"attempt_key\": \"k1\", \"launch_revision\": \"0000000000000000000000000000000000000000\", \"fields\": [{\"field\": \"placement\", \"standing\": \"owed\"}]}")
    && !snapshot_admits(wire: "not json")
}

// EACH FIELD STANDS AS ITS SOURCE AUTHORITY ALLOWS: a producer that is valid in itself but belongs to
// another field, or a valid unbuilt owner swapped for another, does not decode.
test fn a_valid_producer_of_another_field_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: placement_owed, to: replace(s: placement_owed, from: "gunbc.roadmap_session_placement session_placement_observe_for_attempt", to: "gunbc.roadmap_attempt_metering metering_observe_for_attempt")))
}

test fn a_valid_unbuilt_owner_swapped_for_another_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(
    from: "{\"field\": \"wait_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"service-evidence-capture\"}}",
    to: "{\"field\": \"wait_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"unbuilt_producer\", \"owner_node\": \"fabric-storage\"}}"))
}

// THE BINDING AT THE READ BOUNDARY, supplied: all four members against the attempt's launch record.
fn bound_a() -> AttemptBindingOutcome { AttemptBound { binding: binding_for(node: node_a, attempt: key_a) } }

test fn the_attempts_own_binding_has_no_defect() -> Bool {
  match service_evidence_binding_defect(instance_id: "i1", node_id: node_a, attempt_key: key_a, launch_revision: "0000000000000000000000000000000000000000", binding: bound_a()) { Absent => true  Present { value: _ } => false }
}

test fn another_valid_launch_revision_is_a_binding_defect() -> Bool {
  match service_evidence_binding_defect(instance_id: "i1", node_id: node_a, attempt_key: key_a, launch_revision: "1111111111111111111111111111111111111111", binding: bound_a()) { Present { value: _ } => true  Absent => false }
}

test fn another_instance_or_an_unlaunched_attempt_is_a_binding_defect() -> Bool {
  (match service_evidence_binding_defect(instance_id: "i2", node_id: node_a, attempt_key: key_a, launch_revision: "0000000000000000000000000000000000000000", binding: bound_a()) { Present { value: _ } => true  Absent => false })
    && (match service_evidence_binding_defect(instance_id: "i1", node_id: node_a, attempt_key: key_a, launch_revision: "0000000000000000000000000000000000000000", binding: AttemptUnlaunched) { Present { value: _ } => true  Absent => false })
}

// ── G3 BOUND (gunbc.roadmap_attempt_metering, landed): the reader's observation supplied at the
// interface. Only a FINAL record is observed; the record's (node, attempt) is re-checked. ──

fn g3_record(node: String, attempt: String) -> AttemptMeteringRecord {
  AttemptMeteringRecord {
    node_id: node,
    attempt_key: attempt,
    metered_at: 2000,
    sealed_roster: Present { value: "roster-digest" },
    roles: [MeteredRoleUsage {
      role: MeteredWorker,
      tokens: TokensObserved { rounds: 3, input_tokens: token_count(count: 1200), output_tokens: token_count(count: 340), terminal: true },
      seat: SeatReleased { pointer: HarnessSeatPointer { partition: "session-memory-srv2" as NonEmptyStr as PartitionId, reference: "seat-1" as NonEmptyStr, owner: "worker" as NonEmptyStr }, granted_at: 1000, released_at: 1600 },
    }],
    compute: ComputeNotAttributable { reason: compute_not_attributable_reason },
  }
}

fn g3_readings(attempt: String, m: AttemptMeteringObservation) -> ServiceEvidenceReadings {
  service_evidence_readings(r: ServiceEvidenceReceipt {
    binding: binding_for(node: node_a, attempt: key_a),
    inputs: inputs_of(o: SessionPlacementAbsent { unit: "u" }, m: m, rr: ResultNotReturned { attempt_key: key_a }, close: SnapshotNotOpened),
  })
}

// POSITIVE CONTROL: a final meter of the bound attempt observes execution_time as the seat time held
// (1600 - 1000 = 600 s) and billable_usage as the input and output tokens, attributed to G3.
test fn a_final_meter_observes_execution_time_and_billable_usage_from_g3() -> Bool {
  let r = g3_readings(attempt: key_a, m: MeteringObserved { record: g3_record(node: node_a, attempt: key_a) })
  (match r.execution_time { EvidenceObserved { value } => second_count(s: value) == 600  _ => false })
    && (match r.billable_usage { EvidenceObserved { value } => token_count_value(t: value.input_tokens) == 1200 && token_count_value(t: value.output_tokens) == 340  _ => false })
    && all(filter(service_evidence_entries(r: r), x => x.field == "execution_time" || x.field == "billable_usage"), x => match x.standing { StandingObserved { value: _, source } => reader_is(a: source, b: MeteringReader)  _ => false })
}

// A provisional record can still change and a record not yet written is nothing: both are a record
// not yet written, never an observed meter. A refused reading is refused.
test fn a_provisional_or_unwritten_meter_is_record_absent_and_a_refused_meter_is_refused() -> Bool {
  let p = g3_readings(attempt: key_a, m: MeteringProvisional { record: g3_record(node: node_a, attempt: key_a) })
  let n = g3_readings(attempt: key_a, m: MeteringNotYetWritten)
  let x = g3_readings(attempt: key_a, m: MeteringRefused { cause: "the launch roster is unreadable" })
  record_absent(r: p.execution_time) && record_absent(r: p.billable_usage)
    && record_absent(r: n.execution_time) && record_absent(r: n.billable_usage)
    && is_refused(r: x.execution_time) && is_refused(r: x.billable_usage)
}

// DISCRIMINATING RED, FOREIGN ATTEMPT: a final record naming another attempt of the node is refused,
// and so is a provisional one -- it never reads as this attempt's absence.
test fn a_meter_for_another_attempt_than_the_binding_is_refused() -> Bool {
  is_refused(r: g3_readings(attempt: key_a, m: MeteringObserved { record: g3_record(node: node_a, attempt: key_b) }).execution_time)
    && is_refused(r: g3_readings(attempt: key_a, m: MeteringObserved { record: g3_record(node: node_b, attempt: key_a) }).billable_usage)
    && is_refused(r: g3_readings(attempt: key_a, m: MeteringProvisional { record: g3_record(node: node_a, attempt: key_b) }).execution_time)
}

// ── G4 BOUND (gunbc.roadmap.roadmap_result_returned, landed) ──

fn g4_outcome() -> AttemptResultOutcome {
  ResultVerificationFailed { head: "52c56a8" as NonEmptyStr, cause: "verdict validation-failed" as NonEmptyStr }
}

fn g4_observed(node: String, attempt: String) -> ResultReturnedObservation {
  ResultReturnedObserved {
    node: node as NonEmptyStr as RoadmapNodeId,
    attempt: attempt as NonEmptyStr,
    event: "evt-result" as NonEmptyStr as RoadmapEventId,
    claim: "evt-claim" as NonEmptyStr as RoadmapEventId,
    return_to: LegacyEmailPrincipal { email: "requester@example.invalid" as NonEmptyStr, authentication_unestablished: true },
    outcome: g4_outcome(),
    recorded_at: "2026-10-03T10:00:00Z",
  }
}

fn g4_readings(rr: ResultReturnedObservation, close: CarrierSnapshotClose) -> ServiceEvidenceReadings {
  service_evidence_readings(r: ServiceEvidenceReceipt {
    binding: binding_for(node: node_a, attempt: key_a),
    inputs: inputs_of(o: SessionPlacementAbsent { unit: "u" }, m: MeteringNotYetWritten, rr: rr, close: close),
  })
}

// POSITIVE CONTROL: a returned result of the bound attempt observes completion_time as its recorded
// instant and failure_attribution as its outcome arm, attributed to G4.
test fn a_returned_result_observes_completion_time_and_failure_attribution_from_g4() -> Bool {
  let r = g4_readings(rr: g4_observed(node: node_a, attempt: key_a), close: SnapshotClosed)
  (match r.completion_time { EvidenceObserved { value } => (value.recorded_at as String) == "2026-10-03T10:00:00Z"  _ => false })
    && (match r.failure_attribution { EvidenceObserved { value } => value == g4_outcome()  _ => false })
    && all(filter(service_evidence_entries(r: r), x => x.field == "completion_time" || x.field == "failure_attribution"), x => match x.standing { StandingObserved { value: _, source } => reader_is(a: source, b: ResultReturnedReader)  _ => false })
}

// NOT OWED IS ITS OWN STANDING: an attempt with no requester owes no result. It is neither a record
// not yet written nor observed, the wire writes it as not_owed from G4, and it is sourced.
test fn a_result_not_owed_is_its_own_standing_not_record_absent() -> Bool {
  let r = g4_readings(rr: ResultNotOwed { reason: "the attempt was launched autonomously, so there is no requester" }, close: SnapshotNotOpened)
  is_not_owed(r: r.completion_time) && is_not_owed(r: r.failure_attribution)
    && !record_absent(r: r.completion_time)
    && all(filter(service_evidence_entries(r: r), x => x.field == "completion_time" || x.field == "failure_attribution"), x => match x.standing { StandingNotOwed { source, reason: _ } => reader_is(a: source, b: ResultReturnedReader)  _ => false })
    && count(service_evidence_unsourced_fields(r: r)) == 14
}

// DISCRIMINATING REDS, FOREIGN ATTEMPT: a result naming another attempt or node, an absence reported
// for another attempt, an unreadable result, and a leaked event-log snapshot are refused.
test fn a_result_for_another_attempt_or_an_unclosed_snapshot_is_refused() -> Bool {
  is_refused(r: g4_readings(rr: g4_observed(node: node_a, attempt: key_b), close: SnapshotClosed).completion_time)
    && is_refused(r: g4_readings(rr: g4_observed(node: node_b, attempt: key_a), close: SnapshotClosed).failure_attribution)
    && is_refused(r: g4_readings(rr: ResultNotReturned { attempt_key: key_b }, close: SnapshotNotOpened).completion_time)
    && is_refused(r: g4_readings(rr: ResultReturnedUnobserved { step: "history", reason: "unordered" }, close: SnapshotNotOpened).failure_attribution)
    && is_refused(r: g4_readings(rr: g4_observed(node: node_a, attempt: key_a), close: SnapshotCloseFailed { worktree: "/tmp/w", exit_code: 1, stderr: "busy" }).completion_time)
}

// INHABITANCE: the encoder's own wire for observed G3 and G4 values carries exactly the observed
// entry literals the snapshot claims below decode, so the decoder accepts the typed carriers these
// readers produce. Encode here, decode there: each claim pays one of the two passes.
test fn the_encoder_writes_the_observed_g3_and_g4_entries_the_decoder_admits() -> Bool {
  let w = service_evidence_receipt_wire(r: ServiceEvidenceReceipt {
    binding: binding_for(node: node_a, attempt: key_a),
    inputs: inputs_of(o: SessionPlacementAbsent { unit: "u" }, m: MeteringObserved { record: g3_record(node: node_a, attempt: key_a) }, rr: g4_observed(node: node_a, attempt: key_a), close: SnapshotClosed),
  })
  string_contains(s: w, pattern: execution_observed) && string_contains(s: w, pattern: failure_observed)
    && string_contains(s: w, pattern: billable_observed) && string_contains(s: w, pattern: completion_observed)
}

// ── THE SNAPSHOT for the G3 and G4 fields: each claim is one targeted edit of canonical_wire ──
data execution_owed: String = "{\"field\": \"execution_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}}"
data execution_observed: String = "{\"field\": \"execution_time\", \"standing\": \"observed\", \"value\": {\"seconds\": 600}, \"source\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}"
data billable_owed: String = "{\"field\": \"billable_usage\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}}"
data completion_owed: String = "{\"field\": \"completion_time\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}}"
data failure_owed: String = "{\"field\": \"failure_attribution\", \"standing\": \"owed\", \"producer\": {\"kind\": \"reader_record_absent\", \"reader\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}}"
data failure_observed: String = "{\"field\": \"failure_attribution\", \"standing\": \"observed\", \"value\": {\"outcome\": \"verification_failed\", \"head\": \"52c56a8\", \"cause\": \"verdict validation-failed\"}, \"source\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}"
data billable_observed: String = "{\"field\": \"billable_usage\", \"standing\": \"observed\", \"value\": {\"input_tokens\": 1200, \"output_tokens\": 340}, \"source\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\"}"
data completion_observed: String = "{\"field\": \"completion_time\", \"standing\": \"observed\", \"value\": {\"recorded_at\": \"2026-10-03T10:00:00Z\"}, \"source\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\"}"
data completion_not_owed: String = "{\"field\": \"completion_time\", \"standing\": \"not_owed\", \"source\": \"gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt\", \"reason\": \"autonomous\"}"

test fn an_observed_execution_time_from_g3_decodes() -> Bool {
  snapshot_admits(wire: edited(from: execution_owed, to: execution_observed))
}

test fn an_observed_failure_attribution_from_g4_decodes() -> Bool {
  snapshot_admits(wire: edited(from: failure_owed, to: failure_observed))
}

test fn observed_billable_usage_and_completion_time_decode() -> Bool {
  snapshot_admits(wire: replace(s: edited(from: completion_owed, to: completion_observed), from: billable_owed, to: billable_observed))
}

test fn a_not_owed_completion_time_from_g4_decodes() -> Bool {
  snapshot_admits(wire: edited(from: completion_owed, to: completion_not_owed))
}

// WRONG READER: a valid execution_time carrier attributed to the placement reader.
test fn an_observed_execution_time_from_the_wrong_reader_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: execution_owed, to: replace(s: execution_observed, from: "gunbc.roadmap_attempt_metering metering_observe_for_attempt", to: "gunbc.roadmap_session_placement session_placement_observe_for_attempt")))
}

// WRONG PRODUCER FOR THE FIELD: completion_time owed to the metering reader's absent record.
test fn a_g4_field_owed_to_the_g3_reader_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: completion_owed, to: replace(s: completion_owed, from: "gunbc.roadmap.roadmap_result_returned result_returned_observe_for_attempt", to: "gunbc.roadmap_attempt_metering metering_observe_for_attempt")))
}

// NOT OWED ONLY FROM A READER THAT CAN ESTABLISH IT: G3 has no not-owed arm.
test fn a_not_owed_standing_from_the_metering_reader_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: billable_owed, to: "{\"field\": \"billable_usage\", \"standing\": \"not_owed\", \"source\": \"gunbc.roadmap_attempt_metering metering_observe_for_attempt\", \"reason\": \"autonomous\"}"))
}

test fn a_failure_attribution_with_an_unknown_outcome_does_not_decode() -> Bool {
  !snapshot_admits(wire: edited(from: failure_owed, to: replace(s: failure_observed, from: "verification_failed", to: "maybe")))
}
