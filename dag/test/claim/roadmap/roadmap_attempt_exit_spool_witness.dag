import extdeps.systemd.service_exec { ServiceResultSuccess, ServiceResultSignal, ServiceResultExitCode }

// The hook is one typed mkdir argv whose single operand is the record's name, with the four stop
// variables spelled as systemd expansions and no shell anywhere.
fn drain_principal() -> PosixOwnerNames {
  PosixOwnerNames { user: "svc" as NonEmptyStr, group: "grp" as NonEmptyStr }
}

test fn exit_hook_is_a_create_only_mkdir_of_the_record_name() -> Bool {
  match attempt_exit_hook(instance_root: "/opt/gunbc-srv2", node_id: "shell-dag-live", attempt_key: "01feb0b65dee1377", role: AttemptWorkerRole, record_owner: drain_principal()) {
    AttemptExitHookRendered { exec_line } =>
      (exec_line as String) == "+install -d -m 00755 -o svc -g grp /opt/gunbc-srv2/attempt-exit-spool/inbox/shell-dag-live+01feb0b65dee1377+worker+$\{INVOCATION_ID}+$\{SERVICE_RESULT}+$\{EXIT_CODE}+$\{EXIT_STATUS}"
    AttemptExitHookRefused { reason: _ } => false
  }
}

test fn exit_hook_refuses_an_instance_root_systemd_would_reinterpret() -> Bool {
  match attempt_exit_hook(instance_root: "/opt/gunbc %n", node_id: "a", attempt_key: "b", role: AttemptWorkerRole, record_owner: drain_principal()) {
    AttemptExitHookRefused { reason: _ } => true
    AttemptExitHookRendered { exec_line: _ } => false
  }
}

test fn an_exit_record_decodes_to_its_status_and_a_kill_to_its_signal() -> Bool {
  let exited = match attempt_exit_entry_decode(entry_name: "n-1+k1+worker+0123456789abcdef0123456789abcdef+success+exited+0") {
    AttemptExitEntryDecoded { record } =>
      attempt_exit_record_names_attempt(record: record, node_id: "n-1", attempt_key: "k1")
        && (match record.result { ServiceResultSuccess => true _ => false })
        && (match record.end { AttemptProcessExitedWith { status } => status == 0 AttemptProcessSignaled { signal: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
  let killed = match attempt_exit_entry_decode(entry_name: "n-1+k1+worker+0123456789abcdef0123456789abcdef+signal+killed+TERM") {
    AttemptExitEntryDecoded { record } =>
      (match record.result { ServiceResultSignal => true _ => false })
        && (match record.end { AttemptProcessSignaled { signal } => linux_standard_signal_number(signal: signal) == 15 AttemptProcessExitedWith { status: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
  exited && killed
}

test fn a_vendor_pane_record_derives_result_from_status() -> Bool {
  let zero = attempt_exit_vendor_pane_entry_name(node_id: "n", attempt_key: "k", status: 0)
  let killed_status = attempt_exit_vendor_pane_entry_name(node_id: "n", attempt_key: "k", status: 9)
  let zero_ok = attempt_exit_vendor_pane_result_word(status: 0) == "success"
    && match attempt_exit_entry_decode(entry_name: zero) {
      AttemptExitEntryDecoded { record } =>
        (match record.result { ServiceResultSuccess => true _ => false })
          && (match record.end { AttemptProcessExitedWith { status } => status == 0 AttemptProcessSignaled { signal: _ } => false })
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
    }
  let nine_ok = attempt_exit_vendor_pane_result_word(status: 9) == "exit-code"
    && match attempt_exit_entry_decode(entry_name: killed_status) {
      AttemptExitEntryDecoded { record } =>
        (match record.result { ServiceResultExitCode => true _ => false })
          && (match record.end { AttemptProcessExitedWith { status } => status == 9 AttemptProcessSignaled { signal: _ } => false })
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
    }
  zero_ok && nine_ok
}

test fn a_vendor_pane_signal_record_decodes_as_killed() -> Bool {
  match attempt_exit_vendor_pane_entry_name_of_death(node_id: "n", attempt_key: "k", death: VendorPaneSignaled { signal: 9 }) {
    Absent => false
    Present { value: name } =>
      match attempt_exit_entry_decode(entry_name: name) {
        AttemptExitEntryDecoded { record } =>
          (match record.result { ServiceResultSignal => true  _ => false })
            && (match record.end { AttemptProcessSignaled { signal } => linux_standard_signal_number(signal: signal) == 9  AttemptProcessExitedWith { status: _ } => false })
        AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
      }
  }
}

test fn a_vendor_pane_exit_name_decodes_from_status() -> Bool {
  let zero_ok = match attempt_exit_entry_decode(entry_name: "n+k+worker+vendorpane+success+exited+0") {
    AttemptExitEntryDecoded { record } =>
      (match record.result { ServiceResultSuccess => true _ => false })
        && (match record.end { AttemptProcessExitedWith { status } => status == 0 AttemptProcessSignaled { signal: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
  let nine_ok = match attempt_exit_entry_decode(entry_name: "n+k+worker+vendorpane+exit-code+exited+9") {
    AttemptExitEntryDecoded { record } =>
      (match record.result { ServiceResultExitCode => true _ => false })
        && (match record.end { AttemptProcessExitedWith { status } => status == 9 AttemptProcessSignaled { signal: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
  zero_ok && nine_ok
}

test fn a_vendor_pane_signal_name_decodes_as_killed() -> Bool {
  match attempt_exit_entry_decode(entry_name: "n+k+worker+vendorpane+signal+killed+KILL") {
    AttemptExitEntryDecoded { record } =>
      (match record.result { ServiceResultSignal => true  _ => false })
        && (match record.end { AttemptProcessSignaled { signal } => linux_standard_signal_number(signal: signal) == 9  AttemptProcessExitedWith { status: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

test fn a_name_that_is_not_seven_parts_or_whose_status_contradicts_its_code_is_malformed() -> Bool {
  let short = match attempt_exit_entry_decode(entry_name: "n+k+worker+inv+success+exited") { AttemptExitEntryMalformed { entry_name: _, reason: _ } => true AttemptExitEntryDecoded { record: _ } => false }
  let contradiction = match attempt_exit_entry_decode(entry_name: "n+k+worker+inv+success+exited+TERM") { AttemptExitEntryMalformed { entry_name: _, reason: _ } => true AttemptExitEntryDecoded { record: _ } => false }
  let unlisted_code = match attempt_exit_entry_decode(entry_name: "n+k+worker+inv+success+vanished+0") { AttemptExitEntryMalformed { entry_name: _, reason: _ } => true AttemptExitEntryDecoded { record: _ } => false }
  short && contradiction && unlisted_code
}

// The observer's three arms over supplied listings: a record in any stage is found; every stage read
// and none for this attempt is None (never "never ran"); a stage that could not be read is
// Unreadable, never None.
test fn record_found_in_any_stage_none_when_all_read_unreadable_when_one_is_not() -> Bool {
  let other = "other+k9+worker+inv+success+exited+0"
  let mine = "n-1+k1+worker+inv+exit-code+exited+3"
  let found = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [other] }, AttemptExitStageNames { names: [] }, AttemptExitStageNames { names: [mine] }]) {
    AttemptExitRecordFound { record } => match record.end { AttemptProcessExitedWith { status } => status == 3 AttemptProcessSignaled { signal: _ } => false }
    AttemptExitRecordNone => false
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } => false
    AttemptExitRecordUnreadable { reason: _ } => false
  }
  let none_found = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [other] }, AttemptExitStageNames { names: [] }, AttemptExitStageNames { names: [] }]) {
    AttemptExitRecordNone => true
    AttemptExitRecordFound { record: _ } => false
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } => false
    AttemptExitRecordUnreadable { reason: _ } => false
  }
  let unreadable = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [mine] }, AttemptExitStageUnreadable { reason: "EACCES" }, AttemptExitStageNames { names: [] }]) {
    AttemptExitRecordUnreadable { reason: _ } => true
    AttemptExitRecordFound { record: _ } => false
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } => false
    AttemptExitRecordNone => false
  }
  found && none_found && unreadable
}

// The role is part of the subject: a reviewer's record for the same attempt never answers for its
// worker, and the reviewer's hook names its criterion and head.
test fn a_records_role_is_part_of_its_subject() -> Bool {
  let only_reviewer = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: ["n-1+k1+review.conformance-leasing.abc123+inv+success+exited+0"] }]) {
    AttemptExitRecordNone => true
    AttemptExitRecordFound { record: _ } => false
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } => false
    AttemptExitRecordUnreadable { reason: _ } => false
  }
  let reviewer_found = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptReviewerRole { criterion_key: "conformance-leasing", head_sha: "abc123" }, listings: [AttemptExitStageNames { names: ["n-1+k1+worker+inv+success+exited+0", "n-1+k1+review.conformance-leasing.abc123+inv+success+exited+0"] }]) {
    AttemptExitRecordFound { record } => attempt_exit_record_is_role(record: record, token: "review.conformance-leasing.abc123")
    AttemptExitRecordNone => false
    AttemptExitRecordWriterUnsubstituted { entries: _, variables: _ } => false
    AttemptExitRecordUnreadable { reason: _ } => false
  }
  only_reviewer && reviewer_found
}

// A SIGNAL NAME OUTSIDE signal(7)'s standard set has no constructor, so the record that names one is
// refused at decode rather than carried as text to the point of use.
test fn an_unlisted_signal_name_is_refused_at_decode() -> Bool {
  match attempt_exit_entry_decode(entry_name: "n-1+k1+worker+0123456789abcdef0123456789abcdef+signal+killed+RTMIN") {
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => true
    AttemptExitEntryDecoded { record: _ } => false
  }
}

// Review 78301: an entry that names this attempt but cannot be decoded (non-numeric status) is its end
// UNOBSERVED, never absent -- settlement must not free on it. Another attempt's malformed entry is not this one's.
test fn an_undecodable_entry_for_this_attempt_is_unreadable_and_another_attempts_is_not() -> Bool {
  let mine = "n-1+k1+worker+inv+exit-code+exited+BOGUS"
  let other = "n-2+k9+worker+inv+exit-code+exited+BOGUS"
  (match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [mine] }]) {
    AttemptExitRecordUnreadable { reason: _ } => true
    _ => false
  }) && (match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [other] }]) {
    AttemptExitRecordNone => true
    _ => false
  })
}

// THE SRV1 2026-10-28 ARTIFACT, VERBATIM IN SHAPE: the worker unit's only exit entry spells all four
// stop variables UNEXPANDED (its audit, obligation and review units wrote expanded records in the same
// minute). It is malformed, but malformed ABOUT ITS WRITER, and the observer must say which -- reading
// it as "this attempt's end is unobserved" is what held a 22 GiB seat for twelve days.
test fn an_unsubstituted_entry_names_its_writer_and_never_its_holder() -> Bool {
  let entry = "n-1+k1+worker+$\{INVOCATION_ID}+$\{SERVICE_RESULT}+$\{EXIT_CODE}+$\{EXIT_STATUS}"
  let spelled = attempt_exit_entry_unexpanded_variables(entry_name: entry)
  let answered = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [entry] }]) {
    AttemptExitRecordWriterUnsubstituted { entries, variables } =>
      count(entries) == 1 && any(entries, e => e == entry)
        && count(variables) == 4
        && any(variables, v => v == "INVOCATION_ID") && any(variables, v => v == "SERVICE_RESULT")
        && any(variables, v => v == "EXIT_CODE") && any(variables, v => v == "EXIT_STATUS")
    _ => false
  }
  // A decodable record for the same subject still answers the end; the broken artifact does not hide it.
  let good = "n-1+k1+worker+0123456789abcdef0123456789abcdef+exit-code+exited+3"
  let decodable_still_answers = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [entry, good] }]) {
    AttemptExitRecordFound { record } => record.entry_name == good
    _ => false
  }
  // Another attempt's unsubstituted entry is not this attempt's, and a name that merely cannot be
  // decoded (no stop-variable spelling) stays the plain "unobserved" answer it was.
  let foreign = match attempt_exit_record_from_listings(node_id: "n-2", attempt_key: "k9", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: [entry] }]) {
    AttemptExitRecordNone => true
    _ => false
  }
  let ordinary = match attempt_exit_record_from_listings(node_id: "n-1", attempt_key: "k1", role: AttemptWorkerRole, listings: [AttemptExitStageNames { names: ["n-1+k1+worker+inv+exit-code+exited+BOGUS"] }]) {
    AttemptExitRecordUnreadable { reason: _ } => true
    _ => false
  }
  count(spelled) == 4 && answered && decodable_still_answers && foreign && ordinary
}

test fn linux_standard_signal_lookups_invert_the_one_name_and_number_tables() -> Bool {
  all(linux_standard_signals, s =>
    match linux_standard_signal_of_number(n: linux_standard_signal_number(signal: s)) {
      Absent => false
      Present { value: by_n } =>
        linux_standard_signal_number(signal: by_n) == linux_standard_signal_number(signal: s)
          && match linux_standard_signal_of_name(name: linux_standard_signal_wire_name(signal: s)) {
            Absent => false
            Present { value: by_name } =>
              linux_standard_signal_wire_name(signal: by_name) == linux_standard_signal_wire_name(signal: s)
          }
    })
    && match linux_standard_signal_of_number(n: 0) {
      Absent => true
      Present { value: _ } => false
    }
    && match linux_standard_signal_of_name(name: "NOTASIGNAL") {
      Absent => true
      Present { value: _ } => false
    }
}

// THE UNIT IS DERIVED, PER ROUTE. Each row decodes a real entry name through the production decoder and
// compares the record's unit against what THAT ROUTE'S launcher builder returns. One row per route, not a
// roster-wide all(): delete one builder's use in the decoder and exactly that route's row goes red.
fn witness_worker_unit(node_id: String, attempt_key: String) -> String {
  match dispatch_attempt_unit_name(node_id: node_id, attempt_key: attempt_key) {
    SystemdUnitNameAdmitted { name } => systemd_unit_name_wire(name: name)
    SystemdUnitNameStemEmpty => ""
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => ""
    SystemdUnitNameOverlong { length: _ } => ""
  }
}

test fn the_worker_record_derives_the_unit_the_worker_launcher_names() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+worker+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      record.unit == witness_worker_unit(node_id: "node-a", attempt_key: "key-1")
        && string_contains(s: record.unit, pattern: "gunbc-attempt-node-a-key-1.service")
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

test fn the_reviewer_record_derives_the_review_unit_for_its_criterion() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+review.conformance-leasing.2f3a9c1d+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      record.unit == dispatch_review_unit_name(node_id: "node-a", attempt_key: "key-1", criterion_key: "conformance-leasing")
        && attempt_exit_record_is_role(record: record, token: "review.conformance-leasing.2f3a9c1d")
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

test fn the_auditor_record_derives_the_audit_unit() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+audit.2f3a9c1d+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      record.unit == dispatch_audit_unit_name(node_id: "node-a", attempt_key: "key-1")
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

test fn the_supervisor_record_derives_the_supervisor_unit_for_its_turn() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+supervise.t3+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      record.unit == dispatch_supervisor_unit_name(node_id: "node-a", attempt_key: "key-1", turn: 3)
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

test fn the_obligation_record_derives_the_obligation_unit() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+obligation+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      record.unit == belt_attempt_obligation_unit_name(node_id: "node-a", attempt_key: "key-1")
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

// A role no launcher declares is refused BY NAME: the decoder never invents a unit name, and a name no
// launcher can produce is not evidence about any holder.
test fn a_role_no_launcher_declares_refuses_the_record_naming_that_role() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+gatekeeper+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason } =>
      string_contains(s: reason, pattern: "gatekeeper") && string_contains(s: reason, pattern: "no launcher this build declares")
  }
}

// A role that LOOKS like a declared one but has the wrong shape is refused too, rather than guessed at:
// a reviewer role with no head segment would otherwise be read as a criterion that does not exist.
test fn a_reviewer_role_with_the_wrong_shape_refuses_naming_that_role() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+review.conformance-leasing+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason } =>
      string_contains(s: reason, pattern: "review.conformance-leasing") && string_contains(s: reason, pattern: "review.<criterion>.<head>")
  }
}

// THE COMPUTE ROUTE SHARES THE DECODER AND THE END RULES, and derives its unit from the identity by
// calling the SAME builder the launcher used (gunbc.systemd_unit_names compute_unit_name). The literal is
// the pairing: a launcher that renames its units, or a decoder that starts spelling them itself, turns
// this row red. A seat runs one unit, so its entry has five parts and no role.
test fn a_compute_seats_entry_derives_the_units_name_from_its_identity() -> Bool {
  match attempt_exit_entry_decode(entry_name: "0a1b2c3d4e5f6789.occurrence.1793000000+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      (record.unit as String) == "gunbc-compute-0a1b2c3d4e5f6789.occurrence.1793000000"
        && (record.unit as String) == (compute_unit_name(identity_hex: "0a1b2c3d4e5f6789.occurrence.1793000000") as String)
        && (match record.subject {
             ComputeAttemptExit { identity } => identity == "0a1b2c3d4e5f6789.occurrence.1793000000"
             RoadmapAttemptExit { node_id: _, attempt_key: _, role: _ } => false
           })
        // ONE COPY OF THE INVOCATION. It belongs to the record alone -- the arm says whose seat this is and
        // carries no second copy -- so the view a consumer matches on can only be reading the record's. Had
        // the arm kept its own copy, a record whose copies disagree would be constructible, and the door
        // would match on one while the freeing detail named the other.
        && record.invocation_id == "0123456789abcdef0123456789abcdef"
        && (match attempt_exit_subject_of_record(record: record) {
             ComputeEntrySubject { identity: i, invocation_id: v } =>
               i == "0a1b2c3d4e5f6789.occurrence.1793000000" && v == record.invocation_id
             _ => false
           })
        && (match record.end { AttemptProcessExitedWith { status } => status == 0 AttemptProcessSignaled { signal: _ } => false })
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

// CONTROL, THE OTHER ROUTE CANNOT BE READ AS THIS ONE: the identity and the invocation are put where an
// attempt's node and key would sit, so a decoder that filled the roadmap fields positionally -- or a
// consumer allowed to read a record's subject without answering both arms -- would call this seat's record
// a worker's exit and settle a seat it does not own.
test fn a_compute_seats_record_is_never_read_as_an_attempts_worker() -> Bool {
  match attempt_exit_entry_decode(entry_name: "0a1b2c3d4e5f6789.occurrence.1793000000+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record } =>
      !attempt_exit_record_is_role(record: record, token: "worker")
        && !attempt_exit_record_names_attempt(record: record, node_id: "0a1b2c3d4e5f6789.occurrence.1793000000", attempt_key: "0123456789abcdef0123456789abcdef")
    AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
  }
}

// AN IDENTITY THAT CANNOT NAME A UNIT IS REFUSED BY NAME. The decoder never invents a name to carry on
// with: a name no launcher of this build can produce is not evidence about any holder, so the entry is
// refused with the identity spelled out for whoever has to read it.
test fn a_compute_identity_no_launcher_can_name_is_refused_by_name() -> Bool {
  match attempt_exit_entry_decode(entry_name: "seat;identity+0123456789abcdef0123456789abcdef+completed+exited+0") {
    AttemptExitEntryDecoded { record: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason } =>
      string_contains(s: reason, pattern: "seat;identity") && string_contains(s: reason, pattern: "cannot name a unit")
  }
}

// NEITHER ROUTE, REFUSED WITH THE COUNT IT CARRIED: the part count is what says who wrote an entry, so an
// entry that is neither route's is not guessed into one of them.
test fn an_entry_that_is_neither_route_refuses_with_the_count_it_carried() -> Bool {
  match attempt_exit_entry_decode(entry_name: "node-a+key-1+worker+0123456789abcdef0123456789abcdef+completed+exited") {
    AttemptExitEntryDecoded { record: _ } => false
    AttemptExitEntryMalformed { entry_name: _, reason } =>
      string_contains(s: reason, pattern: "seven") && string_contains(s: reason, pattern: "five") && string_contains(s: reason, pattern: "6")
  }
}
