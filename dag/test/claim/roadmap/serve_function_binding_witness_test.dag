module test.claim.serve_function_binding_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, NonEmptyStr, List, CommitSha }
import extdeps.http.server { ServeWireResponse, ServeRequestHeader }
import gunbc.roadmap_dashboard_instance {
  HostDashboardInstance,
  public_builtin_dashboard_instances,
  dashboard_instance_health_identity_prefix,
}
import gunbc.roadmap_serve {
  roadmap_serve_handle,
  roadmap_serve_handle_macbook_local,
  roadmap_serve_handle_srv1_lab,
  roadmap_serve_handle_srv2_preview,
  roadmap_serve_handle_srv2_deploy,
  roadmap_serve_handle_srv2_lab,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY INSTANCE'S serve_function SERVES THAT SAME INSTANCE. HostDashboardInstance.serve_function is
// the name its unit passes to `gunbc serve --function`, and each declared handler binds exactly one
// instance; a row naming another instance's handler serves that other instance's state under its own
// unit -- the MacBook row named srv1-live's roadmap_serve_handle while roadmap_serve_handle_macbook_local
// existed. The control runs each handler on /instance.json (its per-instance identity route; /healthz
// is release-only and identical for every instance) and requires the answer to START with
// the identity prefix of the instance whose row names it, so a handler bound to any other instance
// fails, and a row naming a handler this table does not carry fails as unbound.
type ServeHandlerRow {
  name: String
  handle: fn(String, String, String, String, List<ServeRequestHeader>, CommitSha) -> ServeWireResponse
}

fn declared_serve_handlers() -> List<ServeHandlerRow> {
  [
    ServeHandlerRow { name: "roadmap_serve_handle", handle: (m, p, b, t, h, r) => roadmap_serve_handle(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
    ServeHandlerRow { name: "roadmap_serve_handle_macbook_local", handle: (m, p, b, t, h, r) => roadmap_serve_handle_macbook_local(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
    ServeHandlerRow { name: "roadmap_serve_handle_srv1_lab", handle: (m, p, b, t, h, r) => roadmap_serve_handle_srv1_lab(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
    ServeHandlerRow { name: "roadmap_serve_handle_srv2_preview", handle: (m, p, b, t, h, r) => roadmap_serve_handle_srv2_preview(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
    ServeHandlerRow { name: "roadmap_serve_handle_srv2_deploy", handle: (m, p, b, t, h, r) => roadmap_serve_handle_srv2_deploy(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
    ServeHandlerRow { name: "roadmap_serve_handle_srv2_lab", handle: (m, p, b, t, h, r) => roadmap_serve_handle_srv2_lab(method: m, path: p, body: b, tailscale_identity: t, request_headers: h, release_revision: r) },
  ]
}

fn instance_serves_itself(instance: HostDashboardInstance) -> Bool {
  let bound = filter(declared_serve_handlers(), h => h.name == (instance.serve_function as String))
  count(bound) == 1
    && all(bound, h => {
      let serve = h.handle
      let answer = serve("GET", "/instance.json", "", "", [], "0000000000000000000000000000000000000000" as CommitSha)
      answer.status == 200
        && starts_with(s: answer.body, prefix: dashboard_instance_health_identity_prefix(instance_id: instance.instance_id as String))
    })
}

test fn every_instances_serve_function_serves_that_instance() -> Bool {
  all(public_builtin_dashboard_instances(), i => instance_serves_itself(instance: i))
}
