// ── FIXTURES ─────────────────────────────────────────────────────────────────────────────────────

// The witness voice: a named assertion, checked by its own line. The label documents the row;
// the boolean is what the runner reports.
fn claim(label: String, satisfied: Bool) -> Bool { satisfied }

fn wet(fn_with: fn(FabricStorageBinding) -> Bool) -> Bool {
  match fabric_wet_scenario(template: "/tmp/gunbc_operator_close_witness.XXXXXX" as NonEmptyStr) {
    FabricWetScenarioUnready { detail: d } => claim("the wet scenario could not be made: " + d, false)
    FabricWetScenarioReady { instance: instance, root: _ } =>
      match fabric_wet_store(members: fabric_storage_slots, instance: instance) {
        FabricWetStoreUnready { area: a, detail: d } => claim("the fabric store is not ready at " + (a as String) + ": " + d, false)
        FabricWetStoreReady { store: ops } => fn_with(FabricStorageLocalFiles { operations: ops })
      }
  }
}

fn merged_readback(number: Int) -> OperatorPrReadback {
  PrRoster { rows: [ OperatorPrRow {
    number: number,
    state: Present { value: PullRequestViewMerged },
    merged_at: ("2026-11-03T04:15:00Z" as NonEmptyStr),
    head_sha: ("0123456789abcdef0123456789abcdef01234567" as NonEmptyStr),
  } ] }
}

// The fixture node's review standing: the fabric's own record that the merged PR under test
// belongs to the node under test (the readback-vs-record binding, review 90905). Rows that
// exercise the refusal pass a different standing explicitly.
fn ready_standing() -> RoadmapNodeStanding {
  NodeReadyForReview {
    by: opr_principal(),
    pr: ("briansrls/gunbc#14189" as NonEmptyStr),
    head: ("0123456789abcdef0123456789abcdef01234567" as NonEmptyStr),
  }
}

// A ready standing naming a DIFFERENT pull — the fabric's record for a different node's work.
fn ready_standing_other_pr() -> RoadmapNodeStanding {
  NodeReadyForReview {
    by: opr_principal(),
    pr: ("briansrls/gunbc#999" as NonEmptyStr),
    head: ("0123456789abcdef0123456789abcdef01234567" as NonEmptyStr),
  }
}


