fn close_request(body: String, node_id: String) -> ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence> {
  ServeHttpRequest {
    path: concat("/issue/", concat(node_id, "/close")),
    method: POST,
    body: body,
    security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: AuthAbsent },
  }
}

fn close_request_as_operator(body: String, node_id: String) -> ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence> {
  let r = close_request(body: body, node_id: node_id)
  ServeHttpRequest {
    path: r.path, method: r.method, body: r.body,
    security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: GoogleOidcSession { session: session_fixture() } },
  }
}

fn node_param(node_id: String) -> List<PathParamBinding> {
