fn close_layout(instance: HostDashboardInstance) -> RoadmapEventCarrierLayout {
  roadmap_event_carrier_layout_for_instance(instance: instance)
}

// How many acceptances the ONE home holds, counted through the same reader production uses. A
// refused read is -1, never zero: a read that did not happen is not an empty history.
fn close_row_count(instance: HostDashboardInstance) -> Int {
  match roadmap_operator_close_history(layout: close_layout(instance)) {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => count(filter(events, e => match e {
      AcceptanceRecorded { receipt: _ } => true
      AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => false
    }))
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => -1
  }
}

// A carrier that cannot be read at all: the instance exists, its carrier does not. The load must
// refuse over it, never answer an empty history (gunbc.design_argument::fail_closed).
fn refused_carrier_instance() -> HostDashboardInstance {
  fabric_fixture_instance(root: "/nonexistent-roadmap-close-carrier" as String)
}

// The canonical line of the first acceptance in the log, through the same reader production uses.
fn close_first_line(instance: HostDashboardInstance) -> String? {
  match roadmap_operator_close_history(layout: close_layout(instance)) {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => match events.first() {
      Present { value: e } => match e {
        AcceptanceRecorded { receipt: r } => Present { value: roadmap_acceptance_line_of_receipt(receipt: r) as String }
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => none
      }
      Absent => none
    }
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => none
  }
}

fn live_node_names(load: RoadmapAcceptanceEventHistoryLoad) -> List<String> {
  match load {
    RoadmapAcceptanceEventHistoryLoaded { events: evs } =>
      evs |> map(e => match e {
        AcceptanceRecorded { receipt: r } => r.node as String
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => ""
      })
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

