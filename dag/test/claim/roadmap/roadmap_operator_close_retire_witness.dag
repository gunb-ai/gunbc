fn tail_count(store: FabricStorageBinding) -> Int {
  match roadmap_operator_acceptance_read(store: store) {
    TailRead { head: _, entries: envs } => count(envs)
    TailUnreadable { reason: _ } => -1
  }
}

fn live_node_names(load: RoadmapAcceptanceEventHistoryLoad) -> List<String> {
  match load {
    RoadmapAcceptanceEventHistoryLoaded { events: evs } =>
      evs |> map(e => match e {
        AcceptanceRecorded { receipt: r } => r.node as String
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => ""
      })
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

fn operator_node(id: String) -> RoadmapNode {
  let base = sample_task()
  RoadmapNode {
    identity: base.identity,
    node: id as NonEmptyStr as RoadmapNodeId,
    line: base.line,
    carriers: base.carriers,
    dispatch: base.dispatch,
    execution: base.execution,
    owner: base.owner,
    parent: base.parent,
    centering: base.centering,
  }
}

