// ── THE CLOCK DERIVES THE DAY ────────────────────────────────────────────────────────────────────

data clock_zero: EpochSecs = 0

data clock_newest: EpochSecs = 1791676800

data clock_mid: EpochSecs = 1760227200

test fn the_close_derives_the_civil_utc_day_from_the_clock() -> Bool {
  let d0 = roadmap_operator_date_from_epoch_secs(secs: clock_zero)
  let d1 = roadmap_operator_date_from_epoch_secs(secs: clock_newest)
  let d2 = roadmap_operator_date_from_epoch_secs(secs: clock_mid)
  let e0 = claim("epoch zero is 1970-01-01", d0.year == 1970 && d0.month == 1 && d0.day == 1
    && (roadmap_operator_render_civil_date(date: d0) as String) == "1970-01-01")
  let e1 = claim("the newest seed day reads back exactly", (roadmap_operator_render_civil_date(date: d1) as String) == "2026-10-11")
  let e2 = claim("a mid-year day lands right", (roadmap_operator_render_civil_date(date: d2) as String) == "2025-10-12")
  e0 && e1 && e2
}

// ── THE WIRE LINE IS CANONICAL AND PARSLES UNDER THE SEED'S OWN LAW ──────────────────────────────

fn sample_receipt(node: String) -> RoadmapAcceptanceReceipt {
  RoadmapAcceptanceReceipt {
    node: node as NonEmptyStr as RoadmapNodeId,
    criteria_digest: roadmap_criteria_digest(t: sample_ticket()),
    red_control: RedControlExecuted {
      witness_module: "test/claim/roadmap/roadmap_operator_close_retire_witness" as NonEmptyStr,
      witness_fn: "witness_executes" as NonEmptyStr,
      executed_on: "2026-11-03",
    },
    handback: HandbackDelivered { first_artifact: "commit abc", further_artifacts: [] as List<NonEmptyStr> },
    accepted_by: "briansrls" as NonEmptyStr,
    accepted_on: "2026-11-03" as NonEmptyStr,
  }
}

test fn a_receipt_writes_one_canonical_line_the_seed_parser_accepts_once() -> Bool {
  let receipt = sample_receipt("node-wire-roundtrip")
  let line = roadmap_operator_acceptance_receipt_line(receipt: receipt)
  let again = roadmap_operator_acceptance_receipt_line(receipt: receipt)
  let e1 = claim("the same receipt serializes byte-identically", line == again)
  let e2 = claim("the line is not empty", line != "")
  let e3 = match load_roadmap_acceptance_event_history_from_carrier_text(text: line) {
    RoadmapAcceptanceEventHistoryLoaded { events: evs } => claim("the seed parser accepts exactly this line, once", count(evs) == 1)
    RoadmapAcceptanceEventHistoryLoadRefused { detail: d } => claim("the seed parser refused its own line: " + d, false)
  }
  e1 && e2 && e3
}

test fn a_corrupt_tail_line_refuses_located_and_never_silently() -> Bool {
  let good = roadmap_operator_acceptance_receipt_line(receipt: sample_receipt("node-good"))
  match roadmap_operator_acceptance_parse_tail(lines: [good, "{ not json"] as List<String>) {
    RoadmapAcceptanceTailOk { events: evs } => claim("a corrupt line slipped through unrefused", false)
    RoadmapAcceptanceTailBad { line_index: i, detail: _ } => claim("the corrupt line is refused, located at index 1", nat_to_int(i) == 1)
  }
}

// ── THE CLOSE GATE: EVERY REFUSAL TYPED, NOTHING WRITTEN ─────────────────────────────────────────

test fn an_unreadable_github_refuses_the_close_fail_closed() -> Bool {
  wet(fn_with: fn(instance) {
    let answer = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-github-down"),
      readback: PrReadbackUnavailable { cause: "network refused" as NonEmptyStr }, standing: ready_standing())
    match answer {
      CloseRefused { reason: r } => match r {
        ClosePrUnreadable { cause: _ } => claim("a merge nobody read is not a merge", true)
          && claim("nothing was written for the unread close", close_row_count(instance) == 0)
        _ => claim("the unread-GitHub close refused with the wrong kind", false)
      }
      _ => claim("an unread merge was accepted", false)
    }
  })
}

test fn an_unmerged_pr_and_an_absent_pr_refuse_carrying_their_facts() -> Bool {
  wet(fn_with: fn(instance) {
    let unmerged = PrRoster { rows: [ OperatorPrRow {
      number: 14189, state: Present { value: PullRequestViewClosed }, merged_at: none, head_sha: none,
    } ] }
    let a = match roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-unmerged"), readback: unmerged, standing: ready_standing()) {
      CloseRefused { reason: r } => match r {
        ClosePrNotMerged { pr_number: _, state: st } => claim("the unmerged refusal carries the state", (st as String) == "CLOSED")
        _ => claim("the unmerged PR refused with the wrong kind", false)
      }
      _ => claim("an unmerged PR was closed", false)
    }
    let b = match roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-absent"), readback: PrRoster { rows: [] as List<OperatorPrRow> }, standing: ready_standing()) {
      CloseRefused { reason: r } => match r {
        ClosePrNotFound { pr_number: _ } => claim("a PR absent from the roster is not merged", true)
        _ => claim("the absent PR refused with the wrong kind", false)
      }
      _ => claim("an absent PR was closed", false)
    }
    let d = claim("nothing was written by the refused closes", close_row_count(instance) == 0)
    a && b && d
  })
}

// ── THE CLOSE SUCCEEDS: DURABLE, VISIBLE, DETERMINISTIC, DEPENDING ───────────────────────────────

test fn a_merged_pr_close_lands_durably_reads_closed_on_reload_and_frees_its_child() -> Bool {
  wet(fn_with: fn(instance) {
    match roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-merged-ok"), readback: merged_readback(14189), standing: ready_standing()) {
      CloseWritten { event_id: _ } => {
        let e1 = claim("the tail holds exactly the one acceptance", close_row_count(instance) == 1)
        // Durable across restart: a fresh binding over the same store — what the process holds
        // after a restart — still carries the live receipt, and the node reads closed off it.
        let reloaded = roadmap_operator_close_history(layout: close_layout(instance))
        let e2 = claim("a reload of the store sees the acceptance", count(filter(live_node_names(reloaded), n => n == "node-merged-ok")) == 1)
        let e3 = claim("the node reads closed off the reloaded history",
          roadmap_operator_node_closed(node: "node-merged-ok" as NonEmptyStr as RoadmapNodeId, history: reloaded) == AcceptanceFound)
        // Determinism: the same inputs against a fresh store give the SAME durable record.
        let first_line = close_first_line(instance)
        let twin = wet(fn_with: twin_instance => match roadmap_operator_close(
            instance: twin_instance,
            inputs: close_inputs("node-merged-ok"), readback: merged_readback(14189), standing: ready_standing()) {
          CloseWritten { event_id: _ } => match close_first_line(twin_instance) {
            Present { value: twin_line } => match first_line {
              Present { value: l } => claim("same inputs give the same durable record", twin_line == l)
              Absent => claim("the first carrier's line vanished", false)
            }
            Absent => claim("the twin carrier is empty", false)
          }
          _ => claim("the twin close refused", false)
        })
        // The dependent consequence: with this acceptance live, a child with this parent is ready.
        let accepted = roadmap_node_id_set(["node-merged-ok" as NonEmptyStr as RoadmapNodeId])
        let parents = map_insert(empty_map(), "node-child", ["node-merged-ok" as NonEmptyStr as RoadmapNodeId])
        let e6 = claim("a dependent becomes ready once the parent is accepted",
          count(unmet_parents_in(n: operator_node("node-child"), parents: parents, accepted: accepted)) == 0)
        let e7 = claim("with no acceptance the same child stays blocked",
          count(unmet_parents_in(n: operator_node("node-child"), parents: parents, accepted: empty_set())) == 1)
        e1 && e2 && e3 && twin && e6 && e7
      }
      CloseRefused { reason: r } => claim("the merged-PR close refused", false)
      CloseAlreadyRecorded { event_id: _ } => claim("a fresh node replayed unexpectedly", false)
    }
  })
}

// ── THE KEY IS AN IDEMPOTENCY KEY AND NOTHING ELSE ───────────────────────────────────────────────

// THE RECEIPT IS THE IDEMPOTENCY IDENTITY — no operator-supplied key exists any more. The same
// close answers the FIRST recording's own identity; a close carrying other content for a node that
// already holds a live receipt refuses rather than writing a second one.
test fn the_same_close_replays_the_first_recording_and_other_content_refuses() -> Bool {
  wet(fn_with: fn(instance) {
    let first = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-keys"), readback: merged_readback(14189), standing: ready_standing())
    let e1 = match first { CloseWritten { event_id: _ } => claim("the first close wrote", true) _ => claim("the first close refused", false) }
    let replay = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-keys"), readback: merged_readback(14189), standing: ready_standing())
    let e2 = match replay {
      CloseAlreadyRecorded { event_id: id1 } => match first {
        CloseWritten { event_id: id0 } => claim("the replay answers the FIRST recording, not a recomputed twin", (id0 as String) == (id1 as String))
        _ => false
      }
      _ => claim("an identical close did not answer the first recording", false)
    }
    let base = close_inputs("node-keys")
    let conflicting = roadmap_operator_close(
      instance: instance,
      inputs: OperatorCloseInputs {
        node: base.node, ticket: base.ticket, repo: base.repo, pr_number: base.pr_number,
        accepted_by: base.accepted_by, accepted_on: base.accepted_on,
        witness_module: base.witness_module, witness_fn: base.witness_fn,
        first_artifact: "a DIFFERENT artifact" as NonEmptyStr,
        further_artifacts: base.further_artifacts, at: base.at,
      }, readback: merged_readback(14189), standing: ready_standing())
    let e4 = match conflicting {
      CloseRefused { reason: r } => match r { CloseAlreadyClosed { node: _ } => claim("other content cannot duplicate or reopen a closed node", true) _ => claim("the differing close refused with the wrong kind", false) }
      _ => claim("a closed node was written to twice", false)
    }
    let e5 = claim("the log holds exactly one acceptance through all of it", close_row_count(instance) == 1)
    e1 && e2 && e4 && e5
  })
}

// ── THE STALE HEAD REFUSES WITHOUT A SILENT GAP ──────────────────────────────────────────────────

// THE ONE HOME IS READ BEFORE IT IS WRITTEN. A log the route cannot read is a log it must not
// write onto blind: the refusal names the unreadable read, and nothing lands.
test fn an_unreadable_event_log_refuses_the_close_rather_than_appending_blind() -> Bool {
  wet(fn_with: fn(instance) {
    let written = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-log-ok"), readback: merged_readback(14189), standing: ready_standing())
    let e1 = match written { CloseWritten { event_id: _ } => claim("a readable log takes the close", true) _ => claim("the readable close refused", false) }
    let blind = roadmap_operator_close(
      instance: refused_carrier_instance(),
      inputs: close_inputs("node-log-blind"), readback: merged_readback(14189), standing: ready_standing())
    let e2 = match blind {
      CloseRefused { reason: r } => match r {
        CloseHistoryUnreadable { reason: _ } => claim("the unreadable log refuses the close by name", true)
        CloseInvalidHistory { detail: _ } => claim("the unreadable log refuses the close as an invalid history", true)
        _ => claim("the unreadable-log close refused with the wrong kind: " + (r as String), false)
      }
      _ => claim("a close was written onto a log nobody could read", false)
    }
    let e3 = claim("the readable log still holds exactly its one acceptance", close_row_count(instance) == 1)
    e1 && e2 && e3
  })
}

// ── ONE REPLAY LAW FOR BOTH CARRIERS (manager condition one) ─────────────────────────────────────

// ONE replay law for the ONE home (manager condition one). Two acceptances of the same node are
// refused WHOLE and LOCATED — never a silent double-count, never a silent drop. They are put there
// through the route's own writer (issue_command_apply, the only writer) so the load's law does not
// depend on the close gate that would ordinarily stop the second one.
test fn a_duplicate_acceptance_of_one_node_refuses_the_whole_load_located() -> Bool {
  wet(fn_with: fn(instance) {
    let layout = close_layout(instance)
    let node = "node-duplicate" as NonEmptyStr as RoadmapNodeId
    let receipt = sample_receipt("node-duplicate")
    let facts = fact_set()
    let first = issue_command_apply(layout: layout,
      command: AcceptNode {
        subject: IssueCommandSubject { node: node, author: opr_principal(),
          operation: "op-duplicate-one" as NonEmptyStr, expected: none },
        receipt: receipt, pr_url: facts.url, merged_at: facts.merged_at, head_sha: facts.head },
      recorded_at: 1793692800)
    let e1 = match first { EventAppended { id: _ } => claim("the first acceptance appended", true)
      _ => claim("the first acceptance was refused", false) }
    let second = issue_command_apply(layout: layout,
      command: AcceptNode {
        subject: IssueCommandSubject { node: node, author: opr_principal(),
          operation: "op-duplicate-two" as NonEmptyStr, expected: none },
        receipt: receipt, pr_url: facts.url, merged_at: facts.merged_at, head_sha: facts.head },
      recorded_at: 1793692801)
    let e2 = match second { EventAppended { id: _ } => claim("the duplicate reached the log, so the LOAD is the one that must refuse it", true)
      EventAppendRefused { step: _, reason: _ } => claim("the writer itself refused the duplicate at the chain", true) }
    match roadmap_operator_close_history(layout: layout) {
      RoadmapAcceptanceEventHistoryLoadRefused { detail: d } => e1 && e2 && claim("the replay refuses the duplicate, located: " + d, count(d) > 0)
      RoadmapAcceptanceEventHistoryLoaded { events: evs } => e1 && e2 && claim("the log never holds two acceptances of one node",
        count(filter(evs, e => match e {
          AcceptanceRecorded { receipt: r } => (r.node as String) == "node-duplicate"
          AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => false
        })) <= 1)
    }
  })
}

// THE READ IS THE SAME ONE PRODUCTION USES, AND IT NEVER ANSWERS A SILENT EMPTY: an untouched
// carrier loads with nothing in it, and a carrier that cannot be read REFUSES.
test fn the_history_read_never_answers_a_silent_empty() -> Bool {
  wet(fn_with: fn(instance) {
    let clean = roadmap_operator_close_history(layout: close_layout(instance))
    let e1 = match clean {
      RoadmapAcceptanceEventHistoryLoaded { events: evs } => claim("an untouched carrier reads no acceptances and refuses nothing", count(evs) == 0)
      RoadmapAcceptanceEventHistoryLoadRefused { detail: d } => claim("an untouched carrier refused: " + d, false)
    }
    let e2 = claim("an absent node reads open, not closed",
      roadmap_operator_node_closed(node: "node-never-closed" as NonEmptyStr as RoadmapNodeId, history: clean) == AcceptanceAbsent)
    let refused = roadmap_operator_close_history(layout: close_layout(refused_carrier_instance()))
    let e3 = match refused {
      RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => claim("an unreadable carrier refuses the load — never an empty history", true)
      RoadmapAcceptanceEventHistoryLoaded { events: evs } => claim("an unreadable carrier answered an empty history", false)
    }
    e1 && e2 && e3
  })
}

// ── THE ONE TERMINALITY RULE, AT THE BELT READ AND AT THE OBLIGATION QUESTION ────────────────────

test fn a_closed_nodes_lineage_is_terminal_to_the_belt_and_unreadable_fails_closed() -> Bool {
  wet(fn_with: fn(instance) {
    let instance = fabric_fixture_instance(root: "unused-for-this-read" as String)
    let a = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-terminal"), readback: merged_readback(14189), standing: ready_standing())
    let e1 = match a { CloseWritten { event_id: _ } => claim("the close landed", true) _ => claim("the close refused", false) }
    match belt_node_lineage_terminal_read(instance: instance, node_id: "node-terminal", history: roadmap_operator_close_history(layout: close_layout(instance))) {
      LineageTerminal { why: _ } => {
        let e2 = claim("the closed node's lineage reads terminal", true)
        let unreadable = belt_node_lineage_terminal_read(instance: instance, node_id: "node-terminal", history: roadmap_operator_close_history(layout: close_layout(refused_carrier_instance())))
        let e3 = match unreadable {
          LineageTerminalUnreadable { reason: _ } => claim("an unreadable history fails closed — it never guesses open", true)
          _ => claim("the unreadable history answered something else", false)
        }
        e1 && e2 && e3
      }
      _ => claim("a closed node read non-terminal to the belt", false)
    }
  })
}

test fn a_terminal_lineage_owes_nothing_and_an_open_one_owes_the_unsettled_review() -> Bool {
  let segments = [
    WorkflowSegment { kind: SubmissionWorkflowSegment, state: WorkflowSegmentComplete, detail: "committed" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "verified" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentPending, detail: "no review yet" },
  ]
  // Pure lane: outstanding is a function of provider state and segments ONLY. The terminality rule
  // has no door here (review 90921): the one read is belt_node_lineage_terminal_read, consulted by
  // the actuate seam before these functions run, and it fails closed on unreadable.
  let open = belt_attempt_outstanding(provider: ProviderCompleted { activity: "done" }, segments: segments)
  claim("an unsettled review segment owes review while the lineage is open", count(open) > 0)
}

// The retired half of the one rule, exercised through the real write law (issue_command_apply, the
// route's own writer) so the read and the write share no fixture: a retired node's lineage reads
// terminal to the belt, and the read is the ONLY place terminality is decided for the obligation lane.
test fn a_retired_nodes_lineage_is_terminal_to_the_belt() -> Bool {
  let directory = shell.Mktemp.Dir()
  if !directory.success { claim("the temp dir for the retired-belt row could not be made", false) }
  else {
    let instance = fabric_fixture_instance(root: directory.path as String)
    let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
    match issue_command_apply(layout: layout,
      command: RetireNode { subject: IssueCommandSubject {
        node: "node-retired-belt" as NonEmptyStr as RoadmapNodeId,
        author: opr_principal(),
        operation: "op-retired-belt" as NonEmptyStr,
        expected: none },
        reason: "ended by the operator" as NonEmptyStr },
      recorded_at: "2026-11-04T08:00:00Z") {
      CarrierClosed { result: EventAppended { id: _ }, close: _ } =>
        match belt_node_lineage_terminal_read(instance: instance, node_id: "node-retired-belt", history: roadmap_operator_close_history(layout: close_layout(refused_carrier_instance()))) {
          // The retired half now reads the TYPED LineageRetired{by,reason}, not a flattened LineageTerminal
          // prose tag. Reaching this variant (rather than LineageTerminal/LineageOpen) is itself the
          // discriminating control; the reason carries the operator's own retirement text.
          LineageRetired { by: _, reason } => claim("the retired node reads LineageRetired and names the retirement", string_contains(s: reason, pattern: "ended"))
          LineageTerminal { why: _ } => claim("the retired node read closed-terminal LineageTerminal instead of the typed LineageRetired — wrong terminality kind", false)
          LineageOpen => claim("a retired node read open to the belt", false)
          LineageTerminalUnreadable { reason: r } => claim("the retired lane read unreadable: " + (r as String), false)
        }
      _ => claim("the retire write law refused the seed event for the belt row", false)
    }
  }
}

// GAP B — THE LAUNCH GATE, WITNESSED. Both operator verbs (CONTINUE, START FRESH) reach a launch only
// through belt_node_launch_refusal (belt_dispatch_node_for_instance_over), so the retired-node refusal
// must be witnessed AT THAT SEAM, not only at the read. A RETIRED lineage is refused with the TYPED
// LaunchNodeRetired{by,reason} carrying the operator's own reason — never a flattened prose tag
// (DESIGN §4c/§5, review 91811). The DISCRIMINATING control is an OPEN node in the SAME instance whose
// lineage the gate leaves alone (Absent), so the refusal is proven a retirement rule and not a blanket
// launch veto that would pass even when nothing is retired.
test fn the_launch_gate_refuses_a_retired_node_and_leaves_an_open_node_alone() -> Bool {
  let directory = shell.Mktemp.Dir()
  if !directory.success { claim("the temp dir for the launch-gate row could not be made", false) }
  else {
    let instance = fabric_fixture_instance(root: directory.path as String)
    let layout = roadmap_event_carrier_layout_for_instance(instance: instance)
    let gate_history = roadmap_operator_close_history(layout: close_layout(refused_carrier_instance()))
    match issue_command_apply(layout: layout,
      command: RetireNode { subject: IssueCommandSubject {
        node: "node-launch-gate-retired" as NonEmptyStr as RoadmapNodeId,
        author: opr_principal(),
        operation: "op-launch-gate" as NonEmptyStr,
        expected: none },
        reason: "ended at the launch gate" as NonEmptyStr },
      recorded_at: "2026-11-04T08:00:00Z") {
      CarrierClosed { result: EventAppended { id: _ }, close: _ } => {
        let refused = match belt_node_launch_refusal(instance: instance, node_id: "node-launch-gate-retired", history: gate_history) {
          Present { value: LaunchNodeRetired { by: _, reason } } =>
            claim("a retired node's launch is refused with the typed LaunchNodeRetired naming the retirement", string_contains(s: reason, pattern: "ended at the launch gate"))
          Present { value: _ } => claim("a retired node was refused with a refusal other than the typed LaunchNodeRetired", false)
          Absent => claim("a retired node's launch was admitted instead of refused", false)
        }
        let open_free = match belt_node_launch_refusal(instance: instance, node_id: "node-launch-gate-open", history: gate_history) {
          Absent => claim("the gate leaves an open, non-retired node's launch alone (a retirement rule, not a veto)", true)
          Present { value: _ } => claim("the gate refused an open, non-retired node's launch", false)
        }
        refused && open_free
      }
      _ => claim("the retire write law refused the seed event for the launch-gate row", false)
    }
  }
}

// ── THE RETIREMENT FOLD: ANY STANDING, HONEST, FINAL ─────────────────────────────────────────────

fn opr_principal() -> EventPrincipalAuthenticated {
  EventPrincipalAuthenticated { ref: PrincipalRef {
    authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: "sub-opr" as NonEmptyStr,
  } }
}

test fn a_retirement_ends_any_standing_and_nothing_moves_it_afterwards() -> Bool {
  let n = "node-retired" as NonEmptyStr as RoadmapNodeId
  let p = opr_principal()
  // The unsettled-review world: claimed, then handed back with review demanded.
  let e_claimed = roadmap_event_envelope(e: RoadmapEvent { node: n, author: p, parent: none, kind: Claimed { assignee: p, return_to: p }, recorded_at: "2026-11-04T08:00:00Z" })
  let e_back = roadmap_event_envelope(e: RoadmapEvent {
    node: n, author: p, parent: Present { value: e_claimed.id }, kind: HandedBack { reason: "review requested" as NonEmptyStr }, recorded_at: "2026-11-04T08:30:00Z" })
  let before = roadmap_issue_state(envs: [e_claimed, e_back]).standing
  let e1 = match before { NodeRetired { by: _, reason: _ } => claim("a non-retired world read retired", false) _ => claim("the pre-retirement standing was open to retirement", true) }
  let e_retire = roadmap_event_envelope(e: RoadmapEvent {
    node: n, author: p, parent: Present { value: e_back.id }, kind: Retired { reason: "operator ended the work" as NonEmptyStr }, recorded_at: "2026-11-04T09:00:00Z" })
  let after = roadmap_issue_state(envs: [e_claimed, e_back, e_retire]).standing
  let e2 = match after {
    NodeRetired { by: _, reason: _ } => claim("the retirement ends the unsettled lineage honestly, by the principal", true)
    _ => claim("the retirement did not end the standing", false)
  }
  // Terminal: events recorded afterwards — in causal order or out of it — never move it.
  let e_late = roadmap_event_envelope(e: RoadmapEvent {
    node: n, author: p, parent: Present { value: e_retire.id }, kind: Claimed { assignee: p, return_to: p }, recorded_at: "2026-11-04T09:30:00Z" })
  let later = roadmap_issue_state(envs: [e_claimed, e_back, e_retire, e_late]).standing
  let e3 = match later {
    NodeRetired { by: _, reason: _ } => claim("a retired node stays retired — no event moves it back", true)
    _ => claim("a later event moved a retired standing", false)
  }
  // Retired is not accepted: the retirement alone leaves the node NOT closed.
  let e4 = wet(fn_with: fn(instance) { claim("a retired node never counts as accepted",
    roadmap_operator_node_closed(node: n,
      history: roadmap_operator_close_history(layout: close_layout(instance))) == AcceptanceAbsent) })
  e1 && e2 && e3 && e4
}

// ── THE ROUTES: WHO MAY ASK, AND WHAT THEY HEAR BACK ─────────────────────────────────────────────

test fn the_close_route_refuses_anonymously_and_without_the_token() -> Bool {
  let anon = serve_issue_close_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request(body: close_body_ready, node_id: "operator-node"), params: node_param("operator-node"), read: fn(_repo, n) { merged_readback(n) })
  let e1 = claim("the anonymous close is refused: " + anon.body,
    anon.status == 403 && string_contains(s: anon.body, pattern: "google-oidc-session"))
  let csrf_less = serve_issue_close_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: close_body_no_csrf, node_id: "operator-node"), params: node_param("operator-node"), read: fn(_repo, n) { merged_readback(n) })
  let e2 = claim("the tokenless close is refused: " + csrf_less.body,
    csrf_less.status == 403 && string_contains(s: csrf_less.body, pattern: "CSRF token"))
  e1 && e2
}

test fn the_close_route_names_an_unknown_node_and_refuses_an_unreadable_lane() -> Bool {
  let unknown = serve_issue_close_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: close_body_ready, node_id: "not-a-node"), params: node_param("not-a-node"), read: fn(_repo, n) { merged_readback(n) })
  let e1 = claim("the unknown node is named: " + unknown.body, unknown.status == 404)
  // The lane question fails CLOSED at the serve edge too: a node lane that cannot be read (here,
  // an instance whose carrier root does not exist — the snapshot list itself fails) is refused
  // 503 with the located reason, never treated as empty-and-open and never appended blind (the
  // manager's condition three, one layer up from an_unreadable_github_refuses_the_close_fail_closed).
  let lane_unreadable = serve_issue_close_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: close_body_ready, node_id: "operator-node"), params: node_param("operator-node"), read: fn(_repo, _n) { PrReadbackUnavailable { cause: "witness: github unavailable" as NonEmptyStr } })
  let e2 = claim("an unreadable lane refuses fail-closed, not blind: " + lane_unreadable.body,
    lane_unreadable.status == 503 && string_contains(s: lane_unreadable.body, pattern: "lane unavailable"))
  e1 && e2
}

test fn the_retire_route_refuses_anonymously_by_token_by_name_and_by_form() -> Bool {
  let retire_body = "key=op-serve-retire-1&csrf=csrf-opr&expected_revision=rev-1&reason=ended"
  let anon = serve_issue_retire_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request(body: retire_body, node_id: "operator-node"), params: node_param("operator-node"))
  let e1 = claim("the anonymous retire is refused: " + anon.body,
    anon.status == 403 && string_contains(s: anon.body, pattern: "google-oidc-session"))
  let csrf_less = serve_issue_retire_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: "key=op-serve-retire-1&expected_revision=rev-1", node_id: "operator-node"), params: node_param("operator-node"))
  let e2 = claim("the tokenless retire is refused: " + csrf_less.body,
    csrf_less.status == 403 && string_contains(s: csrf_less.body, pattern: "CSRF token"))
  let unknown = serve_issue_retire_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: retire_body, node_id: "not-a-node"), params: node_param("not-a-node"))
  let e3 = claim("the unknown node is named: " + unknown.body, unknown.status == 404)
  let malformed = serve_issue_retire_response_over(
    instance: srv2_preview_dashboard_instance(), plan: fn() { plan_with_nodes(["operator-node"]) },
    request: close_request_as_operator(body: "key=op-serve-retire-1&csrf=csrf-opr&reason=ended", node_id: "operator-node"), params: node_param("operator-node"))
  let e4 = claim("a retire without its expected revision is refused the form: " + malformed.body,
    malformed.status == 400 && string_contains(s: malformed.body, pattern: "expected_revision"))
  e1 && e2 && e3 && e4
}

// T19 (operator ruling via manager msg_e839d789): a child held by a RETIRED parent must SEE the
// retired blocker — the visible reason says "blocked by retired <id>", derived from the blocker's
// own standing, never a name, claim, or position. An open parent keeps the ordinary voice.
fn w_blocked_by_retired() -> Bool {
  let parent_n = operator_node("node-retired-parent")
  let child_n = operator_node("node-blocked-child")
  let nodes = [parent_n, child_n]
  let edges = [RoadmapEdge { child: "node-blocked-child" as NonEmptyStr as RoadmapNodeId, parent: "node-retired-parent" as NonEmptyStr as RoadmapNodeId }]
  let launch_ctx = LaunchRowContext {
    standing: launch_fixture_standing_clear(mode: ManualReady),
    graph: launch_graph_of_document(doc: launch_fixture_doc(nodes: nodes, edges: edges)),
    merged: [] as List<Int>,
  }
  let retired_standing = NodeRetired { by: "op" as NonEmptyStr, reason: "debt exclusion frontier closed by operator" as NonEmptyStr }
  let row = work_row_view(
    rn: child_n, nodes: nodes, edges: edges, merged: [] as List<Int>, activity: NoActiveWork,
    rounds: RoundsUnobserved { reason: "witness: no active attempt" as NonEmptyStr },
    launch: launch_ctx, worker_alive: false, standing: none, attempt_stale: false, profiles: [],
    standings: StandingsObserved { rows: [NodeStandingRow { node_id: "node-retired-parent", standing: retired_standing, assignment: roadmap_assignment_empty() }] },
  )
  let held_text = match row.scheduling {
    SchedulingNotReady { missing } => readiness_text_with_retired(r: NotReady { missing: missing }, retired: row.retired_blockers)
    _ => "ready"
  }
  let held_reason = match row.scheduling {
    SchedulingNotReady { missing } => readiness_reason_text_with_retired(r: NotReady { missing: missing }, retired: row.retired_blockers)
    _ => "ready"
  }
  // The SAME child with standings unobserved (a projection that cannot see the parent's standing)
  // keeps the ordinary voice — it never invents retired-ness.
  let plain_row = work_row_view(
    rn: child_n, nodes: nodes, edges: edges, merged: [] as List<Int>, activity: NoActiveWork,
    rounds: RoundsUnobserved { reason: "witness: no active attempt" as NonEmptyStr },
    launch: launch_ctx, worker_alive: false, standing: none, attempt_stale: false, profiles: [],
  )
  claim("a child held forever by a retired parent says so; an open parent reads plainly",
    row.retired_blockers == ["node-retired-parent"]
    && string_contains(s: held_text, pattern: "blocked by retired node-retired-parent")
    && string_contains(s: held_reason, pattern: "blocked by retired node-retired-parent")
    && plain_row.retired_blockers == ([] as List<String>)
    && !string_contains(s: readiness_text(r: NotReady { missing: [GapDependencies { blockers: ["node-retired-parent"] }] } as NodeReadiness), pattern: "retired"))
}

// ── THE BINDING (review 90905): A MERGED PR CLOSES ONLY THE NODE IT BELONGS TO ──────────────────

test fn a_merged_pr_that_is_not_the_nodes_review_pr_is_refused() -> Bool {
  wet(fn_with: fn(instance) {
    let answer = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-wrong-pr"), readback: merged_readback(14189),
      standing: Present { value: ready_standing_other_pr() })
    match answer {
      CloseRefused { reason: r } => match r {
        ClosePrNotForNode { pr_number: p, expected: e } =>
          claim("the refusal names the claimed pull", p == 14189)
            && claim("the refusal names the standing's pull", (e as String) == "briansrls/gunbc#999")
            && claim("nothing was written for the unbound close", close_row_count(instance) == 0)
        _ => claim("the wrong-PR refusal came as something else", false)
      }
      _ => claim("a merged PR from another node closed this one", false)
    }
  })
}

test fn a_node_that_never_published_a_review_pr_is_refused_the_close() -> Bool {
  wet(fn_with: fn(instance) {
    let answer = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-never-ready"), readback: merged_readback(14189),
      standing: Present { value: NodeOpen })
    match answer {
      CloseRefused { reason: r } => match r {
        ClosePrNotForNode { pr_number: _, expected: e } =>
          claim("the refusal says there is no review standing", string_contains(s: e as String, pattern: "no review standing"))
            && claim("nothing was written on the standingless close", close_row_count(instance) == 0)
        _ => claim("the no-standing close came as something else", false)
      }
      _ => claim("a node without a review PR closed on a bare claim", false)
    }
  })
}

test fn an_unknown_node_is_refused_before_anything_is_written() -> Bool {
  wet(fn_with: fn(instance) {
    let answer = roadmap_operator_close(
      instance: instance,
      inputs: close_inputs("node-unknown"), readback: merged_readback(14189),
      standing: none)
    match answer {
      CloseRefused { reason: r } => match r {
        CloseUnknownNode { node: n } => claim("the refusal names the unknown node", (n as String) == "node-unknown")
          && claim("nothing was written for the unknown node", close_row_count(instance) == 0)
        _ => claim("the unknown-node close came as something else", false)
      }
      _ => claim("an unknown node closed", false)
    }
  })
}

// ──────────────────────────────────────────────────────────────────────────────────────────────
// THE OPERATION IDENTITY IS THE FACT, NOT THE NODE (review of gunb-ai/gunbc#16189, finding 2).
// The carrier keeps an operation create-once, so an identity naming only the node would let a node be
// accepted ONCE IN ITS LIFE: the acceptance and the revocation that later takes it back would collide
// at operations/<node>/<operation>.json, and the migration could never replay the history of
// entry-graph-union-construction — its acceptance, its revocation, its retirement. Three controls:
// the SAME command retries as the SAME operation (a retry replays rather than writing twice); an
// acceptance and the revocation of that same receipt are TWO operations; and the same receipt under a
// different node is a different operation, so an identity is never accidentally shared.
// ──────────────────────────────────────────────────────────────────────────────────────────────
test fn an_acceptance_and_its_revocation_are_two_operations_and_a_retry_is_one() -> Bool {
  let receipt = sample_receipt("node-operation")
  let accept = BuildAcceptCommand {
    receipt: receipt, pr_url: "https://github.com/briansrls/gunbc/pull/14189",
    merged_at: "2026-11-03T04:15:00Z", head_sha: "0123456789abcdef0123456789abcdef01234567",
  }
  let revoke = BuildRevokeCommand {
    facts: RoadmapAcceptanceRevocationFacts {
      receipt: receipt, disposition: AcceptanceNodeReopensActiveFrontier,
      reason: "the receipt did not survive its own witness" as NonEmptyStr,
      revoked_by: "briansrls" as NonEmptyStr, revoked_on: "2026-11-04" as NonEmptyStr,
    },
  }
  let retry = BuildAcceptCommand {
    receipt: receipt, pr_url: "https://github.com/briansrls/gunbc/pull/14189",
    merged_at: "2026-11-03T04:15:00Z", head_sha: "0123456789abcdef0123456789abcdef01234567",
  }
  let accept_id = roadmap_acceptance_operation_identity(node: "node-operation", choice: accept)
  let retry_id = roadmap_acceptance_operation_identity(node: "node-operation", choice: retry)
  let revoke_id = roadmap_acceptance_operation_identity(node: "node-operation", choice: revoke)
  let other_node_id = roadmap_acceptance_operation_identity(node: "node-operation-two", choice: accept)
  claim("the same command is the same operation, so a retry replays", accept_id == retry_id)
    && claim("an acceptance and the revocation of that receipt are distinct operations", accept_id != revoke_id)
    && claim("a receipt is never shared across nodes by an identity", accept_id != other_node_id)
    && claim("the identity names the node it acts on", string_contains(s: accept_id, pattern: "node-operation"))
}
