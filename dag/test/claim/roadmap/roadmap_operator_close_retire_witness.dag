    number: number,
    state: Present { value: PullRequestViewMerged },
    merged_at: ("2026-11-03T04:15:00Z" as NonEmptyStr),
    head_sha: ("0123456789abcdef0123456789abcdef01234567" as NonEmptyStr),
  } ] }
}

// The fixture node's review standing: the fabric's own record that the merged PR under test
