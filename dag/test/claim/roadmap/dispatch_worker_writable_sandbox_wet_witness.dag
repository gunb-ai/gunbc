data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wet_probe_node: RoadmapNodeId = "writable-probe" as RoadmapNodeId
data wet_probe_key: String = "wetprobe"

// WET: a real systemd-run --user transient with the worker unit's production properties, then one
// argv `touch -- <path>` per subject. Asserts the kernel REFUSES a forbidden write: the touch must
// have RUN and failed with the path absent afterwards (sandbox_touch_reading_of), in a unit shape
// whose allowed touch also runs (worker_shape_runs_an_allowed_touch). Two srv1 readings of this
// shape, both un-refused: (1) before the empty bounding set, kernel.apparmor_restrict_unprivileged_userns=1
// meant the user manager could not build the mount namespace and dropped ProtectSystem/ProtectHome/
// ReadWritePaths without error, so the write succeeded (bright-moth-475, issuecomment-6175000334);
// (2) with EmptyCapabilityBoundingSet in the properties (2026-10-21, systemd 255) the user manager
// fails exec setup, status 218 EXIT_CAPABILITIES, so the command NEVER RUNS: fail closed, and no
// evidence about the mount sandbox. That reading was once scored as a refused write; it is now
// SandboxTouchNeverRan and this claim is RED on it. Production does not launch workers this way:
// belt_actuate starts them as system-manager transients through attempt_system_unit_launch. This is
// the discriminating RED for gunbc.rung_drop.user_manager_worker_write_boundary_unenforced; do not
// invert this claim to expect success, and do not read its RED as "the write succeeded". Local
// recipe: claim_batch --wet --source-root dag
// --source-root src/v2 --entry dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag
// Requires a user systemd manager (srv1).

// ── EVERY CLAIM RUNS AGAINST A LAB ROW IT BUILT ITSELF (the #15627 supplied-root fixture) ──
//
// WHY NOT THE LIVE ROW. `srv1_lab_dashboard_instance()` is the deployment's own row: its
// provision parent, instance root, repo root, origin and serve binary ARE the lab's real
// install paths. A claim that binds it performs its effects on the host that serves the
// roadmap, and then its refusal readbacks prove nothing: the write the sandbox was supposed
// to refuse is a write the claim itself just made, in the one place it should never have
// touched. That is the RFM row `a_confinement_witness_whose_only_writable_root_is_the_live_host`,
// and this file was the open instance of it below the row's ceiling: ten bindings to the live
// row, two of them in claims that create directories.
//
// THE GUARD IS THE FIXTURE'S, NOT A RESTATEMENT OF IT. Both root arms run against the row's
// OWN writable list, and the row is compared against the live roots by name through
// `witness_supplied_roots_are_off_the_live_host`. The off-the-live-host arm is not optional
// dressing: a first guard that only re-checked the claim's own scratch leaf left two execution
// claims GREEN while nine installs wrote /opt/gunbc-lab, which is what commit 8cf8a03a7c5
// closed. An arm that merely restates `!witness_supplied_root_is_refused` over the writable
// list is worthless the same way (review 89877 finding 2) -- it is true of a live-root row too,
// because the live roots are IN the writable list. Only the fixture's arms name the live roots.
//
// THE PRINCIPAL IS HOST-SAID, NEVER MINTED. `useradd`, `groupadd` and `systemd-run` are all
// absent in this container (the host answers `uid=1000(node) gid=1000(node)`), so a fixture
// that created accounts would be RED on every host that cannot create them and GREEN only
// where someone pre-provisioned -- the reachability trap the RFM row files, re-opened. Host-said
// is also what gives the confinement readbacks their oracle: uid, gid, octal mode and the
// names `find -printf '%u %g'` prints are all compared against the host's own answer.
fn wet(command: ArgvCommand) -> ProcessOutcome {
  run_shell_command_capture(command: command, transport: LocalExec)
}

fn wet_ok(command: ArgvCommand) -> Bool {
  match wet(command: command) {
    ProcessRefused { exit_code: _, stderr: _ } => false
    ProcessOutputPresent { text: _ } => true
    ProcessOutputAbsent => true
  }
}

fn wet_out(command: ArgvCommand) -> String {
  match wet(command: command) {
    ProcessOutputPresent { text: text } => trim(s: text)
    ProcessOutputAbsent => ""
    ProcessRefused { exit_code: _, stderr: _ } => ""
  }
}

// THE ROOT THIS CLAIM OWNS: the host's own `mktemp -d`, under the fixture's prefix, with a
// per-claim tag so two claims in one batch can never share a tree. An empty answer is the
// refusal -- never a fallback to a fixed path, which is how a witness ends up writing the
// same directory on every host and calling the agreement evidence.
fn wet_claim_root(tag: NonEmptyStr) -> String {
  wet_out(
    command: mktemp_directory_command(
      template: join([witness_scratch_prefix as String, "/gunbc-sandbox-", tag, "-XXXXXX"], "") as NonEmptyStr,
    ),
  )
}

// THE HOST-SAID PRINCIPAL. Empty text or an unparseable uid/gid yields the fixture's unnameable
// sentinel (uid/gid -1), and every claim that takes a row refuses on it rather than proceeding:
// an unknown principal is exactly the state in which a confinement claim can be GREEN for no
// reason. No uid is ever minted, and uid 0 is refused by the fixture itself.
fn wet_principal() -> WitnessSuppliedPrincipal {
  match witness_principal_from_texts(
    uid_text: wet_out(command: witness_uid_command()),
    gid_text: wet_out(command: witness_gid_command()),
    user_text: wet_out(command: witness_effective_user_command()),
    group_text: wet_out(command: witness_group_name_command()),
  ) {
    Present { value: principal } => principal
    Absent => witness_unnameable_principal()
  }
}

// THE ROW, GUARDED BEFORE ANY CLAIM SEES IT. The off-the-live-host arm runs against the row the
// fixture would actually hand back, so a row that resolves into the lab is refused rather than
// returned for a claim to walk into.
fn wet_supplied_lab_instance(scratch_parent: String) -> HostDashboardInstance {
  let repo = join([scratch_parent, "/source"], "")
  let principal = wet_principal()
  if scratch_parent == "" || principal.uid < 0 || principal.gid < 0 {
    witness_refused_instance(repo: repo as FilePath)
  } else {
    let candidate = witness_supplied_instance(
      scratch_parent: scratch_parent as FilePath,
      repo: repo as FilePath,
      principal: principal,
    )
    if witness_supplied_root_is_refused(candidate: scratch_parent)
      || witness_supplied_root_is_refused(candidate: repo)
      || !witness_supplied_roots_are_off_the_live_host(instance: candidate) {
      witness_refused_instance(repo: repo as FilePath)
    } else {
      candidate
    }
  }
}

// THE CONFINEMENT READBACK, ASSERTED INSIDE THE CLAIM AND NOT ONLY GUARDED IN THE BUILDER.
//
// Guarding is not enough to make this file falsifiable. Most claims here are root-independent in
// their LOGIC -- a refusal is a refusal whichever directory the path names -- so a mutant that
// binds `srv1_lab_dashboard_instance()` again and bypasses the guarded builder would stay GREEN
// on the guard alone. This conjunct is what makes that revert RED: every field the claim can
// write through is re-derived from the row it was actually handed and must sit under the root
// the claim itself created. It is also what makes a deleted derivation RED: replace an accessor
// over `inst` with a literal path and the containment check no longer describes the row.
fn wet_claim_is_confined(instance: HostDashboardInstance, root: String) -> Bool {
  root != ""
    && witness_supplied_roots_are_off_the_live_host(instance: instance)
    && is_under(text: instance.provision_parent_root as String, root: root)
    && is_under(text: instance.instance_root as String, root: root)
    && is_under(text: instance.local_origin_root as String, root: root)
    && is_under(text: instance.repo_root as String, root: root)
    && is_under(text: instance.serve_binary as String, root: root)
}

// THE GUEST'S READ INPUTS, PLANTED INSIDE THE CLAIM'S ROOT.
//
// The launcher legs exec `serve_binary run --source-root <repo>/dag --source-root <repo>/src/v2
// --entry <repo>/dag/...` -- every one of those paths is derived from the supplied row, so under
// a supplied root none of them exist yet and the leg would go RED for a reason that has nothing
// to do with confinement (the guest cannot find its entry). Nothing on main establishes whether
// a worker unit may read an operator checkout -- ProtectHome enforcement is an unobserved
// per-host obligation (`gunbc.host.host_software_surface`
// user_manager_protect_home_enforcement_read_obligation) -- so reading the checkout in place
// would make the leg depend on an unread host fact. The tree is copied in instead, from sources
// the HOST reports: `pwd` for the checkout that holds this witness and `command -v` for one
// executable to serve as the instance binary. Both are asserted present, so a host that cannot
// supply them is RED rather than vacuously GREEN; nothing here is minted. Only the copies are
// written -- the checkout and the binary are read, never touched, which is what keeps this
// inside the rule the whole file exists for.
//
// The copy is the WHOLE `dag/` and `src/v2/` tree, not the entry's import closure: the closure is
// not derivable from inside a claim (no claim-side module resolver is exposed), and a partial
// plant that missed one transitive import would fail as a confusing guest-side error. Recorded
// in the PR body for the same reason.
fn wet_plant_guest_sources(instance: HostDashboardInstance) -> Bool {
  let checkout = wet_out(command: pwd_command())
  let repo = instance.repo_root as String
  // THE CHECKOUT IS HOST-SAID, NOT ASSUMED. `pwd` is the batch's own working directory as the
  // host reports it; an empty reading refuses the plant rather than copying a guessed path.
  checkout != ""
    // `repo` itself has to exist before `cp` can put a tree in it -- the first attempt missed
    // this and the copy refused on a missing parent, which is the difference between a plant and
    // an intention.
    && wet_ok(command: mkdir_parents_command(path: repo))
    && wet_ok(command: cp_recursive_command(source: join([checkout, "/dag"], ""), destination: join([repo, "/dag"], "")))
    && wet_ok(command: mkdir_parents_command(path: join([repo, "/src"], "")))
    && wet_ok(command: cp_recursive_command(source: join([checkout, "/src/v2"], ""), destination: join([repo, "/src/v2"], "")))
}

// THE SERVED BINARY IS THE ONE THE OPERATOR NAMED, OR THE LEG REFUSES. There is no honest way for
// a claim to name the running image by itself: `/proc/self/exe` resolves against the process that
// OPENS it, so an `install -m 0755 /proc/self/exe <dst>` copies `/usr/bin/install`, not the guest
// -- a planted binary of the wrong identity would make every launcher leg refuse for a reason that
// has nothing to do with confinement. So the path comes from the environment through `printenv`
// (no shell expansion), and BOTH readings are required before anything is written: the name is
// non-empty, and what it names is executable to the host-said principal. Unset or non-executable
// refuses the leg; nothing here mints a binary, and no host is required to have a `gunbc` on PATH.
fn wet_plant_guest_binary(instance: HostDashboardInstance) -> Bool {
  let named = wet_out(command: printenv_value_command(name: wet_served_binary_env_var))
  named != ""
    && wet_path_is_executable(path: named)
    && wet_ok(command: mkdir_parents_command(path: path_parent_directory(path: instance.serve_binary as String)))
    && wet_ok(command: install_file_mode_command(
      source: named,
      destination: instance.serve_binary as String,
      mode: "0755" as NonEmptyStr,
    ))
}

data wet_served_binary_env_var: NonEmptyStr = "GUNBC_WET_SERVE_BINARY"

fn wet_plant_guest_runtime(instance: HostDashboardInstance) -> Bool {
  wet_plant_guest_sources(instance: instance) && wet_plant_guest_binary(instance: instance)
}

// THE TREE A REFUSAL LEG NEEDS BEFORE IT CAN MEAN ANYTHING. A refusal leg whose parent
// directory does not exist is not a confinement result at all: `touch` in a missing directory
// fails with ENOENT for a reason the sandbox had nothing to do with, and the claim goes GREEN
// about nothing -- the exact shape this RFM row exists to catch. So the directories the claims
// here name as confined are created, and the file one of them names is planted, all of them
// under the claim's own root and owned by the host-said principal. The unsandboxed control leg
// inside `sandbox_touch_write_refused` then answers the prior question -- if the principal can
// write there OUTSIDE the sandbox, the refusal INSIDE it is the sandbox's doing and nothing
// else's. Every path here is an accessor over the row, never a restated literal, so deleting
// the derivation takes the claim red instead of leaving it standing on a guess.
fn wet_plant_confined_tree(instance: HostDashboardInstance) -> Bool {
  let principal = wet_principal()
  let repo = instance.repo_root as String
  wet_ok(command: mkdir_parents_command(path: path_parent_directory(path: instance.serve_binary as String)))
    && wet_ok(
      command: install_empty_file_command(
        path: instance.serve_binary as String,
        octal_mode: "0755" as NonEmptyStr,
        uid: principal.uid,
        gid: principal.gid,
      ),
    )
    && wet_ok(command: mkdir_parents_command(path: repo))
    && wet_ok(command: mkdir_parents_command(path: join([repo, "/.git/hooks"], "")))
    && wet_ok(command: mkdir_parents_command(path: join([repo, "/.git/objects"], "")))
}

// THE WAY OUT: the claim's own root is removed, and the removal is ANDed into the claim, so a
// claim that leaves its tree behind is RED rather than tidy.
fn wet_clean_claim_root(root: String) -> Bool {
  root != "" && wet_ok(command: rm_recursive_force_command(path: root))
}

fn prepare_probe_attempt(instance: HostDashboardInstance) -> Bool {
  let preps = attempt_state_prepare_argvs_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: wet_probe_key,
  )
  let wt = probe_attempt_worktree(instance: instance)
  fold(preps, init: true, f: (ok, p) => ok && shell.Exec.RunArgv(program: p.program, arguments: p.args).exit_code == 0)
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", wt]).exit_code == 0
}

fn probe_attempt_dir(instance: HostDashboardInstance) -> String {
  attempt_state_directory_text(instance: instance, node_id: wet_probe_node, attempt_key: wet_probe_key, directory: AttemptDirectoryRoot)
}

fn probe_worker_dir(instance: HostDashboardInstance) -> String {
  path_parent_directory(path: attempt_log_member_text(instance: instance, node_id: wet_probe_node, attempt_key: wet_probe_key, member: AttemptWorkerLog))
}

fn probe_attempt_worktree(instance: HostDashboardInstance) -> String {
  join([dashboard_instance_dispatch_worktree_root(instance: instance) as String, "/", wet_probe_key], "")
}

fn worker_probe_properties(instance: HostDashboardInstance) -> List<SystemdRunProperty> {
  dispatch_worker_unit_properties(
    instance: instance,
    working_directory: instance.repo_root as String,
    attempt_worktree: probe_attempt_worktree(instance: instance),
    worker_log_path: join([probe_worker_dir(instance: instance), "/worker-stdout.log"], ""),
    granted: kibibyte(count: 65536),
    process_bounds: session_process_bounds,
    exit_hook: "true" as NonEmptyStr,
  )
}

fn sandbox_touch(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> SandboxTouch {
  match systemd_run_user_wait_command(
    unit: unit,
    properties: worker_probe_properties(instance: instance),
    setenv_bindings: [],
    command_argv: ["/usr/bin/touch", "--", path],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => SandboxTouchUnrunnable
    SystemdSummaryPrintingWaitReady { wait: wait } =>
      SandboxTouchRan {
        exit_code: shell.Exec.RunArgv(
          program: "systemd-run",
          arguments: systemd_run_command_argument_words(command: wait.command),
        ).exit_code,
      }
  }
}

fn sandbox_touch_read(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> SandboxTouchReading {
  let touch = sandbox_touch(instance: instance, unit: unit, path: path)
  sandbox_touch_reading_of(
    touch: touch,
    path_present: shell.Exec.RunArgv(program: "test", arguments: ["-e", path]).exit_code == 0,
  )
}

// The paired control: the SAME route as the sandboxed touch (a user-manager transient, same principal,
// same supplementary groups), with no sandbox properties, writes a sibling of the target in its
// directory and removes it. Running it from the claim process instead would differ in credentials (an
// ssh session carries groups the long-running user manager lacks), so a target writable only through
// such a group would refuse the sandboxed touch by permission while the control wrote, and the
// refusal would be credited to the sandbox. The pair differs in exactly one variable. quick-bee-65
fn unsandboxed_sibling_write_ok(unit: NonEmptyStr, path: String) -> Bool {
  match systemd_run_user_wait_command(
    unit: unit,
    properties: [],
    setenv_bindings: [],
    command_argv: [
      "/bin/sh", "-c", "touch -- \"$1\" && rm -f -- \"$1\"", "sh",
      join([path, ".unsandboxed-control"], ""),
    ],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => false
    SystemdSummaryPrintingWaitReady { wait: wait } =>
      shell.Exec.RunArgv(
        program: "systemd-run",
        arguments: systemd_run_command_argument_words(command: wait.command),
      ).exit_code == 0
  }
}

fn refusal_reading_after_control(control_wrote: Bool, reading: SandboxTouchReading) -> SandboxTouchReading {
  match reading {
    SandboxTouchRefusedReading => if control_wrote { SandboxTouchRefusedReading } else { SandboxTouchInconclusive }
    SandboxTouchNeverRan => SandboxTouchNeverRan
    SandboxTouchWroteReading => SandboxTouchWroteReading
    SandboxTouchInconclusive => SandboxTouchInconclusive
  }
}

fn sandbox_touch_write_refused(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> Bool {
  match refusal_reading_after_control(
    control_wrote: unsandboxed_sibling_write_ok(
      unit: join([unit as String, "-control"], "") as NonEmptyStr,
      path: path,
    ),
    reading: sandbox_touch_read(instance: instance, unit: unit, path: path),
  ) {
    SandboxTouchRefusedReading => true
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
    SandboxTouchInconclusive => false
  }
}

fn reading_is_inconclusive(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchInconclusive => true
    SandboxTouchRefusedReading => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

fn reading_is_refused(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchRefusedReading => true
    SandboxTouchInconclusive => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

// RED for the control, on supplied values: a refused touch whose control could not write reads
// inconclusive, never refused; the same refusal with a writing control stands.
test fn a_refusal_the_principal_could_not_have_been_denied_otherwise_reads_inconclusive() -> Bool {
  reading_is_inconclusive(reading: refusal_reading_after_control(control_wrote: false, reading: SandboxTouchRefusedReading))
    && reading_is_refused(reading: refusal_reading_after_control(control_wrote: true, reading: SandboxTouchRefusedReading))
}

// Inhabitance of the real control route (needs a user manager, like the sibling cells): ENOENT and
// EACCES directories read false, a writable one true. The EACCES half is unobservable as root, so the
// claim requires a non-root principal and is false on a root runner rather than passing without it.
test fn the_unsandboxed_control_reads_the_principals_write_access() -> Bool {
  shell.Exec.RunArgv(program: "sh", arguments: ["-c", "test \"$(id -u)\" -ne 0"]).exit_code == 0
    && !unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-enoent.service" as NonEmptyStr, path: "/proc/gunbc-no-such-dir/target")
    && !unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-eacces.service" as NonEmptyStr, path: "/usr/gunbc-control-target")
    && unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-ok.service" as NonEmptyStr, path: "/tmp/gunbc-control-inhabitance-target")
}

fn sandbox_touch_wrote(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> Bool {
  match sandbox_touch_read(instance: instance, unit: unit, path: path) {
    SandboxTouchWroteReading => true
    SandboxTouchNeverRan => false
    SandboxTouchRefusedReading => false
    SandboxTouchInconclusive => false
  }
}

// The same-shape positive control for the refused cells: the worker unit shape must RUN a touch that
// is allowed, or no refusal from it counts. It writes a dedicated path in the worker directory that nothing else names (systemd itself opens worker-stdout.log, so that file proves nothing about touch) and cleans up.
fn worker_shape_runs_an_allowed_touch(instance: HostDashboardInstance) -> Bool {
  let control = join([probe_worker_dir(instance: instance), "/.gunbc-worker-control-probe"], "")
  sandbox_touch_wrote(
    instance: instance,
    unit: "gunbc-writable-probe-control.service" as NonEmptyStr,
    path: control,
  ) && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", control]).exit_code == 0
}

test fn writes_to_the_deployed_binary_and_tree_fail_inside_the_worker_sandbox() -> Bool {
  // THE DEPLOYED BINARY AND TREE ARE THE CLAIM'S OWN NOW. The claim's whole subject is a write
  // the sandbox refuses; against the live row that write was one this witness made itself in
  // /opt/gunbc-lab, so a refusal proved the sandbox worked only on the assumption that the
  // directory it refused was not the one being served. The row is supplied, the tree is planted
  // under it, and the five targets below stay accessors over the row.
  let root = wet_claim_root(tag: "deployed-writes" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let attempt = probe_attempt_dir(instance: inst)
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && prepare_probe_attempt(instance: inst)
    && worker_shape_runs_an_allowed_touch(instance: inst)
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-bin.service" as NonEmptyStr,
      path: join([inst.serve_binary as String, ".write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-tree.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.gunbc-worker-write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-binding.service" as NonEmptyStr,
      path: join([attempt, "/request-binding.json"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-attempt-file.service" as NonEmptyStr,
      path: join([attempt, "/forged-owner-record"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-hook.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
    && wet_clean_claim_root(root: root)
}

test fn the_worker_worktree_is_writable_inside_the_same_sandbox() -> Bool {
  // THE WRITABLE SIDE OF THE SAME PAIR. A sandbox that refused everything would satisfy the
  // refusal claims above by accident, so this claim is the reason the refusals mean anything --
  // and it can only say that about a worktree the claim created. Under the live row the granted
  // tree was the deployment's, which is the half of the pair the confinement witness had no
  // business writing to.
  let root = wet_claim_root(tag: "worktree-writable" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wt = probe_attempt_worktree(instance: inst)
  let scratch = probe_worker_dir(instance: inst)
  let probe = join([wt, "/.gunbc-worker-write-probe"], "")
  let log_probe = join([scratch, "/.gunbc-worker-write-probe"], "")
  wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && sandbox_touch_wrote(
      instance: inst,
      unit: "gunbc-writable-probe-wt.service" as NonEmptyStr,
      path: probe,
    )
    && sandbox_touch_wrote(
      instance: inst,
      unit: "gunbc-writable-probe-log.service" as NonEmptyStr,
      path: log_probe,
    )
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe]).exit_code == 0
    && wet_clean_claim_root(root: root)
}

fn sandbox_touch_cli(path: String) -> ProcessExit {
  if Filesystem.Write(path: path, content: "probe\n").success {
    ExitSuccess
  } else {
    exit_failure(reason: "sandbox touch write refused")
  }
}

fn wet_witness_entry(instance: HostDashboardInstance) -> String {
  join([instance.repo_root as String, "/dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag"], "")
}

fn launcher_gunbc_run_inner_argv(instance: HostDashboardInstance, function: String, extra_args: List<String>) -> List<String> {
  concat(
    [
      instance.serve_binary as String,
      "run",
      "--source-root", join([instance.repo_root as String, "/dag"], ""),
      "--source-root", join([instance.repo_root as String, "/src/v2"], ""),
      "--entry", wet_witness_entry(instance: instance),
      "--function", function,
    ],
    extra_args,
  )
}

fn launcher_touch_inner_argv(instance: HostDashboardInstance, path: String) -> List<String> {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => []
    NamedArgumentNameHoldsSeparator { name: _ } => []
    NamedArgumentAdmitted { argument: arg } =>
      launcher_gunbc_run_inner_argv(
        instance: instance,
        function: "sandbox_touch_cli",
        extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
      )
  }
}

fn sudo_n_true_cli() -> ProcessExit {
  let r = shell.Exec.RunArgv(program: "/usr/bin/sudo", arguments: ["-n", "true"])
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "sudo -n true refused")
  }
}

fn sudo_n_touch_cli(path: String) -> ProcessExit {
  let r = shell.Exec.RunArgv(program: "/usr/bin/sudo", arguments: ["-n", "/usr/bin/touch", "--", path])
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "sudo -n touch refused")
  }
}

fn launcher_write_refused(instance: HostDashboardInstance, unit_key: String, path: String) -> Bool {
  let existed_before = wet_path_exists(path: path)
  wet_write_refused(touch: launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path), existed_before: existed_before, path: path)
}

fn launcher_wrote(instance: HostDashboardInstance, unit_key: String, path: String) -> Bool {
  match launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path) {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code == 0 && wet_path_exists(path: path)
  }
}

// The two readbacks the plant claim needs, BOTH through declared effect sites: `Filesystem.Read`
// for the entry's bytes and `stat -c %a` for the served binary's mode. A `cmp`/`test` via
// shell.Exec.RunArgv would be an undeclared dispatch (the run reports it on the expectation
// frontier) and would answer with a spawn refusal rather than a reading.
fn wet_file_text(path: String) -> String {
  let r = Filesystem.Read(path: path)
  match filesystem_exact_read(
    path: path,
    content: r.content,
    success: r.success,
    error: r.error,
    error_kind: r.error_kind,
  ) {
    FilesystemExactPathRead { path: _, content: text } => text
    unreadable => ""
  }
}

fn wet_octal_mode(path: String) -> String {
  wet_out(command: stat_mode_command(path: path))
}

test fn the_planted_guest_inputs_reach_the_paths_the_row_derives() -> Bool {
  // WHY THIS CLAIM EXISTS HERE AND NOT ONLY ON SRV2. Six of the legs below exec the guest binary
  // the row derives (`serve_binary run --source-root <repo>/dag --entry <repo>/dag/...`), and the
  // launch itself needs `systemd-run`, which this container does not have. Without a readback
  // that runs in this lane the plant would never be checked anywhere the wet lane can see, and a
  // plant that copied the wrong tree would surface on srv2 as a guest-side parse error rather
  // than as a witness failure. This is the single-principal half of that path: the guest's READ
  // inputs, at the paths the row derives. The guest is not exec'd here -- a second cold entry
  // parse nested in this process does not fit the container's 24 GiB memory cgroup when one entry
  // parse alone measures 16 GiB -- so the exec itself stays queued for srv2, where the launcher
  // legs go with it.
  let root = wet_claim_root(tag: "plant" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let checkout = wet_out(command: pwd_command())
  // The launcher is handed `wet_witness_entry(instance: inst)` -- an accessor over the row, so
  // if the row's repo_root derivation changes this leg moves with it instead of passing on a
  // restated literal.
  let entry = wet_witness_entry(instance: inst)
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_guest_sources(instance: inst)
    && wet_path_exists(path: entry)
    // BYTES, not just existence: a plant that copied a stale or different `dag/` would leave the
    // path present and the leg vacuous, so the planted entry is compared against the checkout the
    // host reports it was copied from. An EMPTY read is refused too -- both sides unreadable would
    // otherwise compare equal and pass.
    && checkout != ""
    && wet_file_text(path: entry) != ""
    && wet_file_text(path: entry)
         == wet_file_text(path: join([checkout, "/dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag"], ""))
    && wet_path_exists(path: join([inst.repo_root as String, "/dag"], ""))
    && wet_path_exists(path: join([inst.repo_root as String, "/src/v2"], ""))
    && wet_clean_claim_root(root: root)
}


// THE OTHER HALF OF THE PLANT, RUN WHERE THE OPERATOR NAMES THE BINARY. This claim is deliberately
// NOT scheduled in `src/v2/workflow/local_repo_wet_terminal.dag`: its precondition is that the
// operator running the batch has exported `GUNBC_WET_SERVE_BINARY`, and a scheduled row that is
// green only where someone pre-provisioned an input is the exact defect this RFM row files. It is
// executed here (the lane's own binary) and on srv2 (the binary that run builds), and the gap is
// named in the PR body's "Known gaps, NOT covered".
test fn the_planted_serve_binary_is_the_image_the_operator_named() -> Bool {
  let root = wet_claim_root(tag: "plant-bin" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_guest_binary(instance: inst)
    // The mode is read back, not trusted from the `install -m` that wrote it: a served binary that
    // is not executable makes every launcher leg refuse for a reason that is not confinement.
    && wet_octal_mode(path: inst.serve_binary as String) == "755"
    && wet_path_is_executable(path: inst.serve_binary as String)
    && wet_clean_claim_root(root: root)
}

test fn writes_through_the_launcher_to_bin_and_source_hooks_are_refused() -> Bool {
  // THE LAUNCHER IS REFUSED THE SAME TWO PLACES the shape path is. Under the live row the two
  // paths named below were the deployment's own bin directory and the deployment's own source
  // hooks, so "refused" was a statement about where the witness had been writing, not about the
  // launcher's policy. The launcher's guest runs `run --source-root <repo>/dag --entry ...` from
  // the supplied row, so the tree has to be planted for the leg to reach the policy at all.
  let root = wet_claim_root(tag: "launcher-refused" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_write_refused(
      instance: inst,
      unit_key: "bin",
      path: join([path_parent_directory(path: inst.serve_binary as String), "/.write-probe"], ""),
    )
    && launcher_write_refused(
      instance: inst,
      unit_key: "hooks",
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
    && wet_clean_claim_root(root: root)
}

// THE LAUNCHER DERIVES THE WORKTREE, LOG DIRECTORY AND EXIT HOOK from the attempt identity (review
// 80324), so each launcher cell is its own attempt (wetprobe-<unit_key>) and prepares that attempt's
// state and worktree the way the belt does before it starts.
fn launcher_probe_key(unit_key: String) -> String {
  join([wet_probe_key, "-", unit_key], "")
}

fn launcher_probe_worktree(instance: HostDashboardInstance, unit_key: String) -> String {
  dispatch_worktree_path_for_instance(instance: instance, node_id: wet_probe_node, attempt_key: launcher_probe_key(unit_key: unit_key))
}

fn launcher_probe_worker_dir(instance: HostDashboardInstance, unit_key: String) -> String {
  path_parent_directory(path: attempt_log_member_text(instance: instance, node_id: wet_probe_node, attempt_key: launcher_probe_key(unit_key: unit_key), member: AttemptWorkerLog))
}

fn prepare_launcher_probe(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let preps = attempt_state_prepare_argvs_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: launcher_probe_key(unit_key: unit_key),
  )
  fold(preps, init: true, f: (ok, p) => ok && shell.Exec.RunArgv(program: p.program, arguments: p.args).exit_code == 0)
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", launcher_probe_worktree(instance: instance, unit_key: unit_key)]).exit_code == 0
}

fn launcher_inner_start(instance: HostDashboardInstance, unit_key: String, inner: List<String>) -> SandboxTouch {
  match inner.first() {
    Absent => SandboxTouchUnrunnable
    Present { value: _ } => {
      let request = AttemptSystemUnitStartRequest {
        node_id: wet_probe_node as String,
        attempt_key: launcher_probe_key(unit_key: unit_key),
        granted: kibibyte(count: 65536),
        inner_argv: inner,
        nonce: wet_run_nonce(),
      }
      if !prepare_launcher_probe(instance: instance, unit_key: unit_key) {
        SandboxTouchUnrunnable
      } else {
        let before = wet_record_names(instance_root: instance.instance_root as String, unit_key: unit_key)
        match attempt_system_unit_enqueue_start_wait(
          instance_root: instance.instance_root as String,
          request: request,
        ) {
          AttemptSystemUnitEnqueueRefused { detail: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueueOccupied { entry: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueued { entry: entry, body: body } =>
            if wet_drain_started(instance_root: instance.instance_root as String, entry: entry, request_body: body) {
              wet_inner_exit_status(instance_root: instance.instance_root as String, unit_key: unit_key, before: before)
            } else {
              SandboxTouchUnrunnable
            }
        }
      }
    }
  }
}

fn launcher_sandbox_touch(instance: HostDashboardInstance, unit_key: String, path: String) -> SandboxTouch {
  launcher_inner_start(instance: instance, unit_key: unit_key, inner: launcher_touch_inner_argv(instance: instance, path: path))
}

fn launcher_sudo_n_true(instance: HostDashboardInstance) -> SandboxTouch {
  launcher_inner_start(
    instance: instance,
    unit_key: "sudo-n-true",
    inner: launcher_gunbc_run_inner_argv(instance: instance, function: "sudo_n_true_cli", extra_args: []),
  )
}

fn launcher_sudo_n_touch(instance: HostDashboardInstance, path: String) -> SandboxTouch {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: arg } =>
      launcher_inner_start(
        instance: instance,
        unit_key: "sudo-n-touch",
        inner: launcher_gunbc_run_inner_argv(
          instance: instance,
          function: "sudo_n_touch_cli",
          extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
        ),
      )
  }
}

test fn sudo_n_true_fails_inside_the_launched_unit() -> Bool {
  // THE UNIT CANNOT ESCALATE. The leg is only evidence if the unit it launched was launched
  // against a lab the claim made: under the live row the escalation attempt ran with the live
  // install as its subject, and the tree it could have touched afterwards was the served one.
  let root = wet_claim_root(tag: "sudo-true" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && match launcher_sudo_n_true(instance: inst) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code != 0
    }
    && wet_clean_claim_root(root: root)
}

test fn sudo_n_touch_of_instance_bin_fails_inside_the_launched_unit() -> Bool {
  // ESCALATION DOES NOT BUY THE DEPLOYED TREE EITHER. The path is an accessor over the row --
  // the bin directory of the instance the claim supplied -- and the directory is planted, so the
  // refusal is the unit's filesystem policy rather than a missing parent.
  let root = wet_claim_root(tag: "sudo-touch" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let escaped_target = join([path_parent_directory(path: inst.serve_binary as String), "/x"], "")
  wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && wet_write_refused(
      touch: launcher_sudo_n_touch(instance: inst, path: escaped_target),
      existed_before: wet_path_exists(path: escaped_target),
      path: escaped_target,
    )
    && wet_clean_claim_root(root: root)
}

test fn writes_through_the_launcher_to_the_worktree_worker_dir_and_git_objects_are_allowed() -> Bool {
  // THE ALLOWED SIDE OF THE LAUNCHER POLICY. These are the writes the launcher is supposed to
  // let through, so they are the half that keeps the refusals above from being a sandbox that
  // simply blocks everything -- and a sandbox that writes the deployment's own worktree, log
  // directory and object store proves nothing about what it would allow. The three targets are
  // accessors over the supplied row; the directories under them are planted by the claim.
  let root = wet_claim_root(tag: "launcher-allowed" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let objects = join([inst.repo_root as String, "/.git/objects/.gunbc-worker-write-probe"], "")
  let probe = join([launcher_probe_worktree(instance: inst, unit_key: "wt"), "/.gunbc-launcher-write-probe"], "")
  let log_probe = join([launcher_probe_worker_dir(instance: inst, unit_key: "log"), "/.gunbc-launcher-log-probe"], "")
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_wrote(instance: inst, unit_key: "wt", path: probe)
    && launcher_wrote(instance: inst, unit_key: "log", path: log_probe)
    && launcher_wrote(instance: inst, unit_key: "objects", path: objects)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe, objects]).exit_code == 0
    && wet_clean_claim_root(root: root)
}

fn exit_success_cli() -> ProcessExit {
  ExitSuccess
}

fn launcher_exit_record_names(instance: HostDashboardInstance) -> List<String> {
  let inbox = attempt_exit_inbox_dir(instance_root: instance.instance_root as String)
  let listing = Filesystem.List(path: inbox)
  let observed = filesystem_listing_observation(
    directory: inbox,
    success: listing.success,
    entries: listing.entries,
    error: listing.error,
  )
  match observed {
    FilesystemDirectoryListed(listed) =>
      filter(
        filesystem_listing_entry_names(listing: listed),
        n => string_contains(s: n, pattern: join([wet_probe_node as String, "+", wet_probe_key, "-exitrec", "+worker+"], "")),
      )
    _ => []
  }
}

fn launcher_exit_record_is_expanded(name: String) -> Bool {
  let unexpanded = join(["$", "{"], "")
  !string_contains(s: name, pattern: unexpanded)
    && match attempt_exit_entry_decode(entry_name: name) {
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
      AttemptExitEntryDecoded { record } =>
        string_length(s: record.invocation_id) == 32
          && !string_contains(s: record.invocation_id, pattern: unexpanded)
          && match record.result {
            ServiceResultSuccess =>
              match record.end {
                AttemptProcessExitedWith { status } => status == 0
                _ => false
              }
            _ => false
          }
    }
}

test fn a_launched_unit_exit_record_names_the_expanded_invocation_and_result() -> Bool {
  // THE EXIT RECORD IS READ BACK FROM THE CLAIM'S OWN INBOX. The record has to name the expanded
  // invocation of a guest the claim installed; under the live row the "expanded invocation" was
  // the deployment's, and the inbox the record was read out of was the served one -- an exit
  // record written into the live lab is an effect, not an observation.
  let root = wet_claim_root(tag: "exit-record" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && match launcher_inner_start(
      instance: inst,
      unit_key: "exitrec",
      inner: launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []),
    ) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code: _ } =>
        match launcher_exit_record_names(instance: inst).first() {
          Absent => false
          Present { value: name } => launcher_exit_record_is_expanded(name: name)
        }
    }
    && wet_clean_claim_root(root: root)
}

// THE ROOT-EXEC SHAPE IS REFUSED ON THE REAL PATH (review 80324). Before the launcher derived the exit
// hook, a requester-written pending body could name `+/usr/bin/touch <marker>` as ExecStopPost, which
// systemd runs with full privileges whatever User= says. This cell writes that earlier wide body
// through the same pending file and runs the real launcher argv: the launcher must refuse the body, and
// no root-created marker may appear.
data launcher_root_hook_marker: String = "/tmp/gunbc-launcher-root-hook-probe"

fn launcher_marker_absent() -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["!", "-e", launcher_root_hook_marker]).exit_code == 0
}

test fn a_wide_request_naming_a_root_exit_hook_is_refused_by_the_launcher() -> Bool {
  // THE WIDE BODY NAMES THE CLAIM'S ROW, NOT THE DEPLOYMENT'S. The forged ExecStopPost and the
  // inner invocation are both built from the supplied row, so the refusal is the launcher
  // refusing a root-exec shape aimed at a lab this claim made -- and the marker it must not
  // leave behind is checked against a tree the claim owns.
  let root = wet_claim_root(tag: "root-hook-refusal" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wide = join([
    "start-wait", wet_probe_node as String, launcher_probe_key(unit_key: "roothook"),
    inst.directory_owner.user as String, inst.repo_root as String,
    launcher_probe_worktree(instance: inst, unit_key: "roothook"), "/tmp/gunbc-roothook.out", "/tmp/gunbc-roothook.err",
    "65536", join(["+/usr/bin/touch ", launcher_root_hook_marker], ""),
    join(launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []), "\u{1f}"),
    wet_run_nonce(),
  ], "\n")
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_marker_absent()
    && prepare_launcher_probe(instance: inst, unit_key: "roothook")
    && match attempt_system_unit_enqueue_request(
      instance_root: inst.instance_root as String,
      node_id: wet_probe_node as String,
      attempt_key: launcher_probe_key(unit_key: "roothook"),
      body: wide,
    ) {
      AttemptSystemUnitEnqueued { entry: entry, body: body } =>
        wet_drain_answer_arrives(instance_root: inst.instance_root as String, entry: entry, request_body: body)
          && launcher_run_refused(instance: inst, entry: entry, request_body: body) && launcher_marker_absent()
      AttemptSystemUnitEnqueueOccupied { entry: _ } => false
      AttemptSystemUnitEnqueueRefused { detail: _ } => false
    }
    && wet_clean_claim_root(root: root)
}

// THE ROOT SIDE RUNS WHEN THE REQUEST DIRECTORY FILLS (the drain .path unit starts the system
// oneshot), so a wet claim writes its request and then OBSERVES the answer the root helper leaves; it
// no longer runs the helper itself and holds no sudo grant. The wait is this witness's own bound, not
// the serve handler's: the handler never waits.
fn wet_drain_answer_arrives(instance_root: String, entry: String, request_body: String) -> Bool {
  wet_drain_answer_poll(instance_root: instance_root, entry: entry, request_body: request_body, remaining: 240)
}

fn wet_drain_answer_poll(instance_root: String, entry: String, request_body: String, remaining: Int) -> Bool {
  match attempt_system_unit_read_answer(instance_root: instance_root, entry: entry, request_body: request_body) {
    AttemptSystemUnitAnswerFound { answer: _ } => true
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
    AttemptSystemUnitAnswerMissing =>
      if remaining <= 0 {
        false
      } else {
        let _ = shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"])
        wet_drain_answer_poll(instance_root: instance_root, entry: entry, request_body: request_body, remaining: remaining - 1)
      }
  }
}

// THE INNER RESULT IS READ FROM THE ATTEMPT'S OWN EXIT RECORD, never inferred from the drain. The drain
// answers Started when the unit has been started and does not wait for it, so the answer says only that
// the unit ran, not whether the command inside it succeeded; the ExecStopPost record carries that
// (record.end). A claim that took "an answer arrived" for the inner command's result would score a unit
// that never executed as a refused write (DESIGN 4b: dissolving the sudo route may delete its
// machinery, never the discriminating RED and its positive control). Missing, unreadable or Refused
// answers, a record that never lands, and a signalled end are all SandboxTouchUnrunnable: the claim is
// false, never counted as refused. attempt_exit_record_observe reads inbox, queued, running, done and
// refused, so the belt-exit drain moving the record between stages cannot hide it.
fn wet_drain_started(instance_root: String, entry: String, request_body: String) -> Bool {
  wet_drain_started_poll(instance_root: instance_root, entry: entry, request_body: request_body, remaining: 240)
}

fn wet_drain_started_poll(instance_root: String, entry: String, request_body: String, remaining: Int) -> Bool {
  match attempt_system_unit_read_answer(instance_root: instance_root, entry: entry, request_body: request_body) {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => true
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: _ } } => false
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
    AttemptSystemUnitAnswerMissing =>
      if remaining <= 0 {
        false
      } else {
        let _ = shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"])
        wet_drain_started_poll(instance_root: instance_root, entry: entry, request_body: request_body, remaining: remaining - 1)
      }
  }
}

// THE RECORD IS BOUND TO THIS START. Probe keys are fixed across runs and done/ is retained (the belt's
// evidence, never deleted to make room), so an earlier run's record answers a search by (node, key, role)
// before this run's unit has written anything. The names present before the enqueue are snapshotted and
// only a record outside the snapshot is this run's; two new ones are ambiguous and Unrunnable.
type WetRecordNames
  = WetRecordNamesListed { names: List<String> }
  | WetRecordNamesUnreadable

fn wet_record_names(instance_root: String, unit_key: String) -> WetRecordNames {
  let prefix = join([wet_probe_node as String, "+", launcher_probe_key(unit_key: unit_key), "+worker+"], "")
  fold(
    attempt_exit_stage_listings(instance_root: instance_root),
    init: WetRecordNamesListed { names: [] },
    f: (acc, listing) => match acc {
      WetRecordNamesUnreadable => WetRecordNamesUnreadable
      WetRecordNamesListed { names: so_far } =>
        match listing {
          AttemptExitStageUnreadable { reason: _ } => WetRecordNamesUnreadable
          AttemptExitStageNames { names: names } =>
            WetRecordNamesListed { names: concat(so_far, filter(names, n => string_contains(s: n, pattern: prefix))) }
        }
    },
  )
}

fn wet_fresh_record_names(before: List<String>, after: List<String>) -> List<String> {
  filter(after, n => !any(before, b => b == n))
}

fn wet_inner_exit_status(instance_root: String, unit_key: String, before: WetRecordNames) -> SandboxTouch {
  match before {
    WetRecordNamesUnreadable => SandboxTouchUnrunnable
    WetRecordNamesListed { names: seen } => wet_inner_exit_status_poll(instance_root: instance_root, unit_key: unit_key, seen: seen, remaining: 240)
  }
}

fn wet_inner_exit_status_poll(instance_root: String, unit_key: String, seen: List<String>, remaining: Int) -> SandboxTouch {
  match wet_record_names(instance_root: instance_root, unit_key: unit_key) {
    WetRecordNamesUnreadable => SandboxTouchUnrunnable
    WetRecordNamesListed { names: after } => {
      let fresh = wet_fresh_record_names(before: seen, after: after)
      match fresh.first() {
        Absent =>
          if remaining <= 0 {
            SandboxTouchUnrunnable
          } else {
            let _ = shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"])
            wet_inner_exit_status_poll(instance_root: instance_root, unit_key: unit_key, seen: seen, remaining: remaining - 1)
          }
        Present { value: name } =>
          if length(fresh) != 1 {
            SandboxTouchUnrunnable
          } else {
            match attempt_exit_entry_decode(entry_name: name) {
              AttemptExitEntryMalformed { entry_name: _, reason: _ } => SandboxTouchUnrunnable
              AttemptExitEntryDecoded { record } =>
                match record.end {
                  AttemptProcessExitedWith { status } => SandboxTouchRan { exit_code: status }
                  AttemptProcessSignaled { signal: _ } => SandboxTouchUnrunnable
                }
            }
          }
      }
    }
  }
}

// A record planted for the key before the run is in the snapshot and is never read as this run's. This goes
// through the poll itself (remaining: 0, so no waiting): a prior refused-scoring record in done/ must leave
// the poll Unrunnable, and one fresh status-0 record in the inbox is then the only one read.
fn wet_plant_record(root: String, stage_dir: String, status: Int) -> Bool {
  shell.Exec.RunArgv(
    program: "mkdir",
    arguments: ["-p", "--", join([stage_dir, "/", attempt_exit_vendor_pane_entry_name(node_id: wet_probe_node as String, attempt_key: launcher_probe_key(unit_key: "bin"), status: status)], "")],
  ).exit_code == 0
}

test fn a_prior_run_record_for_the_key_is_not_read_as_this_runs() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_exit_spool_prepare(instance_root: root)
      && wet_plant_record(root: root, stage_dir: attempt_exit_done_dir(instance_root: root), status: 1)
      && match wet_record_names(instance_root: root, unit_key: "bin") {
        WetRecordNamesUnreadable => false
        WetRecordNamesListed { names: seen } =>
          (match wet_inner_exit_status_poll(instance_root: root, unit_key: "bin", seen: seen, remaining: 0) {
            SandboxTouchUnrunnable => true
            SandboxTouchRan { exit_code: _ } => false
          })
            && wet_plant_record(root: root, stage_dir: attempt_exit_inbox_dir(instance_root: root), status: 0)
            && (match wet_inner_exit_status_poll(instance_root: root, unit_key: "bin", seen: seen, remaining: 0) {
              SandboxTouchUnrunnable => false
              SandboxTouchRan { exit_code } => exit_code == 0
            })
      }
  }
}

// RESIDUAL: a unit that fails in exec setup (EXIT_* range, e.g. 226 NAMESPACE for a missing ReadWritePaths
// entry) still scores as refused here, since the status is nonzero and the path absent. The same-shape
// allowed cells catch a shape-wide failure, not a per-cell one. The exit-status classification is modelled
// for the direct probes in #14655 and is not written a second time here; the launcher cells consume it once
// both land.
fn wet_path_is_executable(path: String) -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["-x", path]).exit_code == 0
}

fn wet_path_exists(path: String) -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["-e", path]).exit_code == 0
}

// A refused write needs the nonzero inner status AND the target unchanged: a probe path that did not
// exist before must still not exist, so a status that disagrees with the filesystem is not a pass.
// An allowed write needs status 0 AND the path present afterwards.
fn wet_write_refused(touch: SandboxTouch, existed_before: Bool, path: String) -> Bool {
  match touch {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code != 0 && (existed_before || !wet_path_exists(path: path))
  }
}

fn launcher_run_refused(instance: HostDashboardInstance, entry: String, request_body: String) -> Bool {
  match attempt_system_unit_read_answer(instance_root: instance.instance_root as String, entry: entry, request_body: request_body) {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => false
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: _ } } => true
    AttemptSystemUnitAnswerMissing => true
    AttemptSystemUnitAnswerUnreadable { detail: _ } => true
  }
}

fn attempt_system_unit_spool_prepare(instance_root: String) -> Bool {
  fold(
    [
      attempt_unit_spool_staging_dir(instance_root: instance_root),
      attempt_unit_spool_request_dir(instance_root: instance_root),
      attempt_unit_spool_claimed_dir(instance_root: instance_root),
      attempt_unit_spool_answer_dir(instance_root: instance_root),
    ],
    init: true,
    f: (ok, dir) => ok && shell.Mkdir.Parents(path: dir as FilePath).success,
  )
}

fn wet_word_request(node_id: String, attempt_key: String, argv_word: String) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: node_id,
    attempt_key: attempt_key,
    granted: kibibyte(count: 1),
    inner_argv: [argv_word],
    nonce: "n",
  }
}

test fn two_request_entries_keep_distinct_bodies() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-a", attempt_key: "k1", argv_word: "one")) {
        AttemptSystemUnitEnqueued { entry: a, body: _ } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-b", attempt_key: "k1", argv_word: "two")) {
            AttemptSystemUnitEnqueued { entry: b, body: _ } => {
              let ra = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: a)))
              let rb = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: b)))
              ra.success && rb.success && ra.content != rb.content && a != b
            }
            AttemptSystemUnitEnqueueOccupied { entry: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_second_request_for_the_same_attempt_is_occupied() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let request = wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x")
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
        AttemptSystemUnitEnqueued { entry: _, body: _ } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
            AttemptSystemUnitEnqueueOccupied { entry } =>
              entry == attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
            AttemptSystemUnitEnqueued { entry: _, body: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_claimed_entry_is_processed_once_across_two_claim_runs() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(
        instance_root: root,
        request: wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x"),
      ) {
        AttemptSystemUnitEnqueued { entry, body: _ } =>
          match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
            AttemptSystemUnitClaimed { entry: _, path: _ } =>
              match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
                AttemptSystemUnitAlreadyClaimed { entry: again } => again == entry
                AttemptSystemUnitClaimed { entry: _, path: _ } => false
                AttemptSystemUnitClaimSymlink { entry: _ } => false
                AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
                AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
              }
            AttemptSystemUnitAlreadyClaimed { entry: _ } => false
            AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
            AttemptSystemUnitClaimSymlink { entry: _ } => false
            AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_symlinked_request_entry_is_refused_by_the_claim() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dest = attempt_system_unit_request_path(instance_root: root, entry: entry)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", dest]).exit_code == 0
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimSymlink { entry: got } => got == entry
        AttemptSystemUnitClaimed { entry: _, path: _ } => false
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

fn claimed_body_refused_after_plant(plant: fn(String) -> Bool, needle: String) -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dir = attempt_system_unit_request_path(instance_root: root, entry: entry)
    let body = attempt_system_unit_request_body_path(dir: dir)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Mkdir.NewOwnerOnly(path: dir as FilePath).success
      && plant(body)
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimed { entry: _, path } =>
          match attempt_system_unit_read_claimed_body(path: attempt_system_unit_request_body_path(dir: path)) {
            AttemptSystemUnitClaimedBodyRefused { reason } => string_contains(s: reason, pattern: needle)
            AttemptSystemUnitClaimedBodyRead { content: _ } => false
          }
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
        AttemptSystemUnitClaimSymlink { entry: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

test fn a_fifo_request_body_is_refused_without_reading() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "mkfifo", arguments: ["--", body]).exit_code == 0,
    needle: "fifo",
  )
}

test fn a_symlinked_request_body_is_refused_without_following() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/dev/zero", body]).exit_code == 0,
    needle: "symlink",
  )
}

fn sandbox_worktree_commit_cli(worktree: String, git_dir: String) -> ProcessExit {
  let r = shell.Exec.RunArgv(
    program: "/usr/bin/git",
    arguments: [
      "--git-dir", git_dir, "--work-tree", worktree,
      "-c", "user.email=probe@gunbc.local", "-c", "user.name=probe",
      "commit", "--allow-empty", "-q", "-m", "worker-probe",
    ],
  )
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "worktree commit refused")
  }
}

fn prepare_launcher_linked_worktree(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  prepare_launcher_probe(instance: instance, unit_key: unit_key)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-rf", "--", wt]).exit_code == 0
    && shell.Exec.RunArgv(
      program: "git",
      arguments: ["-C", instance.repo_root as String, "worktree", "add", "--detach", "--", wt, "HEAD"],
    ).exit_code == 0
}

fn launcher_worktree_commit(instance: HostDashboardInstance, unit_key: String) -> SandboxTouch {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  let git_dir = dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: wt)
  match admit_named_argument(name: "worktree", value: wt) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: wt_arg } =>
      match admit_named_argument(name: "git_dir", value: git_dir) {
        NamedArgumentNameEmpty => SandboxTouchUnrunnable
        NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
        NamedArgumentAdmitted { argument: git_arg } =>
          launcher_inner_start(
            instance: instance,
            unit_key: unit_key,
            inner: launcher_gunbc_run_inner_argv(
              instance: instance,
              function: "sandbox_worktree_commit_cli",
              extra_args: [
                "--arg", join([wt_arg.name, "=", wt_arg.value], ""),
                "--arg", join([git_arg.name, "=", git_arg.value], ""),
              ],
            ),
          )
      }
  }
}


test fn writing_the_gitfile_or_commondir_inside_the_unit_fails_and_a_worktree_commit_succeeds() -> Bool {
  // THE GIT POINTER FILES BELONG TO A LAB THE CLAIM MADE. Under the live row the two refused
  // paths were the deployment's own gitfile and commondir, and the commit that is supposed to
  // SUCCEED ran in the deployment's worktree -- so this claim both proved a refusal by writing
  // where it should not have, and performed a real commit against the served repository.
  let root = wet_claim_root(tag: "git-pointer" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let unit_key = "gitptr"
  let wt = launcher_probe_worktree(instance: inst, unit_key: unit_key)
  let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
  wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && prepare_launcher_linked_worktree(instance: inst, unit_key: unit_key)
    && launcher_write_refused(instance: inst, unit_key: "gitfile", path: pointers.gitfile)
    && launcher_write_refused(instance: inst, unit_key: "commondir", path: pointers.commondir)
    && match launcher_worktree_commit(instance: inst, unit_key: unit_key) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code == 0
    }
    && wet_clean_claim_root(root: root)
}

test fn belt_commit_refuses_a_planted_commondir_without_running_git() -> Bool {
  // THE PLANTED COMMONDIR IS PLANTED IN A LAB THE CLAIM OWNS. This is the model-side half of the
  // pair: the belt must refuse a commit whose worktree carries a commondir pointer, without
  // running git at all. It took its row from `lab_instance_at_repo`, which grafted the claim's
  // temp repository onto the LIVE lab row -- so the repository was the claim's but the instance
  // root, the private git dir the gitfile names, and the serve binary were the deployment's, and
  // the refusal it reported was read off a row this witness had no business standing on. That
  // builder is retired; the row is supplied and every path below, including the gitdir the
  // planted gitfile names, is an accessor over it.
  let root = wet_claim_root(tag: "belt-commondir" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wt = join([root, "/wt"], "")
  let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
  let expected_git_dir = dispatch_attempt_private_git_dir(instance: inst, attempt_worktree: wt)
  wet_claim_is_confined(instance: inst, root: root)
    && shell.Mkdir.Parents(path: path_parent_directory(path: pointers.gitfile) as FilePath).success
    && shell.Mkdir.Parents(path: path_parent_directory(path: pointers.commondir) as FilePath).success
    && Filesystem.Write(path: pointers.gitfile, content: join(["gitdir: ", expected_git_dir, "\n"], "")).success
    && Filesystem.Write(path: pointers.commondir, content: join([root, "/planted-commondir\n"], "")).success
    && match belt_commit_git(instance: inst, worktree: wt, args: ["status"]) {
      ExecRefused { program: _, reason } => string_contains(s: reason, pattern: "commondir")
      ExecOk { stdout: _ } => false
      ExecFailed { program: _, exit_code: _, stderr: _ } => false
    }
    && wet_clean_claim_root(root: root)
}

// THE ATTEMPT-UNIT DRAIN'S LINE STOP. The drain's .path unit is a level on requests/, so every entry a pass
// leaves there starts the root drain again. RED: a request the claim cannot move (claimed/<entry> already
// holds content) must be reported Unmovable, stall the pass that retired nothing, and leave a readable record;
// before the repair the claim reported it AlreadyClaimed and the drain exited with the request in place.
fn unmovable_request_root(tag: String) -> String? {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    none
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: tag)
    let occupied = attempt_system_unit_claimed_path(instance_root: root, entry: entry)
    if attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n1", attempt_key: tag, argv_word: "x")) {
        AttemptSystemUnitEnqueued { entry: _, body: _ } => true
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
      && shell.Mkdir.Parents(path: join([occupied, "/held"], "") as FilePath).success {
      Present { value: root }
    } else {
      none
    }
  }
}

test fn a_request_the_claim_cannot_move_stalls_the_drain_and_leaves_a_record() -> Bool {
  match unmovable_request_root(tag: "k1") {
    Absent => false
    Present { value: root } => {
      let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
      let pass = attempt_system_unit_drain_pass(instance_root: root)
      let claim_is_unmovable = match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimUnmovable { entry: e, cause: _ } => e == entry
        _ => false
      }
      let verdict = match attempt_unit_stall_verdict(pass: pass) {
        AttemptUnitStalled { unmovable } => count(unmovable) == 1
        AttemptUnitNotStalled => false
      }
      let exited = match attempt_system_unit_launch_cli(instance_root: root) {
        ExitSuccess => false
        ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "unmovable at claim")
      }
      claim_is_unmovable && verdict && exited && pass.retired == 0 && match spool_stall_read_at(record_path: attempt_unit_spool_stall_record_path(instance_root: root)) {
        SpoolStallHeld { entries } => count(entries) == 1 && (entries |> map(e => e.step)) == [SpoolStallClaim]
        SpoolStallNone => false
        SpoolStallUnreadable { reason: _ } => false
      }
    }
  }
}

test fn an_unlistable_request_directory_stalls_the_drain() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let pass = attempt_system_unit_drain_pass(instance_root: root)
    match attempt_unit_stall_verdict(pass: pass) {
      AttemptUnitStalled { unmovable } => (unmovable |> map(e => e.step)) == [SpoolStallListRequests]
      AttemptUnitNotStalled => false
    }
  }
}

// POSITIVE CONTROLS: a request the drain retires (here a symlink entry, refused with an answer) is out of
// requests/, retired > 0, and no record is written; an empty spool is not a stall either.
test fn a_retired_request_and_an_empty_spool_do_not_stall_the_drain() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dest = attempt_system_unit_request_path(instance_root: root, entry: entry)
    let prepared = attempt_system_unit_spool_prepare(instance_root: root)
    let empty_not_stalled = match attempt_unit_stall_verdict(pass: attempt_system_unit_drain_pass(instance_root: root)) {
      AttemptUnitNotStalled => true
      AttemptUnitStalled { unmovable: _ } => false
    }
    let planted = shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", dest]).exit_code == 0
    let pass = attempt_system_unit_drain_pass(instance_root: root)
    let retired_not_stalled = pass.retired == 1 && pass.refused == 1 && match attempt_unit_stall_verdict(pass: pass) {
      AttemptUnitNotStalled => true
      AttemptUnitStalled { unmovable: _ } => false
    }
    prepared && empty_not_stalled && planted && retired_not_stalled
      && spool_stall_read_at(record_path: attempt_unit_spool_stall_record_path(instance_root: root)) == SpoolStallNone
  }
}

// A REFUSAL IS AN ANSWER (end to end through the CLI). The refused request is answered and leaves requests/, and
// the unit's exit is success; the drain's own failure (here: the answer cannot be created because one already
// exists for the entry) is the nonzero exit.
fn planted_symlink_request_root(tag: String, answer_exists: Bool) -> String? {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    none
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: tag)
    let prepared = attempt_system_unit_spool_prepare(instance_root: root)
    let planted = shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", attempt_system_unit_request_path(instance_root: root, entry: entry)]).exit_code == 0
    let answered = if answer_exists { attempt_system_unit_write_answer(instance_root: root, entry: entry, body: "", answer: AttemptSystemUnitStarted) } else { true }
    if prepared && planted && answered { Present { value: root } } else { none }
  }
}

test fn a_refused_request_does_not_fail_the_drain_unit() -> Bool {
  match planted_symlink_request_root(tag: "k1", answer_exists: false) {
    Absent => false
    Present { value: root } => match attempt_system_unit_launch_cli(instance_root: root) {
      ExitSuccess => true
      ExitFailure { code: _, reason: _ } => false
    }
  }
}

test fn a_request_the_drain_cannot_answer_fails_the_drain_unit() -> Bool {
  match planted_symlink_request_root(tag: "k1", answer_exists: true) {
    Absent => false
    Present { value: root } => match attempt_system_unit_launch_cli(instance_root: root) {
      ExitSuccess => false
      ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "could not be written")
    }
  }
}

// A PER-RUN NAME FOR A REQUEST ON THE REAL SPOOL. answers/<entry> is keyed by node and attempt key and outlives
// the run, so the cells that use the lab's fixed keys bind their request to a fresh value and read only the
// answer that echoes it. An unmade temp directory yields "", which the encoder refuses: the cell is false, not
// bound to a shared name.
fn wet_run_nonce() -> String {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    ""
  } else {
    fold(split(s: tmp.path as String, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
  }
}
