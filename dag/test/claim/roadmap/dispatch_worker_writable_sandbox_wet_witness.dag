data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wet_probe_node: RoadmapNodeId = "writable-probe" as RoadmapNodeId
data wet_probe_key: String = "wetprobe"

// WET: a real systemd-run --user transient with the worker unit's production properties, then one
// argv `touch -- <path>` per subject. Asserts the kernel REFUSES a forbidden write: the touch must
// have RUN and failed with the path absent afterwards (sandbox_touch_reading_of), in a unit shape
// whose allowed touch also runs (worker_shape_runs_an_allowed_touch). Two srv1 readings of this
// shape, both un-refused: (1) before the empty bounding set, kernel.apparmor_restrict_unprivileged_userns=1
// meant the user manager could not build the mount namespace and dropped ProtectSystem/ProtectHome/
// ReadWritePaths without error, so the write succeeded (bright-moth-475, issuecomment-6175000334);
// (2) with EmptyCapabilityBoundingSet in the properties (2026-10-21, systemd 255) the user manager
// fails exec setup, status 218 EXIT_CAPABILITIES, so the command NEVER RUNS: fail closed, and no
// evidence about the mount sandbox. That reading was once scored as a refused write; it is now
// SandboxTouchNeverRan and this claim is RED on it. Production does not launch workers this way:
// belt_actuate starts them as system-manager transients through attempt_system_unit_launch. This is
// the discriminating RED for gunbc.rung_drop.user_manager_worker_write_boundary_unenforced; do not
// invert this claim to expect success, and do not read its RED as "the write succeeded". Local
// recipe: claim_batch --wet --source-root dag
// --source-root src/v2 --entry dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag
// Requires a user systemd manager (srv1).

fn prepare_probe_attempt(instance: HostDashboardInstance) -> Bool {
  let prep = attempt_state_prepare_argv_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: wet_probe_key,
  )
  let wt = probe_attempt_worktree(instance: instance)
  shell.Exec.RunArgv(program: prep.program, arguments: prep.args).exit_code == 0
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", wt]).exit_code == 0
}

fn probe_attempt_dir(instance: HostDashboardInstance) -> String {
  dispatch_attempt_state_path_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: wet_probe_key,
  )
}

fn probe_worker_dir(instance: HostDashboardInstance) -> String {
  path_parent_directory(path: dispatch_attempt_worker_log_path_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: wet_probe_key,
  ))
}

fn probe_attempt_worktree(instance: HostDashboardInstance) -> String {
  join([dashboard_instance_dispatch_worktree_root(instance: instance) as String, "/", wet_probe_key], "")
}

fn worker_probe_properties(instance: HostDashboardInstance) -> List<SystemdRunProperty> {
  dispatch_worker_unit_properties(
    instance: instance,
    working_directory: instance.repo_root as String,
    attempt_worktree: probe_attempt_worktree(instance: instance),
    worker_log_path: join([probe_worker_dir(instance: instance), "/worker-stdout.log"], ""),
    granted: kibibyte(count: 65536),
    process_bounds: session_process_bounds,
    exit_hook: "true" as NonEmptyStr,
  )
}

fn sandbox_touch(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> SandboxTouch {
  match systemd_run_user_wait_command(
    unit: unit,
    properties: worker_probe_properties(instance: instance),
    setenv_bindings: [],
    command_argv: ["/usr/bin/touch", "--", path],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => SandboxTouchUnrunnable
    SystemdSummaryPrintingWaitReady { wait: wait } =>
      SandboxTouchRan {
        exit_code: shell.Exec.RunArgv(
          program: "systemd-run",
          arguments: systemd_run_command_argument_words(command: wait.command),
        ).exit_code,
      }
  }
}

fn sandbox_touch_read(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> SandboxTouchReading {
  let touch = sandbox_touch(instance: instance, unit: unit, path: path)
  sandbox_touch_reading_of(
    touch: touch,
    path_present: shell.Exec.RunArgv(program: "test", arguments: ["-e", path]).exit_code == 0,
  )
}

// The paired control: the SAME route as the sandboxed touch (a user-manager transient, same principal,
// same supplementary groups), with no sandbox properties, writes a sibling of the target in its
// directory and removes it. Running it from the claim process instead would differ in credentials (an
// ssh session carries groups the long-running user manager lacks), so a target writable only through
// such a group would refuse the sandboxed touch by permission while the control wrote, and the
// refusal would be credited to the sandbox. The pair differs in exactly one variable. quick-bee-65
fn unsandboxed_sibling_write_ok(unit: NonEmptyStr, path: String) -> Bool {
  match systemd_run_user_wait_command(
    unit: unit,
    properties: [],
    setenv_bindings: [],
    command_argv: [
      "/bin/sh", "-c", "touch -- \"$1\" && rm -f -- \"$1\"", "sh",
      join([path, ".unsandboxed-control"], ""),
    ],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => false
    SystemdSummaryPrintingWaitReady { wait: wait } =>
      shell.Exec.RunArgv(
        program: "systemd-run",
        arguments: systemd_run_command_argument_words(command: wait.command),
      ).exit_code == 0
  }
}

fn refusal_reading_after_control(control_wrote: Bool, reading: SandboxTouchReading) -> SandboxTouchReading {
  match reading {
    SandboxTouchRefusedReading => if control_wrote { SandboxTouchRefusedReading } else { SandboxTouchInconclusive }
    SandboxTouchNeverRan => SandboxTouchNeverRan
    SandboxTouchWroteReading => SandboxTouchWroteReading
    SandboxTouchInconclusive => SandboxTouchInconclusive
  }
}

fn sandbox_touch_write_refused(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> Bool {
  match refusal_reading_after_control(
    control_wrote: unsandboxed_sibling_write_ok(
      unit: join([unit as String, "-control"], "") as NonEmptyStr,
      path: path,
    ),
    reading: sandbox_touch_read(instance: instance, unit: unit, path: path),
  ) {
    SandboxTouchRefusedReading => true
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
    SandboxTouchInconclusive => false
  }
}

fn reading_is_inconclusive(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchInconclusive => true
    SandboxTouchRefusedReading => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

fn reading_is_refused(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchRefusedReading => true
    SandboxTouchInconclusive => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

// RED for the control, on supplied values: a refused touch whose control could not write reads
// inconclusive, never refused; the same refusal with a writing control stands.
test fn a_refusal_the_principal_could_not_have_been_denied_otherwise_reads_inconclusive() -> Bool {
  reading_is_inconclusive(reading: refusal_reading_after_control(control_wrote: false, reading: SandboxTouchRefusedReading))
    && reading_is_refused(reading: refusal_reading_after_control(control_wrote: true, reading: SandboxTouchRefusedReading))
}

// Inhabitance of the real control route (needs a user manager, like the sibling cells): ENOENT and
// EACCES directories read false, a writable one true. The EACCES half is unobservable as root, so the
// claim requires a non-root principal and is false on a root runner rather than passing without it.
test fn the_unsandboxed_control_reads_the_principals_write_access() -> Bool {
  shell.Exec.RunArgv(program: "sh", arguments: ["-c", "test \"$(id -u)\" -ne 0"]).exit_code == 0
    && !unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-enoent.service" as NonEmptyStr, path: "/proc/gunbc-no-such-dir/target")
    && !unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-eacces.service" as NonEmptyStr, path: "/usr/gunbc-control-target")
    && unsandboxed_sibling_write_ok(unit: "gunbc-control-inhabit-ok.service" as NonEmptyStr, path: "/tmp/gunbc-control-inhabitance-target")
}

fn sandbox_touch_wrote(instance: HostDashboardInstance, unit: NonEmptyStr, path: String) -> Bool {
  match sandbox_touch_read(instance: instance, unit: unit, path: path) {
    SandboxTouchWroteReading => true
    SandboxTouchNeverRan => false
    SandboxTouchRefusedReading => false
    SandboxTouchInconclusive => false
  }
}

// The same-shape positive control for the refused cells: the worker unit shape must RUN a touch that
// is allowed, or no refusal from it counts. It writes a dedicated path in the worker directory that nothing else names (systemd itself opens worker-stdout.log, so that file proves nothing about touch) and cleans up.
fn worker_shape_runs_an_allowed_touch(instance: HostDashboardInstance) -> Bool {
  let control = join([probe_worker_dir(instance: instance), "/.gunbc-worker-control-probe"], "")
  sandbox_touch_wrote(
    instance: instance,
    unit: "gunbc-writable-probe-control.service" as NonEmptyStr,
    path: control,
  ) && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", control]).exit_code == 0
}

test fn writes_to_the_deployed_binary_and_tree_fail_inside_the_worker_sandbox() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let attempt = probe_attempt_dir(instance: inst)
  prepare_probe_attempt(instance: inst)
    && worker_shape_runs_an_allowed_touch(instance: inst)
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-bin.service" as NonEmptyStr,
      path: join([inst.serve_binary as String, ".write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-tree.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.gunbc-worker-write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-binding.service" as NonEmptyStr,
      path: join([attempt, "/request-binding.json"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-attempt-file.service" as NonEmptyStr,
      path: join([attempt, "/forged-owner-record"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      unit: "gunbc-writable-probe-hook.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
}

test fn the_worker_worktree_is_writable_inside_the_same_sandbox() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let wt = probe_attempt_worktree(instance: inst)
  let scratch = probe_worker_dir(instance: inst)
  let probe = join([wt, "/.gunbc-worker-write-probe"], "")
  let log_probe = join([scratch, "/.gunbc-worker-write-probe"], "")
  prepare_probe_attempt(instance: inst)
    && sandbox_touch_wrote(
      instance: inst,
      unit: "gunbc-writable-probe-wt.service" as NonEmptyStr,
      path: probe,
    )
    && sandbox_touch_wrote(
      instance: inst,
      unit: "gunbc-writable-probe-log.service" as NonEmptyStr,
      path: log_probe,
    )
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe]).exit_code == 0
}

fn sandbox_touch_cli(path: String) -> ProcessExit {
  if Filesystem.Write(path: path, content: "probe\n").success {
    ExitSuccess
  } else {
    exit_failure(reason: "sandbox touch write refused")
  }
}

fn wet_witness_entry(instance: HostDashboardInstance) -> String {
  join([instance.repo_root as String, "/dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag"], "")
}

fn launcher_gunbc_run_inner_argv(instance: HostDashboardInstance, function: String, extra_args: List<String>) -> List<String> {
  concat(
    [
      instance.serve_binary as String,
      "run",
      "--source-root", join([instance.repo_root as String, "/dag"], ""),
      "--source-root", join([instance.repo_root as String, "/src/v2"], ""),
      "--entry", wet_witness_entry(instance: instance),
      "--function", function,
    ],
    extra_args,
  )
}

fn launcher_touch_inner_argv(instance: HostDashboardInstance, path: String) -> List<String> {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => []
    NamedArgumentNameHoldsSeparator { name: _ } => []
    NamedArgumentAdmitted { argument: arg } =>
      launcher_gunbc_run_inner_argv(
        instance: instance,
        function: "sandbox_touch_cli",
        extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
      )
  }
}

fn sudo_n_true_cli() -> ProcessExit {
  let r = shell.Exec.RunArgv(program: "/usr/bin/sudo", arguments: ["-n", "true"])
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "sudo -n true refused")
  }
}

fn sudo_n_touch_cli(path: String) -> ProcessExit {
  let r = shell.Exec.RunArgv(program: "/usr/bin/sudo", arguments: ["-n", "/usr/bin/touch", "--", path])
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "sudo -n touch refused")
  }
}

fn launcher_write_refused(instance: HostDashboardInstance, unit_key: String, path: String) -> Bool {
  match launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path) {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code != 0
  }
}

fn launcher_wrote(instance: HostDashboardInstance, unit_key: String, path: String) -> Bool {
  match launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path) {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code == 0
  }
}

test fn writes_through_the_launcher_to_bin_and_source_hooks_are_refused() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  prepare_probe_attempt(instance: inst)
    && launcher_write_refused(
      instance: inst,
      unit_key: "bin",
      path: join([path_parent_directory(path: inst.serve_binary as String), "/.write-probe"], ""),
    )
    && launcher_write_refused(
      instance: inst,
      unit_key: "hooks",
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
}

// THE LAUNCHER DERIVES THE WORKTREE, LOG DIRECTORY AND EXIT HOOK from the attempt identity (review
// 80324), so each launcher cell is its own attempt (wetprobe-<unit_key>) and prepares that attempt's
// state and worktree the way the belt does before it starts.
fn launcher_probe_key(unit_key: String) -> String {
  join([wet_probe_key, "-", unit_key], "")
}

fn launcher_probe_worktree(instance: HostDashboardInstance, unit_key: String) -> String {
  dispatch_worktree_path_for_instance(instance: instance, node_id: wet_probe_node, attempt_key: launcher_probe_key(unit_key: unit_key))
}

fn launcher_probe_worker_dir(instance: HostDashboardInstance, unit_key: String) -> String {
  path_parent_directory(path: dispatch_attempt_worker_log_path_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: launcher_probe_key(unit_key: unit_key),
  ))
}

fn prepare_launcher_probe(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let prep = attempt_state_prepare_argv_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: launcher_probe_key(unit_key: unit_key),
  )
  shell.Exec.RunArgv(program: prep.program, arguments: prep.args).exit_code == 0
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", launcher_probe_worktree(instance: instance, unit_key: unit_key)]).exit_code == 0
}

fn launcher_inner_start(instance: HostDashboardInstance, unit_key: String, inner: List<String>) -> SandboxTouch {
  match inner.first() {
    Absent => SandboxTouchUnrunnable
    Present { value: _ } => {
      let request = AttemptSystemUnitStartRequest {
        node_id: wet_probe_node as String,
        attempt_key: launcher_probe_key(unit_key: unit_key),
        granted: kibibyte(count: 65536),
        inner_argv: inner,
      }
      if !prepare_launcher_probe(instance: instance, unit_key: unit_key) {
        SandboxTouchUnrunnable
      } else {
        match attempt_system_unit_enqueue_start_wait(
          instance_root: instance.instance_root as String,
          request: request,
        ) {
          AttemptSystemUnitEnqueueRefused { detail: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueueOccupied { entry: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueued { entry: _ } =>
            match attempt_system_unit_launch_host_argv(instance: instance) {
              AttemptSystemUnitLaunchArgvRefused { cause: _ } => SandboxTouchUnrunnable
              AttemptSystemUnitLaunchArgvRevisionUnreadable => SandboxTouchUnrunnable
              AttemptSystemUnitLaunchArgvReady { argv } => {
                let cmd = attempt_system_unit_host_exec_from_launch_argv(argv: argv)
                SandboxTouchRan {
                  exit_code: shell.Exec.RunArgv(program: cmd.program, arguments: cmd.args).exit_code,
                }
              }
            }
        }
      }
    }
  }
}

fn launcher_sandbox_touch(instance: HostDashboardInstance, unit_key: String, path: String) -> SandboxTouch {
  launcher_inner_start(instance: instance, unit_key: unit_key, inner: launcher_touch_inner_argv(instance: instance, path: path))
}

fn launcher_sudo_n_true(instance: HostDashboardInstance) -> SandboxTouch {
  launcher_inner_start(
    instance: instance,
    unit_key: "sudo-n-true",
    inner: launcher_gunbc_run_inner_argv(instance: instance, function: "sudo_n_true_cli", extra_args: []),
  )
}

fn launcher_sudo_n_touch(instance: HostDashboardInstance, path: String) -> SandboxTouch {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: arg } =>
      launcher_inner_start(
        instance: instance,
        unit_key: "sudo-n-touch",
        inner: launcher_gunbc_run_inner_argv(
          instance: instance,
          function: "sudo_n_touch_cli",
          extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
        ),
      )
  }
}

test fn sudo_n_true_fails_inside_the_launched_unit() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  prepare_probe_attempt(instance: inst)
    && match launcher_sudo_n_true(instance: inst) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code != 0
    }
}

test fn sudo_n_touch_of_instance_bin_fails_inside_the_launched_unit() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  prepare_probe_attempt(instance: inst)
    && match launcher_sudo_n_touch(
      instance: inst,
      path: join([path_parent_directory(path: inst.serve_binary as String), "/x"], ""),
    ) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code != 0
    }
}

test fn writes_through_the_launcher_to_the_worktree_worker_dir_and_git_objects_are_allowed() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let objects = join([inst.repo_root as String, "/.git/objects/.gunbc-worker-write-probe"], "")
  let probe = join([launcher_probe_worktree(instance: inst, unit_key: "wt"), "/.gunbc-launcher-write-probe"], "")
  let log_probe = join([launcher_probe_worker_dir(instance: inst, unit_key: "log"), "/.gunbc-launcher-log-probe"], "")
  launcher_wrote(instance: inst, unit_key: "wt", path: probe)
    && launcher_wrote(instance: inst, unit_key: "log", path: log_probe)
    && launcher_wrote(instance: inst, unit_key: "objects", path: objects)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe, objects]).exit_code == 0
}

fn exit_success_cli() -> ProcessExit {
  ExitSuccess
}

fn launcher_exit_record_names(instance: HostDashboardInstance) -> List<String> {
  let inbox = attempt_exit_inbox_dir(instance_root: instance.instance_root as String)
  let listing = Filesystem.List(path: inbox)
  let observed = filesystem_listing_observation(
    directory: inbox,
    success: listing.success,
    entries: listing.entries,
    error: listing.error,
  )
  match observed {
    FilesystemDirectoryListed(listed) =>
      filter(
        filesystem_listing_entry_names(listing: listed),
        n => string_contains(s: n, pattern: join([wet_probe_node as String, "+", wet_probe_key, "-exitrec", "+worker+"], "")),
      )
    _ => []
  }
}

fn launcher_exit_record_is_expanded(name: String) -> Bool {
  let unexpanded = join(["$", "{"], "")
  !string_contains(s: name, pattern: unexpanded)
    && match attempt_exit_entry_decode(entry_name: name) {
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
      AttemptExitEntryDecoded { record } =>
        string_length(s: record.invocation_id) == 32
          && !string_contains(s: record.invocation_id, pattern: unexpanded)
          && match record.result {
            ServiceResultSuccess =>
              match record.end {
                AttemptProcessExitedWith { status } => status == 0
                _ => false
              }
            _ => false
          }
    }
}

test fn a_launched_unit_exit_record_names_the_expanded_invocation_and_result() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  match launcher_inner_start(
    instance: inst,
    unit_key: "exitrec",
    inner: launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []),
  ) {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code: _ } =>
      match launcher_exit_record_names(instance: inst).first() {
        Absent => false
        Present { value: name } => launcher_exit_record_is_expanded(name: name)
      }
  }
}

// THE ROOT-EXEC SHAPE IS REFUSED ON THE REAL PATH (review 80324). Before the launcher derived the exit
// hook, a requester-written pending body could name `+/usr/bin/touch <marker>` as ExecStopPost, which
// systemd runs with full privileges whatever User= says. This cell writes that earlier wide body
// through the same pending file and runs the real launcher argv: the launcher must refuse the body, and
// no root-created marker may appear.
data launcher_root_hook_marker: String = "/tmp/gunbc-launcher-root-hook-probe"

fn launcher_marker_absent() -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["!", "-e", launcher_root_hook_marker]).exit_code == 0
}

test fn a_wide_request_naming_a_root_exit_hook_is_refused_by_the_launcher() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let wide = join([
    "start-wait", wet_probe_node as String, launcher_probe_key(unit_key: "roothook"),
    inst.directory_owner.user as String, inst.repo_root as String,
    launcher_probe_worktree(instance: inst, unit_key: "roothook"), "/tmp/gunbc-roothook.out", "/tmp/gunbc-roothook.err",
    "65536", join(["+/usr/bin/touch ", launcher_root_hook_marker], ""),
    join(launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []), "\u{1f}"),
  ], "\n")
  launcher_marker_absent()
    && prepare_launcher_probe(instance: inst, unit_key: "roothook")
    && match attempt_system_unit_enqueue_request(
      instance_root: inst.instance_root as String,
      node_id: wet_probe_node as String,
      attempt_key: launcher_probe_key(unit_key: "roothook"),
      body: wide,
    ) {
      AttemptSystemUnitEnqueued { entry: _ } =>
        launcher_run_refused(instance: inst) && launcher_marker_absent()
      AttemptSystemUnitEnqueueOccupied { entry: _ } => false
      AttemptSystemUnitEnqueueRefused { detail: _ } => false
    }
}

fn launcher_run_refused(instance: HostDashboardInstance) -> Bool {
  match attempt_system_unit_launch_host_argv(instance: instance) {
    AttemptSystemUnitLaunchArgvRefused { cause: _ } => true
    AttemptSystemUnitLaunchArgvRevisionUnreadable => true
    AttemptSystemUnitLaunchArgvReady { argv } => {
      let cmd = attempt_system_unit_host_exec_from_launch_argv(argv: argv)
      shell.Exec.RunArgv(program: cmd.program, arguments: cmd.args).exit_code != 0
    }
  }
}

fn attempt_system_unit_spool_prepare(instance_root: String) -> Bool {
  fold(
    [
      attempt_unit_spool_staging_dir(instance_root: instance_root),
      attempt_unit_spool_request_dir(instance_root: instance_root),
      attempt_unit_spool_claimed_dir(instance_root: instance_root),
      attempt_unit_spool_answer_dir(instance_root: instance_root),
    ],
    init: true,
    f: (ok, dir) => ok && shell.Mkdir.Parents(path: dir as FilePath).success,
  ) && Filesystem.WriteCreateNew(
    path: attempt_unit_spool_drain_lock_path(instance_root: instance_root),
    content: "",
  ).success
}

fn wet_word_request(node_id: String, attempt_key: String, argv_word: String) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: node_id,
    attempt_key: attempt_key,
    granted: kibibyte(count: 1),
    inner_argv: [argv_word],
  }
}

test fn two_request_entries_keep_distinct_bodies() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-a", attempt_key: "k1", argv_word: "one")) {
        AttemptSystemUnitEnqueued { entry: a } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-b", attempt_key: "k1", argv_word: "two")) {
            AttemptSystemUnitEnqueued { entry: b } => {
              let ra = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: a)))
              let rb = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: b)))
              ra.success && rb.success && ra.content != rb.content && a != b
            }
            AttemptSystemUnitEnqueueOccupied { entry: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_second_request_for_the_same_attempt_is_occupied() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let request = wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x")
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
        AttemptSystemUnitEnqueued { entry: _ } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
            AttemptSystemUnitEnqueueOccupied { entry } =>
              entry == attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
            AttemptSystemUnitEnqueued { entry: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_claimed_entry_is_processed_once_across_two_claim_runs() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(
        instance_root: root,
        request: wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x"),
      ) {
        AttemptSystemUnitEnqueued { entry } =>
          match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
            AttemptSystemUnitClaimed { entry: _, path: _ } =>
              match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
                AttemptSystemUnitAlreadyClaimed { entry: again } => again == entry
                AttemptSystemUnitClaimed { entry: _, path: _ } => false
                AttemptSystemUnitClaimSymlink { entry: _ } => false
                AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
              }
            AttemptSystemUnitAlreadyClaimed { entry: _ } => false
            AttemptSystemUnitClaimSymlink { entry: _ } => false
            AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_symlinked_request_entry_is_refused_by_the_claim() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dest = attempt_system_unit_request_path(instance_root: root, entry: entry)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", dest]).exit_code == 0
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimSymlink { entry: got } => got == entry
        AttemptSystemUnitClaimed { entry: _, path: _ } => false
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

fn claimed_body_refused_after_plant(plant: fn(String) -> Bool, needle: String) -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dir = attempt_system_unit_request_path(instance_root: root, entry: entry)
    let body = attempt_system_unit_request_body_path(dir: dir)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Mkdir.NewOwnerOnly(path: dir as FilePath).success
      && plant(body)
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimed { entry: _, path } =>
          match attempt_system_unit_read_claimed_body(path: attempt_system_unit_request_body_path(dir: path)) {
            AttemptSystemUnitClaimedBodyRefused { reason } => string_contains(s: reason, pattern: needle)
            AttemptSystemUnitClaimedBodyRead { content: _ } => false
          }
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimSymlink { entry: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

test fn a_fifo_request_body_is_refused_without_reading() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "mkfifo", arguments: ["--", body]).exit_code == 0,
    needle: "fifo",
  )
}

test fn a_symlinked_request_body_is_refused_without_following() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/dev/zero", body]).exit_code == 0,
    needle: "symlink",
  )
}

fn wet_quoted_argv(words: List<String>) -> String {
  join(map(words, w => posix_single_quote(spelling: w)), " ")
}

fn wet_run_sh(script: String) -> Int {
  let cmd = posix_sh_program_command(script: script)
  shell.Exec.RunArgv(program: cmd.program.invocation as String, arguments: cmd.arguments).exit_code
}

fn wet_flocked_launch_cli_words(instance: HostDashboardInstance, spool_root: String, wait: Second) -> List<String> {
  match admit_named_argument(name: "instance_root", value: spool_root) {
    NamedArgumentNameEmpty => [] as List<String>
    NamedArgumentNameHoldsSeparator { name: _ } => [] as List<String>
    NamedArgumentAdmitted { argument: arg } =>
      flock_exclusive_wait_words(
        lock_path: attempt_unit_spool_drain_lock_path(instance_root: spool_root) as NonEmptyStr,
        wait: wait,
        conflict_exit_code: attempt_system_unit_launcher_busy_exit,
        command: map(
          concat(
            gunbc_entry_run_argv(
              workspace_root: instance.repo_root as NonEmptyStr,
              binary: instance.serve_binary as NonEmptyStr,
              source_roots: map(release_locus_tree_subdirs, sub => join([instance.repo_root as String, "/", sub], "") as NonEmptyStr),
              entry: join([instance.repo_root as String, "/", attempt_system_unit_launch_entry], "") as NonEmptyStr,
              function: attempt_system_unit_launch_function as NonEmptyStr,
            ),
            ["--arg" as NonEmptyStr, join([arg.name, "=", arg.value], "") as NonEmptyStr],
          ),
          w => w as String,
        ),
      )
  }
}

fn wet_answer_is_started_or_refused(reading: AttemptSystemUnitAnswerRead) -> Bool {
  match reading {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => true
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: _ } } => true
    AttemptSystemUnitAnswerMissing => false
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
  }
}

// TWO REAL DRAINS, NOT FLOCK-WAIT EXPIRY. The holder is the first gunbc launch_cli over this
// spool. The second wait is the production drain wait (belt_tick_run_bound), which outlasts
// that hold; a 30s waiter would expire while the first eval still held the lock.
// Discriminating RED: the same cell on aff3ea58ee9 (pre-flock) leaves a Missing answer.
test fn two_concurrent_launcher_runs_each_read_their_own_answer() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let inst = srv1_lab_dashboard_instance()
    let first = wet_flocked_launch_cli_words(instance: inst, spool_root: root, wait: second(count: 60))
    let second = wet_flocked_launch_cli_words(instance: inst, spool_root: root, wait: attempt_system_unit_launcher_flock_wait)
    if count(first) == 0 || count(second) == 0 {
      false
    } else {
      attempt_system_unit_spool_prepare(instance_root: root)
        && match attempt_system_unit_enqueue_start(
          instance_root: root,
          request: wet_word_request(node_id: "n-a", attempt_key: "k1", argv_word: "one"),
        ) {
          AttemptSystemUnitEnqueued { entry: a } =>
            match attempt_system_unit_enqueue_start(
              instance_root: root,
              request: wet_word_request(node_id: "n-b", attempt_key: "k1", argv_word: "two"),
            ) {
              AttemptSystemUnitEnqueued { entry: b } => {
                let script = join([
                  wet_quoted_argv(words: first),
                  " &\n/usr/bin/sleep 0.2\n",
                  wet_quoted_argv(words: second),
                  "\nwait\n",
                ], "")
                let _ = wet_run_sh(script: script)
                wet_answer_is_started_or_refused(
                    reading: attempt_system_unit_read_answer(instance_root: root, entry: a),
                  )
                  && wet_answer_is_started_or_refused(
                    reading: attempt_system_unit_read_answer(instance_root: root, entry: b),
                  )
              }
              AttemptSystemUnitEnqueueOccupied { entry: _ } => false
              AttemptSystemUnitEnqueueRefused { detail: _ } => false
            }
          AttemptSystemUnitEnqueueOccupied { entry: _ } => false
          AttemptSystemUnitEnqueueRefused { detail: _ } => false
        }
    }
  }
}

fn sandbox_worktree_commit_cli(worktree: String, git_dir: String) -> ProcessExit {
  let r = shell.Exec.RunArgv(
    program: "/usr/bin/git",
    arguments: [
      "--git-dir", git_dir, "--work-tree", worktree,
      "-c", "user.email=probe@gunbc.local", "-c", "user.name=probe",
      "commit", "--allow-empty", "-q", "-m", "worker-probe",
    ],
  )
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "worktree commit refused")
  }
}

fn prepare_launcher_linked_worktree(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  prepare_launcher_probe(instance: instance, unit_key: unit_key)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-rf", "--", wt]).exit_code == 0
    && shell.Exec.RunArgv(
      program: "git",
      arguments: ["-C", instance.repo_root as String, "worktree", "add", "--detach", "--", wt, "HEAD"],
    ).exit_code == 0
}

fn launcher_worktree_commit(instance: HostDashboardInstance, unit_key: String) -> SandboxTouch {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  let git_dir = dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: wt)
  match admit_named_argument(name: "worktree", value: wt) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: wt_arg } =>
      match admit_named_argument(name: "git_dir", value: git_dir) {
        NamedArgumentNameEmpty => SandboxTouchUnrunnable
        NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
        NamedArgumentAdmitted { argument: git_arg } =>
          launcher_inner_start(
            instance: instance,
            unit_key: unit_key,
            inner: launcher_gunbc_run_inner_argv(
              instance: instance,
              function: "sandbox_worktree_commit_cli",
              extra_args: [
                "--arg", join([wt_arg.name, "=", wt_arg.value], ""),
                "--arg", join([git_arg.name, "=", git_arg.value], ""),
              ],
            ),
          )
      }
  }
}

fn lab_instance_at_repo(root: FilePath) -> HostDashboardInstance {
  let lab = srv1_lab_dashboard_instance()
  HostDashboardInstance {
    deployment: lab.deployment,
    instance_id: lab.instance_id,
    host_identity: lab.host_identity,
    provision_parent_root: lab.provision_parent_root,
    instance_root: lab.instance_root,
    local_origin_root: lab.local_origin_root,
    local_origin_publish_ref: lab.local_origin_publish_ref,
    repo_root: root,
    dispatch_base_ref: lab.dispatch_base_ref,
    dispatch_state_scope: lab.dispatch_state_scope,
    execution_environment: lab.execution_environment,
    provider_state: lab.provider_state,
    serve_binary: lab.serve_binary,
    serve_function: lab.serve_function,
    listen_host: lab.listen_host,
    listen_port: lab.listen_port,
    tmux_server: lab.tmux_server,
    actuation: lab.actuation,
    provision_transport: lab.provision_transport,
    source_seed: lab.source_seed,
    admitted_revision: lab.admitted_revision,
    toolchain: lab.toolchain,
    dispatch_worker_memory_max: lab.dispatch_worker_memory_max,
    directory_owner: lab.directory_owner,
    worker: WorkerIsServiceUser,
    materialization_store_root: lab.materialization_store_root,
    publication_base_branch: lab.publication_base_branch,
  }
}

test fn writing_the_gitfile_or_commondir_inside_the_unit_fails_and_a_worktree_commit_succeeds() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let unit_key = "gitptr"
  let wt = launcher_probe_worktree(instance: inst, unit_key: unit_key)
  let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
  prepare_launcher_linked_worktree(instance: inst, unit_key: unit_key)
    && launcher_write_refused(instance: inst, unit_key: "gitfile", path: pointers.gitfile)
    && launcher_write_refused(instance: inst, unit_key: "commondir", path: pointers.commondir)
    && match launcher_worktree_commit(instance: inst, unit_key: unit_key) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code == 0
    }
}

test fn belt_commit_refuses_a_planted_commondir_without_running_git() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let repo = join([root, "/repo"], "")
    let wt = join([root, "/wt"], "")
    let inst = lab_instance_at_repo(root: repo as FilePath)
    let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
    let expected_git_dir = dispatch_attempt_private_git_dir(instance: inst, attempt_worktree: wt)
    shell.Mkdir.Parents(path: path_parent_directory(path: pointers.gitfile) as FilePath).success
      && shell.Mkdir.Parents(path: path_parent_directory(path: pointers.commondir) as FilePath).success
      && Filesystem.Write(path: pointers.gitfile, content: join(["gitdir: ", expected_git_dir, "\n"], "")).success
      && Filesystem.Write(path: pointers.commondir, content: "/tmp/gunbc-planted-commondir\n").success
      && match belt_commit_git(instance: inst, worktree: wt, args: ["status"]) {
        ExecRefused { program: _, reason } => string_contains(s: reason, pattern: "commondir")
        ExecOk { stdout: _ } => false
        ExecFailed { program: _, exit_code: _, stderr: _ } => false
      }
  }
}

test fn flock_wait_expiry_exits_the_conflict_code() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let lock = attempt_unit_spool_drain_lock_path(instance_root: root)
    let waiter = flock_exclusive_wait_words(
      lock_path: lock as NonEmptyStr,
      wait: second(count: 1),
      conflict_exit_code: attempt_system_unit_launcher_busy_exit,
      command: ["/usr/bin/true"],
    )
    attempt_system_unit_spool_prepare(instance_root: root)
      && wet_run_sh(script: join([
        posix_single_quote(spelling: flock_absolute_path as String),
        " --exclusive ",
        posix_single_quote(spelling: lock),
        " /usr/bin/sleep 3 &\n",
        "/usr/bin/sleep 0.2\n",
        wet_quoted_argv(words: waiter),
        "\nstatus=$?\nwait\nexit $status\n",
      ], "")) == attempt_system_unit_launcher_busy_exit
  }
}
