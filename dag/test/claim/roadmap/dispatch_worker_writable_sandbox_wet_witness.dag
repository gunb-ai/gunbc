data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wet_probe_node: RoadmapNodeId = "writable-probe" as RoadmapNodeId
data wet_probe_key: String = "wetprobe"

// WET: a real systemd-run --user transient with the worker unit's production properties, then one
// argv `touch -- <path>` per subject. Asserts the kernel REFUSES a forbidden write: the touch must
// have RUN and failed with the path absent afterwards (sandbox_touch_reading_of), in a unit shape
// whose allowed touch also runs (worker_shape_runs_an_allowed_touch). Two srv1 readings of this
// shape, both un-refused: (1) before the empty bounding set, kernel.apparmor_restrict_unprivileged_userns=1
// meant the user manager could not build the mount namespace and dropped ProtectSystem/ProtectHome/
// ReadWritePaths without error, so the write succeeded (bright-moth-475, issuecomment-6175000334);
// (2) with EmptyCapabilityBoundingSet in the properties (2026-10-21, systemd 255) the user manager
// fails exec setup, status 218 EXIT_CAPABILITIES, so the command NEVER RUNS: fail closed, and no
// evidence about the mount sandbox. That reading was once scored as a refused write; it is now
// SandboxTouchNeverRan and this claim is RED on it. Production does not launch workers this way:
// belt_actuate starts them as system-manager transients through attempt_system_unit_launch. This is
// the discriminating RED for gunbc.rung_drop.user_manager_worker_write_boundary_unenforced; do not
// invert this claim to expect success, and do not read its RED as "the write succeeded". Local
// recipe: claim_batch --wet --source-root dag
// --source-root src/v2 --entry dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag
// Requires a user systemd manager (srv1).

// ── EVERY CLAIM RUNS AGAINST A LAB ROW IT BUILT ITSELF (the #15627 supplied-root fixture) ──
//
// WHY NOT THE LIVE ROW. `srv1_lab_dashboard_instance()` is the deployment's own row: its
// provision parent, instance root, repo root, origin and serve binary ARE the lab's real
// install paths. A claim that binds it performs its effects on the host that serves the
// roadmap, and then its refusal readbacks prove nothing: the write the sandbox was supposed
// to refuse is a write the claim itself just made, in the one place it should never have
// touched. That is the RFM row `a_confinement_witness_whose_only_writable_root_is_the_live_host`,
// and this file was the open instance of it below the row's ceiling: ten bindings to the live
// row, two of them in claims that create directories.
//
// THE GUARD IS THE FIXTURE'S, NOT A RESTATEMENT OF IT. Both root arms run against the row's
// OWN writable list, and the row is compared against the live roots by name through
// `witness_supplied_roots_are_off_the_live_host`. The off-the-live-host arm is not optional
// dressing: a first guard that only re-checked the claim's own scratch leaf left two execution
// claims GREEN while nine installs wrote /opt/gunbc-lab, which is what commit 8cf8a03a7c5
// closed. An arm that merely restates `!witness_supplied_root_is_refused` over the writable
// list is worthless the same way (review 89877 finding 2) -- it is true of a live-root row too,
// because the live roots are IN the writable list. Only the fixture's arms name the live roots.
//
// THE PRINCIPAL IS HOST-SAID, NEVER MINTED. `useradd`, `groupadd` and `systemd-run` are all
// absent in this container (the host answers `uid=1000(node) gid=1000(node)`), so a fixture
// that created accounts would be RED on every host that cannot create them and GREEN only
// where someone pre-provisioned -- the reachability trap the RFM row files, re-opened. Host-said
// is also what gives the confinement readbacks their oracle: uid, gid, octal mode and the
// names `find -printf '%u %g'` prints are all compared against the host's own answer.
// THE ROOT THIS CLAIM OWNS: the host's own `mktemp -d`, under the fixture's prefix, with a
// per-claim tag so two claims in one batch can never share a tree. An empty answer is the
// refusal -- never a fallback to a fixed path, which is how a witness ends up writing the
// same directory on every host and calling the agreement evidence.
fn wet_claim_root(tag: NonEmptyStr) -> String {
  wet_out(
    command: mktemp_directory_command(
      template: join([witness_scratch_prefix as String, "/gunbc-sandbox-", tag, "-XXXXXX"], "") as NonEmptyStr,
    ),
  )
}

// THE HOST-SAID PRINCIPAL. Empty text or an unparseable uid/gid yields the fixture's unnameable
// sentinel (uid/gid -1), and every claim that takes a row refuses on it rather than proceeding:
// an unknown principal is exactly the state in which a confinement claim can be GREEN for no
// reason. No uid is ever minted, and uid 0 is refused by the fixture itself.
fn wet_principal() -> WitnessSuppliedPrincipal {
  match witness_principal_from_texts(
    uid_text: wet_out(command: witness_uid_command()),
    gid_text: wet_out(command: witness_gid_command()),
    user_text: wet_out(command: witness_effective_user_command()),
    group_text: wet_out(command: witness_group_name_command()),
  ) {
    Present { value: principal } => principal
    Absent => witness_unnameable_principal()
  }
}

// THE ROW, GUARDED BEFORE ANY CLAIM SEES IT. The off-the-live-host arm runs against the row the
// fixture would actually hand back, so a row that resolves into the lab is refused rather than
// returned for a claim to walk into.
fn wet_supplied_lab_instance(scratch_parent: String) -> HostDashboardInstance {
  let repo = join([scratch_parent, "/source"], "")
  let principal = wet_principal()
  if scratch_parent == "" || principal.uid < 0 || principal.gid < 0 {
    witness_refused_instance(repo: repo as FilePath)
  } else {
    let candidate = witness_supplied_instance(
      scratch_parent: scratch_parent as FilePath,
      repo: repo as FilePath,
      principal: principal,
    )
    if witness_supplied_root_is_refused(candidate: scratch_parent)
      || witness_supplied_root_is_refused(candidate: repo)
      || !witness_supplied_roots_are_off_the_live_host(instance: candidate)
      || !witness_supplied_credential_is_confined(scratch_parent: scratch_parent, instance: candidate) {
      witness_refused_instance(repo: repo as FilePath)
    } else {
      candidate
    }
  }
}

// THE CONFINEMENT READBACK, ASSERTED INSIDE THE CLAIM AND NOT ONLY GUARDED IN THE BUILDER.
//
// Guarding is not enough to make this file falsifiable. Most claims here are root-independent in
// their LOGIC -- a refusal is a refusal whichever directory the path names -- so a mutant that
// binds `srv1_lab_dashboard_instance()` again and bypasses the guarded builder would stay GREEN
// on the guard alone. This conjunct is what makes that revert RED: every field the claim can
// write through is re-derived from the row it was actually handed and must sit under the root
// the claim itself created. It is also what makes a deleted derivation RED: replace an accessor
// over `inst` with a literal path and the containment check no longer describes the row.
fn wet_claim_is_confined(instance: HostDashboardInstance, root: String) -> Bool {
  root != ""
    && witness_supplied_roots_are_off_the_live_host(instance: instance)
    && is_under(text: instance.provision_parent_root as String, root: root)
    && is_under(text: instance.instance_root as String, root: root)
    && is_under(text: instance.local_origin_root as String, root: root)
    && is_under(text: instance.repo_root as String, root: root)
    && is_under(text: instance.serve_binary as String, root: root)
}

// THE GUEST'S READ INPUTS, PLANTED INSIDE THE CLAIM'S ROOT.
//
// The launcher legs exec `serve_binary run --source-root <repo>/dag --source-root <repo>/src/v2
// --entry <repo>/dag/...` -- every one of those paths is derived from the supplied row, so under
// a supplied root none of them exist yet and the leg would go RED for a reason that has nothing
// to do with confinement (the guest cannot find its entry). Nothing on main establishes whether
// a worker unit may read an operator checkout -- ProtectHome enforcement is an unobserved
// per-host obligation (`gunbc.host.host_software_surface`
// user_manager_protect_home_enforcement_read_obligation) -- so reading the checkout in place
// would make the leg depend on an unread host fact. The tree is copied in instead, from sources
// the HOST reports: `pwd` for the checkout that holds this witness and `command -v` for one
// executable to serve as the instance binary. Both are asserted present, so a host that cannot
// supply them is RED rather than vacuously GREEN; nothing here is minted. Only the copies are
// written -- the checkout and the binary are read, never touched, which is what keeps this
// inside the rule the whole file exists for.
//
// The copy is the WHOLE `dag/` and `src/v2/` tree, not the entry's import closure: the closure is
// not derivable from inside a claim (no claim-side module resolver is exposed), and a partial
// plant that missed one transitive import would fail as a confusing guest-side error. Recorded
// in the PR body for the same reason.
fn wet_plant_guest_sources(instance: HostDashboardInstance) -> Bool {
  let checkout = wet_out(command: pwd_command())
  let repo = instance.repo_root as String
  // THE CHECKOUT IS HOST-SAID, NOT ASSUMED. `pwd` is the batch's own working directory as the
  // host reports it; an empty reading refuses the plant rather than copying a guessed path.
  checkout != ""
    // `repo` itself has to exist before the copy can put a tree in it -- the first attempt missed
    // this and the copy refused on a missing parent, which is the difference between a plant and
    // an intention. The copy is the fleet's OWN route, `shell.Copy.Recursive` (extdeps/shell.dag,
    // transport shell { argv: ["cp", "-r", "{source}", "{destination}"] }); a `-r` argv tail
    // beside it was a fork and is deleted (review 90943, the same defect the printenv rows had).
    // WHAT THAT argv BUYS, measured on coreutils 9.7: `-r` with NEITHER `-H` nor `-L` copies each
    // symbolic link in the source as a LINK, so a tree holding a relative link and a dangling one
    // comes back with both still `symbolic link` under `stat -c %F`, where `-rL` turns the first into
    // a copied directory and fails outright on the second ("cannot stat ...: No such file or
    // directory"). The plant therefore cannot be used to pull the target of a link into the root it is
    // planting into: links arrive inert, and the guest reads only what it actually opens.
    && wet_ok(command: mkdir_parents_command(path: repo))
    && shell.Copy.Recursive(
      source: join([checkout, "/dag"], "") as FilePath,
      destination: join([repo, "/dag"], "") as FilePath,
    ).success
    && wet_ok(command: mkdir_parents_command(path: join([repo, "/src"], "")))
    && shell.Copy.Recursive(
      source: join([checkout, "/src/v2"], "") as FilePath,
      destination: join([repo, "/src/v2"], "") as FilePath,
    ).success
    // THE MANIFEST IS PART OF THE TREE A GUEST CAN RUN FROM. The CLI keys its module graph by a path
    // RELATIVE to a workspace root and finds that root by walking up from its starting directory
    // looking for `Cargo.toml` beside `dag/` (cli_run.rs `resolve_process_workspace_root`; it refuses
    // rather than keying indices against a guessed base). Measured 2026-11-05 with the real CLI
    // against a plant that copied only dag/ and src/v2: the served probe answered "error: no
    // workspace root: none of the current directory <root>/source's ancestors is a git checkout
    // carrying Cargo.toml beside dag/" and exit 2 -- the guest could not run at all, which is the
    // fixture's defect and not a sandbox verdict. A plant that cannot be run from is not a plant, so
    // the manifest the real attempt worktree carries goes in too, before the repository is made.
    && shell.Copy.Recursive(
      source: join([checkout, "/Cargo.toml"], "") as FilePath,
      destination: join([repo, "/Cargo.toml"], "") as FilePath,
    ).success
    && wet_make_source_repository(instance: instance)
}

// THE SOURCE IS A REPOSITORY, NOT A DIRECTORY WITH FILES IN IT. srv2 (stern, 2026-11-04) measured
// `git -C <root>/source worktree add --detach` dying 128 with "not a git repository": copying dag/ and
// src/v2 in reproduces the WORKING TREE of the checkout and nothing of its object database, so every
// leg that takes a worktree, commits, or reads a gitfile was failing at git's first syscall instead of
// at the confinement boundary. `git` is host-said (extdeps.git's git_program, one argv word at a time,
// no PATH guessing and no shell string) and the commit identity is the host-said principal, so the
// plant does not invent an author either. The control claim
// the_supplied_source_is_a_real_repository reads the result back through git itself.
fn wet_make_source_repository(instance: HostDashboardInstance) -> Bool {
  let principal = wet_principal()
  let repo = instance.repo_root as String
  wet_ok(command: git_init_quiet_command(repository_dir: repo))
    && wet_ok(command: git_add_all_force_command(repository_dir: repo))
    && wet_ok(command: git_commit_snapshot_command(
      repository_dir: repo,
      identity_name: principal.user as String,
      identity_email: join([principal.user as String, "@wet-witness.invalid"], ""),
      message: "wet witness: supplied source plant" as NonEmptyStr,
    ))
}

// THE SERVED BINARY IS THE ONE THE OPERATOR NAMED, OR THE LEG REFUSES. There is no honest way for
// a claim to name the running image by itself: `/proc/self/exe` resolves against the process that
// OPENS it, so an `install -m 0755 /proc/self/exe <dst>` copies `/usr/bin/install`, not the guest
// -- a planted binary of the wrong identity would make every launcher leg refuse for a reason that
// has nothing to do with confinement. So the path comes from the environment through the fleet's
// one modeled read (`shell.Env.Get`, which realizes as `printenv {name}` with no shell expansion
// of anything we build), and BOTH readings are required before anything is written: the name is
// non-empty, and what it names is executable to the host-said principal. Unset or non-executable
// refuses the leg; nothing here mints a binary, and no host is required to have a `gunbc` on PATH.
fn wet_plant_guest_binary(instance: HostDashboardInstance) -> Bool {
  // The name is ELIMINATED, not cast: `shell.Env.Get` answers `value: String?` because the
// variable may be unset, and the absence is read in a match rather than re-typed away (the trap
// extdeps/shell/credentials.dag records for `as Secret`, where an unset variable became a
// plausible-looking value). An unset variable therefore reaches `named == ""` and the leg refuses,
// exactly as it refuses a name that does not name an executable -- a host where nobody
// provisioned the input is RED, never green-by-default.
  let named = wet_environment_value(name: wet_served_binary_env_var)
  named != ""
    && wet_path_is_executable(path: named)
    && wet_ok(command: mkdir_parents_command(path: path_parent_directory(path: instance.serve_binary as String)))
    && wet_ok(command: install_file_mode_command(
      source: named,
      destination: instance.serve_binary as String,
      mode: "0755" as NonEmptyStr,
    ))
}

data wet_served_binary_env_var: NonEmptyStr = "GUNBC_WET_SERVE_BINARY"

// One modeled read of one variable, so the leg's host-facing read is the operation the fleet
// already has. Absent means unset: the caller's `!= ""` is the refusal, and nothing here mints a
// value the host did not answer.
fn wet_environment_value(name: NonEmptyStr) -> String {
  match shell.Env.Get(name: name).value {
    Absent => ""
    Present { value: read } => read
  }
}

fn wet_plant_guest_runtime(instance: HostDashboardInstance) -> Bool {
  wet_plant_guest_sources(instance: instance) && wet_plant_guest_binary(instance: instance)
}

// WHETHER THE CLAIM HAS A LOCUS TO RUN THE IMAGE FROM, and if not, why. srv2's S1 at `114bcf31` lost
// nine legs to a `false` with no cause anywhere: the drain ran against the copied source tree and the
// CLI refused it for want of `.gunbc-tree-receipt`, but the claim could only say it had failed. The
// refusal text is what makes this class readable from one log line, and the reason it is a value and
// not a `wet_stage` side effect is that three different arms have to branch on it.
type WetLocusState
  = WetLocusReady { revision: String, dir: String }
  | WetLocusRefused { cause: String }

// PREPARE THE LOCUS THE DRAIN AND THE PROBE RUN FROM: stage the operator-named image where production's
// install fold reads binaries, read the guest tree's own revision out of git, and hand both to the fold
// (the fixture's `witness_locus_install`, which refuses rather than fabricating when either is missing).
// Every leg that asks the image to serve anything calls this first: on a host with the elevation the
// fold needs it converges, and on a host without it the leg refuses with `witness_sudo_elevation_available`'s
// answer as the cause, which is a refusal with a reason and not a pass.
fn wet_locus_prepare(instance: HostDashboardInstance) -> WetLocusState {
  let named = wet_environment_value(name: wet_served_binary_env_var)
  if named == "" {
    WetLocusRefused {
      cause: "GUNBC_WET_SERVE_BINARY is unset, so there is no image to stage into a locus",
    }
  } else if !witness_stage_release_binary(instance: instance, image: named) {
    WetLocusRefused {
      cause: join(["the release stage could not be written at ", witness_release_stage_member(instance: instance)], ""),
    }
  } else {
    let revision = witness_guest_tree_revision(instance: instance)
    let verdict = witness_locus_install(instance: instance, revision_text: revision)
    if !witness_locus_install_converged(verdict: verdict) {
      WetLocusRefused { cause: witness_locus_install_refusal_cause(verdict: verdict) }
    } else if !wet_locus_reads_as_installed(instance: instance, revision_text: revision) {
      // The fold said it converged; the filesystem still gets the last word, because the question the
      // drain will be asked is the filesystem's, not the fold's.
      WetLocusRefused {
        cause: join(
          [
            "the install fold converged but the locus does not read as one: ",
            witness_locus_receipt_path(instance: instance, revision_text: revision),
            " or the locus dag dir is absent",
          ],
          "",
        ),
      }
    } else {
      WetLocusReady {
        revision: revision,
        dir: witness_locus_dir_text(instance: instance, revision_text: revision),
      }
    }
  }
}

// THE TWO QUESTIONS THE READER WILL ASK, ASKED HERE FIRST (src/v1/stage0/src/cli_run.rs:611 wants a
// `dag` directory and a regular receipt file, and the drain execs the member by name). Asking before the
// drain runs is what keeps a half-installed locus from becoming a 245-second leg whose failure says
// nothing about why.
fn wet_locus_reads_as_installed(instance: HostDashboardInstance, revision_text: String) -> Bool {
  wet_path_exists(path: witness_locus_dag_dir(instance: instance, revision_text: revision_text))
    && wet_path_exists(path: witness_locus_receipt_path(instance: instance, revision_text: revision_text))
    && wet_path_is_executable(path: witness_locus_binary_path(instance: instance, revision_text: revision_text))
}

// THE GATE, WITH ITS STAGE NAME. One call per leg records whether the locus converged or which arm
// refused, so a run log names the arm instead of leaving it to be inferred from the leg that failed;
// the value handed back is the revision, which is all a leg needs since every locus path is an accessor
// over it. `Absent` means do not proceed: the same `false` the legs already carried, with the cause
// written down before the leg stops.
fn wet_locus_gate(instance: HostDashboardInstance, label: String) -> Optional<String> {
  match wet_locus_prepare(instance: instance) {
    WetLocusReady { revision: revision, dir: _ } =>
      if wet_stage(stage: join(["claim-locus-installed:", label], ""), ok: true) {
        Present { value: revision }
      } else {
        Absent
      }
    WetLocusRefused { cause: cause } =>
      if wet_stage(stage: join(["claim-locus-refused:", label, ":", cause], ""), ok: false) {
        Present { value: "" }
      } else {
        Absent
      }
  }
}

// THE IMAGE HAS TO ANSWER, NOT JUST EXIST. srv2 (stern, 2026-11-04, at 15be89fa and again at
// fa64a4b9) planted the BATCH RUNNER as the instance gunbc -- `GUNBC_WET_SERVE_BINARY` was pointed at
// claim_batch -- and all nine root-launch legs died inside the drain on `claim_batch: unknown
// argument: run`, with no sandbox conjunct ever reached, while the claim that was supposed to notice
// (the served-binary readback) went GREEN because it only ever asked the planted file for its mode.
// A mode of 0755 and an executable bit say nothing about whether the image can serve a `.dag`
// function, which is the one thing the launch legs depend on. So the image is now asked, through the
// same `run --entry … --function …` route the launch legs use, to answer twice over a module with two
// bodies: the succeeding one must answer as success and the refusing one must answer as failure, AND
// carry the refusal text its own body contains. An image that is not the CLI cannot produce both
// readings, and an image that always exits zero cannot produce the second. The exit code alone is not
// the oracle: the batch runner's "unknown argument" comes back with a status that depends on its own
// argument parser, so the pairing of the two readings plus the body's own words is what discriminates.
// `RunArgvOutcome`, not `RunArgv`, so an image that cannot even be spawned is a value this claim
// answers (extdeps.transports.shell ShellSpawnRefused) instead of an aborted evaluation that would
// skip the claim's own cleanup -- gunbc.recurring_failure_mode
// an_unspawnable_program_aborts_the_run_instead_of_refusing names that route gap.
data wet_served_probe_module_relative: NonEmptyStr = "dag/test/claim/roadmap/witness_served_probe.dag"
data wet_served_probe_success_fn: NonEmptyStr = "served_probe_succeeds"
data wet_served_probe_refusal_fn: NonEmptyStr = "served_probe_refuses"
data wet_served_probe_refusal_marker: NonEmptyStr = "served probe refuses by design"

// TRUE ONLY IF THE PLANTED IMAGE SERVES THE ROUTE, BOTH WAYS ROUND.
// THE CLAIM-LEVEL FORM OF THE SAME ASK: install the claim's locus, then put the drain's question to the
// image UNDER THAT LOCUS. Used by the served-image claim itself and by the launcher legs, which reach a
// manager through `attempt_system_unit_enqueue_start_wait` rather than through `wet_worker_unit_start`
// and so would otherwise never be asked at all. A refusal here means the claim has no route to speak of
// -- a red verdict, not a skip, because the route is what these claims are about.
fn wet_served_image_answers_under_locus(instance: HostDashboardInstance) -> Bool {
  let revision_text = wet_locus_gate_text(instance: instance, label: "served-image")
  revision_text != "" && wet_served_image_answers_the_route(instance: instance, revision_text: revision_text)
}

fn wet_served_image_answers_the_route(instance: HostDashboardInstance, revision_text: String) -> Bool {
  // THE DIRECTORY IS PART OF THE ROUTE. The CLI keys its module graph by a path RELATIVE to its
  // process workspace root and refuses -- by panic, exit 101 -- an entry outside it
  // (cli_run.rs `repo_relative_path_normalized`: "path ... is not under process workspace root").
  // Measured on srv2 (stern, 2026-11-05) when this probe first ran the planted image from the
  // batch's own directory: both probe children panicked 101 and the claim read the panic as "the
  // image cannot serve", which is a fixture bug, not a verdict. Production's inner side never sees
  // this because the unit starts in the plan's WorkingDirectory, and for this provider shape
  // `dispatch_pane_working_directory` (gunbc.roadmap.dispatch_worker_unit_confinement) answers
  // `instance.repo_root` -- the same directory the gate asserts is under the claim root. So the
  // probe starts there too, through coreutils `env -C`, the fleet's own idiom for "run this in that
  // directory" (`shell.Find.Files` spells `env -C {workdir} find ...`). A missing directory answers
  // 125 with env's own message; nothing here fabricates a working directory.
  let ok_run = shell.Exec.RunArgvOutcome(
    program: wet_served_probe_env_program,
    arguments: wet_served_probe_argv(instance: instance, revision_text: revision_text, function: wet_served_probe_success_fn),
  )
  let refuse_run = shell.Exec.RunArgvOutcome(
    program: wet_served_probe_env_program,
    arguments: wet_served_probe_argv(instance: instance, revision_text: revision_text, function: wet_served_probe_refusal_fn),
  )
  match ok_run.outcome {
    ShellSpawnRefused { program: _, cause: _ } => false
    ShellExited =>
      match refuse_run.outcome {
        ShellSpawnRefused { program: _, cause: _ } => false
        ShellExited =>
          ok_run.exit_code == 0
            && refuse_run.exit_code != 0
            && string_contains(s: refuse_run.stderr, pattern: wet_served_probe_refusal_marker as String)
      }
  }
}

data wet_served_probe_env_program: NonEmptyStr = "/usr/bin/env"

// `env -C <the directory the unit would start in> <serve_binary> run ...` -- the inner argv of
// `launcher_gunbc_run_inner_argv` (same words, same starting directory), executed here instead of
// inside a unit because this is the pre-launch read: the claim asks the IMAGE before it asks a
// manager. The words stay in `wet_served_run_tail`, so the probe and the unit's ExecStart cannot
// drift apart.
// THE PROBE'S WORDS: the drain's, run as the claim's own principal. `-C <repo_root>` first (the
// WorkingDirectory systemd gives the unit's side), then `wet_image_serve_argv` verbatim -- so the env
// prefix `GUNBC_WORKSPACE_ROOT=<locus>`, the locus member as the program, both locus `--source-root`
// values and the locus-copied entry are the SAME words the drain elevates. srv2's S1 at 114bcf31 passed
// `the_planted_serve_binary_is_the_image_the_operator_named` while every leg serving through the image
// died, because the probe ran from the source cwd without the env the units serve under: an image that
// could not serve a locus looked fine. Sharing one builder is what makes that impossible now.
fn wet_served_probe_argv(instance: HostDashboardInstance, revision_text: String, function: NonEmptyStr) -> List<String> {
  concat(
    ["-C", instance.repo_root as String],
    map(
      wet_image_serve_argv(
        instance: instance,
        revision_text: revision_text,
        entry_relative: wet_served_probe_module_relative,
        function: function,
      ),
      word => word as String,
    ),
  )
}


// THE TREE A REFUSAL LEG NEEDS BEFORE IT CAN MEAN ANYTHING. A refusal leg whose parent
// directory does not exist is not a confinement result at all: `touch` in a missing directory
// fails with ENOENT for a reason the sandbox had nothing to do with, and the claim goes GREEN
// about nothing -- the exact shape this RFM row exists to catch. So the directories the claims
// here name as confined are created, and the file one of them names is planted, all of them
// under the claim's own root and owned by the host-said principal. The unsandboxed control leg
// inside `sandbox_touch_write_refused` then answers the prior question -- if the principal can
// write there OUTSIDE the sandbox, the refusal INSIDE it is the sandbox's doing and nothing
// else's. Every path here is an accessor over the row, never a restated literal, so deleting
// the derivation takes the claim red instead of leaving it standing on a guess.
fn wet_plant_confined_tree(instance: HostDashboardInstance) -> Bool {
  let principal = wet_principal()
  let repo = instance.repo_root as String
  wet_ok(command: mkdir_parents_command(path: path_parent_directory(path: instance.serve_binary as String)))
    && wet_ok(
      command: install_empty_file_command(
        path: instance.serve_binary as String,
        octal_mode: "0755" as NonEmptyStr,
        uid: principal.uid,
        gid: principal.gid,
      ),
    )
    && wet_ok(command: mkdir_parents_command(path: repo))
    // THE TREE IS A REPOSITORY, NOT A DIRECTORY NAMED .git. srv2's fifth S1 (stern, 2026-11-05) and
    // the local re-run at 74683828 both showed what the hand-made .git/hooks + .git/objects meant:
    // any leg that LAUNCHES now has to name the tree's commit (the locus is named by revision, and
    // the inner side's CLI walks to the .git ancestor), and `git rev-parse --verify HEAD` answered
    // `fatal: not a git repository` -- so those legs refused with 'the plant's git add/commit did
    // not land' while the claims that plant through wet_plant_guest_sources went green. Same tree,
    // two answers, because two routes prepared it. One route now: the production commit sequence
    // (git init -q, git add -A -f, git commit with the host-said principal's identity and
    // --allow-empty), which creates hooks/ and objects/ itself.
    //
    // AND IT IS THE SAME ROUTE THE OTHER LEGS USE, NOT A SHORTER SIBLING OF IT. srv2's S1 at
    // 4ffbdfcc (stern) showed the half-repair: delegating to the commit sequence left this route
    // making an EMPTY repository, while `wet_plant_guest_sources` -- which copies `dag/` and
    // `src/v2/` out of the runner's own checkout and THEN commits -- was the route the other eight
    // legs used. So the two legs that plant only here (`writes_to_the_deployed_binary_and_tree_fail_
    // inside_the_worker_sandbox`, `the_worker_worktree_is_writable_inside_the_same_sandbox`) were
    // asserting over `<root>/source/dag` -- through `find`, and through the `--source-root` the inner
    // argv is built with -- a path this claim had never created: `find: .../source/dag: No such file
    // or directory`, exit 1, and the worker control probe never written. A leg must not assert over
    // a tree it did not populate, and a second, thinner plant route is how that stays invisible: the
    // legs that use it go red on a fixture gap while the legs that do not go green. Delegating here
    // removes the thinner route instead of teaching the two legs to call both.
    && wet_plant_guest_sources(instance: instance)
    && wet_plant_unit_credential(instance: instance)
}

// THE CREDENTIAL FILE A SUPPLIED UNIT COULD BE HANDED, IF IT IS EVER HANDED ONE. It is installed
// beside the instance the witness supplied, at witness_supplied_credential_source, and NEVER at
// dispatch_worker_credstore_path's answer for the lab row -- that one is
// /etc/credstore/<identifier>-<instance id>, a live root, and reading it is what exited srv2's units
// 243 (CREDENTIALS) before any claim command ran. Mode 0400 because a credential is not world-readable
// anywhere, including in a witness.
fn wet_plant_unit_credential(instance: HostDashboardInstance) -> Bool {
  let principal = wet_principal()
  wet_ok(command: mkdir_parents_command(path: witness_supplied_credstore_dir(instance: instance)))
    && wet_ok(command: install_empty_file_command(
      path: witness_supplied_credential_source(instance: instance, file: operator_route_credential_file) as String,
      octal_mode: "0400" as NonEmptyStr,
      uid: principal.uid,
      gid: principal.gid,
    ))
}

// THE WAY OUT: the claim's own root is removed, and the removal is ANDed into the claim, so a
// claim that leaves its tree behind is RED rather than tidy.
fn wet_clean_claim_root(root: String) -> Bool {
  root != ""
    && (wet_ok(command: rm_recursive_force_command(path: root))
      // ONE RETRY, AFTER A BEAT. On the srv2 run of 54f3b519 `rm -rf <root>/source/.git` reported
      // "Directory not empty" while a git child of the claim was still closing its tree. The verdict
      // is reported apart from cleanup (see the plant claim); the retry is here so leftover scratch
      // under the fixture's own prefix does not accumulate when the only fault was timing.
      || (wet_settle() && wet_ok(command: rm_recursive_force_command(path: root))))
}

// ONE BEAT, ONE ROUTE. `sleep 1` through shell.Exec.RunArgv, the same way this witness already waits,
// declared once because two clean-up sites need the same beat: the retry after an `rm` that failed on
// a directory a git child was still closing (stern, srv2 54f3b519 and fa64a4b9, `…/source/.git:
// Directory not empty`), and the retry before the final readback of the claim root. No new extdeps
// row: this witness names its host verbs to RunArgv, whose program is a caller-named word by design
// (extdeps/shell/exec.dag), which is also why no caller roster is touched.
fn wet_settle() -> Bool {
  shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"]).exit_code == 0
}

// THE SPOOL TREE THE ROW DERIVES, CREATED BEFORE ANY LEG MAY NAME IT. The drain writes each request
// as <instance_root>/attempt-unit-spool/requests-staging/<key>.staging. On srv2 (stern, 2026-11-04)
// the unit's own `mkdir -m 00700 .../requests-staging/<key>.staging` returned ENOENT and six launch
// legs died before asserting anything: the live lab root arrives with that tree already provisioned by
// the operator, so a supplied root that skips provisioning turns a confinement claim into a
// filesystem accident -- the same vacuity this file's plant comment refuses elsewhere. Every directory
// is one of gunbc.host.host_layout's accessors over the row's own instance_root, never a restated
// literal, so deleting a derivation takes the claim red instead of leaving it standing on a guess; the
// 0700 is what the drain asks for when it creates the staging leaf itself.
fn wet_attempt_unit_spool_dirs(instance_root: String) -> List<String> {
  [
    attempt_unit_spool_root(instance_root: instance_root),
    attempt_unit_spool_request_dir(instance_root: instance_root),
    attempt_unit_spool_staging_dir(instance_root: instance_root),
    attempt_unit_spool_claimed_dir(instance_root: instance_root),
    attempt_unit_spool_answer_dir(instance_root: instance_root),
  ]
}

fn wet_prepare_attempt_unit_spool(instance: HostDashboardInstance) -> Bool {
  wet_prepare_attempt_unit_spool_at(instance_root: instance.instance_root as String)
}

// THE SPOOL TREE AT A RAW `instance_root`. The row-taking entry above delegates here, so there is still
// one route and one mode; the split exists because a claim that tests the answer CHANNEL (the wait's own
// discriminator) must be able to build a spool without minting a whole supplied row to get one -- and a
// claim that mints a row to test a channel cannot tell a channel fault from a row fault.
fn wet_prepare_attempt_unit_spool_at(instance_root: String) -> Bool {
  // install -d in ONE step with the final mode and ownership, over the same builder the production
  // attempt-exit spool uses (roadmap_attempt_exit_spool:149) and the same declared mode the drain's own
  // `mkdir -m 00700` means: DirectoryOwnerOnly. Owner and group are the INVOKING principal's own names,
  // read from the host, which is the one spelling install(1) accepts without privilege.
  let principal = wet_principal()
  fold(
    wet_attempt_unit_spool_dirs(instance_root: instance_root),
    init: true,
    f: (ok, dir) =>
      ok
        && wet_ok(command: install_directory_owned_argv_command(
             mode: declared_directory_mode(m: DirectoryOwnerOnly),
             owner: principal.user,
             group: principal.group,
             path: dir,
           )),
  )
}

fn prepare_probe_attempt(instance: HostDashboardInstance) -> Bool {
  let preps = attempt_state_prepare_argvs_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: wet_probe_key,
  )
  let wt = probe_attempt_worktree(instance: instance)
  fold(preps, init: true, f: (ok, p) => ok && shell.Exec.RunArgv(program: p.program, arguments: p.args).exit_code == 0)
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", wt]).exit_code == 0
    && wet_prepare_attempt_unit_spool(instance: instance)
}

fn probe_attempt_dir(instance: HostDashboardInstance) -> String {
  attempt_state_directory_text(instance: instance, node_id: wet_probe_node, attempt_key: wet_probe_key, directory: AttemptDirectoryRoot)
}

fn probe_worker_dir(instance: HostDashboardInstance) -> String {
  path_parent_directory(path: attempt_log_member_text(instance: instance, node_id: wet_probe_node, attempt_key: wet_probe_key, member: AttemptWorkerLog))
}

fn probe_attempt_worktree(instance: HostDashboardInstance) -> String {
  join([dashboard_instance_dispatch_worktree_root(instance: instance) as String, "/", wet_probe_key], "")
}

// THE PRODUCTION LAUNCH ROUTE, INHABITED — manager ruling of 2026-11-04, after the srv2 run of
// 54f3b519 (~/build/run15794e.log). Every unit this witness starts is now started the way
// production starts it: the facts of a start request are derived by
// attempt_system_unit_start_facts_for_request, admitted by attempt_system_unit_start_admitted
// (production's own guard: User= must equal dashboard_instance_worker_user), shaped into a
// DispatchWorkerUnitPlan by attempt_system_unit_plan_from_facts, and projected to an argv by
// attempt_system_unit_systemd_run_command. That builder's option head carries NO RunUserManager arm,
// so it targets the DEFAULT (system) manager — which is what production does, and what
// extdeps/systemd/systemd_run.dag:305-317 records ("These builders carry no RunUserManager arm: they
// target the DEFAULT (system) manager"), together with the dissolution row
// systemd_run_manager_side_claim_gap, which records that no REQUIRED automated claim covers that
// population. This witness previously launched through systemd_run_user_wait_command
// (`systemctl --user run`), a manager production never uses for this unit; on systemd 255 that route
// exited status 218 (EXIT_CAPABILITIES) with this property set. 218 is an observation about the USER
// manager and these properties — not a production defect — and no claim here depends on it any more.
//
// ELEVATION. Production reaches the system manager because its root side is a root process: the
// attempt-unit drain .service runs as root and its ExecStart is attempt_system_unit_launch_cli
// (gunbc/live_deploy/emit.dag:956). A witness process is not root, so the claim performs that root
// side with the host's own sudo through extdeps.sudo.elevation's sudo_elevate_command — the module
// whose own comment says "ELEVATION IS PART OF THE OPERATION". Elevation is admitted only where the
// host SAYS `sudo -n true` exits 0; on any other host the claim REFUSES with a named cause and is
// never green (manager ruling: "elsewhere the claim refuses as 'needs a root launcher', never green").
//
// WHO THE UNIT RUNS AS. The fixture's supplied row is WorkerIsServiceUser, so
// dashboard_instance_worker_user resolves to instance.directory_owner.user, which the fixture sets
// from the host-said principal: a root process creates the unit, the worker process still runs as the
// invoking user, and the confinement population established is the SERVICE-USER shape. The
// dedicated-account shape (LoadCredential=, UMask=0002, safe.directory, the gunbc-worker identity) is
// declared uncovered in the RFM row a_confinement_witness_whose_only_writable_root_is_the_live_host,
// with its restoration trigger, rather than being silently skipped.
type WetRootLaunch
  = WetRootLaunchRan { exit_code: Int }
  | WetRootLaunchRefused { cause: String }

// Report a stage AND pass the value through, so a diagnostic can never become a verdict of its own.
fn wet_stage_of<T>(stage: String, ok: Bool, value: T) -> T {
  let _ = wet_stage(stage: stage, ok: ok)
  value
}

// HOST-SUDO AVAILABILITY, read from the host. The elevated legs are gated on this so a host with no
// passwordless root path can never turn a unit that was never started into a green claim.
fn wet_root_launcher_is_available() -> Bool {
  let probe = sudo_elevate_command(command: ["/usr/bin/true"])
  // THE OUTCOME, NOT THE EXIT CODE. shell.Exec.RunArgv RAISES when the program cannot be spawned, and
  // a raised claim neither refuses with a cause nor reaches its own cleanup -- srv2 was left holding
  // /tmp/gunbc-sandbox-* trees by exactly that shape (the unsandboxed control raised out of a missing
  // systemd-run at 5a4dd7e3). A host with no sudo is the manager's "needs a root launcher" REFUSAL, so
  // the typed outcome is what this reads: no process, no answer, refusal -- never an error.
  let read = shell.Exec.RunArgvOutcome(program: probe.program.invocation as String, arguments: probe.arguments)
  match read.outcome {
    ShellSpawnRefused { program: _, cause: _ } => false
    ShellExited => read.exit_code == 0
  }
}

// WHICH CONJUNCT FAILED, recorded where a CI log can show it. A claim that returns only `false` is
// unreadable from a terminal: on srv2 four launcher legs took ~245 s each and then reported
// `test -e ... exit 1`, which reads as a sandbox verdict when what happened was that no answer ever
// arrived. Each conjunct now names its own stage through a child process, so the log distinguishes
// no-exit-observed from sudo-allowed from write-landed.
// THE TRAIL IS A FILE, NOT STDOUT. shell.Exec.RunArgv CAPTURES the child's stdout (that is how wet_out
// reads a command's answer), so a printf from inside a claim reaches nowhere a human sees -- which is
// exactly how srv2 run 15794e lost four launcher legs to an unreadable `test -e ... exit 1`. So the
// trail is appended, one line per stage, to a fixture-prefixed file the runner cats after the batch:
// `grep FAILED /tmp/gunbc-sandbox-witness-stages.log` names the conjunct that failed. Stage strings carry
// the claim's own labels (unit_key, entry name), which is what makes the shared file readable.
data wet_stage_trail: NonEmptyStr = "/tmp/gunbc-sandbox-witness-stages.log" as NonEmptyStr

fn wet_stage(stage: String, ok: Bool) -> Bool {
  let note = join([stage, if ok { " ok" } else { " FAILED" }], "")
  let trail = wet_stage_trail as String
  let dir = mkdir_parents_command(path: "/tmp")
  let _ = shell.Exec.RunArgv(program: dir.program.invocation as String, arguments: dir.arguments)
  let append = tee_append_command(path: trail)
  let _ = shell.Exec.RunArgvStdin(
    program: append.program.invocation as String,
    arguments: append.arguments,
    stdin_payload: join([note, "\n"], ""),
  )
  ok
}

// EVERY WRITABLE PATH THE UNIT IS HANDED MUST SIT IN THE ROOT THIS CLAIM MADE — manager condition on
// the route change: "assert every ReadWritePaths= and the working directory are under the claim root
// before launching, and refuse otherwise". is_under is the fixture's own containment rule, so this
// assertion and the guard that admitted the row agree by construction -- and the fourth arm is
// production's own equality claim about the unit's path settings, so nothing here re-implements the
// rendering of a writable set.
fn wet_plan_reaches_only_the_root(instance: HostDashboardInstance, properties: List<SystemdRunProperty>, plan: DispatchWorkerUnitPlan, root: NonEmptyStr) -> Bool {
  is_under(text: plan.working_directory, root: root as String)
    && is_under(text: plan.attempt_worktree, root: root as String)
    && is_under(text: plan.stdout_path, root: root as String)
    && is_under(text: plan.stderr_path, root: root as String)
    && wet_unit_renders_the_handed_set(instance: instance, plan: plan, properties: properties)
}

// THE UNIT'S PATH SETTINGS ARE EXACTLY PRODUCTION'S RENDERING OF THIS PLAN'S HANDED SET -- the gate's
// writable-path arm, rather than a count of `ReadWritePaths=` settings of my own devising.
// `dispatch_worker_path_settings_are_the_set` (gunbc/roadmap/dispatch_worker_handed_set.dag:206) is
// production's own equality claim: the path-carrying settings of a property list are exactly
// `dispatch_worker_set_path_settings` over the handed set built from this plan's fields. A raw path
// setting added beside the set, or a set entry the unit does not render, makes the two lists differ --
// which a count could not catch, because a count is satisfied by a fold that rendered a DIFFERENT list.
// The two negative probes in wet_gate_refuses_ambiguous_writable_paths attack THIS arm.
fn wet_unit_renders_the_handed_set(instance: HostDashboardInstance, plan: DispatchWorkerUnitPlan, properties: List<SystemdRunProperty>) -> Bool {
  let set = dispatch_worker_handed_set(
    instance: instance,
    working_directory: plan.working_directory,
    attempt_worktree: plan.attempt_worktree,
    stdout_path: plan.stdout_path,
    stderr_path: plan.stderr_path,
  )
  dispatch_worker_path_settings_are_the_set(properties: properties, set: set, exit_hook: plan.exit_hook)
}

// THE PRE-LAUNCH ASSERTION, REACHABLE WITHOUT A LAUNCH. Three things have to hold before a unit is put
// on a manager, and all three come out of production's own derivation: every path the unit is handed
// sits in the root this claim made (wet_plan_reaches_only_the_root), the unit runs as the supplied row's
// own worker identity (User= from dashboard_instance_worker_user, the value
// attempt_system_unit_start_facts_for_request derives at attempt_system_unit_launch.dag:238), and the
// unit name carries this claim's mktemp leaf, so it cannot be a production attempt unit. The gate
// returns a plain Bool and never touches a manager, which is what makes it controllable: a BROKEN
// mutant of any conjunct goes red on a host with no systemd and no sudo, so a vacuous gate cannot hide
// behind the claims that need them. wet_worker_unit_start calls THIS, not a copy of it.
// THE PLAN, THROUGH PRODUCTION'S CHAIN AND NOBODY ELSE'S: request, facts, admission, plan
// (attempt_system_unit_launch.dag:213, :251, :296). The gate and its belt both need the plan itself, so
// it is derived here, once; a refusal prints which step refused and returns Absent.
fn wet_plan_for(instance: HostDashboardInstance, unit_key: String, inner: List<String>, root: NonEmptyStr) -> DispatchWorkerUnitPlan? {
  let request = AttemptSystemUnitStartRequest {
    node_id: wet_probe_node as String,
    attempt_key: wet_attempt_key(root: root, label: unit_key),
    granted: kibibyte(count: 65536),
    inner_argv: inner,
    nonce: wet_run_nonce(),
  }
  match attempt_system_unit_start_facts_for_request(instance: instance, request: request) {
    AttemptSystemUnitStartUnderivable { reason: reason } => {
      let _ = wet_stage(stage: join(["plan-derivation-refused:", reason], ""), ok: false)
      Absent
    }
    AttemptSystemUnitStartDerived { facts: facts } => match attempt_system_unit_start_admitted(instance: instance, facts: facts) {
      AttemptSystemUnitRefused { reason: reason } => {
        let _ = wet_stage(stage: join(["plan-admission-refused:", reason], ""), ok: false)
        Absent
      }
      AttemptSystemUnitAdmitted { unit: unit, facts: facts } => Present { value: attempt_system_unit_plan_from_facts(facts: facts, unit: unit) }
    }
  }
}

// THE PROPERTY SET, FROM THE SAME FOLD THE LAUNCH USES (attempt_system_unit_launch.dag:313). The two
// inputs besides the plan are the ones production's own facts carried: the request's grant, and the
// row's worker identity. So the list read here is the list that would have gone to the manager.
fn wet_properties_for(instance: HostDashboardInstance, plan: DispatchWorkerUnitPlan) -> List<SystemdRunProperty> {
  attempt_system_unit_properties(
    instance: instance,
    plan: plan,
    granted: kibibyte(count: 65536),
    user: dashboard_instance_worker_user(instance: instance),
  )
}

// THE THREE CHECKS, IN ONE PLACE: nothing goes on a manager unless every path the unit is handed sits
// in the root this claim made, the unit runs as the row's own worker identity, and the unit name carries
// this claim's mktemp leaf.
fn wet_plan_passes_the_gate(instance: HostDashboardInstance, plan: DispatchWorkerUnitPlan, unit_key: String, root: NonEmptyStr) -> Bool {
  let properties = wet_properties_for(instance: instance, plan: plan)
  wet_plan_reaches_only_the_root(instance: instance, properties: properties, plan: plan, root: root)
    && wet_unit_runs_as_the_supplied_rows_worker(properties: properties, instance: instance)
    && wet_unit_name_carries_the_claim_leaf(root: root, label: unit_key)
}

// THE GATE, AS THE LAUNCH CALLS IT. Absent means production itself refused to derive a plan, and
// wet_plan_for has already printed which step refused.
fn wet_plan_contained_for(instance: HostDashboardInstance, unit_key: String, inner: List<String>, root: NonEmptyStr) -> Bool {
  match wet_plan_for(instance: instance, unit_key: unit_key, inner: inner, root: root) {
    Absent => false
    Present { value: plan } => wet_plan_passes_the_gate(instance: instance, plan: plan, unit_key: unit_key, root: root)
  }
}

// THE GATE, AS A CLAIM CALLS IT: the same three checks plus NEGATIVE probes. Every plan this file can
// derive from its own row IS contained, so a gate replaced by `true` would sail through every positive
// arm -- an assertion nobody can falsify is not an assertion, and on a host that cannot launch there is
// no other way to reach it. So the claim hands the gate a plan that belongs to somebody else and a
// property list that is not the one production folded, and requires both to be refused.
fn wet_gate_proves_itself(
  instance: HostDashboardInstance,
  unit_key: String,
  inner: List<String>,
  root: NonEmptyStr,
  foreign_root: NonEmptyStr,
) -> Bool {
  match wet_plan_for(instance: instance, unit_key: unit_key, inner: inner, root: root) {
    Absent => false
    Present { value: plan } => wet_plan_passes_the_gate(instance: instance, plan: plan, unit_key: unit_key, root: root)
      && wet_gate_refuses_a_foreign_plan(root: root, foreign_root: foreign_root)
      && wet_gate_refuses_ambiguous_writable_paths(plan: plan, instance: instance, root: root)
  }
}

// A PLAN FROM ANOTHER CLAIM'S ROOT, REJECTED AGAINST THIS ONE. Same production chain, different row, so
// nothing here is a hand-written path: if the is_under arms were vacuous, this probe is what says so.
fn wet_gate_refuses_a_foreign_plan(root: NonEmptyStr, foreign_root: NonEmptyStr) -> Bool {
  let foreign = wet_supplied_lab_instance(scratch_parent: foreign_root)
  match wet_plan_for(
    instance: foreign,
    unit_key: "foreign",
    inner: launcher_touch_inner_argv(instance: foreign, path: join([foreign_root as String, "/foreign-touch"], "")),
    root: foreign_root,
  ) {
    Absent => wet_stage(stage: "foreign-plan-is-underivable", ok: false)
    Present { value: plan } => wet_stage(
      stage: "gate-refuses-a-plan-from-another-claim-root",
      ok: !wet_plan_reaches_only_the_root(
        instance: foreign,
        properties: wet_properties_for(instance: foreign, plan: plan),
        plan: plan,
        root: root,
      ),
    )
  }
}

// TWO PROBES ON THE WRITABLE-PATHS ARM, each killing a different deletion in PRODUCTION's fold, not
// in this file: `dispatch_worker_unit_confinement`'s property fold emits exactly one
// `NamedUnitSetting { property: ReadWritePathsProperty, value: dispatch_worker_set_read_write_wire(set:) }`,
// so the arm's content is that exactly-one. (a) DROP that emission and the gate must still refuse, rather
// than pass vacuously over an empty writable word list -- probe
// "gate-refuses-a-plan-with-no-writable-paths-declared" is what that deletion fails. (b) EMIT it twice and
// the gate must refuse rather than accept an ambiguous fold -- probe
// "gate-refuses-a-plan-declaring-writable-paths-twice" is what that duplication fails. Both probes keep
// their words under the claim's own root, so nothing but the arm can decide them.
fn wet_gate_refuses_ambiguous_writable_paths(plan: DispatchWorkerUnitPlan, instance: HostDashboardInstance, root: NonEmptyStr) -> Bool {
  let all = wet_properties_for(instance: instance, plan: plan)
  let without = fold(
    all,
    init: [],
    f: (acc, p) => match p {
      NamedUnitSetting { property: ReadWritePathsProperty, value: _ } => acc
      _ => concat(acc, [p])
    },
  )
  let twice = fold(
    all,
    init: [],
    f: (acc, p) => match p {
      NamedUnitSetting { property: ReadWritePathsProperty, value: v } => concat(concat(acc, [p]), [NamedUnitSetting { property: ReadWritePathsProperty, value: v }])
      _ => concat(acc, [p])
    },
  )
  wet_stage(
    stage: "gate-refuses-a-plan-with-no-writable-paths-declared",
    ok: !wet_plan_reaches_only_the_root(instance: instance, properties: without, plan: plan, root: root),
  )
    && wet_stage(
      stage: "gate-refuses-a-plan-declaring-writable-paths-twice",
      ok: !wet_plan_reaches_only_the_root(instance: instance, properties: twice, plan: plan, root: root),
    )
}

// WHICH IDENTITY THE MANAGER WAS TOLD TO RUN THE UNIT AS, read back out of the property set through
// the variant production folds it with (User, attempt_system_unit_launch.dag:285) and compared with the
// row's own worker identity. Not a second copy of production's admission -- that guard
// (attempt_system_unit_start_admitted) already refuses a User= that is not
// dashboard_instance_worker_user -- this is the readback showing the supplied SERVICE-USER row reaches
// the manager as the invoking user, which is the population the RFM row declares covered.
fn wet_unit_runs_as_the_supplied_rows_worker(properties: List<SystemdRunProperty>, instance: HostDashboardInstance) -> Bool {
  let worker = dashboard_instance_worker_user(instance: instance) as String
  let users = fold(
    properties,
    init: [],
    f: (acc, p) => match p {
      NamedUnitSetting { property: User, value: v } => concat(acc, [v as String])
      _ => acc
    },
  )
  length(xs: users) == 1
    && fold(users, init: true, f: (ok, u) => ok && (u == worker))
}

// THE NAME IS THIS CLAIM'S, NOT A PRODUCTION ATTEMPT'S. path_basename of the root is mktemp's own
// suffix, six characters the host chose, so requiring it inside the unit name is what makes a probe
// unable to collide with, or mask, a real attempt unit -- and it is per-run: two runs of this file
// cannot name the same unit either.
fn wet_unit_name_carries_the_claim_leaf(root: NonEmptyStr, label: String) -> Bool {
  match wet_unit_name_for(root: root, label: label) {
    Absent => wet_stage(stage: join(["unit-name-refused:", label], ""), ok: false)
    Present { value: name } => wet_stage(
      stage: join(["unit-name:", name as String], ""),
      ok: match witness_claim_leaf(path: root as String) {
        Absent => wet_stage(stage: "claim-root-has-no-leaf", ok: false)
        Present { value: leaf } => string_contains(s: name as String, pattern: leaf),
      },
    )
  }
}

// THE CLAIM'S OWN LEAF, INSIDE THE UNIT NAME (manager condition of 2026-11-04). Production names the
// unit itself -- systemd_service_unit_name(stem: dispatch_attempt_unit_stem(node_id, attempt_key)) --
// and a witness must not name a unit behind that derivation, so what the claim contributes is the
// ATTEMPT KEY: it carries the mktemp leaf of the root this claim made. Two runs of the same probe
// therefore cannot collide with each other (the leaf is mktemp's random suffix), and no production
// attempt unit can ever be named this, because no production attempt key is a /tmp scratch leaf.
// Production's naming, its character policy and its 255-character bound all still decide the result.
fn wet_attempt_key(root: NonEmptyStr, label: String) -> String {
  match witness_claim_leaf(path: root as String) {
    // A root with no final segment is not a claim root at all. Returning the empty string hands the
    // claim to production's own guard (path_segment_is_safe refuses an empty segment, and
    // wet_unit_name_for below then yields Absent), so this cannot quietly name a unit anyway.
    Absent => ""
    Present { value: leaf } => join([leaf, "-", label], "")
  }
}

// The exact name production would have derived for this claim's (node_id, attempt_key), read back
// through the SAME production symbols -- the one used to retire a unit by name, never to name one.
fn wet_unit_name_for(root: NonEmptyStr, label: String) -> NonEmptyStr? {
  match systemd_service_unit_name(
    stem: dispatch_attempt_unit_stem(node_id: wet_probe_node as String, attempt_key: wet_attempt_key(root: root, label: label)),
  ) {
    SystemdUnitNameAdmitted { name: name } => Present { value: systemd_unit_name_wire(name: name) }
    SystemdUnitNameStemEmpty => Absent
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => Absent
    SystemdUnitNameOverlong { length: _ } => Absent
  }
}

// RETIREMENT, BY EXACT NAME. Root now creates units on the SYSTEM manager, where they outlive the
// process that asked for them unless someone takes them down: `systemd-run` without --collect leaves a
// failed transient unit in `systemctl list-units --all`. Every launch therefore stops and
// resets-failed the unit it created, and the claim is RED if the unit is still listed afterwards --
// stern checks `systemctl list-units --all | grep gunbc` after the run, and a probe that leaked a
// unit would be indistinguishable from a host that still has one.
fn wet_retire_unit(root: NonEmptyStr, label: String) -> Bool {
  match wet_unit_name_for(root: root, label: label) {
    Absent => wet_stage(stage: join(["unit-name-underivable:", label], ""), ok: false)
    Present { value: unit } => {
      let stop = sudo_elevate_command(command: systemctl_stop_argv(unit: unit))
      let _ = shell.Exec.RunArgv(program: stop.program.invocation as String, arguments: stop.arguments)
      let reset = sudo_elevate_command(command: systemctl_reset_failed_argv(unit: unit))
      let _ = shell.Exec.RunArgv(program: reset.program.invocation as String, arguments: reset.arguments)
      wet_stage(
        stage: join(["unit-retired:", unit as String], ""),
        ok: wet_unit_is_gone(unit: unit),
      )
    }
  }
}

// THE READBACK IS THE HOST'S OWN UNIT LIST, not the exit code of the command that removed it: a
// stop/reset pair can exit 0 and still leave the name listed, which is the state that matters.
fn wet_unit_is_gone(unit: NonEmptyStr) -> Bool {
  let listing = wet_out(command: systemctl_list_all_service_units_command())
  !string_contains(s: listing, pattern: unit as String)
}

// THE CONTROL UNITS ARE NOT ATTEMPT UNITS. The sandboxed leg's unit is named by production's own
// derivation (`wet_unit_name_for`), because that is the name production would give it; the
// unsandboxed sibling is a probe with no attempt behind it, and handing it production's
// `gunbc-attempt-*` shape would put a witness unit inside the namespace a real attempt owns -- the
// collision the retirement duty exists to prevent. So the sibling gets its own stem, still rendered
// by the host's name authority (`systemd_service_unit_name`: the [A-Za-z0-9-._:] charset and the
// 255-byte bound) and still carrying the claim's mktemp leaf, so two runs of one claim can never
// name the same unit.
fn wet_control_unit_name(root: NonEmptyStr, label: String) -> NonEmptyStr? {
  match witness_claim_leaf(path: root as String) {
    Absent => Absent
    Present { value: leaf } => match systemd_service_unit_name(
      stem: join(["gunbc-sandbox-control-", leaf, "-", label], "") as NonEmptyStr,
    ) {
      SystemdUnitNameAdmitted { name: name } => Present { value: systemd_unit_name_wire(name: name) }
      SystemdUnitNameStemEmpty => Absent
      SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => Absent
      SystemdUnitNameOverlong { length: _ } => Absent
    }
  }
}

// Same readback discipline as `wet_unit_is_gone`, against the manager that actually holds the unit.
fn wet_user_unit_is_gone(unit: NonEmptyStr) -> Bool {
  !string_contains(
    s: wet_argv_out(program: systemctl_path_resolved_program().invocation as String,
      arguments: systemctl_list_all_user_service_units_argv()),
    pattern: unit as String,
  )
}

// The unsandboxed sibling is a transient too, and a FAILED one is retained until someone resets it;
// two of its three cells are supposed to fail, so without this the run would leave gunbc-named units
// in the principal's user manager and stern's `systemctl list-units --all` readback could not tell a
// probe leak from a host that still has a unit. No elevation: this is the invoking principal's own
// manager, the same one `systemd-run --user` reached.
fn wet_retire_user_unit(root: NonEmptyStr, label: String) -> Bool {
  match wet_control_unit_name(root: root, label: label) {
    Absent => wet_stage(stage: join(["control-unit-name-underivable:", label], ""), ok: false)
    Present { value: unit } => {
      // Both are issued and their outcomes deliberately discarded: a unit that is already gone makes
      // `stop` fail, and that is not a leak. The readback below is what decides, so an unfalsifiable
      // "it stopped, trust me" cannot be the answer.
      let ctl = systemctl_path_resolved_program().invocation as String
      let _ = wet_argv_ok(program: ctl as NonEmptyStr, arguments: systemctl_stop_user_argv(unit: unit))
      let _ = wet_argv_ok(program: ctl as NonEmptyStr, arguments: systemctl_reset_failed_user_argv(unit: unit))
      wet_stage(
        stage: join(["control-unit-retired:", unit as String], ""),
        ok: wet_user_unit_is_gone(unit: unit),
      )
    }
  }
}

// Root writes into the claim's tree (the claimed/answer files are created by the elevated root side),
// so removing it sometimes needs the same elevation the writing needed.
fn wet_rm_elevated(root: NonEmptyStr) -> Bool {
  let rm = sudo_elevate_command(command: ["/bin/rm", "-rf", root as String])
  // Same reason as the launcher read above, and it matters most HERE: cleanup is the last thing a
  // failing leg does, and a raise would skip the `claim-root-gone` readback along with the removal.
  // A host without sudo simply has no elevated route, and the readback then reddens the claim.
  let read = shell.Exec.RunArgvOutcome(program: rm.program.invocation as String, arguments: rm.arguments)
  match read.outcome {
    ShellSpawnRefused { program: _, cause: _ } => false
    ShellExited => read.exit_code == 0
  }
}

// One call at the tail of EVERY claim that owns a root -- launch claims and the four fixture claims
// alike; the name once said "launch" and stopped being true the moment the fixture claims needed it
// too. The verdict is bound first, the claim root is then taken away, and A ROOT LEFT BEHIND REDDENS
// THE CLAIM. The cleanup is not decorative and it is not silent. Two measured failures, both of which
// this call closes. (1) srv2 (stern, 2026-11-04, at fa64a4b9) found twenty /tmp/gunbc-sandbox-* roots
// still present after the run while the witness's own stage line called the removal
// "housekeeping-not-verdict" and read ok: the removal had been ATTEMPTED and had not SUCCEEDED, and
// nothing read the outcome back. (2) This file's own BROKEN run: four claims ended their `&&` chain
// with `&& wet_clean_claim_root(root: root)`, so a leg that failed earlier short-circuited PAST the
// removal and left /tmp/gunbc-sandbox-belt-commondir-... (empty, contents never written because the
// chain had already stopped) on disk while its verdict was FAIL. Short-circuiting is why removal can
// never be a conjunct: it must run whether or not the verdict is already false, and its readback must
// still be able to make the claim red. "Cleanup runs whatever the verdict said" is only honest if a
// failed cleanup is visible in the verdict rather than in a log line nobody compares against.
//
// Order: the claim's own removal first; the elevated one when that fails, because a root-side leg
// wrote its files as root and the claim's own principal cannot unlink them; then a one-second settle
// and a second elevated attempt, for the `…/source/.git: Directory not empty` case where a git
// process was still writing (stern, same run, twice). The ORACLE IS THE FILESYSTEM, not rm's exit
// status -- a directory that never existed and a directory rm could not remove both present as an rm
// that returned something, so the claim asks `test -e` about its own root. Verdict and housekeeping
// keep separate stage names, so "the sandbox let the write through" and "the probe left a directory
// in /tmp" remain two faults with two remedies; the returned value carries both, so neither can be
// reported as a pass on its own.
fn wet_claim_verdict_with_root_readback(verdict: Bool, root: NonEmptyStr) -> Bool {
  let removed_by_claim = wet_clean_claim_root(root: root as String)
  let removed_after_elevation = removed_by_claim || wet_rm_elevated(root: root)
  let removed_after_settle =
    removed_after_elevation || (wet_settle() && wet_rm_elevated(root: root))
  let gone = wet_stage(stage: "claim-root-gone", ok: removed_after_settle && wet_claim_root_is_absent(root: root))
  let _ = wet_stage(stage: "claim-root-housekeeping", ok: removed_after_settle)
  verdict && gone
}

// A CLAIM THAT PLANTS MORE THAN ONE ROOT PUTS EVERY ONE OF THEM AWAY, whether or not an earlier one
// already failed. The single-root readback is joined by its callers with `&&`, and `&&` short-circuits:
// chaining two of them left the second root under /tmp on exactly the runs that went RED -- measured here,
// where a RED run of either multi-root claim left its `leaf-b` / `confined-only` root behind. A leftover is
// not cosmetic: it is a tree in /tmp the next run can collide with, and it makes a script's own leftover
// count stop meaning anything. The accumulator is a counter rather than a conjunction on purpose:
// `acc + (…)` evaluates its right operand for every root, where an `acc && (…)` accumulator would stop
// removing at the first root that failed to go and reproduce the very leak this exists to close. Each root
// keeps the single-root helper's two stage names, so "the verdict is false" and "a probe left a directory
// in /tmp" remain two faults with two remedies; the returned value carries the claim's verdict and every
// root's absence together, so no root can be reported away while another one of the same claim's remains.
fn wet_claim_verdicts_with_root_readbacks(verdict: Bool, roots: List<NonEmptyStr>) -> Bool {
  let roots_not_gone = fold(
    roots,
    init: 0,
    f: (acc, root) =>
      acc + (if wet_claim_verdict_with_root_readback(verdict: true, root: root) { 0 } else { 1 })
  )
  verdict && roots_not_gone == 0
}

// THE FILESYSTEM ANSWERS, NOT rm: the claim asks the same `test -e` its sibling readback uses about
// its own root. Present means the claim failed, whatever any removal command reported on the way.
fn wet_claim_root_is_absent(root: NonEmptyStr) -> Bool {
  !wet_path_exists(path: root as String)
}

// THE ROOT SIDE, AS A SERVED FUNCTION THE CLAIM CAN ELEVATE. Production's root side is the attempt-unit
// drain .service (ExecStart = attempt_system_unit_launch_cli, gunbc/live_deploy/emit.dag:956), and it is
// NOT drivable from a supplied root: attempt_system_unit_drain_pass (:1134) recovers the instance row
// with attempt_system_unit_instance_for_root -> dashboard_instance_for_instance_root
// (gunbc/roadmap/roadmap_dashboard_instance.dag:958-966), which filters the STATIC builtin roster
// public_builtin_dashboard_instances(), and its argv builder reads the served binary from
// attempt_system_unit_launcher_helpers_root = "/opt/gunbc/attempt-system-unit-helpers" (:93). Both are
// live-root bindings -- the exact class of binding this PR exists to remove -- so a claim that ran the
// production drain CLI would wait forever for an answer, which is what srv2 run 15794e measured.
// What IS drivable is production's own PER-ENTRY root side: attempt_unit_entry_outcome
// (attempt_system_unit_launch.dag:1119) takes the row as a PARAMETER, then runs production's claim
// entry, its symlink refusal, the derivation, the admission, the plan, the command builder, the
// RunTransient transport (extdeps/systemd/systemd_run.dag:525: ["systemd-run", ...], the system
// manager) and the answer write-back. So this function supplies only the two things the roster and the
// helper root would have supplied -- the row, built by the fixture from the claim's own root, and the
// binary, the planted serve binary -- and calls production's per-entry function. The distance that
// leaves is named in the PR body and in the RFM row.
//
// THE PRINCIPAL IS VERIFIED, NOT TRUSTED. A root process asking `id -u` gets 0, and a unit with
// User=root is not the service-user shape any claim here establishes. So the caller hands over the
// host-said principal it read as the unprivileged claim, and this function refuses unless the claim
// root directory's OWN ownership says the same thing (coreutils_stat_path_ownership, whose own comment
// records that it never defaults a missing field to 0). A caller cannot mint a principal it does not
// already own the directory as, and witness_principal_from_texts refuses uid 0 outright.
fn wet_root_side_cli(
  root: String,
  entry: String,
  uid: String,
  gid: String,
  user: String,
  group: String,
) -> ProcessExit {
  match witness_principal_from_texts(uid_text: uid, gid_text: gid, user_text: user, group_text: group) {
    Absent => exit_failure(reason: "the principal named by the claim is not one the host can confirm as uid/gid/user/group")
    Present { value: who } => match coreutils_stat_path_ownership(path: root as NonEmptyStr) {
      PathOwnershipUnobservable { path: _, reason: reason } => exit_failure(reason: join(["the claim root's ownership could not be read: ", reason], ""))
      PathOwnershipObserved { path: _, ownership: ownership, owner_name: owner_name, group_name: group_name } =>
        if owner_name != who.user || group_name != who.group || ownership.uid != who.uid || ownership.gid != who.gid {
          exit_failure(reason: "the claim root is not owned by the principal the claim named")
        } else {
          let inst = witness_supplied_instance(
            scratch_parent: root as NonEmptyStr,
            repo: join([root, "/source"], "") as FilePath,
            principal: who,
          )
          match attempt_unit_entry_outcome(
            instance_root: inst.instance_root as String,
            instance: Present { value: inst },
            entry: entry,
          ) {
            AttemptUnitEntrySkipped => exit_failure(reason: "the request entry had already been claimed when the root side reached it")
            AttemptUnitEntryUnmovable { entry: _, step: _, cause: cause } => exit_failure(reason: join(["the request entry could not leave the queue: ", cause], ""))
            AttemptUnitEntryHandled { handled: _ } => ExitSuccess
          }
        }
    }
  }
}

// THE ONE ROOT-SIDE START THIS WITNESS PERFORMS. Both routes — the direct sandbox leg and the
// launcher legs — go through here, so there is exactly one place that can put a unit on a manager,
// and it is production's. `attempt_system_unit_properties` is called again below only to READ the
// property set for the containment assertion; the launch itself takes the properties from inside
// attempt_system_unit_systemd_run_command, so this is not a second fold the unit is built from.
fn wet_worker_unit_start(instance: HostDashboardInstance, unit_key: String, inner: List<String>, root: NonEmptyStr) -> WetRootLaunch {
  // THE LOCUS FIRST, THEN THE IMAGE, THEN THE MANAGER. The order is not cosmetic: the served-image probe
  // asks the image the very question the drain will ask, and after this PR that question is asked UNDER
  // THE LOCUS (same env, same workspace root), so it can only be asked once the locus exists. On a host
  // with no elevation the gate refuses here with its cause on the trail, which is the same posture the
  // root-launcher refusal above already takes -- a typed "needs elevation" stop, never a silent skip.
  let revision_text = wet_locus_gate_text(instance: instance, label: unit_key)
  if !wet_root_launcher_is_available() {
    WetRootLaunchRefused { cause: "needs a root launcher: the host says sudo -n true does not exit 0, and the system manager production uses is unreachable without it" }
  } else if revision_text == "" {
    // THE LOCUS IS A PREREQUISITE, NOT A DETAIL THE DRAIN DISCOVERS. srv2's S1 at 114bcf31 learned this
    // the expensive way: with no installed locus the drain's GUNBC_WORKSPACE_ROOT named a copied tree,
    // the CLI refused it, and nine legs reported a failed drain instead of the one fact that mattered.
    // `wet_locus_gate` has already written the cause to the trail -- elevation, staging, the fold's own
    // step, or a fold that converged without leaving what the reader asks for -- so this arm only stops.
    WetRootLaunchRefused {
      cause: join(
        [
          "the claim-local release locus is not installed for ",
          unit_key,
          "; the cause is on the trail as claim-locus-refused:",
          unit_key,
        ],
        "",
      ),
    }
  } else if !wet_stage(
    // THE IMAGE IS ASKED BEFORE ANYTHING REACHES A MANAGER. On the srv2 run of fa64a4b9 the batch
    // runner had been planted as the instance gunbc, so nine legs enqueued a unit, ran the elevated
    // drain, waited on an exit record and reported a missing marker -- while the real fault was one
    // argv word deep: the "image" answered `unknown argument: run`. Asking costs two served-probe
    // runs (measured: a couple of seconds) and turns that into a refusal with a named cause before a
    // transient unit exists, which is also before anything could leave a root-owned file behind.
    stage: join(["served-image-answers-the-route:", unit_key], ""),
    ok: wet_served_image_answers_the_route(instance: instance, revision_text: revision_text),
  ) {
    WetRootLaunchRefused {
      cause: "the planted image does not answer the served route -- it is not the gunbc CLI the row names; see the served-probe pair in the witness",
    }
  } else {
    let request = AttemptSystemUnitStartRequest {
      node_id: wet_probe_node as String,
      attempt_key: wet_attempt_key(root: root, label: unit_key),
      granted: kibibyte(count: 65536),
      inner_argv: inner,
      nonce: wet_run_nonce(),
    }
    match attempt_system_unit_start_facts_for_request(instance: instance, request: request) {
      AttemptSystemUnitStartUnderivable { reason: reason } => WetRootLaunchRefused { cause: join(["production derivation refused the start request: ", reason], "") }
      AttemptSystemUnitStartDerived { facts: facts } => match attempt_system_unit_start_admitted(instance: instance, facts: facts) {
        AttemptSystemUnitRefused { reason: reason } => WetRootLaunchRefused { cause: join(["production admission refused the start facts: ", reason], "") }
        AttemptSystemUnitAdmitted { unit: unit, facts: facts } => {
          let plan = attempt_system_unit_plan_from_facts(facts: facts, unit: unit)
          // NOTHING GOES ON A MANAGER UNTIL THE PRE-LAUNCH ASSERTION PASSES, and the assertion is the
          // same function the control claim runs on any host -- so what this gate refuses is testable
          // where every reader can test it, not only on the host that can launch. It re-derives
          // through the same production symbols rather than trusting the values about to be launched;
          // the derivation is pure and lives in exactly one place.
          if !wet_plan_contained_for(instance: instance, unit_key: unit_key, inner: inner, root: root) {
            WetRootLaunchRefused { cause: "the production plan reaches outside the supplied root, or the unit does not carry this claim's own name and worker identity" }
          } else {
            match attempt_system_unit_systemd_run_command(instance: instance, plan: plan, granted: facts.granted, user: facts.user) {
              SystemdRunCommandRefused { cause: cause } => WetRootLaunchRefused { cause: join(["systemd-run option words refused: ", systemd_run_option_words_refused_cause_detail(cause: cause)], "") }
              SystemdRunCommandReady { command: command } => {
                let elevated = sudo_elevate_command(command: concat([command.program.invocation as String], command.arguments))
                let code = shell.Exec.RunArgv(program: elevated.program.invocation as String, arguments: elevated.arguments).exit_code
                // The unit has run by now; its effect is on disk and its ExecStopPost record is
                // written, so retiring it here cannot take the evidence away -- and it means no claim
                // can end with a live unit, whichever conjunct fails after this point.
                let _ = wet_retire_unit(root: root, label: unit_key)
                WetRootLaunchRan { exit_code: code }
              }
            }
          }
        }
      }
    }
  }
}

// THE ROOT SIDE OF THE LAUNCHER, RUN BY THE CLAIM. Production's drain .service ExecStart is the
// served binary's attempt_system_unit_launch_cli (gunbc/live_deploy/emit.dag:956, argv from
// attempt_system_unit_launch_gunbc_argv_at); that .service is a host installation, so on a host where
// it is not installed nothing ever drains the queue and the leg silently waits out its 240 s. The
// claim therefore performs the same root side itself: the SAME production argv builder
// (gunbc_entry_run_argv) over the planted tree, the entry and function names from production's own
// rows (attempt_system_unit_launch_entry / attempt_system_unit_launch_function), the instance_root
// argument through production's own admission (attempt_system_unit_launch_named_argument), and the
// elevation through the sudo module. After it, the queue's answer files — written by a root process —
// are handed back to the claim's own principal so the unprivileged read-backs and cleanup still work.
fn wet_root_drain_elevated(
  instance: HostDashboardInstance,
  root: NonEmptyStr,
  unit_key: String,
  entry_name: String,
) -> Bool {
  // THE REVISION, RE-READ HERE RATHER THAN PASSED DOWN FROM NINE CLAIMS. The fold is idempotent, so a
  // second gate call costs a readback and not a second install, and it keeps the drain from being
  // callable with a revision some other conjunct remembered -- which is the drift srv2's S1 at 114bcf31
  // caught in the other direction. An empty text means the locus is not there: this leg says false and
  // the trail already carries the cause under claim-locus-refused.
  let revision_text = wet_locus_gate_text(instance: instance, label: join(["drain:", unit_key], ""))
  if revision_text == "" {
    false
  } else if !wet_stage(stage: join(["root-launcher-available:", unit_key], ""), ok: wet_root_launcher_is_available()) {
    false
  } else if !wet_stage(
    stage: join(["spool-tree-prepared:", unit_key], ""),
    ok: wet_prepare_attempt_unit_spool(instance: instance),
  ) {
    false
  } else {
    let principal = wet_principal()
    let arguments = [
      admit_named_argument(name: "root", value: root as String),
      admit_named_argument(name: "entry", value: entry_name as String),
      admit_named_argument(name: "uid", value: to_string(value: principal.uid)),
      admit_named_argument(name: "gid", value: to_string(value: principal.gid)),
      admit_named_argument(name: "user", value: principal.user as String),
      admit_named_argument(name: "group", value: principal.group as String),
    ]
    let words = fold(arguments, init: [], f: (acc, a) => match a {
      NamedArgumentAdmitted { argument: argument } => concat(acc, map(named_argument_words(argument: argument), w => invocation_word_bare(w: w)))
      _ => acc
    })
    // Six arguments, two words each (name + value), with no embedded separator: anything else is a
    // value the word policy had to quote, and this route cannot carry it.
    if length(xs: words) == 12 {
        // THE LOCUS, NOT THE SOURCE COPY. srv2's S1 at 114bcf31 (stern, 2026-11-05) is what this line
        // replaced: the drain asked for `instance.repo_root`, a copied tree with no receipt, and the
        // real CLI refused it at cli_run.rs:611 -- `names no release locus: missing member
        // .gunbc-tree-receipt` -- before any sandbox conjunct ran. The words now come from
        // `wet_image_serve_argv`, the same builder the served-image probe uses.
        let command = wet_image_serve_argv(
          instance: instance,
          revision_text: revision_text,
          entry_relative: wet_witness_entry_relative,
          function: "wet_root_side_cli" as NonEmptyStr,
        )
        // gunbc_entry_run_argv hands back the WHOLE argv (binary first, then the workspace env prefix),
        // so the named arguments are appended to it and the whole list is what gets elevated.
        let elevated = sudo_elevate_command(command: concat(map(command, w => w as String), words))
        let ran = shell.Exec.RunArgv(program: elevated.program.invocation as String, arguments: elevated.arguments).exit_code == 0
        let back = sudo_elevate_command(
          command: [
            "/usr/bin/chown", "-R",
            join([principal.user as String, ":", principal.group as String], ""),
            root as String,
          ],
        )
        let returned = shell.Exec.RunArgv(program: back.program.invocation as String, arguments: back.arguments).exit_code == 0
        wet_stage(stage: join(["elevated-drain-ran:", unit_key], ""), ok: ran) && wet_stage(stage: join(["root-owned-files-returned:", unit_key], ""), ok: returned)
    } else {
      wet_stage(stage: join(["root-side-arguments-refused:", unit_key], ""), ok: false)
    }
  }
}

// THE DIRECT SANDBOX LEG, ON THE PRODUCTION ROUTE. The unit name a caller names is carried as the
// ATTEMPT KEY: production derives the unit name from (node_id, attempt_key) itself, so the probe
// labels below still land in the unit name instead of competing with production's derivation.
fn sandbox_touch(instance: HostDashboardInstance, unit: NonEmptyStr, path: String, root: NonEmptyStr) -> SandboxTouch {
  match wet_worker_unit_start(
    instance: instance,
    unit_key: unit as String,
    // THE GUEST COMMAND IS A SERVED FUNCTION, NOT A BARE PROGRAM. production's own admission refuses an
    // ExecStart whose first word is not the instance's gunbc binary
    // (attempt_system_unit_launch.dag:272-276, "ExecStart program is not the instance gunbc binary"), so
    // the sandboxed touch runs `sandbox_touch_cli` through the served CLI, exactly as the launcher legs
    // run their guests. A bare /usr/bin/touch here would not be a sandbox verdict at all -- the plan
    // would never be admitted, which is what the containment control claim now catches on any host.
    inner: launcher_touch_inner_argv(instance: instance, path: path),
    root: root,
  ) {
    WetRootLaunchRefused { cause: _ } => SandboxTouchUnrunnable
    WetRootLaunchRan { exit_code: exit_code } => SandboxTouchRan { exit_code: exit_code }
  }
}

fn sandbox_touch_read(instance: HostDashboardInstance, unit: NonEmptyStr, path: String, root: NonEmptyStr) -> SandboxTouchReading {
  let touch = sandbox_touch(instance: instance, unit: unit, path: path, root: root)
  sandbox_touch_reading_of(
    touch: touch,
    path_present: shell.Exec.RunArgv(program: "test", arguments: ["-e", path]).exit_code == 0,
  )
}

// The paired control: the SAME route as the sandboxed touch (a user-manager transient, same principal,
// same supplementary groups), with no sandbox properties, writes a sibling of the target in its
// directory and removes it. Running it from the claim process instead would differ in credentials (an
// ssh session carries groups the long-running user manager lacks), so a target writable only through
// such a group would refuse the sandboxed touch by permission while the control wrote, and the
// refusal would be credited to the sandbox. The pair differs in exactly one variable. quick-bee-65
// The verdict of the sibling cell ONLY: whether this principal, with no sandbox property in front of
// it, can write this path at all. The unit it creates is put away by the caller through
// `wet_retire_user_unit`, as a conjunct of its own -- so a probe that leaked a unit goes red instead
// of leaving the host holding it, and a failed cell's verdict is not masked by its cleanup.
fn unsandboxed_sibling_write_ok(root: NonEmptyStr, label: String, path: String) -> Bool {
  match wet_control_unit_name(root: root, label: label) {
    Absent => wet_stage(stage: join(["control-unit-name-underivable:", label], ""), ok: false)
    Present { value: unit } => match systemd_run_user_wait_command(
    unit: unit,
    properties: [],
    setenv_bindings: [],
    command_argv: [
      "/bin/sh", "-c", "touch -- \"$1\" && rm -f -- \"$1\"", "sh",
      join([path, ".unsandboxed-control"], ""),
    ],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => false
    SystemdSummaryPrintingWaitReady { wait: wait } => wet_systemd_run_control_ran(
      words: systemd_run_command_argument_words(command: wait.command),
      label: label,
    )
    }
  }
}

// The control cell asks the USER manager to run the sibling write, because its whole point is a writer
// the unit's hardening does NOT apply to. Where the host has no systemd-run there is no control cell at
// all: that is the cell failing with a cause, not the claim raising -- a raised claim skips its own root
// cleanup, which is how srv2 collected leftover roots (see wet_root_launcher_is_available).
fn wet_systemd_run_control_ran(words: List<String>, label: String) -> Bool {
  let read = shell.Exec.RunArgvOutcome(program: "systemd-run", arguments: words)
  match read.outcome {
    ShellSpawnRefused { program: _, cause: _ } => wet_stage(stage: join(["control-systemd-run-could-not-spawn:", label], ""), ok: false)
    ShellExited => read.exit_code == 0
  }
}

fn refusal_reading_after_control(control_wrote: Bool, reading: SandboxTouchReading) -> SandboxTouchReading {
  match reading {
    SandboxTouchRefusedReading => if control_wrote { SandboxTouchRefusedReading } else { SandboxTouchInconclusive }
    SandboxTouchNeverRan => SandboxTouchNeverRan
    SandboxTouchWroteReading => SandboxTouchWroteReading
    SandboxTouchInconclusive => SandboxTouchInconclusive
  }
}

fn sandbox_touch_write_refused(instance: HostDashboardInstance, unit: NonEmptyStr, path: String, root: NonEmptyStr) -> Bool {
  let control_label = join(["sibling-", unit as String], "")
  let control_ran = unsandboxed_sibling_write_ok(root: root, label: control_label, path: path)
  let verdict = match refusal_reading_after_control(
    control_wrote: control_ran,
    reading: sandbox_touch_read(instance: instance, unit: unit, path: path, root: root),
  ) {
    SandboxTouchRefusedReading => true
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
    SandboxTouchInconclusive => false
  }
  // The control's unit is retired as a conjunct of THIS leg, whatever the reading said.
  verdict && wet_retire_user_unit(root: root, label: control_label)
}

fn reading_is_inconclusive(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchInconclusive => true
    SandboxTouchRefusedReading => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

fn reading_is_refused(reading: SandboxTouchReading) -> Bool {
  match reading {
    SandboxTouchRefusedReading => true
    SandboxTouchInconclusive => false
    SandboxTouchNeverRan => false
    SandboxTouchWroteReading => false
  }
}

// RED for the control, on supplied values: a refused touch whose control could not write reads
// inconclusive, never refused; the same refusal with a writing control stands.
test fn a_refusal_the_principal_could_not_have_been_denied_otherwise_reads_inconclusive() -> Bool {
  reading_is_inconclusive(reading: refusal_reading_after_control(control_wrote: false, reading: SandboxTouchRefusedReading))
    && reading_is_refused(reading: refusal_reading_after_control(control_wrote: true, reading: SandboxTouchRefusedReading))
}

// Inhabitance of the real control route (needs a user manager, like the sibling cells): ENOENT and
// EACCES directories read false, a writable one true. The EACCES half is unobservable as root, so the
// claim requires a non-root principal and is false on a root runner rather than passing without it.
test fn the_unsandboxed_control_reads_the_principals_write_access() -> Bool {
  let root = wet_claim_root(tag: "unsandboxed-control" as NonEmptyStr)
  let principal_is_not_root =
    shell.Sh.ReparseWith(shell: "sh" as NonEmptyStr, command: "test \"$(id -u)\" -ne 0" as NonEmptyStr).success
  // Each cell's verdict is bound BEFORE its unit is retired, and the retirement is then a conjunct of
  // its own: a leaked unit turns the claim red without being able to flip what the cell measured.
  let enoent = !unsandboxed_sibling_write_ok(root: root, label: "inhabit-enoent", path: "/proc/gunbc-no-such-dir/target")
    && wet_retire_user_unit(root: root, label: "inhabit-enoent")
  let eacces = !unsandboxed_sibling_write_ok(root: root, label: "inhabit-eacces", path: "/usr/gunbc-control-target")
    && wet_retire_user_unit(root: root, label: "inhabit-eacces")
  let writable = unsandboxed_sibling_write_ok(root: root, label: "inhabit-ok", path: "/tmp/gunbc-control-inhabitance-target")
    && wet_retire_user_unit(root: root, label: "inhabit-ok")
  wet_claim_verdict_with_root_readback(
    verdict: principal_is_not_root && enoent && eacces && writable,
    root: root,
  )
}

fn sandbox_touch_wrote(instance: HostDashboardInstance, unit: NonEmptyStr, path: String, root: NonEmptyStr) -> Bool {
  match sandbox_touch_read(instance: instance, unit: unit, path: path, root: root) {
    SandboxTouchWroteReading => true
    SandboxTouchNeverRan => false
    SandboxTouchRefusedReading => false
    SandboxTouchInconclusive => false
  }
}

// The same-shape positive control for the refused cells: the worker unit shape must RUN a touch that
// is allowed, or no refusal from it counts. It writes a dedicated path in the worker directory that nothing else names (systemd itself opens worker-stdout.log, so that file proves nothing about touch) and cleans up.
fn worker_shape_runs_an_allowed_touch(instance: HostDashboardInstance, root: NonEmptyStr) -> Bool {
  let control = join([probe_worker_dir(instance: instance), "/.gunbc-worker-control-probe"], "")
  sandbox_touch_wrote(
    instance: instance,
    unit: "gunbc-writable-probe-control.service" as NonEmptyStr,
    path: control,
    root: root,
  ) && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", control]).exit_code == 0
}

test fn writes_to_the_deployed_binary_and_tree_fail_inside_the_worker_sandbox() -> Bool {
  // THE DEPLOYED BINARY AND TREE ARE THE CLAIM'S OWN NOW. The claim's whole subject is a write
  // the sandbox refuses; against the live row that write was one this witness made itself in
  // /opt/gunbc-lab, so a refusal proved the sandbox worked only on the assumption that the
  // directory it refused was not the one being served. The row is supplied, the tree is planted
  // under it, and the five targets below stay accessors over the row.
  let root = wet_claim_root(tag: "deployed-writes" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let attempt = probe_attempt_dir(instance: inst)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && prepare_probe_attempt(instance: inst)
    && worker_shape_runs_an_allowed_touch(instance: inst, root: root)
    && sandbox_touch_write_refused(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-bin.service" as NonEmptyStr,
      path: join([inst.serve_binary as String, ".write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-tree.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.gunbc-worker-write-probe"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-binding.service" as NonEmptyStr,
      path: join([attempt, "/request-binding.json"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-attempt-file.service" as NonEmptyStr,
      path: join([attempt, "/forged-owner-record"], ""),
    )
    && sandbox_touch_write_refused(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-hook.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn the_worker_worktree_is_writable_inside_the_same_sandbox() -> Bool {
  // THE WRITABLE SIDE OF THE SAME PAIR. A sandbox that refused everything would satisfy the
  // refusal claims above by accident, so this claim is the reason the refusals mean anything --
  // and it can only say that about a worktree the claim created. Under the live row the granted
  // tree was the deployment's, which is the half of the pair the confinement witness had no
  // business writing to.
  let root = wet_claim_root(tag: "worktree-writable" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wt = probe_attempt_worktree(instance: inst)
  let scratch = probe_worker_dir(instance: inst)
  let probe = join([wt, "/.gunbc-worker-write-probe"], "")
  let log_probe = join([scratch, "/.gunbc-worker-write-probe"], "")
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    // THE PLANT THIS CLAIM WAS MISSING. Its unit shape launches, so it has to name the tree's
    // commit like every other launching leg; without a plant `git rev-parse --verify HEAD` answered
    // 'not a git repository' and the leg refused for the wrong reason (measured at 74683828, and
    // the same route is what would have made a third srv2 run fail).
    && wet_plant_confined_tree(instance: inst)
    && prepare_probe_attempt(instance: inst)
    && sandbox_touch_wrote(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-wt.service" as NonEmptyStr,
      path: probe,
    )
    && sandbox_touch_wrote(
      instance: inst,
      root: root,
      unit: "gunbc-writable-probe-log.service" as NonEmptyStr,
      path: log_probe,
    )
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe]).exit_code == 0
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

fn sandbox_touch_cli(path: String) -> ProcessExit {
  if Filesystem.Write(path: path, content: "probe\n").success {
    ExitSuccess
  } else {
    exit_failure(reason: "sandbox touch write refused")
  }
}

// THE WITNESS FILE, RELATIVE TO WHICHEVER TREE IT IS READ FROM. One row, two roots: the unit's inner
// side runs it out of the copied source tree (GUNBC_WORKSPACE_ROOT is unset there, so the CLI walks to
// the .git ancestor and the tree is its own root -- src/v1/stage0/src/cli_run.rs:562 says "WHEN UNSET
// nothing changes"), and the drain runs it out of the INSTALLED LOCUS, where the same env is set
// explicitly and the entry has to sit under the root the env names. Two literals for the same file is
// how a drain and an inner side drift apart.
data wet_witness_entry_relative: NonEmptyStr =
  "dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag"

fn wet_witness_entry(instance: HostDashboardInstance) -> String {
  join([instance.repo_root as String, "/", wet_witness_entry_relative as String], "")
}

// THE SAME FILE, INSIDE THE LOCUS THE DRAIN NAMES. `repo_relative_path_normalized` refuses an entry
// outside the process workspace root, so a drain that sets GUNBC_WORKSPACE_ROOT to the locus and hands
// over a source-tree entry panics 101 before it drains anything.
fn wet_witness_entry_in_locus(instance: HostDashboardInstance, revision_text: String) -> String {
  join(
    [
      witness_locus_dir_text(instance: instance, revision_text: revision_text),
      "/",
      wet_witness_entry_relative as String,
    ],
    "",
  )
}

// THE GATE AS ONE STRING, for legs whose verdict is a chain of `&&`s rather than a match: the revision
// on success, "" when the leg must not run. The empty string is never an unexplained stop --
// `wet_locus_gate` has already put the cause in the stage trail, which is where stern reads it.
fn wet_locus_gate_text(instance: HostDashboardInstance, label: String) -> String {
  match wet_locus_gate(instance: instance, label: label) {
    Present { value: revision } => revision
    Absent => ""
  }
}

// THE ONE ARGV THE IMAGE IS ASKED TO SERVE WITH. The elevated drain and the unprivileged served-image
// probe both get their words from here, and neither passes a path the other invented: workspace root,
// binary, both `--source-root` values and the entry come from the fixture's locus accessors, which are
// production's `helper_locus_dir` over the row. This is precisely what srv2's S1 at `114bcf31` caught:
// the drain named `instance.repo_root` -- a copied tree with no receipt -- and the CLI refused it at
// `cli_run.rs:611` before a single sandbox conjunct ran, while nothing in the witness could see that
// the drain and the probe had drifted into two different routes. Elevation is NOT part of this builder:
// the drain wraps these words in `sudo_elevate_command`, the probe runs them as itself, and that is the
// whole difference between them.
fn wet_image_serve_argv(
  instance: HostDashboardInstance,
  revision_text: String,
  entry_relative: NonEmptyStr,
  function: NonEmptyStr,
) -> List<NonEmptyStr> {
  gunbc_entry_run_argv(
    workspace_root: witness_locus_dir_text(instance: instance, revision_text: revision_text) as NonEmptyStr,
    binary: witness_locus_binary_path(instance: instance, revision_text: revision_text) as NonEmptyStr,
    source_roots: map(
      witness_locus_source_roots(instance: instance, revision_text: revision_text),
      s => s as NonEmptyStr,
    ),
    entry: join(
      [
        witness_locus_dir_text(instance: instance, revision_text: revision_text),
        "/",
        entry_relative as String,
      ],
      "",
    ) as NonEmptyStr,
    function: function,
  )
}

// THE SERVED-ROUTE ARGV, ONCE. One builder owns the flag words the instance gunbc takes on its served
// route (`run --source-root … --entry … --function …` plus caller extras); the launcher legs pass the
// witness entry and the served-image probe passes its own tiny module. Written as one builder rather
// than two because the probe's whole value is that it asks about the SAME route the launch legs use --
// a probe with its own copy of the flag words could stay green while the route the claims need broke.
// THE PROGRAM IS NOT AN ARGUMENT: the tail below starts at `run`, because `shell.Exec.RunArgv` takes
// the program as its own input (extdeps/shell/exec.dag:73 says exactly this, and repeating the program
// as argv[0] makes the CLI read it as a subcommand). A unit's inner command is the opposite shape --
// the manager expands it as a word list with the program in front -- so `launcher_gunbc_run_inner_argv`
// prepends it there and nowhere else.
fn wet_served_run_tail(entry: String, function: String, extra_args: List<String>, repo_root: String) -> List<String> {
  concat(
    [
      "run",
      "--source-root", join([repo_root, "/dag"], ""),
      "--source-root", join([repo_root, "/src/v2"], ""),
      "--entry", entry,
      "--function", function,
    ],
    extra_args,
  )
}

fn launcher_gunbc_run_inner_argv(instance: HostDashboardInstance, function: String, extra_args: List<String>) -> List<String> {
  concat(
    [instance.serve_binary as String],
    wet_served_run_tail(
      entry: wet_witness_entry(instance: instance),
      function: function,
      extra_args: extra_args,
      repo_root: instance.repo_root as String,
    ),
  )
}

fn launcher_touch_inner_argv(instance: HostDashboardInstance, path: String) -> List<String> {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => []
    NamedArgumentNameHoldsSeparator { name: _ } => []
    NamedArgumentAdmitted { argument: arg } =>
      launcher_gunbc_run_inner_argv(
        instance: instance,
        function: "sandbox_touch_cli",
        extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
      )
  }
}

fn sudo_n_true_cli() -> ProcessExit {
  let r = shell.Exec.RunArgvOutcome(program: "/usr/bin/sudo", arguments: ["-n", "true"])
  // Two different no-answers, and the leg must say which: sudo refused the command (the sandbox's
  // doing, the thing under test) versus sudo could not be spawned at all (the host has no root
  // launcher). Collapsing them would let an unprovisioned host read as a confinement PASS.
  match r.outcome {
    ShellSpawnRefused { program: _, cause: _ } => exit_failure(reason: "needs a root launcher: sudo could not be spawned in this unit")
    ShellExited => if r.exit_code == 0 { ExitSuccess } else { exit_failure(reason: "sudo -n true refused") }
  }
}

fn sudo_n_touch_cli(path: String) -> ProcessExit {
  let r = shell.Exec.RunArgvOutcome(program: "/usr/bin/sudo", arguments: ["-n", "/usr/bin/touch", "--", path])
  match r.outcome {
    ShellSpawnRefused { program: _, cause: _ } => exit_failure(reason: "needs a root launcher: sudo could not be spawned in this unit")
    ShellExited => if r.exit_code == 0 { ExitSuccess } else { exit_failure(reason: "sudo -n touch refused") }
  }
}

fn launcher_write_refused(instance: HostDashboardInstance, unit_key: String, path: String, root: NonEmptyStr) -> Bool {
  let existed_before = wet_path_exists(path: path)
  wet_write_refused(touch: launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path, root: root), existed_before: existed_before, path: path)
}

fn launcher_wrote(instance: HostDashboardInstance, unit_key: String, path: String, root: NonEmptyStr) -> Bool {
  match launcher_sandbox_touch(instance: instance, unit_key: unit_key, path: path, root: root) {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code == 0 && wet_path_exists(path: path)
  }
}

// The two readbacks the plant claim needs, BOTH through declared effect sites: `Filesystem.Read`
// for the entry's bytes and `stat -c %a` for the served binary's mode. A `cmp`/`test` via
// shell.Exec.RunArgv would be an undeclared dispatch (the run reports it on the expectation
// frontier) and would answer with a spawn refusal rather than a reading.
fn wet_file_text(path: String) -> String {
  let r = Filesystem.Read(path: path)
  match filesystem_exact_read(
    path: path,
    content: r.content,
    success: r.success,
    error: r.error,
    error_kind: r.error_kind,
  ) {
    FilesystemExactPathRead { path: _, content: text } => text
    unreadable => ""
  }
}

fn wet_octal_mode(path: String) -> String {
  wet_out(command: stat_mode_command(path: path))
}

test fn the_planted_guest_inputs_reach_the_paths_the_row_derives() -> Bool {
  // WHY THIS CLAIM EXISTS HERE AND NOT ONLY ON SRV2. Six of the legs below exec the guest binary
  // the row derives (`serve_binary run --source-root <repo>/dag --entry <repo>/dag/...`), and the
  // launch itself needs `systemd-run`, which this container does not have. Without a readback
  // that runs in this lane the plant would never be checked anywhere the wet lane can see, and a
  // plant that copied the wrong tree would surface on srv2 as a guest-side parse error rather
  // than as a witness failure. This is the single-principal half of that path: the guest's READ
  // inputs, at the paths the row derives. The guest is not exec'd here -- a second cold entry
  // parse nested in this process does not fit the container's 24 GiB memory cgroup when one entry
  // parse alone measures 16 GiB -- so the exec itself stays queued for srv2, where the launcher
  // legs go with it.
  let root = wet_claim_root(tag: "plant" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let checkout = wet_out(command: pwd_command())
  // The launcher is handed `wet_witness_entry(instance: inst)` -- an accessor over the row, so
  // if the row's repo_root derivation changes this leg moves with it instead of passing on a
  // restated literal.
  let entry = wet_witness_entry(instance: inst)
  let planted = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_guest_sources(instance: inst)
    && wet_path_exists(path: entry)
    // BYTES, not just existence: a plant that copied a stale or different `dag/` would leave the
    // path present and the leg vacuous, so the planted entry is compared against the checkout the
    // host reports it was copied from. An EMPTY read is refused too -- both sides unreadable would
    // otherwise compare equal and pass.
    && checkout != ""
    && wet_file_text(path: entry) != ""
    && wet_file_text(path: entry)
         == wet_file_text(path: join([checkout, "/dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag"], ""))
    && wet_path_exists(path: join([inst.repo_root as String, "/dag"], ""))
    && wet_path_exists(path: join([inst.repo_root as String, "/src/v2"], ""))
  // THE VERDICT IS BOUND FIRST, THEN THE ROOT IS TAKEN AWAY -- AND A ROOT LEFT BEHIND REDDENS THIS
  // CLAIM. The srv2 run of 54f3b519 reported FAIL here for `rm -rf <root>/source/.git: Directory not
  // empty` after every conjunct above had passed (housekeeping read as a verdict); the fa64a4b9 run
  // went the other way and logged the same failure as housekeeping `ok` while the tree stayed on
  // disk. Both readings were wrong, and the shared cause is that nobody asked the filesystem. The
  // verdict is computed and bound first so a plant fault is never confused with a scratch fault; the
  // removal then runs with the elevated retry and settles, and its readback is a conjunct of what the
  // claim returns -- leftover scratch is a real defect, not a log line.
  wet_claim_verdict_with_root_readback(verdict: planted, root: root)
}


// THE OTHER HALF OF THE PLANT, RUN WHERE THE OPERATOR NAMES THE BINARY. This claim is deliberately
// NOT scheduled in `src/v2/workflow/local_repo_wet_terminal.dag`: its precondition is that the
// operator running the batch has exported `GUNBC_WET_SERVE_BINARY`, and a scheduled row that is
// green only where someone pre-provisioned an input is the exact defect this RFM row files. It is
// executed here (the lane's own binary) and on srv2 (the binary that run builds), and the gap is
// named in the PR body's "Known gaps, NOT covered".
test fn the_planted_serve_binary_is_the_image_the_operator_named() -> Bool {
  let root = wet_claim_root(tag: "plant-bin" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_guest_binary(instance: inst)
    // The mode is read back, not trusted from the `install -m` that wrote it: a served binary that
    // is not executable makes every launcher leg refuse for a reason that is not confinement.
    && wet_octal_mode(path: inst.serve_binary as String) == "755"
    && wet_path_is_executable(path: inst.serve_binary as String)
    // AND IT HAS TO SERVE. Mode and the executable bit are what this claim used to stop at, which is
    // how srv2 (stern, 2026-11-04) went GREEN here while the image it had been handed was the batch
    // runner and all nine launch legs were already dying on `unknown argument: run`. An image that
    // cannot answer the route is not the image the operator named, whatever its mode says.
    && wet_plant_guest_sources(instance: inst)
    && wet_stage(
      stage: "served-image-answers-the-route",
      ok: wet_served_image_answers_under_locus(instance: inst),
    )
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn writes_through_the_launcher_to_bin_and_source_hooks_are_refused() -> Bool {
  // THE LAUNCHER IS REFUSED THE SAME TWO PLACES the shape path is. Under the live row the two
  // paths named below were the deployment's own bin directory and the deployment's own source
  // hooks, so "refused" was a statement about where the witness had been writing, not about the
  // launcher's policy. The launcher's guest runs `run --source-root <repo>/dag --entry ...` from
  // the supplied row, so the tree has to be planted for the leg to reach the policy at all.
  let root = wet_claim_root(tag: "launcher-refused" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_write_refused(
      instance: inst,
      root: root,
      unit_key: "bin",
      path: join([path_parent_directory(path: inst.serve_binary as String), "/.write-probe"], ""),
    )
    && launcher_write_refused(
      instance: inst,
      root: root,
      unit_key: "hooks",
      path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""),
    )
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

// THE LAUNCHER DERIVES THE WORKTREE, LOG DIRECTORY AND EXIT HOOK from the attempt identity (review
// 80324), so each launcher cell is its own attempt (wetprobe-<unit_key>) and prepares that attempt's
// state and worktree the way the belt does before it starts.
fn launcher_probe_key(unit_key: String) -> String {
  join([wet_probe_key, "-", unit_key], "")
}

fn launcher_probe_worktree(instance: HostDashboardInstance, unit_key: String) -> String {
  dispatch_worktree_path_for_instance(instance: instance, node_id: wet_probe_node, attempt_key: launcher_probe_key(unit_key: unit_key))
}

fn launcher_probe_worker_dir(instance: HostDashboardInstance, unit_key: String) -> String {
  path_parent_directory(path: attempt_log_member_text(instance: instance, node_id: wet_probe_node, attempt_key: launcher_probe_key(unit_key: unit_key), member: AttemptWorkerLog))
}

fn prepare_launcher_probe(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let preps = attempt_state_prepare_argvs_for_instance(
    instance: instance,
    node_id: wet_probe_node,
    attempt_key: launcher_probe_key(unit_key: unit_key),
  )
  fold(preps, init: true, f: (ok, p) => ok && shell.Exec.RunArgv(program: p.program, arguments: p.args).exit_code == 0)
    && shell.Exec.RunArgv(program: "install", arguments: ["-d", "--", launcher_probe_worktree(instance: instance, unit_key: unit_key)]).exit_code == 0
}

fn launcher_inner_start(instance: HostDashboardInstance, unit_key: String, inner: List<String>, root: NonEmptyStr) -> SandboxTouch {
  match inner.first() {
    Absent => SandboxTouchUnrunnable
    Present { value: _ } => {
      let request = AttemptSystemUnitStartRequest {
        node_id: wet_probe_node as String,
        attempt_key: wet_attempt_key(root: root, label: launcher_probe_key(unit_key: unit_key)),
        granted: kibibyte(count: 65536),
        inner_argv: inner,
        nonce: wet_run_nonce(),
      }
      if !wet_stage(
        // SAME ASK, SAME REASON, THIS ROUTE TOO: launcher legs reach a manager through
        // attempt_system_unit_enqueue_start_wait rather than wet_worker_unit_start, so the image has
        // to be asked here as well or the nine legs keep discovering the wrong image from the inside
        // of a launched unit. A leg that cannot run its guest is not a sandbox verdict.
        stage: join(["served-image-answers-the-route:", unit_key], ""),
        ok: wet_served_image_answers_under_locus(instance: instance),
      ) {
        SandboxTouchUnrunnable
      } else if !prepare_launcher_probe(instance: instance, unit_key: unit_key) {
        SandboxTouchUnrunnable
      } else if !wet_stage(
        // THE SPOOL TREE, BEFORE ANYTHING IS ENQUEUED. The envelope write makes the request-staging
        // directory the drain later mkdir's into; on the srv2 run of 54f3b519 four legs failed with
        // `mkdir .../attempt-unit-spool/requests-staging/<x>.staging: No such file or directory`
        // because only prepare_probe_attempt made these directories and the launcher legs never
        // called it. It is now a stage of every launcher leg, derived from the row's own accessors.
        stage: join(["spool-tree-prepared:", unit_key], ""),
        ok: wet_prepare_attempt_unit_spool(instance: instance),
      ) {
        SandboxTouchUnrunnable
      } else {
        let before = wet_record_names(instance_root: instance.instance_root as String, unit_key: unit_key)
        match attempt_system_unit_enqueue_start_wait(
          instance_root: instance.instance_root as String,
          request: request,
        ) {
          AttemptSystemUnitEnqueueRefused { detail: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueueOccupied { entry: _ } => SandboxTouchUnrunnable
          AttemptSystemUnitEnqueued { entry: entry, body: body } =>
            // THE ROOT SIDE, PERFORMED BY THE CLAIM. Production's answer comes from a root process
            // (the drain .service); where that host installation is absent nothing ever drains the
            // queue, and the leg used to sit out its full 240 s and then report a missing marker as
            // if it were a sandbox verdict. The claim now performs the same root side itself, and
            // each conjunct reports which one failed.
            if wet_root_drain_elevated(instance: instance, root: root, unit_key: unit_key, entry_name: entry)
              && wet_stage(stage: join(["unit-retired:", unit_key], ""), ok: wet_retire_unit(root: root, label: launcher_probe_key(unit_key: unit_key)))
              && wet_drain_started(
                instance_root: instance.instance_root as String,
                entry: entry,
                request_body: body,
                stage_label: join(["answer-arrived:", unit_key], ""),
              ) {
                // THE RECORD IS OBSERVED ONCE. `wet_stage_of` takes `ok:` and `value:` by value, so spelling
                // the wait twice spelled the POLL twice -- two full 240-beat waits over the same attempt
                // stages inside one leg. Binding it is not a style point: srv2's S1 at 4ffbdfcc (stern) put
                // 570 s of CPU and 36.6M eval steps into this leg, and each beat is not free -- it re-lists
                // inbox, queued, running, done and refused and filters the names against a snapshot, and
                // `done/` is retained across runs on purpose (the belt's evidence).
                let exit_status = wet_inner_exit_status(
                  instance_root: instance.instance_root as String,
                  unit_key: unit_key,
                  before: before,
                )
                wet_stage_of(
                  stage: join(["unit-exit-observed:", unit_key], ""),
                  ok: match exit_status {
                    SandboxTouchUnrunnable => false
                    SandboxTouchRan { exit_code: _ } => true
                  },
                  value: exit_status,
                )
            } else {
              SandboxTouchUnrunnable
            }
        }
      }
    }
  }
}

fn launcher_sandbox_touch(instance: HostDashboardInstance, unit_key: String, path: String, root: NonEmptyStr) -> SandboxTouch {
  launcher_inner_start(instance: instance, unit_key: unit_key, inner: launcher_touch_inner_argv(instance: instance, path: path), root: root)
}

fn launcher_sudo_n_true(instance: HostDashboardInstance, root: NonEmptyStr) -> SandboxTouch {
  launcher_inner_start(
    instance: instance,
    unit_key: "sudo-n-true",
    inner: launcher_gunbc_run_inner_argv(instance: instance, function: "sudo_n_true_cli", extra_args: []),
    root: root,
  )
}

fn launcher_sudo_n_touch(instance: HostDashboardInstance, path: String, root: NonEmptyStr) -> SandboxTouch {
  match admit_named_argument(name: "path", value: path) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: arg } =>
      launcher_inner_start(
        instance: instance,
        unit_key: "sudo-n-touch",
        inner: launcher_gunbc_run_inner_argv(
          instance: instance,
          function: "sudo_n_touch_cli",
          extra_args: ["--arg", join([arg.name, "=", arg.value], "")],
        ),
        root: root,
      )
  }
}

test fn sudo_n_true_fails_inside_the_launched_unit() -> Bool {
  // THE UNIT CANNOT ESCALATE. The leg is only evidence if the unit it launched was launched
  // against a lab the claim made: under the live row the escalation attempt ran with the live
  // install as its subject, and the tree it could have touched afterwards was the served one.
  let root = wet_claim_root(tag: "sudo-true" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && match launcher_sudo_n_true(instance: inst, root: root) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code != 0
    }
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn sudo_n_touch_of_instance_bin_fails_inside_the_launched_unit() -> Bool {
  // ESCALATION DOES NOT BUY THE DEPLOYED TREE EITHER. The path is an accessor over the row --
  // the bin directory of the instance the claim supplied -- and the directory is planted, so the
  // refusal is the unit's filesystem policy rather than a missing parent.
  let root = wet_claim_root(tag: "sudo-touch" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let escaped_target = join([path_parent_directory(path: inst.serve_binary as String), "/x"], "")
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && prepare_probe_attempt(instance: inst)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && wet_write_refused(
      touch: launcher_sudo_n_touch(instance: inst, path: escaped_target, root: root),
      existed_before: wet_path_exists(path: escaped_target),
      path: escaped_target,
    )
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn writes_through_the_launcher_to_the_worktree_worker_dir_and_git_objects_are_allowed() -> Bool {
  // THE ALLOWED SIDE OF THE LAUNCHER POLICY. These are the writes the launcher is supposed to
  // let through, so they are the half that keeps the refusals above from being a sandbox that
  // simply blocks everything -- and a sandbox that writes the deployment's own worktree, log
  // directory and object store proves nothing about what it would allow. The three targets are
  // accessors over the supplied row; the directories under them are planted by the claim.
  let root = wet_claim_root(tag: "launcher-allowed" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let objects = join([inst.repo_root as String, "/.git/objects/.gunbc-worker-write-probe"], "")
  let probe = join([launcher_probe_worktree(instance: inst, unit_key: "wt"), "/.gunbc-launcher-write-probe"], "")
  let log_probe = join([launcher_probe_worker_dir(instance: inst, unit_key: "log"), "/.gunbc-launcher-log-probe"], "")
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_wrote(instance: inst, unit_key: "wt", path: probe, root: root)
    && launcher_wrote(instance: inst, unit_key: "log", path: log_probe, root: root)
    && launcher_wrote(instance: inst, unit_key: "objects", path: objects, root: root)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe, log_probe, objects]).exit_code == 0
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

fn exit_success_cli() -> ProcessExit {
  ExitSuccess
}

fn launcher_exit_record_names(instance: HostDashboardInstance) -> List<String> {
  let inbox = attempt_exit_inbox_dir(instance_root: instance.instance_root as String)
  let listing = Filesystem.List(path: inbox)
  let observed = filesystem_listing_observation(
    directory: inbox,
    success: listing.success,
    entries: listing.entries,
    error: listing.error,
  )
  match observed {
    FilesystemDirectoryListed(listed) =>
      filter(
        filesystem_listing_entry_names(listing: listed),
        n => string_contains(s: n, pattern: join([wet_probe_node as String, "+", wet_probe_key, "-exitrec", "+worker+"], "")),
      )
    _ => []
  }
}

fn launcher_exit_record_is_expanded(name: String) -> Bool {
  let unexpanded = join(["$", "{"], "")
  !string_contains(s: name, pattern: unexpanded)
    && match attempt_exit_entry_decode(entry_name: name) {
      AttemptExitEntryMalformed { entry_name: _, reason: _ } => false
      AttemptExitEntryDecoded { record } =>
        string_length(s: record.invocation_id) == 32
          && !string_contains(s: record.invocation_id, pattern: unexpanded)
          && match record.result {
            ServiceResultSuccess =>
              match record.end {
                AttemptProcessExitedWith { status } => status == 0
                _ => false
              }
            _ => false
          }
    }
}

test fn a_launched_unit_exit_record_names_the_expanded_invocation_and_result() -> Bool {
  // THE EXIT RECORD IS READ BACK FROM THE CLAIM'S OWN INBOX. The record has to name the expanded
  // invocation of a guest the claim installed; under the live row the "expanded invocation" was
  // the deployment's, and the inbox the record was read out of was the served one -- an exit
  // record written into the live lab is an effect, not an observation.
  let root = wet_claim_root(tag: "exit-record" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && match launcher_inner_start(
      instance: inst,
      root: root,
      unit_key: "exitrec",
      inner: launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []),
    ) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code: _ } =>
        match launcher_exit_record_names(instance: inst).first() {
          Absent => false
          Present { value: name } => launcher_exit_record_is_expanded(name: name)
        }
    }
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

// THE ROOT-EXEC SHAPE IS REFUSED ON THE REAL PATH (review 80324). Before the launcher derived the exit
// hook, a requester-written pending body could name `+/usr/bin/touch <marker>` as ExecStopPost, which
// systemd runs with full privileges whatever User= says. This cell writes that earlier wide body
// through the same pending file and runs the real launcher argv: the launcher must refuse the body, and
// no root-created marker may appear.
data launcher_root_hook_marker: String = "/tmp/gunbc-launcher-root-hook-probe"

fn launcher_marker_absent() -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["!", "-e", launcher_root_hook_marker]).exit_code == 0
}

test fn a_wide_request_naming_a_root_exit_hook_is_refused_by_the_launcher() -> Bool {
  // THE WIDE BODY NAMES THE CLAIM'S ROW, NOT THE DEPLOYMENT'S. The forged ExecStopPost and the
  // inner invocation are both built from the supplied row, so the refusal is the launcher
  // refusing a root-exec shape aimed at a lab this claim made -- and the marker it must not
  // leave behind is checked against a tree the claim owns.
  let root = wet_claim_root(tag: "root-hook-refusal" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wide = join([
    "start-wait", wet_probe_node as String, launcher_probe_key(unit_key: "roothook"),
    inst.directory_owner.user as String, inst.repo_root as String,
    launcher_probe_worktree(instance: inst, unit_key: "roothook"), "/tmp/gunbc-roothook.out", "/tmp/gunbc-roothook.err",
    "65536", join(["+/usr/bin/touch ", launcher_root_hook_marker], ""),
    join(launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []), "\u{1f}"),
    wet_run_nonce(),
  ], "\n")
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && launcher_marker_absent()
    && prepare_launcher_probe(instance: inst, unit_key: "roothook")
    // THE SAME SPOOL TREE, ON THE ROUTE THAT ENQUEUES DIRECTLY. This leg is the one launcher claim
    // that does not go through launcher_inner_start (it enqueues a hand-written wide body), so the
    // stage above has to be named here too -- otherwise this is exactly the claim that reproduced
    // the requests-staging ENOENT on the srv2 run of 54f3b519.
    && wet_stage(stage: "spool-tree-prepared:roothook", ok: wet_prepare_attempt_unit_spool(instance: inst))
    && match attempt_system_unit_enqueue_request(
      instance_root: inst.instance_root as String,
      node_id: wet_probe_node as String,
      attempt_key: launcher_probe_key(unit_key: "roothook"),
      body: wide,
    ) {
      AttemptSystemUnitEnqueued { entry: entry, body: body } =>
        wet_root_drain_elevated(instance: inst, root: root, unit_key: "roothook", entry_name: entry)
          && wet_stage(stage: "unit-retired:roothook", ok: wet_retire_unit(root: root, label: launcher_probe_key(unit_key: "roothook")))
          && wet_drain_answer_arrives(
            instance_root: inst.instance_root as String,
            entry: entry,
            request_body: body,
            stage_label: "answer-arrived:roothook",
          )
          && launcher_run_refused(instance: inst, entry: entry, request_body: body) && launcher_marker_absent()
      AttemptSystemUnitEnqueueOccupied { entry: _ } => false
      AttemptSystemUnitEnqueueRefused { detail: _ } => false
    }
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

// THE ROOT SIDE RUNS WHEN THE REQUEST DIRECTORY FILLS (the drain .path unit starts the system
// oneshot), so a wet claim writes its request and then OBSERVES the answer the root helper leaves; it
// no longer runs the helper itself and holds no sudo grant. The wait is this witness's own bound, not
// the serve handler's: the handler never waits.
// THE WAIT'S OWN BOUND, NAMED ONCE. 240 one-second beats, the number this witness has always used; it is
// a data so a reader can see the bound without counting literals, and so a change is a deliberate edit on
// one line rather than a tune applied to whichever leg is currently red.
data wet_answer_wait_beats: Int = 240

type WetAnswerWait
  = WetAnswerArrived { verdict: String }
  | WetAnswerEchoMismatch { path: String, echoed_chars: Int, wanted_chars: Int }
  | WetAnswerNeverArrived { path: String, beats: Int }
  | WetAnswerUnreadable { path: String, detail: String }

// AN ANSWER THAT IS NOT THIS REQUEST'S IS NOT AN ANSWER THAT HAS NOT ARRIVED, and a waiter that cannot
// tell the two apart can only ever report "it did not happen". `attempt_system_unit_decode_answer`
// answers "is this the answer to MY request" by comparing the body the root side echoed with the body the
// claim holds, and when they differ it returns the SAME arm as "nothing has been written yet"
// (AttemptSystemUnitAnswerMissing) -- correctly, for a reader: answers/<entry> is keyed by node and
// attempt key only and outlives the request, so an answer left by an earlier run must not be read as this
// run's outcome. Fatal, for a waiter: srv2's S1 at 4ffbdfcc (stern) ran the launcher leg through
// `claim-locus-installed`, `served-image-answers-the-route`, `spool-tree-prepared`,
// `elevated-drain-ran` and `unit-retired` -- all ok -- then `answer-arrived FAILED` after 1,656 s wall /
// 570 s CPU / 36.6M eval steps with NOTHING on the trail about what it looked for or what it found. A
// drain that ran and retired its unit, followed by an answer that never "arrives", is exactly what an
// echo mismatch looks like from here, and it is also what a genuinely absent answer looks like.
//
// So the bound is kept EXACTLY as it was -- 240 one-second beats, the same beat, the same route -- with no
// widening and no bigger timeout (DESIGN 5: a stop that is not reached becomes a false claim, and a
// timeout raised to make a leg green is a tune, not a finding). What changes is that the wait now returns
// WHY it stopped, read at the bound from the file itself through the same declared effect site the reader
// uses, so the next run answers its own question instead of needing a bespoke read on the host:
//   never-arrived   nothing exists at the answer path (the root side never wrote)
//   echo-mismatch   the answer path EXISTS, so the root side did answer, but to another request body
//   unreadable      the path holds something that is not an answer at all
fn wet_answer_wait(instance_root: String, entry: String, request_body: String) -> WetAnswerWait {
  wet_answer_wait_poll(
    instance_root: instance_root,
    entry: entry,
    request_body: request_body,
    remaining: wet_answer_wait_beats,
    waited: 0,
  )
}

// `waited` is carried, not inferred from the bound: a zero-beat probe (which is what makes these outcomes
// testable here, and what the discriminator claim uses) must not report that it waited the whole bound.
// The refusal names how long it ACTUALLY waited.
fn wet_answer_wait_poll(
  instance_root: String,
  entry: String,
  request_body: String,
  remaining: Int,
  waited: Int,
) -> WetAnswerWait {
  match attempt_system_unit_read_answer(instance_root: instance_root, entry: entry, request_body: request_body) {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => WetAnswerArrived { verdict: "started" }
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: reason } } =>
      WetAnswerArrived { verdict: join(["refused: ", reason], "") }
    AttemptSystemUnitAnswerUnreadable { detail: detail } =>
      WetAnswerUnreadable {
        path: attempt_system_unit_answer_path(instance_root: instance_root, entry: entry),
        detail: detail,
      }
    AttemptSystemUnitAnswerMissing =>
      if remaining <= 0 {
        wet_answer_wait_at_bound(
          instance_root: instance_root,
          entry: entry,
          request_body: request_body,
          beats: waited,
        )
      } else {
        let _ = shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"])
        wet_answer_wait_poll(
          instance_root: instance_root,
          entry: entry,
          request_body: request_body,
          remaining: remaining - 1,
          waited: waited + 1,
        )
      }
  }
}

// THE DISTINCTION IS MADE ONCE, AT THE BOUND, BY THE FILE -- not by waiting longer. A read that fails is
// "never arrived"; a read that succeeds but carries no separator is "unreadable"; a read that succeeds and
// carries the separator is an answer the reader refused for THIS request, which is the echo mismatch. The
// sizes are reported rather than the bodies: the bodies are the claim's own serialized request and the
// root side's echo of it, and the difference is a fact about their shape, not something to leak into a
// trail that stern pastes into a report.
fn wet_answer_wait_at_bound(
  instance_root: String,
  entry: String,
  request_body: String,
  beats: Int,
) -> WetAnswerWait {
  let path = attempt_system_unit_answer_path(instance_root: instance_root, entry: entry)
  let raw = Filesystem.Read(path: path)
  if !raw.success {
    WetAnswerNeverArrived { path: path, beats: beats }
  } else {
    let parts = split(s: raw.content, delimiter: attempt_system_unit_answer_body_separator)
    match parts.first() {
      Absent => WetAnswerUnreadable { path: path, detail: "the answer is empty" }
      Present { value: echoed } =>
        match parts[1] {
          Absent => WetAnswerUnreadable { path: path, detail: "the answer carries no request body echo" }
          Present { value: _ } =>
            WetAnswerEchoMismatch {
              path: path,
              echoed_chars: string_length(echoed),
              wanted_chars: string_length(request_body),
            }
        }
    }
  }
}

// ONE SPELLING OF THE OUTCOME FOR THE TRAIL, so every wait in this witness reports in the same words and a
// grep on srv2 can tell the three apart without reading the code.
fn wet_answer_wait_text(wait: WetAnswerWait) -> String {
  match wait {
    WetAnswerArrived { verdict: verdict } => join(["arrived ", verdict], "")
    WetAnswerNeverArrived { path: path, beats: beats } =>
      join(["never-arrived after ", to_string(value: beats), " beats at ", path], "")
    WetAnswerEchoMismatch { path: path, echoed_chars: echoed_chars, wanted_chars: wanted_chars } =>
      join([
        "echo-mismatch: an answer EXISTS at ", path,
        " but echoes ", to_string(value: echoed_chars), " chars against this request's ",
        to_string(value: wanted_chars), " -- the root side answered another request",
      ], "")
    WetAnswerUnreadable { path: path, detail: detail } =>
      join(["unreadable at ", path, ": ", detail], "")
  }
}

fn wet_answer_wait_arrived(wait: WetAnswerWait) -> Bool {
  match wait {
    WetAnswerArrived { verdict: _ } => true
    _ => false
  }
}

fn wet_answer_wait_started(wait: WetAnswerWait) -> Bool {
  match wait {
    WetAnswerArrived { verdict: verdict } => verdict == "started"
    _ => false
  }
}

// THE WAIT REPORTS ITSELF. Each leg used to wrap the Bool in its own `wet_stage`, which meant the only
// thing the trail could ever carry was "answer-arrived:bin false"; the cause the wait knew (or did not
// know) never appeared. The wrapper now owns the stage line, keeping the leg's label as the prefix so the
// greps already written against `answer-arrived:<unit>` still hit.
fn wet_drain_answer_arrives(
  instance_root: String,
  entry: String,
  request_body: String,
  stage_label: String,
) -> Bool {
  let wait = wet_answer_wait(instance_root: instance_root, entry: entry, request_body: request_body)
  let arrived = wet_answer_wait_arrived(wait: wait)
  if wet_stage(stage: join([stage_label, " ", wet_answer_wait_text(wait: wait)], ""), ok: arrived) {
    arrived
  } else {
    false
  }
}

// THE INNER RESULT IS READ FROM THE ATTEMPT'S OWN EXIT RECORD, never inferred from the drain. The drain
// answers Started when the unit has been started and does not wait for it, so the answer says only that
// the unit ran, not whether the command inside it succeeded; the ExecStopPost record carries that
// (record.end). A claim that took "an answer arrived" for the inner command's result would score a unit
// that never executed as a refused write (DESIGN 4b: dissolving the sudo route may delete its
// machinery, never the discriminating RED and its positive control). Missing, unreadable or Refused
// answers, a record that never lands, and a signalled end are all SandboxTouchUnrunnable: the claim is
// false, never counted as refused. attempt_exit_record_observe reads inbox, queued, running, done and
// refused, so the belt-exit drain moving the record between stages cannot hide it.
fn wet_drain_started(
  instance_root: String,
  entry: String,
  request_body: String,
  stage_label: String,
) -> Bool {
  let wait = wet_answer_wait(instance_root: instance_root, entry: entry, request_body: request_body)
  let started = wet_answer_wait_started(wait: wait)
  if wet_stage(stage: join([stage_label, " ", wet_answer_wait_text(wait: wait)], ""), ok: started) {
    started
  } else {
    false
  }
}

// THE RECORD IS BOUND TO THIS START. Probe keys are fixed across runs and done/ is retained (the belt's
// evidence, never deleted to make room), so an earlier run's record answers a search by (node, key, role)
// before this run's unit has written anything. The names present before the enqueue are snapshotted and
// only a record outside the snapshot is this run's; two new ones are ambiguous and Unrunnable.
type WetRecordNames
  = WetRecordNamesListed { names: List<String> }
  | WetRecordNamesUnreadable

fn wet_record_names(instance_root: String, unit_key: String) -> WetRecordNames {
  let prefix = join([wet_probe_node as String, "+", launcher_probe_key(unit_key: unit_key), "+worker+"], "")
  fold(
    attempt_exit_stage_listings(instance_root: instance_root),
    init: WetRecordNamesListed { names: [] },
    f: (acc, listing) => match acc {
      WetRecordNamesUnreadable => WetRecordNamesUnreadable
      WetRecordNamesListed { names: so_far } =>
        match listing {
          AttemptExitStageUnreadable { reason: _ } => WetRecordNamesUnreadable
          AttemptExitStageNames { names: names } =>
            WetRecordNamesListed { names: concat(so_far, filter(names, n => string_contains(s: n, pattern: prefix))) }
        }
    },
  )
}

fn wet_fresh_record_names(before: List<String>, after: List<String>) -> List<String> {
  filter(after, n => !any(before, b => b == n))
}

fn wet_inner_exit_status(instance_root: String, unit_key: String, before: WetRecordNames) -> SandboxTouch {
  match before {
    WetRecordNamesUnreadable => SandboxTouchUnrunnable
    WetRecordNamesListed { names: seen } => wet_inner_exit_status_poll(instance_root: instance_root, unit_key: unit_key, seen: seen, remaining: 240)
  }
}

fn wet_inner_exit_status_poll(instance_root: String, unit_key: String, seen: List<String>, remaining: Int) -> SandboxTouch {
  match wet_record_names(instance_root: instance_root, unit_key: unit_key) {
    WetRecordNamesUnreadable => SandboxTouchUnrunnable
    WetRecordNamesListed { names: after } => {
      let fresh = wet_fresh_record_names(before: seen, after: after)
      match fresh.first() {
        Absent =>
          if remaining <= 0 {
            SandboxTouchUnrunnable
          } else {
            let _ = shell.Exec.RunArgv(program: "/usr/bin/sleep", arguments: ["1"])
            wet_inner_exit_status_poll(instance_root: instance_root, unit_key: unit_key, seen: seen, remaining: remaining - 1)
          }
        Present { value: name } =>
          if length(fresh) != 1 {
            SandboxTouchUnrunnable
          } else {
            match attempt_exit_entry_decode(entry_name: name) {
              AttemptExitEntryMalformed { entry_name: _, reason: _ } => SandboxTouchUnrunnable
              AttemptExitEntryDecoded { record } =>
                match record.end {
                  AttemptProcessExitedWith { status } => SandboxTouchRan { exit_code: status }
                  AttemptProcessSignaled { signal: _ } => SandboxTouchUnrunnable
                }
            }
          }
      }
    }
  }
}

// A record planted for the key before the run is in the snapshot and is never read as this run's. This goes
// through the poll itself (remaining: 0, so no waiting): a prior refused-scoring record in done/ must leave
// the poll Unrunnable, and one fresh status-0 record in the inbox is then the only one read.
fn wet_plant_record(root: String, stage_dir: String, status: Int) -> Bool {
  shell.Exec.RunArgv(
    program: "mkdir",
    arguments: ["-p", "--", join([stage_dir, "/", attempt_exit_vendor_pane_entry_name(node_id: wet_probe_node as String, attempt_key: launcher_probe_key(unit_key: "bin"), status: status)], "")],
  ).exit_code == 0
}

test fn a_prior_run_record_for_the_key_is_not_read_as_this_runs() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_exit_spool_prepare(instance_root: root)
      && wet_plant_record(root: root, stage_dir: attempt_exit_done_dir(instance_root: root), status: 1)
      && match wet_record_names(instance_root: root, unit_key: "bin") {
        WetRecordNamesUnreadable => false
        WetRecordNamesListed { names: seen } =>
          (match wet_inner_exit_status_poll(instance_root: root, unit_key: "bin", seen: seen, remaining: 0) {
            SandboxTouchUnrunnable => true
            SandboxTouchRan { exit_code: _ } => false
          })
            && wet_plant_record(root: root, stage_dir: attempt_exit_inbox_dir(instance_root: root), status: 0)
            && (match wet_inner_exit_status_poll(instance_root: root, unit_key: "bin", seen: seen, remaining: 0) {
              SandboxTouchUnrunnable => false
              SandboxTouchRan { exit_code } => exit_code == 0
            })
      }
  }
}

// THE WAIT'S FOUR OUTCOMES ARE DISTINGUISHABLE HERE, WITHOUT SYSTEMD, WITHOUT ROOT, AND WITHOUT WAITING.
// All four are decided by what is standing at the answer path when the bound expires, so a claim-local
// spool can put each shape there and ask the wait, at zero beats, which it reports. This is exactly the
// discriminator the srv2 S1 run at 4ffbdfcc lacked: the launcher leg printed `answer-arrived FAILED` after
// 1,656 s wall / 570 s CPU and could not say whether the root side had written NOTHING or had written an
// answer to ANOTHER request body -- and those two states want opposite fixes (the first is a launch that
// never reached the drain, the second is a request/answer disagreement). With the typed wait reverted this
// claim is RED at the second conjunct, because an answer for another body was answered with the same words
// an empty spool gets. The scratch dir is `mktemp -d` output, not under the witness root prefix, so it is
// not one of the roots the run's leftover readback counts; like its sibling above, it plants into a fresh
// temporary tree and leaves the host's own tmp cleanup to the host.
test fn an_answer_for_another_request_is_reported_as_a_mismatch_not_as_a_wait() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let mine = "the body this claim asked for"
    let other = "the body a different request carried, longer on purpose"
    // ONE SPOOL, FOUR ENTRIES. Each arm gets its own entry, because an answer is a FILE and four
    // questions asked of one path would make the last arm's verdict depend on whether the writer
    // truncated or appended -- a fact about Filesystem.Write, not about the wait. The spool tree comes
    // from the witness's own preparer, the route the launcher legs use, so the claim tests the channel
    // rather than a spool I hand-made to pass.
    wet_prepare_attempt_unit_spool_at(instance_root: root)
      // NOTHING AT THE PATH: never arrived, naming the path and the zero beats it actually waited.
      && (
        match wet_answer_wait_poll(
          instance_root: root,
          entry: "keen-shape-absent",
          request_body: mine,
          remaining: 0,
          waited: 0,
        ) {
          WetAnswerNeverArrived { path: path, beats: beats } =>
            beats == 0 && string_contains(path, "/answers/keen-shape-absent")
          _ => false
        }
      )
      // AN ANSWER FOR ANOTHER BODY: a mismatch, not a wait -- the state srv2's launcher leg was in and
      // could not name. It names the file to read and the size of each side.
      && attempt_system_unit_write_answer(
        instance_root: root,
        entry: "keen-shape-other",
        body: other,
        answer: AttemptSystemUnitStarted,
      )
      && (
        match wet_answer_wait_poll(
          instance_root: root,
          entry: "keen-shape-other",
          request_body: mine,
          remaining: 0,
          waited: 0,
        ) {
          WetAnswerEchoMismatch { path: path, echoed_chars: echoed_chars, wanted_chars: wanted_chars } =>
            string_contains(path, "/answers/keen-shape-other")
              && echoed_chars == string_length(other)
              && wanted_chars == string_length(mine)
          _ => false
        }
      )
      // THE ANSWER TO THIS BODY: arrived on the first look, no beat spent.
      && attempt_system_unit_write_answer(
        instance_root: root,
        entry: "keen-shape-mine",
        body: mine,
        answer: AttemptSystemUnitStarted,
      )
      && wet_answer_wait_started(
        wait: wet_answer_wait_poll(
          instance_root: root,
          entry: "keen-shape-mine",
          request_body: mine,
          remaining: 0,
          waited: 0,
        ),
      )
      // SOMETHING THAT IS NOT AN ANSWER AT ALL: unreadable, and it says so rather than waiting.
      && Filesystem.Write(
        path: attempt_system_unit_answer_path(instance_root: root, entry: "keen-shape-garbage"),
        content: "a file that carries no request body separator",
      ).success
      && (
        match wet_answer_wait_poll(
          instance_root: root,
          entry: "keen-shape-garbage",
          request_body: mine,
          remaining: 0,
          waited: 0,
        ) {
          WetAnswerUnreadable { path: path, detail: _ } =>
            string_contains(path, "/answers/keen-shape-garbage")
          _ => false
        }
      )
  }
}

// THE LEAF IS WHAT MAKES A PROBE UNIT NAME UNREUSABLE, so it is now a pure `.dag` fold and must be
// tested as one. Review 91550 asked why a claim was starting a `basename` process to split a string it
// already held; the honest answer is that it should not, and it no longer does -- the fold lives in
// `witness_supplied_instance` `witness_claim_leaf` and the `basename` extdeps rows are deleted with it.
// What the fold owes the rest of the witness is two things, and both are decided here without a host tool,
// a systemd, or root:
//   (1) it answers the way `basename(1)` answers, including the trailing-slash case the fold has to
//       handle by skipping empty segments -- a leaf that differed from what the host's own naming would
//       have produced would put a name on a unit that no host tool would have spelled;
//   (2) the leaf is what makes two runs, or two claims, unable to name the same unit. That is the
//       property the srv2 runs cannot afford to lose: a unit name shared between a leftover and a live
//       launch is exactly the false red that reads as a sandbox refusal. The names come from production
//       (`dispatch_attempt_unit_stem` through `systemd_service_unit_name`), so this is a check that the
//       leaf reaches that naming -- not a re-implementation of it.
test fn the_claim_leaf_is_the_host_segment_and_two_roots_never_name_one_unit() -> Bool {
  let shapes = (
    match witness_claim_leaf(path: "/tmp/gunbc-sandbox-A1b2C3") {
      Present { value: leaf } => leaf == "gunbc-sandbox-A1b2C3"
      Absent => false
    }
  )
    // THE TRAILING SLASH, which is why the fold skips empty segments rather than taking the last
    // position: `basename /a/b/` is `b`, and a fold that answered "" here would refuse a real root.
    && (match witness_claim_leaf(path: "/tmp/gunbc-sandbox-A1b2C3/") {
      Present { value: leaf } => leaf == "gunbc-sandbox-A1b2C3"
      Absent => false
    })
    // AN EMPTY SEGMENT IN THE MIDDLE is not part of the name either.
    && (match witness_claim_leaf(path: "/tmp/a//b") {
      Present { value: leaf } => leaf == "b"
      Absent => false
    })
    // THE THREE SHAPES THAT ARE NOT LEAVES: the filesystem root (what `basename /` prints), nothing at
    // all, and a path made only of separators. Each must refuse, because `wet_attempt_key` hands the
    // empty string to production's own guard when the leaf is Absent -- a silent "" there would name a
    // unit after no claim at all.
    && (match witness_claim_leaf(path: "/") {
      Absent => true
      Present { value: _ } => false
    })
    && (match witness_claim_leaf(path: "") {
      Absent => true
      Present { value: _ } => false
    })
    && (match witness_claim_leaf(path: "///") {
      Absent => true
      Present { value: _ } => false
    })
  let root_a = wet_claim_root(tag: "leaf-a" as NonEmptyStr)
  let root_b = wet_claim_root(tag: "leaf-b" as NonEmptyStr)
  // TWO ROOTS, ONE LABEL: the label is the part a claim chooses, and it is the same here on purpose. If
  // the names came out equal, the label alone was naming the unit and the leaf was decoration.
  let distinct = (
    match wet_unit_name_for(root: root_a as NonEmptyStr, label: "shared-label") {
      Present { value: name_a } =>
        match wet_unit_name_for(root: root_b as NonEmptyStr, label: "shared-label") {
          Present { value: name_b } =>
            (name_a as String) != (name_b as String)
              // THE LEAF MUST BE IN THE NAME, not merely distinguishing it: the name is built by
              // production from `leaf + "-" + label`, so a name that differs but does not carry the
              // leaf is naming something else -- and `wet_retire_unit`, which derives the name again
              // instead of remembering it, would be retiring that something else.
              && (match witness_claim_leaf(path: root_a as String) {
                Present { value: leaf } => string_contains(s: name_a as String, pattern: leaf as String)
                Absent => false
              })
          Absent => false
        }
      Absent => false
    }
  )
  // THE SAME ROOT AND LABEL TWICE MUST NAME THE SAME UNIT, or retirement could never match the launch it
  // belongs to: `wet_retire_unit` derives the name again rather than remembering it.
  let stable = (
    match wet_unit_name_for(root: root_a as NonEmptyStr, label: "shared-label") {
      Present { value: again } =>
        match wet_unit_name_for(root: root_a as NonEmptyStr, label: "shared-label") {
          Present { value: once } => (again as String) == (once as String)
          Absent => false
        }
      Absent => false
    }
  )
  // BOTH ROOTS, ALWAYS. `leaf-a` carries the verdict; `leaf-b` exists to be a second root with the same
  // label, and it must not survive the claim whether or not the verdict held -- see the list readback.
  wet_claim_verdicts_with_root_readbacks(
    verdict: shapes && distinct && stable,
    roots: [root_a as NonEmptyStr, root_b as NonEmptyStr]
  )
}

// RESIDUAL: a unit that fails in exec setup (EXIT_* range, e.g. 226 NAMESPACE for a missing ReadWritePaths
// entry) still scores as refused here, since the status is nonzero and the path absent. The same-shape
// allowed cells catch a shape-wide failure, not a per-cell one. The exit-status classification is modelled
// for the direct probes in #14655 and is not written a second time here; the launcher cells consume it once
// both land.
fn wet_path_is_executable(path: String) -> Bool {
  // `shell.Test.IsExecutable` is the modeled `test -x` (extdeps/shell.dag); running the verb
  // through shell.Exec.RunArgv here was a second path beside it (review 90943's class).
  shell.Test.IsExecutable(path: path as FilePath).executable
}

fn wet_path_exists(path: String) -> Bool {
  shell.Exec.RunArgv(program: "test", arguments: ["-e", path]).exit_code == 0
}

// A refused write needs the nonzero inner status AND the target unchanged: a probe path that did not
// exist before must still not exist, so a status that disagrees with the filesystem is not a pass.
// An allowed write needs status 0 AND the path present afterwards.
fn wet_write_refused(touch: SandboxTouch, existed_before: Bool, path: String) -> Bool {
  match touch {
    SandboxTouchUnrunnable => false
    SandboxTouchRan { exit_code } => exit_code != 0 && (existed_before || !wet_path_exists(path: path))
  }
}

fn launcher_run_refused(instance: HostDashboardInstance, entry: String, request_body: String) -> Bool {
  match attempt_system_unit_read_answer(instance_root: instance.instance_root as String, entry: entry, request_body: request_body) {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => false
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: _ } } => true
    AttemptSystemUnitAnswerMissing => true
    AttemptSystemUnitAnswerUnreadable { detail: _ } => true
  }
}

fn attempt_system_unit_spool_prepare(instance_root: String) -> Bool {
  fold(
    [
      attempt_unit_spool_staging_dir(instance_root: instance_root),
      attempt_unit_spool_request_dir(instance_root: instance_root),
      attempt_unit_spool_claimed_dir(instance_root: instance_root),
      attempt_unit_spool_answer_dir(instance_root: instance_root),
    ],
    init: true,
    f: (ok, dir) => ok && shell.Mkdir.Parents(path: dir as FilePath).success,
  )
}

fn wet_word_request(node_id: String, attempt_key: String, argv_word: String) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: node_id,
    attempt_key: attempt_key,
    granted: kibibyte(count: 1),
    inner_argv: [argv_word],
    nonce: "n",
  }
}

test fn two_request_entries_keep_distinct_bodies() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-a", attempt_key: "k1", argv_word: "one")) {
        AttemptSystemUnitEnqueued { entry: a, body: _ } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n-b", attempt_key: "k1", argv_word: "two")) {
            AttemptSystemUnitEnqueued { entry: b, body: _ } => {
              let ra = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: a)))
              let rb = Filesystem.Read(path: attempt_system_unit_request_body_path(dir: attempt_system_unit_request_path(instance_root: root, entry: b)))
              ra.success && rb.success && ra.content != rb.content && a != b
            }
            AttemptSystemUnitEnqueueOccupied { entry: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_second_request_for_the_same_attempt_is_occupied() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let request = wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x")
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
        AttemptSystemUnitEnqueued { entry: _, body: _ } =>
          match attempt_system_unit_enqueue_start_wait(instance_root: root, request: request) {
            AttemptSystemUnitEnqueueOccupied { entry } =>
              entry == attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
            AttemptSystemUnitEnqueued { entry: _, body: _ } => false
            AttemptSystemUnitEnqueueRefused { detail: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_claimed_entry_is_processed_once_across_two_claim_runs() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(
        instance_root: root,
        request: wet_word_request(node_id: "n1", attempt_key: "k1", argv_word: "x"),
      ) {
        AttemptSystemUnitEnqueued { entry, body: _ } =>
          match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
            AttemptSystemUnitClaimed { entry: _, path: _ } =>
              match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
                AttemptSystemUnitAlreadyClaimed { entry: again } => again == entry
                AttemptSystemUnitClaimed { entry: _, path: _ } => false
                AttemptSystemUnitClaimSymlink { entry: _ } => false
                AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
                AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
              }
            AttemptSystemUnitAlreadyClaimed { entry: _ } => false
            AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
            AttemptSystemUnitClaimSymlink { entry: _ } => false
            AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
          }
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
  }
}

test fn a_symlinked_request_entry_is_refused_by_the_claim() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dest = attempt_system_unit_request_path(instance_root: root, entry: entry)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", dest]).exit_code == 0
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimSymlink { entry: got } => got == entry
        AttemptSystemUnitClaimed { entry: _, path: _ } => false
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

fn claimed_body_refused_after_plant(plant: fn(String) -> Bool, needle: String) -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dir = attempt_system_unit_request_path(instance_root: root, entry: entry)
    let body = attempt_system_unit_request_body_path(dir: dir)
    attempt_system_unit_spool_prepare(instance_root: root)
      && shell.Mkdir.NewOwnerOnly(path: dir as FilePath).success
      && plant(body)
      && match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimed { entry: _, path } =>
          match attempt_system_unit_read_claimed_body(path: attempt_system_unit_request_body_path(dir: path)) {
            AttemptSystemUnitClaimedBodyRefused { reason } => string_contains(s: reason, pattern: needle)
            AttemptSystemUnitClaimedBodyRead { content: _ } => false
          }
        AttemptSystemUnitAlreadyClaimed { entry: _ } => false
        AttemptSystemUnitClaimUnmovable { entry: _, cause: _ } => false
        AttemptSystemUnitClaimSymlink { entry: _ } => false
        AttemptSystemUnitClaimRefused { entry: _, reason: _ } => false
      }
  }
}

test fn a_fifo_request_body_is_refused_without_reading() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "mkfifo", arguments: ["--", body]).exit_code == 0,
    needle: "fifo",
  )
}

test fn a_symlinked_request_body_is_refused_without_following() -> Bool {
  claimed_body_refused_after_plant(
    plant: body => shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/dev/zero", body]).exit_code == 0,
    needle: "symlink",
  )
}

fn sandbox_worktree_commit_cli(worktree: String, git_dir: String) -> ProcessExit {
  let r = shell.Exec.RunArgv(
    program: "/usr/bin/git",
    arguments: [
      "--git-dir", git_dir, "--work-tree", worktree,
      "-c", "user.email=probe@gunbc.local", "-c", "user.name=probe",
      "commit", "--allow-empty", "-q", "-m", "worker-probe",
    ],
  )
  if r.exit_code == 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "worktree commit refused")
  }
}

fn prepare_launcher_linked_worktree(instance: HostDashboardInstance, unit_key: String) -> Bool {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  prepare_launcher_probe(instance: instance, unit_key: unit_key)
    && shell.Exec.RunArgv(program: "rm", arguments: ["-rf", "--", wt]).exit_code == 0
    && shell.Exec.RunArgv(
      program: "git",
      arguments: ["-C", instance.repo_root as String, "worktree", "add", "--detach", "--", wt, "HEAD"],
    ).exit_code == 0
}

fn launcher_worktree_commit(instance: HostDashboardInstance, unit_key: String, root: NonEmptyStr) -> SandboxTouch {
  let wt = launcher_probe_worktree(instance: instance, unit_key: unit_key)
  let git_dir = dispatch_attempt_private_git_dir(instance: instance, attempt_worktree: wt)
  match admit_named_argument(name: "worktree", value: wt) {
    NamedArgumentNameEmpty => SandboxTouchUnrunnable
    NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
    NamedArgumentAdmitted { argument: wt_arg } =>
      match admit_named_argument(name: "git_dir", value: git_dir) {
        NamedArgumentNameEmpty => SandboxTouchUnrunnable
        NamedArgumentNameHoldsSeparator { name: _ } => SandboxTouchUnrunnable
        NamedArgumentAdmitted { argument: git_arg } =>
          launcher_inner_start(
            instance: instance,
            unit_key: unit_key,
            root: root,
            inner: launcher_gunbc_run_inner_argv(
              instance: instance,
              function: "sandbox_worktree_commit_cli",
              extra_args: [
                "--arg", join([wt_arg.name, "=", wt_arg.value], ""),
                "--arg", join([git_arg.name, "=", git_arg.value], ""),
              ],
            ),
          )
      }
  }
}


test fn writing_the_gitfile_or_commondir_inside_the_unit_fails_and_a_worktree_commit_succeeds() -> Bool {
  // THE GIT POINTER FILES BELONG TO A LAB THE CLAIM MADE. Under the live row the two refused
  // paths were the deployment's own gitfile and commondir, and the commit that is supposed to
  // SUCCEED ran in the deployment's worktree -- so this claim both proved a refusal by writing
  // where it should not have, and performed a real commit against the served repository.
  let root = wet_claim_root(tag: "git-pointer" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let unit_key = "gitptr"
  let wt = launcher_probe_worktree(instance: inst, unit_key: unit_key)
  let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    && prepare_launcher_linked_worktree(instance: inst, unit_key: unit_key)
    && launcher_write_refused(instance: inst, unit_key: "gitfile", path: pointers.gitfile, root: root)
    && launcher_write_refused(instance: inst, unit_key: "commondir", path: pointers.commondir, root: root)
    && match launcher_worktree_commit(instance: inst, unit_key: unit_key, root: root) {
      SandboxTouchUnrunnable => false
      SandboxTouchRan { exit_code } => exit_code == 0
    }
  // THE VERDICT IS REPORTED BEFORE THE CLEANUP, AND THE CLEANUP RUNS EITHER WAY: a
  // launched unit leaves root-owned files in this tree, so removal may need the same
  // elevation and it is a named stage of its own -- stern checks the host afterwards.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn belt_commit_refuses_a_planted_commondir_without_running_git() -> Bool {
  // THE PLANTED COMMONDIR IS PLANTED IN A LAB THE CLAIM OWNS. This is the model-side half of the
  // pair: the belt must refuse a commit whose worktree carries a commondir pointer, without
  // running git at all. It took its row from `lab_instance_at_repo`, which grafted the claim's
  // temp repository onto the LIVE lab row -- so the repository was the claim's but the instance
  // root, the private git dir the gitfile names, and the serve binary were the deployment's, and
  // the refusal it reported was read off a row this witness had no business standing on. That
  // builder is retired; the row is supplied and every path below, including the gitdir the
  // planted gitfile names, is an accessor over it.
  let root = wet_claim_root(tag: "belt-commondir" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let wt = join([root, "/wt"], "")
  let pointers = dispatch_worker_git_pointer_files(instance: inst, attempt_worktree: wt)
  let expected_git_dir = dispatch_attempt_private_git_dir(instance: inst, attempt_worktree: wt)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && shell.Mkdir.Parents(path: path_parent_directory(path: pointers.gitfile) as FilePath).success
    && shell.Mkdir.Parents(path: path_parent_directory(path: pointers.commondir) as FilePath).success
    && Filesystem.Write(path: pointers.gitfile, content: join(["gitdir: ", expected_git_dir, "\n"], "")).success
    && Filesystem.Write(path: pointers.commondir, content: join([root, "/planted-commondir\n"], "")).success
    && match belt_commit_git(instance: inst, worktree: wt, args: ["status"]) {
      ExecRefused { program: _, reason } => string_contains(s: reason, pattern: "commondir")
      ExecOk { stdout: _ } => false
      ExecFailed { program: _, exit_code: _, stderr: _ } => false
    }
  // CLEANUP IS NOT A CONJUNCT. The srv2 run left twenty claim roots because a leg that fails
  // before the end of an `&&` chain never reaches a removal sitting at the end of it; the same
  // defect showed up in this file's own BROKEN run, where a claim that was already FAIL left
  // /tmp/gunbc-sandbox-belt-commondir-... on disk. The verdict is bound first, then the root is
  // taken away, and a root still on disk reddens the claim.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

// THE ATTEMPT-UNIT DRAIN'S LINE STOP. The drain's .path unit is a level on requests/, so every entry a pass
// leaves there starts the root drain again. RED: a request the claim cannot move (claimed/<entry> already
// holds content) must be reported Unmovable, stall the pass that retired nothing, and leave a readable record;
// before the repair the claim reported it AlreadyClaimed and the drain exited with the request in place.
fn unmovable_request_root(tag: String) -> String? {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    none
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: tag)
    let occupied = attempt_system_unit_claimed_path(instance_root: root, entry: entry)
    if attempt_system_unit_spool_prepare(instance_root: root)
      && match attempt_system_unit_enqueue_start_wait(instance_root: root, request: wet_word_request(node_id: "n1", attempt_key: tag, argv_word: "x")) {
        AttemptSystemUnitEnqueued { entry: _, body: _ } => true
        AttemptSystemUnitEnqueueOccupied { entry: _ } => false
        AttemptSystemUnitEnqueueRefused { detail: _ } => false
      }
      && shell.Mkdir.Parents(path: join([occupied, "/held"], "") as FilePath).success {
      Present { value: root }
    } else {
      none
    }
  }
}

test fn a_request_the_claim_cannot_move_stalls_the_drain_and_leaves_a_record() -> Bool {
  match unmovable_request_root(tag: "k1") {
    Absent => false
    Present { value: root } => {
      let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
      let pass = attempt_system_unit_drain_pass(instance_root: root)
      let claim_is_unmovable = match attempt_system_unit_claim_entry(instance_root: root, entry: entry) {
        AttemptSystemUnitClaimUnmovable { entry: e, cause: _ } => e == entry
        _ => false
      }
      let verdict = match attempt_unit_stall_verdict(pass: pass) {
        AttemptUnitStalled { unmovable } => count(unmovable) == 1
        AttemptUnitNotStalled => false
      }
      let exited = match attempt_system_unit_launch_cli(instance_root: root) {
        ExitSuccess => false
        ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "unmovable at claim")
      }
      claim_is_unmovable && verdict && exited && pass.retired == 0 && match spool_stall_read_at(record_path: attempt_unit_spool_stall_record_path(instance_root: root)) {
        SpoolStallHeld { entries } => count(entries) == 1 && (entries |> map(e => e.step)) == [SpoolStallClaim]
        SpoolStallNone => false
        SpoolStallUnreadable { reason: _ } => false
      }
    }
  }
}

test fn an_unlistable_request_directory_stalls_the_drain() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let pass = attempt_system_unit_drain_pass(instance_root: root)
    match attempt_unit_stall_verdict(pass: pass) {
      AttemptUnitStalled { unmovable } => (unmovable |> map(e => e.step)) == [SpoolStallListRequests]
      AttemptUnitNotStalled => false
    }
  }
}

// POSITIVE CONTROLS: a request the drain retires (here a symlink entry, refused with an answer) is out of
// requests/, retired > 0, and no record is written; an empty spool is not a stall either.
test fn a_retired_request_and_an_empty_spool_do_not_stall_the_drain() -> Bool {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    false
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: "k1")
    let dest = attempt_system_unit_request_path(instance_root: root, entry: entry)
    let prepared = attempt_system_unit_spool_prepare(instance_root: root)
    let empty_not_stalled = match attempt_unit_stall_verdict(pass: attempt_system_unit_drain_pass(instance_root: root)) {
      AttemptUnitNotStalled => true
      AttemptUnitStalled { unmovable: _ } => false
    }
    let planted = shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", dest]).exit_code == 0
    let pass = attempt_system_unit_drain_pass(instance_root: root)
    let retired_not_stalled = pass.retired == 1 && pass.refused == 1 && match attempt_unit_stall_verdict(pass: pass) {
      AttemptUnitNotStalled => true
      AttemptUnitStalled { unmovable: _ } => false
    }
    prepared && empty_not_stalled && planted && retired_not_stalled
      && spool_stall_read_at(record_path: attempt_unit_spool_stall_record_path(instance_root: root)) == SpoolStallNone
  }
}

// A REFUSAL IS AN ANSWER (end to end through the CLI). The refused request is answered and leaves requests/, and
// the unit's exit is success; the drain's own failure (here: the answer cannot be created because one already
// exists for the entry) is the nonzero exit.
fn planted_symlink_request_root(tag: String, answer_exists: Bool) -> String? {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    none
  } else {
    let root = tmp.path as String
    let entry = attempt_system_unit_request_entry_name(node_id: "n1", attempt_key: tag)
    let prepared = attempt_system_unit_spool_prepare(instance_root: root)
    let planted = shell.Exec.RunArgv(program: "ln", arguments: ["-s", "--", "/tmp/gunbc-not-a-request", attempt_system_unit_request_path(instance_root: root, entry: entry)]).exit_code == 0
    let answered = if answer_exists { attempt_system_unit_write_answer(instance_root: root, entry: entry, body: "", answer: AttemptSystemUnitStarted) } else { true }
    if prepared && planted && answered { Present { value: root } } else { none }
  }
}

test fn a_refused_request_does_not_fail_the_drain_unit() -> Bool {
  match planted_symlink_request_root(tag: "k1", answer_exists: false) {
    Absent => false
    Present { value: root } => match attempt_system_unit_launch_cli(instance_root: root) {
      ExitSuccess => true
      ExitFailure { code: _, reason: _ } => false
    }
  }
}

test fn a_request_the_drain_cannot_answer_fails_the_drain_unit() -> Bool {
  match planted_symlink_request_root(tag: "k1", answer_exists: true) {
    Absent => false
    Present { value: root } => match attempt_system_unit_launch_cli(instance_root: root) {
      ExitSuccess => false
      ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "could not be written")
    }
  }
}

// A PER-RUN NAME FOR A REQUEST ON THE REAL SPOOL. answers/<entry> is keyed by node and attempt key and outlives
// the run, so the cells that use the lab's fixed keys bind their request to a fresh value and read only the
// answer that echoes it. An unmade temp directory yields "", which the encoder refuses: the cell is false, not
// bound to a shared name.
fn wet_run_nonce() -> String {
  let tmp = shell.Mktemp.Dir()
  if !tmp.success {
    ""
  } else {
    fold(split(s: tmp.path as String, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
  }
}

// ---------------------------------------------------------------------------------------------
// THE THREE SRV2 FIXTURE FAULTS, EACH WITH A CONTROL THAT GOES RED HERE.
//
// stern ran the ten launch legs on srv2 on 2026-11-04 (sudo -n true rc=0, binary 61cdeb10..., the
// entry resolved at 1437 modules): 3 PASS / 9 FAIL, and NOT ONE of the nine was a sandbox verdict.
// They were three fixture faults, all of them "the supplied root is not a provisioned root", and all
// of them invisible from this container because the leg that would have caught them needs
// systemd-run. Each fault now has a conjunct that needs no unit and no second principal, so the next
// regression is a red claim in THIS lane rather than a srv2 log line:
//   (A) missing attempt-unit-spool/requests-staging  -> the_supplied_root_carries_the_attempt_unit_spool_tree
//   (B) the lab row's /etc/credstore credential       -> the_supplied_unit_credential_is_under_the_root_and_the_live_credstore_is_refused
//   (C) <root>/source copied but never initialised    -> the_supplied_source_is_a_real_repository
// They are scheduled, so they run in the wet lane, and they are readbacks over accessors, so removing
// the derivation that supplies each path takes the matching claim red.

// CONTROL, RUNNABLE WHEREVER THE BATCH RUNS (no systemd, no sudo, no second principal). The route
// change of 2026-11-04 put a pre-launch assertion between a supplied row and a unit on the SYSTEM
// manager: paths in the root, the row's own worker identity in User=, and this claim's mktemp leaf in
// the unit name. An assertion that can only be exercised by launching is not falsifiable where most
// readers run this file, so this claim derives the same plan through the same production symbols and
// asserts on it WITHOUT starting anything. With wet_plan_reaches_only_the_root replaced by true, with
// the ReadWritePaths= presence arm removed, or with the claim leaf dropped from the attempt key, THIS
// claim goes red here -- the control the nine launch claims cannot have on a host that cannot launch.
test fn the_supplied_plan_reaches_only_the_claim_root() -> Bool {
  let root = wet_claim_root(tag: "plan-containment" as NonEmptyStr)
  // THE ROOT THE NEGATIVE PROBES LAUNCH FROM: a second, separate claim root, so the gate is shown to
  // reject a plan that belongs to somebody else rather than to a hand-written path.
  let foreign = wet_claim_root(tag: "plan-containment-foreign" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && wet_plant_guest_runtime(instance: inst)
    // The inner argv is the shape a real start carries; it is never run here, and it is built from
    // accessors over the supplied row so a deletion of the real derivation is felt, not papered over.
    && wet_gate_proves_itself(
      instance: inst,
      unit_key: "containment",
      inner: launcher_touch_inner_argv(instance: inst, path: join([root as String, "/containment-touch"], "")),
      root: root,
      foreign_root: foreign,
    )
    // The worktree the plan is built from is named outright too: an emptied plan cannot leave the
    // gate vacuously true, which is the same argument the spool control makes about an empty fold.
    && is_under(text: dashboard_instance_dispatch_worktree_root(instance: inst) as String, root: root)
  wet_claim_verdict_with_root_readback(
    verdict: wet_stage_of(
      stage: "foreign-claim-root-removed-is-housekeeping-not-verdict",
      ok: wet_clean_claim_root(root: foreign),
      value: verdict,
    ),
    root: root,
  )
}


// THE WORD AT POSITION `i`, for claims that assert on an assembled argv by position. The corpus has no
// indexing operator and each witness that needs one defines its own (dag/test/claim/
// runner/deploy_slot_account_witness.dag:290 is one); this is that helper, scoped to the words these
// claims read.
fn wet_word_at(words: List<String>, index: Int) -> String {
  match list_at_optional(xs: words, index: index) {
    Present { value: v } => v
    Absent => ""
  }
}

test fn the_drain_names_the_installed_locus_and_not_the_source_copy() -> Bool {
  // THE LOCAL DISCRIMINATOR FOR THE FAULT srv2 CAUGHT, WITH NO ELEVATION ANYWHERE IN IT. On 2026-11-05
  // stern's S1 at 114bcf31 lost nine root-launch legs because the elevated drain named
  // `instance.repo_root` -- a copied tree with no `.gunbc-tree-receipt` -- as GUNBC_WORKSPACE_ROOT, and
  // the real CLI answered `names no release locus: missing member .gunbc-tree-receipt`
  // (src/v1/stage0/src/cli_run.rs:611). Nothing in this file could see it, because those words were only
  // ever assembled inside a leg that had already required sudo. This claim assembles the SAME words --
  // `wet_image_serve_argv`, the one builder the drain and the served-image probe share -- and asks what
  // they name, with no sudo, no manager and no install. A mutant that puts `repo_root` back into the
  // builder turns it RED in the author's container, which is the whole point of it existing.
  let root = wet_claim_root(tag: "drain-argv" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  // A SHAPE, NOT A DEPLOYMENT. Any 40-hex names a revision for the purposes of these words, and what is
  // claimed is that the shape holds for whichever one a leg reads out of git; the same convention the
  // pure install witness already uses (dag/test/claim/workspace_executor_install_witness.dag:25).
  let revision = "0123456789abcdef0123456789abcdef01234567"
  let words = map(
    wet_image_serve_argv(
      instance: inst,
      revision_text: revision,
      entry_relative: wet_witness_entry_relative,
      function: "wet_root_side_cli" as NonEmptyStr,
    ),
    word => word as String,
  )
  let locus = witness_locus_dir_text(instance: inst, revision_text: revision)
  let repo = inst.repo_root as String
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    // 1. PREFIXED THE WAY PRODUCTION PREFIXES: `env_prefixed_argv`'s own env program first, then the
    // binding spelled from production's own env-name row, then the program it runs.
    && wet_stage(
      stage: "drain-argv-is-env-prefixed",
      ok: wet_word_at(words: words, index: 0) == env_absolute_program().invocation as String
        && wet_word_at(words: words, index: 1)
          == join([gunbc_workspace_root_env_name, "=", locus], "")
        && wet_word_at(words: words, index: 2)
          == witness_locus_binary_path(instance: inst, revision_text: revision),
    )
    // 2. THE BINARY IS THE LOCUS MEMBER AND NOT THE ROW's SERVE BINARY. `attempt_system_unit_launch_gunbc_argv_at`
    // passes the locus member; the srv2 drain did not, and every leg that failed was downstream of that
    // one word. The serve binary stays what the UNIT execs (attempt_system_unit_launch.dag:276 admits on
    // it); the drain is a different route and names a different file.
    && wet_stage(
      stage: "drain-argv-binary-is-the-locus-member",
      ok: contains(xs: words, item: witness_locus_binary_path(instance: inst, revision_text: revision))
        && !contains(xs: words, item: inst.serve_binary as String),
    )
    // 3. BOTH SOURCE ROOTS ARE THE LOCUS'S, from `release_locus_tree_subdirs` joined under it -- the
    // list production's argv builder joins, not two strings this claim typed.
    && wet_stage(
      stage: "drain-argv-source-roots-are-the-locus",
      ok: length(xs: witness_locus_source_roots(instance: inst, revision_text: revision)) == 2
        && all(
          xs: witness_locus_source_roots(instance: inst, revision_text: revision),
          predicate: root_word => contains(xs: words, item: root_word),
        )
        && contains(xs: words, item: "--source-root"),
    )
    // 4. AND NO WORD IS THE SOURCE COPY -- not the root, not its dag, not its src/v2, not a path that
    // merely starts under it. This is the conjunct the srv2 run would have failed on its own.
    && wet_stage(
      stage: "drain-argv-names-no-source-copy",
      ok: !contains(xs: words, item: repo)
        && !contains(xs: words, item: join([repo, "/dag"], ""))
        && !contains(xs: words, item: join([repo, "/src/v2"], ""))
        && !any(
          xs: words,
          predicate: word => starts_with(s: word, prefix: join([repo, "/"], "")),
        ),
    )
    // 5. THE LOCUS IS PRODUCTION'S SHAPE, READ FROM PRODUCTION'S ACCESSOR: under the claim's instance
    // root (never the live lab root -- that is `wet_claim_is_confined`'s job), revision-qualified
    // through production's `helper_locus_dir` (`base + "/" + revision`, release_locus.dag:112 -- the
    // step stem lives in the HelperLocus row, not in the path), and the row's step stem IS the live
    // launcher's, so this is the attempt-unit helper locus's shape and not some directory with a
    // receipt in it.
    && wet_stage(
      stage: "drain-argv-locus-is-a-production-helper-locus",
      ok: starts_with(s: locus, prefix: join([inst.instance_root as String, "/"], ""))
        && starts_with(s: locus, prefix: join([witness_claim_helper_locus(instance: inst).base, "/"], ""))
        && string_contains(s: locus, pattern: revision)
        && witness_claim_helper_locus(instance: inst).step_stem
          == attempt_system_unit_launcher_locus(instance: inst).step_stem
        && locus != repo,
    )
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn the_supplied_root_carries_the_attempt_unit_spool_tree() -> Bool {
  // srv2, cause (A): the drain writes each request as
  // <instance_root>/attempt-unit-spool/requests-staging/<key>.staging, and with a bare supplied root the
  // unit's own mkdir returned ENOENT for six claims. This is that directory tree, read back with the
  // host's own `test -d` after prepare_probe_attempt, over the same accessor list the plant creates.
  let root = wet_claim_root(tag: "spool" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let dirs = wet_attempt_unit_spool_dirs(instance_root: inst.instance_root as String)
  // THE BODY IS THE SHAPE THE LAUNCHER PARSES (start-wait, node, key, user, repo, worktree, streams,
  // grant, hook, inner argv, nonce), built from the supplied row like the wide-request claim builds
  // its own. What this control tests is the write into requests-staging, so the body only has to be a
  // body; it is not handed to a unit here.
  let body = join([
    "start-wait", wet_probe_node as String, launcher_probe_key(unit_key: "spool-control"),
    inst.directory_owner.user as String, inst.repo_root as String,
    launcher_probe_worktree(instance: inst, unit_key: "spool-control"), join([root as String, "/spool-control.out"], ""),
    join([root as String, "/spool-control.err"], ""),
    "65536", join(["+", root as String, "/spool-control.hook"], ""),
    join(launcher_gunbc_run_inner_argv(instance: inst, function: "exit_success_cli", extra_args: []), "\u{1f}"),
    wet_run_nonce(),
  ], "\n")
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    // Every entry is under the claim's own root, AND the staging directory the srv2 unit could not
    // create is named outright -- a fold over an empty list would be vacuously true, so the fault path
    // itself is a conjunct and cannot be dropped by emptying the accessor list.
    && is_under(text: attempt_unit_spool_staging_dir(instance_root: inst.instance_root as String), root: root)
    && fold(dirs, init: true, f: (ok, dir) => ok && is_under(text: dir, root: root))
    && prepare_probe_attempt(instance: inst)
    && fold(dirs, init: true, f: (ok, dir) => ok && wet_path_exists(path: dir))
    && wet_octal_mode(path: attempt_unit_spool_staging_dir(instance_root: inst.instance_root as String)) == "700"
    // EVERY ROUTE, NOT ONLY THE ONE THAT FAILED FIRST. The srv2 ENOENT came out of the ENQUEUE
    // itself -- attempt_system_unit_enqueue_request makes the staging leaf with
    // shell.Mkdir.NewOwnerOnly (no -p), so it dies when requests-staging is absent -- and the
    // launcher legs reach this tree through their own preamble, not through prepare_probe_attempt.
    // So the control performs the write that actually failed, on the launcher route's own sequence,
    // and reads the queued body back at the path the row derives.
    && prepare_launcher_probe(instance: inst, unit_key: "spool-control")
    && wet_stage(
      stage: "spool-tree-prepared:spool-control",
      ok: wet_prepare_attempt_unit_spool(instance: inst),
    )
    && match attempt_system_unit_enqueue_request(
      instance_root: inst.instance_root as String,
      node_id: wet_probe_node as String,
      attempt_key: launcher_probe_key(unit_key: "spool-control"),
      body: body,
    ) {
      AttemptSystemUnitEnqueued { entry: entry, body: _ } =>
        wet_path_exists(path: attempt_system_unit_request_path(instance_root: inst.instance_root as String, entry: entry))
      AttemptSystemUnitEnqueueOccupied { entry: _ } => false
      AttemptSystemUnitEnqueueRefused { detail: _ } => false
    }
  // CLEANUP IS NOT A CONJUNCT. The srv2 run left twenty claim roots because a leg that fails
  // before the end of an `&&` chain never reaches a removal sitting at the end of it; the same
  // defect showed up in this file's own BROKEN run, where a claim that was already FAIL left
  // /tmp/gunbc-sandbox-spool-... on disk. The verdict is bound first, then the root is
  // taken away, and a root still on disk reddens the claim.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}

test fn the_supplied_source_is_a_real_repository() -> Bool {
  // srv2, cause (C): `git -C <root>/source worktree add --detach` died 128 "not a git repository",
  // because a copied working tree is not a repository. The readback asks GIT, not the filesystem:
  // `git rev-parse HEAD` of the planted source must be an accepted command that prints a tree -- on a
  // tree with no commit git exits 128, and on a directory with no repository git says so, so an empty
  // or refused reading is the fault this claim exists to catch.
  let root = wet_claim_root(tag: "gitrepo" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let repo = inst.repo_root as String
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_guest_sources(instance: inst)
    && wet_path_exists(path: join([repo, "/.git"], ""))
    && wet_ok(command: git_rev_parse_tree_command(repository_dir: repo, revision: "HEAD" as NonEmptyStr))
    && wet_out(command: git_rev_parse_tree_command(repository_dir: repo, revision: "HEAD" as NonEmptyStr)) != ""
    // AND THE OTHER PLANT ROUTE PRODUCES THE SAME THING. srv2's fifth S1 and the local re-run at
    // 74683828 caught two routes preparing one tree: wet_plant_guest_sources committed through
    // git init/add/commit, while wet_plant_confined_tree only mkdir'd a .git/hooks and .git/objects
    // SKELETON -- a directory named .git, not a repository. The legs that launch (they have to name
    // the tree's commit for the locus) refused with 'not a git repository' while this claim, which
    // uses the committing route, stayed green: two answers, one tree, because two routes prepared
    // it. Both routes now go through wet_make_source_repository, and this claim asks BOTH of them
    // the same question, so a plant route that stops producing a repository is RED here rather
    // than a status code on another host. The hooks/ readback is the same claim asking that the
    // directories the refusal legs write into (.git/hooks/post-commit, .git/objects/...) exist.
    && wet_plant_confined_tree(instance: inst)
    && witness_guest_tree_revision(instance: inst) != ""
    && wet_path_exists(path: join([repo, "/.git/hooks"], ""))
  // CLEANUP IS NOT A CONJUNCT. The srv2 run left twenty claim roots because a leg that fails
  // before the end of an `&&` chain never reaches a removal sitting at the end of it; the same
  // defect showed up in this file's own BROKEN run, where a claim that was already FAIL left
  // /tmp/gunbc-sandbox-gitrepo-... on disk. The verdict is bound first, then the root is
  // taken away, and a root still on disk reddens the claim.
  // AND THE CONFINED ROUTE ALONE, IN A ROOT NOTHING ELSE TOUCHES. Asking that second question in the
  // SAME root as the first would be vacuous: `wet_plant_guest_sources` has already copied `dag/` and
  // `src/v2/` there, so "does the confined route leave a `dag/`?" could only ever be answered by the other
  // route's work -- which is how the half-repair at 74683828 stayed green here while srv2's S1 at 4ffbdfcc
  // went red two legs away. The two sandbox-touch claims
  // (`writes_to_the_deployed_binary_and_tree_fail_inside_the_worker_sandbox`,
  // `the_worker_worktree_is_writable_inside_the_same_sandbox`) plant ONLY through the confined route, and
  // their assertions -- and the `--source-root` of the inner argv they launch -- address
  // `<root>/source/dag`, which that route had never produced. This is the local half of that fault: red
  // with the delegation reverted, for the same reason srv2 saw it, and green without a root launcher.
  let confined_only_root = wet_claim_root(tag: "confined-only" as NonEmptyStr)
  let confined_only_inst = wet_supplied_lab_instance(scratch_parent: confined_only_root)
  let confined_only_repo = confined_only_inst.repo_root as String
  let confined_only = wet_claim_is_confined(instance: confined_only_inst, root: confined_only_root)
    && wet_plant_confined_tree(instance: confined_only_inst)
    && wet_path_exists(path: join([confined_only_repo, "/dag"], ""))
    && wet_path_exists(path: join([confined_only_repo, "/src/v2"], ""))
    && witness_guest_tree_revision(instance: confined_only_inst) != ""

  // BOTH ROOTS, ALWAYS: the ordinary plant and the confined-only plant are two claims' worth of trees in
  // one run, and the second must not survive a RED in the first.
  wet_claim_verdicts_with_root_readbacks(
    verdict: verdict && confined_only,
    roots: [root, confined_only_root]
  )
}

test fn the_supplied_unit_credential_is_under_the_root_and_the_live_credstore_is_refused() -> Bool {
  // srv2, cause (B): the unit carried -p LoadCredential=gunbc-gpu-pod-api-key:/etc/credstore/... and
  // exited 243 (CREDENTIALS) before the claim's command ran, because the supplied row kept the lab
  // row's WorkerDedicatedAccount and dispatch_worker_credstore_path is a data constant (/etc/credstore)
  // plus identifier plus instance id. Three things, all readable without systemd: the credential a
  // supplied unit could be handed lives under the claim's own root at mode 0400; the lab row's own
  // derived credential path does NOT; and the fixture's arm therefore REFUSES the lab row, so putting
  // that variant back into a supplied row is a red claim here instead of a status code on another host.
  let root = wet_claim_root(tag: "credential" as NonEmptyStr)
  let inst = wet_supplied_lab_instance(scratch_parent: root)
  let source = witness_supplied_credential_source(instance: inst, file: operator_route_credential_file) as String
  let lab = srv1_lab_dashboard_instance()
  let lab_source = witness_supplied_credential_source(instance: lab, file: operator_route_credential_file) as String
  let verdict = wet_claim_is_confined(instance: inst, root: root)
    && wet_plant_confined_tree(instance: inst)
    && is_under(text: source, root: root)
    && wet_path_exists(path: source)
    && wet_octal_mode(path: source) == "400"
    && is_under(text: witness_supplied_credstore_dir(instance: inst), root: root)
    // THE LIVE SPELLING, NAMED BY ITS OWN AUTHORITY AND REFUSED. This is the path srv2's unit was
    // handed: dispatch_worker_credstore_path is <systemd_system_credstore_directory>/<identifier>-<id>,
    // a constant outside every claim root, and it is reachable from a row ONLY through
    // WorkerDedicatedAccount. The lab row carries that variant, so the witness placement for the lab row
    // also lands under the live lab root (/opt/gunbc-lab/instances/...) -- two live roots, one variant.
    // The fixture's arm therefore refuses any row whose credential source escapes the claim root, which
    // is what makes putting `worker: lab.worker` back into a supplied row a red claim here rather than a
    // status 243 on some other host.
    && starts_with(s: dispatch_worker_credstore_path(instance: lab, file: operator_route_credential_file) as String, prefix: "/etc/credstore/")
    && !is_under(text: lab_source, root: root)
    && !witness_supplied_credential_is_confined(scratch_parent: root, instance: lab)
  // CLEANUP IS NOT A CONJUNCT. The srv2 run left twenty claim roots because a leg that fails
  // before the end of an `&&` chain never reaches a removal sitting at the end of it; the same
  // defect showed up in this file's own BROKEN run, where a claim that was already FAIL left
  // /tmp/gunbc-sandbox-credential-... on disk. The verdict is bound first, then the root is
  // taken away, and a root still on disk reddens the claim.
  wet_claim_verdict_with_root_readback(verdict: verdict, root: root)
}
