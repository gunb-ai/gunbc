module test.claim.roadmap.dispatch_worker_writable_sandbox_wet_witness

import std.types { Bool, String, List, NonEmptyStr, Int }
import std.measure { kibibyte }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.shell
import extdeps.systemd.systemd_run {
  systemd_run_user_wait_command,
  systemd_run_command_argument_words,
  SystemdSummaryPrintingWaitReady,
  SystemdSummaryPrintingWaitRefused,
  SystemdRunProperty,
}
import gunbc.roadmap.roadmap_dispatch_actuator { dispatch_worker_unit_properties }
import gunbc.roadmap.roadmap_session_placement { session_process_bounds }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance,
  srv1_live_dashboard_instance,
  dashboard_instance_dispatch_worktree_root,
  dashboard_instance_dispatch_attempt_state_root,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WET: a real systemd-run user transient with the worker unit's production properties, then one
// argv `touch -- <path>` per subject. Local recipe: claim_batch --wet --source-root dag
// --source-root src/v2 --entry dag/test/claim/roadmap/dispatch_worker_writable_sandbox_wet_witness.dag
// Requires a user systemd manager (srv1 lab).

fn worker_probe_properties(instance: HostDashboardInstance, worktree: String, scratch: String) -> List<SystemdRunProperty> {
  dispatch_worker_unit_properties(
    instance: instance,
    working_directory: worktree,
    worker_log_path: join([scratch, "/.gunbc-writable-probe.log"], ""),
    granted: kibibyte(count: 65536),
    process_bounds: session_process_bounds,
    exit_hook: "true" as NonEmptyStr,
  )
}

fn sandbox_touch_exit(instance: HostDashboardInstance, worktree: String, scratch: String, unit: NonEmptyStr, path: String) -> Int {
  match systemd_run_user_wait_command(
    unit: unit,
    properties: worker_probe_properties(instance: instance, worktree: worktree, scratch: scratch),
    setenv_bindings: [],
    command_argv: ["/usr/bin/touch", "--", path],
  ) {
    SystemdSummaryPrintingWaitRefused { cause: _ } => 127
    SystemdSummaryPrintingWaitReady { wait: wait } =>
      shell.Exec.RunArgv(
        program: "systemd-run",
        arguments: systemd_run_command_argument_words(command: wait.command),
      ).exit_code
  }
}

test fn writes_to_the_deployed_binary_and_tree_fail_inside_the_worker_sandbox() -> Bool {
  let inst = srv1_live_dashboard_instance()
  let wt = dashboard_instance_dispatch_worktree_root(instance: inst) as String
  let scratch = dashboard_instance_dispatch_attempt_state_root(instance: inst) as String
  sandbox_touch_exit(
    instance: inst,
    worktree: wt,
    scratch: scratch,
    unit: "gunbc-writable-probe-bin.service" as NonEmptyStr,
    path: join([inst.serve_binary as String, ".write-probe"], ""),
  ) != 0
    && sandbox_touch_exit(
      instance: inst,
      worktree: wt,
      scratch: scratch,
      unit: "gunbc-writable-probe-tree.service" as NonEmptyStr,
      path: join([inst.repo_root as String, "/.gunbc-worker-write-probe"], ""),
    ) != 0
}

test fn the_worker_worktree_is_writable_inside_the_same_sandbox() -> Bool {
  let inst = srv1_live_dashboard_instance()
  let wt = dashboard_instance_dispatch_worktree_root(instance: inst) as String
  let scratch = dashboard_instance_dispatch_attempt_state_root(instance: inst) as String
  let probe = join([wt, "/.gunbc-worker-write-probe"], "")
  let wrote = sandbox_touch_exit(
    instance: inst,
    worktree: wt,
    scratch: scratch,
    unit: "gunbc-writable-probe-wt.service" as NonEmptyStr,
    path: probe,
  ) == 0
  let _cleaned = shell.Exec.RunArgv(program: "rm", arguments: ["-f", "--", probe])
  wrote
}
