// THE ROUTE COUNT STOPPED BEING A LITERAL, replaced by the claim the literal stood in for. Sixteen
// was read off the live route roster, so adding /provider.json — a correct route this PR needed —
// reds a witness with nothing to say about which routes exist: the live-state count-transcription
// class ruled against on 2026-07-29 and swept in #7464, a third instance (review, 2026-07-30, found
// by the full floor rather than any targeted run).\n\nThe replacement is strictly stronger. This
// witness is for the live table BUILDING — the refusing arm below is the other half — and the
// interesting failure is a build that silently drops a route rather than refusing.
// serve_page_response_note in this module names that hazard: the EmitRejected => [] route-drop in
// node_http_server_emit is a silent widen this path deliberately does not copy. A literal count
// cannot tell a dropped route from a roster that legitimately grew; comparing against the roster
// can, and never needs editing again.\n\nThe non-emptiness conjunct stays because equality
// between two empty lists would hold vacuously.

test fn witness_live_table_builds_ready_routes() -> Bool {
  match roadmap_serve_route_table_build() {
    ServedRouteTableBuilt { table: t } =>
      count(t.routes) > 0 && count(t.routes) == count(roadmap_serve_route_specs())
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => false
  }
}

// The RED control for review 40286's section-5 catch: a malformed route literal through the SAME
// build fold must REFUSE the whole table (typed, carrying the broken raw), never fabricate an empty
// template that would silently match '/'.

test fn witness_malformed_route_literal_refuses_table() -> Bool {
  let specs = [
    ServedRouteSpec { method: GET, raw: "/ok", handler: HealthzHandler },
    ServedRouteSpec { method: GET, raw: "/dispatch/\{node_id", handler: BeltDispatchHandler },
  ]
  match serve_build_route_table(specs: specs) {
    ServedRouteTableBuildRefused { raw: r, segment: _, reason: _ } => r == "/dispatch/\{node_id"
    ServedRouteTableBuilt { table: _ } => false
  }
}

test fn witness_unknown_method_refuses() -> Bool {
  match parse_http_method_label(label: "BREW") {
    UnknownMethod { label: l } => l == "BREW"
    KnownMethod { method: _ } => false
  }
}

// review 40359: an unrecognized method label is 501 Not Implemented (RFC 9110 section 15.6.2 — the
// server does not implement the method at all), NEVER 405 (405 means the ROUTE exists but this
// method is not in its allowed set, and carries the allowed set — the MethodNotAllowed arm). The
// two arms must stay distinct statuses; collapsing them reds this row.

test fn witness_unknown_method_folds_501_response() -> Bool {
  let r = roadmap_serve_respond(method_label: "BREW", path: "/", body: "", tailscale_identity: "", release_revision: deploy_witness_release_revision)
  r.status == 501 && string_contains(s: r.body, pattern: "BREW")
}

test fn witness_known_methods_parse() -> Bool {
  match parse_http_method_label(label: "GET") {
    KnownMethod { method: m } => m == GET
    UnknownMethod { label: _ } => false
  }
  && match parse_http_method_label(label: "POST") {
    KnownMethod { method: m } => m == POST
    UnknownMethod { label: _ } => false
  }
}

// ── The approval routes: opening the link is not deciding ────────────────────────────────────
// THE PAIR EXISTS SO THESE TWO ARE DISTINGUISHABLE. A GET at the approval URL must render and
// stop; everything that fetches a URL without a person behind it -- link previews, mail scanners,
// chat unfurlers, browser prefetch -- issues exactly that request, and if it decided, an approval
// would be spent with an audit row naming the operator.

test fn a_get_at_the_approval_url_renders_and_does_not_decide() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "GET",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "does not decide anything")
    && string_contains(s: r.body, pattern: "abc123")
    && string_contains(s: r.body, pattern: "method=\"post\"")
    && string_contains(s: r.body, pattern: "action=\"/approve/abc123\"")
}

// THE POST IS A DIFFERENT ROUTE, and the hermetic frame can reach it only up to the first host
// read: once approval_identity_trust is established (it is derived from the instance bind, and
// opens with the loopback row), a well-formed segment goes on to Clock.Now, the keyring and the
// store, none of which has a hermetic arm. So this witness posts a segment that is not <escalation>.<decision>.<hex> and
// pins that the refusal is 400 BEFORE any of those reads -- the ordering that also protects the
// live route from spending effects on the way to a refusal. Redemption of a real segment is
// covered by the store witness (redeem_over_store) and the live probe.
test fn a_post_at_the_approval_url_refuses_rather_than_reporting_a_decision() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 400
    && string_contains(s: r.body, pattern: "capability segment is not")
    && !string_contains(s: r.body, pattern: "does not decide anything")
}

// THE FILING ROUTE STILL MOUNTED HERE IS NOT THE WRITER: under the cutover posture
// (gunbc.auth.approval_cutover_posture BrokerServesAndWrites) this process is refused at writer
// admission -- a 503 naming both processes -- before the envelope parse and before the store, keys
// or publisher are read, which is also why this witness reaches the route in the hermetic frame.
// The writer's parse-first behaviour is the broker's own claim
// (test.claim.approval_broker_serve_witness the_writer_reaches_the_submission_fold_rather_than_the_gate).
// THE RED: drop the admission consult from approval_submit_response and this route parses the
// body and answers 400 "submission unreadable".
test fn an_unreadable_submission_is_refused_before_any_host_read() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approvals",
    body: "not an envelope",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 503 && string_contains(s: r.body, pattern: "writer authority is held by")
    && !string_contains(s: r.body, pattern: "submission unreadable")
}

// THE TRANSPORT OBSERVATION DOES NOT REACH THE HANDLER AS IDENTITY. Under the 2026-09-25 ruling
// this is the end-to-end forged-header control: a login supplied at the serve entry is DROPPED
// unless the access-path modeling vouches for it — and this entry's ingress attests no peer, so
// nothing can — so the consent record names no login. Without this the plumbing could
// be silently laundering the header back into an identity and every unit-level witness would
// still pass. The positive half (a modeled proxy path carries the observation) is
// test.claim.request_authentication_witness's subject; the wiring between them is one function
// call, roadmap_serve_request_security.
test fn a_tailnet_header_without_readback_reaches_the_approval_handler_as_absent() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  string_contains(s: r.body, pattern: "transport observation: \n")
    && !string_contains(s: r.body, pattern: "briansrls")
}

// AND A GENUINELY ABSENT HEADER IS THE SAME ANSWER: no observation, no identity, no default.
test fn an_absent_header_arrives_at_the_handler_as_absent() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  string_contains(s: r.body, pattern: "transport observation: \n")
    && !string_contains(s: r.body, pattern: "briansrls")
}

test fn a_garbage_approval_submission_is_400_and_names_the_unreadable_body() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approvals",
    body: "nope",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 400
    && string_contains(s: r.body, pattern: "approval submission:")
    && !string_contains(s: r.body, pattern: "http")
}

test fn an_unfiled_escalation_status_is_text_plain_standing() -> Bool {
  let body = filed_approval_status_text(status: StatusNotFiled)
  string_contains(s: body, pattern: "standing=")
    && !string_contains(s: body, pattern: "{")
}

// ── The plan authority is a parameter ───────────────────────────────────────────────────────────
//
// THE DISCRIMINATING DIRECTION IS THE NEGATIVE. Asserting that a caller-supplied plan appears in
// the response would stay green if a surface under the route ALSO read the public carrier and
// concatenated both; asserting that the public roadmap's own section title is ABSENT is what goes
// red the moment any consumer below the parameterized fold reaches past its parameter to
// roadmap_authority_projection(). That is the whole claim of the seam: one response, one plan.
//
// THE PATHS ARE CITED, NEVER SPELLED. The first cut of these witnesses typed "/roadmap.md" and
// "/dispatch.json"; neither is a route, so all three asked an unrouted path and asserted nothing
// (review 63317; the operator confirmed the 404s against a running instance). A witness that
// spells its own copy of a route is a second authority for it, and it rots exactly that way. These
// read the same declarations gunbc.roadmap_serve now builds its route table from, so a renamed
// route moves the table and the witness together.

fn caller_supplied_plan_section_title() -> String { "A plan supplied by the caller" }

// The public roadmap's own section title, from gunbc.roadmap_authority active_section_for_acceptance.
// Its presence in a response rendered over a caller-supplied plan IS the leak.
fn public_plan_section_title() -> String { "Active deliverables" }

fn caller_supplied_plan_fixture() -> RoadmapAuthorityProjection {
  RoadmapAuthorityProjected {
    doc: RoadmapDocument {
      preamble: [],
      lead_lanes: [],
      sections: [
        RoadmapSection { title: caller_supplied_plan_section_title(), elements: [] },
      ],
    },
    accepted: [],
    withheld: [],
  }
}

fn serve_over_plan(plan: RoadmapAuthorityProjection, path: String) -> ServeHttpResponse {
  serve_over_plan_declaring(plan: plan, daily_body: DailyBodyRenderedUnderThisPlan, path: path)
}

fn serve_over_plan_declaring(
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  path: String,
) -> ServeHttpResponse {
  roadmap_serve_respond_over(
    instance: srv2_preview_dashboard_instance(),
    plan: fn() { plan },
    daily_body: daily_body,
    method_label: "GET",
    path: path,
    body: "",
    tailscale_identity: "",
    ingress: IngressUnattested,
    release_revision: deploy_witness_release_revision,
  )
}

test fn witness_dispatch_json_answers_from_the_supplied_plan() -> Bool {
  let r = serve_over_plan(
    plan: caller_supplied_plan_fixture(),
    path: roadmap_site_dispatch_url_path as String,
  )
  r.status == 200
    && !string_contains(s: r.body, pattern: public_plan_section_title())
}

// A plan that failed to project refuses in ITS OWN vocabulary rather than serving an empty
// roadmap: the detail the caller handed over is what the reader sees.
test fn witness_supplied_plan_refusal_travels_to_the_wire() -> Bool {
  let detail = "the caller's plan carrier could not be read"
  let dispatch = serve_over_plan(
    plan: RoadmapAuthorityProjectionRefused { detail: detail },
    path: roadmap_site_dispatch_url_path as String,
  )
  string_contains(s: dispatch.body, pattern: "\"refused\": true")
    && !string_contains(s: dispatch.body, pattern: public_plan_section_title())
    && string_contains(s: dispatch.body, pattern: detail)
}

// A CONTROL FOR THE CONTROL. The witnesses above are claims about the PLAN, and a wrong path
// would make every one of them vacuous while looking identical to a pass on the negative
// assertions. This one asks an unrouted path and requires the 404, so "the responder answered from
// the supplied plan" stays distinguishable from "the responder never reached a handler".
test fn witness_an_unrouted_path_is_refused_not_answered() -> Bool {
  let r = serve_over_plan(plan: caller_supplied_plan_fixture(), path: "/roadmap.md")
  r.status == 404
}

// ── The DAILY surface, which is where the seam leaked ───────────────────────────────────────────
//
// WHAT THIS PROBE IS, AND WHAT IT IS NOT. It is a composition check over the served daily fold
// (roadmap_daily_workspace_page_for_projection_observed_stale_with_stylesheet) on both arms. It is NOT the control for the
// leak that review 63317 found, and the first version of this block claimed it was.
//
// The claim was tested and it was false. With the leak deliberately restored in an isolated
// worktree -- the refused arm routed back through the fold that read
// accepted_roadmap_node_ids_projection() -- this witness still PASSED. The reason is structural,
// not a weak assertion: under the hermetic witness route the carrier read REFUSES, that fold takes
// its own refused arm, and it produces the same empty accepted set a clean render produces. No
// input reachable from here distinguishes the two, so the RED is not authorable and no stronger
// assertion could have made it so.
//
// DESIGN 4b: a check whose RED cannot be authored is not a weak wall, it is a decoration, and worse
// than absent because it gets cited as coverage. So the defect was closed by CONSTRUCTION instead
// (gunbc.roadmap_page: the ambient-reading fold is deleted, and every caller supplies its accepted
// set), and this block says plainly what it still earns: that both arms render, that a refused plan
// carries the CALLER's detail rather than an empty public roadmap, and that the workspace readiness
// strip renders in both. The v1-exit finish-line count text is retired from the strip (owner ruling
// 2026-09-28), so neither the text nor its helper survives here.
//
// The negative used on the route witnesses above would be decoration here for a second reason: the
// daily page renders work rows and bands, never the roadmap's section headings, so its absence is
// true of a clean render too.

// The served daily fold every observed render delegates to, with the head's style text supplied
// empty: the claim reads the plan's arms in the body, never the stylesheet.
fn daily_page_html_over_plan(plan: RoadmapAuthorityProjection) -> String {
  match try_serialize_html_source(node: roadmap_daily_workspace_page_for_projection_observed_stale_with_stylesheet(
    proj: plan,
    attempts: [],
    attempts_refused: none,
    standings: StandingsUnobserved { reason: "witness render: the event carrier is not consulted" },
    launch: launch_host_unobserved_static_render(),
    stale_nodes: [],
    profiles: [],
    memberships: roadmap_memberships(),
    stylesheet: site_styles(rules: []),
  )) {
    EmitOk { html } => html
    EmitRejected { reason } => reason
  }
}

// ── The route the plan parameter CANNOT reach refuses instead of answering ───────────────────────
//
// DESIGN 4b puts silent wrongness outside the ladder and forbids it outright, so the plan parameter
// may not create a path where / answers 200 from a body rendered under an authority nobody can
// name. The agreement is a declared fact of the call, and a caller that cannot declare it is
// refused on that ONE route (review 63390). This is the executing evidence for that arm, and for
// its other half: refusing / must not cost the routes whose plan DOES reach them.

test fn witness_undeclared_daily_body_refuses_rather_than_answering() -> Bool {
  let r = serve_over_plan_declaring(
    plan: caller_supplied_plan_fixture(),
    daily_body: DailyBodyAuthorityUnknown,
    path: roadmap_site_daily_url_path as String,
  )
  r.status == 503
    && string_contains(s: r.body, pattern: "carries no identity of the authority it came from")
    && string_contains(s: r.body, pattern: "served_observation_observe_and_write_over")
    && string_contains(s: r.body, pattern: "a_prerendered_body_carries_no_identity_of_its_source")
}

// THE POSITIVE CONTROL, without which the refusal above is satisfiable by refusing everything: a
// caller that cannot vouch for the daily body still gets every other route answered from its own
// plan, and the refusal is located on / alone.
test fn witness_undeclared_daily_body_costs_no_other_route() -> Bool {
  let dispatch = serve_over_plan_declaring(
    plan: caller_supplied_plan_fixture(),
    daily_body: DailyBodyAuthorityUnknown,
    path: roadmap_site_dispatch_url_path as String,
  )
  dispatch.status == 200
    && !string_contains(s: dispatch.body, pattern: public_plan_section_title())
}

// THE ISSUE DETAIL ROUTES (owner ruling 2026-09-24): the issue's detail page is a real served
// route — GET /issue/<node-id> selects the detail handler, POST /issue/<node-id>/assign selects
// the durable-assign handler. Same table, same selection idiom as every other route.
test fn witness_issue_detail_route_selects() -> Bool {
  selects(method: GET, path: "/issue/some-node", want: IssueDetailPageHandler)
    && selects(method: GET, path: "/issue/some-node/assignment", want: IssueAssignmentContextHandler)
    && selects(method: POST, path: "/issue/some-node/assign", want: IssueAssignHandler)
    && selects(method: POST, path: "/issue/some-node/comment", want: IssueCommentHandler)
}

// THE CREATE ROUTES: POST /issues is the write, GET /issues/new is the composer page.
test fn witness_issue_create_routes_select() -> Bool {
  selects(method: POST, path: "/issues", want: IssueCreateHandler)
    && selects(method: GET, path: "/issues/new", want: IssueCreatePageHandler)
}

// ── The durable assign route: validation, concurrency, and the fabric execution entry point ──────
// THE ASSIGN BODY'S WIRE SHAPE (the form ships enctype text/plain): a field reads as its own
// name=value line, absent reads as empty; no percent-encoding exists to undo, and a value never
// bleeds across lines.
test fn witness_assign_form_field_reads_urlencoded_body() -> Bool {
  let body = "expected_revision=abc123&return_to=&assignee=briansrls%40gunb.ai"
  issue_form_field(body: body, name: "assignee") == "briansrls@gunb.ai"
    && issue_form_field(body: body, name: "expected_revision") == "abc123"
    && issue_form_field(body: body, name: "return_to") == ""
    && issue_form_field(body: body, name: "missing") == ""
    && issue_form_field(body: "assignee=a@b.c", name: "assignee") == "a@b.c"
}

// THE ROUTE'S EARLY REFUSALS refuse before any host read (hermetic): an unknown issue is 404,
// and a request WITHOUT a Google session is 403 at the write law's authentication axis —
// whether or not a tailnet header is present (the 2026-09-25 ruling's no-fallback law: tailnet
// transport alone authorizes no write), and the 403 precedes even selector validation.
test fn witness_assign_route_refuses_404_and_403_before_any_host_read() -> Bool {
  let unknown = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/no-such-issue/assign",
    body: "assignee=briansrls@gunb.ai",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  let no_session_no_header = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/assign",
    body: "assignee=briansrls@gunb.ai",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  let tailnet_only = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/assign",
    body: "assignee=briansrls@gunb.ai",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  let bad_selector_tailnet_only = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/assign",
    body: "assignee=not-an-email",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  unknown.status == 404
    && no_session_no_header.status == 403
    && string_contains(s: no_session_no_header.body, pattern: "google-oidc-session")
    && tailnet_only.status == 403
    && string_contains(s: tailnet_only.body, pattern: "tailnet transport is not authentication")
    && bad_selector_tailnet_only.status == 403
}

fn fixture_human_ref() -> PrincipalRef {
  PrincipalRef { authority: "google-oidc" as NonEmptyStr, namespace: "accounts" as NonEmptyStr, subject: "sub-human" as NonEmptyStr }
}

// CONTROL 3, at the response seam: a HUMAN assignee NEVER dispatches — the follow-through records
// the fact and stops, with no launch vocabulary anywhere in the body.
test fn witness_human_assignment_never_dispatches() -> Bool {
  let r = serve_assignment_launch_follow_through_over(
    instance: srv2_preview_dashboard_instance(),
    plan: caller_supplied_plan_fixture(),
    node_id: "some-node",
    assignee: fixture_human_ref(),
    event_id: "evt-1",
    profiles: [],
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "assigned: some-node → principal:google-oidc/accounts/sub-human (event evt-1)")
    && !string_contains(s: r.body, pattern: "fabric")
    && !string_contains(s: r.body, pattern: "waiting on")
    && !string_contains(s: r.body, pattern: "session")
}

// CONTROL 5, at the response seam: an admission refusal DOES NOT UNDO the assignment — the body
// opens with the recorded fact, the issue STAYS with Fabric, and the waiting condition is located
// in the launch's typed vocabulary (label + reason), never "assignment failed". The status is the
// launch refusal's own mapping.
test fn witness_fabric_refusal_leaves_fabric_assigned_and_locates_the_wait() -> Bool {
  let blocked = serve_fabric_assignment_response(
    node_id: "some-node",
    assignee_display: principal_ref_label(p: fabric_workflow_principal),
    event_id: "evt-2",
    outcome: na(r: LaunchNotReady { missing: [GapDependencies { blockers: ["dep-a", "dep-b"] }] }),
  )
  let no_capacity = serve_fabric_assignment_response(
    node_id: "some-node",
    assignee_display: principal_ref_label(p: fabric_workflow_principal),
    event_id: "evt-3",
    outcome: na(r: LaunchNoCapacity { occupied: 3, max_concurrent: 3 }),
  )
  blocked.status == 409
    && string_contains(s: blocked.body, pattern: "assigned: some-node → principal:gunbc/workflows/fabric (event evt-2)")
    && string_contains(s: blocked.body, pattern: "waiting on fabric: not_ready")
    && string_contains(s: blocked.body, pattern: "prerequisites not closed: dep-a, dep-b")
    && string_contains(s: blocked.body, pattern: "the assignment stands")
    && !string_contains(s: blocked.body, pattern: "assignment failed")
    && no_capacity.status == 409
    && string_contains(s: no_capacity.body, pattern: "waiting on fabric: no_capacity")
    && string_contains(s: no_capacity.body, pattern: "belt at capacity: 3 of 3 slots occupied")
    && !string_contains(s: no_capacity.body, pattern: "assignment failed")
}

// CONTROL 4's success arm: an admitted fabric request names the session and points at the Work tab
// — the page reflects the attempt through the existing workflow machinery.
test fn witness_fabric_assignment_admitted_names_the_session() -> Bool {
  let r = serve_fabric_assignment_response(
    node_id: "some-node",
    assignee_display: principal_ref_label(p: fabric_workflow_principal),
    event_id: "evt-4",
    outcome: Spawned { node_id: "some-node", session_name: "gunbc-some-node-abc", provider: "codex", launch: launch_identity_exemplar() },
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "assigned: some-node → principal:gunbc/workflows/fabric (event evt-4)")
    && string_contains(s: r.body, pattern: "fabric work request admitted: session gunbc-some-node-abc")
    && string_contains(s: r.body, pattern: "Work tab")
}

// RE-ASSIGNING THE SAME REVISION JOINS THE EXISTING REQUEST: the admission's already-live arm
// refuses the duplicate attempt, and the response says the assignment stands beside the refusal —
// one work request, never a second attempt.
test fn witness_reassign_same_revision_joins_the_existing_request() -> Bool {
  let r = serve_fabric_assignment_response(
    node_id: "some-node",
    assignee_display: principal_ref_label(p: fabric_workflow_principal),
    event_id: "evt-5",
    outcome: na(r: LaunchAlreadyLive { session_name: "gunbc-some-node-abc" }),
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "waiting on fabric: already_live")
    && string_contains(s: r.body, pattern: "attempt already live in gunbc-some-node-abc")
    && string_contains(s: r.body, pattern: "joins the existing attempt when one is live")
}

// ── The durable comment route: body wire shape, early refusals, retry-idempotence ────────────────
// THE COMMENT BODY'S WIRE SHAPE: the body rides LAST (markdown freely carries newlines) — the
// parse cuts at the FIRST body= opener and keeps everything after it verbatim, including a
// literal "body=" inside the text or trailing newlines; a wire with no body field reads "".
test fn witness_comment_body_parse_cuts_at_the_first_field_and_keeps_markdown_verbatim() -> Bool {
  let with_key = "key=abc-123&expected_revision=&body=first+line%0Asecond+line%0Abody%3D+not+a+field"
  let keyless = "body=just the body"
  let trailing_newlines = "key=k&body=line%0A%0A"
  let no_body = "key=k&expected_revision=x"
  issue_comment_body_of(wire: with_key) == "first line\nsecond line\nbody= not a field"
    && issue_comment_body_of(wire: keyless) == "just the body"
    && issue_comment_body_of(wire: trailing_newlines) == "line\n\n"
    && issue_comment_body_of(wire: no_body) == ""
    && issue_comment_body_of(wire: "") == ""
}

// THE COMMENT ROUTE'S EARLY REFUSALS refuse before any host read (hermetic): an unknown issue is
// 404, and a request WITHOUT a Google session is 403 at the write law's authentication axis —
// tailnet header or not — with the 403 preceding even the empty-body validation.
test fn witness_comment_route_refuses_404_and_403_before_any_host_read() -> Bool {
  let unknown = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/no-such-issue/comment",
    body: "body=hello",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  let no_session_no_header = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/comment",
    body: "body=hello",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  let tailnet_only = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/comment",
    body: "body=hello",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  let empty_body_tailnet_only = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/issue/vm-service/comment",
    body: "key=k&body=",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  unknown.status == 404
    && no_session_no_header.status == 403
    && string_contains(s: no_session_no_header.body, pattern: "google-oidc-session")
    && tailnet_only.status == 403
    && string_contains(s: tailnet_only.body, pattern: "tailnet transport is not authentication")
    && empty_body_tailnet_only.status == 403
}

// THE RECORDED RESPONSE names the deep link — the FIRST WRITE and the RETRY share its spelling,
// so the client re-anchors instead of re-posting (control 6's write-side half: a retry of either
// shape reads back the same address).
test fn witness_comment_recorded_response_names_the_deep_link() -> Bool {
  let comments = [
    IssueComment { ordinal: 1, comment: "k1" as NonEmptyStr, author: EventPrincipalAuthenticated { ref: fixture_human_ref() }, body: "one", visibility: "public" as NonEmptyStr, parent_comment: none, created_at: "t1", edited_at: "", deleted: false },
    IssueComment { ordinal: 2, comment: "k2" as NonEmptyStr, author: EventPrincipalAuthenticated { ref: fixture_human_ref() }, body: "two", visibility: "public" as NonEmptyStr, parent_comment: none, created_at: "t2", edited_at: "", deleted: false },
  ]
  let first = serve_comment_recorded_response(node_id: "demo-node", comments: comments, comment: "k2", event_id: "evt-9", already_present: false)
  let retry = serve_comment_recorded_response(node_id: "demo-node", comments: comments, comment: "k2", event_id: "", already_present: true)
  let missing = serve_comment_recorded_response(node_id: "demo-node", comments: comments, comment: "k9", event_id: "evt-10", already_present: false)
  first.status == 200
    && string_contains(s: first.body, pattern: "comment recorded: /issue/demo-node#comment-2 (event evt-9)")
    && retry.status == 200
    && string_contains(s: retry.body, pattern: "comment recorded (already present): /issue/demo-node#comment-2")
    && missing.status == 502
    && !string_contains(s: missing.body, pattern: "#comment-")
}

// ── The auth routes (lane A3 frontier 3) ───────────────────────────────────────────────────────
// The login surface's controls drive the handlers' PURE arms — the route table membership, the
// config refusal, the redirect construction, the wrong-state refusal, the session render, the
// logout clearing — exactly the arms the witnesses name; the IO arms (entropy, store, the
// exchange, the verification) are the same substrate folds the earlier frontiers witnessed
// piece by piece.

fn witness_auth_session() -> AuthenticatedSession {
  AuthenticatedSession {
    session_id: "session-1" as NonEmptyStr,
    principal: PrincipalRef {
      authority: "google-oidc" as NonEmptyStr,
      namespace: "accounts" as NonEmptyStr,
      subject: "sub-1" as NonEmptyStr,
    },
    authenticated_at: "2026-09-27T00:00:00Z",
    expires_at: "2026-09-27T12:00:00Z",
    auth_method: AuthMethodGoogleOidc,
    client: SessionClientTrackerWeb,
    csrf: CsrfToken { token: "csrf-1" as NonEmptyStr },
    profile: SessionProfile {
      picture: Present { value: Uri { scheme: Https, locator: "lh3.googleusercontent.com/a/avatar-sub-1" as NonEmptyStr } },
      name: Present { value: "Test Operator" },
      email: Present { value: "operator@gunb.ai" as Email },
    },
  }
}

// THE PICTURE-LESS SESSION, the never-blocks control: a login whose token carried no picture
// seats a session whose profile projects none, and the wire answers with NO picture member.
fn witness_auth_session_without_picture() -> AuthenticatedSession {
  AuthenticatedSession {
    session_id: "session-1" as NonEmptyStr,
    principal: PrincipalRef {
      authority: "google-oidc" as NonEmptyStr,
      namespace: "accounts" as NonEmptyStr,
      subject: "sub-1" as NonEmptyStr,
    },
    authenticated_at: "2026-09-27T00:00:00Z",
    expires_at: "2026-09-27T12:00:00Z",
    auth_method: AuthMethodGoogleOidc,
    client: SessionClientTrackerWeb,
    csrf: CsrfToken { token: "csrf-1" as NonEmptyStr },
    profile: SessionProfile { picture: none, name: none, email: none },
  }
}

// THE SESSION AND LOGIN ROUTES ARE SERVED, EACH BY ITS OWN HANDLER: the OIDC login, callback and
// logout routes land with the seed's response-header transport (cli_run serve_write_response
// writes the handler's Location and Set-Cookie lines), so each path selects its handler rather
// than no route. RED if a login path stops selecting, or selects another handler.
test fn the_session_and_login_routes_select_their_handlers() -> Bool {
  match roadmap_serve_route_table_build() {
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => false
    ServedRouteTableBuilt { table: t } =>
      match serve_select_route(table: t, method: GET, path: "/auth/session") {
        SelectedDynamic { handler: AuthSessionHandler, params: _ } => true
        _ => false
      }
        && match serve_select_route(table: t, method: GET, path: "/auth/login") {
          SelectedDynamic { handler: AuthLoginHandler, params: _ } => true
          _ => false
        }
        && match serve_select_route(table: t, method: GET, path: "/auth/google/callback") {
          SelectedDynamic { handler: AuthGoogleCallbackHandler, params: _ } => true
          _ => false
        }
        && match serve_select_route(table: t, method: POST, path: "/auth/logout") {
          SelectedDynamic { handler: AuthLogoutHandler, params: _ } => true
          _ => false
        }
  }
}

// THE SESSION ROUTE RENDERS THE STANDING: anonymous for absence (the pre-login spelling), and
// the authenticated principal's label and expiry for a live session — a read renders, it
// never decides.
test fn the_session_route_renders_anonymous_and_authenticated_standings() -> Bool {
  string_contains(s: auth_session_body(evidence: AuthAbsent), pattern: "\"authenticated\": false")
    && !string_contains(s: auth_session_body(evidence: AuthAbsent), pattern: "principal:")
    && string_contains(s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session() }), pattern: "\"authenticated\": true")
    && string_contains(s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session() }), pattern: "principal:google-oidc/accounts/sub-1")
    && string_contains(s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session() }), pattern: "2026-09-27T12:00:00Z")
}

// THE SESSION WIRE CARRIES THE PROFILE PROJECTION, OPTIONALLY (the never-blocks law on the
// wire): a session whose login projected a picture answers with the picture member spelled as
// the Uri wire form, and a named login answers with the name member; a session without them —
// and every non-authenticated standing — answers with NO such member at all: absence is the
// member's ABSENCE, never an empty string standing in for none, and the client renders
// initials on absence, never an identity claim from a hole in the wire.
test fn the_session_wire_carries_the_picture_only_when_the_profile_projects_one() -> Bool {
  string_contains(
    s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session() }),
    pattern: "\"picture\": \"https://lh3.googleusercontent.com/a/avatar-sub-1\"",
  )
    && string_contains(
      s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session() }),
      pattern: "\"name\": \"Test Operator\"",
    )
    && !string_contains(s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session_without_picture() }), pattern: "\"picture\"")
    && !string_contains(s: auth_session_body(evidence: GoogleOidcSession { session: witness_auth_session_without_picture() }), pattern: "\"name\"")
    && !string_contains(s: auth_session_body(evidence: AuthAbsent), pattern: "\"picture\"")
    && !string_contains(s: auth_session_body(evidence: AuthAbsent), pattern: "\"name\"")
    && !string_contains(s: auth_session_body(evidence: SessionStandingInvalid { standing: SessionCookieAbsent }), pattern: "\"picture\"")
    && !string_contains(s: auth_session_body(evidence: SessionStandingInvalid { standing: SessionCookieAbsent }), pattern: "\"name\"")
}

// Anonymous context reads expose no token or history, and an authenticated request for
// an unknown issue refuses before touching the event store.
test fn witness_inline_assignment_context_refuses_without_session_or_issue() -> Bool {
  let anonymous = serve_issue_assignment_context_over(
    instance: srv2_preview_dashboard_instance(), plan: caller_supplied_plan_fixture(), params: [],
    request: ServeHttpRequest { method: GET, path: "/issue/missing/assignment", body: "",
      security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: AuthAbsent } })
  let unknown = serve_issue_assignment_context_over(
    instance: srv2_preview_dashboard_instance(), plan: caller_supplied_plan_fixture(), params: [],
    request: ServeHttpRequest { method: GET, path: "/issue/missing/assignment", body: "",
      security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: GoogleOidcSession { session: witness_auth_session() } } })
  anonymous.status == 401
    && string_contains(s: anonymous.body, pattern: "Sign in")
    && !string_contains(s: anonymous.body, pattern: "csrf")
    && unknown.status == 404
    && !string_contains(s: unknown.body, pattern: "csrf-1")
}

// ── THE APPROVAL ROUTES, MID-CUTOVER ────────────────────────────────────────────────────────
// The four approval routes are being moved to gunbc.auth.approval_broker_serve under its own unit
// and slice, for an availability reason rather than a tidiness one: boot 15 refused on an approval
// status poll because THIS process's heap was swapped and OOM-killed (side-chat ruling
// 2026-09-19). The staged transaction deploys the broker dark and measures it BEFORE anything is
// repointed, so during the window this table still mounts them -- and what these two claims
// establish is that mounting them costs no second authority.
//
// WHAT IS ASSERTED: every approval row this table carries is a PROJECTION of the broker's own spec
// -- same method, same path literal, same handler value -- so there is one place an approval route
// is defined and one place it is implemented, while there are temporarily two tables serving it.
// The RED is a hand-authored approval row appearing in roadmap_serve_own_route_specs: the counts
// stop agreeing and the projection stops accounting for every approval path this table answers.
//
// THE WALL THIS BECOMES. At stage 6 of gunbc.auth.approval_broker_cutover the arm and the
// projection are deleted, and these two claims are replaced by the standing regression control that
// this table answers NOTHING for the four approval (method, path) pairs.

test fn roadmap_approval_rows_are_projected_from_the_broker() -> Bool {
  let projected = roadmap_serve_approval_cutover_route_specs()
  count(projected) == count(approval_broker_route_specs())
    && count(roadmap_serve_route_specs())
       == count(roadmap_serve_own_route_specs()) + count(projected)
}

// NO APPROVAL PATH IS ANSWERED BY A ROW THIS MODULE AUTHORED. The projection above could hold while
// a hand-written row ALSO matched an approval request -- two owners with agreeing counts. This asks
// selection instead: every approval request this table answers must land on the broker arm.
fn roadmap_approval_request_lands_on_the_broker_arm(method: HttpMethod, path: String) -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => match h {
      ApprovalBrokerCutoverHandler { route: _ } => true
      _ => false
    }
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn roadmap_approval_paths_are_owned_only_by_the_broker_arm() -> Bool {
  roadmap_approval_request_lands_on_the_broker_arm(method: GET, path: "/approve/esc-1.approve.0badc0de")
    && roadmap_approval_request_lands_on_the_broker_arm(method: POST, path: "/approve/esc-1.approve.0badc0de")
    && roadmap_approval_request_lands_on_the_broker_arm(method: POST, path: "/approvals")
    && roadmap_approval_request_lands_on_the_broker_arm(method: GET, path: "/approvals/esc-1")
}

// PLANTED REQUEST HEADERS AT THE READING: a field is selected by its name and nothing else, and
// the three answers stay apart -- absent, one value, repeated with its count. A field whose name
// merely contains the one asked for is not it.
test fn a_planted_header_list_reads_as_absent_single_or_repeated() -> Bool {
  let headers = [
    ServeRequestHeader { name: "accept", value: "text/html" },
    ServeRequestHeader { name: "x-cookie", value: "gunbc_session=planted" },
    ServeRequestHeader { name: "cookie", value: "theme=dark" },
  ]
  serve_request_header_reading(headers: headers, name: "cookie") == ServeRequestHeaderSingle { value: "theme=dark" }
    && serve_request_header_reading(headers: headers, name: "authorization") == ServeRequestHeaderAbsent
    && serve_request_header_reading(headers: [], name: "cookie") == ServeRequestHeaderAbsent
    && serve_request_header_reading(
      headers: concat(headers, [ServeRequestHeader { name: "cookie", value: "theme=light" }]),
      name: "cookie",
    ) == ServeRequestHeaderRepeated { occurrences: 2 }
}

fn witness_assignment_context_over_headers(headers: List<ServeRequestHeader>) -> ServeWireResponse {
  roadmap_serve_handle_over(
    instance: srv2_preview_dashboard_instance(),
    plan: fn() { caller_supplied_plan_fixture() },
    daily_body: DailyBodyRenderedUnderThisPlan,
    method: "GET",
    path: "/issue/demo-node/assignment",
    body: "",
    tailscale_identity: "",
    ingress: IngressUnattested,
    request_headers: headers,
    release_revision: deploy_witness_release_revision,
  )
}

// THE SERVED ENTRY, declared request headers to wire record, on the real assignment-context
// route. That route answers from the authentication evidence alone when no human session is
// present, so the claim performs no host read: no Cookie field and a Cookie field carrying no
// session both answer the signed-out 401; a malformed session cookie answers the invalid-session
// 401, so the field's VALUE reached the cookie decode; two Cookie fields answer 400 before any
// route runs. Deleting the header reading from the entry, or handing it a field other than
// Cookie, makes this fail.
test fn the_served_entry_reads_the_cookie_field_from_its_declared_request_headers() -> Bool {
  let absent = witness_assignment_context_over_headers(headers: [ServeRequestHeader { name: "accept", value: "application/json" }])
  let other = witness_assignment_context_over_headers(headers: [ServeRequestHeader { name: "cookie", value: "theme=dark" }])
  let malformed = witness_assignment_context_over_headers(headers: [ServeRequestHeader { name: "cookie", value: "gunbc_session=a; gunbc_session=b" }])
  let repeated = witness_assignment_context_over_headers(headers: [
    ServeRequestHeader { name: "cookie", value: "gunbc_session=a" },
    ServeRequestHeader { name: "cookie", value: "gunbc_session=b" },
  ])
  absent.status == 401
    && absent.body == "Sign in to assign this issue."
    && other.status == 401
    && other.body == absent.body
    && malformed.status == 401
    && malformed.body == "Your session has expired or is unavailable. Sign in again."
    && repeated.status == 400
    && repeated.body == "bad request: duplicate cookie header\n"
}


test fn preference_routes_are_account_scoped_and_require_csrf_before_store_access() -> Bool {
  let anonymous = ServeHttpRequest { method: GET, path: "/preferences/issues", body: "", security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: AuthAbsent } }
  let no_csrf = ServeHttpRequest { method: POST, path: "/preferences/issues", body: "preferences=invalid", security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: GoogleOidcSession { session: witness_auth_session() } } }
  selects(method: GET, path: "/preferences/issues", want: IssueViewPreferencesReadHandler)
    && selects(method: POST, path: "/preferences/issues", want: IssueViewPreferencesSaveHandler)
    && serve_issue_view_preferences_over(instance: srv2_preview_dashboard_instance(), request: anonymous, saving: false).status == 401
    && serve_issue_view_preferences_over(instance: srv2_preview_dashboard_instance(), request: anonymous, saving: true).status == 401
    && match human_write_admission(route_path: "/preferences/issues", action: ServeActionSaveOwnView, security: no_csrf.security, authorization_policy: tracker_write_authorization_policy, deployment_policy: roadmap_deployment_access_policy, csrf_presented: "", observed_at: "2026-09-27T01:00:00Z") {
      Deny { refusal: _ } => true
      Permit => false
    }
}

test fn issue_query_selects_read_only_route_and_refuses_invalid_views() -> Bool {
  let request = ServeHttpRequest { method: POST, path: "/issues/query", body: "preferences=invalid&offset=0", security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: AuthAbsent } }
  selects(method: POST, path: "/issues/query", want: IssueQueryHandler)
    && serve_issue_query(instance: srv2_preview_dashboard_instance(), request: request).status == 400
}

test fn a_refused_follow_up_enqueue_is_a_502_and_a_held_one_keeps_the_write() -> Bool {
  let ok = serve_text_response(status: 200, content_type: text_plain_utf8, body: "assigned\n")
  let recorded = serve_attaching_follow_ups(response: ok, enqueues: [
    BeltObligationStarted { unit: "gunbc-obligation-srv1-live-observe.service" as NonEmptyStr },
    BeltObligationHeld { unit: "gunbc-obligation-srv1-live-launch.service" as NonEmptyStr },
  ])
  let refused = serve_attaching_follow_ups(response: ok, enqueues: [
    BeltObligationEnqueueRefused { unit: "gunbc-obligation-srv1-live-observe.service" as NonEmptyStr, reason: "user manager unread" },
  ])
  recorded.status == 200 && recorded.body == "assigned\n"
    && refused.status == 502
    && string_contains(s: refused.body, pattern: "assigned")
    && string_contains(s: refused.body, pattern: "follow-up enqueue refused")
    && string_contains(s: refused.body, pattern: "user manager unread")
    && string_contains(s: refused.body, pattern: "the write stands")
}
