// Test-local extraction: a Refused build yields the EMPTY table, so every selection witness below
// goes RED (nothing selects) — the discriminating direction; the production path never does this
// (roadmap_serve_respond answers 500 on Refused).

fn live_table_or_empty() -> ServedRouteTable<RoadmapServeHandler> {
  match roadmap_serve_route_table_build() {
    RoadmapServeTable { table: t } => t
    RoadmapServeTableRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

fn selects(method: HttpMethod, path: String, want: RoadmapServeHandler) -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => h == want
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn witness_serve_table_selection() -> Bool {
  selects(method: GET, path: "/", want: RoadmapDailyPageHandler)
    && selects(method: GET, path: "/roadmap", want: RoadmapFullPageHandler)
    && selects(method: GET, path: "/ROADMAP.md", want: RoadmapMdHandler)
    && selects(method: GET, path: "/target/roadmap-dispatch.json", want: DispatchJsonHandler)
    && selects(method: GET, path: "/healthz", want: HealthzHandler)
    && selects(method: GET, path: "/instance.json", want: DashboardInstanceHandler)
    && selects(method: GET, path: "/sessions.json", want: SessionsJsonHandler)
    && selects(method: GET, path: "/attempts.json", want: AttemptsJsonHandler)
    && selects(method: GET, path: "/workflow.json", want: WorkflowJsonHandler)
    && selects(method: GET, path: roadmap_dispatch_asset_path, want: DispatchAssetHandler)
    && selects(method: GET, path: "/sandbox", want: SandboxPageHandler)
    && selects(method: GET, path: "/sandbox/instrument", want: InstrumentSandboxPageHandler)
    && selects(method: GET, path: "/sandbox/instrument/tuner", want: InstrumentTunerPageHandler)
    && selects(method: GET, path: instrument_tuner_asset_path, want: InstrumentTunerAssetHandler)
    && selects(method: GET, path: instrument_motion_page_path, want: InstrumentMotionPageHandler)
    && selects(method: GET, path: instrument_motion_asset_path, want: InstrumentMotionAssetHandler)
    && selects(method: GET, path: sandbox_asset_path, want: SandboxAssetHandler)
    && selects(method: POST, path: "/sandbox/echo", want: SandboxEchoHandler)
    && selects(method: POST, path: "/dispatch/some-node", want: BeltDispatchHandler)
    && selects(method: POST, path: "/cleanup/some-node", want: BeltStopHandler)
    && selects(method: POST, path: "/stop/some-node", want: BeltStopHandler)
    && selects(method: POST, path: "/publish/some-node", want: BeltPublishHandler)
}

test fn witness_asset_route_serves_modeled_js() -> Bool {
  let r = roadmap_serve_invoke(
    handler: DispatchAssetHandler,
    params: [],
    request: fixture_request(method: GET, path: roadmap_dispatch_asset_path),
    release_revision: deploy_witness_release_revision,
  )
  r.status == 200
    && media_type_wire_label(m: r.content_type) == "text/javascript; charset=utf-8"
    && r.body == dispatch_client_js_source()
    && string_contains(s: r.body, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: r.body, pattern: "fetch('/instance.json')")
    && string_contains(s: r.body, pattern: "fetch('/workflow.json')")
    && string_contains(s: r.body, pattern: "'dispatch · disabled'")
    && string_contains(s: r.body, pattern: "posture === 'observe-only'")
    && string_contains(s: r.body, pattern: "fetch('/cleanup/' + sess.node_id")
}

// The shared header renders its links from instrument_lab_links, and the route table builds its
// specs from the same declarations. This claim is what makes that ONE authority rather than two
// that happen to agree: every rendered link is required to select a route, so a roster row without
// a route reds here rather than shipping a header link to a 404. The RED direction is a row added
// to the roster with no matching route spec.

fn lab_link_selects_something(path: String) -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: GET, path: path) {
    SelectedDynamic { handler: _, params: _ } => true
    SelectedStatic { route: _ } => true
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn witness_every_lab_nav_link_resolves() -> Bool {
  count(instrument_lab_links) == 4
    && all(instrument_lab_links, l => lab_link_selects_something(path: l.path))
}

test fn witness_dispatch_param_bound() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: POST, path: "/dispatch/2-cd-transport") {
    SelectedDynamic { handler: _, params: ps } =>
      path_param_value(params: ps, name: "node_id") == "2-cd-transport"
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn witness_dispatch_get_folds_405() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: GET, path: "/dispatch/x") {
    MethodNotAllowed { allowed: ms } => count(ms) == 1 && any(ms, m => m == POST)
    SelectedStatic { route: _ } => false
    SelectedDynamic { handler: _, params: _ } => false
    NoRouteMatched => false
  }
}

fn fixture_request(method: HttpMethod, path: String) -> ServeHttpRequest {
  ServeHttpRequest { method: method, path: path, body: "", identity: TailnetIdentityAbsent }
}

test fn witness_unknown_path_folds_404_response() -> Bool {
  let r = roadmap_serve_selection_response(sel: NoRouteMatched, request: fixture_request(method: GET, path: "/nope"), release_revision: deploy_witness_release_revision)
  r.status == 404
}

test fn witness_405_response_carries_allowed() -> Bool {
  let r = roadmap_serve_selection_response(sel: MethodNotAllowed { allowed: [POST] }, request: fixture_request(method: GET, path: "/dispatch/x"), release_revision: deploy_witness_release_revision)
  r.status == 405 && string_contains(s: r.body, pattern: "POST")
}

// The 404/409/503/502 rows are the REDs a lazy 200-or-500 collapse would fail (parent review
// 2026-07-20): each refusal variant must map to ITS status, so a collapse of any arm reds exactly
// one witness row below.
//
// THIS PIN WENT STALE WHILE THE PROTECTION IT DESCRIBES READ AS INTACT (review artifact 51368).
// Five arms were added with explicit status mappings — stale session, revision drift, multiplicity
// conflict, liveness unobserved, revision unobserved — while this witness still pinned the original
// eight, so a regression mapping any new arm to 200 stayed green. The note claimed a protection the
// assertion no longer provided, worse than an absent pin.
//
// The label, band, exemplar and button rosters were all swept when those arms landed; this one was
// missed because it lives in a different witness module and is keyed by CONSTRUCTED variants rather
// than a roster the compiler counts — nothing here goes non-exhaustive when an arm appears. That
// asymmetry is the actual defect; until belt_dispatch_status_total is derived from the exemplar
// roster the way the label set is, this assertion must be swept by hand alongside it.

fn na(r: LaunchRefusal) -> BeltSpawnOutcome { SpawnNotAdmitted { node_id: "n", refusal: r } }

fn status_is_typed(s: Int) -> Bool {
  s == 200 || s == 403 || s == 404 || s == 409 || s == 502 || s == 503
}

test fn witness_dispatch_status_total() -> Bool {
  belt_dispatch_status(r: Spawned { node_id: "n", session_name: "s", provider: "codex", launch: launch_identity_exemplar() }) == 200
    && belt_dispatch_status(r: na(r: LaunchAlreadyLive { session_name: "s" })) == 200
    && belt_dispatch_status(r: na(r: LaunchInstanceActuationRefused { instance_id: "i", reason: "r" })) == 403
    && belt_dispatch_status(r: na(r: LaunchNodeUnknown)) == 404
    && belt_dispatch_status(r: na(r: LaunchAlreadyAccepted)) == 409
    && belt_dispatch_status(r: na(r: LaunchSessionsUnobservable { reason: "r" })) == 503
    && belt_dispatch_status(r: na(r: LaunchAuthorityUnobserved { detail: "d" })) == 503
    && belt_dispatch_status(r: SpawnFailed { node_id: "n", step: "git", detail: "d", provider: "codex", launch: launch_identity_exemplar() }) == 502
    && belt_dispatch_status(r: na(r: LaunchStaleSession { session_name: "s", detail: "d" })) == 409
    && belt_dispatch_status(r: na(r: LaunchSessionMultiplicityConflict { session_names: ["s1", "s2"], session_count: 2 })) == 409
    && belt_dispatch_status(r: na(r: LaunchLivenessUnobserved { session_name: "s", reason: "r" })) == 503
    && belt_dispatch_status(r: na(r: LaunchRevisionUnobserved { cause: "c" })) == 503
    && belt_dispatch_status(r: na(r: LaunchDependenciesBlocked { blockers: ["p"] })) == 409
    && belt_dispatch_status(r: na(r: LaunchExecutionContractMissing { reason: "r" })) == 409
    && all(belt_dispatch_result_exemplars(), r => status_is_typed(s: belt_dispatch_status(r: r)))
}

test fn witness_preview_dispatch_refuses_before_effects() -> Bool {
  let r = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "POST",
    path: "/dispatch/ts-dispatch-provider-events",
    body: "",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 403
    && string_contains(s: r.body, pattern: "\"status\": \"disabled\"")
    && string_contains(s: r.body, pattern: "srv2-preview-codex-feedback-v0")
    && string_contains(s: r.body, pattern: "before observation, provider preflight, or worktree creation")
}

test fn witness_instance_route_names_posture_and_paths() -> Bool {
  let r = roadmap_serve_respond_for_instance(
    instance: srv2_preview_dashboard_instance(),
    method_label: "GET",
    path: "/instance.json",
    body: "",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "\"instance_id\": \"srv2-preview-codex-feedback-v0\"")
    && string_contains(s: r.body, pattern: "\"actuation\": \"observe-only\"")
    && string_contains(s: r.body, pattern: "\"provision_transport\": \"local\"")
    && string_contains(s: r.body, pattern: "\"dispatch_base_ref\": \"origin/main\"")
    && string_contains(s: r.body, pattern: "\"desired_provision_plan\": [")
    && string_contains(s: r.body, pattern: "\"kind\": \"hydrate-controller-history\"")
    && string_contains(s: r.body, pattern: "\"kind\": \"prepare-git-bundle\"")
    && string_contains(s: r.body, pattern: "\"kind\": \"stage-git-bundle\"")
    && string_contains(s: r.body, pattern: "\"dispatch_worktree_root\": \"/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-preview-v0/attempts\"")
    && string_contains(s: r.body, pattern: "\"dispatch_attempt_state_root\": \"/home/briansrls/.local/share/gunbc-dashboard-instances/codex-provider-feedback-preview-v0/attempt-state\"")
}

// THE ROUTE COUNT STOPPED BEING A LITERAL, replaced by the claim the literal stood in for. Sixteen
// was read off the live route roster, so adding /provider.json — a correct route this PR needed —
// reds a witness with nothing to say about which routes exist: the live-state count-transcription
// class ruled against on 2026-07-29 and swept in #7464, a third instance (review, 2026-07-30, found
// by the full floor rather than any targeted run).\n\nThe replacement is strictly stronger. This
// witness is for the live table BUILDING — the refusing arm below is the other half — and the
// interesting failure is a build that silently drops a route rather than refusing.
// serve_page_response_note in this module names that hazard: the EmitRejected => [] route-drop in
// node_http_server_emit is a silent widen this path deliberately does not copy. A literal count
// cannot tell a dropped route from a roster that legitimately grew; comparing against the roster
// can, and never needs editing again.\n\nThe non-emptiness conjunct stays because equality
// between two empty lists would hold vacuously.

test fn witness_live_table_builds_ready_routes() -> Bool {
  match roadmap_serve_route_table_build() {
    RoadmapServeTable { table: t } =>
      count(t.routes) > 0 && count(t.routes) == count(roadmap_serve_route_specs())
    RoadmapServeTableRefused { raw: _, segment: _, reason: _ } => false
  }
}

// The RED control for review 40286's section-5 catch: a malformed route literal through the SAME
// build fold must REFUSE the whole table (typed, carrying the broken raw), never fabricate an empty
// template that would silently match '/'.

test fn witness_malformed_route_literal_refuses_table() -> Bool {
  let specs = [
    RoadmapServeRouteSpec { method: GET, raw: "/ok", handler: HealthzHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/dispatch/\{node_id", handler: BeltDispatchHandler },
  ]
  match roadmap_serve_build_from_specs(specs: specs) {
    RoadmapServeTableRefused { raw: r, segment: _, reason: _ } => r == "/dispatch/\{node_id"
    RoadmapServeTable { table: _ } => false
  }
}

test fn witness_unknown_method_refuses() -> Bool {
  match parse_http_method_label(label: "BREW") {
    UnknownMethod { label: l } => l == "BREW"
    KnownMethod { method: _ } => false
  }
}

// review 40359: an unrecognized method label is 501 Not Implemented (RFC 9110 section 15.6.2 — the
// server does not implement the method at all), NEVER 405 (405 means the ROUTE exists but this
// method is not in its allowed set, and carries the allowed set — the MethodNotAllowed arm). The
// two arms must stay distinct statuses; collapsing them reds this row.

test fn witness_unknown_method_folds_501_response() -> Bool {
  let r = roadmap_serve_respond(method_label: "BREW", path: "/", body: "", tailscale_identity: "", release_revision: deploy_witness_release_revision)
  r.status == 501 && string_contains(s: r.body, pattern: "BREW")
}

test fn witness_known_methods_parse() -> Bool {
  match parse_http_method_label(label: "GET") {
    KnownMethod { method: m } => m == GET
    UnknownMethod { label: _ } => false
  }
  && match parse_http_method_label(label: "POST") {
    KnownMethod { method: m } => m == POST
    UnknownMethod { label: _ } => false
  }
}

test fn roadmap_serve_instance_keystone_holds() -> Bool {
  witness_serve_table_selection()
    && witness_asset_route_serves_modeled_js()
    && witness_dispatch_status_total()
    && witness_preview_dispatch_refuses_before_effects()
    && witness_instance_route_names_posture_and_paths()
    && witness_live_table_builds_ready_routes()
    && witness_malformed_route_literal_refuses_table()
    && witness_unknown_method_folds_501_response()
}

// ── The approval routes: opening the link is not deciding ────────────────────────────────────
// THE PAIR EXISTS SO THESE TWO ARE DISTINGUISHABLE. A GET at the approval URL must render and
// stop; everything that fetches a URL without a person behind it -- link previews, mail scanners,
// chat unfurlers, browser prefetch -- issues exactly that request, and if it decided, an approval
// would be spent with an audit row naming the operator.

test fn a_get_at_the_approval_url_renders_and_does_not_decide() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "GET",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 200
    && string_contains(s: r.body, pattern: "does not decide anything")
    && string_contains(s: r.body, pattern: "abc123")
}

// THE POST IS A DIFFERENT ROUTE, and it must not answer 200 while the broker is undeployed: a
// route that reported success here would tell the operator they had approved something no store
// recorded. It refuses with 501 until the keyring, decision store and publisher exist.
test fn a_post_at_the_approval_url_refuses_rather_than_reporting_a_decision() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  r.status == 501
    && !string_contains(s: r.body, pattern: "does not decide anything")
}

// THE IDENTITY REACHES THE HANDLER. This is the end-to-end assertion for the whole identity
// change: a login supplied at the serve entry arrives at the route that will consume it. Without
// this the plumbing could be silently dropping it and every unit-level identity witness would
// still pass.
test fn the_authenticated_identity_reaches_the_approval_handler() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "briansrls@github",
    release_revision: deploy_witness_release_revision,
  )
  string_contains(s: r.body, pattern: "identity: briansrls@github")
}

// AND ITS ABSENCE REACHES IT TOO, rather than becoming a default. A request that did not arrive
// through the authenticating proxy carries no identity, and the handler must see exactly that.
test fn an_absent_identity_arrives_at_the_handler_as_absent() -> Bool {
  let r = roadmap_serve_respond(
    method_label: "POST",
    path: "/approve/abc123",
    body: "",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
  string_contains(s: r.body, pattern: "identity: \n")
    && !string_contains(s: r.body, pattern: "briansrls")
}

// ── The plan authority is a parameter ───────────────────────────────────────────────────────────
//
// THE DISCRIMINATING DIRECTION IS THE NEGATIVE. Asserting that a caller-supplied plan appears in
// the response would stay green if a surface under the route ALSO read the public carrier and
// concatenated both; asserting that the public roadmap's own section title is ABSENT is what goes
// red the moment any consumer below the parameterized fold reaches past its parameter to
// roadmap_authority_projection(). That is the whole claim of the seam: one response, one plan.
//
// THE PATHS ARE CITED, NEVER SPELLED. The first cut of these witnesses typed "/roadmap.md" and
// "/dispatch.json"; neither is a route, so all three asked an unrouted path and asserted nothing
// (review 63317; the operator confirmed the 404s against a running instance). A witness that
// spells its own copy of a route is a second authority for it, and it rots exactly that way. These
// read the same declarations gunbc.roadmap_serve now builds its route table from, so a renamed
// route moves the table and the witness together.

fn caller_supplied_plan_section_title() -> String { "A plan supplied by the caller" }

// The public roadmap's own section title, from gunbc.roadmap_authority active_section_for_acceptance.
// Its presence in a response rendered over a caller-supplied plan IS the leak.
fn public_plan_section_title() -> String { "Active deliverables" }

fn caller_supplied_plan_fixture() -> RoadmapAuthorityProjection {
  RoadmapAuthorityProjected {
    doc: RoadmapDocument {
      preamble: [],
      lead_lanes: [],
      sections: [
        RoadmapSection { title: caller_supplied_plan_section_title(), elements: [] },
      ],
    },
    accepted: [],
  }
}

fn serve_over_plan(plan: RoadmapAuthorityProjection, path: String) -> ServeHttpResponse {
  serve_over_plan_declaring(plan: plan, daily_body: DailyBodyRenderedUnderThisPlan, path: path)
}

fn serve_over_plan_declaring(
  plan: RoadmapAuthorityProjection,
  daily_body: ServedDailyBodyAuthority,
  path: String,
) -> ServeHttpResponse {
  roadmap_serve_respond_over(
    instance: srv2_preview_dashboard_instance(),
    plan: plan,
    daily_body: daily_body,
    method_label: "GET",
    path: path,
    body: "",
    tailscale_identity: "",
    release_revision: deploy_witness_release_revision,
  )
}

test fn witness_roadmap_md_answers_from_the_supplied_plan() -> Bool {
  let r = serve_over_plan(
    plan: caller_supplied_plan_fixture(),
    path: roadmap_site_roadmap_url_path as String,
  )
  r.status == 200
    && string_contains(s: r.body, pattern: caller_supplied_plan_section_title())
    && !string_contains(s: r.body, pattern: public_plan_section_title())
}

test fn witness_dispatch_json_answers_from_the_supplied_plan() -> Bool {
  let r = serve_over_plan(
    plan: caller_supplied_plan_fixture(),
    path: roadmap_site_dispatch_url_path as String,
  )
  r.status == 200
    && !string_contains(s: r.body, pattern: public_plan_section_title())
}

// A plan that failed to project refuses in ITS OWN vocabulary rather than serving an empty
// roadmap: the detail the caller handed over is what the reader sees.
test fn witness_supplied_plan_refusal_travels_to_the_wire() -> Bool {
  let detail = "the caller's plan carrier could not be read"
  let md = serve_over_plan(
    plan: RoadmapAuthorityProjectionRefused { detail: detail },
    path: roadmap_site_roadmap_url_path as String,
  )
  let dispatch = serve_over_plan(
    plan: RoadmapAuthorityProjectionRefused { detail: detail },
    path: roadmap_site_dispatch_url_path as String,
  )
  string_contains(s: md.body, pattern: "# roadmap unavailable")
    && string_contains(s: md.body, pattern: detail)
    && !string_contains(s: md.body, pattern: public_plan_section_title())
    && string_contains(s: dispatch.body, pattern: "\"refused\": true")
    && string_contains(s: dispatch.body, pattern: detail)
}

// A CONTROL FOR THE CONTROL. The three witnesses above are claims about the PLAN, and a wrong path
// would make every one of them vacuous while looking identical to a pass on the negative
// assertions. This one asks an unrouted path and requires the 404, so "the responder answered from
// the supplied plan" stays distinguishable from "the responder never reached a handler".
test fn witness_an_unrouted_path_is_refused_not_answered() -> Bool {
  let r = serve_over_plan(plan: caller_supplied_plan_fixture(), path: "/roadmap.md")
  r.status == 404
}

// ── The DAILY surface, which is where the seam leaked ───────────────────────────────────────────
//
// WHAT THIS PROBE IS, AND WHAT IT IS NOT. It is a composition check over
// roadmap_daily_workspace_page_for_projection_observed on both arms. It is NOT the control for the
// leak that review 63317 found, and the first version of this block claimed it was.
//
// The claim was tested and it was false. With the leak deliberately restored in an isolated
// worktree -- the refused arm routed back through the fold that read
// accepted_roadmap_node_ids_projection() -- this witness still PASSED. The reason is structural,
// not a weak assertion: under the hermetic witness route the carrier read REFUSES, that fold takes
// its own refused arm, and it produces the same empty accepted set a clean render produces. No
// input reachable from here distinguishes the two, so the RED is not authorable and no stronger
// assertion could have made it so.
//
// DESIGN 4b: a check whose RED cannot be authored is not a weak wall, it is a decoration, and worse
// than absent because it gets cited as coverage. So the defect was closed by CONSTRUCTION instead
// (gunbc.roadmap_page: the ambient-reading fold is deleted, and every caller supplies its accepted
// set), and this block says plainly what it still earns: that both arms render, that a refused plan
// carries the CALLER's detail rather than an empty public roadmap, and that the v1-exit progress
// count is the one the supplied plan implies. The count is cited from v1_finish_lines_accepted_count
// and v1_exit_finish_lines rather than transcribed.
//
// The negative used on the route witnesses above would be decoration here for a second reason: the
// daily page renders work rows and bands, never the roadmap's section headings, so its absence is
// true of a clean render too.

fn v1_exit_progress_count_text(accepted_ids: List<RoadmapNodeId>) -> String {
  join([
    to_string(v1_finish_lines_accepted_count(accepted: accepted_ids)),
    " of ",
    to_string(count(v1_exit_finish_lines())),
    " finish lines complete",
  ], "")
}

fn daily_page_html_over_plan(plan: RoadmapAuthorityProjection) -> String {
  match try_serialize_html_source(node: roadmap_daily_workspace_page_for_projection_observed(
    proj: plan,
    attempts: [],
    attempts_refused: none,
    standings: StandingsUnobserved { reason: "witness render: the event carrier is not consulted" },
    launch: launch_host_unobserved_static_render(),
  )) {
    EmitOk { html } => html
    EmitRejected { reason } => reason
  }
}

test fn witness_daily_page_answers_from_the_supplied_plan() -> Bool {
  let projected = daily_page_html_over_plan(plan: caller_supplied_plan_fixture())
  let refused = daily_page_html_over_plan(
    plan: RoadmapAuthorityProjectionRefused { detail: "the caller's plan carrier could not be read" },
  )
  string_contains(s: projected, pattern: v1_exit_progress_count_text(accepted_ids: []))
    && string_contains(s: refused, pattern: "the caller's plan carrier could not be read")
    && string_contains(s: refused, pattern: v1_exit_progress_count_text(accepted_ids: []))
}

// ── The route the plan parameter CANNOT reach refuses instead of answering ───────────────────────
//
// DESIGN 4b puts silent wrongness outside the ladder and forbids it outright, so the plan parameter
// may not create a path where / answers 200 from a body rendered under an authority nobody can
// name. The agreement is a declared fact of the call, and a caller that cannot declare it is
// refused on that ONE route (review 63390). This is the executing evidence for that arm, and for
// its other half: refusing / must not cost the routes whose plan DOES reach them.

test fn witness_undeclared_daily_body_refuses_rather_than_answering() -> Bool {
  let r = serve_over_plan_declaring(
    plan: caller_supplied_plan_fixture(),
    daily_body: DailyBodyAuthorityUnknown,
    path: roadmap_site_daily_url_path as String,
  )
  r.status == 503
    && string_contains(s: r.body, pattern: "carries no identity of the authority it came from")
    && string_contains(s: r.body, pattern: "served_observation_observe_and_write_over")
    && string_contains(s: r.body, pattern: "a_prerendered_body_carries_no_identity_of_its_source")
}

// THE POSITIVE CONTROL, without which the refusal above is satisfiable by refusing everything: a
// caller that cannot vouch for the daily body still gets every other route answered from its own
// plan, and the refusal is located on / alone.
test fn witness_undeclared_daily_body_costs_no_other_route() -> Bool {
  let md = serve_over_plan_declaring(
    plan: caller_supplied_plan_fixture(),
    daily_body: DailyBodyAuthorityUnknown,
    path: roadmap_site_roadmap_url_path as String,
  )
  md.status == 200
    && string_contains(s: md.body, pattern: caller_supplied_plan_section_title())
    && !string_contains(s: md.body, pattern: public_plan_section_title())
}
