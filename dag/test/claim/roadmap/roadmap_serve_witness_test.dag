// Test-local extraction: a Refused build yields the EMPTY table, so every selection witness below
// goes RED (nothing selects) — the discriminating direction; the production path never does this
// (roadmap_serve_respond answers 500 on Refused).

fn live_table_or_empty() -> ServedRouteTable<RoadmapServeHandler> {
  match roadmap_serve_route_table_build() {
    ServedRouteTableBuilt { table: t } => t
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

fn selects(method: HttpMethod, path: String, want: RoadmapServeHandler) -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => h == want
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn witness_serve_table_selection() -> Bool {
  selects(method: GET, path: "/", want: RoadmapDailyPageHandler)
    && selects(method: GET, path: "/target/roadmap-dispatch.json", want: DispatchJsonHandler)
    && selects(method: GET, path: "/healthz", want: HealthzHandler)
    && selects(method: GET, path: "/instance.json", want: DashboardInstanceHandler)
    && selects(method: GET, path: "/sessions.json", want: SessionsJsonHandler)
    && selects(method: GET, path: "/attempts.json", want: AttemptsJsonHandler)
    && selects(method: GET, path: "/workflow.json", want: WorkflowJsonHandler)
    && selects(method: GET, path: roadmap_dispatch_asset_path, want: DispatchAssetHandler)
    && selects(method: POST, path: "/dispatch/some-node", want: BeltDispatchHandler)
    && selects(method: POST, path: "/cleanup/some-node", want: BeltStopHandler)
    && selects(method: POST, path: "/stop/some-node", want: BeltStopHandler)
    && selects(method: POST, path: "/publish/some-node", want: BeltPublishHandler)
}

test fn witness_asset_route_serves_modeled_js() -> Bool {
  let r = roadmap_serve_invoke(
    handler: DispatchAssetHandler,
    params: [],
    request: fixture_request(method: GET, path: roadmap_dispatch_asset_path),
    release_revision: deploy_witness_release_revision,
  )
  r.status == 200
    && media_type_wire_label(m: r.content_type) == "text/javascript; charset=utf-8"
    && r.body == dispatch_client_js_source()
    && string_contains(s: r.body, pattern: "s === 'spawned' ? 'ok'")
    && string_contains(s: r.body, pattern: "fetch('/instance.json')")
    && string_contains(s: r.body, pattern: "fetch('/workflow.json')")
    && string_contains(s: r.body, pattern: "'dispatch · disabled'")
    && string_contains(s: r.body, pattern: "posture === 'observe-only'")
    && string_contains(s: r.body, pattern: "fetch('/cleanup/' + sess.node_id")
}

test fn witness_dispatch_param_bound() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: POST, path: "/dispatch/2-cd-transport") {
    SelectedDynamic { handler: _, params: ps } =>
      path_param_value(params: ps, name: "node_id") == "2-cd-transport"
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

test fn witness_dispatch_get_folds_405() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: GET, path: "/dispatch/x") {
    MethodNotAllowed { allowed: ms } => count(ms) == 1 && any(ms, m => m == POST)
    SelectedStatic { route: _ } => false
    SelectedDynamic { handler: _, params: _ } => false
    NoRouteMatched => false
  }
}

fn fixture_request(method: HttpMethod, path: String) -> ServeHttpRequest<RequestAccessPath, RequestAuthenticationEvidence> {
  ServeHttpRequest {
    method: method,
    path: path,
    body: "",
    security: RequestSecurityContext { access_path: AccessPathLocalDev, authentication: AuthAbsent },
  }
}

test fn witness_unknown_path_folds_404_response() -> Bool {
  let r = roadmap_serve_selection_response(sel: NoRouteMatched, request: fixture_request(method: GET, path: "/nope"), release_revision: deploy_witness_release_revision)
  r.status == 404
}

test fn witness_405_response_carries_allowed() -> Bool {
  let r = roadmap_serve_selection_response(sel: MethodNotAllowed { allowed: [POST] }, request: fixture_request(method: GET, path: "/dispatch/x"), release_revision: deploy_witness_release_revision)
  r.status == 405 && string_contains(s: r.body, pattern: "POST")
}

// The 404/409/503/502 rows are the REDs a lazy 200-or-500 collapse would fail (parent review
// 2026-07-20): each refusal variant must map to ITS status, so a collapse of any arm reds exactly
// one witness row below.
//
// THIS PIN WENT STALE WHILE THE PROTECTION IT DESCRIBES READ AS INTACT (review artifact 51368).
// Five arms were added with explicit status mappings — stale session, revision drift, multiplicity
// conflict, liveness unobserved, revision unobserved — while this witness still pinned the original
// eight, so a regression mapping any new arm to 200 stayed green. The note claimed a protection the
// assertion no longer provided, worse than an absent pin.
//
// The label, band, exemplar and button rosters were all swept when those arms landed; this one was
// missed because it lives in a different witness module and is keyed by CONSTRUCTED variants rather
// than a roster the compiler counts — nothing here goes non-exhaustive when an arm appears. That
// asymmetry is the actual defect; until belt_dispatch_status_total is derived from the exemplar
// roster the way the label set is, this assertion must be swept by hand alongside it.

fn na(r: LaunchRefusal) -> BeltSpawnOutcome { SpawnNotAdmitted { node_id: "n", refusal: r } }

fn status_is_typed(s: Int) -> Bool {
  s == 200 || s == 403 || s == 404 || s == 409 || s == 502 || s == 503
}

test fn witness_dispatch_status_total() -> Bool {
  belt_dispatch_status(r: Spawned { node_id: "n", session_name: "s", provider: "codex", launch: launch_identity_exemplar() }) == 200
    && belt_dispatch_status(r: na(r: LaunchAlreadyLive { session_name: "s" })) == 200
    && belt_dispatch_status(r: na(r: LaunchInstanceActuationRefused { instance_id: "i", reason: "r" })) == 403
    && belt_dispatch_status(r: na(r: LaunchNodeUnknown)) == 404
    && belt_dispatch_status(r: na(r: LaunchNotReady { missing: [GapAccepted] })) == 409
    && belt_dispatch_status(r: na(r: LaunchSessionsUnobservable { reason: "r" })) == 503
    && belt_dispatch_status(r: na(r: LaunchAuthorityUnobserved { detail: "d" })) == 503
    && belt_dispatch_status(r: SpawnFailed { node_id: "n", step: "git", detail: "d", provider: "codex", launch: launch_identity_exemplar() }) == 502
    && belt_dispatch_status(r: na(r: LaunchStaleSession { session_name: "s", detail: "d" })) == 409
    && belt_dispatch_status(r: na(r: LaunchSessionMultiplicityConflict { session_names: ["s1", "s2"], session_count: 2 })) == 409
    && belt_dispatch_status(r: na(r: LaunchLivenessUnobserved { session_name: "s", reason: "r" })) == 503
    && belt_dispatch_status(r: na(r: LaunchRevisionUnobserved { cause: "c" })) == 503
    && belt_dispatch_status(r: na(r: LaunchNotReady { missing: [GapDependencies { blockers: ["p"] }] })) == 409
    && belt_dispatch_status(r: na(r: LaunchNotReady { missing: [GapContract { detail: "r" }] })) == 409
    && belt_dispatch_status(r: na(r: LaunchNotReady { missing: [GapNotAgentWork { mode: OperatorExclusiveMode }] })) == 409
    && all(belt_dispatch_result_exemplars(), r => status_is_typed(s: belt_dispatch_status(r: r)))
}

