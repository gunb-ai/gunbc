module test.claim.roadmap_fleet_components_witness

import std.types { Bool }
import gunbc.roadmap_fleet_components { fleet_component_hosts, fleet_components }
import extdeps.google.issue_tracker { browse_component_tree }

test fn w_fleet_component_tree_hosts_and_arms() -> Bool {
  count(fleet_components()) == 12
    && count(fleet_component_hosts) == 8
    && (match (filter(fleet_components(), c => c.path == ["srv11", "serving", "group-b"])).first() {
      Present { value: c } => c.id == 111
      Absent => false
    })
    && count(filter(fleet_components(), c => count(c.path) == 3)) == 4
    && count(filter(fleet_components(), c => c.path.first() == Present { value: "srv5" })) == 0
}

test fn w_browse_components_derives_the_tree() -> Bool {
  let tree = browse_component_tree(components: fleet_components())
  count(tree) == 12
    && (match tree.first() {
      Present { value: e } => e.component.path == ["srv1"] && e.depth == 1
      Absent => false
    })
    && (match tree.skip(n: 8).first() {
      Present { value: e } => e.component.path.skip(n: 1) == ["serving", "group-b"] && e.depth == 3
      Absent => false
    })
    && (match tree.skip(n: 11).first() {
      Present { value: e } => e.component.path == ["srv12", "serving", "group-b"]
      Absent => false
    })
}
