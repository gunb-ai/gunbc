module test.claim.roadmap.roadmap_worker_alive_witness

import std.types { Bool, NonEmptyStr }
import gunbc.worker_lifecycle {
  WorkerProcessRunning, WorkerProcessExited, WorkerProcessAbsent, WorkerProcessUnobserved,
  worker_process_observed_command,
}
import gunbc.roadmap.roadmap_presentation { worker_alive_from_process }

// THE ORACLE IS AUTHORED BEFORE THE WORKER IS DISPATCHED AND IS RED UNTIL THE WORKER LANDS THE
// FUNCTION IT NAMES. The validation oracle pin observes an oracle by declaration at dispatch and
// refuses one it cannot see, so the judge is written by the planner, never by the worker it judges.
test fn the_pulse_follows_the_worker_process() -> Bool {
  worker_alive_from_process(process: WorkerProcessRunning { command: "gunbc" as NonEmptyStr })
    && !worker_alive_from_process(process: WorkerProcessExited { exit_code: 0, last_command: "gunbc" })
    && !worker_alive_from_process(process: WorkerProcessAbsent)
}

// THE OBSERVED-COMMAND PARTITION, WITNESSED. The nfr_dissolve_provider_terminal_absorb rows are
// gone because live_session_row_with_process now folds over worker_process_observed_command; a
// fifth evidence kind must name its command inhabitance here or the fold loses a case.
test fn the_observed_command_partition_names_only_the_running_pane() -> Bool {
  match worker_process_observed_command(process: WorkerProcessRunning { command: "gunbc" as NonEmptyStr }) {
    Present { value: command } => command == "gunbc" as NonEmptyStr
    none => false
  }
    && match worker_process_observed_command(process: WorkerProcessExited { exit_code: 0, last_command: "gunbc" }) {
         Present { value: _ } => false
         none => true
       }
    && match worker_process_observed_command(process: WorkerProcessAbsent) {
         Present { value: _ } => false
         none => true
       }
    && match worker_process_observed_command(
           process: WorkerProcessUnobserved { reason: "no pane" as NonEmptyStr },
         ) {
         Present { value: _ } => false
         none => true
       }
}
