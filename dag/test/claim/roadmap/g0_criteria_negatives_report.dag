module test.claim.roadmap.g0_criteria_negatives_report

// PRINTS THE MODEL'S OWN VERDICT TEXT for the G0 two-sided isolation verdict, on CONSTRUCTED
// per-probe return-code tokens (review 98584 FINDING 3: the in-repo consumer consumes constructed
// tokens only; the real-observation pair is external lane evidence, PR #16989 evidence comment,
// probe sha256 d9702374...). This is a RUN ENTRY (run --entry ... --function report_named_negatives),
// not a claim witness: the boolean authority stays in
// dag/test/claim/roadmap/g0_criteria_witness.dag (run --claim-run); this module makes the two
// NAMED negatives visible -- each must be RED, and RED FOR THE RIGHT REASON, with the model's
// own reason string printed -- plus the good path, which must be ACCEPTED.

import std.types { String }
import std.algebra { string_contains }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import extdeps.gunbc
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap.g0_contained_dev_execution_proof { g0_two_sided_isolation_verdict }

// good run: own op permitted; mask applied; protected read refused (1), protected exec denied (127);
// sibling refused; unmasked positive controls reach (0); negative run: own permitted, sibling still
// masked, protected EXPLICITLY reachable (0,0).
fn g0_verdict_good() -> ProcessExit {
  g0_two_sided_isolation_verdict(
    own_rc: "0", masked_entries: "0", sibling_rc: "1", protected_read_rc: "1", protected_exec_rc: "127",
    enf_launch_rc: "0", posctl_sibling_rc: "0", posctl_exec_rc: "0", unm_launch_rc: "0",
    neg_own_rc: "0", neg_sibling_rc: "1", neg_protected_read_rc: "0", neg_protected_exec_rc: "0", neg_launch_rc: "0")
}

// NAMED negative [broken_mask]: identical to the good run EXCEPT the protected EXEC probe returns 0
// under the mask (the tmpfs masking silently failed while the protected READ stayed refused).
fn g0_verdict_broken_mask() -> ProcessExit {
  g0_two_sided_isolation_verdict(
    own_rc: "0", masked_entries: "0", sibling_rc: "1", protected_read_rc: "1", protected_exec_rc: "0",
    enf_launch_rc: "0", posctl_sibling_rc: "0", posctl_exec_rc: "0", unm_launch_rc: "0",
    neg_own_rc: "0", neg_sibling_rc: "1", neg_protected_read_rc: "0", neg_protected_exec_rc: "0", neg_launch_rc: "0")
}

// NAMED negative [missing_observation]: the sibling probe produced no line (the shell sent the
// sentinel "MISSING"). This must be a typed located failure, never a silent denial.
fn g0_verdict_missing_observation() -> ProcessExit {
  g0_two_sided_isolation_verdict(
    own_rc: "0", masked_entries: "0", sibling_rc: "MISSING", protected_read_rc: "1", protected_exec_rc: "127",
    enf_launch_rc: "0", posctl_sibling_rc: "0", posctl_exec_rc: "0", unm_launch_rc: "0",
    neg_own_rc: "0", neg_sibling_rc: "1", neg_protected_read_rc: "0", neg_protected_exec_rc: "0", neg_launch_rc: "0")
}

fn g0_exit_text(p: ProcessExit) -> String {
  match p {
    ExitSuccess => "VERDICT=ACCEPTED"
    ExitFailure { code: _, reason: r } => concat("VERDICT=REJECTED:", r)
  }
}

// red-for-the-right-reason classifier: NOT_RED_AT_ALL and RED_FOR_WRONG_REASON are distinct
// failures; only an ExitFailure whose reason carries the named clause counts.
fn g0_negative_class(p: ProcessExit, want: String) -> String {
  match p {
    ExitFailure { code: _, reason: r } =>
      if string_contains(s: r, pattern: want) { "RED_FOR_RIGHT_REASON" } else { "RED_FOR_WRONG_REASON" }
    _ => "NOT_RED_AT_ALL"
  }
}

fn g0_report_text() -> String {
  let good = g0_verdict_good()
  let broken = g0_verdict_broken_mask()
  let missing = g0_verdict_missing_observation()
  let broken_class = g0_negative_class(broken, "ISOLATION_BREACHED:protected_reachable_under_mask")
  let missing_class = g0_negative_class(missing, "MISSING_OR_UNPARSEABLE_OBSERVATION:sibling_rc")
  let summary = if g0_exit_text(good) == "VERDICT=ACCEPTED" && broken_class == "RED_FOR_RIGHT_REASON" && missing_class == "RED_FOR_RIGHT_REASON" {
    "ALL_NAMED_NEGATIVES_RED_FOR_RIGHT_REASON"
  } else {
    "NEGATIVE_REPORT_FAIL"
  }
  concat(
    "GOOD[", g0_exit_text(good), "] ",
    "NAMED_NEGATIVE[broken_mask][", g0_exit_text(broken), "][", broken_class, "] ",
    "NAMED_NEGATIVE[missing_observation][", g0_exit_text(missing), "][", missing_class, "] ",
    summary
  )
}

// RUN ENTRY: prints the model's own verdict text through the typed witness-bin echo and returns
// ProcessExit. The success token requires the printed line to carry the summary; a missing or
// mis-named verdict is a typed ExitFailure, never a silent pass.
fn report_named_negatives() -> ProcessExit {
  let text = g0_report_text()
  let echoed = gunbc.WitnessBin.Run(workdir: "/", bin_path: "/bin/echo", args: [text])
  let wrote = Filesystem.Write(path: "/home/briansrls/scratch/vivid-otter-312/g0_r7_named_negatives.txt", content: concat(text, "\n"))
  if echoed.success && wrote.success && string_contains(s: echoed.stdout, pattern: "ALL_NAMED_NEGATIVES_RED_FOR_RIGHT_REASON") {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: concat("NEGATIVE_REPORT_NOT_PRINTED_OR_RED: stdout=", echoed.stdout, " write_error=", wrote.error) }
  }
}
