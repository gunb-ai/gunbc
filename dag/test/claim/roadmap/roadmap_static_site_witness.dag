module test.claim.roadmap.roadmap_static_site_witness

import std.content_hash { content_hash_atom }
import std.types { NonEmptyStr }
import std.content_hash { Fnv1a64Structural }
import gunbc.roadmap.roadmap_site_surface_witness { roadmap_site_surface_readiness_group_holds }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }
import gunbc.roadmap.roadmap_static_site {
  roadmap_site_static_allocation,
  roadmap_site_text_artifacts,
  roadmap_site_healthz_body,
  roadmap_site_healthz_route,
  roadmap_site_text_static_routes,
  roadmap_site_static_route_authority_paths,
  served_static_route_literal_path,
  roadmap_site_dispatch_json_artifact,
  roadmap_site_dispatch_json_body,
  roadmap_site_dispatch_url_path,
  roadmap_site_health_path,
  RoadmapDispatchJson,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_site_artifact_digest(body: String) -> Fnv1a64Structural {
  content_hash_atom(value: body as NonEmptyStr)
}

test fn witness_site_artifact_model_populated() -> Bool {
  let alloc = roadmap_site_static_allocation()
  count(alloc.artifacts) == 1
    && alloc.service.stateless
    && alloc.service.health_path == roadmap_site_health_path
    && alloc.route.dns_manual
}

test fn witness_dispatch_artifact_matches_file_content() -> Bool {
  let a = roadmap_site_dispatch_json_artifact()
  match a.kind {
    RoadmapDispatchJson => a.body == roadmap_site_dispatch_json_body()
    _ => false
  }
}

test fn witness_artifact_digests_are_content_hashes() -> Bool {
  all(roadmap_site_text_artifacts(), a =>
    a.digest == fixture_site_artifact_digest(body: a.body)
  )
}

test fn witness_healthz_route_json_ok() -> Bool {
  roadmap_site_surface_readiness_group_holds(release_revision: deploy_witness_release_revision)
}

test fn witness_static_site_route_authority_paths_locked() -> Bool {
  let paths = roadmap_site_static_route_authority_paths()
  count(paths) == 2
    && paths == [
      roadmap_site_dispatch_url_path as String,
      roadmap_site_health_path as String,
    ]
}

test fn witness_text_routes_include_health_and_artifacts() -> Bool {
  count(roadmap_site_text_static_routes()) == 2
}

