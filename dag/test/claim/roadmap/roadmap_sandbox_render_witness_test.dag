module test.claim.roadmap.roadmap_sandbox_render_witness_test

import std.types { Bool, String }
import std.markup { Fragment }
import gunbc.roadmap_sandbox { sandbox_page }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }

// THE SANDBOX RENDER IS THE CLOSURE CHECK FOR DASHBOARD PRESENTATION WORK. A node whose oracle
// names only the function it adds can pass while the page that consumes it no longer resolves
// (attempt 5 of the pulse node, 2026-09-05: worker_alive_from_process green, sandbox_page unresolvable
// on one missing argument). This witness renders the whole sandbox page, which imports the page,
// presentation, style and component modules, so a change that breaks any of them is red here.
test fn the_sandbox_page_renders_with_its_strip_lab() -> Bool {
  match try_serialize_html_source(node: sandbox_page()) {
    EmitRejected { reason: _ } => false
    EmitOk { html } => string_contains(s: html, pattern: "strip-lab-row") && string_contains(s: html, pattern: "activity-round-strip")
  }
}

// DISCRIMINATING: an inline animation-duration on a segment outranks the pulse rule and ran the
// live pulse at the 120ms fill floor (2026-09-05). The schedule must reach segments only as the
// --fill-* custom properties, so this is red the moment a longhand is written inline again.
test fn segments_carry_the_fill_schedule_as_custom_properties_not_inline_longhands() -> Bool {
  match try_serialize_html_source(node: sandbox_page()) {
    EmitRejected { reason: _ } => false
    EmitOk { html } =>
      string_contains(s: html, pattern: "--fill-duration: ")
        && string_contains(s: html, pattern: "--fill-delay: ")
        && string_contains(s: html, pattern: "animation-duration: var(--fill-duration")
        && !string_contains(s: html, pattern: "ms; animation-duration: ")
  }
}

// DISCRIMINATING: the active specimen carries a live standing from the event log and its row renders
// the standing chip with the state as its class suffix; a specimen without one renders no chip.
test fn the_standing_chip_renders_the_event_log_standing() -> Bool {
  match try_serialize_html_source(node: sandbox_page()) {
    EmitRejected { reason: _ } => false
    EmitOk { html } => string_contains(s: html, pattern: "standing-in_progress") && string_contains(s: html, pattern: "wiring the fold")
  }
}
