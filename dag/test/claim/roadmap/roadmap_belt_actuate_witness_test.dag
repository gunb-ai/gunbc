data codex_preflight_ok_dissolution_note: String = "review 44110. The codex_preflight_ok helper was a Bool fold over the two-variant BeltCodexPreflight — a variant test, the is_hermetic shape the 2026-07-12 predicate dissolution removed, and every sibling witness here already matches the coproduct directly. Matching in place also recovers what the Bool discarded: the accepted arm CARRIES the auth_method it derived, and asserting that it survives unparsed is the actual claim this witness makes about wording-independence."

test fn witness_codex_preflight_accepts_cli_auth_verdict_without_parsing_wording() -> Bool {
  match belt_codex_preflight_decision_observed_for_home(
    codex_home: "/state/codex",
    codex_on_path: true,
    env_on_path: true,
    identity_command_success: true,
    identity_stdout: "codex-cli 0.146.0",
    identity_stderr: "non-fatal runtime warning",
    login_status_success: true,
    login_status_stdout: "future CLI auth method wording",
    login_status_stderr: "",
  ) {
    CodexPreflightOk { auth_method } =>
      string_contains(s: auth_method as String, pattern: "future CLI auth method wording")
    CodexPreflightRefused { step: _, detail: _ } => false
  }
}

// This witness exists because its subject SHIPPED BROKEN while a whole-tree compile reported 0
// blocking errors. belt_oracle_refs_for_contract called filter_map, a primitive std.primitives
// declares a contract for and the seed implements nothing for, so the call type-checked and died
// as `not yet implemented` the first time a real dispatch reached it — a 500, found on the lab.
// The lane's other witnesses covered the pure oracle carrier and never drove THIS function: a
// projection only the effectful path calls needs a witness even when pure, because purity makes it
// cheap to witness, not covered. The assertions RUN the fold and read its output rather than
// checking a type: a version calling any unregistered primitive fails here at execution, the only
// place that defect class is observable.

test fn oracle_refs_projection_runs_and_selects_pinnable_scopes() -> Bool {
  let claim_contract = gunbc_claim_execution_contract(
    entry: "dag/test/claim/probe_witness_test.dag" as FilePath,
    function: "probe_holds" as NonEmptyStr,
  )
  let claim_refs = belt_oracle_refs_for_contract(contract: claim_contract)
  let cargo_refs = belt_oracle_refs_for_contract(
    contract: cargo_test_execution_contract(filter: "roadmap_" as NonEmptyStr),
  )
  let unspecified_refs = belt_oracle_refs_for_contract(
    contract: ExecutionContractUnspecified,
  )
  count(claim_refs) == 1
    && count(cargo_refs) == 0
    && count(unspecified_refs) == 0
    && match claim_refs.first() {
      Absent => false
      Present { value: oracle } =>
        (oracle.entry as String) == "dag/test/claim/probe_witness_test.dag"
          && (oracle.function as String) == "probe_holds"
    }
}

// review 45271, updated for exact-head wiring. The belt now observes the worktree head before
// reading a receipt, so an instance with no attempt filesystem cannot reach the unreadable-receipt
// arm through a failed legacy read alone. This witness drives the real fn against srv2 preview,
// where neither node nor worktree exist, and asserts verification defers with an exact-head or
// missing-node reason rather than actuating against an unobserved subject.

data fixture_verification_head: CommitSha = "cafecafecafecafecafecafecafecafecafecafe" as CommitSha

fn fixture_verification_subject(node_id: String) -> VerificationSubject {
  VerificationSubject {
    node_identity: node_id as NonEmptyStr as RoadmapNodeIdentity,
    criteria_digest: content_hash_atom(value: "belt-actuate-fixture"),
    attempt_key: "feedfacefeedface",
    branch: join(["dispatch/", node_id, "-afeedfacefeedface"], "") as NonEmptyStr,
    head_sha: fixture_verification_head,
    change_window_identity: git_diff_window_absent_identity(),
  }
}

fn completed_attempt_progress(node_id: String) -> WorkflowAttemptProgress {
  workflow_attempt_progress(evidence: WorkflowAttemptEvidence {
    node_id: node_id,
    attempt_key: "feedfacefeedface",
    branch: join(["dispatch/", node_id, "-afeedfacefeedface"], ""),
    modeled_state_present: true,
    admission_receipt_readable: true,
    admission_receipt: "{\"schema\": \"roadmap-dispatch-environment/v1\", \"status\": \"admitted\"}",
    spawn_failure_present: false,
    spawn_failure: "",
    provider_events_readable: true,
    provider_events: "{\"type\":\"turn.completed\",\"usage\":\{\}\}\n",
    provider_events_error: "",
    process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    validation_summary: "gunbc run --claim-run",
    verification_subject: VerificationSubjectObserved {
      subject: fixture_verification_subject(node_id: node_id),
    },
    verification_selection: SelectionObserved {
      head: fixture_verification_head,
      window_identity: git_diff_window_absent_identity(),
    },
    verification_source: VerificationReceiptAbsent,
    publication_subject: PublicationSubjectObserved {
      subject: RoadmapPublicationSubject {
        node_id: "pub-fixture-node",
        attempt_key: "feedfacefeedface",
        repository: Repository {
          owner: "gunb-ai",
          name: "gunbc",
          full_name: "gunb-ai/gunbc",
          private: false,
          default_branch: "main",
        },
        branch: "dispatch/pub-fixture-node-afeedfacefeedface" as NonEmptyStr,
        expected_base: "main" as NonEmptyStr,
        expected_head: "cafecafecafecafecafecafecafecafecafecafe" as CommitSha,
      },
    },
    publication_source: ReceiptSourceAbsent,
    review: review_report_absent(reason: "fixture"),
    submission_capture: CaptureAbsent,
    integration: IntegrationReceiptAbsent,
    goal_audit: [],
  })
}

// The A2 single-projection-authority receipt at the wire: each attempt object on /workflow.json
// carries the DECIDED activity view beside the progress members, so the client paints without
// composing. The fixture is a completed agent turn with process exited and four pending obligations
// — the falsifier's own shape. The assertions pin the decided fields (arm, the consequence-first
// summary composed by gunbc.roadmap_presentation, the reconcile-derived remaining count, the
// evidence rows) landing as JSON, plus the progress members surviving beside them. The decided
// strings are the contract; a client rebuilding any of them from segments has nothing asserted
// here to rebuild FROM.

test fn attempt_wire_carries_decided_activity() -> Bool {
  let j = serialize_json(v: belt_workflow_attempt_presentation_json(
    progress: completed_attempt_progress(node_id: "belt-wire-activity-node")))
  string_contains(s: j, pattern: "\"activity\": {")
    && string_contains(s: j, pattern: "\"arm\": \"active\"")
    && string_contains(s: j, pattern: "Submission failed")
    && string_contains(s: j, pattern: "\"remaining_obligation_count\": 5")
    && string_contains(s: j, pattern: "\"attention\": \"anomalous\"")
    && string_contains(s: j, pattern: "\"label\": \"session container\"")
    && string_contains(s: j, pattern: "\"value\": \"present\"")
    && string_contains(s: j, pattern: "\"label\": \"worker process\"")
    && string_contains(s: j, pattern: "\"value\": \"process exited\"")
    && string_contains(s: j, pattern: "\"node_id\": \"belt-wire-activity-node\"")
    && string_contains(s: j, pattern: "\"segments\": [")
}

test fn verify_without_observable_subject_defers_instead_of_rerunning() -> Bool {
  match belt_verify_attempt_for_instance(
    instance: srv2_preview_dashboard_instance(),
    progress: completed_attempt_progress(node_id: "belt-verify-probe-node"),
  ) {
    VerifyDeferred { node_id, reason } =>
      node_id == "belt-verify-probe-node"
        && (string_contains(s: reason, pattern: "exact head")
            || string_contains(s: reason, pattern: "no node"))
    VerifyEvidenceUnreadable { node_id: _, detail: _ } => false
    VerifyRefused { node_id: _, cause: _ } => false
    VerifyRecorded { node_id: _, verdict_key: _, detail: _ } => false
    VerifyWriteFailed { node_id: _, detail: _ } => false
  }
}

