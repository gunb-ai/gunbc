test fn witness_no_result_maps_to_in_progress() -> Bool {
  all(belt_dispatch_label_band_rows(), row => row.band_key != "in-progress")
}

test fn witness_ok_labels_derive_from_band_fold() -> Bool {
  belt_dispatch_ok_status_labels() == ["spawned", "supervisor_convened", "already_live"]
}

test fn witness_label_band_cover_reds_on_missing_row() -> Bool {
  let rows = belt_dispatch_label_band_rows()
  let labels = belt_dispatch_all_status_labels()
  let truncated = filter(rows, row => row.wire_label != "spawned")
  label_band_rows_cover(rows: rows, labels: labels)
    && !label_band_rows_cover(rows: truncated, labels: labels)
}

// D4: belt_dispatch_result_exemplars is a HAND roster (one exemplar per BeltDispatchResult arm),
// enrolled DeclaredFrontier in gunbc.roster_registry. belt_dispatch_status_label's total match
// walls a new VARIANT at compile time, but nothing ties the exemplar LIST to the variant set: a
// missed exemplar silently narrows belt_dispatch_all_status_labels AND the component wire-total
// reading it, while the live server emits the unmodeled label. This reconciles the exemplar-derived
// label set against the independent wire-contract pin (the labels
// witness_dispatch_status_labels_pin_wire_contract pins); the RED control proves a missing-variant
// list reds. Dissolves when inhabitance enumeration or the serve-JSON total match replaces the
// hand list.

fn d4_wire_contract_labels() -> List<String> {
  [
    "spawned",
    "supervisor_convened",
    "spawn_failed",
    "no_instance",
    "disabled",
    "deployment_transition_inhibited",
    "deployed_revision_unobserved",
    "authority_refused",
    "node_not_found",
    "node_superseded",
    "already_done_signed_off",
    "review_required",
    "size_missing",
    "execution_contract_missing",
    "centering_absent",
    "operator_exclusive",
    "external_lead",
    "calendar_observation",
    "dependencies_blocked",
    "observe_refused",
    "already_live",
    "stale_session",
    "session_liveness_unobserved",
    "session_multiplicity_conflict",
    "no_capacity",
    "cause_not_permitted_by_mode",
    "gate_not_evaluated",
  ]
}

fn d4_exemplars_reconcile(exemplars: List<BeltSpawnOutcome>) -> Bool {
  map(exemplars, r => belt_dispatch_status_label(r: r)) == d4_wire_contract_labels()
}

test fn witness_exemplar_roster_reconciles_variant_set() -> Bool {
  d4_exemplars_reconcile(exemplars: belt_dispatch_result_exemplars())
    && belt_dispatch_all_status_labels() == d4_wire_contract_labels()
}

fn d4_exemplars_missing_one() -> List<BeltSpawnOutcome> {
  [
    Spawned { node_id: "a", session_name: "s", provider: "codex", launch: launch_identity_exemplar() },
    not_admitted(r: LaunchAlreadyLive { session_name: "s" }),
    not_admitted(r: LaunchInstanceActuationRefused { instance_id: "preview", reason: "observe-only" }),
    not_admitted(r: LaunchNodeUnknown),
    not_admitted(r: LaunchAlreadyAccepted),
    not_admitted(r: LaunchSessionsUnobservable { reason: "x" }),
  ]
}

test fn witness_exemplar_roster_missing_variant_reds() -> Bool {
  !d4_exemplars_reconcile(exemplars: d4_exemplars_missing_one())
}

fn preflight_refused_step(p: BeltClaudePreflight) -> String {
  match p {
    ClaudePreflightRefused { step: st, detail: _ } => st
    ClaudePreflightOk => ""
  }
}

fn preflight_ok(p: BeltClaudePreflight) -> Bool {
  match p {
    ClaudePreflightOk => true
    ClaudePreflightRefused { step: _, detail: _ } => false
  }
}

fn seeded_trust_config() -> String {
  "\{\"projects\":\{\"/opt/x/worktrees\":\{\"hasTrustDialogAccepted\":true\}\}\}"
}

fn preflight_with_config(config: String) -> BeltClaudePreflight {
  belt_claude_preflight_decision(
    claude_on_path: true,
    home: "/home/u",
    trust_store_path: "/home/u/.claude.json",
    trust_store_readable: true,
    trust_store_text: config,
    trust_root: "/opt/x/worktrees",
  )
}

