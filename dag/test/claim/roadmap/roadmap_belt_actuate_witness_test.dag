test fn malformed_pass_reason_makes_receipt_unreadable() -> Bool {
  let raw = join([
    "{\"schema\":\"", belt_tick_receipt_schema, "\",",
    "\"observed_at\":\"2026-08-02T02:00:00Z\",",
    "\"spawn_pass\":{\"outcome\":\"recorded\"},",
    "\"teardown_pass\":{\"outcome\":\"recorded\"},",
    "\"commit_pass\":{\"outcome\":\"recorded\"},",
    "\"verify_pass\":{\"outcome\":\"refused\"},",
    "\"publish_pass\":{\"outcome\":\"recorded\"}}",
  ], "")
  match belt_tick_receipt_decode(raw: raw) {
    BeltTickReceiptUnreadable { reason: r } =>
      string_contains(s: r, pattern: "refused without reason")
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptAbsent => false
  }
}

test fn belt_tick_receipt_missing_file_read_is_absent() -> Bool {
  match belt_tick_receipt_read_from_filesystem(
    success: false,
    content: "",
    error: "No such file or directory (os error 2)",
  ) {
    BeltTickReceiptAbsent => true
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptUnreadable { reason: _ } => false
  }
}

test fn belt_tick_receipt_io_failure_read_is_unreadable() -> Bool {
  match belt_tick_receipt_read_from_filesystem(
    success: false,
    content: "",
    error: "Permission denied (os error 13)",
  ) {
    BeltTickReceiptUnreadable { reason: r } =>
      string_contains(s: r, pattern: "Permission denied")
    BeltTickReceiptPresent { receipt: _ } => false
    BeltTickReceiptAbsent => false
  }
}

// The attempt-grain claim (U1) is PURE — content hashes and string derivations, no host reach — so
// it lives in dag/test/claim/dispatch_attempts_witness_test.dag, which discovery scans on every
// affected PR. This file is BinWitnessWet-excluded because its witnesses execute real host
// commands; a pure row parked here would be enrolled with zero executing consumers, which the
// Phase 0(b) admission invariant refused (CI 30184138800). Deferral is a property of the EXECUTION
// the row needs, never of the module it names.

// review 44039/44043 predicate dissolution. dashboard_instance_can_actuate was a Bool nickname for
// a two-variant coproduct test, so both belt entrypoints now match DashboardActuationPosture
// directly. Deleting the predicate would have deleted its only assertions, which never proved the
// wiring anyway — they restated the posture field. This proves the behaviour: an observe-only
// instance REFUSES at both entrypoints, before any observation, provider preflight, or worktree
// creation. Only the refusing arm is exercised because it short-circuits; the actuating arm would
// reach live tmux.

test fn observe_only_instance_refuses_dispatch_and_stop() -> Bool {
  let preview = srv2_preview_dashboard_instance()
  let dispatched = belt_dispatch_node_for_instance(
    instance: preview,
    node_id: "namespace-canonical-binding",
  )
  let stopped = belt_stop_node_for_instance(
    instance: preview,
    node_id: "namespace-canonical-binding",
  )
  match dispatched {
    SpawnNotAdmitted { node_id, refusal } =>
      node_id == "namespace-canonical-binding"
        && (match refusal {
          LaunchInstanceActuationRefused { instance_id, reason: _ } => instance_id == (preview.instance_id as String)
          _ => false
        })
    _ => false
  }
    && match stopped {
      StopDisabled { node_id, instance_id, reason: _ } =>
        node_id == "namespace-canonical-binding"
          && instance_id == (preview.instance_id as String)
      _ => false
    }
}

// Every arm of belt_footprint_admission_decision is exercised on SYNTHETIC observations, as
// belt_claude_preflight_decision and belt_observe_from_result already are: the decision is a pure
// fn over facts, so its arms are witnessable without a host, and the live half
// (belt_footprint_observe) only threads real probe results into it. The arms are not
// interchangeable and the tests say why — absent, unwritable, and unsearchable name three different
// remedies (converge the member, fix ownership drift, fix the mode), which is why they are not
// collapsed into one `unusable` Bool. The short-circuit witness is the load-bearing one for
// operator experience: with two bad roots the FIRST is reported, so the refusal names the member a
// human should look at first rather than whichever sorted last.

fn footprint_obs(
  member: String,
  present: Bool,
  writable: Bool,
  searchable: Bool,
) -> BeltFootprintObservation {
  BeltFootprintObservation {
    member: member,
    path: join(["/opt/gunbc/", member], ""),
    present: present,
    writable: writable,
    searchable: searchable,
  }
}

fn footprint_refusal_step(admission: BeltFootprintAdmission) -> String {
  match admission {
    FootprintAdmitted => "admitted"
    FootprintRefused { step: st, detail: _ } => st
  }
}

test fn witness_footprint_all_roots_usable_admits() -> Bool {
  let verdict = belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: true, writable: true, searchable: true),
    footprint_obs(member: "attempt-state", present: true, writable: true, searchable: true),
  ])
  footprint_refusal_step(admission: verdict) == "admitted"
}

test fn witness_footprint_absent_root_refuses() -> Bool {
  let verdict = belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: true, writable: true, searchable: true),
    footprint_obs(member: "attempt-state", present: false, writable: false, searchable: false),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-absent"
}

test fn witness_footprint_unwritable_root_refuses() -> Bool {
  let verdict = belt_footprint_admission_decision(observations: [
    footprint_obs(member: "attempt-state", present: true, writable: false, searchable: true),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-unwritable"
}

test fn witness_footprint_unsearchable_root_refuses() -> Bool {
  let verdict = belt_footprint_admission_decision(observations: [
    footprint_obs(member: "attempt-state", present: true, writable: true, searchable: false),
  ])
  footprint_refusal_step(admission: verdict) == "footprint-root-unsearchable"
}

test fn witness_footprint_refusal_names_the_first_bad_root() -> Bool {
  let verdict = belt_footprint_admission_decision(observations: [
    footprint_obs(member: "dispatch-worktrees", present: false, writable: false, searchable: false),
    footprint_obs(member: "attempt-state", present: true, writable: false, searchable: true),
  ])
  let step_is_first = footprint_refusal_step(admission: verdict) == "footprint-root-absent"
  let names_first = match verdict {
    FootprintRefused { step: _, detail: d } =>
      string_contains(s: d, pattern: "dispatch-worktrees")
    FootprintAdmitted => false
  }
  step_is_first && names_first
}

test fn witness_footprint_roots_cover_both_belt_write_targets() -> Bool {
  let roots = belt_dispatch_footprint_roots(instance: srv2_preview_dashboard_instance())
  let paths = join(map(roots, r => r.path), "|")
  let has_worktrees = string_contains(s: paths, pattern: "attempts")
  let has_attempt_state = string_contains(s: paths, pattern: "attempt-state")
  has_worktrees && has_attempt_state
}

// THE PRODUCER'S DECISION, EXERCISED WITHOUT A NETWORK OR A FILESYSTEM.
// belt_publish_attempt_for_instance performs three effects - read the existing receipt, observe the
// two remote surfaces, write the judgment - and every branch is decided by belt_publish_gate and
// belt_publish_write_outcome, both pure. That split makes these claims possible: an arm that fires
// when a receipt on disk is about another attempt would otherwise be reachable only by arranging
// that state on a real host.
//
// THE GATE'S JOB IS TO DECIDE WHETHER TO OBSERVE. Three of the five outcomes are settled by what is
// already on disk, and none should cost a GitHub read or risk overwriting evidence. The claims pin
// each: a receipt for this exact subject halts as already-recorded, an undecodable one halts rather
// than being replaced, one about another subject halts rather than being corrected, and only
// genuine absence proceeds.
//
// THE SUBJECT IS BUILT FROM AN OBSERVED HEAD OR NOT AT ALL. An attempt whose worktree head cannot
// be read has no subject, so the producer defers with the reason rather than adjudicating against
// a branch name - the lookup this lane replaced.

data belt_pub_head: CommitSha = "1111111111111111111111111111111111111111"
data belt_pub_other_head: CommitSha = "2222222222222222222222222222222222222222"

fn belt_pub_subject(head: CommitSha, node_id: String) -> RoadmapPublicationSubject {
  RoadmapPublicationSubject {
    node_id: node_id,
    attempt_key: "feedfacefeedface",
    repository: Repository {
      owner: "gunb-ai",
      name: "gunbc",
      full_name: "gunb-ai/gunbc",
      private: false,
      default_branch: "main",
    },
    branch: "dispatch/belt-pub-node-afeedfacefeedface" as NonEmptyStr,
    expected_base: "main" as NonEmptyStr,
    expected_head: head,
  }
}

fn belt_pub_receipt(head: CommitSha, node_id: String) -> String {
  publication_receipt_json(
    receipt: publication_receipt_of(
      subject: belt_pub_subject(head: head, node_id: node_id),
      outcome: adjudicate_publication(
        pulls: PullRequestsRead {
          pulls: [
            PullRequest {
              number: 1234,
              title: "a change",
              body: none,
              state: Open,
              html_url: "https://github.com/gunb-ai/gunbc/pull/1234" as NonEmptyStr,
              user: GitHubUser { login: "someone", id: 1, type: User },
              head: PullRequestRef {
                ref: "dispatch/belt-pub-node-afeedfacefeedface",
                sha: head,
                label: "head",
              },
              base: PullRequestRef { ref: "main", sha: belt_pub_other_head, label: "base" },
              created_at: "2026-08-01T00:00:00Z",
              updated_at: "2026-08-01T00:00:00Z",
              merged_at: none,
              draft: false,
              merge_commit_sha: none,
            },
          ],
        },
        remotes: RemoteBranchesRead { branches: [] },
        remote: "https://github.com/gunb-ai/gunbc.git" as NonEmptyStr,
        branch: "dispatch/belt-pub-node-afeedfacefeedface" as NonEmptyStr,
        expected_base: "main" as NonEmptyStr,
        expected_head: head,
      ),
    ),
  )
}

fn belt_pub_gate_key(gate: BeltPublishGate) -> String {
  match gate {
    PublishProceed => "proceed"
    PublishHalted { outcome } =>
      match outcome {
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => "already-recorded"
        PublishEvidenceUnreadable { node_id: _, detail: _ } => "evidence-unreadable"
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => "recorded"
        PublishWriteFailed { node_id: _, detail: _ } => "write-failed"
        PublishDeferred { node_id: _, reason: _ } => "deferred"
        PublishRequested { node_id: _, head_sha: _, request_path: _ } => "deferred"
      }
  }
}

test fn an_absent_receipt_lets_the_publish_producer_proceed() -> Bool {
  belt_pub_gate_key(
    gate: belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: ReceiptSourceAbsent,
    ),
  ) == "proceed"
}

test fn a_receipt_for_this_head_halts_the_publish_producer() -> Bool {
  belt_pub_gate_key(
    gate: belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  ) == "already-recorded"
}

test fn a_receipt_about_another_subject_is_not_overwritten() -> Bool {
  match belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "another-node") },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id, detail } =>
          node_id == "belt-pub-node"
            && string_contains(s: detail, pattern: "another subject")
            && string_contains(s: detail, pattern: "node_id")
            && string_contains(s: detail, pattern: "refuses to overwrite")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
        PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
      }
  }
}

// THE DEFECT THIS REFUSES, from review 46148: an I/O failure reading an existing receipt reached
// the gate as `readable=false`, which the evidence layer classified as EvidenceAbsent and the gate
// turned into PublishProceed - so a transient read fault would have OVERWRITTEN a receipt the belt
// could not read. Absent and unreadable have opposite correct actions, so they are now distinct
// constructors and the conflation has no spelling.
//
// Only the pair discriminates: absent proceeds, unreadable halts. Either alone would pass under the
// defect - the old code proceeded on both.

test fn an_unreadable_receipt_halts_rather_than_being_overwritten() -> Bool {
  match belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: ReceiptSourceUnreadable { detail: "input/output error" },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail } =>
          string_contains(s: detail, pattern: "cannot read")
            && string_contains(s: detail, pattern: "input/output error")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
        PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
      }
  }
}

test fn a_present_but_empty_receipt_is_a_fault_not_an_absence() -> Bool {
  match belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: ReceiptSourcePresent { text: "  " },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail: _ } => true
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
        PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
      }
  }
}

test fn an_undecodable_receipt_is_not_overwritten_either() -> Bool {
  match belt_publish_gate(
    node_id: "belt-pub-node",
    subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
    existing: ReceiptSourcePresent { text: "not a receipt" },
  ) {
    PublishProceed => false
    PublishHalted { outcome } =>
      match outcome {
        PublishEvidenceUnreadable { node_id: _, detail } =>
          string_contains(s: detail, pattern: "cannot read")
            && !string_contains(s: detail, pattern: "another subject")
        PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
        PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
        PublishWriteFailed { node_id: _, detail: _ } => false
        PublishDeferred { node_id: _, reason: _ } => false
        PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
      }
  }
}

// A JUDGMENT REACHED AND THEN LOST IS NOT A JUDGMENT RECORDED. Only the write makes the
// adjudication durable, so a failed write must not report the outcome it computed - the next tick
// finds nothing on disk, and a caller told the head was published would be reading a fact that
// exists nowhere. The pair below asserts the same receipt produces different producer outcomes
// purely on whether the write succeeded.

test fn a_failed_write_reports_loss_rather_than_the_outcome_it_computed() -> Bool {
  let subject = belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node")
  let receipt = publication_receipt_of(
    subject: subject,
    outcome: adjudicate_publication(
      pulls: PullRequestsRead { pulls: [] },
      remotes: RemoteBranchesRead { branches: [] },
      remote: "https://github.com/gunb-ai/gunbc.git" as NonEmptyStr,
      branch: "dispatch/belt-pub-node-afeedfacefeedface" as NonEmptyStr,
      expected_base: "main" as NonEmptyStr,
      expected_head: belt_pub_head,
    ),
  )
  let ok = belt_publish_write_outcome(
    node_id: "belt-pub-node",
    subject: subject,
    receipt: receipt,
    write_success: true,
    write_error: "",
  )
  let lost = belt_publish_write_outcome(
    node_id: "belt-pub-node",
    subject: subject,
    receipt: receipt,
    write_success: false,
    write_error: "read-only file system",
  )
  match ok {
    PublishRecorded { node_id: _, head_sha, outcome_key } =>
      head_sha == (belt_pub_head as String)
        && outcome_key == "branch-not-published"
        && match lost {
          PublishWriteFailed { node_id: _, detail } =>
            string_contains(s: detail, pattern: "read-only file system")
              && string_contains(s: detail, pattern: "reached and then lost")
          PublishRecorded { node_id: _, head_sha: _, outcome_key: _ } => false
          PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
          PublishEvidenceUnreadable { node_id: _, detail: _ } => false
          PublishDeferred { node_id: _, reason: _ } => false
          PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
        }
    PublishWriteFailed { node_id: _, detail: _ } => false
    PublishAlreadyRecorded { node_id: _, head_sha: _ } => false
    PublishEvidenceUnreadable { node_id: _, detail: _ } => false
    PublishDeferred { node_id: _, reason: _ } => false
    PublishRequested { node_id: _, head_sha: _, request_path: _ } => false
  }
}

fn subject_key(observation: PublicationSubjectObservation) -> String {
  match observation {
    PublicationSubjectObserved { subject } => subject.expected_head as String
    PublicationSubjectUnobserved { reason: _ } => ""
  }
}

test fn an_unreadable_worktree_head_yields_no_publication_subject() -> Bool {
  let missing = belt_publication_subject_for(
    node_id: "belt-pub-node",
    attempt_key: "feedfacefeedface",
    branch: "dispatch/belt-pub-node-afeedfacefeedface",
    base_branch: "main" as NonEmptyStr,
    repository: gunbc_repository,
    head: worktree_head_observation_of(
      outcome: ExecFailed {
        program: "git",
        exit_code: 128,
        stderr: "not a git repository",
      },
    ),
  )
  let observed = belt_publication_subject_for(
    node_id: "belt-pub-node",
    attempt_key: "feedfacefeedface",
    branch: "dispatch/belt-pub-node-afeedfacefeedface",
    base_branch: "main" as NonEmptyStr,
    repository: gunbc_repository,
    head: worktree_head_observation_of(
      outcome: ExecOk { stdout: (belt_pub_head as String) },
    ),
  )
  subject_key(observation: missing) == ""
    && subject_key(observation: observed) == (belt_pub_head as String)
    && match missing {
      PublicationSubjectUnobserved { reason } =>
        string_contains(s: reason, pattern: "exact head")
          && string_contains(s: reason, pattern: "not a git repository")
      PublicationSubjectObserved { subject: _ } => false
    }
}

// THE DISCRIMINATING CONTROL FOR THE HEAD READ, and why the exit code alone is not the test. git
// rev-parse HEAD exits zero and prints nothing on a worktree whose branch carries no commit yet,
// which a freshly created dispatch worktree is until the worker commits. A reader trusting the exit
// code would cast an empty string into a CommitSha: a subject matching no commit and equal to every
// other empty head, so a receipt written for it would be evidence for any attempt in that state.

test fn a_zero_exit_with_no_revision_is_unobserved_not_an_empty_head() -> Bool {
  match worktree_head_observation_of(outcome: ExecOk { stdout: "\n" }) {
    WorktreeHeadUnobserved { reason } =>
      string_contains(s: reason, pattern: "no revision")
    WorktreeHeadObserved { revision: _ } => false
  }
}

// THE CLAIM THAT PINS THE IDEMPOTENCE KEY, and the defect it would have caught. The obvious key is
// `a receipt exists for this head`; under it the belt's FIRST observation of a head - normally
// before the worker has pushed - records branch-not-published and then halts on its own record
// forever: `not published` for the rest of the attempt's life, the halt caused by the very receipt
// that observed the absence.
//
// So the pair drives the gate with two receipts for the SAME subject, differing only in what the
// remote showed: a bound one halts, an unpublished one proceeds. A gate keyed on existence rather
// than settlement returns already-recorded for both, and this goes red.

fn belt_pub_unpublished_receipt(head: CommitSha, node_id: String) -> String {
  publication_receipt_json(
    receipt: publication_receipt_of(
      subject: belt_pub_subject(head: head, node_id: node_id),
      outcome: adjudicate_publication(
        pulls: PullRequestsRead { pulls: [] },
        remotes: RemoteBranchesRead { branches: [] },
        remote: "https://github.com/gunb-ai/gunbc.git" as NonEmptyStr,
        branch: "dispatch/belt-pub-node-afeedfacefeedface" as NonEmptyStr,
        expected_base: "main" as NonEmptyStr,
        expected_head: head,
      ),
    ),
  )
}

test fn an_unsettled_receipt_is_re_observed_rather_than_halting_the_row() -> Bool {
  let settled = belt_pub_gate_key(
    gate: belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: ReceiptSourcePresent { text: belt_pub_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  )
  let unsettled = belt_pub_gate_key(
    gate: belt_publish_gate(
      node_id: "belt-pub-node",
      subject: belt_pub_subject(head: belt_pub_head, node_id: "belt-pub-node"),
      existing: ReceiptSourcePresent { text: belt_pub_unpublished_receipt(head: belt_pub_head, node_id: "belt-pub-node") },
    ),
  )
  settled == "already-recorded" && unsettled == "proceed" && settled != unsettled
}

// ---------------------------------------------------------------------------
// The deployed-revision gate, at the grain it is actually proven. These witness the PROJECTION of
// the unobserved arm: it cannot reach the ok band, carries a loud band, and its receipt names its
// cause. The drift arm this block once covered is DELETED (operator ruling 2026-09-05,
// launch_revision_outcome): a readable-but-drifted tree is admitted, so there is no drift receipt
// to assert. Whether the gate fires on a host with an unreadable HEAD is a wet fact owed a wet
// receipt -- not established here.

test fn witness_revision_refusal_is_never_ok() -> Bool {
  !belt_dispatch_result_ok(r: not_admitted(r: LaunchRevisionUnobserved { cause: "no git" }))
}

test fn witness_revision_refusal_label_pins_wire_contract() -> Bool {
  belt_dispatch_status_label(r: not_admitted(r: LaunchRevisionUnobserved { cause: "no git" })) == "deployed_revision_unobserved"
    && status_label_glued_to_ok(r: not_admitted(r: LaunchRevisionUnobserved { cause: "no git" }))
}

test fn witness_unobserved_receipt_names_its_cause() -> Bool {
  string_contains(
    s: serialize_json(v: belt_spawn_outcome_json(
      o: not_admitted(r: LaunchRevisionUnobserved { cause: "HEAD undecodable" }))),
    pattern: "HEAD undecodable")
}

// Handback items 3 and 4 (review artifact 51237).

fn dup_running() -> LaunchCensusRow {
  live_session_with_process(
    node_id: "a", process: WorkerProcessRunning { command: "codex" as NonEmptyStr })
}

fn dup_stale() -> LaunchCensusRow {
  live_session_with_process(
    node_id: "a", process: WorkerProcessExited { exit_code: 0, last_command: "codex" })
}

fn multiplicity_count(v: LaunchGateVerdict) -> Int {
  match v {
    GateRefused { refusal } => match refusal { LaunchSessionMultiplicityConflict { session_names: _, session_count: n } => n _ => 0 }
    _ => 0
  }
}

test fn witness_two_sessions_for_one_node_refuse_and_name_both() -> Bool {
  match live_gate(live: [dup_running(), dup_stale()], node_id: "a") {
    GateRefused { refusal } =>
      match refusal {
        LaunchSessionMultiplicityConflict { session_names: names, session_count: n } =>
          n == 2 && count(names) == 2
        _ => false
      }
    _ => false
  }
}

// THE DISCRIMINATING ONE: under first() these two orders answered Running and
// StaleTerminal respectively — same observation, different verdict, no signal.
test fn witness_multiplicity_verdict_is_order_independent() -> Bool {
  let a = multiplicity_count(v: live_gate(live: [dup_running(), dup_stale()], node_id: "a"))
  let b = multiplicity_count(v: live_gate(live: [dup_stale(), dup_running()], node_id: "a"))
  a == 2 && a == b
}

fn witness_oid_or_refuse(hex: String) -> GitObjectId? {
  git_object_id_from_untagged_hex(hex: hex)
}

data witness_desired_hex: String = "1111111111111111111111111111111111111111"
// The gate itself, not its output arms: deleting the local_tree_revision match would leave every
// constructed-arm witness green, so drive the fold directly. DISCRIMINATING against the deleted
// drift arm: an observed revision passes whatever the fleet ref says, because the fold never sees
// the fleet ref at all.
test fn witness_revision_admission_fold_drives_both_arms() -> Bool {
  let unobserved = launch_gate_revision(
    revision: LocalTreeRevisionUnobserved { cause: "HEAD undecodable" })
  match witness_oid_or_refuse(hex: witness_desired_hex) {
    Present { value: d_oid } => {
      let observed = launch_gate_revision(revision: LocalTreeRevisionObserved { revision: d_oid })
      (match observed { GatePassed => true _ => false })
        && (match unobserved {
          GateRefused { refusal } => match refusal { LaunchRevisionUnobserved { cause: c } => c == "HEAD undecodable" _ => false }
          _ => false
        })
    }
    Absent => false
  }
}

// THE BELT-GRAIN CONTROL (review artifact 51237, P0 #2). The previous dead-pane witness proved a
// helper Boolean and said nothing about the continuously running reconciler, which received the
// whole session list and counted every present row as an occupied member. This asserts the
// partition the tick feeds to belt_reconcile: a stale pane is NOT running, so it neither occupies
// capacity nor reads as Unchanged; an unobserved pane is in neither bucket — a counted refusal,
// because tearing it down could kill live work and spawning beside it could double-run the node.
test fn witness_tick_partition_is_lifecycle_aware_not_presence_aware() -> Bool {
  let part = belt_tick_classify_sessions(live: [
    live_session_fat_with_process(
      node_id: "run", process: WorkerProcessRunning { command: "codex" as NonEmptyStr }),
    live_session_fat_with_process(
      node_id: "dead", process: WorkerProcessExited { exit_code: 0, last_command: "codex" }),
    live_session(node_id: "unknown", verdict: Converged),
  ])
  part.running.length() == 1
    && part.stale.length() == 1
    && part.refused.length() == 1
    && part.conflicted.length() == 0
    && all(part.running, s => s.node_id == "run")
    && all(part.stale, s => s.node_id == "dead")
    && all(part.refused, s => s.node_id == "unknown")
}

// Review artifact 51285, finding 1: `refused` was partitioned and never read, so an
// unobserved-but-present session left its node looking ABSENT to belt_reconcile and
// spawnable — beside a pane that might be running. Nothing running means nothing
// occupies capacity; the point is that nothing is spawned either.
test fn witness_tick_defers_every_non_running_class() -> Bool {
  let part = belt_tick_classify_sessions(live: [
    live_session(node_id: "unknown", verdict: Converged),
  ])
  part.running.length() == 0
    && part.refused.length() == 1
    && part.stale.length() == 0
    && part.conflicted.length() == 0
}

// Finding 2: multiplicity is a NODE fact. Two rows for one node landed in two buckets
// because each row's process state was read in isolation, so the tick acted on an
// ambiguity the click path refuses. Neither row may be classified running.
test fn witness_tick_multiplicity_is_a_node_fact() -> Bool {
  let part = belt_tick_classify_sessions(live: [
    live_session_fat_with_process(
      node_id: "a", process: WorkerProcessRunning { command: "codex" as NonEmptyStr }),
    live_session_fat_with_process(
      node_id: "a", process: WorkerProcessExited { exit_code: 0, last_command: "codex" }),
  ])
  part.conflicted.length() == 2
    && part.running.length() == 0
    && part.stale.length() == 0
}

// ── The located spawn cause reaches the receipt ─────────────────────────────────────────────────
//
// THE DEFECT THIS CLOSES: SpawnFailed carries node_id, step, detail and provider, and the pass fold
// discarded all four for the sentence "one or more spawn outcomes failed". The receipt is a tick's
// only durable record, so the cause was computed and erased every time. On srv1 that turned a
// missing provider binary into weeks of a dashboard saying "belt fault" with no way to ask why —
// and the obvious host probes answer about a different object than the preflight tests, so the
// available evidence pointed away from the cause.
//
// Each conjunct names one of the four facts, so a fold dropping any single field reds here rather
// than passing on the other three.
test fn a_failed_spawn_names_its_node_gate_and_detail_in_the_receipt() -> Bool {
  match belt_spawn_pass_outcome_from(
    host_refusal: none,
    spawn_outcomes: [
      SpawnFailed {
        node_id: "v2-emitter-direct-rust-door",
        step: "codex-cli",
        detail: "codex not found at the pinned bundled path",
        provider: "codex",
        launch: launch_identity_exemplar(),
      },
    ],
  ) {
    BeltPassFailed { reason: r } =>
      string_contains(s: r, pattern: "v2-emitter-direct-rust-door")
        && string_contains(s: r, pattern: "codex-cli")
        && string_contains(s: r, pattern: "codex not found at the pinned bundled path")
        && string_contains(s: r, pattern: "codex")
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// THE CONTROL, and it is the one that makes the claim above mean something. A reason string is easy
// to satisfy by concatenating every outcome unconditionally, which would also "name the detail" of
// a successful spawn and report failure for a tick that had none. So: an all-Spawned list must
// reach BeltPassRecorded, with no reason at all.
test fn a_tick_with_no_failed_spawn_records_instead_of_reporting_a_cause() -> Bool {
  match belt_spawn_pass_outcome_from(
    host_refusal: none,
    spawn_outcomes: [
      Spawned { node_id: "n1", session_name: "s1", provider: "codex", launch: launch_identity_exemplar() },
      Spawned { node_id: "n2", session_name: "s2", provider: "codex", launch: launch_identity_exemplar() },
    ],
  ) {
    BeltPassRecorded => true
    BeltPassFailed { reason: _ } => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// Mixed list: the failed one is named and the succeeded one is not dragged into the cause. This is
// what distinguishes "report the failures" from "report everything that happened".
test fn a_mixed_tick_names_only_the_failed_spawn() -> Bool {
  match belt_spawn_pass_outcome_from(
    host_refusal: none,
    spawn_outcomes: [
      Spawned { node_id: "healthy-node", session_name: "s1", provider: "codex", launch: launch_identity_exemplar() },
      SpawnFailed {
        node_id: "broken-node",
        step: "codex-auth",
        detail: "login status exited nonzero",
        provider: "codex",
        launch: launch_identity_exemplar(),
      },
    ],
  ) {
    BeltPassFailed { reason: r } =>
      string_contains(s: r, pattern: "broken-node")
        && string_contains(s: r, pattern: "codex-auth")
        && !string_contains(s: r, pattern: "healthy-node")
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
    BeltPassRefused { reason: _ } => false
  }
}

// An observation refusal still wins over the spawn summary — the pre-existing arm, asserted here so
// the new reason-building cannot quietly displace it.
test fn an_observation_refusal_still_outranks_the_spawn_summary() -> Bool {
  match belt_spawn_pass_outcome_from(
    host_refusal: Present { value: LaunchSessionsUnobservable { reason: "tmux list refused" } },
    spawn_outcomes: [
      SpawnFailed { node_id: "n", step: "codex-cli", detail: "d", provider: "codex", launch: launch_identity_exemplar() },
    ],
  ) {
    BeltPassRefused { reason: r } => string_contains(s: r, pattern: "tmux list refused")
    BeltPassFailed { reason: _ } => false
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
  }
}

// Controls for review 5059681676 on #9696. (1) A transition-halted tick writes a receipt whose FOUR
// passes are Refused with the transition reason -- never Recorded for the verify/publish passes the
// driver did not run; a non-transition host refusal (revision drift) withholds only the launch
// passes and verification still records on its own evidence. (2) The route's decision path after
// the staged observation refuses an unknown node and a contractless node WITHOUT listing tmux:
// under the hermetic route a tmux effect is a route refusal, not a verdict, so the green verdict is
// the effect-order receipt.

fn pass_refused_with(o: BeltPassOutcome, pattern: String) -> Bool {
  match o {
    BeltPassRefused { reason } => string_contains(s: reason, pattern: pattern)
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
    BeltPassFailed { reason: _ } => false
  }
}

fn all_four_refused_with(receipt: BeltTickReceipt, pattern: String) -> Bool {
  pass_refused_with(o: receipt.spawn_pass, pattern: pattern)
    && pass_refused_with(o: receipt.teardown_pass, pattern: pattern)
    && pass_refused_with(o: receipt.verify_pass, pattern: pattern)
    && pass_refused_with(o: receipt.publish_pass, pattern: pattern)
}

test fn transition_halted_tick_refuses_all_four_passes() -> Bool {
  let refusal = LaunchTransitionInhibited { reason: "deployment transition in force on this host" }
  let receipt = belt_tick_receipt_from_result(
    result: BeltTickResult {
      wholesale: TickPassesWithheld { refusal: refusal },
      host_refusal: Present { value: refusal },
      reconcile: belt_tick_empty_reconcile(state: ManualReady),
      spawn_outcomes: [],
      teardown_outcomes: [],
      commit_outcomes: [],
      verify_outcomes: [],
      publish_outcomes: [],
      review_outcomes: [],
      audit_outcomes: [],
    },
    observed_at: "2026-08-30T02:00:00Z",
    execution: TickExecuted { instance_id: "srv1-live", deployed_revision: "0123456789abcdef0123456789abcdef01234567", spawn_mode: ManualReady },
  )
  all_four_refused_with(receipt: receipt, pattern: "deployment transition in force")
}

test fn revision_refusal_keeps_verify_independently_recorded() -> Bool {
  let receipt = belt_tick_receipt_from_result(
    result: BeltTickResult {
      wholesale: TickPassesRun,
      host_refusal: Present { value: LaunchRevisionUnobserved { cause: "HEAD undecodable" } },
      reconcile: belt_tick_empty_reconcile(state: ManualReady),
      spawn_outcomes: [],
      teardown_outcomes: [],
      commit_outcomes: [],
      verify_outcomes: [ VerifyRecorded { node_id: "n", verdict_key: "pass", detail: "ok" } ],
      publish_outcomes: [],
      review_outcomes: [],
      audit_outcomes: [],
    },
    observed_at: "2026-08-30T02:00:00Z",
    execution: TickExecuted { instance_id: "srv1-live", deployed_revision: "0123456789abcdef0123456789abcdef01234567", spawn_mode: ManualReady },
  )
  (match receipt.spawn_pass { BeltPassRefused { reason } => string_contains(s: reason, pattern: "deployed revision could not be observed") _ => false })
    && (match receipt.teardown_pass { BeltPassRefused { reason: _ } => true _ => false })
    && (match receipt.verify_pass { BeltPassRecorded => true _ => false })
    && (match receipt.publish_pass { BeltPassRecorded => true _ => false })
}

fn launch_fixture_canary_graph() -> LaunchGraphStanding {
  launch_graph_of_document(doc: canary_doc(nodes: [canary_parent(signoff: Unsigned), canary_child()], edges: [roadmap_launch_canary_edge()]))
}

fn launch_fixture_canary_graph_child_contracted() -> LaunchGraphStanding {
  launch_graph_of_document(doc: canary_doc(
    nodes: [
      canary_parent(signoff: Unsigned),
      canary_node(
        identity: roadmap_launch_canary_child_identity,
        id: roadmap_launch_canary_child_node_id(),
        execution: roadmap_launch_canary_execution_contract(),
        signoff: Unsigned,
      ),
    ],
    edges: [roadmap_launch_canary_edge()],
  ))
}

fn staged_post_over_canary(graph: LaunchGraphStanding, standing: LaunchHostStanding, node_id: String) -> BeltSpawnOutcome {
  belt_dispatch_node_staged_over(
    instance: srv1_live_dashboard_instance(),
    standing: standing,
    graph: graph,
    merged: [],
    node_id: node_id,
  )
}

// The route's real decision path (belt_dispatch_node_staged_over, which belt_dispatch_node_staged
// calls with the live projection) over the RLM-0 canary graph and a pending session set. Each
// refuses at a model-only gate, so tmux is never listed: under claim_batch's hermetic route a tmux
// effect would be a route refusal, not a verdict.
test fn staged_post_refuses_unknown_node_without_listing_tmux() -> Bool {
  match staged_post_over_canary(graph: launch_fixture_canary_graph(), standing: launch_fixture_standing_pending(mode: ManualReady), node_id: "no-such-node-anywhere") {
    SpawnNotAdmitted { node_id, refusal: LaunchNodeUnknown } => node_id == "no-such-node-anywhere"
    _ => false
  }
}

test fn staged_post_refuses_contractless_node_without_listing_tmux() -> Bool {
  match staged_post_over_canary(graph: launch_fixture_canary_graph(), standing: launch_fixture_standing_pending(mode: ManualReady), node_id: roadmap_launch_canary_child_node_id() as String) {
    SpawnNotAdmitted { node_id: _, refusal: LaunchExecutionContractMissing { reason: _ } } => true
    _ => false
  }
}

test fn staged_post_refuses_blocked_child_without_listing_tmux() -> Bool {
  match staged_post_over_canary(graph: launch_fixture_canary_graph_child_contracted(), standing: launch_fixture_standing_pending(mode: ManualReady), node_id: roadmap_launch_canary_child_node_id() as String) {
    SpawnNotAdmitted { node_id: _, refusal: LaunchDependenciesBlocked { blockers: _ } } => true
    _ => false
  }
}

test fn staged_post_transition_halt_refuses_without_listing_tmux() -> Bool {
  match staged_post_over_canary(graph: launch_fixture_canary_graph(), standing: launch_fixture_standing_halt_transition(), node_id: roadmap_launch_canary_child_node_id() as String) {
    SpawnNotAdmitted { node_id: _, refusal: LaunchTransitionInhibited { reason: _ } } => true
    _ => false
  }
}


// A KEYLESS ATTEMPT IS UNADDRESSABLE, AND THAT MUST NOT FAIL THE PASS.
//
// Measured on srv1 2026-09-07: commit_pass failed on every tick for eighteen hours, verify deferred
// for "no attempt is ready", and the roadmap moved nothing. The cause was seven legacy attempts
// carrying an EMPTY attempt_key. dispatch_worktree_path_for_instance joins node_id, "-a" and the key
// unconditionally, so an empty key addresses <root>/<node>-a, which cannot exist -- the keyless
// worktrees on that host are <root>/<node>, with no suffix. `git status` in a directory that is not
// there exits nonzero, that became CommitFailed, and ONE CommitFailed fails the whole pass.
//
// THE FAILURE WAS NEVER IN THE COMMIT. No git operation was refused and nothing was wrong with the
// other worktrees; the pass computed an address for an attempt that has none. Reporting that as
// CommitFailed is the not-applicable-rendered-as-malformed conflation -- one symbol over "this
// commit was refused" and "this attempt cannot be addressed", which have different owners and
// different repairs.
test fn a_keyless_attempt_is_unaddressable_and_does_not_fail_the_commit_pass() -> Bool {
  let unaddressable = CommitSubjectUnaddressable { node_id: "legacy-node", reason: "no key" }
  !belt_commit_outcome_is_failure(o: unaddressable)
    && !belt_commit_outcome_is_recorded(o: unaddressable)
}

// THE DISCRIMINATOR, and without it the arm above would pass equally well if the pass had simply
// stopped failing on everything. A real CommitFailed must still fail it, and a pass carrying both an
// unaddressable legacy row and a genuine failure must report the failure rather than being softened
// by its neighbour.
test fn a_real_commit_failure_still_fails_the_pass_beside_an_unaddressable_one() -> Bool {
  let with_both = belt_commit_pass_outcome_from(outcomes: [
    CommitSubjectUnaddressable { node_id: "legacy-node", reason: "no key" },
    CommitFailed { node_id: "real-node", detail: "commit: git exited 1" },
  ])
  let only_unaddressable = belt_commit_pass_outcome_from(outcomes: [
    CommitSubjectUnaddressable { node_id: "legacy-node", reason: "no key" },
  ])
  let failed = match with_both { BeltPassFailed { reason: _ } => true  _ => false }
  let not_failed = match only_unaddressable { BeltPassFailed { reason: _ } => false  _ => true }
  failed && not_failed
}

// AN UNADDRESSABLE ATTEMPT IS COUNTED, NOT SILENTLY DROPPED. It is a real defect in whatever wrote a
// keyless attempt, so the tick receipt names it; what changed is only that it stops halting its
// siblings. A row that vanished from the receipt would zero the deficit's frequency by construction.
test fn the_unaddressable_outcome_is_named_in_the_tick_receipt() -> Bool {
  let rendered = serialize_json(v: belt_commit_outcome_json_value(o: CommitSubjectUnaddressable {
    node_id: "legacy-node",
    reason: "no key",
  }))
  string_contains(s: rendered, pattern: "subject-unaddressable")
    && string_contains(s: rendered, pattern: "legacy-node")
}

// The publish edge materializes recovered corpus paths; the parent-dir computation is the one pure
// decision in it, and losing the first segment or keeping the basename would write outside or beside
// the integration worktree's structure.
test fn the_publish_edge_parent_dir_drops_exactly_the_basename() -> Bool {
  belt_path_parent_dir(path: "dag/gunbc/ci/ci_spec.dag") == "dag/gunbc/ci"
    && belt_path_parent_dir(path: "dag/a.dag") == "dag"
    && belt_path_parent_dir(path: "README.md") == ""
}

// The per-attempt commit outcome receipt is the durable record the tick receipt's collapse erases:
// the failing attempt's arm and detail must survive the pass.
test fn the_commit_outcome_receipt_carries_the_failing_attempts_arm_and_detail() -> Bool {
  let r = belt_commit_outcome_receipt(
    o: CommitFailed { node_id: "n1", detail: "status: git exited 128: fatal" },
    attempt_key: "abc",
  )
  let wire = serialize_json(v: belt_commit_outcome_receipt_json(r: r))
  r.node_id == "n1"
    && r.attempt_key == "abc"
    && r.outcome == "failed"
    && r.detail == "status: git exited 128: fatal"
    && string_contains(s: wire, pattern: "\"schema\": \"roadmap-commit-outcome/v1\"")
    && string_contains(s: wire, pattern: "\"outcome\": \"failed\"")
    && string_contains(s: wire, pattern: "status: git exited 128: fatal")
}

test fn the_candidate_receipt_names_the_captured_head() -> Bool {
  let r = belt_commit_outcome_receipt(
    o: CandidateCaptured { node_id: "n1", head_sha: "aaaa", message: "dispatch candidate: n1 aabc" },
    attempt_key: "abc",
  )
  r.outcome == "candidate-captured"
    && string_contains(s: r.detail, pattern: "aaaa")
}


// A DURABLE CAPTURE REFUSAL IS A POISONED ATTEMPT, NOT A FAILED PASS. The 2026-09-21 incident:
// commit_pass answered "one or more attempt worktrees could not be committed" on EVERY tick, and
// verify deferred behind it forever, because one attempt's SCM capture kept refusing -- for a
// while because the save was quadratic (a cost defect, fixed at its own layer), and by
// construction because a durable refusal (no owning arc, a base that freezes nothing, store
// damage) re-refuses on every retry and was typed CommitFailed, which fails the whole pass. The
// classification is born at the refusal site (BeltScmCapture carries the durability split), so a
// poisoned attempt is a typed, located, persisted skip -- the same absorbing-arm repair
// CommitSubjectUnaddressable carries one seam up.
test fn a_capture_poisoned_attempt_is_a_skip_not_a_failure() -> Bool {
  let poisoned = CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" }
  !belt_commit_outcome_is_failure(o: poisoned)
    && !belt_commit_outcome_is_recorded(o: poisoned)
}

// THE DISCRIMINATOR, in both directions. Without it the arm above would pass equally well if the
// pass had simply stopped failing on everything: a real transient CommitFailed beside any number
// of poisoned siblings must still fail the pass (an infra arm that may clear by next tick stays
// loud), while poison alone defers honestly and names the count.
test fn a_real_commit_failure_still_fails_the_pass_beside_poisoned_ones() -> Bool {
  let with_both = belt_commit_pass_outcome_from(outcomes: [
    CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" },
    CommitCapturePoisoned { node_id: "n2", detail: "the seeded base's root is an authored source, which is store damage" },
    CommitFailed { node_id: "real-node", detail: "commit: git exited 1" },
  ])
  let only_poison = belt_commit_pass_outcome_from(outcomes: [
    CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" },
    CommitSkipped { node_id: "n2", reason: "worktree clean" },
  ])
  let poison_with_recorded = belt_commit_pass_outcome_from(outcomes: [
    CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" },
    CommitRecorded { node_id: "n2", message: "dispatch checkpoint" },
  ])
  let failed = match with_both { BeltPassFailed { reason: _ } => true  _ => false }
  let deferred_honestly = match only_poison {
    BeltPassDeferred { reason } => string_contains(s: reason, pattern: "capture-poisoned")
    _ => false
  }
  let recorded_over_poison = match poison_with_recorded { BeltPassRecorded => true  _ => false }
  failed && deferred_honestly && recorded_over_poison
}

// A POISONED ATTEMPT IS COUNTED, NOT SILENTLY DROPPED: the number is how many attempts this tick
// are held for repair, counted in the tick result beside the siblings' verdicts. A zero here
// would make the poison frequency vanish by construction, the deficit this witness exists to
// keep visible.
test fn the_poisoned_attempt_count_counts_only_capture_poisoned_rows() -> Bool {
  let result = BeltTickResult {
    wholesale: TickPassesRun,
    host_refusal: Absent,
    reconcile: belt_tick_empty_reconcile(state: ManualReady),
    spawn_outcomes: [],
    teardown_outcomes: [],
    commit_outcomes: [
      CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" },
      CommitSkipped { node_id: "n2", reason: "worktree clean" },
      CommitCapturePoisoned { node_id: "n3", detail: "two or more arcs depend on this node" },
    ],
    verify_outcomes: [],
    publish_outcomes: [],
    review_outcomes: [],
    audit_outcomes: [],
  }
  belt_tick_commit_poisoned_count(t: result) == 2
    && string_contains(
      s: serialize_json(v: belt_tick_result_json_value(t: result)),
      pattern: "\"commit_poisoned\": 2",
    )
}

// THE POISON IS NAMED AT BOTH DURABLE RECORDS, the tick result's outcome row and the per-attempt
// receipt that survives the pass receipt's collapse -- the operator repairs against the attempt's
// own row, never against the pass sentence it no longer halts.
test fn the_poisoned_outcome_is_named_in_the_tick_result_and_the_attempt_receipt() -> Bool {
  let rendered = serialize_json(v: belt_commit_outcome_json_value(o: CommitCapturePoisoned {
    node_id: "n1",
    detail: "the recorded base names zero files",
  }))
  let r = belt_commit_outcome_receipt(
    o: CommitCapturePoisoned { node_id: "n1", detail: "the recorded base names zero files" },
    attempt_key: "abc",
  )
  string_contains(s: rendered, pattern: "capture-poisoned")
    && string_contains(s: rendered, pattern: "n1")
    && r.outcome == "capture-poisoned"
    && r.attempt_key == "abc"
    && r.node_id == "n1"
    && string_contains(s: r.detail, pattern: "zero files")
}

// ------------------------------------------------------------------------------------------------
// The supervisor convene path: one session per escalation record, the checkpoint projected from
// belt records, the production lineages naming their derived targets.
// ------------------------------------------------------------------------------------------------

// THE GATE ADMITS ONCE AND NEVER STACKS: an absent unit is clear to convene, a running unit is
// already the session over this record (escalation does not stack), an exited unit without a
// verdict is named and not reconvened, and an unreadable unit refuses rather than guessing.
test fn the_convene_gate_admits_once_and_never_stacks() -> Bool {
  match belt_supervisor_convene_gate(process: WorkerProcessAbsent) {
    ConveneClear => true
    _ => false
  }
    && (match belt_supervisor_convene_gate(process: WorkerProcessRunning { command: "gunbc-supervisor-n1-k-t3.service" }) {
      ConveneAlreadyLive => true
      _ => false
    })
    && (match belt_supervisor_convene_gate(process: WorkerProcessExited { exit_code: 1, last_command: "u" }) {
      ConveneExitedNoVerdict { exit_code } => exit_code == 1
      _ => false
    })
    && (match belt_supervisor_convene_gate(process: WorkerProcessUnobserved { reason: "systemctl refused" as NonEmptyStr }) {
      ConveneLivenessUnobserved { reason } => reason == "systemctl refused"
      _ => false
    })
}

// THE CHECKPOINT LINES ARE THE CAPTURE RECORD, PROJECTED: the worker's own explanation and
// limitations arrive verbatim, the capture state names its readiness, a yield reads as a yield,
// and an unreadable capture carries its reason -- no line is invented.
test fn the_checkpoint_lines_project_the_capture_record_verbatim() -> Bool {
  let blocked = WorkerSubmission {
    readiness: SubmissionBlocked,
    explanation: "the acceptance run was still in flight when the budget died",
    limitations: "acceptance unconfirmed",
  }
  let bound = belt_supervisor_checkpoint_lines(
    capture: CaptureForHead { capture: SubmissionCapture {
      head_sha: "b04485cffb000000000000000000000000000000",
      scm_repository: "/instance/attempt-state/projects/n1.gunbc-repository.json",
      scm_commit_ordinal: 3,
      scm_root_locator: SubmissionCaptureRootBound { locator: "0123456789abcdef" },
      digest: submission_digest(submission: blocked),
      submission: blocked,
    } },
    head_sha: "b04485cffb000000000000000000000000000000",
    history_line: "3 turns spent; last commit outcome: recorded -- swept",
  )
  let yielded = belt_supervisor_checkpoint_lines(capture: CaptureAbsent, head_sha: "h2", history_line: "y")
  bound.explanation == "the acceptance run was still in flight when the budget died"
    && bound.limitations == "acceptance unconfirmed"
    && bound.head_sha == "b04485cffb000000000000000000000000000000"
    && bound.history_line == "3 turns spent; last commit outcome: recorded -- swept"
    && string_contains(s: bound.capture_line, pattern: "blocked")
    && string_contains(s: yielded.capture_line, pattern: "preservation only")
    && string_contains(s: yielded.explanation, pattern: "yielded")
    && string_contains(
      s: belt_supervisor_checkpoint_lines(capture: CaptureUnreadable { reason: "does not decode" }, head_sha: "h3", history_line: "z").capture_line,
      pattern: "does not decode",
    )
}

// ------------------------------------------------------------------------------------------------
// The attempt binding: the chain is bound to the attempt identity at spawn, and a continuation
// reads the parent attempt's binding back BEFORE any spawn command exists — a changed chain
// refuses with both fingerprints named, never silently re-briefs (review finding 2026-09-26,
// attempt binding).
// ------------------------------------------------------------------------------------------------

fn belt_test_ready_resolution(node_id: String, project_id: String) -> AlignmentResolution {
  alignment_resolve_chain(
    chain: AlignmentChained {
      task: AlignmentChainLink { node_id: node_id, purpose: "Binding purpose", boundary: "Binding boundary" },
      projects: [AlignmentChainLink {
        node_id: project_id,
        purpose: join(["Purpose of ", project_id], ""),
        boundary: join(["Boundary of ", project_id], ""),
      }],
      root: decl_ref(module_path: "gunbc.design_document", decl_name: "design_document"),
    },
    turns_elapsed: 2,
    state: alignment_base_cadence_state(),
  )
}

fn belt_test_ready_fingerprint(node_id: String, project_id: String) -> String {
  match belt_test_ready_resolution(node_id: node_id, project_id: project_id) {
    AlignmentReady { chain, due_levels: _, rendered_prompt: _ } => alignment_chain_fingerprint(chain: chain)
    AlignmentUnresolved { cause: _ } => ""
  }
}

fn belt_test_binding_read(identity: String, fingerprint: String) -> BeltAlignmentBindingText {
  BeltAlignmentBindingRead {
    content: alignment_binding_text(binding: AlignmentBinding { attempt_identity: identity, fingerprint: fingerprint }),
  }
}

// THE BINDING IS MINTED UNDER THE WORKER ATTEMPT IDENTITY the spawn argv carries — one mint for
// the unit's --arg and the state's binding file, so the two cannot drift apart.
test fn the_binding_identity_is_the_worker_attempt_identity() -> Bool {
  dispatch_worker_attempt_identity(node_id: "n1", attempt_key: "deadbeef") == "worker:n1-deadbeef"
}

// AN UNCHANGED CHAIN BINDS: the parent attempt's fingerprint equals the chain the authority derives
// now, so the continuation dispatches.
test fn a_continuation_with_an_unchanged_chain_binds() -> Bool {
  let fingerprint = belt_test_ready_fingerprint(node_id: "n1", project_id: "a1")
  match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: belt_test_binding_read(identity: "worker:n1-deadbeef", fingerprint: fingerprint),
    resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1"),
  ) {
    BeltAlignmentBindingOk => true
    BeltAlignmentBindingRefused { reason: _ } => false
  }
}

// A CHANGED CHAIN REFUSES, NAMING BOTH FINGERPRINTS: any moved link — here a retitled project row —
// moves the fingerprint, and the refusal names what was bound and what the authority now derives.
test fn a_continuation_with_a_changed_chain_refuses_naming_both_fingerprints() -> Bool {
  let bound_fingerprint = belt_test_ready_fingerprint(node_id: "n1", project_id: "a1")
  let now_fingerprint = belt_test_ready_fingerprint(node_id: "n1", project_id: "a1-retitled")
  match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: belt_test_binding_read(identity: "worker:n1-deadbeef", fingerprint: bound_fingerprint),
    resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1-retitled"),
  ) {
    BeltAlignmentBindingOk => false
    BeltAlignmentBindingRefused { reason } =>
      string_contains(s: reason, pattern: "changed")
        && string_contains(s: reason, pattern: bound_fingerprint)
        && string_contains(s: reason, pattern: now_fingerprint)
  }
}

// AN UNBOUND PARENT REFUSES: an attempt that predates the binding lane carries no chain to compare
// against, and weaker evidence cannot improve admission — the continuation does not dispatch on an
// unbound chain.
test fn a_continuation_over_an_unbound_parent_refuses() -> Bool {
  match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: BeltAlignmentBindingAbsent,
    resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1"),
  ) {
    BeltAlignmentBindingOk => false
    BeltAlignmentBindingRefused { reason } => string_contains(s: reason, pattern: "no alignment binding")
  }
}

// A BINDING MINTED FOR ANOTHER ATTEMPT REFUSES: the identity beside the payload is checked against
// the parent the lineage actually continues — a receipt from a different attempt authorizes nothing
// (conservation law 4: adjacency is not a join).
test fn a_binding_minted_for_another_attempt_refuses() -> Bool {
  let fingerprint = belt_test_ready_fingerprint(node_id: "n1", project_id: "a1")
  match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: belt_test_binding_read(identity: "worker:n1-cafebabe", fingerprint: fingerprint),
    resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1"),
  ) {
    BeltAlignmentBindingOk => false
    BeltAlignmentBindingRefused { reason } =>
      string_contains(s: reason, pattern: "worker:n1-cafebabe")
        && string_contains(s: reason, pattern: "worker:n1-deadbeef")
  }
}

// AN UNREADABLE OR UNDECODABLE BINDING REFUSES rather than guessing the chain.
test fn an_unreadable_or_undecodable_binding_refuses() -> Bool {
  (match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: BeltAlignmentBindingUnreadable { reason: "the directory listing refused" },
    resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1"),
  ) {
    BeltAlignmentBindingOk => false
    BeltAlignmentBindingRefused { reason } => string_contains(s: reason, pattern: "directory listing refused")
  })
    && (match belt_alignment_binding_check(
      expected_identity: "worker:n1-deadbeef",
      bound: BeltAlignmentBindingRead {
        content: "{\"schema\": \"roadmap-alignment-binding/v2\", \"attempt_identity\": \"worker:n1-deadbeef\", \"fingerprint\": \"fp\"}",
      },
      resolution: belt_test_ready_resolution(node_id: "n1", project_id: "a1"),
    ) {
      BeltAlignmentBindingOk => false
      BeltAlignmentBindingRefused { reason } => string_contains(s: reason, pattern: "does not decode")
    })
}

// AN UNRESOLVED CHAIN DEFERS TO THE SPAWN GATE: the binding check passes (its subject is "the
// chain is unchanged", which presupposes a chain) and the spawn fold's alignment gate refuses with
// the typed cause and zero commands — one refusal per question, each at its own seam.
test fn an_unresolved_chain_passes_the_binding_gate_and_the_spawn_gate_names_it() -> Bool {
  let unresolved = AlignmentUnresolved {
    cause: AlignmentChainForked { at: "a1", dependents: ["x", "y"], walked: [] },
  }
  match belt_alignment_binding_check(
    expected_identity: "worker:n1-deadbeef",
    bound: belt_test_binding_read(identity: "worker:n1-deadbeef", fingerprint: "fp"),
    resolution: unresolved,
  ) {
    BeltAlignmentBindingOk => true
    BeltAlignmentBindingRefused { reason: _ } => false
  }
}

// THE FRESH START HAS NOTHING TO CHECK: the gate reads no filesystem on the fresh arm — there is
// no parent attempt — and answers Ok; this attempt's own chain is bound at its state
// initialization for the continuation that may one day read it back.
test fn a_fresh_start_passes_the_binding_gate() -> Bool {
  match belt_alignment_binding_gate(
    instance: srv1_live_dashboard_instance(),
    node_id: roadmap_belt_actuate_nid(s: "n2"),
    origin: FreshFromBase,
    resolution: belt_test_ready_resolution(node_id: "n2", project_id: "a2"),
  ) {
    BeltAlignmentBindingOk => true
    BeltAlignmentBindingRefused { reason: _ } => false
  }
}

// THE TWO PRODUCTION LINEAGES. A capped lineage of either node evaluates to ContinuationEscalate
// (never a refusal), the target derives to their declared project from the authority's own edges,
// and the convene brief names that supervisor with the attempt's identity carried.
fn capped_production_prior(node_id: String) -> PriorAttemptFacts {
  PriorAttemptFacts {
    node_id: node_id,
    edges: declared_roadmap_edges(),
    attempt_key: "cd172fe81b806160",
    branch: "dispatch/x-acd172fe81b806160",
    worker_terminal: true,
    capture: CaptureAbsent,
    supervisor_verdict: SupervisorVerdictAbsent,
    verification: Present { value: WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentFailed, detail: "red" } },
    review: none,
    goal_audit: none,
  }
}

fn production_escalation(node_id: String) -> SupervisorEscalation? {
  match continuation_decision(prior: Present { value: capped_production_prior(node_id: node_id) }, prior_turn: ContinuationTurnKnown { turn: continuation_turn_cap }) {
    ContinuationEscalate { escalation } => Present { value: escalation }
    _ => none
  }
}

fn production_node(id: String) -> RoadmapNode? {
  (declared_roadmap_nodes() |> filter(n => (n.node as String) == id)).first()
}

test fn the_two_production_lineages_escalate_and_convene_naming_their_derived_supervisor() -> Bool {
  match production_escalation(node_id: "shell-dag-cron-entry-line-builder") {
    Absent => false
    Present { value: e1 } =>
      match production_escalation(node_id: "shell-dag-floor-peak-calibration-rows") {
        Absent => false
        Present { value: e2 } =>
          match production_node(id: "shell-dag-cron-entry-line-builder") {
            Absent => false
            Present { value: n1 } =>
              match production_node(id: "shell-dag-floor-peak-calibration-rows") {
                Absent => false
                Present { value: n2 } => {
                  let b1 = belt_supervisor_convene_brief(
                    node: n1,
                    escalation: e1,
                    checkpoint: belt_supervisor_checkpoint_lines(capture: CaptureAbsent, head_sha: "h", history_line: "3 turns spent"),
                  )
                  let b2 = belt_supervisor_convene_brief(
                    node: n2,
                    escalation: e2,
                    checkpoint: belt_supervisor_checkpoint_lines(capture: CaptureAbsent, head_sha: "h", history_line: "3 turns spent"),
                  )
                  (match e1.target { SupervisorForNode { node_id } => node_id == "shell-typed-invocation"  _ => false })
                    && (match e2.target { SupervisorForNode { node_id } => node_id == "shell-typed-invocation"  _ => false })
                    && b1.contains("the supervisor of node shell-typed-invocation")
                    && b2.contains("the supervisor of node shell-typed-invocation")
                    && b1.contains("cd172fe81b806160")
                    && b1.contains(supervisor_verdict_schema as String)
                    && b1.contains("UNRESOLVED")
                    && b1.contains("shell-gate-migration")
                    && !b1.contains("this task serves project shell-residue-zero")
                }
              }
          }
      }
  }
}

// THE CONVENED OUTCOME IS ITS OWN OK LABEL: a convened supervisor is the desired state achieved,
// on the ok side of the band, in the derived ok-label set, and on the wire as
// supervisor_convened -- never painted as a worker spawn and never as a failure.
test fn the_convened_outcome_is_an_ok_label_of_its_own() -> Bool {
  let o = SupervisorConvened { node_id: "n", unit: "gunbc-supervisor-n-k-t3.service", provider: "codex", launch: launch_identity_exemplar() }
  belt_dispatch_status_label(r: o) == "supervisor_convened"
    && belt_dispatch_result_ok(r: o)
    && count(belt_dispatch_ok_status_labels() |> filter(l => l == "supervisor_convened")) == 1
    && serialize_json(v: belt_spawn_outcome_json(o: o)).contains("\"status\": \"supervisor_convened\"")
    && serialize_json(v: belt_spawn_outcome_json(o: o)).contains("gunbc-supervisor-n-k-t3.service")
}

// ------------------------------------------------------------------------------------------------
// The per-item obligations: the gates and routes that make a wake-up a hint, never a fact.
// ------------------------------------------------------------------------------------------------

// THE VERIFY-ONE GATE RUNS ONLY WHEN NO RECEIPT BINDS THE HEAD. A recorded verdict is durable --
// the same head and oracle can never answer differently -- so a repeat wake-up is a typed no-op
// that re-runs nothing and rewrites nothing (conditional publish); only an absent receipt runs,
// and an unreadable one refuses rather than guessing over it.
test fn the_verify_one_gate_runs_only_when_no_receipt_binds_the_head() -> Bool {
  match belt_verify_one_gate(observation: VerifyOneReceiptAbsent) {
    VerifyOneRun => true
    _ => false
  }
    && (match belt_verify_one_gate(observation: VerifyOneReceiptRecorded { verdict_key: "pass", detail: "4 validations" }) {
      VerifyOneNoOp { verdict_key, detail } => verdict_key == "pass" && detail == "4 validations"
      _ => false
    })
    && (match belt_verify_one_gate(observation: VerifyOneReceiptUnreadable { reason: "the receipt does not decode" }) {
      VerifyOneRefuse { reason } => reason == "the receipt does not decode"
      _ => false
    })
}

// THE NO-OP IS ON THE WIRE AS ITSELF: the CLI receipt of an already-recorded verify says
// already-recorded with the durable verdict, so a wake-up storm never re-runs the oracle and the
// receipt says why nothing ran.
test fn the_verify_one_no_op_receipt_names_the_durable_verdict() -> Bool {
  let doc = serialize_json(v: belt_verify_one_result_json(r: VerifyOneAlreadyRecorded { verdict_key: "pass", detail: "4 validations" }))
  doc.contains("\"status\": \"already-recorded\"")
    && doc.contains("\"verdict\": \"pass\"")
    && doc.contains("roadmap-verify-one/v1")
}

// THE ESCALATE-ONE ROUTE CONVENES ONLY AN ESCALATION RECORD. A consumed verdict (Continue), a
// terminal typed state (PlanDefect/Stuck), nothing due (Fresh), and a hold are each the typed
// no-op their decision already is; a refusal stays a refusal.
test fn the_escalate_one_route_convenes_only_an_escalation_record() -> Bool {
  let escalation = SupervisorEscalation {
    node_id: "n1",
    attempt_key: "a1",
    branch: "roadmap/n1/a1",
    turn: 3,
    target: SupervisorForNode { node_id: "arc-1" },
    reason: "its verification still fails",
  }
  match belt_escalate_one_route(decision: ContinuationEscalate { escalation: escalation }) {
    EscalateRouteConvene { escalation: e } => e.attempt_key == "a1"
    _ => false
  }
    && (match belt_escalate_one_route(decision: ContinuationPlanDefect { defect: "the brief scopes four files as one edit" }) {
      EscalateRouteNotDue { detail } => detail.contains("plan defect") && detail.contains("four files")
      _ => false
    })
    && (match belt_escalate_one_route(decision: ContinuationStuck { cause: "the emitter lacks the lowering" }) {
      EscalateRouteNotDue { detail } => detail.contains("stuck")
      _ => false
    })
    && (match belt_escalate_one_route(decision: ContinuationSpawnFresh { reason: "no prior attempt of this node" }) {
      EscalateRouteNotDue { detail } => detail.contains("no escalation is due")
      _ => false
    })
    && (match belt_escalate_one_route(decision: ContinuationHold { reason: "awaits review" }) {
      EscalateRouteNotDue { detail } => detail.contains("holds")
      _ => false
    })
    && (match belt_escalate_one_route(decision: ContinuationRefused { reason: "the verdict does not decode" }) {
      EscalateRouteRefuse { reason } => reason == "the verdict does not decode"
      _ => false
    })
    && (match belt_escalate_one_route(decision: ContinuationSpawnFromPrior { origin: ContinueFromAttempt { parent_attempt_key: "a1", branch: "roadmap/n1/a1", turn: 4, verdict_detail: "nominal" } }) {
      EscalateRouteNotDue { detail } => detail.contains("already consumed")
      _ => false
    })
}

// THE ESCALATE AND INTEGRATE RECEIPTS RENDER THEIR OWN STATUSES, so a wake-up reader distinguishes
// convened, gate-no-op, not-due, integrated, blocked, deferred and unreadable without re-deriving.
test fn the_per_item_receipts_render_their_own_statuses() -> Bool {
  serialize_json(v: belt_escalate_one_result_json(r: EscalateOneConvened { unit: "gunbc-supervisor-n1-a1-t3.service" }))
    .contains("\"status\": \"convened\"")
    && serialize_json(v: belt_escalate_one_result_json(r: EscalateOneGateNoOp { step: "supervisor-convening", detail: "already convening" }))
      .contains("\"status\": \"gate-no-op\"")
    && serialize_json(v: belt_escalate_one_result_json(r: EscalateOneNotDue { detail: "nothing due" }))
      .contains("\"status\": \"not-due\"")
    && serialize_json(v: belt_integrate_one_result_json(r: IntegrationCoreIntegrated { project_key: "shell-typed-invocation" }))
      .contains("\"status\": \"integrated\"")
    && serialize_json(v: belt_integrate_one_result_json(r: IntegrationCoreIntegrated { project_key: "shell-typed-invocation" }))
      .contains("\"project\": \"shell-typed-invocation\"")
    && serialize_json(v: belt_integrate_one_result_json(r: IntegrationCoreBlocked { detail: "2 conflicting path(s)" }))
      .contains("\"status\": \"blocked\"")
    && serialize_json(v: belt_integrate_one_result_json(r: IntegrationCoreDeferred { reason: "no capture" }))
      .contains("\"status\": \"deferred\"")
    && serialize_json(v: belt_integrate_one_result_json(r: IntegrationCoreUnreadable { detail: "the envelope does not decode" }))
      .contains("\"status\": \"unreadable\"")
}

// ------------------------------------------------------------------------------------------------
// Blocker 2's load-bearing control, composed: an active systemd-held worker flows occurrence ->
// census -> decision -> spawn route, and NO spawn command is reachable.
// ------------------------------------------------------------------------------------------------

// THE SPAWN ROUTE OF EVERY NON-SPAWN DECISION IS NONE. Hold (worker running, verification owed),
// Complete (fully approved), Refused, PlanDefect and Stuck carry no origin and no escalation
// record, so the spawn fold has no spawn command to reach for; only the two spawn arms carry one.
test fn no_spawn_command_is_reachable_from_an_unresolved_lineage() -> Bool {
  let hold = belt_spawn_route_for_decision(decision: ContinuationHold { reason: "the prior attempt's worker has not ended" })
  let complete = belt_spawn_route_for_decision(decision: ContinuationComplete { reason: "the lineage is complete" })
  let refused = belt_spawn_route_for_decision(decision: ContinuationRefused { reason: "x" })
  let defect = belt_spawn_route_for_decision(decision: ContinuationPlanDefect { defect: "d" })
  let stuck = belt_spawn_route_for_decision(decision: ContinuationStuck { cause: "c" })
  let fresh = belt_spawn_route_for_decision(decision: ContinuationSpawnFresh { reason: "no prior" })
  let prior = belt_spawn_route_for_decision(decision: ContinuationSpawnFromPrior { origin: ContinueFromAttempt { parent_attempt_key: "a1", branch: "b", turn: 2, verdict_detail: "v" } })
  (match hold { SpawnRouteNone { step, detail: _ } => step == "continuation-hold"  _ => false })
    && (match complete { SpawnRouteNone { step, detail: _ } => step == "continuation-complete"  _ => false })
    && (match refused { SpawnRouteNone { step, detail: _ } => step == "continuation"  _ => false })
    && (match defect { SpawnRouteNone { step, detail: _ } => step == "supervisor-plan-defect"  _ => false })
    && (match stuck { SpawnRouteNone { step, detail: _ } => step == "supervisor-stuck"  _ => false })
    && (match fresh { SpawnRouteWorker { origin } => attempt_origin_turn(origin: origin) == 1  _ => false })
    && (match prior { SpawnRouteWorker { origin } => attempt_origin_turn(origin: origin) == 2  _ => false })
}

// THE COMPOSITION, END TO END OVER THE REAL PRODUCER: an active systemd attempt unit for node-a
// classifies through the occurrence population, occupies and refuses the node's launch at the
// census (AlreadyLive), and the same lineage's continuation decision (worker not terminal) is a
// Hold whose spawn route is None -- no worker spawn command is reachable anywhere in the chain.
test fn an_active_systemd_worker_blocks_the_launch_and_the_spawn_alike() -> Bool {
  let population = occurrence_population(
    containers: [ObservedContainerRow {
      container: AttemptContainerSystemdUnit { unit: "gunbc-attempt-node-a-cd172fe81b806160.service" },
      process: WorkerProcessRunning { command: "gunbc-harness" as NonEmptyStr },
    }],
    records: [DurableAttemptRecord { node: "node-a", attempt: "cd172fe81b806160", spawn_identity: "cause=timer" }],
  )
  let rows = fold(population, init: [], f: fn(acc, o) {
    match occurrence_census_row(o: o) {
      Absent => acc
      Present { value: row } => concat(acc, [row])
    }
  })
  let live_refusal = match launch_gate_live(sessions: LaunchSessionsObserved { live: rows }, node_id: "node-a") {
    GateRefused { refusal } =>
      match refusal {
        LaunchAlreadyLive { session_name: _ } => true
        _ => false
      }
    _ => false
  }
  let decision = continuation_decision(
    prior: Present { value: PriorAttemptFacts {
      node_id: "node-a",
      edges: [],
      attempt_key: "cd172fe81b806160",
      branch: "dispatch/node-a-acd172fe81b806160",
      worker_terminal: false,
      capture: CaptureAbsent,
      supervisor_verdict: SupervisorVerdictAbsent,
      verification: none,
      review: none,
      goal_audit: none,
    } },
    prior_turn: ContinuationTurnKnown { turn: 1 },
  )
  live_refusal
    && (match decision {
      ContinuationHold { reason: _ } =>
        match belt_spawn_route_for_decision(decision: decision) {
          SpawnRouteNone { step, detail: _ } => step == "continuation-hold"
          _ => false
        }
      _ => false
    })
}
