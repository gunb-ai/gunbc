    && band_key_for_label(label: "no_capacity") == "fail"
    && band_key_for_label(label: "cause_not_permitted_by_mode") == "fail"
    && band_key_for_label(label: "gate_not_evaluated") == "loud"
    && band_key_for_label(label: "session_liveness_unobserved") == "loud"
    && band_key_for_label(label: "deployed_revision_unobserved") == "loud"
    && band_key_for_label(label: "session_multiplicity_conflict") == "loud"
    && band_key_for_label(label: "deployment_transition_inhibited") == "loud"
    && band_key_for_label(label: "spawned") == "ok"
    && band_key_for_label(label: "already_live") == "ok"
    && band_key_for_label(label: "disabled") == "fail"
    && band_key_for_label(label: "node_not_found") == "fail"
    && band_key_for_label(label: "already_done_signed_off") == "fail"
    && band_key_for_label(label: "no_instance") == "fail"
    && band_key_for_label(label: "centering_absent") == "fail"
    && band_key_for_label(label: "operator_exclusive") == "fail"
    && band_key_for_label(label: "external_lead") == "fail"
    && band_key_for_label(label: "calendar_observation") == "fail"
    && band_key_for_label(label: "observe_refused") == "loud"
    && band_key_for_label(label: "authority_refused") == "loud"
