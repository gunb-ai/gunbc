      host_refusal: Present { value: LaunchSessionsUnobservable { reason: "belt_observe: tmux ls failed; session containers are unknowable" } },
      reconcile: belt_tick_empty_reconcile(state: ManualReady),
      spawn_outcomes: [],
      teardown_outcomes: [],
      commit_outcomes: [],
