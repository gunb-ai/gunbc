fn roadmap_belt_actuate_nid(s: String) -> RoadmapNodeId { s }

fn ready_node(id: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_RWT4XRCGS4GR90YZXK0Y" as RoadmapNodeIdentity,
    node: roadmap_belt_actuate_nid(s: id),
    line: DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
  }
}

fn live_session(node_id: String, verdict: ObservationVerdict) -> DispatchLiveSession {
  DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: verdict,
    worker: worker_observation_without_provider_probe(
      instance: dispatch_provider_instance_for_kind(kind: extdeps.llm.cli_lifecycle.CodexCliProvider),
    ),
  }
}

fn live_session_fat_with_process(
  node_id: String,
  process: WorkerProcessEvidence,
) -> DispatchLiveSession {
  DispatchLiveSession {
    session_name: "gunbc-dispatch-{node_id}",
    node_id: node_id,
    windows: 1,
    lease_verdict: Converged,
    worker: worker_observation_without_provider_probe_for_process(
      instance: dispatch_provider_instance_for_kind(kind: extdeps.llm.cli_lifecycle.CodexCliProvider),
      process: process,
    ),
  }
}

fn live_row_unobserved(node_id: String) -> LaunchCensusRow {
  LaunchCensusRow {
    session_name: join(["gunbc-dispatch-", node_id], ""),
    node_id: node_id,
    process: WorkerProcessUnobserved { reason: "tmux name presence does not observe pane liveness or exit" as NonEmptyStr },
  }
}

fn live_session_with_process(
  node_id: String,
  process: WorkerProcessEvidence,
) -> LaunchCensusRow {
  LaunchCensusRow {
    session_name: join(["gunbc-dispatch-", node_id], ""),
    node_id: node_id,
    process: process,
  }
}

fn is_exec_ok(o: BeltExecOutcome) -> Bool {
  match o {
    ExecOk { stdout: _ } => true
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn exec_ok_stdout_contains(o: BeltExecOutcome, pattern: String) -> Bool {
  match o {
    ExecOk { stdout: out } => string_contains(s: out, pattern: pattern)
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_failed(o: BeltExecOutcome) -> Bool {
  match o {
    ExecFailed { program: _, exit_code: _, stderr: _ } => true
    ExecOk { stdout: _ } => false
    ExecRefused { program: _, reason: _ } => false
  }
}

fn is_exec_refused(o: BeltExecOutcome) -> Bool {
  match o {
    ExecRefused { program: _, reason: _ } => true
    ExecOk { stdout: _ } => false
    ExecFailed { program: _, exit_code: _, stderr: _ } => false
  }
}

fn is_spawn_failed(o: BeltSpawnOutcome) -> Bool {
  match o {
    SpawnFailed { node_id: _, step: _, detail: _, provider: _, launch: _ } => true
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => false
    SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => false
    SpawnNotAdmitted { node_id: _, refusal: _ } => false
  }
}

fn is_teardown_failed(o: BeltTeardownOutcome) -> Bool {
  match o {
    TeardownFailed { session_name: _, detail: _ } => true
    ReapedSession { session_name: _ } => false
  }
}

test fn witness_exec_ok_runs_echo() -> Bool {
  let o = belt_exec(cmd: host_exec_argv(program: "echo", args: ["belt-ok"]), workdir: "/")
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "belt-ok")
}

test fn witness_exec_refuses_missing_program() -> Bool {
  let o = belt_exec(
    cmd: host_exec_argv(program: "belt-nonexistent-program-xyz", args: []),
    workdir: "/",
  )
  is_exec_refused(o: o)
}

test fn witness_exec_fails_on_nonzero_exit() -> Bool {
  let o = belt_exec(cmd: host_exec_argv(program: "false", args: []), workdir: "/")
  is_exec_failed(o: o)
}

test fn witness_exec_all_runs_every_step_when_ok() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "echo", args: ["first"]),
      host_exec_argv(program: "echo", args: ["second"]),
    ],
    workdir: "/",
  )
  is_exec_ok(o: o) && exec_ok_stdout_contains(o: o, pattern: "second")
}

test fn witness_exec_all_short_circuits_after_failure() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "false", args: []),
      host_exec_argv(program: "echo", args: ["should-not-run"]),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o) && !exec_ok_stdout_contains(o: o, pattern: "should-not-run")
}

test fn witness_exec_all_fails_on_later_step() -> Bool {
  let o = belt_exec_all(
    cmds: [
      host_exec_argv(program: "echo", args: ["ok"]),
      host_exec_argv(program: "false", args: []),
    ],
    workdir: "/",
  )
  is_exec_failed(o: o)
}

test fn witness_named_exec_steps_locate_the_first_failure() -> Bool {
  match belt_exec_steps(
    steps: [
      BeltExecStep {
        step: "prepare",
        command: host_exec_argv(program: "/usr/bin/true", args: []),
      },
      BeltExecStep {
        step: "tmux-event-pipe",
        command: host_exec_argv(program: "/usr/bin/false", args: []),
      },
      BeltExecStep {
        step: "provider-start",
        command: host_exec_argv(program: "/usr/bin/true", args: []),
      },
    ],
    workdir: "/",
  ) {
    ExecStepsOk => false
    ExecStepFailed { step, detail } =>
      step == "tmux-event-pipe"
        && string_contains(s: detail, pattern: "exit 1")
  }
}

test fn witness_spawn_member_refuses_observed_shape() -> Bool {
  let m = ObservedMember { node_id: "z", session: live_session(node_id: "z", verdict: Converged) }
  is_spawn_failed(o: belt_actuate_spawn_member(m: m, workdir: "/", launch: launch_identity_exemplar()))
}

// review 5059520727 finding 4: the admitted identity SURVIVES an actuation failure -- the failed
// outcome carries the exact LaunchIdentity the admission produced, so the route JSON, the tick
// receipt and the attempt state can all name the decision that led to the failed attempt.
test fn witness_identity_survives_actuation_failure() -> Bool {
  let m = ObservedMember { node_id: "z", session: live_session(node_id: "z", verdict: Converged) }
  let id = launch_identity_exemplar()
  match belt_actuate_spawn_member(m: m, workdir: "/", launch: id) {
    SpawnFailed { node_id: _, step, detail: _, provider: _, launch } =>
      step == "member-shape"
        && launch.node_id == id.node_id
        && launch.instance_id == id.instance_id
        && launch.revision == id.revision
    Spawned { node_id: _, session_name: _, provider: _, launch: _ } => false
    SupervisorConvened { node_id: _, unit: _, provider: _, launch: _ } => false
    SpawnNotAdmitted { node_id: _, refusal: _ } => false
  }
}

test fn witness_teardown_member_refuses_desired_shape() -> Bool {
  let m = DesiredMember { node_id: "a", node: ready_node(id: "a") }
  is_teardown_failed(o: belt_actuate_teardown_member(m: m))
}

fn observe_live_count(o: BeltObserve) -> Int {
  match o {
    BeltSessionsObserved { live: live } => count(live)
    ObserveRefused { reason: _ } => -1
  }
}

fn is_observe_refused(o: BeltObserve) -> Bool {
  match o {
    ObserveRefused { reason: _ } => true
    BeltSessionsObserved { live: _ } => false
  }
}

test fn witness_observe_parses_live_on_success() -> Bool {
  match classify_tmux_session_list(
    exit_ok: true,
    stdout: "gunbc-dispatch-a: 1 windows",
    stderr: "",
  ) {
    TmuxSessionsListed { entries } =>
      count(filter_dispatch_tmux_sessions(entries: entries)) == 1
    _ => false
  }
}

test fn witness_observe_empty_on_no_server() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no server running on /tmp/tmux-1000/default",
  )) == 0
}

test fn witness_observe_empty_on_no_sessions() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "no sessions",
  )) == 0
}

test fn witness_observe_empty_on_no_server_enoent() -> Bool {
  observe_live_count(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/srv1-green (No such file or directory)",
  )) == 0
}

test fn witness_observe_refuses_connection_refused() -> Bool {
  let stderr = "error connecting to /tmp/tmux-1000/srv1-green (Connection refused)"
  match belt_observe_from_result(success: false, stdout: "", stderr: stderr) {
    ObserveRefused { reason } => string_contains(s: reason, pattern: stderr)
    BeltSessionsObserved { live: _ } => false
  }
}

test fn witness_observe_refuses_permission_error() -> Bool {
  is_observe_refused(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "error connecting to /tmp/tmux-1000/default (Permission denied)",
  ))
}

test fn witness_observe_refuses_malformed_stdout() -> Bool {
  match belt_observe_from_result(
    success: true,
    stdout: "gunbc-dispatch-a: malformed\n",
    stderr: "",
  ) {
    ObserveRefused { reason } =>
      string_contains(s: reason, pattern: "stdout parse refused")
        && string_contains(s: reason, pattern: "malformed")
    BeltSessionsObserved { live: _ } => false
  }
}

test fn witness_observe_refuses_empty_stderr_failure() -> Bool {
  is_observe_refused(o: belt_observe_from_result(
    success: false,
    stdout: "",
    stderr: "",
  ))
}

fn uuid_char(u: String, i: Int) -> String {
  substring(s: u, start: i, end: i + 1)
}

test fn witness_uuid_deterministic() -> Bool {
  let a = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  let b = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  a == b
}

test fn witness_uuid_distinct_nodes() -> Bool {
  let a = belt_spawn_session_uuid(node_id: "node-a", probed_at: "2026-07-25T20:00:00Z")
  let b = belt_spawn_session_uuid(node_id: "node-b", probed_at: "2026-07-25T20:00:00Z")
  !(a == b)
}

test fn witness_uuid_rfc4122_shape() -> Bool {
  let u = belt_spawn_session_uuid(node_id: "5-regen-cutover", probed_at: "2026-07-25T20:00:00Z")
  string_length(s: u) == 36
    && uuid_char(u: u, i: 8) == "-"
    && uuid_char(u: u, i: 13) == "-"
    && uuid_char(u: u, i: 18) == "-"
    && uuid_char(u: u, i: 23) == "-"
    && uuid_char(u: u, i: 14) == "4"
    && uuid_char(u: u, i: 19) == "8"
}

fn is_node_found(l: BeltNodeLookup) -> Bool {
  match l {
    NodeFound { node: _ } => true
    NodeMissing => false
    AuthorityProjectionRefused { detail: _ } => false
  }
}

test fn witness_find_node_hits() -> Bool {
  is_node_found(l: belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "b"))
}

test fn witness_find_node_misses() -> Bool {
  !is_node_found(l: belt_find_node_in(nodes: [ready_node(id: "a"), ready_node(id: "b")], node_id: "z"))
}

fn owned_node(id: String, owner: String) -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_F2RWDMNTDKS0ZR1P4VNZ" as RoadmapNodeIdentity,
    node: roadmap_belt_actuate_nid(s: id),
    line: DerivableLine { prs: [1], title: id, description: "" },
    carriers: [],
    sizing: Sized { intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc", acceptance: PrsMerged },
    execution: ExecutionContractUnspecified,
    owner: owner,
    signoff: Unsigned,
  }
}

fn found_owner(l: BeltNodeLookup) -> String {
  match l {
    NodeFound { node: n } => n.owner
    NodeMissing => ""
    AuthorityProjectionRefused { detail: _ } => ""
  }
}

test fn witness_find_node_first_wins_on_duplicate() -> Bool {
  found_owner(l: belt_find_node_in(
    nodes: [owned_node(id: "dup", owner: "first"), owned_node(id: "dup", owner: "second")],
    node_id: "dup",
  )) == "first"
}

// LIVENESS IS DERIVED FROM PROCESS EVIDENCE, NOT FROM A SESSION NAME. The prior pair of
// witnesses asserted that a session row matching the node id IS live, over a helper whose worker
// evidence is the placeholder whose own reason reads "tmux name presence does not observe pane
// liveness or exit". They pinned the defect: a retained dead pane answered live, DispatchAlreadyLive
// returned through the accepted band, and the operator got a positive acknowledgement with no
// agent. RLM-1 re-homed the per-node verdict into the shared launch admission's no-live-attempt
// gate (launch_gate_live); these witnesses follow it.
fn live_gate(live: List<LaunchCensusRow>, node_id: String) -> LaunchGateVerdict {
  launch_gate_live(sessions: LaunchSessionsObserved { live: live }, node_id: node_id)
}

test fn witness_node_session_running_is_live() -> Bool {
  match live_gate(
    live: [live_session_with_process(
      node_id: "a",
      process: WorkerProcessRunning { command: "codex" as NonEmptyStr },
    )],
    node_id: "a",
  ) {
    GateRefused { refusal } => match refusal { LaunchAlreadyLive { session_name: sn } => sn == "gunbc-dispatch-a" _ => false }
    _ => false
  }
}

test fn witness_node_session_absent_is_not_live() -> Bool {
  match live_gate(
    live: [live_session_with_process(
      node_id: "a",
      process: WorkerProcessRunning { command: "codex" as NonEmptyStr },
    )],
    node_id: "b",
  ) {
    GatePassed => true
    _ => false
  }
}

// THE DISCRIMINATING RED for the dead-pane defect: a present session whose pane exited is
// NOT live, so it cannot answer AlreadyLive -- and it cannot pass either.
test fn witness_retained_dead_pane_is_not_live() -> Bool {
  match live_gate(
    live: [live_session_with_process(
      node_id: "a",
      process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    )],
    node_id: "a",
  ) {
    GateRefused { refusal } => match refusal { LaunchStaleSession { session_name: _, detail: _ } => true _ => false }
    _ => false
  }
}

// The honest third state refuses in BOTH directions: it is not live (so it never reports a
// running agent) and it is not the absent path either.
test fn witness_unobserved_liveness_is_not_live() -> Bool {
  match live_gate(
    live: [live_row_unobserved(node_id: "a")],
    node_id: "a",
  ) {
    GateRefused { refusal } => match refusal { LaunchLivenessUnobserved { session_name: _, reason: _ } => true _ => false }
    _ => false
  }
}

test fn witness_session_liveness_is_four_valued() -> Bool {
  let running = live_gate(
    live: [live_session_with_process(
      node_id: "a",
      process: WorkerProcessRunning { command: "codex" as NonEmptyStr },
    )],
    node_id: "a",
  )
  let dead = live_gate(
    live: [live_session_with_process(
      node_id: "a",
      process: WorkerProcessExited { exit_code: 3, last_command: "codex" },
    )],
    node_id: "a",
  )
  let unobserved = live_gate(
    live: [live_row_unobserved(node_id: "a")],
    node_id: "a",
  )
  let absent = live_gate(live: [], node_id: "a")
  (match running { GateRefused { refusal } => match refusal { LaunchAlreadyLive { session_name: _ } => true _ => false } _ => false })
    && (match dead { GateRefused { refusal } => match refusal { LaunchStaleSession { session_name: _, detail: d } => string_contains(s: d, pattern: "status 3") _ => false } _ => false })
    && (match unobserved { GateRefused { refusal } => match refusal { LaunchLivenessUnobserved { session_name: _, reason: _ } => true _ => false } _ => false })
    && (match absent { GatePassed => true _ => false })
}

fn not_admitted(r: LaunchRefusal) -> BeltSpawnOutcome {
  SpawnNotAdmitted { node_id: "a", refusal: r }
}

// The stale and unobserved arms must never reach the ok band — an accepted no-op is the
// failure this change exists to remove, and the band is the single ok-authority.
test fn witness_stale_session_is_never_ok() -> Bool {
  !belt_dispatch_result_ok(r: not_admitted(r: LaunchStaleSession { session_name: "s", detail: "d" }))
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchLivenessUnobserved { session_name: "s", reason: "r" }))
    && belt_dispatch_status_label(r: not_admitted(r: LaunchStaleSession { session_name: "s", detail: "d" })) == "stale_session"
}

test fn witness_dispatch_result_ok_spawned_and_live() -> Bool {
  belt_dispatch_result_ok(r: Spawned { node_id: "a", session_name: "gunbc-dispatch-a", provider: "codex", launch: launch_identity_exemplar() })
    && belt_dispatch_result_ok(r: not_admitted(r: LaunchAlreadyLive { session_name: "gunbc-dispatch-a" }))
}

test fn witness_dispatch_result_refusals_not_ok() -> Bool {
  !belt_dispatch_result_ok(r: not_admitted(r: LaunchInstanceActuationRefused { instance_id: "preview", reason: "observe-only" }))
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchNodeUnknown))
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchAlreadyAccepted))
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchSessionsUnobservable { reason: "x" }))
    && !belt_dispatch_result_ok(r: SpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex", launch: launch_identity_exemplar() })
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchDependenciesBlocked { blockers: ["p"] }))
    && !belt_dispatch_result_ok(r: not_admitted(r: LaunchNoCapacity { occupied: 3, max_concurrent: 3 }))
}

fn status_label_glued_to_ok(r: BeltSpawnOutcome) -> Bool {
  let ok = belt_dispatch_result_ok(r: r)
  let label_in_ok_set = any(belt_dispatch_ok_status_labels(), l => l == belt_dispatch_status_label(r: r))
  ok == label_in_ok_set
}

test fn witness_dispatch_status_labels_glued_to_ok_set() -> Bool {
  status_label_glued_to_ok(r: Spawned { node_id: "a", session_name: "s", provider: "codex", launch: launch_identity_exemplar() })
    && status_label_glued_to_ok(r: not_admitted(r: LaunchAlreadyLive { session_name: "s" }))
    && status_label_glued_to_ok(r: not_admitted(r: LaunchInstanceActuationRefused { instance_id: "preview", reason: "observe-only" }))
    && status_label_glued_to_ok(r: not_admitted(r: LaunchNodeUnknown))
    && status_label_glued_to_ok(r: not_admitted(r: LaunchAlreadyAccepted))
    && status_label_glued_to_ok(r: not_admitted(r: LaunchSessionsUnobservable { reason: "x" }))
    && status_label_glued_to_ok(r: SpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex", launch: launch_identity_exemplar() })
    && all(belt_dispatch_result_exemplars(), r => status_label_glued_to_ok(r: r))
}

test fn witness_dispatch_status_labels_pin_wire_contract() -> Bool {
  belt_dispatch_status_label(r: Spawned { node_id: "a", session_name: "s", provider: "codex", launch: launch_identity_exemplar() }) == "spawned"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchAlreadyLive { session_name: "s" })) == "already_live"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchInstanceActuationRefused { instance_id: "preview", reason: "observe-only" })) == "disabled"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchNodeUnknown)) == "node_not_found"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchAlreadyAccepted)) == "already_done_signed_off"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchSessionsUnobservable { reason: "x" })) == "observe_refused"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchAuthorityUnobserved { detail: "x" })) == "authority_refused"
    && belt_dispatch_status_label(r: SpawnFailed { node_id: "a", step: "git", detail: "x", provider: "codex", launch: launch_identity_exemplar() }) == "spawn_failed"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchDependenciesBlocked { blockers: ["p"] })) == "dependencies_blocked"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchExecutionContractMissing { reason: "r" })) == "execution_contract_missing"
    && belt_dispatch_status_label(r: not_admitted(r: LaunchCauseNotPermitted { cause: gunbc.roadmap_launch_admission.Timer, mode: ManualReady })) == "cause_not_permitted_by_mode"
}

test fn witness_fresh_spawn_wire_names_selected_provider() -> Bool {
  string_contains(
    s: serialize_json(v: belt_spawn_outcome_json(
      o: Spawned { node_id: "a", session_name: "s", provider: "codex", launch: launch_identity_exemplar() })),
    pattern: "\"provider\": \"codex\"")
    && string_contains(
      s: serialize_json(v: belt_spawn_outcome_json(
        o: SpawnFailed { node_id: "a", step: "codex-auth", detail: "not logged in", provider: "codex", launch: launch_identity_exemplar() })),
      pattern: "\"provider\": \"codex\"")
}

fn band_key_for_label(label: String) -> String {
  let hit = belt_dispatch_label_band_rows() |> filter(row => row.wire_label == label) |> first
  match hit {
    Present { value: row } => row.band_key
    Absent => "band-row-missing"
  }
}

