    progress: completed_attempt_progress(node_id: "pres-unreadable-node"),
    tick_read: BeltTickReceiptUnreadable { reason: "belt tick receipt schema is unknown" },
  )
  string_contains(s: detail, pattern: "Verification blocked · belt tick receipt unreadable: ")
    && string_contains(s: detail, pattern: "schema is unknown")
}

