module test.claim.roadmap.privileged_helper_closure_witness

import std.types { String, List }
import std.algebra { FreeMonoid, contains }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.text { string_eq }
import v2.lens.module_graph {
  ModuleDeclarationFact,
  ModuleDependencyEdge,
  dependency_closure,
  import_closure_live
}
import gunbc.roadmap.privileged_helper_closure { privileged_helper_closure_excludes_forbidden }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// The exclusion is judged at one interface: a closure (a list of paths) in, a verdict out. The RED is
// authorable as supplied fixture edges, because the forbidden state is "an entry whose import chain
// reaches the dispatch actuator", which a fixture graph can describe though the accepted corpus no
// longer does. The pairing obligation (DESIGN section 3) is the last test: the real helper entry's
// live closure, so deleting the split makes a control fail.
data fixture_nodes: List<ModuleDeclarationFact> = [
  ModuleDeclarationFact { module: "fx.root_split", path: "fx/root_split.dag" },
  ModuleDeclarationFact { module: "fx.confinement", path: "fx/confinement.dag" },
  ModuleDeclarationFact { module: "fx.root_bad", path: "fx/root_bad.dag" },
  ModuleDeclarationFact { module: "fx.mid", path: "fx/mid.dag" },
  ModuleDeclarationFact { module: "gunbc.roadmap.roadmap_dispatch_actuator", path: "dag/gunbc/roadmap/roadmap_dispatch_actuator.dag" }
]

data fixture_edges: List<ModuleDependencyEdge> = [
  ModuleDependencyEdge { path: "fx/root_split.dag", target_module: "fx.confinement", target_declared: true },
  ModuleDependencyEdge { path: "fx/root_bad.dag", target_module: "fx.mid", target_declared: true },
  ModuleDependencyEdge { path: "fx/mid.dag", target_module: "gunbc.roadmap.roadmap_dispatch_actuator", target_declared: true }
]

fn fixture_closure(entry: String) -> FreeMonoid<String> {
  dependency_closure(entry_path: entry, edges: fixture_edges, nodes: fixture_nodes)
}

// RED: a root entry that reaches the actuator through an intermediate module is refused.
test fn a_root_entry_that_reaches_the_dispatch_actuator_is_refused() -> Bool {
  !privileged_helper_closure_excludes_forbidden(closure: fixture_closure(entry: "fx/root_bad.dag"))
}

// POSITIVE CONTROL: a split root entry that imports only the confinement module passes.
test fn a_root_entry_that_imports_only_the_confinement_module_is_admitted() -> Bool {
  privileged_helper_closure_excludes_forbidden(closure: fixture_closure(entry: "fx/root_split.dag"))
}

// INHABITANCE: the real helper entry's live import closure excludes the named set, and the control
// proves the walk reaches the confinement module at all (a walk that returned nothing would pass the
// exclusion vacuously).
test fn the_real_launch_helper_closure_excludes_the_dispatch_brain() -> Bool {
  let closure = import_closure_live(
    entry_path: "dag/gunbc/roadmap/attempt_system_unit_launch.dag",
    pool_roots: ["dag", "src/v2"]
  )
  privileged_helper_closure_excludes_forbidden(closure: closure)
    && contains(xs: closure, item: "dag/gunbc/roadmap/dispatch_worker_unit_confinement.dag", eq: string_eq)
}
