// THE WITNESSES FOR THE ITEM-LEVEL GANTT: every node listed with its estimate source and a state a reader can act
// on, an unsized node never priced at zero or at a default, a derived parent never drawn as a peer of its own
// children, prerequisites gating starts, and the whole roadmap answered at the read.
//
// THE CONTROLS THE ROW PROMISES, one per witness, plus the two that keep the grain honest: an item that owns pieces
// takes its elapsed from the LEAF scheduler's own answer and nothing else, and a contradiction refuses the picture
// rather than being drawn around.
module test.claim.roadmap.roadmap_item_gantt_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Optional, Present, Absent }
import std.algebra { list_push }
import extdeps.units.iso8601_calendar { Iso8601CivilDate }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapNodeIdentity, RoadmapNode, RoadmapEdge, Pointer, NodeParent, MemberOf, AdmittedRoot, NotDispatchable }
import gunbc.roadmap.roadmap_status { TicketLine, TicketFields }
import gunbc.roadmap.roadmap_authority { declared_roadmap_nodes, nid, edge }
import gunbc.roadmap.roadmap_belt { BeltCapacity }
import gunbc.roadmap.roadmap_decomposition { WorkDecomposition, WorkStage, WorkPiece, StageDependency, decomposition_for, expand_decomposition, roadmap_decompositions, decomposition, leaf, Join }
import gunbc.roadmap.roadmap_schedule { schedule, Scheduled, NotScheduled }
import gunbc.roadmap.roadmap_schedule_calendar { bound_day_to_date }
import gunbc.roadmap.roadmap_effort_estimate { EstimateEntry, estimate_row, estimate_recorded, days_estimate, d }
import gunbc.roadmap.roadmap_estimate_derivation { node_by_slug, UnsizedWhy, NothingEstimated, ContainedChildUnsized }
import gunbc.roadmap.roadmap_item_gantt {
  GanttInput, GanttAnswer, GanttRow, GanttRowState, GanttRefusal, gantt_answer, gantt_answer_live, gantt_rows,
  gantt_refusal, gantt_unpriced_count,
  GanttAnswered, GanttContradictionsPresent, GanttNoWorkers, RowBlocked, RowLeafGrainRefused, RowNoFindingsCount, RowPlaced, RowRollup, RowUnplaced, RowUnsized,
  GanttRefused, BlockedCause, NotEstimated, RollupBelow, PiecesRefused, PiecesFindingsCount, PiecesZeroDays, BlockedBelow,
  WaitsOnItsOwnContainer,
}

// ============================== THE FIXTURE ==============================

// THE FIXTURE IS SYNTHETIC AND SUPPLIED WHOLE: the nodes, the edges, the entries and the decomposition table are all
// arguments of the read, never globals it reaches for. The shape is the three-level containment chain the derivation
// witnesses use -- a project, a milestone under it, three pieces of work under the milestone -- under fixture slugs,
// so a control says the same thing on the day a production row gains an estimate or a decomposition. A control that
// filtered the declared roadmap by real slug and asserted "these are unpriced" would be asserting whatever production
// happens to be that day; that is the brittleness this avoids. The two live controls at the bottom of this file are
// the deliberate exception: they exist to answer over the DECLARED roadmap, and they pass the DECLARED table.
fn fixture_fields(headline: String) -> TicketFields {
  TicketFields {
    headline: headline,
    brief: "witness fixture: containment only, no delivery claim",
    displaced_cost: "fixture displaced cost",
    current_state: "fixture current state",
    first_slice: "fixture first slice",
    red_control: "fixture red control",
    out_of_scope: "fixture out of scope",
    handback: "fixture handback",
    updates: [],
    authored_on: "",
    last_verified_on: "",
  }
}

fn fixture_node(slug: String, parent: NodeParent?) -> RoadmapNode {
  RoadmapNode {
    identity: join(["fixture_identity_", slug], "") as RoadmapNodeIdentity,
    node: slug as RoadmapNodeId,
    line: TicketLine { ticket: fixture_fields(headline: slug) },
    carriers: [] as List<Pointer>,
    dispatch: NotDispatchable,
    execution: ExecutionContractUnspecified,
    owner: "item-gantt-fixture",
    parent: parent,
    centering: none,
  }
}

fn fixture_under(project: String) -> NodeParent? {
  Present { value: MemberOf { project: project, contribution: "fixture containment" as NonEmptyStr } }
}

fn fixture_nodes() -> List<RoadmapNode> {
  [
    fixture_node(slug: "fixture-payoff", parent: AdmittedRoot),
    fixture_node(slug: "fixture-milestone", parent: fixture_under(project: "fixture-payoff")),
    fixture_node(slug: "fixture-leaf-a", parent: fixture_under(project: "fixture-milestone")),
    fixture_node(slug: "fixture-leaf-b", parent: fixture_under(project: "fixture-milestone")),
    fixture_node(slug: "fixture-leaf-c", parent: fixture_under(project: "fixture-milestone")),
  ]
}

fn node_of(slug: String) -> Optional<RoadmapNode> {
  node_by_slug(nodes: fixture_nodes(), slug: slug)
}

fn planted(slug: String, days: Int) -> EstimateEntry {
  match node_of(slug: slug) {
    Absent => estimate_recorded(row: estimate_row(
      subject: "rn_01FIXTURENODEABSENT" as RoadmapNodeIdentity,
      made: read_date(),
      value: days_estimate(working_days: days),
      basis: "witness fixture: a fixture node was missing",
    ))
    Present { value: n } => estimate_recorded(row: estimate_row(
      subject: n.identity,
      made: read_date(),
      value: days_estimate(working_days: days),
      basis: "witness fixture: planted duration",
    ))
  }
}

fn read_date() -> Iso8601CivilDate { d(y: 2026, m: 11, day: 19) }

fn lanes(count: Int) -> BeltCapacity { BeltCapacity { max_concurrent: count } }

// A FIXTURE READ: the empty pieces table, because no fixture item owns pieces. The decomposition table is an
// argument of the read (see GanttInput.pieces), which is what makes "prices none" a fact about the input.
fn read(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, entries: List<EstimateEntry>) -> GanttAnswer {
  read_with_pieces(nodes: nodes, edges: edges, entries: entries, pieces: [] as List<WorkDecomposition>)
}

fn read_with_pieces(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, entries: List<EstimateEntry>, pieces: List<WorkDecomposition>) -> GanttAnswer {
  gantt_answer(input: GanttInput {
    nodes: nodes,
    edges: edges,
    entries: entries,
    pieces: pieces,
    workers: lanes(3),
    findings_count: 1,
    read_date: read_date(),
  })
}

fn row_of(a: GanttAnswer, slug: String) -> Optional<GanttRow> {
  match node_of(slug: slug) {
    Absent => Absent
    Present { value: n } => match filter(gantt_rows(a: a), r => r.node == n.node) {
      Empty => Absent
      Cons { head: r, tail: _ } => Present { value: r }
    }
  }
}

fn placed_days(r: Optional<GanttRow>) -> Optional<Int> {
  match r {
    Absent => Absent
    Present { value: row } => match row.state {
      RowPlaced { start_day: s, finish_day: f, lane: _, start: _, finish: _ } => Present { value: f - s }
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => Absent
      RowUnsized { why: _ } => Absent
      RowBlocked { behind: _ } => Absent
      RowLeafGrainRefused { cause: _ } => Absent
      RowUnplaced => Absent
      RowNoFindingsCount { count: _ } => Absent
    }
  }
}

// ============================== THE ANSWER OVER EVERY NODE ==============================

// NOTHING IS PRICED: the read still answers, every node is LISTED, and no row carries a duration. This is the red
// control against the cheapest possible bug -- defaulting an unsized node to zero days and drawing it as free work.
test fn an_unpriced_roadmap_lists_every_node_and_prices_none() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [] as List<EstimateEntry>)
  match a {
    GanttAnswered { rows: rows, horizon: h, in_flight: _, critical: _ } => count(rows) == 5
      && h == 0
      && count(filter(rows, r => match r.work_days { Present { value: _ } => true, Absent => false })) == 0
      && gantt_unpriced_count(a: a) == 5
    GanttRefused { refusal: _ } => false
  }
}

// A PRICED LEAF IS PLACED, and its days bind to dates through the SAME calendar the leaf grain binds with
// (gunbc.roadmap.roadmap_schedule_calendar), so one calendar answers both grains and no date is authored anywhere.
test fn a_priced_leaf_is_placed_and_its_days_bind_to_dates() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [planted(slug: "fixture-leaf-a", days: 10)])
  match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: row } => match row.state {
      RowPlaced { start_day: s, finish_day: f, lane: l, start: sd, finish: fd } => s == 0 && f == 10 && l == 0
        && sd == bound_day_to_date(read_date: read_date(), day: s)
        && fd == bound_day_to_date(read_date: read_date(), day: f)
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowUnsized { why: _ } => false
      RowBlocked { behind: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// TWO INDEPENDENT LEAVES UNDER THREE WORKERS START TOGETHER on different lanes: the worker count is the belt's own
// capacity type, the same one the leaf scheduler is given, so the two grains cannot disagree about what "three
// workers" means.
test fn independent_leaves_start_together_on_different_lanes() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 12),
  ])
  match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: x } => match row_of(a: a, slug: "fixture-leaf-b") {
      Absent => false
      Present { value: y } => match x.state {
        RowPlaced { start_day: xs, finish_day: _, lane: xl, start: _, finish: _ } => match y.state {
          RowPlaced { start_day: ys, finish_day: _, lane: yl, start: _, finish: _ } => xs == 0 && ys == 0 && xl != yl
          RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
          RowUnsized { why: _ } => false
          RowBlocked { behind: _ } => false
          RowLeafGrainRefused { cause: _ } => false
          RowUnplaced => false
          RowNoFindingsCount { count: _ } => false
        }
        RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
        RowUnsized { why: _ } => false
        RowBlocked { behind: _ } => false
        RowLeafGrainRefused { cause: _ } => false
        RowUnplaced => false
        RowNoFindingsCount { count: _ } => false
      }
    }
  }
}

// A PREREQUISITE GATES A START: B waits on A, so B cannot open before A closes -- and both keep their own price,
// which is the whole point of containment-only rollup. Ordering is the only thing an edge is allowed to do here
// (gunbc.design_ruling::planning_scheduling_is_cut: a date or an estimate is never a gate; a waiting relation is).
test fn a_prerequisite_delays_the_task_that_waits_on_it() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [edge(child: "fixture-leaf-b", parent: "fixture-leaf-a")], entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 12),
  ])
  match placed_days(r: row_of(a: a, slug: "fixture-leaf-b")) {
    Present { value: d1 } => d1 == 12 && start_of(a: a, slug: "fixture-leaf-b") == 10
    Absent => false
  }
}

fn start_of(a: GanttAnswer, slug: String) -> Int {
  match row_of(a: a, slug: slug) {
    Absent => -1
    Present { value: row } => match row.state {
      RowPlaced { start_day: s, finish_day: _, lane: _, start: _, finish: _ } => s
      RowRollup { start_day: s, finish_day: _, start: _, finish: _ } => s
      RowUnsized { why: _ } => -1
      RowBlocked { behind: _ } => -1
      RowLeafGrainRefused { cause: _ } => -1
      RowUnplaced => -1
      RowNoFindingsCount { count: _ } => -1
    }
  }
}

// A ROW WAITING ON SOMETHING UNPRICED IS BLOCKED AND NAMES IT, rather than being placed at day 0 as if the missing
// price were a missing dependency: the start this read cannot earn is not drawn.
test fn a_task_waiting_on_an_unpriced_task_is_blocked_and_named() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [edge(child: "fixture-leaf-a", parent: "fixture-leaf-c")], entries: [
    planted(slug: "fixture-leaf-a", days: 10),
  ])
  match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: row } => match row.state {
      // TYPED, per key: the cause is the derivation's own `UnsizedWhy`, so the page can turn this key into a sizing
      // task naming the slug instead of parsing a sentence. fixture-leaf-c has nothing beneath it, so the reason is
      // NothingEstimated -- not a prose "it looks unpriced".
      RowBlocked { behind: b } => count(filter(b, c => match c {
        NotEstimated { node: n, why: why } => n == nid(s: "fixture-leaf-c") && match why {
          NothingEstimated => true
          ContainedChildUnsized { child: _ } => false
        }
        NotEstimated { node: _, why: ContainedChildUnsized { child: _ } } => false
        RollupBelow { node: _, work_days: _ } => false
        PiecesRefused { node: _, cause: _ } => false
        PiecesFindingsCount { node: _, count: _ } => false
        PiecesZeroDays { node: _ } => false
        BlockedBelow { node: _ } => false
        WaitsOnItsOwnContainer { node: _, container: _ } => false
      })) == 1
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowUnsized { why: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// A DEPENDENT OF AN EMPTY MILESTONE IS BLOCKED, AND THE CAUSE IS THE NO-PRICED-DESCENDANTS ONE. The milestone under
// test has nothing beneath it at all, so its own source is Unsized { why: NothingEstimated } -- the exact variant the
// planning page turns into "go price this", with the slug in it. Not NoPricedDescendants-as-prose, and not a silent
// RowUnplaced that hides which key is missing.
test fn an_empty_milestone_blocks_its_dependent_naming_the_no_priced_descendants_cause() -> Bool {
  let nodes = list_push(xs: fixture_nodes(), item: fixture_node(slug: "fixture-empty-milestone", parent: fixture_under(project: "fixture-payoff")))
  let a = read(nodes: nodes, edges: [edge(child: "fixture-leaf-a", parent: "fixture-empty-milestone")], entries: [
    planted(slug: "fixture-leaf-a", days: 10),
  ])
  match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: row } => match row.state {
      RowBlocked { behind: b } => count(filter(b, c => match c {
        NotEstimated { node: n, why: why } => n == nid(s: "fixture-empty-milestone") && match why {
          NothingEstimated => true
          ContainedChildUnsized { child: _ } => false
        }
        NotEstimated { node: _, why: ContainedChildUnsized { child: _ } } => false
        RollupBelow { node: _, work_days: _ } => false
        PiecesRefused { node: _, cause: _ } => false
        PiecesFindingsCount { node: _, count: _ } => false
        PiecesZeroDays { node: _ } => false
        BlockedBelow { node: _ } => false
        WaitsOnItsOwnContainer { node: _, container: _ } => false
      })) == 1
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowUnsized { why: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// AN EDGE AGAINST ITS OWN CONTAINMENT IS A CONTRADICTION, NOT A SCHEDULE. leaf-a sits INSIDE payoff and an edge also
// says it waits on payoff: a container's bar is drawn over the rows it contains, so a row cannot wait on what contains
// it. Expanded through containment that edge is leaf-a waiting on leaf-a -- so leaf-a gets no bar and names BOTH
// sides, its dependents are blocked as behind anything unplaced, and the rest of the read still places: one bad edge
// in the authority data must not blank the timeline for every other item.
test fn a_row_ordered_behind_its_own_container_is_blocked_by_name_while_the_read_still_answers() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [
    edge(child: "fixture-leaf-a", parent: "fixture-payoff"),
    edge(child: "fixture-leaf-c", parent: "fixture-leaf-a"),
  ], entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 5),
    planted(slug: "fixture-leaf-c", days: 3),
  ])
  let answered = match gantt_refusal(a: a) {
    Absent => true
    Present { value: _ } => false
  }
  let contradicted = match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: row } => match row.state {
      RowBlocked { behind: b } => count(filter(b, c => match c {
        WaitsOnItsOwnContainer { node: n, container: cn } => n == nid(s: "fixture-leaf-a") && cn == nid(s: "fixture-payoff")
        NotEstimated { node: _, why: _ } => false
        RollupBelow { node: _, work_days: _ } => false
        PiecesRefused { node: _, cause: _ } => false
        PiecesFindingsCount { node: _, count: _ } => false
        PiecesZeroDays { node: _ } => false
        BlockedBelow { node: _ } => false
      })) == 1
      _ => false
    }
  }
  let dependent = match row_of(a: a, slug: "fixture-leaf-c") {
    Absent => false
    Present { value: row } => match row.state {
      RowBlocked { behind: _ } => true
      _ => false
    }
  }
  let untouched = match row_of(a: a, slug: "fixture-leaf-b") {
    Absent => false
    Present { value: row } => match row.state {
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => true
      _ => false
    }
  }
  answered && contradicted && dependent && untouched
}

// AN UNPRICED CONTAINER IS NOT TOTALLED FROM THE CHILDREN IT HAPPENS TO HAVE. payoff contains milestone, milestone
// has a child with no price, so neither container is priced -- and the one that stopped short NAMES the child that
// stopped it, instead of drawing a bar over work it never counted.
test fn an_unpriced_container_names_the_child_that_stops_it_being_totalled() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [
    planted(slug: "fixture-leaf-a", days: 10),
  ])
  match row_of(a: a, slug: "fixture-payoff") {
    Absent => false
    Present { value: row } => match row.state {
      RowUnsized { why: why } => match why {
        ContainedChildUnsized { child: c } => c == nid(s: "fixture-milestone")
        NothingEstimated => false
      }
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowBlocked { behind: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// THE GATE IS TRANSITIVE, AND THE SECOND ROW KNOWS IT. leaf-a waits on leaf-b, leaf-b waits on the unsized leaf-c.
// leaf-b is PRICED -- it simply cannot be placed -- so leaf-a's cause is not "leaf-b is unpriced" (it isn't) but
// BlockedBelow, naming the key whose own placement this read could not earn. A chain is followed, not flattened into a
// gap.
test fn a_dependent_of_a_blocked_row_is_blocked_naming_it_as_blocked_below() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [
    edge(child: "fixture-leaf-a", parent: "fixture-leaf-b"),
    edge(child: "fixture-leaf-b", parent: "fixture-leaf-c"),
  ], entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 12),
  ])
  match row_of(a: a, slug: "fixture-leaf-a") {
    Absent => false
    Present { value: row } => match row.state {
      RowBlocked { behind: b } => count(filter(b, c => match c {
        BlockedBelow { node: n } => n == nid(s: "fixture-leaf-b")
        NotEstimated { node: _, why: why } => match why {
          NothingEstimated => false
          ContainedChildUnsized { child: _ } => false
        }
        RollupBelow { node: _, work_days: _ } => false
        PiecesRefused { node: _, cause: _ } => false
        PiecesFindingsCount { node: _, count: _ } => false
        PiecesZeroDays { node: _ } => false
        WaitsOnItsOwnContainer { node: _, container: _ } => false
      })) == 1
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowUnsized { why: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// THE UNSIZED NODE BESIDE A PRICED ONE keeps its own state: the priced leaf is drawn and its unpriced sibling is
// listed, so an answer never quietly drops the work nobody looked at.
test fn an_unpriced_sibling_is_listed_beside_a_placed_one() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 12),
  ])
  match row_of(a: a, slug: "fixture-leaf-c") {
    Absent => false
    Present { value: row } => match row.state {
      RowUnsized { why: _ } => match row.work_days { Absent => true, Present { value: _ } => false }
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
      RowBlocked { behind: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// A DERIVED PARENT IS NEVER PLACED BESIDE ITS OWN CHILDREN: it carries no lane and no work of its own, and its bar
// spans the work beneath it. Placing a parent as a peer of its children would spend the same days twice, which is
// the same double-representation the ruling forbids on the pricing side.
test fn a_derived_parent_spans_its_children_and_holds_no_lane() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [
    planted(slug: "fixture-leaf-a", days: 10),
    planted(slug: "fixture-leaf-b", days: 12),
    planted(slug: "fixture-leaf-c", days: 8),
  ])
  match row_of(a: a, slug: "fixture-milestone") {
    Absent => false
    Present { value: row } => match row.state {
      RowRollup { start_day: s, finish_day: f, start: _, finish: _ } => s == 0 && f == 12
      RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
      RowUnsized { why: _ } => false
      RowBlocked { behind: _ } => false
      RowLeafGrainRefused { cause: _ } => false
      RowUnplaced => false
      RowNoFindingsCount { count: _ } => false
    }
  }
}

// ============================== THE REFUSALS ==============================

// A CONTRADICTION REFUSES THE WHOLE PICTURE, naming both sides: a bar drawn over an estimate that contradicts its own
// child is a picture, not a schedule, so the read reports it instead (the operator's own 1w-over-2w case, with the
// refusal the ruling demands).
test fn a_contradiction_refuses_the_whole_picture_by_name() -> Bool {
  let a = read(nodes: fixture_nodes(), edges: [] as List<RoadmapEdge>, entries: [
    planted(slug: "fixture-milestone", days: 5),
    planted(slug: "fixture-leaf-a", days: 10),
  ])
  match gantt_refusal(a: a) {
    Absent => false
    Present { value: refusal } => match refusal {
      GanttContradictionsPresent { contradictions: clashes } => count(clashes) == 1
        && match first(clashes) {
          Absent => false
          Present { value: c } => c.ancestor == nid(s: "fixture-milestone") && c.descendant == nid(s: "fixture-leaf-a")
        }
      _ => false
    }
  }
}

// NO WORKERS, NO ANSWER: zero capacity is a refusal naming the capacity it was given, not a schedule that puts
// everything on lane zero and calls it concurrent.
test fn a_read_with_no_workers_refuses_naming_the_capacity() -> Bool {
  let a = gantt_answer(input: GanttInput {
    nodes: fixture_nodes(),
    edges: [] as List<RoadmapEdge>,
    entries: [planted(slug: "fixture-leaf-a", days: 10)],
    pieces: [] as List<WorkDecomposition>,
    workers: lanes(0),
    findings_count: 1,
    read_date: read_date(),
  })
  match gantt_refusal(a: a) {
    Absent => false
    Present { value: refusal } => match refusal {
      GanttNoWorkers { cap: c } => c.max_concurrent == 0
      _ => false
    }
  }
}

// ============================== WHERE THE TWO GRAINS MEET ==============================

// THE ONE DECLARED MEETING, at full strength on a HERMETIC input: an item that owns pieces takes its elapsed from the
// LEAF scheduler's own answer over its own decomposition -- `gunbc.roadmap.roadmap_schedule::schedule`, the same call
// the belt makes, under the same worker capacity -- and holds no lane of its own. The witness does not re-implement the
// leaf grain: it asks the leaf scheduler the same question and requires ONE outcome from the row. The fixture is
// synthetic and alone in the read (a synthetic item, a synthetic decomposition of two leaves, nothing else), so nothing
// can delay the item behind unrelated work: the bar must start at day zero and finish on exactly the leaf grain's day.
// Sizing work on the real roadmap cannot move this control.
test fn an_item_that_owns_pieces_borrows_its_elapsed_from_the_leaf_scheduler() -> Bool {
  let plan = decomposition(node: "fixture-item-rows", waits_on: [] as List<StageDependency>, stages: [
    [leaf(label: "fixture-leaf-first", days: 2), leaf(label: "fixture-leaf-second", days: 3)],
  ])
  let a = read_with_pieces(nodes: pieces_nodes(), edges: [] as List<RoadmapEdge>, entries: [] as List<EstimateEntry>, pieces: [plan])
  match row_of_in(nodes: pieces_nodes(), a: a, slug: "fixture-item-rows") {
    Absent => false
    Present { value: row } => match leaf_horizon(plan: plan) {
      Absent => false
      Present { value: days } => if days > 0 {
        match row.state {
          RowPlaced { start_day: s, finish_day: f, lane: _, start: _, finish: _ } => s == 0 && f == days && f - s == days
          RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
          RowUnsized { why: _ } => false
          RowBlocked { behind: _ } => false
          RowLeafGrainRefused { cause: _ } => false
          RowUnplaced => false
          RowNoFindingsCount { count: _ } => false
        }
      } else {
        false
      }
    }
  }
}

// A DECOMPOSITION THAT PRICES NOTHING is not a zero-day bar. A decomposition of nothing but a bare wait expands to no
// schedulable occurrence at all -- the leaf grain answers a makespan of zero -- so there is no elapsed to draw, and
// drawing one would be a price nobody computed. The row is blocked and NAMES its own pieces as the reason, which is the
// case where a held row has no prerequisite edge to lean on: the cause is about the row itself, and it still arrives
// typed (gunbc.design_argument::fail_closed -- "a wrong answer is a loud, typed, located error").
test fn an_item_whose_pieces_price_nothing_is_blocked_naming_its_own_pieces() -> Bool {
  let plan = decomposition(node: "fixture-item-zero", waits_on: [] as List<StageDependency>, stages: [
    [Join { label: "fixture-wait-only" }],
  ])
  let a = read_with_pieces(nodes: pieces_nodes(), edges: [] as List<RoadmapEdge>, entries: [] as List<EstimateEntry>, pieces: [plan])
  match leaf_horizon(plan: plan) {
    Present { value: days } => if days == 0 {
      match row_of_in(nodes: pieces_nodes(), a: a, slug: "fixture-item-zero") {
        Absent => false
        Present { value: row } => match row.state {
          RowBlocked { behind: b } => count(filter(b, c => match c {
            PiecesZeroDays { node: n } => n == nid(s: "fixture-item-zero")
            NotEstimated { node: _, why: _ } => false
            RollupBelow { node: _, work_days: _ } => false
            PiecesRefused { node: _, cause: _ } => false
            PiecesFindingsCount { node: _, count: _ } => false
            BlockedBelow { node: _ } => false
            WaitsOnItsOwnContainer { node: _, container: _ } => false
          })) == 1
          RowPlaced { start_day: _, finish_day: _, lane: _, start: _, finish: _ } => false
          RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
          RowUnsized { why: _ } => false
          RowLeafGrainRefused { cause: _ } => false
          RowUnplaced => false
          RowNoFindingsCount { count: _ } => false
        }
      }
    } else {
      false
    }
    Absent => false
  }
}

// THE SAME MEETING ON THE LIVE ROADMAP, where the item shares the belt with every other item: it may start later than
// day zero, but it can only ever SPAN its leaf grain's makespan. This is an invariant over the declared data, not a
// claim about what the data happens to look like: if it fails, the leaf grain's answer for this item and the item
// row's span disagree, and BOTH sides are read before anything in the Gantt is touched.
test fn the_live_item_that_owns_pieces_spans_exactly_its_leaf_grain_makespan() -> Bool {
  let item = "namespace-reference-derived-closure"
  let a = read_with_pieces(nodes: declared_roadmap_nodes(), edges: [] as List<RoadmapEdge>, entries: [] as List<EstimateEntry>, pieces: roadmap_decompositions)
  match leaf_grain_answer(item: item) {
    Absent => false
    Present { value: days } => match row_of_live(a: a, slug: item) {
      Absent => false
      Present { value: row } => match row.state {
        RowPlaced { start_day: s, finish_day: f, lane: _, start: _, finish: _ } => f - s == days
        RowRollup { start_day: _, finish_day: _, start: _, finish: _ } => false
        RowUnsized { why: _ } => false
        RowBlocked { behind: _ } => false
        RowLeafGrainRefused { cause: _ } => false
        RowUnplaced => false
        RowNoFindingsCount { count: _ } => false
      }
    }
  }
}

// THE TWO SYNTHETIC ITEMS the controls above need: each owns a decomposition, and neither is a real slug, so the
// declared roadmap's 290-odd nodes cannot leak into either answer.
fn pieces_nodes() -> List<RoadmapNode> {
  [
    fixture_node(slug: "fixture-item-rows", parent: AdmittedRoot),
    fixture_node(slug: "fixture-item-zero", parent: AdmittedRoot),
  ]
}

fn row_of_in(nodes: List<RoadmapNode>, a: GanttAnswer, slug: String) -> Optional<GanttRow> {
  match filter(nodes, n => n.node == nid(s: slug)) {
    Empty => Absent
    Cons { head: n, tail: _ } => match filter(gantt_rows(a: a), r => r.node == n.node) {
      Empty => Absent
      Cons { head: r, tail: _ } => Present { value: r }
    }
  }
}


// THE LEAF SCHEDULER'S OWN HORIZON for one item's decomposition, asked directly: Present when the leaf read placed
// every leaf, Absent when it refused (in which case the item row must carry that refusal, not a duration).
fn leaf_grain_answer(item: String) -> Optional<Int> {
  match first(decomposition_for(node: nid(s: item))) {
    Absent => Absent
    Present { value: d0 } => leaf_horizon(plan: d0)
  }
}

// ASK THE LEAF SCHEDULER, the same call the item grain makes and the belt makes -- `schedule` over
// `expand_decomposition`, under the same worker capacity this witness reads with. It takes the decomposition as a
// VALUE, so a control can ask it about a synthetic plan without touching the declared table.
fn leaf_horizon(plan: WorkDecomposition) -> Optional<Int> {
  match schedule(d: plan, e: expand_decomposition(d: plan, findings_count: 1), workers: lanes(3)) {
    Scheduled { answer: s } => Present { value: s.horizon }
    NotScheduled { refusal: _ } => Absent
  }
}

fn row_of_live(a: GanttAnswer, slug: String) -> Optional<GanttRow> {
  row_of_in(nodes: declared_roadmap_nodes(), a: a, slug: slug)
}

// ============================== THE WHOLE ROADMAP, AT THE READ ==============================

// THE LIVE READ OVER EVERY DECLARED NODE answers -- nothing authored, nothing sized yet, so every row is listed and
// none is priced at zero. The horizon and the in-flight series are the top-level placement's own, and a row that
// carries a duration carries a positive one: the read is allowed no free work.
test fn the_live_read_over_the_whole_roadmap_lists_every_node_and_prices_none_at_zero() -> Bool {
  let a = gantt_answer_live(workers: lanes(3), findings_count: 1, at: read_date())
  match a {
    GanttAnswered { rows: rows, horizon: _, in_flight: _, critical: _ } => count(rows) == count(filter(declared_roadmap_nodes(), n => true))
      && count(filter(rows, r => match r.work_days { Present { value: v } => v <= 0, Absent => false })) == 0
    GanttRefused { refusal: _ } => false
  }
}
