module test.claim.roadmap.roadmap_status

// The types and predicates this witness discriminates, imported rather than left to resolve by luck:
// the file carried none of them and so had not been resolvable at all -- it sits outside both emitted
// closures, where the required job reports nothing. live_tree_disposition went with its import: the
// data it declared was referenced by nothing in the file.
import gunbc.roadmap.roadmap_status {
  RoadmapItem, DerivableLine, AuthoredLine, PlainLine, DriftVerdict,
  pr_merged, item_is_done, item_drifted, status_drift,
  merged_pr_numbers, prs_all_merged, item_drifts_against_prs,
}
import extdeps.github.github { GitHubUser }
import extdeps.github.pulls { PullRequestRef }

data witness_user: GitHubUser = { login: "gunbai-bot", id: 1, type: extdeps.github.github.User }
data witness_ref: PullRequestRef = { ref: "feature", sha: "deadbeef", label: "gunb:feature" }

data pr_5445: extdeps.github.pulls.PullRequest = {
  number: 5445,
  title: "merged witness pr",
  body: none,
  state: extdeps.github.pulls.Open,
  html_url: "https://github.com/gunb/gunbc/pull/5445",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: "2026-06-20T00:00:00",
  merge_commit_sha: none,
  draft: false,
}
data pr_open_9999: extdeps.github.pulls.PullRequest = {
  number: 9999,
  title: "open witness pr",
  body: none,
  state: extdeps.github.pulls.Open,
  html_url: "https://github.com/gunb/gunbc/pull/9999",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: none,
  merge_commit_sha: none,
  draft: false,
}

fn is_drifted(v: DriftVerdict) -> Bool {
  match v { Drifted => true  Clean => false  Underivable => false }
}
fn is_clean(v: DriftVerdict) -> Bool {
  match v { Clean => true  Drifted => false  Underivable => false }
}
fn is_underivable(v: DriftVerdict) -> Bool {
  match v { Underivable => true  Drifted => false  Clean => false }
}

fn derivable_item(prs: List<Int>, title: String) -> RoadmapItem {
  DerivableLine { prs: prs, title: title, description: "" }
}
fn authored_status_fixture(content: String) -> RoadmapItem {
  AuthoredLine { content: content }
}

test fn witness_merged_pr_is_merged() -> Bool {
  pr_merged(pr: pr_5445)
}
test fn witness_open_pr_not_merged() -> Bool {
  !pr_merged(pr: pr_open_9999)
}
test fn witness_merged_numbers_projection() -> Bool {
  let nums = merged_pr_numbers(prs: [pr_5445, pr_open_9999])
  count(nums) == 1 && (nums |> any(n => n == 5445))
}

test fn witness_all_merged_derives_done() -> Bool {
  prs_all_merged(prs: [5445], merged: [5445])
}

test fn witness_one_unmerged_derives_todo() -> Bool {
  !prs_all_merged(prs: [5445, 9999], merged: [5445])
}

test fn witness_empty_binding_derives_todo() -> Bool {
  !prs_all_merged(prs: [], merged: [5445])
}

test fn witness_derivable_done_from_merge() -> Bool {
  item_is_done(item: derivable_item(prs: [5445], title: "bound + landed"), merged: [5445])
    && !item_is_done(item: derivable_item(prs: [9999], title: "bound + open"), merged: [5445])
}

test fn witness_authored_done_is_authored() -> Bool {
  item_is_done(item: authored_status_fixture(content: "hand-checked done"), merged: [])
    && !item_is_done(item: authored_status_fixture(content: "hand-checked todo, cites #5445"), merged: [5445])
}

test fn witness_partial_evidence_merged_mention_stays_green() -> Bool {
  let item = authored_status_fixture(content: "rust-gate coverage — cites merged #5445 as partial evidence, not done")
  is_underivable(v: status_drift(item: item, committed_box: false, merged: [5445]))
    && !item_drifted(item: item, committed_box: false, merged: [5445])
}

test fn witness_authored_done_underivable() -> Bool {
  let item = authored_status_fixture(content: "audit done, no PR")
  is_underivable(v: status_drift(item: item, committed_box: true, merged: []))
}

test fn witness_derivable_merged_box_todo_drifts() -> Bool {
  let item = derivable_item(prs: [5445], title: "bound + stale")
  is_drifted(v: status_drift(item: item, committed_box: false, merged: [5445]))
    && item_drifted(item: item, committed_box: false, merged: [5445])
}

test fn witness_derivable_unmerged_box_done_drifts() -> Bool {
  let item = derivable_item(prs: [9999], title: "bound + premature")
  is_drifted(v: status_drift(item: item, committed_box: true, merged: [5445]))
}

test fn witness_derivable_merged_box_done_clean() -> Bool {
  let item = derivable_item(prs: [5445], title: "bound + honest done")
  is_clean(v: status_drift(item: item, committed_box: true, merged: [5445]))
    && !item_drifted(item: item, committed_box: true, merged: [5445])
}

test fn witness_derivable_unmerged_box_todo_clean() -> Bool {
  let item = derivable_item(prs: [9999], title: "bound + honest todo")
  is_clean(v: status_drift(item: item, committed_box: false, merged: [5445]))
}

// THE LINE NEVER STATES ITS OWN ENDING (operator ruling
// gunbc.design_ruling::plans_reset_and_audit_recommendations_2026_11_08, steps 1(d) and 3). No row
// shape reports itself done, and no row names a successor: the `done: Bool` the authored shapes
// carried was a hand-editable second spelling of merged-PR evidence, and the SupersededLine variant
// was a hand-editable second spelling of a retirement. Both are deleted with their witnesses. What
// ENDS a node is the roadmap event log's standing — an acceptance that folds to accepted, or a
// retirement — and that is claimed where it is decided:
// dag/test/claim/roadmap/roadmap_event_log_witness.dag. What may still be asked of a row is whether
// its implementation evidence has landed, which is a review state and never an acceptance.
test fn witness_no_line_shape_reports_its_own_ending() -> Bool {
  !item_is_done(item: authored_status_fixture(content: "live row"), merged: [5445])
    && !item_is_done(item: PlainLine { content: "prose row" }, merged: [5445])
    && !item_is_done(item: derivable_item(prs: [9999], title: "bound, unmerged"), merged: [5445])
    && is_underivable(v: status_drift(item: PlainLine { content: "prose row" }, committed_box: true, merged: [5445]))
}

test fn witness_derivable_partial_multi_todo_clean() -> Bool {
  let item = derivable_item(prs: [5445, 9999], title: "bound + multi partial")
  is_clean(v: status_drift(item: item, committed_box: false, merged: [5445]))
}

test fn item_against_prs_drifts() -> Bool {
  let item = derivable_item(prs: [5445], title: "live-edge stale")
  item_drifts_against_prs(item: item, committed_box: false, prs: [pr_5445, pr_open_9999])
}

