module test.claim.roadmap_runtime_plan_witness_test

import std.types { Bool, String, NonEmptyStr }
import std.optional { Present, Absent }
import gunbc.roadmap_model { RoadmapNode, RoadmapNodeId, RoadmapNodeIdentity }
import gunbc.roadmap_authority { roadmap_authority_projection, roadmap_authority_projection_with, roadmap_acceptance_event_history_load, declared_roadmap_nodes, RoadmapAuthorityProjected, RoadmapAuthorityProjectionRefused }
import gunbc.roadmap_page { issue_detail_node_exists }
import gunbc.roadmap_task_store { roadmap_task_minted }
import test.claim.roadmap_task_record_witness_test { sample_task }

// THE UNION: a runtime task value is a node of the one projected plan (issue detail finds it), the
// static projection never carries it, and a runtime id equal to a declared node's id refuses.
test fn runtime_task_joins_the_plan_and_collision_refuses() -> Bool {
  let task = roadmap_task_minted(operation_key: "union-witness" as NonEmptyStr, draft: sample_task())
  let id = task.node as String
  let with = roadmap_authority_projection_with(history: roadmap_acceptance_event_history_load(), runtime: [task])
  let without = roadmap_authority_projection(history: roadmap_acceptance_event_history_load())
  let declared = match first(declared_roadmap_nodes()) { Present { value: n } => n Absent => task }
  let clash = RoadmapNode { identity: task.identity, node: declared.node, line: task.line, carriers: task.carriers, dispatch: task.dispatch, execution: task.execution, owner: task.owner, signoff: task.signoff, parent: task.parent, centering: task.centering }
  let refused = match roadmap_authority_projection_with(history: roadmap_acceptance_event_history_load(), runtime: [clash]) { RoadmapAuthorityProjectionRefused { detail: _ } => true other => false }
  issue_detail_node_exists(proj: with, node_id: id) && !issue_detail_node_exists(proj: without, node_id: id) && refused
}
