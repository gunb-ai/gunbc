fn claim_start_facts(
  instance: HostDashboardInstance,
  node_id: String,
  attempt_key: String,
  user: NonEmptyStr,
  inner_argv: List<String>,
  exit_hook: NonEmptyStr,
) -> AttemptSystemUnitStartFacts? {
  match systemd_service_unit_name(stem: dispatch_attempt_unit_stem(node_id: node_id, attempt_key: attempt_key)) {
    SystemdUnitNameStemEmpty => none
    SystemdUnitNameDisallowedCharacter { stem: _, character: _ } => none
    SystemdUnitNameOverlong { length: _ } => none
    SystemdUnitNameAdmitted { name } => Present {
      value: AttemptSystemUnitStartFacts {
        unit: name,
        node_id: node_id,
        attempt_key: attempt_key,
        user: user,
        working_directory: instance.repo_root as String,
        attempt_worktree: "/tmp/wt",
        stdout_path: "/tmp/out",
        stderr_path: "/tmp/err",
        granted: kibibyte(count: 1),
        exit_hook: exit_hook,
        inner_argv: inner_argv,
      },
    }
  }
}

test fn a_start_with_the_instance_binary_and_user_is_admitted() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match claim_start_facts(
    instance: inst,
    node_id: "n",
    attempt_key: "k",
    user: inst.directory_owner.user as NonEmptyStr,
    inner_argv: [inst.serve_binary as String, "run"],
    exit_hook: "true" as NonEmptyStr,
  ) {
    Absent => false
    Present { value: facts } =>
  match attempt_system_unit_start_admitted(
    instance: inst,
    facts: facts,
  ) {
    AttemptSystemUnitAdmitted { unit: u, facts: _ } =>
      (u as String) == "gunbc-attempt-n-k.service"
    AttemptSystemUnitRefused { reason: _ } => false
  }
  }
}

test fn a_start_with_another_program_is_refused() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match claim_start_facts(
    instance: inst,
    node_id: "n",
    attempt_key: "k",
    user: inst.directory_owner.user as NonEmptyStr,
    inner_argv: ["/bin/touch", "/tmp/x"],
    exit_hook: "true" as NonEmptyStr,
  ) {
    Absent => false
    Present { value: facts } =>
  match attempt_system_unit_start_admitted(
    instance: inst,
    facts: facts,
  ) {
    AttemptSystemUnitRefused { reason: why } => string_contains(s: why, pattern: "gunbc binary")
    AttemptSystemUnitAdmitted { unit: _, facts: _ } => false
  }
  }
}

test fn a_start_with_another_user_is_refused() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match claim_start_facts(
    instance: inst,
    node_id: "n",
    attempt_key: "k",
    user: "root" as NonEmptyStr,
    inner_argv: [inst.serve_binary as String],
    exit_hook: "true" as NonEmptyStr,
  ) {
    Absent => false
    Present { value: facts } =>
  match attempt_system_unit_start_admitted(
    instance: inst,
    facts: facts,
  ) {
    AttemptSystemUnitRefused { reason: why } => string_contains(s: why, pattern: "worker user")
    AttemptSystemUnitAdmitted { unit: _, facts: _ } => false
  }
  }
}

test fn the_launcher_effect_selects_federated_scoped_grant() -> Bool {
  match select_authorization_pattern(e: attempt_system_unit_privileged_effect()) {
    PatternSelected { pattern: FederatedScopedGrant, receipt: _ } => true
    PatternSelected { pattern: OperatorApprovedCapability, receipt: _ } => false
    PatternSelected { pattern: HumanOnlyStep { step: _ }, receipt: _ } => false
    PatternSelected { pattern: OperatorOwnSession, receipt: _ } => false
    PatternSelected { pattern: AdministratorEdge, receipt: _ } => false
    PatternSelected { pattern: ApprovedConvergenceGrant, receipt: _ } => false
    ManualStepRequired { step: _, receipt: _ } => false
    NoAdmissiblePattern { causes: _, scope: _ } => false
    PatternSelectionNeedsEvidence { needs: _ } => false
    PatternSelectionNeedsPolicy { survivors: _ } => false
    PatternSelectionRefused { defects: _ } => false
  }
}

test fn the_launcher_site_conforms_in_the_privileged_effect_census() -> Bool {
  let rows = filter(privileged_effect_census, r => (r.site.decl_name as String) == "attempt_system_unit_launch_cli")
  match rows.first() {
    Absent => false
    Present { value: row } =>
      match site_verdict(row: row).conformance {
        Conforms => true
        DivergesWithReason { reason: _ } => false
        Diverges => false
        SiteNotDecidable { standing: _ } => false
      }
  }
}

// THE DEPLOY RUNS THE DRAIN UNITS (review 80299). The unit fold is the shape; whether a deploy installs it is a
// fact of the apply plan the real producer emits (deploy_apply_plan_legs over the instance's spec, a full
// install), so these claims read the typed legs of that plan. Each instance's apply installs its own drain and
// never the other instance's: a lab apply never touches production's privilege surface.
fn full_install_legs(spec: DeploymentSpec) -> List<DeployApplyLeg> {
  match deploy_apply_plan_legs(
    spec: spec,
    plan: deploy_witness_full_install_plan(spec: spec),
    source_root: "/src",
    oidc_now: tracker_web_test_console_readback_observed_at_epoch,
  ) {
    ApplyPlanReady { legs: ls } => ls
    ApplyPlanRefused { step: _, reason: _ } => []
  }
}

fn leg_command_words(c: ArgvCommand) -> String {
  join(c.arguments, " ")
}

fn leg_text(leg: DeployApplyLeg) -> String {
  match leg {
    ApplyLegInstallFile { step: st, command: c, payload: p } => join([st, " ", leg_command_words(c: c), "\n", p], "")
    ApplyLegCommand { step: st, command: c } => join([st, " ", leg_command_words(c: c)], "")
    ApplyLegRetract { step: st, leg: RetractRemoveForce { paths: ps } } => join([st, " ", join(non_empty_to_list(xs: ps) |> map(p => p as String), " ")], "")
    ApplyLegRootHelperSnapshot { locus: l, spine: _, revision: _, action: _ } => join([deploy_apply_leg_step(leg: leg), " ", l.base], "")
    _ => deploy_apply_leg_step(leg: leg)
  }
}

fn full_install_apply_text(spec: DeploymentSpec) -> String {
  join(map(full_install_legs(spec: spec), l => leg_text(leg: l)), "\n")
}

fn leg_index_from(legs: List<DeployApplyLeg>, step: String, i: Int) -> Int {
  match legs.first() {
    Absent => 0 - 1
    Present { value: h } => if deploy_apply_leg_step(leg: h) == step { i } else { leg_index_from(legs: skip(legs, 1), step: step, i: i + 1) }
  }
}

fn leg_index(legs: List<DeployApplyLeg>, step: String) -> Int {
  leg_index_from(legs: legs, step: step, i: 0)
}

fn apply_installs_the_drain_units(spec: DeploymentSpec, own: HostDashboardInstance) -> Bool {
  let text = full_install_apply_text(spec: spec)
  string_contains(s: text, pattern: deployment_attempt_unit_drain_path_unit_path(names: spec.names) as String)
    && string_contains(s: text, pattern: deployment_attempt_unit_drain_service_unit_path(names: spec.names) as String)
    && string_contains(s: text, pattern: join(["DirectoryNotEmpty=", attempt_unit_spool_request_dir(instance_root: own.instance_root as String)], ""))
    && string_contains(s: text, pattern: join([attempt_system_unit_launcher_helpers_root, "/", own.instance_id as String], ""))
}

// The roster gate is the host plan's selector (lab_plan_worker_sandbox_choice): srv1's plan selects the
// system-manager launcher for production and its lab alike, so both apply the drain; a plan that does not select it
// (refused) installs neither unit.
test fn the_production_full_install_apply_installs_the_drain_path_and_service() -> Bool {
  match lab_plan_worker_sandbox_choice(plan: deployment_spec_srv1().target.lab_plan) {
    Present { value: SystemManagerLauncherSelected } => true
    Absent => false
  }
    && apply_installs_the_drain_units(spec: deployment_spec_srv1(), own: srv1_live_dashboard_instance())
}

test fn a_refused_lab_plan_owns_no_drain_steps_and_the_selected_plan_owns_them() -> Bool {
  let names = deployment_spec_srv1().names
  count(deployment_attempt_unit_drain_steps(names: names, lab_plan: LabPlanRefused { cause: LabOsUnobserved { obligation: "os unobserved" as NonEmptyStr } })) == 0
    && count(deployment_attempt_unit_drain_steps(names: names, lab_plan: deployment_spec_srv1().target.lab_plan)) > 0
}

// The retired sudo route is deleted by the same apply that installs the drain, so a converged host keeps no
// standing root-by-sudo grant beside the path-triggered oneshot.
test fn the_lab_apply_deletes_the_retired_sudoers_receipt_and_lock() -> Bool {
  let text = full_install_apply_text(spec: selected_deployment_spec(row: srv1_lab_desired_deployment()))
  let own = srv1_lab_dashboard_instance()
  all(retired_attempt_unit_sudo_route_paths(instance: own), p => string_contains(s: text, pattern: p))
    && string_contains(s: text, pattern: join(["/etc/sudoers.d/gunbc-attempt-system-unit-", own.instance_id as String], ""))
    && leg_index(legs: full_install_legs(spec: selected_deployment_spec(row: srv1_lab_desired_deployment())), step: "attempt-unit-sudo-route-retire")
      < leg_index(legs: full_install_legs(spec: selected_deployment_spec(row: srv1_lab_desired_deployment())), step: "attempt-unit-sudoers-check")
    && string_contains(s: text, pattern: "visudo")
    && (match attempt_unit_sudo_route_retire_dissolution {
      UnboundDissolution { description } => string_contains(s: description as String, pattern: "passed the sudoers check")
      BoundDissolution { trigger: _ } => false
    })
}

test fn the_lab_full_install_apply_installs_the_drain_path_and_service() -> Bool {
  apply_installs_the_drain_units(
    spec: selected_deployment_spec(row: srv1_lab_desired_deployment()),
    own: srv1_lab_dashboard_instance(),
  )
}

// THE ROOT SIDE IS A ONESHOT RUN AS ROOT FROM THE ROOT-OWNED RELEASE, TRIGGERED BY THE REQUEST DIRECTORY.
// No sudoers line and no flock remain on the requester path; the path unit's target is the service.
test fn the_drain_service_runs_the_release_launcher_and_the_path_unit_targets_it() -> Bool {
  let live = srv1_live_dashboard_instance()
  let spec = deployment_spec_srv1()
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  match live_deploy_attempt_unit_drain_service_unit_file(spec: spec, instance: live, revision: rev) {
    AttemptUnitDrainServiceRefused { cause: _ } => false
    AttemptUnitDrainServiceReady { file: svc } => {
      let text = serialize_systemd_unit_file(file: svc)
      let path_text = serialize_systemd_unit_file(file: live_deploy_attempt_unit_drain_path_unit_file(spec: spec))
      string_contains(s: text, pattern: "Type=oneshot")
        && string_contains(s: text, pattern: attempt_system_unit_launcher_dir(instance: live, revision: rev))
        && string_contains(s: text, pattern: "attempt_system_unit_launch_cli")
        && !string_contains(s: text, pattern: "sudo")
        && string_contains(s: path_text, pattern: join(["Unit=", deployment_attempt_unit_drain_service_unit_name(names: spec.names) as String], ""))
        && string_contains(s: path_text, pattern: "DirectoryNotEmpty=")
    }
  }
}

fn apply_needle_precedes(text: String, earlier: String, later: String) -> Bool {
  string_contains(s: text, pattern: earlier)
    && string_contains(s: text, pattern: later)
    && match split(s: text, delimiter: earlier).first() {
      Absent => false
      Present { value: prefix } => !string_contains(s: prefix, pattern: later)
    }
}

test fn the_full_install_apply_installs_the_attempt_worker_slice_with_bounds_before_the_drain() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  let text = full_install_apply_text(spec: spec)
  let dest = gunbc_attempt_worker_slice_unit_path() as String
  let grant = deployment_attempt_unit_drain_service_unit_path(names: spec.names) as String
  match attempt_worker_slice_memory_high() {
    UserWorkSliceHighGapExceedsMax => false
    UserWorkSliceHighDerived { bytes: high } =>
      string_contains(s: dest, pattern: "/etc/systemd/system/")
        && string_contains(s: dest, pattern: attempt_worker_slice_unit_name as String)
        && string_contains(s: text, pattern: dest)
        && string_contains(s: text, pattern: join(["MemoryMax=", to_string(byte_size_count(b: attempt_worker_slice_memory_max))], ""))
        && string_contains(s: text, pattern: join(["MemoryHigh=", to_string(byte_size_count(b: high))], ""))
        && string_contains(s: text, pattern: join(["MemorySwapMax=", to_string(byte_size_count(b: live_deploy_slice_memory_swap_max))], ""))
        && apply_needle_precedes(text: text, earlier: dest, later: grant)
  }
}

fn instance_toolchain_has_systemd_run(instance: HostDashboardInstance) -> Bool {
  match instance.toolchain.systemd_run {
    Present { value: _ } => true
    Absent => false
  }
}

test fn every_systemd_run_roster_instance_resolves_at_the_launcher() -> Bool {
  all(
    public_builtin_dashboard_instances() |> filter(i => instance_toolchain_has_systemd_run(instance: i)),
    i => match attempt_system_unit_instance_for_root(instance_root: i.instance_root as String) {
      Absent => false
      Present { value: resolved } => resolved.instance_id == i.instance_id
    },
  )
    && match attempt_system_unit_instance_for_root(instance_root: "/not-a-declared-dashboard-instance") {
      Absent => true
      Present { value: _ } => false
    }
}

// THE REQUEST NAMES AN ATTEMPT; ROOT DERIVES EVERYTHING PRIVILEGED (review 80324). The requester
// writes one per-attempt spool entry, so the claims below supply request values at that interface
// and read what the launcher derives: the exit hook is attempt_exit_hook's render for the attempt,
// User= is the instance's, and the writable worktree and log paths are the belt's own derivations.
fn claim_request(node_id: String, attempt_key: String) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: node_id,
    attempt_key: attempt_key,
    granted: kibibyte(count: 1),
    inner_argv: [srv1_lab_dashboard_instance().serve_binary as String, "run"],
    nonce: "n",
  }
}

// THE `+` PREFIX IS THE CONFINEMENT, not its withdrawal. gunbc.roadmap.roadmap_attempt_exit_spool
// attempt_exit_hook renders ExecStopPost through exec_command_line_full_privileges: a fixed
// refuse-on-syntax mkdir of a create-only inbox path from root-derived facts, run outside the unit
// sandbox so the confined process cannot write that inbox. An earlier conjunct asserted
// !starts_with(exit_hook, "+") as if the prefix were a requester-chosen privilege grant; that
// reading diverges from the spool's design. This claim requires the prefix because the launcher
// inhabits that one hook, not a request-supplied line.
test fn the_launcher_derives_the_exit_hook_from_the_attempt_identity() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let node = "n1"
  let key = "k1"
  match attempt_system_unit_start_facts_for_request(instance: inst, request: claim_request(node_id: node, attempt_key: key)) {
    AttemptSystemUnitStartUnderivable { reason: _ } => false
    AttemptSystemUnitStartDerived { facts } =>
      match attempt_exit_hook(instance_root: inst.instance_root as String, node_id: node, attempt_key: key, role: AttemptWorkerRole, record_owner: inst.directory_owner) {
        AttemptExitHookRefused { reason: _ } => false
        AttemptExitHookRendered { exec_line } =>
          (facts.exit_hook as String) == (exec_line as String)
            && starts_with(s: facts.exit_hook as String, prefix: exec_full_privileges_prefix)
      }
  }
}

// User= is the instance WORKER user (WorkerIdentity arm), not the service user: on the srv1 lab the worker is the
// dedicated account (#14246), and the launcher refuses any User= other than dashboard_instance_worker_user.
test fn the_launcher_derives_the_user_and_paths_from_the_attempt_identity() -> Bool {
  let inst = srv1_lab_dashboard_instance()
  let node = "n1"
  let key = "k1"
  match attempt_system_unit_start_facts_for_request(instance: inst, request: claim_request(node_id: node, attempt_key: key)) {
    AttemptSystemUnitStartUnderivable { reason: _ } => false
    AttemptSystemUnitStartDerived { facts } =>
      (facts.user as String) == (dashboard_instance_worker_user(instance: inst) as String)
        && facts.attempt_worktree == dispatch_worktree_path_for_instance(instance: inst, node_id: node as RoadmapNodeId, attempt_key: key)
        && facts.stdout_path == attempt_state_text(instance: inst, node_id: node as RoadmapNodeId, attempt_key: key, member: AttemptWorkerLog)
        && facts.working_directory == dispatch_pane_working_directory(provider: GunbcHarnessProvider, instance: inst, worktree_path: facts.attempt_worktree)
  }
}

fn request_is_underivable(node_id: String, attempt_key: String) -> Bool {
  match attempt_system_unit_start_facts_for_request(instance: srv1_lab_dashboard_instance(), request: claim_request(node_id: node_id, attempt_key: attempt_key)) {
    AttemptSystemUnitStartUnderivable { reason: _ } => true
    AttemptSystemUnitStartDerived { facts: _ } => false
  }
}

test fn an_attempt_identity_that_is_not_one_path_segment_is_underivable() -> Bool {
  request_is_underivable(node_id: "../../opt", attempt_key: "k1")
    && request_is_underivable(node_id: "n1", attempt_key: "a/b")
    && request_is_underivable(node_id: "..", attempt_key: "k1")
    && request_is_underivable(node_id: "n1", attempt_key: "")
    && !request_is_underivable(node_id: "n1", attempt_key: "k1")
}

test fn a_path_safe_node_id_with_a_space_is_underivable_as_a_systemd_unit() -> Bool {
  request_is_underivable(node_id: "a b", attempt_key: "k1")
}

test fn a_path_safe_node_id_with_at_is_underivable_as_a_systemd_unit() -> Bool {
  request_is_underivable(node_id: "x@y", attempt_key: "k1")
}

test fn a_start_whose_node_id_systemd_disallows_cannot_inhabit_start_facts() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match claim_start_facts(
    instance: inst,
    node_id: "a b",
    attempt_key: "k",
    user: inst.directory_owner.user as NonEmptyStr,
    inner_argv: [inst.serve_binary as String, "run"],
    exit_hook: "true" as NonEmptyStr,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

// The earlier wide body carried user, working directory, worktree, both log paths and the exit hook.
// Its hook line here is the root-exec shape systemd honours (`+` runs ExecStopPost with full
// privileges); the decoder reads no such field, so the body is malformed rather than partly admitted.
test fn a_wide_request_body_naming_a_root_exit_hook_is_malformed() -> Bool {
  let wide = split(s: join([
    "start", "n1", "k1", "briansrls", "/", "/opt/gunbc", "/tmp/o", "/tmp/e", "1",
    "+/bin/sh -c 'id > /tmp/rooted'", "/usr/bin/true",
  ], "\n"), delimiter: "\n")
  match attempt_system_unit_start_request_decode(lines: wide) {
    AttemptSystemUnitStartRequestMalformed { reason: _ } => true
    AttemptSystemUnitStartRequestDecoded { verb: _, request: _ } => false
    AttemptSystemUnitStartVerbUnknown { tag: _ } => false
  }
}

test fn a_narrow_request_body_round_trips() -> Bool {
  start_request_round_trips(verb: StartDetached, request: claim_request(node_id: "n1", attempt_key: "k1"))
}

fn start_verbs_equal(got: AttemptSystemUnitStartVerb, expected: AttemptSystemUnitStartVerb) -> Bool {
  match expected {
    StartDetached =>
      match got {
        StartDetached => true
        StartAndWait => false
      }
    StartAndWait =>
      match got {
        StartAndWait => true
        StartDetached => false
      }
  }
}

fn start_request_round_trips(verb: AttemptSystemUnitStartVerb, request: AttemptSystemUnitStartRequest) -> Bool {
  match attempt_system_unit_encode_start(verb: verb, request: request) {
    AttemptSystemUnitStartUnencodable { cause: _ } => false
    AttemptSystemUnitStartEncoded { body } =>
      match attempt_system_unit_start_request_decode(lines: split(s: body, delimiter: "\n")) {
        AttemptSystemUnitStartRequestMalformed { reason: _ } => false
        AttemptSystemUnitStartVerbUnknown { tag: _ } => false
        AttemptSystemUnitStartRequestDecoded { verb: got_verb, request: got } =>
          start_verbs_equal(got: got_verb, expected: verb)
            && got.node_id == request.node_id
            && got.attempt_key == request.attempt_key
            && kibibyte_count(k: got.granted) == kibibyte_count(k: request.granted)
            && got.inner_argv == request.inner_argv
      }
  }
}

fn encode_refuses_cause(request: AttemptSystemUnitStartRequest) -> AttemptSystemUnitStartUnencodableCause? {
  match attempt_system_unit_encode_start(verb: StartDetached, request: request) {
    AttemptSystemUnitStartEncoded { body: _ } => none
    AttemptSystemUnitStartUnencodable { cause } => Present { value: cause }
  }
}

fn request_with_argv(argv: List<String>) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: "n1",
    attempt_key: "k1",
    granted: kibibyte(count: 1),
    inner_argv: argv,
    nonce: "n",
  }
}

test fn each_unencodable_argv_refuses_at_encode() -> Bool {
  match encode_refuses_cause(request: request_with_argv(argv: [])) {
    Absent => false
    Present { value: AttemptSystemUnitArgvEmpty } => true
    Present { value: AttemptSystemUnitNonceUnsafe } => false
  }
}

// A MULTI-LINE WORD IS LEGITIMATE (the node brief is passed inline). Each hostile character survives
// encode then decode exactly, and the encoded body stays one field per line.
test fn every_encodable_request_round_trips_exactly() -> Bool {
  let argv = ["/opt/gunbc/bin/gunbc", "run", "--arg", "k=v", "path with spaces", join(["quote", "\"", "here"], ""), "dollar$ID"]
  start_request_round_trips(verb: StartDetached, request: request_with_argv(argv: argv))
    && start_request_round_trips(verb: StartAndWait, request: request_with_argv(argv: argv))
}

test fn a_word_carrying_a_newline_or_unit_separator_round_trips_exactly() -> Bool {
  let hostile = ["/bin/true", "brief=line one\nline two\n\nline four", "sep\u{1f}arator", "rs\u{1e}sep", "q\"uote", "back\\slash", "caf\u{e9} \u{2603}", "tab\there"]
  start_request_round_trips(verb: StartDetached, request: request_with_argv(argv: hostile))
    && start_request_round_trips(verb: StartAndWait, request: request_with_argv(argv: hostile))
    && match attempt_system_unit_encode_start(verb: StartDetached, request: request_with_argv(argv: hostile)) {
      AttemptSystemUnitStartUnencodable { cause: _ } => false
      AttemptSystemUnitStartEncoded { body } => count(split(s: body, delimiter: "\n")) == 6
    }
}

test fn a_malformed_argv_field_is_a_typed_malformed_refusal() -> Bool {
  decode_with_argv_field(field: "not json")
    && decode_with_argv_field(field: "[\"a\", 3]")
    && decode_with_argv_field(field: "{\"a\": \"b\"}")
    && decode_with_argv_field(field: "[]")
    && decode_with_argv_field(field: "[\"a\"] trailing")
}

fn decode_with_argv_field(field: String) -> Bool {
  match attempt_system_unit_start_request_decode(lines: ["start", "n1", "k1", "1", field, "n"]) {
    AttemptSystemUnitStartRequestMalformed { reason: _ } => true
    AttemptSystemUnitStartVerbUnknown { tag: _ } => false
    AttemptSystemUnitStartRequestDecoded { verb: _, request: _ } => false
  }
}

test fn an_unknown_verb_on_the_wire_is_a_typed_refusal() -> Bool {
  match attempt_system_unit_start_request_decode(lines: ["stop", "n1", "k1", "1", "[\"/bin/true\"]"]) {
    AttemptSystemUnitStartVerbUnknown { tag } => tag == "stop"
    AttemptSystemUnitStartRequestMalformed { reason: _ } => false
    AttemptSystemUnitStartRequestDecoded { verb: _, request: _ } => false
  }
}

test fn each_start_verb_wire_round_trips() -> Bool {
  start_request_round_trips(verb: StartDetached, request: request_with_argv(argv: ["/bin/true"]))
    && start_request_round_trips(verb: StartAndWait, request: request_with_argv(argv: ["/bin/true"]))
    && attempt_system_unit_start_verb_wire(verb: StartDetached) == "start"
    && attempt_system_unit_start_verb_wire(verb: StartAndWait) == "start-wait"
}

test fn an_empty_argv_line_is_malformed() -> Bool {
  match attempt_system_unit_start_request_decode(lines: ["start", "n1", "k1", "1", "", "n"]) {
    AttemptSystemUnitStartRequestMalformed { reason: why } => why == "start request argv is empty"
    AttemptSystemUnitStartVerbUnknown { tag: _ } => false
    AttemptSystemUnitStartRequestDecoded { verb: _, request: _ } => false
  }
}

fn launcher_execstoppost_argv_keeps_single_dollar(instance: HostDashboardInstance, exec_line: NonEmptyStr) -> Bool {
  match claim_start_facts(
    instance: instance,
    node_id: "n",
    attempt_key: "k",
    user: instance.directory_owner.user as NonEmptyStr,
    inner_argv: [instance.serve_binary as String],
    exit_hook: exec_line,
  ) {
    Absent => false
    Present { value: facts } =>
  match attempt_system_unit_start_admitted(instance: instance, facts: facts) {
    AttemptSystemUnitRefused { reason: _ } => false
    AttemptSystemUnitAdmitted { unit: unit, facts: admitted } =>
      match attempt_system_unit_systemd_run_command(
        instance: instance,
        plan: attempt_system_unit_plan_from_facts(facts: admitted, unit: unit),
        granted: admitted.granted,
        user: admitted.user,
      ) {
        SystemdRunCommandRefused { cause: _ } => false
        SystemdRunCommandReady { command } =>
          launcher_execstoppost_words_are_short_and_single_dollar(words: argv_words(command: command))
      }
  }
  }
}

fn launcher_execstoppost_words_are_short_and_single_dollar(words: List<String>) -> Bool {
  let stop = filter(words, w => string_contains(s: w, pattern: "ExecStopPost="))
  let dollar = join(["$", "{", "INVOCATION_ID", "}"], "")
  let doubled = join(["$", "$", "{", "INVOCATION_ID", "}"], "")
  any(words, w => w == "-p")
    && !any(words, w => string_contains(s: w, pattern: "--property=ExecStopPost="))
    && any(stop, w => string_contains(s: w, pattern: dollar))
    && !any(stop, w => string_contains(s: w, pattern: doubled))
}

test fn the_launcher_systemd_run_argv_places_the_worker_and_forbids_swap() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match claim_start_facts(
    instance: inst,
    node_id: "n",
    attempt_key: "k",
    user: inst.directory_owner.user as NonEmptyStr,
    inner_argv: [inst.serve_binary as String],
    exit_hook: "true" as NonEmptyStr,
  ) {
    Absent => false
    Present { value: facts } =>
      match attempt_system_unit_start_admitted(instance: inst, facts: facts) {
        AttemptSystemUnitRefused { reason: _ } => false
        AttemptSystemUnitAdmitted { unit: unit, facts: admitted } =>
          match attempt_system_unit_systemd_run_command(
            instance: inst,
            plan: attempt_system_unit_plan_from_facts(facts: admitted, unit: unit),
            granted: admitted.granted,
            user: admitted.user,
          ) {
            SystemdRunCommandRefused { cause: _ } => false
            SystemdRunCommandReady { command } => {
              let words = argv_words(command: command)
              let swap = join(["MemorySwapMax=", to_string(byte_size_count(b: live_deploy_slice_memory_swap_max))], "")
              let slice = join(["Slice=", attempt_worker_slice_unit_name as String], "")
              let user_slice = join(["Slice=", user_work_slice_unit_name as String], "")
              (attempt_system_unit_worker_slice.unit as String) == (attempt_worker_slice_unit_name as String)
                && filter(words, w => string_contains(s: w, pattern: swap)).length() == 1
                && filter(words, w => string_contains(s: w, pattern: slice)).length() == 1
                && filter(words, w => string_contains(s: w, pattern: user_slice)).length() == 0
            }
          }
      }
  }
}

// DISCRIMINATING: systemd-run specifier-escapes `$` inside one `--property=ExecStopPost=...${VAR}`
// word, so the unit stored `$${INVOCATION_ID}` and the inbox directory kept the unexpanded
// `${` spelling (lab 2026-10-14). Reviewer units use `-p` as two words and expand. The launcher
// must spell ExecStopPost the same way, with a single `$` still in the argv.
test fn the_launcher_execstoppost_uses_short_property_words_and_keeps_a_single_dollar() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match attempt_exit_hook(
    instance_root: inst.instance_root as String,
    node_id: "n",
    attempt_key: "k",
    role: AttemptWorkerRole,
    record_owner: inst.directory_owner,
  ) {
    AttemptExitHookRefused { reason: _ } => false
    AttemptExitHookRendered { exec_line } =>
      launcher_execstoppost_argv_keeps_single_dollar(instance: inst, exec_line: exec_line)
  }
}

test fn two_attempts_never_share_one_request_entry_name() -> Bool {
  attempt_system_unit_request_entry_name(node_id: "n-a", attempt_key: "k1")
    != attempt_system_unit_request_entry_name(node_id: "n-b", attempt_key: "k1")
    && attempt_system_unit_request_entry_name(node_id: "n-a", attempt_key: "k1")
      != attempt_system_unit_request_entry_name(node_id: "n-a", attempt_key: "k2")
}

test fn a_refused_answer_is_not_harness_started() -> Bool {
  match attempt_system_unit_harness_start_from_observation(
    entry: "e",
    reading: AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: "occupied" } },
  ) {
    AttemptSystemUnitHarnessStarted => false
    AttemptSystemUnitHarnessPending { entry: _ } => false
    AttemptSystemUnitHarnessFailed { detail } => detail == "occupied"
  }
}

// THE RED: a request with no answer yet is neither a start nor a failure. It names its entry so a
// client can follow it; it never mints Started and never reads as a refusal.
test fn a_missing_answer_is_pending_and_names_its_entry() -> Bool {
  match attempt_system_unit_harness_start_from_observation(entry: "n-a.k1", reading: AttemptSystemUnitAnswerMissing) {
    AttemptSystemUnitHarnessStarted => false
    AttemptSystemUnitHarnessFailed { detail: _ } => false
    AttemptSystemUnitHarnessPending { entry } => entry == "n-a.k1"
  }
}

test fn a_present_started_answer_is_harness_started() -> Bool {
  match attempt_system_unit_harness_start_from_observation(
    entry: "e",
    reading: AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted },
  ) {
    AttemptSystemUnitHarnessStarted => true
    AttemptSystemUnitHarnessPending { entry: _ } => false
    AttemptSystemUnitHarnessFailed { detail: _ } => false
  }
}

test fn an_unreadable_answer_is_a_failure_not_pending() -> Bool {
  match attempt_system_unit_harness_start_from_observation(entry: "e", reading: AttemptSystemUnitAnswerUnreadable { detail: "eio" }) {
    AttemptSystemUnitHarnessFailed { detail } => detail == "eio"
    AttemptSystemUnitHarnessStarted => false
    AttemptSystemUnitHarnessPending { entry: _ } => false
  }
}

test fn a_started_answer_decodes() -> Bool {
  match attempt_system_unit_decode_answer(content: "body\u{1e}started\n", request_body: "body") {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => true
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason: _ } } => false
    AttemptSystemUnitAnswerMissing => false
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
  }
}

fn body_kind_refused_with(kind: StatFileKind, needle: String) -> Bool {
  match attempt_system_unit_admit_body_kind(kind: kind) {
    AttemptSystemUnitBodyRegular => false
    AttemptSystemUnitBodyRefused { reason } => string_contains(s: reason, pattern: needle)
  }
}

test fn a_regular_file_body_is_admitted() -> Bool {
  match attempt_system_unit_admit_body_kind(kind: RegularFileKind) {
    AttemptSystemUnitBodyRegular => true
    AttemptSystemUnitBodyRefused { reason: _ } => false
  }
}

test fn a_fifo_or_symlink_body_kind_is_refused() -> Bool {
  body_kind_refused_with(kind: FifoKind, needle: "fifo")
    && body_kind_refused_with(kind: SymbolicLinkKind, needle: "symlink")
    && body_kind_refused_with(kind: DirectoryKind, needle: "directory")
}

fn live_with_instance_root(root: FilePath) -> HostDashboardInstance {
  let live = srv1_live_dashboard_instance()
  HostDashboardInstance {
    deployment: live.deployment,
    instance_id: live.instance_id,
    host_identity: live.host_identity,
    provision_parent_root: live.provision_parent_root,
    instance_root: root,
    local_origin_root: live.local_origin_root,
    local_origin_publish_ref: live.local_origin_publish_ref,
    repo_root: live.repo_root,
    dispatch_base_ref: live.dispatch_base_ref,
    dispatch_state_scope: live.dispatch_state_scope,
    execution_environment: live.execution_environment,
    provider_state: live.provider_state,
    serve_binary: live.serve_binary,
    serve_function: live.serve_function,
    listen_host: live.listen_host,
    listen_port: live.listen_port,
    tmux_server: live.tmux_server,
    actuation: live.actuation,
    provision_transport: live.provision_transport,
    source_seed: live.source_seed,
    admitted_revision: live.admitted_revision,
    toolchain: live.toolchain,
    dispatch_worker_memory_max: live.dispatch_worker_memory_max,
    directory_owner: live.directory_owner,
    worker: WorkerIsServiceUser,
    materialization_store_root: live.materialization_store_root,
    publication_base_branch: live.publication_base_branch,
  }
}

fn launch_argv_refused_separator(reading: AttemptSystemUnitLaunchArgv) -> Bool {
  match reading {
    AttemptSystemUnitLaunchArgvReady { argv: _ } => false
    AttemptSystemUnitLaunchArgvRefused { cause } =>
      match cause {
        NamedArgumentNameHoldsSeparator { name } => name == "instance_root"
        NamedArgumentNameEmpty => false
        NamedArgumentAdmitted { argument: _ } => false
      }
  }
}

test fn an_instance_root_holding_the_separator_refuses_at_argv_and_drain_install() -> Bool {
  let inst = live_with_instance_root(root: "/tmp/gunbc=separator" as FilePath)
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  launch_argv_refused_separator(reading: attempt_system_unit_launch_gunbc_argv_at(instance: inst, revision: rev))
    && match live_deploy_attempt_unit_drain_service_unit_file(spec: deployment_spec_srv1(), instance: inst, revision: rev) {
      AttemptUnitDrainServiceRefused { cause: c } => attempt_system_unit_launch_argv_refused_detail(cause: c) == attempt_system_unit_launch_argv_refused_detail(cause: NamedArgumentNameHoldsSeparator { name: "instance_root" })
      AttemptUnitDrainServiceReady { file: _ } => false
    }
}

test fn a_declared_instance_launch_argv_stays_ready() -> Bool {
  let live = srv1_live_dashboard_instance()
  let rev = RevisionBoundAtEmission { revision: deploy_witness_release_revision }
  match attempt_system_unit_launch_gunbc_argv_at(instance: live, revision: rev) {
    AttemptSystemUnitLaunchArgvRefused { cause: _ } => false
    AttemptSystemUnitLaunchArgvReady { argv: gunbc } => count(gunbc) > 0 && !any(gunbc, w => w == "/usr/bin/false")
  }
}

// AN ANSWER ANSWERS ITS OWN REQUEST. answers/<entry> is keyed by node and attempt key and outlives the run, so
// the answer a requester reads must echo the body it wrote. RED (fixture source): an earlier request's
// refusal sitting at the entry reads as Missing for a request with a different nonce, never as its outcome.
test fn an_answer_to_an_earlier_request_for_the_key_reads_as_not_yet_answered() -> Bool {
  match attempt_system_unit_decode_answer(content: "old-body\u{1e}refused\nwhy\n", request_body: "new-body") {
    AttemptSystemUnitAnswerMissing => true
    AttemptSystemUnitAnswerFound { answer: _ } => false
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
  }
}

test fn an_answer_echoing_the_request_body_is_its_outcome() -> Bool {
  match attempt_system_unit_decode_answer(content: "new-body\u{1e}refused\nwhy\n", request_body: "new-body") {
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitRefusedAnswer { reason } } => reason == "why"
    AttemptSystemUnitAnswerFound { answer: AttemptSystemUnitStarted } => false
    AttemptSystemUnitAnswerMissing => false
    AttemptSystemUnitAnswerUnreadable { detail: _ } => false
  }
}

test fn an_answer_that_echoes_no_body_is_unreadable_not_a_match() -> Bool {
  match attempt_system_unit_decode_answer(content: "started\n", request_body: "") {
    AttemptSystemUnitAnswerUnreadable { detail: _ } => true
    AttemptSystemUnitAnswerFound { answer: _ } => false
    AttemptSystemUnitAnswerMissing => false
  }
}

test fn two_requests_for_one_attempt_differ_in_their_encoded_body_by_nonce() -> Bool {
  let a = AttemptSystemUnitStartRequest { node_id: "n1", attempt_key: "k1", granted: kibibyte(count: 1), inner_argv: ["x"], nonce: "1" }
  let b = AttemptSystemUnitStartRequest { node_id: "n1", attempt_key: "k1", granted: kibibyte(count: 1), inner_argv: ["x"], nonce: "2" }
  match attempt_system_unit_encode_start(verb: StartDetached, request: a) {
    AttemptSystemUnitStartEncoded { body: ba } =>
      match attempt_system_unit_encode_start(verb: StartDetached, request: b) {
        AttemptSystemUnitStartEncoded { body: bb } => ba != bb
        AttemptSystemUnitStartUnencodable { cause: _ } => false
      }
    AttemptSystemUnitStartUnencodable { cause: _ } => false
  }
}

test fn a_nonce_that_is_not_one_safe_segment_is_unencodable() -> Bool {
  let r = AttemptSystemUnitStartRequest { node_id: "n1", attempt_key: "k1", granted: kibibyte(count: 1), inner_argv: ["x"], nonce: "a\nb" }
  match attempt_system_unit_encode_start(verb: StartDetached, request: r) {
    AttemptSystemUnitStartUnencodable { cause: AttemptSystemUnitNonceUnsafe } => true
    AttemptSystemUnitStartUnencodable { cause: _ } => false
    AttemptSystemUnitStartEncoded { body: _ } => false
  }
}

// EVERY SERVICE UNIT THE DEPLOYMENT EMITS THAT RUNS THE GUNBC BINARY IS PLACED IN A BOUNDED SLICE. gunbc refuses to
// run in system.slice (user_work_scope UncappedSystemSlice), so a gunbc-running service with no Slice= starts,
// is refused, and trips its start limit; the drain service was emitted so at e926e9f9 and a lab apply reported
// success over it. The predicate reads the typed legs of the apply plan, the same artifact the host receives.
fn service_body_of_payload(payload: String) -> String {
  match split(s: payload, delimiter: "\n[").first() {
    Present { value: body } => body
    Absent => ""
  }
}

fn leg_install_payload(leg: DeployApplyLeg) -> String {
  match leg {
    ApplyLegInstallFile { step: _, command: _, payload: p } => p
    _ => ""
  }
}

fn leg_install_dest(leg: DeployApplyLeg) -> String {
  match leg {
    ApplyLegInstallFile { step: _, command: c, payload: _ } => last_or_empty(parts: c.arguments)
    _ => ""
  }
}

fn gunbc_running_service_bodies(legs: List<DeployApplyLeg>) -> List<String> {
  filter(
    map(
      filter(legs, l => string_contains(s: leg_install_payload(leg: l), pattern: "[Service]")),
      l => service_body_of_payload(payload: join(skip(split(s: leg_install_payload(leg: l), delimiter: "[Service]"), 1), "")),
    ),
    body => string_contains(s: body, pattern: "ExecStart=") && string_contains(s: body, pattern: " run --source-root"),
  )
}

// A Slice= that names a slice the deployment never installs gets no MemoryMax (systemd creates it unbounded),
// and gunbc refuses in it exactly as in system.slice. So the law is "names a slice this apply installs with a
// MemoryMax", and the installed set is read from the apply's own install legs: each `[Slice]` unit payload that
// carries MemoryMax= is installed at `<dir>/<name>.slice`.
fn first_or_empty(parts: List<String>) -> String {
  match parts.first() {
    Present { value: head } => head
    Absent => ""
  }
}

fn last_or_empty(parts: List<String>) -> String {
  first_or_empty(parts: skip(parts, count(parts) - 1))
}

fn basename_of(path: String) -> String {
  last_or_empty(parts: split(s: path, delimiter: "/"))
}

fn installed_bounded_slices(legs: List<DeployApplyLeg>) -> List<String> {
  map(
    filter(legs, l => string_contains(s: leg_install_payload(leg: l), pattern: "[Slice]") && string_contains(s: leg_install_payload(leg: l), pattern: "\nMemoryMax=")),
    l => basename_of(path: leg_install_dest(leg: l)),
  )
}

fn service_slice_name(body: String) -> String {
  let after_key = first_or_empty(parts: skip(split(s: body, delimiter: "\nSlice="), 1))
  first_or_empty(parts: split(s: after_key, delimiter: "\n"))
}

fn gunbc_running_services_are_all_sliced(legs: List<DeployApplyLeg>) -> Bool {
  let installed = installed_bounded_slices(legs: legs)
  all(
    gunbc_running_service_bodies(legs: legs),
    body => any(installed, sl => service_slice_name(body: body) == sl),
  )
}

test fn every_gunbc_running_service_in_the_lab_apply_names_a_bounded_slice() -> Bool {
  let legs = full_install_legs(spec: selected_deployment_spec(row: srv1_lab_desired_deployment()))
  count(gunbc_running_service_bodies(legs: legs)) > 0
    && gunbc_running_services_are_all_sliced(legs: legs)
}

test fn the_drain_service_names_the_deployment_slice() -> Bool {
  let spec = selected_deployment_spec(row: srv1_lab_desired_deployment())
  string_contains(s: full_install_apply_text(spec: spec), pattern: join(["Slice=", deployment_slice_unit_name(names: spec.names) as String], ""))
}

fn fixture_apply(slice_line: String) -> List<DeployApplyLeg> {
  [
    apply_staged_leg(step: "s", dest: "/etc/systemd/system/gunbc-bounded.slice", payload: "[Unit]\nDescription=s\n\n[Slice]\nMemoryMax=1\n"),
    apply_staged_leg(step: "u", dest: "/etc/systemd/system/gunbc-unbounded.slice", payload: "[Unit]\nDescription=u\n\n[Slice]\nMemoryHigh=1\n"),
    apply_staged_leg(step: "x", dest: "/etc/systemd/system/x.service", payload: join(["[Unit]\nDescription=x\n[Service]\nType=oneshot\n", slice_line, "ExecStart=/opt/gunbc run --source-root /d --entry /e\n[Install]\nWantedBy=x\n"], "")),
  ]
}

test fn a_gunbc_running_service_without_a_slice_is_found_unsliced() -> Bool {
  !gunbc_running_services_are_all_sliced(legs: fixture_apply(slice_line: ""))
}

test fn a_gunbc_running_service_in_an_installed_bounded_slice_is_found_sliced() -> Bool {
  let sliced = fixture_apply(slice_line: "Slice=gunbc-bounded.slice\n")
  count(gunbc_running_service_bodies(legs: sliced)) == 1
    && gunbc_running_services_are_all_sliced(legs: sliced)
}

test fn a_gunbc_running_service_in_system_slice_is_found_unsliced() -> Bool {
  !gunbc_running_services_are_all_sliced(legs: fixture_apply(slice_line: "Slice=system.slice\n"))
}

test fn a_gunbc_running_service_in_a_slice_the_apply_never_installs_is_found_unsliced() -> Bool {
  !gunbc_running_services_are_all_sliced(legs: fixture_apply(slice_line: "Slice=gunbc-never-installed.slice\n"))
}

test fn a_gunbc_running_service_in_an_installed_slice_with_no_memory_max_is_found_unsliced() -> Bool {
  !gunbc_running_services_are_all_sliced(legs: fixture_apply(slice_line: "Slice=gunbc-unbounded.slice\n"))
}

// THE ROOT-OWNED RELEASE SNAPSHOT IS RETIRED PER LOCUS, AFTER EVERY UNIT THAT NAMES IT STANDS. The drain's
// units execute the new snapshot, so the superseded releases are swept only once the units are installed and
// the path unit restarted. RED (fixture legs): a retire ahead of the unit installs is found out of order;
// POSITIVE CONTROL: the real plan, whose retire leg is last.
fn snapshot_retired_after_the_units_are_installed(legs: List<DeployApplyLeg>) -> Bool {
  let retire = leg_index(legs: legs, step: "attempt-unit-helper-snapshot-retire")
  retire >= 0
    && leg_index(legs: legs, step: "attempt-unit-helper-snapshot") >= 0
    && leg_index(legs: legs, step: "attempt-unit-helper-snapshot") < leg_index(legs: legs, step: "attempt-unit-drain-service-unit")
    && retire > leg_index(legs: legs, step: "attempt-unit-drain-service-unit")
    && retire > leg_index(legs: legs, step: "attempt-unit-drain-path-unit")
    && retire > leg_index(legs: legs, step: "attempt-unit-drain-restart")
}

test fn the_full_install_retires_the_launcher_snapshot_after_the_drain_units_are_installed() -> Bool {
  snapshot_retired_after_the_units_are_installed(legs: full_install_legs(spec: deployment_spec_srv1()))
    && snapshot_retired_after_the_units_are_installed(legs: full_install_legs(spec: selected_deployment_spec(row: srv1_lab_desired_deployment())))
}

fn snapshot_leg_fixture(step_words: List<String>) -> List<DeployApplyLeg> {
  map(step_words, w => apply_staged_leg(step: w, dest: "/x", payload: ""))
}

test fn a_snapshot_retire_ahead_of_the_drain_unit_installs_is_found_out_of_order() -> Bool {
  !snapshot_retired_after_the_units_are_installed(legs: snapshot_leg_fixture(step_words: [
    "attempt-unit-helper-snapshot", "attempt-unit-helper-snapshot-retire", "attempt-unit-drain-service-unit",
    "attempt-unit-drain-path-unit", "attempt-unit-drain-restart",
  ]))
}

test fn a_snapshot_retire_after_the_drain_unit_installs_is_found_in_order() -> Bool {
  snapshot_retired_after_the_units_are_installed(legs: snapshot_leg_fixture(step_words: [
    "attempt-unit-helper-snapshot", "attempt-unit-drain-service-unit", "attempt-unit-drain-path-unit",
    "attempt-unit-drain-restart", "attempt-unit-helper-snapshot-retire",
  ]))
}

// THE LOCI ARE NOT SHARED, so a retire per locus cannot delete a snapshot another instance's units still name.
// The launcher's locus is `<attempt-system-unit-helpers>/<instance>`; the retire sweeps only the children of its own
// base, so the claim is that two instances' bases are disjoint. (The approval broker's helper locus the claim once
// also named was deleted with the broker's helper grant, #14890.)
fn base_is_path_prefix_of(base: String, other: String) -> Bool {
  other == base || starts_with(s: other, prefix: join([base, "/"], ""))
}

test fn the_drain_helper_snapshots_of_two_instances_live_in_disjoint_loci() -> Bool {
  let live_base = attempt_system_unit_launcher_locus(instance: srv1_live_dashboard_instance()).base
  let lab_base = attempt_system_unit_launcher_locus(instance: srv1_lab_dashboard_instance()).base
  let legs = full_install_legs(spec: deployment_spec_srv1())
  leg_index(legs: legs, step: "attempt-unit-helper-snapshot-retire") >= 0
    && !base_is_path_prefix_of(base: live_base, other: lab_base)
    && !base_is_path_prefix_of(base: lab_base, other: live_base)
}

fn answered(refusal: String?) -> AttemptUnitEntryOutcome {
  AttemptUnitEntryHandled { handled: AttemptUnitAnswered { refusal: refusal } }
}

// A refusal is an answer: the pass counts it and its exit stays success. POSITIVE CONTROL: a started request.
test fn a_refused_request_is_counted_and_does_not_fail_the_pass() -> Bool {
  let pass = attempt_unit_pass_of(outcomes: [answered(refusal: Present { value: "start request is truncated" })])
  pass.refused == 1 && pass.retired == 1 && exit_is_success(e: pass.exit)
}

// RED: a refusal whose cause text is empty is still a refusal (presence is the fact, not the text).
test fn a_refusal_with_empty_cause_text_is_still_counted() -> Bool {
  let pass = attempt_unit_pass_of(outcomes: [answered(refusal: Present { value: "" })])
  pass.refused == 1 && pass.retired == 1
}

test fn a_started_request_is_retired_without_a_refusal() -> Bool {
  let pass = attempt_unit_pass_of(outcomes: [answered(refusal: Absent)])
  pass.refused == 0 && pass.retired == 1 && exit_is_success(e: pass.exit)
}

// RED: the drain failing at its job (no answer written) fails the pass, and stays failed past later refusals.
test fn a_request_whose_answer_cannot_be_written_fails_the_pass() -> Bool {
  let pass = attempt_unit_pass_of(outcomes: [
    AttemptUnitEntryHandled { handled: AttemptUnitAnswerUnwritten { reason: "k: the answer could not be written" } },
    answered(refusal: Present { value: "x" }),
  ])
  match pass.exit {
    ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "could not be written") && pass.refused == 1
    ExitSuccess => false
  }
}

// The FIRST failure in entry order is the exit, and unmovable entries are listed in entry order and counted
// apart from the retired ones; a skipped (already-claimed) entry changes nothing.
test fn the_pass_keeps_the_first_failure_and_lists_unmovable_entries_in_order() -> Bool {
  let pass = attempt_unit_pass_of(outcomes: [
    AttemptUnitEntrySkipped,
    AttemptUnitEntryUnmovable { entry: "a", step: SpoolStallClaim, cause: "c1" },
    answered(refusal: Absent),
    AttemptUnitEntryUnmovable { entry: "b", step: SpoolStallClaim, cause: "c2" },
  ])
  let names = map(pass.unmovable, u => u.entry)
  pass.retired == 1 && count(pass.unmovable) == 2 && names == ["a", "b"]
    && match pass.exit {
      ExitFailure { code: _, reason: r } => string_contains(s: r, pattern: "a: unmovable at claim")
      ExitSuccess => false
    }
}

fn exit_is_success(e: ProcessExit) -> Bool {
  match e {
    ExitSuccess => true
    ExitFailure { code: _, reason: _ } => false
  }
}

// ── THE DEDICATED WORKER'S START: its git trust and its credential ─────────────────────────────────────

// The request names THIS instance's binary: claim_request names the lab's, which the live instance's admission
// refuses (ExecStart program is not the instance gunbc binary), and a refused start has no words to judge.
fn instance_request(instance: HostDashboardInstance) -> AttemptSystemUnitStartRequest {
  AttemptSystemUnitStartRequest {
    node_id: "n1",
    attempt_key: "k1",
    granted: kibibyte(count: 1),
    inner_argv: [instance.serve_binary as String, "run"],
    nonce: "n",
  }
}

fn worker_start_words(instance: HostDashboardInstance) -> List<String> {
  match attempt_system_unit_start_facts_for_request(instance: instance, request: instance_request(instance: instance)) {
    AttemptSystemUnitStartUnderivable { reason: _ } => []
    AttemptSystemUnitStartDerived { facts } =>
      match attempt_system_unit_start_admitted(instance: instance, facts: facts) {
        AttemptSystemUnitRefused { reason: _ } => []
        AttemptSystemUnitAdmitted { unit: unit, facts: admitted } =>
          match attempt_system_unit_systemd_run_command(instance: instance, plan: attempt_system_unit_plan_from_facts(facts: admitted, unit: unit), granted: admitted.granted, user: admitted.user) {
            SystemdRunCommandRefused { cause: _ } => []
            SystemdRunCommandReady { command } => argv_words(command: command)
          }
      }
  }
}

// THE DEDICATED WORKER TRUSTS EXACTLY ITS OWN WORKTREE, AND NOTHING ELSE. The service user owns the worktree, so
// every git call by a dedicated worker account was refused with "detected dubious ownership" (srv1 lab,
// 2026-10-24); the unit is started with git's safe.directory grant naming that one worktree, in the environment so
// the tools' git inherits it. A service-user worker owns its worktree and is started with no grant. RED on a lab
// start without the grant, and on any grant wider than the one worktree (the wildcard, or a second path).
test fn the_dedicated_worker_starts_trusting_only_its_own_worktree() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let lab_words = worker_start_words(instance: lab)
  let live_words = worker_start_words(instance: srv1_live_dashboard_instance())
  let worktree = dispatch_worktree_path_for_instance(instance: lab, node_id: "n1" as RoadmapNodeId, attempt_key: "k1")
  count(lab_words) > 0 && count(live_words) > 0
    && any(lab_words, w => w == "--setenv=GIT_CONFIG_COUNT=1")
    && any(lab_words, w => w == "--setenv=GIT_CONFIG_KEY_0=safe.directory")
    && any(lab_words, w => w == join(["--setenv=GIT_CONFIG_VALUE_0=", worktree], ""))
    && count(filter(lab_words, w => starts_with(s: w, prefix: "--setenv=GIT_CONFIG_"))) == 3
    && !any(lab_words, w => w == "--setenv=GIT_CONFIG_VALUE_0=*")
    && !any(live_words, w => starts_with(s: w, prefix: "--setenv=GIT_CONFIG_"))
}

fn credstore_copy_legs_of(legs: List<DeployApplyLeg>) -> List<DeployApplyLeg> {
  filter(legs, l => match l {
    ApplyLegCredstoreCopy { step: _, source: _, dest: _, file_name: _ } => true
    _ => false
  })
}

// THE DEPLOY INSTALLS THE FILE THE LAUNCHER LOADS, AND ONE FUNCTION SPELLS ITS PATH. The lab apply carries one
// credstore copy per credential, after the credstore directory; its destination and name are exactly the source
// and identifier of the LoadCredential= word in the lab worker's start, and its source is the service user's
// custody, which no start word names. Production's service-user worker gets no copy and loads nothing. RED on a
// deploy or a launcher that spells the credstore path on its own (the two would differ), on a deploy that installs
// nothing for the file the launcher names, and on a start that loads the custody path itself.
test fn the_lab_apply_installs_exactly_the_credstore_file_the_worker_start_loads() -> Bool {
  let lab = srv1_lab_dashboard_instance()
  let legs = full_install_legs(spec: selected_deployment_spec(row: srv1_lab_desired_deployment()))
  let copies = credstore_copy_legs_of(legs: legs)
  let creds = dispatch_worker_credentials(instance: lab)
  let words = worker_start_words(instance: lab)
  let loads = filter(words, w => starts_with(s: w, prefix: "LoadCredential="))
  count(creds) == 1 && count(copies) == count(creds) && count(loads) == count(creds)
    && leg_index(legs: legs, step: "worker-credstore-dir") >= 0
    && leg_index(legs: legs, step: "worker-credstore-dir") < leg_index(legs: legs, step: "worker-credstore-copy")
    && all(copies, l => match l {
      ApplyLegCredstoreCopy { step: _, source: s, dest: d, file_name: f } =>
        any(loads, w => w == join(["LoadCredential=", f as String, ":", d as String], ""))
          && !any(words, w => string_contains(s: w, pattern: s as String))
      _ => false
    })
    && count(credstore_copy_legs_of(legs: full_install_legs(spec: deployment_spec_srv1()))) == 0
    && !any(worker_start_words(instance: srv1_live_dashboard_instance()), w => starts_with(s: w, prefix: "LoadCredential="))
}

// THE COPY IS THE PRIVATE-SECRET BRACKET'S ORDER, AND ROOT NEVER NAMES THE CUSTODY PATH. Rendered at one stage:
// the stage is a fresh mktemp -d; the principal's own copy (no sudo) reads the custody into the stage owner-only;
// the root install (sudo, 0400, root:root) reads the STAGE file, never the custody; then rm -f of the file and
// rmdir of the stage. RED on a root install that reads the custody path, a user copy that elevates, a copy wider
// than 0600, or a removal that is recursive (rmdir is the check that the stage ended empty).
test fn the_credstore_copy_stages_copies_as_the_user_installs_as_root_and_removes_the_stage() -> Bool {
  let stage = "/tmp/gunbc-credstore.abc123" as NonEmptyStr
  let source = "/home/svc/.config/gunbc-gpu-pod/api-key" as NonEmptyStr
  let dest = "/etc/credstore/gunbc-gpu-pod-api-key-lab" as NonEmptyStr
  let cmds = credstore_copy_commands(stage: stage, source: source, dest: dest, file_name: "gunbc-gpu-pod-api-key" as NonEmptyStr)
  let staged = join([stage as String, "/gunbc-gpu-pod-api-key"], "")
  let mk = argv_words(command: credstore_copy_stage_command())
  let user = argv_words(command: cmds.user_copy)
  let root = argv_words(command: cmds.root_install)
  let rmf = argv_words(command: cmds.remove_file)
  let rmd = argv_words(command: cmds.remove_dir)
  (match mk.first() { Present { value: p } => p == "mktemp"  Absent => false }) && any(mk, w => w == "-d")
    && (match user.first() { Present { value: p } => p == "install"  Absent => false })
    && !any(user, w => ends_with(s: w, suffix: "sudo")) && any(user, w => w == (source as String)) && any(user, w => w == staged) && any(user, w => w == "0600")
    && (match root.first() { Present { value: p } => ends_with(s: p, suffix: "/sudo")  Absent => false }) && any(root, w => w == staged) && any(root, w => w == (dest as String)) && any(root, w => w == "0400")
    && !any(root, w => string_contains(s: w, pattern: source as String))
    && rmf == ["rm", "-f", staged] && rmd == ["rmdir", stage as String]
}

