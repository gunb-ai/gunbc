import gunbc.live_deploy.release_locus { RevisionBoundAtEmission }
import gunbc.live_deploy.emit { attempt_system_unit_grant_steps }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import gunbc.fleet.fleet_posix_accounts { fleet_posix_ci_runner_principal }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }
import test.claim.live_deploy.apply_emission_projection { pipeline_steps_text }
import gunbc.ci.ci_release_bins { gunbc_release_bin_name }
import gunbc.roadmap.roadmap_attempt_exit_spool {
  attempt_exit_hook, AttemptExitHookRendered, AttemptExitHookRefused, AttemptWorkerRole,
}
import gunbc.roadmap.attempt_system_unit_launch {
  AttemptSystemUnitStartFacts, AttemptSystemUnitAdmitted, AttemptSystemUnitRefused,
  attempt_system_unit_start_admitted, attempt_system_unit_control_admitted,
  AttemptSystemUnitStop, attempt_system_unit_privileged_effect, attempt_system_unit_sudoers_body,
  attempt_system_unit_sudoers_path, attempt_system_unit_name_admitted,
  attempt_system_unit_systemd_run_command, attempt_system_unit_plan_from_facts,
  attempt_system_unit_launcher_helpers_root, attempt_system_unit_launcher_dir,
}
import gunbc.auth.authorization_pattern_selection {
  select_authorization_pattern, PatternSelected, FederatedScopedGrant, OperatorApprovedCapability,
  HumanOnlyStep, OperatorOwnSession, ManualStepRequired, NoAdmissiblePattern,
