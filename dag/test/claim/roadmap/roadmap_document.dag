module test.claim.roadmap.roadmap_document

import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.roadmap.roadmap_document { RoadmapDocument, RoadmapSection, project_roadmap_to_markdown }
import gunbc.roadmap.roadmap_model { RoadmapNodeId, RoadmapNode, RoadmapEdge, Pointer, WorkItemDispatch, NotDispatchable, SectionElement, section_group }
import gunbc.roadmap.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine }
import gunbc.roadmap.roadmap_execution_contract { ExecutionContractUnspecified }
import std.markdown { MarkdownBlock, HeadingBlock, ParagraphBlock, TextInline, H1 }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data audit_id: RoadmapNodeId = "fail-closed-audit"
data status_id: RoadmapNodeId = "pr-checkbox-status"
data child_id: RoadmapNodeId = "host-fed-status-bridge"

fn audit_node() -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_J19302B1RYEQZVMM6TG9" as RoadmapNodeIdentity,
    node: audit_id,
    line: AuthoredLine { content: "**fail-open audit**" },
    carriers: [Pointer { label: "plan", path: "docs/plans/scaffold-admission-doctrine.md" }],
    dispatch: NotDispatchable,
    execution: ExecutionContractUnspecified,
    owner: "",
    parent: none,
    centering: none,
  }
}

fn status_node() -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_AJ7G9SDD8FFX86WHFYQB" as RoadmapNodeIdentity,
    node: status_id,
    line: DerivableLine { prs: [5491], title: "**PR-checkbox status**", description: "" },
    carriers: [],
    dispatch: NotDispatchable,
    execution: ExecutionContractUnspecified,
    owner: "",
    parent: none,
    centering: none,
  }
}
fn roadmap_document_child_node() -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx_ABYCNZ3BDSY98CHYC51T" as RoadmapNodeIdentity,
    node: child_id,
    line: AuthoredLine { content: "**host-fed status bridge**" },
    carriers: [],
    dispatch: NotDispatchable,
    execution: ExecutionContractUnspecified,
    owner: "",
    parent: none,
    centering: none,
  }
}

fn lockdown_section() -> RoadmapSection {
  RoadmapSection {
    title: "0. Fail-closed lock-down",
    elements: [section_group(label: "", nodes: [audit_node()], edges: [])],
  }
}
fn expansion_section() -> RoadmapSection {
  RoadmapSection {
    title: "6. Expansion",
    elements: [section_group(
      label: "",
      nodes: [status_node(), roadmap_document_child_node()],
      edges: [RoadmapEdge { child: child_id, parent: status_id }],
    )],
  }
}

fn preamble() -> List<MarkdownBlock> {
  [
    HeadingBlock { level: H1, inlines: [TextInline { text: "ROADMAP" }] },
    ParagraphBlock { inlines: [TextInline { text: "Generated from .dag authority — do not hand-edit." }] },
  ]
}

fn authority() -> RoadmapDocument {
  RoadmapDocument { preamble: preamble(), lead_lanes: [], sections: [lockdown_section(), expansion_section()] }
}

fn emit_roadmap(merged: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_to_markdown(doc: authority(), merged: merged))
}

test fn witness_preamble_first() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "# ROADMAP")
    && string_contains(s: out, pattern: "Generated from .dag authority")
}

test fn witness_both_sections() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "## 0. Fail-closed lock-down")
    && string_contains(s: out, pattern: "## 6. Expansion")
}

// witness_authored_evidence_awaiting_acceptance is DELETED with the field it needed. Its subject was an
// AUTHORED row awaiting an acceptance receipt — at base that reading came from AuthoredLine.done, a flag
// the plan wrote for itself to say its work had ended, which is the fact this change leaves to the roadmap
// event log alone (gunbc.design_argument::planning_has_one_home). It is not retargeted: an authored row
// carries no implementation evidence, so there is nothing for it to await a receipt on. The two claims
// that remain say what the document does render, and the exact-bytes claim above is the one that pins an
// authored row to having NO suffix — a stale second home can now only fail that claim, not pass this one.
test fn witness_derived_merged_awaiting_acceptance() -> Bool {
  let out = emit_roadmap(merged: [5491])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && string_contains(s: out, pattern: "⏳ awaiting an acceptance receipt")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

test fn witness_derived_unchecked_when_unmerged() -> Bool {
  let out = emit_roadmap(merged: [])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

// The pinned bytes of the emitted document. They moved with this change, in ONE place, and the reason is
// the second home: the "fail-open audit" row is an AuthoredLine, and at base it carried `done: true`,
// which is what put " — ⏳ awaiting an acceptance receipt" on its row. An authored done-flag is the plan
// asserting that a node's work has ended, which is the fact this change gives to the roadmap event log
// alone (gunbc.design_argument::planning_has_one_home), so the field is gone (with its witness,
// witness_authored_done_is_authored in gunbc.test.claim.roadmap.roadmap_status) and an authored row now
// carries no evidence claim of its own: only a DerivableLine whose PRs have all merged can await a
// receipt. That is why "#5491" keeps its suffix and this row does not.
fn expected_roadmap() -> String {
  join([
    "# ROADMAP\n",
    "\n",
    "Generated from .dag authority — do not hand-edit.\n",
    "\n",
    "## 0. Fail-closed lock-down\n",
    "\n",
    "- [ ] **fail-open audit** [plan](docs/plans/scaffold-admission-doctrine.md)\n",
    "\n",
    "## 6. Expansion\n",
    "\n",
    "- [ ] **PR-checkbox status** (#5491) — ⏳ awaiting an acceptance receipt\n",
    "  - [ ] **host-fed status bridge**\n"
  ], "")
}

test fn witness_exact_bytes() -> Bool {
  emit_roadmap(merged: [5491]) == expected_roadmap()
}

test fn witness_roadmap_document_drift_receipt() -> Bool {
  emit_roadmap(merged: [5491]) == expected_roadmap()
    && !(emit_roadmap(merged: []) == expected_roadmap())
}
