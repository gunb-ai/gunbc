module test.claim.roadmap.roadmap_publish_actuate_witness

import std.types { Bool, String, NonEmptyStr, FilePath }
import gunbc.roadmap.roadmap_publish { PublicationReceiptOutcome, ReceiptBound }
import gunbc.roadmap.roadmap_publish_actuate {
  pull_request_created_outcome, attempt_branch_refspec, publication_mirror_ref,
}
import extdeps.git {
  git_dir_fetch_source_grant, git_non_bare_git_dir, git_local_fetch_source_grant,
  git_isolated_home_env_argv, git_push_ref_in_repo_argv,
}

test fn a_created_pull_request_binds_the_receipt() -> Bool {
  match pull_request_created_outcome(number: 7, html_url: "https://github.com/x/y/pull/7" as NonEmptyStr) {
    ReceiptBound { pr_number, url, draft } => pr_number == 7 && url as String == "https://github.com/x/y/pull/7" && draft == false
    _ => false
  }
}

test fn the_attempt_refspec_pushes_the_branch_to_its_own_remote_name() -> Bool {
  attempt_branch_refspec(branch: "dispatch/n1-aabc" as NonEmptyStr) == "dispatch/n1-aabc:refs/heads/dispatch/n1-aabc"
}

test fn the_push_environment_names_a_private_home_and_not_a_token() -> Bool {
  let prefix = git_isolated_home_env_argv(home: "/tmp/publication-home" as FilePath)
  let argv = git_push_ref_in_repo_argv(
    repo: "/tmp/mirror.git" as FilePath,
    remote: "https://github.com/gunb-ai/gunbc.git",
    refspec: "dispatch/n1-aabc:refs/heads/dispatch/n1-aabc",
    home: "/tmp/publication-home" as FilePath,
  )
  prefix == ["env", "HOME=/tmp/publication-home", "GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1"]
    && argv == concat(prefix, ["git", "-C", "/tmp/mirror.git", "push", "--quiet", "https://github.com/gunb-ai/gunbc.git", "dispatch/n1-aabc:refs/heads/dispatch/n1-aabc"])
}

test fn a_resolved_git_dir_grant_does_not_append_dot_git() -> Bool {
  let git_dir = "/opt/gunbc/gunbc/.git" as NonEmptyStr
  git_dir_fetch_source_grant(git_dir: git_dir).path == git_dir
    && git_local_fetch_source_grant(source: "/opt/gunbc/gunbc" as NonEmptyStr).path == git_non_bare_git_dir(worktree: "/opt/gunbc/gunbc" as NonEmptyStr)
}

test fn the_mirror_ref_is_the_policy_branch() -> Bool {
  publication_mirror_ref(branch: "dispatch/n1-aabc" as NonEmptyStr) == "refs/heads/dispatch/n1-aabc"
}
