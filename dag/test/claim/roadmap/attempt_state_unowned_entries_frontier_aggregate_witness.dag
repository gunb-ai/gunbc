module test.claim.roadmap.attempt_state_unowned_entries_frontier_aggregate_witness

// Controls (d) and (e) of the unowned-class frontier identity join: the group must reach the CENSUS AGGREGATE by
// identity, and the join must be complete. They sit in their own entry because reading the aggregate pulls the
// whole census closure, and that closure does not resolve on current main:
//   dag/extdeps/github/code_search.dag:204:11: error: undefined variable 'Bearer'
// (an unimported std.types name -- the #15247 rule -- which #15694's sweep left in 47 files, code_search.dag
// included; origin/main bace369f7a67 carries it). NOT patched here: the file is outside this PR's diff. These two
// claims are therefore RED as closure diagnostics on any head containing #15694, and that is reported, not hidden.

import std.types { Bool, String, Int, List }
import std.roster_frontier { FrontierRow, FrontierSubject, PathSubject, DeclSubject }
import gunbc.census_closure_frontier { census_closure_frontier_rows }
import test.claim.roadmap.attempt_state_unowned_entries_frontier_witness {
  attempt_state_unowned_class_identity_roster, row_identity_key, first_missing_in,
}

// (d) The group is present in the census aggregate (each identity found among all aggregate rows).
test fn the_unowned_entries_frontier_group_is_in_the_census_aggregate() -> Bool {
  let aggregate = census_closure_frontier_rows()
  any(attempt_state_unowned_class_identity_roster, id =>
    any(aggregate, r => row_identity_key(row: r) == id)
  )
}

// (e) Identity join completeness: every roster identity is present in the census aggregate.
test fn unowned_entries_identity_join_complete_in_aggregate() -> Bool {
  let aggregate = census_closure_frontier_rows()
  first_missing_in(roster: attempt_state_unowned_class_identity_roster, rows: aggregate) == ""
}
