module test.claim.roadmap.dispatch_worker_confinement_witness

import std.types { Bool, String, List, NonEmptyStr }
import gunbc.roadmap.roadmap_dispatch_actuator {
  dispatch_worker_unit_properties,
  dispatch_worker_exec_stop_post_for_systemd_run,
  dispatch_worker_writable_path_list,
  dispatch_worker_writable_paths,
  dispatch_worker_path_is_writable,
  attempt_state_prepare_argv_for_instance,
  dispatch_attempt_verification_dir_for_instance,
  dispatch_attempt_state_path_for_instance,
  dispatch_attempt_worker_log_path_for_instance,
  dispatch_attempt_launch_path_for_instance,
  attempt_unit_substate_has_exited,
  dispatch_review_unit_properties,
}
import gunbc.roadmap.roadmap_attempt_request_record { attempt_request_binding_path_for_instance }
import std.filesystem { path_parent_directory }
import extdeps.systemd { SystemdUnitProperty, systemd_unit_property_wire }
import extdeps.systemd.systemd_run { SystemdRunProperty }
import gunbc.roadmap.roadmap_model { RoadmapNodeId }
import std.measure { kibibyte }
import gunbc.roadmap.roadmap_session_placement { session_process_bounds }
import gunbc.roadmap.roadmap_dashboard_instance {
  HostDashboardInstance,
