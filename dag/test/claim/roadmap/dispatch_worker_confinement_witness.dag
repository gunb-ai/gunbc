import gunbc.roadmap.roadmap_attempt_exit_spool { attempt_exit_hook, AttemptExitHookRendered, AttemptExitHookRefused, AttemptWorkerRole }

// MEMBERSHIP OF THE RENDERED PROPERTIES, not kernel enforcement. On srv1 the user manager drops
// ProtectSystem/ProtectHome/ReadWritePaths when kernel.apparmor_restrict_unprivileged_userns=1
// blocks the mount namespace (bright-moth-475, issuecomment-6175000334). That class is
// gunbc.recurring_failure_mode.sandbox_properties_declared_but_not_enforced_by_the_realization and
// gunbc.rung_drop.user_manager_worker_write_boundary_unenforced. The wet probe that starts a real
// transient is test.claim.roadmap.dispatch_worker_writable_sandbox_wet_witness.
fn property_words(props: List<SystemdRunProperty>) -> List<String> {
  props |> map(p => concat(systemd_unit_property_wire(property: p.property) as String, concat("=", p.value as String)))
}

fn has_property(props: List<SystemdRunProperty>, needle: String) -> Bool {
  any(property_words(props: props), p => string_contains(s: p, pattern: needle))
}

test fn the_worker_unit_confines_writes_to_the_instance_root() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", attempt_worktree: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1048576), process_bounds: session_process_bounds, exit_hook: "mkdir -- /i/attempt-exit-spool/inbox/n+k+x" as NonEmptyStr)
  let expected = dispatch_worker_writable_paths(instance: inst, attempt_worktree: "/wt", scratch_directory: "/wt")
  has_property(props: props, needle: "ProtectSystem=strict")
    && has_property(props: props, needle: "ProtectHome=read-only")
    && has_property(props: props, needle: "PrivateTmp=yes")
    && has_property(props: props, needle: "NoNewPrivileges=yes")
    && has_property(props: props, needle: "RestrictSUIDSGID=yes")
    && has_property(props: props, needle: "CapabilityBoundingSet=")
    && has_property(props: props, needle: join(["ReadWritePaths=", expected], ""))
    && has_property(props: props, needle: "/.git/objects")
    && any(dispatch_worker_writable_path_list(instance: inst, attempt_worktree: "/wt", scratch_directory: "/wt"), p => p == "/wt")
    && any(dispatch_worker_writable_path_list(instance: inst, attempt_worktree: "/wt", scratch_directory: "/wt"), p => p == join([inst.repo_root as String, "/.git/objects"], ""))
    && !any(dispatch_worker_writable_path_list(instance: inst, attempt_worktree: "/wt", scratch_directory: "/wt"), p => p == join([inst.repo_root as String, "/.git"], ""))
}

// DISCRIMINATING ON THE PRODUCTION INSTANCE: ReadWritePaths=/opt/gunbc covered /opt/gunbc/bin and
// the deployed checkout. The writable set is this attempt's worktree, its scratch directory, and
// the common git dir (commit/stash/fetch), so a write to the binary or a source file is not a
// carved-out path. Sibling attempts, the attempt-state root, and the exit spool are not either.
test fn the_srv1_worker_cannot_write_the_deployed_binary_or_tree() -> Bool {
  let inst = srv1_live_dashboard_instance()
  let lab = srv1_lab_dashboard_instance()
  let node = "probe-node" as RoadmapNodeId
  let key = "probe-a-key"
  let wt = join([dashboard_instance_dispatch_worktree_root(instance: inst) as String, "/", key], "")
  let attempt = dispatch_attempt_state_path_for_instance(instance: inst, node_id: node, attempt_key: key)
  let log = dispatch_attempt_worker_log_path_for_instance(instance: inst, node_id: node, attempt_key: key)
  let scratch = path_parent_directory(path: log)
  let lab_wt = join([dashboard_instance_dispatch_worktree_root(instance: lab) as String, "/", key], "")
  let lab_log = dispatch_attempt_worker_log_path_for_instance(instance: lab, node_id: node, attempt_key: key)
  let lab_scratch = path_parent_directory(path: lab_log)
  let lab_props = dispatch_worker_unit_properties(instance: lab, working_directory: lab.repo_root as String, attempt_worktree: lab_wt, worker_log_path: lab_log, granted: kibibyte(count: 1048576), process_bounds: session_process_bounds, exit_hook: "true" as NonEmptyStr)
  string_contains(s: log, pattern: "/worker/worker-stdout.log")
    && scratch == join([attempt, "/worker"], "")
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: "/opt/gunbc")
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: "/opt/gunbc/bin")
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: inst.serve_binary as String)
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: inst.repo_root as String)
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/README.md"], ""))
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: wt)
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([wt, "/session/probe"], ""))
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: scratch)
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: log)
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: attempt)
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: attempt_request_binding_path_for_instance(instance: inst, node_id: node, attempt_key: key))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: dispatch_attempt_launch_path_for_instance(instance: inst, node_id: node, attempt_key: key))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([attempt, "/forged-owner-record"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: dashboard_instance_dispatch_attempt_state_root(instance: inst) as String)
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: dashboard_instance_dispatch_worktree_root(instance: inst) as String)
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git/worktrees/attempt"], ""))
    && dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git/objects"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git/hooks/post-commit"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git/config"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: join([inst.repo_root as String, "/.git/info/exclude"], ""))
    && !dispatch_worker_path_is_writable(instance: inst, attempt_worktree: wt, scratch_directory: scratch, path: attempt_exit_spool_root(instance_root: inst.instance_root as String))
    && !dispatch_worker_path_is_writable(instance: lab, attempt_worktree: lab_wt, scratch_directory: lab_scratch, path: lab.serve_binary as String)
    && !dispatch_worker_path_is_writable(instance: lab, attempt_worktree: lab_wt, scratch_directory: lab_scratch, path: lab.repo_root as String)
    && dispatch_worker_path_is_writable(instance: lab, attempt_worktree: lab_wt, scratch_directory: lab_scratch, path: lab_wt)
    && !any(dispatch_worker_writable_path_list(instance: lab, attempt_worktree: lab_wt, scratch_directory: lab_scratch), p => p == lab.repo_root as String)
    && any(dispatch_worker_writable_path_list(instance: lab, attempt_worktree: lab_wt, scratch_directory: lab_scratch), p => p == lab_wt)
    && has_property(props: lab_props, needle: join(["WorkingDirectory=", lab.repo_root as String], ""))
    && has_property(props: lab_props, needle: join(["ReadWritePaths=", lab_wt], ""))
}

// THE SAME DEFECT, ONE DIRECTORY OVER. The verify pass writes the current verification selection
// into <attempt>/verification/ with the same Filesystem.Write, and that directory was never in the
// prepare list: measured 2026-09-04, zero of twelve srv1 attempt directories and zero of thirty srv2
// attempt directories had verification/, every verify pass refused with ENOENT, and so verification
// had never run anywhere. Asserted through the actuator's own projection, not a literal.
test fn the_prepare_step_creates_the_verification_directory_with_the_attempt_directory() -> Bool {
  let instance = srv2_deploy_dashboard_instance()
  let node_id = "belt-cause-probe" as RoadmapNodeId
  let key = "a0123456789abcdef"
  let argv = attempt_state_prepare_argv_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  let wire = join(argv.args, separator: "\0")
  let verification_dir = dispatch_attempt_verification_dir_for_instance(
    instance: instance,
    node_id: node_id,
    attempt_key: key,
  )
  string_contains(s: wire, pattern: verification_dir)
    && string_contains(s: verification_dir, pattern: "/verification")
    && string_contains(
      s: wire,
      pattern: path_parent_directory(path: dispatch_attempt_worker_log_path_for_instance(
        instance: instance,
        node_id: node_id,
        attempt_key: key,
      )),
    )
}

// DISCRIMINATING: the worker unit no longer outlives its process (reversal of 2026-09-05, bold-bee-114
// ruling 2026-10-06): it carries no RemainAfterExit, so it stops when the worker exits and its
// ExecStopPost exit record is written at that moment; the record, not unit-loaded state, is the exit
// evidence once the unit is collected. SubState still decides exit for a unit that is loaded (a failed
// worker is retained as failed).
test fn the_worker_unit_stops_with_its_process_and_writes_its_exit_record() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", attempt_worktree: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1048576), process_bounds: session_process_bounds, exit_hook: "mkdir -- /i/attempt-exit-spool/inbox/n+k+x" as NonEmptyStr)
  !has_property(props: props, needle: "RemainAfterExit")
    && has_property(props: props, needle: "ExecStopPost=mkdir -- /i/attempt-exit-spool/inbox/n+k+x")
    && attempt_unit_substate_has_exited(substate: "exited")
    && attempt_unit_substate_has_exited(substate: "failed")
    && !attempt_unit_substate_has_exited(substate: "running")
    && !attempt_unit_substate_has_exited(substate: "stop-post")
}

// DISCRIMINATING: the reviewer may write only its review directory, and it runs from the repo root
// (the worktree as cwd made `gunbc run` refuse its own source roots, exit 101). With an exit hook it
// stops with its process and records its exit (bold-bee-114 ruling 2026-10-06: the reviewer's
// RemainAfterExit is removed); the hook is given, the inbox is NOT among its writable paths (the "+"
// prefix lets the hook write there while the reviewer cannot). The supervisor passes no hook and
// keeps RemainAfterExit.
test fn the_reviewer_unit_writes_only_its_review_directory_and_runs_from_the_repo_root() -> Bool {
  let inst = srv2_deploy_dashboard_instance()
  let props = dispatch_review_unit_properties(instance: inst, working_directory: inst.repo_root as String, log_path: "/r/log", review_dir: "/state/a/review", exit_hook: Present { value: "+mkdir -- /i/attempt-exit-spool/inbox/x" as NonEmptyStr })
  let supervisor = dispatch_review_unit_properties(instance: inst, working_directory: inst.repo_root as String, log_path: "/r/log", review_dir: "/state/a/supervisor", exit_hook: none)
  has_property(props: props, needle: "ReadWritePaths=/state/a/review")
    && !has_property(props: props, needle: "/.git/worktrees")
    && !has_property(props: props, needle: "ReadWritePaths=/i/attempt-exit-spool")
    && has_property(props: props, needle: join(["WorkingDirectory=", inst.repo_root as String], ""))
    && has_property(props: props, needle: "ProtectHome=read-only")
    && has_property(props: props, needle: "ExecStopPost=+mkdir -- /i/attempt-exit-spool/inbox/x")
    && !has_property(props: props, needle: "RemainAfterExit")
    && has_property(props: supervisor, needle: "RemainAfterExit=yes")
    && !has_property(props: supervisor, needle: "ExecStopPost")
}

// RED on d9eebf21f81: the confinement fold set neither NoNewPrivileges nor an empty
// CapabilityBoundingSet, so User=briansrls could sudo -n past ReadWritePaths.
test fn the_worker_unit_cannot_sudo_past_the_write_boundary() -> Bool {
  let inst = srv1_live_dashboard_instance()
  let props = dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", attempt_worktree: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1048576), process_bounds: session_process_bounds, exit_hook: "true" as NonEmptyStr)
  has_property(props: props, needle: "NoNewPrivileges=yes")
    && has_property(props: props, needle: "RestrictSUIDSGID=yes")
    && has_property(props: props, needle: "CapabilityBoundingSet=")
}

// RED on d9eebf21f81: ExecStopPost carried ${INVOCATION_ID} unescaped, and the live worker inbox
// record kept those literal names. systemd-run -p expands $ once; $$ survives into the unit.
test fn the_worker_exec_stop_post_escapes_dollars_for_systemd_run() -> Bool {
  let inst = srv1_live_dashboard_instance()
  match attempt_exit_hook(instance_root: inst.instance_root as String, node_id: "n", attempt_key: "k", role: AttemptWorkerRole) {
    AttemptExitHookRefused { reason: _ } => false
    AttemptExitHookRendered { exec_line } => {
      let props = dispatch_worker_unit_properties(instance: inst, working_directory: "/wt", attempt_worktree: "/wt", worker_log_path: "/wt/log", granted: kibibyte(count: 1048576), process_bounds: session_process_bounds, exit_hook: exec_line)
      let escaped = dispatch_worker_exec_stop_post_for_systemd_run(hook: exec_line) as String
      string_contains(s: exec_line as String, pattern: "${INVOCATION_ID}")
        && !string_contains(s: exec_line as String, pattern: "$${INVOCATION_ID}")
        && string_contains(s: escaped, pattern: "$${INVOCATION_ID}")
        && has_property(props: props, needle: "$${INVOCATION_ID}")
    }
  }
}
