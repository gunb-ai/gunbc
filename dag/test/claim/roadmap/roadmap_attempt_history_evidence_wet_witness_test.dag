module test.claim.roadmap_attempt_history_evidence_wet_witness_test

import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import std.types { Bool, String, NonEmptyStr, FilePath }
import gunbc.host_layout { srv1_host_layout }
import gunbc.roadmap_dashboard_instance {
  HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision,
  dashboard_instance_dispatch_attempt_state_root,
}
import gunbc.roadmap_dispatch_actuator { DispatchAttemptRef }
import gunbc.roadmap_belt_actuate {
  BeltAttemptPanesObserved, belt_workflow_attempt_evidence_for_key, belt_workflow_attempt_evidence_for_ref,
}

// A NAMED ATTEMPT'S EVIDENCE IS THAT ATTEMPT'S, NOT ITS NODE'S CURRENT ONE. Two attempts of one node
// are planted on a scratch instance: K1 (historical) and K2 (current, named by the node's current
// pointer). Each carries its own sentinel environment admission and spawn-failure record. Reading K1
// by its key must return only K1's sentinels; the current-pointer wrapper must return only K2's. A
// builder that read any attempt-varying fact through the node's current projection would return
// K2's sentinels for K1 -- the mixture this witness exists to refuse.
fn scratch_root() -> String {
  shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_attempt_history.XXXXXX").path
}

fn instance_at(root: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    instance_id: "attempt-history-witness" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: root as FilePath,
    serve_function: "attempt_history_witness_serve" as NonEmptyStr,
    listen_port: 18097,
    source_anchor_ref: "refs/remotes/origin/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

data node: String = "witness-node"

data k1: String = "1111111111111111"

data k2: String = "2222222222222222"

fn plant(dir: String, admission: String, spawn: String) -> Bool {
  let made = shell.Mkdir.Parents(path: dir)
  let a = Filesystem.Write(path: join([dir, "/environment-admission.json"], ""), content: admission)
  let f = Filesystem.Write(path: join([dir, "/spawn-failure.txt"], ""), content: spawn)
  made.success && a.success && f.success
}

fn planted_instance() -> HostDashboardInstance? {
  let root = scratch_root()
  let instance = instance_at(root: root)
  let state = dashboard_instance_dispatch_attempt_state_root(instance: instance) as String
  let ok1 = plant(dir: join([state, "/", node, "-a", k1], ""), admission: "A1-historical", spawn: "S1-historical")
  let ok2 = plant(dir: join([state, "/", node, "-a", k2], ""), admission: "A2-current", spawn: "S2-current")
  let okc = plant(dir: join([state, "/", node, "-current"], ""), admission: "A2-current", spawn: "S2-current")
  let key = Filesystem.Write(path: join([state, "/", node, "-current/attempt-key"], ""), content: k2)
  if ok1 && ok2 && okc && key.success { Present { value: instance } } else { none }
}

fn attempt_ref(key: String) -> DispatchAttemptRef {
  DispatchAttemptRef {
    node_id: node as NonEmptyStr,
    branch: join(["dispatch/", node, "-a", key], "") as NonEmptyStr,
    attempt_key: key,
  }
}

test fn a_historical_attempt_reads_only_its_own_records() -> Bool {
  match planted_instance() {
    Absent => false
    Present { value: instance } => {
      let e = belt_workflow_attempt_evidence_for_key(instance: instance, panes: BeltAttemptPanesObserved { panes: [] }, attempt: attempt_ref(key: k1), current_key: k1)
      e.attempt_key == k1 && e.admission_receipt == "A1-historical" && e.spawn_failure == "S1-historical"
    }
  }
}

test fn the_current_pointer_reads_only_the_current_attempt() -> Bool {
  match planted_instance() {
    Absent => false
    Present { value: instance } => {
      let e = belt_workflow_attempt_evidence_for_ref(instance: instance, panes: BeltAttemptPanesObserved { panes: [] }, attempt: attempt_ref(key: k1))
      e.attempt_key == k2 && e.admission_receipt == "A2-current" && e.spawn_failure == "S2-current"
    }
  }
}
