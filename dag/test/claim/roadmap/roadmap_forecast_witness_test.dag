  HistoryNodeMissing,
  HistoryNodeDuplicate,
  HistoryAcceptanceMissing,
  HistoryAcceptanceDuplicate,
  HistoryPullMissing,
  HistoryPullDuplicate,
  HistoryPullNotMergedAfterOpen,
  HistoryAcceptanceCarrierLoadRefused,
  ForecastAnchorObservation,
  ReviewCycleCount,
  OperatorMergeLatencyAssumption,
  end_to_end_belt_slot_occupancy_assumption,
  ScheduleForecastAssumptions,
