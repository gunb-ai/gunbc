import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn assumptions_with_cap(max_concurrent: Int) -> ScheduleForecastAssumptions {
  ScheduleForecastAssumptions {
    worker_concurrency_cap: BeltCapacity { max_concurrent: max_concurrent },
    review_cycle_count: ReviewCycleCount { count: positive_measure_count(predecessor: 0) },
    operator_merge_latency: OperatorMergeLatencyAssumption { duration: millisecond(count: 5) },
    belt_slot_occupancy: end_to_end_belt_slot_occupancy_assumption,
  }
}

fn assumptions() -> ScheduleForecastAssumptions {
  assumptions_with_cap(max_concurrent: 3)
}

fn anchor() -> ForecastAnchorObservation {
  ForecastAnchorObservation { observed_at: 1000 }
}

// SIZE IS NO LONGER ON THE FIXTURE NODE. The forecast takes a sizing assignment list, so a fixture
// declares the node and, separately, the cell it wants that node to be sized at; a node with no
// assignment is the unsized case. That split is what keeps the positive controls below executable
// while gunbc.roadmap_sizing derive_task_sizing is still a stub -- the production assignment list
// is empty, and these witnesses supply their own.
fn fixture_node(id: String) -> RoadmapNode {
  RoadmapNode {
    identity: concat("fixture-", id) as RoadmapNodeIdentity,
    node: id as RoadmapNodeId,
    line: PlainLine { content: id },
    carriers: [],
    dispatch: Dispatchable { repo: "gunbc", acceptance: ManualAcceptance },
    execution: ExecutionContractUnspecified,
    owner: "fixture",
    signoff: Unsigned,
  }
}

fn sized_at(n: RoadmapNode, cell: NodeSizing) -> NodeSizingAssignment {
  NodeSizingAssignment { node: n.node, sizing: cell }
}

fn fixture_sizings(ns: List<RoadmapNode>) -> List<NodeSizingAssignment> {
  ns |> map(n => sized_at(n: n, cell: fixture_cell()))
}

fn observation(id: String, cell: NodeSizing, duration_ms: Int) -> CycleTimeObservation {
  CycleTimeObservation {
    node: id as RoadmapNodeId,
    sizing_cell: cell,
    pull_number: duration_ms,
    cycle_time: millisecond(count: duration_ms),
    accepted_on: "2026-08-01",
    source_url: "https://github.com/gunb-ai/gunbc/pull/1",
    provenance: AcceptedRoadmapNodePullHistory,
  }
}

fn fixture_cell() -> NodeSizing {
  NodeSizing { intricacy: IntricacyMedium, volume: VolumeMedium }
}

fn fixture_observations() -> List<CycleTimeObservation> {
  [
    observation(id: "history-a", cell: fixture_cell(), duration_ms: 10),
    observation(id: "history-b", cell: fixture_cell(), duration_ms: 20),
    observation(id: "history-c", cell: fixture_cell(), duration_ms: 30),
  ]
}

// THE LIVE HISTORY JOIN IS THE OTHER SIDE OF THE SAME LOSS, AND THIS WITNESS NOW ASSERTS WHAT IS
// TRUE RATHER THAN WHAT USED TO BE. Before the unbundling, each accepted node carried a hand-
// authored cell, so the ten cited acceptance/pull links produced four calibration observations and
// two bundled-delivery exclusions with no refusals. Sizing is derived now and the deriver is a
// stub, so observation_for_link reaches its sizing check with no assignment and refuses every
// remaining link as HistoryNodeUnsized. Asserting that refusal is not bookkeeping: it is the
// discriminating control that the loss is TOTAL and LOUD rather than partial and quiet, and it
// goes red the day a link joins again -- which is this drop retiring.
test fn witness_cited_acceptance_pr_history_refuses_every_link_as_unsized() -> Bool {
  let builds = roadmap_cycle_time_observation_builds()
  let refusals = cycle_time_history_refusals(builds: builds)
  count(builds) == 10
    && count(accepted_cycle_time_observations(builds: builds)) == 0
    && count(refusals) > 0
    && all(refusals, refusal => match refusal {
      HistoryNodeUnsized { node: _ } => true
      HistoryNodeMissing { node: _ } => false
      HistoryNodeDuplicate { node: _ } => false
      HistoryAcceptanceMissing { node: _ } => false
      HistoryAcceptanceDuplicate { node: _ } => false
      HistoryPullMissing { node: _, pull_number: _ } => false
      HistoryPullDuplicate { node: _, pull_number: _ } => false
      HistoryPullNotMergedAfterOpen { node: _, pull_number: _ } => false
      HistoryAcceptanceCarrierLoadRefused { detail: _ } => false
    })
}

// FOUR LIVE-GRAPH CALIBRATION WITNESSES WERE RETIRED HERE, AND SAYING SO IS THE POINT.
// witness_live_graph_refuses_with_located_counted_calibration_gaps,
// witness_live_graph_gap_count_matches_refusal_rows, witness_live_graph_refusal_is_only_calibration
// and witness_live_calibration_keeps_small_sample_intervals each asserted a property of the LIVE
// calibration population -- that the roadmap's own graph refuses with located, counted, per-cell
// calibration gaps and with nothing else, and that the three live cells calibrate to their exact
// observed intervals without collapsing a small sample to a point. That population
// was keyed on the hand-authored intricacy/volume cells this change deleted, so the subject of all
// three no longer exists: there are no cells to gap, because nothing is sized. They were not
// weakened to keep them green and they were not quietly dropped; they are named in the population
// of gunbc.rung_drop.roadmap_sizing_authored_to_derived, and its trigger -- a deriver that answers
// from the task, with the forecast calibrating from the derived cells end to end -- is exactly the
// condition under which they can be written again against a real population.
//
// What stands in their place until then is the control below, which is the one assertion that
// remains authorable and is the one that matters while the deriver is a stub: the live graph
// REFUSES, naming its unsized nodes, rather than rendering a schedule it cannot support.

test fn witness_fully_calibrated_graph_derives_three_point_critical_path() -> Bool {
  let a = fixture_node(id: "a")
  let b = fixture_node(id: "b")
  let c = fixture_node(id: "c")
  let result = schedule_forecast(
    nodes: [a, b, c],
    sizings: fixture_sizings(ns: [a, b, c]),
    edges: [RoadmapEdge { child: b.node, parent: a.node }],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  )
  match result {
    ScheduleForecastRefused { refusals: _ } => false
    ScheduleForecastKnown { forecast } =>
      forecast.critical_path == [a.node, b.node]
        && count(forecast.nodes) == 3
        && forecast.completion_lower_bound.earliest.epoch_ms == 1020
        && forecast.completion_lower_bound.median.epoch_ms == 1040
        && forecast.completion_lower_bound.latest.epoch_ms == 1060
        && millisecond_count(m: forecast.lower_bounds.total_work.duration.median) == 60
        && millisecond_count(m: forecast.lower_bounds.critical_path_minimum.duration.median) == 40
        && millisecond_count(m: forecast.lower_bounds.capacity_constrained_minimum.duration.median) == 40
        && millisecond_count(m: forecast.lower_bounds.parallelism_headroom.ratio.median.num) == 60
        && millisecond_count(m: forecast.lower_bounds.parallelism_headroom.ratio.median.denom) == 40
        && count(forecast.calibration_population_exclusions) == 0
        && match forecast.scenario_adjustment {
          AdjustmentUnavailable { causes } => count(causes) == 2
        }
        && forecast.assumptions.worker_concurrency_cap.max_concurrent == 3
        && millisecond_count(m: forecast.assumptions.operator_merge_latency.duration) == 5
  }
}

test fn witness_worker_cap_changes_completion_lower_bound() -> Bool {
  let a = fixture_node(id: "capacity-a")
  let b = fixture_node(id: "capacity-b")
  let c = fixture_node(id: "capacity-c")
  let one_worker = schedule_forecast(
    nodes: [a, b, c],
    sizings: fixture_sizings(ns: [a, b, c]),
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 1),
    anchor: anchor(),
  )
  let three_workers = schedule_forecast(
    nodes: [a, b, c],
    sizings: fixture_sizings(ns: [a, b, c]),
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 3),
    anchor: anchor(),
  )
  match one_worker {
    ScheduleForecastRefused { refusals: _ } => false
    ScheduleForecastKnown { forecast: serialized_bound } => match three_workers {
      ScheduleForecastRefused { refusals: _ } => false
      ScheduleForecastKnown { forecast: parallel_bound } =>
        serialized_bound.completion_lower_bound.median.epoch_ms == 1060
          && parallel_bound.completion_lower_bound.median.epoch_ms == 1020
          && millisecond_count(m: serialized_bound.lower_bounds.total_work.duration.median) == 60
          && millisecond_count(m: serialized_bound.lower_bounds.critical_path_minimum.duration.median) == 20
          && millisecond_count(m: serialized_bound.lower_bounds.capacity_constrained_minimum.duration.median) == 60
          && serialized_bound.completion_lower_bound.median.epoch_ms > parallel_bound.completion_lower_bound.median.epoch_ms
    }
  }
}

test fn witness_invalid_worker_cap_refuses() -> Bool {
  let n = fixture_node(id: "invalid-cap")
  match schedule_forecast(
    nodes: [n],
    sizings: fixture_sizings(ns: [n]),
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 0),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => count(refusals) == 1 && any(refusals, refusal => match refusal {
      WorkerConcurrencyCapInvalid { declared_cap } => declared_cap == 0
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      CycleTimeObservationNonPositive { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_zero_cycle_time_observation_refuses_before_headroom() -> Bool {
  let n = fixture_node(id: "zero-cycle")
  match schedule_forecast(
    nodes: [n],
    sizings: fixture_sizings(ns: [n]),
    edges: [],
    observations: [observation(id: n.node, cell: fixture_cell(), duration_ms: 0)],
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => count(refusals) == 1 && any(refusals, refusal => match refusal {
      CycleTimeObservationNonPositive { nodes } => nodes == [n.node]
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_empty_graph_refuses() -> Bool {
  match schedule_forecast(
    nodes: [],
    sizings: [],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => refusals == [ForecastGraphEmpty]
  }
}

// UNSIZED IS NOW "ABSENT FROM THE ASSIGNMENT LIST", which is what the empty list below says. The
// authored form of this fixture carried NodeSizing.Unsized on the node itself; with sizing an input
// to the fold, a node the deriver could not answer for simply has no assignment, and handing this
// witness a cell would make the arm it matches on unreachable.
test fn witness_unsized_node_refuses() -> Bool {
  let n = fixture_node(id: "unsized")
  match schedule_forecast(
    nodes: [n],
    sizings: [],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
      NodeUnsized { nodes } => nodes == [n.node]
      CycleTimeObservationNonPositive { nodes: _ } => false
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

// THE CELL HERE MUST BE ONE THE OBSERVATIONS DO NOT COVER, or the gap this witness exists to find
// cannot exist. fixture_observations are all fixture_cell() (medium/medium), so the node is sized
// high/small deliberately -- the shared fixture_sizings helper would hand it a calibrated cell and
// the NoCalibrationSample assertion would become unsatisfiable.
test fn witness_empty_calibration_cell_refuses() -> Bool {
  let n = fixture_node(id: "missing-cell")
  match schedule_forecast(
    nodes: [n],
    sizings: [sized_at(n: n, cell: NodeSizing { intricacy: IntricacyHigh, volume: VolumeSmall })],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
      NoCalibrationSample { gaps, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => count(gaps) == 1 && first(gaps).nodes == [n.node]
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      CycleTimeObservationNonPositive { nodes: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_dependency_cycle_refuses() -> Bool {
  let a = fixture_node(id: "cycle-a")
  let b = fixture_node(id: "cycle-b")
  match schedule_forecast(
    nodes: [a, b],
    sizings: fixture_sizings(ns: [a, b]),
    edges: [
      RoadmapEdge { child: a.node, parent: b.node },
      RoadmapEdge { child: b.node, parent: a.node },
    ],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
      DependencyCycle { nodes } => count(nodes) == 2
      ForecastGraphEmpty => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      CycleTimeObservationNonPositive { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_forecast_cannot_promote_into_observation_position() -> Bool {
  let a = fixture_node(id: "projection-a")
  let observed: CycleTimeObservation = first(fixture_observations())
  match schedule_forecast(
    nodes: [a],
    sizings: fixture_sizings(ns: [a]),
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastRefused { refusals: _ } => false
    ScheduleForecastKnown { forecast } => {
      let projected: ScheduleForecast = forecast
      millisecond_count(m: observed.cycle_time) == 10
        && projected.anchor.observed_at == anchor().observed_at
    }
  }
}

// WHAT THE LIVE FORECAST RENDERS NOW THAT SIZING IS DERIVED AND THE DERIVER IS A STUB, asserted on
// the real authority rather than on a fixture. The answer must be a REFUSAL naming every node it
// could not size -- not a forecast with empty cells, and not a shorter forecast over the nodes that
// happened to survive. A declared drop admits losing the capability; it does not license rendering
// something that reads like a schedule. This witness is the standing control on that: it goes red
// the moment the live graph produces a ScheduleForecastKnown, whether because the deriver started
// answering (correct, and the drop retires) or because some later change let an unsized node
// through (a regression this would otherwise hide).
test fn witness_live_graph_refuses_every_node_as_unsized_while_the_deriver_is_a_stub() -> Bool {
  match live_roadmap_schedule_forecast(assumptions: assumptions(), anchor: anchor()) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
      NodeUnsized { nodes } => count(nodes) > 0
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      CycleTimeObservationNonPositive { nodes: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}
