module test.claim.roadmap.roadmap_acceptance_outcome_witness_test

import std.types { Bool, String, List, list_length }
import std.optional { Present, Absent }
import gunbc.roadmap.roadmap_workflow_stage {
  WorkflowSegment, WorkflowSegmentKind, WorkflowSegmentState,
  VerificationWorkflowSegment, ReviewWorkflowSegment, GoalAuditWorkflowSegment, SubmissionWorkflowSegment, PublicationWorkflowSegment,
  WorkflowSegmentPending, WorkflowSegmentActive, WorkflowSegmentComplete,
  WorkflowSegmentFailed, WorkflowSegmentRefused, WorkflowSegmentStopped,
}
import gunbc.roadmap.roadmap_acceptance_outcome {
  AcceptanceOutcome, AcceptanceAccepted, AcceptanceChangesRequested, AcceptanceUnavailable,
  AcceptanceOutcomeRecord, AcceptanceOutcomeDecoded, AcceptanceOutcomeUndecodable,
  acceptance_outcome_of_stages, acceptance_outcome_record_text, acceptance_outcome_decode, acceptance_outcome_key,
  handin_identity, acceptance_outcome_addresses,
}
import gunbc.harness.harness_turn {
  harness_acceptance_outcome_tool_text, harness_acceptance_wait_expired_cause, harness_acceptance_outcome_for,
  harness_handin_candidate_from_observations, HandInWorktreeObserved, HandInWorktreeUnreadable,
  harness_tool_contract_wire,
}
import gunbc.harness.harness_wire { AnthropicMessagesShape, OpenAiChatCompletionsShape }
import gunbc.harness.harness_tool { harness_offered_tools }
import gunbc.roadmap.roadmap_provider_events {
  ProviderAwaitingAcceptance, ProviderCompleted, ProviderRunning,
  parse_codex_jsonl, provider_execution_state,
}
import gunbc.roadmap.roadmap_belt_obligation {
  belt_attempt_obligation_outstanding, belt_attempt_outstanding, belt_attempt_next_after,
  BeltAttemptObligationKind, CaptureObligation, VerifyObligation, ReviewObligation, AuditObligation, AcceptanceOutcomeObligation,
  belt_attempt_obligation_kind_key, belt_provider_candidate_ready, belt_provider_handed_in,
}

fn seg(kind: WorkflowSegmentKind, state: WorkflowSegmentState, detail: String) -> WorkflowSegment? {
  Present { value: WorkflowSegment { kind: kind, state: state, detail: detail } }
}

fn key_of(o: AcceptanceOutcome?) -> String {
  match o {
    Absent => "waiting"
    Present { value: v } => acceptance_outcome_key(o: v)
  }
}

// VERIFICATION DECIDES ALONE WHEN IT FAILS OR CANNOT RUN: review and the goal audit start only after it
// passes, so an outcome that waited for all three would wait forever. A failed verification is a change
// the worker owes, with the failure as its findings; one that cannot run is acceptance unavailable.
test fn verification_that_fails_or_cannot_run_decides_without_review() -> Bool {
  let failed = acceptance_outcome_of_stages(verification: seg(kind: VerificationWorkflowSegment, state: WorkflowSegmentFailed, detail: "witness red: missing arm"), review: none, goal_audit: none)
  let refused = acceptance_outcome_of_stages(verification: seg(kind: VerificationWorkflowSegment, state: WorkflowSegmentRefused, detail: "toolchain missing"), review: none, goal_audit: none)
  let running = acceptance_outcome_of_stages(verification: seg(kind: VerificationWorkflowSegment, state: WorkflowSegmentActive, detail: "running"), review: none, goal_audit: none)
  (match failed { Present { value: AcceptanceChangesRequested { stage, findings } } => stage == "verification" && findings == "witness red: missing arm"  _ => false })
    && (match refused { Present { value: AcceptanceUnavailable { cause } } => cause.contains("toolchain missing")  _ => false })
    && key_of(o: running) == "waiting"
    && key_of(o: acceptance_outcome_of_stages(verification: none, review: none, goal_audit: none)) == "waiting"
}

// AFTER VERIFICATION PASSES THE OUTCOME WAITS FOR BOTH REVIEW AND THE AUDIT, so the worker never resumes
// editing while a reader of its worktree is still at work; then a requested change wins, a stage that
// could not run makes acceptance unavailable, and both approving accepts.
test fn after_verification_both_readers_settle_before_an_outcome() -> Bool {
  let verified = seg(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "2 validations")
  let approved_review = seg(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved")
  let changes_review = seg(kind: ReviewWorkflowSegment, state: WorkflowSegmentFailed, detail: "dag/a.dag: the arm is missing")
  let pending_audit = seg(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentActive, detail: "auditing")
  let approved_audit = seg(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved")
  let refused_audit = seg(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentRefused, detail: "no seat")
  key_of(o: acceptance_outcome_of_stages(verification: verified, review: changes_review, goal_audit: pending_audit)) == "waiting"
    && (match acceptance_outcome_of_stages(verification: verified, review: changes_review, goal_audit: approved_audit) {
      Present { value: AcceptanceChangesRequested { stage, findings } } => stage == "review" && findings.contains("the arm is missing")
      _ => false
    })
    && key_of(o: acceptance_outcome_of_stages(verification: verified, review: approved_review, goal_audit: refused_audit)) == "unavailable"
    && key_of(o: acceptance_outcome_of_stages(verification: verified, review: approved_review, goal_audit: approved_audit)) == "accepted"
}

// THE RECORD ROUND-TRIPS WITH ITS HAND-IN AND HEAD, and the schema wall refuses anything else.
test fn the_outcome_record_round_trips_and_refuses_another_schema() -> Bool {
  let r = AcceptanceOutcomeRecord { handin: "h2", head: "abc123", outcome: AcceptanceChangesRequested { stage: "review", findings: "fix the arm" } }
  (match acceptance_outcome_decode(text: acceptance_outcome_record_text(r: r)) {
    AcceptanceOutcomeDecoded { record } =>
      record.handin == "h2" && record.head == "abc123"
        && (match record.outcome { AcceptanceChangesRequested { stage, findings } => stage == "review" && findings == "fix the arm"  _ => false })
    AcceptanceOutcomeUndecodable { reason: _ } => false
  })
    && (match acceptance_outcome_decode(text: "\{\"schema\": \"roadmap-acceptance-outcome/v0\", \"handin\": \"h1\", \"head\": \"x\", \"outcome\": \"accepted\"}") {
      AcceptanceOutcomeUndecodable { reason } => reason.contains("v0")
      AcceptanceOutcomeDecoded { record: _ } => false
    })
}

// A HANDED-IN WORKER IS READY FOR CAPTURE AND OWED AN OUTCOME, but it has not ended: the obligation
// gates read "ended or handed in", and only a handed-in worker is owed an outcome.
test fn a_handed_in_worker_is_captured_and_owed_an_outcome() -> Bool {
  let handed = ProviderAwaitingAcceptance { handin: "h1" }
  let ended = ProviderCompleted { activity: "Agent complete" }
  let running = ProviderRunning { activity: "Agent working" }
  belt_provider_candidate_ready(provider: handed) && belt_provider_candidate_ready(provider: ended) && !belt_provider_candidate_ready(provider: running)
    && belt_provider_handed_in(provider: handed) == "h1" && belt_provider_handed_in(provider: ended) == ""
    && belt_attempt_obligation_outstanding(kind: CaptureObligation, provider: handed, segments: [WorkflowSegment { kind: SubmissionWorkflowSegment, state: WorkflowSegmentPending, detail: "awaiting capture" }])
    && belt_attempt_obligation_outstanding(kind: AcceptanceOutcomeObligation, provider: handed, segments: [])
    && !belt_attempt_obligation_outstanding(kind: AcceptanceOutcomeObligation, provider: ended, segments: [])
    && belt_attempt_obligation_outstanding(
      kind: VerifyObligation,
      provider: handed,
      segments: [
        WorkflowSegment { kind: SubmissionWorkflowSegment, state: WorkflowSegmentComplete, detail: "captured" },
        WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentPending, detail: "owed" },
      ],
    )
}

// SAME WORDING AND A DIFFERENT HEAD ARE DIFFERENT HAND-INS: the digest of the readiness text is not
// the identity, so an outcome written for the first candidate cannot complete the second.
test fn same_wording_and_changed_code_is_a_fresh_hand_in() -> Bool {
  let first = handin_identity(attempt_key: "a1", ordinal: 1, head: "aaa", scm_root: "tree-a")
  let revised = handin_identity(attempt_key: "a1", ordinal: 1, head: "bbb", scm_root: "tree-a")
  let stale = AcceptanceOutcomeRecord { handin: first, head: "aaa", outcome: AcceptanceAccepted }
  first != revised
    && acceptance_outcome_addresses(record: stale, handin: first)
    && !acceptance_outcome_addresses(record: stale, handin: revised)
    && (match harness_handin_candidate_from_observations(
      worktree: "/wt",
      head_success: false,
      head_sha: "",
      head_stderr: "no git",
      tree_success: true,
      tree_sha: "tree-a",
      tree_stderr: "",
    ) {
      HandInWorktreeUnreadable { cause } => cause.contains("HeadCommitIn") && cause.contains("no git")
      HandInWorktreeObserved { head_sha: _, tree_sha: _ } => false
    })
    && (match harness_handin_candidate_from_observations(
      worktree: "/wt",
      head_success: true,
      head_sha: "aaa\n",
      head_stderr: "",
      tree_success: true,
      tree_sha: "tree-a\n",
      tree_stderr: "",
    ) {
      HandInWorktreeObserved { head_sha, tree_sha } => head_sha == "aaa" && tree_sha == "tree-a"
      HandInWorktreeUnreadable { cause: _ } => false
    })
}

test fn the_wire_contract_is_the_offered_tools() -> Bool {
  let a = harness_tool_contract_wire(shape: AnthropicMessagesShape)
  let o = harness_tool_contract_wire(shape: OpenAiChatCompletionsShape)
  list_length(items: harness_offered_tools()) == 2
    && a.contains("run_command") && a.contains("hand_in") && !a.contains("read_file")
    && o.contains("run_command") && o.contains("hand_in") && !o.contains("read_file")
}

test fn the_tool_result_is_the_outcome() -> Bool {
  harness_acceptance_outcome_tool_text(o: AcceptanceAccepted) == "accepted"
    && harness_acceptance_outcome_tool_text(o: AcceptanceChangesRequested { stage: "verification", findings: "red" }).contains("changes-requested")
    && harness_acceptance_outcome_tool_text(o: AcceptanceChangesRequested { stage: "verification", findings: "red" }).contains("red")
    && harness_acceptance_outcome_tool_text(o: AcceptanceUnavailable { cause: "timeout" }).contains("unavailable")
    && harness_acceptance_outcome_tool_text(o: AcceptanceUnavailable { cause: "timeout" }).contains("timeout")
}

test fn a_bounded_wait_expires_to_unavailable() -> Bool {
  harness_acceptance_wait_expired_cause(handin: "h9").contains("h9")
    && harness_acceptance_wait_expired_cause(handin: "h9").contains(" s")
    && (match harness_acceptance_outcome_for(text: Absent, handin: "h9") { Absent => true  Present { value: _ } => false })
}

// LAST VERDICT YIELDS THE PUBLISHED OUTCOME THE WAITER READS (lab 2026-10-14). A projected
// session.handed_in line that still names its id makes AcceptanceOutcome outstanding once review
// and the audit have settled; the stage reduction is Accepted; the record text is exactly what
// harness_acceptance_outcome_for returns for that hand-in. A type-only projected line (today's
// projector default) leaves the id empty, so the same last-verdict evidence owes only publish --
// the 19:46 receipt.
test fn the_last_verdict_yields_the_published_outcome_for_the_current_hand_in() -> Bool {
  let handin = "eb1ec191e8f18aa5"
  let head = "857878f4fa"
  let provider = provider_execution_state(parsed: parse_codex_jsonl(text: "{\"type\":\"session.handed_in\",\"handin\":\"eb1ec191e8f18aa5\"}\n"))
  let stripped = provider_execution_state(parsed: parse_codex_jsonl(text: "{\"type\":\"session.handed_in\"}\n"))
  let settled = [
    WorkflowSegment { kind: SubmissionWorkflowSegment, state: WorkflowSegmentComplete, detail: "captured" },
    WorkflowSegment { kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "19 validations" },
    WorkflowSegment { kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "16 approved" },
    WorkflowSegment { kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved" },
    WorkflowSegment { kind: PublicationWorkflowSegment, state: WorkflowSegmentPending, detail: "1 of 14" },
  ]
  let outstanding = belt_attempt_outstanding(provider: provider, segments: settled)
  let kinds = join(outstanding |> map(k => belt_attempt_obligation_kind_key(kind: k)), ",")
  let outcome = acceptance_outcome_of_stages(
    verification: seg(kind: VerificationWorkflowSegment, state: WorkflowSegmentComplete, detail: "19 validations"),
    review: seg(kind: ReviewWorkflowSegment, state: WorkflowSegmentComplete, detail: "16 approved"),
    goal_audit: seg(kind: GoalAuditWorkflowSegment, state: WorkflowSegmentComplete, detail: "approved"),
  )
  let record = match outcome {
    Present { value: o } => acceptance_outcome_record_text(r: AcceptanceOutcomeRecord { handin: handin, head: head, outcome: o })
    Absent => ""
  }
  belt_provider_handed_in(provider: provider) == handin
    && kinds == "acceptance-outcome,publish"
    && keys_after(ran: ReviewObligation, outstanding: outstanding) == "acceptance-outcome,publish"
    && keys_after(ran: AuditObligation, outstanding: outstanding) == "acceptance-outcome,publish"
    && (match outcome { Present { value: AcceptanceAccepted } => true  _ => false })
    && (match harness_acceptance_outcome_for(text: Present { value: record }, handin: handin) {
      Present { value: AcceptanceAccepted } => true
      _ => false
    })
    && (match harness_acceptance_outcome_for(text: Present { value: record }, handin: "other") {
      Absent => true
      Present { value: _ } => false
    })
    && join(belt_attempt_outstanding(provider: stripped, segments: settled) |> map(k => belt_attempt_obligation_kind_key(kind: k)), ",") == "publish"
}

fn keys_after(ran: BeltAttemptObligationKind, outstanding: List<BeltAttemptObligationKind>) -> String {
  join(belt_attempt_next_after(ran: ran, outstanding: outstanding) |> map(k => belt_attempt_obligation_kind_key(kind: k)), ",")
}
