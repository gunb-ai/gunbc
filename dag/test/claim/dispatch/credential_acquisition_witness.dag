module test.claim.dispatch.credential_acquisition_witness

import std.types { Bool, String, NonEmptyStr, EpochSecs }
import gunbc.compute.attempt_lifecycle {
  AttemptState, AttemptReserved, AttemptLaunching, AttemptTerminal, AttemptRecovered,
  AttemptAdvanced, AttemptLostRace, AttemptTransitionRefused,
}
import gunbc.compute.recorded_cgroup_drain {
  RecordedInvocationEnded, RecordedInvocationStillCurrent,
  RecordedPathAbsent, RecordedPathPopulated, RecordedPathEmpty, RecordedPathUnreadable,
  recorded_cgroup_drain, recorded_cgroup_may_seal,
}
import gunbc.dispatch.credential_acquisition {
  CredentialAcquisitionRecord, credential_acquisition_reference, credential_acquisition_slots_root,
  credential_open, credential_begin_launch, credential_terminate, credential_record_decode,
  credential_record_json, credential_occupy_tombstone, credential_seal_after_terminate,
  credential_recovery_decide, CredentialRecoveryMayClose, CredentialRecoveryPreserve,
  CredentialSealed, CredentialSealFailed, CredentialSealNotOwed, CredentialOccupied,
  credential_snapshot_is_tombstone, credential_tombstone_body,
}
import gunbc.dispatch_credential_snapshot { ClaudeFromSnapshot, CursorFromSnapshot }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell

fn rec(state: AttemptState, deadline: EpochSecs) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1",
    reference: credential_acquisition_reference(identity: "id1", executor: ClaudeFromSnapshot) as String,
    executor_word: "claude",
    snapshot_path: "/tmp/cred-p",
    producer_pid: "1",
    producer_namespace: "ns",
    boot_id: "boot",
    belt_unit: "gunbc-roadmap-belt.service",
    invocation_id: "inv-a",
    control_group: "/gunbc.slice/belt.service",
    opened_at: 10,
    launch_deadline: deadline,
    state: state,
  }
}

fn drain_ended(path: RecordedCgroupPathStanding) -> RecordedCgroupDrain {
  recorded_cgroup_drain(invocation: RecordedInvocationEnded, path: path)
}

test fn h_happy_path_reserved_past_deadline_may_close() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 10), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryMayClose { reason: _ } => true
    CredentialRecoveryPreserve { reason: _ } => false
  }
}

test fn t_death_before_init_is_reserved_close() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 5), drain: drain_ended(path: RecordedPathAbsent), now: 9) {
    CredentialRecoveryMayClose { reason: _ } => true
    CredentialRecoveryPreserve { reason: _ } => false
  }
}

test fn three_a_and_d_and_w_window_preserves_reserved() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 100), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "W:")
    CredentialRecoveryMayClose { reason: _ } => false
  }
}

test fn r_launching_drained_may_close() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptLaunching, deadline: 10), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryMayClose { reason: _ } => true
    CredentialRecoveryPreserve { reason: _ } => false
  }
}

test fn l_m_u_n_p_p_double_p_triple_pf_populated_preserves() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptLaunching, deadline: 10), drain: drain_ended(path: RecordedPathPopulated), now: 20) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "populated 1")
    CredentialRecoveryMayClose { reason: _ } => false
  }
}

test fn e_unreadable_preserves() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptLaunching, deadline: 10), drain: drain_ended(path: RecordedPathUnreadable { detail: "EIO" }), now: 20) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "EIO")
    CredentialRecoveryMayClose { reason: _ } => false
  }
}

test fn p_prime_and_enoent_may_close() -> Bool {
  recorded_cgroup_may_seal(d: drain_ended(path: RecordedPathEmpty))
    && recorded_cgroup_may_seal(d: drain_ended(path: RecordedPathAbsent))
}

test fn c_second_open_of_same_reference_loses() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  let opened = credential_open(root: root as NonEmptyStr, record: rec(state: AttemptReserved, deadline: 100))
  let again = credential_open(root: root as NonEmptyStr, record: rec(state: AttemptReserved, deadline: 100))
  match opened {
    AttemptAdvanced { state: _, generation: _ } =>
      match again {
        AttemptLostRace { expected: e, observed: _ } => string_contains(s: e, pattern: "absent")
        AttemptAdvanced { state: _, generation: _ } => false
        AttemptTransitionRefused { detail: _ } => false
      }
    _ => false
  }
}

test fn b_two_references_do_not_share_a_slot() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  let a = rec(state: AttemptReserved, deadline: 100)
  let b = CredentialAcquisitionRecord {
    identity: "id2", reference: credential_acquisition_reference(identity: "id2", executor: CursorFromSnapshot) as String,
    executor_word: "cursor", snapshot_path: "/tmp/cred-b", producer_pid: "2", producer_namespace: "ns",
    boot_id: "boot", belt_unit: "u", invocation_id: "inv-b", control_group: "/x", opened_at: 10, launch_deadline: 100, state: AttemptReserved,
  }
  match credential_open(root: root as NonEmptyStr, record: a) {
    AttemptAdvanced { state: _, generation: _ } =>
      match credential_open(root: root as NonEmptyStr, record: b) {
        AttemptAdvanced { state: _, generation: _ } => a.reference != b.reference
        _ => false
      }
    _ => false
  }
}

test fn f_seal_not_owed_when_populated() -> Bool {
  match credential_seal_after_terminate(record: rec(state: AttemptLaunching, deadline: 10), drain: drain_ended(path: RecordedPathPopulated)) {
    CredentialSealNotOwed => true
    CredentialSealed { path: _ } => false
    CredentialSealFailed { detail: _ } => false
  }
}

test fn occupy_tombstone_is_the_wrapper_and_discard_shape() -> Bool {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-tomb.XXXXXX").path
  let path = join([dir, "/P"], "")
  match credential_occupy_tombstone(path: path) {
    CredentialOccupied =>
      credential_snapshot_is_tombstone(text: Filesystem.Read(path: path).content)
        && match credential_occupy_tombstone(path: path) {
          CredentialOccupied => credential_snapshot_is_tombstone(text: Filesystem.Read(path: path).content)
          CredentialOccupyFailed { detail: _ } => false
        }
    CredentialOccupyFailed { detail: _ } => false
  }
}

test fn three_b_and_round_trip_record() -> Bool {
  let r = rec(state: AttemptReserved, deadline: 40)
  match credential_record_decode(text: credential_record_json(r: r)) {
    Present { value: back } => back.reference == r.reference && back.invocation_id == r.invocation_id
    Absent => false
  }
}

test fn slots_root_is_under_the_instance() -> Bool {
  credential_acquisition_slots_root(instance_root: "/inst") as String == "/inst/credential-acquisition-slots"
}
