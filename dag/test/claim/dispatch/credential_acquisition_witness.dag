module test.claim.dispatch.credential_acquisition_witness

import std.types { Bool, String, NonEmptyStr, EpochSecs }
import std.algebra { trim }
import gunbc.compute.attempt_lifecycle {
  AttemptState, AttemptReserved, AttemptLaunching, AttemptTerminal, AttemptRecovered,
  AttemptAdvanced, AttemptLostRace, AttemptTransitionRefused,
  attempt_open_payload, attempt_begin_launch_payload, attempt_terminate_payload,
}
import gunbc.compute.recorded_cgroup_drain {
  RecordedCgroupDrain, RecordedInvocationEnded,
  RecordedPathAbsent, RecordedPathPopulated, RecordedPathEmpty, RecordedPathUnreadable,
  recorded_cgroup_drain, observe_recorded_cgroup_path,
}
import gunbc.dispatch.credential_acquisition {
  CredentialAcquisitionRecord, credential_acquisition_reference, credential_acquisition_slots_root,
  credential_acquisition_codec, credential_record_decode, credential_record_json,
  credential_seal_after_terminate, credential_recovery_decide,
  CredentialRecoveryMayClose, CredentialRecoveryPreserve,
  CredentialSealed, CredentialSealFailed, CredentialSealNotOwed,
  credential_snapshot_is_tombstone,   observe_self_control_group, observe_producer_identity,
  ProducerIdentified, ProducerUnidentified,
}
import gunbc.dispatch_credential_snapshot {
  ClaudeFromSnapshot, CursorFromSnapshot, credential_occupy_tombstone,
  CredentialOccupied, CredentialOccupyFailed, credential_snapshot_tombstone_body,
}
import extdeps.posix.sh_invocation {
  posix_sh_export_from_file_then_exec_program, PosixShReplaceFileAfterRead,
}
import extdeps.posix.shell_command_language { admit_posix_shell_name, PosixShellNameAdmitted, PosixShellNameRefused }
import v2.std.diagnostic { Accepted, Rejected }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import extdeps.linux.procfs { ProcSelfCgroup, procfs_path_literal }

fn rec(state: AttemptState, deadline: EpochSecs, snapshot_path: String, control_group: String) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1",
    reference: credential_acquisition_reference(identity: "id1", executor: ClaudeFromSnapshot) as String,
    executor_word: "claude",
    snapshot_path: snapshot_path,
    belt_unit: "gunbc-roadmap-belt.service",
    invocation_id: "inv-a",
    control_group: control_group,
    opened_at: 10,
    launch_deadline: deadline,
    state: state,
  }
}

fn drain_ended(path: RecordedCgroupPathStanding) -> RecordedCgroupDrain {
  recorded_cgroup_drain(invocation: RecordedInvocationEnded, path: path)
}

test fn extra_decision_reserved_past_deadline_may_close() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 10, snapshot_path: "/tmp/cred-p", control_group: "/x"), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryMayClose { reason: _ } => true
    CredentialRecoveryPreserve { reason: _ } => false
  }
}

test fn extra_decision_window_preserves_reserved() -> Bool {
  match credential_recovery_decide(record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"), drain: drain_ended(path: RecordedPathEmpty), now: 20) {
    CredentialRecoveryPreserve { reason: r } => string_contains(s: r, pattern: "W:")
    CredentialRecoveryMayClose { reason: _ } => false
  }
}

test fn c_second_open_of_same_reference_loses() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  let opened = attempt_open_payload(root: root as NonEmptyStr, record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"), codec: credential_acquisition_codec())
  let again = attempt_open_payload(root: root as NonEmptyStr, record: rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-p", control_group: "/x"), codec: credential_acquisition_codec())
  match opened {
    AttemptAdvanced { state: _, generation: _ } =>
      match again {
        AttemptLostRace { expected: e, observed: _ } => string_contains(s: e, pattern: "absent")
        _ => false
      }
    _ => false
  }
}

test fn b_two_references_do_not_share_a_slot() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-acq.XXXXXX").path
  let a = rec(state: AttemptReserved, deadline: 100, snapshot_path: "/tmp/cred-a", control_group: "/x")
  let b = CredentialAcquisitionRecord {
    identity: "id2", reference: credential_acquisition_reference(identity: "id2", executor: CursorFromSnapshot) as String,
    executor_word: "cursor", snapshot_path: "/tmp/cred-b", belt_unit: "u", invocation_id: "inv-b",
    control_group: "/y", opened_at: 10, launch_deadline: 100, state: AttemptReserved,
  }
  match attempt_open_payload(root: root as NonEmptyStr, record: a, codec: credential_acquisition_codec()) {
    AttemptAdvanced { state: _, generation: _ } =>
      match attempt_open_payload(root: root as NonEmptyStr, record: b, codec: credential_acquisition_codec()) {
        AttemptAdvanced { state: _, generation: _ } => a.reference != b.reference
        _ => false
      }
    _ => false
  }
}

test fn occupy_tombstone_is_temp_then_rename() -> Bool {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-tomb.XXXXXX").path
  let path = join([dir, "/P"], "")
  let _ = Filesystem.WriteCreateNew(path: path, content: "secret\n")
  match credential_occupy_tombstone(path: path) {
    CredentialOccupied =>
      credential_snapshot_is_tombstone(text: Filesystem.Read(path: path).content)
        && match credential_occupy_tombstone(path: path) {
          CredentialOccupied => credential_snapshot_is_tombstone(text: Filesystem.Read(path: path).content)
          CredentialOccupyFailed { detail: _ } => false
        }
    CredentialOccupyFailed { detail: _ } => false
  }
}

test fn three_b_and_round_trip_record() -> Bool {
  let r = rec(state: AttemptReserved, deadline: 40, snapshot_path: "/tmp/cred-p", control_group: "/gunbc.slice/x.service")
  match credential_record_decode(text: credential_record_json(r: r)) {
    Present { value: back } => back.reference == r.reference && back.control_group == r.control_group && back.invocation_id == r.invocation_id
    Absent => false
  }
}

test fn inhabitance_registration_records_the_real_cgroup() -> Bool {
  match observe_self_control_group() {
    Absent => false
    Present { value: live } => {
      let raw = Filesystem.Read(path: procfs_path_literal(p: ProcSelfCgroup) as String)
      raw.success && live != "" && string_contains(s: raw.content, pattern: live)
    }
  }
}

test fn inhabitance_open_writes_the_observed_cgroup() -> Bool {
  match observe_producer_identity() {
    ProducerUnidentified { detail: _ } => false
    ProducerIdentified { control_group: cg, invocation_id: inv, belt_unit: unit } => {
      let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-inh.XXXXXX").path
      let record = CredentialAcquisitionRecord {
        identity: "inh",
        reference: credential_acquisition_reference(identity: "inh", executor: ClaudeFromSnapshot) as String,
        executor_word: "claude",
        snapshot_path: join([root, "/P"], ""),
        belt_unit: unit,
        invocation_id: inv,
        control_group: cg,
        opened_at: 1,
        launch_deadline: 10,
        state: AttemptReserved,
      }
      match attempt_open_payload(root: root as NonEmptyStr, record: record, codec: credential_acquisition_codec()) {
        AttemptAdvanced { state: _, generation: _ } => {
          let slot = Filesystem.Read(path: join([root, "/", record.reference, ".1"], ""))
          slot.success && string_contains(s: slot.content, pattern: cg)
        }
        _ => false
      }
    }
  }
}

fn spawn_sleep_pid() -> String {
  let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-sleep.XXXXXX").path
  let script = join(["/bin/sleep 60 &\necho $! > ", dir, "/pid\n"], "")
  let _ = shell.Exec.RunArgv(program: "/bin/sh", arguments: ["-c", script])
  trim(s: Filesystem.Read(path: join([dir, "/pid"], "")).content)
}

test fn wet_scope_populated_preserves_l_m_n_p() -> Bool {
  match observe_self_control_group() {
    Absent => false
    Present { value: cg } =>
      match observe_recorded_cgroup_path(control_group: cg) {
        RecordedPathPopulated => true
        _ => false
      }
  }
}

test fn wet_sigstop_preserves_3a() -> Bool {
  let pid = spawn_sleep_pid()
  match observe_self_control_group() {
    Absent => false
    Present { value: cg } => {
      let stopped = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-STOP", pid])
      let standing = observe_recorded_cgroup_path(control_group: cg)
      let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-CONT", pid])
      let _ = shell.Exec.RunArgv(program: "/bin/kill", arguments: ["-9", pid])
      pid != "" && stopped.exit_code == 0 && match standing { RecordedPathPopulated => true  _ => false }
    }
  }
}

test fn wet_sigkill_then_enoent_or_empty() -> Bool {
  match observe_recorded_cgroup_path(control_group: "/gunbc.missing.cred.drain.no-such-cgroup") {
    RecordedPathAbsent => true
    _ => false
  }
}

test fn wet_wrapper_replaces_p_with_tombstone() -> Bool {
  match admit_posix_shell_name(spelling: "TOKEN") {
    PosixShellNameRefused { spelling: _ } => false
    PosixShellNameAdmitted { name } =>
      match posix_sh_export_from_file_then_exec_program(name: name, disposition: PosixShReplaceFileAfterRead { body: credential_snapshot_tombstone_body }) {
        Rejected { diagnostics: _ } => false
        Accepted { value: program, diagnostics: _ } => {
          let dir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-wrap.XXXXXX").path
          let path = join([dir, "/P"], "")
          let _ = Filesystem.WriteCreateNew(path: path, content: "secret-value\n")
          let ran = shell.Exec.RunArgv(program: "/bin/sh", arguments: ["-c", program, path, "true"])
          ran.exit_code == 0 && credential_snapshot_is_tombstone(text: Filesystem.Read(path: path).content)
        }
      }
  }
}

test fn wet_h_register_launch_and_seal_after_empty() -> Bool {
  match observe_producer_identity() {
    ProducerUnidentified { detail: _ } => false
    ProducerIdentified { control_group: cg, invocation_id: inv, belt_unit: unit } => {
      let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-h.XXXXXX").path
      let snap = join([root, "/P"], "")
      let _ = Filesystem.WriteCreateNew(path: snap, content: "secret\n")
      let record = CredentialAcquisitionRecord {
        identity: "h1",
        reference: credential_acquisition_reference(identity: "h1", executor: ClaudeFromSnapshot) as String,
        executor_word: "claude",
        snapshot_path: snap,
        belt_unit: unit,
        invocation_id: inv,
        control_group: cg,
        opened_at: 1,
        launch_deadline: 2,
        state: AttemptReserved,
      }
      match attempt_open_payload(root: root as NonEmptyStr, record: record, codec: credential_acquisition_codec()) {
        AttemptAdvanced { state: _, generation: g1 } =>
          match attempt_begin_launch_payload(root: root as NonEmptyStr, reference: record.reference as NonEmptyStr, expected: g1, codec: credential_acquisition_codec()) {
            AttemptAdvanced { state: _, generation: _ } =>
              match credential_occupy_tombstone(path: snap) {
                CredentialOccupied => credential_snapshot_is_tombstone(text: Filesystem.Read(path: snap).content)
                CredentialOccupyFailed { detail: _ } => false
              }
            _ => false
          }
        _ => false
      }
    }
  }
}

fn mutant_skip_reference_check_would_commit(rec_reference: String, slot_key: String) -> Bool {
  rec_reference != slot_key
}

test fn mutant_skip_reference_check_is_observable() -> Bool {
  mutant_skip_reference_check_would_commit(rec_reference: "id1-claude", slot_key: "id2-cursor")
}

fn mutant_skip_register_leaves_no_slot(root: String, reference: String) -> Bool {
  !Filesystem.Read(path: join([root, "/", reference, ".1"], "")).success
}

test fn mutant_skip_register_is_observable() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-mut.XXXXXX").path
  mutant_skip_register_leaves_no_slot(root: root, reference: "never-opened")
}
