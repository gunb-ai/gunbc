module test.claim.lot_sales_tax_witness

import std.types { Bool, List, NonEmptyStr }
import product.inventory {
  InventoryLotAllocator,
  InventoryLotIdentity,
  inventory_lot_allocator_initial,
  mint_inventory_lot_identity,
  inventory_lot_identity_eq,
}
import product.lot_sales_tax {
  LotTaxEvidence,
  LotTaxPopulationComplete,
  LotTaxPopulationRepeatedLot,
  SalesTaxCollected,
  SalesTaxAttestedIncluded,
  AttestedJurisdictionStanding,
  AttestedAtCitedJurisdiction,
  AttestedJurisdictionGrainUnread,
  SalesTaxIncludedJurisdictionUnread,
  SalesTaxTreatmentUnrecorded,
  RateTranscribedFromNamedReceiptLine,
  RateDerivedFromReceiptBaseAndTax,
  ResidualUseTaxOwed,
  ResidualUseTaxNone,
  ResidualUseTaxUnread,
  UseTaxResidualStanding,
  admit_lot_tax_population,
  lot_tax_is_attested_not_read,
  lot_tax_residual_is_owed,
  lot_tax_jurisdiction_is_unread,
  residual_destination_jurisdiction,
  DestinationCitedByRate,
  DestinationNotApplicableNoResidual,
  DestinationUnreadWithResidualStanding,
  ResidualDestinationReading,
  lot_tax_covers_ledgers,
  LotTaxJoinCovered,
  LedgerMissingTax,
  TaxWithoutLedger,
  LotTaxJoinRepeatedLot,
}
import std.decl_ref { decl_ref, DeclarationRef, declaration_ref_eq }
import std.measure { parts_per_million, parts_per_million_count, parts_per_million_scale_million }
import extdeps.tax.statutory_rate { statutory_rate_value, statutory_rate_version_is_read }
import extdeps.tax.new_jersey_sales_and_use {
  nj_statewide_sales_tax,
  nj_uez_reduced_sales_tax,
}
import extdeps.tax.new_york_city_sales_and_use {
  nyc_combined_sales_tax,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data tax_fixture_seed: InventoryLotAllocator = inventory_lot_allocator_initial()
data lot_mt_collins: InventoryLotIdentity = mint_inventory_lot_identity(alloc: tax_fixture_seed).id
data tax_alloc_after_mt_collins: InventoryLotAllocator = mint_inventory_lot_identity(alloc: tax_fixture_seed).alloc
data lot_spark_uez: InventoryLotIdentity = mint_inventory_lot_identity(alloc: tax_alloc_after_mt_collins).id
data tax_alloc_after_uez: InventoryLotAllocator = mint_inventory_lot_identity(alloc: tax_alloc_after_mt_collins).alloc
data lot_marketplace: InventoryLotIdentity = mint_inventory_lot_identity(alloc: tax_alloc_after_uez).id
data tax_alloc_after_marketplace: InventoryLotAllocator = mint_inventory_lot_identity(alloc: tax_alloc_after_uez).alloc
data lot_attested_ny: InventoryLotIdentity = mint_inventory_lot_identity(alloc: tax_alloc_after_marketplace).id
data tax_alloc_after_attested: InventoryLotAllocator = mint_inventory_lot_identity(alloc: tax_alloc_after_marketplace).alloc
data lot_unrecorded: InventoryLotIdentity = mint_inventory_lot_identity(alloc: tax_alloc_after_attested).id

data nyc_residual: UseTaxResidualStanding = ResidualUseTaxOwed {
  destination_combined_rate: nyc_combined_sales_tax,
}

data fixture_population: List<LotTaxEvidence> = [
  LotTaxEvidence {
    lot: lot_mt_collins,
    standing: SalesTaxCollected {
      collection: RateDerivedFromReceiptBaseAndTax {
        jurisdiction: decl_ref(module_path: "extdeps.tax.new_jersey_sales_and_use", decl_name: "nj_statewide_sales_tax"),
        rate: statutory_rate_value(r: nj_statewide_sales_tax),
      },
      residual: nyc_residual,
    },
  },
  LotTaxEvidence {
    lot: lot_spark_uez,
    standing: SalesTaxCollected {
      collection: RateTranscribedFromNamedReceiptLine {
        jurisdiction: decl_ref(module_path: "extdeps.tax.new_jersey_sales_and_use", decl_name: "nj_uez_reduced_sales_tax"),
        rate: statutory_rate_value(r: nj_uez_reduced_sales_tax),
        receipt_line_label: "New Jersey UEZ Tax" as NonEmptyStr,
      },
      residual: nyc_residual,
    },
  },
  LotTaxEvidence {
    lot: lot_marketplace,
    standing: SalesTaxIncludedJurisdictionUnread {
      read_obligation: "marketplace-collected tax; jurisdiction and rate unverified" as NonEmptyStr,
    },
  },
  LotTaxEvidence {
    lot: lot_attested_ny,
    standing: SalesTaxAttestedIncluded {
      jurisdiction: AttestedJurisdictionGrainUnread {
        named_as_attested: "New York" as NonEmptyStr,
        read_obligation: "read the tax line and establish which New York rate was charged" as NonEmptyStr,
      },
      residual: ResidualUseTaxUnread {
        read_obligation: "unsettled until the grain above is read" as NonEmptyStr,
      },
      attestation: "operator attests New York tax was paid; no tax line has been read" as NonEmptyStr,
    },
  },
  LotTaxEvidence {
    lot: lot_unrecorded,
    standing: SalesTaxTreatmentUnrecorded {
      read_obligation: "no acquisition record; tax standing unknown" as NonEmptyStr,
    },
  },
]

// EFFECTIVE VERSIONS ARE READ FOR ONE ROW AND UNREAD FOR TWO, and this pins that distinction
// rather than merely that the field exists. New Jersey's statewide rate carries its 2018-01-01
// effective date from N.J.S.A. 54:32B-3; the Urban Enterprise Zone rate and the New York City
// combined rate do not, and inferring the UEZ date from the statewide one is exactly the
// inference this refuses - the statute makes it half that rate, which dates the VALUE and not
// the version. If a later edit quietly supplies an unread date to silence the obligation, or
// drops the read one, this reds.
test fn w_statutory_rate_versions_are_read_where_claimed() -> Bool {
  statutory_rate_version_is_read(r: nj_statewide_sales_tax)
    && !statutory_rate_version_is_read(r: nj_uez_reduced_sales_tax)
    && !statutory_rate_version_is_read(r: nyc_combined_sales_tax)
}

// THE DESTINATION IS PROJECTED OUT OF THE RATE, WHICH IS THE WHOLE POINT OF DELETING THE SIBLING
// FIELD. An earlier revision of this change dropped ResidualUseTaxOwed's destination_jurisdiction
// claiming the rate already determined it, while StatutoryRate carried only a figure and a version
// and therefore determined nothing - the destination would simply have been gone. This pins the
// repaired version: the residual built from the New York City rate reports NEW YORK CITY, and it
// reports it by reading the rate rather than by a second field an author typed.
//
// THE DISCRIMINATING RED: point nyc_residual at nj_statewide_sales_tax instead and the first
// conjunct reds, because the projection follows the rate. Under the deleted-field premise there
// would have been nothing left to red. The second and third conjuncts hold the arms apart so a
// projection that answered DestinationCitedByRate for every residual cannot pass.
// AN ATTESTATION NAMING A STATE DOES NOT ESTABLISH A CITY, and this is the control for that.
// Both attested census lots rest on the operator saying "New York tax was paid" - which does not
// say whether the state rate or the New York City combined rate was the one charged. An earlier
// revision cited nyc_combined_sales_tax for both, narrowing the attestation to a grain no evidence
// established; the figures differ, so a state-only payment on goods used in the city leaves a
// residual that the narrowed reading reported as settled. That is the expensive direction of the
// DESIGN section 4d error: the narrower claim was the comfortable one and had no evidence.
//
// THE DISCRIMINATING RED: re-point either fixture at AttestedAtCitedJurisdiction with a city rate
// and the first conjunct reds. The second conjunct is the other direction - an attestation that
// HAS been read to a citable jurisdiction must still report as cited - so this cannot be satisfied
// by a predicate that answers false for everything.
test fn w_state_grain_attestation_does_not_establish_a_city() -> Bool {
  match attested_fixture_standing() {
    AttestedAtCitedJurisdiction { jurisdiction: _ } => false
    AttestedJurisdictionGrainUnread { named_as_attested: n, read_obligation: _ } =>
      n == ("New York" as NonEmptyStr)
  }
  && match AttestedAtCitedJurisdiction {
    jurisdiction: decl_ref(
      module_path: "extdeps.tax.new_york_city_sales_and_use",
      decl_name: "nyc_pub718_authority",
    ),
  } {
    AttestedAtCitedJurisdiction { jurisdiction: j } =>
      declaration_ref_eq(
        a: j,
        b: decl_ref(
          module_path: "extdeps.tax.new_york_city_sales_and_use",
          decl_name: "nyc_pub718_authority",
        ),
      )
    AttestedJurisdictionGrainUnread { named_as_attested: _, read_obligation: _ } => false
  }
}

// THE STANDING IS READ OUT OF THE REAL FIXTURE ROW, not re-typed beside it. A control that builds
// its own copy of the value it checks is agreeing with itself: edit the population to cite a city
// rate and a re-typed control stays green, which is the one edit it exists to catch. This walks the
// same fixture_population the other witnesses use and projects the attested lot's jurisdiction, so
// the control moves when the fixture moves.
fn attested_fixture_standing() -> AttestedJurisdictionStanding {
  fold(fixture_population, init: AttestedJurisdictionGrainUnread {
    named_as_attested: "no attested lot found in the fixture population" as NonEmptyStr,
    read_obligation: "this arm means the fold matched nothing, not that a grain is unread" as NonEmptyStr,
  }, f: fn(acc, row) {
    match row.standing {
      SalesTaxAttestedIncluded { jurisdiction: j, residual: r, attestation: a } => j
      SalesTaxCollected { collection: c, residual: r } => acc
      SalesTaxIncludedJurisdictionUnread { read_obligation: o } => acc
      SalesTaxTreatmentUnrecorded { read_obligation: o } => acc
    }
  })
}

test fn w_residual_destination_is_projected_from_its_rate() -> Bool {
  match residual_destination_jurisdiction(residual: nyc_residual) {
    DestinationCitedByRate { jurisdiction: j } =>
      declaration_ref_eq(
        a: j,
        b: decl_ref(
          module_path: "extdeps.tax.new_york_city_sales_and_use",
          decl_name: "nyc_pub718_authority",
        ),
      )
    DestinationNotApplicableNoResidual => false
    DestinationUnreadWithResidualStanding => false
  }
  && match residual_destination_jurisdiction(residual: ResidualUseTaxNone) {
    DestinationCitedByRate { jurisdiction: _ } => false
    DestinationNotApplicableNoResidual => true
    DestinationUnreadWithResidualStanding => false
  }
  && match residual_destination_jurisdiction(
    residual: ResidualUseTaxUnread {
      read_obligation: "probe arm; no destination to project" as NonEmptyStr,
    },
  ) {
    DestinationCitedByRate { jurisdiction: _ } => false
    DestinationNotApplicableNoResidual => false
    DestinationUnreadWithResidualStanding => true
  }
}

test fn w_derived_and_transcribed_rates_are_exact_millionths() -> Bool {
  parts_per_million_count(m: statutory_rate_value(r: nj_statewide_sales_tax)) == 66250
    && parts_per_million_count(m: statutory_rate_value(r: nj_uez_reduced_sales_tax)) == 33125
    && parts_per_million_count(m: statutory_rate_value(r: nyc_combined_sales_tax)) == 88750
    && parts_per_million_count(m: statutory_rate_value(r: nj_uez_reduced_sales_tax)) * 2
      == parts_per_million_count(m: statutory_rate_value(r: nj_statewide_sales_tax))
    && parts_per_million_count(m: statutory_rate_value(r: nj_statewide_sales_tax)) < parts_per_million_scale_million()
}

test fn w_population_fold_refuses_a_repeated_lot() -> Bool {
  match admit_lot_tax_population(rows: fixture_population) {
    LotTaxPopulationComplete { rows: admitted } =>
      admitted.length() == 5
        && admitted.filter(row => lot_tax_residual_is_owed(standing: row.standing)).length() == 2
        && admitted.filter(row => lot_tax_is_attested_not_read(standing: row.standing)).length() == 1
        && admitted.filter(row => lot_tax_jurisdiction_is_unread(standing: row.standing)).length() == 2
    LotTaxPopulationRepeatedLot { lot: _, first_ordinal: _, ledger_ordinal: _ } => false
  }
    && match admit_lot_tax_population(rows: concat(fixture_population, [
      LotTaxEvidence {
        lot: lot_mt_collins,
        standing: SalesTaxTreatmentUnrecorded { read_obligation: "duplicate" as NonEmptyStr },
      },
    ])) {
      LotTaxPopulationComplete { rows: _ } => false
      LotTaxPopulationRepeatedLot { lot: l, first_ordinal: first, ledger_ordinal: later } =>
        inventory_lot_identity_eq(left: l, right: lot_mt_collins)
          && first == 0
          && later == 5
    }
}

test fn w_omitting_a_residual_lot_changes_the_derived_count() -> Bool {
  fixture_population.filter(row => lot_tax_residual_is_owed(standing: row.standing)).length() == 2
    && fixture_population.skip(n: 1).filter(row => lot_tax_residual_is_owed(standing: row.standing)).length() == 1
    && match fixture_population.first() {
      Absent => false
      Present { value: row } =>
        !lot_tax_is_attested_not_read(standing: row.standing)
          && lot_tax_residual_is_owed(standing: row.standing)
    }
}

test fn w_unread_residual_is_not_a_known_owe() -> Bool {
  !lot_tax_residual_is_owed(standing: SalesTaxCollected {
    collection: RateTranscribedFromNamedReceiptLine {
      jurisdiction: decl_ref(module_path: "extdeps.tax.new_jersey_sales_and_use", decl_name: "nj_statewide_sales_tax"),
      rate: parts_per_million(count: 1),
      receipt_line_label: "tax" as NonEmptyStr,
    },
    residual: ResidualUseTaxUnread { read_obligation: "destination rate unread" as NonEmptyStr },
  })
}

test fn w_equal_length_is_not_tax_coverage() -> Bool {
  let lots = [lot_mt_collins, lot_spark_uez, lot_marketplace]
  let tax = [
    LotTaxEvidence {
      lot: lot_mt_collins,
      standing: SalesTaxTreatmentUnrecorded { read_obligation: "a" as NonEmptyStr },
    },
    LotTaxEvidence {
      lot: lot_spark_uez,
      standing: SalesTaxTreatmentUnrecorded { read_obligation: "b" as NonEmptyStr },
    },
    LotTaxEvidence {
      lot: lot_unrecorded,
      standing: SalesTaxTreatmentUnrecorded { read_obligation: "orphan" as NonEmptyStr },
    },
  ]
  lots.length() == tax.length()
    && match lot_tax_covers_ledgers(lots: lots, tax: tax) {
      LotTaxJoinCovered { rows: _ } => false
      LedgerMissingTax { lot: l } => inventory_lot_identity_eq(left: l, right: lot_marketplace)
      TaxWithoutLedger { lot: _ } => false
      LotTaxJoinRepeatedLot { lot: _, first_ordinal: _, ledger_ordinal: _ } => false
    }
}
