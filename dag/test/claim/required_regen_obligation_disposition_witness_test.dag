module test.claim.required_regen_obligation_disposition_witness

import gunbc.required_regen_obligation_disposition {
  ObligationLifecycle,
  Active,
  Transferred,
  Retired,
  RetirementObligation,
  MirrorPopulationEmpty,
  RequiredConsumerPopulationEmpty,
  retirement_fully_discharged,
  host_deletion_admitted,
  carrier_deletion_admitted,
  required_regen_derivation_routes,
  some_derivation_route_remains_unexamined,
  refuted_route_count,
  required_regen_closure_membership_controls,
  required_regen_conformance_divergence,
  conformance_divergence_is_observed
}
import std.decl_ref { decl_ref }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

// Declared explicitly: a witness that declares no disposition is treated as ReadsLiveTree and
// DECLINED -- discovered, counted, never executed. Every assertion here reads substrate values
// only, so SubstrateInputsOnly is the honest declaration, and without it this evidence would be
// the inert decoration the carrier it guards warns about.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data transferred_example: ObligationLifecycle = Transferred {
  successor_authority: decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_run"),
  successor_realization: decl_ref(module_path: "v2.workflow.required_regen", decl_name: "required_regen_sync_admission")
}

data fully_retired_example: ObligationLifecycle = Retired {
  discharged: [MirrorPopulationEmpty, RequiredConsumerPopulationEmpty]
}

data partially_retired_example: ObligationLifecycle = Retired {
  discharged: [MirrorPopulationEmpty]
}

// THE ASYMMETRY, ASSERTED AS A DISAGREEMENT. Asserting each predicate separately is satisfied by a
// pair that answers false to everything -- the fused row again in typed clothing. The arms
// DIFFERING is the entire content of the split, so the test requires the difference.
test fn witness_transfer_admits_host_deletion_but_not_carrier_deletion() -> Bool {
  host_deletion_admitted(lifecycle: transferred_example)
    && carrier_deletion_admitted(lifecycle: transferred_example) == false
}

test fn witness_fully_discharged_retirement_admits_both_deletions() -> Bool {
  host_deletion_admitted(lifecycle: fully_retired_example)
    && carrier_deletion_admitted(lifecycle: fully_retired_example)
}

// A RETIREMENT THAT ASSERTS ITSELF WITHOUT DISCHARGING BOTH OBLIGATIONS ADMITS NOTHING. This is
// what typing the obligations bought: an earlier revision carried free-form String receipts, which
// could claim discharge without exhibiting it, so this case was unrepresentable and therefore
// untestable. It is the exact shape the finding is about -- naming a disposition is not proving it.
test fn witness_partial_retirement_admits_neither_deletion() -> Bool {
  host_deletion_admitted(lifecycle: partially_retired_example) == false
    && carrier_deletion_admitted(lifecycle: partially_retired_example) == false
}

test fn witness_partial_retirement_is_not_fully_discharged() -> Bool {
  retirement_fully_discharged(discharged: [MirrorPopulationEmpty]) == false
    && retirement_fully_discharged(discharged: [RequiredConsumerPopulationEmpty]) == false
    && retirement_fully_discharged(discharged: [MirrorPopulationEmpty, RequiredConsumerPopulationEmpty])
}

test fn witness_active_admits_neither_deletion() -> Bool {
  host_deletion_admitted(lifecycle: Active) == false
    && carrier_deletion_admitted(lifecycle: Active) == false
}

// GUARD AGAINST THIS RECUT'S OWN FAILURE MODE. An earlier revision concluded the class could not
// climb on the strength of ONE refuted route. If routes are marked refuted one at a time, each
// step looking locally reasonable, that impossibility claim returns silently -- so the census must
// go red instead. The exact count also keeps the receipts honest in the other direction: dropping
// the refuted route would erase real measured evidence.
test fn witness_no_impossibility_claim_is_reachable() -> Bool {
  some_derivation_route_remains_unexamined()
}

test fn witness_exactly_one_route_is_refuted() -> Bool {
  refuted_route_count() == 1
}

// THE FINDING ITSELF, ASSERTED SO IT EXPIRES LOUDLY. If a conformance relation later lands and the
// carrier names every state the host refuses, this goes RED and the census must be revisited
// rather than standing as a claim about a state that has ended.
test fn witness_conformance_relation_remains_unobserved() -> Bool {
  conformance_divergence_is_observed(d: required_regen_conformance_divergence) == false
}

test fn witness_divergence_counts_are_internally_consistent() -> Bool {
  required_regen_conformance_divergence.carrier_named_states
      < required_regen_conformance_divergence.host_distinct_refusal_states
    && required_regen_conformance_divergence.host_distinct_refusal_states
      <= required_regen_conformance_divergence.host_production_refusal_sites
    && required_regen_conformance_divergence.carrier_variants_without_producer
      < required_regen_conformance_divergence.carrier_declared_variants
}

// Both arms of the control table, plus anti-vacuity: either arm alone passes over an empty table
// and reports a rule nobody measured.
test fn witness_unimported_modules_are_not_emitted() -> Bool {
  required_regen_closure_membership_controls
    |> filter(o => o.seed_importers == 0)
    |> all(o => o.emitted == false)
}

test fn witness_imported_modules_are_emitted() -> Bool {
  required_regen_closure_membership_controls
    |> filter(o => o.seed_importers > 0)
    |> all(o => o.emitted)
}

test fn witness_control_table_populates_both_arms() -> Bool {
  length(xs: required_regen_closure_membership_controls |> filter(o => o.seed_importers == 0)) > 0
    && length(xs: required_regen_closure_membership_controls |> filter(o => o.seed_importers > 0)) > 0
}
