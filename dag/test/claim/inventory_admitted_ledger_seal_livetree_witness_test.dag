module test.claim.inventory_admitted_ledger_seal_livetree_witness_test

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CompileDiagnosticCensusRow,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count
}
import std.types { String, Bool, Int, List }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE CONSTRUCTOR SEAL ON AdmittedInventoryLedger, MEASURED RATHER THAN ASSERTED. Review 59291
// established that provenance may be read only from a ledger fold_inventory_ledger admitted, and
// the carrier is what makes that structural. The runtime battery in
// test.claim.inventory_asset_source_lot_witness_test proves the FOLD refuses the bad populations;
// it says nothing about whether a foreign module can skip the fold entirely by writing the record
// literal. If it can, admit_inventory_ledger is a validator every consumer may bypass and the
// claimed rung is inflation rather than construction. That is a separate question needing separate
// evidence, and this file is it.
//
// The coproduct-variant form of this question was already falsified in this lane -- sole_constructor
// seals RECORDS, not coproduct arms -- so the subject here is deliberately the record
// AdmittedInventoryLedger and not the LedgerAdmitted arm that carries it.
//
// ReadsLiveTree IS TRUTHFUL AND IT NO LONGER MEANS NON-GATING. compile_dag_diagnostic_census
// resolves synthetic sources against the live checkout, so the declaration is the honest one. What
// changed is what it BUYS. It used to route the file to RequiredFloorDisposition DeclinedLiveTree --
// discovered, declined, never run -- and an earlier draft of this annotation said exactly that.
// v2.workflow.required_floor has since DELETED that arm at the root: the interpreter's
// hermetic-checkout carve-out already decides the same question per identity at the effect boundary,
// so the decline was a prediction standing where a decision existed. live_tree_disposition now feeds
// affected-set eligibility and nothing else. The claim was not wrong when written; it was
// invalidated by composition with main, which is why review 5103871417 caught it in a file this
// change never edited.
//
// SO THIS BATTERY'S DISPOSITION IS WHATEVER THE EXACT-HEAD REQUIRED RUN REPORTS, and this annotation
// deliberately does not predict it. If the identities are planned they execute and they gate; if the
// census reaches a host effect with no hermetic arm, the interpreter refuses with
// HermeticHostEffectRefused and the claim reports route_gap, which BLOCKS rather than quietly
// passing. Either outcome is louder than the silence the deleted arm produced, and neither one is
// established by a sentence here.

data forged_source: String = "module probe_ledger_forged_admitted\nimport product.inventory { AdmittedInventoryLedger, ProcurementLot }\nfn forged(lot: ProcurementLot) -> AdmittedInventoryLedger {\n  AdmittedInventoryLedger { lot: lot, events: [] }\n}\n"

data lawful_source: String = "module probe_ledger_lawful_admitted\nimport product.inventory { AdmittedInventoryLedger, ProcurementLot }\nfn lawful(lot: ProcurementLot, value: AdmittedInventoryLedger) -> AdmittedInventoryLedger {\n  value\n}\n"

fn ledger_rows_of_subject(rows: List<CompileDiagnosticCensusRow>, wanted: String) -> List<CompileDiagnosticCensusRow> {
  rows |> filter(r => r.subject_name == wanted)
}

// -1 on the NotRunnable arm, so a harness that never ran satisfies no witness below: every assertion
// here compares against a non-negative quantity.
fn ledger_seal_violation_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(
      rows: ledger_rows_of_subject(
        rows: census_rows_of_class(
          rows: census_blocking_rows(rows: rows),
          wanted: "SoleConstructorViolation"
        ),
        wanted: "AdmittedInventoryLedger"
      )
    )
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

test fn w_a_foreign_record_literal_of_the_admitted_ledger_refuses() -> Bool {
  ledger_seal_violation_count(source: forged_source) >= 1
}

// The positive control. Same imports, same parameter list, no record literal: it proves the type
// resolves and is legally nameable from a foreign module, so the red above is the literal being
// refused rather than the import failing.
test fn w_lawful_foreign_use_of_the_admitted_ledger_is_unsealed() -> Bool {
  ledger_seal_violation_count(source: lawful_source) == 0
}

// The differential. Both counts above could be satisfied by a census dominated by the shared
// closure; the subtraction states that the forged literal is the whole difference.
test fn w_the_ledger_seal_is_the_only_difference_between_the_sources() -> Bool {
  ledger_seal_violation_count(source: forged_source) - ledger_seal_violation_count(source: lawful_source) >= 1
}
