module test.claim.uri_validated_scalar_wall_compile_red

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data uri_validated_scalar_wall_note: String = "D1 compile-clean controls for uri_percent_encode_admitted_scalar_wire (#7790). Nominal UriUnicodeScalar at the admitted entry is not yet a hard synthetic-compile refusal in the v1 pool — runtime re-validation on uri_percent_encode_unicode_scalar carries that bypass class instead (uri_percent_encode_refuses_directly_constructed_surrogate_scalar_holds). These REDs refuse bare Int at the admitted entry and a misspelled UriValidatedScalar field at compile time."

data red_bare_int_note: String = "RED A — bare Int at uri_percent_encode_admitted_scalar_wire. The admitted entry must not accept an unadmitted scalar carrier."

fn w_red_bare_int_at_admitted_wire_entry() -> Bool {
  compile_dag_rust_emit_check(
    "module urivalreda\n\nimport extdeps.uri {\n  UriPercentEncodeBuilding,\n  UriPercentEncodeRefused,\n  uri_percent_encode_admitted_scalar_wire,\n}\n\nfn bypass() -> String {\n  match uri_percent_encode_admitted_scalar_wire(scalar: 55296) {\n    UriPercentEncodeBuilding { wire: w } => w\n    UriPercentEncodeRefused { cause: _ } => \"refused\"\n  }\n}\n",
    "src/urivalreda.rs",
    [],
    []
  )
}

data red_misspelled_field_note: String = "RED B — UriValidatedScalar { cp: 233 } uses the raw UriUnicodeScalar field name. The admitted carrier field is admitted_cp; the misspelled record must not compile."

fn w_red_misspelled_validated_scalar_field() -> Bool {
  compile_dag_rust_emit_check(
    "module urivalredb\n\nimport extdeps.uri {\n  UriValidatedScalar,\n  UriPercentEncodeBuilding,\n  UriPercentEncodeRefused,\n  uri_percent_encode_admitted_scalar_wire,\n}\n\nfn bypass() -> String {\n  match uri_percent_encode_admitted_scalar_wire(scalar: UriValidatedScalar { cp: 233 }) {\n    UriPercentEncodeBuilding { wire: w } => w\n    UriPercentEncodeRefused { cause: _ } => \"refused\"\n  }\n}\n",
    "src/urivalredb.rs",
    [],
    []
  )
}

test fn uri_validated_scalar_wall_red_bare_int_refuses() -> Bool {
  !w_red_bare_int_at_admitted_wire_entry()
}

test fn uri_validated_scalar_wall_red_misspelled_field_refuses() -> Bool {
  !w_red_misspelled_validated_scalar_field()
}
