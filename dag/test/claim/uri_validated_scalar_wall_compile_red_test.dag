module test.claim.uri_validated_scalar_wall_compile_red

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data uri_validated_scalar_wall_note: String = "D1 compile-clean control for UriValidatedScalar (#7790). The carrier is sole_constructor; uri_validated_scalar_construction is the only producer and performs scalar-range plus surrogate checks. Cross-module record construction with a valid field name but an invalid scalar must fail with SoleConstructorViolation — a branded type name is never the evidence; the constructor is."

data red_forged_validated_scalar_note: String = "RED — cross-module UriValidatedScalar { admitted_cp: 55296 } at uri_percent_encode_admitted_scalar_wire. Correct field name, surrogate scalar; must fail SoleConstructorViolation, not compile clean."

fn w_red_forged_validated_scalar_surrogate() -> Bool {
  compile_dag_rust_emit_check(
    "module urivalred\n\nimport extdeps.uri {\n  UriValidatedScalar,\n  UriPercentEncodeBuilding,\n  UriPercentEncodeRefused,\n  uri_percent_encode_admitted_scalar_wire,\n}\n\nfn bypass() -> String {\n  match uri_percent_encode_admitted_scalar_wire(scalar: UriValidatedScalar { admitted_cp: 55296 }) {\n    UriPercentEncodeBuilding { wire: w } => w\n    UriPercentEncodeRefused { cause: _ } => \"refused\"\n  }\n}\n",
    "src/urivalred.rs",
    [],
    []
  )
}

test fn uri_validated_scalar_wall_red_forged_surrogate_refuses() -> Bool {
  !w_red_forged_validated_scalar_surrogate()
}
