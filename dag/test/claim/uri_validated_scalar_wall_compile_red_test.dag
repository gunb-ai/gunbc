module test.claim.uri_validated_scalar_wall_compile_red

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data uri_validated_scalar_wall_note: String = "D1 construction wall (#7790): uri_percent_encode_admitted_scalar_wire accepts UriValidatedScalar only — minted by uri_unicode_scalar_construction, not a hand-built UriUnicodeScalar record and not a surrogate literal cast. Each fake must FAIL TO COMPILE via compile_dag_rust_emit_check; if the admitted wire entry widens back to UriUnicodeScalar or bare Int, the RED goes red."

data red_raw_scalar_note: String = "RED A — bypass via hand-built UriUnicodeScalar { cp: 55296 } at the admitted scalar wire entry. A raw record must not typecheck against UriValidatedScalar."

fn w_red_raw_unicode_scalar_at_admitted_wire_entry() -> Bool {
  compile_dag_rust_emit_check(
    "module urivalreda\n\nimport extdeps.uri {\n  UriUnicodeScalar,\n  UriPercentEncodeBuilding,\n  UriPercentEncodeRefused,\n  uri_percent_encode_admitted_scalar_wire,\n}\n\nfn bypass() -> String {\n  match uri_percent_encode_admitted_scalar_wire(scalar: UriUnicodeScalar { cp: 55296 }) {\n    UriPercentEncodeBuilding { wire: w } => w\n    UriPercentEncodeRefused { cause: _ } => \"refused\"\n  }\n}\n",
    "src/urivalreda.rs",
    [],
    []
  )
}

data red_surrogate_record_note: String = "RED B — bypass via UriValidatedScalar { cp: 55296 } without construction. The where unicode_scalar field refinement must refuse the surrogate literal at the record site."

fn w_red_surrogate_literal_record_validated_scalar() -> Bool {
  compile_dag_rust_emit_check(
    "module urivalredb\n\nimport extdeps.uri {\n  UriValidatedScalar,\n  UriPercentEncodeBuilding,\n  UriPercentEncodeRefused,\n  uri_percent_encode_admitted_scalar_wire,\n}\n\nfn bypass() -> String {\n  match uri_percent_encode_admitted_scalar_wire(scalar: UriValidatedScalar { cp: 55296 }) {\n    UriPercentEncodeBuilding { wire: w } => w\n    UriPercentEncodeRefused { cause: _ } => \"refused\"\n  }\n}\n",
    "src/urivalredb.rs",
    [],
    []
  )
}

test fn uri_validated_scalar_wall_red_raw_unicode_scalar_refuses() -> Bool {
  !w_red_raw_unicode_scalar_at_admitted_wire_entry()
}

test fn uri_validated_scalar_wall_red_surrogate_literal_record_refuses() -> Bool {
  !w_red_surrogate_literal_record_validated_scalar()
}
