// module gunbc.test.claim.approve.ios.vectors.resource.derivation.witness
//
// Charter 5 L6 (proud-bee-376), item (iii). DESIGN.md §5: the fact a generated file states lives in
// exactly one .dag declaration.
//
// WHAT WAS WRONG. load() asked the XCTest bundle for a resource by two hand-typed strings —
// forResource: "vectors", withExtension: "json" — while the only authority for the emitted file's name
// is gunbc.generated_artifact's location row for ApprovalDeviceVectorsArtifact. The pair was a second
// authority for a fact that row already owns. Worse, the file's own doc comment already CLAIMED a join
// to the emitter ("the .dag witness has not emitted it") that no row implemented: rename the emitted
// fixture and load() silently looks for a file that no longer exists, and per
// approve_ios_vector_check_unenrolled_frontier (dag/gunbc/approve_ios_app.dag) ApproveTests "is executed
// by no lane" — no macOS runner, so it runs only when an operator presses Run on a MacBook. So the
// drift class this witness kills is one nothing on the merge path could have seen.
//
// WHAT IT CLAIMS. The stem and extension are derived from that row's `name` split at the dot, and the
// derivation is GUARDED: a name that is not <stem>.<extension> refuses the emission with a named
// reason, so a rename reds as a refusal that identifies the broken join instead of emitting a load()
// that tests no vector at all.
module test.claim.approve.ios.vectors.resource.derivation.witness

import std.types { Bool, String, List }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.optional { Present }
import v2.extdeps.languages.swift.rows { SwiftRowEmitted, SwiftRowEmissionRefused }
import gunbc.generated_artifact { ApprovalDeviceVectorsArtifact, artifact_location }
import gunbc.approve_ios_swift_protocol_vector_tests {
  approve_ios_vectors_artifact_name,
  approve_ios_vectors_resource_stem,
  approve_ios_vectors_resource_extension,
  approve_ios_vectors_resource_name_ok,
  approve_ios_vectors_resource_join_ok,
  approve_ios_vectors_resource_refusal_reason,
  expected_approve_ios_protocol_vector_tests_swift,
}

// The row the app must agree with, read back through the authority — never typed again in this module.
fn authority_name() -> String {
  artifact_location(a: ApprovalDeviceVectorsArtifact).name
}

// POSITIVE: the join holds at the row's real name AND the emission really produces bytes, so the
// refusal arm is not being taken silently (which would make every other witness here vacuous).
fn emission_is_not_silently_refused_helper() -> Bool {
  approve_ios_vectors_resource_join_ok()
    && match expected_approve_ios_protocol_vector_tests_swift() {
      SwiftRowEmitted { source: s } => s != ""
      SwiftRowEmissionRefused { reason: _ } => false
    }
}

// RED: every name that is not <stem>.<extension> is refused by the same predicate the emission guards
// on. Admitting any of them emits a load() that asks the bundle for a file the .dag does not emit — a
// green suite that tested no vector, the exact silent drift this item removes.
fn malformed_resource_names_are_refused_helper() -> Bool {
  !approve_ios_vectors_resource_name_ok(name: "vectors")
    && !approve_ios_vectors_resource_name_ok(name: ".json")
    && !approve_ios_vectors_resource_name_ok(name: "vectors.")
    && !approve_ios_vectors_resource_name_ok(name: "")
    && !approve_ios_vectors_resource_name_ok(name: "a.b.json")
    && approve_ios_vectors_resource_name_ok(name: "vectors.json")
}

// RED: the refusal is NAMED, so a future rename reports which join broke instead of failing as an
// unexplained missing artifact — which is how the hand-typed pair behaved.
fn refusal_carries_a_name_helper() -> Bool {
  approve_ios_vectors_resource_refusal_reason
    == "approve-ios-vectors-resource-name-not-a-stem-and-extension"
}

// POSITIVE, and the non-circular one. The expectation is computed HERE, from the authority row — the
// witness never asks the carrier what the stem and extension are, because that is the thing under test
// (a derivation cannot witness its own derivation). It then reads the EMITTED bytes and requires them
// to carry that pair. Rename the artifact row and both sides move together, which is the point; run the
// same assertion against the pre-change carrier — which spelled forResource: "vectors"/withExtension:
// "json" by hand — and it returns false, because the bytes stay put while the row moves. One assertion,
// one pass and one fail, across the edit: that is the control.
fn emitted_load_line() -> String {
  match expected_approve_ios_protocol_vector_tests_swift() {
    SwiftRowEmitted { source: s } => s
    SwiftRowEmissionRefused { reason: _ } => ""
  }
}

// The needle, built ONLY from the authority row — never from the carrier's own derivation.
fn rows_resource_needle() -> String {
  let parts = split(s: artifact_location(a: ApprovalDeviceVectorsArtifact).name, delimiter: ".")
  let stem = match parts.first() { Present { value: p } => p  Absent => "?" }
  let ext = match parts.last() { Present { value: p } => p  Absent => "?" }
  concat(concat(concat("forResource: \"", stem), "\", withExtension: \"" ), concat(ext, "\""))
}

fn emitted_bytes_carry_the_rows_resource_name_helper() -> Bool {
  let s = emitted_load_line()
  s != "" && s.contains(rows_resource_needle())
}

// DIAGNOSTIC PROBES (so a failing direction says which primitive broke rather than guessing):
// literal-only needle -> proves contains() works and the bytes look like that at head.
fn probe_literal_needle() -> Bool {
  emitted_load_line().contains("forResource: \"vectors\", withExtension: \"json\"")
}

// row-derived needle -> proves the row -> split -> concat chain reaches the same bytes.
fn probe_row_needle() -> Bool {
  emitted_load_line().contains(rows_resource_needle())
}

test fn emitted_bytes_carry_the_rows_resource_name() -> Bool {
  emitted_bytes_carry_the_rows_resource_name_helper()
}

// POSITIVE: the carrier's derivation agrees with the authority row read independently here — the pair
// is what the row says, not what the carrier decided.
fn derivation_agrees_with_the_row_helper() -> Bool {
  let parts = split(s: artifact_location(a: ApprovalDeviceVectorsArtifact).name, delimiter: ".")
  match parts.first() {
    Present { value: row_stem } =>
      match parts.last() {
        Present { value: row_ext } =>
          approve_ios_vectors_resource_stem() == row_stem
            && approve_ios_vectors_resource_extension() == row_ext
        Absent => false
      }
    Absent => false
  }
}

test fn derivation_agrees_with_the_row() -> Bool {
  derivation_agrees_with_the_row_helper()
}

test fn vectors_resource_emission_is_not_silently_refused() -> Bool {
  emission_is_not_silently_refused_helper()
}

test fn red_malformed_resource_names_are_refused() -> Bool {
  malformed_resource_names_are_refused_helper()
}

test fn red_refusal_carries_a_name() -> Bool {
  refusal_carries_a_name_helper()
}

// ---- evidence entry points -------------------------------------------------------------
// `gunbc run --function` only reports a verdict it can map to an exit code: a Bool `false` exits 2 as
// "did not return ProcessExit", which is NOT the same as the claim failing. These wrappers turn each
// claim into a real exit code so the RED directions are actually observable off the runner. They call
// the SAME helper the `test fn` calls, so the claim and the evidence can never diverge.

fn evidence_emitted_bytes_carry_the_rows_resource_name() -> ProcessExit {
  if emitted_bytes_carry_the_rows_resource_name_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "emitted load() does not carry the artifact row's resource name" }
  }
}

fn evidence_derivation_agrees_with_the_row() -> ProcessExit {
  if derivation_agrees_with_the_row_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "carrier derivation disagrees with the authority row" }
  }
}

fn evidence_probe_literal_needle() -> ProcessExit {
  if probe_literal_needle() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "emitted bytes do not contain the literal needle" }
  }
}

fn evidence_probe_row_needle() -> ProcessExit {
  if probe_row_needle() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "emitted bytes do not contain the row-derived needle" }
  }
}

// INVERSE probe: true only when the emission REFUSES. Evaluated under a malformed row name it is the
// direction that must pass; at head it must fail. Proves the guard bites rather than emitting anyway.
fn evidence_refusal_is_taken() -> ProcessExit {
  if !approve_ios_vectors_resource_join_ok() && emitted_load_line() == "" { ExitSuccess } else {
    ExitFailure { code: 1, reason: "guard did not refuse; bytes still produced" }
  }
}

// The refusal must be the NAMED one, not merely some refusal: a rename has to report which join broke.
// Run under a malformed row name it must pass; at head (where nothing is refused) it must fail, which is
// why it is never read alone.
fn refusal_carries_the_named_reason_helper() -> Bool {
  match expected_approve_ios_protocol_vector_tests_swift() {
    SwiftRowEmitted { source: _ } => false
    SwiftRowEmissionRefused { reason: r } => r == approve_ios_vectors_resource_refusal_reason
  }
}

fn evidence_refusal_carries_the_named_reason() -> ProcessExit {
  if refusal_carries_the_named_reason_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "refusal did not carry the named reason" }
  }
}

fn evidence_emission_is_not_silently_refused() -> ProcessExit {
  if emission_is_not_silently_refused_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "emission refused or produced no bytes at this head" }
  }
}

fn evidence_red_malformed_resource_names_are_refused() -> ProcessExit {
  if malformed_resource_names_are_refused_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "a malformed resource name was admitted by the predicate" }
  }
}

fn evidence_red_refusal_carries_a_name() -> ProcessExit {
  if refusal_carries_a_name_helper() { ExitSuccess } else {
    ExitFailure { code: 1, reason: "the refusal arm does not carry the named reason" }
  }
}
