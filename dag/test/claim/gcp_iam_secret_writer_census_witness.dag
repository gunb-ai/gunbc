module test.claim.gcp_iam_secret_writer_census_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List, String }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import gunbc.auth.gcp_iam_trust_roots { TrustRootCeremony, IamBootstrapApply, ApprovalMacKeyProvision, OrgAdminAppKeyAccessConverge, trust_root_ceremony_entry }
import gunbc.auth.privileged_effect_census {
  PrivilegedEffectSite, privileged_effect_census, RealizedAuthorization, RealizedOperatorSession, RealizedFederatedGrant,
  SecretIamWriter, SecretIamWriterArm, SecretIamWriterConverge, SecretIamWriterDeltaApply, SecretIamWriterTrustRootCeremony, secret_iam_writer_census,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ── WHAT THESE CLAIMS ARE ABOUT ──────────────────────────────────────────────────────────────
// The secret-IAM writer census (gunbc.auth.privileged_effect_census secret_iam_writer_census) against the
// census rows it names: every route that writes secret IAM under an operator session is a trust-root
// ceremony, the converge and the delta apply are federated, and the cut routes write nothing. The
// writer population is hand-enumerated (gunbc#14360, 2026-10-19); its next rung is
// gunbc.recurring_failure_mode a_secret_iam_cell_declarer_outside_a_hand_listed_universe.

fn census_row(site: DeclarationRef) -> List<PrivilegedEffectSite> {
  filter(privileged_effect_census, r => declaration_ref_eq(a: r.site, b: site))
}

fn operator_session(r: RealizedAuthorization) -> Bool {
  match r { RealizedOperatorSession { arm: _ } => true  _ => false }
}

fn federated(r: RealizedAuthorization) -> Bool {
  match r { RealizedFederatedGrant => true  _ => false }
}

// THE LAW, over any writer list: a writer realized under an operator session is a trust-root ceremony
// whose site is the entry that ceremony names; the converge and the delta apply are federated grants.
fn writer_admitted(w: SecretIamWriter) -> Bool {
  let rows = census_row(site: w.site)
  count(rows) == 1 && all(rows, r => match w.arm {
    SecretIamWriterTrustRootCeremony { ceremony } => concat(concat(w.site.module_path as String, " "), w.site.decl_name as String) == trust_root_ceremony_entry(ceremony: ceremony)
    SecretIamWriterConverge => federated(r: r.realized)
    SecretIamWriterDeltaApply => federated(r: r.realized)
  } && (!operator_session(r: r.realized) || match w.arm { SecretIamWriterTrustRootCeremony { ceremony: _ } => true  SecretIamWriterConverge => false  SecretIamWriterDeltaApply => false }))
}

test fn every_operator_session_secret_iam_writer_is_a_trust_root_ceremony() -> Bool {
  count(secret_iam_writer_census) == 5 && all(secret_iam_writer_census, w => writer_admitted(w: w))
}

// RED CONTROL: the cut BMC bootstrap, entered as a writer under any arm, is refused (operator session,
// not a ceremony entry), as is an operator-session ceremony row mislabelled as the converge.
test fn a_cut_or_mislabelled_writer_is_refused() -> Bool {
  let bmc = decl_ref(module_path: "gunbc.assimilate.bmc_bootstrap_provision", decl_name: "bmc_bootstrap_provision_srv3")
  let mac = decl_ref(module_path: "gunbc.auth.approval_mac_key_provision", decl_name: "provision_approval_mac_keys")
  !writer_admitted(w: SecretIamWriter { site: bmc, arm: SecretIamWriterConverge })
    && !writer_admitted(w: SecretIamWriter { site: bmc, arm: SecretIamWriterTrustRootCeremony { ceremony: ApprovalMacKeyProvision } })
    && !writer_admitted(w: SecretIamWriter { site: mac, arm: SecretIamWriterConverge })
    && writer_admitted(w: SecretIamWriter { site: mac, arm: SecretIamWriterTrustRootCeremony { ceremony: ApprovalMacKeyProvision } })
}

// THE CUT ROUTES ARE NOT WRITERS: each still has a census row (it still creates identities) and none is
// in the writer census.
test fn the_cut_routes_are_absent_from_the_writer_census() -> Bool {
  let cut = [
    decl_ref(module_path: "gunbc.assimilate.bmc_bootstrap_provision", decl_name: "bmc_bootstrap_provision_srv3"),
    decl_ref(module_path: "gunbc.auth.heal_publisher_provision", decl_name: "heal_publisher_federation_provision_with_supplied_token"),
    decl_ref(module_path: "gunbc.auth.managed_host_boot_federation_provision", decl_name: "managed_host_boot_federation_provision_with_supplied_token"),
  ]
  all(cut, c => count(census_row(site: c)) == 1 && !any(secret_iam_writer_census, w => declaration_ref_eq(a: w.site, b: c)))
}
