module test.claim.resource_requirement_call_admission_witness

import std.types { String, Bool, Int }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A CALL TO A DECLARATION THAT REQUIRES A RESOURCE MUST ESTABLISH IT, AND THE REALIZED CALL PASSES
// THE CALLER'S BINDING. Authorities: v1.std.core ResourceRequirementUnestablished (blocking),
// v1.compiler.infer resource_requirement_diags (the typecheck wall, keyed on the resolved callee
// identity), v1.compiler.infer established_resource_binding (the one matching fold), and
// v1.compiler.emit_rust emit_typed_call (the consumer that renders the caller's binding).
//
// THE DEFECT THIS PINS. `fn reads(path) uses fs: Filesystem` called from `fn plain(path)` agrees
// with the declaration on arity, and the Rust emitter published `reads(path.clone(), &fs).await?`
// inside a synchronous fn that binds no `fs`: the emitter appended the CALLEE's binding name
// unconditionally and consulted nothing about the caller, so the artifact was written and rustc
// refused it later (measured 2026-09-22 on the pre-repair seed; the emitted line is quoted from
// that run). DESIGN section 5 silent wrongness at the realization boundary, and the same root
// shape as the callee-identity defect resolved_call_emission_identity_witness pins one link
// upstream: a contract keyed on a spelling where the identity was already in hand.
//
// WHY THESE ROWS DISCRIMINATE RATHER THAN SNAPSHOT. The two reds and the green control differ only
// in the CALLER's `uses` clause -- the callee, the argument list and the arity are identical across
// all three -- so a wall that counted arguments cannot separate them, and a wall that compared
// binding NAMES would refuse the green control (caller binds `filesystem`, callee binds `fs`) while
// admitting nothing the reds forbid. The emitted-text row then proves the emitter consumed the
// caller's binding and not the callee's spelling: it must contain `&filesystem` and must not
// contain `&fs`.
//
// RUNG, STATED HONESTLY (DESIGN section 4b), AND CORRECTED DOWNWARD AFTER REVIEW 69961. The first
// version of this paragraph read rung 3 on source-to-Rust -- no Accepted program contains the call
// -- and that was INFLATION, by this document's own definition: it cited the ordinary-caller path
// while a second path stayed silent. The paths, separately:
//   ORDINARY CALLERS: rung 3. The typecheck refuses before any file exists (v1.compiler.compile
//   emittable_graph admits no graph carrying a blocking diagnostic), so no Accepted program
//   contains such a call and the emitter's own arm is genuinely unreachable from that door.
//   TEST ROOTS: rung 2, and this is the path the original claim did not measure. caller_is_test_root
//   admits a TestMarked caller with NO `uses` row, test roots ARE rendered
//   (v1.compiler.emit_rust extract_test_projections), so an Accepted program does reach
//   emit_typed_call's unestablished arm. That arm rendered emit_error_expr, whose Rust template is
//   panic!({0}); panic! has type `!` and coerces to any parameter type, so rustc ACCEPTED the
//   artifact and the failure moved to run time. It now renders compile_error!, which makes the
//   target compiler refuse -- a published artifact that cannot build, which is mitigation, NOT the
//   refusal-before-publishing the ordinary path gets.
// THE CLASS'S RUNG IS THE MINIMUM ACROSS ITS IN-SCOPE PATHS, so the class sits at RUNG 2, not 3.
// NEXT-RUNG TRIGGER, naming the capability rather than an artifact: ONE authority for how a test
// root obtains its resources, consumed by the interpreter's ambient provision and by the emitted
// realization alike, sufficient that a rendered test root either carries a binding to pass or is
// refused before the artifact is written. Until then the interpreter and the emitter answer that
// question differently, which is the same meaning fork the resource-requirement frontier holds as
// declared debt rather than ratifies.
// Interpretation serves resources ambiently and does not consult the caller, so on the
// source-to-interpretation path the requirement is enforced by this same typecheck and by nothing
// in the interpreter. The `uses`
// resource TYPE is compared by the declaration it resolves to in the caller's environment; a
// resource spelling that resolves nowhere matches nothing and refuses, never admits.
// TEST ROOTS ARE THE ONE ADMITTED CALLER WITHOUT A `uses` ROW (v1.compiler.infer caller_is_test_root):
// the claim harness supplies a test fn's resources ambiently and keys that provision on the root
// declaring none -- a test fn given `uses net: Network` bypassed the hermetic fixture and reached
// the live network (measured 2026-09-22) -- so the boundary control below pins that arm too.
// dissolve-on: never -- a call site may not pass a resource its declaration did not establish.

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

// NOT-RUNNABLE IS NOT ZERO: a census that could not run answers -1, which satisfies neither a
// green (== 0) nor a red (>= 1), so a broken harness cannot masquerade as either verdict.
fn blocking_unestablished_count(source: String) -> Int {
  match census_blocking_count_for_class(census: census_of(source: source), wanted: "ResourceRequirementUnestablished") {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// THE CALLEE, shared by every row: one parameter, one resource requirement.
data callee_source: String = "fn reads(path: String) -> String uses fs: Filesystem {\n  filesystem_read(path)\n}\n"

// RED 1: arity agrees, no resource established. The pre-repair emitter published this.
data red_plain_caller_source: String = "module probe_resource_plain_caller\nimport std.types { String }\nimport std.resources { Filesystem }\nfn reads(path: String) -> String uses fs: Filesystem {\n  filesystem_read(path)\n}\nfn plain(path: String) -> String {\n  reads(path: path)\n}\n"

// RED 2: arity agrees, the caller establishes a resource -- the WRONG one. A wall that only asked
// "does the caller have any `uses`" admits this; the declaration-identity comparison refuses it.
data red_wrong_resource_caller_source: String = "module probe_resource_wrong_caller\nimport std.types { String }\nimport std.resources { Filesystem, Network }\nfn reads(path: String) -> String uses fs: Filesystem {\n  filesystem_read(path)\n}\nfn networked(path: String) -> String uses net: Network {\n  reads(path: path)\n}\n"

// GREEN CONTROL: the caller establishes the same resource under a DIFFERENT binding name and spells
// the type by its qualified path. Name comparison would refuse this; declaration comparison admits it.
data green_renamed_binding_caller_source: String = "module probe_resource_renamed_caller\nimport std.types { String }\nimport std.resources { Filesystem }\nfn reads(path: String) -> String uses fs: Filesystem {\n  filesystem_read(path)\n}\nfn forwards(path: String) -> String uses filesystem: std.resources.Filesystem {\n  reads(path: path)\n}\n"

// BOUNDARY CONTROL: a callee with no requirement is callable from a plain fn, so the wall is
// about the requirement and not about calls in general.
data green_no_requirement_source: String = "module probe_resource_no_requirement\nimport std.types { String }\nfn plain_reads(path: String) -> String {\n  path\n}\nfn plain(path: String) -> String {\n  plain_reads(path: path)\n}\n"

// BOUNDARY CONTROL 2: a test-marked root calling the resource-requiring declaration is admitted.
data green_test_root_caller_source: String = "module probe_resource_test_root_caller\nimport std.types { String, Bool }\nimport std.resources { Filesystem }\nfn reads(path: String) -> String uses fs: Filesystem {\n  filesystem_read(path)\n}\ntest fn root(path: String) -> Bool {\n  reads(path: path) == path\n}\n"

test fn a_test_root_calling_a_resource_requiring_declaration_is_admitted() -> Bool {
  blocking_unestablished_count(source: green_test_root_caller_source) == 0
}

test fn a_plain_caller_of_a_resource_requiring_declaration_refuses() -> Bool {
  blocking_unestablished_count(source: red_plain_caller_source) >= 1
}

test fn a_caller_establishing_a_different_resource_refuses_by_declaration_identity() -> Bool {
  blocking_unestablished_count(source: red_wrong_resource_caller_source) >= 1
}

test fn a_caller_establishing_the_resource_under_another_name_is_admitted() -> Bool {
  blocking_unestablished_count(source: green_renamed_binding_caller_source) == 0
}

test fn a_callee_without_a_requirement_is_callable_from_a_plain_fn() -> Bool {
  blocking_unestablished_count(source: green_no_requirement_source) == 0
}

// THE CONSUMER ROW: the emitted call carries the CALLER's binding (`&filesystem`), never the
// callee's spelling (`&fs`), and the caller is realized as the effectful signature that binds it.
test fn the_emitted_call_passes_the_callers_binding_not_the_callees_spelling() -> Bool {
  compile_dag_rust_emit_check(
    green_renamed_binding_caller_source,
    "src/probe_resource_renamed_caller.rs",
    ["reads(path.clone(), &filesystem).await?", "filesystem: &Filesystem"],
    ["&fs)"]
  )
}

// REFUSE BEFORE PUBLISHING: the red source yields NO emitted file at all. The emit check answers
// false on a blocking diagnostic, and it would answer false on a missing file, so this row is
// paired with the census row above that names the class -- together they say the line stopped
// AND why.
test fn the_red_source_publishes_nothing() -> Bool {
  !compile_dag_rust_emit_check(
    red_plain_caller_source,
    "src/probe_resource_plain_caller.rs",
    [],
    []
  )
}
