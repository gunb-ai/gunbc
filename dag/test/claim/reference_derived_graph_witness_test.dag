module test.claim.reference_derived_graph_witness

import std.types { Bool, List, String }
import extdeps.filesystem.filesystem_io
import v2.std.diagnostic { Accepted, Rejected }
import v2.lens.module_graph {
  ImportResolutionFact,
  ModuleDependencyEdge,
  import_resolution_facts_live,
  reference_derived_resolution_facts_flagged_pending_reference_producer,
}
import tools.reference_derived_graph {
  ImportOnlyEdge,
  ReferenceOnlyEdge,
  SharedEdge,
  consumer_both_path,
  consumer_import_only_path,
  consumer_reference_only_path,
  diffs_include_import_only,
  diffs_include_reference_only,
  diffs_include_shared,
  fixture_report,
  provider_module,
}

data fixture_roots: List<String> = ["dag/test/fixture/reference_derived_graph"]

data fixture_exclude: List<String> = []

fn fixture_reference_edges() -> List<ModuleDependencyEdge> {
  match reference_derived_resolution_facts_flagged_pending_reference_producer(
    pool_roots: fixture_roots,
    importer_roots: fixture_roots,
    exclude_substrings: fixture_exclude
  ) {
    Accepted { value: edges, diagnostics: _ } => edges
    Rejected { diagnostics: _ } => []
  }
}

fn fixture_import_facts() -> List<ImportResolutionFact> {
  import_resolution_facts_live(
    pool_roots: fixture_roots,
    importer_roots: fixture_roots,
    exclude_substrings: fixture_exclude
  )
}

fn has_reference_edge(path: String, target: String) -> Bool {
  fold(fixture_reference_edges(), init: false, f: fn(acc, e) {
    acc || (e.path == path && e.target_module == target)
  })
}

fn has_import_fact(path: String, target: String) -> Bool {
  fold(fixture_import_facts(), init: false, f: fn(acc, f) {
    acc || (f.path == path && f.import_module == target)
  })
}

// Discriminating RED: a module that references another with no import still gets the
// reference-derived edge, and that identity is absent from the import-derived graph.
test fn reference_only_module_has_edge_and_unused_import_does_not() -> Bool {
  has_reference_edge(path: consumer_reference_only_path, target: provider_module)
    && !has_import_fact(path: consumer_reference_only_path, target: provider_module)
    && has_import_fact(path: consumer_import_only_path, target: provider_module)
    && !has_reference_edge(path: consumer_import_only_path, target: provider_module)
}

// Positive control: the same target imported and referenced is present on both graphs.
test fn imported_and_referenced_target_is_present_on_both_graphs() -> Bool {
  has_reference_edge(path: consumer_both_path, target: provider_module)
    && has_import_fact(path: consumer_both_path, target: provider_module)
}

test fn instrument_report_classifies_the_three_identities() -> Bool {
  match fixture_report() {
    Rejected { diagnostics: _ } => false
    Accepted { value: r, diagnostics: _ } =>
      diffs_include_reference_only(
        diffs: r.diffs,
        path: consumer_reference_only_path,
        target: provider_module
      )
        && diffs_include_import_only(
          diffs: r.diffs,
          path: consumer_import_only_path,
          target: provider_module
        )
        && diffs_include_shared(
          diffs: r.diffs,
          path: consumer_both_path,
          target: provider_module
        )
  }
}
