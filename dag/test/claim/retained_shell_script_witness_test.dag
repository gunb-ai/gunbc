module test.claim.retained_shell_script_witness


data srvn_takeover_ref: std.decl_ref.DeclarationRef = std.decl_ref.DeclarationRef {
  module_path: "gunbc.plans.fleet_subsumption_manual_gaps",
  decl_name: "fleet_subsumption_manual_gaps_plan",
  field: std.decl_ref.WholeDeclaration,
}

test fn witness_retained_transport_mints_from_record() -> Bool {
  let t = gunbc.retained_shell_script.retained_transport(
    body: "echo hi",
    reason: "witness: retained_transport mints through the sealed transport_script_seal",
    dissolves_to: srvn_takeover_ref,
  )
  t.body == "echo hi"
}

test fn witness_converter_preserves_body() -> Bool {
  let rss = gunbc.retained_shell_script.RetainedShellScript {
    body: "systemctl daemon-reload",
    reason: "witness: record -> transport",
    dissolves_to: srvn_takeover_ref,
  }
  gunbc.retained_shell_script.retained_shell_script_to_transport(rss: rss).body == "systemctl daemon-reload"
}

