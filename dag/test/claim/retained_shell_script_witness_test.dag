module test.claim.retained_shell_script_witness

import std.types { Bool, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.retained_shell_script {
  RetainedShellScript,
  retained_shell_script_to_transport,
  retained_transport,
}

data srvn_takeover_ref: DeclarationRef = DeclarationRef {
  module_path: "gunbc.plans.fleet_subsumption_manual_gaps",
  decl_name: "fleet_subsumption_manual_gaps_plan",
  field: WholeDeclaration,
}

fn witness_retained_transport_mints_from_record() -> Bool {
  let t = retained_transport(
    body: "echo hi",
    reason: "witness: cross-module as TransportScript mint",
    dissolves_to: srvn_takeover_ref,
  )
  (t as String) == "echo hi"
}

fn witness_converter_preserves_body() -> Bool {
  let rss = RetainedShellScript {
    body: "systemctl daemon-reload",
    reason: "witness: record -> transport",
    dissolves_to: srvn_takeover_ref,
  }
  (retained_shell_script_to_transport(rss: rss) as String) == "systemctl daemon-reload"
}

test fn retained_shell_script_holds() -> Bool {
  witness_retained_transport_mints_from_record()
    && witness_converter_preserves_body()
}
