module test.claim.budget_tree_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn claim(name: String, amount: std.nat.Nat, p: product.budget_tree.BudgetPriority) -> product.budget_tree.BudgetClaim {
  product.budget_tree.BudgetClaim { item: extdeps.accounting.budget.LineItem { purpose: name, amount: std.measure.byte_size(count: amount) }, priority: gunbc.plans.md_helpers.p }
}

fn appr(n: std.nat.Nat) -> extdeps.accounting.budget.Appropriation<std.measure.Memory, std.measure.One> {
  extdeps.accounting.budget.Appropriation { ceiling: std.measure.byte_size(count: n) }
}

fn sample_claims() -> List<product.budget_tree.BudgetClaim> {
  [
    claim(name: "g1", amount: 40, p: Guaranteed),
    claim(name: "g2", amount: 40, p: Guaranteed),
    claim(name: "b1", amount: 30, p: BestEffort)
  ]
}

fn leaf_node(cap: std.nat.Nat) -> product.budget_tree.BudgetNode {
  product.budget_tree.BudgetNode { name: "host", appropriation: appr(n: test.claim.roadmap_belt_witness.cap), claims: sample_claims(), children: [] }
}

fn child_node(cap: std.nat.Nat) -> product.budget_tree.BudgetNode {
  product.budget_tree.BudgetNode { name: "c", appropriation: appr(n: test.claim.roadmap_belt_witness.cap), claims: sample_claims(), children: [] }
}

fn root_with(child: product.budget_tree.BudgetNode) -> product.budget_tree.BudgetNode {
  product.budget_tree.BudgetNode { name: "root", appropriation: appr(n: 200), claims: [], children: [child] }
}

fn is_all_satisfied(r: product.budget_tree.BudgetReconciliation) -> Bool {
  match r { AllSatisfied { realized: x } => true  _ => false }
}

fn is_evicted(r: product.budget_tree.BudgetReconciliation) -> Bool {
  match r { product.budget_tree.Evicted { kept: k, evicted: e } => true  _ => false }
}

fn is_guaranteed_shortfall(r: product.budget_tree.BudgetReconciliation) -> Bool {
  match r { product.budget_tree.GuaranteedShortfall { shortfall: s } => true  _ => false }
}

fn witness_conservation_residue_lens() -> Bool {
  product.budget_tree.node_conserves_local(node: leaf_node(cap: 120)) && !product.budget_tree.node_conserves_local(node: leaf_node(cap: 100))
}

fn witness_tree_conservation_recursive() -> Bool {
  product.budget_tree.node_conserves(node: root_with(child: child_node(cap: 120)))
    && !product.budget_tree.node_conserves(node: root_with(child: child_node(cap: 100)))
}

fn witness_divide_once() -> Bool {
  let two_children = [child_node(cap: 100), child_node(cap: 100)]
  let tight = product.budget_tree.BudgetNode { name: "r", appropriation: appr(n: 150), claims: [], children: two_children }
  let roomy = product.budget_tree.BudgetNode { name: "r", appropriation: appr(n: 250), claims: [], children: two_children }
  return !product.budget_tree.node_conserves_local(node: tight) && product.budget_tree.node_conserves_local(node: roomy)
}

fn witness_admission_is_construction() -> Bool {
  let admitted = extdeps.accounting.budget.admit_all(appropriation: appr(n: 90), candidates: product.budget_tree.claim_items(claims: sample_claims()))
  return extdeps.accounting.budget.within_appropriation(appropriation: appr(n: 90), items: admitted.committed)
    && admitted.refused.length() > 0
}

fn witness_balance_states() -> Bool {
  (product.budget_tree.node_balance(node: leaf_node(cap: 200)) == Surplus)
    && (product.budget_tree.node_balance(node: leaf_node(cap: 110)) == Balanced)
    && (product.budget_tree.node_balance(node: leaf_node(cap: 100)) == Deficit)
}

fn witness_reconcile_all_satisfied() -> Bool {
  is_all_satisfied(r: product.budget_tree.reconcile(node: leaf_node(cap: 120), actual: std.measure.byte_size(count: 120)))
}

fn witness_reconcile_evicts_best_effort() -> Bool {
  is_evicted(r: product.budget_tree.reconcile(node: leaf_node(cap: 120), actual: std.measure.byte_size(count: 90)))
}

fn witness_reconcile_guaranteed_shortfall() -> Bool {
  is_guaranteed_shortfall(r: product.budget_tree.reconcile(node: leaf_node(cap: 120), actual: std.measure.byte_size(count: 50)))
}

fn witness_method_is_zero_based() -> Bool {
  budget_tree_method == ZeroBased
}

test fn budget_tree_holds() -> Bool {
  witness_conservation_residue_lens()
    && witness_tree_conservation_recursive()
    && witness_divide_once()
    && witness_admission_is_construction()
    && witness_balance_states()
    && witness_reconcile_all_satisfied()
    && witness_reconcile_evicts_best_effort()
    && witness_reconcile_guaranteed_shortfall()
    && witness_method_is_zero_based()
}
