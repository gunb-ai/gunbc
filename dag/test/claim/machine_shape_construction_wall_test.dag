module test.claim.machine_shape_construction_wall

import v2.lens.machine_shape { machine_shape_compile_gate }
import v2.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.logic { Bool }
import v2.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  Transform,
  TypeNode
}
import v2.std.witness { Witness }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data machine_shape_wall_witness_note: String = "RED/GREEN controls for MachineShape single-constructor compile gate (synthetic fixtures). A Transform call with callee Atom ^MachineShape is unsanctioned outside std.machine_shape and extdeps.*.machine_shape; ^shape_from_catalog is the sanctioned producer path."

fn ms_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ms_positional(target: Node) -> Edge {
  Edge { label: Positional, target: target }
}

fn ms_call(callee: Symbol, arg: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [ms_positional(target: ms_atom(id: callee)), ms_positional(target: arg)],
    occurrence_id: SyntheticOccurrence
  }
}

fn machine_shape_literal_fixture() -> Node {
  ms_call(
    callee: ^MachineShape,
    arg: Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  )
}

fn shape_from_catalog_call_fixture() -> Node {
  ms_call(callee: ^shape_from_catalog, arg: ms_atom(id: ^machine_shape_wall_fixture_input))
}

fn non_empty_contains_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

fn gate_rejects(o: Outcome<Witness<Node>>) -> Bool {
  match o {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn gate_accepts(o: Outcome<Witness<Node>>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn gate_red_synthetic_machine_shape_call() -> Bool {
  match machine_shape_compile_gate(node: machine_shape_literal_fixture()) {
    Rejected { diagnostics: d } =>
      non_empty_contains_reason(d: d, reason: ^machine_shape_unsanctioned_construction)
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn gate_green_synthetic_shape_from_catalog_call() -> Bool {
  gate_accepts(o: machine_shape_compile_gate(node: shape_from_catalog_call_fixture()))
}

test fn machine_shape_construction_wall_witnesses() -> Bool {
  gate_red_synthetic_machine_shape_call() && gate_green_synthetic_shape_from_catalog_call()
}
