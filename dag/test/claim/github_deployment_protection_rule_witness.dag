module test.claim.github_deployment_protection_rule_witness

// Witness for extdeps.github.deployment_protection_rule — the upstream interface a GitHub App uses
// to answer a custom deployment protection rule, which is the mechanism proposed to replace the
// operator's GitHub "Review deployments" click with the existing ntfy tap (plan:
// gunbc.plans.ntfy_deployment_gate_approval).
//
// WHY THESE REDS AND NOT MORE. The feature's one catastrophic failure is that a deployment into
// srv1-production — root mutation — proceeds when it should not. Every red here attacks a fact
// that, if modelled wrong, would let a broker believe it had approval when it had none, or point a
// review at the wrong target:
//   1. an invented review state, which now cannot even be named (§5), so the red attacks the wire
//      boundary that turns a string into a ReviewState;
//   2. the two review endpoints collapsing into one (App review landing in the human queue);
//   3. an invented environment protection-rule type (the model would "see" a custom rule where
//      GitHub reports none, or fail to see the human reviewers that are still standing);
//   4. a 30-day timeout read as a pass;
//   5. a review that names the wrong environment, or forgets the environment — now unwritable;
//   6. an unfiltered webhook action answered with a review;
//   7. the reviewer App granted an axis upstream never asked for.
// Each test below has a MUTATED counterpart that must fail: the same fn, fed the wrong upstream
// fact, returning true. A fn that returns true for everything passes all of these and enforces
// nothing — which is why the negatives are written first here, not last.

import std.types { String, List, Bool, NonEmptyStr }
import std.measure { second, second_count, seconds_per_day, seconds_per_minute, minutes_per_hour }
import extdeps.github.deployment_protection_rule {
  ReviewState,
  Approved,
  Rejected,
  review_state_wire,
  review_state_from_wire,
  DeploymentProtectionRuleReview,
  review_body_field_names,
  review_releases_environment,
  review_matches_capability,
  review_matches_decision,
  HumanDeploymentReview,
  RequiredReviewersKind,
  WaitTimerKind,
  BranchPolicyKind,
  environment_protection_rule_kind_wire,
  environment_protection_rule_kind_from_wire,
  RuleTimeoutOutcome,
  JobFails,
  JobApproved,
  rule_timeout,
  rule_gate_approval_ceiling,
  InstallationAccessToken,
  OAuthClassicWithRepoScope,
  review_credential_is_permitted,
  review_credential_is_documented,
  PendingDeploymentWait,
  broker_may_answer,
  pending_wait_is_over_ceiling,
  pending_deployment_wait_is_answerable_by_app,
  rule_webhook_payload_field_is_published,
  review_call_succeeded,
  the_two_success_statuses_are_not_the_same,
  the_three_calls_are_distinguishable,
  review_permission_is_satisfied,
  environment_protection_types_are_read_from,
  rule_timeout_fails_the_job,
  rule_webhook_published_fields,
  review_documented_example_body,
  review_documented_example_is_complete,
  review_documented_example_releases_a_different_environment,
  review_documented_api_version_header,
  review_api_version_header_is_pinned,
  ReviewApiVersionHeader,
  the_two_review_endpoints_are_distinct,
  rule_webhook_is_an_answerable_request,
  rule_timeout_is_a_refusal,
  rule_app_permission_is_admissible,
  rule_app_permission_set_is_admissible,
  rule_app_permission_set_is_complete,
  review_endpoint_path,
  human_review_endpoint_path,
  pending_deployments_endpoint_path,
  review_endpoint_success_status,
  review_endpoint_body_environment_name_field,
  review_endpoint_body_state_field,
  review_endpoint_body_comment_field,
  review_endpoint_body_alternatives,
  environment_protection_rule_type_values,
  rule_webhook_action,
  rule_webhook_event_name,
  rule_incompatible_job_setting,
  rule_app_permissions,
  rule_app_forbidden_axes,
}
import extdeps.github.app {
  GitHubAppPermission,
  ContentsAxis,
  DeploymentsAxis,
  AdministrationAxis,
  SecurityEventsAxis,
  IdTokenAxis,
  AppAccessRead,
  AppAccessWrite,
}
import gunbc.plan { plans_all_have_retirement, plans_all_titled }
import gunbc.plan_registry { all_plans }

// Two fixed environments, named rather than spelled at each call site: the one the gate protects and
// one that is NOT the gate. Every binding red is "would this review have released the boundary?"
data srv1_env: NonEmptyStr = "srv1-production"
data other_env: NonEmptyStr = "gcp-iam-converge"

// The review the operator actually authorised: srv1-production, approved, with a reason.
fn sanctioned_review() -> DeploymentProtectionRuleReview {
  DeploymentProtectionRuleReview {
    environment_name: srv1_env,
    state: Approved,
    comment: Present { value: "tapped on the phone" },
  }
}

// ---------------------------------------------------------------------------
// 1. The review state: an invented state cannot be named, and cannot be parsed in
// ---------------------------------------------------------------------------

// The two wire strings GitHub's enum accepts, reached through the type rather than through a list.
test fn review_state_admits_exactly_the_documented_pair() -> Bool {
  (review_state_wire(state: Approved) as String) == "approved"
    && (review_state_wire(state: Rejected) as String) == "rejected"
    && review_state_from_wire(name: "approved") == Present { value: Approved }
    && review_state_from_wire(name: "rejected") == Present { value: Rejected }
}

// The discriminating red: an approval that was never tapped must not be expressible. Where the model
// used a List<NonEmptyStr> plus a String->Bool membership predicate, a broker could hand that
// predicate "approved_by_operator" and get a Bool back; now the only way to obtain a ReviewState is
// Approved, Rejected, or a parse that returns nothing for every invented spelling. `true` here means:
// for each invented spelling, there is NO ReviewState to build a request with.
test fn review_state_refuses_every_invented_variant() -> Bool {
  review_state_from_wire(name: "approved_by_operator") == none
    && review_state_from_wire(name: "APPROVED") == none
    && review_state_from_wire(name: "approve") == none
    && review_state_from_wire(name: "auto") == none
    && review_state_from_wire(name: "waiting") == none
    // No empty-string case: NonEmptyStr refuses it at the type, which is itself the guarantee that
    // "no state at all" cannot be smuggled in as a blank.
    && review_state_from_wire(name: "  ") == none
    && review_state_from_wire(name: "approved ") == none
}

// The sum has exactly two constructors and the wire map is injective over them. A third arm would
// mean a third outcome nobody approved.
test fn review_state_wire_is_injective_and_total() -> Bool {
  (review_state_wire(state: Approved) as String) != (review_state_wire(state: Rejected) as String)
    && review_state_from_wire(name: review_state_wire(state: Approved)) == Present { value: Approved }
    && review_state_from_wire(name: review_state_wire(state: Rejected)) == Present { value: Rejected }
}

// ---------------------------------------------------------------------------
// 2. The two review endpoints, and the two bodies, stay distinct
// ---------------------------------------------------------------------------

// POST .../deployment_protection_rule is the App's own-rule endpoint. POST .../pending_deployments
// is the human/team reviewer endpoint. They differ by one path segment, so a typo or a fold that
// reused a constant silently sends an App review to the human queue — where, on srv1-production
// today, the operator is the reviewer. That is the double-authority failure in a different costume.
test fn the_app_and_human_review_endpoints_do_not_collapse() -> Bool {
  the_two_review_endpoints_are_distinct()
    && (review_endpoint_path as String).contains("/deployment_protection_rule")
    && (human_review_endpoint_path as String).contains("pending_deployments")
    && pending_deployments_endpoint_path == human_review_endpoint_path
}

// The two authorities take different body TYPES, so the mix-up is a type error rather than a 422.
// The human body names environments by numeric id and requires a comment; the App's names one by
// name and takes the comment optionally. Neither value converts into the other.
test fn the_two_review_bodies_are_different_types_with_different_fields() -> Bool {
  (review_body_field_names(review: sanctioned_review()) |> count) == 3
    // The names come from the model's own rows, not from string literals repeated here: if the
    // upstream renames the field, the model and this red move together.
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_environment_name_field))
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_state_field))
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_comment_field))
    && !(review_body_field_names(review: sanctioned_review())
         |> any(f => (f as String) == "environment_ids"))
    && (review_endpoint_body_alternatives |> count) == 2
    // The human record's environment field is a LIST OF IDS, not a name — so a reviewer identity
    // cannot be reused as an App identity by smuggling a name into the ids slot.
    && HumanDeploymentReview {
         environment_ids: [22766227517],
         state: Approved,
         comment: "a human typed this",
       }.state
       == Approved
}

// ---------------------------------------------------------------------------
// 3. The environment binding: the discriminating red the implementation PR inherits
// ---------------------------------------------------------------------------

// The environment a review releases is NOT a function of the URL: the path carries owner, repo and
// run_id only. So the only thing that can catch a review aimed at the wrong environment is a check
// on the record — and this red is what the stage-2 broker red must reproduce against a real call.
test fn the_environment_binding_is_a_body_field_not_a_path_segment() -> Bool {
  !(review_endpoint_path as String).contains("environment_name")
    && (review_releases_environment(review: sanctioned_review()) as String) == "srv1-production"
    && review_matches_capability(review: sanctioned_review(), capability_environment: srv1_env)
    // THE mutation: same run, same decision, wrong environment. The gate that opens is not the one
    // the operator tapped.
    && !review_matches_capability(review: sanctioned_review(), capability_environment: other_env)
}

// The decision is checked against the capability the same way, so "tapped reject, sent approve"
// fails the comparison rather than being caught downstream by a GitHub response.
test fn the_decision_is_checked_against_the_capability() -> Bool {
  review_matches_decision(review: sanctioned_review(), capability_state: Approved)
    && !review_matches_decision(review: sanctioned_review(), capability_state: Rejected)
}

// A review with no reason is still a legal request (comment is optional upstream). A model that made
// it required would push a broker to stuff the field with something untrue to satisfy its own check.
test fn a_review_without_a_comment_is_still_sendable() -> Bool {
  (review_body_field_names(review: sanctioned_review()) |> count) == 3
    && (review_body_field_names(review: DeploymentProtectionRuleReview {
         environment_name: srv1_env,
         state: Approved,
         comment: none,
       })
        |> count) == 2
}

// ---------------------------------------------------------------------------
// 4. Protection-rule types: GitHub reports three; a fourth is invented
// ---------------------------------------------------------------------------

test fn environment_protection_types_are_the_three_documented_kinds() -> Bool {
  (environment_protection_rule_type_values |> count) == 3
    && (environment_protection_rule_kind_wire(kind: RequiredReviewersKind) as String) == "required_reviewers"
    && (environment_protection_rule_type_values
        |> any(t => (t as String) == environment_protection_rule_kind_wire(kind: RequiredReviewersKind)))
    && (environment_protection_rule_type_values
        |> any(t => (t as String) == environment_protection_rule_kind_wire(kind: WaitTimerKind)))
    && (environment_protection_rule_type_values
        |> any(t => (t as String) == environment_protection_rule_kind_wire(kind: BranchPolicyKind)))
}

// An invented type value must not parse. "custom_deployment_protection_rules" is the name that would
// make the model SEE a custom rule where GitHub reports none — the read-back that gates activation.
test fn environment_protection_types_refuse_invented_members() -> Bool {
  environment_protection_rule_kind_from_wire(value: "custom_deployment_protection_rules") == none
    && environment_protection_rule_kind_from_wire(value: "required_reviewer") == none
    && environment_protection_rule_kind_from_wire(value: "deployment_protection_rule") == none
    && environment_protection_rule_kind_from_wire(value: "wait-timer") == none
    && environment_protection_rule_kind_from_wire(value: "RequiredReviewersKind") == none
    && environment_protection_rule_kind_from_wire(
         value: environment_protection_rule_kind_wire(kind: RequiredReviewersKind)
       ) == Present { value: RequiredReviewersKind }
}

// ---------------------------------------------------------------------------
// 5. The timeout is a refusal, and is not provable by searching prose
// ---------------------------------------------------------------------------

// A timeout must fail the job. The previous model stored the upstream SENTENCE and asserted
// outcome.contains("fails") && !outcome.contains("approved") — a grep over English, which passes for
// "the job fails over and is approved later". Now the only two readings are typed, and the wrong one
// is a different value, not a different word.
test fn the_rule_timeout_reads_as_a_refusal() -> Bool {
  rule_timeout_is_a_refusal(outcome: JobFails)
    && !rule_timeout_is_a_refusal(outcome: JobApproved)
}

// THE STALL IS A DURATION, NOT A NUMBER WHOSE UNIT LIVES IN ITS NAME. Read as an Int, 30 would
// still print 30 if someone meant 30 hours, and `== 30` could not tell the difference. Here the
// quantity is compared against 30 DAYS BUILT FROM THE SAME CARRIER, so a unit slip — days to hours,
// hours to minutes — changes the value and reddens this. The precedent is
// extdeps.cache.github_actions' gha_actions_cache_idle_release() = second(count: 7 * seconds_per_day()).
test fn the_rule_timeout_is_a_duration_in_days() -> Bool {
  second_count(s: rule_timeout()) == 30 * seconds_per_day()
    // A unit slip is the mutation this red exists to catch: an hour is not a day, and neither is a
    // minute, and neither is the 30-day ceiling expressed in some other unit.
    && second_count(s: rule_timeout()) != 30 * seconds_per_minute() * minutes_per_hour()
    && second_count(s: rule_timeout()) != 30
    && second_count(s: rule_timeout()) != 30 * seconds_per_minute()
    // The ceiling that also governs the gate we are replacing IS the ceiling above — one fact, not
    // two that must be kept in step.
    && second_count(s: rule_gate_approval_ceiling()) == second_count(s: rule_timeout())
}

// The fail-closed arms are all the same shape: nothing was approved. A fold that mapped the timeout
// onto the approved state is refused by the type's own arms, not by a string comparison.
test fn a_timeout_never_produces_an_approval() -> Bool {
  !rule_timeout_is_a_refusal(outcome: JobApproved)
    && rule_timeout_is_a_refusal(outcome: rule_timeout_outcome_reading())
    && second_count(s: rule_timeout()) > 0
}

fn rule_timeout_outcome_reading() -> RuleTimeoutOutcome {
  JobFails
}

// ---------------------------------------------------------------------------
// 6. The webhook is answered only for the action that asks for an answer
// ---------------------------------------------------------------------------

test fn the_rule_webhook_is_answerable_only_when_requested() -> Bool {
  rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "requested")
    && !rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "created")
    && !rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "")
    && !rule_webhook_is_an_answerable_request(event: "deployment", action: "created")
    && !rule_webhook_is_an_answerable_request(event: "workflow_run", action: "requested")
    && (rule_webhook_action as String) == "requested"
    && (rule_webhook_event_name as String) == "deployment_protection_rule"
}

// ---------------------------------------------------------------------------
// 7. The reviewer App holds exactly the axes upstream asked for
// ---------------------------------------------------------------------------

// Two axes, both at the documented level, and no forbidden axis among them. Compared as
// GitHubPermissionAxis values: a description that merely omits the widening cannot satisfy this.
test fn the_gate_app_carries_only_the_rule_axes() -> Bool {
  (rule_app_permissions |> count) == 2
    && rule_app_permission_set_is_complete()
    && rule_app_permission_set_is_admissible()
    && (rule_app_forbidden_axes |> count) == 6
}

// THE discriminating red for the App registration: grant Contents (or IdToken, which would let a
// reviewer identity federate into a cloud role) and admissibility goes false. This is the red a
// widened registration must trip.
test fn a_widened_app_is_refused_by_axis_not_by_prose() -> Bool {
  !rule_app_permission_is_admissible(
    permission: GitHubAppPermission { name: ContentsAxis, access: AppAccessWrite }
  )
    && !rule_app_permission_is_admissible(
         permission: GitHubAppPermission { name: IdTokenAxis, access: AppAccessWrite }
       )
    && !rule_app_permission_is_admissible(
         permission: GitHubAppPermission { name: AdministrationAxis, access: AppAccessRead }
       )
    && rule_app_permission_is_admissible(
         permission: GitHubAppPermission { name: DeploymentsAxis, access: AppAccessWrite }
       )
    && !rule_app_permission_is_admissible(
         permission: GitHubAppPermission { name: SecurityEventsAxis, access: AppAccessRead }
       )
}

// ---------------------------------------------------------------------------
// 8. Success signal, and the job setting that cannot be gated
// ---------------------------------------------------------------------------

// 204 with no body is the ONLY success signal. A fold that treated 200-with-json, or "no exception",
// as success would report an approval it did not receive.
test fn the_review_call_has_exactly_one_success_signal() -> Bool {
  review_endpoint_success_status == 204
}

// A job whose environment is `deployment: false` is incompatible with a custom rule. If this were
// modelled wrong, a job could be gated by a rule GitHub never invokes for it — waiting forever, or
// silently ungated.
test fn an_environmentless_job_setting_stays_incompatible_with_a_rule() -> Bool {
  (rule_incompatible_job_setting as String) == "deployment: false"
}

// ---------------------------------------------------------------------------
// 10. The broker's pre-answer verification: the submission is CONFIRMED, not trusted
// ---------------------------------------------------------------------------

// A wait as the poll reports it for THIS run: the gated environment, a short timer, and the App as
// the reviewer. Built once; every red below mutates one part of it.
data app_installation: NonEmptyStr = "installation-123"

fn waiting_for_the_app() -> PendingDeploymentWait {
  PendingDeploymentWait {
    environment: srv1_env,
    wait_timer: second(count: 60),
    wait_timer_started_at: Present { value: "2026-10-18T00:00:00Z" },
    current_user_can_approve: true,
    reviewers: [app_installation],
  }
}

// THE PRE-ANSWER CHECK, red-first. The environment named by the submission AND by the capability AND
// reported by GitHub must be one environment, and the wait must belong to this App. Each conjunct is
// exercised by a mutation, so the fold cannot be satisfied by "everything is fine" reading.
test fn the_broker_confirms_before_it_answers() -> Bool {
  broker_may_answer(
    wait: waiting_for_the_app(),
    submitted_environment: srv1_env,
    capability_environment: srv1_env,
    app_installation_id: app_installation
  )
    // THE SUBMISSION LIES ABOUT THE ENVIRONMENT: GitHub reports srv1-production waiting, the workflow
    // asked about another environment. Refused — and this is the conjunct that stops a workflow from
    // choosing which environment its own tap unlocks.
    && !broker_may_answer(
         wait: waiting_for_the_app(),
         submitted_environment: other_env,
         capability_environment: srv1_env,
         app_installation_id: app_installation
       )
    // THE CAPABILITY AND THE WAIT DISAGREE. A redeemed capability naming gcp-iam-converge cannot
    // release srv1-production, however the run is parked.
    && !broker_may_answer(
         wait: waiting_for_the_app(),
         submitted_environment: srv1_env,
         capability_environment: other_env,
         app_installation_id: app_installation
       )
    // THE WAIT IS A HUMAN'S. If `reviewers` names someone other than this App, it is a
    // required-reviewer wait, and an App may only review its OWN rule — so answering it is refused
    // even though every environment matches.
    && !broker_may_answer(
         wait: PendingDeploymentWait {
           environment: srv1_env,
           wait_timer: second(count: 60),
           wait_timer_started_at: none,
           current_user_can_approve: true,
           reviewers: ["mtcollins1"],
         },
         submitted_environment: srv1_env,
         capability_environment: srv1_env,
         app_installation_id: app_installation
       )
}

// `current_user_can_approve` is the field a BROKER MUST NOT ACT ON: it is human-facing, and it reads
// true in the operator's own session. A wait that says the user can approve but names no App in
// `reviewers` is unanswerable by the App — this is the conjunct a careless broker would drop.
test fn a_human_facing_approval_field_is_not_the_signal() -> Bool {
  !pending_deployment_wait_is_answerable_by_app(
    wait: PendingDeploymentWait {
      environment: srv1_env,
      wait_timer: second(count: 0),
      wait_timer_started_at: none,
      current_user_can_approve: true,
      reviewers: [],
    },
    app_installation_id: app_installation
  )
    && pending_deployment_wait_is_answerable_by_app(
         wait: waiting_for_the_app(), app_installation_id: app_installation
       )
}

// A wait past the ceiling. The timer is a DURATION on both sides, so this compares 30 days against
// 30 days rather than a bare number against a bare number.
test fn a_wait_past_the_ceiling_is_visible() -> Bool {
  !pending_wait_is_over_ceiling(wait: waiting_for_the_app())
    && pending_wait_is_over_ceiling(
         wait: PendingDeploymentWait {
           environment: srv1_env,
           wait_timer: second(count: 31 * seconds_per_day()),
           wait_timer_started_at: none,
           current_user_can_approve: false,
           reviewers: [app_installation],
         }
       )
    // One second under the ceiling is still under it: the comparison is the ceiling, not a rounding.
    && !pending_wait_is_over_ceiling(
         wait: PendingDeploymentWait {
           environment: srv1_env,
           wait_timer: second(count: 30 * seconds_per_day()),
           wait_timer_started_at: none,
           current_user_can_approve: false,
           reviewers: [app_installation],
         }
       )
}

// ---------------------------------------------------------------------------
// 11. The rejected credential alternative stays rejected, as a value
// ---------------------------------------------------------------------------

// The REST reference ALLOWS an operator's OAuth/PAT with the repo scope; this design does not. The
// rejected alternative is therefore modelled as a value the fold REFUSES — naming it is what keeps it
// out, rather than a paragraph hoping nobody implements the second credential kind.
test fn the_operators_own_token_is_refused_even_though_github_allows_it() -> Bool {
  review_credential_is_permitted(credential: InstallationAccessToken)
    && !review_credential_is_permitted(credential: OAuthClassicWithRepoScope)
    && review_credential_is_documented(token_type: "GitHub App installation access tokens")
    && !review_credential_is_documented(token_type: "personal access token (classic)")
}

// ---------------------------------------------------------------------------
// 12. The callback and the installation id are READ FROM THE PAYLOAD, not chosen
// ---------------------------------------------------------------------------

// The broker posts to the URL GitHub put in `deployment_callback_url`, to the endpoint that field
// addresses. Aimed anywhere else, or read from a field GitHub does not publish, it is refused — which
// is what keeps a review from being posted at a DIFFERENT run's callback.
test fn the_review_is_posted_only_where_the_payload_points() -> Bool {
  rule_review_is_answerable_at(
    payload_field: "deployment_callback_url",
    target_path: review_endpoint_path
  )
    && !rule_review_is_answerable_at(
         payload_field: "run_url",
         target_path: review_endpoint_path
       )
    && !rule_review_is_answerable_at(
         payload_field: "deployment_callback_url",
         target_path: human_review_endpoint_path
       )
    && !rule_review_is_answerable_at(payload_field: "html_url", target_path: review_endpoint_path)
    // The installation identity comes from the payload field, not from a configured constant or a
    // different field.
    && rule_installation_id_is_read_from(payload_field: "installation_id")
    && !rule_installation_id_is_read_from(payload_field: "app_id")
    && !rule_installation_id_is_read_from(payload_field: "sender")
}

// A receiver coded against an undocumented payload field is refused before it reads anything.
test fn an_undocumented_payload_field_is_not_published() -> Bool {
  rule_webhook_payload_field_is_published(name: "deployment_callback_url")
    && rule_webhook_payload_field_is_published(name: "installation_id")
    && !rule_webhook_payload_field_is_published(name: "callback_url")
    && !rule_webhook_payload_field_is_published(name: "installation")
    && (rule_webhook_published_fields |> count) == 8
}

// ---------------------------------------------------------------------------
// 13. Success is one status, on the right call
// ---------------------------------------------------------------------------

// The App's review call answers 204 and nothing else; the poll and the human review answer 200. A
// broker that read "2xx" as success would report an approval from a poll's body. Path, method and
// status are one fact per call, so the three calls cannot be confused by a fold.
test fn success_is_one_status_on_the_right_call() -> Bool {
  review_call_succeeded(status: 204)
    && !review_call_succeeded(status: 200)
    && !review_call_succeeded(status: 201)
    && !review_call_succeeded(status: 422)
    && !review_call_succeeded(status: 302)
    && the_two_success_statuses_are_not_the_same()
    && the_three_calls_are_distinguishable()
}

// ---------------------------------------------------------------------------
// 14. GitHub's own worked example, and the citation table
// ---------------------------------------------------------------------------

// The docs' example review is a complete, three-field request — and it names prod-eus, which is NOT
// this repository's gated environment. Copying the example verbatim into a broker would release
// nothing we care about, so the difference is asserted rather than assumed.
test fn the_documented_example_is_complete_but_not_our_gate() -> Bool {
  review_documented_example_is_complete()
    && review_documented_example_releases_a_different_environment(gated: srv1_env)
    && !review_matches_capability(
         review: review_documented_example_body,
         capability_environment: srv1_env
       )
}

// The pinned API-version header the reference sends, checked as name and value rather than as one
// string matched by eye.
test fn the_api_version_header_is_the_pinned_one() -> Bool {
  review_api_version_header_is_pinned(header: review_documented_api_version_header)
    && !review_api_version_header_is_pinned(
         header: ReviewApiVersionHeader {
           name: "X-GitHub-Api-Version",
           value: "2022-11-28",
         }
       )
    && !review_api_version_header_is_pinned(
         header: ReviewApiVersionHeader { name: "Accept", value: "application/vnd.github+json" }
       )
}

// Every fact above points at a declaration that still exists. A rename that strands a citation
// reddens this instead of quietly leaving a module with five authority rows and no facts covered.
test fn the_citation_table_names_only_live_declarations() -> Bool {
  every_citation_names_a_live_declaration()
}

// The permission the call needs, as one typed row (axis + level). An App without Deployments:write
// cannot answer, and the activation check reads THIS rather than a description of the App.
test fn the_call_needs_deployments_write_and_checks_it() -> Bool {
  review_permission_is_satisfied(
    permissions: [
      GitHubAppPermission { name: DeploymentsAxis, access: AppAccessWrite },
    ]
  )
    // A read-only Deployments grant is not enough for a review, however the App is described.
    && !review_permission_is_satisfied(
         permissions: [GitHubAppPermission { name: DeploymentsAxis, access: AppAccessRead }]
       )
    && !review_permission_is_satisfied(
         permissions: [GitHubAppPermission { name: ContentsAxis, access: AppAccessWrite }]
       )
    && environment_protection_types_are_read_from(key: "type")
    && !environment_protection_types_are_read_from(key: "protection_type")
    && rule_timeout_fails_the_job()
}

// ---------------------------------------------------------------------------
// 9. The plan is in the registry, not loose
// ---------------------------------------------------------------------------

// Without this red a plan can sit in dag/gunbc/plans/ unread by the lens, the doc graph and every
// governance claim over all_plans — which is how a plan becomes prose nobody enforces.
fn plan_slug_is_registered(slug: String) -> Bool {
  fold(all_plans, init: false, f: (acc, p) => acc || p.slug == slug)
}

test fn the_plan_is_registered_in_the_authority_registry() -> Bool {
  plan_slug_is_registered(slug: "ntfy-deployment-gate-approval")
    && (plans_all_have_retirement(plans: all_plans))
    && (plans_all_titled(plans: all_plans))
}
