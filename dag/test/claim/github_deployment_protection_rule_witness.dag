// Two fixed environments, named rather than spelled at each call site: the one the gate protects and
// one that is NOT the gate. Upstream's example uses prod-eus; these two are what makes the field
// ordering and the "one environment, not a path segment" claims checkable.
data srv1_env: NonEmptyStr = "srv1-production"
data other_env: NonEmptyStr = "gcp-iam-converge"

// The review a rule would post: srv1-production, approved, with a reason.
fn sanctioned_review() -> DeploymentProtectionRuleReview {
  DeploymentProtectionRuleReview {
    environment_name: srv1_env,
    state: Approved,
    comment: Present { value: "tapped on the phone" },
  }
}

// A wait as the poll reports it: the gated environment as an OBJECT, a short configured timer, and a
// reviewer list. Built once; each red below mutates one part of it.
fn waiting_wait(reviewers: List<PendingDeploymentReviewer>) -> PendingDeploymentWait {
  PendingDeploymentWait {
    environment: PendingDeploymentEnvironment { id: 160000001, name: srv1_env },
    wait_timer: minute(count: 30),
    wait_timer_started_at: Present { value: "2026-10-18T00:00:00Z" },
    current_user_can_approve: true,
    reviewers: reviewers,
  }
}

// ---------------------------------------------------------------------------
// 1. The review state: an invented state cannot be named, and cannot be parsed in
// ---------------------------------------------------------------------------

// The two wire strings GitHub's enum accepts, reached through the type rather than through a list.
test fn review_state_admits_exactly_the_documented_pair() -> Bool {
  (review_state_wire(state: Approved) as String) == "approved"
    && (review_state_wire(state: Rejected) as String) == "rejected"
    && review_state_from_wire(name: "approved") == Present { value: Approved }
    && review_state_from_wire(name: "rejected") == Present { value: Rejected }
}

// THE DISCRIMINATING RED for an invented state. Where the model had a List<NonEmptyStr> plus a
// String->Bool membership predicate, a caller could hand that predicate "approved_by_operator" and get
// a Bool back. Now the only ways to obtain a ReviewState are Approved, Rejected, or a parse that
// returns nothing for every invented spelling — so `true` here means: for each invented spelling, there
// is NO ReviewState to build a request with.
test fn review_state_refuses_every_invented_variant() -> Bool {
  review_state_from_wire(name: "approved_by_operator") == none
    && review_state_from_wire(name: "APPROVED") == none
    && review_state_from_wire(name: "approve") == none
    && review_state_from_wire(name: "auto") == none
    && review_state_from_wire(name: "waiting") == none
    // No empty-string case: NonEmptyStr refuses it at the type, which is itself the guarantee that
    // "no state at all" cannot be smuggled in as a blank.
    && review_state_from_wire(name: "  ") == none
    && review_state_from_wire(name: "approved ") == none
}

// The sum has exactly two constructors and the wire map is injective over them. A third arm would mean
// a third outcome nobody approved.
test fn review_state_wire_is_injective_and_total() -> Bool {
  (review_state_wire(state: Approved) as String) != (review_state_wire(state: Rejected) as String)
    && review_state_from_wire(name: review_state_wire(state: Approved)) == Present { value: Approved }
    && review_state_from_wire(name: review_state_wire(state: Rejected)) == Present { value: Rejected }
}

// ---------------------------------------------------------------------------
// 2. The request body: the shape that releases a deployment
// ---------------------------------------------------------------------------

// The environment binding is a BODY FIELD, not a path segment. The path is .../actions/runs/{run_id}/
// deployment_protection_rule with NO environment in it, so a review aimed at another environment is
// invisible in the URL and visible only in the body. This is the single highest-consequence fact in the
// module, and it is why the body is a record with a required environment field rather than a bag.
test fn the_environment_binding_is_a_body_field_not_a_path_segment() -> Bool {
  (review_releases_environment(review: sanctioned_review()) as String) == (srv1_env as String)
    && (review_endpoint_path |> contains(review_endpoint_body_environment_name_field as String))
        == false
    && (review_endpoint_path |> contains("runs"))
    && (review_endpoint_body_environment_name_field as String) == "environment_name"
}

// THE CONSTRUCTION GUARANTEE. This is what a record buys over a list of names: there is no value of
// DeploymentProtectionRuleReview that lacks an environment or a state, so the validators that used to
// check for them are gone rather than merely uncalled. The red is the human body, which upstream
// REQUIRES environment_ids and state and comment TOGETHER — a different set, which is why it is a
// different type; a fold that conflated the two would accept a body GitHub rejects, or post a human
// body that releases the deployment while reading as an approval.
test fn a_review_without_an_environment_or_a_state_cannot_be_built() -> Bool {
  (review_body_field_names(review: sanctioned_review()) |> count) == 3
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_environment_name_field))
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_state_field))
    // The two required body alternatives upstream lists: one needing environment_name+state, one
    // needing environment_name+comment. Neither is satisfied by a body with only "comment".
    && (review_endpoint_body_alternatives |> count) == 2
}

// The decision, as the value the body carries — not as a search for the word "state". Both arms are
// constructible, so "the review said the opposite of what was tapped" is a mutation that can be
// exercised rather than described.
test fn the_review_carries_a_decision_and_it_can_be_a_refusal() -> Bool {
  review_decision(review: sanctioned_review()) == Approved
    && review_decision(review: DeploymentProtectionRuleReview {
         environment_name: srv1_env,
         state: Rejected,
         comment: Absent,
       }) == Rejected
}

// A comment is optional upstream (maxLength 65535). A body without one is still sendable, so the model
// must not require it — a model that did would reject GitHub-legal requests.
test fn a_review_without_a_comment_is_still_sendable() -> Bool {
  review_decision(
    review: DeploymentProtectionRuleReview {
      environment_name: srv1_env,
      state: Approved,
      comment: Absent,
    }
  ) == Approved
}

// GitHub's worked example, verbatim from the REST reference. Transcribed as a value of the type, so
// "the example is a complete request" is a computation and not a claim about a comment.
test fn the_documented_example_is_a_value_of_the_type() -> Bool {
  review_documented_example_is_complete()
    && (review_documented_example_body.environment_name as String) == "prod-eus"
    && review_decision(review: review_documented_example_body) == Approved
    && review_documented_example_body.comment != none
}

// ---------------------------------------------------------------------------
// 3. The two review endpoints do not collapse
// ---------------------------------------------------------------------------

// THE CONFLATION RED. GitHub's HUMAN reviewer endpoint (/environments/{environment_name}/
// deployments/{deployment_id}/statuses/{status_id}) takes environment_ids, state, comment and answers
// 200. The App rule endpoint takes environment_name, state, comment and answers 204. Both are "review a
// deployment", and a wrong model would merge them into one call. Merged, the wrong one silently does
// the wrong thing: the human endpoint cannot be called by an App, and a 200 read as an accepted rule
// review reports an approval that was never given.
test fn the_app_and_human_review_endpoints_do_not_collapse() -> Bool {
  the_two_review_endpoints_are_distinct()
    && review_endpoint_method == POST
    && human_review_endpoint_method == POST
    && (review_endpoint_path as String) != (human_review_endpoint_path as String)
    && (human_review_endpoint_path |> contains("statuses"))
    && (review_endpoint_path |> contains("deployment_protection_rule"))
    && (pending_deployments_endpoint_path |> contains("pending_deployments"))
}

// THE TWO BODIES ARE DIFFERENT TYPES WITH DIFFERENT FIELDS, not one optional-field bag. The App's body
// names ONE environment by name; the human body takes a LIST of environment ids. A single record with
// all five fields optional would accept a request that has environment_name and environment_ids and no
// comment, which GitHub rejects — and it would let the human body's "no decision in the path" property
// leak into the rule body, where it is a lie.
test fn the_two_review_bodies_are_different_types_with_different_fields() -> Bool {
  review_body_is_complete(review: sanctioned_review())
    && (review_documented_example_body.comment != none)
    && (review_body_field_names(review: sanctioned_review())
        |> any(f => f == review_endpoint_body_environment_name_field))
    // The human body's field names, spelled as upstream spells them, are NOT the rule body's.
    && (review_endpoint_body_environment_name_field as String) == "environment_name"
    && (review_endpoint_body_state_field as String) == "state"
    && (review_endpoint_body_comment_field as String) == "comment"
    && pending_deployments_endpoint_method == GET
}

// ---------------------------------------------------------------------------
// 4. What the pending_deployments read can and cannot say
// ---------------------------------------------------------------------------

// THE FACT THAT CLOSED A GUARD. The pinned blob gives pending-deployment.environment as an OBJECT
// ({id, node_id, name, url, html_url}) and each reviewer as a structured object whose `type` is
// exactly User | Team. So the projection is an object here and a closed sum there, and an App is
// NOT REPRESENTABLE among the reviewers. Before this was read, this model carried
// reviewers: List<NonEmptyStr> and asked whether an installation id appeared in it — a question that
// can only ever be answered "no", which is how a guard ends up permanently closed while looking active.
test fn reviewers_are_users_or_teams_and_never_an_app() -> Bool {
  (pending_deployment_reviewer_type_wire(reviewer: UserReviewer { login: "mtcollins1" }) as String)
    == "User"
    && (pending_deployment_reviewer_type_wire(
         reviewer: TeamReviewer { name: "infra-approvers" }
       ) as String) == "Team"
    && pending_wait_carries_a_human_reviewer(
         wait: waiting_wait(
           reviewers: [UserReviewer { login: "mtcollins1" }] as List<PendingDeploymentReviewer>
         )
       )
    && pending_wait_carries_a_human_reviewer(
         wait: waiting_wait(
           reviewers: [TeamReviewer { name: "infra-approvers" }] as List<PendingDeploymentReviewer>
         )
       )
    // The empty list is the shape a custom-rule wait has: nobody is listed, because the gate is a
    // rule, not a person. It is NOT "the App is listed".
    && !pending_wait_carries_a_human_reviewer(wait: waiting_wait(
         reviewers: [] as List<PendingDeploymentReviewer>
       ))
}

// The environment name is reached THROUGH the object. The discriminating part is the field census: the
// projection has exactly the five fields upstream marks required, so a consumer cannot ask for an
// `app` or an `installation_id` and get one.
test fn the_wait_names_its_environment_through_the_object() -> Bool {
  pending_wait_environment_name(wait: waiting_wait(
    reviewers: [] as List<PendingDeploymentReviewer>
  )) == srv1_env
    && (pending_deployment_wait_field_names |> count) == 5
    && (pending_deployment_wait_field_names
        |> any(f => f == pending_deployments_field_environment))
    && (pending_deployment_wait_field_names
        |> any(f => f == "current_user_can_approve"))
    && !(pending_deployment_wait_field_names |> any(f => f == "app"))
    && !(pending_deployment_wait_field_names |> any(f => f == "installation_id"))
}

// WHO MAY ANSWER is a separate read, not a field of the wait. Ownership comes from the environment's
// enabled-rule readback matched against this installation, and "we did not check" is a value.
test fn ownership_is_a_separate_fact_with_two_arms() -> Bool {
  rule_ownership_is_established(
    ownership: OwnedByGateApp {
      rule_id: 900000001,
      installation_id: 1900000001,
      environment_name: srv1_env,
    }
  )
    && !rule_ownership_is_established(
         ownership: NotOwnedByGateApp { because: "the readback never ran" }
       )
    && (available_rule_readback_path_mentions("deployment_protection_rules/apps"))
    && available_rule_readback_is_a_get()
}

fn available_rule_readback_path_mentions(fragment: NonEmptyStr) -> Bool {
  extdeps.github.deployment_protection_rule.available_rule_readback_endpoint_path
    |> contains(fragment as String)
}

fn available_rule_readback_is_a_get() -> Bool {
  extdeps.github.deployment_protection_rule.available_rule_readback_endpoint_method == GET
}

// ---------------------------------------------------------------------------
// 5. The wait timer is a configured duration in MINUTES, and not an age
// ---------------------------------------------------------------------------

// THE UNIT RED. GitHub's environments REST reference counts wait_timer in MINUTES ("The time (in
// minutes) must be an integer between 0 and 43,200 (30 days)"), and the pinned blob carries the field
// with example 30. Read as SECONDS the documented maximum is twelve hours, so a ceiling check written
// against a seconds reading waves through a job that has waited a month. The two clauses below differ
// only in unit: the first is what minutes gives, the second is what seconds would have given.
test fn the_wait_timer_is_minutes_and_not_seconds() -> Bool {
  let wait = waiting_wait(reviewers: [] as List<PendingDeploymentReviewer>)
  minute_count(m: wait.wait_timer) == 30
    && second_count(s: extdeps.github.deployment_protection_rule.wait_timer_as_seconds(wait: wait))
        == 1800
    // The documented ceiling, at both scales. 43,200 MINUTES is 30 days; 43,200 SECONDS is twelve
    // hours. Only one of these is the truth, and this test fails if the field is ever re-typed to
    // carry seconds.
    && second_count(s: extdeps.github.deployment_protection_rule.wait_minutes_as_seconds(
         minutes: minute(count: 43200)
       )) == 30 * seconds_per_day()
    && second_count(s: extdeps.github.deployment_protection_rule.wait_minutes_as_seconds(
         minutes: minute(count: 43200)
       )) != 43200
}

// The documented range, checked rather than described: 0 and 43,200 are the boundaries upstream gives,
// and one past either is not in range.
test fn the_configured_timer_cannot_exceed_the_documented_range() -> Bool {
  extdeps.github.deployment_protection_rule.wait_timer_is_in_documented_range(minutes: 0 as Nat)
    && extdeps.github.deployment_protection_rule.wait_timer_is_in_documented_range(
         minutes: 43200 as Nat
       )
    && !extdeps.github.deployment_protection_rule.wait_timer_is_in_documented_range(
         minutes: 43201 as Nat
       )
}

// ---------------------------------------------------------------------------
// 6. Environment protection types and the incompatible job setting
// ---------------------------------------------------------------------------

// The three environment protection types, from the upstream reference, not invented. A fourth value
// here means someone added a protection kind GitHub does not implement — which would let us assert a
// gate that does not exist.
test fn environment_protection_types_are_the_three_documented_kinds() -> Bool {
  (environment_protection_rule_type_values |> count) == 3
    && (environment_protection_rule_type_values |> any(v => v == "required_reviewers"))
    && (environment_protection_rule_type_values |> any(v => v == "wait_timer"))
    && (environment_protection_rule_type_values |> any(v => v == "branch_policy"))
}

// The sum is derived, not a second list: the census of arms and the census of values are the same
// number, and an invented member cannot be parsed in. That is the difference between a list someone
// can extend and a type someone cannot.
test fn environment_protection_types_refuse_invented_members() -> Bool {
  (environment_protection_rule_type_values |> count) == 3
    && environment_protection_rule_kind_from_wire(name: "custom_rules") == none
    && environment_protection_rule_kind_from_wire(name: "required_reviewers")
        == Present { value: RequiredReviewersKind }
    && environment_protection_rule_kind_wire(kind: WaitTimerKind) == "wait_timer"
    && environment_protection_rule_kind_wire(kind: BranchPolicyKind) == "branch_policy"
    && environment_protection_types_are_read_from(
         field: extdeps.github.deployment_protection_rule.environment_protection_type_field
       )
}

// A job whose environment is `deployment: false` is incompatible with a custom rule. Modelled wrong, a
// job could be gated by a rule GitHub never invokes for it — waiting forever, or silently ungated.
test fn an_environmentless_job_setting_stays_incompatible_with_a_rule() -> Bool {
  (rule_incompatible_job_setting as String) == "deployment: false"
}

// ---------------------------------------------------------------------------
// 7. The timeout: one ceiling from one authority, one outcome that is not an approval
// ---------------------------------------------------------------------------

// THE DIRECTION THE GATE DEPENDS ON. The custom-rule page states one consequence, and it is not a
// choice: the job FAILS. Modelled the other way — an outcome that could read as an approval — the
// broker would see success where nothing was approved. There is no private "JobApproved" arm here to
// reject: the consequence is typed in GitHub's own run-conclusion vocabulary, so the only values it can
// take are GitHub's, and the one it takes is the failing one.
test fn a_rule_timeout_concludes_the_run_as_a_failure() -> Bool {
  extdeps.github.deployment_protection_rule.custom_rule_timeout_run_conclusion == RunFailure
    && extdeps.github.deployment_protection_rule.custom_rule_timeout_run_conclusion != RunSuccess
}

// THE CEILING AS A DURATION, not an Int whose unit lives in its name. 30 days, counted in seconds, and
// the same magnitude from the two independent upstream statements — the limits reference for the
// general gate-approval ceiling, the custom-rule page for this feature's wait. A divergence between the
// two citations would show up here.
test fn the_gate_wait_is_thirty_days_from_both_authorities() -> Bool {
  second_count(s: rule_gate_approval_ceiling()) == 30 * seconds_per_day()
    && second_count(s: custom_rule_response_timeout()) == second_count(s: rule_gate_approval_ceiling())
    && second_count(s: custom_rule_response_timeout()) == 2592000
}

// ---------------------------------------------------------------------------
// 8. The webhook payload, as the fallback route's fact — with the invented fields refused
// ---------------------------------------------------------------------------

// THE NEGATIVE RED. Plain sense gives this payload a run_id, a run_url, an app_id and a top-level
// installation_id, and an implementation reaches for exactly those names. NONE OF THEM EXIST, and this
// module previously asserted they did. Each is refused on its own, so a regression that adds one back
// to the published set is caught by that row rather than by a reader.
test fn an_invented_payload_field_is_never_published() -> Bool {
  (rule_webhook_absent_fields |> count) == 4
    && !rule_webhook_payload_field_is_published(name: "run_id")
    && !rule_webhook_payload_field_is_published(name: "run_url")
    && !rule_webhook_payload_field_is_published(name: "app_id")
    && !rule_webhook_payload_field_is_published(name: "installation_id")
}

// The fields upstream does carry, including the ones this route does NOT consume. The claim is
// deliberately weaker than the record: this file asserts these exist, and asserts nothing about the
// rest of the payload's shape (deployment, pull_requests, repository, organization, sender are
// deliberately untyped because nobody reads them).
test fn the_documented_payload_fields_are_published() -> Bool {
  (rule_webhook_documented_field_names |> count) == 12
    && rule_webhook_payload_field_is_published(name: "environment")
    && rule_webhook_payload_field_is_published(name: "deployment_callback_url")
    && rule_webhook_payload_field_is_published(name: "installation")
    && rule_webhook_payload_field_is_published(name: "sender")
    && (rule_webhook_consumed_fields |> count) == 3
}

// The trigger that makes a rule answerable at all, from the webhook page. Without this event name the
// App never sees the request, and a broker that never receives it looks identical to one that is down.
test fn the_rule_webhook_is_answerable_only_when_requested() -> Bool {
  rule_webhook_is_an_answerable_request(
    action: rule_webhook_action,
    event: rule_webhook_event_name
  )
    && !rule_webhook_is_an_answerable_request(action: "completed", event: "deployment_protection_rule")
    && !rule_webhook_is_an_answerable_request(action: "requested", event: "deployment")
}

// THE TOKEN IDENTITY IS READ FROM THE PAYLOAD'S installation OBJECT — not a top-level key, and not a
// configured constant. Both halves of the path are named values, so renaming either reddens the fold.
test fn the_token_identity_is_read_from_the_payload_object() -> Bool {
  rule_installation_id_is_read_from(payload_field: rule_webhook_field_installation)
    && !rule_installation_id_is_read_from(payload_field: "installation_id")
    && (rule_installation_id_nested_field as String) == "id"
    && (rule_webhook_field_installation as String) == "installation"
}

// THE CALLBACK PAIR IS CHECKABLE. On the webhook route a review posted where the payload points cannot
// aim itself at a different run; on the selected route there is no payload and the URL is built from a
// verified run id. The mutation: a callback naming some other path is refused.
test fn the_review_is_posted_only_where_the_payload_points() -> Bool {
  rule_review_callback.payload_field == rule_webhook_field_deployment_callback_url
    && rule_review_callback.addresses == review_endpoint_path
    && rule_webhook_payload_field_is_published(name: rule_review_callback.payload_field)
}

// THE SELECTED ROUTE ADDS NO INBOUND EXPOSURE, and the bet that makes it work is typed as an open
// standing rather than asserted as a fact. The broker is tailnet-only, so a public GitHub webhook would
// be a new exposure; the route therefore reads nothing from a delivery, and the inference that GitHub
// accepts a review for a run whose delivery was never received is carried with its read obligation.
test fn the_selected_route_is_the_no_webhook_one_and_the_bet_is_still_open() -> Bool {
  rule_webhook_route_adds_no_inbound(route: rule_webhook_selected_route)
    && !rule_webhook_route_adds_no_inbound(route: "public-webhook")
    && rule_delivery_is_unproven(standing: rule_delivery_independence)
}

// ---------------------------------------------------------------------------
// 9. Credentials, permissions, and the calls
// ---------------------------------------------------------------------------

// Upstream ACCEPTS both credential kinds at this endpoint, and this model says so. What gunbc permits is
// a separate decision, witnessed in gunbc.auth.deployment_gate_authorization; an upstream model that
// quietly omitted the operator-token arm would be stating something false about GitHub.
test fn both_documented_credential_kinds_are_representable() -> Bool {
  review_credential_is_documented(token_type: review_accepted_token_type)
    && review_credential_is_documented(token_type: "OAuth app tokens and personal access tokens")
    && (review_oauth_classic_scope as String) == "repo"
    && (review_credential_is_documented(token_type: "a token kind GitHub has never heard of") == false)
}

// The permission the endpoint requires, in the upstream's own words: "Deployments" repository
// permissions (write), and installation access tokens only. The discriminating half is the ACCESS
// LEVEL — a model that recorded Deployments at read would still satisfy a name-only check.
test fn the_call_needs_deployments_write_and_checks_it() -> Bool {
  review_permission_is_satisfied(permission: review_required_permission)
    && review_required_permission.name == DeploymentsAxis
    && review_required_permission.access == AppAccessWrite
    && !review_permission_is_satisfied(
         permission: GitHubAppPermission { name: DeploymentsAxis, access: AppAccessRead }
       )
    && !review_permission_is_satisfied(
         permission: GitHubAppPermission { name: ActionsAxis, access: AppAccessRead }
       )
}

// The documented App permission set, as an upstream fact: Actions read-only AND Deployments read+write,
// which is two rows and no more. (That the App is REFUSED anything else is gunbc policy, and is
// witnessed where that policy lives.)
test fn the_documented_permission_set_is_exactly_two_rows() -> Bool {
  (rule_app_permissions |> count) == 2
    && (rule_app_permissions |> any(p => p.name == ActionsAxis && p.access == AppAccessRead))
    && (rule_app_permissions
        |> any(p => p.name == DeploymentsAxis && p.access == AppAccessWrite))
}

// THE SUCCESS SIGNAL, and the three calls that must not be confused. 204 with no body is the only
// success the rule review can produce; the poll and the human endpoint answer 200. The three
// RestCall values are distinguishable by path AND by status, so a caller cannot select one by asking
// "was it a 2xx".
test fn success_is_one_status_on_the_right_call() -> Bool {
  review_call.success_status == 204 as HttpStatus
    && human_review_call.success_status == 200 as HttpStatus
    && the_two_success_statuses_are_not_the_same()
    && the_three_calls_are_distinguishable()
    && review_call_succeeded(status: review_call.success_status)
    && !review_call_succeeded(status: human_review_call.success_status)
    && !review_call_succeeded(status: pending_deployments_poll_call.success_status)
    && review_call.method == POST
    && pending_deployments_poll_call.method == GET
    && (review_call.path |> contains("deployment_protection_rule"))
    && (pending_deployments_poll_call.path |> contains("pending_deployments"))
}

// The version header the reference sends, as a typed value rather than a name. The mutation is a
// plausible-looking header that is not the pinned one.
test fn the_api_version_header_is_the_pinned_one() -> Bool {
  review_api_version_header_is_pinned(header: review_documented_api_version_header)
    && !review_api_version_header_is_pinned(
         header: ReviewApiVersionHeader { name: "x-github-api-version", value: "2022-11-28" }
       )
    && !review_api_version_header_is_pinned(
         header: ReviewApiVersionHeader { name: "accept", value: "application/vnd.github+json" }
       )
}

// ---------------------------------------------------------------------------
// 10. Citations, the pinned spec, and the scope rows
// ---------------------------------------------------------------------------

// THE CITATION CENSUS. Every fact the module claims from upstream is paired with an authority, and the
// live-name census is what catches a citation orphaned by a rename. Counting equal is not enough on its
// own, which is why the fold also requires every cited decl_name to be in the census and every citation
// to point at THIS module — a citation aimed at a sibling module's name would otherwise keep the table
// looking complete while covering nothing.
test fn the_citation_table_names_only_live_declarations() -> Bool {
  every_citation_names_a_live_declaration()
    && deployment_protection_rule_citation_count() == 12
    && (deployment_protection_rule_fact_citations |> count) == (
         deployment_protection_rule_live_fact_names |> count
       )
}

// THE SPEC IS READ AT A COMMIT, NOT A BRANCH. blob/main moves under the model, and every "the schema
// requires ..." claim in this file is about one revision. The red is the branch locator: an authority
// that points at main is not a pinned authority, however well the rest of the row reads.
test fn the_openapi_is_pinned_to_a_commit_and_not_to_a_branch() -> Bool {
  spec_is_pinned_to_a_commit(commit: spec_pinned_commit)
    && !spec_is_pinned_to_a_commit(commit: "main")
    && !spec_is_pinned_to_a_commit(commit: "blob/main")
    && (spec_authority.uri.locator |> contains(spec_pinned_commit as String))
    && (spec_authority.uri.locator |> contains("blob/"))
    && !(spec_authority.uri.locator |> contains("/main/"))
    && (spec_pinned_path |> contains("api.github.com.json"))
}

// Every authority this module cites is one it publishes, and every one is an https URI. A fact cited to
// an authority that is not in the anchor is a fact nobody is accountable for.
test fn every_cited_authority_is_published_by_this_module() -> Bool {
  (extdeps_external_authority_anchor |> count) == 8
    && (rule_authority.uri.scheme == Https)
    && (rest_authority.uri.locator |> contains("rest/api/actions"))
    && (webhook_authority.uri.locator |> contains("webhooks-and-events/webhooks"))
    && (environment_authority.uri.locator |> contains("rest/api/deployments"))
    && (limits_authority.uri.locator |> contains("limits"))
    && (enablement_authority.uri.locator
        |> contains("configure-custom-protection-rules"))
}

// The scope rows, and the rule that extdeps models no product surface. This is the boundary the module
// has to keep to be in extdeps at all.
test fn the_model_scope_cites_the_published_authorities() -> Bool {
  (external_model_scope_citations(scope: extdeps_model_scope) |> count) == 8
    && extdeps_model_scope.first_citation == extdeps_external_authority_anchor
    && (external_model_scope_citations(scope: extdeps_model_scope)
        |> any(a => a.uri.locator == limits_authority.uri.locator))
    && (external_model_scope_citations(scope: extdeps_model_scope)
        |> any(a => a.uri.locator == spec_authority.uri.locator))
}

// ---------------------------------------------------------------------------
// 11. The plan is registered, because a plan that is not findable is a plan that was not written
// ---------------------------------------------------------------------------

// The plan carrier this model implements has to be reachable through the registry authority. This fails
// if it is unregistered, if its name changes, or if it is registered twice.
test fn the_plan_is_registered_in_the_authority_registry() -> Bool {
  (all_plans |> all(p => p.plan.name != "ntfy-deployment-gate-approval")) == false
    && (all_plans |> filter(p => p.plan.name == "ntfy-deployment-gate-approval") |> count) == 1
    && ((all_plans |> filter(p => p.plan.name == "ntfy-deployment-gate-approval")
         |> first
         |> map(p => p.plan.owner)
         |> or_else("nobody")) as String) == "fleet-converge"
}
