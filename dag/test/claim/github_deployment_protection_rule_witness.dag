module test.claim.github_deployment_protection_rule_witness

// Witness for extdeps.github.deployment_protection_rule — the upstream interface a GitHub App uses
// to answer a custom deployment protection rule, which is the mechanism proposed to replace the
// operator's GitHub "Review deployments" click with the existing ntfy tap (plan:
// gunbc.plans.ntfy_deployment_gate_approval).
//
// WHY THESE REDS AND NOT MORE. The feature's one catastrophic failure is that a deployment into
// srv1-production — root mutation — proceeds when it should not. Every red here attacks a fact
// that, if modelled wrong, would let a broker believe it had approval when it had none, or point a
// review at the wrong target:
//   1. an invented review state read as approval;
//   2. the two review endpoints collapsing into one (App review landing in the human queue);
//   3. an invented environment protection-rule type (the model would "see" a custom rule where
//      GitHub reports none, or fail to see the human reviewers that are still standing);
//   4. a 30-day timeout read as a pass;
//   5. an incomplete review body read as sendable (GitHub rejects it, and a broker that treats the
//      rejection as harmless leaves the gate shut but reports success);
//   6. an unfiltered webhook action answered with a review.
// Each test below has a MUTATED counterpart that must fail: the same fn, fed the wrong upstream
// fact, returning true. A fn that returns true for everything passes all of these and enforces
// nothing — which is why the negatives are written first here, not last.

import std.types { String, List, Bool }
import extdeps.github.deployment_protection_rule {
  review_state_is_accepted,
  review_body_is_complete,
  review_body_carries_a_decision,
  review_body_binds_an_environment,
  human_review_body_is_complete,
  review_endpoint_body_environment_name_field,
  review_endpoint_body_optional_fields,
  review_endpoint_body_alternatives,
  the_two_review_endpoints_are_distinct,
  environment_protection_type_is_known,
  rule_webhook_is_an_answerable_request,
  rule_timeout_is_a_refusal,
  review_endpoint_path,
  human_review_endpoint_path,
  pending_deployments_endpoint_path,
  review_endpoint_success_status,
  review_accepted_states,
  review_endpoint_body_required_fields,
  human_review_body_required_fields,
  environment_protection_rule_type_values,
  rule_webhook_action,
  rule_timeout_days,
  rule_incompatible_job_setting,
}
import gunbc.plan { plans_all_have_retirement, plans_all_titled }
import gunbc.plan_registry { all_plans }

// ---------------------------------------------------------------------------
// 1. The review state enum: an invented state must never read as accepted
// ---------------------------------------------------------------------------

test fn review_state_admits_exactly_the_documented_pair() -> Bool {
  review_state_is_accepted(state: "approved")
    && review_state_is_accepted(state: "rejected")
}

// The discriminating red: an approval that was never tapped must not be expressible. A model that
// admitted `approved_by_operator` would let a broker synthesize a decision the human did not make.
test fn review_state_refuses_every_invented_variant() -> Bool {
  !review_state_is_accepted(state: "approved_by_operator")
    && !review_state_is_accepted(state: "APPROVED")
    && !review_state_is_accepted(state: "approve")
    && !review_state_is_accepted(state: "")
    && !review_state_is_accepted(state: "waiting")
}

test fn review_state_enum_has_no_third_member() -> Bool {
  (review_accepted_states |> count) == 2
}

// ---------------------------------------------------------------------------
// 2. The two review endpoints stay distinct
// ---------------------------------------------------------------------------

// POST .../deployment_protection_rule is the App's own-rule endpoint. POST .../pending_deployments
// is the human/team reviewer endpoint. They differ by one path segment, so a typo or a fold that
// reused a constant silently sends an App review to the human queue — where, on srv1-production
// today, the operator is the reviewer. That is the double-authority failure in a different costume.
test fn the_app_and_human_review_endpoints_do_not_collapse() -> Bool {
  the_two_review_endpoints_are_distinct()
    && (review_endpoint_path as String) != (human_review_endpoint_path as String)
    && (review_endpoint_path as String).ends_with("/deployment_protection_rule")
    && (human_review_endpoint_path as String).ends_with("/pending_deployments")
}

// The body shapes differ, so the mix-up is detectable at request-build time and must be refused
// there rather than discovered in a GitHub 422.
test fn the_human_endpoint_refuses_the_app_body_shape() -> Bool {
  human_review_body_is_complete(fields: ["environment_ids", "state", "comment"])
    // The App's decision body is missing environment_ids: handing it to the human endpoint is a
    // call that will not be accepted, and the mix-up must be caught here rather than in a 422.
    && !human_review_body_is_complete(fields: ["environment_name", "state"])
    && !human_review_body_is_complete(fields: ["environment_name", "state", "comment"])
}

// The discriminating red, written against the upstream pair rather than against the row: dropping
// EITHER required field must fail. If the model row ever lost environment_name — the field that
// binds a review to an environment, and the one absent from the URL — the second clause goes red.
test fn the_app_endpoint_refuses_an_incomplete_body() -> Bool {
  review_body_is_complete(fields: ["environment_name", "state"])
    && !review_body_is_complete(fields: ["state"])
    && !review_body_is_complete(fields: ["environment_name"])
    && !review_body_is_complete(fields: ["environment_name", "comment"])
    && !review_body_is_complete(fields: ["state", "comment"])
    && !review_body_is_complete(fields: [])
}

// comment is optional in the decision-bearing alternative, so a body WITHOUT it is still sendable.
// A model that made comment required would refuse honest approvals and push a broker to stuff the
// comment field with something untrue just to satisfy its own check.
test fn the_app_endpoint_accepts_a_review_without_a_comment() -> Bool {
  review_body_is_complete(fields: ["environment_name", "state"])
    && (review_endpoint_body_optional_fields |> count) == 1
    && (review_endpoint_body_optional_fields |> any(f => (f as String) == "comment"))
    && (review_endpoint_body_required_fields |> count) == 2
}

// The poll endpoint is neither of them: it is a GET that reports what is waiting and carries no
// authority to change it.
test fn the_pending_poll_is_not_a_review_endpoint() -> Bool {
  (pending_deployments_endpoint_path as String) != (review_endpoint_path as String)
    && (pending_deployments_endpoint_path as String).ends_with("/pending_deployments")
}

// ---------------------------------------------------------------------------
// 3. The environment projection's type enum has exactly three built-in kinds
// ---------------------------------------------------------------------------

test fn environment_protection_types_are_the_three_documented_kinds() -> Bool {
  environment_protection_type_is_known(value: "required_reviewers")
    && environment_protection_type_is_known(value: "wait_timer")
    && environment_protection_type_is_known(value: "branch_policy")
    && (environment_protection_rule_type_values |> count) == 3
}

// The discriminating red: an enabled custom App rule is NOT a fourth `protection_rules[].type`
// value. A model that invented `custom_deployment_protection_rules` here would let a check read
// "the App rule is on this environment" from the environment projection — and read it falsely,
// because the projection would then contain a value GitHub never sends. Conversely, dropping
// `required_reviewers` from the enum would make a still-standing human gate read as absent, which
// is precisely the state in which removing the operator's reviewer would go unnoticed.
test fn environment_protection_types_refuse_invented_members() -> Bool {
  !environment_protection_type_is_known(value: "custom_deployment_protection_rules")
    && !environment_protection_type_is_known(value: "deployment_protection_rule")
    && !environment_protection_type_is_known(value: "protection_rule")
    && !environment_protection_type_is_known(value: "app")
}

// ---------------------------------------------------------------------------
// 4. The timeout is a refusal, never a pass
// ---------------------------------------------------------------------------

test fn the_rule_timeout_reads_as_a_refusal() -> Bool {
  rule_timeout_is_a_refusal(
    outcome: "it will wait for up to 30 days for a webhook event response before it times out and the workflow job fails",
  )
    && rule_timeout_days == 30
}

// The discriminating red: a fold that turned the timeout into an approval — "nothing objected, so
// proceed" — is the exact fail-open this feature must not introduce.
test fn the_rule_timeout_refuses_an_approval_shaped_reading() -> Bool {
  !rule_timeout_is_a_refusal(outcome: "the wait timer elapsed and the deployment was approved")
    && !rule_timeout_is_a_refusal(outcome: "no reviewer responded, proceeding")
    && !rule_timeout_is_a_refusal(outcome: "the workflow job succeeded")
}

// ---------------------------------------------------------------------------
// 5. The webhook is answerable only on its one published activity
// ---------------------------------------------------------------------------

test fn the_rule_webhook_is_answerable_only_when_requested() -> Bool {
  rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "requested")
    && (rule_webhook_action as String) == "requested"
}

// The discriminating red: a receiver that ignored the action would post a review in response to any
// future activity type on the same event — including one whose semantics are the opposite of a
// request.
test fn the_rule_webhook_refuses_unpublished_or_foreign_activities() -> Bool {
  !rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "completed")
    && !rule_webhook_is_an_answerable_request(event: "deployment_protection_rule", action: "")
    && !rule_webhook_is_an_answerable_request(event: "deployment", action: "created")
    && !rule_webhook_is_an_answerable_request(event: "workflow_run", action: "requested")
}

// ---------------------------------------------------------------------------
// 6. The upstream facts the broker's own logic is written against
// ---------------------------------------------------------------------------

// 204 is the ONLY success signal GitHub gives for the review call, so the broker's witness must be
// the response code. A model that allowed a different success status would let a broker call
// "success" on a 301 or a 200-with-body and consider the gate answered.
test fn the_review_call_has_exactly_one_success_signal() -> Bool {
  review_endpoint_success_status == 204
}

// The human body takes `environment_ids`; the App body does not. If the two required-field lists
// ever became equal, the endpoint-distinctness red above would stop discriminating.
test fn the_two_review_bodies_do_not_share_a_shape() -> Bool {
  (human_review_body_required_fields |> count) == 3
    && (review_endpoint_body_required_fields |> count) == 2
    // `environment_ids` (a numeric id list) belongs to the human endpoint's body ONLY, and
    // `environment_name` (a name, in the App's body) ONLY to the App's. If a fold ever put either
    // in the other list, the endpoint-distinctness red above would stop discriminating, so both
    // memberships are asserted directly.
    && (human_review_body_required_fields |> any(r => (r as String) == "environment_ids"))
    && !(review_endpoint_body_required_fields |> any(r => (r as String) == "environment_ids"))
    && (review_endpoint_body_required_fields |> any(r => (r as String) == "environment_name"))
    && !(human_review_body_required_fields |> any(r => (r as String) == "environment_name"))
    && (review_endpoint_body_required_fields |> any(r => (r as String) == "state"))
    // comment is NOT required in the decision-bearing alternative, so it must not appear here.
    && !(review_endpoint_body_required_fields |> any(r => (r as String) == "comment"))
}

// The binding that the discriminating implementation red will attack. The environment released by a
// review is carried in the BODY as environment_name; the path carries only owner, repo and run_id.
// So a review aimed at the wrong environment is invisible to anything that validates the URL, and
// only a check on the body can catch it. If these three fns ever stop distinguishing the three
// bodies, the implementation red (wrong run id / wrong environment must not approve) has no teeth.
test fn the_environment_binding_is_a_body_field_not_a_path_segment() -> Bool {
  review_body_binds_an_environment(fields: ["environment_name", "state"])
    && !review_body_binds_an_environment(fields: ["state", "comment"])
    && !review_body_binds_an_environment(fields: [])
    && review_body_carries_a_decision(fields: ["environment_name", "state"])
    // the comment-only alternative is schema-legal and asserts NO decision
    && !review_body_carries_a_decision(fields: ["environment_name", "comment"])
    && (review_endpoint_path as String).contains("environment_name") == false
    && (review_endpoint_body_alternatives |> count) == 2
}

// A job whose environment is `deployment: false` is incompatible with a custom rule. If this were
// modelled wrong, a job could be gated by a rule that GitHub will never invoke for it — waiting
// forever, or silently ungated.
test fn an_environmentless_job_setting_stays_incompatible_with_a_rule() -> Bool {
  (rule_incompatible_job_setting as String) == "deployment: false"
    && (rule_incompatible_job_setting as String).contains("deployment")
}

// The plan carrier is registered in the authority registry, not left as a loose file. Without this
// red a plan can sit in dag/gunbc/plans/ unread by the lens, the doc graph and every governance
// claim over all_plans — which is exactly how a plan becomes prose nobody enforces.
fn plan_slug_is_registered(slug: String) -> Bool {
  fold(all_plans, init: false, f: (acc, p) => acc || p.slug == slug)
}

test fn the_plan_is_registered_in_the_authority_registry() -> Bool {
  plan_slug_is_registered(slug: "ntfy-deployment-gate-approval")
    && (plans_all_have_retirement(plans: all_plans))
    && (plans_all_titled(plans: all_plans))
}
