module test.claim.cursor_sdk_dispatch_bridge_witness_test

import std.types { Bool, NonEmptyStr, String }
import extdeps.cloud.gcp.secret_ref {
  SecretRef,
  HashPending,
}
import extdeps.cloud.gcp.gcp { GcpProjectId }
import gunbc.dispatch_selection {
  CursorApiKeySecretRef,
  CursorLocalLoginRef,
}
import gunbc.cursor_sdk_local_binding {
  CursorSdkLocalCredentialAdmitted,
  CursorSdkLocalCredentialRefused,
  cursor_sdk_local_credential_from_dispatch,
  cursor_sdk_materialization_uses_secret_ref,
}
import extdeps.llm.cursor_sdk {
  CursorSdkApiKeyFromEnvironment,
  cursor_sdk_environment_api_key_materialization,
}
import extdeps.llm.cursor_cli { cursor_api_key_env_var }

data witness_secret_ref: SecretRef = SecretRef {
  project: "gunbc-dashboard" as GcpProjectId,
  secret: "cursor-api-key" as NonEmptyStr,
  version: "7" as NonEmptyStr,
  hash_state: HashPending,
}

test fn dispatch_secret_ref_admits_sdk_local_binding() -> Bool {
  match cursor_sdk_local_credential_from_dispatch(
    credential: CursorApiKeySecretRef { secret_ref: witness_secret_ref },
  ) {
    CursorSdkLocalCredentialAdmitted { credential: _, materialization: _ } => true
    CursorSdkLocalCredentialRefused { reason: _ } => false
  }
}

test fn dispatch_local_login_ref_refuses() -> Bool {
  match cursor_sdk_local_credential_from_dispatch(credential: CursorLocalLoginRef) {
    CursorSdkLocalCredentialRefused { reason } =>
      string_contains(s: reason as String, pattern: "SecretRef")
    CursorSdkLocalCredentialAdmitted { credential: _, materialization: _ } => false
  }
}

test fn dispatch_secret_ref_materializes_via_secret_ref_arm() -> Bool {
  match cursor_sdk_local_credential_from_dispatch(
    credential: CursorApiKeySecretRef { secret_ref: witness_secret_ref },
  ) {
    CursorSdkLocalCredentialAdmitted { credential: _, materialization } =>
      cursor_sdk_materialization_uses_secret_ref(materialization: materialization)
    CursorSdkLocalCredentialRefused { reason: _ } => false
  }
}

test fn environment_materialization_consumes_cli_env_var() -> Bool {
  match cursor_sdk_environment_api_key_materialization() {
    CursorSdkApiKeyFromEnvironment { env_var } => env_var == cursor_api_key_env_var
    _ => false
  }
}

test fn dispatch_binding_refuses_latest_secret_version() -> Bool {
  match cursor_sdk_local_credential_from_dispatch(
    credential: CursorApiKeySecretRef {
      secret_ref: SecretRef {
        project: "gunbc-dashboard" as GcpProjectId,
        secret: "cursor-api-key" as NonEmptyStr,
        version: "latest" as NonEmptyStr,
        hash_state: HashPending,
      },
    },
  ) {
    CursorSdkLocalCredentialRefused { reason } =>
      string_contains(s: reason as String, pattern: "never latest")
    _ => false
  }
}

test fn cursor_sdk_dispatch_bridge_witness_keystone_holds() -> Bool {
  dispatch_secret_ref_admits_sdk_local_binding()
    && dispatch_local_login_ref_refuses()
    && dispatch_secret_ref_materializes_via_secret_ref_arm()
    && environment_materialization_consumes_cli_env_var()
    && dispatch_binding_refuses_latest_secret_version()
}
