  let want = DeclSubject { ref: decl_ref(module_path: "gunbc.roadmap.roadmap_attempt_metering", decl_name: "attempt_metering_roster_schema") }
  any(census_closure_frontier_rows(), c => frontier_subject_eq(a: c.subject, b: want))
}

test fn w_the_census_receipt_format_row_is_in_the_census_aggregate() -> Bool {
  let want = DeclSubject { ref: decl_ref(module_path: "gunbc.roadmap.roadmap_event_snapshot_census", decl_name: "snapshot_census_receipt_slots") }
  any(census_closure_frontier_rows(), c => frontier_subject_eq(a: c.subject, b: want))
}

