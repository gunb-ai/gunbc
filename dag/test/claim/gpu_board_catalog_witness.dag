module test.claim.gpu_board_catalog_witness

import std.types { Bool, NonEmptyStr }
import std.optional { Present, Absent }
import std.measure { watt, watt_count }
import extdeps.gpu.types {
  GpuBoardCatalogFacts, GpuBoardPower, GpuNamedPowerPoint, GpuBoardAdmission, GpuBoardAdmitted, GpuBoardRefused,
  GpuBoardRefusal, BoardCarriesNoGpu, BoardPowerRangeInverted, BoardPowerDefaultOutsideRange, BoardNamedPointOutsideRange,
  ZeroPowerSupported, ZeroPowerNotSupported, admit_gpu_board
}
import extdeps.gpu.nvidia_a16 { nvidia_a16_board_facts, nvidia_a16_board_catalog }

// The board row exists only through admit_gpu_board. The A16 as the brief states it is admitted with
// its figures intact, and each invariant the row carries has a red: the A16's own facts with one
// figure moved are refused, by the refusal that names that figure.

fn refused_as(a: GpuBoardAdmission, expect: GpuBoardRefusal) -> Bool {
  match a {
    GpuBoardAdmitted { row: _ } => false
    GpuBoardRefused { refusal } => match refusal {
      BoardCarriesNoGpu => match expect { BoardCarriesNoGpu => true  _ => false }
      BoardPowerRangeInverted => match expect { BoardPowerRangeInverted => true  _ => false }
      BoardPowerDefaultOutsideRange => match expect { BoardPowerDefaultOutsideRange => true  _ => false }
      BoardNamedPointOutsideRange { name } => match expect { BoardNamedPointOutsideRange { name: n } => (n as String) == (name as String)  _ => false }
    }
  }
}

fn with_power(f: GpuBoardCatalogFacts, p: GpuBoardPower) -> GpuBoardCatalogFacts {
  GpuBoardCatalogFacts {
    vendor: f.vendor, model: f.model, gpu: f.gpu, gpu_count: f.gpu_count, board_power: p,
    zero_power: f.zero_power, thermal: f.thermal, host_link: f.host_link, pci_device_id: f.pci_device_id,
    figure_citations: f.figure_citations,
  }
}

test fn the_a16_is_admitted_with_its_brief_figures() -> Bool {
  match nvidia_a16_board_catalog {
    GpuBoardRefused { refusal: _ } => false
    GpuBoardAdmitted { row } =>
      row.facts.gpu_count == 4
        && (row.facts.gpu.model as String) == "GA107-890"
        && watt_count(row.facts.board_power.minimum) == 195
        && watt_count(row.facts.board_power.maximum) == 250
        && match row.facts.zero_power { ZeroPowerNotSupported => true  ZeroPowerSupported => false }
  }
}

test fn a_board_that_breaks_an_invariant_has_no_row() -> Bool {
  let f = nvidia_a16_board_facts
  let p = f.board_power
  refused_as(a: admit_gpu_board(facts: GpuBoardCatalogFacts {
      vendor: f.vendor, model: f.model, gpu: f.gpu, gpu_count: 0, board_power: p,
      zero_power: f.zero_power, thermal: f.thermal, host_link: f.host_link, pci_device_id: f.pci_device_id,
      figure_citations: f.figure_citations,
    }), expect: BoardCarriesNoGpu)
    && refused_as(a: admit_gpu_board(facts: with_power(f: f, p: GpuBoardPower { default: p.default, minimum: watt(count: 260), maximum: p.maximum, named_points: [] })), expect: BoardPowerRangeInverted)
    && refused_as(a: admit_gpu_board(facts: with_power(f: f, p: GpuBoardPower { default: watt(count: 300), minimum: p.minimum, maximum: p.maximum, named_points: [] })), expect: BoardPowerDefaultOutsideRange)
    && refused_as(a: admit_gpu_board(facts: with_power(f: f, p: GpuBoardPower { default: p.default, minimum: p.minimum, maximum: p.maximum, named_points: [GpuNamedPowerPoint { name: "MaxQ", power: watt(count: 100) }] })), expect: BoardNamedPointOutsideRange { name: "MaxQ" })
    && !refused_as(a: admit_gpu_board(facts: with_power(f: f, p: GpuBoardPower { default: p.default, minimum: p.minimum, maximum: p.maximum, named_points: [GpuNamedPowerPoint { name: "MaxQ", power: watt(count: 195) }] })), expect: BoardNamedPointOutsideRange { name: "MaxQ" })
}
