module test.claim.rack_power_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn host_a() -> product.placement_supply.PhysicalAssetIdentity { ("srv-chassis-1" as product.placement_supply.PhysicalAssetIdentity) }
fn host_b() -> product.placement_supply.PhysicalAssetIdentity { ("srv-chassis-2" as product.placement_supply.PhysicalAssetIdentity) }
fn absent_host() -> product.placement_supply.PhysicalAssetIdentity { ("srv-chassis-99" as product.placement_supply.PhysicalAssetIdentity) }

fn mount(asset: product.placement_supply.PhysicalAssetIdentity, lowest: Int) -> product.rack_mount.ChassisMount {
  product.rack_mount.ChassisMount { asset: asset, chassis: extdeps.chassis.rosewill.rosewill_rsv_r4000u_catalog, lowest_unit: lowest }
}

fn rack_of(mounts: List<product.rack_mount.ChassisMount>) -> product.rack_mount.RackInstance? {
  match product.rack_mount.rack_instance(identity: ("rack-a" as product.placement_supply.RackIdentity), catalog: extdeps.rack.navepoint.navepoint_18u_open_frame_catalog, mounts: mounts) {
    product.rack_mount.MountRefused { cause: _ } => none
    product.rack_mount.MountReady { value: r } => v2.std.optional.Present { value: r }
  }
}

fn two_host_rack() -> product.rack_mount.RackInstance? { rack_of(mounts: [mount(asset: host_a(), lowest: 1), mount(asset: host_b(), lowest: 5)]) }

fn feed() -> product.rack_power.PowerFeed {
  product.rack_power.power_feed(identity: ("pdu-01" as product.placement_supply.PhysicalAssetIdentity), catalog: extdeps.power.eaton_tripp_lite.eaton_tripp_lite_rs_1215_family_catalog)
}

fn pf(percent: Int) -> product.rack_power.DeclaredPowerFactor? {
  match product.rack_power.declared_power_factor(percent: percent) {
    product.rack_power.PowerRefused { cause: _ } => none
    product.rack_power.PowerReady { value: f } => v2.std.optional.Present { value: f }
  }
}

fn budget(rack: product.rack_mount.RackInstance?, loads: List<product.rack_power.AssetLoad>, percent: Int) -> product.rack_power.PowerBudget? {
  match rack {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: r } =>
      match pf(percent: percent) {
        v2.std.optional.Absent => none
        v2.std.optional.Present { value: factor } =>
          match product.rack_power.rack_power_budget(rack: r, feed: feed(), loads: loads, power_factor: factor) {
            product.rack_power.PowerRefused { cause: _ } => none
            product.rack_power.PowerReady { value: b } => v2.std.optional.Present { value: b }
          }
      }
  }
}

fn refusal_of(rack: product.rack_mount.RackInstance?, loads: List<product.rack_power.AssetLoad>, percent: Int) -> product.rack_power.PowerRefusal? {
  match rack {
    v2.std.optional.Absent => none
    v2.std.optional.Present { value: r } =>
      match pf(percent: percent) {
        v2.std.optional.Absent => none
        v2.std.optional.Present { value: factor } =>
          match product.rack_power.rack_power_budget(rack: r, feed: feed(), loads: loads, power_factor: factor) {
            product.rack_power.PowerReady { value: _ } => none
            product.rack_power.PowerRefused { cause: c } => v2.std.optional.Present { value: c }
          }
      }
  }
}

// The cited RS-1215 states 120 V and 15 A, and their product is what the unit can deliver: 1800
// volt-amperes. It is derived from the two datasheet figures rather than authored, so no third
// number can disagree with them.
test fn the_feed_capacity_is_the_product_of_the_two_cited_figures() -> Bool {
  std.measure.volt_ampere_count(v: product.rack_power.feed_capacity(f: feed())) == 1800
}

test fn two_measured_hosts_inside_the_rating_produce_a_budget() -> Bool {
  match budget(
    rack: two_host_rack(),
    loads: [product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(400) }, product.rack_power.ObservedRealPower { asset: host_b(), draw: std.measure.watt(400) }],
    percent: 95,
  ) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: b } =>
      std.measure.watt_count(w: product.rack_power.budget_real_load(b: b)) == 800
        && std.measure.volt_ampere_count(v: product.rack_power.budget_apparent_load(b: b)) == 0
        && product.rack_power.budget_outlets_used(b: b) == 2
        && std.measure.volt_ampere_count(v: product.rack_power.budget_capacity(b: b)) == 1800
  }
}

// THE POWER FACTOR IS LOAD-BEARING, and this pair is what proves it rather than the type name. 1700
// watts at a factor of 100 is 1700 volt-amperes and fits; the SAME load at 90 needs about 1889 and
// does not. A module that quietly assumed unity would admit both.
test fn the_declared_power_factor_decides_a_marginal_load() -> Bool {
  match budget(rack: two_host_rack(), loads: [product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(1700) }, product.rack_power.ObservedRealPower { asset: host_b(), draw: std.measure.watt(0) }], percent: 100) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: _ } =>
      match refusal_of(rack: two_host_rack(), loads: [product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(1700) }, product.rack_power.ObservedRealPower { asset: host_b(), draw: std.measure.watt(0) }], percent: 90) {
        v2.std.optional.Absent => false
        v2.std.optional.Present { value: c } =>
          match c {
            product.rack_power.FeedCapacityExceeded { real_load: r, apparent_load: _, capacity: cap } =>
              std.measure.watt_count(w: r) == 1700 && std.measure.volt_ampere_count(v: cap) == 1800
            product.rack_power.PowerFactorOutOfRange { supplied: _ } => false
            product.rack_power.LoadNotObserved { asset: _ } => false
            product.rack_power.LoadDeclaredTwice { asset: _ } => false
            product.rack_power.LoadDeclaredForUnmountedAsset { asset: _ } => false
            product.rack_power.MountedAssetHasNoLoad { asset: _ } => false
            product.rack_power.OutletsExhausted { required: _, available: _ } => false
          }
      }
  }
}

// A nameplate figure is already apparent power and is NOT converted: the power factor applies to the
// real-power arm only. Mixing the two in one rack is ordinary, and the totals stay separate so a
// reader can see which half rests on the declared assumption.
test fn a_nameplate_load_is_counted_as_apparent_power_unconverted() -> Bool {
  match budget(
    rack: two_host_rack(),
    loads: [product.rack_power.DeclaredApparentPower { asset: host_a(), draw: std.measure.volt_ampere(1000) }, product.rack_power.ObservedRealPower { asset: host_b(), draw: std.measure.watt(400) }],
    percent: 50,
  ) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: b } =>
      std.measure.volt_ampere_count(v: product.rack_power.budget_apparent_load(b: b)) == 1000 && std.measure.watt_count(w: product.rack_power.budget_real_load(b: b)) == 400
  }
}

// An unmeasured machine is not a machine drawing nothing. This is the arm that keeps an unmeasured
// rack from reporting comfortable headroom.
test fn an_unobserved_load_refuses_rather_than_counting_as_zero() -> Bool {
  match refusal_of(rack: two_host_rack(), loads: [product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(400) }, product.rack_power.LoadUnobserved { asset: host_b() }], percent: 95) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.rack_power.LoadNotObserved { asset: a } => (a as String) == "srv-chassis-2"
        product.rack_power.PowerFactorOutOfRange { supplied: _ } => false
        product.rack_power.LoadDeclaredTwice { asset: _ } => false
        product.rack_power.LoadDeclaredForUnmountedAsset { asset: _ } => false
        product.rack_power.MountedAssetHasNoLoad { asset: _ } => false
        product.rack_power.OutletsExhausted { required: _, available: _ } => false
        product.rack_power.FeedCapacityExceeded { real_load: _, apparent_load: _, capacity: _ } => false
      }
  }
}

// COMPLETENESS IS AN IDENTITY JOIN, and this is the arrangement that proves it: two rows for two
// mounted assets, so any count-based check passes, while one asset is measured twice and the other
// not at all.
test fn two_rows_for_one_asset_do_not_stand_in_for_the_other() -> Bool {
  match refusal_of(
    rack: two_host_rack(),
    loads: [product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(400) }, product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(400) }],
    percent: 95,
  ) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.rack_power.MountedAssetHasNoLoad { asset: a } => (a as String) == "srv-chassis-2"
        product.rack_power.LoadDeclaredTwice { asset: a } => (a as String) == "srv-chassis-1"
        product.rack_power.PowerFactorOutOfRange { supplied: _ } => false
        product.rack_power.LoadNotObserved { asset: _ } => false
        product.rack_power.LoadDeclaredForUnmountedAsset { asset: _ } => false
        product.rack_power.OutletsExhausted { required: _, available: _ } => false
        product.rack_power.FeedCapacityExceeded { real_load: _, apparent_load: _, capacity: _ } => false
      }
  }
}

// The other direction of the join: a row naming a machine this rack does not carry is a stale
// inventory, and it is its own refusal because its remedy is a different one.
test fn a_load_for_an_unmounted_asset_refuses() -> Bool {
  match refusal_of(
    rack: two_host_rack(),
    loads: [
      product.rack_power.ObservedRealPower { asset: host_a(), draw: std.measure.watt(400) },
      product.rack_power.ObservedRealPower { asset: host_b(), draw: std.measure.watt(400) },
      product.rack_power.ObservedRealPower { asset: absent_host(), draw: std.measure.watt(400) },
    ],
    percent: 95,
  ) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: c } =>
      match c {
        product.rack_power.LoadDeclaredForUnmountedAsset { asset: a } => (a as String) == "srv-chassis-99"
        product.rack_power.PowerFactorOutOfRange { supplied: _ } => false
        product.rack_power.LoadNotObserved { asset: _ } => false
        product.rack_power.LoadDeclaredTwice { asset: _ } => false
        product.rack_power.MountedAssetHasNoLoad { asset: _ } => false
        product.rack_power.OutletsExhausted { required: _, available: _ } => false
        product.rack_power.FeedCapacityExceeded { real_load: _, apparent_load: _, capacity: _ } => false
      }
  }
}

test fn a_power_factor_outside_its_range_is_not_a_power_factor() -> Bool {
  match product.rack_power.declared_power_factor(percent: 0) {
    product.rack_power.PowerReady { value: _ } => false
    product.rack_power.PowerRefused { cause: c } =>
      match c {
        product.rack_power.PowerFactorOutOfRange { supplied: s } => s == 0
        product.rack_power.LoadNotObserved { asset: _ } => false
        product.rack_power.LoadDeclaredTwice { asset: _ } => false
        product.rack_power.LoadDeclaredForUnmountedAsset { asset: _ } => false
        product.rack_power.MountedAssetHasNoLoad { asset: _ } => false
        product.rack_power.OutletsExhausted { required: _, available: _ } => false
        product.rack_power.FeedCapacityExceeded { real_load: _, apparent_load: _, capacity: _ } => false
      }
  }
}

test fn a_power_factor_above_unity_is_refused_too() -> Bool {
  match product.rack_power.declared_power_factor(percent: 101) {
    product.rack_power.PowerReady { value: _ } => false
    product.rack_power.PowerRefused { cause: _ } => true
  }
}
