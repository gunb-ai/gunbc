module test.claim.spark_credential_workflow_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn spark_admin_password_secret_pins_versions_one_not_latest() -> Bool {
  let resource = secret_ref_version_resource(ref: spark_administrator_password_secret_ref)
  spark_administrator_password_secret_ref.version as String == "1"
    && string_contains(s: resource, pattern: "/secrets/spark-administrator-password/versions/1")
    && spark_administrator_password_secret_ref.version as String != "latest"
}

test fn fleet_automation_privkey_secret_pins_versions_one_not_latest() -> Bool {
  fleet_automation_ssh_privkey_secret.version as String == "1"
    && string_contains(
      s: secret_ref_version_resource(ref: fleet_automation_ssh_privkey_secret),
      pattern: "/versions/1",
    )
    && fleet_automation_ssh_privkey_secret.version as String != "latest"
}

test fn privkey_identity_file_name_is_attempt_scoped_and_not_worktree_target() -> Bool {
  match fleet_ssh_attempt_identity(raw: "witness-attempt-1") {
    Present { value: attempt } => {
      let name = fleet_ssh_privkey_identity_file_name(attempt: attempt) as String
      name == "gunbc-fleet-ssh-attempt-witness-attempt-1-privkey"
        && !string_contains(s: name, pattern: "target/")
    }
    Absent => false
  }
}

test fn unsafe_attempt_identity_refuses_before_secret_fetch() -> Bool {
  match fleet_ssh_attempt_identity(raw: "../escape") {
    Absent => true
    Present { value: _ } => false
  }
}

test fn wire_decode_refusal_labels_identity_cause() -> Bool {
  let reason = secret_credential_wire_decode_refusal_reason(
    identity_cause: Present { value: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityEmpty },
    payload_cause: Absent,
  ) as String
  reason == "resolved version identity empty"
}

test fn wire_decode_refusal_labels_payload_cause() -> Bool {
  let reason = secret_credential_wire_decode_refusal_reason(
    identity_cause: Absent,
    payload_cause: Present { value: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadInvalidBase64 },
  ) as String
  reason == "access version payload invalid base64"
}

test fn wire_decode_refusal_joins_both_causes() -> Bool {
  let reason = secret_credential_wire_decode_refusal_reason(
    identity_cause: Present { value: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityMalformed },
    payload_cause: Present { value: extdeps.cloud.gcp.secret_manager.SmAccessVersionPayloadEmpty },
  ) as String
  reason == "resolved version identity malformed; access version payload empty"
}

test fn fetch_refusal_reason_maps_access_upsert_required() -> Bool {
  match gcloud_access_token_resolution(
    success: false,
    stderr: "ERROR: (gcloud.auth.print-access-token) Reauthentication required.",
    token: "unused" as std.types.Secret,
  ) {
    AccessTokenUpsertRequired { plan: plan } => {
      let mapped = secret_credential_fetch_refusal_reason(
        fetch: gunbc.auth.secret_ref_credential.SecretCredentialAccessUpsertRequired { plan: plan },
      ) as String
      mapped == access_token_upsert_required_reason(plan: plan) as String
    }
    _ => false
  }
}

test fn fetch_refusal_reason_maps_fetch_refused() -> Bool {
  let reason = secret_credential_fetch_refusal_reason(
    fetch: gunbc.auth.secret_ref_credential.SecretCredentialFetchRefused { reason: "synthetic refusal" as std.types.NonEmptyStr },
  ) as String
  reason == "synthetic refusal"
}

test fn fetch_refusal_reason_maps_wire_decode_refused() -> Bool {
  let reason = secret_credential_fetch_refusal_reason(
    fetch: gunbc.auth.secret_ref_credential.SecretCredentialWireDecodeRefused {
      identity_cause: Present { value: extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentityEmpty },
      payload_cause: Absent,
    },
  ) as String
  reason == "resolved version identity empty"
}

test fn fetch_refusal_reason_refuses_ready_arm_mislabeled_as_failure() -> Bool {
  string_contains(
    s: secret_credential_fetch_refusal_reason(
      fetch: gunbc.auth.secret_ref_credential.SecretCredentialReady {
        credential: "synthetic" as std.types.Secret,
        resolved_version: "projects/example-project/secrets/example-secret/versions/1" as extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
      },
    ) as String,
    pattern: "mapping refusal",
  )
}

test fn workflow_note_forbids_argv_plaintext_credentials() -> Bool {
  string_contains(s: spark_credential_workflow_note, pattern: "never plaintext")
    && string_contains(s: spark_credential_workflow_note, pattern: "fetch_secret_ref_credential")
    && string_contains(s: spark_credential_workflow_note, pattern: "argv")
}

test fn workflow_note_names_admin_password_critical_path() -> Bool {
  string_contains(s: spark_credential_workflow_note, pattern: "critical path")
    && string_contains(s: spark_credential_workflow_note, pattern: "EnableLingerForOwnAccount")
    && string_contains(s: spark_credential_workflow_note, pattern: "SystemUnitRealization")
}

test fn access_token_frontier_names_gcloud_only_and_refuses_workaround() -> Bool {
  string_contains(s: spark_credential_access_token_frontier_note, pattern: "GcloudPrintToken")
    && string_contains(s: spark_credential_access_token_frontier_note, pattern: "ACCESS_TOKEN_TYPE_UNSUPPORTED")
    && string_contains(s: spark_credential_access_token_frontier_note, pattern: "github_actions_wif")
    && string_contains(s: spark_credential_access_token_frontier_note, pattern: "HOST SCOPE")
    && string_contains(s: spark_credential_access_token_frontier_note, pattern: "dead work")
    && string_contains(s: spark_credential_access_token_frontier_note, pattern: "refuses")
}

test fn secret_ref_hash_state_admits_only_hash_pending() -> Bool {
  spark_administrator_password_secret_ref.hash_state == extdeps.cloud.gcp.secret_ref.HashPending
    && fleet_automation_ssh_privkey_secret.hash_state == extdeps.cloud.gcp.secret_ref.HashPending
}

test fn consumer_evidence_from_ready_fetch_names_resolved_version() -> Bool {
  match consumer_evidence_from_secret_fetch(
    consumer: fleet_automation_ssh_privkey_rotation_consumer_id,
    fetch: gunbc.auth.secret_ref_credential.SecretCredentialReady {
      credential: "synthetic" as std.types.Secret,
      resolved_version: "projects/gunbai-secrets/secrets/fleet-automation-ssh-key/versions/1" as extdeps.cloud.gcp.secret_manager.SmResolvedVersionIdentity,
    },
  ) {
    Present { value: gunbc.auth.secret_rotation.ResolvedVersionObserved { consumer: c, resolved: r } } =>
      c == fleet_automation_ssh_privkey_rotation_consumer_id
        && r as String == "projects/gunbai-secrets/secrets/fleet-automation-ssh-key/versions/1"
    Absent => false
  }
}

test fn consumer_evidence_refuses_fetch_refused() -> Bool {
  match consumer_evidence_from_secret_fetch(
    consumer: spark_administrator_password_rotation_consumer_id,
    fetch: gunbc.auth.secret_ref_credential.SecretCredentialFetchRefused { reason: "synthetic refusal" as std.types.NonEmptyStr },
  ) {
    Absent => true
    Present { value: _ } => false
  }
}
