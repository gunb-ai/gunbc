module test.claim.m4_universal_corpus_witness


fn witness_universal_published_realizes() -> Bool {
  let r = GovernedUniversalProbe.Allowed()
  return r.ok == "universal-published-realized"
}

fn witness_universal_unpublished_fails_closed() -> Bool {
  let r = GovernedUniversalProbe.Forbidden()
  return r.ok != ""
}
