module test.claim.module_graph.demand_closure_agreement_witness

import std.algebra { FreeMonoid }
import v2.std.algebra { contains, for_all }
import v2.std.text { String, string_eq }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.lens.module_graph {
  dependency_closure,
  dependency_closure_live_excluding,
  dependency_resolution_facts_live,
  module_declaration_facts_live,
  module_graph_exclude_substrings
}
import gunbc.ci_layer_roots { witness_layer_roots }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE DEMAND WALK ANSWERS WHAT THE CORPUS WALK ANSWERED. v2.lens.module_graph
// dependency_closure_live_excluding now expands from the entry through the keyed edge read instead
// of folding every module's edges into an adjacency first. The reference here is the fold it
// replaced -- dependency_closure over the population read's edges and the whole declaration census
// -- run on the same live tree and roots, so a divergence in edge law, target resolution or visited
// tracking shows as a set difference. The two entries are real: the approval broker, whose closure
// no longer reaches the compiler, and gunbc.commit_workflow, whose closure does, so agreement is
// asserted on both sides of the boundary the broker wall (test.claim.auth.approval_broker_closure_witness)
// depends on.
data broker_entry: String = "dag/gunbc/auth/approval_broker_serve.dag"

data compiler_reaching_entry: String = "dag/gunbc/commit_workflow.dag"

fn same_set(a: FreeMonoid<String>, b: FreeMonoid<String>) -> Bool {
  for_all(xs: a, predicate: fn(x) { contains(xs: b, item: x, eq: string_eq) })
    && for_all(xs: b, predicate: fn(x) { contains(xs: a, item: x, eq: string_eq) })
}

fn corpus_walk_closure(entry: String) -> FreeMonoid<String> {
  dependency_closure(
    entry_path: entry,
    edges: dependency_resolution_facts_live(pool_roots: witness_layer_roots, importer_roots: witness_layer_roots, exclude_substrings: module_graph_exclude_substrings),
    nodes: module_declaration_facts_live(pool_roots: witness_layer_roots)
  )
}

fn demand_walk_closure(entry: String) -> FreeMonoid<String> {
  dependency_closure_live_excluding(entry_path: entry, pool_roots: witness_layer_roots, exclude_substrings: module_graph_exclude_substrings)
}

test fn the_demand_walk_agrees_with_the_corpus_walk_on_the_broker() -> Bool {
  same_set(a: demand_walk_closure(entry: broker_entry), b: corpus_walk_closure(entry: broker_entry))
}

test fn the_demand_walk_agrees_with_the_corpus_walk_on_a_compiler_reaching_entry() -> Bool {
  same_set(a: demand_walk_closure(entry: compiler_reaching_entry), b: corpus_walk_closure(entry: compiler_reaching_entry))
}
