module test.claim.runner_capacity_plan_witness

import std.logic { Bool }
import std.nat { Nat }
import gunbc.fleet_intent_network { operator_host_srv3, operator_host_srv4 }
import gunbc.runner_capacity_plan {
  desired_slot_indices,
  addition_slot_indices,
  reconcile_slot_population,
  SlotPopulationVerdict,
  SlotPopulationReconciled,
  SlotPopulationRefused,
}
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.build_cache_instance { RunnerSlotIdentity }
import gunbc.runner_capacity_plan {
  runner_capacity_plan,
  runner_capacity_add_count,
  addition_actions,
  PlanReady,
  PlanRefused,
}
import gunbc.fleet_runner_connectivity {
  organization_runner_roster_evidence,
  RosterReadUnavailable,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THIS REPLACES A WITNESS THAT ASSERTED TWO ADDITIONS PER HOST AT REQUESTED 7, AND THE OLD
// ASSERTION WAS WRONG IN A WAY ITS GREEN CONCEALED. It required slots 06 AND 07 on hosts whose
// committed width is 6, so it demanded a SEVENTH slot on a six-wide host -- an artifact of the
// 14GiB era, when the managed hosts admitted 7. The 2026-08-17 16GiB ruling moved them to 6 and
// this witness was never re-derived, so CI was affirming a false statement about the fleet.
//
// SEVEN IS NOW REFUSED RATHER THAN QUIETLY UNFULFILLED. The admission ceiling derives from the
// committed width instead of restating it as a literal 7, so a request no host has been admitted
// to carry stops at the wall with a typed cause rather than being admitted and then producing
// nothing. Both hosts plan zero actions and both carry a WidthRefused admission -- the difference
// from the old behaviour is that the refusal is now VISIBLE in the plan.
test fn a_width_above_the_committed_ceiling_is_refused_not_silently_unfulfilled() -> Bool {
  let plan = runner_capacity_plan(
    srv3_width: 7,
    srv4_width: 7,
    roster: organization_runner_roster_evidence()
  )
  match plan {
    PlanReady { hosts: _ } =>
      runner_capacity_add_count(plan: plan, host: operator_host_srv3) == 0
        && runner_capacity_add_count(plan: plan, host: operator_host_srv4) == 0
    PlanRefused { reason: _ } => false
  }
}

// AT THE COMMITTED WIDTH THE TWO HOSTS DISAGREE, AND THAT IS THE PURPOSE MODEL SHOWING THROUGH.
// Both are six wide and both requests are admitted. srv4 has no fabric slot, so its GitHub
// population is all 6 and one addition is planned: slot 06. srv3 carries the one compute-fabric
// slot, so its GitHub population is 5, it is already at 5, and NO addition is planned -- the sixth
// slot exists in the model and is deliberately not a GitHub runner. Same width, same request,
// different populations.
test fn at_the_committed_width_additions_follow_purpose_not_count() -> Bool {
  let plan = runner_capacity_plan(
    srv3_width: 6,
    srv4_width: 6,
    roster: organization_runner_roster_evidence()
  )
  match plan {
    PlanReady { hosts: _ } =>
      runner_capacity_add_count(plan: plan, host: operator_host_srv4) == 1
        && runner_capacity_add_count(plan: plan, host: operator_host_srv3) == 0
    PlanRefused { reason: _ } => false
  }
}

// ENROLLED REGRESSION CONTROL FOR THE EMPTY-OBSERVATION NARROW
// (gunbc.runner_capacity_plan slot_enumeration_narrow_class_note).
//
// These two are a PAIR and neither is meaningful alone. Before the enumerator was derived,
// desired_slot_indices(6) returned five indices and widening srv4 from 5 to 6 returned zero
// actions. The srv4 row is the one that FLIPPED: it was false and is now true, so it goes red
// again the moment an enumeration stops being able to express a width.
//
// THE srv3 ROW IS HERE BECAUSE IT DID NOT FLIP, WHICH IS THE TRAP. Widening srv3 from 5 to 6
// planned zero additions before this change and plans zero additions after it, for entirely
// different reasons -- first because the bucket could not spell 6, now because slot 06 is a
// compute-fabric slot withheld from the GitHub plan. Enrolled alone it would have stayed green
// straight through the defect AND the fix while silently changing meaning, which is precisely the
// shape that let this class survive. It is only a check when read against the srv4 row beside it:
// same width transition, same index, different purpose, different answer.
test fn a_requested_width_is_always_enumerable_and_purpose_gates_the_plan() -> Bool {
  desired_slot_indices(width: 6).length() == 6
    && addition_actions(host: operator_host_srv4, requested_width: 6, observed_width: 5).length() == 1
    && addition_actions(host: operator_host_srv3, requested_width: 6, observed_width: 5).length() == 0
}

// WIDTH MOVED TO 6 SO THIS ROW STILL REACHES ITS OWN SUBJECT. The admission ceiling now derives
// from the committed width, so a request for 7 is refused BEFORE the roster is ever consulted --
// the plan would come back Ready with zero actions and this row would have been asserting the width
// wall while claiming to assert the roster wall. At the committed width admission passes and the
// unavailable roster is genuinely what refuses.
test fn roster_unavailable_refuses_runner_capacity_plan() -> Bool {
  match runner_capacity_plan(
    srv3_width: 6,
    srv4_width: 6,
    roster: RosterReadUnavailable { reason: "503" }
  ) {
    PlanRefused { reason: _ } => true
    PlanReady { hosts: _ } => false
  }
}

test fn satisfied_observed_width_plans_zero_additions() -> Bool {
  addition_actions(host: operator_host_srv3, requested_width: 5, observed_width: 5).length() == 0
    && addition_actions(host: operator_host_srv3, requested_width: 7, observed_width: 7).length() == 0
}

fn population_is_refused(v: SlotPopulationVerdict) -> Bool {
  match v {
    SlotPopulationRefused { reason: _ } => true
    SlotPopulationReconciled => false
  }
}

// THE ENUMERATOR IS A GENERAL POPULATION MODEL, NOT A SPECIAL CASE FOR SLOT 6, AND THESE TWO ROWS
// ARE A PAIR FOR THAT REASON. Asserting only the 5-to-6 transition would go green against an
// enumerator that hardcoded "if the gap is slot 6, add slot 6" -- the bucket rebuilt under a new
// name, which is exactly the shape this change removed. The 5-to-7 row is what makes that
// impossible: no single special case satisfies both.
//
// THEY ASSERT THE INDICES AND NOT THE COUNT. A length check cannot tell [6] from [7], so a run
// that produced the right NUMBER of the WRONG slots would pass while planning work against slots
// that are not the ones missing. This is the enumerator's own claim, taken below the host-policy
// clamp deliberately: what a host may do with the run is purpose's business, but the run itself
// must be a correct run of naturals for every transition.
test fn the_additions_run_is_general_across_transitions() -> Bool {
  addition_slot_indices(observed_width: 5, requested_width: 6) == [6]
    && addition_slot_indices(observed_width: 5, requested_width: 7) == [6, 7]
    && addition_slot_indices(observed_width: 0, requested_width: 3) == [1, 2, 3]
    && addition_slot_indices(observed_width: 5, requested_width: 5) == []
    && addition_slot_indices(observed_width: 6, requested_width: 5) == []
}

fn srv3_slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv3, slot_index: i }
}

fn srv1_slot(i: Nat) -> RunnerSlotIdentity {
  RunnerSlotIdentity { host: operator_host_srv1, slot_index: i }
}

// A GitHub RUNNER SITTING IN THE FABRIC'S SLOT MUST NOT READ AS CONVERGED, AND THE THIRD ROW IS THE
// ONE THAT MATTERS. The first two are the unequal-count cases an Int-shaped reconciler could already
// catch. The third is the case it could not: observed GitHub {1,2,3,4,6} against expected
// {1,2,3,4,5} counts FIVE ON BOTH SIDES, so every count-shaped comparison reconciles, while slot 06
// -- the fabric member -- is occupied by an actions-runner and a legitimate GitHub member is missing.
// That is exactly the proposition this module asserts counts cannot establish, and an earlier
// revision of reconcile_slot_population took an observed_width Int while its own annotation claimed
// it compared populations.
//
// THE srv1 ROWS ARE THE CONTROL AND WITHOUT THEM THIS PROVES NOTHING. srv1 has no fabric slot, so
// its full committed population is a reconciled observation and must NOT refuse; an identity beyond
// its width must. A verdict that refused every non-empty roster would satisfy the srv3 rows by
// being broken everywhere.
test fn a_github_runner_in_a_fabric_slot_refuses_instead_of_reading_converged() -> Bool {
  population_is_refused(v: reconcile_slot_population(
    host: operator_host_srv3,
    observed: [srv3_slot(i: 1), srv3_slot(i: 2), srv3_slot(i: 3), srv3_slot(i: 4), srv3_slot(i: 5), srv3_slot(i: 6)],
  ))
    && !population_is_refused(v: reconcile_slot_population(
      host: operator_host_srv3,
      observed: [srv3_slot(i: 1), srv3_slot(i: 2), srv3_slot(i: 3), srv3_slot(i: 4), srv3_slot(i: 5)],
    ))
    && population_is_refused(v: reconcile_slot_population(
      host: operator_host_srv3,
      observed: [srv3_slot(i: 1), srv3_slot(i: 2), srv3_slot(i: 3), srv3_slot(i: 4), srv3_slot(i: 6)],
    ))
    && !population_is_refused(v: reconcile_slot_population(
      host: operator_host_srv1,
      observed: [srv1_slot(i: 1), srv1_slot(i: 2), srv1_slot(i: 3), srv1_slot(i: 4), srv1_slot(i: 5)],
    ))
    && population_is_refused(v: reconcile_slot_population(
      host: operator_host_srv1,
      observed: [srv1_slot(i: 1), srv1_slot(i: 6)],
    ))
}
