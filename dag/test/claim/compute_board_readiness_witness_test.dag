module test.claim.compute_board_readiness_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data witness_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "amperecomputing.com/briefs/ampere-altra-family-product-brief"
  }
}

fn list_is_empty<T>(xs: List<T>) -> Bool {
  fold(xs, init: true, f: (acc, _) => false)
}

fn list_count<T>(xs: List<T>) -> Int {
  fold(xs, init: 0, f: (acc, _) => acc + 1)
}

fn contact(designator: std.types.NonEmptyStr) -> extdeps.cpu.ampere_altra_package.PackageContact {
  extdeps.cpu.ampere_altra_package.PackageContact { designator: designator, function: FunctionUnstated }
}

// A THREE-CONTACT FIXTURE, DELIBERATELY. The subject under proof is the count-and-identity
// JOIN, and the smallest specimen that crosses the boundary is the requirement plus one. A
// 4926-row fixture would prove nothing further and would be a cost-shape defect wearing a
// test's name.
fn three_contact_map() -> extdeps.cpu.ampere_altra_package.PackageContactMap {
  extdeps.cpu.ampere_altra_package.PackageContactMap {
    socket: altra_fclga_socket,
    contacts: [contact(designator: "A1"), contact(designator: "A2"), contact(designator: "A3")],
    authority: witness_authority,
  }
}

fn duplicated_contact_map() -> extdeps.cpu.ampere_altra_package.PackageContactMap {
  extdeps.cpu.ampere_altra_package.PackageContactMap {
    socket: altra_fclga_socket,
    contacts: [contact(designator: "A1"), contact(designator: "A2"), contact(designator: "A1")],
    authority: witness_authority,
  }
}

fn standing_is_admitted(s: extdeps.cpu.ampere_altra_package.PackageContactMapStanding) -> Bool {
  match s {
    PackageContactMapAdmitted { resolved: _ } => true
    _ => false
  }
}

// POSITIVE CONTROL. Without this, every refusal claim below is satisfied by a function that
// refuses unconditionally, which would establish nothing at all.
test fn w_exact_population_admits() -> Bool {
  standing_is_admitted(s: admit_package_contact_map(map: three_contact_map(), expected: 3))
}

// THE DISCRIMINATING RED FOR THE COMPLETENESS JOIN: the same map that admits at 3 must refuse
// against the real declared package population, and the refusal must carry both numbers so the
// reader learns the size of the gap rather than only that one exists.
test fn w_stub_population_refuses_against_declared_package_count() -> Bool {
  match admit_package_contact_map(
    map: three_contact_map(),
    expected: altra_declared_contact_count()
  ) {
    ContactPopulationIncomplete { expected: e, resolved: r } => e == 4926 && r == 3
    _ => false
  }
}

// Adding, deleting or duplicating a contact must make the design refuse. Duplication is the
// arm that a pure count check cannot catch: this map has exactly three entries and would pass
// a count-only join while naming only two distinct lands.
test fn w_duplicate_designator_refuses_at_correct_count() -> Bool {
  match admit_package_contact_map(map: duplicated_contact_map(), expected: 3) {
    DuplicateContactDesignator { designator: d } => d == "A1"
    _ => false
  }
}

test fn w_incomplete_differential_polarity_projects_to_design_refusal() -> Bool {
  let projected = project_contact_map_standing(
    standing: extdeps.cpu.ampere_altra_package.IncompleteDifferentialPolarity { pair: "DDR4_CLK_0" }
  )
  list_count(xs: projected.design) == 1
    && list_is_empty(xs: projected.collateral)
    && !board_is_ready(r: projected)
}

// GAP-0's live claim, CORRECTED TWICE. The Altra pin map is public (Rev A1 datasheet Issue
// 1.15, section 5 Table 4). An earlier revision asserted the opposite; a later one correctly
// named the standing as 'published and not yet ingested'. ALTRA-CONTACTS-0 completes that
// ingestion, so the live standing is now admitted at the declared package population.
test fn w_altra_contact_map_is_published_and_lands_in_design_family() -> Bool {
  match altra_contact_map_standing() {
    PackageContactMapAdmitted { resolved: n } => {
      let contact_only = project_contact_map_standing(standing: altra_contact_map_standing())
      n == altra_declared_contact_count()
        && list_is_empty(xs: contact_only.collateral)
        && list_is_empty(xs: contact_only.design)
    }
    _ => false
  }
}

// The genuinely NDA-bound subject is the reference BOARD collateral, and it must still land in
// the COLLATERAL family. Both arms are asserted together because the correction is precisely
// that these two are different subjects with different owners; a witness on either alone would
// have passed under the wrong model too.
// ASSERTED THROUGH board_readiness, NOT through the projection. An earlier revision called
// project_reference_board_standing directly and passed while board_readiness never consulted
// it at all, so the NDA blocker read as ready on the one surface the module documents as the
// answer. A claim about a fold has to travel the fold.
test fn w_reference_board_collateral_reaches_the_readiness_fold() -> Bool {
  let blocked = board_readiness(
    intent: narrow_compute_node_intent,
    components: [],
    contact_standing: extdeps.cpu.ampere_altra_package.PackageContactMapAdmitted { resolved: 4926 },
    reference_board_standing: altra_reference_board_collateral_standing()
  )
  let clear = board_readiness(
    intent: narrow_compute_node_intent,
    components: [],
    contact_standing: extdeps.cpu.ampere_altra_package.PackageContactMapAdmitted { resolved: 4926 },
    reference_board_standing: ReferenceBoardCollateralAvailable
  )
  list_count(xs: blocked.collateral) == 1
    && !board_is_ready(r: blocked)
    && list_is_empty(xs: clear.collateral)
}

// The cited pin summary cross-foots: 1960 signal + 2927 power/ground + 39 reserved = 4926,
// which is the same total the product brief prints independently. Two documents agreeing is
// what makes this a completeness authority rather than a transcribed number.
test fn w_pin_summary_cross_foots_to_declared_package_count() -> Bool {
  altra_pin_summary_total() == altra_declared_contact_count()
}

// An empty board leaves every contract capability unsatisfied. Ten requirements, ten holes:
// the count is the contract's, so a requirement added without a component would move it.
test fn w_empty_board_leaves_every_capability_unsatisfied() -> Bool {
  list_count(xs: unsatisfied_board_capabilities(intent: narrow_compute_node_intent, components: [])) == list_count(xs: narrow_compute_node_intent.requirements)
}

fn cpu_component() -> product.compute_board.composition.ComponentInstance {
  product.compute_board.composition.ComponentInstance {
    designator: "U1",
    part: "processor",
    justifications: [product.compute_board.composition.DischargesCapability { capability: Compute }],
    provisions: [product.compute_board.composition.ProvidesCores { cores: hardware_thread_count(128) }],
  }
}

fn undersized_cpu_component() -> product.compute_board.composition.ComponentInstance {
  product.compute_board.composition.ComponentInstance {
    designator: "U1",
    part: "processor",
    justifications: [product.compute_board.composition.DischargesCapability { capability: Compute }],
    provisions: [product.compute_board.composition.ProvidesCores { cores: hardware_thread_count(127) }],
  }
}

fn decoupling_component() -> product.compute_board.composition.ComponentInstance {
  product.compute_board.composition.ComponentInstance {
    designator: "C1",
    part: "decoupling network",
    justifications: [
      product.compute_board.composition.ImposedByComponent {
        by: "U1",
        requirement: "supply decoupling required by the processor's power delivery specification",
        authority: witness_authority,
      }
    ],
    provisions: [],
  }
}

fn unjustified_component() -> product.compute_board.composition.ComponentInstance {
  product.compute_board.composition.ComponentInstance { designator: "J9", part: "expansion header", justifications: [], provisions: [] }
}

test fn w_discharging_component_satisfies_its_capability() -> Bool {
  capability_satisfied(components: [cpu_component()], cap: Compute)
    && !capability_satisfied(components: [cpu_component()], cap: MemorySubsystem)
}

// THE SEPARATION THAT MATTERS MOST HERE: a component earned by another component's imposed
// requirement is legitimately in the design, yet it satisfies NO contract capability. If these
// two facts were one field, a board could appear to satisfy its contract entirely through
// support parts that discharge nothing the workload asked for.
test fn w_imposed_component_is_earned_but_discharges_no_capability() -> Bool {
  list_is_empty(xs: unearned_components(components: [decoupling_component()]))
    && !capability_satisfied(components: [decoupling_component()], cap: Compute)
}

test fn w_unjustified_component_is_unearned() -> Bool {
  let unearned = unearned_components(components: [cpu_component(), unjustified_component()])
  list_count(xs: unearned) == 1 && fold(unearned, init: false, f: fn(acc, c) { acc || c.designator == "J9" })
}

// RED CONTROL FOR THE READINESS FOLD: a board clean on both other axes must still refuse when
// only the manufacturing family is non-empty. Written because a fold that consulted just the
// design list would pass every other claim in this file.
test fn w_manufacturing_refusal_alone_blocks_readiness() -> Bool {
  !board_is_ready(r: product.compute_board.composition.BoardReadiness {
    collateral: [],
    design: [],
    manufacturing: [product.compute_board.composition.FabricatorStackupUnconfirmed { fabricator: "unselected" }],
  })
    && board_is_ready(r: product.compute_board.composition.BoardReadiness { collateral: [], design: [], manufacturing: [] })
}

fn carriage_of(rows: List<extdeps.ipc.dpmx.FormatSemanticRow>, semantic: extdeps.ipc.dpmx.ManufacturingSemantic) -> extdeps.ipc.dpmx.SemanticCarriage {
  fold(rows, init: NotCarried, f: fn(acc, row) {
    match row.semantic {
      NetlistConnectivity => match semantic {
        NetlistConnectivity => row.carriage
        _ => acc
      }
      _ => acc
    }
  })
}

fn carriage_is_in_format(c: extdeps.ipc.dpmx.SemanticCarriage) -> Bool {
  match c {
    CarriedInFormat => true
    _ => false
  }
}

// THE FACT THAT DECIDES WHICH ARTIFACT SET A FACTORY RECEIVES, proven by execution over the
// two upstream carriage rosters rather than asserted in prose: connectivity survives the
// IPC-DPMX projection and does NOT survive the Gerber layer projection. This is why 'the
// emitter is green' can never mean 'the manufacturer has been told what the board is'.
test fn w_connectivity_survives_dpmx_and_not_gerber() -> Bool {
  carriage_is_in_format(
    c: carriage_of(rows: ipc_dpmx_semantic_carriage, semantic: NetlistConnectivity)
  )
    && !carriage_is_in_format(
      c: carriage_of(rows: gerber_semantic_carriage, semantic: NetlistConnectivity)
    )
}

// THE MINIMAL PAIR THE OLD FOLD COULD NOT SEE. Both components are justified as Compute and
// both are labelled a processor; they differ only in the quantity they supply. Under the
// previous tag-matching satisfaction the 127-core part passed a 128-core requirement, because
// the contract's quantity was read when the requirement was authored and discarded when it was
// checked. One core is the smallest specimen that crosses the boundary.
test fn w_cores_requirement_compares_quantity_not_capability_tag() -> Bool {
  !requirement_met(components: [undersized_cpu_component()], r: product.compute_board.intent.ComputeCores { minimum_cores: hardware_thread_count(128) })
    && requirement_met(components: [cpu_component()], r: product.compute_board.intent.ComputeCores { minimum_cores: hardware_thread_count(128) })
}

// The boolean-shaped requirements demand every declared sub-facility, not merely a provision of
// the right kind: a management device with power control and console but no recovery path must
// not satisfy a contract that asked for recovery.
test fn w_management_requirement_demands_every_declared_sub_facility() -> Bool {
  let partial = product.compute_board.composition.ComponentInstance {
    designator: "U2",
    part: "management controller",
    justifications: [product.compute_board.composition.DischargesCapability { capability: Management }],
    provisions: [product.compute_board.composition.ProvidesManagement { power_control: true, console: true, recovery: false }],
  }
  let complete = product.compute_board.composition.ComponentInstance {
    designator: "U2",
    part: "management controller",
    justifications: [product.compute_board.composition.DischargesCapability { capability: Management }],
    provisions: [product.compute_board.composition.ProvidesManagement { power_control: true, console: true, recovery: true }],
  }
  !requirement_met(components: [partial], r: product.compute_board.intent.RemoteManagement { power_control: true, console: true, recovery: true })
    && requirement_met(components: [complete], r: product.compute_board.intent.RemoteManagement { power_control: true, console: true, recovery: true })
}
