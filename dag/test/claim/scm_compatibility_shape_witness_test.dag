module test.claim.scm_compatibility_shape_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

type SyntheticFourthReceipt {
  target: std.types.NonEmptyStr
  generation: std.types.NonEmptyStr
}

fn synthetic_fourth_handler(
) -> gunbc.scm_compatibility_shape.CompatibilityProjectionHandler<SyntheticFourthReceipt> {
  gunbc.scm_compatibility_shape.CompatibilityProjectionHandler {
    project: fn(receipt) {
      gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
        realization: "synthetic-fourth-r0",
        target: receipt.target,
        generation_evidence: receipt.generation,
        projection: concat("synthetic-projection:", receipt.generation),
        read_back: concat("synthetic-readback:", receipt.generation),
        advance: gunbc.scm_compatibility_shape.CompatibilityAdvanceUnavailable {
          cause: "synthetic R0 intentionally has no conditional advance",
        },
        fidelity: gunbc.scm_compatibility_shape.CompatibilityFidelityProfile {
          endpoint_state: gunbc.scm_compatibility_shape.CompatibilityFidelityPreserved,
          upstream_change_evidence: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          native_proposal_contract: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          history: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          publication: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          conflict_facts: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          path_and_mode: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          availability: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
          native_identity: gunbc.scm_compatibility_shape.CompatibilityFidelityUnavailable {
            cause: "synthetic fixture carries endpoint state only",
          },
        },
      }
    },
  }
}

fn synthetic_projection(
  target: std.types.NonEmptyStr,
  generation: std.types.NonEmptyStr,
) -> gunbc.scm_compatibility_shape.CompatibilityProjectionReceipt {
  gunbc.scm_compatibility_shape.compatibility_projection_from_handler(
    handler: synthetic_fourth_handler(),
    receipt: SyntheticFourthReceipt {
      target: target,
      generation: generation,
    },
  )
}

test fn witness_fourth_realization_adds_handler_without_primary_edit() -> Bool {
  let original = test.claim.native_scm_interaction_scenario_fixture.native_scm_receipt_for(
    scenario: test.claim.native_scm_interaction_scenario_fixture.TwoIndependentChangesLand,
  )
  let projected = synthetic_projection(
    target: "main",
    generation: "synthetic-generation-1",
  )
  let attached = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
    receipt: original,
    projection: projected,
  )
  attached.identity == original.identity
    && attached.transition == original.transition
    && attached.primary == original.primary
    && gunbc.native_scm_interaction_contract.native_scm_primary_label(primary: attached.primary) == "Landed"
    && count(attached.projections.realizations) == 1
    && attached.projections.realizations
      |> any(row => row.realization == "synthetic-fourth-r0")
}

test fn witness_projection_attachment_is_idempotent_per_realization_target() -> Bool {
  let original = test.claim.native_scm_interaction_scenario_fixture.native_scm_receipt_for(
    scenario: test.claim.native_scm_interaction_scenario_fixture.TwoIndependentChangesLand,
  )
  let first = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
    receipt: original,
    projection: synthetic_projection(
      target: "main",
      generation: "synthetic-generation-1",
    ),
  )
  let replaced = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
    receipt: first,
    projection: synthetic_projection(
      target: "main",
      generation: "synthetic-generation-2",
    ),
  )
  let second_target = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
    receipt: replaced,
    projection: synthetic_projection(
      target: "review",
      generation: "synthetic-generation-3",
    ),
  )
  count(first.projections.realizations) == 1
    && count(replaced.projections.realizations) == 1
    && replaced.projections.realizations
      |> any(row =>
        row.target == "main"
          && row.generation_evidence == "synthetic-generation-2"
      )
    && count(second_target.projections.realizations) == 2
}

test fn witness_one_c0_fixture_accepts_three_realization_receipts() -> Bool {
  let original = test.claim.native_scm_interaction_scenario_fixture.native_scm_receipt_for(
    scenario: test.claim.native_scm_interaction_scenario_fixture.TwoIndependentChangesLand,
  )
  match test.claim.scm_compatibility_git_witness.git_fixture_binding() {
    gunbc.scm_compatibility.git.GitCompatibilityBindingRefused { cause: _ } => false
    gunbc.scm_compatibility.git.GitCompatibilityBound { receipt: git_receipt } => {
      let git_projection = gunbc.scm_compatibility_shape.compatibility_projection_from_handler(
        handler: gunbc.scm_compatibility.git.git_compatibility_projection_handler(),
        receipt: git_receipt,
      )
      let with_git = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
        receipt: original,
        projection: git_projection,
      )
      match test.claim.scm_compatibility_mercurial_witness.mercurial_fixture_binding() {
        gunbc.scm_compatibility.mercurial.MercurialCompatibilityBindingRefused { cause: _ } => false
        gunbc.scm_compatibility.mercurial.MercurialCompatibilityBound { receipt: mercurial_receipt } => {
          let mercurial_projection = gunbc.scm_compatibility_shape.compatibility_projection_from_handler(
            handler: gunbc.scm_compatibility.mercurial.mercurial_compatibility_projection_handler(),
            receipt: mercurial_receipt,
          )
          let with_mercurial = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
            receipt: with_git,
            projection: mercurial_projection,
          )
          match test.claim.scm_compatibility_pijul_witness.pijul_fixture_binding() {
            gunbc.scm_compatibility.pijul.PijulCompatibilityBindingRefused { cause: _ } => false
            gunbc.scm_compatibility.pijul.PijulCompatibilityBound { receipt: pijul_receipt } => {
              let pijul_projection = gunbc.scm_compatibility_shape.compatibility_projection_from_handler(
                handler: gunbc.scm_compatibility.pijul.pijul_compatibility_projection_handler(),
                receipt: pijul_receipt,
              )
              let with_all = gunbc.native_scm_interaction_contract.native_scm_attach_projection(
                receipt: with_mercurial,
                projection: pijul_projection,
              )
              with_all.identity == original.identity
                && with_all.transition == original.transition
                && with_all.primary == original.primary
                && gunbc.native_scm_interaction_contract.native_scm_primary_label(primary: with_all.primary) == "Landed"
                && count(with_all.projections.realizations) == 3
                && git_projection.realization == "git-r0"
                && git_projection.target == "refs/heads/main"
                && mercurial_projection.realization == "mercurial-r0"
                && mercurial_projection.target == "default"
                && pijul_projection.realization == "pijul-r0"
                && pijul_projection.target == "main"
            }
          }
        }
      }
    }
  }
}

test fn witness_r1_acceptance_contract_holds() -> Bool {
  witness_one_c0_fixture_accepts_three_realization_receipts()
    && test.claim.scm_compatibility_git_witness.witness_git_modeled_advance_refuses_different_guarantee()
    && test.claim.scm_compatibility_mercurial_witness.witness_mercurial_missing_advance_refuses_required_capability()
    && test.claim.scm_compatibility_pijul_witness.witness_pijul_missing_advance_refuses_required_capability()
    && test.claim.scm_compatibility_git_witness.witness_git_readback_mismatch_refuses_binding()
    && witness_fourth_realization_adds_handler_without_primary_edit()
}
