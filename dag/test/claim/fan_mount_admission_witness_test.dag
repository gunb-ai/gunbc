module test.claim.fan_mount_admission_witness_test

import std.types { Bool }
import std.measure { Micrometer, micrometer, micrometer_count }
import extdeps.fans.types { FanMountingPattern, fan_mounting_pattern, ConventionUnverified }
import extdeps.fans.arctic { arctic_p8_mounting_pattern }
import product.printed_chassis.coupon { OpThroughHole }
import product.printed_chassis.fan_mount {
  FanMountAdmission, FanMountAdmitted, FanMountBoreReachesMountingHoles,
  FanMountPlateSmallerThanPattern, FanMountBoreNotEnclosedByPlate, admit_fan_mount,
  arctic_p8_mount_plate_edge, arctic_p8_mount_plate_thickness, arctic_p8_mount_bore,
}

// The pattern under test is the real Arctic P8 one, so a change to the fan's declared geometry moves
// these witnesses rather than leaving them asserting against a private copy of it.
fn thickness() -> Micrometer { micrometer(count: 4000) }

// POSITIVE CONTROL. The shipping numbers admit.
test fn w_the_declared_arctic_mount_is_admitted() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern,
    plate_edge: arctic_p8_mount_plate_edge,
    plate_thickness: arctic_p8_mount_plate_thickness,
    bore_diameter: arctic_p8_mount_bore,
  ) {
    FanMountAdmitted { geometry: g } => true
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}

// The admitted geometry must carry FOUR screw holes plus the bore, not some other count. A refusal
// arm that fired correctly while the accepted arm emitted three holes would still print a bad part.
test fn w_the_admitted_mount_carries_four_screw_holes() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern,
    plate_edge: arctic_p8_mount_plate_edge,
    plate_thickness: arctic_p8_mount_plate_thickness,
    bore_diameter: arctic_p8_mount_bore,
  ) {
    FanMountAdmitted { geometry: g } => length(list: g.mounting_holes) == 4
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}

// DISCRIMINATING RED 1. A bore wide enough to eat the screw holes must refuse rather than be clamped.
//
// THE 92 mm SHIPPING PLATE CANNOT REACH THIS ARM, and that is a fact about the plate rather than a
// missing wall: a bore is capped by the plate edge at 46 mm radius, while the screw circle sits at
// 50.6 mm, so the outer edge is always hit first. The state is nonetheless perfectly authorable as a
// fixture, so the wall is enrolled against one -- a 130 mm plate carrying the same 71.5 mm pattern,
// where a 104 mm bore fits the plate and still reaches the holes.
test fn w_a_bore_that_reaches_the_screw_holes_refuses() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern,
    plate_edge: micrometer(count: 130000),
    plate_thickness: thickness(),
    bore_diameter: micrometer(count: 104000),
  ) {
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } =>
      micrometer_count(m: r) == 52000 && micrometer_count(m: c) == 35750
    FanMountAdmitted { geometry: g } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}

// THE BOUNDARY IS EXACT, AND BOTH SIDES OF IT ARE ASSERTED HERE.
//
// On that same 130 mm fixture plate the bore edge reaches the near edge of a screw hole when
// (bore_radius + 2200)^2 >= 2 * 35750^2. That limit is 2556125000, whose square root is 50558.13, so
// the first REACH that refuses is 50559 and the first bore that refuses is 96718 um; 96716 still
// admits. The one-micrometre pair is the whole point: it pins the wall to a coordinate rather than to
// a neighbourhood, and it is where an off-by-one in the comparison would show up. Asserting only the refusing side would leave a blanket
// refusal of the whole neighbourhood indistinguishable from a wall placed at the right coordinate.
test fn w_the_bore_refusal_is_exactly_at_the_boundary_not_approximate() -> Bool {
  let over = match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern, plate_edge: micrometer(count: 130000),
    plate_thickness: thickness(), bore_diameter: micrometer(count: 96718),
  ) {
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => true
    FanMountAdmitted { geometry: g } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
  let under = match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern, plate_edge: micrometer(count: 130000),
    plate_thickness: thickness(), bore_diameter: micrometer(count: 96716),
  ) {
    FanMountAdmitted { geometry: g } => true
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
  over && under
}

// THE REGRESSION CONTROL FOR THE AXIS-OFFSET DEFECT.
//
// The shipping 76 mm bore must ADMIT. An implementation that compares the bore radius against the
// axis offset (35750) instead of the corner distance (50558) refuses it, which is exactly what the
// first form of this check did. This witness is the one that caught it and it stays enrolled.
test fn w_the_shipping_bore_is_measured_against_the_corner_not_the_axis() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern, plate_edge: arctic_p8_mount_plate_edge,
    plate_thickness: thickness(), bore_diameter: micrometer(count: 76000),
  ) {
    FanMountAdmitted { geometry: g } => true
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}

// A bore wider than the plate refuses on its own arm rather than being reported as screw-hole
// interference, so the author is told which edge they actually hit.
test fn w_a_bore_not_enclosed_by_the_plate_refuses_on_its_own_arm() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern, plate_edge: arctic_p8_mount_plate_edge,
    plate_thickness: thickness(), bore_diameter: micrometer(count: 95000),
  ) {
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } =>
      micrometer_count(m: bd) == 95000 && micrometer_count(m: pe) == 92000
    FanMountAdmitted { geometry: g } => false
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
  }
}

// DISCRIMINATING RED 2. A plate too small to hold the pattern refuses, and says what it needed.
// Required edge is pitch + one clearance diameter = 71500 + 4400 = 75900 um.
test fn w_a_plate_smaller_than_the_pattern_refuses() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern,
    plate_edge: micrometer(count: 60000),
    plate_thickness: thickness(),
    bore_diameter: micrometer(count: 40000),
  ) {
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } =>
      micrometer_count(m: e) == 60000 && micrometer_count(m: n) == 75900
    FanMountAdmitted { geometry: g } => false
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}

// ORDER OF REFUSAL. The plate check is decided BEFORE either bore check, because a plate that cannot
// hold the pattern has no meaningful screw circle to measure a bore against. This 60 mm plate with a
// 70 mm bore violates all three conditions at once, and must report the plate -- the one an author
// can act on first.
test fn w_a_plate_too_small_reports_the_plate_not_the_bore() -> Bool {
  match admit_fan_mount(
    pattern: arctic_p8_mounting_pattern,
    plate_edge: micrometer(count: 60000),
    plate_thickness: thickness(),
    bore_diameter: micrometer(count: 70000),
  ) {
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => true
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
    FanMountAdmitted { geometry: g } => false
  }
}

// Plate centre is 46000 um; a 50000 um pitch puts the first hole at 46000 - 25000 = 21000 on both
// axes. The holes must be placed from the PATTERN, not from the plate. A foreign pattern with a
// different pitch must move them; if the implementation centred them on the plate by a constant
// instead of deriving the offset, this goes red.
test fn w_the_screw_holes_follow_the_pattern_not_the_plate() -> Bool {
  let narrow = fan_mounting_pattern(
    frame_edge: micrometer(count: 60000),
    hole_pitch: micrometer(count: 50000),
    hole_clearance_diameter: micrometer(count: 4400),
    evidence: ConventionUnverified { convention: "fixture pattern, not a real fan" },
  )
  match admit_fan_mount(
    pattern: narrow, plate_edge: arctic_p8_mount_plate_edge,
    plate_thickness: thickness(), bore_diameter: micrometer(count: 40000),
  ) {
    FanMountAdmitted { geometry: g } => match g.mounting_holes.first() {
      Present { value: h } => match h {
        OpThroughHole { diameter: d, center_x: cx, center_y: cy } =>
          micrometer_count(m: cx) == 21000 && micrometer_count(m: cy) == 21000
      }
      Absent => false
    }
    FanMountBoreReachesMountingHoles { bore_radius: r, hole_center_distance: c } => false
    FanMountPlateSmallerThanPattern { plate_edge: e, required_edge: n } => false
    FanMountBoreNotEnclosedByPlate { bore_diameter: bd, plate_edge: pe } => false
  }
}
