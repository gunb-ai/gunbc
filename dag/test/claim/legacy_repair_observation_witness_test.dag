    compiler_artifact_digest: base.compiler_artifact_digest,
    repairer_identity: decl_field_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceId", field_name: "value"),
    repair_site_roster_digest: base.repair_site_roster_digest,
    resolution_registry_digest: base.resolution_registry_digest
  }) == "repairer_identity.field"
