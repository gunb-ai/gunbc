test fn a_moved_repairer_decl_refuses() -> Bool {
  let base = lro_base_subject()
  lro_diverged_field(other: LegacyRepairObservationSubject {
    semantic_source_digest: base.semantic_source_digest,
    source_set_digest: base.source_set_digest,
    compiler_artifact_digest: base.compiler_artifact_digest,
    repairer_identity: decl_ref(module_path: "std.occurrence_identity", decl_name: "OccurrenceIndex"),
    repair_site_roster_digest: base.repair_site_roster_digest,
    resolution_registry_digest: base.resolution_registry_digest
  }) == "repairer_identity.decl_name"
