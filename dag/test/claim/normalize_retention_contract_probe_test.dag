module gunbc.test.claim.normalize_retention_contract_probe_test

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.node { Symbol }
import v2.std.collection { List }
import v2.std.algebra { fold_list }
import v2.std.diagnostic { NonEmptyDiagnostics, module_unavailable_diagnostic }
import gunbc.tools.frontier_ingestion_probe {
  FrontendStage,
  MemberObservation,
  LexRefused,
  ParseRefused,
  NormalizeAccepted,
  NormalizeGraftRefused,
  NormalizeRetained,
  NormalizeOther,
  classify_normalize_diagnostics,
  classify_source,
  frontend_stage_eq,
  frontend_stage_label,
  frontier_roster,
  census_is_complete,
  reasons_contain,
}

data permanent_witness_scope_note: String = "WHAT THIS WITNESS MAY ASSERT, and why the live-corpus rows are NOT here. A required witness whose success depends on the current defects continuing to exist inverts the moment the defect is repaired: it would go RED on the repair and GREEN on a regression. So the assertions below validate the STAGE CLASSIFIER, the containment-read discipline, and the roster join on specimens whose stage is a property of the specimen rather than of the frontier. The per-member live population is a revision-scoped OBSERVATION recorded in docs/plans/v2-frontend-std-ingestion-frontier-exact-head.md and reproducible from gunbc.tools.frontier_ingestion_probe, which is deliberately NOT a test module for exactly this reason. Every classifier and roster symbol is imported from that one authority rather than restated here, so the thing under test and the thing used for measurement cannot drift apart."

data stage_separation_cost_note: String = "WHY TWO STAGE-SEPARATION CLAIMS ARE NOT HERE, stated rather than hidden. classify_source reaching parse_module builds dag_grammar(), and that construction alone measured 5002-5003ms thread-CPU against the 5000ms fast-lane budget on CI — so an ACCEPTED claim and a PARSE claim cannot execute per-PR, while the LEX claim below can, because a lex refusal returns before any grammar is built.\n\nThey are DELETED, not relocated. Moving them under a long/ directory would remove them from per-PR discovery without giving them an executing consumer, which deletes the coverage while retaining the source — the gunbc#7762 specimen the 2026-08-04 admission ruling exists to forbid. Nothing here claims those two stages are covered.\n\nWHAT IS OWED, and to which lane: the 15-member census needs a batched or realized instrument precisely because the interpreted path also exceeds budget on the larger members. Closing the result space and making completeness a join (this increment) does not discharge that; it only means the instrument those two claims return to now has a total verdict type and a denominator to join against."

data empty_reason_set_control_retirement_note: String = "WHERE THE EMPTY-REASON-SET RED WENT. A previous revision asserted classify_normalize_reasons(rs: []) == NORM_REASON_SET_INVALID_EMPTY, guarding the collapse in which a missing observation reads as an accepted stage. The classifier now takes NonEmptyDiagnostics, whose head field is not optional, so that input has no representation and the arm it exercised has no subject.\n\nThis is the one case where the dissolution rule's keep-the-evidence clause does not apply, and the distinction is worth being exact about: the rule preserves a discriminating control when the invalid state stays WRITABLE and a mechanism keeps it out. Here the state became unwritable, so the control cannot be authored at all — not because it was judged redundant, but because it has no input. Retaining it would require re-widening the parameter type to admit the value it tests, which is the wall itself run backwards. The class did not stop being guarded; it stopped being expressible."

data unterminated_string_source: String = "module frontier_probe\n\ndata d: String = \"unterminated\n"

// The specimen is built at the NonEmptyDiagnostics shape rather than from a List<Symbol> that
// some helper then splits: a helper taking a list would have to answer for the empty one, which
// is the state this increment just made unrepresentable. The head is passed separately because
// the carrier separates it.
fn classify_reasons(first: Symbol, rest: List<Symbol>) -> FrontendStage {
  classify_normalize_diagnostics(
    d: NonEmptyDiagnostics {
      head: module_unavailable_diagnostic(reason: first, module_file: ^frontier_probe),
      tail: fold_list(xs: rest, empty: [], cons: fn(acc, r) {
        concat(acc, [module_unavailable_diagnostic(reason: r, module_file: ^frontier_probe)])
      }),
    }
  )
}


test fn classifier_separates_lex_from_accepted() -> Bool {
  frontend_stage_eq(a: classify_source(source: unterminated_string_source), b: LexRefused)
}


// The normalize classifier is exercised DIRECTLY. Testing reasons_contain alone would not stop
// classify_normalize_diagnostics reverting to a head read: each pair below puts an unrelated
// diagnostic FIRST, so a head read returns the wrong verdict while a containment read does not.
test fn classifier_reads_graft_refusal_behind_a_prepended_diagnostic() -> Bool {
  frontend_stage_eq(
    a: classify_reasons(
      first: ^body_lowering_reason_wrapper_retained_emitted,
      rest: [^namespace_graft_body_dissolved_refused]
    ),
    b: NormalizeGraftRefused
  )
}

test fn classifier_reads_retention_pair_behind_a_prepended_diagnostic() -> Bool {
  frontend_stage_eq(
    a: classify_reasons(
      first: ^body_lowering_reason_unsupported_form,
      rest: [
        ^body_lowering_reason_wrapper_retained_emitted,
        ^normalize_reason_post_normalize_not_well_formed
      ]
    ),
    b: NormalizeRetained
  )
}

test fn classifier_calls_a_plain_rejection_other() -> Bool {
  frontend_stage_eq(
    a: classify_reasons(first: ^body_lowering_reason_unsupported_form, rest: []),
    b: NormalizeOther
  )
}

test fn classifier_does_not_call_retention_alone_retained_RED() -> Bool {
  frontend_stage_eq(
    a: classify_reasons(first: ^body_lowering_reason_wrapper_retained_emitted, rest: []),
    b: NormalizeOther
  )
}


test fn containment_read_finds_reason_behind_prepended_carrier() -> Bool {
  reasons_contain(
    reasons: [
      ^body_lowering_reason_wrapper_retained_emitted,
      ^normalize_reason_post_normalize_not_well_formed
    ],
    sym: ^normalize_reason_post_normalize_not_well_formed
  )
}

test fn containment_read_refuses_absent_reason_RED() -> Bool {
  reasons_contain(
    reasons: [^body_lowering_reason_wrapper_retained_emitted],
    sym: ^normalize_reason_post_normalize_not_well_formed
  ) == false
}


// Every stage renders to a distinct label. frontend_stage_eq is defined over the label, so a
// collision would silently make two stages compare equal and every classifier claim above would
// hold for the wrong reason.
test fn stage_labels_are_pairwise_distinct() -> Bool {
  let labels = [
    frontend_stage_label(s: LexRefused),
    frontend_stage_label(s: ParseRefused),
    frontend_stage_label(s: NormalizeGraftRefused),
    frontend_stage_label(s: NormalizeRetained),
    frontend_stage_label(s: NormalizeOther),
    frontend_stage_label(s: NormalizeAccepted),
  ]
  fold_list(xs: labels, empty: true, cons: fn(acc, l) {
    acc && ((fold_list(xs: labels, empty: 0, cons: fn(n, m) {
      if l == m { n + 1 } else { n }
    })) == 1)
  })
}


// The roster join, exercised on SYNTHETIC observations so it never reads the live tree. The
// discriminating half is the second claim: a census that observed every member but one must be
// incomplete, and a count comparison would not catch it once a sixteenth stray observation
// existed. Dropping exactly one roster label is the smallest input that separates the two.
fn observations_for_whole_roster() -> List<MemberObservation> {
  fold_list(xs: frontier_roster, empty: [], cons: fn(acc, m) {
    concat(acc, [MemberObservation { label: m.label, stage: NormalizeOther }])
  })
}

fn observations_missing_one() -> List<MemberObservation> {
  fold_list(xs: frontier_roster, empty: [], cons: fn(acc, m) {
    if m.label == ^entry {
      acc
    } else {
      concat(acc, [MemberObservation { label: m.label, stage: NormalizeOther }])
    }
  })
}

test fn census_over_the_whole_roster_is_complete() -> Bool {
  census_is_complete(obs: observations_for_whole_roster())
}

test fn census_missing_one_member_is_incomplete_RED() -> Bool {
  census_is_complete(obs: observations_missing_one()) == false
}

// A count equality would accept this: fifteen observations, none of them a roster member.
test fn census_of_the_right_size_but_wrong_members_is_incomplete_RED() -> Bool {
  let wrong = fold_list(xs: frontier_roster, empty: [], cons: fn(acc, m) {
    concat(acc, [MemberObservation { label: ^not_a_roster_member, stage: NormalizeOther }])
  })
  census_is_complete(obs: wrong) == false
}
