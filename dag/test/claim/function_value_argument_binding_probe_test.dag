module test.claim.function_value_argument_binding_probe

import std.types { Bool, String, List, Int }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.fabric_cell_converge { FabricCellResourceAddress, FabricCellRootAddress, FabricCellAttemptRootAddress, FabricCellResourceBoundaryAddress }

// ROUTED, BECAUSE AN UNROUTED WITNESS IS DISCOVERED AND NEVER RUN. A module declaring no live-tree
// disposition defaults to ReadsLiveTree, and the required floor declines those before the fold sees
// them -- offered, counted, never executed. Every row here reads only values the fixture authors.
data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A FUNCTION'S OWN PARAMETER IS SHADOWED BY A SYMBOL THE MODULE NEVER ASKED FOR, and the whole
// content of this file is the pair of arms that shows it. Two functions differ in ONE token -- the
// name of a parameter -- and return different answers over the same input, the same predicate and
// the same fold.
//
// THIS FILE IS THE SECOND ATTEMPT AND THE FIRST ONE'S ERROR IS RECORDED HERE RATHER THAN DELETED.
// It originally reported the discriminator as "the element type is declared in another module",
// built from a table of five passing arms and one failing one. That table was WRONG: the five arms
// were executed BEFORE the `gunbc.fabric_cell_converge` import was added to the file, and re-running
// them afterwards fails every one. A measurement taken against an earlier state of the same file,
// carried forward as if still current, is the stale-measurement class -- and it is worth an
// annotation because the wrong conclusion was more interesting than the right one, which is exactly
// when nobody re-checks.
//
// THE COLLISION IS SILENT ONLY WHEN THE ARITIES MATCH, established by a second specimen rather
// than reasoned: in `test.claim.fabric_cell_evidence_algebra_witness` a parameter named `project`
// collided with a module-scope `fn project` of TWO arguments, and the call REFUSED loudly with
// `call contract mismatch calling 'project': missing required argument 'assignments'`. Here `p`
// takes one argument and the shadowing `p` takes one, so nothing refuses and a wrong value is
// returned. Same defect; the arity alone decides whether anyone finds out, which is why the loud
// specimen is named here rather than left in its own PR.
//
// NO MECHANISM IS ASSERTED, AND THE READ THAT SUGGESTS ONE IS MARKED AS A READ. What is EXECUTED is
// below. What is READ, not executed: the emitted Rust for this module carries
// `pub use crate::gunbc_plans_md_helpers::{p};`, and `gunbc.plans.md_helpers` declares
// `fn p(text: String) -> MarkdownBlock`. This module does not import that symbol; it arrives
// through a re-export chain. That reading is CONSISTENT with the predicate being constantly true
// rather than merely wrong -- a non-Bool in a condition would have to be truthy -- but nothing here
// proves the value reaching the condition is that MarkdownBlock, so nothing here says it does.

fn probe_address_is_root(a: FabricCellResourceAddress) -> Bool {
  match a {
    FabricCellRootAddress => true
    FabricCellAttemptRootAddress => false
    FabricCellResourceBoundaryAddress => false
  }
}

fn probe_addresses() -> List<FabricCellResourceAddress> {
  [FabricCellRootAddress, FabricCellRootAddress, FabricCellResourceBoundaryAddress]
}

fn probe_ints() -> List<Int> {
  [2, 2, 3]
}

fn probe_int_is_two(n: Int) -> Bool {
  n == 2
}

// THE ORACLES, ASSERTED AGAINST LITERALS THE FIXTURE AUTHORS. Two roots in three addresses, two
// twos in three ints. Without these the disagreements below could be read as the direct folds being
// wrong.
fn probe_count_roots_direct(items: List<FabricCellResourceAddress>) -> Int {
  fold(items, init: 0, f: (acc, a) => if probe_address_is_root(a: a) { acc + 1 } else { acc })
}

fn probe_count_twos_direct(items: List<Int>) -> Int {
  fold(items, init: 0, f: (acc, n) => if probe_int_is_two(n: n) { acc + 1 } else { acc })
}

test fn probe_direct_folds_count_two_and_two() -> Bool {
  probe_count_roots_direct(items: probe_addresses()) == 2 && probe_count_twos_direct(items: probe_ints()) == 2
}

// THE PAIR. `probe_count_addresses_via_p` and `probe_count_addresses_via_pred` are the same
// function with the parameter renamed, and nothing else differs -- not the signature shape, not the
// body, not the call, not the input.
fn probe_count_addresses_via_p(items: List<FabricCellResourceAddress>, p: fn(FabricCellResourceAddress) -> Bool) -> Int {
  fold(items, init: 0, f: (acc, a) => if p(a) { acc + 1 } else { acc })
}

fn probe_count_addresses_via_pred(items: List<FabricCellResourceAddress>, pred: fn(FabricCellResourceAddress) -> Bool) -> Int {
  fold(items, init: 0, f: (acc, a) => if pred(a) { acc + 1 } else { acc })
}

fn probe_count_ints_via_p(items: List<Int>, p: fn(Int) -> Bool) -> Int {
  fold(items, init: 0, f: (acc, n) => if p(n) { acc + 1 } else { acc })
}

fn probe_count_ints_via_pred(items: List<Int>, pred: fn(Int) -> Bool) -> Int {
  fold(items, init: 0, f: (acc, n) => if pred(n) { acc + 1 } else { acc })
}

// THE CONTROL ARMS, GREEN. The renamed parameter agrees with its direct oracle at both element
// types. These are what make the red arms below a statement about the NAME rather than about
// function-valued parameters, which are sound.
test fn probe_renamed_parameter_agrees_with_direct_fold_over_addresses() -> Bool {
  probe_count_addresses_via_pred(items: probe_addresses(), pred: probe_address_is_root) == 2
}

test fn probe_renamed_parameter_agrees_with_direct_fold_over_ints() -> Bool {
  probe_count_ints_via_pred(items: probe_ints(), pred: probe_int_is_two) == 2
}

// THE RED ARMS, ENROLLED. Both are the desired law -- the parameter reaches the call site it was
// written for -- asserted in the direction we want it to hold, so each turns GREEN on the commit
// that fixes this and its enrollment goes stale loudly. Neither asserts the defect: a row claiming
// the wrong answer would go red when the defect is repaired and invite the next reader to restore
// it.
//
// MEASURED VALUE, RECORDED HERE RATHER THAN ASSERTED BY A ROW: the parameterized fold returns
// THREE over both three-element lists, where the direct folds return two. The predicate is not
// merely wrong, it is constantly true. The element type does not matter -- Int and an imported
// coproduct behave identically, which is what refutes the first attempt's conclusion.
test fn probe_parameter_named_p_agrees_with_direct_fold_over_addresses() -> Bool {
  probe_count_addresses_via_p(items: probe_addresses(), p: probe_address_is_root) == 2
}

test fn probe_parameter_named_p_agrees_with_direct_fold_over_ints() -> Bool {
  probe_count_ints_via_p(items: probe_ints(), p: probe_int_is_two) == 2
}

// THE VALUE IS THE AXIS, NOT THE BINDING FORM, AND THESE ARMS COMPLETE THE MATRIX. calm-boar-150
// reached this defect independently from fifteen runtime-erroring floor witnesses, first reported
// it as "a local binding of ANY form loses to a module-level free function", then retracted that:
// their three original arms all bound the local to a NAMED top-level function, so they varied the
// form while holding the value constant and read the wrong variable as the cause. Their corrected
// A/B shows a local bound to a LAMBDA wins and a local bound to a named function loses, in both
// `let` and parameter position.
//
// TWO CELLS WERE STILL UNMEASURED WHEN THAT WAS RELAYED, AND ASSERTING SYMMETRY ACROSS THEM WOULD
// HAVE BEEN THE SAME ERROR ONE TURN LATER: parameter was measured on the named side only, and
// PATTERN on neither. Both are now executed, so the matrix is complete -- three binding forms by
// two values, six cells, no cell inferred from another:
//
//   binding form   value = named top-level fn   value = lambda
//   let            wrong (calm-boar-150)        correct (calm-boar-150)
//   parameter      wrong                        correct
//   pattern        wrong                        correct
//
// The value decides and the form does not, and that is now established rather than probable.
type ProbePredicateCarrier { p: fn(Int) -> Bool }

fn probe_carrier() -> ProbePredicateCarrier {
  ProbePredicateCarrier { p: probe_int_is_two }
}

type ProbeLambdaCarrier { p: fn(Int) -> Bool }

fn probe_lambda_carrier() -> ProbeLambdaCarrier {
  ProbeLambdaCarrier { p: n => probe_int_is_two(n: n) }
}

// THE COLLISION IS DECIDED AT THE CALL SITE BY THE NAME USED THERE, and the first version of these
// two rows failed to test anything because of it. They bound the field to `p` in a pattern and then
// handed it to a helper whose own parameter is `pred` -- so the call inside the helper spelled
// `pred`, no name collided, and the row passed while measuring nothing. The call must be written in
// the scope where the shadowed name IS the local, which is what these do.
//
// PATTERN-BOUND, VALUE = A NAMED TOP-LEVEL FUNCTION, CALLED AS `p` IN THE ARM. The desired law: the
// field the pattern bound is what the call reaches.
test fn probe_pattern_bound_named_function_is_what_the_call_reaches() -> Bool {
  match probe_carrier() {
    ProbePredicateCarrier { p: p } => p(2) && !p(3)
  }
}

// PATTERN-BOUND, VALUE = A LAMBDA, CALLED AS `p` IN THE ARM. The control on the other side of the
// value axis: if this passes while the row above fails, the value decides and the pattern form is
// no different from `let` and parameter.
test fn probe_pattern_bound_lambda_is_what_the_call_reaches() -> Bool {
  match probe_lambda_carrier() {
    ProbeLambdaCarrier { p: p } => p(2) && !p(3)
  }
}

// PARAMETER-BOUND, VALUE = A LAMBDA. Re-added as a durable control: it was measured green here
// before the restructure, and it is one of the two cells that were being asserted rather than run.
test fn probe_parameter_bound_lambda_agrees_with_direct_fold() -> Bool {
  probe_count_ints_via_p(items: probe_ints(), p: n => probe_int_is_two(n: n)) == 2
}
