module test.claim.falsifier_run_control_witness_test


data falsifier_run_control_witness_note: String = "F0 executing consumer (operator mandate 2026-08-04): cold controls must use always()+release_build prerequisite, not default success(). Verified defect on run 30935833427 where steps 13-14 were SKIPPED while step 12 receipt upload PASSED. The closed control-role roster must enumerate exactly three roles so a control cannot silently vanish."

test fn falsifier_required_control_roles_is_closed_population_of_three() -> Bool {
  count(xs: falsifier_required_control_roles) == 3
    && falsifier_required_control_roles[0] == AffectedSetPredictOnlyCold
    && falsifier_required_control_roles[1] == CompileCleanWholeTreeCold
    && falsifier_required_control_roles[2] == NativeCacheCold
}

test fn falsifier_cold_controls_use_prerequisite_if_not_default_success() -> Bool {
  match compile_clean_cold_control_step() {
    RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: cc, continue_on_error: _, timeout_minutes: _ } =>
      match native_cache_cold_control_step() {
        RunStep { name: _, id: _, run: _, shell: _, env: _, working_directory: _, if_condition: nc, continue_on_error: _, timeout_minutes: _ } =>
          match cc {
            Present { value: s } =>
              (s == falsifier_control_prerequisite_if)
                && match nc {
                  Present { value: s2 } => s2 == falsifier_control_prerequisite_if
                  _ => false
                }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn falsifier_yml_cold_controls_carry_prerequisite_if() -> Bool {
  string_contains(s: expected_falsifier_yml(), pattern: falsifier_control_prerequisite_if)
    && string_contains(s: expected_falsifier_yml(), pattern: "release_build")
}

test fn falsifier_prerequisite_if_discriminates_from_bare_always() -> Bool {
  falsifier_control_prerequisite_if != "always()"
    && string_contains(s: falsifier_control_prerequisite_if, pattern: "release_bins")
}

test fn falsifier_prerequisite_if_cites_same_job_step() -> Bool {
  !string_contains(s: falsifier_control_prerequisite_if, pattern: "release_build")
    && string_contains(s: falsifier_control_prerequisite_if, pattern: "steps.release_bins.outcome")
}

test fn falsifier_execution_proof_note_states_the_real_acceptance_gate() -> Bool {
  string_contains(s: falsifier_control_prerequisite_execution_proof_note, pattern: "condition SHAPE")
    && string_contains(s: falsifier_control_prerequisite_execution_proof_note, pattern: "never 'skipped'")
    && string_contains(s: falsifier_control_prerequisite_execution_proof_note, pattern: "not entitled to be declared done at merge time")
}
