module test.claim.temporal_effect_spine

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data witness_intent_hash: std.content_hash.ContentHash = content_hash_of_value(value: "temporal-spine-witness-intent-v1" as std.types.NonEmptyStr)
data witness_escalation_id: std.types.NonEmptyStr = "srv3-boot-once-cd" as std.types.NonEmptyStr
data witness_observed_at: std.types.Timestamp = "2026-07-02T23:05:00Z"

data witness_intent: std.temporal_effect.EffectAttemptIntent = std.temporal_effect.EffectAttemptIntent {
  attempt_id: "attempt-witness-1" as std.types.NonEmptyStr,
  intent_hash: witness_intent_hash,
  target: "srv3" as std.types.NonEmptyStr,
  created_at: "2026-07-02T23:00:00Z",
}

data witness_step_boot: std.types.NonEmptyStr = "boot-once-cd" as std.types.NonEmptyStr
data witness_step_serve: std.types.NonEmptyStr = "nbd-serve" as std.types.NonEmptyStr

data witness_lease_key: std.types.NonEmptyStr = "srv3-nbd-proxy-10809" as std.types.NonEmptyStr

data foreign_lease: std.temporal_effect.HeldLease = held_lease(
  epoch: std.temporal_effect.LeaseEpoch {
    lease_key: witness_lease_key,
    resource_fingerprint: content_hash_of_value(value: "seeded-iso-fp" as std.types.NonEmptyStr),
    owner_fingerprint: content_hash_of_value(value: "foreign-owner" as std.types.NonEmptyStr),
    generation: 1,
  },
  observed: LeasePortForeign,
)

data stale_lease: std.temporal_effect.HeldLease = held_lease(
  epoch: std.temporal_effect.LeaseEpoch {
    lease_key: witness_lease_key,
    resource_fingerprint: content_hash_of_value(value: "seeded-iso-fp" as std.types.NonEmptyStr),
    owner_fingerprint: content_hash_of_value(value: "expected-owner" as std.types.NonEmptyStr),
    generation: 2,
  },
  observed: LeaseRunningStale,
)

data expected_lease: std.temporal_effect.HeldLease = held_lease(
  epoch: std.temporal_effect.LeaseEpoch {
    lease_key: witness_lease_key,
    resource_fingerprint: content_hash_of_value(value: "seeded-iso-fp" as std.types.NonEmptyStr),
    owner_fingerprint: content_hash_of_value(value: "expected-owner" as std.types.NonEmptyStr),
    generation: 3,
  },
  observed: LeaseRunningExpected,
)

data absent_lease: std.temporal_effect.HeldLease = held_lease(
  epoch: std.temporal_effect.LeaseEpoch {
    lease_key: witness_lease_key,
    resource_fingerprint: content_hash_of_value(value: "seeded-iso-fp" as std.types.NonEmptyStr),
    owner_fingerprint: content_hash_of_value(value: "no-owner" as std.types.NonEmptyStr),
    generation: 0,
  },
  observed: LeaseAbsent,
)

fn converged_serve_receipt() -> std.temporal_effect.EffectStepReceipt {
  std.temporal_effect.EffectStepReceipt {
    attempt_id: witness_intent.attempt_id,
    step_id: witness_step_serve,
    observation_digest: content_hash_of_value(value: "obs" as std.types.NonEmptyStr),
    verdict_label: "Converged" as std.types.NonEmptyStr,
    plan_label: "Noop" as std.types.NonEmptyStr,
    applied: std.temporal_effect.EffectApplied { effect_id: "nbd-serve-effect-1" as std.types.NonEmptyStr },
    read_back_ok: true,
    recorded_at: "2026-07-02T23:02:00Z",
  }
}

test fn missing_approval_awaits_not_apply() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_boot,
    requires_destructive_approval: true,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: expected_lease,
    prior: NoPriorReceipt,
    observed_at: witness_observed_at,
  ) {
    PlanAwaitApproval { escalation_id: eid } => eid == witness_escalation_id
    _ => false
  }
}

test fn foreign_lease_refuses_not_drain() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: foreign_lease,
    prior: NoPriorReceipt,
    observed_at: witness_observed_at,
  ) {
    PlanRefuse { step_id: _, reason: _ } => true
    PlanDrainThenStart { step_id: _, lease_key: _ } => false
    _ => false
  }
}

test fn stale_lease_drains_not_blind_start() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: stale_lease,
    prior: NoPriorReceipt,
    observed_at: witness_observed_at,
  ) {
    PlanDrainThenStart { step_id: sid, lease_key: lk } =>
      sid == witness_step_serve && lk == witness_lease_key
    PlanApply { step_id: _ } => false
    _ => false
  }
}

test fn converged_receipt_stale_lease_drains_not_noop() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: stale_lease,
    prior: std.temporal_effect.PriorReceipt { receipt: converged_serve_receipt() },
    observed_at: witness_observed_at,
  ) {
    PlanDrainThenStart { step_id: sid, lease_key: lk } =>
      sid == witness_step_serve && lk == witness_lease_key
    PlanNoop { step_id: _ } => false
    _ => false
  }
}

test fn applied_without_read_back_refuses() -> Bool {
  let bad_receipt = std.temporal_effect.EffectStepReceipt {
    attempt_id: witness_intent.attempt_id,
    step_id: witness_step_serve,
    observation_digest: content_hash_of_value(value: "obs" as std.types.NonEmptyStr),
    verdict_label: "Stale" as std.types.NonEmptyStr,
    plan_label: "Apply" as std.types.NonEmptyStr,
    applied: std.temporal_effect.EffectApplied { effect_id: "nbd-serve-effect-1" as std.types.NonEmptyStr },
    read_back_ok: false,
    recorded_at: "2026-07-02T23:01:00Z",
  }
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: expected_lease,
    prior: std.temporal_effect.PriorReceipt { receipt: bad_receipt },
    observed_at: witness_observed_at,
  ) {
    PlanRefuse { step_id: _, reason: r } => string_contains(s: r, pattern: "read-back")
    _ => false
  }
}

test fn converged_receipt_expected_lease_yields_noop() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: expected_lease,
    prior: std.temporal_effect.PriorReceipt { receipt: converged_serve_receipt() },
    observed_at: witness_observed_at,
  ) {
    PlanNoop { step_id: sid } => sid == witness_step_serve
    _ => false
  }
}

test fn active_grant_covers_matching_intent() -> Bool {
  approval_grant_covers_intent(
    grant: std.temporal_effect.GrantActive {
      escalation_id: witness_escalation_id,
      intent_hash: witness_intent_hash,
      granted_by: "operator" as std.types.NonEmptyStr,
      granted_at: "2026-07-02T23:00:00Z",
      expires_at: "2026-07-03T23:00:00Z",
    },
    intent: witness_intent,
    escalation_id: witness_escalation_id,
    observed_at: witness_observed_at,
  )
}

test fn expired_grant_does_not_authorize_destructive() -> Bool {
  !approval_grant_covers_intent(
    grant: std.temporal_effect.GrantActive {
      escalation_id: witness_escalation_id,
      intent_hash: witness_intent_hash,
      granted_by: "operator" as std.types.NonEmptyStr,
      granted_at: "2026-07-02T22:00:00Z",
      expires_at: "2026-07-02T23:00:00Z",
    },
    intent: witness_intent,
    escalation_id: witness_escalation_id,
    observed_at: witness_observed_at,
  )
    && match plan_next_step_from_prior_receipt_and_lease(
      intent: witness_intent,
      pending_step_id: witness_step_boot,
      requires_destructive_approval: true,
      escalation_id: witness_escalation_id,
      grant: std.temporal_effect.GrantActive {
        escalation_id: witness_escalation_id,
        intent_hash: witness_intent_hash,
        granted_by: "operator" as std.types.NonEmptyStr,
        granted_at: "2026-07-02T22:00:00Z",
        expires_at: "2026-07-02T23:00:00Z",
      },
      lease: expected_lease,
      prior: NoPriorReceipt,
      observed_at: witness_observed_at,
    ) {
      PlanAwaitApproval { escalation_id: _ } => true
      PlanApply { step_id: _ } => false
      _ => false
    }
}

test fn derived_cursor_uses_last_receipt_step() -> Bool {
  let receipts = [
    std.temporal_effect.EffectStepReceipt {
      attempt_id: witness_intent.attempt_id,
      step_id: "toolchain-ensure" as std.types.NonEmptyStr,
      observation_digest: content_hash_of_value(value: "a" as std.types.NonEmptyStr),
      verdict_label: "Converged" as std.types.NonEmptyStr,
      plan_label: "Noop" as std.types.NonEmptyStr,
      applied: NoEffectApplied,
      read_back_ok: true,
      recorded_at: "2026-07-02T22:58:00Z",
    },
    std.temporal_effect.EffectStepReceipt {
      attempt_id: witness_intent.attempt_id,
      step_id: witness_step_serve,
      observation_digest: content_hash_of_value(value: "b" as std.types.NonEmptyStr),
      verdict_label: "Stale" as std.types.NonEmptyStr,
      plan_label: "DrainThenStart" as std.types.NonEmptyStr,
      applied: NoEffectApplied,
      read_back_ok: false,
      recorded_at: "2026-07-02T22:59:00Z",
    },
  ]
  let pending = derived_pending_step_id(
    receipts: receipts,
    default_step: "toolchain-ensure" as std.types.NonEmptyStr,
  )
  pending == witness_step_serve
    && match prior_receipt_for_step(receipts: receipts, step_id: witness_step_serve) {
      PriorReceipt { receipt: r } => r.step_id == witness_step_serve
      _ => false
    }
}

test fn consumed_grant_does_not_authorize_destructive() -> Bool {
  !approval_grant_covers_intent(
    grant: std.temporal_effect.GrantConsumed {
      escalation_id: witness_escalation_id,
      intent_hash: witness_intent_hash,
      consumed_by_step: witness_step_boot,
    },
    intent: witness_intent,
    escalation_id: witness_escalation_id,
    observed_at: witness_observed_at,
  )
    && match plan_next_step_from_prior_receipt_and_lease(
      intent: witness_intent,
      pending_step_id: witness_step_boot,
      requires_destructive_approval: true,
      escalation_id: witness_escalation_id,
      grant: std.temporal_effect.GrantConsumed {
        escalation_id: witness_escalation_id,
        intent_hash: witness_intent_hash,
        consumed_by_step: witness_step_boot,
      },
      lease: expected_lease,
      prior: NoPriorReceipt,
      observed_at: witness_observed_at,
    ) {
      PlanAwaitApproval { escalation_id: _ } => true
      PlanApply { step_id: _ } => false
      _ => false
    }
}

test fn absent_lease_plans_apply_when_no_prior_receipt() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: absent_lease,
    prior: NoPriorReceipt,
    observed_at: witness_observed_at,
  ) {
    PlanApply { step_id: sid } => sid == witness_step_serve
    _ => false
  }
}

test fn inaccessible_lease_refuses() -> Bool {
  match plan_next_step_from_prior_receipt_and_lease(
    intent: witness_intent,
    pending_step_id: witness_step_serve,
    requires_destructive_approval: false,
    escalation_id: witness_escalation_id,
    grant: std.temporal_effect.GrantAbsent,
    lease: held_lease(
      epoch: std.temporal_effect.LeaseEpoch {
        lease_key: witness_lease_key,
        resource_fingerprint: content_hash_of_value(value: "seeded-iso-fp" as std.types.NonEmptyStr),
        owner_fingerprint: content_hash_of_value(value: "no-owner" as std.types.NonEmptyStr),
        generation: 0,
      },
      observed: LeaseInaccessible,
    ),
    prior: NoPriorReceipt,
    observed_at: witness_observed_at,
  ) {
    PlanRefuse { step_id: _, reason: r } => string_contains(s: r, pattern: "inaccessible")
    _ => false
  }
}

test fn held_lease_observed_verdict_is_a_5_element_bijection_onto_observation_verdict() -> Bool {
  let absent = held_lease_observed_verdict(observed: LeaseAbsent)
  let expected = held_lease_observed_verdict(observed: LeaseRunningExpected)
  let stale = held_lease_observed_verdict(observed: LeaseRunningStale)
  let foreign = held_lease_observed_verdict(observed: LeasePortForeign)
  let inaccessible = held_lease_observed_verdict(observed: LeaseInaccessible)
  match absent {
    Absent => true
    _ => false
  }
    && match expected {
      Converged => true
      _ => false
    }
    && match stale {
      Drifted => true
      _ => false
    }
    && match foreign {
      Conflict => true
      _ => false
    }
    && match inaccessible {
      Inaccessible => true
      _ => false
    }
}

test fn decision_for_held_lease_verdict_grounds_each_observation_arm() -> Bool {
  let noop_decision = decision_for_held_lease_verdict(
    verdict: held_lease_observed_verdict(observed: LeaseRunningExpected),
    lease: expected_lease,
    pending_step_id: witness_step_serve,
  )
  let apply_decision = decision_for_held_lease_verdict(
    verdict: held_lease_observed_verdict(observed: LeaseAbsent),
    lease: absent_lease,
    pending_step_id: witness_step_serve,
  )
  let drain_decision = decision_for_held_lease_verdict(
    verdict: held_lease_observed_verdict(observed: LeaseRunningStale),
    lease: stale_lease,
    pending_step_id: witness_step_serve,
  )
  let refuse_decision = decision_for_held_lease_verdict(
    verdict: held_lease_observed_verdict(observed: LeasePortForeign),
    lease: foreign_lease,
    pending_step_id: witness_step_serve,
  )
  match noop_decision {
    Noop => true
    _ => false
  }
    && match apply_decision {
      Apply { plan: ApplyAtStep { step_id: s } } => s == witness_step_serve
      _ => false
    }
    && match drain_decision {
      Apply { plan: DrainThenStartAtStep { step_id: s, lease_key: k } } =>
        s == witness_step_serve && k == witness_lease_key
      _ => false
    }
    && match refuse_decision {
      Refuse { reason: r } => string_contains(s: r, pattern: "foreign")
      _ => false
    }
}

test fn stall_budget_within_limit_preserves_apply_plan() -> Bool {
  let budget = std.temporal_effect.EffectStallBudget {
    step_id: witness_step_serve,
    limit_ms: hang_budget_millisecond(ms: srv3_install_hang_no_installer_progress_ms),
    elapsed_ms: millisecond(count: 600000),
  }
  match stall_budget_verdict(budget: budget) {
    StallWithinBudget => true
    StallBudgetExceeded { step_id: _, elapsed_ms: _, limit_ms: _ } => false
  }
    && match next_step_plan_on_stall_budget(
      pending_plan: std.temporal_effect.PlanApply { step_id: witness_step_serve },
      budget: budget,
    ) {
      PlanApply { step_id: sid } => sid == witness_step_serve
      _ => false
    }
}

test fn stall_budget_exceeded_refuses_not_widen() -> Bool {
  let budget = std.temporal_effect.EffectStallBudget {
    step_id: witness_step_serve,
    limit_ms: hang_budget_millisecond(ms: srv3_install_hang_no_installer_progress_ms),
    elapsed_ms: hang_budget_millisecond(ms: srv3_install_hang_no_router_lease_ms),
  }
  match stall_budget_verdict(budget: budget) {
    StallBudgetExceeded { step_id: sid, elapsed_ms: _, limit_ms: _ } => sid == witness_step_serve
    StallWithinBudget => false
  }
    && match next_step_plan_on_stall_budget(
      pending_plan: std.temporal_effect.PlanApply { step_id: witness_step_serve },
      budget: budget,
    ) {
      PlanRefuse { step_id: _, reason: r } => string_contains(s: r, pattern: "stall budget exceeded")
      PlanApply { step_id: _ } => false
      _ => false
    }
}

test fn stall_cause_fold_router_absent_dominates_silent_installer() -> Bool {
  match cause_fold_dominant_hang_stall(causes: [
    gunbc.srv3_os_install_diagnostic.HangStallInstallerProgressSilent { elapsed_ms: millisecond(count: 1000000) },
    gunbc.srv3_os_install_diagnostic.HangStallRouterLeaseAbsent { elapsed_ms: millisecond(count: 4600000) },
  ]) {
    HangStallRouterLeaseAbsent { elapsed_ms: _ } => true
    _ => false
  }
    && match cause_fold_dominant_hang_stall(causes: [HangStallWithinBudget]) {
      HangStallWithinBudget => true
      _ => false
    }
}

test fn srv3_stall_budget_limits_match_runbook() -> Bool {
  srv3_install_hang_no_installer_progress_ms == 900000
    && srv3_install_hang_no_router_lease_ms == 4500000
}

test fn srv3_transition_budget_past_limit_is_exceeded_not_within() -> Bool {
  let past = millisecond(
    count: millisecond_count(
      m: hang_budget_millisecond(ms: srv3_install_hang_no_router_lease_ms),
    ) + 1,
  )
  let budget = srv3_os_install_to_host_identity_budget(elapsed: past)
  match stall_budget_verdict(budget: budget) {
    StallBudgetExceeded { step_id: sid, elapsed_ms: _, limit_ms: _ } =>
      string_contains(s: sid, pattern: "os-install-actuated-to-host-identity")
    StallWithinBudget => false
  }
}

test fn held_lease_with_observed_preserves_the_epoch_exactly() -> Bool {
  let updated = held_lease_with_observed(lease: expected_lease, observed: LeaseInaccessible)
  let same_epoch = held_lease_epoch(lease: updated) == held_lease_epoch(lease: expected_lease)
  same_epoch
    && match updated.observed {
      LeaseInaccessible => true
      _ => false
    }
}

test fn held_lease_epoch_separates_leases_differing_only_in_generation() -> Bool {
  let restated = held_lease_with_observed(lease: stale_lease, observed: LeaseRunningExpected)
  let differs = held_lease_epoch(lease: restated) != held_lease_epoch(lease: expected_lease)
  let same_owner = restated.epoch.owner_fingerprint == expected_lease.epoch.owner_fingerprint
  differs && same_owner
}

test fn held_lease_rebuilds_the_observation_without_a_second_epoch_spelling() -> Bool {
  let rebuilt = held_lease(
    epoch: held_lease_epoch(lease: absent_lease),
    observed: LeasePortForeign,
  )
  let restated = held_lease_with_observed(lease: absent_lease, observed: LeasePortForeign)
  rebuilt == restated
}
