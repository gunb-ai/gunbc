module test.claim.accelerator_demo_gpu_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_m5_vendor_grounds_on_apple_entity() -> Bool {
  extdeps.gpu.apple.apple_m5_gpu_catalog.vendor == extdeps.vendor.apple.apple
}

fn witness_rtx5090_vendor_grounds_on_nvidia_entity() -> Bool {
  extdeps.gpu.nvidia.nvidia_rtx_5090_catalog.vendor == extdeps.vendor.nvidia.nvidia
}

fn witness_m5_runtime_is_metal() -> Bool {
  match extdeps.gpu.apple.apple_m5_gpu_catalog.supported_runtimes.first() {
    Present { value: rt } => match rt {
      Metal => true
      Cuda => false
      Rocm => false
      OpenCl => false
    }
    Absent => false
  }
}

fn witness_rtx5090_runtime_is_cuda() -> Bool {
  match extdeps.gpu.nvidia.nvidia_rtx_5090_catalog.supported_runtimes.first() {
    Present { value: rt } => match rt {
      Cuda => true
      Metal => false
      Rocm => false
      OpenCl => false
    }
    Absent => false
  }
}

fn witness_m5_memory_kind_is_unified_shared() -> Bool {
  match extdeps.gpu.apple.apple_m5_gpu_catalog.memory.memory_kind {
    UnifiedShared => true
    Dram => false
    Hbm => false
  }
}

fn witness_rtx5090_memory_kind_is_dram() -> Bool {
  match extdeps.gpu.nvidia.nvidia_rtx_5090_catalog.memory.memory_kind {
    Dram => true
    UnifiedShared => false
    Hbm => false
  }
}

test fn accelerator_demo_gpu_modeling_witnesses() -> Bool {
  gunbc.accelerator_demo_gpu.witness_m5_gpu_execution_lane_count_grounded()
    && gunbc.accelerator_demo_gpu.witness_rtx5090_execution_lane_count_grounded()
    && gunbc.accelerator_demo_gpu.witness_rtx5090_memory_bandwidth_grounded()
    && gunbc.accelerator_demo_gpu.witness_m5_memory_bandwidth_grounded()
    && gunbc.accelerator_demo_gpu.witness_rtx5090_compute_capability_grounded()
    && gunbc.accelerator_demo_gpu.witness_m5_has_no_compute_capability()
    && gunbc.accelerator_demo_gpu.witness_integer_path_is_lossless()
    && gunbc.accelerator_demo_gpu.witness_float_path_is_lossy_even_when_fma_refused()
    && gunbc.accelerator_demo_gpu.witness_gpu_receipt_status_is_dormant()
    && gunbc.accelerator_demo_gpu.witness_gpu_triptych_contains_three_panels()
    && extdeps.languages.gpu.wgsl.kernel.witness_wgsl_relu_mul_add_kernel_surface_shape()
    && extdeps.languages.gpu.wgsl.kernel.witness_wgsl_reuses_simd_op_code_authority()
    && extdeps.languages.gpu.wgsl.kernel.witness_wgsl_int_kernel_source_shape()
    && extdeps.languages.gpu.wgsl.kernel.witness_wgsl_float_kernel_source_shape()
    && extdeps.languages.gpu.wgsl.kernel.witness_wgsl_kernel_sources_grammar_scaffold_documented()
    && witness_m5_vendor_grounds_on_apple_entity()
    && witness_rtx5090_vendor_grounds_on_nvidia_entity()
    && witness_m5_runtime_is_metal()
    && witness_rtx5090_runtime_is_cuda()
    && witness_m5_memory_kind_is_unified_shared()
    && witness_rtx5090_memory_kind_is_dram()
}
