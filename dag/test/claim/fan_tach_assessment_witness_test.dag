module test.claim.fan_tach_assessment_witness

import std.types { Bool, Int, List, NonEmptyStr }
import product.fan_tach { FanTachWindow }
import gunbc.fleet_fan_tach_expectation {
  HostFanTachExpectation,
  chassis_tach_expected,
  expected_tach_headers,
  srv1_fan_tach_expectation,
  srv2_fan_tach_expectation,
  srv3_fan_tach_expectation,
  srv4_fan_tach_expectation,
}
import gunbc.fleet_fan_tach_observation {
  srv1_windows,
  srv2_windows,
  srv3_windows,
  srv4_windows,
}
import product.fan_tach_health {
  DuplicateExpectedHeader,
  DuplicateObservedHeader,
  ExpectedHeaderObservationMissing,
  ExpectedRotationNotObserved,
  UnexpectedRotation,
  FanTachDeviation,
  FanTachHealthy,
  FanTachJudgement,
  FanTachSubject,
  HostIdentityMismatch,
  JudgedDeviant,
  JudgedHealthy,
  JudgedUnknown,
  ObservationForUndeclaredHeader,
  RotationCorrectlyAbsent,
  RotationDegraded,
  RotationObserved,
  authority_gap_count,
  fan_tach_goal,
  fan_tach_judgements,
  fan_tach_observed,
  fan_tach_subject,
  inspect_fan_tach,
  observation_gap_count,
  rotation_degraded_count,
}
import std.goal_assessment {
  GoalAssessmentRefused,
  GoalDiverged,
  GoalIndeterminate,
  GoalInspected,
  GoalObservationRefused,
  GoalSatisfied,
}
import v2.std.algebra { non_empty_to_list }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// 12 OF 20 IS THIS WITNESS'S OWN POLICY, AND IT IS NOT AN ORACLE COPIED FROM THE TREE. srv2's
// healthy endpoints sit at 16-20 and srv1's two bad ones at 4 and 9, so any floor in that gap
// separates them; 12 is chosen inside that gap and threaded as a parameter rather than frozen into
// the judgement, so a number measured on the current fleet cannot quietly become the definition of
// healthy (DESIGN section 5 on literals that are not grounded in an authority).
//
// It is declared here rather than imported because product.fan_tach_health deliberately does not
// own it: the floor is policy about one fleet's telemetry, so the module takes it as a parameter of
// the goal and the caller supplies it. A shared constant would make this witness's threshold the
// authority for every future caller, which is the fork that parameter exists to prevent.
data rotating_floor: Int = 12

fn subject_of(
  expectation: HostFanTachExpectation,
  windows: List<FanTachWindow>,
) -> FanTachSubject {
  fan_tach_subject(
    host: expectation.host,
    expectation: expectation,
    minimum_rotating: rotating_floor,
    windows: windows,
  )
}

fn drop_window(windows: List<FanTachWindow>, header: NonEmptyStr) -> List<FanTachWindow> {
  filter(windows, w => w.endpoint.name != header)
}

// THE CENTRAL WITNESS. srv1 carries two degraded endpoints, so the fleet's own hardware is the
// discriminating input: a migration that lost the degraded verdict would turn this green.
test fn srv1_diverges_on_its_two_degraded_endpoints() -> Bool {
  match inspect_fan_tach(subject: subject_of(expectation: srv1_fan_tach_expectation, windows: srv1_windows)) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalDiverged { deviations: ds } =>
          rotation_degraded_count(deviations: non_empty_to_list(xs: ds)) == 2
        GoalSatisfied { evidence: e } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}

// THE POSITIVE CONTROL. Without it the divergence above could be produced by an assessment that
// never agrees for any input, which would make the wall decoration rather than a check. srv2 is
// the same fleet, the same floor, and healthy.
test fn srv2_the_control_host_is_satisfied() -> Bool {
  match inspect_fan_tach(subject: subject_of(expectation: srv2_fan_tach_expectation, windows: srv2_windows)) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalSatisfied { evidence: e } => e.headers_judged == 5 && e.healthy.length() == 5
        GoalDiverged { deviations: ds } => false
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}

// THE FAIL-OPEN CONTROL, AND THE ONE ARM THIS MIGRATION MOVED. Dropping a window entirely is the
// shape a collector produces when it OMITS an endpoint rather than reporting it absent. Under the
// coproduct this replaced, that header was a verdict beside the others and the host still read as
// assessed; nothing about that fan was ever established, so the honest answer is indeterminate.
//
// The conjunct is deliberately not just "an unknown exists": it also holds that the two degraded
// endpoints are STILL reported, because an indeterminate result that silently dropped the proved
// deviations would be a different defect wearing this one's clothes.
test fn an_omitted_window_is_an_unknown_not_an_assessed_host() -> Bool {
  let dropped = drop_window(windows: srv1_windows, header: "FAN4")
  match inspect_fan_tach(subject: subject_of(expectation: srv1_fan_tach_expectation, windows: dropped)) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalIndeterminate { known_deviations: kd, unknowns: u } =>
          observation_gap_count(unknowns: non_empty_to_list(xs: u)) == 1
            && rotation_degraded_count(deviations: kd) == 1
        GoalSatisfied { evidence: e } => false
        GoalDiverged { deviations: ds } => false
        GoalAssessmentRefused { cause: c } => false
      }
  }
}

// AND A FULLY READ HOST MUST NOT BE INDETERMINATE, or the witness above would pass on a migration
// that made every host indeterminate.
test fn a_fully_read_host_is_not_indeterminate() -> Bool {
  match inspect_fan_tach(subject: subject_of(expectation: srv2_fan_tach_expectation, windows: srv2_windows)) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalIndeterminate { known_deviations: kd, unknowns: u } => false
        GoalSatisfied { evidence: e } => true
        GoalDiverged { deviations: ds } => true
        GoalAssessmentRefused { cause: c } => true
      }
  }
}

// THE THREE REFUSAL CAUSES, one witness each. These are the arms whose binding discharges
// std.goal_assessment's declared GoalAssessmentRefused frontier, so each must be reachable on a
// real input or the frontier was discharged in name only.
test fn one_host_expectation_against_another_hosts_windows_refuses() -> Bool {
  match inspect_fan_tach(subject: fan_tach_subject(
    host: srv3_fan_tach_expectation.host,
    expectation: srv3_fan_tach_expectation,
    minimum_rotating: rotating_floor,
    windows: srv4_windows,
  )) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: HostIdentityMismatch } => true
        other => false
      }
  }
}

test fn a_roster_naming_one_header_twice_refuses() -> Bool {
  match inspect_fan_tach(subject: subject_of(
    expectation: HostFanTachExpectation {
      host: srv3_fan_tach_expectation.host,
      headers: flat_map(
        [srv3_fan_tach_expectation.headers, [chassis_tach_expected(header: "FAN3")]],
        g => g,
      ),
    },
    windows: srv3_windows,
  )) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: DuplicateExpectedHeader { header: h } } =>
          h == ("FAN3" as NonEmptyStr)
        other => false
      }
  }
}

test fn a_collector_answering_twice_for_one_endpoint_refuses() -> Bool {
  match inspect_fan_tach(subject: subject_of(
    expectation: srv3_fan_tach_expectation,
    windows: flat_map([srv3_windows, [srv3_windows.first()]], g => g),
  )) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: DuplicateObservedHeader { header: h } } =>
          h == ("FAN1" as NonEmptyStr)
        other => false
      }
  }
}

// AND A WELL-FORMED QUESTION MUST NOT REFUSE, or the three above would pass on an assessment that
// refuses everything. This is the same srv3 roster and the same srv3 windows, unduplicated.
test fn a_well_formed_question_does_not_refuse() -> Bool {
  match inspect_fan_tach(subject: subject_of(expectation: srv3_fan_tach_expectation, windows: srv3_windows)) {
    GoalObservationRefused { subject: s, goal: g, request: rq, cause: c } => false
    GoalInspected { subject: s, goal: g, request: rq, observed: o, assessment: a } =>
      match a {
        GoalAssessmentRefused { cause: c } => false
        other => true
      }
  }
}

// ---------------------------------------------------------------------------
// THE PER-HEADER PICTURE, which is a different question from the verdict.
//
// These five conjuncts were carried by gunbc.fleet_fan_tach_health_witness, a WET witness that
// this change deletes. It was not dropped for being wet: it was referenced by nothing -- absent
// from `local_repo_wet_schedule`, named by no lane, no roster and no CI step -- so its claims had
// never executed on any merge path. A module that looks like coverage while being inert is worse
// than an absent one, because it is cited as the safety net it is not (DESIGN section 5,
// specification-without-execution; section 3c, a witness no roster reads).
//
// So the claims move to where they run, and the inert module dies with them rather than lingering
// as an attractor. They fold the judgements directly, because "srv1 has two degraded endpoints AND
// three healthy ones" is a statement about five headers, and the algebra carries evidence on the
// satisfied arm alone.
fn judgements_of(
  expectation: HostFanTachExpectation,
  windows: List<FanTachWindow>,
) -> List<FanTachJudgement> {
  fan_tach_judgements(
    goal: fan_tach_goal(expectation: expectation, minimum_rotating: rotating_floor),
    observed: fan_tach_observed(windows: windows),
  )
}

fn tag_of(j: FanTachJudgement) -> NonEmptyStr {
  match j {
    JudgedHealthy { healthy: h } =>
      match h {
        RotationObserved { header: hd, speed: sp } => "spin"
        RotationCorrectlyAbsent { header: hd } => "nominal-absent"
      }
    JudgedDeviant { deviation: d } =>
      match d {
        ExpectedRotationNotObserved { header: hd, role: r, absence: ab } => "no-rotation"
        RotationDegraded { header: hd, role: r, rotating_count: rc, sample_count: sc } => "degraded"
        UnexpectedRotation { header: hd, speed: sp } => "drift"
        ObservationForUndeclaredHeader { header: hd } => "authority-gap"
      }
    JudgedUnknown { unknown: u } =>
      match u {
        ExpectedHeaderObservationMissing { header: hd, role: r } => "obs-gap"
      }
  }
}

fn tags_of(
  expectation: HostFanTachExpectation,
  windows: List<FanTachWindow>,
) -> List<NonEmptyStr> {
  map(judgements_of(expectation: expectation, windows: windows), j => tag_of(j: j))
}

fn count_of(tags: List<NonEmptyStr>, tag: NonEmptyStr) -> Int {
  fold(tags, init: 0, f: (acc, t) => if t == tag { acc + 1 } else { acc })
}

// DEGRADED IS ITS OWN VERDICT, AND THIS IS THE CONTROL THAT FORCED IT TO EXIST. srv1/FAN4 rotates
// 9 times in 20 and srv1/FAN5 four times, against 16-20 for the same fans on the control host at
// the same duty. A two-state vocabulary put them in the wrong bucket either way: "not rotating"
// reads as a hardware emergency, "rotating" reads as nothing at all. The three healthy endpoints
// are asserted BESIDE them, which is the half the verdict arm cannot carry.
test fn srv1_carries_two_degraded_endpoints_beside_three_healthy_ones() -> Bool {
  let tags = tags_of(expectation: srv1_fan_tach_expectation, windows: srv1_windows)
  count_of(tags: tags, tag: "degraded") == 2
    && count_of(tags: tags, tag: "no-rotation") == 0
    && count_of(tags: tags, tag: "spin") == 3
}

// AN INTERMITTENT ZERO IS NOT A FAULT. srv2 reads zero on every chassis endpoint 2-4 times in 20
// while healthy, so a judgement keying on "any zero" would condemn a working machine. This is the
// conjunct that makes the RATE load-bearing rather than decorative.
test fn an_ordinary_dropout_is_not_a_fault() -> Bool {
  let tags = tags_of(expectation: srv2_fan_tach_expectation, windows: srv2_windows)
  count_of(tags: tags, tag: "no-rotation") == 0 && count_of(tags: tags, tag: "degraded") == 0
}

// UNAVAILABLE AND NEVER-ROTATED ARE DIFFERENT ABSENCES. srv3/FAN2 publishes nothing because
// nothing is wired to it; that is not the same as a rotor that was read and never turned.
test fn an_unwired_endpoint_is_nominal_not_a_missing_rotation() -> Bool {
  let tags = tags_of(expectation: srv3_fan_tach_expectation, windows: srv3_windows)
  count_of(tags: tags, tag: "nominal-absent") == 1
    && count_of(tags: tags, tag: "no-rotation") == 0
    && count_of(tags: tags, tag: "spin") == 4
}

// A HEADER THE AUTHORITY DOES NOT DECLARE IS AN AUTHORITY GAP, not a fan condition: the fleet
// roster is what is wrong, and it belongs to whoever maintains the inventory.
test fn a_header_outside_the_roster_is_an_authority_gap() -> Bool {
  let tags = tags_of(
    expectation: HostFanTachExpectation {
      host: srv4_fan_tach_expectation.host,
      headers: filter(srv4_fan_tach_expectation.headers, row => row.header != "FAN4"),
    },
    windows: srv4_windows,
  )
  count_of(tags: tags, tag: "authority-gap") == 1
}

// TWO HOSTS WITH THE SAME HEADER COUNT ARE STILL DIFFERENT ROSTERS. Nothing about the SHAPE of a
// srv3/srv4 pairing is wrong, which is exactly why the identity has to be checked rather than the
// arity -- and why the cross-host refusal above is not made redundant by counting.
test fn srv3_and_srv4_differ_by_identity_not_by_count() -> Bool {
  let a = expected_tach_headers(expectation: srv3_fan_tach_expectation)
  let b = expected_tach_headers(expectation: srv4_fan_tach_expectation)
  a.length() == 4 && b.length() == 4 && a != b
}
