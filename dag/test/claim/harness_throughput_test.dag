module test.claim.harness_throughput

import std.types { Bool, String, Int, list_length }
import gunbc.harness.harness_throughput {
  HarnessThroughput, ThroughputObserved, ThroughputUnobserved,
  harness_throughput_from_events, throughput_centi_tokens_per_second,
  throughput_rate_text, throughput_band, throughput_band_word, throughput_cell_text,
  harness_round_ledger_from_events, HarnessRoundLedger, RoundsObserved, RoundsUnobserved, RoundObservation, round_segments, round_segment_kind_word, RoundSegment,
  round_playback, round_playback_floor_ms, RoundPlayback, round_remaining_flex, harness_round_budget_steps, WriteRound, ReadRound, ReasonRound,
  ThroughputBand, Crawling, Walking, Running, Sprinting,
}

// A CONTROLLED FIXTURE, NOT A TREE MEASUREMENT. The rows below are authored here with their answer
// computed by hand, so the assertion compares a fold against an independent oracle rather than
// against whatever the current tree happens to produce -- the distinction DESIGN section 5 draws
// between a check and a change detector.
//
// THE ARITHMETIC, STATED SO A FAILURE IS READABLE: three clocked rounds at t=1000, 3000, 5000 ms
// carrying 100, 200 and 300 output tokens. Round 1's tokens are excluded because its timestamp
// marks the END of its own generation, so the numerator is 200+300=500 over an interval of
// 5000-1000=4000 ms, which is 125.00 tok/s exactly.
data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn three_clocked_rounds() -> String {
  join([
    "{\"type\":\"turn.started\"}",
    "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
    "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"epoch_ms\":3000}",
    "{\"type\":\"round.usage\",\"step\":3,\"input_tokens\":30,\"output_tokens\":300,\"epoch_ms\":5000}",
  ], "\n")
}

test fn three_clocked_rounds_measure_the_exact_rate() -> Bool {
  match throughput_centi_tokens_per_second(t: harness_throughput_from_events(body: three_clocked_rounds())) {
    Present { value: centi } => centi == 12500
    Absent => false
  }
}

test fn the_rate_renders_with_two_decimal_places() -> Bool {
  throughput_rate_text(t: harness_throughput_from_events(body: three_clocked_rounds())) == "125.00 tok/s"
}

// THE FIRST ROUND IS EXCLUDED FROM THE NUMERATOR. If it were counted the numerator would be 600 and
// the rate 150.00, so this witness goes red exactly if that decision is silently reversed.
test fn the_first_rounds_tokens_are_not_credited_to_the_interval() -> Bool {
  throughput_rate_text(t: harness_throughput_from_events(body: three_clocked_rounds())) != "150.00 tok/s"
}

// DISCRIMINATING RED. One clocked round cannot yield an interval, and the refusal must say so
// rather than reporting a rate over a zero-width window. The row is fully populated on purpose: a
// fixture missing a required count would refuse for the READER's reason and this witness would
// stop failing on the axis it names.
test fn a_single_clocked_round_refuses_rather_than_dividing() -> Bool {
  match harness_throughput_from_events(
    body: "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
  ) {
    ThroughputUnobserved { reason: _ } => true
    ThroughputObserved { output_tokens: _, elapsed_ms: _, rounds: _ } => false
  }
}

// DISCRIMINATING RED. A usage row whose clock read was refused carries clock_refused and no
// epoch_ms; it must not be absorbed as if it had a time -- nor, as the interior-round red below
// shows, dropped as if it had not happened.
test fn an_unclocked_usage_row_is_not_counted_as_a_reading() -> Bool {
  match harness_throughput_from_events(
    body: "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"clock_refused\":\"no clock\"}",
  ) {
    ThroughputUnobserved { reason: _ } => true
    ThroughputObserved { output_tokens: _, elapsed_ms: _, rounds: _ } => false
  }
}

// A stream carrying no usage rows at all refuses; it does not report zero.
test fn an_event_stream_without_usage_rows_refuses() -> Bool {
  match harness_throughput_from_events(body: "{\"type\":\"turn.started\"}") {
    ThroughputUnobserved { reason: _ } => true
    ThroughputObserved { output_tokens: _, elapsed_ms: _, rounds: _ } => false
  }
}

// The band boundary is a declared policy; this pins the measured rate to its symbol so a boundary
// edit is a visible change rather than a silent one.
test fn a_fast_rate_lands_in_the_top_band() -> Bool {
  match throughput_band(t: harness_throughput_from_events(body: three_clocked_rounds())) {
    Present { value: b } => throughput_band_word(band: b) == "sprinting"
    Absent => false
  }
}


// THE STRIP FOLD OVER A LEDGER WHOSE ANSWER IS COMPUTED BY HAND. Three clocked rounds at t=1000,
// 3000, 5000 with cumulative files_changed 0, 0, 2: two segments (rounds 2 and 3), widths 2000 and
// 2000, the first a READ (0 -> 0) and the second a WRITE (0 -> 2).
fn three_rounds_one_write() -> String {
  join([
    "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000,\"files_changed\":0}",
    "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"epoch_ms\":3000,\"files_changed\":0}",
    "{\"type\":\"round.usage\",\"step\":3,\"input_tokens\":30,\"output_tokens\":300,\"epoch_ms\":5000,\"files_changed\":2}",
  ], "\n")
}

test fn n_rounds_paint_n_minus_one_segments() -> Bool {
  list_length(items: round_segments(ledger: harness_round_ledger_from_events(body: three_rounds_one_write()))) == 2
}

fn playback_expected(p: RoundPlayback) -> Bool {
  if p.segment.step == 2 { p.delay_ms == 0 && p.duration_ms == 1000 }
  else if p.segment.step == 3 { p.delay_ms == 1000 && p.duration_ms == 3000 }
  else if p.segment.step == 4 { p.delay_ms == 4000 && p.duration_ms == round_playback_floor_ms }
  else { false }
}

test fn playback_compresses_the_run_into_a_fixed_window_with_a_floor() -> Bool {
  let segs = [
    RoundSegment { step: 2, duration_ms: 1000, output_tokens: 1, kind: ReadRound },
    RoundSegment { step: 3, duration_ms: 3000, output_tokens: 1, kind: ReadRound },
    RoundSegment { step: 4, duration_ms: 40, output_tokens: 1, kind: WriteRound },
  ]
  let plays = round_playback(segs: segs, playback_ms: 4040)
  list_length(items: plays) == 3 && fold(plays, init: true, f: (acc, p) => acc && playback_expected(p: p))
}

test fn segment_width_is_the_interval_that_ended_at_its_round() -> Bool {
  fold(round_segments(ledger: harness_round_ledger_from_events(body: three_rounds_one_write())),
       init: true, f: (ok, seg) => ok && seg.duration_ms == 2000)
}

// DISCRIMINATING: a rise in the cumulative count is a write; an unchanged count is a read. A level
// test would call round 3 a write for the wrong reason and would call every later round a write.
test fn a_round_that_raised_files_changed_is_a_write_and_the_prior_is_a_read() -> Bool {
  let segs = round_segments(ledger: harness_round_ledger_from_events(body: three_rounds_one_write()))
  match segs.first() {
    Absent => false
    Present { value: a } =>
      match segs.last() {
        Absent => false
        Present { value: b } =>
          round_segment_kind_word(k: a.kind) == "read" && round_segment_kind_word(k: b.kind) == "write"
      }
  }
}

// An older stream with no files_changed paints unmeasured, never read -- the two are different claims.
test fn a_round_without_a_files_changed_count_is_unmeasured() -> Bool {
  match round_segments(ledger: harness_round_ledger_from_events(body: three_clocked_rounds())).first() {
    Absent => false
    Present { value: seg } => round_segment_kind_word(k: seg.kind) == "unmeasured"
  }
}

// DISCRIMINATING: a round that carried no tool call is a reasoning round; the same round with one
// call and no file delta is a read, and a round from an older stream with no count stays a read.
test fn a_round_with_zero_tool_calls_is_reasoning_and_one_call_is_a_read() -> Bool {
  let body = join([
    "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":1,\"output_tokens\":1,\"epoch_ms\":1000,\"files_changed\":0,\"tool_calls\":1}",
    "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":1,\"output_tokens\":1,\"epoch_ms\":2000,\"files_changed\":0,\"tool_calls\":0}",
    "{\"type\":\"round.usage\",\"step\":3,\"input_tokens\":1,\"output_tokens\":1,\"epoch_ms\":3000,\"files_changed\":0,\"tool_calls\":1}",
    "{\"type\":\"round.usage\",\"step\":4,\"input_tokens\":1,\"output_tokens\":1,\"epoch_ms\":4000,\"files_changed\":0}",
  ], "\n")
  let words = map(round_segments(ledger: harness_round_ledger_from_events(body: body)), s => round_segment_kind_word(k: s.kind))
  join(words, ",") == "reasoning,read,read"
}

test fn the_unspent_budget_is_projected_at_the_mean_pace() -> Bool {
  let ledger = RoundsObserved { rounds: [
    RoundObservation { step: 1, input_tokens: 1, output_tokens: 1, epoch_ms: 0, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 2, input_tokens: 1, output_tokens: 1, epoch_ms: 1000, files_changed: Present { value: 0 }, tool_calls: none },
    RoundObservation { step: 3, input_tokens: 1, output_tokens: 1, epoch_ms: 4000, files_changed: Present { value: 0 }, tool_calls: none },
  ] }
  round_remaining_flex(ledger: ledger, budget_steps: 5) == 4000
    && round_remaining_flex(ledger: ledger, budget_steps: 3) == 0
    && harness_round_budget_steps == 40
}

// A ROUND WHOSE COUNT COULD NOT BE READ IS NOT A ROUND THAT PRODUCED NOTHING (review 63779).
//
// These were GREEN PARSES before the repair, and green is what made them dangerous: the reader
// answered 0 for a `round.usage` missing its `output_tokens`, so the row stayed a clocked round --
// its interval in the denominator, nothing in the numerator -- and the cell rendered a confident
// rate that was too low by exactly the work the unread member represented. Zero is a legal token
// count, so no consumer could tell. The fixture below is built so the arithmetic states the harm:
// three rounds at t=1000/3000/5000 carrying 100, 200 and 300 tokens read 125.00 tok/s, and the same
// stream with round 3's count unreadable used to read 200 over 4000 ms -- 50.00 tok/s, a plausible
// number for a run that was in fact producing two and a half times that.
fn three_rounds_with_an_unreadable_count() -> String {
  join([
    "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
    "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"epoch_ms\":3000}",
    "{\"type\":\"round.usage\",\"step\":3,\"input_tokens\":30,\"epoch_ms\":5000}",
  ], "\n")
}

fn throughput_refusal_naming(t: HarnessThroughput, fragment: String) -> Bool {
  match t {
    ThroughputUnobserved { reason: r } => (r as String).contains(fragment)
    ThroughputObserved { output_tokens: _, elapsed_ms: _, rounds: _ } => false
  }
}

test fn a_usage_row_without_output_tokens_does_not_become_a_zero_token_clocked_round() -> Bool {
  throughput_refusal_naming(
    t: harness_throughput_from_events(body: three_rounds_with_an_unreadable_count()),
    fragment: "output_tokens",
  )
    && throughput_rate_text(t: harness_throughput_from_events(body: three_rounds_with_an_unreadable_count())) == "-- tok/s"
}

// AND THE ROW IS NOT SILENTLY DROPPED EITHER, which is the other way to make the first assertion
// pass while still lying: a ledger missing the rows it could not read is a shorter run that looks
// complete, and every projection over it -- rate, strip, budget track -- renders confidently from a
// population nobody was told had shrunk.
test fn an_unreadable_row_refuses_the_whole_ledger_rather_than_shortening_it() -> Bool {
  match harness_round_ledger_from_events(body: three_rounds_with_an_unreadable_count()) {
    RoundsUnobserved { reason: _ } => true
    RoundsObserved { rounds: _ } => false
  }
}

// A DUPLICATED COUNT IS NOT AN ABSENT ONE HERE EITHER, and the cause must say which happened: the
// reader this module now shares with the writer separates them, and a wildcard reinstated in either
// place would put back one sentence for two wire facts.
test fn a_duplicated_output_tokens_member_says_duplicated() -> Bool {
  throughput_refusal_naming(
    t: harness_throughput_from_events(body: join([
      "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
      "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"output_tokens\":900,\"epoch_ms\":3000}",
    ], "\n")),
    fragment: "duplicated",
  )
}

// THE BOUNDARY THE REPAIR DELIBERATELY DID NOT CROSS: a member the stream DECLARES optional is
// still absent-is-an-answer. files_changed is not carried by older writers and its absence paints
// `unmeasured`, which the strip witness above pins; without this control the repair would read as
// "refuse any row that is not fully populated" and would blank every historical run.
test fn an_older_row_without_the_optional_counts_still_reads() -> Bool {
  match harness_round_ledger_from_events(body: three_clocked_rounds()) {
    RoundsUnobserved { reason: _ } => false
    RoundsObserved { rounds } => list_length(items: rounds) == 3
  }
}


// AN UNCLOCKED INTERIOR ROUND MAY NOT BE DELETED FROM THE POPULATION (side-chat review,
// 2026-09-11). Dropping it is the zero-default's understatement reached by subtraction instead of
// substitution: the endpoints' interval stays in the denominator while the dropped round's tokens
// leave the numerator and its row leaves the count. THE ARITHMETIC, SO A FAILURE IS READABLE:
// 100/200/300 at t=1000, unclocked, t=5000. The honest reading of rounds 2..N over 1000..5000 is
// 500/4000ms = 125.00 tok/s over 3 rounds; dropping the middle row reports 300/4000 = 75.00 tok/s
// over 2. This asserts the refusal rather than either number, because a round whose time is unknown
// cannot be placed in an interval-denominated aggregate at all -- and it asserts NOT 75.00
// explicitly, since a reader that silently dropped the row would otherwise satisfy every other
// witness in this file.
fn three_rounds_with_an_unclocked_middle() -> String {
  join([
    "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
    "{\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"clock_refused\":\"no clock\"}",
    "{\"type\":\"round.usage\",\"step\":3,\"input_tokens\":30,\"output_tokens\":300,\"epoch_ms\":5000}",
  ], "\n")
}

test fn an_unclocked_interior_round_is_not_dropped_from_the_rate() -> Bool {
  let t = harness_throughput_from_events(body: three_rounds_with_an_unclocked_middle())
  throughput_refusal_naming(t: t, fragment: "epoch_ms")
    && throughput_rate_text(t: t) != "75.00 tok/s"
    && throughput_rate_text(t: t) == "-- tok/s"
}

test fn an_unclocked_interior_round_does_not_shorten_the_ledger() -> Bool {
  match harness_round_ledger_from_events(body: three_rounds_with_an_unclocked_middle()) {
    RoundsUnobserved { reason: _ } => true
    RoundsObserved { rounds: _ } => false
  }
}

// THE DISCRIMINATOR ITSELF IS A READING, AND AN UNREADABLE ONE IS NOT SOMEBODY ELSE'S EVENT. A line
// carrying `type` twice used to answer "not a usage row" and be skipped, so its counts never
// reached the reader that refuses -- the same class one frame earlier, in the test that decides
// whether a measurement is ours to read.
test fn a_row_with_a_duplicated_type_member_refuses_rather_than_being_skipped() -> Bool {
  throughput_refusal_naming(
    t: harness_throughput_from_events(body: join([
      "{\"type\":\"round.usage\",\"step\":1,\"input_tokens\":10,\"output_tokens\":100,\"epoch_ms\":1000}",
      "{\"type\":\"round.usage\",\"type\":\"round.usage\",\"step\":2,\"input_tokens\":20,\"output_tokens\":200,\"epoch_ms\":3000}",
    ], "\n")),
    fragment: "more than once",
  )
}

// AND A RECOGNISED NON-USAGE EVENT IS STILL SKIPPED, not refused: the stream carries turn.started
// and round.usage_unavailable by design, and the fixture at the top of this file leads with one.
test fn another_event_type_is_still_skipped_rather_than_refusing() -> Bool {
  throughput_rate_text(t: harness_throughput_from_events(body: three_clocked_rounds())) == "125.00 tok/s"
}
