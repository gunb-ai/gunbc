module test.claim.durable_compare_and_set

import std.types as Types: NonEmptyStr
import std.content_hash as ContentHash: content_hash_of_value
import std.checked_arithmetic as CheckedArithmetic: int_inclusive_max
import std.durable_compare_and_set as DurableCas: CasAttempt, CasAttemptKey, CasCommitted, CasExpectation,
  CasExpectedGeneration, CasGeneration, CasGenerationSpaceExhausted, CasObservedReadable,
  CasObservedUnreadable, CasOutcome, CasPreconditionFailed, CasReadableAbsent, CasReadablePresent,
  CasReadableSlot, CasSlotObservation, CasSlotVersion, CasStoreRefused, CasUnreadableContentMissing,
  CasUnreadableObservationBoundExceeded, CasUnreadableReadRefused, ExpectSlotAbsent, ExpectSlotGeneration,
  cas_attempt, cas_decide, cas_generation_count, cas_unreadable_slot_detail

// WHAT DECIDES HERE. std.durable_compare_and_set's cas_decide answers one question -- does this attempt's
// expectation admit this observation, and at which generation -- from an attempt and an observation, with no
// persistence. This entry keeps the claims about that decision that a real file store cannot reach: the
// generation-space boundary, the unreadable-cause completeness, the superseded refusal that reports the current
// head, the empty-slot counterexample, and the sentinel for the one field the fold does not consume.
//
// THE RULE IS SHARED, NOT RESTATED. gunbc.durable_cas_file_store's cas_compare_and_set_outcome now calls
// cas_expectation_admits instead of spelling its own comparison, so the rows here and the rows in
// test.claim.durable_cas_file_store_wet_witness decide through one authority. Measured control: mutating
// cas_expectation_admits so an absent observation admits a generation-naming expectation reddens the store's
// empty-slot counterexample and this entry's; before that cut, the same mutation left every store row green.
//
// WHY THIS ENTRY WAS DEAD, AND WHAT REPAIRED IT. It imported nothing, so every cas_* name it used was
// unresolved -- 134 hard errors at its own entry, measured before this change, and identical under
// --source-root src/v2 -- which is why none of its rows had ever executed. It also declared
// live_tree_disposition: a LiveTreeDisposition fixture (a type from a std live-tree module it never imported)
// that no row read. A fixture carrying no witness is not evidence, so the declaration was deleted and the
// imports above are exactly what its rows name.
//
// WHAT WAS RETIRED, AND WHERE EACH CLAIM LIVES INSTEAD. The covering rows are the wet ones -- they execute the
// real store under test.claim.durable_cas_file_store_wet_witness, so they are the stronger authority and the
// fold-level copies were removed rather than left beside them:
//   - a create against an absent slot lands at the first generation:
//     commit_then_independent_read_back_agrees_by_real_execution;
//   - a create against an occupied slot refuses: a_second_eligible_writer_loses_to_the_observed_winner_by_real_execution;
//   - an update from the current generation commits at the next: an_advance_after_commit_lands_generation_two_by_real_execution;
//   - the loser of a race retries against the generation that won, and a retry of the stale expectation stays
//     refused: a_racing_writer_under_a_window_retries_and_loses_no_commit_by_real_execution, which binds a real
//     window and a real attempt rather than a fixture;
//   - an expectation refused as unreadable commits when the same slot is read absent:
//     a_missing_slot_root_refuses_rather_than_reading_absent_by_real_execution and
//     an_established_empty_root_reads_the_slot_absent_by_real_execution.
data witness_key: NonEmptyStr = "gunbc-owned-ci-fabric" as NonEmptyStr

data occupied_at_seven: CasSlotObservation<NonEmptyStr> = CasObservedReadable {
  readable: CasReadablePresent { version: CasSlotVersion {
    generation: 7,
    content: content_hash_of_value(value: "state-at-seven" as NonEmptyStr),
    value: "state-at-seven" as NonEmptyStr,
  } },
}

data occupied_at_nine: CasSlotObservation<NonEmptyStr> = CasObservedReadable {
  readable: CasReadablePresent { version: CasSlotVersion {
    generation: 9,
    content: content_hash_of_value(value: "state-at-nine" as NonEmptyStr),
    value: "state-at-nine" as NonEmptyStr,
  } },
}

fn proposal(expected: CasExpectation) -> CasAttempt<NonEmptyStr> {
  cas_attempt(
    key: witness_key,
    expected: expected,
    proposed: "proposed-state" as NonEmptyStr,
    proposed_content: content_hash_of_value(value: "proposed-state" as NonEmptyStr),
  )
}

fn committed_generation_of(outcome: CasOutcome<NonEmptyStr>) -> Int {
  match outcome {
    CasCommitted { committed: v } => cas_generation_count(g: v.generation)
    CasPreconditionFailed { expected: _, observed: _ } => 0
    CasStoreRefused { cause: _ } => 0
  }
}


// THE COUNTEREXAMPLE THE STORE'S OWN HEADER CARRIES, DECIDED AT THE RULE ITSELF. A slot proven absent admits
// only an expectation that asserts absence: an ExpectSlotGeneration naming a generation must refuse, because
// deciding it from the expectation alone would let an unobserved write create a row at the successor of a
// generation nobody read -- the empty-store-expecting-seven case. Before the store called this rule, the row
// below was the only place that claim was checked; the store's
// a_generation_expectation_against_an_empty_store_refuses_and_writes_no_slot_by_real_execution now checks the
// same rule through the file store.
test fn an_absent_slot_refuses_a_generation_naming_expectation_and_commits_nothing() -> Bool {
  let absent = CasObservedReadable { readable: CasReadableAbsent }
  let refused = match cas_decide(attempt: proposal(expected: ExpectSlotGeneration { generation: 7 }), observed: absent) {
    CasPreconditionFailed { expected: _, observed: o } => match o {
      CasReadableAbsent => true
      CasReadablePresent { version: _ } => false
    }
    CasCommitted { committed: _ } => false
    CasStoreRefused { cause: _ } => false
  }
  let admitted = committed_generation_of(
    outcome: cas_decide(attempt: proposal(expected: ExpectSlotAbsent), observed: absent)
  ) == 1
  refused && admitted
}
// that goes red.
test fn an_update_from_a_superseded_generation_refuses_and_reports_the_current_head() -> Bool {
  let outcome = cas_decide(
    attempt: proposal(expected: ExpectSlotGeneration { generation: 7 }),
    observed: occupied_at_nine,
  )
  match outcome {
    CasPreconditionFailed { expected: _, observed: o } => match o {
      CasReadablePresent { version: v } => cas_generation_count(g: v.generation) == 9
      CasReadableAbsent => false
    }
    CasCommitted { committed: _ } => false
    CasStoreRefused { cause: _ } => false
  }
}

// The four-step control. Steps 1 and 2 are the race; step 3 is the one that
// does the work, because a store that simply wedged after any conflict would
// satisfy steps 1 and 2 and fail here. Step 4 confirms the loser's ORIGINAL
// expectation is still refused afterwards — a retry of the stale write must
// not become admissible just because the loser re-read once.
//
//   1. the winner holds the current generation 7 and commits, landing 8
//   2. the loser holds the same prior 7 against the now-8 slot, and is refused
//   3. the loser re-reads, retries against 8, and MUST land 9
//
// The bindings below are named winner / loser / retry in that order.

// cause is that arm.
test fn an_unreadable_slot_is_a_store_refusal_not_a_lost_race() -> Bool {
  let malformed = cas_decide(
    attempt: proposal(expected: ExpectSlotAbsent),
    observed: CasObservedUnreadable { cause: CasUnreadableMalformed { detail: "head is not parseable" as NonEmptyStr } },
  )
  let missing = cas_decide(
    attempt: proposal(expected: ExpectSlotAbsent),
    observed: CasObservedUnreadable { cause: CasUnreadableContentMissing { referenced: content_hash_of_value(value: "absent-object" as NonEmptyStr) } },
  )
  let refused = cas_decide(
    attempt: proposal(expected: ExpectSlotAbsent),
    observed: CasObservedUnreadable { cause: CasUnreadableReadRefused { detail: "store unreachable" as NonEmptyStr } },
  )
  let beyond = cas_decide(
    attempt: proposal(expected: ExpectSlotAbsent),
    observed: CasObservedUnreadable { cause: CasUnreadableObservationBoundExceeded { bound: 4096 } },
  )
  is_store_refusal(outcome: malformed)
    && is_store_refusal(outcome: missing)
    && is_store_refusal(outcome: refused)
    && is_store_refusal(outcome: beyond)
    && cas_unreadable_slot_detail(cause: CasUnreadableObservationBoundExceeded { bound: 8 })
      == "observation bound exceeded: 8"
}

fn is_store_refusal(outcome: CasOutcome<NonEmptyStr>) -> Bool {
  match outcome {
    CasStoreRefused { cause: _ } => true
    CasCommitted { committed: _ } => false
    CasPreconditionFailed { expected: _, observed: _ } => false
  }
}

// Positive control on the negative arm: ExpectSlotAbsent against a genuinely
// absent slot commits, so the refusal above is attributable to unreadability
// and not to the expectation being unsatisfiable in general.

// A green here is NOT a safety claim. It is the receipt for a declared gap.
fn attempt_for(key: NonEmptyStr) -> CasAttempt<NonEmptyStr> {
  cas_attempt(
    key: key,
    expected: ExpectSlotGeneration { generation: 7 },
    proposed: "proposed-state" as NonEmptyStr,
    proposed_content: content_hash_of_value(value: "proposed-state" as NonEmptyStr),
  )
}

test fn known_gap_attempt_key_unconsumed_red_here_means_the_gap_was_closed() -> Bool {
  let for_slot_a = cas_decide(
    attempt: attempt_for(key: "slot-a" as NonEmptyStr),
    observed: occupied_at_seven,
  )
  let for_slot_b = cas_decide(
    attempt: attempt_for(key: "slot-b" as NonEmptyStr),
    observed: occupied_at_seven,
  )
  committed_generation_of(outcome: for_slot_a) == 8
    && committed_generation_of(outcome: for_slot_b) == 8
}

fn occupied_at(g: CasGeneration) -> CasSlotObservation<NonEmptyStr> {
  CasObservedReadable { readable: CasReadablePresent { version: CasSlotVersion {
    generation: g, content: content_hash_of_value(value: "state" as NonEmptyStr), value: "state" as NonEmptyStr,
  } } }
}

// THE LAST GENERATION HAS NO SUCCESSOR, AND AN ADMITTED ATTEMPT AGAINST IT REFUSES AS EXHAUSTED rather
// than committing a successor that only an overflowing addition could name. The positive control is
// the generation one below: it still commits, to the maximum itself.

// the generation one below: it still commits, to the maximum itself.
test fn an_attempt_against_the_last_generation_refuses_as_exhausted_and_one_below_commits_to_it() -> Bool {
  let max = int_inclusive_max()
  let exhausted = match cas_decide(attempt: proposal(expected: ExpectSlotGeneration { generation: max }), observed: occupied_at(g: max)) {
    CasStoreRefused { cause: c } => match c {
      CasGenerationSpaceExhausted { head: h } => h == max
      _ => false
    }
    _ => false
  }
  let below = match cas_decide(attempt: proposal(expected: ExpectSlotGeneration { generation: max - 1 }), observed: occupied_at(g: max - 1)) {
    CasCommitted { committed: v } => v.generation == max
    _ => false
  }
  exhausted && below
}
