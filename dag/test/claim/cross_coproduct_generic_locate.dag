module test.claim.cross_coproduct_generic_locate

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count,
}

// Accept-only until fleet regen emits UnifyGenericsAcc. Defect cases stay on
// known_red_probe constructor_tag_route_probe_red (review 80494 / 80557).
// dissolve-on: none for the accept rows — they stay after the climb.

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn prelude() -> String {
  "module locate.cross\n\ntype P = P1 { x: Int } | P2 { y: Int }\ntype Q = Q1 { x: Int } | Q2 { y: Int }\n\n"
}

fn same_arm_source(a: String, b: String) -> String {
  join([
    prelude(),
    "fn same_arm<T>(a: T, b: T) -> Bool { true }\nfn probe() -> Bool {\n  same_arm(a: ",
    a,
    ", b: ",
    b,
    ")\n}\n"
  ], "")
}

test fn same_arm_same_coproduct_is_accepted() -> Bool {
  blocking_count(source: same_arm_source(a: "P1 { x: 1 }", b: "P2 { y: 2 }")) == 0
}

test fn same_arm_int_int_is_accepted() -> Bool {
  blocking_count(source: "module locate.ii\nfn same_arm<T>(a: T, b: T) -> Bool { true }\nfn probe() -> Bool {\n  same_arm(a: 1, b: 2)\n}\n") == 0
}

test fn uninformative_then_int_then_int_is_accepted() -> Bool {
  blocking_count(source: "module locate.tv3ok\nfn same_arm<T>(a: T, b: T, c: T) -> Bool { true }\nfn probe<U>(u: U) -> Bool {\n  same_arm(a: u, b: 1, c: 2)\n}\n") == 0
}

test fn same_arm_two_lambdas_does_not_compare_return_to_callable() -> Bool {
  blocking_count(source: "module locate.lam\nfn same_arm<T>(a: T, b: T) -> Bool { true }\nfn probe() -> Bool {\n  same_arm(a: (x: Int) => x, b: (y: Int) => y)\n}\n") == 0
}

test fn same_arm_two_applied_box_int_is_accepted() -> Bool {
  blocking_count(source: "module locate.box\ntype Box<T>\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn probe(x: Box<Int>, y: Box<Int>) -> Bool {\n  same_arm(a: x, b: y)\n}\n") == 0
}
