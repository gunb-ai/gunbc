module test.claim.tmp_countmean_census_debug

import std.types { String, Bool, Int, List }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable }

fn blocking_total(c: CompileDiagnosticCensus) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } => rows |> filter(r => r.blocking) |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

fn census_ran(c: CompileDiagnosticCensus) -> Bool {
  match c { CensusNotRunnable { cause: _ } => false CensusObserved { rows: _ } => true }
}

data green_fixture: String = "module probe_ratio_vs_countmean_consumers\nimport std.types { Bool }\nimport std.measure { ConcurrentRequestHundredths, ConcurrentRequestThousandths, concurrent_request_hundredths, concurrent_request_thousandths }\nimport extdeps.vllm.log_lines { VllmNumberReading }\nimport extdeps.vllm.kv_layout { hundredths_within_printed_precision }\nimport gunbc.serving.flash_next_recipe_throughput_evidence { mean_decode_concurrency, RecipeThroughputVerdict }\nimport gunbc.spark.serving_rank_observe { RankStartupObservation }\nfn uses(predicted: ConcurrentRequestHundredths, reported: ConcurrentRequestHundredths, mean: ConcurrentRequestThousandths, reading: VllmNumberReading<ConcurrentRequestHundredths>, verdict: RecipeThroughputVerdict, observed: RankStartupObservation) -> Bool { hundredths_within_printed_precision(predicted: predicted, reported: reported) }\n"

data red_percent_at_thousandths: String = "module probe_ratio_vs_countmean_red_pt\nimport std.types { Bool }\nimport std.measure { ConcurrentRequestHundredths, ConcurrentRequestThousandths, concurrent_request_hundredths, concurrent_request_thousandths }\nimport extdeps.vllm.log_lines { VllmNumberReading }\nimport extdeps.vllm.kv_layout { hundredths_within_printed_precision }\nimport gunbc.serving.flash_next_recipe_throughput_evidence { mean_decode_concurrency, RecipeThroughputVerdict }\nimport gunbc.spark.serving_rank_observe { RankStartupObservation }\nimport std.measure { Percent, percent }\nfn uses(predicted: ConcurrentRequestHundredths, reported: ConcurrentRequestHundredths, mean: ConcurrentRequestThousandths, reading: VllmNumberReading<ConcurrentRequestHundredths>, verdict: RecipeThroughputVerdict, observed: RankStartupObservation) -> Bool { hundredths_within_printed_precision(predicted: predicted, reported: reported) }\nfn resident_requests(c: ConcurrentRequestThousandths) -> Int { 0 }\nfn call() -> Int { resident_requests(c: percent(value: 15)) }\n"

fn green_total() -> Int { blocking_total(c: compile_dag_diagnostic_census(green_fixture)) }
fn green_ran() -> Bool { census_ran(c: compile_dag_diagnostic_census(green_fixture)) }
fn red_total() -> Int { blocking_total(c: compile_dag_diagnostic_census(red_percent_at_thousandths)) }

test fn dbg_green_ran() -> Bool { green_ran() }
test fn dbg_green_zero() -> Bool { green_total() == 0 }
test fn dbg_green_ge_1() -> Bool { green_total() >= 1 }
test fn dbg_green_ge_2() -> Bool { green_total() >= 2 }
test fn dbg_green_ge_3() -> Bool { green_total() >= 3 }
test fn dbg_green_ge_4() -> Bool { green_total() >= 4 }
test fn dbg_green_ge_8() -> Bool { green_total() >= 8 }
test fn dbg_red_gt_green() -> Bool { red_total() > green_total() }
test fn dbg_red_eq_green_plus_1() -> Bool { red_total() == green_total() + 1 }
