module test.claim.github_effect_perform_real_execution

import std.logic { Bool }
import std.types { Secret, NonEmptyStr }
import extdeps.shell
import gunbc.github_effect_perform {
  GitHubAuthenticatedUserObserved, GitHubAuthenticatedUserRefused,
  GitHubHttpRefused,
  perform_github_authenticated_user_read,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Wet execution witnesses for github.Http.GetAuthenticatedUser through perform_github_authenticated_user_read. The operation has no mock_response, so hermetic discovery refuses it by construction. Excluded from discovery (gunbc.ci_layer_roots witness_exclusion_substrings) and re-enrolled as declared Wet explicit entries (bin_witness_wet_entries). WHY GET /user: a read has no commit-ambiguity blast radius and still proves Bearer auth, REST transport, RestOutcome, and classify_github_http_outcome on the real GitHub API. The discriminating RED is a token GitHub will not accept; the positive control uses GITHUB_TOKEN when the environment supplies one."

test fn github_authenticated_user_read_rejects_a_bogus_token_by_real_execution() -> Bool {
  match perform_github_authenticated_user_read(auth_token: "definitely-not-a-github-token" as Secret) {
    GitHubAuthenticatedUserRefused {
      performance: GitHubHttpRefused { status, body: _ }
    } => status == 401
    GitHubAuthenticatedUserObserved { user: _ } => false
    GitHubAuthenticatedUserRefused { performance: _ } => false
  }
}

test fn github_authenticated_user_read_observes_login_when_token_present_by_real_execution() -> Bool {
  let observed = shell.Env.Get(name: "GITHUB_TOKEN")
  match observed.value {
    Absent => false
    Present { value: raw } =>
      if raw == "" {
        false
      } else {
        match perform_github_authenticated_user_read(auth_token: raw as Secret) {
          GitHubAuthenticatedUserObserved { user } => user.login != "" && user.id > 0
          GitHubAuthenticatedUserRefused { performance: _ } => false
        }
      }
  }
}
