module test.claim.sec_edgar_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data gitlab_fy2026_gross_margin_ratio_low: Float = 0.8735

data gitlab_fy2026_gross_margin_ratio_high: Float = 0.8737

test fn w_gitlab_filed_facts_internal_consistency() -> Bool {
  match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_revenue) {
    Present { value: revenue } =>
      match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_cost_of_revenue) {
        Present { value: cost } =>
          match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_gross_profit) {
            Present { value: gross_profit } =>
              extdeps.sec.facts.filed_gross_profit_matches_revenue_minus_cost(
                revenue: revenue,
                cost_of_revenue: cost,
                gross_profit: gross_profit
              )
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn w_gitlab_gross_margin_derivation_matches_filed_facts() -> Bool {
  match extdeps.sec.facts.derive_gross_margin_ratio_from_facts(
    revenue: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_revenue,
    gross_profit: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_gross_profit
  ) {
    Present { value: ratio } =>
      extdeps.sec.facts.gross_margin_ratio_in_band(
        ratio: ratio,
        low: gitlab_fy2026_gross_margin_ratio_low,
        high: gitlab_fy2026_gross_margin_ratio_high
      )
    _ => false
  }
}

test fn w_gitlab_gross_margin_red_on_perturbed_gross_profit() -> Bool {
  match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_revenue) {
    Present { value: revenue } =>
      match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_cost_of_revenue) {
        Present { value: cost } =>
          match extdeps.sec.facts.filed_amount(fact: extdeps.sec.issuer.gitlab_facts.gitlab_fy2026_gross_profit) {
            Present { value: gross_profit } =>
              !extdeps.sec.facts.filed_gross_profit_matches_revenue_minus_cost(
                revenue: revenue,
                cost_of_revenue: cost,
                gross_profit: extdeps.sec.facts.usd_whole_dollars(
                  count: extdeps.sec.facts.usd_whole_dollars_count(gross_profit) + 1
                )
              )
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn w_gitlab_cik_verified_on_edgar() -> Bool {
  extdeps.sec.edgar.cik_padded_digits(cik: extdeps.sec.issuer.gitlab.gitlab_cik) == "0001653482"
}

