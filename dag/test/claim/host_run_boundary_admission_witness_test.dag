module test.claim.host_run_boundary_admission_witness_test


data host_run_boundary_admission_witness_note: String = "Discriminating witnesses for the hermetic-native host-run network-boundary precondition (v2.compiler.host_run_boundary_admission). The admit path EXISTS and is reachable -- a boundary that closes the UriTree layer at LifecycleByConstruction (as a netns/container handler would) is HostRunBoundaryAdmitted (the GREEN control). The in-container reality is the RED: the always-available Simulated handler closes UriTree only at LifecycleByConvention (offline flag, not a kernel wall), so it is HostRunBoundaryUnderConstructed -- REFUSED for a native run, never laundered into Admitted (operator Option 1 fail-closed 2026-07-20); if grade_is_construction accepted convention, admits_construction_only would flip. A boundary that does not cover the network layer at all is HostRunBoundaryRefused naming UriTree -- located, distinct from the under-constructed state (DESIGN 5: three states, not a conflated 2-valued pass/fail)."

fn construction_network_boundary() -> std.frame_boundary.BoundaryMaterialization {
  std.frame_boundary.BoundaryMaterialization {
    closures: [std.frame_boundary.BoundaryClosure { tree: std.effect_grant.UriTree, grade: std.effect_grant.LifecycleByConstruction }]
  }
}

fn is_under_constructed_convention(a: v2.compiler.host_run_boundary_admission.HostRunBoundaryAdmission) -> Bool {
  match a {
    v2.compiler.host_run_boundary_admission.HostRunBoundaryUnderConstructed { grade: g } =>
      match g {
        std.effect_grant.LifecycleByConvention => true
        std.effect_grant.LifecycleByConstruction => false
      }
    v2.compiler.host_run_boundary_admission.HostRunBoundaryAdmitted => false
    v2.compiler.host_run_boundary_admission.HostRunBoundaryRefused { tree: t } => false
  }
}

fn is_refused_for(a: v2.compiler.host_run_boundary_admission.HostRunBoundaryAdmission, tree: std.effect_grant.NamespaceTree) -> Bool {
  match a {
    v2.compiler.host_run_boundary_admission.HostRunBoundaryRefused { tree: t } => std.effect_grant.namespace_tree_eq(a: t, b: tree)
    v2.compiler.host_run_boundary_admission.HostRunBoundaryAdmitted => false
    v2.compiler.host_run_boundary_admission.HostRunBoundaryUnderConstructed { grade: g } => false
  }
}

test fn host_run_admits_construction_only() -> Bool {
  v2.compiler.host_run_boundary_admission.host_run_boundary_is_admitted(
    a: v2.compiler.host_run_boundary_admission.host_run_network_boundary_admits(provided: construction_network_boundary())
  )
}

test fn host_run_refuses_convention_boundary() -> Bool {
  is_under_constructed_convention(
    a: v2.compiler.host_run_boundary_admission.host_run_network_boundary_admits(provided: extdeps.realization.frame_boundary_simulated.simulated_boundary(trees: [std.effect_grant.UriTree]))
  )
}

test fn host_run_refuses_missing_network_layer() -> Bool {
  is_refused_for(
    a: v2.compiler.host_run_boundary_admission.host_run_network_boundary_admits(
      provided: extdeps.realization.frame_boundary_simulated.simulated_boundary(trees: [std.effect_grant.FilesystemPathTree])
    ),
    tree: std.effect_grant.UriTree
  )
}
