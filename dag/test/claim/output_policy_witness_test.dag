module test.claim.output_policy_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn dec_is(d: gunbc.output_policy.OutputDecision, suppressed: Bool, condensed: Bool, full: Bool) -> Bool {
  match d {
    Suppressed => suppressed
    Condensed => condensed
    Full => full
  }
}

fn verbosity_is_verbose(v: gunbc.output_policy.Verbosity) -> Bool {
  match v { Verbose => true, _ => false }
}

fn verbosity_is_quiet(v: gunbc.output_policy.Verbosity) -> Bool {
  match v { Quiet => true, _ => false }
}

fn verbosity_is_normal(v: gunbc.output_policy.Verbosity) -> Bool {
  match v { Normal => true, _ => false }
}

fn w_diagnostic_never_hidden() -> Bool {
  dec_is(d: gunbc.output_policy.channel_decision(channel: Diagnostic, verbosity: Quiet), suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: Diagnostic, verbosity: Normal), suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: Diagnostic, verbosity: Verbose), suppressed: false, condensed: false, full: true)
}

fn w_instrumentation_is_debug_only() -> Bool {
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.Instrumentation, verbosity: Normal), suppressed: true, condensed: false, full: false) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.Instrumentation, verbosity: Quiet), suppressed: true, condensed: false, full: false) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.Instrumentation, verbosity: Verbose), suppressed: false, condensed: false, full: true)
}

fn w_shell_trace_condenses_at_normal() -> Bool {
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.ShellTrace, verbosity: Normal), suppressed: false, condensed: true, full: false) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.ShellTrace, verbosity: Quiet), suppressed: true, condensed: false, full: false) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.ShellTrace, verbosity: Verbose), suppressed: false, condensed: false, full: true)
}

fn w_claim_result_shown_at_normal_hidden_at_quiet() -> Bool {
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.ClaimResult, verbosity: Normal), suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.ClaimResult, verbosity: Quiet), suppressed: true, condensed: false, full: false)
}

fn w_progress_condenses_at_normal() -> Bool {
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.Progress, verbosity: Normal), suppressed: false, condensed: true, full: false) &&
  dec_is(d: gunbc.output_policy.channel_decision(channel: gunbc.output_policy.Progress, verbosity: Quiet), suppressed: true, condensed: false, full: false)
}

fn w_verbose_wins_over_quiet() -> Bool {
  verbosity_is_verbose(v: gunbc.output_policy.resolve_verbosity(env: gunbc.output_policy.VerbosityEnv { verbose: true, quiet: true })) &&
  verbosity_is_quiet(v: gunbc.output_policy.resolve_verbosity(env: gunbc.output_policy.VerbosityEnv { verbose: false, quiet: true })) &&
  verbosity_is_normal(v: gunbc.output_policy.resolve_verbosity(env: gunbc.output_policy.VerbosityEnv { verbose: false, quiet: false }))
}

fn w_env_var_dispatch_names_grounded() -> Bool {
  gunbc.output_policy.env_var_for(v: Verbose) == "GUNBC_VERBOSE" &&
  gunbc.output_policy.env_var_for(v: Quiet) == "GUNBC_QUIET"
}

fn w_shell_trace_cap_is_authority() -> Bool {
  shell_trace_summary_max_columns == 100
}

fn w_resolve_channel_policy_normal_bundles_decisions() -> Bool {
  let gunbc.plans.md_helpers.p = gunbc.output_policy.resolve_channel_policy(verbose: false, quiet: false)
  dec_is(d: gunbc.plans.md_helpers.p.diagnostic, suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.plans.md_helpers.p.claim_result, suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.plans.md_helpers.p.progress, suppressed: false, condensed: true, full: false) &&
  dec_is(d: gunbc.plans.md_helpers.p.shell_trace, suppressed: false, condensed: true, full: false) &&
  dec_is(d: gunbc.plans.md_helpers.p.instrumentation, suppressed: true, condensed: false, full: false)
}

fn w_resolve_channel_policy_verbose_all_full() -> Bool {
  let gunbc.plans.md_helpers.p = gunbc.output_policy.resolve_channel_policy(verbose: true, quiet: false)
  dec_is(d: gunbc.plans.md_helpers.p.shell_trace, suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.plans.md_helpers.p.instrumentation, suppressed: false, condensed: false, full: true) &&
  dec_is(d: gunbc.plans.md_helpers.p.progress, suppressed: false, condensed: false, full: true)
}

test fn output_policy_witnesses() -> Bool {
  w_diagnostic_never_hidden() &&
  w_instrumentation_is_debug_only() &&
  w_shell_trace_condenses_at_normal() &&
  w_claim_result_shown_at_normal_hidden_at_quiet() &&
  w_progress_condenses_at_normal() &&
  w_verbose_wins_over_quiet() &&
  w_env_var_dispatch_names_grounded() &&
  w_shell_trace_cap_is_authority() &&
  w_resolve_channel_policy_normal_bundles_decisions() &&
  w_resolve_channel_policy_verbose_all_full()
}
