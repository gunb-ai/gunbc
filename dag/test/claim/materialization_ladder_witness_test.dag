module test.claim.materialization_ladder_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ladder_witness_note: String = "Each test is one cell of the operator's state x decision table (2026-07-09): the decision is a function of WHEN the redundancy is knowable and WHETHER what was knowable was prepared for. Errors fire only on knowable-but-unprepared; genuine emergence and declared triviality are typed acceptances, never silence. Fixtures mirror the live worked example: a workflow (isolated children) over jobs (shared-state steps), a retry frame (declared replay), a fleet frame (unbounded sibling runs over time)."

fn wf() -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: "workflow", kind: IsolatedChildrenFrame } }
fn job(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: SharedStateFrame } }
fn step(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: SharedStateFrame } }
fn retry(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: ReplayedFrame { attempts: 3 } } }
fn fleet() -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: "fleet", kind: UnboundedSiblingsFrame } }

fn demand(identity: String, site: List<std.materialization_ladder.Frame>, nature: DemandNature) -> FrameDemand {
  FrameDemand { identity: identity, site: site, nature: nature }
}

fn root_content_provider(id: String) -> CacheProvider {
  CacheProvider {
    id: id,
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: CasTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: CapacityBounded { limit: ByteCapacity { limit: EffectiveLimitUnobserved }, at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed } })
  }
}

fn rust_reference_provider() -> CacheProvider {
  CacheProvider {
    id: "rust-reference",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: ReferenceTier,
    retention: scope_released_retention(capacity: CapacityUnbounded)
  }
}

fn rust_clone_provider() -> CacheProvider {
  CacheProvider {
    id: "rust-clone",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: CopyTier,
    retention: scope_released_retention(capacity: CapacityUnbounded)
  }
}

fn edge(access: AccessMode, site: String) -> ValueConsumerEdge {
  ValueConsumerEdge { access: access, site: site }
}

fn usage(identity: String, consumers: List<ValueConsumerEdge>) -> ValueUsage {
  ValueUsage { identity: identity, consumers: consumers }
}

fn count_matching(vs: List<LadderVerdict>, matched: fn(LadderVerdict) -> Bool) -> Int {
  vs |> fold(init: 0, f: (acc, v) => if matched(v) { acc + 1 } else { acc })
}

fn two_steps_same_job() -> List<FrameDemand> {
  [
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build-a")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build-b")], nature: PureComputation)
  ]
}

fn three_jobs_same_build() -> List<FrameDemand> {
  [
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci_regen"), step(name: "build")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "rust_tests"), step(name: "sccache-warm")], nature: PureComputation)
  ]
}

test fn authored_duplication_in_shared_frame_is_error() -> Bool {
  let vs = materialization_ladder(
    demands: two_steps_same_job(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let flagged = count_matching(vs: vs, matched: v => verdict_is_authored_duplication(v: v, identity: "cargo-release-build", site_count: 2)) == 1
  flagged && !materialization_ladder_holds(
    demands: two_steps_same_job(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn cross_frame_duplicate_discharged_by_covering_provider() -> Bool {
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let discharged = count_matching(vs: vs, matched: v => verdict_is_discharged_by(v: v, identity: "cargo-release-build", provider_id: "sccache")) == 1
  discharged && materialization_ladder_holds(
    demands: three_jobs_same_build(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn obligation_without_provider_is_typed_refusal() -> Bool {
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: vs, matched: v => verdict_is_refused_no_provider(v: v, identity: "cargo-release-build")) == 1
  refused && !materialization_ladder_holds(
    demands: three_jobs_same_build(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn provider_scope_too_narrow_is_refused() -> Bool {
  let narrow = CacheProvider {
    id: "job-local-cache",
    scope: [wf(), job(name: "ci")],
    coverage: CoversAllComputations,
    tier: MemoTier { keying: ContentKeyed },
    retention: scope_released_retention(capacity: CapacityUnbounded)
  }
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [narrow],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_scope_too_narrow(v: v, provider_id: "job-local-cache")) == 1
}

test fn existence_keyed_provider_is_refused() -> Bool {
  let build_if_absent = CacheProvider {
    id: "build-if-absent",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: MemoTier { keying: ExistenceKeyed },
    retention: scope_released_retention(capacity: CapacityUnbounded)
  }
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [build_if_absent],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_existence_keyed(v: v, provider_id: "build-if-absent")) == 1
}

fn single_demand_under_retry() -> List<FrameDemand> {
  [demand(identity: "expensive-stage", site: [wf(), retry(name: "install-retry"), step(name: "attempt")], nature: PureComputation)]
}

test fn declared_replay_frame_obligates_up_front() -> Bool {
  let unprepared = materialization_ladder(
    demands: single_demand_under_retry(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: unprepared, matched: v => verdict_is_refused_no_provider(v: v, identity: "expensive-stage")) == 1
  let prepared = materialization_ladder(
    demands: single_demand_under_retry(),
    providers: [root_content_provider(id: "checkpoint-store")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let discharged = count_matching(vs: prepared, matched: v => verdict_is_discharged_by(v: v, identity: "expensive-stage", provider_id: "checkpoint-store")) == 1
  refused && discharged
}

fn single_demand_under_fleet() -> List<FrameDemand> {
  [demand(identity: "cargo-release-build", site: [fleet(), job(name: "run-2026-07-09"), step(name: "build")], nature: PureComputation)]
}

test fn unbounded_siblings_frame_obligates_up_front() -> Bool {
  let unprepared = materialization_ladder(
    demands: single_demand_under_fleet(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: unprepared, matched: v => verdict_is_refused_no_provider(v: v, identity: "cargo-release-build")) == 1
  refused && materialization_ladder_holds(
    demands: single_demand_under_fleet(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

