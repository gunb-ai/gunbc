module test.claim.materialization_ladder_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data ladder_witness_note: String = "Each test is one cell of the operator's state x decision table (2026-07-09): the decision is a function of WHEN the redundancy is knowable and WHETHER what was knowable was prepared for. Errors fire only on knowable-but-unprepared; genuine emergence and declared triviality are typed acceptances, never silence. Fixtures mirror the live worked example: a workflow (isolated children) over jobs (shared-state steps), a retry frame (declared replay), a fleet frame (unbounded sibling runs over time)."

fn wf() -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: "workflow", kind: IsolatedChildrenFrame } }
fn job(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: SharedStateFrame } }
fn step(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: SharedStateFrame } }
fn retry(name: String) -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: name, kind: ReplayedFrame { attempts: 3 } } }
fn fleet() -> std.materialization_ladder.Frame { std.materialization_ladder.Frame { name: "fleet", kind: UnboundedSiblingsFrame } }

fn demand(identity: String, site: List<std.materialization_ladder.Frame>, nature: DemandNature) -> FrameDemand {
  FrameDemand { identity: identity, site: site, nature: nature }
}

fn root_content_provider(id: String) -> CacheProvider {
  CacheProvider {
    id: id,
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: CasTier { keying: ContentKeyed },
    eviction: SpacePacked { budget: "10G local cache dir" }
  }
}

fn rust_reference_provider() -> CacheProvider {
  CacheProvider {
    id: "rust-reference",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: ReferenceTier,
    eviction: ScopeExit
  }
}

fn rust_clone_provider() -> CacheProvider {
  CacheProvider {
    id: "rust-clone",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: CopyTier,
    eviction: ScopeExit
  }
}

fn edge(access: AccessMode, site: String) -> ValueConsumerEdge {
  ValueConsumerEdge { access: access, site: site }
}

fn usage(identity: String, consumers: List<ValueConsumerEdge>) -> ValueUsage {
  ValueUsage { identity: identity, consumers: consumers }
}

fn count_matching(vs: List<LadderVerdict>, matched: fn(LadderVerdict) -> Bool) -> Int {
  vs |> fold(init: 0, f: (acc, v) => if matched(v) { acc + 1 } else { acc })
}

fn two_steps_same_job() -> List<FrameDemand> {
  [
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build-a")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build-b")], nature: PureComputation)
  ]
}

fn three_jobs_same_build() -> List<FrameDemand> {
  [
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "ci_regen"), step(name: "build")], nature: PureComputation),
    demand(identity: "cargo-release-build", site: [wf(), job(name: "rust_tests"), step(name: "sccache-warm")], nature: PureComputation)
  ]
}

test fn authored_duplication_in_shared_frame_is_error() -> Bool {
  let vs = materialization_ladder(
    demands: two_steps_same_job(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let flagged = count_matching(vs: vs, matched: v => verdict_is_authored_duplication(v: v, identity: "cargo-release-build", site_count: 2)) == 1
  flagged && !materialization_ladder_holds(
    demands: two_steps_same_job(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn cross_frame_duplicate_discharged_by_covering_provider() -> Bool {
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let discharged = count_matching(vs: vs, matched: v => verdict_is_discharged_by(v: v, identity: "cargo-release-build", provider_id: "sccache")) == 1
  discharged && materialization_ladder_holds(
    demands: three_jobs_same_build(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn obligation_without_provider_is_typed_refusal() -> Bool {
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: vs, matched: v => verdict_is_refused_no_provider(v: v, identity: "cargo-release-build")) == 1
  refused && !materialization_ladder_holds(
    demands: three_jobs_same_build(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn provider_scope_too_narrow_is_refused() -> Bool {
  let narrow = CacheProvider {
    id: "job-local-cache",
    scope: [wf(), job(name: "ci")],
    coverage: CoversAllComputations,
    tier: MemoTier { keying: ContentKeyed },
    eviction: ScopeExit
  }
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [narrow],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_scope_too_narrow(v: v, provider_id: "job-local-cache")) == 1
}

test fn existence_keyed_provider_is_refused() -> Bool {
  let build_if_absent = CacheProvider {
    id: "build-if-absent",
    scope: empty_frame_path,
    coverage: CoversAllComputations,
    tier: MemoTier { keying: ExistenceKeyed },
    eviction: ScopeExit
  }
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [build_if_absent],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_existence_keyed(v: v, provider_id: "build-if-absent")) == 1
}

fn single_demand_under_retry() -> List<FrameDemand> {
  [demand(identity: "expensive-stage", site: [wf(), retry(name: "install-retry"), step(name: "attempt")], nature: PureComputation)]
}

test fn declared_replay_frame_obligates_up_front() -> Bool {
  let unprepared = materialization_ladder(
    demands: single_demand_under_retry(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: unprepared, matched: v => verdict_is_refused_no_provider(v: v, identity: "expensive-stage")) == 1
  let prepared = materialization_ladder(
    demands: single_demand_under_retry(),
    providers: [root_content_provider(id: "checkpoint-store")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let discharged = count_matching(vs: prepared, matched: v => verdict_is_discharged_by(v: v, identity: "expensive-stage", provider_id: "checkpoint-store")) == 1
  refused && discharged
}

fn single_demand_under_fleet() -> List<FrameDemand> {
  [demand(identity: "cargo-release-build", site: [fleet(), job(name: "run-2026-07-09"), step(name: "build")], nature: PureComputation)]
}

test fn unbounded_siblings_frame_obligates_up_front() -> Bool {
  let unprepared = materialization_ladder(
    demands: single_demand_under_fleet(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: unprepared, matched: v => verdict_is_refused_no_provider(v: v, identity: "cargo-release-build")) == 1
  refused && materialization_ladder_holds(
    demands: single_demand_under_fleet(),
    providers: [root_content_provider(id: "sccache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn duplicated_measurement() -> List<FrameDemand> {
  [
    demand(identity: "cgroup-peak-measurement", site: [wf(), job(name: "ci"), step(name: "measure")], nature: FreshEffect),
    demand(identity: "cgroup-peak-measurement", site: [wf(), job(name: "rust_tests"), step(name: "measure")], nature: FreshEffect)
  ]
}

test fn fresh_effect_duplication_is_exempt_not_cached() -> Bool {
  let vs = materialization_ladder(
    demands: duplicated_measurement(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let exempt = count_matching(vs: vs, matched: v => verdict_is_exempt_fresh(v: v, identity: "cgroup-peak-measurement")) == 1
  exempt && materialization_ladder_holds(
    demands: duplicated_measurement(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

fn duplicated_world_read(declared: Bool) -> List<FrameDemand> {
  [
    demand(identity: "dns-lookup", site: [wf(), job(name: "ci"), step(name: "resolve")], nature: WorldRead { staleness_envelope_declared: declared }),
    demand(identity: "dns-lookup", site: [wf(), job(name: "rust_tests"), step(name: "resolve")], nature: WorldRead { staleness_envelope_declared: declared })
  ]
}

test fn world_read_without_envelope_is_refused() -> Bool {
  let vs = materialization_ladder(
    demands: duplicated_world_read(declared: false),
    providers: [root_content_provider(id: "dns-cache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_unmodeled_world_read(v: v, identity: "dns-lookup")) == 1
}

test fn world_read_with_declared_envelope_is_discharged() -> Bool {
  materialization_ladder_holds(
    demands: duplicated_world_read(declared: true),
    providers: [root_content_provider(id: "dns-cache")],
    cost_floor_exempt: no_cost_floor_exemptions
  )
}

test fn single_pure_demand_is_accepted_recompute() -> Bool {
  let one = [demand(identity: "one-off-transform", site: [wf(), job(name: "ci"), step(name: "emit")], nature: PureComputation)]
  let vs = materialization_ladder(demands: one, providers: no_cache_providers, cost_floor_exempt: no_cost_floor_exemptions)
  let accepted = count_matching(vs: vs, matched: v => verdict_is_accepted_single_recompute(v: v, identity: "one-off-transform")) == 1
  accepted && materialization_ladder_holds(demands: one, providers: no_cache_providers, cost_floor_exempt: no_cost_floor_exemptions)
}

fn duplicated_trivial_step() -> List<FrameDemand> {
  [
    demand(identity: "rustup-pin", site: [wf(), job(name: "ci"), step(name: "pin")], nature: PureComputation),
    demand(identity: "rustup-pin", site: [wf(), job(name: "ci_regen"), step(name: "pin")], nature: PureComputation),
    demand(identity: "rustup-pin", site: [wf(), job(name: "rust_tests"), step(name: "pin")], nature: PureComputation)
  ]
}

test fn zero_demand_pure_declaration_is_dead_computation() -> Bool {
  let declared = [
    DeclaredComputation { identity: "unused-transform", frame: [wf(), job(name: "ci")], nature: PureComputation },
    DeclaredComputation { identity: "cargo-release-build", frame: [wf(), job(name: "ci")], nature: PureComputation }
  ]
  let demands = [demand(identity: "cargo-release-build", site: [wf(), job(name: "ci"), step(name: "build")], nature: PureComputation)]
  let vs = ladder_zero_demand_verdicts(declared: declared, demands: demands)
  let dead = count_matching(vs: vs, matched: v => verdict_is_dead_computation(v: v, identity: "unused-transform")) == 1
  dead && ((vs |> count) == 1)
}

test fn zero_demand_effect_is_the_use_not_dead() -> Bool {
  let declared = [
    DeclaredComputation { identity: "deploy-dashboard", frame: [wf(), job(name: "deploy")], nature: IdempotentEffect },
    DeclaredComputation { identity: "cgroup-peak-measurement", frame: [wf(), job(name: "ci")], nature: FreshEffect }
  ]
  let vs = ladder_zero_demand_verdicts(declared: declared, demands: [])
  let deploy_ok = count_matching(vs: vs, matched: v => verdict_is_accepted_effect_is_the_use(v: v, identity: "deploy-dashboard")) == 1
  let measure_ok = count_matching(vs: vs, matched: v => verdict_is_accepted_effect_is_the_use(v: v, identity: "cgroup-peak-measurement")) == 1
  deploy_ok && measure_ok
}

data value_tier_witness_note: String = "Value-tier mirror witnesses: each asserts the refactored ladder verdict agrees cell-by-cell with v1.compiler.ownership semantics — make_decision (take_count = semantic_consumer_count: Consumed only), build_read_only_params (plurality = binding_fan_out: CarryAccess excluded; all access readonly), build_movable_set (borrows = whole_value_borrow_count: Read + Carry, NOT Project). The fold-accumulator case (carries + one take → demoted, v1 re-earns the move via FoldAccUnwrapProof) is asserted at the conservative pre-unwrap semantics."

fn rust_value_providers() -> List<CacheProvider> {
  [rust_reference_provider(), rust_clone_provider()]
}

test fn value_single_take_no_borrows_is_moved() -> Bool {
  let u = usage(identity: "graph", consumers: [edge(access: ConsumeAccess, site: "call:emit")])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_moved(v: v, identity: "graph") && value_materialization_is_green(v: v)
}

test fn value_plural_readonly_is_shared_by_reference() -> Bool {
  let u = usage(identity: "config", consumers: [
    edge(access: ReadAccess, site: "call:render"),
    edge(access: ReadAccess, site: "call:validate"),
    edge(access: ProjectAccess, site: "field:port")
  ])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_shared_by_reference(v: v, identity: "config", provider_id: "rust-reference", reader_count: 3)
}

test fn value_take_with_borrows_is_priced_demotion_to_copy() -> Bool {
  let u = usage(identity: "acc", consumers: [
    edge(access: ReadAccess, site: "call:report"),
    edge(access: ConsumeAccess, site: "call:finish")
  ])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_demoted_to_copy(v: v, identity: "acc", copies: 1)
}

test fn value_fold_carry_excluded_from_plurality_but_blocks_move() -> Bool {
  let u = usage(identity: "fold-acc", consumers: [
    edge(access: CarryAccess, site: "fold:step-1"),
    edge(access: CarryAccess, site: "fold:step-2"),
    edge(access: ConsumeAccess, site: "fold:final")
  ])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_demoted_to_copy(v: v, identity: "fold-acc", copies: 1)
}

test fn value_double_take_is_affine_refusal_not_a_caching_opportunity() -> Bool {
  let u = usage(identity: "payload", consumers: [
    edge(access: ConsumeAccess, site: "call:send"),
    edge(access: ConsumeAccess, site: "call:archive")
  ])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_refused_affine(v: v, identity: "payload", take_count: 2) && !value_materialization_is_green(v: v)
}

test fn value_reference_share_requires_the_carrier_capability() -> Bool {
  let u = usage(identity: "config", consumers: [
    edge(access: ReadAccess, site: "call:render"),
    edge(access: ReadAccess, site: "call:validate")
  ])
  let v = value_materialization(usage: u, providers: no_cache_providers)
  value_verdict_is_refused_needing_reference(v: v, identity: "config") && !value_materialization_is_green(v: v)
}

test fn value_demotion_requires_declared_copy_provider() -> Bool {
  let u = usage(identity: "acc", consumers: [
    edge(access: ReadAccess, site: "call:report"),
    edge(access: ConsumeAccess, site: "call:finish")
  ])
  let v = value_materialization(usage: u, providers: [rust_reference_provider()])
  value_verdict_is_refused_needing_copy(v: v, identity: "acc") && !value_materialization_is_green(v: v)
}

test fn value_zero_use_is_dead() -> Bool {
  let u = usage(identity: "unused", consumers: [])
  let v = value_materialization(usage: u, providers: rust_value_providers())
  value_verdict_is_dead(v: v, identity: "unused") && !value_materialization_is_green(v: v)
}

test fn reference_provider_cannot_discharge_isolation_obligation() -> Bool {
  let vs = materialization_ladder(
    demands: three_jobs_same_build(),
    providers: [rust_reference_provider()],
    cost_floor_exempt: no_cost_floor_exemptions
  )
  count_matching(vs: vs, matched: v => verdict_is_refused_no_provider(v: v, identity: "cargo-release-build")) == 1
}

test fn below_cost_floor_duplication_is_typed_acceptance() -> Bool {
  let vs = materialization_ladder(
    demands: duplicated_trivial_step(),
    providers: no_cache_providers,
    cost_floor_exempt: ["rustup-pin"]
  )
  let accepted = count_matching(vs: vs, matched: v => verdict_is_accepted_below_cost_floor(v: v, identity: "rustup-pin")) == 1
  let red_without_roster = !materialization_ladder_holds(
    demands: duplicated_trivial_step(),
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  accepted && red_without_roster
}

test fn conflicting_natures_on_one_identity_are_refused() -> Bool {
  let conflicted = [
    demand(identity: "probe-metric", site: [wf(), job(name: "run-a"), step(name: "measure")], nature: PureComputation),
    demand(identity: "probe-metric", site: [wf(), job(name: "run-b"), step(name: "measure")], nature: FreshEffect)
  ]
  let vs = materialization_ladder(
    demands: conflicted,
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  let refused = count_matching(vs: vs, matched: v => verdict_is_refused_nature_conflict(v: v, identity: "probe-metric")) == 1
  let red = !materialization_ladder_holds(
    demands: conflicted,
    providers: no_cache_providers,
    cost_floor_exempt: no_cost_floor_exemptions
  )
  refused && red
}
