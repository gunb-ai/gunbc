module test.claim.nested_fold_generic_param_emit


test fn witness_flat_fold_resolves_generic_scale() -> Bool {
  let batch = [std.measure.time_measure(count: 10)]
  std.measure.measure_count(m: std.realization_measurement.schedule_batch_critical_path(batch_times: batch)) == 10
}

test fn witness_nested_fold_resolves_generic_scale() -> Bool {
  let batches = [
    [std.measure.time_measure(count: 40), std.measure.time_measure(count: 5)],
    [std.measure.time_measure(count: 20)],
  ]
  std.measure.measure_count(m: std.realization_measurement.schedule_critical_path_time(batch_times: batches)) == 60
}

