module test.claim.machine_shape_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data rtx5090_domain: std.machine_shape.DomainId = "rtx5090" as std.machine_shape.DomainId
data rtx5090_register_level: std.machine_shape.LevelId = "sm-register-file" as std.machine_shape.LevelId
data rtx5090_shared_level: std.machine_shape.LevelId = "sm-shared-memory" as std.machine_shape.LevelId
data rtx5090_device_level: std.machine_shape.LevelId = "device-dram" as std.machine_shape.LevelId

data dangling_domain: std.machine_shape.DomainId = "missing-domain" as std.machine_shape.DomainId

data rtx5090_pcie_link: extdeps.storage.types.PcieLink = extdeps.storage.types.PcieLink { generation: extdeps.storage.types.Gen4, lane_count: 16 }

data m5_domain: std.machine_shape.DomainId = "apple-m5-gpu" as std.machine_shape.DomainId
data m5_register_level: std.machine_shape.LevelId = "sm-register-file" as std.machine_shape.LevelId
data m5_shared_level: std.machine_shape.LevelId = "sm-shared-memory" as std.machine_shape.LevelId
data m5_device_level: std.machine_shape.LevelId = "device-dram" as std.machine_shape.LevelId

data rtx5090_sm_shared_bytes: std.nat.Nat = 102400
data rtx5090_sm_register_bytes: std.nat.Nat = 262144

fn shape_from_rtx5090_catalog() -> std.machine_shape.MachineShape {
  match extdeps.gpu.machine_shape.gpu_shape_from_catalog(input: extdeps.gpu.machine_shape.FromGpuModelCatalog {
    domain: rtx5090_domain,
    register_level: rtx5090_register_level,
    shared_level: rtx5090_shared_level,
    device_level: rtx5090_device_level,
    row: extdeps.gpu.nvidia.nvidia_rtx_5090_catalog,
  }) {
    std.machine_shape.MachineShapeOk { shape: s } => s
    std.machine_shape.MachineShapeRefused { cause: _ } => std.machine_shape.MachineShape { domains: [], edges: [] }
  }
}

test fn catalog_derivation_matches_row() -> Bool {
  let shape = shape_from_rtx5090_catalog()
  let memory = shape.domains.first().memory
  let device = memory.skip(n: std.types.list_length(items: memory) - 1).first()
  match std.machine_shape.machine_shape_domain_lane_count(shape: shape) {
    Present { value: lanes } =>
      std.measure.hardware_thread_count_value(t: lanes) == 21760
        && std.measure.byte_size_count(b: device.capacity) == std.measure.byte_size_count(b: nvidia_rtx_5090_catalog.memory.capacity)
        && match device.bandwidth {
          Present { value: bw } =>
            std.measure.bandwidth_count(b: bw) == std.measure.bandwidth_count(b: nvidia_rtx_5090_catalog.memory_bandwidth)
          Absent => false
        }
    Absent => false
  }
}

test fn minimal_grant_is_single_domain() -> Bool {
  std.machine_shape.machine_shape_is_single_domain(shape: shape_from_rtx5090_catalog())
}

fn shape_from_m5_catalog() -> std.machine_shape.MachineShape {
  match extdeps.gpu.machine_shape.gpu_shape_from_catalog(input: extdeps.gpu.machine_shape.FromGpuModelCatalog {
    domain: m5_domain,
    register_level: m5_register_level,
    shared_level: m5_shared_level,
    device_level: m5_device_level,
    row: extdeps.gpu.apple.apple_m5_gpu_catalog,
  }) {
    std.machine_shape.MachineShapeOk { shape: s } => s
    std.machine_shape.MachineShapeRefused { cause: _ } => std.machine_shape.MachineShape { domains: [], edges: [] }
  }
}

test fn gpu_sm_cache_levels_integrated_when_cited() -> Bool {
  let memory = shape_from_rtx5090_catalog().domains.first().memory
  std.types.list_length(items: memory) == 3
    && std.measure.byte_size_count(b: memory.first().capacity) == rtx5090_sm_register_bytes
    && std.measure.byte_size_count(b: memory.skip(n: 1).first().capacity) == rtx5090_sm_shared_bytes
}

test fn gpu_sm_cache_absent_when_ungranted() -> Bool {
  std.types.list_length(items: shape_from_m5_catalog().domains.first().memory) == 1
}

test fn energy_derived_not_stored() -> Bool {
  std.measure.joule_count(j: std.measure.energy_from_power_and_time(power: std.measure.watt(count: 100), time: std.measure.second(count: 5))) == 500
}

test fn pcie_interconnect_link_derives_bandwidth() -> Bool {
  std.measure.bandwidth_count(b: extdeps.storage.types.pcie_interconnect_link(link: rtx5090_pcie_link).bandwidth) == std.measure.bandwidth_count(b: extdeps.storage.types.pcie_link_bandwidth(link: rtx5090_pcie_link))
}

test fn red_dangling_domain_refuses() -> Bool {
  let good = shape_from_rtx5090_catalog()
  let bad = std.machine_shape.MachineShape {
    domains: good.domains
    edges: [
      std.machine_shape.LinkEdge {
        from: rtx5090_domain
        to: dangling_domain
        link: extdeps.storage.types.pcie_interconnect_link(link: rtx5090_pcie_link)
      }
    ]
  }
  match std.machine_shape.machine_shape_validate(shape: bad) {
    std.machine_shape.MachineShapeRefused { cause: std.machine_shape.UnknownDomain { id: id } } => id == dangling_domain
    std.machine_shape.MachineShapeRefused { cause: std.machine_shape.UnknownLevel { owner: _, level: _ } } => false
    std.machine_shape.MachineShapeOk { shape: _ } => false
  }
}

test fn red_dangling_level_refuses() -> Bool {
  let bad_level: std.machine_shape.LevelId = "missing-level" as std.machine_shape.LevelId
  let bad = std.machine_shape.MachineShape {
    domains: shape_from_rtx5090_catalog().domains
    edges: [
      std.machine_shape.SharedLevelEdge {
        owner: rtx5090_domain
        sharer: rtx5090_domain
        level: bad_level
      }
    ]
  }
  match std.machine_shape.machine_shape_validate(shape: bad) {
    std.machine_shape.MachineShapeRefused { cause: std.machine_shape.UnknownLevel { owner: o, level: l } } =>
      o == rtx5090_domain && l == bad_level
    std.machine_shape.MachineShapeRefused { cause: std.machine_shape.UnknownDomain { id: _ } } => false
    std.machine_shape.MachineShapeOk { shape: _ } => false
  }
}

