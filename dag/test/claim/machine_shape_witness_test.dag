module test.claim.machine_shape_witness

import extdeps.gpu.nvidia { nvidia_rtx_5090_catalog }
import extdeps.gpu.types { GpuModelCatalogRow }
import extdeps.catalog_estimate { Exact, Interval, estimate_floor }
import extdeps.storage.types { PcieLink, PcieGeneration, Gen4 }
import std.measure {
  ByteSize,
  Bandwidth,
  HardwareThreadCount,
  hardware_thread_count,
  hardware_thread_count_value,
  byte_size,
  byte_size_count,
  bandwidth,
  bandwidth_count,
  watt,
  second,
  energy_from_power_and_time,
  joule_count,
  watt_count,
  second_count,
  hertz,
  hertz_count,
}
import std.machine_shape {
  DomainId,
  LevelId,
  MachineShape,
  ExecutionDomain,
  ExecutionShape,
  MemoryLevel,
  IndependentLanes,
  LinkEdge,
  SharedLevelEdge,
  PcieAttach,
  MachineShapeOk,
  MachineShapeRefused,
  UnknownDomain,
  UnknownLevel,
  ShapeFromCatalogInput,
  FromGpuModelCatalog,
  shape_from_catalog,
  machine_shape_validate,
  machine_shape_is_single_domain,
  machine_shape_domain_lane_count,
  machine_shape_device_level_capacity,
  machine_shape_device_level_bandwidth,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data rtx5090_domain: DomainId = "rtx5090" as DomainId
data rtx5090_device_level: LevelId = "device-dram" as LevelId

data dangling_domain: DomainId = "missing-domain" as DomainId

fn shape_from_rtx5090_catalog() -> MachineShape {
  match shape_from_catalog(input: FromGpuModelCatalog {
    domain: rtx5090_domain,
    device_level: rtx5090_device_level,
    row: nvidia_rtx_5090_catalog,
  }) {
    MachineShapeOk { shape: s } => s
    MachineShapeRefused { cause: _ } => MachineShape { domains: [], edges: [] }
  }
}

fn catalog_derivation_matches_row() -> Bool {
  let shape = shape_from_rtx5090_catalog()
  match machine_shape_domain_lane_count(shape: shape) {
    Present { value: lanes } =>
      hardware_thread_count_value(t: lanes) == 21760
        && match machine_shape_device_level_capacity(shape: shape) {
          Present { value: cap } =>
            byte_size_count(b: cap) == byte_size_count(b: nvidia_rtx_5090_catalog.memory.capacity)
              && match machine_shape_device_level_bandwidth(shape: shape) {
                Present { value: bw } =>
                  bandwidth_count(b: bw) == bandwidth_count(b: nvidia_rtx_5090_catalog.memory_bandwidth)
                Absent => false
              }
          Absent => false
        }
    Absent => false
  }
}

fn minimal_grant_is_single_domain() -> Bool {
  machine_shape_is_single_domain(shape: shape_from_rtx5090_catalog())
}

fn energy_derived_not_stored() -> Bool {
  joule_count(j: energy_from_power_and_time(power: watt(count: 100), time: second(count: 5))) == 500
}

fn catalog_estimate_exact_on_row() -> Bool {
  match nvidia_rtx_5090_catalog.boost_clock {
    Present { value: Exact { value: hz } } =>
      hertz_count(h: estimate_floor(estimate: Exact { value: hz })) == 2410000000
    Present { value: Interval { lo: _, hi: _ } } => false
    Absent => false
  }
}

fn catalog_estimate_interval_floor() -> Bool {
  hertz_count(
    h: estimate_floor(
      estimate: Interval { lo: hertz(count: 1500000000), hi: hertz(count: 2410000000) }
    )
  ) == 1500000000
}

fn red_dangling_domain_refuses() -> Bool {
  let good = shape_from_rtx5090_catalog()
  let bad = MachineShape {
    domains: good.domains
    edges: [
      LinkEdge {
        from: rtx5090_domain
        to: dangling_domain
        link: PcieAttach { link: PcieLink { generation: Gen4, lane_count: 16 } }
      }
    ]
  }
  match machine_shape_validate(shape: bad) {
    MachineShapeRefused { cause: UnknownDomain { id: id } } => id == dangling_domain
    MachineShapeRefused { cause: UnknownLevel { owner: _, level: _ } } => false
    MachineShapeOk { shape: _ } => false
  }
}

fn red_dangling_level_refuses() -> Bool {
  let bad_level: LevelId = "missing-level" as LevelId
  let bad = MachineShape {
    domains: shape_from_rtx5090_catalog().domains
    edges: [
      SharedLevelEdge {
        owner: rtx5090_domain
        sharer: rtx5090_domain
        level: bad_level
      }
    ]
  }
  match machine_shape_validate(shape: bad) {
    MachineShapeRefused { cause: UnknownLevel { owner: o, level: l } } =>
      o == rtx5090_domain && l == bad_level
    MachineShapeRefused { cause: UnknownDomain { id: _ } } => false
    MachineShapeOk { shape: _ } => false
  }
}

test fn machine_shape_witnesses() -> Bool {
  catalog_derivation_matches_row()
    && minimal_grant_is_single_domain()
    && energy_derived_not_stored()
    && catalog_estimate_exact_on_row()
    && catalog_estimate_interval_floor()
    && red_dangling_domain_refuses()
    && red_dangling_level_refuses()
}
