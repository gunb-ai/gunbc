module test.claim.rest_credential_refusal_witness

import std.types { String, Bool, Int, NonEmptyStr }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import std.access { AccessRefusal, AccessEvidenceAbsent }
import extdeps.transports.rest {
  RestRefusal, RestCredentialRefused, RestTransportRefused,
  RestReadExchange, RestMutationExchange, classify_rest_refusal,
  RestExchangeUnreached, RestExchangeCommitAmbiguous, rest_exchange_refusal_text,
}
import extdeps.github.auth { github_token_absent_refusal }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// A CREDENTIAL REFUSED BEFORE DISPATCH IS NOT AN UNCERTAIN WRITE. The interface is
// extdeps.transports.rest classify_rest_refusal and its renderer, handed supplied refusals; the
// variable name stands for the selected source and the token is never present at all, so its
// absence from every rendering is the confidentiality reading.

data absent: RestRefusal = github_token_absent_refusal(variable: "GITHUB_TOKEN" as NonEmptyStr)

data transport_failed: RestRefusal = RestTransportRefused { cause: "connection reset" as NonEmptyStr }

fn is_unreached(r: RestRefusal, mutation: Bool) -> Bool {
  let standing = if mutation { RestMutationExchange { refusal: r } } else { RestReadExchange { refusal: r } }
  match classify_rest_refusal(standing: standing) {
    RestExchangeUnreached { cause: _ } => true
    _ => false
  }
}

fn is_ambiguous(r: RestRefusal) -> Bool {
  match classify_rest_refusal(standing: RestMutationExchange { refusal: r }) {
    RestExchangeCommitAmbiguous { detail: _ } => true
    _ => false
  }
}

// The discriminating pair: the same mutation is commit-ambiguous when the transport failed and
// established as unsent when the credential was refused before dispatch.
test fn a_mutation_refused_before_dispatch_is_unsent_and_a_transport_failure_is_not() -> Bool {
  is_unreached(r: absent, mutation: true)
    && !is_ambiguous(r: absent)
    && is_ambiguous(r: transport_failed)
    && !is_unreached(r: transport_failed, mutation: true)
}

test fn a_read_refused_before_dispatch_is_unreached() -> Bool {
  is_unreached(r: absent, mutation: false)
}

// The typed cause survives to the caller: the refusal is AccessEvidenceAbsent naming the selected
// variable, not a transport string.
test fn the_absent_token_refusal_is_typed_evidence_absence() -> Bool {
  match absent {
    RestCredentialRefused { refusal: AccessRefusal { cause: AccessEvidenceAbsent { evidence: e }, location: _ } } => e == "GITHUB_TOKEN"
    _ => false
  }
}

test fn the_rendered_refusal_names_the_source_and_says_nothing_was_sent() -> Bool {
  let text = rest_exchange_refusal_text(refusal: classify_rest_refusal(standing: RestMutationExchange { refusal: absent }))
  contains(text, "GITHUB_TOKEN") && contains(text, "not sent")
}

// ── ONE AUTH AUTHORITY PER SERVICE, AT THE SHARED PARSE ─────────────────────────────────────
// A probe source handed to the compiler. The control declares only the caller's input and must
// compile; the probe adds an environment source beside it and must be refused, so the red is the
// pairing and not the service.

fn parse_refusals(c: CompileDiagnosticCensus, naming: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => r.blocking && (r.diagnostic_class as String) == "ParseError" && contains(r.subject_name, naming))
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

data service_head: String = "module probe_one_auth_authority\nimport std.types { AuthScheme, Bearer, String }\nservice probe.Svc {\n  config {\n    endpoint: \"https://unreachable.invalid.example\"\n    auth: Bearer\n    auth_input: token\n"

data service_tail: String = "  }\n  operation GetData {\n    input { token: String }\n    output { data: String }\n    transport rest { method: GET, path: \"/data\" }\n    response {\n      200 => String\n    }\n  }\n}\n"

test fn a_service_with_only_the_caller_input_compiles() -> Bool {
  parse_refusals(c: compile_dag_diagnostic_census(source: concat(service_head, service_tail)), naming: "") == 0
}

test fn a_service_declaring_an_environment_source_beside_its_input_is_refused() -> Bool {
  parse_refusals(c: compile_dag_diagnostic_census(source: concat(concat(service_head, "    auth_source: EnvVar { name: \"GITHUB_TOKEN\" }\n"), service_tail)), naming: "declares both `auth_input` and `auth_source`") == 1
}
