module test.claim.dependency_facts_native_equivalence_witness_test

// THE EQUIVALENCE CONTROL for native-realizing `dependency_resolution_facts_live`.
//
// The repair moved a composition, not a fact: the interpreted union+dedup over the two producers
// measured 104,943ms against 151ms for the two producers themselves, so the composition was moved
// into the host. A cost repair that changes WHICH rows come back is not a cost repair, so the
// native producer is held to the retained interpreted spelling
// (`dependency_resolution_facts_interpreted_reference`) row for row, in order, over the SAME live
// inputs — not to a remembered count and not to a golden string.
//
// WHY ORDERED AND NOT SET-EQUAL. Order is observable: `module_target_index_from` conses targets in
// arrival order and downstream confirmation walks those lists, so two producers that agree as sets
// and disagree in order are two different answers. Reference-first is the specific order the
// interpreted spelling established and the native arm must keep it.
//
// WHY `target_declared` IS ASSERTED SEPARATELY. It is the field the partition-closure census exists
// to judge — an unresolved target is exactly a `target_declared: false` row — so a dedup that
// collapsed the two declared-ness variants of one (path, target) pair would still satisfy a
// path/target comparison while destroying the census's subject.

import std.types { Bool, String, List }
import std.integer { Int }
import std.algebra { Cons, Empty }
import v2.lens.module_graph {
  ModuleDependencyEdge,
  dependency_resolution_facts_live,
  dependency_resolution_facts_interpreted_reference,
}
import gunbc.stage0_partition_closure {
  partition_closure_pool_roots,
  partition_closure_exclude_substrings,
}

data equivalence_subject_note: String = "Both sides read the SAME live pool roots the partition-closure census reads, because the claim is about the producer the census actually consumes. A narrowed pool would prove the arms agree on a population neither consumer uses."

fn native_rows() -> List<ModuleDependencyEdge> {
  dependency_resolution_facts_live(
    pool_roots: partition_closure_pool_roots,
    importer_roots: partition_closure_pool_roots,
    exclude_substrings: partition_closure_exclude_substrings
  )
}

fn interpreted_rows() -> List<ModuleDependencyEdge> {
  dependency_resolution_facts_interpreted_reference(
    pool_roots: partition_closure_pool_roots,
    importer_roots: partition_closure_pool_roots,
    exclude_substrings: partition_closure_exclude_substrings
  )
}

fn edge_eq(a: ModuleDependencyEdge, b: ModuleDependencyEdge) -> Bool {
  a.path == b.path
    && a.target_module == b.target_module
    && a.target_declared == b.target_declared
}

type ZipAcc {
  rest: List<ModuleDependencyEdge>
  ok: Bool
  compared: Int
}

// Walks the two lists in lockstep. A length disagreement surfaces as an empty `rest` with items
// still arriving on the left, which sets ok false rather than silently comparing a prefix.
fn ordered_match(left: List<ModuleDependencyEdge>, right: List<ModuleDependencyEdge>) -> ZipAcc {
  left |> fold(init: ZipAcc { rest: right, ok: true, compared: 0 }, f: fn(a, l) {
    match a.rest {
      Cons { head: r, tail: t } =>
        ZipAcc {
          rest: t,
          ok: a.ok && edge_eq(a: l, b: r),
          compared: a.compared + 1
        }
      Empty => ZipAcc { rest: [], ok: false, compared: a.compared }
    }
  })
}

fn count_rows(xs: List<ModuleDependencyEdge>) -> Int {
  xs |> fold(init: 0, f: fn(a, x) { a + 1 })
}

test fn native_matches_interpreted_row_for_row_in_order() -> Bool {
  let m = ordered_match(left: native_rows(), right: interpreted_rows())
  match m.rest {
    Empty => m.ok && m.compared > 0
    Cons { head: _, tail: _ } => false
  }
}

test fn native_population_is_nonempty() -> Bool {
  count_rows(xs: native_rows()) > 0
}

// The declared-ness axis, asserted on its own so a collapse of the two variants of one
// (path, target) pair cannot hide behind a path/target-only comparison.
test fn native_preserves_target_declared_distribution() -> Bool {
  let native_declared = native_rows()
    |> fold(init: 0, f: fn(a, e) { if e.target_declared { a + 1 } else { a } })
  let interpreted_declared = interpreted_rows()
    |> fold(init: 0, f: fn(a, e) { if e.target_declared { a + 1 } else { a } })
  let native_total = count_rows(xs: native_rows())
  let interpreted_total = count_rows(xs: interpreted_rows())
  native_declared == interpreted_declared && native_total == interpreted_total
}
