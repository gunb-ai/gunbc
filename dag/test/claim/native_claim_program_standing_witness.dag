module test.claim.native_claim_program_standing_witness

import std.types { Int, String, Bool }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.native_claim_program { native_claim_program_standing }

// gunbc.native_claim_program native_claim_program_standing, at ITS interface: reports are SUPPLIED
// here, because the claim is what the reader decides for a report of each shape, not whether some
// program produces one (DESIGN section 3, a witness discriminates at one interface). THE REAL PATH
// IS RUN ELSEWHERE, as the pairing obligation requires: `gunbc test
// //gunbc/instruments:native-crypto-vectors` emits, builds and runs the NativeClaimDriver program
// and hands its actual stdout and status to this same fold.
//
// Each arm below is a way a run can go wrong that must NOT read as a pass: a missing row, a
// duplicated row, a row the roster never named, a status the rows contradict, a signal, and a report
// with no roster at all. The two positive arms (held, not held) are what makes the refusals
// evidence: a reader that refused everything would fail them.

fn code_of(e: ProcessExit) -> Int {
  match e {
    ExitSuccess => 0
    ExitFailure { code: c, reason: _ } => c
  }
}

data two_held: String = "roster a,b\ncase a held observed=x\ncase b held observed=y\n"
data one_not_held: String = "roster a,b\ncase a held observed=x\ncase b not_held observed=y\n"

test fn every_row_held_with_status_zero_is_held() -> Bool {
  code_of(e: native_claim_program_standing(stdout: two_held, status: 0)) == 0
}

test fn a_not_held_row_with_status_one_is_an_observation_that_did_not_hold() -> Bool {
  code_of(e: native_claim_program_standing(stdout: one_not_held, status: 1)) == 1
}

test fn a_roster_case_with_no_row_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a,b\ncase a held observed=x\n", status: 0)) == 2
}

test fn a_case_reported_twice_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a,b\ncase a held observed=x\ncase a held observed=x\ncase b held observed=y\n", status: 0)) == 2
}

test fn a_row_the_roster_never_named_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a\ncase a held observed=x\ncase z held observed=q\n", status: 0)) == 2
}

test fn status_zero_beside_a_not_held_row_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: one_not_held, status: 0)) == 2
}

test fn status_one_with_every_row_held_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: two_held, status: 1)) == 2
}

test fn a_signal_is_no_observation_even_with_every_row_held() -> Bool {
  code_of(e: native_claim_program_standing(stdout: two_held, status: -1)) == 2
}

test fn a_report_with_no_roster_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "case a held observed=x\n", status: 0)) == 2
}

// ── THE WHOLE-REPORT GRAMMAR (review 5311497200 of gunbc#12250). Each of these was ACCEPTED by the
// earlier reader, which flat-mapped unparseable lines to nothing; each must now be no observation.

test fn a_row_with_an_unknown_verdict_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a,z\ncase a held observed=x\ncase z nonsense observed=q\n", status: 0)) == 2
}

test fn a_row_without_an_observed_field_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a\ncase a held\n", status: 0)) == 2
}

test fn a_noise_line_among_the_rows_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a\ncase a held observed=x\nwarning: something\n", status: 0)) == 2
}

test fn a_second_roster_line_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a\ncase a held observed=x\nroster a,b\n", status: 0)) == 2
}

test fn a_roster_naming_an_identity_twice_is_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: "roster a,a\ncase a held observed=x\n", status: 0)) == 2
}

// ── THE TERMINAL (same review): only 0 with every row held is held. The closed NativeClaimTerminal
// means a program cannot produce any other code, but the reader refuses one anyway, so a regression
// in the rendered main surfaces here instead of reading as held.

test fn an_out_of_vocabulary_status_is_no_observation_even_with_every_row_held() -> Bool {
  code_of(e: native_claim_program_standing(stdout: two_held, status: 3)) == 2
}

test fn the_programs_own_no_observation_terminal_stays_no_observation() -> Bool {
  code_of(e: native_claim_program_standing(stdout: two_held, status: 2)) == 2
}
