module test.claim.compute_board_spice_projection_witness

import std.types { String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.extdeps.formats.spice { Ground }
import product.compute_board.spice_projection {
  BoardSlice,
  CapacitiveElement,
  ElectricalModelAbsent,
  ElectricalModelCited,
  IdealLumped,
  ModelFidelityNotEmittable,
  VendorSubcircuit,
  ElectricalModelUnavailable,
  ResistiveElement,
  SliceElement,
  SliceSource,
  SpiceSliceProjected,
  SpiceSliceRefused,
  named_node,
  project_slice_to_spice,
  projected_deck_text,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

fn list_count<T>(xs: List<T>) -> Int {
  fold(xs, init: 0, f: (acc, _) => acc + 1)
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A SYNTHETIC fixture authority, deliberately unresolvable. An earlier revision cited Ucamco's
// Gerber page as the electrical-model authority for a passive, which is a real page about an
// unrelated subject — a fixture citation that reads as grounded and is not. Where a fixture
// needs an authority-shaped value and no real authority is being claimed, the locator says so.
data synthetic_fixture_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "example.invalid/synthetic-witness-fixture-not-a-real-model-authority"
  }
}

// Symbols are restricted to the spelling table v2.extdeps.formats.spice actually carries
// (r1 / c1 / v1 / n1). That is a real bound on the emitter, so the fixture is sized to what
// can be emitted rather than to what would look realistic — a larger deck would exercise no
// further behaviour and would only be prettier.
fn modelled_resistor() -> SliceElement {
  SliceElement {
    designator: ^r1,
    part: "series sense resistor",
    kind: ResistiveElement,
    n_plus: named_node(name: ^n1),
    n_minus: Ground,
    value_lexeme: "10k",
    model: ElectricalModelCited {
      model_card: "ideal lumped passive at declared fidelity",
      fidelity: IdealLumped,
      authority: synthetic_fixture_authority,
    },
  }
}

fn modelled_capacitor() -> SliceElement {
  SliceElement {
    designator: ^c1,
    part: "bulk decoupling capacitor",
    kind: CapacitiveElement,
    n_plus: named_node(name: ^n1),
    n_minus: Ground,
    value_lexeme: "100n",
    model: ElectricalModelCited {
      model_card: "ideal lumped passive at declared fidelity",
      fidelity: IdealLumped,
      authority: synthetic_fixture_authority,
    },
  }
}

fn unmodelled_capacitor() -> SliceElement {
  SliceElement {
    designator: ^c1,
    part: "bulk decoupling capacitor",
    kind: CapacitiveElement,
    n_plus: named_node(name: ^n1),
    n_minus: Ground,
    value_lexeme: "100n",
    model: ElectricalModelAbsent,
  }
}

fn vendor_subcircuit_capacitor() -> SliceElement {
  SliceElement {
    designator: ^c1,
    part: "bulk decoupling capacitor",
    kind: CapacitiveElement,
    n_plus: named_node(name: ^n1),
    n_minus: Ground,
    value_lexeme: "100n",
    model: ElectricalModelCited {
      model_card: "vendor ESR/ESL subcircuit",
      fidelity: VendorSubcircuit,
      authority: synthetic_fixture_authority,
    },
  }
}

fn rail_source() -> SliceSource {
  SliceSource { designator: ^v1, node: named_node(name: ^n1), value_lexeme: "12" }
}

fn slice_with(elements: List<SliceElement>) -> BoardSlice {
  BoardSlice { title: "standby rail slice", source: rail_source(), elements: elements }
}

// POSITIVE CONTROL ON THE PROJECTED NETLIST STRUCTURE — one source statement plus one per
// element. It asserts the deck was built, not merely that the projected arm was reached.
//
// WHY NOT ON EMITTED BYTES, stated precisely because an earlier revision of this file got the
// diagnosis wrong TWICE. The first attempt blamed spice_emit outright. The second blamed this
// lane for passing a native list literal where the module wants its Cons/Empty free monoid —
// which was a real bug here and is fixed — and then claimed the byte receipt was therefore
// available. It is not. What execution actually shows: v2.extdeps.formats.spice's OWN golden
// fixture, spice_rc_tran_deck, emits correctly through spice_emit_ngspice inside its own test
// (both its witnesses pass, untouched), and that SAME fixture returns a value string_contains
// rejects as a Variant when spice_emit is called on it FROM THIS MODULE. Same input, same
// function, different calling module, different result. So the boundary is cross-module, not
// the deck and not the emitter's logic — which is a materially different and more serious
// finding than either earlier description, and it is not repaired here.
test fn w_modelled_slice_projects_expected_statement_count() -> Bool {
  match project_slice_to_spice(slice: slice_with(elements: [modelled_resistor(), modelled_capacitor()])) {
    SpiceSliceProjected { netlist: n } => list_count(xs: n.body) == 3
    SpiceSliceRefused { cause: _ } => false
  }
}

// THE WALL. One element loses its model and the whole slice refuses, naming the part. The
// forbidden behaviour is not an error message — it is a deck that still emits, with an ideal
// part quietly standing in for the one we could not model.
test fn w_unmodelled_element_refuses_and_emits_nothing() -> Bool {
  let projection = project_slice_to_spice(
    slice: slice_with(elements: [modelled_resistor(), unmodelled_capacitor()])
  )
  match projection {
    SpiceSliceRefused { cause: c } =>
      match c {
        ElectricalModelUnavailable { part: p } => {
          let emitted = projected_deck_text(projection: projection)
          p == "bulk decoupling capacitor" && match emitted { Absent => true, _ => false }
        }
        ModelFidelityNotEmittable { part: _, model_card: _ } => false
      }
    SpiceSliceProjected { netlist: _ } => false
  }
}

// The discriminating pair: the SAME slice differing only in model standing must land on
// opposite arms. Without this, the refusal claim above is satisfied by a projection that
// refuses everything.
test fn w_model_standing_alone_decides_the_arm() -> Bool {
  let modelled = project_slice_to_spice(slice: slice_with(elements: [modelled_capacitor()]))
  let unmodelled = project_slice_to_spice(slice: slice_with(elements: [unmodelled_capacitor()]))
  match modelled {
    SpiceSliceProjected { netlist: _ } =>
      match unmodelled {
        SpiceSliceRefused { cause: _ } => true
        SpiceSliceProjected { netlist: _ } => false
      }
    SpiceSliceRefused { cause: _ } => false
  }
}

// THE OVERCLAIM THIS ARM CLOSES. A cited vendor subcircuit cannot be emitted by this
// projection — it emits no .SUBCKT or .MODEL binding — so it REFUSES rather than emitting an
// ideal "C1 n1 0 100n" line while the type claims a vendor model stands behind it. That
// silent downgrade is the same substitution the absent-model wall forbids, and an earlier
// revision performed it: admission checked only that a model card was PRESENT, and every
// admitted element emitted as an ideal lumped part regardless.
test fn w_vendor_subcircuit_refuses_rather_than_emitting_an_ideal_part() -> Bool {
  match project_slice_to_spice(slice: slice_with(elements: [vendor_subcircuit_capacitor()])) {
    SpiceSliceRefused { cause: c } =>
      match c {
        ModelFidelityNotEmittable { part: p, model_card: mc } =>
          p == "bulk decoupling capacitor" && mc == "vendor ESR/ESL subcircuit"
        ElectricalModelUnavailable { part: _ } => false
      }
    SpiceSliceProjected { netlist: _ } => false
  }
}

// The three-way discrimination, asserted together: absent model, unemittable fidelity, and
// emittable fidelity must land on three different outcomes. Any two collapsing is the defect.
test fn w_three_model_standings_land_on_three_outcomes() -> Bool {
  let absent = project_slice_to_spice(slice: slice_with(elements: [unmodelled_capacitor()]))
  let subckt = project_slice_to_spice(slice: slice_with(elements: [vendor_subcircuit_capacitor()]))
  let ideal = project_slice_to_spice(slice: slice_with(elements: [modelled_capacitor()]))
  match absent {
    SpiceSliceRefused { cause: ElectricalModelUnavailable { part: _ } } =>
      match subckt {
        SpiceSliceRefused { cause: ModelFidelityNotEmittable { part: _, model_card: _ } } =>
          match ideal {
            SpiceSliceProjected { netlist: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}
