module test.claim.materialized_secret

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data incident_secret_note: String = "The witness uses the ACTUAL credential from the A3 incident — gunbc_ci_github_app.app_pem_secret, ci-github-app-private-key — rather than a synthetic fixture, so the conjuncts below are statements about the thing that 401'd srv4 and not about a stand-in that resembles it."

fn incident_secret_ref() -> SecretRef {
  gunbc_ci_github_app.app_pem_secret
}

fn use_marker(m: MaterializedSecret) -> Int {
  1
}

data witness_a3_hinge_note: String = "THE conjunct A3 exists for, and it is the srv4 incident replayed. Secret Manager says SmEnabled — every existence check the model can perform is green, and it stayed green through the entire incident — while NO liveness observation exists. The materialization must REFUSE. If it completes, the model has certified a credential on the strength of the store's opinion about its own contents, which is exactly the state that produced the 401, and it would do so on the same inputs that produced it."

fn witness_enabled_but_unprobed_refuses() -> Bool {
  let outcome = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    probe: github_app_jwt_mint_probe,
    liveness_observation: none,
    use: fn(m) { use_marker(m: m) },
  )
  !materialization_completed(outcome: outcome)
    && match outcome {
      MaterializationRefused { cause: c } =>
        match c {
          SecretNotLive { verdict: v } =>
            observation_verdict_eq(a: v, b: std.upsert_decision.UnknownRefused)
          SecretVersionUnusable { state: _ } => false
          LivenessProbeNotIndependent { probe_label: _ } => false
        }
      MaterializationCompleted { value: _ } => false
    }
}

data witness_revoked_note: String = "The incident's other half: the store is enabled AND a probe ran AND the upstream rejected the key. The refusal must carry the probe's own verdict rather than collapsing to a generic failure, because 'GitHub does not accept this key' and 'nobody asked GitHub' are different pieces of work — reconcile the credential versus build the probe — and this lane already paid for conflating them once."

fn witness_enabled_but_revoked_refuses() -> Bool {
  let outcome = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    probe: github_app_jwt_mint_probe,
    liveness_observation: Present { value: std.upsert_decision.Absent },
    use: fn(m) { use_marker(m: m) },
  )
  !materialization_completed(outcome: outcome)
    && match outcome {
      MaterializationRefused { cause: c } =>
        match c {
          SecretNotLive { verdict: v } =>
            observation_verdict_eq(a: v, b: std.upsert_decision.Absent)
          SecretVersionUnusable { state: _ } => false
          LivenessProbeNotIndependent { probe_label: _ } => false
        }
      MaterializationCompleted { value: _ } => false
    }
}

data witness_non_vacuity_note: String = "The non-vacuity control, without which every conjunct above is satisfied by a bracket that refuses unconditionally. Store enabled AND upstream accepts: the materialization completes AND the use function actually RAN — proven by its return value travelling out through MaterializationCompleted, not merely by the outcome's tag. That distinction matters because a bracket that returned Completed with a fabricated value would look identical at the tag."

fn witness_live_secret_materializes_and_runs_the_use() -> Bool {
  let outcome = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    probe: github_app_jwt_mint_probe,
    liveness_observation: Present { value: std.upsert_decision.Converged },
    use: fn(m) { use_marker(m: m) },
  )
  match outcome {
    MaterializationCompleted { value: v } => v == 1
    MaterializationRefused { cause: _ } => false
  }
}

data witness_store_state_note: String = "Store state still refuses on its own axis, and keeps its own cause. Liveness dominating existence must not make existence irrelevant: a destroyed version is unusable no matter what a stale probe result says, and the refusal names the store rather than the upstream so the remedy points at the right system."

fn witness_destroyed_version_refuses_even_when_probe_says_live() -> Bool {
  let outcome = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: EnvVar { name: "GH_APP_PEM" },
    existence: SmDestroyed,
    probe: github_app_jwt_mint_probe,
    liveness_observation: Present { value: std.upsert_decision.Converged },
    use: fn(m) { use_marker(m: m) },
  )
  !materialization_completed(outcome: outcome)
}

data witness_self_repairing_probe_note: String = "A probe that repairs what it tests cannot certify it. The self-repairing sketch is the automation of the exact hand reconciliation the A3 gap row describes — mint, and on failure add a fresh key version — so its Converged may be reporting the version the probe itself just wrote. The bracket refuses on the probe's CLASSIFICATION before it ever looks at the verdict, and the refusal names the probe so the remedy is 'replace this probe' rather than 'the credential is bad'."

fn witness_self_repairing_probe_is_refused_by_classification() -> Bool {
  let outcome = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    probe: liveness_self_repairing_probe_sketch,
    liveness_observation: Present { value: std.upsert_decision.Converged },
    use: fn(m) { use_marker(m: m) },
  )
  !materialization_completed(outcome: outcome)
    && match outcome {
      MaterializationRefused { cause: c } =>
        match c {
          LivenessProbeNotIndependent { probe_label: _ } => true
          SecretNotLive { verdict: _ } => false
          SecretVersionUnusable { state: _ } => false
        }
      MaterializationCompleted { value: _ } => false
    }
}

data witness_red_control_note: String = "The discriminating RED control. The perturbation is materializing on store existence alone — what every hand-run credential step in the srv4 session effectively did, and the behaviour that produced the 401 — and it is executed rather than described. On the incident's own inputs (SmEnabled, no liveness observation) the sketch COMPLETES where the authority REFUSES, the gate rejects the sketch and accepts the authority, and the gate's decision is computed from the liveness argument rather than from which function produced the outcome, so relabelling cannot satisfy it. The final conjunct is the other direction: with liveness Converged the gate accepts a completion, so this is not an always-reject gate."

fn witness_red_control_existence_only_rejected_by_gate() -> Bool {
  let widened = materialize_existence_only_widen_sketch(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    use: fn(m) { use_marker(m: m) },
  )
  let authority = with_materialized_secret(
    ref: incident_secret_ref(),
    binding: SshKeyFile,
    existence: SmEnabled,
    probe: github_app_jwt_mint_probe,
    liveness_observation: none,
    use: fn(m) { use_marker(m: m) },
  )
  materialization_completed(outcome: widened)
    && !materialization_completed(outcome: authority)
    && !materialization_gate_accepts(
      outcome: widened,
      liveness: std.upsert_decision.UnknownRefused,
    )
    && materialization_gate_accepts(
      outcome: authority,
      liveness: std.upsert_decision.UnknownRefused,
    )
    && materialization_gate_accepts(
      outcome: authority,
      liveness: std.upsert_decision.Converged,
    )
}

data witness_qualification_asymmetry_note: String = "Liveness qualification is a presupposition check and not a meet, pinned the same way the swap axis pins its own. A DISABLED store version under a live probe stays Drifted — the probe does not repair the store — while an ENABLED version under an absent probe becomes UnknownRefused. Under a symmetric meet those two would be indistinguishable and the direction of the check would be lost."

fn witness_liveness_qualification_is_asymmetric() -> Bool {
  let store_drifted = secret_liveness_qualified_verdict(
    existence: secret_existence_verdict(state: SmDisabled),
    liveness: std.upsert_decision.Converged,
  )
  let probe_missing = secret_liveness_qualified_verdict(
    existence: secret_existence_verdict(state: SmEnabled),
    liveness: std.upsert_decision.UnknownRefused,
  )
  observation_verdict_eq(a: store_drifted, b: std.upsert_decision.Drifted)
    && observation_verdict_eq(a: probe_missing, b: std.upsert_decision.UnknownRefused)
    && observation_verdict_eq(
      a: secret_existence_verdict(state: SmEnabled),
      b: std.upsert_decision.Converged,
    )
}

test fn materialized_secret_witnesses() -> Bool {
  witness_enabled_but_unprobed_refuses()
    && witness_enabled_but_revoked_refuses()
    && witness_live_secret_materializes_and_runs_the_use()
    && witness_destroyed_version_refuses_even_when_probe_says_live()
    && witness_self_repairing_probe_is_refused_by_classification()
    && witness_red_control_existence_only_rejected_by_gate()
    && witness_liveness_qualification_is_asymmetric()
}
