module test.claim.release_bins_consumer_check_script_witness

import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String }
import std.optional { Absent, Present }
import std.algebra { string_contains }
import extdeps.github.actions { Step, RunStep, UsesStep, workflow_file_size_max, workflow_file_within }
import gunbc.generated_artifact { ReleaseBinsConsumerCheckScriptArtifact, FleetConvergeYamlArtifact, artifact_path, artifact_commit_policy, CommitRequired, GithubActionsWorkflow }
import gunbc.generated_artifact_registry { committed_generated_artifacts }
import gunbc.tier_o_artifact_emit { tier_o_artifact_body, tier_o_artifacts, TierOArtifactProduced, TierOArtifactRefused, TierOArtifactNotTierO }
import gunbc.fleet.fleet_release_bins_key { release_bins_consumer_key_check_script }
import gunbc.fleet.fleet_workflow_steps { ci_release_bins_unpack_verify_step }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE COMMITTED SCRIPT IS THE CHECK, NOT A COPY OF IT: its body is the generated provenance header over
// exactly release_bins_consumer_key_check_script, the text the twelve steps used to inline.
test fn the_committed_script_is_the_consumer_check_under_its_provenance_header() -> Bool {
  match tier_o_artifact_body(a: ReleaseBinsConsumerCheckScriptArtifact) {
    TierOArtifactProduced { content } =>
      string_contains(s: content, pattern: "# Generated by gunbc.fleet.fleet_release_bins_key release_bins_consumer_key_check_script")
        && string_contains(s: content, pattern: release_bins_consumer_key_check_script())
    _ => false
  }
}

// THE STEP RUNS THAT FILE, AT THE REGISTRY'S PATH, WITH THE INLINE STEP'S SHELL FLAGS. A step naming any
// other path, or dropping -e, fails here.
test fn the_verify_step_runs_the_registered_script_with_bash_e() -> Bool {
  match ci_release_bins_unpack_verify_step() {
    RunStep { name: _, id: _, run: run, shell: shell, env: _, working_directory: wd, if_condition: _, continue_on_error: _, timeout_minutes: _ } =>
      run == concat("bash -e \"$GITHUB_WORKSPACE\"/", artifact_path(a: ReleaseBinsConsumerCheckScriptArtifact))
        && (match shell { Absent => true  _ => false })
        && (match wd { Absent => true  _ => false })
    UsesStep { name: _, id: _, uses: _, with: _, env: _, if_condition: _, continue_on_error: _, timeout_minutes: _ } => false
  }
}

// THE SCRIPT IS A COMMITTED, DRIFT-JUDGED ARTIFACT whose consumer is the Actions runner: it is in the committed
// registry and on the tier O roster the drift watch and heal read, so an edit to the check regenerates it.
test fn the_script_is_committed_and_on_the_tier_o_roster() -> Bool {
  let path = artifact_path(a: ReleaseBinsConsumerCheckScriptArtifact)
  path == ".github/scripts/release-bins-consumer-check.sh"
    && fold(committed_generated_artifacts(), init: false, f: (acc, a) => acc || artifact_path(a: a) == path)
    && fold(tier_o_artifacts(), init: false, f: (acc, a) => acc || artifact_path(a: a) == path)
    && (match artifact_commit_policy(a: ReleaseBinsConsumerCheckScriptArtifact) {
      CommitRequired { consumer: GithubActionsWorkflow } => true
      _ => false
    })
}

// THE REAL ROUTE: the emitted fleet-converge workflow invokes the script and is within GitHub's size limit.
test fn the_emitted_fleet_converge_workflow_invokes_the_script_within_the_limit() -> Bool {
  match tier_o_artifact_body(a: FleetConvergeYamlArtifact) {
    TierOArtifactProduced { content } =>
      string_contains(s: content, pattern: concat("bash -e \"$GITHUB_WORKSPACE\"/", artifact_path(a: ReleaseBinsConsumerCheckScriptArtifact)))
        && workflow_file_within(content: content, max: workflow_file_size_max)
    _ => false
  }
}
