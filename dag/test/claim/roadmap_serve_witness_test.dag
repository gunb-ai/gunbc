module test.claim.roadmap_serve_witness

import gunbc.roadmap_serve {
  RoadmapServeHandler,
  RoadmapDailyPageHandler, RoadmapFullPageHandler, RoadmapMdHandler,
  DispatchJsonHandler, HealthzHandler, BeltDispatchHandler, DispatchAssetHandler,
  RoadmapServeRouteSpec,
  RoadmapServeTableBuild, RoadmapServeTable, RoadmapServeTableRefused,
  roadmap_serve_route_table_build,
  roadmap_serve_build_from_specs,
  roadmap_serve_selection_response,
  roadmap_serve_invoke,
  roadmap_serve_respond,
  belt_dispatch_status,
}
import gunbc.roadmap_belt_actuate {
  BeltDispatchResult,
  DispatchSpawned, DispatchAlreadyLive, DispatchNodeNotFound,
  DispatchNodeAlreadyDone, DispatchObserveRefused, DispatchSpawnFailed,
}
import gunbc.roadmap_component { roadmap_dispatch_asset_path, dispatch_client_js_source }
import extdeps.http.server {
  ServeHttpRequest, ServeHttpResponse,
  ServedRouteTable,
  RouteSelection, SelectedStatic, SelectedDynamic, MethodNotAllowed, NoRouteMatched,
  serve_select_route,
  HttpMethodParse, KnownMethod, UnknownMethod,
  parse_http_method_label,
  http_content_type_wire_label,
}
import std.http_path { PathParamBinding, path_param_value }
import std.types { String, Int, Bool, List, HttpMethod, GET, POST, PUT }

data live_table_or_empty_note: String = "Test-local extraction: a Refused build yields the EMPTY table, so every selection witness below goes RED (nothing selects) — the discriminating direction; the production path never does this (roadmap_serve_respond answers 500 on Refused)."

fn live_table_or_empty() -> ServedRouteTable<RoadmapServeHandler> {
  match roadmap_serve_route_table_build() {
    RoadmapServeTable { table: t } => t
    RoadmapServeTableRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

fn selects(method: HttpMethod, path: String, want: RoadmapServeHandler) -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => h == want
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

fn witness_serve_table_selection() -> Bool {
  selects(method: GET, path: "/", want: RoadmapDailyPageHandler)
    && selects(method: GET, path: "/roadmap", want: RoadmapFullPageHandler)
    && selects(method: GET, path: "/ROADMAP.md", want: RoadmapMdHandler)
    && selects(method: GET, path: "/target/roadmap-dispatch.json", want: DispatchJsonHandler)
    && selects(method: GET, path: "/healthz", want: HealthzHandler)
    && selects(method: GET, path: roadmap_dispatch_asset_path, want: DispatchAssetHandler)
    && selects(method: POST, path: "/dispatch/some-node", want: BeltDispatchHandler)
}

fn witness_asset_route_serves_modeled_js() -> Bool {
  let r = roadmap_serve_invoke(
    handler: DispatchAssetHandler,
    params: [],
    request: fixture_request(method: GET, path: roadmap_dispatch_asset_path),
  )
  r.status == 200
    && http_content_type_wire_label(content_type: r.content_type) == "text/javascript; charset=utf-8"
    && r.body == dispatch_client_js_source()
    && string_contains(s: r.body, pattern: "j.status === 'spawned'")
    && !string_contains(s: r.body, pattern: "j.ok")
}

fn witness_dispatch_param_bound() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: POST, path: "/dispatch/2-cd-transport") {
    SelectedDynamic { handler: _, params: ps } =>
      path_param_value(params: ps, name: "node_id") == "2-cd-transport"
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

fn witness_dispatch_get_folds_405() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: GET, path: "/dispatch/x") {
    MethodNotAllowed { allowed: ms } => count(ms) == 1 && any(ms, m => m == POST)
    SelectedStatic { route: _ } => false
    SelectedDynamic { handler: _, params: _ } => false
    NoRouteMatched => false
  }
}

fn fixture_request(method: HttpMethod, path: String) -> ServeHttpRequest {
  ServeHttpRequest { method: method, path: path, body: "" }
}

fn witness_unknown_path_folds_404_response() -> Bool {
  let r = roadmap_serve_selection_response(sel: NoRouteMatched, request: fixture_request(method: GET, path: "/nope"))
  r.status == 404
}

fn witness_405_response_carries_allowed() -> Bool {
  let r = roadmap_serve_selection_response(sel: MethodNotAllowed { allowed: [POST] }, request: fixture_request(method: GET, path: "/dispatch/x"))
  r.status == 405 && string_contains(s: r.body, pattern: "POST")
}

data status_map_red_note: String = "The 404/409/503/502 rows are the REDs a lazy 200-or-500 collapse would fail (parent review 2026-07-20): each refusal variant must map to ITS status, so a collapse of any arm reds exactly one witness row below."

fn witness_dispatch_status_total() -> Bool {
  belt_dispatch_status(r: DispatchSpawned { node_id: "n", session_name: "s" }) == 200
    && belt_dispatch_status(r: DispatchAlreadyLive { node_id: "n", session_name: "s" }) == 200
    && belt_dispatch_status(r: DispatchNodeNotFound { node_id: "n" }) == 404
    && belt_dispatch_status(r: DispatchNodeAlreadyDone { node_id: "n" }) == 409
    && belt_dispatch_status(r: DispatchObserveRefused { node_id: "n", reason: "r" }) == 503
    && belt_dispatch_status(r: DispatchSpawnFailed { node_id: "n", step: "git", detail: "d" }) == 502
}

fn witness_live_table_builds_ready_seven_routes() -> Bool {
  match roadmap_serve_route_table_build() {
    RoadmapServeTable { table: t } => count(t.routes) == 7
    RoadmapServeTableRefused { raw: _, segment: _, reason: _ } => false
  }
}

data malformed_literal_red_note: String = "The RED control for review 40286's section-5 catch: a malformed route literal through the SAME build fold must REFUSE the whole table (typed, carrying the broken raw), never fabricate an empty template that would silently match '/'."

fn witness_malformed_route_literal_refuses_table() -> Bool {
  let specs = [
    RoadmapServeRouteSpec { method: GET, raw: "/ok", handler: HealthzHandler },
    RoadmapServeRouteSpec { method: GET, raw: "/dispatch/\{node_id", handler: BeltDispatchHandler },
  ]
  match roadmap_serve_build_from_specs(specs: specs) {
    RoadmapServeTableRefused { raw: r, segment: _, reason: _ } => r == "/dispatch/\{node_id"
    RoadmapServeTable { table: _ } => false
  }
}

fn witness_unknown_method_refuses() -> Bool {
  match parse_http_method_label(label: "BREW") {
    UnknownMethod { label: l } => l == "BREW"
    KnownMethod { method: _ } => false
  }
}

data unknown_method_501_note: String = "review 40359: an unrecognized method label is 501 Not Implemented (RFC 9110 section 15.6.2 — the server does not implement the method at all), NEVER 405 (405 means the ROUTE exists but this method is not in its allowed set, and carries the allowed set — the MethodNotAllowed arm). The two arms must stay distinct statuses; collapsing them reds this row."

fn witness_unknown_method_folds_501_response() -> Bool {
  let r = roadmap_serve_respond(method_label: "BREW", path: "/", body: "")
  r.status == 501 && string_contains(s: r.body, pattern: "BREW")
}

fn witness_known_methods_parse() -> Bool {
  match parse_http_method_label(label: "GET") {
    KnownMethod { method: m } => m == GET
    UnknownMethod { label: _ } => false
  }
  && match parse_http_method_label(label: "POST") {
    KnownMethod { method: m } => m == POST
    UnknownMethod { label: _ } => false
  }
}

test fn roadmap_serve_witnesses() -> Bool {
  witness_serve_table_selection()
    && witness_dispatch_param_bound()
    && witness_dispatch_get_folds_405()
    && witness_unknown_path_folds_404_response()
    && witness_405_response_carries_allowed()
    && witness_dispatch_status_total()
    && witness_asset_route_serves_modeled_js()
    && witness_live_table_builds_ready_seven_routes()
    && witness_malformed_route_literal_refuses_table()
    && witness_unknown_method_refuses()
    && witness_unknown_method_folds_501_response()
    && witness_known_methods_parse()
}
