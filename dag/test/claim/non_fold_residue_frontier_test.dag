module test.claim.non_fold_residue_frontier


data non_fold_residue_frontier_test_note: String = "GREEN: every enrolled non-fold-residue row is well-formed (nonempty subject, reason, trigger), path keys are unique via keyed_roster_build construction (lane 4), and the roster is populated. RED controls: a synthetic row with an empty trigger fails well-formedness; a synthetic duplicate path key yields KeyedRosterBuildDuplicateKey. The host-side equivalence receipt (nfr_roster_receipt: unrostered=0, stale=0 against the live corpus scan) lives in cli_run.rs nfr_tests and the always-on witness enrollment on src/v2/lens/non_fold_residue_test.dag."

test fn non_fold_residue_frontier_rows_well_formed_holds() -> Bool {
  non_fold_residue_frontier_well_formed()
}

test fn non_fold_residue_frontier_keyed_roster_build_admits() -> Bool {
  match non_fold_residue_frontier_construct() {
    KeyedRosterBuilt { rows: _ } => true
    std.keyed_roster.KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

test fn non_fold_residue_frontier_is_populated() -> Bool {
  length(xs: non_fold_residue_frontier_units()) >= 100
}

// Constructs the empty condition through the NON-LITERAL path deliberately.
// The literal form `unbound_dissolution(description: "")` is now refused at
// compile (the parameter is NonEmptyStr), which is the wall. Refinement at
// non-literal positions is still deferred, so that gap is exactly what the
// downstream well-formedness guard defends -- and this control has to reach it
// through the gap in order to keep proving the guard works (DESIGN 4b(4):
// production machinery dissolves on a climb, the evidence stays enrolled).
fn synthetic_nonliteral_text(text: String) -> std.types.NonEmptyStr {
  concat(text, "")
}

fn synthetic_empty_condition(text: String) -> std.dissolution.DissolutionCondition {
  unbound_dissolution(description: test.claim.non_fold_residue_frontier.synthetic_nonliteral_text(text: text))
}

test fn non_fold_residue_frontier_red_control_empty_trigger_reds() -> Bool {
  let verdict = std.roster_frontier.frontier_row_well_formed(
    row: std.roster_frontier.FrontierRow {
      subject: std.roster_frontier.PathSubject { path: "synthetic.dag::f" },
      reason: "a reason without a trigger is not a frontier row",
      dissolution: test.claim.non_fold_residue_frontier.synthetic_empty_condition(text: "")
    }
  )
  verdict == false
}

test fn non_fold_residue_frontier_red_control_duplicate_path_reds() -> Bool {
  match std.roster_frontier.frontier_rows_keyed_roster_build(
    rows: [
      std.roster_frontier.FrontierRow {
        subject: std.roster_frontier.PathSubject { path: "synthetic/a.dag::f" },
        reason: "r1",
        dissolution: unbound_dissolution(description: "d1"),
      },
      std.roster_frontier.FrontierRow {
        subject: std.roster_frontier.PathSubject { path: "synthetic/a.dag::f" },
        reason: "r2",
        dissolution: unbound_dissolution(description: "d2"),
      },
    ]
  ) {
    KeyedRosterBuilt { rows: _ } => false
    std.keyed_roster.KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => true
  }
}
