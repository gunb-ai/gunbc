import std.optional { Absent, Present }
import std.error_primitives { Err, Ok }
import std.algebra { fold_list }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.allocation_roster { AllocationAdmitted, AllocationPrimaryKeyRepeated, AllocationSecondaryKeyRepeated }
import product.host_identity { HostIdentity }
import extdeps.dns.domain_name { DnsLabel, parse_dns_label_raw }
import gunbc.fleet.fleet_host_identity {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4, operator_host_srv14, operator_host_183527,
}
import gunbc.hostname_allocation {
  HostnameAllocation,
  HumanName,
  FirstOnly,
  FirstLast,
  LegacyHostname,
  DrawnHumanName,
  HumanNameDraw,
  HumanNameDrawn,
  HumanNameDrawExhausted,
  HumanNameDrawRefused,
  HostSelectorResolved,
  HostSelectorAmbiguous,
  HostSelectorUnknown,
  human_name_canonical_hostname,
  draw_human_name,
  canonical_hostname_for_fleet_slot,
  canonical_hostname_in_roster,
  hostname_allocation_admission,
  resolve_host_selector,
  resolve_host_selector_in,
  fleet_machine_registry,
  next_name_for_fleet_slot,
  allocation_reserved_forms,
  pending_name_collisions,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn allocation_fixture(slot: String, hostname: String) -> HostnameAllocation {
  HostnameAllocation {
    fleet_slot: slot as HostIdentity,
    name: LegacyHostname { label: hostname as DnsLabel },
    next_name: Absent,
  }
}

fn drawn_fixture(slot: String, name: HumanName, entropy: Int) -> HostnameAllocation {
  HostnameAllocation {
    fleet_slot: slot as HostIdentity,
    name: DrawnHumanName { name: name, draw: HumanNameDraw { entropy: entropy } },
    next_name: Absent,
  }
}

fn pending_fixture(slot: String, hostname: String, next: String) -> HostnameAllocation {
  HostnameAllocation {
    fleet_slot: slot as HostIdentity,
    name: LegacyHostname { label: hostname as DnsLabel },
    next_name: Present { value: LegacyHostname { label: next as DnsLabel } },
  }
}

// A PENDING DRAW REPRODUCES against every other registry row, pending names included. Re-drawing against
// that superset is exact because pending_name_collisions forbids any other row from holding the form the
// draw chose; so a recorded next_name the allocator would not yield reds here rather than standing.
fn pending_draw_reproduces(row: HostnameAllocation, rows: List<HostnameAllocation>) -> Bool {
  match row.next_name {
    Absent => true
    Present { value: next } => match next {
      LegacyHostname { label: _ } => true
      DrawnHumanName { name: recorded, draw: d } =>
        match draw_human_name(draw: d, existing: filter(rows, o => (o.fleet_slot as String) != (row.fleet_slot as String))) {
          HumanNameDrawn { name: drawn } => human_name_eq(a: drawn, b: recorded)
          HumanNameDrawExhausted { entropy: _, taken_forms: _ } => false
          HumanNameDrawRefused { reason: _ } => false
        }
    }
  }
}

fn human_name_eq(a: HumanName, b: HumanName) -> Bool {
  (human_name_canonical_hostname(name: a) as String) == (human_name_canonical_hostname(name: b) as String)
}

type RecordedDrawCheck {
  prior: List<HostnameAllocation>
  reproduced: Bool
}

fn recorded_draw_reproduces(row: HostnameAllocation, prior: List<HostnameAllocation>) -> Bool {
  match row.name {
    LegacyHostname { label: _ } => true
    DrawnHumanName { name: recorded, draw: d } => match draw_human_name(draw: d, existing: prior) {
      HumanNameDrawn { name: drawn } => human_name_eq(a: drawn, b: recorded)
      HumanNameDrawExhausted { entropy: _, taken_forms: _ } => false
      HumanNameDrawRefused { reason: _ } => false
    }
  }
}

test fn witness_legacy_srv_allocations_are_byte_identical_to_slot_spelling() -> Bool {
  match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv1) {
    Present { value: h1 } =>
      match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv2) {
        Present { value: h2 } =>
          match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv3) {
            Present { value: h3 } =>
              match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv4) {
                Present { value: h4 } =>
                  (h1 as String) == "srv1"
                    && (h2 as String) == "srv2"
                    && (h3 as String) == "srv3"
                    && (h4 as String) == "srv4"
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn witness_identity_that_is_not_a_dns_label_can_still_have_a_hostname() -> Bool {
  let roster = [allocation_fixture(slot: "spark_lab#1", hostname: "spark-lab-1")]
  match parse_dns_label_raw(raw: "spark_lab#1") {
    Ok { value: _ } => false
    Err { value: _ } =>
      match canonical_hostname_in_roster(
        allocations: roster,
        fleet_slot: "spark_lab#1" as HostIdentity,
      ) {
        Present { value: allocated } => (allocated as String) == "spark-lab-1"
        Absent => false
      }
  }
}

test fn witness_production_fleet_roster_is_injective() -> Bool {
  match hostname_allocation_admission(allocations: fleet_machine_registry) {
    AllocationAdmitted { roster: _ } => true
    AllocationPrimaryKeyRepeated { key: _ } => false
    AllocationSecondaryKeyRepeated { key: _ } => false
  }
}

test fn witness_two_identities_may_not_claim_one_canonical_hostname() -> Bool {
  let roster = [
    allocation_fixture(slot: "srvA", hostname: "shared"),
    allocation_fixture(slot: "srvB", hostname: "shared"),
  ]
  match hostname_allocation_admission(allocations: roster) {
    AllocationSecondaryKeyRepeated { key: dup } => dup == "shared"
    AllocationAdmitted { roster: _ } => false
    AllocationPrimaryKeyRepeated { key: _ } => false
  }
}

test fn witness_one_identity_may_not_be_allocated_two_hostnames() -> Bool {
  let roster = [
    allocation_fixture(slot: "srvA", hostname: "first"),
    allocation_fixture(slot: "srvA", hostname: "second"),
  ]
  match hostname_allocation_admission(allocations: roster) {
    AllocationPrimaryKeyRepeated { key: dup } => dup == "srvA"
    AllocationAdmitted { roster: _ } => false
    AllocationSecondaryKeyRepeated { key: _ } => false
  }
}

test fn witness_colliding_roster_serves_no_hostname_rather_than_a_winner() -> Bool {
  let roster = [
    allocation_fixture(slot: "srvA", hostname: "shared"),
    allocation_fixture(slot: "srvB", hostname: "shared"),
  ]
  match canonical_hostname_in_roster(allocations: roster, fleet_slot: "srvA" as HostIdentity) {
    Absent =>
      match canonical_hostname_in_roster(allocations: roster, fleet_slot: "srvB" as HostIdentity) {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: _ } => false
  }
}

test fn witness_lookup_of_unallocated_slot_is_absent_not_reconstructed() -> Bool {
  let roster = [allocation_fixture(slot: "srvA", hostname: "srv-a")]
  match canonical_hostname_in_roster(allocations: roster, fleet_slot: "srvB" as HostIdentity) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE RECORDED NAMES ARE THE ALLOCATOR'S, NOT HAND-PICKED. Every drawn row in the production roster
// is re-drawn by the real allocator against the rows allocated before it, and must yield exactly the
// recorded name; at least one drawn row must exist, so an empty set cannot pass vacuously.
test fn witness_every_recorded_draw_is_what_the_allocator_yields() -> Bool {
  let drawn = filter(fleet_machine_registry, r => match r.name {
    DrawnHumanName { name: _, draw: _ } => true
    LegacyHostname { label: _ } => false
  })
  let check = fold_list(
    xs: fleet_machine_registry,
    empty: RecordedDrawCheck { prior: [], reproduced: true },
    cons: fn(acc, r) {
      RecordedDrawCheck {
        prior: append(acc.prior, [r]),
        reproduced: acc.reproduced && recorded_draw_reproduces(row: r, prior: acc.prior),
      }
    }
  )
  drawn.length() >= 2 && check.reproduced
}

// A collision lengthens the SAME name. 707054856316 draws damien / energy / risotto; with "damien"
// already answered to, the allocator must yield damien-energy, and with that taken too,
// damien-risotto-energy -- never a different first name.
test fn witness_collision_lengthens_the_drawn_name() -> Bool {
  let d = HumanNameDraw { entropy: 707054856316 }
  let taken_first = [allocation_fixture(slot: "a", hostname: "damien")]
  let taken_two = append(taken_first, [allocation_fixture(slot: "b", hostname: "damien-energy")])
  let one = match draw_human_name(draw: d, existing: []) {
    HumanNameDrawn { name: n } => (human_name_canonical_hostname(name: n) as String) == "damien"
    HumanNameDrawExhausted { entropy: _, taken_forms: _ } => false
    HumanNameDrawRefused { reason: _ } => false
  }
  let two = match draw_human_name(draw: d, existing: taken_first) {
    HumanNameDrawn { name: n } => (human_name_canonical_hostname(name: n) as String) == "damien-energy"
    HumanNameDrawExhausted { entropy: _, taken_forms: _ } => false
    HumanNameDrawRefused { reason: _ } => false
  }
  let three = match draw_human_name(draw: d, existing: taken_two) {
    HumanNameDrawn { name: n } => (human_name_canonical_hostname(name: n) as String) == "damien-risotto-energy"
    HumanNameDrawExhausted { entropy: _, taken_forms: _ } => false
    HumanNameDrawRefused { reason: _ } => false
  }
  one && two && three
}

test fn witness_exhausted_draw_refuses_rather_than_suffixing() -> Bool {
  let taken = [
    allocation_fixture(slot: "a", hostname: "damien"),
    allocation_fixture(slot: "b", hostname: "damien-energy"),
    allocation_fixture(slot: "c", hostname: "damien-risotto-energy"),
  ]
  match draw_human_name(draw: HumanNameDraw { entropy: 707054856316 }, existing: taken) {
    HumanNameDrawExhausted { entropy: e, taken_forms: forms } => e == 707054856316 && forms.length() == 3
    HumanNameDrawn { name: _ } => false
    HumanNameDrawRefused { reason: _ } => false
  }
}

// Stable identity, drawn name and (legacy) hostname all differ, and each resolves to the same host.
test fn witness_identity_and_name_resolve_to_one_host() -> Bool {
  let by_name = match resolve_host_selector(selector: "damien") {
    HostSelectorResolved { host: h } => (h as String) == (operator_host_183527 as String)
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  let by_identity = match resolve_host_selector(selector: "host-183527") {
    HostSelectorResolved { host: h } => (h as String) == (operator_host_183527 as String)
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  let legacy = match resolve_host_selector(selector: "srv3") {
    HostSelectorResolved { host: h } => (h as String) == (operator_host_srv3 as String)
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  by_name && by_identity && legacy
}

test fn witness_ambiguous_short_name_selects_nothing() -> Bool {
  let roster = [
    drawn_fixture(slot: "x1", name: FirstLast { first: "ada" as DnsLabel, last: "smith" as DnsLabel }, entropy: 1),
    drawn_fixture(slot: "x2", name: FirstLast { first: "ada" as DnsLabel, last: "jones" as DnsLabel }, entropy: 2),
  ]
  let short = match resolve_host_selector_in(allocations: roster, selector: "ada") {
    HostSelectorAmbiguous { selector: _, candidates: c } =>
      c.length() == 2 && any(c, x => (x as String) == "ada-smith") && any(c, x => (x as String) == "ada-jones")
    HostSelectorResolved { host: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  let full = match resolve_host_selector_in(allocations: roster, selector: "ada-jones") {
    HostSelectorResolved { host: h } => (h as String) == "x2"
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  short && full
}

test fn witness_unknown_selector_is_unknown() -> Bool {
  match resolve_host_selector(selector: "nobody-here") {
    HostSelectorUnknown { selector: s } => s == "nobody-here"
    HostSelectorResolved { host: _ } => false
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
  }
}

test fn witness_butch_and_its_identity_resolve_to_srv14() -> Bool {
  let by_name = match resolve_host_selector(selector: "butch") {
    HostSelectorResolved { host: h } => (h as String) == (operator_host_srv14 as String)
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  let by_identity = match resolve_host_selector(selector: "srv14") {
    HostSelectorResolved { host: h } => (h as String) == (operator_host_srv14 as String)
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
    HostSelectorUnknown { selector: _ } => false
  }
  by_name && by_identity
}

// THE DELETED SECOND SLOT FOR srv14's BOARD NO LONGER RESOLVES (gunbc.fleet.fleet_host_identity, the ONE
// BOARD, ONE SLOT note): neither its hostname nor its identity names a host.
test fn witness_owen_and_host_94c81d_name_no_host() -> Bool {
  let by_name = match resolve_host_selector(selector: "owen") {
    HostSelectorUnknown { selector: s } => s == "owen"
    HostSelectorResolved { host: _ } => false
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
  }
  let by_identity = match resolve_host_selector(selector: "host-94c81d") {
    HostSelectorUnknown { selector: s } => s == "host-94c81d"
    HostSelectorResolved { host: _ } => false
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
  }
  by_name && by_identity
}

// THE ACCEPTED NEXT NAMES (operator, D3 of gunbc.plans.fleet_machine_authority, 2026-11-10) ARE THE
// ALLOCATOR'S: each re-draws to its recorded name, at least five are pending, and srv4's is fox.
test fn witness_every_pending_draw_is_what_the_allocator_yields() -> Bool {
  let pending = filter(fleet_machine_registry, r => match r.next_name {
    Present { value: _ } => true
    Absent => false
  })
  let fox = match next_name_for_fleet_slot(fleet_slot: operator_host_srv4) {
    Present { value: n } => match n {
      DrawnHumanName { name: h, draw: _ } => (human_name_canonical_hostname(name: h) as String) == "fox"
      LegacyHostname { label: _ } => false
    }
    Absent => false
  }
  pending.length() >= 5 && all(pending, r => pending_draw_reproduces(row: r, rows: fleet_machine_registry)) && fox
}

// A PENDING NAME IS RESERVED, NOT ANSWERED TO: srv4 does not resolve as fox until its rename applies, and
// no other draw can take fox meanwhile.
test fn witness_pending_name_is_reserved_but_does_not_resolve() -> Bool {
  let unresolved = match resolve_host_selector(selector: "fox") {
    HostSelectorUnknown { selector: s } => s == "fox"
    HostSelectorResolved { host: _ } => false
    HostSelectorAmbiguous { selector: _, candidates: _ } => false
  }
  let reserved = any(allocation_reserved_forms(allocation: pending_fixture(slot: "a", hostname: "a1", next: "fox")), f => f == "fox")
  unresolved && reserved
}

test fn witness_production_registry_has_no_pending_collision() -> Bool {
  pending_name_collisions(allocations: fleet_machine_registry).length() == 0
}

// THE TWO REDS OF THE PENDING AXIS: a next_name another machine already answers to, and one next_name
// awaited by two machines.
test fn witness_pending_name_colliding_with_a_current_name_refuses() -> Bool {
  let roster = [allocation_fixture(slot: "a", hostname: "fox"), pending_fixture(slot: "b", hostname: "b1", next: "fox")]
  any(pending_name_collisions(allocations: roster), c => c == "fox")
}

test fn witness_one_pending_name_for_two_machines_refuses() -> Bool {
  let roster = [pending_fixture(slot: "a", hostname: "a1", next: "fox"), pending_fixture(slot: "b", hostname: "b1", next: "fox")]
  pending_name_collisions(allocations: roster).length() == 2
}
