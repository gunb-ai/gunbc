module test.claim.walk_target_alias_apply_witness_test

import tools.walk_target_alias_apply {
  walk_target_alias_apply_plan_pure,
  walk_target_alias_binding_identity_oracle_static,
  walk_target_alias_binding_identity_oracle_executed_refused,
  alias_apply_parse_module_source,
  alias_apply_insert_anchor_after_import_block,
  alias_apply_row_node_from_binding_row,
  ModuleInsertAnchor,
  WalkTargetAliasPlan
}
import tools.walk_target_alias_plan {
  WalkTargetAliasPlanRow,
  WalkTargetAliasPlanRowKey,
  WalkTargetAliasPlanClass,
  GlobalBareLcp,
  FnParentFirstHit
}
import v2.std.collection { Present, Absent, Optional, optional_absent, optional_present }
import v2.std.diagnostic { Accepted, Rejected, bind_outcome }
import v2.std.namespace_alias { AliasBindingRow }
import v2.std.node { Node, Named }
import v2.std.qualified_name { qualified_name_from_dotted_string }
import v2.std.logic { Bool }
import v2.extdeps.languages.dag {
  parse_production_emitted_identity_optional,
