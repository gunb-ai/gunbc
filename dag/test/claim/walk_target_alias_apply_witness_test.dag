}
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }

fn wtaa_find_import_node_in_children(tree: Node) -> Optional<Node> {
  fold(tree.children, init: optional_absent(), f: fn(acc, edge) {
    match acc {
      Present { value: _ } => acc
      Absent => wtaa_find_import_node(tree: edge.target)
    }
  })
}

fn wtaa_find_import_node(tree: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: tree) {
    Present { value: id } =>
      if id == ^dag_surface_import_decl {
        optional_present(value: tree)
      } else {
        wtaa_find_import_node_in_children(tree: tree)
      }
    Absent => wtaa_find_import_node_in_children(tree: tree)
  }
}

fn wtaa_fixture_has_import_decl(tree: Node) -> Bool {
  match wtaa_find_import_node(tree: tree) {
    Present { value: _ } => true
    Absent => false
  }
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data wtaa_import_block_fixture_source: String = "module v2.test.walk_target_alias_apply.probe\nimport v2.std.algebra { Cons, Empty }\n"

data wtaa_header_only_fixture_source: String = "module v2.test.walk_target_alias_apply.probe_header_only\n"

data wtaa_global_bare_lcp_plan_row: WalkTargetAliasPlanRow = WalkTargetAliasPlanRow {
  key: WalkTargetAliasPlanRowKey {
    class: GlobalBareLcp,
    declaring_module: "test.aliasplan.near.consumer",
    binding: "AmbigType",
    walk_target_qualified_path: "test.aliasplan.near.AmbigType"
  },
  pre_flip_qualified_path: "test.aliasplan.near.AmbigType",
  walk_verified: true,
  lookup_events: 1
}

data wtaa_fn_parent_plan_row: WalkTargetAliasPlanRow = WalkTargetAliasPlanRow {
  key: WalkTargetAliasPlanRowKey {
    class: FnParentFirstHit,
    declaring_module: "test.aliasplan.fn_parent.leaf",
    binding: "shared_pick",
    walk_target_qualified_path: "test.aliasplan.fn_parent.a.shared_pick"
  },
  pre_flip_qualified_path: "test.aliasplan.fn_parent.a.shared_pick",
  walk_verified: true,
  lookup_events: 1
}

fn wtaa_oracle_accepts_row(row: WalkTargetAliasPlanRow) -> Bool {
  match walk_target_alias_binding_identity_oracle_static(rows: [row]) {
    Absent => true
    Present { value: _ } => false
  }
}

fn wtaa_oracle_refuses_unverified_row() -> Bool {
  let bad = WalkTargetAliasPlanRow {
    key: WalkTargetAliasPlanRowKey {
      class: GlobalBareLcp,
      declaring_module: "test.bad",
      binding: "X",
      walk_target_qualified_path: "test.bad.X"
    },
    pre_flip_qualified_path: "test.bad.X",
    walk_verified: false,
    lookup_events: 0
  }
  match walk_target_alias_binding_identity_oracle_static(rows: [bad]) {
    Present { value: msg } => string_contains(s: msg, pattern: "BINDING_IDENTITY_ORACLE")
    Absent => false
  }
}

fn wtaa_oracle_refuses_walk_target_mismatch() -> Bool {
  let bad = WalkTargetAliasPlanRow {
    key: WalkTargetAliasPlanRowKey {
      class: GlobalBareLcp,
      declaring_module: "test.bad",
      binding: "X",
      walk_target_qualified_path: "test.a.X"
    },
    pre_flip_qualified_path: "test.b.X",
    walk_verified: true,
    lookup_events: 1
  }
  match walk_target_alias_binding_identity_oracle_static(rows: [bad]) {
    Present { value: msg } =>
      string_contains(s: msg, pattern: "walk_target=")
        && string_contains(s: msg, pattern: "pre_flip_qn=")
    Absent => false
  }
}

fn wtaa_insert_anchor_child_index_for(source: String) -> Int? {
  match alias_apply_parse_module_source(
    text: source,
    file_anchor: ^walk_target_alias_apply_insert_anchor_fixture
  ) {
    Rejected { diagnostics: _ } => none
    Accepted { value: module_root, diagnostics: _ } =>
      match alias_apply_insert_anchor_after_import_block(module_root: module_root) {
        Rejected { diagnostics: _ } => none
        Accepted { value: anchor, diagnostics: _ } => Present { value: anchor.child_index }
      }
  }
}

fn wtaa_insert_anchor_after_import_block_holds() -> Bool {
  match alias_apply_parse_module_source(
    text: wtaa_import_block_fixture_source,
    file_anchor: ^walk_target_alias_apply_insert_anchor_fixture
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: module_root, diagnostics: _ } =>
      match alias_apply_insert_anchor_after_import_block(module_root: module_root) {
        Rejected { diagnostics: _ } => false
        Accepted { value: anchor, diagnostics: _ } =>
          (anchor.child_index == 1) && wtaa_fixture_has_import_decl(tree: module_root)
      }
  }
}

fn wtaa_insert_anchor_header_only_is_zero_holds() -> Bool {
  match wtaa_insert_anchor_child_index_for(source: wtaa_header_only_fixture_source) {
    Present { value: idx } => idx == 0
    Absent => false
  }
}

fn wtaa_alias_decl_emit_node_holds() -> Bool {
  let row = AliasBindingRow {
    binding: ^AmbigType,
    target: qualified_name_from_dotted_string(dotted: "test.aliasplan.near.AmbigType")
  }
  let decl = alias_apply_row_node_from_binding_row(row: row)
  fold(
    decl.children,
    init: false,
    f: fn(found, edge) {
      if found {
        true
      } else {
        match edge.label {
          Named { name: sym } => sym == ^dag_surface_alias_decl
          Positional => false
        }
      }
    }
  )
}

fn wtaa_corpus_write_gate_refuses_holds() -> Bool {
  let plan = WalkTargetAliasPlan {
    rows: [wtaa_global_bare_lcp_plan_row],
    refused: [],
    source_scope_label: "write-gate-fixture"
  }
  match walk_target_alias_apply_plan_pure(plan: plan, write_requested: true) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } =>
      string_contains(s: d.head.reason, pattern: "#6979")
  }
}

fn wtaa_dry_run_apply_seed_gap_refuses_holds() -> Bool {
  let plan = WalkTargetAliasPlan {
    rows: [wtaa_global_bare_lcp_plan_row],
    refused: [],
    source_scope_label: "dry-run-fixture"
  }
  match walk_target_alias_apply_plan_pure(plan: plan, write_requested: false) {
    Rejected { diagnostics: _ } => false
    Accepted { value: report, diagnostics: _ } =>
      report.binding_identity_static_oracle_passed && !report.write_requested
  }
}

fn wtaa_executed_oracle_seed_gap_is_declared() -> Bool {
  string_contains(
    s: walk_target_alias_binding_identity_oracle_executed_refused(),
    pattern: "BINDING_IDENTITY_ORACLE_EXECUTED"
  )
}

fn wtaa_positive_control_plan_rows_oracle_green() -> Bool {
  wtaa_oracle_accepts_row(row: wtaa_global_bare_lcp_plan_row)
    && wtaa_oracle_accepts_row(row: wtaa_fn_parent_plan_row)
}

test fn walk_target_alias_apply_static_oracle_red_on_unverified_holds() -> Bool {
  wtaa_oracle_refuses_unverified_row()
}

test fn walk_target_alias_apply_static_oracle_red_on_walk_target_mismatch_holds() -> Bool {
  wtaa_oracle_refuses_walk_target_mismatch()
}

test fn walk_target_alias_apply_parse_fixture_holds() -> Bool {
  match alias_apply_parse_module_source(
    text: wtaa_import_block_fixture_source,
    file_anchor: ^walk_target_alias_apply_insert_anchor_fixture
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn walk_target_alias_apply_insert_anchor_tree_fact_holds() -> Bool {
  wtaa_insert_anchor_after_import_block_holds()
}

test fn walk_target_alias_apply_insert_anchor_header_only_red_control_holds() -> Bool {
  wtaa_insert_anchor_header_only_is_zero_holds()
}

test fn walk_target_alias_apply_alias_decl_emit_node_holds() -> Bool {
  wtaa_alias_decl_emit_node_holds()
}

test fn walk_target_alias_apply_corpus_write_gate_refuses_holds() -> Bool {
  wtaa_corpus_write_gate_refuses_holds()
}

test fn walk_target_alias_apply_dry_run_seed_gap_holds() -> Bool {
  wtaa_dry_run_apply_seed_gap_refuses_holds()
}

test fn walk_target_alias_apply_executed_oracle_seed_gap_holds() -> Bool {
  wtaa_executed_oracle_seed_gap_is_declared()
}

test fn walk_target_alias_apply_positive_control_plan_rows_oracle_holds() -> Bool {
  wtaa_positive_control_plan_rows_oracle_green()
}
