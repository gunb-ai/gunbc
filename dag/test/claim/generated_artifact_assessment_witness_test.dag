module test.claim.generated_artifact_assessment

import gunbc.generated_artifact { GeneratedArtifact, DesignArtifact, RoadmapArtifact, GitignoreArtifact, GitattributesArtifact }
import gunbc.generated_artifact_assessment {
  GeneratedArtifactObservation,
  GeneratedArtifactObserved,
  GeneratedArtifactObservationRefused,
  GeneratedArtifactPopulationFindings,
  UnadjudicatedArtifactFinding,
  generated_artifact_population_findings,
  generated_artifact_population_findings_count,
  generated_artifact_population_findings_empty,
  generated_artifact_population_findings_rendered,
  expected_cardinality_finding_rendered,
  observation_finding_rendered
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// EVERY FIXTURE HERE IS AUTHORED, INPUT AND EXPECTATION BOTH. The production population is never
// the oracle: folding the live committed roster and asserting what it returns would be
// `measure() == measure()`, the change detector DESIGN section 5 rejects. The defect this carrier
// was built to remove -- a complete verdict reported through a one-item diagnostic -- is only
// observable when MORE THAN ONE finding exists at once, and the live tree cannot be relied on to
// carry a specific multiplicity. So the multiplicities are planted.

fn artifact_observation_fixture(a: GeneratedArtifact, path: String, gen: String, com: String, valid: Bool) -> GeneratedArtifactObservation {
  GeneratedArtifactObserved {
    artifact: a, path: path, generated_content: gen, committed_content: com, extra_validation: valid
  }
}

fn clean_observation(a: GeneratedArtifact, path: String) -> GeneratedArtifactObservation {
  artifact_observation_fixture(a: a, path: path, gen: "same", com: "same", valid: true)
}

fn drifted_observation(a: GeneratedArtifact, path: String) -> GeneratedArtifactObservation {
  artifact_observation_fixture(a: a, path: path, gen: "generated", com: "committed", valid: true)
}

// ---------------------------------------------------------------------------------------------
// 1. SAME-CLASS MULTIPLICITY -- the direct RED for the within-class collapse.
// ---------------------------------------------------------------------------------------------

fn two_drift_expected() -> List<GeneratedArtifact> {
  [DesignArtifact, RoadmapArtifact]
}

fn two_drift_observations() -> List<GeneratedArtifactObservation> {
  [
    drifted_observation(a: DesignArtifact, path: "DESIGN.md"),
    drifted_observation(a: RoadmapArtifact, path: "ROADMAP.md")
  ]
}

test fn two_content_drifts_are_both_reported() -> Bool {
  let f = generated_artifact_population_findings(expected: two_drift_expected(), observations: two_drift_observations())
  (f.observation_failures |> count) == 2
    && (f.unadjudicated |> count) == 0
    && (f.expected_cardinality |> count) == 0
    && (f.unknown_observations |> count) == 0
    && generated_artifact_population_findings_count(f: f) == 2
}

// The old shape returned ONE path regardless of how many artifacts had drifted. Asserting the
// count alone would still pass a projection that reported the same artifact twice, so this pins
// both IDENTITIES rather than the cardinality.
test fn two_content_drifts_name_both_distinct_artifacts() -> Bool {
  let f = generated_artifact_population_findings(expected: two_drift_expected(), observations: two_drift_observations())
  let paths = map(f.observation_failures, x => observation_finding_rendered(f: x))
  any(paths, p => string_contains(s: p, pattern: "DESIGN.md")) && any(paths, p => string_contains(s: p, pattern: "ROADMAP.md"))
}

// ORDER INDEPENDENCE. The removed projections were folds that kept whichever failure they met
// first, so their answer was a function of input order. The complete population must not be.
test fn finding_population_does_not_depend_on_observation_order() -> Bool {
  let forward = generated_artifact_population_findings(expected: two_drift_expected(), observations: two_drift_observations())
  let reversed = generated_artifact_population_findings(
    expected: two_drift_expected(),
    observations: [
      drifted_observation(a: RoadmapArtifact, path: "ROADMAP.md"),
      drifted_observation(a: DesignArtifact, path: "DESIGN.md")
    ]
  )
  generated_artifact_population_findings_count(f: forward) == generated_artifact_population_findings_count(f: reversed)
    && (forward.observation_failures |> count) == (reversed.observation_failures |> count)
}

// ---------------------------------------------------------------------------------------------
// 2. CROSS-CLASS MULTIPLICITY -- the direct RED for the across-class collapse.
// ---------------------------------------------------------------------------------------------

// One population carrying every cause at once. The old diagnostic priority-ordered these three
// classes and returned the first non-empty, so a tree with all of them reported exactly one.
fn mixed_expected() -> List<GeneratedArtifact> {
  [DesignArtifact, RoadmapArtifact, GitignoreArtifact, GithooksPrePushArtifact]
}

fn mixed_observations() -> List<GeneratedArtifactObservation> {
  [
    drifted_observation(a: DesignArtifact, path: "DESIGN.md"),
    GeneratedArtifactObservationRefused { artifact: RoadmapArtifact, path: "ROADMAP.md", cause: "committed read failed" },
    artifact_observation_fixture(a: GitignoreArtifact, path: ".gitignore", gen: "same", com: "same", valid: false),
    clean_observation(a: GitattributesArtifact, path: ".gitattributes")
  ]
}

test fn every_cause_is_reported_together() -> Bool {
  let f = generated_artifact_population_findings(expected: mixed_expected(), observations: mixed_observations())
  (f.observation_failures |> count) == 2
    && (f.unadjudicated |> count) == 1
    && (f.expected_cardinality |> count) == 1
    && (f.unknown_observations |> count) == 1
    && generated_artifact_population_findings_count(f: f) == 5
}

// THE SEPARATION, AS A DISCRIMINATING CLAIM RATHER THAN A SHAPE DESCRIPTION.
//
// mixed_observations carries exactly one REFUSED observation and two comparison failures. Before
// the split all three sat in observation_failures and a consumer reading that count could not
// tell "two artifacts drifted" from "two artifacts could not be read". This pins the refusal to
// the provenance bucket BY IDENTITY -- the cause travels with it -- and pins its ABSENCE from the
// comparison bucket, which is the half that would silently regress if the arm were folded back.
test fn a_refusal_is_provenance_and_never_a_comparison_result() -> Bool {
  let f = generated_artifact_population_findings(expected: mixed_expected(), observations: mixed_observations())
  let causes = map(f.unadjudicated, u => u.cause)
  (f.unadjudicated |> count) == 1
    && any(causes, c => string_contains(s: c, pattern: "committed read failed"))
    && (f.observation_failures |> count) == 2
}

// A CLEAN POPULATION MUST LEAVE THE PROVENANCE BUCKET EMPTY, or the field would report findings
// for runs that reached every verdict -- the mirror defect of hiding them.
test fn a_fully_observed_population_has_no_unadjudicated_members() -> Bool {
  let f = generated_artifact_population_findings(expected: two_drift_expected(), observations: two_drift_observations())
  (f.unadjudicated |> count) == 0 && (f.observation_failures |> count) == 2
}

// DUPLICATE AND MISSING ARE SEPARATE ARMS, because their repairs differ: a missing observation
// points at the observer or the population producer, a duplicate at population construction or
// identity aliasing. One ExpectedCardinalityWrong arm would discard that.
test fn duplicate_and_missing_are_distinct_findings() -> Bool {
  let f = generated_artifact_population_findings(
    expected: [DesignArtifact, RoadmapArtifact],
    observations: [
      clean_observation(a: DesignArtifact, path: "DESIGN.md"),
      clean_observation(a: DesignArtifact, path: "DESIGN.md")
    ]
  )
  let rendered = map(f.expected_cardinality, x => expected_cardinality_finding_rendered(f: x))
  (f.expected_cardinality |> count) == 2
    && any(rendered, r => string_contains(s: r, pattern: "found 0"))
    && any(rendered, r => string_contains(s: r, pattern: "more than one"))
}

// EACH CLASS CARRIES ITS OWN REMEDY, AND THE SECOND CLAUSE IS THE WHOLE POINT. The gate body used
// to append one closing instruction -- regenerate via main_wet -- to every nonempty population,
// which is right for a content difference and wrong for every other class. Asserting only that the
// drift line names the producer would stay green under that global sentence, because a universal
// suffix satisfies it too; the discriminating half is that a MISSING-OBSERVATION line must NOT name
// the producer, since regenerating cannot repair an observer that never adjudicated the artifact.
// Reintroducing any run-level remedy makes this red.
test fn remedies_are_class_specific_not_universal() -> Bool {
  let f = generated_artifact_population_findings(
    expected: [DesignArtifact, RoadmapArtifact],
    observations: [drifted_observation(a: DesignArtifact, path: "DESIGN.md")]
  )
  let drift = map(f.observation_failures, x => observation_finding_rendered(f: x))
  let missing = map(f.expected_cardinality, x => expected_cardinality_finding_rendered(f: x))
  any(drift, d => string_contains(s: d, pattern: "main_wet"))
    && !any(missing, m => string_contains(s: m, pattern: "main_wet"))
    && any(missing, m => string_contains(s: m, pattern: "never adjudicated"))
}

// ---------------------------------------------------------------------------------------------
// 3. MULTI-AXIS SINGLE OBSERVATION -- the leaf must not become a first-remedy projection.
// ---------------------------------------------------------------------------------------------

test fn one_observation_yields_both_content_and_validation_findings() -> Bool {
  let f = generated_artifact_population_findings(
    expected: [DesignArtifact],
    observations: [artifact_observation_fixture(a: DesignArtifact, path: "DESIGN.md", gen: "generated", com: "committed", valid: false)]
  )
  (f.observation_failures |> count) == 2
}

// ---------------------------------------------------------------------------------------------
// 4. POSITIVE CONTROL -- prevents an assessment that reports every member as failing.
// ---------------------------------------------------------------------------------------------

test fn clean_population_agrees_over_a_nonempty_roster() -> Bool {
  let expected = [DesignArtifact, RoadmapArtifact]
  let observations = [
    clean_observation(a: DesignArtifact, path: "DESIGN.md"),
    clean_observation(a: RoadmapArtifact, path: "ROADMAP.md")
  ]
  let f = generated_artifact_population_findings(expected: expected, observations: observations)
  generated_artifact_population_findings_empty(f: f)
    && (expected |> count) > 0
    && assess_generated_artifact_population(expected: expected, observations: observations)
    && generated_artifact_population_findings_rendered(f: f) == ""
}

// THE BOOLEAN IS A PROJECTION AND NOT A SECOND OPINION. If the two ever disagreed, the fork this
// cut removed would be back.
test fn boolean_projection_agrees_with_the_finding_population() -> Bool {
  assess_generated_artifact_population(expected: mixed_expected(), observations: mixed_observations()) == false
    && assess_generated_artifact_population(expected: two_drift_expected(), observations: two_drift_observations()) == false
}

// ---------------------------------------------------------------------------------------------
// 5. THE BOUND-SHAPED RED -- restore the old shape and show what it loses.
// ---------------------------------------------------------------------------------------------

// This reconstructs the DELETED behaviour: keep only the first observation failure. It exists so
// the class has an executing discriminator rather than a description. If a future change makes
// the complete population head-shaped again, this witness goes red while a green-fixture-only
// suite would not notice.
fn first_only_projection(f: GeneratedArtifactPopulationFindings) -> Int {
  if (f.observation_failures |> count) == 0 { 0 } else { 1 }
}

test fn a_first_only_projection_loses_findings_the_population_keeps() -> Bool {
  let f = generated_artifact_population_findings(expected: mixed_expected(), observations: mixed_observations())
  first_only_projection(f: f) == 1
    && generated_artifact_population_findings_count(f: f) == 5
    && generated_artifact_population_findings_count(f: f) > first_only_projection(f: f)
}

// The rendering must carry every finding, not a head. Counting sections rather than characters
// keeps this from passing on a truncated message that happens to be long.
test fn rendering_carries_every_class_that_has_findings() -> Bool {
  let r = generated_artifact_population_findings_rendered(
    f: generated_artifact_population_findings(expected: mixed_expected(), observations: mixed_observations())
  )
  string_contains(s: r, pattern: "observation failures:")
    && string_contains(s: r, pattern: "expected observation cardinality:")
    && string_contains(s: r, pattern: "unknown observations:")
    && string_contains(s: r, pattern: "5 findings")
}
