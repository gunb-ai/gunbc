module test.claim.pun_shadow.with_import

import std.types { Int }
import test.claim.pun_shadow.home { shadowed_name }

type PunThing = PunDup { shadowed_name: Int } | PunOther

fn in_arm(v: PunThing) -> Int {
  match v {
    PunDup { shadowed_name } => shadowed_name
    PunOther => 0
  }
}

fn free_call() -> Int {
  shadowed_name(2)
}
