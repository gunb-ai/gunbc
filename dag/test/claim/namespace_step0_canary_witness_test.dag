module test.claim.namespace_step0_canary_witness

import std.types { Bool, NonEmptyStr }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import extdeps.git.object_store { GitObjectId, git_sha1_object_id }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.namespace_step0_canary {
  namespace_step0_canary_contract,
  namespace_step0_manifest_identity,
  namespace_step0_unavailable_receipt,
  namespace_step0_unavailable_receipt_admitted,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn canary_commit() -> GitObjectId? {
  git_sha1_object_id(hex: "cfb448de521965163e9a82e0a9eb77b311b49f9d")
}

fn canary_tree() -> GitObjectId? {
  git_sha1_object_id(hex: "140fbae21fbc209319bbe1a9d9bfbdfd2c5d5dc6")
}

fn foreign_tree() -> GitObjectId? {
  git_sha1_object_id(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
}

fn canary_compiler() -> Sha256Digest? {
  sha256_hex_digest(hex: "4a14d9095b820ad92b7b12752c6464cc0b25f91897c85958feb8bac9ad5c9f3e")
}

test fn current_main_step0_canary_receipt_is_admitted() -> Bool {
  match canary_commit() {
    Absent => false
    Present { value: commit } => match canary_tree() {
      Absent => false
      Present { value: tree } => match canary_compiler() {
        Absent => false
        Present { value: compiler } => namespace_step0_unavailable_receipt_admitted(
          receipt: namespace_step0_unavailable_receipt(
            contract_identity: namespace_step0_canary_contract.identity,
            source_commit: commit,
            source_tree: tree,
            compiler_program: "target/release/gunbc" as NonEmptyStr,
            compiler_executable_sha256: compiler,
            input_subject_manifest: namespace_step0_manifest_identity()
          ),
          expected_commit: commit,
          expected_tree: tree,
          expected_compiler_sha256: compiler
        )
      }
    }
  }
}

// A receipt from another tree cannot inherit current main's observation. This is the second-end
// revision binding: the contract is frozen independently, while each observation names its tree.
test fn a_foreign_tree_cannot_relabel_the_current_main_receipt() -> Bool {
  match canary_commit() {
    Absent => false
    Present { value: commit } => match canary_tree() {
      Absent => false
      Present { value: tree } => match foreign_tree() {
        Absent => false
        Present { value: other_tree } => match canary_compiler() {
          Absent => false
          Present { value: compiler } => !namespace_step0_unavailable_receipt_admitted(
            receipt: namespace_step0_unavailable_receipt(
              contract_identity: namespace_step0_canary_contract.identity,
              source_commit: commit,
              source_tree: other_tree,
              compiler_program: "target/release/gunbc" as NonEmptyStr,
              compiler_executable_sha256: compiler,
              input_subject_manifest: namespace_step0_manifest_identity()
            ),
            expected_commit: commit,
            expected_tree: tree,
            expected_compiler_sha256: compiler
          )
        }
      }
    }
  }
}

// An empty/foreign contract is not a harmless empty observation. It is refused before its subject
// entry or completeness fields can be read as evidence about Step 0.
test fn a_foreign_contract_cannot_present_an_unavailable_observation_as_this_canary() -> Bool {
  match canary_commit() {
    Absent => false
    Present { value: commit } => match canary_tree() {
      Absent => false
      Present { value: tree } => match canary_compiler() {
        Absent => false
        Present { value: compiler } => !namespace_step0_unavailable_receipt_admitted(
          receipt: namespace_step0_unavailable_receipt(
            contract_identity: "foreign-empty-canary" as NonEmptyStr,
            source_commit: commit,
            source_tree: tree,
            compiler_program: "target/release/gunbc" as NonEmptyStr,
            compiler_executable_sha256: compiler,
            input_subject_manifest: namespace_step0_manifest_identity()
          ),
          expected_commit: commit,
          expected_tree: tree,
          expected_compiler_sha256: compiler
        )
      }
    }
  }
}
