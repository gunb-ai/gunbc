module test.claim.srv3_os_install


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// ARCH-GROUNDED is still the claim and is asserted directly on the mapping,
// which is where it lives. The srv3 clause that used to read the architecture off
// a Ready plan is now the plan's refusal: with no delivery mechanism selectable
// on 3.22.00 there is no plan to take an architecture from, and taking one anyway
// would be reading a field off a plan that does not exist.
test fn bootloader_artifact_is_arch_grounded() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
    && match network_uefi_bootloader_artifact(arch: X86_64) {
      Present { value: x } => x == "grubnetx64.efi"
      Absent => false
    }
    && match network_uefi_bootloader_artifact(arch: Riscv64) {
      Present { value: _ } => false
      Absent => true
    }
}

test fn srv3_pxe_chain_is_uefi_http_boot_when_modeled() -> Bool {
  match srv3_pxe_network_boot_chain.boot_mode {
    UefiHttpBoot => true
    LegacyBiosPxe { tftp_root: _ } => false
    UefiPxe { tftp_root: _ } => false
  }
}

test fn srv3_survey_forces_proxy_dhcp() -> Bool {
  match srv3_pxe_network_boot_chain.dhcp_direction {
    ProxyDhcp => true
    NativeDhcpBootOptions => false
  }
    && match survey_implied_dhcp_direction(
      survey: gunbc.os_install.LanInstallInfraSurvey {
        existing_dhcp_configurable: true,
        dedicated_install_server_present: false,
      }
    ) {
      ProxyDhcp => false
      NativeDhcpBootOptions => true
    }
}

// Now asserted through the standing, so a refusal cannot read as a satisfied plan: the plan
// arm must be Ready AND its delivery virtual-media, both derived from srv3's firmware evidence.
// SOLVER-DERIVED is the claim, and the two halves moving TOGETHER is the proof.
// A plan hardcoded to nbd-proxy virtual media would still be Ready now that the
// solve refuses; because it is derived, both refuse. Asserting the pair is
// strictly more discriminating than the old version, which could not tell a
// derived plan from a hardcoded one while the solve happened to agree with it.
test fn srv3_plan_is_solver_derived_and_refuses_with_the_solve() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
    && match srv3_install_mechanism_solution {
      OsInstallMechanismRefused { cause: _ } => true
      OsInstallMechanismSelected { mechanism: _ } => false
    }
    && fleet_install_server_specs.length() == 0
}

// The plan's TARGET facts — Ubuntu 24.04, Cd, Once, fully-automated seed — are
// not assertable while no plan exists, and this witness now says that instead of
// describing one. They are not lost: they are what the INSTALL-0 lane must
// reproduce once srv3 has an established delivery path again, at which point this
// witness reds and is replaced by the real target assertions rather than
// silently continuing to pass.
test fn srv3_plan_target_facts_are_unassertable_while_the_plan_refuses() -> Bool {
  match srv3_os_install_plan_standing {
    OsInstallPlanRefused { cause: _ } => true
    OsInstallPlanReady { plan: _ } => false
  }
}
