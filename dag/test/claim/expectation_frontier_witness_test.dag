module test.claim.expectation_frontier_witness

import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import gunbc.ci_layer_roots { witness_layer_roots }
import gunbc.output_policy { ExpectSuccess }
import std.logic { Bool }
import std.types { String }
import tools.host_prelude { ClaimRun, claim_batch_claims_argv, witness_bin_release_path }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data expectation_frontier_note: String = "EXECUTING CONSUMER for the expectation frontier (v1_interpreter ExpectationDeclaration). The boundary no longer manufactures an expectation when a call site declares none — absence is the value UntracedDefault, which still resolves to ExpectSuccess (no behaviour change, and no floor-time refusal per the operator guardrail) but is COUNTED at its located service.op and emitted as [expectation-frontier]. That receipt is the entire difference between a declared interim frontier and the fail-open it replaced: an absorbed default that is tallied can be prioritised and shrunk, one that is not has frequency zero by construction and never ranks for fixing (DESIGN §5). A COUNTER THAT IS NEVER READ IS THE SAME LIE AS NO COUNTER, so this witness reads it from a real child run rather than trusting the mechanism. THE PAIR IS THE PROOF: an entry whose effects are undeclared MUST emit the line, and an entry whose effects all declare their arm MUST NOT. Either claim alone is satisfiable by a broken counter — one that always fires passes the first, one that never fires passes the second — so neither is dropped even when it looks redundant."

data subject_source_roots_note: String = "witness_layer_roots (dag + src/v2), NOT compile_clean_source_roots. The difference is load-bearing and was found by execution: compile_clean_source_roots appends src/v1, which puts v1.std.core.Node and v2.std.node.Node in one pool, and any subject whose closure reaches the compiler modules then dies on ~100 `ambiguous reference Node` errors before running a single effect. A child that fails to RESOLVE dispatches nothing, emits no receipt, and reds this witness for a reason that has nothing to do with the mechanism under test — a false red that would read as a real one. The subject needs the roots it actually imports, so it gets them."

data frontier_marker: String = "[expectation-frontier]"

fn claim_batch_path() -> String {
  let root = git.Inspect.Toplevel()
  witness_bin_release_path(root: root.path, bin_name: "claim_batch")
}

fn run_entry_capturing_stderr(entry: String, function: String) -> String {
  let root = git.Inspect.Toplevel()
  let result = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: claim_batch_path(),
    args: claim_batch_claims_argv(
      source_roots: witness_layer_roots,
      claims: [ClaimRun { entry: entry, function: function }]
    ),
    expect: ExpectSuccess
  )
  result.stderr
}

data undeclared_subject_note: String = "SUBJECT RE-POINTED 2026-09-02 (dashboard node adhoc-f005ddc0-98e). This arm named dag/test/claim/long/generated_artifact_drift_fixed_point_witness_test.dag witness_committed_is_fixed_point, a file 611fd02770 (#8283, the FLOOR-Y cut, 2026-08-17) DELETED. Nothing went red, and the reason is worth carrying rather than fixing quietly: this row is enrolled on FalsifierRehomedBinWet, a cadence std.witness_admission witness_cadence_has_scheduled_route answers FALSE since falsifier.yml went with the same cut, so the row executes nowhere and could not red on a subject that was not there. IT WAS UNREACHABLE, NOT VACUOUS, and the difference decides the remedy: the release claim_batch REFUSES on that entry, typed and located, at exit 2 (measured 2026-09-02, BuildBuddy invocation ee22e7c5-6250-446d-a864-c2bf76cad6bd), which under the ExpectSuccess above is a red -- so restoring the cadence without this re-point would have reddened the lane for a reason unrelated to the mechanism under test. The two failures hid each other -- censused as the eighteenth site in gunbc.deleted_cadence_reference_census, which repairs neither the cadence nor pretends to. THE REPLACEMENT SUBJECT IS CHOSEN FOR THE PROPERTY THIS ARM ACTUALLY NEEDS, not for resemblance: test.claim.gitattributes_emit_witness witness_committed_matches_emit_holds reaches Filesystem.Read from a .dag call site that carries no `expect:`, so a correct counter must emit the receipt on it. It is also a live per-PR discovery row, which means the subject cannot silently vanish the way the last one did -- a deletion would red the required lane before it could orphan this citation. THE COUNT IS DELIBERATELY NOT PINNED, for the reason the prior note gave and which still holds: the claim is the receipt PRESENCE, which is the property the mechanism owns; a pinned dispatch count turns an unrelated edit into a red here."

test fn undeclared_effects_emit_the_frontier_receipt_holds() -> Bool {
  let stderr = run_entry_capturing_stderr(
    entry: "dag/test/claim/gitattributes_emit_witness_test.dag",
    function: "witness_committed_matches_emit_holds"
  )
  string_contains(s: stderr, pattern: frontier_marker)
}

data declared_subject_note: String = "roadmap_belt_actuate's three probes (belt_program_available, belt_exec, belt_observe) all carry `expect: OutcomeIsData`, so a correct counter stays silent on this entry. NOTE THE COUPLING, because it is load-bearing exactly as the no-fake-anomalies wall's is: if those annotations are ever removed, this control goes red — which is the correct outcome and should be read as the control working, not as this witness being wrong. If the entry stops exercising effects entirely the control passes VACUOUSLY; re-point it at another fully-annotated effect entry rather than deleting it."

test fn fully_declared_effects_emit_no_frontier_receipt_holds() -> Bool {
  let stderr = run_entry_capturing_stderr(
    entry: "dag/test/claim/roadmap/roadmap_belt_actuate_witness_test.dag",
    function: "witness_exec_ok_runs_echo"
  )
  !string_contains(s: stderr, pattern: frontier_marker)
}
