module test.claim.runner_placement_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn live_plan() -> gunbc.ci_runner_placement.RunnerDeploymentPlan {
  gunbc.ci_runner_placement.runner_deployment_plan()
}

fn witness_live_plan_is_conservation_sound() -> Bool {
  match live_plan() {
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: total } =>
      hosts.length() == gunbc.ci_fleet.fleet_intent_offers.length()
        && total == gunbc.fleet_host_budget.declared_runner_count() * gunbc.ci_fleet.fleet_intent_offers.length()
        && all(hosts, h =>
            h.runner_count == gunbc.fleet_host_budget.declared_runner_count()
              && std.measure.byte_size_count(b: h.per_runner_memory_cap) == std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap)
              && std.measure.byte_size_count(b: h.runner_slice_cap) == std.measure.byte_size_count(b: gunbc.fleet_host_budget.gunbc_runner_pool_budget)
              && std.measure.hardware_thread_count_value(t: h.build_tokens) > 0
          )
    gunbc.ci_runner_placement.PlanUnsound { reason: _ } => false
  }
}

fn witness_per_runner_cap_within_runner_pool() -> Bool {
  match live_plan() {
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h =>
            h.runner_count * std.measure.byte_size_count(b: h.per_runner_memory_cap) <= std.measure.byte_size_count(b: h.runner_slice_cap)
          )
    gunbc.ci_runner_placement.PlanUnsound { reason: _ } => false
  }
}

fn witness_live_session_plan_fail_closed() -> Bool {
  match gunbc.ci_runner_placement.session_reservation_plan() {
    gunbc.ci_runner_placement.SessionReservationUnsound { reason: _ } => true
    gunbc.ci_runner_placement.SessionReservationDerived { hosts: _, fleet_concurrent_sessions: _, per_session_reservation: _, coverage_count: _, sample_count: _ } => false
  }
}

fn witness_live_effective_runners_derives_declared_count() -> Bool {
  match gunbc.ci_runner_placement.effective_runners_per_host() {
    gunbc.ci_runner_placement.RunnersPerHostDerived { count: c } => c == gunbc.fleet_host_budget.declared_runner_count()
    gunbc.ci_runner_placement.RunnersPerHostUnsound { reason: _ } => false
  }
}

fn witness_sound_manifest_line_is_populated() -> Bool {
  match live_plan() {
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h => {
            let rendered = render(doc: gunbc.runner_deploy_emit.manifest_host_doc(h: h), proto: gunbc.runner_deploy_emit.runner_deploy_protocol)
            starts_with(s: rendered, prefix: concat(concat("host=", h.identity), " runner_count="))
          })
    gunbc.ci_runner_placement.PlanUnsound { reason: _ } => false
  }
}

fn witness_regime1_resolves_worst_case_slice() -> Bool {
  match gunbc.ci_runner_placement.resolve_session_slice(mode: gunbc.ci_floor_measurement.Regime1WorstCase { point: gunbc.ci_floor_measurement.SessionOperatingPointSet { per_session_cap: std.measure.byte_size(10000000000), session_concurrency: 4 } }, oomd: gunbc.ci_floor_measurement.OomdEnforced) {
    gunbc.ci_runner_placement.SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      std.measure.byte_size_count(b: b) == 40000000000 && std.measure.byte_size_count(b: c) == 10000000000 && n == 4
    gunbc.ci_runner_placement.SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_mode_unset_is_unresolved() -> Bool {
  match gunbc.ci_runner_placement.resolve_session_slice(mode: gunbc.ci_floor_measurement.SessionReservationModeUnset, oomd: gunbc.ci_floor_measurement.OomdEnforced) {
    gunbc.ci_runner_placement.SessionSliceUnresolved { reason: _ } => true
    gunbc.ci_runner_placement.SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_oomd_unverified_is_unresolved() -> Bool {
  match gunbc.ci_runner_placement.resolve_session_slice(mode: gunbc.ci_floor_measurement.Regime2AggregateOomd {
    oomd_eviction_ceiling: std.measure.byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: gunbc.ci_floor_measurement.SessionAggregateMeasured { bytes: std.measure.byte_size(15000000000) },
  }, oomd: gunbc.ci_floor_measurement.OomdUnverified) {
    gunbc.ci_runner_placement.SessionSliceUnresolved { reason: _ } => true
    gunbc.ci_runner_placement.SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_aggregate_unmeasured_is_unresolved() -> Bool {
  match gunbc.ci_runner_placement.resolve_session_slice(mode: gunbc.ci_floor_measurement.Regime2AggregateOomd {
    oomd_eviction_ceiling: std.measure.byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: gunbc.ci_floor_measurement.SessionAggregateUnmeasured,
  }, oomd: gunbc.ci_floor_measurement.OomdEnforced) {
    gunbc.ci_runner_placement.SessionSliceUnresolved { reason: _ } => true
    gunbc.ci_runner_placement.SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_reserves_aggregate_not_product() -> Bool {
  match gunbc.ci_runner_placement.resolve_session_slice(mode: gunbc.ci_floor_measurement.Regime2AggregateOomd {
    oomd_eviction_ceiling: std.measure.byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: gunbc.ci_floor_measurement.SessionAggregateMeasured { bytes: std.measure.byte_size(15000000000) },
  }, oomd: gunbc.ci_floor_measurement.OomdEnforced) {
    gunbc.ci_runner_placement.SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      std.measure.byte_size_count(b: b) == 15000000000 && std.measure.byte_size_count(b: c) == 8000000000 && n == 16
    gunbc.ci_runner_placement.SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_coverage_is_distribution_grounded() -> Bool {
  gunbc.ci_runner_placement.samples_covered(cap: std.measure.byte_size(0)) == 0
    && gunbc.ci_runner_placement.samples_covered(cap: std.measure.byte_size(2211908157)) == 6
    && gunbc.ci_runner_placement.samples_covered(cap: std.measure.byte_size(8879844884)) == 13
}

fn witness_curve_coverage_monotone_in_cap() -> Bool {
  let lo = gunbc.ci_runner_placement.evaluate_operating_point(cap: std.measure.byte_size(2000000000), n: 6)
  let hi = gunbc.ci_runner_placement.evaluate_operating_point(cap: std.measure.byte_size(8000000000), n: 6)
  hi.coverage_count >= lo.coverage_count
    && std.measure.byte_size_count(b: hi.sessions_slice) >= std.measure.byte_size_count(b: lo.sessions_slice)
}

fn witness_curve_has_full_coverage_option() -> Bool {
  v2.std.algebra.any(gunbc.ci_runner_placement.operating_curve(), r => r.coverage_count == r.sample_count)
}

fn witness_manifest_drift_red_receipt() -> Bool {
  !gunbc.runner_deploy_emit.runner_deploy_drifted(committed: gunbc.runner_deploy_emit.expected_runner_deploy_manifest())
    && gunbc.runner_deploy_emit.runner_deploy_drifted(committed: concat(gunbc.runner_deploy_emit.expected_runner_deploy_manifest(), "x"))
}

fn witness_session_cpu_weight_exceeds_runner_cpu_weight() -> Bool {
  gunbc.ci_runner_placement.workload_class_cpu_weight(wc: gunbc.ci_runner_placement.InteractiveLatencySensitive) > gunbc.ci_runner_placement.workload_class_cpu_weight(wc: gunbc.ci_runner_placement.BatchLatencyTolerant)
}

fn witness_runner_manifest_line_contains_cpu_weight() -> Bool {
  match live_plan() {
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h => string_contains(s: render(doc: gunbc.runner_deploy_emit.manifest_host_doc(h: h), proto: gunbc.runner_deploy_emit.runner_deploy_protocol), pattern: " cpu_weight=100"))
    gunbc.ci_runner_placement.PlanUnsound { reason: _ } => false
  }
}

fn witness_runner_and_session_cpu_weights_are_distinct() -> Bool {
  gunbc.ci_runner_placement.workload_class_cpu_weight(wc: gunbc.ci_runner_placement.BatchLatencyTolerant) != gunbc.ci_runner_placement.workload_class_cpu_weight(wc: gunbc.ci_runner_placement.InteractiveLatencySensitive)
}

fn witness_session_slice_line_emits_cpu_weight() -> Bool {
  let rendered = gunbc.runner_deploy_emit.expected_runner_deploy_manifest()
  string_contains(s: rendered, pattern: "session-slice host=")
    && string_contains(s: rendered, pattern: " cpu_weight=1000")
    && string_contains(s: rendered, pattern: " slice_max_bytes=")
    && string_contains(s: rendered, pattern: " per_session_max_bytes=")
    && string_contains(s: rendered, pattern: " oom_pressure_kill=true")
    && string_contains(s: rendered, pattern: " oom_pressure_limit_pct=60")
}

fn witness_session_reservation_line_has_no_cpu_weight() -> Bool {
  let fixture = gunbc.ci_runner_placement.SessionHostReservation {
    identity: "fixture-host",
    session_count: 4,
    per_session_reservation: std.measure.byte_size(4294967296),
    workload_class: gunbc.ci_runner_placement.InteractiveLatencySensitive,
  }
  !(string_contains(s: render(doc: gunbc.runner_deploy_emit.session_host_doc(h: fixture), proto: gunbc.runner_deploy_emit.runner_deploy_protocol), pattern: "cpu_weight"))
}

fn witness_real_manifest_fields_drive_both_formats() -> Bool {
  match gunbc.ci_runner_placement.runner_deployment_plan() {
    gunbc.ci_runner_placement.PlanUnsound { reason: _ } => false
    gunbc.ci_runner_placement.PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0 &&
      all(hosts, h => {
        let text_out = render(doc: gunbc.runner_deploy_emit.manifest_host_doc(h: h), proto: gunbc.runner_deploy_emit.runner_deploy_protocol)
        let json_out = render(doc: std.serialize.serialize_record_doc(knobs: std.languages.json_record_knobs, fields: gunbc.runner_deploy_emit.manifest_host_fields(h: h)), proto: gunbc.runner_deploy_emit.runner_deploy_protocol)
        text_out != json_out &&
          string_contains(s: text_out, pattern: concat("host=", h.identity)) &&
          string_contains(s: json_out, pattern: concat("\"host\": \"", h.identity))
      })
  }
}

fn witness_manifest_json_entry_point_produces_json_format() -> Bool {
  let full = expected_runner_deploy_manifest_json()
  string_contains(s: full, pattern: "runner-deploy {") &&
    string_contains(s: full, pattern: "\"host\": \"") &&
    string_contains(s: full, pattern: "\"cpu_weight\": \"")
}

test fn runner_placement_holds() -> Bool {
  witness_live_plan_is_conservation_sound()
    && witness_per_runner_cap_within_runner_pool()
    && witness_live_session_plan_fail_closed()
    && witness_live_effective_runners_derives_declared_count()
    && witness_sound_manifest_line_is_populated()
    && witness_regime1_resolves_worst_case_slice()
    && witness_mode_unset_is_unresolved()
    && witness_regime2_oomd_unverified_is_unresolved()
    && witness_regime2_aggregate_unmeasured_is_unresolved()
    && witness_regime2_reserves_aggregate_not_product()
    && witness_coverage_is_distribution_grounded()
    && witness_curve_coverage_monotone_in_cap()
    && witness_curve_has_full_coverage_option()
    && witness_manifest_drift_red_receipt()
    && witness_session_cpu_weight_exceeds_runner_cpu_weight()
    && witness_runner_manifest_line_contains_cpu_weight()
    && witness_runner_and_session_cpu_weights_are_distinct()
    && witness_session_slice_line_emits_cpu_weight()
    && witness_session_reservation_line_has_no_cpu_weight()
    && witness_real_manifest_fields_drive_both_formats()
    && witness_manifest_json_entry_point_produces_json_format()
}
