module test.claim.grub_cmdline_quoting


test fn grub_quotes_semicolon_cmdline_args_only() -> Bool {
  let entry = extdeps.bootloader.grub.GrubMenuEntry {
    title: "gunbc autoinstall",
    linux_image: "/casper/vmlinuz",
    linux_cmdline: [
      extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "ip", value: "dhcp" },
      extdeps.firmware.kernel_cmdline.KernelKeyValue { key: "ds", value: "nocloud;s=/cdrom/nocloud/srv4/" },
      extdeps.firmware.kernel_cmdline.KernelFlag { name: "autoinstall" },
    ],
    initrd_image: "/casper/initrd",
  }
  let r = extdeps.bootloader.grub.grub_menuentry_render(entry: entry)
  string_contains(s: r, pattern: "\"ds=nocloud;s=/cdrom/nocloud/srv4/\"")
    && string_contains(s: r, pattern: " ip=dhcp ")
    && (string_contains(s: r, pattern: "\"ip=dhcp\"") == false)
}
