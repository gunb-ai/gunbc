module test.claim.fleet_observation_producers_witness

import gunbc.fleet_shell_transport_observation {
  fleet_shell_transport_observation,
  fleet_shell_transport_unobserved_count,
  still_ram_738_session_shell_transport_receipt_note,
  ShellTransportReachRefused,
  ShellTransportSucceeded,
  ShellTransportUnobserved,
}
import gunbc.session_residency {
  session_residency_shell_gated_census,
  SessionsUnobserved,
  SessionsObservedAbsent,
  SessionsObservedPresent,
  SessionsOperatorDeclaredAbsent,
}
import gunbc.host_disk_observation {
  host_disk_fleet_unobserved_count,
  host_disk_observation,
  DiskUnobserved,
  DiskObservationRefused,
}
import gunbc.host_swap_backing {
  host_swap_backing_fleet_unobserved_count,
  host_swap_backing_host_verdict,
}
import gunbc.build_cache_endpoint_observation {
  build_cache_ci_endpoint_fleet_unavailable_count,
  build_cache_ci_placement_observation,
  build_cache_ci_endpoint_observation,
}
import gunbc.build_cache_instance {
  EndpointObservationUnavailable,
  ServerPlacementUnknown,
}
import gunbc.fleet_intent_network {
  operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4,
}
import gunbc.host_phase_status { fleet_subsumption_hosts }
import std.upsert_decision { UnknownRefused }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn producer_unobserved_all_enrolled_hosts_not_stale_reach_refused() -> Bool {
  fleet_shell_transport_unobserved_count() == fleet_subsumption_hosts.length() - 1
    && fleet_subsumption_hosts.length() > 0
    && match fleet_shell_transport_observation(host: operator_host_srv3) {
      ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } => true
      ShellTransportUnobserved { reason: _ } => false
      ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
    }
}

test fn srv3_shell_transport_observed_srv4_stays_unobserved_discriminates_grade() -> Bool {
  match fleet_shell_transport_observation(host: operator_host_srv3) {
    ShellTransportSucceeded { observed_on: o, principal: p, detail: d } =>
      (o as String) == "2026-08-07"
        && string_contains(s: p as String, pattern: "ubuntu@192.168.1.221")
        && string_contains(s: d as String, pattern: "vivid-eagle-131")
    ShellTransportUnobserved { reason: _ } => false
    ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
  }
    && match fleet_shell_transport_observation(host: operator_host_srv4) {
      ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } => false
      ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
      ShellTransportUnobserved { reason: r } =>
        string_contains(s: r, pattern: "dated session receipt")
          && string_contains(s: r, pattern: "2026-08-06")
          && string_contains(s: r, pattern: "Permission denied")
    }
    && string_contains(
      s: still_ram_738_session_shell_transport_receipt_note(host: operator_host_srv4),
      pattern: "A1",
    )
}

test fn session_producer_returns_unobserved_not_operator_declared_absent() -> Bool {
  match session_residency_shell_gated_census(host: operator_host_srv3) {
    SessionsUnobserved { reason: _ } => true
    SessionsOperatorDeclaredAbsent { reason: _ } => false
    SessionsObservedAbsent { observed_on: _ } => false
    SessionsObservedPresent { observed_on: _, container_count: _ } => false
  }
}

test fn disk_producer_unobserved_while_swap_backing_unknown_refused() -> Bool {
  host_disk_fleet_unobserved_count() == fleet_subsumption_hosts.length()
    && host_swap_backing_fleet_unobserved_count() == fleet_subsumption_hosts.length()
    && match host_disk_observation(host: operator_host_srv3) {
      DiskUnobserved { reason: _ } => true
      DiskObservationRefused { detail: _ } => false
      _ => false
    }
    && host_swap_backing_host_verdict(host: operator_host_srv3) == UnknownRefused
}

test fn build_cache_ci_endpoint_unavailable_not_absent() -> Bool {
  build_cache_ci_endpoint_fleet_unavailable_count() == fleet_subsumption_hosts.length()
    && match build_cache_ci_endpoint_observation(host: operator_host_srv3) {
      EndpointObservationUnavailable { instance: _, reason: _ } => true
      _ => false
    }
    && match build_cache_ci_placement_observation(host: operator_host_srv3) {
      ServerPlacementUnknown { detail: _ } => true
      _ => false
    }
}

test fn shell_transport_observation_not_authoritative_reach_refused() -> Bool {
  match fleet_shell_transport_observation(host: operator_host_srv1) {
    ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } => false
    ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
    ShellTransportUnobserved { reason: _ } => true
  }
    && match fleet_shell_transport_observation(host: operator_host_srv2) {
      ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } => false
      ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
      ShellTransportUnobserved { reason: _ } => true
    }
    && match fleet_shell_transport_observation(host: operator_host_srv4) {
      ShellTransportSucceeded { observed_on: _, principal: _, detail: _ } => false
      ShellTransportReachRefused { observed_on: _, principal: _, detail: _, gap: _ } => false
      ShellTransportUnobserved { reason: _ } => true
    }
}
