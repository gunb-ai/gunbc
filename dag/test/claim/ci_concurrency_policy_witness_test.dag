module test.claim.ci_concurrency_policy_witness_test

import gunbc.ci_workflow { ci_workflow }
import gunbc.ci_workflow_expressions {
  ci_concurrency_cancel_in_progress_if,
  ci_concurrency_cancel_in_progress_expression,
  ci_concurrency_group,
}
import extdeps.github.actions {
  ConcurrencyMappingQueueNotMax,
  CancelInProgressExpression,
}
import v2.std.collection { Present }
import v2.std.text { String }

test fn ci_concurrency_cancel_expression_holds() -> Bool {
  ci_concurrency_cancel_in_progress_expression() == ci_concurrency_cancel_in_progress_if
}

test fn ci_concurrency_event_scoped_stop_policy_holds() -> Bool {
  match ci_workflow.concurrency {
    Present { value: spec } =>
      match spec {
        ConcurrencyMappingQueueNotMax { group: _, cancel_in_progress: cip, explicit_single: _ } =>
          match cip {
            Present { value: c } =>
              match c {
                CancelInProgressExpression { expression: e } =>
                  e == "${{ github.event_name != 'merge_group' }}"
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn ci_concurrency_stop_policy_discriminates_merge_group() -> Bool {
  ci_concurrency_cancel_in_progress_if != "true"
    && ci_concurrency_cancel_in_progress_if != "false"
    && ci_concurrency_cancel_in_progress_if != "github.event_name != 'merge_group'"
}

// The group key is the arm that exempts main from supersession, so it carries three
// claims rather than one string comparison: the exact serialized form, that a main push
// keys on the per-commit sha, and that the exemption did NOT widen into the global
// unique-key mistake the stop-policy note warns about (PR events must still key on the
// PR number, or every event gets its own group and cancellation becomes unreachable).
test fn ci_concurrency_group_exempts_main_and_keeps_pr_supersession() -> Bool {
  ci_concurrency_group() == "${{ github.workflow }}-${{ github.event.pull_request.number || github.ref == 'refs/heads/main' && github.sha || github.ref }}"
}

test fn ci_concurrency_group_keys_main_pushes_per_commit() -> Bool {
  string_contains(s: ci_concurrency_group(), pattern: "github.ref == 'refs/heads/main' && github.sha")
}

test fn ci_concurrency_group_still_supersedes_within_a_pull_request() -> Bool {
  string_contains(s: ci_concurrency_group(), pattern: "github.event.pull_request.number")
    && !string_contains(s: ci_concurrency_group(), pattern: "github.run_id")
}

