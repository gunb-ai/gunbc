module test.claim.roadmap_sandbox_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data roadmap_sandbox_witness_note: String = "P4 keystone: /sandbox is the register at every depth plus every component in every state, and it doubles as the visual witness. Gallery totality is the wire vocabulary re-witnessed as coverage (one static instance per wire label; drop one -> RED). The echo answers ANY wire arm on demand with the SAME belt JSON shape production sends (proven per label; unknown label refuses 400). The live instances are one pressable button per arm, all driven by the shared client program. The register depths (roles under both themes, scales) render from the authorities, so the sandbox cannot drift from the live surfaces."

fn sandbox_html() -> String {
  match extdeps.languages.html.try_serialize_html_source(node: gunbc.roadmap_sandbox.sandbox_page()) {
    extdeps.languages.html.EmitOk { html: h } => h
    extdeps.languages.html.EmitRejected { reason: _ } => ""
  }
}

test fn witness_auditioner_blocks_emitted_with_derived_inks() -> Bool {
  let css = sandbox_css()
  all(audition_sets, a => audition_set_resolved(a: a))
    && string_contains(s: css, pattern: ":root[data-swatch-set=\"island-pastel\"]")
    && string_contains(s: css, pattern: ":root[data-swatch-set=\"solarized\"]")
    && all(audition_sets, a => all(audition_paints(a: a), p =>
      match srgb8_contrast_ratio_x100(a: p.ink.color, b: p.fill.color) {
        Present { value: r } => r >= wcag_aa_large_text_and_graphics_hundredths
        Absent => false
      }))
    && map(audition_sets, a => a.set_name) == swatch_audition_values
    && swatch_default_set_value == okabe_ito.name
}

test fn witness_auditioner_missing_swatch_is_loud() -> Bool {
  let bogus = AuditionSet {
    set_name: "bogus",
    set: okabe_ito,
    fills: [ AuditionFillRow { key: "invite", swatch_name: "no-such-swatch" } ],
  }
  !audition_set_resolved(a: bogus)
    && audition_block_css(a: bogus) == ""
}

test fn witness_sandbox_carries_auditioner_control() -> Bool {
  let h = sandbox_html()
  let js = sandbox_client_js_source()
  string_contains(s: h, pattern: "class=\"swatch-toggle\"")
    && string_contains(s: js, pattern: "data-swatch-set")
    && string_contains(s: js, pattern: "'island-pastel'")
}

test fn witness_gallery_covers_every_wire_label() -> Bool {
  let gallery = gunbc.roadmap_sandbox.sandbox_gallery_terminal_labels()
  let wire = gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels()
  gallery.length() == wire.length()
    && all(wire, w => any(gallery, g => g == w))
    && all(gallery, g => any(wire, w => w == g))
}

test fn witness_gallery_drop_is_located_red() -> Bool {
  let dropped = gunbc.design.component.component_drop_state(c: gunbc.roadmap_component.dispatch_button_component(), drop_key: "spawned")
  let labels = map(gunbc.design.component.component_terminal_states(c: dropped), s => gunbc.roadmap_component.dispatch_state_display_text(state: s))
  labels.length() == gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels().length() - 1
    && !any(labels, l => l == "spawned")
}

test fn witness_echo_answers_every_wire_arm() -> Bool {
  all(gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels(), l => {
    let r = gunbc.roadmap_serve.roadmap_serve_respond(method_label: "POST", path: join(["/sandbox/echo?status=", l], ""), body: "", release_revision: test.claim.live_deploy.deploy_release_fixture.deploy_witness_release_revision)
    r.status == 200 && string_contains(s: r.body, pattern: l) && string_contains(s: r.body, pattern: "status")
  })
}

test fn witness_echo_unknown_label_refuses() -> Bool {
  let r = gunbc.roadmap_serve.roadmap_serve_respond(method_label: "POST", path: "/sandbox/echo?status=bogus", body: "", release_revision: test.claim.live_deploy.deploy_release_fixture.deploy_witness_release_revision)
  r.status == 400 && string_contains(s: r.body, pattern: "unknown status")
}

test fn witness_sandbox_renders_register_depths() -> Bool {
  let h = sandbox_html()
  string_contains(s: h, pattern: "roles — night / day")
    && string_contains(s: h, pattern: "scales")
    && string_contains(s: h, pattern: "class=\"swatch\"")
    && string_contains(s: h, pattern: gunbc.design.theme.role_var(r: gunbc.design.theme.CanvasRole))
    && string_contains(s: h, pattern: gunbc.design.material.paint(m: gunbc.design.theme.night_canvas))
    && string_contains(s: h, pattern: "space-8")
}

test fn witness_sandbox_gallery_and_live_render() -> Bool {
  let h = sandbox_html()
  string_contains(s: h, pattern: "dispatch button — every state")
    && string_contains(s: h, pattern: "dispatch-ok")
    && string_contains(s: h, pattern: "dispatch-refused")
    && string_contains(s: h, pattern: "dispatching...")
    && string_contains(s: h, pattern: gunbc.roadmap_component.sandbox_live_class)
    && string_contains(s: h, pattern: "/assets/sandbox.js")
    && all(gunbc.roadmap_belt_actuate.belt_dispatch_all_status_labels(), l => string_contains(s: h, pattern: join(["data-status=\"", l, "\""], "")))
}


data family_fixture_witness_note: String = "The A3 exhibit's discriminating pins, strengthened per review 46754 (the containment-only draft would have survived a duplicated claim, a '13 nodes' count, the neighbour absorbed into the family, or chips reappearing). Three layers: (1) the TYPED band_entries output is pinned by exact list equality — exactly one BandFamily (claim exact, member count exactly 3, member headlines exactly the three subjects in order) followed by exactly one BandRow (the neighbour's full headline) — so claim duplication, count drift, membership drift, and the subject swap are all caught at the structure the renderer consumes; (2) ONE serialized frame carries exact occurrence counts (family-claim/family-count/family-group/family-rows spans each render exactly once, the count span is exactly '>3 nodes<' so a '13 nodes' regression cannot hide inside a containment check, the member's full task headline occurs zero times — the RED control for family_subject_row — and the A3 chip collapse holds: zero 'status status-open' and zero activity markup, routine state earns no ink); (3) the PAGE contains all three width frames verbatim, so the frame-level pins transfer to the page without scanning it. Occurrence counting walks an index over the ~2KB frame (the std.encoding base64_collect_values shape), never the full page."

fn frame_occurrence_count_go(s: String, pattern: String, i: Int, len: Int, plen: Int, acc: Int) -> Int {
  if i + plen > len {
    acc
  } else {
    if substring(s: s, start: i, end: i + plen) == pattern {
      frame_occurrence_count_go(s: s, pattern: pattern, i: i + plen, len: len, plen: plen, acc: acc + 1)
    } else {
      frame_occurrence_count_go(s: s, pattern: pattern, i: i + 1, len: len, plen: plen, acc: acc)
    }
  }
}

fn frame_occurrence_count(s: String, pattern: String) -> Int {
  frame_occurrence_count_go(
    s: s, pattern: pattern,
    i: 0, len: string_length(s: s), plen: string_length(s: pattern),
    acc: 0)
}

fn fixture_band_entry_signature(e: gunbc.roadmap_presentation.WorkBandEntry) -> String {
  match e {
    gunbc.roadmap_presentation.BandFamily { family } => join([
      "family|", family.claim,
      "|", to_string(count(family.rows)),
      "|", join(map(family.rows, r => r.headline), ","),
    ], "")
    gunbc.roadmap_presentation.BandRow { row } => join(["row|", row.headline], "")
  }
}

test fn witness_family_fixture_typed_structure_exact() -> Bool {
  let entries = gunbc.roadmap_presentation.band_entries(
    rows: gunbc.roadmap_sandbox.fixture_family_rows(),
    families: [gunbc.roadmap_sandbox.fixture_family_decl()],
    members: gunbc.roadmap_sandbox.fixture_family_members(),
  )
  map(entries, e => fixture_band_entry_signature(e: e)) == [
    "family|Every startable node carries a closing contract|3|dag_compile_clean_gate,affected_set_falsifier,regen_floor_skip_witness",
    "row|Record which generator actually produced each result",
  ]
}

fn family_frame_html(label: String, cls: String) -> String {
  match extdeps.languages.html.try_serialize_html_source(node: gunbc.roadmap_sandbox.family_fixture_frame(label: label, cls: cls)) {
    extdeps.languages.html.EmitOk { html: h } => h
    extdeps.languages.html.EmitRejected { reason: _ } => ""
  }
}

test fn witness_family_fixture_frame_occurrences_exact() -> Bool {
  let h = family_frame_html(label: "wide · 1680", cls: "fixture-wide")
  h != ""
    && frame_occurrence_count(s: h, pattern: "class=\"family-group\"") == 1
    && frame_occurrence_count(s: h, pattern: "class=\"family-claim\"") == 1
    && frame_occurrence_count(s: h, pattern: "Every startable node carries a closing contract") == 1
    && frame_occurrence_count(s: h, pattern: "class=\"family-count\"") == 1
    && frame_occurrence_count(s: h, pattern: ">3 nodes<") == 1
    && frame_occurrence_count(s: h, pattern: "class=\"family-rows\"") == 1
    && frame_occurrence_count(s: h, pattern: "Record which generator actually produced each result") == 1
    && frame_occurrence_count(s: h, pattern: "Declare the closing contract for dag_compile_clean_gate") == 0
    && frame_occurrence_count(s: h, pattern: "status status-open") == 0
    && frame_occurrence_count(s: h, pattern: "class=\"activity") == 0
}

test fn witness_family_fixture_page_carries_all_three_frames() -> Bool {
  let page = sandbox_html()
  string_contains(s: page, pattern: "family grouping — claim stated once, members carry subjects (static)")
    && string_contains(s: page, pattern: family_frame_html(label: "wide · 1680", cls: "fixture-wide"))
    && string_contains(s: page, pattern: family_frame_html(label: "medium · 1024", cls: "fixture-medium"))
    && string_contains(s: page, pattern: family_frame_html(label: "narrow · 480", cls: "fixture-narrow"))
}
