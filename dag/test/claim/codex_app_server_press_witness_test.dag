test fn account_trip_typed_session_classifies_login_quota_ok_incomplete() -> Bool {
  let login = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":null,\"requiresOpenaiAuth\":true}}\n",
    ),
  )
  let quota = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":\"rate_limit_reached\",\"message\":\"rate_limit_reached\"}}\n",
      ),
    ),
  )
  let quota_message_only = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"message\":\"rate_limit_reached\"}}\n",
      ),
    ),
  )
  let ok = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        fixture_rate_limits_capacity_available_line,
      ),
    ),
  )
  let empty_limits = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        fixture_rate_limits_empty_object_line,
      ),
    ),
  )
  let missing = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"message\":\"boom\"}}\n",
  )
  let incomplete = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{}}}\n",
    ),
  )
  let duplicate = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        concat(
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
          fixture_rate_limits_capacity_available_line,
        ),
      ),
    ),
  )
  let login_ok = match login.classification {
    gunbc.codex_app_server_press.AccountStandingLoginRequired => true
    _ => false
  }
  let quota_ok = match quota.classification {
    gunbc.codex_app_server_press.AccountStandingQuotaReached => true
    _ => false
  }
  let quota_message_only_incomplete = match quota_message_only.classification {
    gunbc.codex_app_server_press.AccountStandingIncomplete => true
    _ => false
  }
  let ready_ok = match ok.classification {
    gunbc.codex_app_server_press.AccountStandingAuthenticatedRateLimitsReadable => true
    _ => false
  }
  let empty_limits_incomplete = match empty_limits.classification {
    gunbc.codex_app_server_press.AccountStandingIncomplete => true
    _ => false
  }
  let missing_ok = match missing.classification {
    gunbc.codex_app_server_press.AccountStandingInitializeMissing => true
    _ => false
  }
  let incomplete_ok = match incomplete.classification {
    gunbc.codex_app_server_press.AccountStandingIncomplete => true
    _ => false
  }
  let duplicate_ok = match duplicate.classification {
    gunbc.codex_app_server_press.AccountStandingIncomplete => true
    _ => false
  }
  let projected = gunbc.codex_app_server_press.account_standing_projection(classification: ok.classification)
  let projection_ok = projected == "initialize_ok; account_read_ok; rate_limits_observed"
  login_ok && quota_ok && quota_message_only_incomplete && ready_ok && empty_limits_incomplete && missing_ok && incomplete_ok && duplicate_ok && projection_ok
}

test fn quota_refusal_caption_is_quota_exhausted_not_accepted() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":\"rate_limit_reached\",\"message\":\"rate_limit_reached\"}}\n",
      ),
    ),
  )
  match fixture_preflight_subject() {
    Absent => false
    Present { value: subject } =>
      let outcome = gunbc.codex_app_server_press.CodexPressRefused {
        reason: "codex quota exhausted at account/rateLimits/read" as std.types.NonEmptyStr,
        receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt {
          subject: subject,
          standing: gunbc.codex_app_server_press.account_standing_summary_from_evidence(evidence: evidence),
          wire_evidence: none,
          process: fixture_process_receipt(),
        },
      }
      gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) == "press_refused"
        && gunbc.codex_app_server_press.codex_press_outcome_operator_caption(outcome: outcome) == "codex quota exhausted"
        && gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) != "accepted"
        && gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) != "turn_started"
  }
}

data rate_limit_id_witness_note: String = "Discriminating controls for the limitId absorbing-fallback repair (review 50532). The fabrication these pin is NOT cosmetic: buckets are read downstream BY limit_id, so a malformed id emitted under the synthesized default would put a sibling bucket's numbers on the codex bucket. The sibling-only control is the one that fails loudest against the old code — it carries a REAL id (codex_bengalfox), so a reader that defaults on anything other than absence reports it as codex. The absence control is the positive: the legacy mirror legitimately has no limitId and must still yield codex, so this pair proves the split rather than a blanket refusal."

fn rate_limit_bucket_ids_for_stdout(line: String) -> List<String> {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(fixture_account_read_chatgpt_requires_auth_true_line, line),
    ),
  )
  map(
    evidence.rate_limit_buckets,
    bucket =>
      match bucket {
        gunbc.codex_app_server_press.CodexBucketCapacityAvailable { limit_id: id } => id as String
        gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset { limit_id: id, reached_type: _, resets_at: _ } => id as String
        gunbc.codex_app_server_press.CodexBucketCapacityUnknown { limit_id: id } => id as String
      },
  )
}

test fn absent_limit_id_still_defaults_to_codex_legacy_mirror() -> Bool {
  rate_limit_bucket_ids_for_stdout(line: fixture_rate_limits_empty_object_line) == ["codex"]
}

test fn real_sibling_limit_id_is_never_reported_as_codex() -> Bool {
  let ids = rate_limit_bucket_ids_for_stdout(line: fixture_rate_limits_sibling_bucket_only_line)
  ids == ["codex_bengalfox"]
}

test fn empty_limit_id_emits_no_bucket_rather_than_a_fabricated_one() -> Bool {
  rate_limit_bucket_ids_for_stdout(line: fixture_rate_limits_empty_limit_id_line) == []
}

test fn nonstring_limit_id_emits_no_bucket_rather_than_a_fabricated_one() -> Bool {
  rate_limit_bucket_ids_for_stdout(line: fixture_rate_limits_nonstring_limit_id_line) == []
}

test fn negative_resets_at_refuses_epoch_secs_mint() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        fixture_account_read_chatgpt_requires_auth_true_line,
        fixture_rate_limits_negative_resets_at_line,
      ),
    ),
  )
  match evidence.classification {
    gunbc.codex_app_server_press.AccountStandingQuotaReached =>
      fold(
        evidence.rate_limit_buckets,
        init: false,
        f: (acc, bucket) =>
          match bucket {
            gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset { limit_id: id, reached_type: _, resets_at: resets } =>
              if (id as String) == "codex" {
                match resets {
                  Absent => true
                  Present { value: _ } => false
                }
              } else {
                acc
              }
            _ => acc
          },
      )
    _ => false
  }
}

test fn live_exhausted_multibucket_is_quota_on_codex_with_bengalfox_available() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        fixture_account_read_chatgpt_requires_auth_true_line,
        fixture_rate_limits_live_exhausted_multibucket_line,
      ),
    ),
  )
  let quota_ok = match evidence.classification {
    gunbc.codex_app_server_press.AccountStandingQuotaReached => true
    _ => false
  }
  let bucket_count_ok = count(evidence.rate_limit_buckets) == 2
  let codex_exhausted = fold(
    evidence.rate_limit_buckets,
    init: false,
    f: (acc, bucket) =>
      match bucket {
        gunbc.codex_app_server_press.CodexBucketUnavailableUntilReset { limit_id: id, reached_type: _, resets_at: _ } =>
          acc || (id as String) == "codex"
        _ => acc
      },
  )
  let bengalfox_available = fold(
    evidence.rate_limit_buckets,
    init: false,
    f: (acc, bucket) =>
      match bucket {
        gunbc.codex_app_server_press.CodexBucketCapacityAvailable { limit_id: id } =>
          acc || (id as String) == "codex_bengalfox"
        _ => acc
      },
  )
  quota_ok && bucket_count_ok && codex_exhausted && bengalfox_available
    && (fixture_live_exhausted_multibucket_path as String).contains("provider_terminal")
}

test fn missing_rate_limits_response_after_auth_is_incomplete_handshake_class() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      fixture_account_read_chatgpt_requires_auth_true_line,
    ),
  )
  match evidence.classification {
    gunbc.codex_app_server_press.AccountStandingIncomplete => count(evidence.rate_limit_buckets) == 0
    _ => false
  }
}

test fn login_required_wire_status_is_not_accepted_or_turn_started() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"requiresOpenaiAuth\":true}}\n",
    ),
  )
  match fixture_preflight_subject() {
    Absent => false
    Present { value: subject } =>
      let outcome = gunbc.codex_app_server_press.CodexPressLoginRequired {
        reason: "codex app-server account trip requires login" as std.types.NonEmptyStr,
        receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt {
          subject: subject,
          standing: gunbc.codex_app_server_press.account_standing_summary_from_evidence(evidence: evidence),
          wire_evidence: none,
          process: fixture_process_receipt(),
        },
      }
      gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) == "login_required"
        && gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) != "accepted"
        && gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome) != "turn_started"
        && gunbc.codex_app_server_press.codex_press_outcome_operator_caption(outcome: outcome) == "login required"
  }
}

test fn unknown_frame_is_digested_not_silent() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"method\":\"notification\",\"params\":{}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
        concat(
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
          fixture_rate_limits_capacity_available_line,
        ),
      ),
    ),
  )
  match evidence.classification {
    gunbc.codex_app_server_press.AccountStandingAuthenticatedRateLimitsReadable => count(evidence.unknown_frame_digests) == 1
    _ => false
  }
}
