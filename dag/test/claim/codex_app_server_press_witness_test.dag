module test.claim.codex_app_server_press_witness_test


data witness_note: String = "Hermetic press carriers: account-trip itinerary (3) vs turn-target itinerary (5) + projected stdio binding + preflight subject + terminal/cause adjudication RED. AccountReady gates on native limit_id codex bucket capacity (usedPercent below 100), never an empty rateLimits object, never sibling-bucket availability alone, and never turn_started. Live multi-bucket exhausted specimen enrolled under dag/test/fixture/provider_terminal/. Live JSON-RPC turn execution remains open."

data fixture_rate_limits_capacity_available_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":12},\"secondary\":{\"usedPercent\":3},\"spendControlReached\":false}}}\n"

data fixture_rate_limits_empty_object_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{}}}\n"

data fixture_rate_limits_empty_limit_id_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"\",\"primary\":{\"usedPercent\":12}}}}\n"

data fixture_rate_limits_nonstring_limit_id_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":7,\"primary\":{\"usedPercent\":12}}}}\n"

data fixture_rate_limits_sibling_bucket_only_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex_bengalfox\",\"primary\":{\"usedPercent\":12}}}}\n"

data fixture_rate_limits_primary_saturated_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":100,\"resetsAt\":1893456000},\"rateLimitReachedType\":\"rate_limit_reached\"}}}\n"

data fixture_rate_limits_negative_resets_at_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"primary\":{\"usedPercent\":100,\"resetsAt\":-1},\"rateLimitReachedType\":\"rate_limit_reached\"}}}\n"

data fixture_rate_limits_spend_control_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"spendControlReached\":true}}}\n"

data fixture_rate_limits_live_exhausted_multibucket_line: String = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{\"limitId\":\"codex\",\"limitName\":null,\"primary\":{\"usedPercent\":100,\"windowDurationMins\":10080,\"resetsAt\":1786159940},\"secondary\":null,\"credits\":{\"hasCredits\":false,\"unlimited\":false,\"balance\":\"0\"},\"individualLimit\":null,\"spendControlReached\":false,\"planType\":\"pro\",\"rateLimitReachedType\":\"rate_limit_reached\"},\"rateLimitsByLimitId\":{\"codex\":{\"limitId\":\"codex\",\"limitName\":null,\"primary\":{\"usedPercent\":100,\"windowDurationMins\":10080,\"resetsAt\":1786159940},\"secondary\":null,\"credits\":{\"hasCredits\":false,\"unlimited\":false,\"balance\":\"0\"},\"individualLimit\":null,\"spendControlReached\":false,\"planType\":\"pro\",\"rateLimitReachedType\":\"rate_limit_reached\"},\"codex_bengalfox\":{\"limitId\":\"codex_bengalfox\",\"limitName\":\"GPT-5.3-Codex-Spark\",\"primary\":{\"usedPercent\":0,\"windowDurationMins\":10080,\"resetsAt\":1786656789},\"secondary\":null,\"credits\":null,\"individualLimit\":null,\"spendControlReached\":null,\"planType\":null,\"rateLimitReachedType\":null}},\"rateLimitResetCredits\":{\"availableCount\":0,\"credits\":[]}}}\n"

data fixture_account_read_chatgpt_requires_auth_true_line: String = "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\",\"planType\":\"pro\",\"email\":\"REDACTED@example.invalid\"},\"requiresOpenaiAuth\":true}}\n"

data fixture_live_exhausted_multibucket_path: String = "dag/test/fixture/provider_terminal/codex_account_rate_limits_exhausted_multibucket_2026-08-06.jsonl"

data fixture_digest_hex: String = "c86dec3d635d6bfd980084080eaf4caeb8e8093210eebc5833921ab2b1b754172e8422d39207a0fc9cea989ab557df11138309e630b10d75d094e8eb762b4547"


fn fixture_digest() -> std.content_hash.Sha512Digest? {
  std.content_hash.sha512_hex_digest(hex: fixture_digest_hex)
}

fn fixture_bundle_from_digest(digest: std.content_hash.Sha512Digest) -> gunbc.package_delivery.CodexRuntimeBundle {
  let id = std.content_hash.as_content_hash_sha512(digest: digest)
  let target = gunbc.package_delivery.CodexNpmRuntimeTarget {
    os: "linux" as std.types.NonEmptyStr,
    cpu: "arm64" as std.types.NonEmptyStr,
  }
  let tree = gunbc.package_delivery.PackageMaterializedTreeReceipt {
    entries: [],
    tree_identity: id,
  }
  gunbc.package_delivery.CodexRuntimeBundle {
    root: "/tmp/codex-runtime-fixture" as std.types.FilePath,
    native_executable_rel: "node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex" as std.types.NonEmptyStr,
    wrapper_executable_rel: "node_modules/@openai/codex/bin/codex.js" as std.types.NonEmptyStr,
    platform_package_rel: "node_modules/@openai/codex-linux-arm64" as std.types.NonEmptyStr,
    target: target,
    admitted_packages: [],
    admitted_package_set_identity: id,
    receipt: gunbc.package_delivery.CodexRuntimeBundleReceipt {
      manifest_digest: digest,
      lock_digest: digest,
      target: target,
      admitted_packages: [],
      admitted_package_set_identity: id,
      materialized_tree: tree,
      native_executable_digest: digest,
      toolchain: gunbc.package_delivery.CodexBuildToolchainReceipt {
        npm_cli_version: "10.9.8" as std.types.NonEmptyStr,
        node_version: "v22.0.0" as std.types.NonEmptyStr,
      },
      protocol_schema_identity: id,
      receipt_identity: id,
    },
  }
}

fn fixture_process_receipt() -> gunbc.codex_app_server_press.ProviderProcessReceipt {
  gunbc.codex_app_server_press.ProviderProcessReceipt {
    exit: gunbc.codex_app_server_press.ProviderProcessObservationFailed,
    wire: none,
  }
}

fn fixture_preflight_subject() -> gunbc.codex_app_server_press.CodexAccountPreflightSubject? {
  match fixture_digest() {
    Absent => none
    Present { value: digest } =>
      match gunbc.provider_interface_binding.project_codex_app_server_stdio_binding(
        bundle: fixture_bundle_from_digest(digest: digest),
      ) {
        gunbc.provider_interface_binding.ProviderInterfaceResolved { binding } =>
          Present {
            value: gunbc.codex_app_server_press.preflight_subject_from_bundle(
              bundle: fixture_bundle_from_digest(digest: digest),
              binding: binding,
              probe_key: "probe-fixture-1" as gunbc.codex_app_server_press.ProviderProbeKey,
              codex_home: "/tmp/gunbc-codex-home-fixture" as std.types.FilePath,
            ),
          }
        _ => none
      }
  }
}

test fn press_turn_target_itinerary_is_five_steps_starting_with_initialize() -> Bool {
  let steps = gunbc.codex_app_server_press.codex_press_method_itinerary()
  match steps.first() {
    Present { value: step } =>
      match step {
        extdeps.llm.codex_app_server.CodexAppServerInitialize => count(steps) == 5
        _ => false
      }
    Absent => false
  }
}

test fn press_account_trip_itinerary_is_three_steps_without_turn_start() -> Bool {
  let steps = gunbc.codex_app_server_press.codex_press_account_trip_methods()
  count(steps) == 3
    && match steps.last() {
      Present { value: last } =>
        match last {
          extdeps.llm.codex_app_server.CodexAppServerAccountRateLimitsRead => true
          extdeps.llm.codex_app_server.CodexAppServerTurnStart => false
          _ => false
        }
      Absent => false
    }
}

test fn press_itinerary_wire_names_match_generated_schema() -> Bool {
  let steps = gunbc.codex_app_server_press.codex_press_method_itinerary()
  count(steps) == 5
    && (extdeps.llm.codex_app_server.codex_app_server_method_wire_name(method: extdeps.llm.codex_app_server.CodexAppServerInitialize) as String) == "initialize"
    && (extdeps.llm.codex_app_server.codex_app_server_method_wire_name(method: extdeps.llm.codex_app_server.CodexAppServerTurnStart) as String) == "turn/start"
    && match steps.last() {
      Present { value: last } =>
        match last {
          extdeps.llm.codex_app_server.CodexAppServerTurnStart =>
            (extdeps.llm.codex_app_server.codex_app_server_method_wire_name(method: last) as String) == "turn/start"
          _ => false
        }
      Absent => false
    }
}

test fn stdio_binding_derives_from_runtime_bundle() -> Bool {
  match fixture_digest() {
    Absent => false
    Present { value: digest } =>
      match gunbc.provider_interface_binding.project_codex_app_server_stdio_binding(
        bundle: fixture_bundle_from_digest(digest: digest),
      ) {
        gunbc.provider_interface_binding.ProviderInterfaceResolved { binding } =>
          match binding.interface {
            CodexAppServer {} =>
              match binding.transport {
                extdeps.llm.codex_app_server.CodexAppServerStdio =>
                  (binding.executable.path as String) == "/tmp/codex-runtime-fixture/node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex"
                _ => false
              }
          }
        _ => false
      }
  }
}

test fn preflight_subject_carries_runtime_receipt_and_probe_key() -> Bool {
  match fixture_preflight_subject() {
    Absent => false
    Present { value: subject } =>
      (subject.probe_key as String) == "probe-fixture-1"
        && (subject.credential.codex_home as String) == "/tmp/gunbc-codex-home-fixture"
        && match subject.runtime {
          gunbc.codex_app_server_press.CodexRuntimeBundleReceiptRef { receipt_identity: id } =>
            match fixture_digest() {
              Absent => false
              Present { value: digest } =>
                (id as String) == (std.content_hash.as_content_hash_sha512(digest: digest) as String)
            }
        }
        && count(gunbc.codex_app_server_press.codex_press_account_trip_methods()) == 3
  }
}

test fn preflight_subject_without_turn_never_displays_as_running_or_finished() -> Bool {
  match fixture_preflight_subject() {
    Absent => false
    Present { value: _ } =>
      gunbc.provider_turn_adjudication.press_display_running(disposition: gunbc.provider_turn_adjudication.ProviderTurnNotObserved) == false
        && gunbc.provider_turn_adjudication.press_display_finished(disposition: gunbc.provider_turn_adjudication.ProviderTurnNotObserved) == false
        && gunbc.provider_turn_adjudication.automatic_recovery_authorized(disposition: gunbc.provider_turn_adjudication.ProviderTurnNotObserved) == false
  }
}

test fn failed_unclassified_cannot_authorize_recovery() -> Bool {
  let unknown = gunbc.provider_turn_adjudication.ProviderTurnFailed {
    cause: gunbc.provider_turn_adjudication.ProviderNativeCauseUnknown {
      evidence: "malformed app-server line retained as evidence" as std.types.NonEmptyStr,
    },
  }
  let classified_retryable = gunbc.provider_turn_adjudication.ProviderTurnFailed {
    cause: gunbc.provider_turn_adjudication.ProviderNativeCauseClassified {
      class: gunbc.provider_turn_adjudication.RetryableTransient,
      evidence: "provider-native retryable class with retained evidence" as std.types.NonEmptyStr,
    },
  }
  gunbc.provider_turn_adjudication.automatic_recovery_authorized(disposition: unknown) == false
    && gunbc.provider_turn_adjudication.automatic_recovery_authorized(disposition: classified_retryable) == false
}

test fn account_ready_wire_status_is_not_turn_started_or_dispatch_accepted() -> Bool {
  let evidence = gunbc.codex_app_server_press.parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        fixture_rate_limits_capacity_available_line,
      ),
    ),
  )
  let standing = gunbc.codex_app_server_press.account_standing_summary_from_evidence(evidence: evidence)
  match fixture_preflight_subject() {
    Absent => false
    Present { value: subject } =>
      let outcome = gunbc.codex_app_server_press.CodexPressAccountReady {
        receipt: gunbc.codex_app_server_press.CodexAccountStandingReceipt {
          subject: subject,
          standing: standing,
          wire_evidence: none,
          process: fixture_process_receipt(),
        },
      }
      let status = gunbc.codex_app_server_press.codex_press_outcome_wire_status(outcome: outcome)
      let caption = gunbc.codex_app_server_press.codex_press_outcome_operator_caption(outcome: outcome)
      let ready_ok = status == "account_authenticated_rate_limits_readable"
        && status != "turn_started"
        && status != "accepted"
        && status != "spawned"
        && caption == "authenticated; codex capacity available"
        && caption != "turn started"
      match evidence.classification {
        gunbc.codex_app_server_press.AccountStandingAuthenticatedRateLimitsReadable => ready_ok
        _ => false
      }
  }
}

