module test.claim.codex_app_server_press_witness_test

import std.types { Bool, String, NonEmptyStr, FilePath }
import std.content_hash {
  content_hash_of_value,
  sha512_hex_digest,
  Sha512Digest,
  as_content_hash_sha512,
}
import gunbc.package_delivery {
  CodexRuntimeBundle,
  CodexNpmRuntimeTarget,
  CodexRuntimeBundleReceipt,
  PackageMaterializedTreeReceipt,
  CodexBuildToolchainReceipt,
}
import gunbc.provider_interface_binding {
  project_codex_app_server_stdio_binding,
  ProviderInterfaceResolved,
  ProviderControlInterface,
}
import gunbc.codex_app_server_press {
  admit_codex_press_start_projected,
  CodexPressStartAdmitted,
  codex_press_method_itinerary,
  codex_press_account_trip_methods,
  codex_press_specimen_node_identity,
  codex_press_outcome_wire_status,
  codex_press_outcome_operator_caption,
  parse_account_trip_stdout_for_tests,
  account_standing_projection,
  account_standing_summary_from_evidence,
  CodexPressAccountReady,
  CodexPressLoginRequired,
  CodexPressRefused,
  CodexAccountStandingReceipt,
  AccountStandingReady,
  AccountStandingLoginRequired,
  AccountStandingQuotaReached,
  AccountStandingInitializeMissing,
  AccountStandingIncomplete,
}
import gunbc.provider_turn_adjudication {
  automatic_recovery_authorized,
  press_display_finished,
  press_display_running,
  ProviderTurnNotObserved,
  ProviderTurnFailed,
  ProviderNativeCauseUnknown,
  ProviderNativeCauseClassified,
  RetryableTransient,
}
import extdeps.llm.codex_app_server {
  CodexAppServerStdio,
  CodexAppServerInitialize,
  CodexAppServerTurnStart,
  CodexAppServerAccountRateLimitsRead,
  codex_app_server_method_wire_name,
}

data witness_note: String = "Hermetic press carriers: account-trip itinerary (3) vs turn-target itinerary (5) + projected stdio binding + AttemptKey Start + terminal/cause adjudication RED. AccountReady is standing only — never turn_started. Live JSON-RPC turn execution remains open."

data fixture_digest_hex: String = "c86dec3d635d6bfd980084080eaf4caeb8e8093210eebc5833921ab2b1b754172e8422d39207a0fc9cea989ab557df11138309e630b10d75d094e8eb762b4547"

fn fixture_digest() -> Sha512Digest? {
  sha512_hex_digest(hex: fixture_digest_hex)
}

fn fixture_bundle_from_digest(digest: Sha512Digest) -> CodexRuntimeBundle {
  let id = as_content_hash_sha512(digest: digest)
  let target = CodexNpmRuntimeTarget {
    os: "linux" as NonEmptyStr,
    cpu: "arm64" as NonEmptyStr,
  }
  let tree = PackageMaterializedTreeReceipt {
    entries: [],
    tree_identity: id,
  }
  CodexRuntimeBundle {
    root: "/tmp/codex-runtime-fixture" as FilePath,
    native_executable_rel: "node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex" as NonEmptyStr,
    wrapper_executable_rel: "node_modules/@openai/codex/bin/codex.js" as NonEmptyStr,
    platform_package_rel: "node_modules/@openai/codex-linux-arm64" as NonEmptyStr,
    target: target,
    admitted_packages: [],
    admitted_package_set_identity: id,
    receipt: CodexRuntimeBundleReceipt {
      manifest_digest: digest,
      lock_digest: digest,
      target: target,
      admitted_packages: [],
      admitted_package_set_identity: id,
      materialized_tree: tree,
      native_executable_digest: digest,
      toolchain: CodexBuildToolchainReceipt {
        npm_cli_version: "10.9.8" as NonEmptyStr,
        node_version: "v22.0.0" as NonEmptyStr,
      },
      protocol_schema_identity: id,
      receipt_identity: id,
    },
  }
}

test fn press_turn_target_itinerary_is_five_steps_starting_with_initialize() -> Bool {
  let steps = codex_press_method_itinerary()
  match steps.first() {
    Present { value: step } =>
      match step {
        CodexAppServerInitialize => count(steps) == 5
        _ => false
      }
    Absent => false
  }
}

test fn press_account_trip_itinerary_is_three_steps_without_turn_start() -> Bool {
  let steps = codex_press_account_trip_methods()
  count(steps) == 3
    && match steps.last() {
      Present { value: last } =>
        match last {
          CodexAppServerAccountRateLimitsRead => true
          CodexAppServerTurnStart => false
          _ => false
        }
      Absent => false
    }
}

test fn press_itinerary_wire_names_match_generated_schema() -> Bool {
  let steps = codex_press_method_itinerary()
  count(steps) == 5
    && (codex_app_server_method_wire_name(method: CodexAppServerInitialize) as String) == "initialize"
    && (codex_app_server_method_wire_name(method: CodexAppServerTurnStart) as String) == "turn/start"
    && match steps.last() {
      Present { value: last } =>
        match last {
          CodexAppServerTurnStart =>
            (codex_app_server_method_wire_name(method: last) as String) == "turn/start"
          _ => false
        }
      Absent => false
    }
}

test fn stdio_binding_derives_from_runtime_bundle() -> Bool {
  match fixture_digest() {
    Absent => false
    Present { value: digest } =>
      match project_codex_app_server_stdio_binding(
        bundle: fixture_bundle_from_digest(digest: digest),
      ) {
        ProviderInterfaceResolved { binding } =>
          match binding.interface {
            CodexAppServer {} =>
              match binding.transport {
                CodexAppServerStdio =>
                  (binding.executable.path as String) == "/tmp/codex-runtime-fixture/node_modules/@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/bin/codex"
                _ => false
              }
          }
        _ => false
      }
  }
}

test fn press_start_admits_account_trip_not_turn_itinerary() -> Bool {
  match fixture_digest() {
    Absent => false
    Present { value: digest } =>
      match admit_codex_press_start_projected(
        node_identity: codex_press_specimen_node_identity,
        attempt_key: "attempt-fixture-1",
        turn_key: "turn-fixture-1",
        bundle: fixture_bundle_from_digest(digest: digest),
        workspace_root: "/tmp/ws" as FilePath,
        head_sha: "deadbeef",
      ) {
        CodexPressStartAdmitted { start, itinerary } =>
          (start.attempt_key as String) == "attempt-fixture-1"
            && (start.node_identity as String) == "codex-app-server-press-vertical"
            && count(itinerary) == 3
        _ => false
      }
  }
}

test fn accepted_start_without_turn_never_displays_as_running_or_finished() -> Bool {
  match fixture_digest() {
    Absent => false
    Present { value: digest } =>
      match admit_codex_press_start_projected(
        node_identity: codex_press_specimen_node_identity,
        attempt_key: "attempt-fixture-2",
        turn_key: "turn-fixture-2",
        bundle: fixture_bundle_from_digest(digest: digest),
        workspace_root: "/tmp/ws" as FilePath,
        head_sha: "deadbeef",
      ) {
        CodexPressStartAdmitted { start: _, itinerary: _ } =>
          press_display_running(disposition: ProviderTurnNotObserved) == false
            && press_display_finished(disposition: ProviderTurnNotObserved) == false
            && automatic_recovery_authorized(disposition: ProviderTurnNotObserved) == false
        _ => false
      }
  }
}

test fn failed_unclassified_cannot_authorize_recovery() -> Bool {
  let unknown = ProviderTurnFailed {
    cause: ProviderNativeCauseUnknown {
      evidence: "malformed app-server line retained as evidence" as NonEmptyStr,
    },
  }
  let classified_retryable = ProviderTurnFailed {
    cause: ProviderNativeCauseClassified {
      class: RetryableTransient,
      evidence: "provider-native retryable class with retained evidence" as NonEmptyStr,
    },
  }
  automatic_recovery_authorized(disposition: unknown) == false
    && automatic_recovery_authorized(disposition: classified_retryable) == false
}

test fn account_ready_wire_status_is_not_turn_started_or_dispatch_accepted() -> Bool {
  let evidence = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{}}}\n",
      ),
    ),
  )
  let standing = account_standing_summary_from_evidence(evidence: evidence)
  let outcome = CodexPressAccountReady {
    receipt: CodexAccountStandingReceipt {
      node_identity: codex_press_specimen_node_identity,
      attempt_key: "a",
      standing: standing,
    },
  }
  let status = codex_press_outcome_wire_status(outcome: outcome)
  let caption = codex_press_outcome_operator_caption(outcome: outcome)
  match evidence.classification {
    AccountStandingReady =>
      status == "account_ready"
        && status != "turn_started"
        && status != "accepted"
        && status != "spawned"
        && caption == "account ready"
        && caption != "turn started"
    _ => false
  }
}

test fn account_trip_typed_session_classifies_login_quota_ok_incomplete() -> Bool {
  let login = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":null,\"requiresOpenaiAuth\":true}}\n",
    ),
  )
  let quota = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"message\":\"rate_limit_reached\"}}\n",
      ),
    ),
  )
  let ok = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{\"type\":\"chatgpt\"}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{}}}\n",
      ),
    ),
  )
  let missing = parse_account_trip_stdout_for_tests(
    stdout: "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"message\":\"boom\"}}\n",
  )
  let incomplete = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{}}}\n",
    ),
  )
  match login.classification {
    AccountStandingLoginRequired =>
      match quota.classification {
        AccountStandingQuotaReached =>
          match ok.classification {
            AccountStandingReady =>
              match missing.classification {
                AccountStandingInitializeMissing =>
                  match incomplete.classification {
                    AccountStandingIncomplete =>
                      account_standing_projection(classification: ok.classification)
                        == "initialize_ok; account_read_ok; rate_limits_observed"
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn quota_refusal_caption_is_quota_exhausted_not_accepted() -> Bool {
  let evidence = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{}}}\n",
        "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"message\":\"rate_limit_reached\"}}\n",
      ),
    ),
  )
  let outcome = CodexPressRefused {
    reason: "codex quota exhausted at account/rateLimits/read" as NonEmptyStr,
    standing: account_standing_summary_from_evidence(evidence: evidence),
  }
  codex_press_outcome_wire_status(outcome: outcome) == "press_refused"
    && codex_press_outcome_operator_caption(outcome: outcome) == "quota exhausted"
    && codex_press_outcome_wire_status(outcome: outcome) != "accepted"
    && codex_press_outcome_wire_status(outcome: outcome) != "turn_started"
}

test fn login_required_wire_status_is_not_accepted_or_turn_started() -> Bool {
  let evidence = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"requiresOpenaiAuth\":true}}\n",
    ),
  )
  let outcome = CodexPressLoginRequired {
    reason: "codex app-server account trip requires login" as NonEmptyStr,
    standing: account_standing_summary_from_evidence(evidence: evidence),
  }
  codex_press_outcome_wire_status(outcome: outcome) == "login_required"
    && codex_press_outcome_wire_status(outcome: outcome) != "accepted"
    && codex_press_outcome_wire_status(outcome: outcome) != "turn_started"
    && codex_press_outcome_operator_caption(outcome: outcome) == "login required"
}

test fn unknown_frame_is_digested_not_silent() -> Bool {
  let evidence = parse_account_trip_stdout_for_tests(
    stdout: concat(
      "{\"jsonrpc\":\"2.0\",\"method\":\"notification\",\"params\":{}}\n",
      concat(
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"userAgent\":\"x\"}}\n",
        concat(
          "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"account\":{}}}\n",
          "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"rateLimits\":{}}}\n",
        ),
      ),
    ),
  )
  match evidence.classification {
    AccountStandingReady => count(evidence.unknown_frame_digests) == 1
    _ => false
  }
}
