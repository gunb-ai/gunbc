module test.claim.arity_zero_import_refusal_witness

import std.types { String, Int, Bool }
import std.process { ProcessExit }
import gunbc.compile_census_probe { blocking_class_census, census_verdict, census_exit }

// AN IMPORT WHOSE MEMBER LIST HAS ARITY ZERO REFUSES AT PARSE, AND THE SAME IMPORT WITH ONE
// MEMBER IS ACCEPTED.
//
// WHY THIS FILE EXISTS, and the reason is a defect in the PR that installed the wall rather than
// a defect in the wall. The refusal was proven by execution against a throwaway fixture written
// outside the tree and deleted afterwards, and the corpus's one live specimen -- an
// `import std.realization_schedule { }` in gunbc.floor_component_receipt (that module itself was
// later deleted, 2026-09-01, as unreachable residue of the 2026-08-15 CI cut) -- was deleted in the
// same diff, because a wall is not installable over a corpus that violates it. Those two facts
// together removed the only authored instance of the state the wall refuses. THE WALL EXECUTED
// AND NOTHING WENT RED IF IT WERE DELETED: a live corpus specimen had been doing double duty as
// the discriminating red without anyone electing it, and the deletion that made the wall
// shippable converted "one red exists" into "no red exists" in one motion. No check sees that --
// three green lanes and an on-head approval all passed over it.
//
// THIS IS THE SPECIFICATION-WITHOUT-EXECUTION CASE, NOT THE DECORATION CASE, and the distinction
// decides whether declining the red is a saving. DESIGN section 4b judges reachability against
// what a FIXTURE MAY AUTHOR, never against what the accepted corpus contains. `import M { }` is a
// SINGLE-MODULE source string, so it needs no multi-module harness -- which is the one thing this
// boundary genuinely cannot express, and the reason other classes stop here. The red can flip; it
// simply was not enrolled.
//
// WHAT THE PAIR DISCRIMINATES. Both sources are compiled through the real acceptance path and
// differ in EXACTLY the fact the wall decides -- whether the member list is empty. Asserting
// `ParseError >= 1` alone would be satisfied by any malformed source, so the red carries no
// information without the control: the control is what says the refusal is ABOUT ARITY and not
// about the source being unparseable for some unrelated reason.
//
// The positive control at corpus scale is free and is not restated here: the rest of the tree
// still parses, which is what the floor's parse phase measures on every run.
//
// PROVEN DISCRIMINATING BY MUTATION, NOT ASSERTED. The eleven-line refusal was removed from the
// EXECUTING binary -- the emitted mirror, rebuilt -- and re-measured:
//
//   wall present : red TRUE   control TRUE
//   wall removed : red FALSE  control TRUE
//   wall restored: red TRUE   control TRUE
//
// So this red is a function of the wall and of nothing else in the harness, and the control is
// insensitive to it in the same run. Asserting that a red "would flip" without flipping it is
// the specification-without-execution failure applied to the evidence rather than to the code.

// NOT-RUNNABLE IS NOT ZERO. A census that could not run has observed nothing: it is
// CensusUnobserved, neither the green's zero nor the red's positive count, so a harness that stops
// working fails in both directions instead of passing by silence.
fn blocking_parse_error_verdict(source: String, holds: fn(Int) -> Bool) -> ProcessExit {
  census_exit(census_verdict(census: blocking_class_census(source: source, wanted_class: "ParseError"), holds: holds))
}

data red_arity_zero_member_list_source: String = "module probe_arity_zero_import\nimport std.types {\n}\nfn answers() -> Int { 7 }\n"

data green_one_member_source: String = "module probe_arity_one_import\nimport std.types { Int }\nfn answers() -> Int { 7 }\n"

test fn an_arity_zero_import_member_list_refuses_at_parse() -> ProcessExit {
  blocking_parse_error_verdict(source: red_arity_zero_member_list_source, holds: fn(n) { n >= 1 })
}

test fn the_same_import_carrying_one_member_is_accepted() -> ProcessExit {
  blocking_parse_error_verdict(source: green_one_member_source, holds: fn(n) { n == 0 })
}
