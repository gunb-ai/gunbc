module test.claim.package_graph_witness_test


type ProbeSelection {
  name: std.types.NonEmptyStr
  version: std.types.NonEmptyStr
}

type ProbeKind = ProbeRuntime | ProbeDev

fn node(key: std.types.NonEmptyStr, name: std.types.NonEmptyStr, v: std.types.NonEmptyStr) -> extdeps.package.PackageLockNode<std.types.NonEmptyStr, ProbeSelection, String> {
  extdeps.package.PackageLockNode {
    key: key,
    selection: ProbeSelection { name: name, version: v },
    metadata: "",
  }
}

fn graph() -> extdeps.package.PackageLockGraph<std.types.NonEmptyStr, std.types.NonEmptyStr, ProbeSelection, String, ProbeKind> {
  extdeps.package.PackageLockGraph {
    manager: "probe-pm" as std.types.NonEmptyStr,
    roots: ["node_modules/a" as std.types.NonEmptyStr],
    nodes: [
      node(key: "node_modules/a" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "1.0.0" as std.types.NonEmptyStr),
      node(key: "node_modules/b/node_modules/a" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "1.0.0" as std.types.NonEmptyStr),
    ],
    edges: [extdeps.package.PackageDependencyEdge {
      consumer: "node_modules/a" as std.types.NonEmptyStr,
      dependency: "node_modules/b/node_modules/a" as std.types.NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
}

test fn same_name_version_different_paths_stay_distinct() -> Bool {
  match extdeps.package.package_lock_lookup_node(graph: graph(), key: "node_modules/a" as std.types.NonEmptyStr) {
    extdeps.package.PackageLockNodeUnique { node: _ } =>
      match extdeps.package.package_lock_lookup_node(graph: graph(), key: "node_modules/b/node_modules/a" as std.types.NonEmptyStr) {
        extdeps.package.PackageLockNodeUnique { node: _ } =>
          match extdeps.package.package_lock_lookup_node(graph: graph(), key: "node_modules/c" as std.types.NonEmptyStr) {
            extdeps.package.PackageLockNodeAbsent { key: _ } => true
            extdeps.package.PackageLockNodeUnique { node: _ } => false
            extdeps.package.PackageLockNodeDuplicate { key: _, count: _ } => false
          }
        extdeps.package.PackageLockNodeAbsent { key: _ } => false
        extdeps.package.PackageLockNodeDuplicate { key: _, count: _ } => false
      }
    extdeps.package.PackageLockNodeAbsent { key: _ } => false
    extdeps.package.PackageLockNodeDuplicate { key: _, count: _ } => false
  }
}

test fn admitted_graph_accepts_unique_keys() -> Bool {
  match extdeps.package.package_lock_admit_graph(graph: graph()) {
    extdeps.package.PackageLockGraphAdmitted { graph: _ } => true
    _ => false
  }
}

test fn edge_to_missing_node_refuses() -> Bool {
  let g = extdeps.package.PackageLockGraph {
    manager: "probe-pm" as std.types.NonEmptyStr,
    roots: [],
    nodes: [node(key: "node_modules/a" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "1.0.0" as std.types.NonEmptyStr)],
    edges: [extdeps.package.PackageDependencyEdge {
      consumer: "node_modules/a" as std.types.NonEmptyStr,
      dependency: "node_modules/missing" as std.types.NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
  match extdeps.package.package_lock_admit_graph(graph: g) {
    extdeps.package.PackageLockGraphMissingEdgeDependency { key } =>
      key == ("node_modules/missing" as std.types.NonEmptyStr)
    _ => false
  }
}

test fn duplicate_identical_node_keys_refuse_admission() -> Bool {
  let g = extdeps.package.PackageLockGraph {
    manager: "probe-pm" as std.types.NonEmptyStr,
    roots: ["dup" as std.types.NonEmptyStr],
    nodes: [
      node(key: "dup" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "1.0.0" as std.types.NonEmptyStr),
      node(key: "dup" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "2.0.0" as std.types.NonEmptyStr),
    ],
    edges: [extdeps.package.PackageDependencyEdge {
      consumer: "dup" as std.types.NonEmptyStr,
      dependency: "dup" as std.types.NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
  match extdeps.package.package_lock_lookup_node(graph: g, key: "dup" as std.types.NonEmptyStr) {
    extdeps.package.PackageLockNodeDuplicate { key, count } =>
      key == ("dup" as std.types.NonEmptyStr)
        && count == 2
        && match extdeps.package.package_lock_admit_graph(graph: g) {
          extdeps.package.PackageLockGraphDuplicateNode { key: k2, count: c2 } =>
            k2 == ("dup" as std.types.NonEmptyStr) && c2 == 2
          _ => false
        }
    extdeps.package.PackageLockNodeUnique { node: _ } => false
    extdeps.package.PackageLockNodeAbsent { key: _ } => false
  }
}

test fn package_delivery_boundary_readmits_raw_graph() -> Bool {
  match gunbc.package_delivery.admit_codex_package_lock_graph(raw_graph: graph()) {
    extdeps.package.PackageLockGraphAdmitted { graph: _ } => true
    _ => false
  }
}

test fn admitted_nodes_do_not_surface_as_missing_root() -> Bool {
  let g = extdeps.package.PackageLockGraph {
    manager: "probe-pm" as std.types.NonEmptyStr,
    roots: [],
    nodes: [node(key: "only" as std.types.NonEmptyStr, name: "a" as std.types.NonEmptyStr, v: "1.0.0" as std.types.NonEmptyStr)],
    edges: [],
  }
  match extdeps.package.package_lock_admit_graph(graph: g) {
    extdeps.package.PackageLockGraphAdmitted { graph: _ } => true
    extdeps.package.PackageLockGraphLookupInconsistency { key: _ } => false
    extdeps.package.PackageLockGraphMissingRoot { key: _ } => false
    _ => false
  }
}

