module test.claim.package_graph_witness_test


type ProbeSelection {
  name: NonEmptyStr
  version: NonEmptyStr
}

type ProbeKind = ProbeRuntime | ProbeDev

fn node(key: NonEmptyStr, name: NonEmptyStr, v: NonEmptyStr) -> PackageLockNode<NonEmptyStr, ProbeSelection, String> {
  PackageLockNode {
    key: key,
    selection: ProbeSelection { name: name, version: v },
    metadata: "",
  }
}

fn graph() -> PackageLockGraph<NonEmptyStr, NonEmptyStr, ProbeSelection, String, ProbeKind> {
  PackageLockGraph {
    manager: "probe-pm" as NonEmptyStr,
    roots: ["node_modules/a" as NonEmptyStr],
    nodes: [
      node(key: "node_modules/a" as NonEmptyStr, name: "a" as NonEmptyStr, v: "1.0.0" as NonEmptyStr),
      node(key: "node_modules/b/node_modules/a" as NonEmptyStr, name: "a" as NonEmptyStr, v: "1.0.0" as NonEmptyStr),
    ],
    edges: [PackageDependencyEdge {
      consumer: "node_modules/a" as NonEmptyStr,
      dependency: "node_modules/b/node_modules/a" as NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
}

test fn same_name_version_different_paths_stay_distinct() -> Bool {
  match package_lock_lookup_node(graph: graph(), key: "node_modules/a" as NonEmptyStr) {
    PackageLockNodeUnique { node: _ } =>
      match package_lock_lookup_node(graph: graph(), key: "node_modules/b/node_modules/a" as NonEmptyStr) {
        PackageLockNodeUnique { node: _ } =>
          match package_lock_lookup_node(graph: graph(), key: "node_modules/c" as NonEmptyStr) {
            PackageLockNodeAbsent { key: _ } => true
            PackageLockNodeUnique { node: _ } => false
            PackageLockNodeDuplicate { key: _, count: _ } => false
          }
        PackageLockNodeAbsent { key: _ } => false
        PackageLockNodeDuplicate { key: _, count: _ } => false
      }
    PackageLockNodeAbsent { key: _ } => false
    PackageLockNodeDuplicate { key: _, count: _ } => false
  }
}

test fn admitted_graph_accepts_unique_keys() -> Bool {
  match package_lock_admit_graph(graph: graph()) {
    PackageLockGraphAdmitted { graph: _ } => true
    _ => false
  }
}

test fn edge_to_missing_node_refuses() -> Bool {
  let g = PackageLockGraph {
    manager: "probe-pm" as NonEmptyStr,
    roots: [],
    nodes: [node(key: "node_modules/a" as NonEmptyStr, name: "a" as NonEmptyStr, v: "1.0.0" as NonEmptyStr)],
    edges: [PackageDependencyEdge {
      consumer: "node_modules/a" as NonEmptyStr,
      dependency: "node_modules/missing" as NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
  match package_lock_admit_graph(graph: g) {
    PackageLockGraphMissingEdgeDependency { key } =>
      key == ("node_modules/missing" as NonEmptyStr)
    _ => false
  }
}

test fn duplicate_identical_node_keys_refuse_admission() -> Bool {
  let g = PackageLockGraph {
    manager: "probe-pm" as NonEmptyStr,
    roots: ["dup" as NonEmptyStr],
    nodes: [
      node(key: "dup" as NonEmptyStr, name: "a" as NonEmptyStr, v: "1.0.0" as NonEmptyStr),
      node(key: "dup" as NonEmptyStr, name: "a" as NonEmptyStr, v: "2.0.0" as NonEmptyStr),
    ],
    edges: [PackageDependencyEdge {
      consumer: "dup" as NonEmptyStr,
      dependency: "dup" as NonEmptyStr,
      kind: ProbeRuntime,
    }],
  }
  match package_lock_lookup_node(graph: g, key: "dup" as NonEmptyStr) {
    PackageLockNodeDuplicate { key, count } =>
      key == ("dup" as NonEmptyStr)
        && count == 2
        && match package_lock_admit_graph(graph: g) {
          PackageLockGraphDuplicateNode { key: k2, count: c2 } =>
            k2 == ("dup" as NonEmptyStr) && c2 == 2
          _ => false
        }
    PackageLockNodeUnique { node: _ } => false
    PackageLockNodeAbsent { key: _ } => false
  }
}

test fn package_delivery_boundary_readmits_raw_graph() -> Bool {
  match admit_codex_package_lock_graph(raw_graph: graph()) {
    PackageLockGraphAdmitted { graph: _ } => true
    _ => false
  }
}

test fn admitted_nodes_do_not_surface_as_missing_root() -> Bool {
  let g = PackageLockGraph {
    manager: "probe-pm" as NonEmptyStr,
    roots: [],
    nodes: [node(key: "only" as NonEmptyStr, name: "a" as NonEmptyStr, v: "1.0.0" as NonEmptyStr)],
    edges: [],
  }
  match package_lock_admit_graph(graph: g) {
    PackageLockGraphAdmitted { graph: _ } => true
    PackageLockGraphLookupInconsistency { key: _ } => false
    PackageLockGraphMissingRoot { key: _ } => false
    _ => false
  }
}

