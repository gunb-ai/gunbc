module test.claim.parse_population_baseline_roster_witness

import std.types { Bool }
import gunbc.parse_population_baseline_roster {
  parse_population_cardinality_accepts_real,
  parse_population_cardinality_refuses_planted_extra_row,
  parse_population_partition_is_consistent,
  parse_population_zero_byte_row_count,
  parse_population_is_unique,
  parse_population_duplicate_refuses_with_trivial_eq,
  parse_population_rows_ordered_descending,
  parse_population_ordering_accepts_descending,
  parse_population_ordering_refuses_ascending,
  parse_population_reconcile_accepts_correct_slice,
  parse_population_reconcile_refuses_mistyped_slice,
  parse_population_unreconciled_row_count,
  parse_population_mistyped_real_row_slice,
  parse_population_correct_real_row_slice,
  parse_population_roster_is_selected_sorted,
  parse_population_top_n_excludes_overflow,
  parse_population_top_n_accepts_full_window,
  parse_population_top_n_breaks_tie_by_path,
  parse_population_selection_refuses_misordered_tie,
  parse_population_carrier_reader_rung_drop_ledger_line,
}

// THE ROSTERED CLAIM for gunbc.parse_population_baseline_roster, the two fixed parse populations
// (Five Largest and 165-Sample) of roadmap row emission-real-consumer-profiles. It does not restate
// the selection rule (that is the carrier's single home, gunbc.design_argument::planning_has_one_home);
// it EXECUTES the carrier and refuses if the roster silently lost or gained a member, or if a byte
// total moved, so a claim that reads an empty or short roster cannot pass
// (gunbc.design_argument::fail_closed — a check standing where construction was available must
// actually measure). NONZERO by construction: every count is asserted EQUAL to a positive figure,
// so a 0 roster fails, not passes, and the named negative control proves the discrimination
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).

// Whole-roster cardinality: the 170 members the row fixes (5 + 165).
test fn parse_population_baseline_roster_cardinality_holds() -> Bool {
  // review 98328 + warm-fox rule: a cardinality claim must be discriminating, not a constant
  // readback. The former ==5 / ==165 conjuncts only read the constants back (fail_closed); the real
  // check is the fixed benchmark size, and it is PAIRED with a planted-row refusal in this same leg
  // so it can actually fail for the reason it claims: the ACCEPT arm (real roster is exactly the
  // expected 170 = 5 largest + 165 sample) AND the REFUSE arm (a roster with one planted extra row
  // must be refused). Both arms run in this one witness so the negative fails in the same run.
  parse_population_cardinality_accepts_real()
    && parse_population_cardinality_refuses_planted_extra_row()
}

// Byte totals per fixed population and combined, compared IN the ByteSize measure (no bare-Int
// re-representation; gunbc.design_argument::single_authority).
// Non-circular byte invariants: the two populations are a disjoint cover of the roster and no row is
// zero. These are derived from the roster's own rows, NOT compared against literals copied from the
// same tree read (fail_closed: "a count copied from the current tree is a change detector"). The
// absolute measured totals live in the measurement report as the recorded baseline, with the pinned
// sha and the producer command, so they are reproducible there; asserting them here would only restate
// the roster against itself.
test fn parse_population_baseline_roster_byte_invariants_hold() -> Bool {
  parse_population_partition_is_consistent()
    && parse_population_zero_byte_row_count() == 0
}

// The selection rule's ordering invariant, executed: the roster is non-increasing in byte size
// along list order, so the two fixed populations really are the largest blobs at the pinned sha.
test fn parse_population_baseline_rows_ordered_descending_holds() -> Bool {
  parse_population_rows_ordered_descending()
}

// DISCRIMINATION (both arms shown). The ACCEPT arm: a descending synthetic list is accepted.
test fn parse_population_ordering_accepts_descending_holds() -> Bool {
  parse_population_ordering_accepts_descending()
}

// The REFUSE arm: an ascending synthetic list (a smaller file before a larger one) is refused by
// the same fold. If the fold passed everything, this FAILs — so the invariant cannot be vacuous.
test fn parse_population_ordering_refuses_ascending_holds() -> Bool {
  parse_population_ordering_refuses_ascending()
}

// THE SELECTION RULE AS A TYPED ALGORITHM (review 98809 F1). The rule "top N by blob size descending,
// then path ascending for the tiebreak" was an unchecked comment plus a shell sort; it now lives in
// the carrier and is EXECUTED here, so the shell runner is transport, not the authority for the rule
// (how_to_work: "raw shell implementing semantics expressible in .dag"). The roster is checked against
// its own modelled top-N order.
test fn parse_population_selection_rule_is_modelled_holds() -> Bool {
  parse_population_roster_is_selected_sorted()
}

// DISCRIMINATING PAIR for the top-N window: [30,20,10] top-2 leaves exactly one row outside, top-3
// leaves none. A window that always said "inside" fails the first; "always outside" fails the second
// (executed_red_control_names_its_failing_commit).
test fn parse_population_top_n_window_discriminates_holds() -> Bool {
  parse_population_top_n_excludes_overflow()
    && parse_population_top_n_accepts_full_window()
}

// TIEBREAK IS MODELLED, not just size: at equal blob size the smaller path wins the slot. The
// size-only ordering check above cannot distinguish two equal sizes; this claim proves the path
// component of the comparator is real, so a stored order that breaks the path tiebreak turns red.
test fn parse_population_selection_breaks_tie_by_path_holds() -> Bool {
  parse_population_top_n_breaks_tie_by_path()
    && parse_population_selection_refuses_misordered_tie()
}

// Disjointness/uniqueness over the whole roster via keyed_roster_build's Built arm.
test fn parse_population_baseline_roster_is_unique_holds() -> Bool {
  parse_population_is_unique()
}

// NAMED NEGATIVE CONTROL. The same fold over the same 170 rows with a trivial always-equal key_eq
// MUST land on DuplicateKey. This is the leg that proves the uniqueness verdict above is a real
// discrimination and not a fold that ignores its key: if this ever PASSed as Built, the roster
// check would be green by vacancy. Run in the same claim_batch, so the green and the red leg share
// a run.
test fn parse_population_baseline_roster_duplicate_key_refuses() -> Bool {
  parse_population_duplicate_refuses_with_trivial_eq()
}

// CARRIER <-> TREE reconciliation, BOTH arms (the load-bearing instrument that ties these rows to the
// tree; review 98443). ACCEPT: the correct real-row slice reconciles fully (zero unreconciled rows).
// REFUSE: the same slice with one REAL row's byte size mistyped is NOT fully reconciled — a real wrong
// row drives the refusal. This claim_batch test exercises ONLY the comparison predicate against
// hand-built reference row-sets; it does NOT itself read `git ls-tree` and does NOT read the 170-row
// roster (no filesystem in the language). The reconciliation of ALL 170 rows against
// `git ls-tree -r -l <pinned_sha>` (green diff rc 0; a mistyped row drives it rc nonzero) is executed by
// the committed runner test/parse_population_baseline_roster/run_evidence.sh — the last execution of that
// path — recorded as a green-by-execution run link (legs A/B/C); gunbc CI executes no claims, so no CI
// lane runs it. The name says exactly what THIS claim judges: the predicate refuses one bad row.
test fn parse_population_reconcile_predicate_refuses_bad_row_holds() -> Bool {
  parse_population_reconcile_accepts_correct_slice()
    && parse_population_reconcile_refuses_mistyped_slice()
}

// REAL-WRONG-ROW RED CONTROL (replaces the former planted byte_size(count: 999); review 98443 says the
// red control must be a real wrong row, not a planted constant). Invoked by name in the SAME claim_batch
// as the PASS witnesses: it asserts the MISTYPED real-row slice reconciles fully to the correct tree,
// which is FALSE (one real row's byte size is wrong), so claim_batch reports exactly one FAIL-by-name line
// while the witnesses PASS — proving the runner reports a real wrong row as FAIL, not PASS
// (gunbc.design_ruling::executed_red_control_names_its_failing_commit).
fn parse_population_roster_red_control_mistyped_row_fails() -> Bool {
  parse_population_unreconciled_row_count(
    declared: parse_population_mistyped_real_row_slice(),
    tree: parse_population_correct_real_row_slice()) == 0
}


// THE F2 RUNG DROP IS DECLARED AND READ: the carrier's regex-reader limitation
// (parse_population_carrier_reader_rung_drop) is rendered by its consumer into a ledger line; this guard
// fails if that limitation text is ever deleted while the runners still read the carrier by regex
// (source_annotations; review 98809 F2). Presence is the guard; the substance is the bounded-trigger text.
test fn parse_population_carrier_reader_rung_drop_declared_holds() -> Bool {
  parse_population_carrier_reader_rung_drop_ledger_line() != ""
}
