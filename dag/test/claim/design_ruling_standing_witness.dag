module test.claim.design_ruling_standing_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count
}
import std.types { String, Bool, Int }
import std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// AN UNCLASSIFIED RULING DOES NOT CONSTRUCT. `gunbc.design_ruling DesignRuling` carries `standing`
// with no default arm, so a row that omits it is a missing-field refusal at compile time, which is
// structural rather than a check run over the roster. This witness exists because that fact is
// otherwise only asserted in prose: it drives the real census over a source that builds a
// DesignRuling without the field and over the same source with it, and asks for a DIFFERENTIAL
// (red_count > green_count), not a bare zero, because a total over a live-tree fixture is not exact
// evidence. Each source also has a census_ran control, so a CensusNotRunnable (counted -1) reds the
// claim instead of reading as a held refusal.
fn census_ran(source: String) -> Bool {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: _ } => true
    CensusNotRunnable { cause: _ } => false
  }
}

fn refusing_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => 0 - 1
  }
}

data unclassified_source: String = "module probe_unclassified_ruling\nimport std.decl_ref { decl_ref }\nimport gunbc.design_ruling { DesignRuling }\nfn probe() -> DesignRuling { DesignRuling { reference: decl_ref(module_path: \"m\", decl_name: \"d\"), decided: \"2026-01-01\", section: \"3\", provenance: \"p\" } }\n"

data classified_source: String = "module probe_classified_ruling\nimport std.decl_ref { decl_ref }\nimport gunbc.design_ruling { DesignRuling, CitedInDesign }\nfn probe() -> DesignRuling { DesignRuling { reference: decl_ref(module_path: \"m\", decl_name: \"d\"), decided: \"2026-01-01\", section: \"3\", provenance: \"p\", standing: CitedInDesign {} } }\n"

test fn an_unclassified_ruling_row_is_refused_and_a_classified_one_is_not() -> Bool {
  census_ran(source: unclassified_source)
    && census_ran(source: classified_source)
    && refusing_count(source: unclassified_source) > refusing_count(source: classified_source)
}
