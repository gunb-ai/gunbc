module test.claim.transport_emission_not_modeled_witness

import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus,
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_count_at_key,
  census_rows_of_class,
  census_total_count,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Permanent regression control for the `transport file` emission wall (DESIGN §4b(4): a climb
// deletes the production machinery it obsoletes, but the discriminating RED and its positive
// control STAY ENROLLED as the executing evidence that the higher rung is still real -- deleting
// the evidence with the machinery would recreate specification-without-execution one rung up).
//
// WHAT CHANGED, and why every row below flipped rather than being deleted. #8858 replaced three
// fabricating per-target renderers with a TOTAL refusal, and this file's rows then read "every
// file operation refuses". The next-rung trigger that PR declared has since fired -- the
// self-host `03_ingest` closure imports extdeps.filesystem.filesystem_io, so a total wall emitted
// no artifact at all for the module the self-host boards are taken on -- and the rust target now
// carries a real realization handler. So the ROW SUBJECTS are the same and their expectations are
// inverted: a fully-declared file operation must EMIT for rust, and the wall must still refuse,
// per operation, exactly what the handler cannot express.
//
// The census compiles for the RUST target only (cli_run compile_dag_diagnostic_census), so every
// count here is a rust-path count. Python and go remain refused by target and are NOT witnessed
// by this file -- claiming their rung from these rows would be the §4b(1) inflation.
//
// The two shell/rest rows are NOT decoration. Without them this file cannot distinguish "the file
// arm behaves" from "the transport dispatch is broken for everything", which is the failure mode
// that would make a green suite defend a total outage.
// Paired control for the file-transport emission wall via compile_dag_diagnostic_census (rust
// target). A service whose operations declare `transport file` with a modeled verb, a renderable
// path and modeled output channels must now EMIT with zero TransportEmissionNotModeled rows; an
// operation declaring an unmodeled verb, an unmodeled output channel, or a payload verb with no
// `content` input must refuse with exactly one counted row. The mixed row is the discriminator: it
// pins both the emission and the refusal to the OPERATION rather than to the service or the module,
// so a wall that poisoned every sibling operation -- or a handler that emitted every sibling
// regardless of its declaration -- would go red here while the single-operation rows stayed green.

data file_transport_source: String = "module tfx_file\nservice Fs \{\n  operation Write \{\n    input \{ path: String, content: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\", success: Bool from \"read_success\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Delete \{\n    input \{ path: String \}\n    output \{ success: Bool from \"delete_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"delete\" \}\n  \}\n  operation List \{\n    input \{ path: String \}\n    output \{ entries: String from \"entries\", success: Bool from \"list_success\" \}\n    readonly\n    transport file \{ path: \"\{path\}\", verb: \"list\" \}\n  \}\n\}\n"

data rest_and_shell_source: String = "module tfx_ok\nimport extdeps.transports.rest \{ RestResult \}\nservice Sh \{\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n\}\n\nservice Net \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n\}\n"

// The same importing fixture with one unmodeled operation beside the healthy ones. It keeps the
// rest import, so this RED reaches the closure the zero claims above read: if a blocking row in
// that closure stops emit again, this goes red instead of the zeros going silently green
// (gunbc.recurring_failure_mode a_census_measurement_mode_changes_whether_emit_runs).
data rest_and_shell_with_planted_refusal_source: String = "module tfx_ok_red\nimport extdeps.transports.rest \{ RestResult \}\nservice Sh \{\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n  operation Chmod \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"chmod\" \}\n  \}\n\}\n\nservice Net \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n\}\n"

data mixed_transport_source: String = "module tfx_mixed\nimport extdeps.transports.rest \{ RestResult \}\nservice Mixed \{\n  config \{\n    endpoint: \"https://example.invalid\"\n  \}\n  operation Fetch \{\n    input \{ id: String \}\n    output \{ body: String from \"body\" \}\n    readonly\n    transport rest \{ method: GET, path: \"/things/\{id\}\" \}\n  \}\n  operation ListDirs \{\n    input \{ path: String \}\n    output \{ dirs: String from \"stdout_lines\" \}\n    readonly\n    transport shell \{ argv: [\"find\", \"\{path\}\", \"-type\", \"d\"] \}\n  \}\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

// The three discriminating REDs, one per FileEmissionRefusal arm the rust handler can meet. Each
// declares TWO file operations: one fully modeled and one carrying the single unmodeled fact, so
// the expected count of 1 separates "this operation refused" from "declaring a file transport
// anywhere in the module refuses", which a one-operation fixture cannot.
data unmodeled_verb_source: String = "module tfx_verb\nservice Fv \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Chmod \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"chmod\" \}\n  \}\n\}\n"

data unmodeled_output_key_source: String = "module tfx_key\nservice Fk \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Stat \{\n    input \{ path: String \}\n    output \{ modified: String from \"modified_time\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n\}\n"

data payload_verb_without_content_source: String = "module tfx_payload\nservice Fp \{\n  operation Read \{\n    input \{ path: String \}\n    output \{ content: String from \"content\" \}\n    readonly\n    transport file \{ path: \"\{path\}\" \}\n  \}\n  operation Seal \{\n    input \{ path: String \}\n    output \{ success: Bool from \"write_success\" \}\n    transport file \{ path: \"\{path\}\", verb: \"write_owner_only\" \}\n  \}\n\}\n"

// The rust shell handler now realizes the declared stderr capture channels
// (truncation + both byte counts) from WitnessStderrCapturePolicy. The mixed
// row keeps the unmodeled-key RED beside that emission so a handler that
// answered every sibling, or a wall that poisoned every sibling, still fails.
data shell_stderr_capture_source: String = "module tfx_cap\nimport std.shell_stream_capture \{ WitnessStderrCapturePolicy, BoundedTail \}\nimport std.measure \{ byte_size \}\nservice Bin \{\n  operation Run \{\n    input \{\n      bin_path: String\n      stderr_capture: WitnessStderrCapturePolicy = BoundedTail \{ bytes: byte_size(count: 16) \}\n    \}\n    output \{\n      success: Bool from \"exit_success\"\n      stderr: String from \"stderr\"\n      stderr_truncated: Bool from \"stderr_truncated\"\n      stderr_total_bytes: Int from \"stderr_total_bytes\"\n      stderr_retained_bytes: Int from \"stderr_retained_bytes\"\n    \}\n    transport shell \{ argv: [\"\{bin_path\}\"] \}\n  \}\n\}\n"

data shell_stderr_capture_beside_unmodeled_key_source: String = "module tfx_cap_mix\nimport std.shell_stream_capture \{ WitnessStderrCapturePolicy, BoundedTail \}\nimport std.measure \{ byte_size \}\nservice Bin \{\n  operation Run \{\n    input \{\n      bin_path: String\n      stderr_capture: WitnessStderrCapturePolicy = BoundedTail \{ bytes: byte_size(count: 16) \}\n    \}\n    output \{\n      success: Bool from \"exit_success\"\n      stderr_truncated: Bool from \"stderr_truncated\"\n      stderr_total_bytes: Int from \"stderr_total_bytes\"\n      stderr_retained_bytes: Int from \"stderr_retained_bytes\"\n    \}\n    transport shell \{ argv: [\"\{bin_path\}\"] \}\n  \}\n  operation Weird \{\n    input \{ bin_path: String \}\n    output \{ digest: String from \"stderr_digest_hex\" \}\n    transport shell \{ argv: [\"\{bin_path\}\"] \}\n  \}\n\}\n"

data shell_stderr_capture_without_policy_input_source: String = "module tfx_cap_nop\nservice Bin \{\n  operation Run \{\n    input \{ bin_path: String \}\n    output \{\n      success: Bool from \"exit_success\"\n      stderr_truncated: Bool from \"stderr_truncated\"\n    \}\n    transport shell \{ argv: [\"\{bin_path\}\"] \}\n  \}\n\}\n"

fn not_modeled_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TransportEmissionNotModeled")))
    CensusNotRunnable { cause: _ } => -1
  }
}

fn blocking_diagnostic_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_fully_declared_file_transport_operations_emit() -> Bool {
  not_modeled_blocking_count(source: file_transport_source) == 0
}

test fn w_fully_declared_file_transport_module_is_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: file_transport_source) == 0
}

test fn w_rest_and_shell_transports_emit_without_refusal() -> Bool {
  not_modeled_blocking_count(source: rest_and_shell_source) == 0
}

// The census rows are the WHOLE compile's, and this fixture imports extdeps.transports.rest, so an
// all-blocking total carries that closure's rows and is permanently nonzero
// (gunbc.compile_diagnostic_census, CompileDiagnosticCensus). The exact form is a count keyed on
// class AND subject; a TransportEmissionNotModeled row's subject is "<Service>.<Operation>"
// (compile_clean_diagnostic_histogram_key), so the fixture's own operations are the subjects.
fn own_operation_refusal_count(source: String, subject: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: "TransportEmissionNotModeled", subject_name: subject, blocking: true)
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_rest_and_shell_transports_are_not_refused_at_their_own_operations() -> Bool {
  own_operation_refusal_count(source: rest_and_shell_source, subject: "Sh.ListDirs") == 0
    && own_operation_refusal_count(source: rest_and_shell_source, subject: "Net.Fetch") == 0
}

// THE QUALIFIED-SPELLING CONTROL. extdeps.transports.rest spells rest_method_verb's return type
// std.effect_grant.Verb and imports std.effect_grant selectively; production binds that name, and
// so must the census, or the importing fixtures above stop emitting (gunbc#15097,
// gunbc.recurring_failure_mode a_census_measurement_mode_changes_whether_emit_runs). Keyed on both
// classes the measure can charge it to, so neither a revert of the import arm (UnresolvedType)
// nor a disagreement reading of an imported module (TypeRefMeasureBindingDisagreement) passes.
fn qualified_verb_blocking_count(diagnostic_class: String) -> Int {
  match compile_dag_diagnostic_census(rest_and_shell_source) {
    CensusObserved { rows: rows } =>
      census_count_at_key(rows: rows, diagnostic_class: diagnostic_class, subject_name: "std.effect_grant.Verb", blocking: true)
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_rest_qualified_return_type_binds_under_the_census() -> Bool {
  qualified_verb_blocking_count(diagnostic_class: "UnresolvedType") == 0
    && qualified_verb_blocking_count(diagnostic_class: "TypeRefMeasureBindingDisagreement") == 0
}

test fn w_importing_fixture_reports_a_planted_refusal_at_its_own_operation() -> Bool {
  own_operation_refusal_count(source: rest_and_shell_with_planted_refusal_source, subject: "Sh.Chmod") == 1
    && own_operation_refusal_count(source: rest_and_shell_with_planted_refusal_source, subject: "Sh.ListDirs") == 0
    && own_operation_refusal_count(source: rest_and_shell_with_planted_refusal_source, subject: "Net.Fetch") == 0
}

// RED + positive control for the keyed form: it must go red on a planted refusal at the fixture's
// own operation (Fv.Chmod, unmodeled verb) and stay zero at the healthy sibling (Fv.Read).
test fn w_keyed_count_sees_a_planted_refusal_at_its_own_operation_only() -> Bool {
  own_operation_refusal_count(source: unmodeled_verb_source, subject: "Fv.Chmod") == 1
    && own_operation_refusal_count(source: unmodeled_verb_source, subject: "Fv.Read") == 0
}

test fn w_file_operation_emits_beside_its_rest_and_shell_siblings() -> Bool {
  not_modeled_blocking_count(source: mixed_transport_source) == 0
}

test fn w_unmodeled_verb_refuses_only_its_own_operation() -> Bool {
  not_modeled_blocking_count(source: unmodeled_verb_source) == 1
}

test fn w_unmodeled_output_channel_refuses_only_its_own_operation() -> Bool {
  not_modeled_blocking_count(source: unmodeled_output_key_source) == 1
}

test fn w_payload_verb_without_content_input_refuses_only_its_own_operation() -> Bool {
  not_modeled_blocking_count(source: payload_verb_without_content_source) == 1
}

test fn w_declared_shell_stderr_capture_channels_emit() -> Bool {
  not_modeled_blocking_count(source: shell_stderr_capture_source) == 0
}

test fn w_declared_shell_stderr_capture_module_is_clean_of_all_blocking_diagnostics() -> Bool {
  blocking_diagnostic_count(source: shell_stderr_capture_source) == 0
}

test fn w_unmodeled_shell_channel_refuses_beside_realized_capture_channels() -> Bool {
  not_modeled_blocking_count(source: shell_stderr_capture_beside_unmodeled_key_source) == 1
}

test fn w_capture_channel_without_stderr_capture_input_refuses() -> Bool {
  not_modeled_blocking_count(source: shell_stderr_capture_without_policy_input_source) == 1
}
