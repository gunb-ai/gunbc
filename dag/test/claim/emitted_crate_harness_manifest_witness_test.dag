module test.claim.emitted_crate_harness_manifest_witness

import std.logic { Bool }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import tools.emitted_crate_harness_manifest {
  HarnessCrateTarget,
  WitnessBinTarget,
  ProbeLibTarget,
  HarnessSeedLinkage,
  SeedLinked,
  SeedAbsent,
  HarnessManifestDerived,
  EmittedManifestUnreadable,
  HarnessManifestWriteFailed,
  harness_manifest_over_emitted,
  derive_harness_manifest_in_place
}

// THE EMITTED MANIFEST IS SUPPLIED, NOT PRODUCED. These claims are about one boundary -- what a
// harness manifest is, given the manifest an emission wrote -- so the emitted text is a designed
// value carrying a dependency no harness has ever named. The real emitter's manifest reaching this
// function is the behavioral transport roster's fact (its rows build through the derived
// manifest), not something a claim here re-executes.
data supplied_emitted_manifest: String = "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[workspace]\n\n[features]\ndefault = []\n\n[dependencies]\nim = \"15.1\"\nzz-harness-never-named-this = \"9.9\"\n"

data supplied_dependency_line: String = "zz-harness-never-named-this = \"9.9\"\n"

fn derived_over_supplied(target: HarnessCrateTarget, linkage: HarnessSeedLinkage) -> String {
  harness_manifest_over_emitted(emitted: supplied_emitted_manifest, target: target, linkage: linkage)
}

// The discriminating control for the class: a dependency present only in the emitted manifest is
// present in every harness manifest. A harness that wrote its own roster over the emitted one
// fails this for whichever dependency its roster omits.
test fn a_dependency_only_the_emission_declared_reaches_every_harness_manifest() -> Bool {
  string_contains(s: derived_over_supplied(target: WitnessBinTarget, linkage: SeedLinked { root: "/r" }), pattern: supplied_dependency_line)
    && string_contains(s: derived_over_supplied(target: WitnessBinTarget, linkage: SeedAbsent), pattern: supplied_dependency_line)
    && string_contains(s: derived_over_supplied(target: ProbeLibTarget, linkage: SeedLinked { root: "/r" }), pattern: supplied_dependency_line)
    && string_contains(s: derived_over_supplied(target: ProbeLibTarget, linkage: SeedAbsent), pattern: supplied_dependency_line)
}

// What the harness adds over an EMPTY emitted manifest is the whole of what it authors. It may
// carry target tables and the seed path; a registry requirement in it is the second dependency
// authority returning.
test fn the_harness_overlay_declares_no_registry_dependency() -> Bool {
  let seed_linked = harness_manifest_over_emitted(emitted: "", target: WitnessBinTarget, linkage: SeedLinked { root: "/r" })
  let seed_absent = harness_manifest_over_emitted(emitted: "", target: ProbeLibTarget, linkage: SeedAbsent)
  !string_contains(s: seed_linked, pattern: "version")
    && !string_contains(s: seed_absent, pattern: "version")
    && !string_contains(s: seed_linked, pattern: "\n[dependencies]\n")
    && !string_contains(s: seed_absent, pattern: "[dependencies")
}

test fn the_seed_dependency_table_exists_exactly_when_the_build_is_seed_linked() -> Bool {
  let seed_table = "\n[dependencies.v1-compiler]\npath = \"/r/src/v1/stage0\"\n"
  string_contains(s: derived_over_supplied(target: WitnessBinTarget, linkage: SeedLinked { root: "/r" }), pattern: seed_table)
    && string_contains(s: derived_over_supplied(target: ProbeLibTarget, linkage: SeedLinked { root: "/r" }), pattern: seed_table)
    && !string_contains(s: derived_over_supplied(target: WitnessBinTarget, linkage: SeedAbsent), pattern: "v1-compiler")
    && !string_contains(s: derived_over_supplied(target: ProbeLibTarget, linkage: SeedAbsent), pattern: "v1-compiler")
}

test fn only_the_witness_target_declares_the_witness_binary() -> Bool {
  let bin_table = "\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n"
  string_contains(s: derived_over_supplied(target: WitnessBinTarget, linkage: SeedAbsent), pattern: bin_table)
    && !string_contains(s: derived_over_supplied(target: ProbeLibTarget, linkage: SeedAbsent), pattern: "[[bin]]")
}

fn refused_as_unreadable(crate_dir: String) -> Bool {
  match derive_harness_manifest_in_place(crate_dir: crate_dir, target: WitnessBinTarget, linkage: SeedAbsent) {
    EmittedManifestUnreadable { path: p } => p == concat(crate_dir, "/Cargo.toml")
    HarnessManifestDerived { content: _ } => false
    HarnessManifestWriteFailed { path: _ } => false
  }
}

// A crate directory the emitter did not describe is refused, and nothing is written in its place:
// the refusal names the manifest it could not read, and the directory still holds no Cargo.toml.
test fn a_crate_directory_without_an_emitted_manifest_refuses_and_writes_nothing() -> Bool {
  let dir = shell.Mktemp.Dir()
  let refused = refused_as_unreadable(crate_dir: dir.path)
  let after = Filesystem.Read(path: concat(dir.path, "/Cargo.toml"))
  let cleaned = shell.Remove.RecursiveForce(path: dir.path)
  dir.success && refused && !after.success && cleaned.success
}

fn derived_content(crate_dir: String) -> String {
  match derive_harness_manifest_in_place(crate_dir: crate_dir, target: WitnessBinTarget, linkage: SeedLinked { root: "/r" }) {
    HarnessManifestDerived { content: c } => c
    EmittedManifestUnreadable { path: _ } => ""
    HarnessManifestWriteFailed { path: _ } => ""
  }
}

// The effectful route end to end over a supplied emitted file: what is on disk afterwards is the
// derived manifest, and it still carries the dependency only the emission declared.
test fn the_manifest_on_disk_after_derivation_is_the_emitted_one_plus_the_overlay() -> Bool {
  let dir = shell.Mktemp.Dir()
  let emitted = Filesystem.Write(path: concat(dir.path, "/Cargo.toml"), content: supplied_emitted_manifest)
  let content = derived_content(crate_dir: dir.path)
  let after = Filesystem.Read(path: concat(dir.path, "/Cargo.toml"))
  let cleaned = shell.Remove.RecursiveForce(path: dir.path)
  dir.success && emitted.success && after.success && cleaned.success
    && content == derived_over_supplied(target: WitnessBinTarget, linkage: SeedLinked { root: "/r" })
    && after.content == content
    && string_contains(s: after.content, pattern: supplied_dependency_line)
}
