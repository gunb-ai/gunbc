module test.claim.merge_admission_producer_witness


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data scenario_base: ContentHash = "merge-admission-producer-base"
data scenario_head: ContentHash = "abc1234def5678901234567890abcd1234567890"

data green_receipt: MergeAdmissionReceipt = stamp_floor_receipt_with_conclusion(
  pr_number: Present { value: 5933 },
  head_sha: scenario_head,
  base_tree_hash: scenario_base,
  conclusion: Success,
)

data red_receipt: MergeAdmissionReceipt = stamp_floor_receipt_with_conclusion(
  pr_number: Present { value: 5933 },
  head_sha: scenario_head,
  base_tree_hash: scenario_base,
  conclusion: Failure,
)

data floor_shell_transport_retired_note: String = "These replace three witnesses that pinned the RETIRED shell transport: floor_stamp_exports_ci_floor_exit_on_gunbc_line asserted the literal `CI_FLOOR_EXIT=$FLOOR_EXIT \"$ROOT/target/release/gunbc\" run` line, floor_stamp_propagates_stamp_failure_after_green_floor asserted the STAMP_EXIT/FLOOR_EXIT capture arithmetic, and stamp_missing_floor_exit_policy_is_fail_closed asserted a policy note about unset CI_FLOOR_EXIT. All three described a producer that no longer exists — merge admission is now an OnWalkSuccess finalizer inside the walk, not a shell tail. Deleting them without replacement would have removed the producer-shape coverage entirely, so the assertions are re-aimed at the NEW transport and, critically, keep a NEGATIVE arm: the retired env channel must be provably absent from the emitted floor script, not merely unmentioned. Two exit-code mapping witnesses went with them (see merge_admission_exit_code_mapping_retired_note) because the function they tested is deleted."

test fn floor_script_no_longer_carries_the_exit_code_channel() -> Bool {
  let script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  !string_contains(s: script, pattern: "CI_FLOOR_EXIT")
    && !string_contains(s: script, pattern: "FLOOR_EXIT=$?")
    && !string_contains(s: script, pattern: "STAMP_EXIT")
    && !string_contains(s: script, pattern: "set +e")
    && !string_contains(s: script, pattern: "merge_admission_stamp.dag")
}

test fn floor_script_still_invokes_the_executor() -> Bool {
  let script = gunbc_ci_floor_only_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: "claim_executor")
    && string_contains(s: script, pattern: "gunbc_ci_floor_batches")
}

test fn admission_rides_the_floor_finalizers_in_stamp_then_gate_order() -> Bool {
  let fin = gunbc_ci_floor_finalizers()
  length(xs: fin) == 2
    && match fin.first() {
      RunnableSingleClaim { entry: e, function: f, profile: _ } =>
        (e == "dag/tools/merge_admission_stamp.dag") && (f == "merge_admission_stamp_claim")
      _ => false
    }
    && match fin.last() {
      RunnableSingleClaim { entry: e, function: f, profile: _ } =>
        (e == "dag/tools/merge_admission_gate.dag") && (f == "merge_admission_gate_claim")
      _ => false
    }
}

test fn stamp_conclusion_is_green_only_by_reachability() -> Bool {
  string_contains(s: merge_admission_stamp_green_only_by_reachability, pattern: "REACHABILITY")
    && string_contains(s: merge_admission_stamp_green_only_by_reachability, pattern: "FullLedger")
    && string_contains(s: merge_admission_stamp_green_only_by_reachability, pattern: "finalizer_index")
}

test fn mint_binds_current_gate_roster_hash() -> Bool {
  green_receipt.gate_roster_hash == current_gate_roster_hash
}

test fn shell_stdout_line_strips_trailing_newline() -> Bool {
  shell_stdout_line(raw: "abc123\n") == "abc123"
}

test fn wire_roundtrip_preserves_admission_fields() -> Bool {
  let wire = render_receipt_wire(receipt: green_receipt)
  match parse_receipt_wire(text: wire) {
    Present { value: parsed } =>
      (parsed.base_tree_hash == scenario_base)
        && (parsed.gate_roster_hash == current_gate_roster_hash)
        && (parsed.conclusion == extdeps.github.checks.Success)
        && (parsed.head_sha == scenario_head)
        && match parsed.pr_number {
          Present { value: n } => n == 5933
          Absent => false
        }
    Absent => false
  }
}

test fn wire_missing_head_sha_returns_absent() -> Bool {
  let wire = concat(
    concat(
      concat(scenario_base, "\n"),
      concat(current_gate_roster_hash, "\n")
    ),
    check_conclusion_wire_label(c: Success)
  )
  match parse_receipt_wire(text: wire) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn wire_missing_pr_number_parses_as_absent_field() -> Bool {
  let wire = concat(
    concat(
      concat(concat(scenario_base, "\n"), concat(current_gate_roster_hash, "\n")),
      concat(check_conclusion_wire_label(c: Success), "\n")
    ),
    scenario_head
  )
  match parse_receipt_wire(text: wire) {
    Present { value: parsed } =>
      match parsed.pr_number {
        Absent => parsed.conclusion == extdeps.github.checks.Success
        Present { value: _ } => false
      }
    Absent => false
  }
}

test fn wire_omitted_pr_roundtrips_without_fabricated_zero() -> Bool {
  let receipt = stamp_floor_receipt_with_conclusion(
    pr_number: none,
    head_sha: scenario_head,
    base_tree_hash: scenario_base,
    conclusion: Success,
  )
  let wire = render_receipt_wire(receipt: receipt)
  match parse_receipt_wire(text: wire) {
    Present { value: parsed } =>
      match parsed.pr_number {
        Absent =>
          (parsed.base_tree_hash == scenario_base)
            && (parsed.conclusion == extdeps.github.checks.Success)
            && (parsed.head_sha == scenario_head)
        Present { value: _ } => false
      }
    Absent => false
  }
}

test fn stamp_non_pr_event_omits_fabricated_pr_number() -> Bool {
  string_contains(
    s: merge_admission_stamp_non_pr_omits_pr_number,
    pattern: "not fabricated 0"
  )
}

test fn red_floor_stamps_failure_conclusion() -> Bool {
  red_receipt.conclusion == extdeps.github.checks.Failure
}

test fn receipt_schema_and_path_are_stable() -> Bool {
  (merge_admission_receipt_schema == "gunbc.merge_admission_receipt.v1")
    && (merge_admission_receipt_rel_path == ".gunbc/merge-admission-receipt.wire")
}

test fn mint_matches_explicit_constructor() -> Bool {
  let explicit = mint_merge_admission_receipt(
    pr_number: Present { value: 5933 },
    head_sha: scenario_head,
    base_tree_hash: scenario_base,
    gate_roster_hash: current_gate_roster_hash,
    conclusion: Success,
  )
  (explicit.base_tree_hash == green_receipt.base_tree_hash)
    && (explicit.gate_roster_hash == green_receipt.gate_roster_hash)
    && (explicit.conclusion == green_receipt.conclusion)
}
