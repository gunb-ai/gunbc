module test.claim.class_b_import_closure_binding_refusal_witness

import gunbc.declared_import_closure_binding {
  DeclaredImportClosureBindingObservation,
  BindingObserved,
  BindingNotRunnable,
  ObservationProduced,
  ObservationProductionRefused,
  ClassBListedImport,
  ClassBPoolCoincidence,
  ClassBSeamRefusal,
  ClassBOther,
  class_b_binding_projection,
  binding_source_is_listed_import,
  binding_source_is_pool_coincidence,
  binding_refused_at_intended_seam,
  row3_stripped_refuses_binding,
  row4_stripped_pool_coincidence_or_refuse
}
import gunbc.compile_clean_diagnostic_policy {
  UnlistedImportBindingSource,
  ListedImport,
  PoolCoincidence,
  DefinerResolvable,
  AmbiguousLeaf
}
import std.optional { Optional, Present, Absent }
import std.types { Bool, Int, NonEmptyStr }

// Per-PR discovery-admitted unit controls for gunbc.declared_import_closure_binding verdict
// predicates (#7835 P1). Pure folds over typed observation/outcome variants — not path-excluded and
// not explicit_witness_admission enrolled.
// binding_refused_at_seam_rejects_unrelated_hard_diagnostic exercises the fold predicate only;
// producer-level hard-diagnostic refusal is tested in cli_run.rs
// unrelated_hard_diagnostic_observation_is_not_runnable_at_producer.

fn class_b_obs(
  binding_source: Optional<UnlistedImportBindingSource>,
  symbol_resolves: Bool,
  blocking_hard_diagnostic_count: Int
) -> DeclaredImportClosureBindingObservation {
  BindingObserved {
    binding_source: binding_source,
    definer_module: "",
    symbol_resolves: symbol_resolves,
    blocking_hard_diagnostic_count: blocking_hard_diagnostic_count
  }
}

fn class_b_pins(
  obs: DeclaredImportClosureBindingObservation,
  listed: Bool,
  pool: Bool,
  seam: Bool
) -> Bool {
  binding_source_is_listed_import(obs: obs) == listed
    && binding_source_is_pool_coincidence(obs: obs) == pool
    && binding_refused_at_intended_seam(obs: obs) == seam
}

fn class_b_pins_present(
  source: UnlistedImportBindingSource,
  symbol_resolves: Bool,
  blocking_hard_diagnostic_count: Int,
  listed: Bool,
  pool: Bool,
  seam: Bool
) -> Bool {
  class_b_pins(
    obs: class_b_obs(
      binding_source: Present { value: source },
      symbol_resolves: symbol_resolves,
      blocking_hard_diagnostic_count: blocking_hard_diagnostic_count
    ),
    listed: listed,
    pool: pool,
    seam: seam
  )
}

fn class_b_listed_misarm(obs: DeclaredImportClosureBindingObservation) -> Bool {
  match class_b_binding_projection(obs: obs) {
    ClassBListedImport => true
    ClassBPoolCoincidence => true
    ClassBSeamRefusal => false
    ClassBOther => false
  }
}

test fn class_b_binding_projection_pins_every_observation_variant() -> Bool {
  class_b_pins(
    obs: BindingNotRunnable { cause: "could-not-measure" as NonEmptyStr },
    listed: false,
    pool: false,
    seam: false
  )
    && class_b_pins(
      obs: class_b_obs(binding_source: Absent, symbol_resolves: true, blocking_hard_diagnostic_count: 0),
      listed: false,
      pool: false,
      seam: false
    )
    && class_b_pins(
      obs: class_b_obs(binding_source: Absent, symbol_resolves: true, blocking_hard_diagnostic_count: 1),
      listed: false,
      pool: false,
      seam: false
    )
    && class_b_pins(
      obs: class_b_obs(binding_source: Absent, symbol_resolves: false, blocking_hard_diagnostic_count: 0),
      listed: false,
      pool: false,
      seam: true
    )
    && class_b_pins(
      obs: class_b_obs(binding_source: Absent, symbol_resolves: false, blocking_hard_diagnostic_count: 1),
      listed: false,
      pool: false,
      seam: false
    )
    && class_b_pins_present(source: ListedImport, symbol_resolves: true, blocking_hard_diagnostic_count: 0, listed: true, pool: false, seam: false)
    && class_b_pins_present(source: ListedImport, symbol_resolves: true, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: ListedImport, symbol_resolves: false, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: true)
    && class_b_pins_present(source: ListedImport, symbol_resolves: false, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: PoolCoincidence, symbol_resolves: true, blocking_hard_diagnostic_count: 0, listed: false, pool: true, seam: false)
    && class_b_pins_present(source: PoolCoincidence, symbol_resolves: true, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: PoolCoincidence, symbol_resolves: false, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: true)
    && class_b_pins_present(source: PoolCoincidence, symbol_resolves: false, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: DefinerResolvable, symbol_resolves: true, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: DefinerResolvable, symbol_resolves: true, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: DefinerResolvable, symbol_resolves: false, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: true)
    && class_b_pins_present(source: DefinerResolvable, symbol_resolves: false, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: AmbiguousLeaf, symbol_resolves: true, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: AmbiguousLeaf, symbol_resolves: true, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
    && class_b_pins_present(source: AmbiguousLeaf, symbol_resolves: false, blocking_hard_diagnostic_count: 0, listed: false, pool: false, seam: true)
    && class_b_pins_present(source: AmbiguousLeaf, symbol_resolves: false, blocking_hard_diagnostic_count: 1, listed: false, pool: false, seam: false)
}

test fn class_b_binding_projection_positive_listed_import_control() -> Bool {
  binding_source_is_listed_import(
    obs: class_b_obs(
      binding_source: Present { value: ListedImport },
      symbol_resolves: true,
      blocking_hard_diagnostic_count: 0
    )
  )
    && !binding_source_is_pool_coincidence(
      obs: class_b_obs(
        binding_source: Present { value: ListedImport },
        symbol_resolves: true,
        blocking_hard_diagnostic_count: 0
      )
    )
    && !binding_refused_at_intended_seam(
      obs: class_b_obs(
        binding_source: Present { value: ListedImport },
        symbol_resolves: true,
        blocking_hard_diagnostic_count: 0
      )
    )
}

test fn class_b_binding_projection_red_misarm_pool_as_listed_disagrees() -> Bool {
  let pool = class_b_obs(
    binding_source: Present { value: PoolCoincidence },
    symbol_resolves: true,
    blocking_hard_diagnostic_count: 0
  )
  class_b_listed_misarm(obs: pool)
    && !binding_source_is_listed_import(obs: pool)
}

test fn binding_refused_at_seam_not_runnable_is_false() -> Bool {
  !binding_refused_at_intended_seam(obs: BindingNotRunnable { cause: "could-not-measure" as NonEmptyStr })
}

test fn binding_refused_at_seam_rejects_unrelated_hard_diagnostic() -> Bool {
  !binding_refused_at_intended_seam(
    obs: BindingObserved {
      binding_source: Absent,
      definer_module: "",
      symbol_resolves: false,
      blocking_hard_diagnostic_count: 1
    }
  )
}

test fn binding_refused_at_seam_accepts_clean_unresolved() -> Bool {
  binding_refused_at_intended_seam(
    obs: BindingObserved {
      binding_source: Absent,
      definer_module: "",
      symbol_resolves: false,
      blocking_hard_diagnostic_count: 0
    }
  )
}

test fn row3_production_refused_is_false() -> Bool {
  !row3_stripped_refuses_binding(
    outcome: ObservationProductionRefused {
      phase: "strip" as NonEmptyStr,
      cause: "setup failed" as NonEmptyStr
    }
  )
}

test fn row3_compile_production_refused_is_false() -> Bool {
  !row3_stripped_refuses_binding(
    outcome: ObservationProductionRefused {
      phase: "compile" as NonEmptyStr,
      cause: "declared-import-closure compile produced no graph" as NonEmptyStr
    }
  )
}

test fn row3_not_runnable_observation_is_false() -> Bool {
  !row3_stripped_refuses_binding(
    outcome: ObservationProduced {
      observation: BindingNotRunnable { cause: "could-not-measure" as NonEmptyStr }
    }
  )
}

test fn row4_production_refused_is_false() -> Bool {
  !row4_stripped_pool_coincidence_or_refuse(
    outcome: ObservationProductionRefused {
      phase: "mktemp" as NonEmptyStr,
      cause: "setup failed" as NonEmptyStr
    }
  )
}

test fn row4_compile_production_refused_is_false() -> Bool {
  !row4_stripped_pool_coincidence_or_refuse(
    outcome: ObservationProductionRefused {
      phase: "compile" as NonEmptyStr,
      cause: "declared-import-closure compile produced no graph" as NonEmptyStr
    }
  )
}

test fn row4_listed_import_on_produced_observation_fails() -> Bool {
  !row4_stripped_pool_coincidence_or_refuse(
    outcome: ObservationProduced {
      observation: BindingObserved {
        binding_source: Present { value: ListedImport },
        definer_module: "v2.extdeps.languages.rust",
        symbol_resolves: true,
        blocking_hard_diagnostic_count: 0
      }
    }
  )
}
