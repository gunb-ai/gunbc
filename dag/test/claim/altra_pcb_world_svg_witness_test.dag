module test.claim.altra_pcb_world_svg_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn synthetic_design_identity() -> std.decl_ref.DeclarationRef {
  std.decl_ref.decl_ref(module_path: "test.claim.altra_pcb_world_svg_witness", decl_name: "synthetic_design_identity")
}

fn world_or_empty() -> product.pcb.world.PcbWorld? {
  match product.altra_motherboard.pcb_world.altra_pcb_world() {
    product.pcb.world.PcbWorldRefused { cause: _ } => none
    product.pcb.world.PartialPcbWorldReady { value: w } => Present { value: w }
    product.pcb.world.AdmittedPcbWorld { value: _ } => none
  }
}

fn scene_or_empty() -> String? {
  match product.altra_motherboard.scene_emission.emit_altra_board_scene() {
    product.pcb.plan_view.PcbSceneEmitted { source: s } => Present { value: s }
    product.pcb.plan_view.PcbSceneEmissionRefused { cause: _ } => none
  }
}

fn count_substring(haystack: String, needle: String) -> Int {
  fold(split(s: haystack, delimiter: needle), init: 0, f: fn(acc, _part) { acc + 1 }) - 1
}

fn synthetic_frame() -> std.coordinate_frame.CoordinateFrameIdentity {
  std.coordinate_frame.coordinate_frame_identity(occurrence: 21)
}

fn synthetic_origin() -> std.affine_space.Point2 {
  std.affine_space.point2(frame: synthetic_frame(), x: 10000, y: 10000)
}

fn synthetic_outline() -> std.orthogonal_geometry.AxisAlignedRectangle2? {
  match std.orthogonal_geometry.axis_aligned_rectangle2(
    min: std.affine_space.point2(frame: synthetic_frame(), x: 0, y: 0),
    max: std.affine_space.point2(frame: synthetic_frame(), x: 100000, y: 80000)
  ) {
    std.orthogonal_geometry.OrthogonalReady { value: r } => Present { value: r }
    std.orthogonal_geometry.OrthogonalRefused { cause: _ } => none
  }
}

fn synthetic_unselected_obligations(ids: List<std.types.NonEmptyStr>) -> List<product.pcb.world.PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [product.pcb.world.PcbComponentObligation {
      identity: id,
      origin: synthetic_origin(),
      cause: product.pcb.world.UnselectedPart { because: "synthetic unselected" },
    }])
  })
}

fn synthetic_missing_document_obligations(ids: List<std.types.NonEmptyStr>) -> List<product.pcb.world.PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [product.pcb.world.PcbComponentObligation {
      identity: id,
      origin: synthetic_origin(),
      cause: product.pcb.world.MissingDocument { what_is_missing: "synthetic document" },
    }])
  })
}

fn world_with_obligations(obs: List<product.pcb.world.PcbComponentObligation>) -> product.pcb.world.PcbWorld? {
  match synthetic_outline() {
    Absent => none
    Present { value: o } =>
      Present {
        value: product.pcb.world.pcb_world(
          design: synthetic_design_identity(),
          electrical: product.pcb.world.PcbElectricalWorld {
            nets: product.pcb.world.capability_pending(what_is_owed: "synthetic nets"),
          },
          physical: product.pcb.world.PcbPhysicalWorld {
            board: product.pcb.world.PcbBoard { frame: synthetic_frame(), outline: o },
            components: [],
            envelope_reads: [],
            obligations: obs,
            attachment_obligations: [],
            functional_obligations: [],
            body_layout: product.pcb.world.PcbBodyLayoutAdmittedOverEstablishedSubsetOnly {
              parts_still_owed: std.types.list_length(items: obs),
            },
            stackup: product.pcb.world.capability_pending(what_is_owed: "synthetic stackup"),
            footprints: product.pcb.world.capability_pending(what_is_owed: "synthetic footprints"),
            pads: product.pcb.world.capability_pending(what_is_owed: "synthetic pads"),
            routes: product.pcb.world.capability_pending(what_is_owed: "synthetic routes"),
          },
          manufacturing: product.pcb.world.PcbManufacturingWorld {
            artifacts: product.pcb.world.capability_pending(what_is_owed: "synthetic artifacts"),
          },
        )
      }
  }
}

fn projected_document(ids: List<std.types.NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_unselected_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match product.pcb.plan_view.emit_pcb_plan_view(c: product.pcb.plan_view.project_pcb_world(w: w)) {
        product.pcb.plan_view.PcbSceneEmitted { source: s } => Present { value: s }
        product.pcb.plan_view.PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

fn projected_missing_document(ids: List<std.types.NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_missing_document_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match product.pcb.plan_view.emit_pcb_plan_view(c: product.pcb.plan_view.project_pcb_world(w: w)) {
        product.pcb.plan_view.PcbSceneEmitted { source: s } => Present { value: s }
        product.pcb.plan_view.PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

fn drop_label(xs: List<std.types.NonEmptyStr>, needle: String) -> List<std.types.NonEmptyStr> {
  fold(xs, init: [], f: fn(acc, x) {
    if (x as String) == needle {
      acc
    } else {
      concat(acc, [x])
    }
  })
}

fn six_channel_design() -> product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
  product.altra_motherboard.minimal_design.AltraMinimalMotherboard {
    intent: product.altra_motherboard.minimal_design.Production,
    memory: product.altra_motherboard.minimal_design.MemoryConfiguration {
      topology: product.altra_motherboard.minimal_design.ActiveDdrTopology {
        populated_channels: [product.altra_motherboard.minimal_design.DdrChannel0, product.altra_motherboard.minimal_design.DdrChannel1, product.altra_motherboard.minimal_design.DdrChannel2, product.altra_motherboard.minimal_design.DdrChannel3, product.altra_motherboard.minimal_design.DdrChannel4, product.altra_motherboard.minimal_design.DdrChannel5],
        positions_per_channel: [product.altra_motherboard.minimal_design.FirstDimmOnChannel],
      },
    },
    pcie_lanes_broken_out: 4,
  }
}

test fn w_the_altra_pcb_world_constructs_as_a_partial_preview() -> Bool {
  match product.altra_motherboard.pcb_world.altra_pcb_world() {
    product.pcb.world.PartialPcbWorldReady { value: _ } => true
    product.pcb.world.AdmittedPcbWorld { value: _ } => false
    product.pcb.world.PcbWorldRefused { cause: _ } => false
  }
}

// THE SOCKET LEFT THE MISSING-DOCUMENT POPULATION AND HAS ITS OWN. It used to be counted as a
// missing document naming "ILM4926", which told a reader to go and find a document by that name.
// ILM4926 is not a document; it is a designation whose vendor and orderable part are unresolved,
// so it is its own cause and its own count. Component missing-document is zero. The board land
// pattern is a commercial-access ATTACHMENT obligation (Customer Connect); attachment causes are
// not folded into pcb_cause_counts or the legend population string.
test fn w_the_world_carries_five_established_twelve_unselected_and_one_attachment_part_unresolved() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = product.pcb.world.pcb_world_physical(w: w)
      product.pcb.world.pcb_component_count(p: p) == 5
        && product.pcb.world.pcb_obligation_count(p: p) == 12
        && product.pcb.world.pcb_unselected_part_count(p: p) == 11
        && product.pcb.world.pcb_named_attachment_part_unresolved_count(p: p) == 1
        && product.pcb.world.pcb_missing_document_count(p: p) == 0
        && product.pcb.world.pcb_commercial_access_count(p: p) == 0
        && product.pcb.world.pcb_legal_carriage_count(p: p) == 0
        && product.pcb.world.pcb_population_count(p: p) == 17
  }
}

test fn w_the_reference_board_body_layout_is_the_established_subset_with_twelve_parts_owed() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.pcb.world.pcb_body_layout(p: product.pcb.world.pcb_world_physical(w: w)) {
        product.pcb.world.PcbBodyLayoutAdmittedOverEveryRequiredPart => false
        product.pcb.world.PcbBodyLayoutAdmittedOverEstablishedSubsetOnly { parts_still_owed: n } => n == 12
        product.pcb.world.PcbBodyLayoutRefusedOverEstablishedSubset { parts_still_owed: _, causes: _ } => false
        product.pcb.world.PcbBodyLayoutRefusedOverCompletePopulation { causes: _ } => false
      }
  }
}

test fn w_unmodeled_capabilities_are_pending_with_a_nonempty_obligation() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = product.pcb.world.pcb_world_physical(w: w)
      match p.routes {
        product.pcb.world.CapabilityRefused { cause: _ } => false
        product.pcb.world.CapabilityEstablished { authority: _ } => false
        product.pcb.world.CapabilityPending { owed: o } =>
          (o.first.what_is_owed as String) != ""
            && match w.electrical.nets {
              product.pcb.world.CapabilityRefused { cause: _ } => false
              product.pcb.world.CapabilityEstablished { authority: _ } => false
              product.pcb.world.CapabilityPending { owed: n } => (n.first.what_is_owed as String) != ""
            }
            && match w.manufacturing.artifacts {
              product.pcb.world.CapabilityRefused { cause: _ } => false
              product.pcb.world.CapabilityEstablished { authority: _ } => false
              product.pcb.world.CapabilityPending { owed: a } => (a.first.what_is_owed as String) != ""
            }
            && match p.stackup {
              product.pcb.world.CapabilityRefused { cause: _ } => false
              product.pcb.world.CapabilityEstablished { authority: _ } => false
              product.pcb.world.CapabilityPending { owed: s } => (s.first.what_is_owed as String) != ""
            }
      }
  }
}

test fn w_admit_pcb_world_refuses_the_preview_while_capabilities_are_pending() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.altra_motherboard.pcb_world.admit_pcb_world(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), w: w) {
        product.pcb.world.PartialPcbWorldReady { value: _ } => false
        product.pcb.world.AdmittedPcbWorld { value: _ } => false
        product.pcb.world.PcbWorldRefused { cause: c } =>
          match c {
            product.pcb.world.PcbCapabilityStillPending { capability: cap } => (cap as String) == "stackup"
            product.pcb.world.PcbCapabilityRefused { capability: _, cause: _ } => false
            product.pcb.world.PcbDesignPlanUnavailable { only_available: _ } => false
            product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            product.pcb.world.PcbPlacementNotAdmitted => false
            product.pcb.world.PcbBoardOutlineRefused { cause: _ } => false
            product.pcb.world.PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}

test fn w_altra_pcb_world_for_refuses_a_design_without_a_plan() -> Bool {
  match product.altra_motherboard.pcb_world.altra_pcb_world_for(d: six_channel_design()) {
    product.pcb.world.PartialPcbWorldReady { value: _ } => false
    product.pcb.world.AdmittedPcbWorld { value: _ } => false
    product.pcb.world.PcbWorldRefused { cause: c } =>
      match c {
        product.pcb.world.PcbDesignPlanUnavailable { only_available: r } =>
          std.decl_ref.declaration_ref_eq(a: r, b: product.altra_motherboard.placement.altra_1p_minimum_ref())
        product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
        product.pcb.world.PcbCapabilityStillPending { capability: _ } => false
        product.pcb.world.PcbCapabilityRefused { capability: _, cause: _ } => false
        product.pcb.world.PcbPlacementNotAdmitted => false
        product.pcb.world.PcbBoardOutlineRefused { cause: _ } => false
        product.pcb.world.PcbOutlineCopiedFromCitedForeignBoard => false
      }
  }
}

test fn w_the_world_carries_the_plan_design_identity() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.altra_motherboard.placement.altra_reference_plan() {
        std.orthogonal_geometry.OrthogonalRefused { cause: _ } => false
        std.orthogonal_geometry.OrthogonalReady { value: plan } =>
          std.decl_ref.declaration_ref_eq(a: product.pcb.world.pcb_world_design(w: w), b: plan.design)
            && std.decl_ref.declaration_ref_eq(a: plan.design, b: product.altra_motherboard.placement.altra_1p_minimum_ref())
      }
  }
}

test fn w_the_emitted_scene_is_non_empty_and_opens_the_cited_root() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      s != "" && string_contains(s: s, pattern: "<svg") && string_contains(s: s, pattern: "pcb-world-scene") && string_contains(s: s, pattern: "viewBox=\"0 0 305000 267000\"") && string_contains(s: s, pattern: "http://www.w3.org/2000/svg")
  }
}

test fn w_the_authored_outline_is_not_the_cited_mt_jade_board() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      !product.altra_motherboard.pcb_world.outline_copies_mt_jade_reference(o: product.pcb.world.pcb_world_physical(w: w).board.outline)
  }
}

test fn w_the_processor_package_renders_at_cited_body_dimensions() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: concat("width=\"", to_string(std.measure.micrometer_count(m: extdeps.cpu.ampere_altra_package.altra_package_body_width)))) && string_contains(s: s, pattern: concat("height=\"", to_string(std.measure.micrometer_count(m: extdeps.cpu.ampere_altra_package.altra_package_body_height)))) && string_contains(s: s, pattern: "processor_package")
  }
}

// THE SOCKET IS NEITHER A MISSING DOCUMENT NOR A PLAIN UNSELECTED PART, and this witness used to
// assert the first of those. The scene said "missing document: ILM4926", which sends a reader to
// look for a document with that name; no such document is missing. What is unresolved is which
// vendor part the designation buys. The marker now carries the designation AND the real reason,
// and both are asserted here so neither can be dropped back into the other.
test fn w_the_socket_names_its_designation_and_its_real_unresolved_reason() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "class=\"pcb-component-named-attachment-type-part-unresolved\">cpu_socket<")
        && string_contains(s: s, pattern: concat(ilm4926.designator as String, " part unresolved:"))
        && !string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">cpu_socket<")
        && !string_contains(s: s, pattern: "class=\"pcb-component-missing-document\">cpu_socket<")
        && !string_contains(s: s, pattern: concat("(missing document:", ilm4926.designator as String))
  }
}

test fn w_unselected_roles_render_as_unselected_part() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">boot_eeprom<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">nvme_conn<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">dimm_ddr0_slot0<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">debug_hdr<")
        && !string_contains(s: s, pattern: "class=\"pcb-component-missing-document\">boot_eeprom<")
  }
}

// COUNTED ON THE CLASS ATTRIBUTE, NOT THE BARE NAME. These counts previously matched the class
// name anywhere in the document, which was an accurate element count only because nothing else
// mentioned those names. The emitted stylesheet mentions every one of them, so the old needle
// started counting its own selectors -- a proxy that silently stopped measuring elements. The
// attribute form counts elements, which is what the claim was always about.
test fn w_subset_bodies_are_not_drawn_as_checked() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      count_substring(haystack: s, needle: "class=\"pcb-component-established\"") == 0
        && count_substring(haystack: s, needle: "class=\"pcb-component-subset-body\"") == 5
        && count_substring(haystack: s, needle: "class=\"pcb-component-unselected-part\"") == 11
        && count_substring(haystack: s, needle: "class=\"pcb-component-named-attachment-type-part-unresolved\"") == 1
        && count_substring(haystack: s, needle: "class=\"pcb-component-missing-document\"") == 0
        && string_contains(s: s, pattern: "body layout admitted over established subset only; 12 parts owed")
        && !string_contains(s: s, pattern: "body layout checked over established subset only")
  }
}

test fn w_the_legend_states_the_cause_populations() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } => string_contains(s: s, pattern: "5 established / 11 unselected / 0 missing-document / 0 commercial-access / 0 legal-carriage / 0 drawing-must-be-read / 1 attachment-part-unresolved / 7 unrealized-function — body layout admitted over established subset only; 12 parts owed")
  }
}

test fn w_every_world_component_identity_appears_in_the_scene() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let physical = product.pcb.world.pcb_world_physical(w: w)
      match scene_or_empty() {
        Absent => false
        Present { value: svg } =>
          fold(physical.components, init: true, f: fn(acc, c) {
            acc && string_contains(s: svg, pattern: c.identity as String)
          }) && fold(physical.obligations, init: true, f: fn(acc, o) {
            acc && string_contains(s: svg, pattern: o.identity as String)
          })
      }
  }
}

// THE BOARD LAND PATTERN DROPPED OUT OF THIS LIST ON 2026-08-23 AND THAT IS THE CORRECT OUTCOME.
// The label is emitted per OPEN obligation, so a resolved layer has no label to find; asserting
// its presence would now be asserting that a solved problem is still unsolved. The two layers that
// remain open keep their assertions, and the count conjunct is what stops this from silently
// becoming weaker: it ties the number of emitted labels to the obligation population rather than
// to a list someone remembered to update, so a layer resolving or regressing moves both together.
test fn w_mounting_and_socket_attachment_obligations_appear() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match scene_or_empty() {
        Absent => false
        Present { value: s } =>
          string_contains(s: s, pattern: "attachment: mounting") && string_contains(s: s, pattern: "attachment: socket") && !string_contains(s: s, pattern: "attachment: board land pattern") && count_substring(haystack: s, needle: "class=\"pcb-label-attachment-obligation\"") == product.pcb.world.pcb_attachment_obligation_count(p: product.pcb.world.pcb_world_physical(w: w))
      }
  }
}

// THE BOARD LAND PATTERN IS NO LONGER AN OPEN OBLIGATION, AND THE WITNESS INVERTED RATHER THAN
// WEAKENED. It asserted the layer sat behind a commercial gate, because its only route ran through
// Ampere Customer Connect. The socket vendor supplied the geometry on 2026-08-23, so the layer is
// established, its carriage is decided, subject_blocker returns Absent for it, and it drops out of
// the obligation list entirely.
//
// ASSERTING ITS ABSENCE ALONE WOULD BE A WEAKER TEST THAN THE ONE IT REPLACES, so the second half
// is what keeps it honest: obligations still EXIST for other layers, and the fold that produced
// this one still discriminates causes. Without that conjunct this witness would also pass if
// attachment_obligations were empty for a reason having nothing to do with the land pattern --
// an empty-observation narrow, which is the failure mode DESIGN names as strictly worse than the
// widen it forbids, because a widen is merely expensive and a narrow is silently uncovered.
test fn w_the_board_land_pattern_is_no_longer_an_open_obligation() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let obligations = product.pcb.world.pcb_world_physical(w: w).attachment_obligations
      let land_still_open = fold(obligations, init: false, f: fn(acc, a) {
        acc || (a.layer as String) == "board land pattern"
      })
      !land_still_open && std.types.list_length(items: obligations) > 0
  }
}

test fn w_plan_view_unselected_marker_count_follows_population() -> Bool {
  match projected_document(ids: ["m0", "m1", "m2", "m3"]) {
    Absent => false
    Present { value: four_doc } =>
      match projected_document(ids: ["m0", "m1", "m2", "m3", "m4", "m5"]) {
        Absent => false
        Present { value: six_doc } =>
          count_substring(haystack: four_doc, needle: "class=\"pcb-component-unselected-part\"") == 4 && count_substring(haystack: six_doc, needle: "class=\"pcb-component-unselected-part\"") == 6
      }
  }
}

test fn w_plan_view_missing_document_count_follows_population() -> Bool {
  match projected_missing_document(ids: ["p0", "p1"]) {
    Absent => false
    Present { value: two_doc } =>
      match projected_missing_document(ids: ["p0", "p1", "p2"]) {
        Absent => false
        Present { value: three_doc } =>
          count_substring(haystack: two_doc, needle: "class=\"pcb-component-missing-document\"") == 2
            && count_substring(haystack: three_doc, needle: "class=\"pcb-component-missing-document\"") == 3
      }
  }
}

test fn w_the_projection_matches_the_emission_entry() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.altra_motherboard.scene_emission.emit_altra_board_scene() {
        product.pcb.plan_view.PcbSceneEmitted { source: from_entry } =>
          match product.pcb.plan_view.project_pcb_world(w: w) {
            product.pcb.plan_view.PcbSceneReady { value: scene } =>
              product.pcb.world.pcb_worlds_share_design(a: w, b: scene.world)
                && scene.document == from_entry
                && string_contains(
                  s: from_entry,
                  pattern: concat("design identity: ", std.decl_ref.declaration_ref_display_key(ref: product.pcb.world.pcb_world_design(w: w))),
                )
                && !string_contains(s: from_entry, pattern: "board revision")
                && !string_contains(s: from_entry, pattern: "Mechanical Data")
                && !string_contains(s: from_entry, pattern: "verified provenance")
            product.pcb.plan_view.PcbSceneRefused { cause: _ } => false
          }
        product.pcb.plan_view.PcbSceneEmissionRefused { cause: _ } => false
      }
  }
}

test fn w_established_envelopes_name_the_declaration_read_not_a_datasheet_sentence() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "read: ")
        && string_contains(s: s, pattern: "extdeps.programmable_logic.ice40.subject::ice40_tq144_package")
        && string_contains(s: s, pattern: "extdeps.cpu.ampere_altra_package::altra_package_body_width")
        && string_contains(s: s, pattern: "extdeps.network.ti_dp83867::dp83867_rgz0048b_body")
        && string_contains(s: s, pattern: "extdeps.power.ti_tps53688::tps53688_rsb0040a_body")
        && string_contains(s: s, pattern: "extdeps.power.ti_tps3808::tps3808_dbv0006a_body")
        && !string_contains(s: s, pattern: "Mechanical Data")
        && !string_contains(s: s, pattern: "verified")
  }
}

test fn w_the_two_envelope_reads_are_distinct_declarations() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let reads = product.pcb.world.pcb_envelope_reads(p: product.pcb.world.pcb_world_physical(w: w))
      std.types.list_length(items: reads) == 5
        && fold(reads, init: true, f: fn(ok, r) {
          ok && fold(reads, init: true, f: fn(inner, q) {
            inner && ((r.identity as String) == (q.identity as String) || !std.decl_ref.declaration_ref_eq(a: r.source, b: q.source))
          })
        })
  }
}

test fn w_dropping_an_envelope_read_from_the_document_is_detected() -> Bool {
