      )
      match product.pcb.scene.first_unrepresented_scene_identity(scene: scene, represented: represented) {
        Absent => false
        Present { value: id } => (id as String) == "extdeps.cpu.ampere_altra_package::altra_package_body_width"
      }
  }
}

