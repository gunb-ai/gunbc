    && std.measure.micrometer_count(m: product.pcb.plan_view.attachment_label_step) > 0
}

// THE DISCRIMINATING CONTROL FOR THE CAPABILITY GATE. The world below is the real one with every
// capability standing replaced by CapabilityRefused, which is the mutation that used to admit it:
// the old projection answered Absent for a refused capability, so an all-refused world read as a
// world with nothing outstanding and fell through to the placement check. That it did not in fact
// reach AdmittedPcbWorld was an accident of placement failing for an unrelated reason, and an
// accident is not a wall. This asserts the refusal is produced BY the capability gate -- naming
// the first refused capability -- rather than by whatever else happens to be broken.
fn all_capabilities_refused(w: product.pcb.world.PcbWorld) -> product.pcb.world.PcbWorld {
  let p = product.pcb.world.pcb_world_physical(w: w)
  product.pcb.world.pcb_world(
    design: product.pcb.world.pcb_world_design(w: w),
    electrical: product.pcb.world.PcbElectricalWorld { nets: product.pcb.world.CapabilityRefused { cause: "planted refusal: nets" } },
    physical: product.pcb.world.PcbPhysicalWorld {
      board: p.board,
      components: p.components,
      envelope_reads: p.envelope_reads,
      obligations: p.obligations,
      attachment_obligations: p.attachment_obligations,
      functional_obligations: p.functional_obligations,
      body_layout: p.body_layout,
      stackup: product.pcb.world.CapabilityRefused { cause: "planted refusal: stackup" },
      footprints: product.pcb.world.CapabilityRefused { cause: "planted refusal: footprints" },
      pads: product.pcb.world.CapabilityRefused { cause: "planted refusal: pads" },
      routes: product.pcb.world.CapabilityRefused { cause: "planted refusal: routes" },
    },
    manufacturing: product.pcb.world.PcbManufacturingWorld {
      artifacts: product.pcb.world.CapabilityRefused { cause: "planted refusal: artifacts" },
    },
  )
}

test fn w_a_world_whose_capabilities_are_all_refused_is_not_admitted() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.altra_motherboard.pcb_world.admit_pcb_world(d: product.altra_motherboard.minimal_design.altra_1p_minimum, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), w: all_capabilities_refused(w: w)) {
        product.pcb.world.PartialPcbWorldReady { value: _ } => false
        product.pcb.world.AdmittedPcbWorld { value: _ } => false
        product.pcb.world.PcbWorldRefused { cause: c } =>
          match c {
            product.pcb.world.PcbCapabilityRefused { capability: cap, cause: why } =>
              (cap as String) == "stackup" && (why as String) == "planted refusal: stackup"
            product.pcb.world.PcbCapabilityStillPending { capability: _ } => false
            product.pcb.world.PcbDesignPlanUnavailable { only_available: _ } => false
            product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            product.pcb.world.PcbPlacementNotAdmitted => false
            product.pcb.world.PcbBoardOutlineRefused { cause: _ } => false
            product.pcb.world.PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}

// AND THE PROJECTION ITSELF, asserted directly rather than only through admission, so that a
// future admission path cannot quietly stop consulting it without a witness going red.
test fn w_a_refused_capability_is_reported_as_outstanding() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match product.pcb.world.first_unsettled_capability(w: all_capabilities_refused(w: w)) {
        Absent => false
        Present { value: r } =>
          match r {
            product.pcb.world.PcbCapabilityRefused { capability: cap, cause: _ } => (cap as String) == "stackup"
            product.pcb.world.PcbCapabilityStillPending { capability: _ } => false
            product.pcb.world.PcbDesignPlanUnavailable { only_available: _ } => false
            product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            product.pcb.world.PcbPlacementNotAdmitted => false
            product.pcb.world.PcbBoardOutlineRefused { cause: _ } => false
            product.pcb.world.PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}

// THE DISCRIMINATING CONTROL FOR THE REFUSED SUBSET. This is the exact world the old projection
// hid: an established subset whose geometry REFUSED, with parts still owed. The subset arm carried
// the nested PhysicalAdmission and the projection bound it to `_`, so the count of what was not
// examined survived and the verdict on what WAS examined was discarded -- two colliding bodies
// rendered as "checked over established subset only", which reads as incomplete but clean. It was
// not clean; the only geometry this board had actually performed had failed. Both halves are
// asserted: the refusal reaches the world, and the word that used to hide it is absent.
fn refused_subset_standing() -> product.altra_motherboard.placement.BoardBodyLayoutStanding {
  product.altra_motherboard.placement.BodyLayoutCheckedOverEstablishedSubsetOnly {
    parts_still_owed: 13,
    geometry: product.pcb.physical.PhysicallyRefused {
      causes: product.pcb.physical.PhysicalRefusalSet {
        first: product.pcb.physical.PlacementsOverlap { first: "planted_a", second: "planted_b" },
        rest: [],
      },
    },
  }
}

test fn w_a_refused_subset_does_not_project_as_a_checked_subset() -> Bool {
  match product.altra_motherboard.pcb_world.project_body_layout(s: refused_subset_standing()) {
    product.pcb.world.PcbBodyLayoutRefusedOverEstablishedSubset { parts_still_owed: n, causes: cs } =>
      n == 13 && match cs.first {
        product.pcb.physical.PlacementsOverlap { first: a, second: b } =>
          (a as String) == "planted_a" && (b as String) == "planted_b"
        product.pcb.physical.BoardFrameUnregistered { frame: _ } => false
        product.pcb.physical.BoardFrameRegistrationRefused { cause: _ } => false
        product.pcb.physical.BoardFrameIsNotSubMillimetre { frame: _ } => false
        product.pcb.physical.PlacementFrameDiffersFromBoard { placement: _ } => false
        product.pcb.physical.PlacementExtentNotPositive { placement: _ } => false
        product.pcb.physical.PlacementNotWithinOutline { placement: _ } => false
        product.pcb.physical.PlacementIdentityRepeated { placement: _ } => false
      }
    product.pcb.world.PcbBodyLayoutAdmittedOverEstablishedSubsetOnly { parts_still_owed: _ } => false
    product.pcb.world.PcbBodyLayoutAdmittedOverEveryRequiredPart => false
    product.pcb.world.PcbBodyLayoutRefusedOverCompletePopulation { causes: _ } => false
  }
}

// MOVING CLOCKS OFF THE PHYSICAL ROSTER AND ADMITTING CANDIDATE BODY ENVELOPES DID NOT STOP
// REPORTING UNESTABLISHED FUNCTIONS. Clocks have no providers; host PHY, power stage, and power
// good have cited bodies but candidate-only justifications — all must reach the scene as functional
// obligations rather than reading as geometrically established connectivity or control.
test fn w_unestablished_functions_reach_the_scene_including_candidate_body_providers() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      product.pcb.world.pcb_functional_obligation_count(p: product.pcb.world.pcb_world_physical(w: w)) == 7
        && match scene_or_empty() {
             Absent => false
             Present { value: s } =>
               string_contains(s: s, pattern: "function unrealized: clock reference generation")
                 && string_contains(s: s, pattern: "function unrealized: clock reference distribution")
                 && string_contains(s: s, pattern: "function unrealized: host network connectivity")
                 && string_contains(s: s, pattern: "function unrealized: processor power stage control")
                 && string_contains(s: s, pattern: "function unrealized: processor power good supervision")
                 && string_contains(s: s, pattern: "function unrealized: management network connectivity")
                 && string_contains(s: s, pattern: "function unrealized: processor rail enable sequencing")
           }
  }
}

// AND CLOCKS ARE NOT COMPONENTS
// "fixed" the missing clock parts by re-adding the roles. No planned component fills a clock
// function, so nothing in the geometric population claims a clock device exists.
test fn w_no_clock_device_appears_in_the_physical_population() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      !string_contains(s: s, pattern: "clock_gen")
        && !string_contains(s: s, pattern: "clock_source<")
        && !string_contains(s: s, pattern: "clock_fanout<")
  }
}

// THE DOCUMENT CARRIES ITS OWN PRESENTATION. Without this the emitted SVG was semantically
// complete and visually unreadable: class names with no sizes, rendered at a user agent default
// inside a coordinate space measured in micrometres. A viewer had to supply a stylesheet from
// outside, which means the artifact was not self-contained and two people looking at the same
// emission could see different things. The sizes are asserted against the typed rows rather than
// spelled again here, so editing a size cannot leave this witness agreeing with a stale number.
test fn w_the_emitted_document_carries_its_own_type_sizing() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "<style>")
        && string_contains(s: s, pattern: concat("font-size:", concat(to_string(std.measure.micrometer_count(m: product.pcb.plan_view.label_type_size)), "px")))
        && string_contains(s: s, pattern: concat("font-size:", concat(to_string(std.measure.micrometer_count(m: product.pcb.plan_view.cause_type_size)), "px")))
        && string_contains(s: s, pattern: ".pcb-obligation-cause")
  }
}

// AND NO SELECTOR SURVIVED THE TEXT ESCAPE MANGLED. The style content is emitted through the
// medium's ordinary escape, so a child combinator or an ampersand would arrive as an entity and
// the rule would be silently dropped -- present in the document, matching nothing. This asserts
// the escape did not fire, which is the failure that looks like success.
test fn w_no_style_selector_was_escaped() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      !string_contains(s: s, pattern: "&gt;")
        && !string_contains(s: s, pattern: "&amp;")
        && !string_contains(s: s, pattern: "&lt;/style")
  }
}

// THE SECOND UNREALIZED FUNCTION SITS BELOW THE FIRST ONE'S REASON LINE, asserted on the emitted
// coordinate rather than on the constants. An earlier version of this witness compared the label
// step against the cause drop, which is a fact about two data rows and stays true no matter what
// the fold does with them -- it passed with the defect reinstated, which makes it evidence that
// cannot fail. This derives the expected y for the second functional label from the same rows the
// emitter uses and looks for it attached to that label in the document, so reverting the fold to
// advance by one moves the label to a different coordinate and turns this red.
fn expected_second_function_label() -> String {
  match world_or_empty() {
    Absent => ""
    Present { value: w } =>
      let attachments = product.pcb.world.pcb_attachment_obligation_count(p: product.pcb.world.pcb_world_physical(w: w))
      let y = std.measure.micrometer_count(m: product.pcb.plan_view.attachment_label_base) + ((attachments + 2) * std.measure.micrometer_count(m: product.pcb.plan_view.attachment_label_step))
      concat("y=\"", concat(to_string(y), "\" class=\"pcb-label-functional-obligation\">function unrealized: clock reference distribution"))
  }
}

test fn w_the_second_function_label_clears_the_first_ones_cause_line() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      expected_second_function_label() != ""
        && string_contains(s: s, pattern: expected_second_function_label())
  }
}
