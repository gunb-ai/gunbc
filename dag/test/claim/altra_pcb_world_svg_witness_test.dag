module test.claim.altra_pcb_world_svg_witness

import std.types { Bool, String, NonEmptyStr, List }
import std.integer { Int }
import std.measure { micrometer_count }
import std.coordinate_frame { CoordinateFrameIdentity, coordinate_frame_identity }
import std.affine_space { Point2, point2 }
import std.orthogonal_geometry {
  AxisAlignedRectangle2,
  OrthogonalReady,
  OrthogonalRefused,
  axis_aligned_rectangle2,
}
import product.pcb.world {
  PcbWorld,
  PcbWorldIdentity,
  PcbWorldReady,
  PcbWorldRefused,
  PcbSourceDesign,
  PcbBoard,
  PcbPhysicalWorld,
  PcbElectricalWorld,
  PcbManufacturingWorld,
  PcbComponentObligation,
  AuthorityUnresolved,
  PatternOutstanding,
  pcb_world,
  pcb_world_physical,
  pcb_component_count,
  pcb_obligation_count,
  pcb_population_count,
  pcb_attachment_obligation_count,
  pcb_pattern_outstanding_count,
  pcb_unfilled_count,
  pcb_type_named_count,
  pcb_selection_never_attempted_count,
  pcb_access_refused_count,
  pcb_justification_count,
  pcb_justification_precedent_count,
  pcb_justification_outstanding_count,
}
import product.pcb.plan_view {
  PcbSceneEmitted,
  PcbSceneEmissionRefused,
  PcbSceneReady,
  PcbSceneRefused,
  project_pcb_world,
  emit_pcb_plan_view,
  first_unrepresented_world_identity,
}
import product.altra_motherboard.pcb_world { altra_pcb_world }
import product.altra_motherboard.scene_emission { emit_altra_board_scene }
import product.altra_motherboard.placement {
  channel_indices,
  required_roles,
}
import product.altra_motherboard.minimal_design {
  AltraMinimalMotherboard,
  MemoryConfiguration,
  Production,
  FourChannels,
  SixChannels,
  altra_1p_minimum,
}
import extdeps.cpu.ampere_altra_package {
  altra_package_body_width,
  altra_package_body_height,
}
import extdeps.land_pattern.types { VendorPatternNotEstablished }
import extdeps.power.ti_tps3808 { tps3808g01dbvr }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data synthetic_world_identity: PcbWorldIdentity = "synthetic-plan-view" as PcbWorldIdentity

fn world_or_empty() -> PcbWorld? {
  match altra_pcb_world() {
    PcbWorldRefused { cause: _ } => none
    PcbWorldReady { value: w } => Present { value: w }
  }
}

fn scene_or_empty() -> String? {
  match emit_altra_board_scene() {
    PcbSceneEmitted { source: s } => Present { value: s }
    PcbSceneEmissionRefused { cause: _ } => none
  }
}

fn count_substring(haystack: String, needle: String) -> Int {
  fold(split(s: haystack, delimiter: needle), init: 0, f: fn(acc, _part) { acc + 1 }) - 1
}

fn synthetic_frame() -> CoordinateFrameIdentity {
  coordinate_frame_identity(occurrence: 21)
}

fn synthetic_origin() -> Point2 {
  point2(frame: synthetic_frame(), x: 10000, y: 10000)
}

fn synthetic_outline() -> AxisAlignedRectangle2? {
  match axis_aligned_rectangle2(
    min: point2(frame: synthetic_frame(), x: 0, y: 0),
    max: point2(frame: synthetic_frame(), x: 100000, y: 80000)
  ) {
    OrthogonalReady { value: r } => Present { value: r }
    OrthogonalRefused { cause: _ } => none
  }
}

fn synthetic_unfilled_obligations(ids: List<NonEmptyStr>) -> List<PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [PcbComponentObligation {
      identity: id,
      role: "slot",
      origin: synthetic_origin(),
      standing: AuthorityUnresolved { because: "synthetic" },
    }])
  })
}

fn synthetic_pattern_outstanding_obligations(ids: List<NonEmptyStr>) -> List<PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [PcbComponentObligation {
      identity: id,
      role: "slot",
      origin: synthetic_origin(),
      standing: PatternOutstanding {
        standing: VendorPatternNotEstablished { what_is_missing: "synthetic hole pattern" },
      },
    }])
  })
}

fn world_with_obligations(obs: List<PcbComponentObligation>) -> PcbWorld? {
  match synthetic_outline() {
    Absent => none
    Present { value: o } =>
      Present {
        value: pcb_world(
          identity: synthetic_world_identity,
          source_design: PcbSourceDesign { subject: "synthetic" },
          electrical: PcbElectricalWorld { nets: [] },
          physical: PcbPhysicalWorld {
            board: PcbBoard { frame: synthetic_frame(), outline: o },
            stackup: [],
            components: [],
            footprints: [],
            pads: [],
            holes: [],
            routes: [],
            copper_regions: [],
            keepouts: [],
            obligations: obs,
            attachment_obligations: [],
            justifications: [],
          },
          manufacturing: PcbManufacturingWorld { artifacts: [] },
        )
      }
  }
}

fn projected_document(ids: List<NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_unfilled_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match emit_pcb_plan_view(c: project_pcb_world(w: w)) {
        PcbSceneEmitted { source: s } => Present { value: s }
        PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

fn projected_pattern_outstanding_document(ids: List<NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_pattern_outstanding_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match emit_pcb_plan_view(c: project_pcb_world(w: w)) {
        PcbSceneEmitted { source: s } => Present { value: s }
        PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

test fn w_the_altra_pcb_world_constructs() -> Bool {
  match world_or_empty() {
    Present { value: _ } => true
    Absent => false
  }
}

test fn w_the_world_carries_six_established_four_pattern_outstanding_one_type_named_and_four_unfilled() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      pcb_component_count(p: p) == 6
        && pcb_obligation_count(p: p) == 9
        && pcb_pattern_outstanding_count(p: p) == 4
        && pcb_type_named_count(p: p) == 1
        && pcb_unfilled_count(p: p) == 4
        && pcb_selection_never_attempted_count(p: p) == 0
        && pcb_access_refused_count(p: p) == 4
        && pcb_justification_count(p: p) == pcb_population_count(p: p)
        && pcb_justification_precedent_count(p: p) == 1
        && pcb_justification_outstanding_count(p: p) == 14
  }
}

test fn w_the_emitted_scene_is_non_empty_and_opens_the_cited_root() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      s != "" && string_contains(s: s, pattern: "<svg") && string_contains(s: s, pattern: "pcb-world-scene") && string_contains(s: s, pattern: "viewBox=\"0 0 305000 267000\"") && string_contains(s: s, pattern: "http://www.w3.org/2000/svg")
  }
}

test fn w_the_processor_package_renders_at_cited_body_dimensions() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: concat("width=\"", to_string(micrometer_count(m: altra_package_body_width)))) && string_contains(s: s, pattern: concat("height=\"", to_string(micrometer_count(m: altra_package_body_height)))) && string_contains(s: s, pattern: "processor_package")
  }
}

test fn w_the_socket_is_type_named_not_a_body_rectangle() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "cpu_socket (type named:ILM4926")
        && string_contains(s: s, pattern: "pcb-component-type-named")
        && !string_contains(s: s, pattern: "cpu_socket (selection never attempted")
        && !string_contains(s: s, pattern: "cpu_socket</text>")
  }
}

test fn w_the_storage_endpoint_is_access_refused_not_never_attempted() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "nvme_conn (access refused") && !string_contains(s: s, pattern: "nvme_conn (selection never attempted")
  }
}

test fn w_dimm_slots_are_pattern_outstanding_not_established_and_not_unfilled() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "dimm_slot_0 (pattern outstanding")
        && string_contains(s: s, pattern: "dimm_slot_3 (pattern outstanding")
        && string_contains(s: s, pattern: "pcb-component-pattern-outstanding")
        && !string_contains(s: s, pattern: "dimm_slot_0 (obligation")
        && !string_contains(s: s, pattern: "dimm_slot_0 (selection never attempted")
        && !string_contains(s: s, pattern: "dimm_slot_0 (access refused")
        && !string_contains(s: s, pattern: "dimm_slot_0</text>")
  }
}

test fn w_access_refused_roles_render_as_access_refused() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "boot_eeprom (access refused")
        && string_contains(s: s, pattern: "spi_nor (access refused")
        && string_contains(s: s, pattern: "debug_hdr (access refused")
        && string_contains(s: s, pattern: "nvme_conn (access refused")
  }
}

test fn w_established_components_use_the_established_class() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      count_substring(haystack: s, needle: "pcb-component-established") == 6
        && count_substring(haystack: s, needle: "pcb-component-pattern-outstanding") == 4
        && count_substring(haystack: s, needle: "pcb-component-type-named") == 1
        && count_substring(haystack: s, needle: "pcb-component-obligation") == 4
  }
}

test fn w_the_legend_states_the_three_populations() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } => string_contains(s: s, pattern: "6 established / 4 pattern-outstanding / 1 type-named / 4 unfilled")
  }
}

test fn w_the_reset_controller_renders_at_the_vendor_max_outline() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "reset_ctl")
        && string_contains(s: s, pattern: concat("width=\"", to_string(micrometer_count(m: tps3808g01dbvr.outline.body_width_max))))
        && string_contains(s: s, pattern: concat("height=\"", to_string(micrometer_count(m: tps3808g01dbvr.outline.body_length_max))))
  }
}

test fn w_every_world_component_identity_appears_in_the_scene() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let physical = pcb_world_physical(w: w)
      match scene_or_empty() {
        Absent => false
        Present { value: svg } =>
          fold(physical.components, init: true, f: fn(acc, c) {
            acc && string_contains(s: svg, pattern: c.identity as String)
          }) && fold(physical.obligations, init: true, f: fn(acc, o) {
            acc && string_contains(s: svg, pattern: o.identity as String)
          })
      }
  }
}

test fn w_mounting_and_socket_attachment_obligations_appear() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match scene_or_empty() {
        Absent => false
        Present { value: s } =>
          string_contains(s: s, pattern: "attachment: mounting") && string_contains(s: s, pattern: "attachment: socket") && count_substring(haystack: s, needle: "pcb-label-attachment-obligation") == pcb_attachment_obligation_count(p: pcb_world_physical(w: w))
      }
  }
}

test fn w_six_channels_requires_more_roles_than_four_without_touching_the_renderer() -> Bool {
  let four = channel_indices(c: FourChannels)
  let six = channel_indices(c: SixChannels)
  let four_roles = required_roles(d: altra_1p_minimum)
  let six_design = AltraMinimalMotherboard {
    intent: Production,
    memory: MemoryConfiguration { channels: SixChannels, dimms_per_channel: 1 },
    pcie_lanes_broken_out: 4,
  }
  let six_roles = required_roles(d: six_design)
  length(six) > length(four) && length(six_roles) > length(four_roles)
}

test fn w_plan_view_pattern_outstanding_count_follows_population() -> Bool {
  match projected_pattern_outstanding_document(ids: ["p0", "p1"]) {
    Absent => false
    Present { value: two_doc } =>
      match projected_pattern_outstanding_document(ids: ["p0", "p1", "p2"]) {
        Absent => false
        Present { value: three_doc } =>
          count_substring(haystack: two_doc, needle: "pcb-component-pattern-outstanding") == 2
            && count_substring(haystack: three_doc, needle: "pcb-component-pattern-outstanding") == 3
            && count_substring(haystack: two_doc, needle: "pcb-component-obligation") == 0
      }
  }
}

test fn w_plan_view_unfilled_marker_count_follows_population() -> Bool {
  match projected_document(ids: ["m0", "m1", "m2", "m3"]) {
    Absent => false
    Present { value: four_doc } =>
      match projected_document(ids: ["m0", "m1", "m2", "m3", "m4", "m5"]) {
        Absent => false
        Present { value: six_doc } =>
          count_substring(haystack: four_doc, needle: "pcb-component-obligation") == 4 && count_substring(haystack: six_doc, needle: "pcb-component-obligation") == 6
      }
  }
}

test fn w_the_projection_matches_the_emission_entry() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match emit_altra_board_scene() {
        PcbSceneEmitted { source: from_entry } =>
          match project_pcb_world(w: w) {
            PcbSceneReady { value: scene } => scene.document == from_entry
            PcbSceneRefused { cause: _ } => false
          }
        PcbSceneEmissionRefused { cause: _ } => false
      }
  }
}

test fn w_a_blank_scene_reports_a_dropped_obligation() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match first_unrepresented_world_identity(physical: pcb_world_physical(w: w), document: "") {
        Present { value: _ } => true
        Absent => false
      }
  }
}

test fn w_the_emitted_scene_drops_no_world_identity() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match scene_or_empty() {
        Absent => false
        Present { value: s } =>
          match first_unrepresented_world_identity(physical: pcb_world_physical(w: w), document: s) {
            Absent => true
            Present { value: _ } => false
          }
      }
  }
}

test fn w_mutation_control_obligation_count_must_be_nine() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } => pcb_obligation_count(p: pcb_world_physical(w: w)) == 9
  }
}

test fn w_mutation_control_established_count_must_be_six() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } => pcb_component_count(p: pcb_world_physical(w: w)) == 6
  }
}

test fn w_mutation_control_never_attempted_must_be_zero_type_named_one_and_access_refused_four() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      pcb_selection_never_attempted_count(p: p) == 0
        && pcb_type_named_count(p: p) == 1
        && pcb_access_refused_count(p: p) == 4
  }
}

test fn w_mutation_control_justification_is_one_precedent_and_covers_the_population() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      pcb_justification_count(p: p) == pcb_population_count(p: p)
        && pcb_justification_precedent_count(p: p) == 1
        && pcb_justification_outstanding_count(p: p) == 14
  }
}

test fn w_mutation_control_population_is_established_plus_obligations() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let physical = pcb_world_physical(w: w)
      pcb_population_count(p: physical) == pcb_component_count(p: physical) + pcb_obligation_count(p: physical)
  }
}
