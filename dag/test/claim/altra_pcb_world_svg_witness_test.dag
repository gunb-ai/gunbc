import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn synthetic_design_identity() -> DeclarationRef {
  decl_ref(module_path: "test.claim.altra_pcb_world_svg_witness", decl_name: "synthetic_design_identity")
}

fn world_or_empty() -> PcbWorld? {
  match altra_pcb_world() {
    PcbWorldRefused { cause: _ } => none
    PartialPcbWorldReady { value: w } => Present { value: w }
    AdmittedPcbWorld { value: _ } => none
  }
}

fn scene_or_empty() -> String? {
  match emit_altra_board_scene() {
    PcbSceneEmitted { source: s } => Present { value: s }
    PcbSceneEmissionRefused { cause: _ } => none
  }
}

fn count_substring(haystack: String, needle: String) -> Int {
  fold(split(s: haystack, delimiter: needle), init: 0, f: fn(acc, _part) { acc + 1 }) - 1
}

fn synthetic_frame() -> CoordinateFrameIdentity {
  coordinate_frame_identity(occurrence: 21)
}

fn synthetic_origin() -> Point2 {
  point2(frame: synthetic_frame(), x: 10000, y: 10000)
}

fn synthetic_outline() -> AxisAlignedRectangle2? {
  match axis_aligned_rectangle2(
    min: point2(frame: synthetic_frame(), x: 0, y: 0),
    max: point2(frame: synthetic_frame(), x: 100000, y: 80000)
  ) {
    OrthogonalReady { value: r } => Present { value: r }
    OrthogonalRefused { cause: _ } => none
  }
}

fn synthetic_unselected_obligations(ids: List<NonEmptyStr>) -> List<PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [PcbComponentObligation {
      identity: id,
      origin: synthetic_origin(),
      cause: UnselectedPart { because: "synthetic unselected" },
    }])
  })
}

fn synthetic_missing_document_obligations(ids: List<NonEmptyStr>) -> List<PcbComponentObligation> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, [PcbComponentObligation {
      identity: id,
      origin: synthetic_origin(),
      cause: MissingDocument { what_is_missing: "synthetic document" },
    }])
  })
}

fn world_with_obligations(obs: List<PcbComponentObligation>) -> PcbWorld? {
  match synthetic_outline() {
    Absent => none
    Present { value: o } =>
      Present {
        value: pcb_world(
          design: synthetic_design_identity(),
          electrical: PcbElectricalWorld {
            nets: capability_pending(what_is_owed: "synthetic nets"),
          },
          physical: PcbPhysicalWorld {
            board: PcbBoard { frame: synthetic_frame(), outline: o },
            components: [],
            envelope_reads: [],
            obligations: obs,
            attachment_obligations: [],
            body_layout: PcbBodyLayoutCheckedOverEstablishedSubsetOnly {
              parts_still_owed: list_length(items: obs),
            },
            stackup: capability_pending(what_is_owed: "synthetic stackup"),
            footprints: capability_pending(what_is_owed: "synthetic footprints"),
            pads: capability_pending(what_is_owed: "synthetic pads"),
            routes: capability_pending(what_is_owed: "synthetic routes"),
          },
          manufacturing: PcbManufacturingWorld {
            artifacts: capability_pending(what_is_owed: "synthetic artifacts"),
          },
        )
      }
  }
}

fn projected_document(ids: List<NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_unselected_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match emit_pcb_plan_view(c: project_pcb_world(w: w)) {
        PcbSceneEmitted { source: s } => Present { value: s }
        PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

fn projected_missing_document(ids: List<NonEmptyStr>) -> String? {
  match world_with_obligations(obs: synthetic_missing_document_obligations(ids: ids)) {
    Absent => none
    Present { value: w } =>
      match emit_pcb_plan_view(c: project_pcb_world(w: w)) {
        PcbSceneEmitted { source: s } => Present { value: s }
        PcbSceneEmissionRefused { cause: _ } => none
      }
  }
}

fn drop_label(xs: List<NonEmptyStr>, needle: String) -> List<NonEmptyStr> {
  fold(xs, init: [], f: fn(acc, x) {
    if (x as String) == needle {
      acc
    } else {
      concat(acc, [x])
    }
  })
}

fn six_channel_design() -> AltraMinimalMotherboard {
  AltraMinimalMotherboard {
    intent: Production,
    memory: MemoryConfiguration {
      topology: ActiveDdrTopology {
        populated_channels: [DdrChannel0, DdrChannel1, DdrChannel2, DdrChannel3, DdrChannel4, DdrChannel5],
        positions_per_channel: [FirstDimmOnChannel],
      },
    },
    pcie_lanes_broken_out: 4,
  }
}

test fn w_the_altra_pcb_world_constructs_as_a_partial_preview() -> Bool {
  match altra_pcb_world() {
    PartialPcbWorldReady { value: _ } => true
    AdmittedPcbWorld { value: _ } => false
    PcbWorldRefused { cause: _ } => false
  }
}

test fn w_the_world_carries_two_established_twelve_unselected_and_one_missing_document() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      pcb_component_count(p: p) == 2
        && pcb_obligation_count(p: p) == 13
        && pcb_unselected_part_count(p: p) == 12
        && pcb_missing_document_count(p: p) == 1
        && pcb_commercial_access_count(p: p) == 0
        && pcb_legal_carriage_count(p: p) == 0
        && pcb_population_count(p: p) == 15
  }
}

test fn w_the_reference_board_body_layout_is_the_established_subset_with_thirteen_parts_owed() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match pcb_body_layout(p: pcb_world_physical(w: w)) {
        PcbBodyLayoutAdmittedOverEveryRequiredPart => false
        PcbBodyLayoutCheckedOverEstablishedSubsetOnly { parts_still_owed: n } => n == 13
        PcbBodyLayoutRefused => false
      }
  }
}

test fn w_unmodeled_capabilities_are_pending_with_a_nonempty_obligation() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      match p.routes {
        CapabilityRefused { cause: _ } => false
        CapabilityPending { owed: o } =>
          (o.first.what_is_owed as String) != ""
            && match w.electrical.nets {
              CapabilityRefused { cause: _ } => false
              CapabilityPending { owed: n } => (n.first.what_is_owed as String) != ""
            }
            && match w.manufacturing.artifacts {
              CapabilityRefused { cause: _ } => false
              CapabilityPending { owed: a } => (a.first.what_is_owed as String) != ""
            }
            && match p.stackup {
              CapabilityRefused { cause: _ } => false
              CapabilityPending { owed: s } => (s.first.what_is_owed as String) != ""
            }
      }
  }
}

test fn w_admit_pcb_world_refuses_the_preview_while_capabilities_are_pending() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match admit_pcb_world(d: altra_1p_minimum, d_ref: altra_1p_minimum_ref(), w: w) {
        PartialPcbWorldReady { value: _ } => false
        AdmittedPcbWorld { value: _ } => false
        PcbWorldRefused { cause: c } =>
          match c {
            PcbCapabilityStillPending { capability: cap } => (cap as String) == "stackup"
            PcbCapabilityRefused { capability: _, cause: _ } => false
            PcbDesignPlanUnavailable { only_available: _ } => false
            PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            PcbPlacementNotAdmitted => false
            PcbBoardOutlineRefused { cause: _ } => false
            PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}

test fn w_altra_pcb_world_for_refuses_a_design_without_a_plan() -> Bool {
  match altra_pcb_world_for(d: six_channel_design()) {
    PartialPcbWorldReady { value: _ } => false
    AdmittedPcbWorld { value: _ } => false
    PcbWorldRefused { cause: c } =>
      match c {
        PcbDesignPlanUnavailable { only_available: r } =>
          declaration_ref_eq(a: r, b: altra_1p_minimum_ref())
        PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
        PcbCapabilityStillPending { capability: _ } => false
        PcbCapabilityRefused { capability: _, cause: _ } => false
        PcbPlacementNotAdmitted => false
        PcbBoardOutlineRefused { cause: _ } => false
        PcbOutlineCopiedFromCitedForeignBoard => false
      }
  }
}

test fn w_the_world_carries_the_plan_design_identity() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match altra_reference_plan() {
        OrthogonalRefused { cause: _ } => false
        OrthogonalReady { value: plan } =>
          declaration_ref_eq(a: pcb_world_design(w: w), b: plan.design)
            && declaration_ref_eq(a: plan.design, b: altra_1p_minimum_ref())
      }
  }
}

test fn w_the_emitted_scene_is_non_empty_and_opens_the_cited_root() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      s != "" && string_contains(s: s, pattern: "<svg") && string_contains(s: s, pattern: "pcb-world-scene") && string_contains(s: s, pattern: "viewBox=\"0 0 305000 267000\"") && string_contains(s: s, pattern: "http://www.w3.org/2000/svg")
  }
}

test fn w_the_authored_outline_is_not_the_cited_mt_jade_board() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      !outline_copies_mt_jade_reference(o: pcb_world_physical(w: w).board.outline)
  }
}

test fn w_the_processor_package_renders_at_cited_body_dimensions() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: concat("width=\"", to_string(micrometer_count(m: altra_package_body_width)))) && string_contains(s: s, pattern: concat("height=\"", to_string(micrometer_count(m: altra_package_body_height)))) && string_contains(s: s, pattern: "processor_package")
  }
}

test fn w_the_socket_is_missing_document_not_an_unselected_part() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "class=\"pcb-component-missing-document\">cpu_socket<")
        && string_contains(s: s, pattern: concat("(missing document:", ilm4926.designator as String))
        && !string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">cpu_socket<")
  }
}

test fn w_unselected_roles_render_as_unselected_part() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">boot_eeprom<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">nvme_conn<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">dimm_ddr0_slot0<")
        && string_contains(s: s, pattern: "class=\"pcb-component-unselected-part\">debug_hdr<")
        && !string_contains(s: s, pattern: "class=\"pcb-component-missing-document\">boot_eeprom<")
  }
}

test fn w_subset_bodies_are_not_drawn_as_checked() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      count_substring(haystack: s, needle: "pcb-component-established") == 0
        && count_substring(haystack: s, needle: "pcb-component-subset-body") == 2
        && count_substring(haystack: s, needle: "pcb-component-unselected-part") == 12
        && count_substring(haystack: s, needle: "pcb-component-missing-document") == 1
        && string_contains(s: s, pattern: "body layout checked over established subset only; 13 parts owed")
  }
}

test fn w_the_legend_states_the_cause_populations() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } => string_contains(s: s, pattern: "2 established / 12 unselected / 1 missing-document / 0 commercial-access / 0 legal-carriage / 0 drawing-must-be-read — body layout checked over established subset only; 13 parts owed")
  }
}

test fn w_every_world_component_identity_appears_in_the_scene() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let physical = pcb_world_physical(w: w)
      match scene_or_empty() {
        Absent => false
        Present { value: svg } =>
          fold(physical.components, init: true, f: fn(acc, c) {
            acc && string_contains(s: svg, pattern: c.identity as String)
          }) && fold(physical.obligations, init: true, f: fn(acc, o) {
            acc && string_contains(s: svg, pattern: o.identity as String)
          })
      }
  }
}

test fn w_mounting_and_socket_attachment_obligations_appear() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match scene_or_empty() {
        Absent => false
        Present { value: s } =>
          string_contains(s: s, pattern: "attachment: mounting") && string_contains(s: s, pattern: "attachment: socket") && string_contains(s: s, pattern: "attachment: board land pattern") && count_substring(haystack: s, needle: "pcb-label-attachment-obligation") == pcb_attachment_obligation_count(p: pcb_world_physical(w: w))
      }
  }
}

// THE BOARD LAND PATTERN IS FILED AS A DOCUMENT NOBODY HAS FOUND, and this witness was reversed
// to say so. It previously asserted the opposite -- that the layer produced DrawingMustBeRead,
// naming a figure -- which followed the model when board_land_pattern_standing claimed the fact
// was stated in the platform specification's Figure 3. That claim was an overclaim: Figure 3 is
// the package outline and pad array, the underside of the PART, and no document consulted states
// a board-side land pattern at all. Routing a reader to a drawing that does not contain the fact
// is a worse answer than admitting the document is missing, so the standing changed and this
// assertion changed with it. No live obligation produces DrawingMustBeRead today; the arm remains
// modelled because the state is real, and the planted-obligation controls elsewhere in this file
// are what keep the causes distinguishable now that no live row exercises that one.
test fn w_the_board_land_pattern_is_filed_as_a_missing_document() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      fold(pcb_world_physical(w: w).attachment_obligations, init: false, f: fn(acc, a) {
        acc || match a.cause {
          MissingDocument { what_is_missing: m } =>
            (a.layer as String) == "board land pattern" && (m as String) != ""
          DrawingMustBeRead { figure: _, what_is_drawn: _ } => false
          CommercialAccess { subject: _ } => false
          LegalCarriage { reason: _ } => false
          UnselectedPart { because: _ } => false
          StandingIsSelfContradictory { what_is_wrong: _ } => false
        }
      })
  }
}

test fn w_plan_view_unselected_marker_count_follows_population() -> Bool {
  match projected_document(ids: ["m0", "m1", "m2", "m3"]) {
    Absent => false
    Present { value: four_doc } =>
      match projected_document(ids: ["m0", "m1", "m2", "m3", "m4", "m5"]) {
        Absent => false
        Present { value: six_doc } =>
          count_substring(haystack: four_doc, needle: "pcb-component-unselected-part") == 4 && count_substring(haystack: six_doc, needle: "pcb-component-unselected-part") == 6
      }
  }
}

test fn w_plan_view_missing_document_count_follows_population() -> Bool {
  match projected_missing_document(ids: ["p0", "p1"]) {
    Absent => false
    Present { value: two_doc } =>
      match projected_missing_document(ids: ["p0", "p1", "p2"]) {
        Absent => false
        Present { value: three_doc } =>
          count_substring(haystack: two_doc, needle: "pcb-component-missing-document") == 2
            && count_substring(haystack: three_doc, needle: "pcb-component-missing-document") == 3
      }
  }
}

test fn w_the_projection_matches_the_emission_entry() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match emit_altra_board_scene() {
        PcbSceneEmitted { source: from_entry } =>
          match project_pcb_world(w: w) {
            PcbSceneReady { value: scene } =>
              pcb_worlds_share_design(a: w, b: scene.world)
                && scene.document == from_entry
                && string_contains(
                  s: from_entry,
                  pattern: concat("design identity: ", declaration_ref_display_key(ref: pcb_world_design(w: w))),
                )
                && !string_contains(s: from_entry, pattern: "board revision")
                && !string_contains(s: from_entry, pattern: "Mechanical Data")
                && !string_contains(s: from_entry, pattern: "verified provenance")
            PcbSceneRefused { cause: _ } => false
          }
        PcbSceneEmissionRefused { cause: _ } => false
      }
  }
}

test fn w_established_envelopes_name_the_declaration_read_not_a_datasheet_sentence() -> Bool {
  match scene_or_empty() {
    Absent => false
    Present { value: s } =>
      string_contains(s: s, pattern: "read: ")
        && string_contains(s: s, pattern: "extdeps.programmable_logic.ice40.subject::ice40_tq144_package")
        && string_contains(s: s, pattern: "extdeps.cpu.ampere_altra_package::altra_package_body_width")
        && !string_contains(s: s, pattern: "Mechanical Data")
        && !string_contains(s: s, pattern: "verified")
  }
}

test fn w_the_two_envelope_reads_are_distinct_declarations() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let reads = pcb_envelope_reads(p: pcb_world_physical(w: w))
      list_length(items: reads) == 2
        && fold(reads, init: true, f: fn(ok, r) {
          ok && fold(reads, init: true, f: fn(inner, q) {
            inner && ((r.identity as String) == (q.identity as String) || !declaration_ref_eq(a: r.source, b: q.source))
          })
        })
  }
}

test fn w_dropping_an_envelope_read_from_the_document_is_detected() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let scene = project_engineering_scene(w: w)
      let represented = drop_label(
        xs: scene_identities(scene: scene),
        needle: "extdeps.cpu.ampere_altra_package::altra_package_body_width",
      )
      match first_unrepresented_scene_identity(scene: scene, represented: represented) {
        Absent => false
        Present { value: id } => (id as String) == "extdeps.cpu.ampere_altra_package::altra_package_body_width"
      }
  }
}

test fn w_a_blank_scene_reports_a_dropped_obligation() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match first_unrepresented_scene_identity(scene: project_engineering_scene(w: w), represented: []) {
        Present { value: _ } => true
        Absent => false
      }
  }
}

test fn w_the_emitted_scene_drops_no_world_identity() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let scene = project_engineering_scene(w: w)
      match first_unrepresented_scene_identity(scene: scene, represented: represented_scene_labels(scene: scene)) {
        Absent => true
        Present { value: _ } => false
      }
  }
}

test fn w_cpu_socket_text_does_not_cover_the_socket_attachment() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let scene = project_engineering_scene(w: w)
      let represented = drop_label(xs: scene_identities(scene: scene), needle: "attachment: socket")
      string_contains(s: "cpu_socket", pattern: "socket")
        && match first_unrepresented_scene_identity(scene: scene, represented: represented) {
          Absent => false
          Present { value: id } => (id as String) == "attachment: socket"
        }
  }
}

test fn w_a_longer_attachment_label_does_not_cover_its_prefix() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let scene = project_engineering_scene(w: w)
      let represented = drop_label(xs: scene_identities(scene: scene), needle: "attachment: socket")
      label_is_represented(represented: represented, id: "attachment: socket board termination" as NonEmptyStr)
        && !label_is_represented(represented: represented, id: "attachment: socket" as NonEmptyStr)
        && match first_unrepresented_scene_identity(scene: scene, represented: represented) {
          Absent => false
          Present { value: id } => (id as String) == "attachment: socket"
        }
  }
}

test fn w_the_engineering_scene_is_projected_from_the_world() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let scene = project_engineering_scene(w: w)
      fold(scene.elements, init: false, f: fn(acc, _e) { true })
  }
}

test fn w_mutation_control_obligation_count_must_be_thirteen() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } => pcb_obligation_count(p: pcb_world_physical(w: w)) == 13
  }
}

test fn w_mutation_control_established_count_must_be_two() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } => pcb_component_count(p: pcb_world_physical(w: w)) == 2
  }
}

test fn w_mutation_control_unselected_twelve_and_missing_document_one() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let p = pcb_world_physical(w: w)
      pcb_unselected_part_count(p: p) == 12 && pcb_missing_document_count(p: p) == 1 && pcb_drawing_must_be_read_count(p: p) == 0
  }
}

test fn w_mutation_control_population_is_established_plus_obligations() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      let physical = pcb_world_physical(w: w)
      pcb_population_count(p: physical) == pcb_component_count(p: physical) + pcb_obligation_count(p: physical)
  }
}

test fn w_attachment_label_offsets_are_micrometre_measures() -> Bool {
  micrometer_count(m: attachment_label_base) > 0
    && micrometer_count(m: attachment_label_step) > 0
}

// THE DISCRIMINATING CONTROL FOR THE CAPABILITY GATE. The world below is the real one with every
// capability standing replaced by CapabilityRefused, which is the mutation that used to admit it:
// the old projection answered Absent for a refused capability, so an all-refused world read as a
// world with nothing outstanding and fell through to the placement check. That it did not in fact
// reach AdmittedPcbWorld was an accident of placement failing for an unrelated reason, and an
// accident is not a wall. This asserts the refusal is produced BY the capability gate -- naming
// the first refused capability -- rather than by whatever else happens to be broken.
fn all_capabilities_refused(w: PcbWorld) -> PcbWorld {
  let p = pcb_world_physical(w: w)
  pcb_world(
    design: pcb_world_design(w: w),
    electrical: PcbElectricalWorld { nets: CapabilityRefused { cause: "planted refusal: nets" } },
    physical: PcbPhysicalWorld {
      board: p.board,
      components: p.components,
      envelope_reads: p.envelope_reads,
      obligations: p.obligations,
      attachment_obligations: p.attachment_obligations,
      body_layout: p.body_layout,
      stackup: CapabilityRefused { cause: "planted refusal: stackup" },
      footprints: CapabilityRefused { cause: "planted refusal: footprints" },
      pads: CapabilityRefused { cause: "planted refusal: pads" },
      routes: CapabilityRefused { cause: "planted refusal: routes" },
    },
    manufacturing: PcbManufacturingWorld {
      artifacts: CapabilityRefused { cause: "planted refusal: artifacts" },
    },
  )
}

test fn w_a_world_whose_capabilities_are_all_refused_is_not_admitted() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match admit_pcb_world(d: altra_1p_minimum, d_ref: altra_1p_minimum_ref(), w: all_capabilities_refused(w: w)) {
        PartialPcbWorldReady { value: _ } => false
        AdmittedPcbWorld { value: _ } => false
        PcbWorldRefused { cause: c } =>
          match c {
            PcbCapabilityRefused { capability: cap, cause: why } =>
              (cap as String) == "stackup" && (why as String) == "planted refusal: stackup"
            PcbCapabilityStillPending { capability: _ } => false
            PcbDesignPlanUnavailable { only_available: _ } => false
            PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            PcbPlacementNotAdmitted => false
            PcbBoardOutlineRefused { cause: _ } => false
            PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}

// AND THE PROJECTION ITSELF, asserted directly rather than only through admission, so that a
// future admission path cannot quietly stop consulting it without a witness going red.
test fn w_a_refused_capability_is_reported_as_outstanding() -> Bool {
  match world_or_empty() {
    Absent => false
    Present { value: w } =>
      match first_unsettled_capability(w: all_capabilities_refused(w: w)) {
        Absent => false
        Present { value: r } =>
          match r {
            PcbCapabilityRefused { capability: cap, cause: _ } => (cap as String) == "stackup"
            PcbCapabilityStillPending { capability: _ } => false
            PcbDesignPlanUnavailable { only_available: _ } => false
            PcbPlanWasBuiltFromADifferentDesign { plan_design: _, admitted_against: _ } => false
            PcbPlacementNotAdmitted => false
            PcbBoardOutlineRefused { cause: _ } => false
            PcbOutlineCopiedFromCitedForeignBoard => false
          }
      }
  }
}
