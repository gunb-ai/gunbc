module test.claim.firmware_applicability_and_loop_cause_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// These bind the PRODUCTION release rows, not fixtures, so the gate is
// exercised against the prerequisite the catalog actually declares.

// THE FAIL-CLOSED ARM, and the case that justified it: srv3 reports its BIOS
// version as null through Redfish. "We could not read it" must refuse rather
// than collapse into either pole.
test fn unreadable_target_version_refuses_rather_than_assuming() -> Bool {
  match firmware_release_applicability(
    prerequisite: asrock_altrad8ud_bios_3_10_openbmc_release.prerequisite,
    observed: v2.std.optional.Absent,
  ) {
    FirmwarePrerequisiteUnobserved { target: t, minimum: m } =>
      t == extdeps.firmware.types.BmcController && m.major == 3 && m.minor == 22
    FirmwareApplicable => false
    FirmwarePrerequisiteUnmet { target: _, minimum: _, observed: _ } => false
  }
}

// The srv3 push that actually happened: BMC 2.07.00 against a row requiring
// 3.22.00. Unmet, and the verdict carries the observed version so the refusal
// can say what it saw rather than only that it refused.
test fn the_srv3_push_is_refused_by_the_catalog() -> Bool {
  match firmware_release_applicability(
    prerequisite: asrock_altrad8ud_bios_3_10_openbmc_release.prerequisite,
    observed: v2.std.optional.Present {
      value: firmware_semantic_version(major: 2, minor: 7, patch: 0),
    },
  ) {
    FirmwarePrerequisiteUnmet { target: _, minimum: _, observed: o } =>
      o.major == 2 && o.minor == 7
    _ => false
  }
}

// Positive control: the srv4 push, same bytes, same row, accepted.
test fn the_srv4_push_is_admitted_by_the_catalog() -> Bool {
  match firmware_release_applicability(
    prerequisite: asrock_altrad8ud_bios_3_10_openbmc_release.prerequisite,
    observed: v2.std.optional.Present {
      value: firmware_semantic_version(major: 3, minor: 22, patch: 0),
    },
  ) {
    FirmwareApplicable => true
    _ => false
  }
}

// RED control on the COMPARISON, not on the arms. 3.06.00 exceeds the minimum
// on major and fails on minor; a naive major-only compare would admit it. The
// version is also a real catalogued image for this board, so this is a push
// someone could actually attempt.
test fn a_higher_major_with_lower_minor_is_still_unmet() -> Bool {
  match firmware_release_applicability(
    prerequisite: asrock_altrad8ud_bios_3_10_openbmc_release.prerequisite,
    observed: v2.std.optional.Present {
      value: firmware_semantic_version(major: 3, minor: 6, patch: 0),
    },
  ) {
    FirmwarePrerequisiteUnmet { target: _, minimum: _, observed: o } =>
      o.major == 3 && o.minor == 6
    _ => false
  }
}

// The packaging asymmetry, exercised rather than asserted: the Instant Flash
// ROM never passes through the BMC, so it is applicable even when the BMC
// version is unreadable — the exact input that refuses on the tar row above.
// Same observation, opposite verdict, because the packaging differs.
test fn the_rom_packaging_is_applicable_with_no_readable_bmc_version() -> Bool {
  match firmware_release_applicability(
    prerequisite: asrock_altrad8ud_bios_3_10_instant_flash_release.prerequisite,
    observed: v2.std.optional.Absent,
  ) {
    FirmwareApplicable => true
    _ => false
  }
}

data srv4_e588_signature: gunbc.host_boot_supervision.HostBootStallSignature = gunbc.host_boot_supervision.HostBootStallSignature {
  host: "srv4",
  last_checkpoint: "P012",
  error_code: v2.std.optional.Present { value: "E588" },
  observed_cycles: 6,
  observed_at: 1786580000000,
}

// THE POWERMON REFUTATION, as an executing check rather than a prose receipt.
// power-monitor.service was stopped on srv4 and the loop PERSISTED, which is
// what moves the cause to the host itself. Note the shape of the argument: the
// loop's PERIOD never decides this — a 306-second cycle looks identical whether
// or not a 306-second timeout causes it. Only the intervention discriminates.
test fn loop_persisting_after_supervisor_stop_is_host_self_reset() -> Bool {
  match host_boot_loop_cause(
    signature: srv4_e588_signature,
    supervisor_stopped: true,
    looped_after_stop: true,
  ) {
    HostSelfResetOnError { code: c } => c == "E588"
    _ => false
  }
}

// RED control: the SAME signature with the supervisor still running is
// CONFOUNDED, not attributed. This is the state the incident was in for hours
// while the watchdog theory looked plausible, and the function must not
// resolve it — the discriminating fact is the intervention, not the signature.
test fn the_same_signature_without_the_intervention_is_confounded() -> Bool {
  match host_boot_loop_cause(
    signature: srv4_e588_signature,
    supervisor_stopped: false,
    looped_after_stop: false,
  ) {
    LoopCauseConfounded { candidates: _ } => true
    HostSelfResetOnError { code: _ } => false
    SupervisorForcedReset { supervisor: _ } => false
    LoopCauseUnobserved => false
  }
}

// Stopping the supervisor and observing the loop STOP does not attribute the
// cause either — it removes one candidate, and with no error code there is
// nothing left to attribute to, so the answer is Unobserved rather than a
// supervisor verdict inferred from silence.
test fn no_error_code_after_a_clean_stop_is_unobserved_not_attributed() -> Bool {
  match host_boot_loop_cause(
    signature: gunbc.host_boot_supervision.HostBootStallSignature {
      host: "srv4",
      last_checkpoint: "P012",
      error_code: v2.std.optional.Absent,
      observed_cycles: 3,
      observed_at: 1786580000000,
    },
    supervisor_stopped: true,
    looped_after_stop: true,
  ) {
    LoopCauseUnobserved => true
    _ => false
  }
}
