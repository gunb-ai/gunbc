module test.claim.emitter_unprojectable_construct_refuse_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Permanent regression control (DESIGN 4b(4)) for a wall that refused correct code. The
// emitter once withheld every module with a filter in an if-condition (EmissionConstructUnprojectable,
// FilterInBranchCondition) on the premise that the guarded branch was dropped. Executing the
// projection showed the condition and both arms render intact, so the wall was deleted rather than
// taught: an expression legal in value position is projected the same way in a branch condition.
// These claims assert the emitted file carries the guard's own body (the filter's push) and the
// spelling that selects each arm, which a truncated or withheld module cannot. Compilation and
// execution of the same shapes, both arms each, is gunbc.instruments.native_emission_controls
// filter_in_branch_condition_cases (gunbc test //gunbc/instruments:native-emission-controls).

data filter_in_guard_source: String = "module fx.filter_guard\nimport std.types { List, Bool, Int }\nfn f(xs: List<Int>) -> Int {\n  if (xs |> filter(x => x > 0) |> count) > 0 {\n    1\n  } else {\n    0\n  }\n}\n"

data any_in_guard_source: String = "module fx.any_guard\nimport std.types { List, Bool, Int }\nfn f(xs: List<Int>) -> Int {\n  if xs |> any(x => x > 0) {\n    1\n  } else {\n    0\n  }\n}\n"

data filter_free_call_in_guard_source: String = "module fx.filter_call_guard\nimport std.types { List, Bool, Int }\nfn f(xs: List<Int>) -> Int {\n  if (filter(xs, x => x > 0) |> count) > 0 {\n    1\n  } else {\n    0\n  }\n}\n"

data nested_if_filter_in_guard_source: String = "module fx.filter_nested_if_guard\nimport std.types { List, Bool, Int }\nfn f(xs: List<Int>) -> Int {\n  if (if (xs |> filter(x => x > 0) |> count) > 0 { true } else { false }) {\n    1\n  } else {\n    0\n  }\n}\n"

data filter_in_then_of_if_used_as_guard_source: String = "module fx.filter_then_of_guard\nimport std.types { List, Bool, Int }\nfn f(xs: List<Int>) -> Int {\n  if (if (xs |> any(x => x > 0)) { (xs |> filter(x => x > 0) |> count) > 0 } else { false }) {\n    1\n  } else {\n    0\n  }\n}\n"

data filter_guard_body: String = "__result.push(x)"

test fn w_filter_in_branch_condition_emits_the_guard() -> Bool {
  compile_dag_rust_emit_check(filter_in_guard_source, "src/fx_filter_guard.rs", ["fn f", filter_guard_body, "} else {"], [])
}

test fn w_supported_guarded_any_lambda_still_emits() -> Bool {
  compile_dag_rust_emit_check(any_in_guard_source, "src/fx_any_guard.rs", ["fn f"], [])
}

// Written as filter(xs, x => …) in a guard; infer rewrites it onto the method arm, so the same
// projection renders it.
test fn w_free_call_filter_in_branch_condition_emits_the_guard() -> Bool {
  compile_dag_rust_emit_check(filter_free_call_in_guard_source, "src/fx_filter_call_guard.rs", ["fn f", filter_guard_body, "} else {"], [])
}

test fn w_nested_if_filter_in_guard_emits_the_guard() -> Bool {
  compile_dag_rust_emit_check(nested_if_filter_in_guard_source, "src/fx_filter_nested_if_guard.rs", ["fn f", filter_guard_body, "} else {"], [])
}

test fn w_filter_in_then_of_if_used_as_guard_still_emits() -> Bool {
  compile_dag_rust_emit_check(filter_in_then_of_if_used_as_guard_source, "src/fx_filter_then_of_guard.rs", ["fn f", filter_guard_body], [])
}
