module test.claim.workspace_network_producer_witness_test

import std.types { Bool }
import gunbc.runner_microvm_network_observe { tap_holders_reading }
import gunbc.runner_microvm_network { TapPresentUnheld, TapHeld, TapHoldersUnreadable }
import extdeps.linux.tun_fdinfo { TunDescriptorCount, TunDescriptorUnreadable, TunCensusMultiQueue }

test fn network_producer_requires_successful_tun_census() -> Bool {
  (match tap_holders_reading(census: TunDescriptorCount { count: 0, exited: 0 }) { TapPresentUnheld => true other => false })
    && (match tap_holders_reading(census: TunDescriptorCount { count: 1, exited: 0 }) { TapHeld { holders: n } => n == 1 other => false })
    && (match tap_holders_reading(census: TunDescriptorUnreadable { cause: TunCensusMultiQueue }) { TapHoldersUnreadable { reason: _ } => true other => false })
}
