module test.claim.transport_fidelity


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn test_class_is_hermetic(c: TestClass) -> Bool {
  match c {
    Hermetic => true
    Unit => false
    Integration => false
  }
}

fn test_class_is_integration(c: TestClass) -> Bool {
  match c {
    Integration => true
    Unit => false
    Hermetic => false
  }
}

fn test_class_is_unit(c: TestClass) -> Bool {
  match c {
    Unit => true
    Hermetic => false
    Integration => false
  }
}

test fn local_set_is_hermetic() -> Bool {
  let d = classify_transports(transports: [ShellLocal, FileBoundary, LocalDirect])
  test_class_is_hermetic(c: d.test_class) && d.hermetic && fermi_eq(lhs: d.depth, rhs: S)
}

test fn network_set_is_integration() -> Bool {
  let d = classify_transports(transports: [ShellLocal, RestNetwork])
  test_class_is_integration(c: d.test_class) && !d.hermetic && fermi_eq(lhs: d.depth, rhs: L)
}

test fn empty_set_is_unit() -> Bool {
  let d = classify_transports(transports: [])
  test_class_is_unit(c: d.test_class) && d.hermetic && fermi_eq(lhs: d.depth, rhs: Xs)
}

test fn dispatch_reads_cited_rows() -> Bool {
  fermi_eq(lhs: transport_depth(tc: ShellLocal), rhs: S)
    && transport_hermetic(tc: ShellLocal)
    && fermi_eq(lhs: transport_depth(tc: RestNetwork), rhs: L)
    && !transport_hermetic(tc: RestNetwork)
}

test fn rest_network_is_not_hermetic() -> Bool {
  !transport_hermetic(tc: RestNetwork)
}

