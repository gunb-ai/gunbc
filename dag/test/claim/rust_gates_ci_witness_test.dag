module test.claim.rust_gates_ci_witness

import tools.rust_gates_ci { gate_diag, rust_gate_reason }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn w_diag_names_check() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo fmt --all --check", stdout: "diff here", stderr: ""),
    pattern: "cargo fmt --all --check"
  )
}

test fn w_diag_includes_stdout() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo fmt --all --check", stdout: "diff here", stderr: ""),
    pattern: "diff here"
  )
}

test fn w_diag_includes_stderr() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo nextest run -p v1-compiler-tests", stdout: "", stderr: "FAILED test::my_failing_test"),
    pattern: "FAILED test::my_failing_test"
  )
}

test fn w_quiet_on_passing_fmt() -> Bool {
  let reason = rust_gate_reason(
    fmt_success: true, fmt_stdout: "SENTINEL_SHOULD_NOT_APPEAR", fmt_stderr: "",
    test_success: false, test_stdout: "", test_stderr: "some test error"
  )
  !string_contains(s: reason, pattern: "SENTINEL_SHOULD_NOT_APPEAR")
}

test fn w_red_surfaces_nextest() -> Bool {
  let reason = rust_gate_reason(
    fmt_success: true, fmt_stdout: "", fmt_stderr: "",
    test_success: false, test_stdout: "", test_stderr: "FAILED test::x_failure"
  )
  string_contains(s: reason, pattern: "FAILED test::x_failure") &&
  string_contains(s: reason, pattern: "cargo nextest run -p v1-compiler-tests")
}

