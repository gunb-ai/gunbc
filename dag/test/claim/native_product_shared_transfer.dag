module test.claim.native_product_shared_transfer

import std.types { Bool, String }
import gunbc.native_product_shared_transfer { native_product_listing_is_exactly, native_product_standing_for, native_product_store_dir }
import gunbc.native_product_shared_store { ForkPullRequestRun, MergeGroupRun, SameRepoPullRequestRun, UnattributedRun }

data transfer_key: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

// The accepting control: the two entry files under the key, nothing else.
test fn a_listing_of_exactly_the_two_entry_files_is_admitted() -> Bool {
  native_product_listing_is_exactly(key: transfer_key, listing: join([transfer_key, "/executable\n", transfer_key, "/manifest.json\n"], ""))
}

// The refusing controls: a traversal member, an extra member and a different key's directory each
// refuse before anything is extracted.
test fn a_listing_with_a_traversal_or_extra_or_foreign_member_is_refused() -> Bool {
  let traversal = native_product_listing_is_exactly(key: transfer_key, listing: join([transfer_key, "/executable\n../escape\n"], ""))
  let extra = native_product_listing_is_exactly(key: transfer_key, listing: join([transfer_key, "/executable\n", transfer_key, "/manifest.json\n", transfer_key, "/extra\n"], ""))
  let foreign = native_product_listing_is_exactly(key: transfer_key, listing: "ffff/executable\nffff/manifest.json\n")
  !traversal && !extra && !foreign
}

test fn the_store_directory_is_the_one_the_seed_commits_under() -> Bool {
  native_product_store_dir(root: "/r") == "/r/native-products"
}

test fn a_pull_request_is_attributed_by_its_head_repository() -> Bool {
  let same = native_product_standing_for(event: "pull_request", head: "gunb-ai/gunbc", repository: "gunb-ai/gunbc") == SameRepoPullRequestRun
  let fork = native_product_standing_for(event: "pull_request", head: "someone/gunbc", repository: "gunb-ai/gunbc") == ForkPullRequestRun
  let unreadable = native_product_standing_for(event: "pull_request", head: "", repository: "gunb-ai/gunbc") == UnattributedRun
  let queue = native_product_standing_for(event: "merge_group", head: "", repository: "gunb-ai/gunbc") == MergeGroupRun
  let other = native_product_standing_for(event: "push", head: "gunb-ai/gunbc", repository: "gunb-ai/gunbc") == UnattributedRun
  same && fork && unreadable && queue && other
}
