module test.claim.approval_ntfy_deployment_witness_test

import std.logic { Bool }
import std.types { Int }
import std.human_intervention {
  ProvisioningHumanBurden, HumanIntervention, FleetOnce, DeviceOnce, EveryProvision,
  BreakGlassOnly, human_intervention_count_at, HumanInterventionIdentity,
}
import gunbc.auth.approval_ntfy_deployment {
  approval_ntfy_human_burden, approval_ntfy_listen_address,
  approval_ntfy_endpoint, approval_ntfy_server_install_intervention, approval_ntfy_state_root,
  approval_ntfy_subscriber_grant_intervention, approval_ntfy_phone_subscription_intervention,
}
import extdeps.ntfy.ntfy { NtfyTopic }
import gunbc.auth.approval_notification { approval_ntfy_topic }
import std.types { String }
import product.placement_supply { HostIdentity }
import gunbc.fleet_posix_accounts {
  notification_service_realization_standing, PersistentServiceAccount, AccountUnallocated,
  ServicePrincipalRealizationUnselected, DynamicServicePrincipal, FleetAccountNotificationService,
}

data srv1: HostIdentity = "srv1" as HostIdentity

// THE ONE COUNT WORTH ASSERTING, and the reason it is not a change detector: zero is a DESIGN
// CLAIM, not a measurement copied from the roster beside it. The notification path must cost a
// person nothing per run -- the operator is the thing being economized -- so this stays true for
// any future roster and goes red exactly when someone adds a step at the wrong frequency.
//
// The sibling counts this file used to carry (FleetOnce == 4, DeviceOnce == 1, total == 6) are
// DELETED. They were measurements of a roster authored three files away in the same PR, so
// automating their update would have collapsed them to `measure() == measure()` -- §5's own review
// tell for a change detector. Adding a legitimate seventh step should not redden a test whose
// subject is not the number of steps.
test fn witness_no_per_run_human_cost() -> Bool {
  human_intervention_count_at(burden: approval_ntfy_human_burden(), frequency: EveryProvision) == 0
}

// A STRUCTURAL PROPERTY THAT SURVIVES ROSTER GROWTH. Every intervention must be uniquely
// identified, because the identity is what a discharge record would key on -- two rows sharing one
// identity would let discharging either close both. This is also the check that catches the
// copy-paste a count cannot see: duplicating a row and deleting another keeps every count equal.
fn identity_occurrence_count(b: ProvisioningHumanBurden, id: HumanInterventionIdentity) -> Int {
  list_length(items: filter(xs: b.interventions, f: i => i.identity == id))
}

fn every_identity_occurs_once(b: ProvisioningHumanBurden) -> Bool {
  all(xs: b.interventions, f: i => identity_occurrence_count(b: b, id: i.identity) == 1)
}

test fn witness_every_intervention_has_a_distinct_identity() -> Bool {
  every_identity_occurs_once(b: approval_ntfy_human_burden())
}

// POSITIVE CONTROL ON THAT PROPERTY, so it is not green because the predicate cannot fail. A
// burden holding one row twice must be refused.
fn burden_with_a_duplicated_row() -> ProvisioningHumanBurden {
  ProvisioningHumanBurden {
    interventions: [
      approval_ntfy_phone_subscription_intervention(),
      approval_ntfy_phone_subscription_intervention(),
    ],
  }
}

test fn witness_duplicate_identities_are_refused() -> Bool {
  !every_identity_occurs_once(b: burden_with_a_duplicated_row())
}

// EVERY ROW MUST ACTUALLY TELL A PERSON WHAT TO DO. An intervention with an empty instruction is
// a roster entry that looks like coverage and discharges nothing.
test fn witness_every_intervention_carries_an_instruction() -> Bool {
  all(xs: approval_ntfy_human_burden().interventions, f: i => (i.instruction as String) != "" && (i.subject as String) != "")
}

// THE LOOPBACK BIND IS A POLICY REQUIREMENT, not a measurement -- which is what makes comparing it
// to a literal legitimate under §5 (an explicit policy budget, grounded outside the tree). The
// requirement is that this address MUST be loopback: it is what makes tailscale serve the sole
// route in, and the sole route is what makes the identity header on the approval route
// trustworthy. A 0.0.0.0 bind would let anything on the host forge it.
//
// The former witness_upstream_relay_is_declared is DELETED: it compared
// approval_ntfy_upstream_base_url to its own literal, which is `measure() == measure()` and
// asserted nothing at all.
test fn witness_server_binds_loopback_only() -> Bool {
  approval_ntfy_listen_address == "127.0.0.1"
}

// THE DERIVED INSTRUCTION ACTUALLY CARRIES THE DECLARED VALUES. This is what stops the config
// declarations from being dangling data beside an English restatement of themselves: if the port
// or the state root changes and the instruction stops agreeing, these go red. A person following
// the instruction and a machine reading the declarations get the same answer by construction.
test fn witness_install_instruction_carries_the_declared_endpoint() -> Bool {
  string_contains(s: approval_ntfy_server_install_intervention().instruction as String, pattern: approval_ntfy_endpoint())
}

test fn witness_install_instruction_carries_the_declared_state_root() -> Bool {
  string_contains(s: approval_ntfy_server_install_intervention().instruction as String, pattern: approval_ntfy_state_root as String)
}

// POSITIVE CONTROL on those two: string_contains must be capable of answering false here, or the
// pair above would pass over any instruction at all.
test fn witness_install_instruction_does_not_carry_an_unrelated_endpoint() -> Bool {
  !string_contains(s: approval_ntfy_server_install_intervention().instruction as String, pattern: "0.0.0.0:2586")
}

// THE ENDPOINT IS BUILT FROM THE LOOPBACK ADDRESS, so the security property asserted by
// witness_server_binds_loopback_only reaches the string the operator actually follows.
test fn witness_endpoint_is_the_loopback_one() -> Bool {
  approval_ntfy_endpoint() == "127.0.0.1:2586"
}

// The notification principal's realization standing is persistent and unallocated until a host uid
// is observed -- the same shape its sibling carries, asserted rather than assumed, and naming its
// own principal so a copy-paste of the publication helper's row would go red.
test fn witness_notification_service_realization_is_a_persistent_account() -> Bool {
  match notification_service_realization_standing(host: srv1) {
    PersistentServiceAccount { allocation: AccountUnallocated { occurrence: o } } =>
      match o.principal {
        FleetAccountNotificationService => true
        _ => false
      }
    PersistentServiceAccount { allocation: _ } => false
    ServicePrincipalRealizationUnselected => false
    DynamicServicePrincipal { supervisor: _ } => false
  }
}


// THE GRANT INSTRUCTION NAMES THE DECLARED TOPIC, for the same reason the install instruction names
// the declared endpoint: the topic is the entire access-control surface on a default ntfy
// deployment, so an operator granting read on a DIFFERENT topic than the broker publishes to would
// leave the real one at read-write -- silently, and in exactly the direction that makes approval
// links public. Joining the declaration is what makes that disagreement impossible.
test fn witness_grant_instruction_names_the_declared_topic() -> Bool {
  string_contains(
    s: approval_ntfy_subscriber_grant_intervention().instruction as String,
    pattern: approval_ntfy_topic as String,
  )
}

test fn witness_grant_instruction_does_not_name_an_unrelated_topic() -> Bool {
  !string_contains(
    s: approval_ntfy_subscriber_grant_intervention().instruction as String,
    pattern: "gunbc-approvals-staging",
  )
}
