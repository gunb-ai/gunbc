module test.claim.reference_instrument_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.design.reference_instrument {
  InstrumentBehaviourAxis, OpticalInstability, RestingOffsetCalibration,
  ImpulseGlitch, ImpulseThreshold, TiltDerivedReadout, BuoyantDrift,
  pip_boy_3000_subject, pip_boy_mk_v_subject,
  axis_is_cited_on, subject_covers_axes, directive_requested_axes,
  named_referent, named_referent_covers_directive, mk_v_covers_directive,
  axis_is_originated, axis_has_any_evidence, axis_provenance_is_total,
  all_evidence_is_contained, all_sources_read_directly,
  reference_instrument_evidence, evidence_fact_is_inside_subject_module,
  ReferenceInstrumentEvidence, impulse_glitch_evidence,
}
import extdeps.external_authority { external_subject_ref_eq }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.instrument.pip_boy_3000 {
  pip_boy_3000_settings, pip_boy_3000_setting_label,
  pip_boy_3000_glitch_modes, pip_boy_3000_glitch_mode_label,
  pip_boy_3000_licensing_statement,
}
import extdeps.instrument.pip_boy_3000_mk_v {
  pip_boy_mk_v_capabilities, pip_boy_mk_v_capability_label,
  pip_boy_mk_v_licensing_statement,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data reference_instrument_witness_note: String = "Receipts for the two cited Pip-Boy products and the join over them, RECUT against a direct read of both manuals (2026-08-04). The prior witness set was ten green claims over an inverted attribution, and it is the reason these claims are shaped differently: they read the product rosters and the evidence rows, and the evidence rows point INTO the product modules, so a wrong setting can no longer be consistent with a right attribution. What no in-repo witness can establish is that a quoted wording matches the upstream document — that is a read-path fact, carried as a SourceReadReceipt, and the lesson recorded rather than papered over is that ten structural greens did not make the upstream claim true."

fn setting_present(wanted: String) -> Bool {
  fold(pip_boy_3000_settings, init: false, f: (acc, row) =>
    acc || pip_boy_3000_setting_label(s: row.setting) == wanted)
}

fn capability_present(wanted: String) -> Bool {
  fold(pip_boy_mk_v_capabilities, init: false, f: (acc, c) =>
    acc || pip_boy_mk_v_capability_label(c: c) == wanted)
}

fn glitch_mode_present(wanted: String) -> Bool {
  fold(pip_boy_3000_glitch_modes, init: false, f: (acc, m) =>
    acc || pip_boy_3000_glitch_mode_label(m: m) == wanted)
}

test fn witness_two_products_are_distinct_subjects() -> Bool {
  return pip_boy_3000_licensing_statement != pip_boy_mk_v_licensing_statement
    && !external_subject_ref_eq(a: pip_boy_3000_subject, b: pip_boy_mk_v_subject)
}

test fn witness_impulse_settings_belong_to_the_named_referent() -> Bool {
  return setting_present(wanted: "Glitch on tap")
    && setting_present(wanted: "Tap threshold")
    && setting_present(wanted: "CRT jitter")
    && setting_present(wanted: "Vertical shift")
}

test fn witness_glitch_modes_are_grounded() -> Bool {
  return glitch_mode_present(wanted: "Off")
    && glitch_mode_present(wanted: "Short")
    && glitch_mode_present(wanted: "Persistent")
}

test fn witness_mk_v_carries_only_its_own_manuals_capabilities() -> Bool {
  return capability_present(wanted: "Changing the display colour")
    && capability_present(wanted: "Demo mode")
    && capability_present(wanted: "FM radio function")
    && !capability_present(wanted: "Glitch on tap")
    && !capability_present(wanted: "CRT jitter")
}

test fn witness_named_referent_covers_the_directive() -> Bool {
  return named_referent_covers_directive()
    && external_subject_ref_eq(a: named_referent, b: pip_boy_3000_subject)
}

test fn witness_mk_v_does_not_cover_the_directive() -> Bool {
  return !mk_v_covers_directive()
    && !axis_is_cited_on(axis: ImpulseGlitch, subject: pip_boy_mk_v_subject)
    && !axis_is_cited_on(axis: OpticalInstability, subject: pip_boy_mk_v_subject)
}

test fn witness_impulse_axes_resolve_to_the_named_referent() -> Bool {
  return axis_is_cited_on(axis: ImpulseGlitch, subject: pip_boy_3000_subject)
    && axis_is_cited_on(axis: ImpulseThreshold, subject: pip_boy_3000_subject)
    && axis_is_cited_on(axis: TiltDerivedReadout, subject: pip_boy_3000_subject)
    && axis_is_cited_on(axis: RestingOffsetCalibration, subject: pip_boy_3000_subject)
}

test fn witness_every_evidence_row_lands_in_its_own_subject_module() -> Bool {
  return all_evidence_is_contained()
}

test fn witness_a_cross_attached_evidence_row_is_refused() -> Bool {
  let cross_attached = ReferenceInstrumentEvidence {
    instrument: pip_boy_mk_v_subject,
    axis: ImpulseGlitch,
    fact: optical_fact_of_the_sibling(),
  }
  return !evidence_fact_is_inside_subject_module(row: cross_attached)
    && evidence_fact_is_inside_subject_module(row: impulse_glitch_evidence)
}

fn optical_fact_of_the_sibling() -> DeclarationRef {
  decl_ref(
    module_path: "extdeps.instrument.pip_boy_3000",
    decl_name: "glitch_on_tap_row")
}

test fn witness_buoyant_drift_is_originated_not_cited() -> Bool {
  return axis_is_originated(axis: BuoyantDrift)
    && !axis_has_any_evidence(axis: BuoyantDrift)
    && !axis_is_cited_on(axis: BuoyantDrift, subject: pip_boy_3000_subject)
    && !axis_is_cited_on(axis: BuoyantDrift, subject: pip_boy_mk_v_subject)
}

test fn witness_every_axis_has_exactly_one_provenance_kind() -> Bool {
  return axis_provenance_is_total(axis: OpticalInstability)
    && axis_provenance_is_total(axis: RestingOffsetCalibration)
    && axis_provenance_is_total(axis: ImpulseGlitch)
    && axis_provenance_is_total(axis: ImpulseThreshold)
    && axis_provenance_is_total(axis: TiltDerivedReadout)
    && axis_provenance_is_total(axis: BuoyantDrift)
}

test fn witness_both_manuals_were_read_directly() -> Bool {
  return all_sources_read_directly()
}
