module test.claim.witness_envelope_typed_consumer_witness

import std.measure { millisecond, millisecond_count }
import std.witness_admission {
  WitnessConsumerCadence,
  DiscoverySelection,
  FalsifierSelfHostWet,
  FalsifierRehomedBinWet,
  FalsifierSubstrateLongLane,
  BinWitnessWet,
  QuarantineProbeExpectRed,
  OfflineLocalRecipe,
  FixtureExplicitRoster,
  NoConsumer,
  witness_consumer_cadence_eq,
}
import std.realization_schedule {
  ScheduledWitnessEnvelope,
  scheduled_envelope_per_pr_max_staleness,
  scheduled_envelope_four_hour_max_staleness,
  scheduled_witness_envelope_wellformed,
}

data witness_envelope_typed_consumer_witness_note: String = "Slice C-b: ScheduledWitnessEnvelope carries WitnessConsumerCadence consumer and Millisecond max_staleness — no cadence or staleness strings. Every authority arm is writable on the enrollment carrier (the 7893 round-trip gap closed by typing, not by expanding wire spellings). Placement and derivation are slice C-c."

test fn envelope_per_pr_carries_discovery_selection_consumer() -> Bool {
  let envelope = ScheduledWitnessEnvelope {
    consumer: DiscoverySelection,
    wall_budget: millisecond(count: 5000),
    max_staleness: scheduled_envelope_per_pr_max_staleness(),
  }
  witness_consumer_cadence_eq(a: envelope.consumer, b: DiscoverySelection)
    && millisecond_count(m: envelope.max_staleness) == 0
}

test fn envelope_scheduled_carries_falsifier_self_host_wet_consumer() -> Bool {
  let envelope = ScheduledWitnessEnvelope {
    consumer: FalsifierSelfHostWet,
    wall_budget: millisecond(count: 900000),
    max_staleness: scheduled_envelope_four_hour_max_staleness(),
  }
  witness_consumer_cadence_eq(a: envelope.consumer, b: FalsifierSelfHostWet)
    && millisecond_count(m: envelope.max_staleness) == 14400000
}

test fn envelope_rejects_zero_wall_budget() -> Bool {
  !scheduled_witness_envelope_wellformed(
    envelope: ScheduledWitnessEnvelope {
      consumer: DiscoverySelection,
      wall_budget: millisecond(count: 0),
      max_staleness: scheduled_envelope_per_pr_max_staleness(),
    }
  )
}

test fn every_consumer_cadence_arm_is_envelope_writable() -> Bool {
  let cadences = [
    DiscoverySelection,
    FalsifierSelfHostWet,
    FalsifierRehomedBinWet,
    FalsifierSubstrateLongLane,
    BinWitnessWet,
    QuarantineProbeExpectRed,
    OfflineLocalRecipe,
    FixtureExplicitRoster,
    NoConsumer,
  ]
  length(xs: cadences) == 9
}
