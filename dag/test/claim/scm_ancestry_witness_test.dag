module test.claim.scm_ancestry_witness

import std.types { Bool, String, List }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.scm.ancestry {
  CommitAncestry,
  RootCommit,
  DescendsFrom,
  RepositoryCommitRef,
  repository_commit_ref_eq,
  CommitAncestryLookup,
  AncestryKnown,
  AncestryUnknownCommit,
  AncestryWalk,
  AncestryTraced,
  AncestryBrokenAt,
  AncestryStartNotInHistory,
  AncestryRevisitsACommit,
  ancestry_walk,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Names qualified: top-level definitions are corpus-wide and the resolver silently selects among
// duplicates (#8707), which this layer's witness files already document hitting.
//
// A REFERENCE NAMES A HISTORY ROW, so this helper no longer reaches the object store at all. The
// previous form hashed a synthetic node to mint an ObjectId, which was the wrong grain: it produced
// the identity of a PROGRAM where the walk needs the identity of a RECORD.
fn ancestry_witness_ref(name: String) -> RepositoryCommitRef {
  RepositoryCommitRef { reference: name }
}

type AncestryWitnessEntry {
  commit: RepositoryCommitRef
  ancestry: CommitAncestry
}

fn ancestry_witness_lookup_in(
  entries: List<AncestryWitnessEntry>,
  wanted: RepositoryCommitRef,
) -> CommitAncestryLookup {
  fold(entries, init: AncestryUnknownCommit, f: fn(found, e) {
    match found {
      AncestryKnown { ancestry: _ } => found
      AncestryUnknownCommit =>
        if repository_commit_ref_eq(left: e.commit, right: wanted) {
          AncestryKnown { ancestry: e.ancestry }
        } else {
          AncestryUnknownCommit
        }
    }
  })
}


// THIS WITNESS DERIVES ITS OWN BOOLEAN FROM THE WALK, which is what the deleted
// `commit_is_ancestor_of` used to do for everyone. The module no longer offers it, because
// collapsing four outcomes into `false` erased the difference between "traced, and not an ancestor"
// and "could not establish anything" -- so each consumer now decides what a refusal means to IT.
//
// WHAT THIS CONSUMER DECIDES, stated rather than buried: only a completed trace can establish
// ancestry, so the three refusal arms answer false HERE. That is safe in these witnesses and not in
// general -- the fixtures below are well-formed by construction, so the refusal arms are unreachable
// from them, and the broken-chain, cycle and unknown-start states are asserted directly by their own
// witnesses rather than through this helper. A production consumer with damaged input must not reuse
// this reasoning.
fn ancestry_witness_traces_through(
  candidate: RepositoryCommitRef,
  descendant: RepositoryCommitRef,
  history: List<RepositoryCommitRef>,
  entries: List<AncestryWitnessEntry>,
) -> Bool {
  match ancestry_walk(
    start: descendant,
    history: history,
    lookup: fn(id) { ancestry_witness_lookup_in(entries: entries, wanted: id) },
  ) {
    AncestryTraced { chain: chain } =>
      fold(chain, init: false, f: fn(seen, c) {
        if seen { true } else { repository_commit_ref_eq(left: c, right: candidate) }
      })
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// A linear history: c0 is the root, c1 descends from c0, c2 from c1.
fn ancestry_witness_linear() -> List<AncestryWitnessEntry> {
  [
    AncestryWitnessEntry { commit: ancestry_witness_ref(name: "c0"), ancestry: RootCommit },
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c1"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c0") },
    },
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c2"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c1") },
    },
  ]
}

fn ancestry_witness_linear_history() -> List<RepositoryCommitRef> {
  map(ancestry_witness_linear(), e => e.commit)
}

// THE ROOT IS ITS OWN STATE. Asserted against the alternative this module refuses -- a parent field
// holding a "nothing" value, which would make "this commit begins the history" and "this commit's
// parent is missing" the same value. Those are opposite facts: the first is every repository's
// ordinary first commit, the second is damage.
// The root/descends discrimination is asserted with a WITNESS-LOCAL reader rather than a predicate
// exported from gunbc.scm.ancestry. review 56207 objected to that export, and the decisive fact is
// that it had NO production consumer -- its only caller was this claim. A helper whose sole consumer
// is the test asserting it works belongs in the test (DESIGN section 6: an artifact with no final
// consumer). The production module keeps the coproduct and no predicate over it, so every real
// consumer matches the arms and stays exhaustive when a variant is added.
fn ancestry_witness_reads_as_root(ancestry: CommitAncestry) -> Bool {
  match ancestry {
    RootCommit => true
    DescendsFrom { parent: _ } => false
  }
}

test fn the_root_commit_is_structurally_a_root_not_a_missing_parent() -> Bool {
  ancestry_witness_reads_as_root(ancestry: RootCommit)
    && !ancestry_witness_reads_as_root(
         ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c0") }
       )
}

test fn a_linear_history_traces_from_the_start_back_to_the_root() -> Bool {
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c2"),
    history: ancestry_witness_linear_history(),
    lookup: fn(id) { ancestry_witness_lookup_in(entries: ancestry_witness_linear(), wanted: id) },
  ) {
    AncestryTraced { chain: chain } =>
      chain == [
        ancestry_witness_ref(name: "c2"),
        ancestry_witness_ref(name: "c1"),
        ancestry_witness_ref(name: "c0"),
      ]
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// A TRUNCATED HISTORY IS NOT A FINISHED ONE. c1 names c0 as its parent, but c0 is not in this
// history at all. Answering "traced" here would report a broken chain as a complete one -- the same
// shape as reporting an unreadable document as an empty one, which is the empty-observation narrow.
test fn a_parent_outside_the_history_is_broken_not_traced() -> Bool {
  let entries = [
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c1"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c0") },
    },
  ]
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c1"),
    history: [ancestry_witness_ref(name: "c1")],
    lookup: fn(id) { ancestry_witness_lookup_in(entries: entries, wanted: id) },
  ) {
    AncestryBrokenAt { commit: c, missing_parent: p } =>
      repository_commit_ref_eq(left: c, right: ancestry_witness_ref(name: "c1"))
        && repository_commit_ref_eq(left: p, right: ancestry_witness_ref(name: "c0"))
    AncestryTraced { chain: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// A CYCLE IS REFUSED, NOT TRUNCATED AND NOT LOOPED. DESIGN's substrate is bounded and forward, so a
// parent chain that returns to a commit it already visited must refuse. The RED is authorable here
// precisely because nothing constructs commits yet -- a fixture can state a cycle that no producer
// would, which is what makes this an executing wall rather than a decoration.
test fn a_cyclic_parent_chain_is_refused_rather_than_traced() -> Bool {
  let entries = [
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c0"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c1") },
    },
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c1"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "c0") },
    },
  ]
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c0"),
    history: [ancestry_witness_ref(name: "c0"), ancestry_witness_ref(name: "c1")],
    lookup: fn(id) { ancestry_witness_lookup_in(entries: entries, wanted: id) },
  ) {
    AncestryRevisitsACommit { detected_from: d } =>
      repository_commit_ref_eq(left: d, right: ancestry_witness_ref(name: "c0"))
    AncestryTraced { chain: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
  }
}

// THE CLAIM THIS MODULE EXISTS FOR: ANCESTRY IS CARRIED, NOT RECOVERED FROM POSITION.
//
// Both commits are in the history, ADJACENT, in the order a log would list them -- and neither
// descends from the other, because both are stated roots. A model that read descent off position
// would call c0 an ancestor of c1 here. Nothing does, because the relation is asserted rather than
// inferred, and this witness is what would go red if someone later "optimised" the walk into an
// index comparison.
// TWO UNRELATED ROOTS, hoisted out of the witness below so its positive companion shares this exact
// fixture by construction rather than by an author remembering to copy it.
fn ancestry_witness_two_roots() -> List<AncestryWitnessEntry> {
  [
    AncestryWitnessEntry { commit: ancestry_witness_ref(name: "c0"), ancestry: RootCommit },
    AncestryWitnessEntry { commit: ancestry_witness_ref(name: "c1"), ancestry: RootCommit },
  ]
}

fn ancestry_witness_two_roots_history() -> List<RepositoryCommitRef> {
  [ancestry_witness_ref(name: "c0"), ancestry_witness_ref(name: "c1")]
}

test fn adjacent_position_does_not_make_one_commit_an_ancestor_of_another() -> Bool {
  !ancestry_witness_traces_through(
    candidate: ancestry_witness_ref(name: "c0"),
    descendant: ancestry_witness_ref(name: "c1"),
    history: ancestry_witness_two_roots_history(),
    entries: ancestry_witness_two_roots(),
  )
}

// THE POSITIVE COMPANION FOR THE NEGATION ABOVE, OVER THE SAME FIXTURE.
//
// The negation is satisfied by a walk that FAILS for any reason, because the helper answers false on
// every refusal arm. The suite's other positive control does not rescue it: that control runs over
// the LINEAR fixture and never touches this one, so a failure that struck only this shape -- two
// records that are both roots, which is exactly the shape the revert fixture makes interesting --
// would leave the negation green and nothing else would notice.
//
// So this asserts something this fixture must answer TRUE: a walk from c1, which is itself a root,
// completes and traces exactly itself. A selective failure on this shape now reddens here.
test fn the_two_root_fixture_still_traces_a_root_to_itself() -> Bool {
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c1"),
    history: ancestry_witness_two_roots_history(),
    lookup: fn(id) {
      ancestry_witness_lookup_in(entries: ancestry_witness_two_roots(), wanted: id)
    },
  ) {
    AncestryTraced { chain: chain } => length(chain) == 1
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE ABOVE, and without it a function that answered false for everything
// would satisfy it. A STATED ancestor is found, across two generations rather than one, so the claim
// is about tracing rather than about comparing a commit to its immediate parent.
test fn a_stated_ancestor_two_generations_back_is_found() -> Bool {
  ancestry_witness_traces_through(
    candidate: ancestry_witness_ref(name: "c0"),
    descendant: ancestry_witness_ref(name: "c2"),
    history: ancestry_witness_linear_history(),
    entries: ancestry_witness_linear(),
  )
}

// DESCENT HAS A DIRECTION. c2 is not an ancestor of c0, and a walk that ignored direction -- or a
// membership test over the whole history -- would answer true here.
test fn ancestry_has_a_direction_and_a_descendant_is_not_an_ancestor() -> Bool {
  !ancestry_witness_traces_through(
    candidate: ancestry_witness_ref(name: "c2"),
    descendant: ancestry_witness_ref(name: "c0"),
    history: ancestry_witness_linear_history(),
    entries: ancestry_witness_linear(),
  )
}

// AN UNKNOWN START IS THE CALLER'S FACT, NOT A TRUNCATED HISTORY, and this is the claim review 56102
// asked for. Before the split, this answered AncestryBrokenAt with `missing_parent` set to the START
// -- a parent the input never supplied and that nothing in the history names. So the walk fabricated
// an identity, and a consumer acting on "commit X's parent Y is missing" would have gone looking for
// an object that was never claimed to exist.
//
// It asserts the START IDENTITY, not merely that some non-traced arm came back: an implementation
// that answered this arm for every input would satisfy a bare not-traced claim, and the two witnesses
// above -- a real trace and a real truncation -- are what stop that reading.
test fn a_start_outside_the_history_is_the_callers_fact_not_a_broken_chain() -> Bool {
  let entries = [
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "c1"),
      ancestry: RootCommit,
    },
  ]
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c9"),
    history: [ancestry_witness_ref(name: "c1")],
    lookup: fn(id) { ancestry_witness_lookup_in(entries: entries, wanted: id) },
  ) {
    AncestryStartNotInHistory { start: s } =>
      repository_commit_ref_eq(left: s, right: ancestry_witness_ref(name: "c9"))
    AncestryTraced { chain: _ } => false
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// AN EMPTY HISTORY CANNOT CONTAIN A CYCLE (review 56225). Before the membership gate, the fold ran
// zero steps, `done` stayed false, and the fallthrough reported AncestryRevisitsACommit -- a cycle,
// concluded from having looked at nothing. The pigeonhole argument needs at least one step taken;
// with none, it is vacuous.
//
// It asserts the START IDENTITY on the start-not-in-history arm rather than merely that the answer
// is not a cycle: an implementation answering that arm for every input would satisfy the weaker
// claim, and the traced and cyclic witnesses above are what stop that reading.
test fn an_empty_history_is_not_a_cycle() -> Bool {
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c0"),
    history: [],
    lookup: fn(id) { AncestryKnown { ancestry: RootCommit } },
  ) {
    AncestryStartNotInHistory { start: s } =>
      repository_commit_ref_eq(left: s, right: ancestry_witness_ref(name: "c0"))
    AncestryRevisitsACommit { detected_from: _ } => false
    AncestryTraced { chain: _ } => false
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
  }
}

// THE POSITIVE CONTROL FOR THE GATE, and it is the one that matters: the lookup above answers KNOWN
// for every identity, so a gate that merely trusted `lookup` would have walked happily. The claim is
// that membership in the stated HISTORY decides it, and this asserts the gate did not break the
// ordinary case where the start IS a member.
test fn a_start_inside_the_history_still_walks() -> Bool {
  let entries = [
    AncestryWitnessEntry { commit: ancestry_witness_ref(name: "c0"), ancestry: RootCommit },
  ]
  match ancestry_walk(
    start: ancestry_witness_ref(name: "c0"),
    history: [ancestry_witness_ref(name: "c0")],
    lookup: fn(id) { ancestry_witness_lookup_in(entries: entries, wanted: id) },
  ) {
    AncestryTraced { chain: chain } => chain == [ancestry_witness_ref(name: "c0")]
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
  }
}
// THE REVERT: THE HISTORY THAT ROOT-KEYED ANCESTRY CANNOT REPRESENT.
//
// This is the discriminating control for the identity grain, and it is an ORDINARY revert rather
// than a corner case: r2 restores exactly the program r0 stored, so content addressing correctly
// gives r0 and r2 the SAME root. Under the previous ObjectId-keyed model, a lookup on that shared
// root answered with r0's `RootCommit` on first match, so a walk from r2 terminated immediately and
// reported r2 as a root -- r1 and the revert edge vanished. Not a refusal: a well-formed, confident,
// wrong answer.
//
// Row references make the two occurrences distinct, so the walk traces all three. This witness stays
// enrolled after it greens (DESIGN section 4b(4)): it is the control that keeps the grain from
// drifting back, and deleting it on the grounds that it now passes would recreate exactly the
// specification-without-execution the recut removed.
fn ancestry_witness_revert() -> List<AncestryWitnessEntry> {
  [
    AncestryWitnessEntry { commit: ancestry_witness_ref(name: "r0"), ancestry: RootCommit },
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "r1"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "r0") },
    },
    AncestryWitnessEntry {
      commit: ancestry_witness_ref(name: "r2"),
      ancestry: DescendsFrom { parent: ancestry_witness_ref(name: "r1") },
    },
  ]
}

fn ancestry_witness_revert_history() -> List<RepositoryCommitRef> {
  [
    ancestry_witness_ref(name: "r0"),
    ancestry_witness_ref(name: "r1"),
    ancestry_witness_ref(name: "r2"),
  ]
}

test fn a_revert_to_an_earlier_program_still_traces_every_record() -> Bool {
  match ancestry_walk(
    start: ancestry_witness_ref(name: "r2"),
    history: ancestry_witness_revert_history(),
    lookup: fn(id) { ancestry_witness_lookup_in(entries: ancestry_witness_revert(), wanted: id) },
  ) {
    AncestryTraced { chain: chain } => length(chain) == 3
    AncestryBrokenAt { commit: _, missing_parent: _ } => false
    AncestryStartNotInHistory { start: _ } => false
    AncestryRevisitsACommit { detected_from: _ } => false
  }
}

// THE REVERTED-TO RECORD IS AN ANCESTOR OF THE REVERT, and is not the same record as it.
//
// Asserted separately from the chain length above because a walk could trace three rows and still
// have collapsed the two occurrences -- length alone does not establish that r0 and r2 stayed
// distinct. This is the assertion that a root-keyed model cannot satisfy at all.
test fn the_reverted_to_record_is_an_ancestor_and_not_the_revert_itself() -> Bool {
  ancestry_witness_traces_through(
    candidate: ancestry_witness_ref(name: "r0"),
    descendant: ancestry_witness_ref(name: "r2"),
    history: ancestry_witness_revert_history(),
    entries: ancestry_witness_revert(),
  ) && !repository_commit_ref_eq(
    left: ancestry_witness_ref(name: "r0"),
    right: ancestry_witness_ref(name: "r2"),
  )
}
