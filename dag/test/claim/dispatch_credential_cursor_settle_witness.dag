module test.claim.dispatch_credential_cursor_settle_witness

// THE CURSOR RUNTIME SETTLE (round-4 review items 2 and 6): a base this attempt created, left
// without its owner marker (marker-creation refusal, or a sweep that never spawned -- the
// manager's double-failure case), must NOT close successfully as "not owned, so it is not
// removed". The settle scans what actually stands IN the base: no marker of any attempt means
// our own garbage and the removal runs, sealing only when the parent listing positively lacks the
// base; a marker of some attempt means a foreign root and the not-owned rule leaves it alone
// untouched; a base that cannot be swept stays OWED (SealFailed), never sealed. These claims
// drive the production fold (credential_retire_cursor_runtime_root) over real fixture trees --
// red on the pre-fix head, where NotOwned blind-sealed and the base stayed on disk.

import std.types { Bool, String, NonEmptyStr, FilePath, Int }
import std.algebra { string_contains }
import std.optional { Present, Absent }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.chmod { chmod_set_mode_command }
import gunbc.command_runner { run_shell_command_capture, process_capture_admitted, LocalExec }
import gunbc.compute.attempt_lifecycle { AttemptReserved, AttemptTerminal, AttemptRecovered }
import gunbc.compute.recorded_cgroup_drain { RecordedCgroupMaySeal }
import gunbc.dispatch_credential_acquisition {
  CredentialAcquisitionRecord, CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready,
  CredentialSealed, CredentialSealFailed, CredentialSealReceipt,
  AttemptCursor, CursorRuntimeRootRegistered, CursorRuntimeRootUnregistered,
  credential_acquisition_store, credential_acquisition_slots_path,
  credential_retire_cursor_runtime_root, credential_create_cursor_runtime_root,
  CursorRuntimeRootCreationRefused, CursorRuntimeRootNotOwned,
  observe_cursor_runtime_root_fact, credential_recovery_decide,
  CredentialRecoverySealNow, CredentialRecoveryPreserve,
  credential_occupy_snapshot, CredentialReaderEnded,
  cursor_attempt_runtime_root, cursor_attempt_runtime_parent,
}
import gunbc.roadmap.roadmap_dashboard_instance { isolated_dashboard_instance, HostDashboardInstance, DashboardActuating }
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { srv1_lab_codex_feedback_deployment }

fn settle_instance(instance_root: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: srv1_lab_codex_feedback_deployment,
    instance_id: "cursor-settle-wet" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: instance_root as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18081,
    source_anchor_ref: "refs/remotes/origin/main" as NonEmptyStr,
    actuation: DashboardActuating,
    actuator_host: "macbook" as NonEmptyStr,
  )
}

fn settle_store(instance_root: String) -> CredentialAcquisitionStore? {
  let _ = shell.Mkdir.Parents(path: credential_acquisition_slots_path(instance: settle_instance(instance_root: instance_root)) as String as FilePath)
  match credential_acquisition_store(instance: settle_instance(instance_root: instance_root)) {
    CredentialAcquisitionStoreReady { store: s } => Present { value: s }
    CredentialAcquisitionStoreUnready { detail: _ } => none
  }
}

fn settle_record(reference: String) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1", node_id: "n", reference: reference, executor: AttemptCursor { runtime_root: CursorRuntimeRootRegistered }, snapshot_path: "/s",
    belt_unit: "u.service", control_group: "/g", opened_at: 10, launch_deadline: 40, state: AttemptReserved,
  }
}

fn unregistered_record(reference: String) -> CredentialAcquisitionRecord {
  CredentialAcquisitionRecord {
    identity: "id1", node_id: "n", reference: reference, executor: AttemptCursor { runtime_root: CursorRuntimeRootUnregistered }, snapshot_path: "/s",
    belt_unit: "u.service", control_group: "/g", opened_at: 10, launch_deadline: 40, state: AttemptReserved,
  }
}

fn stage_base(instance_root: String, reference: String) -> String {
  let root = cursor_attempt_runtime_root(instance_root: instance_root, reference: reference)
  if !shell.Mkdir.Parents(path: root.base as FilePath).success { return "" }
  let chmodded = run_shell_command_capture(command: chmod_set_mode_command(chmod_program: "/bin/chmod" as NonEmptyStr, mode: "700" as NonEmptyStr, path: root.base), transport: LocalExec)
  if !process_capture_admitted(captured: chmodded) { return "" }
  root.base
}

// OUR OWN MARKERLESS GARBAGE IS REMOVED, AND THE SEAL REQUIRES THE POSITIVE ABSENCE READING:
// after the retire, the parent's own listing must lack the base. Pre-fix, the NotOwned arm
// sealed while the base stood -- this claim's absence assertion is the red.
test fn a_markerless_base_this_attempt_created_is_removed_and_sealed_only_on_absence() -> Bool {
  let ir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-settle-a.XXXXXX").path as String
  match settle_store(instance_root: ir) {
    Absent => false
    Present { value: store } => {
      let r = settle_record(reference: "id1-settle-a")
      let base = stage_base(instance_root: ir, reference: r.reference)
      if base == "" { return false }
      match credential_retire_cursor_runtime_root(record: r, credentials: store) {
        CredentialSealed { path: _ } =>
          let parent_listing = Filesystem.List(path: cursor_attempt_runtime_parent(instance_root: ir))
          parent_listing.success && !string_contains(s: parent_listing.entries, pattern: r.reference)
        _ => false
      }
    }
  }
}

// THE DOUBLE-FAILURE SHAPE (manager's case (a) restaged on disk): the base stands without its
// marker AND cannot be swept -- a mode-000 directory holding a payload cannot be taken by
// rm -f. The retire must report the removal OWED (SealFailed naming the failed removal), never
// seal it away. Pre-fix this arm was a blind CredentialSealed: a silent success over a standing,
// unremovable, credential-adjacent tree.
test fn an_unsweepable_markerless_base_stays_owed_and_never_seals() -> Bool {
  let ir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-settle-b.XXXXXX").path as String
  match settle_store(instance_root: ir) {
    Absent => false
    Present { value: store } => {
      let r = settle_record(reference: "id1-settle-b")
      let base = stage_base(instance_root: ir, reference: r.reference)
      if base == "" { return false }
      let locked = join([base, "/locked"], "")
      if !shell.Mkdir.Parents(path: locked as FilePath).success { return false }
      if !Filesystem.WriteCreateNew(path: join([locked, "/payload"], ""), content: "secret material").success { return false }
      let sealed_dir = run_shell_command_capture(command: chmod_set_mode_command(chmod_program: "/bin/chmod" as NonEmptyStr, mode: "000" as NonEmptyStr, path: locked), transport: LocalExec)
      if !process_capture_admitted(captured: sealed_dir) { return false }
      let outcome = credential_retire_cursor_runtime_root(record: r, credentials: store)
      // Best-effort restore so the fixture leaves nothing unremovable behind.
      let _restore = run_shell_command_capture(command: chmod_set_mode_command(chmod_program: "/bin/chmod" as NonEmptyStr, mode: "755" as NonEmptyStr, path: locked), transport: LocalExec)
      let _cleanup = shell.Remove.RecursiveForce(path: base as FilePath)
      match outcome {
        CredentialSealFailed { detail: d } => string_contains(s: d, pattern: "could not be removed") || string_contains(s: d, pattern: "could not be listed")
        _ => false
      }
    }
  }
}

// A FOREIGN ROOT IS STILL LEFT ALONE: a base carrying an owner marker of ANOTHER attempt (the
// name embeds a different opened_at) is a root the not-owned rule exists for. The settle seals
// the record and touches nothing -- the base still stands, marker intact.
test fn a_base_carrying_another_attempts_marker_is_left_alone() -> Bool {
  let ir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-settle-c.XXXXXX").path as String
  match settle_store(instance_root: ir) {
    Absent => false
    Present { value: store } => {
      let r = settle_record(reference: "id1-settle-c")
      let base = stage_base(instance_root: ir, reference: r.reference)
      if base == "" { return false }
      if !Filesystem.WriteCreateNew(path: join([base, "/owner-id1-settle-c-9999"], ""), content: "another attempt owns this").success { return false }
      match credential_retire_cursor_runtime_root(record: r, credentials: store) {
        CredentialSealed { path: p } => (p as String) == "" && Filesystem.List(path: base).success
        _ => false
      }
    }
  }
}

// A BASE THIS ATTEMPT NEVER CREATED IS NEVER REMOVED (round-5 review, blocker 1 -- the data-loss
// counterexample): a pre-existing canonical 0700 base holding an ordinary file and no owner-* entry
// makes the create-only mkdir REFUSE, and the record of that attempt was never registered (the
// won-creation fact is persisted only after mkdir returns 0). Recovery and retire must leave that
// foreign base and its contents exactly as they were. Pre-fix, opening the slot claimed
// registration for every Cursor attempt, so this exact shape -- no competing process, no
// intervening change -- ended with the settle treating "no owner-* name" as authority to delete a
// stranger's tree.
test fn a_base_this_attempt_never_created_is_never_removed() -> Bool {
  let ir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-settle-d.XXXXXX").path as String
  match settle_store(instance_root: ir) {
    Absent => false
    Present { value: store } => {
      let r = unregistered_record(reference: "id1-settle-d")
      let base = stage_base(instance_root: ir, reference: r.reference)
      if base == "" { return false }
      if !Filesystem.WriteCreateNew(path: join([base, "/someone-elses-file"], ""), content: "not ours").success { return false }
      // THE REAL CREATE REFUSES: the pre-existing base defeats the create-only mkdir, and the
      // record stays unregistered.
      match credential_create_cursor_runtime_root(record: r, credentials: store) {
        CursorRuntimeRootCreationRefused { detail: c } =>
          string_contains(s: c, pattern: "create-only refuses a pre-existing root")
            && match credential_retire_cursor_runtime_root(record: r, credentials: store) {
                 CredentialSealed { path: _ } =>
                   Filesystem.List(path: base).success
                     && Filesystem.Read(path: join([base, "/someone-elses-file"], "")).success
                     && string_contains(s: Filesystem.Read(path: join([base, "/someone-elses-file"], "")).content, pattern: "not ours")
                 _ => false
               }
        _ => false
      }
    }
  }
}

// THE SECOND SWEEP CANNOT CALL ITS OWN SURVIVING BASE "SEALED" (round-5 review, blocker 2): the
// attempt WON the create, the marker child failed and the cleanup failed, so the terminal record,
// the tombstoned snapshot and a base standing WITHOUT its marker coexist. The next sweep's decision
// over the REAL standing tree (observe answers NotOwned only under the won-creation proof) must
// keep the base OWED -- SealNow, which runs the marker-guarded removal -- and must not answer the
// old "sealed", the receipt that let the recovery CLI exit success over the standing base. Pre-fix
// that arm was `CredentialRecoveryPreserve { reason: "sealed" }` forever.
test fn the_second_sweep_keeps_our_surviving_base_owed_never_sealed() -> Bool {
  let ir = shell.Mktemp.DirWithTemplate(template: "/tmp/cred-settle-e.XXXXXX").path as String
  match settle_store(instance_root: ir) {
    Absent => false
    Present { value: store } => {
      let r = settle_record(reference: "id1-settle-e")
      let base = stage_base(instance_root: ir, reference: r.reference)
      if base == "" { return false }
      let snap = join([ir, "/snapshot-E"], "")
      if !Filesystem.WriteCreateNew(path: snap, content: "plaintext material").success { return false }
      match credential_occupy_snapshot(path: snap) {
        CredentialSealed { path: _ } =>
          // The standing tree answers NotOwned only because the record holds the won-creation
          // proof; the sweep decision over that fact must keep the base owed.
          match observe_cursor_runtime_root_fact(record: r, credentials: store) {
            CursorRuntimeRootNotOwned { detail: _ } =>
              match credential_recovery_decide(
                record: CredentialAcquisitionRecord { identity: r.identity, node_id: r.node_id, reference: r.reference, executor: r.executor, snapshot_path: snap, belt_unit: r.belt_unit, control_group: r.control_group, opened_at: r.opened_at, launch_deadline: r.launch_deadline, state: AttemptTerminal { verdict: AttemptRecovered, detail: "reader ended" } },
                drain: RecordedCgroupMaySeal { detail: "drained" },
                now: 50,
                reader: CredentialReaderEnded,
                root: observe_cursor_runtime_root_fact(record: r, credentials: store),
              ) {
                CredentialRecoverySealNow { reason: s } =>
                  Filesystem.List(path: base).success && string_contains(s: s, pattern: "stands without its marker")
                _ => false
              }
            _ => false
          }
        _ => false
      }
    }
  }
}
