module test.claim.whole_corpus_compile_demand_projection_witness

import std.types { Bool, String, NonEmptyStr, List }
import std.measure { byte_size }
import gunbc.generated_artifact {
  GeneratedArtifact, WholeCorpusCompileMeasuredRootDemandsArtifact,
  generated_artifact_registry, artifact_eq, artifact_is_committed
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import gunbc.repository_census_observation { RepositoryIdentity, SourceRootIdentity }
import gunbc.whole_corpus_compile_admission {
  WholeCorpusCompileRootIdentity,
  MeasuredForRoot,
  UnmeasuredRoot,
  whole_corpus_compile_public_root_census,
  whole_corpus_compile_public_root_receipt,
}
import gunbc.whole_corpus_compile_demand_projection {
  whole_corpus_compile_demand_projection_json,
  expected_whole_corpus_compile_measured_root_demands_json,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// The committed projection carries the public root's whole identity key and its peak, rendered from
// the row, so the seed's join has every coordinate to join on.
test fn the_public_projection_carries_the_identity_key_and_peak() -> Bool {
  let j = expected_whole_corpus_compile_measured_root_demands_json()
  string_contains(s: j, pattern: "\"repository\": \"gunbc\"")
    && string_contains(s: j, pattern: "\"primary_root\": \"dag\"")
    && string_contains(s: j, pattern: "\"dependency_pools\": [\"src/v2\"]")
    && string_contains(s: j, pattern: "\"peak_bytes\": 17179869184")
    && string_contains(s: j, pattern: "\"schema\": \"gunbc.whole_corpus_compile_demand_projection/1\"")
}

// An unmeasured root is the ABSENCE of a row: it projects to no row, so no reader can mistake an
// authored negative for a measurement. The measured control beside it projects one row.
test fn an_unmeasured_root_projects_no_row_and_a_measured_one_projects_one() -> Bool {
  let root = WholeCorpusCompileRootIdentity {
    repository: "gunbc-private" as RepositoryIdentity,
    primary_root: "strategy" as SourceRootIdentity,
    dependency_pools: [],
  }
  let unmeasured = whole_corpus_compile_demand_projection_json(demands: [UnmeasuredRoot { root: root }])
  let measured = whole_corpus_compile_demand_projection_json(demands: [
    MeasuredForRoot { root: root, census: whole_corpus_compile_public_root_census, peak: byte_size(6442450944), receipt: whole_corpus_compile_public_root_receipt }
  ])
  string_contains(s: unmeasured, pattern: "\"rows\": []")
    && string_contains(s: measured, pattern: "\"repository\": \"gunbc-private\"")
    && string_contains(s: measured, pattern: "\"dependency_pools\": []")
    && string_contains(s: measured, pattern: "\"peak_bytes\": 6442450944")
}

// THE PROJECTION IS A REGISTERED, COMMITTED ARTIFACT, AND THAT IS ASSERTED BY IDENTITY JOIN.
// Registry membership is what puts the projection under the generated-artifact drift gate, so the
// seed's read of the committed file is held to the .dag rows. A merge once moved this variant out
// of the registry's list literal into a stray argument of concat (review 67010 on gunbc#11265),
// which the compiler refused; had it instead dropped the row, the gate would have gone quiet while
// the seed read an ungoverned file. This is the red for that direction.
fn registry_contains(a: GeneratedArtifact) -> Bool {
  fold(generated_artifact_registry, init: false, f: fn(acc, r) { acc || artifact_eq(a: r, b: a) })
}

test fn the_projection_artifact_is_registered_and_committed() -> Bool {
  registry_contains(a: WholeCorpusCompileMeasuredRootDemandsArtifact)
    && artifact_is_committed(a: WholeCorpusCompileMeasuredRootDemandsArtifact)
}
