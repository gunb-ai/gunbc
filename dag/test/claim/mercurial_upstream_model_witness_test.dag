fn mercurial_fixture_repository() -> extdeps.mercurial.MercurialRepositoryState? {
  match extdeps.mercurial.mercurial_decode_projection(projection: fixture_projection()) {
    extdeps.mercurial.MercurialDecoded { repository } => Present { value: repository }
    extdeps.mercurial.MercurialDecodeRefused { cause: _ } => Absent
    extdeps.mercurial.MercurialRepositoryUnavailable { reason: _ } => Absent
  }
}

fn mercurial_r0_fixture_expected_execution_receipt() -> String {
  "node_width=40|local_revs=0,1,2|heads=2|bookmark=left|local_tag=right|branches=default,default,default|phases=public,draft,secret|copy=bin/run<-src/main.dag|flags=exec,symlink,regular|requirements=present|verify=ok"
}

test fn witness_mercurial_upstream_authority_is_version_pinned() -> Bool {
  mercurial_upstream_version.major == 7
    && mercurial_upstream_version.minor == 2
    && mercurial_upstream_version.patch == 3
}

test fn witness_mercurial_wire_identity_decodes_to_structural_node() -> Bool {
  match extdeps.mercurial.mercurial_decode_node_identity(
    observation: extdeps.mercurial.MercurialNodeIdentityObservation {
      role: extdeps.mercurial.MercurialChangesetNodeIdentity,
      text: "1111111111111111111111111111111111111111",
    },
  ) {
    extdeps.mercurial.MercurialNodeIdentityDecoded { node } => node == hg_c0
    _ => false
  }
}

test fn witness_mercurial_wire_identity_refuses_noncanonical_text() -> Bool {
  let short = extdeps.mercurial.mercurial_decode_node_identity(
    observation: extdeps.mercurial.MercurialNodeIdentityObservation {
      role: extdeps.mercurial.MercurialChangesetNodeIdentity,
      text: "x",
    },
  )
  let non_hex = extdeps.mercurial.mercurial_decode_node_identity(
    observation: extdeps.mercurial.MercurialNodeIdentityObservation {
      role: extdeps.mercurial.MercurialChangesetNodeIdentity,
      text: "gggggggggggggggggggggggggggggggggggggggg",
    },
  )
  let uppercase = extdeps.mercurial.mercurial_decode_node_identity(
    observation: extdeps.mercurial.MercurialNodeIdentityObservation {
      role: extdeps.mercurial.MercurialChangesetNodeIdentity,
      text: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    },
  )
  match short {
    extdeps.mercurial.MercurialNodeIdentityDecodeRefused {
      cause: extdeps.mercurial.MercurialNodeIdentityWrongLength { observed },
    } => if observed == 1 {
      match non_hex {
        extdeps.mercurial.MercurialNodeIdentityDecodeRefused {
          cause: extdeps.mercurial.MercurialNodeIdentityNonHexadecimal,
        } => match uppercase {
          extdeps.mercurial.MercurialNodeIdentityDecodeRefused {
            cause: extdeps.mercurial.MercurialNodeIdentityNonCanonicalUppercase,
          } => true
          _ => false
        }
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

test fn witness_mercurial_execution_receipt_binds_native_distinctions() -> Bool {
  let receipt = mercurial_r0_fixture_expected_execution_receipt()
  string_contains(s: receipt, pattern: "local_revs=0,1,2")
    && string_contains(s: receipt, pattern: "heads=2")
    && string_contains(s: receipt, pattern: "phases=public,draft,secret")
    && string_contains(s: receipt, pattern: "copy=bin/run<-src/main.dag")
}

test fn witness_mercurial_present_identity_cannot_be_declared_missing() -> Bool {
  let invalid = extdeps.mercurial.MercurialPartialProjection {
    contents: fixture_projection_contents(),
    missing_changesets: [hg_c0],
    missing_manifests: [],
    missing_file_revisions: [hg_file_missing],
  }
  match extdeps.mercurial.mercurial_decode_projection(projection: invalid) {
    extdeps.mercurial.MercurialDecodeRefused {
      cause: extdeps.mercurial.MercurialChangesetPresentAndDeclaredMissing { changeset },
    } => changeset == hg_c0
    _ => false
  }
}

test fn witness_mercurial_inaccessible_projection_cannot_carry_repository_facts() -> Bool {
  let inaccessible = extdeps.mercurial.MercurialInaccessibleProjection {
    reason: "repository permission denied",
  }
  let mapped = extdeps.mercurial.mercurial_projection_map_contents(
    projection: inaccessible,
    map_contents: fn(contents) {
      extdeps.mercurial.MercurialRepositoryProjectionContents {
        requirements: contents.requirements,
        file_revisions: fixture_file_revisions(),
        manifests: contents.manifests,
        changesets: fixture_changesets(),
        local_revisions: contents.local_revisions,
        heads: contents.heads,
        bookmarks: contents.bookmarks,
        tags: contents.tags,
        phases: contents.phases,
        publishing: contents.publishing,
        subrepositories: contents.subrepositories,
        evolution: contents.evolution,
      }
    },
  )
  match mapped {
    extdeps.mercurial.MercurialInaccessibleProjection { reason } =>
      reason == "repository permission denied"
    _ => false
  }
}

test fn witness_mercurial_empty_inaccessible_projection_stays_unavailable() -> Bool {
  let inaccessible = extdeps.mercurial.MercurialInaccessibleProjection {
    reason: "repository permission denied",
  }
  match extdeps.mercurial.mercurial_decode_projection(projection: inaccessible) {
    extdeps.mercurial.MercurialRepositoryUnavailable { reason } =>
      reason == "repository permission denied"
    _ => false
  }
}

test fn witness_mercurial_fixture_decodes_and_projects_without_loss() -> Bool {
  match extdeps.mercurial.mercurial_decode_projection(projection: fixture_projection()) {
    extdeps.mercurial.MercurialDecodeRefused { cause: _ } => false
    extdeps.mercurial.MercurialRepositoryUnavailable { reason: _ } => false
    extdeps.mercurial.MercurialDecoded { repository } =>
      let contents = repository.contents
      let projected = extdeps.mercurial.mercurial_project_repository(repository: repository)
      match extdeps.mercurial.mercurial_assess_read_back(
        expected: repository,
        observation: extdeps.mercurial.MercurialReadBackObservation {
          projection: projected,
          observed_by: "bounded projection round-trip control",
        },
      ) {
        extdeps.mercurial.MercurialReadBackMatches { observed_by: _ } =>
          count(contents.file_revisions) == 3
            && count(contents.manifests) == 1
            && count(contents.changesets) == 3
            && count(contents.subrepositories) == 1
        _ => false
      }
  }
}

test fn witness_mercurial_readback_assessment_rejects_perturbed_observation() -> Bool {
  match mercurial_fixture_repository() {
    Absent => false
    Present { value: repository } =>
      let projected = extdeps.mercurial.mercurial_project_repository(repository: repository)
      let perturbed = projection_with_publishing(
        projection: projected,
        publishing: extdeps.mercurial.MercurialPublishingServer,
      )
      match extdeps.mercurial.mercurial_assess_read_back(
        expected: repository,
        observation: extdeps.mercurial.MercurialReadBackObservation {
          projection: perturbed,
          observed_by: "perturbed read-back RED",
        },
      ) {
        extdeps.mercurial.MercurialReadBackMismatch { observed_by: _, expected: _, observed: _ } => true
        extdeps.mercurial.MercurialReadBackMatches { observed_by: _ } => false
        extdeps.mercurial.MercurialReadBackInvalid { observed_by: _, cause: _ } => false
        extdeps.mercurial.MercurialReadBackUnavailable { observed_by: _, reason: _ } => false
      }
  }
}

test fn witness_mercurial_manifest_flags_and_raw_path_remain_distinct() -> Bool {
  match mercurial_fixture_repository() {
    Absent => false
    Present { value: repository } =>
      let contents = repository.contents
      match contents.manifests.first() {
        Absent => false
        Present { value: manifest } =>
          let entries = manifest.entries
          count(entries) == 3
            && match entries.first() {
              Present { value: entry } => match entry.flag {
                extdeps.mercurial.MercurialRegularFile => true
                _ => false
              }
              Absent => false
            }
            && match entries.skip(n: 1).first() {
              Present { value: entry } => match entry.flag {
                extdeps.mercurial.MercurialExecutableFile => true
                _ => false
              }
              Absent => false
            }
            && match entries.skip(n: 2).first() {
              Present { value: entry } =>
                entry.path == hg_path_symlink
                  && match entry.flag {
                    extdeps.mercurial.MercurialSymlink => true
                    _ => false
                  }
              Absent => false
            }
      }
  }
}

test fn witness_mercurial_copy_metadata_stays_on_file_revision() -> Bool {
