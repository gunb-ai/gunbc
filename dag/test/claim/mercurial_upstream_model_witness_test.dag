test fn witness_mercurial_branch_head_uses_same_branch_descendants_not_only_children() -> Bool {
  let changesets = [
    extdeps.mercurial.MercurialChangeset {
      node: hg_c0,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialNoParents,
      branch: "default",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-0",
      description: "default root",
    },
    extdeps.mercurial.MercurialChangeset {
      node: hg_c1,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialOneParent { parent: hg_c0 },
      branch: "feature",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-1",
      description: "feature bridge",
    },
    extdeps.mercurial.MercurialChangeset {
      node: hg_c2,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialOneParent { parent: hg_c1 },
      branch: "default",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-2",
      description: "default descendant",
    },
  ]
  let with_changesets = projection_with_changesets(
    projection: extdeps.mercurial.MercurialCompleteProjection {
      contents: fixture_projection_contents(),
    },
    changesets: changesets,
  )
  let complete = projection_with_heads(
    projection: with_changesets,
    heads: [
      extdeps.mercurial.MercurialHead { changeset: hg_c1 },
      extdeps.mercurial.MercurialHead { changeset: hg_c2 },
    ],
  )
  match extdeps.mercurial.mercurial_decode_projection(projection: complete) {
    extdeps.mercurial.MercurialDecoded { repository: _ } => true
    _ => false
  }
}

fn fixture_projection_with_closed_right_head() -> extdeps.mercurial.MercurialRepositoryProjection {
  let closed = fixture_changesets() |> map(changeset =>
    if changeset.node == hg_c2 {
      extdeps.mercurial.MercurialChangeset {
        node: changeset.node,
        manifest: changeset.manifest,
        parents: changeset.parents,
        branch: changeset.branch,
        branch_closure: extdeps.mercurial.MercurialClosesBranch,
        user: changeset.user,
        authored_at: changeset.authored_at,
        description: changeset.description,
      }
    } else {
      changeset
    }
  )
  projection_with_changesets(
    projection: extdeps.mercurial.MercurialCompleteProjection {
      contents: fixture_projection_contents(),
    },
    changesets: closed,
  )
}

test fn witness_mercurial_closed_branch_head_is_excluded_from_open_heads() -> Bool {
  let complete = projection_with_heads(
    projection: fixture_projection_with_closed_right_head(),
    heads: [extdeps.mercurial.MercurialHead { changeset: hg_c1 }],
  )
  match extdeps.mercurial.mercurial_decode_projection(projection: complete) {
    extdeps.mercurial.MercurialDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_mercurial_closed_branch_head_cannot_be_reported_as_open() -> Bool {
  let invalid = projection_with_heads(
    projection: fixture_projection_with_closed_right_head(),
    heads: [
      extdeps.mercurial.MercurialHead { changeset: hg_c1 },
      extdeps.mercurial.MercurialHead { changeset: hg_c2 },
    ],
  )
  match extdeps.mercurial.mercurial_decode_projection(projection: invalid) {
    extdeps.mercurial.MercurialDecodeRefused {
      cause: extdeps.mercurial.MercurialHeadSetMismatch { observed, derived },
    } =>
      observed == [hg_c1, hg_c2]
        && derived == [hg_c1]
    _ => false
  }
}

test fn witness_mercurial_partial_capture_does_not_invent_exact_head_set() -> Bool {
  let with_missing_head = projection_with_heads(
    projection: fixture_projection(),
    heads: [extdeps.mercurial.MercurialHead { changeset: hg_missing_c }],
  )
  let partial = match with_missing_head {
    extdeps.mercurial.MercurialPartialProjection {
      contents,
      missing_changesets: _,
      missing_manifests,
      missing_file_revisions,
    } => extdeps.mercurial.MercurialPartialProjection {
      contents: contents,
      missing_changesets: [hg_missing_c],
      missing_manifests: missing_manifests,
      missing_file_revisions: missing_file_revisions,
    }
    other => other
  }
  match extdeps.mercurial.mercurial_decode_projection(projection: partial) {
    extdeps.mercurial.MercurialDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_mercurial_two_parent_merge_decodes_with_derived_head() -> Bool {
  let projection_contents = fixture_projection_contents()
  let merge = extdeps.mercurial.MercurialChangeset {
    node: hg_c2,
    manifest: hg_manifest,
    parents: extdeps.mercurial.MercurialTwoParents { first: hg_c0, second: hg_c1 },
    branch: "default",
    branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
    user: "author@example.invalid",
    authored_at: "provenance-only-2",
    description: "merge",
  }
  let with_merge = projection_with_changesets(
    projection: fixture_projection(),
    changesets: append(
      projection_contents.changesets |> filter(c => !(c.node == hg_c2)),
      items: [merge],
    ),
  )
  let with_head = projection_with_heads(
    projection: with_merge,
    heads: [extdeps.mercurial.MercurialHead { changeset: hg_c2 }],
  )
  match extdeps.mercurial.mercurial_decode_projection(projection: with_head) {
    extdeps.mercurial.MercurialDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_mercurial_duplicate_local_revision_refuses() -> Bool {
  let invalid = projection_with_local_revisions(
    projection: fixture_projection(),
    local_revisions: [
      extdeps.mercurial.MercurialLocalRevisionEntry {
        revision: extdeps.mercurial.MercurialLocalRevision { value: 0 },
        changeset: hg_c0,
      },
      extdeps.mercurial.MercurialLocalRevisionEntry {
        revision: extdeps.mercurial.MercurialLocalRevision { value: 0 },
        changeset: hg_c1,
      },
    ],
  )
  match extdeps.mercurial.mercurial_decode_projection(projection: invalid) {
    extdeps.mercurial.MercurialDecodeRefused { cause: _ } => true
    extdeps.mercurial.MercurialDecoded { repository: _ } => false
    extdeps.mercurial.MercurialRepositoryUnavailable { reason: _ } => false
  }
}

test fn witness_mercurial_r0_write_capability_stays_unavailable() -> Bool {
  match extdeps.mercurial.mercurial_r0_conditional_advance {
    extdeps.mercurial.MercurialConditionalAdvanceUnavailable { reason } =>
      string_contains(s: reason, pattern: "no executing transaction transport")
  }
}
