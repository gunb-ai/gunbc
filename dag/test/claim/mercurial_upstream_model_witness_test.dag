test fn witness_mercurial_duplicate_changeset_parent_refuses() -> Bool {
  let projection_contents = fixture_projection_contents()
  let duplicate_parent = MercurialChangeset {
    node: hg_c2,
    manifest: hg_manifest,
    parents: MercurialTwoParents { first: hg_c0, second: hg_c0 },
    branch: "default",
    user: "author@example.invalid",
    authored_at: "provenance-only-2",
    description: "right",
  }
  let invalid = projection_with_changesets(
    projection: fixture_projection(),
    changesets: append(
      projection_contents.changesets |> filter(c => !(c.node == hg_c2)),
      items: [duplicate_parent],
    ),
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialDuplicateChangesetParent { changeset, parent },
    } => changeset == hg_c2 && parent == hg_c0
    _ => false
  }
}

test fn witness_mercurial_changeset_self_parent_refuses_as_cycle() -> Bool {
  let projection_contents = fixture_projection_contents()
  let self_parent = MercurialChangeset {
    node: hg_c2,
    manifest: hg_manifest,
    parents: MercurialOneParent { parent: hg_c2 },
    branch: "default",
    user: "author@example.invalid",
    authored_at: "provenance-only-2",
    description: "right",
  }
  let invalid = projection_with_changesets(
    projection: fixture_projection(),
    changesets: append(
      projection_contents.changesets |> filter(c => !(c.node == hg_c2)),
      items: [self_parent],
    ),
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialChangesetAncestryCycle { changeset },
    } => changeset == hg_c2
    _ => false
  }
}

test fn witness_mercurial_multi_revision_changeset_cycle_refuses() -> Bool {
  let cycle_left = MercurialChangeset {
    node: hg_c1,
    manifest: hg_manifest,
    parents: MercurialOneParent { parent: hg_c2 },
    branch: "default",
    user: "author@example.invalid",
    authored_at: "provenance-only-1",
    description: "left",
  }
  let cycle_right = MercurialChangeset {
    node: hg_c2,
    manifest: hg_manifest,
    parents: MercurialOneParent { parent: hg_c1 },
    branch: "default",
    user: "author@example.invalid",
    authored_at: "provenance-only-2",
    description: "right",
  }
  let invalid = projection_with_changesets(
    projection: fixture_projection(),
    changesets: [
      MercurialChangeset {
        node: hg_c0,
        manifest: hg_manifest,
        parents: MercurialNoParents,
        branch: "default",
        user: "author@example.invalid",
        authored_at: "provenance-only-0",
        description: "root",
      },
      cycle_left,
      cycle_right,
    ],
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialChangesetAncestryCycle { changeset },
    } => changeset == hg_c1 || changeset == hg_c2
    _ => false
  }
}

test fn witness_mercurial_file_revision_cycle_refuses() -> Bool {
  let cycle_regular = MercurialFileRevision {
    node: hg_file_regular,
    parents: MercurialOneParent { parent: hg_file_executable },
    copy: MercurialNotCopied,
    content: octets_bytes(o: [109, 97, 105, 110]),
  }
  let cycle_executable = MercurialFileRevision {
    node: hg_file_executable,
    parents: MercurialOneParent { parent: hg_file_regular },
    copy: MercurialCopiedFrom {
      path: hg_path_regular,
      file_revision: hg_file_regular,
    },
    content: octets_bytes(o: [114, 117, 110]),
  }
  let invalid = projection_with_file_revisions(
    projection: fixture_projection(),
    file_revisions: [
      cycle_regular,
      cycle_executable,
      MercurialFileRevision {
        node: hg_file_symlink,
        parents: MercurialNoParents,
        copy: MercurialNotCopied,
        content: octets_bytes(o: [46, 46, 47, 109, 97, 105, 110]),
      },
    ],
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialFileRevisionAncestryCycle { file_revision },
    } =>
      file_revision == hg_file_regular || file_revision == hg_file_executable
    _ => false
  }
}

test fn witness_mercurial_duplicate_file_revision_parent_refuses() -> Bool {
  let duplicate_parent = MercurialFileRevision {
    node: hg_file_executable,
    parents: MercurialTwoParents {
      first: hg_file_regular,
      second: hg_file_regular,
    },
    copy: MercurialCopiedFrom {
      path: hg_path_regular,
      file_revision: hg_file_regular,
    },
    content: octets_bytes(o: [114, 117, 110]),
  }
  let invalid = projection_with_file_revisions(
    projection: fixture_projection(),
    file_revisions: append(
      fixture_file_revisions()
        |> filter(file_revision =>
          !(file_revision.node == hg_file_executable)
        ),
      items: [duplicate_parent],
    ),
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialDuplicateFileRevisionParent {
        file_revision,
        parent,
      },
    } =>
      file_revision == hg_file_executable
        && parent == hg_file_regular
    _ => false
  }
}

test fn witness_mercurial_observed_non_head_refuses() -> Bool {
  let invalid = projection_with_heads(
    projection: MercurialCompleteProjection {
      contents: fixture_projection_contents(),
    },
    heads: [MercurialHead { changeset: hg_c0 }],
  )
  match mercurial_decode_projection(projection: invalid) {
    MercurialDecodeRefused {
      cause: MercurialHeadSetMismatch { observed, derived },
    } =>
      observed == [hg_c0]
        && derived == [hg_c1, hg_c2]
    _ => false
  }
}

test fn witness_mercurial_partial_capture_does_not_invent_exact_head_set() -> Bool {
  let with_missing_head = projection_with_heads(
    projection: fixture_projection(),
    heads: [MercurialHead { changeset: hg_missing_c }],
  )
  let partial = match with_missing_head {
    MercurialPartialProjection {
      contents,
      missing_changesets: _,
      missing_manifests,
      missing_file_revisions,
    } => MercurialPartialProjection {
      contents: contents,
      missing_changesets: [hg_missing_c],
      missing_manifests: missing_manifests,
      missing_file_revisions: missing_file_revisions,
    }
    other => other
  }
  match mercurial_decode_projection(projection: partial) {
    MercurialDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_mercurial_two_parent_merge_decodes_with_derived_head() -> Bool {
  let projection_contents = fixture_projection_contents()
  let merge = MercurialChangeset {
    node: hg_c2,
    manifest: hg_manifest,
    parents: MercurialTwoParents { first: hg_c0, second: hg_c1 },
    branch: "default",
    user: "author@example.invalid",
    authored_at: "provenance-only-2",
    description: "merge",
  }
  let with_merge = projection_with_changesets(
    projection: fixture_projection(),
    changesets: append(
      projection_contents.changesets |> filter(c => !(c.node == hg_c2)),
      items: [merge],
    ),
  )
  let with_head = projection_with_heads(
    projection: with_merge,
    heads: [MercurialHead { changeset: hg_c2 }],
  )
  match mercurial_decode_projection(projection: with_head) {
    MercurialDecoded { repository: _ } => true
    _ => false
  }
}

test fn witness_mercurial_duplicate_local_revision_refuses() -> Bool {
  let invalid = projection_with_local_revisions(
