import std.bytes { octets_bytes }
import std.integer { UInt8 }

fn repeated_mercurial_node_id(octet: UInt8) -> MercurialNodeId {
  MercurialNodeId {
    octet00: octet,
    octet01: octet,
    octet02: octet,
    octet03: octet,
    octet04: octet,
    octet05: octet,
    octet06: octet,
    octet07: octet,
    octet08: octet,
    octet09: octet,
    octet10: octet,
    octet11: octet,
    octet12: octet,
    octet13: octet,
    octet14: octet,
    octet15: octet,
    octet16: octet,
    octet17: octet,
    octet18: octet,
    octet19: octet,
  }
}

data hg_c0: MercurialNodeId = repeated_mercurial_node_id(octet: 17)
data hg_c1: MercurialNodeId = repeated_mercurial_node_id(octet: 34)
data hg_c2: MercurialNodeId = repeated_mercurial_node_id(octet: 51)
data hg_missing_c: MercurialNodeId = repeated_mercurial_node_id(octet: 68)

data hg_manifest: MercurialNodeId = repeated_mercurial_node_id(octet: 170)
data hg_file_regular: MercurialNodeId = repeated_mercurial_node_id(octet: 187)
data hg_file_executable: MercurialNodeId = repeated_mercurial_node_id(octet: 204)
data hg_file_symlink: MercurialNodeId = repeated_mercurial_node_id(octet: 221)
data hg_file_missing: MercurialNodeId = repeated_mercurial_node_id(octet: 238)
data hg_file_undeclared: MercurialNodeId = repeated_mercurial_node_id(octet: 255)

data hg_path_regular: MercurialPath = MercurialPath {
  octets: [115, 114, 99, 47, 109, 97, 105, 110, 46, 100, 97, 103]
}
data hg_path_executable: MercurialPath = MercurialPath {
  octets: [98, 105, 110, 47, 114, 117, 110]
}
data hg_path_symlink: MercurialPath = MercurialPath {
  octets: [255, 46, 108, 105, 110, 107]
}
data hg_path_subrepo: MercurialPath = MercurialPath {
  octets: [118, 101, 110, 100, 111, 114]
}

fn fixture_file_revisions() -> List<MercurialFileRevision> {
  [
    MercurialFileRevision {
      node: hg_file_regular,
      parents: MercurialNoParents,
      copy: MercurialNotCopied,
      content: octets_bytes(o: [109, 97, 105, 110]),
    },
    MercurialFileRevision {
      node: hg_file_executable,
      parents: MercurialOneParent { parent: hg_file_regular },
      copy: MercurialCopiedFrom {
        path: hg_path_regular,
        file_revision: hg_file_regular,
      },
      content: octets_bytes(o: [114, 117, 110]),
    },
    MercurialFileRevision {
      node: hg_file_symlink,
      parents: MercurialNoParents,
      copy: MercurialNotCopied,
      content: octets_bytes(o: [46, 46, 47, 109, 97, 105, 110]),
    },
  ]
}

fn fixture_manifest_wire() -> MercurialManifestWire {
  MercurialManifestWire {
    node: hg_manifest,
    entries: [
      MercurialManifestWireEntry {
        path: hg_path_regular,
        file_revision: hg_file_regular,
        flag: "",
      },
      MercurialManifestWireEntry {
        path: hg_path_executable,
        file_revision: hg_file_executable,
        flag: "x",
      },
      MercurialManifestWireEntry {
        path: hg_path_symlink,
        file_revision: hg_file_symlink,
        flag: "l",
      },
    ],
  }
}

fn fixture_changesets() -> List<MercurialChangeset> {
  [
    MercurialChangeset {
      node: hg_c0,
      manifest: hg_manifest,
      parents: MercurialNoParents,
      branch: "default",
      user: "author@example.invalid",
      authored_at: "provenance-only-0",
      description: "root",
    },
    MercurialChangeset {
      node: hg_c1,
      manifest: hg_manifest,
      parents: MercurialOneParent { parent: hg_c0 },
      branch: "default",
      user: "author@example.invalid",
      authored_at: "provenance-only-1",
      description: "left",
    },
    MercurialChangeset {
      node: hg_c2,
      manifest: hg_manifest,
      parents: MercurialOneParent { parent: hg_c0 },
      branch: "default",
      user: "author@example.invalid",
      authored_at: "provenance-only-2",
      description: "right",
    },
  ]
}

fn local_revisions_a() -> List<MercurialLocalRevisionEntry> {
  [
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 0 },
      changeset: hg_c0,
    },
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 1 },
      changeset: hg_c1,
    },
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 2 },
      changeset: hg_c2,
    },
  ]
}

fn local_revisions_b() -> List<MercurialLocalRevisionEntry> {
  [
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 17 },
      changeset: hg_c0,
    },
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 4 },
      changeset: hg_c1,
    },
    MercurialLocalRevisionEntry {
      revision: MercurialLocalRevision { value: 9 },
      changeset: hg_c2,
    },
  ]
}

fn fixture_projection_contents_with_local_revisions(
  local_revisions: List<MercurialLocalRevisionEntry>,
) -> MercurialRepositoryProjectionContents {
  MercurialRepositoryProjectionContents {
    requirements: MercurialRepositoryRequirements {
      tokens: ["revlogv1", "store", "fncache", "dotencode"],
    },
    file_revisions: fixture_file_revisions(),
    manifests: [fixture_manifest_wire()],
    changesets: fixture_changesets(),
    local_revisions: local_revisions,
    heads: [
      MercurialHead { changeset: hg_c1 },
      MercurialHead { changeset: hg_c2 },
    ],
    bookmarks: [
      MercurialBookmark { name: "main", target: hg_c1 },
    ],
    tags: [
      MercurialTag { name: "v0", target: hg_c0, source: MercurialVersionedTag },
      MercurialTag { name: "scratch", target: hg_c2, source: MercurialLocalTag },
    ],
    phases: [
      MercurialPhaseWireEntry { changeset: hg_c0, phase: "public" },
      MercurialPhaseWireEntry { changeset: hg_c1, phase: "draft" },
      MercurialPhaseWireEntry { changeset: hg_c2, phase: "secret" },
    ],
    publishing: MercurialNonPublishingServer,
    subrepositories: [
      MercurialSubrepository {
        path: hg_path_subrepo,
        source: "https://example.invalid/vendor",
        revision: "portable-upstream-revision",
      },
    ],
    evolution: MercurialEvolutionMarkers {
      markers: [
        MercurialObsolescenceMarker {
          predecessor: hg_c1,
          successors: [hg_c2],
          operation: "rebase",
        },
      ],
    },
  }
}

fn fixture_projection_with_local_revisions(
  local_revisions: List<MercurialLocalRevisionEntry>,
) -> MercurialRepositoryProjection {
  MercurialPartialProjection {
    contents: fixture_projection_contents_with_local_revisions(
      local_revisions: local_revisions,
    ),
    missing_changesets: [],
    missing_manifests: [],
    missing_file_revisions: [hg_file_missing],
  }
}

fn fixture_projection_contents() -> MercurialRepositoryProjectionContents {
  fixture_projection_contents_with_local_revisions(
    local_revisions: local_revisions_a(),
  )
}

fn fixture_projection() -> MercurialRepositoryProjection {
  fixture_projection_with_local_revisions(local_revisions: local_revisions_a())
}

fn projection_with_phases(
  projection: MercurialRepositoryProjection,
  phases: List<MercurialPhaseWireEntry>,
) -> MercurialRepositoryProjection {
  mercurial_projection_map_contents(
    projection: projection,
    map_contents: fn(contents) {
      MercurialRepositoryProjectionContents {
        requirements: contents.requirements,
        file_revisions: contents.file_revisions,
        manifests: contents.manifests,
        changesets: contents.changesets,
        local_revisions: contents.local_revisions,
        heads: contents.heads,
        bookmarks: contents.bookmarks,
        tags: contents.tags,
        phases: phases,
        publishing: contents.publishing,
        subrepositories: contents.subrepositories,
        evolution: contents.evolution,
      }
    },
  )
}

