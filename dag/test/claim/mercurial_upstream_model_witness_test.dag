fn projection_with_replaced_root_node(
  node: MercurialNodeId,
) -> MercurialRepositoryProjection {
  projection_with_changesets(
    projection: fixture_projection(),
    changesets: fixture_changesets() |> map(changeset =>
      if changeset.node == hg_c0 {
        MercurialChangeset {
          node: node,
          manifest: changeset.manifest,
          parents: changeset.parents,
          branch: changeset.branch,
          user: changeset.user,
          authored_at: changeset.authored_at,
          description: changeset.description,
        }
      } else {
        changeset
      }
    ),
  )
}

