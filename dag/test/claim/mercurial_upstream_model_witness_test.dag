module test.claim.mercurial_upstream_model_witness


fn repeated_mercurial_node_id(octet: std.integer.UInt8) -> extdeps.mercurial.MercurialNodeId {
  extdeps.mercurial.MercurialNodeId {
    octet00: octet,
    octet01: octet,
    octet02: octet,
    octet03: octet,
    octet04: octet,
    octet05: octet,
    octet06: octet,
    octet07: octet,
    octet08: octet,
    octet09: octet,
    octet10: octet,
    octet11: octet,
    octet12: octet,
    octet13: octet,
    octet14: octet,
    octet15: octet,
    octet16: octet,
    octet17: octet,
    octet18: octet,
    octet19: octet,
  }
}

data hg_c0: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 17)
data hg_c1: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 34)
data hg_c2: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 51)
data hg_missing_c: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 68)

data hg_manifest: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 170)
data hg_file_regular: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 187)
data hg_file_executable: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 204)
data hg_file_symlink: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 221)
data hg_file_missing: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 238)
data hg_file_undeclared: extdeps.mercurial.MercurialNodeId = repeated_mercurial_node_id(octet: 255)

data hg_path_regular: extdeps.mercurial.MercurialPath = extdeps.mercurial.MercurialPath {
  octets: [115, 114, 99, 47, 109, 97, 105, 110, 46, 100, 97, 103]
}
data hg_path_executable: extdeps.mercurial.MercurialPath = extdeps.mercurial.MercurialPath {
  octets: [98, 105, 110, 47, 114, 117, 110]
}
data hg_path_symlink: extdeps.mercurial.MercurialPath = extdeps.mercurial.MercurialPath {
  octets: [255, 46, 108, 105, 110, 107]
}
data hg_path_subrepo: extdeps.mercurial.MercurialPath = extdeps.mercurial.MercurialPath {
  octets: [118, 101, 110, 100, 111, 114]
}

fn fixture_file_revisions() -> List<extdeps.mercurial.MercurialFileRevision> {
  [
    extdeps.mercurial.MercurialFileRevision {
      node: hg_file_regular,
      parents: extdeps.mercurial.MercurialNoParents,
      copy: extdeps.mercurial.MercurialNotCopied,
      content: std.bytes.octets_bytes(o: [109, 97, 105, 110]),
    },
    extdeps.mercurial.MercurialFileRevision {
      node: hg_file_executable,
      parents: extdeps.mercurial.MercurialOneParent { parent: hg_file_regular },
      copy: extdeps.mercurial.MercurialCopiedFrom {
        path: hg_path_regular,
        file_revision: hg_file_regular,
      },
      content: std.bytes.octets_bytes(o: [114, 117, 110]),
    },
    extdeps.mercurial.MercurialFileRevision {
      node: hg_file_symlink,
      parents: extdeps.mercurial.MercurialNoParents,
      copy: extdeps.mercurial.MercurialNotCopied,
      content: std.bytes.octets_bytes(o: [46, 46, 47, 109, 97, 105, 110]),
    },
  ]
}

fn fixture_manifest_wire() -> extdeps.mercurial.MercurialManifestWire {
  extdeps.mercurial.MercurialManifestWire {
    node: hg_manifest,
    entries: [
      extdeps.mercurial.MercurialManifestWireEntry {
        path: hg_path_regular,
        file_revision: hg_file_regular,
        flag: "",
      },
      extdeps.mercurial.MercurialManifestWireEntry {
        path: hg_path_executable,
        file_revision: hg_file_executable,
        flag: "x",
      },
      extdeps.mercurial.MercurialManifestWireEntry {
        path: hg_path_symlink,
        file_revision: hg_file_symlink,
        flag: "l",
      },
    ],
  }
}

fn fixture_changesets() -> List<extdeps.mercurial.MercurialChangeset> {
  [
    extdeps.mercurial.MercurialChangeset {
      node: hg_c0,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialNoParents,
      branch: "default",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-0",
      description: "root",
    },
    extdeps.mercurial.MercurialChangeset {
      node: hg_c1,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialOneParent { parent: hg_c0 },
      branch: "default",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-1",
      description: "left",
    },
    extdeps.mercurial.MercurialChangeset {
      node: hg_c2,
      manifest: hg_manifest,
      parents: extdeps.mercurial.MercurialOneParent { parent: hg_c0 },
      branch: "default",
      branch_closure: extdeps.mercurial.MercurialBranchRemainsOpen,
      user: "author@example.invalid",
      authored_at: "provenance-only-2",
      description: "right",
    },
  ]
}

fn local_revisions_a() -> List<extdeps.mercurial.MercurialLocalRevisionEntry> {
  [
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 0 },
      changeset: hg_c0,
    },
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 1 },
      changeset: hg_c1,
    },
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 2 },
      changeset: hg_c2,
    },
  ]
}

fn local_revisions_b() -> List<extdeps.mercurial.MercurialLocalRevisionEntry> {
  [
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 17 },
      changeset: hg_c0,
    },
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 4 },
      changeset: hg_c1,
    },
    extdeps.mercurial.MercurialLocalRevisionEntry {
      revision: extdeps.mercurial.MercurialLocalRevision { value: 9 },
      changeset: hg_c2,
    },
  ]
}

fn fixture_projection_contents_with_local_revisions(
  local_revisions: List<extdeps.mercurial.MercurialLocalRevisionEntry>,
) -> extdeps.mercurial.MercurialRepositoryProjectionContents {
  extdeps.mercurial.MercurialRepositoryProjectionContents {
    requirements: extdeps.mercurial.MercurialRepositoryRequirements {
      tokens: ["revlogv1", "store", "fncache", "dotencode"],
    },
    file_revisions: fixture_file_revisions(),
    manifests: [fixture_manifest_wire()],
    changesets: fixture_changesets(),
    local_revisions: local_revisions,
    heads: [
      extdeps.mercurial.MercurialHead { changeset: hg_c1 },
      extdeps.mercurial.MercurialHead { changeset: hg_c2 },
    ],
    bookmarks: [
      extdeps.mercurial.MercurialBookmark { name: "main", target: hg_c1 },
    ],
    tags: [
      extdeps.mercurial.MercurialTag { name: "v0", target: hg_c0, source: extdeps.mercurial.MercurialVersionedTag },
      extdeps.mercurial.MercurialTag { name: "scratch", target: hg_c2, source: extdeps.mercurial.MercurialLocalTag },
    ],
    phases: [
      extdeps.mercurial.MercurialPhaseWireEntry { changeset: hg_c0, phase: "public" },
      extdeps.mercurial.MercurialPhaseWireEntry { changeset: hg_c1, phase: "draft" },
      extdeps.mercurial.MercurialPhaseWireEntry { changeset: hg_c2, phase: "secret" },
    ],
    publishing: extdeps.mercurial.MercurialNonPublishingServer,
    subrepositories: [
      extdeps.mercurial.MercurialSubrepository {
        path: hg_path_subrepo,
        source: "https://example.invalid/vendor",
        revision: "portable-upstream-revision",
      },
    ],
    evolution: extdeps.mercurial.MercurialEvolutionMarkers {
      markers: [
        extdeps.mercurial.MercurialObsolescenceMarker {
          predecessor: hg_c1,
          successors: [hg_c2],
          operation: "rebase",
        },
      ],
    },
  }
}

fn fixture_projection_with_local_revisions(
  local_revisions: List<extdeps.mercurial.MercurialLocalRevisionEntry>,
) -> extdeps.mercurial.MercurialRepositoryProjection {
  extdeps.mercurial.MercurialPartialProjection {
    contents: fixture_projection_contents_with_local_revisions(
      local_revisions: local_revisions,
    ),
    missing_changesets: [],
    missing_manifests: [],
    missing_file_revisions: [hg_file_missing],
  }
}

fn fixture_projection_contents() -> extdeps.mercurial.MercurialRepositoryProjectionContents {
  fixture_projection_contents_with_local_revisions(
    local_revisions: local_revisions_a(),
  )
}

fn mercurial_r0_fixture_projection() -> extdeps.mercurial.MercurialRepositoryProjection {
  fixture_projection_with_local_revisions(local_revisions: local_revisions_a())
}

fn fixture_projection() -> extdeps.mercurial.MercurialRepositoryProjection {
  mercurial_r0_fixture_projection()
}

fn projection_with_phases(
  projection: extdeps.mercurial.MercurialRepositoryProjection,
  phases: List<extdeps.mercurial.MercurialPhaseWireEntry>,
) -> extdeps.mercurial.MercurialRepositoryProjection {
  extdeps.mercurial.mercurial_projection_map_contents(
    projection: projection,
    map_contents: fn(contents) {
      extdeps.mercurial.MercurialRepositoryProjectionContents {
        requirements: contents.requirements,
        file_revisions: contents.file_revisions,
        manifests: contents.manifests,
        changesets: contents.changesets,
        local_revisions: contents.local_revisions,
        heads: contents.heads,
        bookmarks: contents.bookmarks,
        tags: contents.tags,
        phases: phases,
        publishing: contents.publishing,
        subrepositories: contents.subrepositories,
        evolution: contents.evolution,
      }
    },
  )
}

