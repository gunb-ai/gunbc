    extdeps.mercurial.MercurialDecoded { repository } =>
      let contents = repository.contents
      match contents.file_revisions.skip(n: 2).first() {
        Absent => false
        Present { value: file_revision } => match file_revision.copy {
          extdeps.mercurial.MercurialCopiedFrom { path: _, file_revision: source_revision } =>
            source_revision == hg_file_missing
          extdeps.mercurial.MercurialNotCopied => false
        }
      }
  }
}

test fn witness_mercurial_clone_local_revision_can_change_without_identity_change() -> Bool {
  let a = extdeps.mercurial.mercurial_decode_projection(
    projection: fixture_projection_with_local_revisions(local_revisions: local_revisions_a()),
  )
  let b = extdeps.mercurial.mercurial_decode_projection(
    projection: fixture_projection_with_local_revisions(local_revisions: local_revisions_b()),
  )
  match a {
    extdeps.mercurial.MercurialDecodeRefused { cause: _ } => false
    extdeps.mercurial.MercurialRepositoryUnavailable { reason: _ } => false
    extdeps.mercurial.MercurialDecoded { repository: repo_a } => match b {
      extdeps.mercurial.MercurialDecodeRefused { cause: _ } => false
      extdeps.mercurial.MercurialRepositoryUnavailable { reason: _ } => false
      extdeps.mercurial.MercurialDecoded { repository: repo_b } =>
        let contents_a = repo_a.contents
        let contents_b = repo_b.contents
        extdeps.mercurial.mercurial_portable_history(repository: repo_a) == extdeps.mercurial.mercurial_portable_history(repository: repo_b)
          && !(contents_a.local_revisions == contents_b.local_revisions)
    }
  }
}

