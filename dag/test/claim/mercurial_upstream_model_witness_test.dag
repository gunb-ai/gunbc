test fn witness_mercurial_publishing_and_secret_exchange_rules_remain_distinct() -> Bool {
  match extdeps.mercurial.mercurial_exchange_disposition(
    publishing: extdeps.mercurial.MercurialPublishingServer,
    phase: extdeps.mercurial.MercurialDraft,
  ) {
    extdeps.mercurial.MercurialExchangeVisible { resulting_phase: extdeps.mercurial.MercurialPublic } =>
      match extdeps.mercurial.mercurial_exchange_disposition(
        publishing: extdeps.mercurial.MercurialNonPublishingServer,
        phase: extdeps.mercurial.MercurialDraft,
      ) {
        extdeps.mercurial.MercurialExchangeVisible { resulting_phase: extdeps.mercurial.MercurialDraft } =>
          match extdeps.mercurial.mercurial_exchange_disposition(
            publishing: extdeps.mercurial.MercurialPublishingServer,
            phase: extdeps.mercurial.MercurialSecret,
          ) {
            extdeps.mercurial.MercurialExchangeWithheld => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

