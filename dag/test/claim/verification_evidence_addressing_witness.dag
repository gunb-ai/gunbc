data fixture_head: CommitSha = "cafecafecafecafecafecafecafecafecafecafe" as CommitSha

data fixture_other_head: CommitSha = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" as CommitSha

data fixture_window_w1: Fnv1a64Structural = git_diff_window_absent_identity()

data fixture_window_w2: Fnv1a64Structural = content_hash_atom(
  value: "recut-a-window-two-fixture" as NonEmptyStr,
)

fn fixture_subject(window: Fnv1a64Structural) -> VerificationSubject {
  VerificationSubject {
    node_identity: "rnfx-recut-a" as NonEmptyStr as RoadmapNodeIdentity,
    criteria_digest: content_hash_atom(value: "recut-a-criteria"),
    attempt_key: "feedfacefeedface",
    branch: "dispatch/recut-a-afeedfacefeedface" as NonEmptyStr,
    head_sha: fixture_head,
    change_window_identity: window,
  }
}

fn fixture_receipt(
  window: Fnv1a64Structural,
  verdict: ValidationVerdict,
) -> VerificationReceipt {
  VerificationReceipt {
    subject: fixture_subject(window: window),
    oracle_identity: content_hash_of_value(value: "oracle-fixture"),
    executions: [],
    verdict: verdict,
  }
}

fn v1_legacy_receipt_text() -> String {
  serialize_json(v: json_object(members: [
    json_kv(
      key: "schema",
      value: json_string(s: verification_receipt_schema_v1 as String),
    ),
    json_kv(
      key: "subject",
      value: json_object(members: [
        json_kv(key: "node_identity", value: json_string(s: "rnfx-recut-a")),
        json_kv(
          key: "criteria_digest",
          value: json_string(
            s: serialize_content_hash(
              hash: as_content_hash_structural(
                structural: content_hash_atom(value: "recut-a-criteria"),
              ),
            ) as String,
          ),
        ),
        json_kv(key: "attempt_key", value: json_string(s: "feedfacefeedface")),
        json_kv(
          key: "branch",
          value: json_string(s: "dispatch/recut-a-afeedfacefeedface"),
        ),
        json_kv(key: "head_sha", value: json_string(s: fixture_head as String)),
      ]),
    ),
    json_kv(
      key: "oracle_identity",
      value: json_string(
        s: serialize_content_hash(
          hash: content_hash_of_value(value: "oracle-fixture"),
        ) as String,
      ),
    ),
    json_kv(key: "executions", value: json_array(elements: [])),
    json_kv(
      key: "verdict",
      value: json_object(members: [
        json_kv(key: "key", value: json_string(s: "passed")),
        json_kv(key: "command", value: json_string(s: "fixture-command")),
        json_kv(
          key: "oracle_identity",
          value: json_string(
            s: serialize_content_hash(
              hash: content_hash_of_value(value: "oracle-fixture"),
            ) as String,
          ),
        ),
      ]),
    ),
  ]))
}

// FACTORED SO THE TWO FIXTURES DIFFER IN EXACTLY ONE MEMBER. A hand-authored second document would
// let an unrelated typo produce the refusal the witness attributes to the missing verdict; sharing
// the prefix makes the verdict the only variable.
fn v1_receipt_members_without_verdict() -> List<JsonKeyValue> {
  [
    json_kv(
      key: "schema",
      value: json_string(s: verification_receipt_schema_v1 as String),
    ),
    json_kv(
      key: "subject",
      value: json_object(members: [
        json_kv(key: "node_identity", value: json_string(s: "rnfx-recut-a")),
        json_kv(
          key: "criteria_digest",
          value: json_string(
            s: serialize_content_hash(
              hash: as_content_hash_structural(
                structural: content_hash_atom(value: "recut-a-criteria"),
              ),
            ) as String,
          ),
        ),
        json_kv(key: "attempt_key", value: json_string(s: "feedfacefeedface")),
        json_kv(
          key: "branch",
          value: json_string(s: "dispatch/recut-a-afeedfacefeedface"),
        ),
        json_kv(key: "head_sha", value: json_string(s: fixture_head as String)),
      ]),
    ),
    json_kv(
      key: "oracle_identity",
      value: json_string(
        s: serialize_content_hash(
          hash: content_hash_of_value(value: "oracle-fixture"),
        ) as String,
      ),
    ),
    json_kv(
      key: "executions",
      value: json_array(elements: [
        json_object(members: [
          json_kv(
            key: "validation",
            value: json_object(members: [
              json_kv(key: "kind", value: json_string(s: "cargo-fmt")),
            ]),
          ),
          json_kv(
            key: "command",
            value: json_object(members: [
              json_kv(key: "label", value: json_string(s: "cargo fmt")),
              json_kv(key: "program", value: json_string(s: "/usr/bin/cargo")),
              json_kv(key: "args", value: json_array(elements: [
                json_string(s: "fmt"),
              ])),
            ]),
          ),
          json_kv(key: "exit_code", value: json_int(n: 0)),
          json_kv(key: "stdout", value: json_string(s: "")),
          json_kv(key: "stderr", value: json_string(s: "")),
        ]),
      ]),
    ),
  ]
}

fn v1_receipt_verdict_member() -> JsonKeyValue {
  json_kv(
      key: "verdict",
      value: json_object(members: [
        json_kv(key: "key", value: json_string(s: "passed")),
        json_kv(key: "command", value: json_string(s: "cargo fmt")),
        json_kv(
          key: "oracle_identity",
          value: json_string(
            s: serialize_content_hash(
              hash: content_hash_of_value(value: "oracle-fixture"),
            ) as String,
          ),
        ),
      ]),
    )
}

fn v1_receipt_with_one_execution_text() -> String {
  serialize_json(v: json_object(members: list_snoc_item(
    xs: v1_receipt_members_without_verdict(),
    item: v1_receipt_verdict_member(),
  )))
}

fn v1_receipt_without_verdict_text() -> String {
  serialize_json(v: json_object(members: v1_receipt_members_without_verdict()))
}

fn fixture_node_id() -> RoadmapNodeId {
  "recut-a" as NonEmptyStr as RoadmapNodeId
}

fn fixture_roadmap_node() -> RoadmapNode {
  RoadmapNode {
    identity: "rnfx-recut-a" as NonEmptyStr as RoadmapNodeIdentity,
    node: fixture_node_id(),
    line: DerivableLine { prs: [1], title: "recut-a", description: "" },
    carriers: [],
    dispatch: Dispatchable {
      repo: "gunbc",
      acceptance: PrsMerged,
    },
    execution: ExecutionContractUnspecified,
    owner: "",
    signoff: Unsigned,
    parent: none,
    centering: none,
  }
}

fn verify_segment_state(
  evidence: WorkflowAttemptEvidence,
  expected_state: String,
) -> Bool {
  let progress = workflow_attempt_progress(evidence: evidence)
  fold(progress.segments, init: false, f: fn(acc, segment) {
    if workflow_segment_kind_key(kind: segment.kind) == "verify" {
      workflow_segment_state_key(state: segment.state) == expected_state
    } else {
      acc
    }
  })
}

fn fixture_evidence(
  selection: CurrentVerificationSelectionObservation,
  subject: VerificationSubjectObservation,
  source: VerificationReceiptFileSource,
) -> WorkflowAttemptEvidence {
  WorkflowAttemptEvidence {
    node_id: "recut-a",
    attempt_key: "feedfacefeedface",
    branch: "dispatch/recut-a-afeedfacefeedface",
    modeled_state: WorkflowModeledStateObserved,
    worktree: AttemptWorktreePresent { path: "/wt" },
    admission_receipt_readable: true,
    admission_receipt: "{\"schema\": \"roadmap-dispatch-environment/v1\", \"status\": \"admitted\"}",
    spawn_failure_present: false,
    spawn_failure: "",
    provider_events_readable: true,
    provider_events: "{\"type\":\"turn.completed\",\"usage\":{}}\n",
    provider_events_error: "",
    process: WorkerProcessExited { exit_code: 0, last_command: "codex" },
    validation_summary: "gunbc run --claim-run",
    verification_subject: subject,
    verification_selection: selection,
    verification_source: source,
    publication_subject: PublicationSubjectObserved {
      subject: RoadmapPublicationSubject {
        node_id: "recut-a",
        attempt_key: "feedfacefeedface",
        repository: Repository {
          owner: "gunb-ai",
          name: "gunbc",
          full_name: "gunb-ai/gunbc",
          private: false,
          default_branch: "main",
        },
        branch: "dispatch/recut-a-afeedfacefeedface" as NonEmptyStr,
        expected_base: "main" as NonEmptyStr,
        expected_head: fixture_head,
      },
    },
    publication_source: ReceiptSourceAbsent,
    review: review_report_absent(reason: "fixture"),
    submission_capture: CaptureAbsent,
    integration: IntegrationReceiptAbsent,
    goal_audit: [],
    session_placement: SessionPlacementAbsent { unit: "" },
  }
}

fn live_verify_progress_state(
  selection: CurrentVerificationSelectionObservation,
) -> String {
  let subject = belt_verification_subject_from_selection(
    node: fixture_roadmap_node(),
    attempt_key: "feedfacefeedface",
    branch: "dispatch/recut-a-afeedfacefeedface",
    head: fixture_head,
    selection: selection,
  )
  let source = belt_verification_receipt_source(
    instance: srv1_live_dashboard_instance(),
    node_id: fixture_node_id(),
    attempt_key: "feedfacefeedface",
    selection: selection,
  )
  let progress = workflow_attempt_progress(
    evidence: fixture_evidence(
      selection: selection,
      subject: subject,
      source: source,
    ),
  )
  fold(progress.segments, init: "", f: fn(acc, segment) {
    if workflow_segment_kind_key(kind: segment.kind) == "verify" {
      workflow_segment_state_key(state: segment.state)
    } else {
      acc
    }
  })
}

test fn unreadable_exact_receipt_is_evidence_unreadable_not_refuse() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptUnreadable {
      detail: "the exact verification receipt was listed and then could not be read",
    },
  ) {
    BeltVerificationEvidenceUnreadable { reason: _ } => true
    BeltVerificationRun => false
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationRefuse { reason: _ } => false
  }
}

test fn absent_exact_receipt_runs_once() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptAbsent,
  ) {
    BeltVerificationRun => true
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn two_window_identities_use_distinct_receipt_basenames() -> Bool {
  exact_verification_receipt_basename(
    head_sha: fixture_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w1),
  ) != exact_verification_receipt_basename(
    head_sha: fixture_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w2),
  )
}

test fn current_selection_points_to_w2_not_w1_basename() -> Bool {
  let w1 = exact_verification_receipt_basename(
    head_sha: fixture_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w1),
  )
  let w2 = exact_verification_receipt_basename(
    head_sha: fixture_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w2),
  )
  let selection_name = current_verification_selection_basename(
    head_sha: fixture_head as String,
  )
  w1 != w2
    && selection_name == join(
      [fixture_head as String, ".current-selection.json"],
      "",
    )
}

test fn no_current_selection_projects_verify_pending() -> Bool {
  verify_segment_state(
    evidence: fixture_evidence(
      selection: SelectionAbsent,
      subject: VerificationSubjectUnobserved {
        reason: "the belt has not selected a verification window for this head yet",
      },
      source: VerificationReceiptAbsent,
    ),
    expected_state: "pending",
  )
}

test fn unobservable_worktree_head_projects_verify_refused() -> Bool {
  live_verify_progress_state(
    selection: SelectionUnaddressable {
      cause: "the attempt worktree head could not be observed",
    },
  ) == "refused"
}

test fn selection_document_for_expected_head_naming_another_head_is_malformed() -> Bool {
  match current_verification_selection_decode_document(
    selection_path: join(
      [
        "/attempt/recut-a/verification/",
        current_verification_selection_basename(head_sha: fixture_head as String),
      ],
      "",
    ),
    expected_head_sha: fixture_head as String,
    content: current_verification_selection_json(
      selection: CurrentVerificationSelection {
        head_sha: fixture_other_head,
        change_window_identity: fixture_window_w1,
      },
    ),
  ) {
    SelectionMalformed { cause } =>
      string_contains(s: cause, pattern: "different head")
    SelectionObserved { head: _, window_identity: _ } => false
    SelectionAbsent => false
    SelectionUnreadable { cause: _ } => false
    SelectionUnaddressable { cause: _ } => false
  }
}

test fn mismatched_selection_cannot_address_the_other_heads_receipt() -> Bool {
  let selection = current_verification_selection_decode_document(
    selection_path: join(
      [
        "/attempt/recut-a/verification/",
        current_verification_selection_basename(head_sha: fixture_head as String),
      ],
      "",
    ),
    expected_head_sha: fixture_head as String,
    content: current_verification_selection_json(
      selection: CurrentVerificationSelection {
        head_sha: fixture_other_head,
        change_window_identity: fixture_window_w2,
      },
    ),
  )
  let other_receipt_basename = exact_verification_receipt_basename(
    head_sha: fixture_other_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w2),
  )
  match selection {
    SelectionMalformed { cause: _ } =>
      match belt_verification_receipt_source(
        instance: srv1_live_dashboard_instance(),
        node_id: fixture_node_id(),
        attempt_key: "feedfacefeedface",
        selection: selection,
      ) {
        VerificationReceiptUnreadable { detail } =>
          !string_contains(s: detail, pattern: other_receipt_basename)
        VerificationReceiptAbsent => false
        VerificationReceiptPresent { text: _ } => false
      }
    SelectionObserved { head: _, window_identity: _ } => false
    SelectionAbsent => false
    SelectionUnreadable { cause: _ } => false
    SelectionUnaddressable { cause: _ } => false
  }
}

test fn unreadable_current_selection_projects_verify_refused() -> Bool {
  let state = live_verify_progress_state(
    selection: SelectionUnreadable {
      cause: "permission denied",
    },
  )
  state == "refused"
}

test fn listing_failure_with_not_found_text_is_unreadable_not_absent() -> Bool {
  let state = live_verify_progress_state(
    selection: SelectionUnreadable {
      cause: join([
        "the verification directory was named by the attempt listing but could not itself be listed: ",
        "/srv/dispatch/recut-a/attempt/verification (No such file or directory)",
      ], ""),
    },
  )
  state == "refused"
}

test fn live_assembly_unreadable_selection_never_addresses_receipt_as_absent() -> Bool {
  match belt_verification_receipt_source(
    instance: srv1_live_dashboard_instance(),
    node_id: fixture_node_id(),
    attempt_key: "feedfacefeedface",
    selection: SelectionUnreadable {
      cause: "the current verification selection was listed and then could not be read",
    },
  ) {
    VerificationReceiptUnreadable { detail: _ } => true
    VerificationReceiptAbsent => false
    VerificationReceiptPresent { text: _ } => false
  }
}

test fn v1_at_exact_path_refuses_v2_subject() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptPresent {
      text: v1_legacy_receipt_text(),
    },
  ) {
    BeltVerificationRefuse { reason } =>
      string_contains(
        s: reason,
        pattern: "change_window_identity",
      )
    BeltVerificationRun => false
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn selected_v2_receipt_is_read_exactly() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w2),
    source: ExactVerificationReceiptPresent {
      text: verification_receipt_json(
        receipt: fixture_receipt(
          window: fixture_window_w2,
          verdict: ValidationPassed {
            command: "fixture-command",
            oracle_identity: content_hash_of_value(value: "oracle-fixture"),
          },
        ),
      ),
    },
  ) {
    BeltVerificationDefer { reason: _ } => true
    BeltVerificationRun => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn exact_verification_address_coheres_basename_and_path() -> Bool {
  let address = exact_verification_address_for(
    attempt_dir: "/attempt/recut-a",
    verification_dir: "/attempt/recut-a/verification",
    head_sha: fixture_head as String,
    window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w1),
  )
  let receipt_path = join(
    ["/attempt/recut-a/verification/", address.receipt_basename],
    "",
  )
  let selection_path = join(
    ["/attempt/recut-a/verification/", address.selection_basename],
    "",
  )
  address.receipt_path == receipt_path
    && address.selection_path == selection_path
}

test fn new_window_identity_does_not_match_old_passed_receipt() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w2),
    source: ExactVerificationReceiptPresent {
      text: verification_receipt_json(
        receipt: fixture_receipt(
          window: fixture_window_w1,
          verdict: ValidationPassed {
            command: "fixture-command",
            oracle_identity: content_hash_of_value(value: "oracle-fixture"),
          },
        ),
      ),
    },
  ) {
    BeltVerificationRefuse { reason: _ } => true
    BeltVerificationRun => false
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn final_exact_receipt_defers_without_rerun() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptPresent {
      text: verification_receipt_json(
        receipt: fixture_receipt(
          window: fixture_window_w1,
          verdict: ValidationPassed {
            command: "fixture-command",
            oracle_identity: content_hash_of_value(value: "oracle-fixture"),
          },
        ),
      ),
    },
  ) {
    BeltVerificationDefer { reason } =>
      string_contains(
        s: reason,
        pattern: validation_verdict_key(
          verdict: ValidationPassed {
            command: "fixture-command",
            oracle_identity: content_hash_of_value(value: "oracle-fixture"),
          },
        ),
      )
    BeltVerificationRun => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn wrong_subject_document_at_exact_path_refuses() -> Bool {
  let wrong_branch = VerificationSubject {
    node_identity: fixture_subject(window: fixture_window_w1).node_identity,
    criteria_digest: fixture_subject(window: fixture_window_w1).criteria_digest,
    attempt_key: fixture_subject(window: fixture_window_w1).attempt_key,
    branch: "dispatch/wrong-branch" as NonEmptyStr,
    head_sha: fixture_head,
    change_window_identity: fixture_window_w1,
  }
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptPresent {
      text: verification_receipt_json(
        receipt: VerificationReceipt {
          subject: wrong_branch,
          oracle_identity: as_content_hash_structural(
            structural: content_hash_atom(value: "oracle-fixture"),
          ),
          executions: [],
          verdict: ValidationPassed {
            command: "fixture-command",
            oracle_identity: content_hash_of_value(value: "oracle-fixture"),
          },
        },
      ),
    },
  ) {
    BeltVerificationRefuse { reason } =>
      string_contains(s: reason, pattern: "will not be overwritten")
    BeltVerificationRun => false
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn not_run_migration_receipt_runs() -> Bool {
  match belt_verification_decision(
    expected: fixture_subject(window: fixture_window_w1),
    source: ExactVerificationReceiptPresent {
      text: verification_receipt_json(
        receipt: fixture_receipt(
          window: fixture_window_w1,
          verdict: ValidationNotRun,
        ),
      ),
    },
  ) {
    BeltVerificationRun => true
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

test fn v1_decode_preserves_execution_rows() -> Bool {
  match verification_receipt_v1_decode(receipt: v1_receipt_with_one_execution_text()) {
    LegacyExactHeadDecoded { receipt: legacy } => count(legacy.executions) == 1
    LegacyExactHeadNotReadable { gap: _ } => false
  }
}

// THE COLLAPSE THIS CHANGE REMOVES, ASSERTED AS TWO DIFFERENT VALUES. The predecessor returned an
// Optional, so a receipt whose BYTES are not a document and a receipt that decodes all the way to
// its verdict and stops both answered `none`, and the production consumer rendered both as the one
// sentence "the v1 exact-head body is not readable". A corrupt file and a single drifted member got
// the same diagnostic.
test fn RED_unreadable_v1_receipt_bytes_are_located_as_bytes() -> Bool {
  match verification_receipt_v1_decode(receipt: "not a document") {
    LegacyExactHeadNotReadable { gap: gap } => gap == LegacyReceiptBytesUnreadable
    LegacyExactHeadDecoded { receipt: _ } => false
  }
}

// THE DISCRIMINATOR FOR THE ABOVE. This body PARSES and carries a decodable subject and oracle
// identity, and stops at the verdict -- so a decoder that answered BytesUnreadable for every
// failure would satisfy the witness above and fail here. It is built from the same fixture text as
// the positive control, with one member removed, so the two differ only in the thing under test.
test fn RED_v1_receipt_missing_verdict_is_located_at_the_verdict() -> Bool {
  match verification_receipt_v1_decode(receipt: v1_receipt_without_verdict_text()) {
    LegacyExactHeadNotReadable { gap: gap } => gap == LegacyReceiptVerdictMemberMissing
    LegacyExactHeadDecoded { receipt: _ } => false
  }
}

test fn belt_verification_refuse_projects_belt_pass_refused() -> Bool {
  match belt_verify_pass_outcome_from(outcomes: [
    VerifyRefused {
      node_id: "recut-a",
      cause: "a v1 exact-head receipt at this path lacks change_window_identity",
    },
  ]) {
    BeltPassRefused { reason: _ } => true
    BeltPassFailed { reason: _ } => false
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
  }
}

test fn belt_verification_evidence_unreadable_projects_belt_pass_failed() -> Bool {
  match belt_verify_pass_outcome_from(outcomes: [
    VerifyEvidenceUnreadable {
      node_id: "recut-a",
      detail: "the exact verification receipt was listed and then could not be read",
    },
  ]) {
    BeltPassFailed { reason: _ } => true
    BeltPassRefused { reason: _ } => false
    BeltPassRecorded => false
    BeltPassDeferred { reason: _ } => false
  }
}

fn resume_receipt_source(verdict: ValidationVerdict) -> ExactVerificationReceiptSource {
  ExactVerificationReceiptPresent {
    text: verification_receipt_json(receipt: fixture_receipt(window: fixture_window_w1, verdict: verdict)),
  }
}

// THE OPERATOR RESUME RE-RUNS ONLY A RECORDED REFUSED VERDICT. A supplied refused receipt for the exact
// subject runs (RED against belt_verification_decision, which defers it); a passed or a failed verdict
// stays recorded (controls: a verdict is a judgment of the candidate, never re-run by a resume).
test fn resume_runs_a_recorded_refused_verdict() -> Bool {
  let refused = ValidationRefused { cause: ValidationCommandRefused { program: "gunbc-compute", reason: "the claim run ended refused_by_infrastructure" } }
  (match belt_verification_decision(expected: fixture_subject(window: fixture_window_w1), source: resume_receipt_source(verdict: refused)) {
    BeltVerificationDefer { reason: _ } => true
    _ => false
  })
    && (match belt_verification_resume_decision(expected: fixture_subject(window: fixture_window_w1), source: resume_receipt_source(verdict: refused)) {
      BeltVerificationRun => true
      _ => false
    })
}

test fn resume_never_re_runs_a_passed_or_failed_verdict() -> Bool {
  let passed = ValidationPassed { command: "fixture-command", oracle_identity: content_hash_of_value(value: "oracle-fixture") }
  let failed = ValidationFailed { command: "fixture-command", exit_code: 1, detail: "assertion failed" }
  (match belt_verification_resume_decision(expected: fixture_subject(window: fixture_window_w1), source: resume_receipt_source(verdict: passed)) {
    BeltVerificationDefer { reason: _ } => true
    _ => false
  })
    && (match belt_verification_resume_decision(expected: fixture_subject(window: fixture_window_w1), source: resume_receipt_source(verdict: failed)) {
      BeltVerificationDefer { reason: _ } => true
      _ => false
    })
}

// THE REAL COMPUTE REFUSAL, built by the producer's own builder: a failed dependency under a
// refused_by_infrastructure ending (the receipt of attempt a1c9b5bec8253061b).
fn infra_refusal_verdict() -> ValidationVerdict {
  ValidationRefused { cause: compute_refusal_cause(
    ending: WorkEndedRefusedByInfrastructure,
    document: "gunbc-compute: dependency <build:release:gunbc,claim_batch> ended failed",
  ) }
}

fn decision_for(verdict: ValidationVerdict) -> BeltVerificationDecision {
  belt_verification_decision(expected: fixture_subject(window: fixture_window_w1), source: resume_receipt_source(verdict: verdict))
}

// CLAIM C1: an infrastructure-refused verification with retries left RE-RUNS instead of holding.
test fn c1_infra_refused_with_retries_left_re_runs() -> Bool {
  match belt_verification_retry_verdict(decision: decision_for(verdict: infra_refusal_verdict()), source: resume_receipt_source(verdict: infra_refusal_verdict()), retries_recorded: 0) {
    RefusedRetryRun { ordinal, cause } => ordinal == 1 && cause.contains("refused_by_infrastructure")
    RefusedRetryPassThrough => false
    RefusedRetryStop { reason: _ } => false
  }
}

// CLAIM C2: past the bound the lineage reaches the typed RetryExhausted terminal, not a hold.
test fn c2_infra_refused_past_the_bound_reaches_the_typed_terminal() -> Bool {
  match belt_verification_retry_verdict(decision: decision_for(verdict: infra_refusal_verdict()), source: resume_receipt_source(verdict: infra_refusal_verdict()), retries_recorded: refused_retry_bound) {
    RefusedRetryStop { reason } => reason.contains("RetryExhausted")
    RefusedRetryRun { ordinal: _, cause: _ } => false
    RefusedRetryPassThrough => false
  }
}

// CLAIM C3 (control): a FAILED verdict is a judgment and is never retried, at any count.
test fn c3_a_failed_verdict_is_never_retried() -> Bool {
  let failed = ValidationFailed { command: "fixture-command", exit_code: 1, detail: "refused_by_infrastructure" }
  (match belt_verification_retry_verdict(decision: decision_for(verdict: failed), source: resume_receipt_source(verdict: failed), retries_recorded: 0) {
    RefusedRetryPassThrough => true
    RefusedRetryRun { ordinal: _, cause: _ } => false
    RefusedRetryStop { reason: _ } => false
  })
    && (match belt_verification_retry_verdict(decision: decision_for(verdict: failed), source: resume_receipt_source(verdict: failed), retries_recorded: refused_retry_bound) {
      RefusedRetryPassThrough => true
      RefusedRetryRun { ordinal: _, cause: _ } => false
      RefusedRetryStop { reason: _ } => false
    })
}

// CLAIM C4 (control): a refusal about the candidate, not the environment, keeps manual resume: it holds
// with no spawn of a retry, and the standing is operator-only.
test fn c4_a_candidate_refusal_still_holds_without_a_retry() -> Bool {
  let candidate = ValidationRefused { cause: ValidationCommandRefused { program: "gunbc", reason: "the oracle moved" } }
  (match belt_verification_retry_verdict(decision: decision_for(verdict: candidate), source: resume_receipt_source(verdict: candidate), retries_recorded: 0) {
    RefusedRetryPassThrough => true
    RefusedRetryRun { ordinal: _, cause: _ } => false
    RefusedRetryStop { reason: _ } => false
  })
    && (match refused_retry_standing(class: RefusalCauseCandidate, retries_recorded: 0) {
      RefusedRetryOperatorOnly => true
      RefusedRetryOwed { ordinal: _ } => false
      RefusedRetryExhausted { attempts: _ } => false
    })
}

// CLAIM C5 (inhabitance): the cause the REAL producer builds from the real compute ending
// (compute_refusal_cause over WorkEndedRefusedByInfrastructure) is the typed infrastructure variant,
// survives the receipt wire round trip as that variant, and classifies as infrastructure; every other
// ending classifies as candidate. A command refusal whose TEXT merely contains the infrastructure
// wording is NOT infrastructure: the class is the variant, never the text.
test fn c5_the_real_compute_refusal_inhabits_the_shape() -> Bool {
  let source = resume_receipt_source(verdict: infra_refusal_verdict())
  let lookalike = ValidationCommandRefused { program: compute_refusal_program, reason: compute_refusal_reason(ending: work_ending_wire(e: WorkEndedRefusedByInfrastructure), document: "x") }
  (match belt_verification_refused_cause(source: source) {
    Present { value: cause } => match refusal_cause_class(cause: cause) { RefusalCauseInfrastructure => true  RefusalCauseCandidate => false }
    Absent => false
  })
    && (match refusal_cause_class(cause: compute_refusal_cause(ending: WorkEndedFailed, document: "x")) { RefusalCauseInfrastructure => false  RefusalCauseCandidate => true })
    && (match refusal_cause_class(cause: compute_refusal_cause(ending: WorkEndedCancelled, document: "x")) { RefusalCauseInfrastructure => false  RefusalCauseCandidate => true })
    && (match belt_verification_refused_cause(source: source) { Present { value: c } => validation_refusal_cause_detail(cause: c) == "the claim run ended refused_by_infrastructure: gunbc-compute: dependency <build:release:gunbc,claim_batch> ended failed"  Absent => false })
    && (match refusal_cause_class(cause: lookalike) { RefusalCauseInfrastructure => false  RefusalCauseCandidate => true })
}

fn terminality_receipt_text(head: CommitSha, window: Fnv1a64Structural, verdict: ValidationVerdict) -> ExactVerificationReceiptSource {
  let base = fixture_receipt(window: window, verdict: verdict)
  ExactVerificationReceiptPresent {
    text: verification_receipt_json(receipt: VerificationReceipt {
      subject: VerificationSubject {
        node_identity: base.subject.node_identity,
        criteria_digest: base.subject.criteria_digest,
        attempt_key: base.subject.attempt_key,
        branch: base.subject.branch,
        head_sha: head,
        change_window_identity: window,
      },
      oracle_identity: base.oracle_identity,
      executions: [],
      verdict: verdict,
    }),
  }
}

fn terminality_is_established(source: AttemptHeadReceiptsSource) -> Bool {
  match belt_attempt_terminality_evidence(expected: fixture_subject(window: fixture_window_w2), source: source) {
    AttemptTerminalityEstablished => true
    AttemptTerminalityNotEstablished => false
    AttemptTerminalityEvidenceUnreadable { detail: _ } => false
  }
}

fn terminality_is_unreadable(source: AttemptHeadReceiptsSource) -> Bool {
  match belt_attempt_terminality_evidence(expected: fixture_subject(window: fixture_window_w2), source: source) {
    AttemptTerminalityEstablished => false
    AttemptTerminalityNotEstablished => false
    AttemptTerminalityEvidenceUnreadable { detail: _ } => true
  }
}

fn terminality_guard_runs(evidence: AttemptTerminalityEvidence) -> Bool {
  match belt_verify_terminality_guard(provider_ready: false, evidence: evidence, decision: BeltVerificationRun) {
    BeltVerificationRun => true
    BeltVerificationDefer { reason: _ } => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  }
}

// CLAIM C6 (TERMINALITY-EVIDENCE-1; legacy attempt, no provider events): the evidence that the worker ended
// is a receipt for the same node, attempt, branch and head under ANY window, not the exact subject, because
// the window identity moves with every deploy (target_generation) while the attempt does not.
// The expected subject here is at window W2; the refused receipt was recorded under W1 (the 10-13 shape).
// RED on lab-dev: the exact-subject relation found no receipt for W2 and the guard deferred.
test fn c6_terminality_evidence_is_the_attempt_and_head_not_the_change_window() -> Bool {
  let refused_w1 = terminality_receipt_text(head: fixture_head, window: fixture_window_w1, verdict: infra_refusal_verdict())
  let passed_w1 = terminality_receipt_text(head: fixture_head, window: fixture_window_w1, verdict: ValidationPassed { command: "fixture-command", oracle_identity: content_hash_of_value(value: "oracle-fixture") })
  terminality_is_established(source: AttemptHeadReceiptsListed { sources: [refused_w1] })
    && terminality_is_established(source: AttemptHeadReceiptsListed { sources: [passed_w1] })
    && terminality_guard_runs(evidence: belt_attempt_terminality_evidence(expected: fixture_subject(window: fixture_window_w2), source: AttemptHeadReceiptsListed { sources: [refused_w1] }))
}

// CLAIM C6b control: a receipt at a DIFFERENT head, or one that never ran, establishes nothing.
test fn c6b_a_receipt_at_another_head_or_not_run_establishes_nothing() -> Bool {
  let other_head = terminality_receipt_text(head: fixture_other_head, window: fixture_window_w1, verdict: infra_refusal_verdict())
  let not_run = terminality_receipt_text(head: fixture_head, window: fixture_window_w1, verdict: ValidationNotRun)
  !terminality_is_established(source: AttemptHeadReceiptsListed { sources: [other_head, not_run] })
    && !terminality_is_unreadable(source: AttemptHeadReceiptsListed { sources: [other_head, not_run] })
    && !terminality_guard_runs(evidence: belt_attempt_terminality_evidence(expected: fixture_subject(window: fixture_window_w2), source: AttemptHeadReceiptsListed { sources: [other_head] }))
}

// CLAIM C6c control (live worker): no receipt at all defers with the unchanged reason, and provider
// terminality still runs without any receipt.
test fn c6c_no_receipt_defers_with_the_unchanged_reason() -> Bool {
  (match belt_verify_terminality_guard(provider_ready: false, evidence: belt_attempt_terminality_evidence(expected: fixture_subject(window: fixture_window_w2), source: AttemptHeadReceiptsListed { sources: [] }), decision: BeltVerificationRun) {
    BeltVerificationDefer { reason } => string_contains(s: reason, pattern: "the agent has not reached a terminal state")
    BeltVerificationRun => false
    BeltVerificationRefuse { reason: _ } => false
    BeltVerificationEvidenceUnreadable { reason: _ } => false
  })
    && (match belt_verify_terminality_guard(provider_ready: true, evidence: AttemptTerminalityNotEstablished, decision: BeltVerificationRun) { BeltVerificationRun => true  BeltVerificationDefer { reason: _ } => false  BeltVerificationRefuse { reason: _ } => false  BeltVerificationEvidenceUnreadable { reason: _ } => false })
}

// CLAIM C6d control: the old (B1,H) receipt still does not ANSWER the (B2,H) question. The exact-subject
// decision on the W2 subject over a W1-only directory is a fresh Run (absent), never the old verdict, and
// a W1 refused receipt presented as the W2 exact source is refused as another subject.
test fn c6d_an_old_window_receipt_does_not_answer_the_new_subject() -> Bool {
  let w2 = fixture_subject(window: fixture_window_w2)
  (match belt_verification_resume_decision(expected: w2, source: ExactVerificationReceiptAbsent) { BeltVerificationRun => true  BeltVerificationDefer { reason: _ } => false  BeltVerificationRefuse { reason: _ } => false  BeltVerificationEvidenceUnreadable { reason: _ } => false })
    && (match belt_verification_resume_decision(expected: w2, source: resume_receipt_source(verdict: infra_refusal_verdict())) { BeltVerificationRefuse { reason: _ } => true  BeltVerificationRun => false  BeltVerificationDefer { reason: _ } => false  BeltVerificationEvidenceUnreadable { reason: _ } => false })
}

// CLAIM C6e control: an unreadable or malformed receipt (or listing) is typed unreadable, never absent and
// never a receipt, even beside an unrelated readable one; a readable matching one still wins.
test fn c6e_an_unreadable_receipt_is_typed_not_read_as_absent() -> Bool {
  let refused_w1 = terminality_receipt_text(head: fixture_head, window: fixture_window_w1, verdict: infra_refusal_verdict())
  let other_head = terminality_receipt_text(head: fixture_other_head, window: fixture_window_w1, verdict: infra_refusal_verdict())
  terminality_is_unreadable(source: AttemptHeadReceiptsListed { sources: [ExactVerificationReceiptUnreadable { detail: "eio" }] })
    && terminality_is_unreadable(source: AttemptHeadReceiptsListed { sources: [other_head, ExactVerificationReceiptPresent { text: "this is not a receipt" }] })
    && terminality_is_unreadable(source: AttemptHeadReceiptsUnreadable { detail: "listing failed" })
    && terminality_is_established(source: AttemptHeadReceiptsListed { sources: [ExactVerificationReceiptUnreadable { detail: "eio" }, refused_w1] })
    && !terminality_guard_runs(evidence: AttemptTerminalityEvidenceUnreadable { detail: "x" })
    && (match belt_verify_terminality_guard(provider_ready: false, evidence: AttemptTerminalityEvidenceUnreadable { detail: "x" }, decision: BeltVerificationRun) { BeltVerificationEvidenceUnreadable { reason: _ } => true  BeltVerificationRun => false  BeltVerificationDefer { reason: _ } => false  BeltVerificationRefuse { reason: _ } => false })
}

// CLAIM C6f inhabitance: the receipt text and file names are the producer's own (verification_receipt_json,
// exact_verification_receipt_basename), and the relation reads the four subject fields from them; the
// current-selection pointer and another head's file are not receipts.
test fn c6f_the_producers_shapes_feed_the_terminality_relation() -> Bool {
  let w1_name = exact_verification_receipt_basename(head_sha: fixture_head as String, window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w1))
  let w2_name = exact_verification_receipt_basename(head_sha: fixture_head as String, window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w2))
  let other_name = exact_verification_receipt_basename(head_sha: fixture_other_head as String, window_identity_hex: git_diff_window_identity_hex(identity: fixture_window_w1))
  attempt_head_receipt_name_is_a_receipt(name: w1_name, head_sha: fixture_head as String)
    && attempt_head_receipt_name_is_a_receipt(name: w2_name, head_sha: fixture_head as String)
    && !attempt_head_receipt_name_is_a_receipt(name: other_name, head_sha: fixture_head as String)
    && !attempt_head_receipt_name_is_a_receipt(name: current_verification_selection_basename(head_sha: fixture_head as String), head_sha: fixture_head as String)
    && terminality_is_established(source: AttemptHeadReceiptsListed { sources: [resume_receipt_source(verdict: infra_refusal_verdict())] })
}

// CLAIM C6g (review of 1c71e84371): the directory's other files are not receipts. The live dir holds
// <head>.<w>.diff-window.json beside <head>.<w>.json and <head>.current-selection.json; only the last
// receipt-shaped name is read, so a diff-window-only directory is NotEstablished (a defer), never Unreadable.
test fn c6g_diff_window_and_selection_files_are_not_receipts() -> Bool {
  let head = fixture_head as String
  let w1 = git_diff_window_identity_hex(identity: fixture_window_w1)
  let diff_window = join([head, ".", w1, ".diff-window.json"], "")
  !attempt_head_receipt_name_is_a_receipt(name: diff_window, head_sha: head)
    && !attempt_head_receipt_name_is_a_receipt(name: join([head, ".afec9ffd990865ea.diff-window.json"], ""), head_sha: head)
    && attempt_head_receipt_name_is_a_receipt(name: join([head, ".a83b619683c79c0f.json"], ""), head_sha: head)
}

