module test.claim.void_element


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn br_node() -> std.markup.MarkupNode {
  std.markup.ElementNode { tag: "br", attrs: [], children: [] }
}

fn meta_node() -> std.markup.MarkupNode {
  std.markup.ElementNode {
    tag: "meta",
    attrs: [ std.markup.MarkupAttr { name: "charset", value: "utf-8" } ],
    children: [],
  }
}

fn div_node() -> std.markup.MarkupNode {
  std.markup.ElementNode { tag: "div", attrs: [], children: [ std.markup.TextNode { text: "content" } ] }
}

fn witness_html_br_omits_close() -> Bool {
  extdeps.languages.html.serialize_html_source(node: br_node()) == "<br>"
}

fn witness_html_meta_omits_close() -> Bool {
  extdeps.languages.html.serialize_html_source(node: meta_node()) == "<meta charset=\"utf-8\">"
}

fn witness_html_div_still_closes() -> Bool {
  extdeps.languages.html.serialize_html_source(node: div_node()) == "<div>content</div>"
}

fn witness_jsx_br_self_closes() -> Bool {
  extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: br_node()) ==
    "export function F(): JSX.Element { return <br />; }"
}

fn witness_jsx_div_still_closes() -> Bool {
  extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: div_node()) ==
    "export function F(): JSX.Element { return <div>content</div>; }"
}

fn witness_html_br_differs_from_jsx_br() -> Bool {
  !(extdeps.languages.html.serialize_html_source(node: br_node()) == extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: br_node()))
}

test fn void_element_keystone_holds() -> Bool {
  witness_html_br_omits_close()
    && witness_html_meta_omits_close()
    && witness_html_div_still_closes()
    && witness_jsx_br_self_closes()
    && witness_jsx_div_still_closes()
    && witness_html_br_differs_from_jsx_br()
}
