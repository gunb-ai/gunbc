module test.claim.void_element


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn br_node() -> std.markup.Fragment {
  std.markup.Element { tag: "br", attributes: [], children: [] }
}

fn meta_node() -> std.markup.Fragment {
  std.markup.Element {
    tag: "meta",
    attributes: [ std.markup.attr(name: "charset", value: "utf-8" ) ],
    children: [],
  }
}

fn div_node() -> std.markup.Fragment {
  std.markup.Element { tag: "div", attributes: [], children: [ std.markup.FragmentText { content: "content" } ] }
}

test fn witness_html_br_omits_close() -> Bool {
  extdeps.languages.html.serialize_html_source(node: br_node()) == "<br>"
}

test fn witness_html_meta_omits_close() -> Bool {
  extdeps.languages.html.serialize_html_source(node: meta_node()) == "<meta charset=\"utf-8\">"
}

test fn witness_html_div_still_closes() -> Bool {
  extdeps.languages.html.serialize_html_source(node: div_node()) == "<div>content</div>"
}

test fn witness_jsx_br_self_closes() -> Bool {
  extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: br_node()) ==
    "export function F(): JSX.Element { return <br />; }"
}

test fn witness_jsx_div_still_closes() -> Bool {
  extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: div_node()) ==
    "export function F(): JSX.Element { return <div>content</div>; }"
}

test fn witness_html_br_differs_from_jsx_br() -> Bool {
  !(extdeps.languages.html.serialize_html_source(node: br_node()) == extdeps.languages.react_jsx.serialize_jsx_component(fn_name: "F", node: br_node()))
}

