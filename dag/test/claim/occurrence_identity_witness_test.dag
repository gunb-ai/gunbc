module test.claim.occurrence_identity_witness_test

import std.types { Bool }
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceIdAllocator,
  OccurrenceIdAllocResult,
  NodeOccurrenceIdentity,
  OccurrenceSynthetic,
  OccurrenceMinted,
  authored_token_ordinal_space_from_allocator,
  occurrence_id_allocator_initial,
  alloc_occurrence_id,
  occurrence_id_eq,
  occurrence_id_allocator_advance_to,
  node_occurrence_identity_minted,
  occurrence_identity_consumer_red_debts,
  OccurrenceIdentityReceiptEnrollmentDebt,
  occurrence_identity_receipt_enrollment_debts,
}
import v2.std.node {
  NodeOccurrenceId,
  SyntheticOccurrence,
  MintedOccurrence,
  node_occurrence_id_to_shared,
  node_occurrence_id_from_shared,
}

test fn occurrence_identity_initial_allocator_starts_at_zero_holds() -> Bool {
  occurrence_id_allocator_initial().next_id == 0
}

test fn occurrence_identity_allocates_distinct_ordered_ids_holds() -> Bool {
  let first = alloc_occurrence_id(alloc: occurrence_id_allocator_initial())
  let second = alloc_occurrence_id(alloc: first.alloc)
  first.id.value == 0
    && second.id.value == 1
    && !occurrence_id_eq(left: first.id, right: second.id)
}

test fn occurrence_identity_advance_is_monotonic_holds() -> Bool {
  let initial = occurrence_id_allocator_initial()
  let advanced = occurrence_id_allocator_advance_to(
    alloc: initial,
    min_next: authored_token_ordinal_space_from_allocator(
      alloc: OccurrenceIdAllocator { next_id: 7 }
    ),
  )
  let unchanged = occurrence_id_allocator_advance_to(
    alloc: advanced,
    min_next: authored_token_ordinal_space_from_allocator(
      alloc: OccurrenceIdAllocator { next_id: 3 }
    ),
  )
  advanced.next_id == 7 && unchanged.next_id == 7
}

fn occurrence_identity_typed_ordinal_advance_compiles() -> Bool {
  compile_dag_rust_emit_check(
    "module occurrenceordinaltyped\n\nimport std.occurrence_identity { OccurrenceIdAllocator, authored_token_ordinal_space_from_allocator, occurrence_id_allocator_advance_to, occurrence_id_allocator_initial }\n\nfn advance() -> Bool {\n  occurrence_id_allocator_advance_to(\n    alloc: occurrence_id_allocator_initial(),\n    min_next: authored_token_ordinal_space_from_allocator(\n      alloc: OccurrenceIdAllocator { next_id: 7 }\n    )\n  ).next_id == 7\n}\n",
    "src/occurrenceordinaltyped.rs",
    [],
    []
  )
}

fn occurrence_identity_raw_scalar_advance_compiles() -> Bool {
  compile_dag_rust_emit_check(
    "module occurrenceordinalraw\n\nimport std.occurrence_identity { occurrence_id_allocator_advance_to, occurrence_id_allocator_initial }\n\nfn advance() -> Bool {\n  occurrence_id_allocator_advance_to(\n    alloc: occurrence_id_allocator_initial(),\n    min_next: 7\n  ).next_id == 7\n}\n",
    "src/occurrenceordinalraw.rs",
    [],
    []
  )
}

test fn occurrence_identity_typed_ordinal_boundary_refuses_raw_scalar_holds() -> Bool {
  occurrence_identity_typed_ordinal_advance_compiles()
    && !occurrence_identity_raw_scalar_advance_compiles()
}

test fn occurrence_identity_minted_and_synthetic_are_distinct_holds() -> Bool {
  let minted = std.occurrence_identity.node_occurrence_identity_minted(
    id: std.occurrence_identity.OccurrenceId { value: 4 }
  )
  let minted_holds = match minted {
    OccurrenceMinted { id: id } =>
      id.value == 4
    _ => false
  }
  let synthetic: NodeOccurrenceIdentity = OccurrenceSynthetic
  let synthetic_holds = match synthetic {
    OccurrenceSynthetic => true
    _ => false
  }
  minted_holds && synthetic_holds
}

test fn occurrence_identity_v2_synthetic_facade_round_trip_holds() -> Bool {
  let facade: NodeOccurrenceId = SyntheticOccurrence
  match node_occurrence_id_from_shared(
    occurrence: node_occurrence_id_to_shared(occurrence: facade)
  ) {
    SyntheticOccurrence => true
    _ => false
  }
}

test fn occurrence_identity_v2_minted_facade_round_trip_holds() -> Bool {
  let facade: NodeOccurrenceId = MintedOccurrence {
    id: std.occurrence_identity.OccurrenceId { value: 11 },
  }
  match node_occurrence_id_from_shared(
    occurrence: node_occurrence_id_to_shared(occurrence: facade)
  ) {
    MintedOccurrence { id: id } => id.value == 11
    _ => false
  }
}

test fn occurrence_identity_v2_shared_constructor_equivalence_holds() -> Bool {
  let shared: std.occurrence_identity.NodeOccurrenceIdentity = std.occurrence_identity.OccurrenceMinted {
    id: std.occurrence_identity.OccurrenceId { value: 12 },
  }
  match node_occurrence_id_to_shared(
    occurrence: node_occurrence_id_from_shared(occurrence: shared)
  ) {
    std.occurrence_identity.OccurrenceMinted { id: id } => id.value == 12
    _ => false
  }
}

data occurrence_identity_consumer_red_debt_witness_note: String = "The expected owner and required receipt are PARAMETERS, not shared constants. Four receipts are green by local execution but retain consumer debt until parser_transport_witness_entries exists on main and executes them per PR. The census pins all six debts to their distinct acceptance nodes and exact required_receipt text, preventing a row from staying counted while silently weakening what execution must make RED."

fn occurrence_identity_consumer_red_debt_has(
  id: String,
  owner: String,
  required_receipt: String
) -> Bool {
  occurrence_identity_consumer_red_debts
    |> any(row =>
      row.id == id &&
      row.owner == owner &&
      row.required_receipt == required_receipt &&
      string_contains(row.dissolve_on, "DISSOLVE-ON:")
    )
}

test fn occurrence_identity_consumer_red_debt_is_counted_holds() -> Bool {
  (occurrence_identity_consumer_red_debts |> count) == 6 &&
  occurrence_identity_consumer_red_debt_has(
    id: "rebuilt-reference-identity-preservation",
    owner: "namespace-reference-derived-closure",
    required_receipt: "A production reference rebuild preserves the exact sidecar occurrence identity and containment path; dropping or reminting the occurrence must make the consumer RED.",
  ) &&
  occurrence_identity_consumer_red_debt_has(
    id: "one-occurrence-collector-dedupe",
    owner: "namespace-reference-derived-closure",
    required_receipt: "Two observations of one authored occurrence enter the collector once by exact occurrence identity, never by spelling, SourceSpan, or Node structure.",
  ) &&
  occurrence_identity_consumer_red_debt_has(
    id: "structurally-equal-distinct-occurrences",
    owner: "namespace-reference-derived-closure",
    required_receipt: "Structurally equal and equally spelled authored occurrences with distinct IDs remain two collector entries.",
  ) &&
  occurrence_identity_consumer_red_debt_has(
    id: "pattern-declaration-reachability",
    owner: "namespace-reference-derived-closure",
    required_receipt: "Authoritative collection reaches every parser-minted pattern declaration occurrence, including nested pattern binders.",
  ) &&
  occurrence_identity_consumer_red_debt_has(
    id: "inferred-target-anchor-identity",
    owner: "namespace-canonical-binding",
    required_receipt: "An inferred target projection remains anchored to the exact authored occurrence instead of a rebuilt shell Node, spelling, or SourceSpan.",
  ) &&
  occurrence_identity_consumer_red_debt_has(
    id: "same-spelling-parser-declaration-isolation",
    owner: "namespace-reference-derived-closure",
    required_receipt: "Same-spelling declarations and references in sibling match arms, nested lets, lambdas, and parameters retain distinct authored identities and containment paths without overwrite.",
  )
}

test fn occurrence_identity_receipt_enrollment_debt_is_counted_holds() -> Bool {
  occurrence_identity_receipt_enrollment_debts == [
    OccurrenceIdentityReceiptEnrollmentDebt {
      id: "namespace-parser-occurrence-receipts-per-pr-enrollment",
      receipt_functions: [
        "w_rebuilt_reference_identity_preservation_executes_holds",
        "w_structurally_equal_distinct_occurrences_execute_holds",
        "w_pattern_declaration_reachability_executes_holds",
        "w_same_spelling_parser_declaration_isolation_executes_holds",
        "pipeline_occurrence_sidecar_serde_round_trip",
      ],
      owner: "witness-scheduling-source-root-surface",
      cause: "The four DAG receipts and the generated Rust rebuild assertion are green by execution and discriminating under planted defects, but none is executed per PR on main. The DAG receipts require the scoped dag and src/v1 parser-transport batch whose parser_transport_witness_entries roster is not yet on main. The Rust test crate containing pipeline_occurrence_sidecar_serde_round_trip is cargo-checked but its tests are not executed.",
      dissolve_on: "DISSOLVE-ON: gunbc.ci_layer_roots.parser_transport_witness_entries exists on main and executes the four DAG functions per PR, and pipeline_occurrence_sidecar_serde_round_trip executes per PR or its rebuild assertion migrates into an enrolled witness; prove both enrollment surfaces and narrow or delete this row in the same PR.",
    },
  ]
}
