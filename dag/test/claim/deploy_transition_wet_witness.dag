// ONE TRANSITION CONTEXT OVER A REAL DIRECTORY. Each test mints the context through the production mint
// (gunbc.deploy_transition_store transition_context) from an isolated instance whose root is a directory the test
// made, acquires the lease there, drives the production decision functions over the guard bound to that context,
// and checks the bytes on disk with
// a raw read at the path the code before the seal wrote to (<instance_root>/transition-inhibition.json): the
// format is unchanged exactly when those bytes are the literal the old code produced. Every test removes its
// directory and the removal joins the verdict. On the local-repo wet lane (temp-directory writes).
//
// EVERY REFUSAL FAILS THE CLAIM WITH ITS OWN REASON (ruling 2026-10-25). No arm below maps a refusal -- a mint
// that answered Unready, a lease that was not acquired, a write the store refused, a standing that could not be
// read, a read or a listing the host refused -- to false, empty or absent for a later assertion to accept. Each
// such arm is an exit_failure naming what refused. The one claim whose subject IS a refusal (the unlisted root)
// matches the Unready arm itself. Absence is established by a successful listing that does not name the file,
// never by a read that failed.

fn fresh_dir(tag: String) -> String {
  shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_transition_", tag, ".XXXXXX"], "")).path
}

fn failed(test: String, reason: String) -> ProcessExit {
  exit_failure(reason: join(["test.claim.deploy_transition_wet_witness ", test, ": ", reason], ""))
}

// THE FIRST FAILURE, IN ORDER. Each step was already evaluated by a `let` in sequence, so the effects ran in the
// order written; this only picks the verdict.
fn first_failure(steps: List<ProcessExit>) -> ProcessExit {
  fold(steps, init: ExitSuccess, f: (acc, step) =>
    match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => step
    }
  )
}

// The directory is removed whatever the verdict; a removal that fails is its own failure.
fn cleaned(test: String, dir: String, verdict: ProcessExit) -> ProcessExit {
  let removed = shell.Remove.RecursiveForce(path: dir)
  if removed.success {
    verdict
  } else {
    first_failure(steps: [verdict, failed(test: test, reason: join(["could not remove ", dir], ""))])
  }
}

fn instance_at(dir: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "transition-wet" as NonEmptyStr),
    instance_id: "transition-wet" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: dir as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18096,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

// The pre-seal file name, spelled here independently of the store's declaration: it is the oracle the store's
// derivation is checked against, not a second authority the code reads.
data old_inhibition_name: String = "transition-inhibition.json"

fn old_inhibition_path(dir: String) -> String {
  join([dir, "/", old_inhibition_name], "")
}

data candidate_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data candidate_c: String = "cccccccccccccccccccccccccccccccccccccccc"

fn subject_at(dir: String, candidate: String) -> TransitionSubject {
  TransitionSubject {
    repo_root: join([dir, "/source"], ""),
    base_ref: "refs/remotes/origin/main",
    candidate: candidate,
  }
}

fn actor(invocation: String) -> TransitionActor {
  TransitionActor { actor: "deployer", invocation: invocation }
}

fn record_at(dir: String, invocation: String, candidate: String, phase: TransitionPhase) -> TransitionRecord {
  TransitionRecord {
    actor: "deployer",
    invocation: invocation,
    repo_root: join([dir, "/source"], ""),
    base_ref: "refs/remotes/origin/main",
    candidate: candidate,
    phase: phase,
  }
}

// THE BYTES THE CODE BEFORE THE SEAL WROTE for this subject, as a literal: gunbc.deploy_transition
// transition_record_json over extdeps.languages.json.emit serialize_json (": " and ", " separators, members in
// declaration order). The readback receipt in the PR checks the same bytes against a file main's code wrote.
fn record_bytes(dir: String, invocation: String, candidate: String, phase: String) -> String {
  join([
    "{\"schema\": \"gunbc.deploy_transition/1\", \"actor\": \"deployer\", \"invocation\": \"",
    invocation,
    "\", \"repo_root\": \"",
    dir,
    "/source\", \"base_ref\": \"refs/remotes/origin/main\", \"candidate\": \"",
    candidate,
    "\", \"phase\": \"",
    phase,
    "\"}",
  ], "")
}

fn old_record_bytes(dir: String, phase: String) -> String {
  record_bytes(dir: dir, invocation: "run-1", candidate: candidate_a, phase: phase)
}

data old_lease_name: String = "transition-lease.json"

fn old_lease_path(dir: String) -> String {
  join([dir, "/", old_lease_name], "")
}

fn standing_at(dir: String) -> ActuationStanding {
  transition_actuation_standing(inhibition: transition_inhibition_store(instance: instance_at(dir: dir)))
}

fn expect_completed(test: String, step: String, a: TransitionActuation) -> ProcessExit {
  match a {
    TransitionActuationCompleted { detail: _ } => ExitSuccess
    TransitionActuationRefused { cause: c } => failed(test: test, reason: join([step, " refused: ", c], ""))
  }
}

fn expect_completed_naming(test: String, step: String, a: TransitionActuation, names: List<String>) -> ProcessExit {
  match a {
    TransitionActuationCompleted { detail: d } =>
      if all(names, n => string_contains(s: d, pattern: n)) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, " completed without naming ", join(names, ", "), ": ", d], ""))
      }
    TransitionActuationRefused { cause: c } => failed(test: test, reason: join([step, " refused: ", c], ""))
  }
}

// A CLAIM WHOSE SUBJECT IS THE REFUSAL matches the refusal arm itself and checks what it names.
fn expect_refused_naming(test: String, step: String, a: TransitionActuation, names: String) -> ProcessExit {
  match a {
    TransitionActuationRefused { cause: c } =>
      if string_contains(s: c, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, " refused for another reason: ", c], ""))
      }
    TransitionActuationCompleted { detail: d } =>
      failed(test: test, reason: join([step, " completed where it must refuse: ", d], ""))
  }
}

fn expect_permitted(test: String, step: String, s: ActuationStanding) -> ProcessExit {
  match s {
    ActuationPermitted => ExitSuccess
    ActuationInhibited { record: r } =>
      failed(test: test, reason: join([step, ": inhibited by ", r.actor, "/", r.invocation], ""))
    ActuationStandingUnreadable { cause: c } => failed(test: test, reason: join([step, ": standing unreadable: ", c], ""))
  }
}

fn expect_inhibited(test: String, step: String, s: ActuationStanding, phase: TransitionPhase) -> ProcessExit {
  match s {
    ActuationInhibited { record: r } =>
      if r.actor == "deployer" && r.invocation == "run-1"
        && r.candidate == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        && transition_phase_wire(phase: r.phase) == transition_phase_wire(phase: phase) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": inhibited by another record: ", r.actor, "/", r.invocation, " ", transition_phase_wire(phase: r.phase)], ""))
      }
    ActuationPermitted => failed(test: test, reason: join([step, ": permitted where the marker must inhibit"], ""))
    ActuationStandingUnreadable { cause: c } => failed(test: test, reason: join([step, ": standing unreadable: ", c], ""))
  }
}

fn expect_unreadable(test: String, step: String, s: ActuationStanding, names: String) -> ProcessExit {
  match s {
    ActuationStandingUnreadable { cause: c } =>
      if string_contains(s: c, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": unreadable for another reason: ", c], ""))
      }
    ActuationPermitted => failed(test: test, reason: join([step, ": permitted where nothing could be looked at"], ""))
    ActuationInhibited { record: r } => failed(test: test, reason: join([step, ": inhibited by ", r.actor, " where nothing could be looked at"], ""))
  }
}

fn expect_admission_refused(test: String, step: String, a: ActuationAdmission) -> ProcessExit {
  match a {
    ActuationRefused { reason: _ } => ExitSuccess
    ActuationAdmitted => failed(test: test, reason: join([step, ": actuation admitted where it must refuse"], ""))
  }
}

fn expect_bytes(test: String, step: String, path: String, expected: String) -> ProcessExit {
  let read = Filesystem.Read(path: path)
  if !read.success {
    failed(test: test, reason: join([step, ": the read of ", path, " was refused: ", read.error], ""))
  } else {
    if read.content == expected {
      ExitSuccess
    } else {
      failed(test: test, reason: join([step, ": bytes differ at ", path, ": ", read.content], ""))
    }
  }
}

// ABSENT MEANS A SUCCESSFUL LISTING THAT DOES NOT NAME THE FILE. A refused listing is its own failure.
fn expect_absent(test: String, step: String, dir: String, name: String) -> ProcessExit {
  let listing = Filesystem.List(path: dir)
  if !listing.success {
    failed(test: test, reason: join([step, ": the listing of ", dir, " was refused: ", listing.error], ""))
  } else {
    if filesystem_listing_names_entry(listing: listing.entries, name: name) {
      failed(test: test, reason: join([step, ": ", name, " is still listed in ", dir], ""))
    } else {
      ExitSuccess
    }
  }
}

fn expect_listed(test: String, step: String, dir: String, name: String) -> ProcessExit {
  let listing = Filesystem.List(path: dir)
  if !listing.success {
    failed(test: test, reason: join([step, ": the listing of ", dir, " was refused: ", listing.error], ""))
  } else {
    if filesystem_listing_names_entry(listing: listing.entries, name: name) {
      ExitSuccess
    } else {
      failed(test: test, reason: join([step, ": ", name, " is not listed in ", dir], ""))
    }
  }
}

fn expect_admitted_naming(test: String, step: String, c: ClearanceAdmission, names: List<String>) -> ProcessExit {
  match c {
    ClearanceAdmitted { basis: b } =>
      if all(names, n => string_contains(s: b, pattern: n)) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": admitted without naming ", join(names, ", "), ": ", b], ""))
      }
    ClearanceRefused { reason: r } => failed(test: test, reason: join([step, ": refused: ", r], ""))
  }
}

fn expect_clearance_refused_naming(test: String, step: String, c: ClearanceAdmission, names: List<String>) -> ProcessExit {
  match c {
    ClearanceRefused { reason: r } =>
      if all(names, n => string_contains(s: r, pattern: n)) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": refused without naming ", join(names, ", "), ": ", r], ""))
      }
    ClearanceAdmitted { basis: b } => failed(test: test, reason: join([step, ": admitted where it must refuse: ", b], ""))
  }
}

// THE ONLY WAY A WITNESS HOLDS A GUARD is the production route: the context mint over the instance, then the lease
// acquisition over that context. Every arm that is not a guard fails the claim with what refused.
fn with_guard(test: String, dir: String, invocation: String, candidate: String, proceed: fn(TransitionGuard) -> ProcessExit) -> ProcessExit {
  match transition_context(instance: instance_at(dir: dir)) {
    TransitionContextUnready { detail: d } => failed(test: test, reason: join(["the context mint refused at ", dir, ": ", d], ""))
    TransitionContextReady { context: c } =>
      match acquire_transition_lease(context: c, subject: subject_at(dir: dir, candidate: candidate), holder: actor(invocation: invocation)) {
        LeaseAcquired(g) => proceed(g)
        LeaseHeldBy { record: r } => failed(test: test, reason: join(["the lease at ", dir, " is held by ", r.actor, "/", r.invocation], ""))
        LeaseHeldUndecodable { cause: why } => failed(test: test, reason: join(["the lease at ", dir, " is held and undecodable: ", why], ""))
        LeaseUnobtainable { cause: why } => failed(test: test, reason: join(["the lease at ", dir, " could not be obtained: ", why], ""))
      }
  }
}

fn with_residue(test: String, context: TransitionContext, observed: Bool, head: String, proceed: fn(TransitionResidue) -> ProcessExit) -> ProcessExit {
  match transition_residue(context: context, head_observed: observed, observed_head: head, observation_detail: "rev-parse HEAD refused") {
    TransitionResidueObserved(r) => proceed(r)
    TransitionResidueUnobserved { cause: why } => failed(test: test, reason: join(["no residue was read: ", why], ""))
  }
}

// SET, READ, CLEAR THROUGH THE SEALED STORE, and the bytes between are the old format at the old path. The empty
// root is permitted; the set writes exactly the pre-seal bytes and inhibits; the holder's clearance after a
// converged readback removes the marker (and the lease) and the standing is permitted again.
test fn the_sealed_inhibition_sets_and_clears_in_the_unchanged_format() -> ProcessExit {
  let t = "the_sealed_inhibition_sets_and_clears_in_the_unchanged_format"
  let dir = fresh_dir(tag: "set")
  let before = expect_permitted(test: t, step: "before the set", s: standing_at(dir: dir))
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let bytes = expect_bytes(test: t, step: "after the set", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    let lease_bytes = expect_bytes(test: t, step: "the lease after the set", path: old_lease_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    let inhibited = expect_inhibited(test: t, step: "after the set", s: standing_at(dir: dir), phase: TransitionInForce)
    let refused = expect_admission_refused(test: t, step: "after the set", a: actuation_admission(standing: standing_at(dir: dir)))
    let cleared = expect_completed(test: t, step: "clear", a: clear_transition_records(basis: ClearedByHolder(g), readback_converged: true))
    let marker_gone = expect_absent(test: t, step: "after the clear", dir: dir, name: old_inhibition_name)
    let lease_gone = expect_absent(test: t, step: "after the clear", dir: dir, name: old_lease_name)
    let after = expect_permitted(test: t, step: "after the clear", s: standing_at(dir: dir))
    first_failure(steps: [set, bytes, lease_bytes, inhibited, refused, cleared, marker_gone, lease_gone, after])
  })
  cleaned(test: t, dir: dir, verdict: first_failure(steps: [before, verdict]))
}

// THE BYTES THE OLD CODE ACTUALLY WROTE, planted independently of ANY writer this head owns. `record_bytes` and
// `old_record_bytes` are generated by a join over THIS head's literals, so a claim whose subject is "the old format
// is still readable" may not be fed by them: if the sealed store's writer and this join drifted together, the claim
// would green while the real old bytes failed. These two rows are the marker bytes copied byte for byte out of
// `main`@`3a470031426`'s own write of the subject below, printed by the readback dispatch (BuildBuddy
// 593a1033-3721-41c5-bd78-e5bc536188bd, `sha256 51e411ff..89fc8` -> the 251 bytes planted there, whose content the
// old tree's `set_transition_inhibition` produced with no code from this head). The phase is the one string the two
// rows differ in, because the old writer emitted only the phase differently.
data main_written_inhibition_bytes: String =
  "{\"schema\": \"gunbc.deploy_transition/1\", \"actor\": \"deployer\", \"invocation\": \"run-1\", \"repo_root\": \"/tmp/gunbc_readback.plwt0c/source\", \"base_ref\": \"refs/remotes/origin/main\", \"candidate\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"phase\": \"in-force\"}"

// THE READBACK, INDEPENDENTLY PLANTED. Plant the literal above at the pre-seal path of an isolated instance with a
// raw Filesystem.Write -- no sealed operation, and none of this head's byte generators -- then mint the standing and
// the guard through the sealed store and prove it reads THAT marker as the inhibition it is. The claim asserts the
// exact subject the planted bytes carry (deployer/run-1, candidate_a, in-force), so an empty or invented standing
// could not pass: the arm must be ActuationInhibited with those fields, and actuation must refuse.
test fn the_main_written_marker_bytes_are_read_by_the_sealed_store() -> ProcessExit {
  let t = "the_main_written_marker_bytes_are_read_by_the_sealed_store"
  let dir = fresh_dir(tag: "mainbytes")
  let planted = Filesystem.Write(path: old_inhibition_path(dir: dir), content: main_written_inhibition_bytes)
  let verdict = if !planted.success {
    failed(test: t, reason: join(["the main-written marker could not be planted: ", planted.error], ""))
  } else {
    let read_back = Filesystem.Read(path: old_inhibition_path(dir: dir))
    if !read_back.success {
      failed(test: t, reason: join(["the planted marker could not be read back raw: ", read_back.error], ""))
    } else {
      if read_back.content != main_written_inhibition_bytes {
        failed(test: t, reason: "the planted bytes did not read back as planted (the plant is not the bytes claimed)")
      } else {
        let standing = standing_at(dir: dir)
        first_failure(steps: [
          expect_bytes(test: t, step: "the planted marker", path: old_inhibition_path(dir: dir), expected: main_written_inhibition_bytes),
          expect_inhibited(test: t, step: "the planted marker", s: standing, phase: TransitionInForce),
          expect_admission_refused(test: t, step: "the planted marker", a: actuation_admission(standing: standing)),
        ])
      }
    }
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A MARKER THE OLD CODE LEFT IS READ BY THE SEALED STORE. The pre-seal bytes are planted with a raw write at the
// pre-seal path -- no sealed operation involved -- and the standing minted through the store reads them as the
// inhibition they are and refuses actuation.
test fn a_marker_in_the_pre_seal_format_inhibits_through_the_sealed_store() -> ProcessExit {
  let t = "a_marker_in_the_pre_seal_format_inhibits_through_the_sealed_store"
  let dir = fresh_dir(tag: "old")
  let planted = Filesystem.Write(path: old_inhibition_path(dir: dir), content: old_record_bytes(dir: dir, phase: "in-force"))
  let verdict = if !planted.success {
    failed(test: t, reason: join(["the pre-seal marker could not be planted: ", planted.error], ""))
  } else {
    let standing = standing_at(dir: dir)
    first_failure(steps: [
      expect_inhibited(test: t, step: "the planted marker", s: standing, phase: TransitionInForce),
      expect_admission_refused(test: t, step: "the planted marker", a: actuation_admission(standing: standing)),
    ])
  }
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE CREATE IS EXCLUSIVE THROUGH THE STORE. A second set over a standing marker refuses, names the transition
// that holds it, and leaves the first record's bytes untouched.
test fn a_second_set_refuses_and_leaves_the_standing_marker() -> ProcessExit {
  let t = "a_second_set_refuses_and_leaves_the_standing_marker"
  let dir = fresh_dir(tag: "excl")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let first = expect_completed(test: t, step: "first set", a: set_transition_inhibition(guard: g))
    let second = expect_refused_naming(test: t, step: "second set", a: set_transition_inhibition(guard: g), names: "already stands for deployer/run-1")
    let bytes = expect_bytes(test: t, step: "after the second set", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    first_failure(steps: [first, second, bytes])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A PARTIAL TRANSITION REWRITES THE PHASE IN PLACE: after the mark the marker is still there, in the pre-seal
// format with the partial phase, and the belt still refuses.
test fn a_partial_transition_rewrites_the_phase_in_place() -> ProcessExit {
  let t = "a_partial_transition_rewrites_the_phase_in_place"
  let dir = fresh_dir(tag: "part")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let marked = expect_completed(test: t, step: "mark partial", a: mark_transition_partial(guard: g, detail: "worktree transition failed"))
    let bytes = expect_bytes(test: t, step: "after the mark", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "partial-transition-left"))
    let inhibited = expect_inhibited(test: t, step: "after the mark", s: standing_at(dir: dir), phase: TransitionPartialLeft)
    first_failure(steps: [set, marked, bytes, inhibited])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE REALIZATION REMOVED: an instance root that does not list. The subject of this claim IS the refusal, so it
// matches the Unready arm of both mints itself (a Ready store or context fails it), then checks that the standing
// over the same instance is the unreadable arm naming the store, and that actuation refuses -- never permitted
// because nothing could be looked at.
test fn an_unlisted_instance_root_mints_no_store_and_refuses_actuation() -> ProcessExit {
  let t = "an_unlisted_instance_root_mints_no_store_and_refuses_actuation"
  let dir = fresh_dir(tag: "gone")
  let removed = shell.Remove.RecursiveForce(path: dir)
  if !removed.success {
    failed(test: t, reason: join(["could not remove ", dir, " to make it unlisted"], ""))
  } else {
    let unready = match transition_inhibition_store(instance: instance_at(dir: dir)) {
      TransitionInhibitionStoreUnready { detail: d } =>
        if string_contains(s: d, pattern: old_inhibition_name) {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the mint refused without naming the store: ", d], ""))
        }
      TransitionInhibitionStoreReady { store: _ } => failed(test: t, reason: "the mint handed out a store over a root that does not list")
    }
    let no_context = match transition_context(instance: instance_at(dir: dir)) {
      TransitionContextUnready { detail: d } =>
        if string_contains(s: d, pattern: old_inhibition_name) {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the context mint refused without naming the store: ", d], ""))
        }
      TransitionContextReady { context: _ } => failed(test: t, reason: "the context mint handed out a context over a root that does not list")
    }
    let standing = standing_at(dir: dir)
    first_failure(steps: [
      unready,
      no_context,
      expect_unreadable(test: t, step: "the standing", s: standing, names: old_inhibition_name),
      expect_admission_refused(test: t, step: "the standing", a: actuation_admission(standing: standing)),
    ])
  }
}

// ONE FIXED ROOT, SPELLED ONE WAY. The context mint refuses, by the instance's one rule
// (gunbc.roadmap.roadmap_dashboard_instance dashboard_instance_root_spelling_refusal), a declared root that is not
// absolute or not spelled one way -- a trailing separator, a `.` segment, a doubled separator, a relative root --
// before listing anything. The subject of these claims IS the refusal, and each matches the Unready arm itself;
// the canonical spelling of the same directory, admitted, is the positive control.
fn expect_context_refused(test: String, step: String, root: String, names: String) -> ProcessExit {
  match transition_context(instance: instance_at(dir: root)) {
    TransitionContextUnready { detail: d } =>
      if string_contains(s: d, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": the context mint refused for another reason: ", d], ""))
      }
    TransitionContextReady { context: _ } => failed(test: test, reason: join([step, ": a context was minted over ", root], ""))
  }
}

test fn the_context_mint_refuses_every_spelling_but_the_canonical_absolute_root() -> ProcessExit {
  let t = "the_context_mint_refuses_every_spelling_but_the_canonical_absolute_root"
  let dir = fresh_dir(tag: "spell")
  let trailing = expect_context_refused(test: t, step: "a trailing separator", root: join([dir, "/"], ""), names: "segment")
  let dotted = expect_context_refused(test: t, step: "a dot segment", root: join([dir, "/."], ""), names: "segment")
  let doubled = expect_context_refused(test: t, step: "a doubled separator", root: join(["/", dir], ""), names: "segment")
  let relative = expect_context_refused(test: t, step: "a relative root", root: "tmp/gunbc_transition_relative", names: "not absolute")
  let canonical = match transition_context(instance: instance_at(dir: dir)) {
    TransitionContextReady { context: _ } => ExitSuccess
    TransitionContextUnready { detail: d } => failed(test: t, reason: join(["the canonical root was refused: ", d], ""))
  }
  cleaned(test: t, dir: dir, verdict: first_failure(steps: [trailing, dotted, doubled, relative, canonical]))
}

// THE RECORDS LIVE OUTSIDE THE REPOSITORY BEING TRANSITIONED. A durable file written under `repo_root` would be
// untracked residue in the tree the convergence reads back, so the convergence's own residue check would refuse
// on the artifact that exists to protect it. Both locations are the context's own derivations.
test fn the_durable_records_sit_outside_the_repository_they_protect() -> ProcessExit {
  let t = "the_durable_records_sit_outside_the_repository_they_protect"
  let dir = fresh_dir(tag: "out")
  let instance = instance_at(dir: dir)
  let repo = join([instance.repo_root as String, "/"], "")
  let verdict = match transition_context(instance: instance) {
    TransitionContextUnready { detail: d } => failed(test: t, reason: join(["the context mint refused: ", d], ""))
    TransitionContextReady { context: c } => {
      let lease = transition_lease_path(context: c)
      let inhibition = transition_inhibition_store_path(store: c.inhibition)
      if lease != inhibition
        && !string_contains(s: lease, pattern: repo)
        && !string_contains(s: inhibition, pattern: repo)
        && lease == old_lease_path(dir: dir)
        && inhibition == old_inhibition_path(dir: dir) {
        ExitSuccess
      } else {
        failed(test: t, reason: join(["the records are not beside the instance and outside ", repo, ": lease ", lease, ", inhibition ", inhibition], ""))
      }
    }
  }
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE ADMITTING ACQUISITION ARM, AND ITS EXCLUSION: the first acquire over a context mints a guard; a second over
// the same instance refuses and names the holder, and the first lease's bytes are untouched.
test fn a_second_acquire_is_refused_and_names_the_holder() -> ProcessExit {
  let t = "a_second_acquire_is_refused_and_names_the_holder"
  let dir = fresh_dir(tag: "acq")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let second = match acquire_transition_lease(context: g.context, subject: subject_at(dir: dir, candidate: candidate_c), holder: actor(invocation: "run-2")) {
      LeaseHeldBy { record: r } =>
        if r.invocation == "run-1" && r.candidate == candidate_a {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the second acquire named another holder: ", r.actor, "/", r.invocation], ""))
        }
      LeaseAcquired(_) => failed(test: t, reason: "a second guard was minted over a held lease")
      LeaseHeldUndecodable { cause: why } => failed(test: t, reason: join(["the held lease read as undecodable: ", why], ""))
      LeaseUnobtainable { cause: why } => failed(test: t, reason: join(["the held lease read as unobtainable: ", why], ""))
    }
    let bytes = expect_bytes(test: t, step: "the lease after the second acquire", path: old_lease_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    first_failure(steps: [second, bytes])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE HOLDER MAY NOT CLEAR ON EXIT STATUS. Over one guard, the clear without a converged readback refuses and
// removes nothing; the same clear with it removes both records.
test fn the_holder_clears_only_after_a_converged_readback() -> ProcessExit {
  let t = "the_holder_clears_only_after_a_converged_readback"
  let dir = fresh_dir(tag: "hold")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let unconverged = expect_refused_naming(test: t, step: "the unconverged clear", a: clear_transition_records(basis: ClearedByHolder(g), readback_converged: false), names: "may not clear without a converged readback")
    let kept = expect_bytes(test: t, step: "after the unconverged clear", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    let lease_kept = expect_listed(test: t, step: "after the unconverged clear", dir: dir, name: old_lease_name)
    let converged = expect_completed(test: t, step: "the converged clear", a: clear_transition_records(basis: ClearedByHolder(g), readback_converged: true))
    let gone = expect_absent(test: t, step: "after the converged clear", dir: dir, name: old_inhibition_name)
    let lease_gone = expect_absent(test: t, step: "after the converged clear", dir: dir, name: old_lease_name)
    first_failure(steps: [set, unconverged, kept, lease_kept, converged, gone, lease_gone])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE CLEARANCE IS SUBJECT-MATCHED. A late-finishing older deployment holds a sound basis -- its own guard, its own
// converged readback -- and the marker on disk belongs to a NEWER transition still running. The same clearance that
// admits against its own record refuses against the other one, and the refusal names both transitions.
test fn a_clearance_cannot_clear_another_transitions_marker_and_names_both() -> ProcessExit {
  let t = "a_clearance_cannot_clear_another_transitions_marker_and_names_both"
  let dir = fresh_dir(tag: "subj")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let own = expect_admitted_naming(test: t, step: "against its own record", c: clearance_admission(
      basis: ClearedByHolder(g),
      readback_converged: true,
      observed: TransitionFilePresent { record: record_at(dir: dir, invocation: "run-1", candidate: candidate_a, phase: TransitionInForce) },
    ), names: ["run-1"])
    let other = expect_clearance_refused_naming(test: t, step: "against a newer record", c: clearance_admission(
      basis: ClearedByHolder(g),
      readback_converged: true,
      observed: TransitionFilePresent { record: record_at(dir: dir, invocation: "run-2", candidate: candidate_c, phase: TransitionInForce) },
    ), names: ["run-1", "run-2", candidate_c])
    first_failure(steps: [own, other])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A MARKER THAT VANISHED OR BECAME UNREADABLE BETWEEN THE DECISION AND THE DELETE ALSO REFUSES. Absent is the subtle
// one: it reads like "already cleared", and it is equally consistent with another actor having replaced the file.
// The vanished case runs for real -- a holder that never set its marker clears -- and leaves the lease held.
test fn a_vanished_or_unreadable_marker_refuses_the_clearance() -> ProcessExit {
  let t = "a_vanished_or_unreadable_marker_refuses_the_clearance"
  let dir = fresh_dir(tag: "vani")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let vanished = expect_refused_naming(test: t, step: "the clear over no marker", a: clear_transition_records(basis: ClearedByHolder(g), readback_converged: true), names: "no longer readable")
    let lease_kept = expect_bytes(test: t, step: "the lease after the refused clear", path: old_lease_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    let unreadable = expect_clearance_refused_naming(test: t, step: "over an unreadable marker", c: clearance_admission(
      basis: ClearedByHolder(g),
      readback_converged: true,
      observed: TransitionFileIndeterminate { cause: "corrupt" },
    ), names: ["unreadable", "corrupt"])
    first_failure(steps: [vanished, lease_kept, unreadable])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// EVIDENCE-BASED CLEARANCE FOLLOWS THE DISPOSITION OF A RESIDUE READ FROM ITS OWN STORE, and the clearing process's
// readback flag is irrelevant (it is clearing someone else's residue). An incomplete residue refuses and names both
// the recorded candidate and the observed head; an unobservable one refuses; both leave the records; the resolvable
// one clears both.
test fn evidence_clears_only_a_resolvable_residue_read_from_its_own_store() -> ProcessExit {
  let t = "evidence_clears_only_a_resolvable_residue_read_from_its_own_store"
  let dir = fresh_dir(tag: "evid")
  let other_head = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let incomplete = with_residue(test: t, context: g.context, observed: true, head: other_head, proceed: r =>
      expect_refused_naming(test: t, step: "an incomplete residue", a: clear_transition_records(basis: ClearedByEvidence(r), readback_converged: true), names: other_head))
    let unobservable = with_residue(test: t, context: g.context, observed: false, head: candidate_a, proceed: r =>
      expect_refused_naming(test: t, step: "an unobservable repository", a: clear_transition_records(basis: ClearedByEvidence(r), readback_converged: true), names: "rev-parse HEAD refused"))
    let kept = expect_bytes(test: t, step: "after the refused clears", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
    let lease_kept = expect_listed(test: t, step: "after the refused clears", dir: dir, name: old_lease_name)
    let resolvable = with_residue(test: t, context: g.context, observed: true, head: candidate_a, proceed: r =>
      expect_completed_naming(test: t, step: "a resolvable residue", a: clear_transition_records(basis: ClearedByEvidence(r), readback_converged: false), names: [candidate_a]))
    let gone = expect_absent(test: t, step: "after the resolvable clear", dir: dir, name: old_inhibition_name)
    let lease_gone = expect_absent(test: t, step: "after the resolvable clear", dir: dir, name: old_lease_name)
    first_failure(steps: [set, incomplete, unobservable, kept, lease_kept, resolvable, gone, lease_gone])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A DECLARED PARTIAL TRANSITION IS NOT RESOLVABLE BY A MATCHING HEAD: the residue read from the store carries the
// partial phase, so evidence at the recorded candidate refuses and the partial record stays.
test fn a_declared_partial_residue_refuses_even_at_a_matching_head() -> ProcessExit {
  let t = "a_declared_partial_residue_refuses_even_at_a_matching_head"
  let dir = fresh_dir(tag: "pres")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let marked = expect_completed(test: t, step: "mark partial", a: mark_transition_partial(guard: g, detail: "worktree transition failed"))
    let refused = with_residue(test: t, context: g.context, observed: true, head: candidate_a, proceed: r =>
      expect_refused_naming(test: t, step: "a partial residue at its candidate", a: clear_transition_records(basis: ClearedByEvidence(r), readback_converged: true), names: "partial transition"))
    let kept = expect_bytes(test: t, step: "after the refused clear", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "partial-transition-left"))
    first_failure(steps: [set, marked, refused, kept])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// NO RESIDUE IS MINTED WHERE NOTHING STANDS: the residue's record is read from the context's store, so over a store
// whose listing does not name the marker the mint refuses, naming the store. The subject IS the refusal.
test fn no_residue_is_minted_where_nothing_stands() -> ProcessExit {
  let t = "no_residue_is_minted_where_nothing_stands"
  let dir = fresh_dir(tag: "nres")
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g =>
    match transition_residue(context: g.context, head_observed: true, observed_head: candidate_a, observation_detail: "observed") {
      TransitionResidueUnobserved { cause: why } =>
        if string_contains(s: why, pattern: "no residue stands") {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the residue mint refused for another reason: ", why], ""))
        }
      TransitionResidueObserved(_) => failed(test: t, reason: "a residue was minted over a store with no marker")
    })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE OPERATOR PATH HAS TWO WALLS AND BOTH FIRE, AND WHAT IT ADMITS IS RECORDED. An abandonment minted by a
// non-operator, or without a fresh observation, refuses; the admitted one clears both records and its basis names
// the operator and what they saw.
test fn an_abandonment_needs_an_operator_and_an_observation_and_names_both() -> ProcessExit {
  let t = "an_abandonment_needs_an_operator_and_an_observation_and_names_both"
  let dir = fresh_dir(tag: "aban")
  let seen = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let verdict = with_guard(test: t, dir: dir, invocation: "run-1", candidate: candidate_a, proceed: g => {
    let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(guard: g))
    let marked = expect_completed(test: t, step: "mark partial", a: mark_transition_partial(guard: g, detail: "worktree transition failed"))
    let no_operator = with_residue(test: t, context: g.context, observed: true, head: seen, proceed: r =>
      match mint_transition_abandonment(operator: "belt", operator_admitted: false, residue: r) {
        AbandonmentRefusedNotOperator { actor: _ } => ExitSuccess
        AbandonmentRefusedUnobserved { cause: why } => failed(test: t, reason: join(["a non-operator refused for another reason: ", why], ""))
        AbandonmentMinted(_) => failed(test: t, reason: "a non-operator minted an abandonment")
      })
    let no_observation = with_residue(test: t, context: g.context, observed: false, head: "", proceed: r =>
      match mint_transition_abandonment(operator: "operator", operator_admitted: true, residue: r) {
        AbandonmentRefusedUnobserved { cause: _ } => ExitSuccess
        AbandonmentRefusedNotOperator { actor: a } => failed(test: t, reason: join(["the operator was refused as ", a], ""))
        AbandonmentMinted(_) => failed(test: t, reason: "an abandonment was minted without an observation")
      })
    let kept = expect_bytes(test: t, step: "after the refused mints", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "partial-transition-left"))
    let admitted = with_residue(test: t, context: g.context, observed: true, head: seen, proceed: r =>
      match mint_transition_abandonment(operator: "operator", operator_admitted: true, residue: r) {
        AbandonmentMinted(a) =>
          expect_completed_naming(test: t, step: "the abandonment", a: clear_transition_records(basis: ClearedByAbandonment(a), readback_converged: false), names: ["operator", seen])
        AbandonmentRefusedUnobserved { cause: why } => failed(test: t, reason: join(["the observed abandonment refused: ", why], ""))
        AbandonmentRefusedNotOperator { actor: a } => failed(test: t, reason: join(["the operator was refused as ", a], ""))
      })
    let gone = expect_absent(test: t, step: "after the abandonment", dir: dir, name: old_inhibition_name)
    let lease_gone = expect_absent(test: t, step: "after the abandonment", dir: dir, name: old_lease_name)
    first_failure(steps: [set, marked, no_operator, no_observation, kept, admitted, gone, lease_gone])
  })
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE TWO-ROOT RED, BEHAVIORAL HALF. Two instances, A and B, each with its own context and guard and a different
// transition standing. Every operation through A's guard lands at A only: its set, its mark and its clear leave B's
// marker and lease byte-for-byte as they were. Evidence observed for A's transition (a head at A's candidate)
// handed to a residue read at B is judged against B's own record and refuses, changing nothing at A or B. Each
// step reads both instances back. The structural half -- no operation takes a store or a root beside its guard or
// basis, and no context, guard or residue pairs two instances -- is
// test.claim.transition_inhibition_store_seal_witness.
test fn two_roots_one_guard_reaches_only_its_own_instance() -> ProcessExit {
  let t = "two_roots_one_guard_reaches_only_its_own_instance"
  let a_dir = fresh_dir(tag: "twoa")
  let b_dir = fresh_dir(tag: "twob")
  let b_bytes = record_bytes(dir: b_dir, invocation: "run-2", candidate: candidate_c, phase: "in-force")
  let verdict = with_guard(test: t, dir: a_dir, invocation: "run-1", candidate: candidate_a, proceed: ga =>
    with_guard(test: t, dir: b_dir, invocation: "run-2", candidate: candidate_c, proceed: gb => {
      let set_b = expect_completed(test: t, step: "set at B", a: set_transition_inhibition(guard: gb))
      let set_a = expect_completed(test: t, step: "set at A", a: set_transition_inhibition(guard: ga))
      let after_set = first_failure(steps: [
        expect_bytes(test: t, step: "A after A's set", path: old_inhibition_path(dir: a_dir), expected: old_record_bytes(dir: a_dir, phase: "in-force")),
        expect_bytes(test: t, step: "B after A's set", path: old_inhibition_path(dir: b_dir), expected: b_bytes),
      ])
      let mark_a = expect_completed(test: t, step: "mark at A", a: mark_transition_partial(guard: ga, detail: "worktree transition failed"))
      let after_mark = first_failure(steps: [
        expect_bytes(test: t, step: "A after A's mark", path: old_inhibition_path(dir: a_dir), expected: old_record_bytes(dir: a_dir, phase: "partial-transition-left")),
        expect_bytes(test: t, step: "B after A's mark", path: old_inhibition_path(dir: b_dir), expected: b_bytes),
      ])
      let crossed = with_residue(test: t, context: gb.context, observed: true, head: candidate_a, proceed: r =>
        expect_refused_naming(test: t, step: "A's evidence on B's residue", a: clear_transition_records(basis: ClearedByEvidence(r), readback_converged: true), names: candidate_c))
      let after_crossed = first_failure(steps: [
        expect_bytes(test: t, step: "A after the crossed evidence", path: old_inhibition_path(dir: a_dir), expected: old_record_bytes(dir: a_dir, phase: "partial-transition-left")),
        expect_bytes(test: t, step: "A's lease after the crossed evidence", path: old_lease_path(dir: a_dir), expected: old_record_bytes(dir: a_dir, phase: "in-force")),
        expect_bytes(test: t, step: "B after the crossed evidence", path: old_inhibition_path(dir: b_dir), expected: b_bytes),
        expect_bytes(test: t, step: "B's lease after the crossed evidence", path: old_lease_path(dir: b_dir), expected: b_bytes),
      ])
      let clear_a = expect_completed(test: t, step: "clear at A", a: clear_transition_records(basis: ClearedByHolder(ga), readback_converged: true))
      let after_clear = first_failure(steps: [
        expect_absent(test: t, step: "A after A's clear", dir: a_dir, name: old_inhibition_name),
        expect_absent(test: t, step: "A after A's clear", dir: a_dir, name: old_lease_name),
        expect_bytes(test: t, step: "B after A's clear", path: old_inhibition_path(dir: b_dir), expected: b_bytes),
        expect_bytes(test: t, step: "B's lease after A's clear", path: old_lease_path(dir: b_dir), expected: b_bytes),
      ])
      first_failure(steps: [set_b, set_a, after_set, mark_a, after_mark, crossed, after_crossed, clear_a, after_clear])
    }))
  cleaned(test: t, dir: b_dir, verdict: cleaned(test: t, dir: a_dir, verdict: verdict))
}
