// THE SEALED INHIBITION STORE OVER A REAL DIRECTORY. Each test mints the store through the production mint
// (gunbc.deploy_transition_store transition_inhibition_store) from an isolated instance whose root is a
// directory the test made, drives the production decision functions over it, and checks the bytes on disk with
// a raw read at the path the code before the seal wrote to (<instance_root>/transition-inhibition.json): the
// format is unchanged exactly when those bytes are the literal the old code produced. THE LEASE is minted the same
// way (gunbc.deploy_transition_lease_store transition_lease_store) and held on the hold library; what it did is read
// back by the hold library's own observation over the test's directory, and the hand lock's
// transition-lease.json is never written. Every test removes its directory and the removal joins the verdict. On
// the local-repo wet lane (temp-directory writes).
//
// EVERY REFUSAL FAILS THE CLAIM WITH ITS OWN REASON (ruling 2026-10-25). No arm below maps a refusal -- a mint
// that answered Unready, a lease that was not acquired, a write the store refused, a standing that could not be
// read, a read or a listing the host refused -- to false, empty or absent for a later assertion to accept. Each
// such arm is an exit_failure naming what refused. The one claim whose subject IS a refusal (the unlisted root)
// matches the Unready arm itself. Absence is established by a successful listing that does not name the file,
// never by a read that failed.

fn fresh_dir(tag: String) -> String {
  shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_transition_", tag, ".XXXXXX"], "")).path
}

fn failed(test: String, reason: String) -> ProcessExit {
  exit_failure(reason: join(["test.claim.deploy_transition_wet_witness ", test, ": ", reason], ""))
}

// THE FIRST FAILURE, IN ORDER. Each step was already evaluated by a `let` in sequence, so the effects ran in the
// order written; this only picks the verdict.
fn first_failure(steps: List<ProcessExit>) -> ProcessExit {
  fold(steps, init: ExitSuccess, f: (acc, step) =>
    match acc {
      ExitFailure { code: _, reason: _ } => acc
      ExitSuccess => step
    }
  )
}

// The directory is removed whatever the verdict; a removal that fails is its own failure.
fn cleaned(test: String, dir: String, verdict: ProcessExit) -> ProcessExit {
  let removed = shell.Remove.RecursiveForce(path: dir)
  if removed.success {
    verdict
  } else {
    first_failure(steps: [verdict, failed(test: test, reason: join(["could not remove ", dir], ""))])
  }
}

fn instance_at(dir: String) -> HostDashboardInstance {
  instance_named(dir: dir, id: "transition-wet")
}

fn instance_named(dir: String, id: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "transition-wet" as NonEmptyStr),
    instance_id: id as NonEmptyStr,
    layout: srv1_host_layout(),
    root: dir as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18096,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

// The pre-seal file name, spelled here independently of the store's declaration: it is the oracle the store's
// derivation is checked against, not a second authority the code reads.
data old_inhibition_name: String = "transition-inhibition.json"

fn old_inhibition_path(dir: String) -> String {
  join([dir, "/", old_inhibition_name], "")
}

fn subject_at(dir: String) -> TransitionSubject {
  TransitionSubject {
    repo_root: join([dir, "/source"], ""),
    base_ref: "refs/remotes/origin/main",
    candidate: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  }
}

fn holder() -> TransitionActor {
  TransitionActor { actor: "deployer", invocation: "run-1" }
}

fn successor() -> TransitionActor {
  TransitionActor { actor: "deployer", invocation: "run-2" }
}

// THE BYTES THE CODE BEFORE THE SEAL WROTE for this subject, as a literal: gunbc.deploy_transition
// transition_record_json over extdeps.languages.json.emit serialize_json (": " and ", " separators, members in
// declaration order). The readback receipt in the PR checks the same bytes against a file main's code wrote.
fn old_record_bytes(dir: String, phase: String) -> String {
  join([
    "{\"schema\": \"gunbc.deploy_transition/1\", \"actor\": \"deployer\", \"invocation\": \"run-1\", \"repo_root\": \"",
    dir,
    "/source\", \"base_ref\": \"refs/remotes/origin/main\", \"candidate\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"phase\": \"",
    phase,
    "\"}",
  ], "")
}

fn standing_at(dir: String) -> ActuationStanding {
  transition_actuation_standing(inhibition: transition_inhibition_store(instance: instance_at(dir: dir)))
}

fn expect_completed(test: String, step: String, a: TransitionActuation) -> ProcessExit {
  match a {
    TransitionActuationCompleted { detail: _ } => ExitSuccess
    TransitionActuationRefused { cause: c } => failed(test: test, reason: join([step, " refused: ", c], ""))
  }
}

// A CLAIM WHOSE SUBJECT IS THE REFUSAL matches the refusal arm itself and checks what it names.
fn expect_refused_naming(test: String, step: String, a: TransitionActuation, names: String) -> ProcessExit {
  match a {
    TransitionActuationRefused { cause: c } =>
      if string_contains(s: c, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, " refused for another reason: ", c], ""))
      }
    TransitionActuationCompleted { detail: d } =>
      failed(test: test, reason: join([step, " completed where it must refuse: ", d], ""))
  }
}

fn expect_permitted(test: String, step: String, s: ActuationStanding) -> ProcessExit {
  match s {
    ActuationPermitted => ExitSuccess
    ActuationInhibited { record: r } =>
      failed(test: test, reason: join([step, ": inhibited by ", r.actor, "/", r.invocation], ""))
    ActuationStandingUnreadable { cause: c } => failed(test: test, reason: join([step, ": standing unreadable: ", c], ""))
  }
}

fn expect_inhibited(test: String, step: String, s: ActuationStanding, phase: TransitionPhase) -> ProcessExit {
  match s {
    ActuationInhibited { record: r } =>
      if r.actor == "deployer" && r.invocation == "run-1"
        && r.candidate == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        && transition_phase_wire(phase: r.phase) == transition_phase_wire(phase: phase) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": inhibited by another record: ", r.actor, "/", r.invocation, " ", transition_phase_wire(phase: r.phase)], ""))
      }
    ActuationPermitted => failed(test: test, reason: join([step, ": permitted where the marker must inhibit"], ""))
    ActuationStandingUnreadable { cause: c } => failed(test: test, reason: join([step, ": standing unreadable: ", c], ""))
  }
}

fn expect_unreadable(test: String, step: String, s: ActuationStanding, names: String) -> ProcessExit {
  match s {
    ActuationStandingUnreadable { cause: c } =>
      if string_contains(s: c, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": unreadable for another reason: ", c], ""))
      }
    ActuationPermitted => failed(test: test, reason: join([step, ": permitted where nothing could be looked at"], ""))
    ActuationInhibited { record: r } => failed(test: test, reason: join([step, ": inhibited by ", r.actor, " where nothing could be looked at"], ""))
  }
}

fn expect_admission_refused(test: String, step: String, a: ActuationAdmission) -> ProcessExit {
  match a {
    ActuationRefused { reason: _ } => ExitSuccess
    ActuationAdmitted => failed(test: test, reason: join([step, ": actuation admitted where it must refuse"], ""))
  }
}

fn expect_bytes(test: String, step: String, path: String, expected: String) -> ProcessExit {
  let read = Filesystem.Read(path: path)
  if !read.success {
    failed(test: test, reason: join([step, ": the read of ", path, " was refused: ", read.error], ""))
  } else {
    if read.content == expected {
      ExitSuccess
    } else {
      failed(test: test, reason: join([step, ": bytes differ at ", path, ": ", read.content], ""))
    }
  }
}

// ABSENT MEANS A SUCCESSFUL LISTING THAT DOES NOT NAME THE FILE. A refused listing is its own failure.
fn expect_absent(test: String, step: String, dir: String, name: String) -> ProcessExit {
  let listing = Filesystem.List(path: dir)
  if !listing.success {
    failed(test: test, reason: join([step, ": the listing of ", dir, " was refused: ", listing.error], ""))
  } else {
    if filesystem_listing_names_entry(listing: listing.entries, name: name) {
      failed(test: test, reason: join([step, ": ", name, " is still listed in ", dir], ""))
    } else {
      ExitSuccess
    }
  }
}

fn lease_refusal(test: String, a: LeaseAcquisition) -> ProcessExit {
  match a {
    LeaseAcquired(_) => ExitSuccess
    LeaseHeldBy { holder: h } => failed(test: test, reason: join(["the lease is held by ", h], ""))
    LeaseHeldUndecodable { cause: c } => failed(test: test, reason: join(["the lease is held and undecodable: ", c], ""))
    LeaseAcquireLost { cause: c } => failed(test: test, reason: join(["the lease acquire lost a race: ", c], ""))
    LeaseUnobtainable { cause: c } => failed(test: test, reason: join(["the lease could not be obtained: ", c], ""))
  }
}

// THE LEASE STORE THROUGH ITS PRODUCTION MINT, then the acquire. Each refusal is its own failure.
fn with_lease_store(test: String, dir: String, then: fn(TransitionLeaseStore) -> ProcessExit) -> ProcessExit {
  match transition_lease_store(instance: instance_at(dir: dir)) {
    TransitionLeaseStoreUnready { detail: d } => failed(test: test, reason: join(["the lease mint refused: ", d], ""))
    TransitionLeaseStoreReady { store: l } => then(l)
  }
}

fn with_inhibition_store(test: String, dir: String, then: fn(TransitionInhibitionStore) -> ProcessExit) -> ProcessExit {
  match transition_inhibition_store(instance: instance_at(dir: dir)) {
    TransitionInhibitionStoreUnready { detail: d } => failed(test: test, reason: join(["the inhibition mint refused: ", d], ""))
    TransitionInhibitionStoreReady { store: s } => then(s)
  }
}

fn with_guard(test: String, a: LeaseAcquisition, then: fn(TransitionGuard) -> ProcessExit) -> ProcessExit {
  match a {
    LeaseAcquired(g) => then(g)
    LeaseHeldBy { holder: _ } => lease_refusal(test: test, a: a)
    LeaseHeldUndecodable { cause: _ } => lease_refusal(test: test, a: a)
    LeaseAcquireLost { cause: _ } => lease_refusal(test: test, a: a)
    LeaseUnobtainable { cause: _ } => lease_refusal(test: test, a: a)
  }
}

// THE LEASE SLOT AS THE HOLD LIBRARY READS IT, over the directory the test made: the oracle for what the
// sealed store did, read by the library's own observation rather than by the store under test.
fn lease_slot(dir: String) -> DurableHoldObservation {
  observe_file_hold(root: dir as NonEmptyStr, key: transition_lease_slots.member)
}

fn expect_lease_held_by(test: String, step: String, dir: String, invocation: String, generation: Int) -> ProcessExit {
  match lease_slot(dir: dir) {
    HoldSlotHeld { generation: g, owner: o } =>
      if string_contains(s: o as String, pattern: invocation) && cas_generation_count(g: g) == generation {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": the lease is held by ", o as String, " at generation ", to_string(cas_generation_count(g: g))], ""))
      }
    HoldSlotFree { generation: g, released_by: r } =>
      failed(test: test, reason: join([step, ": the lease is free at generation ", to_string(cas_generation_count(g: g)), ", released by ", r as String], ""))
    HoldSlotAbsent => failed(test: test, reason: join([step, ": no lease slot exists"], ""))
    HoldSlotUndecodable { generation: _, detail: d } => failed(test: test, reason: join([step, ": the lease slot is undecodable: ", d as String], ""))
    HoldObservationUnavailable { cause: c } => failed(test: test, reason: join([step, ": the lease slot could not be read: ", cas_unreadable_slot_detail(cause: c)], ""))
  }
}

fn expect_lease_free(test: String, step: String, dir: String, generation: Int) -> ProcessExit {
  match lease_slot(dir: dir) {
    HoldSlotFree { generation: g, released_by: _ } =>
      if cas_generation_count(g: g) == generation {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": the lease is free at generation ", to_string(cas_generation_count(g: g))], ""))
      }
    HoldSlotHeld { generation: _, owner: o } => failed(test: test, reason: join([step, ": the lease is still held by ", o as String], ""))
    HoldSlotAbsent => failed(test: test, reason: join([step, ": no lease slot exists"], ""))
    HoldSlotUndecodable { generation: _, detail: d } => failed(test: test, reason: join([step, ": the lease slot is undecodable: ", d as String], ""))
    HoldObservationUnavailable { cause: c } => failed(test: test, reason: join([step, ": the lease slot could not be read: ", cas_unreadable_slot_detail(cause: c)], ""))
  }
}

// SET, READ, CLEAR THROUGH THE SEALED STORES, and the inhibition's bytes between are the old format at the old
// path. The empty root is permitted; the lease is acquired through its store (held at generation 1); the set
// writes exactly the pre-seal bytes and inhibits; the holder's clearance after a converged readback removes the
// marker and RELEASES the lease through the hold library (free at generation 2), and the standing is permitted
// again. The hand lock's file is never written.
test fn the_sealed_inhibition_sets_and_clears_in_the_unchanged_format() -> ProcessExit {
  let t = "the_sealed_inhibition_sets_and_clears_in_the_unchanged_format"
  let dir = fresh_dir(tag: "set")
  let before = expect_permitted(test: t, step: "before the set", s: standing_at(dir: dir))
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      with_inhibition_store(test: t, dir: dir, then: s => {
        let held = expect_lease_held_by(test: t, step: "after the acquire", dir: dir, invocation: "run-1", generation: 1)
        let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(inhibition: s, guard: g))
        let bytes = expect_bytes(test: t, step: "after the set", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
        let inhibited = expect_inhibited(test: t, step: "after the set", s: standing_at(dir: dir), phase: TransitionInForce)
        let refused = expect_admission_refused(test: t, step: "after the set", a: actuation_admission(standing: standing_at(dir: dir)))
        let cleared = expect_completed(test: t, step: "clear", a: clear_transition_records(inhibition: s, basis: ClearedByHolder(g), readback_converged: true))
        let marker_gone = expect_absent(test: t, step: "after the clear", dir: dir, name: old_inhibition_name)
        let released = expect_lease_free(test: t, step: "after the clear", dir: dir, generation: 2)
        let no_hand_lock = expect_absent(test: t, step: "after the clear", dir: dir, name: "transition-lease.json")
        let after = expect_permitted(test: t, step: "after the clear", s: standing_at(dir: dir))
        first_failure(steps: [held, set, bytes, inhibited, refused, cleared, marker_gone, released, no_hand_lock, after])
      })
    )
  )
  cleaned(test: t, dir: dir, verdict: first_failure(steps: [before, verdict]))
}

// A MARKER THE OLD CODE LEFT IS READ BY THE SEALED STORE. The pre-seal bytes are planted with a raw write at the
// pre-seal path -- no sealed operation involved -- and the standing minted through the store reads them as the
// inhibition they are and refuses actuation.
test fn a_marker_in_the_pre_seal_format_inhibits_through_the_sealed_store() -> ProcessExit {
  let t = "a_marker_in_the_pre_seal_format_inhibits_through_the_sealed_store"
  let dir = fresh_dir(tag: "old")
  let planted = Filesystem.Write(path: old_inhibition_path(dir: dir), content: old_record_bytes(dir: dir, phase: "in-force"))
  let verdict = if !planted.success {
    failed(test: t, reason: join(["the pre-seal marker could not be planted: ", planted.error], ""))
  } else {
    let standing = standing_at(dir: dir)
    first_failure(steps: [
      expect_inhibited(test: t, step: "the planted marker", s: standing, phase: TransitionInForce),
      expect_admission_refused(test: t, step: "the planted marker", a: actuation_admission(standing: standing)),
    ])
  }
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE CREATE IS EXCLUSIVE THROUGH THE STORE. A second set over a standing marker refuses, names the transition
// that holds it, and leaves the first record's bytes untouched.
test fn a_second_set_refuses_and_leaves_the_standing_marker() -> ProcessExit {
  let t = "a_second_set_refuses_and_leaves_the_standing_marker"
  let dir = fresh_dir(tag: "excl")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      with_inhibition_store(test: t, dir: dir, then: s => {
        let first = expect_completed(test: t, step: "first set", a: set_transition_inhibition(inhibition: s, guard: g))
        let second = expect_refused_naming(test: t, step: "second set", a: set_transition_inhibition(inhibition: s, guard: g), names: "already stands for deployer/run-1")
        let bytes = expect_bytes(test: t, step: "after the second set", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
        first_failure(steps: [first, second, bytes])
      })
    )
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A PARTIAL TRANSITION REWRITES THE PHASE IN PLACE: after the mark the marker is still there, in the pre-seal
// format with the partial phase, the belt still refuses, and the lease is still held by the holder that marked it.
test fn a_partial_transition_rewrites_the_phase_in_place() -> ProcessExit {
  let t = "a_partial_transition_rewrites_the_phase_in_place"
  let dir = fresh_dir(tag: "part")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      with_inhibition_store(test: t, dir: dir, then: s => {
        let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(inhibition: s, guard: g))
        let marked = expect_completed(test: t, step: "mark partial", a: mark_transition_partial(inhibition: s, guard: g, detail: "worktree transition failed"))
        let bytes = expect_bytes(test: t, step: "after the mark", path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "partial-transition-left"))
        let inhibited = expect_inhibited(test: t, step: "after the mark", s: standing_at(dir: dir), phase: TransitionPartialLeft)
        let still_held = expect_lease_held_by(test: t, step: "after the mark", dir: dir, invocation: "run-1", generation: 1)
        first_failure(steps: [set, marked, bytes, inhibited, still_held])
      })
    )
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE REALIZATION REMOVED: an instance root that does not list. The subject of this claim IS the refusal, so it
// matches the Unready arm of BOTH mints itself (a Ready store fails it), then checks that the standing over the
// same instance is the unreadable arm naming the store, and that actuation refuses -- never permitted because
// nothing could be looked at.
test fn an_unlisted_instance_root_mints_no_store_and_refuses_actuation() -> ProcessExit {
  let t = "an_unlisted_instance_root_mints_no_store_and_refuses_actuation"
  let dir = fresh_dir(tag: "gone")
  let removed = shell.Remove.RecursiveForce(path: dir)
  if !removed.success {
    failed(test: t, reason: join(["could not remove ", dir, " to make it unlisted"], ""))
  } else {
    let unready = match transition_inhibition_store(instance: instance_at(dir: dir)) {
      TransitionInhibitionStoreUnready { detail: d } =>
        if string_contains(s: d, pattern: old_inhibition_name) {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the mint refused without naming the store: ", d], ""))
        }
      TransitionInhibitionStoreReady { store: _ } => failed(test: t, reason: "the mint handed out a store over a root that does not list")
    }
    let lease_unready = match transition_lease_store(instance: instance_at(dir: dir)) {
      TransitionLeaseStoreUnready { detail: d } =>
        if string_contains(s: d, pattern: "could not be listed") {
          ExitSuccess
        } else {
          failed(test: t, reason: join(["the lease mint refused for another reason: ", d], ""))
        }
      TransitionLeaseStoreReady { store: _ } => failed(test: t, reason: "the lease mint handed out a store over a root that does not list")
    }
    let standing = standing_at(dir: dir)
    first_failure(steps: [
      unready,
      lease_unready,
      expect_unreadable(test: t, step: "the standing", s: standing, names: old_inhibition_name),
      expect_admission_refused(test: t, step: "the standing", a: actuation_admission(standing: standing)),
    ])
  }
}

// ONE FIXED ROOT, SPELLED ONE WAY. The lease mint takes the root from the instance and refuses a declared root
// that is not absolute and canonical -- a trailing separator, a `.` segment, a relative root -- because the hold
// library names a hold by the root as spelled, so a second spelling would be a second lease. The subject of
// these three claims IS the refusal, and each matches the Unready arm itself; the canonical spelling of the same
// directory is the positive control.
fn expect_lease_mint_refused(test: String, step: String, root: String, names: String) -> ProcessExit {
  match transition_lease_store(instance: instance_at(dir: root)) {
    TransitionLeaseStoreUnready { detail: d } =>
      if string_contains(s: d, pattern: names) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": refused for another reason: ", d], ""))
      }
    TransitionLeaseStoreReady { store: _ } => failed(test: test, reason: join([step, ": a store was minted over ", root], ""))
  }
}

test fn the_lease_mint_refuses_every_spelling_but_the_canonical_absolute_root() -> ProcessExit {
  let t = "the_lease_mint_refuses_every_spelling_but_the_canonical_absolute_root"
  let dir = fresh_dir(tag: "spell")
  let trailing = expect_lease_mint_refused(test: t, step: "a trailing separator", root: join([dir, "/"], ""), names: "segment")
  let dotted = expect_lease_mint_refused(test: t, step: "a dot segment", root: join([dir, "/."], ""), names: "segment")
  let doubled = expect_lease_mint_refused(test: t, step: "a doubled separator", root: join(["/", dir], ""), names: "segment")
  let relative = expect_lease_mint_refused(test: t, step: "a relative root", root: "tmp/gunbc_transition_relative", names: "not absolute")
  let canonical = with_lease_store(test: t, dir: dir, then: l => ExitSuccess)
  cleaned(test: t, dir: dir, verdict: first_failure(steps: [trailing, dotted, doubled, relative, canonical]))
}

// THE LEASE EXCLUDES, AND THE HOLDER'S RELEASE FREES IT FOR THE NEXT. A second acquire while the first holds
// refuses as held and names the holder; after the holder's release a successor acquires at the next generation.
test fn a_held_lease_refuses_a_second_acquire_until_its_holder_releases() -> ProcessExit {
  let t = "a_held_lease_refuses_a_second_acquire_until_its_holder_releases"
  let dir = fresh_dir(tag: "hold")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g => {
      let second = match acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: successor()) {
        LeaseHeldBy { holder: h } =>
          if string_contains(s: h, pattern: "run-1") { ExitSuccess } else { failed(test: t, reason: join(["the second acquire names another holder: ", h], "")) }
        LeaseAcquired(_) => failed(test: t, reason: "a second acquire was admitted while the first held the lease")
        LeaseHeldUndecodable { cause: c } => failed(test: t, reason: join(["the second acquire read an undecodable lease: ", c], ""))
        LeaseAcquireLost { cause: c } => failed(test: t, reason: join(["the second acquire lost a race instead of seeing the holder: ", c], ""))
        LeaseUnobtainable { cause: c } => failed(test: t, reason: join(["the second acquire could not reach the store: ", c], ""))
      }
      let released = match transition_lease_release(held: g.lease, released_by: "holder-cleared deployer/run-1" as NonEmptyStr) {
        TransitionLeaseReleased => ExitSuccess
        TransitionLeaseReleaseRefused { detail: d } => failed(test: t, reason: join(["the holder's release refused: ", d], ""))
      }
      let next = with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: successor()), then: n =>
        expect_lease_held_by(test: t, step: "after the successor's acquire", dir: dir, invocation: "run-2", generation: 3))
      first_failure(steps: [second, released, next])
    })
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A STALE HOLDER CANNOT FREE ITS SUCCESSOR'S LEASE, which the hand lock's Delete could: the release presents the
// generation it acquired, so after a successor holds the slot the old holder's release refuses and the successor
// still holds it.
test fn a_stale_holders_release_refuses_and_leaves_the_successor_holding() -> ProcessExit {
  let t = "a_stale_holders_release_refuses_and_leaves_the_successor_holding"
  let dir = fresh_dir(tag: "stale")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g => {
      let released = match transition_lease_release(held: g.lease, released_by: "holder-cleared deployer/run-1" as NonEmptyStr) {
        TransitionLeaseReleased => ExitSuccess
        TransitionLeaseReleaseRefused { detail: d } => failed(test: t, reason: join(["the first release refused: ", d], ""))
      }
      let next = with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: successor()), then: n => ExitSuccess)
      let stale = match transition_lease_release(held: g.lease, released_by: "holder-cleared deployer/run-1" as NonEmptyStr) {
        TransitionLeaseReleaseRefused { detail: d } =>
          if string_contains(s: d, pattern: "run-2") { ExitSuccess } else { failed(test: t, reason: join(["the stale release refused without naming the successor: ", d], "")) }
        TransitionLeaseReleased => failed(test: t, reason: "a stale holder's release freed the successor's lease")
      }
      let kept = expect_lease_held_by(test: t, step: "after the stale release", dir: dir, invocation: "run-2", generation: 3)
      first_failure(steps: [released, next, stale, kept])
    })
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// A GUARD TAKEN FOR ONE INSTANCE DOES NOT ACT ON ANOTHER'S INHIBITION. The lease of instance A licenses no write to
// instance B's marker: the set refuses naming both instances, and B's root keeps no marker.
test fn a_guard_for_one_instance_refuses_another_instances_inhibition() -> ProcessExit {
  let t = "a_guard_for_one_instance_refuses_another_instances_inhibition"
  let dir = fresh_dir(tag: "inst_a")
  let other = fresh_dir(tag: "inst_b")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      match transition_inhibition_store(instance: instance_named(dir: other, id: "transition-wet-other")) {
        TransitionInhibitionStoreUnready { detail: d } => failed(test: t, reason: join(["the other instance's mint refused: ", d], ""))
        TransitionInhibitionStoreReady { store: s } =>
          first_failure(steps: [
            expect_refused_naming(test: t, step: "set across instances", a: set_transition_inhibition(inhibition: s, guard: g), names: "transition-wet-other"),
            expect_refused_naming(test: t, step: "mark across instances", a: mark_transition_partial(inhibition: s, guard: g, detail: "x"), names: "transition-wet-other"),
            expect_refused_naming(test: t, step: "clear across instances", a: clear_transition_records(inhibition: s, basis: ClearedByHolder(g), readback_converged: true), names: "transition-wet-other"),
            expect_absent(test: t, step: "the other root", dir: other, name: old_inhibition_name),
            expect_lease_held_by(test: t, step: "after the refusals", dir: dir, invocation: "run-1", generation: 1),
          ])
      }
    )
  )
  cleaned(test: t, dir: other, verdict: cleaned(test: t, dir: dir, verdict: verdict))
}

// A NON-HOLDER CLEARANCE CLEARS THE INHIBITION AND DOES NOT RELEASE THE LEASE. Evidence that the transition landed
// resolves the residue, so the marker goes; the lease, held by a holder that is not the caller, stays held, and the
// refusal names the residual. The subject of the claim is that refusal, so it matches the refused arm itself.
fn residue_at(record: TransitionRecord) -> ResidueEvidence {
  ResidueEvidence {
    record: record,
    head_observed: true,
    observed_head: record.candidate,
    observation_detail: "rev-parse supplied by the witness",
  }
}

test fn evidence_clears_the_inhibition_and_leaves_the_lease_held() -> ProcessExit {
  let t = "evidence_clears_the_inhibition_and_leaves_the_lease_held"
  let dir = fresh_dir(tag: "evid")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      with_inhibition_store(test: t, dir: dir, then: s => {
        let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(inhibition: s, guard: g))
        let record = transition_guard_record(guard: g, phase: TransitionInForce)
        let cleared = expect_refused_naming(
          test: t,
          step: "clear on evidence",
          a: clear_transition_records(inhibition: s, basis: ClearedByEvidence { expected: record, disposition: ResidueResolvable { candidate: record.candidate } }, readback_converged: false),
          names: "a_generic_release_assess_accepts_evidence_its_caller_authored",
        )
        let marker_gone = expect_absent(test: t, step: "after the evidence clearance", dir: dir, name: old_inhibition_name)
        let still_held = expect_lease_held_by(test: t, step: "after the evidence clearance", dir: dir, invocation: "run-1", generation: 1)
        first_failure(steps: [set, cleared, marker_gone, still_held])
      })
    )
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE OPERATOR ARM REFUSES THE LEASE TOO. An abandonment retires the inhibition record on its own evidence, and is
// not a lease-release basis until it binds a std.scoped_authorization AuthorizationDecision, so the lease stays
// held and the refusal says why.
test fn an_abandonment_clears_the_inhibition_and_leaves_the_lease_held() -> ProcessExit {
  let t = "an_abandonment_clears_the_inhibition_and_leaves_the_lease_held"
  let dir = fresh_dir(tag: "aban")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g =>
      with_inhibition_store(test: t, dir: dir, then: s => {
        let set = expect_completed(test: t, step: "set", a: set_transition_inhibition(inhibition: s, guard: g))
        let record = transition_guard_record(guard: g, phase: TransitionInForce)
        let cleared = match mint_transition_abandonment(operator: "operator", operator_admitted: true, evidence: residue_at(record: record)) {
          AbandonmentMinted(a) =>
            expect_refused_naming(
              test: t,
              step: "clear on abandonment",
              a: clear_transition_records(inhibition: s, basis: ClearedByAbandonment(a), readback_converged: false),
              names: "AuthorizationDecision",
            )
          AbandonmentRefusedUnobserved { cause: c } => failed(test: t, reason: join(["the abandonment mint refused as unobserved: ", c], ""))
          AbandonmentRefusedNotOperator { actor: a } => failed(test: t, reason: join(["the abandonment mint refused the operator ", a], ""))
        }
        let marker_gone = expect_absent(test: t, step: "after the abandonment", dir: dir, name: old_inhibition_name)
        let still_held = expect_lease_held_by(test: t, step: "after the abandonment", dir: dir, invocation: "run-1", generation: 1)
        first_failure(steps: [set, cleared, marker_gone, still_held])
      })
    )
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}

// THE HOLDER'S CLEARANCE IS SUBJECT-MATCHED AND READBACK-CONDITIONED, over a real guard (moved here from
// test.claim.deploy_transition_witness: a guard is minted only by a committed acquire). A late-finishing older
// deployment holds a perfectly sound basis -- its own guard, its own converged readback -- and the marker on disk
// belongs to a NEWER transition that is still running; the same basis that admits against its own record refuses
// against someone else's, names both, refuses a marker that vanished or became unreadable, and refuses without a
// converged readback. All pure folds over the guard; the subject of each refusal is matched on its arm.
fn newer_record() -> TransitionRecord {
  TransitionRecord {
    actor: "deployer",
    invocation: "run-2",
    repo_root: "/opt/gunbc/gunbc",
    base_ref: "refs/remotes/origin/main",
    candidate: "cccccccccccccccccccccccccccccccccccccccc",
    phase: TransitionInForce,
  }
}

fn expect_clearance_admitted(test: String, step: String, c: ClearanceAdmission) -> ProcessExit {
  match c {
    ClearanceAdmitted { basis: _ } => ExitSuccess
    ClearanceRefused { reason: r } => failed(test: test, reason: join([step, ": refused: ", r], ""))
  }
}

fn expect_clearance_refused_naming(test: String, step: String, c: ClearanceAdmission, names: List<String>) -> ProcessExit {
  match c {
    ClearanceRefused { reason: r } =>
      if all(names, n => string_contains(s: r, pattern: n)) {
        ExitSuccess
      } else {
        failed(test: test, reason: join([step, ": refused without naming what it must: ", r], ""))
      }
    ClearanceAdmitted { basis: b } => failed(test: test, reason: join([step, ": admitted where it must refuse: ", b], ""))
  }
}

test fn the_holders_clearance_is_subject_matched_and_readback_conditioned() -> ProcessExit {
  let t = "the_holders_clearance_is_subject_matched_and_readback_conditioned"
  let dir = fresh_dir(tag: "subj")
  let verdict = with_lease_store(test: t, dir: dir, then: l =>
    with_guard(test: t, a: acquire_transition_lease(lease: l, subject: subject_at(dir: dir), holder: holder()), then: g => {
      let own = TransitionFilePresent { record: transition_guard_record(guard: g, phase: TransitionInForce) }
      first_failure(steps: [
        expect_clearance_admitted(test: t, step: "own marker, converged", c: clearance_admission(basis: ClearedByHolder(g), readback_converged: true, observed: own)),
        expect_clearance_refused_naming(test: t, step: "own marker, not converged", c: clearance_admission(basis: ClearedByHolder(g), readback_converged: false, observed: own), names: ["readback"]),
        expect_clearance_refused_naming(test: t, step: "a newer transition's marker", c: clearance_admission(basis: ClearedByHolder(g), readback_converged: true, observed: TransitionFilePresent { record: newer_record() }), names: ["run-1", "run-2", "cccccccccccccccccccccccccccccccccccccccc"]),
        expect_clearance_refused_naming(test: t, step: "an unreadable marker", c: clearance_admission(basis: ClearedByHolder(g), readback_converged: true, observed: TransitionFileIndeterminate { cause: "corrupt" }), names: ["unreadable"]),
        with_inhibition_store(test: t, dir: dir, then: s =>
          expect_refused_naming(test: t, step: "a marker that is not there", a: clear_transition_records(inhibition: s, basis: ClearedByHolder(g), readback_converged: true), names: "no longer readable")),
        expect_lease_held_by(test: t, step: "after the refused clearances", dir: dir, invocation: "run-1", generation: 1),
      ])
    })
  )
  cleaned(test: t, dir: dir, verdict: verdict)
}
