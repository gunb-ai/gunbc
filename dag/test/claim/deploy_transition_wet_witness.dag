module test.claim.deploy_transition_wet_witness

import extdeps.shell
import std.types { Bool, String, List, NonEmptyStr, FilePath }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.host.host_layout { srv1_host_layout }
import gunbc.deployment_risk { deployment_id }
import gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }
import gunbc.deploy_transition_store {
  TransitionInhibitionStoreReading,
  TransitionInhibitionStoreReady,
  TransitionInhibitionStoreUnready,
  transition_inhibition_store,
}
import gunbc.deploy_transition {
  TransitionSubject,
  TransitionActor,
  TransitionGuard,
  TransitionPhase,
  TransitionInForce,
  TransitionPartialLeft,
  LeaseAcquisition,
  LeaseAcquired,
  LeaseHeldBy,
  LeaseHeldUndecodable,
  LeaseUnobtainable,
  TransitionActuation,
  TransitionActuationCompleted,
  TransitionActuationRefused,
  ActuationStanding,
  ActuationPermitted,
  ActuationInhibited,
  ActuationStandingUnreadable,
  ActuationAdmission,
  ActuationAdmitted,
  ActuationRefused,
  ClearedByHolder,
  acquire_transition_lease,
  set_transition_inhibition,
  mark_transition_partial,
  clear_transition_records,
  transition_actuation_standing,
  actuation_admission,
  transition_phase_wire,
}

// THE SEALED INHIBITION STORE OVER A REAL DIRECTORY. Each test mints the store through the production mint
// (gunbc.deploy_transition_store transition_inhibition_store) from an isolated instance whose root is a
// directory the test made, drives the production decision functions over it, and checks the bytes on disk with
// a raw read at the path the code before the seal wrote to (<instance_root>/transition-inhibition.json): the
// format is unchanged exactly when those bytes are the literal the old code produced. Every test removes its
// directory and the removal joins the verdict. On the local-repo wet lane (temp-directory writes).

fn fresh_dir(tag: String) -> String {
  shell.Mktemp.DirWithTemplate(template: join(["/tmp/gunbc_transition_", tag, ".XXXXXX"], "")).path
}

fn cleaned(dir: String, verdict: Bool) -> Bool {
  shell.Remove.RecursiveForce(path: dir).success && verdict
}

fn instance_at(dir: String) -> HostDashboardInstance {
  isolated_dashboard_instance(
    deployment: deployment_id(name: "transition-wet" as NonEmptyStr),
    instance_id: "transition-wet" as NonEmptyStr,
    layout: srv1_host_layout(),
    root: dir as FilePath,
    serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
    listen_port: 18096,
    source_anchor_ref: "refs/heads/main" as NonEmptyStr,
    actuation: DashboardActuating,
    provision_transport: DashboardLocalProvision,
  )
}

// The pre-seal path, spelled here independently of the store's declaration: it is the oracle the store's
// derivation is checked against, not a second authority the code reads.
fn old_inhibition_path(dir: String) -> String {
  join([dir, "/transition-inhibition.json"], "")
}

fn subject_at(dir: String) -> TransitionSubject {
  TransitionSubject {
    instance_root: dir,
    repo_root: join([dir, "/source"], ""),
    base_ref: "refs/remotes/origin/main",
    candidate: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  }
}

fn holder() -> TransitionActor {
  TransitionActor { actor: "deployer", invocation: "run-1" }
}

// THE BYTES THE CODE BEFORE THE SEAL WROTE for this subject, as a literal: gunbc.deploy_transition
// transition_record_json over extdeps.languages.json.emit serialize_json (": " and ", " separators, members in
// declaration order). The readback receipt in the PR checks the same bytes against a file the old tree wrote.
fn old_record_bytes(dir: String, phase: String) -> String {
  join([
    "{\"schema\": \"gunbc.deploy_transition/1\", \"actor\": \"deployer\", \"invocation\": \"run-1\", \"repo_root\": \"",
    dir,
    "/source\", \"base_ref\": \"refs/remotes/origin/main\", \"candidate\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"phase\": \"",
    phase,
    "\"}",
  ], "")
}

fn guard_at(dir: String) -> TransitionGuard? {
  match acquire_transition_lease(subject: subject_at(dir: dir), holder: holder()) {
    LeaseAcquired(g) => Present { value: g }
    LeaseHeldBy { record: _ } => none
    LeaseHeldUndecodable { cause: _ } => none
    LeaseUnobtainable { cause: _ } => none
  }
}

fn completed(a: TransitionActuation) -> Bool {
  match a {
    TransitionActuationCompleted { detail: _ } => true
    TransitionActuationRefused { cause: _ } => false
  }
}

fn refusal_cause(a: TransitionActuation) -> String {
  match a {
    TransitionActuationCompleted { detail: _ } => ""
    TransitionActuationRefused { cause: c } => c
  }
}

fn standing_at(dir: String) -> ActuationStanding {
  transition_actuation_standing(inhibition: transition_inhibition_store(instance: instance_at(dir: dir)))
}

fn permitted(s: ActuationStanding) -> Bool {
  match s {
    ActuationPermitted => true
    ActuationInhibited { record: _ } => false
    ActuationStandingUnreadable { cause: _ } => false
  }
}

fn inhibited_in_phase(s: ActuationStanding, phase: TransitionPhase) -> Bool {
  match s {
    ActuationInhibited { record: r } =>
      r.actor == "deployer" && r.invocation == "run-1"
        && r.candidate == "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        && transition_phase_wire(phase: r.phase) == transition_phase_wire(phase: phase)
    ActuationPermitted => false
    ActuationStandingUnreadable { cause: _ } => false
  }
}

fn unreadable(s: ActuationStanding) -> Bool {
  match s {
    ActuationStandingUnreadable { cause: _ } => true
    ActuationPermitted => false
    ActuationInhibited { record: _ } => false
  }
}

fn admits(a: ActuationAdmission) -> Bool {
  match a {
    ActuationAdmitted => true
    ActuationRefused { reason: _ } => false
  }
}

fn raw_bytes_are(path: String, expected: String) -> Bool {
  let read = Filesystem.Read(path: path)
  read.success && read.content == expected
}

fn raw_absent(path: String) -> Bool {
  !Filesystem.Read(path: path).success
}

// SET, READ, CLEAR THROUGH THE SEALED STORE, and the bytes between are the old format at the old path. The empty
// root is permitted; the set writes exactly the pre-seal bytes and inhibits; the holder's clearance after a
// converged readback removes the marker (and the lease) and the standing is permitted again.
test fn the_sealed_inhibition_sets_and_clears_in_the_unchanged_format() -> Bool {
  let dir = fresh_dir(tag: "set")
  let before = permitted(s: standing_at(dir: dir))
  let verdict = match guard_at(dir: dir) {
    Absent => false
    Present { value: g } =>
      match transition_inhibition_store(instance: instance_at(dir: dir)) {
        TransitionInhibitionStoreUnready { detail: _ } => false
        TransitionInhibitionStoreReady { store: s } => {
          let set = completed(a: set_transition_inhibition(inhibition: s, guard: g))
          let bytes = raw_bytes_are(path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
          let inhibited = inhibited_in_phase(s: standing_at(dir: dir), phase: TransitionInForce)
          let refused = !admits(a: actuation_admission(standing: standing_at(dir: dir)))
          let cleared = completed(a: clear_transition_records(instance_root: dir, inhibition: s, basis: ClearedByHolder(g), readback_converged: true))
          let gone = raw_absent(path: old_inhibition_path(dir: dir)) && raw_absent(path: join([dir, "/transition-lease.json"], ""))
          set && bytes && inhibited && refused && cleared && gone && permitted(s: standing_at(dir: dir))
        }
      }
  }
  cleaned(dir: dir, verdict: before && verdict)
}

// A MARKER THE OLD CODE LEFT IS READ BY THE SEALED STORE. The pre-seal bytes are planted with a raw write at the
// pre-seal path -- no sealed operation involved -- and the standing minted through the store reads them as the
// inhibition they are and refuses actuation.
test fn a_marker_in_the_pre_seal_format_inhibits_through_the_sealed_store() -> Bool {
  let dir = fresh_dir(tag: "old")
  let planted = Filesystem.Write(path: old_inhibition_path(dir: dir), content: old_record_bytes(dir: dir, phase: "in-force")).success
  let standing = standing_at(dir: dir)
  cleaned(dir: dir, verdict: planted && inhibited_in_phase(s: standing, phase: TransitionInForce) && !admits(a: actuation_admission(standing: standing)))
}

// THE CREATE IS EXCLUSIVE THROUGH THE STORE. A second set over a standing marker refuses, names the transition
// that holds it, and leaves the first record's bytes untouched.
test fn a_second_set_refuses_and_leaves_the_standing_marker() -> Bool {
  let dir = fresh_dir(tag: "excl")
  let verdict = match guard_at(dir: dir) {
    Absent => false
    Present { value: g } =>
      match transition_inhibition_store(instance: instance_at(dir: dir)) {
        TransitionInhibitionStoreUnready { detail: _ } => false
        TransitionInhibitionStoreReady { store: s } => {
          let first = completed(a: set_transition_inhibition(inhibition: s, guard: g))
          let second = set_transition_inhibition(inhibition: s, guard: g)
          first && !completed(a: second)
            && string_contains(s: refusal_cause(a: second), pattern: "already stands for deployer/run-1")
            && raw_bytes_are(path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "in-force"))
        }
      }
  }
  cleaned(dir: dir, verdict: verdict)
}

// A PARTIAL TRANSITION REWRITES THE PHASE IN PLACE: after the mark the marker is still there, in the pre-seal
// format with the partial phase, and the belt still refuses.
test fn a_partial_transition_rewrites_the_phase_in_place() -> Bool {
  let dir = fresh_dir(tag: "part")
  let verdict = match guard_at(dir: dir) {
    Absent => false
    Present { value: g } =>
      match transition_inhibition_store(instance: instance_at(dir: dir)) {
        TransitionInhibitionStoreUnready { detail: _ } => false
        TransitionInhibitionStoreReady { store: s } => {
          let set = completed(a: set_transition_inhibition(inhibition: s, guard: g))
          let marked = completed(a: mark_transition_partial(inhibition: s, guard: g, detail: "worktree transition failed"))
          set && marked
            && raw_bytes_are(path: old_inhibition_path(dir: dir), expected: old_record_bytes(dir: dir, phase: "partial-transition-left"))
            && inhibited_in_phase(s: standing_at(dir: dir), phase: TransitionPartialLeft)
        }
      }
  }
  cleaned(dir: dir, verdict: verdict)
}

// THE REALIZATION REMOVED: an instance root that does not list. The mint refuses (no store exists for it), the
// standing is unreadable, and actuation refuses -- never permitted because nothing could be looked at.
test fn an_unlisted_instance_root_mints_no_store_and_refuses_actuation() -> Bool {
  let dir = fresh_dir(tag: "gone")
  let removed = shell.Remove.RecursiveForce(path: dir).success
  let unready = match transition_inhibition_store(instance: instance_at(dir: dir)) {
    TransitionInhibitionStoreUnready { detail: d } => string_contains(s: d, pattern: "transition-inhibition.json")
    TransitionInhibitionStoreReady { store: _ } => false
  }
  let standing = standing_at(dir: dir)
  removed && unready && unreadable(s: standing) && !admits(a: actuation_admission(standing: standing))
}
