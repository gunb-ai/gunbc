module test.claim.r2_mint_secret_access_witness_test

// WHICH CELLS THE MINT'S FEDERATED IDENTITY ASKS FOR, ASSERTED WHERE THAT FACT IS OWNED.
// The reconciler itself -- reconciliation, foreign-binding survival, readback discrimination, the
// role and condition axes, the principal ceiling -- is covered by test.claim.gcp_secret_access_witness
// and must not be restated here; the shared ensure has to stay agnostic about who calls it. What
// this file covers is the fact gunbc.cloudflare.r2_mint_secret_access owns: WHICH secrets and WHICH
// roles the R2 write mint needs, which is precisely what an operator is being asked to grant.
//
// THE PAIRING IS THE POINT, NOT THE ROLE NAMES. Each cell is derived from one effect the mint
// performs, and the two that matter most are the two on the WRITE secret: versionAdder for
// add_initial_version's write, and accessor for the exact-version readback that write is only
// trusted on. A future edit that dropped the readback cell as redundant would leave a mint that
// writes the value and then refuses one call later, having already spent a non-idempotent
// AccountTokens.Create -- so that pairing fails a test rather than passing silently.
import extdeps.cloud.gcp.iam {
  GcpIamBindingCell, gcp_cell_in,
  role_secretmanager_secret_accessor, role_secretmanager_secret_version_adder,
  role_secretmanager_viewer,
}
import gunbc.auth.gcp_secret_access { secret_access_desired_cells }
import gunbc.cloudflare.r2_mint_secret_access {
  r2_mint_bootstrap_secret_target, r2_mint_write_secret_target,
  r2_mint_bootstrap_read_grant, r2_mint_write_container_read_grant,
  r2_mint_write_version_add_grant, r2_mint_write_readback_grant,
  r2_bucket_admin_container_read_grant, r2_bucket_admin_version_add_grant, r2_bucket_admin_read_grant,
}
import gunbc.cloudflare.r2_origin {
  cloudflare_bootstrap_custody_secret_id, fabric_durable_origin_write_secret_id,
  cloudflare_r2_bucket_admin_secret_id,
}
import std.types { String }
import gunbc.gcp_estate_observation { fleet_cloud_convergence_sa_email }
import gunbc.fleet_secrets_config { fleet_secrets_gcp_project }
import std.logic { Bool }

// THE MEMBER IS JOINED TO THE ESTATE DECLARATION, NOT RE-SPELLED. review 65039 flagged this line
// as a literal where a modeled value exists, and I deferred it as non-blocking; the deferral was
// wrong twice over. It is the same §3 fork this PR fixed twice elsewhere, AND the name it declared
// was already declared by three sibling witness files, so this added a FOURTH corpus-global
// declarer of `convergence_member` -- .dag names are corpus-global, so a duplicate declaration is
// not local to the file that writes it. Deriving the member the way gunbc.auth.gcp_secret_access
// grant_member does also makes this test say something true about the principal that will actually
// be bound, rather than about a string someone typed.
fn convergence_member_for_witness() -> String {
  concat("serviceAccount:", fleet_cloud_convergence_sa_email as String)
}

// THE PROJECT IS JOINED TOO, AND THAT IS NOT A VACUOUS COMPARISON. These targets happen to be built
// through gunbc.secret_provision fleet_secret_ref, which reads fleet_secrets_gcp_project -- but the
// assertion exists precisely so a target that did NOT go through it, hand-built with some other
// project, fails here. Comparing against the authority catches that exactly as well as the literal
// "gunbai-secrets" did and additionally survives a legitimate project rename, which the literal
// would have turned into a false red (review 66101).
//
// THE TARGETS ARE JOINED TO THE ORIGIN DECLARATION, NOT RE-SPELLED. A grant that named a secret the
// mint does not write would converge a binding nobody needs and leave the mint refusing anyway.
test fn the_grants_target_the_two_secrets_the_mint_actually_touches() -> Bool {
  let b = r2_mint_bootstrap_secret_target()
  let w = r2_mint_write_secret_target()
  b.secret as String == cloudflare_bootstrap_custody_secret_id as String
    && w.secret as String == fabric_durable_origin_write_secret_id as String
    && b.project == fleet_secrets_gcp_project
    && w.project == fleet_secrets_gcp_project
}

test fn the_bootstrap_grant_is_the_unconditioned_accessor_cell() -> Bool {
  let g = r2_mint_bootstrap_read_grant()
  let cells = secret_access_desired_cells(member: convergence_member_for_witness(), grant: g)
  g.role == role_secretmanager_secret_accessor
    && g.target.secret as String == cloudflare_bootstrap_custody_secret_id as String
    && count(cells) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell {
              role: role_secretmanager_secret_accessor,
              member: convergence_member_for_witness(),
              condition: none
            },
         xs: cells
       )
}

// THE WRITE SECRET NEEDS ALL THREE CELLS, AND NONE IS OPTIONAL. This is the discriminating one: it
// goes red if any of the container read, the version add, or the readback is dropped, or if any is
// widened to a role broader than the effect that needs it.
//
// THE CONTAINER-READ CELL IS THE ONE WITH THE SHARPEST FAILURE. viewer and accessor look
// interchangeable and are not: accessor carries secretmanager.versions.access (a version's payload)
// and NOT secretmanager.secrets.get (the container resource). Collapsing the two would leave
// gunbc.cloudflare.r2_token_mint_run's precondition GET answering 403 at exactly the moment it is
// protecting a non-idempotent, value-returned-once Cloudflare mint.
test fn the_write_secret_gets_container_read_version_add_and_readback_and_nothing_wider() -> Bool {
  let get = r2_mint_write_container_read_grant()
  let add = r2_mint_write_version_add_grant()
  let back = r2_mint_write_readback_grant()
  get.role == role_secretmanager_viewer
    && add.role == role_secretmanager_secret_version_adder
    && back.role == role_secretmanager_secret_accessor
    && get.role != back.role
    && get.target.secret as String == fabric_durable_origin_write_secret_id as String
    && add.target.secret as String == fabric_durable_origin_write_secret_id as String
    && back.target.secret as String == fabric_durable_origin_write_secret_id as String
}

// NO CELL IS CONDITIONED. gunbc.auth.gcp_secret_access partitions conditioned cells as a population
// whose issuing request must be findable, so a conditioned cell authored here without a live grant
// backing it would report as drift against the fleet's own surface.
test fn none_of_the_mint_grants_are_conditioned() -> Bool {
  match r2_mint_bootstrap_read_grant().condition {
    Present { value: _ } => false
    Absent =>
      match r2_mint_write_container_read_grant().condition {
        Present { value: _ } => false
        Absent =>
      match r2_mint_write_version_add_grant().condition {
        Present { value: _ } => false
        Absent =>
          match r2_mint_write_readback_grant().condition {
            Present { value: _ } => false
            Absent => true
          }
      }
      }
  }
}

// THE BUCKET-ADMIN CONTAINER GETS THE SAME THREE CELLS ON ITS OWN SECRET, AND NONE ON THE BOOTSTRAP'S.
// Red if a cell is dropped, widened, conditioned, or pointed at the bootstrap or write container --
// the last would let the bucket converge's identity read the key that mints.
test fn the_bucket_admin_secret_gets_container_read_version_add_and_read_on_its_own_container() -> Bool {
  let get = r2_bucket_admin_container_read_grant()
  let add = r2_bucket_admin_version_add_grant()
  let read = r2_bucket_admin_read_grant()
  let id = cloudflare_r2_bucket_admin_secret_id as String
  get.role == role_secretmanager_viewer
    && add.role == role_secretmanager_secret_version_adder
    && read.role == role_secretmanager_secret_accessor
    && get.target.secret as String == id
    && add.target.secret as String == id
    && read.target.secret as String == id
    && id != cloudflare_bootstrap_custody_secret_id as String
    && id != fabric_durable_origin_write_secret_id as String
    && match get.condition { Present { value: _ } => false Absent => true }
    && match add.condition { Present { value: _ } => false Absent => true }
    && match read.condition { Present { value: _ } => false Absent => true }
}
