module test.claim.zzprobe_partition

import v2.std.orchestration { Pipeline, FailFast }
import gunbc.live_deploy.emit { approval_broker_dark_install_script, approval_broker_dark_install_intent, emit_pipeline_or_poison, deploy_raw, RevisionBoundAtEmission }
import gunbc.live_deploy.desired { deployment_spec_srv1 }
import test.claim.live_deploy.deploy_release_fixture { deploy_witness_release_revision }

// THROWAWAY PROBE (never merged): isolates the floor's fill/marginal partition of the dark-install render.
test fn zp_a_render() -> Bool { !(approval_broker_dark_install_script(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision }) == "x") }
test fn zp_b_intent() -> Bool { count(approval_broker_dark_install_intent(spec: deployment_spec_srv1(), revision: RevisionBoundAtEmission { revision: deploy_witness_release_revision }).steps) > 0 }
test fn zp_c_orch40() -> Bool { !(emit_pipeline_or_poison(p: Pipeline { steps: [deploy_raw(command: "echo probe-step-0"), deploy_raw(command: "echo probe-step-1"), deploy_raw(command: "echo probe-step-2"), deploy_raw(command: "echo probe-step-3"), deploy_raw(command: "echo probe-step-4"), deploy_raw(command: "echo probe-step-5"), deploy_raw(command: "echo probe-step-6"), deploy_raw(command: "echo probe-step-7"), deploy_raw(command: "echo probe-step-8"), deploy_raw(command: "echo probe-step-9"), deploy_raw(command: "echo probe-step-10"), deploy_raw(command: "echo probe-step-11"), deploy_raw(command: "echo probe-step-12"), deploy_raw(command: "echo probe-step-13"), deploy_raw(command: "echo probe-step-14"), deploy_raw(command: "echo probe-step-15"), deploy_raw(command: "echo probe-step-16"), deploy_raw(command: "echo probe-step-17"), deploy_raw(command: "echo probe-step-18"), deploy_raw(command: "echo probe-step-19"), deploy_raw(command: "echo probe-step-20"), deploy_raw(command: "echo probe-step-21"), deploy_raw(command: "echo probe-step-22"), deploy_raw(command: "echo probe-step-23"), deploy_raw(command: "echo probe-step-24"), deploy_raw(command: "echo probe-step-25"), deploy_raw(command: "echo probe-step-26"), deploy_raw(command: "echo probe-step-27"), deploy_raw(command: "echo probe-step-28"), deploy_raw(command: "echo probe-step-29"), deploy_raw(command: "echo probe-step-30"), deploy_raw(command: "echo probe-step-31"), deploy_raw(command: "echo probe-step-32"), deploy_raw(command: "echo probe-step-33"), deploy_raw(command: "echo probe-step-34"), deploy_raw(command: "echo probe-step-35"), deploy_raw(command: "echo probe-step-36"), deploy_raw(command: "echo probe-step-37"), deploy_raw(command: "echo probe-step-38"), deploy_raw(command: "echo probe-step-39")], on_failure: FailFast }, refused: "R") == "R") }
test fn zp_d_spec() -> Bool { !(deployment_spec_srv1().instance_id as String == "x") }
