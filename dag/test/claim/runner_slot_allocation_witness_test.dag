module test.claim.runner_slot_allocation_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn runner_slot_allocation_wall_holds() -> Bool {
  gunbc.runner_slot_allocation.gunbc_runner_slot_allocation_wall_holds()
}

test fn runner_slot_allocation_oversubscription_boundary_exact() -> Bool {
  let per_slot = gunbc.runner_slot_allocation.gunbc_runner_slot_desired()
  all(
    gunbc.runner_slot_allocation.gunbc_committed_runner_slot_allocations(),
    a =>
      gunbc.runner_slot_allocation.gunbc_runner_slot_oversubscription_within_slice(
        slots: gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: a.host),
        per_slot: per_slot.memory_max,
        slice_cap: gunbc.runner_slot_allocation.gunbc_runner_slice_cap_declared(host: a.host)
      )
  )
}

fn committed_allocation_for(host: product.placement_supply.HostIdentity) -> Int {
  fold(
    gunbc.runner_slot_allocation.gunbc_committed_runner_slot_allocations(),
    init: 0,
    f: (n, a) => if (a.host as String) == (host as String) { n + 1 } else { n }
  )
}

test fn runner_slot_allocation_committed_hosts_cover_the_fleet_exactly_once() -> Bool {
  committed_allocation_for(host: operator_host_srv1) == 1
    && committed_allocation_for(host: operator_host_srv2) == 1
    && committed_allocation_for(host: operator_host_srv3) == 1
    && committed_allocation_for(host: operator_host_srv4) == 1
    && committed_allocation_for(host: "srv-does-not-exist") == 0
}

data widths_are_pinned_on_both_axes_note: String = "MEMORY ADMISSIONS AND COMMITTED WIDTHS ARE PINNED SEPARATELY. srv4's historical disk row-pin is retired: allocation commits 6 at the memory axis (7 before the 2026-08-17 16GiB ruling) and disk binding moves to apply-time gunbc.runner_lifecycle runner_width_disk_preflight. Asserting only 5/5/6/6 committed would miss a reintroduced disk pin; asserting only memory admissions would miss provisioning without the apply gate."

test fn runner_slot_allocation_memory_admissions_differ_by_host_class() -> Bool {
  gunbc.runner_slot_allocation.host_memory_admitted_width(host: operator_host_srv1) == 5
    && gunbc.runner_slot_allocation.host_memory_admitted_width(host: operator_host_srv2) == 5
    && gunbc.runner_slot_allocation.host_memory_admitted_width(host: operator_host_srv3) == 6
    && gunbc.runner_slot_allocation.host_memory_admitted_width(host: operator_host_srv4) == 6
}

test fn runner_slot_allocation_committed_widths_match_memory_admission() -> Bool {
  gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: operator_host_srv1) == 5
    && gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: operator_host_srv2) == 5
    && gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: operator_host_srv3) == 6
    && gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: operator_host_srv4) == 6
}

test fn runner_slot_allocation_srv4_disk_unconstrained_at_allocation() -> Bool {
  match gunbc.runner_slot_allocation.host_disk_admitted_width(host: operator_host_srv4) {
    DiskWidthUnconstrained { reason: r } => string_contains(s: r, pattern: "runner_width_disk_preflight")
    DiskAdmitsWidth { slots: _, provenance: _ } => false
  }
}

test fn runner_slot_allocation_RED_oversubscription_exceeds_slice() -> Bool {
  let per_slot = gunbc.runner_slot_allocation.gunbc_runner_slot_desired()
  all(
    gunbc.runner_slot_allocation.gunbc_committed_runner_slot_allocations(),
    a =>
      !gunbc.runner_slot_allocation.gunbc_runner_slot_oversubscription_within_slice(
        slots: gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: a.host) + 1,
        per_slot: per_slot.memory_max,
        slice_cap: gunbc.runner_slot_allocation.gunbc_runner_slice_cap_declared(host: a.host)
      )
  )
}

test fn runner_slot_allocation_unknown_host_refuses_a_width() -> Bool {
  gunbc.runner_slot_allocation.gunbc_runner_slots_per_host(host: "srv-does-not-exist") == 0
    && std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slice_cap_declared(host: "srv-does-not-exist")) == 0
}

test fn runner_slot_allocation_memory_high_clears_the_measured_floor() -> Bool {
  std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high) > std.measure.byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
}

test fn runner_slot_allocation_enforcement_expected_cap_is_desired_memory_max() -> Bool {
  std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_enforcement_expected_cap()) == std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_max)
}

test fn runner_slot_allocation_minimum_viable_armed_budget_wall_holds() -> Bool {
  gunbc.runner_slot_allocation.gunbc_floor_minimum_viable_armed_budget_wall_holds()
}

test fn runner_slot_allocation_minimum_viable_armed_budget_is_12_gib() -> Bool {
  std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_floor_minimum_viable_armed_budget_bytes()) == std.measure.byte_size_count(b: std.measure.byte_size(12884901888))
}

data srv2_03_effective_cap_drift_note: String = "SUBJECT B (effective cap on srv2-03): binds 16GiB/15GiB and the declaration now MATCHES it, so the 2GiB drift this subject was written for is dissolved (gunbc.runner_slot_allocation gunbc_srv2_03_drift_dissolved_by_ruling_note). The witness below asserts the ABSENCE of drift; the readback-refusal predicate keeps its discriminating input from gunbc_synthetic_drifted_cap_observation instead, deliberately synthetic so no convergence can green it. Dissolve-on: post-apply readback replaces gunbc_srv2_03_effective_cap_observation."

data declared_row_floor_peak_derivation_note: String = "SUBJECT A (declared row): 16GiB/15GiB derives from the 2026-08-17 floor-peak ruling superseding the 2026-08-05 calibration (gunbc_runner_slot_memory_max_ruling_note), NOT from srv2-03 live readback — that the two now coincide is a coincidence recorded as one in that ruling. This witness pins only the declared constants."

data srv2_03_readback_refusal_note: String = "SUBJECT C (refusal): gunbc_runner_slot_allocation_refuses_effective_readback_reconciliation is the structural predicate — effective readback must not become declaration authority when drift exists. Its discriminating input is now gunbc_synthetic_drifted_cap_observation, srv2-03 having stopped drifting; a synthetic fixture is used precisely so that a future converge cannot silently retire this predicate's only witness."

data srv2_03_converge_floor_fit_note: String = "SUBJECT D (converge consequence): ANSWERED, not pending. Modeled-budget compliance under the superseded 14GiB/13GiB row is now MEASURED and it failed — an uncensored 15509315584-byte floor peak above that max, plus srv1 pinned at exactly 13.00GiB with 829 and 44803 memory.high events once it was actually converged there. The floor cgroup leaf events at T5 entry remain zero as the baseline they always were, and srv2-03 has no envelope left to enforce because the declaration moved to meet it. Superseded detail retained: converge would first enforce the modeled envelope against the CI floor consumer (gunbc_srv2_03_converge_floor_fit_note). No OOM outcome and no floor byte figure are asserted."

test fn witness_declared_row_pins_16_15_gib_from_floor_peak_ruling() -> Bool {
  std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_max) == std.measure.byte_size_count(b: std.measure.byte_size(17179869184))
    && std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high) == std.measure.byte_size_count(b: std.measure.byte_size(16106127360))
}

test fn witness_declared_high_clears_measured_floor_peak() -> Bool {
  std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high)
    >= std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_floor_measured_peak_observation)
}

test fn witness_floor_peak_input_is_uncensored_not_a_throttle_pin() -> Bool {
  gunbc.runner_slot_allocation.gunbc_floor_measured_peak_is_uncensored()
}

test fn witness_RED_binary_unit_reading_would_exceed_the_armed_line() -> Bool {
  std.measure.byte_size_count(b: std.measure.byte_size(16750372454)) > std.measure.byte_size_count(b: gunbc.runner_slot_allocation.gunbc_floor_measured_peak_armed_high)
}

test fn witness_srv2_03_observation_no_longer_drifts_after_ruling() -> Bool {
  match gunbc.runner_slot_allocation.gunbc_srv2_03_effective_cap_observation {
    RunnerSlotEffectiveCapMeasured { runner_unit: unit, memory_max: max, memory_high: high, probed_at: _ } =>
      unit == "actions-runner@srv2-03.service"
        && std.measure.byte_size_count(b: max) == std.measure.byte_size_count(b: std.measure.byte_size(17179869184))
        && std.measure.byte_size_count(b: high) == std.measure.byte_size_count(b: std.measure.byte_size(16106127360))
        && !gunbc.runner_slot_allocation.runner_slot_effective_memory_max_drifts_from_declaration(effective: max)
        && !gunbc.runner_slot_allocation.runner_slot_effective_memory_high_drifts_from_declaration(effective: high)
    _ => false
  }
}

test fn witness_readback_refusal_stays_witnessed_by_synthetic_drift() -> Bool {
  gunbc.runner_slot_allocation.gunbc_readback_refusal_stays_witnessed_by_synthetic_drift()
}

test fn witness_srv2_03_floor_leaf_cgroup_events_at_entry_are_zero() -> Bool {
  gunbc.runner_slot_allocation.srv2_03_floor_leaf_cgroup_events_at_entry_are_zero()
}

test fn witness_srv2_03_RED_converged_cap_would_not_refuse_readback_reconciliation() -> Bool {
  !gunbc.runner_slot_allocation.gunbc_runner_slot_allocation_refuses_effective_readback_reconciliation(
    obs: gunbc.runner_slot_allocation.RunnerSlotEffectiveCapMeasured {
      runner_unit: "actions-runner@srv2-03.service",
      memory_max: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_max,
      memory_high: gunbc.runner_slot_allocation.gunbc_runner_slot_desired().memory_high,
      probed_at: "synthetic-converged-control",
    }
  )
}
