module test.claim.runner_slot_allocation_witness

import gunbc.runner_slot_allocation {
  gunbc_runner_slot_allocation_wall_holds,
  gunbc_runner_slot_oversubscription_within_slice,
  gunbc_runner_slot_desired,
  gunbc_runner_slots_per_host,
  gunbc_runner_slice_cap_declared,
  gunbc_committed_runner_slot_allocations,
  gunbc_runner_slot_enforcement_expected_cap,
  gunbc_runner_slot_thrash_not_fail_policy_holds,
}
import gunbc.runner_slot_oom_policy {
  gunbc_runner_slot_oom_pressure_kill,
  gunbc_runner_slot_oom_pressure_limit,
}
import extdeps.os.oomd { ManagedOomKill }
import std.measure { byte_size, byte_size_count, percent_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn runner_slot_allocation_wall_holds() -> Bool {
  gunbc_runner_slot_allocation_wall_holds()
}

test fn runner_slot_allocation_oversubscription_boundary_exact() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  gunbc_runner_slot_oversubscription_within_slice(
    slots: gunbc_runner_slots_per_host(),
    per_slot: per_slot.memory_max,
    slice_cap: gunbc_runner_slice_cap_declared()
  )
}

test fn runner_slot_allocation_committed_hosts_nonempty() -> Bool {
  (gunbc_committed_runner_slot_allocations() |> count) == 3
}

test fn runner_slot_allocation_RED_oversubscription_exceeds_slice() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  !gunbc_runner_slot_oversubscription_within_slice(
    slots: gunbc_runner_slots_per_host() + 1,
    per_slot: per_slot.memory_max,
    slice_cap: gunbc_runner_slice_cap_declared()
  )
}

test fn runner_slot_allocation_enforcement_expected_cap_is_desired_memory_max() -> Bool {
  byte_size_count(b: gunbc_runner_slot_enforcement_expected_cap()) == byte_size_count(b: gunbc_runner_slot_desired().memory_max)
}

test fn runner_slot_allocation_thrash_not_fail_policy_holds() -> Bool {
  gunbc_runner_slot_thrash_not_fail_policy_holds()
}

test fn runner_slot_allocation_oom_pressure_kill_is_true() -> Bool {
  gunbc_runner_slot_oom_pressure_kill()
}

test fn runner_slot_allocation_managed_oom_memory_pressure_is_kill() -> Bool {
  match gunbc_runner_slot_desired().managed_oom_memory_pressure {
    ManagedOomKill => true
    _ => false
  }
}

test fn runner_slot_allocation_oom_pressure_limit_matches_policy() -> Bool {
  percent_count(p: gunbc_runner_slot_desired().managed_oom_memory_pressure_limit) == percent_count(p: gunbc_runner_slot_oom_pressure_limit())
}

test fn runner_slot_allocation_RED_oom_pressure_kill_disabled_would_break_thrash_not_fail() -> Bool {
  gunbc_runner_slot_thrash_not_fail_policy_holds() && gunbc_runner_slot_oom_pressure_kill()
}
