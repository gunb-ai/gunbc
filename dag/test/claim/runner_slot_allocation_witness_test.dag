module test.claim.runner_slot_allocation_witness

import gunbc.runner_slot_allocation {
  gunbc_runner_slot_allocation_wall_holds,
  gunbc_runner_slot_oversubscription_within_slice,
  gunbc_runner_slot_desired,
  candidate_width_under_current_topology,
  actuatable_desired_width,
  observed_live_width,
  width_actuation_standing,
  ActuationGrounded,
  ActuationUngrounded,
  host_memory_admitted_width,
  host_disk_admitted_width,
  DiskAdmitsWidth,
  DiskWidthUnconstrained,
  gunbc_runner_slice_cap_declared,
  gunbc_committed_runner_slot_allocations,
  gunbc_runner_slot_enforcement_expected_cap,
  gunbc_floor_minimum_viable_armed_budget_wall_holds,
  gunbc_floor_minimum_viable_armed_budget_bytes,
}
import std.measure { byte_size, byte_size_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn runner_slot_allocation_wall_holds() -> Bool {
  gunbc_runner_slot_allocation_wall_holds()
}

test fn runner_slot_allocation_oversubscription_boundary_exact() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  all(
    gunbc_committed_runner_slot_allocations(),
    a =>
      gunbc_runner_slot_oversubscription_within_slice(
        slots: actuatable_desired_width(host: a.host),
        per_slot: per_slot.memory_max,
        slice_cap: gunbc_runner_slice_cap_declared(host: a.host)
      )
  )
}

fn committed_allocation_for(host: HostIdentity) -> Int {
  fold(
    gunbc_committed_runner_slot_allocations(),
    init: 0,
    f: (n, a) => if (a.host as String) == (host as String) { n + 1 } else { n }
  )
}

test fn runner_slot_allocation_committed_hosts_cover_the_fleet_exactly_once() -> Bool {
  committed_allocation_for(host: operator_host_srv1) == 1
    && committed_allocation_for(host: operator_host_srv2) == 1
    && committed_allocation_for(host: operator_host_srv3) == 1
    && committed_allocation_for(host: operator_host_srv4) == 1
    && committed_allocation_for(host: "srv-does-not-exist") == 0
}

data widths_are_pinned_on_both_axes_note: String = "BOTH AXES ARE PINNED SEPARATELY, because the committed width is a minimum and a minimum can be right for the wrong reason. Asserting only the committed 5/5/7/5 would pass if the disk cap vanished and srv4's MEMORY admission fell to 5 instead — the same four numbers from a broken memory model. Asserting only the memory admissions would pass while the fleet provisioned a seventh slot onto srv4's 500GB disk.\n\nSo the memory admission is pinned at 5/5/7/7, the committed width at 5/5/7/5, and srv4 is the row where they are asserted to DIFFER. That last conjunct is what makes the pair discriminating rather than redundant: it fails if the two axes are ever collapsed back into one, in either direction."

test fn runner_slot_allocation_memory_admissions_differ_by_host_class() -> Bool {
  host_memory_admitted_width(host: operator_host_srv1) == 5
    && host_memory_admitted_width(host: operator_host_srv2) == 5
    && host_memory_admitted_width(host: operator_host_srv3) == 7
    && host_memory_admitted_width(host: operator_host_srv4) == 7
}

test fn runner_slot_allocation_candidate_widths_take_the_binding_axis() -> Bool {
  candidate_width_under_current_topology(host: operator_host_srv1) == 5
    && candidate_width_under_current_topology(host: operator_host_srv2) == 5
    && candidate_width_under_current_topology(host: operator_host_srv3) == 7
    && candidate_width_under_current_topology(host: operator_host_srv4) == 5
    && candidate_width_under_current_topology(host: operator_host_srv4) < host_memory_admitted_width(host: operator_host_srv4)
}

data three_widths_are_pinned_separately_note: String = "EACH WIDTH IS PINNED AGAINST ITS OWN CLAIM, and the rows are worth having separately because a single assertion cannot distinguish the three states that produced this split. Candidate is 5/5/7/5 — what the resolved constraints admit. Actuatable is 5/5/5/5 — what can be reached through the modeled path, which is nothing beyond what is already running because no activation receipt exists on any host. Observed is 5/5/5/5 — what the machines are running.\n\nsrv3 IS THE ROW THAT DISCRIMINATES: it is the only host whose candidate and actuatable differ, so a change that re-collapsed the widths, or that quietly advanced actuatable without a receipt, reds here and nowhere else. That second failure is the one worth catching — advancing actuatable is how two runners would get claimed on a machine nobody provisioned."

test fn actuatable_width_never_exceeds_candidate() -> Bool {
  all(
    gunbc_committed_runner_slot_allocations(),
    a => actuatable_desired_width(host: a.host) <= candidate_width_under_current_topology(host: a.host)
  )
}

test fn actuatable_width_is_the_observed_width_while_activation_is_ungrounded() -> Bool {
  all(
    [operator_host_srv1, operator_host_srv2, operator_host_srv3, operator_host_srv4],
    h =>
      match width_actuation_standing(host: h) {
        ActuationUngrounded { reason: _ } => actuatable_desired_width(host: h) == observed_live_width(host: h)
        ActuationGrounded { receipt: _ } => actuatable_desired_width(host: h) == candidate_width_under_current_topology(host: h)
      }
  )
}

test fn srv3_is_the_host_whose_candidate_exceeds_what_can_be_actuated() -> Bool {
  candidate_width_under_current_topology(host: operator_host_srv3) == 7
    && actuatable_desired_width(host: operator_host_srv3) == 5
    && observed_live_width(host: operator_host_srv3) == 5
}

test fn runner_slot_allocation_RED_oversubscription_exceeds_slice() -> Bool {
  let per_slot = gunbc_runner_slot_desired()
  all(
    gunbc_committed_runner_slot_allocations(),
    a =>
      !gunbc_runner_slot_oversubscription_within_slice(
        slots: actuatable_desired_width(host: a.host) + 1,
        per_slot: per_slot.memory_max,
        slice_cap: gunbc_runner_slice_cap_declared(host: a.host)
      )
  )
}

test fn runner_slot_allocation_unknown_host_refuses_a_width() -> Bool {
  candidate_width_under_current_topology(host: "srv-does-not-exist") == 0
    && actuatable_desired_width(host: "srv-does-not-exist") == 0
    && observed_live_width(host: "srv-does-not-exist") == 0
    && byte_size_count(b: gunbc_runner_slice_cap_declared(host: "srv-does-not-exist")) == 0
}

test fn runner_slot_allocation_memory_high_clears_the_measured_floor() -> Bool {
  byte_size_count(b: gunbc_runner_slot_desired().memory_high) > byte_size_count(b: gunbc_floor_minimum_viable_armed_budget)
}

test fn runner_slot_allocation_enforcement_expected_cap_is_desired_memory_max() -> Bool {
  byte_size_count(b: gunbc_runner_slot_enforcement_expected_cap()) == byte_size_count(b: gunbc_runner_slot_desired().memory_max)
}

test fn runner_slot_allocation_minimum_viable_armed_budget_wall_holds() -> Bool {
  gunbc_floor_minimum_viable_armed_budget_wall_holds()
}

test fn runner_slot_allocation_minimum_viable_armed_budget_is_12_gib() -> Bool {
  byte_size_count(b: gunbc_floor_minimum_viable_armed_budget_bytes()) == byte_size_count(b: byte_size(12884901888))
}
