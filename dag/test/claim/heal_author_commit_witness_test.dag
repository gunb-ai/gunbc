
module test.claim.heal_author_commit_witness

import gunbc.generated_artifact {
  CiYamlArtifact, FalsifierYamlArtifact, GitignoreArtifact, DesignArtifact,
  artifact_path
}
import gunbc.heal_push_plan {
  classify_heal_repair_paths,
  HealRepairNoDrift,
  HealRepairAutoPushEligibleOnly,
  HealRepairAuthorCommitRequired,
  HealRepairMixed,
  path_requires_author_commit
}
import gunbc.ci_spec {
  ci_heal_author_commit_regen_command,
  gunbc_ci_heal_commit_push_script
}

data heal_author_commit_witness_note: String = "Synthetic executing controls for the two repair dispositions (operator brief 2026-08-02). Control 1: non-workflow generated drift classifies as AutoPushEligibleOnly — the heal shell stages auto_push_eligible paths and retains git push for that population. Control 2: workflow-only drift classifies as AuthorCommitRequired — the shell detects workflow paths, packages heal-author-commit-required/, emits HealAuthorCommitRequired with every affected path and the local regen command, and never git-adds workflow paths. RED controls flip the classification or shell structure."

test fn control_non_workflow_drift_is_auto_push_eligible_only() -> Bool {
  match classify_heal_repair_paths(changed_paths: [".gitignore", "DESIGN.md"]) {
    HealRepairAutoPushEligibleOnly { paths } =>
      (paths == [".gitignore", "DESIGN.md"])
    HealRepairNoDrift => false
    HealRepairAuthorCommitRequired { paths: _ } => false
    HealRepairMixed { auto_push_paths: _, author_commit_paths: _ } => false
  }
}

test fn control_workflow_only_drift_is_author_commit_required() -> Bool {
  match classify_heal_repair_paths(changed_paths: [
    artifact_path(a: CiYamlArtifact),
    artifact_path(a: FalsifierYamlArtifact)
  ]) {
    HealRepairAuthorCommitRequired { paths } =>
      (paths == [
        artifact_path(a: CiYamlArtifact),
        artifact_path(a: FalsifierYamlArtifact)
      ])
    HealRepairNoDrift => false
    HealRepairAutoPushEligibleOnly { paths: _ } => false
    HealRepairMixed { auto_push_paths: _, author_commit_paths: _ } => false
  }
}

test fn control_mixed_drift_partitions_both_populations() -> Bool {
  match classify_heal_repair_paths(changed_paths: [
    ".gitignore",
    artifact_path(a: CiYamlArtifact)
  ]) {
    HealRepairMixed { auto_push_paths, author_commit_paths } =>
      (auto_push_paths == [".gitignore"])
        && (author_commit_paths == [artifact_path(a: CiYamlArtifact)])
    HealRepairNoDrift => false
    HealRepairAutoPushEligibleOnly { paths: _ } => false
    HealRepairAuthorCommitRequired { paths: _ } => false
  }
}

test fn control_workflow_shell_never_stages_workflow_paths() -> Bool {
  let script = gunbc_ci_heal_commit_push_script()
  !string_contains(s: script, pattern: concat("git add \"", artifact_path(a: CiYamlArtifact)))
    && !string_contains(s: script, pattern: concat("git add \"", artifact_path(a: FalsifierYamlArtifact)))
    && string_contains(s: script, pattern: concat("git add \"", artifact_path(a: GitignoreArtifact)))
}

test fn control_workflow_shell_emits_regen_command_and_artifact_dir() -> Bool {
  let script = gunbc_ci_heal_commit_push_script()
  string_contains(s: script, pattern: "HealAuthorCommitRequired")
    && string_contains(s: script, pattern: ci_heal_author_commit_regen_command)
    && string_contains(s: script, pattern: "heal-author-commit-required")
    && string_contains(s: script, pattern: "author_commit_paths=$AUTHOR_COMMIT_DRIFT")
}

test fn red_control_gitignore_is_not_author_commit_required() -> Bool {
  !path_requires_author_commit(path: ".gitignore")
}

test fn red_control_ci_yml_is_author_commit_required() -> Bool {
  path_requires_author_commit(path: artifact_path(a: CiYamlArtifact))
}
