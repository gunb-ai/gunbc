data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// ──────────────────────────────────────────────────────────────────────────────────────────────────────
// THE FIXTURES, READ FROM DISK. Files rather than pasted strings so the document that decides a converge's
// arm is one artifact a reviewer can open, diff and reuse -- and so a claim can hold the FIXTURE to its own
// meaning. A refused read yields the empty document, and every claim below distinguishes "answered" from
// "could not be read": a witness that passes because its fixture was unreadable is the same silent-success
// class this whole change is about.
// ──────────────────────────────────────────────────────────────────────────────────────────────────────

data fleet_member_fixture_path: FilePath = "dag/test/fixture/tailscale_status_fleet_member.json"
data hand_joined_fixture_path: FilePath = "dag/test/fixture/tailscale_status_hand_joined_no_tags.json"
data foreign_tag_fixture_path: FilePath = "dag/test/fixture/tailscale_status_foreign_tag_only.json"
// The operator's ruling of 2026-11-18 ("C both tags is fine"; operator, in chat to smart-crane-730): the
// fleet's both_participation hosts (ken, dan/h11-a16) carry tag:ci AND tag:serving, so the converge reaches
// them over the tailnet AND the serving grants still apply. These two fixtures witness that a node carrying
// both tags is a fleet member (ci present), while one carrying ONLY serving is not yet (the fleet tag gates
// membership, not the mere presence of any tag).
data ci_and_serving_fixture_path: FilePath = "dag/test/fixture/tailscale_status_fleet_member_ci_and_serving.json"
data serving_only_fixture_path: FilePath = "dag/test/fixture/tailscale_status_serving_tag_only.json"
data not_joined_fixture_path: FilePath = "dag/test/fixture/tailscale_status_not_joined.json"
data running_without_self_fixture_path: FilePath = "dag/test/fixture/tailscale_status_running_without_self.json"

fn fixture_text(path: FilePath) -> String {
  Filesystem.Read(path: path, expect: ExpectSuccess).content
}

// A document no fixture file is needed for: `Self.Tags` present but NOT a list. Upstream's member is a list of
// strings, so this is a malformed document, and the case exists to pin the distinction -- a document that cannot
// be read for tags must not answer "tagless", because "tagless" is the arm that refuses.
data tags_member_not_a_list_document: String =
  "{\"Version\":\"fixture\",\"BackendState\":\"Running\",\"Self\":{\"HostName\":\"srv1\",\"Tags\":\"tag:ci\"}}"

// The state one fixture document yields, at the boundary where it is decided -- the tag asked for is the fleet's
// own authority, so nothing in these claims hand-waves a tag into existence.
fn state_of(fixture: FilePath) -> TailscaleJoinState {
  tailscale_up_join_state_of(status_json: fixture_text(path: fixture), required_tag: tailscale_fleet_node_tag)
}

// The plan for a document, on an ALLOCATED host. The host has to be srv1's handle because the plan refuses any
// host with no allocated hostname BEFORE it asks the join question -- an ordering worth knowing: a specimen like
// ken, in no allocation roster, refuses today for a different reason. The arm added here is for the host that IS
// enrolled and IS hand-joined, which is the fail-open that was live.
fn plan_for(document: String, key_usable: Bool) -> TailscaleJoinPlan {
  tailscale_join_plan(
    host: operator_host_srv1,
    observation: JoinObsInstalled { join_state: tailscale_up_join_state_of(status_json: document, required_tag: tailscale_fleet_node_tag) },
    key_usable: key_usable,
  )
}

// THE OBSERVATION SUM + ITS GUARDS (the fix for srv4, run 44643376146, and reviews 96824 + 96828).
// tailscale_join_plan takes a single TailscaleJoinObservation sum: JoinObsInstall / JoinObsRefused /
// JoinObsInstalled{join_state}. w_package_decides_before_the_join_state exercises the plan arms;
// w_install_requires_binary_absent_or_positive_not_joined witnesses tailscale_join_observation_of -- the builder.
// The destructive `tailscale up --force-reauth` is authorized ONLY for JoinObsInstall, which the builder emits
// only when the status is 127 (binary absent) or positively NotJoined. A host dpkg cannot see but which IS joined
// stays JoinObsInstalled (Noop / NotFleetMember); an UNREADABLE status (not 127) REFUSES -- it does not prove
// "not joined" (review 96828).
fn plan_installs(p: TailscaleJoinPlan) -> Bool {
  match p {
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: action } =>
      action == JoinPackageInstall
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
    JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
  }
}

fn plan_refused(p: TailscaleJoinPlan) -> Bool {
  match p {
    JoinPlanRefused { host: _, cause: cause } => cause != ""
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
    JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
  }
}

fn obs_is_install(o: TailscaleJoinObservation) -> Bool {
  match o {
    JoinObsInstall { status_string: _ } => true
    JoinObsInstalled { join_state: _ } => false
    JoinObsRefused { cause: _ } => false
  }
}

fn obs_is_installed(o: TailscaleJoinObservation) -> Bool {
  match o {
    JoinObsInstalled { join_state: _ } => true
    JoinObsInstall { status_string: _ } => false
    JoinObsRefused { cause: _ } => false
  }
}

fn obs_is_refused(o: TailscaleJoinObservation) -> Bool {
  match o {
    JoinObsRefused { cause: cause } => cause != ""
    JoinObsInstalled { join_state: _ } => false
    JoinObsInstall { status_string: _ } => false
  }
}

test fn w_package_decides_before_the_join_state() -> Bool {
  let install = tailscale_join_plan(
    host: operator_host_srv1,
    observation: JoinObsInstall { status_string: Absent },
    key_usable: true,
  )
  let refused = tailscale_join_plan(
    host: operator_host_srv1,
    observation: JoinObsRefused { cause: "dpkg could not answer whether tailscale is installed" },
    key_usable: true,
  )
  let installed_unreadable = tailscale_join_plan(
    host: operator_host_srv1,
    observation: JoinObsInstalled { join_state: JoinStateUnreadable { cause: "status leg exited non-zero with the binary present" } },
    key_usable: true,
  )
  plan_installs(install)
    && plan_refused(refused)
    && plan_refused(installed_unreadable)
}

// The dpkg leg's wet decoding, witnessed at the decision the wet makes. `dpkg-query -s <absent>` exits 1 and
// prints "... is not installed and no information is available" -- a dpkg ANSWER (Unknown = definite absence),
// NOT an execution failure. The wet used to short-circuit ANY non-zero exit to Undecidable, so srv4 (live run
// 44677315667) refused to install tailscale on a host that simply did not have it. Now a CONVERGED leg is decoded
// by dpkg_query_status_verdict_of: the exit-1-marker shape -> Unknown -> (with a 127 binary-absent status) ->
// JoinObsInstall -> the plan INSTALLS; a transport refusal and a genuine non-0/non-1 dpkg failure stay Undecidable
// and refuse. Mirrors the proven sibling observe_site_pxe_edge_package.
fn pkg_is_unknown(s: DpkgInstalledState) -> Bool {
  match s {
    DpkgPackageUnknown => true
    _ => false
  }
}

fn pkg_is_undecidable(s: DpkgInstalledState) -> Bool {
  match s {
    DpkgQueryUndecidable { reason: _ } => true
    _ => false
  }
}

test fn w_fresh_host_dpkg_answer_installs_not_refuses() -> Bool {
  let fresh_host = tailscale_join_package_verdict_of(
    outcome: TypedArgvExecConverged {
      result: SshSessionExecResult {
        exit_code: 1,
        success: false,
        stdout: "",
        stderr: "dpkg-query: package 'tailscale' is not installed and no information is available\nUse dpkg --info (= dpkg-deb --info) to examine archive files.",
      },
    },
  )
  let transport_down = tailscale_join_package_verdict_of(
    outcome: TypedArgvExecRefused { reason: "ssh transport down" },
  )
  let dpkg_broken = tailscale_join_package_verdict_of(
    outcome: TypedArgvExecConverged {
      result: SshSessionExecResult {
        exit_code: 2,
        success: false,
        stdout: "",
        stderr: "dpkg-query: an unexpected failure with no recognizable answer",
      },
    },
  )
  let install_obs = tailscale_join_observation_of(package: fresh_host, status: StatusBinaryAbsent)
  let refusal_transport = tailscale_join_observation_of(package: transport_down, status: StatusBinaryAbsent)
  let refusal_broken = tailscale_join_observation_of(package: dpkg_broken, status: StatusBinaryAbsent)
  pkg_is_unknown(fresh_host)
    && obs_is_install(install_obs)
    && plan_installs(
      tailscale_join_plan(
        host: operator_host_srv1,
        observation: install_obs,
        key_usable: true,
      )
    )
    && pkg_is_undecidable(transport_down)
    && obs_is_refused(refusal_transport)
    && pkg_is_undecidable(dpkg_broken)
    && obs_is_refused(refusal_broken)
}

// The guard (reviews 96824 + 96828). Install (and its destructive `tailscale up --force-reauth`) is authorized
// ONLY on a binary-absent (127) or a positive NotJoined reading. A host dpkg cannot see but which IS joined stays
// JoinObsInstalled (so the plan keeps Noop / NotFleetMember and never overwrites an operator identity), and an
// UNREADABLE status that is not 127 refuses -- it is not evidence of "not joined".
test fn w_install_requires_binary_absent_or_positive_not_joined() -> Bool {
  let unknown_tagged = tailscale_join_observation_of(
    package: DpkgPackageUnknown,
    status: StatusParsed { state: JoinStateJoinedWithRequiredTag { self_tags: ["tag:ci"] } },
  )
  let not_installed_notag = tailscale_join_observation_of(
    package: DpkgPackageNotInstalled { status: "" },
    status: StatusParsed { state: JoinStateJoinedWithoutRequiredTag { self_tags: [] } },
  )
  let unknown_binary_absent = tailscale_join_observation_of(
    package: DpkgPackageUnknown,
    status: StatusBinaryAbsent,
  )
  let not_installed_not_joined = tailscale_join_observation_of(
    package: DpkgPackageNotInstalled { status: "deinstall ok config-files" },
    status: StatusParsed { state: JoinStateNotJoined { state: "BackendState: NeedsLogin" } },
  )
  // THE REGRESSION opus caught (review 96846). A non-apt tailscale (static/snap/purged record) that dpkg cannot
  // see, whose parsed status is a NOT-JOINED whose BackendState string is "NeedsMachineAuth". The builder still
  // classifies it install-eligible (a parsed not-joined => JoinObsInstall), but it MUST carry the observed string,
  // because a host running tailscale in NeedsMachineAuth must REFUSE at the plan's key guard -- installing the apt
  // package over a running tailscale and force-reauthing it with the fleet key is the exact harm the guard exists
  // to stop. Pre-fix JoinObsInstall dropped the string, the plan passed Absent, and the guard's `Absent => false`
  // was a fabricated default for a status that WAS read -- so this host re-joined. Now: obs_is_install is true
  // (the builder's classification is unchanged) AND plan_refused is true (the guard now sees the carried string).
  let needs_machine_auth_on_hidden_tailscale = tailscale_join_observation_of(
    package: DpkgPackageUnknown,
    status: StatusParsed { state: JoinStateNotJoined { state: "NeedsMachineAuth" } },
  )
  let unknown_unreadable = tailscale_join_observation_of(
    package: DpkgPackageUnknown,
    status: StatusUnreadable { cause: "status leg exit=1 (daemon unreachable)" },
  )
  let not_installed_unreadable = tailscale_join_observation_of(
    package: DpkgPackageNotInstalled { status: "" },
    status: StatusUnreadable { cause: "status leg refused" },
  )
  let broken = tailscale_join_observation_of(
    package: DpkgQueryUndecidable { reason: "dpkg itself failed" },
    status: StatusParsed { state: JoinStateNotJoined { state: "ignored" } },
  )
  obs_is_installed(unknown_tagged)
    && obs_is_installed(not_installed_notag)
    && obs_is_install(unknown_binary_absent)
    && obs_is_install(not_installed_not_joined)
    && obs_is_refused(unknown_unreadable)
    && obs_is_refused(not_installed_unreadable)
    && obs_is_refused(broken)
    // review 96846 regression guard. The builder still classifies the NeedsMachineAuth host install-eligible
    // (obs_is_install true), but the PLAN must REFUSE it -- JoinObsInstall now carries the observed string so the
    // key guard's NeedsMachineAuth arm fires instead of the fabricated `Absent => false`.
    && obs_is_install(
      needs_machine_auth_on_hidden_tailscale
    )
    && plan_refused(
      tailscale_join_plan(
        host: operator_host_srv1,
        observation: needs_machine_auth_on_hidden_tailscale,
        key_usable: true,
      )
    )
}

// ──────────────────────────────────────────────────────────────────────────────────────────────────────
// THE THREE STATES, ONE DOCUMENT EACH.
// ──────────────────────────────────────────────────────────────────────────────────────────────────────

// JOINED AS A FLEET MEMBER: Running AND `Self.Tags` carries tag:ci. The only state a converge may call
// converged -- and it is REACHED from the document, not assumed from the backend state.
test fn w_fleet_member_fixture_reads_as_a_fleet_member() -> Bool {
  let text = fixture_text(path: fleet_member_fixture_path)
  match state_of(fixture: fleet_member_fixture_path) {
    JoinStateJoinedWithRequiredTag { self_tags: tags } =>
      string_contains(s: text, pattern: "\"BackendState\": \"Running\"")
        && tags.count() == 2
        && tailscale_up_join_state_is_joined(state: JoinStateJoinedWithRequiredTag { self_tags: tags })
    JoinStateJoinedWithoutRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// JOINED WITH BOTH TAGS IS STILL A FLEET MEMBER -- the operator's ruling of 2026-11-18 ("C both tags is fine";
// operator, in chat to smart-crane-730). ken and dan (h11-a16) carry tag:ci AND tag:serving, and the converge
// (#16685's JoinStateJoinedWithRequiredTag, decided by tailscale_self_tags_include on the REQUIRED tag) must
// read them as fleet members, not as some other identity. Witnessed from the document, not assumed.
test fn w_a_node_carrying_both_ci_and_serving_is_read_as_a_fleet_member() -> Bool {
  match state_of(fixture: ci_and_serving_fixture_path) {
    JoinStateJoinedWithRequiredTag { self_tags: tags } =>
      tags.count() == 2
        && tailscale_self_tags_include(tags: tags, tag: tailscale_fleet_node_tag)
        && tailscale_self_tags_include(tags: tags, tag: ("tag:serving" as NonEmptyStr))
    JoinStateJoinedWithoutRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// SERVING ALONE IS NOT MEMBERSHIP. The fleet tag, not the mere presence of ANY tag, gates the converge. This is
// the committed RED CONTROL for the arm above: if JoinStateJoinedWithRequiredTag's check were loosened to "any
// tag present", the serving-only node would land in the WithRequiredTag arm -- which returns false here -- and
// this witness goes red. Only tag:ci reaches the fleet.
test fn w_a_node_carrying_only_serving_is_not_yet_a_fleet_member() -> Bool {
  match state_of(fixture: serving_only_fixture_path) {
    JoinStateJoinedWithoutRequiredTag { self_tags: tags } =>
      tailscale_self_tags_include(tags: tags, tag: ("tag:serving" as NonEmptyStr))
        && !tailscale_self_tags_include(tags: tags, tag: tailscale_fleet_node_tag)
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// THE DESIRED TAG SET IS THE FLEET KEY'S ci PLUS A ROLE-DERIVED serving. A both_participation host (#16602's
// ken, and dan) is desired to carry BOTH tags -- ci so the converge reaches it, serving because its role is
// inference serving. The set is DERIVED from the participation column of the enrollment row, not a hand-kept
// per-host table (#16685 deleted such a table twice).
test fn w_a_both_participation_host_is_desired_to_carry_ci_and_serving() -> Bool {
  tailscale_desired_tags_for_participation(participation: both_participation_enrollment_participation)
    == [tailscale_fleet_node_tag, tag_serving]
}

// SERVING IS ROLE-GATED, NOT STAMPED ON EVERYONE. The committed RED CONTROL for the derivation above: a
// ci-only role (a ci-runner server or a hetzner guest) is desired to carry ONLY the fleet key's ci tag. Were
// serving stamped on every fleet host, this list would grow a second element and the equality would fail.
test fn w_a_ci_only_host_is_desired_to_carry_ci_and_not_serving() -> Bool {
  tailscale_desired_tags_for_participation(participation: ci_runner_enrollment_participation)
    == [tailscale_fleet_node_tag]
}

// JOINED, BUT NOT A FLEET MEMBER -- the ken specimen. Running, resolvable, and `Self.Tags` ABSENT, which is how
// upstream's `omitempty` spells a node with no tags. Note the last conjunct, which names the fail-open:
// `tailscale_up_join_state_is_joined` still answers true here, because that question ("does the daemon report a
// member at all?") is not the question membership is decided on. A Noop keyed on the old two-valued state was
// answering THAT question, and this is why.
test fn w_hand_joined_specimen_reads_as_joined_but_not_a_fleet_member() -> Bool {
  match state_of(fixture: hand_joined_fixture_path) {
    // No `backend == "Running"` conjunct here: the arm IS that fact. Restating it would test the type
    // rather than the reading (#gunbc.design_argument::fail_closed: making the wrong state unwritable is
    // stronger than catching it).
    JoinStateJoinedWithoutRequiredTag { self_tags: tags } =>
      tags.count() == 0
        && tailscale_up_join_state_is_joined(state: JoinStateJoinedWithoutRequiredTag { self_tags: tags })
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// THE TAG IS THE FLEET'S TAG, NOT "ANY TAG". A node carrying tag:dashboard is another role's member. Without
// this witness the check could silently degrade to "`Self.Tags` is non-empty" and stay green.
test fn w_a_foreign_tag_is_not_the_fleet_tag() -> Bool {
  match state_of(fixture: foreign_tag_fixture_path) {
    JoinStateJoinedWithoutRequiredTag { self_tags: tags } =>
      tags.count() == 1 && tags.any(tag => tag == "tag:dashboard")
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// NOT JOINED STAYS NOT JOINED. NeedsLogin and no `Self` at all: the widening must not turn a logged-out node into
// a membership question, because there is no identity to ask about.
test fn w_not_joined_fixture_reads_as_not_joined() -> Bool {
  match state_of(fixture: not_joined_fixture_path) {
    JoinStateNotJoined { state: backend } =>
      backend == "NeedsLogin"
        && !tailscale_up_join_state_is_joined(state: JoinStateNotJoined { state: backend })
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateJoinedWithoutRequiredTag { self_tags: _ } => false
    JoinStateUnreadable { cause: _ } => false
  }
}

// A DOCUMENT THAT CANNOT ANSWER IS NOT THE TAGLESS ANSWER. Running with no `Self`: membership cannot be decided,
// so this refuses rather than reading as "joined, no tags" -- which would route it into the very arm this change
// adds, on evidence the document does not give. Fail-closed means the failure arm refuses; it does not widen into
// whichever arm is nearest (#gunbc.design_argument::fail_closed).
test fn w_running_without_self_refuses_rather_than_reading_tagless() -> Bool {
  match state_of(fixture: running_without_self_fixture_path) {
    JoinStateUnreadable { cause: cause } => cause != ""
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateJoinedWithoutRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
  }
}

// THE SAME DISCIPLINE FOR A MALFORMED TAGS MEMBER: `Tags` present but not a list is a document to refuse on, not
// one to read as untagged.
test fn w_a_tags_member_that_is_not_a_list_refuses() -> Bool {
  match tailscale_up_join_state_of(
    status_json: tags_member_not_a_list_document,
    required_tag: tailscale_fleet_node_tag,
  ) {
    JoinStateUnreadable { cause: cause } => cause != ""
    JoinStateJoinedWithRequiredTag { self_tags: _ } => false
    JoinStateJoinedWithoutRequiredTag { self_tags: _ } => false
    JoinStateNotJoined { state: _ } => false
  }
}

// THE FIXTURE HOLDS ITSELF TO ITS OWN MEANING: the specimen document says it is Running and carries NO `Tags`
// member. If it is ever re-tagged, the witnesses above stop being about a hand-joined node, and this says so.
test fn w_the_hand_joined_fixture_really_carries_no_tag_member() -> Bool {
  let text = fixture_text(path: hand_joined_fixture_path)
  text != ""
    && string_contains(s: text, pattern: "\"BackendState\": \"Running\"")
    && !string_contains(s: text, pattern: "Tags")
}

// ──────────────────────────────────────────────────────────────────────────────────────────────────────
// THE PLAN: Noop IS ONLY FOR A FLEET MEMBER.
// ──────────────────────────────────────────────────────────────────────────────────────────────────────

// A FLEET MEMBER STILL NOOPS, AND STILL WITHOUT CONSULTING THE KEY. srv1 and srv2 are recorded as carrying
// tag:ci (gunbc.tailscale_fleet_auth_key, the note on why tag:ci was chosen), so their routine converge keeps the
// behavior it had. The key is declared UNUSABLE here on purpose: if the Noop stopped being first, this goes red.
test fn w_a_fleet_member_still_noops_without_reading_the_key() -> Bool {
  match plan_for(document: fixture_text(path: fleet_member_fixture_path), key_usable: false) {
    JoinPlanNoop { host: host, tailnet_name: _, reason: reason } =>
      host == operator_host_srv1 && string_contains(s: reason, pattern: "fleet tag")
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
    JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
  }
}

// THE FIX ITSELF: the specimen's document, on an enrolled host, is a TYPED REFUSAL -- not a Noop, not a re-join,
// and not the generic `JoinPlanRefused` string bucket, which is where an input the converge could go and get
// belongs. This is a state of the world the converge has no authority over, and it names the tag and what the
// node presented instead.
test fn w_the_specimen_refuses_typed_rather_than_noopping() -> Bool {
  match plan_for(document: fixture_text(path: hand_joined_fixture_path), key_usable: true) {
    JoinPlanNotFleetMember { host: host, tailnet_name: _, required_tag: required, observed_tags: observed } =>
      host == operator_host_srv1 && required == tailscale_fleet_node_tag && observed.count() == 0
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
  }
}

// NO OTHER JOINED STATE REACHES Noop EITHER: the foreign-tag document refuses as a non-member, the logged-out
// document still reaches the join arm, and the unreadable document still refuses. One claim because it is ONE
// property: among the join states, Noop has exactly one qualifier.
test fn w_noop_has_exactly_one_join_state_that_qualifies() -> Bool {
  match plan_for(document: fixture_text(path: foreign_tag_fixture_path), key_usable: true) {
    JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: required, observed_tags: observed } =>
      required == tailscale_fleet_node_tag
        && observed.count() == 1
        && match plan_for(document: fixture_text(path: not_joined_fixture_path), key_usable: true) {
          JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => true
          JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
          JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
          JoinPlanRefused { host: _, cause: _ } => false
        }
        && match plan_for(document: fixture_text(path: running_without_self_fixture_path), key_usable: true) {
          JoinPlanRefused { host: _, cause: cause } => cause != ""
          JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
          JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
          JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
        }
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
  }
}

// THE OUTCOME CANNOT SETTLE THE JOB, AND THE RECEIPT SAYS WHAT THE OPERATOR MUST DO. The outcome is built from
// the plan arm itself, so the fields the operator reads are the ones the refusal carried: the tag the policy keys
// on, that the node presents NOTHING, that the key was never used, and the remedy as an operator act. A
// `JoinConvergedNoop` line -- what the old code printed for this host -- is what the last two conjuncts refuse to
// let this receipt ever say.
test fn w_the_refusal_outcome_never_settles_and_says_what_to_do() -> Bool {
  match plan_for(document: fixture_text(path: hand_joined_fixture_path), key_usable: true) {
    JoinPlanNotFleetMember { host: host, tailnet_name: tailnet_name, required_tag: required, observed_tags: observed } => {
      let outcome = JoinRefusedNotFleetMember {
        host: host,
        tailnet_name: tailnet_name,
        required_tag: required,
        observed_tags: observed,
      }
      let line = tailscale_join_outcome_receipt(outcome: outcome)
      !tailscale_join_run_settled(outcome: outcome)
        && string_contains(s: line, pattern: "outcome=refused_not_fleet_member")
        && string_contains(s: line, pattern: "fleet_tag=tag:ci")
        && string_contains(s: line, pattern: "presents_tags=none")
        && string_contains(s: line, pattern: "key=never_used")
        && string_contains(s: line, pattern: "force-reauth")
        && string_contains(s: line, pattern: "never re-authenticates")
        && !string_contains(s: line, pattern: "outcome=noop")
        && !string_contains(s: line, pattern: "outcome=converged")
    }
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
  }
}

// THE WORD FOR WHAT THE NODE PRESENTS. `none` and a list are different facts to whoever acts on the receipt -- a
// node carrying no tags is the hand-joined case, a node carrying another role's tag is a different problem -- and
// an empty list printed as nothing is how a log line stops telling them apart.
test fn w_the_observed_tags_word_distinguishes_none_from_a_list() -> Bool {
  tailscale_join_observed_tags_word(tags: []) == "none"
    && tailscale_join_observed_tags_word(tags: ["tag:ci"]) == "tag:ci"
    && tailscale_join_observed_tags_word(tags: ["tag:ci", "tag:dashboard"]) == "tag:ci,tag:dashboard"
}

// THE OTHER ARMS ARE UNHURT. A not-joined host with a usable key still plans the place-and-join; with no usable
// key it still refuses ON THE KEY, not on the tag. The widening added an arm; it did not move the others, and
// the two refusals stay different facts.
test fn w_the_join_and_key_refusal_arms_are_unchanged() -> Bool {
  let document = fixture_text(path: not_joined_fixture_path)
  match plan_for(document: document, key_usable: true) {
    JoinPlanPlaceAndJoin { host: host, tailnet_name: _, hostname: _, package_action: _ } =>
      host == operator_host_srv1
        && match plan_for(document: document, key_usable: false) {
          JoinPlanRefused { host: _, cause: cause } => string_contains(s: cause, pattern: "key")
          JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
          JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
          JoinPlanPlaceAndJoin { host: _, tailnet_name: _, hostname: _, package_action: _ } => false
        }
    JoinPlanNoop { host: _, tailnet_name: _, reason: _ } => false
    JoinPlanNotFleetMember { host: _, tailnet_name: _, required_tag: _, observed_tags: _ } => false
    JoinPlanRefused { host: _, cause: _ } => false
  }
}

// The honest-consumption classification (design_argument::consumption) for the role-derived desired-tag
// functions: a well-formed frontier naming the later device-tags route as their consumer -- classified, not
// dangling. This consumes gunbc.tailscale_fleet_auth_key::tailscale_fleet_auth_key_later_consumer_frontier_rows
// so the classification is itself reached, exactly as gunbc.arm_ci_seller_census's frontier is consumed.
test fn w_a_the_desired_tag_derivation_is_classified_as_a_named_later_consumer_not_dangling() -> Bool {
  let rows = tailscale_fleet_auth_key_later_consumer_frontier_rows
  frontier_rows_well_formed(rows: rows) && (length(rows) == 2)
}

// ---------------------------------------------------------------------------
// THE tailscale APT REPOSITORY ROUTE (PR #16779): the keyring Guard is now a PURE fold over gpg's machine
// output, so its security property is witnessed without a host, a shell, or a subprocess. A wrong key must
// refuse; a two-key listing that carries the pin must refuse (the multi-key bypass); the plan must be the ten
// ordered steps; the source line must be apt-shaped. A happy-path live srv3/srv4 run can only ever show the key
// MATCHING, so the security property -- a key whose fingerprint differs from the row's, or that smuggles a
// second key beside it, refuses before the keyring is ever trusted -- lives only in these pure claims.
// ---------------------------------------------------------------------------

// A gpg `--show-keys --with-colons` sample carrying ONE primary-key `pub` record followed by its `fpr` field
// (field index 9, the fingerprint of the listing format) and a `uid`. This is the colon text the pure guard
// reads; the shape mirrors gpg's machine output (gpg(1), MACHINE-PARSABLE LISTING).
fn gpg_colons_with_fingerprint(fp: String) -> String {
  join(
    [
      "pub:-:4096:1:0B4423A0D19062A6D4E4F5D2C1B0A9E8F7D6C5B4:1700000000:::::::::::\n",
      "fpr:::::::::",
      fp,
      ":\n",
      "uid:-::::::::Tailscale <pkg@tailscale.com>:::::::\n",
    ],
    "",
  )
}

// A two-KEY gpg --with-colons sample: TWO `pub` records, the FIRST carrying `first_fp`. This is the fail-open
// case -- a fetched file holding the genuine key PLUS a second key. A substring grep would wave it through and
// signed-by would trust both; the guard's exactly-one-pub count is what refuses it.
fn gpg_colons_two_keys_containing(first_fp: String, second_fp: String) -> String {
  join(
    [
      "pub:-:4096:1:0B4423A0D19062A6D4E4F5D2C1B0A9E8F7D6C5B4:1700000000:::::::::::\n",
      "fpr:::::::::",
      first_fp,
      ":\n",
      "uid:-::::::::Tailscale <pkg@tailscale.com>:::::::\n",
      "pub:-:4096:1:11AA22BB33CC44DD55EE66FF77889900AABBCCDD:1700000000:::::::::::\n",
      "fpr:::::::::",
      second_fp,
      ":\n",
    ],
    "",
  )
}

// (a) THE PURE FOLD RED CONTROL, on fixture colon text -- no shell, no host, no subprocess. The fold accepts a
// single-key listing whose `fpr` equals the row's pinned fingerprint, and refuses a single-key listing whose
// fingerprint differs. An accepted wrong pin would be written as `signed-by=`, i.e. trusted.
test fn w_a_wrong_key_fingerprint_refuses_the_repo_route() -> Bool {
  let pinned = tailscale_apt_repo_noble(arch: "amd64").keyring_fingerprint
  apt_third_party_keyring_colons_are_pinned(
    colons: gpg_colons_with_fingerprint(fp: pinned.value as String),
    pinned: pinned,
  )
    && !apt_third_party_keyring_colons_are_pinned(
      colons: gpg_colons_with_fingerprint(fp: "1111111111111111111111111111111111111111"),
      pinned: pinned,
    )
}

// (b) THE SOURCE LINE for the tailscale row is exactly the apt shape every vendor documents: signed-by at the
// pinned keyring path, the ARCH FROM THE INPUT (proving arch is the host's, not a pinned constant), the noble
// suite, the main component, the published repo base.
test fn w_tailscale_repo_source_line_is_apt_shaped() -> Bool {
  apt_third_party_repo_source_line(repo: tailscale_apt_repo_noble(arch: "arm64"))
    == "deb [arch=arm64 signed-by=/etc/apt/keyrings/tailscale.gpg] https://pkgs.tailscale.com/stable/ubuntu noble main"
}

// (b2) THE TWO-KEY PURE RED CONTROL. A listing that carries the pinned fingerprint AND a second `pub` key must
// FAIL the fold -- it is not the single genuine key. This is the exact fail-open a substring grep would wave
// through, letting signed-by= trust both keys; the exactly-one-pub count is why it refuses even though the pin
// is present.
test fn w_b_two_key_output_containing_the_pin_refuses() -> Bool {
  let pinned = tailscale_apt_repo_noble(arch: "amd64").keyring_fingerprint
  !apt_third_party_keyring_colons_are_pinned(
    colons: gpg_colons_two_keys_containing(
      first_fp: pinned.value as String,
      second_fp: "2222222222222222222222222222222222222222",
    ),
    pinned: pinned,
  )
}

// (c) THE STEP-ORDER WITNESS. The plan apt.dag publishes is the ten steps in the order the security property
// depends on: keyrings dir, private staging dir, fetch, show-keys, the keyring GUARD (before any dearmor --
// verify before trust), dearmor, the signed-by source line, apt update, install, then the staging cleanup last.
// If the plan is ever reordered the walker runs the wrong sequence, and this goes red.
test fn w_the_apt_repo_install_plan_has_the_ten_step_order() -> Bool {
  join(
    map(
      apt_third_party_repo_install_plan(repo: tailscale_apt_repo_noble(arch: "amd64"), packages: tailscale_packages),
      fn(step) { apt_repo_install_step_kind_name(step: step) },
    ),
    ",",
  )
    == "KeyringDir,Mktemp,Fetch,ShowKeys,Guard,Dearmor,SourceLine,Update,Install,Cleanup"
}

// (d) THE READ-BACK PONG NAMED BY THE NODE LABEL. The srv4 join dispatch (fleet-converge run
// 44757742976, 2026-11-20) installed tailscale through the shared apt walker and ran `tailscale up`, then
// REFUSED at the read-back: "the pong named srv4, not srv4.tailecbe08.ts.net". The cause: `tailscale ping
// <fqdn>` names the answering peer by its NODE LABEL ("srv4"), while the expected name is the MagicDNS FQDN;
// string-equal, they never match, so a join that had in fact settled was refused. The fixture is that run's
// pong -- the node name "srv4" is the observed fact; the address and route behind it never enter the
// comparison -- transcribed here so a regression in the read-back goes red on the real bytes, not a guess.
test fn w_the_srv4_pong_from_the_dispatch_settles_a_correct_join() -> Bool {
  let srv4_pong = "pong from srv4 (100.120.40.7) via <derp-7> in 18ms"
  match tailnet_host_from(machine: operator_host_srv4) {
    Present { value: expected_fqdn } =>
      match tailscale_ping_verdict(exit_code: 0, stdout: srv4_pong, stderr: "") {
        PingAnswered { node_name: node_name, line: _ } =>
          // The pong names srv4, and the read-back compares that node label to the model's first label
          // (the canonical name ahead of the zone labels), so the correct join settles.
          node_name == "srv4"
            && tailscale_ping_pong_is_expected(expected: expected_fqdn, node_name: node_name)
        _ => false
      }
    _ => false
  }
}

// THE READ-BACK STILL FAILS CLOSED ON A WRONG NAME. The fix must not turn "compare like with like" into
// "trust whoever answered": a pong naming a different node -- an address answering from a stale peer record
// as somebody else -- is still refused. This is the guard the fix had to preserve; it goes red if the
// comparison is loosened to "any pong at all".
test fn w_a_pong_from_a_different_node_still_refuses_the_read_back() -> Bool {
  let wrong_pong = "pong from srv3 (100.120.40.3) via <derp-7> in 21ms"
  match tailnet_host_from(machine: operator_host_srv4) {
    Present { value: expected_fqdn } =>
      match tailscale_ping_verdict(exit_code: 0, stdout: wrong_pong, stderr: "") {
        PingAnswered { node_name: node_name, line: _ } =>
          node_name == "srv3"
            && !tailscale_ping_pong_is_expected(expected: expected_fqdn, node_name: node_name)
        _ => false
      }
    _ => false
  }
}

// THE HOST-SIDE TAILSCALE-SSH HALF IS OFF, AND THE JOIN CANNOT TURN IT ON. The operator recorded
// per-host on 2026-11-20: Tailscale SSH is OFF on srv1, and srv3/srv4 terminate SSH connections with
// plain OpenSSH (the gunbc-build forced-command account and its closed client-key list,
// gunbc.compute.remote_build::remote_build_authorized_entry). That recorded state matches what the
// fleet join guarantees BY CONSTRUCTION -- tailscale_up_join_argv (extdeps.tailscale.join) carries no
// --ssh flag, so the host-side half of Tailscale SSH is never enabled at join. This claim is the
// discriminating input behind that sentence: if a --ssh flag ever enters the join argv, hosts would
// come up answering ssh on tailscale-ssh instead of sshd-with-forced-command, and the ci-dispatch ->
// tag:ci tcp:22 grant (extdeps.tailscale.acl) would reach a different server than the forced-command
// key controls -- THIS claim goes red.
test fn w_the_fleet_join_argv_never_enables_tailscale_ssh() -> Bool {
  match canonical_hostname_for_fleet_slot(fleet_slot: operator_host_srv1) {
    Present { value: name } =>
      match tailscale_join_up_command(hostname: name) {
        TailscaleUpJoinCommandBuilt { command: command } =>
          !list_member(
            xs: argv_words(command: command),
            x: "--ssh",
            eq: (a, b) => a == b
          )
        TailscaleUpJoinCommandRefused { cause: _ } => false
      }
    Absent => false
  }
}
