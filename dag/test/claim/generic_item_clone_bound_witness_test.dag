}

fn w_both_triggers_render_one_bound() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.both_triggers\nimport std.algebra { FreeMonoid }\n\ntype Boxed<T> {\n  inner: T\n}\n\ntype BothTriggers<T> {\n  boxed: Boxed<T>\n  bare: T\n  listed: FreeMonoid<T>\n}\n",
    "src/generic_item_witness_both_triggers.rs",
    ["struct BothTriggers<T: Clone>"],
    ["struct BothTriggers<T: Clone, T: Clone>", "struct BothTriggers<T: Clone + Clone>", "struct BothTriggers<T>"]
  )
}

