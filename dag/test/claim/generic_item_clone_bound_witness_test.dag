module test.claim.generic_item_clone_bound_witness

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data generic_item_clone_bound_witness_note: String = "Executing floor witness for v1.compiler.trait_derive_emit item-level Clone bounds. compile_dag_rust_emit_check is the per-PR enrolled consumer here; it compiles inline fixtures and asserts emitted Rust spellings. Per-PR rustc evidence is the build job cargo-checking the whole stage0 crate (generated std modules compile only when bounds are correct). TWO INDEPENDENT TRIGGERS, and the negative controls below are what keep them from collapsing into one widening rule. DERIVE trigger (structs only): bound P when P is a bare field type or a container/FreeMonoid element; enum items keep bare params, because derive emits per-impl bounds. WELL-FORMEDNESS trigger (structs AND enums): naming a declared generic type G<A..> requires satisfying G's own declared bounds, so if G's i-th parameter already carries `: Clone` and the i-th argument's Clone impl needs P, the declaring item is ill-formed without P: Clone -- rustc E0277 at the field, before any derive is considered. The second trigger is a LEAST FIXPOINT over the declared-type graph, so it propagates along a chain and saturates on a recursive type. Unused phantom-only params stay bare under both triggers."

fn w_containment_path_emits_clone_bound() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.fixture\nimport std.algebra { FreeMonoid }\n\ntype ContainmentPath<N> {\n  ancestors: FreeMonoid<N>\n  terminal: N\n}\n",
    "src/generic_item_witness_fixture.rs",
    ["struct ContainmentPath<N: Clone>"],
    []
  )
}

fn w_unused_param_no_spurious_clone_bound() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.holder\n\ntype Holder<N> {\n  tag: Int\n}\n",
    "src/generic_item_witness_holder.rs",
    ["struct Holder<N>"],
    ["struct Holder<N: Clone>"]
  )
}

fn w_bound_propagates_through_declared_generic_type() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.propagate\nimport std.algebra { FreeMonoid }\n\ntype ContainmentPath<N> {\n  ancestors: FreeMonoid<N>\n  terminal: N\n}\n\ntype BindingOccurrence<N> {\n  containment: ContainmentPath<N>\n}\n\ntype BindingCandidate<N> {\n  occurrence: BindingOccurrence<N>\n}\n\ntype CandidateRows<N> {\n  rows: FreeMonoid<BindingOccurrence<N>>\n}\n",
    "src/generic_item_witness_propagate.rs",
    [
      "struct ContainmentPath<N: Clone>",
      "struct BindingOccurrence<N: Clone>",
      "struct BindingCandidate<N: Clone>",
      "struct CandidateRows<N: Clone>"
    ],
    [
      "struct BindingOccurrence<N>",
      "struct BindingCandidate<N>",
      "struct CandidateRows<N>"
    ]
  )
}

fn w_bound_propagates_into_coproduct_item() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.coproduct\nimport std.algebra { FreeMonoid }\n\ntype ContainmentPath<N> {\n  ancestors: FreeMonoid<N>\n  terminal: N\n}\n\ntype OccurrenceBinding<N>\n  = BoundTo { path: ContainmentPath<N> }\n  | Unbound { reason: String }\n",
    "src/generic_item_witness_coproduct.rs",
    ["enum OccurrenceBinding<N: Clone>"],
    ["enum OccurrenceBinding<N>"]
  )
}

fn w_coproduct_bare_payload_param_stays_bare() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.coproduct_bare\n\ntype PlainChoice<N>\n  = Payload { value: N }\n  | Nothing { reason: String }\n",
    "src/generic_item_witness_coproduct_bare.rs",
    ["enum PlainChoice<N>"],
    ["enum PlainChoice<N: Clone>"]
  )
}

fn w_unbounded_declared_generic_type_propagates_nothing() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.no_propagate\n\ntype Holder<N> {\n  tag: Int\n}\n\ntype UsesHolder<N> {\n  held: Holder<N>\n}\n",
    "src/generic_item_witness_no_propagate.rs",
    ["struct UsesHolder<N>"],
    ["struct UsesHolder<N: Clone>"]
  )
}

fn w_recursive_declared_type_saturates() -> Bool {
  compile_dag_rust_emit_check(
    "module generic_item_witness.recursive\nimport std.algebra { FreeMonoid }\n\ntype ContainmentPath<N> {\n  ancestors: FreeMonoid<N>\n  terminal: N\n}\n\ntype Spine<N> {\n  parent: Spine<N>?\n  path: ContainmentPath<N>\n}\n",
    "src/generic_item_witness_recursive.rs",
    ["struct Spine<N: Clone>"],
    ["struct Spine<N>"]
  )
}

test fn containment_path_clone_bound_positive() -> Bool {
  w_containment_path_emits_clone_bound()
}

test fn unused_generic_param_negative_control() -> Bool {
  w_unused_param_no_spurious_clone_bound()
}

test fn declared_generic_type_propagation_positive() -> Bool {
  w_bound_propagates_through_declared_generic_type()
}

test fn coproduct_well_formedness_propagation_positive() -> Bool {
  w_bound_propagates_into_coproduct_item()
}

test fn coproduct_bare_payload_negative_control() -> Bool {
  w_coproduct_bare_payload_param_stays_bare()
}

test fn unbounded_declared_generic_negative_control() -> Bool {
  w_unbounded_declared_generic_type_propagates_nothing()
}

test fn recursive_declared_type_saturation_positive() -> Bool {
  w_recursive_declared_type_saturates()
}
