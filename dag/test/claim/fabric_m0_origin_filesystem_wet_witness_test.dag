module test.claim.fabric_m0_origin_filesystem_wet_witness_test

import extdeps.shell
import extdeps.crypto.hash
import std.types { Bool, FilePath, List, NonEmptyStr, String }
import std.algebra { trim }
import std.content_hash { Sha256Digest, sha256_hex_digest }
import extdeps.crypto.hash { sha256sum_line_digest }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.fabric_m0_origin_readback {
  OriginPutOutcome, OriginObjectStored, OriginObjectAlreadyPresent, OriginPutRefused, OriginPutOutcomeUnknown,
  OriginFetchOutcome, OriginObjectStaged, OriginObjectAbsent, OriginFetchUnavailable,
}
import gunbc.fabric_m0_completion {
  ObligationVerdict, ObligationSatisfied, ObligationUnsatisfied, ObligationUndetermined, ObligationUnenumerable,
  origin_readback_of_fetch, readback_digest_verdict,
}
import gunbc.fabric_m0_origin_filesystem {
  FilesystemOriginRoot, content_addressed_origin_key, put_filesystem_origin_object, fetch_filesystem_origin_object,
}

// WET CONTROLS FOR THE FILESYSTEM ORIGIN, against a real throwaway root. Each test makes its own
// /tmp/gunbc_fsorigin.* directory, establishes (or deliberately fails to establish) objects/, sha256/
// and staging/ the way host convergence would, drives the real put and fetch - test, mktemp, cp, sync,
// ln, rm, listings and sha256sum - and removes the root. Verdicts are taken through
// gunbc.fabric_m0_completion readback_digest_verdict, the judgement the completion authority applies to
// an R2 origin. What these cannot drive is an fsync failure on a real directory; that arm is shown by
// the hermetic witness, over the same decision function the realization calls.

fn verdict_arm(v: ObligationVerdict) -> String {
  match v {
    ObligationSatisfied => "satisfied"
    ObligationUnsatisfied { subject: _, cause: _ } => "unsatisfied"
    ObligationUndetermined { subject: _, cause: _ } => "undetermined"
    ObligationUnenumerable { subject: _, cause: _ } => "unenumerable"
  }
}

fn put_arm(p: OriginPutOutcome) -> String {
  match p {
    OriginObjectStored { key: _ } => "stored"
    OriginObjectAlreadyPresent { key: _ } => "already_present"
    OriginPutRefused { key: _, cause: _ } => "refused"
    OriginPutOutcomeUnknown { key: _, cause: _ } => "unknown"
  }
}

fn fetch_arm(f: OriginFetchOutcome) -> String {
  match f {
    OriginObjectStaged { key: _, reading: _ } => "staged"
    OriginObjectAbsent { key: _ } => "absent"
    OriginFetchUnavailable { key: _, cause: _ } => "unavailable"
  }
}

fn mkdirs(paths: List<String>) -> Bool {
  all(paths, p => shell.Mkdir.Parents(path: p as FilePath).success)
}

fn new_base() -> String {
  trim(shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc_fsorigin.XXXXXX").path as String)
}

// A converged root: objects/, objects/sha256/ and staging/ all established.
fn converged_root() -> String {
  let base = new_base()
  if mkdirs(paths: [join([base, "/root/objects/sha256"], ""), join([base, "/root/staging"], "")]) { base } else { "" }
}

fn root_of(base: String) -> FilesystemOriginRoot {
  FilesystemOriginRoot { root: join([base, "/root"], "") as FilePath }
}

fn local_file(base: String, name: String, content: String) -> FilePath {
  let path = join([base, "/", name], "")
  let w = Filesystem.Write(path: path, content: content)
  path as FilePath
}

fn digest_of(path: FilePath) -> Sha256Digest? {
  let observed = crypto.Sha256Sum.File(path: path as String)
  match sha256sum_line_digest(line: observed.line) {
    Absent => Absent
    Present { value: d } => sha256_hex_digest(hex: d.hex as String)
  }
}

fn lists(directory: String, name: String) -> Bool {
  let l = Filesystem.List(path: directory)
  l.success && string_contains(s: concat("\n", concat(l.entries, "\n")), pattern: concat("\n", concat(name, "\n")))
}

test fn a_content_addressed_put_reads_back_to_its_own_digest_by_real_execution() -> Bool {
  let base = converged_root()
  let local = local_file(base: base, name: "a.txt", content: "workflow bytes\n")
  let verdict = match digest_of(path: local) {
    Absent => false
    Present { value: d } => {
      let key = content_addressed_origin_key(digest: d)
      let put = put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: key)
      let fetched = fetch_filesystem_origin_object(root: root_of(base: base), key: key)
      put_arm(p: put) == "stored"
        && fetch_arm(f: fetched) == "staged"
        && verdict_arm(v: readback_digest_verdict(subject: key, recorded: d, readback: origin_readback_of_fetch(fetch: fetched))) == "satisfied"
    }
  }
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && verdict && removed.success
}

test fn the_same_bytes_twice_are_already_present_and_staging_is_left_empty_by_real_execution() -> Bool {
  let base = converged_root()
  let local = local_file(base: base, name: "a.txt", content: "workflow bytes\n")
  let verdict = match digest_of(path: local) {
    Absent => false
    Present { value: d } => {
      let key = content_addressed_origin_key(digest: d)
      let first = put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: key)
      let second = put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: key)
      put_arm(p: first) == "stored"
        && put_arm(p: second) == "already_present"
        && verdict_arm(v: readback_digest_verdict(subject: key, recorded: d, readback: origin_readback_of_fetch(fetch: fetch_filesystem_origin_object(root: root_of(base: base), key: key)))) == "satisfied"
    }
  }
  let staging = Filesystem.List(path: join([base, "/root/staging"], ""))
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && verdict && staging.success && trim(staging.entries) == "" && removed.success
}

test fn different_bytes_under_an_occupied_key_are_never_replaced_and_fail_the_verdict_by_real_execution() -> Bool {
  let base = converged_root()
  let original = local_file(base: base, name: "a.txt", content: "original bytes\n")
  let impostor = local_file(base: base, name: "b.txt", content: "different bytes\n")
  let verdict = match digest_of(path: original) {
    Absent => false
    Present { value: d } => match digest_of(path: impostor) {
      Absent => false
      Present { value: other } => {
        let key = content_addressed_origin_key(digest: d)
        let first = put_filesystem_origin_object(root: root_of(base: base), local_path: original, key: key)
        let second = put_filesystem_origin_object(root: root_of(base: base), local_path: impostor, key: key)
        let readback = origin_readback_of_fetch(fetch: fetch_filesystem_origin_object(root: root_of(base: base), key: key))
        put_arm(p: first) == "stored"
          && put_arm(p: second) == "already_present"
          && verdict_arm(v: readback_digest_verdict(subject: key, recorded: d, readback: readback)) == "satisfied"
          && verdict_arm(v: readback_digest_verdict(subject: key, recorded: other, readback: readback)) == "unsatisfied"
      }
    }
  }
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && verdict && removed.success
}

test fn a_key_absent_from_an_established_directory_is_absent_by_real_execution() -> Bool {
  let base = converged_root()
  let arm = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "sha256/0011223344556677889900112233445566778899001122334455667788990011" as NonEmptyStr))
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && arm == "absent" && removed.success
}

// Counterexample A: staging/ exists and objects/ does not. The put must refuse and must not found objects/.
test fn a_put_never_creates_the_objects_directory_by_real_execution() -> Bool {
  let base = new_base()
  let made = mkdirs(paths: [join([base, "/root/staging"], "")])
  let local = local_file(base: base, name: "a.txt", content: "bytes\n")
  let put = put_arm(p: put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: "sha256/abc" as NonEmptyStr))
  let fetch = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "sha256/abc" as NonEmptyStr))
  let founded = lists(directory: join([base, "/root"], ""), name: "objects")
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && made && put == "refused" && fetch == "unavailable" && !founded && removed.success
}

// A key directory convergence never established is unavailable, never absent, and is not created.
test fn a_key_directory_that_was_never_established_is_unavailable_and_not_created_by_real_execution() -> Bool {
  let base = converged_root()
  let local = local_file(base: base, name: "a.txt", content: "bytes\n")
  let put = put_arm(p: put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: "manifests/slot-1" as NonEmptyStr))
  let fetch = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "manifests/slot-1" as NonEmptyStr))
  let created = lists(directory: join([base, "/root/objects"], ""), name: "manifests")
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && put == "refused" && fetch == "unavailable" && !created && removed.success
}

// Counterexample C: an intermediate component that is a symbolic link to a directory outside the root.
test fn a_symbolically_linked_key_directory_is_refused_and_nothing_lands_outside_by_real_execution() -> Bool {
  let base = new_base()
  let made = mkdirs(paths: [join([base, "/root/objects"], ""), join([base, "/root/staging"], ""), join([base, "/outside"], "")])
  let linked = shell.Symlink.AtomicReplace(target: join([base, "/outside"], "") as FilePath, link: join([base, "/root/objects/sha256"], "") as FilePath).success
  let local = local_file(base: base, name: "a.txt", content: "bytes\n")
  let put = put_arm(p: put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: "sha256/abc" as NonEmptyStr))
  let fetch = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "sha256/abc" as NonEmptyStr))
  let leaked = lists(directory: join([base, "/outside"], ""), name: "abc")
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && made && linked && put == "refused" && fetch == "unavailable" && !leaked && removed.success
}

test fn a_key_that_escapes_lexically_is_refused_before_any_effect_by_real_execution() -> Bool {
  let base = converged_root()
  let local = local_file(base: base, name: "a.txt", content: "bytes\n")
  let put = put_arm(p: put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: "../outside" as NonEmptyStr))
  let fetch = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "../a.txt" as NonEmptyStr))
  let escaped = lists(directory: join([base, "/root"], ""), name: "outside")
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && put == "refused" && fetch == "unavailable" && !escaped && removed.success
}

// The origin root itself is a symbolic link to a converged tree elsewhere: nothing beneath it is used.
test fn an_origin_root_that_is_a_symbolic_link_is_refused_by_real_execution() -> Bool {
  let base = new_base()
  let made = mkdirs(paths: [join([base, "/real/objects/sha256"], ""), join([base, "/real/staging"], "")])
  let linked = shell.Symlink.AtomicReplace(target: join([base, "/real"], "") as FilePath, link: join([base, "/root"], "") as FilePath).success
  let local = local_file(base: base, name: "a.txt", content: "bytes\n")
  let put = put_arm(p: put_filesystem_origin_object(root: root_of(base: base), local_path: local, key: "sha256/abc" as NonEmptyStr))
  let fetch = fetch_arm(f: fetch_filesystem_origin_object(root: root_of(base: base), key: "sha256/abc" as NonEmptyStr))
  let landed = lists(directory: join([base, "/real/objects/sha256"], ""), name: "abc")
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && made && linked && put == "refused" && fetch == "unavailable" && !landed && removed.success
}

// The object leaf is a symbolic link to a file OUTSIDE the root that holds exactly the expected bytes.
// A fetch that followed it would mint a reading that satisfies the verdict; it must be unavailable.
test fn an_object_leaf_that_is_a_symbolic_link_is_never_staged_even_with_the_expected_bytes_by_real_execution() -> Bool {
  let base = converged_root()
  let outside = local_file(base: base, name: "outside.txt", content: "workflow bytes\n")
  let verdict = match digest_of(path: outside) {
    Absent => false
    Present { value: d } => {
      let key = content_addressed_origin_key(digest: d)
      let linked = shell.Symlink.AtomicReplace(target: outside, link: join([base, "/root/objects/", key as String], "") as FilePath).success
      let fetched = fetch_filesystem_origin_object(root: root_of(base: base), key: key)
      linked && fetch_arm(f: fetched) == "unavailable"
        && verdict_arm(v: readback_digest_verdict(subject: key, recorded: d, readback: origin_readback_of_fetch(fetch: fetched))) == "undetermined"
    }
  }
  let removed = shell.Remove.RecursiveForce(path: base)
  base != "" && verdict && removed.success
}
