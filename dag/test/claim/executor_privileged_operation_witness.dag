data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE HOST'S SUDOERS FILE IS REACHED THE WAY EVERY OTHER GENERATED FILE IS REACHED, and that is
// the claim rather than a convenience: these assertions used to call a per-host wrapper function
// that existed only to be called from here, so they proved the RENDERER worked while the file an
// operator installs had no path, no ignore rule, and no row in the artifact population. Routing
// them through gunbc.generated_artifact_emit artifact_generate means the same bytes are asserted
// AND the enrollment is executed: unenroll the row and generation has no arm to reach.
//
// A REFUSAL RENDERS THE EMPTY STRING, WHICH FAILS EVERY CONTAINMENT CLAIM BELOW rather than
// greening one. The no-wildcard claim is the one that would pass on empty bytes, so it carries a
// positive conjunct that only real content satisfies.
fn srv3_runner_host_sudoers_artifact() -> GeneratedArtifact {
  RunnerHostSudoersArtifact { host: operator_host_srv3 }
}

fn runner_host_sudoers_bytes(host: HostIdentity) -> String {
  match artifact_generate(a: RunnerHostSudoersArtifact { host: host }) {
    ArtifactGenerated { content } => content
    ArtifactGenerationRefused { reason: _ } => ""
  }
}

fn srv3_runner_host_sudoers() -> String {
  runner_host_sudoers_bytes(host: operator_host_srv3)
}

// THE ENROLLMENT ITSELF, AND IT IS THE COMMITTED ARM THAT MATTERS. A registry row alone would give
// the file a path and an ignore rule; CommitRequired is what puts it in the population main_wet
// writes and the drift gate adjudicates, which is the whole reason the stale drop-in installed on
// srv3 could diverge from the grant constructors with nothing in the repository able to say so.
// RED IS AUTHORABLE in three directions: drop the row from generated_artifact_registry, move its
// commit policy to NotCommitted, or change the location, and one of these conjuncts goes false.
test fn witness_srv3_sudoers_is_an_enrolled_generated_artifact() -> Bool {
  registry_contains(a: srv3_runner_host_sudoers_artifact())
    && artifact_path(a: srv3_runner_host_sudoers_artifact())
      == "provisioning/srv3/gunbc-ghrunner.sudoers"
    && artifact_is_committed(a: srv3_runner_host_sudoers_artifact())
}

// THE HEADER NAMES THIS HOST'S OWN PATH, which is what the derived header buys: srv1's file cannot
// tell a reader to reproduce it with srv3's recipe, because neither header carries an authored
// entry-point string any more.
test fn witness_rendered_header_names_the_hosts_own_artifact_path() -> Bool {
  string_contains(s: srv3_runner_host_sudoers(), pattern: "provisioning/srv3/gunbc-ghrunner.sudoers")
    && !string_contains(
      s: runner_host_sudoers_bytes(host: operator_host_srv1),
      pattern: "provisioning/srv3/",
    )
}

// THE ANTI-DRIFT WALL, ASSERTED AT ITS SEAM. The sudoers command match is DERIVED from the same argv
// the host executes, so a grant that fails to authorize its own command has no spelling. This
// witness pins that identity rather than a golden string: it rebuilds the expected line from the
// argv projection, so editing either projection alone cannot keep it green.
// RED IS AUTHORABLE: rendering the sudoers command from anything other than the argv -- a bare
// binary path, as the roster did before this module -- makes the two disagree and this goes false.
test fn witness_sudoers_command_is_the_argv() -> Bool {
  let op = RemoveDirectoryTree { path: "/opt/actions-runner/srv3-09" as NonEmptyStr }
  executor_privileged_operation_sudoers_command(op: op)
    == join(map(executor_privileged_operation_argv(op: op), w => w as String), " ")
}

// RUN-AS IS root, NEVER ALL. ALL=(ALL) authorizes the grantee to run the command as any user on the
// host, including other service accounts; the executor rendered exactly that before this module.
test fn witness_run_as_is_root_not_all() -> Bool {
  string_contains(
    s: executor_privileged_operation_sudoers_line(
      grantee: "ghrunner" as NonEmptyStr,
      op: SystemdDaemonReload,
    ) as String,
    pattern: "ALL=(root) NOPASSWD:",
  )
}

// NO WILDCARD REACHES THE RENDERED FILE. A sudoers wildcard such as /opt/actions-runner/* matches
// `..` -- fnmatch's * declines to cross `/`, and `..` contains none -- so it would authorize
// `rm -rf /opt/actions-runner/..`. Every managed path is named in full instead.
test fn witness_rendered_grants_carry_no_wildcard() -> Bool {
  let body = srv3_runner_host_sudoers()
  string_contains(s: body, pattern: "ALL=(root) NOPASSWD:")
    && !string_contains(s: body, pattern: "*")
    && !string_contains(s: body, pattern: "?")
}

// THE POPULATION IS DERIVED FROM THE SLOT ROSTER, so every managed slot contributes exactly the
// operations the provisioner runs against it. A slot added to the roster brings its own
// authorization; one removed takes it away. RED: hand-listing binaries instead of folding the
// roster decouples the count from the roster and this goes false.
//
// THE PER-SLOT GITHUB FACTOR IS FOUR IN THIS SUM, SPLIT FOR DISCRIMINATION. Teardown is the
// grammar bound, not the desired width. Each desired slot then contributes one install
// directory and three service transitions (unmask, enable, start) -- the transitions are no longer
// hand-listed here, they are the steps the activation plan can issue for that slot
// (gunbc.runner.runner_slot_actuation::runner_slot_activation_steps), so a masked slot -- srv3-06/07 and
// srv4-06/07, the former fabric slots now committed to CI -- is reachable by converge instead of stopping
// at `sudo: a password is required`. `slots * 4` is install+activation; `activation == slots * 3` is the
// transition half.
//
// THE FACTOR IS ASSERTED IN TWO PIECES RATHER THAN AS ONE PRODUCT, because `slots * 5` alone would
// stay green if the two halves drifted in opposite directions -- four directory operations and no
// transitions counts the same as one and four. Splitting them means each half has to be right.
// THE FABRIC CELL CONTRIBUTES ITS OWN DERIVED TERM, GROUNDED IN THE FABRIC AUTHORITIES RATHER THAN
// A LITERAL. A fabric host adds one base-directory ensure plus, per fabric slot: two directory
// ensures (root-owned cell root, delegated attempt root), one set-property grant per desired slice
// directive, and one slice start. Both factors come from the authorities that decide them --
// fabric_execution_slot_identities and fabric_cell_slice_desired_directives -- so a second fabric
// cell or a sixth directive moves this row without an edit, and a roster that dropped the fabric
// grants goes red.
// THE HOST-WIDE TERM IS runner_host_wide_privileged_operations(deploy).length(), NOT A LITERAL.
// On main the same list has five members (converge dir, runner base, runner cache, kvm
// supplementary group, daemon-reload) while this witness transcribed `+ 4` and named four of
// them, omitting kvm -- false from birth in ea22499df2, the commit that added both the list and
// the witness. test.claim.executor_privileged_operation_witness is not in
// v2.workflow.required_floor required_gate_prefixes, so the required floor never executes it;
// it reddened here only because touching this file enrolled it as a changed witness. That is an
// inert lens on main (gunbc.design_argument::how_to_work), not a defect this CPU-quota diff introduced. The fabric term
// already derived from desired_directives length; this term now does the same from the named
// host-wide list. `allocation_store == 2` remains a transcribed count of
// fabric_allocation_store_privileged_operations on a fabric host -- deriving that chain is
// out of scope here.
//
// THE MICROVM NETWORK READBACKS ARE THE SEVENTH TERM, AND THEY WERE MISSING FROM THIS SUM. #11751
// (99c2d33263) appended gunbc.runner.runner_microvm_network_converge microvm_network_granted_operations to
// every host's population -- the job user's readbacks only, reads by construction (that module
// states why the installs stay off this roster). The sum above omitted it, so the row was red from
// that landing by exactly that list's length. The term is that named list's length, not a literal.
// The retirement mask grants (runner_slot_retirement_mask_operations, derived from host_maskable_units)
// are one more named component of the roster, so the sum names them the same way.
test fn witness_population_tracks_the_slot_roster() -> Bool {
  let ds = fabric_cell_slice_desired_directives()
  // THE FABRIC TERMS ARE MEASURED ON SRV1, THE ONLY HOST STILL COMMITTING FABRIC CELLS. srv3 and srv4
  // committed theirs to CI under gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci (#16137), so every
  // srv3-scoped fabric term in this row has been dead since that landing: `fabric_cell_host_slots(srv3)`
  // reads [], the allocation store contributes nothing, and no slice directive is granted anywhere on
  // srv3 (its committed sudoers carries no set-property line). The row could not report that, because the
  // entry did not resolve at all -- its import block named none of these callees -- so a premise that had
  // stopped existing kept asserting a population the model no longer renders. Both halves are asserted
  // here: the fabric population where cells are still committed, and the zero that replaced it on srv3.
  let fabric_host = wt_srv1_deploy()
  let fabric_spec = runner_host_spec_of(deploy: fabric_host)
  let ci_host = wt_srv3_deploy()
  let ci_spec = runner_host_spec_of(deploy: ci_host)
  let slots = desired_runner_slot_members(deploy: fabric_host).length()
  let activation = runner_slot_activation_operations(members: desired_runner_slot_members(deploy: fabric_host)).length()
  let ci_slots = desired_runner_slot_members(deploy: ci_host).length()
  let ci_activation = runner_slot_activation_operations(members: desired_runner_slot_members(deploy: ci_host)).length()
  let fabric_slots = fabric_cell_host_slots(spec: fabric_spec).length()
  let directives = ds.length()
  let fabric_expected = 1 + fabric_slots * (2 + directives + 1)
  let allocation_store = fabric_allocation_store_privileged_operations(spec: fabric_spec).length()
  let host_wide = runner_host_wide_privileged_operations(spec: fabric_spec).length()
  let microvm_reads = microvm_network_granted_operations().length()
  let retirement_masks = runner_slot_retirement_mask_operations(spec: fabric_spec).length()
  runner_host_privileged_operations(deploy: fabric_host).length()
    == runner_slot_teardown_grant_index_bound + (slots * 3) + host_wide + fabric_expected + allocation_store + microvm_reads + retirement_masks
    && allocation_store == 2
    && fabric_cell_privileged_operations(spec: fabric_spec).length() == fabric_expected
    && activation == slots * 3
    // THE SAME FACTOR ON THE HOST THE DEFECT WAS MEASURED ON. srv3 carries no fabric term now, so its
    // activation rows are exactly the plan's steps -- unmask, enable, start -- per committed member.
    && ci_activation == ci_slots * 3
    && fabric_cell_privileged_operations(spec: ci_spec).length() == 0
    && slots > 0
    && ci_slots > 0
    && fabric_slots > 0
    && host_wide > 0
    && microvm_reads > 0
}

// THE CPUQuota GRANT IS THE DECLARED DIRECTIVE OF THE CELL IT AUTHORIZES, NOT A TRANSCRIBED PERCENTAGE.
// The generated sudoers body is `artifact_generate` of this host's row; each grant word is the
// `systemd_slice_directive_line` of the quota directive `fabric_cell_slice_quota_directive` selects for
// THAT cell's declared quota -- a thread ceiling under CpuQuotaResolved, the empty assignment `CPUQuota=`
// under SlotCpuQuotaUnbounded (the 2026-09-19 policy). RED: hand-insert a different quota into the
// committed file, or declare a different quota than the committed projection, and either this or the
// generated-artifact gate goes false.
//
// MEASURED PER CELL, ON SRV1. This row read srv3 while srv3 still committed fabric cells, both of them
// unbounded; #16137 (gunbc.design_ruling::srv3_srv4_fabric_slots_serve_ci) moved srv3's and srv4's cells
// to CI, so srv3 renders no slice grant at all and the file-wide negative "no line ends in %" was being
// answered by an empty file. srv1 commits two cells and they declare DIFFERENT quotas -- the shakedown
// cell a thread ceiling, the revision-job cell unbounded -- so the claim is now made cell by cell, which
// is also the shape the model has: the per-cell directives come from
// gunbc.fabric.fabric_cell_effect::fabric_cell_slice_desired_directives_of_slot, and the module itself
// says a consumer that has a slot must read _for_slot rather than answer the fleet row for it.
//
// THE NEGATIVE IS THE NEWLINE. Each cell's grant is asserted as `<slice unit> <escaped assignment>`
// TERMINATED BY A NEWLINE, so a percentage on an unbounded cell -- `CPUQuota\=100%` -- fails to match the
// empty assignment it must carry; the earlier file-wide "no line ends in %" could not say which cell was
// throttled once one legitimate percentage grant existed, and a `%group` principal line begins with the
// character anyway (review 68479). THE SUDOERS SIDE IS READ IN SUDOERS' OWN SPELLING: since #12563 every
// grant word passes through gunbc.executor_privileged_operation sudoers_argument_word, which escapes `=`
// as sudoers(5) documents, so the file carries `CPUQuota\=` and the bare directive line can never appear
// in it. The claim renders the assignment through that same escape rather than transcribing the escaped
// literal, so the two sides stay one word under the grammar that joins them.
test fn witness_fabric_slice_cpu_quota_grant_is_the_declared_directive() -> Bool {
  let cells = fabric_cell_host_slots(spec: runner_host_spec_of(deploy: wt_srv1_deploy()))
  let body = runner_host_sudoers_bytes(host: operator_host_srv1)
  cells.length() > 0
    && string_contains(s: body, pattern: "ALL=(root) NOPASSWD:")
    && all(cells, c =>
      string_contains(
        s: body,
        pattern: join(
          [
            fabric_cell_slice_name(slot: c),
            " ",
            sudoers_argument_word(
              w: systemd_slice_directive_line(
                directive: fabric_cell_slice_quota_directive(
                  quota: gunbc_runner_slot_desired_for(slot: c).cpu_quota),
              ),
            ) as String,
            "\n",
          ],
          "",
        ),
      ))
    // AND THE FLEET ROW STILL DECLARES THE 2026-09-19 POLICY: the quota a consumer naming no slot is
    // answered with is the unbounded assignment, not a percentage. RED: declare a fleet-wide thread
    // ceiling and this goes false while the per-cell rows above keep passing -- the two claims are
    // deliberately separate.
    && string_contains(
      s: join(map(fabric_cell_slice_desired_directives(), d => systemd_slice_directive_line(directive: d)), "\n"),
      pattern: systemd_slice_directive_line(directive: slice_cpu_quota_unbounded()),
    )
    // AND NOTHING IS LEFT GRANTING A SLICE CAP ON THE HOST THAT NO LONGER COMMITS CELLS.
    && !string_contains(s: srv3_runner_host_sudoers(), pattern: "CPUQuota")
}

// A HOST WITH NO RESOLVED WIDTH IS COVERED VACUOUSLY AND SAYS SO. The bound must exceed every width
// the fleet COMMITS; a host that commits none imposes no lower bound, and the alternative -- reading
// its unresolved width as 0 -- would make this conjunct true for the wrong reason on exactly the
// host most likely to be re-grounded into a large width later.
fn bound_covers(host: HostIdentity, bound: Int) -> Bool {
  match gunbc_runner_committed_width(host: host) {
    RunnerWidthUnresolved { cause: _ } => true
    RunnerWidthDerived { slots: n } => bound >= n
  }
}

// THE TEARDOWN GRANT COVERS EVERY WIDTH THE FLEET COMMITS TO, with the bound pinned above each
// host's committed width so a width change cannot outgrow its own teardown; and it is exact paths
// only -- the highest grammar dir is named and the one past the bound is not.
test fn witness_teardown_grant_bound_covers_every_committed_width_exactly() -> Bool {
  let bound = runner_slot_teardown_grant_index_bound
  let dirs = runner_slot_grammar_dirs_to_bound(host: operator_host_srv2, bound: bound)
  bound_covers(host: operator_host_srv1, bound: bound)
    && bound_covers(host: operator_host_srv2, bound: bound)
    && bound_covers(host: operator_host_srv3, bound: bound)
    && bound_covers(host: operator_host_srv4, bound: bound)
    && bound >= 12
    && dirs.length() == bound
    && any(dirs, d => (d as String) == "/opt/actions-runner/srv2-12")
    && any(dirs, d => (d as String) == "/opt/actions-runner/srv2-64")
    && !any(dirs, d => (d as String) == "/opt/actions-runner/srv2-65")
    && !any(dirs, d => string_contains(s: d as String, pattern: "*"))
}

// THE NON-INTERACTIVE FLAG IS PRESENT, NOT OMITTED. The hand-spelled predecessor carried its own
// "sudo " prefix and omitted -n, so a missing NOPASSWD grant would hang waiting for a tty prompt
// rather than refusing immediately. RED IS AUTHORABLE: drop "-n" from sudo_elevate and this goes
// false before any host waits for a deadlocked sudo.
test fn witness_shell_command_is_non_interactive() -> Bool {
  let op = RemoveDirectoryTree { path: "/opt/actions-runner/srv3-09" as NonEmptyStr }
  let rendered = executor_privileged_operation_shell_command(op: op)
  string_contains(s: rendered, pattern: "'-n'")
}

// THE BINARY IS CITED BY ABSOLUTE PATH. A bare "sudo" lets PATH decide which binary crosses the
// privilege boundary (extdeps.sudo.elevation lines 29-38). The hand-spelled predecessor carried a
// bare "sudo " prefix. RED IS AUTHORABLE: change sudo_elevate's binary path to a bare name and
// this goes false.
test fn witness_shell_command_cites_absolute_sudo_path() -> Bool {
  let op = RemoveDirectoryTree { path: "/opt/actions-runner/srv3-09" as NonEmptyStr }
  let rendered = executor_privileged_operation_shell_command(op: op)
  string_contains(s: rendered, pattern: "'/usr/bin/sudo'")
}

// THE PERTURBATION COMPANION: the OLD hand-spelled form, for discrimination evidence.
// If the function is ever reverted to the hand-spelled "sudo " prefix (missing -n and bare binary),
// this test goes red — proving the fix is load-bearing and the distinguishing properties above
// are testing the authority rather than a coincidental string match.
test fn witness_shell_command_differs_from_hand_spelled_prefix() -> Bool {
  let op = RemoveDirectoryTree { path: "/opt/actions-runner/srv3-09" as NonEmptyStr }
  let rendered = executor_privileged_operation_shell_command(op: op)
  let old_form = join([
    "sudo ",
    join(
      map(executor_privileged_operation_argv(op: op), w => posix_single_quote(spelling: w as String)),
      " ",
    )
  ], "")
  rendered != old_form
}

// THE JOIN, ASSERTED THROUGH THE PRODUCTION PATH. This is the witness the module exists for: the
// command the emitted provisioning script RUNS and the command the sudoers file GRANTS are the same
// word vector, reached from opposite ends of the tree. The left side comes from
// gunbc.runner.runner_slot_provision's real seam (what the host executes); the right side from the grant
// renderer (what the host authorizes). Before this module they were authored independently -- the
// script rebuilt an argv from a binary path while the roster granted the bare binary -- and the
// disagreement was discoverable only by a wet apply on a real host.
// RED IS AUTHORABLE: change either projection alone and the two stop matching.
// The script runs the QUOTED argv; the sudoers file grants the SAME argv unquoted.
test fn witness_executed_command_is_the_granted_command() -> Bool {
  let slot = "/opt/actions-runner/srv3-09" as NonEmptyStr
  let job = "ghrunner" as NonEmptyStr
  let executed = gunbc_runner_slot_privileged_commands(slot_dir: slot, job_user: job, mode: executor_managed_directory_mode)
  let op = RemoveDirectoryTree { path: slot }
  let argv = executor_privileged_operation_argv(op: op)
  executed.remove_command
    == executor_privileged_operation_shell_command(op: op)
    && executor_privileged_operation_sudoers_command(op: op)
      == join(map(argv, w => w as String), " ")
}

// AND THE GRANT ACTUALLY COVERS THE SLOT THE SCRIPT TOUCHES. A population that renders correctly but
// omits the slot the provisioner is about to mutate is the srv3 failure exactly.
test fn witness_grant_population_covers_the_provisioned_slot() -> Bool {
  string_contains(
    s: srv3_runner_host_sudoers(),
    pattern: "/usr/bin/rm -rf /opt/actions-runner/srv3-09",
  )
}

// THE PRIVILEGE LAW, WALLED. A grantee that is also its own bootstrap principal is an account that
// authorizes itself, which is the one shape the whole staged-install transaction exists to prevent.
// RED IS AUTHORABLE: point executor_bootstrap_principal.login at the deploy row's job_user and
// this goes false.
test fn witness_bootstrap_principal_is_not_the_grantee() -> Bool {
  bootstrap_principal_is_not_the_grantee(
    bootstrap: executor_bootstrap_principal,
    deploy: wt_srv3_deploy(),
  )
}

// THE ADMITTED ROW, ASKED FOR RATHER THAN READ. srv2 has no deploy row at all now -- its width
// refuses -- so these rows come from the admission and a test that somehow lost its host fails on the
// fixture rather than on a fabricated production value.
fn wt_missing_deploy() -> RunnerHostDeploy {
  RunnerHostDeploy {
    host_label: "wt-unadmitted",
    ssh_target: "unadmitted@invalid.example",
    runner_user: "unadmitted",
    unit_user: "unadmitted",
    job_user: "unadmitted",
    app: gunbc_ci_github_app,
    runner_count: 1,
  }
}

fn wt_srv3_deploy() -> RunnerHostDeploy {
  match admitted_deploy_for(host: operator_host_srv3) {
    Present { value: d } => d
    Absent => wt_missing_deploy()
  }
}

