// A COPRODUCT THAT DECLARES ITS OWN `Absent` ARM IS NOT AN OPTIONAL. The bare arm is typed as the
// kernel Optional coproduct, so the produced side is optional BY NAME ONLY; refusing it at the
// declared coproduct was a fabricated refusal, measured at sixteen record-field and declared-return
// sites and at six direct-call arguments that already stood refused on main
// (std.upsert_decision ObservationVerdict, gunbc.host.host_converge ConvergeVerdict). One source
// holds the arm at all three positions.
fn oar_own_absent_positive_source() -> String {
  "module oar.own_absent_ok\n\nimport std.types { Int, String }\n\ntype Verdict\n  = Converged\n  | Absent\n\ntype Receipt { verdict: Verdict }\n\nfn take_v(v: Verdict) -> Int {\n  match v {\n    Converged => 1\n    Absent => 0\n  }\n}\n\nfn probe(c: Bool) -> Verdict {\n  let r = Receipt { verdict: Absent }\n  if c { r.verdict } else if take_v(v: Absent) == 0 { Absent } else { Converged }\n}\n"
}

test fn a_coproducts_own_absent_arm_at_its_declared_positions_still_compiles() -> Bool  {
  not_inhabited_blocking_count(source: oar_own_absent_positive_source()) == 0
    && compile_dag_rust_emit_check(
      oar_own_absent_positive_source(),
      "src/oar_own_absent_ok.rs",
      [],
      []
    )
}

// THE DECLARED RESIDUAL, ENROLLED AS WHAT IT IS. An index access types as optional and realizes in
// Rust as the bare element, so its optionality is not established across the two acceptance paths
// and these positions raise no cardinality obligation for it (v1.compiler.infer
// expr_value_is_index_access; the seed's own tokenizer returns `chars[pos]` at a declared Int).
// This claim pins the admission so the residual is an executed fact rather than a sentence: it
// goes red the day the index model and its realization are reconciled and the wall reaches index
// values, and on that day it flips to a refusal count, it does not retire.
fn oar_index_residual_source() -> String {
  "module oar.index_residual\n\nimport std.types { Int, String }\n\ntype Code { code: Int }\n\nfn probe(xs: List<Int>) -> Int {\n  xs[0]\n}\n\nfn probe_field(xs: List<Int>) -> Code {\n  Code { code: xs[0] }\n}\n"
}

test fn an_index_access_at_a_required_position_is_the_declared_residual() -> Bool  {
  not_inhabited_blocking_count(source: oar_index_residual_source()) == 0
}
