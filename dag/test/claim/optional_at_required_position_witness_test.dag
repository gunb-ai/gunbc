// THE REMAINING REQUIRED POSITIONS: record literal field, declared return (trailing expression and
// early return), data initializer, let annotation. Receipt, review 73175 on gunbc#12677:
// `AccountTripNativeCauseNumericCode { code: parse_int(..) }` for `code: Int` compiled with no row,
// because those seams compared the two types through a relation that does not read cardinality.
// The first RED is that shape exactly, parse_int into an Int field. Each position has one RED
// asserting EXACTLY ONE blocking DeclaredTypeNotInhabited row over a source with one candidate
// site, and one control one term away: the same optional value at the same position declared
// optional, asserting zero such rows and a clean Rust emission.

fn oar_field_parse_int_negative_source() -> String {
  "module oar.field_parse_int\n\nimport std.types { Int, String }\n\ntype Code { code: Int }\n\ntype MaybeCode { code: Int? }\n\nfn maybe_i(x: Int) -> Int? {\n  if x > 0 { Present { value: x } } else { none }\n}\n\nfn probe(s: String) -> Code {\n  Code { code: parse_int(s: s) }\n}\n"
}

test fn parse_int_at_a_required_int_field_must_refuse() -> Bool  {
  not_inhabited_blocking_count(source: oar_field_parse_int_negative_source()) == 1
}

fn oar_field_negative_source() -> String {
