module test.claim.approval_broker_serve_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, NonEmptyStr, HttpMethod, GET, POST, PUT }
import extdeps.http.server {
  ServedRouteTable,
  ServedRouteTableBuilt, ServedRouteTableBuildRefused,
  RouteSelection, SelectedStatic, SelectedDynamic, MethodNotAllowed, NoRouteMatched,
  serve_select_route,
}
import extdeps.uri_path { path_param_value }
import gunbc.auth.approval_broker_serve {
  ApprovalBrokerHandler,
  ApprovalConfirmPageHandler, ApprovalDecideHandler, ApprovalSubmitHandler, ApprovalStatusHandler,
  approval_broker_route_specs,
  approval_broker_route_table_build,
  approval_broker_respond,
  approval_broker_respond_as,
}
import gunbc.auth.approval_writer_authority {
  ApprovalServingProcess, RoadmapProcess, BrokerProcess,
  ApprovalWriterAuthority, RoadmapWriter, BrokerWriter,
  ApprovalWriteAdmission, ApprovalWriteAdmitted, ApprovalWriteRefused,
  approval_write_admission_under,
}
import extdeps.http.server { ServeHttpResponse }
import gunbc.auth.approval_broker_endpoint {
  approval_broker_confirm_path_template,
  approval_broker_decide_path_template,
  approval_broker_submit_path,
  approval_broker_status_path_template,
  approval_broker_confirm_path_prefix,
  approval_broker_listen_port,
  approval_broker_submit_url,
  approval_broker_status_url,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A Refused build yields the EMPTY table here, so every selection claim below goes RED — the
// discriminating direction. The production path never does this: approval_broker_respond answers
// 500 naming the broken literal.
fn broker_table_or_empty() -> ServedRouteTable<ApprovalBrokerHandler> {
  match approval_broker_route_table_build() {
    ServedRouteTableBuilt { table: t } => t
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

fn broker_selects(method: HttpMethod, path: String, want: ApprovalBrokerHandler) -> Bool {
  match serve_select_route(table: broker_table_or_empty(), method: method, path: path) {
    SelectedDynamic { handler: h, params: _ } => h == want
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

// THE POSITIVE CONTROL FOR THE ROADMAP'S WALL. test.claim.roadmap_serve_witness
// roadmap_serve_table_owns_no_approval_route asserts the roadmap answers NOTHING for these four
// (method, path) pairs; on its own that claim is satisfiable by deleting the approval loop. This
// one establishes the same four pairs are answered HERE, so the pair together says the routes
// moved rather than vanished.
test fn approval_broker_table_selects_the_four_routes() -> Bool {
  broker_selects(method: GET, path: "/approve/esc-1.approve.0badc0de", want: ApprovalConfirmPageHandler)
    && broker_selects(method: POST, path: "/approve/esc-1.approve.0badc0de", want: ApprovalDecideHandler)
    && broker_selects(method: POST, path: "/approvals", want: ApprovalSubmitHandler)
    && broker_selects(method: GET, path: "/approvals/esc-1", want: ApprovalStatusHandler)
}

// THE TABLE IS EXACTLY THE FOUR. A fifth row is not a neutral addition: every route this process
// serves is one more thing whose demand shares the broker's slice, and the split exists because
// co-tenancy is what made an approval poll depend on a dashboard render.
test fn approval_broker_table_carries_no_other_route() -> Bool {
  count(approval_broker_route_specs()) == 4
    && match approval_broker_route_table_build() {
      ServedRouteTableBuilt { table: t } => count(t.routes) == 4
      ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => false
    }
}

// A METHOD THE PAIR DOES NOT DEFINE IS 405 WITH THE ALLOWED SET, not a 404 and not a decision.
// The GET/POST split on one path is the whole safety property of the approval pair, so the table
// must distinguish "this path exists under other methods" from "no such path".
test fn approval_broker_unsupported_method_on_the_pair_is_method_not_allowed() -> Bool {
  match serve_select_route(table: broker_table_or_empty(), method: PUT, path: "/approve/esc-1.approve.0badc0de") {
    MethodNotAllowed { allowed: ms } => count(ms) == 2
    SelectedDynamic { handler: _, params: _ } => false
    SelectedStatic { route: _ } => false
    NoRouteMatched => false
  }
}

// THE DECIDE PATH IS THE CONFIRM PATH. Two literals that agree today are a coincidence; one literal
// read twice is the construction that keeps "same path, different consequence" true.
test fn approval_broker_pair_is_one_path() -> Bool {
  approval_broker_decide_path_template == approval_broker_confirm_path_template
}

// THE LINK PREFIX IS THE ROUTE'S OWN. gunbc.auth.approval_request_submission builds every
// notification link from approval_broker_confirm_path_prefix; if that prefix and the route template
// could disagree, an issued link would 404 at the broker while every claim over either side passed.
test fn approval_broker_link_prefix_matches_the_confirm_route() -> Bool {
  join([approval_broker_confirm_path_prefix as String, "\{capability\}"], "")
    == approval_broker_confirm_path_template as String
}

// ── THE INHABITANCE CLAIM ────────────────────────────────────────────────────────────────────
// Every claim above supplies a (method, path) at the ROUTE TABLE boundary and inspects what the
// table answers. DESIGN section 3's pairing obligation is that some claim still runs the real path,
// and it is discharged here: this one enters approval_broker_respond — the fold the serve entry
// calls — with the bytes a request carries, and lets it build the table, select, bind the path
// parameter, parse the capability segment and serialize the page.
//
// The confirm route is the one that can be run for real without a store: it renders and stops, by
// construction, because a GET must never spend a decision. That is the same property being
// asserted — a 200 with the decision word in it and NO write — so the claim exercises the route
// rather than merely proving the adapter compiles.
//
// DELETE THE INTEGRATION AND THIS GOES RED: remove the confirm row from the specs and the same call
// answers 404, not a differently-shaped 200.
test fn approval_broker_confirm_route_renders_through_the_real_entry() -> Bool {
  let r = approval_broker_respond(
    method_label: "GET",
    path: "/approve/esc-1.approve.0badc0de",
    body: "",
    tailscale_identity: "",
  )
  r.status == 200 && string_contains(s: r.body, pattern: "APPROVE")
}

// THE ADAPTER'S 404 IS ITS OWN, not the table's absence: a path this process does not serve answers
// not-found through the same entry rather than reaching a handler.
test fn approval_broker_entry_refuses_a_roadmap_path() -> Bool {
  let r = approval_broker_respond(
    method_label: "GET",
    path: "/roadmap",
    body: "",
    tailscale_identity: "",
  )
  r.status == 404
}

// ── THE LOOPBACK ENDPOINT A BOOT RUN IS POINTED AT ──────────────────────────────────────────
// ONE ADDRESS FOR THE PROCESS'S WHOLE LIFE, so a boot client needs no cutover-aware port logic: the
// same URL reaches the broker while it is dark and after it holds the store, and what changes is
// whether the write is ADMITTED (gunbc.auth.approval_writer_authority), not where it lands. An
// earlier cut parameterised this over a dark port and a serving port, which made the client's
// correctness depend on knowing which stage the deployment was in (side-chat HOLD item 1).
test fn the_loopback_submit_url_names_the_brokers_one_port() -> Bool {
  let url = approval_broker_submit_url(port: approval_broker_listen_port) as String
  string_contains(s: url, pattern: join(["127.0.0.1:", to_string(approval_broker_listen_port)], ""))
    && string_contains(s: url, pattern: approval_broker_submit_path as String)
}

// THE STATUS URL IS THE SUBMIT COLLECTION PLUS A MEMBER, and the claim is here because the obvious
// implementation is a second "/approvals/" literal that agrees until one of them moves. A status URL
// built this way reaches the route the broker's table actually carries.
test fn the_loopback_status_url_is_the_submit_collection_plus_the_escalation() -> Bool {
  let url = approval_broker_status_url(port: approval_broker_listen_port, escalation_id: "esc-1" as NonEmptyStr) as String
  url == join([approval_broker_submit_url(port: approval_broker_listen_port) as String, "/esc-1"], "")
    && broker_selects(method: GET, path: join([approval_broker_submit_path as String, "/esc-1"], ""), want: ApprovalStatusHandler)
}

// ══════════════════════════════════════════════════════════════════════════════════════════════
// WRITER AUTHORITY IS CONSULTED BEFORE ANY STORE MUTATION — side-chat HOLD item 3
// ══════════════════════════════════════════════════════════════════════════════════════════════
// PORT IDENTITY IS NOT WRITER AUTHORITY. The earlier design kept the broker on a separate port and
// treated being off the front door as being unable to write. That holds only for traffic arriving
// through the front door; a boot client on the same host reaches loopback directly, and the moment
// one does, two processes with working keyrings and one store root are both able to write it.
//
// So the two MUTATING routes consult gunbc.auth.approval_writer_authority before the store, and the
// process that is not the declared writer refuses. These claims run the real entry fold for both
// process identities, which is the only way to establish that the gate is on the path rather than
// merely declared beside it.

fn broker_respond_as(process: ApprovalServingProcess, method_label: String, path: String, body: String) -> ServeHttpResponse {
  approval_broker_respond_as(
    method_label: method_label,
    path: path,
    body: body,
    tailscale_identity: "",
    process: process,
  )
}

// THE ROADMAP MOUNT CANNOT FILE WHILE THE BROKER HOLDS AUTHORITY, and vice versa. Exactly one of
// the two process identities is admitted at any value of the row, which is the single-writer
// property stated where it is decided.
test fn exactly_one_process_may_write_at_every_authority_value() -> Bool {
  let roadmap_holds = approval_write_admission_under(authority: RoadmapWriter, asker: RoadmapProcess)
  let roadmap_holds_broker_asks = approval_write_admission_under(authority: RoadmapWriter, asker: BrokerProcess)
  let broker_holds = approval_write_admission_under(authority: BrokerWriter, asker: BrokerProcess)
  let broker_holds_roadmap_asks = approval_write_admission_under(authority: BrokerWriter, asker: RoadmapProcess)
  admitted(a: roadmap_holds) && !admitted(a: roadmap_holds_broker_asks)
    && admitted(a: broker_holds) && !admitted(a: broker_holds_roadmap_asks)
}

fn admitted(a: ApprovalWriteAdmission) -> Bool {
  match a {
    ApprovalWriteAdmitted { writer: _ } => true
    ApprovalWriteRefused { holder: _, asker: _ } => false
  }
}

// THE GATE IS ON THE REQUEST PATH, NOT BESIDE IT. This runs the broker's own adapter with the
// NON-WRITER identity and asserts the submission is refused with the authority's own reason -- so a
// future edit that removes the consult from approval_submit_response reds here even though the
// admission fold itself still exists and its own claims still pass.
//
// THE RED: delete the approval_write_admission call in approval_submit_response and this answers a
// submission outcome instead of the authority refusal.
test fn a_non_writer_submission_is_refused_before_the_store() -> Bool {
  let r = broker_respond_as(
    process: RoadmapProcess,
    method_label: "POST",
    path: approval_broker_submit_path as String,
    body: "{}",
  )
  r.status == 503 && string_contains(s: r.body, pattern: "writer authority is held by")
}

// THE SAME FOR THE ONE ROUTE THAT COMMITS A DECISION. A capability that parses is the input that
// would otherwise reach redeem_over_store, so this asserts the gate sits between the parse and the
// store rather than after it.
test fn a_non_writer_decision_is_refused_before_the_store() -> Bool {
  let r = broker_respond_as(
    process: RoadmapProcess,
    method_label: "POST",
    path: "/approve/esc-1.approve.0badc0de",
    body: "",
  )
  r.status == 503 && string_contains(s: r.body, pattern: "writer authority is held by")
}

// THE POSITIVE CONTROL: the READ routes are not gated, because gating a read would refuse a poll
// that is safe from either process and would say nothing true about single-writer discipline. The
// confirmation page renders what a URL claims and writes nothing.
test fn a_non_writer_may_still_render_the_confirmation_page() -> Bool {
  let r = broker_respond_as(
    process: RoadmapProcess,
    method_label: "GET",
    path: "/approve/esc-1.approve.0badc0de",
    body: "",
  )
  r.status == 200 && string_contains(s: r.body, pattern: "APPROVE")
}
