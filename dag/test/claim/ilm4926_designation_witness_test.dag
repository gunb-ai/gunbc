module test.claim.ilm4926_designation_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn w_ilm4926_is_carried_as_a_designator() -> Bool {
  ilm4926.designator == "ILM4926"
}

// The justification for a separate authority is INDEPENDENT publishers, not a
// count of mentions: two Ampere datasheets are one publisher saying it twice.
test fn w_the_designation_is_attested_by_independent_publishers() -> Bool {
  extdeps.cpu_attachment.ilm4926.attestation_count() == 3
    && std.types.list_length(items: extdeps.cpu_attachment.ilm4926.ilm4926_attestations) == 3
    && extdeps.cpu_attachment.ilm4926.attested_by_ampere_datasheets()
    && extdeps.cpu_attachment.ilm4926.attested_by_ocp_specification()
    && extdeps.cpu_attachment.ilm4926.attested_by_independent_publishers()
}

test fn w_each_attestation_carries_its_own_authority_and_wording() -> Bool {
  let ampere_max = extdeps.cpu_attachment.ilm4926.attestations_from_authority(authority: extdeps.cpu_attachment.ilm4926.extdeps_external_authority_anchor)
  let ampere_classic = extdeps.cpu_attachment.ilm4926.attestations_from_authority(authority: extdeps.cpu_attachment.ilm4926.altra_classic_datasheet_authority)
  let ocp = extdeps.cpu_attachment.ilm4926.attestations_from_authority(authority: extdeps.cpu_attachment.ilm4926.ocp_mt_jade_specification_authority)
  std.types.list_length(items: ampere_max) == 1
    && std.types.list_length(items: ampere_classic) == 1
    && std.types.list_length(items: ocp) == 1
    && ampere_max.first().wording == "device seated in ILM4926 socket"
    && ocp.first().wording == "ILM4926"
}

// THE OPEN QUESTION IS MODELLED, NOT ASSUMED AWAY. No cited document expands
// the designator or attributes it to a vendor part, so the referent is
// unresolved and the predicate says so.
test fn w_the_referent_is_unresolved_by_the_cited_documents() -> Bool {
  !extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.ilm4926_referent)
}

// RED control: each concrete referent WOULD resolve, so the unresolved answer
// above is a property of the evidence rather than a predicate that can only
// return false.
test fn w_red_a_concrete_referent_would_resolve_the_question() -> Bool {
  extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.SocketBodyOnly)
    && extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.IndependentLoadingMechanismOnly)
    && extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.SocketAssemblyIncludingLoadingMechanism)
    && !extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.ReferentUnresolvedByCitedDocuments { reason: "any reason at all" })
}

// RED control: a single-publisher population must NOT read as independent
// attestation, which is the claim this module's existence rests on.
test fn w_red_one_publisher_twice_is_not_independent_attestation() -> Bool {
  let ampere_only = extdeps.cpu_attachment.ilm4926.attestations_from_authority(authority: extdeps.cpu_attachment.ilm4926.extdeps_external_authority_anchor)
  let ocp_only = extdeps.cpu_attachment.ilm4926.attestations_from_authority(authority: extdeps.cpu_attachment.ilm4926.ocp_mt_jade_specification_authority)
  std.types.list_length(items: ampere_only) != std.types.list_length(items: extdeps.cpu_attachment.ilm4926.ilm4926_attestations)
    && std.types.list_length(items: ocp_only) != std.types.list_length(items: extdeps.cpu_attachment.ilm4926.ilm4926_attestations)
}

// THE FOUR BOARD-DESIGN AXES ARE UNRESOLVED SUMS, NOT NONEMPTY STRINGS — read by
// match on each field rather than a Bool predicate over the coproduct.
// THE SOCKET BODY IS NOW IDENTIFIED ON EVERY AXIS, AND THE DESIGNATOR IS STILL NOT EXPANDED.
// This witness inverted on 2026-08-23 when Lotes supplied AZIFA072-P001CCS. It is kept rather
// than deleted because the pairing is the whole content: three axes flipped and the fourth did
// not, and a reader who assumes a part number closes the referent question needs to see exactly
// that combination assert. A part number resolves what to order; it does not tell you what the
// letters I-L-M stand for, and no cited document still does.
test fn w_the_socket_body_is_identified_while_the_designator_stays_unexpanded() -> Bool {
  let a = extdeps.cpu_attachment.ilm4926.ilm4926_attachment_standing
  extdeps.cpu_attachment.ilm4926.standing_is_established(s: a.socket_body.vendor_identity)
    && extdeps.cpu_attachment.ilm4926.standing_is_established(s: a.socket_body.orderable_part_number)
    && extdeps.cpu_attachment.ilm4926.standing_is_established(s: extdeps.cpu_attachment.ilm4926.attachment_board_land_pattern(a: a))
    && extdeps.cpu_attachment.ilm4926.attachment_socket_body_is_identified(a: a)
    && !extdeps.cpu_attachment.ilm4926.designation_referent_is_resolved(referent: extdeps.cpu_attachment.ilm4926.ilm4926_referent)
}

// TWO CONSTITUENTS, TWO AUTHORITIES, AND THE WITNESS IS THAT THEY STAYED SEPARATE. The retention
// assembly is cited to the Lotes catalogue page; the socket body is cited to the Lotes customer
// drawing. Both are Lotes, and that is exactly why this asserts the authorities are DIFFERENT
// declarations: one vendor supplying two parts is still two subjects, and the failure this
// guards is a later edit collapsing them onto one citation because the vendor name matches.
test fn w_the_two_constituents_resolve_to_their_own_separate_authorities() -> Bool {
  let a = extdeps.cpu_attachment.ilm4926.ilm4926_attachment_standing
  (match a.retention_assembly.orderable_part_number {
    extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: auth } => auth == extdeps.cpu_attachment.ilm4926.lotes_azif0222_product_authority
    extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => false
  })
    && (match a.socket_body.orderable_part_number {
      extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: auth } => auth == extdeps.cpu_attachment.lotes_azifa072.azifa072_drawing_authority
      extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => false
    })
    && (match extdeps.cpu_attachment.ilm4926.attachment_board_land_pattern(a: a) {
      extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: auth } => auth == extdeps.cpu_attachment.lotes_azifa072.azifa072_drawing_authority
      extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => false
    })
    && extdeps.cpu_attachment.ilm4926.standing_is_established(s: a.retention_assembly.vendor_identity)
    && extdeps.cpu_attachment.ilm4926.lotes_azif0222_product_authority != extdeps.cpu_attachment.lotes_azifa072.azifa072_drawing_authority
}

// MOUNTING HARDWARE IS ITS OWN CONSTITUENT AND IS NOT COVERED BY THE RETENTION PART. Whether the
// screws ship with AZIF0222 is unestablished, so assuming the retention row covers them would be
// inventing a procurement fact -- three constituents, two of them unresolved.
test fn w_mounting_hardware_is_separately_unresolved() -> Bool {
  let a = extdeps.cpu_attachment.ilm4926.ilm4926_attachment_standing
  !extdeps.cpu_attachment.ilm4926.standing_is_established(s: a.mounting_hardware.orderable_part_number)
    && extdeps.cpu_attachment.ilm4926.attachment_unresolved_constituent_count(a: a) == 1
}

// ESTABLISHED IS NOT COMPLETE, AND THIS WITNESS IS THE PAIR THAT SAYS SO. The standing-level
// gate now OPENS -- the socket body is identified and its land pattern established, so a
// predicate over the standing has nothing left to refuse. The release gate still REFUSES,
// because three geometry gaps stand in the socket-body module. Both halves are asserted
// together because either alone is misleading: the first read alone says ship it, the second
// read alone hides that the citations actually landed.
//
// This is the specimen for the failure caught on the run that introduced it: the standing gate
// flipped to true the moment the last citation arrived, while the stencil aperture was unread
// and the Pin 1 corner unlocated. Establishment is a property of a fact's grounding;
// releasability is a property of a deliverable's completeness. A gate reading only the first
// permits as soon as the paperwork is done.
test fn w_the_standing_gate_opens_while_the_release_gate_still_refuses() -> Bool {
  extdeps.cpu_attachment.ilm4926.attachment_footprint_may_emit(a: extdeps.cpu_attachment.ilm4926.ilm4926_attachment_standing)
    && !extdeps.cpu_attachment.ilm4926.lga4926_footprint_may_release()
    && !extdeps.cpu_attachment.lotes_azifa072.azifa072_footprint_may_emit()
    && extdeps.cpu_attachment.lotes_azifa072.land_pattern_gap_count() == 3
}

// RED control: the emit gate is reachable. A predicate that can only answer false would prove
// nothing about the corpus, so a fully identified socket body must open it -- and dropping either
// axis alone must close it again, which is what makes the conjunction real rather than decorative.
test fn w_red_an_identified_socket_body_with_a_land_pattern_would_permit_emission() -> Bool {
  let cited = extdeps.cpu_attachment.ilm4926.DesignationFactEstablished {
    value: "some cited value",
    authority: extdeps.cpu_attachment.ilm4926.lotes_azif0222_product_authority,
  }
  let missing = extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved {
    reason: "any reason at all",
    next_authority_to_consult: none,
  }
  let complete = extdeps.cpu_attachment.ilm4926.AttachmentStanding {
    socket_body: extdeps.cpu_attachment.ilm4926.SocketBodyStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
      board_land_pattern: cited,
    },
    retention_assembly: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
    mounting_hardware: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
  }
  let no_land_pattern = extdeps.cpu_attachment.ilm4926.AttachmentStanding {
    socket_body: extdeps.cpu_attachment.ilm4926.SocketBodyStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
      board_land_pattern: missing,
    },
    retention_assembly: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
    mounting_hardware: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
  }
  let unnamed_socket = extdeps.cpu_attachment.ilm4926.AttachmentStanding {
    socket_body: extdeps.cpu_attachment.ilm4926.SocketBodyStanding {
      vendor_identity: missing,
      orderable_part_number: missing,
      board_land_pattern: cited,
    },
    retention_assembly: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
    mounting_hardware: extdeps.cpu_attachment.ilm4926.ConstituentStanding {
      vendor_identity: cited,
      orderable_part_number: cited,
    },
  }
  extdeps.cpu_attachment.ilm4926.attachment_footprint_may_emit(a: complete)
    && !extdeps.cpu_attachment.ilm4926.attachment_footprint_may_emit(a: no_land_pattern)
    && !extdeps.cpu_attachment.ilm4926.attachment_footprint_may_emit(a: unnamed_socket)
    && extdeps.cpu_attachment.ilm4926.attachment_unresolved_constituent_count(a: complete) == 0
}

// RED control: the established arm is reachable only by inhabiting DesignationFactEstablished.
test fn w_red_a_cited_value_would_establish_a_resolution_axis() -> Bool {
  let established = extdeps.cpu_attachment.ilm4926.DesignationFactEstablished {
    value: "Lotes",
    authority: extdeps.cpu_attachment.ilm4926.extdeps_external_authority_anchor,
  }
  let unresolved = extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved {
    reason: "any reason at all",
    next_authority_to_consult: none,
  }
  match established {
    extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: _ } => true
    extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => false
  }
    && match unresolved {
      extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: _ } => false
      extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => true
    }
}


// THE ATTRIBUTION MUST NOT HARDEN INTO A FACT. Two part numbers and a vendor now exist in the
// model, and the whole risk of recording them is that a later reader takes their presence for
// resolution. These three witnesses are the wall against that: the candidates are carried, and
// NONE of them is officially attested or referent-assigned.
test fn w_one_lotes_part_is_carried_and_vendor_attested() -> Bool {
  count(extdeps.cpu_attachment.ilm4926.lotes_part_attestations) == 1
    && extdeps.cpu_attachment.ilm4926.any_part_officially_attested()
    && all(extdeps.cpu_attachment.ilm4926.lotes_part_attestations, c => extdeps.cpu_attachment.ilm4926.part_referent_is_assigned(c: c))
    && all(extdeps.cpu_attachment.ilm4926.lotes_part_attestations, c => match c.claimed_referent {
      extdeps.cpu_attachment.ilm4926.ClaimedLoadingMechanismWithBackplate => true
      extdeps.cpu_attachment.ilm4926.ClaimedSocketBody => false
      extdeps.cpu_attachment.ilm4926.ClaimedLoadingMechanism => false
      extdeps.cpu_attachment.ilm4926.ReferentAssignmentDisputed { because: _ } => false
    })
}

// THE ARM THAT MATTERS MOST IS THE ONE NOT TAKEN. A vendor-attested retention assembly must never
// be read as a socket body, because only the socket body carries the land pattern. This asserts
// the negative directly rather than trusting the row above to stay correct.
test fn w_no_carried_part_claims_to_be_the_socket_body() -> Bool {
  all(extdeps.cpu_attachment.ilm4926.lotes_part_attestations, c => match c.claimed_referent {
    extdeps.cpu_attachment.ilm4926.ClaimedSocketBody => false
    extdeps.cpu_attachment.ilm4926.ClaimedLoadingMechanism => true
    extdeps.cpu_attachment.ilm4926.ClaimedLoadingMechanismWithBackplate => true
    extdeps.cpu_attachment.ilm4926.ReferentAssignmentDisputed { because: _ } => true
  })
}

// RED control: the official arm is reachable, so the claim above is a measurement and not a
// vacuous truth about a predicate that can never be true.
test fn w_red_an_official_attestation_would_register_as_one() -> Bool {
  let official = extdeps.cpu_attachment.ilm4926.PartNumberCandidate {
    part_number: "SOME-PART",
    vendor: extdeps.vendor.lotes.lotes,
    claimed_referent: extdeps.cpu_attachment.ilm4926.ClaimedSocketBody,
    standing: extdeps.cpu_attachment.ilm4926.PublisherOfRecord,
    authority: extdeps.cpu_attachment.ilm4926.ampere_community_lga4926_thread_authority,
  }
  extdeps.cpu_attachment.ilm4926.part_candidate_is_officially_attested(c: official)
    && extdeps.cpu_attachment.ilm4926.part_referent_is_assigned(c: official)
}

// THE RETENTION DRAWING IS MOUNTING GEOMETRY, NOT A LAND PATTERN, and this witness is what stops
// attachment-stack progress from being read as land-pattern progress. Its second conjunct changed
// on 2026-08-23 and the reason is worth stating: the land pattern IS now established, so asserting
// it is unresolved would be asserting a stale fact. What the witness actually defends is that the
// retention drawing did not establish it -- so it now asserts the land pattern's authority is the
// SOCKET-BODY drawing and specifically NOT the retention catalogue page. That keeps the original
// claim exactly (mounting geometry establishes no pad array) and states it against the world that
// exists rather than the one that did.
test fn w_retention_drawing_does_not_establish_the_land_pattern() -> Bool {
  (match extdeps.cpu_attachment.ilm4926.lga4926_retention_drawing_scope {
    extdeps.cpu_attachment.ilm4926.MountingAndOutlineGeometry => true
    extdeps.cpu_attachment.ilm4926.BoardSidePadArray => false
  })
    && (match extdeps.cpu_attachment.ilm4926.attachment_board_land_pattern(a: extdeps.cpu_attachment.ilm4926.ilm4926_attachment_standing) {
      extdeps.cpu_attachment.ilm4926.DesignationFactEstablished { value: _, authority: auth } =>
        auth == extdeps.cpu_attachment.lotes_azifa072.azifa072_drawing_authority && auth != extdeps.cpu_attachment.ilm4926.lotes_azif0222_product_authority
      extdeps.cpu_attachment.ilm4926.DesignationFactUnresolved { reason: _, next_authority_to_consult: _ } => false
    })
}

// THE TWO ROUTES ARE DISTINGUISHED BY CARRIAGE, NOT BY PREFERENCE. Obtaining the gated Ampere
// package would answer the question for a reader and leave this public model exactly as unresolved
// as before, so an NDA acquisition must never register as progress toward a carriable fact. Only
// the socket-vendor route ends somewhere this repository can publish.
test fn w_only_the_public_socket_vendor_route_yields_a_carriable_fact() -> Bool {
  extdeps.cpu_attachment.ilm4926.route_yields_a_carriable_fact(r: extdeps.cpu_attachment.ilm4926.lga4926_land_pattern_public_route)
    && !extdeps.cpu_attachment.ilm4926.route_yields_a_carriable_fact(r: extdeps.cpu_attachment.ilm4926.lga4926_land_pattern_gated_route)
}

// AND THE GATED ROUTE STILL EXISTS. Recording that the land pattern is written down somewhere is a
// different claim from being able to carry it, and dropping the gated route would have made the
// fact look undiscovered rather than unpublishable.
test fn w_the_gated_route_is_retained_beside_the_public_one() -> Bool {
  match extdeps.cpu_attachment.ilm4926.lga4926_land_pattern_gated_route {
    extdeps.cpu_attachment.ilm4926.AccessGatedReferenceCollateral { access_route: a, why_not_carriable: _ } =>
      a == extdeps.vendor.ampere.ampere_customer_reference_boards_authority
    extdeps.cpu_attachment.ilm4926.PublicSocketVendorDrawing { vendor_authority: _, what_to_request: _ } => false
  }
}
