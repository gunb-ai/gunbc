module test.claim.fleet_converge_cli_witness

import std.logic { Bool }
import gunbc.host_converge { VerdictConverged, Absent }
import gunbc.fleet_converge_cli {
  ConvergeCliReceipt,
  converge_cli_run,
  converge_cli_receipt_line,
  converge_cli_receipt_converged,
  converge_cli_output,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_converge_cli_run_known_host_fails_closed_on_knob_frontier() -> Bool {
  let r = converge_cli_run(host: "srv1")
  r.host == "srv1"
    && r.applied == 0
    && r.drifted == 0
    && r.verdict == Absent
    && !converge_cli_receipt_converged(r: r)
    && match r.reason {
      Present { value: why } => string_contains(s: why, pattern: "host_converge_realize")
      Absent => false
    }
}

fn witness_converge_cli_run_unknown_host_refuses() -> Bool {
  let r = converge_cli_run(host: "no-such-fleet-host")
  r.host == "no-such-fleet-host"
    && r.applied == 0
    && r.drifted == 0
    && r.verdict == Absent
    && !converge_cli_receipt_converged(r: r)
    && match r.reason {
      Present { value: why } =>
        string_contains(s: why, pattern: "unknown fleet host identity")
          && !string_contains(s: why, pattern: "host_converge_realize")
      Absent => false
    }
}

fn witness_converge_cli_receipt_line_matches_byte_locked_grammar() -> Bool {
  let converged = ConvergeCliReceipt { host: "srv9", applied: 3, drifted: 0, verdict: VerdictConverged, reason: none }
  let refused = ConvergeCliReceipt { host: "srv1", applied: 0, drifted: 0, verdict: Absent, reason: Present { value: "refused" } }
  converge_cli_receipt_line(r: converged) == "converge-receipt host=srv9 applied=3 drifted=0 verdict=converged"
    && converge_cli_receipt_line(r: refused) == "converge-receipt host=srv1 applied=0 drifted=0 verdict=absent"
}

fn witness_converge_cli_output_projects_receipt_and_exit_signal() -> Bool {
  let out = converge_cli_output(host: "no-such-fleet-host")
  out.line == "converge-receipt host=no-such-fleet-host applied=0 drifted=0 verdict=absent"
    && !out.converged
    && match out.reason {
      Present { value: why } => string_contains(s: why, pattern: "unknown fleet host identity")
      Absent => false
    }
}

test fn fleet_converge_cli_witness_holds() -> Bool {
  witness_converge_cli_run_known_host_fails_closed_on_knob_frontier()
    && witness_converge_cli_run_unknown_host_refuses()
    && witness_converge_cli_receipt_line_matches_byte_locked_grammar()
    && witness_converge_cli_output_projects_receipt_and_exit_signal()
}
