module test.claim.approval_broker_cutover_witness_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, String, NonEmptyStr, Int, Port }
import std.measure { ByteSize, byte_size }
import gunbc.running_release_identity { running_release_revision_key }
import gunbc.serve_liveness {
  ServeLivenessRead, ServeLivenessUnreachable, serve_liveness_read_from_probe,
}
import gunbc.auth.approval_broker_endpoint {
  approval_broker_listen_port, approval_broker_dark_listen_port,
}
import gunbc.auth.approval_broker_cutover {
  ApprovalBrokerCutoverStage,
  DeployDark, ProveRelease, MeasureDemand, RepointFrontDoor, ProbeRouteClasses, RetireRoadmapRoutes,
  ApprovalBrokerCutoverEvidence,
  DarkDeploymentStanding, DarkUnitNotStarted, DarkUnitListening,
  ReleaseReadback, ReleaseNotReadBack, ReleaseReadBack,
  release_readback_from_livez,
  BrokerDemandReading, DemandUnmeasured, DemandMeasured,
  FrontDoorStanding, FrontDoorPointsAtRoadmap, FrontDoorPointsAtBroker,
  RouteClassProbe, RouteClassUnprobed, RouteClassRefused, RouteClassAnswered,
  CutoverAdmission, StageAdmitted, StageRefused,
  CutoverRefusal, DarkDeploymentNotListening, DarkDeploymentOnTheServingPort, ReleaseUnreadable,
  DemandNotMeasured, FrontDoorStillAtRoadmap, RouteClassNotProbed, RouteClassProbeRefused,
  approval_broker_cutover_admission,
  approval_broker_cutover_stage_discharged,
  dark_install_release_discharged, dark_install_evidence,
  DarkUnitNotStarted,
  approval_broker_cutover_position,
  approval_broker_cutover_complete,
  ApprovalRouteOwnership,
  ApprovalPathsRoutedToRoadmap, ApprovalPathsRoutedToBroker, ApprovalPathsOwnedByBroker,
  approval_route_ownership, approval_broker_deploy_port, roadmap_still_mounts_approval_routes,
  approval_front_door_mounts_installed, roadmap_is_routed_for_approvals, broker_is_routed_for_approvals,
  approval_broker_front_door_enable_argv,
  approval_broker_cutover_stages,
  approval_broker_front_door_enable_argv,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE RELEASE EVIDENCE IS BUILT BY THE READER, NOT BY THIS FIXTURE, which is what keeps these
// claims about a plan whose stages are decided by observations rather than by assertions: the
// admitting arm is reachable only through a liveness document that parsed and validated
// (review 68036). The empty-body call below is the refusing direction for the same reason.
data cutover_fixture_liveness_body: String = join([
  "{\"live\":true,\"", running_release_revision_key,
  "\":\"0123456789abcdef0123456789abcdef01234567\",\"bound_port\":18085}",
], "")

fn nothing_observed() -> ApprovalBrokerCutoverEvidence {
  ApprovalBrokerCutoverEvidence {
    dark: DarkUnitNotStarted { detail: "no unit installed" as NonEmptyStr },
    release_readback: release_readback_from_livez(body: ""),
    demand: DemandUnmeasured { missing: "all six readings" as NonEmptyStr },
    front_door: FrontDoorPointsAtRoadmap,
    confirm_probe: RouteClassUnprobed,
    decide_probe: RouteClassUnprobed,
    submit_probe: RouteClassUnprobed,
    status_probe: RouteClassUnprobed,
  }
}

fn everything_observed() -> ApprovalBrokerCutoverEvidence {
  ApprovalBrokerCutoverEvidence {
    dark: DarkUnitListening { port: approval_broker_dark_listen_port },
    release_readback: release_readback_from_livez(body: cutover_fixture_liveness_body),
    demand: DemandMeasured {
      cold_load_peak: byte_size(900000000),
      idle_resident: byte_size(300000000),
      submission_peak: byte_size(950000000),
      confirm_page_peak: byte_size(400000000),
      redemption_peak: byte_size(950000000),
      status_poll_peak: byte_size(350000000),
      declared_concurrency: 1,
    },
    front_door: FrontDoorPointsAtBroker { port: approval_broker_listen_port },
    confirm_probe: RouteClassAnswered { status: 200 },
    decide_probe: RouteClassAnswered { status: 400 },
    submit_probe: RouteClassAnswered { status: 403 },
    status_probe: RouteClassAnswered { status: 404 },
  }
}

fn stage_is_refused(stage: ApprovalBrokerCutoverStage, e: ApprovalBrokerCutoverEvidence) -> Bool {
  match approval_broker_cutover_admission(stage: stage, e: e) {
    StageRefused { stage: _, cause: _ } => true
    StageAdmitted { stage: _ } => false
  }
}

fn stage_is_admitted(stage: ApprovalBrokerCutoverStage, e: ApprovalBrokerCutoverEvidence) -> Bool {
  match approval_broker_cutover_admission(stage: stage, e: e) {
    StageAdmitted { stage: _ } => true
    StageRefused { stage: _, cause: _ } => false
  }
}

// ── THE PLAN REFUSES WITH NOTHING OBSERVED ───────────────────────────────────────────────────
// THE FIRST STAGE IS ADMITTED because deploying dark requires no prior evidence -- that is what
// makes it first. Every stage after it is refused, and the refusal is what the staging IS: without
// it, "advance" would mean "somebody decided to", which is a plan that can always proceed.
test fn cutover_refuses_every_stage_but_the_first_with_nothing_observed() -> Bool {
  let e = nothing_observed()
  stage_is_admitted(stage: DeployDark, e: e)
    && stage_is_refused(stage: ProveRelease, e: e)
    && stage_is_refused(stage: MeasureDemand, e: e)
    && stage_is_refused(stage: RepointFrontDoor, e: e)
    && stage_is_refused(stage: ProbeRouteClasses, e: e)
    && stage_is_refused(stage: RetireRoadmapRoutes, e: e)
}

// ── THE DANGEROUS STAGE IS THE ONE WITH THE SHARPEST CONTROL ─────────────────────────────────
// Removing the roadmap's approval routes while a route class was never probed is the edit that
// takes the approval loop down. UNPROBED IS NOT PASSING: it says nothing was learned, and folding
// it together with "probed and answered" is the cannot-tell-versus-not-met collapse. This is the
// discriminating RED for that: everything else is observed, one probe is missing, and the stage
// refuses naming that route class.
test fn cutover_refuses_retirement_when_one_route_class_was_never_probed() -> Bool {
  let full = everything_observed()
  let e = ApprovalBrokerCutoverEvidence {
    dark: full.dark,
    release_readback: full.release_readback,
    demand: full.demand,
    front_door: full.front_door,
    confirm_probe: full.confirm_probe,
    decide_probe: full.decide_probe,
    submit_probe: RouteClassUnprobed,
    status_probe: full.status_probe,
  }
  match approval_broker_cutover_admission(stage: RetireRoadmapRoutes, e: e) {
    StageRefused { stage: _, cause: c } => match c {
      RouteClassNotProbed { route: _ } => true
      _ => false
    }
    StageAdmitted { stage: _ } => false
  }
}

// A PROBE THAT CAME BACK REFUSED IS A DIFFERENT CAUSE FROM ONE NEVER TAKEN, and the two must not
// collapse: the first is a fact about the deployment that names a repair (most likely the
// front-door prefix question the endpoint module carries as an open read obligation), the second is
// a measurement someone has to go and take.
test fn cutover_distinguishes_a_refused_probe_from_an_unprobed_one() -> Bool {
  let full = everything_observed()
  let e = ApprovalBrokerCutoverEvidence {
    dark: full.dark,
    release_readback: full.release_readback,
    demand: full.demand,
    front_door: full.front_door,
    confirm_probe: RouteClassRefused { status: 404, detail: "front door presented /esc-1.approve.0badc0de" as NonEmptyStr },
    decide_probe: full.decide_probe,
    submit_probe: full.submit_probe,
    status_probe: full.status_probe,
  }
  match approval_broker_cutover_admission(stage: RetireRoadmapRoutes, e: e) {
    StageRefused { stage: _, cause: c } => match c {
      RouteClassProbeRefused { route: _, status: st, detail: _ } => st == 404
      _ => false
    }
    StageAdmitted { stage: _ } => false
  }
}

// ── A DARK DEPLOYMENT ON THE SERVING PORT IS NOT DARK ────────────────────────────────────────
// The measurement stage exists to observe the broker while it is NOT a writer. A broker that came
// up on the port the front door will reach is a second writer wearing the first stage's name, and
// the refusal names the port so the operator can see what happened rather than reading a false
// green.
test fn cutover_refuses_a_dark_stage_that_bound_the_serving_port() -> Bool {
  let full = everything_observed()
  let e = ApprovalBrokerCutoverEvidence {
    dark: DarkUnitListening { port: approval_broker_listen_port },
    release_readback: full.release_readback,
    demand: full.demand,
    front_door: FrontDoorPointsAtRoadmap,
    confirm_probe: RouteClassUnprobed,
    decide_probe: RouteClassUnprobed,
    submit_probe: RouteClassUnprobed,
    status_probe: RouteClassUnprobed,
  }
  match approval_broker_cutover_admission(stage: ProveRelease, e: e) {
    StageRefused { stage: _, cause: c } => match c {
      DarkDeploymentOnTheServingPort { port: p } => p == approval_broker_listen_port
      _ => false
    }
    StageAdmitted { stage: _ } => false
  }
}

// ── MEASUREMENT CANNOT BE SKIPPED BY SUCCEEDING AT THE NEXT THING ────────────────────────────
// Admission is cumulative, which is the ordering law rather than a convenience. With the six
// readings absent but every later observation present, repointing is still refused -- because a
// bound sized from a ceiling proved by containment is not a bound sized from this process.
test fn cutover_refuses_repointing_while_the_demand_is_unmeasured() -> Bool {
  let full = everything_observed()
  let e = ApprovalBrokerCutoverEvidence {
    dark: full.dark,
    release_readback: full.release_readback,
    demand: DemandUnmeasured { missing: "redemption peak" as NonEmptyStr },
    front_door: full.front_door,
    confirm_probe: full.confirm_probe,
    decide_probe: full.decide_probe,
    submit_probe: full.submit_probe,
    status_probe: full.status_probe,
  }
  match approval_broker_cutover_admission(stage: RepointFrontDoor, e: e) {
    StageRefused { stage: _, cause: c } => match c {
      DemandNotMeasured { missing: _ } => true
      _ => false
    }
    StageAdmitted { stage: _ } => false
  }
}

// ── THE POSITIVE CONTROL ─────────────────────────────────────────────────────────────────────
// Without this, every claim above is satisfiable by a plan that refuses everything. With every
// observation taken, the last stage is admitted and the transaction reads complete.
test fn cutover_admits_every_stage_once_every_observation_is_taken() -> Bool {
  let e = everything_observed()
  stage_is_admitted(stage: RetireRoadmapRoutes, e: e)
    && approval_broker_cutover_complete(e: e)
    && count(approval_broker_cutover_stages()) == 6
}

// COMPLETION IS NOT THE SAME FACT AS ADMISSION, and it is no longer something the caller can state.
// A plan admitted to perform the retirement has not performed it, and the fact that decides whether
// it was performed is roadmap_approval_mount -- the declaration the roadmap table and the deploy
// port both read. While that row says StillMounted, every observation can be in and the cutover is
// still incomplete, which is what this asserts. It used to read an evidence field an operator
// supplied, so a caller could assert completion with the rows still mounted (review 68050).
test fn cutover_is_not_complete_while_the_roadmap_still_mounts_the_routes() -> Bool {
  roadmap_still_mounts_approval_routes()
    && stage_is_admitted(stage: RetireRoadmapRoutes, e: everything_observed())
    && !approval_broker_cutover_complete(e: everything_observed())
}

// ── EXACTLY ONE PARTY IS ROUTED, AT EVERY VALUE OF THE ROW ──────────────────────────────────
// TWO EARLIER ARRANGEMENTS FAILED HERE IN OPPOSITE DIRECTIONS. The first let an ordinary apply
// produce two routed writers, forbidden only by prose (review 68050). Its repair used the broker's
// PORT as the lever, which could not express the middle state -- broker routed, roadmap holding
// rows nothing reaches -- so stage 4 would have repointed the front door at a port nothing was
// bound to, killing every live approval link and deadlocking the plan short of stage 6
// (review 68075).
//
// THIS CLAIM IS OVER EVERY ARM, NOT OVER THE ONE THE ROW HOLDS TODAY, which is the difference
// between asserting an invariant and observing a configuration. Zero routed is the outage; two
// routed is the store hazard; each arm must be exactly one.
fn exactly_one_routed(o: ApprovalRouteOwnership) -> Bool {
  let roadmap = match o {
    ApprovalPathsRoutedToRoadmap => true
    ApprovalPathsRoutedToBroker => false
    ApprovalPathsOwnedByBroker => false
  }
  let broker = match o {
    ApprovalPathsRoutedToRoadmap => false
    ApprovalPathsRoutedToBroker => true
    ApprovalPathsOwnedByBroker => true
  }
  (roadmap || broker) && !(roadmap && broker)
}

test fn exactly_one_party_is_routed_at_every_ownership_value() -> Bool {
  exactly_one_routed(o: ApprovalPathsRoutedToRoadmap)
    && exactly_one_routed(o: ApprovalPathsRoutedToBroker)
    && exactly_one_routed(o: ApprovalPathsOwnedByBroker)
    && (roadmap_is_routed_for_approvals() || broker_is_routed_for_approvals())
    && !(roadmap_is_routed_for_approvals() && broker_is_routed_for_approvals())
}

// ── THE FRONT DOOR CANNOT NAME A PORT NOTHING IS BOUND TO ───────────────────────────────────
// THE DEADLOCK REVIEW 68075 FOUND, AS A CLAIM. The mounts and the broker unit read the same row, so
// a mount that exists names the port the deploy binds. The RED is the exact edit that caused it:
// hardcode approval_broker_listen_port as the front-door backend while the deploy port is dark.
test fn the_front_door_backend_is_the_port_the_broker_is_deployed_on() -> Bool {
  let lines = map(approval_broker_front_door_enable_argv(https_port: 443), argv => join(argv, " "))
  let expected = to_string(approval_broker_deploy_port())
  count(lines) == 2
    && count(filter(lines, l => string_contains(s: l, pattern: expected))) == 2
}

// WHILE THE ROADMAP ANSWERS, THE BROKER IS UNREACHABLE TWICE OVER: no front-door mount names it,
// and it is not even bound to the port a mount would name. Either alone would do; both is what
// makes an accidental repoint during stages 1-3 a no-op rather than an outage.
test fn while_the_roadmap_answers_the_broker_is_dark_and_unmounted() -> Bool {
  match approval_route_ownership {
    ApprovalPathsRoutedToRoadmap =>
      approval_broker_deploy_port() == approval_broker_dark_listen_port
        && !approval_front_door_mounts_installed()
        && roadmap_still_mounts_approval_routes()
    ApprovalPathsRoutedToBroker =>
      approval_broker_deploy_port() == approval_broker_listen_port
        && approval_front_door_mounts_installed()
    ApprovalPathsOwnedByBroker =>
      approval_broker_deploy_port() == approval_broker_listen_port
        && approval_front_door_mounts_installed()
        && !roadmap_still_mounts_approval_routes()
  }
}

// THE PATHS ARE NEVER UNSERVED. At every arm, whoever is routed also has the routes: the roadmap
// only counts as routed while it still projects them, and the broker only while a mount names it.
// A row value where neither holds is the outage the staging exists to prevent, and there isn't one.
test fn no_ownership_value_leaves_the_approval_paths_unserved() -> Bool {
  let unserved = match approval_route_ownership {
    ApprovalPathsRoutedToRoadmap => !roadmap_still_mounts_approval_routes()
    ApprovalPathsRoutedToBroker => !approval_front_door_mounts_installed()
    ApprovalPathsOwnedByBroker => !approval_front_door_mounts_installed()
  }
  !unserved
}

// ── THE FRONT DOOR STAGE CARRIES ITS OWN ARGV ────────────────────────────────────────────────
// Stage 4 installs two mounts, and they must ADD to the roadmap's root mount rather than rebind it:
// a bare `serve --bg <port>` binds the default listener at the root, which is how a second
// deployment once silently repointed production. Two --set-path endpoints on one listener are two
// distinct keys, so the argv carry their mount flags and differ from each other.
test fn front_door_repoint_installs_two_distinct_scoped_mounts() -> Bool {
  let lines = map(approval_broker_front_door_enable_argv(https_port: 443), argv => join(argv, " "))
  count(lines) == 2
    && count(filter(lines, l => string_contains(s: l, pattern: "--set-path=/approve "))) == 1
    && count(filter(lines, l => string_contains(s: l, pattern: "--set-path=/approvals "))) == 1
}

// ══════════════════════════════════════════════════════════════════════════════════════════════
// THE PRODUCTION CONSUMER'S RED — review 68058
// ══════════════════════════════════════════════════════════════════════════════════════════════
// The first cut of the dark-install gate was green by construction: it asked ADMISSION for
// ProveRelease, whose cumulative cause list is the stages BEFORE it, so the release readback was
// never consulted and the only arm that could have fired -- a broker on the serving port -- is
// unwritable because approval_broker_deploy_port() derives the dark port. A constant StageAdmitted
// cited as the receipt that the plan is consumed is worse than no check at all, and the function's
// own annotation asserted the opposite of what it did.
//
// These four claims are the red that was missing. Each drives dark_install_release_discharged --
// the exact fold gunbc.live_deploy.apply calls -- with a reading the probe could actually return.

fn dark_install_refuses(read: ServeLivenessRead) -> Bool {
  match dark_install_release_discharged(listening_port: approval_broker_dark_listen_port, read: read) {
    StageRefused { stage: _, cause: _ } => true
    StageAdmitted { stage: _ } => false
  }
}

fn probe_answered(body: String) -> ServeLivenessRead {
  serve_liveness_read_from_probe(success: true, body: body, error: "unused" as NonEmptyStr)
}

// A UNIT THAT NEVER CAME UP. This is the most likely real failure of stage 1 -- a bad ExecStart, a
// missing binary, a slice that does not exist -- and it used to exit success.
test fn the_dark_install_refuses_when_the_broker_never_answered() -> Bool {
  dark_install_refuses(read: serve_liveness_read_from_probe(
    success: false,
    body: "",
    error: "connection refused" as NonEmptyStr,
  ))
}

// A PROCESS THAT ANSWERED A BRANCH NAME. The stage exists to establish WHICH BUILD is listening;
// every later stage's evidence is about that build, so admitting an unnameable one poisons all of
// them. This is the case the old annotation claimed to catch and did not.
test fn the_dark_install_refuses_a_revision_that_is_not_a_revision() -> Bool {
  dark_install_refuses(read: probe_answered(body: join([
    "{\"", running_release_revision_key, "\":\"main\"}",
  ], "")))
}

// SOMETHING ELSE ON THE PORT. During the cutover two gunbc processes and a front door are all live
// on one host; a well-formed answer from the wrong thing must not be read as this broker.
test fn the_dark_install_refuses_a_body_that_is_not_the_liveness_document() -> Bool {
  dark_install_refuses(read: probe_answered(body: "[1,2,3]"))
    && dark_install_refuses(read: probe_answered(body: "{\"live\":true}"))
}

// THE POSITIVE CONTROL. Without it every claim above is satisfiable by a fold that refuses
// everything -- which is the same defect as one that admits everything, wearing the other sign.
test fn the_dark_install_admits_a_broker_that_named_its_release() -> Bool {
  match dark_install_release_discharged(
    listening_port: approval_broker_dark_listen_port,
    read: probe_answered(body: cutover_fixture_liveness_body),
  ) {
    StageAdmitted { stage: _ } => true
    StageRefused { stage: _, cause: _ } => false
  }
}

// THE PROBE DECIDES WHETHER A UNIT IS LISTENING, NOT THE CALLER'S PORT ARGUMENT. The evidence used
// to carry DarkUnitListening built from the port the deploy intended to use, which restated "we
// asked systemd to start one" as "one is listening".
test fn an_unanswered_probe_reports_the_unit_as_not_started() -> Bool {
  let e = dark_install_evidence(
    listening_port: approval_broker_dark_listen_port,
    read: serve_liveness_read_from_probe(success: false, body: "", error: "no route to host" as NonEmptyStr),
  )
  match e.dark {
    DarkUnitNotStarted { detail: _ } => true
    DarkUnitListening { port: _ } => false
  }
}

// ── ADMISSION AND DISCHARGE ARE DIFFERENT QUESTIONS, AND THE FOLD MUST NOT MERGE THEM ────────
// With the dark deployment observed and nothing else, a caller MAY attempt the release readback and
// has NOT discharged it. A single fold answering both is how the production gate came to be green.
test fn a_stage_may_be_admitted_and_undischarged() -> Bool {
  let full = everything_observed()
  let e = ApprovalBrokerCutoverEvidence {
    dark: full.dark,
    release_readback: release_readback_from_livez(body: ""),
    demand: DemandUnmeasured { missing: "not taken" as NonEmptyStr },
    front_door: FrontDoorPointsAtRoadmap,
    confirm_probe: RouteClassUnprobed,
    decide_probe: RouteClassUnprobed,
    submit_probe: RouteClassUnprobed,
    status_probe: RouteClassUnprobed,
  }
  stage_is_admitted(stage: ProveRelease, e: e)
    && match approval_broker_cutover_stage_discharged(stage: ProveRelease, e: e) {
      StageRefused { stage: _, cause: c } => match c {
        ReleaseUnreadable { detail: _ } => true
        _ => false
      }
      StageAdmitted { stage: _ } => false
    }
}
