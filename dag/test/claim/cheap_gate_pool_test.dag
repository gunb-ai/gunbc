module test.claim.cheap_gate_pool

import tools.cheap_gate_pool {
  ClaimRun,
  cheap_claim_pool_claims,
  cheap_pool_chunked_claims,
  chunk_claims,
  claims_covered_by_cheap_pool_chunks,
  claim_in_pool,
  cheap_gate_pool_max_claims_per_child
}
import tools.layering_imports_transport { layering_imports_claims }
import tools.extdeps_external_authority_transport { extdeps_external_authority_claims }
import std.logic { Bool }

test fn cheap_pool_chunk_totality_holds() -> Bool {
  claims_covered_by_cheap_pool_chunks(claims: layering_imports_claims())
    && claims_covered_by_cheap_pool_chunks(claims: extdeps_external_authority_claims())
}

test fn cheap_pool_chunking_preserves_count() -> Bool {
  length(cheap_pool_chunked_claims()) == length(cheap_claim_pool_claims())
}

test fn cheap_pool_chunk_totality_red_control_holds() -> Bool {
  let bogus = ClaimRun {
    entry: "dag/test/claim/__no_such_entry_zzz.dag",
    function: "no_such_claim_zzz"
  }
  !claims_covered_by_cheap_pool_chunks(claims: [bogus])
}

test fn cheap_pool_chunk_cap_splits_at_cap() -> Bool {
  let a = ClaimRun { entry: "a.dag", function: "f1" }
  let b = ClaimRun { entry: "a.dag", function: "f2" }
  let c = ClaimRun { entry: "b.dag", function: "g" }
  let chunks = chunk_claims(claims: [a, b, c], max_per_child: 2)
  length(chunks) == 2
    && claim_in_pool(c: c, pool: chunks.skip(n: 1).first())
    && cheap_gate_pool_max_claims_per_child > 0
}
