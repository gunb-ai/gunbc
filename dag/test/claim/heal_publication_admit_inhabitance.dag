module test.claim.heal_publication_admit_inhabitance

// INHABITANCE (DESIGN 3, the pairing obligation for heal publisher admit). The credential-free admit
// observation (gunbc.heal_publication.observe_candidate_world_wet) answers head liveness with a live
// `git ls-remote` of refs/pull/<n>/head and the base tree with a single-ref `git fetch` into an isolated
// store read by local plumbing. This claim runs that EXACT primitive route -- the same operations, the
// same arguments, the same decoder -- against the real PUBLIC gunb-ai/gunbc repository, over the real
// transport, with NO credential in the environment, once. It witnesses that the route is inhabitated:
// if any of these operations were re-declared to require auth, or the transport could not answer
// anonymously, this claim fails -- so deleting or re-authing the integration cannot leave the suite
// green. It is a WET lane (network + host effects), run explicitly under `gunbc run --function`, not a
// --claim-run (which refuses host effects). The deterministic LOGIC pair is the hermetic boundary
// witness (heal_publication_boundary_witness.dag), whose HeadMoved / repository / base arms refuse on
// disagreement; this claim is the transport half, the witness is the shape half.

import extdeps.git
import extdeps.git.plumbing { GitWorktreeAt, GitDirectoryAt }
import extdeps.shell
import extdeps.git.object_store { git_object_id_wire_hex, git_object_id_from_untagged_hex, git_decode_ls_files_stage_z, GitLsFilesStageZDecoded, GitLsFilesStageZRefused, git_path_octets, git_ascii_field_text, GitObjectFormatSha1 }
import std.bytes { utf8_encode_bytes }
import std.algebra { trim }
import std.optional { Present, Absent }
import std.process { ProcessExit, ExitSuccess, exit_failure }

data inhabitant_public_url: String = "https://github.com/gunb-ai/gunbc.git"
data inhabitant_ref_name: String = "refs/pull/15670/head"
data inhabitant_expected_path: String = "dag/gunbc/heal_publication.dag"

fn git_ascii(octets: List<Int>) -> String {
  match git_ascii_field_text(octets: octets) { Present { value: text } => text as String  Absent => "" }
}

fn inhabitance_run() -> ProcessExit {
  let mk = shell.Mktemp.Dir()
  if !mk.success { return exit_failure(reason: "inhabitance: could not allocate the isolated store") }
  let store = mk.path
  if git.Plumbing.InitBareAt(address: GitWorktreeAt { path: store }, path: store).exit_code != 0 {
    return exit_failure(reason: "inhabitance: could not initialise the isolated store")
  }
  let ls = git.Core.LsRemoteRefInRepo(repo: store, remote: inhabitant_public_url, ref_name: inhabitant_ref_name)
  if ls.exit_code != 0 { return exit_failure(reason: concat("inhabitance: anonymous ls-remote refused: ", ls.stderr)) }
  let live = match (match split(s: trim(s: ls.advertised), delimiter: "\t").first() { Absent => none  Present { value: wire } => git_object_id_from_untagged_hex(hex: wire) }) {
    Present { value: oid } => git_object_id_wire_hex(oid: oid) as String
    Absent => return exit_failure(reason: "inhabitance: ls-remote advertised no decodable head -- the anonymous transport did not answer")
  }
  let fetched = git.Core.FetchForcedRefInRepo(repo: store, remote: inhabitant_public_url, refspec: concat("+", inhabitant_ref_name, ":refs/heal-publisher/candidate-head"))
  if fetched.exit_code != 0 { return exit_failure(reason: concat("inhabitance: anonymous single-ref fetch refused: ", fetched.stderr)) }
  if git.Plumbing.ReadTreeIntoIndex(address: GitDirectoryAt { path: store, run_in: store }, index: concat(store as String, "/index") as FilePath, treeish: live).exit_code != 0 {
    return exit_failure(reason: "inhabitance: read-tree of the fetched commit refused")
  }
  let written = git.Plumbing.WriteTreeFromIndex(address: GitDirectoryAt { path: store, run_in: store }, index: concat(store as String, "/index") as FilePath)
  match git_object_id_from_untagged_hex(hex: trim(s: written.tree)) { Absent => return exit_failure(reason: "inhabitance: the fetched head has no decodable tree")  Present { value: _ } => true }
  let staged = git.Core.LsFilesStageZInRepo(repo: store)
  if !staged.success { return exit_failure(reason: "inhabitance: ls-files --stage refused") }
  match git_decode_ls_files_stage_z(payload: utf8_encode_bytes(s: staged.raw), format: GitObjectFormatSha1) {
    GitLsFilesStageZRefused { cause: _ } => exit_failure(reason: "inhabitance: the staged file set did not decode")
    GitLsFilesStageZDecoded { entries } =>
      let paths = map(entries, e => git_ascii(octets: git_path_octets(path: e.path)))
      if count(entries) <= 0 { return exit_failure(reason: "inhabitance: the fetched tree listed no entries") }
      if count(filter(paths, p => p == inhabitant_expected_path)) <= 0 {
        return exit_failure(reason: concat("inhabitance: the fetched tree did not contain ", inhabitant_expected_path))
      }
      ExitSuccess
  }
}
