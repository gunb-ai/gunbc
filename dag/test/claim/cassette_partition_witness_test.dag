module test.claim.cassette_partition_witness
import std.types {Bool}
import product.printed_chassis.cassette_profiles {mt_jade_profile,gh200_p4261_profile,altra_profile}
import product.printed_chassis.cassette_layout {partition_profile,TrayPartitionKnown,TrayPartitionInvalid,TrayPartitionNeedsOutline}
test fn jade_partition_accounts_for_margins_and_feature_budget() -> Bool {
 match partition_profile(profile:mt_jade_profile,edge_margin_um:14000,bed_um:180000,feature_budget_um:30000) {
 TrayPartitionKnown {partition:p}=>p.columns==4 && p.rows==4 && count(p.cells)==16 && count(p.edges)==24 && all(p.cells,c=>c.x1_um-c.x0_um+30000<=180000 && c.z1_um-c.z0_um+30000<=180000) && fold(p.cells,init:0,f:(a,c)=>a+(c.x1_um-c.x0_um)*(c.z1_um-c.z0_um))==456000*507360
 TrayPartitionInvalid=>false TrayPartitionNeedsOutline=>false
 }
}
test fn altra_partition_stays_four_cells_and_unknown_board_refuses() -> Bool {
 let a=match partition_profile(profile:altra_profile,edge_margin_um:14000,bed_um:180000,feature_budget_um:30000) {TrayPartitionKnown {partition:p}=>count(p.cells)==4 && count(p.edges)==4 TrayPartitionInvalid=>false TrayPartitionNeedsOutline=>false}
 let u=match partition_profile(profile:gh200_p4261_profile,edge_margin_um:14000,bed_um:180000,feature_budget_um:30000) {TrayPartitionKnown {partition:_}=>false TrayPartitionInvalid=>false TrayPartitionNeedsOutline=>true}
 let b=match partition_profile(profile:altra_profile,edge_margin_um:14000,bed_um:180000,feature_budget_um:180000) {TrayPartitionKnown {partition:_}=>false TrayPartitionInvalid=>true TrayPartitionNeedsOutline=>false}
 a && u && b
}
