module test.claim.regional_compute_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// Answers the operator's wage-intuition question by execution over cited rows: is compute cheaper where wages are lower? Every claim below is derived from the two machine-readable price authorities with the SKU held fixed per provider, so a difference is a region fact. The headline is a totality claim -- no sampled region is cheaper than its provider's US baseline -- which is the shape that would break loudly if a future re-pull found one, rather than a single-region spot check that could stay true while the thesis rotted.
fn premium_bp_of(baseline: RegionalComputeRow, region: RegionalComputeRow) -> std.nat.Nat? {
  match gunbc.econ.regional_compute_premium.derive_regional_premium(baseline: baseline, region: region) {
    gunbc.econ.regional_compute_premium.RegionalPremiumDerived { premium_bp: bp } => Present { value: std.measure.basis_point_count(bp: bp) }
    gunbc.econ.regional_compute_premium.RegionalPremiumRefused { cause: _ } => none
  }
}

fn w_premium_at_least(baseline: RegionalComputeRow, region: RegionalComputeRow, floor_bp: std.nat.Nat) -> Bool {
  match premium_bp_of(baseline: baseline, region: region) {
    Present { value: bp } => bp >= floor_bp
    _ => false
  }
}

test fn w_no_aws_region_is_cheaper_than_us_east() -> Bool {
  w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_ap_south_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_eu_central_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_me_central_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_ap_southeast_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_ap_northeast_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_me_south_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_af_south_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_ap_east_1, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_sa_east_1, floor_bp: 1)
}

test fn w_no_azure_region_is_cheaper_than_east_us() -> Bool {
  w_premium_at_least(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_centralindia, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_southindia, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_uaenorth, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_southafricanorth, floor_bp: 1)
    && w_premium_at_least(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_brazilsouth, floor_bp: 1)
}

test fn w_brazil_premium_agrees_across_two_independent_providers() -> Bool {
  match premium_bp_of(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_sa_east_1) {
    Present { value: aws_bp } =>
      match premium_bp_of(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.azure_brazilsouth) {
        Present { value: azure_bp } =>
          (aws_bp == 5937) && (azure_bp == 5937)
        _ => false
      }
    _ => false
  }
}

test fn w_india_is_the_smallest_premium_and_south_america_the_largest() -> Bool {
  match premium_bp_of(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_ap_south_1) {
    Present { value: mumbai } =>
      match premium_bp_of(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_sa_east_1) {
        Present { value: saopaulo } =>
          match premium_bp_of(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_af_south_1) {
            Present { value: capetown } =>
              (mumbai == 520) && (saopaulo == 5937) && (mumbai < capetown) && (capetown < saopaulo)
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn w_geography_axis_is_populated_across_all_requested_regions() -> Bool {
  extdeps.pricing.regional_compute.geography_eq(a: aws_ap_south_1.geography, b: extdeps.pricing.regional_compute.SouthAsia)
    && extdeps.pricing.regional_compute.geography_eq(a: aws_af_south_1.geography, b: extdeps.pricing.regional_compute.Africa)
    && extdeps.pricing.regional_compute.geography_eq(a: aws_sa_east_1.geography, b: extdeps.pricing.regional_compute.SouthAmerica)
    && extdeps.pricing.regional_compute.geography_eq(a: aws_me_central_1.geography, b: extdeps.pricing.regional_compute.MiddleEast)
    && extdeps.pricing.regional_compute.geography_eq(a: azure_southafricanorth.geography, b: extdeps.pricing.regional_compute.Africa)
    && extdeps.pricing.regional_compute.geography_eq(a: azure_brazilsouth.geography, b: extdeps.pricing.regional_compute.SouthAmerica)
}

test fn w_per_vcpu_month_is_derived_within_one_currency() -> Bool {
  match gunbc.econ.regional_compute_premium.per_vcpu_month_micros(row: extdeps.pricing.regional_compute.aws_us_east_1) {
    Present { value: virginia } =>
      match gunbc.econ.regional_compute_premium.per_vcpu_month_micros(row: extdeps.pricing.regional_compute.aws_sa_east_1) {
        Present { value: saopaulo } =>
          (virginia == 36792000) && (saopaulo == 58637250) && (saopaulo > virginia)
        _ => false
      }
    _ => false
  }
}

test fn w_red_cross_provider_premium_refuses() -> Bool {
  match gunbc.econ.regional_compute_premium.derive_regional_premium(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.azure_brazilsouth) {
    gunbc.econ.regional_compute_premium.RegionalPremiumRefused { cause: gunbc.econ.regional_compute_premium.ProviderMismatch } => true
    _ => false
  }
}

test fn w_red_unreadable_local_provider_rates_refuse() -> Bool {
  match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.e2e_networks_india) {
    Present { value: _ } => false
    _ =>
      match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.magalu_cloud_brazil) {
        Present { value: _ } => false
        _ =>
          match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.afrihost_south_africa) {
            Present { value: _ } => false
            _ =>
              match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.alibaba_cloud_asia) {
                Present { value: _ } => false
                _ =>
                  match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.contabo_global) {
                    Present { value: _ } => false
                    _ => true
                  }
              }
          }
      }
  }
}

test fn w_red_unrepresentable_currency_refuses_distinctly() -> Bool {
  match extdeps.pricing.regional_compute.hourly_micros(row: extdeps.pricing.regional_compute.sakura_japan_vps) {
    Present { value: _ } => false
    _ =>
      match gunbc.econ.regional_compute_premium.derive_regional_premium(baseline: extdeps.pricing.regional_compute.azure_eastus, region: extdeps.pricing.regional_compute.sakura_japan_vps) {
        gunbc.econ.regional_compute_premium.RegionalPremiumRefused { cause: gunbc.econ.regional_compute_premium.ProviderMismatch } => true
        _ => false
      }
  }
}

test fn w_red_premium_against_an_unpriced_region_refuses() -> Bool {
  match gunbc.econ.regional_compute_premium.derive_regional_premium(baseline: extdeps.pricing.regional_compute.aws_us_east_1, region: extdeps.pricing.regional_compute.aws_us_east_1) {
    gunbc.econ.regional_compute_premium.RegionalPremiumDerived { premium_bp: bp } =>
      (std.measure.basis_point_count(bp: bp) == 0)
        && match gunbc.econ.regional_compute_premium.derive_regional_premium(baseline: extdeps.pricing.regional_compute.e2e_networks_india, region: extdeps.pricing.regional_compute.e2e_networks_india) {
          gunbc.econ.regional_compute_premium.RegionalPremiumRefused { cause: gunbc.econ.regional_compute_premium.BaselineRateUnavailable } => true
          _ => false
        }
    _ => false
  }
}

