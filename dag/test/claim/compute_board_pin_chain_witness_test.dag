module test.claim.compute_board_pin_chain_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn admitted() -> product.compute_board.admission.AdmittedBoardPowerInterfaceArticle? {
  match product.compute_board.admission.admit_board_article(a: power_interlock_article) {
    BoardArticleAdmitted { article: adm } => Present { value: adm }
    BoardArticleRefused { causes: _ } => none
  }
}

fn project(
  bindings: List<product.compute_board.verilog_projection.VerilogBinding>,
  assignments: List<product.compute_board.device_binding.DevicePinAssignment>
) -> String {
  match test.claim.compute_board_pin_chain_witness.admitted() {
    Absent => "NOT-ADMITTED"
    Present { value: adm } =>
      match project_article_to_pin_constraints(
        admitted: adm,
        realization: interlock_device_realization,
        bindings: bindings,
        assignments: assignments
      ) {
        PinConstraintsEmitted { receipt: r } => r.source
        PinConstraintsRefused { causes: _ } => "REFUSED"
      }
  }
}

// THE EXACT BYTES nextpnr WAS GIVEN. Full equality rather than a substring probe: a constraint
// file with an extra line places a port nobody asked for, and one with a missing line leaves a
// port for the tool to place wherever it likes — both pass a substring check.
data expected_pin_constraints: String = "set_io conditioned_good 1\nset_io fault 2\nset_io power_permit 3\nset_io reset_release 4\n"

test fn w_the_production_pin_constraints_emit_exact_bytes() -> Bool {
  let emitted = test.claim.compute_board_pin_chain_witness.project(bindings: power_interlock_verilog_bindings, assignments: interlock_pin_assignments)
  emitted == expected_pin_constraints
}

// THE PORT NAME COMES FROM THE VERILOG TABLE, and this is what proves it rather than the comment
// saying so. Perturbing one spelling in the binding table must move the constraint file with it;
// if the two were independently authored, this would pass while the real design placed a port
// the module does not declare.
data respelled_bindings: List<product.compute_board.verilog_projection.VerilogBinding> = [
  product.compute_board.verilog_projection.VerilogBinding { signal: "board_power_interlock" as product.compute_board.digital_control.SignalName, symbol: ^interlock_module_name, spelling: "board_power_interlock" },
  product.compute_board.verilog_projection.VerilogBinding { signal: conditioned_good_signal, symbol: ^interlock_conditioned_good, spelling: "cond_good_renamed" },
  product.compute_board.verilog_projection.VerilogBinding { signal: fault_signal, symbol: ^interlock_fault, spelling: "fault" },
  product.compute_board.verilog_projection.VerilogBinding { signal: power_permit_signal, symbol: ^interlock_power_permit, spelling: "power_permit" },
  product.compute_board.verilog_projection.VerilogBinding { signal: reset_release_signal, symbol: ^interlock_reset_release, spelling: "reset_release" },
]

test fn w_a_respelled_port_moves_the_constraint_file() -> Bool {
  let respelled = test.claim.compute_board_pin_chain_witness.project(bindings: respelled_bindings, assignments: interlock_pin_assignments)
  respelled != expected_pin_constraints
    && respelled == "set_io cond_good_renamed 1\nset_io fault 2\nset_io power_permit 3\nset_io reset_release 4\n"
}

fn refusal_is(r: product.compute_board.device_binding.PinChainRefusal, wanted: String) -> Bool {
  match r {
    PinNotOnPackage { signal: _, pin: _ } => wanted == "PinNotOnPackage"
    PinAssignedToSeveralSignals { pin: _ } => wanted == "PinAssignedToSeveralSignals"
    SignalAssignedToSeveralPins { signal: _ } => wanted == "SignalAssignedToSeveralPins"
    AssignedSignalNotDeclared { signal: _ } => wanted == "AssignedSignalNotDeclared"
    DeclaredSignalHasNoPin { signal: _ } => wanted == "DeclaredSignalHasNoPin"
    SignalHasNoTargetSpelling { signal: _ } => wanted == "SignalHasNoTargetSpelling"
    ConstraintNotEmittable { reason: _ } => wanted == "ConstraintNotEmittable"
  }
}

fn refuses_naming(assignments: List<product.compute_board.device_binding.DevicePinAssignment>, wanted: String) -> Bool {
  match test.claim.compute_board_pin_chain_witness.admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_pin_constraints(
        admitted: adm,
        realization: interlock_device_realization,
        bindings: power_interlock_verilog_bindings,
        assignments: assignments
      ) {
        PinConstraintsEmitted { receipt: _ } => false
        PinConstraintsRefused { causes: cs } =>
          fold(concat([cs.first], cs.rest), init: false, f: fn(acc, r) { acc || test.claim.compute_board_pin_chain_witness.refusal_is(r: r, wanted: wanted) })
      }
  }
}

// Pin 5 is absent from the TQ144 roster — the package numbers 144 positions and only 96 of them
// are placeable I/O, so a plausible-looking number is exactly the kind that gets authored.
test fn w_a_pin_the_package_does_not_have_refuses() -> Bool {
  roster_admits_pin(r: icestorm_hx1k_tq144_roster, pin: "1")
    && !roster_admits_pin(r: icestorm_hx1k_tq144_roster, pin: "5")
    && test.claim.compute_board_pin_chain_witness.refuses_naming(
      assignments: [
        product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "5" },
        product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "2" },
        product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
        product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
      ],
      wanted: "PinNotOnPackage"
    )
}

// Two signals on one pin is a short at the package boundary; place-and-route would refuse it, but
// only after an artifact has been generated and handed over.
test fn w_two_signals_on_one_pin_refuse() -> Bool {
  test.claim.compute_board_pin_chain_witness.refuses_naming(
    assignments: [
      product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
      product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "1" },
      product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
      product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
    ],
    wanted: "PinAssignedToSeveralSignals"
  )
}

// One signal on two pins is not a short — it is an AMBIGUITY, and the emitter would resolve it by
// list order. A verdict decided by which row was authored first is the accident this repository
// has now closed in four places.
test fn w_one_signal_on_two_pins_refuses() -> Bool {
  test.claim.compute_board_pin_chain_witness.refuses_naming(
    assignments: [
      product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
      product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "7" },
      product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "2" },
      product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
      product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
    ],
    wanted: "SignalAssignedToSeveralPins"
  )
}

test fn w_a_pin_for_a_signal_the_article_never_declared_refuses() -> Bool {
  test.claim.compute_board_pin_chain_witness.refuses_naming(
    assignments: [
      product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
      product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "2" },
      product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
      product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
      product.compute_board.device_binding.DevicePinAssignment { signal: "phantom_signal" as product.compute_board.digital_control.SignalName, pin: "7" },
    ],
    wanted: "AssignedSignalNotDeclared"
  )
}

// THE MISSING DIRECTION. Every check above walks the assignments, and no walk over assignments
// can see a signal nobody assigned — the emitted file would simply not mention it and the tool
// would place it somewhere. This is the arm that needs the opposite walk.
test fn w_a_declared_signal_with_no_pin_refuses() -> Bool {
  test.claim.compute_board_pin_chain_witness.refuses_naming(
    assignments: [
      product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
      product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "2" },
      product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
    ],
    wanted: "DeclaredSignalHasNoPin"
  )
}

// An empty assignment list refuses once per declared signal rather than once overall: four
// missing pins are four defects, and collapsing them into one cause would hide three of them.
test fn w_every_unassigned_signal_is_its_own_cause() -> Bool {
  match test.claim.compute_board_pin_chain_witness.admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_pin_constraints(
        admitted: adm,
        realization: interlock_device_realization,
        bindings: power_interlock_verilog_bindings,
        assignments: []
      ) {
        PinConstraintsEmitted { receipt: _ } => false
        PinConstraintsRefused { causes: cs } => pin_refusal_set_count(s: cs) == 4
      }
  }
}

// ONE COLLISION IS ONE CAUSE. Two assignments sharing a pin is a single defect at a single pin,
// and an earlier revision filed it once per participating row — so the cause count reported how
// many assignments touched the collision rather than how many collisions there were. Counting is
// what makes that visible: naming the cause passes either way.
test fn w_a_doubled_pin_is_reported_once() -> Bool {
  match test.claim.compute_board_pin_chain_witness.admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_pin_constraints(
        admitted: adm,
        realization: interlock_device_realization,
        bindings: power_interlock_verilog_bindings,
        assignments: [
          product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
          product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "1" },
          product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
          product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
        ]
      ) {
        PinConstraintsEmitted { receipt: _ } => false
        PinConstraintsRefused { causes: cs } => pin_refusal_set_count(s: cs) == 1
      }
  }
}

// The mirror, and it is NOT symmetric with the one above: one signal on two pins leaves that
// signal assigned, so nothing else fires, but the doubled ROW is still one ambiguity rather than
// two. Both directions are counted because a deduplication that only ran on one axis would pass
// the test above and still double-report here.
test fn w_a_doubled_signal_is_reported_once() -> Bool {
  match test.claim.compute_board_pin_chain_witness.admitted() {
    Absent => false
    Present { value: adm } =>
      match project_article_to_pin_constraints(
        admitted: adm,
        realization: interlock_device_realization,
        bindings: power_interlock_verilog_bindings,
        assignments: [
          product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "1" },
          product.compute_board.device_binding.DevicePinAssignment { signal: conditioned_good_signal, pin: "7" },
          product.compute_board.device_binding.DevicePinAssignment { signal: fault_signal, pin: "2" },
          product.compute_board.device_binding.DevicePinAssignment { signal: power_permit_signal, pin: "3" },
          product.compute_board.device_binding.DevicePinAssignment { signal: reset_release_signal, pin: "4" },
        ]
      ) {
        PinConstraintsEmitted { receipt: _ } => false
        PinConstraintsRefused { causes: cs } => pin_refusal_set_count(s: cs) == 1
      }
  }
}

// TWO AUTHORITIES, PRODUCED INDEPENDENTLY, AGREEING ON A POPULATION. Lattice's per-bank table for
// the HX1K in TQ144 gives 23 + 25 + 20 + 24 general-purpose pins and four configuration pins;
// Project IceStorm's roster, reverse-engineered from the bitstream format, carries 96 designators.
// Neither was derived from the other, so this is evidence rather than bookkeeping — and it is
// derived from both rather than pinned to a literal, so it cannot be kept true by editing one.
test fn w_the_vendor_and_the_toolchain_agree_on_the_pin_population() -> Bool {
  bank_population_general_purpose(p: ice40_hx1k_tq144_banks) == 92
    && bank_population_total(p: ice40_hx1k_tq144_banks) == 96
    && roster_pin_count(r: icestorm_hx1k_tq144_roster) == 96
    && realization_populations_agree(realization: interlock_device_realization)
}

// The device and package facts are the ones a board reproduces: a 0.5 mm pitch on a 20 mm body is
// what the footprint has to match, and a wrong pitch is a board that cannot be assembled.
test fn w_the_package_carries_the_facts_a_footprint_needs() -> Bool {
  (ice40_hx1k.ordering_part_number as String) == "ICE40HX1K-TQ144"
    && (ice40_tq144_package.designator as String) == "TQ144"
    && micrometer_count(m: ice40_tq144_package.contact_pitch) == 500
    && micrometer_count(m: ice40_tq144_package.body_width) == 20000
    && ice40_tq144_package.contact_count == 144
}

// THE COUNT IS ONLY EVIDENCE IF THE ROWS ARE DISTINCT. The vendor-and-toolchain agreement above
// compares 96 against 96, and a duplicated designator would hold that count while the real
// population shrank — the roster would agree with Lattice about a number and disagree about the
// package. Every designator is asserted to appear exactly once, which is what makes the agreement
// a join rather than an arithmetic coincidence.
test fn w_no_package_position_is_listed_twice() -> Bool {
  fold(icestorm_hx1k_tq144_roster.pins, init: true, f: fn(acc, p) {
    acc && roster_pin_occurrences(r: icestorm_hx1k_tq144_roster, pin: p) == 1
  })
}

// THE JOIN NAMES WHAT IT COMPARES. The previous form was two bare Ints that both happened to be
// 96, from two documents that never said they counted the same things — evidence of a coincidence
// rather than of agreement. This asserts the comparison lands on the AGREE arm specifically, so a
// change that made the two populations incomparable could no longer read as a passing test.
test fn w_the_population_agreement_names_its_kind() -> Bool {
  match realization_population_comparison(realization: interlock_device_realization) {
    PopulationsAgree { kind: k, count: c } => c == 96
    PopulationsDisagree { kind: _, left: _, right: _ } => false
    PopulationsNotComparable { left: _, right: _ } => false
  }
}

// AND COMPARING UNLIKE POPULATIONS IS NOT FALSE, IT IS UNANSWERABLE. A false would claim the
// device disagrees with itself; the truth is that 144 package leads and 96 placeable pins are
// different questions, and nothing has stated the projection between them. Different states,
// different remedies, different arms.
test fn w_unlike_populations_refuse_rather_than_disagreeing() -> Bool {
  let leads = product.compute_board.contact_population.ContactPopulation { kind: AllPackageLeads, count: 144, authority: "package drawing" }
  let placeable = product.compute_board.contact_population.ContactPopulation { kind: PlaceableLogicPins, count: 96, authority: "IceStorm roster" }
  match compare_populations(a: leads, b: placeable) {
    PopulationsNotComparable { left: _, right: _ } => true
    PopulationsAgree { kind: _, count: _ } => false
    PopulationsDisagree { kind: _, left: _, right: _ } => false
  }
}

// THE THIRD COUNT RECONCILED, BY READING THE CURRENT DOCUMENT. The product table's 98 was carried
// as an open contradiction against the data sheet's 96 while this repository cited a 2017 revision
// that lacked the row relating them. The February 2025 revision states both terms, and 96 + 2 is
// 98 exactly. This asserts the arithmetic through the declared projection rather than restating
// the sum, so a projection that stopped naming those two kinds would stop passing.
test fn w_the_vendor_total_reconciles_through_a_declared_projection() -> Bool {
  let se = product.compute_board.contact_population.ContactPopulation { kind: VendorGeneralPurposeSingleEndedIo, count: 96, authority: "FPGA-DS-02029-4.3" }
  let ded = product.compute_board.contact_population.ContactPopulation { kind: VendorDedicatedIo, count: 2, authority: "FPGA-DS-02029-4.3" }
  match project_population(p: vendor_total_io_from_datasheet_rows, parts: [se, ded]) {
    Absent => false
    Present { value: total } =>
      total.count == 98
        && (population_kind_name(k: total.kind) as String) == "vendor total I/O"
  }
}

// AND A PROJECTION ONLY ADMITS THE KINDS IT NAMES. Without this the test above is satisfied by a
// projection that sums whatever it is handed, which would make the declared from_kinds decorative
// and let two unrelated populations add to a plausible total.
test fn w_the_projection_refuses_a_population_it_does_not_admit() -> Bool {
  let se = product.compute_board.contact_population.ContactPopulation { kind: VendorGeneralPurposeSingleEndedIo, count: 96, authority: "FPGA-DS-02029-4.3" }
  let leads = product.compute_board.contact_population.ContactPopulation { kind: AllPackageLeads, count: 144, authority: "FPGA-DS-02029-4.3" }
  match project_population(p: vendor_total_io_from_datasheet_rows, parts: [se, leads]) {
    Absent => true
    Present { value: _ } => false
  }
}

// THE GAP THAT REPLACED IT, executed against the document's own partition rather than asserted.
// The classes the Pin Information Summary names sum to 143 for this column while the same table's
// Total Count of Bonded Pins reads 144, so one contact is in no class the document names. The
// VQ100 column is the control: read from the same rows by the same method, it cross-foots exactly,
// which is what distinguishes a property of the document from a mistake in the reading.
test fn w_the_bonded_pin_itemization_falls_one_short_and_says_so() -> Bool {
  let itemized = itemized_contact_total(i: ice40_hx1k_tq144_contacts)
  let control = itemized_contact_total(i: ice40_hx1k_vq100_contacts)
  itemized == 143
    && ice40_hx1k_tq144_contacts.declared_bonded_pins == 144
    && control == ice40_hx1k_vq100_contacts.declared_bonded_pins
    && gap_is_open(g: ice40_hx1k_tq144_io_count_gap)
    && citation_is_current(c: ice40_hx1k_tq144_io_count_gap.citation_currency)
    && fold(ice40_hx1k_tq144_io_count_gap.unreconciled, init: false, f: fn(acc, p) {
      acc || (p.count == 144 && (population_kind_name(k: p.kind) as String) == "all package leads")
    })
}

// THE DIFFERENTIAL INPUTS ARE NOT ADDED, and this is what says so. They are the same contacts as
// twelve of the general-purpose single-ended ones, counted a second time by capability, so a
// partition including them would exceed the package. The itemisation excludes them; adding them
// would overshoot the declared total rather than reaching it.
test fn w_the_differential_recount_is_excluded_from_the_partition() -> Bool {
  ice40_hx1k_tq144_contacts.differential_inputs_subset == 12
    && (itemized_contact_total(i: ice40_hx1k_tq144_contacts) +
        ice40_hx1k_tq144_contacts.differential_inputs_subset) > ice40_hx1k_tq144_contacts.declared_bonded_pins
}

// THE DISCRIMINANT IS DISTINCT PER KIND, asserted over the enumerated kind list rather than over
// a count. Kind equality decides whether two populations may be compared at all, so two kinds
// sharing a tag would silently fuse two populations that count different things - which is the
// exact failure this module exists to prevent, reappearing one level down in the mechanism meant
// to prevent it. The pairwise walk is over identity, not cardinality: a roster that grew a
// duplicate entry would still have to produce two equal tags to pass.
test fn w_every_population_kind_has_a_distinct_discriminant() -> Bool {
  fold(all_contact_population_kinds, init: true, f: fn(acc, a) {
    acc && fold(all_contact_population_kinds, init: 0, f: fn(n, b) {
      if population_kinds_equal(a: a, b: b) { n + 1 } else { n }
    }) == 1
  })
}

// AND EQUALITY IS NOT SPELLING. Two kinds whose display strings both mention I/O are still
// different kinds; a reader comparing prose would fuse them. This pins the property the tag
// bought by naming a pair that a substring-minded comparison would get wrong.
test fn w_kind_equality_does_not_follow_the_display_prose() -> Bool {
  !population_kinds_equal(a: VendorGeneralPurposeIo, b: VendorGeneralPurposeSingleEndedIo)
    && !population_kinds_equal(a: VendorTotalIo, b: VendorDedicatedIo)
    && population_kinds_equal(a: PlaceableLogicPins, b: PlaceableLogicPins)
    && population_kind_tag(k: SupplyContacts) != population_kind_tag(k: ReturnContacts)
}
