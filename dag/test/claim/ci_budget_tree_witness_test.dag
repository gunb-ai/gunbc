module test.claim.ci_budget_tree_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

fn fitting_slice() -> Int {
  53687091200
}

fn oversized_slice() -> Int {
  214748364800
}

fn witness_live_trees_conserve() -> Bool {
  product.budget_tree.node_conserves(node: gunbc.ci_budget_tree.srv1_budget_tree)
    && product.budget_tree.node_conserves(node: gunbc.ci_budget_tree.srv2_budget_tree)
    && product.budget_tree.node_conserves(node: gunbc.ci_budget_tree.srv3_budget_tree)
}

fn witness_live_is_fail_closed() -> Bool {
  std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_gha_runner_pool_budget()) == 0
    && std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_dashboard_session_pool_budget()) == std.measure.byte_size_count(b: gunbc.ci_budget_tree.host_allocatable_bytes(offer: gunbc.ci_fleet.srv1_offer))
}

fn witness_measured_fixture_derives_positive_runner_pool() -> Bool {
  let tree = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv1", offer: gunbc.ci_fleet.srv1_offer, session_slice: std.measure.byte_size(fitting_slice()))
  let runner_pool = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: tree) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let expected = std.measure.byte_size_count(b: gunbc.ci_budget_tree.host_allocatable_bytes(offer: gunbc.ci_fleet.srv1_offer)) - fitting_slice()
  product.budget_tree.node_conserves(node: tree) && runner_pool > 0 && runner_pool == expected
}

fn witness_overcommit_fails_conservation() -> Bool {
  let tree = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv1", offer: gunbc.ci_fleet.srv1_offer, session_slice: std.measure.byte_size(oversized_slice()))
  let runner_pool = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: tree) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  runner_pool == 0 && !product.budget_tree.node_conserves(node: tree)
}

fn witness_three_way_conservation_live() -> Bool {
  let overhead = std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_fixed_overhead_bytes())
  let gha = std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_gha_runner_pool_budget())
  let dash = std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_dashboard_session_pool_budget())
  overhead + gha + dash <= std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_host_ram())
}

fn witness_srv2_symmetric_to_srv1() -> Bool {
  let s1 = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv1", offer: gunbc.ci_fleet.srv1_offer, session_slice: std.measure.byte_size(fitting_slice()))
  let s2 = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv2", offer: gunbc.ci_fleet.srv2_offer, session_slice: std.measure.byte_size(fitting_slice()))
  let p1 = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: s1) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let p2 = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: s2) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  p1 == p2 && p1 > 0
}

fn witness_two_pools_present() -> Bool {
  let gha_found = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: gunbc.ci_budget_tree.srv1_budget_tree) {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  let dash_found = match gunbc.ci_budget_tree.budget_tree_dashboard_session_pool_node(tree: gunbc.ci_budget_tree.srv1_budget_tree) {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  return gha_found && dash_found
}

fn witness_unknown_child_is_absent() -> Bool {
  match product.budget_tree.budget_child_named(node: gunbc.ci_budget_tree.srv1_budget_tree, name: "__no_such_child__") {
    BudgetChildFound { node: _ } => false
    BudgetChildMissing => true
  }
}

fn witness_spawn_width_budget_within_per_runner_cap() -> Bool {
  let fleet_budget = std.measure.byte_size_count(b: gunbc.ci_runner_target.ci_runner_target_ram_speed_budget(target: gunbc.ci_runner_target.FleetSelfHosted))
  std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_floor_memory_budget()) > 0
    && fleet_budget <= std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_slot_memory_max_live)
    && fleet_budget <= std.measure.byte_size_count(b: gunbc.fleet_host_budget.gunbc_per_runner_memory_cap)
    && fleet_budget < std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_host_ram())
}

fn witness_hard_cap_is_runner_cgroup_cap() -> Bool {
  std.measure.byte_size_count(b: gunbc.ci_budget_tree.srv1_ci_run_container_hard_cap()) == std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap)
}

fn witness_cap_split_runner_lt_session() -> Bool {
  gunbc.ci_floor_measurement.witness_runner_cgroup_cap_lt_dashboard_session_cap()
    && std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_dashboard_session_container_cap) > std.measure.byte_size_count(b: gunbc.ci_floor_measurement.gunbc_ci_runner_cgroup_memory_cap)
}

fn witness_floor_budget_equals_selected_target_budget_holds() -> Bool {
  gunbc.ci_budget_tree.witness_floor_budget_equals_selected_target_budget()
}

fn witness_srv3_symmetric_to_srv1() -> Bool {
  let s1 = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv1", offer: gunbc.ci_fleet.srv1_offer, session_slice: std.measure.byte_size(fitting_slice()))
  let s3 = gunbc.ci_budget_tree.host_budget_tree_at(name: "srv3", offer: gunbc.ci_fleet.srv3_offer, session_slice: std.measure.byte_size(fitting_slice()))
  let p1 = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: s1) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  let p3 = match gunbc.ci_budget_tree.budget_tree_gha_runner_pool_node(tree: s3) {
    BudgetChildFound { node: n } => std.measure.byte_size_count(b: n.appropriation.ceiling)
    BudgetChildMissing => 0
  }
  p1 == p3 && p3 > 0
}

test fn ci_budget_tree_holds() -> Bool {
  witness_live_trees_conserve()
    && witness_live_is_fail_closed()
    && witness_measured_fixture_derives_positive_runner_pool()
    && witness_overcommit_fails_conservation()
    && witness_three_way_conservation_live()
    && witness_srv2_symmetric_to_srv1()
    && witness_srv3_symmetric_to_srv1()
    && witness_two_pools_present()
    && witness_unknown_child_is_absent()
    && witness_spawn_width_budget_within_per_runner_cap()
    && witness_hard_cap_is_runner_cgroup_cap()
    && witness_cap_split_runner_lt_session()
    && witness_floor_budget_equals_selected_target_budget_holds()
}
