  "module sv5.fm_bool_at_fm_int\n\nimport std.types { Int, Bool }\nimport std.algebra { FreeMonoid }\n\nfn takes(x: FreeMonoid<Int>) -> Int {\n  1\n}\n\nfn probe(q: FreeMonoid<Bool>) -> Int {\n  takes(x: q)\n}\n"
}

test fn free_monoid_of_bool_at_a_free_monoid_of_int_formal_must_refuse() -> Bool {
