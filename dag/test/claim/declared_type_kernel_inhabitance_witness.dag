}

// THE HARM, Pinned: the accepted path was not a lint gap but an INTERPRETATION breach -- with
// 'takes(x: Int) -> Int { x }' the chain probe(q: true) through takes(x: q) evaluated Bool(true) at an
// entry declared -> Int (graph:true, zero blocking diagnostics), and the emitted Rust carried
// 'fn probe(q:bool) -> i64 { takes(x: q) }'. The refusal at the argument is what closes it.
fn sv5_harm_through_int_source() -> String {
  "module sv5.harm_through_int\n\nimport std.types { Int, Bool }\n\nfn takes(x: Int) -> Int {\n  x\n}\n\nfn probe(q: Bool) -> Int {\n  takes(x: q)\n}\n\nfn entry() -> Int {\n  probe(q: true)\n}\n"
}

test fn the_bool_through_int_harm_chain_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_harm_through_int_source()) >= 1
}

// A BOOL AT A FLOAT FORMAL: refused. There is NO declared Bool->Float route -- the cast rows carry
// Int<->Float only (std.coercion dag_cast_rules, verbatim: Int->Int, Int->Float, Float->Int,
// Float->Float, Bool->Bool). Accepted before the repair, at zero diagnostics.
fn sv5_bool_at_float_source() -> String {
  "module sv5.bool_at_float\n\nimport std.types { Int, Bool, Float }\n\nfn takes(x: Float) -> Float {\n  x\n}\n\nfn probe(q: Bool) -> Float {\n  takes(x: q)\n}\n"
}

test fn a_bool_variable_at_a_float_formal_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_bool_at_float_source()) >= 1
}

// GREENS -- every acceptance the relation still grants, each by a CITED ROUTE, each measured unchanged
// across the pin. A blanket refusal of variables or of structured values goes red here.

// The declared numeric conversion route Int<->Float (dag_cast_rules): a Float variable at an Int
// formal and an Int at a Float formal both stay admitted.
fn sv5_green_float_var_at_int_source() -> String {
  "module sv5.green_float_var\n\nimport std.types { Int, Float }\n\nfn takes(x: Int) -> Int {\n  x\n}\n\nfn probe(f: Float) -> Int {\n  takes(x: f)\n}\n"
}

test fn a_float_variable_at_an_int_formal_stays_admitted_by_the_declared_cast_route() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_green_float_var_at_int_source()) == 0
}

