// DEPTH IS NOT SPECIAL-CASED, and this is the probe that says so. The repair re-enters the same
// relation rather than peeling a fixed number of levels, so a three-link alias chain is decided by
// the same code as a one-link one. A repair that peeled once would pass the four probes above and
// red here.
test fn kernel_at_chained_alias_declared_return_must_refuse() -> Bool {
  !compile_dag_rust_emit_check(
    alias_inhabitance_chained_alias_fixture_source(),
    "src/ka_chain.rs",
    [],
    []
  )
}

// THE POSITIVE CONTROL. Without it a relation that refused every aliased declaration would satisfy
// all five reds above, and the reds would measure the mechanism rather than the distinction.
test fn conforming_value_through_an_alias_still_compiles() -> Bool {
  compile_dag_rust_emit_check(
    alias_inhabitance_positive_control_source(),
    "src/ka_control.rs",
    [],
    []
  )
}

// THE EXEMPTION CONTROL, and it is the one that would catch the likeliest way to get this wrong. The
// repair follows the alias and then re-applies the relation's own exemptions at the followed name;
// a repair that followed the alias and then judged on the DECLARATION SHAPE alone would newly refuse
// an alias over a kernel type, where the value is perfectly good. Every position the reds above
// cover is carried here with a conforming value at `type KIntAlias = Int`.
test fn kernel_value_at_an_alias_over_that_kernel_still_compiles() -> Bool {
  compile_dag_rust_emit_check(
    alias_over_kernel_positive_control_source(),
    "src/ka_kernel.rs",
    [],
    []
  )
}

// THE APPLIED ALIAS -- `type KAliasG = KGen2<Int>`, an alias whose right-hand side is a type
// APPLICATION rather than a bare name. It is enrolled separately from the bare-name probes above
// because its binding has a different shape: it arrives carrying a CHILD (the argument) where a
// bare-name alias arrives with none, so a repair that keyed on childlessness would pass every probe
// above and red here. Measured: admits before the repair, refuses after.
test fn kernel_at_applied_alias_named_field_must_refuse() -> Bool {
  !compile_dag_rust_emit_check(
    applied_alias_inhabitance_named_field_fixture_source(),
    "src/ka_applied.rs",
    [],
    []
  )
}

// ================================================================================================
// MEASURED SPECIMEN FIVE OF gunbc.recurring_failure_mode.declared_type_wall_keyed_on_the_value_being_a_kernel
// (2026-10-17, node://adhoc-ed047a8d-5b3, pinned pair b97793f4603b -> f907616774e): THE KERNEL
// DECLARED-TYPE RELATION BAILED ON THE PRODUCED VALUE'S RUNTIME SHAPE, so a Bool VARIABLE at a
// scalar formal was ACCEPTED while the `true` LITERAL at the same formal refused. The corpus Bool is
// `type Bool = True | False`: a Bool variable's node carries two children, the literal is a childless
// kernel spelling, and the relation's first bail (`(actual_base.children |> count) > 0`) answered
// `no mismatch` for the variable before any comparison -- one declared type, two verdicts, decided by
// the value's spelling. The bail is withdrawn; the produced side is judged by its declared head name.
// THE NINE REDS below are the eight shapes that flipped ACCEPTED -> REFUSED on the pinned pair (each
// measured twice, seed at the parent and seed at the fix, on the v1-compiler-tests harness whose
// filter is is_interpreter_blocking_diagnostic -- the same blocking predicate the census projects),
// plus the Bool-LITERAL control at the same argument, which was already refusing before the repair
// and is what makes the variable's acceptance a measurement rather than an absent check.
// THE SEVEN GREENS are acceptances unchanged across the pin, each carrying a CITED ROUTE: the declared
// dag_cast_rules rows (Int<->Float), the grounded identity rows of dag/std/coercion.dag (Int->Nat,
// String->FreeMonoid -- the declared text unfold the operator ruled legitimate), name equality through
// an alias, or a same-head application. The oracle counts blocking rows of EITHER refusing class,
// exactly as test.claim.numeral_at_non_numeric_kernel_witness does for the same reason: the wall
// refuses some of these positions as TypeMismatch from the kernel-mismatch arm and others as
// DeclaredTypeNotInhabited from the inhabitance arm, and a RED needs one row while a GREEN needs zero
// of both, which keeps -1 (not runnable) out of both arms.
// ================================================================================================

// The two-class blocking oracle, in the sibling witness's proven idiom. CensusObserved carries the
// whole compile's rows including imported closures, which is why these fixtures import only
// std.types/std.algebra/std.nat -- whose rows are known-clean -- and why a GREEN asserts zero of the
// two SPECIFIC classes rather than zero rows of any class.
fn inhabitance_or_mismatch_blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "DeclaredTypeNotInhabited")))
        + census_total_count(rows: census_blocking_rows(rows: census_rows_of_class(rows: rows, wanted: "TypeMismatch")))
    CensusNotRunnable { cause: _ } => -1
  }
}

// THE SHAPE, AT THE POSITION THE SHIPPED SEED BINARY WAS MEASURED ON (gentle-carp-16, probe for
// gunbc#14152): 'takes(x: q)' with 'q: Bool' compiled with ZERO blocking diagnostics; 'takes(x: true)'
// refused. The refusals at the literal are what make the variable's acceptance a measurement.
fn sv5_arg_bool_var_source() -> String {
  "module sv5.arg_bool_var\n\nimport std.types { Int, Bool }\n\nfn takes(x: Int) -> Int {\n  x\n}\n\nfn probe(q: Bool) -> Int {\n  takes(x: q)\n}\n"
}

test fn a_bool_variable_at_an_int_direct_call_argument_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_arg_bool_var_source()) >= 1
}

fn sv5_arg_bool_literal_source() -> String {
  "module sv5.arg_bool_literal\n\nimport std.types { Int, Bool }\n\nfn takes(x: Int) -> Int {\n  x\n}\n\nfn probe() -> Int {\n  takes(x: true)\n}\n"
}

test fn a_bool_literal_at_an_int_direct_call_argument_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_arg_bool_literal_source()) >= 1
}

// THE SAME DECLARED TYPE, AT THE OTHER CONSULTED POSITIONS: the variable and the literal now receive
// the SAME verdict (measured: the variable accepted and the literal refused at every one of these
// before the repair).
fn sv5_return_bool_var_source() -> String {
  "module sv5.return_bool_var\n\nimport std.types { Int, Bool }\n\nfn takes(x: Int) -> Int {\n  x\n}\n\nfn probe(q: Bool) -> Int {\n  q\n}\n"
}

test fn a_bool_variable_at_an_int_declared_return_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_return_bool_var_source()) >= 1
}

fn sv5_field_bool_var_source() -> String {
  "module sv5.field_bool_var\n\nimport std.types { Int, Bool }\n\ntype Box { n: Int }\n\nfn probe(q: Bool) -> Box {\n  Box { n: q }\n}\n"
}

test fn a_bool_variable_at_an_int_record_field_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_field_bool_var_source()) >= 1
}

fn sv5_let_bool_var_source() -> String {
  "module sv5.let_bool_var\n\nimport std.types { Int, Bool }\n\nfn probe(q: Bool) -> Int {\n  let z: Int = q\n  z\n}\n"
}

test fn a_bool_variable_at_an_int_let_annotation_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_let_bool_var_source()) >= 1
}

// THE SHAPE BEYOND THE KERNEL FORMAL: a Bool at a differently-parameterised declared head, and a
// differently-parameterised head at itself. These refuse as DeclaredTypeNotInhabited -- at the direct
// call argument for the first, at the GENERIC TYPE ARGUMENT for the second (the child-count bail had
// silenced both; measured ACCEPTED with zero diagnostics before).
fn sv5_bool_at_free_monoid_int_source() -> String {
  "module sv5.bool_at_fm_int\n\nimport std.types { Int, Bool }\nimport std.algebra { FreeMonoid }\n\nfn takes(x: FreeMonoid<Int>) -> Int {\n  1\n}\n\nfn probe(q: Bool) -> Int {\n  takes(x: q)\n}\n"
}

test fn a_bool_variable_at_a_free_monoid_of_int_formal_must_refuse() -> Bool {
  inhabitance_or_mismatch_blocking_count(source: sv5_bool_at_free_monoid_int_source()) >= 1
}

