module test.claim.systemd_unit_invocation_liveness_witness

import std.types { Bool, NonEmptyStr, String }
import std.durable_exclusive_hold { HolderObservedLive, HolderObservedDead, HolderLivenessUnobservable }
import gunbc.systemd_unit_invocation_liveness {
  SystemManager, UserManager, SystemdManagerInstance, UnitInvocationObservation, UnitInvocationPresent, UnitInvocationAbsent, UnitInvocationUnreadable,
  unit_invocation_observation, unit_invocation_holder_liveness, unit_run_wire, unit_run_of_wire,
  BootObserved, BootUnreadable, unit_boot_observation,
  BootStartsAfterAcquisition, BootStartsBeforeAcquisition, BootOrderUndecided, BootOrderUnreadable,
  unit_boot_order, unit_reboot_holder_liveness,
}

data boot_a: String = "73c8153e-0e0e-4480-a36c-bc7560c50e8b"
data boot_b: String = "11111111-2222-4333-8444-555555555555"
data inv_a: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
data inv_b: String = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
data stat_text: String = "cpu 1 2 3\nbtime 1792000000\nprocesses 5\n"

data unit_a: NonEmptyStr = "gunbc-slot@a.service"
data unit_b: NonEmptyStr = "gunbc-slot@b.service"
data boot_old_stat: String = "cpu 1 2 3\nbtime 1791000000\nprocesses 5\n"

fn observed(manager: SystemdManagerInstance, unit: NonEmptyStr, boot: String, stat: String, inv: String) -> UnitInvocationObservation {
  unit_invocation_observation(manager: manager, unit: unit, boot_id_text: boot, proc_stat_text: stat, invocation_text: inv)
}

// Identity differs on any component; a DEATH verdict additionally needs the recorded holder's own unit and manager.
test fn a_reading_with_a_mismatched_boot_invocation_or_manager_is_not_the_same_run() -> Bool {
  match observed(manager: SystemManager, unit: unit_a, boot: boot_a, stat: boot_old_stat, inv: inv_a) {
    UnitInvocationPresent { unit: _, run: r } => {
      let live = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_a, stat: boot_old_stat, inv: inv_a))
      let other_inv = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_a, stat: boot_old_stat, inv: inv_b))
      let later_boot = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_b, stat: stat_text, inv: inv_a))
      let gone = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_a, stat: boot_old_stat, inv: ""))
      let gone_later_boot = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_b, stat: stat_text, inv: ""))
      (match live { HolderObservedLive { evidence: _ } => true  _ => false })
        && (match other_inv { HolderObservedDead { evidence: _ } => true  _ => false })
        && (match later_boot { HolderObservedDead { evidence: _ } => true  _ => false })
        && (match gone { HolderObservedDead { evidence: _ } => true  _ => false })
        && (match gone_later_boot { HolderObservedDead { evidence: _ } => true  _ => false })
    }
    _ => false
  }
}

// A different manager, an unrelated unit, or a boot not starting after the recorded one cannot yield a death verdict.
test fn a_foreign_subject_or_unordered_boot_is_unobservable_never_dead() -> Bool {
  match observed(manager: SystemManager, unit: unit_a, boot: boot_a, stat: stat_text, inv: inv_a) {
    UnitInvocationPresent { unit: _, run: r } => {
      let other_mgr = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: UserManager { uid: 1000 }, unit: unit_a, boot: boot_a, stat: stat_text, inv: inv_b))
      let other_unit = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_b, boot: boot_a, stat: stat_text, inv: inv_b))
      let other_unit_absent = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_b, boot: boot_a, stat: stat_text, inv: ""))
      let other_mgr_absent = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: UserManager { uid: 1000 }, unit: unit_a, boot: boot_a, stat: stat_text, inv: ""))
      let earlier_boot = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_b, stat: boot_old_stat, inv: inv_a))
      let absent_earlier_boot = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_b, stat: boot_old_stat, inv: ""))
      let absent_equal_start = unit_invocation_holder_liveness(recorded: r, holder_unit: unit_a, observed: observed(manager: SystemManager, unit: unit_a, boot: boot_b, stat: stat_text, inv: ""))
      (match absent_earlier_boot { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match absent_equal_start { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match other_mgr { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match other_unit { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match other_unit_absent { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match other_mgr_absent { HolderLivenessUnobservable { cause: _ } => true  _ => false })
        && (match earlier_boot { HolderLivenessUnobservable { cause: _ } => true  _ => false })
    }
    _ => false
  }
}

test fn a_malformed_or_absent_reading_is_a_typed_refusal_never_a_default() -> Bool {
  let bad_inv = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_a, proc_stat_text: stat_text, invocation_text: "not-hex")
  let bad_boot = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: "nope", proc_stat_text: stat_text, invocation_text: inv_a)
  let no_btime = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_a, proc_stat_text: "cpu 1\n", invocation_text: inv_a)
  (match bad_inv { UnitInvocationUnreadable { cause: _ } => true  _ => false })
    && (match bad_boot { UnitInvocationUnreadable { cause: _ } => true  _ => false })
    && (match no_btime { UnitInvocationUnreadable { cause: _ } => true  _ => false })
}

test fn a_run_round_trips_its_wire_and_a_bare_legacy_id_is_unreadable() -> Bool {
  match unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_a, proc_stat_text: stat_text, invocation_text: inv_a) {
    UnitInvocationPresent { unit: _, run: r } => {
      let back = unit_run_of_wire(wire: unit_run_wire(run: r))
      let legacy = unit_run_of_wire(wire: inv_a)
      (match back { Present { value: b } => unit_run_wire(run: b) == unit_run_wire(run: r)  Absent => false })
        && (match legacy { Present { value: _ } => false  Absent => true })
    }
    _ => false
  }
}

// ---------------------------------------------------------------------------------------------
// THE BOOT-ONLY READING, AND THE OBSERVED-REBOOT ARM BUILT ON IT. These are the rows for the weaker
// carrier: a holder whose run identity was never recorded, where the only host fact that can bind a unit
// name to a lifetime is the boot. The RED rows are the point of the change -- a boot that predates the
// acquisition, a unit that still reports an InvocationID, and a boot that cannot be ordered must ALL keep
// the hold; only the conjunction of "the manager that ran the unit has no such unit" and "this boot began
// after the acquisition, by more than the skew bound" may free it.

data boot_good: String = "6f2f9a1c-3b7e-4a55-9c1d-2a4e6b8c0d11"
data stat_btime_1792000000: String = "cpu  1 2 3 4\nbtime 1792000000\nprocesses 7\n"
data stat_btime_bad: String = "cpu  1 2 3 4\nbtime not-a-number\n"
data stat_no_btime: String = "cpu  1 2 3 4\nprocesses 7\n"
data stat_btime_negative: String = "cpu  1 2 3 4\nbtime -5\n"

test fn the_boot_only_reading_refuses_everywhere_a_default_would_sit() -> Bool {
  let good = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  let bad_id = unit_boot_observation(boot_id_text: "not-a-uuid", proc_stat_text: stat_btime_1792000000)
  let no_btime = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_no_btime)
  let bad_btime = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_bad)
  let negative = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_negative)
  (match good { BootObserved { boot_id: _, boot_started_at: t } => t == 1792000000  _ => false })
    && (match bad_id { BootUnreadable { cause: _ } => true  _ => false })
    && (match no_btime { BootUnreadable { cause: _ } => true  _ => false })
    && (match bad_btime { BootUnreadable { cause: _ } => true  _ => false })
    && (match negative { BootUnreadable { cause: _ } => true  _ => false })
}

// ONE READING, ONE REFUSAL. The run reading and the boot-only reading take the same two host texts, and a
// malformed one must produce the SAME located cause from both -- otherwise the two consumers of this
// module are acting on two different accounts of the same file (DESIGN 3).
test fn the_two_readings_refuse_with_the_same_cause_for_the_same_bad_host_text() -> Bool {
  let run_reading = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: "not-a-uuid", proc_stat_text: stat_btime_1792000000, invocation_text: inv_a)
  let boot_reading = unit_boot_observation(boot_id_text: "not-a-uuid", proc_stat_text: stat_btime_1792000000)
  let run_no_btime = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_good, proc_stat_text: stat_no_btime, invocation_text: inv_a)
  let boot_no_btime = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_no_btime)
  match run_reading {
    UnitInvocationUnreadable { cause: c1 } =>
      match boot_reading {
        BootUnreadable { cause: c2 } => c1 == c2
        _ => false
      }
    _ => false
  }
  && match run_no_btime {
    UnitInvocationUnreadable { cause: c3 } =>
      match boot_no_btime { BootUnreadable { cause: c4 } => c3 == c4  _ => false }
    _ => false
  }
}

// THE BOOT AND THE RUN AGREE ABOUT WHEN THE BOOT BEGAN, because they read it once.
test fn the_boot_instant_the_run_reading_carries_is_the_boot_instant_the_boot_reading_carries() -> Bool {
  match unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, invocation_text: inv_a) {
    UnitInvocationPresent { unit: _, run: r } =>
      match unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000) {
        BootObserved { boot_id: b, boot_started_at: t } => (t == r.boot_started_at) && ((b as String) == (r.boot_id as String))
        BootUnreadable { cause: _ } => false
      }
    _ => false
  }
}

// BOOT ORDER IS A THREE-WAY FACT, AND THE SKEW BOUND IS THE CALLER'S. The bound is not a fudge factor: an
// overlap says "this cannot be ordered", which is a different value from "after" and from "before".
test fn boot_and_acquisition_are_ordered_only_outside_the_callers_skew_bound() -> Bool {
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  (match unit_boot_order(boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    BootStartsAfterAcquisition { boot_started_at: s, acquired_at: a } => (s == 1792000000) && (a == 1791900000)
    _ => false
  })
  && (match unit_boot_order(boot: boot, acquired_at: 1792100000, skew_bound_seconds: 120) {
    BootStartsBeforeAcquisition { boot_started_at: s, acquired_at: a } => (s == 1792000000) && (a == 1792100000)
    _ => false
  })
  && (match unit_boot_order(boot: boot, acquired_at: 1792000060, skew_bound_seconds: 120) {
    BootOrderUndecided { boot_started_at: s, acquired_at: a, skew_bound_seconds: b } => (s == 1792000000) && (a == 1792000060) && (b == 120)
    _ => false
  })
  && (match unit_boot_order(boot: unit_boot_observation(boot_id_text: "not-a-uuid", proc_stat_text: stat_btime_1792000000), acquired_at: 1791900000, skew_bound_seconds: 120) {
    BootOrderUnreadable { cause: _ } => true
    _ => false
  })
}

// AN ABSENT STANDING TAKEN ON A GIVEN HOST PAIR. The standing carries its own boot now, so a row that wants
// the conjunction to hold must take the standing and the boot operand from ONE host reading; a row that wants
// the cross-check to fail says so by naming a different pair. Built through the production admission function,
// so the boot fields in the standing are the product of the same decode the host reading uses.
fn absent_standing(boot_id_text: String, proc_stat_text: String, unit: NonEmptyStr, manager: SystemdManagerInstance) -> UnitInvocationObservation {
  unit_invocation_observation(manager: manager, unit: unit, boot_id_text: boot_id_text, proc_stat_text: proc_stat_text, invocation_text: "")
}

// THE LAWFUL CONTROL: the manager that ran the unit has no such unit, AND this boot began after the hold
// was acquired. That is death evidence, and it is the only shape that produces it here.
test fn an_absent_unit_and_a_boot_that_began_after_the_acquisition_is_death_evidence() -> Bool {
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  match unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: SystemManager), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderObservedDead { evidence: _ } => true
    _ => false
  }
}

// RED: A BOOT THAT PREDATES THE ACQUISITION IS NOT DEATH EVIDENCE. The unit is gone from the manager, and
// that still does not free the hold. It is UNOBSERVABLE rather than live: a unit not loaded in a boot that
// began before the acquisition may never have been started in that boot, so the boot neither ends the holder
// nor proves it running -- and claiming life from absence would be the same over-claim as claiming death.
test fn a_boot_that_predates_the_acquisition_keeps_the_hold_even_with_the_unit_gone() -> Bool {
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  match unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: SystemManager), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1792100000, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  }
}

// RED: A UNIT THAT STILL REPORTS AN INVOCATIONID IS ALIVE TO THIS ARM, whatever the boot says.
test fn a_unit_that_still_reports_an_invocation_is_alive_to_the_boot_arm() -> Bool {
  let standing = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, invocation_text: inv_a)
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  match unit_reboot_holder_liveness(standing: standing, holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderObservedLive { evidence: _ } => true
    _ => false
  }
}

// A PRESENT reading is a verdict about the holder too, so it needs the same subject binding the absent arm
// needs. The same unit name under a DIFFERENT manager is a different subject: a user manager can run a unit
// whose name the system manager also uses. That neither frees the hold nor proves THIS holder alive, so it
// reads Unobservable rather than Live.
test fn a_present_reading_from_another_manager_is_not_this_holder_alive() -> Bool {
  let standing = unit_invocation_observation(manager: UserManager { uid: 1000 }, unit: unit_a, boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, invocation_text: inv_a)
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  match unit_reboot_holder_liveness(standing: standing, holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause } => string_contains(s: cause, pattern: "not from system, the manager named for this holder")
    _ => false
  }
}

// RED: AN OVERLAP WITHIN THE SKEW BOUND REFUSES TO DECIDE, and an unreadable boot or an unreadable unit
// standing refuses too. "No reading" and "no order" are kept apart in the cause text, and neither one is
// ever death.
test fn an_unorderable_boot_or_an_unreadable_standing_never_frees_the_hold() -> Bool {
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  let unreadable_boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_no_btime)
  let unreadable_standing = unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: "not-a-uuid", proc_stat_text: stat_btime_1792000000, invocation_text: "not-hex")
  (match unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: SystemManager), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1792000060, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  })
  && (match unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: SystemManager), holder_unit: unit_a, holder_manager: SystemManager, boot: unreadable_boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  })
  && (match unit_reboot_holder_liveness(standing: unreadable_standing, holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  })
}

// SUBJECT BINDING APPLIES TO THE BOOT ARM EXACTLY AS IT APPLIES TO THE RUN ARM. A boot that began after the
// acquisition is a fact about the HOST; it becomes evidence about a holder only when it is conjoined with a
// reading of that holder's own unit, from the manager named for that holder. Paired with a reading of another
// unit, or of another manager, the arm REFUSES -- and it refuses rather than answering live, because a reading
// about somebody else does not even establish that this holder is running.
test fn a_foreign_subject_never_frees_the_hold_even_across_a_boot() -> Bool {
  let boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  let other_unit_absent = unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_b, manager: SystemManager), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120)
  let other_manager_absent = unit_reboot_holder_liveness(standing: absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: UserManager { uid: 1000 }), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120)
  let other_unit_present = unit_reboot_holder_liveness(standing: unit_invocation_observation(manager: SystemManager, unit: unit_b, boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, invocation_text: inv_a), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120)
  let own_unit_present = unit_reboot_holder_liveness(standing: unit_invocation_observation(manager: SystemManager, unit: unit_a, boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, invocation_text: inv_a), holder_unit: unit_a, holder_manager: SystemManager, boot: boot, acquired_at: 1791900000, skew_bound_seconds: 120)
  (match other_unit_absent { HolderLivenessUnobservable { cause: _ } => true  _ => false })
    && (match other_manager_absent { HolderLivenessUnobservable { cause: _ } => true  _ => false })
    && (match other_unit_present { HolderLivenessUnobservable { cause: _ } => true  _ => false })
    && (match own_unit_present { HolderObservedLive { evidence: _ } => true  _ => false })
}

// THE BOOT THAT ORDERS MUST BE THE BOOT THE STANDING WAS TAKEN ON. The not-found reading now carries its own
// boot, and the order is taken against THAT boot; the boot operand is a cross-check, not a second source. A
// standing from one host pair offered beside a boot from another is not one reading, so the arm refuses even
// though the second boot began long after the acquisition -- which is exactly the shape that would otherwise
// manufacture death evidence out of two facts that were never observed together.
test fn a_boot_that_is_not_the_standing_s_own_boot_never_frees_the_hold() -> Bool {
  let standing = absent_standing(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000, unit: unit_a, manager: SystemManager)
  let other_pair_boot = unit_boot_observation(boot_id_text: boot_b, proc_stat_text: boot_old_stat)
  let same_pair_boot = unit_boot_observation(boot_id_text: boot_good, proc_stat_text: stat_btime_1792000000)
  (match unit_reboot_holder_liveness(standing: standing, holder_unit: unit_a, holder_manager: SystemManager, boot: other_pair_boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderLivenessUnobservable { cause: _ } => true
    _ => false
  })
  && (match unit_reboot_holder_liveness(standing: standing, holder_unit: unit_a, holder_manager: SystemManager, boot: same_pair_boot, acquired_at: 1791900000, skew_bound_seconds: 120) {
    HolderObservedDead { evidence: _ } => true
    _ => false
  })
}
