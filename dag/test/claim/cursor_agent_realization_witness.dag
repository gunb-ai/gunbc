  cursor_agent_executable_path,
  cursor_agent_sandbox_helper_path,
  admit_cursor_agent_path,
  CursorAgentPathAdmitted,
  CursorAgentPathRefused,
  PathHasWildcard,
  PathHasUnsafeSegment,
  PathOutsidePinnedRoot,
  render_cursor_agent_profile,
  CursorAgentProfileRendered,
  CursorAgentProfileUnrenderable,
  ProfileFileObservation,
  ProfileFileObserved,
  ProfileFileUnobserved,
  LoadedProfilesObserved,
  LoadedProfilesUnobserved,
  InstallTreeObserved,
  InstallTreeUnobserved,
  CursorAgentReadbackHolds,
  CursorAgentReadbackFails,
  CursorAgentReadbackUnobserved,
  ProfileDigestMismatch,
  ProfileDigestUnreadable,
  ProfileNotRootOwned,
  ProfileModeNotPinned,
  ProfileNotLoaded,
  ProfileLoadedNotEnforcing,
  InstallExecutableMissing,
  InstallHelperMissing,
  InstallEntriesNotRootOwned,
  InstallEntriesWritable,
  InstallSymlinkEscapes,
  cursor_agent_realization_readback,
  readback_install_tree,
  PreflightObserved,
