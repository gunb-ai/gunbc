module test.claim.markdown_inline_render


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn parse_and_render(text: String) -> List<std.markup.Fragment> {
  std.markdown.markdown_inlines_to_fragments(
    inlines: extdeps.languages.markdown.parse_inline_markdown_minimal(text: text)
  )
}

test fn witness_bold_renders_to_strong_node() -> Bool {
  parse_and_render(text: "**bold text**") ==
    [ std.markup.Element { tag: "strong", attributes: [], children: [ std.markup.FragmentText { content: "bold text" } ] } ]
}

test fn witness_code_renders_to_code_node() -> Bool {
  parse_and_render(text: "`inline code`") ==
    [ std.markup.Element { tag: "code", attributes: [], children: [ std.markup.FragmentText { content: "inline code" } ] } ]
}

test fn witness_link_renders_to_anchor_node() -> Bool {
  parse_and_render(text: "[label](/docs/plan.md)") ==
    [ std.markup.Element {
        tag: "a",
        attributes: [ std.markup.attr(name: "href", value: "/docs/plan.md" ) ],
        children: [ std.markup.FragmentText { content: "label" } ],
      }
    ]
}

test fn witness_em_renders_to_em_node() -> Bool {
  parse_and_render(text: "*emphasis*") ==
    [ std.markup.Element { tag: "em", attributes: [], children: [ std.markup.FragmentText { content: "emphasis" } ] } ]
}

test fn witness_mixed_inline_renders_to_nodes() -> Bool {
  parse_and_render(text: "**bold** and `code`") ==
    [
      std.markup.Element { tag: "strong", attributes: [], children: [ std.markup.FragmentText { content: "bold" } ] },
      std.markup.FragmentText { content: " and " },
      std.markup.Element { tag: "code", attributes: [], children: [ std.markup.FragmentText { content: "code" } ] },
    ]
}

test fn witness_plain_text_stays_text_node() -> Bool {
  parse_and_render(text: "plain text no markup") == [ std.markup.FragmentText { content: "plain text no markup" } ]
}

test fn witness_markup_bold_differs_from_plain() -> Bool {
  !(parse_and_render(text: "**bold**") == parse_and_render(text: "bold"))
}

test fn witness_image_inline_renders_to_img_node() -> Bool {
  std.markdown.markdown_inline_to_fragments(inline: std.markdown.ImageInline { alt: "description", url: "/img.png" }) ==
    [ std.markup.Element {
        tag: "img",
        attributes: [
          std.markup.attr(name: "src", value: "/img.png" ),
          std.markup.attr(name: "alt", value: "description" ),
        ],
        children: [],
      }
    ]
}

