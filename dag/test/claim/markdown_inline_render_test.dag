module test.claim.markdown_inline_render

import std.markup { Fragment, Element, FragmentText, attr }
import std.markdown {
  markdown_inlines_to_fragments,
  markdown_inline_to_fragments,
  ImageInline,
}
import extdeps.languages.markdown { parse_inline_markdown_minimal }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn parse_and_render(text: String) -> List<Fragment> {
  markdown_inlines_to_fragments(
    inlines: parse_inline_markdown_minimal(text: text)
  )
}

test fn witness_bold_renders_to_strong_node() -> Bool {
  parse_and_render(text: "**bold text**") ==
    [ Element { tag: "strong", attributes: [], children: [ FragmentText { content: "bold text" } ] } ]
}

test fn witness_code_renders_to_code_node() -> Bool {
  parse_and_render(text: "`inline code`") ==
    [ Element { tag: "code", attributes: [], children: [ FragmentText { content: "inline code" } ] } ]
}

test fn witness_link_renders_to_anchor_node() -> Bool {
  parse_and_render(text: "[label](/docs/plan.md)") ==
    [ Element {
        tag: "a",
        attributes: [ attr(name: "href", value: "/docs/plan.md" ) ],
        children: [ FragmentText { content: "label" } ],
      }
    ]
}

test fn witness_em_renders_to_em_node() -> Bool {
  parse_and_render(text: "*emphasis*") ==
    [ Element { tag: "em", attributes: [], children: [ FragmentText { content: "emphasis" } ] } ]
}

test fn witness_mixed_inline_renders_to_nodes() -> Bool {
  parse_and_render(text: "**bold** and `code`") ==
    [
      Element { tag: "strong", attributes: [], children: [ FragmentText { content: "bold" } ] },
      FragmentText { content: " and " },
      Element { tag: "code", attributes: [], children: [ FragmentText { content: "code" } ] },
    ]
}

test fn witness_plain_text_stays_text_node() -> Bool {
  parse_and_render(text: "plain text no markup") == [ FragmentText { content: "plain text no markup" } ]
}

test fn witness_markup_bold_differs_from_plain() -> Bool {
  !(parse_and_render(text: "**bold**") == parse_and_render(text: "bold"))
}

test fn witness_image_inline_renders_to_img_node() -> Bool {
  markdown_inline_to_fragments(inline: ImageInline { alt: "description", url: "/img.png" }) ==
    [ Element {
        tag: "img",
        attributes: [
          attr(name: "src", value: "/img.png" ),
          attr(name: "alt", value: "description" ),
        ],
        children: [],
      }
    ]
}

