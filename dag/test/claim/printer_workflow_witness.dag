module test.claim.printer_workflow_witness

import std.types { Bool, String }
import gunbc.fleet.printer_workflow_artifact { printer_starts_path, printer_starts_directory, print_run_directory }
import gunbc.fleet.printer_state_layout { printer_state_directories }
import gunbc.fleet.print_record_stores { print_request_path, print_completion_path }
import gunbc.fleet.printer_actuation { printer_start_claim_path }
import gunbc.fleet.printer_start_evidence_store { start_evidence_path }
import product.printed_chassis.assembly_inventory_store { cassette_inventory_path }
import gunbc.host_state_root { host_state_tree }
import gunbc.owned_directory { owned_directory_path, owned_directory_owner, owned_directory_mode, OwnedDirectoryModeResolved, OwnedDirectoryModeRefused }
import extdeps.access.posix { file_mode_octal }
import gunbc.fleet.fleet_posix_accounts { fleet_automation_user }
import extdeps.tools.mosquitto_pub { mosquitto_pub_help_supports_private_options }
import gunbc.fleet.printer_selection { print_inputs_admitted, select_printer, PrinterSelected, PrinterSelectionRefused }
import gunbc.fleet.printer_federation { printer_claim_pins }
import gunbc.auth.oidc_claim_pins {
  claim_pins_admit, presented_from_pins, with_presented_value, without_presented_claim,
  fleet_converge_workflow_ref_at_main,
}

data project_digest: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

test fn w_print_needs_exact_version_and_digest() -> Bool {
  print_inputs_admitted(version: "1", digest: project_digest) &&
  !print_inputs_admitted(version: "latest", digest: project_digest) &&
  !print_inputs_admitted(version: "pending", digest: project_digest) &&
  !print_inputs_admitted(version: "1", digest: "")
}

test fn w_unknown_printer_never_selects_a_default_machine() -> Bool {
  match select_printer(name: "printer-03") { PrinterSelectionRefused => true  PrinterSelected { printer: _ } => false }
}

test fn w_printer_federation_rejects_other_workflow_tag_and_environment() -> Bool {
  let pins = printer_claim_pins()
  let presented = presented_from_pins(pins: pins)
  claim_pins_admit(pins: pins, claims: presented) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "workflow_ref", value: concat(fleet_converge_workflow_ref_at_main(), "session/x"))) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/tags/x")) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "environment", value: "namecheap-dns")) &&
  !claim_pins_admit(pins: pins, claims: without_presented_claim(claims: presented, claim: "workflow_ref"))
}

test fn w_tool_probe_requires_mosquitto_version_two_or_newer() -> Bool {
  mosquitto_pub_help_supports_private_options(stdout: "mosquitto_pub is a simple mqtt client that will publish a message on a single topic and exit.\nmosquitto_pub version 2.0.18 running on libmosquitto 2.0.18.") &&
  !mosquitto_pub_help_supports_private_options(stdout: "mosquitto_pub version 1.6.12 running on libmosquitto 1.6.12.") &&
  !mosquitto_pub_help_supports_private_options(stdout: "") &&
  !mosquitto_pub_help_supports_private_options(stdout: "unrelated tool 2.0")
}

// The printer's state tree has ONE root-owned parent and fleet-owned members beneath it (quick-newt-573
// security ruling, 2026-11-05). printer-starts hosts a privileged `install -d` for every member below it, so
// -- exactly as gunbc.host_state_root host_state_tree_root rules for /var/lib/gunbc -- the PARENT is root-owned
// and traverse-only (0755, the group class cannot write): root owns the parent's CONTENTS, and the
// de-privileged job user (a gunbc-fleet member) can traverse it but can never plant a symlink in it that a
// privileged install of a member would follow and chown. Each member store dir is fleet-owned and group-writable
// setgid (2770), the group class the fleet collaborators reach records through. The parent precedes the members
// it nests (the installer creates it first); print-run sits BESIDE the parent under the host state tree root, so
// only the five members nest under the parent path.
test fn w_printer_state_parent_is_root_traverse_and_members_are_fleet_shared() -> Bool {
  let tree = host_state_tree()
  let ds = printer_state_directories(tree: tree)
  let root = printer_starts_path(tree: tree) as String
  let parent = printer_starts_directory(tree: tree)
  let parent_mode_is_traverse = match owned_directory_mode(t: parent) {
    OwnedDirectoryModeResolved { mode: m } => !m.group.write && file_mode_octal(mode: m) == "0755"
    OwnedDirectoryModeRefused { reason: _ } => false
  }
  count(ds) == 7 &&
  map(ds, d => owned_directory_path(t: d) as String) == [
    root,
    start_evidence_path(tree: tree) as String,
    print_request_path(tree: tree) as String,
    print_completion_path(tree: tree) as String,
    printer_start_claim_path(tree: tree) as String,
    cassette_inventory_path(tree: tree) as String,
    print_run_directory(tree: tree) as String,
  ] &&
  // the parent is root:root and traverse-only (the host_state_tree_root ruling for a directory that hosts
  // privileged installs): root owns its contents, the group class cannot write it
  (owned_directory_owner(t: parent).user as String) == "root" &&
  (owned_directory_owner(t: parent).group as String) == "root" &&
  parent_mode_is_traverse &&
  // every non-parent directory is fleet-owned and group-writable setgid
  all(filter(xs: ds, predicate: fn(d) { (owned_directory_path(t: d) as String) != root }), d =>
    (owned_directory_owner(t: d).user as String) == (fleet_automation_user.name as String) &&
    (owned_directory_owner(t: d).group as String) == (fleet_automation_user.name as String) &&
    (match owned_directory_mode(t: d) { OwnedDirectoryModeResolved { mode: m } => m.group.write && file_mode_octal(mode: m) == "2770" OwnedDirectoryModeRefused { reason: _ } => false })
  ) &&
  // the five members nest under the parent; print-run sits beside it under the host state tree root
  all([start_evidence_path(tree: tree), print_request_path(tree: tree), print_completion_path(tree: tree), printer_start_claim_path(tree: tree), cassette_inventory_path(tree: tree)], m => starts_with(s: m as String, prefix: concat(root, "/"))) &&
  !starts_with(s: print_run_directory(tree: tree) as String, prefix: concat(root, "/"))
}
