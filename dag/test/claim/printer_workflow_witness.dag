module test.claim.printer_workflow_witness

import std.types { Bool, String }
import gunbc.fleet.printer_workflow_artifact { printer_starts_path, print_run_directory }
import gunbc.fleet.printer_state_layout { printer_state_directories }
import gunbc.fleet.print_record_stores { print_request_path, print_completion_path }
import gunbc.fleet.printer_actuation { printer_start_claim_path }
import gunbc.fleet.printer_execution_hold { printer_execution_hold_path }
import product.printed_chassis.assembly_inventory_store { cassette_inventory_path }
import gunbc.host_state_root { host_state_tree }
import gunbc.owned_directory { owned_directory_path, owned_directory_owner, owned_directory_mode, OwnedDirectoryModeResolved, OwnedDirectoryModeRefused }
import extdeps.access.posix { file_mode_octal }
import gunbc.fleet.fleet_posix_accounts { fleet_automation_user }
import extdeps.tools.mosquitto_pub { mosquitto_pub_help_supports_private_options }
import gunbc.fleet.printer_selection { print_inputs_admitted, select_printer, PrinterSelected, PrinterSelectionRefused }
import gunbc.fleet.printer_federation { printer_claim_pins }
import gunbc.auth.oidc_claim_pins {
  claim_pins_admit, presented_from_pins, with_presented_value, without_presented_claim,
  fleet_converge_workflow_ref_at_main,
}

data project_digest: String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

test fn w_print_needs_exact_version_and_digest() -> Bool {
  print_inputs_admitted(version: "1", digest: project_digest) &&
  !print_inputs_admitted(version: "latest", digest: project_digest) &&
  !print_inputs_admitted(version: "pending", digest: project_digest) &&
  !print_inputs_admitted(version: "1", digest: "")
}

test fn w_unknown_printer_never_selects_a_default_machine() -> Bool {
  match select_printer(name: "printer-03") { PrinterSelectionRefused => true  PrinterSelected { printer: _ } => false }
}

test fn w_printer_federation_rejects_other_workflow_tag_and_environment() -> Bool {
  let pins = printer_claim_pins()
  let presented = presented_from_pins(pins: pins)
  claim_pins_admit(pins: pins, claims: presented) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "workflow_ref", value: concat(fleet_converge_workflow_ref_at_main(), "session/x"))) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "workflow_ref", value: "gunb-ai/gunbc/.github/workflows/fleet-converge.yml@refs/tags/x")) &&
  !claim_pins_admit(pins: pins, claims: with_presented_value(claims: presented, claim: "environment", value: "namecheap-dns")) &&
  !claim_pins_admit(pins: pins, claims: without_presented_claim(claims: presented, claim: "workflow_ref"))
}

test fn w_tool_probe_requires_mosquitto_version_two_or_newer() -> Bool {
  mosquitto_pub_help_supports_private_options(stdout: "mosquitto_pub is a simple mqtt client that will publish a message on a single topic and exit.\nmosquitto_pub version 2.0.18 running on libmosquitto 2.0.18.") &&
  !mosquitto_pub_help_supports_private_options(stdout: "mosquitto_pub version 1.6.12 running on libmosquitto 1.6.12.") &&
  !mosquitto_pub_help_supports_private_options(stdout: "") &&
  !mosquitto_pub_help_supports_private_options(stdout: "unrelated tool 2.0")
}

// The printer's state roots belong to the fleet account, group-writable setgid so the job user reaches
// them through that group, and the claim root precedes the request root nested in it.
test fn w_printer_state_roots_are_fleet_owned_group_shared_and_parent_first() -> Bool {
  let ds = printer_state_directories(tree: host_state_tree())
  count(ds) == 7 &&
  all(ds, d => (owned_directory_owner(t: d).user as String) == (fleet_automation_user.name as String) && (owned_directory_owner(t: d).group as String) == (fleet_automation_user.name as String) &&
    (match owned_directory_mode(t: d) { OwnedDirectoryModeResolved { mode: m } => file_mode_octal(mode: m) == "2770" OwnedDirectoryModeRefused { reason: _ } => false })) &&
  map(ds, d => owned_directory_path(t: d) as String) == [printer_starts_path(tree: host_state_tree()) as String, print_request_path(tree: host_state_tree()) as String, print_completion_path(tree: host_state_tree()) as String, printer_start_claim_path(tree: host_state_tree()) as String, printer_execution_hold_path(tree: host_state_tree()) as String, cassette_inventory_path(tree: host_state_tree()) as String, print_run_directory(tree: host_state_tree()) as String] &&
  all([print_request_path(tree: host_state_tree()), print_completion_path(tree: host_state_tree()), printer_start_claim_path(tree: host_state_tree()), printer_execution_hold_path(tree: host_state_tree()), cassette_inventory_path(tree: host_state_tree())], m => starts_with(s: m as String, prefix: concat(printer_starts_path(tree: host_state_tree()) as String, "/")))
}
