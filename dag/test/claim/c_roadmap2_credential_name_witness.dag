module test.claim.c_roadmap2_credential_name_witness

import std.types { Bool, String, NonEmptyStr, FilePath, List }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.dispatch_attempt { DispatchAttempt }
import gunbc.dispatch_credential_snapshot { ClaudeFromSnapshot, CursorFromSnapshot, SnapshotExecutor, credential_snapshot_path_for_attempt, credential_snapshot_provider_label, taken_credential_snapshot_slots }
import gunbc.roadmap.roadmap_attempt_state_store { attempt_state_slots, attempt_state_entry_name }
import gunbc.roadmap.roadmap_dashboard_instance { DashboardActuating, DashboardLocalProvision, dashboard_instance_dispatch_attempt_state_root, isolated_dashboard_instance }
import gunbc.deployment_risk { srv1_lab_codex_feedback_deployment }
import gunbc.host.host_layout { srv1_host_layout }
import test.claim.roadmap.roadmap_dispatch_actuator_witness { sized_derivable }
import gunbc.roadmap.roadmap_dispatch_actuator { dispatch_provider_label }
import gunbc.roadmap.dispatch_worker_unit_confinement { ClaudeCodeProvider, CodexDispatchProvider, CursorDispatchProvider, GunbcHarnessProvider, dispatch_provider_words }

// THE NAME THE SEAL DERIVES IS THE NAME THE PRE-SEAL CODE WROTE, AND IT COMES OUT OF THE DECLARATIONS.
// Before this PR the snapshot's name was spelled twice -- once inside the take and once, character for
// character, in the dispatch actuator (its `dispatch_credential_snapshot_path_for_attempt`, whose literals
// were "-" + "a" + "." + "-credential" written out by hand) -- and a launch that re-derived it at spawn could
// disagree with the take that wrote it. Now there is ONE derivation (gunbc.dispatch_credential_snapshot
// credential_snapshot_path_for_attempt) and no path enters it: the attempt and the executor go in, the path
// comes out, assembled from the attempt-state row's `attempt_infix` and this module's own
// taken_credential_snapshot_slots row. THE CLAIMS BELOW ARE ABOUT THAT IDENTITY: the fixture names below are
// what the live host holds today -- the byte-identical spelling the pre-seal actuator produced -- and the
// claim is that the WRITER'S OWN ROUTE produces them, with the separator, the suffix and the infix read from
// the declarations that own them. A rename in either row turns these claims red along with every reader,
// which is the point: nothing here is a second literal nobody reads.

type NameCase {
  label: String
  actual: String
  expected: String
}

fn names_agree(cases: List<NameCase>) -> ProcessExit {
  if all(cases, c => c.actual == c.expected) {
    ExitSuccess
  } else {
    exit_failure(join(map(cases, c => if c.actual == c.expected { "" } else { join([c.label, ": got <", c.actual, "> expected <", c.expected, ">"], "") }), " | "))
  }
}

// An instance whose identity is the lab's, over a root the witness owns; the name fold is pure, so no effect
// is needed to ask it what it writes.
fn fx_named_attempt(instance_root: String, node: String, attempt_key: String) -> DispatchAttempt {
  DispatchAttempt {
    instance: isolated_dashboard_instance(
      deployment: srv1_lab_codex_feedback_deployment,
      instance_id: "cred-name-witness" as NonEmptyStr,
      layout: srv1_host_layout(),
      root: instance_root as FilePath,
      serve_function: "roadmap_serve_handle_srv1_lab" as NonEmptyStr,
      listen_port: 18081,
      source_anchor_ref: "refs/remotes/origin/main" as NonEmptyStr,
      actuation: DashboardActuating,
      provision_transport: DashboardLocalProvision,
    ),
    node: sized_derivable(id: node, prs: [], title: "Credential name witness"),
    attempt_key: attempt_key,
  }
}

data witness_root: String = "/srv/gunbc-c-roadmap2-name-witness/instances/cred-name-witness"
data witness_node: String = "node-worker-turn"
data witness_attempt_key: String = "0123456789abcdef"

// THE PINNED NAME, byte for byte as the pre-seal actuator spelled it and as the live host holds it: the
// attempt-state root, then `<node>` + the attempt-state infix `-a` + the attempt key, then the snapshot
// separator `.`, the provider label, and the sealed store's `-credential` suffix.
data claude_snapshot_name: String = "/srv/gunbc-c-roadmap2-name-witness/instances/cred-name-witness/attempt-state/node-worker-turn-a0123456789abcdef.claude-credential"
data cursor_snapshot_name: String = "/srv/gunbc-c-roadmap2-name-witness/instances/cred-name-witness/attempt-state/node-worker-turn-a0123456789abcdef.cursor-credential"

test fn the_derived_snapshot_name_is_the_name_the_pre_seal_code_wrote() -> ProcessExit {
  let attempt = fx_named_attempt(instance_root: witness_root, node: witness_node, attempt_key: witness_attempt_key)
  names_agree(cases: [
    NameCase {
      label: "claude snapshot name",
      actual: credential_snapshot_path_for_attempt(attempt: attempt, executor: ClaudeFromSnapshot) as String,
      expected: claude_snapshot_name,
    },
    NameCase {
      label: "cursor snapshot name",
      actual: credential_snapshot_path_for_attempt(attempt: attempt, executor: CursorFromSnapshot) as String,
      expected: cursor_snapshot_name,
    },
  ])
}

// THE NAME IS THE DECLARATIONS, NOT A SECOND LITERAL: the same path, assembled by hand out of the rows that
// own each piece -- the attempt-state root, the attempt-state declaration's entry name (its own infix), this
// store's separator and suffix, and the provider label the take itself selects. Change a row and both this
// claim and every reader move together; change one spelling alone and this claim is the RED that says so. A
// module-level fn rather than a value, so a reader can see every row it reads.
fn name_from_rows(attempt: DispatchAttempt, executor: SnapshotExecutor) -> String {
  join([
    dashboard_instance_dispatch_attempt_state_root(instance: attempt.instance) as String,
    "/",
    attempt_state_entry_name(node: attempt.node.node as String, attempt_key: attempt.attempt_key),
    taken_credential_snapshot_slots.entry_separator as String,
    credential_snapshot_provider_label(executor: executor) as String,
    taken_credential_snapshot_slots.entry_suffix as String,
  ], "")
}

test fn the_name_is_read_from_the_declarations_that_own_each_piece() -> ProcessExit {
  let attempt = fx_named_attempt(instance_root: witness_root, node: witness_node, attempt_key: witness_attempt_key)
  names_agree(cases: [
    NameCase {
      label: "claude: the take's route and the declaration rows agree",
      actual: credential_snapshot_path_for_attempt(attempt: attempt, executor: ClaudeFromSnapshot) as String,
      expected: name_from_rows(attempt: attempt, executor: ClaudeFromSnapshot),
    },
    NameCase {
      label: "cursor: the take's route and the declaration rows agree",
      actual: credential_snapshot_path_for_attempt(attempt: attempt, executor: CursorFromSnapshot) as String,
      expected: name_from_rows(attempt: attempt, executor: CursorFromSnapshot),
    },
    NameCase {
      label: "the suffix row is the live host's -credential",
      actual: taken_credential_snapshot_slots.entry_suffix as String,
      expected: "-credential",
    },
    NameCase {
      label: "the infix row is the live host's -a",
      actual: attempt_state_slots.attempt_infix,
      expected: "-a",
    },
    NameCase {
      label: "the separator row is the live host's dot",
      actual: taken_credential_snapshot_slots.entry_separator as String,
      expected: ".",
    },
  ])
}

// TWO PROVIDERS, TWO NAMES, ONE ATTEMPT: the provider label is the only difference, so a take that mixed the
// providers could not read the other's file by accident -- and neither name is a path a caller chose.
test fn the_two_providers_of_one_attempt_differ_only_in_the_provider_label() -> ProcessExit {
  let attempt = fx_named_attempt(instance_root: witness_root, node: witness_node, attempt_key: witness_attempt_key)
  let claude = credential_snapshot_path_for_attempt(attempt: attempt, executor: ClaudeFromSnapshot) as String
  let cursor = credential_snapshot_path_for_attempt(attempt: attempt, executor: CursorFromSnapshot) as String
  let stem = join([dashboard_instance_dispatch_attempt_state_root(instance: attempt.instance) as String, "/", attempt_state_entry_name(node: attempt.node.node as String, attempt_key: attempt.attempt_key), "."], "")
  names_agree(cases: [
    NameCase { label: "the two names differ", actual: if claude == cursor { "equal" } else { "different" }, expected: "different" },
    NameCase { label: "claude is the stem plus claude and the suffix row", actual: claude, expected: join([stem, "claude", taken_credential_snapshot_slots.entry_suffix as String], "") },
    NameCase { label: "cursor is the stem plus cursor and the suffix row", actual: cursor, expected: join([stem, "cursor", taken_credential_snapshot_slots.entry_suffix as String], "") },
  ])
}

// ONE DECLARATION OWNS THE PROVIDER WORD (review 89845). The snapshot store and the dispatch actuator used to
// carry their own literal maps from provider to word; the word now lives beside the provider type, in
// gunbc.roadmap.dispatch_worker_unit_confinement (dispatch_provider_words), and BOTH readers read it. The four
// literals below are the words the live host's bytes carry today (the snapshot file name and the label the belt
// reports a provider under), so this claim is the pin that a rename in the row turns red -- and it turns red for
// BOTH spellings at once, because there is one row. Bytes on disk do not change: the row spells what the pre-PR
// code spelled, character for character.
test fn the_provider_word_is_declared_once_and_both_readers_read_it() -> ProcessExit {
  names_agree(cases: [
    NameCase { label: "the row spells claude the way the bytes carry it", actual: dispatch_provider_words.claude as String, expected: "claude" },
    NameCase { label: "the row spells cursor the way the bytes carry it", actual: dispatch_provider_words.cursor as String, expected: "cursor" },
    NameCase { label: "the row spells codex the way the bytes carry it", actual: dispatch_provider_words.codex as String, expected: "codex" },
    NameCase { label: "the row spells the harness word the way the bytes carry it", actual: dispatch_provider_words.gunbc_harness as String, expected: "gunbc-harness" },
    NameCase { label: "the snapshot label for claude is the row's word", actual: credential_snapshot_provider_label(executor: ClaudeFromSnapshot) as String, expected: dispatch_provider_words.claude as String },
    NameCase { label: "the snapshot label for cursor is the row's word", actual: credential_snapshot_provider_label(executor: CursorFromSnapshot) as String, expected: dispatch_provider_words.cursor as String },
    NameCase { label: "the actuator label for claude is the same row's word", actual: dispatch_provider_label(provider: ClaudeCodeProvider), expected: dispatch_provider_words.claude as String },
    NameCase { label: "the actuator label for cursor is the same row's word", actual: dispatch_provider_label(provider: CursorDispatchProvider), expected: dispatch_provider_words.cursor as String },
    NameCase { label: "the actuator label for codex is the same row's word", actual: dispatch_provider_label(provider: CodexDispatchProvider), expected: dispatch_provider_words.codex as String },
    NameCase { label: "the actuator label for the harness is the same row's word", actual: dispatch_provider_label(provider: GunbcHarnessProvider), expected: dispatch_provider_words.gunbc_harness as String },
  ])
}

// THE DERIVED NAME CARRIES THE ROW'S WORD, NOT A LITERAL THE WITNESS INVENTED: same claim shape as the one
// above, but the expected side is built from the row, so it stays green when the row is renamed while the
// literal-pinned claim above goes red. That pair is what the executed control shows: the pin moves, the
// reader-follows-the-row claim does not.
test fn the_snapshot_name_carries_the_provider_word_row() -> ProcessExit {
  let attempt = fx_named_attempt(instance_root: witness_root, node: witness_node, attempt_key: witness_attempt_key)
  let cursor = credential_snapshot_path_for_attempt(attempt: attempt, executor: CursorFromSnapshot) as String
  let stem = join([dashboard_instance_dispatch_attempt_state_root(instance: attempt.instance) as String, "/", attempt_state_entry_name(node: attempt.node.node as String, attempt_key: attempt.attempt_key), "."], "")
  names_agree(cases: [
    NameCase { label: "the cursor snapshot name is stem + the row's word + the suffix row", actual: cursor, expected: join([stem, dispatch_provider_words.cursor as String, taken_credential_snapshot_slots.entry_suffix as String], "") },
    NameCase { label: "the actuator would name the provider the same word", actual: dispatch_provider_label(provider: CursorDispatchProvider), expected: dispatch_provider_words.cursor as String },
  ])
}
