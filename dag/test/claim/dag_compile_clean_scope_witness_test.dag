module test.claim.dag_compile_clean_scope_witness

import tools.dag_compile_clean_scope {
  witness_empty_touched_requires_whole_tree,
  witness_touched_path_dispositions_hold,
  touched_path_disposition_matches,
  scope_disposition_rows,
  ScopeDispositionRow,
  ExpectSkip,
  ExpectScopedContaining,
  ExpectWholeTree,
  witness_entry_roots_are_witness_layer_roots,
  witness_pool_roots_match_witness_layer_roots,
  witness_mixed_rs_and_dag_requires_whole_tree,
  witness_departed_dag_path_requires_whole_tree,
  witness_docs_only_departure_still_skips,
  compile_clean_docs_universe_path_grain_dissolve_trigger
}
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

test fn dag_compile_clean_scope_empty_touched_skips_holds() -> Bool {
  witness_empty_touched_requires_whole_tree()
}

test fn dag_compile_clean_scope_all_disposition_rows_hold() -> Bool {
  witness_touched_path_dispositions_hold()
}

test fn dag_compile_clean_scope_disposition_row_count_pinned() -> Bool {
  fold(scope_disposition_rows, init: 0, f: fn(n, row) { n + 1 }) == 7
}

test fn dag_compile_clean_scope_disposition_core_discriminates() -> Bool {
  let wrong_expectation = ScopeDispositionRow {
    touched: "docs/plans/example.md",
    expect: ExpectWholeTree
  }
  touched_path_disposition_matches(row: wrong_expectation) == false
}

test fn dag_compile_clean_scope_partition_authority_holds() -> Bool {
  witness_entry_roots_are_witness_layer_roots()
    && witness_pool_roots_match_witness_layer_roots()
}

test fn dag_compile_clean_scope_mixed_rs_and_dag_requires_whole_tree() -> Bool {
  witness_mixed_rs_and_dag_requires_whole_tree()
}

test fn dag_compile_clean_scope_departed_dag_path_requires_whole_tree() -> Bool {
  witness_departed_dag_path_requires_whole_tree()
}

test fn dag_compile_clean_scope_docs_only_departure_still_skips() -> Bool {
  witness_docs_only_departure_still_skips()
}

test fn dag_compile_clean_scope_docs_universe_path_grain_dissolve_on_named() -> Bool {
  string_contains(
    s: compile_clean_docs_universe_path_grain_dissolve_trigger,
    pattern: "dissolve-on: compile_clean_docs_universe_path_grain"
  )
}
