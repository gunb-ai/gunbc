// THE READ-ONLY SCAN OF J68, HELD TO WHAT WAS RUN. Two things here are supplied values and not derived
// (gunbc.design_argument::single_authority, a witness discriminates at one interface): the script
// below is, line for line, the one OpenOCD 0.12.0 ran on 2026-11-13 against a simulated TAP built from
// Intel's description, and the designed capture's fields are what that run printed for a boundary
// register holding a known pattern. What that run showed, and no more: against the described device the
// simulated chain latched BYPASS at start-up and then IDCODE, USERCODE and SAMPLE; against a device with
// another word, against one with a fourteen-bit instruction register, and against the described device
// with its TDO held at either level, it latched the all-ones code at start-up and nothing else, and the
// script printed NOT THE EXPECTED DEVICE. The simulator is not in the repository, so that is a scoped
// observation of one version; what this file holds to is the emitted lines and the policy that the
// start-up's own instruction is named and admitted. The inhabitance claim these owe, that the real
// carrier's FPGA answers the same script, is the operator's scan of J68. Its first rung was taken on
// 2026-11-13 on the lot E1 and is recorded against that carrier in product.p4261.readings
// p4261_j68_chain_scans; the second rung, the steps and the capture, is still owed.

data description: BoundaryScanDescription = cyclone_10_gx_10cx085_f672_boundary_scan

data script_that_ran: List<String> = [
  "if \{[string first \{0.12.0} [version]] < 0} \{ echo \{UNTESTED OPENOCD VERSION: stopped before the chain was touched} ; shutdown }",
  "jtag newtap c10gx tap -irlen 60 -expected-id 49225949",
  "init",
  "if \{[jtag cget c10gx.tap -idcode] != 49225949} \{ echo \{NOT THE EXPECTED DEVICE: stopped before any scan step} ; shutdown }",
  "echo [format \{IDENTIFIED 0x%08x} [jtag cget c10gx.tap -idcode]]",
  "irscan c10gx.tap 6755399441055744",
  "echo [concat IDCODE [drscan c10gx.tap 32 0]]",
  "irscan c10gx.tap 7881299347898368",
  "echo [concat USERCODE [drscan c10gx.tap 32 0]]",
  "irscan c10gx.tap 5629499534213120",
  "echo [concat SAMPLE [drscan c10gx.tap 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 32 0 27 0]]",
  "shutdown",
]

// THE DESIGNED CAPTURE: cell n is high exactly when n mod 7 is 3, or n is 0, or n is 1338.
fn designed_level(n: Nat) -> Bool {
  n % 7 == 3 || n == 0 || n == 1338
}

