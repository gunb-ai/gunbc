fn settled_captures() -> List<BoundaryCapture> {
  match p4261_j68_capture_series.first() {
    Present { value: s } => s.captures
    Absent => []
  }
}

fn settled(n: Nat) -> List<BoundaryCapture> {
  take_prefix(xs: skip(xs: settled_captures(), n: n), n: 1)
}

fn with_fields(captures: List<BoundaryCapture>, fields: List<NonEmptyStr>) -> List<BoundaryCapture> {
  map(captures, c => BoundaryCapture { idcode: c.idcode, usercode: c.usercode, sample_fields: fields })
}

fn with_codes(captures: List<BoundaryCapture>, idcode: NonEmptyStr, usercode: NonEmptyStr) -> List<BoundaryCapture> {
  map(captures, c => BoundaryCapture { idcode: idcode, usercode: usercode, sample_fields: c.sample_fields })
}

fn supplied_series(between: CaptureIntervention, captures: List<BoundaryCapture>) -> List<BoundaryCaptureSeries> {
  [BoundaryCaptureSeries { carrier: p4261_e1_c, read_on: "supplied", board_state: "supplied", between: between, captures: captures, evidence: e1_j68_labelled_photo }]
}

fn capture_observations(captures: List<BoundaryCapture>) -> List<List<PinObservation>> {
  map(captures, c => match read_sample(d: description, fields: map(c.sample_fields, f => f as String)) {
    Present { value: readings } => pin_observations(readings: readings)
    Absent => []
  })
}

fn pin_value(observations: List<PinObservation>, port: String) -> Bool? {
  flat_map(observations, o => match o {
    PinLevel { port: _, level: _ } => []
    PinDrive { port: p, value, driving: _ } => if (p as String) == port { [value] } else { [] }
  }).first()
}

fn values_read(series: List<List<PinObservation>>, read: fn(List<PinObservation>) -> Bool?) -> String {
  join(map(series, o => match read(o) { Present { value: v } => if v { "1" } else { "0" }, Absent => "?" }), "")
}

fn standing_on(series: List<BoundaryCaptureSeries>) -> U4DesignStanding {
  u4_design_standing(carrier: p4261_e1_c, revision: p4261_e1, series: series)
}

fn nothing_moved_with(s: U4DesignStanding, drivers: Nat) -> Bool {
  match s {
    UserDriversOnNothingMoved { user_drivers_on, holds_if_high } => user_drivers_on == drivers && same_lines(a: map(holds_if_high, s => s as String), b: ["nCONFIG", "nSTATUS"])
    _ => false
  }
}

fn not_read(s: U4DesignStanding) -> Bool {
  match s {
    SeriesNotRead { why: _ } => true
    _ => false
  }
}

// U4 IS RUNNING A DESIGN ON THE LOT E1. In all three settled captures 141 user pins are driven, and eight
// user pins changed between them with nothing changed on the board, first seen first. Read on the
// record as it stands, that is the lot E1's and no other carrier's: the E1-b has no capture series.
test fn the_settled_captures_on_the_lot_e1_show_a_design_running() -> Bool {
  match u4_design_standing(carrier: p4261_e1_c, revision: p4261_e1, series: p4261_j68_capture_series) {
    UserDesignActivityObserved { user_drivers_on, moved, holds_if_high } => user_drivers_on == 141
      && same_lines(a: map(moved, p => p as String), b: ["IOP5", "IOR5", "IOP4", "IOP3", "IOC18", "IOA4", "IOY14", "IOAC13"])
      && same_lines(a: map(holds_if_high, s => s as String), b: ["nCONFIG", "nSTATUS"])
    _ => false
  } && match u4_design_standing(carrier: p4261_e1_b, revision: p4261_e1, series: p4261_j68_capture_series) {
    NoCaptureSeries => true
    _ => false
  } && match u4_design_standing(carrier: p4261_k1_a, revision: p4261_k1, series: p4261_j68_capture_series) {
    UserDesignActivityObserved { user_drivers_on: _, moved: _, holds_if_high: _ } => false
    _ => true
  }
}

// WHAT THE THREE CAPTURES HOLD, PORT BY PORT. The same word and user code each time; the straps read 010
// (active serial from an EPCQ-L flash, fast power-on reset) and nIO_PULLUP 1 (pull-ups off) in every
// capture; the three flash selects driven high, deselected, in every capture. Three driven user pins
// changed: IOR5 0, 1, 1; IOP3 1, 0, 0; IOC18 1, 0, 1, each with its driver on throughout; and IOY14, an
// input whose driver is off, read 0, 1, 0.
test fn what_the_three_settled_captures_hold() -> Bool {
  let captures = settled_captures()
  let observations = capture_observations(captures: captures)
  count(captures) == 3
    && all(captures, c => (c.idcode as String) == "02ef20dd" && (c.usercode as String) == "09b67fc9" && count(c.sample_fields) == 42)
    && all(captures, c => any(u4_report(fields: map(c.sample_fields, f => f as String)), l => starts_with(s: l, prefix: "mode select MSEL2 MSEL1 MSEL0 = 010: active serial x1 from a EPCQ-L flash")))
    && all(captures, c => any(u4_report(fields: map(c.sample_fields, f => f as String)), l => l == "nIO_PULLUP = 1: weak pull-ups on the user pins before and during configuration OFF"))
    && values_read(series: observations, read: o => pin_value(observations: o, port: "IOR5")) == "011"
    && values_read(series: observations, read: o => pin_value(observations: o, port: "IOP3")) == "100"
    && values_read(series: observations, read: o => pin_value(observations: o, port: "IOC18")) == "101"
    && values_read(series: observations, read: o => pin_driving(observations: o, port: "IOC18")) == "111"
    && values_read(series: observations, read: o => pin_level(observations: o, port: "IOY14")) == "010"
    && values_read(series: observations, read: o => pin_driving(observations: o, port: "IOY14")) == "000"
    && values_read(series: observations, read: o => pin_value(observations: o, port: "nCSO0")) == "111"
    && values_read(series: observations, read: o => pin_driving(observations: o, port: "nCSO2")) == "111"
}

// THE STANDING CARRIES ITS CONDITION, AND SO DOES ITS TEXT. A boundary scan reads the pins only while
// nCONFIG and nSTATUS are high, and neither has a cell; the standing names them and the printed line
// says the conclusion holds only if they were high.
test fn the_design_standing_says_when_it_holds() -> Bool {
  let text = design_standing_text(s: u4_design_standing(carrier: p4261_e1_c, revision: p4261_e1, series: p4261_j68_capture_series))
  starts_with(s: text, prefix: "U4 is running a design: 141 user pins driven, and 8 user pins changed between captures with nothing changed on the board")
    && text.contains("this holds only if nCONFIG and nSTATUS were high when the captures were taken, which they cannot show")
    && design_standing_text(s: NoCaptureSeries) == "no capture series is recorded for this carrier"
}

// ONLY A USER PIN THAT CHANGES WITH NOTHING CHANGED IS ACTIVITY. Three copies of one capture show the
// drivers and nothing moving; a flipped transmitter cell, which SAMPLE does not read, and a flipped
// internal cell are not a pin moving; a capture with every user driver off is not a design driving. A
// series with a control changed shows a response, not activity, and a series that does not read, has
// one capture, or disagrees on the user code or the word says nothing.
test fn only_a_user_pin_changing_with_nothing_changed_is_activity() -> Bool {
  let one = settled(n: 0)
  let all_three = settled_captures()
  nothing_moved_with(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(concat(one, one), one))), drivers: 141)
    && nothing_moved_with(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(one, with_fields(captures: one, fields: settled_one_transceiver_cell_flipped)))), drivers: 141)
    && nothing_moved_with(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(one, with_fields(captures: one, fields: settled_one_internal_cell_flipped)))), drivers: 141)
    && match standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: with_fields(captures: concat(one, one), fields: settled_one_no_user_driver))) { NoUserDriverOn { holds_if_high } => count(holds_if_high) == 2, _ => false }
    && match standing_on(series: supplied_series(between: OneControlChanged { control: "S1, one pole" }, captures: all_three)) { SeriesShowsAResponse { control } => (control as String) == "S1, one pole", _ => false }
    && not_read(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: one)))
    && not_read(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(one, with_fields(captures: one, fields: take_prefix(xs: settled_one_internal_cell_flipped, n: 41))))))
    && not_read(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(one, with_codes(captures: one, idcode: "02ef20dd", usercode: "ffffffff")))))
    && not_read(s: standing_on(series: supplied_series(between: NothingChangedBetweenCaptures, captures: concat(one, with_codes(captures: one, idcode: "02e660dd", usercode: "09b67fc9")))))
}
