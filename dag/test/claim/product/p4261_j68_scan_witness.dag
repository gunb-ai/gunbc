// The first settled capture with every user pin's control cell at its disabling value (216 drivers off).
data settled_one_no_user_driver: List<NonEmptyStr> = [
  "08b6db6d", "249020b6", "59249249", "927b2692", "24924924", "49249249", "92492492",
  "24924924", "49249249", "92492492", "24924924", "49249249", "92492492", "24924924",
  "49249249", "92492492", "24924924", "ffffb249", "d249a5ff", "24ba4925", "49ae9f7d",
  "dfe92492", "b6db6dbe", "6db6ff6f", "ffffbffb", "6d97ffff", "ffa4baeb", "d7ffb493",
  "fefa4fa6", "ffffdb5f", "97ed34d2", "bffb5fa6", "5dfed75f", "db6db6db", "f6dffff6",
