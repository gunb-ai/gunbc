// ── HELPERS ───────────────────────────────────────────────────────────────────────────────────

fn with_parts(base: CarrierLayoutObservation, components: List<InstalledComponent>, readings: List<DesignatorReading>) -> CarrierLayoutObservation {
  CarrierLayoutObservation {
    asset: base.asset, design: base.design, revision: base.revision, markings: base.markings, module_receptacles: base.module_receptacles,
    backplane_connectors: base.backplane_connectors, j20: base.j20, j20_calipers: base.j20_calipers, edge_high_speed_connectors: base.edge_high_speed_connectors,
    management_io_survey: base.management_io_survey, management_io: base.management_io, components: components, measured: base.measured, input: base.input,
    unresolved: base.unresolved, designator_readings: readings,
  }
}

// A second E1 held under another asset and its own identity space, with the E1-B's records copied.
fn second_e1(components: List<InstalledComponent>, readings: List<DesignatorReading>) -> CarrierLayoutObservation {
  let b = p4261_e1_layout
  CarrierLayoutObservation {
    asset: "p4261-e1-supplied-second" as PhysicalAssetIdentity, design: "p4261-e1-supplied-second" as ElectricalDesignIdentity, revision: b.revision, markings: b.markings,
    module_receptacles: b.module_receptacles, backplane_connectors: b.backplane_connectors, j20: b.j20, j20_calipers: b.j20_calipers,
    edge_high_speed_connectors: b.edge_high_speed_connectors, management_io_survey: b.management_io_survey, management_io: b.management_io,
    components: components, measured: Absent, input: Absent, unresolved: b.unresolved, designator_readings: readings,
  }
}

fn photo() -> EvidenceRef {
  OperatorPhotograph { taken_on: "supplied", locator: "supplied photograph" }
}

fn read(c: ComponentInstanceIdentity, d: NonEmptyStr) -> DesignatorReading {
  DesignatorReading { specimen: c, designator: d, evidence: photo() }
}

fn e1_at(d: NonEmptyStr) -> P4261DesignPosition {
  match (filter(p4261_e1_positions, p => (p.position.designator as String) == (d as String))).first() {
    Present { value: p } => p
    Absent => P4261DesignPosition { position: p4261_position(revision: p4261_e1, designator: d), population: Absent }
  }
}

fn k1_at(d: NonEmptyStr) -> P4261DesignPosition {
  match (filter(p4261_k1_positions, p => (p.position.designator as String) == (d as String))).first() {
    Present { value: p } => p
    Absent => P4261DesignPosition { position: p4261_position(revision: p4261_k1, designator: d), population: Absent }
  }
}

fn assess_on(layout: CarrierLayoutObservation, p: P4261DesignPosition) -> PopulationOutcome {
  assess_population(position: p, layout: layout, admitted: admit_correspondence(layout: layout).admitted).outcome
}

fn supported(o: PopulationOutcome) -> Bool {
  match o {
    SupportedOnSpecimen { supporting } => count(supporting) > 0
    EvidenceMissing { undecided: _ } => false
    Contradicted { contradicting: _, supporting: _ } => false
    NotAttributable { gap: _ } => false
  }
}

fn missing(o: PopulationOutcome) -> Bool {
  match o {
    EvidenceMissing { undecided: _ } => true
    SupportedOnSpecimen { supporting: _ } => false
    Contradicted { contradicting: _, supporting: _ } => false
    NotAttributable { gap: _ } => false
  }
}

fn contradicted_with(o: PopulationOutcome, against: Nat, with_support: Nat) -> Bool {
  match o {
    Contradicted { contradicting, supporting } => count(contradicting) == against && count(supporting) == with_support
    SupportedOnSpecimen { supporting: _ } => false
    EvidenceMissing { undecided: _ } => false
    NotAttributable { gap: _ } => false
  }
}

fn no_claim(o: PopulationOutcome) -> Bool {
  match o {
    NotAttributable { gap } => match gap { NoPopulationClaim => true, _ => false }
    _ => false
  }
}

fn no_reading(o: PopulationOutcome) -> Bool {
  match o {
    NotAttributable { gap } => match gap { NoAdmittedReading => true, _ => false }
    _ => false
  }
}

fn refused_as(r: CorrespondenceRefusal, want: Nat) -> Bool {
  match r {
    SpecimenOfAnotherBoard { reading: _ } => want == 0
    NoSuchPosition { reading: _ } => want == 1
    PositionListedTwice { reading: _ } => want == 2
    SpecimenReadUnderTwoDesignators { reading: _ } => want == 3
  }
}

fn receipt_on(s: CitedFigureStanding, decl: String) -> Bool {
  match s {
    ObservedByReceipt { observed } => (observed_receipt_ref(observed: observed).decl_name as String) == decl
    _ => false
  }
}

fn standing_at(ss: List<PositionStanding>, d: String) -> PositionStanding? {
  (filter(ss, s => (s.assessment.position.position.designator as String) == d)).first()
}

fn conclusion_at(c: P4261Comparison, d: String) -> PositionConclusion? {
  match (filter(c.positions, p => (p.designator as String) == d)).first() {
    Absent => Absent
    Present { value: p } => Present { value: p.conclusion }
  }
}

fn e1_side_receipt(c: P4261Comparison, d: String) -> Bool {
  match (filter(c.positions, p => (p.designator as String) == d)).first() {
    Absent => false
    Present { value: p } => match p.e1.claim { Absent => false, Present { value: s } => receipt_on(s: s.standing, decl: "p4261_e1_layout") }
  }
}

fn is_same_part(c: PositionConclusion?) -> Bool {
  match c {
    Absent => false
    Present { value: x } => match x { SameIdentifiedPart { row: _ } => true, _ => false }
  }
}

fn incomplete_on(c: PositionConclusion?, boards: Nat) -> Bool {
  match c {
    Absent => false
    Present { value: x } => match x { ComparisonIncomplete { boards: bs } => count(bs) == boards, _ => false }
  }
}

fn identified(c: ComponentInstanceIdentity, row: ElectronicComponentRow) -> InstalledComponent {
  InstalledComponent { seen: seen_unordered(), component: c, terminals: [], identification: IdentifiedByMarking { row: row, marking: MarkingReading { text: "supplied", evidence: photo() } } }
}

fn with_seen(cs: List<InstalledComponent>, c: ComponentInstanceIdentity) -> List<InstalledComponent> {
  map(cs, x => if component_identity_eq(a: x.component, b: c) { InstalledComponent { seen: seen_unordered(), component: x.component, terminals: x.terminals, identification: x.identification } } else { x })
}

// ── CORRESPONDENCE ────────────────────────────────────────────────────────────────────────────

// A COMPONENT IS BOUND ONLY TO ITS OWN BOARD'S REVISION, AND NEVER BY THE FIRST OF TWO READINGS. Every
// reading on both held boards is admitted. On the E1: a K1 component's reading is refused as another
// board's; a designator only the K1's catalogue lists names no E1 position; Q21_P5 read also as Q22_P5
// has both readings refused and neither admitted.
test fn a_component_is_bound_only_to_its_own_boards_revision() -> Bool {
  let e1 = admit_correspondence(layout: p4261_e1_layout)
  let k1 = admit_correspondence(layout: p4261_k1_layout)
  let foreign = admit_correspondence(layout: with_parts(base: p4261_e1_layout, components: p4261_e1_layout.components, readings: [read(c: k1_u1_p5, d: "U1_P5")]))
  let k1_only = admit_correspondence(layout: with_parts(base: p4261_e1_layout, components: p4261_e1_layout.components, readings: [read(c: e1_converter_near, d: "U2_P2")]))
  let twice = admit_correspondence(layout: with_parts(base: p4261_e1_layout, components: p4261_e1_layout.components, readings: [read(c: e1_q21, d: "Q21_P5"), read(c: e1_q21, d: "Q22_P5"), read(c: e1_u1_p5, d: "U1_P5")]))
  count(e1.refused) == 0 && count(e1.admitted) == count(p4261_e1_layout.designator_readings)
    && count(k1.refused) == 0 && count(k1.admitted) == count(p4261_k1_layout.designator_readings)
    && count(foreign.admitted) == 0 && all(foreign.refused, r => refused_as(r: r, want: 0)) && count(foreign.refused) == 1
    && count(k1_only.admitted) == 0 && all(k1_only.refused, r => refused_as(r: r, want: 1)) && count(k1_only.refused) == 1
    && count(twice.admitted) == 1 && count(twice.refused) == 2 && all(twice.refused, r => refused_as(r: r, want: 3))
}

// ── POPULATION SEMANTICS ──────────────────────────────────────────────────────────────────────

// EACH OBSERVATION BEARS BY WHAT IT ESTABLISHES. On the E1: U1_P5's matched marking supports its row; D2's
// code shared by two makers supports the claim constrained to those two rows; F300's printed rating
// supports the rating claim; the converter's candidate marking and Q300's leave their claims missing;
// U2_P5's empty footprint carries no claim. On the K1: F300's rating, read only off the seller's
// listing, does not support; the converter's pre-lift marking does, its later footprint being the one
// we emptied. Supported claims carry a receipt naming their own board's record; the rest keep their
// authored standing.
test fn each_observation_bears_by_what_it_establishes() -> Bool {
  let e1 = p4261_e1_layout
  let k1 = p4261_k1_layout
  let e1s = p4261_e1_population_standings()
  let k1s = p4261_k1_population_standings()
  supported(o: assess_on(layout: e1, p: e1_at(d: "U1_P5")))
    && supported(o: assess_on(layout: e1, p: e1_at(d: "D2")))
    && supported(o: assess_on(layout: e1, p: e1_at(d: "F300")))
    && missing(o: assess_on(layout: e1, p: e1_at(d: "U10_P2")))
    && missing(o: assess_on(layout: e1, p: e1_at(d: "Q300")))
    && no_claim(o: assess_on(layout: e1, p: e1_at(d: "U2_P5")))
    && missing(o: assess_on(layout: k1, p: k1_at(d: "F300")))
    && supported(o: assess_on(layout: k1, p: k1_at(d: "U10_P2")))
    && supported(o: assess_on(layout: k1, p: k1_at(d: "U1_P5")))
    && match standing_at(ss: e1s, d: "U1_P5") { Present { value: s } => receipt_on(s: s.standing, decl: "p4261_e1_layout"), Absent => false }
    && match standing_at(ss: e1s, d: "U10_P2") { Present { value: s } => match s.standing { TranscribedUncited { read_obligation: _ } => true, _ => false }, Absent => false }
    && match standing_at(ss: k1s, d: "U10_P2") { Present { value: s } => receipt_on(s: s.standing, decl: "p4261_k1_layout"), Absent => false }
    && match standing_at(ss: k1s, d: "F300") { Present { value: s } => match s.standing { TranscribedUncited { read_obligation: _ } => true, _ => false }, Absent => false }
}

// AN EMPTY FOOTPRINT CONTRADICTS A CLAIM UNLESS WE EMPTIED IT. A supplied claim at F302 (read empty on the
// E1, no removal recorded there) is contradicted; the K1's U10_P2 footprint, seen after the K1's own
// lift of the part admitted at that position, does not contradict its claim.
test fn an_empty_footprint_contradicts_unless_we_emptied_it() -> Bool {
  let claimed_f302 = P4261DesignPosition { position: p4261_position(revision: p4261_e1, designator: "F302"), population: Present { value: PopulationClaim { part: PartRow { row: tmp275_dgk }, standing: TranscribedUncited { read_obligation: "supplied" } } } }
  contradicted_with(o: assess_on(layout: p4261_e1_layout, p: claimed_f302), against: 1, with_support: 0)
    && supported(o: assess_on(layout: p4261_k1_layout, p: k1_at(d: "U10_P2")))
}

// ── SUPPORT IS ON ONE BOARD ───────────────────────────────────────────────────────────────────

// THE E1-B'S SUPPORT IS NOT ANOTHER E1'S. A second E1 with nothing read is assessed as having no admitted
// reading; given the E1-B's components and readings copied verbatim, those readings name the E1-B's
// identity space and are refused as another board's, so its outcome is the same -- never the E1-B's
// support under another asset.
test fn one_boards_support_is_not_another_of_its_revision() -> Bool {
  let bare = second_e1(components: [], readings: [])
  let copied = second_e1(components: p4261_e1_layout.components, readings: p4261_e1_layout.designator_readings)
  supported(o: assess_on(layout: p4261_e1_layout, p: e1_at(d: "U1_P5")))
    && no_reading(o: assess_on(layout: bare, p: e1_at(d: "U1_P5")))
    && no_reading(o: assess_on(layout: copied, p: e1_at(d: "U1_P5")))
    && count(admit_correspondence(layout: copied).admitted) == 0
}

// ── HISTORICAL INSTALLATION ───────────────────────────────────────────────────────────────────

// A PART SEEN BEFORE ITS REMOVAL STAYS SEEN FITTED. The E1's converter, photographed before the lift, was
// fitted when seen and is removed after the record; U1_P5, never removed, is neither. Restated with no
// order against the lift, the converter observation supplies no fitted-state evidence, and the K1's
// supported U10_P2 claim falls to missing.
test fn a_part_seen_before_its_removal_stays_seen_fitted() -> Bool {
  let e1 = p4261_e1_layout
  let rec = match e1.measured { Present { value: b } => b.bench, Absent => no_bench_record }
  let seen_converter = (filter(e1.components, c => component_identity_eq(a: c.component, b: e1_converter_near))).first()
  let unordered_k1 = with_parts(base: p4261_k1_layout, components: with_seen(cs: p4261_k1_layout.components, c: k1_converter_near), readings: p4261_k1_layout.designator_readings)
  match seen_converter {
    Absent => false
    Present { value: c } =>
      match fitted_at_observation(r: rec, asset: e1.asset, c: c.component, seen: c.seen) { SeenFitted => true, _ => false }
        && match installation_after_record(r: rec, asset: e1.asset, c: c.component) { RemovedBy { key } => (key as String) == (e1_u10p2_lift.key as String), _ => false }
        && match installation_after_record(r: rec, asset: e1.asset, c: e1_u1_p5) { NotRemovedByRecord => true, _ => false }
        && match fitted_at_observation(r: rec, asset: e1.asset, c: c.component, seen: seen_unordered()) { FittedOrderUnknown => true, _ => false }
        && missing(o: assess_on(layout: unordered_k1, p: k1_at(d: "U10_P2")))
  }
}

// ── CONTRADICTION ─────────────────────────────────────────────────────────────────────────────

// A DISAGREEING OBSERVATION IS NEVER HIDDEN BY AN AGREEING ONE, IN EITHER ORDER. A second E1 component
// admitted at U1_P5 whose marking matches another row makes the claim contradicted, with both the
// disagreeing and the agreeing observation returned, whichever is listed first.
test fn a_disagreeing_observation_is_never_hidden() -> Bool {
  let other = component_instance_identity(design: e1_design, local_identity: "supplied second part read at U1_P5")
  let readings = concat(p4261_e1_layout.designator_readings, [read(c: other, d: "U1_P5")])
  let after = with_parts(base: p4261_e1_layout, components: concat(p4261_e1_layout.components, [identified(c: other, row: tmp275_dgk)]), readings: readings)
  let before = with_parts(base: p4261_e1_layout, components: concat([identified(c: other, row: tmp275_dgk)], p4261_e1_layout.components), readings: readings)
  contradicted_with(o: assess_on(layout: after, p: e1_at(d: "U1_P5")), against: 1, with_support: 1)
    && contradicted_with(o: assess_on(layout: before, p: e1_at(d: "U1_P5")), against: 1, with_support: 1)
}

// ── COMPARISON ────────────────────────────────────────────────────────────────────────────────

// SETS ARE COMPARED CONSERVATIVELY. One row each, the same: the same part. Disjoint: different parts.
// Equal shared sets: the same candidate constraint, not the same part. Overlapping unequal sets: the
// difference is undetermined.
test fn row_sets_are_compared_conservatively() -> Bool {
  let shared = [tvs_5_0smdj60a, aos_tvs_5_0smdj60a]
  match rows_conclusion(a: [lm5066i_pwp], b: [lm5066i_pwp]) { SameIdentifiedPart { row: _ } => true, _ => false }
    && match rows_conclusion(a: [lm5066i_pwp], b: [tmp275_dgk]) { DifferentParts { e1: _, k1: _ } => true, _ => false }
    && match rows_conclusion(a: shared, b: shared) { SameCandidateConstraint { rows: _ } => true, _ => false }
    && match rows_conclusion(a: shared, b: [tvs_5_0smdj60a]) { DifferenceUndetermined { e1: _, k1: _ } => true, _ => false }
    && match rows_conclusion(a: [aos_tvs_5_0smdj60a, mp2333cgtl], b: [tvs_5_0smdj60a, aos_tvs_5_0smdj60a]) { DifferenceUndetermined { e1: _, k1: _ } => true, _ => false }
}

// THE HELD BOARDS, COMPARED. U1_P5 reads the same LM5066I on both; U10_P2 is incomplete, the E1's marking
// being a candidate; F300 is incomplete, the K1's rating read only off the listing (and a rating names
// no row). The E1's side at U1_P5 carries its claim's minted receipt, so the comparison reads the
// assessment folds, not the authored rows. The rendered comparison carries those conclusions, and the
// power-path obligation of every GH200 assembly reads it.
test fn the_held_boards_are_compared_label_by_label() -> Bool {
  let c = p4261_comparison()
  let text = population_comparison_text(c: c)
  is_same_part(c: conclusion_at(c: c, d: "U1_P5"))
    && e1_side_receipt(c: c, d: "U1_P5")
    && incomplete_on(c: conclusion_at(c: c, d: "U10_P2"), boards: 1)
    && incomplete_on(c: conclusion_at(c: c, d: "F300"), boards: 2)
    && count(c.positions) > 0
    && text.contains("U1_P5 both read Texas Instruments Incorporated")
    && text.contains("not an established circuit correspondence")
}
