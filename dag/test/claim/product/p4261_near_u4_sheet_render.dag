module test.claim.product.p4261_near_u4_sheet_render

// Writes the near-U4 converter sheet's drawing, generated from product.p4261.near_u4_converter_sheet, to the
// path given: gunbc run --entry this file --function render_near_u4_sheet --arg path=<file.svg>. The drawing
// is a view of the rows, regenerated whenever they change; it is never edited by hand.
import std.types { NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import product.p4261.near_u4_converter_sheet { near_u4_converter_sheet, near_u4_sheet_svg, sheet_drawable }

fn render_near_u4_sheet(path: NonEmptyStr) -> ProcessExit {
  if !sheet_drawable(s: near_u4_converter_sheet) { exit_failure(reason: "a text on the sheet holds '&' or '<' and would draw broken SVG") } else {
    let w = Filesystem.Write(path: path as String, content: near_u4_sheet_svg())
    if w.success { ExitSuccess } else { exit_failure(reason: w.error) }
  }
}
