module test.claim.product.p4261_ranger_start_sequence_witness

import std.types { List, NonEmptyStr }
import extdeps.nvidia.gracebmc_ranger { ranger_lines, ranger_start_steps, set, RunPower }
import product.p4261.ranger_start_sequence {
  lines_changing_for_run,
  changing_but_not_in_the_summary,
  reported_lines_changing_for_run,
  steps_naming_no_listed_line,
  level_after,
  steps_through_standby,
  lot_e1_218_standing,
  is_on_ladder,
  OnRangerLadder,
  RangerBmcReady,
  below_ranger_standby,
  lot_e1_218_forced_watts,
  total_watts,
  milliamps_at_48_volts,
  ranger_power_host_off,
  ranger_power_at_start,
  ranger_power_at_owner_limit,
  start_sequence_lines,
}

// Every step names a listed line, and the sequence prints one line per step.
test fn every_step_names_a_listed_line() -> Bool {
  count(steps_naming_no_listed_line(lines: ranger_lines, steps: ranger_start_steps)) == 0
    && count(start_sequence_lines()) == count(ranger_start_steps)
    && count(steps_naming_no_listed_line(lines: ranger_lines, steps: concat(ranger_start_steps, [set(phase: RunPower, line: "NO_SUCH_LINE", level: 1)]))) == 1
}

// From the steps, six lines differ between standby and running: the five the owner summed up and
// LOCAL_RUN_PWR_EN, which the summary leaves out. That one line is the question owed to the owner.
test fn the_steps_change_one_line_more_than_the_summary() -> Bool {
  count(lines_changing_for_run(lines: ranger_lines, steps: ranger_start_steps)) == 6
    && all(reported_lines_changing_for_run, n => any(lines_changing_for_run(lines: ranger_lines, steps: ranger_start_steps), l => l.name == n))
    && count(changing_but_not_in_the_summary(lines: ranger_lines, steps: ranger_start_steps)) == 1
    && all(changing_but_not_in_the_summary(lines: ranger_lines, steps: ranger_start_steps), l => l.name == "LOCAL_RUN_PWR_EN")
}

// What standby leaves in place before run power: the shutdown and brake lines at 1, the FPGA released and
// ready, the controller ready, and the system reset still held at 0 with run power off.
test fn standby_ends_with_reset_held_and_run_power_off() -> Bool {
  let standby = steps_through_standby(steps: ranger_start_steps)
  level_after(steps: standby, line: "SHDN_REQ_L") == 1
    && level_after(steps: standby, line: "SHDN_FORCE_L") == 1
    && level_after(steps: standby, line: "PWR_BRAKE_L") == 1
    && level_after(steps: standby, line: "FPGA_RST_L") == 1
    && level_after(steps: standby, line: "FPGA_READY") == 1
    && level_after(steps: standby, line: "BMC_READY") == 1
    && level_after(steps: standby, line: "SYS_RST_IN_L") == 0
    && level_after(steps: standby, line: "RUN_POWER_EN") == 0
    && level_after(steps: ranger_start_steps, line: "SYS_RST_IN_L") == 1
    && level_after(steps: ranger_start_steps, line: "RUN_POWER_EN") == 1
}

// The lot board's forced state is not on the ladder, and its 16 W is below that tray's 34 W with the host
// off; a state on the ladder reads as one, and 34 W would not be below.
test fn the_forced_state_is_off_the_ladder_and_below_standby() -> Bool {
  !is_on_ladder(s: lot_e1_218_standing)
    && is_on_ladder(s: OnRangerLadder { state: RangerBmcReady })
    && below_ranger_standby(watts: lot_e1_218_forced_watts)
    && !below_ranger_standby(watts: 34)
    && total_watts(p: ranger_power_host_off) == 34
}

// The supply a real start needs, from the reported figures: about 4.1 A at 48 V just after power-on and
// about 9.3 A at that owner's limit, so a 1 A limit stops a start that is working.
test fn a_real_start_needs_more_than_one_amp() -> Bool {
  total_watts(p: ranger_power_at_start) == 199
    && milliamps_at_48_volts(p: ranger_power_at_start) > 4000
    && milliamps_at_48_volts(p: ranger_power_at_owner_limit) > 9000
    && milliamps_at_48_volts(p: ranger_power_host_off) < 1000
}
