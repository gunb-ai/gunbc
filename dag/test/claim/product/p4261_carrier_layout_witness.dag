// ── HELPERS ───────────────────────────────────────────────────────────────────────────────────

fn layout_with(base: CarrierLayoutObservation, components: List<InstalledComponent>, measured: MeasuredBoard?, input: InputConnector?) -> CarrierLayoutObservation {
  CarrierLayoutObservation {
    asset: base.asset,
    design: base.design,
    markings: base.markings,
    module_receptacles: base.module_receptacles,
    backplane_connectors: base.backplane_connectors,
    j20: base.j20,
    j20_calipers: base.j20_calipers,
    edge_high_speed_connectors: base.edge_high_speed_connectors,
    management_io_survey: base.management_io_survey,
    management_io: base.management_io,
    components: components,
    measured: measured,
    input: input,
    unresolved: base.unresolved,
  }
}

fn e1_with_continuity(cs: List<ContinuityObservation>) -> CarrierLayoutObservation {
  layout_with(base: p4261_e1_layout, components: p4261_e1_layout.components, measured: Present { value: MeasuredBoard { asset: e1_measured.asset, continuity: cs, diode_readings: e1_measured.diode_readings, source_draws: e1_measured.source_draws, bench: e1_measured.bench } }, input: p4261_e1_layout.input)
}

fn component_of(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> List<InstalledComponent> {
  filter(layout.components, x => component_identity_eq(a: x.component, b: c))
}

fn placement_of(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> List<AcrossInputStanding> {
  map(component_of(layout: layout, c: c), x => across_input(layout: layout, c: x))
}

fn is_unplaced(s: AcrossInputStanding) -> Bool {
  match s {
    AcrossInput { component: _, on_fused: _, on_return: _, fused_path: _, return_path: _ } => false
    AcrossInputContradicted { component: _, readings: _ } => false
    AcrossInputUnestablished { component: _, gap } => match gap {
      TerminalsNotPlaced => true
      _ => false
    }
  }
}

fn bound_volts(b: InputBoundStanding) -> Nat {
  match b {
    BoundEstablished { bound, equally_limiting: _, observed: _ } => volt_count(v: bound.rated.maximum)
    BoundContradicted { contradicted: _, observed: _ } => 0
    BoundUnestablished { observed: _ } => 0
  }
}

fn bound_limiter_is(b: InputBoundStanding, c: ComponentInstanceIdentity) -> Bool {
  match b {
    BoundEstablished { bound, equally_limiting: _, observed: _ } => component_identity_eq(a: bound.limiting_component, b: c)
    BoundContradicted { contradicted: _, observed: _ } => false
    BoundUnestablished { observed: _ } => false
  }
}

fn bound_ties(b: InputBoundStanding) -> List<ComponentInstanceIdentity> {
  match b {
    BoundEstablished { bound: _, equally_limiting, observed: _ } => map(equally_limiting, x => x.limiting_component)
    BoundContradicted { contradicted: _, observed: _ } => []
    BoundUnestablished { observed: _ } => []
  }
}

fn is_unestablished_bound(b: InputBoundStanding) -> Bool {
  match b {
    BoundEstablished { bound: _, equally_limiting: _, observed: _ } => false
    BoundContradicted { contradicted: _, observed: _ } => false
    BoundUnestablished { observed: _ } => true
  }
}

fn supplied_said() -> EvidenceRef {
  OperatorStatement { stated_on: "supplied", verbatim: "supplied" }
}

fn read(a: ElectricalTerminalRef, b: ElectricalTerminalRef, result: ContinuityResult) -> ContinuityObservation {
  ContinuityObservation { asset: p4261_e1_b, first: a, second: b, record: both_points_recorded, conditions: e1_bench, result: result, evidence: supplied_said() }
}

fn positive_term() -> TerminalIdentity {
  "positive" as TerminalIdentity
}

fn negative_term() -> TerminalIdentity {
  "negative" as TerminalIdentity
}

// ── THE K1: its listing photographs, and nothing measured on another board ───────────────────

// The K1 has no measured board, so every rated part is an observed rating with no placement and the
// photographs establish NO bound; the 75 V fuse and the 100 V MOSFETs are carried, never promoted.
test fn the_photographs_establish_no_input_bound() -> Bool {
  match input_bound(layout: p4261_k1_layout) {
    BoundUnestablished { observed } =>
      any(observed, o => volt_count(v: o.rated.maximum) == 75) && any(observed, o => volt_count(v: o.rated.maximum) == 100)
        && all(observed, o => match o.placement {
          AcrossInputUnestablished { component: _, gap } => match gap {
            InputPolarityNotEstablished => true
            _ => false
          }
          AcrossInput { component: _, on_fused: _, on_return: _, fused_path: _, return_path: _ } => false
          AcrossInputContradicted { component: _, readings: _ } => false
        })
    BoundEstablished { bound: _, equally_limiting: _, observed: _ } => false
    BoundContradicted { contradicted: _, observed: _ } => false
  }
}

// A READING ON THE E1 CANNOT QUALIFY THE K1. The K1 given the E1's very readings and J20 mapping still
// derives nothing: every reading names the E1 asset, and the K1's board is the K1 asset.
test fn a_reading_on_the_e1_cannot_qualify_the_k1() -> Bool {
  let k1_given_e1 = layout_with(base: p4261_k1_layout, components: p4261_k1_layout.components,
    measured: Present { value: MeasuredBoard { asset: p4261_k1_a, continuity: e1_measured.continuity, diode_readings: e1_measured.diode_readings, source_draws: e1_measured.source_draws, bench: e1_measured.bench } },
    input: Present { value: e1_input })
  let unpolarized = match input_polarity(layout: k1_given_e1) {
    PolarityUnestablished { gaps: _ } => true
    PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => false
    PolarityContradicted { readings: _ } => false
  }
  unpolarized && is_unestablished_bound(b: input_bound(layout: k1_given_e1))
    && j20_position_count(layout: p4261_k1_layout) == 16
    && physical_asset_identity_eq(a: e1_measured.asset, b: p4261_e1_b)
}

// TWO COMPONENTS WITH ONE LOCAL LABEL ON TWO DESIGNS DO NOT JOIN. The K1's D2 and the E1's D2 share a
// label and are different identities; a reading between K1-design terminals filed on the E1 asset
// joins nothing on the E1, so its bound is unchanged.
test fn identical_labels_on_another_design_do_not_join() -> Bool {
  let k1_d2 = component_instance_identity(design: k1_design, local_identity: "D2")
  let k1_j20 = component_instance_identity(design: k1_design, local_identity: "J20")
  let stray = read(a: terminal_ref(component: k1_j20, terminal: e1_ground_ref.terminal), b: terminal_ref(component: k1_d2, terminal: e1_d2_near.terminal), result: BuzzerAsserted)
  let with_stray = e1_with_continuity(cs: concat(e1_measured.continuity, [stray]))
  !component_identity_eq(a: k1_d2, b: e1_d2)
    && !terminal_ref_equal(a: terminal_ref(component: k1_d2, terminal: e1_d2_near.terminal), b: e1_d2_near)
    && bound_volts(b: input_bound(layout: with_stray)) == 60
    && bound_limiter_is(b: input_bound(layout: with_stray), c: e1_d2)
}

// ── THE E1: polarity, placement and the bound ───────────────────────────────────────────────

fn row_is(s: RowSide, away: Bool) -> Bool {
  match s {
    AwayFromLatch => away
    LatchSide => !away
    SideUnrecorded => false
  }
}

fn housing_with_sides(latch_row: RowSide, away_row: RowSide) -> ConnectorHousing {
  ConnectorHousing {
    component: e1_j20_housing.component,
    positions: map(e1_j20_housing.positions, p => HousingPosition {
      terminal: p.terminal,
      side: match p.side {
        LatchSide => latch_row
        AwayFromLatch => away_row
        SideUnrecorded => SideUnrecorded
      },
      index: p.index,
    }),
    sides_evidence: e1_j20_housing.sides_evidence,
  }
}

fn e1_with_housing(h: ConnectorHousing) -> CarrierLayoutObservation {
  layout_with(base: p4261_e1_layout, components: p4261_e1_layout.components, measured: p4261_e1_layout.measured, input: Present { value: InputConnector { housing: h, fuse_terminal: e1_input.fuse_terminal } })
}

// J20'S POLARITY IS DERIVED, AND SAYS WHAT IT RESTS ON. The fused contacts are the row away from the
// latch, the return contacts the latch side, separated by silent (above-threshold) readings to ground on the fused side;
// the return-side readings have inferred second points, and the standing carries them. The same
// positions recorded on the opposite sides read the other way round; a side left unrecorded refuses;
// the K1 has no measured board.
test fn j20_polarity_is_derived_from_the_readings() -> Bool {
  let e1 = match input_polarity(layout: p4261_e1_layout) {
    PolarityEstablished { fused_side, return_side, fused: _, returns, isolation } =>
      row_is(s: fused_side, away: true) && row_is(s: return_side, away: false)
        && any(returns, o => is_inferred(o: o)) && count(isolation) > 0
    PolarityContradicted { readings: _ } => false
    PolarityUnestablished { gaps: _ } => false
  }
  let swapped = match input_polarity(layout: e1_with_housing(h: housing_with_sides(latch_row: AwayFromLatch, away_row: LatchSide))) {
    PolarityEstablished { fused_side, return_side: _, fused: _, returns: _, isolation: _ } => row_is(s: fused_side, away: false)
    PolarityContradicted { readings: _ } => false
    PolarityUnestablished { gaps: _ } => false
  }
  let unrecorded = match input_polarity(layout: e1_with_housing(h: housing_with_sides(latch_row: LatchSide, away_row: SideUnrecorded))) {
    PolarityUnestablished { gaps } => any(gaps, g => match g {
      SidesUnrecorded => true
      _ => false
    })
    PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => false
    PolarityContradicted { readings: _ } => false
  }
  let k1 = match input_polarity(layout: p4261_k1_layout) {
    PolarityUnestablished { gaps } => any(gaps, g => match g {
      NoMeasuredBoard => true
      _ => false
    })
    PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => false
    PolarityContradicted { readings: _ } => false
  }
  e1 && swapped && unrecorded && k1
}

fn placed_d2(s: AcrossInputStanding) -> Bool {
  match s {
    AcrossInput { component: _, on_fused, on_return, fused_path, return_path } =>
      terminal_ref_equal(a: on_fused, b: e1_d2_near) && terminal_ref_equal(a: on_return, b: e1_d2_far) && count(fused_path) > 0 && count(return_path) > 0
    AcrossInputContradicted { component: _, readings: _ } => false
    AcrossInputUnestablished { component: _, gap: _ } => false
  }
}

// EACH READING IS COUNTED ONCE. Every contact on an established side reaches one class, so the polarity's
// readings are that class's, taken once: the inferred readings it rests on can never outnumber the
// board's own inferred readings, which they would if each contact carried the class again.
test fn each_reading_is_counted_once() -> Bool {
  let board = count(filter(e1_measured.continuity, o => is_inferred(o: o)))
  match polarity_grade(p: input_polarity(layout: p4261_e1_layout)) {
    IncludesInferredPoints { readings } => count(readings) > 0 && count(readings) <= board
    RecordedPointsOnly => false
  }
}

// THE BOUND CARRIES TYPED CAUSES. D2 and D5, each a 5PGK-class TVS with its tabs read to the two sides,
// bound J20 at 60 V; the bound names D2 as limiting, D5 as equally limiting, J20 as the input and the
// E1 as the asset, D2's fused-side and return-side terminals, and the grade of the readings it rests on.
test fn the_bound_carries_typed_causes() -> Bool {
  match input_bound(layout: p4261_e1_layout) {
    BoundEstablished { bound, equally_limiting, observed: _ } =>
      volt_count(v: bound.rated.maximum) == 60
        && component_identity_eq(a: bound.limiting_component, b: e1_d2)
        && component_identity_eq(a: bound.input_connector, b: e1_j20)
        && physical_asset_identity_eq(a: bound.asset, b: p4261_e1_b)
        && any(equally_limiting, x => component_identity_eq(a: x.limiting_component, b: e1_d5))
        && placed_d2(s: bound.placement)
        && match bound.grade {
          IncludesInferredPoints { readings } => count(readings) > 0
          RecordedPointsOnly => false
        }
    BoundContradicted { contradicted: _, observed: _ } => false
    BoundUnestablished { observed: _ } => false
  }
}

fn is_zu1j151(c: InstalledComponent) -> Bool {
  match c.identification {
    IdentifiedByMarking { row, marking: _ } => (row.ordering_code as String).contains("EEH-ZU1J151")
    _ => false
  }
}

fn is_unresolved_marking(c: InstalledComponent) -> Bool {
  match c.identification {
    MarkingUnresolved { marking: _, discriminator: _ } => true
    _ => false
  }
}

// THE CANS ARE NOT ACROSS J20, AND THE UNPROBED ONE INHERITS NOTHING. C10_P5 and C12_P5 are two
// instances identified by their own markings, their negatives on ground and their positives read silent
// to the rail, so neither is placed. The third can has no reading and no decoded marking: no rating,
// no placement, nothing from its neighbours.
test fn the_capacitors_do_not_bound_and_the_third_inherits_nothing() -> Bool {
  let caps = filter(p4261_e1_layout.components, c => is_zu1j151(c: c))
  let third = component_of(layout: p4261_e1_layout, c: e1_third_can)
  count(caps) == 2
    && all(caps, c => is_unplaced(s: across_input(layout: p4261_e1_layout, c: c)))
    && count(third) == 1
    && all(third, c => is_unplaced(s: across_input(layout: p4261_e1_layout, c: c)) && is_unresolved_marking(c: c))
}

fn shared_marking_evidence(c: ComponentInstanceIdentity) -> List<String> {
  flat_map(component_of(layout: p4261_e1_layout, c: c), x => match x.identification {
    MarkingSharedByMakers { rows: _, marking } => [evidence_text(e: marking.evidence)]
    _ => []
  })
}

fn evidence_text(e: EvidenceRef) -> String {
  match e {
    OperatorStatement { stated_on, verbatim } => join([stated_on as String, verbatim as String], " ")
    OperatorPhotograph { taken_on, locator } => join([taken_on as String, locator as String], " ")
    _ => "listing"
  }
}

fn with_d5_unread(c: InstalledComponent) -> InstalledComponent {
  if component_identity_eq(a: c.component, b: e1_d5) {
    InstalledComponent { component: c.component, terminals: c.terminals, identification: MarkingUnresolved { marking: Absent, discriminator: "supplied: unread" } }
  } else { c }
}

// D5 CANNOT INHERIT D2'S IDENTITY. Each carries its own marking receipt (different photographs); D5
// re-declared with its marking unread drops out of the bound, which D2 then limits alone.
test fn d5_cannot_inherit_d2s_identity() -> Bool {
  let d2_evidence = shared_marking_evidence(c: e1_d2)
  let d5_evidence = shared_marking_evidence(c: e1_d5)
  let b = input_bound(layout: layout_with(base: p4261_e1_layout, components: map(p4261_e1_layout.components, c => with_d5_unread(c: c)), measured: p4261_e1_layout.measured, input: p4261_e1_layout.input))
  count(d2_evidence) == 1 && count(d5_evidence) == 1 && all(d2_evidence, x => all(d5_evidence, y => x != y))
    && bound_limiter_is(b: b, c: e1_d2) && count(bound_ties(b: b)) == 0
}

fn low_can_row() -> ElectronicComponentRow {
  ElectronicComponentRow {
    vendor: eeh_zu1j151.vendor,
    ordering_code: "supplied 16 V can",
    package: "supplied",
    top_marking: "supplied",
    specification: CapacitorSpec { capacitor: CapacitorSpecification { capacitance_microfarads: 100, rated_voltage: volt(count: 16) } },
    vendor_application_statements: [],
  }
}

// A RATING COUNTS ONLY ACROSS THE INPUT. F300's 75 V is observed with its placement unestablished --
// both its ends are on the fused side -- so it bounds nothing and the bound stays 60 V. A supplied
// 16 V can read across the two sides lowers the bound to 16 V; the same can with no readings does not.
test fn only_a_rating_across_the_input_bounds_it() -> Bool {
  let f300 = placement_of(layout: p4261_e1_layout, c: e1_f300)
  let low = component_instance_identity(design: e1_d2.design, local_identity: "supplied 16 V can")
  let low_part = InstalledComponent { component: low, terminals: [positive_term(), negative_term()], identification: IdentifiedByMarking { row: low_can_row(), marking: MarkingReading { text: "supplied", evidence: supplied_said() } } }
  let low_pos = terminal_ref(component: low, terminal: positive_term())
  let low_neg = terminal_ref(component: low, terminal: negative_term())
  let with_low = concat(p4261_e1_layout.components, [low_part])
  let placed = layout_with(base: p4261_e1_layout, components: with_low, measured: Present { value: MeasuredBoard { asset: e1_measured.asset, continuity: concat(e1_measured.continuity, [read(a: low_pos, b: e1_rail_ref, result: BuzzerAsserted), read(a: low_neg, b: e1_ground_ref, result: BuzzerAsserted)]), diode_readings: e1_measured.diode_readings, source_draws: e1_measured.source_draws, bench: e1_measured.bench } }, input: p4261_e1_layout.input)
  let unread = layout_with(base: p4261_e1_layout, components: with_low, measured: p4261_e1_layout.measured, input: p4261_e1_layout.input)
  count(f300) == 1 && all(f300, s => is_unplaced(s: s))
    && bound_volts(b: input_bound(layout: p4261_e1_layout)) == 60
    && bound_volts(b: input_bound(layout: placed)) == 16 && bound_limiter_is(b: input_bound(layout: placed), c: low)
    && bound_volts(b: input_bound(layout: unread)) == 60
}

fn moved_to(o: ContinuityObservation, from: ElectricalTerminalRef, to: ElectricalTerminalRef) -> ContinuityObservation {
  if terminal_ref_equal(a: o.first, b: from) {
    ContinuityObservation { asset: o.asset, first: to, second: o.second, record: o.record, conditions: o.conditions, result: o.result, evidence: o.evidence }
  } else { o }
}

// MOVING A TERMINAL IDENTITY -- NOT A LABEL -- TURNS THE DEDUCTION RED. The reading that put D2's farther
// tab on ground, re-filed against the third can's negative terminal, leaves D2 unplaced; the bound is
// then D5's alone.
test fn moving_a_terminal_identity_turns_the_deduction_red() -> Bool {
  let third_neg = terminal_ref(component: e1_third_can, terminal: negative_term())
  let l = e1_with_continuity(cs: map(e1_measured.continuity, o => moved_to(o: o, from: e1_d2_far, to: third_neg)))
  all(placement_of(layout: l, c: e1_d2), s => is_unplaced(s: s))
    && bound_limiter_is(b: input_bound(layout: l), c: e1_d5) && count(bound_ties(b: input_bound(layout: l))) == 0
}

fn rl_c(c: ComponentInstanceIdentity) -> ComponentInstanceIdentity {
  component_instance_identity(design: c.design, local_identity: join(["relabelled ", c.local_identity as String], "") as NonEmptyStr)
}

fn rl_t(t: TerminalIdentity) -> TerminalIdentity {
  (join(["relabelled ", t as String], "") as NonEmptyStr) as TerminalIdentity
}

fn rl_ref(r: ElectricalTerminalRef) -> ElectricalTerminalRef {
  terminal_ref(component: rl_c(c: r.component), terminal: rl_t(t: r.terminal))
}

fn rl_obs(o: ContinuityObservation) -> ContinuityObservation {
  ContinuityObservation { asset: o.asset, first: rl_ref(r: o.first), second: rl_ref(r: o.second), record: o.record, conditions: o.conditions, result: o.result, evidence: o.evidence }
}

fn rl_diode(o: DiodeModeObservation) -> DiodeModeObservation {
  DiodeModeObservation {
    asset: o.asset,
    probes: match o.probes {
      RedBlack { red, black } => RedBlack { red: rl_ref(r: red), black: rl_ref(r: black) }
      _ => o.probes
    },
    display: o.display,
    conditions: o.conditions,
    evidence: o.evidence,
  }
}

fn rl_housing(h: ConnectorHousing) -> ConnectorHousing {
  ConnectorHousing { component: rl_c(c: h.component), positions: map(h.positions, p => HousingPosition { terminal: rl_t(t: p.terminal), side: p.side, index: p.index }), sides_evidence: h.sides_evidence }
}

fn rl_draw(o: SourceDrawObservation) -> SourceDrawObservation {
  SourceDrawObservation {
    asset: o.asset, feed: rl_ref(r: o.feed), return_terminal: rl_ref(r: o.return_terminal), leads: o.leads, conditions: o.conditions, setting: o.setting,
    open_reading: o.open_reading, loaded_reading: o.loaded_reading, stepping_peak: o.stepping_peak, behaviour: o.behaviour, evidence: o.evidence,
  }
}

// A datasheet-identified part's package terminals ("pin 4", "tab") are the datasheet's names, not board
// labels, so relabelling re-spells the component a reading names and keeps its package terminal.
fn rl_voltage(o: NodeVoltageObservation) -> NodeVoltageObservation {
  NodeVoltageObservation {
    asset: o.asset, at: terminal_ref(component: rl_c(c: o.at.component), terminal: o.at.terminal), reference: rl_ref(r: o.reference), record: o.record,
    conditions: o.conditions, source: o.source, value: o.value, certainty: o.certainty, order: o.order, evidence: o.evidence,
  }
}

fn rl_resistance(o: ResistanceObservation) -> ResistanceObservation {
  ResistanceObservation {
    asset: o.asset, first: terminal_ref(component: rl_c(c: o.first.component), terminal: o.first.terminal), second: terminal_ref(component: rl_c(c: o.second.component), terminal: o.second.terminal),
    record: o.record, conditions: o.conditions, range: o.range, display: o.display, stability: o.stability, certainty: o.certainty, order: o.order, evidence: o.evidence,
  }
}

fn rl_bench(b: BenchRecord) -> BenchRecord {
  BenchRecord { incidents: b.incidents, voltages: map(b.voltages, o => rl_voltage(o: o)), resistances: map(b.resistances, o => rl_resistance(o: o)) }
}

fn relabelled_e1() -> CarrierLayoutObservation {
  layout_with(
    base: p4261_e1_layout,
    components: map(p4261_e1_layout.components, c => InstalledComponent { component: rl_c(c: c.component), terminals: map(c.terminals, t => rl_t(t: t)), identification: c.identification }),
    measured: Present { value: MeasuredBoard { asset: e1_measured.asset, continuity: map(e1_measured.continuity, o => rl_obs(o: o)), diode_readings: map(e1_measured.diode_readings, o => rl_diode(o: o)), source_draws: map(e1_measured.source_draws, o => rl_draw(o: o)), bench: rl_bench(b: e1_measured.bench) } },
    input: Present { value: InputConnector { housing: rl_housing(h: e1_j20_housing), fuse_terminal: rl_ref(r: e1_input.fuse_terminal) } },
  )
}

// CHANGING EVERY LABEL LEAVES THE CONCLUSION UNCHANGED. Every component and terminal identity on the
// E1 is re-spelled consistently -- components, housing, input, readings, diode readings -- and the
// bound is still 60 V, limited by the re-spelled D2: the deduction joins identities, not spellings.
test fn relabeling_cannot_change_a_deduction() -> Bool {
  let r = relabelled_e1()
  bound_volts(b: input_bound(layout: r)) == 60
    && bound_limiter_is(b: input_bound(layout: r), c: rl_c(c: e1_d2))
    && !bound_limiter_is(b: input_bound(layout: r), c: e1_d2)
    && carrier_input_reading(layout: r).contains("limited by relabelled D2's TVS reverse standoff")
}

// CONTINUITY THROUGH AN INTACT FUSE DOES NOT MERGE COPPER NETS, AND F1 STAYS A COMPONENT EDGE. F1's two
// ends are reachable through the readings; two design nets either side of F1 stay two nets, and F1's
// ends stay two terminals of one installed two-terminal part.
test fn continuity_through_a_fuse_does_not_merge_nets() -> Bool {
  let before = ElectricalNet { identity: net_identity(design: e1_d2.design, local_identity: "supplied: J20 side of F1"), members: [e1_rail_ref, e1_f1_near] }
  let after = ElectricalNet { identity: net_identity(design: e1_d2.design, local_identity: "supplied: far side of F1"), members: [e1_f1_far, e1_d2_near] }
  is_reachable(s: reachability(observations: e1_measured.continuity, asset: p4261_e1_b, a: e1_f1_near, b: e1_f1_far))
    && !net_contains_terminal(net: before, t: e1_f1_far) && !net_contains_terminal(net: after, t: e1_f1_near)
    && !terminal_ref_equal(a: e1_f1_near, b: e1_f1_far)
    && count(component_of(layout: p4261_e1_layout, c: e1_f1)) == 1
    && all(component_of(layout: p4261_e1_layout, c: e1_f1), c => count(c.terminals) == 2)
}

// CONFLICTING READINGS REFUSE. A supplied beep from D2's nearer tab to ground joins the rail to ground,
// where F300's ends and the MOSFET's tab were read silent to ground: polarity is contradicted, and nothing
// is bounded.
test fn conflicting_readings_refuse() -> Bool {
  let l = e1_with_continuity(cs: concat(e1_measured.continuity, [read(a: e1_d2_near, b: e1_ground_ref, result: BuzzerAsserted)]))
  match input_polarity(layout: l) {
    PolarityContradicted { readings } => count(readings) > 0 && is_unestablished_bound(b: input_bound(layout: l))
    PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => false
    PolarityUnestablished { gaps: _ } => false
  }
}

// ── JUNCTIONS ─────────────────────────────────────────────────────────────────────────────────

fn diode(red: ElectricalTerminalRef, black: ElectricalTerminalRef, display: DiodeDisplay) -> DiodeModeObservation {
  DiodeModeObservation { asset: p4261_e1_b, probes: RedBlack { red: red, black: black }, display: display, conditions: e1_bench, evidence: supplied_said() }
}

// A MISSING REVERSE READING STAYS MISSING, AND CONTRADICTORY DIODE READINGS REFUSE. D2's one forward
// reading puts its anode on the farther tab and its cathode on the nearer, the reverse unread; a
// supplied forward reading the other way makes the junction contradicted; a supplied over-limit reverse
// reading is carried as read. D5's reading puts its anode on its top tab.
test fn junction_readings_are_raw_and_total() -> Bool {
  let d2 = junction_between(observations: e1_measured.diode_readings, asset: p4261_e1_b, a: e1_d2_near, b: e1_d2_far)
  let forward_unread = match d2 {
    JunctionForward { anode, cathode, forward, reverse } => terminal_ref_equal(a: anode, b: e1_d2_far) && terminal_ref_equal(a: cathode, b: e1_d2_near) && count(forward) == 1 && match reverse {
      ReverseUnread => true
      _ => false
    }
    _ => false
  }
  let contradicted = match junction_between(observations: concat(e1_measured.diode_readings, [diode(red: e1_d2_near, black: e1_d2_far, display: ForwardMillivolts { millivolts: 600 })]), asset: p4261_e1_b, a: e1_d2_near, b: e1_d2_far) {
    JunctionContradicted { readings } => count(readings) == 2
    _ => false
  }
  let reverse_read = match junction_between(observations: concat(e1_measured.diode_readings, [diode(red: e1_d2_near, black: e1_d2_far, display: OverLimit)]), asset: p4261_e1_b, a: e1_d2_near, b: e1_d2_far) {
    JunctionForward { anode: _, cathode: _, forward: _, reverse } => match reverse {
      ReverseOverLimit { readings } => count(readings) == 1
      _ => false
    }
    _ => false
  }
  let d5 = match junction_between(observations: e1_measured.diode_readings, asset: p4261_e1_b, a: e1_d5_top, b: e1_d5_bottom) {
    JunctionForward { anode, cathode, forward: _, reverse: _ } => terminal_ref_equal(a: anode, b: e1_d5_top) && terminal_ref_equal(a: cathode, b: e1_d5_bottom)
    _ => false
  }
  forward_unread && contradicted && reverse_read && d5
}

// A SILENT BUZZER SEPARATES WITHOUT CLAIMING AN OPEN CIRCUIT. The E1's rail and ground references are
// separated by no-beep readings and stand ReadAboveThreshold, which keeps the two low-impedance classes
// apart; D2's forward diode reading conducts across exactly those classes, so the silence cannot be a
// literal open circuit, and the rendering says "above the continuity threshold", never "open".
test fn a_silent_buzzer_separates_without_claiming_an_open_circuit() -> Bool {
  let s = reachability(observations: e1_measured.continuity, asset: p4261_e1_b, a: e1_rail_ref, b: e1_ground_ref)
  let separated = match s {
    ReadAboveThreshold { readings } => count(readings) > 0 && all(readings, o => match o.result {
      BuzzerNotAsserted => true
      BuzzerAsserted => false
    })
    _ => false
  }
  let conducts_across = match junction_between(observations: e1_measured.diode_readings, asset: p4261_e1_b, a: e1_d2_near, b: e1_d2_far) {
    JunctionForward { anode: _, cathode: _, forward: _, reverse: _ } => true
    _ => false
  }
  let text = reachability_text(s: s)
  separated && conducts_across && !is_reachable(s: s)
    && text.contains("above the continuity threshold") && !text.contains("open")
}

// AN ENDPOINT IS RECORDED ONLY WHERE THE OPERATOR NAMED IT. D2's and D5's tabs were named, so their first
// points are recorded; F300's ends (from "everything i touched") and the MOSFET's middle lead (from "the
// very middle little small pin") are inferred from the visible population, and both kinds still carry
// their inferred grade into what they support.
fn first_point_recorded_for(t: ElectricalTerminalRef) -> List<Bool> {
  map(filter(e1_measured.continuity, o => terminal_ref_equal(a: o.first, b: t)), o => match o.record.first {
    PointRecorded => true
    PointInferred { basis: _ } => false
  })
}

test fn population_statements_infer_their_endpoints() -> Bool {
  let named = concat(concat(first_point_recorded_for(t: e1_d2_near), first_point_recorded_for(t: e1_d2_far)), concat(first_point_recorded_for(t: e1_d5_top), first_point_recorded_for(t: e1_d5_bottom)))
  let population = concat(first_point_recorded_for(t: e1_f300_one), first_point_recorded_for(t: e1_f302_one))
  count(named) == 4 && all(named, r => r)
    && count(population) > 0 && all(population, r => !r)
    && all(filter(e1_measured.continuity, o => terminal_ref_equal(a: o.first, b: e1_f300_one)), o => is_inferred(o: o))
}

// A NARROW FINDING STANDS OR FALLS ALONE. On the E1 every finding a consumer cites is established; on the
// K1 the polarity and the bound are not, and its J20 is only counted. Removing D2's tab readings from the
// E1 unestablishes D2's placement while J20's inventory and C10's identification stand untouched, so a
// consumer citing one finding is reopened by that finding and no other.
test fn a_narrow_finding_stands_or_falls_alone() -> Bool {
  let e1_findings = [J20ContactInventory, J20Polarity, ComponentAcrossInput { component: e1_d2 }, ComponentAcrossInput { component: e1_d5 }, ComponentIdentified { component: e1_c10 }, ComponentIdentified { component: e1_d2 }, InputUpperBound, J20EnergizedDraw]
  let e1_all = all(e1_findings, f => is_finding_established(s: carrier_finding(layout: p4261_e1_layout, f: f)))
  let k1_open = !is_finding_established(s: carrier_finding(layout: p4261_k1_layout, f: J20Polarity))
    && !is_finding_established(s: carrier_finding(layout: p4261_k1_layout, f: InputUpperBound))
    && !is_finding_established(s: carrier_finding(layout: p4261_k1_layout, f: J20ContactInventory))
  let without_d2 = e1_with_continuity(cs: filter(e1_measured.continuity, o => !terminal_ref_equal(a: o.first, b: e1_d2_near) && !terminal_ref_equal(a: o.first, b: e1_d2_far)))
  let only_d2_falls = !is_finding_established(s: carrier_finding(layout: without_d2, f: ComponentAcrossInput { component: e1_d2 }))
    && is_finding_established(s: carrier_finding(layout: without_d2, f: J20ContactInventory))
    && is_finding_established(s: carrier_finding(layout: without_d2, f: ComponentIdentified { component: e1_c10 }))
  let unresolved = !is_finding_established(s: carrier_finding(layout: p4261_e1_layout, f: ComponentIdentified { component: e1_third_can }))
  e1_all && k1_open && only_d2_falls && unresolved
}

// ── IDENTIFICATION AND COUNTS ─────────────────────────────────────────────────────────────────

// A SHARED MARKING SUPPORTS ONLY WHAT EVERY CANDIDATE SUPPORTS: two TVS rows of one standoff yield it;
// a TVS row beside a MOSFET row -- different kinds of limit -- yields none.
test fn a_shared_marking_supports_only_what_every_candidate_supports() -> Bool {
  let same = match shared_withstand(rows: [tvs_5_0smdj60a, tvs_5_0smdj60a]) {
    Present { value: w } => volt_count(v: w.maximum) == 60
    Absent => false
  }
  let mixed = match shared_withstand(rows: [tvs_5_0smdj60a, ipb017n10n5lf]) {
    Present { value: _ } => false
    Absent => true
  }
  same && mixed
}

// COUNTS ARE DERIVED. J20's position count is its contact inventory's length -- nine a side -- and the
// K1's is the photograph count; component counts are counts of instances.
test fn counts_are_derived_from_inventories() -> Bool {
  j20_position_count(layout: p4261_e1_layout) == count(e1_j20_housing.positions)
    && j20_position_count(layout: p4261_e1_layout) == 18
    && count(side_terminals(h: e1_j20_housing, side: LatchSide)) == 9
    && count(side_terminals(h: e1_j20_housing, side: AwayFromLatch)) == 9
    && count(component_of(layout: p4261_e1_layout, c: e1_c10)) == 1
    && count(component_of(layout: p4261_e1_layout, c: e1_c12)) == 1
}

// ── THE REPORT IS RENDERED FROM THE TYPED MODEL ───────────────────────────────────────────────

fn with_survey(base: CarrierLayoutObservation, survey: ManagementIoSurvey) -> CarrierLayoutObservation {
  CarrierLayoutObservation {
    asset: base.asset,
    design: base.design,
    markings: base.markings,
    module_receptacles: base.module_receptacles,
    backplane_connectors: base.backplane_connectors,
    j20: base.j20,
    j20_calipers: base.j20_calipers,
    edge_high_speed_connectors: base.edge_high_speed_connectors,
    management_io_survey: survey,
    management_io: base.management_io,
    components: base.components,
    measured: base.measured,
    input: base.input,
    unresolved: base.unresolved,
  }
}

// The E1's reading renders its bound, its tie, its evidence grade and the caliper fit from the typed
// model; the K1's renders no bound and an unestablished polarity. A close-up establishes no absence of
// management I/O: the same E1 rows re-declared as photographed whole would claim one. The edge
// receptacle stays a candidate family, and U522's bus pins render as trace targets from typed roles.
test fn the_report_is_rendered_from_the_typed_model() -> Bool {
  let e1 = carrier_input_reading(layout: p4261_e1_layout)
  let k1 = carrier_input_reading(layout: p4261_k1_layout)
  let e1_io = management_io_text(layout: p4261_e1_layout)
  e1.contains("at most 60 V, limited by D2's TVS reverse standoff")
    && e1.contains("equally limited by D5")
    && e1.contains("readings with a probe point inferred from the operator's words")
    && e1.contains("caliper spans fit a 3.0 mm pitch and do not fit a 4.2 mm pitch")
    && k1.contains("no input bound established")
    && k1.contains("polarity UNESTABLISHED")
    && !e1_io.contains("shows no RJ45")
    && management_io_text(layout: with_survey(base: p4261_e1_layout, survey: WholeBoardPhotographed)).contains("shows no RJ45")
    && management_io_text(layout: p4261_k1_layout).contains("shows no RJ45")
    && e1_io.contains("USB 3.0 SuperSpeed Micro-B (part number, protocol and role unestablished)")
    && e1_io.contains("U522 ('TI 31 / T275') is TMP275AIDGKR; trace pins 1 SDA (serial data), 2 SCL (serial clock), 3 ALERT (alert output)")
}

// ── THE ENERGIZED INPUT DRAW ──────────────────────────────────────────────────────────────────

fn draw_with(open: Nat, loaded: Nat, behaviour: SourceBehaviour, conditions: BenchConditions, feed: ElectricalTerminalRef, ret: ElectricalTerminalRef) -> SourceDrawObservation {
  SourceDrawObservation {
    asset: e1_j20_draw.asset, feed: feed, return_terminal: ret, leads: e1_j20_draw.leads, conditions: conditions, setting: e1_j20_draw.setting,
    open_reading: milliampere(count: open), loaded_reading: milliampere(count: loaded), stepping_peak: Absent, behaviour: behaviour, evidence: e1_j20_draw.evidence,
  }
}

fn on_input(open: Nat, loaded: Nat, behaviour: SourceBehaviour) -> SourceDrawObservation {
  draw_with(open: open, loaded: loaded, behaviour: behaviour, conditions: e1_j20_draw.conditions, feed: e1_rail_ref, ret: e1_ground_ref)
}

fn e1_with_draws(ds: List<SourceDrawObservation>) -> CarrierLayoutObservation {
  layout_with(base: p4261_e1_layout, components: p4261_e1_layout.components, measured: Present { value: MeasuredBoard { asset: e1_measured.asset, continuity: e1_measured.continuity, diode_readings: e1_measured.diode_readings, source_draws: ds, bench: e1_measured.bench } }, input: p4261_e1_layout.input)
}

fn draw_finding(layout: CarrierLayoutObservation) -> Bool {
  is_finding_established(s: carrier_finding(layout: layout, f: J20EnergizedDraw))
}

fn bounded_by(d: InputDrawStanding, above_open: Nat, headroom: Nat) -> Bool {
  match d {
    InputDrawBounded { bounded, observed: _ } => count(bounded) == 1 && all(bounded, s => match s {
      DrawBounded { observation: _, above_open: a, headroom: h } => milliampere_count(i: a) == above_open && milliampere_count(i: h) == headroom
      DrawBoundContradicted { observation: _, cause: _ } => false
      DrawUnestablished { observation: _, gaps: _ } => false
    })
    InputDrawContradicted { contradicted: _, observed: _ } => false
    InputDrawUnestablished { gaps: _ } => false
  }
}

fn is_input_draw_contradicted(d: InputDrawStanding) -> Bool {
  match d {
    InputDrawContradicted { contradicted: _, observed: _ } => true
    InputDrawBounded { bounded: _, observed: _ } => false
    InputDrawUnestablished { gaps: _ } => false
  }
}

fn no_input_reading(d: InputDrawStanding) -> Bool {
  match d {
    InputDrawUnestablished { gaps } => any(gaps, g => match g {
      NoEnergizedInputReading => true
      _ => false
    })
    InputDrawBounded { bounded: _, observed: _ } => false
    InputDrawContradicted { contradicted: _, observed: _ } => false
  }
}

fn has_gap(s: SourceDrawStanding, load: Bool) -> Bool {
  match s {
    DrawUnestablished { observation: _, gaps } => any(gaps, g => match g {
      LoadNotDistinguished => load
      SourceNotEnergized => !load
    })
    DrawBounded { observation: _, above_open: _, headroom: _ } => false
    DrawBoundContradicted { observation: _, cause: _ } => false
  }
}

// A DRAW IS THE BOARD'S ONLY ABOVE THE DISPLAY'S ZERO. The live E1 reading -- 13 mA loaded, 0 mA open,
// 100 mA limit held -- establishes a bounded draw of 13 mA with 87 mA of headroom. The same reading with
// the open reading equal to the loaded one distinguishes no draw, and a source not recorded as energized
// establishes none; the K1, never energized, has no finding.
test fn an_energized_draw_counts_only_above_its_open_reading() -> Bool {
  let live = draw_finding(layout: p4261_e1_layout) && bounded_by(d: input_draw(layout: p4261_e1_layout), above_open: 13, headroom: 87)
  let offset = on_input(open: 13, loaded: 13, behaviour: HeldBelowLimit)
  let offset_red = !draw_finding(layout: e1_with_draws(ds: [offset])) && has_gap(s: source_draw_standing(o: offset), load: true)
  let cold = draw_with(open: 0, loaded: 13, behaviour: HeldBelowLimit, conditions: BenchConditions { power: Unpowered, module: ModuleRemoved }, feed: e1_rail_ref, ret: e1_ground_ref)
  let cold_red = !draw_finding(layout: e1_with_draws(ds: [cold])) && has_gap(s: source_draw_standing(o: cold), load: false)
  let no_reading = !draw_finding(layout: e1_with_draws(ds: [])) && no_input_reading(d: input_draw(layout: e1_with_draws(ds: [])))
  let k1 = !draw_finding(layout: p4261_k1_layout)
  live && offset_red && cold_red && no_reading && k1
}

// A TRIP, CONSTANT CURRENT OR A READING AT THE LIMIT CONTRADICTS THE BOUND, and one contradicted reading
// contradicts the input's bound even beside a bounded one.
test fn a_trip_or_the_limit_contradicts_the_draw_bound() -> Bool {
  let tripped = on_input(open: 0, loaded: 13, behaviour: ProtectionTripped { at: volt(count: 30) })
  let at_limit = on_input(open: 0, loaded: 100, behaviour: HeldBelowLimit)
  let constant = on_input(open: 0, loaded: 13, behaviour: EnteredConstantCurrent)
  all([tripped, at_limit, constant], o => is_input_draw_contradicted(d: input_draw(layout: e1_with_draws(ds: [o]))) && !draw_finding(layout: e1_with_draws(ds: [o])))
    && is_input_draw_contradicted(d: input_draw(layout: e1_with_draws(ds: [e1_j20_draw, tripped])))
}

// A READING ACROSS OTHER TERMINALS SAYS NOTHING ABOUT THE INPUT: the same reading with its leads swapped
// onto the opposite rows is not placed across J20's fused and return sides.
test fn a_reading_off_the_input_rows_is_not_the_inputs() -> Bool {
  let swapped = draw_with(open: 0, loaded: 13, behaviour: HeldBelowLimit, conditions: e1_j20_draw.conditions, feed: e1_ground_ref, ret: e1_rail_ref)
  !draw_finding(layout: e1_with_draws(ds: [swapped])) && no_input_reading(d: input_draw(layout: e1_with_draws(ds: [swapped])))
}

// The draw renders from the typed reading, with its inferred lead points, and survives relabelling.
test fn the_energized_draw_renders_and_survives_relabelling() -> Bool {
  let e1 = carrier_input_reading(layout: p4261_e1_layout)
  e1.contains("it drew 13 mA (0 mA with the load disconnected, so 13 mA is the board's)")
    && e1.contains("over-current shutoff armed")
    && e1.contains("brief readings up to 20 mA while stepping, cause unread")
    && e1.contains("on lead points inferred from the operator's words")
    && carrier_input_reading(layout: p4261_k1_layout).contains("no energized draw established")
    && bounded_by(d: input_draw(layout: relabelled_e1()), above_open: 13, headroom: 87)
}

// ── THE INPUT SWITCHES AND THEIR CONTROLLER ───────────────────────────────────────────────────

fn e1_with_bench(vs: List<NodeVoltageObservation>, rs: List<ResistanceObservation>) -> CarrierLayoutObservation {
  layout_with(base: p4261_e1_layout, components: p4261_e1_layout.components, measured: Present { value: MeasuredBoard { asset: e1_measured.asset, continuity: e1_measured.continuity, diode_readings: e1_measured.diode_readings, source_draws: e1_measured.source_draws, bench: BenchRecord { incidents: e1_bench_record.incidents, voltages: vs, resistances: rs } } }, input: p4261_e1_layout.input)
}

fn e1_with_voltages(vs: List<NodeVoltageObservation>) -> CarrierLayoutObservation {
  e1_with_bench(vs: vs, rs: [])
}

fn reading_under(c: ComponentInstanceIdentity, terminal: NonEmptyStr, value: VoltageValue, order: ReadingOrder, source_volts: Nat) -> NodeVoltageObservation {
  NodeVoltageObservation {
    asset: p4261_e1_b, at: terminal_ref(component: c, terminal: terminal as TerminalIdentity), reference: e1_ground_ref, record: both_points_recorded,
    conditions: e1_live_bench, source: volt(count: source_volts), value: value, certainty: StatedPlainly, order: order, evidence: [OperatorStatement { stated_on: "supplied", verbatim: "supplied" }],
  }
}

fn reading(c: ComponentInstanceIdentity, terminal: NonEmptyStr, value: VoltageValue, order: ReadingOrder) -> NodeVoltageObservation {
  reading_under(c: c, terminal: terminal, value: value, order: order, source_volts: 48)
}

fn about(mv: Nat) -> VoltageValue {
  ReadAbout { value: millivolt(count: mv) }
}

fn before() -> ReadingOrder {
  BeforeIncidents { keys: [e1_bridge_incident.key] }
}

fn q21_with(drain_mv: Nat, source_mv: Nat) -> List<NodeVoltageObservation> {
  [reading(c: e1_q21, terminal: "tab", value: about(mv: drain_mv), order: before()), reading(c: e1_q21, terminal: "pin 2", value: about(mv: source_mv), order: before())]
}

fn switch_of(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> List<InputSwitchStanding> {
  match installed(layout: layout, c: c) {
    Absent => []
    Present { value: x } => [input_switch_standing(layout: layout, c: x)]
  }
}

fn is_blocking(ss: List<InputSwitchStanding>) -> Bool {
  count(ss) == 1 && all(ss, s => match s {
    SwitchBlocking { component: _, drain: _, sources: _ } => true
    _ => false
  })
}

fn is_conducting(ss: List<InputSwitchStanding>) -> Bool {
  count(ss) == 1 && all(ss, s => match s {
    SwitchConducting { component: _, drain: _, sources: _ } => true
    _ => false
  })
}

fn switch_gap_is(ss: List<InputSwitchStanding>, between: Bool) -> Bool {
  count(ss) == 1 && all(ss, s => match s {
    SwitchStateUnestablished { component: _, gap } => match gap {
      SourcesBetweenStates => between
      DrainUnread => !between
      _ => false
    }
    _ => false
  })
}

fn finding_holds(layout: CarrierLayoutObservation, f: CarrierFinding) -> Bool {
  is_finding_established(s: carrier_finding(layout: layout, f: f))
}

// A SWITCH'S STATE COMES FROM ITS DATASHEET ROLES AND ITS READINGS. The live E1 readings -- tabs near
// 48 V, every small lead near 1 V -- establish Q21_P5 and Q22_P5 blocking, and say their order against
// the probe-bridge incident is unrecorded. A source read near the drain conducts; one read halfway
// establishes no state; with no drain value nothing is established; and the probed MOSFET whose marking
// is unread has no roles, so the same readings put on it establish nothing. Relabelling the components
// keeps both states.
test fn the_input_switches_read_blocking() -> Bool {
  let live = finding_holds(layout: p4261_e1_layout, f: InputSwitchState { component: e1_q21 })
    && finding_holds(layout: p4261_e1_layout, f: InputSwitchState { component: e1_q22 })
    && is_blocking(ss: switch_of(layout: p4261_e1_layout, c: e1_q21))
    && carrier_input_reading(layout: p4261_e1_layout).contains("Q21_P5 is BLOCKING")
    && carrier_input_reading(layout: p4261_e1_layout).contains("order against incident 2026-10-19 probe bridge unrecorded")
  let conducting = is_conducting(ss: switch_of(layout: e1_with_voltages(vs: q21_with(drain_mv: 48000, source_mv: 47500)), c: e1_q21))
  let halfway = switch_gap_is(ss: switch_of(layout: e1_with_voltages(vs: q21_with(drain_mv: 48000, source_mv: 30000)), c: e1_q21), between: true)
    && !finding_holds(layout: e1_with_voltages(vs: q21_with(drain_mv: 48000, source_mv: 30000)), f: InputSwitchState { component: e1_q21 })
  let no_drain = switch_gap_is(ss: switch_of(layout: e1_with_voltages(vs: [reading(c: e1_q21, terminal: "pin 2", value: about(mv: 1000), order: before())]), c: e1_q21), between: false)
  let unrolled = [reading(c: e1_input_fet, terminal: "tab", value: about(mv: 48000), order: before()), reading(c: e1_input_fet, terminal: "pin 2", value: about(mv: 1000), order: before())]
  let unidentified = all(switch_of(layout: e1_with_voltages(vs: unrolled), c: e1_input_fet), s => match s {
    SwitchStateUnestablished { component: _, gap } => match gap {
      SwitchNotIdentified => true
      _ => false
    }
    _ => false
  }) && count(switch_of(layout: e1_with_voltages(vs: unrolled), c: e1_input_fet)) == 1
  let relabelled = is_blocking(ss: switch_of(layout: relabelled_e1(), c: rl_c(c: e1_q22)))
  live && conducting && halfway && no_drain && unidentified && relabelled
}

fn enable_of(layout: CarrierLayoutObservation) -> List<ControllerEnableStanding> {
  match installed(layout: layout, c: e1_u1_p5) {
    Absent => []
    Present { value: x } => [controller_enable_standing(layout: layout, c: x)]
  }
}

fn enable_is(ss: List<ControllerEnableStanding>, held: Bool) -> Bool {
  count(ss) == 1 && all(ss, s => match s {
    EnableHeldBelowThreshold { component: _, readings: _, minimum: _ } => held
    EnableAboveThreshold { component: _, readings: _, maximum: _ } => !held
    EnableUnestablished { component: _, readings: _, gap: _ } => false
  })
}

fn enable_gap(ss: List<ControllerEnableStanding>, which: Nat) -> Bool {
  count(ss) == 1 && all(ss, s => match s {
    EnableUnestablished { component: _, readings: _, gap } => match gap {
      EnableUnread => which == 0
      BoundNotBelowMinimum { bound: _, minimum: _ } => which == 1
      ReadWithinWindow => which == 2
      AccessPointUnseparated { points: _, neighbours: _ } => which == 3
      _ => false
    }
    _ => false
  })
}

fn u1_reading(terminal: NonEmptyStr, value: VoltageValue) -> List<NodeVoltageObservation> {
  [reading(c: e1_u1_p5, terminal: terminal, value: value, order: before())]
}

fn pad_to_pin(pin: NonEmptyStr, display: ResistanceDisplay) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: terminal_ref(component: e1_pin7_pad, terminal: "pad" as TerminalIdentity), second: terminal_ref(component: e1_u1_p5, terminal: pin as TerminalIdentity),
    record: both_points_recorded, conditions: BenchConditions { power: Unpowered, module: ModuleRemoved }, range: RangeFullScale { ohms: 200 }, display: display,
    stability: StabilityUnrecorded, certainty: StatedPlainly, order: before(), evidence: [OperatorStatement { stated_on: "supplied", verbatim: "supplied" }],
  }
}

// The pad separated from pin 7's neighbours: over range to pin 6, kilohms to pin 8.
fn separated_from_neighbours() -> List<ResistanceObservation> {
  [pad_to_pin(pin: "pin 6", display: DisplayOverRange), pad_to_pin(pin: "pin 8", display: DisplayValue { ohms: 3500, approximate: false })]
}

// AN ENABLE PIN IS HELD LOW ONLY BELOW THE DATASHEET MINIMUM. U1_P5 is the LM5066I by its marking, and
// its enable is pin 7 by the datasheet's role. The live E1's pad is joined to "pin 7" at the
// shorted-probe baseline but not separated from pins 6 and 8, so its 1.8 V establishes nothing about
// pin 7 -- it may be pin 8's (OVLO). With readings separating it from both neighbours the same 1.8 V
// is held below; with the pad at the baseline to pin 8 as well, it stays a candidate. The reading with
// the join removed, or the pad joined only by a kilohm reading, is no reading of pin 7 at all. With no
// join, a stated bound of 2.5 V does
// not establish a hold against a 2.41 V minimum, even hedged words aside; a bound of 2.0 V or a value of
// 0.3 V does; a value inside the window establishes nothing; 3.0 V is above. A low reading on pin 22,
// the right column's seventh lead from the top, is not the enable pin's.
test fn an_enable_bound_above_the_threshold_minimum_establishes_nothing() -> Bool {
  let identified = finding_holds(layout: p4261_e1_layout, f: ComponentIdentified { component: e1_u1_p5 })
    && carrier_finding(layout: p4261_e1_layout, f: ComponentIdentified { component: e1_u1_p5 }) == carrier_finding(layout: p4261_e1_layout, f: ComponentIdentified { component: e1_u1_p5 })
  let pad_reading = filter(e1_bench_record.voltages, o => component_identity_eq(a: o.at.component, b: e1_pin7_pad))
  let kilohm_join = map(filter(e1_pin7_resistances, o => component_identity_eq(a: o.first.component, b: e1_u1_p5)), o => ResistanceObservation {
    asset: o.asset, first: o.first, second: o.second, record: o.record, conditions: o.conditions, range: o.range, display: DisplayValue { ohms: 3500, approximate: false },
    stability: o.stability, certainty: o.certainty, order: o.order, evidence: o.evidence,
  })
  let live = enable_gap(ss: enable_of(layout: p4261_e1_layout), which: 3) && !finding_holds(layout: p4261_e1_layout, f: ControllerEnableState { component: e1_u1_p5 })
    && count(pad_reading) == 2
    && enable_is(ss: enable_of(layout: e1_with_bench(vs: pad_reading, rs: concat(e1_pin7_resistances, separated_from_neighbours()))), held: true)
    && enable_gap(ss: enable_of(layout: e1_with_bench(vs: pad_reading, rs: concat(e1_pin7_resistances, [pad_to_pin(pin: "pin 6", display: DisplayOverRange), pad_to_pin(pin: "pin 8", display: DisplayAtProbeBaseline)]))), which: 3)
    && enable_gap(ss: enable_of(layout: e1_with_bench(vs: pad_reading, rs: [])), which: 0)
    && enable_gap(ss: enable_of(layout: e1_with_bench(vs: pad_reading, rs: kilohm_join)), which: 0)
  let bound_red = enable_gap(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: ReadBelow { bound: millivolt(count: 2500) }))), which: 1)
  let bound_held = enable_is(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: ReadBelow { bound: millivolt(count: 2000) }))), held: true)
  let value_held = enable_is(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: about(mv: 300)))), held: true)
    && finding_holds(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: about(mv: 300))), f: ControllerEnableState { component: e1_u1_p5 })
  let window = enable_gap(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: about(mv: 2480)))), which: 2)
  let above = enable_is(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: about(mv: 3000)))), held: false)
  let wrong_pin = enable_gap(ss: enable_of(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 22", value: about(mv: 300)))), which: 0)
  identified && live && bound_red && bound_held && value_held && window && above && wrong_pin
}

// A READING TAKEN AFTER AN INCIDENT SAYS SO. The same held enable reading renders with the incident
// caveat when ordered after the probe bridge, and without it when ordered before; a hedged statement
// is named as hedged.
test fn a_post_incident_reading_is_never_presented_as_before() -> Bool {
  let after = [NodeVoltageObservation {
    asset: p4261_e1_b, at: terminal_ref(component: e1_u1_p5, terminal: "pin 7" as TerminalIdentity), reference: e1_ground_ref, record: both_points_recorded,
    conditions: e1_live_bench, source: volt(count: 48), value: about(mv: 300), certainty: StatedHedged { verbatim: "supplied: i think" }, order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "supplied", verbatim: "supplied" }],
  }]
  let after_text = carrier_input_reading(layout: e1_with_voltages(vs: after))
  let before_text = carrier_input_reading(layout: e1_with_voltages(vs: u1_reading(terminal: "pin 7", value: about(mv: 300))))
  after_text.contains("read after incident 2026-10-19 probe bridge")
    && after_text.contains("rests on readings taken after an incident or of unrecorded order")
    && after_text.contains("rests on a hedged statement")
    && before_text.contains("U1_P5's enable is HELD BELOW its threshold")
    && !before_text.contains("rests on readings taken after an incident")
    && !before_text.contains("hedged")
}

// A REFERENCE-DESIGN CONNECTION IS NOT AN EDGE. TI's application circuit wires the controller's GATE
// to the MOSFETs' gates, but no reading on the E1 joins U1_P5 pin 2 to Q21_P5 pin 1, so they are not
// reachable; the datasheet stays a hypothesis's source, never a reading.
test fn a_reference_design_connection_is_not_a_reachability_edge() -> Bool {
  let g = board_graph(b: e1_measured)
  !is_reachable(s: reach(g: g, a: terminal_ref(component: e1_u1_p5, terminal: "pin 2" as TerminalIdentity), b: terminal_ref(component: e1_q21, terminal: "pin 1" as TerminalIdentity)))
    && carrier_input_reading(layout: p4261_e1_layout).contains("Q4_P5 is the diode-configured MMBT3904-class transistor")
    && carrier_input_reading(layout: p4261_e1_layout).contains("incident 2026-10-19 probe bridge")
}

fn projection_of(layout: CarrierLayoutObservation) -> List<EnableProjection> {
  match installed(layout: layout, c: e1_u1_p5) {
    Absent => []
    Present { value: x } => [enable_projection(layout: layout, c: x)]
  }
}

// The projected turn-on input of a single projection of each kind, in millivolts; any other shape
// projects nothing and never equals a positive expectation.
fn unreachable_turn_on(ps: List<EnableProjection>) -> Nat? {
  match ps.first() {
    Absent => Absent
    Present { value: p } => match p {
      EnableUnreachableWithinInputBound { component: _, readings: _, turn_on_millivolts: t, bound: _ } => Present { value: t }
      EnableReachableWithinInputBound { component: _, readings: _, turn_on_millivolts: _, bound: _ } => Absent
      EnableProjectionUnestablished { component: _, gap: _ } => Absent
    }
  }
}

fn reachable_turn_on(ps: List<EnableProjection>) -> Nat? {
  match ps.first() {
    Absent => Absent
    Present { value: p } => match p {
      EnableReachableWithinInputBound { component: _, readings: _, turn_on_millivolts: t, bound: _ } => Present { value: t }
      EnableUnreachableWithinInputBound { component: _, readings: _, turn_on_millivolts: _, bound: _ } => Absent
      EnableProjectionUnestablished { component: _, gap: _ } => Absent
    }
  }
}

fn turn_on_is(t: Nat?, expected: Nat) -> Bool {
  match t {
    Present { value: v } => v == expected
    Absent => false
  }
}

fn projection_gap(ps: List<EnableProjection>, proportional_gap: Bool) -> Bool {
  count(ps) == 1 && all(ps, p => match p {
    EnableProjectionUnestablished { component: _, gap } => match gap {
      NotProportionalToSource => proportional_gap
      FewerThanTwoSourceSettings => !proportional_gap
      _ => false
    }
    _ => false
  })
}

fn pin7(mv: Nat, source_volts: Nat) -> NodeVoltageObservation {
  reading_under(c: e1_u1_p5, terminal: "pin 7", value: about(mv: mv), order: before(), source_volts: source_volts)
}

// A PROJECTION NEEDS PIN 7'S OWN READINGS. The live pad (1.8 V at 48 V, 1.35 V at 36 V) is not separated
// from pin 8, so the live E1 projects nothing. Were it separated from both neighbours, the readings
// track the input in proportion and would reach the 2.41 V minimum only near 64.3 V, above the 60 V
// working bound. Two readings out of proportion, or a single source setting, project nothing; a steeper
// divider (3.0 V at 48 V) would reach the threshold within the bound.
test fn the_enable_cannot_reach_its_threshold_within_the_input_bound() -> Bool {
  let pad_reading = filter(e1_bench_record.voltages, o => component_identity_eq(a: o.at.component, b: e1_pin7_pad))
  let separated = e1_with_bench(vs: pad_reading, rs: concat(e1_pin7_resistances, separated_from_neighbours()))
  let live = projection_gap(ps: projection_of(layout: p4261_e1_layout), proportional_gap: false)
    && !finding_holds(layout: p4261_e1_layout, f: EnableInputProjection { component: e1_u1_p5 })
    && turn_on_is(t: unreachable_turn_on(ps: projection_of(layout: separated)), expected: 64266)
    && finding_holds(layout: separated, f: EnableInputProjection { component: e1_u1_p5 })
    && carrier_input_reading(layout: separated).contains("would reach its threshold minimum only near 64.266 V, above the input's 60 V bound")
  let skewed = projection_gap(ps: projection_of(layout: e1_with_voltages(vs: [pin7(mv: 1800, source_volts: 48), pin7(mv: 1800, source_volts: 36)])), proportional_gap: true)
  let single = projection_gap(ps: projection_of(layout: e1_with_voltages(vs: [pin7(mv: 1800, source_volts: 48)])), proportional_gap: false)
    && !finding_holds(layout: e1_with_voltages(vs: [pin7(mv: 1800, source_volts: 48)]), f: EnableInputProjection { component: e1_u1_p5 })
  let steeper = turn_on_is(t: reachable_turn_on(ps: projection_of(layout: e1_with_voltages(vs: [pin7(mv: 3000, source_volts: 48), pin7(mv: 2250, source_volts: 36)]))), expected: 38560)
  live && skewed && single && steeper
}
