// ── THE K1 UNIT: its listing photographs, and nothing measured on another board ──────────────

// Every rated part on the K1's grey-block path was placed by adjacency in a photograph, so no part's
// rating is shown to apply across that input and the photographs establish NO bound. The 75 V fuse
// rating is carried as an observation and named, never promoted to a ceiling.
test fn the_photographs_establish_no_input_bound() -> Bool {
  match path_bound(layout: p4261_k1_layout, path: GreyBlindMatePath) {
    NoEstablishedBound { observed_ratings: rs } =>
      any(rs, r => (r as String).contains("75 V fuse voltage rating, placed by adjacency only"))
        && any(rs, r => (r as String).contains("100 V drain-source maximum"))
    BoundByRatedParts { maximum: _, limiting: _, relation: _ } => false
  }
}

// THE E1 READINGS DO NOT REACH THE K1. Both boards are P4261s, and that licenses nothing: the K1's J20
// path still has no bound, no pin rows, its own listing count, and its undecoded parts; the measured
// circuit names the E1 asset and not the K1's.
test fn a_reading_on_the_e1_does_not_describe_the_k1() -> Bool {
  let k1_j20 = match path_bound(layout: p4261_k1_layout, path: J20InputPath) {
    NoEstablishedBound { observed_ratings: rs } => count(rs) == 0
    BoundByRatedParts { maximum: _, limiting: _, relation: _ } => false
  }
  let k1_unmeasured = match p4261_k1_layout.circuit {
    Absent => true
    Present { value: _ } => false
  }
  k1_j20
    && k1_unmeasured
    && j20_position_count(layout: p4261_k1_layout) == 16
    && count(p4261_k1_layout.identified_signal_parts) == 0
    && physical_asset_identity_eq(a: e1_measured_circuit.asset, b: p4261_e1_b)
    && !physical_asset_identity_eq(a: e1_measured_circuit.asset, b: p4261_k1_a)
}

// ── THE E1 UNIT: the measured circuit and what it deduces ────────────────────────────────────

fn is_capacitor_row(c: ObservedComponent) -> Bool {
  match c.identification {
    IdentifiedByDatasheetMarking { row: r, marking_read: _ } => (r.ordering_code as String).contains("EEH-ZU1J151")
    MarkingSharedByMakers { rows: _, marking_read: _ } => false
    RatingPrintedOnBody { voltage: _, current: _, marking_read: _ } => false
    ResistanceCodeRead { milliohms: _, marking_read: _ } => false
    MarkingUnresolved { marking_read: _, discriminator: _ } => false
  }
}

fn is_adjacent(m: PathMembership) -> Bool {
  match m {
    OnPathByAdjacency { basis: _ } => true
    RatingAcrossInputRail { evidence: _ } => false
  }
}

// J20'S INPUT IS BOUNDED BY D2, AND ONLY BY D2. The measured circuit puts D2's tabs on J20's supply
// and ground, so its 60 V standoff bounds J20's working voltage; the evidence carries the raw diode
// reading and says the reverse direction was not read. The probed 63 V cans are on a separate node, so
// they stay observed and do not enter the bound: an identified rating is not a placed one.
test fn d2_bounds_j20_and_the_capacitors_do_not() -> Bool {
  match path_bound(layout: p4261_e1_layout, path: J20InputPath) {
    BoundByRatedParts { maximum: m, limiting: l, relation: r } =>
      volt_count(v: m) == 60
        && (l as String).contains("TVS")
        && (r as String).contains("'D2 tab nearer J20' on net 'J20 supply', 'D2 tab farther from J20' on net 'ground'")
        && (r as String).contains("red on 'D2 tab farther from J20', black on 'D2 tab nearer J20': 600 mV; the reverse direction was not read; cathode on net 'J20 supply'")
        && all(filter(p4261_e1_layout.power_components, c => is_capacitor_row(c: c)), c => is_adjacent(m: c.membership))
    NoEstablishedBound { observed_ratings: _ } => false
  }
}

fn with_components(base: CarrierLayoutObservation, cs: List<ObservedComponent>) -> CarrierLayoutObservation {
  CarrierLayoutObservation {
    labels: base.labels,
    module_receptacles: base.module_receptacles,
    grey_edge_connectors: base.grey_edge_connectors,
    j20_connector: base.j20_connector,
    j20: base.j20,
    circuit: base.circuit,
    edge_high_speed_connectors: base.edge_high_speed_connectors,
    management_io_survey: base.management_io_survey,
    management_io_observed: base.management_io_observed,
    power_components: cs,
    identified_signal_parts: base.identified_signal_parts,
    unresolved_parts: base.unresolved_parts,
  }
}

fn with_component(c: ObservedComponent) -> CarrierLayoutObservation {
  with_components(base: p4261_k1_layout, cs: concat(p4261_k1_layout.power_components, [c]))
}

// THE SAME CANS, PLACED ACROSS THE RAIL, WOULD BOUND IT AT 63 V: the RED for the rule above. The row
// is the live one, so this fails if the cited rating drifts from 63 V.
test fn the_capacitors_placed_across_the_rail_would_bound_it() -> Bool {
  let caps = filter(p4261_e1_layout.power_components, c => is_capacitor_row(c: c))
  let placed = map(caps, c => ObservedComponent {
    designators: c.designators,
    quantity: c.quantity,
    role: c.role,
    identification: c.identification,
    path: c.path,
    membership: RatingAcrossInputRail { evidence: "supplied: positive terminals joined to J20's supply under power" },
  })
  let bounded = match path_bound(layout: with_components(base: p4261_e1_layout, cs: placed), path: J20InputPath) {
    BoundByRatedParts { maximum: m, limiting: _, relation: _ } => volt_count(v: m) == 63
    NoEstablishedBound { observed_ratings: _ } => false
  }
  count(caps) == 1 && bounded
}

fn circuit_with(readings: List<ContinuityReading>, anchors: List<NetAnchor>) -> MeasuredCircuit {
  MeasuredCircuit {
    asset: e1_measured_circuit.asset,
    read_on: e1_measured_circuit.read_on,
    conditions: "supplied",
    readings: readings,
    anchors: anchors,
    input_supply: e1_measured_circuit.input_supply,
    ground: e1_measured_circuit.ground,
    diode_readings: e1_measured_circuit.diode_readings,
  }
}

// THE DEDUCTION DISCRIMINATES. The same D2 with its near tab read joined to the capacitor rail instead
// of J20's supply is not across J20, so it falls back to adjacency and bounds nothing.
test fn d2_off_the_supply_net_is_not_across_j20() -> Bool {
  let moved = circuit_with(
    readings: [
      JoinedByContinuity { terminals: [e1_j20_away_1] },
      JoinedByContinuity { terminals: [e1_j20_latch_1, e1_d2_far] },
      JoinedByContinuity { terminals: [e1_c10_pos, e1_d2_near] },
    ],
    anchors: e1_measured_circuit.anchors,
  )
  is_adjacent(m: membership_by_circuit(c: moved, positives: [e1_d2_near], returns: [e1_d2_far], otherwise: e1_adjacency_j20))
}

fn on_net(nl: MeasuredNetlist, t: ElectricalTerminalRef, net: NetIdentity) -> Bool {
  on_measured_net(netlist: nl, t: t, net: net)
}

// 0 when the circuit derives; otherwise which refusal it is.
fn refusal_key(d: NetlistDerivation) -> Nat {
  match d {
    NetlistDerived { netlist: _ } => 0
    NetlistRefused { cause } => match cause {
      OpenPairJoined { a: _, b: _ } => 1
      TwoNamesOnOneNet { first: _, second: _ } => 2
      AnchorUnreached { net: _ } => 3
    }
  }
}

fn is_derived(d: NetlistDerivation) -> Bool {
  match d {
    NetlistDerived { netlist: _ } => true
    NetlistRefused { cause: _ } => false
  }
}

// THE E1'S READINGS DERIVE THREE NAMED NETS AND NOTHING UNNAMED, and every J20 position, F1 end and D2
// tab lands where the readings put it: J20's two rows on two different nets, F1's ends together.
test fn the_e1_readings_derive_three_named_nets() -> Bool {
  match circuit_netlist(c: e1_measured_circuit) {
    NetlistRefused { cause: _ } => false
    NetlistDerived { netlist: nl } =>
      count(nl.nets) == 3 && count(nl.unnamed) == 0
        && all(nl.nets, n => any([e1_ground, e1_j20_supply, e1_capacitor_rail], x => net_identity_eq(a: x, b: n.identity)))
  }
}

// A CONTRADICTORY READING STOPS THE LINE. A supplied reading joining J20's supply to the capacitor rail
// contradicts the recorded open reading between them; a reading joining J20's two rows puts the ground
// and supply anchors on one net; an anchor no reading reaches names nothing. Each refuses with its own
// cause, and a refused circuit places no part across the input -- D2 falls back to adjacency.
test fn contradictory_readings_refuse() -> Bool {
  let open_joined = circuit_with(readings: concat(e1_measured_circuit.readings, [JoinedByContinuity { terminals: [e1_j20_away_1, e1_c10_pos] }]), anchors: e1_measured_circuit.anchors)
  let rows_joined = circuit_with(readings: concat(e1_measured_circuit.readings, [JoinedByContinuity { terminals: [e1_j20_away_1, e1_j20_latch_1] }]), anchors: e1_measured_circuit.anchors)
  let unreached = circuit_with(readings: [JoinedByContinuity { terminals: [e1_j20_latch_1, e1_d2_far] }], anchors: e1_measured_circuit.anchors)
  refusal_key(d: circuit_netlist(c: open_joined)) == 1
    && refusal_key(d: circuit_netlist(c: rows_joined)) == 2
    && refusal_key(d: circuit_netlist(c: unreached)) == 3
    && is_derived(d: circuit_netlist(c: e1_measured_circuit))
    && is_adjacent(m: membership_by_circuit(c: open_joined, positives: [e1_d2_near], returns: [e1_d2_far], otherwise: e1_adjacency_j20))
}

fn cathode_on_supply(o: JunctionOrientation) -> Bool {
  match o {
    CathodeOn { cathode_net: k, anode_net: a } => net_identity_eq(a: k, b: e1_j20_supply) && net_identity_eq(a: a, b: e1_ground)
    OrientationUnread => false
  }
}

// THE RAW READING UNDERLIES THE ORIENTATION. D2's forward reading, red on its farther tab and black on
// its nearer, and D5's, red on its upper tab and black on its lower, each put the cathode on J20's supply
// net; the reverse directions are unread, not open. The capacitor rail's two readings have no recorded
// probe placement, so they establish no orientation at all.
test fn orientation_is_derived_from_raw_readings_only() -> Bool {
  let d2 = cathode_on_supply(o: part_orientation(c: e1_measured_circuit, terminals: [e1_d2_near, e1_d2_far]))
  let d5 = cathode_on_supply(o: part_orientation(c: e1_measured_circuit, terminals: [e1_d5_upper, e1_d5_lower]))
  let caps = match part_orientation(c: e1_measured_circuit, terminals: [e1_c10_pos, e1_j20_away_1]) {
    CathodeOn { cathode_net: _, anode_net: _ } => false
    OrientationUnread => true
  }
  d2 && d5 && caps && count(readings_across(c: e1_measured_circuit, terminals: [e1_d2_near, e1_d2_far])) == 1
}

// D5 IS A SECOND CLAMP ACROSS THE SAME RAIL: its tabs read on J20's supply and on ground, so it is placed
// across the input by the circuit alone, with its own oriented reading as evidence.
test fn d5_is_a_second_clamp_across_j20s_supply() -> Bool {
  let d5 = filter(p4261_e1_layout.power_components, c => any(c.designators, d => d == "D5"))
  count(d5) == 1 && all(d5, c => match c.membership {
    RatingAcrossInputRail { evidence: e } => (e as String).contains("'D5 lower tab") && (e as String).contains("red on 'D5 upper tab") && (e as String).contains("605 mV") && (e as String).contains("cathode on net 'J20 supply'")
    OnPathByAdjacency { basis: _ } => false
  })
}

// 5PGK IDENTIFIES AN ELECTRICAL CLASS, NOT A MAKER. D2 carries both makers' rows for the code, with
// distinct vendors and one 60 V standoff, and the bound it yields is that standoff.
test fn d2_is_identified_by_class_not_maker() -> Bool {
  let parts = filter(p4261_e1_layout.power_components, c => any(c.designators, d => d == "D2" || d == "D5"))
  count(parts) == 2 && all(parts, c => match c.identification {
    MarkingSharedByMakers { rows: rs, marking_read: _ } =>
      count(rs) == 2
        && all(rs, r => volt_count(v: r.voltage_rating.maximum) == 60)
        && any(rs, r => (r.vendor.legal_name as String) == "Bourns")
        && any(rs, r => (r.vendor.legal_name as String) == "Alpha and Omega Semiconductor")
    IdentifiedByDatasheetMarking { row: _, marking_read: _ } => false
    RatingPrintedOnBody { voltage: _, current: _, marking_read: _ } => false
    ResistanceCodeRead { milliohms: _, marking_read: _ } => false
    MarkingUnresolved { marking_read: _, discriminator: _ } => false
  })
}

// THE UNPROBED THIRD CAN INHERITS NOTHING from the two probed ones: neither their identity nor their
// node. It is its own component, unresolved and adjacent.
test fn the_third_can_inherits_nothing() -> Bool {
  let third = filter(p4261_e1_layout.power_components, c => (c.role as String).contains("third SMD can"))
  count(third) == 1 && all(third, c => is_adjacent(m: c.membership) && match c.identification {
    MarkingUnresolved { marking_read: _, discriminator: _ } => true
    IdentifiedByDatasheetMarking { row: _, marking_read: _ } => false
    MarkingSharedByMakers { rows: _, marking_read: _ } => false
    RatingPrintedOnBody { voltage: _, current: _, marking_read: _ } => false
    ResistanceCodeRead { milliohms: _, marking_read: _ } => false
  })
}

// J20 IS A POWER INPUT BY CONTINUITY: 18 positions, the nine on the latch side on ground and the nine
// away from it on J20's supply, with both ends of F1 on that supply net. Its bound does not leak onto
// the grey-block path, which on this unit has no rated part placed and no bound.
test fn j20_reads_as_a_fused_power_input_and_stays_on_its_path() -> Bool {
  let grey = match path_bound(layout: p4261_e1_layout, path: GreyBlindMatePath) {
    NoEstablishedBound { observed_ratings: _ } => true
    BoundByRatedParts { maximum: _, limiting: _, relation: _ } => false
  }
  let placed = match circuit_netlist(c: e1_measured_circuit) {
    NetlistRefused { cause: _ } => false
    NetlistDerived { netlist: nl } =>
      all(housing_side_terminals(h: e1_j20_housing, side: LatchSide), x => on_net(nl: nl, t: x, net: e1_ground))
        && all(housing_side_terminals(h: e1_j20_housing, side: AwayFromLatch), x => on_net(nl: nl, t: x, net: e1_j20_supply))
        && on_net(nl: nl, t: e1_f1_near, net: e1_j20_supply) && on_net(nl: nl, t: e1_f1_far, net: e1_j20_supply)
  }
  j20_position_count(layout: p4261_e1_layout) == 18
    && count(housing_side_terminals(h: e1_j20_housing, side: LatchSide)) == 9
    && placed
    && grey
}

// F300 IS ON J20'S SUPPLY, AND ITS RATING BOUNDS NOTHING. Both its ends read on J20's supply net, so it
// is on J20's path; a fuse has no return terminal, so its 75 V interrupt rating is carried as observed,
// never placed across the rail -- the J20 bound stays D2's 60 V.
test fn f300_is_on_j20s_supply_and_bounds_nothing() -> Bool {
  let on_supply = match circuit_netlist(c: e1_measured_circuit) {
    NetlistRefused { cause: _ } => false
    NetlistDerived { netlist: nl } => on_net(nl: nl, t: e1_f300_one_end, net: e1_j20_supply) && on_net(nl: nl, t: e1_f300_other_end, net: e1_j20_supply)
  }
  let f300 = filter(p4261_e1_layout.power_components, c => any(c.designators, d => d == "F300"))
  let observed_only = match path_bound(layout: p4261_e1_layout, path: J20InputPath) {
    BoundByRatedParts { maximum: m, limiting: _, relation: _ } => volt_count(v: m) == 60
    NoEstablishedBound { observed_ratings: _ } => false
  }
  on_supply && count(f300) == 1 && all(f300, c => is_adjacent(m: c.membership)) && observed_only
}

// U522 is identified as a management-bus part, and the management text names the pins to trace.
test fn the_tmp275_is_a_trace_target() -> Bool {
  let t = management_io_text(layout: p4261_e1_layout)
  t.contains("U522 ('TI 31 / T275') is TMP275AIDGKR") && t.contains("1 SDA, 2 SCL, 3 ALERT")
}

fn with_survey(base: CarrierLayoutObservation, survey: ManagementIoSurvey) -> CarrierLayoutObservation {
  CarrierLayoutObservation {
    labels: base.labels,
    module_receptacles: base.module_receptacles,
    grey_edge_connectors: base.grey_edge_connectors,
    j20_connector: base.j20_connector,
    j20: base.j20,
    circuit: base.circuit,
    edge_high_speed_connectors: base.edge_high_speed_connectors,
    management_io_survey: survey,
    management_io_observed: base.management_io_observed,
    power_components: base.power_components,
    identified_signal_parts: base.identified_signal_parts,
    unresolved_parts: base.unresolved_parts,
  }
}

// A close-up establishes what it shows and no absence. The E1 has been photographed only in close-ups,
// so its text names J620 and claims no missing RJ45 or console; the K1 listing photographed the whole
// board, so its absence reading stands. The same E1 rows, re-declared as photographed whole, would
// claim the absence -- the survey extent, not the rows, decides it.
test fn a_close_up_establishes_no_absence() -> Bool {
  let e1 = management_io_text(layout: p4261_e1_layout)
  let k1 = management_io_text(layout: p4261_k1_layout)
  let e1_as_whole = management_io_text(layout: with_survey(base: p4261_e1_layout, survey: WholeBoardPhotographed))
  !e1.contains("shows no RJ45")
    && e1.contains("no absence of management I/O is established")
    && e1.contains("J620")
    && k1.contains("shows no RJ45")
    && e1_as_whole.contains("shows no RJ45")
}

fn supply_side_is_away(p: PolarityReading) -> Bool {
  match p {
    PolarityRecorded { supply_side, ground_side } => match supply_side {
      AwayFromLatch => match ground_side { LatchSide => true _ => false }
      _ => false
    }
    PolarityUnrecorded { reason: _ } => false
  }
}

fn supply_side_is_latch(p: PolarityReading) -> Bool {
  match p {
    PolarityRecorded { supply_side, ground_side: _ } => match supply_side { LatchSide => true _ => false }
    PolarityUnrecorded { reason: _ } => false
  }
}

fn is_unrecorded(p: PolarityReading) -> Bool {
  match p {
    PolarityRecorded { supply_side: _, ground_side: _ } => false
    PolarityUnrecorded { reason: _ } => true
  }
}

fn housing_with_sides(latch_row_side: RowSide, away_row_side: RowSide) -> ConnectorHousing {
  ConnectorHousing {
    component: e1_j20_housing.component,
    positions: map(e1_j20_housing.positions, p => HousingPosition {
      terminal: p.terminal,
      side: match p.side {
        LatchSide => latch_row_side
        AwayFromLatch => away_row_side
        SideUnrecorded => SideUnrecorded
      },
      index: p.index,
    }),
  }
}

// J20'S POLARITY IS DERIVED FROM THE NETS AGAINST THE LATCH, AND ONLY A CONSISTENT READING COUNTS. The
// E1's housing puts the supply-net row away from the latch; the same positions recorded on the opposite
// sides read the other way round; a housing with a side unrecorded, or both rows recorded on one side,
// refuses rather than guessing; the K1, counted from a photograph, has none.
test fn j20_polarity_is_read_against_the_latch() -> Bool {
  supply_side_is_away(p: polarity_reading(layout: p4261_e1_layout))
    && supply_side_is_latch(p: housing_polarity(h: housing_with_sides(latch_row_side: AwayFromLatch, away_row_side: LatchSide), c: e1_measured_circuit))
    && is_unrecorded(p: housing_polarity(h: housing_with_sides(latch_row_side: LatchSide, away_row_side: SideUnrecorded), c: e1_measured_circuit))
    && is_unrecorded(p: housing_polarity(h: housing_with_sides(latch_row_side: LatchSide, away_row_side: LatchSide), c: e1_measured_circuit))
    && is_unrecorded(p: polarity_reading(layout: p4261_k1_layout))
}

fn rated_part(volts: Nat, kind_is_fuse: Bool, membership: PathMembership) -> ObservedComponent {
  ObservedComponent {
    designators: [],
    quantity: 1,
    role: "supplied part",
    identification: RatingPrintedOnBody {
      voltage: Present { value: ComponentVoltageRating { kind: if kind_is_fuse { FuseInterruptRating } else { CapacitorRatedVoltage }, maximum: volt(count: volts) } },
      current: Absent,
      marking_read: "supplied",
    },
    path: GreyBlindMatePath,
    membership: membership,
  }
}

// A BOUND COMES ONLY FROM AN ESTABLISHED RELATION, in both directions. A lower-rated part placed by
// adjacency -- standing in for a capacitor on a downstream converted rail that shares the region --
// bounds nothing. The same part with its rating established across the input rail does bound it, and
// the lowest such rating wins.
test fn only_a_rating_across_the_input_rail_bounds_it() -> Bool {
  let adjacent = match path_bound(layout: with_component(c: rated_part(volts: 16, kind_is_fuse: false, membership: OnPathByAdjacency { basis: "supplied: shares the region" })), path: GreyBlindMatePath) {
    NoEstablishedBound { observed_ratings: rs } => any(rs, r => (r as String).contains("16 V capacitor rated voltage, placed by adjacency only"))
    BoundByRatedParts { maximum: _, limiting: _, relation: _ } => false
  }
  let across = RatingAcrossInputRail { evidence: "supplied: traced from the input terminal block" }
  let one = with_component(c: rated_part(volts: 75, kind_is_fuse: true, membership: across))
  let bounded = match path_bound(layout: one, path: GreyBlindMatePath) {
    BoundByRatedParts { maximum: m, limiting: _, relation: r } => volt_count(v: m) == 75 && (r as String).contains("traced from the input terminal block")
    NoEstablishedBound { observed_ratings: _ } => false
  }
  let two = with_components(base: one, cs: concat(one.power_components, [rated_part(volts: 63, kind_is_fuse: false, membership: across)]))
  let lowest = match path_bound(layout: two, path: GreyBlindMatePath) {
    BoundByRatedParts { maximum: m, limiting: _, relation: _ } => volt_count(v: m) == 63
    NoEstablishedBound { observed_ratings: _ } => false
  }
  adjacent && bounded && lowest
}

// The rendered readings state the input contract as unknown and carry the grey-path idea as a sourced
// hypothesis with what would decide it -- never as a derived class. The K1 reading has no bound; the E1
// reading carries J20's measured 60 V bound and still says which connector powers the module is open.
test fn the_reading_names_its_limits() -> Bool {
  let k1 = carrier_input_reading(layout: p4261_k1_layout)
  let e1 = carrier_input_reading(layout: p4261_e1_layout)
  k1.contains("grey blind-mate path: no input bound established")
    && k1.contains("hypothesis, not a derivation: the grey blind-mate connectors carry the P4261's main input")
    && k1.contains("The input voltage contract is unknown")
    && !k1.contains("at most")
    && e1.contains("J20 input path at J20")
    && e1.contains("at most 60 V, limited by the unidirectional TVS diode beside J20")
    && e1.contains("Which connector carries the module's power is not established")
    && count(p4261_grey_path_hypothesis.sources) == 2
}
