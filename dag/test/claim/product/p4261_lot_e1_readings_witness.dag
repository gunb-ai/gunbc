module test.claim.product.p4261_lot_e1_readings_witness

import std.types { List, NonEmptyStr, String }
import std.nat { Nat }
import std.optional { Absent, Present }
import product.electrical.continuity { ModuleRemoved }
import gunbc.fleet.fleet_asset_identity { p4261_e1_c, p4261_e1_s1583323120218 }
import product.placement_supply { physical_asset_identity_eq }
import product.electrical.connectivity { ElectricalTerminalRef, terminal_ref_equal }
import product.electrical.continuity { ForwardMillivolts, OverLimit }
import product.electrical.bench_session { DisplayValue, DisplayZeroWithoutBaseline, DisplayOverRange, DisplayAboveBaseline, ResistanceDisplay, ResistanceObservation }
import product.electrical.measured_netlist { MeasuredNetlist, MeasuredLink, LinkBetweenNodes, LinkWithinOneNode }
import product.p4261.readings { board_after, board_intact, board_readings, board_netlist }
import product.p4261.lot_e1_readings {
  BoardsSideBySide,
  ComparedReading,
  ReadingAgreement,
  DisplaysAgree,
  DisplaysDiffer,
  NotComparable,
  displays_agree,
  diode_displays_agree,
  is_differ,
  lot_e1_side_by_side,
  lot_e1_c_board,
  lot_e1_s218_board,
  lot_e1_c_q300_resistances,
  lot_e1_c_transistor_resistances,
  lot_e1_c_leg_check_resistances,
  lot_e1_c_gate_check_resistances,
  lot_e1_c_fuse_resistances,
  lot_e1_c_gate_part_resistances,
  lot_e1_c_after_both,
  lot_e1_c_b_removal_key,
  lot_e1_c_after_removal_resistances,
  lot_e1_c_b_fit_key,
  lot_e1_c_after_fit_resistances,
  gate_b_1_pad,
  gate_b_2_pad,
  gate_b_2_via,
  lot_e1_s218_resistances,
  lot_e1_s218_gate_part_resistances,
  gate_a_1,
  gate_a_2,
  gate_b_1,
  gate_b_2,
  red_point,
  l_pin,
  r_pin,
  u1_lead,
}
import product.p4261.e1_b { e1_q300_lone_lead, e1_ground_ref, e1_f1_near, e1_f1_far, e1_f300_one, e1_f300_other }

fn agrees(a: ReadingAgreement) -> Bool {
  match a {
    DisplaysAgree => true
    DisplaysDiffer => false
    NotComparable { why: _ } => false
  }
}

fn not_comparable(a: ReadingAgreement) -> Bool {
  match a {
    DisplaysAgree => false
    DisplaysDiffer => false
    NotComparable { why: _ } => true
  }
}

fn on_pair(c: ComparedReading, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: c.altered.first, b: a) && terminal_ref_equal(a: c.altered.second, b: b)) || (terminal_ref_equal(a: c.altered.first, b: b) && terminal_ref_equal(a: c.altered.second, b: a))
}

fn red_on(c: ComparedReading, t: ElectricalTerminalRef) -> Bool {
  match red_point(o: c.altered) {
    Present { value: r } => terminal_ref_equal(a: r, b: t)
    Absent => false
  }
}

fn comparisons_at(s: BoardsSideBySide, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ComparedReading> {
  filter(s.resistances, c => on_pair(c: c, a: a, b: b))
}

fn all_differ(cs: List<ComparedReading>) -> Bool {
  count(cs) > 0 && all(cs, c => is_differ(a: c.agreement))
}

fn all_agree(cs: List<ComparedReading>) -> Bool {
  count(cs) > 0 && all(cs, c => agrees(a: c.agreement))
}

fn altered_count() -> Nat {
  count(lot_e1_c_q300_resistances) + count(lot_e1_c_transistor_resistances) + count(lot_e1_c_leg_check_resistances) + count(lot_e1_c_gate_check_resistances) + count(lot_e1_c_fuse_resistances) + count(lot_e1_c_gate_part_resistances)
}

// The board after part B's removal: a state of its own, resolved against the board's record, holding the
// readings taken since and none from before, each a link in its own netlist.
fn state_after_removal_holds_its_own_readings() -> Bool {
  match board_after(b: lot_e1_c_board, keys: concat(lot_e1_c_after_both, [lot_e1_c_b_removal_key]), module: ModuleRemoved) {
    Absent => false
    Present { value: after_removal } => count(board_readings(s: after_removal).resistances) == count(lot_e1_c_after_removal_resistances)
      && count(lot_e1_c_after_removal_resistances) == 3
      && all_read(os: netlist_links_at(net: board_netlist(s: after_removal), a: gate_a_1, b: gate_a_2), d: DisplayValue { ohms: 5, approximate: true })
      && all_read(os: netlist_links_at(net: board_netlist(s: after_removal), a: gate_b_1_pad, b: gate_a_1), d: DisplayZeroWithoutBaseline { reported: "baseline" })
      && all_read(os: netlist_links_at(net: board_netlist(s: after_removal), a: gate_b_2_pad, b: gate_b_2_via), d: DisplayZeroWithoutBaseline { reported: "baseline" })
      && count(netlist_links_at(net: board_netlist(s: after_removal), a: gate_b_1, b: gate_b_2)) == 0
  }
}

// The board with the new part B: a third state, holding only the reading taken since, A2 to B2 at 11 ohm,
// beside the untouched board's 12 ohm on the same pair; the bare-footprint readings stay in their own state.
fn state_after_fit_holds_its_own_reading() -> Bool {
  match board_after(b: lot_e1_c_board, keys: concat(lot_e1_c_after_both, [lot_e1_c_b_removal_key, lot_e1_c_b_fit_key]), module: ModuleRemoved) {
    Absent => false
    Present { value: after_fit } => count(board_readings(s: after_fit).resistances) == 1
      && count(lot_e1_c_after_fit_resistances) == 1
      && all_read(os: netlist_links_at(net: board_netlist(s: after_fit), a: gate_a_2, b: gate_b_2), d: DisplayValue { ohms: 11, approximate: false })
      && count(netlist_links_at(net: board_netlist(s: after_fit), a: gate_b_1_pad, b: gate_a_1)) == 0
      && count(netlist_links_at(net: board_netlist(s: after_fit), a: gate_a_1, b: gate_a_2)) == 0
  }
}

fn reference_count() -> Nat {
  count(lot_e1_s218_resistances) + count(lot_e1_s218_gate_part_resistances)
}

fn link_reading(l: MeasuredLink) -> ResistanceObservation {
  match l {
    LinkBetweenNodes { reading, from: _, to: _ } => reading
    LinkWithinOneNode { reading, node: _ } => reading
  }
}

fn between_nodes(l: MeasuredLink) -> Bool {
  match l {
    LinkBetweenNodes { reading: _, from: _, to: _ } => true
    LinkWithinOneNode { reading: _, node: _ } => false
  }
}

fn reading_on_pair(o: ResistanceObservation, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: o.first, b: a) && terminal_ref_equal(a: o.second, b: b)) || (terminal_ref_equal(a: o.first, b: b) && terminal_ref_equal(a: o.second, b: a))
}

// The netlist's links between two points, as readings: only links between two nodes, none a contradiction.
fn netlist_links_at(net: MeasuredNetlist, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ResistanceObservation> {
  map(filter(net.links, l => between_nodes(l: l) && reading_on_pair(o: link_reading(l: l), a: a, b: b)), l => link_reading(l: l))
}

fn all_read(os: List<ResistanceObservation>, d: ResistanceDisplay) -> Bool {
  count(os) > 0 && all(os, o => agrees(a: displays_agree(a: o.display, b: d)))
}

// S/N 1583323120148's readings all fall in its state after both of its events, and none is lost.
test fn the_altered_board_reads_in_its_state_after_both_events() -> Bool {
  match lot_e1_side_by_side() {
    Absent => false
    Present { value: s } => count(board_readings(s: s.altered).resistances) == altered_count()
      && count(board_readings(s: s.reference).resistances) == reference_count()
  }
}

// Where the two boards differ: the two gates to each other, each gate to U1_P5's GATE, U1_P5's OUT to the
// source, L's gate to its source in both directions and in diode mode, each tab to its source with red on
// the tab, Q300's lone lead to the return, and the underside part B end to end. Nothing else differs.
test fn the_two_boards_differ_where_the_record_says_and_nowhere_else() -> Bool {
  match lot_e1_side_by_side() {
    Absent => false
    Present { value: s } => all_differ(cs: comparisons_at(s: s, a: l_pin(n: "pin 1"), b: r_pin(n: "pin 1")))
      && count(comparisons_at(s: s, a: l_pin(n: "pin 1"), b: r_pin(n: "pin 1"))) == 3
      && all_differ(cs: comparisons_at(s: s, a: l_pin(n: "pin 1"), b: u1_lead(n: "pin 2")))
      && all_differ(cs: comparisons_at(s: s, a: r_pin(n: "pin 1"), b: u1_lead(n: "pin 2")))
      && all_differ(cs: comparisons_at(s: s, a: l_pin(n: "pin 2"), b: u1_lead(n: "pin 1")))
      && all_differ(cs: comparisons_at(s: s, a: l_pin(n: "pin 1"), b: l_pin(n: "pin 2")))
      && all_agree(cs: comparisons_at(s: s, a: r_pin(n: "pin 1"), b: r_pin(n: "pin 2")))
      && all_differ(cs: filter(comparisons_at(s: s, a: l_pin(n: "tab"), b: l_pin(n: "pin 2")), c => red_on(c: c, t: l_pin(n: "tab"))))
      && all_agree(cs: filter(comparisons_at(s: s, a: l_pin(n: "tab"), b: l_pin(n: "pin 2")), c => red_on(c: c, t: l_pin(n: "pin 2"))))
      && all_differ(cs: comparisons_at(s: s, a: e1_q300_lone_lead, b: e1_ground_ref))
      && all_differ(cs: comparisons_at(s: s, a: gate_b_1, b: gate_b_2))
      && count(comparisons_at(s: s, a: gate_a_1, b: gate_a_2)) == 0
      && count(filter(s.resistances, c => is_differ(a: c.agreement))) == 13
      && count(filter(s.diodes, c => is_differ(a: c.agreement))) == 1
      && count(filter(s.resistances, c => agrees(a: c.agreement))) == 19
  }
}

// Q300's six diode readings, the fuses, the bonded source pins, the shared drain and the shared source
// agree between the boards; what only one board has is listed apart, with the statements without figures
// (the underside readings S/N 1583323120148 gave as 'the same' among them).
test fn the_untouched_board_agrees_where_it_should_and_the_rest_is_kept_apart() -> Bool {
  match lot_e1_side_by_side() {
    Absent => false
    Present { value: s } => count(s.diodes) == 14
      && all_agree(cs: comparisons_at(s: s, a: e1_f1_near, b: e1_f1_far))
      && all_agree(cs: comparisons_at(s: s, a: e1_f300_one, b: e1_f300_other))
      && all_agree(cs: comparisons_at(s: s, a: l_pin(n: "pin 2"), b: r_pin(n: "pin 2")))
      && all_agree(cs: comparisons_at(s: s, a: l_pin(n: "tab"), b: r_pin(n: "tab")))
      && all_agree(cs: comparisons_at(s: s, a: l_pin(n: "pin 2"), b: l_pin(n: "pin 7")))
      && count(s.only_on_altered) == 4
      && count(s.only_on_reference) == 12
      && count(s.stated_on_altered) == 13
      && count(s.diodes_only_on_altered) == 0
      && count(s.diodes_only_on_reference) == 0
  }
}

// The grain: the probes' level against a few ohms agrees, open against 10 ohm differs, 0.6 Mohm against
// 10 Mohm differs, values within a factor of three agree and beyond it differ, open against 16 Mohm
// agrees, an unvalued display compares with nothing; a conducting junction against none differs, two
// charging readings agree, junctions 51 mV apart agree and 200 mV apart differ.
test fn the_grain_discriminates() -> Bool {
  agrees(a: displays_agree(a: DisplayZeroWithoutBaseline { reported: "0.6ohm" }, b: DisplayValue { ohms: 2, approximate: false }))
    && is_differ(a: displays_agree(a: DisplayOverRange, b: DisplayValue { ohms: 10, approximate: false }))
    && is_differ(a: displays_agree(a: DisplayValue { ohms: 600000, approximate: true }, b: DisplayValue { ohms: 10000000, approximate: true }))
    && agrees(a: displays_agree(a: DisplayValue { ohms: 15000, approximate: true }, b: DisplayValue { ohms: 25000, approximate: true }))
    && is_differ(a: displays_agree(a: DisplayValue { ohms: 15000, approximate: true }, b: DisplayValue { ohms: 50000, approximate: true }))
    && agrees(a: displays_agree(a: DisplayOverRange, b: DisplayValue { ohms: 16000000, approximate: true }))
    && not_comparable(a: displays_agree(a: DisplayAboveBaseline, b: DisplayValue { ohms: 5, approximate: false }))
    && is_differ(a: diode_displays_agree(a: ForwardMillivolts { millivolts: 139 }, b: OverLimit))
    && agrees(a: diode_displays_agree(a: ForwardMillivolts { millivolts: 1900 }, b: ForwardMillivolts { millivolts: 1600 }))
    && agrees(a: diode_displays_agree(a: ForwardMillivolts { millivolts: 400 }, b: ForwardMillivolts { millivolts: 451 }))
    && is_differ(a: diode_displays_agree(a: ForwardMillivolts { millivolts: 400 }, b: ForwardMillivolts { millivolts: 600 }))
}

// Each board keeps its own readings: every row names its own asset, and the untouched board's state reads
// none of the altered board's.
test fn each_board_keeps_its_own_readings() -> Bool {
  all(lot_e1_c_board.bench.resistances, o => physical_asset_identity_eq(a: o.asset, b: p4261_e1_c))
    && all(lot_e1_s218_board.bench.resistances, o => physical_asset_identity_eq(a: o.asset, b: p4261_e1_s1583323120218))
    && count(board_readings(s: board_intact(b: lot_e1_s218_board, module: lot_e1_s218_board.analysis.module)).resistances) == reference_count()
    && all(board_readings(s: board_intact(b: lot_e1_s218_board, module: lot_e1_s218_board.analysis.module)).resistances, o => physical_asset_identity_eq(a: o.asset, b: p4261_e1_s1583323120218))
}

// Each board's measured netlist carries the underside readings as links between its nodes: on S/N
// 1583323120148 B's ends open to each other, and none of the readings it gave only as 'the same'; on S/N
// 1583323120218 A's and B's ends each about 6 ohm apart, A2 12 ohm from B2, and each gate a link to its
// own part's end 2 that joins nothing.
test fn the_underside_parts_reach_each_boards_netlist() -> Bool {
  match lot_e1_side_by_side() {
    Absent => false
    Present { value: s } => all_read(os: netlist_links_at(net: board_netlist(s: s.altered), a: gate_b_1, b: gate_b_2), d: DisplayOverRange)
      && count(netlist_links_at(net: board_netlist(s: s.altered), a: gate_a_1, b: gate_a_2)) == 0
      && count(netlist_links_at(net: board_netlist(s: s.altered), a: gate_a_2, b: gate_b_2)) == 0
      && all_read(os: netlist_links_at(net: board_netlist(s: s.reference), a: gate_b_1, b: gate_b_2), d: DisplayValue { ohms: 6, approximate: true })
      && all_read(os: netlist_links_at(net: board_netlist(s: s.reference), a: gate_a_1, b: gate_a_2), d: DisplayValue { ohms: 6, approximate: true })
      && all_read(os: netlist_links_at(net: board_netlist(s: s.reference), a: gate_a_2, b: gate_b_2), d: DisplayValue { ohms: 12, approximate: false })
      && all_read(os: netlist_links_at(net: board_netlist(s: s.reference), a: gate_a_1, b: gate_b_1), d: DisplayOverRange)
      && count(netlist_links_at(net: board_netlist(s: s.reference), a: l_pin(n: "pin 1"), b: gate_a_2)) == 1
      && count(netlist_links_at(net: board_netlist(s: s.reference), a: r_pin(n: "pin 1"), b: gate_b_2)) == 1
  }
}

// Part B's removal divides S/N 1583323120148's states: the board after it resolves as a state of its own and
// holds only the three readings taken since (A end to end, B's bare pads to A1 and to the via), while every
// earlier reading stays in the state after both earlier events (the first test), B's open among them.
test fn the_removal_of_part_b_divides_the_board() -> Bool {
  state_after_removal_holds_its_own_readings()
}

// Fitting the new part B divides the board again: the state after it holds only the A2-to-B2 reading, and
// the bare-footprint state keeps its three readings and gains none.
test fn fitting_the_new_part_b_divides_the_board_again() -> Bool {
  state_after_fit_holds_its_own_reading() && state_after_removal_holds_its_own_readings()
}
