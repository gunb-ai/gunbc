module test.claim.product.p4261_near_u4_converter_sheet_witness

// ==================================================================================================
// The near-U4 converter sheet, held to what a partial schematic built from readings may claim.
//
//   * No two nodes reach a common terminal, joined or proposed: SW and OUT, with the inductor's winding
//     between them, stay two nodes.
//   * A proposed connection is admissible only on evidence between exactly its counterpart terminals,
//     unpowered, off the shorted E1-b, and of a display that could join. An unrelated reading, a nonzero
//     reading, an energized reading and an E1-b reading are each refused.
//   * Nothing promotes to membership without a baseline reading AND established correspondences: a
//     reported zero or a proposed K1-a-to-E1-b correspondence leaves the anchor the node's only member.
//   * Forced-current readings are candidates, never members, and an unrecorded probe place stays inferred.
//   * Every read names a target the sheet carries, an observable and at least two outcomes.
//   * The fault's candidate set reaches beyond the photograph.
//   * The disputed 3.2 V record is cited where it stands.
//   * The drawing is generated from the rows and carries every node, continuation, dispute and alias.
// ==================================================================================================
import std.types { Bool, List }
import std.nat { Nat }
import std.algebra { string_contains }
import gunbc.fleet.fleet_asset_identity { p4261_k1_a }
import product.electrical.connectivity { ElectricalTerminalRef, terminal_ref, TerminalIdentity }
import product.electrical.bench_session {
  AutoRanging,
  DisplayAtProbeBaseline,
  DisplayValue,
  ForcedCurrentReading,
  HeldSteady,
  RangeFullScale,
  RedOnFirst,
  ResistanceObservation,
  ShortedProbeBaseline,
  StatedPlainly,
}
import product.electrical.continuity {
  BeforeIncidents,
  BenchConditions,
  both_points_recorded,
  Energized,
  EvidenceRef,
  ModuleUnrecorded,
  OperatorStatement,
  PointInferred,
  PointRecorded,
  Unpowered,
}
import product.p4261.bench { inductor_pad_far_u4 }
import product.p4261.e1_b { e1_converter_pair_resistances, e1_converter_pin, e1_forced_current_readings, e1_pad, e1_photo_part }
import product.p4261.k1_a { k1_converter_near, k1_l_4r7_near, k1_near_converter_lead_resistances, k1_return }
import product.p4261.near_u4_converter_sheet {
  aliases_resolve,
  all_connections_admissible,
  asks_settle_named_targets,
  BenchAsk,
  CandidateOpen,
  connection_admissible,
  connection_joins,
  ConverterSheet,
  Correspondence,
  CorrespondenceEstablished,
  CorrespondenceProposed,
  continuation_keys,
  drawable,
  e1_fault_candidates,
  FaultCandidate,
  fault_reaches_beyond_the_sheet,
  key_in,
  l_converter_pad,
  l_out_pad,
  member_of,
  near_u4_converter_sheet,
  near_u4_sheet_svg,
  node_members,
  observed_between,
  node_reach,
  nodes_disjoint,
  out_voltage_dispute,
  PartOnSheet,
  ProposedConnection,
  Settlement,
  SheetNode,
  sheet_drawable,
  sheet_gnd_node,
  sheet_nodes,
  sheet_out_node,
  sheet_sw_node,
  sw_connection,
}

test fn no_two_nodes_reach_a_common_terminal() -> Bool {
  nodes_disjoint(ns: sheet_nodes)
}

// RED CONTROL: OUT proposing a connection to the inductor's converter pad, SW's anchor, is caught.
data out_across_the_winding: SheetNode = SheetNode {
  key: "out", anchor: l_out_pad,
  connections: [ProposedConnection { key: "control-across-winding", first: Correspondence { sheet: l_out_pad, counterpart: sw_connection.first.counterpart, standing: CorrespondenceProposed { basis: "control" } }, second: Correspondence { sheet: l_converter_pad, counterpart: sw_connection.second.counterpart, standing: CorrespondenceProposed { basis: "control" } }, observed: sw_connection.observed }],
  by_datasheet: [], candidates: [], continuations: [],
}

test fn a_connection_across_the_winding_is_caught() -> Bool {
  !nodes_disjoint(ns: [sheet_sw_node, out_across_the_winding])
}

test fn every_sheet_connection_is_admissible_and_cited() -> Bool {
  all_connections_admissible(ns: sheet_nodes) && connection_admissible(c: sw_connection) && count(sw_connection.observed) > 0 && count(sheet_gnd_node.connections) == 5
}

// Reported zeros on the K1-a, with correspondences proposed by placement, promote nothing: the anchor is
// each node's only member, while the proposals stay reachable on the sheet.
test fn reported_zeros_and_proposed_correspondences_do_not_promote() -> Bool {
  !connection_joins(c: sw_connection)
    && count(node_members(n: sheet_sw_node)) == 1 && count(node_members(n: sheet_gnd_node)) == 1
    && member_of(ts: node_reach(n: sheet_sw_node), t: e1_pad(number: 3, name: "SW"))
    && !member_of(ts: node_members(n: sheet_sw_node), t: e1_pad(number: 3, name: "SW"))
}

fn with_observed(os: List<ResistanceObservation>) -> ProposedConnection {
  ProposedConnection { key: "control", first: sw_connection.first, second: sw_connection.second, observed: os }
}

// RED CONTROL: wrong endpoints -- the K1-a's GND lead reading cited for the SW connection -- is refused.
test fn evidence_between_other_points_is_refused() -> Bool {
  !connection_admissible(c: with_observed(os: k1_near_converter_lead_resistances))
}

data k1_sw_pin: ElectricalTerminalRef = terminal_ref(component: k1_converter_near, terminal: "pin 3 (SW)" as TerminalIdentity)

data k1_l_far_pad: ElectricalTerminalRef = terminal_ref(component: k1_l_4r7_near, terminal: inductor_pad_far_u4 as TerminalIdentity)

data control_said: EvidenceRef = OperatorStatement { stated_on: "2026-11-07", verbatim: "control fixture, not a reading" }

fn control_reading(power_on: Bool, display_baseline: Bool, ohms: Nat) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_k1_a, first: k1_sw_pin, second: k1_l_far_pad, record: both_points_recorded,
    conditions: BenchConditions { power: if power_on { Energized } else { Unpowered }, module: ModuleUnrecorded },
    polarity: RedOnFirst, range: RangeFullScale { ohms: 200 },
    display: if display_baseline { DisplayAtProbeBaseline { shown: "0.3", baseline: ShortedProbeBaseline { full_scale_ohms: 200, shown: "0.3", evidence: control_said } } } else { DisplayValue { ohms: ohms, approximate: false } },
    stability: HeldSteady, certainty: StatedPlainly, order: BeforeIncidents { keys: [] }, evidence: [control_said],
  }
}

// RED CONTROL: a nonzero reading between exactly the right points is not join evidence.
test fn a_nonzero_reading_is_refused() -> Bool {
  !connection_admissible(c: with_observed(os: [control_reading(power_on: false, display_baseline: false, ohms: 8000)]))
}

// RED CONTROL: an energized reading is of another configuration and is refused.
test fn an_energized_reading_is_refused() -> Bool {
  !connection_admissible(c: with_observed(os: [control_reading(power_on: true, display_baseline: true, ohms: 0)]))
}

// RED CONTROL: the E1-b's own SW-to-inductor zero, read after the short, places nothing.
data e1_sw_zero: List<ResistanceObservation> = observed_between(os: e1_converter_pair_resistances, a: e1_converter_pin(number: 3, name: "SW"), b: l_converter_pad)

test fn an_e1b_reading_is_refused() -> Bool {
  count(e1_sw_zero) > 0 && !connection_admissible(c: ProposedConnection {
    key: "control",
    first: Correspondence { sheet: e1_pad(number: 3, name: "SW"), counterpart: e1_converter_pin(number: 3, name: "SW"), standing: CorrespondenceProposed { basis: "control" } },
    second: Correspondence { sheet: l_converter_pad, counterpart: l_converter_pad, standing: CorrespondenceProposed { basis: "control" } },
    observed: e1_sw_zero,
  })
}

// CROSS-REVISION PROMOTION: a baseline reading on the counterpart with proposed correspondences does not
// join; the same reading with both correspondences established does, and only then do the terminals
// become members.
data baseline_proposed: ProposedConnection = with_observed(os: [control_reading(power_on: false, display_baseline: true, ohms: 0)])

data baseline_established: ProposedConnection = ProposedConnection {
  key: "control-established",
  first: Correspondence { sheet: sw_connection.first.sheet, counterpart: sw_connection.first.counterpart, standing: CorrespondenceEstablished { evidence: [control_said] } },
  second: Correspondence { sheet: sw_connection.second.sheet, counterpart: sw_connection.second.counterpart, standing: CorrespondenceEstablished { evidence: [control_said] } },
  observed: [control_reading(power_on: false, display_baseline: true, ohms: 0)],
}

test fn promotion_needs_baseline_and_established_correspondence() -> Bool {
  connection_admissible(c: baseline_proposed) && !connection_joins(c: baseline_proposed)
    && connection_joins(c: baseline_established)
    && member_of(ts: node_members(n: SheetNode { key: "sw", anchor: l_converter_pad, connections: [baseline_established], by_datasheet: [], candidates: [], continuations: [] }), t: e1_pad(number: 3, name: "SW"))
}

test fn forced_current_ends_are_candidates_with_their_readings() -> Bool {
  let cs = concat(sheet_out_node.candidates, sheet_gnd_node.candidates)
  count(filter(cs, c => count(c.readings) == 0)) == 0
    && count(filter(cs, c => member_of(ts: concat(node_members(n: sheet_out_node), node_members(n: sheet_gnd_node)), t: c.terminal))) == 0
}

// The two 0.10 A readings keep the meter's black lead as inferred, not as G.
test fn an_unrecorded_probe_place_stays_inferred() -> Bool {
  count(filter(e1_forced_current_readings, r => r.injected_milliamps == 100 && match r.record.second { PointInferred { basis: _ } => true, PointRecorded => false })) == 2
}

test fn unknown_continuations_are_on_the_sheet() -> Bool {
  let ks = continuation_keys(ns: sheet_nodes)
  key_in(ks: ks, k: "out-loads") && key_in(ks: ks, k: "out-copper-route") && key_in(ks: ks, k: "vin-continuation") && key_in(ks: ks, k: "en-continuation")
    && key_in(ks: ks, k: "pg-continuation") && key_in(ks: ks, k: "ss-continuation") && key_in(ks: ks, k: "fb-continuation")
    && key_in(ks: ks, k: "out-7-8-chain") && key_in(ks: ks, k: "out-9-far-end") && key_in(ks: ks, k: "gnd-4-6-or-vin")
}

test fn every_read_names_a_target_an_observable_and_outcomes() -> Bool {
  asks_settle_named_targets(s: near_u4_converter_sheet)
}

fn with_asks(asks: List<BenchAsk>) -> ConverterSheet {
  ConverterSheet {
    title: near_u4_converter_sheet.title, aliases: near_u4_converter_sheet.aliases, nodes: near_u4_converter_sheet.nodes,
    disputes: near_u4_converter_sheet.disputes, e1_removals: near_u4_converter_sheet.e1_removals, fault_key: near_u4_converter_sheet.fault_key,
    e1_fault: near_u4_converter_sheet.e1_fault, fault_candidates: near_u4_converter_sheet.fault_candidates, asks: asks,
  }
}

// RED CONTROLS: a read whose target the sheet does not carry, and one with a single possible outcome.
test fn a_read_on_an_unnamed_target_or_with_one_outcome_is_refused() -> Bool {
  !asks_settle_named_targets(s: with_asks(asks: [BenchAsk { key: "stray", on: "control", procedure: "control", settles: [Settlement { target: "a-node-nobody-drew", observable: "control", outcomes: ["a", "b"] }] }]))
    && !asks_settle_named_targets(s: with_asks(asks: [BenchAsk { key: "one-way", on: "control", procedure: "control", settles: [Settlement { target: "sw", observable: "control", outcomes: ["only one"] }] }]))
}

test fn the_fault_set_reaches_beyond_the_photograph() -> Bool {
  fault_reaches_beyond_the_sheet(cs: e1_fault_candidates)
}

data photo_only_candidates: List<FaultCandidate> = [
  PartOnSheet { part: e1_photo_part(label: "1"), standing: CandidateOpen },
  PartOnSheet { part: e1_photo_part(label: "3"), standing: CandidateOpen },
]

test fn a_photo_only_fault_set_is_refused() -> Bool {
  !fault_reaches_beyond_the_sheet(cs: photo_only_candidates)
}

test fn every_photo_label_names_a_placed_part() -> Bool {
  aliases_resolve(s: near_u4_converter_sheet)
}

test fn the_disputed_record_is_cited_where_it_stands() -> Bool {
  count(out_voltage_dispute.held) == 1
}

test fn the_drawing_carries_every_node_continuation_dispute_and_alias() -> Bool {
  let svg = near_u4_sheet_svg()
  sheet_drawable(s: near_u4_converter_sheet)
    && count(filter(sheet_nodes, n => !string_contains(s: svg, pattern: join(["NODE ", n.key as String], "")))) == 0
    && count(filter(continuation_keys(ns: sheet_nodes), k => !string_contains(s: svg, pattern: join(["? ", k as String, ":"], "")))) == 0
    && string_contains(s: svg, pattern: "DISPUTED out-voltage-3v2")
    && count(filter(near_u4_converter_sheet.aliases, a => !string_contains(s: svg, pattern: join([a.label as String, " = "], "")))) == 0
}

// RED CONTROL: a text holding '&' or '<' is refused rather than drawn into broken SVG.
test fn an_undrawable_text_is_refused() -> Bool {
  !drawable(t: "R & D") && !drawable(t: "a < b") && drawable(t: "plain text")
}
