module test.claim.algebra_receiver_annotated_witness_test

import std.types { Bool, Int, List, String }
import std.algebra { Cons, Empty }
import v2.std.optional { Present, Absent }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus, CensusObserved, CensusNotRunnable }
import gunbc.guarantee_probe_corpus { census_blocking_count_for_class }

fn blocking_count_for(source: String, wanted: String) -> Int {
  match census_blocking_count_for_class(
    census: compile_dag_diagnostic_census(source),
    wanted: wanted
  ) {
    Present { value: n } => n
    Absent => 0 - 1
  }
}

// The declared List<Int> is a nominal application. Its argument is the Int
// algebra_child_or_placeholder is missing on a Cons expansion. Binding that
// annotation supplies the evidence; it must not skip the check.
test fn annotated_list_cons_fold_resolves() -> Bool {
  let l: List<Int> = Cons { head: 1, tail: [2, 3] }
  l |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

test fn list_literal_fold_stays_green() -> Bool {
  [1, 2, 3] |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

fn a_call_result() -> List<Int> {
  [1, 2, 3]
}

test fn call_result_fold_stays_green() -> Bool {
  a_call_result() |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

fn annotated_parameter_fold(xs: List<Int>) -> Int {
  xs |> fold(init: 0, f: fn(acc, x) { acc + x })
}

test fn annotated_fn_parameter_fold_resolves() -> Bool {
  annotated_parameter_fold(xs: [1, 2, 3]) == 6
}

// Unannotated constructors remain expansions. These programs live in strings
// so the required corpus does not absorb their refusal, and the class name
// is the check that a green here is the SAME wall, not a different error.
data unannotated_cons_fold_source: String = "module annotated_recv_unannotated_cons\nimport std.types { Int }\nimport std.algebra { Cons }\nfn asks() -> Int { Cons { head: 1, tail: [2, 3] } |> fold(init: 0, f: fn(acc, x) { acc + x }) }\n"
data unannotated_empty_fold_source: String = "module annotated_recv_unannotated_empty\nimport std.types { Int }\nimport std.algebra { Empty }\nfn asks() -> Int { Empty |> fold(init: 0, f: fn(acc, x) { acc + x }) }\n"

test fn unannotated_cons_fold_still_refuses_application_evidence() -> Bool {
  blocking_count_for(source: unannotated_cons_fold_source, wanted: "AlgebraApplicationEvidenceUnavailable") >= 1
}

test fn unannotated_empty_fold_still_refuses_application_evidence() -> Bool {
  blocking_count_for(source: unannotated_empty_fold_source, wanted: "AlgebraApplicationEvidenceUnavailable") >= 1
}
