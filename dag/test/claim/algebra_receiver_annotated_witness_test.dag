module test.claim.algebra_receiver_annotated_witness_test

import std.types { Bool, Int, List }
import std.algebra { Cons, Empty, FreeMonoid }

// The declared List<Int> is a nominal application. Its argument is the Int
// algebra_child_or_placeholder is missing on a Cons expansion. Binding that
// annotation supplies the evidence; it must not skip the check.
// Unannotated Cons/Empty refusals wait on #10625's evidence wall and are not
// enrolled here: on this main they still execute, so a census for
// AlgebraApplicationEvidenceUnavailable would be a premature red, not a discriminator.
test fn annotated_list_cons_fold_resolves() -> Bool {
  let l: List<Int> = Cons { head: 1, tail: [2, 3] }
  l |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

test fn list_literal_fold_stays_green() -> Bool {
  [1, 2, 3] |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

fn a_call_result() -> List<Int> {
  [1, 2, 3]
}

test fn call_result_fold_stays_green() -> Bool {
  a_call_result() |> fold(init: 0, f: fn(acc, x) { acc + x }) == 6
}

fn annotated_parameter_fold(xs: List<Int>) -> Int {
  xs |> fold(init: 0, f: fn(acc, x) { acc + x })
}

test fn annotated_fn_parameter_fold_resolves() -> Bool {
  annotated_parameter_fold(xs: [1, 2, 3]) == 6
}

// Annotated Empty as fold init: the declared FreeMonoid<Int> is the
// application; Empty's expansion is not. Same binding as the Cons receiver
// above, different constructor and a different fold argument.
test fn annotated_freemonoid_empty_initializer_fold_resolves() -> Bool {
  let initial: FreeMonoid<Int> = Empty
  [1, 2] |> fold(init: initial, f: fn(acc, value) { acc |> list_push(value) }) == [1, 2]
}
