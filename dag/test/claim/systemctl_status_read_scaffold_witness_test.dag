module test.claim.systemctl_status_read_scaffold

import std.types { Bool, NonEmptyStr, String }
import gunbc.systemctl_status_read {
  systemctl_status_read_local,
  systemctl_status_operation_argv_matches_authority,
  unit_status_capture_from_stdout,
}
import gunbc.host_effect { LocalShell }
import gunbc.live_deploy.intent {
  live_deploy_unit_diagnosis_dissolution_trigger,
  live_deploy_unit_diagnosis_capture_exit_note,
  live_deploy_unit_status_tail_scaffold,
}
import std.disposition { Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn witness_status_operation_argv_matches_authority() -> Bool {
  systemctl_status_operation_argv_matches_authority(unit: "demo.service" as NonEmptyStr)
}

fn witness_status_read_local_returns_text() -> Bool {
  match systemctl_status_read_local(unit: "demo.service" as NonEmptyStr) {
    UnitStatusCaptured { text: t } => t != ""
    UnitStatusCaptureRefused { reason: _ } => false
  }
}

fn witness_dead_unit_status_capture_preserves_failed_text() -> Bool {
  match unit_status_capture_from_stdout(
    stdout: "● gunbc-roadmap.service - Gunbc Roadmap\n     Loaded: loaded\n     Active: failed (Result: exit-code)",
    refusal: "",
  ) {
    UnitStatusCaptured { text: t } => string_contains(s: t, pattern: "failed")
    UnitStatusCaptureRefused { reason: _ } => false
  }
}

fn witness_dissolution_trigger_declared_on_capture_note() -> Bool {
  string_contains(
    s: live_deploy_unit_diagnosis_capture_exit_note,
    pattern: "dissolves-on: unit-diagnosis modeled as a typed systemd.Systemctl.Status observation",
  )
}

fn witness_status_tail_scaffold_binds_dissolution_trigger() -> Bool {
  match live_deploy_unit_status_tail_scaffold {
    Scaffold {
      dissolves_to: SingleAuthority,
      bind: DeclarationRef { module_path: m, decl_name: n, field: WholeDeclaration },
    } =>
      m == "gunbc.live_deploy.intent"
        && n == "live_deploy_unit_diagnosis_dissolution_trigger"
        && string_contains(
          s: live_deploy_unit_diagnosis_dissolution_trigger,
          pattern: "never masked",
        )
    Terminal { reason: _ } => false
  }
}

test fn systemctl_status_read_scaffold_witnesses() -> Bool {
  witness_status_operation_argv_matches_authority()
    && witness_status_read_local_returns_text()
    && witness_dead_unit_status_capture_preserves_failed_text()
    && witness_dissolution_trigger_declared_on_capture_note()
    && witness_status_tail_scaffold_binds_dissolution_trigger()
}
