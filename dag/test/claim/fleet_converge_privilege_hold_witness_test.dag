module test.claim.fleet_converge_privilege_hold_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// RED control: whole-binary install/systemctl on the operator roster is root-equivalent
// and held for operator ruling — not an accidental merge artifact.
test fn witness_operator_roster_not_widened_to_whole_binary_install_or_systemctl() -> Bool {
  length(xs: fleet_posix_operator_sudo_grants()) == 1
    && fleet_posix_operator_sudo_grant_is_hostnamectl_only()
    && length(xs: fleet_posix_ci_runner_sudo_grants()) >= 2
}

test fn witness_receipt_publication_uses_staging_rename_grain() -> Bool {
  fleet_converge_receipt_staging_path(host: "srv1") == "/opt/gunbc/receipts/srv1-converge-receipt.staging"
    && fleet_converge_receipt_path(host: "srv1") == "/opt/gunbc/receipts/srv1-converge-receipt.txt"
}

// Operator ruling 2026-08-13: converge must not re-apply MemoryMax via set-property.
test fn witness_convergence_suppresses_memory_max_set_property() -> Bool {
  host_converge_slice1_memory_max_converge_apply_suppressed
}
