module test.claim.printer_custody_source_witness
import std.types { Bool, String }
import std.algebra { string_contains }
import gunbc.fleet.fleet_asset_identity { printer_01, printer_02 }
import gunbc.fleet.printer_credential_source {
  printer_custody_path, printer_custody_record_text, parse_printer_custody_record,
  PrinterCustodyPresent, PrinterCustodyRefused,
}
import extdeps.cloud.gcp.secret_manager { sm_resolved_version_id, SmVersionIdProjected, SmVersionIdNotAVersionResource }

// The shell route reads a host custody record {code, sm_resolved}; every defect is a typed refusal naming
// the path, and nothing falls back to Secret Manager (this route holds no Google identity).

fn good_record() -> String { printer_custody_record_text(code: "12345678", resolved: "projects/1/secrets/printer-01-access-code/versions/7") }

test fn a_custody_record_round_trips_code_and_version() -> Bool {
  match parse_printer_custody_record(path: "/p", text: good_record()) {
    PrinterCustodyPresent { record: r } => (r.code as String) == "12345678" && (match sm_resolved_version_id(identity: r.resolved) { SmVersionIdProjected { version: v } => (v as String) == "7" SmVersionIdNotAVersionResource { supplied: _ } => false })
    PrinterCustodyRefused { path: _, cause: _ } => false
  }
}

test fn a_malformed_or_incomplete_custody_record_refuses_naming_the_path() -> Bool {
  all(["", "not json", "{}", "{\"code\":\"\",\"sm_resolved\":\"projects/1/secrets/s/versions/1\"}", "{\"code\":\"1\"}", "{\"code\":\"1\",\"sm_resolved\":\"latest\"}"], t =>
    match parse_printer_custody_record(path: "/etc/gunbc-printer-credentials/printer-01.json", text: t) {
      PrinterCustodyRefused { path: p, cause: _ } => p == "/etc/gunbc-printer-credentials/printer-01.json"
      PrinterCustodyPresent { record: _ } => false
    })
}

test fn each_printer_has_its_own_custody_file_under_the_custody_directory() -> Bool {
  (printer_custody_path(printer: printer_01) as String) == "/etc/gunbc-printer-credentials/printer-01.json" &&
  (printer_custody_path(printer: printer_02) as String) == "/etc/gunbc-printer-credentials/printer-02.json" &&
  !string_contains(s: good_record(), pattern: "latest")
}
