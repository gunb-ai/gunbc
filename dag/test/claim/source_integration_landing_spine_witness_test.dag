module test.claim.source_integration_landing_spine_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn p0_claim(
  id: std.types.NonEmptyStr,
  target: std.types.NonEmptyStr,
  bound: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingRequiredClaim {
  std.claim_evidence.Claim {
    id: id,
    subject: "rename-worker-and-update-callers",
    target: target,
    proposition: gunbc.source_integration_landing_spine.LandingGuaranteeProposition {
      statement: id,
    },
    scope: "source-and-public-behavior",
    bound: bound,
  }
}

fn p0_builds_claim() -> gunbc.source_integration_landing_spine.LandingRequiredClaim {
  p0_claim(
    id: "builds",
    target: "accepted-main",
    bound: "proposal-50-agent-fixture-attempt-1",
  )
}

fn p0_behavior_claim() -> gunbc.source_integration_landing_spine.LandingRequiredClaim {
  p0_claim(
    id: "preserves-public-behavior",
    target: "accepted-main",
    bound: "proposal-50-agent-fixture-attempt-1",
  )
}

fn p0_proposal_with(
  submitted_at: std.types.Timestamp,
  guarantees: gunbc.source_integration_landing_spine.LandingRequiredClaims,
) -> gunbc.source_integration_landing_spine.LandingProposalContract {
  gunbc.source_integration_landing_spine.LandingProposalContract {
    occurrence: "proposal-50-agent-fixture",
    attempt: "proposal-50-agent-fixture-attempt-1",
    target: "accepted-main",
    authored_parent: "accepted-state-41",
    transformation: "rename-worker-and-update-callers",
    reads_relies: ["declaration-worker", "caller-build"],
    modifies_frame: ["source-worker", "source-callers"],
    ensures_guarantees: guarantees,
    dependencies: [],
    atomicity: LandingWholeProposalAtomic,
    submit_authority: "fixture-author",
    submitted_at: submitted_at,
  }
}

fn p0_proposal() -> gunbc.source_integration_landing_spine.LandingProposalContract {
  p0_proposal_with(
    submitted_at: "2026-07-29T08:00:00Z",
    guarantees: gunbc.source_integration_landing_spine.LandingRequiredClaims {
      first: p0_builds_claim(),
      remaining: [p0_behavior_claim()],
    },
  )
}

fn p0_fact_claim(
  fact: RecordedFact<gunbc.source_integration_landing_spine.LandingEvidenceFact>,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  fact.value.claim == claim
    && fact.value.proposal == p0_proposal().occurrence
}

fn p0_rule_claim(
  rule: std.claim_evidence.InferenceRuleId,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  rule == "p0-observation-supports-exact-guarantee"
    && claim.subject == p0_proposal().transformation
}

fn p0_authority_claim(
  authority: gunbc.source_integration_landing_spine.LandingEvidenceAuthorityHandle,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  authority == "p0-independent-validator"
    && claim.target == p0_proposal().target
}

fn p0_provenance_claim(
  provenance: std.claim_evidence.EvidenceProvenance,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  provenance.agent == "p0-validator"
    && claim.bound == (p0_proposal().attempt as gunbc.source_integration_landing_spine.LandingClaimBound)
}

fn p0_freshness_claim(
  freshness: EvidenceFreshness<gunbc.source_integration_landing_spine.LandingRequiredClaim>,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  freshness.maximum_conclusion == claim
}

fn p0_fidelity_claim(
  fidelity: EvidenceFidelity<gunbc.source_integration_landing_spine.LandingFidelityBoundaryHandle>,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  fidelity.boundary == "p0-lossless-guarantee"
    && count(fidelity.losses) == 0
    && claim.scope == "source-and-public-behavior"
}

fn p0_independence_claim(
  independence: gunbc.source_integration_landing_spine.LandingEvidenceIndependenceHandle,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
  direction: std.claim_evidence.EvidenceDirection,
) -> Bool {
  independence == "p0-independent-probe"
    && claim.target == p0_proposal().target
    && (direction == EvidenceSupports || direction == EvidenceChallenges)
}

fn p0_link_relation(
  link: gunbc.source_integration_landing_spine.LandingEvidenceLink,
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
) -> Bool {
  link.fact.value.claim == claim
    && link.freshness.maximum_conclusion == claim
}

fn p0_admission_policy() -> gunbc.source_integration_landing_spine.LandingEvidenceAdmissionPolicy {
  std.claim_evidence.EvidenceAdmissionPolicy {
    fact_claim: p0_fact_claim,
    inference_rule_claim: p0_rule_claim,
    authority_claim: p0_authority_claim,
    provenance_claim: p0_provenance_claim,
    freshness_claim: p0_freshness_claim,
    fidelity_claim: p0_fidelity_claim,
    independence_claim: p0_independence_claim,
    relation: p0_link_relation,
  }
}

fn p0_link(
  claim: gunbc.source_integration_landing_spine.LandingRequiredClaim,
  direction: std.claim_evidence.EvidenceDirection,
  authority: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingEvidenceLink {
  std.claim_evidence.EvidenceLink {
    fact: std.claim_evidence.RecordedFact {
      id: concat("fact-", claim.id as String) as std.claim_evidence.RecordedFactId,
      value: gunbc.source_integration_landing_spine.LandingEvidenceFact {
        proposal: p0_proposal().occurrence,
        observation: concat("observed-", claim.id as String),
        claim: claim,
      },
    },
    direction: direction,
    inference_rule: "p0-observation-supports-exact-guarantee",
    authority: authority,
    provenance: std.claim_evidence.EvidenceProvenance {
      entity: "p0-validation-result",
      activity: "p0-validate-proposal",
      agent: "p0-validator",
    },
    freshness: std.claim_evidence.EvidenceFreshness {
      maximum_conclusion: claim,
      basis: "the observation is bound to this proposal attempt",
    },
    fidelity: std.claim_evidence.EvidenceFidelity {
      boundary: "p0-lossless-guarantee",
      losses: [],
    },
    probe_independence: "p0-independent-probe",
  }
}

fn p0_support(claim: gunbc.source_integration_landing_spine.LandingRequiredClaim) -> gunbc.source_integration_landing_spine.LandingEvidenceLink {
  p0_link(
    claim: claim,
    direction: EvidenceSupports,
    authority: "p0-independent-validator",
  )
}

fn p0_challenge(claim: gunbc.source_integration_landing_spine.LandingRequiredClaim) -> gunbc.source_integration_landing_spine.LandingEvidenceLink {
  p0_link(
    claim: claim,
    direction: EvidenceChallenges,
    authority: "p0-independent-validator",
  )
}

fn p0_ready_evidence() -> gunbc.source_integration_landing_spine.LandingReadyEvidenceReceipt {
  match landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_support(claim: p0_builds_claim()),
      p0_support(claim: p0_behavior_claim()),
    ],
  ) {
    LandingEvidenceReady { receipt } => receipt
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: _,
      remaining_blocking: _,
    } =>
      p0_ready_evidence()
  }
}

fn p0_result(
  handle: std.types.NonEmptyStr,
  preview: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingResultClass {
  gunbc.source_integration_landing_spine.LandingResultClass {
    result: handle,
    preview: preview,
  }
}

fn p0_refusal(
  kind: gunbc.source_integration_landing_spine.LandingRefusalKind,
  reason: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingRefusal {
  gunbc.source_integration_landing_spine.LandingRefusal {
    kind: kind,
    locus: "proposal-50-agent-fixture",
    occurrences: 1,
    internal_cause: reason,
    plain_reason: reason,
    responsible_party: "workspace owner",
    next_action: "update the requested outcome and submit again",
    receipt: content_hash_of_value(value: "p0-refusal-receipt"),
  }
}

fn p0_continuation(
  kind: gunbc.source_integration_landing_spine.LandingMachineContinuationKind,
  status: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingMachineContinuation {
  gunbc.source_integration_landing_spine.LandingMachineContinuation {
    handle: "p0-machine-continuation",
    kind: kind,
    status: status,
  }
}

fn p0_closure_evidence() -> gunbc.source_integration_landing_spine.LandingClosureEvidence {
  gunbc.source_integration_landing_spine.LandingClosureEvidence {
    capture_completeness: gunbc.source_integration_landing_spine.LandingCaptureCompletenessReceipt {
      receipt: content_hash_of_value(value: "capture-completeness-receipt"),
    },
    affected_scope: gunbc.source_integration_landing_spine.LandingAffectedScopeReceipt {
      receipt: content_hash_of_value(value: "affected-scope-receipt"),
    },
    rule_closure: gunbc.source_integration_landing_spine.LandingRuleClosureReceipt {
      receipt: content_hash_of_value(value: "rule-closure-receipt"),
    },
    candidate_generation: gunbc.source_integration_landing_spine.LandingCandidateGenerationReceipt {
      receipt: content_hash_of_value(value: "candidate-generation-receipt"),
    },
    admissibility: gunbc.source_integration_landing_spine.LandingAdmissibilityReceipt {
      receipt: content_hash_of_value(value: "admissibility-receipt"),
    },
    equivalence_quotient: gunbc.source_integration_landing_spine.LandingEquivalenceQuotientReceipt {
      receipt: content_hash_of_value(value: "equivalence-quotient-receipt"),
    },
    multiplicity: gunbc.source_integration_landing_spine.LandingMultiplicityReceipt {
      receipt: content_hash_of_value(value: "multiplicity-receipt"),
    },
  }
}

fn p0_closed_receipt(
  candidates: gunbc.source_integration_landing_spine.LandingCandidateSpace,
) -> gunbc.source_integration_landing_spine.LandingClosedResultSpaceReceipt {
  gunbc.source_integration_landing_spine.LandingClosedResultSpaceReceipt {
    subject: gunbc.source_integration_landing_spine.LandingClosureSubject {
      ready_evidence: p0_ready_evidence(),
      admission_contract: "p0-admission-contract",
      read_back_authority: gunbc.source_integration_landing_spine.LandingIndependentReadBackAuthorityReceipt {
        observer: "independent-read-back",
        admission_contract: "p0-admission-contract",
        established_by: "fixture-admission-authority",
        receipt: content_hash_of_value(value: "read-back-authority-receipt"),
      },
      equivalence: "p0-declared-equivalence",
      candidates: candidates,
    },
    closure: p0_closure_evidence(),
  }
}

fn p0_closed_one() -> gunbc.source_integration_landing_spine.LandingClosedOneReceipt {
  let result = p0_result(
    handle: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
  )
  match landing_closed_result_space(
    attempt: gunbc.source_integration_landing_spine.LandingClosureComplete {
      receipt: p0_closed_receipt(
        candidates: gunbc.source_integration_landing_spine.LandingOneResultClass { result: result },
      ),
    },
    zero_refusal: p0_refusal(
      kind: LandingSemanticRequirementsIncompatible,
      reason: "The requested guarantees cannot all hold.",
    ),
    continuation: p0_continuation(
      kind: LandingContinueInvestigation,
      status: "checking the result before it lands",
    ),
  ) {
    LandingClosedOne { receipt } => receipt
    _ => p0_closed_one()
  }
}

fn p0_admitted() -> gunbc.source_integration_landing_spine.LandingAdmittedResult {
  let semantic = p0_closed_one()
  match landing_admitted_result(
    admission: gunbc.source_integration_landing_spine.LandingAdmitted {
      receipt: gunbc.source_integration_landing_spine.LandingAdmissionReceipt {
        semantic: semantic,
        authority: "fixture-author",
        receipt: content_hash_of_value(value: "admission-receipt-42"),
      },
    },
  ) {
    LandingAdmissionAdvanced { admitted } => admitted
    LandingAdmissionNotAdvanced { decision: _ } => p0_admitted()
  }
}

fn p0_transition(
  admitted: gunbc.source_integration_landing_spine.LandingAdmittedResult,
  identity: std.types.NonEmptyStr,
  result: std.types.NonEmptyStr,
) -> gunbc.source_integration_landing_spine.LandingTransitionReceipt {
  gunbc.source_integration_landing_spine.LandingTransitionReceipt {
    admitted: admitted,
    identity: identity,
    resulting_state: result,
    transition_authority: "transition-executor",
  }
}

test fn witness_p0_full_claim_readiness_reaches_closed_one() -> Bool {
  let receipt = p0_closed_one()
  let first = receipt.closed_space.subject.ready_evidence.proposal.ensures_guarantees.first
  first == p0_builds_claim()
    && count(
      receipt.closed_space.subject.ready_evidence.readiness.submitted_links
    ) == 2
    && receipt.unique.result == "unique-result-42"
}

test fn witness_p0_same_claim_id_different_target_and_bound_blocks() -> Bool {
  let wrong = p0_claim(
    id: "builds",
    target: "another-target",
    bound: "another-attempt",
  )
  match landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_support(claim: wrong),
      p0_support(claim: p0_behavior_claim()),
    ],
  ) {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: LandingMissingEvidence { claim },
      remaining_blocking: _,
    } =>
      claim.id == p0_builds_claim().id
        && claim.target == p0_builds_claim().target
        && claim.bound == p0_builds_claim().bound
    _ => false
  }
}

test fn witness_p0_unrelated_satisfied_claim_blocks() -> Bool {
  let unrelated = p0_claim(
    id: "unrelated",
    target: "accepted-main",
    bound: "proposal-50-agent-fixture-attempt-1",
  )
  match landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [p0_support(claim: unrelated)],
  ) {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: _,
      remaining_blocking: _,
    } =>
      true
    _ => false
  }
}

test fn witness_p0_omitted_guarantee_blocks() -> Bool {
  match landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [p0_support(claim: p0_builds_claim())],
  ) {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: LandingMissingEvidence { claim },
      remaining_blocking: _,
    } =>
      claim.id == p0_behavior_claim().id
        && claim.target == p0_behavior_claim().target
        && claim.bound == p0_behavior_claim().bound
    _ => false
  }
}

test fn witness_p0_duplicate_requirement_blocks() -> Bool {
  let duplicate = p0_proposal_with(
    submitted_at: "2026-07-29T08:00:00Z",
    guarantees: gunbc.source_integration_landing_spine.LandingRequiredClaims {
      first: p0_builds_claim(),
      remaining: [p0_builds_claim()],
    },
  )
  match landing_evidence_readiness(
    proposal: duplicate,
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [p0_support(claim: p0_builds_claim())],
  ) {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: LandingDuplicateRequirement { claim },
      remaining_blocking: _,
    } =>
      claim == p0_builds_claim()
    _ => false
  }
}

test fn witness_p0_forged_readiness_without_evidence_admission_blocks() -> Bool {
  let forged = p0_link(
    claim: p0_builds_claim(),
    direction: EvidenceSupports,
    authority: "caller-authored-untrusted-authority",
  )
  let refused_only = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      forged,
      p0_support(claim: p0_behavior_claim()),
    ],
  )
  let mixed = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_support(claim: p0_builds_claim()),
      p0_link(
        claim: p0_builds_claim(),
        direction: EvidenceChallenges,
        authority: "caller-authored-untrusted-authority",
      ),
      p0_support(claim: p0_behavior_claim()),
    ],
  )
  match refused_only {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: LandingEvidenceRefused { claim, refusals },
      remaining_blocking: _,
    } =>
      claim == p0_builds_claim()
        && any(refusals, refusal => refusal == EvidenceAuthorityRefused)
        && match mixed {
          LandingEvidenceBlocking {
            proposal: _,
            policy: _,
            readiness: _,
            first_blocking: LandingEvidenceRefused {
              claim: mixed_claim,
              refusals: mixed_refusals,
            },
            remaining_blocking: _,
          } =>
            mixed_claim == p0_builds_claim()
              && any(
                mixed_refusals,
                refusal => refusal == EvidenceAuthorityRefused,
              )
          _ => false
        }
    _ => false
  }
}

test fn witness_p0_challenge_neither_and_both_remain_distinct() -> Bool {
  let challenged = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_challenge(claim: p0_builds_claim()),
      p0_support(claim: p0_behavior_claim()),
    ],
  )
  let neither = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [],
  )
  let both = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_support(claim: p0_builds_claim()),
      p0_challenge(claim: p0_builds_claim()),
      p0_support(claim: p0_behavior_claim()),
    ],
  )
  match challenged {
    LandingEvidenceBlocking {
      proposal: _,
      policy: _,
      readiness: _,
      first_blocking: LandingClaimChallenged { claim: _, challenging: _ },
      remaining_blocking: _,
    } =>
      match neither {
        LandingEvidenceBlocking {
          proposal: _,
          policy: _,
          readiness: _,
          first_blocking: LandingMissingEvidence { claim: _ },
          remaining_blocking: _,
        } =>
          match both {
            LandingEvidenceBlocking {
              proposal: _,
              policy: _,
              readiness: _,
              first_blocking: LandingEvidenceConflicted {
                claim: _,
                supporting: _,
                challenging: _,
              },
              remaining_blocking: _,
            } =>
              true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn witness_p0_block_disposition_is_not_boolean_laundered() -> Bool {
  let challenged = landing_evidence_readiness(
    proposal: p0_proposal(),
    policy: "p0-exact-guarantee-policy",
    admission: p0_admission_policy(),
    links: [
      p0_challenge(claim: p0_builds_claim()),
      p0_support(claim: p0_behavior_claim()),
    ],
  )
  let semantic = landing_blocked_evidence_result(
    readiness: challenged,
    partial_results: [],
    continuation: p0_continuation(
      kind: LandingContinueInvestigation,
      status: "gathering missing observations",
    ),
    conflict_continuation: p0_continuation(
      kind: LandingResolveEvidenceConflict,
      status: "resolving conflicting observations",
    ),
    terminal_refusal: p0_refusal(
      kind: LandingEvidenceAdmissionDenied,
      reason: "An independent check contradicts a required guarantee.",
    ),
  )
  match semantic {
    LandingUnclosed {
      proposal: _,
      cause: LandingEvidenceNotReady { first: _, remaining: _ },
      partial_results: _,
      disposition: LandingUnclosedTerminal { refusal },
    } =>
      refusal.kind == LandingEvidenceAdmissionDenied
        && match landing_user_boundary(
          receipt: gunbc.source_integration_landing_spine.LandingSemanticSpine { result: semantic },
        ) {
          LandingTerminal {
            outcome: NativeScmTerminalCouldNotLand { refusal: presented },
          } =>
            presented.plain_reason == "An independent check contradicts a required guarantee."
          _ => false
        }
    _ => false
  }
}

test fn witness_p0_closed_zero_is_closure_qualified() -> Bool {
  let receipt = p0_closed_receipt(
    candidates: gunbc.source_integration_landing_spine.LandingNoResultClasses {
      incompatible_core: "the two required guarantees cannot coexist",
      counterexample: "the public call changes behavior",
    },
  )
  match landing_closed_result_space(
    attempt: gunbc.source_integration_landing_spine.LandingClosureComplete { receipt: receipt },
    zero_refusal: p0_refusal(
      kind: LandingSemanticRequirementsIncompatible,
      reason: "The requested guarantees cannot all hold.",
    ),
    continuation: p0_continuation(
      kind: LandingContinueInvestigation,
      status: "checking the result space",
    ),
  ) {
    LandingClosedZero {
      closed_space,
      incompatible_core: _,
      counterexample: _,
      disposition: _,
    } =>
      closed_space.subject.ready_evidence.policy == "p0-exact-guarantee-policy"
        && closed_space.closure.multiplicity.receipt == content_hash_of_value(
          value: "multiplicity-receipt",
        )
    _ => false
  }
}

test fn witness_p0_closed_many_owns_material_alternatives() -> Bool {
  let first = p0_result(
    handle: "first-result",
    preview: "The new call uses the renamed function.",
  )
  let second = p0_result(
    handle: "second-result",
    preview: "The original name remains as a separate function.",
  )
  let options = gunbc.source_integration_landing_spine.LandingNormativeOptions {
    first_option: gunbc.source_integration_landing_spine.LandingNormativeOption {
      label: "use this result",
      preview: first.preview,
      resume_hint: "same-non-authoritative-hint",
      alternative: gunbc.source_integration_landing_spine.LandingSelectResult { result: first },
    },
    second_option: gunbc.source_integration_landing_spine.LandingNormativeOption {
      label: "use this result",
      preview: second.preview,
      resume_hint: "same-non-authoritative-hint",
      alternative: gunbc.source_integration_landing_spine.LandingSelectResult { result: second },
    },
    additional_options: [],
  }
  match landing_closed_result_space(
    attempt: gunbc.source_integration_landing_spine.LandingClosureComplete {
      receipt: p0_closed_receipt(
        candidates: gunbc.source_integration_landing_spine.LandingManyResultClasses {
          question: "Which result should be used?",
          options: options,
        },
      ),
    },
    zero_refusal: p0_refusal(
      kind: LandingSemanticRequirementsIncompatible,
      reason: "No result can satisfy the request.",
    ),
    continuation: p0_continuation(
      kind: LandingContinueInvestigation,
      status: "checking the result space",
    ),
  ) {
    LandingClosedMany { receipt } =>
      p0_primary_message_is_plain(message: receipt.question.question)
        && match landing_resolve_question(
        prior: receipt,
        choice: NativeScmFirstContinuationOption,
      ) {
        LandingChoiceAdvanced { continuation } =>
          continuation.selected.identity.choice == NativeScmFirstContinuationOption
            && match continuation.processing {
              LandingSelectedResultProcessing { result } =>
                result.result == "first-result"
              _ => false
            }
        LandingChoiceNotOffered { prior: _, choice: _ } => false
      }
        && match landing_resolve_question(
        prior: receipt,
        choice: NativeScmSecondContinuationOption,
      ) {
        LandingChoiceAdvanced { continuation } =>
          continuation.selected.identity.choice == NativeScmSecondContinuationOption
            && continuation.selected.option.resume_token == "same-non-authoritative-hint"
            && continuation.prior.closed_space == receipt.closed_space
            && match continuation.processing {
              LandingSelectedResultProcessing { result } =>
                result.result == "second-result"
              _ => false
            }
        LandingChoiceNotOffered { prior: _, choice: _ } => false
      }
        && match receipt.closed_space.subject.candidates {
          LandingManyResultClasses { question: _, options: stored } =>
            stored.first_option.alternative != stored.second_option.alternative
          _ => false
        }
        && match landing_resolve_question(
          prior: receipt,
          choice: gunbc.native_scm_interaction_contract.NativeScmAdditionalContinuationOption { index: 3 },
        ) {
          LandingChoiceNotOffered { prior: _, choice } =>
            choice == gunbc.native_scm_interaction_contract.NativeScmAdditionalContinuationOption { index: 3 }
          LandingChoiceAdvanced { continuation: _ } => false
        }
    _ => false
  }
}

fn p0_incomplete_closure_stays_machine_owned(
  missing: gunbc.source_integration_landing_spine.LandingClosureCertificateKind,
) -> Bool {
  let subject = gunbc.source_integration_landing_spine.LandingClosureSubject {
    ready_evidence: p0_ready_evidence(),
    admission_contract: "p0-admission-contract",
    read_back_authority: gunbc.source_integration_landing_spine.LandingIndependentReadBackAuthorityReceipt {
      observer: "independent-read-back",
      admission_contract: "p0-admission-contract",
      established_by: "fixture-admission-authority",
      receipt: content_hash_of_value(value: "read-back-authority-receipt"),
    },
    equivalence: "p0-declared-equivalence",
    candidates: gunbc.source_integration_landing_spine.LandingOneResultClass {
      result: p0_result(
        handle: "unique-result-42",
        preview: "Worker was renamed and its callers were updated.",
      ),
    },
  }
  let semantic = landing_closed_result_space(
    attempt: gunbc.source_integration_landing_spine.LandingClosureIncomplete {
      subject: subject,
      missing: missing,
      cause: "one required closure receipt is absent",
    },
    zero_refusal: p0_refusal(
      kind: LandingSemanticRequirementsIncompatible,
      reason: "No result can satisfy the request.",
    ),
    continuation: p0_continuation(
      kind: LandingContinueInvestigation,
      status: "checking the result space",
    ),
  )
  match semantic {
    LandingUnclosed {
      proposal: _,
      cause: LandingClosureCertificateMissing {
        certificate,
        cause: _,
      },
      partial_results: _,
      disposition: LandingInvestigationContinues { continuation: _ },
    } =>
      certificate == missing
        && match landing_user_boundary(
        receipt: gunbc.source_integration_landing_spine.LandingSemanticSpine { result: semantic },
      ) {
        LandingMachineOwned { status, continuation: _ } =>
          status == "checking the result space"
        LandingTerminal { outcome: _ } => false
      }
    _ => false
  }
}

test fn witness_p0_incomplete_closure_stays_machine_owned() -> Bool {
  all([
    LandingCaptureCompletenessCertificate,
    LandingAffectedScopeCertificate,
    LandingRuleClosureCertificate,
    LandingCandidateGenerationCertificate,
    LandingAdmissibilityCertificate,
    LandingEquivalenceQuotientCertificate,
    LandingMultiplicityCertificate,
  ], missing => p0_incomplete_closure_stays_machine_owned(missing: missing))
}

test fn witness_p0_admission_and_transition_flow_forward() -> Bool {
  let admitted = p0_admitted()
  let transition = p0_transition(
    admitted: admitted,
    identity: "transition-42",
    result: "state-42",
  )
  let carried = transition.admitted.admission.semantic.closed_space.subject.ready_evidence.proposal
  transition.admitted.admission.semantic == p0_closed_one()
    && carried == p0_proposal()
}

test fn witness_p0_cross_paired_read_back_refuses() -> Bool {
  let transition = p0_transition(
    admitted: p0_admitted(),
    identity: "transition-42",
    result: "state-42",
  )
  match landing_independent_read_back(
    observation: gunbc.source_integration_landing_spine.LandingReadBackObservation {
      transition: transition,
      observed_state: "state-from-another-transition",
      authority: "independent-read-back",
    },
  ) {
    LandingReadBackMismatched { observation } =>
      observation.transition.identity == "transition-42"
    LandingReadBackMatched { receipt: _ } => false
    LandingReadBackAuthorityRefused { observation: _ } => false
  }
    && match landing_independent_read_back(
      observation: gunbc.source_integration_landing_spine.LandingReadBackObservation {
        transition: transition,
        observed_state: "state-42",
        authority: "caller-invented-different-reader",
      },
    ) {
      LandingReadBackAuthorityRefused { observation } =>
        observation.authority != observation.transition.admitted.admission.semantic.closed_space.subject.read_back_authority.observer
      LandingReadBackMatched { receipt: _ } => false
      LandingReadBackMismatched { observation: _ } => false
    }
}

test fn witness_p0_cross_paired_projection_refuses() -> Bool {
  let transition = p0_transition(
    admitted: p0_admitted(),
    identity: "transition-42",
    result: "state-42",
  )
  match git_fixture_binding() {
    GitCompatibilityBindingRefused { cause: _ } => false
    GitCompatibilityBound { receipt } => {
      let projection = compatibility_projection_from_handler(
        handler: git_compatibility_projection_handler(),
        receipt: receipt,
      )
      match landing_projection_of_transition(
        transition: transition,
        binding: gunbc.source_integration_landing_spine.LandingCompatibilityTargetBinding {
          semantic_target: "another-semantic-target",
          native_target: projection.target,
          receipt: content_hash_of_value(value: "semantic-native-target-binding"),
        },
        projection: projection,
      ) {
        LandingProjectionBindingRefused { cause: _ } => true
        LandingProjectionBound { receipt: _ } => false
      }
    }
  }
}

test fn witness_p0_projection_from_another_transition_refuses_commit() -> Bool {
  let admitted = p0_admitted()
  let first = p0_transition(
    admitted: admitted,
    identity: "transition-first",
    result: "state-first",
  )
  let second = p0_transition(
    admitted: admitted,
    identity: "transition-second",
    result: "state-second",
  )
  let observation = gunbc.source_integration_landing_spine.LandingReadBackObservation {
    transition: first,
    observed_state: "state-first",
    authority: "independent-read-back",
  }
  match git_fixture_binding() {
    GitCompatibilityBindingRefused { cause: _ } => false
    GitCompatibilityBound { receipt } => {
      let projection = compatibility_projection_from_handler(
        handler: git_compatibility_projection_handler(),
        receipt: receipt,
      )
      match landing_projection_of_transition(
        transition: second,
        binding: gunbc.source_integration_landing_spine.LandingCompatibilityTargetBinding {
          semantic_target: "accepted-main",
          native_target: projection.target,
          receipt: content_hash_of_value(value: "semantic-native-target-binding"),
        },
        projection: projection,
      ) {
        LandingProjectionBindingRefused { cause: _ } => false
        LandingProjectionBound { receipt: bound } =>
          match landing_user_boundary(
            receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
              transition: gunbc.source_integration_landing_spine.LandingCommitObserved {
                observation: observation,
                projections: [gunbc.source_integration_landing_spine.LandingProjected { receipt: bound }],
                continuation: p0_continuation(
                  kind: LandingRetryCurrentTarget,
                  status: "rechecking transition relations",
                ),
              },
            },
          ) {
            LandingMachineOwned { status: _, continuation: _ } => true
            LandingTerminal { outcome: _ } => false
          }
      }
    }
  }
}

