data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn p0_proposal_at(
  submitted_at: Timestamp,
) -> LandingProposalContract {
  LandingProposalContract {
    occurrence: "proposal-50-agent-fixture",
    attempt: "proposal-50-agent-fixture-attempt-1",
    target: "accepted-main",
    authored_parent: "accepted-state-41",
    transformation: "rename-worker-and-update-callers",
    reads_relies: ["declaration-worker", "caller-build"],
    modifies_frame: ["source-worker", "source-callers"],
    ensures_guarantees: ["builds", "preserves-public-behavior"],
    dependencies: [],
    atomicity: LandingWholeProposalAtomic,
    submit_authority: "fixture-author",
    submitted_at: submitted_at,
  }
}

fn p0_ready_evidence() -> LandingEvidenceProfile {
  LandingEvidenceProfile {
    first_required: ClaimReadinessSatisfied { claim: "builds" },
    remaining_required: [
      ClaimReadinessSatisfied {
        claim: "preserves-public-behavior",
      },
    ],
  }
}

fn p0_blocking_evidence() -> LandingEvidenceProfile {
  LandingEvidenceProfile {
    first_required: ClaimReadinessSatisfied { claim: "builds" },
    remaining_required: [
      ClaimReadinessBlocking {
        claim: "preserves-public-behavior",
      },
    ],
  }
}

fn p0_closure_receipt(
  name: NonEmptyStr,
) -> LandingClosureCertificate {
  LandingClosureCertificate { receipt: name as ContentHash }
}

fn p0_complete_closure() -> LandingClosureCertificates {
  LandingClosureCertificates {
    capture_completeness: p0_closure_receipt(
      name: "capture-completeness-receipt",
    ),
    affected_scope: p0_closure_receipt(
      name: "affected-scope-receipt",
    ),
    rule_closure: p0_closure_receipt(
      name: "rule-closure-receipt",
    ),
    candidate_generation: p0_closure_receipt(
      name: "candidate-generation-receipt",
    ),
    admissibility: p0_closure_receipt(
      name: "admissibility-receipt",
    ),
    equivalence_quotient: p0_closure_receipt(
      name: "equivalence-quotient-receipt",
    ),
    multiplicity: p0_closure_receipt(
      name: "multiplicity-receipt",
    ),
    commit_validity: p0_closure_receipt(
      name: "commit-validity-receipt",
    ),
  }
}

fn p0_machine_continuation(
  status: NonEmptyStr,
) -> LandingMachineContinuation {
  LandingMachineContinuation {
    handle: "p0-machine-continuation",
    kind: LandingContinueInvestigation,
    status: status,
  }
}

fn p0_unique_result() -> LandingUniqueResult {
  LandingUniqueResult {
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    closure: p0_complete_closure(),
    ready_obligations: LandingReadyEvidenceProfile {
      first_required: "builds",
      remaining_required: ["preserves-public-behavior"],
    },
  }
}

fn p0_closed_one_receipt() -> LandingClosedOneReceipt {
  LandingClosedOneReceipt {
    proposal: p0_proposal_at(
      submitted_at: "2026-07-29T08:00:00Z",
    ),
    unique: p0_unique_result(),
  }
}

fn p0_admission_advance() -> LandingAdmissionAdvance {
  landing_admitted_result(
    admission: LandingAdmitted {
      semantic: p0_closed_one_receipt(),
      receipt: "admission-receipt-42",
    },
  )
}

fn p0_refusal(
  kind: LandingRefusalKind,
  reason: NonEmptyStr,
) -> LandingRefusal {
  LandingRefusal {
    kind: kind,
    locus: "proposal-50-agent-fixture",
    occurrences: 1,
    cause: reason,
    plain_reason: reason,
    responsible_party: "workspace owner",
    next_action: "update the requested outcome and submit again",
    receipt: "p0-refusal-receipt",
  }
}

fn p0_question() -> LandingNormativeQuestion {
  let proposal = p0_proposal_at(
    submitted_at: "2026-07-29T08:00:00Z",
  )
  LandingNormativeQuestion {
    proposal: proposal,
    question: "Should the new call use the renamed function or keep a separate function?",
    options: NativeScmContinuationOptions {
      first_option: NativeScmContinuationOption {
        label: "use the renamed function",
        result_preview: "The new call uses the renamed function.",
        resume_token: "resume-use-renamed-function",
      },
      second_option: NativeScmContinuationOption {
        label: "keep a separate function",
        result_preview: "The original name remains as a separate function.",
        resume_token: "resume-keep-separate-function",
      },
      additional_options: [],
    },
  }
}

fn p0_primary_messages(
  primary: NativeScmPrimaryOutcome,
) -> List<String> {
  match primary {
    Landed { result_preview } => [result_preview]
    ChoiceRequired { question, continuation } =>
      append(
        [question],
        items: native_scm_continuation_options(
          continuation: continuation,
        ) |> flat_map(option => [
          option.label as String,
          option.result_preview as String,
        ]),
      )
    InProgress { progress_preview } => [progress_preview]
    CouldNotLand { refusal } => [
      refusal.plain_reason,
      refusal.responsible_party,
      refusal.next_action,
    ]
  }
}

fn p0_message_is_plain(
  message: String,
) -> Bool {
  !string_contains(s: message, pattern: "candidate")
    && !string_contains(s: message, pattern: "closedness")
    && !string_contains(s: message, pattern: "evidence grade")
    && !string_contains(s: message, pattern: "reconciliation")
    && !string_contains(s: message, pattern: "constraint")
    && !string_contains(s: message, pattern: "unknown")
    && !string_contains(s: message, pattern: "contradictory")
    && !string_contains(s: message, pattern: "merge")
    && !string_contains(s: message, pattern: "rebase")
    && !string_contains(s: message, pattern: "cherry-pick")
    && !string_contains(s: message, pattern: "reset")
    && !string_contains(s: message, pattern: "conflict marker")
    && !string_contains(s: message, pattern: "force-push")
}

test fn witness_p0_unique_admitted_commit_lands_with_git_projection() -> Bool {
  let proposal = p0_proposal_at(
    submitted_at: "2026-07-29T08:00:00Z",
  )
  match landing_unique_candidate(
    proposal: proposal,
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    evidence: p0_ready_evidence(),
    closure: LandingClosureComplete {
      certificates: p0_complete_closure(),
    },
    continuation: p0_machine_continuation(
      status: "checking the result before it lands",
    ),
  ) {
    LandingClosedOne { receipt: semantic } =>
      match git_fixture_binding() {
        GitCompatibilityBindingRefused { cause: _ } => false
        GitCompatibilityBound { receipt } => {
          let projection = compatibility_projection_from_handler(
            handler: git_compatibility_projection_handler(),
            receipt: receipt,
          )
          match landing_admitted_result(
            admission: LandingAdmitted {
              semantic: semantic,
              receipt: "admission-receipt-42",
            },
          ) {
            LandingAdmissionAdvanced { admitted } => {
              let boundary = landing_user_boundary(
                receipt: LandingTransitionSpine {
                  transition: LandingCommittedAndReadBack {
                    admitted: admitted,
                    transition_receipt: "committed-transition-42",
                    independent_read_back: "independent-read-back-42",
                    projections: [
                      LandingProjected { receipt: projection },
                    ],
                  },
                },
              )
              projection.realization == "git-r0"
                && projection.target == "refs/heads/main"
                && match boundary {
                  LandingUserOutcome {
                    outcome: Landed { result_preview },
                  } =>
                    result_preview == "Worker was renamed and its callers were updated."
                  _ => false
                }
            }
            LandingAdmissionNotAdvanced { decision: _ } => false
          }
        }
      }
    _ => false
  }
}

test fn witness_p0_missing_closure_stays_machine_owned() -> Bool {
  let semantic = landing_unique_candidate(
    proposal: p0_proposal_at(
      submitted_at: "2026-07-29T08:00:00Z",
    ),
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    evidence: p0_ready_evidence(),
    closure: LandingClosureIncomplete {
      missing: LandingCommitValidityCertificate,
      cause: "the write validity check is still running",
    },
    continuation: p0_machine_continuation(
      status: "checking the result before it lands",
    ),
  )
  match semantic {
    LandingUnclosed {
      proposal: _,
      cause: LandingClosureCertificateMissing {
        certificate: LandingCommitValidityCertificate,
        cause: _,
      },
      partial_results: _,
      disposition: LandingInvestigationContinues {
        continuation: _,
      },
    } =>
      match landing_user_boundary(
        receipt: LandingSemanticSpine {
          result: semantic,
        },
      ) {
        LandingMachineOwned { status, continuation: _ } =>
          status == "checking the result before it lands"
        LandingUserOutcome { outcome: _ } => false
      }
    _ => false
  }
}

test fn witness_p0_blocking_claim_stays_machine_owned() -> Bool {
  let semantic = landing_unique_candidate(
    proposal: p0_proposal_at(
      submitted_at: "2026-07-29T08:00:00Z",
    ),
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    evidence: p0_blocking_evidence(),
    closure: LandingClosureComplete {
      certificates: p0_complete_closure(),
    },
    continuation: p0_machine_continuation(
      status: "checking the remaining requirement",
    ),
  )
  match semantic {
    LandingUnclosed {
      proposal: _,
      cause: LandingRequiredClaimBlocking,
      partial_results: _,
      disposition: LandingInvestigationContinues {
        continuation: _,
      },
    } =>
      match landing_user_boundary(
        receipt: LandingSemanticSpine {
          result: semantic,
        },
      ) {
        LandingMachineOwned { status: _, continuation: _ } => true
        LandingUserOutcome { outcome: _ } => false
      }
    _ => false
  }
}

test fn witness_p0_question_has_two_resumable_normative_answers() -> Bool {
  let question = p0_question()
  let expected_identity = landing_native_identity(
    proposal: question.proposal,
  )
  let boundary = landing_user_boundary(
    receipt: LandingSemanticSpine {
      result: LandingClosedMany {
        question: question,
      },
    },
  )
  let continuation = landing_question_continuation(question: question)
  count(native_scm_continuation_options(
    continuation: continuation,
  )) == 2
    && match landing_resolve_question(
      question: question,
      choice: NativeScmFirstContinuationOption,
    ) {
      LandingChoiceResumed { proposal: _, resume_token } =>
        resume_token == "resume-use-renamed-function"
      LandingChoiceNotOffered { proposal: _, choice: _ } => false
    }
    && match landing_resolve_question(
      question: question,
      choice: NativeScmSecondContinuationOption,
    ) {
      LandingChoiceResumed { proposal: _, resume_token } =>
        resume_token == "resume-keep-separate-function"
      LandingChoiceNotOffered { proposal: _, choice: _ } => false
    }
    && match boundary {
      LandingUserOutcome {
        outcome: ChoiceRequired {
          question: prompt,
          continuation: presented,
        },
      } =>
        prompt == "Should the new call use the renamed function or keep a separate function?"
          && presented.proposal.attempt_key == expected_identity.attempt_key
      _ => false
    }
}

test fn witness_p0_equal_labels_keep_distinct_resume_tokens() -> Bool {
  let proposal = p0_proposal_at(
    submitted_at: "2026-07-29T08:00:00Z",
  )
  let expected_identity = landing_native_identity(proposal: proposal)
  let question = LandingNormativeQuestion {
    proposal: proposal,
    question: "Which same-named result did you intend?",
    options: NativeScmContinuationOptions {
      first_option: NativeScmContinuationOption {
        label: "use this result",
        result_preview: "first result",
        resume_token: "resume-first-result",
      },
      second_option: NativeScmContinuationOption {
        label: "use this result",
        result_preview: "second result",
        resume_token: "resume-second-result",
      },
      additional_options: [],
    },
  }
  match landing_resolve_question(
    question: question,
    choice: NativeScmSecondContinuationOption,
  ) {
    LandingChoiceResumed { proposal: identity, resume_token } =>
      identity.attempt_key == expected_identity.attempt_key
        && resume_token == "resume-second-result"
    LandingChoiceNotOffered { proposal: _, choice: _ } => false
  }
}

test fn witness_p0_unauthorized_unique_is_plain_refusal() -> Bool {
  let refusal = p0_refusal(
    kind: LandingAuthorizationDenied,
    reason: "You are not allowed to change this target.",
  )
  let boundary = landing_user_boundary(
    receipt: LandingAdmissionSpine {
      admission: LandingUnauthorized {
        semantic: p0_closed_one_receipt(),
        refusal: refusal,
      },
    },
  )
  refusal.kind == LandingAuthorizationDenied
    && match boundary {
      LandingUserOutcome {
        outcome: CouldNotLand { refusal: user_refusal },
      } =>
        user_refusal.plain_reason == "You are not allowed to change this target."
      _ => false
  }
}

test fn witness_p0_refused_admission_cannot_advance() -> Bool {
  let expected = p0_closed_one_receipt()
  match landing_admitted_result(
    admission: LandingUnauthorized {
      semantic: expected,
      refusal: p0_refusal(
        kind: LandingAuthorizationDenied,
        reason: "You are not allowed to change this target.",
      ),
    },
  ) {
    LandingAdmissionNotAdvanced {
      decision: LandingUnauthorized {
        semantic,
        refusal: _,
      },
    } =>
      semantic.proposal.occurrence == expected.proposal.occurrence
    LandingAdmissionNotAdvanced { decision: _ } => false
    LandingAdmissionAdvanced { admitted: _ } => false
  }
}

test fn witness_p0_transition_uses_its_admitted_semantic_receipt() -> Bool {
  let admitted_semantic = LandingClosedOneReceipt {
    proposal: p0_proposal_at(
      submitted_at: "2026-07-29T09:00:00Z",
    ),
    unique: LandingUniqueResult {
      result: "second-unique-result",
      preview: "The second admitted proposal landed.",
      closure: p0_complete_closure(),
      ready_obligations: LandingReadyEvidenceProfile {
        first_required: "builds",
        remaining_required: ["preserves-public-behavior"],
      },
    },
  }
  match landing_admitted_result(
    admission: LandingAdmitted {
      semantic: admitted_semantic,
      receipt: "second-admission-receipt",
    },
  ) {
    LandingAdmissionAdvanced { admitted } =>
      match landing_user_boundary(
        receipt: LandingTransitionSpine {
          transition: LandingCommittedAndReadBack {
            admitted: admitted,
            transition_receipt: "second-transition-receipt",
            independent_read_back: "second-read-back",
            projections: [],
          },
        },
      ) {
        LandingUserOutcome {
          outcome: Landed { result_preview },
        } =>
          result_preview == "The second admitted proposal landed."
        _ => false
      }
    LandingAdmissionNotAdvanced { decision: _ } => false
  }
}

test fn witness_p0_self_amendment_is_plain_refusal() -> Bool {
  let refusal = p0_refusal(
    kind: LandingSelfAmendmentDenied,
    reason: "This change cannot approve itself.",
  )
  match landing_user_boundary(
    receipt: LandingAdmissionSpine {
      admission: LandingSelfAmendmentRefused {
        semantic: p0_closed_one_receipt(),
        refusal: refusal,
      },
    },
  ) {
    LandingUserOutcome {
      outcome: CouldNotLand { refusal: user_refusal },
    } =>
      refusal.kind == LandingSelfAmendmentDenied
        && user_refusal.plain_reason == "This change cannot approve itself."
    _ => false
  }
}

test fn witness_p0_exhausted_bound_is_typed_plain_refusal() -> Bool {
  let refusal = p0_refusal(
    kind: LandingBoundExhausted,
    reason: "This change is too large for the current operation.",
  )
  let semantic = LandingUnclosed {
    proposal: p0_proposal_at(
      submitted_at: "2026-07-29T08:00:00Z",
    ),
    cause: LandingSearchBoundExhausted {
      cause: "the bounded search was exhausted",
    },
    partial_results: [],
    disposition: LandingUnclosedTerminal { refusal: refusal },
  }
  match landing_user_boundary(
    receipt: LandingSemanticSpine {
      result: semantic,
    },
  ) {
    LandingUserOutcome {
      outcome: CouldNotLand { refusal: user_refusal },
    } =>
      refusal.kind == LandingBoundExhausted
        && user_refusal.plain_reason == "This change is too large for the current operation."
    _ => false
  }
}

test fn witness_p0_permanent_effect_failure_is_typed_plain_refusal() -> Bool {
  let refusal = p0_refusal(
    kind: LandingPermanentEffectFailure,
    reason: "The target rejected this update.",
  )
  match p0_admission_advance() {
    LandingAdmissionAdvanced { admitted } =>
      match landing_user_boundary(
        receipt: LandingTransitionSpine {
          transition: LandingEffectFailed {
            admitted: admitted,
            refusal: refusal,
          },
        },
      ) {
        LandingUserOutcome {
          outcome: CouldNotLand { refusal: user_refusal },
        } =>
          refusal.kind == LandingPermanentEffectFailure
            && user_refusal.plain_reason == "The target rejected this update."
        _ => false
      }
    LandingAdmissionNotAdvanced { decision: _ } => false
  }
}

test fn witness_p0_stale_parent_retries_inside_machine() -> Bool {
  match p0_admission_advance() {
    LandingAdmissionAdvanced { admitted } =>
      match landing_user_boundary(
        receipt: LandingTransitionSpine {
          transition: LandingRetryStaleParent {
            admitted: admitted,
            continuation: LandingMachineContinuation {
              handle: "retry-current-target-42",
              kind: LandingRetryCurrentTarget,
              status: "updating the change against the current target",
            },
          },
        },
      ) {
        LandingMachineOwned { status, continuation } =>
          status == "updating the change against the current target"
            && continuation.kind == LandingRetryCurrentTarget
        LandingUserOutcome { outcome: _ } => false
      }
    LandingAdmissionNotAdvanced { decision: _ } => false
  }
}

test fn witness_p0_projection_failure_after_commit_stays_landed() -> Bool {
  match p0_admission_advance() {
    LandingAdmissionAdvanced { admitted } =>
      match landing_user_boundary(
        receipt: LandingTransitionSpine {
          transition: LandingCommittedAndReadBack {
            admitted: admitted,
            transition_receipt: "committed-transition-42",
            independent_read_back: "independent-read-back-42",
            projections: [
              LandingProjectionFailed {
                realization: "git-r0",
                target: "refs/heads/main",
                cause: "the compatibility view will be retried",
              },
            ],
          },
        },
      ) {
        LandingUserOutcome {
          outcome: Landed { result_preview },
        } =>
          result_preview == "Worker was renamed and its callers were updated."
        _ => false
      }
    LandingAdmissionNotAdvanced { decision: _ } => false
  }
}

test fn witness_p0_timestamps_are_inert_and_stress_is_explicit() -> Bool {
  let early = p0_proposal_at(
    submitted_at: "2026-07-29T08:00:00Z",
  )
  let late = p0_proposal_at(
    submitted_at: "2026-07-29T09:00:00Z",
  )
  let early_semantic = landing_unique_candidate(
    proposal: early,
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    evidence: p0_ready_evidence(),
    closure: LandingClosureComplete {
      certificates: p0_complete_closure(),
    },
    continuation: p0_machine_continuation(
      status: "checking the result before it lands",
    ),
  )
  let late_semantic = landing_unique_candidate(
    proposal: late,
    result: "unique-result-42",
    preview: "Worker was renamed and its callers were updated.",
    evidence: p0_ready_evidence(),
    closure: LandingClosureComplete {
      certificates: p0_complete_closure(),
    },
    continuation: p0_machine_continuation(
      status: "checking the result before it lands",
    ),
  )
  let early_boundary = landing_user_boundary(
    receipt: LandingSemanticSpine {
      result: early_semantic,
    },
  )
  let late_boundary = landing_user_boundary(
    receipt: LandingSemanticSpine {
      result: late_semantic,
    },
  )
  let stress: LandingStressProfile = gunbc_landing_stress_profile
  early_boundary == late_boundary
    && stress.agents_per_developer == 50
    && stress.overlapping_proposals == 10
    && minute_count(stress.validation_path) == 30
}

test fn witness_p0_primary_messages_are_plain_and_git_ritual_free() -> Bool {
  let landed = Landed {
    result_preview: "Worker was renamed and its callers were updated.",
  }
  let normative = p0_question()
  let question = ChoiceRequired {
    question: normative.question as String,
    continuation: landing_question_continuation(question: normative),
  }
  let refused = CouldNotLand {
    refusal: landing_native_refusal(
      refusal: p0_refusal(
        kind: LandingAuthorizationDenied,
        reason: "You are not allowed to change this target.",
      ),
    ),
  }
  let messages = append(
    p0_primary_messages(primary: landed),
    items: append(
      p0_primary_messages(primary: question),
      items: p0_primary_messages(primary: refused),
    ),
  )
  messages |> all(message => p0_message_is_plain(message: message))
}
