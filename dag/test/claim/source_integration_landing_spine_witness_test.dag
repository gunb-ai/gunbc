test fn witness_p0_projection_failure_after_commit_stays_landed() -> Bool {
  let transition = p0_transition(
    admitted: p0_admitted(),
    identity: "transition-42",
    result: "state-42",
  )
  let observation = gunbc.source_integration_landing_spine.LandingReadBackObservation {
    transition: transition,
    observed_state: "state-42",
    authority: "independent-read-back",
  }
  let failed = gunbc.source_integration_landing_spine.LandingProjectionFailed {
    transition: transition,
    realization: "git-r0",
    target: gunbc.source_integration_landing_spine.LandingCompatibilityTargetBinding {
      semantic_target: "accepted-main",
      native_target: "refs/heads/main",
      receipt: content_hash_of_value(value: "semantic-native-target-binding"),
    },
    cause: "the compatibility view will be retried",
  }
  match landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
      transition: gunbc.source_integration_landing_spine.LandingCommitObserved {
        observation: observation,
        projections: [failed],
        continuation: p0_continuation(
          kind: LandingRetryCurrentTarget,
          status: "repairing the compatibility projection",
        ),
      },
    },
  ) {
    LandingTerminal {
      outcome: NativeScmTerminalLanded { result_preview: _ },
    } =>
      true
    _ => false
  }
}

test fn witness_p0_refused_admission_cannot_advance() -> Bool {
  let semantic = p0_closed_one()
  match landing_admitted_result(
    admission: gunbc.source_integration_landing_spine.LandingUnauthorized {
      semantic: semantic,
      refusal: p0_refusal(
        kind: LandingAuthorizationDenied,
        reason: "You are not allowed to change this target.",
      ),
    },
  ) {
    LandingAdmissionNotAdvanced {
      decision: LandingUnauthorized {
        semantic: retained,
        refusal: _,
      },
    } =>
      retained == semantic
    _ => false
  }
}

test fn witness_p0_stale_parent_retries_inside_machine() -> Bool {
  match landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
      transition: gunbc.source_integration_landing_spine.LandingRetryStaleParent {
        admitted: p0_admitted(),
        continuation: p0_continuation(
          kind: LandingRetryCurrentTarget,
          status: "updating the change against the current target",
        ),
      },
    },
  ) {
    LandingMachineOwned { status, continuation } =>
      status == "updating the change against the current target"
        && continuation.kind == LandingRetryCurrentTarget
    LandingTerminal { outcome: _ } => false
  }
}

test fn witness_p0_terminal_surface_excludes_machine_progress() -> Bool {
  let machine = landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
      transition: gunbc.source_integration_landing_spine.LandingRetryStaleParent {
        admitted: p0_admitted(),
        continuation: p0_continuation(
          kind: LandingRetryCurrentTarget,
          status: "updating the change against the current target",
        ),
      },
    },
  )
  let refused = landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingAdmissionSpine {
      admission: gunbc.source_integration_landing_spine.LandingSelfAmendmentRefused {
        semantic: p0_closed_one(),
        refusal: p0_refusal(
          kind: LandingSelfAmendmentDenied,
          reason: "This change cannot approve itself.",
        ),
      },
    },
  )
  let unauthorized = landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingAdmissionSpine {
      admission: gunbc.source_integration_landing_spine.LandingUnauthorized {
        semantic: p0_closed_one(),
        refusal: p0_refusal(
          kind: LandingAuthorizationDenied,
          reason: "You are not allowed to change this target.",
        ),
      },
    },
  )
  let exhausted = landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingSemanticSpine {
      result: gunbc.source_integration_landing_spine.LandingUnclosed {
        proposal: p0_proposal(),
        cause: gunbc.source_integration_landing_spine.LandingSearchBoundExhausted {
          cause: "the declared search bound was exhausted",
        },
        partial_results: [],
        disposition: gunbc.source_integration_landing_spine.LandingUnclosedTerminal {
          refusal: p0_refusal(
            kind: LandingBoundExhausted,
            reason: "This change is outside the supported search limit.",
          ),
        },
      },
    },
  )
  let permanent = landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
      transition: gunbc.source_integration_landing_spine.LandingEffectFailed {
        admitted: p0_admitted(),
        refusal: p0_refusal(
          kind: LandingPermanentEffectFailure,
          reason: "The target permanently rejected this update.",
        ),
      },
    },
  )
  match machine {
    LandingMachineOwned { status: _, continuation: _ } =>
      match refused {
        LandingTerminal {
          outcome: NativeScmTerminalCouldNotLand { refusal },
        } =>
          refusal.plain_reason == "This change cannot approve itself."
            && match unauthorized {
              LandingTerminal {
                outcome: NativeScmTerminalCouldNotLand { refusal: denied },
              } =>
                denied.plain_reason == "You are not allowed to change this target."
                  && match exhausted {
                    LandingTerminal {
                      outcome: NativeScmTerminalCouldNotLand { refusal: bounded },
                    } =>
                      bounded.plain_reason == "This change is outside the supported search limit."
                        && match permanent {
                          LandingTerminal {
                            outcome: NativeScmTerminalCouldNotLand { refusal: effect },
                          } =>
                            effect.plain_reason == "The target permanently rejected this update."
                          _ => false
                        }
                    _ => false
                  }
              _ => false
            }
        _ => false
      }
    LandingTerminal { outcome: _ } => false
  }
}

fn p0_primary_message_is_plain(message: String) -> Bool {
  all([
    "candidate",
    "closedness",
    "evidence grade",
    "reconciliation",
    "constraint",
    "unknown",
    "contradictory",
    "merge",
    "rebase",
    "cherry-pick",
    "reset",
    "conflict marker",
    "force-push",
  ], forbidden => !string_contains(s: message, pattern: forbidden))
}

test fn witness_p0_audience_projection_is_separate_from_internal_cause() -> Bool {
  let refusal = gunbc.source_integration_landing_spine.LandingRefusal {
    kind: LandingPermanentEffectFailure,
    locus: "private-node-42",
    occurrences: 1,
    internal_cause: "locked node private-node-42 contradicted solver proof edge 7",
    plain_reason: "The target rejected this update.",
    responsible_party: "workspace owner",
    next_action: "review the target policy",
    receipt: content_hash_of_value(value: "private-refusal-receipt"),
  }
  match landing_user_boundary(
    receipt: gunbc.source_integration_landing_spine.LandingTransitionSpine {
      transition: gunbc.source_integration_landing_spine.LandingEffectFailed {
        admitted: p0_admitted(),
        refusal: refusal,
      },
    },
  ) {
    LandingTerminal {
      outcome: NativeScmTerminalCouldNotLand { refusal: presented },
    } =>
      presented.plain_reason == "The target rejected this update."
        && p0_primary_message_is_plain(message: presented.plain_reason)
        && !string_contains(
          s: presented.plain_reason,
          pattern: "private-node-42",
        )
    _ => false
  }
}

fn p0_timestamps_are_inert_and_stress_is_explicit() -> Bool {
  let early = p0_proposal_with(
    submitted_at: "2026-07-29T08:00:00Z",
    guarantees: gunbc.source_integration_landing_spine.LandingRequiredClaims {
      first: p0_builds_claim(),
      remaining: [p0_behavior_claim()],
    },
  )
  let late = p0_proposal_with(
    submitted_at: "2026-07-29T09:00:00Z",
    guarantees: gunbc.source_integration_landing_spine.LandingRequiredClaims {
      first: p0_builds_claim(),
      remaining: [p0_behavior_claim()],
    },
  )
  let stress: gunbc.source_integration_landing_spine.LandingStressProfile = gunbc_landing_stress_profile
  early.occurrence == late.occurrence
    && early.target == late.target
    && early.submitted_at != late.submitted_at
    && stress.agents_per_developer == 50
    && stress.overlapping_proposals == 10
    && minute_count(stress.validation_path) == 30
}

test fn witness_p0_roadmap_acceptance_contract_holds() -> Bool {
  witness_p0_full_claim_readiness_reaches_closed_one()
    && witness_p0_same_claim_id_different_target_and_bound_blocks()
    && witness_p0_unrelated_satisfied_claim_blocks()
    && witness_p0_omitted_guarantee_blocks()
    && witness_p0_duplicate_requirement_blocks()
    && witness_p0_forged_readiness_without_evidence_admission_blocks()
    && witness_p0_challenge_neither_and_both_remain_distinct()
    && witness_p0_block_disposition_is_not_boolean_laundered()
    && witness_p0_closed_zero_is_closure_qualified()
    && witness_p0_closed_many_owns_material_alternatives()
    && witness_p0_incomplete_closure_stays_machine_owned()
    && witness_p0_admission_and_transition_flow_forward()
    && witness_p0_cross_paired_read_back_refuses()
    && witness_p0_cross_paired_projection_refuses()
    && witness_p0_projection_from_another_transition_refuses_commit()
    && witness_p0_unique_admitted_commit_lands_with_bound_git_projection()
    && witness_p0_projection_failure_after_commit_stays_landed()
    && witness_p0_refused_admission_cannot_advance()
    && witness_p0_stale_parent_retries_inside_machine()
    && witness_p0_terminal_surface_excludes_machine_progress()
    && witness_p0_audience_projection_is_separate_from_internal_cause()
    && p0_timestamps_are_inert_and_stress_is_explicit()
}
