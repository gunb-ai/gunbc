module test.claim.memory_scale_factor_derivation


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn factor_is(s: std.measure.Scale, expected: std.nat.Nat) -> Bool {
  match memory_scale_factor_bytes(s: s) {
    Present { value: n } => n == expected
    Absent => false
  }
}

test fn memory_scale_factors_derive_correctly() -> Bool {
  test.claim.memory_scale_factor_derivation.factor_is(s: Kibi, expected: 1024)
    && test.claim.memory_scale_factor_derivation.factor_is(s: Mebi, expected: 1048576)
    && test.claim.memory_scale_factor_derivation.factor_is(s: Tebi, expected: 1099511627776)
}
