module test.claim.memory_scale_factor_derivation


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn factor_is(s: std.measure.Scale, expected: std.nat.Nat) -> Bool {
  match std.measure.memory_scale_factor_bytes(s: s) {
    Present { value: n } => n == expected
    Absent => false
  }
}

test fn memory_scale_factors_derive_correctly() -> Bool {
  factor_is(s: std.measure.Kibi, expected: 1024)
    && factor_is(s: std.measure.Mebi, expected: 1048576)
    && factor_is(s: std.measure.Tebi, expected: 1099511627776)
}
