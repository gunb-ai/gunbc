module test.claim.gha_expression_roundtrip

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn core_expr() -> Expression {
  LogicalOr {
    left: LogicalOr {
      left: extdeps.github.expressions.FunctionCall {
        function: HashFiles,
        args: [ StringLiteral { value: "Cargo.lock" }, StringLiteral { value: "Cargo.toml" } ],
      },
      right: ContextAccess { context: Github, path: ["event", "number"] },
    },
    right: ContextAccess { context: Runner, path: ["os"] },
  }
}

fn core_template() -> ExpressionTemplate {
  ExpressionTemplate {
    segments: [
      LiteralText { text: "cargo-ci-" },
      Interpolation { expression: ContextAccess { context: Runner, path: ["os"] } },
      LiteralText { text: "-" },
      Interpolation { expression: ContextAccess { context: Runner, path: ["arch"] } },
    ],
  }
}

test fn witness_roundtrip_expression() -> Bool {
  match ingest_expression(src: serialize_expression(expression: core_expr())) {
    Present { value: v } => v == core_expr()
    Absent => false
  }
}

test fn witness_roundtrip_template() -> Bool {
  match ingest_template(src: serialize_template(template: core_template())) {
    Present { value: v } => v == core_template()
    Absent => false
  }
}

// THIS IS A CANONICALIZATION ROW, NOT AN EXTERNAL-VALIDITY ROW, AND THE DISTINCTION MUST TRAVEL
// WITH IT.
//
// Forcing the dot arm does NOT produce syntax GitHub rejects. The cited production admits a
// hyphen after a valid start character, so `needs.a-b.result` is valid upstream; what the dot
// arm violates is THIS WRITER'S CANONICAL SPELLING, which is index notation for anything outside
// that narrow production. A reader who takes this row as evidence that GitHub refuses the dot
// form will believe the consumer rejects something it accepts -- which is why the row is named
// for the rendering rather than for validity.
//
// THREE PROPERTIES ARE IN PLAY AND ONLY ONE OF THEM IS THIS ROW: (1) a round trip proves
// agreement between THIS writer and THIS reader; (2) a canonical-rendering check proves the
// writer emits the chosen spelling; (3) external-grammar acceptance proves the consumer takes
// it. (1) establishes neither of the others. This row is (2). Nothing in this module is (3),
// and nothing here claims to be.
//
// THE RED IS AUTHORABLE AND SHARP: make `render_path_segment_with` always take the dot arm and
// this row goes red on the rendering, while every other row in this file stays green -- their
// segments (`os`, `arch`, `event`, `number`) all take the dot form, so nothing else here can see
// the distinction. Measured: 1 red of 11.
fn hyphenated_expr() -> Expression {
  ContextAccess { context: Needs, path: ["required-witnesses-build", "result"] }
}

test fn witness_hyphenated_segment_renders_as_index_not_dot() -> Bool {
  serialize_expression(expression: hyphenated_expr()) == "needs['required-witnesses-build'].result"
}

test fn witness_roundtrip_hyphenated_segment() -> Bool {
  match ingest_expression(src: serialize_expression(expression: hyphenated_expr())) {
    Present { value: v } => v == hyphenated_expr()
    Absent => false
  }
}

// A DOT-SAFE SEGMENT MUST STILL TAKE THE DOT ARM. Without this the index form could be applied
// unconditionally -- which would also round-trip, and would silently rewrite every existing
// expression in the tree.
test fn witness_dot_safe_segment_keeps_dot_form() -> Bool {
  serialize_expression(expression: ContextAccess { context: Runner, path: ["os"] }) == "runner.os"
}

fn override_spellings(path_sep: String, or_op: String) -> ExpressionSpellings {
  ExpressionSpellings {
    path_sep: path_sep,
    call_open: default_expression_spellings.call_open,
    call_close: default_expression_spellings.call_close,
    arg_sep: default_expression_spellings.arg_sep,
    string_quote: default_expression_spellings.string_quote,
    or_op: or_op,
    and_op: default_expression_spellings.and_op,
    eq_op: default_expression_spellings.eq_op,
    neq_op: default_expression_spellings.neq_op,
    not_op: default_expression_spellings.not_op,
    interp_open: default_expression_spellings.interp_open,
    interp_close: default_expression_spellings.interp_close,
    group_open: default_expression_spellings.group_open,
    group_close: default_expression_spellings.group_close,
    index_open: default_expression_spellings.index_open,
    index_close: default_expression_spellings.index_close,
    lt_op: default_expression_spellings.lt_op,
    le_op: default_expression_spellings.le_op,
    gt_op: default_expression_spellings.gt_op,
    ge_op: default_expression_spellings.ge_op,
    wildcard: default_expression_spellings.wildcard,
    true_literal: default_expression_spellings.true_literal,
    false_literal: default_expression_spellings.false_literal,
    null_literal: default_expression_spellings.null_literal,
  }
}

fn perturbed_path_sep() -> ExpressionSpellings {
  override_spellings(path_sep: "->", or_op: default_expression_spellings.or_op)
}

fn perturbed_or_op() -> ExpressionSpellings {
  override_spellings(path_sep: default_expression_spellings.path_sep, or_op: " OR ")
}

fn roundtrips_under(sp: ExpressionSpellings) -> Bool {
  match ingest_expression_with(src: serialize_expression_with(expression: core_expr(), sp: sp), sp: sp) {
    Present { value: v } => v == core_expr()
    Absent => false
  }
}

test fn witness_roundtrip_under_perturbed_rows() -> Bool {
  roundtrips_under(sp: perturbed_path_sep()) && roundtrips_under(sp: perturbed_or_op())
}

fn ingest_reads(sp: ExpressionSpellings) -> Bool {
  match ingest_expression(src: serialize_expression_with(expression: core_expr(), sp: sp)) {
    Present { value: v } => !(v == core_expr())
    Absent => true
  }
}

test fn witness_ingest_reads_rows() -> Bool {
  ingest_reads(sp: perturbed_path_sep()) && ingest_reads(sp: perturbed_or_op())
}

fn left_nested_or() -> Expression {
  LogicalOr {
    left: LogicalOr {
      left: ContextAccess { context: Runner, path: ["os"] },
      right: ContextAccess { context: Runner, path: ["arch"] },
    },
    right: ContextAccess { context: Runner, path: ["temp"] },
  }
}

fn right_nested_or() -> Expression {
  LogicalOr {
    left: ContextAccess { context: Runner, path: ["os"] },
    right: LogicalOr {
      left: ContextAccess { context: Runner, path: ["arch"] },
      right: ContextAccess { context: Runner, path: ["temp"] },
    },
  }
}

test fn witness_or_associativity_partition() -> Bool {
  match ingest_expression(src: serialize_expression(expression: left_nested_or())) {
    Present { value: left_v } =>
      match ingest_expression(src: serialize_expression(expression: right_nested_or())) {
        Present { value: right_v } => (left_v == left_nested_or()) && !(right_v == right_nested_or())
        Absent => false
      }
    Absent => false
  }
}

fn frontier_string_with_or() -> Expression {
  StringLiteral { value: "a || b" }
}

fn frontier_nested_multiarg_call() -> Expression {
  extdeps.github.expressions.FunctionCall {
    function: extdeps.github.expressions.Contains,
    args: [
      ContextAccess { context: Github, path: ["event"] },
      extdeps.github.expressions.FunctionCall {
        function: Format,
        args: [
          StringLiteral { value: "v" },
          ContextAccess { context: Runner, path: ["os"] },
          ContextAccess { context: Runner, path: ["arch"] },
        ],
      },
    ],
  }
}

// The two former frontier claims are positive controls now: the parser reads what the writer writes.
fn roundtrips(e: Expression) -> Bool {
  match ingest_expression(src: serialize_expression(expression: e)) {
    Present { value: v } => v == e
    Absent => false
  }
}

test fn witness_right_nested_or_roundtrips_by_value_when_parsed_left() -> Bool {
  // right-nested Or is rendered without parens and reads back left-associated: the declared asymmetry.
  match ingest_expression(src: serialize_expression(expression: right_nested_or())) {
    Present { value: v } => !(v == right_nested_or()) && (v == left_nested_or())
    Absent => false
  }
}

test fn witness_string_containing_or_roundtrips() -> Bool {
  roundtrips(e: frontier_string_with_or())
}

test fn witness_nested_multiarg_call_roundtrips() -> Bool {
  roundtrips(e: frontier_nested_multiarg_call())
}

test fn witness_quote_in_string_is_escaped_and_roundtrips() -> Bool {
  serialize_expression(expression: StringLiteral { value: "it's" }) == "'it''s'"
    && roundtrips(e: StringLiteral { value: "it's" })
}

fn ctx(c: ExpressionContext, path: List<String>) -> Expression {
  ContextAccess { context: c, path: path }
}

fn parsed(src: String) -> Expression? {
  ingest_expression(src: src)
}

fn parses_to(src: String, want: Expression) -> Bool {
  match parsed(src: src) {
    Present { value: v } => v == want
    Absent => false
  }
}

fn refuses(src: String) -> Bool {
  match parsed(src: src) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn witness_eq_and_not_parse_with_real_contexts() -> Bool {
  parses_to(
    src: "github.a == 'b' && !github.c",
    want: LogicalAnd { left: Equals { left: ctx(c: Github, path: ["a"]), right: StringLiteral { value: "b" } }, right: LogicalNot { operand: ctx(c: Github, path: ["c"]) } }
  )
}

test fn witness_bare_unknown_name_refuses() -> Bool {
  refuses(src: "a == 'b' && !c")
}

test fn witness_index_whitespace_and_mixed_forms_parse_to_one_path() -> Bool {
  parses_to(src: "steps[ 'x' ].outputs", want: ctx(c: Steps, path: ["x", "outputs"]))
    && parses_to(src: "steps.x['outputs']", want: ctx(c: Steps, path: ["x", "outputs"]))
    && parses_to(src: "steps . x . outputs", want: ctx(c: Steps, path: ["x", "outputs"]))
}

test fn witness_object_filter_parses_to_filtered_access() -> Bool {
  parses_to(src: "steps.*.outputs", want: FilteredContextAccess { context: Steps, path: [FilterAll, FilterKey { name: "outputs" }] })
    && roundtrips(e: FilteredContextAccess { context: Steps, path: [FilterAll, FilterKey { name: "outputs" }] })
    && !parses_to(src: "steps['*'].outputs", want: FilteredContextAccess { context: Steps, path: [FilterAll, FilterKey { name: "outputs" }] })
}

test fn witness_double_quoted_string_refuses() -> Bool {
  refuses(src: "github.a == \"b\"") && refuses(src: "\"b\"")
}

test fn witness_precedence_or_over_and() -> Bool {
  let a = ctx(c: Github, path: ["a"])
  let b = ctx(c: Github, path: ["b"])
  let c = ctx(c: Github, path: ["c"])
  parses_to(src: "github.a || github.b && github.c", want: LogicalOr { left: a, right: LogicalAnd { left: b, right: c } })
    && parses_to(src: "(github.a || github.b) && github.c", want: LogicalAnd { left: LogicalOr { left: a, right: b }, right: c })
    && roundtrips(e: LogicalAnd { left: LogicalOr { left: a, right: b }, right: c })
}

test fn witness_comparisons_and_literals_roundtrip() -> Bool {
  let a = ctx(c: Github, path: ["a"])
  roundtrips(e: LessThan { left: a, right: NumberLiteral { text: "10" } })
    && roundtrips(e: LessOrEqual { left: a, right: NumberLiteral { text: "-1.5e+3" } })
    && roundtrips(e: GreaterThan { left: a, right: NumberLiteral { text: "0xff" } })
    && roundtrips(e: GreaterOrEqual { left: a, right: NumberLiteral { text: "2" } })
    && roundtrips(e: Equals { left: a, right: BoolLiteral { value: true } })
    && roundtrips(e: NotEquals { left: a, right: NullLiteral })
    && roundtrips(e: LogicalNot { operand: Equals { left: a, right: BoolLiteral { value: false } } })
}

test fn witness_comparison_binds_tighter_than_and() -> Bool {
  let a = ctx(c: Github, path: ["a"])
  parses_to(
    src: "github.a < 3 && github.a >= 1",
    want: LogicalAnd { left: LessThan { left: a, right: NumberLiteral { text: "3" } }, right: GreaterOrEqual { left: a, right: NumberLiteral { text: "1" } } }
  )
}

test fn witness_malformed_input_is_absent_not_partial() -> Bool {
  refuses(src: "github.a ||")
    && refuses(src: "(github.a")
    && refuses(src: "github.a)")
    && refuses(src: "github.a b")
    && refuses(src: "'unterminated")
    && refuses(src: "steps[0].outputs")
    && refuses(src: "")
    && refuses(src: "1abc")
}

test fn witness_core_advertised_lossless() -> Bool {
  match ingest_expression(src: serialize_expression(expression: core_expr())) {
    Present { value: v } => {
      let m = source_medium_carried(carried: v, fidelity: Lossless)
      match m.fidelity {
        Lossless => m.carried == core_expr()
        Lossy => false
      }
    }
    Absent => false
  }
}

test fn witness_emit_non_regression() -> Bool {
  let e = core_expr()
  let t = core_template()
  (serialize_expression(expression: e) == serialize_expression_with(expression: e, sp: default_expression_spellings))
    && (serialize_template(template: t) == serialize_template_with(template: t, sp: default_expression_spellings))
    && (serialize_expression(expression: e) == "hashFiles('Cargo.lock', 'Cargo.toml') || github.event.number || runner.os")
    && (serialize_template(template: t) == "cargo-ci-${{ runner.os }}-${{ runner.arch }}")
}

fn not_equals_empty_input_expr() -> Expression {
  NotEquals {
    left: ContextAccess { context: Github, path: ["event", "inputs", "expected_healed_sha"] },
    right: StringLiteral { value: "" }
  }
}

test fn witness_not_equals_renders_ne_operator() -> Bool {
  serialize_expression(expression: not_equals_empty_input_expr()) == "github.event.inputs.expected_healed_sha != ''"
}

fn unused_github_path(path: List<String>) -> GithubPathResolution {
  GithubPathUnmodeled
}

test fn witness_not_equals_evaluates_false_when_equal() -> Bool {
  match evaluate_expression(
    expression: NotEquals { left: StringLiteral { value: "a" }, right: StringLiteral { value: "a" } },
    github_path: unused_github_path
  ) {
    ExpressionValue { value: v } => v == ""
    ExpressionEvaluationRefused { cause: _ } => false
  }
    && match evaluate_expression(
      expression: NotEquals { left: StringLiteral { value: "a" }, right: StringLiteral { value: "b" } },
      github_path: unused_github_path
    ) {
      ExpressionValue { value: v } => v == "true"
      ExpressionEvaluationRefused { cause: _ } => false
    }
}

fn and_literals(left: String, right: String) -> Expression {
  LogicalAnd { left: StringLiteral { value: left }, right: StringLiteral { value: right } }
}

test fn witness_string_false_and_zero_are_truthy() -> Bool {
  match evaluate_expression(expression: and_literals(left: "false", right: "x"), github_path: unused_github_path) {
    ExpressionValue { value: v } => v == "x"
    ExpressionEvaluationRefused { cause: _ } => false
  }
    && match evaluate_expression(expression: and_literals(left: "0", right: "x"), github_path: unused_github_path) {
      ExpressionValue { value: v } => v == "x"
      ExpressionEvaluationRefused { cause: _ } => false
    }
    && match evaluate_expression(expression: and_literals(left: "", right: "x"), github_path: unused_github_path) {
      ExpressionValue { value: v } => v == ""
      ExpressionEvaluationRefused { cause: _ } => false
    }
}


// PRECEDENCE: an operand whose operator binds looser than its parent's is grouped, and nothing else
// is. RED before the grouping rule: (a || b) && c rendered as `a || b && c`, which reads back as
// a || (b && c) -- a different expression for the same tree.
test fn witness_looser_operand_is_grouped_under_a_tighter_operator() -> Bool {
  let a = ContextAccess { context: Github, path: ["a"] }
  let b = ContextAccess { context: Github, path: ["b"] }
  let c = ContextAccess { context: Github, path: ["c"] }
  serialize_expression(expression: LogicalAnd { left: LogicalOr { left: a, right: b }, right: c }) == "(github.a || github.b) && github.c"
    && serialize_expression(expression: Equals { left: LogicalAnd { left: a, right: b }, right: c }) == "(github.a && github.b) == github.c"
}

test fn witness_tighter_operand_is_not_grouped() -> Bool {
  let a = ContextAccess { context: Github, path: ["a"] }
  let b = ContextAccess { context: Github, path: ["b"] }
  let c = ContextAccess { context: Github, path: ["c"] }
  serialize_expression(expression: LogicalOr { left: LogicalAnd { left: a, right: b }, right: c }) == "github.a && github.b || github.c"
    && serialize_expression(expression: LogicalAnd { left: Equals { left: a, right: b }, right: c }) == "github.a == github.b && github.c"
}


// .dag reads `{name` inside a string as an interpolation, so the bare-delimiter spellings are
// authored with << >> and swapped for the writer's delimiters with their spaces trimmed.
fn braced(t: String) -> String {
  replace(replace(t, "<<", trim(s: default_expression_spellings.interp_open)), ">>", trim(s: default_expression_spellings.interp_close))
}

fn template_is(src: String, want: List<TemplateSegment>) -> Bool {
  match ingest_template(src: src) {
    Present { value: t } => t.segments == want
    Absent => false
  }
}

// Upstream's delimiters are the bare `${{` and `}}`; inner whitespace is the tokenizer's.
test fn witness_interpolation_delimiters_tolerate_inner_whitespace() -> Bool {
  let want = [ Interpolation { expression: ctx(c: Steps, path: ["wif_auth", "outputs", "x"]) } ]
  template_is(src: braced(t: "<<steps.wif_auth.outputs.x>>"), want: want)
    && template_is(src: braced(t: "<<  steps.wif_auth.outputs.x >>"), want: want)
    && template_is(src: braced(t: "<<steps.wif_auth.outputs.x >>"), want: want)
    && template_is(src: braced(t: "<< steps.wif_auth.outputs.x >>"), want: want)
}

test fn witness_close_inside_string_literal_does_not_close() -> Bool {
  template_is(src: braced(t: "<< 'a}}b' >>"), want: [ Interpolation { expression: StringLiteral { value: "a}}b" } } ])
    && template_is(src: braced(t: "pre << 'a}}b' >> post"), want: [ LiteralText { text: "pre " }, Interpolation { expression: StringLiteral { value: "a}}b" } }, LiteralText { text: " post" } ])
}

test fn witness_unclosed_interpolation_refuses() -> Bool {
  match ingest_template(src: braced(t: "echo << github.a")) {
    Absent => true
    Present { value: _ } => false
  } && match ingest_template(src: braced(t: "<< 'unterminated >>")) {
    Absent => true
    Present { value: _ } => false
  }
}
