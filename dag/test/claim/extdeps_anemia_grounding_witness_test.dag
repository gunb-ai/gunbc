module test.claim.extdeps_anemia_grounding_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data sample_email: std.types.Email = "author@example.com"
data sample_sha: std.types.CommitSha = "abc1234def5678901234567890abcd1234567890"
data sample_ref: std.types.GitRef = "feature/widgets"
data sample_path: std.types.FilePath = "dag/extdeps/git/git.dag"

test fn w_git_author_email_grounded() -> Bool {
  let author = extdeps.git.GitAuthor {
    name: "Example Author",
    email: sample_email,
    timestamp: "2026-06-18T00:00:00Z"
  }
  author.email == sample_email
}

test fn w_pull_request_ref_grounded() -> Bool {
  let head = extdeps.github.pulls.PullRequestRef {
    ref: sample_ref,
    sha: sample_sha,
    label: "mock-user:feature/widgets"
  }
  head.ref == sample_ref && head.sha == sample_sha
}

test fn w_pull_review_commit_id_grounded() -> Bool {
  let review = extdeps.github.pulls.PullReview {
    id: 1,
    body: "Looks good",
    state: extdeps.github.pulls.Commented,
    commit_id: sample_sha,
    html_url: "https://github.com/mock/pull/1#pullrequestreview-1"
  }
  review.commit_id == sample_sha
}

test fn w_review_comment_path_grounded() -> Bool {
  let comment = extdeps.github.pulls.ReviewComment {
    id: 1,
    node_id: "PRRC_kwDO",
    path: sample_path,
    line: 10,
    original_line: none,
    body: "nit",
    html_url: "https://github.com/mock/pull/1#discussion_r1"
  }
  comment.path == sample_path
}

test fn w_digest_subject_survives_grounded_pull_request_ref() -> Bool {
  let pr = extdeps.github.pulls.PullRequest {
    number: 42,
    title: "Ground extdeps git/github fields",
    body: none,
    state: extdeps.github.pulls.Open,
    html_url: "https://github.com/mock/pull/42",
    user: extdeps.github.github.GitHubUser { login: "mock-user", id: 1, type: extdeps.github.github.User },
    head: extdeps.github.pulls.PullRequestRef {
      ref: sample_ref,
      sha: sample_sha,
      label: "mock-user:feature/widgets"
    },
    base: extdeps.github.pulls.PullRequestRef {
      ref: "main",
      sha: "000aaa111bbb000aaa111bbb000aaa111bbb",
      label: "mock-owner:main"
    },
    created_at: "2026-06-18T00:00:00Z",
    updated_at: "2026-06-18T00:00:00Z",
    merged_at: none,
    draft: false,
    merge_commit_sha: none,
  }
  let subject = gunbc.digest_render.digest_subject(pr: pr)
  subject.head_sha == sample_sha && subject.base_ref == "main"
}

test fn w_cpu_tdp_watts_power_dimension() -> Bool {
  std.measure.watt_count(extdeps.cpu.ampere.altra_max_m12830_catalog.tdp_watts) == 183
}

test fn w_cpu_catalog_row_tdp_not_bare_int() -> Bool {
  let row = extdeps.cpu.types.CpuModelCatalogRow {
    model_number: "TEST",
    oem_listing_id: none,
    vendor: extdeps.vendor.ampere.ampere_vendor,
    architecture: extdeps.toolchain.types.Aarch64,
    cores: 1,
    threads: std.measure.hardware_thread_count(1),
    nominal_sustained_per_thread_hz: std.measure.hertz(1000000000),
    socket: extdeps.cpu.types.CpuSocket { platform_owner: extdeps.vendor.ampere.ampere_vendor, termination: extdeps.cpu.types.SocketedLandGrid, contact_count: 4926, cooling_mount: extdeps.cpu.ampere.ampere_lga4926_cooling_mount },
    socket_citations: extdeps.cpu.ampere.socket_lga4926_citations,
    tdp_watts: std.measure.watt(99),
    l1_cache: extdeps.cpu.ampere.ampere_altra_l1_cache_geometry,
    l1_cache_citations: extdeps.cpu.ampere.ampere_altra_l1_cache_citations,
    l2_cache: extdeps.cpu.ampere.ampere_altra_l2_cache_geometry,
    l2_cache_citations: extdeps.cpu.ampere.ampere_altra_l2_cache_citations,
    l3_cache: extdeps.cpu.ampere.ampere_altra_max_l3_cache_geometry,
    l3_cache_citations: extdeps.cpu.ampere.ampere_altra_max_l3_cache_citations,
  }
  std.measure.watt_count(row.tdp_watts) == 99
}

