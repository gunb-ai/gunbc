module test.claim.cli_run_floor_lens_oracle_witness




test fn floor_lens_hand_rust_production_arms_are_declared_scaffolds() -> Bool {
  !v2.lens.disposition_redundancy.disposition_is_terminal(d: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_read_refusal_hand_rust_scaffold) &&
    !v2.lens.disposition_redundancy.disposition_is_terminal(d: cli_run_floor_lens_observation_hand_rust_scaffold)
}

test fn floor_lens_scaffold_shape_reader_discriminates() -> Bool {
  !v2.lens.disposition_redundancy.disposition_is_terminal(d: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_read_refusal_hand_rust_scaffold)
    && v2.lens.disposition_redundancy.disposition_is_terminal(d: cli_run_floor_lens_scaffold_shape_red_control)
}

test fn floor_lens_hand_rust_trigger_names_sites_and_ticket() -> Bool {
  string_contains(
    s: dissolution_description(condition: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_hand_rust_dissolve_trigger),
    pattern: "refuse_on_module_graph_read_refusals"
  ) &&
    string_contains(
      s: dissolution_description(condition: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_hand_rust_dissolve_trigger),
      pattern: "import_resolution_facts_with_observation"
    ) &&
    string_contains(
      s: dissolution_description(condition: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_hand_rust_dissolve_trigger),
      pattern: "5-dissolve-patches"
    ) &&
    string_contains(
      s: dissolution_description(condition: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_hand_rust_dissolve_trigger),
      pattern: "cli-run-reconcile-defork"
    )
}

test fn floor_lens_oracle_executing_receipt_named() -> Bool {
  string_contains(
    s: gunbc.cli_run_floor_lens_oracle_scaffold.cli_run_floor_lens_oracle_read_refusal_receipt_test,
    pattern: "read_refusal_not_an_absence"
  )
}
