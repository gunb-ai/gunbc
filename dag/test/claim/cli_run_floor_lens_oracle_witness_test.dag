module test.claim.cli_run_floor_lens_oracle_witness


test fn floor_lens_legacy_graph_oracle_is_declared_scaffold() -> Bool {
  disposition_dissolves_to_single_authority(d: cli_run_floor_lens_legacy_graph_oracle_scaffold)
}

test fn floor_lens_legacy_walk_oracle_is_declared_scaffold() -> Bool {
  disposition_dissolves_to_single_authority(d: cli_run_floor_lens_legacy_walk_oracle_scaffold)
}

test fn floor_lens_hand_rust_production_arms_are_declared_scaffolds() -> Bool {
  disposition_dissolves_to_single_authority(d: cli_run_floor_lens_census_walk_hand_rust_scaffold) &&
    disposition_dissolves_to_single_authority(d: cli_run_floor_lens_justification_hand_rust_scaffold) &&
    disposition_dissolves_to_single_authority(d: cli_run_floor_lens_read_refusal_hand_rust_scaffold) &&
    disposition_dissolves_to_single_authority(d: cli_run_floor_lens_observation_hand_rust_scaffold)
}

test fn floor_lens_scaffold_shape_reader_discriminates() -> Bool {
  disposition_dissolves_to_single_authority(d: cli_run_floor_lens_census_walk_hand_rust_scaffold)
    && !disposition_dissolves_to_single_authority(d: cli_run_floor_lens_scaffold_shape_red_control)
    && !disposition_is_terminal(d: cli_run_floor_lens_census_walk_hand_rust_scaffold)
    && disposition_is_terminal(d: cli_run_floor_lens_scaffold_shape_red_control)
}

test fn floor_lens_oracle_dissolve_trigger_names_sites_and_lane() -> Bool {
  string_contains(
    s: cli_run_floor_lens_oracle_dissolve_trigger,
    pattern: "floor_lens_graph_legacy"
  ) &&
    string_contains(
      s: cli_run_floor_lens_oracle_dissolve_trigger,
      pattern: "inert_lens_modules_legacy"
    ) &&
    string_contains(
      s: cli_run_floor_lens_oracle_dissolve_trigger,
      pattern: "resolve_transitively_bfs_legacy"
    ) &&
    string_contains(
      s: cli_run_floor_lens_oracle_dissolve_trigger,
      pattern: "cli-run-reconcile-defork"
    )
}

test fn floor_lens_hand_rust_trigger_names_sites_ticket_and_loc() -> Bool {
  string_contains(
    s: cli_run_floor_lens_hand_rust_dissolve_trigger,
    pattern: "refuse_on_module_graph_read_refusals"
  ) &&
    string_contains(
      s: cli_run_floor_lens_hand_rust_dissolve_trigger,
      pattern: "import_resolution_facts_with_observation"
    ) &&
    string_contains(
      s: cli_run_floor_lens_hand_rust_dissolve_trigger,
      pattern: "5-dissolve-patches"
    ) &&
    string_contains(
      s: cli_run_floor_lens_hand_rust_dissolve_trigger,
      pattern: "cli-run-reconcile-defork"
    ) &&
    cli_run_floor_lens_hand_rust_loc_delta_net > 0
}

test fn floor_lens_oracle_executing_receipts_named() -> Bool {
  string_contains(
    s: cli_run_floor_lens_oracle_equality_receipt_test,
    pattern: "matches_legacy_floor_lens_graph"
  ) &&
    string_contains(
      s: cli_run_floor_lens_oracle_build_count_receipt_test,
      pattern: "single_facts_build"
    ) &&
    string_contains(
      s: cli_run_floor_lens_oracle_read_refusal_receipt_test,
      pattern: "read_refusal_not_an_absence"
    )
}
