module test.claim.fleet_fan_policy_witness

import std.types { Bool, Int, NonEmptyStr }
import std.optional { Absent, Present }
import std.measure { Celsius, celsius, celsius_count, percent }
import extdeps.external_authority { CitedToAuthority, ObservedByReceipt, TranscribedUncited }
import extdeps.cpu.types { ProcessorThermalLimits }
import extdeps.cpu.ampere { ampere_altra_max_m12830_thermal_limits, ampere_altra_thermal_limits_for_model }
import std.measure { celsius_delta_count }
import product.fleet_fan_policy {
  ChassisOutlet,
  DimmChannel,
  FirmwareAutomatic,
  FleetFanControl,
  FleetFanGuardVerdict,
  GuardTrip,
  FleetFanPolicy,
  GuardHolds,
  GuardRestoreAutomatic,
  HeldAtDutyFloor,
  SocJunction,
  ThermalGuardRole,
  VoltageRegulator,
  fleet_fan_control_after,
  fleet_fan_guard_reading,
  fleet_fan_policy,
  fleet_fan_run_exit,
  fleet_fan_trip_for,
  AbsoluteTrip,
  MarginBelowCeiling,
}
import gunbc.machine_intake.megarac_fan_thermal_guard {
  megarac_temperature_trips,
}

// SUPPLIED: temperatures. EXECUTED: the policy fold and, for the MegaRAC arm, the real
// megarac_temperature_trips path that now reads the fleet policy (the inhabitance claim: deleting
// that wiring reds witness_megarac_guard_reads_the_fleet_policy).

fn held_policy() -> FleetFanPolicy {
  FleetFanPolicy { control: HeldAtDutyFloor { floor: percent(20) }, guard: fleet_fan_policy.guard, unreadable_sensor_trips: true }
}

fn is_restore(v: FleetFanGuardVerdict) -> Bool {
  match v {
    GuardHolds => false
    GuardRestoreAutomatic { cause: _ } => true
  }
}

fn is_automatic(c: FleetFanControl) -> Bool {
  match c {
    FirmwareAutomatic => true
    HeldAtDutyFloor { floor: _ } => false
  }
}

// The machine row's ceilings, as the MegaRAC adapter supplies them: only the SoC has one.
fn ceiling_of(role: ThermalGuardRole) -> Celsius? {
  match role {
    SocJunction => Present { value: ampere_altra_max_m12830_thermal_limits.maximum_continuous_junction_temperature }
    DimmChannel => Absent
    VoltageRegulator => Absent
    ChassisOutlet => Absent
  }
}

fn reading_trips(role: ThermalGuardRole, c: Int) -> Bool {
  is_restore(fleet_fan_guard_reading(policy: fleet_fan_policy, role: role, component_ceiling: ceiling_of(role: role), reading: Present { value: celsius(c) }))
}

// THE FLEET REST POSTURE IS FIRMWARE AUTOMATIC.
test fn witness_fleet_policy_rests_in_automatic() -> Bool {
  is_automatic(fleet_fan_policy.control) && fleet_fan_policy.unreadable_sensor_trips
}

// TRIP IS AT-OR-ABOVE, PER ROLE. The oracle is the datasheet (100C continuous junction, Ampere) less
// the stated 15C margin, and the three uncited figures as authored; each is checked on both sides.
test fn witness_guard_trips_at_boundary_per_role() -> Bool {
  reading_trips(role: SocJunction, c: 85) && !reading_trips(role: SocJunction, c: 84)
    && reading_trips(role: DimmChannel, c: 85) && !reading_trips(role: DimmChannel, c: 84)
    && reading_trips(role: VoltageRegulator, c: 90) && !reading_trips(role: VoltageRegulator, c: 89)
    && reading_trips(role: ChassisOutlet, c: 70) && !reading_trips(role: ChassisOutlet, c: 69)
}

// AN UNREADABLE SENSOR TRIPS (fail-closed) - and only because the policy says so, which the second
// half proves by flipping it.
test fn witness_unreadable_sensor_trips_toward_automatic() -> Bool {
  let off = FleetFanPolicy { control: fleet_fan_policy.control, guard: fleet_fan_policy.guard, unreadable_sensor_trips: false }
  is_restore(fleet_fan_guard_reading(policy: fleet_fan_policy, role: SocJunction, component_ceiling: ceiling_of(role: SocJunction), reading: Absent))
    && !is_restore(fleet_fan_guard_reading(policy: off, role: SocJunction, component_ceiling: ceiling_of(role: SocJunction), reading: Absent))
}

// EVERY RESTORE LEAVES AUTOMATIC, WHATEVER THE POLICY WAS HOLDING; HOLDS KEEPS THE POLICY'S POSTURE.
test fn witness_every_exit_leaves_automatic() -> Bool {
  let held = held_policy()
  let tripped = fleet_fan_guard_reading(policy: held, role: SocJunction, component_ceiling: ceiling_of(role: SocJunction), reading: Present { value: celsius(99) })
  is_automatic(fleet_fan_control_after(policy: held, verdict: tripped))
    && is_automatic(fleet_fan_control_after(policy: held, verdict: fleet_fan_run_exit()))
    && !is_automatic(fleet_fan_control_after(policy: held, verdict: GuardHolds))
}

// THE FLEET CARRIES ONLY THE SOC MARGIN (the ceiling is the machine row's), AND THE OTHER THREE
// FIGURES STAY TYPED BETS (DESIGN 4d).
fn is_bet(t: GuardTrip) -> Bool {
  match t {
    AbsoluteTrip { trip: _, standing: st } => match st {
      TranscribedUncited { read_obligation: _ } => true
      CitedToAuthority { authority: _ } => false
      ObservedByReceipt { observed: _ } => false
    }
    MarginBelowCeiling { margin: _, standing: st2 } => match st2 {
      TranscribedUncited { read_obligation: _ } => true
      CitedToAuthority { authority: _ } => false
      ObservedByReceipt { observed: _ } => false
    }
  }
}

test fn witness_guard_standing_cited_versus_bet() -> Bool {
  let soc_margin = match fleet_fan_policy.guard.soc {
    MarginBelowCeiling { margin: m, standing: _ } => celsius_delta_count(m) == 15
    AbsoluteTrip { trip: _, standing: _ } => false
  }
  soc_margin && is_bet(fleet_fan_policy.guard.dimm) && is_bet(fleet_fan_policy.guard.vrd) && is_bet(fleet_fan_policy.guard.outlet)
}

// A MARGIN BELOW A CEILING THE MACHINE ROW DOES NOT STATE HAS NO TEMPERATURE, SO IT TRIPS TOWARD
// AUTOMATIC; it is never read as "no guard".
test fn witness_trip_lookup_is_total_over_the_policy_roles() -> Bool {
  let outlet = match fleet_fan_trip_for(policy: fleet_fan_policy, role: ChassisOutlet, component_ceiling: Absent) {
    Absent => false
    Present { value: t } => celsius_count(t) == 70
  }
  let soc_unstated = is_restore(fleet_fan_guard_reading(policy: fleet_fan_policy, role: SocJunction, component_ceiling: Absent, reading: Present { value: celsius(40) }))
  let soc_other_part = match fleet_fan_trip_for(policy: fleet_fan_policy, role: SocJunction, component_ceiling: Present { value: celsius(95) }) {
    Absent => false
    Present { value: t } => celsius_count(t) == 80
  }
  outlet && soc_unstated && soc_other_part
}

// INHABITANCE: the MegaRAC guard's own predicate agrees with the fleet fold on both sides of a trip,
// so the real adapter path reads the policy and not a private copy.
test fn witness_megarac_guard_reads_the_fleet_policy() -> Bool {
  let m128 = ampere_altra_thermal_limits_for_model(model_number: "M128-30" as NonEmptyStr)
  let q80 = ampere_altra_thermal_limits_for_model(model_number: "Q80-30" as NonEmptyStr)
  megarac_temperature_trips(sensor: "CPU0_SOC_Temp" as NonEmptyStr, temperature: celsius(85), cpu_limits: m128)
    && !megarac_temperature_trips(sensor: "CPU0_SOC_Temp" as NonEmptyStr, temperature: celsius(84), cpu_limits: m128)
    && megarac_temperature_trips(sensor: "Outlet_1_Temp" as NonEmptyStr, temperature: celsius(70), cpu_limits: m128)
    && !megarac_temperature_trips(sensor: "Not_A_Guard_Sensor" as NonEmptyStr, temperature: celsius(120), cpu_limits: m128)
    && !is_present_limits(q80)
    && megarac_temperature_trips(sensor: "CPU0_SOC_Temp" as NonEmptyStr, temperature: celsius(30), cpu_limits: q80)
}

fn is_present_limits(v: ProcessorThermalLimits?) -> Bool {
  match v {
    Present { value: _ } => true
    Absent => false
  }
}
