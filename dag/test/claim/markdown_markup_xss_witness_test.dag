module test.claim.markdown_markup_xss_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn sample_readme_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.HeadingBlock {
        level: H1,
        inlines: [ std.markdown.TextInline { text: "README" } ],
      },
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.TextInline { text: "Visit " },
          std.markdown.LinkInline {
            inlines: [ std.markdown.TextInline { text: "home" } ],
            url: "https://gunbc.dev",
          },
          std.markdown.TextInline { text: " for docs." },
        ],
      },
      std.markdown.UnorderedListBlock {
        items: [
          std.markdown.MarkdownListItem {
            blocks: [
              std.markdown.ParagraphBlock {
                inlines: [
                  std.markdown.StrongInline {
                    inlines: [ std.markdown.TextInline { text: "bold" } ],
                  },
                  std.markdown.TextInline { text: " and " },
                  std.markdown.EmphasisInline {
                    inlines: [ std.markdown.TextInline { text: "italic" } ],
                  },
                ],
              },
            ],
          },
          std.markdown.MarkdownListItem {
            blocks: [
              std.markdown.ParagraphBlock {
                inlines: [
                  std.markdown.TextInline { text: "inline " },
                  std.markdown.CodeInline { text: "fn main()" },
                ],
              },
            ],
          },
        ],
      },
      std.markdown.CodeBlock { code: "let x = 1;\n" },
    ],
  }
}

fn witness_markdown_reduces_and_serializes() -> Bool {
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: sample_readme_doc()) {
    std.markup.Serialized { html: h } =>
      h == concat(
        concat(
          concat(
            concat(
              "<div><h1>README</h1><gunbc.plans.md_helpers.p>Visit <a href=\"https://gunbc.dev\">home</a> for docs.</gunbc.plans.md_helpers.p>",
              "<ul><li><gunbc.plans.md_helpers.p><strong>bold</strong> and <em>italic</em></gunbc.plans.md_helpers.p></li>",
            ),
            "<li><gunbc.plans.md_helpers.p>inline <code>fn main()</code></gunbc.plans.md_helpers.p></li></ul>",
          ),
          "<pre><code>let x = 1;\n</code></pre>",
        ),
        "</div>"
      )
    Rejected { reason: _ } => false
  }
}

fn witness_markdown_uses_one_serialize_fragment_fold() -> Bool {
  let via_consumer = extdeps.languages.markdown.serialize_markdown_document(doc: sample_readme_doc())
  let via_fold = extdeps.languages.html_fragment.serialize_fragment(
    frag: std.markdown.markdown_document_to_fragment(doc: sample_readme_doc())
  )
  via_consumer == via_fold
}

fn witness_ordered_list_serializes() -> Bool {
  let doc = std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.OrderedListBlock {
        items: [
          std.markdown.MarkdownListItem {
            blocks: [
              std.markdown.ParagraphBlock {
                inlines: [ std.markdown.TextInline { text: "one" } ],
              },
            ],
          },
          std.markdown.MarkdownListItem {
            blocks: [
              std.markdown.ParagraphBlock {
                inlines: [ std.markdown.TextInline { text: "two" } ],
              },
            ],
          },
        ],
      },
    ],
  }
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: doc) {
    std.markup.Serialized { html: h } => h == "<div><ol><li><gunbc.plans.md_helpers.p>one</gunbc.plans.md_helpers.p></li><li><gunbc.plans.md_helpers.p>two</gunbc.plans.md_helpers.p></li></ol></div>"
    Rejected { reason: _ } => false
  }
}

fn witness_image_serializes() -> Bool {
  let doc = std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.ImageInline { alt: "logo", url: "/static/logo.png" },
        ],
      },
    ],
  }
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: doc) {
    std.markup.Serialized { html: h } =>
      h == "<div><gunbc.plans.md_helpers.p><img src=\"/static/logo.png\" alt=\"logo\"></gunbc.plans.md_helpers.p></div>"
    Rejected { reason: _ } => false
  }
}

fn witness_heading_levels_map_to_tags() -> Bool {
  let doc = std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.HeadingBlock { level: H2, inlines: [ std.markdown.TextInline { text: "sub" } ] },
    ],
  }
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: doc) {
    std.markup.Serialized { html: h } => h == "<div><h2>sub</h2></div>"
    Rejected { reason: _ } => false
  }
}

fn javascript_link_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.LinkInline {
            inlines: [ std.markdown.TextInline { text: "click" } ],
            url: "javascript:alert(1)",
          },
        ],
      },
    ],
  }
}

fn data_image_doc() -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.ImageInline {
            alt: "x",
            url: "data:text/html,<script>alert(1)</script>",
          },
        ],
      },
    ],
  }
}

fn witness_javascript_link_rejects() -> Bool {
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: javascript_link_doc()) {
    Rejected { reason: _ } => true
    std.markup.Serialized { html: _ } => false
  }
}

fn witness_data_image_rejects() -> Bool {
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: data_image_doc()) {
    Rejected { reason: _ } => true
    std.markup.Serialized { html: _ } => false
  }
}

fn witness_escape_url_passes_javascript_scheme() -> Bool {
  std.markup.escape_url(s: "javascript:alert(1)") == "javascript:alert(1)"
}

fn witness_javascript_link_reject_discriminates_from_char_escape() -> Bool {
  let unchecked = extdeps.languages.markdown.serialize_markdown_document(doc: javascript_link_doc())
  witness_javascript_link_rejects()
    && witness_escape_url_passes_javascript_scheme()
    && unchecked == "<div><gunbc.plans.md_helpers.p><a href=\"javascript:alert(1)\">click</a></gunbc.plans.md_helpers.p></div>"
}

fn witness_data_image_reject_discriminates_from_char_escape() -> Bool {
  witness_data_image_rejects()
    && starts_with(
      s: extdeps.languages.markdown.serialize_markdown_document(doc: data_image_doc()),
      prefix: "<div><gunbc.plans.md_helpers.p><img src=\"data:"
    )
}

fn witness_validate_href_javascript_rejects() -> Bool {
  match validate_href(url: "javascript:alert(1)") {
    RejectedHref { reason: DangerousScheme { scheme: JavascriptScheme } } => true
    _ => false
  }
}

fn witness_validate_href_data_rejects() -> Bool {
  match validate_href(url: "data:text/html,x") {
    RejectedHref { reason: DangerousScheme { scheme: DataScheme } } => true
    _ => false
  }
}

fn witness_relative_link_accepted() -> Bool {
  match validate_href(url: "/safe/path") {
    SafeHref { url: u } => u == "/safe/path"
    _ => false
  }
}

fn witness_https_link_serializes() -> Bool {
  let doc = std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.LinkInline {
            inlines: [ std.markdown.TextInline { text: "home" } ],
            url: "https://gunbc.dev",
          },
        ],
      },
    ],
  }
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: doc) {
    std.markup.Serialized { html: h } =>
      h == "<div><gunbc.plans.md_helpers.p><a href=\"https://gunbc.dev\">home</a></gunbc.plans.md_helpers.p></div>"
    Rejected { reason: _ } => false
  }
}

fn witness_req_a_hostile_href_still_emits_with_escaping() -> Bool {
  let doc = std.markdown.MarkdownDocument {
    blocks: [
      std.markdown.ParagraphBlock {
        inlines: [
          std.markdown.LinkInline {
            inlines: [],
            url: "x\"&<y onmouseover=z",
          },
        ],
      },
    ],
  }
  match extdeps.languages.markdown.try_serialize_markdown_document(doc: doc) {
    std.markup.Serialized { html: h } =>
      h == "<div><gunbc.plans.md_helpers.p><a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a></gunbc.plans.md_helpers.p></div>"
    Rejected { reason: _ } => false
  }
}

test fn markdown_markup_xss_keystone_holds() -> Bool {
  witness_markdown_reduces_and_serializes()
    && witness_markdown_uses_one_serialize_fragment_fold()
    && witness_ordered_list_serializes()
    && witness_image_serializes()
    && witness_heading_levels_map_to_tags()
    && witness_javascript_link_rejects()
    && witness_data_image_rejects()
    && witness_javascript_link_reject_discriminates_from_char_escape()
    && witness_data_image_reject_discriminates_from_char_escape()
    && witness_validate_href_javascript_rejects()
    && witness_validate_href_data_rejects()
    && witness_relative_link_accepted()
    && witness_https_link_serializes()
    && witness_req_a_hostile_href_still_emits_with_escaping()
}
