module gunbc.test.claim.witness_execution_class_live_census_test

import v2.workflow.floor_discovery_producer {
  FloorDiscoveryWalkState,
  floor_discovery_walk_state_zero,
  floor_discovery_walk_dir
}
import gunbc.ci_layer_roots { witness_discovery_scan_dirs }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree, SubstrateInputsOnly }
import v2.std.optional { Optional, Present, Absent }
import v2.std.algebra { fold_list, length, any }
import std.types { Bool, Int, List, String }
import std.selected_witness_bundle {
  SelectedWitnessPlan,
  SelectedWitnessMember,
  NativeSelected,
  InterpreterFrontier
}
import v2.test.execution.native_selected_witness_bundle {
  selected_logic_primary_plan
}
import gunbc.witness_execution_class {
  WitnessExecutionClass,
  NativeRequired,
  NativeLiveObservation,
  EffectObligation,
  InterpreterSubjectTest,
  NativeBlocked,
  NativeBlockedCause,
  GeneralWitnessTargetModelUnavailable,
  EmitterCarriage,
  CarriedInEnrolledBundle,
  NoEmitterCarriage,
  WitnessClassRow,
  classify_witness,
  census_of,
  census_accounts_for_every_row,
  every_identity_classified_exactly_once,
  row_identity
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data live_census_note: String = "CI-0 live-roster consumer (operator bar, msg_be57b9db): the classifier is exercised against the LIVE enrolled discovery roster, not fixtures — the same floor_discovery_producer walk over the same witness_discovery_scan_dirs the floor's corpus batch scans, with the enrolled bundle plan joined in as the CarriedInEnrolledBundle population. Assertions are structural laws and identity joins, never tree-copied count literals (DESIGN §5 oracle rule): partition exactness, exactly-once at identity grain, and the NativeRequired population equal by identity join to the enrolled plan members. Residue, declared: the floor also walks source-root *_test.dag files outside these dirs; classifying that wider universe from .dag awaits the module-identity walk (the same wider-universe residue the discovery flip note carries)."

fn live_discovery_state() -> FloorDiscoveryWalkState {
  fold_list(
    xs: witness_discovery_scan_dirs,
    empty: floor_discovery_walk_state_zero(),
    cons: fn(acc, dir) {
      floor_discovery_walk_dir(state: acc, dir_path: dir, exclude_substrings: [])
    }
  )
}

fn plan_bundle_name() -> String {
  "v2-compiler-emit-selected-logic-bundle-v1"
}

fn empty_class_rows() -> List<WitnessClassRow> {
  []
}

fn plan_member_rows(plan: SelectedWitnessPlan) -> List<WitnessClassRow> {
  fold_list(xs: plan.members, empty: empty_class_rows(), cons: fn(acc, member) {
    match member {
      NativeSelected { witness: w, realization: _ } =>
        concat(acc, [WitnessClassRow {
          entry: w.entry,
          function: w.function,
          class: classify_witness(
            disposition: Present { value: SubstrateInputsOnly },
            effect_obligation: false,
            interpreter_subject: false,
            carriage: CarriedInEnrolledBundle {
              bundle_identity: plan_bundle_name(),
              member: w.function
            }
          )
        }])
      InterpreterFrontier { witness: _, cause: _, reason: _, dissolve_on: _ } => acc
    }
  })
}

fn discovery_class_rows(state: FloorDiscoveryWalkState) -> List<WitnessClassRow> {
  fold_list(xs: state.rows, empty: empty_class_rows(), cons: fn(acc, r) {
    concat(acc, [WitnessClassRow {
      entry: r.entry,
      function: r.function,
      class: classify_witness(
        disposition: Present { value: r.reads_live_tree },
        effect_obligation: false,
        interpreter_subject: false,
        carriage: NoEmitterCarriage { cause: GeneralWitnessTargetModelUnavailable }
      )
    }])
  })
}

fn live_census_rows() -> List<WitnessClassRow> {
  concat(discovery_class_rows(state: live_discovery_state()), plan_member_rows(plan: selected_logic_primary_plan()))
}

test fn witness_live_roster_census_holds() -> Bool {
  let state = live_discovery_state()
  let walk_loud = state.walk_failures == 0
    && match state.disposition_refusal {
      Absent => true
      Present { value: _ } => false
    }
    && length(xs: state.rows) > 0
  let rows = concat(discovery_class_rows(state: state), plan_member_rows(plan: selected_logic_primary_plan()))
  let plan = selected_logic_primary_plan()
  let native_rows = fold_list(xs: rows, empty: empty_class_rows(), cons: fn(acc, r) {
    match r.class {
      NativeRequired => concat(acc, [r])
      _ => acc
    }
  })
  let plan_join = length(xs: native_rows) == length(xs: plan.members)
    && fold_list(xs: plan.members, empty: true, cons: fn(acc, member) {
      acc && match member {
        NativeSelected { witness: w, realization: _ } =>
          any(xs: native_rows, predicate: fn(r) { (r.entry == w.entry) && (r.function == w.function) })
        InterpreterFrontier { witness: _, cause: _, reason: _, dissolve_on: _ } => true
      }
    })
  walk_loud
    && every_identity_classified_exactly_once(rows: rows)
    && census_accounts_for_every_row(rows: rows)
    && plan_join
}
