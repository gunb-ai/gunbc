module test.claim.generated_workflow_provenance_witness

import gunbc.generated_artifact { committed_generated_workflow_artifacts }
import gunbc.generated_artifact_emit {
  artifact_generate,
  ArtifactGenerated,
  ArtifactGenerationRefused,
}
import gunbc.generated_workflow_provenance {
  generated_workflow_provenance_header,
  GeneratedWorkflowProvenanceHeaderProduced,
  GeneratedWorkflowProvenanceHeaderNotApplicable,
}

// ALL MEMBERS, joined by artifact identity. There is no copied cardinality: a new committed
// GithubActionsWorkflow artifact enters this fold through the existing generated-artifact commit
// policy and must carry its own projected header as the first bytes it emits.
test fn every_committed_generated_workflow_declares_its_provenance_in_its_own_bytes() -> Bool {
  all(committed_generated_workflow_artifacts(), a =>
    match generated_workflow_provenance_header(a: a) {
      GeneratedWorkflowProvenanceHeaderNotApplicable => false
      GeneratedWorkflowProvenanceHeaderProduced { content: header } =>
        match artifact_generate(a: a) {
          ArtifactGenerationRefused { reason: _ } => false
          ArtifactGenerated { content } => starts_with(s: content, prefix: header)
        }
    }
  )
}
