module test.claim.gcp_secret_access_witness_test

import extdeps.cloud.gcp.iam {
  GcpPolicy, GcpBinding, GcpIamBindingCell, GcpIamOwnedCellUniverse, IamCondition,
  GcpPolicyReconciliation, GcpPolicyAlreadyConverged, GcpPolicyDeltaRequired,
  reconcile_gcp_policy, gcp_policy_cells, gcp_cell_in, condition_mangled_roles,
  role_secretmanager_secret_accessor
}
import gunbc.auth.gcp_secret_access {
  SecretAccessGrant, secret_accessor_grant,
  secret_access_ensure_operations,
  principal_admits_every_ensure_operation, principal_admits_any_ensure_operation,
  ensure_control_plane_principal, ensure_workload_principal,
  GrantMemberResolved, GrantMemberUnresolved, grant_member_resolution,
  secret_access_desired_cells, secret_access_owned_universe, secret_access_grant_present,
  conditioned_cells_without_grant,
}
import gunbc.spark.credential_workflow { spark_administrator_password_secret_ref }
import std.types { String }
import std.logic { Bool }

data convergence_member: String = "serviceAccount:fleet-cloud-convergence@gunbai-secrets.iam.gserviceaccount.com"

fn accessor_grant() -> SecretAccessGrant {
  secret_accessor_grant(target: spark_administrator_password_secret_ref)
}

// A time-bounded grant of the SAME role to the SAME member on the SAME secret. Everything about it
// agrees with accessor_grant() except the condition, which is exactly the discrimination the
// condition axis has to survive: if condition were dropped anywhere in the desired/owned/readback
// chain these two would be one cell and the expiring grant would silently read as the standing one.
data twenty_four_hour_condition: IamCondition = IamCondition {
  title: "access-request-expiry",
  expression: "request.time < timestamp(\"2026-09-06T00:00:00Z\")",
  description: none
}

fn expiring_accessor_grant() -> SecretAccessGrant {
  SecretAccessGrant {
    target: spark_administrator_password_secret_ref,
    role: role_secretmanager_secret_accessor,
    condition: Present { value: twenty_four_hour_condition }
  }
}

fn admin_grant() -> SecretAccessGrant {
  SecretAccessGrant {
    target: spark_administrator_password_secret_ref,
    role: "roles/secretmanager.admin",
    condition: none
  }
}

// A binding this model does not own, held by an unrelated principal. Its survival is the property
// that separates an ensure from a policy overwrite.
data foreign_binding: GcpBinding = GcpBinding {
  role: "roles/secretmanager.admin",
  members: ["user:someone-else@example.com"],
  condition: none
}

fn policy_without_grant() -> GcpPolicy {
  GcpPolicy { bindings: [foreign_binding], etag: "etag-observed", version: 1 }
}

fn policy_with_grant() -> GcpPolicy {
  GcpPolicy {
    bindings: [
      foreign_binding,
      GcpBinding { role: role_secretmanager_secret_accessor, members: [convergence_member], condition: none }
    ],
    etag: "etag-observed",
    version: 1
  }
}

// The same accessor cell for the same member, but CONDITIONED. Against accessor_grant() this policy
// does not carry the grant at all.
//
// VERSION 3, AND THE FIRST REVISION OF THIS FIXTURE SAID 1, WHICH IS A POLICY GOOGLE WILL NOT ISSUE.
// A document carrying a conditional binding is schema version 3; version 1 with a condition is
// invalid, so every test reading this fixture was asserting over a state the provider cannot
// produce. Caught in review. A fixture that encodes an impossible observation proves nothing about
// the real round trip however green it goes, which is why it is corrected rather than annotated.
fn policy_with_expiring_grant() -> GcpPolicy {
  GcpPolicy {
    bindings: [
      foreign_binding,
      GcpBinding {
        role: role_secretmanager_secret_accessor,
        members: [convergence_member],
        condition: Present { value: twenty_four_hour_condition }
      }
    ],
    etag: "etag-observed",
    version: 3
  }
}

// A conditional binding held by SOMEONE ELSE. This is the population a desired-only version scan
// misses: the document is conditional because of a cell this model does not own and will preserve.
data foreign_conditional_binding: GcpBinding = GcpBinding {
  role: "roles/secretmanager.viewer",
  members: ["user:someone-else@example.com"],
  condition: Present { value: twenty_four_hour_condition }
}

fn policy_with_foreign_conditional_only() -> GcpPolicy {
  GcpPolicy {
    bindings: [foreign_binding, foreign_conditional_binding],
    etag: "etag-observed",
    version: 3
  }
}

fn reconcile_cells(
  observed: GcpPolicy,
  desired: List<GcpIamBindingCell>,
  owned: List<GcpIamBindingCell>
) -> GcpPolicyReconciliation {
  reconcile_gcp_policy(
    observed: observed,
    desired_owned: desired,
    owned_universe: GcpIamOwnedCellUniverse { cells: owned }
  )
}

fn reconcile_for(observed: GcpPolicy, grant: SecretAccessGrant) -> GcpPolicyReconciliation {
  reconcile_gcp_policy(
    observed: observed,
    desired_owned: secret_access_desired_cells(member: convergence_member, grant: grant),
    owned_universe: secret_access_owned_universe(member: convergence_member, grant: grant)
  )
}

test fn the_member_resolves_to_the_allocated_convergence_principal() -> Bool {
  match grant_member_resolution() {
    GrantMemberResolved { member: m } => m == convergence_member
    GrantMemberUnresolved { cause: _ } => false
  }
}

// The accessor helper is what both production entries call, so what IT selects is asserted -- not
// the value of the imported role constant, which would be a tautology about extdeps and would say
// nothing about the cell this ensure actually writes. A grant of admin to the workload would be the
// escalation the two-principal split exists to prevent.
test fn the_accessor_helper_grants_the_accessor_role_and_no_administrative_one() -> Bool {
  let cells = secret_access_desired_cells(member: convergence_member, grant: accessor_grant())
  let admin_cells = cells |> filter(c => c.role == "roles/secretmanager.admin")
  count(cells) == 1
    && count(admin_cells) == 0
    && gcp_cell_in(
         c: GcpIamBindingCell { role: "roles/secretmanager.secretAccessor", member: convergence_member, condition: none },
         xs: cells
       )
}

// ROLE IS NOW A PARAMETER, AND THIS IS THE WITNESS THAT IT REACHES THE CELL. Before the widening the
// role was a constant inside the desired-cell builder, so a request naming a different role had
// nowhere to go. If the parameter were accepted and then ignored -- the exact shape of a widening
// that type-checks and does nothing -- this test goes red while every other test in the file stays
// green, because every other test uses the accessor role the old constant already produced.
test fn a_grant_naming_a_different_role_produces_a_cell_for_that_role() -> Bool {
  let cells = secret_access_desired_cells(member: convergence_member, grant: admin_grant())
  count(cells) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell { role: "roles/secretmanager.admin", member: convergence_member, condition: none },
         xs: cells
       )
    && count(cells |> filter(c => c.role == role_secretmanager_secret_accessor)) == 0
}

// THE SAME TEST FOR THE CONDITION AXIS. A dropped condition is the silent failure that would make
// every time-bounded grant reconcile as a permanent one -- the grant would be written without its
// expiry and would never end.
test fn a_conditioned_grant_produces_a_conditioned_cell() -> Bool {
  let cells = secret_access_desired_cells(member: convergence_member, grant: expiring_accessor_grant())
  count(cells) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell {
              role: role_secretmanager_secret_accessor,
              member: convergence_member,
              condition: Present { value: twenty_four_hour_condition }
            },
         xs: cells
       )
}

// OWNED is what may be REMOVED. Keeping it equal to desired is what makes a foreign binding
// unremovable; a witness pins it so widening it is a visible edit rather than a quiet one.
test fn the_owned_universe_is_exactly_the_desired_cell() -> Bool {
  let owned = secret_access_owned_universe(member: convergence_member, grant: accessor_grant())
  count(owned.cells) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell { role: role_secretmanager_secret_accessor, member: convergence_member, condition: none },
         xs: owned.cells
       )
}

// THE NO-OP IS THE POINT. A policy already carrying the grant reconciles to its own arm, so the
// ensure performs no setIamPolicy and the etag does not advance.
test fn an_already_granted_policy_reconciles_to_converged_and_writes_nothing() -> Bool {
  match reconcile_for(observed: policy_with_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => true
    GcpPolicyDeltaRequired { policy: _, added: _, removed: _, preserved: _ } => false
  }
}

test fn a_policy_missing_the_grant_requires_a_delta() -> Bool {
  match reconcile_for(observed: policy_without_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: _, added: a, removed: _, preserved: _ } => count(a) == 1
  }
}

// AN EXPIRING CELL IS NOT THE UNCONDITIONED ONE, driven through the reconciler rather than only
// through cell equality. A policy holding only the 24-hour grant must still require a delta for the
// standing grant -- if condition were ignored this would report converged and the permanent access
// the caller asked for would never be written.
test fn a_policy_holding_only_the_expiring_cell_still_needs_the_standing_grant() -> Bool {
  match reconcile_for(observed: policy_with_expiring_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: _, added: a, removed: _, preserved: _ } => count(a) == 1
  }
}

// The written policy must CONTAIN the grant. A delta that computed correctly but assembled a
// policy without the cell would still fail the run, and this is the assertion that separates them.
test fn the_policy_to_write_carries_the_granted_cell() -> Bool {
  match reconcile_for(observed: policy_without_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } =>
      secret_access_grant_present(policy: p, member: convergence_member, grant: accessor_grant())
  }
}

// THE SAFETY PROPERTY. setIamPolicy is a whole-policy replace, so an ensure that assembles the new
// policy from its desired set alone would silently revoke every binding it does not know about.
// The foreign admin binding must survive into the policy that gets written, and must never appear
// in `removed`.
test fn a_foreign_binding_survives_the_write_and_is_never_removed() -> Bool {
  match reconcile_for(observed: policy_without_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: _, removed: r, preserved: pres } =>
      count(r) == 0
        && gcp_cell_in(
             c: GcpIamBindingCell { role: "roles/secretmanager.admin", member: "user:someone-else@example.com", condition: none },
             xs: gcp_policy_cells(p: p)
           )
        && count(pres) == 1
  }
}

// The readback predicate must be able to say NO. A predicate that answers true for any policy
// would make the post-write verification vacuous, so it is driven both ways.
test fn the_grant_readback_predicate_discriminates() -> Bool {
  secret_access_grant_present(policy: policy_with_grant(), member: convergence_member, grant: accessor_grant())
    && !secret_access_grant_present(policy: policy_without_grant(), member: convergence_member, grant: accessor_grant())
}

// A different member is a different grant. Without this the readback would accept a policy that
// granted access to somebody else entirely.
test fn the_readback_does_not_accept_a_grant_to_another_member() -> Bool {
  !secret_access_grant_present(
    policy: policy_with_grant(),
    member: "serviceAccount:someone-else@gunbai-secrets.iam.gserviceaccount.com",
    grant: accessor_grant()
  )
}

// AND A DIFFERENT CONDITION IS A DIFFERENT GRANT. This is the readback half of the condition axis:
// an expiring cell must not satisfy a readback performed for the standing one, or the ensure would
// report success on a grant that ends tomorrow.
test fn the_readback_does_not_accept_an_expiring_cell_for_a_standing_grant() -> Bool {
  !secret_access_grant_present(
    policy: policy_with_expiring_grant(),
    member: convergence_member,
    grant: accessor_grant()
  )
    && secret_access_grant_present(
         policy: policy_with_expiring_grant(),
         member: convergence_member,
         grant: expiring_accessor_grant()
       )
}

// ── Conditioned-cell drift ───────────────────────────────────────────────────────────────────
// A time-bounded cell nobody requested must be REPORTED, not preserved in silence.
test fn a_conditioned_cell_with_no_matching_grant_is_reported_as_drift() -> Bool {
  let drift = conditioned_cells_without_grant(observed: policy_with_expiring_grant(), granted: [])
  count(drift) == 1
    && gcp_cell_in(
         c: GcpIamBindingCell {
              role: role_secretmanager_secret_accessor,
              member: convergence_member,
              condition: Present { value: twenty_four_hour_condition }
            },
         xs: drift
       )
}

// THE POSITIVE CONTROL ON THE PLANT. The test above is only evidence if the SAME policy goes quiet
// once the cell IS granted -- otherwise the detector could be answering "nonempty" for any
// conditioned policy and the red above would be unearned.
test fn the_same_conditioned_cell_is_not_drift_once_a_grant_matches_it() -> Bool {
  let granted = secret_access_desired_cells(member: convergence_member, grant: expiring_accessor_grant())
  count(conditioned_cells_without_grant(observed: policy_with_expiring_grant(), granted: granted)) == 0
}

// UNCONDITIONED FOREIGN BINDINGS ARE NOT DRIFT, and this is what keeps the detector from becoming
// the absorbing fallback in the other direction. policy_with_grant() carries a foreign admin cell
// this model does not own and did not request; reporting it would make every ordinary policy look
// like drift and the signal would be worthless.
test fn an_unconditioned_foreign_binding_is_never_reported_as_drift() -> Bool {
  count(conditioned_cells_without_grant(observed: policy_with_grant(), granted: [])) == 0
    && count(conditioned_cells_without_grant(observed: policy_without_grant(), granted: [])) == 0
}

// THE PRINCIPAL ATTRIBUTION, EXECUTED. The module claims it acts as the modeled control plane and
// never as the workload. Prose cannot establish that, so both directions are driven here.
//
// This is the one that matters. If the workload could perform these operations, the ensure would be
// self-granting and the two-principal split decorative -- so the negative is asserted per operation
// rather than in aggregate, because an aggregate false is satisfied by ANY single denial and would
// hide a partial widening.
test fn the_workload_principal_can_perform_no_operation_this_ensure_needs() -> Bool {
  !principal_admits_any_ensure_operation(principal: ensure_workload_principal())
}

test fn the_control_plane_principal_admits_every_operation_this_ensure_needs() -> Bool {
  principal_admits_every_ensure_operation(principal: ensure_control_plane_principal())
}

// The two checks above are only meaningful if the operation set is the real one. An empty list
// would satisfy "every" vacuously and "any" trivially, so the population is pinned.
test fn the_ensure_operation_set_is_exactly_the_two_policy_operations() -> Bool {
  count(secret_access_ensure_operations()) == 2
}


// ── The assembled policy's schema version ────────────────────────────────────────────────────
// Google requires version 3 for any document containing a conditional binding and rejects a
// version-1 document that carries one. The reconciler used to copy observed.version forward, so the
// first conditional grant produced an invalid write. These drive the rule in both directions.

test fn adding_the_first_condition_promotes_the_written_policy_to_version_three() -> Bool {
  match reconcile_for(observed: policy_without_grant(), grant: expiring_accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } =>
      p.version == 3 && p.etag == "etag-observed"
  }
}

// THE CASE A DESIRED-ONLY SCAN MISSES. Our own grant is unconditioned, so nothing WE author makes
// this document conditional -- the foreign viewer binding does, and we are preserving it. Reading
// only the desired set would write version 1 over a policy that still contains someone else's
// condition.
test fn a_preserved_foreign_condition_keeps_the_written_policy_at_version_three() -> Bool {
  match reconcile_for(observed: policy_with_foreign_conditional_only(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: a, removed: _, preserved: pres } =>
      p.version == 3 && count(a) == 1 && count(pres) == 2
  }
}

// REMOVING THE LAST CONDITION IS STILL AN OPERATION ON A CONDITIONAL POLICY. The otherwise arm is
// observed.version rather than a literal 1, so this write stays at version 3. Spelling that arm as 1
// would downgrade the removal, which is the counterexample the rule is shaped to avoid.
test fn removing_the_last_conditional_cell_still_writes_version_three() -> Bool {
  let owned = secret_access_desired_cells(member: convergence_member, grant: expiring_accessor_grant())
  match reconcile_cells(observed: policy_with_expiring_grant(), desired: [], owned: owned) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: _, removed: r, preserved: _ } =>
      count(r) == 1 && p.version == 3
  }
}

// THE NEGATIVE HALF. Without this the rule could be "always 3" and every test above would still
// pass, so an ordinary unconditioned reconciliation must carry the observation's own version
// through untouched.
test fn an_unconditioned_delta_preserves_the_observed_version() -> Bool {
  match reconcile_for(observed: policy_without_grant(), grant: accessor_grant()) {
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: p, added: _, removed: _, preserved: _ } =>
      p.version == 1 && p.etag == "etag-observed"
  }
}


// ── The version-1 conditional read is refused, not repaired ──────────────────────────────────
// Google renders a conditional binding to a version-1 requester as `<role>_withcond_<hash>` with the
// condition object absent. Reconciling against that computes our unconditional cell as MISSING and
// writes it, replacing somebody's restricted access with an unconditional grant.

data withcond_binding: GcpBinding = GcpBinding {
  role: "roles/secretmanager.secretAccessor_withcond_a1b2c3d4",
  members: [convergence_member],
  condition: none
}

fn policy_read_at_version_one_with_conditions() -> GcpPolicy {
  GcpPolicy { bindings: [foreign_binding, withcond_binding], etag: "etag-observed", version: 1 }
}

test fn a_condition_mangled_policy_is_refused_rather_than_reconciled() -> Bool {
  match reconcile_for(observed: policy_read_at_version_one_with_conditions(), grant: accessor_grant()) {
    GcpPolicyRepresentationLossy { conditional_roles: rs } =>
      count(rs) == 1 && any(rs, r => r == "roles/secretmanager.secretAccessor_withcond_a1b2c3d4")
    GcpPolicyAlreadyConverged { policy: _ } => false
    GcpPolicyDeltaRequired { policy: _, added: _, removed: _, preserved: _ } => false
  }
}

// THE DAMAGE THIS PREVENTS, MADE EXPLICIT. Without the refusal the same observation takes the delta
// path, because the mangled role does not match the accessor cell we want, so the reconciler reports
// our grant as missing and adds it -- an unconditional binding written beside a restriction it
// could not see. This asserts the refusal arm wins over that path for this exact input.
test fn the_mangled_read_never_reaches_the_delta_path_that_would_widen_access() -> Bool {
  match reconcile_for(observed: policy_read_at_version_one_with_conditions(), grant: accessor_grant()) {
    GcpPolicyDeltaRequired { policy: _, added: _, removed: _, preserved: _ } => false
    GcpPolicyRepresentationLossy { conditional_roles: _ } => true
    GcpPolicyAlreadyConverged { policy: _ } => false
  }
}

// THE POSITIVE CONTROL ON THE DETECTOR. Every ordinary policy in this file must go quiet, or the
// refusal would fire on faithful reads and the arm above would be unearned.
test fn faithful_policies_are_never_reported_as_condition_mangled() -> Bool {
  count(condition_mangled_roles(p: policy_without_grant())) == 0
    && count(condition_mangled_roles(p: policy_with_grant())) == 0
    && count(condition_mangled_roles(p: policy_with_expiring_grant())) == 0
    && count(condition_mangled_roles(p: policy_with_foreign_conditional_only())) == 0
}
