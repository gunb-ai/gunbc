module test.claim.dag_compile_clean_shard_a_witness

import v2.std.subject_evidence {
  EvidenceInstrumentRefused,
  EvidenceSubjectCompleted,
  EvidenceSubjectUnreached,
  subject_evidence_establishes
}
import tools.host_prelude { WitnessBinNotEnrolled }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly
data witness_compose_red_on_injected_failure: Bool = compose_compile_clean_shard_verdicts(
  verdicts: [ShardClean, ShardFailed { entry_path: shard_a_exemplar_entry_path() }]
) != ShardClean

test fn compile_clean_partition_boundary_matches_compile_clean_source_roots() -> Bool {
  witness_partition_entry_roots_are_witness_layer_roots()
    && witness_partition_pool_roots_are_compile_clean_source_roots()
}

test fn compile_clean_shard_verdict_compose_laws_hold() -> Bool {
  witness_compose_all_clean_is_clean()
    && witness_compose_any_failure_fails_closed()
    && witness_compose_associativity()
    && witness_reduce_projection_preserves_compose()
    && witness_empty_compose_is_unknown_reduce()
}

test fn compile_clean_shard_verdict_compose_RED_on_injected_failure() -> Bool {
  witness_compose_red_on_injected_failure
}

test fn compile_clean_shard_a_exemplar_compile_green() -> Bool {
  subject_evidence_establishes(evidence: run_shard_a_exemplar_compile(), licenses: fn(held) { held })
}

// A MISSING COMPILER IS A LOCATED INSTRUMENT REFUSAL, NEVER A SHARD VERDICT. Same receipt route as
// the green above, with a compiler that is not an enrolled release bin: the evidence must be the
// EvidenceInstrumentRefused arm naming that bin and WitnessBinNotEnrolled. Before the receipt was
// typed, this state and an unclean module answered the same false.
test fn compile_clean_shard_a_unready_compiler_surfaces_its_refusal() -> Bool {
  match run_shard_a_exemplar_compile_with_unenrolled_compiler() {
    EvidenceInstrumentRefused { cause: refusal } =>
      refusal.bin_name == "no_such_witness_bin_zzz" && refusal.reason == WitnessBinNotEnrolled
    EvidenceSubjectUnreached { cause: _ } => false
    EvidenceSubjectCompleted { outcome: _ } => false
  }
}
