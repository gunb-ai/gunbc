module test.claim.world_converge_witness

import std.types { String, Bool, List }
import gunbc.world_converge {
  WorldObservation, WorldObserved, WorldUnobservable,
  WorldDifference, WorldDiverged, WorldInAgreement,
  WorldActuation, WorldActuationRefused,
  WorldConvergenceHandler,
  WorldNotConverged, WorldConverged,
  world_converge,
}

type FixtureSubject { key: String }
type FixtureObserved { value: String }
type FixtureDrift { field: String }
type FixtureApplied { field: String }
type FixtureRefusal = FixtureUnreadable | FixtureApplyShouldNotRun

fn fixture_observe(_: FixtureSubject, readable: Bool) -> WorldObservation<FixtureObserved, FixtureRefusal> {
  if readable {
    WorldObserved { value: FixtureObserved { value: "observed" } }
  } else {
    WorldUnobservable { cause: FixtureUnreadable }
  }
}

fn fixture_differences(_: FixtureSubject, agreed: Bool, _: FixtureObserved) -> WorldDifference<FixtureDrift> {
  if agreed {
    WorldInAgreement
  } else {
    WorldDiverged { differences: [FixtureDrift { field: "enforcement" }] }
  }
}

fn fixture_apply(_: FixtureSubject, _: Bool, _: FixtureObserved, _: List<FixtureDrift>) -> WorldActuation<FixtureApplied, FixtureRefusal> {
  WorldActuationRefused { cause: FixtureApplyShouldNotRun }
}

fn fixture_unchanged(_: FixtureSubject, _: Bool, _: FixtureObserved) -> FixtureApplied {
  FixtureApplied { field: "unchanged" }
}

type FixtureWorldHandler = WorldConvergenceHandler<FixtureSubject, Bool, FixtureObserved, FixtureDrift, FixtureApplied, FixtureRefusal>

data fixture_world_handler: FixtureWorldHandler = WorldConvergenceHandler {
  observe: fixture_observe,
  differences: fixture_differences,
  apply: fixture_apply,
  unchanged_receipt: fixture_unchanged,
}

// Discriminating RED: the apply handler deliberately carries a different refusal. If the generic
// root computes differences or actuation before guarding observation, this answers the wrong arm.
test fn unreadable_subject_refuses_the_run_before_apply() -> Bool {
  match world_converge(
    subject: FixtureSubject { key: "fixture" },
    context: false,
    handler: fixture_world_handler,
  ) {
    WorldNotConverged { subject: _, refusal: FixtureUnreadable } => true
    _ => false
  }
}

// The positive control the refusal claim is measured against: the same root, the same handler, a
// readable subject in agreement. Without it the RED above is satisfiable by a root that refuses
// everything.
test fn agreeing_subject_converges_on_the_unchanged_receipt() -> Bool {
  match world_converge(
    subject: FixtureSubject { key: "fixture" },
    context: true,
    handler: fixture_world_handler,
  ) {
    WorldConverged { subject: _, observed: _, receipt: r } => r.field == "unchanged"
    _ => false
  }
}
