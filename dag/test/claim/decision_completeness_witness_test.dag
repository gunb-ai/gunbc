fn standing_settled(s: DecisionStanding) -> Bool {
  match accept_settled_policy(standing: s) {
    SettledPolicyAccepted { policy: _ } => true
    SettledPolicyRejectedDeferred { obligations: _, reopen_trigger: _ } => false
    SettledPolicyRejectedRefused { cause: _ } => false
  }
}

fn standing_deferred(s: DecisionStanding) -> Bool {
  match accept_settled_policy(standing: s) {
    SettledPolicyRejectedDeferred { obligations: _, reopen_trigger: _ } => true
    SettledPolicyAccepted { policy: _ } => false
    SettledPolicyRejectedRefused { cause: _ } => false
  }
}

fn standing_refused(s: DecisionStanding) -> Bool {
  match accept_settled_policy(standing: s) {
    SettledPolicyRejectedRefused { cause: _ } => true
    SettledPolicyAccepted { policy: _ } => false
    SettledPolicyRejectedDeferred { obligations: _, reopen_trigger: _ } => false
  }
}

// SYNTHETIC CLOSED SUBJECT — positive control and discriminating reds. Required populations are
// named data rows (authorities). Disposition lists are built per test and never used as the
// required-population oracle.

data id_var_a: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "var_a")
data id_var_b: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "var_b")
data id_term_power: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "term_power")
data id_term_throughput: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "term_throughput")
data id_constraint: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "constraint_budget")
data id_param: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "param_workload")
data id_objective: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "objective_capacity")
data id_domain: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "choice_domain")
data id_subject: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "subject")
data id_region: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "region_r")
data id_candidate: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "id_candidate")
data id_foreign_term: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "id_foreign_term")
data id_order_auth: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "id_order_auth")

data var_a: DecisionVariable = DecisionVariable { identity: id_var_a }
data var_b: DecisionVariable = DecisionVariable { identity: id_var_b }

data fixture_physical_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "fixture.invalid/physical-model/completeness" },
}

data term_power: ObjectiveTerm = ObjectiveTerm {
  identity: id_term_power,
  ground: CeilingCitedToAuthority { authority: fixture_physical_authority },
}
data term_throughput: ObjectiveTerm = ObjectiveTerm {
  identity: id_term_throughput,
  ground: CeilingCitedToAuthority { authority: fixture_physical_authority },
}
data constraint_budget: DecisionConstraint = DecisionConstraint { identity: id_constraint }
data param_workload: ContextParameter = ContextParameter { identity: id_param }
data region_r: DecisionRegion = DecisionRegion { identity: id_region }

data objective_capacity: ObjectiveMeasure = ObjectiveMeasure {
  identity: id_objective,
  goal: HigherIsBetter,
  terms: [term_throughput, term_power],
}

data choice_domain: ChoiceDomain = ChoiceDomain {
  identity: id_domain,
  variables: [var_a, var_b],
}

data subject: DecisionSubject = DecisionSubject {
  identity: id_subject,
  question: "synthetic decision completeness control" as NonEmptyStr,
  parameters: [param_workload],
  constraints: [constraint_budget],
  objective: objective_capacity,
  choice_domain: choice_domain,
}

data fixture_physical: PhysicalModelPopulation = PhysicalModelEstablished {
  terms: [id_term_throughput, id_term_power],
}

data id_coupling_receipt: DeclarationRef = decl_ref(
  module_path: "test.claim.decision_completeness_witness",
  decl_name: "id_coupling_receipt",
)

data id_term_fan: DeclarationRef = decl_ref(module_path: "test.claim.decision_completeness_witness", decl_name: "id_term_fan")

data fixture_causal: CausalModelPopulation = CausalModelEstablished {
  couplings: [
    FleetObservedCoupling { receipt: id_coupling_receipt, term: id_term_throughput, variable: id_var_a, subject: id_subject },
    FleetObservedCoupling { receipt: id_coupling_receipt, term: id_term_throughput, variable: id_var_b, subject: id_subject },
    FleetObservedCoupling { receipt: id_coupling_receipt, term: id_term_power, variable: id_var_a, subject: id_subject },
    FleetObservedCoupling { receipt: id_coupling_receipt, term: id_term_power, variable: id_var_b, subject: id_subject },
  ],
}

// Required cells come from the subject authorities (2 terms × 2 variables), not from dispositions.
test fn required_cells_are_the_cartesian_product_of_term_and_variable_authorities() -> Bool {
  let required = required_sensitivity_cells(subject: subject)
  (required |> count) == 4
    && any(required, c => declaration_ref_eq(a: c.term, b: id_term_power) && declaration_ref_eq(a: c.variable, b: id_var_a))
    && any(required, c => declaration_ref_eq(a: c.term, b: id_term_power) && declaration_ref_eq(a: c.variable, b: id_var_b))
    && any(required, c => declaration_ref_eq(a: c.term, b: id_term_throughput) && declaration_ref_eq(a: c.variable, b: id_var_a))
    && any(required, c => declaration_ref_eq(a: c.term, b: id_term_throughput) && declaration_ref_eq(a: c.variable, b: id_var_b))
}

fn closed_sensitivities() -> List<ObjectiveTermSensitivity> {
  [
    InvariantAlong {
      term: id_term_power,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_power,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_a,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ]
}

fn closed_constraints() -> List<ConstraintDisposition> {
  [
    ConstraintSatisfied {
      constraint: id_constraint,
      evidence: "fixture budget satisfied" as NonEmptyStr,
    },
  ]
}

fn closed_parameters() -> List<ParameterDisposition> {
  [
    ParameterBound {
      parameter: id_param,
      evidence: "fixture workload bound" as NonEmptyStr,
    },
  ]
}

fn settled_assessment() -> DecisionAssessment {
  DecisionAssessment {
    subject: subject,
    sensitivities: closed_sensitivities(),
    constraints: closed_constraints(),
    parameters: closed_parameters(),
    selected_candidate: Present { value: id_candidate },
    term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
  }
}

test fn positive_control_closed_subject_mints_settled() -> Bool {
  match mint_settled_policy(assessment: settled_assessment()) {
    Settled { policy: p } =>
      declaration_ref_eq(a: p.subject, b: id_subject)
        && declaration_ref_eq(a: p.selected_candidate, b: id_candidate)
    Deferred { obligations: _, reopen_trigger: _ } => false
    DecisionRefused { cause: _ } => false
  }
}

test fn consumer_accepts_settled_and_rejects_deferred() -> Bool {
  let settled = mint_settled_policy(assessment: settled_assessment())
  let deferred_assessment = DecisionAssessment {
    subject: subject,
    sensitivities: [
      SensitivityUnestablished {
        term: id_term_power,
        variable: id_var_a,
        obligation: "need measurement" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_power,
        variable: id_var_b,
        obligation: "need measurement" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_throughput,
        variable: id_var_a,
        obligation: "need measurement" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_throughput,
        variable: id_var_b,
        obligation: "need measurement" as NonEmptyStr,
      },
    ],
    constraints: closed_constraints(),
    parameters: closed_parameters(),
    selected_candidate: Present { value: id_candidate },
    term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
  }
  let deferred = mint_settled_policy(assessment: deferred_assessment)
  match accept_settled_policy(standing: settled) {
    SettledPolicyAccepted { policy: _ } =>
      match accept_settled_policy(standing: deferred) {
        SettledPolicyRejectedDeferred { obligations: o, reopen_trigger: _ } => (o |> count) > 0
        SettledPolicyAccepted { policy: _ } => false
        SettledPolicyRejectedRefused { cause: _ } => false
      }
    SettledPolicyRejectedDeferred { obligations: _, reopen_trigger: _ } => false
    SettledPolicyRejectedRefused { cause: _ } => false
  }
}

// Shrink the choice-domain authority: leftover sensitivity cells for the dropped variable are foreign.
test fn shrinking_choice_domain_makes_extra_cells_foreign() -> Bool {
  let truncated_domain: ChoiceDomain = ChoiceDomain {
    identity: id_domain,
    variables: [var_a],
  }
  let truncated: DecisionSubject = DecisionSubject {
    identity: id_subject,
    question: "truncated variables" as NonEmptyStr,
    parameters: [param_workload],
    constraints: [constraint_budget],
    objective: objective_capacity,
    choice_domain: truncated_domain,
  }
  match sensitivity_closure(subject: truncated, rows: closed_sensitivities()) {
    SensitivityClosureForeign { cells: cells } =>
      any(cells, c => declaration_ref_eq(a: c.variable, b: id_var_b))
        && standing_refused(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: truncated,
          sensitivities: closed_sensitivities(),
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [],
          physical_model: fixture_physical,
          causal_model: fixture_causal,
        }))
    SensitivityClosureComplete => false
    SensitivityClosureMissing { cells: _ } => false
    SensitivityClosureRepeatedObserved { cells: _ } => false
    SensitivityClosureRepeatedExpected { cells: _ } => false
  }
}

// Remove platform power from the assessment while it remains in the objective term population.
test fn omitting_objective_term_cell_makes_sensitivity_closure_missing() -> Bool {
  let without_power_cells = [
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_a,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ]
  match sensitivity_closure(subject: subject, rows: without_power_cells) {
    SensitivityClosureMissing { cells: cells } =>
      any(cells, c => declaration_ref_eq(a: c.term, b: id_term_power))
        && standing_refused(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: subject,
          sensitivities: without_power_cells,
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
        }))
    SensitivityClosureComplete => false
    SensitivityClosureForeign { cells: _ } => false
    SensitivityClosureRepeatedObserved { cells: _ } => false
    SensitivityClosureRepeatedExpected { cells: _ } => false
  }
}

// Carry platform power but omit its relation to one variable.
test fn omitting_one_required_sensitivity_cell_blocks_settlement() -> Bool {
  let missing_one = [
    InvariantAlong {
      term: id_term_power,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_a,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ]
  match sensitivity_closure(subject: subject, rows: missing_one) {
    SensitivityClosureMissing { cells: cells } =>
      any(cells, c =>
        declaration_ref_eq(a: c.term, b: id_term_power) && declaration_ref_eq(a: c.variable, b: id_var_b)
      )
        && !standing_settled(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: subject,
          sensitivities: missing_one,
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
        }))
    SensitivityClosureComplete => false
    SensitivityClosureForeign { cells: _ } => false
    SensitivityClosureRepeatedObserved { cells: _ } => false
    SensitivityClosureRepeatedExpected { cells: _ } => false
  }
}

test fn two_answers_for_one_cell_refuse_as_repeated_observed() -> Bool {
  let dup = concat(closed_sensitivities(), [
    InvariantAlong {
      term: id_term_power,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ])
  match sensitivity_closure(subject: subject, rows: dup) {
    SensitivityClosureRepeatedObserved { cells: cells } =>
      any(cells, c =>
        declaration_ref_eq(a: c.term, b: id_term_power) && declaration_ref_eq(a: c.variable, b: id_var_a)
      )
        && standing_refused(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: subject,
          sensitivities: dup,
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
        }))
    SensitivityClosureComplete => false
    SensitivityClosureMissing { cells: _ } => false
    SensitivityClosureForeign { cells: _ } => false
    SensitivityClosureRepeatedExpected { cells: _ } => false
  }
}

test fn foreign_term_or_variable_refuses_rather_than_ignored() -> Bool {
  let foreign = concat(closed_sensitivities(), [
    SensitivityUnestablished {
      term: id_foreign_term,
      variable: id_var_a,
      obligation: "foreign" as NonEmptyStr,
    },
  ])
  match sensitivity_closure(subject: subject, rows: foreign) {
    SensitivityClosureForeign { cells: cells } =>
      any(cells, c => declaration_ref_eq(a: c.term, b: id_foreign_term))
        && standing_refused(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: subject,
          sensitivities: foreign,
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
        }))
    SensitivityClosureComplete => false
    SensitivityClosureMissing { cells: _ } => false
    SensitivityClosureRepeatedObserved { cells: _ } => false
    SensitivityClosureRepeatedExpected { cells: _ } => false
  }
}

test fn overlapping_regions_yield_deferred_never_settled() -> Bool {
  let pending = DecisionAssessment {
    subject: subject,
    sensitivities: [
      SensitivityUnestablished {
        term: id_term_power,
        variable: id_var_a,
        obligation: "regions overlap; need sharper evidence" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_power,
        variable: id_var_b,
        obligation: "regions overlap; need sharper evidence" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_throughput,
        variable: id_var_a,
        obligation: "regions overlap; need sharper evidence" as NonEmptyStr,
      },
      SensitivityUnestablished {
        term: id_term_throughput,
        variable: id_var_b,
        obligation: "regions overlap; need sharper evidence" as NonEmptyStr,
      },
    ],
    constraints: closed_constraints(),
    parameters: closed_parameters(),
    selected_candidate: Present { value: id_candidate },
    term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
  }
  standing_deferred(s: mint_settled_policy(assessment: pending))
    && !standing_settled(s: mint_settled_policy(assessment: pending))
}

test fn scalar_method_without_order_preservation_refuses() -> Bool {
  match term_drop_standing(authority: OrderPreservationAbsent {
    dropped_term: id_term_power,
    obligation: "cannot drop platform power from a ratio objective without order-preservation authority" as NonEmptyStr,
  }) {
    TermDropRefused { cause: c } =>
      string_contains(s: c as String, pattern: "order-preservation")
        && standing_refused(s: mint_settled_policy(assessment: DecisionAssessment {
          subject: subject,
          sensitivities: closed_sensitivities(),
          constraints: closed_constraints(),
          parameters: closed_parameters(),
          selected_candidate: Present { value: id_candidate },
          term_drops: [
            OrderPreservationAbsent {
              dropped_term: id_term_power,
              obligation: "cannot drop platform power from a ratio objective without order-preservation authority" as NonEmptyStr,
            },
          ],
          physical_model: fixture_physical,
          causal_model: fixture_causal,
        }))
    TermDropAdmitted { authority: _ } => false
  }
}

test fn order_preservation_authority_admits_term_drop() -> Bool {
  match term_drop_standing(authority: OrderPreservationEstablished {
    authority: id_order_auth,
    dropped_term: id_term_power,
    evidence: "additive constant under pure minimization" as NonEmptyStr,
  }) {
    TermDropAdmitted { authority: a } => declaration_ref_eq(a: a, b: id_order_auth)
    TermDropRefused { cause: _ } => false
  }
}

test fn proved_tradeoff_is_incomparable_coarse_evidence_is_undecided() -> Bool {
  match candidate_comparison_standing(verdict: Incomparable) {
    CandidatesIncomparableTradeoff =>
      match candidate_comparison_standing(verdict: DominanceUndecided) {
        CandidatesUndecidedOnEvidence =>
          match candidate_comparison_standing(verdict: Dominates) {
            CandidatesComparable { verdict: v } =>
              match v {
                Dominates => true
                Dominated => false
                Equivalent => false
                Incomparable => false
                DominanceUndecided => false
              }
            CandidatesIncomparableTradeoff => false
            CandidatesUndecidedOnEvidence => false
            CandidateComparisonRefused { cause: _ } => false
          }
        CandidatesIncomparableTradeoff => false
        CandidatesComparable { verdict: _ } => false
        CandidateComparisonRefused { cause: _ } => false
      }
    CandidatesUndecidedOnEvidence => false
    CandidatesComparable { verdict: _ } => false
    CandidateComparisonRefused { cause: _ } => false
  }
}

test fn variable_irrelevance_is_derived_never_authored() -> Bool {
  let all_invariant_for_a = [
    InvariantAlong {
      term: id_term_power,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    InvariantAlong {
      term: id_term_throughput,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_power,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ]
  variable_irrelevance_is_derived(subject: subject, variable: id_var_a, rows: all_invariant_for_a)
    && !variable_irrelevance_is_derived(subject: subject, variable: id_var_b, rows: all_invariant_for_a)
    && !variable_irrelevance_is_derived(subject: subject, variable: id_var_a, rows: closed_sensitivities())
}

test fn fan_power_missing_from_throughput_per_wall_watt_is_objective_under_modeling() -> Bool {
  let physical = [id_term_throughput, id_term_power, id_term_fan]
  match term_set_join(terms: physical, objective: objective_capacity, subject: id_subject) {
    ObjectiveUnderModeled { subject: s, missing_from_objective: missing } =>
      declaration_ref_eq(a: s, b: id_subject)
        && any(missing, id => declaration_ref_eq(a: id, b: id_term_fan))
        && !any(missing, id => declaration_ref_eq(a: id, b: id_term_power))
    TermSetsJoinComplete => false
    ObjectiveDeclaresUnwarrantedTerms { subject: _, extras: _ } => false
  }
}

test fn objective_under_modeling_refuses_settlement() -> Bool {
  match mint_settled_policy(assessment: DecisionAssessment {
    subject: subject,
    sensitivities: closed_sensitivities(),
    constraints: closed_constraints(),
    parameters: closed_parameters(),
    selected_candidate: Present { value: id_candidate },
    term_drops: [],
    physical_model: PhysicalModelEstablished {
      terms: [id_term_throughput, id_term_power, id_term_fan],
    },
    causal_model: fixture_causal,
  }) {
    DecisionRefused { cause: c } =>
      match c {
        ObjectiveUnderModeledCause { missing_from_objective: missing } =>
          any(missing, id => declaration_ref_eq(a: id, b: id_term_fan))
        _ => false
      }
    Settled { policy: _ } => false
    Deferred { obligations: _, reopen_trigger: _ } => false
  }
}

test fn required_population_oracle_is_not_the_disposition_list() -> Bool {
  let required = required_sensitivity_cells(subject: subject)
  let dispositions = [
    SensitivityUnestablished {
      term: id_term_power,
      variable: id_var_a,
      obligation: "only one disposition authored" as NonEmptyStr,
    },
  ]
  (required |> count) == 4
    && (dispositions |> count) == 1
    && match sensitivity_closure(subject: subject, rows: dispositions) {
      SensitivityClosureMissing { cells: cells } => (cells |> count) == 3
      SensitivityClosureComplete => false
      SensitivityClosureForeign { cells: _ } => false
      SensitivityClosureRepeatedObserved { cells: _ } => false
      SensitivityClosureRepeatedExpected { cells: _ } => false
    }
}

test fn invariant_along_with_uncited_coupling_must_not_mint_settled() -> Bool {
  let uncited = [
    InvariantAlong {
      term: id_term_power,
      variable: id_var_a,
      region: region_r,
      coupling: CeilingTranscribedUncited {
        read_obligation: "uncited invariance is not a warrant; absence of a coupling edge is not proven invariance" as NonEmptyStr,
      },
    },
    VariesAlong {
      term: id_term_power,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_a,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
    VariesAlong {
      term: id_term_throughput,
      variable: id_var_b,
      region: region_r,
      relation: MonotoneDecreasing,
      coupling: CeilingCitedToAuthority { authority: fixture_physical_authority },
    },
  ]
  standing_deferred(s: mint_settled_policy(assessment: DecisionAssessment {
    subject: subject,
    sensitivities: uncited,
    constraints: closed_constraints(),
    parameters: closed_parameters(),
    selected_candidate: Present { value: id_candidate },
    term_drops: [],
    physical_model: fixture_physical,
    causal_model: fixture_causal,
  }))
    && !standing_settled(s: mint_settled_policy(assessment: DecisionAssessment {
      subject: subject,
      sensitivities: uncited,
      constraints: closed_constraints(),
      parameters: closed_parameters(),
      selected_candidate: Present { value: id_candidate },
      term_drops: [],
      physical_model: fixture_physical,
      causal_model: fixture_causal,
    }))
}

fn decision_completeness_witness_main() -> ProcessExit {
  if !required_cells_are_the_cartesian_product_of_term_and_variable_authorities() {
    ExitFailure { code: 1, reason: "fail: required_cells" as NonEmptyStr }
  } else if !positive_control_closed_subject_mints_settled() {
    ExitFailure { code: 1, reason: "fail: positive_control_settled" as NonEmptyStr }
  } else if !consumer_accepts_settled_and_rejects_deferred() {
    ExitFailure { code: 1, reason: "fail: consumer_wall" as NonEmptyStr }
  } else if !shrinking_choice_domain_makes_extra_cells_foreign() {
    ExitFailure { code: 1, reason: "fail: shrink_choice_domain" as NonEmptyStr }
  } else if !omitting_objective_term_cell_makes_sensitivity_closure_missing() {
    ExitFailure { code: 1, reason: "fail: omit_objective_term" as NonEmptyStr }
  } else if !omitting_one_required_sensitivity_cell_blocks_settlement() {
    ExitFailure { code: 1, reason: "fail: omit_one_cell" as NonEmptyStr }
  } else if !two_answers_for_one_cell_refuse_as_repeated_observed() {
    ExitFailure { code: 1, reason: "fail: repeated_observed" as NonEmptyStr }
  } else if !foreign_term_or_variable_refuses_rather_than_ignored() {
    ExitFailure { code: 1, reason: "fail: foreign" as NonEmptyStr }
  } else if !overlapping_regions_yield_deferred_never_settled() {
    ExitFailure { code: 1, reason: "fail: deferred_pending" as NonEmptyStr }
  } else if !scalar_method_without_order_preservation_refuses() {
    ExitFailure { code: 1, reason: "fail: scalar_no_order_preservation" as NonEmptyStr }
  } else if !order_preservation_authority_admits_term_drop() {
    ExitFailure { code: 1, reason: "fail: order_preservation_admits" as NonEmptyStr }
  } else if !proved_tradeoff_is_incomparable_coarse_evidence_is_undecided() {
    ExitFailure { code: 1, reason: "fail: incomparable_vs_undecided" as NonEmptyStr }
  } else if !variable_irrelevance_is_derived_never_authored() {
    ExitFailure { code: 1, reason: "fail: variable_irrelevance" as NonEmptyStr }
  } else if !fan_power_missing_from_throughput_per_wall_watt_is_objective_under_modeling() {
    ExitFailure { code: 1, reason: "fail: fan_under_modeling_join" as NonEmptyStr }
  } else if !objective_under_modeling_refuses_settlement() {
    ExitFailure { code: 1, reason: "fail: fan_under_modeling_refuses" as NonEmptyStr }
  } else if !required_population_oracle_is_not_the_disposition_list() {
    ExitFailure { code: 1, reason: "fail: oracle_not_disposition_list" as NonEmptyStr }
  } else if !invariant_along_with_uncited_coupling_must_not_mint_settled() {
    ExitFailure { code: 1, reason: "fail: uncited_invariant_not_settled" as NonEmptyStr }
  } else {
    ExitSuccess
  }
}
