module test.claim.claim_batch_exit_two_unobserved_witness

import std.types { Bool, String, FilePath, List }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.algebra { string_contains }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.git.inspect
import extdeps.gunbc
import extdeps.shell

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// WHY THIS IS WET. The property is what the `claim_batch` PROCESS does with a claim that returns
// `ProcessExit::ExitFailure` with code 2: the exit contract reads 2 as "no observation", so the
// line must say UNOBSERVED and the process must exit 2. Before this mapping the arm printed FAIL
// and exited 1 for every code, so a claim that observed nothing read as a subject that answered
// no (the fail-open this witness pins). The exit status is an external effect, so only a child
// process observes it.
//
// THE CLAIMS ARE PLANTED, NEVER COMMITTED: a committed `test fn` returning code 2 would be a
// standing red in every enumeration of the claim population. Each case is its own entry in a
// mktemp directory under target/, handed to the child as --source-root beside `dag` (a verdict
// needs `gunbc.output_policy`, which resolves only from there).
//
// The cases differ only in the ProcessExit the claim returns: code 2 (the RED), code 1 (a real
// refusal, which must stay FAIL/1 so the mapping is not "every ExitFailure is unobserved"), and
// ExitSuccess (the positive control, exit 0).

data exit_two_unobserved_entry_source: String = "module probe.exit_two_entry

import std.process { ProcessExit, ExitSuccess, ExitFailure }

test fn exit_two_entry_holds() -> ProcessExit {
  ExitFailure { code: 2, reason: \"subject never reached\" }
}
"

data exit_one_failed_entry_source: String = "module probe.exit_two_entry

import std.process { ProcessExit, ExitSuccess, ExitFailure }

test fn exit_two_entry_holds() -> ProcessExit {
  ExitFailure { code: 1, reason: \"subject answered no\" }
}
"

data exit_success_held_entry_source: String = "module probe.exit_two_entry

import std.process { ProcessExit, ExitSuccess, ExitFailure }

test fn exit_two_entry_holds() -> ProcessExit {
  ExitSuccess
}
"

type PlantedExitTwo
  = PlantedExitTwoReady { dir: String }
  | PlantedExitTwoUnwritable { detail: String }

fn plant_exit_two(root: String, entry_source: String) -> PlantedExitTwo {
  let dir = shell.Mktemp.DirWithTemplate(
    template: concat(root, "/target/exit-two-planted-XXXXXX") as FilePath,
  )
  if !dir.success {
    PlantedExitTwoUnwritable { detail: "mktemp under target/ failed" }
  } else {
    let d = dir.path as String
    let e = Filesystem.Write(path: concat(d, "/exit_two_entry.dag"), content: entry_source)
    if e.success {
      PlantedExitTwoReady { dir: d }
    } else {
      PlantedExitTwoUnwritable { detail: join(["fixture write failed: ", e.error], "") }
    }
  }
}

fn exit_two_args(dir: String) -> List<String> {
  [
    "--source-root", "dag",
    "--source-root", dir,
    "--entry", concat(dir, "/exit_two_entry.dag"),
    "--function", "exit_two_entry_holds"
  ]
}

// The RED. A code-2 ExitFailure is no observation: exit 2, an UNOBSERVED line carrying the
// claim's reason, and no FAIL line. At base this arm prints FAIL and exits 1.
test fn an_exit_failure_with_code_2_exits_2_and_prints_unobserved() -> Bool {
  let root = git.Inspect.Toplevel().path
  match plant_exit_two(root: root, entry_source: exit_two_unobserved_entry_source) {
    PlantedExitTwoUnwritable { detail: _ } => false
    PlantedExitTwoReady { dir } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root,
        bin_path: concat(root, "/target/release/claim_batch"),
        args: exit_two_args(dir: dir)
      )
      let cleaned = shell.Remove.RecursiveForce(path: dir as FilePath)
      cleaned.success
        && result.exit_code == 2
        && string_contains(s: result.stdout, pattern: "UNOBSERVED exit_two_entry_holds")
        && string_contains(s: result.stdout, pattern: "subject never reached")
        && !string_contains(s: result.stdout, pattern: "FAIL")
    }
  }
}

// The discriminating twin. A code-1 ExitFailure is a verdict that did not hold: FAIL and exit 1.
// Without it the RED is satisfiable by a binary that maps every ExitFailure to exit 2.
test fn an_exit_failure_with_code_1_still_exits_1_and_prints_fail() -> Bool {
  let root = git.Inspect.Toplevel().path
  match plant_exit_two(root: root, entry_source: exit_one_failed_entry_source) {
    PlantedExitTwoUnwritable { detail: _ } => false
    PlantedExitTwoReady { dir } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root,
        bin_path: concat(root, "/target/release/claim_batch"),
        args: exit_two_args(dir: dir)
      )
      let cleaned = shell.Remove.RecursiveForce(path: dir as FilePath)
      cleaned.success
        && result.exit_code == 1
        && string_contains(s: result.stdout, pattern: "FAIL exit_two_entry_holds")
        && !string_contains(s: result.stdout, pattern: "UNOBSERVED")
    }
  }
}

// The positive control. A held claim exits 0 with PASS, so the two arms above are not satisfiable
// by a binary that refuses every entry.
test fn a_held_claim_exits_0_and_prints_pass() -> Bool {
  let root = git.Inspect.Toplevel().path
  match plant_exit_two(root: root, entry_source: exit_success_held_entry_source) {
    PlantedExitTwoUnwritable { detail: _ } => false
    PlantedExitTwoReady { dir } => {
      let result = gunbc.WitnessBin.Run(
        workdir: root,
        bin_path: concat(root, "/target/release/claim_batch"),
        args: exit_two_args(dir: dir)
      )
      let cleaned = shell.Remove.RecursiveForce(path: dir as FilePath)
      cleaned.success
        && result.exit_code == 0
        && string_contains(s: result.stdout, pattern: "PASS exit_two_entry_holds")
    }
  }
}
