module test.claim.compute_fabric_resource_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn compute_fabric_connector_model_holds() -> Bool {
  product.compute_fabric.witness_need_is_only_fabric_plus_program()
    && product.compute_fabric.witness_shape_is_derived_from_program()
    && product.compute_fabric.witness_fabric_binds_need_to_opportunity()
    && product.compute_fabric.witness_exec_and_ci_are_just_programs()
    && product.compute_fabric.witness_hard_requirement_unmet_is_unmet()
}

test fn ci_floor_run_demand_envelope_model_holds() -> Bool {
  gunbc.fleet_container.witness_run_demand_envelope_fits_budget()
    && gunbc.fleet_container.witness_high_demand_shrinks_envelope_and_fits()
    && gunbc.fleet_container.witness_fail_open_memory_blind_demand_exceeds_budget()
    && gunbc.fleet_container.witness_unreadable_budget_uses_conservative_demand()
}
