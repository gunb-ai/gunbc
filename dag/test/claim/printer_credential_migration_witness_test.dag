module test.claim.printer_credential_migration_witness

import std.types { Bool, NonEmptyStr }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.cloud.gcp.secret_ref { SecretRef, HashPending }
import gunbc.fleet.printer_credential_migration {
  classify_migration_authorization, MigrationAuthorized, MigrationUnauthorized,
  MigrationAuthorizationNamesAnotherSecret,
  ContainerDeleted, ContainerDeletionRefused, ContainerDeletionOutcomeUnknown,
  deletion_may_be_replayed,
  PostDeletionAbsent, PostDeletionStillPresent, PostDeletionUnobserved,
  absence_is_established,
  classify_deletion_subject, DeletionSubjectObserved, DeletionSubjectNamesAnotherResource,
  DeletionSubjectHasNoEtag, DeletionSubjectUnobserved,
}

data printer_02_desired: SecretRef = SecretRef {
  project: "gunbai-secrets" as GcpProjectId,
  secret: "printer-02-lan-access-code" as NonEmptyStr,
  version: "pending" as NonEmptyStr,
  hash_state: HashPending,
}

// THE DEFAULT IS UNAUTHORIZED, which is the row that keeps a crashed run from escalating itself.
// A process that minted a verification and died before delivery restarts into a remote state
// indistinguishable from an out-of-band container; if absence of authorization did not refuse, that
// crash would license an irreversible delete of a working credential.
fn no_authorization_means_no_deletion() -> Bool {
  match classify_migration_authorization(supplied: "", desired: printer_02_desired) {
    MigrationUnauthorized => true
    MigrationAuthorized { authorization: _ } => false
    MigrationAuthorizationNamesAnotherSecret { supplied: _, resolved: _ } => false
  }
}

// AUTHORIZING ONE SECRET DOES NOT AUTHORIZE ITS NEIGHBOUR. This is the discriminating row: an
// operator who approved destroying printer-02's container has not approved destroying printer-01's,
// and a boolean flag could not tell the difference.
fn an_authorization_for_another_secret_does_not_license_this_one() -> Bool {
  match classify_migration_authorization(
    supplied: "projects/gunbai-secrets/secrets/printer-01-lan-access-code",
    desired: printer_02_desired
  ) {
    MigrationAuthorizationNamesAnotherSecret { supplied: _, resolved: _ } => true
    MigrationAuthorized { authorization: _ } => false
    MigrationUnauthorized => false
  }
}

fn the_exact_resolved_resource_is_authorized() -> Bool {
  match classify_migration_authorization(
    supplied: "projects/gunbai-secrets/secrets/printer-02-lan-access-code",
    desired: printer_02_desired
  ) {
    MigrationAuthorized { authorization: _ } => true
    MigrationUnauthorized => false
    MigrationAuthorizationNamesAnotherSecret { supplied: _, resolved: _ } => false
  }
}

// NO DELETION OUTCOME MAY BE REPLAYED, INCLUDING THE UNKNOWN ONE. Deletion is addressed by NAME, so
// a replay after a lost answer can destroy a same-name container this run never observed. This row
// is deliberately universal rather than checking only the unknown arm.
fn no_deletion_outcome_authorizes_a_second_delete() -> Bool {
  deletion_may_be_replayed(o: ContainerDeleted) == false
    && deletion_may_be_replayed(o: ContainerDeletionRefused { cause: "denied" as NonEmptyStr }) == false
    && deletion_may_be_replayed(o: ContainerDeletionOutcomeUnknown { cause: "no answer" as NonEmptyStr }) == false
}

// ONLY A READ ESTABLISHES ABSENCE. A successful DELETE is not the oracle, because everything except
// add-version then access-that-exact-version is eventually consistent.
fn only_an_observed_absence_lets_creation_proceed() -> Bool {
  absence_is_established(o: PostDeletionAbsent)
    && absence_is_established(o: PostDeletionStillPresent { resource: "projects/p/secrets/s" }) == false
    && absence_is_established(o: PostDeletionUnobserved { cause: "403" as NonEmptyStr }) == false
}

// A MISSING ETAG MUST REFUSE, NOT DEGRADE TO AN UNFENCED DELETE. This is the discriminating row for
// the absorbing-fallback arm: the tempting behaviour is "no etag, so just delete by name", which
// converts an inability to fence into permission to proceed unfenced, precisely when the service
// said something unexpected.
fn a_secret_without_an_etag_cannot_be_deleted() -> Bool {
  match classify_deletion_subject(
    returned_resource: "projects/gunbai-secrets/secrets/printer-02-lan-access-code",
    returned_etag: "",
    expected_resource: "projects/gunbai-secrets/secrets/printer-02-lan-access-code"
  ) {
    DeletionSubjectHasNoEtag { resource: _ } => true
    DeletionSubjectObserved { observed: _ } => false
    DeletionSubjectNamesAnotherResource { returned: _, expected: _ } => false
    DeletionSubjectUnobserved { cause: _ } => false
  }
}

// AN ANSWER ABOUT A DIFFERENT RESOURCE MINTS NO DELETION CAPABILITY, or the capability would
// authorize destroying the object the service talked about rather than the one that was authorized.
fn an_observation_of_another_resource_mints_no_deletion_capability() -> Bool {
  match classify_deletion_subject(
    returned_resource: "projects/gunbai-secrets/secrets/printer-01-lan-access-code",
    returned_etag: "abc123",
    expected_resource: "projects/gunbai-secrets/secrets/printer-02-lan-access-code"
  ) {
    DeletionSubjectNamesAnotherResource { returned: _, expected: _ } => true
    DeletionSubjectObserved { observed: _ } => false
    DeletionSubjectHasNoEtag { resource: _ } => false
    DeletionSubjectUnobserved { cause: _ } => false
  }
}

fn the_observed_generation_mints_a_fenced_deletion_capability() -> Bool {
  match classify_deletion_subject(
    returned_resource: "projects/gunbai-secrets/secrets/printer-02-lan-access-code",
    returned_etag: "abc123",
    expected_resource: "projects/gunbai-secrets/secrets/printer-02-lan-access-code"
  ) {
    DeletionSubjectObserved { observed: _ } => true
    DeletionSubjectNamesAnotherResource { returned: _, expected: _ } => false
    DeletionSubjectHasNoEtag { resource: _ } => false
    DeletionSubjectUnobserved { cause: _ } => false
  }
}
