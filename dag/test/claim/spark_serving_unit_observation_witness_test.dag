module test.claim.spark_serving_unit_observation_witness_test

import std.types { Bool, String, NonEmptyStr }
import gunbc.spark_serving_observed_members {
  SparkServingUnitManagerState,
  UserUnitManagerEnabled,
  UserUnitManagerDisabled,
  UserUnitManagerNotRegistered,
  UserUnitManagerUnobserved,
  SparkServingObservedUnitState,
  UserUnitStateObserved,
  UserUnitStateAbsent,
  UserUnitStateUnobserved,
  classify_observed_user_unit,
  spark_serving_user_unit_read_argv,
  spark_serving_user_unit_is_enabled_argv,
  spark_serving_unit_state_was_observed,
}
import gunbc.spark_serving_membership { spark_serving_user_unit_state_digest }
import gunbc.spark_serving_unit_render { spark_serving_user_unit_content_identity }
import gunbc.spark_serving_unit_render { spark_serving_desired_user_unit_text }
import gunbc.spark_serving_install_paths { spark_serving_user_unit_path }

fn digest_of(state: SparkServingObservedUnitState) -> String {
  match state {
    UserUnitStateObserved { unit_state_digest: d } => d as String
    UserUnitStateAbsent => "<absent>"
    UserUnitStateUnobserved => "<unobserved>"
  }
}

// ── Converged: the file on disk IS the desired spec ─────────────────────────────────────────────

// A unit whose bytes equal the rendering carries the SAME digest as the desired member, so the
// reconcile sees no change. This is what finally lets a second plan be empty.
//
// The digest is not COPIED from the desired state -- what was measured is a byte equality, which is
// a real observation of the file. Equal bytes are what establish that the address holds the spec.
test fn a_unit_matching_the_rendering_observes_the_desired_digest() -> Bool {
  digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: spark_serving_desired_user_unit_text(),
      file_absent: false,
    ),
  ) == (spark_serving_user_unit_state_digest() as String)
}

// ── Drifted: present, but not what was asked for ────────────────────────────────────────────────

// THE KEYSTONE. A unit file that exists but differs must NOT observe the desired digest, or a
// drifted host would report converged forever and the member would be unable to detect the one
// thing it exists to detect. The two digests must be distinct constants, not merely "some digest".
test fn a_drifted_unit_does_not_observe_the_desired_digest() -> Bool {
  digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: "[Unit]\nDescription=something else\n",
      file_absent: false,
    ),
  ) != (spark_serving_user_unit_state_digest() as String)
}

// A drifted unit is still OBSERVED -- we read it and know what it holds. Rendering drift as
// unobserved would lose the fact that we successfully looked.
test fn a_drifted_unit_is_still_observed() -> Bool {
  spark_serving_unit_state_was_observed(
    unit: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: "[Unit]\nDescription=something else\n",
      file_absent: false,
    ),
  )
}

// Whitespace is not a free pass: a byte difference is a difference. The convergence comparison is
// exact, so a trailing-newline change is drift, which is the same reason the renderer's trailing
// newline is load-bearing.
test fn a_unit_differing_only_in_its_trailing_newline_is_drift() -> Bool {
  digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: "[Unit]\nDescription=x",
      file_absent: false,
    ),
  ) != (spark_serving_user_unit_state_digest() as String)
}

// ── Absent is not unobserved, and a failed read is not absence ──────────────────────────────────

// `cat` exits non-zero both when the file is missing and when it cannot be read, and only the first
// means the member is absent. The remedies differ -- write the unit, versus fix why it is unreadable
// -- so a failed read that did not establish absence stays unobserved.
test fn a_failed_read_that_did_not_establish_absence_stays_unobserved() -> Bool {
  match classify_observed_user_unit(read_succeeded: false, read_stdout: "", file_absent: false) {
    UserUnitStateUnobserved => true
    UserUnitStateAbsent => false
    UserUnitStateObserved { unit_state_digest: _ } => false
  }
}

test fn a_read_that_established_absence_observes_absence() -> Bool {
  match classify_observed_user_unit(read_succeeded: false, read_stdout: "", file_absent: true) {
    UserUnitStateAbsent => true
    UserUnitStateUnobserved => false
    UserUnitStateObserved { unit_state_digest: _ } => false
  }
}

// The two failure arms must not collapse: this asserts they are DIFFERENT, which is the property a
// single "not found" arm would silently destroy.
test fn a_failed_read_and_an_established_absence_are_different_states() -> Bool {
  digest_of(state: classify_observed_user_unit(read_succeeded: false, read_stdout: "", file_absent: false))
    != digest_of(state: classify_observed_user_unit(read_succeeded: false, read_stdout: "", file_absent: true))
}

// An empty successful read is NOT absence either -- an empty file is a file, and it is drift.
test fn an_empty_successful_read_is_drift_not_absence() -> Bool {
  match classify_observed_user_unit(read_succeeded: true, read_stdout: "", file_absent: false) {
    UserUnitStateObserved { unit_state_digest: _ } => true
    UserUnitStateAbsent => false
    UserUnitStateUnobserved => false
  }
}

// ── The probes read what they claim to read ─────────────────────────────────────────────────────

test fn the_unit_read_probe_reads_the_modeled_unit_path() -> Bool {
  spark_serving_user_unit_read_argv()
    == ["cat", spark_serving_user_unit_path() as String]
}

// `is-enabled` is the INSTALL state, a different question from is-active. It is asked of the USER
// manager, because this is a user unit and a system-manager query would answer about a different
// unit namespace entirely.
test fn the_enabled_probe_asks_the_user_manager() -> Bool {
  spark_serving_user_unit_is_enabled_argv()
    == ["systemctl", "--user", "is-enabled", "gunbc-spark-serving.service"]
}

// ── The three defects this closes ───────────────────────────────────────────────────────────────

// ONE IDENTITY DOMAIN. The observed identity is the identity of the bytes read, on every arm. An
// earlier revision returned the DESIRED spec's digest when bytes matched, so the same file on disk
// changed identity whenever desired state changed, and the equality arm imported the answer it was
// meant to establish. Asserted by construction: the matching case equals the identity taken over the
// rendered text independently, not a value the classifier chose.
test fn the_observed_identity_is_taken_over_bytes_on_both_sides() -> Bool {
  digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: spark_serving_desired_user_unit_text(),
      file_absent: false,
    ),
  ) == (spark_serving_user_unit_content_identity(bytes: spark_serving_desired_user_unit_text()) as String)
}

// AN EMPTY FILE IS DRIFT, not an impossible state. The identity is taken over `String`, so `""` needs
// no cast to `NonEmptyStr` -- an earlier revision forced one, which was a lie about what was read.
test fn an_empty_file_gets_a_real_identity_rather_than_a_cast() -> Bool {
  let e = digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true, read_stdout: "", file_absent: false,
    ),
  )
  e != "<absent>" && e != "<unobserved>"
    && e != (spark_serving_user_unit_state_digest() as String)
}

// ENABLEMENT IS PART OF THE STATE. A unit with exactly the right bytes that is DISABLED will not
// RETIRED AND REPLACED, with its receipt. This asserted that exact bytes which are disabled produce
// a DIFFERENT content digest than desired -- true only under the `disabled:` prefix encoding, which
// folded enablement into the content identity and thereby planned a file rewrite to fix an
// enablement. The claim it was protecting is real and survives: a disabled unit is not converged.
// It now lands where it belongs, on the enablement member, and the content claim inverts.
test fn exact_bytes_that_are_disabled_still_match_the_desired_content() -> Bool {
  digest_of(
    state: classify_observed_user_unit(
      read_succeeded: true,
      read_stdout: spark_serving_desired_user_unit_text(),
      file_absent: false,
    ),
  ) == (spark_serving_user_unit_state_digest() as String)
}

// An unregistered unit is distinct from a disabled one: different remedies, different states. That
// is now a claim about the ENABLEMENT classifier, since the content identity no longer carries it.
test fn a_not_found_enablement_is_distinct_from_disabled() -> Bool {
  spark_serving_user_unit_not_registered_state != spark_serving_user_unit_disabled_state
    && spark_serving_user_unit_disabled_state != spark_serving_user_unit_enabled_state
}

// THIS TEST ASSERTED THE DEFECT, and is retired with its receipt rather than left standing.
//
// It required that an unobserved enablement leave the UNIT unobserved -- which is exactly the
// coupling that let a failed enablement probe erase a successfully read file. A test whose only
// subject is behavior the model now rejects is how obsolete behavior grants itself immortality.
//
// The successor claim is the opposite, and it is the one that had to be true all along: the read
// succeeded, so the content is established, and the enablement's failure scopes to the enablement.
test fn an_unobserved_enablement_leaves_the_read_content_observed() -> Bool {
  match classify_observed_user_unit(
    read_succeeded: true,
    read_stdout: spark_serving_desired_user_unit_text(),
    file_absent: false,
  ) {
    UserUnitStateObserved { unit_state_digest: d } =>
      (d as String) == (spark_serving_user_unit_state_digest() as String)
    UserUnitStateUnobserved => false
    UserUnitStateAbsent => false
  }
}
