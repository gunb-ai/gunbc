module test.claim.machine_width_range_witness

import std.logic { Bool }
import std.types { Int, List }
import std.measure { bit_width }
import std.integer { Signed, Unsigned }
import std.machine_width_range { machine_width_admits, machine_width_reading, MachineWidthReading, MachineWidthTypeArgument, NotWidthConstrained, WidthReadable, WidthUnreadable, WidthComposeMalformed, WidthNotStatic, WidthCarrierSignednessUndeclared }
import std.optional { Absent, Present }
import std.decl_ref { decl_ref }

// THE ONE RANGE AUTHORITY, EXERCISED AT ITS EDGES. std.machine_width_range machine_width_admits is read
// by v2.compiler.infer (literal admission) and by std.machine_word word_of_int, so a wrong edge here is a
// wrong edge in both; each claim pins a value just inside and just outside a boundary, in both
// directions, so an off-by-one on either side reds exactly one of the pair.
// This lives apart from test.claim.machine_word_witness because that file must not import std.integer
// (it rebinds bare Int there).
test fn unsigned_eight_admits_zero_through_255_and_nothing_beside() -> Bool {
  machine_width_admits(signedness: Unsigned, bits: bit_width(count: 8), value: 0)
    && machine_width_admits(signedness: Unsigned, bits: bit_width(count: 8), value: 255)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 8), value: 256)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 8), value: 300)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 8), value: 0 - 1)
}

test fn signed_eight_admits_minus_128_through_127_and_nothing_beside() -> Bool {
  machine_width_admits(signedness: Signed, bits: bit_width(count: 8), value: 0 - 128)
    && machine_width_admits(signedness: Signed, bits: bit_width(count: 8), value: 127)
    && !machine_width_admits(signedness: Signed, bits: bit_width(count: 8), value: 128)
    && !machine_width_admits(signedness: Signed, bits: bit_width(count: 8), value: 0 - 129)
}

// WIDTH ZERO: unsigned is the range {0}; signed is empty. Whether zero is a valid machine width is the
// declaration's question (std.machine_word's WordWidth has no zero member), not this function's.
test fn width_zero_admits_exactly_zero_unsigned_and_nothing_signed() -> Bool {
  machine_width_admits(signedness: Unsigned, bits: bit_width(count: 0), value: 0)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 0), value: 1)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 0), value: 0 - 1)
    && !machine_width_admits(signedness: Signed, bits: bit_width(count: 0), value: 0)
}

// A width at or past the host Int admits every host value of the right sign, because no host Int can
// lie outside it; the unsigned boundary is 63 (2^63 is not a host Int), the signed one is 64.
test fn a_width_at_the_host_bound_admits_every_host_value_of_its_sign() -> Bool {
  machine_width_admits(signedness: Unsigned, bits: bit_width(count: 64), value: 9223372036854775807)
    && !machine_width_admits(signedness: Unsigned, bits: bit_width(count: 64), value: 0 - 1)
    && machine_width_admits(signedness: Signed, bits: bit_width(count: 64), value: 0 - 9223372036854775807)
    && machine_width_admits(signedness: Unsigned, bits: bit_width(count: 63), value: 9223372036854775807)
}

// THE ONE WIDTH READING (machine_width_reading), on parts a compiler extracts. Each refusal has a readable
// twin of the same Compose shape: an unsigned and a signed width read; a named width, an undeclared carrier
// and a one-argument Compose each refuse with their own cause; a type that names no width is not
// width-constrained, so ordinary grounding decides it.
fn mwr_compose() -> MachineWidthTypeArgument { MachineWidthTypeArgument { head: Present { value: decl_ref(module_path: "std.machine_constraints", decl_name: "Compose") }, is_kernel_int: false, sole_literal_argument: Absent } }
fn mwr_nat() -> MachineWidthTypeArgument { MachineWidthTypeArgument { head: Present { value: decl_ref(module_path: "std.nat", decl_name: "Nat") }, is_kernel_int: false, sole_literal_argument: Absent } }
fn mwr_kernel_int() -> MachineWidthTypeArgument { MachineWidthTypeArgument { head: Absent, is_kernel_int: true, sole_literal_argument: Absent } }
fn mwr_width(bits: Int) -> MachineWidthTypeArgument { MachineWidthTypeArgument { head: Present { value: decl_ref(module_path: "std.machine_constraints", decl_name: "MachineWidth") }, is_kernel_int: false, sole_literal_argument: Present { value: bit_width(count: bits) } } }
fn mwr_named_width() -> MachineWidthTypeArgument { MachineWidthTypeArgument { head: Present { value: decl_ref(module_path: "std.machine_constraints", decl_name: "MachineWidth") }, is_kernel_int: false, sole_literal_argument: Absent } }

fn mwr_read(arguments: List<MachineWidthTypeArgument>) -> MachineWidthReading {
  machine_width_reading(head: mwr_compose().head, arguments: arguments)
}

fn mwr_is_readable(r: MachineWidthReading, signed: Bool, bits: Int) -> Bool {
  match r {
    WidthReadable { signedness: Signed, bits: b } => signed && b == bit_width(count: bits)
    WidthReadable { signedness: Unsigned, bits: b } => !signed && b == bit_width(count: bits)
    WidthUnreadable { cause: _ } => false
    NotWidthConstrained => false
  }
}

test fn the_reading_reads_an_unsigned_and_a_signed_width() -> Bool {
  mwr_is_readable(r: mwr_read(arguments: [mwr_nat(), mwr_width(bits: 8)]), signed: false, bits: 8)
    && mwr_is_readable(r: mwr_read(arguments: [mwr_kernel_int(), mwr_width(bits: 128)]), signed: true, bits: 128)
}

test fn a_named_width_refuses_as_not_static() -> Bool {
  match mwr_read(arguments: [mwr_nat(), mwr_named_width()]) {
    WidthUnreadable { cause: WidthNotStatic } => true
    WidthUnreadable { cause: _ } => false
    WidthReadable { signedness: _, bits: _ } => false
    NotWidthConstrained => false
  }
}

test fn a_carrier_of_undeclared_signedness_refuses() -> Bool {
  match mwr_read(arguments: [mwr_named_width(), mwr_width(bits: 8)]) {
    WidthUnreadable { cause: WidthCarrierSignednessUndeclared } => true
    WidthUnreadable { cause: _ } => false
    WidthReadable { signedness: _, bits: _ } => false
    NotWidthConstrained => false
  }
}

test fn a_one_argument_compose_refuses_as_malformed() -> Bool {
  match mwr_read(arguments: [mwr_kernel_int()]) {
    WidthUnreadable { cause: WidthComposeMalformed } => true
    WidthUnreadable { cause: _ } => false
    WidthReadable { signedness: _, bits: _ } => false
    NotWidthConstrained => false
  }
}

test fn a_type_naming_no_width_is_not_width_constrained() -> Bool {
  match mwr_read(arguments: [mwr_nat(), mwr_nat()]) {
    NotWidthConstrained => match machine_width_reading(head: mwr_nat().head, arguments: [mwr_nat(), mwr_width(bits: 8)]) {
      NotWidthConstrained => true
      WidthUnreadable { cause: _ } => false
      WidthReadable { signedness: _, bits: _ } => false
    }
    WidthUnreadable { cause: _ } => false
    WidthReadable { signedness: _, bits: _ } => false
  }
}
