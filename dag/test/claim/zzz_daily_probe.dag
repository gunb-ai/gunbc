module test.claim.zzz_daily_probe

import gunbc.roadmap_page {
  roadmap_daily_workspace_page_for_authority,
  roadmap_page_for_authority,
  three_gate_progress_markup,
}
import gunbc.node_http_server_emit { roadmap_dashboard_served_static_route_table }
import gunbc.live_deploy.emit { expected_live_deploy_apply_script }
import gunbc.generated_artifact {
  GeneratedArtifact, RunnerDeployArtifact, LiveDeployRetractScriptArtifact,
  LiveDeployApplyScriptArtifact, RoadmapArtifact,
}
import gunbc.generated_artifact_emit { artifact_generate }
import extdeps.languages.html { EmitOk, EmitRejected, try_serialize_html_source }
import std.markup { MarkupNode, ElementNode, MarkupAttr }

fn witness_zzz_apply_script_gen() -> Bool {
  string_contains(s: expected_live_deploy_apply_script(), pattern: "server.js")
}

fn witness_zzz_route_table() -> Bool {
  count(roadmap_dashboard_served_static_route_table().routes) == 5
}

fn zzz_gen_ok(a: GeneratedArtifact) -> Bool {
  artifact_generate(a: a) == artifact_generate(a: a)
}

fn witness_zzz_runner_deploy_gen() -> Bool { zzz_gen_ok(a: RunnerDeployArtifact) }
fn witness_zzz_retract_gen() -> Bool { zzz_gen_ok(a: LiveDeployRetractScriptArtifact) }
fn witness_zzz_apply_via_artifact() -> Bool { zzz_gen_ok(a: LiveDeployApplyScriptArtifact) }
fn witness_zzz_roadmap_md_gen() -> Bool { zzz_gen_ok(a: RoadmapArtifact) }

fn zzz_three_gate_html() -> String {
  match try_serialize_html_source(node: ElementNode { tag: "div", attrs: [], children: [three_gate_progress_markup()] }) {
    EmitOk { html: h } => h
    EmitRejected { reason: r } => concat("REJECTED:", r)
  }
}

fn witness_zzz_three_gate_alone() -> Bool {
  string_contains(s: zzz_three_gate_html(), pattern: "gate-row")
}

fn zzz_daily_html() -> String {
  match try_serialize_html_source(node: roadmap_daily_workspace_page_for_authority()) {
    EmitOk { html: h } => h
    EmitRejected { reason: r } => concat("REJECTED:", r)
  }
}

fn witness_zzz_daily_page() -> Bool {
  string_contains(s: zzz_daily_html(), pattern: "three-gate-progress")
}

fn zzz_roadmap_html() -> String {
  match try_serialize_html_source(node: roadmap_page_for_authority()) {
    EmitOk { html: h } => h
    EmitRejected { reason: r } => concat("REJECTED:", r)
  }
}

fn witness_zzz_roadmap_page() -> Bool {
  string_contains(s: zzz_roadmap_html(), pattern: "three-gate-progress")
}
