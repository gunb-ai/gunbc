import std.optional { Present, Absent }
import std.durable_compare_and_set { cas_generation_first }
import product.fabric.execution { ReservationRef }
import gunbc.durable_cas_file_store { cas_file_slot_path }
import gunbc.serving.caller_backlog {
  LogicalWorkId, CallerBacklogSnapshot, empty_caller_backlog, waiting_record, encode_waiting, decode_waiting,
  DurableWaitingPersisted, DurablePhasePersisted, DurablePersistIdempotent, DurablePersistRefusedTerminal,
  DurablePersistStoreRefused, DurablePersistKeyNotSlotAddressable, DurablePersistPayloadUnencodable,
  DurablePersistUnknownWork, DurablePersistDuplicate,
  WaitingWireEncoded, WaitingWireUnencodable,
  DurableResumedWaiting, DurableResumedTerminal, DurableResumeUnknownWork,
  DurableResumeStoreUnreadable, DurableResumePayloadUndecodable, DurableResumeWorkMismatch,
  DurableCancelled, DurableCancelAlreadyTerminal, DurableCancelUnknownWork,
  DurableCancelStoreRefused, DurableCancelKeyNotSlotAddressable,
  DurableAttemptCommitted, DurableAttemptFenceRefused, DurableAttemptNotWaiting,
  DurableAttemptUnknownWork, DurableAttemptStoreRefused, DurableAttemptKeyNotSlotAddressable,
  persist_waiting_durable, resume_waiting_durable, cancel_work_durable, commit_attempt_durable, ComputeCellFence,
  DispatchTurnKey, logical_work_id_of, WorkIdDerived, WorkIdKeyNotOctets,
  note_recovery_durable,
  WorkCancelled, WorkCompleted, WorkWaiting, WorkRecoveryBoundExceeded,
  RecoveryEvent, RecoveryProbe, RecoveryRequest,
}
