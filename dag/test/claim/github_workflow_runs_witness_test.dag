module test.claim.github_workflow_runs_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data sample_run: extdeps.github.workflow_runs.WorkflowRun = extdeps.github.workflow_runs.WorkflowRun {
  id: 12345678
  name: "CI"
  head_sha: "abc123def456abc123def456abc123def456abc123"
  status: Completed
  conclusion: Present { value: extdeps.github.workflow_runs.Success }
  workflow_id: 987
  run_number: 42
  html_url: "https://github.com/owner/repo/actions/runs/12345678"
  created_at: "2026-06-23T10:00:00Z"
  updated_at: "2026-06-23T10:15:00Z"
}

data sample_run_list: extdeps.github.workflow_runs.WorkflowRunList = extdeps.github.workflow_runs.WorkflowRunList {
  total_count: 1
  workflow_runs: [sample_run]
}

test fn workflow_run_status_wire_label_queued() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(Queued) == "queued"
}

test fn workflow_run_status_wire_label_in_progress() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(InProgress) == "in_progress"
}

test fn workflow_run_status_wire_label_completed() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(Completed) == "completed"
}

test fn workflow_run_status_wire_label_waiting() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(Waiting) == "waiting"
}

test fn workflow_run_status_wire_label_requested() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(Requested) == "requested"
}

test fn workflow_run_status_wire_label_pending() -> Bool {
  extdeps.github.workflow_runs.workflow_run_status_wire_label(Pending) == "pending"
}

test fn parse_workflow_run_status_queued() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_status("queued") {
    Present { value: Queued } => true
    _ => false
  }
}

test fn parse_workflow_run_status_in_progress() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_status("in_progress") {
    Present { value: InProgress } => true
    _ => false
  }
}

test fn parse_workflow_run_status_completed() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_status("completed") {
    Present { value: Completed } => true
    _ => false
  }
}

test fn parse_workflow_run_status_invalid_returns_none() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_status("unknown_status") {
    Absent => true
    _ => false
  }
}

test fn parse_workflow_run_status_case_sensitive() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_status("Queued") {
    Absent => true
    _ => false
  }
}

test fn workflow_run_conclusion_wire_label_success() -> Bool {
  extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Success) == "success"
}

test fn workflow_run_conclusion_wire_label_failure() -> Bool {
  extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Failure) == "failure"
}

test fn workflow_run_conclusion_wire_label_startup_failure() -> Bool {
  extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(extdeps.github.workflow_runs.StartupFailure) == "startup_failure"
}

test fn workflow_run_conclusion_wire_label_action_required() -> Bool {
  extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(ActionRequired) == "action_required"
}

test fn workflow_run_conclusion_wire_label_timed_out() -> Bool {
  extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(TimedOut) == "timed_out"
}

test fn parse_workflow_run_conclusion_success() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_conclusion("success") {
    Present { value: Success } => true
    _ => false
  }
}

test fn parse_workflow_run_conclusion_startup_failure() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_conclusion("startup_failure") {
    Present { value: extdeps.github.workflow_runs.StartupFailure } => true
    _ => false
  }
}

test fn parse_workflow_run_conclusion_neutral() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_conclusion("neutral") {
    Present { value: Neutral } => true
    _ => false
  }
}

test fn parse_workflow_run_conclusion_invalid_returns_none() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_conclusion("stale") {
    Absent => true
    _ => false
  }
}

test fn parse_workflow_run_conclusion_case_sensitive() -> Bool {
  match extdeps.github.workflow_runs.parse_workflow_run_conclusion("Success") {
    Absent => true
    _ => false
  }
}

test fn workflow_run_status_roundtrip_queued() -> Bool {
  (extdeps.github.workflow_runs.parse_workflow_run_status(extdeps.github.workflow_runs.workflow_run_status_wire_label(Queued))) == Present { value: extdeps.github.workflow_runs.Queued }
}

test fn workflow_run_status_roundtrip_in_progress() -> Bool {
  (extdeps.github.workflow_runs.parse_workflow_run_status(extdeps.github.workflow_runs.workflow_run_status_wire_label(InProgress))) == Present { value: extdeps.github.workflow_runs.InProgress }
}

test fn workflow_run_status_roundtrip_completed() -> Bool {
  (extdeps.github.workflow_runs.parse_workflow_run_status(extdeps.github.workflow_runs.workflow_run_status_wire_label(Completed))) == Present { value: extdeps.github.workflow_runs.Completed }
}

test fn workflow_run_conclusion_roundtrip_all() -> Bool {
  let r_success = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Success))) == Present { value: extdeps.github.workflow_runs.Success }
  let r_failure = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Failure))) == Present { value: extdeps.github.workflow_runs.Failure }
  let r_cancelled = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Cancelled))) == Present { value: extdeps.github.workflow_runs.Cancelled }
  let r_neutral = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Neutral))) == Present { value: extdeps.github.workflow_runs.Neutral }
  let r_skipped = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(Skipped))) == Present { value: extdeps.github.workflow_runs.Skipped }
  let r_timed_out = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(TimedOut))) == Present { value: extdeps.github.workflow_runs.TimedOut }
  let r_action_required = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(ActionRequired))) == Present { value: extdeps.github.workflow_runs.ActionRequired }
  let r_startup_failure = (extdeps.github.workflow_runs.parse_workflow_run_conclusion(extdeps.github.workflow_runs.workflow_run_conclusion_wire_label(extdeps.github.workflow_runs.StartupFailure))) == Present { value: extdeps.github.workflow_runs.StartupFailure }
  r_success && r_failure && r_cancelled && r_neutral && r_skipped && r_timed_out && r_action_required && r_startup_failure
}

test fn sample_run_has_success_conclusion() -> Bool {
  match sample_run.conclusion {
    Present { value: Success } => true
    _ => false
  }
}

test fn sample_run_list_has_one_run() -> Bool {
  sample_run_list.total_count == 1
}
