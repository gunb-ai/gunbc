      origin: a1_origin_cell(),
      end: A1EndOpen {
        column: A1Column { letter: "D" as NonEmptyStr },
      },
    },
    range: range,
    projection: projection,
    erasures: [],
  ) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "column-bounded GetValues request")
        && string_contains(s: r as String, pattern: "unobserved columns")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn grid_resolved_response_range_is_not_a_truncated_request() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "Widget")])
  let range = ValueRange {
    range: "Review!A1:D1000",
    majorDimension: Present { value: "ROWS" },
    values: Present { value: concat([w_headers()], [["L1", "", w_standing_observed(), ""]]) },
  }
  match review_sheet_ensure(
