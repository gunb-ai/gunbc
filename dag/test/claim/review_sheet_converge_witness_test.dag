test fn derived_payload_erasure_duplicate_listing_is_unreadable() -> Bool {
  let projection = w_projection(rows: [])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_gone(), "buy"]],
  )
  match classify_review_sheet_with_erasure(
    observed: observed,
    projection: projection,
    erasures: [
      w_erasure(listing_id: "L1" as NonEmptyStr),
      w_erasure(listing_id: "L1" as NonEmptyStr),
    ],
  ) {
    ReviewSheetUnreadable { reason: r } =>
      string_contains(s: r as String, pattern: "duplicate derived payload erasure listing L1")
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
  }
}

test fn ensure_with_erasure_applies_blank_derived() -> Bool {
  let projection = w_projection(rows: [])
  let range = w_value_range(rows: [["L1", "alpha", w_standing_gone(), "buy"]])
  match review_sheet_ensure(
    policy: EnsureMayApply,
    requested: w_open_request(tab: "Review" as NonEmptyStr),
    range: range,
    projection: projection,
    erasures: [w_erasure(listing_id: "L1" as NonEmptyStr)],
  ) {
    Apply { plan: bound } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: bound.plan)
        && !write_plan_touches_column(plan: bound.plan, column: "judgement" as NonEmptyStr)
        && fold(bound.plan.patches, init: false, f: fn(acc, w) {
          acc || (w.listing_id == ("L1" as NonEmptyStr)
            && w.column == ("title" as NonEmptyStr)
            && w.value == "")
        })
        && fold(bound.plan.patches, init: false, f: fn(acc, w) {
          acc || (w.listing_id == ("L1" as NonEmptyStr)
            && w.column == ("erasure" as NonEmptyStr)
            && w.value == w_erasure_applied())
        })
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn ensure_with_erasure_refuses_while_still_projected() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let range = w_value_range(rows: [["L1", "alpha", w_standing_observed(), "buy"]])
  match review_sheet_ensure(
    policy: EnsureMayApply,
    requested: w_open_request(tab: "Review" as NonEmptyStr),
    range: range,
    projection: projection,
    erasures: [w_erasure(listing_id: "L1" as NonEmptyStr)],
  ) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "still in projection")
        && string_contains(s: r as String, pattern: "listing=L1")
        && string_contains(s: r as String, pattern: "cell=A2")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn gone_listing_with_derived_payload_still_restores_when_it_returns() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_gone(), "buy"]],
  )
  match classify_review_sheet(observed: observed, projection: projection) {
    ReviewSheetNeedsWrite { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && fold(p.patches, init: false, f: fn(acc, w) {
          acc || (w.listing_id == ("L1" as NonEmptyStr)
            && w.column == ("standing" as NonEmptyStr)
            && w.value == listing_standing_label(state: StandingObserved))
        })
        && !fold(p.patches, init: false, f: fn(acc, w) {
          acc || (w.listing_id == ("L1" as NonEmptyStr)
            && w.column == ("title" as NonEmptyStr)
            && w.value == "")
        })
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

test fn applied_erasure_mark_does_not_restore_derived_when_the_listing_returns() -> Bool {
