    spreadsheet: SpreadsheetIdentified { spreadsheet_id: id, owner: "operator" as NonEmptyStr },
    residency: SheetInOwnerMyDrive,
    serviceusage_enable_iam: w_discharged_iam(),
    share: w_discharged_share(),
    sharing_policy: DomainSharingPolicyUnobserved,
    tenancy: buyer_review_account_tenancy,
  ) {
    ReviewSheetOperatorRefused { reason: r } =>
      string_contains(s: r as String, pattern: "sharing policy unread")
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
    ReviewSheetAwaitingHuman { intervention: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetEstateUnresolved { subject: _, reason: _ } => false
  }
}

