test fn readback_apply_qualifies_once_on_the_value_range_fold() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "Widget")])
  let range = w_value_range(rows: [["L1", "", w_standing_observed(), ""]])
  match review_sheet_ensure(policy: EnsureMayApply, requested: w_open_request(tab: "Review" as NonEmptyStr), range: range, projection: projection, erasures: []) {
    Apply { plan: bound } =>
      (bound.tab as String) == "Review"
        && match bound.plan.patches |> first {
          Present { value: w } =>
            a1_cell_wire(cell: w.a1) == "B2"
              && !string_contains(s: a1_cell_wire(cell: w.a1), pattern: "!")
              && match lowered_ranges(bound: bound) |> first {
                Present { value: vr } =>
                  vr.range == "'Review'!B2"
                    && !string_contains(s: vr.range, pattern: "Review!Review!")
                Absent => false
              }
          Absent => false
        }
    Noop => false
    Refuse { reason: _ } => false
  }
}

