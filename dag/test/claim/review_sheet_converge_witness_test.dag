    requested: review_sheet_get_values_request(
      tab: "Review" as NonEmptyStr,
    ),
    range: range,
    projection: projection,
    erasures: [],
  ) {
    Apply { plan: bound } =>
      (bound.tab as String) == "Review"
        && match lowered_ranges(bound: bound) |> first {
          Present { value: vr } => vr.range == "'Review'!B2"
          Absent => false
        }
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn standing_is_a_sum_projected_at_emit() -> Bool {
  match read_listing_standing(cell: listing_standing_label(state: StandingObserved)) {
    StandingKnown { state: s } => match s {
      StandingObserved => match read_listing_standing(cell: listing_standing_label(state: StandingGone)) {
        StandingKnown { state: g } => match g {
          StandingGone => match read_listing_standing(cell: "") {
            StandingBlank => true
            StandingKnown { state: _ } => false
            StandingForeign { raw: _ } => false
          }
          StandingObserved => false
        }
        StandingBlank => false
        StandingForeign { raw: _ } => false
      }
      StandingGone => false
    }
    StandingBlank => false
    StandingForeign { raw: _ } => false
  }
}

test fn duplicate_header_refuses_rather_than_last_wins() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: ["listing_id", "title", "standing", "judgement", "erasure", "title"],
    rows: [["L1", "alpha", w_standing_observed(), "", "hand-edit"]],
  )
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetUnreadable { reason: r } =>
      string_contains(s: r as String, pattern: "duplicate header title")
        && !string_contains(s: r as String, pattern: "derived cell conflict")
    ReviewSheetConverged => false
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConflict { conflict: _ } => false
  }
}

fn rendered(cause: ReviewCellConflictCause) -> String {
  conflict_reason(conflict: LocatedDerivedConflict {
    listing_id: "L1" as NonEmptyStr,
    column: "title" as NonEmptyStr,
    a1: A1Cell { column: A1Column { letter: "B" as NonEmptyStr }, row: 2 },
    cause: cause,
  }) as String
}

test fn conflict_reason_renders_the_located_facts_and_names_which_cause() -> Bool {
  let occupied = rendered(cause: DerivedFieldOccupied { observed: "hand-edited", desired: "alpha" })
  let standing = rendered(cause: ListingStandingForeignValue { raw: "Obsered" })
  let mark = rendered(cause: DerivedErasureMarkForeignValue { raw: "Aplied" })
  string_contains(s: occupied, pattern: "listing=L1")
    && string_contains(s: occupied, pattern: "column=title")
    && string_contains(s: occupied, pattern: "cell=B2")
    && string_contains(s: occupied, pattern: "cause=derived field occupied observed=hand-edited desired=alpha")
    && string_contains(s: standing, pattern: "cause=listing standing value unrecognised raw=Obsered")
    && string_contains(s: mark, pattern: "cause=derived erasure mark unrecognised raw=Aplied")
    && occupied != standing
    && standing != mark
    && occupied != mark
}

fn conflict_cause_tag(c: ReviewSheetClassification) -> String {
  match c {
    ReviewSheetConflict { conflict: k } => match k.cause {
      DerivedFieldOccupied { observed: _, desired: _ } => "occupied"
      ListingStandingForeignValue { raw: _ } => "standing"
      DerivedErasureMarkForeignValue { raw: _ } => "mark"
    }
    ReviewSheetUnreadable { reason: _ } => "unreadable"
    ReviewSheetConverged => "converged"
    ReviewSheetNeedsWrite { plan: _ } => "needs-write"
  }
}

test fn the_three_conflict_causes_are_distinguishable_from_each_other() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let occupied = classify_review_sheet(
    observed: w_observed(headers: w_headers(), rows: [["L1", "hand-edited", w_standing_observed(), "", ""]]),
    projection: projection,
    erasures: [],
  )
  let standing = classify_review_sheet(
    observed: w_observed(headers: w_headers(), rows: [["L1", "alpha", "Obsered", "", ""]]),
    projection: projection,
    erasures: [],
  )
  let mark = classify_review_sheet(
    observed: w_observed(headers: w_headers(), rows: [["L1", "alpha", w_standing_observed(), "", "Aplied"]]),
    projection: projection,
    erasures: [],
  )
  conflict_cause_tag(c: occupied) == "occupied"
    && conflict_cause_tag(c: standing) == "standing"
    && conflict_cause_tag(c: mark) == "mark"
}

test fn the_erasure_mark_conflict_carries_its_observed_token_and_location() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  match classify_review_sheet(
