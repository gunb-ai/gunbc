test fn value_range_readback_is_identity_keyed_not_positional() -> Bool {
  let projection = w_projection(rows: [
    w_row(listing_id: "L1" as NonEmptyStr, title: "alpha"),
    w_row(listing_id: "L2" as NonEmptyStr, title: "beta"),
  ])
  let range = w_value_range(rows: [
    ["L2", "beta", w_standing_observed(), "skip"],
    ["L1", "alpha", w_standing_observed(), "buy"],
  ])
  let observed_read = observed_sheet_from_value_range(range: range)
  match observed_read {
    ReadbackUnreadable { reason: _ } => false
    ReadbackObserved { observed: observed, tab: _ } =>
      match review_sheet_ensure(policy: EnsureMayApply, requested: w_open_request(tab: "Review" as NonEmptyStr), range: range, projection: projection, erasures: []) {
        Noop =>
          match judgement_for_listing(
            observed: observed,
            identity_column: "listing_id" as NonEmptyStr,
            judgement_column: "judgement" as NonEmptyStr,
            listing_id: "L1" as NonEmptyStr,
          ) {
            JudgementEntered { value: v } => (v as String) == "buy"
            JudgementBlank => false
            JudgementUnreadable { reason: _ } => false
          }
        Apply { plan: _ } => false
        Refuse { reason: _ } => false
      }
  }
}

