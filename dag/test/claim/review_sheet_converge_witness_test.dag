  ServiceObservedEnabled { project: w_fixture_project(), service_id: sheets_serviceusage_api_id }
}

fn w_observed_disabled() -> ServiceEnablementObservation {
  ServiceObservedDisabled { project: w_fixture_project(), service_id: sheets_serviceusage_api_id }
}

// The home is selected now, so the admission no longer stops at the estate. It stops one step
// later and for a different reason: nobody has observed serviceusage on gunbai-sheets, because
// the operator creates that project by hand. The proposition worth keeping across that move is
// the one in the name -- the committed project and writer are not the secrets-project defaults --
// so it is asserted against the SELECTED arm rather than deleted with the unresolved one.
test fn committed_project_and_writer_are_selected_not_secrets_defaults() -> Bool {
  match fleet_review_sheet_operator_admission() {
    ReviewSheetOperatorRefused { reason: r } =>
      string_contains(s: r as String, pattern: "unobserved")
        && string_contains(s: r as String, pattern: "sheets.googleapis.com")
        && string_contains(s: r as String, pattern: gunbai_sheets_project_id as String)
        && match sheets_calling_home() {
          SheetsCallingHomeUnresolved {
            refused_api_surface_project: _,
            refused_writer: _,
            candidate_writer_in_secrets: _,
            kitchen_sink_project: _,
            pool_host_without_sts: _,
            sts_host_without_sheets: _,
          } => false
          SheetsCallingHomeSelected {
            project_id: pid,
            writer: wr,
            refused_api_surface_project: refused,
            refused_writer: rw,
          } =>
            pid == gunbai_sheets_project_id
              && wr == review_sheet_writer_sa_email
              && pid != refused
              && (wr as String) != (rw as String)
        }
    ReviewSheetEstateUnresolved { subject: _, reason: _ } => false
    ReviewSheetAwaitingHuman { intervention: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

// Still the point of this witness: the admission reads the estate's home and keeps no second
// standing of its own. With the home selected, "follows the estate" means it carries the estate's
// project into its refusal rather than answering about some project of its own.
test fn fleet_admission_is_the_estate_calling_home_not_a_second_standing() -> Bool {
  match sheets_calling_home() {
    SheetsCallingHomeUnresolved {
      refused_api_surface_project: _,
      refused_writer: _,
      candidate_writer_in_secrets: _,
      kitchen_sink_project: _,
      pool_host_without_sts: _,
      sts_host_without_sheets: _,
    } =>
      match fleet_review_sheet_operator_admission() {
        ReviewSheetEstateUnresolved { subject: s, reason: _ } =>
          (s as String) == "sheets_calling_home"
        ReviewSheetAwaitingHuman { intervention: _ } => false
        ReviewSheetNeedsApiEnable { plan: _ } => false
        ReviewSheetOperatorRefused { reason: _ } => false
        ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
      }
    SheetsCallingHomeSelected {
      project_id: pid,
      writer: _,
      refused_api_surface_project: _,
      refused_writer: _,
    } =>
      match fleet_review_sheet_operator_admission() {
        ReviewSheetOperatorRefused { reason: r } =>
          string_contains(s: r as String, pattern: pid as String)
        ReviewSheetEstateUnresolved { subject: _, reason: _ } => false
        ReviewSheetAwaitingHuman { intervention: _ } => false
        ReviewSheetNeedsApiEnable { plan: _ } => false
        ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
      }
  }
}

