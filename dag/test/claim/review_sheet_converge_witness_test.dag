test fn bounded_get_values_request_refuses() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let range = w_value_range(rows: [["L1", "alpha", w_standing_observed(), ""]])
  match review_sheet_ensure(
    policy: EnsureMayApply,
    requested: SheetA1Range {
      tab: "Review" as NonEmptyStr,
      origin: a1_origin_cell(),
      end: A1EndClosed {
        cell: match a1_cell(column_index: 3, sheet_row: 4) {
          Present { value: c } => c
          Absent => a1_origin_cell()
        }
      },
    },
    range: range,
    projection: projection,
    erasures: [],
  ) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "bounded GetValues request")
        && string_contains(s: r as String, pattern: "unobserved rows")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn column_bounded_get_values_request_refuses() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let range = w_value_range(rows: [["L1", "alpha", w_standing_observed(), ""]])
  match review_sheet_ensure(
    policy: EnsureMayApply,
