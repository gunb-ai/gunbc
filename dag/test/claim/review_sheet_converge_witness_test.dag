test fn a1_column_past_z_has_no_letter() -> Bool {
  match a1_column_letter(index: 0) {
    Present { value: a } =>
      a == "A"
        && match a1_column_letter(index: 25) {
          Present { value: z } =>
            z == "Z"
              && match a1_column_letter(index: 26) {
                Absent => true
                Present { value: _ } => false
              }
          Absent => false
        }
    Absent => false
  }
}

test fn a_twenty_seventh_column_refuses_rather_than_writing_a_fake_a1() -> Bool {
  let schema = ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: map(a1_column_letters, n => ReviewColumn {
      name: n as NonEmptyStr,
      kind: if n == "Z" {
        DerivedField { source_field: n as NonEmptyStr }
      } else {
        OperatorEntered
      },
    }),
  }
  let projection = ReviewSheetProjection {
    schema: schema,
    rows: [ProjectionRow {
      listing_id: "L1" as NonEmptyStr,
      derived: [DerivedCell { column: "Z" as NonEmptyStr, value: "x" }],
    }],
  }
  let observed = w_observed(
    headers: concat(["listing_id"], a1_column_letters),
    rows: [concat(["L1"], map(a1_column_letters, n => ""))],
  )
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetUnreadable { reason: r } => string_contains(s: r as String, pattern: "unrepresentable A1 column index 26")
    ReviewSheetConverged => false
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConflict { conflict: _ } => false
  }
}

test fn absent_listing_appends_a_located_row() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L2" as NonEmptyStr, title: "beta")])
  let observed = w_observed(headers: w_headers(), rows: [])
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetNeedsWrite { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && !write_plan_touches_column(plan: p, column: "judgement" as NonEmptyStr)
        && !write_plan_covers_column_letter(plan: p, letter: "D")
        && (p.patches |> count) == 0
        && match p.appends |> first {
          Present { value: a } =>
            (a.listing_id as String) == "L2"
              && a.sheet_row == 2
              && match a.runs |> first {
                Present { value: run } =>
                  a1_row_span_wire(span: run.a1) == "A2:C2"
                    && !a1_row_span_includes_letter(span: run.a1, letter: "D")
                    && match run.cells |> first {
                      Present { value: id } =>
                        id == "L2"
                          && match run.cells.skip(n: 2).first() {
                            Present { value: standing } =>
                              standing == w_standing_observed()
                                && (run.cells |> count) == 3
                                && all(
                                  lowered_ranges(
                                    bound: TabBoundWritePlan { tab: "Review" as NonEmptyStr, plan: p },
                                  ),
                                  vr => !value_range_includes_column_letter(range: vr.range, letter: "D"),
                                )
                                && match lowered_ranges(
                                  bound: TabBoundWritePlan { tab: "Review" as NonEmptyStr, plan: p },
                                ) |> first {
                                  Present { value: vr } =>
                                    vr.range == "'Review'!A2:C2"
                                      && match vr.values |> first {
                                        Present { value: cells } =>
                                          match cells.skip(n: 1).first() {
                                            Present { value: title } => title == "beta"
                                            Absent => false
                                          }
                                        Absent => false
                                      }
                                  Absent => false
                                }
                            Absent => false
                          }
                      Absent => false
                    }
                Absent => false
              }
          Absent => false
        }
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

test fn append_follows_observed_header_order_not_schema_order() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L2" as NonEmptyStr, title: "alpha")])
  let headers = ["listing_id", "standing", "title", "judgement", "erasure"]
  let observed = w_observed(headers: headers, rows: [])
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetNeedsWrite { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && !write_plan_touches_column(plan: p, column: "judgement" as NonEmptyStr)
        && !write_plan_covers_column_letter(plan: p, letter: "D")
        && match p.appends |> first {
        Present { value: a } =>
          match a.runs |> first {
            Present { value: run } =>
              match run.cells.skip(n: 1).first() {
                Present { value: standing } =>
                  standing == w_standing_observed()
                    && match run.cells.skip(n: 2).first() {
                      Present { value: title } =>
                        title == "alpha"
                          && (run.cells |> count) == 3
                          && match run.cells.skip(n: 3).first() {
                            Present { value: _ } => false
                            Absent =>
                              all(
                                lowered_ranges(
                                  bound: TabBoundWritePlan { tab: "Review" as NonEmptyStr, plan: p },
                                ),
                                vr => !value_range_includes_column_letter(range: vr.range, letter: "D"),
                              )
                                && match lowered_ranges(
                                  bound: TabBoundWritePlan { tab: "Review" as NonEmptyStr, plan: p },
                                ) |> first {
                                Present { value: vr } =>
                                  match vr.values |> first {
                                    Present { value: cells } =>
                                      match cells.skip(n: 1).first() {
                                        Present { value: standing_cell } =>
                                          standing_cell == w_standing_observed()
                                            && match cells.skip(n: 2).first() {
                                              Present { value: title_cell } => title_cell == "alpha"
                                              Absent => false
                                            }
                                        Absent => false
                                      }
                                    Absent => false
                                  }
                                Absent => false
                              }
                          }
                      Absent => false
                    }
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

