fn w_schema() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "title" as NonEmptyStr, kind: DerivedField { source_field: "title" as NonEmptyStr } },
      ReviewColumn { name: "standing" as NonEmptyStr, kind: ListingStanding },
      ReviewColumn { name: "judgement" as NonEmptyStr, kind: OperatorEntered },
      ReviewColumn { name: "erasure" as NonEmptyStr, kind: DerivedErasureMark },
    ]
  }
}

fn w_schema_no_derived() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "standing" as NonEmptyStr, kind: ListingStanding },
      ReviewColumn { name: "judgement" as NonEmptyStr, kind: OperatorEntered },
    ]
  }
}

fn w_projection(rows: List<ProjectionRow>) -> ReviewSheetProjection {
  ReviewSheetProjection { schema: w_schema(), rows: rows }
}

fn w_row(listing_id: NonEmptyStr, title: String) -> ProjectionRow {
  ProjectionRow {
    listing_id: listing_id,
    derived: [DerivedCell { column: "title" as NonEmptyStr, value: title }],
  }
}

fn w_observed(headers: List<String>, rows: List<List<String>>) -> ObservedSheet {
  ObservedSheet {
    headers: headers,
    rows: rows |> enumerate |> map(pair => ObservedSheetRow { data_index: pair.first, cells: pair.second }),
  }
}

fn w_schema_without_erasure_mark() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "title" as NonEmptyStr, kind: DerivedField { source_field: "title" as NonEmptyStr } },
      ReviewColumn { name: "standing" as NonEmptyStr, kind: ListingStanding },
      ReviewColumn { name: "judgement" as NonEmptyStr, kind: OperatorEntered },
    ]
  }
}

fn w_headers() -> List<String> {
  ["listing_id", "title", "standing", "judgement", "erasure"]
}

fn w_standing_observed() -> String {
  listing_standing_label(state: StandingObserved)
}

fn w_standing_gone() -> String {
  listing_standing_label(state: StandingGone)
}

fn w_erasure_applied() -> String {
  derived_erasure_applied_label
}

fn w_erasure(listing_id: NonEmptyStr) -> DerivedPayloadErasure {
  DerivedPayloadErasure { listing_id: listing_id }
}

// The lowering is total and typed; these claims are about the ensure decision and read only the
// lowered ranges of a plan they already hold, so a refusal here surfaces as an empty list and the
// claim's own `first` match goes red. The refusal arms are the subject of
// test.claim.review_sheet_batch_actuator_witness, not of this file.
fn lowered_ranges(bound: TabBoundWritePlan) -> List<ValueRangeWrite> {
  match lower_write_plan(bound: bound) {
    WritePlanLowered { ranges: rs } => rs
    WritePlanUnlowerable { refusals: _ } => []
  }
}

fn w_value_range(rows: List<List<String>>) -> ValueRange {
  ValueRange {
    range: "Review!A1:E",
    majorDimension: Present { value: "ROWS" },
    values: Present { value: concat([w_headers()], rows) },
  }
}

fn w_open_request(tab: NonEmptyStr) -> SheetA1Range {
  review_sheet_get_values_request(tab: tab)
}

fn w_bounded_request(tab: NonEmptyStr) -> SheetA1Range {
  SheetA1Range {
    tab: tab,
    origin: a1_origin_cell(),
    end: A1EndClosed { cell: A1Cell { column: A1Column { letter: "E" as NonEmptyStr }, row: 9 } },
  }
}

fn w_column_bounded_request(tab: NonEmptyStr) -> SheetA1Range {
  SheetA1Range {
    tab: tab,
    origin: a1_origin_cell(),
    end: A1EndOpen { column: A1Column { letter: "E" as NonEmptyStr } },
  }
}

fn w_2b_projection() -> ReviewSheetProjection {
  w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
}

fn assessment_tag(a: ReviewSheetEnsureAssessment) -> String {
  match a {
    ReviewSheetRequestRejected { cause: c } => match c {
      BoundedRequest { range: _ } => "request:bounded"
      ColumnBoundedRequest { range: _ } => "request:column-bounded"
      TitleNotEncodable { range: _ } => "request:title"
    }
    ReviewSheetReadbackRejected { reason: _ } => "readback"
    ReviewSheetProjectionClassified { observed: _, tab: _, classification: _ } => "classified"
  }
}

fn assess_2b(requested: SheetA1Range, range: ValueRange) -> ReviewSheetEnsureAssessment {
  review_sheet_ensure_assess(
    requested: requested,
    range: range,
    projection: w_2b_projection(),
    erasures: [],
  )
}

test fn assess_refuses_each_request_shape_under_its_own_cause() -> Bool {
  let good = w_value_range(rows: [["L1", "alpha", w_standing_observed(), "", ""]])
  assessment_tag(a: assess_2b(requested: w_bounded_request(tab: "Review" as NonEmptyStr), range: good)) == "request:bounded"
    && assessment_tag(a: assess_2b(requested: w_column_bounded_request(tab: "Review" as NonEmptyStr), range: good)) == "request:column-bounded"
    && assessment_tag(a: assess_2b(requested: w_open_request(tab: "Review" as NonEmptyStr), range: good)) == "classified"
}

fn request_cause_range_wire(a: ReviewSheetEnsureAssessment) -> String {
  match a {
    ReviewSheetRequestRejected { cause: c } => match c {
      BoundedRequest { range: r } => concat("bounded:", a1_range_encoding_text(e: sheet_a1_range_wire(range: r)))
      ColumnBoundedRequest { range: r } => concat("column:", a1_range_encoding_text(e: sheet_a1_range_wire(range: r)))
      TitleNotEncodable { range: _ } => "title"
    }
    ReviewSheetReadbackRejected { reason: _ } => "readback"
    ReviewSheetProjectionClassified { observed: _, tab: _, classification: _ } => "classified"
  }
}

test fn assess_carries_the_whole_refused_range_not_only_its_tab() -> Bool {
  let empty = w_value_range(rows: [])
  request_cause_range_wire(a: assess_2b(requested: w_bounded_request(tab: "Review" as NonEmptyStr), range: empty))
    == "bounded:'Review'!A1:E9"
    && request_cause_range_wire(a: assess_2b(requested: w_column_bounded_request(tab: "Review" as NonEmptyStr), range: empty))
      == "column:'Review'!A1:E"
}

fn rendered_request_refusal(requested: SheetA1Range) -> String {
  match review_sheet_ensure_decide(
    policy: EnsureMayApply,
    assessment: assess_2b(requested: requested, range: w_value_range(rows: [])),
  ) {
    Refuse { reason: r } => r as String
    Apply { plan: _ } => "APPLY"
    Noop => "NOOP"
  }
}

test fn the_request_refusal_reason_renders_the_range_it_refused_for_both_walls() -> Bool {
  let bounded = rendered_request_refusal(requested: w_bounded_request(tab: "Review" as NonEmptyStr))
  let column = rendered_request_refusal(requested: w_column_bounded_request(tab: "Review" as NonEmptyStr))
  string_contains(s: bounded, pattern: "'Review'!A1:E9")
    && string_contains(s: bounded, pattern: "unobserved rows")
    && string_contains(s: column, pattern: "'Review'!A1:E")
    && string_contains(s: column, pattern: "unobserved columns")
    && !string_contains(s: column, pattern: "unobserved rows")
}

fn w_malformed_readback() -> ValueRange {
  ValueRange {
    range: "Review",
    majorDimension: Present { value: "ROWS" },
    values: Present { value: [w_headers()] },
  }
}

test fn the_request_wall_preempts_a_readback_that_cannot_parse() -> Bool {
  let bad = w_malformed_readback()
  assessment_tag(a: assess_2b(requested: w_bounded_request(tab: "Review" as NonEmptyStr), range: bad)) == "request:bounded"
    && assessment_tag(a: assess_2b(requested: w_column_bounded_request(tab: "Review" as NonEmptyStr), range: bad)) == "request:column-bounded"
    && assessment_tag(a: assess_2b(requested: w_open_request(tab: "Review" as NonEmptyStr), range: bad)) == "readback"
}

test fn assess_refuses_a_foreign_readback_tab() -> Bool {
  assessment_tag(a: assess_2b(
    requested: w_open_request(tab: "Other" as NonEmptyStr),
    range: w_value_range(rows: [["L1", "alpha", w_standing_observed(), "", ""]]),
  )) == "readback"
}

test fn decide_applies_policy_and_assess_never_does() -> Bool {
  let needs_write = assess_2b(
    requested: w_open_request(tab: "Review" as NonEmptyStr),
    range: w_value_range(rows: []),
  )
  match review_sheet_ensure_decide(policy: EnsureObserveOnly, assessment: needs_write) {
    Refuse { reason: _ } =>
      match review_sheet_ensure_decide(policy: EnsureMayApply, assessment: needs_write) {
        Apply { plan: _ } => true
        Noop => false
        Refuse { reason: _ } => false
      }
    Apply { plan: _ } => false
    Noop => false
  }
}

fn lp(s: String) -> String {
  length_prefixed_encode(s: s)
}

// Each field is length-prefixed, so it is self-delimiting; a list is the concatenation of its
// length-prefixed elements, length-prefixed again so the list is one field. Nesting stays injective.
fn lp_list(xs: List<String>) -> String {
  lp(s: join(map(xs, x => lp(s: x)), ""))
}

fn patch_wire(w: DerivedCellWrite) -> String {
  lp_list(xs: [w.listing_id as String, w.column as String, a1_cell_wire(cell: w.a1), w.value])
}

fn run_wire(r: AppendCellRun) -> String {
  lp_list(xs: [a1_row_span_wire(span: r.a1), lp_list(xs: r.cells), lp_list(xs: map(r.columns, c => c as String))])
}

fn append_wire(a: AppendListingRow) -> String {
  lp_list(xs: [a.listing_id as String, to_string(a.sheet_row), lp_list(xs: map(a.runs, r => run_wire(r: r)))])
}

// A CANONICAL ENCODING, NOT A DELIMITER JOIN. An earlier form of this was described as injective
// and was not: it joined arbitrary cell strings with "," "~" ";" "|" unescaped, so ["a,b","c"] and
// ["a","b,c"] serialized identically and a wrapper could alter a plan while preserving this value.
// It now uses std.materialization_provider length_prefixed_encode -- the keying home's canonical
// field encoding -- with the variant tag first so Noop, Apply and Refuse cannot collide.
fn decision_wire_2b(d: UpsertDecision<TabBoundWritePlan>) -> String {
  match d {
    Noop => lp_list(xs: ["noop"])
    Apply { plan: p } =>
      lp_list(xs: [
        "apply",
        p.tab as String,
        lp_list(xs: map(p.plan.patches, w => patch_wire(w: w))),
        lp_list(xs: map(p.plan.appends, a => append_wire(a: a))),
      ])
    Refuse { reason: r } => lp_list(xs: ["refuse", r as String])
  }
}

test fn the_decision_encoding_separates_values_a_delimiter_join_would_merge() -> Bool {
  lp_list(xs: ["a,b", "c"]) != lp_list(xs: ["a", "b,c"])
    && lp_list(xs: ["a", "b"]) != lp_list(xs: ["ab"])
    && lp_list(xs: [lp_list(xs: ["a"]), "b"]) != lp_list(xs: ["a", lp_list(xs: ["b"])])
}

fn ensure_equals_composition(policy: EnsurePolicy, requested: SheetA1Range, range: ValueRange) -> Bool {
  decision_wire_2b(d: review_sheet_ensure(
    policy: policy,
    requested: requested,
    range: range,
    projection: w_2b_projection(),
    erasures: [],
  )) == decision_wire_2b(d: review_sheet_ensure_decide(
    policy: policy,
    assessment: assess_2b(requested: requested, range: range),
  ))
}

test fn ensure_is_exactly_decide_of_assess_on_every_arm() -> Bool {
  let review = "Review" as NonEmptyStr
  let empty = w_value_range(rows: [])
  let converged = w_value_range(rows: [["L1", "alpha", w_standing_observed(), "", ""]])
  let conflicted = w_value_range(rows: [["L1", "hand-edited", w_standing_observed(), "", ""]])
  let unreadable = w_value_range(rows: [
    ["L1", "alpha", w_standing_observed(), "", ""],
    ["L1", "alpha", w_standing_observed(), "", ""],
  ])
  ensure_equals_composition(policy: EnsureMayApply, requested: w_bounded_request(tab: review), range: empty)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_column_bounded_request(tab: review), range: empty)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: "Other" as NonEmptyStr), range: converged)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: review), range: empty)
    && ensure_equals_composition(policy: EnsureObserveOnly, requested: w_open_request(tab: review), range: empty)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: review), range: converged)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: review), range: conflicted)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: review), range: unreadable)
    && ensure_equals_composition(policy: EnsureObserveOnly, requested: w_open_request(tab: review), range: conflicted)
    && ensure_equals_composition(policy: EnsureMayApply, requested: w_open_request(tab: review), range: w_patch_readback())
}

fn w_patch_readback() -> ValueRange {
  w_value_range(rows: [["L1", "", w_standing_observed(), "", ""]])
}

test fn the_equivalence_matrix_reaches_a_patch_producing_plan() -> Bool {
  match review_sheet_ensure_decide(
    policy: EnsureMayApply,
    assessment: assess_2b(requested: w_open_request(tab: "Review" as NonEmptyStr), range: w_patch_readback()),
  ) {
    Apply { plan: p } => (p.plan.patches |> count) >= 1 && (p.plan.appends |> count) == 0
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn the_equivalence_comparator_actually_reaches_conflict_and_unreadable() -> Bool {
  let review = "Review" as NonEmptyStr
  let conflicted = w_value_range(rows: [["L1", "hand-edited", w_standing_observed(), "", ""]])
  let unreadable = w_value_range(rows: [
    ["L1", "alpha", w_standing_observed(), "", ""],
    ["L1", "alpha", w_standing_observed(), "", ""],
  ])
  classification_tag(a: assess_2b(requested: w_open_request(tab: review), range: conflicted)) == "conflict"
    && classification_tag(a: assess_2b(requested: w_open_request(tab: review), range: unreadable)) == "unreadable"
}

fn classification_tag(a: ReviewSheetEnsureAssessment) -> String {
  match a {
    ReviewSheetProjectionClassified { observed: _, tab: _, classification: c } => match c {
      ReviewSheetConverged => "converged"
      ReviewSheetNeedsWrite { plan: _ } => "needs-write"
      ReviewSheetConflict { conflict: _ } => "conflict"
      ReviewSheetUnreadable { reason: _ } => "unreadable"
    }
    ReviewSheetRequestRejected { cause: _ } => "request"
    ReviewSheetReadbackRejected { reason: _ } => "readback"
  }
}

test fn converge_twice_unchanged_is_noop() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_observed(), ""]],
  )
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetConverged =>
      match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
        ReviewSheetConverged => true
        ReviewSheetNeedsWrite { plan: _ } => false
        ReviewSheetConflict { conflict: _ } => false
        ReviewSheetUnreadable { reason: _ } => false
      }
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

test fn converge_preserves_populated_human_column() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "", w_standing_observed(), "buy"]],
  )
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetNeedsWrite { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && match judgement_for_listing(
          observed: observed,
          identity_column: "listing_id" as NonEmptyStr,
          judgement_column: "judgement" as NonEmptyStr,
          listing_id: "L1" as NonEmptyStr,
        ) {
          JudgementEntered { value: v } => (v as String) == "buy"
          JudgementBlank => false
          JudgementUnreadable { reason: _ } => false
        }
        && !write_plan_touches_column(plan: p, column: "judgement" as NonEmptyStr)
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

test fn converge_over_hand_edited_derived_cell_refuses_and_names_the_cell() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "hand-edited", w_standing_observed(), ""]],
  )
  match classify_review_sheet(observed: observed, projection: projection, erasures: []) {
    ReviewSheetConflict { conflict: c } =>
      (c.listing_id as String) == "L1"
        && (c.column as String) == "title"
        && a1_cell_eq(a: c.a1, b: A1Cell { column: A1Column { letter: "B" as NonEmptyStr }, row: 2 })
        && match c.cause {
          DerivedFieldOccupied { observed: o, desired: d } => o == "hand-edited" && d == "alpha"
          ListingStandingForeignValue { raw: _ } => false
          DerivedErasureMarkForeignValue { raw: _ } => false
        }
    ReviewSheetUnreadable { reason: _ } => false
    ReviewSheetConverged => false
    ReviewSheetNeedsWrite { plan: _ } => false
  }
}

test fn resorted_sheet_does_not_move_a_judgement() -> Bool {
  let projection = w_projection(rows: [
    w_row(listing_id: "L1" as NonEmptyStr, title: "alpha"),
    w_row(listing_id: "L2" as NonEmptyStr, title: "beta"),
  ])
  let sorted = w_observed(
    headers: w_headers(),
    rows: [
      ["L1", "alpha", w_standing_observed(), "buy"],
      ["L2", "beta", w_standing_observed(), "skip"],
    ],
  )
  let resorted = w_observed(
    headers: w_headers(),
    rows: [
      ["L2", "beta", w_standing_observed(), "skip"],
      ["L1", "alpha", w_standing_observed(), "buy"],
    ],
  )
  match classify_review_sheet(observed: sorted, projection: projection, erasures: []) {
    ReviewSheetConverged =>
      match classify_review_sheet(observed: resorted, projection: projection, erasures: []) {
        ReviewSheetConverged =>
          match judgement_for_listing(
            observed: resorted,
            identity_column: "listing_id" as NonEmptyStr,
            judgement_column: "judgement" as NonEmptyStr,
            listing_id: "L1" as NonEmptyStr,
          ) {
            JudgementEntered { value: v } => (v as String) == "buy"
            JudgementBlank => false
            JudgementUnreadable { reason: _ } => false
          }
            && match judgement_for_listing(
              observed: resorted,
              identity_column: "listing_id" as NonEmptyStr,
              judgement_column: "judgement" as NonEmptyStr,
              listing_id: "L2" as NonEmptyStr,
            ) {
              JudgementEntered { value: v } => (v as String) == "skip"
              JudgementBlank => false
              JudgementUnreadable { reason: _ } => false
            }
        ReviewSheetNeedsWrite { plan: _ } => false
        ReviewSheetConflict { conflict: _ } => false
        ReviewSheetUnreadable { reason: _ } => false
      }
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

