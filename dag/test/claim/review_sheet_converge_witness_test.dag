test fn disabled_api_awaits_serviceusage_enable_iam_before_enable() -> Bool {
  match admit_review_sheet_operator(
    project: w_fixture_project(),
    writer: w_fixture_writer(),
    enablement: w_observed_disabled(),
    enablement_policy: EnsureMayApply,
    spreadsheet: SpreadsheetAwaitingCreation,
    serviceusage_enable_iam: serviceusage_enable_iam_grant_intervention(
      project: w_fixture_project(),
      writer: w_fixture_writer(),
    ),
    share: w_pending_share(),
    sharing_policy: DomainSharingAllowsServiceAccountShare,
    tenancy: ReviewSheetWorkspaceDomain,
  ) {
    ReviewSheetAwaitingHuman { intervention: i } =>
      string_contains(s: i.identity as String, pattern: "gcp-serviceusage-enable-iam")
        && string_contains(s: i.identity as String, pattern: "fixture-api-project")
        && string_contains(s: i.identity as String, pattern: "writer@fixture.iam.gserviceaccount.com")
        && string_contains(s: i.instruction as String, pattern: "serviceusage.services.enable")
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetEstateUnresolved { subject: _, reason: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

