  )
  match classify_review_sheet(observed: observed, projection: projection) {
    ReviewSheetUnreadable { reason: r } =>
      string_contains(s: r as String, pattern: "projection omitted derived column title")
        && !string_contains(s: r as String, pattern: "derived cell conflict")
    ReviewSheetConverged => false
    ReviewSheetNeedsWrite { plan: _ } => false
    ReviewSheetConflict { conflict: _ } => false
  }
}

test fn live_transport_frontiers_are_scaffold_not_terminal() -> Bool {
  match live_sheets_transport_frontier {
    Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
      (b.module_path as String) == "gunbc.review_sheet_sheets"
        && (b.decl_name as String) == "review_sheet_ensure"
    Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
    Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
    Terminal { reason: _ } => false
  }
    && match buyer_review_judgement_read_frontier {
      Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
        (b.module_path as String) == "gunbc.review_sheet_projection"
          && (b.decl_name as String) == "judgement_for_listing"
      Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
      Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
      Terminal { reason: _ } => false
    }
    && sheet_a1_range_wire(
      range: review_sheet_get_values_request(
        tab: "Review" as NonEmptyStr,
      ),
    ) == "Review"
    && match live_serviceusage_get_frontier {
      Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
        (b.decl_name as String) == "service_enablement_from_state_wire"
      Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
      Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
      Terminal { reason: _ } => false
    }
    && match live_serviceusage_enable_frontier {
      Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
        (b.decl_name as String) == "decide_service_enablement"
      Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
      Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
      Terminal { reason: _ } => false
    }
    && match sheets_major_dimension_from_wire(raw: sheets_major_dimension_wire(d: DimensionRows)) {
      Present { value: DimensionRows } =>
        match sheets_major_dimension_from_wire(raw: sheets_major_dimension_wire(d: DimensionColumns)) {
          Present { value: DimensionColumns } =>
            match sheets_value_input_option_from_wire(
              raw: sheets_value_input_option_wire(o: review_sheet_batch_value_input_option()),
            ) {
              Present { value: InputRaw } =>
                match sheets_value_input_option_from_wire(raw: sheets_value_input_option_wire(o: InputUserEntered)) {
                  Present { value: InputUserEntered } =>
                    match sheets_value_render_option_from_wire(
                      raw: sheets_value_render_option_wire(o: review_sheet_get_value_render_option()),
                    ) {
                      Present { value: RenderFormattedValue } =>
                        match value_ranges_from_write_plan(
                          bound: TabBoundWritePlan {
                            tab: "Review" as NonEmptyStr,
                            plan: ReviewSheetWritePlan {
                              patches: [
                                DerivedCellWrite {
                                  listing_id: "L1" as NonEmptyStr,
                                  column: "title" as NonEmptyStr,
                                  a1: A1Cell {
                                    column: A1Column { letter: "B" as NonEmptyStr },
                                    row: 2,
                                  },
                                  value: "Widget",
                                }
                              ],
                              appends: [],
                            },
                          },
                        ) |> first {
                          Present { value: vr } =>
                            vr.range == "Review!B2"
                              && match vr.values {
                                Present { value: rows } =>
                                  match rows |> first {
                                    Present { value: cells } =>
                                      match cells |> first {
                                        Present { value: v } => v == "Widget"
                                        Absent => false
                                      }
                                    Absent => false
                                  }
                                Absent => false
                              }
                          Absent => false
                        }
                      Present { value: RenderUnformattedValue } => false
                      Present { value: RenderFormula } => false
                      Absent => false
                    }
                  Present { value: InputRaw } => false
                  Absent => false
                }
              Present { value: InputUserEntered } => false
              Absent => false
            }
          Present { value: DimensionRows } => false
          Absent => false
        }
      Present { value: DimensionColumns } => false
      Absent => false
    }
}

test fn sheets_published_mock_corpus_covers_get_and_batch_update() -> Bool {
  match sheets_published_mock_corpus |> first {
    Present { value: get } =>
      get.operation_key == "sheets.Spreadsheets.GetValues"
        && match sheets_published_mock_corpus.skip(n: 1).first() {
          Present { value: upd } =>
            upd.operation_key == "sheets.Spreadsheets.BatchUpdateValues"
              && match sheets_published_mock_corpus.skip(n: 2).first() {
                Absent =>
                  match BatchUpdateValuesResponse {
                    spreadsheetId: "s",
                    totalUpdatedRows: none,
                    totalUpdatedColumns: none,
                    totalUpdatedCells: none,
                    totalUpdatedSheets: none,
                    responses: none,
                  }.totalUpdatedCells {
                    Absent => true
                    Present { value: _ } => false
                  }
                Present { value: _ } => false
              }
          Absent => false
        }
    Absent => false
  }
}

fn w_fixture_project() -> GcpProjectId {
  "fixture-api-project"
}

fn w_fixture_writer() -> ServiceAccountEmail {
  "writer@fixture.iam.gserviceaccount.com"
}

fn w_discharged_iam() -> HumanIntervention {
  w_discharged_iam_for(project: w_fixture_project(), writer: w_fixture_writer())
}

fn w_discharged_iam_for(project: GcpProjectId, writer: ServiceAccountEmail) -> HumanIntervention {
  let pending = serviceusage_enable_iam_grant_intervention(project: project, writer: writer)
  HumanIntervention {
    identity: pending.identity,
    frequency: pending.frequency,
    subject: pending.subject,
    instruction: pending.instruction,
    completion_evidence: DischargedAt {
      evidence: DeclarationRef {
        module_path: "test.claim.review_sheet_converge_witness",
        decl_name: "w_discharged_iam",
        field: WholeDeclaration,
      }
    },
  }
}

fn w_pending_share() -> HumanIntervention {
  spreadsheet_share_intervention(spreadsheet_id: "sheet-abc" as NonEmptyStr, writer: w_fixture_writer())
}

fn w_discharged_share() -> HumanIntervention {
  let pending = spreadsheet_share_intervention(
    spreadsheet_id: "sheet-abc" as NonEmptyStr,
    writer: w_fixture_writer(),
  )
  HumanIntervention {
    identity: pending.identity,
    frequency: pending.frequency,
    subject: pending.subject,
    instruction: pending.instruction,
    completion_evidence: DischargedAt {
      evidence: DeclarationRef {
        module_path: "test.claim.review_sheet_converge_witness",
        decl_name: "w_discharged_share",
        field: WholeDeclaration,
      }
    },
  }
}

