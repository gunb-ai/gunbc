fn w_schema() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "title" as NonEmptyStr, kind: DerivedField { source_field: "title" as NonEmptyStr } },
      ReviewColumn { name: "standing" as NonEmptyStr, kind: ListingStanding },
      ReviewColumn { name: "judgement" as NonEmptyStr, kind: OperatorEntered },
    ]
  }
}

fn w_projection(rows: List<ProjectionRow>) -> ReviewSheetProjection {
  ReviewSheetProjection { schema: w_schema(), rows: rows }
}

fn w_row(listing_id: NonEmptyStr, title: String) -> ProjectionRow {
  ProjectionRow {
    listing_id: listing_id,
    derived: [DerivedCell { column: "title" as NonEmptyStr, value: title }],
  }
}

fn w_observed(headers: List<String>, rows: List<List<String>>) -> ObservedSheet {
  ObservedSheet {
    headers: headers,
    rows: rows |> enumerate |> map(pair => ObservedSheetRow { data_index: pair.first, cells: pair.second }),
  }
}

fn w_headers() -> List<String> {
  ["listing_id", "title", "standing", "judgement"]
}

fn w_standing_observed() -> String {
  listing_standing_label(state: StandingObserved)
}

fn w_value_range(rows: List<List<String>>) -> ValueRange {
  ValueRange {
    range: "Review!A1:D4",
    majorDimension: Present { value: "ROWS" },
    values: Present { value: concat([w_headers()], rows) },
  }
}

test fn converge_twice_unchanged_is_noop() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_observed(), ""]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Noop =>
      match decide_review_sheet(observed: observed, projection: projection) {
        Noop => true
        Apply { plan: _ } => false
        Refuse { reason: _ } => false
      }
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn converge_preserves_populated_human_column() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "", w_standing_observed(), "buy"]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Apply { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && judgement_for_listing(
          observed: observed,
          identity_column: "listing_id" as NonEmptyStr,
          judgement_column: "judgement" as NonEmptyStr,
          listing_id: "L1" as NonEmptyStr,
        ) == "buy"
        && !write_plan_touches_column(plan: p, column: "judgement" as NonEmptyStr)
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn converge_over_hand_edited_derived_cell_refuses_and_names_the_cell() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "hand-edited", w_standing_observed(), ""]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "listing=L1")
        && string_contains(s: r as String, pattern: "column=title")
        && string_contains(s: r as String, pattern: "cell=B2")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn resorted_sheet_does_not_move_a_judgement() -> Bool {
  let projection = w_projection(rows: [
    w_row(listing_id: "L1" as NonEmptyStr, title: "alpha"),
    w_row(listing_id: "L2" as NonEmptyStr, title: "beta"),
  ])
  let sorted = w_observed(
    headers: w_headers(),
    rows: [
      ["L1", "alpha", w_standing_observed(), "buy"],
      ["L2", "beta", w_standing_observed(), "skip"],
    ],
  )
  let resorted = w_observed(
    headers: w_headers(),
    rows: [
      ["L2", "beta", w_standing_observed(), "skip"],
      ["L1", "alpha", w_standing_observed(), "buy"],
    ],
  )
  match decide_review_sheet(observed: sorted, projection: projection) {
    Noop =>
      match decide_review_sheet(observed: resorted, projection: projection) {
        Noop =>
          judgement_for_listing(
            observed: resorted,
            identity_column: "listing_id" as NonEmptyStr,
            judgement_column: "judgement" as NonEmptyStr,
            listing_id: "L1" as NonEmptyStr,
          ) == "buy"
            && judgement_for_listing(
              observed: resorted,
              identity_column: "listing_id" as NonEmptyStr,
              judgement_column: "judgement" as NonEmptyStr,
              listing_id: "L2" as NonEmptyStr,
            ) == "skip"
        Apply { plan: _ } => false
        Refuse { reason: _ } => false
      }
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn listing_gone_with_judgement_is_retained_and_marked() -> Bool {
  let projection = w_projection(rows: [])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_observed(), "buy"]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Apply { plan: p } =>
      write_plan_preserves_operator_columns(schema: w_schema(), plan: p)
        && (p.appends |> count) == 0
        && judgement_for_listing(
          observed: observed,
          identity_column: "listing_id" as NonEmptyStr,
          judgement_column: "judgement" as NonEmptyStr,
          listing_id: "L1" as NonEmptyStr,
        ) == "buy"
        && fold(p.patches, init: false, f: fn(acc, w) {
          acc || (w.listing_id == ("L1" as NonEmptyStr)
            && w.column == ("standing" as NonEmptyStr)
            && w.value == listing_standing_label(state: StandingGone))
        })
    Noop => false
    Refuse { reason: _ } => false
  }
}

test fn ensure_over_unchanged_readback_is_noop() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let range = w_value_range(rows: [["L1", "alpha", w_standing_observed(), "buy"]])
  match review_sheet_ensure(policy: EnsureMayApply, range: range, projection: projection) {
    Noop =>
      match review_sheet_from_readback(range: range, projection: projection) {
        Noop => true
        Apply { plan: _ } => false
        Refuse { reason: _ } => false
      }
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn value_range_readback_is_identity_keyed_not_positional() -> Bool {
  let projection = w_projection(rows: [
    w_row(listing_id: "L1" as NonEmptyStr, title: "alpha"),
    w_row(listing_id: "L2" as NonEmptyStr, title: "beta"),
  ])
  let range = w_value_range(rows: [
    ["L2", "beta", w_standing_observed(), "skip"],
    ["L1", "alpha", w_standing_observed(), "buy"],
  ])
  let observed = observed_sheet_from_value_range(range: range)
  match review_sheet_from_readback(range: range, projection: projection) {
    Noop =>
      judgement_for_listing(
        observed: observed,
        identity_column: "listing_id" as NonEmptyStr,
        judgement_column: "judgement" as NonEmptyStr,
        listing_id: "L1" as NonEmptyStr,
      ) == "buy"
    Apply { plan: _ } => false
    Refuse { reason: _ } => false
  }
}

test fn sheets_api_is_v4_with_published_read_quota_and_scope() -> Bool {
  (sheets_api_version as String) == "v4"
    && (sheets_spreadsheets_oauth_scope as String) == "https://www.googleapis.com/auth/spreadsheets"
    && sheets_read_requests_per_minute_per_project.requests == 300
    && (sheets_workspace_suite() as String) == "Google Workspace"
}

test fn standing_is_a_sum_projected_at_emit() -> Bool {
  match read_listing_standing(cell: listing_standing_label(state: StandingObserved)) {
    StandingKnown { state: s } => match s {
      StandingObserved => match read_listing_standing(cell: listing_standing_label(state: StandingGone)) {
        StandingKnown { state: g } => match g {
          StandingGone => match read_listing_standing(cell: "") {
            StandingBlank => true
            StandingKnown { state: _ } => false
            StandingForeign { raw: _ } => false
          }
          StandingObserved => false
        }
        StandingBlank => false
        StandingForeign { raw: _ } => false
      }
      StandingGone => false
    }
    StandingBlank => false
    StandingForeign { raw: _ } => false
  }
}

test fn foreign_standing_cell_refuses_and_names_the_cell() -> Bool {
  let projection = w_projection(rows: [w_row(listing_id: "L1" as NonEmptyStr, title: "alpha")])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", "Obsered", ""]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "listing=L1")
        && string_contains(s: r as String, pattern: "column=standing")
        && string_contains(s: r as String, pattern: "cell=C2")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn a1_column_past_z_has_no_letter() -> Bool {
  match a1_column_letter(index: 0) {
    Present { value: a } =>
      a == "A"
        && match a1_column_letter(index: 25) {
          Present { value: z } =>
            z == "Z"
              && match a1_column_letter(index: 26) {
                Absent => true
                Present { value: _ } => false
              }
          Absent => false
        }
    Absent => false
  }
}

test fn a_twenty_seventh_column_refuses_rather_than_writing_a_fake_a1() -> Bool {
  let schema = ReviewSheetSchema {
    identity_column: "listing_id" as NonEmptyStr,
    columns: map(a1_column_letters, n => ReviewColumn {
      name: n as NonEmptyStr,
      kind: DerivedField { source_field: n as NonEmptyStr },
    }),
  }
  let projection = ReviewSheetProjection {
    schema: schema,
    rows: [ProjectionRow {
      listing_id: "L1" as NonEmptyStr,
      derived: [DerivedCell { column: "Z" as NonEmptyStr, value: "x" }],
    }],
  }
  let observed = w_observed(
    headers: concat(["listing_id"], a1_column_letters),
    rows: [concat(["L1"], map(a1_column_letters, n => ""))],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Refuse { reason: r } => string_contains(s: r as String, pattern: "unrepresentable A1 column index 26")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn omitted_derived_column_on_blank_sheet_refuses_rather_than_noop() -> Bool {
  let projection = w_projection(rows: [
    ProjectionRow { listing_id: "L1" as NonEmptyStr, derived: [] },
  ])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "", w_standing_observed(), ""]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "projection omitted derived column title")
        && string_contains(s: r as String, pattern: "listing=L1")
        && !string_contains(s: r as String, pattern: "derived cell conflict")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn omitted_derived_column_on_populated_sheet_is_not_a_conflict() -> Bool {
  let projection = w_projection(rows: [
    ProjectionRow { listing_id: "L1" as NonEmptyStr, derived: [] },
  ])
  let observed = w_observed(
    headers: w_headers(),
    rows: [["L1", "alpha", w_standing_observed(), ""]],
  )
  match decide_review_sheet(observed: observed, projection: projection) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "projection omitted derived column title")
        && !string_contains(s: r as String, pattern: "derived cell conflict")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn sheets_cited_facts_have_executing_readers() -> Bool {
  (sheets_rate_limits |> count) == 3
    && sheets_write_requests_per_minute_per_project.requests == 300
    && sheets_requests_per_minute_per_user.requests == 60
    && sheets_read_quota_citation.fact.decl_name == "sheets_read_requests_per_minute_per_project"
    && match sheets_major_dimension_from_wire(raw: sheets_major_dimension_wire(d: DimensionRows)) {
      Present { value: DimensionRows } =>
        match sheets_major_dimension_from_wire(raw: sheets_major_dimension_wire(d: DimensionColumns)) {
          Present { value: DimensionColumns } => true
          Present { value: DimensionRows } => false
          Absent => false
        }
      Present { value: DimensionColumns } => false
      Absent => false
    }
    && (sheets_published_mock_corpus |> count) == 2
    && (sheets_spreadsheets_readonly_oauth_scope as String) != (sheets_spreadsheets_oauth_scope as String)
    && (sheets_projection_oauth_scope() as String) == (sheets_spreadsheets_oauth_scope as String)
    && sheets_value_input_raw() == "RAW"
    && (sheets_api_edition() as String) == (sheets_api_version as String)
    && (sheets_serviceusage_api_id as String) == "sheets.googleapis.com"
    && match live_sheets_transport_frontier {
      Scaffold { dissolves_to: RealizationDispatch, bind: b } =>
        (b.module_path as String) == "gunbc.review_sheet_sheets"
          && (b.decl_name as String) == "review_sheet_from_readback"
      Scaffold { dissolves_to: SingleAuthority, bind: _ } => false
      Scaffold { dissolves_to: SubstrateMandatoryTag, bind: _ } => false
      Terminal { reason: _ } => false
    }
    && sheets_access(
      spreadsheet_id: "sheet" as NonEmptyStr,
      credential: SecretRef {
        project: "proj",
        secret: "sheets-sa" as NonEmptyStr,
        version: "pending",
        hash_state: HashPending,
      },
    ).spreadsheet_id == ("sheet" as NonEmptyStr)
}

fn w_discharged_wif() -> HumanIntervention {
  HumanIntervention {
    identity: "gcp-fleet-secrets-wif-binding" as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: "test-only discharged wif",
    instruction: "fixture",
    completion_evidence: DischargedAt {
      evidence: DeclarationRef {
        module_path: "test.claim.review_sheet_converge_witness",
        decl_name: "w_discharged_wif",
        field: WholeDeclaration,
      }
    },
  }
}

fn w_discharged_iam() -> HumanIntervention {
  HumanIntervention {
    identity: concat("gcp-serviceusage-enable-iam-", review_sheet_gcp_project as String) as HumanInterventionIdentity,
    frequency: FleetOnce,
    subject: "test-only discharged serviceusage enable iam",
    instruction: "fixture",
    completion_evidence: DischargedAt {
      evidence: DeclarationRef {
        module_path: "test.claim.review_sheet_converge_witness",
        decl_name: "w_discharged_iam",
        field: WholeDeclaration,
      }
    },
  }
}

fn w_observed_enabled() -> ServiceEnablementObservation {
  ServiceObservedEnabled { project: review_sheet_gcp_project, service_id: sheets_serviceusage_api_id }
}

fn w_observed_disabled() -> ServiceEnablementObservation {
  ServiceObservedDisabled { project: review_sheet_gcp_project, service_id: sheets_serviceusage_api_id }
}

test fn committed_operator_path_awaits_per_project_serviceusage_iam() -> Bool {
  match fleet_review_sheet_operator_admission() {
    ReviewSheetAwaitingHuman { intervention: i } =>
      string_contains(s: i.identity as String, pattern: "gcp-serviceusage-enable-iam-")
        && string_contains(s: i.identity as String, pattern: "gunb-test")
        && match i.frequency {
          FleetOnce => true
          DeviceOnce => false
          EveryProvision => false
          BreakGlassOnly => false
        }
        && string_contains(s: i.instruction as String, pattern: "serviceusage.services.enable")
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
    && match buyer_review_spreadsheet {
      SpreadsheetAwaitingCreation => true
      SpreadsheetIdentified { spreadsheet_id: _, owner: _ } => false
    }
    && match buyer_review_workspace_domain_sharing {
      DomainSharingPolicyUnobserved => true
      DomainSharingForbidsExternalPrincipals => false
      DomainSharingAllowsServiceAccountShare => false
    }
    && (review_sheet_gcp_project as String) == "gunb-test"
    && (review_sheet_uses_fleet_secrets_project() as String) == "gunbai-secrets"
    && string_contains(s: review_sheet_writer_service_account() as String, pattern: "fleet-automation@gunbai-secrets")
    && match review_sheet_live_access(
      credential: SecretRef {
        project: "gunbai-secrets",
        secret: "unused" as NonEmptyStr,
        version: "pending",
        hash_state: HashPending,
      },
    ) {
      ReviewSheetLiveNotAdmitted { admission: a } =>
        match a {
          ReviewSheetAwaitingHuman { intervention: i } =>
            string_contains(s: i.identity as String, pattern: "gcp-serviceusage-enable-iam-")
          ReviewSheetOperatorRefused { reason: _ } => false
          ReviewSheetNeedsApiEnable { plan: _ } => false
          ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
        }
      ReviewSheetLiveOpen { access: _ } => false
    }
}

test fn disabled_sheets_api_on_gunb_test_is_apply_enable() -> Bool {
  match sheets_api_enablement_decision() {
    Apply { plan: p } =>
      (p.project as String) == "gunb-test"
        && (p.service_id as String) == "sheets.googleapis.com"
    Noop => false
    Refuse { reason: _ } => false
  }
    && match sheets_api_enablement_observation {
      ServiceObservedDisabled { project: p, service_id: s } =>
        (p as String) == "gunb-test" && (s as String) == "sheets.googleapis.com"
      ServiceObservedEnabled { project: _, service_id: _ } => false
      ServiceEnablementUnobserved { project: _, service_id: _ } => false
    }
}

test fn enablement_converge_never_disables() -> Bool {
  match decide_service_enablement(
    desired: ServiceDesiredDisabled {
      project: review_sheet_gcp_project,
      service_id: sheets_serviceusage_api_id,
    },
    observed: w_observed_enabled(),
  ) {
    Refuse { reason: r } =>
      string_contains(s: r as String, pattern: "never disables")
        && string_contains(s: r as String, pattern: "sheets.googleapis.com")
    Noop => false
    Apply { plan: _ } => false
  }
}

test fn enabled_readback_is_noop_then_wif_is_awaiting_human() -> Bool {
  match admit_review_sheet_operator(
    desired: sheets_api_desired_enablement,
    enablement: w_observed_enabled(),
    spreadsheet: SpreadsheetAwaitingCreation,
    wif_binding: gcp_fleet_secrets_wif_binding_intervention(),
    serviceusage_enable_iam: w_discharged_iam(),
  ) {
    ReviewSheetAwaitingHuman { intervention: i } =>
      (i.identity as String) == "gcp-fleet-secrets-wif-binding"
        && match i.completion_evidence {
          NoDischargeSiteModeled => true
          DischargedAt { evidence: _ } => false
        }
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

test fn discharged_iam_with_disabled_api_needs_enable_not_a_console_click() -> Bool {
  match admit_review_sheet_operator(
    desired: sheets_api_desired_enablement,
    enablement: w_observed_disabled(),
    spreadsheet: SpreadsheetAwaitingCreation,
    wif_binding: gcp_fleet_secrets_wif_binding_intervention(),
    serviceusage_enable_iam: w_discharged_iam(),
  ) {
    ReviewSheetNeedsApiEnable { plan: p } =>
      (p.project as String) == "gunb-test"
        && (p.service_id as String) == "sheets.googleapis.com"
    ReviewSheetAwaitingHuman { intervention: _ } => false
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

test fn unverified_wif_is_awaiting_human_not_assumed_live() -> Bool {
  match admit_review_sheet_operator(
    desired: sheets_api_desired_enablement,
    enablement: w_observed_enabled(),
    spreadsheet: SpreadsheetAwaitingCreation,
    wif_binding: gcp_fleet_secrets_wif_binding_intervention(),
    serviceusage_enable_iam: w_discharged_iam(),
  ) {
    ReviewSheetAwaitingHuman { intervention: i } =>
      (i.identity as String) == "gcp-fleet-secrets-wif-binding"
        && match i.completion_evidence {
          NoDischargeSiteModeled => true
          DischargedAt { evidence: _ } => false
        }
        && match i.frequency {
          FleetOnce => true
          DeviceOnce => false
          EveryProvision => false
          BreakGlassOnly => false
        }
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

test fn undeclared_spreadsheet_is_fleet_once_create_not_a_caller_string() -> Bool {
  match admit_review_sheet_operator(
    desired: sheets_api_desired_enablement,
    enablement: w_observed_enabled(),
    spreadsheet: SpreadsheetAwaitingCreation,
    wif_binding: w_discharged_wif(),
    serviceusage_enable_iam: w_discharged_iam(),
  ) {
    ReviewSheetAwaitingHuman { intervention: i } =>
      (i.identity as String) == "buyer-review-spreadsheet-create"
        && match i.frequency {
          FleetOnce => true
          DeviceOnce => false
          EveryProvision => false
          BreakGlassOnly => false
        }
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

test fn sharing_is_device_once_editor_with_the_fleet_sa() -> Bool {
  let id = "sheet-abc" as NonEmptyStr
  match admit_review_sheet_operator(
    desired: sheets_api_desired_enablement,
    enablement: w_observed_enabled(),
    spreadsheet: SpreadsheetIdentified { spreadsheet_id: id, owner: "operator" as NonEmptyStr },
    wif_binding: w_discharged_wif(),
    serviceusage_enable_iam: w_discharged_iam(),
  ) {
    ReviewSheetAwaitingHuman { intervention: i } =>
      match i.frequency {
        DeviceOnce =>
          string_contains(s: i.instruction as String, pattern: "fleet-automation@gunbai-secrets")
            && string_contains(s: i.instruction as String, pattern: "Editor")
            && string_contains(s: i.identity as String, pattern: "sheet-abc")
            && match spreadsheet_share_intervention(spreadsheet_id: id).frequency {
              DeviceOnce => true
              FleetOnce => false
              EveryProvision => false
              BreakGlassOnly => false
            }
        FleetOnce => false
        EveryProvision => false
        BreakGlassOnly => false
      }
    ReviewSheetOperatorRefused { reason: _ } => false
    ReviewSheetNeedsApiEnable { plan: _ } => false
    ReviewSheetOperatorAdmitted { spreadsheet_id: _ } => false
  }
}

test fn enablement_state_wire_enabled_is_not_unobserved() -> Bool {
  match sheets_api_enablement_from_service_state(project: review_sheet_gcp_project, state_wire: "ENABLED") {
    ServiceObservedEnabled { project: p, service_id: s } =>
      (p as String) == "gunb-test" && (s as String) == "sheets.googleapis.com"
    ServiceObservedDisabled { project: _, service_id: _ } => false
    ServiceEnablementUnobserved { project: _, service_id: _ } => false
  }
}

test fn iam_grant_is_fleet_once_per_project_not_per_api() -> Bool {
  match serviceusage_enable_iam_grant_intervention(project: review_sheet_gcp_project).frequency {
    FleetOnce =>
      string_contains(
        s: serviceusage_enable_iam_grant_intervention(project: review_sheet_gcp_project).instruction as String,
        pattern: "One grant per project",
      )
    DeviceOnce => false
    EveryProvision => false
    BreakGlassOnly => false
  }
}
