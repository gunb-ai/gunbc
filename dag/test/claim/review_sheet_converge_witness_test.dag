test fn judgement_failures_are_unreadable_not_blank() -> Bool {
  let observed = w_observed(headers: w_headers(), rows: [["L1", "alpha", w_standing_observed(), "buy"]])
  match judgement_for_listing(
    observed: observed,
    identity_column: "missing_id" as NonEmptyStr,
    judgement_column: "judgement" as NonEmptyStr,
    listing_id: "L1" as NonEmptyStr,
  ) {
    JudgementUnreadable { reason: r } =>
      string_contains(s: r as String, pattern: "missing identity column")
        && match judgement_for_listing(
          observed: observed,
          identity_column: "listing_id" as NonEmptyStr,
          judgement_column: "missing_judgement" as NonEmptyStr,
          listing_id: "L1" as NonEmptyStr,
        ) {
          JudgementUnreadable { reason: r2 } =>
            string_contains(s: r2 as String, pattern: "missing judgement column")
              && match judgement_for_listing(
                observed: observed,
                identity_column: "listing_id" as NonEmptyStr,
                judgement_column: "judgement" as NonEmptyStr,
                listing_id: "NOPE" as NonEmptyStr,
              ) {
                JudgementUnreadable { reason: r3 } =>
                  string_contains(s: r3 as String, pattern: "listing not present")
                    && match judgement_for_listing(
                      observed: observed,
                      identity_column: "listing_id" as NonEmptyStr,
                      judgement_column: "judgement" as NonEmptyStr,
                      listing_id: "L1" as NonEmptyStr,
                    ) {
                      JudgementEntered { value: v } => (v as String) == "buy"
                      JudgementBlank => false
                      JudgementUnreadable { reason: _ } => false
                    }
                JudgementBlank => false
                JudgementEntered { value: _ } => false
              }
          JudgementBlank => false
          JudgementEntered { value: _ } => false
        }
    JudgementBlank => false
    JudgementEntered { value: _ } => false
  }
}

test fn judgement_for_duplicate_listing_rows_is_unreadable() -> Bool {
  match judgement_for_listing(
    observed: w_observed(
      headers: w_headers(),
      rows: [
        ["L1", "alpha", w_standing_observed(), "buy"],
        ["L1", "alpha", w_standing_observed(), "reject"],
      ],
    ),
    identity_column: "listing_id" as NonEmptyStr,
    judgement_column: "judgement" as NonEmptyStr,
    listing_id: "L1" as NonEmptyStr,
  ) {
    JudgementUnreadable { reason: r } =>
      string_contains(s: r as String, pattern: "duplicate sheet listing L1")
    JudgementEntered { value: _ } => false
    JudgementBlank => false
  }
}

fn w_generic_operator_schema() -> ReviewSheetSchema {
  ReviewSheetSchema {
    identity_column: "Item" as NonEmptyStr,
    columns: [
      ReviewColumn { name: "Title" as NonEmptyStr, kind: DerivedField { source_field: "title" as NonEmptyStr } },
      ReviewColumn { name: "Qty" as NonEmptyStr, kind: OperatorEntered },
      ReviewColumn { name: "OperatorNote" as NonEmptyStr, kind: OperatorEntered },
    ],
  }
}

test fn classify_review_sheet_append_does_not_write_operator_columns() -> Bool {
  let schema = w_generic_operator_schema()
  let projection = ReviewSheetProjection {
    schema: schema,
    rows: [ProjectionRow {
      listing_id: "v1|123" as NonEmptyStr,
      derived: [DerivedCell { column: "Title" as NonEmptyStr, value: "alpha" }],
    }],
  }
  match classify_review_sheet(
    observed: w_observed(
      headers: ["Item", "Title", "Qty", "OperatorNote"],
      rows: [],
    ),
    projection: projection,
    erasures: [],
  ) {
    ReviewSheetNeedsWrite { plan: p } =>
      write_plan_preserves_operator_columns(schema: schema, plan: p)
        && !write_plan_touches_column(plan: p, column: "Qty" as NonEmptyStr)
        && !write_plan_touches_column(plan: p, column: "OperatorNote" as NonEmptyStr)
    ReviewSheetConverged => false
    ReviewSheetConflict { conflict: _ } => false
    ReviewSheetUnreadable { reason: _ } => false
  }
}

