// WHAT THESE CLAIMS HOLD.
//
// The shared CI emitters (gunbc.ci.repository_ci_profile and the modules that read it) exist so that
// gunbc's repository and its private mirror are rendered by ONE set of emitters from TWO rows. The risk that
// substitution creates is the obvious one: the profile row becomes a second description of the repository
// that its emitters never consult, so it drifts and starts certifying a CI that does not exist. The answer is
// not a witness holding two descriptions equal - the four workflow emitters read identity, runner, timeout,
// cadence and source roots out of this row, and the committed bytes are compared with their emission by the
// authority that owns generated artifacts (dag/gunbc/instruments/tier_o_drift_check.dag). So what is claimed
// here is what no emitter can vouch for itself: that gunbc's own row is well formed, that the shapes a
// repository may not declare are refused before a byte is emitted, and that a declared row becomes a step
// rather than a comment.

fn public_profile() -> RepositoryCiProfile {
  gunbc_repository_ci_profile()
}

// THE ROW IS CHECKED AGAINST THE RULES THAT DECIDE WHAT A REPOSITORY MAY DECLARE - never against a copy of
// the strings the emitters print. The four workflow emitters read identity, runner, timeout and source roots
// out of this row (gunbc.witness.compiler_gate_workflow, gunbc.heal_workflow,
// gunbc.heal_publisher_workflow, gunbc.drift_watch_workflow), so a claim repeating those facts against an
// emitter constant would be two descriptions held equal by a witness. What only the row can answer is what is
// checked: that gunbc's own row is well formed, and that the lanes a repository cannot mix are refused.
test fn the_public_row_is_well_formed_under_the_profile_rules() -> Bool {
  repository_ci_profile_refusal(profile: public_profile()) == no_refusal()
}

// A REPOSITORY THAT DISPATCHES ITS ROSTER THROUGH THE INSTRUMENT CANNOT ALSO DECLARE A SECOND COMPILER. The
// dispatcher runs every row in the checkout that already holds the compiler under test, so a seed row or an
// overlay beside it is a required gate reporting on a binary none of its rows ever ran. Refused by the rules
// rather than by convention, which is what stops the instrument lane and a mirror's composed lane from being
// "simplified" into one shape that quietly runs the wrong compiler.
test fn the_instrument_lane_is_refused_when_it_also_declares_a_seed() -> Bool {
  let refused = match repository_ci_profile_refusal(profile: instrument_lane_with_seed()) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "instrument dispatcher")
    Absent => false
  }
  refused && repository_ci_profile_refusal(profile: public_profile()) == no_refusal()
}

fn no_refusal() -> Optional<NonEmptyStr> {
  Absent
}

// THE GATE'S TIMEOUT IS A FACT ABOUT THE GATE, NOT A VIBRANCY. A required check killed before it can
// report leaves the branch unpromotable with no reason attached, so a non-positive timeout is refused
// before a byte is emitted rather than surfacing as a job that dies in the night.
test fn a_zero_timeout_gate_is_refused() -> Bool {
  match repository_ci_profile_refusal(profile: with_roster_timeout(limit: minute(0))) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "timeout")
    Absent => false
  }
}

// BOTH HALVES OF THE HEAL TRANSACTION OR NEITHER. A seal with no publisher produces repair candidates
// nobody can land; a publisher with no seal is a job whose every run must fail. Either shape looks like
// a working workflow in the file list, which is why it is refused at emit time.
test fn a_seal_without_a_publisher_is_refused_and_both_halves_are_accepted() -> Bool {
  let only_seal = repository_ci_profile_refusal(profile: mirror_profile(seal: true, publish: false))
  let whole = repository_ci_profile_refusal(profile: mirror_profile(seal: true, publish: true))
  match only_seal {
    Present { value: _ } => true
    Absent => false
  }
    && match whole {
         Absent => true
         Present { value: reason } => false
       }
}

// A JOB MAY ONLY PIN ITSELF TO A RUNNER GROUP SOMETHING ENSURES. An undeclared group name is a job that
// never runs: the check stays pending forever, which reads as infrastructure flakiness rather than as a
// reference to a resource that was never created.
test fn an_undeclared_runner_group_is_refused_and_a_declared_one_is_accepted() -> Bool {
  let undeclared = repository_ci_profile_refusal(profile: mirror_profile_on_group(group: "no-such-runner-group"))
  let declared = repository_ci_profile_refusal(profile: mirror_profile_on_group(group: declared_group_name()))
  match undeclared {
    Present { value: _ } => true
    Absent => false
  }
    && match declared {
         Absent => true
         Present { value: reason } => false
       }
}

fn declared_group_name() -> NonEmptyStr {
  match list_head(xs: restricted_runner_groups()) {
    Present { value: g } => g.name
    Absent => "no-groups-are-declared"
  }
}

// THE THREE DISPOSITIONS PARTITION, AND NO FILTER IS THE COMPLEMENT OF ANOTHER. "Not enforced" was a
// faithful reading while there were two kinds; when the third arrived it silently began counting a
// must-not-compile probe as a declared red - reported in the quarantine census, read as debt, and its row
// proposed for retirement. Each filter asks the arm it names.
test fn the_dispositions_partition_and_no_filter_complements_another() -> Bool {
  count(enforced_entries(entries: fixture_roster())) == 2
    && count(known_red_entries(entries: fixture_roster())) == 1
    && count(must_not_compile_entries(entries: fixture_roster())) == 1
    && any(fixture_roster(), e =>
         counted_twice(entry: e)
       ) == false
}

fn counted_twice(entry: RosterEntry) -> Bool {
  count(kinds_matching(entry: entry)) != 1
}

fn kinds_matching(entry: RosterEntry) -> List<String> {
  filter(
    ["enforced", "known-red", "must-not-compile"],
    k => kind_label_matches(entry: entry, label: k)
  )
}

fn kind_label_matches(entry: RosterEntry, label: String) -> Bool {
  if label == "enforced" {
    roster_entry_is_enforced(entry: entry)
  } else if label == "known-red" {
    roster_entry_is_known_red(entry: entry)
  } else {
    roster_entry_is_must_not_compile(entry: entry)
  }
}

// A ROSTER WITH DECLARED-CAUSE ROWS CANNOT RUN THROUGH THE INSTRUMENT DISPATCHER. The dispatcher runs a
// labelled subject and reports green or red; it has no arm that reads a cause set or a declared refusal,
// so under that route a quarantined row would be a passing step and a probe would be a passing step - the
// shape of a check that cannot fail. The emitter asks the ROWS this question rather than trusting the
// route the profile declares.
test fn rows_with_declared_causes_require_the_arm_capable_route() -> Bool {
  roster_needs_declared_cause_arms(entries: fixture_roster())
    && roster_needs_declared_cause_arms(entries: enforced_only_roster()) == false
}

// A QUARANTINE READS BOTH DIRECTIONS. Every declared cause must have occurred, AND every diagnostic that
// came out must be one of the declared causes - presence-only checking let a quarantine pass while new
// defects arrived beside the expected ones. And a red that has started passing fails the run, because the
// row then describes a repository that no longer exists.
test fn the_declared_red_arm_states_both_directions_and_carries_its_trigger() -> Bool {
  let gate = emitted_gate_text(mirror_profile(seal: true, publish: true))
  string_contains(s: gate, pattern: "STALE QUARANTINE")
    && string_contains(s: gate, pattern: "CAUSE DRIFT")
    && string_contains(s: gate, pattern: "UNDECLARED FAILURE")
    && string_contains(s: gate, pattern: "Declare it or fix it")
    && string_contains(s: gate, pattern: "'-vF'")
    && string_contains(s: gate, pattern: "overlay/dag/")
}

// A MUST-NOT-COMPILE PROBE IS EVIDENCE ONLY IF IT REFUSES FOR THE REFUSAL IT NAMES. Any nonzero exit
// satisfies a bare expecting-red check -- a typo in an import refuses too -- so the emitted arm compares
// the diagnostic against the declared refusal, fails the run when a declared refusal is absent, and names
// the wall the probe was supposed to be measuring.
test fn the_must_not_compile_arm_compares_the_refusal_not_the_exit_code() -> Bool {
  let gate = emitted_gate_text(mirror_profile(seal: true, publish: true))
  string_contains(s: gate, pattern: "WALL GONE")
    && string_contains(s: gate, pattern: "PROBE DRIFT")
    && string_contains(s: gate, pattern: "'-qF'")
    && string_contains(s: gate, pattern: "this program MUST NOT COMPILE and it compiled")
    && string_contains(s: gate, pattern: "refused, but NOT for its declared cause")
    && count(must_not_compile_entries(entries: fixture_roster())) == 1
    && string_contains(s: gate, pattern: "dag/claim/d.dag")
    && string_contains(s: gate, pattern: "no such module")
    && string_contains(s: gate, pattern: "the wall that keeps the credential out of the image")
}

// ONE SUBJECT, INVOKED THE SAME WAY IN EVERY REPOSITORY. The argv is built from the row rather than
// assembled at each call site, because the difference between two repositories' CI must be the row and
// never the command construction.
test fn a_subject_is_invoked_through_its_own_roots_entry_and_function() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile(seal: true, publish: true),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerated { content: text } =>
      string_contains(
        s: text,
        pattern: "'--source-root' 'dag' '--source-root' 'src/v2' '--source-root' 'overlay/dag'"
      ) &&
      string_contains(s: text, pattern: "'--entry' 'overlay/dag/dag/claim/projections.dag'") &&
      string_contains(s: text, pattern: "'--function' 'projection_check'")
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => false
  }
}

fn with_roster_timeout(limit: Minute) -> RepositoryCiProfile {
  let base = public_profile()
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: RosterGate {
      workflow_file: base.roster.workflow_file,
      workflow_name: base.roster.workflow_name,
      job_id: base.roster.job_id,
      job_display_name: base.roster.job_display_name,
      required_context: base.roster.required_context,
      runner: base.roster.runner,
      timeout: limit,
      source_roots: base.roster.source_roots,
      schedule: base.roster.schedule,
      memory_budget: base.roster.memory_budget,
      route: base.roster.route,
      annotation: base.roster.annotation
    },
    public_seed: base.public_seed,
    drift: base.drift,
    publisher: base.publisher
  }
}

// A NEUTRAL MIRROR-SHAPED PROFILE. These fixtures are deliberately not the mirror's real row: the public
// corpus must not acquire another repository's module names, entry paths or row names, and the claims
// below are about the SHAPE a profile must have. The mirror's own row lives with the mirror and is
// asserted against these emitters there.
fn mirror_profile(seal: Bool, publish: Bool) -> RepositoryCiProfile {
  mirror_profile_on_group_named(group: FleetSelfHosted, seal: seal, publish: publish)
}

fn mirror_profile_on_group(group: NonEmptyStr) -> RepositoryCiProfile {
  mirror_profile_on_group_named(group: fleet_runner_group_target(group: group), seal: true, publish: true)
}

fn mirror_profile_on_group_named(group: CiRunnerTarget, seal: Bool, publish: Bool) -> RepositoryCiProfile {
  RepositoryCiProfile {
    repository: "example-org/example-mirror",
    default_branch: "main",
    heal: Absent,
    roster: RosterGate {
      workflow_file: "witnesses.yml",
      workflow_name: "witnesses",
      job_id: "witnesses",
      job_display_name: "witnesses",
      required_context: "witnesses",
      runner: group,
      timeout: minute(90),
      source_roots: ["dag", "src/v2"],
      schedule: Present {
        value: CronSchedule {
          minute: Exact { value: 0 },
          hour: Listed { values: [0, 4] },
          day_of_month: Wildcard,
          month: Wildcard,
          day_of_week: Wildcard
        }
      },
      memory_budget: Present { value: byte_size(1073741824) },
      route: ComposedOverlayInterpreterRoster {
        overlay: fixture_overlay(),
        run_roster_step_name: "Run the roster over the composed root"
      },
      annotation: Absent
    },
    public_seed: Present {
      value: fixture_seed()
    },
    drift: Present {
      value: ProjectionDrift {
        workflow_file: "projection-drift.yml",
        workflow_name: "projection-drift",
        job_id: "projection-drift",
        job_display_name: "projection-drift",
        runner: FleetSelfHosted,
        timeout: minute(90),
        // THE MIRROR POLL NOTHING. Its drift check runs on every checkout of a mirror commit, which is
        // the moment a public seed could have moved; a cadence would only re-run the same comparison.
        // (gunbc's own drift watch is the opposite shape: it exists to poll, and its emitter refuses a
        // row with no cadence.)
        cron: Absent,
        check: DagInvocation { entry: "dag/claim/projections.dag", function: "projection_check" },
        seal: if seal {
          Present {
            value: HealSeal {
              invocation: DagInvocation { entry: "dag/claim/heal.dag", function: "heal_seal" },
              seal_step_id: "heal_seal",
              seal_step_name: "Seal a repair candidate",
              upload_step_name: "Upload the repair candidate",
              head_tree_dir_name: "example-mirror-head",
              head_link_name: "head_repo",
              compose_dir_name: "example-mirror-heal-compose",
              candidate_artifact: "repair-candidate",
              banner: "the candidate is sealed here and published by another job"
            }
          }
        } else {
          Absent
        }
      }
    },
    publisher: if publish {
      Present {
        value: HealPublisherPolicy {
          workflow_file: "heal-publish.yml",
          workflow_name: "heal-publish",
          job_id: "publish",
          job_display_name: "publish",
          runner: github_hosted_publisher_runner_target(),
          timeout: minute(45),
          trigger_workflow: "projection-drift",
          candidate_artifact: "repair-candidate",
          admit_invocation: DagInvocation { entry: "dag/claim/heal.dag", function: "heal_admit" },
          publish_invocation: DagInvocation { entry: "dag/claim/heal.dag", function: "heal_publish" },
          // The fixture borrows the public federation rather than inventing a provider path: the claim is
          // about the SHAPE the emitter accepts, and a made-up provider string here would be a fact the
          // witness does not own.
          federation: public_heal_publisher_federation(),
          pull_requests: PermWrite,
          build_route: Own_checkout_under_witness_floor { required_bins: ["gunbc" as NonEmptyStr] }
        }
      }
    } else {
      Absent
    }
  }
}

fn fixture_seed() -> PublicSeed {
  PublicSeed {
    repository: "example-org/example-public",
    checkout_path: "seed_repo",
    ref_name: "main",
    build_command: [
      command(
        words: [
          word(text: "cargo"),
          word(text: "build"),
          word(text: "--release"),
          word(text: "-p"),
          word(text: "example"),
          word(text: "--bin"),
          word(text: "example")
        ]
      )
    ],
    seed_binary_relative_path: "target/release/example",
    record_step_name: "Record the seed revision",
    build_step_name: "Build the seed compiler"
  }
}

fn fixture_overlay() -> OverlayIngest {
  OverlayIngest {
    overlay_dir_name: "overlay",
    entry_prefix: "overlay/dag/",
    repo_link_name: "head_repo",
    compose_dir_name: "example-mirror-compose",
    compose_root_env_default: "/tmp",
    overlay_copy_dissolves_when: unbound_dissolution(description: "gunbc admits an extra --source-root outside the process workspace roots"),
    local_runs_warning: "compose in a temporary directory, never in a session worktree"
  }
}

fn fixture_roster() -> List<RosterEntry> {
  [
    RosterEntry { entry: "dag/claim/a.dag", function: "a_main", kind: Enforced },
    RosterEntry { entry: "dag/claim/b.dag", function: "b_main", kind: Enforced },
    RosterEntry {
      entry: "dag/claim/c.dag",
      function: "c_main",
      kind: KnownRed {
        reason: "the emitter does not yet lower this construct" as NonEmptyStr,
        expected_causes: ["the cause that has not yet arrived"] as List<NonEmptyStr>,
        restoration_trigger: "the emitter lowers the construct" as NonEmptyStr
      }
    },
    RosterEntry {
      entry: "dag/claim/d.dag",
      function: "d_main",
      kind: MustNotCompile {
        guards: "the wall that keeps the credential out of the image" as NonEmptyStr,
        expected_refusals: ["no such module"] as List<NonEmptyStr>,
        dissolution: "the credential is injected at run time" as NonEmptyStr
      }
    }
  ]
}

fn enforced_only_roster() -> List<RosterEntry> {
  [RosterEntry { entry: "dag/claim/a.dag", function: "a_main", kind: Enforced }]
}

// THE GATE EMITTER REFUSES TO EMIT A SECOND REQUIRED CHECK FOR A REPOSITORY THAT ALREADY HAS ONE. A
// repository compiles itself either through the instrument dispatcher or through a composed overlay, not
// both: two workflows claiming one required context means whichever runs last decides promotion, and the
// disagreement is invisible until someone reads both files.
test fn the_instrument_lane_repository_is_refused_by_the_composed_gate_emitter() -> Bool {
  match repository_witness_lane_refusal(profile: public_profile(), program: fixture_program()) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "instrument dispatcher")
    Absent => false
  }
}

// A REQUIRED GATE THAT CAN FAIL IS THE MINIMUM. With no enforced row the script prints banners and exits
// zero forever, so the emitter refuses rather than shipping a check whose green means nothing.
test fn a_gate_with_no_enforced_row_is_refused() -> Bool {
  match repository_witness_lane_refusal(profile: mirror_profile(seal: true, publish: true), program: gate_program(entries: [])) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "cannot fail")
    Absent => false
  }
}

// THE EMITTED GATE CONTAINS THE OBLIGATIONS THAT MAKE THE RUN ATTRIBUTABLE AND THE ARMS THAT MAKE THE
// ROWS EVIDENCE. Each substring is a step a reader would otherwise have to trust the emitter about: the
// seed revision being judged is printed, the compiler is built from source rather than fetched, one
// process runs per row, the quarantined rows are compared against their declared causes in both
// directions, and the two obligations of the composed root (do not edit the copy, do not compose inside a
// session worktree) are echoed by the step that performs them.
test fn the_emitted_gate_carries_the_seed_receipt_the_composition_and_the_declared_cause_arms() -> Bool {
  let yml = expected_repository_witnesses_yml(
    profile: mirror_profile(seal: true, publish: true),
    program: gate_program(entries: fixture_roster())
  )
  yaml_emission_admitted(result: repository_witnesses_yml_emission(
    profile: mirror_profile(seal: true, publish: true),
    program: gate_program(entries: fixture_roster())
  ))
    && string_contains(s: yml, pattern: "--detach")
    && string_contains(s: yml, pattern: "rev-parse")
    && string_contains(s: yml, pattern: "'cargo' 'build' '--release'")
    && string_contains(s: yml, pattern: "exit $fail")
    && string_contains(s: yml, pattern: "CAUSE DRIFT")
    && string_contains(s: yml, pattern: "UNDECLARED FAILURE")
    && string_contains(s: yml, pattern: "STALE QUARANTINE")
    && string_contains(s: yml, pattern: "WALL GONE")
    && string_contains(s: yml, pattern: "PROBE DRIFT")
    && string_contains(s: yml, pattern: "LOCAL RUNS")
    && string_contains(s: yml, pattern: "generated ingest copy")
    && string_contains(s: yml, pattern: "contents: read")
}

// THE TRIGGER THAT RETIRES THE HAND-WRITTEN ROSTER IS PRINTED BY THE STEP THAT NEEDS IT. A declared
// divergence nobody can see is how an interim measure becomes permanent: the row carries the successor
// capability and the emitted step states it, so a reader of a green run learns what would replace this.
test fn the_emitted_gate_prints_the_trigger_that_retires_the_copied_overlay() -> Bool {
  let yml = emitted_gate_text(mirror_profile(seal: true, publish: true))
  string_contains(s: yml, pattern: "Dissolves when")
    && string_contains(s: yml, pattern: "gunbc admits an extra --source-root outside the process workspace roots")
}

// THE MACHINE CLASS IS PROJECTED FROM THE TARGET, NOT TYPED. The gate's runs-on comes from
// ci_runner_target_spec over the profile's CiRunnerTarget, which is what keeps "move CI to another class
// of machine" a one-row edit in the target authority rather than a hunt through shell strings.
test fn the_gate_runs_on_the_selected_target_not_on_a_typed_label() -> Bool {
  let yml = expected_repository_witnesses_yml(
    profile: mirror_profile_on_group(group: declared_group_name()),
    program: gate_program(entries: fixture_roster())
  )
  string_contains(s: yml, pattern: "self-hosted")
    && string_contains(s: yml, pattern: declared_group_name() as String)
}

// THE TIMEOUT IS A DURATION IN THE ROW AND A MINUTE COUNT ONLY AT THE EMIT EDGE. The row carries a
// std.measure `Minute` (Time at the ISO-8601 sixty scale, the same carrier a ruleset's response timeout
// uses); GitHub's `timeout-minutes` is where the number appears, and it is produced by one projection
// (`minute_count`) rather than by a field named for a unit and typed as a bare count. So a row that meant
// ninety seconds could not be spelled `90`, and the emitted step's ceiling is read from the row rather
// than restated next to it.
test fn the_gate_timeout_is_the_rows_duration_projected_at_the_emit_edge() -> Bool {
  string_contains(
    s: emitted_gate_text(profile: mirror_profile(seal: true, publish: true)),
    pattern: "timeout-minutes: 90"
  )
}

// THE CADENCE IS A ROW. A mirror that must notice the seed branch moved without a commit here needs a
// poll; a repository that does not can leave the list empty and get no schedule at all.
test fn a_declared_cadence_becomes_a_schedule_and_an_empty_one_becomes_no_trigger() -> Bool {
  string_contains(s: emitted_gate_text(profile: mirror_profile(seal: true, publish: true)), pattern: "schedule")
    && string_contains(s: emitted_gate_text(profile: gate_profile_without_schedule()), pattern: "schedule") == false
}

fn emitted_gate_text(profile: RepositoryCiProfile) -> String {
  expected_repository_witnesses_yml(profile: profile, program: gate_program(entries: fixture_roster()))
}

fn gate_program(entries: List<RosterEntry>) -> RosterProgram {
  RosterProgram {
    entries: entries,
    aggregate: Present {
      value: RosterAggregate {
        invocation: DagInvocation { entry: "dag/claim/roster.dag", function: "roster_main" },
        pass_banner: "PASS every enforced witness in one process",
        fail_banner: "the roster did not pass"
      }
    },
    roster_authority: "example.repo.roster",
    scaffold_banner: "these rows are quarantined, not deleted",
    checkout_step_name: "Checkout the repository",
    toolchain_step_name: "Install Rust toolchain"
  }
}

fn fixture_program() -> RosterProgram {
  gate_program(entries: fixture_roster())
}

fn gate_profile_without_schedule() -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: RosterGate {
      workflow_file: base.roster.workflow_file,
      workflow_name: base.roster.workflow_name,
      job_id: base.roster.job_id,
      job_display_name: base.roster.job_display_name,
      required_context: base.roster.required_context,
      runner: base.roster.runner,
      timeout: base.roster.timeout,
      source_roots: base.roster.source_roots,
      schedule: Absent,
      memory_budget: base.roster.memory_budget,
      route: base.roster.route,
      annotation: base.roster.annotation
    },
    public_seed: base.public_seed,
    drift: base.drift,
    publisher: base.publisher
  }
}

// ---------------------------------------------------------------------------
// THE SHARED DRIFT CHECK. A mirror's drift job is the same comparison gunbc's own drift watch makes,
// with a seed checked out beside it and a seal at the end. These claims hold the two things that make
// it trustworthy rather than merely similar: the emitter refuses a row that cannot support the job, and
// the seal names its candidate exactly the way the publisher expects to find it.

fn mirror_drift_program() -> DriftProgram {
  DriftProgram {
    checkout_step_name: "Checkout the mirror",
    toolchain_step_name: "Install Rust toolchain",
    check_step_name: "Check every committed projection against its authority",
    check_authority_banner: "projection-drift: every committed projection must equal its authority"
  }
}

fn with_no_drift() -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: base.roster,
    public_seed: base.public_seed,
    drift: Absent,
    publisher: base.publisher
  }
}

// The instrument lane asking for a seed too: gunbc's row with a seed repository declared beside it. The
// refusal claim's subject, and the shape the rules must never accept.
fn instrument_lane_with_seed() -> RepositoryCiProfile {
  let base = public_profile()
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: base.roster,
    public_seed: Present { value: fixture_seed() },
    drift: base.drift,
    publisher: base.publisher
  }
}

fn with_no_seed() -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: base.roster,
    public_seed: Absent,
    drift: base.drift,
    publisher: base.publisher
  }
}

// A DRIFT JOB WITHOUT ITS ROW IS REFUSED, not emitted as an empty job. A workflow file that exists and
// checks nothing is worse than no file, because it reads as coverage.
test fn the_drift_emitter_refuses_a_repository_with_no_drift_row() -> Bool {
  match projection_drift_refusal(profile: with_no_drift()) {
    Present { value: reason } => string_contains(s: reason, pattern: "declares no drift check")
    Absent => false
  }
}

// A MIRROR THAT CLAIMS A SEAL IT CANNOT COMPOSE IS REFUSED. The seal regenerates from the seed's
// compiler over the composed overlay; with no seed row the job would emit steps that reference a
// checkout nobody performed, and the candidate would be bytes from whatever was lying around.
test fn the_drift_emitter_refuses_a_mirror_with_no_seed() -> Bool {
  match projection_drift_refusal(profile: with_no_seed()) {
    Present { value: reason } => string_contains(s: reason, pattern: "needs that seed")
    Absent => false
  }
}

// THE SEAL NAMES THE FACTS THE PUBLISHER READS. The publisher's admit step refuses a candidate that
// does not say which pull request it came from; these names are the contract between the two jobs, so
// they are asserted here rather than left to match by coincidence in two step bodies.
test fn the_seal_names_every_fact_the_publisher_reads() -> Bool {
  let keys = join(list_map(xs: heal_seal_env(), f: fn(b) { b.key as String }), ",")
    string_contains(s: keys, pattern: "HEAD_SHA")
      && string_contains(s: keys, pattern: "HEAL_REPOSITORY")
      && string_contains(s: keys, pattern: "HEAL_PULL_NUMBER")
      && string_contains(s: keys, pattern: "HEAL_HEAD_REF")
      && string_contains(s: keys, pattern: "HEAL_BASE_REF")
      && string_contains(s: keys, pattern: "HEAL_RUN_ID")
}

// THE COMMITTED DRIFT YAML IS THE EMISSION, and it carries the three things the mirror's fork carried:
// the seal composes at the pull request HEAD (not at the merge), the candidate is uploaded as the
// artifact the publisher downloads, and a missing candidate fails the job rather than publishing
// nothing quietly.
test fn the_drift_emission_seals_at_the_head_and_uploads_the_candidate() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile(seal: true, publish: true),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerated { content: text } =>
      string_contains(s: text, pattern: "--detach")
        && string_contains(s: text, pattern: "\"$HEAD_TREE\"")
        && string_contains(s: text, pattern: "name: repair-candidate")
        && string_contains(s: text, pattern: "if-no-files-found: error")
        && string_contains(s: text, pattern: "steps.heal_seal.outcome == 'success'")
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => false
  }
}

// THE MIRROR LANE IS CHECKED, NOT JUST WRITTEN. A frontier row with an empty reason or trigger is how a
// declaration becomes decoration, and `frontier_rows_well_formed` is the check the rest of the corpus uses
// for exactly that. What is asserted on top of it: the lane is non-empty, and each of the five modules that
// exist wholly for the mirror is named by a PathSubject row, so deleting a module's declaration deletes the
// record of why it is allowed to be unread here. What is NOT asserted, and cannot be from inside a claim:
// that the DECL names the roster lists exist. std.roster_frontier builds them as typed `decl_ref` literals,
// and the authority that resolves those against the live declaration index is the decl-ref census instrument
// (gunbc.native_census_verb, dispatched through gunbc/instrument_targets.dag, manual dispatch), which per
// gunbc.recurring_failure_mode.declaration_reference_cites_a_declaration_nothing_resolved refuses an
// unresolved identity BY NAME; resolving refs inside claim evaluation is the repo's declared stall
// (gunbc.guarantee_stall::decl_ref_host_resolver_awaits_native_claim_evaluation_stall), so no Bool here can
// be that check. What is NOT asserted either is that the roster reaches gunbc.census_closure_frontier: the
// fold includes it by construction, and restating what the model already builds is the 4c tell.
test fn the_mirror_frontier_roster_is_well_formed_and_covers_the_lane() -> Bool {
  frontier_rows_well_formed(rows: repository_mirror_frontier_rows)
    && length(xs: repository_mirror_frontier_rows) > 0
    && mirror_lane_module_is_rostered(path: "dag/gunbc/witness/repository_witness_workflow.dag")
    && mirror_lane_module_is_rostered(path: "dag/gunbc/ci/repository_projection_drift_workflow.dag")
    && mirror_lane_module_is_rostered(path: "dag/gunbc/ci/repository_compose_overlay.dag")
    && mirror_lane_module_is_rostered(path: "dag/gunbc/witness/witness_roster.dag")
    && mirror_lane_module_is_rostered(path: "dag/gunbc/ci/repository_seed_steps.dag")
}

// ONE ROW PER MIRROR-LANE FILE, asserted by path. A row that names a file nobody reads is the thing a
// frontier is for; a roster that stops naming a file that is still unread is how the lane drifts back into
// undocumented hand-owned CI.
fn mirror_lane_module_is_rostered(path: String) -> Bool {
  any(
    xs: repository_mirror_frontier_rows,
    f: fn(row) {
      match row.subject {
        PathSubject { path: p } => p == path
        DeclSubject { ref: r } => false
      }
    }
  )
}

// A MIRROR WITH NO CADENCE GETS NO SCHEDULE TRIGGER. It has three: dispatch, push, and the pull request
// that the seal needs. A schedule here would only re-run the same comparison against an unchanged seed.

test fn a_mirror_with_no_cadence_gets_no_schedule_trigger() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile(seal: false, publish: false),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerated { content: text } => !string_contains(s: text, pattern: "on:") == false
      && string_contains(s: text, pattern: "workflow_dispatch")
      && string_contains(s: text, pattern: "pull_request")
      && !string_contains(s: text, pattern: "cron:")
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => false
  }
}

// THE GATE CANNOT BE GREEN WHILE JUDGING NOTHING (review 89571 / side-chat finding 1). An enforced row
// with no aggregate step is refused at the admission the emission itself consumes - the same call the
// emitter makes, so a passing claim here means the emitted gate cannot be the vacuous one.
test fn an_enforced_program_with_no_aggregate_is_refused_at_admission() -> Bool {
  match enforced_rows_need_an_aggregate_refusal(
    program: program_without_aggregate(entries: [
      RosterEntry { entry: "dag/claim/a.dag", function: "a_check", kind: Enforced }
    ])
  ) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "no aggregate step")
    Absent => false
  }
}

test fn a_quarantine_with_no_declared_causes_is_refused_at_admission() -> Bool {
  match lane_admission(
    profile: mirror_profile(seal: true, publish: true),
    program: gate_program(entries: [
      RosterEntry {
        entry: "dag/claim/b.dag",
        function: "b_check",
        kind: KnownRed {
          reason: "quarantined pending the fix",
          expected_causes: [] as List<NonEmptyStr>,
          restoration_trigger: "when the cause is fixed"
        }
      }
    ])
  ) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "declares no expected causes")
    Absent => false
  }
}

test fn a_wall_with_no_expected_refusal_text_is_refused_at_admission() -> Bool {
  match lane_admission(
    profile: mirror_profile(seal: true, publish: true),
    program: gate_program(entries: [
      RosterEntry {
        entry: "dag/claim/c.dag",
        function: "c_check",
        kind: MustNotCompile {
          guards: "the wall",
          expected_refusals: [] as List<NonEmptyStr>,
          dissolution: "when the wall is retired"
        }
      }
    ])
  ) {
    Present { value: reason } => string_contains(s: reason as String, pattern: "no expected refusal text")
    Absent => false
  }
}

// THE DRIFT ENTRYPOINT CONSUMES THE ADMITTED PROFILE (side-chat finding 4): a repository whose profile is
// invalid - here, a runner group no census declared - does not get YAML.
test fn the_drift_entrypoint_refuses_a_repository_whose_runner_group_is_never_declared() -> Bool {
  drift_entrypoint_refuses(profile: mirror_profile_on_group(group: "group-no-census-declared")) &&
  drift_entrypoint_composes_for_a_declared_group()
}

fn drift_entrypoint_refuses(profile: RepositoryCiProfile) -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile_on_group(group: "group-no-census-declared"),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => true
    ProjectionDriftWorkflowGenerated { content: _ } => false
  }
}

fn drift_entrypoint_composes_for_a_declared_group() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile(seal: true, publish: true),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => false
    ProjectionDriftWorkflowGenerated { content: text } => count(text) > 0
  }
}

// THE SEAL IS INVOKED THROUGH THE ROW, LIKE THE CHECK (side-chat finding 3): the roots the seal passes
// come from the admitted profile, so renaming them in the row moves BOTH steps. Before this the seal read
// gunbc's own row through a helper, and the two agreed only because the literals happened to match.
test fn the_seal_step_is_invoked_through_the_rows_roots() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile_with_roots(roots: ["mirror_only", "src/v2"]),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerated { content: text } =>
      string_contains(s: text, pattern: "'--source-root' 'mirror_only'") &&
      string_contains(s: text, pattern: "'--source-root' 'overlay/dag'") &&
      !(string_contains(s: text, pattern: "'--source-root' 'dag'"))
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => false
  }
}

fn program_without_aggregate(entries: List<RosterEntry>) -> RosterProgram {
  let base = gate_program(entries: entries)
  RosterProgram {
    entries: base.entries,
    aggregate: Absent,
    roster_authority: base.roster_authority,
    scaffold_banner: base.scaffold_banner,
    checkout_step_name: base.checkout_step_name,
    toolchain_step_name: base.toolchain_step_name
  }
}

fn mirror_profile_with_roots(roots: List<String>) -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: RosterGate {
      workflow_file: base.roster.workflow_file,
      workflow_name: base.roster.workflow_name,
      job_id: base.roster.job_id,
      job_display_name: base.roster.job_display_name,
      required_context: base.roster.required_context,
      runner: base.roster.runner,
      timeout: base.roster.timeout,
      source_roots: roots,
      schedule: base.roster.schedule,
      memory_budget: base.roster.memory_budget,
      route: base.roster.route,
      annotation: base.roster.annotation
    },
    public_seed: base.public_seed,
    drift: base.drift,
    publisher: base.publisher
  }
}

// THE SEED AND THE OVERLAY ARE THE ROW'S, NOT ARGUMENTS A CALLER MAY BRING (side-chat finding 3, second
// half). The emitters used to take a seed and an overlay beside the profile and only check that the
// profile declared them, so one repository's profile could be paired with another's seed. Now the values
// are read once from the admitted row and threaded through the checkout, the receipt, the build, the check
// and the seal - and a profile that declares no seed is refused instead of being handed a default.
test fn the_gate_emitter_refuses_a_profile_that_declares_no_seed() -> Bool {
  !yaml_emission_admitted(
    result: repository_witnesses_yml_emission(
      profile: mirror_profile_without_seed(),
      program: fixture_program()
    )
  ) &&
    yaml_emission_admitted(
      result: repository_witnesses_yml_emission(
        profile: mirror_profile(seal: true, publish: true),
        program: fixture_program()
      )
    )
}

test fn the_drift_entrypoint_refuses_a_profile_that_declares_no_seed() -> Bool {
  match expected_projection_drift_workflow_yml(
    profile: mirror_profile_without_seed(),
    program: mirror_drift_program()
  ) {
    ProjectionDriftWorkflowGenerationRefused { reason: _ } => true
    ProjectionDriftWorkflowGenerated { content: _ } => false
  }
}

test fn the_seed_the_lane_checks_out_is_the_rows_seed() -> Bool {
  string_contains(
    s: expected_repository_witnesses_yml(
      profile: mirror_profile_with_seed_ref(ref: "rev-9-9-9"),
      program: fixture_program()
    ),
    pattern: "rev-9-9-9"
  )
}

fn mirror_profile_without_seed() -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: base.roster,
    public_seed: none,
    drift: base.drift,
    publisher: base.publisher
  }
}

fn mirror_profile_with_seed_ref(ref: NonEmptyStr) -> RepositoryCiProfile {
  let base = mirror_profile(seal: true, publish: true)
  let seed = match base.public_seed {
    Present { value: s } => s
    Absent => fixture_seed()
  }
  RepositoryCiProfile {
    repository: base.repository,
    default_branch: base.default_branch,
    heal: base.heal,
    roster: base.roster,
    public_seed: Present {
      value: PublicSeed {
        repository: seed.repository,
        ref_name: ref,
        checkout_path: seed.checkout_path,
        build_command: seed.build_command,
        seed_binary_relative_path: seed.seed_binary_relative_path,
        record_step_name: seed.record_step_name,
        build_step_name: seed.build_step_name
      }
    },
    drift: base.drift,
    publisher: base.publisher
  }
}

// EVERY GUNBC EMITTER ADMITS THE ROW BEFORE IT RENDERS (review 89604). The four emitters that read
// gunbc's own row used to call no admission at all: a row pinning a job to a runner group no census
// declared, declaring a heal with no publisher, or carrying a duration that is not positive still produced
// committed YAML. Each emitter now admits first, and each pair below is a discriminator: the same emitter
// function refuses the row it does not admit and composes for gunbc's own.
// THE REQUIRED JOB'S IDENTITY IS THE ADMITTED ROW'S, NOT A GLOBAL ROW'S.
// The fleet-only conjunct of the capability gate compares two lists: the jobs on the merge path and the
// jobs the emitted workflow puts on a hosted runner. If the merge-path list is read from some global row
// while the workflow is built from the profile, the two lists name different repositories and are
// comparable only by accident: rename the required context and move the job to a hosted runner, and the
// merge-path list holds a name no job in the workflow has - disjoint lists, conjunct satisfied, and a
// merge-gating job on a hosted runner lands in a committed workflow, which is what the 2026-09-28 operator
// ruling exists to prevent. So the renamed-and-hosted row must be refused BY THAT CONJUNCT - the refusal
// has to name it, so the control cannot be satisfied by some earlier refusal - and the renamed-but-fleet
// row, the same rename with only the machine changed, must still compose.
test fn renamed_required_job_on_a_hosted_runner_is_refused_by_the_fleet_conjunct() -> Bool {
  let hosted_row = profile_with_required_context(
    profile: profile_with_roster_runner(
      profile: gunbc_repository_ci_profile(),
      runner: github_hosted_publisher_runner_target()
    ),
    name: "renamed-required-context-under-test"
  )
  let fleet_row = profile_with_required_context(
    profile: gunbc_repository_ci_profile(),
    name: "renamed-required-context-under-test"
  )

  match compiler_gate_yml_for(profile: hosted_row) {
    WitnessFloorGenerationRefused { reason: r } =>
      string_contains(s: r, pattern: "FIRST FAILING CONJUNCT: compiler_gate_merge_path_runs_on_the_fleet") &&
      match compiler_gate_yml_for(profile: fleet_row) {
        WitnessFloorGenerated { content: _ } => true
        WitnessFloorGenerationRefused { reason: _ } => false
      }
    WitnessFloorGenerated { content: _ } => false
  }
}

test fn the_four_gunbc_emitters_admit_the_row_before_rendering() -> Bool {
  heal_emitter_admits() &&
    publisher_emitter_admits() &&
    drift_emitter_admits() &&
    gate_emitter_admits()
}

// THE FOUR ADMISSION CONTROLS, ONE PER GUNBC EMITTER.
//
// WHY EACH NEGATIVE IS GUNBC'S OWN VALID ROW WITH ONE FIELD BROKEN. A control that hands an emitter a
// whole foreign row and accepts ANY refusal proves nothing: a mirror-shaped row with no heal job and no
// cadence is refused for those reasons, and the claim stays green while the emitter admits nothing at all.
// So each negative is `gunbc_repository_ci_profile()` - a row every one of these emitters renders - with
// ONE fact changed by the profile module's own updater: the runner of the job that emitter is about to
// render, pinned to a group no census declares. That is the only conjunct that can refuse these rows, the
// claim requires the refusal to SAY so, and if the emitter's admission call is deleted the negative renders
// a workflow and the claim goes red. The claim also asserts the job is declared at all, because an updater
// on an absent arm changes nothing and a control that mutated nothing would pass by proving nothing.
// A BUILD ROUTE THAT NAMES A SEED THE ROW DOES NOT DECLARE IS REFUSED, by the row and by the emitter that
// would otherwise render it. The negative is gunbc's OWN row with that single field changed by the profile
// module's updater, so the refusal can only be that field's; the claim requires its words rather than any
// refusal, asserts the publisher is declared at all (an edit to an absent arm changes nothing and proves
// nothing), and requires gunbc's untouched row still to compose through the same emitter.
// THE BUILD ROUTE IS THE AUTHORITY OVER THE BUILD STEPS - NOT WHICH OTHER FIELDS HAPPEN TO BE PRESENT,
// which is exactly how this module once gave one repository another repository's build. ONE PROFILE, ONE
// FIELD CHANGED: the route that names the profile's own seed yields the seed's checkout, the floor's
// toolchain and the seed's build command; the route that names this checkout yields the toolchain-home
// isolation, the floor's toolchain, the rustup pin and this checkout's self-build. THE TWO SETS MUST BE
// DISJOINT - an emitter that picked a build by whether a seed was declared would produce the same steps for
// both routes and go red here, rather than shipping gunbc's build under a mirror's row or a mirror's seed
// build under gunbc's. The names asserted are read from the row (the seed's own build step) and from the
// builders the emitter calls, so the claim is about which steps were SELECTED, not about a substring of
// rendered YAML.
fn publisher_route_step_names(row: RepositoryCiProfile) -> Optional<List<String>> {
  match row.publisher {
    Absent => Absent
    Present { value: job } =>
      // THE ROUTE ANSWERS WITH A VERDICT, not with a bare absence: a refused route has no names to read,
      // which is a different fact from a route that produced steps.
      match heal_publisher_route_steps(profile: row, job: job) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: steps, diagnostics: _ } =>
          Present { value: list_map(xs: steps, f: fn(b) { step_display_name(s: b.step) }) }
      }
  }
}

test fn the_publisher_build_route_selects_the_build_steps_and_not_the_presence_of_a_seed() -> Bool {
  let seed_route = publisher_route_step_names(
    row: profile_with_publisher_build_route(profile: mirror_profile(seal: true, publish: true), route: Declared_seed)
  )
  let own_route = publisher_route_step_names(
    row: profile_with_publisher_build_route(
      profile: mirror_profile(seal: true, publish: true),
      route: Own_checkout_under_witness_floor { required_bins: ["gunbc" as NonEmptyStr] }
    )
  )
  match seed_route {
    Absent => false
    Present { value: seed_names } =>
      match own_route {
        Absent => false
        Present { value: own_names } =>
          // The isolation step is in ONE list and not the other, and the seed's own build step is in the
          // other and not that one. Both directions are required: a single-direction check would pass if
          // the emitter simply always emitted the checkout route, and the second pair rules out always
          // emitting the seed route.
          any(own_names, n => n == step_display_name(s: toolchain_home_isolation_step())) &&
            all(seed_names, n => n != step_display_name(s: toolchain_home_isolation_step())) &&
            any(seed_names, n => n == fixture_seed().build_step_name as String) &&
            all(own_names, n => n != fixture_seed().build_step_name as String)
      }
  }
}

data build_route_refusal_phrase: String = "profile declares no seed to build"

fn publisher_row_on_undeclared_seed_route() -> RepositoryCiProfile {
  profile_with_publisher_build_route(profile: gunbc_repository_ci_profile(), route: Declared_seed)
}

test fn a_build_route_naming_a_seed_the_row_does_not_declare_is_refused_by_the_row_and_the_emitter() -> Bool {
  match gunbc_repository_ci_profile().publisher {
    Absent => false
    Present { value: _ } =>
      match repository_ci_profile_refusal(profile: publisher_row_on_undeclared_seed_route()) {
        Absent => false
        Present { value: why } =>
          string_contains(s: why as String, pattern: build_route_refusal_phrase) &&
            match heal_publisher_workflow_yml_for(profile: publisher_row_on_undeclared_seed_route()) {
              HealPublisherWorkflowGenerationRefused { reason: r } =>
                string_contains(s: r, pattern: build_route_refusal_phrase) &&
                  match heal_publisher_workflow_yml_for(profile: gunbc_repository_ci_profile()) {
                    HealPublisherWorkflowGenerationRefused { reason: _ } => false
                    HealPublisherWorkflowGenerated { content: _ } => true
                  }
              HealPublisherWorkflowGenerated { content: _ } => false
            }
      }
  }
}

data emitter_group_refusal_phrase: String = "runner group that gunbc.runner.runner_group_restriction_ensure does not declare"

fn undeclared_group_runner() -> CiRunnerTarget {
  // A group name no ensure in gunbc.runner.runner_group_restriction_ensure declares - the same name the
  // mirror-lane control uses, so one fabricated name is the lie in both controls.
  fleet_runner_group_target(group: "group-no-census-declared")
}

fn gate_row_on_undeclared_group() -> RepositoryCiProfile {
  profile_with_roster_runner(profile: gunbc_repository_ci_profile(), runner: undeclared_group_runner())
}

fn heal_row_on_undeclared_group() -> RepositoryCiProfile {
  profile_with_heal_runner(profile: gunbc_repository_ci_profile(), runner: undeclared_group_runner())
}

fn drift_row_on_undeclared_group() -> RepositoryCiProfile {
  profile_with_drift_runner(profile: gunbc_repository_ci_profile(), runner: undeclared_group_runner())
}

fn publisher_row_on_undeclared_group() -> RepositoryCiProfile {
  profile_with_publisher_runner(profile: gunbc_repository_ci_profile(), runner: undeclared_group_runner())
}

// THE SHAPE ALL FOUR CONTROLS SHARE: the row is refused BY THE PROFILE CHECK for the group reason, the
// emitter refuses too and reports the check's own words (not its own paraphrase, not a different
// conjunct), and gunbc's untouched row still composes through the same emitter.
fn emitter_refuses_where_the_row_is_refused(
  row: RepositoryCiProfile,
  emitter_refused: Bool,
  emitter_reason: String,
  emitter_composes_for_gunbc_row: Bool
) -> Bool {
  match repository_ci_profile_refusal(profile: row) {
    Absent => false
    Present { value: why } =>
      string_contains(s: why as String, pattern: emitter_group_refusal_phrase) &&
      emitter_refused &&
      string_contains(s: emitter_reason, pattern: emitter_group_refusal_phrase) &&
      string_contains(s: emitter_reason, pattern: why as String) &&
      emitter_composes_for_gunbc_row
  }
}

fn heal_emitter_admits() -> Bool {
  match gunbc_repository_ci_profile().heal {
    Absent => false
    Present { value: _ } =>
      match heal_workflow_yml_for(profile: heal_row_on_undeclared_group()) {
        HealWorkflowGenerationRefused { reason: r } => emitter_refuses_where_the_row_is_refused(
          row: heal_row_on_undeclared_group(),
          emitter_refused: true,
          emitter_reason: r,
          emitter_composes_for_gunbc_row: match heal_workflow_yml_for(profile: gunbc_repository_ci_profile()) {
            HealWorkflowGenerationRefused { reason: _ } => false
            HealWorkflowGenerated { content: _ } => true
          }
        )
        HealWorkflowGenerated { content: _ } => false
      }
  }
}

fn publisher_emitter_admits() -> Bool {
  match gunbc_repository_ci_profile().publisher {
    Absent => false
    Present { value: _ } =>
      match heal_publisher_workflow_yml_for(profile: publisher_row_on_undeclared_group()) {
        HealPublisherWorkflowGenerationRefused { reason: r } => emitter_refuses_where_the_row_is_refused(
          row: publisher_row_on_undeclared_group(),
          emitter_refused: true,
          emitter_reason: r,
          emitter_composes_for_gunbc_row: match heal_publisher_workflow_yml_for(profile: gunbc_repository_ci_profile()) {
            HealPublisherWorkflowGenerationRefused { reason: _ } => false
            HealPublisherWorkflowGenerated { content: _ } => true
          }
        )
        HealPublisherWorkflowGenerated { content: _ } => false
      }
  }
}

fn drift_emitter_admits() -> Bool {
  match gunbc_repository_ci_profile().drift {
    Absent => false
    Present { value: _ } =>
      match drift_watch_workflow_yml_for(profile: drift_row_on_undeclared_group()) {
        DriftWatchWorkflowGenerationRefused { reason: r } => emitter_refuses_where_the_row_is_refused(
          row: drift_row_on_undeclared_group(),
          emitter_refused: true,
          emitter_reason: r,
          emitter_composes_for_gunbc_row: match drift_watch_workflow_yml_for(profile: gunbc_repository_ci_profile()) {
            DriftWatchWorkflowGenerationRefused { reason: _ } => false
            DriftWatchWorkflowGenerated { content: _ } => true
          }
        )
        DriftWatchWorkflowGenerated { content: _ } => false
      }
  }
}

fn gate_emitter_admits() -> Bool {
  match compiler_gate_yml_for(profile: gate_row_on_undeclared_group()) {
    WitnessFloorGenerationRefused { reason: r } => emitter_refuses_where_the_row_is_refused(
      row: gate_row_on_undeclared_group(),
      emitter_refused: true,
      emitter_reason: r,
      emitter_composes_for_gunbc_row: match compiler_gate_yml_for(profile: gunbc_repository_ci_profile()) {
        WitnessFloorGenerationRefused { reason: _ } => false
        WitnessFloorGenerated { content: _ } => true
      }
    )
    WitnessFloorGenerated { content: _ } => false
  }
}

// AN OVERLAY HAS TO COMPOSE INTO A DECLARED SEED. The overlay is copied into a detached tree checked out
// from the row's public seed, and the publisher's phases run inside that composed root. A row that declares
// the overlay with no seed has no tree to compose into, and the publisher would run its admit and publish
// steps in its own checkout - sealing a candidate from one composition and admitting it against another,
// which is the drift the publisher exists to prevent. Built from the MIRROR row that does declare a seed,
// with that one field removed, so the refusal can only be the missing seed's; and the admitted contrast is
// asked of the same builder with the seed left in, so this cannot pass because a fixture is mis-shapen.
test fn an_overlay_with_no_declared_seed_is_refused_by_the_row_and_the_emitter() -> Bool {
  let overlay_carried = match profile_overlay(profile: mirror_profile_without_seed()) {
    Present { value: _ } => true
    Absent => false
  }
  match overlay_carried {
    false => false
    true =>
      match repository_ci_profile_refusal(profile: mirror_profile_without_seed()) {
        Absent => false
        Present { value: why } =>
          string_contains(s: why as String, pattern: "profile_overlay_has_a_declared_seed") &&
            // THE SAME BUILDER, ONE FIELD DIFFERENT: the row that DOES declare its seed is admitted, and
            // the predicate that refused its twin says true for it. A fixture mis-shapen in some other
            // field would fail here rather than pass on an unrelated refusal.
            match repository_ci_profile_refusal(profile: mirror_profile(seal: true, publish: true)) {
              Present { value: other } => false
              Absent => profile_overlay_has_a_declared_seed(profile: mirror_profile(seal: true, publish: true))
            } &&
            // THE EMITTER REFUSES TOO - it is not allowed to render the silent downgrade and leave the
            // operator to notice which composition its candidate came from.
            match heal_publisher_workflow_yml_for(profile: mirror_profile_without_seed()) {
              HealPublisherWorkflowGenerationRefused { reason: _ } => true
              HealPublisherWorkflowGenerated { content: _ } => false
            }
      }
  }
}

// A SEED ROW THE BASH GRAMMAR CANNOT FOLD. `command(words: [])` plants the grammar's refused-empty word-list
// placeholder: `v2.workflow.bash_command_fold_serialize.bash_fold_serialize_stmt_list_shape_refused` refuses
// it because a zero-child statement list is not a statement. Row admission never folds a build command, so
// this row is ADMITTED and the failure happens later, when the publisher resolves its build steps - which is
// exactly the path a refusal has to travel to reach a caller, and the path the earlier version of this
// control did not run.
fn publisher_row_with_unfoldable_seed_build() -> RepositoryCiProfile {
  let base = profile_with_publisher_build_route(profile: mirror_profile(seal: true, publish: true), route: Declared_seed)
  match base.public_seed {
    Absent => base
    Present { value: seed } =>
      RepositoryCiProfile {
        repository: base.repository,
        default_branch: base.default_branch,
        heal: base.heal,
        roster: base.roster,
        public_seed: Present {
          value: PublicSeed {
            repository: seed.repository,
            ref_name: seed.ref_name,
            checkout_path: seed.checkout_path,
            build_command: [ command(words: []) ],
            seed_binary_relative_path: seed.seed_binary_relative_path,
            record_step_name: seed.record_step_name,
            build_step_name: seed.build_step_name
          }
        },
        drift: base.drift,
        publisher: base.publisher
      }
  }
}

// THE PUBLISHER'S REFUSAL CARRIES THE IDENTITY OF WHAT REFUSED, AT THE ENTRYPOINT THE CALLER USES. The row is
// admitted - so a refusal here can only be the seed grammar's - and the reason the caller receives must name
// the diagnostic that refused, composed from the diagnostics that travelled out of the resolution. Folding a
// `Rejected` into a bare absence and inferring a cause from `build_route` (the shape this module had before
// review 89844) drops the lexeme and turns this red; so does an entrypoint that hard-codes a reason instead
// of composing one from what refused.
test fn the_unfoldable_seed_row_is_admitted_by_the_profile() -> Bool {
  match repository_ci_profile_refusal(profile: publisher_row_with_unfoldable_seed_build()) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn the_unfoldable_seed_build_is_refused_by_the_step_resolution() -> Bool {
  let row = publisher_row_with_unfoldable_seed_build()
  match row.publisher {
    Absent => false
    Present { value: job } =>
      match heal_publisher_resolved_steps(profile: row, job: job) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
  }
}

test fn the_publisher_refusal_names_the_diagnostic_that_refused_it() -> Bool {
  let row = publisher_row_with_unfoldable_seed_build()
  match row.publisher {
    Absent => false
    Present { value: job } =>
      match heal_publisher_resolved_steps(profile: row, job: job) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: d } =>
          match heal_publisher_workflow_yml_for(profile: row) {
            HealPublisherWorkflowGenerated { content: _ } => false
            HealPublisherWorkflowGenerationRefused { reason: r } =>
              // THE CALLER READS WHAT REFUSED. The reason string handed to a caller has to carry the very
              // lexemes the resolution carried - not a cause reconstructed from `build_route`, and not a
              // fixed sentence about the build. `the_unfoldable_seed_build_is_refused_by_the_step_resolution`
              // proves a refusal exists; this proves it survives the trip to the caller.
              string_contains(s: r, pattern: diagnostics_reason_lexemes(diagnostics: d))
          }
      }
  }
}
