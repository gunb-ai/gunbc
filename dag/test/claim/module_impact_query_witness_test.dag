module test.claim.module_impact_query_witness_test


data module_impact_query_witness_note: String = "Controlled fixtures: every input population and every expected population is authored here, so no assertion is a measurement of the current tree copied back onto itself (DESIGN 5 oracle rule). Three discriminating families. (1) The cycle pair - all_import vs mixed - has identical topology and different provenance, so a union-grain classifier reds on one while passing the other. (2) The two-disjoint-cycles fixture is the regression control for review 50459: the pre-fix union-level verdict greened its own suite while suppressing a real violation. (3) The pool-mismatch fixture is the control for the operator's F3 finding: an edge whose target is declared-but-absent from the pool used to vanish silently while the reading still answered complete."

data fixture_nodes: List<v2.lens.module_graph.ModuleDeclarationFact> = [
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.a", path: "fixture/a.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.b", path: "fixture/b.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.c", path: "fixture/c.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.d", path: "fixture/d.dag" },
]

data mod_a: v2.lens.module_impact_query.ModuleIdentity = v2.lens.module_impact_query.ModuleIdentity { name: "m.a" }
data mod_b: v2.lens.module_impact_query.ModuleIdentity = v2.lens.module_impact_query.ModuleIdentity { name: "m.b" }
data mod_c: v2.lens.module_impact_query.ModuleIdentity = v2.lens.module_impact_query.ModuleIdentity { name: "m.c" }

data pool_independence_unavailable: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission> = [
  gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
    capability: gunbc.namespace_reference_derived_closure_admission.UnrelatedLoadedFileExcluded,
    trigger: gunbc.namespace_reference_derived_closure_admission.P2aPoolIndependentDependencyProjection7515
  },
]

data pool_independence_established_note: String = "ReferenceDerivedClosureAcceptanceReceipt is sole_constructor, so a consumer CANNOT fabricate an Established capability from outside the admission module - the wall refused this witness's first attempt to hand-build the receipt, which is exactly the point of the wall. The admission module's own `established` constructor is the only legitimate route, so the witness goes through it."

data pool_independence_established: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission> = [
  gunbc.namespace_reference_derived_closure_admission.established(capability: gunbc.namespace_reference_derived_closure_admission.UnrelatedLoadedFileExcluded),
]

data unrelated_admission_only: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission> = [
  gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
    capability: gunbc.namespace_reference_derived_closure_admission.RepeatedMentionsCollapseDependency,
    trigger: gunbc.namespace_reference_derived_closure_admission.P2aReferenceDependencyProjection7515
  },
]

data chain_edges: List<v2.lens.module_graph.ModuleDependencyEdge> = [
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/a.dag", target_module: "m.b", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/b.dag", target_module: "m.c", target_declared: true },
]

data chain_import_facts: List<v2.lens.module_graph.ImportResolutionFact> = [
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/a.dag", import_module: "m.b", target_declared: true },
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/b.dag", import_module: "m.c", target_declared: true },
]

fn chain_reading(
  seeds: List<v2.lens.module_impact_query.ModuleIdentity>,
  admissions: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission>
) -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: seeds,
    direction: v2.lens.module_impact_query.DependentsOf,
    edges: chain_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: admissions
  )
}

fn reached_has(reading: v2.lens.module_impact_query.ImpactReading, wanted: String) -> Bool {
  v2.std.algebra.any(xs: reading.reached, predicate: fn(m) { m.name == wanted })
}

test fn witness_dependents_of_walks_the_edge_population_backwards() -> Bool {
  let reading = chain_reading(seeds: [mod_c], admissions: unrelated_admission_only)
  reached_has(reading: reading, wanted: "m.c")
    && reached_has(reading: reading, wanted: "m.b")
    && reached_has(reading: reading, wanted: "m.a")
    && v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true }) == 3
}

test fn witness_dependencies_of_is_the_opposite_direction() -> Bool {
  let reading = v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: chain_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: unrelated_admission_only
  )
  v2.std.algebra.any(xs: reading.reached, predicate: fn(m) { m.name == "m.c" })
    && v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true }) == 3
}

test fn witness_dependents_of_a_leaf_source_reaches_only_itself() -> Bool {
  let reading = chain_reading(seeds: [mod_a], admissions: unrelated_admission_only)
  v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true }) == 1
}

test fn witness_core_is_keyed_on_module_identity_not_path() -> Bool {
  let reading = chain_reading(seeds: [mod_c], admissions: unrelated_admission_only)
  v2.std.algebra.any(xs: reading.explanation, predicate: fn(edge) {
    edge.dependent_module.name == "m.a" && edge.dependency_module.name == "m.b"
  })
    && v2.std.algebra.any(xs: reading.reached, predicate: fn(m) { m.name == "m.a" })
    && v2.std.algebra.count_where(xs: reading.reached, predicate: fn(m) { m.name == "fixture/a.dag" }) == 0
}

test fn witness_path_adapter_projects_a_file_question_to_semantic_seeds() -> Bool {
  let seeds = v2.lens.module_impact_query.impact_seeds_for_path(nodes: fixture_nodes, path: "fixture/a.dag")
  v2.std.algebra.count_where(xs: seeds, predicate: fn(_) { true }) == 1
    && v2.std.algebra.any(xs: seeds, predicate: fn(m) { m.name == "m.a" })
}

test fn witness_path_adapter_invents_no_seed_for_an_unknown_path() -> Bool {
  v2.std.algebra.count_where(
    xs: v2.lens.module_impact_query.impact_seeds_for_path(nodes: fixture_nodes, path: "fixture/nowhere.dag"),
    predicate: fn(_) { true }
  ) == 0
}

test fn witness_paths_project_back_for_presentation() -> Bool {
  let paths = v2.lens.module_impact_query.impact_paths_for_module(nodes: fixture_nodes, module_id: mod_a)
  v2.std.algebra.count_where(xs: paths, predicate: fn(_) { true }) == 1
    && v2.std.algebra.contains(xs: paths, item: "fixture/a.dag", eq: fn(x, y) { x == y })
}

test fn witness_pool_independence_unavailable_forbids_an_exact_standing() -> Bool {
  match chain_reading(seeds: [mod_c], admissions: pool_independence_unavailable).standing {
    v2.lens.module_impact_query.PoolIndependentProjectionUnavailable { trigger } =>
      match trigger {
        gunbc.namespace_reference_derived_closure_admission.P2aPoolIndependentDependencyProjection7515 => true
        _ => false
      }
    v2.lens.module_impact_query.ExactForGraphSubject => false
    v2.lens.module_impact_query.ProvisionalForObservedPool => false
    v2.lens.module_impact_query.Incomplete { causes: _ } => false
  }
}

test fn witness_clean_pool_without_established_independence_is_only_provisional() -> Bool {
  match chain_reading(seeds: [mod_c], admissions: unrelated_admission_only).standing {
    v2.lens.module_impact_query.ProvisionalForObservedPool => true
    v2.lens.module_impact_query.ExactForGraphSubject => false
    v2.lens.module_impact_query.Incomplete { causes: _ } => false
    v2.lens.module_impact_query.PoolIndependentProjectionUnavailable { trigger: _ } => false
  }
}

test fn witness_exact_standing_requires_established_pool_independence() -> Bool {
  match chain_reading(seeds: [mod_c], admissions: pool_independence_established).standing {
    v2.lens.module_impact_query.ExactForGraphSubject => true
    v2.lens.module_impact_query.ProvisionalForObservedPool => false
    v2.lens.module_impact_query.Incomplete { causes: _ } => false
    v2.lens.module_impact_query.PoolIndependentProjectionUnavailable { trigger: _ } => false
  }
}

data undeclared_target_edges: List<v2.lens.module_graph.ModuleDependencyEdge> = [
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/a.dag", target_module: "m.b", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/b.dag", target_module: "m.outside_pool", target_declared: false },
]

test fn witness_undeclared_target_lands_as_a_typed_cause() -> Bool {
  let reading = v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: undeclared_target_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: pool_independence_established
  )
  v2.std.algebra.count_where(xs: reading.causes, predicate: fn(_) { true }) == 1
    && v2.std.algebra.any(xs: reading.causes, predicate: fn(cause) {
      match cause {
        v2.lens.module_impact_query.UndeclaredTargetModule { dependent_module, target_module } =>
          dependent_module.name == "m.b" && target_module == "m.outside_pool"
        v2.lens.module_impact_query.DeclaredTargetAbsentFromPool { dependent_module: _, target_module: _ } => false
      }
    })
}

data declared_but_absent_edges: List<v2.lens.module_graph.ModuleDependencyEdge> = [
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/a.dag", target_module: "m.b", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/b.dag", target_module: "m.ghost", target_declared: true },
]

data pool_mismatch_note: String = "F3 control (operator ruling 2026-08-08). m.ghost is target_declared TRUE but has no ModuleDeclarationFact in fixture_nodes - the producer believed it declared, the supplied pool does not carry it. The pre-recut implementation resolved that edge to zero rows, dropped it from adjacency/closure/cycles, and computed completeness from the raw declared flag alone, so the reading answered CLOSED on an inconsistent pool. The two observations are now independent, so this must surface as DeclaredTargetAbsentFromPool and must NOT be reported as an undeclared target."

test fn witness_declared_but_absent_target_is_not_silently_dropped() -> Bool {
  let reading = v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: declared_but_absent_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: pool_independence_established
  )
  v2.std.algebra.count_where(xs: reading.causes, predicate: fn(_) { true }) == 1
    && v2.std.algebra.any(xs: reading.causes, predicate: fn(cause) {
      match cause {
        v2.lens.module_impact_query.DeclaredTargetAbsentFromPool { dependent_module, target_module } =>
          dependent_module.name == "m.b" && target_module == "m.ghost"
        v2.lens.module_impact_query.UndeclaredTargetModule { dependent_module: _, target_module: _ } => false
      }
    })
}

test fn witness_pool_mismatch_forbids_an_exact_standing() -> Bool {
  let reading = v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: declared_but_absent_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: pool_independence_established
  )
  match reading.standing {
    v2.lens.module_impact_query.Incomplete { causes } => v2.std.algebra.count_where(xs: causes, predicate: fn(_) { true }) == 1
    v2.lens.module_impact_query.ExactForGraphSubject => false
    v2.lens.module_impact_query.ProvisionalForObservedPool => false
    v2.lens.module_impact_query.PoolIndependentProjectionUnavailable { trigger: _ } => false
  }
}

data cycle_edges: List<v2.lens.module_graph.ModuleDependencyEdge> = [
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/a.dag", target_module: "m.b", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/b.dag", target_module: "m.a", target_declared: true },
]

data all_import_cycle_facts: List<v2.lens.module_graph.ImportResolutionFact> = [
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/a.dag", import_module: "m.b", target_declared: true },
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/b.dag", import_module: "m.a", target_declared: true },
]

data mixed_cycle_facts: List<v2.lens.module_graph.ImportResolutionFact> = [
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/a.dag", import_module: "m.b", target_declared: true },
]

fn cycle_reading(facts: List<v2.lens.module_graph.ImportResolutionFact>) -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: cycle_edges,
    nodes: fixture_nodes,
    import_facts: facts,
    admissions: unrelated_admission_only
  )
}

fn cycle_has_member(cycle: v2.lens.module_impact_query.ImpactCycle, wanted: String) -> Bool {
  match cycle {
    v2.lens.module_impact_query.ImpactImportAcyclicityViolation { members } =>
      v2.std.algebra.any(xs: members, predicate: fn(m) { m.name == wanted })
    v2.lens.module_impact_query.ImpactCycleReferenceAdmissible { members } =>
      v2.std.algebra.any(xs: members, predicate: fn(m) { m.name == wanted })
  }
}

test fn witness_all_import_cycle_is_an_acyclicity_violation() -> Bool {
  let cycles = v2.lens.module_impact_query.module_cycle_analysis(reading: cycle_reading(facts: all_import_cycle_facts)).cycles
  v2.std.algebra.count_where(xs: cycles, predicate: fn(_) { true }) == 1
    && v2.std.algebra.any(xs: cycles, predicate: fn(cycle) {
      match cycle {
        v2.lens.module_impact_query.ImpactImportAcyclicityViolation { members } =>
          v2.std.algebra.count_where(xs: members, predicate: fn(_) { true }) == 2
        v2.lens.module_impact_query.ImpactCycleReferenceAdmissible { members: _ } => false
      }
    })
}

test fn witness_cycle_with_a_reference_derived_edge_is_admissible() -> Bool {
  let cycles = v2.lens.module_impact_query.module_cycle_analysis(reading: cycle_reading(facts: mixed_cycle_facts)).cycles
  v2.std.algebra.count_where(xs: cycles, predicate: fn(_) { true }) == 1
    && v2.std.algebra.any(xs: cycles, predicate: fn(cycle) {
      match cycle {
        v2.lens.module_impact_query.ImpactImportAcyclicityViolation { members: _ } => false
        v2.lens.module_impact_query.ImpactCycleReferenceAdmissible { members } =>
          v2.std.algebra.count_where(xs: members, predicate: fn(_) { true }) == 2
      }
    })
}

test fn witness_acyclic_population_reports_no_cycle() -> Bool {
  v2.std.algebra.count_where(
    xs: v2.lens.module_impact_query.module_cycle_analysis(reading: chain_reading(seeds: [mod_c], admissions: unrelated_admission_only)).cycles,
    predicate: fn(_) { true }
  ) == 0
}

data two_disjoint_cycle_edges: List<v2.lens.module_graph.ModuleDependencyEdge> = [
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/a.dag", target_module: "m.b", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/b.dag", target_module: "m.a", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/c.dag", target_module: "m.d", target_declared: true },
  v2.lens.module_graph.ModuleDependencyEdge { path: "fixture/d.dag", target_module: "m.c", target_declared: true },
]

data two_disjoint_cycle_import_facts: List<v2.lens.module_graph.ImportResolutionFact> = [
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/a.dag", import_module: "m.b", target_declared: true },
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/b.dag", import_module: "m.a", target_declared: true },
  v2.lens.module_graph.ImportResolutionFact { path: "fixture/c.dag", import_module: "m.d", target_declared: true },
]

fn two_disjoint_cycles_reading() -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [mod_a, mod_c],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: two_disjoint_cycle_edges,
    nodes: fixture_nodes,
    import_facts: two_disjoint_cycle_import_facts,
    admissions: unrelated_admission_only
  )
}

test fn witness_two_disjoint_cycles_are_classified_separately() -> Bool {
  v2.std.algebra.count_where(xs: v2.lens.module_impact_query.module_cycle_analysis(reading: two_disjoint_cycles_reading()).cycles, predicate: fn(_) { true }) == 2
}

test fn witness_all_import_cycle_survives_a_reference_cycle_elsewhere() -> Bool {
  v2.std.algebra.any(xs: v2.lens.module_impact_query.module_cycle_analysis(reading: two_disjoint_cycles_reading()).cycles, predicate: fn(cycle) {
    match cycle {
      v2.lens.module_impact_query.ImpactImportAcyclicityViolation { members } =>
        v2.std.algebra.count_where(xs: members, predicate: fn(_) { true }) == 2
          && cycle_has_member(cycle: cycle, wanted: "m.a")
          && cycle_has_member(cycle: cycle, wanted: "m.b")
      v2.lens.module_impact_query.ImpactCycleReferenceAdmissible { members: _ } => false
    }
  })
}

test fn witness_reference_cycle_stays_admissible_beside_an_import_cycle() -> Bool {
  v2.std.algebra.any(xs: v2.lens.module_impact_query.module_cycle_analysis(reading: two_disjoint_cycles_reading()).cycles, predicate: fn(cycle) {
    match cycle {
      v2.lens.module_impact_query.ImpactImportAcyclicityViolation { members: _ } => false
      v2.lens.module_impact_query.ImpactCycleReferenceAdmissible { members } =>
        v2.std.algebra.count_where(xs: members, predicate: fn(_) { true }) == 2
          && cycle_has_member(cycle: cycle, wanted: "m.c")
          && cycle_has_member(cycle: cycle, wanted: "m.d")
    }
  })
}

test fn witness_no_component_merges_modules_from_distinct_cycles() -> Bool {
  v2.std.algebra.any(xs: v2.lens.module_impact_query.module_cycle_analysis(reading: two_disjoint_cycles_reading()).cycles, predicate: fn(cycle) {
    cycle_has_member(cycle: cycle, wanted: "m.a")
      && cycle_has_member(cycle: cycle, wanted: "m.c")
  }) == false
}




data changed_surface_witness_note: String = "CAPSULE 2 acceptance, REWORKED under the operator ruling 2026-08-08. The earlier revision's five controls were good for what they tested but the SELECTED contract was not the PRODUCT contract: deletions were discarded, every subject resolved against head, an unresolved subject did not contaminate the typed result, and nothing stopped a partial answer authorizing a skip. These witnesses pin the reworked contract, including the two the operator named explicitly: an unresolved subject makes the WHOLE outcome Partial, and a Partial outcome can never yield a skip authority."

data no_departed: List<String> = []

data deleted_module_nodes: List<v2.lens.module_graph.ModuleDeclarationFact> = [
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.a", path: "fixture/a.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.b", path: "fixture/b.dag" },
  v2.lens.module_graph.ModuleDeclarationFact { module: "m.c", path: "fixture/c.dag" },
]

fn surface_outcome(
  changed: List<String>,
  departed: List<String>
) -> v2.lens.module_impact_query.ChangedSurfaceImpactOutcome {
  v2.lens.module_impact_query.changed_surface_impact_outcome(
    changed_paths: changed,
    departed_paths: departed,
    edges: chain_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: unrelated_admission_only
  )
}

fn outcome_is_partial(outcome: v2.lens.module_impact_query.ChangedSurfaceImpactOutcome) -> Bool {
  match outcome {
    v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects: _ } => true
    v2.lens.module_impact_query.ChangedSurfaceComplete { reading: _ } => false
    v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
  }
}

fn outcome_reached_count(outcome: v2.lens.module_impact_query.ChangedSurfaceImpactOutcome) -> Int {
  match outcome {
    v2.lens.module_impact_query.ChangedSurfacePartial { reading, unresolved_subjects: _ } =>
      v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true })
    v2.lens.module_impact_query.ChangedSurfaceComplete { reading } =>
      v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true })
    v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => 0
  }
}

test fn witness_a_clean_changed_surface_is_complete() -> Bool {
  let outcome = surface_outcome(changed: ["fixture/c.dag"], departed: no_departed)
  match outcome {
    v2.lens.module_impact_query.ChangedSurfaceComplete { reading } =>
      v2.std.algebra.count_where(xs: reading.reached, predicate: fn(_) { true }) == 3
    v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects: _ } => false
    v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
  }
}

test fn witness_an_unresolved_subject_contaminates_the_whole_outcome() -> Bool {
  let outcome = surface_outcome(changed: ["README.md", "fixture/c.dag"], departed: no_departed)
  outcome_is_partial(outcome: outcome)
    && outcome_reached_count(outcome: outcome) == 3
    && match outcome {
      v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects } =>
        v2.std.algebra.count_where(xs: unresolved_subjects, predicate: fn(_) { true }) == 1
          && v2.std.algebra.any(xs: unresolved_subjects, predicate: fn(u) {
            match u.cause {
              v2.lens.module_impact_query.NoModuleDeclaredAtPath => u.path == "README.md"
              v2.lens.module_impact_query.BaseGraphUnavailable => false
            }
          })
      v2.lens.module_impact_query.ChangedSurfaceComplete { reading: _ } => false
      v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
    }
}

test fn witness_a_deleted_path_is_consumed_and_needs_the_base_population() -> Bool {
  let outcome = surface_outcome(changed: no_departed, departed: ["fixture/b.dag"])
  outcome_is_partial(outcome: outcome)
    && match outcome {
      v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects } =>
        v2.std.algebra.count_where(xs: unresolved_subjects, predicate: fn(_) { true }) == 1
          && v2.std.algebra.any(xs: unresolved_subjects, predicate: fn(u) {
            match u.cause {
              v2.lens.module_impact_query.BaseGraphUnavailable => u.path == "fixture/b.dag"
              v2.lens.module_impact_query.NoModuleDeclaredAtPath => false
            }
          })
      v2.lens.module_impact_query.ChangedSurfaceComplete { reading: _ } => false
      v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
    }
}

test fn witness_a_deleted_path_is_never_resolved_against_head() -> Bool {
  let outcome = surface_outcome(changed: no_departed, departed: ["fixture/c.dag"])
  outcome_reached_count(outcome: outcome) == 0
    && outcome_is_partial(outcome: outcome)
}

test fn witness_partial_never_yields_a_skip_authority() -> Bool {
  match v2.lens.module_impact_query.changed_surface_skip_authority(
    outcome: surface_outcome(changed: ["README.md"], departed: no_departed)
  ) {
    v2.lens.module_impact_query.SkipAuthorityWithheld { cause } =>
      match cause {
        v2.lens.module_impact_query.SkipWithheldUnresolvedSubjects => true
        v2.lens.module_impact_query.SkipWithheldObservationRefused => false
        v2.lens.module_impact_query.SkipWithheldStandingNotExact => false
      }
    v2.lens.module_impact_query.SkipAuthorityGranted { affected: _ } => false
  }
}

test fn witness_a_refused_observation_never_yields_a_skip_authority() -> Bool {
  match v2.lens.module_impact_query.changed_surface_skip_authority(
    outcome: v2.lens.module_impact_query.ChangedSurfaceRefused { reason: "diff observation failed" }
  ) {
    v2.lens.module_impact_query.SkipAuthorityWithheld { cause } =>
      match cause {
        v2.lens.module_impact_query.SkipWithheldObservationRefused => true
        v2.lens.module_impact_query.SkipWithheldUnresolvedSubjects => false
        v2.lens.module_impact_query.SkipWithheldStandingNotExact => false
      }
    v2.lens.module_impact_query.SkipAuthorityGranted { affected: _ } => false
  }
}

test fn witness_a_complete_but_pool_relative_outcome_withholds_skip_authority() -> Bool {
  match v2.lens.module_impact_query.changed_surface_skip_authority(
    outcome: surface_outcome(changed: ["fixture/c.dag"], departed: no_departed)
  ) {
    v2.lens.module_impact_query.SkipAuthorityWithheld { cause } =>
      match cause {
        v2.lens.module_impact_query.SkipWithheldStandingNotExact => true
        v2.lens.module_impact_query.SkipWithheldUnresolvedSubjects => false
        v2.lens.module_impact_query.SkipWithheldObservationRefused => false
      }
    v2.lens.module_impact_query.SkipAuthorityGranted { affected: _ } => false
  }
}

data differential_control_note: String = "OPERATOR ruling item 6. The production selector asks, per entry, whether any touched path lies in that entry's FORWARD dependency closure; this lane answers it once in reverse. The two must agree exactly over the same edge population: entry E's forward closure contains M if and only if E is among the reverse consumers of M. This witness asserts that biconditional in BOTH directions over every module in a fixture population — a one-directional check would pass on a reverse answer that silently narrows, which is the failure mode that matters when a selector decides what NOT to run."

fn forward_closure_of(entry: v2.lens.module_impact_query.ModuleIdentity) -> List<v2.lens.module_impact_query.ModuleIdentity> {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [entry],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: chain_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: unrelated_admission_only
  ).reached
}

fn reverse_consumers_of(target: v2.lens.module_impact_query.ModuleIdentity) -> List<v2.lens.module_impact_query.ModuleIdentity> {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [target],
    direction: v2.lens.module_impact_query.DependentsOf,
    edges: chain_edges,
    nodes: fixture_nodes,
    import_facts: chain_import_facts,
    admissions: unrelated_admission_only
  ).reached
}

fn module_in(xs: List<v2.lens.module_impact_query.ModuleIdentity>, m: v2.lens.module_impact_query.ModuleIdentity) -> Bool {
  v2.std.algebra.any(xs: xs, predicate: fn(x) { x.name == m.name })
}

fn biconditional_holds_for(entry: v2.lens.module_impact_query.ModuleIdentity, target: v2.lens.module_impact_query.ModuleIdentity) -> Bool {
  module_in(xs: forward_closure_of(entry: entry), m: target) ==
    module_in(xs: reverse_consumers_of(target: target), m: entry)
}

data differential_universe: List<v2.lens.module_impact_query.ModuleIdentity> = [mod_a, mod_b, mod_c]

test fn witness_reverse_agrees_with_forward_closure_in_both_directions() -> Bool {
  fold_list(
    xs: differential_universe,
    empty: true,
    cons: fn(acc, entry) {
      acc && fold_list(
        xs: differential_universe,
        empty: true,
        cons: fn(inner, target) {
          inner && biconditional_holds_for(entry: entry, target: target)
        }
      )
    }
  )
}

test fn witness_the_differential_control_can_fail() -> Bool {
  module_in(xs: forward_closure_of(entry: mod_a), m: mod_c)
    && module_in(xs: reverse_consumers_of(target: mod_c), m: mod_a)
    && v2.std.algebra.count_where(xs: forward_closure_of(entry: mod_c), predicate: fn(_) { true }) == 1
}


data fully_unresolved_witness_note: String = "Addendum to the operator ruling (verification pass, 2026-08-08). The earlier fully-unresolved case asserted only that nothing was reached, which INSTITUTIONALISED the exact bug item 3 names: a surface where NO input resolved produced reached=0 and a result a machine consumer would read as affects-nothing. Reaching nothing and knowing nothing are different states. This asserts the whole-result arm."

test fn witness_a_fully_unresolved_surface_is_partial_not_an_empty_answer() -> Bool {
  let outcome = surface_outcome(changed: ["README.md", "docs/plans/x.md"], departed: no_departed)
  outcome_is_partial(outcome: outcome)
    && outcome_reached_count(outcome: outcome) == 0
    && match outcome {
      v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects } =>
        v2.std.algebra.count_where(xs: unresolved_subjects, predicate: fn(_) { true }) == 2
      v2.lens.module_impact_query.ChangedSurfaceComplete { reading: _ } => false
      v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
    }
}


data departed_overlap_witness_note: String = "The earlier fixtures authored changed_paths and departed_paths as DISJOINT lists, which is not how git reports a deletion: touched_paths carries every entry's path including deleted ones, so a deleted path appears in both. The fixture was therefore not a model of the real observation, and the bug it hid - one deletion producing two subjects, a spurious NoModuleDeclaredAtPath beside the correct BaseGraphUnavailable - was found by a real-diff receipt instead. This witness authors the overlap the way git actually produces it."

test fn witness_a_deleted_path_present_in_both_lists_yields_one_base_subject() -> Bool {
  let outcome = surface_outcome(
    changed: ["fixture/b.dag", "fixture/c.dag"],
    departed: ["fixture/b.dag"]
  )
  match outcome {
    v2.lens.module_impact_query.ChangedSurfacePartial { reading: _, unresolved_subjects } =>
      v2.std.algebra.count_where(xs: unresolved_subjects, predicate: fn(_) { true }) == 1
        && v2.std.algebra.any(xs: unresolved_subjects, predicate: fn(u) {
          match u.cause {
            v2.lens.module_impact_query.BaseGraphUnavailable => u.path == "fixture/b.dag"
            v2.lens.module_impact_query.NoModuleDeclaredAtPath => false
          }
        })
    v2.lens.module_impact_query.ChangedSurfaceComplete { reading: _ } => false
    v2.lens.module_impact_query.ChangedSurfaceRefused { reason: _ } => false
  }
}
