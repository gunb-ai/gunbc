module test.claim.toolchain_hostile_writer_discriminator_witness_test

import v2.workflow.ci_workflow_run_emit { ci_hostile_legacy_writer_discriminator_script }

// BOTH OUTCOMES ARE PERMANENT WITNESSES. The shared arm is the RED control: the readers and
// antagonist name one executable, so a mechanism that merely asks every job to cooperate cannot
// pass. The private arm changes only reader ownership and must remain green while that same
// antagonist replaces the legacy path. Keeping both assertions prevents a permanently-green
// decoration or a script that simply refuses every run from masquerading as discrimination.
test fn w_shared_arm_requires_observed_interference() -> Bool {
  string_contains(
    s: ci_hostile_legacy_writer_discriminator_script(),
    pattern: "if [ \"$SHARED_STATUS\" -ne 1 ]; then"
  ) && string_contains(
    s: ci_hostile_legacy_writer_discriminator_script(),
    pattern: "shared-arm control unexpectedly passed"
  )
}

test fn w_private_arm_requires_unaffected_readers() -> Bool {
  string_contains(
    s: ci_hostile_legacy_writer_discriminator_script(),
    pattern: "if [ \"$PRIVATE_STATUS\" -ne 0 ]; then"
  ) && string_contains(
    s: ci_hostile_legacy_writer_discriminator_script(),
    pattern: "hostile legacy writer affected private-home readers"
  )
}

test fn w_barrier_failure_is_bounded_and_distinct_from_interference() -> Bool {
  string_contains(s: ci_hostile_legacy_writer_discriminator_script(), pattern: "if [ \"$I\" -gt 3000 ]; then") &&
    string_contains(s: ci_hostile_legacy_writer_discriminator_script(), pattern: "return 2") &&
    string_contains(s: ci_hostile_legacy_writer_discriminator_script(), pattern: "control failed before reader comparison")
}

// The GREEN arm must depend on the isolation binding itself. Hard-wiring a third directory here
// was the withdrawn defect: it passed even with the isolation step deleted because nobody ever
// read the path C mutated. The fallback deliberately aliases the controlled legacy fixture, making
// deletion of the isolation binding turn the private arm red.
test fn red_control_missing_isolation_collapses_private_onto_legacy() -> Bool {
  string_contains(
    s: ci_hostile_legacy_writer_discriminator_script(),
    pattern: "\"$RUNNER_TEMP/cargo\") PRIVATE_READER=\"$CARGO_HOME\" ;; *) PRIVATE_READER=\"$LEGACY\""
  )
}
