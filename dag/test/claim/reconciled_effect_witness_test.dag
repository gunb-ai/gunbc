module test.claim.reconciled_effect_witness

import std.types { String, Bool, NonEmptyStr }
import std.upsert_decision { UpsertDecision, Noop, Apply, Refuse }
import std.realization_reconcile {
  ReconciledEffect,
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounding,
  Grounds,
  DoesNotGround,
  reconcile_effect,
  reconciled_effect_converged,
  ConvergedEffect,
  ReconciledOutcome,
  EffectConverged,
  EffectNotConverged,
  classify_reconciled,
  Application,
  NotApplied,
  Applied,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Every witness below drives the REAL runner rather than asserting over a hand-built carrier, which
// is not a stylistic choice: ReconciledEffect is sole_constructor, so a hand-built carrier is not
// authorable here at all. That is the wall doing the work the witness would otherwise have to be
// trusted to respect — the same shape the guarantee-probe corpus enrolls as a compile-time RED.

fn reported_grounding_read() -> ShowEffectiveRead<String> {
  ReadObserved { value: "observed" }
}

fn grounds() -> Grounding<String> {
  Grounds { evidence: "observed" }
}

fn does_not_ground() -> Grounding<String> {
  DoesNotGround { reason: "post-apply observation does not satisfy the desired relation" }
}

fn apply_decision() -> UpsertDecision<String> {
  Apply { plan: "the plan" }
}

// The domain evidence value. In a real domain this is a SEALED carrier minted only behind the
// authority that performed the effect — gunbc.typed_remote_file_write RemoteFileConverged is the
// worked example. "The observation that EARNS it", as an earlier revision read, overstated it: the
// mint is admitted to the func that ran the four legs, which is a restriction on WHO may mint, not a
// proof that the legs ran. Here it is a String because these witnesses are about the generic truth table, and the
// point being fixed is that the Apply route now demands a REPORTED evidence value at all rather than a Bool
// any caller could write.
fn reported_application() -> Application<String> {
  Applied { evidence: "actuator receipt" }
}

// THE DISCRIMINATING RED. The application is REPORTED as applied with evidence, and the carrier still
// refuses to call that convergence, because convergence is classified from the reported effective read
// rather than from the application arm beside it. Nothing here executes an effect or performs a read:
// this witness constructs a String report, a ReadObserved and a Grounds locally, and what it
// establishes is the classifier's truth table, not lifecycle provenance. If this greens, the receipt means "something was attempted" rather than "the
// desired relation now holds", which is the entire distinction the carrier exists to carry.

test fn an_application_reported_with_a_non_grounding_read_is_not_converged() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: apply_decision(),
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: does_not_ground(),
    )
  )
}

// The positive control on that detector. Without it a runner that returned NotConverged
// unconditionally would satisfy the RED above and establish nothing.

test fn an_application_reported_with_a_grounding_read_is_converged() -> Bool {
  reconciled_effect_converged(
    r: reconcile_effect(
      decision: apply_decision(),
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

// The laundering arm: Refuse paired with a grounding read report must not mint a converged receipt.
// The reported read grounds — what is absent is any decision to act, so passing this through the grounding predicate
// would report convergence for an effect the policy declined to run.

test fn a_refused_decision_cannot_be_laundered_into_convergence_by_a_reported_grounding_read() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: Refuse { reason: "policy is observe-only" as NonEmptyStr },
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

// Apply paired with NotApplied. The read report grounds because the desired relation may already
// hold for an unrelated reason; that does not discharge an Apply reported as not applied.

test fn an_apply_reported_as_not_applied_is_not_converged() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: apply_decision(),
      application: NotApplied,
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

// Noop paired with NotApplied, where convergence is still the correct verdict: the read report
// already satisfies the desired relation. It is the reason `applied` alone can never be
// the convergence test in either direction.

test fn a_noop_over_a_grounding_read_is_converged() -> Bool {
  reconciled_effect_converged(
    r: reconcile_effect(
      decision: Noop,
      application: NotApplied,
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

test fn a_noop_whose_read_is_absent_is_not_converged() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: Noop,
      application: NotApplied,
      show_read: ReadAbsent { reason: "target absent" },
      grounding: does_not_ground(),
    )
  )
}

// The decision survives onto the receipt unchanged. A carrier that recorded convergence while losing
// which decision produced it would make an audit unable to distinguish a Noop from an Apply.

test fn the_receipt_carries_the_decision_that_produced_it() -> Bool {
  match reconcile_effect(
    decision: apply_decision(),
    application: reported_application(),
    show_read: reported_grounding_read(),
    grounding: grounds(),
  ).decision {
    Apply { plan: p } => p == "the plan"
    Noop => false
    Refuse { reason: _ } => false
  }
}

// The classified split is what a SINK consumes. These two witnesses are not a restatement of the
// convergence witnesses above: those establish that the runner derives the right verdict, these
// establish that the verdict controls which carrier exists. A sink parameterised on ConvergedEffect
// is unreachable from the refusing arm, and that is the property the witnesses fix in place.

test fn a_refusing_reconciliation_classifies_to_the_non_converged_arm() -> Bool {
  match classify_reconciled(
    r: reconcile_effect(
      decision: apply_decision(),
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: does_not_ground(),
    )
  ) {
    EffectNotConverged { reason: _, attempt: _ } => true
    EffectConverged { converged: _ } => false
  }
}

// The positive control, and it also asserts the evidence survives onto the success carrier: a
// converged receipt that dropped its observation could not tell a domain consumer WHAT converged,
// which is the join that keeps evidence about one subject from standing for another.

test fn a_converged_reconciliation_classifies_to_a_success_carrier_holding_its_evidence() -> Bool {
  match classify_reconciled(
    r: reconcile_effect(
      decision: apply_decision(),
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  ) {
    EffectConverged { converged: c } => c.evidence == "observed"
    EffectNotConverged { reason: _, attempt: _ } => false
  }
}

// ── The lifecycle-violation population ──────────────────────────────────────────────────────────
//
// These four close the holes a review found in the first revision, where `applied` was an ordinary
// Bool. Each is a state that WAS constructible and did converge, and each is now refused. They are
// not variations on the readback RED above: that one asks whether the result is derived from the
// observation, these ask whether the reported application CONTRADICTS the decision beside it. An
// earlier revision of this header said they establish that the application was EARNED and that the
// applied plan was the one decided. Neither survives: the plan join was removed from std, and being
// reported is not being earned. A carrier can pass the first and fail every one of these.

// Noop paired with Applied, with a grounding read report. Adherence is not "the reported end state
// looks right" — a Noop reported beside an application did not hold.
test fn a_noop_reported_beside_an_application_does_not_converge() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: Noop,
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

// Refuse paired with Applied. The refusal is the whole content of the decision; an application
// reported beside it is a lifecycle violation even where the read report grounds.
test fn a_refusal_reported_beside_an_application_does_not_converge() -> Bool {
  !reconciled_effect_converged(
    r: reconcile_effect(
      decision: Refuse { reason: "policy is observe-only" as NonEmptyStr },
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  )
}

// THE PLAN JOIN IS NOT CLAIMED HERE ANY MORE, so the two witnesses that asserted it are gone rather
// than left passing against a weaker function. They tested a caller-supplied `plan_eq`, and review
// 61680 established that a law supplied by the same caller who supplies both plans is the original
// untrusted-Boolean hole wearing a different name. Deleting the claim and its tests together is the
// honest move; keeping green tests over a guarantee std no longer makes would be the inflation this
// module already retracted once. The binding now lives where it can be sealed -- see
// gunbc.typed_remote_file_write remote_file_converged_from_report, admitted to the func that ran the
// effect, whose evidence carries the exact write so it names the bytes it is evidence for.

// And the seal on the success carrier survives the reshape: a violating lifecycle classifies to the
// non-converged arm, so a sink parameterised on ConvergedEffect is unreachable from it.
test fn a_lifecycle_violation_classifies_to_the_non_converged_arm() -> Bool {
  match classify_reconciled(
    r: reconcile_effect(
      decision: Noop,
      application: reported_application(),
      show_read: reported_grounding_read(),
      grounding: grounds(),
    )
  ) {
    EffectNotConverged { reason: _, attempt: _ } => true
    EffectConverged { converged: _ } => false
  }
}
