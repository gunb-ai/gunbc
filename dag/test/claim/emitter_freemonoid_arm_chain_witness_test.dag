module test.claim.emitter_freemonoid_arm_chain_witness_test

// PERMANENT REGRESSION CONTROL for the FreeMonoid match lowering in v1.compiler.emit_rust
// (emit_native_freemonoid_match / emit_native_freemonoid_tco_match and the fm_* analysis).
//
// THE DEFECT. The lowering asked which arm mentions `Empty` and which mentions `Cons`, kept the
// FIRST answer to each, and emitted `if __fm.is_empty() { A } else { B }`. Its admission predicate
// established only that the SCRUTINEE resolves to FreeMonoid, never that the ARMS fit a two-way
// split. So a refutable field sub-pattern degraded to a wildcard, every arm after the first `Cons`
// arm was discarded, and an arm guard was dropped outright. v2.std.algebra `list_init` emitted as
// `if __fm.is_empty() { vec![] } else { vec![] }` -- one function, every input answered `[]`.
//
// WHY THIS ROW EXISTS AT ALL, because the repair's own PR argued it could not. The PR body and an
// earlier revision of the failure-mode row claimed the discriminating evidence was unavailable to
// the enrolled floor "because every claim it runs is interpreted". That is true of the defect's
// CONSEQUENCE -- a miscompiled downstream binary answering wrongly at runtime -- and FALSE of the
// repair's own subject. `emit_native_freemonoid_match` is a pure String fold, so its output is
// decidable by an interpreted claim over a fixture handed to the compiler, which is exactly what
// DESIGN section 4b directs: a state unrepresentable in the accepted corpus may still be
// representable as SOURCE HANDED TO THE COMPILER BY A FIXTURE, and if the refusal is authorable
// there, the evidence is enrollable there and declining it is specification-without-execution.
// Reported by review 69861 on gunbc#12026. The mistake was a SUBJECT CONFLATION: the harder
// question (does the emitted binary compute the right list) was used to excuse not asking the
// easy one (does the emitter emit the right arms), and that parked an available climb behind a
// capability that does not need to exist.
//
// WHAT THESE ROWS DO NOT ESTABLISH. They assert the EMITTED TEXT, not the runtime answer. The
// end-to-end behavioural evidence -- the emitted binary returning [1,2] for list_init([1,2,3]) --
// was measured on gunbc#12026 against the real emitted crate and is NOT reproduced here, because
// no enrolled claim executes emitted code. That remains the differential oracle's subject.

// THE DISCRIMINATING RED. Three arms where the middle one is a NESTED constructor in a field
// position. Pre-repair this emitted a two-way split: no length test, and the third arm's body
// absent entirely. The `__fm.len() == 1` spelling is the narrowest thing only the repaired chain
// produces, and `list_tail` pins the THIRD arm's body specifically -- without it a lowering that
// kept two arms and dropped only the last would still pass.
test fn nested_field_arm_and_its_successor_both_reach_the_emitted_chain() -> Bool {
  compile_dag_rust_emit_check(
    "module fmchain\n\nimport std.types { List, Int }\n\nfn drop_last(xs: List<Int>) -> List<Int> {\n  match xs {\n    Empty => Empty\n    Cons { head: _, tail: Empty } => Empty\n    Cons { head: h, tail: t } => Cons { head: h, tail: drop_last(xs: t) }\n  }\n}\n",
    "src/fmchain.rs",
    ["__fm.len() == 1", "drop_last("],
    []
  )
}

// POSITIVE CONTROL. The ordinary two-arm shape must still lower to the native split and must NOT
// refuse. Without this row the refusal arm below is satisfiable by refusing everything, which
// would pass every must-contain-compile_error assertion while breaking all real lowering.
test fn the_ordinary_two_arm_shape_still_lowers_natively() -> Bool {
  compile_dag_rust_emit_check(
    "module fmplain\n\nimport std.types { List, Int }\n\nfn head_or_zero(xs: List<Int>) -> Int {\n  match xs {\n    Empty => 0\n    Cons { head: h, tail: _ } => h\n  }\n}\n",
    "src/fmplain.rs",
    ["__fm.is_empty()"],
    ["compile_error!"]
  )
}

// REFUSAL CONTROL ONE: a refutable HEAD sub-pattern asks a question about the ELEMENT, which this
// lowering does not answer. Pre-repair it silently degraded to a wildcard and matched every
// non-empty list. It must now refuse, located, rather than mis-lower.
test fn a_refutable_head_sub_pattern_refuses_rather_than_becoming_a_wildcard() -> Bool {
  compile_dag_rust_emit_check(
    "module fmhead\n\nimport std.types { List, Int }\n\ntype Box\n  = Zero\n  | One { v: Int }\n\nfn first_one(xs: List<Box>) -> Int {\n  match xs {\n    Empty => 0\n    Cons { head: One { v: n }, tail: _ } => n\n    Cons { head: _, tail: _ } => 0\n  }\n}\n",
    "src/fmhead.rs",
    ["compile_error!", "will not lower"],
    ["__fm.is_empty()"]
  )
}

// REFUSAL CONTROL TWO: an arm GUARD was dropped outright by the old lowering -- no branch body ever
// read arm_guard -- so a guarded arm silently ran unguarded. This is the third consequence of the
// class, and it appeared in neither of the two reports that found the other two.
test fn a_guarded_arm_refuses_rather_than_running_unguarded() -> Bool {
  compile_dag_rust_emit_check(
    "module fmguard\n\nimport std.types { List, Int }\n\nfn big_head(xs: List<Int>) -> Int {\n  match xs {\n    Empty => 0\n    Cons { head: h, tail: _ } if h > 10 => h\n    Cons { head: _, tail: _ } => 0\n  }\n}\n",
    "src/fmguard.rs",
    ["compile_error!", "will not lower"],
    ["__fm.is_empty()"]
  )
}
