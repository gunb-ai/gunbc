module test.claim.sccache_pin_witness

import std.types { NonEmptyStr, String, Bool, ContentHash }
import extdeps.pin {
  Pin,
  ExactPin,
  PinAdmission,
  PinIntegrityAdmitted,
  PinRefused,
  ObservedIdentityMismatch,
  PinRestatesSubjectMismatch,
}
import extdeps.cache.sccache {
  SccacheBinaryArtifact,
  SccacheMuslAarch64,
  SccacheMuslX86_64,
  Riscv64,
  sccache_release_0_15_0,
  sccache_binary_artifact_content_identity,
  sccache_binary_artifact_for_arch,
  sccache_published_musl_arch_of,
}
import extdeps.cache.pin {
  sccache_binary_artifact_pin,
  admit_sccache_binary_artifact_pin_integrity,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data sccache_aarch64_artifact: SccacheBinaryArtifact = SccacheBinaryArtifact {
  binary_release: sccache_release_0_15_0,
  arch: SccacheMuslAarch64,
}

data sccache_x86_64_artifact: SccacheBinaryArtifact = SccacheBinaryArtifact {
  binary_release: sccache_release_0_15_0,
  arch: SccacheMuslX86_64,
}

data sccache_aarch64_pin: Pin<SccacheBinaryArtifact> = sccache_binary_artifact_pin(artifact: sccache_aarch64_artifact)

data sccache_pin_grain_family_note: String = "Discriminating witness for feature:pin-artifact-grain. Pin<SccacheBinaryArtifact> pins ONE cited musl tarball per row; expected_identity is projected from the subject's cited digest row via extdeps.cache.pin and version is Absent because binary_release.version is the single authority (review 44984). RED CONTROL aarch64_pin_refuses_x86_64_observation fails if observing the x86_64 digest admits an aarch64 pin — the whole point of release x platform grain. RED CONTROL unsupported_arch_cannot_construct_artifact fails if Riscv64 can inhabit SccacheBinaryArtifact (review 44866 construction wall). RED CONTROL restated_identity_disagreeing_with_subject_refuses fails if a Pin whose expected_identity disagrees with the subject projection is admitted before host observation."

test fn sccache_pin_version_is_absent_subject_carries_release_version() -> Bool {
  match sccache_aarch64_pin.version {
    Absent =>
      sccache_aarch64_artifact.binary_release.version == sccache_release_0_15_0.version
    Present { value: _ } => false
  }
}

test fn sccache_pin_expected_identity_is_derived_from_cited_row() -> Bool {
  sccache_aarch64_pin.expected_identity == sccache_binary_artifact_content_identity(artifact: sccache_aarch64_artifact)
}

test fn sccache_aarch64_and_x86_64_identities_differ() -> Bool {
  sccache_binary_artifact_content_identity(artifact: sccache_aarch64_artifact) != sccache_binary_artifact_content_identity(artifact: sccache_x86_64_artifact)
}

test fn unsupported_arch_cannot_construct_artifact() -> Bool {
  match sccache_published_musl_arch_of(arch: Riscv64) {
    Absent => true
    Present { value: _ } => false
  } && match sccache_binary_artifact_for_arch(
    binary_release: sccache_release_0_15_0,
    arch: Riscv64,
  ) {
    Absent => true
    Present { value: _ } => false
  }
}

test fn sccache_aarch64_pin_admits_matching_observation() -> Bool {
  match admit_sccache_binary_artifact_pin_integrity(
    pin: sccache_aarch64_pin,
    observed_identity: sccache_binary_artifact_content_identity(artifact: sccache_aarch64_artifact),
  ) {
    PinIntegrityAdmitted { pin: p } => p.subject.arch == SccacheMuslAarch64
    PinRefused { subject: _, cause: _ } => false
  }
}

test fn sccache_aarch64_pin_refuses_x86_64_observation() -> Bool {
  let x86_identity = sccache_binary_artifact_content_identity(artifact: sccache_x86_64_artifact)
  match admit_sccache_binary_artifact_pin_integrity(pin: sccache_aarch64_pin, observed_identity: x86_identity) {
    PinIntegrityAdmitted { pin: _ } => false
    PinRefused { subject: subj, cause: c } =>
      (subj.arch == SccacheMuslAarch64)
        && match c {
             ObservedIdentityMismatch { expected: e, observed: o } =>
               (e == sccache_aarch64_pin.expected_identity) && (o == x86_identity)
             _ => false
           }
  }
}

test fn restated_identity_disagreeing_with_subject_refuses() -> Bool {
  let wrong_identity = sccache_binary_artifact_content_identity(artifact: sccache_x86_64_artifact)
  let disagreeing = Pin {
    subject: sccache_aarch64_artifact,
    version: Absent,
    expected_identity: wrong_identity,
    selection: ExactPin,
  }
  match admit_sccache_binary_artifact_pin_integrity(
    pin: disagreeing,
    observed_identity: sccache_binary_artifact_content_identity(artifact: sccache_aarch64_artifact),
  ) {
    PinIntegrityAdmitted { pin: _ } => false
    PinRefused { subject: subj, cause: c } =>
      (subj.arch == SccacheMuslAarch64)
        && match c {
             PinRestatesSubjectMismatch { projected: p, stated: s } =>
               (p == sccache_binary_artifact_content_identity(artifact: sccache_aarch64_artifact))
                 && (s == wrong_identity)
             _ => false
           }
  }
}
