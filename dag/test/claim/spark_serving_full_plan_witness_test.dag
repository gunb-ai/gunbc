module test.claim.spark_serving_full_plan_witness_test

import std.types { Bool, List, NonEmptyStr, String }
import product.placement_supply { HostIdentity }
import gunbc.membership_reconcile { MembershipPlan, membership_write_count }
import gunbc.spark_serving_release {
  SparkServingObservation,
  SparkServingObserved,
  SparkServingAbsent,
  SparkServingObservationRefused,
  SparkServingReleaseIdentity,
  SparkServingOccurrence,
  SparkServingRelease,
}
import gunbc.spark_serving_membership {
  SparkServingMember,
  spark_serving_desired_members,
}
import gunbc.spark_serving_observed_members {
  SparkServingObservedUnitState,
  UserUnitStateObserved,
  UserUnitStateAbsent,
  UserUnitStateUnobserved,
  SparkServingObservedLingerState,
  LingerObservedEnabled,
  LingerObservedDisabled,
  LingerUnobservedState,
  SparkServingObservedMemberProjection,
  SparkServingObservedMembers,
  SparkServingObservedMembersRefused,
  spark_serving_observed_members,
  spark_serving_projection_supports_empty_replan,
}
import gunbc.spark_serving_converge_plan {
  SparkServingFullMembershipPlan,
  SparkServingFullMembershipPlanReady,
  SparkServingFullMembershipPlanRefused,
  spark_serving_full_membership_plan,
  spark_serving_linger_membership_plan,
}
import gunbc.spark_serving_desired {
  SparkServingDesiredAdmission,
  SparkServingDesiredAdmitted,
  SparkServingDesiredRefused,
  spark_serving_desired_admission,
  spark_serving_occurrence,
}

data subject_host: HostIdentity = "srv6" as HostIdentity

// The subject is the DECLARED release, so these claims move with the real authority rather than a
// fixture that could drift from it. A refused admission has no release to plan against, and the
// witness says so rather than substituting one.
fn subject_release() -> SparkServingRelease? {
  match spark_serving_desired_admission {
    SparkServingDesiredAdmitted { serving_release: r } => Present { value: r }
    SparkServingDesiredRefused { cause: _ } => none
  }
}

fn project(
  obs: SparkServingObservation,
  unit: SparkServingObservedUnitState,
  linger: SparkServingObservedLingerState,
) -> SparkServingObservedMemberProjection {
  spark_serving_observed_members(observation: obs, unit: unit, linger: linger)
}

fn observed_count(p: SparkServingObservedMemberProjection) -> Int {
  match p {
    SparkServingObservedMembersRefused { cause: _ } => 0 - 1
    SparkServingObservedMembers { members: ms, unit_observed: _ } => length(ms)
  }
}

fn plan_writes(p: SparkServingFullMembershipPlan) -> Int {
  match p {
    SparkServingFullMembershipPlanRefused { cause: _ } => 0 - 1
    SparkServingFullMembershipPlanReady { plan: plan, unit_observed: _ } =>
      membership_write_count(plan: plan)
  }
}

fn full_plan_writes(
  obs: SparkServingObservation,
  unit: SparkServingObservedUnitState,
  linger: SparkServingObservedLingerState,
) -> Int {
  match subject_release() {
    Absent => 0 - 2
    Present { value: r } =>
      plan_writes(
        p: spark_serving_full_membership_plan(
          occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
          serving_release: r,
          projection: project(obs: obs, unit: unit, linger: linger),
        ),
      )
  }
}

fn full_plan_refuses(
  obs: SparkServingObservation,
  unit: SparkServingObservedUnitState,
  linger: SparkServingObservedLingerState,
) -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      match spark_serving_full_membership_plan(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
        projection: project(obs: obs, unit: unit, linger: linger),
      ) {
        SparkServingFullMembershipPlanRefused { cause: c } => string_contains(c, "refused")
        SparkServingFullMembershipPlanReady { plan: _, unit_observed: _ } => false
      }
  }
}

// ── The defect this closes ──────────────────────────────────────────────────────────────────────

// The declared desired population is four members. This is the denominator every claim below divides
// by, asserted rather than assumed.
test fn the_declared_desired_population_is_four_members() -> Bool {
  match subject_release() {
    Absent => false
    Present { value: r } =>
      length(spark_serving_desired_members(
        occurrence: spark_serving_occurrence(host: subject_host, serving_release: r),
        serving_release: r,
      )) == 4
  }
}

// THE KEYSTONE. On a bare host the production plan planned ONE member; the full plan plans four.
// Without this the three unrealized install effects could never be selected however well implemented.
test fn a_bare_host_plans_all_four_members_not_only_linger() -> Bool {
  full_plan_writes(
    obs: SparkServingAbsent { host: subject_host },
    unit: UserUnitStateAbsent,
    linger: LingerObservedDisabled,
  ) == 4
}

// The contrast, executed rather than asserted in prose: the superseded plan writes exactly one.
test fn the_superseded_linger_plan_writes_exactly_one() -> Bool {
  membership_write_count(
    plan: spark_serving_linger_membership_plan(host: subject_host, linger_enabled: false),
  ) == 1
}

// ── Observation, never the desired state ────────────────────────────────────────────────────────

// A bare host observes no runtime, unit or model member. If the projection derived observed state
// from the desired release, this would be four and the plan would be empty on a bare machine.
test fn a_bare_host_observes_no_serving_members() -> Bool {
  observed_count(p: project(obs: SparkServingAbsent { host: subject_host }, unit: UserUnitStateAbsent, linger: LingerObservedDisabled)) == 0
}

// Linger is observed independently, so it is carried even when serving is absent.
test fn linger_is_carried_on_a_bare_host_when_it_is_enabled() -> Bool {
  observed_count(p: project(obs: SparkServingAbsent { host: subject_host }, unit: UserUnitStateAbsent, linger: LingerObservedEnabled)) == 1
}

// With linger already enabled a bare host needs three writes, not four.
test fn a_bare_host_with_linger_already_enabled_plans_three() -> Bool {
  full_plan_writes(
    obs: SparkServingAbsent { host: subject_host },
    unit: UserUnitStateAbsent,
    linger: LingerObservedEnabled,
  ) == 3
}

// ── The refusal that must not narrow ────────────────────────────────────────────────────────────

// A refused observation may NOT be rendered as an empty observed population: that would plan every
// member as an addition against a host nobody saw. It refuses, and the plan refuses with it.
test fn a_refused_observation_refuses_the_projection() -> Bool {
  match project(
    obs: SparkServingObservationRefused { host: subject_host, cause: "ssh unreachable" as NonEmptyStr },
    unit: UserUnitStateUnobserved,
    linger: LingerUnobservedState,
  ) {
    SparkServingObservedMembersRefused { cause: _ } => true
    SparkServingObservedMembers { members: _, unit_observed: _ } => false
  }
}

test fn a_refused_observation_refuses_the_plan_rather_than_planning_four_writes() -> Bool {
  full_plan_refuses(
    obs: SparkServingObservationRefused { host: subject_host, cause: "ssh unreachable" as NonEmptyStr },
    unit: UserUnitStateUnobserved,
    linger: LingerUnobservedState,
  )
}

// The refusal names the host, so a fleet-wide run says WHICH host was not seen.
test fn the_projection_refusal_names_the_host() -> Bool {
  match project(
    obs: SparkServingObservationRefused { host: subject_host, cause: "ssh unreachable" as NonEmptyStr },
    unit: UserUnitStateUnobserved,
    linger: LingerUnobservedState,
  ) {
    SparkServingObservedMembersRefused { cause: c } =>
      string_contains(c, "srv6") && string_contains(c, "ssh unreachable")
    SparkServingObservedMembers { members: _, unit_observed: _ } => false
  }
}

// ── Unobserved is not absent ────────────────────────────────────────────────────────────────────

// An unobserved unit is not listed, so it plans as an addition — the same OUTCOME as absent, but the
// two must remain distinguishable because only one of them supports an empty replan.
test fn an_unobserved_unit_does_not_support_an_empty_replan() -> Bool {
  !spark_serving_projection_supports_empty_replan(
    projection: project(obs: SparkServingAbsent { host: subject_host }, unit: UserUnitStateUnobserved, linger: LingerObservedEnabled),
  )
}

test fn an_observed_absent_unit_does_support_an_empty_replan() -> Bool {
  spark_serving_projection_supports_empty_replan(
    projection: project(obs: SparkServingAbsent { host: subject_host }, unit: UserUnitStateAbsent, linger: LingerObservedEnabled),
  )
}

test fn a_refused_projection_never_supports_an_empty_replan() -> Bool {
  !spark_serving_projection_supports_empty_replan(
    projection: project(
      obs: SparkServingObservationRefused { host: subject_host, cause: "x" as NonEmptyStr },
      unit: UserUnitStateUnobserved,
      linger: LingerUnobservedState,
    ),
  )
}
