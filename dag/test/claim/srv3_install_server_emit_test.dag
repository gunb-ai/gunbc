module test.claim.srv3_install_server_emit


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

test fn srv3_dnsmasq_is_proxy_dhcp_uefi_http_boot() -> Bool {
  let conf = gunbc.install_server_emit.install_server_dnsmasq_conf(spec: gunbc.os_install.srv3_install_server_spec)
  string_contains(s: conf, pattern: "port=0")
    && string_contains(s: conf, pattern: "dhcp-range=192.168.1.0,proxy")
    && string_contains(s: conf, pattern: "dhcp-option-force=tag:efihttp,60,HTTPClient")
}

test fn srv3_dnsmasq_arch_code_is_rfc4578_grounded() -> Bool {
  let conf = gunbc.install_server_emit.install_server_dnsmasq_conf(spec: gunbc.os_install.srv3_install_server_spec)
  string_contains(s: conf, pattern: "dhcp-match=set:efihttp,option:client-arch,19")
    && !string_contains(s: conf, pattern: "option:client-arch,16")
    && !string_contains(s: conf, pattern: "option:client-arch,0")
}

test fn srv3_dnsmasq_boot_target_projects_uri_and_bootloader() -> Bool {
  let conf = gunbc.install_server_emit.install_server_dnsmasq_conf(spec: gunbc.os_install.srv3_install_server_spec)
  string_contains(s: conf, pattern: "dhcp-boot=tag:efihttp,https://install.srv3.lan/ubuntu-24.04/grubnetaa64.efi")
}

test fn rfc4578_client_arch_mapping_is_grounded() -> Bool {
  match extdeps.provisioning.dhcp_client_arch.dhcp_client_processor_architecture(arch: extdeps.os.ubuntu_install_media.Aarch64, mode: extdeps.provisioning.network_boot.UefiHttpBoot) {
    Present { value: a } =>
      extdeps.provisioning.dhcp_client_arch.dhcp_processor_architecture_code(a: a) == 19
        && match a { HttpBootArm64 => true  _ => false }
    Absent => false
  }
    && match extdeps.provisioning.dhcp_client_arch.dhcp_client_processor_architecture(arch: X86_64, mode: extdeps.provisioning.network_boot.UefiHttpBoot) {
      Present { value: x } => extdeps.provisioning.dhcp_client_arch.dhcp_processor_architecture_code(a: x) == 16
      Absent => false
    }
    && match extdeps.provisioning.dhcp_client_arch.dhcp_client_processor_architecture(arch: extdeps.os.ubuntu_install_media.Aarch64, mode: LegacyBiosPxe { tftp_root: extdeps.uri.Uri { scheme: extdeps.uri.Https, locator: "x" } }) {
      Present { value: _ } => false
      Absent => true
    }
    && match extdeps.provisioning.dhcp_client_arch.dhcp_client_processor_architecture(arch: Riscv64, mode: extdeps.provisioning.network_boot.UefiHttpBoot) {
      Present { value: _ } => false
      Absent => true
    }
}
