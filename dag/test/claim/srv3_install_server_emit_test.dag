module test.claim.srv3_install_server_emit


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn srv3_dnsmasq_is_proxy_dhcp_uefi_http_boot() -> Bool {
  let conf = install_server_dnsmasq_conf(spec: srv3_install_server_spec)
  test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "port=0")
    && test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "dhcp-range=192.168.1.0,proxy")
    && test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "dhcp-option-force=tag:efihttp,60,HTTPClient")
}

test fn srv3_dnsmasq_arch_code_is_rfc4578_grounded() -> Bool {
  let conf = install_server_dnsmasq_conf(spec: srv3_install_server_spec)
  test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "dhcp-match=set:efihttp,option:client-arch,19")
    && !test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "option:client-arch,16")
    && !test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "option:client-arch,0")
}

test fn srv3_dnsmasq_boot_target_projects_uri_and_bootloader() -> Bool {
  let conf = install_server_dnsmasq_conf(spec: srv3_install_server_spec)
  test.claim.srv3_install_server_emit.string_contains(s: conf, pattern: "dhcp-boot=tag:efihttp,https://install.srv3.lan/ubuntu-24.04/grubnetaa64.efi")
}

test fn rfc4578_client_arch_mapping_is_grounded() -> Bool {
  match dhcp_client_processor_architecture(arch: Aarch64, mode: UefiHttpBoot) {
    v2.std.optional.Present { value: a } =>
      dhcp_processor_architecture_code(a: a) == 19
        && match a { HttpBootArm64 => true  _ => false }
    Absent => false
  }
    && match dhcp_client_processor_architecture(arch: X86_64, mode: UefiHttpBoot) {
      v2.std.optional.Present { value: x } => dhcp_processor_architecture_code(a: x) == 16
      Absent => false
    }
    && match dhcp_client_processor_architecture(arch: Aarch64, mode: extdeps.provisioning.network_boot.LegacyBiosPxe { tftp_root: extdeps.uri.Uri { scheme: Https, locator: "x" } }) {
      v2.std.optional.Present { value: _ } => false
      Absent => true
    }
    && match dhcp_client_processor_architecture(arch: Riscv64, mode: UefiHttpBoot) {
      v2.std.optional.Present { value: _ } => false
      Absent => true
    }
}

// Local since the falsifier witness that used to declare it was deleted with the CI wipe
// (2026-08-15). One line over one builtin: a cross-test import for this is a dependency on
// another witness's incidental helper, not on a shared authority.
fn string_contains(s: String, pattern: String) -> Bool {
  s.contains(pattern)
}
