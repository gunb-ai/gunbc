module test.claim.shell.shell_typed_invocation_witness_test

import std.types { Bool, String, List }
import extdeps.linux.usb_gadget { ConfigfsOp, ConfigfsMkdir, ConfigfsWriteAttr, ConfigfsSymlink, ConfigfsRemoveLink, ConfigfsRmdir }
import gunbc.bmc_virtual_media { srv4_vm_gadget_setup_ops, srv4_vm_gadget_setup_display }

// THE ACCEPTANCE ORACLE FOR shell-typed-invocation, GREEN SINCE THE NODE'S SLICE LANDED. The node's
// bar is that callers say which operation and which arguments and nobody hands over shell text; the
// specimen the node's own note names is the USB gadget setup, whose script once prefixed `set -e`
// and joined rendered lines carrying `2>/dev/null || true`. The setup now acts through typed
// commands (each ConfigfsOp maps to an ArgvCommand through a cited builder, or to a typed
// attribute write, or refuses typed), so this witness reads the described form's DISPLAY of the
// srv4 virtual-media gadget fixture (an authored fixture, not a live observation) and refuses
// while any shell control word is present.
//
// PER DESIGN SECTION 4b(4) THE GREENED PROBE DOES NOT RETIRE: the enrollment row left
// v2.workflow.floor_expected_red by the roster's own removal path in the same change, and this
// witness stays enrolled as the permanent regression control -- the red it would go is exactly the
// regression it guards against (shell text creeping back into the instruction).
//
// WHAT THE WORKER MAY CHANGE HERE: if the surface this reads (`srv4_vm_gadget_setup_display`)
// moves again, this witness is re-pointed at the same fixture's new described rendering; its NAME
// and its claim do not change, because the node's contract names the function.

data shell_control_words: List<String> = ["set -e", "||", "&&", ";", "2>/dev/null"]

test fn usb_gadget_setup_emits_no_shell_control_word() -> Bool {
  let rendered = srv4_vm_gadget_setup_display()
  rendered != "" && !any(shell_control_words, w => string_contains(s: rendered, pattern: w))
}

// POSITIVE CONTROL, green today and after: the setup is a list of typed configfs operations over the
// gadget's own configfs directory, so the red above is about the RENDERING and not about the ops.
test fn usb_gadget_setup_is_typed_configfs_ops_under_the_gadget_root() -> Bool {
  let ops = srv4_vm_gadget_setup_ops()
  count(ops) > 0
    && all(ops, op => match op {
      ConfigfsMkdir { path } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsWriteAttr { path, value: _ } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsSymlink { target: _, link } => string_contains(s: link as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsRemoveLink { link } => string_contains(s: link as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsRmdir { path } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
    })
}
