module test.claim.shell.shell_typed_invocation_witness_test

import std.types { Bool, String, List, NonEmptyStr, list_length }
import extdeps.exec.command { shell_command_render }
import extdeps.linux.usb_gadget {
  ConfigfsOp,
  ConfigfsMkdir,
  ConfigfsWriteAttr,
  ConfigfsSymlink,
  ConfigfsRemoveLink,
  ConfigfsRmdir,
  ConfigfsCommandArgv,
  ConfigfsCommandWriteFile,
  ConfigfsOpCommandBuilt,
  ConfigfsOpCommandRefused,
  configfs_op_command,
}
import gunbc.bmc_virtual_media { srv4_vm_gadget_setup_ops, srv4_vm_gadget_setup_commands }

// THE ACCEPTANCE ORACLE FOR shell-typed-invocation. The node's bar is that callers say which
// operation and which arguments and nobody hands over shell text; the specimen the node's own note
// names is the USB gadget setup. It WAS red by design while the setup rendered as one script
// string whose prefix was `set -e` and whose joins carried `2>/dev/null || true` — shell control
// words this witness refused on. The work has since landed: the setup is carried as described
// operations (typed argv commands and typed file writes), so this witness reads the described
// form's rendering of the same fixture (an authored fixture, not a live observation) and holds the
// same claim over everything in it that can bear shell text: every argv command renders through
// the one translator, extdeps.exec.command shell_command_render, and the rendering carries none of
// the words that made the old script opaque. A file write is not shell at all and has nothing to
// render — its presence as a TYPED write is itself the claim holding — and a refused op fails the
// fixture outright, because the fixture's gadget is in-repo authority and must build clean.

data shell_control_words: List<String> = ["set -e", "||", "&&", ";", "2>/dev/null"]

test fn usb_gadget_setup_emits_no_shell_control_word() -> Bool {
  let commands = srv4_vm_gadget_setup_commands()
  list_length(items: commands) > 0
    && all(commands, c => match c {
      ConfigfsOpCommandBuilt { command: cmd } => match cmd {
        ConfigfsCommandArgv { command: argv } =>
          !any(shell_control_words, w => string_contains(s: shell_command_render(command: argv), pattern: w))
        ConfigfsCommandWriteFile { path: _, content: _ } => true
      }
      ConfigfsOpCommandRefused { cause: _ } => false
    })
}

// THE REFUSAL, EXERCISED AT IDENTITY GRAIN. The mapping's typed refusal is part of the node's
// red control — bad arguments refuse BEFORE any command is built — and this is the one op that
// would have sailed through the old shell renderer into the rendered script: an attribute write
// naming a path outside the gadget's configfs directory.
test fn configfs_op_outside_the_gadget_root_refuses_before_any_command_is_built() -> Bool {
  match configfs_op_command(
    op: ConfigfsWriteAttr { path: "/etc/passwd" as NonEmptyStr, value: "x" },
    root: "/sys/kernel/config/usb_gadget/gunbcvm" as NonEmptyStr,
  ) {
    ConfigfsOpCommandRefused { cause: _ } => true
    ConfigfsOpCommandBuilt { command: _ } => false
  }
}

// POSITIVE CONTROL, green before and after: the setup is a list of typed configfs operations over
// the gadget's own configfs directory, so the oracle above is about the CARRIAGE and not about the
// ops. It is what makes the oracle discriminating in both directions: the same ops carried as one
// glued script string used to red it, and the same ops carried as typed commands holds it.
test fn usb_gadget_setup_is_typed_configfs_ops_under_the_gadget_root() -> Bool {
  let ops = srv4_vm_gadget_setup_ops()
  count(ops) > 0
    && all(ops, op => match op {
      ConfigfsMkdir { path } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsWriteAttr { path, value: _ } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsSymlink { target: _, link } => string_contains(s: link as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsRemoveLink { link } => string_contains(s: link as String, pattern: "/sys/kernel/config/usb_gadget/")
      ConfigfsRmdir { path } => string_contains(s: path as String, pattern: "/sys/kernel/config/usb_gadget/")
    })
}
