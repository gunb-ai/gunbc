module test.claim.shell.shell_dag_codex_app_server_trip_script_witness

import std.types { Bool, String, List, FilePath }
import std.algebra { list_flat_map }
import v2.std.compilers.cli_surface {
  process_argv_expansion_surface,
  cli_surface_arguments,
  cli_argument_text,
}
import extdeps.tools.env { env_path_resolved_program }
import gunbc.codex_app_server_press {
  codex_press_account_trip_argv_admission,
  CodexTripArgvAdmitted,
  CodexTripArgvRefused,
  codex_press_account_trip_request_lines,
  codex_app_server_initialize_request_line,
}
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE ACCEPTANCE ORACLE FOR shell-dag-codex-app-server-trip-script, RED BY DESIGN UNTIL THE NODE
// IS DONE. The node's bar is that gunbc.codex_app_server_press codex_press_account_trip_script —
// retained_foreign over shell.Exec.Run, scaffold per the module's own note — is realized as a
// typed ArgvCommand carrying the JSON-RPC payload on stdin with separate stream capture, and the
// sentinel mux (split_gunbc_stdio_capture) is deleted with the scaffold: a capture that cannot
// separate streams refuses, never muxes. Today the trip script is one concatenated line of shell
// carrying `;` throughout and the literal ---GUNBC_EXIT---/---GUNBC_STDOUT---/---GUNBC_STDERR---
// sentinels — sentinels that can collide with real output and cannot be checked before they run.
// The red arms assert the rendered trip surface carries no shell control word (`set -e`, `||`,
// `&&`, `;`, `2>/dev/null`) and no sentinel; they turn green only over the typed realization.
// Enrolled in v2.workflow.floor_expected_red; the transition red -> green IS the work. STATUS: the
// typed realization landed (typed argv over shell.Exec.RunArgvStdin, sentinel mux deleted), the four
// arms are GREEN, and this row's floor_expected_red chunk has been withdrawn in the same diff that
// turned them green; the file is kept as a permanent regression check.
//
// PINNED AT LAUNCH: the dispatched worker is forbidden to edit this file — an edit refuses
// verification as oracle-moved. ONE SANCTIONED EXCEPTION, inherited from the exemplar
// (test.claim.shell.shell_typed_invocation_witness): the node row's M2 DELETES
// codex_press_account_trip_script, the surface these claims read. If that deletion lands, this
// file's import is re-pointed at the typed ArgvCommand realization's rendering of the SAME trip —
// same executable, same codex_home, same payload — and nothing else moves: the fn names and the
// claims do not change, because the node's contract names the acceptance fn.
//
// AUTHORIZED SECOND MOVE (operator ruling, escalation msg_aa1d82e8, decided 2026-11-15, explicit
// not a timeout default), verbatim: "Re-point pinned oracle to assert CodexTripArgvRefused."
// Under it the adversarial arm adversarial_codex_home_renders_no_shell_control_word is re-pointed
// to assert the TYPED CodexTripArgvRefused returned by gunbc.codex_app_server_press
// codex_press_account_trip_argv_admission for an adversarial codex_home — i.e. it now observes the
// real refusal at the single acceptance interface every production caller consumes, instead of
// grepping a rendered string (which could stay green by omission: gunbc.design_argument::
// witness_one_interface). The arm's NAME and the other three claims are unchanged. Under the SAME
// ruling the render helper trip_surface now sources its three benign arms' argv from the admission's
// Admitted { arguments } (their claims -- no control word, no stdio sentinel, declared payload/subject
// -- are text-unchanged; only the data source moved), which let the retired test-only
// codex_press_account_trip_invocation projection -- it fabricated a spawnable empty argv on refusal
// (gunbc.design_argument::fail_closed) and held a second cli_surface_of_literal_words mint
// (gunbc.design_argument::single_authority) -- be deleted along with its roster entry. Endorsed by the
// witness owner gentle-boar-614 (msg 902a0231), who withdrew the earlier hold. The general "do not
// hand-edit this pinned oracle" rule still governs any OTHER change.

data shell_control_words: List<String> = ["set -e", "||", "&&", ";", "2>/dev/null"]

data stdio_sentinels: List<String> = ["---GUNBC_EXIT---", "---GUNBC_STDOUT---", "---GUNBC_STDERR---"]

// RE-POINTED under the sanctioned exception above: gunbc#12973 deleted
// codex_press_account_trip_script; this renders the typed realization of the SAME trip (same
// executable, same codex_home, same payload) with the projection
// test.claim.codex_app_server_press_witness codex_account_trip_transport_surface_text uses:
// the env(1) program, the argv words, then the stdin request lines.
fn trip_surface(codex_home: String) -> String {
  let argument_words: List<String> = match codex_press_account_trip_argv_admission(
    executable: "/usr/bin/codex" as FilePath,
    codex_home: codex_home as FilePath,
    lock: none,
  ) {
    CodexTripArgvAdmitted { arguments } => list_flat_map(
      xs: cli_surface_arguments(surface: process_argv_expansion_surface(expansion: arguments)),
      f: fn(argument) { [cli_argument_text(argument: argument)] },
    )
    // UNREACHABLE for the three benign arms (all pass an admitted home); the adversarial arm does
    // not render through trip_surface -- it asserts the typed refusal directly. A render helper
    // yields TEXT, never a spawnable command, so this totality branch cannot smuggle an argv.
    CodexTripArgvRefused { diagnostic: _ } => []
  }
  join(
    concat(
      concat([env_path_resolved_program().invocation as String], argument_words),
      [codex_press_account_trip_request_lines()],
    ),
    "\n",
  )
}

// RED TODAY: the trip surface is one concatenated shell line and carries command separators
// throughout. Greens when the trip is a typed ArgvCommand with the payload on stdin.
test fn trip_surface_renders_no_shell_control_word() -> Bool {
  !any(shell_control_words, w => string_contains(s: trip_surface(codex_home: "/tmp/codex-home"), pattern: w))
}

// RED TODAY: the stdio capture is muxed through literal sentinels that can collide with real
// output. Greens when streams are captured separately — a capture that cannot separate streams
// refuses rather than muxing.
test fn trip_surface_carries_no_stdio_sentinel() -> Bool {
  !any(stdio_sentinels, s => string_contains(s: trip_surface(codex_home: "/tmp/codex-home"), pattern: s))
}

// RE-POINTED under the operator ruling cited above. It no longer greps a rendered string (which
// could stay green by omission). It asserts the TYPED refusal at the single acceptance interface
// both production callers consume: an adversarial codex_home is refused by
// codex_press_account_trip_argv_admission with a non-empty located diagnostic. If the trip were
// NOT refused (the pre-fix defect), this arm FAILS -- it is a true discriminator, not a stand-in.
test fn adversarial_codex_home_renders_no_shell_control_word() -> Bool {
  match codex_press_account_trip_argv_admission(
    executable: "/usr/bin/codex" as FilePath,
    codex_home: "/tmp/codex-home; reboot" as FilePath,
    lock: none,
  ) {
    CodexTripArgvRefused { diagnostic } => string_length(s: diagnostic as String) > 0
    CodexTripArgvAdmitted { arguments: _ } => false
  }
}

// TYPED-FORM POSITIVE CONTROL, green today and after: the trip surface carries the declared
// payload — the initialize request line is the first frame of the stdin payload — and addresses
// the declared executable and codex_home. The rebind changes who constructs the invocation,
// never what the app-server is asked.
test fn trip_surface_carries_the_declared_payload_and_subject() -> Bool {
  string_contains(s: trip_surface(codex_home: "/tmp/codex-home"), pattern: codex_app_server_initialize_request_line() as String)
    && string_contains(s: trip_surface(codex_home: "/tmp/codex-home"), pattern: "/usr/bin/codex")
    && string_contains(s: trip_surface(codex_home: "/tmp/codex-home"), pattern: "/tmp/codex-home")
}

