module test.claim.hermetic_mock_fidelity_witness

import std.types { String, Bool }
import gunbc.guarantee_rung_drop { OutsideTheLadder, StructurallyGuaranteed }
import gunbc.hermetic_mock_fidelity {
  HermeticMockRow,
  UnconditionalArm,
  InputDiscriminating,
  ExitStatus,
  hermetic_mock_fidelity_all_diagnosed,
  hermetic_mock_fidelity_all_tracked,
  hermetic_mock_row_is_tracked,
  hermetic_mock_row_names_what_it_fabricates
}

// THE PAIR, NOT THE ASSERTION. `hermetic_mock_fidelity_all_tracked` over the live roster is the
// positive control; on its own it would be satisfied by an empty roster and by a roster with no
// fabricating rows, so it carries no information about the check. The two rows below are the
// discriminating half: an UNTRACKED fabricating row must be rejected, and a non-fabricating row
// with no trigger must be accepted -- which is what establishes that the predicate reads the
// discrimination and the trigger together rather than either alone.

fn untracked_fabricating_row() -> HermeticMockRow {
  HermeticMockRow {
    operation: "probe.Untracked.Run",
    discrimination: UnconditionalArm {},
    fabricates: [ExitStatus {}],
    rung: OutsideTheLadder {},
    ceiling: StructurallyGuaranteed {},
    next_trigger: ""
  }
}

fn honest_row_needs_no_trigger() -> HermeticMockRow {
  HermeticMockRow {
    operation: "probe.Honest.Run",
    discrimination: InputDiscriminating {},
    fabricates: [],
    rung: StructurallyGuaranteed {},
    ceiling: StructurallyGuaranteed {},
    next_trigger: ""
  }
}

test fn hermetic_mock_live_roster_is_tracked() -> Bool {
  hermetic_mock_fidelity_all_tracked()
}

test fn hermetic_mock_untracked_fabricating_row_is_rejected() -> Bool {
  !hermetic_mock_row_is_tracked(r: untracked_fabricating_row())
}

test fn hermetic_mock_honest_row_needs_no_trigger() -> Bool {
  hermetic_mock_row_is_tracked(r: honest_row_needs_no_trigger())
}

fn undiagnosed_fabricating_row() -> HermeticMockRow {
  HermeticMockRow {
    operation: "probe.Undiagnosed.Run",
    discrimination: UnconditionalArm {},
    fabricates: [],
    rung: OutsideTheLadder {},
    ceiling: StructurallyGuaranteed {},
    next_trigger: "a trigger exists; what it fabricates does not"
  }
}

test fn hermetic_mock_live_roster_is_diagnosed() -> Bool {
  hermetic_mock_fidelity_all_diagnosed()
}

// THE SECOND PAIR, and it discriminates against the FIRST check as well as for this one: this
// row is TRACKED (it carries a trigger) and still undiagnosed, so a green here would mean the
// two predicates had collapsed into one.
test fn hermetic_mock_undiagnosed_fabricating_row_is_rejected() -> Bool {
  hermetic_mock_row_is_tracked(r: undiagnosed_fabricating_row())
    && !hermetic_mock_row_names_what_it_fabricates(r: undiagnosed_fabricating_row())
}

test fn hermetic_mock_honest_row_needs_no_fabrication_list() -> Bool {
  hermetic_mock_row_names_what_it_fabricates(r: honest_row_needs_no_trigger())
}
