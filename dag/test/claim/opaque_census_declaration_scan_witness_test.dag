module test.claim.opaque_census_declaration_scan_witness

import tools.opaque_realization_census {
  DeclarationBodyStanding, DeclaredOpaque, DeclaredWithBody, declaration_body_standing_in
}
import v2.std.optional { Absent, Present }
import v2.std.logic { Bool }

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// THE TWO REDS THIS WITNESS EXISTS FOR WERE BOTH LIVE ON MAIN, AND BOTH WERE MEASURED RATHER THAN
// REASONED. Against the unrepaired scanner: prefix_boundary answered DeclaredWithBody (a longer
// same-prefix name decided a shorter name's standing) and multiline answered DeclaredOpaque (the
// body was on the following line). The instrument's own annotation asserted the second spelling did
// not occur in this corpus; it occurred 5132 times.
//
// THE TWO CONTROLS ARE NOT DECORATION. A repair that answered NO-MATCH or DeclaredWithBody for
// everything would satisfy both REDs above and be useless, so genuinely_bodyless and
// same_line_body pin the arms that must NOT move. They were green before the repair and stay green
// after it, which is what makes the other two rows evidence about the fix rather than about a
// scanner that changed its mind everywhere.

fn opaque_census_scan_answers(content: String, name: String) -> String {
  match declaration_body_standing_in(content: content, name: name) {
    Absent => "NO-MATCH"
    Present { value: v } =>
      match v {
        DeclaredOpaque => "OPAQUE"
        DeclaredWithBody => "BODY"
        DeclarationSourceUnresolved { attempted: _ } => "UNRESOLVED"
      }
  }
}

// RED before the boundary repair: answered BODY, because `type FooBar = A | B` starts with
// `type Foo` and the leftover `Bar = A | B` contains `=`.
fn witness_longer_same_prefix_name_does_not_answer_for_a_shorter_one() -> Bool {
  opaque_census_scan_answers(content: "type FooBar = A | B\n", name: "Foo") == "NO-MATCH"
}

// RED before the continuation repair: answered OPAQUE, because the declaration line ends after the
// name and the scanner never read the next line.
fn witness_body_on_the_following_line_is_a_body() -> Bool {
  opaque_census_scan_answers(content: "type Foo\n  = A | B\n", name: "Foo") == "BODY"
}

// POSITIVE CONTROL: a genuinely bodyless declaration must still read as opaque, or the continuation
// repair has simply reclassified everything.
fn witness_a_genuinely_bodyless_declaration_is_still_opaque() -> Bool {
  opaque_census_scan_answers(content: "type Foo\n\nfn z() -> Int { 1 }\n", name: "Foo") == "OPAQUE"
}

// POSITIVE CONTROL: the same-line body arm is untouched by either repair.
fn witness_a_same_line_body_is_still_a_body() -> Bool {
  opaque_census_scan_answers(content: "type Foo = Int\n", name: "Foo") == "BODY"
}

test fn opaque_census_declaration_scan_witnesses() -> Bool {
  witness_longer_same_prefix_name_does_not_answer_for_a_shorter_one()
    && witness_body_on_the_following_line_is_a_body()
    && witness_a_genuinely_bodyless_declaration_is_still_opaque()
    && witness_a_same_line_body_is_still_a_body()
}
