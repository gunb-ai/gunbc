module test.claim.durable_handoff_host_witness

import std.types { Bool, List }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem, FilesystemCreated, FilesystemCreateTargetOccupied, FilesystemCreateRefused }
import std.measure { second, second_count }
import gunbc.durable_handoff_host {
  host_request_create_only,
  HostSpoolHealthEntry, HostSpoolHealthBound,
  HostSpoolHealthClear, HostSpoolHealthStale, HostSpoolHealthUnobserved, host_spool_health_judge,
}
import gunbc.spool_queue {
  SpoolPublication, RolePending, RoleHandedOff, RoleDone, spool_enqueue_assess, EnqueueEligible, EnqueueAlreadyPresent, EnqueueRefused,
  EntryAbsent, EntryStanding, EntryObservationUnavailable,
}

test fn enqueue_is_create_only_and_does_not_overwrite() -> Bool {
  (match spool_enqueue_assess(kind: SpoolPublication, observed: EntryAbsent) {
    EnqueueEligible { into: r } => r == RolePending
    _ => false
  }) && (match spool_enqueue_assess(kind: SpoolPublication, observed: EntryStanding { role: RolePending }) {
    EnqueueAlreadyPresent { state: _ } => true
    _ => false
  }) && (match spool_enqueue_assess(kind: SpoolPublication, observed: EntryObservationUnavailable { detail: "eacces" }) {
    EnqueueRefused { detail: d } => d == "eacces"
    _ => false
  })
}

test fn queue_health_names_the_oldest_owed_entry_past_its_bound() -> Bool {
  let bounds = [
    HostSpoolHealthBound { stage: RolePending, bound: second(count: 60) },
    HostSpoolHealthBound { stage: RoleHandedOff, bound: second(count: 2700) },
  ]
  let clear = host_spool_health_judge(entries: [
    HostSpoolHealthEntry { stage: RolePending, entry: "young", age: second(count: 10) },
    HostSpoolHealthEntry { stage: RoleHandedOff, entry: "ok", age: second(count: 100) },
  ], bounds: bounds)
  let stale = host_spool_health_judge(entries: [
    HostSpoolHealthEntry { stage: RolePending, entry: "young", age: second(count: 10) },
    HostSpoolHealthEntry { stage: RolePending, entry: "old", age: second(count: 90) },
    HostSpoolHealthEntry { stage: RoleHandedOff, entry: "also-old", age: second(count: 80) },
  ], bounds: bounds)
  (match clear { HostSpoolHealthClear { depth_pending: i, depth_handed_off: q, depth_claimed: r } => i == 1 && q == 1 && r == 0  _ => false })
    && (match stale { HostSpoolHealthStale { stage: _, entry: e, age: a, bound: b } => e == "old" && second_count(s: a) == 90 && second_count(s: b) == 60  _ => false })
}

test fn a_stage_with_no_bound_is_unobserved_never_silently_young() -> Bool {
  match host_spool_health_judge(entries: [
    HostSpoolHealthEntry { stage: RoleDone, entry: "settled", age: second(count: 1) },
  ], bounds: [
    HostSpoolHealthBound { stage: RolePending, bound: second(count: 60) },
  ]) {
    HostSpoolHealthUnobserved { detail: d } => d == "no bound for stage done"
    _ => false
  }
}

// Exercise the actual shared acceptance boundary. Consumers supply payloads;
// neither the codec nor a retry grants permission to overwrite accepted work.
test fn file_request_acceptance_preserves_the_first_payload_and_refuses_missing_storage() -> Bool {
  let root = shell.Mktemp.DirWithTemplate(template: "/tmp/gunbc-handoff.XXXXXX").path
  let path = concat(root, "/request")
  let accepted = match host_request_create_only(path: path, content: "first request") {
    FilesystemCreated { path: n } => n == path
    _ => false
  }
  let repeated = match host_request_create_only(path: path, content: "replacement request") {
    FilesystemCreateTargetOccupied { path: n } => n == path
    _ => false
  }
  let stored = Filesystem.Read(path: path)
  let refused = match host_request_create_only(path: concat(root, "/absent/request"), content: "unaccepted") {
    FilesystemCreateRefused { path: _, kind: _, error: _ } => true
    _ => false
  }
  let removed = shell.Remove.RecursiveForce(path: root)
  accepted && repeated && stored.success && stored.content == "first request" && refused && removed.success
}
