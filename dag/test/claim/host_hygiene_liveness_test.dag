module test.claim.host_hygiene_liveness

import std.measure { Second, second }
import std.types { NonEmptyStr, Bool, List }
import std.realization_reconcile { Grounds, DoesNotGround }
import gunbc.host_hygiene_liveness {
  RunnerSessionStartedObservation,
  SessionStartedObserved,
  SessionStartedNeverSeen,
  SessionStartedFresh,
  SessionStartedStale,
  SessionStartedUnknown,
  runner_session_started_verdict,
  fleet_green_from_session_started,
  ground_fleet_session_started,
}
import gunbc.host_hygiene_liveness_script { host_hygiene_liveness_reads_listening_for_jobs_line }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data liveness_test_bound: Second = second(1800)

data liveness_test_fresh_slot: RunnerSessionStartedObservation = SessionStartedObserved {
  unit: "actions-runner@srv1-01.service" as NonEmptyStr,
  age: second(60),
}

data liveness_test_stale_slot: RunnerSessionStartedObservation = SessionStartedObserved {
  unit: "actions-runner@srv1-02.service" as NonEmptyStr,
  age: second(9000),
}

data liveness_test_never_seen_slot: RunnerSessionStartedObservation = SessionStartedNeverSeen {
  unit: "actions-runner@srv1-04.service" as NonEmptyStr,
}

test fn fresh_session_start_within_bound_is_fresh() -> Bool {
  match runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound) {
    SessionStartedFresh { unit: _ } => true
    _ => false
  }
}

test fn verdict_flips_when_age_crosses_the_bound() -> Bool {
  match runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound) {
    SessionStartedFresh { unit: _ } =>
      match runner_session_started_verdict(obs: liveness_test_stale_slot, bound: liveness_test_bound) {
        SessionStartedStale { unit: _, age: _, bound: _ } => true
        _ => false
      }
    _ => false
  }
}

test fn never_seen_session_start_is_unknown_not_fabricated_fresh() -> Bool {
  match runner_session_started_verdict(obs: liveness_test_never_seen_slot, bound: liveness_test_bound) {
    SessionStartedUnknown { unit: _, reason: _ } => true
    _ => false
  }
}

test fn fleet_session_started_is_green_when_every_slot_is_fresh() -> Bool {
  let verdicts = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
  ]
  fleet_green_from_session_started(verdicts: verdicts)
}

test fn one_stale_session_start_flips_the_fleet_verdict_red() -> Bool {
  let all_fresh = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
  ]
  let one_stale = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
    runner_session_started_verdict(obs: liveness_test_stale_slot, bound: liveness_test_bound),
  ]
  fleet_green_from_session_started(verdicts: all_fresh) && !fleet_green_from_session_started(verdicts: one_stale)
}

test fn unknown_session_start_also_flips_the_fleet_verdict_red() -> Bool {
  let verdicts = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
    runner_session_started_verdict(obs: liveness_test_never_seen_slot, bound: liveness_test_bound),
  ]
  !fleet_green_from_session_started(verdicts: verdicts)
}

data nrestarts_signal_exclusion_doc: String = "review 40975: the prior test here only pattern-matched that the fixture was shaped SessionStartedObserved{..} — true by construction — and never called runner_session_started_verdict. The real guarantee is structural: RunnerSessionStartedObservation has exactly three variants and none carry an NRestarts-shaped field, so runner_session_started_verdict cannot consult a signal the type does not have. This diagnostic is NOT registration connectivity; see gunbc.fleet_runner_connectivity."

test fn ground_fleet_session_started_converges_when_all_fresh() -> Bool {
  let verdicts = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
  ]
  match ground_fleet_session_started(verdicts: verdicts) {
    Grounds { evidence: _ } => true
    DoesNotGround { reason: _ } => false
  }
}

test fn ground_fleet_session_started_refuses_when_one_stale() -> Bool {
  let verdicts = [
    runner_session_started_verdict(obs: liveness_test_fresh_slot, bound: liveness_test_bound),
    runner_session_started_verdict(obs: liveness_test_stale_slot, bound: liveness_test_bound),
  ]
  match ground_fleet_session_started(verdicts: verdicts) {
    Grounds { evidence: _ } => false
    DoesNotGround { reason: _ } => true
  }
}

test fn liveness_script_reads_listening_for_jobs_line_is_an_executing_witness() -> Bool {
  host_hygiene_liveness_reads_listening_for_jobs_line()
}
