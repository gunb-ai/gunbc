module test.claim.runner_host_deploy


test fn srv4_docker_prereq_cites_official_repo() -> Bool {
  let s = gunbc.runner_host_deploy.runner_host_docker_provision_script()
  string_contains(s: s, pattern: "download.docker.com/linux/ubuntu/gpg")
    && string_contains(s: s, pattern: "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable")
    && string_contains(s: s, pattern: "docker-ce-rootless-extras")
}

test fn srv4_sccache_prereq_pins_version_and_digest() -> Bool {
  let s = gunbc.runner_host_deploy.runner_host_sccache_provision_script(arch: "aarch64", sha256: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8")
  string_contains(s: s, pattern: "github.com/mozilla/sccache/releases/download/v0.15.0/sccache-v0.15.0-aarch64-unknown-linux-musl.tar.gz")
    && string_contains(s: s, pattern: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8  /tmp/sccache.tar.gz")
    && string_contains(s: s, pattern: "/tmp/sccache-v0.15.0-aarch64-unknown-linux-musl/sccache' /usr/local/bin/sccache")
}

test fn fleet_surface_no_longer_lies_declares_sccache() -> Bool {
  let surf = gunbc.fleet_intent.fleet_intent_execution_surface()
  fold(surf.toolchains, init: false, f: (acc, t) => acc || (t.name as String == "sccache"))
}

test fn srv4_runner_installer_command_cites_installer_with_env() -> Bool {
  let outcome = gunbc.runner_host_deploy.runner_host_installer_command(
    admission: gunbc.runner_host_deploy.admit_runner_host(deploy: gunbc.runner_host_deploy.srv4_runner_host_deploy),
    installer_path: "/tmp/install-actions-runner.sh",
    pem_src_path: "/tmp/app.pem",
  )
  match outcome {
    gunbc.runner_host_deploy.RunnerCommandRefused { host_label: _, reason: _ } => false
    gunbc.runner_host_deploy.RunnerCommandReady { command: cmd } => {
      let c = extdeps.exec.command.shell_command_render(command: cmd)
      string_contains(s: c, pattern: "'CTRL_RUNNER_HOST_LABEL=srv4'")
        && string_contains(s: c, pattern: "'CTRL_RUNNER_JOB_USER=ghrunner'")
        && string_contains(s: c, pattern: "'CTRL_RUNNER_APP_PEM_SRC=/tmp/app.pem'")
        && string_contains(s: c, pattern: "'/usr/bin/sudo' '-E' 'bash' '/tmp/install-actions-runner.sh'")
    }
  }
}

test fn srv4_runner_app_from_secret_manager() -> Bool {
  gunbc.runner_host_deploy.github_app_runner_org(config: gunbc.runner_host_deploy.gunbc_ci_github_app) as String == "gunb-ai"
    && gunbc_ci_github_app.app_pem_secret.secret as String == "ci-github-app-private-key"
    && gunbc_ci_github_app.app.app_id.value == 2653532
    && gunbc_ci_github_app.installation_id.value == 104134109
}

// THE ROSTER AND THE ENABLE COMMAND MUST AGREE WITH THE DECLARED COUNT, WHATEVER THAT COUNT IS.
//
// This row pinned six twice over: the roster length, and an assertion that srv4-07 does NOT appear.
// Both were measurements of the tree the day it was written, and the 2026-08-23 CPU-axis change
// falsified both at once -- srv4 commits twenty-one, so the roster is twenty-one long and srv4-07
// is a perfectly ordinary member of it.
//
// What the row is actually for is the JOIN: the systemd units the enable command names are exactly
// the instances the roster names, one per slot, zero-padded and one-based. That relation is what
// would break if the two ever diverged, and it holds at any width. The name changes with it, since
// a row called _six_ that no longer asserts six is worse than either.
//
// THE INVOCATION CONJUNCT NAMED ITS PROGRAMS AND #8919 MOVED THEM UNDER IT. It read
// "'sudo' 'systemctl' 'enable' '--now'" -- correct against the hand-built argv this row was written
// for, and false the moment runner_enable_command_argv started routing through
// extdeps.systemd.systemctl systemctl_enable_now_command, which mints through the sealed
// argv_command with sudo_binary_path as the program and inserts sudo's non-interactive flag. The
// spelling was a THIRD authoring of facts extdeps.sudo.elevation and extdeps.systemd.systemctl
// already own, so it rotted exactly the way a re-spelling does (DESIGN section 3).
//
// The two conjuncts now cite those authorities instead of re-spelling them, and they are split
// because they assert different things: that activation ELEVATES non-interactively, and that it
// reaches systemctl's enable --now. `enable` and `--now` stay literal because they are systemctl's
// own operands, spelled inline by the builder rather than derived from any row -- so they remain
// discriminating, and a command that listed the units without the verb still fails here.
test fn srv4_enables_its_declared_runner_instances() -> Bool {
  let names = gunbc.runner_host_deploy.runner_instance_names(deploy: gunbc.runner_host_deploy.srv4_runner_host_deploy)
  match gunbc.runner_activation.runner_activate_command(admission: gunbc.runner_activation.admit_runner_activation(host_admission: gunbc.runner_host_deploy.admit_runner_host(deploy: gunbc.runner_host_deploy.srv4_runner_host_deploy), cache_ready: witness_ready_receipt(), pool_ready: witness_ready_pool())) {
    gunbc.runner_host_deploy.RunnerCommandRefused { host_label: _, reason: _ } => false
    gunbc.runner_host_deploy.RunnerCommandReady { command: cmd } => {
      let enable = extdeps.exec.command.shell_command_render(command: cmd)
      std.types.list_length(items: names) == srv4_runner_host_deploy.runner_count
        && string_contains(s: enable, pattern: "'actions-runner@srv4-01.service'")
        && string_contains(s: enable, pattern: "'actions-runner@srv4-05.service'")
        && all(names, n => string_contains(s: enable, pattern: n))
        && !string_contains(
             s: enable,
             pattern: concat("srv4-", gunbc.build_cache_instance.runner_slot_index_suffix(index: srv4_runner_host_deploy.runner_count + 1)),
           )
        && string_contains(
             s: enable,
             pattern: concat(
               concat("'", extdeps.sudo.elevation.sudo_binary_path as String),
               concat("' '", concat(extdeps.sudo.elevation.sudo_non_interactive_flag as String, "'")),
             ),
           )
        && string_contains(
             s: enable,
             pattern: concat(concat("'", extdeps.systemd.systemctl.systemctl_program as String), "' 'enable' '--now'"),
           )
    }
  }
}

data unenrolled_host_fixture: gunbc.runner_host_deploy.RunnerHostDeploy = gunbc.runner_host_deploy.RunnerHostDeploy {
  host_label: "srv9",
  ssh_target: "briansrls@192.168.1.250",
  runner_user: "briansrls",
  job_user: "ghrunner",
  app: gunbc.runner_host_deploy.gunbc_ci_github_app,
  runner_count: 5,
}

data witness_enrollment_wall_note: String = "The srv4 host-convergence OOM class, made unwritable. A host absent from fleet_intent_known_hosts yields an admission whose refusal arm carries NO command, so neither builder can hand back something runnable. The fixture is srv9 — a plausible next fleet host that nobody has enrolled — which is exactly the shape the incident took: real hardware, real ssh target, no intent row, and therefore no RAM figure for the conservation wall to check slot caps against."

test fn unenrolled_host_cannot_produce_an_installer_command() -> Bool {
  match gunbc.runner_host_deploy.runner_host_installer_command(
    admission: gunbc.runner_host_deploy.admit_runner_host(deploy: unenrolled_host_fixture),
    installer_path: "/tmp/install-actions-runner.sh",
    pem_src_path: "/tmp/app.pem",
  ) {
    gunbc.runner_host_deploy.RunnerCommandRefused { host_label: l, reason: r } =>
      (l as String) == "srv9"
        && string_contains(s: r as String, pattern: "fleet_intent_known_hosts")
        && string_contains(s: r as String, pattern: "Fail-closed")
    gunbc.runner_host_deploy.RunnerCommandReady { command: _ } => false
  }
}

test fn unenrolled_host_cannot_enable_runner_units() -> Bool {
  match gunbc.runner_activation.runner_activate_command(admission: gunbc.runner_activation.admit_runner_activation(host_admission: gunbc.runner_host_deploy.admit_runner_host(deploy: unenrolled_host_fixture), cache_ready: witness_ready_receipt(), pool_ready: witness_ready_pool())) {
    gunbc.runner_host_deploy.RunnerCommandRefused { host_label: _, reason: _ } => true
    gunbc.runner_host_deploy.RunnerCommandReady { command: _ } => false
  }
}

test fn enrolled_host_still_admits() -> Bool {
  gunbc.runner_host_deploy.fleet_intent_enrolls_host_label(label: "srv4")
    && !gunbc.runner_host_deploy.fleet_intent_enrolls_host_label(label: "srv9")
    && match gunbc.runner_host_deploy.admit_runner_host(deploy: gunbc.runner_host_deploy.srv4_runner_host_deploy) {
        gunbc.runner_host_deploy.RunnerHostEnrolled { deploy: _ } => true
        gunbc.runner_host_deploy.RunnerHostUnenrolled { host_label: _, reason: _ } => false
      }
}

data witness_admission_red_control_note: String = "Discriminating RED control on the PATH-shadow precedent: the admission-blind sketch (what this module was before the wall) DOES hand back a runnable command for the unenrolled host, the gate rejects it, and the authority's refusal passes the same gate. The perturbation is independent of the property checked, so the conjunct cannot pass tautologically."

test fn red_control_admission_blind_builder_rejected_by_gate() -> Bool {
  let adm = gunbc.runner_host_deploy.admit_runner_host(deploy: unenrolled_host_fixture)
  let widened = gunbc.runner_host_deploy.runner_command_admission_blind_widen_sketch(deploy: unenrolled_host_fixture, admission: adm)
  let authority = gunbc.runner_activation.runner_activate_command(admission: gunbc.runner_activation.admit_runner_activation(host_admission: adm, cache_ready: witness_ready_receipt(), pool_ready: witness_ready_pool()))
  match widened {
    gunbc.runner_host_deploy.RunnerCommandReady { command: _ } => true
    gunbc.runner_host_deploy.RunnerCommandRefused { host_label: _, reason: _ } => false
  }
    && !gunbc.runner_host_deploy.runner_host_admission_gate_accepts(outcome: widened, admission: adm)
    && gunbc.runner_host_deploy.runner_host_admission_gate_accepts(outcome: authority, admission: adm)
}

data activation_moved_note: String = "runner_enable_command was deleted with the materialization/activation split; these rows now drive runner_activate_command through a readiness receipt. The receipt below is a fixture, and the enrollment assertions it supports are unchanged: an unenrolled host still refuses, and the refusal still carries no command. What changed is that enrollment alone is no longer sufficient, which is the whole point of the split — so these witnesses now assert the WEAKER half of a stronger wall, and the wall's own controls live in test.claim.runner_activation_wall."

// DEFINED LOCALLY RATHER THAN SHARED WITH runner_activation_wall_test, which carries the same fixture
// and the full reasoning for it. A cross-test-module reference resolves under the floor -- it prepares
// one subject over every module, so the other test module is loaded -- and fails NoSuchFunction under a
// targeted `gunbc run` whose entry closure does not reach it. Twelve duplicated lines are cheaper than a
// witness whose resolvability depends on which harness runs it.
fn pool_declared_instance_fixture(host: product.placement_supply.HostIdentity) -> gunbc.build_cache_instance.BuildCacheInstance {
  let base = gunbc.build_cache_instance.ci_cache_instance(host: host)
  gunbc.build_cache_instance.BuildCacheInstance {
    identity: base.identity,
    implementation: base.implementation,
    endpoint: base.endpoint,
    intended_unit: base.intended_unit,
    intended_principal: base.intended_principal,
    intended_storage: base.intended_storage,
    intended_capacity: base.intended_capacity,
    intended_compile_pool: CompilePoolSliceDeclared {
      slice_unit: gunbc.host_layout.gunbc_managed_compile_pool_slice as String,
    },
  }
}

fn witness_ready_receipt() -> gunbc.runner_activation.BuildCacheInstanceReady {
  gunbc.runner_activation.BuildCacheInstanceReady {
    instance: pool_declared_instance_fixture(host: srv4_runner_host_deploy.host_label as product.placement_supply.HostIdentity),
    owner: gunbc.build_cache_instance.ProcessIdentity {
      boot_id: "fixture-boot" as std.types.NonEmptyStr,
      pid: 4242,
      start_time: "80000000" as std.types.NonEmptyStr,
    },
    managed_unit: gunbc.build_cache_instance.ci_cache_instance(host: srv4_runner_host_deploy.host_label as product.placement_supply.HostIdentity).intended_unit,
  }
}

fn witness_ready_pool() -> gunbc.runner_activation.HostCompilePoolReady {
  gunbc.runner_activation.HostCompilePoolReady {
    host: srv4_runner_host_deploy.host_label as product.placement_supply.HostIdentity,
    slice_unit: gunbc.host_layout.gunbc_managed_compile_pool_slice,
    pool_declared: true,
    pool_observed: true,
  }
}
