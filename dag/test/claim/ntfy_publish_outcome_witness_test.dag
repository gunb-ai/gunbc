module test.claim.ntfy_publish_outcome_witness_test

import std.logic { Bool }
import std.types { String, Int }
import extdeps.ntfy.ntfy {
  NtfyPublishOutcome, NtfyPublished, NtfyPublishRefused,
  ntfy_publish_outcome_of, ntfy_publish_succeeded,
}
import extdeps.transports.rest {
  RestOutcome, RestOk, RestStatusRefused, RestTransportRefused, RestBodyUndecodable,
}

// THE FOLD FROM TRANSPORT OBSERVATION TO PUBLISH OUTCOME, exercised on every arm. This exists
// because the transport half was measured to be broken in a way no static check saw: before
// `outcome: RestOutcome` was declared on the operation, a real 401 from the self-hosted server
// arrived as an untyped `TypeError` and NtfyPublishRefused had no constructor on any path. The
// operation's opt-in is the fix; this fold is the only route from the observation to the outcome
// type, so it is where the fix becomes consumable -- and an unexercised fold would leave the
// repaired path asserted rather than run.

test fn witness_ok_becomes_published() -> Bool {
  match ntfy_publish_outcome_of(rest: RestOk, message_id: "abc123") {
    NtfyPublished { message_id } => message_id as String == "abc123"
    NtfyPublishRefused { status: _, detail: _ } => false
  }
}

// THE DISCRIMINATING ONE: the exact shape the live server returns for a credential that is not
// authorized. 401 must become a REFUSAL carrying the status, not a success and not a throw.
test fn witness_unauthorized_becomes_refusal_carrying_its_status() -> Bool {
  match ntfy_publish_outcome_of(
    rest: RestStatusRefused { status: 401, body: "{\"code\":40101}" },
    message_id: "",
  ) {
    NtfyPublishRefused { status, detail } => status == 401 && detail != ""
    NtfyPublished { message_id: _ } => false
  }
}

// 403 IS THE OTHER LIVE SHAPE and it is not the same mistake as 401: the deny-by-default topic
// policy answers 403 to a token that authenticates but is not permitted on the topic. Both were
// observed against the real server, so both are pinned.
test fn witness_forbidden_becomes_refusal_carrying_its_status() -> Bool {
  match ntfy_publish_outcome_of(
    rest: RestStatusRefused { status: 403, body: "{\"code\":40301}" },
    message_id: "",
  ) {
    NtfyPublishRefused { status, detail } => status == 403
    NtfyPublished { message_id: _ } => false
  }
}

// A TRANSPORT REFUSAL HAS NO STATUS, and must not be given a plausible one. Status 0 is the
// honest encoding of "no response arrived", and it must never read as success.
test fn witness_transport_refusal_is_not_a_status() -> Bool {
  match ntfy_publish_outcome_of(
    rest: RestTransportRefused { cause: "connection refused" },
    message_id: "",
  ) {
    NtfyPublishRefused { status, detail } => status == 0 && detail == "connection refused"
    NtfyPublished { message_id: _ } => false
  }
}

test fn witness_undecodable_body_is_a_refusal_not_a_publish() -> Bool {
  match ntfy_publish_outcome_of(
    rest: RestBodyUndecodable { status: 200, cause: "not json" },
    message_id: "",
  ) {
    NtfyPublishRefused { status, detail } => status == 200
    NtfyPublished { message_id: _ } => false
  }
}

// A 200 WITH AN UNDECODABLE BODY IS THE SUBTLE ONE and this is its control: the arm above must
// NOT be reachable by status alone, or a successful publish and a garbled one would be one state.
// ntfy_publish_succeeded must answer false for it and true only for the RestOk fold.
test fn witness_succeeded_separates_ok_from_a_200_that_did_not_decode() -> Bool {
  ntfy_publish_succeeded(o: ntfy_publish_outcome_of(rest: RestOk, message_id: "id"))
    && !ntfy_publish_succeeded(
      o: ntfy_publish_outcome_of(rest: RestBodyUndecodable { status: 200, cause: "not json" }, message_id: "id"),
    )
}
