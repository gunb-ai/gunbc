module test.claim.codex_package_delivery_wet_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.ReadsLiveTree

data witness_note: String = "WET: exact wrapper+platform lock-nodes → admit HTTPS registry archives into isolated cache → npm ci --offline → native Codex executable read-back. Release parent is an isolated mktemp root (not hardcoded /opt) so CI hosts and local runners share one path. Excluded from hermetic discovery and from the per-PR wet floor (integration job)."

data openai_codex_integrity_hex: String = "c86dec3d635d6bfd980084080eaf4caeb8e8093210eebc5833921ab2b1b754172e8422d39207a0fc9cea989ab557df11138309e630b10d75d094e8eb762b4547"

fn committed_codex_lock_text() -> String {
  filesystem_read(path: gunbc.package_delivery.codex_runtime_lock_path as String).content
}

fn committed_admitted_codex_runtime_source() -> gunbc.package_delivery.AdmittedCodexRuntimeSource {
  gunbc.package_delivery.AdmittedCodexRuntimeSource {
    manifest_bytes: filesystem_read(path: gunbc.package_delivery.codex_runtime_manifest_path as String).content,
    lock_bytes: committed_codex_lock_text(),
  }
}

fn isolated_release_parent() -> std.types.FilePath? {
  let d = shell.Mktemp.Dir()
  if d.success == false {
    none
  } else {
    Present { value: d.path }
  }
}

test fn acquire_required_codex_tarball_sha512_matches_lock() -> Bool {
  match gunbc.package_delivery.admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    gunbc.package_delivery.CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match gunbc.package_delivery.codex_wrapper_lookup(graph: graph) {
        gunbc.package_delivery.CodexWrapperUnique { node: _, artifact } => {
          let staging = shell.Mktemp.Dir()
          if staging.success == false {
            false
          } else {
            match gunbc.package_delivery.acquire_and_admit_registry_artifact(
              artifact: artifact,
              lock_node_key: "node_modules/@openai/codex" as std.types.NonEmptyStr,
              dest_dir: staging.path,
            ) {
              gunbc.package_delivery.RegistryArtifactAdmitted { staged } =>
                (staged.receipt.observed_digest.hex as String) == openai_codex_integrity_hex
              _ => false
            }
          }
        }
        _ => false
      }
    _ => false
  }
}

test fn acquire_exact_target_pair_admits_wrapper_and_platform() -> Bool {
  match gunbc.package_delivery.admit_codex_package_lock_text(text: committed_codex_lock_text()) {
    gunbc.package_delivery.CodexPackageLockAdmitted { graph, nodes: _, registry_artifacts: _ } =>
      match gunbc.package_delivery.observe_codex_npm_runtime_target() {
        gunbc.package_delivery.CodexNpmRuntimeTargetObserved { target } =>
          match gunbc.package_delivery.select_codex_exact_target_closure(graph: graph, target: target) {
            gunbc.package_delivery.CodexExactTargetClosureSelected {
              wrapper,
              platform,
              target: _,
              platform_lock_key: _,
              native_executable_rel: _,
            } => {
              let staging = shell.Mktemp.Dir()
              if staging.success == false {
                false
              } else {
                match gunbc.package_delivery.acquire_and_admit_selected_pair(
                  wrapper: wrapper,
                  platform: platform,
                  dest_dir: staging.path,
                ) {
                  gunbc.package_delivery.TargetClosureAcquisitionOk { admitted } => count(admitted) == 2
                  _ => false
                }
              }
            }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn materialize_codex_runtime_bundle_produces_native_executable_holds() -> Bool {
  match isolated_release_parent() {
    Absent => false
    Present { value: release_parent } =>
      match gunbc.package_delivery.materialize_codex_runtime_bundle(
        source: committed_admitted_codex_runtime_source(),
        release_parent: release_parent,
      ) {
        gunbc.package_delivery.CodexRuntimeMaterialized { bundle } =>
          count(bundle.admitted_packages) == 2
            && (bundle.platform_package_rel as String).starts_with(
              prefix: "node_modules/@openai/codex-",
            )
            && (bundle.native_executable_rel as String).contains("/vendor/")
            && (bundle.root as String).starts_with(prefix: (release_parent as String))
            && match bundle.admitted_package_set_identity {
              std.content_hash.Sha512Hash(_) => true
              _ => false
            }
            && match bundle.receipt.receipt_identity {
              std.content_hash.Sha512Hash(_) => true
              _ => false
            }
            && match bundle.receipt.protocol_schema_identity {
              std.content_hash.Sha512Hash(_) => true
              _ => false
            }
            && match bundle.receipt.materialized_tree.tree_identity {
              std.content_hash.Sha512Hash(_) => true
              _ => false
            }
            && (bundle.receipt.toolchain.npm_cli_version as String) != ""
            && (bundle.receipt.toolchain.node_version as String) != ""
            && shell.Test.IsFile(
              path: concat(
                bundle.root as String,
                "/.gunbc-codex-runtime-receipt",
              ) as std.types.FilePath,
            ).is_file
        _ => false
      }
  }
}

fn materialize_codex_runtime_bundle_produces_native_executable_failure_receipt() -> String {
  match isolated_release_parent() {
    Absent => "staging mktemp failed"
    Present { value: release_parent } =>
      gunbc.package_delivery.codex_runtime_materialization_failure_receipt(
        outcome: gunbc.package_delivery.materialize_codex_runtime_bundle(
          source: committed_admitted_codex_runtime_source(),
          release_parent: release_parent,
        ),
      )
  }
}

fn materialize_identical_input_twice_reuses_same_release_identity_failure_receipt() -> String {
  match isolated_release_parent() {
    Absent => "staging mktemp failed"
    Present { value: release_parent } => {
      let source = committed_admitted_codex_runtime_source()
      gunbc.package_delivery.codex_runtime_materialization_failure_receipt(
        outcome: gunbc.package_delivery.materialize_codex_runtime_bundle(
          source: source,
          release_parent: release_parent,
        ),
      )
    }
  }
}

test fn materialize_identical_input_twice_reuses_same_release_identity_holds() -> Bool {
  match isolated_release_parent() {
    Absent => false
    Present { value: release_parent } => {
      let source = committed_admitted_codex_runtime_source()
      match gunbc.package_delivery.materialize_codex_runtime_bundle(
        source: source,
        release_parent: release_parent,
      ) {
        gunbc.package_delivery.CodexRuntimeMaterialized { bundle: first } =>
          match gunbc.package_delivery.materialize_codex_runtime_bundle(
            source: source,
            release_parent: release_parent,
          ) {
            gunbc.package_delivery.CodexRuntimeMaterialized { bundle: second } => {
              let same_root = (first.root as String) == (second.root as String)
              let same_receipt = (first.receipt.receipt_identity as String) == (second.receipt.receipt_identity as String)
              let same_tree = (first.receipt.materialized_tree.tree_identity as String) == (second.receipt.materialized_tree.tree_identity as String)
              same_root && same_receipt && same_tree
            }
            _ => false
          }
        _ => false
      }
    }
  }
}
