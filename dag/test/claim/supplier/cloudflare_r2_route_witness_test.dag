module test.claim.supplier.cloudflare_r2_route_witness

import std.types { Bool, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.content_hash { as_content_hash_structural, content_hash_atom }
import product.fabric.identity { FabricIdentity, DemandKey, WorkKey, OfferKey }
import product.fabric.provider_route {
  ProviderRoute, CompliancePostureRevision, ProviderRouteFacts,
  ProviderDataPathClosure, ProviderPathStanding, ProviderPathLocated, ProviderPathAbsent,
  ProviderPathUnread, DownstreamProviderPopulation, NoDownstreamProviders,
  ProviderRegionObservation, ProviderRegionRead, ProviderRegionUnread,
  ProviderRouteObserved, ProviderRouteRegionUnobserved,
  PermittedJurisdictionsEnumerated,
}
import product.fabric.provider_admission {
  RouteScopeSanction, ProviderUseScope, ProviderUseAdmission,
  ProviderUseAdmitted, ProviderUseDenied, ProviderUseRefusal,
  ProviderRouteUnclassified, ProviderRouteFactsIncomplete, DownstreamProviderUnassessed,
  PostureRevisionStale, CustomerScopeUnsupported, DataHandlingUnsupported,
  RequiredAgreementAuthorityAbsent, ProhibitedUseNotCleared, SanctionsNotCleared, ExportNotCleared,
  PostureJurisdictionsUnread, TransferOrLocationUnresolved, ProviderAccessPathUnsupported,
  DispositionCleared,
  admit_provider_use,
}
import product.supplier.cloudflare_r2 {
  cloudflare_r2_route,
  cloudflare_r2_durable_origin_route_standing,
  cloudflare_r2_route_facts_population,
  cloudflare_r2_data_paths,
  cloudflare_r2_facts,
  cloudflare_r2_region_from_read,
  cloudflare_r2_region_from_observations,
  CloudflareR2BucketLocationObservation,
}
import extdeps.cloudflare.r2_buckets { R2BucketResponse, R2BucketRead, R2BucketPresent, R2BucketAbsent }
import gunbc.cloudflare.r2_origin { FabricDurableOrigin, FabricBootOrigin }

data r2_witness_customer_profile: NonEmptyStr = "r2-witness-customer-profile"
data r2_witness_data_handling_profile: NonEmptyStr = "r2-witness-data-handling-profile"
data r2_witness_agreement: NonEmptyStr = "r2-witness-agreement"
data r2_witness_posture_authority: NonEmptyStr = "r2-witness-posture-authority"
data r2_witness_decision_receipt: NonEmptyStr = "r2-witness-decision-receipt"
data r2_witness_prohibited_use_cleared: NonEmptyStr = "r2-witness-prohibited-use-cleared"
data r2_witness_sanctions_cleared: NonEmptyStr = "r2-witness-sanctions-cleared"
data r2_witness_export_cleared: NonEmptyStr = "r2-witness-export-cleared"
data r2_witness_resolved_operator: NonEmptyStr = "r2-witness-resolved-operator"
data r2_witness_resolved_jurisdiction: NonEmptyStr = "r2-witness-resolved-jurisdiction"
data r2_witness_resolved_evidence: NonEmptyStr = "r2-witness-resolved-evidence"
data r2_witness_no_downstream: NonEmptyStr = "r2-witness-no-downstream"
data r2_witness_synthetic_region: NonEmptyStr = "r2-witness-synthetic-region"

fn t_resolved() -> ProviderPathStanding {
  ProviderPathLocated {
    operator: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_resolved_operator"),
    jurisdiction: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_resolved_jurisdiction"),
    evidence: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_resolved_evidence"),
  }
}

fn t_posture() -> CompliancePostureRevision {
  CompliancePostureRevision {
    authority: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_posture_authority"),
    revision: as_content_hash_structural(structural: content_hash_atom(value: "r2-witness-posture-r1" as NonEmptyStr)),
    permitted_jurisdictions: PermittedJurisdictionsEnumerated {
      first: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_resolved_jurisdiction"),
      further: [],
    },
    jurisdiction_drop_enrollments: [],
  }
}

fn t_customer_profile() -> DeclarationRef {
  decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_customer_profile")
}

fn t_data_handling_profile() -> DeclarationRef {
  decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_data_handling_profile")
}

fn t_agreement() -> DeclarationRef {
  decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_agreement")
}

// THE DISCRIMINATOR ROUTE IS MINTED ONLY IN THE READ ARM, SAME CONSTRUCTION AS PRODUCTION.
// It is not gunbai-fabric-origin: that standing is Unobserved, so no origin route exists to
// admit. The pair below asks whether admit_provider_use still refuses an unread path and
// admits once that path is resolved, on a route the coproduct is allowed to mint.
fn t_read_region() -> ProviderRegionObservation {
  ProviderRegionRead {
    region: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_synthetic_region"),
  }
}

fn t_sanction(route: ProviderRoute) -> RouteScopeSanction {
  RouteScopeSanction {
    route: route,
    posture: t_posture(),
    customer_profile: t_customer_profile(),
    data_handling_profile: t_data_handling_profile(),
    requires_agreement: t_agreement(),
  }
}

fn t_roster(route: ProviderRoute) -> List<RouteScopeSanction> {
  [t_sanction(route: route)]
}

fn t_scope() -> ProviderUseScope<NonEmptyStr> {
  ProviderUseScope {
    demand: FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "r2-witness-demand-1" as DemandKey },
    work: FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "r2-witness-work-1" as WorkKey },
    customer_profile: t_customer_profile(),
    data_handling_profile: t_data_handling_profile(),
    agreement: t_agreement(),
    prohibited_use_disposition: DispositionCleared {
      evidence: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_prohibited_use_cleared"),
    },
    sanctions_disposition: DispositionCleared {
      evidence: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_sanctions_cleared"),
    },
    export_disposition: DispositionCleared {
      evidence: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_export_cleared"),
    },
  }
}

fn t_offer() -> FabricIdentity<NonEmptyStr, OfferKey> {
  FabricIdentity { principal: "gunbc" as NonEmptyStr, key: "r2-witness-offer-1" as OfferKey }
}

fn t_decide(route: ProviderRoute, facts: ProviderRouteFacts) -> ProviderUseAdmission<NonEmptyStr> {
  admit_provider_use(
    roster: t_roster(route: route),
    facts: facts,
    active: t_posture(),
    scope: t_scope(),
    offer: t_offer(),
    decision_receipt: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_decision_receipt"),
  )
}

fn t_refusal_tag(c: ProviderUseRefusal) -> String {
  match c {
    ProviderRouteUnclassified { route } => "route-unclassified",
    ProviderRouteFactsIncomplete { route, obligation } => "facts-incomplete",
    DownstreamProviderUnassessed { obligation } => "downstream-unassessed",
    PostureJurisdictionsUnread { obligation } => "posture-jurisdictions-unread",
    TransferOrLocationUnresolved { route, jurisdiction } => "transfer-or-location-unresolved",
    ProviderAccessPathUnsupported { route, operator, jurisdiction } => "provider-access-path-unsupported",
    PostureRevisionStale { evaluated, active } => "posture-stale",
    CustomerScopeUnsupported { cause } => "customer-unsupported",
    DataHandlingUnsupported { cause } => "data-handling-unsupported",
    RequiredAgreementAuthorityAbsent { accepted } => "agreement-absent",
    ProhibitedUseNotCleared { obligation } => "prohibited-use-not-cleared",
    SanctionsNotCleared { obligation } => "sanctions-not-cleared",
    ExportNotCleared { obligation } => "export-not-cleared",
  }
}

fn t_refusal_located(c: ProviderUseRefusal) -> List<DeclarationRef> {
  match c {
    ProviderRouteUnclassified { route } => [],
    ProviderRouteFactsIncomplete { route, obligation } => [obligation],
    DownstreamProviderUnassessed { obligation } => [obligation],
    PostureJurisdictionsUnread { obligation } => [obligation],
    TransferOrLocationUnresolved { route, jurisdiction } => [jurisdiction],
    ProviderAccessPathUnsupported { route, operator, jurisdiction } => [operator, jurisdiction],
    PostureRevisionStale { evaluated, active } => [],
    CustomerScopeUnsupported { cause } => [cause],
    DataHandlingUnsupported { cause } => [cause],
    RequiredAgreementAuthorityAbsent { accepted } => accepted,
    ProhibitedUseNotCleared { obligation } => [obligation],
    SanctionsNotCleared { obligation } => [obligation],
    ExportNotCleared { obligation } => [obligation],
  }
}

fn t_denied_with(a: ProviderUseAdmission<NonEmptyStr>, tag: String, located: DeclarationRef) -> Bool {
  match a {
    ProviderUseAdmitted { permit } => false,
    ProviderUseDenied { decision, cause } =>
      t_refusal_tag(c: cause) == tag
        && count(filter(t_refusal_located(c: cause), r => declaration_ref_eq(a: r, b: located))) == 1,
  }
}

test fn the_durable_origin_has_no_admissible_facts() -> Bool {
  match cloudflare_r2_durable_origin_route_standing() {
    ProviderRouteObserved { route } => false,
    ProviderRouteRegionUnobserved { obligation } => declaration_ref_eq(
      a: obligation,
      b: decl_ref(
        module_path: "product.supplier.cloudflare_r2",
        decl_name: "cloudflare_r2_region_unread_obligation",
      ),
    )
      && count(cloudflare_r2_route_facts_population()) == 0,
  }
}

test fn the_durable_storage_path_is_unread_with_the_location_obligation() -> Bool {
  match cloudflare_r2_data_paths().durable_storage {
    ProviderPathLocated { operator, jurisdiction, evidence } => false,
    ProviderPathAbsent { evidence } => false,
    ProviderPathUnread { obligation } => declaration_ref_eq(
      a: obligation,
      b: decl_ref(
        module_path: "product.supplier.cloudflare_r2",
        decl_name: "cloudflare_r2_durable_storage_location_obligation",
      ),
    ),
  }
}

test fn every_production_path_is_unread() -> Bool {
  let c = cloudflare_r2_data_paths()
  let paths = [
    c.execution, c.durable_storage, c.backups, c.logs, c.telemetry,
    c.control_plane, c.support_access, c.administrative_access, c.spill,
  ]
  count(filter(paths, p => match p {
    ProviderPathUnread { obligation } => true,
    ProviderPathLocated { operator, jurisdiction, evidence } => false,
    ProviderPathAbsent { evidence } => false,
  })) == 9
}

fn t_paths_with_durable_storage(storage: ProviderPathStanding) -> ProviderDataPathClosure {
  ProviderDataPathClosure {
    execution: t_resolved(),
    durable_storage: storage,
    backups: t_resolved(),
    logs: t_resolved(),
    telemetry: t_resolved(),
    control_plane: t_resolved(),
    support_access: t_resolved(),
    administrative_access: t_resolved(),
    spill: t_resolved(),
  }
}

fn t_synthetic_downstream() -> DownstreamProviderPopulation {
  NoDownstreamProviders {
    evidence: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_no_downstream"),
  }
}

fn t_facts_with_durable_storage(route: ProviderRoute, storage: ProviderPathStanding) -> ProviderRouteFacts {
  ProviderRouteFacts {
    route: route,
    contract_terms: decl_ref(module_path: "extdeps.vendor.cloudflare", decl_name: "cloudflare_customer_dpa_reading"),
    data_paths: t_paths_with_durable_storage(storage: storage),
    downstream: t_synthetic_downstream(),
    observed_at: "2026-09-12T00:00:00Z",
    facts_revision: as_content_hash_structural(structural: content_hash_atom(value: "r2-witness-discriminator" as NonEmptyStr)),
  }
}

test fn one_unread_durable_storage_path_refuses_with_that_paths_obligation() -> Bool {
  match cloudflare_r2_route(region: t_read_region()) {
    ProviderRouteRegionUnobserved { obligation } => false,
    ProviderRouteObserved { route } => t_denied_with(
      a: t_decide(
        route: route,
        facts: t_facts_with_durable_storage(route: route, storage: ProviderPathUnread {
          obligation: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_durable_storage_location_obligation"),
          consulted: [],
        }),
      ),
      tag: "facts-incomplete",
      located: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_durable_storage_location_obligation"),
    ),
  }
}

test fn a_read_region_route_admits_once_that_path_is_resolved() -> Bool {
  match cloudflare_r2_route(region: t_read_region()) {
    ProviderRouteRegionUnobserved { obligation } => false,
    ProviderRouteObserved { route } => match t_decide(
      route: route,
      facts: t_facts_with_durable_storage(route: route, storage: t_resolved()),
    ) {
      ProviderUseDenied { decision, cause } => false,
      ProviderUseAdmitted { permit } =>
        declaration_ref_eq(
          a: permit.route.provider,
          b: decl_ref(module_path: "extdeps.vendor.cloudflare", decl_name: "cloudflare"),
        )
          && declaration_ref_eq(
            a: permit.route.service,
            b: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "R2S3Endpoint"),
          )
          && declaration_ref_eq(
            a: permit.route.region,
            b: decl_ref(module_path: "test.claim.supplier.cloudflare_r2_route_witness", decl_name: "r2_witness_synthetic_region"),
          )
          && declaration_ref_eq(
            a: permit.evidence.customer_profile,
            b: t_customer_profile(),
          ),
    },
  }
}

test fn production_unread_paths_on_a_read_region_route_still_refuse() -> Bool {
  match cloudflare_r2_route(region: t_read_region()) {
    ProviderRouteRegionUnobserved { obligation } => false,
    ProviderRouteObserved { route } => t_denied_with(
      a: t_decide(route: route, facts: cloudflare_r2_facts(route: route)),
      tag: "downstream-unassessed",
      located: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_downstream_obligation"),
    ),
  }
}

// THE REGION DERIVATION OVER SUPPLIED GET BUCKET ANSWERS. The inputs are designed reads at the
// extdeps.cloudflare.r2_buckets R2BucketRead boundary; the real producer is
// gunbc.cloudflare.r2_bucket_ensure read_r2_bucket, a live signed call that no witness can make, and
// its inhabitance is the converge receipt that prints the same field (r2_bucket_read_location_text).

fn t_origin_read(name: String, jurisdiction: String, location: String?) -> R2BucketRead {
  R2BucketPresent {
    bucket: R2BucketResponse { name: name, jurisdiction: Present { value: jurisdiction }, location: location },
  }
}

fn t_region_is(r: ProviderRegionObservation, decl: String) -> Bool {
  match r {
    ProviderRegionUnread { obligation } => false,
    ProviderRegionRead { region } => declaration_ref_eq(a: region, b: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: decl)),
  }
}

fn t_region_unread(r: ProviderRegionObservation) -> Bool {
  match r {
    ProviderRegionRead { region } => false,
    ProviderRegionUnread { obligation } => declaration_ref_eq(
      a: obligation,
      b: decl_ref(module_path: "product.supplier.cloudflare_r2", decl_name: "cloudflare_r2_region_unread_obligation"),
    ),
  }
}

test fn a_converged_read_reporting_enam_reads_the_enam_location() -> Bool {
  t_region_is(
    r: cloudflare_r2_region_from_read(
      purpose: FabricDurableOrigin {},
      read: t_origin_read(name: "gunbai-fabric-origin", jurisdiction: "default", location: Present { value: "enam" }),
    ),
    decl: "r2_location_enam",
  )
}

test fn a_converged_read_without_a_location_stays_unread() -> Bool {
  t_region_unread(r: cloudflare_r2_region_from_read(
    purpose: FabricDurableOrigin {},
    read: t_origin_read(name: "gunbai-fabric-origin", jurisdiction: "default", location: none),
  ))
}

test fn an_unpublished_location_token_stays_unread() -> Bool {
  t_region_unread(r: cloudflare_r2_region_from_read(
    purpose: FabricDurableOrigin {},
    read: t_origin_read(name: "gunbai-fabric-origin", jurisdiction: "default", location: Present { value: "ENAM" }),
  ))
}

test fn a_read_under_another_jurisdiction_lends_no_region() -> Bool {
  t_region_unread(r: cloudflare_r2_region_from_read(
    purpose: FabricDurableOrigin {},
    read: t_origin_read(name: "gunbai-fabric-origin", jurisdiction: "eu", location: Present { value: "weur" }),
  ))
}

test fn a_read_of_another_bucket_lends_no_region() -> Bool {
  t_region_unread(r: cloudflare_r2_region_from_read(
    purpose: FabricDurableOrigin {},
    read: t_origin_read(name: "gunbai-fabric-boot", jurisdiction: "default", location: Present { value: "enam" }),
  ))
}

test fn an_absent_bucket_lends_no_region() -> Bool {
  t_region_unread(r: cloudflare_r2_region_from_read(purpose: FabricDurableOrigin {}, read: R2BucketAbsent))
}

// The observation is keyed by purpose, so a boot-origin row cannot place the durable origin.
test fn an_observation_of_another_purpose_does_not_place_the_durable_origin() -> Bool {
  let boot = CloudflareR2BucketLocationObservation {
    purpose: FabricBootOrigin {},
    read: t_origin_read(name: "gunbai-fabric-boot", jurisdiction: "default", location: Present { value: "enam" }),
    observed_at: "2026-09-24T00:00:00Z",
    receipt: "r2-witness-receipt",
  }
  let durable = CloudflareR2BucketLocationObservation {
    purpose: FabricDurableOrigin {},
    read: t_origin_read(name: "gunbai-fabric-origin", jurisdiction: "default", location: Present { value: "weur" }),
    observed_at: "2026-09-24T00:00:00Z",
    receipt: "r2-witness-receipt",
  }
  t_region_unread(r: cloudflare_r2_region_from_observations(purpose: FabricDurableOrigin {}, observations: [boot]))
    && t_region_is(
      r: cloudflare_r2_region_from_observations(purpose: FabricDurableOrigin {}, observations: [boot, durable]),
      decl: "r2_location_weur",
    )
}

// THE CONSULTED CITATIONS ARE THE READINGS THE OBLIGATION NAMES, so durable storage is
// researched-and-unanswered rather than never-looked.
test fn durable_storage_cites_the_get_bucket_location_reading_as_consulted() -> Bool {
  match cloudflare_r2_data_paths().durable_storage {
    ProviderPathLocated { operator, jurisdiction, evidence } => false,
    ProviderPathAbsent { evidence } => false,
    ProviderPathUnread { obligation, consulted } =>
      count(filter(consulted, c => declaration_ref_eq(
        a: c,
        b: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "r2_get_bucket_location_reading"),
      ))) == 1,
  }
}

test fn no_production_path_is_never_looked() -> Bool {
  let c = cloudflare_r2_data_paths()
  let paths = [
    c.execution, c.durable_storage, c.backups, c.logs, c.telemetry,
    c.control_plane, c.support_access, c.administrative_access, c.spill,
  ]
  count(filter(paths, p => match p {
    ProviderPathUnread { obligation, consulted } => count(consulted) > 0,
    ProviderPathLocated { operator, jurisdiction, evidence } => false,
    ProviderPathAbsent { evidence } => false,
  })) == 9
}
