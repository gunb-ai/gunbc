module test.claim.supplier.oracle_oci_always_free_ensure_witness

import std.types { Bool, Int, List, NonEmptyStr, String }
import extdeps.languages.json.emit { JsonValue, JsonArray, JsonObject, JsonNull, JsonBool, JsonNumber, JsonString }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import gunbc.oracle_oci.api { OciListRead, OciListed, OciListRefused, OciListInaccessible, OciAnswered, classify_oci_list }
import gunbc.oracle_oci.network_ensure {
  OciNamedDecision, NamedReady, NamedCreate, NamedStop,
  oci_named_decision, oci_named_resource_of, oci_route_table_wiring, oci_subnet_wiring,
}
import gunbc.oracle_oci.instance_ensure {
  OciInstanceDecision, InstanceHeld, InstanceLaunch, InstanceStop,
  oci_instance_decision, oci_observed_instance_of, oci_free_plan, oci_launch_body,
  oci_query_value, OciQueryEncoded, OciQueryRefused, oci_out_of_host_capacity, oci_free_authorized_keys,
  oci_select_offering, oci_domain_answer, DomainOffers, DomainLacks, DomainReadRefused,
  CandidateDomains, CandidateDomainsRefused,
}
import product.supplier.oracle_oci { FitsAlwaysFree, ExceedsAlwaysFree, oci_always_free_fit }

// The subject is each decision point of the Always Free converge at its list boundary, over supplied
// list answers shaped as Oracle's SDK models them. The signed exchange runs only live, on srv1. Its
// receipt is the inhabitance evidence for these boundaries, and these rows are what it must agree with.

fn json_items(text: String) -> List<JsonValue> {
  match parse_json_document(s: text) {
    JsonDocumentUnreadable { gap } => []
    JsonDocumentParsed { value } => match value {
      JsonArray { elements } => elements
      JsonObject { members } => []
      JsonNull => []
      JsonBool { value: b } => []
      JsonNumber { lexeme } => []
      JsonString { value: s } => []
    }
  }
}

fn one(text: String) -> JsonValue {
  match json_items(text: join(["[", text, "]"], "")).first() {
    Present { value: v } => v
    Absent => JsonNull
  }
}

fn named(display: String, text: String) -> String {
  match oci_named_decision(kind: "vcn", display_name: display, read: OciListed { items: json_items(text: text) }) {
    NamedReady { resource } => concat("ready:", resource.id)
    NamedCreate => "create"
    NamedStop { line } => "stop"
  }
}

// ── THE OPERATOR'S PLAN ───────────────────────────────────────────────────────────────────────

test fn the_operators_plan_fits_the_always_free_allowance() -> Bool {
  match oci_always_free_fit(plan: oci_free_plan) {
    FitsAlwaysFree => true
    ExceedsAlwaysFree { breaches } => false
  }
}

// ── LISTS ─────────────────────────────────────────────────────────────────────────────────────

// Absence needs a complete list: an answer carrying opc-next-page refuses, even when its page is empty.
test fn a_continued_list_refuses_and_a_finished_one_lists() -> Bool {
  let continued = match classify_oci_list(operation: "List", exchange: OciAnswered { status: 200, body: "[]", next_page: "t" }) {
    OciListRefused { cause } => true
    OciListed { items } => false
    OciListInaccessible { status, body } => false
  }
  let finished = match classify_oci_list(operation: "List", exchange: OciAnswered { status: 200, body: "[{\"id\":\"x\"}]", next_page: "" }) {
    OciListed { items } => items.length() == 1
    OciListRefused { cause } => false
    OciListInaccessible { status, body } => false
  }
  continued && finished
}

// A network row missing a required field refuses the read. It does not read as "none live", which
// would create a duplicate.
test fn a_malformed_network_row_stops_rather_than_creating() -> Bool {
  named(display: "gunbc-always-free", text: "[{\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"AVAILABLE\"}]") == "stop"
    && named(display: "gunbc-always-free", text: "[{}]") == "stop"
}

// ── NETWORK ───────────────────────────────────────────────────────────────────────────────────

test fn a_network_resource_is_created_only_when_none_live_has_the_name() -> Bool {
  named(display: "gunbc-always-free", text: "[]") == "create"
    && named(display: "gunbc-always-free", text: "[{\"id\":\"v1\",\"displayName\":\"other\",\"lifecycleState\":\"AVAILABLE\"}]") == "create"
    && named(display: "gunbc-always-free", text: "[{\"id\":\"v1\",\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"TERMINATED\"}]") == "create"
}

test fn an_available_namesake_is_ready_and_a_provisioning_one_stops() -> Bool {
  named(display: "gunbc-always-free", text: "[{\"id\":\"v1\",\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"AVAILABLE\"}]") == "ready:v1"
    && named(display: "gunbc-always-free", text: "[{\"id\":\"v1\",\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"PROVISIONING\"}]") == "stop"
    && named(display: "gunbc-always-free", text: "[{\"id\":\"v1\",\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"AVAILABLE\"},{\"id\":\"v2\",\"displayName\":\"gunbc-always-free\",\"lifecycleState\":\"AVAILABLE\"}]") == "stop"
}

test fn a_route_table_is_admitted_only_if_it_reaches_this_gateway() -> Bool {
  let good = oci_named_resource_of(v: one(text: "{\"id\":\"rt\",\"displayName\":\"p\",\"lifecycleState\":\"AVAILABLE\",\"routeRules\":[{\"destination\":\"0.0.0.0/0\",\"destinationType\":\"CIDR_BLOCK\",\"networkEntityId\":\"igw1\"}]}"))
  let other = oci_named_resource_of(v: one(text: "{\"id\":\"rt\",\"displayName\":\"p\",\"lifecycleState\":\"AVAILABLE\",\"routeRules\":[{\"destination\":\"0.0.0.0/0\",\"destinationType\":\"CIDR_BLOCK\",\"networkEntityId\":\"igw2\"}]}"))
  let empty = oci_named_resource_of(v: one(text: "{\"id\":\"rt\",\"displayName\":\"p\",\"lifecycleState\":\"AVAILABLE\",\"routeRules\":[]}"))
  oci_route_table_wiring(r: good, igw: "igw1") == ""
    && oci_route_table_wiring(r: other, igw: "igw1") != ""
    && oci_route_table_wiring(r: empty, igw: "igw1") != ""
}

test fn a_subnet_is_admitted_only_on_this_route_table() -> Bool {
  let s = oci_named_resource_of(v: one(text: "{\"id\":\"sn\",\"displayName\":\"p\",\"lifecycleState\":\"AVAILABLE\",\"routeTableId\":\"rt1\"}"))
  oci_subnet_wiring(r: s, route_table: "rt1") == "" && oci_subnet_wiring(r: s, route_table: "rt2") != ""
}

// ── INSTANCES ─────────────────────────────────────────────────────────────────────────────────

fn decide_a1(text: String) -> String {
  match oci_free_plan.skip(n: 2).first() {
    Absent => "no-plan"
    Present { value: p } => match oci_instance_decision(planned: p, observed: map(json_items(text: text), i => oci_observed_instance_of(v: i))) {
      InstanceHeld { line } => "held"
      InstanceLaunch => "launch"
      InstanceStop { line } => "stop"
    }
  }
}

test fn the_a1_instance_launches_when_absent_and_holds_when_running() -> Bool {
  decide_a1(text: "[]") == "launch"
    && decide_a1(text: "[{\"id\":\"i\",\"displayName\":\"gunbc-free-a1\",\"lifecycleState\":\"TERMINATED\",\"shape\":\"VM.Standard.A1.Flex\"}]") == "launch"
    && decide_a1(text: "[{\"id\":\"i\",\"displayName\":\"gunbc-free-a1\",\"lifecycleState\":\"RUNNING\",\"shape\":\"VM.Standard.A1.Flex\"}]") == "held"
}

// A stopped instance was stopped by someone, and a wrong-shaped namesake is not this instance. Neither
// is started, reshaped or replaced.
test fn a_stopped_or_wrong_shaped_namesake_stops_rather_than_launching() -> Bool {
  decide_a1(text: "[{\"id\":\"i\",\"displayName\":\"gunbc-free-a1\",\"lifecycleState\":\"STOPPED\",\"shape\":\"VM.Standard.A1.Flex\"}]") == "stop"
    && decide_a1(text: "[{\"id\":\"i\",\"displayName\":\"gunbc-free-a1\",\"lifecycleState\":\"RUNNING\",\"shape\":\"VM.Standard.E2.1.Micro\"}]") == "stop"
}

// The query values go through extdeps.uri's encoder: an availability domain's colon and the image
// query's space come out percent-encoded, and an empty value refuses before any read is sent.
test fn query_values_are_encoded_by_the_shared_uri_encoder() -> Bool {
  let colon = match oci_query_value(value: "Uocm:US-ASHBURN-AD-1") { OciQueryEncoded { wire } => wire == "Uocm%3AUS-ASHBURN-AD-1"  OciQueryRefused { line } => false }
  let space = match oci_query_value(value: "Oracle Linux") { OciQueryEncoded { wire } => wire == "Oracle%20Linux"  OciQueryRefused { line } => false }
  let empty = match oci_query_value(value: "") { OciQueryRefused { line } => true  OciQueryEncoded { wire } => false }
  colon && space && empty
}

test fn out_of_host_capacity_is_read_from_oracles_500_text_only() -> Bool {
  oci_out_of_host_capacity(status: 500, body: "{\"code\":\"InternalError\",\"message\":\"Out of host capacity.\"}")
    && !oci_out_of_host_capacity(status: 500, body: "{\"code\":\"InternalError\",\"message\":\"something else\"}")
    && !oci_out_of_host_capacity(status: 400, body: "Out of host capacity.")
}

// The A1 launch carries its shapeConfig and both keys. The micro launch carries no shapeConfig,
// because its size is fixed.
test fn launch_bodies_carry_shape_config_only_for_the_flex_shape() -> Bool {
  let micro = match oci_free_plan.first() { Present { value: p } => oci_launch_body(planned: p, compartment: "c", subnet: "s", domain: "AD-1", image: "img") Absent => "" }
  let a1 = match oci_free_plan.skip(n: 2).first() { Present { value: p } => oci_launch_body(planned: p, compartment: "c", subnet: "s", domain: "AD-1", image: "img") Absent => "" }
  !string_contains(s: micro, pattern: "shapeConfig")
    && string_contains(s: a1, pattern: "\"shapeConfig\": {\"ocpus\": 2, \"memoryInGBs\": 12}")
    && string_contains(s: a1, pattern: "\"bootVolumeSizeInGBs\": 50")
    && string_contains(s: oci_free_authorized_keys(), pattern: "fleet-automation@gunbc")
    && string_contains(s: oci_free_authorized_keys(), pattern: "macbook-m4")
}

// A refused ListShapes read is not "this domain lacks the shape" (review 76366). One refused domain
// refuses the selection with its cause, even beside a domain that answered and offers the shape.
// With every read answered, the offering domain is selected.
test fn a_refused_shape_read_refuses_the_selection_rather_than_reading_as_lacking() -> Bool {
  let refused = match oci_select_offering(answers: [oci_domain_answer(domain: "AD-1", offer: DomainReadRefused { line: "ListShapes for AD-1 refused: 500" }), oci_domain_answer(domain: "AD-2", offer: DomainOffers)]) {
    CandidateDomainsRefused { line } => string_contains(s: line, pattern: "AD-1")
    CandidateDomains { domains } => false
  }
  let selected = match oci_select_offering(answers: [oci_domain_answer(domain: "AD-1", offer: DomainLacks), oci_domain_answer(domain: "AD-2", offer: DomainOffers)]) {
    CandidateDomains { domains } => domains == ["AD-2"]
    CandidateDomainsRefused { line } => false
  }
  refused && selected
}
