module test.claim.import_deletion_bridge_witness

import std.types { Bool, String, List, NonEmptyStr }
import extdeps.filesystem.filesystem_io { Filesystem }
import std.occurrence_identity {
  OccurrenceId, OccurrenceIndexEntry, OccurrenceTransport,
  ReferenceOccurrence, DeclarationOccurrence,
}
import std.occurrence_binding_candidates {
  OccurrenceBindingCandidateInputs,
  CrossFileBindingClosureRow,
  AssembledCrossFileBindingClosure,
  AssembledCrossFileBindingClosureReady,
  AssembledCrossFileBindingClosureRefused,
  assemble_cross_file_binding_closure,
  BoundReferenceProvider,
  DeclarationExposureGrounding,
  ModuleLocalMemberExposure,
  CrossFileProviderExportedExposure,
  ReferenceBindingProjectionBound,
  resolve_reference_binding_via_structural_candidates,
}
import v1.gunbc.occurrence_binding_parser_walk {
  ParsedOccurrenceBindingSource,
  ParsedOccurrenceBindingSourceReady,
  ParsedOccurrenceBindingSourceRefused,
  parse_authored_occurrence_binding_source,
  occurrence_binding_inputs_from_transport,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data bridge_witness_note: String = "CHECKPOINT 1 OF IMPORT DELETION — the bridge from the real source population to production occurrence binding, proven on the largest falsifier rather than on a fixture pair.

WHAT THIS PROVES. An import-less consumer reaches a declaration in a REAL production module — v2.std.live_tree, read off disk, not a fixture provider and not an embedded source string — with no import participating in the decision anywhere. LiveTreeDisposition is the subject because it is the largest population that loses its sole provider under strip: 1,673 references corpus-wide. If reference-derived binding cannot reach this declaration, deleting imports cannot work at all.

WHY BOTH FILES ARE READ FROM DISK. The point of this checkpoint is the bridge from the EXISTING source population, so a witness that hands the parser an embedded string would prove the parser and skip the thing under test. Both sides go through filesystem_read, and the provider side is an ordinary production module nobody authored for this test.

WHY PER-REFERENCE RESOLVE AND NOT structural_binding_walk. The walk demands AllReferencesBound over the whole transport. A real production module references types this two-file closure does not contain, so the walk would refuse for reasons that have nothing to do with the claim — and a refusal read as a failure here would be a false red. Resolving the one reference under test keeps the discriminator on the claim.

THE DISCRIMINATING CONTROL IS THE SECOND TEST, NOT AN ASSERTION IN THIS ONE. Binding the reference proves little on its own: it must FAIL when the provider is absent from the assembled closure. Without that control this witness would pass on any closure that happened to contain the name, which is precisely the pool-membership coincidence the whole lane exists to eliminate."

data live_tree_source_path: String = "src/v2/std/live_tree.dag"
data consumer_source_path: String = "dag/test/fixture/import_deletion_bridge/live_tree_consumer_bare.dag"
data provider_module_name: String = "v2.std.live_tree"
data subject_name: String = "LiveTreeDisposition"

fn parsed_row(path: String) -> ParsedOccurrenceBindingSource {
  parse_authored_occurrence_binding_source(
    file: path,
    source: filesystem_read(path: path).content,
  )
}

fn closure_row_for(
  path: String,
  grounding: DeclarationExposureGrounding
) -> List<CrossFileBindingClosureRow> {
  match parsed_row(path: path) {
    ParsedOccurrenceBindingSourceRefused => []
    ParsedOccurrenceBindingSourceReady { transport: t, module_path: m } =>
      [ CrossFileBindingClosureRow {
          transport: t,
          inputs: occurrence_binding_inputs_from_transport(
            module_path: m, transport: t, grounding: grounding,
          ),
          module_path: m,
          file_path: path,
        } ]
  }
}

fn index_entry_for_occurrence(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId
) -> OccurrenceIndexEntry? {
  fold(transport.index.entries, init: none, f: (found, entry) =>
    match found {
      Present { value: _ } => found
      Absent =>
        match entry.projection.occurrence.value == occurrence.value {
          true => Present { value: entry }
          false => Absent
        }
    })
}

fn references_named(transport: OccurrenceTransport, name: String) -> List<ReferenceOccurrence> {
  fold(transport.references, init: [], f: (acc, reference) =>
    match index_entry_for_occurrence(transport: transport, occurrence: reference.occurrence) {
      Absent => acc
      Present { value: entry } =>
        match entry.projection.authored_name == name {
          true => concat(acc, [reference])
          false => acc
        }
    })
}

fn bound_provider_for_subject(
  consumer_path: String,
  provider_paths: List<String>
) -> BoundReferenceProvider? {
  let consumers = closure_row_for(path: consumer_path, grounding: ModuleLocalMemberExposure)
  let providers = fold(provider_paths, init: [], f: (acc, p) =>
    concat(acc, closure_row_for(path: p, grounding: CrossFileProviderExportedExposure)))
  fold(consumers, init: none, f: (outer, consumer_row) =>
    match outer {
      Present { value: _ } => outer
      Absent =>
        match assemble_cross_file_binding_closure(consumer: consumer_row, providers: providers) {
          AssembledCrossFileBindingClosureRefused { refusal: _ } => none
          AssembledCrossFileBindingClosureReady { transport: t, inputs: i, module_files: _, consumer_file: _ } =>
            fold(references_named(transport: t, name: subject_name), init: none, f: (found, reference) =>
              match found {
                Present { value: _ } => found
                Absent =>
                  match resolve_reference_binding_via_structural_candidates(
                    transport: t, inputs: i, reference: reference,
                  ) {
                    ReferenceBindingProjectionBound { provider: provider } => Present { value: provider }
                    _ => none
                  }
              })
        }
    })
}

test fn witness_import_less_reference_reaches_the_real_provider() -> Bool {
  match bound_provider_for_subject(
    consumer_path: consumer_source_path,
    provider_paths: [live_tree_source_path],
  ) {
    Absent => false
    Present { value: provider } =>
      provider.provider_module == provider_module_name
        && !(provider.consumer_module == provider_module_name)
  }
}

data bridge_red_control_note: String = "THE CONTROL. Same consumer, same subject, provider file withheld from the assembled closure. A binding here would mean the reference resolved against something other than the declaration in v2.std.live_tree — pool coincidence rather than derivation — and would invalidate the positive case above."

test fn witness_subject_does_not_bind_without_its_provider() -> Bool {
  match bound_provider_for_subject(consumer_path: consumer_source_path, provider_paths: []) {
    Absent => true
    Present { value: _ } => false
  }
}

data bridge_no_import_note: String = "The consumer carries NO import declaration. This asserts that directly against the bytes on disk rather than trusting the fixture to stay import-less: if someone repairs the fixture by adding an import, the bridge claim would silently become a claim about import-based resolution, and this reds instead."

test fn witness_consumer_carries_no_import_declaration() -> Bool {
  let source = filesystem_read(path: consumer_source_path).content
  !string_contains(s: source, pattern: "import ")
    && string_contains(s: source, pattern: subject_name)
}


data checkpoint_one_finding_note: String = "WHAT THIS WITNESS FOUND, BY EXECUTION, ON ITS FIRST RUN.

The positive case below currently REDS, and the reason is the load-bearing checkpoint-1 finding: the parser mints declaration occurrences for `fn` and `data` declarations but NOT for `type` declarations or their coproduct variants. Narrowed by discriminating probes rather than inferred — the assembled closure is Ready, the consumer's LiveTreeDisposition REFERENCE is present in it, the provider transport carries MORE THAN ONE declaration, and yet neither `LiveTreeDisposition` nor its variant `ReadsLiveTree` appears among them. So the failure is not assembly, not the read, not the reference side, and not an empty provider: it is that the type declaration was never minted.

WHY THIS BLOCKS THE WHOLE LANE. Type references are the dominant residual category (1,893 unique-declaration unresolved plus 603 variant-shaped rows). If a type declaration is not a declaration occurrence, NO type reference can bind by derivation, cross-file or otherwise — so deleting imports is impossible until this closes, and no amount of closure or loader work reaches it.

ONE REAL REPAIR ALREADY LANDED FROM THIS RUN, and it was masked by the above: occurrence_binding_inputs_from_transport hardwired ModuleLocalMemberExposure, which derives ModuleExposure — visible only WITHIN one module — so a provider's exported declarations were unexposed to any cross-file consumer and the candidate population was empty by construction. The grounding is now a parameter chosen at derivation, as DeclarationExposure's own authority requires. That defect was real and would have blocked binding independently; it is simply not the only one.

The two controls below PASS and stay enrolled: they are what make the red above a located finding rather than an unexplained failure."

