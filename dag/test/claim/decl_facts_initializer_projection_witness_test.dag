module test.claim.decl_facts_initializer_projection_witness_test

import test.fixture.decl_facts_reflection.ambiguous_shared_a
import test.fixture.decl_facts_reflection.ambiguous_shared_b { OtherTwo }
import test.fixture.decl_facts_reflection.ambiguous_specimen
import test.claim.decl_facts_reflection_witness_support {
  decl_facts_reflection_constructor_parent,
  decl_facts_reflection_constructor_variant,
  decl_facts_reflection_field_projection,
  decl_facts_reflection_fact_node,
  decl_facts_reflection_lookup,
  duplicate_qualified_identity_lookup_names_primary_and_shadow,
  duplicate_qn_exact_declaration_lookup_per_candidate_is_unique,
  decl_fact_lookup_duplicate_exact_declaration_identity_is_ambiguous_for_qn,
  decl_facts_reflection_value_identity_projection,
  decl_facts_reflection_projection_variant_label_optional,
  decl_facts_reflection_resolved_nullary_parent,
  decl_facts_reflection_resolved_nullary_variant_name,
  decl_facts_reflection_plain_record_parent,
}
import v2.std.data_initializer_identity {
  ambiguous_candidate_projection_count,
  data_initializer_is_constructor_resolution_refused_projection,
  data_initializer_is_typechecked_subject_absent_projection,
  record_field_projection_optional,
  value_projection_is_ambiguous,
  value_projection_is_missing,
  value_projection_is_not_variant_value,
  value_projection_is_resolved_variant,
  decl_fact_lookup_is_missing,
}
import test.claim.decl_facts_reflection_witness_support {
  decl_facts_reflection_fact_node,
}

data disposition_scaffold_qn: String = "test.fixture.decl_facts_reflection.specimens.disposition_scaffold"
data local_a_scaffold_qn: String = "test.fixture.decl_facts_reflection.specimens.local_a_scaffold"
data local_b_scaffold_qn: String = "test.fixture.decl_facts_reflection.specimens.local_b_scaffold"
data local_a_shared_nullary_qn: String = "test.fixture.decl_facts_reflection.specimens.local_a_shared_nullary"
data local_b_shared_nullary_qn: String = "test.fixture.decl_facts_reflection.specimens.local_b_shared_nullary"
data terminal_specimen_qn: String = "test.fixture.decl_facts_reflection.specimens.terminal_specimen"
data mechanism_single_authority_qn: String = "test.fixture.decl_facts_reflection.specimens.mechanism_single_authority"
data mechanism_realization_dispatch_qn: String = "test.fixture.decl_facts_reflection.specimens.mechanism_realization_dispatch"
data missing_variant_specimen_qn: String = "test.fixture.decl_facts_reflection.specimens.missing_variant_specimen"
data ambiguous_arm_specimen_qn: String = "test.fixture.decl_facts_reflection.ambiguous_specimen.ambiguous_arm_specimen"
data duplicate_shadowed_specimen_qn: String = "test.fixture.decl_facts_reflection_duplicate_qn.shadowed_module.shadowed_specimen"
data unimported_globally_unique_specimen_qn: String = "test.fixture.decl_facts_reflection.unimported_globally_unique_user.unimported_globally_unique_specimen"
data scaffold_named_field_bind_qn: String = "test.fixture.decl_facts_reflection.specimens.scaffold_named_field_bind"
data whole_declaration_bind_qn: String = "test.fixture.decl_facts_reflection.specimens.disposition_scaffold"
data scaffold_with_data_ref_qn: String = "test.fixture.decl_facts_reflection.specimens.scaffold_with_data_ref"
data dimensionless_anchor_qn: String = "extdeps.units.dimensionless.extdeps_external_authority_anchor"

test fn decl_facts_reflection_data_ref_with_coproduct_type_is_not_variant_value() -> Bool {
  match decl_facts_reflection_field_projection(qn: scaffold_with_data_ref_qn, field: "dissolves_to") {
    Present { value: projection } => value_projection_is_not_variant_value(node: projection)
    Absent => false
  }
}

test fn decl_facts_reflection_imported_external_authority_positive_control() -> Bool {
  match decl_facts_reflection_plain_record_parent(qn: dimensionless_anchor_qn) {
    Present { value: parent } => parent == "extdeps.external_authority.ExternalAuthority"
    Absent => false
  }
}

test fn decl_facts_reflection_two_unrelated_scaffold_arms_do_not_alias() -> Bool {
  let parent_a = decl_facts_reflection_constructor_parent(qn: local_a_scaffold_qn)
  let parent_b = decl_facts_reflection_constructor_parent(qn: local_b_scaffold_qn)
  let variant_a = decl_facts_reflection_constructor_variant(qn: local_a_scaffold_qn)
  let variant_b = decl_facts_reflection_constructor_variant(qn: local_b_scaffold_qn)
  match parent_a {
    Present { value: pa } =>
      match parent_b {
        Present { value: pb } =>
          match variant_a {
            Present { value: va } =>
              match variant_b {
                Present { value: vb } => va == "TaggedA" && vb == "TaggedB" && pa != pb
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn decl_facts_reflection_two_unrelated_shared_nullary_arms_do_not_alias() -> Bool {
  match decl_facts_reflection_resolved_nullary_parent(qn: local_a_shared_nullary_qn) {
    Present { value: pa } =>
      match decl_facts_reflection_resolved_nullary_parent(qn: local_b_shared_nullary_qn) {
        Present { value: pb } =>
          match decl_facts_reflection_resolved_nullary_variant_name(qn: local_a_shared_nullary_qn) {
            Present { value: va } =>
              match decl_facts_reflection_resolved_nullary_variant_name(qn: local_b_shared_nullary_qn) {
                Present { value: vb } =>
                  va == "SharedNullaryA" && vb == "SharedNullaryB" && pa != pb
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn decl_facts_reflection_disposition_scaffold_constructor_is_std_disposition() -> Bool {
  match decl_facts_reflection_constructor_parent(qn: disposition_scaffold_qn) {
    Present { value: parent } =>
      parent == "std.disposition.Disposition"
        && decl_facts_reflection_constructor_variant(qn: disposition_scaffold_qn) == Present { value: "Scaffold" }
    Absent => false
  }
}

test fn decl_facts_reflection_terminal_vs_scaffold_constructors_distinct() -> Bool {
  match decl_facts_reflection_constructor_variant(qn: terminal_specimen_qn) {
    Present { value: terminal_ctor } =>
      terminal_ctor == "Terminal"
        && decl_facts_reflection_constructor_variant(qn: disposition_scaffold_qn) == Present { value: "Scaffold" }
    Absent => false
  }
}

test fn decl_facts_reflection_single_authority_vs_realization_dispatch_distinct() -> Bool {
  match decl_facts_reflection_resolved_nullary_parent(qn: mechanism_single_authority_qn) {
    Present { value: sp } =>
      match decl_facts_reflection_resolved_nullary_variant_name(qn: mechanism_single_authority_qn) {
        Present { value: sv } =>
          match decl_facts_reflection_resolved_nullary_parent(qn: mechanism_realization_dispatch_qn) {
            Present { value: rp } =>
              match decl_facts_reflection_resolved_nullary_variant_name(qn: mechanism_realization_dispatch_qn) {
                Present { value: rv } =>
                  sp == "std.disposition.ConstructionMechanism"
                    && rp == "std.disposition.ConstructionMechanism"
                    && sv == "SingleAuthority"
                    && rv == "RealizationDispatch"
                    && sv != rv
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn decl_facts_reflection_whole_declaration_vs_named_field_field_grain() -> Bool {
  match decl_facts_reflection_field_projection(qn: whole_declaration_bind_qn, field: "bind") {
    Present { value: whole_bind } =>
      match record_field_projection_optional(record: whole_bind, label: "field") {
        Present { value: whole_field } =>
          match decl_facts_reflection_field_projection(qn: scaffold_named_field_bind_qn, field: "bind") {
            Present { value: named_bind } =>
              match record_field_projection_optional(record: named_bind, label: "field") {
                Present { value: named_field } =>
                  match decl_facts_reflection_projection_variant_label_optional(node: whole_field) {
                    Present { value: whole } =>
                      match decl_facts_reflection_projection_variant_label_optional(node: named_field) {
                        Present { value: named } => whole == "WholeDeclaration" && named == "NamedField"
                        Absent => false
                      }
                    Absent => false
                  }
                Absent => false
              }
            Absent => false
          }
        Absent => false
      }
    Absent => false
  }
}

test fn decl_facts_reflection_missing_variant_refuses_missing_projection() -> Bool {
  match decl_facts_reflection_field_projection(qn: missing_variant_specimen_qn, field: "dissolves_to") {
    Present { value: projection } => value_projection_is_missing(node: projection)
    Absent => false
  }
}

test fn decl_facts_reflection_ambiguous_variant_refuses_ambiguous_projection() -> Bool {
  match decl_facts_reflection_value_identity_projection(qn: ambiguous_arm_specimen_qn) {
    Present { value: projection } =>
      value_projection_is_ambiguous(node: projection)
        && ambiguous_candidate_projection_count(node: projection) == 2
    Absent => false
  }
}

test fn decl_facts_reflection_nullary_mechanism_projection_shape() -> Bool {
  match decl_facts_reflection_nullary_value_projection(qn: mechanism_single_authority_qn) {
    Present { value: projection } => value_projection_is_resolved_variant(node: projection)
    Absent => false
  }
}

test fn decl_facts_reflection_lookup_ambiguous_arrives_at_consumer() -> Bool {
  duplicate_qualified_identity_lookup_names_primary_and_shadow(
    lookup: decl_facts_reflection_lookup(qn: duplicate_shadowed_specimen_qn)
  )
}

test fn decl_fact_lookup_duplicate_qualified_identity_returns_ambiguous_both_candidates() -> Bool {
  duplicate_qualified_identity_lookup_names_primary_and_shadow(
    lookup: decl_facts_reflection_lookup(qn: duplicate_shadowed_specimen_qn)
  )
}

test fn decl_facts_reflection_unimported_globally_unique_refuses_constructor_resolution() -> Bool {
  match decl_facts_reflection_fact_node(qn: unimported_globally_unique_specimen_qn) {
    Present { value: node } => data_initializer_is_constructor_resolution_refused_projection(node: node)
    Absent => false
  }
}

test fn decl_facts_reflection_lookup_missing_vs_present_fact_distinct() -> Bool {
  let bogus_qn: String = "test.fixture.decl_facts_reflection.specimens.nonexistent_data_row"
  decl_fact_lookup_is_missing(lookup: decl_facts_reflection_lookup(qn: bogus_qn))
    && match decl_facts_reflection_fact_node(qn: missing_variant_specimen_qn) {
      Present { value: node } =>
        !data_initializer_is_typechecked_subject_absent_projection(node: node)
      Absent => false
    }
}

test fn decl_facts_reflection_absent_vs_refused_vs_missing_projections_distinct() -> Bool {
  match decl_facts_reflection_fact_node(qn: unimported_globally_unique_specimen_qn) {
    Present { value: refused_node } =>
      if data_initializer_is_constructor_resolution_refused_projection(node: refused_node) {
        match decl_facts_reflection_field_projection(qn: missing_variant_specimen_qn, field: "dissolves_to") {
          Present { value: missing_projection } =>
            value_projection_is_missing(node: missing_projection)
              && !data_initializer_is_typechecked_subject_absent_projection(node: refused_node)
          Absent => false
        }
      } else {
        false
      }
    Absent => false
  }
}

test fn decl_facts_duplicate_qn_exact_declaration_lookup_per_candidate_is_unique() -> Bool {
  duplicate_qn_exact_declaration_lookup_per_candidate_is_unique(
    lookup: decl_facts_reflection_lookup(qn: duplicate_shadowed_specimen_qn)
  )
}

test fn decl_facts_duplicate_exact_declaration_identity_lookup_is_ambiguous() -> Bool {
  decl_fact_lookup_duplicate_exact_declaration_identity_is_ambiguous_for_qn(
    qn: disposition_scaffold_qn
  )
}
