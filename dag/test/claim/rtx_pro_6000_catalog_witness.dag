data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// NVIDIA publishes 1792 GB/s for Workstation and Max-Q and 1597 GB/s for Server Edition: two
// correct figures for three editions, not a disagreement about one card.
test fn w_workstation_bandwidth_is_1792() -> Bool {
  match gpu_catalog_bandwidth_count(row: nvidia_rtx_pro_6000_workstation_catalog) {
    Present { value: n } => n == 1792000000000
    Absent => false
  }
}

test fn w_max_q_bandwidth_is_1792() -> Bool {
  match gpu_catalog_bandwidth_count(row: nvidia_rtx_pro_6000_max_q_catalog) {
    Present { value: n } => n == 1792000000000
    Absent => false
  }
}

test fn w_server_bandwidth_is_1597() -> Bool {
  match gpu_catalog_bandwidth_count(row: nvidia_rtx_pro_6000_server_catalog) {
    Present { value: n } => n == 1597000000000
    Absent => false
  }
}

// The Hetzner listing names the card as a string; it must resolve to exactly one catalog row.
test fn w_hetzner_max_q_string_resolves_to_row() -> Bool {
  match hetzner_gex131_listed.workload {
    CpuWithGpu { gpu_description } =>
      gpu_description == "NVIDIA " + nvidia_rtx_pro_6000_max_q_catalog.model
    CpuOnly => false
  }
}

data observed_region: NonEmptyStr = "observed-region-for-this-witness"

fn a_read_region() -> ProviderRegionObservation {
  ProviderRegionRead {
    region: decl_ref(module_path: "test.claim.rtx_pro_6000_catalog_witness", decl_name: "observed_region"),
  }
}

fn vast_offer_arch(gpus: Int, arch: String?) -> VastAiOffer {
  VastAiOffer {
    id: 1, machine_id: 2, gpu_name: "RTX PRO 6000 S", num_gpus: gpus,
    compute_cap: 1200, gpu_arch: arch,
    verification: "verified", geolocation: "US", rentable: true, rented: false, is_bid: Present { value: false },
    min_bid: ExactDecimal { units: 32, fraction_digits: 1 },
    dph_total: ExactDecimal { units: 32, fraction_digits: 1 },
    storage_cost: ExactDecimal { units: 15, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    gpu_ram: 98304,
    driver_version: Present { value: "580.65.06" },
  }
}

fn vast_offer(gpus: Int) -> VastAiOffer {
  vast_offer_arch(gpus: gpus, arch: Present { value: "nvidia" })
}

fn vast_offer_bid(bid: Bool?) -> VastAiOffer {
  VastAiOffer {
    id: 1, machine_id: 2, gpu_name: "RTX PRO 6000 S", num_gpus: 2,
    compute_cap: 1200, gpu_arch: Present { value: "nvidia" },
    verification: "verified", geolocation: "US", rentable: true, rented: false, is_bid: bid,
    min_bid: ExactDecimal { units: 32, fraction_digits: 1 },
    dph_total: ExactDecimal { units: 32, fraction_digits: 1 },
    storage_cost: ExactDecimal { units: 15, fraction_digits: 2 },
    inet_up_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    inet_down_cost: ExactDecimal { units: 1, fraction_digits: 2 },
    gpu_ram: 98304,
    driver_version: Present { value: "580.65.06" },
  }
}

fn hourly() -> MoneyPerHour {
  MoneyPerHour { amount: money_amount_micro(count: 3200000), currency: Usd }
}

fn vast_shape_arch(offer: VastAiOffer, region: ProviderRegionObservation) -> Shape? {
  match bind_vast_ai_offer(
    principal: "gunbc", executor: "gunbc", offer: offer,
    threads: hardware_thread_count(count: 16), min_vram: byte_size(103079215104), rate: hourly(),
    billing_quantum: second(count: 1), capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: region, quoted_at: "2026-10-11T00:00:00Z", valid_until: "2026-10-12T00:00:00Z",
    receipt: "r2", key: "vast-offer-1",
  ) {
    OfferBound { bound: b } => Present { value: b.offer.shape }
    OfferBindingRefused { runs_on_label: _, cause: _ } => none
  }
}

// Unmet axes of an offered-GPUs shape against a needed-GPUs shape; -1 when either refused to bind.
fn vast_shape_for(gpus: Int, region: ProviderRegionObservation) -> Shape? {
  vast_shape_arch(offer: vast_offer(gpus: gpus), region: region)
}

fn unmet_count(offered_gpus: Int, needed_gpus: Int) -> Int {
  match vast_shape_for(gpus: offered_gpus, region: a_read_region()) {
    Absent => 0 - 1
    Present { value: offered } =>
      match vast_shape_for(gpus: needed_gpus, region: a_read_region()) {
        Absent => 0 - 1
        Present { value: needed } => count(unmet_shape_axes(offered: offered, needed: needed))
      }
  }
}

// A 1x and a 2x offer of one card are different shapes, and the fabric's own fold tells them apart:
// a 2x requirement is NOT covered by a 1x offer (RED) and IS covered by a 2x offer (control).
test fn w_one_gpu_offer_does_not_cover_a_two_gpu_requirement() -> Bool {
  unmet_count(offered_gpus: 1, needed_gpus: 2) == 1
}

test fn w_two_gpu_offer_covers_a_two_gpu_requirement() -> Bool {
  unmet_count(offered_gpus: 2, needed_gpus: 2) == 0
}

test fn w_vast_unobserved_region_refuses() -> Bool {
  match vast_shape_for(gpus: 2, region: ProviderRegionUnread {
    obligation: decl_ref(module_path: "test.claim.rtx_pro_6000_catalog_witness", decl_name: "observed_region"),
  }) {
    Present { value: _ } => false
    Absent => true
  }
}

// RED: AMD and an unread gpu_arch refuse (no Cuda runtime is minted for them); nvidia is the control.
test fn w_vast_non_nvidia_or_unread_arch_refuses() -> Bool {
  match vast_shape_arch(offer: vast_offer_arch(gpus: 2, arch: Present { value: "amd" }), region: a_read_region()) {
    Present { value: _ } => false
    Absent =>
      match vast_shape_arch(offer: vast_offer_arch(gpus: 2, arch: none), region: a_read_region()) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

test fn w_vast_nvidia_arch_binds_with_cuda() -> Bool {
  match vast_shape_arch(offer: vast_offer(gpus: 2), region: a_read_region()) {
    Present { value: _ } => true
    Absent => false
  }
}

fn packet_pool(region: PacketAiRegion?) -> PacketAiPool {
  PacketAiPool {
    id: "pool-1", name: "pool", gpu_model: "RTX 6000 Pro", available_gpus: 8,
    region: region,
  }
}

fn packet_binds_in(region: ProviderRegionObservation) -> String {
  match bind_packet_ai_offer(
    storefront: storefront_for(tier: TierWholeCard),
    principal: "gunbc", executor: "gunbc", product: packet_product(vram: Present { value: 96 }),
    gpu_count: CountFixedByPool { gpus_per_instance: 2 },
    threads: hardware_thread_count(count: 16), billing_quantum: second(count: 3600),
    capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: region, quoted_at: "2026-10-11T00:00:00Z",
    valid_until: "2026-10-12T00:00:00Z", receipt: "r2",
  ) {
    OfferBound { bound: _ } => "bound"
    OfferBindingRefused { runs_on_label: _, cause: _ } => "refused"
  }
}

fn observed_region_row() -> DeclarationRef {
  decl_ref(module_path: "test.claim.rtx_pro_6000_catalog_witness", decl_name: "observed_region")
}

// RED: a pool with no region is an unread location and the region admission refuses at the bind;
// the same pool with a region is the positive control.
test fn w_packet_pool_without_region_refuses() -> Bool {
  packet_binds_in(region: packet_ai_pool_region(pool: packet_pool(region: none), region_row: observed_region_row())) == "refused"
    && packet_binds_in(region: packet_ai_pool_region(
      pool: packet_pool(region: Present { value: PacketAiRegion { id: none, name: "r", city: "c", country: "US" } }),
      region_row: observed_region_row(),
    )) == "bound"
}

// The vendor's storefront row for the product; the tier is what its `allocation` string says.
fn storefront_for(tier: PacketAiTierFact) -> PacketAiStorefrontProduct? {
  match tier {
    TierWholeCard => Present { value: PacketAiStorefrontProduct { id: "p1", name: "RTX 6000 Pro 96GB", allocation: Present { value: Dedicated }, gpuCount: 2 } }
    TierShared => Present { value: PacketAiStorefrontProduct { id: "p1", name: "RTX 6000 Pro 96GB", allocation: Present { value: Dynamic }, gpuCount: 2 } }
    TierNotEstablished => none
  }
}

fn packet_product(vram: Int?) -> PacketAiProduct {
  PacketAiProduct {
    id: "p1", name: "RTX 6000 Pro 96GB", featured: true, poolIds: [1], pricePerHourCents: 189,
    totalAvailableGpus: 8, vramGb: vram,
    regions: [PacketAiRegion { id: none, name: "r", city: "c", country: "US" }],
  }
}

fn packet_quote(count: PacketAiPoolGpuCount) -> OfferQuote {
  match bind_packet_ai_offer(
    storefront: storefront_for(tier: TierWholeCard),
    principal: "gunbc", executor: "gunbc", product: packet_product(vram: Present { value: 96 }), gpu_count: count,
    threads: hardware_thread_count(count: 16), billing_quantum: second(count: 3600),
    capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z",
    valid_until: "2026-10-12T00:00:00Z", receipt: "r2",
  ) {
    OfferBound { bound: b } => b.offer.quote
    OfferBindingRefused { runs_on_label: _, cause: _ } => QuotedPerHour(MoneyPerHour { amount: money_amount_micro(count: 0), currency: Usd })
  }
}

fn packet_expected(cents: Int) -> OfferQuote {
  QuotedPerHour(MoneyPerHour { amount: money_amount_micro(count: cents * 10000), currency: Usd })
}

// RED: pricePerHourCents is per GPU, so a 2-GPU pool's instance costs twice the 1-GPU pool's.
test fn w_packet_offer_price_scales_with_gpus_per_instance() -> Bool {
  packet_quote(count: CountFixedByPool { gpus_per_instance: 1 }) == packet_expected(cents: 189)
    && packet_quote(count: CountFixedByPool { gpus_per_instance: 2 }) == packet_expected(cents: 378)
}

fn packet_binds(count: PacketAiPoolGpuCount, vram: Int?) -> String {
  match bind_packet_ai_offer(
    storefront: storefront_for(tier: TierWholeCard),
    principal: "gunbc", executor: "gunbc", product: packet_product(vram: vram), gpu_count: count,
    threads: hardware_thread_count(count: 16), billing_quantum: second(count: 3600),
    capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z",
    valid_until: "2026-10-12T00:00:00Z", receipt: "r2",
  ) {
    OfferBound { bound: _ } => "bound"
    OfferBindingRefused { runs_on_label: _, cause: _ } => "refused"
  }
}

test fn w_packet_pool_with_fixed_count_binds() -> Bool {
  packet_binds(count: CountFixedByPool { gpus_per_instance: 2 }, vram: Present { value: 96 }) == "bound"
}

// RED: a pool whose GPU count nobody established refuses; it is not assumed to be one.
test fn w_packet_pool_with_unestablished_count_refuses() -> Bool {
  packet_binds(
    count: CountUnestablished {
      obligation: decl_ref(module_path: "product.supplier.packet_ai", decl_name: "packet_ai_vram_unstated_obligation"),
    },
    vram: Present { value: 96 },
  ) == "refused"
}

test fn w_packet_product_without_vram_refuses() -> Bool {
  packet_binds(count: CountFixedByPool { gpus_per_instance: 2 }, vram: none) == "refused"
}

// Workstation datasheet and Server page state 24,064; Max-Q still does not.
test fn w_cuda_core_standing_is_cited_only_for_server() -> Bool {
  (match rtx_pro_6000_server_cuda_core_standing {
    CitedToAuthority { authority: _ } => true
    TranscribedUncited { read_obligation: _ } => false
    ObservedByReceipt { observed: _ } => false
  })
    && (match rtx_pro_6000_workstation_cuda_core_standing {
      TranscribedUncited { read_obligation: _ } => false
      CitedToAuthority { authority: a } =>
        (a.uri.locator as String) == (rtx_pro_6000_workstation_datasheet_authority.uri.locator as String)
      ObservedByReceipt { observed: _ } => false
    })
    && (match rtx_pro_6000_max_q_cuda_core_standing {
      TranscribedUncited { read_obligation: _ } => true
      CitedToAuthority { authority: _ } => false
      ObservedByReceipt { observed: _ } => false
    })
}

// Identity join, not a count: every cited figure sits on the row it names (list_cover is both
// directions, so a citation list attached to no row, or a row figure no list states, is red).
// Workstation CUDA cores and PCIe endpoint cite the 3519208 datasheet, not the product page.
fn figure_citation_eq(a: FactCitation, b: FactCitation) -> Bool {
  a.fact == b.fact && a.authority == b.authority
}

fn row_cites_field(row: GpuDeviceCatalogRow, decl_name: String, field_name: String) -> Bool {
  row.figure_citations.any(c => c.fact == decl_field_ref(module_path: "extdeps.gpu.nvidia", decl_name: decl_name, field_name: field_name))
}

test fn w_figure_citation_lists_are_carried_by_their_rows() -> Bool {
  list_cover(held: nvidia_rtx_pro_6000_workstation_catalog.figure_citations, expected: rtx_pro_6000_workstation_figure_citations, eq: figure_citation_eq)
    && list_cover(held: nvidia_rtx_pro_6000_max_q_catalog.figure_citations, expected: rtx_pro_6000_max_q_figure_citations, eq: figure_citation_eq)
    && list_cover(held: nvidia_rtx_pro_6000_server_catalog.figure_citations, expected: rtx_pro_6000_server_figure_citations, eq: figure_citation_eq)
}

test fn w_figure_citations_name_their_own_row_fields() -> Bool {
  row_cites_field(row: nvidia_rtx_pro_6000_workstation_catalog, decl_name: "nvidia_rtx_pro_6000_workstation_catalog", field_name: "memory_bandwidth")
    && row_cites_field(row: nvidia_rtx_pro_6000_max_q_catalog, decl_name: "nvidia_rtx_pro_6000_max_q_catalog", field_name: "memory_bandwidth")
    && row_cites_field(row: nvidia_rtx_pro_6000_server_catalog, decl_name: "nvidia_rtx_pro_6000_server_catalog", field_name: "execution_lane_count")
    && row_cites_field(row: nvidia_rtx_pro_6000_workstation_catalog, decl_name: "nvidia_rtx_pro_6000_workstation_catalog", field_name: "execution_lane_count")
}


// SUPPLIER-NEUTRAL TENANCY NEGOTIATION. Both offers are bound by their own supplier module with no
// role and no policy (one-second billing quantum on both so the ranking compares rates, not rounding); what separates them is the isolation each OFFER states (Packet from its tier
// fact, Vast as a whole-device rental) and the price. The requirement, not the supplier, decides.
fn packet_offer(tier: PacketAiTierFact) -> SupplierOffer<NonEmptyStr>? {
  match bind_packet_ai_offer(
    storefront: storefront_for(tier: tier),
    principal: "gunbc", executor: "gunbc", product: packet_product(vram: Present { value: 96 }),
    gpu_count: CountFixedByPool { gpus_per_instance: 2 },
    threads: hardware_thread_count(count: 16), billing_quantum: second(count: 1),
    capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z",
    valid_until: "2026-10-12T00:00:00Z", receipt: "r2",
  ) {
    OfferBound { bound: b } => Present { value: b.offer }
    OfferBindingRefused { runs_on_label: _, cause: _ } => none
  }
}

fn vast_offer_bound(rate_micro: Int) -> SupplierOffer<NonEmptyStr>? {
  match bind_vast_ai_offer(
    principal: "gunbc", executor: "gunbc", offer: vast_offer(gpus: 2),
    threads: hardware_thread_count(count: 16), min_vram: byte_size(103079215104),
    rate: MoneyPerHour { amount: money_amount_micro(count: rate_micro), currency: Usd },
    billing_quantum: second(count: 1), capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z", valid_until: "2026-10-12T00:00:00Z",
    receipt: "r2", key: "vast-offer-1",
  ) {
    OfferBound { bound: b } => Present { value: b.offer }
    OfferBindingRefused { runs_on_label: _, cause: _ } => none
  }
}

fn requirement_with(offer: SupplierOffer<NonEmptyStr>, isolation: IsolationProfile) -> ExecutionRequirements {
  ExecutionRequirements {
    capacity_class: ControlPlaneCapacity,
    shape: offer.shape,
    capabilities: offer.capabilities,
    trust_domain: offer.trust_domain,
    isolation: isolation,
    revocation: WarmResidencyRequired,
  }
}

fn candidate_of(offer: SupplierOffer<NonEmptyStr>) -> List<CandidateOffer<NonEmptyStr>> {
  bound(
    offer: offer,
    admission: fixture_admitted_for_offer(route: offer.route, offer: offer.id),
    demand: fixture_demand_for(offer: offer.id),
    work: fixture_work_for(offer: offer.id),
  )
}

// The winner's offer key under the requirement, or "none".
fn winner_key(packet: SupplierOffer<NonEmptyStr>, vast: SupplierOffer<NonEmptyStr>, isolation: IsolationProfile) -> String {
  match first(ranked(
    requirements: requirement_with(offer: vast, isolation: isolation),
    candidates: concat(candidate_of(offer: packet), candidate_of(offer: vast)),
  )) {
    Absent => "none"
    Present { value: w } => w.candidate.offer.id.key
  }
}

fn tenancy_winner(packet_tier: PacketAiTierFact, vast_rate_micro: Int, isolation: IsolationProfile) -> String {
  match packet_offer(tier: packet_tier) {
    Absent => "unbound"
    Present { value: packet } =>
      match vast_offer_bound(rate_micro: vast_rate_micro) {
        Absent => "unbound"
        Present { value: vast } => winner_key(packet: packet, vast: vast, isolation: isolation)
      }
  }
}

fn dedicated_tenancy() -> IsolationProfile {
  IsolationProfile { guarantees: [DedicatedDevice] }
}

fn sharing_tolerated() -> IsolationProfile {
  IsolationProfile { guarantees: [] }
}

// RED: a qualification-shaped requirement (dedicated device) excludes the shared Packet offer BEFORE
// ranking even though it is the CHEAPER one (378c vs 4.00 USD/h), so the dearer dedicated Vast offer wins.
test fn w_dedicated_requirement_excludes_shared_packet_before_cost() -> Bool {
  tenancy_winner(packet_tier: TierShared, vast_rate_micro: 4000000, isolation: dedicated_tenancy()) == "vast-offer-1"
}

// A pool whose tier nobody established does not provide dedicated tenancy either.
test fn w_dedicated_requirement_excludes_unestablished_tier() -> Bool {
  tenancy_winner(packet_tier: TierNotEstablished, vast_rate_micro: 4000000, isolation: dedicated_tenancy()) == "vast-offer-1"
}

// CONTROL: a whole-card Packet pool provides DedicatedDevice, so both are admitted and cost ranks.
test fn w_dedicated_requirement_admits_whole_card_packet_and_ranks_by_cost() -> Bool {
  tenancy_winner(packet_tier: TierWholeCard, vast_rate_micro: 4000000, isolation: dedicated_tenancy()) == "RTX 6000 Pro 96GB"
}

// CONTROL: a requirement that tolerates sharing admits both and ranks by cost: cheaper Packet wins,
// and when Vast is the cheaper one it wins instead.
test fn w_sharing_tolerant_requirement_ranks_both_by_cost() -> Bool {
  tenancy_winner(packet_tier: TierShared, vast_rate_micro: 4000000, isolation: sharing_tolerated()) == "RTX 6000 Pro 96GB"
    && tenancy_winner(packet_tier: TierShared, vast_rate_micro: 1000000, isolation: sharing_tolerated()) == "vast-offer-1"
}

fn vast_provides_dedicated(bid: Bool?) -> Bool {
  match bind_vast_ai_offer(
    principal: "gunbc", executor: "gunbc", offer: vast_offer_bid(bid: bid),
    threads: hardware_thread_count(count: 16), min_vram: byte_size(103079215104), rate: hourly(),
    billing_quantum: second(count: 1), capabilities: "cap-1", trust_domain: "trust-1",
    readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
    region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z", valid_until: "2026-10-12T00:00:00Z",
    receipt: "r2", key: "vast-offer-1",
  ) {
    OfferBound { bound: b } =>
      (unsatisfied_isolation_guarantees(required: dedicated_tenancy(), provided: b.offer.isolation) |> count) == 0
    OfferBindingRefused { runs_on_label: _, cause: _ } => false
  }
}

// RED: an interruptible (bid) or unread-is_bid Vast offer provides no dedicated tenancy; on-demand does.
test fn w_vast_dedicated_only_when_observed_on_demand() -> Bool {
  vast_provides_dedicated(bid: Present { value: false })
    && !vast_provides_dedicated(bid: Present { value: true })
    && !vast_provides_dedicated(bid: none)
}

// RED: a storefront row naming another product, or an unrecognised allocation, is not an established tier.
test fn w_packet_tier_is_read_from_the_wire_or_unestablished() -> Bool {
  let product = packet_product(vram: Present { value: 96 })
  let other = PacketAiStorefrontProduct { id: "p2", name: "other", allocation: Present { value: Dedicated }, gpuCount: 2 }
  let odd = PacketAiStorefrontProduct { id: "p1", name: "RTX 6000 Pro 96GB", allocation: none, gpuCount: 2 }
  (match packet_ai_tier(product: product, storefront: Present { value: other }) { TierNotEstablished => true TierShared => false TierWholeCard => false })
    && (match packet_ai_tier(product: product, storefront: Present { value: odd }) { TierNotEstablished => true TierShared => false TierWholeCard => false })
    && (match packet_ai_tier(product: product, storefront: none) { TierNotEstablished => true TierShared => false TierWholeCard => false })
}

fn is_not_observed(f: UnexpressedSupplyFact) -> Bool {
  match f {
    IsolationNotObserved => true
    _ => false
  }
}

// IsolationNotObserved means nobody looked: an observed is_bid (on-demand OR bid) carries none, and
// only the unread arm carries it.
test fn w_vast_isolation_not_observed_only_when_is_bid_unread() -> Bool {
  (vast_ai_unexpressed(offer: vast_offer_bid(bid: Present { value: false })).any(is_not_observed) == false)
    && (vast_ai_unexpressed(offer: vast_offer_bid(bid: Present { value: true })).any(is_not_observed) == false)
    && vast_ai_unexpressed(offer: vast_offer_bid(bid: none)).any(is_not_observed)
}

test fn w_packet_isolation_not_observed_only_when_tier_unestablished() -> Bool {
  (packet_ai_unexpressed(tier: TierWholeCard).any(is_not_observed) == false)
    && (packet_ai_unexpressed(tier: TierShared).any(is_not_observed) == false)
    && packet_ai_unexpressed(tier: TierNotEstablished).any(is_not_observed)
}


// RESPONSE REPLAY ACROSS THE WIRE BOUNDARY: a recorded dash.packet.ai /api/products body is decoded by
// the type-directed REST decode (the probe op carries ListProducts' output shape and response type), the
// decoded row reaches packet_ai_tier and the bind, and the offer provides DedicatedDevice. The hand-built
// storefront rows above skip this boundary; this is its inhabitance claim.
data replay_store: String = "packet-storefront"

fn storefront_frame(body: String) -> WitnessEvaluationFrame<Unit> {
  WitnessEvaluationFrame {
    envelope: Envelope {
      frame: Frame { name: "packet-storefront-replay", kind: SharedStateFrame }
      grants: [Grant {
        verb: Read
        root: NamespacePosition { tree: ServiceOpTree { service: "test.RestReplay" }, path: [] }
        binding: Replay { fixture_store: replay_store }
        lifecycle: LifecycleByConstruction
      }]
    }
    rest_fixtures: [RestExchangeFixture {
      store: replay_store
      invocation: RestBoundOperationInvocation {
        at: OperationRef {
          path: "dag/test/fixture/rest_exchange_replay_probe.dag"
          service: "test.RestReplay"
          operation: "StorefrontProductsPage"
        }
        method: GET
        target: Uri { scheme: Https, locator: "rest-replay.invalid/answer" }
        input_digest: Fnv1a64Structural { digest: "0000000000000000" }
        auth_identity: RestUnauthenticated
      }
      observation: RestResponseObserved { status: 200, body: RestBodyRead { body: body } }
    }]
    realization: none
  }
}

fn storefront_body(allocation: String) -> String {
  "{\"data\":[{\"id\":\"p1\",\"name\":\"RTX 6000 Pro 96GB\",\"allocation\":" + allocation + ",\"gpuCount\":2}]}"
}

fn replayed_tier_isolation_dedicated(body: String) -> Bool {
  match evaluate_in_witness_frame(frame: storefront_frame(body: body), subject: fn(_scope) {
    match test.RestReplay.StorefrontProductsPage() {
      RestAnswered { answer } =>
        match bind_packet_ai_offer(
          storefront: answer.products.first(),
          principal: "gunbc", executor: "gunbc", product: packet_product(vram: Present { value: 96 }),
          gpu_count: CountFixedByPool { gpus_per_instance: 2 },
          threads: hardware_thread_count(count: 16), billing_quantum: second(count: 3600),
          capabilities: "cap-1", trust_domain: "trust-1",
          readiness: ReadinessMeasured { ready_at: "2026-10-11T00:00:00Z", receipt: "r1" },
          region: a_read_region(), quoted_at: "2026-10-11T00:00:00Z",
          valid_until: "2026-10-12T00:00:00Z", receipt: "r2",
        ) {
          OfferBound { bound: b } =>
            (unsatisfied_isolation_guarantees(required: dedicated_tenancy(), provided: b.offer.isolation) |> count) == 0
          OfferBindingRefused { runs_on_label: _, cause: _ } => false
        }
      RestRefused { refusal: _ } => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

fn replay_refuses_at_allocation(body: String) -> Bool {
  match evaluate_in_witness_frame(frame: storefront_frame(body: body), subject: fn(_scope) {
    match test.RestReplay.StorefrontProductsPage() {
      RestRefused { refusal: RestBodyUndecodable { status, cause } } =>
        status == 200 && string_contains(s: cause, pattern: "allocation")
      _ => false
    }
  }) {
    WitnessReturned { value } => value
    WitnessRefused { diagnostic: _ } => false
    WitnessInterrupted { at: _, route: _, state: _ } => false
  }
}

test fn w_recorded_dedicated_body_reaches_dedicated_device() -> Bool {
  replayed_tier_isolation_dedicated(body: storefront_body(allocation: "\"dedicated\""))
}

// RED: dynamic is shared (no DedicatedDevice); null is unread (none); both ANSWER and give no dedicated.
test fn w_recorded_dynamic_and_null_bodies_do_not_provide_dedicated() -> Bool {
  (replayed_tier_isolation_dedicated(body: storefront_body(allocation: "\"dynamic\"")) == false)
    && (replayed_tier_isolation_dedicated(body: storefront_body(allocation: "null")) == false)
}

// RED: a case variant or unknown word refuses the decode at the located field; it is never a default arm.
test fn w_recorded_case_variant_or_unknown_allocation_refuses_decode() -> Bool {
  replay_refuses_at_allocation(body: storefront_body(allocation: "\"Dedicated\""))
    && replay_refuses_at_allocation(body: storefront_body(allocation: "\"DEDICATED\""))
    && replay_refuses_at_allocation(body: storefront_body(allocation: "\"reserved\""))
}
