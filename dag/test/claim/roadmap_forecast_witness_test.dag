test fn witness_dependency_cycle_refuses() -> Bool {
  let a = sized_node(id: "cycle-a", cell: fixture_cell())
  let b = sized_node(id: "cycle-b", cell: fixture_cell())
  match gunbc.roadmap_forecast.schedule_forecast(
    nodes: [a, b],
    edges: [
      gunbc.roadmap_model.RoadmapEdge { child: a.node, parent: b.node },
      gunbc.roadmap_model.RoadmapEdge { child: b.node, parent: a.node },
    ],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    gunbc.roadmap_forecast.ScheduleForecastKnown { forecast: _ } => false
    gunbc.roadmap_forecast.ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
      gunbc.roadmap_forecast.DependencyCycle { nodes } => count(nodes) == 2
      gunbc.roadmap_forecast.ForecastGraphEmpty => false
      gunbc.roadmap_forecast.DependencyEndpointUnknown { nodes: _ } => false
      gunbc.roadmap_forecast.NodeUnsized { nodes: _ } => false
      gunbc.roadmap_forecast.CycleTimeObservationNonPositive { nodes: _ } => false
      gunbc.roadmap_forecast.NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      gunbc.roadmap_forecast.WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      gunbc.roadmap_forecast.CalibrationHistoryRefused { refusals: _ } => false
      gunbc.roadmap_forecast.ForecastRoadmapAuthorityRefused { detail: _ } => false
      gunbc.roadmap_forecast.ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_forecast_cannot_promote_into_observation_position() -> Bool {
  let a = sized_node(id: "projection-a", cell: fixture_cell())
  let observed: gunbc.roadmap_forecast.CycleTimeObservation = first(fixture_observations())
  match gunbc.roadmap_forecast.schedule_forecast(
    nodes: [a],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    gunbc.roadmap_forecast.ScheduleForecastRefused { refusals: _ } => false
    gunbc.roadmap_forecast.ScheduleForecastKnown { forecast } => {
      let projected: gunbc.roadmap_forecast.ScheduleForecast = forecast
      std.measure.millisecond_count(m: observed.cycle_time) == 10
        && projected.anchor.observed_at == anchor().observed_at
    }
  }
}
