module test.claim.roadmap_forecast_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn assumptions_with_cap(max_concurrent: Int) -> gunbc.roadmap_forecast.ScheduleForecastAssumptions {
  gunbc.roadmap_forecast.ScheduleForecastAssumptions {
    worker_concurrency_cap: gunbc.roadmap_belt.BeltCapacity { max_concurrent: max_concurrent },
    review_cycle_count: gunbc.roadmap_forecast.ReviewCycleCount { count: positive_measure_count(predecessor: 0) },
    operator_merge_latency: gunbc.roadmap_forecast.OperatorMergeLatencyAssumption { duration: millisecond(count: 5) },
    belt_slot_occupancy: end_to_end_belt_slot_occupancy_assumption,
  }
}

fn assumptions() -> gunbc.roadmap_forecast.ScheduleForecastAssumptions {
  assumptions_with_cap(max_concurrent: 3)
}

fn anchor() -> gunbc.roadmap_forecast.ForecastAnchorObservation {
  gunbc.roadmap_forecast.ForecastAnchorObservation { observed_at: 1000 }
}

fn sized_node(id: String, cell: gunbc.roadmap_forecast.SizingCell) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: concat("fixture-", id) as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: id as gunbc.roadmap_model.RoadmapNodeId,
    line: gunbc.roadmap_status.PlainLine { content: id },
    carriers: [],
    sizing: gunbc.roadmap_model.Sized {
      intricacy: cell.intricacy,
      volume: cell.volume,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: "fixture",
    signoff: Unsigned,
  }
}

fn unsized_node(id: String) -> gunbc.roadmap_model.RoadmapNode {
  let base = sized_node(id: id, cell: gunbc.roadmap_forecast.SizingCell { intricacy: IntricacyLow, volume: VolumeSmall })
  gunbc.roadmap_model.RoadmapNode {
    identity: base.identity,
    node: base.node,
    line: base.line,
    carriers: base.carriers,
    sizing: Unsized,
    execution: base.execution,
    owner: base.owner,
    signoff: base.signoff,
  }
}

fn observation(id: String, cell: gunbc.roadmap_forecast.SizingCell, duration_ms: Int) -> gunbc.roadmap_forecast.CycleTimeObservation {
  gunbc.roadmap_forecast.CycleTimeObservation {
    node: id as gunbc.roadmap_model.RoadmapNodeId,
    sizing_cell: cell,
    pull_number: duration_ms,
    cycle_time: millisecond(count: duration_ms),
    accepted_on: "2026-08-01",
    source_url: "https://github.com/gunb-ai/gunbc/pull/1",
    provenance: AcceptedRoadmapNodePullHistory,
  }
}

fn fixture_cell() -> gunbc.roadmap_forecast.SizingCell {
  gunbc.roadmap_forecast.SizingCell { intricacy: IntricacyMedium, volume: VolumeMedium }
}

fn fixture_observations() -> List<gunbc.roadmap_forecast.CycleTimeObservation> {
  [
    test.claim.roadmap_forecast_witness.observation(id: "history-a", cell: fixture_cell(), duration_ms: 10),
    test.claim.roadmap_forecast_witness.observation(id: "history-b", cell: fixture_cell(), duration_ms: 20),
    test.claim.roadmap_forecast_witness.observation(id: "history-c", cell: fixture_cell(), duration_ms: 30),
  ]
}

test fn witness_cited_acceptance_pr_history_joins_without_refusal() -> Bool {
  let builds = roadmap_cycle_time_observation_builds()
  count(builds) == 10
    && count(accepted_cycle_time_observations(builds: builds)) == 4
    && count(cycle_time_history_refusals(builds: builds)) == 0
    && count(cycle_time_population_exclusions(builds: builds)) == 2
    && all(accepted_cycle_time_observations(builds: builds), observation =>
      millisecond_count(m: observation.cycle_time) > 0
        && string_contains(observation.source_url as String, "https://github.com/gunb-ai/gunbc/pull/")
    )
    && all(cycle_time_population_exclusions(builds: builds), exclusion => match exclusion {
      BundledPullDelivery { pull_number: _, nodes } => count(nodes) > 1
    })
}

test fn witness_live_calibration_keeps_small_sample_intervals() -> Bool {
  let observations = accepted_cycle_time_observations(builds: roadmap_cycle_time_observation_builds())
  let low_small = calibrate_cell(
    cell: gunbc.roadmap_forecast.SizingCell { intricacy: IntricacyLow, volume: VolumeSmall },
    observations: observations,
  )
  let medium_medium = calibrate_cell(
    cell: gunbc.roadmap_forecast.SizingCell { intricacy: IntricacyMedium, volume: VolumeMedium },
    observations: observations,
  )
  let high_medium = calibrate_cell(
    cell: gunbc.roadmap_forecast.SizingCell { intricacy: IntricacyHigh, volume: VolumeMedium },
    observations: observations,
  )
  match low_small {
    CalibrationRefusedNoSample { cell: _ } => false
    Calibrated { interval: l } =>
      l.sample_count == 1
        && millisecond_count(m: l.minimum) == 7721000
        && millisecond_count(m: l.median) == 7721000
        && millisecond_count(m: l.maximum) == 7721000
        && match medium_medium {
          CalibrationRefusedNoSample { cell: _ } => false
          Calibrated { interval: m } =>
            m.sample_count == 1
              && millisecond_count(m: m.minimum) == 2570000
              && millisecond_count(m: m.median) == 2570000
              && millisecond_count(m: m.maximum) == 2570000
              && match high_medium {
                CalibrationRefusedNoSample { cell: _ } => false
                Calibrated { interval: h } =>
                  h.sample_count == 2
                    && millisecond_count(m: h.minimum) == 4396000
                    && millisecond_count(m: h.median) == 21652000
                    && millisecond_count(m: h.maximum) == 38908000
              }
        }
  }
}

test fn witness_live_graph_refuses_with_located_counted_calibration_gaps() -> Bool {
  let result = live_roadmap_schedule_forecast(assumptions: assumptions(), anchor: anchor())
  let derived_gap_count = no_calibration_gap_count(result: result)
  derived_gap_count > 0
    && match result {
      ScheduleForecastKnown { forecast: _ } => false
      ScheduleForecastRefused { refusals } =>
        count(refusals) == 1
          && match first(refusals) {
            Absent => false
            Present { value: refusal } => match refusal {
              NoCalibrationSample { gaps, population_exclusions, assumptions: declared, scenario_adjustment: adjustment } =>
                count(gaps) == derived_gap_count
                  && count(population_exclusions) == 2
                  && millisecond_count(m: declared.operator_merge_latency.duration) == 5
                  && match adjustment {
                    AdjustmentUnavailable { causes } =>
                      count(causes) == 2
                        && any(causes, cause => match cause {
                          ReviewCycleDurationUnobserved { declared_count: _ } => true
                          OperatorMergeLatencyUnobserved { declared_latency: _ } => false
                        })
                        && any(causes, cause => match cause {
                          ReviewCycleDurationUnobserved { declared_count: _ } => false
                          OperatorMergeLatencyUnobserved { declared_latency } => millisecond_count(m: declared_latency) == 5
                        })
                  }
                  && all(gaps, gap => count(gap.nodes) > 0)
              DependencyCycle { nodes: _ } => false
              ForecastGraphEmpty => false
              DependencyEndpointUnknown { nodes: _ } => false
              NodeUnsized { nodes: _ } => false
              CycleTimeObservationNonPositive { nodes: _ } => false
              WorkerConcurrencyCapInvalid { declared_cap: _ } => false
              CalibrationHistoryRefused { refusals: _ } => false
              ForecastRoadmapAuthorityRefused { detail: _ } => false
              ForecastBuildRefused { node: _ } => false
            }
          }
    }
}

test fn witness_live_graph_gap_count_matches_refusal_rows() -> Bool {
  let result = live_roadmap_schedule_forecast(assumptions: assumptions(), anchor: anchor())
  let derived_gap_count = no_calibration_gap_count(result: result)
  derived_gap_count > 0
    && match result {
      ScheduleForecastKnown { forecast: _ } => false
      ScheduleForecastRefused { refusals } => any(refusals, refusal => match refusal {
        NoCalibrationSample { gaps, population_exclusions: _, assumptions: _, scenario_adjustment: _ } =>
          count(gaps) == derived_gap_count && all(gaps, gap => count(gap.nodes) > 0)
        ForecastGraphEmpty => false
        DependencyCycle { nodes: _ } => false
        DependencyEndpointUnknown { nodes: _ } => false
        NodeUnsized { nodes: _ } => false
        CycleTimeObservationNonPositive { nodes: _ } => false
        WorkerConcurrencyCapInvalid { declared_cap: _ } => false
        CalibrationHistoryRefused { refusals: _ } => false
        ForecastRoadmapAuthorityRefused { detail: _ } => false
        ForecastBuildRefused { node: _ } => false
      })
    }
}

test fn witness_live_graph_refusal_is_only_calibration() -> Bool {
  match live_roadmap_schedule_forecast(assumptions: assumptions(), anchor: anchor()) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } =>
      count(refusals) == 1 && any(refusals, refusal => match refusal {
        NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => true
        ForecastGraphEmpty => false
        DependencyCycle { nodes: _ } => false
        DependencyEndpointUnknown { nodes: _ } => false
        NodeUnsized { nodes: _ } => false
        CycleTimeObservationNonPositive { nodes: _ } => false
        WorkerConcurrencyCapInvalid { declared_cap: _ } => false
        CalibrationHistoryRefused { refusals: _ } => false
        ForecastRoadmapAuthorityRefused { detail: _ } => false
        ForecastBuildRefused { node: _ } => false
      })
  }
}

test fn witness_fully_calibrated_graph_derives_three_point_critical_path() -> Bool {
  let a = sized_node(id: "a", cell: fixture_cell())
  let b = sized_node(id: "b", cell: fixture_cell())
  let c = sized_node(id: "c", cell: fixture_cell())
  let result = schedule_forecast(
    nodes: [a, b, c],
    edges: [gunbc.roadmap_model.RoadmapEdge { child: b.node, parent: a.node }],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  )
  match result {
    ScheduleForecastRefused { refusals: _ } => false
    ScheduleForecastKnown { forecast } =>
      forecast.critical_path == [a.node, b.node]
        && count(forecast.nodes) == 3
        && forecast.completion_lower_bound.earliest.epoch_ms == 1020
        && forecast.completion_lower_bound.median.epoch_ms == 1040
        && forecast.completion_lower_bound.latest.epoch_ms == 1060
        && millisecond_count(m: forecast.lower_bounds.total_work.duration.median) == 60
        && millisecond_count(m: forecast.lower_bounds.critical_path_minimum.duration.median) == 40
        && millisecond_count(m: forecast.lower_bounds.capacity_constrained_minimum.duration.median) == 40
        && millisecond_count(m: forecast.lower_bounds.parallelism_headroom.ratio.median.num) == 60
        && millisecond_count(m: forecast.lower_bounds.parallelism_headroom.ratio.median.denom) == 40
        && count(forecast.calibration_population_exclusions) == 0
        && match forecast.scenario_adjustment {
          AdjustmentUnavailable { causes } => count(causes) == 2
        }
        && forecast.assumptions.worker_concurrency_cap.max_concurrent == 3
        && millisecond_count(m: forecast.assumptions.operator_merge_latency.duration) == 5
  }
}

test fn witness_worker_cap_changes_completion_lower_bound() -> Bool {
  let a = sized_node(id: "capacity-a", cell: fixture_cell())
  let b = sized_node(id: "capacity-b", cell: fixture_cell())
  let c = sized_node(id: "capacity-c", cell: fixture_cell())
  let one_worker = schedule_forecast(
    nodes: [a, b, c],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 1),
    anchor: anchor(),
  )
  let three_workers = schedule_forecast(
    nodes: [a, b, c],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 3),
    anchor: anchor(),
  )
  match one_worker {
    ScheduleForecastRefused { refusals: _ } => false
    ScheduleForecastKnown { forecast: serialized_bound } => match three_workers {
      ScheduleForecastRefused { refusals: _ } => false
      ScheduleForecastKnown { forecast: parallel_bound } =>
        serialized_bound.completion_lower_bound.median.epoch_ms == 1060
          && parallel_bound.completion_lower_bound.median.epoch_ms == 1020
          && millisecond_count(m: serialized_bound.lower_bounds.total_work.duration.median) == 60
          && millisecond_count(m: serialized_bound.lower_bounds.critical_path_minimum.duration.median) == 20
          && millisecond_count(m: serialized_bound.lower_bounds.capacity_constrained_minimum.duration.median) == 60
          && serialized_bound.completion_lower_bound.median.epoch_ms > parallel_bound.completion_lower_bound.median.epoch_ms
    }
  }
}

test fn witness_invalid_worker_cap_refuses() -> Bool {
  let n = sized_node(id: "invalid-cap", cell: fixture_cell())
  match schedule_forecast(
    nodes: [n],
    edges: [],
    observations: fixture_observations(),
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions_with_cap(max_concurrent: 0),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => count(refusals) == 1 && any(refusals, refusal => match refusal {
      WorkerConcurrencyCapInvalid { declared_cap } => declared_cap == 0
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      CycleTimeObservationNonPositive { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

test fn witness_zero_cycle_time_observation_refuses_before_headroom() -> Bool {
  let n = sized_node(id: "zero-cycle", cell: fixture_cell())
  match schedule_forecast(
    nodes: [n],
    edges: [],
    observations: [test.claim.roadmap_forecast_witness.observation(id: n.node, cell: fixture_cell(), duration_ms: 0)],
    history_refusals: [],
    population_exclusions: [],
    assumptions: assumptions(),
    anchor: anchor(),
  ) {
    ScheduleForecastKnown { forecast: _ } => false
    ScheduleForecastRefused { refusals } => count(refusals) == 1 && any(refusals, refusal => match refusal {
      CycleTimeObservationNonPositive { nodes } => nodes == [n.node]
      ForecastGraphEmpty => false
      DependencyCycle { nodes: _ } => false
      DependencyEndpointUnknown { nodes: _ } => false
      NodeUnsized { nodes: _ } => false
      NoCalibrationSample { gaps: _, population_exclusions: _, assumptions: _, scenario_adjustment: _ } => false
      WorkerConcurrencyCapInvalid { declared_cap: _ } => false
      CalibrationHistoryRefused { refusals: _ } => false
      ForecastRoadmapAuthorityRefused { detail: _ } => false
      ForecastBuildRefused { node: _ } => false
    })
  }
}

