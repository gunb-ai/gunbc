module test.claim.roadmap_authority


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn nodes() -> List<gunbc.roadmap_model.RoadmapNode> { declared_roadmap_nodes() }
fn edges() -> List<gunbc.roadmap_model.RoadmapEdge> { declared_roadmap_edges() }
fn active_nodes() -> List<gunbc.roadmap_model.RoadmapNode> {
  match live_accepted_node_ids() {
    Present { value: accepted } => active_roadmap_nodes_for_accepted(accepted: accepted)
    Absent => []
  }
}
fn active_edges() -> List<gunbc.roadmap_model.RoadmapEdge> {
  match live_accepted_node_ids() {
    Present { value: accepted } => active_roadmap_edges_for_accepted(accepted: accepted)
    Absent => []
  }
}

fn live_accepted_node_ids() -> List<gunbc.roadmap_model.RoadmapNodeId>? {
  match accepted_roadmap_node_ids_projection() {
    AcceptedRoadmapNodeIdsProjected { ids: ids } => Present { value: ids }
    AcceptedRoadmapNodeIdsProjectionRefused { detail: _ } => Absent
  }
}

fn tnid(s: String) -> gunbc.roadmap_model.RoadmapNodeId { s }
fn tchash(s: String) -> std.content_hash.Fnv1a64Structural { content_hash_atom(value: s as std.types.NonEmptyStr) }

fn digest_or_zero(rn: gunbc.roadmap_model.RoadmapNode) -> std.content_hash.Fnv1a64Structural {
  match node_criteria_digest(rn: rn) {
    Present { value } => value
    Absent => tchash(s: "0000000000000000")
  }
}

fn declared_node(id: String) -> List<gunbc.roadmap_model.RoadmapNode> {
  test.claim.roadmap_authority.nodes() |> filter(n => n.node == id)
}

fn receipt_fixture(node: String, digest: std.content_hash.Fnv1a64Structural) -> gunbc.roadmap_model.RoadmapAcceptanceReceipt {
  gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: tnid(s: node),
    criteria_digest: digest,
    red_control: gunbc.roadmap_status.RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: gunbc.roadmap_status.HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn evidenceless_receipt_fixture(rn: gunbc.roadmap_model.RoadmapNode) -> gunbc.roadmap_model.RoadmapAcceptanceReceipt {
  gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: RedControlNotRun,
    handback: gunbc.roadmap_status.HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn undelivered_receipt_fixture(rn: gunbc.roadmap_model.RoadmapNode) -> gunbc.roadmap_model.RoadmapAcceptanceReceipt {
  gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: rn.node,
    criteria_digest: digest_or_zero(rn: rn),
    red_control: gunbc.roadmap_status.RedControlExecuted {
      witness_module: "test.fixture",
      witness_fn: "fixture_red_control",
      executed_on: "2026-07-28",
    },
    handback: HandbackNotDelivered,
    accepted_by: "operator",
    accepted_on: "2026-07-28",
  }
}

fn id_exists(id: gunbc.roadmap_model.RoadmapNodeId) -> Bool {
  test.claim.roadmap_authority.nodes() |> any(n => n.node == id)
}

fn id_count(id: gunbc.roadmap_model.RoadmapNodeId) -> Int {
  test.claim.roadmap_authority.nodes() |> filter(n => n.node == id) |> count
}

fn active_id_exists(id: gunbc.roadmap_model.RoadmapNodeId) -> Bool {
  active_nodes() |> any(n => n.node == id)
}

fn edge_exists(child: String, parent: String) -> Bool {
  test.claim.roadmap_authority.edges() |> any(e => e.child == child && e.parent == parent)
}

fn node_has_carrier_path(path: String) -> Bool {
  test.claim.roadmap_authority.nodes() |> any(n => n.carriers |> any(p => p.path == path))
}

fn node_count_with_carrier_path(path: String) -> Int {
  test.claim.roadmap_authority.nodes() |> filter(n => n.carriers |> any(p => p.path == path)) |> count
}

fn mechanical_graph() -> std.graph.CallGraph {
  std.graph.CallGraph {
    edges: test.claim.roadmap_authority.edges() |> map(e => std.graph.GraphEdge {
      caller: e.parent as String,
      callee: e.child as String,
    }),
  }
}

fn node_names() -> List<String> {
  test.claim.roadmap_authority.nodes() |> map(n => n.node as String)
}

fn ticket_fields_complete(ticket: gunbc.roadmap_status.TicketFields) -> Bool {
  !(ticket.headline == "")
        && !(ticket.brief == "")
        && !(ticket.displaced_cost == "")
        && !(ticket.current_state == "")
        && !(ticket.first_slice == "")
        && !(ticket.red_control == "")
        && !(ticket.out_of_scope == "")
        && !(ticket.handback == "")
}

fn active_node_admissible(n: gunbc.roadmap_model.RoadmapNode) -> Bool {
  !item_is_done(item: n.line, merged: [])
    && !signoff_is_present(s: n.signoff)
    && match line_ticket(item: n.line) {
      Present { value } => ticket_fields_complete(ticket: value)
      Absent => false
    }
    && count(n.carriers) > 0
    && !(n.owner == "")
    && match n.sizing {
      Sized { intricacy: _, volume: _, repo, acceptance } =>
        repo == "gunbc" && acceptance == ManualAcceptance
      Unsized => false
  }
}

fn red_fixture(line: gunbc.roadmap_status.RoadmapItem, signoff: gunbc.roadmap_status.Signoff) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: "rnfx_8E5PG4F7CAZ148VZ8MNY" as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: "red-fixture",
    line: line,
    carriers: [gunbc.roadmap_model.Pointer { label: "authority", path: "DESIGN.md" }],
    sizing: gunbc.roadmap_model.Sized {
      intricacy: IntricacyMedium,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    execution: ExecutionContractUnspecified,
    owner: "roadmap-authority",
    signoff: signoff,
  }
}

fn red_ticket(done: Bool) -> gunbc.roadmap_status.RoadmapItem {
  gunbc.roadmap_status.TicketLine {
    done: done,
    ticket: gunbc.roadmap_status.TicketFields {
      headline: "planted completed-row RED",
      brief: "Every required field is populated so only the forbidden completion or acceptance state can reject this fixture.",
      displaced_cost: "none",
      current_state: "fixture",
      first_slice: "fixture",
      red_control: "fixture",
      out_of_scope: "fixture",
      handback: "fixture",
      updates: [],
      authored_on: "",
      last_verified_on: "",
    },
  }
}

test fn witness_declared_graph_has_justified_size() -> Bool {
  count(test.claim.roadmap_authority.nodes()) > 0 && count(test.claim.roadmap_authority.edges()) > 0
    && count(active_nodes()) > 0 && count(active_edges()) > 0
}

test fn witness_declared_node_ids_are_unique() -> Bool {
  all(test.claim.roadmap_authority.nodes(), n => id_count(id: n.node) == 1)
}

test fn witness_every_edge_endpoint_exists() -> Bool {
  all(test.claim.roadmap_authority.edges(), e => id_exists(id: e.child) && id_exists(id: e.parent))
}

test fn witness_declared_graph_is_mechanically_acyclic() -> Bool {
  all(test.claim.roadmap_authority.edges(), e => !(e.parent == e.child))
    && !graph_has_multi_node_scc(names: node_names(), graph: mechanical_graph())
}

test fn witness_every_declared_row_is_complete_unsigned_ticket() -> Bool {
  all(test.claim.roadmap_authority.nodes(), n => active_node_admissible(n: n))
}

data live_state_count_transcription_note: String = "NO LIVE-STATE COUNT PINS IN THIS FILE, deliberately, and the deleted ones are named so the class does not creep back. Removed: `count(accepted) == 8` here, and `\"63 declared · 8 accepted · 55 active\"` in test.claim.long.roadmap_page_witness. Both TRANSCRIBED a number nobody decided — they mirrored whatever the live authority happened to hold, so authoring any correct roadmap row redded them (observed twice; the second was PR #7463, whose only content was two new rows). A pin like that reports 'the roadmap changed', which is not a defect, while the reviewer's habit becomes editing the number to match — a check satisfied by editing the declaration, which DESIGN §5 names as the tell that validation stood where construction was available. THE DISTINCTION THAT DECIDES WHETHER A COUNT MAY STAY: does the number come from a fixture the test CONSTRUCTS, or from live corpus state? test.claim.roadmap_altitude_witness renders `doc_html(nodes: [done_signed_node(), open_node()])` and asserts `1 open · 1 done` — that is the renderer computing from two known inputs, so it is a specification and it stays; deleting it would remove real coverage. Same for the observation render witnesses over replayed fixture blocks, and for structural counts that encode a design fact rather than a population (two workflow lamps, three static routes). WHAT SURVIVED THE DELETION HERE, and why nothing was lost: this witness's actual invariant is the RELATIONSHIP `count(active_nodes()) == count(nodes()) - count(accepted)`, which is magnitude-independent and still asserted; the eight per-id acceptance assertions also stay, because they pin WHICH acceptances exist and a dropped one is real history loss (scm_prerequisite_acceptance_note). Only the magnitude went. Replacing it with `string_contains(page, roadmap_counts_label())` was considered and rejected as the vacuous form — both sides derive from the same function, so it asserts the page contains what the page computed (operator ruling 2026-07-30: no vacuous or tautological testing)."

test fn witness_active_set_is_declared_minus_accepted() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      (accepted |> any(a => a == "namespace-occurrence-transport"))
        && (accepted |> any(a => a == "pderive-typesafe-nullary-reflection"))
        && (accepted |> any(a => a == "pderive-static-supplemental-contract"))
        && (accepted |> any(a => a == "v1-test-hygiene-producer-retirement"))
        && (accepted |> any(a => a == "2-scm-git-upstream-model"))
        && (accepted |> any(a => a == "2-scm-mercurial-upstream-model"))
        && (accepted |> any(a => a == "2-scm-pijul-upstream-model"))
        && (accepted |> any(a => a == "2-claim-indexed-evidence"))
        && (accepted |> any(a => a == "2-scm-compatibility-shape"))
        && (accepted |> any(a => a == "2-scm-p0-landing-spine"))
        && count(active_nodes()) == count(test.claim.roadmap_authority.nodes()) - count(accepted)
        && all(active_nodes(), n => !(accepted |> any(a => a == n.node)))
        && all(accepted, a => id_exists(id: a))
  }
}

test fn witness_acceptance_receipts_are_valid_and_unique() -> Bool {
  match roadmap_acceptance_receipts() {
    RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
    RoadmapAcceptanceReceiptsProjected { receipts: receipts } =>
      count(receipts) > 0
        && all(receipts, r => count(receipts |> filter(x => x.node == r.node)) == 1)
        && all(receipts, r => id_exists(id: r.node))
        && all(receipts, r => all(declared_node(id: r.node as String), n => receipt_matches_node(r: r, rn: n)))
  }
}

test fn witness_accepted_parents_precede_dependents() -> Bool {
  match live_accepted_node_ids() {
    Absent => false
    Present { value: accepted } =>
      all(accepted, a => all(roadmap_parent_ids(edges: test.claim.roadmap_authority.edges(), node: a), p => accepted |> any(x => x == p)))
  }
}

test fn witness_stale_criteria_digest_refuses_acceptance() -> Bool {
  let victims = declared_node(id: "namespace-occurrence-transport")
  count(victims) == 1
    && all(victims, n => !node_accepted(
      receipts: [receipt_fixture(node: "namespace-occurrence-transport", digest: tchash(s: "0000000000000000"))],
      rn: n,
    ))
}

test fn witness_duplicate_receipts_refuse_acceptance() -> Bool {
  match roadmap_acceptance_receipts() {
    RoadmapAcceptanceReceiptsProjectionRefused { detail: _ } => false
    RoadmapAcceptanceReceiptsProjected { receipts: all_receipts } => {
      let rs = all_receipts |> filter(r => r.node == "namespace-occurrence-transport")
      let victims = declared_node(id: "namespace-occurrence-transport")
      count(rs) == 1
        && count(victims) == 1
        && all(victims, n => node_accepted(receipts: rs, rn: n))
        && all(victims, n => !node_accepted(receipts: concat(rs, rs), rn: n))
    }
  }
}

test fn witness_unexecuted_or_undelivered_evidence_refuses_acceptance() -> Bool {
  let victims = declared_node(id: "namespace-occurrence-transport")
  count(victims) == 1
    && all(victims, n => !node_accepted(receipts: [evidenceless_receipt_fixture(rn: n)], rn: n))
    && all(victims, n => !node_accepted(receipts: [undelivered_receipt_fixture(rn: n)], rn: n))
}

test fn witness_receipt_for_unknown_node_accepts_nothing() -> Bool {
  let ghost = receipt_fixture(node: "no-such-roadmap-node", digest: tchash(s: "0000000000000000"))
  all(test.claim.roadmap_authority.nodes(), n => !node_accepted(receipts: [ghost], rn: n))
}

data acceptance_receipt_continuity_witness_note: String = "THE WALL AGAINST SILENT RECEIPT DELETION (acceptance_receipt_continuity_wall_note). roadmap_acceptance_event_history loads from dag/gunbc/roadmap_acceptance_event_history.jsonl; roadmap_acceptance_receipts projects live receipts only. Live git-observed integrity executes in test.claim.roadmap_receipt_continuity_live_witness (ReadsLiveTree, bin_witness_wet_entries). RED controls in test.claim.roadmap_receipt_continuity_acceptance plant deleted events, prefix law, empty-prior bypass discriminant, digest-field mutation, wrong prior digest, revocation while live, duplicate revocations, exact revocation admit, criteria rewrite, git-refusal observation, and typed projection refusal chain."

fn live_acceptance_event_history() -> List<gunbc.roadmap_model.RoadmapAcceptanceEvent> {
  match roadmap_acceptance_event_history_load() {
    RoadmapAcceptanceEventHistoryLoaded { events: events } => events
    RoadmapAcceptanceEventHistoryLoadRefused { detail: _ } => []
  }
}

test fn witness_vanished_receipt_without_revocation_refuses() -> Bool {
  let prior = live_acceptance_event_history()
  let current = prior
    |> filter(e =>
      match e {
        AcceptanceRecorded { receipt: r } => r.node != tnid(s: "namespace-occurrence-transport")
        AcceptanceRevoked { exact_prior_receipt: _, disposition: _, reason: _, revoked_by: _, revoked_on: _ } => true
      }
    )
  !acceptance_history_extends_prior(prior: prior, current: current)
}

test fn witness_explicit_revocation_authorizes_vanished_receipt() -> Bool {
  let prior = live_acceptance_event_history()
  let receipt = first(
    project_live_acceptance_receipts(history: prior)
      |> filter(r => r.node == tnid(s: "namespace-occurrence-transport")),
  )
  let current = concat(prior, [
    gunbc.roadmap_model.AcceptanceRevoked {
      exact_prior_receipt: receipt,
      disposition: gunbc.roadmap_model.AcceptanceNodeReopensActiveFrontier {},
      reason: "fixture revocation witness" as std.types.NonEmptyStr,
      revoked_by: "operator" as std.types.NonEmptyStr,
      revoked_on: "2026-08-04" as std.types.NonEmptyStr,
    },
  ])
  acceptance_history_extends_prior(prior: prior, current: current)
    && acceptance_history_integrity_holds(
      history: current,
      prior_history: prior,
    )
}

test fn witness_accepted_parent_discharges_active_dependency() -> Bool {
  let act = active_edges()
  !(act |> any(e => e.child == "namespace-binding-kernel" && e.parent == "namespace-occurrence-transport"))
    && !(act |> any(e => e.child == "pderive-static-supplemental-contract" && e.parent == "pderive-typesafe-nullary-reflection"))
    && !(act |> any(e => e.child == "2-scm-p0-landing-spine"))
    && is_top_level(edges: act, node: "namespace-binding-kernel")
    && !is_top_level(edges: act, node: "namespace-canonical-binding")
    && is_top_level(edges: act, node: "pderive-static-supplemental-contract")
    && is_top_level(edges: act, node: "2-scm-p0-landing-spine")
    && edge_exists(child: "namespace-binding-kernel", parent: "namespace-occurrence-transport")
    && edge_exists(child: "pderive-static-supplemental-contract", parent: "pderive-typesafe-nullary-reflection")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-git-upstream-model")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-mercurial-upstream-model")
    && edge_exists(child: "2-scm-compatibility-shape", parent: "2-scm-pijul-upstream-model")
    && !edge_exists(child: "2-scm-compatibility-shape", parent: "2-claim-indexed-evidence")
    && edge_exists(child: "2-scm-p0-landing-spine", parent: "2-scm-compatibility-shape")
    && edge_exists(child: "2-scm-p0-landing-spine", parent: "2-claim-indexed-evidence")
}

fn exit_line_bound_to(l: gunbc.v1_deletion_plan.V1FinishLine, node: String) -> Bool {
  let matches = v1_exit_finish_lines()
    |> filter(s => v1_finish_line_key(l: s.line) == v1_finish_line_key(l: l))
  count(matches) == 1 && all(matches, s => s.node == node && id_exists(id: s.node))
}

test fn witness_exit_model_finish_lines_bind_declared_terminals() -> Bool {
  let specs = v1_exit_finish_lines()
  count(specs) == 4
    && all(specs, s => id_exists(id: s.node))
    && exit_line_bound_to(l: CompilerFixedPoint, node: "v1-emitter-fixed-point")
    && exit_line_bound_to(l: InterpreterDeleted, node: "v1-interpreter-delete")
    && exit_line_bound_to(l: ProductsV1Free, node: "v1-products-v1-free")
    && exit_line_bound_to(l: ZeroHandMaintainedRust, node: "v1-zero-hand-maintained-rust")
    && match live_accepted_node_ids() {
      Absent => false
      Present { value: accepted } => v1_finish_lines_accepted_count(accepted: accepted) == 0
    }
}

test fn witness_completed_ticket_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(line: red_ticket(done: true), signoff: gunbc.roadmap_status.Unsigned))
}

test fn witness_accepted_ticket_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(
    line: red_ticket(done: false),
    signoff: gunbc.roadmap_status.SignedOff {
      by: "operator",
      works: gunbc.roadmap_status.RedControlExecuted { witness_module: "test.fixture", witness_fn: "fixture_red_control", executed_on: "2026-07-28" },
      scope_equivalent: gunbc.roadmap_status.HandbackDelivered { first_artifact: "fixture-handback", further_artifacts: [] },
      as_expected: true,
    },
  ))
}

test fn witness_superseded_row_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(
    line: gunbc.roadmap_status.SupersededLine { by: "replacement", content: "retired history" },
    signoff: gunbc.roadmap_status.Unsigned,
  ))
}

test fn witness_active_sizes_are_intentional_and_nonuniform() -> Bool {
  all(test.claim.roadmap_authority.nodes(), n => match n.sizing {
    Sized { intricacy: _, volume: _, repo: _, acceptance: ManualAcceptance } => true
    _ => false
  })
    && any(test.claim.roadmap_authority.nodes(), n => match n.sizing {
      Sized { intricacy: IntricacyLow, volume: VolumeSmall, repo: _, acceptance: _ } => true
      _ => false
    })
    && any(test.claim.roadmap_authority.nodes(), n => match n.sizing {
      Sized { intricacy: IntricacyHigh, volume: VolumeLarge, repo: _, acceptance: _ } => true
      _ => false
    })
}

test fn witness_authority_contains_no_mutable_execution_ledger() -> Bool {
  all(test.claim.roadmap_authority.nodes(), n => match n.line {
    TicketLine { done: _, ticket } =>
      count(ticket.updates) == 0
        && ticket.authored_on == ""
        && ticket.last_verified_on == ""
        && !string_contains(s: ticket.current_state, pattern: "PR #")
        && !string_contains(s: ticket.current_state, pattern: "session/")
        && !string_contains(s: ticket.current_state, pattern: "CI run")
    _ => false
  }) && count(authored_merged_prs()) == 0
}

test fn witness_namespace_chain_is_explicit() -> Bool {
  edge_exists(child: "namespace-binding-kernel", parent: "namespace-occurrence-transport")
    && edge_exists(child: "namespace-reference-derived-closure", parent: "namespace-binding-kernel")
    && edge_exists(child: "namespace-ambiguity-discharge", parent: "namespace-reference-derived-closure")
    && edge_exists(child: "namespace-canonical-binding", parent: "namespace-ambiguity-discharge")
    && !edge_exists(child: "namespace-canonical-binding", parent: "namespace-occurrence-transport")
    && edge_exists(child: "namespace-bound-only-consumers", parent: "namespace-canonical-binding")
    && edge_exists(child: "namespace-v2-import-completion", parent: "namespace-bound-only-consumers")
    && edge_exists(child: "namespace-legacy-choice-retirement", parent: "namespace-v2-import-completion")
}

test fn witness_pderive_chain_and_namespace_prerequisite_are_explicit() -> Bool {
    edge_exists(child: "pderive-static-supplemental-contract", parent: "pderive-typesafe-nullary-reflection")
    && edge_exists(child: "pderive-source-slot-binding", parent: "pderive-static-supplemental-contract")
    && edge_exists(child: "pderive-source-slot-binding", parent: "namespace-canonical-binding")
    && edge_exists(child: "pderive-v2-emitter-consumer", parent: "pderive-source-slot-binding")
    && edge_exists(child: "pderive-v2-emitter-consumer", parent: "v2-emitter-direct-rust-door")
    && edge_exists(child: "pderive-error-movement-receipt", parent: "pderive-v2-emitter-consumer")
}

test fn witness_pderive_vertical_slice_gates_bootstrap_widening() -> Bool {
    edge_exists(child: "v2-emitter-native-bootstrap", parent: "pderive-error-movement-receipt")
}

test fn witness_new_generator_precedes_fixed_point_and_old_generator_deletion() -> Bool {
    edge_exists(child: "v2-emitter-direct-rust-door", parent: "v2-emitter-producer-provenance")
    && edge_exists(child: "v2-emitter-first-behavioral-module", parent: "v2-emitter-direct-rust-door")
    && edge_exists(child: "v2-emitter-native-bootstrap", parent: "v2-emitter-first-behavioral-module")
    && edge_exists(child: "v1-emitter-fixed-point", parent: "v2-emitter-native-bootstrap")
    && edge_exists(child: "v1-emitter-quarantine", parent: "v1-ci-floor-cutover")
    && edge_exists(child: "v1-emitter-delete", parent: "v1-emitter-quarantine")
    && edge_exists(child: "v1-interpreter-delete", parent: "v1-emitter-delete")
}

data native_cutover_edge_direction_note: String = "THE NATIVE EDGE POINTS THE OTHER WAY NOW, and this witness is what forced the change to be deliberate (2026-08-07). It previously required native-selected-witness-bundle to depend on the five-minute gate AND on warm-merge-admission. Both are now asserted ABSENT and the reverse edge is required instead, because the gate is an AGGREGATE OUTCOME: making the native cutover wait for it means the one step that removes the interpreter from the required path cannot start until the programme it contributes to has already succeeded. The warm-merge edge went with it because no input dependency was ever shown — the bundle needs a selected population, an emitter and a toolchain, none of which merge admission supplies.\n\nWHY THIS IS A REORDERING AND NOT A LOOSENING. The node is stale in a specific way: its first slice read 'merge #7599', #7599 is merged, and the cited production enrolment still ran none of its three selected members natively and fell back on all three. So the mechanism exists and the required path takes no benefit, which makes the cutover the first thing that should be startable rather than the last. With no parent, it is. The negatives are asserted rather than merely dropped so the old direction cannot return silently — a re-added dependency on the aggregate would red here, which is the property that was doing the work before and still is.\n\nSUPERSEDED IN PART BY THE CI2-0 STOP (operator ruling 2026-08-10). The reverse edge this note required — the gate depending on the native bundle — is now DELETED, not reversed again: gunbc.roadmap_authority five_minute_ci_gate_program_note records the measurement that decided it, a 3,290s floor carrying 97s of witness evaluation, so an infinitely fast evaluator leaves about 97 percent of the floor standing and native execution cannot be this gate's prerequisite. #8116 implemented the deletion in the authority and left this witness asserting the edge it removed, so the witness read main as broken while main was following the ruling. The clause is now a NEGATIVE on both directions: neither node depends on the other, and either edge returning would red here. What survives from this note unchanged is its reason for asserting absence rather than dropping the clause — a silent re-parenting is exactly what the negative exists to catch."

