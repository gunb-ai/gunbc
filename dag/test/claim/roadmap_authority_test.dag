module test.claim.roadmap_authority

import gunbc.roadmap_authority {
  active_roadmap_nodes,
  active_roadmap_edges,
  roadmap_authority,
  authored_merged_prs,
  observation_scoped_run_seed_growth_justification,
}
import gunbc.roadmap_document { project_roadmap_to_markdown }
import gunbc.roadmap_model {
  RoadmapNode,
  RoadmapEdge,
  RoadmapNodeId,
  Pointer,
  IntricacyLow,
  IntricacyMedium,
  IntricacyHigh,
  VolumeSmall,
  VolumeMedium,
  VolumeLarge,
  Sized,
  Unsized,
  ManualAcceptance,
}
import gunbc.roadmap_status {
  RoadmapItem,
  Signoff,
  TicketLine,
  TicketFields,
  SupersededLine,
  AuthoredLine,
  PlainLine,
  DerivableLine,
  Unsigned,
  SignedOff,
  line_ticket,
  item_is_done,
  signoff_is_present,
}
import extdeps.languages.markdown { serialize_markdown_source }
import std.graph { GraphEdge, CallGraph, graph_has_multi_node_scc }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nodes() -> List<RoadmapNode> { active_roadmap_nodes() }
fn edges() -> List<RoadmapEdge> { active_roadmap_edges() }

fn id_exists(id: RoadmapNodeId) -> Bool {
  nodes() |> any(n => n.node == id)
}

fn id_count(id: RoadmapNodeId) -> Int {
  nodes() |> filter(n => n.node == id) |> count
}

fn edge_exists(child: String, parent: String) -> Bool {
  edges() |> any(e => e.child == child && e.parent == parent)
}

fn node_has_carrier_path(path: String) -> Bool {
  nodes() |> any(n => n.carriers |> any(p => p.path == path))
}

fn mechanical_graph() -> CallGraph {
  CallGraph {
    edges: edges() |> map(e => GraphEdge {
      caller: e.parent as String,
      callee: e.child as String,
    }),
  }
}

fn node_names() -> List<String> {
  nodes() |> map(n => n.node as String)
}

fn ticket_fields_complete(ticket: TicketFields) -> Bool {
  !(ticket.headline == "")
        && !(ticket.brief == "")
        && !(ticket.displaced_cost == "")
        && !(ticket.current_state == "")
        && !(ticket.first_slice == "")
        && !(ticket.red_control == "")
        && !(ticket.out_of_scope == "")
        && !(ticket.handback == "")
}

fn active_node_admissible(n: RoadmapNode) -> Bool {
  !item_is_done(item: n.line, merged: [])
    && !signoff_is_present(s: n.signoff)
    && match line_ticket(item: n.line) {
      Present { value } => ticket_fields_complete(ticket: value)
      Absent => false
    }
    && count(n.carriers) > 0
    && !(n.owner == "")
    && match n.sizing {
      Sized { intricacy: _, volume: _, repo, acceptance } =>
        repo == "gunbc" && acceptance == ManualAcceptance
      Unsized => false
  }
}

fn red_fixture(line: RoadmapItem, signoff: Signoff) -> RoadmapNode {
  RoadmapNode {
    node: "red-fixture",
    line: line,
    carriers: [Pointer { label: "authority", path: "DESIGN.md" }],
    sizing: Sized {
      intricacy: IntricacyMedium,
      volume: VolumeMedium,
      repo: "gunbc",
      acceptance: ManualAcceptance,
    },
    owner: "roadmap-authority",
    signoff: signoff,
  }
}

fn red_ticket(done: Bool) -> RoadmapItem {
  TicketLine {
    done: done,
    ticket: TicketFields {
      headline: "planted completed-row RED",
      brief: "Every required field is populated so only the forbidden completion or acceptance state can reject this fixture.",
      displaced_cost: "none",
      current_state: "fixture",
      first_slice: "fixture",
      red_control: "fixture",
      out_of_scope: "fixture",
      handback: "fixture",
      updates: [],
      authored_on: "",
      last_verified_on: "",
    },
  }
}

test fn witness_active_graph_has_justified_size() -> Bool {
  count(nodes()) > 0 && count(edges()) > 0
}

test fn witness_active_node_ids_are_unique() -> Bool {
  all(nodes(), n => id_count(id: n.node) == 1)
}

test fn witness_every_edge_endpoint_exists() -> Bool {
  all(edges(), e => id_exists(id: e.child) && id_exists(id: e.parent))
}

test fn witness_active_graph_is_mechanically_acyclic() -> Bool {
  all(edges(), e => !(e.parent == e.child))
    && !graph_has_multi_node_scc(names: node_names(), graph: mechanical_graph())
}

test fn witness_every_active_row_is_complete_unsigned_ticket() -> Bool {
  all(nodes(), n => active_node_admissible(n: n))
}

test fn witness_completed_ticket_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(line: red_ticket(done: true), signoff: Unsigned))
}

test fn witness_accepted_ticket_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(
    line: red_ticket(done: false),
    signoff: SignedOff {
      by: "operator",
      works: true,
      scope_equivalent: true,
      as_expected: true,
    },
  ))
}

test fn witness_superseded_row_cannot_reenter_active_graph() -> Bool {
  !active_node_admissible(n: red_fixture(
    line: SupersededLine { by: "replacement", content: "retired history" },
    signoff: Unsigned,
  ))
}

test fn witness_active_sizes_are_intentional_and_nonuniform() -> Bool {
  all(nodes(), n => match n.sizing {
    Sized { intricacy: _, volume: _, repo: _, acceptance: ManualAcceptance } => true
    _ => false
  })
    && any(nodes(), n => match n.sizing {
      Sized { intricacy: IntricacyLow, volume: VolumeSmall, repo: _, acceptance: _ } => true
      _ => false
    })
    && any(nodes(), n => match n.sizing {
      Sized { intricacy: IntricacyHigh, volume: VolumeLarge, repo: _, acceptance: _ } => true
      _ => false
    })
}

test fn witness_authority_contains_no_mutable_execution_ledger() -> Bool {
  all(nodes(), n => match n.line {
    TicketLine { done: _, ticket } =>
      count(ticket.updates) == 0
        && ticket.authored_on == ""
        && ticket.last_verified_on == ""
        && !string_contains(s: ticket.current_state, pattern: "PR #")
        && !string_contains(s: ticket.current_state, pattern: "session/")
        && !string_contains(s: ticket.current_state, pattern: "CI run")
    _ => false
  }) && count(authored_merged_prs()) == 0
}

test fn witness_namespace_chain_is_explicit() -> Bool {
  edge_exists(child: "namespace-canonical-binding", parent: "namespace-occurrence-transport")
    && edge_exists(child: "namespace-bound-only-consumers", parent: "namespace-canonical-binding")
    && edge_exists(child: "namespace-v2-import-completion", parent: "namespace-bound-only-consumers")
    && edge_exists(child: "namespace-legacy-choice-retirement", parent: "namespace-v2-import-completion")
}

test fn witness_pderive_chain_and_namespace_prerequisite_are_explicit() -> Bool {
    edge_exists(child: "pderive-static-supplemental-contract", parent: "pderive-typesafe-nullary-reflection")
    && edge_exists(child: "pderive-source-slot-binding", parent: "pderive-static-supplemental-contract")
    && edge_exists(child: "pderive-source-slot-binding", parent: "namespace-canonical-binding")
    && edge_exists(child: "pderive-single-emitter", parent: "pderive-source-slot-binding")
    && edge_exists(child: "pderive-error-movement-receipt", parent: "pderive-single-emitter")
}

test fn witness_observation_and_placement_chains_are_explicit() -> Bool {
  edge_exists(
    child: "observation-scoped-run-consumer",
    parent: "observation-scoped-run-seed-growth-justification",
  )
    && edge_exists(child: "observation-ci-event-grouping", parent: "observation-scoped-run-consumer")
    && edge_exists(child: "observation-collapse-watchdog-restatement", parent: "observation-ci-event-grouping")
    && edge_exists(child: "observation-raw-print-retirement", parent: "observation-collapse-watchdog-restatement")
    && edge_exists(child: "placement-live-roster-preflight", parent: "observation-scoped-run-consumer")
    && edge_exists(child: "placement-two-host-warm-qualification", parent: "placement-live-roster-preflight")
    && edge_exists(child: "placement-shadow-equality", parent: "placement-two-host-warm-qualification")
    && edge_exists(child: "placement-atomic-authority-flip", parent: "placement-shadow-equality")
