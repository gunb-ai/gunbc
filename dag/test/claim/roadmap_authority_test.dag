module test.claim.roadmap_authority

import gunbc.roadmap_authority {
  active_roadmap_nodes,
  active_roadmap_edges,
  roadmap_authority,
  authored_merged_prs,
}
import gunbc.roadmap_document { project_roadmap_to_markdown }
import gunbc.roadmap_model {
  RoadmapNode,
  RoadmapEdge,
  RoadmapNodeId,
  Sized,
  Unsized,
}
import gunbc.roadmap_status {
  TicketLine,
  SupersededLine,
  AuthoredLine,
  PlainLine,
  DerivableLine,
  Unsigned,
}
import extdeps.languages.markdown { serialize_markdown_source }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn nodes() -> List<RoadmapNode> { active_roadmap_nodes() }
fn edges() -> List<RoadmapEdge> { active_roadmap_edges() }

fn id_exists(id: RoadmapNodeId) -> Bool {
  nodes() |> any(n => n.node == id)
}

fn id_count(id: RoadmapNodeId) -> Int {
  nodes() |> filter(n => n.node == id) |> count
}

fn edge_exists(child: String, parent: String) -> Bool {
  edges() |> any(e => e.child == child && e.parent == parent)
}

fn rank(id: RoadmapNodeId) -> Int {
  match id {
    "namespace-occurrence-transport" => 0
    "namespace-canonical-binding" => 1
    "namespace-bound-only-consumers" => 2
    "namespace-legacy-choice-retirement" => 3
    "pderive-typesafe-nullary-reflection" => 0
    "pderive-static-supplemental-contract" => 1
    "pderive-source-slot-binding" => 2
    "pderive-single-emitter" => 3
    "pderive-error-movement-receipt" => 4
    "observation-scoped-run-consumer" => 0
    "observation-ci-event-grouping" => 1
    "observation-collapse-watchdog-restatement" => 2
    "observation-raw-print-retirement" => 3
    "placement-live-roster-preflight" => 0
    "placement-two-host-warm-qualification" => 1
    "placement-shadow-equality" => 2
    "placement-atomic-authority-flip" => 3
    "v1-test-hygiene-producer-retirement" => 0
    "v1-interpreter-role-frontier" => 1
    "v1-materialization-kernel" => 2
    "v1-interpreter-quarantine" => 3
    "v1-interpreter-delete" => 5
    "shell-typed-invocation" => 0
    "shell-effectplan-to-bash" => 1
    "shell-gate-migration" => 2
    "shell-residue-zero" => 3
    "roadmap-runtime-identity-join" => 0
    "roadmap-runtime-ready-override" => 1
    "roadmap-runtime-dispatch-consumer" => 2
    "roadmap-runtime-readback" => 3
    "fleet-state-frontier" => 0
    "fleet-bmc-policy-convergence" => 1
    "fleet-closed-loop-converge" => 3
    "fleet-anti-entropy-hygiene" => 4
    "fleet-receipt-qualified-control" => 5
    "product-scm-git-upstream" => 0
    "product-scm-mercurial-upstream" => 0
    "product-scm-pijul-upstream" => 0
    "product-scm-common-shape" => 2
    "product-source-intent-kernel" => 3
    "product-agent-landing-benchmark" => 4
    _ => -1
  }
}

fn active_ticket_complete(n: RoadmapNode) -> Bool {
  match n.line {
    TicketLine { done, ticket } =>
      !done
        && !(ticket.headline == "")
        && !(ticket.brief == "")
        && !(ticket.displaced_cost == "")
        && !(ticket.current_state == "")
        && !(ticket.first_slice == "")
        && !(ticket.red_control == "")
        && !(ticket.out_of_scope == "")
        && !(ticket.handback == "")
        && count(n.carriers) > 0
        && !(n.owner == "")
        && match n.signoff {
          Unsigned => true
          _ => false
        }
    SupersededLine { by: _, content: _ } => false
    AuthoredLine { done: _, content: _ } => false
    PlainLine { content: _ } => false
    DerivableLine { prs: _, title: _, description: _ } => false
  }
}

test fn witness_active_graph_has_justified_size() -> Bool {
  count(nodes()) == 41 && count(edges()) == 37
}

test fn witness_active_node_ids_are_unique() -> Bool {
  all(nodes(), n => id_count(id: n.node) == 1)
}

test fn witness_every_edge_endpoint_exists() -> Bool {
  all(edges(), e => id_exists(id: e.child) && id_exists(id: e.parent))
}

test fn witness_active_graph_is_acyclic_by_topological_rank() -> Bool {
  all(nodes(), n => rank(id: n.node) >= 0)
    && all(edges(), e => rank(id: e.parent) < rank(id: e.child))
}

test fn witness_every_active_row_is_complete_unsigned_ticket() -> Bool {
  all(nodes(), n => active_ticket_complete(n: n))
}

test fn witness_only_product_rows_are_queued_nonspawnable() -> Bool {
  all(nodes(), n =>
    if string_starts_with(s: n.node, prefix: "product-") {
      match n.sizing { Unsized => true _ => false }
    } else {
      match n.sizing { Sized { intricacy: _, volume: _, repo: _, acceptance: _ } => true _ => false }
    }
  )
}

test fn witness_authority_contains_no_mutable_execution_ledger() -> Bool {
  all(nodes(), n => match n.line {
    TicketLine { done: _, ticket } =>
      count(ticket.updates) == 0
        && ticket.authored_on == ""
        && ticket.last_verified_on == ""
        && !string_contains(s: ticket.current_state, pattern: "PR #")
        && !string_contains(s: ticket.current_state, pattern: "session/")
        && !string_contains(s: ticket.current_state, pattern: "CI run")
    _ => false
  }) && count(authored_merged_prs()) == 0
}

test fn witness_namespace_chain_is_explicit() -> Bool {
  edge_exists(child: "namespace-canonical-binding", parent: "namespace-occurrence-transport")
    && edge_exists(child: "namespace-bound-only-consumers", parent: "namespace-canonical-binding")
    && edge_exists(child: "namespace-legacy-choice-retirement", parent: "namespace-bound-only-consumers")
}

test fn witness_pderive_chain_and_namespace_prerequisite_are_explicit() -> Bool {
  edge_exists(child: "pderive-static-supplemental-contract", parent: "pderive-typesafe-nullary-reflection")
    && edge_exists(child: "pderive-source-slot-binding", parent: "pderive-static-supplemental-contract")
    && edge_exists(child: "pderive-source-slot-binding", parent: "namespace-occurrence-transport")
    && edge_exists(child: "pderive-single-emitter", parent: "pderive-source-slot-binding")
    && edge_exists(child: "pderive-error-movement-receipt", parent: "pderive-single-emitter")
}

test fn witness_observation_and_placement_chains_are_explicit() -> Bool {
  edge_exists(child: "observation-ci-event-grouping", parent: "observation-scoped-run-consumer")
    && edge_exists(child: "observation-collapse-watchdog-restatement", parent: "observation-ci-event-grouping")
    && edge_exists(child: "observation-raw-print-retirement", parent: "observation-collapse-watchdog-restatement")
    && edge_exists(child: "placement-two-host-warm-qualification", parent: "placement-live-roster-preflight")
    && edge_exists(child: "placement-shadow-equality", parent: "placement-two-host-warm-qualification")
    && edge_exists(child: "placement-atomic-authority-flip", parent: "placement-shadow-equality")
}

test fn witness_interpreter_delete_fan_in_is_explicit() -> Bool {
  edge_exists(child: "v1-interpreter-delete", parent: "v1-interpreter-quarantine")
    && edge_exists(child: "v1-interpreter-delete", parent: "namespace-legacy-choice-retirement")
    && edge_exists(child: "v1-interpreter-delete", parent: "pderive-error-movement-receipt")
}

test fn witness_shell_roadmap_and_fleet_chains_are_explicit() -> Bool {
  edge_exists(child: "shell-effectplan-to-bash", parent: "shell-typed-invocation")
    && edge_exists(child: "shell-gate-migration", parent: "shell-effectplan-to-bash")
    && edge_exists(child: "roadmap-runtime-ready-override", parent: "roadmap-runtime-identity-join")
    && edge_exists(child: "roadmap-runtime-dispatch-consumer", parent: "roadmap-runtime-ready-override")
    && edge_exists(child: "fleet-closed-loop-converge", parent: "shell-gate-migration")
    && edge_exists(child: "fleet-receipt-qualified-control", parent: "fleet-anti-entropy-hygiene")
}

test fn witness_queued_product_falsifiers_gate_common_shape() -> Bool {
  edge_exists(child: "product-scm-common-shape", parent: "product-scm-git-upstream")
    && edge_exists(child: "product-scm-common-shape", parent: "product-scm-mercurial-upstream")
    && edge_exists(child: "product-scm-common-shape", parent: "product-scm-pijul-upstream")
    && edge_exists(child: "product-source-intent-kernel", parent: "product-scm-common-shape")
    && edge_exists(child: "product-source-intent-kernel", parent: "namespace-canonical-binding")
    && edge_exists(child: "product-agent-landing-benchmark", parent: "product-source-intent-kernel")
}

test fn witness_projection_is_active_only() -> Bool {
  let out = serialize_markdown_source(
    doc: project_roadmap_to_markdown(
      doc: roadmap_authority(),
      merged: authored_merged_prs()
    )
  )
  string_contains(s: out, pattern: "## Active deliverables — dependency order")
    && !string_contains(s: out, pattern: "superseded")
    && !string_contains(s: out, pattern: "awaiting sign-off")
    && !string_contains(s: out, pattern: "Operator TODO")
}
