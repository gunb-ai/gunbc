            GunbcClaimValidation { entry, function } =>
              (entry as String) == "dag/test/claim/source_integration_proof_kernel_acceptance_test.dag"
                && function == "witness_p1_proof_kernel_acceptance_contract_holds"
            CargoTestValidation { filter: _ } => false
            CargoFmtValidation => false
          })
    }
    && !id_exists(id: "2-scm-node-merge")
    && !id_exists(id: "2-scm-design-partner-shadow")
  }
}

