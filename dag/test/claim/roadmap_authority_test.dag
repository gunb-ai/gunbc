    && node_count_with_carrier_path(path: "docs/plans/dag-scm-design.md") == 7
    && !node_has_carrier_path(path: "docs/plans/node-subtree-visibility-grants.md")
    && id_exists(id: "2-scm-git-upstream-model")
    && id_exists(id: "2-scm-mercurial-upstream-model")
    && id_exists(id: "2-scm-pijul-upstream-model")
    && id_exists(id: "2-claim-indexed-evidence")
    && id_exists(id: "2-scm-compatibility-shape")
    && id_exists(id: "2-scm-p0-landing-spine")
    && id_exists(id: "2-scm-p1-proof-kernel")
    && !active_id_exists(id: "2-scm-git-upstream-model")
    && !active_id_exists(id: "2-scm-mercurial-upstream-model")
    && !active_id_exists(id: "2-scm-pijul-upstream-model")
    && !active_id_exists(id: "2-claim-indexed-evidence")
    && !active_id_exists(id: "2-scm-compatibility-shape")
    && !active_id_exists(id: "2-scm-p0-landing-spine")
    && active_id_exists(id: "2-scm-p1-proof-kernel")
    && (accepted |> any(id => id == "2-scm-git-upstream-model"))
    && (accepted |> any(id => id == "2-scm-mercurial-upstream-model"))
    && (accepted |> any(id => id == "2-scm-pijul-upstream-model"))
    && (accepted |> any(id => id == "2-claim-indexed-evidence"))
    && (accepted |> any(id => id == "2-scm-compatibility-shape"))
    && (accepted |> any(id => id == "2-scm-p0-landing-spine"))
    && !(accepted |> any(id => id == "2-scm-p1-proof-kernel"))
    && edge_exists(child: "2-scm-p1-proof-kernel", parent: "2-scm-p0-landing-spine")
