data projection_active_only_focus_independence_note: String = "THIS CLAIM READS THE FOCUS-INDEPENDENT VIEW, and that is the whole point of it (2026-08-07). Its subject is the ACTIVE-SET DERIVATION — declared minus validly accepted — so its three controls have to be about acceptance. Against roadmap_authority(), which applies roadmap_focus_selection, they are not: both negative controls name ACCEPTED nodes (namespace-occurrence-transport and pderive-typesafe-nullary-reflection), so any focus that stops selecting the namespace and P-derive lanes makes them absent because they are HIDDEN, and the claim goes green while proving nothing about acceptance. That is not hypothetical — it happened the moment the focus moved to the infrastructure lanes, and the positive control caught it by failing loudly rather than the negatives passing quietly, which is only luck about which way the focus happened to move.\n\nSo the two facts are separated. Whether an accepted row leaves the active set is asserted here, against NoFocus, where absence can only mean accepted. Whether the focused page hides what the policy says it hides belongs to the focus mechanism's own claims. Binding both to one rendering made the stronger fact hostage to a projection policy row that is expected to move, and DESIGN 5 already names the shape: a check satisfiable by editing a declaration is validation standing where the real subject was available. The precedent is witness_rendered_nodes_are_declared_or_derived, which reads BOTH documents deliberately and says why in rendered_containment_witness_note."

test fn witness_projection_is_active_only() -> Bool {
  let out = serialize_markdown_source(
    doc: project_roadmap_to_markdown(
      doc: roadmap_authority_for(focus: NoFocus),
      merged: authored_merged_prs()
    )
  )
  string_contains(s: out, pattern: "## Active deliverables — dependency order")
    && string_contains(s: out, pattern: "Build and run every product without the old code present")
    && !string_contains(s: out, pattern: "Keep track of exactly which name is which")
    && !string_contains(s: out, pattern: "Stop the compiler from mixing up one type with another")
    && !string_contains(s: out, pattern: "**superseded →**")
    && !string_contains(s: out, pattern: "awaiting sign-off")
    && !string_contains(s: out, pattern: "Operator TODO")
}

data execution_frontier_witness_note: String = "The execution-contract frontier is a COUNT, and these claims pin both of its halves. Before the first binding the count was zero — dispatch_environment_admit refused on every node, so nothing below Env in the workflow had ever executed end to end and the whole seven-segment strip was unreachable in production. A binding is therefore the gate for every downstream receipt, and an unwitnessed one could regress to zero silently (the way it already did once, when the 2026-07-27 authority refresh deleted the node that carried the prior contract and no claim noticed). The first claim proves the bound node yields a real contract rather than the fail-closed variant; the second proves the platform/task capability JOIN actually happens at admission — 8 fixed dispatch mechanics plus the one capability this contract's validation derives — which is the fact that turns a contract into an admissible environment; the third is the frontier itself, and it is the RED-shaped one: it fails if a binding is lost AND it fails if a second node is bound without this roster being updated, so the count in roadmap_execution_contract_frontier_note cannot silently drift from the authority it describes."

fn bound_execution_contract_for(id: String) -> gunbc.roadmap_execution_contract.WorkItemExecutionContract {
  match test.claim.roadmap_authority.nodes()
    |> filter(n => (n.node as String) == id)
    |> map(n => n.execution)
    |> first {
    Present { value: c } => c
    Absent => ExecutionContractUnspecified
  }
}

test fn witness_shell_typed_invocation_carries_a_real_contract() -> Bool {
  match bound_execution_contract_for(id: "shell-typed-invocation") {
    ExecutionContractUnspecified => false
    ExecutionContract { validations, extra_capabilities: _ } => count(validations) == 1
  }
}

test fn witness_bound_contract_joins_platform_and_task_capabilities() -> Bool {
  let caps = dispatch_required_capabilities(
    contract: bound_execution_contract_for(id: "shell-typed-invocation"),
  )
  count(caps) == 9
    && any(caps, c => execution_capability_label(capability: c) == "gunbc-claim-runner")
}

test fn witness_every_binding_carries_a_validation() -> Bool {
  all(
    test.claim.roadmap_authority.nodes() |> filter(n => match n.execution {
        ExecutionContractUnspecified => false
        ExecutionContract { validations: _, extra_capabilities: _ } => true
      }),
    n => match n.execution {
        ExecutionContractUnspecified => false
        ExecutionContract { validations, extra_capabilities: _ } => count(validations) > 0
      },
  )
}

