// GUARDS FOR THE FRONTEND ELEMENTS. Each claim below reads one interface with a supplied fixture:
// an element's markup function, an element's rules, the token block, the palette, a text role.
// None renders a page. The ownership claims are guards over the registered element rules and the
// specimen's layout rules; they do not make a second declaration of an element class unwritable,
// they report one that reaches the registry.

fn html(node: Fragment) -> String {
  serialize_html_source(node: node)
}

fn has(s: String, pattern: String) -> Bool {
  string_contains(s: s, pattern: pattern)
}

// Card.
test fn card_renders_its_edge_label_row_and_trailing_controls() -> Bool {
  let full = html(node: card(input: Card {
    edge: CardEdgeBar,
    label_row: Present { value: CardLabelRow { label: "Description", trailing: [txt("trailing")] } },
    body: [txt("body")],
  }))
  has(s: full, pattern: "<section class=\"el-card\" data-card-edge=\"bar\">")
    && has(s: full, pattern: "<div class=\"el-card-label-row\"><h2 class=\"el-card-label\">Description</h2><div class=\"el-card-trailing\">trailing</div></div>body</section>")
}

test fn card_without_a_label_row_renders_none() -> Bool {
  let plain = html(node: card(input: Card { edge: CardEdgePlain, label_row: Absent, body: [txt("body")] }))
  let labelled = html(node: card(input: Card { edge: CardEdgePlain, label_row: Present { value: CardLabelRow { label: "Comments", trailing: [] } }, body: [] }))
  plain == "<section class=\"el-card\" data-card-edge=\"plain\">body</section>"
    && has(s: labelled, pattern: "<h2 class=\"el-card-label\">Comments</h2></div>")
    && !has(s: labelled, pattern: "el-card-trailing")
}

test fn card_rules_draw_the_measured_card() -> Bool {
  let css = serialize_rules(rules: card_rules())
  has(s: css, pattern: ".el-card { --issue-action-ink: var(--issue-action); min-width: var(--space-0); background: var(--issue-surface); border: var(--border-1) solid var(--issue-border); border-radius: var(--radius-4); padding: var(--space-16); font-family: var(--font-sans); font-size: var(--text-13); line-height: var(--leading-18); font-weight: 400; color: var(--issue-text);")
    && has(s: css, pattern: ".el-card[data-card-edge=\"bar\"] { border-left: var(--border-4) solid var(--issue-leading-bar) }")
    && has(s: css, pattern: ".el-card-label-row { display: flex; align-items: center; gap: var(--space-8); min-height: var(--h-card-label-row) }")
    && has(s: css, pattern: ".el-card-label { margin: var(--space-0); font-family: var(--font-sans); font-size: var(--text-11); line-height: var(--leading-15); font-weight: 500; color: var(--issue-text); text-transform: uppercase; letter-spacing: var(--tracking-80) }")
}

// SectionHeading.
test fn section_heading_formats_the_counts_it_is_given() -> Bool {
  html(node: section_heading(input: SectionHeading { text: "Acceptance criteria", count: SectionUncounted })) == "<h3 class=\"el-section-heading\">Acceptance criteria</h3>"
    && html(node: section_heading(input: SectionHeading { text: "Parent", count: SectionCounted { n: 1 } })) == "<h3 class=\"el-section-heading\">Parent (1)</h3>"
    && html(node: section_heading(input: SectionHeading { text: "Sub-issues", count: SectionCountedOfTotal { n: 1, total: 3 } })) == "<h3 class=\"el-section-heading\">Sub-issues (1/3)</h3>"
}

test fn section_heading_rule_is_the_section_heading_role() -> Bool {
  serialize_rules(rules: section_heading_rules()) == ".el-section-heading { margin: var(--space-8) var(--space-0); font-family: var(--font-sans); font-size: var(--text-13); line-height: var(--leading-18); font-weight: 700; color: var(--issue-text-dim); text-transform: none; letter-spacing: normal }"
}

// StatusChip.
fn chip_is(status_html: String, form: String, label: String) -> Bool {
  status_html == join(["<span class=\"el-status-chip\" data-status-form=\"", form, "\">", label, "</span>"], "")
}

test fn status_chip_renders_every_status_in_its_form() -> Bool {
  chip_is(status_html: html(node: status_chip(status: DisplayReady)), form: "ready", label: "Ready")
    && chip_is(status_html: html(node: status_chip(status: DisplayAssigned)), form: "assigned", label: "Assigned")
    && chip_is(status_html: html(node: status_chip(status: DisplayActive)), form: "assigned", label: "Active")
    && chip_is(status_html: html(node: status_chip(status: DisplayReview)), form: "assigned", label: "Review")
    && chip_is(status_html: html(node: status_chip(status: DisplayBlocked)), form: "blocked", label: "Blocked")
    && chip_is(status_html: html(node: status_chip(status: DisplayReturned)), form: "blocked", label: "Returned")
    && chip_is(status_html: html(node: status_chip(status: DisplayDone)), form: "filled", label: "Done")
    && chip_is(status_html: html(node: status_chip(status: DisplaySuperseded)), form: "quiet", label: "Superseded")
    && chip_is(status_html: html(node: status_chip(status: DisplayUnknown)), form: "quiet", label: "Unknown")
}

test fn status_chip_rules_draw_the_measured_chip_and_its_three_forms() -> Bool {
  let css = serialize_rules(rules: status_chip_rules())
  has(s: css, pattern: ".el-status-chip { --el-status-chip-ring: var(--issue-text-dim); --el-status-chip-fill: var(--issue-bg-subtle); display: inline-flex; align-items: center; height: var(--h-chip); padding: var(--space-0) var(--space-4); border-radius: var(--radius-4); background: var(--el-status-chip-fill); box-shadow: inset 0 0 0 var(--border-1) var(--el-status-chip-ring); white-space: nowrap; font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-22); font-weight: 400;")
    && has(s: css, pattern: ".el-status-chip[data-status-form=\"filled\"] { --el-status-chip-fill: var(--issue-text-dim); color: var(--issue-surface) }")
    && has(s: css, pattern: ".el-status-chip[data-status-form=\"ready\"] { --el-status-chip-ring: var(--status-ready-ink); --el-status-chip-fill: color-mix(in srgb, var(--status-ready-ink) 12%, var(--issue-surface)) }")
    && has(s: css, pattern: ".el-status-chip[data-status-form=\"assigned\"] { --el-status-chip-ring: var(--status-assigned-ink);")
    && has(s: css, pattern: ".el-status-chip[data-status-form=\"blocked\"] { --el-status-chip-ring: var(--status-blocked-ink);")
}

// Button.
test fn button_renders_its_idiom_size_and_availability() -> Bool {
  html(node: button(input: Button { label: "Add", idiom: IssueButtonContainedPrimary, size: ButtonSmall, availability: IssueActionEnabled }))
      == "<button class=\"el-button\" type=\"button\" data-button-idiom=\"contained-primary\" data-button-size=\"small\">Add</button>"
    && has(s: html(node: button(input: Button { label: "Comment", idiom: IssueButtonOutlined, size: ButtonRegular, availability: IssueActionDisabled })),
      pattern: "<button class=\"el-button\" type=\"button\" data-button-idiom=\"outlined\" data-button-size=\"regular\" disabled")
    && has(s: html(node: button(input: Button { label: "More", idiom: IssueButtonText, size: ButtonRegular, availability: IssueActionEnabled })), pattern: "data-button-idiom=\"text\"")
}

test fn button_rules_draw_the_two_sizes_and_three_idioms() -> Bool {
  let css = serialize_rules(rules: button_rules())
  has(s: css, pattern: ".el-button { display: inline-flex; align-items: center; justify-content: center; height: var(--h-button); min-height: var(--h-button); padding: var(--space-0) var(--space-12); border: var(--border-1) solid transparent; border-radius: var(--radius-4); background: transparent; cursor: pointer; white-space: nowrap; font-family: var(--font-heading); font-size: var(--text-14); line-height: var(--leading-20); font-weight: 500; color: var(--issue-action-ink);")
    && has(s: css, pattern: ".el-button[data-button-size=\"small\"] { height: var(--h-button-small); min-height: var(--h-button-small); padding: var(--space-0) var(--space-10); font-size: var(--text-13) }")
    && has(s: css, pattern: ".el-button[data-button-idiom=\"contained-primary\"] { background: var(--issue-action); color: var(--issue-on-action) }")
    && has(s: css, pattern: ".el-button[data-button-idiom=\"outlined\"] { background: var(--issue-surface); border-color: var(--issue-border) }")
    && has(s: css, pattern: ".el-button:disabled { color: color-mix(in srgb, var(--issue-text) 38%, transparent); cursor: default }")
    && has(s: css, pattern: ".el-button[data-button-idiom=\"contained-primary\"]:disabled { background: color-mix(in srgb, var(--issue-text) 12%, transparent) }")
    && has(s: css, pattern: ".el-button[data-button-idiom=\"contained-primary\"]:enabled:hover { background: var(--issue-action-hover) }")
    && has(s: css, pattern: ".el-button:focus-visible { outline: var(--border-2) solid var(--issue-action); outline-offset: var(--space-2) }")
}

// THE HIERARCHY ELEMENTS. The fixture nodes are planted here; no claim below reads a declared
// roadmap row or renders a page.
fn fx_node(slug: String, status: NodeStatus, priority: RoadmapPriority) -> NodePresentation {
  NodePresentation {
    slug: slug,
    title: join(["Title of ", slug], ""),
    status: status,
    priority: DerivedPriority { priority: priority, source: "", reason: "fixture" },
    route: issue_page_path(node_id: slug),
  }
}

fn fx_derived(slug: String, status: IssueDisplayStatus) -> NodePresentation {
  fx_node(slug: slug, status: node_status_derived(status: status), priority: PriorityP2)
}

// Chip and PriorityMark.
test fn chip_and_priority_mark_render_their_typed_inputs() -> Bool {
  html(node: chip(input: Chip { text: "shell-typed-invocation" })) == "<span class=\"el-chip\">shell-typed-invocation</span>"
    && html(node: priority_mark(input: PriorityMark { priority: PriorityP0, explanation: none })) == "<span class=\"el-priority-mark\" data-priority-form=\"solid\">P0</span>"
    && html(node: priority_mark(input: PriorityMark { priority: PriorityP1, explanation: none })) == "<span class=\"el-priority-mark\" data-priority-form=\"ringed\">P1</span>"
    && html(node: priority_mark(input: PriorityMark { priority: PriorityP2, explanation: none })) == "<span class=\"el-priority-mark\" data-priority-form=\"plain\">P2</span>"
    && html(node: priority_mark(input: PriorityMark { priority: PriorityP3, explanation: Present { value: "P3 · fixture" } })) == "<span class=\"el-priority-mark\" data-priority-form=\"quiet\" title=\"P3 · fixture\">P3</span>"
}

test fn chip_and_priority_mark_rules_draw_the_measured_marks() -> Bool {
  let chip_css = serialize_rules(rules: chip_rules())
  let mark_css = serialize_rules(rules: priority_mark_rules())
  has(s: chip_css, pattern: ".el-chip { display: inline-flex; align-items: center; min-height: var(--h-chip); padding: var(--space-0) var(--space-6); border-radius: var(--radius-4); background: color-mix(in srgb, var(--issue-text) 6%, transparent); font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-22); font-weight: 400;")
    && has(s: mark_css, pattern: ".el-priority-mark { display: inline-flex; align-items: center; justify-content: flex-start; box-sizing: border-box; min-width: var(--w-priority-mark); height: var(--h-chip); padding: var(--space-0) var(--space-2); border: var(--border-2) solid transparent; border-radius: var(--radius-4); font-family: var(--font-sans); font-size: var(--text-13);")
    && has(s: mark_css, pattern: ".el-priority-mark[data-priority-form=\"ringed\"] { border-color: var(--issue-action) }")
    && has(s: mark_css, pattern: ".el-priority-mark[data-priority-form=\"solid\"] { border-color: var(--issue-action); background: var(--issue-action); color: var(--issue-on-action) }")
}

// NodeRow.
test fn node_row_renders_title_priority_slug_and_status_from_the_presentation() -> Bool {
  let row = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-parent", status: node_status_derived(status: DisplayActive), priority: PriorityP1), place: NodeRowFlat, density: NodeRowDensityTable }))
  row == join([
    "<tr class=\"el-node-row\" data-node-density=\"table\" data-node-state=\"open\" data-node-depth=\"0\">",
    "<td class=\"el-node-row-cell\" data-node-column=\"title\"><div class=\"el-node-row-lead\"><a class=\"el-node-row-link\" href=\"/issue/fx-parent\">Title of fx-parent</a></div></td>",
    "<td class=\"el-node-row-cell\" data-node-column=\"priority\"><span class=\"el-priority-mark\" data-priority-form=\"ringed\" title=\"P1 · fixture\">P1</span></td>",
    "<td class=\"el-node-row-cell\" data-node-column=\"id\"><span class=\"el-chip\">fx-parent</span></td>",
    "<td class=\"el-node-row-cell\" data-node-column=\"status\"><span class=\"el-status-chip\" data-status-form=\"assigned\">Active</span></td>",
    "</tr>",
  ], "")
}

test fn node_row_in_a_tree_shows_its_depth_and_links_the_count_it_refers_to() -> Bool {
  let with_children = html(node: node_row(input: NodeRow { node: fx_derived(slug: "fx-branch", status: DisplayReady), place: NodeRowInTree { depth: 2, children: RowChildrenExpandable { count: 3 } }, density: NodeRowDensityTable }))
  let one_child = html(node: node_row(input: NodeRow { node: fx_derived(slug: "fx-one", status: DisplayReady), place: NodeRowInTree { depth: 0, children: RowChildrenExpandable { count: 1 } }, density: NodeRowDensityTable }))
  let leaf = html(node: node_row(input: NodeRow { node: fx_derived(slug: "fx-leaf", status: DisplayReady), place: NodeRowInTree { depth: 0, children: RowChildrenExpandable { count: 0 } }, density: NodeRowDensityTable }))
  has(s: with_children, pattern: "data-node-depth=\"2\"")
    && count(split(s: with_children, delimiter: "<span class=\"el-node-row-indent\" aria-hidden=\"true\"></span>")) == 3
    && has(s: with_children, pattern: "<a class=\"el-node-row-link\" href=\"/issue/fx-branch\">Title of fx-branch</a><a class=\"el-node-row-children\" href=\"/issue/fx-branch\" data-node-children=\"3\">3 sub-issues</a></div>")
    && has(s: one_child, pattern: "<a class=\"el-node-row-children\" href=\"/issue/fx-one\" data-node-children=\"1\">1 sub-issue</a>")
    && has(s: leaf, pattern: "<div class=\"el-node-row-lead\"><a class=\"el-node-row-link\" href=\"/issue/fx-leaf\">Title of fx-leaf</a></div>")
    && !has(s: leaf, pattern: "el-node-row-indent")
    && !has(s: leaf, pattern: "el-node-row-children")
    && !has(s: with_children, pattern: "<svg")
    && !has(s: with_children, pattern: "<button")
}

test fn node_row_says_an_underived_status_is_unavailable() -> Bool {
  let row = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-gone", status: NodeStatusUnavailable { reason: "no authority establishes a status" }, priority: PriorityP2), place: NodeRowFlat, density: NodeRowDensityTable }))
  has(s: row, pattern: "<td class=\"el-node-row-cell\" data-node-column=\"status\"><span class=\"el-node-row-status-unavailable\" title=\"no authority establishes a status\" aria-label=\"Status unavailable: no authority establishes a status\">Status unavailable</span></td>")
    && !has(s: row, pattern: "el-status-chip")
    && has(s: row, pattern: "data-node-state=\"open\"")
}

// A row is drawn closed exactly when its presentation says the node is closed. For a planted
// status that is the vocabulary's own predicate, and the claim walks the whole vocabulary, so a
// status added to it is covered without an edit here. The two rows after it separate the closure
// fact from the status word: a node the producer states is closed is drawn closed while shown as
// Unknown, and a node shown as Done that the producer states is not closed is drawn open.
fn row_state(status: NodeStatus) -> String {
  let row = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-any", status: status, priority: PriorityP2), place: NodeRowFlat, density: NodeRowDensityTable }))
  if has(s: row, pattern: "data-node-state=\"closed\"") && !has(s: row, pattern: "data-node-state=\"open\"") { "closed" }
  else if has(s: row, pattern: "data-node-state=\"open\"") && !has(s: row, pattern: "data-node-state=\"closed\"") { "open" }
  else { "neither" }
}

fn row_state_follows_predicate(status: IssueDisplayStatus) -> Bool {
  row_state(status: node_status_derived(status: status)) == (if issue_display_status_is_closed(status: status) { "closed" } else { "open" })
}

test fn node_row_closed_styling_follows_the_status_predicate() -> Bool {
  let css = serialize_rules(rules: node_row_rules())
  all(issue_display_statuses, s => row_state_follows_predicate(status: s))
    && any(issue_display_statuses, s => issue_display_status_is_closed(status: s))
    && any(issue_display_statuses, s => !issue_display_status_is_closed(status: s))
    && row_state(status: NodeStatusDerived { status: DisplayUnknown, closed: true }) == "closed"
    && row_state(status: NodeStatusDerived { status: DisplayDone, closed: false }) == "open"
    && row_state(status: NodeStatusUnavailable { reason: "no authority establishes a status" }) == "open"
    && has(s: css, pattern: ".el-node-row[data-node-state=\"closed\"] .el-node-row-cell { background: var(--issue-closed-row); color: var(--issue-text-dim) }")
    && has(s: css, pattern: ".el-node-row[data-node-state=\"closed\"] .el-node-row-link { color: var(--issue-text-dim) }")
    && !has(s: css, pattern: "data-node-state=\"open\"")
}

test fn node_row_header_and_rules_draw_the_table_density() -> Bool {
  let css = serialize_rules(rules: node_row_rules())
  let flat = html(node: node_row_header(density: NodeRowDensityTable))
  flat == "<tr class=\"el-node-row-head\" data-node-density=\"table\"><th class=\"el-node-row-heading\" data-node-column=\"title\" scope=\"col\">Title</th><th class=\"el-node-row-heading\" data-node-column=\"priority\" scope=\"col\">P</th><th class=\"el-node-row-heading\" data-node-column=\"id\" scope=\"col\">Id</th><th class=\"el-node-row-heading\" data-node-column=\"status\" scope=\"col\">Status</th></tr>"
    && has(s: css, pattern: ".el-node-row[data-node-density=\"table\"] { --el-node-row-height: var(--h-relation-row) }")
    && has(s: css, pattern: ".el-node-row-head[data-node-density=\"table\"] { --el-node-row-height: var(--h-relation-row) }")
    && has(s: css, pattern: ".el-node-row[data-node-density=\"grid\"] { --el-node-row-height: var(--h-grid-row) }")
    && has(s: html(node: node_row_header(density: NodeRowDensityGrid)), pattern: "<tr class=\"el-node-row-head\" data-node-density=\"grid\">")
    && has(s: css, pattern: ".el-node-row-cell { height: var(--el-node-row-height); padding: var(--space-0) var(--space-4); border-bottom: var(--border-1) solid var(--issue-border); vertical-align: middle; text-align: left; white-space: nowrap; font-family: var(--font-sans); font-size: var(--text-13);")
    && has(s: css, pattern: ".el-node-row-indent { flex: none; width: var(--space-24) }")
    && has(s: css, pattern: ".el-node-row-children { font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-16); font-weight: 500; color: var(--issue-text-dim); text-transform: none; letter-spacing: normal; flex: none; color: var(--issue-action-ink); text-decoration: none; white-space: nowrap }")
}

// RelationTable.
fn fx_relation(kind: RelationKind, nodes: List<NodePresentation>, undeclared: List<String>) -> NodeRelation {
  NodeRelation {
    kind: kind,
    rows: map(nodes, n => RelationRow { node: n, children: match kind {
      RelationSubIssues => RowChildrenExpandable { count: 0 }
      RelationParent => RowChildrenNotCarried
      RelationBlockedBy => RowChildrenNotCarried
      RelationBlocking => RowChildrenNotCarried
    } }),
    undeclared: undeclared,
  }
}

fn table_html(relation: NodeRelation) -> String {
  html(node: relation_table(input: RelationTable { relation: relation, depth: 0 }))
}

fn row_count(table: String) -> Int {
  count(split(s: table, delimiter: "<tr class=\"el-node-row\"")) - 1
}

test fn relation_table_heading_counts_the_rows_it_shows() -> Bool {
  let parent = table_html(relation: fx_relation(kind: RelationParent, nodes: [fx_derived(slug: "fx-parent", status: DisplayActive)], undeclared: []))
  let blocked = table_html(relation: fx_relation(kind: RelationBlockedBy, nodes: [fx_derived(slug: "fx-a", status: DisplayBlocked), fx_derived(slug: "fx-b", status: DisplayDone)], undeclared: []))
  has(s: parent, pattern: "<section class=\"el-relation-table\" data-relation-kind=\"parent\"><h3 class=\"el-section-heading\">Parent (1)</h3><table class=\"el-relation-table-rows\"><thead><tr class=\"el-node-row-head\"")
    && row_count(table: parent) == 1
    && has(s: blocked, pattern: "<h3 class=\"el-section-heading\">Blocked by (2)</h3>")
    && row_count(table: blocked) == 2
    && has(s: blocked, pattern: "data-node-state=\"closed\" data-node-depth=\"0\"><td class=\"el-node-row-cell\" data-node-column=\"title\"><div class=\"el-node-row-lead\"><a class=\"el-node-row-link\" href=\"/issue/fx-b\">")
}

test fn relation_table_sub_issues_read_closed_over_total_only_when_every_status_is_derived() -> Bool {
  let derived = [fx_derived(slug: "fx-a", status: DisplayReady), fx_derived(slug: "fx-b", status: DisplayDone), fx_derived(slug: "fx-c", status: DisplaySuperseded)]
  let all_derived = table_html(relation: fx_relation(kind: RelationSubIssues, nodes: derived, undeclared: []))
  let one_unavailable = table_html(relation: fx_relation(kind: RelationSubIssues, nodes: concat(derived, [fx_node(slug: "fx-d", status: NodeStatusUnavailable { reason: "no authority establishes a status" }, priority: PriorityP2)]), undeclared: []))
  has(s: all_derived, pattern: "<h3 class=\"el-section-heading\">Sub-issues (2/3)</h3>")
    && row_count(table: all_derived) == 3
    && has(s: one_unavailable, pattern: "<h3 class=\"el-section-heading\">Sub-issues (4)</h3>")
    && row_count(table: one_unavailable) == 4
}

test fn relation_table_states_an_empty_relation_and_names_an_undeclared_id() -> Bool {
  let empty = table_html(relation: fx_relation(kind: RelationParent, nodes: [], undeclared: []))
  let empty_blocking = table_html(relation: fx_relation(kind: RelationBlocking, nodes: [], undeclared: []))
  let undeclared = table_html(relation: fx_relation(kind: RelationBlockedBy, nodes: [], undeclared: ["fx-missing"]))
  empty == "<section class=\"el-relation-table\" data-relation-kind=\"parent\"><h3 class=\"el-section-heading\">Parent (0)</h3><p class=\"el-relation-table-empty\">No parent</p></section>"
    && has(s: empty_blocking, pattern: "<p class=\"el-relation-table-empty\">Not blocking any issue</p>")
    && has(s: undeclared, pattern: "<tr class=\"el-relation-table-undeclared\"><td class=\"el-relation-table-undeclared-cell\" colspan=\"4\"><div class=\"el-relation-table-undeclared-note\"><span class=\"el-chip\">fx-missing</span><span>Blocked by names no declared node</span></div></td></tr>")
    && row_count(table: undeclared) == 0
    && !has(s: undeclared, pattern: "el-relation-table-empty")
}

test fn relation_table_rules_style_the_table_and_no_row_internals() -> Bool {
  let css = serialize_rules(rules: relation_table_rules())
  has(s: css, pattern: ".el-relation-table-rows { width: 100%; border-collapse: collapse }")
    && has(s: css, pattern: ".el-relation-table-empty { font-family: var(--font-sans); font-size: var(--text-13);")
    && !has(s: css, pattern: ".el-node-row")
    && !has(s: css, pattern: ".el-section-heading")
}

// NodeChain.
fn fx_chain(levels: Int) -> NodeChain {
  let slugs: List<String> = ["l1", "l2", "l3", "l4", "l5", "l6", "l7"]
  let ancestors = map(slugs.take(n: levels - 1), slug => fx_derived(slug: slug, status: DisplayActive))
  NodeChainRooted { ancestors: ancestors, self_node: fx_derived(slug: "self", status: DisplayReady) }
}

fn chain_html(levels: Int) -> String {
  html(node: node_chain(chain: fx_chain(levels: levels)))
}

test fn node_chain_lists_every_level_as_a_titled_link_ending_in_the_current_node() -> Bool {
  chain_html(levels: 3) == join([
    "<nav class=\"el-node-chain\" aria-label=\"Issue hierarchy\" data-chain-state=\"rooted\"><ol class=\"el-node-chain-levels\">",
    "<li class=\"el-node-chain-level\"><a class=\"el-node-chain-link\" href=\"/issue/l1\" title=\"Title of l1\" aria-label=\"l1: Title of l1\">l1</a></li>",
    "<li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><a class=\"el-node-chain-link\" href=\"/issue/l2\" title=\"Title of l2\" aria-label=\"l2: Title of l2\">l2</a></li>",
    "<li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><span class=\"el-node-chain-current\" aria-current=\"page\" title=\"Title of self\" aria-label=\"self: Title of self\">self</span></li>",
    "</ol></nav>",
  ], "")
    && chain_html(levels: 1) == "<nav class=\"el-node-chain\" aria-label=\"Issue hierarchy\" data-chain-state=\"rooted\"><ol class=\"el-node-chain-levels\"><li class=\"el-node-chain-level\"><span class=\"el-node-chain-current\" aria-current=\"page\" title=\"Title of self\" aria-label=\"self: Title of self\">self</span></li></ol></nav>"
}

// Every level of a chain is in the rendered chain as a link (or as the current node), at every
// length. A chain folds only past the unfolded limit, and a folded chain states how many levels
// the fold holds: all of them but the first and the last two.
fn chain_keeps_every_level(levels: Int) -> Bool {
  let h = chain_html(levels: levels)
  let links = count(split(s: h, delimiter: "<a class=\"el-node-chain-link\"")) - 1
  let folds = count(split(s: h, delimiter: "<details class=\"el-node-chain-fold\">")) - 1
  let fold_stated = if levels <= node_chain_unfolded_levels {
    folds == 0 && !has(s: h, pattern: "<summary")
  } else {
    folds == 1
      && has(s: h, pattern: join(["<summary class=\"el-node-chain-fold-count\" aria-label=\"", to_string(levels - 3), " more levels\" title=\"", to_string(levels - 3), " more levels\">… ", to_string(levels - 3), "</summary>"], ""))
  }
  links == levels - 1
    && count(split(s: h, delimiter: "aria-current=\"page\"")) == 2
    && fold_stated
}

test fn node_chain_overflow_never_hides_a_level_without_the_counted_control() -> Bool {
  all([1, 2, 3, 4, 5, 6, 7, 8], n => chain_keeps_every_level(levels: n))
    && node_chain_unfolded_levels == 4
}

test fn node_chain_folds_the_middle_and_keeps_the_first_and_the_last_two() -> Bool {
  let h = chain_html(levels: 7)
  has(s: h, pattern: "<ol class=\"el-node-chain-levels\"><li class=\"el-node-chain-level\"><a class=\"el-node-chain-link\" href=\"/issue/l1\" title=\"Title of l1\" aria-label=\"l1: Title of l1\">l1</a></li><li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><details class=\"el-node-chain-fold\"><summary")
    && has(s: h, pattern: "</summary><ol class=\"el-node-chain-levels\"><li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><a class=\"el-node-chain-link\" href=\"/issue/l2\"")
    && has(s: h, pattern: "aria-label=\"l5: Title of l5\">l5</a></li></ol></details></li><li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><a class=\"el-node-chain-link\" href=\"/issue/l6\"")
    && has(s: h, pattern: "aria-label=\"l6: Title of l6\">l6</a></li><li class=\"el-node-chain-level\"><span class=\"el-node-chain-separator\" aria-hidden=\"true\">›</span><span class=\"el-node-chain-current\" aria-current=\"page\"")
}

test fn node_chain_renders_a_refused_lineage_as_its_reason_and_no_level() -> Bool {
  html(node: node_chain(chain: NodeChainRefused { refusal: LineageCyclic { node_id: "fx-loop" } }))
    == "<nav class=\"el-node-chain\" aria-label=\"Issue hierarchy\" data-chain-state=\"refused\"><span class=\"el-node-chain-refused\">project path unavailable: the parent walk revisits fx-loop; project nesting is cyclic</span></nav>"
}

test fn node_chain_rules_draw_one_chip() -> Bool {
  let css = serialize_rules(rules: node_chain_rules())
  has(s: css, pattern: ".el-node-chain { display: inline-flex; align-items: center; min-height: var(--h-chip); padding: var(--space-0) var(--space-6); border-radius: var(--radius-4); background: color-mix(in srgb, var(--issue-text) 6%, transparent); font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-22);")
    && has(s: css, pattern: ".el-node-chain-current { color: var(--issue-text) }")
    && has(s: css, pattern: ".el-node-chain-refused { color: var(--issue-error) }")
    && has(s: css, pattern: ".el-node-chain-fold-count:focus-visible { outline: var(--border-2) solid var(--issue-action); outline-offset: var(--space-2) }")
}

// Tokens. The adopted values are the rulings of the element spec (R3 and section 1).
test fn element_tokens_carry_the_adopted_radius_and_heights() -> Bool {
  let css = serialize_decls(decls: element_token_decls())
  has(s: css, pattern: "--radius-4: 4px")
    && has(s: css, pattern: "--radius-2: 2px")
    && has(s: css, pattern: "--h-chip: 22px")
    && has(s: css, pattern: "--h-button-small: 24px")
    && has(s: css, pattern: "--h-button: 32px")
    && has(s: css, pattern: "--h-tab: 34px")
    && has(s: css, pattern: "--h-relation-row: 32px")
    && has(s: css, pattern: "--h-grid-row: 36px")
    && has(s: css, pattern: "--h-bar: 48px")
    && has(s: css, pattern: "--h-card-label-row: 36px")
}

test fn element_tokens_add_only_what_the_shared_scale_lacks() -> Bool {
  let css = serialize_decls(decls: element_token_decls())
  has(s: css, pattern: "--space-10: 10px")
    && has(s: css, pattern: "--border-4: 4px")
    && has(s: css, pattern: "--leading-15: 15px")
    && has(s: css, pattern: "--leading-24: 24px")
    && has(s: css, pattern: "--font-code: monospace")
    && has(s: css, pattern: "--font-heading: Google Sans, Roboto, Arial, sans-serif")
    && has(s: css, pattern: "--tracking-80: 0.80px")
    && !has(s: css, pattern: "--space-16:")
    && !has(s: css, pattern: "--text-13:")
    && !has(s: css, pattern: "--border-1:")
    && count(split(s: css, delimiter: "--leading-18:")) == 2
}

// Text roles.
fn role_css(decls: List<CssDecl>) -> String {
  serialize_decls(decls: decls)
}

test fn text_roles_body_label_and_headings() -> Bool {
  role_css(decls: element_text_decls(role: ElementBody)) == "font-family: var(--font-sans); font-size: var(--text-13); line-height: var(--leading-18); font-weight: 400; color: var(--issue-text); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_text_decls(role: ElementLabel)) == "font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-16); font-weight: 500; color: var(--issue-text-dim); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_text_decls(role: ElementCardLabel)) == "font-family: var(--font-sans); font-size: var(--text-11); line-height: var(--leading-15); font-weight: 500; color: var(--issue-text); text-transform: uppercase; letter-spacing: var(--tracking-80)"
    && role_css(decls: element_text_decls(role: ElementSectionHeading)) == "font-family: var(--font-sans); font-size: var(--text-13); line-height: var(--leading-18); font-weight: 700; color: var(--issue-text-dim); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_text_decls(role: ElementProseHeading)) == "font-family: var(--font-sans); font-size: var(--text-18); line-height: var(--leading-24); font-weight: 500; color: var(--issue-text); text-transform: none; letter-spacing: normal"
}

test fn text_roles_control_title_identifier_and_code() -> Bool {
  role_css(decls: element_text_decls(role: ElementControl)) == "font-family: var(--font-heading); font-size: var(--text-14); line-height: var(--leading-20); font-weight: 500; color: var(--issue-action-ink); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_control_small_size_decls()) == "font-size: var(--text-13)"
    && role_css(decls: element_text_decls(role: ElementTitle)) == "font-family: var(--font-heading); font-size: var(--text-18); line-height: var(--leading-24); font-weight: 400; color: var(--issue-text); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_text_decls(role: ElementIdentifier)) == "font-family: var(--font-sans); font-size: var(--text-12); line-height: var(--leading-22); font-weight: 400; color: var(--issue-text); text-transform: none; letter-spacing: normal"
    && role_css(decls: element_text_decls(role: ElementCode)) == "font-family: var(--font-code); font-size: var(--text-13); line-height: var(--leading-18); font-weight: 400; color: var(--issue-code-ink); text-transform: none; letter-spacing: normal"
}

// Palette.
