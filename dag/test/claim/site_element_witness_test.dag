    && has(s: css, pattern: "--issue-surface: #18191b")
    && has(s: css, pattern: "--issue-bg-subtle: #242528")
    && has(s: css, pattern: "--issue-leading-bar: #1a73e8")
}

// Colours are approved as pairings: the action colour clears AA for body-size text on a card and
// not on the ground, which is why link-coloured text on the ground takes the link slot.
fn pairing_clears_text_aa(figure: Srgb8, ground: Srgb8) -> Bool {
  match grade_pairing(figure: Swatch { name: "figure", color: figure }, ground: Swatch { name: "ground", color: ground }) {
    Present { value: p } => grade_rank(g: p.grade) >= grade_rank(g: TextAa)
    Absent => false
  }
}

test fn link_pairing_on_the_ground_clears_aa_where_the_action_colour_does_not() -> Bool {
  pairing_clears_text_aa(figure: palette_day(slot: SlotLink), ground: palette_day(slot: SlotGround))
    && pairing_clears_text_aa(figure: palette_day(slot: SlotAction), ground: palette_day(slot: SlotSurface))
    && !pairing_clears_text_aa(figure: palette_day(slot: SlotAction), ground: palette_day(slot: SlotGround))
}

// The specimen route.
fn live_table_or_empty() -> ServedRouteTable<RoadmapServeHandler> {
  match roadmap_serve_route_table_build() {
    ServedRouteTableBuilt { table: t } => t
    ServedRouteTableBuildRefused { raw: _, segment: _, reason: _ } => ServedRouteTable { routes: [] }
  }
}

test fn specimen_route_selects_the_specimen_handler() -> Bool {
  match serve_select_route(table: live_table_or_empty(), method: GET, path: specimen_route_path) {
    SelectedDynamic { handler: h, params: _ } => h == SpecimenPageHandler
    SelectedStatic { route: _ } => false
    MethodNotAllowed { allowed: _ } => false
    NoRouteMatched => false
  }
}

// The specimen is built from the production elements: every registered element's class reaches
// the served content. Removing an element from the page turns this red.
test fn specimen_content_is_built_from_every_registered_element() -> Bool {
  match try_serialize_html_source(node: Element { tag: "div", attributes: [], children: specimen_content() }) {
    EmitRejected { reason: _ } => false
    EmitOk { html: h } => all(element_styles(), s => has(s: h, pattern: join(["class=\"", s.class_name, "\""], "")))
  }
}

// Ownership guards.
fn style_selectors(style: ElementStyle) -> List<String> {
  map(style.rules, r => rule_selector(rule: r))
}

fn selector_names_class(selector: String, class_name: String) -> Bool {
  has(s: selector, pattern: join([".", class_name], ""))
}

fn style_owns_its_selectors(style: ElementStyle, all_styles: List<ElementStyle>) -> Bool {
  all(style_selectors(style: style), sel =>
    selector_names_class(selector: sel, class_name: style.class_name)
      && all(all_styles, other => other.class_name == style.class_name || !selector_names_class(selector: sel, class_name: other.class_name)))
}

fn styles_have_one_owner_each(styles: List<ElementStyle>) -> Bool {
  count(distinct_by_key(xs: styles, key: s => s.class_name)) == count(styles)
    && all(styles, s => style_owns_its_selectors(style: s, all_styles: styles))
}

test fn each_element_class_is_declared_by_one_element_module() -> Bool {
  styles_have_one_owner_each(styles: element_styles())
}

test fn a_rule_reaching_into_another_element_is_reported() -> Bool {
  let rogue = StaticRule { selector: RawSelector { text: ".el-card .el-button" }, decls: [decl(prop: Padding, value: "0")] }
  let stolen = StaticRule { selector: RawSelector { text: ".el-button" }, decls: [decl(prop: Color, value: "inherit")] }
  !styles_have_one_owner_each(styles: concat(element_styles(), [ElementStyle { class_name: "el-card", rules: [] }]))
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-card", rules: [rogue] }, ElementStyle { class_name: "el-button", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-card", rules: [stolen] }, ElementStyle { class_name: "el-button", rules: [] }])
}

// The hierarchy elements are rows of the same registry, so the claims above already read them;
// these name them, and plant the reaches a composing element or a page could be tempted into.
test fn the_hierarchy_elements_are_registered_and_guarded() -> Bool {
  let names = map(element_styles(), s => s.class_name)
  let table_styling_a_row = StaticRule { selector: RawSelector { text: ".el-relation-table .el-node-row-cell" }, decls: [decl(prop: Padding, value: "0")] }
  let row_styling_a_chip = StaticRule { selector: RawSelector { text: ".el-node-row .el-chip" }, decls: [decl(prop: Padding, value: "0")] }
  let chain_styling_a_chip = StaticRule { selector: RawSelector { text: ".el-node-chain .el-status-chip" }, decls: [decl(prop: Color, value: "inherit")] }
  let own_rule = StaticRule { selector: RawSelector { text: ".el-relation-table-rows" }, decls: [decl(prop: Padding, value: "0")] }
  all(["el-chip", "el-priority-mark", "el-node-row", "el-relation-table", "el-node-chain"], n => any(names, have => have == n))
    && styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-relation-table", rules: [own_rule] }, ElementStyle { class_name: "el-node-row", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-relation-table", rules: [table_styling_a_row] }, ElementStyle { class_name: "el-node-row", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-node-row", rules: [row_styling_a_chip] }, ElementStyle { class_name: "el-chip", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-node-chain", rules: [chain_styling_a_chip] }, ElementStyle { class_name: "el-status-chip", rules: [] }])
}

test fn the_specimen_page_styles_no_element_internals() -> Bool {
  all(specimen_layout_rules(), r => all(element_styles(), s => !selector_names_class(selector: rule_selector(rule: r), class_name: s.class_name)))
}

test fn element_rules_carry_no_literal_colour_or_raw_length() -> Bool {
  count(unthemed_color_decls(rules: element_rules())) == 0
    && count(untokened_length_decls(rules: element_rules())) == 0
}

// FieldList. Each value arm is supplied directly (no producer runs): every arm that shows text
// draws it as ONE single-line text element carrying the full value in `title`, and a value the
// caller abbreviated keeps its full text in the DOM for assistive technology.
fn field_html(value: FieldValue) -> String {
  html(node: field_list(input: FieldList { rows: [FieldRow { label: "Field", value: value }] }))
}

fn field_face() -> Fragment {
  Element { tag: "span", attributes: [], children: [txt("A")] }
}

data field_long: String = "a-very-long-service-identity@an-equally-long-project.iam.gserviceaccount.com"

test fn field_list_value_arms_render_one_single_line_value_with_the_full_text_in_title() -> Bool {
  let text = field_html(value: FieldText { text: field_long, full: none })
  let short = field_html(value: FieldText { text: "attempt 0cfc…", full: Present { value: "attempt 0cfc18886a3d3b10" } })
  let links = field_html(value: FieldLinks { links: [FieldLink { text: "Parent title", href: "/issue/p", full: none }], unlinked: ["undeclared: q"] })
  let person = field_html(value: FieldIdentity { person: FieldPerson { face: field_face(), identity: field_long, full: Present { value: join(["Service — ", field_long], "") } } })
  let control = field_html(value: FieldIdentityControl { person: FieldPerson { face: field_face(), identity: field_long, full: none }, action: "Change assignee", editor: [] })
  text == join(["<dl class=\"el-field-list\"><div class=\"el-field-list-row\" data-field-value=\"text\"><dt class=\"el-field-list-label\">Field</dt><dd class=\"el-field-list-value\"><span class=\"el-field-list-text\" title=\"", field_long, "\" tabindex=\"0\">", field_long, "</span></dd></div></dl>"], "")
    && has(s: short, pattern: "title=\"attempt 0cfc18886a3d3b10\" tabindex=\"0\"><span aria-hidden=\"true\">attempt 0cfc…</span><span class=\"el-field-list-assistive\">attempt 0cfc18886a3d3b10</span>")
    && has(s: links, pattern: "<span class=\"el-field-list-text\" title=\"Parent title, undeclared: q\"><a class=\"el-field-list-link\" href=\"/issue/p\" title=\"Parent title\">Parent title</a>, undeclared: q</span>")
    && has(s: person, pattern: join(["title=\"Service — ", field_long, "\" tabindex=\"0\">"], ""))
    && has(s: person, pattern: "<span class=\"el-field-list-face\" aria-hidden=\"true\">")
    && has(s: control, pattern: join(["aria-label=\"Change assignee: ", field_long, "\""], ""))
    && has(s: control, pattern: "data-field-open=\"in-place\"")
    && !has(s: control, pattern: "tabindex")
    && has(s: html(node: field_list(input: FieldList { rows: [FieldRow { label: "Status", value: FieldStatusControl { status: DisplayActive, detail: [] } }] })), pattern: "<span class=\"el-status-chip\" data-status-form=\"assigned\">Active</span>")
    && has(s: field_html(value: FieldAction { text: "3 issues", attributes: [] }), pattern: "<button class=\"el-field-list-action\" type=\"button\" title=\"3 issues\">3 issues</button>")
}

// An absent value draws "--" and nothing else visible, with its reason in `title` and as the text
// assistive technology reads; the mark itself is hidden from it.
test fn field_list_absent_value_renders_the_mark_with_its_reason() -> Bool {
  field_html(value: FieldAbsent { reason: "Not recorded" })
    == "<dl class=\"el-field-list\"><div class=\"el-field-list-row\" data-field-value=\"absent\"><dt class=\"el-field-list-label\">Field</dt><dd class=\"el-field-list-value\"><span class=\"el-field-list-text el-field-list-absent\" title=\"Not recorded\"><span aria-hidden=\"true\">--</span><span class=\"el-field-list-assistive\">Not recorded</span></span></dd></div></dl>"
}

// The rules draw the measured sidebar: a fixed label column clamped as measured, one row pitch,
// the Label and Body roles, and single-line values cut with an ellipsis.
test fn field_list_rules_draw_one_pitch_a_fixed_label_column_and_single_line_values() -> Bool {
  let css = serialize_rules(rules: field_list_rules())
  has(s: css, pattern: ".el-field-list { display: grid; grid-template-columns: minmax(var(--w-field-label-min), max-content) minmax(0, 1fr); column-gap: var(--space-10);")
    && has(s: css, pattern: ".el-field-list-row { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; align-items: start; min-height: var(--h-field-row);")
    && has(s: css, pattern: "max-width: var(--w-field-label-max); white-space: nowrap }")
    && has(s: css, pattern: ".el-field-list-text { display: block; position: relative; min-width: var(--space-0); overflow: hidden; text-overflow: ellipsis; white-space: nowrap }")
    && has(s: css, pattern: "min-height: var(--h-button-small)")
    && has(s: css, pattern: ".el-field-list-face { display: inline-flex; flex: none; width: var(--h-field-avatar); height: var(--h-field-avatar); border-radius: var(--radius-999)")
}

// The ownership guard reads the field list as a registered element: its rules name only its own
// classes, a page rule reaching into a row is reported, and the field list may compose the status
// chip and the build meter without styling either.
test fn field_list_is_registered_and_guarded() -> Bool {
  let reach = StaticRule { selector: RawSelector { text: ".issue-rail .el-field-list-value" }, decls: [decl(prop: Padding, value: "0")] }
  let into_chip = StaticRule { selector: RawSelector { text: ".el-field-list-summary .el-status-chip" }, decls: [decl(prop: Padding, value: "0")] }
  any(element_styles(), s => s.class_name == "el-field-list")
    && styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-field-list", rules: field_list_rules() }, ElementStyle { class_name: "el-status-chip", rules: [] }, ElementStyle { class_name: "el-build-meter", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-card", rules: [reach] }, ElementStyle { class_name: "el-field-list", rules: [] }])
    && !styles_have_one_owner_each(styles: [ElementStyle { class_name: "el-field-list", rules: [into_chip] }, ElementStyle { class_name: "el-status-chip", rules: [] }])
}

// The specimen's fixture holds every arm the rail uses and the long values that used to wrap.
test fn specimen_field_list_fixture_covers_the_rail_cases() -> Bool {
  let h = html(node: field_list(input: specimen_field_list_fixture()))
  all(["status-control", "identity-control", "work", "absent", "text", "links", "action", "identity"], k => has(s: h, pattern: join(["data-field-value=\"", k, "\""], "")))
    && has(s: h, pattern: "iam.gserviceaccount.com")
}

// EVERY PRIORITY IS THE SAME BOX. The one rule that sets geometry (size, padding, border width,
// alignment) names the element's class alone, and each form's rule may set only colours: the
// border's colour, the fill and the ink. So no priority can move its label's left edge, and the
// column is aligned by construction. A form rule that changed a length is reported.
fn colour_only(decls: List<CssDecl>) -> Bool {
  all(decls, d => any(["border-color", "background", "color"], n => css_property_wire(p: d.prop) == n))
}

test fn every_priority_mark_has_the_same_geometry() -> Bool {
  let marks = map([PriorityP0, PriorityP1, PriorityP2, PriorityP3], p => html(node: priority_mark(input: PriorityMark { priority: p, explanation: none })))
  all(priority_mark_forms, f => colour_only(decls: priority_mark_form_decls(form: f)))
    && !colour_only(decls: [decl(prop: Padding, value: "var(--space-4)")])
    && all(marks, m => has(s: m, pattern: "<span class=\"el-priority-mark\" data-priority-form=\""))
    && count(priority_mark_rules()) == 4
}

// ACCEPTED AND WITHHELD ARE STATUSES, NOT ABSENCES. A node the acceptance authority lists draws the
// Accepted chip in the filled form Done uses and reads closed; one the plan withholds draws the
// Withheld chip in the quiet form and reads open; only a node no authority establishes says its
// status is unavailable.
test fn accepted_and_withheld_draw_their_own_chips() -> Bool {
  let accepted = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-acc", status: NodeStatusAccepted, priority: PriorityP2), place: NodeRowFlat, density: NodeRowDensityTable }))
  let withheld = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-wh", status: NodeStatusWithheld, priority: PriorityP2), place: NodeRowFlat, density: NodeRowDensityTable }))
  let unknown = html(node: node_row(input: NodeRow { node: fx_node(slug: "fx-un", status: NodeStatusUnavailable { reason: "no authority establishes a status" }, priority: PriorityP2), place: NodeRowFlat, density: NodeRowDensityTable }))
  has(s: accepted, pattern: "<span class=\"el-status-chip\" data-status-form=\"filled\">Accepted</span>") && has(s: accepted, pattern: "data-node-state=\"closed\"")
    && has(s: withheld, pattern: "<span class=\"el-status-chip\" data-status-form=\"quiet\">Withheld</span>") && has(s: withheld, pattern: "data-node-state=\"open\"")
    && !has(s: accepted, pattern: "unavailable") && !has(s: withheld, pattern: "unavailable")
    && has(s: unknown, pattern: "Status unavailable")
}
