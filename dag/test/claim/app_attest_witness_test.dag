module test.claim.app_attest_witness_test

import std.logic { Bool }
import std.types { NonEmptyStr, Int, List }
import extdeps.apple.app_attest {
  AttestKeyId, AppIdPrefix, AppAttestDevelopment, AppAttestProduction, AppAttestEnvironment, AppAttestTrustAnchor,
  AttestationVerification, AttestationVerified, AttestationRefused,
  AttestationChainUntrusted, AttestationNonceMismatch, AttestationKeyIdMismatch,
  AttestationAppIdMismatch, AttestationEnvironmentUnexpected, AttestationUndecodable,
  AttestationValidationCategoryAbsent, AttestationValidationCategoryRefused,
  AssertionVerification, AssertionVerified, AssertionRefused,
  AssertionSignatureInvalid, AssertionAppIdMismatch, AssertionCounterNotIncreasing,
  app_attest_verify, app_attest_verify_under, app_attest_verify_assertion_of,
}

// ── A GENUINE DEVICE ATTESTATION ─────────────────────────────────────────────────────────────
// Apple publishes no fixture. These are real objects produced by DCAppAttestService on an iPhone
// running iOS 14.4 on 2021-01-23 (development environment), published under Apache-2.0 by
// github.com/veehaitch/devicecheck-appattest, src/test/resources/ios-14.4.yaml. Its chain verifies to
// the pinned Apple root (independently: `openssl verify -attime 1611404013` -> OK). The credential
// certificate lived three days, so validity is judged at the capture time, 1611404013.
//
// It PREDATES Apple's steps 9 and 10: its authenticator data carries no extensions (flags 0x40), so
// under the current procedure it is refused at step 9. Because the steps run in Apple's order, that
// refusal is itself the evidence that steps 1-8 all passed on a genuine device object, and each
// earlier refusal below is a genuine object failing exactly one earlier step. A genuine object that
// passes all ten steps needs a current device and lands with the iOS client
// (gunbc.auth.approval_device_redemption ios_realization_frontier).
data genuine_attestation: NonEmptyStr = ""
data genuine_assertion: NonEmptyStr = "omlzaWduYXR1cmVYRjBEAiBJ6BT/QR689UKy84YyN3RDydYD9KVQ2BTRK+x1i8ezqAIgGM7BsZbSuF6TjmK6xtOFekyVyjf8akGvp5qFRGm9LTxxYXV0aGVudGljYXRvckRhdGFYJUVlEup+JpR2q5Pht5cWhVkv9z+JSsDsL9VICKCL+2yPQAAAAAE="
data genuine_key_id: AttestKeyId = "YmbJO4x5nEHUvncp9zdWuVZjNBEMgJn3cdSToAXQe3M=" as AttestKeyId
data genuine_client_data: NonEmptyStr = "wurzelpfropf"
data genuine_prefix: AppIdPrefix = "6MURL8TA57" as AppIdPrefix
data genuine_bundle_id: NonEmptyStr = "de.vincent-haupert.apple-appattest-poc"
data captured_at: Int = 1611404013
data development_categories: List<Int> = [2, 3]

fn genuine(client_data: NonEmptyStr, key_id: AttestKeyId, bundle_id: NonEmptyStr, environment: AppAttestEnvironment, now: Int) -> AttestationVerification {
  app_attest_verify(prefix: genuine_prefix, bundle_id: bundle_id, environment: environment, admitted_categories: development_categories, attestation_b64: genuine_attestation, client_data: client_data, key_id: key_id, now_epoch: now)
}

test fn the_genuine_attestation_passes_steps_one_to_eight_and_stops_at_the_absent_category() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now: captured_at) {
    AttestationRefused { cause: AttestationValidationCategoryAbsent } => true
    _ => false
  }
}

test fn the_wrong_app_id_is_refused_at_the_rp_id_hash() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: "de.vincent-haupert.other", environment: AppAttestDevelopment, now: captured_at) {
    AttestationRefused { cause: AttestationAppIdMismatch { expected_app_id } } => expected_app_id as String == "6MURL8TA57.de.vincent-haupert.other"
    _ => false
  }
}

test fn different_client_data_is_a_nonce_mismatch() -> Bool {
  match genuine(client_data: "wurzelpfropg", key_id: genuine_key_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now: captured_at) {
    AttestationRefused { cause: AttestationNonceMismatch } => true
    _ => false
  }
}

test fn the_wrong_key_id_is_refused() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: "AAAAO4x5nEHUvncp9zdWuVZjNBEMgJn3cdSToAXQe3M=" as AttestKeyId, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now: captured_at) {
    AttestationRefused { cause: AttestationKeyIdMismatch { declared: _ } } => true
    _ => false
  }
}

test fn a_development_attestation_is_refused_where_production_is_required() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, environment: AppAttestProduction, now: captured_at) {
    AttestationRefused { cause: AttestationEnvironmentUnexpected { expected: _ } } => true
    _ => false
  }
}

test fn the_genuine_attestation_is_refused_after_its_certificate_expires() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now: 1790000000) {
    AttestationRefused { cause: AttestationChainUntrusted { detail: _ } } => true
    _ => false
  }
}

test fn an_attestation_that_is_not_base64_is_undecodable() -> Bool {
  match app_attest_verify(prefix: genuine_prefix, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, admitted_categories: development_categories, attestation_b64: "not base64!", client_data: genuine_client_data, key_id: genuine_key_id, now_epoch: captured_at) {
    AttestationRefused { cause: AttestationUndecodable { cause: _ } } => true
    _ => false
  }
}

// ── The genuine assertion ────────────────────────────────────────────────────────────────────
// Captured three seconds after the attestation, from the same key and over the same client data;
// its counter is 1. The attested key is SUPPLIED here as the value the attestation certified (the
// credential certificate's public key, cross-checked by SHA-256 against the key id); the route that
// produces it is exercised by the_forged_chain_verifies_under_its_own_test_root.
data genuine_point: NonEmptyStr = "BIjANKGQqn28WgYVAcZUKAOUJYIZiz8cxUZzyjua0gtBUoJnpU9f26BGn6-0a7aZCjlr8E-UpJ1DIMgcerJAo5g"

fn assert_genuine(stored: Int?, client_data: NonEmptyStr, bundle_id: NonEmptyStr) -> AssertionVerification {
  app_attest_verify_assertion_of(prefix: genuine_prefix, bundle_id: bundle_id, key_id: genuine_key_id, public_key_point_b64url: genuine_point, stored_counter: stored, assertion_b64: genuine_assertion, client_data: client_data)
}

test fn the_genuine_assertion_verifies_under_the_attested_key_with_no_stored_counter() -> Bool {
  match assert_genuine(stored: none, client_data: genuine_client_data, bundle_id: genuine_bundle_id) {
    AssertionVerified { verified } => verified.key_id == genuine_key_id && verified.counter == 1 && verified.client_data == genuine_client_data
    AssertionRefused { cause: _ } => false
  }
}

test fn the_genuine_assertion_verifies_above_a_lower_stored_counter() -> Bool {
  match assert_genuine(stored: Present { value: 0 }, client_data: genuine_client_data, bundle_id: genuine_bundle_id) {
    AssertionVerified { verified } => verified.counter == 1
    AssertionRefused { cause: _ } => false
  }
}

// The same assertion presented again after the server stored counter 1: a replay.
test fn a_replayed_assertion_is_refused_by_the_counter() -> Bool {
  match assert_genuine(stored: Present { value: 1 }, client_data: genuine_client_data, bundle_id: genuine_bundle_id) {
    AssertionRefused { cause: AssertionCounterNotIncreasing { stored, presented } } => stored == 1 && presented == 1
    _ => false
  }
}

test fn an_assertion_over_different_client_data_is_invalid() -> Bool {
  match assert_genuine(stored: none, client_data: "wurzelpfropg", bundle_id: genuine_bundle_id) {
    AssertionRefused { cause: AssertionSignatureInvalid } => true
    _ => false
  }
}

test fn an_assertion_for_the_wrong_app_id_is_refused() -> Bool {
  match assert_genuine(stored: none, client_data: genuine_client_data, bundle_id: "de.vincent-haupert.other") {
    AssertionRefused { cause: AssertionAppIdMismatch { expected_app_id: _ } } => true
    _ => false
  }
}

// ── A TEST-ROOT CHAIN: the ten-step accept, category policy, and ROOT PINNING ────────────────
// Built in this repository: a P-384 test root -> P-384 intermediate -> P-256 credential (openssl),
// authenticator data with a COSE key and the extensions {apple_validation_category_01: 3,
// apple_bundle_version_01: "1.0"} (flags 0xC0), a receipt, and a hand-encoded CBOR map, for the
// genuine fixture's App ID and client data "forged". x5c carries the test root itself as its third
// element. Under its own anchor it passes all ten steps; under the pinned Apple root it is refused,
// the x5c root notwithstanding.
data forged_attestation: NonEmptyStr = ""
data forged_key_id: AttestKeyId = "AxWx3+EEZnYK4GXgWH2SusvPdnnXn3jn3oolnVpbd+0=" as AttestKeyId
data forged_now: Int = 1790000000
data test_root: AppAttestTrustAnchor = AppAttestTrustAnchor {
  root_pem: "-----BEGIN CERTIFICATE-----\nMIICHTCCAaKgAwIBAgIUXywxeFKcvzUHUeEZ8SPpDw2UeIMwCgYIKoZIzj0EAwMw\nPDElMCMGA1UEAwwcVGVzdCBBcHAgQXR0ZXN0YXRpb24gUm9vdCBDQTETMBEGA1UE\nCgwKZ3VuYmMgdGVzdDAgFw0yNjA5MTgwNjU4MDBaGA8yMTI2MDgyNTA2NTgwMFow\nPDElMCMGA1UEAwwcVGVzdCBBcHAgQXR0ZXN0YXRpb24gUm9vdCBDQTETMBEGA1UE\nCgwKZ3VuYmMgdGVzdDB2MBAGByqGSM49AgEGBSuBBAAiA2IABDozjM/UMa4nLWc+\n0H+GPsJbWH9D395PCEW3ghK99L1zcUDBwiD/7BeJUkRHf59mtZ9nSI8KrFfEsQlc\nW6S+0eqKJreCJrRCc+pI8NseKJCiEr/UJHGe2ZGUIl5bkbradqNjMGEwHQYDVR0O\nBBYEFBji7l7Z2FYJinAIYCMIu/EAAPDYMB8GA1UdIwQYMBaAFBji7l7Z2FYJinAI\nYCMIu/EAAPDYMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgIEMAoGCCqG\nSM49BAMDA2kAMGYCMQDBk1aptnKz0ZxMQaXMEyL7dvT3aUV0hmxVo/UrcFy8afJ2\nMlCGIRa39790MbEIcckCMQCtYHlG8LdR2byQVklL/YQvVNaqu8ko7gZGZAe9JSis\nphtXsgtFOWBbzM8iTHmRjuM=\n-----END CERTIFICATE-----\n",
}

fn forged_under(anchor: AppAttestTrustAnchor, admitted: List<Int>) -> AttestationVerification {
  app_attest_verify_under(anchor: anchor, prefix: genuine_prefix, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, admitted_categories: admitted, attestation_b64: forged_attestation, client_data: "forged", key_id: forged_key_id, now_epoch: forged_now)
}

test fn the_forged_chain_verifies_under_its_own_test_root() -> Bool {
  match forged_under(anchor: test_root, admitted: development_categories) {
    AttestationVerified { verified } =>
      verified.key_id == forged_key_id
        && verified.public_key_point_b64url as String == "BFIuggVA-y3RU_usJbYfvChlz-Mpq7yvbf0d60JkajVGfprBR8p3eq6QzcDEBZGY2BoW6a-aFMjRjmGipHdFPss"
        && verified.receipt_b64 as String == "Z3VuYmMgdGVzdCByZWNlaXB0"
        && verified.client_data as String == "forged"
    AttestationRefused { cause: _ } => false
  }
}

// Category 3 (development signing) presented to a policy that admits only App Store (4).
test fn a_category_outside_the_admitted_set_is_refused() -> Bool {
  match forged_under(anchor: test_root, admitted: [4]) {
    AttestationRefused { cause: AttestationValidationCategoryRefused { category } } => category == 3
    _ => false
  }
}

test fn the_forged_chain_is_refused_under_the_pinned_apple_root() -> Bool {
  match app_attest_verify(prefix: genuine_prefix, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, admitted_categories: development_categories, attestation_b64: forged_attestation, client_data: "forged", key_id: forged_key_id, now_epoch: forged_now) {
    AttestationRefused { cause: AttestationChainUntrusted { detail } } => detail.contains("Apple App Attestation Root CA")
    _ => false
  }
}
