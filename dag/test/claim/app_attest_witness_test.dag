module test.claim.app_attest_witness_test

import std.logic { Bool }
import std.types { NonEmptyStr }
import extdeps.apple.app_attest {
  AttestKeyId, AppAttestDevelopment, AppAttestProduction, AppAttestTrustAnchor,
  AttestationVerification, AttestationVerified, AttestationRefused,
  AttestationChainUntrusted, AttestationNonceMismatch, AttestationKeyIdMismatch,
  AttestationAppIdMismatch, AttestationEnvironmentUnexpected, AttestationUndecodable,
  AssertionVerification, AssertionVerified, AssertionRefused,
  AssertionSignatureInvalid, AssertionAppIdMismatch, AssertionCounterNotIncreasing,
  app_attest_verify, app_attest_verify_under, app_attest_verify_assertion_of,
}
import extdeps.crypto.signature { VerifyingKey }

// ── A GENUINE DEVICE ATTESTATION ─────────────────────────────────────────────────────────────
// Apple publishes no fixture. These are real objects produced by DCAppAttestService on an iPhone
// running iOS 14.4 on 2021-01-23 (development environment), published under Apache-2.0 by
// github.com/veehaitch/devicecheck-appattest, src/test/resources/ios-14.4.yaml. Its chain verifies to
// the pinned Apple root (independently: `openssl verify -attime 1611404013` -> OK). The credential
// certificate lived three days, so every witness judges validity at the capture time, 1611404013
// (2021-01-23T12:13:33Z); the same object at today's clock is refused as expired, which is witnessed
// too.
data genuine_attestation: NonEmptyStr = ""
data genuine_assertion: NonEmptyStr = "omlzaWduYXR1cmVYRjBEAiBJ6BT/QR689UKy84YyN3RDydYD9KVQ2BTRK+x1i8ezqAIgGM7BsZbSuF6TjmK6xtOFekyVyjf8akGvp5qFRGm9LTxxYXV0aGVudGljYXRvckRhdGFYJUVlEup+JpR2q5Pht5cWhVkv9z+JSsDsL9VICKCL+2yPQAAAAAE="
data genuine_key_id: AttestKeyId = "YmbJO4x5nEHUvncp9zdWuVZjNBEMgJn3cdSToAXQe3M=" as AttestKeyId
data genuine_client_data: NonEmptyStr = "wurzelpfropf"
data genuine_team_id: NonEmptyStr = "6MURL8TA57"
data genuine_bundle_id: NonEmptyStr = "de.vincent-haupert.apple-appattest-poc"
data captured_at: Int = 1611404013

fn genuine(client_data: NonEmptyStr, key_id: AttestKeyId, bundle_id: NonEmptyStr, production: Bool, now: Int) -> AttestationVerification {
  app_attest_verify(
    attestation_b64: genuine_attestation,
    client_data: client_data,
    key_id: key_id,
    team_id: genuine_team_id,
    bundle_id: bundle_id,
    environment: if production { AppAttestProduction } else { AppAttestDevelopment },
    now_epoch: now,
  )
}

test fn the_genuine_attestation_verifies_to_the_pinned_apple_root() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, production: false, now: captured_at) {
    AttestationVerified { key_id, public_key, client_data_hash_hex, environment: _ } =>
      key_id == genuine_key_id
        && client_data_hash_hex as String == "8be65cca515ad097c953967d18d635d86dd78a142ed3d077526bed11c6bec67b"
        && public_key.point_b64url as String == "BIjANKGQqn28WgYVAcZUKAOUJYIZiz8cxUZzyjua0gtBUoJnpU9f26BGn6-0a7aZCjlr8E-UpJ1DIMgcerJAo5g"
    AttestationRefused { cause: _ } => false
  }
}

test fn the_wrong_app_id_is_refused_at_the_rp_id_hash() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: "de.vincent-haupert.other", production: false, now: captured_at) {
    AttestationRefused { cause: AttestationAppIdMismatch { expected_app_id } } => expected_app_id as String == "6MURL8TA57.de.vincent-haupert.other"
    _ => false
  }
}

// One character of the client data changed: the nonce the certificate carries no longer matches.
test fn different_client_data_is_a_nonce_mismatch() -> Bool {
  match genuine(client_data: "wurzelpfropg", key_id: genuine_key_id, bundle_id: genuine_bundle_id, production: false, now: captured_at) {
    AttestationRefused { cause: AttestationNonceMismatch } => true
    _ => false
  }
}

test fn the_wrong_key_id_is_refused() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: "AAAAO4x5nEHUvncp9zdWuVZjNBEMgJn3cdSToAXQe3M=" as AttestKeyId, bundle_id: genuine_bundle_id, production: false, now: captured_at) {
    AttestationRefused { cause: AttestationKeyIdMismatch { declared: _ } } => true
    _ => false
  }
}

// A development attestation presented where production is required.
test fn the_wrong_environment_is_refused() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, production: true, now: captured_at) {
    AttestationRefused { cause: AttestationEnvironmentUnexpected { expected: _ } } => true
    _ => false
  }
}

// The same genuine object judged at 2026-09-18: the three-day credential certificate has expired.
test fn the_genuine_attestation_is_refused_after_its_certificate_expires() -> Bool {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, production: false, now: 1789714800) {
    AttestationRefused { cause: AttestationChainUntrusted { detail: _ } } => true
    _ => false
  }
}

test fn an_attestation_that_is_not_base64_is_undecodable() -> Bool {
  match app_attest_verify(attestation_b64: "not base64!", client_data: genuine_client_data, key_id: genuine_key_id, team_id: genuine_team_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now_epoch: captured_at) {
    AttestationRefused { cause: AttestationUndecodable { cause: _ } } => true
    _ => false
  }
}

// ── The genuine assertion, and counter monotonicity ──────────────────────────────────────────
// Captured three seconds after the attestation, from the same key, over the same client data;
// its authenticator counter is 1.
fn genuine_key() -> VerifyingKey? {
  match genuine(client_data: genuine_client_data, key_id: genuine_key_id, bundle_id: genuine_bundle_id, production: false, now: captured_at) {
    AttestationVerified { key_id: _, public_key, client_data_hash_hex: _, environment: _ } => Present { value: public_key }
    AttestationRefused { cause: _ } => none
  }
}

fn assert_genuine(previous: Int, client_data: NonEmptyStr, bundle_id: NonEmptyStr) -> AssertionVerification? {
  match genuine_key() {
    Absent => none
    Present { value: k } => Present { value: app_attest_verify_assertion_of(
      key_id: genuine_key_id, public_key: k, previous_counter: previous,
      assertion_b64: genuine_assertion, client_data: client_data,
      team_id: genuine_team_id, bundle_id: bundle_id,
    ) }
  }
}

test fn the_genuine_assertion_verifies_under_the_attested_key_and_advances_the_counter() -> Bool {
  match assert_genuine(previous: 0, client_data: genuine_client_data, bundle_id: genuine_bundle_id) {
    Present { value: AssertionVerified { key_id, counter } } => key_id == genuine_key_id && counter == 1
    _ => false
  }
}

// The same assertion presented again after the server stored counter 1: a replay.
test fn a_replayed_assertion_is_refused_by_the_counter() -> Bool {
  match assert_genuine(previous: 1, client_data: genuine_client_data, bundle_id: genuine_bundle_id) {
    Present { value: AssertionRefused { cause: AssertionCounterNotIncreasing { counter, previous_counter } } } => counter == 1 && previous_counter == 1
    _ => false
  }
}

// The signature covers the client data: a different request body does not verify.
test fn an_assertion_over_different_client_data_is_invalid() -> Bool {
  match assert_genuine(previous: 0, client_data: "wurzelpfropg", bundle_id: genuine_bundle_id) {
    Present { value: AssertionRefused { cause: AssertionSignatureInvalid } } => true
    _ => false
  }
}

test fn an_assertion_for_the_wrong_app_id_is_refused() -> Bool {
  match assert_genuine(previous: 0, client_data: genuine_client_data, bundle_id: "de.vincent-haupert.other") {
    Present { value: AssertionRefused { cause: AssertionAppIdMismatch { expected_app_id: _ } } } => true
    _ => false
  }
}

// ── ROOT PINNING ─────────────────────────────────────────────────────────────────────────────
// A forged attestation built in this repository from a TEST root (P-384 root -> P-384 intermediate
// -> P-256 credential, openssl + a hand-encoded CBOR map, for the genuine fixture's app id and client
// data "forged"). Every step other than the anchor is correct, and x5c carries the test root itself
// as its third element. Under its own anchor it verifies -- so the refusal below is the pin, not some
// other step -- and under the pinned Apple root it is refused, the x5c root notwithstanding.
data forged_attestation: NonEmptyStr = ""
data forged_key_id: AttestKeyId = "AxWx3+EEZnYK4GXgWH2SusvPdnnXn3jn3oolnVpbd+0=" as AttestKeyId
data test_root: AppAttestTrustAnchor = AppAttestTrustAnchor {
  root_pem: "-----BEGIN CERTIFICATE-----\nMIICHTCCAaKgAwIBAgIUXywxeFKcvzUHUeEZ8SPpDw2UeIMwCgYIKoZIzj0EAwMw\nPDElMCMGA1UEAwwcVGVzdCBBcHAgQXR0ZXN0YXRpb24gUm9vdCBDQTETMBEGA1UE\nCgwKZ3VuYmMgdGVzdDAgFw0yNjA5MTgwNjU4MDBaGA8yMTI2MDgyNTA2NTgwMFow\nPDElMCMGA1UEAwwcVGVzdCBBcHAgQXR0ZXN0YXRpb24gUm9vdCBDQTETMBEGA1UE\nCgwKZ3VuYmMgdGVzdDB2MBAGByqGSM49AgEGBSuBBAAiA2IABDozjM/UMa4nLWc+\n0H+GPsJbWH9D395PCEW3ghK99L1zcUDBwiD/7BeJUkRHf59mtZ9nSI8KrFfEsQlc\nW6S+0eqKJreCJrRCc+pI8NseKJCiEr/UJHGe2ZGUIl5bkbradqNjMGEwHQYDVR0O\nBBYEFBji7l7Z2FYJinAIYCMIu/EAAPDYMB8GA1UdIwQYMBaAFBji7l7Z2FYJinAI\nYCMIu/EAAPDYMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgIEMAoGCCqG\nSM49BAMDA2kAMGYCMQDBk1aptnKz0ZxMQaXMEyL7dvT3aUV0hmxVo/UrcFy8afJ2\nMlCGIRa39790MbEIcckCMQCtYHlG8LdR2byQVklL/YQvVNaqu8ko7gZGZAe9JSis\nphtXsgtFOWBbzM8iTHmRjuM=\n-----END CERTIFICATE-----\n",
}

test fn the_forged_chain_verifies_under_its_own_test_root() -> Bool {
  match app_attest_verify_under(anchor: test_root, attestation_b64: forged_attestation, client_data: "forged", key_id: forged_key_id, team_id: genuine_team_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now_epoch: 1789714800) {
    AttestationVerified { key_id, public_key: _, client_data_hash_hex: _, environment: _ } => key_id == forged_key_id
    AttestationRefused { cause: _ } => false
  }
}

test fn the_forged_chain_is_refused_under_the_pinned_apple_root() -> Bool {
  match app_attest_verify(attestation_b64: forged_attestation, client_data: "forged", key_id: forged_key_id, team_id: genuine_team_id, bundle_id: genuine_bundle_id, environment: AppAttestDevelopment, now_epoch: 1789714800) {
    AttestationRefused { cause: AttestationChainUntrusted { detail } } => detail.contains("Apple App Attestation Root CA")
    _ => false
  }
}
