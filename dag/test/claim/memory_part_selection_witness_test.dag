module test.claim.memory_part_selection_witness_test


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data stick_32g: std.measure.ByteSize = byte_size(count: 34359738368)

// The family observed failing MREP on this board: load-reduced, so it must
// execute the data-buffer step.
data lrdimm_32g: extdeps.memory.types.DramModuleCatalogRow = extdeps.memory.types.DramModuleCatalogRow {
  part_number: "M386A4G40DM0-CPB",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_32g,
  data_rate_mts: 2133,
  ecc: true,
  buffering: LoadReduced,
  chip_width: bit_width(count: 4),
  rank_count: 4,
}

// Same capacity, same vendor, same generation — registered rather than load
// reduced. The ONLY axis that differs is the one the rule reads.
data rdimm_32g: extdeps.memory.types.DramModuleCatalogRow = extdeps.memory.types.DramModuleCatalogRow {
  part_number: "M393A4K40DB2-CTD",
  manufacturer: samsung,
  generation: dram_generation_ddr4,
  capacity_bytes: stick_32g,
  data_rate_mts: 2666,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 4),
  rank_count: 2,
}

data observed_failures: List<gunbc.memory_part_selection.PlatformTrainingFailure> = [altrad8ud_mrep_failure_observation]

// The same failure at DECODED standing. Only the evidence differs, which is
// what makes the severity comparison below discriminating.
data decoded_failure: gunbc.memory_part_selection.PlatformTrainingFailure = gunbc.memory_part_selection.PlatformTrainingFailure {
  board: AsrockRackAltrad8ud1l2t,
  step: LrdimmDataBufferMrep,
  standing: gunbc.memory_part_selection.DecodedFromPlatformSyndrome { register: "B5" },
  observed_population: ["A1"],
  observed_at: 1786590000000,
}

// The same failure with NO evidence behind it.
data unobserved_failure: gunbc.memory_part_selection.PlatformTrainingFailure = gunbc.memory_part_selection.PlatformTrainingFailure {
  board: AsrockRackAltrad8ud1l2t,
  step: LrdimmDataBufferMrep,
  standing: EvidenceUnobserved,
  observed_population: ["A1"],
  observed_at: 1786590000000,
}

// PRICE IS A PARAMETER because the Pareto axes are real. An earlier revision
// gave both fixtures the same price and capacity, leaving data rate as the
// only difference — so the registered module strictly DOMINATED the
// load-reduced one and the frontier legitimately dropped it. The test then
// read that dominance as an admission failure. Admitted and undominated are
// different properties, and a fixture pair that differs on exactly one axis
// cannot distinguish them.
//
// The prices below also match the market fact this module models: at
// capacities near the density ceiling the load-reduced part is the CHEAP one.
// So neither candidate dominates — cheaper-but-slower against
// faster-but-dearer — and frontier membership is decided by admission alone.
fn candidate_at_price(
  module: extdeps.memory.types.DramModuleCatalogRow,
  currency: std.currency.CurrencyCode,
  unit_price: std.measure.MoneyAmountMicro,
) -> gunbc.memory_part_selection.PartCandidate {
  gunbc.memory_part_selection.PartCandidate {
    module: module,
    unit_price: unit_price,
    currency: currency,
    sticks_required: 8,
    qualification: PartQualificationUnobserved,
  }
}

fn cheap_lrdimm_candidate(currency: std.currency.CurrencyCode) -> gunbc.memory_part_selection.PartCandidate {
  candidate_at_price(
    module: lrdimm_32g,
    currency: currency,
    unit_price: money_amount_micro(count: 60000000),
  )
}

fn dearer_rdimm_candidate(currency: std.currency.CurrencyCode) -> gunbc.memory_part_selection.PartCandidate {
  candidate_at_price(
    module: rdimm_32g,
    currency: currency,
    unit_price: money_amount_micro(count: 100000000),
  )
}

fn candidate_of(
  module: extdeps.memory.types.DramModuleCatalogRow,
  currency: std.currency.CurrencyCode,
) -> gunbc.memory_part_selection.PartCandidate {
  candidate_at_price(
    module: module,
    currency: currency,
    unit_price: money_amount_micro(count: 100000000),
  )
}

// WHAT AN ASSOCIATION LICENSES. gunbc holds MREP at
// AssociatedByIdenticalSignature, so another load-reduced module is a
// buy-one-and-test candidate — NOT a refusal. An earlier revision answered
// PartImplicatedByFailingStep here, which is how a single association
// removed most of the 64GB DDR4 market by construction.
test fn an_association_requires_a_sample_rather_than_refusing() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: observed_failures,
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartSampleQualificationRequired { step: _, standing: _ } => true
    PartImplicatedByFailingStep { step: _, standing: _ } => false
    PartNotImplicated => false
  }
}

// The severity is a function of EVIDENCE, not of the step. Same board, same
// step, same module — decoded from this platform's own syndrome register, so
// the refusal is earned.
test fn a_decoded_syndrome_does_refuse() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: [decoded_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartImplicatedByFailingStep { step: _, standing: _ } => true
    _ => false
  }
}

// FAIL-OPEN CONTROL IN THE OTHER DIRECTION: an unevidenced row must not
// implicate anything at all. Refusing on EvidenceUnobserved would let a row
// nobody measured remove parts from the market.
test fn an_unobserved_standing_implicates_nothing() -> Bool {
  match part_implication(
    candidate: lrdimm_32g,
    failures: [unobserved_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartNotImplicated => true
    _ => false
  }
}

// RED control on the structural axis: an otherwise identical registered module
// has no data buffer, cannot execute MREP, and is untouched at ANY standing.
test fn registered_module_is_untouched_even_by_a_decoded_failure() -> Bool {
  match part_implication(
    candidate: rdimm_32g,
    failures: [decoded_failure],
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    PartNotImplicated => true
    _ => false
  }
}

test fn only_the_load_reduced_module_executes_mrep() -> Bool {
  module_executes_step(module: lrdimm_32g, step: LrdimmDataBufferMrep)
    && !module_executes_step(module: rdimm_32g, step: LrdimmDataBufferMrep)
}

// A candidate priced in a currency other than the declared one is REFUSED with
// a typed cause, never silently ranked against it.
test fn cross_currency_candidate_is_refused_not_ranked() -> Bool {
  match candidate_admission(
    candidate: candidate_of(module: rdimm_32g, currency: Eur),
    failures: observed_failures,
    declared_currency: Usd,
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    CandidateCurrencyMismatch { declared: _, candidate_currency: _ } => true
    _ => false
  }
}

test fn same_candidate_in_declared_currency_is_admissible() -> Bool {
  match candidate_admission(
    candidate: candidate_of(module: rdimm_32g, currency: Usd),
    failures: observed_failures,
    declared_currency: Usd,
    target_board: AsrockRackAltrad8ud1l2t,
  ) {
    CandidateAdmissible => true
    _ => false
  }
}

// THE MARKET IS NOT SHRUNK BY AN ASSOCIATION. Both candidates stay on the
// frontier under the evidence gunbc actually holds; the load-reduced one is
// flagged sample-required rather than dropped.
test fn an_association_leaves_both_candidates_on_the_frontier() -> Bool {
  let front = pareto_frontier(
    candidates: [
      cheap_lrdimm_candidate(currency: Usd),
      dearer_rdimm_candidate(currency: Usd),
    ],
    failures: observed_failures,
    declared_currency: Usd,
    target_board: AsrockRackAltrad8ud1l2t,
  )
  list_length(front) == 2
    && match candidate_admission(
      candidate: cheap_lrdimm_candidate(currency: Usd),
      failures: observed_failures,
      declared_currency: Usd,
      target_board: AsrockRackAltrad8ud1l2t,
    ) {
      CandidateSampleRequired { step: _, standing: _ } => true
      _ => false
    }
}

// Positive control that the frontier CAN still drop a part: at decoded
// standing the load-reduced candidate is refused before ranking.
test fn a_decoded_refusal_does_drop_the_candidate_from_the_frontier() -> Bool {
  let front = pareto_frontier(
    candidates: [
      cheap_lrdimm_candidate(currency: Usd),
      dearer_rdimm_candidate(currency: Usd),
    ],
    failures: [decoded_failure],
    declared_currency: Usd,
    target_board: AsrockRackAltrad8ud1l2t,
  )
  list_length(front) == 1
    && match candidate_admission(
      candidate: cheap_lrdimm_candidate(currency: Usd),
      failures: [decoded_failure],
      declared_currency: Usd,
      target_board: AsrockRackAltrad8ud1l2t,
    ) {
      CandidateImplicated { step: _, standing: _ } => true
      _ => false
    }
}
