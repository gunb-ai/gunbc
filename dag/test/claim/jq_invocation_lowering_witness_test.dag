module test.claim.jq_invocation_lowering_witness

import std.algebra { Cons, Empty }
import std.types { Bool, String }
import v2.std.algebra { fold_list, list_snoc_item }
import v2.std.collection { List }
import v2.std.compilers.cli_surface { cli_argument_text, cli_surface_arguments }
import v2.std.diagnostic { Accepted, Rejected }
import extdeps.tools.jq {
  JqInputFile,
  JqInputStdin,
  JqInvocation,
  JqJsonBinding,
  JqBindingName,
  JqLastResultExit,
  JqProgram,
  JqProgramExit,
  JqRawOutput,
  JqBindingLoweringUnwired,
  JqFileInputLoweringUnwired,
  JqLowered,
  JqLoweringRefused,
  JqOutcome,
  JqExitPolicy,
  JqOutputAbsent,
  JqOutputPresent,
  JqExecutionRefused,
  JqProcessObservation,
  jq_classify_observation,
  jq_invocation_process_plan,
  jq_admitted_plan_input,
  JqProcessStdin,
  JqProcessNoStdin,
  jq_admitted_plan_surface,
  jq_invocation_cli_arguments,
  jq_invocation_lower,
  jq_invocation_process_plan,
  jq_lowering_refusal_identity
}

// WAVE 1B, LANDED. The semantic invocation the OpenBMC sensor projection makes, lowered to argv.
// Not "will make": openbmc.JsonProjection.SensorIntegerValue is DELETED and
// extdeps.bmc.openbmc_fan_control openbmc_sensor_integer_projection is the live consumer of this
// lowering. (The note calls the ObjectMapper site Wave 1A; it is blocked on --argjson lowering.)
// docs/plans/cli-invocation-emission-design.md
//
// The point of every assertion below is that the caller named no flag. It asked for raw output
// and for jq's ordinary exit contract; --raw-output and the ABSENCE of --exit-status are derived.

data sensor_stdin: String = "{\"data\": 41.6}"

data sensor_program: String = "if (.data | type) == \"number\" then (.data | round) else empty end"

fn sensor_invocation() -> JqInvocation {
  JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: Empty,
    input: JqInputStdin { content: sensor_stdin },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }
}

fn argv_of(invocation: JqInvocation) -> List<String> {
  match jq_invocation_cli_arguments(invocation: invocation) {
    Accepted { value: surface, diagnostics: _ } =>
      fold_list(
        xs: cli_surface_arguments(surface: surface),
        empty: Empty,
        cons: fn(acc, a) { list_snoc_item(xs: acc, item: cli_argument_text(argument: a)) }
      )
    Rejected { diagnostics: _ } => Empty
  }
}

// JqRawOutput selects the raw-output option and it renders in its CANONICAL long form, not -r.
// JqProgramExit selects NO exit-status option. The program is exactly ONE argument even though it
// contains spaces, quotes and parentheses.
test fn sensor_invocation_lowers_to_exact_argv() -> Bool {
  match argv_of(invocation: sensor_invocation()) {
    Empty => false
    Cons { head: first, tail: rest } =>
      match rest {
        Empty => false
        Cons { head: second, tail: after } =>
          match after {
            Empty => (first == "--raw-output") && (second == sensor_program)
            Cons { head: _, tail: _ } => false
          }
      }
  }
}

// THE STDIN CONTROL. The JSON payload is a process channel, not an argument: it must appear
// nowhere in argv. An argv-only model could not even state this.
test fn stdin_content_is_absent_from_argv() -> Bool {
  fold_list(
    xs: argv_of(invocation: sensor_invocation()),
    empty: true,
    cons: fn(acc, arg) { acc && (arg != sensor_stdin) }
  )
}

// PERTURBATION, LEVEL ONE: change the semantic property and the emitted vector changes. This is
// what proves the SELECTION row is authoritative rather than decorative -- a spelling-only test
// would pass even if the option could be omitted.
test fn exit_policy_perturbation_adds_the_exit_status_option() -> Bool {
  match argv_of(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: Empty,
    input: JqInputStdin { content: "{}" },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Empty => false
    Cons { head: first, tail: rest } =>
      match rest {
        Empty => false
        Cons { head: second, tail: _ } =>
          (first == "--raw-output") && (second == "--exit-status")
      }
  }
}

// The unlowered axes REFUSE rather than emitting a plausible guess.
test fn unlowered_bindings_refuse() -> Bool {
  match jq_invocation_cli_arguments(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: [JqJsonBinding { name: JqBindingName { name: "index" }, value: "3" }],
    input: JqInputStdin { content: "{}" },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn unlowered_file_input_refuses() -> Bool {
  match jq_invocation_cli_arguments(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: Empty,
    input: JqInputFile { path: "/tmp/x.json" },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}


// STDIN MUST SURVIVE, not merely stay out of argv.
//
// stdin_content_is_absent_from_argv above is a NEGATIVE control, and a negative control is
// satisfied just as well by the content being lost entirely -- which is exactly what the public
// projection used to do. These two assertions are the positive half: the content reaches the
// process plan, and it reaches it WITHOUT also appearing in the argument vector. Neither one
// alone distinguishes correct routing from total loss.
test fn stdin_survives_lowering_into_the_process_plan() -> Bool {
  match jq_invocation_process_plan(invocation: sensor_invocation()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: plan, diagnostics: _ } =>
      match jq_admitted_plan_input(plan: plan) {
        JqProcessNoStdin => false
        JqProcessStdin { content: carried } => carried == sensor_stdin
      }
  }
}

test fn stdin_reaches_the_plan_without_entering_the_argument_vector() -> Bool {
  match jq_invocation_process_plan(invocation: sensor_invocation()) {
    Rejected { diagnostics: _ } => false
    Accepted { value: plan, diagnostics: _ } =>
      fold_list(
        xs: cli_surface_arguments(surface: jq_admitted_plan_surface(plan: plan)),
        empty: true,
        cons: fn(acc, arg) { acc && (cli_argument_text(argument: arg) != sensor_stdin) }
      )
  }
}

// THE TWO UNLOWERED AXES ARE DISTINGUISHABLE. The refusal witnesses above assert only a generic
// Rejected, which one shared diagnostic identity would satisfy -- and did, while the cause was
// prose the diagnostic never read.
test fn the_two_unlowered_causes_carry_distinct_identities() -> Bool {
  jq_lowering_refusal_identity(cause: JqBindingLoweringUnwired)
    != jq_lowering_refusal_identity(cause: JqFileInputLoweringUnwired)
}

test fn unlowered_bindings_refuse_with_the_binding_cause() -> Bool {
  match jq_invocation_lower(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: [JqJsonBinding { name: JqBindingName { name: "index" }, value: "3" }],
    input: JqInputStdin { content: "{}" },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }) {
    JqLowered { plan: _ } => false
    JqLoweringRefused { cause: cause } =>
      match cause {
        JqBindingLoweringUnwired => true
        JqFileInputLoweringUnwired => false
      }
  }
}

test fn unlowered_file_input_refuses_with_the_file_cause() -> Bool {
  match jq_invocation_lower(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: Empty,
    input: JqInputFile { path: "/tmp/x.json" },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }) {
    JqLowered { plan: _ } => false
    JqLoweringRefused { cause: cause } =>
      match cause {
        JqBindingLoweringUnwired => false
        JqFileInputLoweringUnwired => true
      }
  }
}


// THE EXIT CODE MEANS DIFFERENT THINGS UNDER DIFFERENT POLICIES, and these four assertions are the
// discriminating evidence for that. Each holds ONE observation fixed and varies only the exit
// policy the plan carries. A decoder that read the exit code without the policy -- which is what
// the sensor path did before this landed -- cannot make all four true at once: it must answer
// Refused for exit 1 under both policies, and the second assertion below would go red.

type ExpectedOutcome = ExpectPresent | ExpectAbsent | ExpectRefused

fn outcome_matches(outcome: JqOutcome, expected: ExpectedOutcome) -> Bool {
  match expected {
    ExpectPresent =>
      match outcome {
        JqOutputPresent { text: _ } => true
        JqOutputAbsent => false
        JqExecutionRefused { exit_code: _, stderr: _ } => false
      }
    ExpectAbsent =>
      match outcome {
        JqOutputPresent { text: _ } => false
        JqOutputAbsent => true
        JqExecutionRefused { exit_code: _, stderr: _ } => false
      }
    ExpectRefused =>
      match outcome {
        JqOutputPresent { text: _ } => false
        JqOutputAbsent => false
        JqExecutionRefused { exit_code: _, stderr: _ } => true
      }
  }
}

// A plan that fails to lower answers FALSE rather than being replaced by a fabricated one: if the
// lowering ever refuses this invocation, these assertions must go red, not quietly test a stand-in.
fn classifies_as(
  policy: JqExitPolicy,
  observation: JqProcessObservation,
  expected: ExpectedOutcome,
) -> Bool {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: sensor_program },
    bindings: Empty,
    input: JqInputStdin { content: "{}" },
    output_encoding: JqRawOutput,
    exit_policy: policy,
  }) {
    Rejected { diagnostics: _ } => false
    Accepted { value: plan, diagnostics: _ } =>
      outcome_matches(
        outcome: jq_classify_observation(plan: plan, observation: observation),
        expected: expected,
      )
  }
}

// Exit 1 with output "false": a program-exit contract never produces it, so it is a failure.
test fn exit_one_is_a_refusal_under_program_exit() -> Bool {
  classifies_as(
    policy: JqProgramExit,
    observation: JqProcessObservation { exit_code: 1, stdout: "false", stderr: "" },
    expected: ExpectRefused,
  )
}

// The SAME observation under the last-result contract is a legitimate VALUE -- jq documents exit 1
// as "the last output was false or null", and false is a value a filter may correctly produce.
// This is the assertion a policy-blind decoder cannot satisfy while satisfying the one above.
test fn exit_one_is_a_value_under_last_result_exit() -> Bool {
  classifies_as(
    policy: JqLastResultExit,
    observation: JqProcessObservation { exit_code: 1, stdout: "false", stderr: "" },
    expected: ExpectPresent,
  )
}

// Exit 4 is jq's "no valid result was ever produced" -- absence, not breakage.
test fn exit_four_is_absence_under_last_result_exit() -> Bool {
  classifies_as(
    policy: JqLastResultExit,
    observation: JqProcessObservation { exit_code: 4, stdout: "", stderr: "" },
    expected: ExpectAbsent,
  )
}

// Exit 2 is a usage or system error and refuses under BOTH policies -- the policy changes how
// SOME codes read, not whether jq can fail.
test fn exit_two_refuses_under_both_policies() -> Bool {
  classifies_as(
    policy: JqProgramExit,
    observation: JqProcessObservation { exit_code: 2, stdout: "", stderr: "usage" },
    expected: ExpectRefused,
  )
  && classifies_as(
    policy: JqLastResultExit,
    observation: JqProcessObservation { exit_code: 2, stdout: "", stderr: "usage" },
    expected: ExpectRefused,
  )
}

// Empty output on a zero exit is absence, not an empty observation -- the sensor path's third
// state, which is the whole reason JqProgramExit must not carry --exit-status.
test fn empty_output_on_zero_exit_is_absence() -> Bool {
  classifies_as(
    policy: JqProgramExit,
    observation: JqProcessObservation { exit_code: 0, stdout: "   ", stderr: "" },
    expected: ExpectAbsent,
  )
}
