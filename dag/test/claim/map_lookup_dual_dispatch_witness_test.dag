module test.claim.map_lookup_dual_dispatch_witness_test

import std.graph { CallGraph, GraphEdge, build_adjacency_views }
import std.logic { Bool }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn map_get_method_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("a", 10)
  (m |> get("a")) == 10
}

test fn map_index_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("b", 42)
  m["b"] == 42
}

test fn lookup_builtin_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("k", 7)
  lookup(m, "k") == 7
}

test fn std_graph_build_adjacency_views_evaluates() -> Bool {
  let names = ["a", "b"]
  let graph = CallGraph { edges: [GraphEdge { caller: "a", callee: "b" }] }
  let views = build_adjacency_views(names: names, graph: graph)
  match map_get(views.forward, "a") {
    Present { value: ns } => ns == ["b"]
    Absent => false
  }
}
