module test.claim.map_lookup_dual_dispatch_witness_test


data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn map_get_method_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("a", 10)
  (m |> get("a")) == 10
}

test fn map_index_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("b", 42)
  m["b"] == 42
}

test fn lookup_builtin_routes_through_dual_dispatch_chokepoint() -> Bool {
  let m = empty_map() |> map_insert("k", 7)
  match lookup(m, "k") {
    Present { value: v } => v == 7
    Absent => false
  }
}

data lookup_witness_contract_note: String = "lookup routes through the dual-dispatch chokepoint, which wraps the hit in the Optional coproduct (Present { value } | Absent) — the v1_rt Witness<V> carrier was deleted (v1_rt-witness-diagnostic-carrier-decouple-design.md); lookup now returns Option<V> natively. Matching Present is still the discriminating form — a raw 7 here would mean the bare builtin BYPASSED the chokepoint, and Present/Absent proves the modeled dispatch runs."

test fn std_graph_build_adjacency_views_evaluates() -> Bool {
  let names = ["a", "b"]
  let graph = CallGraph { edges: [GraphEdge { caller: "a", callee: "b" }] }
  let views = build_adjacency_views(names: names, graph: graph)
  match map_get(views.forward, "a") {
    Present { value: ns } => ns == ["b"]
    Absent => false
  }
}
