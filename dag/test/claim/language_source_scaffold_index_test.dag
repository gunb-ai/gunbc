module test.claim.language_source_scaffold_index_test

import std.types { Bool, String, Int }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.language_source_scaffold_index {
  LanguageSourceScaffoldRow,
  language_source_scaffold_roster,
  language_source_scaffold_roster_size,
  language_source_scaffold_roster_all_dispositioned,
  language_source_scaffold_row_is_dispositioned,
  rust_pair_completion_spelling_scaffold_trigger
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data language_source_scaffold_index_test_note: String = "B2/B4/B5 control for the language-source scaffold inventory. Two distinct obligations are asserted separately. (1) DISPOSITION: every rostered blob carries a Disposition that names something — a Scaffold binding the construction that subsumes it, or a Terminal stating why it is irreducible. Because Disposition has no prose arm, an unmarked row is unwritable, so the discriminating case is a mark that names NOTHING: the RED control is a Scaffold with an empty bind. A Terminal WITH a reason is legitimate (fnv1a64 is a named irreducible kernel), so the control is deliberately not 'Terminal is bad'. (2) COVERAGE: the roster must actually cover its carriers. Asserting hardcoded census counts alone would let a new rt_/ct_ blob land unmarked and stay green until someone bumped the number by hand (review 43161), so coverage is read from the LIVE TREE: the rt_ and ct_ declaration counts in the carrier sources are compared against the roster, and a newly added blob reds this witness instead of sitting unrostered. The comparison is EXACT equality with no offset: an earlier version used declared == rostered + 1 to absorb ct_coercion_tests, which was itself an absorbing fallback (review 43177) — that blob is a hybrid (row-driven core via extract_coercion_tests, but it still emits a hand-authored header and aggregates three hand blobs), so it is rostered like any other and the fudge is gone."

data runtime_rust_source_path: String = "src/v1/runtime_rust.dag"
data compiler_tests_rust_source_path: String = "src/v1/compiler_tests_rust.dag"

data empty_bind_control_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "extdeps.languages.rust.emit",
  blob_decl: "synthetic_blob_marked_with_nothing",
  disposition: Scaffold {
    dissolves_to: SingleAuthority,
    bind: DeclarationRef { module_path: "", decl_name: "", field: WholeDeclaration }
  }
}

data legitimate_terminal_control_row: LanguageSourceScaffoldRow = LanguageSourceScaffoldRow {
  carrier_module: "v1.compiler.runtime_rust",
  blob_decl: "synthetic_irreducible_kernel",
  disposition: Terminal { reason: "named irreducible intrinsic kernel" }
}

fn rostered_count_for(carrier: String) -> Int {
  language_source_scaffold_roster |> filter(r => r.carrier_module == carrier) |> count
}

fn declared_fn_count(path: String, prefix: String) -> Int {
  let src = filesystem_read(path: path)
  (src.content |> split(delimiter: prefix) |> count) - 1
}

test fn language_source_scaffold_roster_is_fully_dispositioned() -> Bool {
  language_source_scaffold_roster_all_dispositioned()
}

test fn runtime_rust_blobs_are_all_rostered() -> Bool {
  let declared = declared_fn_count(path: runtime_rust_source_path, prefix: "\nfn rt_")
  let rostered = rostered_count_for(carrier: "v1.compiler.runtime_rust")
  declared == rostered
}

test fn compiler_tests_rust_blobs_are_all_rostered() -> Bool {
  let declared = declared_fn_count(path: compiler_tests_rust_source_path, prefix: "\nfn ct_")
  let rostered = rostered_count_for(carrier: "v1.compiler.compiler_tests_rust")
  declared == rostered
}

test fn scaffold_binding_nothing_is_refused() -> Bool {
  language_source_scaffold_row_is_dispositioned(row: empty_bind_control_row) == false
}

test fn reasoned_terminal_is_accepted() -> Bool {
  let is_scaffold = match legitimate_terminal_control_row.disposition {
    Scaffold { dissolves_to: _, bind: _ } => true
    Terminal { reason: _ } => false
  }
  language_source_scaffold_row_is_dispositioned(row: legitimate_terminal_control_row) && is_scaffold == false
}

test fn pair_completion_spelling_binds_the_derivation_authority() -> Bool {
  match rust_pair_completion_spelling_scaffold_trigger {
    Scaffold { dissolves_to: _, bind: bind } =>
      bind.module_path == "std.trait_derive_shape" && bind.decl_name == "pair_completion_op_rows"
    Terminal { reason: _ } => false
  }
}
