data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn phase_tag(p: BmcOnboardingPhase) -> Int {
  match p {
    FactoryDefault => 0
    CredentialsRotated => 1
    OsInstalled => 2
    FabricJoined => 3
  }
}

fn next_tag(p: BmcOnboardingPhase) -> Int {
  match bmc_onboarding_next_phase(phase: p) {
    Present { value: q } => phase_tag(p: q)
    Absent => -1
  }
}

test fn bmc_onboarding_lifecycle_is_linear_dag() -> Bool {
  next_tag(p: FactoryDefault) == 1
    && next_tag(p: CredentialsRotated) == 2
    && next_tag(p: OsInstalled) == 3
    && next_tag(p: FabricJoined) == -1
}

fn posture_tag(p: BmcCredentialPosture) -> Int {
  match p {
    FactoryPublished => 0
    RotatedSecretManaged => 1
    KeylessFederated => 2
  }
}

fn posture_is_keyless(p: BmcCredentialPosture) -> Bool {
  match p {
    FactoryPublished => false
    RotatedSecretManaged => false
    KeylessFederated => true
  }
}

test fn bmc_credential_posture_hardens_to_keyless_steady_state() -> Bool {
  posture_tag(p: bmc_phase_credential_posture(phase: FactoryDefault)) == 0
    && posture_tag(p: bmc_phase_credential_posture(phase: CredentialsRotated)) == 1
    && posture_tag(p: bmc_phase_credential_posture(phase: OsInstalled)) == 1
    && posture_tag(p: bmc_phase_credential_posture(phase: FabricJoined)) == 2
    && !posture_is_keyless(p: bmc_phase_credential_posture(phase: FactoryDefault))
    && !posture_is_keyless(p: bmc_phase_credential_posture(phase: OsInstalled))
    && posture_is_keyless(p: bmc_phase_credential_posture(phase: FabricJoined))
}

test fn bmc_lifecycle_fold_is_complete_and_monotone() -> Bool {
  bmc_lifecycle_length() == 4
    && bmc_lifecycle_is_monotone_hardening()
}

test fn bmc_plan_steady_state_is_keyless_wif() -> Bool {
  let steady = bmc_plan_steady_state_phase(plan: srv3_onboarding_plan)
  (steady == FabricJoined)
    && posture_is_keyless(p: bmc_plan_steady_state_posture(plan: srv3_onboarding_plan))
    && !string_contains(s: bmc_smoke_workflow_text(), pattern: "credentials_json")
    && string_contains(s: bmc_smoke_workflow_text(), pattern: "id-token: write")
}

fn prev_next_is_identity(p: BmcOnboardingPhase) -> Bool {
  match bmc_onboarding_next_phase(phase: p) {
    Present { value: nxt } =>
      match bmc_onboarding_prev_phase(phase: nxt) {
        Present { value: back } => back == p
        Absent => false
      }
    Absent => true
  }
}

fn next_prev_is_identity(p: BmcOnboardingPhase) -> Bool {
  match bmc_onboarding_prev_phase(phase: p) {
    Present { value: prv } =>
      match bmc_onboarding_next_phase(phase: prv) {
        Present { value: fwd } => fwd == p
        Absent => false
      }
    Absent => true
  }
}

test fn bmc_decom_is_two_sided_inverse_on_phase_ladder() -> Bool {
  prev_next_is_identity(p: FactoryDefault)
    && prev_next_is_identity(p: CredentialsRotated)
    && prev_next_is_identity(p: OsInstalled)
    && prev_next_is_identity(p: FabricJoined)
    && next_prev_is_identity(p: FactoryDefault)
    && next_prev_is_identity(p: CredentialsRotated)
    && next_prev_is_identity(p: OsInstalled)
    && next_prev_is_identity(p: FabricJoined)
}

test fn bmc_onboard_then_decom_recovers_factory_phase() -> Bool {
  let decom_after_install = bmc_decom_to_factory(phase: bmc_onboard_to_steady(phase: FactoryDefault))
  let install_after_decom = bmc_onboard_to_steady(phase: bmc_decom_to_factory(phase: FabricJoined))
  (decom_after_install == FactoryDefault) && (install_after_decom == FabricJoined)
}

fn factory_at(p: BmcOnboardingPhase) -> BmcLifecycleState {
  match p {
    FactoryDefault => bmc_factory_state()
    CredentialsRotated => bmc_install_step(s: bmc_factory_state())
    OsInstalled => bmc_install_step(s: bmc_install_step(s: bmc_factory_state()))
    FabricJoined => bmc_install_step(s: bmc_install_step(s: bmc_install_step(s: bmc_factory_state())))
  }
}

test fn bmc_decom_roundtrips_canonical_on_named_quotient() -> Bool {
  bmc_transition_roundtrips_on_quotient(s: factory_at(p: FactoryDefault))
    && bmc_transition_roundtrips_on_quotient(s: factory_at(p: CredentialsRotated))
    && bmc_transition_roundtrips_on_quotient(s: factory_at(p: OsInstalled))
}

fn decom_step_broken(s: BmcLifecycleState) -> BmcLifecycleState {
  match bmc_onboarding_prev_phase(phase: s.phase) {
    Present { value: prv } => BmcLifecycleState {
      phase: prv,
      credential: bmc_phase_credential_posture(phase: prv),
      secret_epoch: s.secret_epoch,
      boot_cleared: s.boot_cleared
    }
    Absent => s
  }
}

fn transition_does_not_roundtrip_on_quotient(s: BmcLifecycleState) -> Bool {
  let recovered = bmc_recoverable_quotient(s: decom_step_broken(s: bmc_install_step(s: s)))
  let original = bmc_recoverable_quotient(s: s)
  !(recovered == original)
}

test fn bmc_decom_does_not_roundtrip_when_inverse_is_wrong() -> Bool {
  transition_does_not_roundtrip_on_quotient(s: factory_at(p: CredentialsRotated))
}

test fn srv3_plan_starts_factory_default_at_192() -> Bool {
  srv3_onboarding_plan.bmc.host == "192.168.1.192"
    && phase_tag(p: srv3_onboarding_plan.start_phase) == 0
    && srv3_onboarding_plan.secret_name == Present { value: "bmc-srv3-admin" }
    && redfish_boot_target_wire(t: BootTargetCd) == "Cd"
    && redfish_account_role_wire(role: srv3_onboarding_plan.rotated_account_role) == "Administrator"
    && redfish_account_role_wire(role: AccountRoleAdministrator) == "Administrator"
}

test fn srv4_plan_targets_195_with_srv4_secret() -> Bool {
  srv4_onboarding_plan.bmc.host == "192.168.1.195"
    && !(srv4_onboarding_plan.bmc.host == srv3_onboarding_plan.bmc.host)
    && phase_tag(p: srv4_onboarding_plan.start_phase) == 0
    && srv4_onboarding_plan.secret_name == Present { value: "bmc-srv4-admin" }
    && redfish_account_role_wire(role: srv4_onboarding_plan.rotated_account_role) == "Administrator"
}

// srv1 and srv2 read their BMC endpoints from the fleet intent, so the literals here are the
// expectation and the plan is the subject: a plan that retyped a wrong address would fail this.
test fn srv1_and_srv2_plans_take_their_bmc_from_the_fleet_intent() -> Bool {
  srv1_onboarding_plan.bmc.host == "192.168.1.183"
    && srv2_onboarding_plan.bmc.host == "192.168.1.184"
    && srv1_onboarding_plan.secret_name == Present { value: "bmc-srv1-admin" }
    && srv2_onboarding_plan.secret_name == Present { value: "bmc-srv2-admin" }
    && phase_tag(p: srv1_onboarding_plan.start_phase) == 0
    && redfish_account_role_wire(role: srv2_onboarding_plan.rotated_account_role) == "Administrator"
}

test fn credential_probe_maps_to_correct_phase() -> Bool {
  match bmc_credential_probe_to_phase(probe: FactoryCredentialActive) {
    Present { value: FactoryDefault } => true
    Present { value: _ } => false
    Absent => false
  }
    && match bmc_credential_probe_to_phase(probe: RotatedCredentialActive) {
      Present { value: CredentialsRotated } => true
      Present { value: _ } => false
      Absent => false
    }
    && match bmc_credential_probe_to_phase(
      probe: CredentialAccessUpsertRequired {
        plan: GoogleCloudInteractiveAuthenticationRequired {},
      },
    ) {
      Absent => true
      Present { value: _ } => false
    }
    && match bmc_credential_probe_to_phase(probe: CredentialStateUnknown { reason: "test" }) {
      Absent => true
      Present { value: _ } => false
    }
}

// THE CONTRADICTION THIS REPAIR REMOVED, kept as the regression control. BmcOnboardingPlan used
// to carry os_install_boot_target, and altra_onboarding_plan put srv3's board-default CD target
// into EVERY host's plan — so srv4, whose firmware evidence justifies no delivery mechanism at
// all, still carried a plausible "boot CD" instruction. The previous version of this witness
// asserted exactly that (srv4_onboarding_plan.os_install_boot_target == "Cd"), enshrining the
// contradiction as the contract.
//
// The install fields are gone from the onboarding record entirely rather than wrapped in a
// standing: no production consumer ever read them (srv3_boot_once_cd, bmc_fan_converge,
// srv3_bmc_credential_resolve and the bmc_onboard tools use bmc / factory_login / secret_name),
// so forcing credential-only operations to unwrap an installation plan would have been a second
// fusion, not a repair. The boot target now lives with the evidence that derives it.
//
// ---------------------------------------------------------------------------
// THE INSTALL BOOT TARGET, IN THE CURRENT MODEL. What this witness asserts about it, and what
// it does not.
//
// The standing this witness used to read — srv3_install_boot_target_standing, with its
// InstallBootTargetSelected / InstallBootTargetRefused family (InstallAccessProfileNotLookedUp,
// InstallFirmwareEvidenceAbsent, InstallBootControlUnestablished, InstallNoBootSourceOverride,
// InstallNoEligibleTransport, InstallDeliveryOutsideLegacyMechanism, InstallTargetContextMismatch
// and the rest) — was deleted with OsInstallMechanism. Nothing in dag/ or src/v2 defines any of
// those names any more, so the claim below is not that claim with new spelling: it is the
// onboarding-scoped fact re-derived against what decides the install boot target now. That is
// gunbc.fleet.fleet_boot_delivery_solution, whose one row per host is an ASSERTED
// BootDeliverySolution built from that host's OWN BMC firmware-evidence row
// (gunbc.fleet.fleet_bmc_firmware_evidence) through the shapes of gunbc.boot_artifact_delivery:
// for a host whose BMC access context has never been looked up the answer is
// BootDeliveryRefused { cause: DeliveryAccessUnbound { standing:
// AccessContextProfileLookupNotRun { endpoint } } } naming that host's own BMC controller.
//
// Two facts are this witness's business, because they are where the onboarding record and the
// install path meet: the plan a host was onboarded through and the delivery answer for that same
// host must name the SAME BMC controller (so the host you enrolled is the host the install path
// refuses on, never its neighbour); and every host the module enrolls has its own refusal, four
// distinct controllers for four distinct machines.
//
// What is NOT asserted here, and why not: that no field of the onboarding record moves the
// answer. A first version of this section tested it by building plan variants that differed in
// start phase, rotated role and secret name and re-checking the same host's refusal. That check
// was green by construction and has been deleted rather than kept as a decoration: the delivery
// answer is composed from the host's firmware-evidence row and takes no plan argument at all, so
// a variant plan reaches it only through the controller, which the variants copied unchanged. The
// independence it wanted to state is a fact about the MODULE STRUCTURE (BootDeliverySolution is
// built from BmcFirmwareEvidence, never from BmcOnboardingPlan), and a witness cannot falsify a
// structural fact by re-supplying an input the subject never reads. The old model's bug shape —
// one host's record carrying another host's boot instruction — is instead held by the two claims
// below, both of which go red when a refusal is pointed at the wrong host.
//
// What is also NOT asserted here: the solver's own refusals and eligibility arms
// (test.claim.machine_intake.boot_artifact_delivery_witness) and the refusal's agreement with
// the firmware-evidence row (test.claim.bmc.bmc_firmware_evidence_install_mechanism_witness) are
// those witnesses' facts, and repeating them here would be a second home, not a second check.

// The controller a host's onboarding plan enrols it at: the plan's BMC endpoint, reduced exactly
// the way the delivery model reduces an evidence endpoint (bmc_controller_of_endpoint drops the
// protocol and keeps the host), so the two sides are compared in the delivery model's own terms.
fn plan_controller(plan: BmcOnboardingPlan) -> BmcControllerEndpoint {
  bmc_controller_of_endpoint(endpoint: plan.bmc)
}

// Is this host's install boot target refused precisely because its access context was never
// looked up, and does the refusal name THIS controller? Any other refusal — a different cause,
// a same-shaped cause naming another host's controller — and any selection at all, reads false.
fn boot_target_refused_at(that: BootDeliverySolution, controller: BmcControllerEndpoint) -> Bool {
  match that {
    BootDeliveryRefused {
      cause: DeliveryAccessUnbound {
        standing: AccessContextProfileLookupNotRun { endpoint: named },
      },
    } => named == controller
    BootDeliveryPlanned { plan: _ } => false
    BootDeliveryRefused { cause: _ } => false
  }
}

// srv3 HAS JOINED srv4. This previously read "per-host, and srv4 has none",
// pinning srv3 to a Cd target while srv4 refused — a real difference at the time,
// because srv3 still ran 2.07.00. Both hosts now run 3.22.00 and both refuse with
// the same cause, so asserting a difference would be asserting a fact that
// stopped being true when srv3's BMC was upgraded. The per-host machinery is
// unchanged and still reads each host's own evidence; the two hosts simply agree
// now, and the witness says which state that is rather than which it used to be.
//
// Two 3.22.00 hosts, one refused boot target each, and neither refusal may be the other's copy:
// the causes match, the controllers each names are the two plans' own, and the two controllers
// are different machines. A row that hand-typed srv3's controller into srv4's refusal, or that
// selected a target for either host, reads false here.
test fn install_boot_target_refuses_alike_for_both_3_22_00_hosts() -> Bool {
  boot_target_refused_at(that: srv3_boot_delivery_solution, controller: plan_controller(plan: srv3_onboarding_plan))
    && boot_target_refused_at(that: srv4_boot_delivery_solution, controller: plan_controller(plan: srv4_onboarding_plan))
    && !(srv3_boot_delivery_solution == srv4_boot_delivery_solution)
    && !(plan_controller(plan: srv3_onboarding_plan) == plan_controller(plan: srv4_onboarding_plan))
    // Neither host's refusal names the OTHER host's controller: the pairing the deleted model
    // could not express is the one thing this claim exists to keep unexpressible.
    && !(boot_target_refused_at(that: srv3_boot_delivery_solution, controller: plan_controller(plan: srv4_onboarding_plan)))
    && !(boot_target_refused_at(that: srv4_boot_delivery_solution, controller: plan_controller(plan: srv3_onboarding_plan)))
}

// Totality over the onboarded roster: all four hosts this module enrolls have a boot-delivery
// answer, every one of them a refusal at the access step, and the four controllers named are the
// four plans' own — four distinct machines, no host missing and no host sharing a refusal.
test fn every_onboarded_host_has_its_own_refused_boot_target() -> Bool {
  boot_target_refused_at(that: srv1_boot_delivery_solution, controller: plan_controller(plan: srv1_onboarding_plan))
    && boot_target_refused_at(that: srv2_boot_delivery_solution, controller: plan_controller(plan: srv2_onboarding_plan))
    && boot_target_refused_at(that: srv3_boot_delivery_solution, controller: plan_controller(plan: srv3_onboarding_plan))
    && boot_target_refused_at(that: srv4_boot_delivery_solution, controller: plan_controller(plan: srv4_onboarding_plan))
    && !(plan_controller(plan: srv1_onboarding_plan) == plan_controller(plan: srv2_onboarding_plan))
    && !(plan_controller(plan: srv1_onboarding_plan) == plan_controller(plan: srv3_onboarding_plan))
    && !(plan_controller(plan: srv1_onboarding_plan) == plan_controller(plan: srv4_onboarding_plan))
    && !(plan_controller(plan: srv2_onboarding_plan) == plan_controller(plan: srv3_onboarding_plan))
    && !(plan_controller(plan: srv2_onboarding_plan) == plan_controller(plan: srv4_onboarding_plan))
    && !(plan_controller(plan: srv3_onboarding_plan) == plan_controller(plan: srv4_onboarding_plan))
}

fn bmc_smoke_workflow_text() -> String {
  match emit_bmc_token_smoke_workflow_yaml() {
    EmittedYaml { text: t } => t
    YamlEmitRefused { path: _, reason: _ } => ""
  }
}
