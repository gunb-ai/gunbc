data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE CIPHER SUITE BECAME AN INPUT OF EVERY LANPLUS OPERATION, AND MTCOLLINS1'S ARGV DID NOT MOVE (merry-fox-82's
// ruling A, condition 2). Each operation of diagnostic.ipmi.Tool is materialized from its REAL declaration
// (std.operation_argv shell_materialize_operation_argv reads dag/extdeps/bmc/ipmi.dag) with the suite mtcollins1's
// route supplies, and compared word for word with the argv main rendered before the input existed: the literal is
// main's template with the same bindings substituted, so it is an oracle independent of this change. The REDs
// inject a suite on mtcollins1's route and require the argv to change, so the equality cannot hold vacuously.

data ipmi_path: String = "dag/extdeps/bmc/ipmi.dag"
data ipmi_service: String = "diagnostic.ipmi.Tool"

// The spec's suite 3, from the table (IpmiCipherSuite has one constructor, the table's).
fn suite_3() -> IpmiCipherSuite? {
  ipmi_cipher_suite_of_id(id: 3)
}

// The suite each of mtcollins1's routes supplies: the bound-route chain reads its access observation, and the
// run's row reads the same route observation. Both are its observed IPMI route's own.
fn mtcollins1_observation_suite() -> IpmiCipherSuite? {
  bmc_observation_ipmi_cipher_suite(observation: mtcollins1_access_observation)
}

fn mtcollins1_row_suite() -> IpmiCipherSuite? {
  mtcollins1_boot_row_value.ipmi_cipher_suite
}

// The corpus materializer binds what the declaration carries. Every ipmi.dag operation declares
// cipher_suite_argv, so the suite binding is unconditional; the retry bound rides ONLY rows that
// declare it (an unauthenticated row must materialize with no retry binding at all -- binding one it
// never declared would be refused, and the mains-on-both-routes claims pin the unauthenticated argv
// byte for byte).
fn materialize(operation: String, bindings: List<OperationInputBinding>, suite: IpmiCipherSuite?) -> List<String> {
  let row_opt = first(filter(xs: shell_transport_operation_rows(), predicate: fn(row) { ipmi_row_at(row: row, path: ipmi_path, service: ipmi_service, operation: operation) }))
  let retry_binds = match row_opt {
    Present { value: row } =>
      if ipmi_row_declares(row: row, name: "retry_bound_argv") {
        [operation_argv_bind_text_list(name: "retry_bound_argv", items: bmc_ipmi_retry_bound_argv())]
      } else {
        []
      }
    Absent => []
  }
  operation_argv_tokens_or_refusal_label(m: shell_materialize_operation_argv(
    ipmi_path,
    ipmi_service,
    operation,
    bindings + [operation_argv_bind_text_list(name: "cipher_suite_argv", items: ipmi_cipher_suite_argv(suite: suite))] + retry_binds
  ))
}

fn host() -> OperationInputBinding {
  operation_argv_bind_text(name: "bmc_host", text: mtcollins1_endpoint.host as String)
}

fn bindings_sensor_list() -> List<OperationInputBinding> {
  [
    host(),
  ]
}

data main_argv_sensor_list: List<String> = ["ipmitool", "-H", "192.168.1.228", "-I", "lanplus", "sensor"]

test fn sensor_list_argv_is_mains_on_both_mtcollins1_routes() -> Bool {
  materialize(operation: "SensorList", bindings: bindings_sensor_list(), suite: mtcollins1_observation_suite()) == main_argv_sensor_list
    && materialize(operation: "SensorList", bindings: bindings_sensor_list(), suite: mtcollins1_row_suite()) == main_argv_sensor_list
}

