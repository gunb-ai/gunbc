data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn mtcollins1_grounded_read_is_automatic_with_two_live_pairs() -> Bool {
  match mtcollins1_megarac_fan_mode_observation_2026_10_14.manager {
    CoolingManagerAutomatic =>
      mtcollins1_megarac_fan_mode_observation_2026_10_14.fans.length() == 6
        && match mtcollins1_megarac_fan_mode_observation_2026_10_14.fans.skip(n: 4).first() {
          Present { value: row } => percent_count(p: row.fan_pwm) == 20
          Absent => false
        }
        && match megarac_manager_disabled_of_wire(manager_disabled: 1) {
          MegaRacManagerDisabledAdmitted { standing: s } =>
            s == CoolingManagerDisabledManual
              && megarac_fan_boot_phase_desire.phase == BootThroughTerminal
              && megarac_fan_bringup_phase_desire.phase == HostBringupAndAfter
              && megarac_fan_bringup_phase_desire.manager == CoolingManagerAutomatic
              && (megarac_set_manager_status_body(standing: CoolingManagerAutomatic) as String)
                == "{\"manager_disabled\":0}"
              && mtcollins1_megarac_thermal_snapshot_2026_10_14.system_inlet_suspect
          MegaRacManagerDisabledRefused { wire: _ } => false
        }
    CoolingManagerDisabledManual => false
  }
}

test fn fan_control_paths_are_the_served_ui_routes() -> Bool {
  (megarac_op_fan_get_manager_status.path as String) == "/api/fan_control/get_manager_status"
    && (megarac_op_fan_get_fan_info.path as String) == "/api/fan_control/get_fan_info"
    && (megarac_op_fan_set_manager_status.path as String) == "/api/fan_control/set_manager_status"
    && (megarac_op_fan_set_fan_speed.path as String) == "/api/fan_control/set_fan_speed"
    && (megarac_op_fan_get_manager_status.http_method as String) == "GET"
    && (megarac_op_fan_set_fan_speed.http_method as String) == "POST"
}

test fn missing_socket1_fans_are_physically_absent_not_zero_duty() -> Bool {
  match megarac_fan_slot_standing(pwm: percent(0), sdr: MegaRacSdrFanPresenceAbsent) {
    MegaRacFanSlotPhysicallyAbsent =>
      match megarac_fan_slot_standing(
        pwm: percent(20),
        sdr: MegaRacSdrFanRotatingInBand { min_rpm: rpm(5700), max_rpm: rpm(5800) },
      ) {
        MegaRacFanSlotDriven { pwm: p, min_rpm: _, max_rpm: _ } =>
          percent_count(p: p) == 20
            && match megarac_fan_slot_standing(pwm: percent(20), sdr: MegaRacSdrFanPresenceAbsent) {
              MegaRacFanSlotJoinUnexplained { pwm: _, sdr: _ } => true
              MegaRacFanSlotPhysicallyAbsent => false
              MegaRacFanSlotDriven { pwm: _, min_rpm: _, max_rpm: _ } => false
            }
        MegaRacFanSlotPhysicallyAbsent => false
        MegaRacFanSlotJoinUnexplained { pwm: _, sdr: _ } => false
      }
    MegaRacFanSlotDriven { pwm: _, min_rpm: _, max_rpm: _ } => false
    MegaRacFanSlotJoinUnexplained { pwm: _, sdr: _ } => false
  }
}

test fn set_fan_speed_body_is_fan_pwm_all_as_a_string() -> Bool {
  match megarac_fan_pwm_all_of(duty: percent(25)) {
    MegaRacFanPwmAllAdmitted { wire: w } =>
      (w as String) == "25"
        && match megarac_fan_pwm_all_body(pwm: MegaRacFanPwmAllAdmitted { wire: w }) {
          Present { value: body } => (body as String) == "{\"fan_pwm_all\":\"25\"}"
          Absent => false
        }
        && megarac_fan_boot_pwm_admitted(duty: percent(20))
        && megarac_fan_boot_pwm_admitted(duty: percent(30))
        && !megarac_fan_boot_pwm_admitted(duty: percent(35))
        && match megarac_fan_pwm_all_of(duty: percent(22)) {
          MegaRacFanPwmAllRefused { duty: _ } => true
          MegaRacFanPwmAllAdmitted { wire: _ } => false
        }
    MegaRacFanPwmAllRefused { duty: _ } => false
  }
}

test fn redirection_status_at_0_32_recovers_the_served_ui_enum() -> Bool {
  match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 1) {
    RedirectionStatusKnown { firmware: _, status: RedirectionStartedConnectionAccepted } =>
      match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 100) {
        RedirectionStatusKnown { firmware: _, status: RedirectionConnecting } =>
          match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 0) {
            RedirectionStatusKnown { firmware: _, status: RedirectionStopped } =>
              match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 7) {
                RedirectionStatusKnown { firmware: _, status: RedirectionWireUncatalogued { wire: 7 } } => true
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn redirection_status_refuses_an_uncatalogued_firmware() -> Bool {
  let other = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.31")
  match megarac_redirection_status_of_wire(firmware: other, wire: 1) {
    RedirectionStatusFirmwareUncatalogued { firmware: _, wire: 1 } => true
    _ => false
  }
}

test fn uncatalogued_wire_cannot_confirm_attachment() -> Bool {
  megarac_redirection_presentation_standing(
    lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 1),
  ) == RedirectionPresenting
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 100),
    ) == RedirectionPresenting
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 0),
    ) == RedirectionKnownStopped
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 2),
    ) == RedirectionPresentationUnknown
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 5),
    ) == RedirectionPresentationUnknown
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 7),
    ) == RedirectionPresentationUnknown
    && megarac_redirection_presentation_standing(
      lookup: megarac_redirection_status_of_wire(
        firmware: bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.31"),
        wire: 1,
      ),
    ) == RedirectionPresentationUnknown
}

test fn web_and_ipmi_event_log_layouts_are_distinct() -> Bool {
  megarac_web_event_log_layout == MegaRacWebEventLogOemEmptySelData
    && megarac_ipmi_sel_layout == MegaRacIpmiSelPayloadPreserved
    && megarac_web_event_log_layout != megarac_ipmi_sel_layout
}

fn collector_without_coverage() -> SolCollectorObservation {
  SolCollectorSessionAcknowledged {
    coverage: SolCoverageNeverEstablished { termination: CollectorTerminatedExitZeroStdinEof },
    host_payload: SolHostPayloadNotReceived,
    terminate_deadline: megarac_sol_collector_terminate_deadline,
  }
}

fn collector_with_host_payload() -> SolCollectorObservation {
  SolCollectorSessionAcknowledged {
    coverage: SolCoverageComplete,
    host_payload: SolHostPayloadReceived,
    terminate_deadline: megarac_sol_collector_terminate_deadline,
  }
}

test fn incomplete_sol_coverage_is_not_a_host_silence_fact() -> Bool {
  match sol_host_fact_from_collector(obs: collector_without_coverage()) {
    SolCollectorDidNotEstablishCoverage { coverage: SolCoverageNeverEstablished { termination: CollectorTerminatedExitZeroStdinEof } } => true
    _ => false
  }
    && match sol_host_fact_from_collector(obs: collector_with_host_payload()) {
      SolHostPayloadAdmitted => true
      _ => false
    }
    && match sol_host_fact_from_collector(obs: SolCollectorSessionAcknowledged {
      coverage: SolCoverageComplete,
      host_payload: SolHostPayloadNotReceived,
      terminate_deadline: megarac_sol_collector_terminate_deadline,
    }) {
      SolHostProducedNoConsoleBytes => true
      _ => false
    }
}

test fn unacknowledged_session_never_claims_the_host_produced_no_bytes() -> Bool {
  match sol_host_fact_from_collector(obs: SolCollectorSessionNotAcknowledged {
    termination: CollectorTerminatedExitZeroStdinEof,
    host_payload: SolHostPayloadNotReceived,
    terminate_deadline: megarac_sol_collector_terminate_deadline,
  }) {
    SolSessionNeverAcknowledged => true
    SolHostProducedNoConsoleBytes => false
    _ => false
  }
    && match sol_host_fact_from_collector(obs: SolCollectorSessionNotAcknowledged {
      termination: CollectorTerminatedExitZeroStdinEof,
      host_payload: SolHostPayloadReceived,
      terminate_deadline: megarac_sol_collector_terminate_deadline,
    }) {
      SolSessionNeverAcknowledged => true
      SolHostPayloadAdmitted => false
      _ => false
    }
}

test fn ampere_oem_sel_layout_does_not_cover_sensor_0xde() -> Bool {
  match ampere_oem_sel_record_match(
    layout: ampere_oem_sel_producer_layout,
    sensor: 235,
    manufacturer_id_byte0: 58,
    manufacturer_id_byte1: 205,
    manufacturer_id_byte2: 0,
  ) {
    AmpereBootSyndromeOemSel =>
      match ampere_oem_sel_record_match(
        layout: ampere_oem_sel_producer_layout,
        sensor: 222,
        manufacturer_id_byte0: 58,
        manufacturer_id_byte1: 205,
        manufacturer_id_byte2: 0,
      ) {
        AmpereOemSelSensorOutsideLayout { sensor: 222 } =>
          match ampere_oem_sel_record_match(
            layout: ampere_oem_sel_producer_layout,
            sensor: 235,
            manufacturer_id_byte0: 0,
            manufacturer_id_byte1: 0,
            manufacturer_id_byte2: 0,
          ) {
            AmpereOemSelManufacturerIdNotThisPen => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn sol_host_payload_is_admitted_while_coverage_is_still_past_deadline() -> Bool {
  match sol_host_fact_from_collector(obs: megarac_sol_host_payload_positive_control) {
    SolHostPayloadAdmitted => true
    _ => false
  }
    && match megarac_sol_host_payload_positive_control {
      SolCollectorSessionAcknowledged {
        coverage: SolCoverageStillRunningPastDeadline,
        host_payload: SolHostPayloadReceived,
        terminate_deadline: _,
      } => true
      _ => false
    }
    && match sol_host_fact_from_collector(obs: SolCollectorSessionAcknowledged {
      coverage: SolCoverageComplete,
      host_payload: SolHostPayloadReceived,
      terminate_deadline: megarac_sol_collector_terminate_deadline,
    }) {
      SolHostPayloadAdmitted => true
      _ => false
    }
    && match sol_host_fact_from_collector(obs: SolCollectorSessionAcknowledged {
      coverage: SolCoverageStillRunningPastDeadline,
      host_payload: SolHostPayloadNotReceived,
      terminate_deadline: megarac_sol_collector_terminate_deadline,
    }) {
      SolCollectorDidNotEstablishCoverage { coverage: SolCoverageStillRunningPastDeadline } => true
      _ => false
    }
}
