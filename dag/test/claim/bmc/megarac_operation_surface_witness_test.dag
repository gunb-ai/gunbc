data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn path_roster_contains(xs: List<NonEmptyStr>, s: NonEmptyStr) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || x == s)
}

test fn media_route_is_bmc_nfs_client_not_pxe() -> Bool {
  match megarac_remote_media_role {
    MegaRacBmcIsNfsClientHostSeesVirtualCd => true
  }
}

test fn cd_active_sessions_cannot_be_read_as_a_count() -> Bool {
  match megarac_cd_active_sessions_session_count(field: megarac_cd_active_sessions_flag_byte(wire: 128)) {
    CdActiveSessionsFlagByteIsNotACount { field: _ } =>
      match megarac_cd_active_sessions_session_count(field: megarac_cd_active_sessions_flag_byte(wire: 129)) {
        CdActiveSessionsFlagByteIsNotACount { field: _ } => true
      }
  }
}

test fn redirection_status_at_0_32_recovers_the_served_ui_enum() -> Bool {
  match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 1) {
    RedirectionStatusKnown { firmware: _, status: RedirectionStartedConnectionAccepted } =>
      match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 100) {
        RedirectionStatusKnown { firmware: _, status: RedirectionConnecting } =>
          match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 0) {
            RedirectionStatusKnown { firmware: _, status: RedirectionStopped } =>
              match megarac_redirection_status_of_wire(firmware: megarac_firmware_0_32, wire: 7) {
                RedirectionStatusKnown { firmware: _, status: RedirectionVendorRenderedStopped { wire: 7 } } =>
                  megarac_redirection_is_started(status: RedirectionStartedConnectionAccepted)
                    && megarac_redirection_is_connecting(status: RedirectionConnecting)
                    && !megarac_redirection_is_started(status: RedirectionConnecting)
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn redirection_status_refuses_an_uncatalogued_firmware() -> Bool {
  let other = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "0.31")
  match megarac_redirection_status_of_wire(firmware: other, wire: 1) {
    RedirectionStatusFirmwareUncatalogued { firmware: _, wire: 1 } => true
    _ => false
  }
}

test fn recorders_survive_reset_and_live_sol_does_not() -> Bool {
  megarac_framebuffer_recorder_reset_survival == SurvivesHostAndControllerReset
    && megarac_sol_recorder_reset_survival == SurvivesHostAndControllerReset
    && megarac_live_sol_activate_reset_survival == DiesOnReset
    && megarac_framebuffer_recorder_reset_survival != megarac_live_sol_activate_reset_survival
    && megarac_video_trigger_power_on_field_wire() == "chassis_power_on_events_enable" as NonEmptyStr
    && megarac_sol_trigger_power_on_field_wire() == "chasis_power_on_events_enable" as NonEmptyStr
}

test fn served_ui_absences_are_first_class_at_0_32() -> Bool {
  match megarac_served_ui_absence_standing(firmware: megarac_firmware_0_32, absence: RedfishServiceAbsentFromServedUi) {
    ServedUiFactKnown { firmware: _, holds: true } =>
      match megarac_served_ui_absence_standing(firmware: megarac_firmware_0_32, absence: BiosUefiSettingsSurfaceAbsent) {
        ServedUiFactKnown { firmware: _, holds: true } =>
          match megarac_served_ui_absence_standing(firmware: megarac_firmware_0_32, absence: PerDimmFruAndTelemetryAbsentFromServedUi) {
            ServedUiFactKnown { firmware: _, holds: true } =>
              match megarac_served_ui_absence_standing(firmware: megarac_firmware_0_32, absence: OemSelDecodeAbsentFromControllerRenderer) {
                ServedUiFactKnown { firmware: _, holds: true } =>
                  path_roster_contains(xs: megarac_bios_adjacent_paths_at_0_32, s: "/api/maintenance/hpm/getbiosversions" as NonEmptyStr)
                _ => false
              }
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn other_firmware_does_not_inherit_0_32_absences() -> Bool {
  let other = bmc_firmware_release_identity_of_wire(family: AmiMegaRac, wire: "1.00")
  match megarac_served_ui_absence_standing(firmware: other, absence: RedfishServiceAbsentFromServedUi) {
    ServedUiFactFirmwareUncatalogued { firmware: _ } => true
    _ => false
  }
}

test fn web_event_log_empties_oem_payload_and_genid_is_not_a_sender() -> Bool {
  megarac_web_event_log_layout == MegaRacWebEventLogOemEmptySelData
    && megarac_ipmi_sel_layout == MegaRacIpmiSelPayloadPreserved
    && megarac_web_event_log_layout != megarac_ipmi_sel_layout
    && match megarac_gen_id_as_sender(standing: megarac_gen_id_standing(gen_id1: 62, gen_id2: 17)) {
      GenIdDoesNotIdentifyASender { standing: _ } => true
    }
}

fn silent_sol_profile() -> PreOsObservationCapabilities {
  PreOsObservationCapabilities {
    baseboard: AmpereMtCollins,
    controller_firmware: megarac_firmware_0_32,
    console: SolPresentSilent,
    sel: SelStandardDecoded,
    oem_sel_decode: OemDecodeControllerDeclaredUnknown,
    web_event_log: WebEventLogAvailable,
    dimm_localization: LocalizationUnavailableFromExposedTelemetry,
    memory_power: AggregateMemoryPowerExposed,
    managed_ac: NoManagedAcActuator,
    host_callback: HostCallbackIntendedNotDemonstrated,
  }
}

fn emitting_sol_profile() -> PreOsObservationCapabilities {
  PreOsObservationCapabilities {
    baseboard: AmpereMtCollins,
    controller_firmware: megarac_firmware_0_32,
    console: SolPresentEmitting,
    sel: SelStandardDecoded,
    oem_sel_decode: OemDecodeControllerDeclaredUnknown,
    web_event_log: WebEventLogAvailable,
    dimm_localization: LocalizationUnavailableFromExposedTelemetry,
    memory_power: AggregateMemoryPowerExposed,
    managed_ac: NoManagedAcActuator,
    host_callback: HostCallbackIntendedNotDemonstrated,
  }
}

test fn present_silent_sol_refuses_as_a_host_fact() -> Bool {
  !megarac_silent_sol_is_host_fact(delivery: ChannelPresentNotDelivering)
    && megarac_silent_sol_is_host_fact(delivery: ChannelPresentDelivering)
    && !console_silence_is_informative(profile: silent_sol_profile())
    && console_silence_is_informative(profile: emitting_sol_profile())
    && megarac_sol_silent_refuses_host_fact(profile: silent_sol_profile())
    && !megarac_sol_silent_refuses_host_fact(profile: emitting_sol_profile())
    && match megarac_sol_host_observation(profile: silent_sol_profile()) {
      SilentChannelRefusedAsHostFact { channel: MegaRacSolSessionChannel } => true
      _ => false
    }
}
