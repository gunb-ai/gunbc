  DiesOnReset,
  MegaRacIpmiSelPayloadPreserved,
  MegaRacWebEventLogOemEmptySelData,
  MegaRacWebEventLogOemDescriptionUnknown,
  PerDimmFruAndTelemetryAbsentFromServedUi,
  RedirectionConnecting,
  RedirectionStartedConnectionAccepted,
  RedirectionStatusFirmwareUncatalogued,
  RedirectionStatusKnown,
  RedirectionStopped,
  RedirectionVendorRenderedStopped,
  RedfishServiceAbsentFromServedUi,
  ServedUiFactFirmwareUncatalogued,
  ServedUiFactKnown,
  FramebufferRecorder,
  SolStreamRecorder,
  SurvivesHostAndControllerReset,
  megarac_bios_adjacent_paths_at_0_32,
  megarac_firmware_0_32,
  megarac_framebuffer_recorder_reset_survival,
  megarac_ipmi_sel_layout,
  megarac_live_sol_activate_reset_survival,
  megarac_recorder_reset_survival,
  megarac_recorder_trigger_power_on_field,
  megarac_redirection_presents_media,
  megarac_redirection_status_of_wire,
  megarac_served_ui_absence_standing,
  megarac_sol_recorder_reset_survival,
  megarac_sol_trigger_power_on_field,
  megarac_trigger_power_on_field_wire,
  megarac_video_trigger_power_on_field,
