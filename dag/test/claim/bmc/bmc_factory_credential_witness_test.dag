module test.claim.bmc_factory_credential

import std.types { Bool, Int, List, String }
import std.credentials { FactoryLogin }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { AmiMegaRac, BmcEndpoint, BmcProtocol, OpenBmc, Redfish }
import extdeps.boards.types { ServerBaseboard }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import gunbc.bmc_implementation_dispatch { bmc_firmware_factory_login, bmc_firmware_supported_protocols }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data new_server_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

data new_server_factory_login: FactoryLogin = bmc_firmware_factory_login(family: new_server_baseboard.catalog.bmc_firmware)

fn protocol_count(ps: List<BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, p) => acc + 1)
}

test fn bmc_factory_credential_holds() -> Bool {

  new_server_factory_login.username == "root"
    && new_server_factory_login.published_password == "0penBmc"

    && new_server_baseboard.catalog.vendor == extdeps.vendor.asrock_rack.asrock_rack

    && protocol_count(ps: bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}

// The MegaRAC arm answers from its own module (gunbc#9678's cited admin/admin
// default), never OpenBMC's root/0penBmc by fall-through; and its protocol
// answer is the family FLOOR — IPMI only — not the OpenBMC pair.
test fn megarac_answers_from_its_own_module() -> Bool {
  let login = bmc_firmware_factory_login(family: AmiMegaRac)
  login.username == "admin"
    && login.published_password == "admin"
    && protocol_count(ps: bmc_firmware_supported_protocols(family: AmiMegaRac)) == 1
}
