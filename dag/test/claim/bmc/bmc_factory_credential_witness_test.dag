module test.claim.bmc_factory_credential

import std.types { Bool, Int, List, String }
import std.credentials { FactoryLogin }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { AmiMegaRac, BmcEndpoint, BmcProtocol, FactoryLoginPublished, FactoryLoginStanding, FactoryLoginUnobserved, OpenBmc, Redfish }
import extdeps.boards.types { ServerBaseboard }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import gunbc.bmc_implementation_dispatch { bmc_firmware_factory_login, bmc_firmware_supported_protocols }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data new_server_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

fn published_username(standing: FactoryLoginStanding) -> String {
  match standing {
    FactoryLoginPublished { login: l } => l.username
    FactoryLoginUnobserved { family: _ } => ""
  }
}

fn published_password(standing: FactoryLoginStanding) -> String {
  match standing {
    FactoryLoginPublished { login: l } => l.published_password
    FactoryLoginUnobserved { family: _ } => ""
  }
}

data new_server_factory_login: FactoryLoginStanding = bmc_firmware_factory_login(family: new_server_baseboard.catalog.bmc_firmware)

fn protocol_count(ps: List<BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, p) => acc + 1)
}

test fn bmc_factory_credential_holds() -> Bool {

  published_username(standing: new_server_factory_login) == "root"
    && published_password(standing: new_server_factory_login) == "0penBmc"

    && new_server_baseboard.catalog.vendor == extdeps.vendor.asrock_rack.asrock_rack

    && protocol_count(ps: bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}

// RED CONTROL for the dispatch recut: the MegaRAC arm answers from its own
// module and cites NO published login, so the dispatcher must return the
// unobserved standing — never OpenBMC's root/0penBmc by fall-through.
test fn megarac_factory_login_is_unobserved_not_openbmcs() -> Bool {
  match bmc_firmware_factory_login(family: AmiMegaRac) {
    FactoryLoginUnobserved { family: f } => f == AmiMegaRac
    FactoryLoginPublished { login: _ } => false
  }
}

test fn megarac_cites_redfish_and_ipmi() -> Bool {
  protocol_count(ps: bmc_firmware_supported_protocols(family: AmiMegaRac)) == 2
}
