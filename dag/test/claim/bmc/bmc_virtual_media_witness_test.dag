module test.claim.bmc_virtual_media

import std.logic { Bool }
import std.types { list_length }
import extdeps.linux.usb_gadget {
  ConfigfsOp,
  ConfigfsWriteAttr,
  ConfigfsMkdir,
  ConfigfsSymlink,
  ConfigfsRemoveLink,
  ConfigfsRmdir,
  ConfigfsCommandArgv,
  ConfigfsCommandWriteFile,
  ConfigfsOpCommandOutcome,
  ConfigfsOpCommandBuilt,
  ConfigfsOpCommandRefused,
}
import extdeps.tools.mkdir { mkdir_path_resolved_program }
import gunbc.bmc_virtual_media {
  srv4_nbd_server_config_text,
  srv4_nbd_client_attach_command_text,
  srv4_vm_gadget_setup_commands,
  srv4_vm_gadget_setup_ops,
}
import gunbc.fleet_intent_network { srv1_host_lan_endpoint }
import extdeps.bmc.webui.nbd_proxy_serve { srv3_nbd_proxy_local_port }

fn configfs_write_value_for(ops: List<ConfigfsOp>, path_suffix: String) -> String {
  fold(ops, init: "", f: (acc, op) => match op {
    ConfigfsWriteAttr { path: p, value: v } =>
      if string_contains(s: p as String, pattern: path_suffix) { v } else { acc }
    ConfigfsMkdir { path: _ } => acc
    ConfigfsSymlink { target: _, link: _ } => acc
    ConfigfsRemoveLink { link: _ } => acc
    ConfigfsRmdir { path: _ } => acc
  })
}

test fn srv4_nbd_export_read_only_seeded_iso() -> Bool {
  let cfg = srv4_nbd_server_config_text()
  string_contains(s: cfg, pattern: concat("port = ", to_string(srv3_nbd_proxy_local_port)))
    && string_contains(s: cfg, pattern: "[srv4iso]")
    && string_contains(s: cfg, pattern: "exportname = /var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-srv4-seeded.iso")
    && string_contains(s: cfg, pattern: "readonly = true")
}

test fn srv4_nbd_client_attaches_named_export() -> Bool {
  string_contains(
    s: srv4_nbd_client_attach_command_text(),
    pattern: concat(
      "'nbd-client' '-N' 'srv4iso' '",
      concat(
        srv1_host_lan_endpoint.address as String,
        concat("' '", concat(to_string(srv3_nbd_proxy_local_port), "' '/dev/nbd0'")),
      ),
    ),
  )
}

// MIGRATED TO THE DESCRIBED FORM (shell-typed-invocation). This test used to assert the same
// facts by scraping the assembled shell script for `printf '%s' '…' > …` lines; the script surface
// is deleted, and the facts are asserted where the described plan carries them: sixteen commands,
// every one BUILT (the fixture's gadget is in-repo authority — a refusal here is a defect, not a
// verdict), the attribute writes riding as TYPED file writes with exactly the contents the ops
// promise, and the mkdir spelled as the path-resolved ensure form — the deliberate spelling for an
// unobserved BMC target, recorded at extdeps.linux.usb_gadget configfs_op_command.
fn configfs_command_write_content_for(commands: List<ConfigfsOpCommandOutcome>, path_suffix: String) -> String {
  fold(commands, init: "", f: (acc, c) => match c {
    ConfigfsOpCommandBuilt { command: cmd } => match cmd {
      ConfigfsCommandWriteFile { path: p, content: v } =>
        if string_contains(s: p as String, pattern: path_suffix) { v } else { acc }
      ConfigfsCommandArgv { command: _ } => acc
    }
    ConfigfsOpCommandRefused { cause: _ } => acc
  })
}

test fn srv4_gadget_is_readonly_cdrom_on_nbd0() -> Bool {
  let commands = srv4_vm_gadget_setup_commands()
  list_length(items: commands) == 16
    && all(commands, c => match c {
      ConfigfsOpCommandBuilt { command: _ } => true
      ConfigfsOpCommandRefused { cause: _ } => false
    })
    && configfs_command_write_content_for(commands: commands, path_suffix: "/lun.0/file") == "/dev/nbd0"
    && configfs_command_write_content_for(commands: commands, path_suffix: "/lun.0/cdrom") == "0"
    && configfs_command_write_content_for(commands: commands, path_suffix: "gunbcvm/UDC") == "1e6a0000.usb-vhub:p3"
    && any(commands, c => match c {
      ConfigfsOpCommandBuilt { command: cmd } => match cmd {
        ConfigfsCommandArgv { command: argv } =>
          argv.program as String == mkdir_path_resolved_program as String
            && argv.arguments == ["-p", "/sys/kernel/config/usb_gadget/gunbcvm"]
        ConfigfsCommandWriteFile { path: _, content: _ } => false
      }
      ConfigfsOpCommandRefused { cause: _ } => false
    })
}

test fn srv4_gadget_ops_are_typed_not_scraped_from_shell() -> Bool {
  let ops = srv4_vm_gadget_setup_ops()
  configfs_write_value_for(ops: ops, path_suffix: "/lun.0/file") == "/dev/nbd0"
    && configfs_write_value_for(ops: ops, path_suffix: "/lun.0/cdrom") == "0"
    && configfs_write_value_for(ops: ops, path_suffix: "/lun.0/ro") == "1"
    && configfs_write_value_for(ops: ops, path_suffix: "gunbcvm/UDC") == "1e6a0000.usb-vhub:p3"
    && list_length(items: ops) == 16
}
