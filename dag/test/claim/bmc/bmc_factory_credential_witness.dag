module test.claim.bmc.bmc_factory_credential_witness

import std.types { Bool, Int, List, String }
import std.credentials { FactoryLogin }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import extdeps.bmc.endpoint { AmiMegaRac, BmcEndpoint, BmcProtocol, OpenBmc, Redfish, SupermicroAten }
import extdeps.boards.types { ServerBaseboard }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import gunbc.bmc.bmc_implementation_dispatch { bmc_firmware_factory_login, bmc_firmware_supported_protocols, BmcFactoryLoginStanding, FactoryLoginPublished, FactoryLoginPerUnit }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data new_server_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

fn protocol_count(ps: List<BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, p) => acc + 1)
}

fn published_login_is(standing: BmcFactoryLoginStanding, username: String, password: String) -> Bool {
  match standing {
    FactoryLoginPublished { login: l } => l.username == username && l.published_password == password
    FactoryLoginPerUnit { username: _, password_form: _, authority: _ } => false
  }
}

test fn bmc_factory_credential_holds() -> Bool {

  published_login_is(standing: bmc_firmware_factory_login(family: new_server_baseboard.catalog.bmc_firmware), username: "root", password: "0penBmc")

    && new_server_baseboard.catalog.vendor == extdeps.vendor.asrock_rack.asrock_rack

    && protocol_count(ps: bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}

// The MegaRAC arm answers from its own module (gunbc#9678's cited admin/admin
// default), never OpenBMC's root/0penBmc by fall-through; and its protocol
// answer is the family FLOOR — IPMI only — not the OpenBMC pair.
test fn megarac_answers_from_its_own_module() -> Bool {
  published_login_is(standing: bmc_firmware_factory_login(family: AmiMegaRac), username: "admin", password: "admin")
    && protocol_count(ps: bmc_firmware_supported_protocols(family: AmiMegaRac)) == 1
}

// The Supermicro arm publishes NO password: a per-unit sticker credential with the username ADMIN, and an
// IPMI-only protocol floor because its Redfish is licence-gated. A published-login arm here would be a
// family default copied from another family, which is what this control refuses.
test fn supermicro_answers_a_per_unit_login_and_an_ipmi_floor() -> Bool {
  match bmc_firmware_factory_login(family: SupermicroAten) {
    FactoryLoginPerUnit { username: u, password_form: f, authority: _ } => u == "ADMIN" && string_contains(s: f, pattern: "10 uppercase")
    FactoryLoginPublished { login: _ } => false
  }
    && protocol_count(ps: bmc_firmware_supported_protocols(family: SupermicroAten)) == 1
}
