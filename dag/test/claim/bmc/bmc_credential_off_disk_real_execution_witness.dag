module test.claim.bmc.bmc_credential_off_disk_real_execution_witness

import std.algebra { trim }
import std.types { Bool, FilePath, List, NonEmptyStr, Secret, String, PathSegment }
import std.optional { Absent, Present }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.shell
import gunbc.auth.private_secret_file {
  PrivateSecretFileBracket,
  PrivateSecretFileCompleted,
  PrivateSecretFileCompletedResidueRemains,
  PrivateSecretFileNotEntered,
  PrivateSecretFileNotEnteredResidueRemains,
  with_private_secret_file,
}
import gunbc.auth.netrc_binding { netrc_binding_path, with_private_netrc_binding }
import gunbc.tools.bmc_onboard { bmc_rotate_credential }
import gunbc.bmc.bmc_onboarding { altra_onboarding_plan }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import std.process { ExitSuccess, ExitFailure }
import std.operation_argv { operation_argv_bind_text, operation_argv_tokens_or_refusal_label }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Wet execution witnesses for the BMC credential on disk (gunbc.tools.bmc_onboard bmc_rotate_credential, which wrote its password body to /tmp/bmc_onboard_pwbody.json with the ambient umask and its netrc to /tmp/bmc_onboard_netrc, removing neither). The body now reaches curl on stdin (extdeps.bmc.http SetAccountPassword); the netrc goes through gunbc.auth.netrc_binding with_private_netrc_binding. The srv3 bmcweb login body (formerly /tmp/srv3_bmcweb_login_body.json, ambient umask, never removed) goes through gunbc.auth.private_secret_file with_private_secret_file, the bracket both delegate to; the real srv3 login is not run here because it targets the live srv3 BMC. shell.Mktemp, shell.Stat, shell.Test, shell.Remove and the Redfish curl rows have no mock_response, so hermetic discovery refuses this file; it is excluded from discovery (gunbc.ci.ci_layer_roots witness_exclusion_frontier) and enrolled in bin_witness_wet_entries. No real BMC is contacted: the rotation targets bmc.invalid, which RFC 6761 reserves as never resolving. Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/claim/bmc/bmc_credential_off_disk_real_execution_witness.dag"

data witness_secret: String = "witness-bmc-password-never-real"

// What the bracket's body saw while the credential was on disk: where it was, and its modes.
type SecretFileObservedInside {
  file: String
  dir: String
  file_mode: String
  dir_mode: String
  answered: Bool
}

fn octal_mode(path: String) -> String {
  trim(s: shell.Stat.ModeOf(path: path as FilePath).stdout)
}

// The body stands where the Redfish request runs in production. `answered` is what that request
// would have returned, so one witness runs the arm a successful rotation takes and one runs the arm a
// failed rotation takes. The teardown must not depend on which.
fn observe_inside(path: NonEmptyStr, file_name: String, answered: Bool) -> SecretFileObservedInside {
  let file = path as String
  let dir = replace(s: file, from: concat("/", file_name), to: "")
  SecretFileObservedInside {
    file: file,
    dir: dir,
    file_mode: octal_mode(path: file),
    dir_mode: octal_mode(path: dir),
    answered: answered,
  }
}

fn run_netrc_bracket(answered: Bool) -> PrivateSecretFileBracket<SecretFileObservedInside> {
  with_private_netrc_binding(
    machine: "bmc.invalid" as NonEmptyStr,
    login: "root" as NonEmptyStr,
    password: witness_secret as Secret,
    use: fn(binding) { observe_inside(path: netrc_binding_path(binding: binding) as NonEmptyStr, file_name: "netrc", answered: answered) },
  )
}

// The srv3 login's own call: the file name is the one gunbc.srv3.srv3_os_install_actuate
// srv3_bmcweb_session_login_resolved passes, and the body is a SUPPLIED value in the shape its
// producer emits. Importing that producer would pull the whole host-effect realization into this
// witness's closure (measured: past 15 GiB resident before it was stopped); the producer's own
// output is asserted by test.claim.srv3.srv3_os_install_actuate_witness
// srv3_bmcweb_login_body_snapshot_uses_factory_when_unresolved.
data supplied_login_body: String = "{\"username\":\"root\",\"password\":\"witness-bmc-password-never-real\"}"

fn run_login_body_bracket(answered: Bool) -> PrivateSecretFileBracket<SecretFileObservedInside> {
  with_private_secret_file(
    file_name: "bmcweb_login_body.json" as PathSegment,
    content: supplied_login_body as Secret,
    use: fn(body) { observe_inside(path: body, file_name: "bmcweb_login_body.json", answered: answered) },
  )
}

// Owner-only while it exists, gone afterwards, and the bracket reports it cleaned. A file written
// with the ambient umask reads 644 here; a bracket that skipped the shred, or removed the file but
// not its directory, leaves a path that IsFile or IsDirectory finds.
fn owner_only_inside_and_gone_after(outcome: PrivateSecretFileBracket<SecretFileObservedInside>, answered: Bool) -> Bool {
  match outcome {
    PrivateSecretFileCompleted { value: seen } =>
      seen.answered == answered
        && seen.file_mode == "600"
        && seen.dir_mode == "700"
        && seen.dir != seen.file
        && !shell.Test.IsFile(path: seen.file as FilePath).is_file
        && !shell.Test.IsDirectory(path: seen.dir as FilePath).is_directory
    PrivateSecretFileCompletedResidueRemains { value: _ } => false
    PrivateSecretFileNotEntered { cause: _ } => false
    PrivateSecretFileNotEnteredResidueRemains { cause: _ } => false
  }
}

test fn the_netrc_is_owner_only_and_gone_after_a_call_that_succeeded() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_netrc_bracket(answered: true), answered: true)
}

test fn the_netrc_is_owner_only_and_gone_after_a_call_that_failed() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_netrc_bracket(answered: false), answered: false)
}

test fn the_srv3_login_body_is_owner_only_and_gone_after_a_login_that_succeeded() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_login_body_bracket(answered: true), answered: true)
}

test fn the_srv3_login_body_is_owner_only_and_gone_after_a_login_that_failed() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_login_body_bracket(answered: false), answered: false)
}

// THE REAL ROTATION, FAILING, END TO END. bmc_rotate_credential runs its real route: the private
// netrc is placed, SetAccountPassword receives the body on stdin, curl fails to resolve bmc.invalid,
// and the bracket removes the netrc. The reason is the discriminator: a removal that failed would
// replace "password PATCH refused" with the residue reason, and a placement that failed would say the
// BMC was not called.
test fn a_failed_rotation_reaches_the_bmc_call_and_leaves_no_credential_behind() -> Bool {
  let plan = altra_onboarding_plan(host: operator_host_srv3, bmc_host: "bmc.invalid" as NonEmptyStr)
  match bmc_rotate_credential(plan: plan, current_password: witness_secret as Secret, new_credential: "witness-new-password" as Secret) {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } =>
      string_contains(s: r as String, pattern: "rotate: password PATCH refused")
        && !string_contains(s: r as String, pattern: "could not be removed")
        && !string_contains(s: r as String, pattern: "was not called")
  }
}

// THE BODY HAS NO PATH TO LEAVE BEHIND. The password-bearing body is a declared input of
// SetAccountPassword that no argv word reads, and curl is told to read the body from stdin. Reverting
// the operation to `--data @{request_body_file}` refuses this binding as UndeclaredInputBound, and a
// body interpolated into argv would carry the sentinel into the materialized words.
fn set_account_password_argv() -> List<String> {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      "dag/extdeps/bmc/http.dag",
      "redfish.Http",
      "SetAccountPassword",
      [
        operation_argv_bind_text(name: "bmc_host", text: "bmc.invalid"),
        operation_argv_bind_text(name: "netrc_file", text: "/fixture/netrc"),
        operation_argv_bind_text(name: "account_id", text: "root"),
        operation_argv_bind_text(name: "request_body", text: witness_secret),
      ]
    )
  )
}

test fn the_password_body_reaches_curl_on_stdin_and_never_as_a_path() -> Bool {
  let argv = set_account_password_argv()
  any(argv, a => a == "curl")
    && any(argv, a => a == "@-")
    && !any(argv, a => string_contains(s: a, pattern: witness_secret))
    && !any(argv, a => starts_with(s: a, prefix: "@") && a != "@-")
}

// A FILE NAME THAT LEAVES THE BRACKET'S DIRECTORY IS REFUSED BEFORE ANYTHING IS CREATED. The sentinel
// sits in the directory the bracket's own `mktemp -d` would be created in (RUNNER_TEMP, else TMPDIR,
// else /tmp), so "../<sentinel>" names exactly it. Without the path_segment_is_safe guard in
// with_private_secret_file, the O_EXCL write refuses because the sentinel exists, and the
// failed-write cleanup rm -f's it: the sentinel would be gone. Without O_EXCL it would be
// overwritten with the secret. With the guard, `use` is not entered and the sentinel is unchanged.
fn temp_parent() -> String {
  match shell.Env.Get(name: "RUNNER_TEMP" as NonEmptyStr).value {
    Present { value: r } => if trim(s: r) != "" { trim(s: r) } else { tmpdir_or_tmp() }
    Absent => tmpdir_or_tmp()
  }
}

fn tmpdir_or_tmp() -> String {
  match shell.Env.Get(name: "TMPDIR" as NonEmptyStr).value {
    Present { value: t } => if trim(s: t) != "" { trim(s: t) } else { "/tmp" }
    Absent => "/tmp"
  }
}

data sentinel_original: String = "sentinel-original-bytes-not-a-secret"

test fn a_file_name_that_leaves_the_bracket_directory_is_refused_and_touches_nothing_outside() -> Bool {
  let parent = temp_parent()
  let made = shell.Mktemp.FileInDirectory(dir: parent as FilePath)
  let sentinel = trim(s: made.path as String)
  let wrote = Filesystem.Write(path: sentinel, content: sentinel_original)
  let base = replace(s: sentinel, from: concat(parent, "/"), to: "")
  let name = concat("../", base)
  let entered = match with_private_secret_file(
    file_name: name as PathSegment,
    content: witness_secret as Secret,
    use: fn(path) { true },
  ) {
    PrivateSecretFileNotEntered { cause: _ } => false
    PrivateSecretFileNotEnteredResidueRemains { cause: _ } => true
    PrivateSecretFileCompleted { value: _ } => true
    PrivateSecretFileCompletedResidueRemains { value: _ } => true
  }
  let after = Filesystem.Read(path: sentinel)
  let cleaned = shell.Remove.FileForce(path: sentinel as FilePath).success
  made.success && wrote.success
    && base != sentinel
    && !string_contains(s: base, pattern: "/")
    && !entered
    && after.success
    && after.content == sentinel_original
    && cleaned
}

