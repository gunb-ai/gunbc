module test.claim.bmc.bmc_credential_off_disk_real_execution_witness

import std.algebra { trim }
import std.types { Bool, FilePath, List, NonEmptyStr, Secret, String }
import extdeps.shell
import gunbc.auth.netrc_binding {
  NetrcBracket,
  NetrcBracketCompleted,
  NetrcBracketCompletedResidueRemains,
  NetrcBracketNotEntered,
  NetrcBracketNotEnteredResidueRemains,
  with_private_netrc_binding,
}
import gunbc.tools.bmc_onboard { bmc_rotate_credential }
import gunbc.bmc.bmc_onboarding { altra_onboarding_plan }
import gunbc.fleet.fleet_host_identity { operator_host_srv3 }
import std.process { ExitSuccess, ExitFailure }
import std.operation_argv { operation_argv_bind_text, operation_argv_tokens_or_refusal_label }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data real_execution_home_doc: String = "Wet execution witnesses for the BMC credential on disk (gunbc.tools.bmc_onboard bmc_rotate_credential, which wrote its password body to /tmp/bmc_onboard_pwbody.json with the ambient umask and its netrc to /tmp/bmc_onboard_netrc, removing neither). The body now reaches curl on stdin (extdeps.bmc.http SetAccountPassword); the netrc goes through gunbc.auth.netrc_binding with_private_netrc_binding. shell.Mktemp, shell.Stat, shell.Test, shell.Remove and the Redfish curl rows have no mock_response, so hermetic discovery refuses this file; it is excluded from discovery (gunbc.ci.ci_layer_roots witness_exclusion_frontier) and enrolled in bin_witness_wet_entries. No real BMC is contacted: the rotation targets bmc.invalid, which RFC 6761 reserves as never resolving. Local recipe: claim_batch --wet --source-root dag --source-root src/v2 --entry dag/test/claim/bmc/bmc_credential_off_disk_real_execution_witness.dag"

data witness_secret: String = "witness-bmc-password-never-real"

// What the bracket's body saw while the credential was on disk: where it was, and its modes.
type NetrcObservedInside {
  file: String
  dir: String
  file_mode: String
  dir_mode: String
  answered: Bool
}

fn octal_mode(path: String) -> String {
  trim(s: shell.Stat.ModeOf(path: path as FilePath).stdout)
}

// The body stands where the Redfish request runs in production. `answered` is what that request
// would have returned, so one witness runs the arm a successful rotation takes and one runs the arm a
// failed rotation takes. The teardown must not depend on which.
fn observe_inside(netrc: NonEmptyStr, answered: Bool) -> NetrcObservedInside {
  let file = netrc as String
  let dir = replace(s: file, from: "/netrc", to: "")
  NetrcObservedInside {
    file: file,
    dir: dir,
    file_mode: octal_mode(path: file),
    dir_mode: octal_mode(path: dir),
    answered: answered,
  }
}

fn run_bracket(answered: Bool) -> NetrcBracket<NetrcObservedInside> {
  with_private_netrc_binding(
    machine: "bmc.invalid" as NonEmptyStr,
    login: "root" as NonEmptyStr,
    password: witness_secret as Secret,
    use: fn(netrc) { observe_inside(netrc: netrc, answered: answered) },
  )
}

// Owner-only while it exists, gone afterwards, and the bracket reports it cleaned. A file written
// with the ambient umask reads 644 here; a bracket that skipped the shred, or removed the file but
// not its directory, leaves a path that IsFile or IsDirectory finds.
fn owner_only_inside_and_gone_after(outcome: NetrcBracket<NetrcObservedInside>, answered: Bool) -> Bool {
  match outcome {
    NetrcBracketCompleted { value: seen } =>
      seen.answered == answered
        && seen.file_mode == "600"
        && seen.dir_mode == "700"
        && seen.dir != seen.file
        && !shell.Test.IsFile(path: seen.file as FilePath).is_file
        && !shell.Test.IsDirectory(path: seen.dir as FilePath).is_directory
    NetrcBracketCompletedResidueRemains { value: _ } => false
    NetrcBracketNotEntered { cause: _ } => false
    NetrcBracketNotEnteredResidueRemains { cause: _ } => false
  }
}

test fn the_netrc_is_owner_only_and_gone_after_a_call_that_succeeded() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_bracket(answered: true), answered: true)
}

test fn the_netrc_is_owner_only_and_gone_after_a_call_that_failed() -> Bool {
  owner_only_inside_and_gone_after(outcome: run_bracket(answered: false), answered: false)
}

// THE REAL ROTATION, FAILING, END TO END. bmc_rotate_credential runs its real route: the private
// netrc is placed, SetAccountPassword receives the body on stdin, curl fails to resolve bmc.invalid,
// and the bracket removes the netrc. The reason is the discriminator: a removal that failed would
// replace "password PATCH refused" with the residue reason, and a placement that failed would say the
// BMC was not called.
test fn a_failed_rotation_reaches_the_bmc_call_and_leaves_no_credential_behind() -> Bool {
  let plan = altra_onboarding_plan(host: operator_host_srv3, bmc_host: "bmc.invalid" as NonEmptyStr)
  match bmc_rotate_credential(plan: plan, current_password: witness_secret as Secret, new_credential: "witness-new-password" as Secret) {
    ExitSuccess => false
    ExitFailure { code: _, reason: r } =>
      string_contains(s: r as String, pattern: "rotate: password PATCH refused")
        && !string_contains(s: r as String, pattern: "could not be removed")
        && !string_contains(s: r as String, pattern: "was not called")
  }
}

// THE BODY HAS NO PATH TO LEAVE BEHIND. The password-bearing body is a declared input of
// SetAccountPassword that no argv word reads, and curl is told to read the body from stdin. Reverting
// the operation to `--data @{request_body_file}` refuses this binding as UndeclaredInputBound, and a
// body interpolated into argv would carry the sentinel into the materialized words.
fn set_account_password_argv() -> List<String> {
  operation_argv_tokens_or_refusal_label(
    m: shell_materialize_operation_argv(
      "dag/extdeps/bmc/http.dag",
      "redfish.Http",
      "SetAccountPassword",
      [
        operation_argv_bind_text(name: "bmc_host", text: "bmc.invalid"),
        operation_argv_bind_text(name: "netrc_file", text: "/fixture/netrc"),
        operation_argv_bind_text(name: "account_id", text: "root"),
        operation_argv_bind_text(name: "request_body", text: witness_secret),
      ]
    )
  )
}

test fn the_password_body_reaches_curl_on_stdin_and_never_as_a_path() -> Bool {
  let argv = set_account_password_argv()
  any(argv, a => a == "curl")
    && any(argv, a => a == "@-")
    && !any(argv, a => string_contains(s: a, pattern: witness_secret))
    && !any(argv, a => starts_with(s: a, prefix: "@") && a != "@-")
}
