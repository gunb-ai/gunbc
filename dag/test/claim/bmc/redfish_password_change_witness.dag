module test.claim.bmc.redfish_password_change_witness

import std.types { Bool, String }
import extdeps.bmc.redfish { redfish_password_change_verdict, RedfishPasswordChangeRequired, RedfishPasswordChangeNotIndicated }
import gunbc.tools.bmc_onboard { factory_login_accepted }

// The body srv13's OpenBMC 3.22.00 returned for a GET of /redfish/v1/Systems/system with the
// published root credential, 2026-10-08 (artifacts/bmc/srv13-first-contact-2026-10-07/
// bmc-3.22.00-factory-login-403.json), whitespace removed.
data srv13_factory_login_403_body: String = "{\"@Message.ExtendedInfo\":[{\"@odata.type\":\"#Message.v1_1_1.Message\",\"Message\":\"The password provided for this account must be changed before access is granted.  PATCH the Password property for this account located at the target URI '/redfish/v1/AccountService/Accounts/root' to complete this process.\",\"MessageArgs\":[\"/redfish/v1/AccountService/Accounts/root\"],\"MessageId\":\"Base.1.16.0.PasswordChangeRequired\",\"MessageSeverity\":\"Critical\",\"Resolution\":\"Change the password for this account using a PATCH to the Password property at the URI provided.\"}]}"

data error_wrapped_body: String = "{\"error\":{\"code\":\"Base.1.8.PasswordChangeRequired\",\"message\":\"x\",\"@Message.ExtendedInfo\":[{\"MessageId\":\"Base.1.8.PasswordChangeRequired\"}]}}"

data insufficient_privilege_body: String = "{\"error\":{\"@Message.ExtendedInfo\":[{\"MessageId\":\"Base.1.16.0.InsufficientPrivilege\"}]}}"

data oem_registry_body: String = "{\"@Message.ExtendedInfo\":[{\"MessageId\":\"Oem.1.0.PasswordChangeRequired\"}]}"

data system_body: String = "{\"@odata.id\":\"/redfish/v1/Systems/system\",\"PowerState\":\"Off\"}"

fn required(body: String) -> Bool {
  match redfish_password_change_verdict(body: body) {
    RedfishPasswordChangeRequired => true
    RedfishPasswordChangeNotIndicated => false
  }
}

// The observed body and the standard error-object form both indicate the change; another Base
// message, a non-Base registry, a success body and a non-JSON body do not.
test fn password_change_required_is_read_from_the_base_registry_message() -> Bool {
  required(body: srv13_factory_login_403_body)
    && required(body: error_wrapped_body)
    && !required(body: insufficient_privilege_body)
    && !required(body: oem_registry_body)
    && !required(body: system_body)
    && !required(body: "401 Unauthorized")
}

// A change-required refusal admits the published credential; any other refusal does not, and a
// success admits it regardless of body.
test fn factory_login_is_accepted_when_the_bmc_demands_a_password_change() -> Bool {
  factory_login_accepted(succeeded: false, body: srv13_factory_login_403_body)
    && !factory_login_accepted(succeeded: false, body: "401 Unauthorized")
    && !factory_login_accepted(succeeded: false, body: insufficient_privilege_body)
    && factory_login_accepted(succeeded: true, body: system_body)
}
