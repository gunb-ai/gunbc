module test.claim.power_watt

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn total_power_watts(components: List<Watt>) -> Watt {
  watt(count: fold(components, init: 0, f: (acc, w) => acc + watt_count(w: w)))
}

data example_component_draws: List<Watt> = [
  watt(count: 166),
  watt(count: 3), watt(count: 3), watt(count: 3), watt(count: 3),
  watt(count: 3), watt(count: 3), watt(count: 3), watt(count: 3),
  watt(count: 30)
]

test fn total_power_is_computed_sum() -> Bool {
  watt_count(w: total_power_watts(components: example_component_draws)) == 220
}

test fn empty_budget_is_zero_watts() -> Bool {
  watt_count(w: total_power_watts(components: [])) == 0
}

test fn watt_roundtrips() -> Bool {
  watt_count(w: watt(count: 183)) == 183
}

