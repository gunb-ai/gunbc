module test.claim.dispatch_attempts_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

data dispatch_attempts_witness_note: String = "U3's receipts: the attempt-branch parse proven on real shapes (an attempt-grain branch round-trips node and key; a LEGACY pre-attempt-grain branch — the operator's accidental spawn class — parses with an empty key rather than filtering as noise; garbage refuses), the wire projection proven on synthetic observations both arms, and the client machinery pinned in the served asset. The round-trip witness closes the loop with U1: a branch MINTED by dispatch_branch_name must parse back to its own node and key — the two authorities cannot drift."

fn attempt_fixture() -> gunbc.roadmap_dispatch_actuator.DispatchAttemptRef {
  gunbc.roadmap_dispatch_actuator.DispatchAttemptRef { node_id: "5-regen-cutover", branch: "dispatch/5-regen-cutover-afeedfacefeedface", attempt_key: "feedfacefeedface" }
}

test fn attempts_parse_roundtrips_the_minted_branch() -> Bool {
  let k = gunbc.roadmap_dispatch_actuator.dispatch_attempt_key(node_id: "ts-wf-progress", probed_at: "2026-07-25T22:00:00Z")
  let b = gunbc.roadmap_dispatch_actuator.dispatch_branch_name(node_id: "ts-wf-progress", attempt_key: k)
  return match gunbc.roadmap_dispatch_actuator.parse_dispatch_attempt_branch(line: b) {
    Present { value: r } => r.node_id == "ts-wf-progress" && r.attempt_key == k && r.branch == b
    Absent => false
  }
}

test fn attempts_parse_holds_on_the_three_shapes() -> Bool {
  let modern = gunbc.roadmap_dispatch_actuator.parse_dispatch_attempt_branch(line: "dispatch/5-regen-cutover-afeedfacefeedface")
  let legacy = gunbc.roadmap_dispatch_actuator.parse_dispatch_attempt_branch(line: "dispatch/ts-authority-converge")
  let empty_node = gunbc.roadmap_dispatch_actuator.parse_dispatch_attempt_branch(line: "dispatch/-afeedfacefeedface")
  let garbage = gunbc.roadmap_dispatch_actuator.parse_dispatch_attempt_branch(line: "refs/stash")
  return match modern {
    Present { value: m } => m.node_id == "5-regen-cutover" && m.attempt_key == "feedfacefeedface"
    Absent => false
  } && match legacy {
    Present { value: l } => l.node_id == "ts-authority-converge" && l.attempt_key == ""
    Absent => false
  } && match empty_node {
    Present { value: e } => false
    Absent => true
  } && match garbage {
    Present { value: g2 } => false
    Absent => true
  }
}

test fn attempts_multi_line_output_parses() -> Bool {
  let out = "dispatch/node-x-afeedfacefeedface\ndispatch/ts-authority-converge\n"
  let refs = gunbc.roadmap_dispatch_actuator.dispatch_attempt_refs(git_output: out)
  return count(refs) == 2
    && any(refs, r => r.node_id == "node-x" && r.attempt_key == "feedfacefeedface")
    && any(refs, r => r.node_id == "ts-authority-converge" && r.attempt_key == "")
}

test fn attempts_observed_projects_to_wire() -> Bool {
  let j = gunbc.roadmap_belt_actuate.belt_attempts_observed_json(a: gunbc.roadmap_belt_actuate.AttemptsObserved { attempts: [attempt_fixture()] })
  return string_contains(s: j, pattern: "\"schema\": \"roadmap-attempts/v1\"")
    && string_contains(s: j, pattern: "\"attempts_refused\": false")
    && string_contains(s: j, pattern: "\"branch\": \"dispatch/5-regen-cutover-afeedfacefeedface\"")
    && string_contains(s: j, pattern: "\"worktree_evidence\": \"unobserved\"")
    && string_contains(s: j, pattern: "\"provider_evidence\": \"unobserved\"")
    && string_contains(s: j, pattern: "\"process_identity_evidence\": \"unobserved\"")
    && string_contains(s: j, pattern: "\"transcript_evidence\": \"unobserved\"")
    && string_contains(s: j, pattern: "\"terminal_outcome_evidence\": \"unobserved\"")
    && gunbc.roadmap_belt_actuate.belt_attempts_http_status(a: gunbc.roadmap_belt_actuate.AttemptsObserved { attempts: [] }) == 200
}

test fn attempts_refusal_is_loud_on_the_wire() -> Bool {
  let a = gunbc.roadmap_belt_actuate.AttemptsRefused { reason: "git not found on PATH — the attempts set is unknowable" }
  let j = gunbc.roadmap_belt_actuate.belt_attempts_observed_json(a: a)
  return string_contains(s: j, pattern: "\"attempts_refused\": true")
    && string_contains(s: j, pattern: "unknowable")
    && gunbc.roadmap_belt_actuate.belt_attempts_http_status(a: a) == 503
    && !string_contains(s: j, pattern: "\"attempts\":")
}

test fn attempts_client_renders_and_shouts() -> Bool {
  let js = gunbc.roadmap_component.dispatch_client_js_source()
  return string_contains(s: js, pattern: join(["fetch('", gunbc.roadmap_component.attempts_route_path, "')"], ""))
    && string_contains(s: js, pattern: "aj.attempts_refused")
    && string_contains(s: js, pattern: join(["const ", gunbc.roadmap_component.js_attempts_observe_fn, " ="], ""))
    && string_contains(s: js, pattern: join([gunbc.roadmap_component.js_attempts_observe_fn, "()"], ""))
    && string_contains(s: js, pattern: "querySelectorAll('.dispatch-attempts')")
    && string_contains(s: js, pattern: "staleAttempts.remove()")
    && string_contains(s: js, pattern: "oldAttempts.remove()")
    && string_contains(s: js, pattern: "'dispatch-attempts'")
    && string_contains(s: js, pattern: "att.branch")
    && string_contains(s: js, pattern: "attempt observation refused: ")
    && string_contains(s: js, pattern: "session observation refused: ")
}

test fn attempts_row_is_styled() -> Bool {
  return string_contains(s: gunbc.roadmap_style.roadmap_css(), pattern: ".dispatch-attempts { font-size: var(--text-11); font-family: var(--font-mono); color: var(--text-dim); margin: var(--space-2) var(--space-0) var(--space-1) }")
}

test fn attempts_argv_is_typed_and_scoped() -> Bool {
  let cmd = gunbc.roadmap_dispatch_actuator.git_for_each_ref_dispatch_argv()
  return cmd.program == "git"
    && any(cmd.args, a => a == "refs/heads/dispatch/")
    && !any(cmd.args, a => a == "-rf")
}

// U1's own REDs: redispatch works exactly when a NEW attempt yields a NEW branch/worktree/uuid while the tmux name — the observe/reconcile key — stays node-grain. Fresh where debris collides, stable where identity reconciles. Homed beside U3's parse witnesses because the two are the same authority read in both directions: this row proves the MINT varies per attempt, attempts_parse_roundtrips_the_minted_branch proves the READ recovers exactly what was minted.
test fn belt_attempt_grain_holds() -> Bool {
  let n = "5-regen-cutover"
  let t1 = "2026-07-25T20:00:00Z"
  let t2 = "2026-07-25T21:30:00Z"
  let k1 = gunbc.roadmap_dispatch_actuator.dispatch_attempt_key(node_id: n, probed_at: t1)
  let k2 = gunbc.roadmap_dispatch_actuator.dispatch_attempt_key(node_id: n, probed_at: t2)
  return k1 != k2
    && k1 == gunbc.roadmap_dispatch_actuator.dispatch_attempt_key(node_id: n, probed_at: t1)
    && gunbc.roadmap_dispatch_actuator.dispatch_branch_name(node_id: n, attempt_key: k1) != gunbc.roadmap_dispatch_actuator.dispatch_branch_name(node_id: n, attempt_key: k2)
    && gunbc.roadmap_dispatch_actuator.dispatch_worktree_path(node_id: n, attempt_key: k1) != gunbc.roadmap_dispatch_actuator.dispatch_worktree_path(node_id: n, attempt_key: k2)
    && gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: n, probed_at: t1) != gunbc.roadmap_belt_actuate.belt_spawn_session_uuid(node_id: n, probed_at: t2)
    && string_contains(s: gunbc.roadmap_dispatch_actuator.dispatch_branch_name(node_id: n, attempt_key: k1), pattern: "dispatch/5-regen-cutover-a")
}
