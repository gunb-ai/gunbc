module test.claim.process_lease_plan_is_not_a_refusal_witness

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_rows_of_class,
  census_total_count,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A PLAN IS WHAT `Apply` EXECUTES, SO A REFUSAL IS NOT ONE. gunbc.session_lease used to carry
// RefuseForeignOwner as a third ProcessLeasePlan, which made `Apply { plan: RefuseForeignOwner }`
// -- execute the refusal -- a writable state that every consumer of the decision had to answer
// for and that no producer could ever reach. decision_for_process_port_verdict already answers a
// foreign owner on the `Refuse` arm, with the reason attached, so the plan was a second
// representation of one fact rather than a fourth outcome.
//
// These two fixtures are what keeps that wall observed. Both import the real module, so
// re-adding the variant makes the negative go quiet and this file fail. The pair discriminates:
// they differ only in WHICH plan is written into the same `Apply`, so a green negative cannot be
// explained by `Apply` being unusable.

data refusal_as_a_plan_source: String = "module process_lease_plan_negative\nimport gunbc.session_lease { ProcessLeasePlan }\nimport std.upsert_decision { UpsertDecision, Apply }\nfn f() -> UpsertDecision<ProcessLeasePlan> {\n  Apply { plan: RefuseForeignOwner }\n}\n"

data start_as_a_plan_source: String = "module process_lease_plan_positive\nimport gunbc.session_lease { ProcessLeasePlan, Start }\nimport std.upsert_decision { UpsertDecision, Apply }\nfn f() -> UpsertDecision<ProcessLeasePlan> {\n  Apply { plan: Start }\n}\n"

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } =>
      census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn w_a_refusal_cannot_be_written_as_a_lease_plan() -> Bool {
  blocking_count(source: refusal_as_a_plan_source) > 0
}

test fn w_a_real_plan_on_the_same_arm_is_admitted() -> Bool {
  blocking_count(source: start_as_a_plan_source) == 0
}
