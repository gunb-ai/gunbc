import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data gb: Nat = 1000000000

fn rdimm(part: NonEmptyStr, capacity: Nat) -> DramModuleCatalogRow {
  DramModuleCatalogRow {
    part_number: part,
    manufacturer: samsung,
    generation: dram_generation_ddr4,
    capacity_bytes: byte_size(count: capacity),
    data_rate_mts: 3200,
    ecc: true,
    buffering: Registered,
    chip_width: bit_width(count: 4),
    rank_count: 2,
  }
}

fn rdimm_16g() -> DramModuleCatalogRow { rdimm(part: "SYNTH-16G", capacity: 16 * gb) }
fn rdimm_32g() -> DramModuleCatalogRow { rdimm(part: "SYNTH-32G", capacity: 32 * gb) }
fn rdimm_64g() -> DramModuleCatalogRow { rdimm(part: "SYNTH-64G", capacity: 64 * gb) }

// ---------------------------------------------------------------------------
// The surveyed market: the ratios are READ from cited rows, not asserted.
// ---------------------------------------------------------------------------

// The two providers whose arm64 surfaces publish three GB per vCPU. Asserted
// through the derivation so the number comes from the fetched rows.
test fn ubicloud_and_blacksmith_publish_three_gb_per_arm_vcpu() -> Bool {
  let rows = surveyed_runner_shapes()
  match memory_per_vcpu(rows: rows, provider: ubicloud_provider_identity, architecture: Aarch64) {
    UniformMemoryPerVcpu { per_vcpu, sizes_agreeing } =>
      quoted_numeral(quoted: per_vcpu) == 3
        && sizes_agreeing == 5
        && match memory_per_vcpu(rows: rows, provider: blacksmith_provider_identity, architecture: Aarch64) {
          UniformMemoryPerVcpu { per_vcpu, sizes_agreeing } =>
            quoted_numeral(quoted: per_vcpu) == 3 && sizes_agreeing == 5
          RatioNotUniformAcrossSizes { first_per_vcpu, divergent_label, divergent_per_vcpu } => false
          NonIntegralRatioInSizes { label } => false
          NoShapesForProviderArchitecture => false
        }
    RatioNotUniformAcrossSizes { first_per_vcpu, divergent_label, divergent_per_vcpu } => false
    NonIntegralRatioInSizes { label } => false
    NoShapesForProviderArchitecture => false
  }
}

// Depot publishes four GB per arm vCPU, so the market is not one ratio.
test fn depot_publishes_four_gb_per_arm_vcpu() -> Bool {
  match memory_per_vcpu(
    rows: surveyed_runner_shapes(),
    provider: depot_provider_identity,
    architecture: Aarch64,
  ) {
    UniformMemoryPerVcpu { per_vcpu, sizes_agreeing } => quoted_numeral(quoted: per_vcpu) == 4
    RatioNotUniformAcrossSizes { first_per_vcpu, divergent_label, divergent_per_vcpu } => false
    NonIntegralRatioInSizes { label } => false
    NoShapesForProviderArchitecture => false
  }
}

// RED CONTROL on the census itself — a provider whose published sizes DISAGREE
// refuses instead of reporting a provider-level constant. GitHub's arm64 sizes
// are mostly four GB per vCPU but include a 5-vCPU/14 GB size, so a collapsed
// figure would have silently discarded a real published shape.
test fn a_provider_with_non_uniform_sizes_refuses_a_single_ratio() -> Bool {
  match memory_per_vcpu(
    rows: surveyed_runner_shapes(),
    provider: github_actions_provider_identity,
    architecture: Aarch64,
  ) {
    NonIntegralRatioInSizes { label } => true
    RatioNotUniformAcrossSizes { first_per_vcpu, divergent_label, divergent_per_vcpu } => true
    UniformMemoryPerVcpu { per_vcpu, sizes_agreeing } => false
    NoShapesForProviderArchitecture => false
  }
}

// The x64 side is not uniformly four either: CircleCI's x86 Docker classes are
// two GB per vCPU. This is the row that refutes "1:4 everywhere".
test fn circleci_x86_docker_is_two_gb_per_vcpu() -> Bool {
  match memory_per_vcpu(
    rows: surveyed_runner_shapes(),
    provider: circleci_provider_identity,
    architecture: X86_64,
  ) {
    UniformMemoryPerVcpu { per_vcpu, sizes_agreeing } => quoted_numeral(quoted: per_vcpu) == 2
    RatioNotUniformAcrossSizes { first_per_vcpu, divergent_label, divergent_per_vcpu } => false
    NonIntegralRatioInSizes { label } => false
    NoShapesForProviderArchitecture => false
  }
}

// Only one surveyed provider states what a vCPU is backed by; the rest are
// Unstated. Asserted in BOTH directions so the unstated arm is known to be a
// real reading of the pages and not a constructor nobody reaches.
test fn only_ubicloud_states_a_dedicated_core_entitlement() -> Bool {
  let ubicloud_arm = filter(
    runner_shape_rows(availability: ubicloud_runner_catalog_shapes),
    r => r.architecture == Aarch64,
  )
  let blacksmith_arm = filter(
    runner_shape_rows(availability: blacksmith_runner_catalog),
    r => r.architecture == Aarch64,
  )
  count(ubicloud_arm) != 0
    && all(ubicloud_arm, r => match r.entitlement {
      DedicatedPhysicalCore => true
      SmtSharedVcpu { threads_per_core } => false
      EntitlementUnstated => false
    })
    && count(blacksmith_arm) != 0
    && all(blacksmith_arm, r => match r.entitlement {
      EntitlementUnstated => true
      DedicatedPhysicalCore => false
      SmtSharedVcpu { threads_per_core } => false
    })
}

// Ubicloud's x64 vCPU is an SMT thread, so its four GB per vCPU is EIGHT GB
// per physical core — the cross-frame comparison this whole model exists to
// make visible.
test fn ubicloud_x64_entitlement_is_an_smt_thread() -> Bool {
  all(
    filter(runner_shape_rows(availability: ubicloud_runner_catalog_shapes), r => r.architecture == X86_64),
    r => match r.entitlement {
      SmtSharedVcpu { threads_per_core } => threads_per_core == 2
      DedicatedPhysicalCore => false
      EntitlementUnstated => false
    },
  )
}

// ---------------------------------------------------------------------------
// Profiles: cited, basis-declared, and refusing when either is missing.
// ---------------------------------------------------------------------------

// Every declared profile names at least one cited row, and the value profile
// names two. The list is nonempty by construction, so this asserts the count
// the profiles actually carry rather than that the field was filled in.
test fn every_declared_profile_carries_a_nonempty_cited_basis() -> Bool {
  all(declared_service_profiles(), p => basis_count(b: p.basis) >= 1)
    && basis_count(b: arm_value_profile.basis) == 2
    && basis_count(b: x64_standard_profile.basis) == 4
}

// The declared basis converts; three decimal GB is 3e9 bytes.
test fn a_declared_decimal_basis_converts_to_bytes() -> Bool {
  match entitlement_bytes(profile: arm_value_profile) {
    EntitlementBytesDeclared { bytes } => byte_size_count(b: bytes) == 3 * gb
    EntitlementBytesBasisUndeclared => false
  }
}

// POSITIVE CONTROL on the basis axis: the same quoted 3 under a BINARY basis
// is a different number of bytes. If this equalled the row above, the basis
// field would be decoration.
test fn the_same_quoted_figure_differs_under_a_binary_basis() -> Bool {
  match entitlement_bytes(
    profile: RunnerServiceProfile {
      label: "arm-value-binary",
      architecture: Aarch64,
      entitlement: DedicatedPhysicalCore,
      memory_per_entitlement: QuotedBinaryGibibytes { value: gibibyte(count: 3) },
      basis: arm_value_profile.basis,
    },
  ) {
    EntitlementBytesDeclared { bytes } =>
      byte_size_count(b: bytes) == 3 * 1073741824 && byte_size_count(b: bytes) != 3 * gb
    EntitlementBytesBasisUndeclared => false
  }
}

// RED CONTROL — an undeclared basis refuses the conversion rather than picking
// a reading. The spread is over seven percent, which is larger than the gap
// between two DIMM SKUs at this target.
test fn an_undeclared_basis_refuses_the_capacity_derivation() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: RunnerServiceProfile {
      label: "basis-undeclared",
      architecture: Aarch64,
      entitlement: DedicatedPhysicalCore,
      memory_per_entitlement: QuotedWithoutBasis { numeral: 3, unit_label: "GB" },
      basis: arm_value_profile.basis,
    },
    modules: [rdimm_64g()],
  ) {
    ProfileCapacityRefused { profile_label, cause } =>
      match cause {
        ProfileBasisUndeclared => true
        ProfileEntitlementUnstated => false
        ProfilePopulationRefused { cause } => false
      }
    ProfileCapacitiesDerived { capacities } => false
  }
}

// RED CONTROL — an unstated entitlement cannot be counted, and refuses rather
// than falling back to physical cores. The fallback would have been the
// conservative number, which is exactly why it would have gone unnoticed.
test fn an_unstated_entitlement_refuses_rather_than_assuming_cores() -> Bool {
  match cpu_entitlement_supply(cpu: altra_q6430_catalog, entitlement: EntitlementUnstated) {
    EntitlementKindUnstated => true
    EntitlementsAvailable { count } => false
  }
}

// ---------------------------------------------------------------------------
// The derivation on a real board and a real processor.
// ---------------------------------------------------------------------------

// Q64-30 is 64 physical cores. Under the value profile that is 192 GB and
// eight 32 GB DIMMs (256 GB) serve all 64 entitlements — CPU-bound, meaning
// the memory is not the limit and a larger DIMM buys no more service.
test fn q6430_under_the_value_profile_is_cpu_bound_at_64_entitlements() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: arm_value_profile,
    modules: [rdimm_32g()],
  ) {
    ProfileCapacitiesDerived { capacities } =>
      count(capacities) == 1
        && all(
          capacities,
          c =>
            c.dimm_count == 8
              && c.cpu_entitlements == 64
              && c.memory_entitlements == 85
              && c.servable_entitlements == 64
              && c.surplus_entitlements == 21
              && match c.bound {
                CpuBound => true
                EvenlyBound => false
              },
        )
    ProfileCapacityRefused { profile_label, cause } => false
  }
}

// THE PROFILE CHANGES THE ANSWER, which is why one architecture-neutral figure
// could not have been enough: the memory profile's 4 GB per core needs 256 GB
// on the same processor, so eight 32 GB DIMMs land EXACTLY on the target and
// the board becomes evenly bound rather than CPU-bound.
test fn the_memory_profile_moves_the_same_board_to_evenly_bound() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: arm_memory_profile,
    modules: [rdimm_32g()],
  ) {
    ProfileCapacitiesDerived { capacities } =>
      all(
        capacities,
        c =>
          c.cpu_entitlements == 64
            && c.memory_entitlements == 64
            && c.surplus_entitlements == 0
            && match c.bound {
              EvenlyBound => true
              CpuBound => false
            },
      )
    ProfileCapacityRefused { profile_label, cause } => false
  }
}

// SURPLUS IS THE LIVE QUANTITY, and this row exists to prove it varies rather
// than being a constant nobody reads: a two-per-channel board carrying sixteen
// 16 GB DIMMs reaches 256 GB, which is 85 entitlements against a 64-core
// socket — CPU-bound with 21 spare, the same verdict as the 32 GB population
// but a different surplus.
//
// There is deliberately no memory-bound counterpart: admission requires the
// population to meet the target, so a memory-bound admitted reading is
// unwritable, and a board that cannot feed its socket surfaces as an
// unreachable-target refusal instead (witnessed separately below).
test fn surplus_varies_while_the_bound_verdict_stays_cpu_bound() -> Bool {
  match derive_profile_capacity(
    geometry: MemoryChannelGeometry {
      board_label: "synthetic 8-channel 2DPC",
      channels: 8,
      max_topology: TwoDimmsPerChannel,
      authority: asrock_altrad8ud_1l2t_geometry.authority,
    },
    cpu: altra_q6430_catalog,
    profile: arm_value_profile,
    modules: [rdimm_16g()],
  ) {
    ProfileCapacitiesDerived { capacities } =>
      any(
        capacities,
        c =>
          c.dimm_count == 16
            && c.memory_entitlements == 85
            && c.surplus_entitlements == 21
            && match c.bound {
              CpuBound => true
              EvenlyBound => false
            },
      )
    ProfileCapacityRefused { profile_label, cause } => false
  }
}

// EVERY population is full-channel: on a one-DIMM-per-channel board exactly
// one option per module at eight DIMMs, and on a two-per-channel board two
// options. No six-module population is expressible.
test fn populations_are_full_channel_and_topology_derived() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: arm_value_profile,
    modules: [rdimm_64g()],
  ) {
    ProfileCapacitiesDerived { capacities } =>
      count(capacities) == 1
        && all(capacities, c => c.dimm_count == 8)
        && match derive_profile_capacity(
          geometry: MemoryChannelGeometry {
            board_label: "synthetic 8-channel 2DPC",
            channels: 8,
            max_topology: TwoDimmsPerChannel,
            authority: asrock_altrad8ud_1l2t_geometry.authority,
          },
          cpu: altra_q6430_catalog,
          profile: arm_value_profile,
          modules: [rdimm_64g()],
        ) {
          ProfileCapacitiesDerived { capacities } =>
            count(capacities) == 2
              && any(capacities, c => c.dimm_count == 8)
              && any(capacities, c => c.dimm_count == 16)
          ProfileCapacityRefused { profile_label, cause } => false
        }
    ProfileCapacityRefused { profile_label, cause } => false
  }
}

// RED CONTROL — a target the slot geometry cannot reach refuses, carrying the
// population cause through rather than reporting an empty success.
test fn an_unreachable_target_refuses_through_the_profile() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: arm_memory_profile,
    modules: [rdimm_16g()],
  ) {
    ProfileCapacityRefused { profile_label, cause } =>
      match cause {
        ProfilePopulationRefused { cause } =>
          match cause {
            TargetUnreachableInSlotGeometry { required_bytes, best_reachable_bytes, shortfall_bytes } =>
              byte_size_count(b: required_bytes) == 256 * gb
                && byte_size_count(b: best_reachable_bytes) == 128 * gb
                && byte_size_count(b: shortfall_bytes) == 128 * gb
            NoModuleCandidatesOffered => false
            MixedCapacityPopulationUnsupported => false
          }
        ProfileBasisUndeclared => false
        ProfileEntitlementUnstated => false
      }
    ProfileCapacitiesDerived { capacities } => false
  }
}

// RED CONTROL — an empty candidate list is a distinct refusal from an
// unreachable target: the first says nobody was asked, the second says the
// board cannot do it.
test fn no_offered_modules_refuses_distinctly() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profile: arm_value_profile,
    modules: [],
  ) {
    ProfileCapacityRefused { profile_label, cause } =>
      match cause {
        ProfilePopulationRefused { cause } =>
          match cause {
            NoModuleCandidatesOffered => true
            TargetUnreachableInSlotGeometry { required_bytes, best_reachable_bytes, shortfall_bytes } =>
              false
            MixedCapacityPopulationUnsupported => false
          }
        ProfileBasisUndeclared => false
        ProfileEntitlementUnstated => false
      }
    ProfileCapacitiesDerived { capacities } => false
  }
}

// RED CONTROL — a mixed-capacity population is refused even though it would
// arithmetically clear the target; no cited platform authority admits one.
test fn a_mixed_capacity_population_is_refused() -> Bool {
  match admit_mixed_capacity_population(geometry: asrock_altrad8ud_1l2t_geometry) {
    PopulationDerivationRefused { board_label, cause } =>
      match cause {
        MixedCapacityPopulationUnsupported => true
        NoModuleCandidatesOffered => false
        TargetUnreachableInSlotGeometry { required_bytes, best_reachable_bytes, shortfall_bytes } =>
          false
      }
    PopulationsDerived { options } => false
  }
}

// The fan-out produces one reading PER PROFILE, never one blended number: the
// x64 profile refuses on this arm processor's own terms while the two arm
// profiles derive, and all three answers arrive side by side.
test fn the_fan_out_answers_once_per_profile() -> Bool {
  let readings = derive_all_profile_capacities(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q6430_catalog,
    profiles: declared_service_profiles(),
    modules: [rdimm_32g()],
  )
  count(readings) == 3
    && count(filter(readings, r => match r {
      ProfileCapacitiesDerived { capacities } => true
      ProfileCapacityRefused { profile_label, cause } => false
    })) == 3
}

// THE PROCESSOR THE PURCHASE IS ACTUALLY ABOUT, and the clearest case for
// carrying profiles rather than one figure: on Q80-30 the two arm profiles
// give different ANSWERS, not merely different numbers. Eighty cores at 3 GB
// is a 240 GB target that eight 32 GB DIMMs clear, serving all 80
// entitlements with headroom; the same eighty cores at 4 GB is 320 GB, which
// this board cannot reach in any full-channel population of that module, so
// the memory profile REFUSES where the value profile succeeds.
test fn q8030_capacity_differs_between_the_two_arm_profiles() -> Bool {
  match derive_profile_capacity(
    geometry: asrock_altrad8ud_1l2t_geometry,
    cpu: altra_q8030_catalog,
    profile: arm_value_profile,
    modules: [rdimm_32g()],
  ) {
    ProfileCapacitiesDerived { capacities } =>
      all(
        capacities,
        c => c.cpu_entitlements == 80 && c.memory_entitlements == 85 && c.servable_entitlements == 80,
      )
        && match derive_profile_capacity(
          geometry: asrock_altrad8ud_1l2t_geometry,
          cpu: altra_q8030_catalog,
          profile: arm_memory_profile,
          modules: [rdimm_32g()],
        ) {
          ProfileCapacitiesDerived { capacities } => false
          ProfileCapacityRefused { profile_label, cause } =>
            match cause {
              ProfilePopulationRefused { cause } =>
                match cause {
                  TargetUnreachableInSlotGeometry { required_bytes, best_reachable_bytes, shortfall_bytes } =>
                    byte_size_count(b: required_bytes) == 320 * gb
                      && byte_size_count(b: best_reachable_bytes) == 256 * gb
                      && byte_size_count(b: shortfall_bytes) == 64 * gb
                  NoModuleCandidatesOffered => false
                  MixedCapacityPopulationUnsupported => false
                }
              ProfileBasisUndeclared => false
              ProfileEntitlementUnstated => false
            }
        }
    ProfileCapacityRefused { profile_label, cause } => false
  }
}
