module test.claim.printer_workflow_binding_witness

import std.types { Bool, String }
import std.optional { Present, Absent }
import extdeps.github.actions { Step, RunStep, UsesStep }
import extdeps.languages.yaml.types { YamlString }
import gunbc.fleet.fleet_converge_workflow {
  PrinterWorkflow, WorkspaceCommissioningPlan, R2WorkspaceObjectReadMint, R2WorkspaceObjectWriteMint,
  FleetSshKeyNotConsumed, fleet_converge_workflow_modes, fleet_converge_spark_target_modes,
  fleet_converge_workflow_mode_wire, fleet_converge_mode_job_id, fleet_converge_jobs,
  fleet_converge_mode_options, fleet_converge_mode_fleet_ssh_key_demand,
  fleet_converge_printer_job, fleet_converge_shared_job_if,
}
import test.claim.fleet.fleet_converge_checkout_trust { fleet_converge_checkout_trust_holds, fleet_converge_shared_job_runs_all_but }
import gunbc.ci.ci_spec { gunbc_run_step_targets }
import gunbc.fleet.printer_federation { printer_service_account, printer_provider_resource }

import gunbc.fleet.printer_federation_provision { printer_dedicated_federation }
import gunbc.fleet.fleet_printer_access {printer_access_code_loci}

fn auth_step_matches(st: Step) -> Bool {
  match st {
    UsesStep { name: _, id, uses: _, with: args, env: _, if_condition: cond, continue_on_error: _, timeout_minutes: _ } =>
      match id { Present { value: value } => value == "wif_auth" && (match cond { Present { value: c } => c == "github.ref == 'refs/heads/main'" Absent => false }) && match args {
        Present { value: fields } => any(fields, f => f.key == "service_account" && match f.value { YamlString { value: v } => v == (printer_service_account as String) _ => false })
          && any(fields, f => f.key == "workload_identity_provider" && match f.value { YamlString { value: v } => v == printer_provider_resource() _ => false })
        Absent => false
      } Absent => false }
    _ => false
  }
}
// The printer credential is signed in only on reviewed main (design A, 2026-10-25): the one auth step
// carries the exact main-ref condition, so a branch run of this job holds no printer token.
test fn separate_job_uses_dedicated_identity() -> Bool {
  let job = fleet_converge_printer_job()
  job.id == "printer" && match job.environment { Present { value } => value == "printer-lan" Absent => false }
    && count(filter(job.steps, s => auth_step_matches(st: s))) == 1
    && any(job.needs, n => n == "build")
}
test fn observer_has_no_fleet_ssh_demand() -> Bool {
  match fleet_converge_mode_fleet_ssh_key_demand(mode: PrinterWorkflow) { FleetSshKeyNotConsumed => true _ => false }
}
// The trusted-checkout conjuncts live once in test.claim.fleet.fleet_converge_checkout_trust; #14690's three per-file copies were consolidated there, the literal shared-job exclusion included.
test fn trusted_code_cannot_be_replaced_by_dispatch_revision() -> Bool {
  fleet_converge_checkout_trust_holds()
    && fleet_converge_shared_job_runs_all_but(excluded: PrinterWorkflow)
}
test fn observer_is_a_registered_dispatch_and_run_target() -> Bool {
  any(fleet_converge_mode_options, m => m == "printer")
    && count(filter(gunbc_run_step_targets(), t => t.entry == "dag/gunbc/fleet/printer_workflow_run.dag" && t.function == "run")) == 1
}

test fn printer_identity_reads_only_the_two_printer_secrets() -> Bool {
  let f = printer_dedicated_federation()
  length(f.secret_grants) == length(printer_access_code_loci) &&
  all(f.secret_grants, g => g.role == "roles/secretmanager.secretAccessor" &&
    any(printer_access_code_loci,p=>(p.secret.secret as String)==(g.target.secret as String)))
}

// The merge combines independent dispatch additions; neither side may erase the other.
// Re-derived at the SOURCE (DESIGN.md §6b), 2026-10-27 (fierce-ferret-64, node adhoc-0201be55-56b):
// this witness used to grep the four wire names out of fleet_converge_mode_options — the very
// generated-text surface (the workflow's input-choice projection) the row
// a_dispatch_surface_probe_asserts_generated_text_not_its_derivation names. Grepping the projection
// cannot tell a lost mode from a renamed one and cannot tell a dispatchable mode from one that is
// listed but lands no job. It reads the closed roster instead, in the mode's own typed value: a
// mode is dispatchable when it is in fleet_converge_workflow_modes, is not excluded by the live
// fleet_converge_spark_target_modes filter, and is named exactly once in fleet_converge_mode_options
// (no duplicate wire name, which would silently double-list one job), and it is REACHABLE when the
// job the product actually emits — fleet_converge_jobs(), the same list the generated yml is written
// from — holds its fleet_converge_mode_job_id.
// History of the four names, so 'stale' vs 'lost capability' is settled, not guessed: all four are
// live product dispatch (printer #15086 87586a64e029, workspace_commissioning_plan, and the two
// r2_workspace_object_*_mint modes), and the only modes ever removed from this list were the seven
// spark_* variants, retired deliberately with the Spark fleet by fa44b9810259 (#13641, 2026-10-10 —
// its own message: GitHub rejects an empty choice list, so the dead option went with the fleet);
// #15160 c62131787d3 dropped them from this witness. Nothing here asserts a retired mode.
test fn printer_and_main_workspace_modes_remain_dispatchable() -> Bool {
  let job_ids = map(fleet_converge_jobs(), j => j.id)
  all([PrinterWorkflow, WorkspaceCommissioningPlan, R2WorkspaceObjectReadMint, R2WorkspaceObjectWriteMint], mode =>
    count(filter(fleet_converge_workflow_modes, m => fleet_converge_workflow_mode_wire(mode: m) == fleet_converge_workflow_mode_wire(mode: mode))) == 1
      && !any(fleet_converge_spark_target_modes, m => fleet_converge_workflow_mode_wire(mode: m) == fleet_converge_workflow_mode_wire(mode: mode))
      && count(filter(fleet_converge_mode_options, o => o == fleet_converge_workflow_mode_wire(mode: mode))) == 1
      && any(job_ids, id => id == (fleet_converge_mode_job_id(mode: mode) as String)))
}

// POSITIVE CONTROL for the exclusion conjunct above, and the reason it may not be dropped as
// vacuous. The product excludes a mode when fleet_converge_spark_target_modes names it, via
// fleet_converge_mode_is_spark_target_mode inside fleet_converge_dispatchable_modes, and that filter
// is LIVE on main rather than vestigial: the closed roster still carries seven retired spark_* modes
// (SparkGrants, SparkBootstrap, SparkServingApply, SparkNativeServingApply, SparkRuntimeImageProbe,
// SparkWirelessLinkConverge, SparkGrantsObserve) and all seven are excluded, 81 roster entries down to
// 74 options. This conjunct pins the excluded set's cardinality on one member — SparkGrants appears
// exactly once in the exclusion list, exactly once in the roster, and zero times in options — because
// that is what makes the exclusion check discriminating: delete the product's filter, or shrink the
// exclusion list, and options grows while this control goes red. Delete this control instead and the
// exclusion conjunct reads as a filter that never excludes anything.
// (The exclusion is conditional in the product — fleet_converge_dispatchable_modes guards it with
// `count(fleet_converge_spark_target_options) > 0 ||` — so it holds today because the Spark host
// roster is empty. That is the product's own stated rule, not this claim's assumption; if a host is
// ever re-rostered the filter flips open and this control is the thing that reports it.)
test fn spark_target_exclusion_filter_is_live() -> Bool {
  count(filter(fleet_converge_spark_target_modes, m => fleet_converge_workflow_mode_wire(mode: m) == "spark_grants")) == 1
    && count(filter(fleet_converge_workflow_modes, m => fleet_converge_workflow_mode_wire(mode: m) == "spark_grants")) == 1
    && count(filter(fleet_converge_mode_options, o => o == "spark_grants")) == 0
}
