module test.claim.review_sheet_tab_refusal_probe_witness

import std.types { String, Bool, Int, List }
import extdeps.filesystem.filesystem_io
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import gunbc.compile_diagnostic_census {
  CompileDiagnosticCensus, CompileDiagnosticCensusRow, CensusObserved, CensusNotRunnable,
}

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// THE FORGED LOCATED TABS, ENROLLED AS EXECUTED REDS. The locator's claim is that a caller cannot
// author a located tab -- not the record, not through the mint, not through the mint's caller --
// and on the source-to-.dag acceptance path that claim is STRUCTURAL: the invalid state has no
// constructor in accepted code. DESIGN section 4b rules that this does not excuse the check. A
// state unrepresentable in the accepted corpus is still representable as SOURCE HANDED TO THE
// COMPILER BY A FIXTURE, and the compiler refusing it is the enrollable evidence. So
// test.probe.review_sheet_tab_forged_probe authors all three routes, this witness hands that
// source to the compiler through the same diagnostic-census harness the hold-plan and data-class
// probes use, and requires a BLOCKING row of the NAMED CLASS at the NAMED SUBJECT for each. A
// probe refusing for any other reason would be measuring another wall, which is why neither a
// nonzero exit nor a total count is what is asserted.

data probe_dir: String = "dag/test/probe/"

fn probe_source(name: String) -> String {
  filesystem_read(path: probe_dir + name + ".dag").content
}

fn census_of(source: String) -> CompileDiagnosticCensus {
  compile_dag_diagnostic_census(source)
}

fn blocking_count_for_class_and_subject(c: CompileDiagnosticCensus, wanted: String, subject: String) -> Int {
  match c {
    CensusNotRunnable { cause: _ } => -1
    CensusObserved { rows: rows } =>
      rows
        |> filter(r => (r.diagnostic_class as String) == wanted && r.subject_name == subject && r.blocking)
        |> fold(init: 0, f: (acc, r) => acc + r.count)
  }
}

// THE CONTROL IS SCOPED TO CLASS AND SUBJECT, NOT A TOTAL, AND THE TOTAL WAS TRIED FIRST.
// gunbc.compile_diagnostic_census says outright that CensusObserved carries EVERY diagnostic the
// compile produced, the imported closure included -- so a fixture importing any production module
// can never read zero blocking rows, and a control asserting blocking_total == 0 is a check whose
// RED is unauthorable: a decoration under DESIGN section 4b rather than a weak wall. It was
// written that way here and it failed, which is the only reason this note can be honest about it.
//
// The same authority names the two forms that ARE exact over one census: a count scoped to a class
// AND a subject_name, and a differential between two censuses differing on one axis. The three
// claims below are the first form, and together with the three probe claims they are also the
// second: same class, same subject, one axis moved -- a source that MENTIONS the locator versus a
// source that FORGES against it. That pairing is what makes the probe's refusals attributable to
// the forgeries rather than to naming the module at all, which a total could never have shown.
data harness_control_source: String = "module probe_review_sheet_tab_harness_control\nimport std.types { String }\nimport gunbc.review_sheet_tab_locator { review_tab_locator_field_mask }\nfn mask() -> String { review_tab_locator_field_mask }\n"

test fn a_source_that_only_names_the_locator_forges_no_located_tab() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: harness_control_source),
    wanted: "SoleConstructorViolation", subject: "LocatedReviewTab",
  ) == 0
}

test fn a_source_that_only_names_the_locator_is_refused_at_neither_sealed_mint() -> Bool {
  (blocking_count_for_class_and_subject(
    c: census_of(source: harness_control_source),
    wanted: "ConstructorCallAdmissionRefused", subject: "review_tab_standing_from_classification",
  ) == 0)
    && (blocking_count_for_class_and_subject(
      c: census_of(source: harness_control_source),
      wanted: "ConstructorCallAdmissionRefused", subject: "review_tab_standing_of_outcome",
    ) == 0)
}

// (a) THE RECORD HAS NO CONSTRUCTOR OUTSIDE THE LOCATOR. A hand-built located tab carrying the
// constant sheet id is the exact regression this change removes, reintroduced under the name of an
// observation; it refuses at the record literal rather than being caught downstream.
test fn a_forged_located_tab_cannot_be_authored_outside_the_locator() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "SoleConstructorViolation", subject: "LocatedReviewTab",
  ) >= 1
}

// (b) THE MINT REFUSES AN UNADMITTED CALLER. sole_constructor alone would still let any module
// call the one function that builds the record with a response it authored, so the seal on the
// mint is what makes the record's seal mean anything.
test fn an_unadmitted_caller_cannot_mint_a_located_tab_from_a_supplied_classification() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "ConstructorCallAdmissionRefused", subject: "review_tab_standing_from_classification",
  ) >= 1
}

// (c) AND SO DOES THE MINT'S CALLER, at its own name. A seal with an unsealed caller is not a
// weaker seal, it is no seal, and the census keys the row by the CALLEE's declaration name -- so
// this is an identity join on the second door rather than a second count of the first.
test fn an_unadmitted_caller_cannot_reach_the_mint_through_the_outcome_classifier() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "ConstructorCallAdmissionRefused", subject: "review_tab_standing_of_outcome",
  ) >= 1
}

// (d) AND THE WITNESS WRAPPER REFUSES TOO, which is the door the side-chat hold on gunbc#11725
// found open. test.claim.review_sheet_format_target_witness located_tab_for_witness is ADMITTED to
// the conversion, and for one revision that was all it was: exported, unrestricted, and therefore
// a route by which any module could obtain a located tab from values it chose. An admitted call
// edge does not confine a value when an exported wrapper returns that value or a carrier
// containing it, so the wrapper carries its own admission list and this asserts it by name.
test fn an_unadmitted_caller_cannot_reach_a_located_tab_through_the_witness_wrapper() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "ConstructorCallAdmissionRefused", subject: "located_tab_for_witness",
  ) >= 1
}

// (e) THE FORMAT EFFECTS CANNOT BE REACHED WITHOUT A LOCATED TAB. Each batchUpdate function takes
// a request record, and while those records were ordinary a foreign module could author one and
// format an arbitrary tab of an arbitrary workbook without a LocatedReviewTab, a validated schema
// or a converge -- the production entry required a located tab and the effects did not. The
// closure is on the INPUT rather than on the five callers: every record is sole_constructor and
// its only mints require a located tab, so the refusal lands at the RECORD. That is why these
// four claims name record types rather than callees, and it is the stronger form -- an
// unconstructible argument cannot reach those functions by any route, named or unnamed, so
// confinement does not depend on an admission list staying complete as the module grows.
test fn a_freeze_request_cannot_be_authored_outside_the_located_builders() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "SoleConstructorViolation", subject: "FreezeRowsRequest",
  ) >= 1
}

test fn a_header_band_request_cannot_be_authored_outside_the_located_builders() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "SoleConstructorViolation", subject: "HeaderBandRequest",
  ) >= 1
}

test fn a_standing_rule_request_cannot_be_authored_outside_the_located_builders() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "SoleConstructorViolation", subject: "StandingRuleRequest",
  ) >= 1
}

test fn a_whole_format_plan_cannot_be_authored_outside_the_located_builders() -> Bool {
  blocking_count_for_class_and_subject(
    c: census_of(source: probe_source(name: "review_sheet_tab_forged_probe")),
    wanted: "SoleConstructorViolation", subject: "FormatRequestPlan",
  ) >= 1
}
