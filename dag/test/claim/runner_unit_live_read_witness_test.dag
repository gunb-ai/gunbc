module test.claim.runner_unit_live_read_witness

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

fn fixture_host() -> String {
  "srv1"
}

fn fixture_unit() -> String {
  "actions-runner@srv1-01.service"
}

fn fixture_memory_max_target() -> ConvergeTarget {
  PerSlotMemoryCap {
    dropin_path: gunbc_runner_per_slot_dropin_path,
    instance_glob: runner_instance_glob(host: fixture_host()),
    property: systemd_memory_max_property,
    bytes_value: to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)),
  }
}

fn fixture_swap_max_target() -> ConvergeTarget {
  PerSlotMemoryCap {
    dropin_path: gunbc_runner_per_slot_swap_dropin_path,
    instance_glob: runner_instance_glob(host: fixture_host()),
    property: systemd_memory_swap_max_property,
    bytes_value: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max)),
  }
}

fn matching_swap_max_row() -> RunnerUnitLiveReadRow {
  RunnerUnitLiveReadRow {
    unit: fixture_unit(),
    memory_max_raw: to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)),
    memory_swap_max_raw: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max)),
    memory_high_raw: "infinity",
    memory_current_raw: "",
    probed_at: "2026-07-10",
  }
}

fn fixture_high_target() -> ConvergeTarget {
  PerSlotMemoryCap {
    dropin_path: gunbc_runner_per_slot_high_dropin_path,
    instance_glob: runner_instance_glob(host: fixture_host()),
    property: systemd_memory_high_property,
    bytes_value: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_high)),
  }
}

fn matching_high_row() -> RunnerUnitLiveReadRow {
  RunnerUnitLiveReadRow {
    unit: fixture_unit(),
    memory_max_raw: to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)),
    memory_swap_max_raw: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_swap_max)),
    memory_high_raw: to_string(byte_size_count(b: gunbc_runner_slot_desired().memory_high)),
    memory_current_raw: "",
    probed_at: "2026-07-11",
  }
}

fn matching_memory_max_row() -> RunnerUnitLiveReadRow {
  RunnerUnitLiveReadRow {
    unit: fixture_unit(),
    memory_max_raw: to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)),
    memory_swap_max_raw: "0",
    memory_high_raw: "infinity",
    memory_current_raw: "",
    probed_at: "2026-07-01",
  }
}

fn drift_memory_max_row() -> RunnerUnitLiveReadRow {
  RunnerUnitLiveReadRow {
    unit: fixture_unit(),
    memory_max_raw: "30000000000",
    memory_swap_max_raw: "0",
    memory_high_raw: "infinity",
    memory_current_raw: "",
    probed_at: "2026-07-01",
  }
}

test fn witness_parse_infinity_is_unbounded() -> Bool {
  match parse_systemd_memory_limit_show(raw: "infinity") {
    MemoryLimitUnbounded => true
    _ => false
  }
}

test fn witness_parse_bytes_is_typed() -> Bool {
  match parse_systemd_memory_limit_show(raw: "17179869184") {
    MemoryLimitBytes { bytes: b } =>
      byte_size_count(b: b) == byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
    _ => false
  }
}

test fn witness_parse_empty_is_absent() -> Bool {
  match parse_systemd_memory_limit_show(raw: "") {
    MemoryLimitAbsent => true
    _ => false
  }
}

test fn witness_fixture_read_types_all_three_properties() -> Bool {
  let read = fixture_live_read()
  match read.memory_max {
    MemoryLimitUnbounded => true
    _ => false
  }
    && match read.memory_swap_max {
      MemoryLimitBytes { bytes: b } => byte_size_count(b: b) == 0
      _ => false
    }
    && match read.memory_high {
      MemoryLimitUnbounded => true
      _ => false
    }
}

test fn witness_fixture_memory_max_drifts_against_model_cap() -> Bool {
  runner_unit_memory_max_drifts_against_cap(
    read: fixture_live_read(),
    desired_cap: gunbc_ci_runner_cgroup_memory_cap
  )
}

test fn witness_fixture_swap_max_drifts_against_desired() -> Bool {
  match converge_target_live_verdict(read: fixture_live_read(), target: fixture_swap_max_target()) {
    Present { value: Drifted } => true
    _ => false
  }
}

test fn witness_matching_swap_read_converges_on_desired() -> Bool {
  runner_unit_swap_max_converged(
    read: runner_unit_live_read_typed(row: matching_swap_max_row()),
    target: fixture_swap_max_target()
  )
}

test fn witness_fixture_high_drifts_against_desired() -> Bool {
  match converge_target_live_verdict(read: fixture_live_read(), target: fixture_high_target()) {
    Present { value: Drifted } => true
    _ => false
  }
}

test fn witness_matching_high_read_converges_on_desired() -> Bool {
  match converge_target_live_verdict(
    read: runner_unit_live_read_typed(row: matching_high_row()),
    target: fixture_high_target()
  ) {
    Present { value: VerdictConverged } => true
    _ => false
  }
}

fn witness_matching_read_converges_on_memory_max_target() -> Bool {
  let read = runner_unit_live_read_typed(row: matching_memory_max_row())
  match converge_target_live_verdict(read: read, target: fixture_memory_max_target()) {
    Present { value: VerdictConverged } => true
    _ => false
  }
}

fn witness_drift_read_fails_memory_max_target() -> Bool {
  let read = runner_unit_live_read_typed(row: drift_memory_max_row())
  match converge_target_live_verdict(read: read, target: fixture_memory_max_target()) {
    Present { value: Drifted } => true
    _ => false
  }
}

test fn witness_target_bytes_value_is_single_authority() -> Bool {
  let read = runner_unit_live_read_typed(row: drift_memory_max_row())
  let target = PerSlotMemoryCap {
    dropin_path: gunbc_runner_per_slot_dropin_path,
    instance_glob: runner_instance_glob(host: fixture_host()),
    property: systemd_memory_max_property,
    bytes_value: "30000000000",
  }
  match converge_target_live_verdict(read: read, target: target) {
    Present { value: VerdictConverged } => true
    _ => false
  }
}

test fn witness_perturbed_fixture_read_diff_red_on_memory_max() -> Bool {
  witness_fixture_memory_max_drifts_against_model_cap()
    && witness_matching_read_converges_on_memory_max_target()
    && witness_drift_read_fails_memory_max_target()
}

test fn witness_memory_limit_absent_routes_to_absent_verdict() -> Bool {
  memory_limit_converge_verdict_for_bytes_value(
    observed: MemoryLimitAbsent,
    bytes_value: to_string(byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)),
  ) == Absent
}

test fn witness_cap_effectiveness_projection_matches_runner_slot_type() -> Bool {
  let read = runner_unit_live_read_typed(row: matching_memory_max_row())
  match memory_limit_to_cap_effectiveness(lim: read.memory_max) {
    Present { value: CapEffective { bytes: b } } =>
      byte_size_count(b: b) == byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
    _ => false
  }
    && match memory_limit_to_cap_effectiveness(lim: read.memory_swap_max) {
      Present { value: CapEffective { bytes: b } } => byte_size_count(b: b) == 0
      _ => false
    }
}

