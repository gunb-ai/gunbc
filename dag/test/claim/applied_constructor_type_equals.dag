module test.claim.applied_constructor_type_equals

import gunbc.compile_diagnostic_census {
  CensusObserved,
  CensusNotRunnable,
  census_blocking_rows,
  census_total_count,
}

fn blocking_count(source: String) -> Int {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => census_total_count(rows: census_blocking_rows(rows: rows))
    CensusNotRunnable { cause: _ } => -1
  }
}

test fn same_applied_box_int_is_accepted() -> Bool {
  blocking_count(source: "module locate.boxeq\ntype Box<T>\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn probe(x: Box<Int>, y: Box<Int>) -> Bool {\n  same_arm(a: x, b: y)\n}\n") == 0
}

test fn list_int_equals_freemonoid_int() -> Bool {
  blocking_count(source: "module locate.listalias\nimport std.types { List }\nimport std.algebra { FreeMonoid }\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn probe(x: List<Int>, y: FreeMonoid<Int>) -> Bool {\n  same_arm(a: x, b: y)\n}\n") == 0
}

// AN APPLICATION AGAINST THE SAME SPELLING WITH DIFFERENT ARGUMENTS REFUSES (parent
// ruling msg_d6381674; the class PRED-C measured CLOSED by arm 2). Box<Int> and Box<Bool>
// share one declaration, so head identity cannot separate them -- the descent must compare
// the applied arguments. On main and on the #14056 leaf/binder head both were ACCEPTED
// (census count 0, a silent wrong-type accept); at the PR-2 head the applied-children
// descent refuses it. The positive above (Box<Int> vs Box<Int>) keeps the refusal from
// collapsing into over-rejection of one head.
test fn box_int_against_box_bool_is_refused() -> Bool {
  blocking_count(source: "module locate.boxneq\ntype Box<T>\nfn same_arm<A>(a: A, b: A) -> Bool { true }\nfn probe(x: Box<Int>, y: Box<Bool>) -> Bool {\n  same_arm(a: x, b: y)\n}\n") >= 1
}

// THE SHADOW-FORMAL CASE (manager ruling msg_60a19937 (a), PR-2 lane): a REAL corpus type whose
// name collides with a callee's formal parameter name must NOT be mistaken for an unsettled
// formal. f<K> forwards its own-form m against an actual that is the corpus type K: the fold's
// interim own-form predicate must refuse, not treat the real K as an unsettled slot -- an ACCEPT
// here is the interim's misread class made concrete, and it fails PR-2's RED. The identity
// re-expression (binder_marked_type refs, not spelling) is the dissolution; #14750's
// representation PR owns the substitution-key half (eager-cat-804).
test fn corpus_type_shadow_named_like_formal_still_refuses() -> Bool {
  blocking_count(source: "module locate.shadowformal\ntype K\nfn f<K>(m: K, k: K) -> K { m }\nfn caller(x: Int, y: K) -> Int { f(m: x, k: y) }\n") >= 1
}
