module test.claim.tmp_pv_attribution

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { String, Bool, Int, List }
import gunbc.roadmap_authority {
  declared_roadmap_nodes, declared_roadmap_edges, roadmap_acceptance_receipts,
}
import gunbc.v1_deletion_plan { v1_exit_finish_lines }
import gunbc.roadmap_program_view {
  v1_program_view, v1_convergence_fronts,
  V1ProgramViewResult, ProgramViewDerived, ProgramViewRefused,
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data scratch_note: String = "TEMPORARY COST-ATTRIBUTION SCRATCH — deleted before commit. Splits the program-view cost into input construction versus the derivation over those inputs."

test fn pv_a_nodes_only() -> Bool {
  count(declared_roadmap_nodes()) > 0
}

test fn pv_b_edges_only() -> Bool {
  count(declared_roadmap_edges()) > 0
}

test fn pv_c_receipts_only() -> Bool {
  count(roadmap_acceptance_receipts()) >= 0
}

test fn pv_d_specs_only() -> Bool {
  count(v1_exit_finish_lines()) > 0 && count(v1_convergence_fronts()) > 0
}

test fn pv_e_full_projection() -> Bool {
  match v1_program_view(
    nodes: declared_roadmap_nodes(),
    edges: declared_roadmap_edges(),
    receipts: roadmap_acceptance_receipts(),
    in_flight: [],
  ) {
    ProgramViewDerived { view } => count(view.finish_lines) == 4
    ProgramViewRefused { causes } => false
  }
}
