module test.claim.cursor_sdk_stream_witness_test

import std.types { Bool, String }
import extdeps.llm.cursor_stream {
  CursorSdkStreamTerminalsReconciled,
  CursorSdkStreamTerminalsUnclassified,
  CursorSdkTerminalFinished,
  CursorSdkTerminalError,
  CursorSdkTerminalErrorObserved,
  CursorSdkMessageAssistant,
  CursorSdkMessageUsage,
  CursorSdkLocalRunStreamResult,
  CursorSdkLocalRunStreamUnclassified,
  cursor_sdk_stream_reconcile_run_result,
  cursor_sdk_stream_classify_message_line,
  CursorSdkLineClassified,
  CursorSdkLineUnreadable,
  CursorSdkLineTypeMemberAbsent,
  CursorSdkLineTypeMemberDuplicated,
  CursorSdkLineNotAnObject,
  cursor_sdk_stream_classify_local_run_event,
}
import extdeps.llm.cursor_sdk_errors {
  CursorSdkAuthenticationError,
  CursorSdkRateLimitError,
  CursorSdkErrorCodeOther,
}

data finished_result: String = "{\"id\":\"run-1\",\"status\":\"finished\",\"result\":\"ok\"}"
data auth_error_result: String = "{\"id\":\"run-2\",\"status\":\"error\",\"error\":{\"message\":\"bad key\",\"code\":\"authentication_error\"}}"
data rate_limit_result: String = "{\"id\":\"run-3\",\"status\":\"error\",\"error\":{\"message\":\"slow down\",\"code\":\"rate_limit_error\"}}"
data malformed_result: String = "{\"status\":"
data assistant_message: String = "{\"type\":\"assistant\",\"agent_id\":\"a1\",\"run_id\":\"r1\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}}"
data usage_message: String = "{\"type\":\"usage\",\"agent_id\":\"a1\",\"run_id\":\"r1\",\"usage\":{\"inputTokens\":1,\"outputTokens\":2}}"
data local_result_event: String = "{\"schemaVersion\":1,\"type\":\"result\",\"agentId\":\"a1\",\"runId\":\"r1\",\"status\":\"finished\"}"
data unknown_event: String = "{\"type\":\"future_shape\",\"agentId\":\"a1\"}"

test fn finished_run_result_reconciles() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: finished_result) {
    CursorSdkStreamTerminalsReconciled { status: CursorSdkTerminalFinished, error: _, raw: _ } => true
    CursorSdkStreamTerminalsUnclassified { reason: _, raw: _ } => false
  }
}

test fn auth_error_classifies() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: auth_error_result) {
    CursorSdkStreamTerminalsReconciled { error: err, status: CursorSdkTerminalError, raw: _ } =>
      match err {
        CursorSdkTerminalErrorObserved { message: _, code: CursorSdkAuthenticationError } => true
        CursorSdkTerminalErrorObserved { message: _, code: _ } => false
        CursorSdkTerminalErrorAbsent => false
      }
    CursorSdkStreamTerminalsUnclassified { reason: _, raw: _ } => false
  }
}

test fn rate_limit_error_classifies() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: rate_limit_result) {
    CursorSdkStreamTerminalsReconciled { error: err, status: CursorSdkTerminalError, raw: _ } =>
      match err {
        CursorSdkTerminalErrorObserved { message: _, code: CursorSdkRateLimitError } => true
        CursorSdkTerminalErrorObserved { message: _, code: _ } => false
        CursorSdkTerminalErrorAbsent => false
      }
    CursorSdkStreamTerminalsUnclassified { reason: _, raw: _ } => false
  }
}

test fn malformed_result_refuses() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: malformed_result) {
    CursorSdkStreamTerminalsUnclassified { reason: _, raw: _ } => true
    CursorSdkStreamTerminalsReconciled { status: _, error: _, raw: _ } => false
  }
}

test fn assistant_message_classifies() -> Bool {
  match cursor_sdk_stream_classify_message_line(raw: assistant_message) {
    CursorSdkLineClassified { kind: CursorSdkMessageAssistant } => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineUnreadable => false
    CursorSdkLineTypeMemberAbsent => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}

test fn usage_message_classifies() -> Bool {
  match cursor_sdk_stream_classify_message_line(raw: usage_message) {
    CursorSdkLineClassified { kind: CursorSdkMessageUsage } => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineUnreadable => false
    CursorSdkLineTypeMemberAbsent => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}

test fn local_result_event_classifies() -> Bool {
  match cursor_sdk_stream_classify_local_run_event(raw: local_result_event) {
    CursorSdkLineClassified { kind: CursorSdkLocalRunStreamResult } => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineUnreadable => false
    CursorSdkLineTypeMemberAbsent => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}

test fn unknown_event_stays_unclassified() -> Bool {
  match cursor_sdk_stream_classify_local_run_event(raw: unknown_event) {
    CursorSdkLineClassified { kind: CursorSdkLocalRunStreamUnclassified { wire_type: _ } } => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineUnreadable => false
    CursorSdkLineTypeMemberAbsent => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}

test fn agent_report_text_does_not_classify_as_terminal_error() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(
    raw: "{\"status\":\"error\",\"error\":{\"message\":\"you hit your usage limit\",\"code\":\"other\"}}",
  ) {
    CursorSdkStreamTerminalsReconciled { error: err, status: CursorSdkTerminalError, raw: _ } =>
      match err {
        CursorSdkTerminalErrorObserved { message: _, code: CursorSdkRateLimitError } => false
        CursorSdkTerminalErrorObserved { message: _, code: CursorSdkErrorCodeOther { raw: _ } } => true
        CursorSdkTerminalErrorObserved { message: _, code: _ } => true
        CursorSdkTerminalErrorAbsent => true
      }
    CursorSdkStreamTerminalsUnclassified { reason: _, raw: _ } => false
  }
}

data malformed_error_subobject: String = "{\"status\":\"error\",\"error\":[{\"message\":\"bad\"}]}"
data malformed_error_missing_message: String = "{\"status\":\"error\",\"error\":{\"code\":\"authentication_error\"}}"

test fn malformed_error_subobject_refuses_not_absent() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: malformed_error_subobject) {
    CursorSdkStreamTerminalsUnclassified { reason, raw: _ } =>
      string_contains(s: reason as String, pattern: "malformed error object")
    CursorSdkStreamTerminalsReconciled { status: _, error: _, raw: _ } => false
  }
}

test fn malformed_error_missing_message_refuses_not_absent() -> Bool {
  match cursor_sdk_stream_reconcile_run_result(raw: malformed_error_missing_message) {
    CursorSdkStreamTerminalsUnclassified { reason, raw: _ } =>
      string_contains(s: reason as String, pattern: "malformed error object")
    CursorSdkStreamTerminalsReconciled {
      status: _,
      error: CursorSdkTerminalErrorAbsent,
      raw: _,
    } => false
    CursorSdkStreamTerminalsReconciled { status: _, error: _, raw: _ } => false
  }
}

test fn cursor_sdk_stream_witness_keystone_holds() -> Bool {
  finished_run_result_reconciles()
    && auth_error_classifies()
    && rate_limit_error_classifies()
    && malformed_result_refuses()
    && malformed_error_subobject_refuses_not_absent()
    && malformed_error_missing_message_refuses_not_absent()
    && assistant_message_classifies()
    && usage_message_classifies()
    && local_result_event_classifies()
    && unknown_event_stays_unclassified()
    && agent_report_text_does_not_classify_as_terminal_error()
}

data cursor_line_reading_discrimination_note: String = "THE COLLAPSE THIS CHANGE REMOVES, AND WHY A CLASSIFIER IS THE WORST PLACE FOR IT. Both classifiers returned an Optional whose `none` answered four different facts, and a classifier is asked about EVERY line of a stream -- so `none` is its ordinary answer and nothing about it looks wrong. A stream that became malformed halfway through (truncated write, interleaved writer, crash mid-line) was therefore indistinguishable from a stream of lines the classifier simply had nothing to say about. The witnesses below assert that an unreadable line and a well-formed line missing its type member are now different values, and the untouched unknown_event_stays_unclassified control is what keeps them honest: an UNRECOGNISED KIND is a CLASSIFIED answer, not a reading failure, and a decoder that refused it would break the classifier while satisfying a naive refusal test."

test fn RED_unreadable_cursor_line_is_not_a_missing_type_member() -> Bool {
  match cursor_sdk_stream_classify_message_line(raw: "{ truncated mid-lin") {
    CursorSdkLineUnreadable => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineTypeMemberAbsent => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}

test fn RED_cursor_line_without_type_member_is_not_unreadable() -> Bool {
  match cursor_sdk_stream_classify_message_line(raw: "{\"role\":\"assistant\"}") {
    CursorSdkLineTypeMemberAbsent => true
    CursorSdkLineClassified { kind: _ } => false
    CursorSdkLineUnreadable => false
    CursorSdkLineTypeMemberDuplicated { count: _ } => false
    CursorSdkLineNotAnObject => false
  }
}
