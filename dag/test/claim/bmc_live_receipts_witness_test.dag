module test.claim.bmc_live_receipts_witness

import extdeps.bmc.types {
  BmcConfigPersistenceUnsupported,
  BmcOverlayConfigObserved,
  RedfishFanControlResourceAbsent,
  RedfishInitialDutyControlResource,
  RedfishLegacyChassisThermal,
  RedfishThermalSubsystemSensorCollection,
  ResetGracefulRestart,
}
import extdeps.filesystem.linux {
  linux_overlay_observation_is_flash_backed,
}
import gunbc.fleet_bmc_observation {
  srv3_bmc_firmware_observation,
  srv3_bmc_redfish_surface_observation,
  srv3_bmc_update_service_observation,
  srv4_bmc_config_persistence_observation,
  srv4_bmc_fan_active_config_digest,
  srv4_bmc_fan_convergence_receipt,
  srv4_bmc_fan_observed_config_path,
  srv4_bmc_fan_observed_curve,
  srv4_bmc_fan_perturbation_generation,
  srv4_bmc_fan_reboot_persistence_receipt,
  srv4_bmc_firmware_observation,
  srv4_bmc_redfish_surface_observation,
  srv4_bmc_update_service_observation,
}
import gunbc.fleet_intent { srv4_host }
import std.measure { rpm_count }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

test fn firmware_and_redfish_surfaces_are_literal_versioned_observations() -> Bool {
  srv3_bmc_firmware_observation.firmware.version == "2.07.00"
    && srv4_bmc_firmware_observation.firmware.version == "3.22.00"
    && srv3_bmc_redfish_surface_observation.thermal_surface == RedfishThermalSubsystemSensorCollection
    && srv3_bmc_redfish_surface_observation.fan_control_surface == RedfishFanControlResourceAbsent
    && srv4_bmc_redfish_surface_observation.thermal_surface == RedfishLegacyChassisThermal
    && srv4_bmc_redfish_surface_observation.fan_control_surface == RedfishInitialDutyControlResource
}

test fn update_surface_receipts_do_not_claim_an_available_backup_image() -> Bool {
  srv3_bmc_update_service_observation.active_bmc_image_updateable
    && srv4_bmc_update_service_observation.active_bmc_image_updateable
    && !srv3_bmc_update_service_observation.backup_bmc_image_observed
    && !srv4_bmc_update_service_observation.backup_bmc_image_observed
}

test fn overlay_receipt_records_literal_mount_and_write_facts_only() -> Bool {
  match srv4_bmc_config_persistence_observation {
    BmcOverlayConfigObserved {
      firmware: firmware,
      config_path: config_path,
      overlay: overlay,
      writable: writable,
      upper_override_present: upper_override_present,
      available_bytes: _,
      observed_at: _,
    } =>
      firmware.version == "3.22.00"
        && config_path == srv4_bmc_fan_observed_config_path
        && linux_overlay_observation_is_flash_backed(observation: overlay)
        && writable
        && upper_override_present
    BmcConfigPersistenceUnsupported {
      firmware: _,
      config_path: _,
      reason: _,
      observed_at: _,
    } => false
  }
}

test fn convergence_receipt_binds_host_realizer_readback_and_live_health() -> Bool {
  let receipt = srv4_bmc_fan_convergence_receipt
  receipt.host == srv4_host.identity
    && receipt.policy.curve == srv4_bmc_fan_observed_curve
    && receipt.policy.board_config_path == srv4_bmc_fan_observed_config_path
    && receipt.active_config_digest == srv4_bmc_fan_active_config_digest
    && !receipt.zone_failsafe_active
    && receipt.monitoring_sample_count == 12
    && receipt.final_tachs.length() == 4
    && fold(
      receipt.final_tachs,
      init: true,
      f: (healthy, tach) => healthy && rpm_count(tach.reading) > 0,
    )
}

test fn restart_receipt_binds_one_literal_perturbation_generation_and_readback() -> Bool {
  let receipt = srv4_bmc_fan_reboot_persistence_receipt
  receipt.host == srv4_host.identity
    && receipt.perturbation_generation == srv4_bmc_fan_perturbation_generation
    && receipt.reset.reset_type == ResetGracefulRestart
    && receipt.reset.accepted
    && receipt.bmc_down_observed
    && receipt.bmc_returned
    && receipt.before.active_config_digest == srv4_bmc_fan_active_config_digest
    && receipt.post_reboot_active_config_digest == srv4_bmc_fan_active_config_digest
    && receipt.post_reboot_policy.curve == srv4_bmc_fan_observed_curve
    && receipt.post_reboot_controller_active
    && !receipt.post_reboot_zone_failsafe_active
    && receipt.post_reboot_observer_exit_success
    && receipt.post_reboot_converge_noop_exit_success
}
