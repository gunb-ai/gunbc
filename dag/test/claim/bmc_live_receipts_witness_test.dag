module test.claim.bmc_live_receipts_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

// The firmware VERSION is the per-host observation and the only one. srv3 was
// flashed to 3.22.00 on 2026-08-11 and re-observed 2026-08-12; the surface it
// presents is no longer asserted here, because it is no longer stored here.
test fn firmware_versions_are_the_per_host_observation() -> Bool {
  srv3_bmc_firmware_observation.firmware.version.major == 3
    && srv3_bmc_firmware_observation.firmware.version.minor == 22
    && srv4_bmc_firmware_observation.firmware.version.major == 3
    && srv4_bmc_firmware_observation.firmware.version.minor == 22
}

test fn update_surface_receipts_do_not_claim_an_available_backup_image() -> Bool {
  srv3_bmc_update_service_observation.active_bmc_image_updateable
    && srv4_bmc_update_service_observation.active_bmc_image_updateable
    && !srv3_bmc_update_service_observation.backup_bmc_image_observed
    && !srv4_bmc_update_service_observation.backup_bmc_image_observed
}

test fn overlay_receipt_records_literal_mount_and_write_facts_only() -> Bool {
  match gunbc.fleet_bmc_observation.srv4_bmc_config_persistence_observation {
    extdeps.bmc.types.BmcOverlayConfigObserved {
      firmware: firmware,
      config_path: config_path,
      overlay: overlay,
      writable: writable,
      upper_override_present: upper_override_present,
      available_bytes: _,
      evidence_scope: _,
      observed_at: _,
    } =>
      firmware.version.major == 3
        && firmware.version.minor == 22
        && config_path == gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_config_path
        && extdeps.filesystem.linux.linux_overlay_observation_is_flash_backed(observation: overlay)
        && writable
        && upper_override_present
    extdeps.bmc.types.BmcConfigPersistenceUnsupported {
      firmware: _,
      config_path: _,
      reason: _,
      evidence_scope: _,
      observed_at: _,
    } => false
  }
}

test fn observed_fan_curve_is_validated_before_use() -> Bool {
  match extdeps.bmc.types.validate_bmc_fan_curve(curve: gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_curve) {
    extdeps.bmc.types.BmcFanCurveValid { curve: validated } =>
      validated.curve == gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_curve
    extdeps.bmc.types.BmcFanCurveInvalid { cause: _ } => false
  }
}

test fn duty_curve_cannot_fall_after_reaching_full_duty() -> Bool {
  let falling = extdeps.bmc.types.BmcFanCurve {
    control_sensor: "TEMP_SOC",
    steps: [
      extdeps.bmc.types.BmcFanCurveStep { at_or_above: std.measure.celsius(90), duty: std.measure.percent(100) },
      extdeps.bmc.types.BmcFanCurveStep { at_or_above: std.measure.celsius(95), duty: std.measure.percent(30) },
    ],
    minimum_duty: std.measure.percent(30),
    sensor_unavailable_duty: std.measure.percent(100),
    zone_failsafe_duty: std.measure.percent(100),
    positive_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
    negative_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
  }
  match extdeps.bmc.types.validate_bmc_fan_curve(curve: falling) {
    extdeps.bmc.types.BmcFanCurveInvalid {
      cause: extdeps.bmc.types.BmcFanCurveDutyDecreased { previous: _, current: _ },
    } => true
    _ => false
  }
}

test fn fan_curve_refuses_duty_above_full() -> Bool {
  let above_full = extdeps.bmc.types.BmcFanCurve {
    control_sensor: "TEMP_SOC",
    steps: [
      extdeps.bmc.types.BmcFanCurveStep { at_or_above: std.measure.celsius(90), duty: std.measure.percent(100) },
    ],
    minimum_duty: std.measure.percent(101),
    sensor_unavailable_duty: std.measure.percent(100),
    zone_failsafe_duty: std.measure.percent(100),
    positive_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
    negative_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
  }
  match extdeps.bmc.types.validate_bmc_fan_curve(curve: above_full) {
    extdeps.bmc.types.BmcFanCurveInvalid {
      cause: extdeps.bmc.types.BmcFanCurveDutyAboveFull {
        field: extdeps.bmc.types.BmcFanCurveMinimumDuty,
        duty: duty,
      },
    } => duty == std.measure.percent(101)
    _ => false
  }
}

test fn fan_curve_refuses_minimum_above_first_step() -> Bool {
  let below_minimum = extdeps.bmc.types.BmcFanCurve {
    control_sensor: "TEMP_SOC",
    steps: [
      extdeps.bmc.types.BmcFanCurveStep { at_or_above: std.measure.celsius(90), duty: std.measure.percent(30) },
      extdeps.bmc.types.BmcFanCurveStep { at_or_above: std.measure.celsius(95), duty: std.measure.percent(100) },
    ],
    minimum_duty: std.measure.percent(40),
    sensor_unavailable_duty: std.measure.percent(100),
    zone_failsafe_duty: std.measure.percent(100),
    positive_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
    negative_hysteresis: std.measure.positive_celsius_delta(
      count: std.measure.positive_measure_count(predecessor: 0),
    ),
  }
  match extdeps.bmc.types.validate_bmc_fan_curve(curve: below_minimum) {
    extdeps.bmc.types.BmcFanCurveInvalid {
      cause: extdeps.bmc.types.BmcFanCurveMinimumExceedsFirstStep {
        minimum: minimum,
        first_step: first_step,
      },
    } => minimum == std.measure.percent(40) && first_step == std.measure.percent(30)
    _ => false
  }
}

data fixture_proc_mounts: String = "cow / overlay rw,lowerdir=/run/initramfs/ro,upperdir=/run/initramfs/rw/cow 0 0\n/dev/mtdblock4 /run/initramfs/ro squashfs ro 0 0\n/dev/mtdblock5 /run/initramfs/rw jffs2 rw 0 0\n"

test fn proc_mounts_parser_derives_literal_overlay_paths() -> Bool {
  match extdeps.filesystem.linux.linux_overlay_observation_from_proc_mounts(
    proc_mounts: fixture_proc_mounts,
  ) {
    extdeps.filesystem.linux.LinuxOverlayParsed { observation: observation } =>
      observation.lower_directory == "/run/initramfs/ro"
        && observation.upper_directory == "/run/initramfs/rw/cow"
        && extdeps.filesystem.linux.linux_overlay_observation_is_flash_backed(observation: observation)
    extdeps.filesystem.linux.LinuxOverlayRefused { cause: _ } => false
  }
}

test fn proc_mounts_parser_decodes_kernel_mount_escapes() -> Bool {
  let escaped = "cow / overlay rw,lowerdir=/run/initramfs/ro\\040image,upperdir=/run/initramfs/rw/cow 0 0\n/dev/mtdblock4 /run/initramfs/ro\\040image squashfs ro 0 0\n/dev/mtdblock5 /run/initramfs/rw jffs2 rw 0 0"
  match extdeps.filesystem.linux.linux_overlay_observation_from_proc_mounts(proc_mounts: escaped) {
    extdeps.filesystem.linux.LinuxOverlayParsed { observation: observation } =>
      observation.lower_directory == "/run/initramfs/ro image"
        && observation.lower_backing_mount.target == "/run/initramfs/ro image"
    extdeps.filesystem.linux.LinuxOverlayRefused { cause: _ } => false
  }
}

test fn proc_mounts_parser_refuses_multi_lower_overlay() -> Bool {
  let multiple = "cow / overlay rw,lowerdir=/ro/a:/ro/b,upperdir=/rw/cow 0 0\n/dev/a /ro squashfs ro 0 0\n/dev/b /rw jffs2 rw 0 0"
  match extdeps.filesystem.linux.linux_overlay_observation_from_proc_mounts(proc_mounts: multiple) {
    extdeps.filesystem.linux.LinuxOverlayRefused {
      cause: extdeps.filesystem.linux.LinuxOverlayMultipleLowerDirectoriesUnsupported { wire: _ },
    } => true
    _ => false
  }
}

test fn proc_mounts_parser_refuses_relative_overlay_paths() -> Bool {
  let relative = "cow / overlay rw,lowerdir=ro,upperdir=/rw/cow 0 0\n/dev/a /ro squashfs ro 0 0\n/dev/b /rw jffs2 rw 0 0"
  match extdeps.filesystem.linux.linux_overlay_observation_from_proc_mounts(proc_mounts: relative) {
    extdeps.filesystem.linux.LinuxOverlayRefused {
      cause: extdeps.filesystem.linux.LinuxOverlayDirectoryNotAbsolute { path: "ro" },
    } => true
    _ => false
  }
}

test fn convergence_receipt_binds_host_realizer_readback_and_live_health() -> Bool {
  let receipt = gunbc.fleet_bmc_observation.srv4_bmc_fan_convergence_receipt
  receipt.host == srv4_host.identity
    && receipt.policy.curve == gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_curve
    && receipt.policy.board_config_path == gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_config_path
    && receipt.active_config_digest == gunbc.fleet_bmc_observation.srv4_bmc_fan_active_config_digest
    && !receipt.zone_failsafe_active
    && receipt.monitoring_sample_count == 12
    && receipt.final_tachs.length() == 4
    && fold(
      receipt.final_tachs,
      init: true,
      f: (healthy, tach) => healthy && std.measure.rpm_count(tach.reading) > 0,
    )
}

test fn restart_receipt_binds_one_literal_perturbation_generation_and_readback() -> Bool {
  let receipt = gunbc.fleet_bmc_state.srv4_bmc_fan_reboot_persistence_receipt
  receipt.host == srv4_host.identity
    && receipt.perturbation_generation == gunbc.fleet_bmc_observation.srv4_bmc_fan_perturbation_generation
    && receipt.reset.reset_type == extdeps.bmc.types.ResetGracefulRestart
    && receipt.reset.accepted
    && receipt.bmc_down_observed
    && receipt.bmc_returned
    && receipt.before.active_config_digest == gunbc.fleet_bmc_observation.srv4_bmc_fan_active_config_digest
    && receipt.post_reboot_active_config_digest == gunbc.fleet_bmc_observation.srv4_bmc_fan_active_config_digest
    && receipt.post_reboot_policy.curve == gunbc.fleet_bmc_observation.srv4_bmc_fan_observed_curve
    && receipt.post_reboot_controller_active
    && !receipt.post_reboot_zone_failsafe_active
    && receipt.post_reboot_observer_exit_success
    && receipt.post_reboot_converge_noop_exit_success
}
