}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// --- Each platform module joins the subject module that owns its identity ---

// FIELD-WISE, NOT WHOLE-RECORD, AND THE REASON IS A LIVE DEFECT NOT MINE TO FIX.
// Both subject records carry a `revision` field whose value is a bodyless type
// name (AltraPlatformHwDesignRev1_00, MtMitchellRev0_80), which typechecks but
// is an undefined VARIABLE at evaluation, so any expression that forces the
// whole record dies with a runtime error rather than answering. Reported to the
// module owner; when the revision carrier becomes constructible this collapses
// back to two record equalities.
test fn w_platform_facts_hang_off_the_subject_declarations() -> Bool {
  altra_platform_hw_design_subject.version_label == altra_platform_hw_design_specification.version_label
    && altra_platform_hw_design_subject.title == altra_platform_hw_design_specification.title
    && altra_platform_hw_design_subject.publication_date == altra_platform_hw_design_specification.publication_date
    && mt_mitchell_platform_subject.version_label == mt_mitchell_reference_platform.version_label
    && mt_mitchell_platform_subject.marketing_name == mt_mitchell_reference_platform.marketing_name
}

// --- Ampere Altra Platform Hardware Design Specification, revision 1.00 ---

test fn w_altra_platform_facts_are_not_claimed_current() -> Bool {
  !platform_facts_are_from_the_latest_revision()
}

test fn w_altra_two_dimms_per_channel_reaches_package_ceiling() -> Bool {
  dimm_slots_per_socket(topology: OneDimmPerChannel) == 8
    && dimm_slots_per_socket(topology: TwoDimmsPerChannel) == 16
    && altra_platform_max_dimm_slots_per_socket() == altra_max_dimms_per_socket
}

test fn w_altra_one_dimm_per_channel_uses_the_far_slot() -> Bool {
  one_dimm_per_channel_populated_slot() == DimmSlot0
    && dimm_slot_farther_from_cpu() == DimmSlot0
}

test fn w_altra_root_complex_structure_derives_the_lane_total() -> Bool {
  root_complex_count_of_type(kind: RootComplexTypeA) == 4
    && root_complex_count_of_type(kind: RootComplexTypeB) == 4
    && altra_root_complex_count() == 8
    && altra_derived_lane_total() == 128
    && altra_derived_lane_total() == altra_declared_lane_total()
    && altra_declared_lane_total() == altra_pcie_gen4_lane_count
    && altra_pcie_controller_count == 48
}

test fn w_altra_lane_groupings_partition_their_root_complex() -> Bool {
  type_a_grouping_lane_total(grouping: TypeAOneX16) == 16
    && type_a_grouping_lane_total(grouping: TypeATwoX8) == 16
    && type_a_grouping_lane_total(grouping: TypeAOneX8AndTwoX4) == 16
    && type_a_grouping_lane_total(grouping: TypeAFourX4) == 16
    && type_b_half_grouping_lane_total(grouping: TypeBOneX8) == 8
    && type_b_half_grouping_lane_total(grouping: TypeBTwoX4) == 8
}

test fn w_altra_ccix_capability_belongs_to_type_a_only() -> Bool {
  root_complex_supports_ccix(kind: RootComplexTypeA)
    && !root_complex_supports_ccix(kind: RootComplexTypeB)
    && altra_two_socket_ccix_port_count == 2
    && altra_two_socket_ccix_lane_width == 16
}

test fn w_altra_refclk_requirement_splits_by_input() -> Bool {
  refclk_always_required(input: RefclkSrns)
    && !refclk_always_required(input: RefclkSris)
    && hertz_count(h: altra_refclk_frequency) == 100000000
}

test fn w_altra_pcie_reset_is_cpld_decoded_without_per_controller_perst() -> Bool {
  !altra_has_dedicated_perst_per_controller()
    && !altra_has_native_hot_plug_controller()
    && altra_pcie_reset_scheme.gpio_output_max == 6
}

// --- OCP Mt. Mitchell motherboard specification, revision 0.80 ---

test fn w_mt_mitchell_revision_table_ends_at_the_modelled_revision() -> Bool {
  let latest = mt_mitchell_revision_table.last()
  list_length(items: mt_mitchell_revision_table) == 3
    && latest.revision == "0.80"
    && latest.year == 2022
    && latest.month == 9
    && latest.day == 9
    && mt_mitchell_revision_table.first().revision == "0.50"
}

test fn w_mt_mitchell_architecture_options_divide_into_whole_dimms_per_channel() -> Bool {
  list_length(items: mt_mitchell_architecture_options) == 3
    && all(mt_mitchell_architecture_options, o => architecture_slot_count_divides_channels(option: o))
    && architecture_dimms_per_channel(option: mt_mitchell_two_socket_eight_channel) == 2
    && architecture_dimms_per_channel(option: mt_mitchell_two_socket_twelve_channel) == 1
    && architecture_dimms_per_channel(option: mt_mitchell_one_socket_twelve_channel) == 2
    && architecture_channel_total(option: mt_mitchell_two_socket_eight_channel) == 16
    && architecture_channel_total(option: mt_mitchell_one_socket_twelve_channel) == 12
}

test fn w_mt_mitchell_mcio_population_cross_foots() -> Bool {
  mt_mitchell_derived_mcio_connector_total() == mt_mitchell_mcio_connector_total
    && mt_mitchell_mcio_connector_total == 13
}

test fn w_mt_mitchell_ocp_nic_modes_separate_width_from_host_count() -> Bool {
  mt_mitchell_ocp_nic_connector_count == 2
    && ocp_nic_unstrapped_host_mode() == SingleHostX8
    && ocp_nic_host_mode_lane_count(mode: SingleHostX8) == 8
    && ocp_nic_host_mode_lane_count(mode: SingleHostX16) == 16
    && ocp_nic_host_mode_lane_count(mode: MultiHostX16) == 16
    && !ocp_nic_host_mode_is_multi_host(mode: SingleHostX16)
    && ocp_nic_host_mode_is_multi_host(mode: MultiHostX16)
}

test fn w_mt_mitchell_inter_processor_links_split_evenly_across_sockets() -> Bool {
  let ports = mt_mitchell_inter_processor_link_ports
  list_length(items: ports) == 4
    && list_length(items: ports |> filter(p => inter_processor_link_socket(port: p) == 0)) == 2
    && list_length(items: ports |> filter(p => inter_processor_link_socket(port: p) == 1)) == 2
}

test fn w_mt_mitchell_board_dimensions_are_exact_in_micrometres() -> Bool {
  micrometer_count(m: mt_mitchell_board_width) == 424900
    && micrometer_count(m: mt_mitchell_board_depth) == 422900
    && rack_unit_count(u: mt_mitchell_chassis_height) == 2
}

// --- The separation itself ---

test fn w_the_two_specifications_target_different_memory_generations() -> Bool {
  dram_generation_eq(a: altra_platform_memory_generation, b: dram_generation_ddr4)
    && dram_generation_eq(a: mt_mitchell_memory_generation, b: dram_generation_ddr5)
    && !dram_generation_eq(a: altra_platform_memory_generation, b: mt_mitchell_memory_generation)
}

// --- RED controls: each goes red if the modelled fact stops discriminating ---

test fn w_red_fabricated_architecture_option_fails_the_channel_join() -> Bool {
  let fabricated = MtMitchellArchitectureOption {
    socket_count: 2,
    ddr_channels_per_socket: 12,
    dimm_slot_total: 30,
  }
  !architecture_slot_count_divides_channels(option: fabricated)
}

test fn w_red_a_grouping_that_lost_lanes_would_not_sum_to_its_root_complex() -> Bool {
  type_a_grouping_lane_total(grouping: TypeATwoX8) != 8
    && type_b_half_grouping_lane_total(grouping: TypeBTwoX4) != 16
}

test fn w_red_the_package_ceiling_is_not_the_one_dimm_per_channel_population() -> Bool {
  dimm_slots_per_socket(topology: OneDimmPerChannel) != altra_max_dimms_per_socket
}
