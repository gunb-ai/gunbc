  altra_platform_max_dimm_slots_per_socket,
  altra_platform_memory_generation,
  altra_refclk_frequency,
  altra_root_complex_count,
  altra_two_socket_ccix_lane_width,
  altra_two_socket_ccix_port_count,
  dimm_slot_farther_from_cpu,
  dimm_slots_per_socket,
  one_dimm_per_channel_populated_slot,
  platform_facts_are_from_the_latest_revision,
  refclk_always_required,
  root_complex_count_of_type,
  root_complex_supports_ccix,
  type_a_grouping_lane_total,
  type_b_half_grouping_lane_total,
}
