  RunLoad,
  RunLoaded,
  RunEmpty,
  RunUnreadable,
  loaded_runs,
  refused_load_lines
}
import gunbc.floor_cost_distribution {
  ClaimCostColumns,
  claim_cost_columns,
  CrossingRecurrence,
  identity_inflation_permille_at_equal_work,
  crossing_recurrence,
  recurring_crossers,
  FloorCostRow,
  RunCost,
  SameHeadAttemptPair,
  EvalStepDeterminismViolation,
  CostBand,
  LadderStep,
  parse_claim_cost_line,
  parse_claim_cost_tsv,
  accepted_rows,
  ClaimCostArtifact,
  ArtifactRows,
  ArtifactRefused,
  ArtifactRefusalCause,
  NoHeaderLine,
  HeaderNotReadable,
  MalformedDataRow,
  rows_in_band,
  rows_at_or_above,
  cost_bands,
  run_crossings,
  run_worst_cpu,
  runs_refused,
  worst_over_runs,
  identity_max_cpu,
  module_max_cpu,
  repair_ladder,
  identity_inflation_permille,
  identity_inflation,
  InflationObservations,
  permille_percentile,
  implied_clean_run_budget,
  ClaimCostReading,
  ObservedCpuReading,
  RightCensoredCpuReading,
  WorstCost,
  WorstObserved,
  WorstIsLowerBound,
  worst_cost_at_least_ms,
  observed_cpu_ms,
  cpu_at_least_ms,
  censored_rows,
  RowCrossing,
  RowCrossed,
  RowBelowLine,
  RowCrossingUndecidable,
  row_crossing,
  run_crossing_census,
  runs_crossing_undecidable,
  same_head_eval_step_violations,
  same_head_eval_steps_are_deterministic
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE FIXTURE IS HAND-BUILT AND TINY, DELIBERATELY. These derivations are consumed against ten
// downloaded run artifacts, and a witness that read those artifacts would be measuring whichever
// runs happened to be on disk -- green or red for reasons outside the diff. The subject here is
// the ARITHMETIC, so the fixture is small enough that every expected value is decidable by hand.
//
// Shape: two runs over the same three identities in two modules, one of which ("hot") crosses the
// 500ms ceiling on run B only. That is the exact shape the real analysis turns on -- a row whose
// membership in the crossing set depends on the run rather than on the row.
data row_a1: FloorCostRow = FloorCostRow { identity: "m.hot.x", module: "m.hot", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 400) }, eval_steps: 9000 }
data row_a2: FloorCostRow = FloorCostRow { identity: "m.mid.y", module: "m.mid", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 200) }, eval_steps: 4000 }
data row_a3: FloorCostRow = FloorCostRow { identity: "m.mid.z", module: "m.mid", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 50) }, eval_steps: 900 }

data row_b1: FloorCostRow = FloorCostRow { identity: "m.hot.x", module: "m.hot", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 600) }, eval_steps: 9000 }
data row_b2: FloorCostRow = FloorCostRow { identity: "m.mid.y", module: "m.mid", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 300) }, eval_steps: 4400 }
data row_b3: FloorCostRow = FloorCostRow { identity: "m.mid.z", module: "m.mid", verdict_reached: true, cost: ObservedCpuReading { cpu_ms: millisecond(count: 100) }, eval_steps: 900 }

// THE CENSORED FIXTURE ROW, and it is deliberately given a bound of 502ms against a 500ms
// ceiling -- the shape every interrupted row in the real artifact has, because a row is stopped
// approximately AT whatever ceiling stopped it. Its true cost is unknown and unbounded above; the
// receipt that this cannot be corrected for is gunbc#9629, where one such rendered figure denoted
// a completed cost of 2,902ms in one case and 355ms in another.
//
// `verdict_reached: false` BECAUSE A DEADLINE PREEMPTED IT, which is the ordinary pairing -- but
// the two fields are still independent, and gunbc#10209's determinism detector reads the boolean
// while every cost derivation reads the coproduct.
data row_c_censored: FloorCostRow = FloorCostRow {
  identity: "m.hot.k",
  module: "m.hot",
  verdict_reached: false,
  cost: RightCensoredCpuReading { cpu_lower_bound_ms: millisecond(count: 502), censoring_ceiling_ms: millisecond(count: 500) },
  eval_steps: 163840
}

data run_a: RunCost = RunCost { run: "runA" as NonEmptyStr, rows: [row_a1, row_a2, row_a3] }
data run_b: RunCost = RunCost { run: "runB" as NonEmptyStr, rows: [row_b1, row_b2, row_b3] }
data both_runs: List<RunCost> = [run_a, run_b]

// A run carrying one censored row beside two observed ones. Every arm below that must change
// behaviour in the presence of censoring is witnessed against THIS run and its censor-free peer,
// so a green can never come from the censored row simply being absent.
data run_c: RunCost = RunCost { run: "runC" as NonEmptyStr, rows: [row_b2, row_b3, row_c_censored] }

// PARSING: the artifact's own preamble must not become rows.
data sample_tsv: String = "# summary\texecuted=3\tcost_basis=cpu\nidentity\tmodule\toutcome\tverdict_reached\tcost_reading\tobserved_wall_ms\tobserved_cpu_ms\twall_at_least_ms\tcpu_at_least_ms\tcensoring_wall_limit_ms\tcensoring_cpu_limit_ms\tcensoring_raised_by\teval_steps\tcost_line_ms\nm.hot.x\tm.hot\tpass\ttrue\tobserved\t402\t400\t\t\t\t\t\t1000\t100\nm.mid.y\tm.mid\tpass\ttrue\tobserved\t201\t200\t\t\t\t\t\t900\t100"

// THE SAME ARTIFACT WITH ONE INTERRUPTED ROW, which is what every real required-floor run
// produces. Its cost columns are EMPTY and its bound columns are filled -- the two populations do
// not share a column, so a consumer projecting `observed_cpu_ms` over the file receives nothing
// for this row rather than a figure that is approximately the ceiling.
data censored_tsv: String = "# summary\texecuted=2\tcost_basis=cpu\nidentity\tmodule\toutcome\tverdict_reached\tcost_reading\tobserved_wall_ms\tobserved_cpu_ms\twall_at_least_ms\tcpu_at_least_ms\tcensoring_wall_limit_ms\tcensoring_cpu_limit_ms\tcensoring_raised_by\teval_steps\tcost_line_ms\nm.hot.x\tm.hot\tpass\ttrue\tobserved\t402\t400\t\t\t\t\t\t1000\t100\nm.hot.k\tm.hot\tbudget_interrupted\tfalse\tright_censored\t\t\t513\t509\t8000\t500\tcpu_deadline\t163840\t100"

// The layout the current artifact ships, resolved from its own header rather than assumed.
data sample_columns: ClaimCostColumns = ClaimCostColumns {
  identity: 0,
  module: 1,
  verdict_reached: 3,
  cost_reading: 4,
  observed_cpu_ms: 6,
  cpu_at_least_ms: 8,
  censoring_cpu_limit_ms: 10,
  eval_steps: 12
}

// THE OLD VINTAGE, VERBATIM. Run 33661252708's artifact has no `eval_steps` column at all -- the
// header is one field shorter and index 6 holds `cost_line_ms`, the constant 100. A positional
// parser reads that as a step count and produces microseconds-per-step near 2500 instead of near
// 2: not an error, a PLAUSIBLE NUMBER, which is why this is a refusal and not a warning.
data old_vintage_tsv: String = "# summary\texecuted=2\tcost_basis=cpu\nidentity\tmodule\toutcome\tverdict_reached\twall_ms\tcpu_ms\tcost_line_ms\nm.hot.x\tm.hot\tpass\ttrue\t402\t400\t100"

test fn an_artifact_without_the_steps_column_yields_no_rows_rather_than_reading_the_next_one() -> Bool {
  match parse_claim_cost_tsv(text: old_vintage_tsv) {
         ArtifactRows { rows: _ } => false
         ArtifactRefused { cause: c } => match c {
           HeaderNotReadable { header_line: _ } => true
           NoHeaderLine => false
           MalformedDataRow { line: _ } => false
         }
       }
    && match claim_cost_columns(header_line: "identity\tmodule\toutcome\tverdict_reached\twall_ms\tcpu_ms\tcost_line_ms") {
         Present { value: _ } => false
         Absent => true
       }
}

// THE DISCRIMINATING RED FOR THIS WHOLE CHANGE, AND IT IS A REFUSAL RATHER THAN A REPAIR.
//
// An artifact whose header carries the SHARED `cpu_ms` column -- every vintage produced before the
// reading became a coproduct -- cannot be parsed at all. That is the correct answer and not a
// regression: in such a file a completed cost and a right-censored bound occupy one column with
// only an adjacent `verdict_reached` to tell them apart, so the rows cannot be separated into the
// two populations, and reading them as costs is precisely the defect. A parser that fell back to
// reading `cpu_ms` for every row would be the absorbing arm DESIGN section 5 forbids.
//
// IF THIS TEST GOES GREEN BY THE PARSER ACCEPTING THE OLD HEADER, THE WALL IS GONE.
test fn a_shared_cpu_ms_column_refuses_rather_than_being_read_as_a_completed_cost() -> Bool {
  let shared_header = "identity\tmodule\toutcome\tverdict_reached\twall_ms\tcpu_ms\teval_steps\tcost_line_ms"
  let shared_tsv = concat(concat("# summary\texecuted=1\n", shared_header), "\nm.hot.k\tm.hot\tbudget_interrupted\tfalse\t513\t509\t163840\t100")
  match parse_claim_cost_tsv(text: shared_tsv) {
         ArtifactRows { rows: _ } => false
         ArtifactRefused { cause: c } => match c {
           HeaderNotReadable { header_line: _ } => true
           NoHeaderLine => false
           MalformedDataRow { line: _ } => false
         }
       }
    && match claim_cost_columns(header_line: shared_header) {
         Present { value: _ } => false
         Absent => true
       }
}

// AND ITS POSITIVE CONTROL, so the refusal above cannot be satisfied by a parser that rejects
// everything: the same interrupted row under the DISJOINT header parses, and it parses as a
// BOUND -- `observed_cpu_ms` answers Absent for it while `cpu_at_least_ms` answers 509.
test fn a_censored_row_parses_as_a_bound_and_yields_no_observed_cost() -> Bool {
  count(accepted_rows(artifact: parse_claim_cost_tsv(text: censored_tsv))) == 2
    && match accepted_rows(artifact: parse_claim_cost_tsv(text: censored_tsv)) |> filter(r => r.identity == "m.hot.k") |> first {
         Absent => false
         Present { value: r } =>
           match observed_cpu_ms(reading: r.cost) {
             Present { value: _ } => false
             Absent => millisecond_count(m: cpu_at_least_ms(reading: r.cost)) == 509
           }
       }
}

// A ROW WHOSE DECLARED KIND DOES NOT MATCH THE COLUMNS IT FILLED IS REFUSED, never repaired from
// the other arm. Recovering a figure from the opposite column is exactly the promotion this file
// exists to prevent, and it would be invisible because the recovered number is well-formed.
test fn a_kind_that_disagrees_with_its_filled_columns_yields_no_row() -> Bool {
  match parse_claim_cost_line(line: "m.x\tm\tpass\ttrue\tobserved\t402\t\t513\t509\t8000\t500\tcpu_deadline\t900\t100", columns: sample_columns) {
    Present { value: _ } => false
    Absent => match parse_claim_cost_line(line: "m.x\tm\tbudget_interrupted\tfalse\tright_censored\t402\t400\t\t\t\t\t\t900\t100", columns: sample_columns) {
      Present { value: _ } => false
      Absent => true
    }
  }
}

// AND THE POSITIVE CONTROL FOR THAT REFUSAL, so an empty population cannot be read as "the parser
// is broken": the same rows under a header that DOES carry the column parse normally.
test fn the_same_shape_with_a_steps_column_parses() -> Bool {
  count(accepted_rows(artifact: parse_claim_cost_tsv(text: sample_tsv))) == 2
}

// COLUMNS ARE FOUND BY NAME, WHICH MEANS A REORDERED HEADER STILL READS CORRECTLY. This is the
// discriminating red for the whole change: under a positional parser this fixture returns a row
// whose cpu and steps are swapped, and swapped values are two plausible numbers rather than an
// error.
test fn a_reordered_header_is_followed_rather_than_the_old_positions() -> Bool {
  let reordered = "identity\tmodule\teval_steps\tverdict_reached\tcost_reading\tcpu_at_least_ms\tcensoring_cpu_limit_ms\tobserved_cpu_ms\nm.hot.x\tm.hot\t1000\ttrue\tobserved\t\t\t400"
  match accepted_rows(artifact: parse_claim_cost_tsv(text: reordered)) |> first {
    Absent => false
    Present { value: r } =>
      match observed_cpu_ms(reading: r.cost) {
        Absent => false
        Present { value: c } => millisecond_count(m: c) == 400 && r.eval_steps == 1000
      }
  }
}

test fn the_summary_and_header_lines_are_not_rows() -> Bool {
  count(accepted_rows(artifact: parse_claim_cost_tsv(text: sample_tsv))) == 2
}

test fn a_parsed_row_takes_cpu_from_the_cpu_column_not_the_wall_column() -> Bool {
  match accepted_rows(artifact: parse_claim_cost_tsv(text: sample_tsv)) |> first {
    Absent => false
    Present { value: r } =>
      match observed_cpu_ms(reading: r.cost) {
        Absent => false
        Present { value: c } => millisecond_count(m: c) == 400 && r.identity == "m.hot.x" && r.module == "m.hot"
      }
  }
}

// THE DISCRIMINATING RED FOR THE PARSER, and it is the one that matters: a short or unparseable
// line must produce NO row rather than a zero-cost one. A fabricated zero would sit silently in
// the bottom band and make the population look safer than it is.
test fn an_unparseable_line_yields_no_row_rather_than_a_zero_cost_row() -> Bool {
  match parse_claim_cost_line(line: "m.broken\tm\tpass", columns: sample_columns) {
    Present { value: _ } => false
    Absent => match parse_claim_cost_line(line: "m.x\tm\tpass\ttrue\tobserved\t10\tNOT-A-NUMBER\t\t\t\t\t\t1\t100", columns: sample_columns) {
      Present { value: _ } => false
      Absent => true
    }
  }
}

test fn bands_partition_the_population_and_the_cumulative_counts_agree() -> Bool {
  let bands = cost_bands(rows: run_b.rows, edges: [0, 100, 300, 1000] |> map(e => millisecond(count: e)))
  count(bands) == 3
    && rows_in_band(rows: run_b.rows, lower_ms: millisecond(count: 0), upper_ms: millisecond(count: 100)) == 0
    && rows_in_band(rows: run_b.rows, lower_ms: millisecond(count: 100), upper_ms: millisecond(count: 300)) == 1
    && rows_in_band(rows: run_b.rows, lower_ms: millisecond(count: 300), upper_ms: millisecond(count: 1000)) == 2
    && rows_at_or_above(rows: run_b.rows, ms: millisecond(count: 300)) == 2
    && rows_at_or_above(rows: run_b.rows, ms: millisecond(count: 500)) == 1
}

// A RUN REFUSES EXISTENTIALLY OVER ROWS: runA has no crossing, runB has one.
test fn crossings_are_per_run_and_a_refusal_needs_only_one_row() -> Bool {
  count(run_crossings(run: run_a, ceiling_ms: millisecond(count: 500), excluded_modules: [])) == 0
    && count(run_crossings(run: run_b, ceiling_ms: millisecond(count: 500), excluded_modules: [])) == 1
    && runs_refused(runs: both_runs, ceiling_ms: millisecond(count: 500), excluded_modules: []) == 1
}

// THE COUNTERFACTUAL REPLAY, which is the derivation the memo's central correction rests on:
// excluding the crossing module must take the refused-run count to zero.
test fn excluding_the_crossing_module_replays_the_runs_clean() -> Bool {
  runs_refused(runs: both_runs, ceiling_ms: millisecond(count: 500), excluded_modules: ["m.hot"]) == 0
    && runs_refused(runs: both_runs, ceiling_ms: millisecond(count: 500), excluded_modules: ["m.mid"]) == 1
}

// AND ITS DISCRIMINATING RED: excluding an UNRELATED module must not change the verdict. Without
// this, an exclusion that silently dropped every row would also read as "clean" and the
// counterfactual would be vacuous.
test fn excluding_an_unrelated_module_leaves_the_refusal_standing() -> Bool {
  runs_refused(runs: both_runs, ceiling_ms: millisecond(count: 500), excluded_modules: ["m.absent"]) == 1
}

test fn the_worst_row_is_taken_over_every_run_not_the_latest() -> Bool {
  millisecond_count(m: worst_cost_at_least_ms(w: run_worst_cpu(run: run_a, excluded_modules: []))) == 400
    && millisecond_count(m: worst_cost_at_least_ms(w: worst_over_runs(runs: both_runs, excluded_modules: []))) == 600
    && millisecond_count(m: worst_cost_at_least_ms(w: worst_over_runs(runs: both_runs, excluded_modules: ["m.hot"]))) == 300
    && millisecond_count(m: worst_cost_at_least_ms(w: identity_max_cpu(runs: both_runs, identity: "m.mid.y"))) == 300
    && millisecond_count(m: worst_cost_at_least_ms(w: module_max_cpu(runs: both_runs, module: "m.mid"))) == 300
}

// THE LADDER: each step must be CUMULATIVE with the ones before it, not independent.
test fn the_repair_ladder_accumulates_its_removals() -> Bool {
  let steps = repair_ladder(runs: both_runs, ceiling_ms: millisecond(count: 500), already_excluded: [], order: ["m.hot", "m.mid"])
  count(steps) == 2
    && millisecond_count(m: worst_cost_at_least_ms(w: steps[0].worst)) == 300 && steps[0].runs_refused == 0
    && millisecond_count(m: worst_cost_at_least_ms(w: steps[1].worst)) == 0 && steps[1].runs_refused == 0
}

// INFLATION IS PAIRED ON IDENTITY, and the min_base filter drops rows too small to measure.
// m.hot.x 400->600 is 1500 permille; m.mid.y 200->300 is 1500; m.mid.z 50->100 is 2000.
test fn inflation_is_paired_on_identity_and_carried_in_permille() -> Bool {
  let all = identity_inflation_permille(base: run_a, other: run_b, min_base_ms: millisecond(count: 50))
  let big = identity_inflation_permille(base: run_a, other: run_b, min_base_ms: millisecond(count: 100))
  count(all) == 3 && count(big) == 2
    && any(all, v => v == 2000)
    && !any(big, v => v == 2000)
}

// THE PERCENTILE IS AN ORDER STATISTIC: every value it returns was observed.
test fn the_percentile_returns_an_observed_value_and_refuses_an_empty_population() -> Bool {
  match permille_percentile(values: [1000, 1200, 1500], percent: 50) {
    Absent => false
    Present { value: v } => v == 1200 && match permille_percentile(values: [], percent: 50) {
      Present { value: _ } => false
      Absent => true
    }
  }
}

test fn the_implied_budget_is_the_ceiling_deflated_by_the_measured_inflation() -> Bool {
  millisecond_count(m: implied_clean_run_budget(ceiling_ms: millisecond(count: 500), inflation_permille: 1600)) == 312
    && millisecond_count(m: implied_clean_run_budget(ceiling_ms: millisecond(count: 500), inflation_permille: 1000)) == 500
}

// THE LOAD REFUSAL ARMS. `RunEmpty` exists because an artifact DID download empty during the
// original analysis and silently emptied a ten-way identity intersection; a run that reads as zero
// rows is indistinguishable from a run in which nothing crossed, so it must refuse rather than
// contribute an empty population. These two rows keep both arms produced rather than merely
// declared.
test fn an_unreadable_or_empty_run_is_named_and_never_counted_as_loaded() -> Bool {
  let loads = [
    RunLoaded { run: run_a },
    RunEmpty { run: "runEmpty" as NonEmptyStr, path: "/x/runEmpty/required_floor_claim_cost.tsv" },
    RunUnreadable { run: "runGone" as NonEmptyStr, path: "/x/runGone/required_floor_claim_cost.tsv" }
  ]
  count(loaded_runs(loads: loads)) == 1
    && count(refused_load_lines(loads: loads)) == 2
    && any(refused_load_lines(loads: loads), l => l == "REFUSED empty run=runEmpty path=/x/runEmpty/required_floor_claim_cost.tsv")
}

// AND ITS DISCRIMINATING RED: an all-loaded set must produce NO refusal lines, so the arm above
// cannot be satisfied by a function that always reports something.
test fn a_complete_sample_produces_no_refusal_lines() -> Bool {
  count(refused_load_lines(loads: [RunLoaded { run: run_a }, RunLoaded { run: run_b }])) == 0
}

// THE STEP COUNT COMES FROM ITS OWN COLUMN, and this is worth a witness because it is the column
// every other one in this artifact could be mistaken for: the row carries wall, cpu, steps and a
// diagnostic line threshold side by side, and reading the wrong one produces a plausible number
// rather than an error. 1000 is the steps field of the fixture's first row; 400 is its cpu and 402
// its wall.
test fn a_parsed_row_takes_eval_steps_from_the_steps_column() -> Bool {
  match accepted_rows(artifact: parse_claim_cost_tsv(text: sample_tsv)) |> first {
    Absent => false
    Present { value: r } =>
      match observed_cpu_ms(reading: r.cost) {
        Absent => false
        Present { value: c } => r.eval_steps == 1000 && millisecond_count(m: c) == 400
      }
  }
}

// THE WORK-CONTROLLED PAIRING, AND ITS DISCRIMINATING RED IS THE ROW WHOSE WORK CHANGED. Fixture
// shape: `m.hot.x` runs 9000 steps in both runs and moves 400 -> 600ms, which is inflation;
// `m.mid.y` moves 200 -> 300ms but its steps move 4000 -> 4400, so its cost change is not
// separable and it must be DROPPED rather than counted at 1500 permille. A pairing that admitted
// it would report a work change as contention, which is the whole confound this exists to remove.
test fn equal_work_pairing_admits_the_unchanged_row_and_drops_the_changed_one() -> Bool {
  let controlled = identity_inflation_permille_at_equal_work(base: run_a, other: run_b, min_base_ms: millisecond(count: 100))
  let uncontrolled = identity_inflation_permille(base: run_a, other: run_b, min_base_ms: millisecond(count: 100))
  count(controlled) == 1 && count(uncontrolled) == 2
    && match controlled |> first { Absent => false  Present { value: v } => v == 1500 }
}

// AND THE REACH IS REPORTABLE, which is the first thing a reader should doubt: a work-controlled
// figure over one row of two is a clean instrument over half the population, and the caller must
// be able to say so rather than quoting the percentile alone.
test fn the_controlled_population_is_smaller_than_the_paired_one_and_countable() -> Bool {
  count(identity_inflation_permille_at_equal_work(base: run_a, other: run_b, min_base_ms: millisecond(count: 100)))
    < count(identity_inflation_permille(base: run_a, other: run_b, min_base_ms: millisecond(count: 100)))
}

// RECURRENCE OVER THE FIXTURE: `m.hot.x` crosses on run B alone, so it recurs ONCE and the
// recurring-crosser population is EMPTY. That is the shape a run-level cause produces, and an
// empty answer here is the finding rather than the absence of one.
test fn a_single_run_crossing_recurs_once_and_no_identity_recurs() -> Bool {
  let rec = crossing_recurrence(runs: both_runs, ceiling_ms: millisecond(count: 500), excluded_modules: [])
  count(rec) == 1
    && match rec |> first { Absent => false  Present { value: r } => r.identity == "m.hot.x" && r.runs_crossed == 1 }
    && count(recurring_crossers(recurrence: rec)) == 0
}

// THE POSITIVE CONTROL FOR RECURRENCE, so the empty answer above is not vacuous: over a run pair
// where the SAME identity crosses twice, it is counted twice and reported as recurring. Without
// this, `recurring_crossers` returning empty would be indistinguishable from a join that never
// matches anything.
test fn an_identity_crossing_in_two_runs_is_counted_twice_and_reported_recurring() -> Bool {
  let hot_a = RunCost { run: "hotA" as NonEmptyStr, rows: [row_b1] }
  let hot_b = RunCost { run: "hotB" as NonEmptyStr, rows: [row_b1] }
  let rec = crossing_recurrence(runs: [hot_a, hot_b], ceiling_ms: millisecond(count: 500), excluded_modules: [])
  count(rec) == 1
    && count(recurring_crossers(recurrence: rec)) == 1
    && match rec |> first { Absent => false  Present { value: r } => r.runs_crossed == 2 }
}

// ============================================================================================
// THE RIGHT-CENSORED POPULATION. Each arm below is paired with a censor-free control over the
// same shape, so no green here can come from the censored row merely being absent -- which is the
// failure this whole section exists to make impossible.
// ============================================================================================

// A BOUND IS NOT A COST, SO IT ENTERS NO BAND -- and the count of what was left out is reportable
// rather than being the silent difference between the bands and the population.
//
// THE RED THIS FORBIDS is the shape that made the class worth filing: were the bound admitted, the
// censored row would land in whichever band contains its ceiling, manufacturing exactly the
// "population dense near the ceiling" reading a band histogram is built to test for. Every
// interrupted row in a real artifact sits at approximately the same ceiling, so the manufactured
// density is guaranteed for ANY ceiling over ANY population and carries no information at all.
// FIXTURE SHAPE, so the expected values below are checkable without running anything: run_c holds
// 300ms and 100ms OBSERVED plus one row censored at >=502ms; run_b is the same three-row shape with
// every row observed (600/300/100). run_b is THE CONTROL -- it puts two rows in the top band, so
// the zero run_c reports there is the censoring and not an empty filter.
test fn a_censored_row_enters_no_band_and_is_counted_as_excluded() -> Bool {
  censored_rows(rows: run_c.rows) == 1
    && rows_in_band(rows: run_c.rows, lower_ms: millisecond(count: 500), upper_ms: millisecond(count: 1000)) == 0
    && rows_in_band(rows: run_c.rows, lower_ms: millisecond(count: 100), upper_ms: millisecond(count: 500)) == 2
    && rows_in_band(rows: run_b.rows, lower_ms: millisecond(count: 300), upper_ms: millisecond(count: 1000)) == 2
    && censored_rows(rows: run_b.rows) == 0
}

// THE ONE INFERENCE THE BOUND DOES SUPPORT, AND IT IS ADMITTED. "Was this row known to reach the
// line" is a LOWER-BOUND question, and a row stopped at a ceiling answers it. Excluding censored
// rows here would under-count crossings and make the floor read healthier than it is -- the one
// direction this figure must never err in, because `runs_refused` is built on it.
//
// SO THE TWO RULINGS SIT SIDE BY SIDE OVER ONE ROW: it enters no band and it does cross. That is
// not an inconsistency, it is the whole distinction -- a threshold question against a point
// question -- and this pair is the executable statement of it.
// THE THIRD ASSERTION IS NOT AN AFTERTHOUGHT: a censored row stays EXCLUDABLE BY MODULE, so the
// counterfactual replay reaches it like any other row rather than being pinned into every result.
test fn a_censored_row_still_counts_as_a_crossing_because_that_question_is_a_lower_bound() -> Bool {
  count(run_crossings(run: run_c, ceiling_ms: millisecond(count: 500), excluded_modules: [])) == 1
    && runs_refused(runs: [run_c], ceiling_ms: millisecond(count: 500), excluded_modules: []) == 1
    && runs_refused(runs: [run_c], ceiling_ms: millisecond(count: 500), excluded_modules: ["m.hot"]) == 0
}

// A MAXIMUM OVER A POPULATION CONTAINING A BOUND IS ITSELF A BOUND, and it says so in its type.
// This is the arm that a merged host calibration was authored on: the figure looked like a cost,
// it was folded as one, and no coefficient could have recovered the completed value from it
// (gunbc#9629 -- one rendered 502ms denoting 2,902ms in one case and 355ms in another).
//
// THE CONTROL IS THE CENSOR-FREE RUN, and it must answer WorstObserved. Without it, a function
// that returned WorstIsLowerBound unconditionally would pass the first half and have destroyed the
// distinction rather than made it.
test fn a_maximum_over_a_censored_population_is_typed_as_a_lower_bound() -> Bool {
  match run_worst_cpu(run: run_c, excluded_modules: []) {
    WorstObserved { cpu_ms: _ } => false
    WorstIsLowerBound { at_least_ms: b, censored_rows: n } =>
      millisecond_count(m: b) == 502 && n == 1
        && match run_worst_cpu(run: run_b, excluded_modules: []) {
             WorstIsLowerBound { at_least_ms: _, censored_rows: _ } => false
             WorstObserved { cpu_ms: c } => millisecond_count(m: c) == 600
           }
  }
}

// THE CENSORING IS UNION-PROPAGATED ACROSS RUNS rather than decided by whichever run held the
// maximum. Here run_b's observed 600ms is the largest figure in the sample and run_c's censored
// row is smaller -- so a fold that took the censoring from the WINNING run would report
// WorstObserved 600 and lose the fact that another run held a row of unknown, possibly larger,
// cost. A maximum is exact only when every member it ranged over was.
test fn one_censored_row_in_any_run_makes_the_fleet_wide_worst_a_bound() -> Bool {
  match worst_over_runs(runs: [run_b, run_c], excluded_modules: []) {
    WorstObserved { cpu_ms: _ } => false
    WorstIsLowerBound { at_least_ms: b, censored_rows: n } => millisecond_count(m: b) == 600 && n == 1
  }
}

// A RATIO NEEDS TWO COSTS, SO A PAIR WITH A CENSORED MEMBER YIELDS NO OBSERVATION -- AND THE
// EXCLUSION IS COUNTED, WHICH IS THE HALF THAT KEEPS THIS FROM BECOMING ITS OWN NEIGHBOUR.
//
// Dropping censored pairs and reporting the percentile over the survivors is
// `censored_estimator_drops_its_own_tail` exactly: the excluded pairs are systematically the
// expensive ones, so the statistic is biased low with no bound, and biased low precisely where the
// analysis is looking. Returning `censored_pairs` beside `permille` is what makes the exclusion
// STATED rather than silent, and a caller quoting a percentile without it has re-created that
// class from this one.
// FIXTURE SHAPE: run_b -> run_c pairs on m.mid.y (300->300) and m.mid.z (100->100); m.hot.x has no
// partner in run_c and m.hot.k none in run_b, so neither pairs at all.
//
// THE SECOND HALF IS THE ARM THAT REDS IF A BOUND EVER REACHES THE DIVISION, and it is why the
// test pairs a run against ITSELF: only then does the censored row have a partner. m.hot.k pairs
// with m.hot.k, and that pair must be refused and COUNTED rather than contributing a 1000-permille
// "no inflation" observation -- which is exactly what dividing the bound by itself would produce,
// and it is a perfectly plausible number.
test fn an_inflation_pair_with_a_censored_member_is_refused_and_counted() -> Bool {
  let obs = identity_inflation(base: run_b, other: run_c, min_base_ms: millisecond(count: 50))
  count(obs.permille) == 2 && obs.paired == 2 && obs.censored_pairs == 0
    && match identity_inflation(base: run_c, other: run_c, min_base_ms: millisecond(count: 50)) {
         InflationObservations { permille: p, paired: pd, censored_pairs: cp } =>
           count(p) == 2 && pd == 3 && cp == 1
       }
}

// THE THIRD CROSSING ARM, AND IT IS A RED THAT CANNOT FIRE ON TODAY'S CONSTANTS -- which is
// precisely why it is here rather than omitted as dead.
//
// A censored row is known only to have cost at least its own bound. Whether that settles "did it
// cross the line" depends on how the bound compares to the line, and today it always does: the CPU
// safety ceiling sits well above the cost line, so every censored row genuinely crossed. That is a
// coincidence between two constants in different modules with nothing asserting the ordering, not
// a property of the question -- so the case where it breaks is exercised HERE, on a fixture, where
// the line can be moved without moving either constant.
//
// THE FIXTURE MOVES THE LINE ABOVE THE BOUND rather than editing any live constant: asked about a
// 600ms line, the row censored at >=502ms is genuinely undecidable -- its true cost may be on
// either side of 600 and nothing in the artifact can say which.
// IT IS NOT SILENTLY DROPPED EITHER: the row leaves the crossed list and APPEARS in the
// undecidable one, so the count a caller reports is a refusal rather than an absence.
//
// AND THE CONTROL IS THE ARM THAT ACTUALLY HOLDS TODAY: at the real 500ms line the same row's
// bound clears it, so it is a sound crossing and the undecidable list is EMPTY. Without that half,
// a function answering Undecidable for every censored row would pass the first half and have
// destroyed the admission rather than guarded it.
test fn a_censored_row_below_the_line_is_undecidable_rather_than_assumed_to_have_crossed() -> Bool {
  match row_crossing(row: row_c_censored, ceiling_ms: millisecond(count: 600)) {
    RowCrossed => false
    RowBelowLine => false
    RowCrossingUndecidable =>
      count(run_crossing_census(run: run_c, ceiling_ms: millisecond(count: 600), excluded_modules: []).crossed) == 0
        && count(runs_crossing_undecidable(runs: [run_c], ceiling_ms: millisecond(count: 600), excluded_modules: [])) == 1
        && match row_crossing(row: row_c_censored, ceiling_ms: millisecond(count: 500)) {
             RowCrossed =>
               count(runs_crossing_undecidable(runs: [run_c], ceiling_ms: millisecond(count: 500), excluded_modules: [])) == 0
             RowBelowLine => false
             RowCrossingUndecidable => false
           }
  }
}

// AN OBSERVED ROW IS NEVER UNDECIDABLE, on either side of the line. The third arm belongs to
// censoring alone, so a defect that widened it to observed rows -- making the whole analysis
// refuse -- would be caught here rather than read as caution.
test fn an_observed_row_is_decided_in_both_directions_and_never_undecidable() -> Bool {
  match row_crossing(row: row_b1, ceiling_ms: millisecond(count: 500)) {
    RowCrossed => match row_crossing(row: row_b3, ceiling_ms: millisecond(count: 500)) {
      RowBelowLine => true
      RowCrossed => false
      RowCrossingUndecidable => false
    }
    RowBelowLine => false
    RowCrossingUndecidable => false
  }
}

// SAME HEAD, TWO ATTEMPTS, AND CPU IS DELIBERATELY DIFFERENT. The equal pair stays green because
// this wall judges work identity, not runner speed. The changed row is the discriminating red:
// filtering unequal-step rows out (the distribution instrument's correct behavior) would make
// the wall green over exactly the evidence it exists to refuse.
test fn same_head_completed_claims_require_exact_step_equality() -> Bool {
  let equal = SameHeadAttemptPair {
    left_head: "same-head" as NonEmptyStr,
    left_attempt: "attempt-2" as NonEmptyStr,
    left_rows: [row_a1],
    right_head: "same-head" as NonEmptyStr,
    right_attempt: "attempt-3" as NonEmptyStr,
    right_rows: [row_b1]
  }
  let drifted = SameHeadAttemptPair {
    left_head: "same-head" as NonEmptyStr,
    left_attempt: "attempt-2" as NonEmptyStr,
    left_rows: [row_a2],
    right_head: "same-head" as NonEmptyStr,
    right_attempt: "attempt-3" as NonEmptyStr,
    right_rows: [row_b2]
  }
  let different_trees = SameHeadAttemptPair {
    left_head: "head-a" as NonEmptyStr,
    left_attempt: "attempt-2" as NonEmptyStr,
    left_rows: [row_a1],
    right_head: "head-b" as NonEmptyStr,
    right_attempt: "attempt-3" as NonEmptyStr,
    right_rows: [row_b1]
  }
  same_head_eval_steps_are_deterministic(pair: equal)
    && !same_head_eval_steps_are_deterministic(pair: drifted)
    && match same_head_eval_step_violations(pair: drifted) |> first {
         Present { value: CompletedIdentityStepsDiffer { identity: id, module: m, left_attempt: _, left_steps: a, right_attempt: _, right_steps: b } } =>
           id == "m.mid.y" && m == "m.mid" && a == 4000 && b == 4400
         _ => false
       }
    && match same_head_eval_step_violations(pair: different_trees) |> first {
         Present { value: AttemptHeadsDiffer { left_head: a, left_attempt: _, right_head: b, right_attempt: _ } } => a == "head-a" && b == "head-b"
         _ => false
       }
}

// Population equality is part of the wall. Comparing only the intersection would certify a run
// after the differing row vanished or failed to reach verdict, the two easiest ways for an exact
// equality check to become vacuous.
test fn a_missing_or_interrupted_counterpart_refuses_instead_of_shrinking_the_comparison() -> Bool {
  let interrupted = FloorCostRow {
    identity: "m.hot.x",
    module: "m.hot",
    verdict_reached: false,
    cost: RightCensoredCpuReading { cpu_lower_bound_ms: millisecond(count: 500), censoring_ceiling_ms: millisecond(count: 500) },
    eval_steps: 8000
  }
  let missing = SameHeadAttemptPair {
    left_head: "same-head" as NonEmptyStr,
    left_attempt: "attempt-2" as NonEmptyStr,
    left_rows: [row_a1],
    right_head: "same-head" as NonEmptyStr,
    right_attempt: "attempt-3" as NonEmptyStr,
    right_rows: []
  }
  let unavailable = SameHeadAttemptPair {
    left_head: "same-head" as NonEmptyStr,
    left_attempt: "attempt-2" as NonEmptyStr,
    left_rows: [row_a1],
    right_head: "same-head" as NonEmptyStr,
    right_attempt: "attempt-3" as NonEmptyStr,
    right_rows: [interrupted]
  }
  match same_head_eval_step_violations(pair: missing) |> first {
    Present { value: CompletedIdentityAbsent { identity: id, module: m, completed_attempt: _, absent_attempt: _ } } => id == "m.hot.x" && m == "m.hot"
    _ => false
  } && match same_head_eval_step_violations(pair: unavailable) |> first {
    Present { value: CompletedIdentityUnavailable { identity: id, module: m, completed_attempt: _, unavailable_attempt: _ } } => id == "m.hot.x" && m == "m.hot"
    _ => false
  }
}

// THE DISCRIMINATING RED FOR THE PARSER BLOCKER, AND ITS TWO CONTROLS.
//
// The defect it fails on: a malformed data row DISAPPEARING while the analysis proceeds over the
// rows that survived it. That is DESIGN section 5's absorbing fallback inverted -- a silent NARROW
// rather than a widen -- and it is invisible from every downstream figure, because a shrunken
// population stays internally consistent. This module's coproduct makes it unwritable to read a
// bound as an exact cost, but a row that vanishes before it is judged never reaches the coproduct,
// so a guarantee about how rows are CLASSIFIED is worth nothing without one that every declared
// row WAS classified.
//
// IF THIS GOES GREEN BY THE PARSER SILENTLY DROPPING THE BAD ROW AND RETURNING THE OTHER ONE, THE
// WALL IS GONE -- so the arm asserts the REFUSAL and names the offending line, not a count.
test fn a_malformed_data_row_refuses_the_whole_artifact_rather_than_vanishing() -> Bool {
  let header = "identity\tmodule\toutcome\tverdict_reached\tcost_reading\tobserved_wall_ms\tobserved_cpu_ms\twall_at_least_ms\tcpu_at_least_ms\tcensoring_wall_limit_ms\tcensoring_cpu_limit_ms\tcensoring_raised_by\teval_steps\tcost_line_ms"
  let good = "m.ok.a\tm.ok\tpass\ttrue\tobserved\t402\t400\t\t\t\t\t\t900\t100"
  let torn = "m.torn.b\tm.torn\tpass"
  match parse_claim_cost_tsv(text: concat(concat(concat(header, "\n"), concat(good, "\n")), torn)) {
    ArtifactRows { rows: _ } => false
    ArtifactRefused { cause: c } => match c {
      MalformedDataRow { line: l } => l == torn
      NoHeaderLine => false
      HeaderNotReadable { header_line: _ } => false
    }
  }
}

// CONTROL ONE, so the refusal above cannot come from a parser that refuses everything: the SAME
// artifact without the torn line is ACCEPTED and yields its row.
test fn the_same_artifact_without_the_torn_row_is_accepted() -> Bool {
  let header = "identity\tmodule\toutcome\tverdict_reached\tcost_reading\tobserved_wall_ms\tobserved_cpu_ms\twall_at_least_ms\tcpu_at_least_ms\tcensoring_wall_limit_ms\tcensoring_cpu_limit_ms\tcensoring_raised_by\teval_steps\tcost_line_ms"
  let good = "m.ok.a\tm.ok\tpass\ttrue\tobserved\t402\t400\t\t\t\t\t\t900\t100"
  match parse_claim_cost_tsv(text: concat(concat(header, "\n"), good)) {
    ArtifactRefused { cause: _ } => false
    ArtifactRows { rows: r } => count(r) == 1
  }
}

// CONTROL TWO, so the refusal is not merely "any line that fails to parse": the `#` summary line
// and a blank line are NOT declared rows, and an artifact carrying both is still accepted. Without
// this, the fix could be satisfied by refusing every artifact the instrument has ever read.
test fn the_summary_and_blank_lines_are_not_malformed_rows() -> Bool {
  let header = "identity\tmodule\toutcome\tverdict_reached\tcost_reading\tobserved_wall_ms\tobserved_cpu_ms\twall_at_least_ms\tcpu_at_least_ms\tcensoring_wall_limit_ms\tcensoring_cpu_limit_ms\tcensoring_raised_by\teval_steps\tcost_line_ms"
  let good = "m.ok.a\tm.ok\tpass\ttrue\tobserved\t402\t400\t\t\t\t\t\t900\t100"
  match parse_claim_cost_tsv(text: concat(concat(concat("# summary\texecuted=1\n", concat(header, "\n")), concat(good, "\n")), "")) {
    ArtifactRefused { cause: _ } => false
    ArtifactRows { rows: r } => count(r) == 1
  }
}

// AN ARTIFACT WITH NO HEADER IS REFUSED AND NAMED, NOT REPORTED AS EMPTY. `RunEmpty` and
// `RunRefused` are different facts about a run and the instrument now carries both.
test fn an_artifact_with_no_header_is_refused_rather_than_empty() -> Bool {
  match parse_claim_cost_tsv(text: "# summary\texecuted=0\nnothing here") {
    ArtifactRows { rows: _ } => false
    ArtifactRefused { cause: c } => match c {
      NoHeaderLine => true
      HeaderNotReadable { header_line: _ } => false
      MalformedDataRow { line: _ } => false
    }
  }
}
