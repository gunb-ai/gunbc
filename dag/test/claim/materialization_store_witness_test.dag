import std.cache_identity { CacheInterfaceId }
import std.measure { byte_size }
import std.materialization_provider {
  DeclaredInput, ArtifactRequest, ArtifactManifest,
  NativeCompilerArtifactRequest, UniverseArtifactRequest, NativeModuleVerdictBundleRequest,
  NativeModuleVerdictBundleSubject,
  RealizationServed, RealizationCommitted, RealizationConvergedOnPriorCommit,
  request_key, request_kind, request_required_outputs,
  output_module_test_verdicts, output_module_preparation_diagnostics,
  output_universe_test_identity_population, output_universe_module_import_closures,
  output_native_compiler_executable,
}
import std.materialization_store_grant { WitnessScratchRoot, DurableHostVolumeRoot }
import std.materialization_object {
  ArtifactPayload, payload_part,
  OpenedMaterializationStore,
  StoreFault, StoreFaultUnreachable,
  StoreObjectPresent, StoreObjectAbsent, StoreObjectUnavailable,
  StoreObjectPublished, StoreObjectOccupied, StoreObjectPublishRefused,
  StoreLookup, StoreLookupHit, StoreLookupMiss, StoreLookupRefused,
  StoreCommitPreparation, StoreCommitPrepared, StoreCommitNotPrepared, StoreCommitSettled, StoreCommitRefused,
  StoreObjectPublish,
