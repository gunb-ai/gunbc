  FilesystemExactPathAbsent, FilesystemExactPathUnreadable, FilesystemExactPathKindUnrecognized,
  FilesystemExactPathRead, FilesystemCreateTargetOccupied, FilesystemCreateRefused,
  filesystem_exact_read, filesystem_create_new,
}
