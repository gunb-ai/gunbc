module test.claim.source_admission_selection_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

type FixtureTrees {
  base: extdeps.git.object_store.GitObjectId
  head: extdeps.git.object_store.GitObjectId
  other: extdeps.git.object_store.GitObjectId
}

fn fixture_trees() -> FixtureTrees? {
  match extdeps.git.object_store.git_sha1_object_id(hex: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") {
    Absent => none
    Present { value: base } =>
      match extdeps.git.object_store.git_sha1_object_id(hex: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") {
        Absent => none
        Present { value: head } =>
          match extdeps.git.object_store.git_sha1_object_id(hex: "cccccccccccccccccccccccccccccccccccccccc") {
            Absent => none
            Present { value: other } =>
              Present {
                value: FixtureTrees { base: base, head: head, other: other },
              }
          }
      }
  }
}

fn on_trees(body: fn(FixtureTrees) -> Bool) -> Bool {
  match fixture_trees() {
    Absent => false
    Present { value: trees } => body(trees)
  }
}

fn mechanism_a() -> gunbc.source_admission_selection.ComputedMechanismIdentity {
  gunbc.source_admission_selection.fixture_computed_mechanism(executing: gunbc.source_admission_selection.SeedRustExecuting, label: "mechanism-a")
}

fn mechanism_b() -> gunbc.source_admission_selection.ComputedMechanismIdentity {
  gunbc.source_admission_selection.fixture_computed_mechanism(executing: gunbc.source_admission_selection.SeedRustExecuting, label: "mechanism-b")
}

fn mechanism_self_emitted() -> gunbc.source_admission_selection.ComputedMechanismIdentity {
  gunbc.source_admission_selection.fixture_computed_mechanism(executing: gunbc.source_admission_selection.SelfEmittedExecuting, label: "mechanism-a")
}

fn identity_of(file: gunbc.source_admission_selection.SourcePoolFile) -> gunbc.source_admission_selection.ActiveSourceIdentity {
  gunbc.source_admission_selection.ActiveSourceIdentity {
    module_path: file.module_path,
    path: file.path,
    content_digest: file.content_digest,
  }
}

fn observed_from_files(files: List<gunbc.source_admission_selection.SourcePoolFile>) -> gunbc.source_admission_selection.ActiveSourceManifest {
  let rows = gunbc.source_admission_selection.project_active_source_rows(files: files)
  gunbc.source_admission_selection.admit_active_source_manifest(
    rows: rows,
    expected_keys: map(rows, r => r.module_path)
  )
}

fn mint_from_files(
  tree: extdeps.git.object_store.GitObjectId,
  mechanism: gunbc.source_admission_selection.ComputedMechanismIdentity,
  files: List<gunbc.source_admission_selection.SourcePoolFile>
) -> gunbc.source_admission_selection.AnnotationCorpusAdmitted? {
  let rows = gunbc.source_admission_selection.project_active_source_rows(files: files)
  gunbc.source_admission_selection.mint_annotation_corpus_admitted(
    tree: tree,
    mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism },
    manifest: gunbc.source_admission_selection.admit_active_source_manifest(
      rows: rows,
      expected_keys: map(rows, r => r.module_path)
    ),
    admitted: rows,
  )
}

fn select_with_receipt(
  trees: FixtureTrees,
  receipt: gunbc.source_admission_selection.AnnotationCorpusAdmitted,
  head_mechanism: gunbc.source_admission_selection.AnnotationMechanismIdentity,
  head_files: List<gunbc.source_admission_selection.SourcePoolFile>
) -> gunbc.source_admission_selection.SourceAdmissionSelection {
  gunbc.source_admission_selection.select_source_admission(
    evaluating_merge_tree: true,
    base_tree: trees.base,
    head_tree: trees.head,
    base_receipt: Present { value: receipt },
    head_mechanism: head_mechanism,
    head_manifest: observed_from_files(files: head_files),
  )
}

fn refusal_is(
  sel: gunbc.source_admission_selection.SourceAdmissionSelection,
  wanted: gunbc.source_admission_selection.SourceTransitionRefusalCause
) -> Bool {
  match gunbc.source_admission_selection.source_admission_refusal_cause(sel: sel) {
    Absent => false
    Present { value: cause } => cause == wanted
  }
}

fn file_high() -> gunbc.source_admission_selection.SourcePoolFile {
  gunbc.source_admission_selection.fixture_source(
    root_ordinal: 0,
    module_path: "mod.alpha",
    path: "root0/alpha.dag",
    label: "alpha-high",
  )
}

fn file_low() -> gunbc.source_admission_selection.SourcePoolFile {
  gunbc.source_admission_selection.fixture_source(
    root_ordinal: 1,
    module_path: "mod.alpha",
    path: "root1/alpha.dag",
    label: "alpha-low",
  )
}

fn file_beta() -> gunbc.source_admission_selection.SourcePoolFile {
  gunbc.source_admission_selection.fixture_source(
    root_ordinal: 0,
    module_path: "mod.beta",
    path: "root0/beta.dag",
    label: "beta-v1",
  )
}

fn file_beta_changed() -> gunbc.source_admission_selection.SourcePoolFile {
  gunbc.source_admission_selection.fixture_source(
    root_ordinal: 0,
    module_path: "mod.beta",
    path: "root0/beta.dag",
    label: "beta-v2",
  )
}

fn file_gamma() -> gunbc.source_admission_selection.SourcePoolFile {
  gunbc.source_admission_selection.fixture_source(
    root_ordinal: 0,
    module_path: "mod.gamma",
    path: "root0/gamma.dag",
    label: "gamma-v1",
  )
}

test fn source_admission_production_mechanism_identity_is_unobservable() -> Bool {
  match gunbc.source_admission_selection.production_annotation_mechanism_identity() {
    gunbc.source_admission_selection.MechanismIdentityComputed { computed: _ } => false
    gunbc.source_admission_selection.MechanismIdentityUnobservable { cause: _ } => true
  }
}

test fn source_admission_induction_standing_awaits_computed_identity_on_8201_head() -> Bool {
  match gunbc.source_admission_selection.annotation_corpus_induction_standing() {
    Absent => false
    Present { value: standing } =>
      match standing {
        gunbc.source_admission_selection.AwaitingComputedMechanismIdentity { tree: tree } =>
          extdeps.git.object_store.git_object_id_eq(left: tree, right: gunbc.source_admission_selection.annotation_corpus_induction_base_tree)
        gunbc.source_admission_selection.AwaitingAdmittedSourceJoin { tree: _, mechanism: _ } => false
        gunbc.source_admission_selection.CorpusAdmitted { receipt: _ } => false
      }
  }
}

test fn source_admission_cannot_mint_receipt_when_mechanism_unobservable() -> Bool {
  on_trees(body: fn(trees) {
    let rows = [identity_of(file: file_beta())]
    match gunbc.source_admission_selection.mint_annotation_corpus_admitted(
      tree: trees.base,
      mechanism: gunbc.source_admission_selection.production_annotation_mechanism_identity(),
      manifest: gunbc.source_admission_selection.admit_active_source_manifest(
        rows: rows,
        expected_keys: ["mod.beta"]
      ),
      admitted: rows,
    ) {
      Present { value: _ } => false
      Absent => true
    }
  })
}

test fn source_admission_cannot_mint_receipt_when_admitted_set_is_not_identity_join() -> Bool {
  on_trees(body: fn(trees) {
    let observed = [identity_of(file: file_beta()), identity_of(file: file_gamma())]
    let admitted = [identity_of(file: file_beta()), identity_of(file: file_beta())]
    match gunbc.source_admission_selection.mint_annotation_corpus_admitted(
      tree: trees.base,
      mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
      manifest: gunbc.source_admission_selection.admit_active_source_manifest(
        rows: observed,
        expected_keys: ["mod.beta", "mod.gamma"]
      ),
      admitted: admitted,
    ) {
      Present { value: _ } => false
      Absent => true
    }
  })
}

test fn source_admission_same_count_different_keys_is_incomplete_walk_not_observed() -> Bool {
  match gunbc.source_admission_selection.admit_active_source_manifest(
    rows: [identity_of(file: file_beta())],
    expected_keys: ["mod.gamma"]
  ) {
    gunbc.source_admission_selection.ManifestObserved { rows: _ } => false
    gunbc.source_admission_selection.ManifestUnobservable { cause: cause } =>
      match cause {
        gunbc.source_admission_selection.IncompleteWalk { expected_keys: _, observed_count: n } => n == 1
        gunbc.source_admission_selection.EmptyUniverse => false
        gunbc.source_admission_selection.DuplicateModulePath { module_path: _ } => false
      }
  }
}

test fn source_admission_empty_expected_keys_is_empty_universe() -> Bool {
  match gunbc.source_admission_selection.admit_active_source_manifest(rows: [], expected_keys: []) {
    gunbc.source_admission_selection.ManifestObserved { rows: _ } => false
    gunbc.source_admission_selection.ManifestUnobservable { cause: cause } =>
      match cause {
        gunbc.source_admission_selection.EmptyUniverse => true
        gunbc.source_admission_selection.IncompleteWalk { expected_keys: _, observed_count: _ } => false
        gunbc.source_admission_selection.DuplicateModulePath { module_path: _ } => false
      }
  }
}

test fn source_admission_partial_walk_refuses_not_observed_with_fewer_rows() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        refusal_is(
          sel: gunbc.source_admission_selection.select_source_admission(
            evaluating_merge_tree: true,
            base_tree: trees.base,
            head_tree: trees.head,
            base_receipt: Present { value: receipt },
            head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
            head_manifest: gunbc.source_admission_selection.admit_active_source_manifest(
              rows: [identity_of(file: file_beta())],
              expected_keys: ["mod.beta", "mod.gamma"]
            ),
          ),
          wanted: gunbc.source_admission_selection.TransitionManifestUnobservable,
        )
    }
  })
}

test fn source_admission_not_merge_tree_refuses() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        refusal_is(
          sel: gunbc.source_admission_selection.select_source_admission(
            evaluating_merge_tree: false,
            base_tree: trees.base,
            head_tree: trees.head,
            base_receipt: Present { value: receipt },
            head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
            head_manifest: observed_from_files(files: [file_beta()]),
          ),
          wanted: gunbc.source_admission_selection.NotMergeTree,
        )
    }
  })
}

test fn source_admission_missing_base_receipt_refuses_not_incremental_empty() -> Bool {
  on_trees(body: fn(trees) {
    let sel = gunbc.source_admission_selection.select_source_admission(
      evaluating_merge_tree: true,
      base_tree: trees.base,
      head_tree: trees.head,
      base_receipt: none,
      head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
      head_manifest: observed_from_files(files: [file_beta()]),
    )
    refusal_is(sel: sel, wanted: gunbc.source_admission_selection.BaseReceiptAbsent)
      && gunbc.source_admission_selection.source_admission_is_incremental(sel: sel) == false
      && gunbc.source_admission_selection.source_admission_is_unchanged_noop(sel: sel) == false
  })
}

test fn source_admission_production_unobservable_refuses_even_with_fixture_receipt() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        refusal_is(
          sel: select_with_receipt(
            trees: trees,
            receipt: receipt,
            head_mechanism: gunbc.source_admission_selection.production_annotation_mechanism_identity(),
            head_files: [file_beta()],
          ),
          wanted: gunbc.source_admission_selection.TransitionMechanismIdentityUnobservable,
        )
    }
  })
}

test fn source_admission_identical_manifest_is_unchanged_noop_not_empty_incremental() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta(), file_gamma()]
    ) {
      Absent => false
      Present { value: receipt } =>
        let sel = select_with_receipt(
          trees: trees,
          receipt: receipt,
          head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
          head_files: [file_beta(), file_gamma()],
        )
        gunbc.source_admission_selection.source_admission_is_unchanged_noop(sel: sel)
          && gunbc.source_admission_selection.source_admission_is_incremental(sel: sel) == false
          && gunbc.source_admission_selection.incremental_changed_module_paths(sel: sel) == []
    }
  })
}

test fn source_admission_content_change_selects_only_the_changed_head_row() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta(), file_gamma()]
    ) {
      Absent => false
      Present { value: receipt } =>
        let sel = select_with_receipt(
          trees: trees,
          receipt: receipt,
          head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
          head_files: [file_beta_changed(), file_gamma()],
        )
        gunbc.source_admission_selection.source_admission_is_incremental(sel: sel)
          && gunbc.source_admission_selection.incremental_changed_module_paths(sel: sel) == ["mod.beta"]
    }
  })
}

test fn source_admission_removal_only_is_unchanged_noop() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta(), file_gamma()]
    ) {
      Absent => false
      Present { value: receipt } =>
        let sel = select_with_receipt(
          trees: trees,
          receipt: receipt,
          head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
          head_files: [file_beta()],
        )
        gunbc.source_admission_selection.source_admission_is_unchanged_noop(sel: sel)
    }
  })
}

test fn source_admission_known_mechanism_digest_change_is_entire_head_not_refused() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        let sel = select_with_receipt(
          trees: trees,
          receipt: receipt,
          head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_b() },
          head_files: [file_beta()],
        )
        gunbc.source_admission_selection.source_admission_is_entire_head(sel: sel)
          && gunbc.source_admission_selection.source_admission_is_incremental(sel: sel) == false
    }
  })
}

test fn source_admission_seed_to_self_emitted_is_entire_head_even_with_same_digest_label() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        gunbc.source_admission_selection.source_admission_is_entire_head(
          sel: select_with_receipt(
            trees: trees,
            receipt: receipt,
            head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_self_emitted() },
            head_files: [file_beta()],
          )
        )
    }
  })
}

test fn source_admission_primary_precedence_independent_of_pool_file_list_order() -> Bool {
  let forward = gunbc.source_admission_selection.project_active_source_rows(files: [file_high(), file_low()])
  let reversed = gunbc.source_admission_selection.project_active_source_rows(files: [file_low(), file_high()])
  gunbc.source_admission_selection.active_source_lists_identity_join(expected: forward, observed: reversed)
    && forward |> any(row => row.path == "root0/alpha.dag")
}

test fn source_admission_deleting_higher_precedence_exposes_lower_as_incremental() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_high(), file_low()]
    ) {
      Absent => false
      Present { value: receipt } =>
        let sel = select_with_receipt(
          trees: trees,
          receipt: receipt,
          head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
          head_files: [file_low()],
        )
        gunbc.source_admission_selection.source_admission_is_incremental(sel: sel)
          && gunbc.source_admission_selection.incremental_changed_module_paths(sel: sel) == ["mod.alpha"]
          && match sel {
            gunbc.source_admission_selection.IncrementalSources { changed: changed } =>
              gunbc.source_admission_selection.nonempty_active_sources_all(rows: changed) |> any(row =>
                row.path == "root1/alpha.dag"
              )
            _ => false
          }
    }
  })
}

test fn source_admission_deleting_shadowed_loser_is_active_map_noop() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.base,
      mechanism: mechanism_a(),
      files: [file_high(), file_low()]
    ) {
      Absent => false
      Present { value: receipt } =>
        gunbc.source_admission_selection.source_admission_is_unchanged_noop(
          sel: select_with_receipt(
            trees: trees,
            receipt: receipt,
            head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
            head_files: [file_high()],
          )
        )
    }
  })
}

test fn source_admission_receipt_tree_mismatch_refuses() -> Bool {
  on_trees(body: fn(trees) {
    match mint_from_files(
      tree: trees.other,
      mechanism: mechanism_a(),
      files: [file_beta()]
    ) {
      Absent => false
      Present { value: receipt } =>
        refusal_is(
          sel: gunbc.source_admission_selection.select_source_admission(
            evaluating_merge_tree: true,
            base_tree: trees.base,
            head_tree: trees.head,
            base_receipt: Present { value: receipt },
            head_mechanism: gunbc.source_admission_selection.MechanismIdentityComputed { computed: mechanism_a() },
            head_manifest: observed_from_files(files: [file_beta()]),
          ),
          wanted: gunbc.source_admission_selection.BaseReceiptTreeMismatch,
        )
    }
  })
}

test fn source_admission_seed_roots_name_executing_path_not_dag_only() -> Bool {
  gunbc.source_admission_selection.admission_mechanism_seed_roots |> any(root =>
    (root.realization_file as String) == "src/v1/stage0/src/v1_compiler_tokenize.rs"
      && (root.function_name as String) == "tokenize_artifact"
  ) && gunbc.source_admission_selection.admission_mechanism_seed_roots |> any(root =>
    (root.function_name as String) == "alloc_occurrence_id"
  )
}
