module test.claim.cargo_version


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn w_stage0_default_package_version() -> Bool {
  extdeps.cargo_version.default_stage0_package_version == "0.1.0"
    && extdeps.cargo_version.render_cargo_package_version_field(version: extdeps.cargo_version.default_stage0_package_version) == "version = \"0.1.0\""
}

fn w_package_version_field_renders() -> Bool {
  let pkg = extdeps.cargo.CargoPackage {
    name: "demo",
    version: "2.4.6",
    edition: extdeps.cargo.Edition2021,
    path: "."
  }
  extdeps.cargo_version.render_cargo_package_version_field(version: pkg.version) == "version = \"2.4.6\""
}

fn w_registry_dep_version_requirements() -> Bool {
  let serde = extdeps.cargo.CargoDependency {
    name: "serde",
    source: extdeps.cargo.RegistryDep { version: "1", features: ["derive", "rc"] }
  }
  let stacker = extdeps.cargo.CargoDependency {
    name: "stacker",
    source: extdeps.cargo.RegistryDep { version: "0.1", features: [] }
  }
  match serde.source {
    extdeps.cargo.RegistryDep { version: v, features: f } =>
      extdeps.cargo_version.render_cargo_version_requirement_toml(req: v) == "\"1\""
        && (f |> count) == 2
    extdeps.cargo.LocalPathDep { path: _ } => false
  }
    && match stacker.source {
      extdeps.cargo.RegistryDep { version: v, features: f } =>
        extdeps.cargo_version.render_cargo_version_requirement_toml(req: v) == "\"0.1\""
          && (f |> count) == 0
      extdeps.cargo.LocalPathDep { path: _ } => false
    }
}

fn w_requirement_distinct_from_package_version() -> Bool {
  extdeps.cargo_version.render_cargo_version_requirement_toml(req: "1") != extdeps.cargo_version.render_cargo_package_version_field(version: "1.0.0")
}

fn w_emitter_header_prefix_uses_default() -> Bool {
  extdeps.cargo_version.render_cargo_package_header_prefix(name: "demo-crate") == "[package]\nname = \"demo-crate\"\nversion = \"0.1.0\""
}

fn w_min_cargo_version_grounded() -> Bool {
  extdeps.cargo.min_cargo_version == ">= 1.56"
}

fn dep_requirement_one() -> extdeps.cargo_version.CargoVersionRequirement { "1" }

fn w_tool_floor_distinct_from_dep_requirement() -> Bool {
  extdeps.cargo.min_cargo_version != dep_requirement_one()
}

test fn cargo_version_witnesses() -> Bool {
  w_stage0_default_package_version()
    && w_package_version_field_renders()
    && w_registry_dep_version_requirements()
    && w_requirement_distinct_from_package_version()
    && w_emitter_header_prefix_uses_default()
    && w_min_cargo_version_grounded()
    && w_tool_floor_distinct_from_dep_requirement()
}
