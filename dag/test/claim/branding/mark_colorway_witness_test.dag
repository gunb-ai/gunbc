module test.claim.branding.mark_colorway_witness_test

import std.types { Bool }
import gunbc.branding.colorways { brand_colorways, brand_colorways_distinct, brand_colorway_salmon_and_void, brand_colorway_stark }
import gunbc.branding.colorway_svg { MarkColorwayEmitted, MarkColorwayRefused, brand_colorway_artwork }

// Every colourway has its own name and file stem, and the check refuses a duplicated stem.
test fn w_colourways_are_distinct_by_name_and_file() -> Bool {
  brand_colorways_distinct(rows: brand_colorways)
    && !brand_colorways_distinct(rows: concat(brand_colorways, [brand_colorway_stark]))
}

// THE REAL PATH. Salmon & Void is the cut-through seal at mark.svg's authored placement: field and
// features #ffb5b0, body #0a0a0a at x 100..1100, y 200..1000 of the 1200-tenth canvas, eyes at the
// authored centres (35, 48) r 8 in tenths, exported at 1080 px.
test fn w_a_colourway_is_the_cut_through_seal_at_its_authored_placement() -> Bool {
  match brand_colorway_artwork(c: brand_colorway_salmon_and_void) {
    MarkColorwayRefused { reason: _ } => false
    MarkColorwayEmitted { svg } =>
      starts_with(s: svg, prefix: "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1080\" height=\"1080\" viewBox=\"0 0 1200 1200\" role=\"img\" aria-label=\"gunb.ai, Salmon &amp; Void\">")
        && contains(svg, "<rect width=\"1200\" height=\"1200\" fill=\"#ffb5b0\">")
        && contains(svg, "<g fill=\"#0a0a0a\"><rect x=\"100\" y=\"200\" width=\"1000\" height=\"800\" rx=\"300\">")
        && contains(svg, "<g fill=\"#ffb5b0\"><circle cx=\"350\" cy=\"480\" r=\"80\">")
  }
}
