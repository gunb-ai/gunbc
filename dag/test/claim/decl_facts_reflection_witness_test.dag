module test.claim.decl_facts_reflection_witness_test

import v2.std.decl_facts_skeleton {
  decl_facts_nullary_variant_value_identity_gap_note,
  decl_facts_reflection_fixture_witness,
}

data decl_facts_reflection_witness_note: String = "Step-1 prerequisite (#7796): executing evidence for narrow decl_facts skeleton reflection. Positive controls prove outer record-literal variant constructors and DeclarationRef field literals surface structurally via eval_decl_facts Value oracle (host bridge — substrate Node walk cannot read marshaled atoms). Gap controls prove nullary variant VALUE references (ExprVar SingleAuthority, WholeDeclaration) are absent under parse-only marshal. Rust tests in v1-compiler-tests are developer convenience only (compile-only in CI; nextest retired 2026-07-11)."

test fn w_outer_variant_scaffold_constructor_surfaces() -> Bool {
  decl_facts_reflection_fixture_witness(case: "outer_variant_scaffold")
}

test fn w_outer_variant_terminal_constructor_surfaces() -> Bool {
  decl_facts_reflection_fixture_witness(case: "outer_variant_terminal")
}

test fn w_declaration_ref_bind_fields_surface_in_scaffold_specimen() -> Bool {
  decl_facts_reflection_fixture_witness(case: "declaration_ref_bind_fields")
}

test fn w_named_field_declaration_ref_surfaces() -> Bool {
  decl_facts_reflection_fixture_witness(case: "named_field_declaration_ref")
}

test fn w_plain_int_specimen_has_no_coproduct_variant_atoms() -> Bool {
  decl_facts_reflection_fixture_witness(case: "plain_int_no_variant_atoms")
}

test fn w_nullary_variant_value_absent_without_infer_stamping_top_level() -> Bool {
  decl_facts_reflection_fixture_witness(case: "nullary_variant_value_absent_top_level")
}

test fn w_nullary_variant_value_absent_without_infer_stamping_nested() -> Bool {
  decl_facts_reflection_fixture_witness(case: "nullary_variant_value_absent_nested")
}

test fn w_fn_body_param_reference_does_not_gain_variant_atoms() -> Bool {
  decl_facts_reflection_fixture_witness(case: "fn_body_param_no_variant_atoms")
}

test fn w_fn_body_local_bindings_do_not_gain_variant_atoms() -> Bool {
  decl_facts_reflection_fixture_witness(case: "fn_body_local_no_variant_atoms")
}

test fn w_gap_note_names_infer_binding_kind_authority() -> Bool {
  string_contains(
    s: decl_facts_nullary_variant_value_identity_gap_note,
    pattern: "VariantValueBinding",
  ) && string_contains(
    s: decl_facts_nullary_variant_value_identity_gap_note,
    pattern: "lookup_variant_parent_enum",
  )
}
