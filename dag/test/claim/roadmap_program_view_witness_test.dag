module test.claim.roadmap_program_view_witness


data roadmap_program_view_witness_note: String = "SMALL SYNTHETIC BUSINESS WITNESSES for gunbc.roadmap_program_view (operator verdict 2026-08-05): every oracle is PLANTED on a hand-authored fixture graph — never copied from the live roadmap tree (DESIGN section 5). Covers acceptance algebra (receipt moves primary constraint; accepted mid-chain collapses depth), dependency hold (unmet parents block startability), duplicate receipt and duplicate node identity refusal, in-flight overlay, merged-PR and contract non-acceptance, misspelled finish-line/gate refusal, proposed-plane absence, and derived front/constraint facts on the fixture. Live-corpus wiring — that the real roadmap authority projects and every finish line and gate resolves — is ONE separately classified receipt in test.claim.roadmap_program_view_live_corpus_receipt (falsifier substrate long lane), not counted here."

fn fx_ticket(headline: String) -> gunbc.roadmap_status.TicketFields {
  gunbc.roadmap_status.TicketFields {
    headline: headline,
    brief: "fixture brief",
    displaced_cost: "fixture",
    current_state: "fixture",
    first_slice: "fixture",
    red_control: "fixture red control",
    out_of_scope: "fixture",
    handback: "fixture handback",
    updates: [],
    authored_on: "2026-08-02",
    last_verified_on: "2026-08-02",
  }
}

fn fx_node_custom(
  id: String,
  headline: String,
  bound: Bool,
  sized: Bool,
) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: concat("fx_", id) as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: id as gunbc.roadmap_model.RoadmapNodeId,
    line: gunbc.roadmap_status.TicketLine { done: false, ticket: fx_ticket(headline: headline) },
    carriers: [],
    sizing: if sized {
      gunbc.roadmap_model.Sized { intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc", acceptance: ManualAcceptance }
    } else { Unsized },
    execution: if bound {
      gunbc.roadmap_execution_contract.ExecutionContract { validations: [CargoFmtValidation], extra_capabilities: [] }
    } else { ExecutionContractUnspecified },
    owner: "fixture",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn fx_node(id: String, bound: Bool, sized: Bool) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: concat("fx_", id) as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: id as gunbc.roadmap_model.RoadmapNodeId,
    line: gunbc.roadmap_status.TicketLine { done: false, ticket: fx_ticket(headline: concat("Fixture: ", id)) },
    carriers: [],
    sizing: if sized {
      gunbc.roadmap_model.Sized { intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc", acceptance: ManualAcceptance }
    } else { Unsized },
    execution: if bound {
      gunbc.roadmap_execution_contract.ExecutionContract { validations: [CargoFmtValidation], extra_capabilities: [] }
    } else { ExecutionContractUnspecified },
    owner: "fixture",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn fx_pr_node(id: String) -> gunbc.roadmap_model.RoadmapNode {
  gunbc.roadmap_model.RoadmapNode {
    identity: concat("fx_", id) as gunbc.roadmap_model.RoadmapNodeIdentity,
    node: id as gunbc.roadmap_model.RoadmapNodeId,
    line: gunbc.roadmap_status.DerivableLine { prs: [9999], title: concat("Fixture merged-PR node: ", id), description: "merged but never accepted" },
    carriers: [],
    sizing: gunbc.roadmap_model.Sized { intricacy: IntricacyLow, volume: VolumeSmall, repo: "gunbc", acceptance: PrsMerged },
    execution: gunbc.roadmap_execution_contract.ExecutionContract { validations: [CargoFmtValidation], extra_capabilities: [] },
    owner: "fixture",
    signoff: gunbc.roadmap_status.Unsigned,
  }
}

fn fx_edge(child: String, parent: String) -> gunbc.roadmap_model.RoadmapEdge {
  gunbc.roadmap_model.RoadmapEdge { child: child as gunbc.roadmap_model.RoadmapNodeId, parent: parent as gunbc.roadmap_model.RoadmapNodeId }
}

fn fx_nodes() -> List<gunbc.roadmap_model.RoadmapNode> {
  [
    fx_node(id: "fa", bound: true, sized: true),
    fx_node(id: "fb", bound: true, sized: true),
    fx_node(id: "fc", bound: true, sized: true),
    fx_node(id: "fd", bound: false, sized: false),
    fx_pr_node(id: "fe"),
    fx_node(id: "fline", bound: true, sized: true),
  ]
}

fn fx_edges() -> List<gunbc.roadmap_model.RoadmapEdge> {
  [
    fx_edge(child: "fb", parent: "fa"),
    fx_edge(child: "fc", parent: "fb"),
    fx_edge(child: "fline", parent: "fc"),
    fx_edge(child: "fline", parent: "fd"),
    fx_edge(child: "fline", parent: "fe"),
  ]
}

fn fx_lines() -> List<gunbc.v1_deletion_plan.V1FinishLineSpec> {
  [ gunbc.v1_deletion_plan.V1FinishLineSpec {
      line: CompilerFixedPoint,
      name: "Fixture finish line",
      claim: "The fixture program completes.",
      node: "fline" as gunbc.roadmap_model.RoadmapNodeId,
  } ]
}

fn fx_fronts() -> List<gunbc.roadmap_program_view.ConvergenceFrontSpec> {
  [
    gunbc.roadmap_program_view.ConvergenceFrontSpec {
      front: NamespacePDeriveFront,
      name: "Fixture front one",
      purpose: "fixture",
      gates: [ "fc" as gunbc.roadmap_model.RoadmapNodeId ],
    },
    gunbc.roadmap_program_view.ConvergenceFrontSpec {
      front: V2GenerationFront,
      name: "Fixture front two",
      purpose: "fixture",
      gates: [ "fd" as gunbc.roadmap_model.RoadmapNodeId ],
    },
  ]
}

fn fx_receipt_for(n: gunbc.roadmap_model.RoadmapNode) -> gunbc.roadmap_model.RoadmapAcceptanceReceipt {
  gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: n.node,
    criteria_digest: roadmap_criteria_digest(t: fx_ticket(headline: concat("Fixture: ", n.node as String))),
    red_control: gunbc.roadmap_status.RedControlExecuted {
      witness_module: "test.claim.roadmap_program_view_witness" as std.types.NonEmptyStr,
      witness_fn: "fixture" as std.types.NonEmptyStr,
      executed_on: "2026-08-02" as std.types.NonEmptyStr,
    },
    handback: gunbc.roadmap_status.HandbackDelivered {
      first_artifact: "fixture-artifact" as std.types.NonEmptyStr,
      further_artifacts: [],
    },
    accepted_by: "fixture" as std.types.NonEmptyStr,
    accepted_on: "2026-08-02" as std.types.NonEmptyStr,
  }
}

fn fx_view(receipts: List<gunbc.roadmap_model.RoadmapAcceptanceReceipt>, in_flight: List<String>) -> gunbc.roadmap_program_view.V1ProgramViewResult {
  program_view(
    lines: fx_lines(), fronts: fx_fronts(),
    nodes: fx_nodes(), edges: fx_edges(),
    receipts: receipts, in_flight: in_flight,
  )
}

fn fx_derived(receipts: List<gunbc.roadmap_model.RoadmapAcceptanceReceipt>, in_flight: List<String>) -> gunbc.roadmap_program_view.V1DeletionProgramView {
  match fx_view(receipts: receipts, in_flight: in_flight) {
    ProgramViewDerived { view } => view
    ProgramViewRefused { causes: _ } => gunbc.roadmap_program_view.V1DeletionProgramView {
      finish_lines: [], fronts: [],
      remaining: gunbc.roadmap_program_view.RemainingShape {
        sequential_depth: 0 - 1, open_fronts: 0 - 1, startable_now: 0 - 1,
        in_flight: 0 - 1, dependency_held: 0 - 1, contract_held: 0 - 1, unsized: 0 - 1,
      },
      proposed: ProposedCarrierAbsent,
    }
  }
}

fn fx_line_view(receipts: List<gunbc.roadmap_model.RoadmapAcceptanceReceipt>, in_flight: List<String>) -> gunbc.roadmap_program_view.FinishLineView? {
  fx_derived(receipts: receipts, in_flight: in_flight).finish_lines |> first
}

test fn witness_fixture_shape_exact_populations() -> Bool {
  match fx_line_view(receipts: [], in_flight: []) {
    Absent => false
    Present { value: lv } =>
      lv.remaining.sequential_depth == 4
        && lv.remaining.open_fronts == 2
        && lv.remaining.startable_now == 2
        && lv.remaining.in_flight == 0
        && lv.remaining.dependency_held == 3
        && lv.remaining.contract_held == 1
        && lv.remaining.unsized == 1
        && !lv.accepted
        && count(lv.contributing_fronts) == 2
  }
}

test fn witness_red_collapsing_a_link_changes_the_depth() -> Bool {
  let base = fx_line_view(receipts: [], in_flight: [])
  let collapsed = fx_line_view(
    receipts: [ fx_receipt_for(n: fx_node(id: "fa", bound: true, sized: true)) ],
    in_flight: [])
  match base {
    Absent => false
    Present { value: b } => match collapsed {
      Absent => false
      Present { value: c } =>
        b.remaining.sequential_depth == 4
          && c.remaining.sequential_depth == 3
          && b.remaining.sequential_depth != c.remaining.sequential_depth
    }
  }
}

test fn witness_acceptance_moves_the_primary_constraint() -> Bool {
  let base = fx_line_view(receipts: [], in_flight: [])
  let advanced = fx_line_view(
    receipts: [ fx_receipt_for(n: fx_node(id: "fa", bound: true, sized: true)) ],
    in_flight: [])
  match base {
    Absent => false
    Present { value: b } => match advanced {
      Absent => false
      Present { value: a } => match b.constraint {
        Absent => false
        Present { value: bc } => match a.constraint {
          Absent => false
          Present { value: ac } =>
            (bc.subject as String) == "fa"
              && (ac.subject as String) == "fb"
              && match ac.kind {
                ImplementationConstraint => true
                ContractConstraint => false
              }
        }
      }
    }
  }
}

test fn witness_red_misspelled_identities_refuse_with_located_causes() -> Bool {
  let bad_line = program_view(
    lines: [ gunbc.v1_deletion_plan.V1FinishLineSpec {
      line: CompilerFixedPoint, name: "typo", claim: "typo",
      node: "fline-typo" as gunbc.roadmap_model.RoadmapNodeId,
    } ],
    fronts: fx_fronts(), nodes: fx_nodes(), edges: fx_edges(), receipts: [], in_flight: [])
  let bad_gate = program_view(
    lines: fx_lines(),
    fronts: [ gunbc.roadmap_program_view.ConvergenceFrontSpec {
      front: V2GenerationFront, name: "typo front", purpose: "typo",
      gates: [ "fd-typo" as gunbc.roadmap_model.RoadmapNodeId ],
    } ],
    nodes: fx_nodes(), edges: fx_edges(), receipts: [], in_flight: [])
  let line_refused = match bad_line {
    ProgramViewRefused { causes } =>
      count(causes) == 1 && all(causes, c => match c {
        FinishLineNodeUnresolved { line_key, node } =>
          line_key == "compiler-fixed-point" && (node as String) == "fline-typo"
        FrontGateUnresolved { front_key: _, gate: _ } => false
        DuplicateAcceptanceReceipt { node: _ } => false
        DuplicateProgramNodeId { node: _ } => false
      })
    ProgramViewDerived { view: _ } => false
  }
  let gate_refused = match bad_gate {
    ProgramViewRefused { causes } =>
      count(causes) == 1 && all(causes, c => match c {
        FrontGateUnresolved { front_key, gate } =>
          front_key == "v2-generation" && (gate as String) == "fd-typo"
        FinishLineNodeUnresolved { line_key: _, node: _ } => false
        DuplicateAcceptanceReceipt { node: _ } => false
        DuplicateProgramNodeId { node: _ } => false
      })
    ProgramViewDerived { view: _ } => false
  }
  line_refused && gate_refused
}

test fn witness_red_duplicate_receipts_refuse_projection() -> Bool {
  let n = fx_node(id: "fa", bound: true, sized: true)
  let duplicate_receipts = [ fx_receipt_for(n: n), fx_receipt_for(n: n) ]
  match program_view(
    lines: fx_lines(),
    fronts: fx_fronts(),
    nodes: fx_nodes(),
    edges: fx_edges(),
    receipts: duplicate_receipts,
    in_flight: [],
  ) {
    ProgramViewRefused { causes } =>
      count(causes) == 1
        && all(causes, c => match c {
          DuplicateAcceptanceReceipt { node } => (node as String) == "fa"
          FinishLineNodeUnresolved { line_key: _, node: _ } => false
          FrontGateUnresolved { front_key: _, gate: _ } => false
          DuplicateProgramNodeId { node: _ } => false
        })
    ProgramViewDerived { view: _ } => false
  }
}

test fn witness_red_duplicate_node_ids_refuse_projection() -> Bool {
  let conflicting_fb = fx_node_custom(
    id: "fb",
    headline: "Conflicting fixture identity for fb",
    bound: false,
    sized: false,
  )
  match program_view(
    lines: fx_lines(),
    fronts: fx_fronts(),
    nodes: concat(fx_nodes(), [conflicting_fb]),
    edges: fx_edges(),
    receipts: [],
    in_flight: [],
  ) {
    ProgramViewRefused { causes } =>
      count(causes) == 1
        && all(causes, c => match c {
          DuplicateProgramNodeId { node } => (node as String) == "fb"
          FinishLineNodeUnresolved { line_key: _, node: _ } => false
          FrontGateUnresolved { front_key: _, gate: _ } => false
          DuplicateAcceptanceReceipt { node: _ } => false
        })
    ProgramViewDerived { view: _ } => false
  }
}

test fn witness_unmet_parents_block_startability() -> Bool {
  match fx_line_view(receipts: [], in_flight: []) {
    Absent => false
    Present { value: lv } =>
      lv.remaining.dependency_held == 3
        && lv.remaining.startable_now == 2
        && !lv.accepted
  }
}

test fn witness_red_merged_prs_and_contracts_do_not_accept() -> Bool {
  let bogus_receipt = gunbc.roadmap_model.RoadmapAcceptanceReceipt {
    node: "fe" as gunbc.roadmap_model.RoadmapNodeId,
    criteria_digest: roadmap_criteria_digest(t: fx_ticket(headline: "Fixture: fe")),
    red_control: gunbc.roadmap_status.RedControlExecuted {
      witness_module: "test.claim.roadmap_program_view_witness" as std.types.NonEmptyStr,
      witness_fn: "fixture" as std.types.NonEmptyStr,
      executed_on: "2026-08-02" as std.types.NonEmptyStr,
    },
    handback: gunbc.roadmap_status.HandbackDelivered {
      first_artifact: "fixture-artifact" as std.types.NonEmptyStr,
      further_artifacts: [],
    },
    accepted_by: "fixture" as std.types.NonEmptyStr,
    accepted_on: "2026-08-02" as std.types.NonEmptyStr,
  }
  let with_bogus = fx_line_view(receipts: [ bogus_receipt ], in_flight: [])
  match with_bogus {
    Absent => false
    Present { value: lv } =>
      lv.remaining.sequential_depth == 4
        && lv.remaining.startable_now == 2
        && lv.remaining.dependency_held == 3
  }
}

test fn witness_in_flight_is_an_overlay_not_a_state() -> Bool {
  match fx_line_view(receipts: [], in_flight: [ "fa" ]) {
    Absent => false
    Present { value: lv } =>
      lv.remaining.in_flight == 1
        && lv.remaining.startable_now == 1
        && lv.remaining.dependency_held == 3
        && match lv.constraint {
          Absent => false
          Present { value: c } => (c.subject as String) == "fa" && c.in_flight
        }
  }
}

test fn witness_proposed_plane_carries_nothing_by_construction() -> Bool {
  match fx_view(receipts: [], in_flight: []) {
    ProgramViewRefused { causes: _ } => false
    ProgramViewDerived { view } => match view.proposed {
      ProposedCarrierAbsent => true
    }
  }
}

test fn witness_fixture_every_front_contributes_to_some_line() -> Bool {
  let view = fx_derived(receipts: [], in_flight: [])
  all(view.fronts, fv =>
    any(view.finish_lines, lv =>
      lv.contributing_fronts |> any(c => program_front_key(front: c) == fv.key)))
}

fn probe_constraint_iff(lv: gunbc.roadmap_program_view.FinishLineView) -> Bool {
  match lv.constraint {
    Absent => lv.accepted
    Present { value: _ } => !lv.accepted
  }
}

test fn witness_fixture_constraint_present_iff_line_unaccepted() -> Bool {
  let view = fx_derived(receipts: [], in_flight: [])
  all(view.finish_lines, lv => probe_constraint_iff(lv: lv))
}
