module test.claim.orch_cmdsubst_assign_call_spelling_witness

// EXECUTED COVERAGE FOR THE COMMAND-SUBSTITUTION CALL SPELLING, added on the snappy-bat-554
// GO so the kept v2.extdeps.languages.bash_orch_tier2 orch_call_target_model is not caught only
// by goldens that are queued for deletion.
//
// WHY THIS FILE EXISTS. orch_call_target_model was kept because
// orch_cmdsubst_assign_call_target_model consumes it on the command-substitution route, and the
// gateway above it (v2.extdeps.languages.bash_orch_if bash_dirname_ascent_target_model) is live
// production code. Measured, the ONLY claims that went red under a mutation of that spelling were
// the three ci_floor_peak goldens -- and #14467 (queued) deletes src/v2/workflow/ci_floor_peak_emit.dag
// and its claim module. Once that lands, a broken orch_call_target_model would turn nothing red on
// any run route. The pre-existing sibling orch_bash_cmdsubst_assign_row_holds
// (v2.workflow.orchestration_bash) does NOT cover this: it drives the PLAIN
// orch_cmdsubst_assign_target_model, which only wraps "$(" body ")" and never asks for a call
// target. Only the _call variant runs the callee/args spelling through orch_call_target_model.
//
// This file sits under dag/test/claim, the directory with the undisputed executing consumer,
// rather than beside the gateway in src/v2/workflow -- which is exactly why the while-loop
// goldens that share this spelling are not counted as coverage (zesty-tern-692 measured the same
// gap for the path-predicate lowering and ported it for the same reason).
//
// WHAT IS PINNED IS THE OPERATOR'S OWN TEXT: name= $( callee<space>args ), unquoted on the right
// of the assignment, because the _call variant takes the command-substitution authority source
// text as its value -- the same bytes the gateway emits as d=$(dirname "$d") in production. The
// second row pins the callee/args separator, which the first row cannot see.

import v2.workflow.orchestration_bash { orch_emit_bash }
import v2.extdeps.languages.bash { bash_stmt_assign_emitted }
import v2.extdeps.languages.bash_orch_tier2 { orch_cmdsubst_assign_call_target_model }
import v2.std.diagnostic { Accepted, None, Rejected }

test fn cmdsubst_assign_call_spelling_emits_callee_then_args() -> Bool {
  match orch_emit_bash(
    root: bash_stmt_assign_emitted,
    target: orch_cmdsubst_assign_call_target_model(
      name: "dag_pin",
      callee: "converge_read_gunbc_host_pin",
      args_spelling: "\"$checkout\""
    )
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == "dag_pin=$(converge_read_gunbc_host_pin \"$checkout\")")
        && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}

test fn cmdsubst_assign_call_spelling_pins_the_callee_args_separator() -> Bool {
  match orch_emit_bash(
    root: bash_stmt_assign_emitted,
    target: orch_cmdsubst_assign_call_target_model(
      name: "verdict",
      callee: "decide_verdict",
      args_spelling: "\"$dag_pin\" \"$desired_pin\""
    )
  ) {
    Accepted { value: source, diagnostics: dg } =>
      (source.carried == "verdict=$(decide_verdict \"$dag_pin\" \"$desired_pin\")")
        && (dg == None)
    Rejected { diagnostics: _ } => false
  }
}
