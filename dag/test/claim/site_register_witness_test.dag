module test.claim.site_register_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_themes_coherent() -> Bool {
  gunbc.design.theme.themes_coherent(themes: gunbc.design.theme.site_themes, roles: gunbc.design.theme.theme_roles)
}

fn witness_gamer_cyan_refused() -> Bool {
  let gamer_cyan = gunbc.design.material.Material { name: "gamer-cyan", hue: 194, sat_pct: 88, light_pct: 76, area: gunbc.design.material.PointArea }
  let warm_bright = gunbc.design.material.Material { name: "warm-bright", hue: 45, sat_pct: 26, light_pct: 87, area: gunbc.design.material.PointArea }
  let chromatic_dim = gunbc.design.material.Material { name: "chromatic-dim", hue: 226, sat_pct: 58, light_pct: 20, area: gunbc.design.material.PointArea }
  !gunbc.design.material.quiet_envelope(m: gamer_cyan)
    && !gunbc.design.material.chroma_admissible(m: gamer_cyan)
    && gunbc.design.material.chroma_admissible(m: warm_bright)
    && gunbc.design.material.chroma_admissible(m: chromatic_dim)
}

fn witness_saturated_field_refused() -> Bool {
  let neon_field = gunbc.design.material.Material { name: "neon-field", hue: 226, sat_pct: 60, light_pct: 40, area: gunbc.design.material.FieldArea }
  !gunbc.design.material.chroma_admissible(m: neon_field)
}

fn witness_dataviz_seam_open_but_unused() -> Bool {
  let series_cyan = gunbc.design.material.Material { name: "series-cyan", hue: 194, sat_pct: 88, light_pct: 76, area: gunbc.design.material.DataVizArea }
  let same_as_point = gunbc.design.material.Material { name: "gamer-point", hue: 194, sat_pct: 88, light_pct: 76, area: gunbc.design.material.PointArea }
  gunbc.design.material.chroma_admissible(m: series_cyan)
    && !gunbc.design.material.chroma_admissible(m: same_as_point)
    && all(gunbc.design.theme.theme_roles, r => !(gunbc.design.material.area_key(area: gunbc.design.theme.role_area(r: r)) == "dataviz"))
    && all(gunbc.design.theme.site_themes, t => all(t.assignments, a => !(gunbc.design.material.area_key(area: a.material.area) == "dataviz")))
}

fn brass_paints_text_somewhere(rules: List<gunbc.design.material.BuildRule>) -> Bool {
  fold(rules, init: false, f: (acc, r) => acc || match r {
    gunbc.design.material.StaticRule { selector: _, decls } =>
      fold(decls, init: false, f: (inner, d) => inner || (css_property_wire(p: d.prop) == "color" && d.value == gunbc.design.theme.role_var(r: gunbc.design.theme.FocusRole)))
    gunbc.design.material.ResponseRule { subject: _, shape: _, trigger: _, transition_props: _, timing: _, base_decls, response_decls } =>
      fold(concat(base_decls, response_decls), init: false, f: (inner, d) => inner || (css_property_wire(p: d.prop) == "color" && d.value == gunbc.design.theme.role_var(r: gunbc.design.theme.FocusRole)))
  })
}

fn witness_brass_never_paints_text() -> Bool {
  !brass_paints_text_somewhere(rules: gunbc.site.moodboard.moodboard_rules())
    && !brass_paints_text_somewhere(rules: gunbc.roadmap_style.roadmap_rules())
}

fn witness_focus_boundary_differ_by_area() -> Bool {
  !(gunbc.design.material.area_key(area: gunbc.design.theme.role_area(r: gunbc.design.theme.FocusRole)) == gunbc.design.material.area_key(area: gunbc.design.theme.role_area(r: gunbc.design.theme.BoundaryRole)))
}

fn witness_theme_gap_is_located() -> Bool {
  let partial = gunbc.design.theme.Theme { name: "partial", scheme: "dark", assignments: [
    gunbc.design.theme.assign(role: gunbc.design.theme.CanvasRole, material: gunbc.design.theme.night_canvas),
  ] }
  gunbc.design.theme.theme_gaps(t: partial, roles: gunbc.design.theme.theme_roles).length() == theme_roles.length() - 1
    && gunbc.design.theme.theme_gaps(t: gunbc.design.theme.night_theme, roles: gunbc.design.theme.theme_roles).length() == 0
    && gunbc.design.theme.theme_gaps(t: gunbc.design.theme.day_theme, roles: gunbc.design.theme.theme_roles).length() == 0
}

fn witness_role_area_mismatch_refused() -> Bool {
  let field_on_figure = gunbc.design.theme.Theme { name: "mismatched", scheme: "dark", assignments: [
    gunbc.design.theme.assign(role: gunbc.design.theme.FigureRole, material: gunbc.design.theme.night_canvas),
  ] }
  !gunbc.design.theme.theme_area_coherent(t: field_on_figure)
    && gunbc.design.theme.theme_area_coherent(t: gunbc.design.theme.night_theme)
    && gunbc.design.theme.theme_area_coherent(t: gunbc.design.theme.day_theme)
}

fn witness_theme_contrast_holds() -> Bool {
  gunbc.design.theme.theme_contrast_ok(t: gunbc.design.theme.night_theme) && gunbc.design.theme.theme_contrast_ok(t: gunbc.design.theme.day_theme)
}

fn witness_moodboard_coverage_complete() -> Bool {
  gunbc.design.interaction.coverage_complete(elements: gunbc.site.moodboard.moodboard_elements, rows: gunbc.site.moodboard.moodboard_behaviors)
}

fn witness_dead_hover_is_located_gap() -> Bool {
  let elements = [ gunbc.design.interaction.InteractiveElement { element: gunbc.design.interaction.HashElement, verbs: [gunbc.design.interaction.Enter] } ]
  let gaps = gunbc.design.interaction.coverage_gaps(elements: elements, rows: gunbc.site.moodboard.moodboard_behaviors)
  gaps.length() == 1
    && all(gaps, g => gunbc.design.interaction.element_id_eq(a: g.element, b: gunbc.design.interaction.HashElement) && gunbc.design.interaction.verb_key(v: g.verb) == "enter")
}

fn witness_unrealized_behavior_is_counted() -> Bool {
  let ghost = gunbc.design.interaction.BehaviorRow { element: gunbc.design.interaction.StarElement, verb: gunbc.design.interaction.Enter, response: gunbc.design.interaction.Receipt, timing: gunbc.design.material.respond_fast }
  gunbc.site.moodboard.unrealized_behaviors(rows: [ghost]).length() == 1
    && gunbc.site.moodboard.unrealized_behaviors(rows: gunbc.site.moodboard.moodboard_behaviors).length() == 0
}

fn witness_mark_on_grid_and_confluent() -> Bool {
  gunbc.site.mark.mark_nodes_on_grid(nodes: gunbc.site.mark.mark_nodes, unit: gunbc.site.mark.mark_grid_unit)
    && gunbc.site.mark.all_forks_rejoin(nodes: gunbc.site.mark.mark_nodes, edges: gunbc.site.mark.mark_edges, source: "a")
}

fn witness_broken_fork_refutes_confluence() -> Bool {
  let severed = [
    gunbc.site.mark.MarkEdge { from_key: "a", to_key: "b" },
    gunbc.site.mark.MarkEdge { from_key: "a", to_key: "c" },
    gunbc.site.mark.MarkEdge { from_key: "c", to_key: "d" },
  ]
  !gunbc.site.mark.all_forks_rejoin(nodes: gunbc.site.mark.mark_nodes, edges: severed, source: "a")
}

fn mark_svg_at(depth: Int) -> String {
  match extdeps.languages.html.try_serialize_html_source(node: gunbc.site.mark.render_mark(depth: depth)) {
    extdeps.languages.html.EmitOk { html: h } => h
    extdeps.languages.html.EmitRejected { reason: _ } => ""
  }
}

fn witness_mark_lod_monotone() -> Bool {
  let d0 = mark_svg_at(depth: 0)
  let d1 = mark_svg_at(depth: 1)
  let d3 = mark_svg_at(depth: 3)
  !string_contains(s: d0, pattern: "<line")
    && string_contains(s: d1, pattern: "<line")
    && !string_contains(s: d1, pattern: "r=\"9\"")
    && string_contains(s: d3, pattern: "r=\"9\"")
}

fn witness_brightest_star_is_std() -> Bool {
  gunbc.site.constellation.brightest_is_authority(stars: gunbc.site.constellation.layer_stars, authority_key: "std")
    && !gunbc.site.constellation.brightest_is_authority(stars: gunbc.site.constellation.layer_stars, authority_key: "workflow")
}

fn witness_moodboard_emits_with_structure() -> Bool {
  let h = gunbc.site.moodboard.moodboard_html()
  starts_with(s: h, prefix: "<!DOCTYPE html>")
    && string_contains(s: h, pattern: "class=\"constellation\"")
    && string_contains(s: h, pattern: ".hero:has(.star-std:hover) .legend-std")
    && string_contains(s: h, pattern: ".star:focus-visible")
    && string_contains(s: h, pattern: "@media (prefers-reduced-motion: reduce)")
    && string_contains(s: h, pattern: "thesis+themes digest")
    && !string_contains(s: h, pattern: "EMIT REJECTED")
}

fn witness_two_themes_one_model() -> Bool {
  let h = gunbc.site.moodboard.moodboard_html()
  string_contains(s: h, pattern: ":root { --canvas:")
    && string_contains(s: h, pattern: ":root[data-theme=\"day\"]")
    && string_contains(s: h, pattern: "@media (prefers-color-scheme: light) { :root:not([data-theme])")
    && string_contains(s: h, pattern: "color-scheme: dark")
    && string_contains(s: h, pattern: "color-scheme: light")
    && string_contains(s: h, pattern: ".star { fill: var(--figure)")
    && string_contains(s: h, pattern: ".mark-sink { fill: var(--focus) }")
}

fn witness_gamer_cyan_absent_from_page() -> Bool {
  !string_contains(s: gunbc.site.moodboard.moodboard_html(), pattern: "hsl(194")
}

fn witness_still_until_touched_in_css() -> Bool {
  let h = gunbc.site.moodboard.moodboard_html()
  string_contains(s: h, pattern: "transition: fill 90ms ease-out")
    && !string_contains(s: h, pattern: "@keyframes")
    && !string_contains(s: h, pattern: "animation:")
}

fn witness_reframe_derived_for_free() -> Bool {
  let h = gunbc.site.moodboard.moodboard_html()
  string_contains(s: h, pattern: "html.reframing body { transition: background-color 320ms ease, color 320ms ease }")
    && string_contains(s: h, pattern: "html.reframing .star { transition: fill 320ms ease }")
    && string_contains(s: h, pattern: "html.reframing .mark-sink")
}

fn witness_reframe_reduced_motion_guarded() -> Bool {
  let css = gunbc.design.theme_transition.reframe_css(rules: gunbc.site.moodboard.moodboard_rules())
  string_contains(s: css, pattern: "@media (prefers-reduced-motion: reduce)")
    && string_contains(s: css, pattern: "html.reframing body { transition: none }")
}

fn witness_unthemed_color_census_empty() -> Bool {
  gunbc.design.theme_transition.unthemed_color_decls(rules: gunbc.site.moodboard.moodboard_rules()).length() == 0
}

fn witness_unthemed_color_is_counted() -> Bool {
  let rogue = gunbc.design.material.StaticRule { selector: ClassSelector { name: "rogue" }, decls: [ gunbc.design.material.decl(prop: Color, value: "hsl(194 88% 76%)") ] }
  let census = gunbc.design.theme_transition.unthemed_color_decls(rules: [rogue])
  census.length() == 1
    && all(census, c => c.selector == ".rogue" && c.prop == "color")
}

fn witness_watcher_shares_the_token_clock() -> Bool {
  let js = gunbc.site.moodboard.moodboard_nav_js()
  string_contains(s: js, pattern: "matchMedia('(prefers-color-scheme: light)')")
    && string_contains(s: js, pattern: "classList.add('reframing')")
    && string_contains(s: js, pattern: "classList.remove('reframing')")
    && string_contains(s: js, pattern: "320")
}

fn witness_watcher_owns_applied_theme() -> Bool {
  let js = gunbc.site.moodboard.moodboard_nav_js()
  string_contains(s: js, pattern: "setAttribute('data-theme', mql.matches ? 'day' : 'night')")
    && string_contains(s: js, pattern: "applyTheme();")
}

test fn site_register_keystone_holds() -> Bool {
  gunbc.site.moodboard.moodboard_preconditions_hold()
    && witness_themes_coherent()
    && witness_gamer_cyan_refused()
    && witness_saturated_field_refused()
    && witness_dataviz_seam_open_but_unused()
    && witness_brass_never_paints_text()
    && witness_focus_boundary_differ_by_area()
    && witness_theme_gap_is_located()
    && witness_role_area_mismatch_refused()
    && witness_theme_contrast_holds()
    && witness_moodboard_coverage_complete()
    && witness_dead_hover_is_located_gap()
    && witness_unrealized_behavior_is_counted()
    && witness_mark_on_grid_and_confluent()
    && witness_broken_fork_refutes_confluence()
    && witness_mark_lod_monotone()
    && witness_brightest_star_is_std()
    && witness_moodboard_emits_with_structure()
    && witness_two_themes_one_model()
    && witness_gamer_cyan_absent_from_page()
    && witness_still_until_touched_in_css()
    && witness_reframe_derived_for_free()
    && witness_reframe_reduced_motion_guarded()
    && witness_unthemed_color_census_empty()
    && witness_unthemed_color_is_counted()
    && witness_watcher_shares_the_token_clock()
    && witness_watcher_owns_applied_theme()
}
