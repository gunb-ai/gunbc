module test.claim.claude_sdk_parser_drop_witness

import std.types { String, Bool, List }
import extdeps.llm.claude_agent_sdk_stream {
  claude_sdk_control_response_parser_drop_holds,
  list_contains_string,
  parser_drop_fixture_subprocess_raw_types,
  parser_drop_fixture_sdk_parsed_types,
  parser_drop_red_control_parsed_types,
  claude_stream_event_type_control_response,
}
import extdeps.filesystem.filesystem_io
import extdeps.languages.json.parse {
  parse_json,
  json_object_unique_member,
  JsonMemberFound,
  JsonMemberAbsent,
  JsonMemberDuplicated,
  JsonMemberNotAnObject,
}
import extdeps.languages.json.emit { JsonValue, JsonString, JsonArray }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data claude_sdk_parser_drop_witness_note: String = "Audit section 4.1 confirmed BY EXECUTION on 2026-08-06: control_response is present in the Claude subprocess stream-json captured beneath @anthropic-ai/claude-agent-sdk 0.3.220 query(), and absent from the SDK parsed message surface. This is independent of subscription entitlement and does not require an authenticated host. The wet receipt lives at docs/probes/claude_paired_entitlement_probe/claude_sdk_parser_drop_receipt.json; these rows execute the derivation against that receipt and against the discriminating RED control."

data claude_sdk_parser_drop_receipt_path: String = "docs/probes/claude_paired_entitlement_probe/claude_sdk_parser_drop_receipt.json"

fn json_string_list_contains(items: JsonValue, needle: String) -> Bool {
  match items {
    JsonArray { elements: elems } =>
      fold(elems, init: false, f: fn(found, head) {
        if found {
          true
        } else {
          match head {
            JsonString { value: s } => s == needle
            _ => false
          }
        }
      })
    _ => false
  }
}

fn receipt_member_array(v: JsonValue, key: String) -> JsonValue {
  match json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value: found } => found
    JsonMemberAbsent => JsonArray { elements: [] }
    JsonMemberDuplicated { count: _ } => JsonArray { elements: [] }
    JsonMemberNotAnObject => JsonArray { elements: [] }
  }
}

fn receipt_decode_parser_drop_holds(text: String) -> Bool {
  match parse_json(s: text) {
    Absent => false
    Present { value: root } =>
      let comparison = receipt_member_array(v: root, key: "comparison")
      let dropped = receipt_member_array(v: comparison, key: "event_types_dropped_by_sdk_parser")
      json_string_list_contains(items: dropped, needle: claude_stream_event_type_control_response)
  }
}

test fn witness_control_response_parser_drop_fixture_holds() -> Bool {
  claude_sdk_control_response_parser_drop_holds(
    subprocess_raw_types: parser_drop_fixture_subprocess_raw_types,
    sdk_parsed_types: parser_drop_fixture_sdk_parsed_types
  )
}

test fn RED_parsed_surface_including_control_response_does_not_hold() -> Bool {
  !claude_sdk_control_response_parser_drop_holds(
    subprocess_raw_types: parser_drop_fixture_subprocess_raw_types,
    sdk_parsed_types: parser_drop_red_control_parsed_types
  )
}

test fn witness_wet_receipt_control_response_parser_drop_holds() -> Bool {
  let result = filesystem_read(path: claude_sdk_parser_drop_receipt_path)
  receipt_decode_parser_drop_holds(text: result.content)
}
