module test.claim.data_reference_kind_from_resolved_node

import std.logic { Bool }
import std.types { String }
import std.measure { Gigabyte }
import extdeps.vendor.gigabyte { gigabyte }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// A DATA REFERENCE IS CLASSIFIED BY THE DECLARATION IT RESOLVES TO, NOT BY A SAME-SPELLED ITEM
// ELSEWHERE. `gigabyte` here is extdeps.vendor.gigabyte's `data`, imported by name; std.measure,
// also in scope, declares `fn gigabyte`. The evaluator used to take the item kind from a bare-name
// registry projection that keeps one homonym in hash-seed order, so on some processes this reference
// evaluated as a function and the field read refused ("cannot access field 'legal_name' on Fn").
// eval_var now takes the kind from the resolved node. This is the production homonym, not a synthetic one;
// the isolated four-module geometry is stern-bear-703's fixture on gunbc#11062.
//
// A PROBABILISTIC REGRESSION CONTROL, AND NEVER THIS CLASS'S COVERAGE. A reintroduced fork reds this
// only on processes whose hash seed puts the `fn` last. At the rate the N-run comparison on
// gunbc#11065 measured, one run MISSES a regression more often than it catches it, and repeating the
// assertion in-process cannot help because the seed is per process. Over successive pushes a
// reintroduction's survival decays geometrically: caught eventually, not reliably at the grain that
// matters, which is one PR. If asked whether this class is caught, the answer is that N-run
// comparison -- a control binary built from the base against the repaired binary, across
// per-process hash seeds, on this specimen -- not a green run of this witness.
//
// The class's rung, ceiling and next-rung trigger live in its ledger row,
// gunbc.recurring_failure_mode surface_shorthand_preempts_resolved_identity, not here.
test fn a_data_reference_is_classified_by_the_declaration_it_resolves_to() -> Bool {
  (gigabyte.legal_name as String) == "GIGA-BYTE Technology Co., Ltd."
}
