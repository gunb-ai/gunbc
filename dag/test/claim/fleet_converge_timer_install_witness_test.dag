module test.claim.fleet_converge_timer_install_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

// Timer cadence retired (sleek-heron-218): every enrolled host routes to TimerRetired;
// only names outside the fleet applicability join stay on TimerOutsideFleet.
test fn witness_timer_route_is_total_and_discriminates() -> Bool {
  match fleet_timer_install_route(host: "srv1") {
    TimerRetired { host: h } => h == "srv1"
    _ => false
  }
    && match fleet_timer_install_route(host: "srv2") {
      TimerRetired { host: h } => h == "srv2"
      _ => false
    }
    && match fleet_timer_install_route(host: "srv3") {
      TimerRetired { host: h } => h == "srv3"
      _ => false
    }
    && match fleet_timer_install_route(host: "srv4") {
      TimerRetired { host: h } => h == "srv4"
      _ => false
    }
    && match fleet_timer_install_route(host: "srv5") {
      TimerRetired { host: h } => h == "srv5"
      _ => false
    }
    && match fleet_timer_install_route(host: "no-such-host") {
      TimerOutsideFleet { host: _ } => true
      _ => false
    }
}

// The install plan derives from the ONE timer authority: staged and installed paths
// carry the authority's unit names, the enable step names the timer unit, and the LAST
// step is the independent post-effect readback (is-enabled), not an exit-code trust.
test fn witness_timer_install_plan_derives_from_authority_and_ends_in_readback() -> Bool {
  let cmds = fleet_timer_install_commands()
  cmds.length() == 5
    && match cmds.first() {
      Present { value: head } =>
        match head {
          ArgvCommand { argv: argv } =>
            string_contains(s: join(argv, " "), pattern: fleet_converge_service_unit_name)
              && string_contains(s: join(argv, " "), pattern: "/etc/systemd/system/")
        }
      Absent => false
    }
    && match last_command(cmds: cmds) {
      Present { value: readback } =>
        match readback {
          ArgvCommand { argv: argv } => join(argv, " ") == join(["systemctl is-enabled ", fleet_converge_timer_unit_name], "")
        }
      Absent => false
    }
}

fn last_command(cmds: List<extdeps.exec.command.ArgvCommand>) -> extdeps.exec.command.ArgvCommand? {
  fold(cmds, init: none, f: (acc, c) => Present { value: c })
}
