module test.claim.merge_admission_actuator_witness


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

data scenario_base_b0: extdeps.git.object_store.GitObjectId = merge_admission_witness_git_tree(label: "merge-admission-witness-base-b0")
data scenario_base_b1: extdeps.git.object_store.GitObjectId = merge_admission_witness_git_tree(label: "merge-admission-witness-base-b1")
data scenario_roster_r0: gunbc.merge_admission.GateRosterHash = merge_admission_witness_gate_roster(label: "merge-admission-witness-roster-r0")
data scenario_roster_r1: gunbc.merge_admission.GateRosterHash = merge_admission_witness_gate_roster(label: "merge-admission-witness-roster-r1")
data scenario_pr_x_receipt: gunbc.merge_admission.MergeAdmissionReceipt = gunbc.merge_admission.MergeAdmissionReceipt {
  pr_number: Present { value: 5933 },
  head_sha: "abc1234def5678901234567890abcd1234567890",
  base_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b0,
  gate_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r0,
  conclusion: Success,
}

test fn enforcement_policy_is_keyed_receipt() -> Bool {
  merge_admission_enforcement_policy == KeyedReceipt
}

test fn enforcement_denies_stale_base_verdict() -> Bool {
  match classify_merge_admission_verdict(
    receipt: test.claim.merge_admission_actuator_witness.scenario_pr_x_receipt,
    merge_target_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b1,
    current_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r0,
  ) {
    MergeDeniedStaleBase => true
    MergeAdmitted => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
  }
}

test fn enforcement_denies_stale_roster_verdict() -> Bool {
  match classify_merge_admission_verdict(
    receipt: test.claim.merge_admission_actuator_witness.scenario_pr_x_receipt,
    merge_target_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b0,
    current_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r1,
  ) {
    MergeDeniedStaleRoster => true
    MergeAdmitted => false
    MergeDeniedStaleBase => false
    MergeDeniedNotSuccess => false
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
  }
}

