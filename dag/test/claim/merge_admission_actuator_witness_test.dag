  match classify_merge_admission_verdict(
    receipt: test.claim.merge_admission_actuator_witness.scenario_pr_x_receipt,
    merge_target_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b0,
    current_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r0,
  ) {
    MergeAdmitted => true
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
  }
}

test fn enforcement_denies_skipped_fresh_receipt() -> Bool {
  let receipt = gunbc.merge_admission.MergeAdmissionReceipt {
    pr_number: Present { value: 5933 },
    head_sha: test.claim.merge_admission_actuator_witness.scenario_pr_x_receipt.head_sha,
    base_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b0,
    gate_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r0,
    conclusion: Skipped,
  }
  match classify_merge_admission_verdict(
    receipt: receipt,
    merge_target_tree_hash: test.claim.merge_admission_actuator_witness.scenario_base_b0,
    current_roster_hash: test.claim.merge_admission_actuator_witness.scenario_roster_r0,
  ) {
    MergeDeniedNotSuccess => true
    MergeDeniedWrongAttempt => false
    MergeDeniedSubjectMismatch => false
    MergeAdmitted => false
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
  }
}

