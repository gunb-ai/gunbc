module test.claim.realization_witness


data live_tree_disposition: LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn witness_unknown_independence_never_reorders() -> Bool {
  let indep = std.realization.Unknown
  match indep {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

fn witness_read_read_independent() -> Bool {
  std.realization.independence_from_effect_shapes(left: std.effects.ReadEffect, right: std.effects.ReadEffect) == Independent
}

fn witness_create_unknown_not_independent() -> Bool {
  match std.realization.independence_from_effect_shapes(
    left: std.effects.CreateEffect { cause: std.effects.PostAlways },
    right: std.effects.ReadEffect
  ) {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

fn witness_upsert_same_key_dependent() -> Bool {
  std.realization.independence_from_effect_shapes(
    left: std.effects.UpsertEffect { key_source: PathParam { param: "id" } },
    right: std.effects.UpsertEffect { key_source: PathParam { param: "id" } }
  ) == Dependent
}

fn witness_upsert_different_keys_independent() -> Bool {
  std.realization.independence_from_effect_shapes(
    left: std.effects.UpsertEffect { key_source: InputField { field: "a" } },
    right: std.effects.UpsertEffect { key_source: InputField { field: "b" } }
  ) == Independent
}

test fn realization_witnesses() -> Bool {
  witness_unknown_independence_never_reorders()
    && witness_read_read_independent()
    && witness_create_unknown_not_independent()
    && witness_upsert_same_key_dependent()
    && witness_upsert_different_keys_independent()
}
