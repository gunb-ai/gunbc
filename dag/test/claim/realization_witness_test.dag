module test.claim.realization_witness

data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

test fn witness_unknown_independence_never_reorders() -> Bool {
  let indep = std.realization.Unknown
  match indep {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

test fn witness_read_read_independent() -> Bool {
  independence_from_effect_shapes(left: ReadEffect, right: ReadEffect) == Independent
}

test fn witness_create_unknown_not_independent() -> Bool {
  match independence_from_effect_shapes(
    left: std.effects.CreateEffect { cause: PostAlways },
    right: ReadEffect
  ) {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

test fn witness_upsert_same_key_dependent() -> Bool {
  independence_from_effect_shapes(
    left: std.effects.UpsertEffect { key_source: std.effects.PathParam { param: "id" } },
    right: std.effects.UpsertEffect { key_source: std.effects.PathParam { param: "id" } }
  ) == Dependent
}

test fn witness_upsert_different_keys_independent() -> Bool {
  independence_from_effect_shapes(
    left: std.effects.UpsertEffect { key_source: std.effects.InputField { field: "a" } },
    right: std.effects.UpsertEffect { key_source: std.effects.InputField { field: "b" } }
  ) == Independent
}

