module test.claim.stage0_rust_lifecycle_totality_witness

import gunbc.stage0_rust_lifecycle_totality {
  LifecycleTotalityDerived,
  exact_unclassified_tracked_paths,
  lifecycle_decision_complete,
  lifecycle_discovery_complete,
  lifecycle_totality_receipt,
  lifecycle_totality_witness_observation,
  stage0_rust_lifecycle_totality_note,
  stage0_rust_lifecycle_totality_underived_axes,
  RetirementTrigger
}
import v2.std.algebra { length }

test fn lifecycle_totality_note_cites_identity_join() -> Bool {
  string_contains(s: stage0_rust_lifecycle_totality_note, pattern: "identity join")
    && string_contains(s: stage0_rust_lifecycle_totality_note, pattern: "C1 carrier")
}

test fn lifecycle_totality_exact_unclassified_preserves_identity() -> Bool {
  exact_unclassified_tracked_paths(
    tracked_paths: ["a.rs", "classified.rs", "b.rs"],
    classified_paths: ["classified.rs"]
  ) == ["a.rs", "b.rs"]
}

test fn lifecycle_totality_red_control_reports_exact_unclassified_path() -> Bool {
  let observation = lifecycle_totality_witness_observation(extra_paths: ["orphan.rs"])
  match lifecycle_totality_receipt(observation: observation) {
    LifecycleTotalityDerived {
      tracked_paths: tracked_paths,
      generated_paths: generated_paths,
      maintenance_disposition_paths: maintenance_disposition_paths,
      unclassified_paths: paths,
      stale_disposition_paths: stale_disposition_paths,
      duplicate_disposition_paths: duplicate_disposition_paths,
      role_without_disposition_paths: role_without_disposition_paths,
      ill_formed_maintenance_disposition_paths: ill_formed_maintenance_disposition_paths
    } =>
      paths == ["orphan.rs"]
        && !lifecycle_decision_complete(
          receipt: lifecycle_totality_receipt(observation: observation)
        )
    _ => false
  }
}

test fn lifecycle_totality_discovery_and_decision_are_separate() -> Bool {
  let receipt = lifecycle_totality_receipt(
    observation: lifecycle_totality_witness_observation(extra_paths: ["orphan.rs"])
  )
  lifecycle_discovery_complete(receipt: receipt)
    && !lifecycle_decision_complete(receipt: receipt)
}

test fn lifecycle_totality_counts_retirement_trigger_as_underived_axis() -> Bool {
  stage0_rust_lifecycle_totality_underived_axes == [RetirementTrigger]
    && length(xs: stage0_rust_lifecycle_totality_underived_axes) == 1
    && string_contains(s: stage0_rust_lifecycle_totality_note, pattern: "stage0_rust_lifecycle_totality_underived_axes")
}

test fn lifecycle_totality_positive_control_decision_complete() -> Bool {
  lifecycle_decision_complete(
    receipt: lifecycle_totality_receipt(
      observation: lifecycle_totality_witness_observation(extra_paths: [])
    )
  )
}
