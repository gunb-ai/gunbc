module test.claim.ci_cost_arc_closeout_receipt_witness

import std.types { Bool, Int }
import std.measure { millisecond_count }
import gunbc.ci_cost_arc_closeout_receipt {
  harvested_capture_wall,
  harvested_selected_entry_groups,
  harvested_total_entry_groups,
  harvested_resolve_wall,
  harvested_eval_wall,
  cold_admission_baseline_wall,
  settle_7522_net_wall_note,
  settle_7671_native_rate_note,
  settle_7534_warm_hit_note,
  terminal_lane_dispositions_note,
}

data ci_cost_arc_closeout_witness_note: String = "Pins the harvested numeric identity of the closeout receipt and that the three settle notes refuse to claim net wall, fleet native=3, or warm-hit Delivered. Duration accessors are Millisecond (unit-modeling wall — review 47900). RED controls flip a measured field or strip an OPEN marker."

test fn witness_harvested_capture_is_run_30863019228() -> Bool {
  millisecond_count(m: harvested_capture_wall()) == 110820
}

test fn witness_selection_ratio_identity() -> Bool {
  harvested_selected_entry_groups() == 297
    && harvested_total_entry_groups() == 916
}

test fn witness_resolve_dominates_eval() -> Bool {
  millisecond_count(m: harvested_resolve_wall()) > millisecond_count(m: harvested_eval_wall()) * 5
}

test fn witness_cold_baseline_is_197130() -> Bool {
  millisecond_count(m: cold_admission_baseline_wall()) == 197130
}

test fn witness_7522_net_remains_open() -> Bool {
  let n = settle_7522_net_wall_note
  string_contains(s: n, pattern: "NET vs 197.13s = OPEN")
    && string_contains(s: n, pattern: "110820")
    && !string_contains(s: n, pattern: "probable")
}

test fn witness_7671_not_described_as_completed_native_speedup() -> Bool {
  let n = settle_7671_native_rate_note
  string_contains(s: n, pattern: "NOT bankable as native=3")
}

test fn witness_7534_warm_hit_still_partial() -> Bool {
  let n = settle_7534_warm_hit_note
  string_contains(s: n, pattern: "PartiallyDelivered")
    && string_contains(s: n, pattern: "#7728")
}

test fn witness_terminal_table_names_assembly_as_dominant_open() -> Bool {
  string_contains(s: terminal_lane_dispositions_note, pattern: "per-entry assembly")
}

test fn red_capture_wall_must_not_silently_drift() -> Bool {
  !(millisecond_count(m: harvested_capture_wall()) == 0)
}
