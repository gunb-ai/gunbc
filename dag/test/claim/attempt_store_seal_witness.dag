data session_path_minter_source: String = "module probe_session_store_path_minter\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(i: HostDashboardInstance) -> NonEmptyStr {\n  match session_attempt_slots_store(instance: i, root: \"/tmp/forged-session-attempts\") {\n    SessionAttemptSlotsStoreReady { store: _ } => \"minted\"\n    SessionAttemptSlotsStoreUnready { detail: _ } => \"unready\"\n  }\n}\n"

