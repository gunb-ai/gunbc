// THE THIRD ROUTE, ONE EXPECTING-RED PROBE PER STORE, as test.claim.slot_store_seal_witness
// a_claim_store_over_a_chosen_instance_root_is_accepted_today is for the claim store: a foreign module builds a
// HostDashboardInstance over a root it chose (gunbc.roadmap.roadmap_dashboard_instance isolated_dashboard_instance is
// public and takes any path), mints the store from it and hands it to its consumer -- ACCEPTED, with no blocking
// diagnostic beyond the same closure and no seal violation. Each seal fixes WHERE in an instance its store lives, not
// WHICH instance. Route 3 of gunbc.recurring_failure_mode a_slot_store_is_built_over_a_literal_path_by_any_module;
// each probe goes red, and is then inverted into that wall's RED, in the change that seals or admits the instance.

test fn a_session_store_over_a_chosen_instance_root_is_accepted_today() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: session_instance_route_source, safe: instance_route_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: session_instance_route_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 0 }),
  ])
}

test fn a_credential_store_over_a_chosen_instance_root_is_accepted_today() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: credential_instance_route_source, safe: instance_route_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: credential_instance_route_source, subject: "CredentialAcquisitionStore"), holds: fn(n) { n == 0 }),
