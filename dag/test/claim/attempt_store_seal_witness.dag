    blocking_delta(hostile: credential_lawful_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: credential_lawful_source, subject: "CredentialAcquisitionStore"), holds: fn(n) { n == 0 }),
