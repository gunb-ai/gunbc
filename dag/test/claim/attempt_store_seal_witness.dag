module test.claim.attempt_store_seal_witness

import std.types { Bool, Int, String }
import gunbc.compile_census_probe { blocking_subject_census, census_delta_verdict, census_verdict, census_verdict_all, total_blocking_census, census_exit, CensusVerdict }
import gunbc.compile_diagnostic_census { CompileDiagnosticCensus }
import std.process { ProcessExit }

// THE ATTEMPT STORES OF THE attempt_lifecycle FAMILY ARE MINTED FROM THEIR DECLARATIONS AND CANNOT BE SPELLED OR
// MINTED FROM A PATH, as the claim store is (test.claim.slot_store_seal_witness).
// gunbc.roadmap.roadmap_session_attempt_slots_root SessionAttemptSlotsStore, gunbc.dispatch_credential_acquisition
// CredentialAcquisitionStore and gunbc.compute.compute_attempt_slots_root ComputeSeatStore are sole_constructor, each
// built in one place from the instance (and, for a seat, the typed seat) alone, the root derived there from its own
// declaration. For each store, every RED hands the compiler a module outside the defining file and asserts the
// refusal on the real acceptance path:
//   * a forged store literal, a forged cast, and a store built around a LITERAL PATH (file_slot_store_over over a
//     root the fixture wrote) -- each EXACTLY ONE SoleConstructorViolation on the store's own subject;
//   * the store's mint handed a path, another family member's handle returned where this store is required, and a
//     root read out of the store -- each at least one blocking diagnostic beyond a baseline importing the same
//     closure (gunbc.compile_diagnostic_census cancels the shared closure).
// The GREEN per store is the lawful route, the store's own mint into a consumer, which adds no blocking diagnostic
// and draws no seal violation on the store or on SlotStore. NOT witnessed, because it is not expressible: a store
// minted for instance A refused where B is required (one type for both). Seal residuals: variant construction
// (test.claim.sole_constructor_completeness_audit_probe f13) and parameter defaults (f19), so no store record is
// generic or a variant arm.

fn seal_violations(source: String, subject: String) -> CompileDiagnosticCensus {
  blocking_subject_census(source: source, wanted_class: "SoleConstructorViolation", wanted_subject: subject)
}

fn blocking_delta(hostile: String, safe: String, holds: fn(Int) -> Bool) -> CensusVerdict {
  census_delta_verdict(red: total_blocking_census(source: hostile), control: total_blocking_census(source: safe), holds: holds)
}

data closure_baseline_source: String = "module probe_attempt_store_baseline\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(n: NonEmptyStr) -> NonEmptyStr {{\n  n\n}}\n"

