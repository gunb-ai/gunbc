test fn a_forged_session_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_literal_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_session_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_cast_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn a_session_store_minted_from_another_readiness_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_foreign_readiness_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn another_family_store_is_not_a_session_store() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_other_store_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn session_store_holders_have_no_route_to_a_root() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_root_out_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn the_lawful_session_store_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: session_lawful_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: session_lawful_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: session_lawful_source, subject: "SlotStore"), holds: fn(n) { n == 0 }),
  ])
}

