data compute_lawful_source: String = "module probe_compute_store_lawful\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store_over }\nimport gunbc.filesystem_interface { local_filesystem }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(i: HostDashboardInstance) -> AttemptSlotKeysReading {\n  match compute_seat_store(instance: i, seat: ComputeFlatSeat) {\n    ComputeSeatStoreReady { store } => attempt_slot_keys(store: store.slots)\n    ComputeSeatStoreUnready { detail } => AttemptSlotKeysRefused { detail: detail }\n  }\n}\n"

test fn a_forged_session_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_literal_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_session_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_cast_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn a_session_store_built_around_a_literal_path_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_literal_path_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn no_session_store_mint_takes_a_path() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_path_minter_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn another_family_store_is_not_a_session_store() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_other_store_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn session_store_holders_have_no_route_to_a_root() -> ProcessExit {
  census_exit(blocking_delta(hostile: session_root_out_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn the_lawful_session_store_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: session_lawful_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: session_lawful_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: session_lawful_source, subject: "SlotStore"), holds: fn(n) { n == 0 }),
  ])
}

