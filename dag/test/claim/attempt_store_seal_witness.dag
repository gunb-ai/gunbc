data compute_literal_path_source: String = "module probe_compute_store_literal_path\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f() -> ComputeSeatStore {\n  ComputeSeatStore { instance: \"srv1-lab\", seat: ComputeFlatSeat, slots: file_slot_store(root: \"/tmp/forged-attempts\") }\n}\n"

data compute_path_minter_source: String = "module probe_compute_store_path_minter\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(i: HostDashboardInstance) -> NonEmptyStr {\n  match compute_seat_store(instance: i, seat: ComputeFlatSeat, root: \"/tmp/forged-attempts\") {\n    ComputeSeatStoreReady { store: _ } => \"minted\"\n    ComputeSeatStoreUnready { detail: _ } => \"unready\"\n  }\n}\n"

data compute_other_store_source: String = "module probe_compute_store_other_handle\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(o: SessionAttemptSlotsStore) -> ComputeSeatStore {\n  o\n}\n"

data compute_root_out_source: String = "module probe_compute_store_root_out\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(c: ComputeSeatStore) -> NonEmptyStr {\n  c.slots.root\n}\n"

data compute_lawful_source: String = "module probe_compute_store_lawful\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(i: HostDashboardInstance) -> AttemptSlotKeysReading {\n  match compute_seat_store(instance: i, seat: ComputeFlatSeat) {\n    ComputeSeatStoreReady { store } => attempt_slot_keys(store: store.slots)\n    ComputeSeatStoreUnready { detail } => AttemptSlotKeysRefused { detail: detail }\n  }\n}\n"

data instance_route_baseline_source: String = "module probe_attempt_store_instance_route_baseline\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport std.types { FilePath }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(n: NonEmptyStr) -> NonEmptyStr {\n  n\n}\n"

data session_instance_route_source: String = "module probe_session_store_over_a_chosen_instance_root\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport std.types { FilePath }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f() -> AttemptSlotKeysReading {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"any\" as NonEmptyStr), instance_id: \"any\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/any/chosen/dir\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match session_attempt_slots_store(instance: i) {\n    SessionAttemptSlotsStoreReady { store } => attempt_slot_keys(store: store.slots)\n    SessionAttemptSlotsStoreUnready { detail } => AttemptSlotKeysRefused { detail: detail }\n  }\n}\n"

data credential_instance_route_source: String = "module probe_credential_store_over_a_chosen_instance_root\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport std.types { FilePath }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f(rec: CredentialAcquisitionRecord) -> AttemptTransition {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"any\" as NonEmptyStr), instance_id: \"any\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/any/chosen/dir\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match credential_acquisition_store(instance: i) {\n    CredentialAcquisitionStoreReady { store } => credential_open(credentials: store, record: rec)\n    CredentialAcquisitionStoreUnready { detail } => AttemptTransitionRefused { detail: detail }\n  }\n}\n"

data compute_instance_route_source: String = "module probe_compute_store_over_a_chosen_instance_root\nimport std.types { NonEmptyStr }\nimport gunbc.roadmap.roadmap_dashboard_instance { HostDashboardInstance, isolated_dashboard_instance, DashboardActuating, DashboardLocalProvision }\nimport gunbc.host.host_layout { srv1_host_layout }\nimport gunbc.deployment_risk { deployment_id }\nimport std.types { FilePath }\nimport gunbc.durable_cas_file_store { SlotStore, file_slot_store }\nimport gunbc.compute.attempt_lifecycle { AttemptTransition, AttemptTransitionRefused, AttemptSlotKeysReading, AttemptSlotKeysRefused, attempt_slot_keys }\nimport gunbc.roadmap.roadmap_session_attempt_slots_root { SessionAttemptSlotsStore, SessionAttemptSlotsStoreReady, SessionAttemptSlotsStoreUnready, session_attempt_slots_store }\nimport gunbc.dispatch_credential_acquisition { CredentialAcquisitionStore, CredentialAcquisitionStoreReady, CredentialAcquisitionStoreUnready, credential_acquisition_store, CredentialAcquisitionRecord, credential_open }\nimport gunbc.compute.compute_attempt_slots_root { ComputeSeatStore, ComputeSeatStoreReady, ComputeSeatStoreUnready, compute_seat_store, ComputeFlatSeat }\nfn f() -> AttemptSlotKeysReading {\n  let i = isolated_dashboard_instance(deployment: deployment_id(name: \"any\" as NonEmptyStr), instance_id: \"any\" as NonEmptyStr, layout: srv1_host_layout(), root: \"/any/chosen/dir\" as FilePath, serve_function: \"roadmap_serve_handle_srv1_lab\" as NonEmptyStr, listen_port: 18097, source_anchor_ref: \"refs/heads/main\" as NonEmptyStr, actuation: DashboardActuating, provision_transport: DashboardLocalProvision)\n  match compute_seat_store(instance: i, seat: ComputeFlatSeat) {\n    ComputeSeatStoreReady { store } => attempt_slot_keys(store: store.slots)\n    ComputeSeatStoreUnready { detail } => AttemptSlotKeysRefused { detail: detail }\n  }\n}\n"

test fn a_forged_session_store_literal_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_literal_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

test fn a_forged_session_store_cast_is_refused_at_compile() -> ProcessExit {
  census_exit(census_verdict(census: seal_violations(source: session_forged_cast_source, subject: "SessionAttemptSlotsStore"), holds: fn(n) { n == 1 }))
}

