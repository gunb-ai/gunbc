}

test fn another_family_store_is_not_a_compute_store() -> ProcessExit {
  census_exit(blocking_delta(hostile: compute_other_store_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn compute_store_holders_have_no_route_to_a_root() -> ProcessExit {
  census_exit(blocking_delta(hostile: compute_root_out_source, safe: closure_baseline_source, holds: fn(n) { n >= 1 }))
}

test fn the_lawful_compute_store_mint_is_admitted() -> ProcessExit {
  census_verdict_all(verdicts: [
    blocking_delta(hostile: compute_lawful_source, safe: closure_baseline_source, holds: fn(n) { n <= 0 }),
    census_verdict(census: seal_violations(source: compute_lawful_source, subject: "ComputeSeatStore"), holds: fn(n) { n == 0 }),
    census_verdict(census: seal_violations(source: compute_lawful_source, subject: "SlotStore"), holds: fn(n) { n == 0 }),
  ])
}
