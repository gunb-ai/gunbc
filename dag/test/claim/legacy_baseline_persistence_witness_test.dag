module test.claim.legacy_baseline_persistence_witness

import std.types { String, Bool, Int, List, SourceSpan, CommitSha }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.content_hash { Fnv1a64Structural, structural_content_hash }
import std.decl_ref { decl_ref }
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceIndex,
  OccurrenceIndexEntry,
  OccurrenceProjection,
  OccurrenceContainmentPath,
  LexicalValueOccurrence,
  DeclarationOccurrence,
  ReferenceOccurrence,
  OccurrenceTransport,
  ValidatedOccurrenceTransport,
  OccurrenceTransportValidated,
  OccurrenceTransportRefused,
  occurrence_transport_validate
}
import v2.workflow.legacy_binding_observation {
  LegacyBindingObservation,
  LegacyBindingObservationRow,
  LegacyBindingObservationSubject,
  ImportScopedPolicy,
  ObservationAdmitted,
  ObservationRefused,
  admit_complete_observation,
  legacy_subject_identity
}
import v2.workflow.legacy_baseline_persistence {
  LegacyBaselineReceipt,
  BaselinePersisted,
  BaselineBaseMalformed,
  NoLegacyBaselinePersisted,
  LegacyBaselinePersisted,
  persist_legacy_baseline,
  legacy_baseline_receipt,
  legacy_baseline_standing_of,
  legacy_baseline_persistence_standing,
  legacy_baseline_receipts
}

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE SUBJECT UNDER TEST IS "HAS A BASELINE BEEN TAKEN", not "can one be admitted". The admission is
// v2.workflow.legacy_binding_observation's and is witnessed there; these arms exercise only the
// binding of an admitted observation to a named base, the projection of its receipt, and the standing
// a consumer derives from the roster.
type LbpTestOutcome
  = LbpObserved
  | LbpUnobserved

// THE FIXTURE CANNOT FABRICATE AN ADMITTED OBSERVATION AND MUST NOT TRY. CompleteLegacyObservation is
// sole_constructor, so the only route is through the real admission, which means every arm carries an
// admission-refused branch and a transport-refused branch. Those are not decoration: collapsing
// either into a persistence verdict would let a fixture that never reached the mint read exactly like
// one that reached it and got an answer -- execution-provenance loss inside the harness, which is the
// easiest place to leave it uncaught.
type LbpPersistOutcome
  = PersistComputed { base: CommitSha, identity: Fnv1a64Structural, rows: Int }
  | PersistRefusedMalformedBase { base: String }
  | PersistAdmissionRefused
  | PersistFixtureTransportRefused

fn lbp_span() -> SourceSpan {
  SourceSpan { file: "legacy-baseline-persistence-fixture.dag", start: 1, end: 2 }
}

fn lbp_path(id: Int) -> OccurrenceContainmentPath {
  OccurrenceContainmentPath { ancestors: [OccurrenceId { value: 900 }], terminal: OccurrenceId { value: id } }
}

fn lbp_subject() -> LegacyBindingObservationSubject {
  LegacyBindingObservationSubject {
    semantic_source_digest: structural_content_hash(digest: "1111111111111111"),
    source_set_digest: structural_content_hash(digest: "2222222222222222"),
    compiler_artifact_digest: structural_content_hash(digest: "3333333333333333"),
    resolver_identity: decl_ref(module_path: "v1.compiler.infer_env", decl_name: "lookup_binding_by_name"),
    resolver_policy: ImportScopedPolicy,
    occurrence_transport_digest: structural_content_hash(digest: "4444444444444444"),
    declaration_index_digest: structural_content_hash(digest: "5555555555555555")
  }
}

fn lbp_observation_of(ids: List<Int>) -> LegacyBindingObservation<LbpTestOutcome> {
  LegacyBindingObservation {
    subject: lbp_subject(),
    rows: ids |> map(id => LegacyBindingObservationRow {
      occurrence: OccurrenceId { value: id },
      outcome: LbpObserved
    })
  }
}

fn lbp_transport_of(expected: List<Int>) -> OccurrenceTransportValidation {
  occurrence_transport_validate(transport: OccurrenceTransport {
    index: OccurrenceIndex { entries: concat(
      [OccurrenceIndexEntry {
        projection: OccurrenceProjection {
          occurrence: OccurrenceId { value: 900 },
          authored_name: "root",
          diagnostic_span: lbp_span()
        },
        containment: OccurrenceContainmentPath { ancestors: [], terminal: OccurrenceId { value: 900 } }
      }],
      expected |> map(id => OccurrenceIndexEntry {
        projection: OccurrenceProjection {
          occurrence: OccurrenceId { value: id },
          authored_name: "r",
          diagnostic_span: lbp_span()
        },
        containment: lbp_path(id: id)
      })
    ) },
    declarations: [DeclarationOccurrence {
      occurrence: OccurrenceId { value: 900 },
      containment: OccurrenceContainmentPath { ancestors: [], terminal: OccurrenceId { value: 900 } },
      category: LexicalValueOccurrence,
      diagnostic_span: lbp_span()
    }],
    references: expected |> map(id => ReferenceOccurrence {
      occurrence: OccurrenceId { value: id },
      containment: lbp_path(id: id),
      category: LexicalValueOccurrence,
      diagnostic_span: lbp_span()
    })
  })
}

fn lbp_persist_over(ids: List<Int>, base: CommitSha) -> LbpPersistOutcome {
  match lbp_transport_of(expected: ids) {
    OccurrenceTransportRefused { refusal: _ } => PersistFixtureTransportRefused
    OccurrenceTransportValidated { transport: t } =>
      match admit_complete_observation(observation: lbp_observation_of(ids: ids), transport: t) {
        ObservationRefused { completeness: _ } => PersistAdmissionRefused
        ObservationAdmitted { admitted: a } =>
          match persist_legacy_baseline(admitted: a, base_commit: base) {
            BaselineBaseMalformed { base_commit: b } => PersistRefusedMalformedBase { base: b }
            BaselinePersisted { persisted: p } => PersistComputed {
              base: p.base_commit,
              identity: p.subject_identity,
              rows: legacy_baseline_receipt(persisted: p).observed_rows
            }
          }
      }
  }
}

fn lbp_good_base() -> CommitSha {
  "1007efb256a20749f77c3b1295eed144fddeb9fd"
}

// A well-formed base binds, and the stored identity is the one the observation's own subject hashes
// to -- checked against an independent call rather than against a value the fixture supplied, which
// is the whole claim of the mint deriving it.
test fn a_baseline_over_a_well_formed_base_binds_to_its_own_subject_identity() -> Bool {
  match lbp_persist_over(ids: [10, 11], base: lbp_good_base()) {
    PersistFixtureTransportRefused => false
    PersistAdmissionRefused => false
    PersistRefusedMalformedBase { base: _ } => false
    PersistComputed { base: b, identity: i, rows: r } =>
      b == lbp_good_base()
        && i == legacy_subject_identity(subject: lbp_subject())
        && r == 2
  }
}

// THE MALFORMED BASE REFUSES AND NAMES THE TEXT IT REJECTED. This is the arm that would silently
// bind a baseline to a commit nobody can resolve if the mint took CommitSha at face value, which is
// what the alias permits.
test fn a_base_that_is_not_forty_hex_refuses_and_carries_the_rejected_text() -> Bool {
  match lbp_persist_over(ids: [10], base: "HEAD") {
    PersistFixtureTransportRefused => false
    PersistAdmissionRefused => false
    PersistComputed { base: _, identity: _, rows: _ } => false
    PersistRefusedMalformedBase { base: b } => b == "HEAD"
  }
}

// An uppercase 40-hex string is a real near-miss rather than a contrived one: it names the same
// commit to a human and fails the syntax wall, so a mint that lowercased or shrugged would admit two
// spellings of one base.
test fn an_uppercase_forty_hex_base_still_refuses() -> Bool {
  match lbp_persist_over(ids: [10], base: "1007EFB256A20749F77C3B1295EED144FDDEB9FD") {
    PersistComputed { base: _, identity: _, rows: _ } => false
    PersistFixtureTransportRefused => false
    PersistAdmissionRefused => false
    PersistRefusedMalformedBase { base: _ } => true
  }
}

// THE ABSENT DIRECTION. An empty roster is its own state and must not be a Clear-shaped answer.
test fn an_empty_roster_reports_that_no_baseline_is_persisted() -> Bool {
  match legacy_baseline_standing_of(receipts: []) {
    LegacyBaselinePersisted { malformed_bases: _ } => false
    NoLegacyBaselinePersisted => true
  }
}

// THE PRESENT DIRECTION, from a receipt PROJECTED off a real persisted baseline rather than authored
// here -- so this arm cannot pass over a receipt shape the mint would never produce.
test fn a_projected_receipt_makes_the_standing_persisted_with_nothing_outstanding() -> Bool {
  match lbp_transport_of(expected: [10, 11]) {
    OccurrenceTransportRefused { refusal: _ } => false
    OccurrenceTransportValidated { transport: t } =>
      match admit_complete_observation(observation: lbp_observation_of(ids: [10, 11]), transport: t) {
        ObservationRefused { completeness: _ } => false
        ObservationAdmitted { admitted: a } =>
          match persist_legacy_baseline(admitted: a, base_commit: lbp_good_base()) {
            BaselineBaseMalformed { base_commit: _ } => false
            BaselinePersisted { persisted: p } =>
              match legacy_baseline_standing_of(receipts: [legacy_baseline_receipt(persisted: p)]) {
                NoLegacyBaselinePersisted => false
                LegacyBaselinePersisted { malformed_bases: m } => count(m) == 0
              }
          }
      }
  }
}

// A HAND-AUTHORED ROW *CAN* NAME A BASE THE MINT WOULD HAVE REFUSED, because the roster is a plain
// record list rather than a list of minted carriers. That is the gap the outstanding population
// exists to report, and this arm is the evidence it reports it rather than counting the row as good.
test fn a_receipt_naming_a_malformed_base_is_outstanding_rather_than_clear() -> Bool {
  match legacy_baseline_standing_of(receipts: [LegacyBaselineReceipt {
    base_commit: "not-a-commit",
    subject_identity: legacy_subject_identity(subject: lbp_subject()),
    observed_rows: 1
  }]) {
    NoLegacyBaselinePersisted => false
    LegacyBaselinePersisted { malformed_bases: m } => count(m) == 1
  }
}

// THE ROSTER IS EMPTY TODAY, AND THAT IS ASSERTED RATHER THAN ASSUMED. If a row ever lands, this arm
// goes red and whoever landed it must say so here -- which is the point: a baseline appearing is a
// program event, not a quiet edit.
test fn the_committed_roster_is_still_empty_and_the_milestone_therefore_unanswerable() -> Bool {
  count(legacy_baseline_receipts) == 0
    && match legacy_baseline_persistence_standing() {
      LegacyBaselinePersisted { malformed_bases: _ } => false
      NoLegacyBaselinePersisted => true
    }
}
