module test.claim.card_cooling_route_witness

import std.types {Bool}
import std.measure {micrometer}
import product.printed_chassis.card_cooling_route {
  PlaneOnEnd, PlaneAcrossRowStanding, OverTheRow, BesideTheRow,
  RouteAdmission, RouteAdmitted, RouteProposalOnly, RouteRefusedByChassis, RouteHomeUnmeasured,
  admit_home, plane_on_end_run_back, plane_on_end_slot_demand, plane_across_row_run_back,
  a16_blower, a16_wall_design, a16_route_report, outlet_alignment_obligation,
}
import product.printed_chassis.gpu_duct {a16_blower_duct_design, blower_reach_behind, um}
import product.printed_chassis.chassis_clearances {Measured, DeclaredConservativeByOperator, EstimatedByOperator, NeedsMeasurement, card_end_rear_fan_clearance, neighbour_lane_width, chassis_gaps, gap_display, gap_is_measured, gap_may_be_printed_on, remeasure_before_print}
import extdeps.gpu.passive_card_row {row_is_sealed, row_unread_fields, row_field_obligation}
import extdeps.gpu.nvidia_passive_rows {a16_row, t10_row, a2_row, card_rows, all_rows_bench_list}

// ═══ THE 70 mm IS NOT THE ONLY CONSTRAINT, AND THE WITNESSES SAY SO ═══
//
// The operator asked for a duct that curves inside the ~70 mm between the A16's plug end and the rear
// chassis fan. These tests pin the two things that make that ask a design question rather than a drawing
// exercise: (a) which orientation actually spends the 70 mm, and (b) which chassis gaps a home depends on
// that nobody has ever measured. A test that only checked "36 mm fits in 70 mm" would certify a duct that
// puts 97 mm of blower housing into the neighbouring card's lane.

fn is_admitted(a: RouteAdmission) -> Bool { match a { RouteAdmitted {home: _, needs: _} => true RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: _, margin: _} => false RouteProposalOnly {home: _, needs: _, on_estimate: _, margin: _} => false RouteRefusedByChassis {home: _, unmet: _, gap: _} => false RouteHomeUnmeasured {home: _, unmet: _, gap: _} => false } }
fn is_chassis_refusal(a: RouteAdmission) -> Bool { match a { RouteAdmitted {home: _, needs: _} => false RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: _, margin: _} => false RouteProposalOnly {home: _, needs: _, on_estimate: _, margin: _} => false RouteRefusedByChassis {home: _, unmet: _, gap: _} => true RouteHomeUnmeasured {home: _, unmet: _, gap: _} => false } }
// The operator-bound admission, kept separate from RouteAdmitted everywhere: `is_admitted` is TRUE only
// for the caliper-grounded verdict, so no test can accidentally treat a declared bound as a measurement.
fn is_admitted_on_operator_bound(a: RouteAdmission) -> Bool { match a { RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: _, margin: _} => true _ => false } }
fn is_operator_admission_that_prints_as_a_fit_print(a: RouteAdmission) -> Bool {
  match a {
    RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: g, margin: _} => gap_may_be_printed_on(g: g) && !gap_is_measured(g: g)
    _ => false
  }
}
fn is_unmeasured_refusal(a: RouteAdmission) -> Bool { match a { RouteAdmitted {home: _, needs: _} => false RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: _, margin: _} => false RouteProposalOnly {home: _, needs: _, on_estimate: _, margin: _} => false RouteRefusedByChassis {home: _, unmet: _, gap: _} => false RouteHomeUnmeasured {home: _, unmet: _, gap: _} => true } }

// DERIVATION, NOT DECORATION: the plane-on-end home spends only the blower's thickness behind the plug
// end. Delta's cited envelope is 33.0 mm thick +/- 0.5 (extdeps.fans.delta delta_bfb1012m_envelope) and
// the duct's wall is 2 mm (product.printed_chassis.gpu_duct a16_duct_design): 37.5 mm of the operator's
// ~70 mm. If Delta's number or the wall moves, this test moves with it -- that is the point of the literal.
test fn w_plane_on_end_spends_its_thickness_not_its_face_behind_the_end() -> Bool {
  plane_on_end_run_back(b: a16_blower(), d: a16_wall_design()) == 33000 + 500 + 2 * 2000
    && plane_on_end_run_back(b: a16_blower(), d: a16_wall_design()) <= 70000
}

// THE SAME HOME PAYS ACROSS THE SLOT. Plane on end, the housing's LONG face (97.2 mm) spans the slot
// direction, where the next card's duct starts at the slot pitch -- 40.64 mm by the PCIe class the design
// carries. The orientation that fits the 70 mm is the orientation that does NOT fit the pitch, and the
// model must keep both numbers in the reader's head at once.
test fn w_plane_on_end_spills_into_the_neighbour_lane() -> Bool {
  plane_on_end_slot_demand(b: a16_blower()) == 97200
    && plane_on_end_slot_demand(b: a16_blower()) > um(m: a16_blower_duct_design.slot_pitch)
}

// AND THE OVERHANG IS ASKED THE WAY THE SIDES ARE MEASURED. The face spans the 40.64 mm pitch, so what it
// spends BESIDE this card's own lane is the excess -- 28.28 mm per side at 97.2 mm. The operator's word
// about the sides was a word about one side, so the per-side figure is the honest thing to put under it:
// putting the whole 97.2 under a per-side allowance would be a unit error dressed as caution, and putting
// the per-side figure under the whole span would be the same error the other way.
test fn w_the_overhang_asks_per_side_what_the_sides_gave_per_side() -> Bool {
  plane_on_end_overhang_per_side(b: a16_blower()) == (97200 - 40640) / 2
    && plane_on_end_overhang_per_side(b: a16_blower()) == 28280
    && a16_slot_pitch_um() == 40640
}

// THE STRAIGHT BACK, MEASURED HONESTLY: what the duct built today asks for behind the end is the socket's
// bound -- the housing's longer edge while the outlet's edge on the drawing stays unread -- plus the
// socket's depth and a wall. That is well over the 70 mm, which is the whole reason this module exists.
test fn w_the_straight_back_asks_the_chassis_for_more_than_it_has() -> Bool {
  let asked = plane_across_row_run_back(b: a16_blower(), d: a16_wall_design())
  asked == blower_reach_behind(b: a16_blower_duct_design) + 10000 + 2000 && asked > 70000
}

// ADMISSION: the straight-back home is refused BY THE CHASSIS, not by an unread gap -- its verdict does
// not change when the unmeasured gaps are read, and a reader must not be sent to measure the wrong thing.
test fn w_straight_back_is_refused_by_the_chassis_itself() -> Bool {
  is_chassis_refusal(a: admit_home(home: PlaneAcrossRowStanding))
}

// ADMISSION, 2026-10-26. The two blanks that refused the flat-on-the-plug-end home now carry the
// operator's declared conservative bounds -- chassis_clearances card_end_rear_fan_clearance ("i would put
// 70mm for now - its like 73mm but i want to be conservative") and neighbour_lane_width ("yes, you can
// assume more than enough space on the sides, 70mm is fine") -- and the home is ADMITTED ON THEM: 37.5 mm
// behind the end (w_plane_on_end_spends_its_thickness_not_its_face_behind_the_end) and 28.28 mm per side,
// both under the 70 they allowed. The over-the-row and beside-the-row
// homes still refuse on gaps nobody has ruled on, and they must keep refusing: the operator's words were
// about the rear and the sides, and a rule that admitted those two as well would be a rule the quotes do
// not support (DESIGN.md 4d, "do not over-forbid" has a twin -- do not over-admit either).
test fn w_plane_on_end_is_admitted_on_the_operators_bounds_and_the_rest_still_refuse() -> Bool {
  is_admitted_on_operator_bound(a: admit_home(home: PlaneOnEnd))
    && is_unmeasured_refusal(a: admit_home(home: OverTheRow {riser: micrometer(count: 6000)}))
    && is_unmeasured_refusal(a: admit_home(home: BesideTheRow))
}

// THE OPERATOR'S BOUND PRINTS, AND IT DOES NOT BECOME A MEASUREMENT BY DOING SO. Their two sentences
// answered "can we print" as well as "is this admissible", and the exposure they accepted is one PLA plate
// -- the fit print is itself the instrument that catches a wrong allowance. So gap_may_be_printed_on is
// true for a declared bound. What must NOT move is the epistemic part: gap_is_measured stays false for the
// same gap, and the reading is still listed as owed. A witness that conflated printable with measured is
// the laundering this verdict shape exists to prevent, and a witness that refused the print would be
// over-forbidding past a decision the owner of the chassis already made.
test fn w_the_operators_bound_prints_without_becoming_a_measurement() -> Bool {
  gap_may_be_printed_on(g: card_end_rear_fan_clearance)
    && gap_may_be_printed_on(g: neighbour_lane_width)
    && !gap_is_measured(g: card_end_rear_fan_clearance)
    && !gap_is_measured(g: neighbour_lane_width)
    && is_operator_admission_that_prints_as_a_fit_print(a: admit_home(home: PlaneOnEnd))
}

// THE TWO STANDINGS THAT ARE NOT RULINGS STILL REFUSE THE PRINT. An estimate is a guess about a fact that
// nobody has ruled on, and an unread gap is nobody's claim at all: both keep refusing, so the print answer
// tracks WHO DECIDED rather than how big the number is.

// THE MARGIN IS THE BOUND'S, NOT THE READING'S. The route needs 37.5 mm behind the end and the bound
// allows 70, so the margin is 32.5 mm -- taken against what the operator ALLOWED, and not against the
// ~73 mm they said it was "like": checking against the 73 would promote a figure they called rough and
// then deliberately discounted into the authority the design is measured by. The expected figure is
// derived from plane_on_end_run_back, so this cannot drift from the arithmetic it checks.
test fn w_the_margin_is_taken_against_the_allowed_bound_not_the_rough_reading() -> Bool {
  match admit_home(home: PlaneOnEnd) {
    RouteAdmittedOnOperatorBound {home: _, needs: _, on_bound: _, margin: mg} => um(m: mg) == 70000 - plane_on_end_run_back(b: a16_blower(), d: a16_wall_design())
      && um(m: mg) == 32500
    _ => false
  }
}

// THE PART CANNOT OUTGROW THE ADMITTED DEMAND. The printable part budgets its own z stack -- the housing's
// thickness, Delta's tolerance, and the shoulder's two plates -- and that stack must equal the demand the route
// model put under the operator's bound. If someone thickens a wall, this fails before a plate is planned,
// rather than the print discovering 4 mm that the chassis never agreed to.
test fn w_the_printable_part_budgets_exactly_the_admitted_run_back() -> Bool {
  plane_on_end_duct_run_back(b: a16_blower_duct_design, d: a16_wall_design())
    == plane_on_end_run_back(b: a16_blower(), d: a16_wall_design())
    && plane_on_end_duct_run_back(b: a16_blower_duct_design, d: a16_wall_design()) == 37500
}

// THE SHARP OPEN POINT, PINNED AS AN ARITHMETIC FACT AND NOT AS A PARAGRAPH. The A16 end face is 97.84 mm;
// the 8-pin connector claims a 26.0 mm band at its top end (2.56 mm from the edge to the connector's near
// pin, 23.44 mm past its outer pin), leaving 71.84 mm of face clear of it. The BFB1012M housing is 94.4 mm
// at its SHORTER edge. So the flat-on-end housing lies over the connector's keep-out band in either
// orientation and at any placement on this face -- this is a size fact about this card and this fan, not a
// placement mistake to be slid out of. Pinned so that a future change to either figure is noticed: if the
// clearance ever becomes real, this witness fails and says so, rather than the part quietly becoming legal.
test fn w_the_housing_cannot_be_placed_clear_of_the_power_keepout_on_this_card() -> Bool {
  plane_on_end_face_clear_of_keepout_um(f: a16_end_face, d: a16_wall_design()) == 71840
    && plane_on_end_keepout_crossing_um(f: a16_end_face, d: a16_wall_design(), b: a16_blower_duct_design) == 22400
    && !plane_on_end_housing_clears_keepout(b: a16_blower_duct_design, f: a16_end_face, d: a16_wall_design())
    && smaller_i(a: um(m: delta_bfb1012m_envelope.housing_length), b: um(m: delta_bfb1012m_envelope.housing_depth)) > plane_on_end_face_clear_of_keepout_um(f: a16_end_face, d: a16_wall_design())
}

// THE REFUSAL IS THE SAME CODE WITH A SMALLER NUMBER IN IT. Nothing below hand-writes a verdict: at 30 mm
// behind the end the identical home -- same blower, same wall, same overhang -- is refused by the chassis,
// and at the operator's 70 it is admitted. Refusal as a function of the bound is the only form of this
// test that says anything about the RULE rather than about today's text.
fn bench_rear_bound(total: Int) -> ChassisGap {
  Measured {
    name: "plug end to rear chassis fan (bench bound, not this chassis)",
    from_point: "the card's plug end",
    to_point: "the nearest surface of the rear chassis fan assembly in the card's lane",
    distance: micrometer(count: total),
    standing: DeclaredConservativeByOperator {
      bound: micrometer(count: total),
      reading: Absent,
      date: "hypothetical; exercised by dag/test/claim/card_cooling_route_witness only",
      positions: "not a reading of the operator's chassis",
      basis: "not the operator's words -- a stand-in bound, to exercise the refusal at 30 mm",
      does_not_settle: "everything: nobody has given this bound",
    },
  }
}

test fn w_the_same_home_is_refused_at_thirty_mm_behind_the_end() -> Bool {
  is_chassis_refusal(a: admit_plane_on_end(rear: bench_rear_bound(total: 30000), lane: neighbour_lane_width))
    && is_admitted_on_operator_bound(a: admit_plane_on_end(rear: card_end_rear_fan_clearance, lane: neighbour_lane_width))
}

// A SHORT REAR BOUND REFUSES THE REAR, NOT THE SIDES. The refusal must name the rear demand and carry the
// rear gap, so the operator is sent back to the thing that actually failed. Blaming the sides would be the
// model lying about which of the two bounds the design exhausted.
test fn w_the_thirty_mm_refusal_blames_the_rear_and_not_the_sides() -> Bool {
  match admit_plane_on_end(rear: bench_rear_bound(total: 30000), lane: neighbour_lane_width) {
    RouteRefusedByChassis {home: PlaneOnEnd, unmet: n, gap: g} => (n.of_gap as String) == "plug end to rear chassis fan"
      && string_contains(s: gap_display(g: g), pattern: "DECLARED BY THE OPERATOR")""
    _ => false
  }
}

// AND A TIGHT SIDE BOUND REFUSES THE SIDES, NOT THE REAR: at 20 mm per side the overhang fails while the
// rear still fits, which is the other half of the same honesty.
test fn w_a_twenty_mm_side_bound_refuses_on_the_overhang() -> Bool {
  let tight = Measured {
    name: "lane between adjacent cards, behind the plug ends (bench bound, not this chassis)",
    from_point: "this card's own centre plane across the slot",
    to_point: "the nearest surface of the adjacent card's own duct or blower behind the plug ends",
    distance: micrometer(count: 20000),
    standing: DeclaredConservativeByOperator {
      bound: micrometer(count: 20000),
      reading: Absent,
      date: "hypothetical; exercised by dag/test/claim/card_cooling_route_witness only",
      positions: "not a reading of the operator's chassis",
      basis: "not the operator's words -- a stand-in bound, to exercise a tight side",
      does_not_settle: "everything: nobody has given this bound",
    },
  }
  match admit_plane_on_end(rear: card_end_rear_fan_clearance, lane: tight) {
    RouteRefusedByChassis {home: PlaneOnEnd, unmet: n, gap: _} => (n.of_gap as String) == "space on the sides of the card row"
    _ => false
  }
}

// AN ADMISSION IS NEVER LUCKY: the home the operator's bounds open is admitted with all THREE demands
// visible -- the slot span, the per-side overhang and the run back -- so a reader sees everything the
// bound was asked to cover, and the verdict says whose bound it was.
test fn w_the_admitted_home_reports_everything_it_spends() -> Bool {
  match admit_home(home: PlaneOnEnd) {
    RouteAdmittedOnOperatorBound {home: _, needs: ns, on_bound: g, margin: _} => length(list: ns) == 3
      && string_contains(s: gap_display(g: g), pattern: "DECLARED BY THE OPERATOR")""
    _ => false
  }
}

// THREE OPERATOR-FACING VERDICTS, NOT TWO. A caliper admission, an admission on a declared bound and a
// proposal are three different things, rendered with different words; a reader who could read "ADMITTED"
// off an estimate is exactly the defect DESIGN.md 4d names.
test fn w_the_verdicts_stay_distinguishable_in_text() -> Bool {
  let report = a16_route_report()
  length(list: report) == 4
    && match report[0] {
      Absent => false
      Present { value: line } => string_contains(s: line, pattern: "ADMITTED ON AN OPERATOR-DECLARED BOUND")
    }
    && match report[2] {
      Absent => false
      Present { value: line } => string_contains(s: line, pattern: "REFUSED")
    }
}

// THE BENCH LIST IS THE OUTPUT: the gaps the operator must read are reachable as data, and the estimate
// appears in it as a re-read demand rather than silently counting as a measurement.
test fn w_the_bench_list_carries_every_gap_the_model_refuses_on() -> Bool {
  length(list: remeasure_before_print(gaps: chassis_gaps)) == length(list: chassis_gaps)
}

// THE ONE THING NO GEOMETRY CAN CLOSE: the outlet's position on Delta's housing is unread, so every home
// here assumes the air CAN be aimed at the window and says so. A check invented over that blank would be
// a guess about where the fan blows.
// The outlet ambiguity itself is witnessed where it is minted (test.claim.gpu_duct_witness, on
// extdeps.fans.delta delta_bfb1012m_outlet_standing); what this module's tests must pin is that the route
// model CARRIES the obligation rather than silently assuming the aim.
test fn w_outlet_alignment_stays_an_obligation_not_a_check() -> Bool {
  string_length(outlet_alignment_obligation()) > 0
}

// ═══ THE CARD ROWS ═══

// THE A16 ROW IS HONEST ABOUT BEING A COPY. Its millimetres are the operator's caliper record
// (product.printed_chassis.gpu_duct a16_end_face); carrying them into a row makes them a transcription,
// and a transcription prints nothing until read back. Minting the observation standing directly is a
// forgery (test.claim.observed_receipt_seal_witness), so the sealed row would be the SUSPICIOUS one.
test fn w_the_a16_row_is_transcribed_not_sealed() -> Bool {
  !row_is_sealed(row: a16_row)
    && length(list: row_unread_fields(row: a16_row)) > 0
    && match row_field_obligation(field: a16_row.end_face_length) {
         Absent => false
         Present { value: o } => string_length(o) > 0
       }
}

// THE T10 AND A2 ROWS REFUSE EVERY FIELD. The datasheets do not answer at any path this repository could
// reach (the probe is recorded in extdeps.gpu/nvidia_passive_rows); a row built on remembered numbers
// would seal on a guess, and 60 cards would arrive wearing it.
test fn w_t10_and_a2_rows_carry_no_unbacked_numbers() -> Bool {
  !row_is_sealed(row: t10_row) && !row_is_sealed(row: a2_row)
    && length(list: row_unread_fields(row: t10_row)) == 8
    && length(list: row_unread_fields(row: a2_row)) == 8
}

// ONE CONCEPT, CARDS AS DATA: the rows are data in a list, the bench list names each unsealed row once,
// and a fourth card joins without any product-layer branch. The report's length is the row count, so a
// new card shows up where the operator will read it.
test fn w_a_fourth_card_is_one_more_row() -> Bool {
  length(list: card_rows) == 3
    && length(list: all_rows_bench_list()) > length(list: card_rows)
}
