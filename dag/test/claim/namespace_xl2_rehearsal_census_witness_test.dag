module test.claim.namespace_xl2_rehearsal_census

import std.types { Bool, List, NonEmptyStr, String }
import extdeps.git.object_store { git_sha1_object_id }
import gunbc.namespace_step0_subject_collector { Step0CommitIdentityUnreadable }
import tools.multi_module_compile_fixture { FixtureSource }
import gunbc.namespace_xl2_rehearsal_census {
  Xl2PrerequisiteOutstanding,
  Xl2ScopeUnobserved,
  Xl2CompleteArmNotAdmitted,
  Xl2CensusCompletenessRefused,
  Xl2MemberPathDuplicated,
  Xl2ModuleObservationIncomplete,
  Xl2RehearsalBaseUnobserved,
  Xl2RehearsalObserved,
  Xl2RehearsalRun,
  Xl2ResidualChain,
  Xl2ScopeUnobserved,
  Xl2Strip,
  Xl2KernelCanonicalReferencesUncounted,
  HeaderSegmentsNotRefusalSites,
  Xl2StrippedMember,
  xl2_rehearse_stripped,
  xl2_strip_members
}
import gunbc.compiler_frontend_program_status { xl2_prerequisites_outstanding }
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.diagnostic { None, Some, diagnostics_eq }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// THE CONTROLS THE BRIEF OWES, RUN THROUGH THE REHEARSAL'S OWN COMPOSITION: the typed strip
// (gunbc.namespace_step0_strip_producer), path admission, the path-faithful ingest, and
// v2.compiler.compile's census-resolve. Only the exact-base collector is replaced by supplied
// sources, because it reads the repository's object store and the hermetic floor cannot reach that
// (the collector's own note states the route deficit); every stage downstream of the vector is the
// production one.
//
// THE RESIDUAL CONTROL IS THE CUT'S OWN SHAPE: a module whose body names a function ANOTHER MODULE
// declares and it imports. Unstripped it resolves; stripped, the import is gone and the reference
// dangles at NAME RESOLUTION. THE NAME IS A CORPUS DECLARATION, NOT A KERNEL NAME, and that is
// measured rather than chosen: the first cut of this control relied on v2.std.logic Bool, and the
// floor showed its stripped form still resolving, because v2.compiler.resolve
// resolved_reference_identity binds a kernel canonical leaf with no import at all (carried on the run
// as Xl2KernelCanonicalReferencesUncounted). Bool remains in these signatures only as a kernel type,
// which is why stripping its import changes nothing.
//
// THE TWO-FAILURE CONTROL IS P4'S DISCRIMINATOR APPLIED TO THE REHEARSAL: two declarations in ONE
// module, each naming a different provider function, so the stripped module refuses at two
// independent sites. P4 (gunbc#12116) reports both chains and ObservationComplete; the census must
// report exactly two rows, each carrying its own chain, and raise no incomplete-observation scope.
//
// THE PROVIDER AND THE CLEAN CONTROL IMPORT NOTHING but kernel names, so the strip leaves them
// resolving.
data xl2_provider_control_source: String = "module v2.xl2_control_provider\n\nimport std.types { Bool }\n\nfn xl2_control_provider_flag(p: Bool) -> Bool { p }\n\nfn xl2_control_provider_other(p: Bool) -> Bool { p }\n"

data xl2_residual_control_source: String = "module v2.xl2_control_residual\n\nimport std.types { Bool }\nimport v2.xl2_control_provider { xl2_control_provider_flag }\n\nfn xl2_control_residual_value(p: Bool) -> Bool { xl2_control_provider_flag }\n"

data xl2_two_failure_control_source: String = "module v2.xl2_control_two\n\nimport std.types { Bool }\nimport v2.xl2_control_provider { xl2_control_provider_flag, xl2_control_provider_other }\n\nfn xl2_control_two_first(p: Bool) -> Bool { xl2_control_provider_flag }\n\nfn xl2_control_two_second(p: Bool) -> Bool { xl2_control_provider_other }\n"

// THE NESTED CONTROL: a module declared UNDER the provider's namespace, naming the provider's
// function through an import the strip removes. Nesting grants no scope (operator ruling
// 2026-10-04: a module sees only its own declarations and its own imports), so stripped, its
// reference is an ordinary residual row like any other module's.
data xl2_nested_control_source: String = "module v2.xl2_control_provider.nested\n\nimport std.types { Bool }\nimport v2.xl2_control_provider { xl2_control_provider_flag }\n\nfn xl2_control_nested_value(p: Bool) -> Bool { xl2_control_provider_flag }\n"

data xl2_clean_control_source: String = "module v2.xl2_control_clean\n\nimport std.types { Bool }\n\nfn xl2_control_clean_value(p: Bool) -> Bool { p }\n"

fn xl2_control_source(path: String, content: String) -> FixtureSource {
  FixtureSource { path: path as NonEmptyStr, content: content }
}

// A placeholder revision: the controls exercise the composition, not the pin. An unreadable literal
// is reported as the collector would report it, never replaced by a default.
data xl2_control_revision_hex: String = "0000000000000000000000000000000000000000"

fn xl2_control_rehearse(strip: Xl2Strip) -> Xl2RehearsalRun {
  match git_sha1_object_id(hex: xl2_control_revision_hex) {
    Absent => Xl2RehearsalBaseUnobserved { cause: Step0CommitIdentityUnreadable { hex: xl2_control_revision_hex } }
    Present { value: oid } => xl2_rehearse_stripped(source_commit: oid, source_tree: oid, supplied: strip)
  }
}

// THE PRE-CUT DIFFERENTIAL BYPASSES ONLY THE STRIP: the same sources, admitted unchanged, through the
// same observation.
fn xl2_unstripped(sources: List<FixtureSource>) -> Xl2Strip {
  Xl2Strip {
    members: fold(sources, init: [], f: fn(acc, s) { acc |> list_push(Xl2StrippedMember { source: s, base_coordinates: [] }) }),
    unobserved: []
  }
}

// ONE NULLARY PRODUCER PER RUN, each a front end plus its resolves. They were one record whose
// claims each read a different field, which the derived share now declines as a bundle
// (v2.workflow.floor_pure_producer_share BundleOfDisjointProjections): sharing it netted every
// claim's own run out of that claim's budget. Now `xl2_cut_run` is the one value four claims
// demand, shared by demand; each other run is its one claim's own fixture, carried as that claim's
// floor_single_claim_fill_debt membership rather than hidden inside a shared record.
fn xl2_provider_fixture() -> FixtureSource {
  xl2_control_source(path: "dag/xl2_control_provider.dag", content: xl2_provider_control_source)
}

fn xl2_residual_fixture() -> FixtureSource {
  xl2_control_source(path: "dag/xl2_control_residual.dag", content: xl2_residual_control_source)
}

fn xl2_clean_fixture() -> FixtureSource {
  xl2_control_source(path: "dag/xl2_control_clean.dag", content: xl2_clean_control_source)
}

fn xl2_cut_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_strip_members(sources: [xl2_provider_fixture(), xl2_residual_fixture(), xl2_clean_fixture()]))
}

fn xl2_two_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_strip_members(sources: [
    xl2_provider_fixture(),
    xl2_control_source(path: "dag/xl2_control_two.dag", content: xl2_two_failure_control_source)
  ]))
}

fn xl2_pre_cut_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_unstripped(sources: [xl2_provider_fixture(), xl2_residual_fixture()]))
}

fn xl2_duplicated_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_strip_members(sources: [
    xl2_control_source(path: "dag/xl2_control_shared.dag", content: xl2_residual_control_source),
    xl2_control_source(path: "dag/xl2_control_shared.dag", content: xl2_clean_control_source),
    xl2_clean_fixture()
  ]))
}

fn xl2_nesting_run() -> Xl2RehearsalRun {
  xl2_control_rehearse(strip: xl2_strip_members(sources: [
    xl2_provider_fixture(),
    xl2_control_source(path: "dag/xl2_control_nested.dag", content: xl2_nested_control_source)
  ]))
}

// RED CONTROL: the residual module yields exactly one failure chain, and it is that module's.
test fn xl2_residual_control_is_reported_holds() -> Bool {
  match xl2_cut_run() {
    Xl2RehearsalObserved { residual: residual } =>
      count(residual) == 1 && all(residual, r => r.module == "v2.xl2_control_residual")
    _ => false
  }
}

// GREEN CONTROL: the provider and the clean module both resolved, and neither contributed a row.
test fn xl2_clean_control_resolves_holds() -> Bool {
  match xl2_cut_run() {
    Xl2RehearsalObserved { residual: residual, resolved_module_count: n } =>
      n == 2 && !any(residual, r => r.module == "v2.xl2_control_clean" || r.module == "v2.xl2_control_provider")
    _ => false
  }
}

// THE CUT IS WHAT MADE THE RED: the residual module unstripped, beside its provider, resolves on the
// same route, so the row above is the strip's residual and not a defect in the specimen.
test fn xl2_residual_control_resolves_before_the_cut_holds() -> Bool {
  match xl2_pre_cut_run() {
    Xl2RehearsalObserved { residual: residual, resolved_module_count: n } => count(residual) == 0 && n == 2
    _ => false
  }
}

// COMPLETENESS IS REFUSED, AND FOR THE NAMED REASONS ONLY: every outstanding XL-2 prerequisite, one each,
// and P4 observed the residual module completely, so NO incomplete-observation scope is raised for
// it. The previous cut raised an abandonment scope for every refused module, which would have kept
// the rehearsal incomplete for a reason P4 has since discharged.
test fn xl2_control_completeness_is_refused_holds() -> Bool {
  match xl2_cut_run() {
    Xl2RehearsalObserved { completeness: Xl2CensusCompletenessRefused { first: Xl2PrerequisiteOutstanding { prerequisite: _ }, rest: rest } } =>
      count(rest) + 1 == count(xl2_prerequisites_outstanding())
        && all(rest, r => match r {
             Xl2PrerequisiteOutstanding { prerequisite: _ } => true
             Xl2ScopeUnobserved { scope: _ } => false
             Xl2CompleteArmNotAdmitted => false
           })
    _ => false
  }
}

// The first and last rows' chains, compared through std.diagnostic's own equality.
fn xl2_first_and_last_chains_differ(residual: List<Xl2ResidualChain>) -> Bool {
  let chains = fold(residual, init: [], f: fn(acc, r) { acc |> list_push(Some { diagnostics: r.chain }) })
  let first = fold(chains, init: None, f: fn(acc, c) {
    match acc {
      None => c
      Some { diagnostics: _ } => acc
    }
  })
  let last = fold(chains, init: None, f: fn(_acc, c) { c })
  !diagnostics_eq(a: first, b: last)
}

// TWO INDEPENDENT FAILURES IN ONE MODULE: exactly two rows, both that module's, carrying DIFFERENT
// chains, and the module's complete observation raises no scope.
test fn xl2_two_failures_in_one_module_are_two_rows_holds() -> Bool {
  match xl2_two_run() {
    Xl2RehearsalObserved { residual: residual, completeness: Xl2CensusCompletenessRefused { first: _, rest: rest } } =>
      count(residual) == 2
        && all(residual, r => r.module == "v2.xl2_control_two")
        && xl2_first_and_last_chains_differ(residual: residual)
        && !any(rest, c => match c {
             Xl2ScopeUnobserved { scope: Xl2ModuleObservationIncomplete { module: _, path: _, reason: _ } } => true
             _ => false
           })
    _ => false
  }
}

// THE WALLS AND THE EXCLUDED KERNEL POPULATION RIDE ON THEIR OWN AXES: an observed run names both
// native requalification walls and the uncounted kernel-canonical class, and neither is among its
// completeness refusals (the refusal type cannot carry them).
test fn xl2_control_names_the_native_requalification_walls_holds() -> Bool {
  match xl2_cut_run() {
    Xl2RehearsalObserved { native_requalification: walls, excluded: excluded } =>
      count(walls) == 2 && count(excluded) == 2
        && any(excluded, e => e == Xl2KernelCanonicalReferencesUncounted)
        && any(excluded, e => e == HeaderSegmentsNotRefusalSites)
    _ => false
  }
}

// DUPLICATED PATH, REFUSED RATHER THAN CHOSEN: the residual and clean specimens supplied at ONE path,
// beside the clean specimen at its own path. Neither shared member enters the ingest, so no row is
// emitted, only the uniquely-pathed module resolves, and the path is reported once as unobserved.
test fn xl2_duplicated_path_is_withheld_not_chosen_holds() -> Bool {
  match xl2_duplicated_run() {
    Xl2RehearsalObserved { residual: residual, resolved_module_count: n, completeness: Xl2CensusCompletenessRefused { first: _, rest: rest } } =>
      count(residual) == 0 && n == 1
        && count(filter(rest, c => match c {
             Xl2ScopeUnobserved { scope: Xl2MemberPathDuplicated { path: _ } } => true
             _ => false
           })) == 1
    _ => false
  }
}

// A NESTED MODULE'S STRIPPED REFERENCE IS RESIDUAL: nesting under the provider's namespace grants
// no scope, so once the import is removed the nested module refuses and is the one residual row,
// and only the provider resolves. Before the 2026-10-04 ruling this specimen resolved and was
// carried as an uncounted excluded population; that arm dissolved by its own stated condition.
test fn xl2_nested_reference_is_residual_after_the_strip_holds() -> Bool {
  match xl2_nesting_run() {
    Xl2RehearsalObserved { residual: residual, resolved_module_count: n } =>
      count(residual) == 1 && n == 1 && all(residual, r => r.module == "v2.xl2_control_provider.nested")
    _ => false
  }
}
